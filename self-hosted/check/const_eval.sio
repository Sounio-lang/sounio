// ============================================================
// Test 12: Unary negation
// ============================================================

fn test_ce_unary_neg() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pair_a = const_pool_add_int(pool, 42)
    pool = pair_a.0
    let aid = pair_a.1

    let pair_neg = const_eval_unop(pool, UNOP_NEG(), aid)
    pool = pair_neg.0
    let neg_r = const_to_i64(pool, pair_neg.1)

    let pair_f = const_pool_add_float(pool, 3.14)
    pool = pair_f.0
    let fid = pair_f.1
    let pair_fneg = const_eval_unop(pool, UNOP_NEG(), fid)
    pool = pair_fneg.0
    let fneg_r = const_to_f64(pool, pair_fneg.1)

    let ok1 = neg_r == (0 - 42)
    let ok2 = fneg_r == (0.0 - 3.14)
    ce_assert_true(ok1 && ok2, 12)
}

// ============================================================
// Test 13: Full expression evaluation (2 + 3 * 4)
//   Built as:  binop(+, lit(2), binop(*, lit(3), lit(4)))
// ============================================================

fn test_ce_expr_eval() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    // Add literal values to pool
    let p2 = const_pool_add_int(pool, 2)
    pool = p2.0
    let vid2 = p2.1

    let p3 = const_pool_add_int(pool, 3)
    pool = p3.0
    let vid3 = p3.1

    let p4 = const_pool_add_int(pool, 4)
    pool = p4.0
    let vid4 = p4.1

    // Build expression tree: lit(2), lit(3), lit(4), binop(*, e1, e2), binop(+, e0, e3)
    let e0p = expr_pool_add(epool, cexpr_lit(vid2))
    epool = e0p.0
    let eid0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid3))
    epool = e1p.0
    let eid1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_lit(vid4))
    epool = e2p.0
    let eid2 = e2p.1

    let e3p = expr_pool_add(epool, cexpr_binop(BINOP_MUL(), eid1, eid2))
    epool = e3p.0
    let eid3 = e3p.1

    let e4p = expr_pool_add(epool, cexpr_binop(BINOP_ADD(), eid0, eid3))
    epool = e4p.0
    let eid4 = e4p.1

    // Evaluate
    let result_pair = const_eval(pool, epool, env, eid4)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)

    // 2 + 3 * 4 = 2 + 12 = 14
    ce_assert_true(result == 14, 13)
}

// ============================================================
// Test 14: Variable binding and lookup in evaluation
//   let x = 10; x + 5
// ============================================================

fn test_ce_var_eval() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    var env = const_env_new()

    // x = 10 in pool
    let px = const_pool_add_int(pool, 10)
    pool = px.0
    let xvid = px.1
    env = const_env_bind(env, 1, xvid)  // name=1 -> x

    // 5 in pool
    let p5 = const_pool_add_int(pool, 5)
    pool = p5.0
    let vid5 = p5.1

    // Build: var(x) + lit(5)
    let e0p = expr_pool_add(epool, cexpr_var(1))
    epool = e0p.0
    let eid0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid5))
    epool = e1p.0
    let eid1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_binop(BINOP_ADD(), eid0, eid1))
    epool = e2p.0
    let eid2 = e2p.1

    let result_pair = const_eval(pool, epool, env, eid2)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)

    ce_assert_true(result == 15, 14)
}

// ============================================================
// Test 15: Conditional evaluation
//   if true then 42 else 0
// ============================================================

fn test_ce_if_eval() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    let pt = const_pool_add_bool(pool, true)
    pool = pt.0
    let tid = pt.1

    let p42 = const_pool_add_int(pool, 42)
    pool = p42.0
    let vid42 = p42.1

    let p0 = const_pool_add_int(pool, 0)
    pool = p0.0
    let vid0 = p0.1

    // Build: if(lit(true), lit(42), lit(0))
    let e0p = expr_pool_add(epool, cexpr_lit(tid))
    epool = e0p.0
    let cond_eid = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid42))
    epool = e1p.0
    let then_eid = e1p.1

    let e2p = expr_pool_add(epool, cexpr_lit(vid0))
    epool = e2p.0
    let else_eid = e2p.1

    let e3p = expr_pool_add(epool, cexpr_if(cond_eid, then_eid, else_eid))
    epool = e3p.0
    let if_eid = e3p.1

    let result_pair = const_eval(pool, epool, env, if_eid)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)
    ce_assert_true(result == 42, 15)
}

// ============================================================
// Test 16: Conditional false branch
//   if false then 1 else 99
// ============================================================

fn test_ce_if_false() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    let pf = const_pool_add_bool(pool, false)
    pool = pf.0
    let fid = pf.1

    let p1 = const_pool_add_int(pool, 1)
    pool = p1.0
    let vid1 = p1.1

    let p99 = const_pool_add_int(pool, 99)
    pool = p99.0
    let vid99 = p99.1

    let e0p = expr_pool_add(epool, cexpr_lit(fid))
    epool = e0p.0
    let cond_eid = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid1))
    epool = e1p.0
    let then_eid = e1p.1

    let e2p = expr_pool_add(epool, cexpr_lit(vid99))
    epool = e2p.0
    let else_eid = e2p.1

    let e3p = expr_pool_add(epool, cexpr_if(cond_eid, then_eid, else_eid))
    epool = e3p.0
    let if_eid = e3p.1

    let result_pair = const_eval(pool, epool, env, if_eid)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)
    ce_assert_true(result == 99, 16)
}

// ============================================================
// Test 17: Array construction and indexing
//   [10, 20, 30][1] == 20
// ============================================================

fn test_ce_array_index() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    let p10 = const_pool_add_int(pool, 10)
    pool = p10.0
    let vid10 = p10.1

    let p20 = const_pool_add_int(pool, 20)
    pool = p20.0
    let vid20 = p20.1

    let p30 = const_pool_add_int(pool, 30)
    pool = p30.0
    let vid30 = p30.1

    let pidx = const_pool_add_int(pool, 1)
    pool = pidx.0
    let vidx = pidx.1

    // Build: array(lit(10), lit(20), lit(30))
    let e0p = expr_pool_add(epool, cexpr_lit(vid10))
    epool = e0p.0
    let eid0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid20))
    epool = e1p.0
    let eid1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_lit(vid30))
    epool = e2p.0
    let eid2 = e2p.1

    var arr_children: [i64; 8] = [0; 8]
    arr_children[0] = eid0
    arr_children[1] = eid1
    arr_children[2] = eid2

    let e3p = expr_pool_add(epool, cexpr_array(arr_children, 3))
    epool = e3p.0
    let arr_eid = e3p.1

    let e4p = expr_pool_add(epool, cexpr_lit(vidx))
    epool = e4p.0
    let idx_eid = e4p.1

    let e5p = expr_pool_add(epool, cexpr_index(arr_eid, idx_eid))
    epool = e5p.0
    let index_eid = e5p.1

    let result_pair = const_eval(pool, epool, env, index_eid)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)
    ce_assert_true(result == 20, 17)
}

// ============================================================
// Test 18: Out of bounds index returns error
// ============================================================

fn test_ce_oob_index() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()

    // Create a 2-element array value
    let p1 = const_pool_add_int(pool, 100)
    pool = p1.0
    let vid1 = p1.1

    let p2 = const_pool_add_int(pool, 200)
    pool = p2.0
    let vid2 = p2.1

    let pair_arr = const_make_array(pool, vid1, 2)
    pool = pair_arr.0
    let arr_vid = pair_arr.1

    // Index with 5 (out of bounds)
    let pidx = const_pool_add_int(pool, 5)
    pool = pidx.0
    let idx_vid = pidx.1

    let pair_r = const_eval_index(pool, arr_vid, idx_vid)
    pool = pair_r.0
    let rv = const_pool_get(pool, pair_r.1)
    ce_assert_true(rv.kind == CONST_ERROR(), 18)
}

// ============================================================
// Test 19: is_const_expr — literal is const
// ============================================================

fn test_ce_is_const_lit() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()

    let pair_v = const_pool_add_int(pool, 7)
    pool = pair_v.0
    let vid = pair_v.1

    let pair_e = expr_pool_add(epool, cexpr_lit(vid))
    epool = pair_e.0
    let eid = pair_e.1

    let result = is_const_expr(epool, eid)
    ce_assert_true(result == true, 19)
}

// ============================================================
// Test 20: is_const_expr — nested binop is const
// ============================================================

fn test_ce_is_const_binop() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()

    let pa = const_pool_add_int(pool, 1)
    pool = pa.0
    let va = pa.1
    let pb = const_pool_add_int(pool, 2)
    pool = pb.0
    let vb = pb.1

    let e0p = expr_pool_add(epool, cexpr_lit(va))
    epool = e0p.0
    let e0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vb))
    epool = e1p.0
    let e1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_binop(BINOP_ADD(), e0, e1))
    epool = e2p.0
    let e2 = e2p.1

    let result = is_const_expr(epool, e2)
    ce_assert_true(result == true, 20)
}

// ============================================================
// Test 21: try_const_fold — successful fold
// ============================================================

fn test_ce_try_fold() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    let pa = const_pool_add_int(pool, 6)
    pool = pa.0
    let va = pa.1
    let pb = const_pool_add_int(pool, 7)
    pool = pb.0
    let vb = pb.1

    let e0p = expr_pool_add(epool, cexpr_lit(va))
    epool = e0p.0
    let e0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vb))
    epool = e1p.0
    let e1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_binop(BINOP_MUL(), e0, e1))
    epool = e2p.0
    let e2 = e2p.1

    let result_struct = try_const_fold(pool, epool, env, e2)
    let success = result_struct.ok
    pool = result_struct.pool
    let vid = result_struct.value
    let result = const_to_i64(pool, vid)
    ce_assert_true(success && result == 42, 21)
}

// ============================================================
// Test 22: const_values_equal
// ============================================================

fn test_ce_values_equal() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()

    let pa = const_pool_add_int(pool, 42)
    pool = pa.0
    let a = pa.1

    let pb = const_pool_add_int(pool, 42)
    pool = pb.0
    let b = pb.1

    let pc = const_pool_add_int(pool, 99)
    pool = pc.0
    let c = pc.1

    let eq1 = const_values_equal(pool, a, b)
    let eq2 = const_values_equal(pool, a, c)
    ce_assert_true(eq1 && !eq2, 22)
}

// ============================================================
// Test 23: Mixed int/float promotion
//   int(3) + float(0.5) = float(3.5)
// ============================================================

fn test_ce_mixed_arith() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pa = const_pool_add_int(pool, 3)
    pool = pa.0
    let aid = pa.1
    let pb = const_pool_add_float(pool, 0.5)
    pool = pb.0
    let bid = pb.1

    let pair_r = const_eval_binop(pool, BINOP_ADD(), aid, bid)
    pool = pair_r.0
    let rv = const_pool_get(pool, pair_r.1)
    let ok1 = rv.kind == CONST_FLOAT()
    let ok2 = rv.float_val == 3.5
    ce_assert_true(ok1 && ok2, 23)
}

// ============================================================
// Test 24: const_make_array fills correctly
// ============================================================

fn test_ce_make_array() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pe = const_pool_add_int(pool, 7)
    pool = pe.0
    let eid = pe.1

    let pair_a = const_make_array(pool, eid, 4)
    pool = pair_a.0
    let avid = pair_a.1

    let arr = const_pool_get(pool, avid)
    let ok1 = arr.kind == CONST_ARRAY()
    let ok2 = arr.child_count == 4
    let ok3 = arr.children[0] == eid
    let ok4 = arr.children[3] == eid
    ce_assert_true(ok1 && ok2 && ok3 && ok4, 24)
}

// ============================================================
// Test 25: const_make_tuple
// ============================================================

fn test_ce_make_tuple() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pa = const_pool_add_int(pool, 1)
    pool = pa.0
    let va = pa.1
    let pb = const_pool_add_bool(pool, true)
    pool = pb.0
    let vb = pb.1

    var elems: [i64; 16] = [0; 16]
    elems[0] = va
    elems[1] = vb
    let pair_t = const_make_tuple(pool, elems, 2)
    pool = pair_t.0
    let tvid = pair_t.1

    let tup = const_pool_get(pool, tvid)
    let ok1 = tup.kind == CONST_TUPLE()
    let ok2 = tup.child_count == 2
    let ok3 = tup.children[0] == va
    let ok4 = tup.children[1] == vb
    ce_assert_true(ok1 && ok2 && ok3 && ok4, 25)
}

// ============================================================
// Test 26: Env shadowing — later bind overrides earlier
// ============================================================

fn test_ce_env_shadow() -> i64 with IO, Mut, Panic, Div {
    var env = const_env_new()
    env = const_env_bind(env, 1, 10)
    env = const_env_bind(env, 1, 20)  // shadow the first binding
    let v = const_env_lookup(env, 1)
    ce_assert_true(v == 20, 26)
}

// ============================================================
// Test 27: Error propagation in binop
//   error + 5 = error
// ============================================================

fn test_ce_error_propagation() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pe = const_pool_add_error(pool)
    pool = pe.0
    let err_id = pe.1

    let p5 = const_pool_add_int(pool, 5)
    pool = p5.0
    let vid5 = p5.1

    let pair_r = const_eval_binop(pool, BINOP_ADD(), err_id, vid5)
    pool = pair_r.0
    let rv = const_pool_get(pool, pair_r.1)
    ce_assert_true(rv.kind == CONST_ERROR(), 27)
}

// ============================================================
// Test 28: Nested if-then-else evaluation
//   if (3 < 5) then (10 + 20) else 0  ->  30
// ============================================================

fn test_ce_nested_if() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    var epool = expr_pool_new()
    let env = const_env_new()

    // Pool values: 3, 5, 10, 20, 0
    let p3 = const_pool_add_int(pool, 3)
    pool = p3.0
    let vid3 = p3.1

    let p5 = const_pool_add_int(pool, 5)
    pool = p5.0
    let vid5 = p5.1

    let p10 = const_pool_add_int(pool, 10)
    pool = p10.0
    let vid10 = p10.1

    let p20 = const_pool_add_int(pool, 20)
    pool = p20.0
    let vid20 = p20.1

    let p0 = const_pool_add_int(pool, 0)
    pool = p0.0
    let vid0 = p0.1

    // Exprs: lit(3), lit(5), binop(<, 0, 1), lit(10), lit(20), binop(+, 3, 4), lit(0), if(2, 5, 6)
    let e0p = expr_pool_add(epool, cexpr_lit(vid3))
    epool = e0p.0
    let e0 = e0p.1

    let e1p = expr_pool_add(epool, cexpr_lit(vid5))
    epool = e1p.0
    let e1 = e1p.1

    let e2p = expr_pool_add(epool, cexpr_binop(BINOP_LT(), e0, e1))
    epool = e2p.0
    let e2 = e2p.1

    let e3p = expr_pool_add(epool, cexpr_lit(vid10))
    epool = e3p.0
    let e3 = e3p.1

    let e4p = expr_pool_add(epool, cexpr_lit(vid20))
    epool = e4p.0
    let e4 = e4p.1

    let e5p = expr_pool_add(epool, cexpr_binop(BINOP_ADD(), e3, e4))
    epool = e5p.0
    let e5 = e5p.1

    let e6p = expr_pool_add(epool, cexpr_lit(vid0))
    epool = e6p.0
    let e6 = e6p.1

    let e7p = expr_pool_add(epool, cexpr_if(e2, e5, e6))
    epool = e7p.0
    let e7 = e7p.1

    let result_pair = const_eval(pool, epool, env, e7)
    pool = result_pair.0
    let result = const_to_i64(pool, result_pair.1)
    ce_assert_true(result == 30, 28)
}

// ============================================================
// Test 29: LE and GE comparison
// ============================================================

fn test_ce_le_ge() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pa = const_pool_add_int(pool, 5)
    pool = pa.0
    let aid = pa.1
    let pb = const_pool_add_int(pool, 5)
    pool = pb.0
    let bid = pb.1
    let pc = const_pool_add_int(pool, 3)
    pool = pc.0
    let cid = pc.1

    // 5 <= 5 = true
    let pair_le = const_eval_binop(pool, BINOP_LE(), aid, bid)
    pool = pair_le.0
    let le_r = const_to_bool(pool, pair_le.1)

    // 5 >= 3 = true
    let pair_ge = const_eval_binop(pool, BINOP_GE(), aid, cid)
    pool = pair_ge.0
    let ge_r = const_to_bool(pool, pair_ge.1)

    // 3 >= 5 = false
    let pair_ge2 = const_eval_binop(pool, BINOP_GE(), cid, aid)
    pool = pair_ge2.0
    let ge2_r = const_to_bool(pool, pair_ge2.1)

    ce_assert_true(le_r && ge_r && !ge2_r, 29)
}

// ============================================================
// Test 30: Unit value
// ============================================================

fn test_ce_unit_value() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pu = const_pool_add_unit(pool)
    pool = pu.0
    let uid = pu.1
    let v = const_pool_get(pool, uid)
    let ok1 = v.kind == CONST_UNIT()
    let ok2 = const_values_equal(pool, uid, uid)
    ce_assert_true(ok1 && ok2, 30)
}

// ============================================================
// Test 31: Pool count tracks correctly
// ============================================================

fn test_ce_pool_count() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let ok0 = pool.count == 0

    let p1 = const_pool_add_int(pool, 1)
    pool = p1.0
    let ok1 = pool.count == 1

    let p2 = const_pool_add_float(pool, 2.0)
    pool = p2.0
    let ok2 = pool.count == 2

    let p3 = const_pool_add_bool(pool, true)
    pool = p3.0
    let ok3 = pool.count == 3

    ce_assert_true(ok0 && ok1 && ok2 && ok3, 31)
}

