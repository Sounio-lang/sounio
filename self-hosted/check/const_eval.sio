    if t27 != 0 { fails = fails + 1 }

    let t28 = test_ce_nested_if()
    if t28 != 0 { fails = fails + 1 }

    let t29 = test_ce_le_ge()
    if t29 != 0 { fails = fails + 1 }

    let t30 = test_ce_unit_value()
    if t30 != 0 { fails = fails + 1 }

    let t31 = test_ce_pool_count()
    if t31 != 0 { fails = fails + 1 }

    print("Total failures: ")
    print_int(fails)
