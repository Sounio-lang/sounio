// "i8" = [105, 56]
pub fn name_is_i8(n: Name) -> bool with Panic, Div {
    name_matches_str2(n, 105, 56)
}

// "DsepProof" — the discharged-d-separation credential. Recognised generically
// wherever a type name is scanned, exactly like i8/i32/... above, but NOT a
// declared struct anywhere: nothing in any struct table resolves this name, so
// no `DsepProof { ... }` literal exists to write. Producible only where the
// checker stamps it directly onto a `d_separated(A, B | Z)` expression.
pub fn name_is_dsep_proof(n: Name) -> bool with Panic, Div {
    name_matches_str9(n, 68, 115, 101, 112, 80, 114, 111, 111, 102)
}

