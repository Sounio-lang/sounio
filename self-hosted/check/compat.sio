// Arbitrary wide-int name parse: 'i'/'u' followed by all-decimal-digits.
// Returns the bit width (>0) or 0 if the name is not an iN/uN form.
// Signedness is the caller's job (first byte 105='i' signed, 117='u' unsigned).
// The all-digit guard prevents swallowing identifiers like `input`, `usize`, `i32x4`.
pub fn name_wide_int_bits(n: Name) -> i64 with Panic, Div {
    if n.len < 2 { return 0 }
    let c0 = n.buf[0] as i64
    if c0 != 105 && c0 != 117 { return 0 }
    var bits: i64 = 0
    var i: i64 = 1
    while i < n.len {
        let d = n.buf[i as usize] as i64
        if d < 48 || d > 57 { return 0 }
        bits = bits * 10 + (d - 48)
        i = i + 1
    }
    if bits <= 0 { return 0 }
    bits
}

// "usize" = [117, 115, 105, 122, 101]. lean_single (the oracle) collapses every
// integer width — i32/u32/i64/u64/usize — to a single integer type code, so the
// faithful mapping is to the canonical integer (i64). Without this, `x as usize`
// lowered to ty_named("usize") (a TyNamed) and array-index checks rejected it (E014).
pub fn name_is_usize(n: Name) -> bool with Panic, Div {
    name_matches_str5(n, 117, 115, 105, 122, 101)
}

