// Compatibility and operator typing for the type checker
//
// Standalone functions that don't need Checker state.
// lower_type_expr is a Checker method and lives in check.sio.

// ============================================================
// Type compatibility — must be symmetric
// ============================================================

// Feature B: an Invariant<T,G> type is lowered (in check.sio) to a TyNamed whose name
// is "Invariant<rank>" (rank 1..4 = DiffInf<Diff1<BiLip<Homeo), optionally followed by
// "$<frame>" for the 3-arg Invariant<T,G,F>. Decode that rank here (raw bytes, so this
// stays above types_compatible with no forward reference); returns 0 for any other
// type. Used so Invariant arithmetic/comparison resolves on the inner T and so the
// inner T is not erased from compatibility.
fn compat_invariant_name_prefix(n: Name) -> bool with Panic, Div {
    if n.len < 10 { return false }
    if (n.buf[0] as i64) != 73 { return false }    // I
    if (n.buf[1] as i64) != 110 { return false }   // n
    if (n.buf[2] as i64) != 118 { return false }   // v
    if (n.buf[3] as i64) != 97 { return false }    // a
    if (n.buf[4] as i64) != 114 { return false }   // r
    if (n.buf[5] as i64) != 105 { return false }   // i
    if (n.buf[6] as i64) != 97 { return false }    // a
    if (n.buf[7] as i64) != 110 { return false }   // n
    if (n.buf[8] as i64) != 116 { return false }   // t
    // a frame suffix, if any, must start with '$' at position 10
    if n.len > 10 && (n.buf[10] as i64) != 36 { return false }
    true
}

pub fn compat_invariant_rank(ty: TypeEntry) -> i64 with Panic, Div {
    if ty.kind != TypeKind::TyNamed { return 0 }
    let n = ty.name
    if !compat_invariant_name_prefix(n) { return 0 }
    let d = n.buf[9] as i64
    if d >= 49 && d <= 52 { return d - 48 }
    0
}

// Two Invariant types share a frame iff BOTH carry a frame suffix ("$<frame>") and the
// suffixes are identical. A frameless Invariant (2-arg Invariant<T,G>) is treated as an
// unknown, distinct frame, so it never matches anything — the binop gate then falls
// back to the conservative cross-frame rule.
pub fn compat_invariant_same_frame(a: TypeEntry, b: TypeEntry) -> bool with Panic, Div {
    if compat_invariant_rank(a) == 0 || compat_invariant_rank(b) == 0 { return false }
    let na = a.name
    let nb = b.name
    if na.len <= 11 || nb.len <= 11 { return false }   // no (or empty) frame on one side
    if na.len != nb.len { return false }
    var i: i64 = 11
    while i < na.len {
        if (na.buf[i as usize] as i64) != (nb.buf[i as usize] as i64) { return false }
        i = i + 1
    }
    true
}

// A7: integer-width coercion (matches lean_single's permissiveness).
// Classifies the "narrow" machine integer kinds by signedness family so that an
// i32 branch/operand and an i64 branch/operand type-check by widening to the
// wider type. Returns 1 for the signed narrow family {i8,i32,i64}, 2 for the
// unsigned narrow family {u8,u32,u64}, 0 for anything else (incl. the wide
// i128/u128 kinds, which keep their exact bit-width check — the i128≠i256
// soundness hole stays closed). Cross-signedness (i32 vs u32) is deliberately
// NOT widened, so a genuine signed/unsigned mismatch is still rejected.
fn int_width_family(k: TypeKind) -> i64 with Panic, Div {
    if k == TypeKind::TyI8 { return 1 }
    if k == TypeKind::TyI32 { return 1 }
    if k == TypeKind::TyI64 { return 1 }
    if k == TypeKind::TyU8 { return 2 }
    if k == TypeKind::TyU32 { return 2 }
    if k == TypeKind::TyU64 { return 2 }
    0
}

// Two narrow integer types are mutually compatible iff they share a signedness
// family. The exact-kind cases are already handled above; this covers the
// mixed-width cases (i32<->i64, i8<->i32, u32<->u64, ...).
pub fn int_widths_compatible(a: TypeEntry, b: TypeEntry) -> bool with Panic, Div {
    let fa = int_width_family(a.kind)
    if fa == 0 { return false }
    fa == int_width_family(b.kind)
}

pub fn types_compatible(a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    // Wildcard types: compatible with anything (check BOTH sides)
    if a.kind == TypeKind::TyError || b.kind == TypeKind::TyError {
        return true
    }
    if a.kind == TypeKind::TyNever || b.kind == TypeKind::TyNever {
        return true
    }
    if a.kind == TypeKind::TyUnknown || b.kind == TypeKind::TyUnknown {
        return true
    }

    // DsepProof: compatible ONLY with itself, and deliberately checked before
    // the primitive/struct rules below. It carries no payload to compare --
    // its opacity comes entirely from there being no OTHER way to produce a
    // TypeEntry of this kind, so kind equality alone is the whole rule. No
    // rule anywhere may make this compatible with TyI64 or anything else;
    // that is the property indep_dsep's signature depends on.
    if a.kind == TypeKind::TyDsepProof && b.kind == TypeKind::TyDsepProof {
        return true
    }

    // Primitives: kind must match
    if a.kind == TypeKind::TyI8 && b.kind == TypeKind::TyI8 {
        return true
    }
    if a.kind == TypeKind::TyI32 && b.kind == TypeKind::TyI32 {
        return true
    }
    if a.kind == TypeKind::TyI64 && b.kind == TypeKind::TyI64 {
        return true
    }
    if a.kind == TypeKind::TyU8 && b.kind == TypeKind::TyU8 {
        return true
    }
    if a.kind == TypeKind::TyU32 && b.kind == TypeKind::TyU32 {
        return true
    }
    if a.kind == TypeKind::TyU64 && b.kind == TypeKind::TyU64 {
        return true
    }
    // Wide ints: same signedness AND same width (clifford_p carries bit-width).
    // Closes the i128 != i256 soundness hole.
    if a.kind == TypeKind::TyI128 && b.kind == TypeKind::TyI128 {
        return a.clifford_p == b.clifford_p
    }
    if a.kind == TypeKind::TyU128 && b.kind == TypeKind::TyU128 {
        return a.clifford_p == b.clifford_p
    }
    if a.kind == TypeKind::TyF32 && b.kind == TypeKind::TyF32 {
        return true
    }
    if a.kind == TypeKind::TyF64 && b.kind == TypeKind::TyF64 {
        // If both carry unit annotations, the units must match
        if a.unit_id >= 0 && b.unit_id >= 0 {
            return a.unit_id == b.unit_id
        }
        return true
    }
    if wide_float_format_identity_compatible(a, b) {
        return true
    }
    if a.kind == TypeKind::TyBool && b.kind == TypeKind::TyBool {
        return true
    }
    if a.kind == TypeKind::TyUnit && b.kind == TypeKind::TyUnit {
        return true
    }
    if a.kind == TypeKind::TyString && b.kind == TypeKind::TyString {
        return true
    }
    if a.kind == TypeKind::TyChar && b.kind == TypeKind::TyChar {
        return true
    }

    // A7: narrow integer width coercion (i32<->i64, i8<->i32, u32<->u64, ...).
    // Same signedness family only; wide i128/u128 keep their exact bit-width
    // check above so the i128≠i256 hole stays closed.
    if int_widths_compatible(a, b) {
        return true
    }

    // Named types: names must match
    if a.kind == TypeKind::TyNamed && b.kind == TypeKind::TyNamed {
        // Feature B: Invariant<T,G[,F]> mangles G (and an optional frame F) into the
        // name but carries T in `inner`. Compatibility is by GROUP RANK + inner T — NOT
        // the full mangled name: the FRAME is deliberately ignored here so two same-group
        // invariants in different frames stay "compatible", and the binop comparability
        // gate (check.sio) decides accept/reject from the frame relation. Comparing rank
        // (not name) also keeps the inner T from being erased (Invariant<f64,G> ≠
        // Invariant<i64,G>).
        let ra = compat_invariant_rank(a)
        let rb = compat_invariant_rank(b)
        if ra > 0 && rb > 0 {
            if ra != rb { return false }   // different invariance group → incompatible
            match a.inner {
                Some(ai) => match b.inner {
                    Some(bi) => return types_compatible(*ai, *bi),
                    None => return false,
                },
                None => return false,
            }
        }
        // Seq<T>: name "Seq" with element in `inner`. Must not collapse to bare name
        // equality (that would make Seq<i64> ~ Seq<f64>). Bare Seq (no inner) is a
        // soft wildcard against a concrete Seq<T> so seq_new() can type against an
        // annotated binding.
        if is_seq_type(a) && is_seq_type(b) {
            match a.inner {
                None => return true
                Some(_) => {
                    match b.inner {
                        None => return true
                        Some(_) => return types_compatible_inner(a.inner, b.inner)
                    }
                }
            }
        }
        return name_eq(a.name, b.name)
    }

    // Array: elements compatible, sizes match (or -1 = unknown)
    if a.kind == TypeKind::TyArray && b.kind == TypeKind::TyArray {
        let elems_ok = types_compatible_inner(a.inner, b.inner)
        if !elems_ok {
            return false
        }
        if a.array_size == -1 || b.array_size == -1 {
            return true
        }
        return a.array_size == b.array_size
    }

    // References: inner compatible, mutability must match
    if a.kind == TypeKind::TyRef && b.kind == TypeKind::TyRef {
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyRefMut && b.kind == TypeKind::TyRefMut {
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyRawPtr && b.kind == TypeKind::TyRawPtr {
        if a.name.buf[0] != b.name.buf[0] {
            return false
        }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TySlice && b.kind == TypeKind::TySlice {
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TySliceMut && b.kind == TypeKind::TySliceMut {
        return types_compatible_inner(a.inner, b.inner)
    }

    // Tuples: count + pairwise compatible
    if a.kind == TypeKind::TyTuple && b.kind == TypeKind::TyTuple {
        return tuple_types_compatible(a.tuple_elems, b.tuple_elems)
    }

    // Function types: same sig_id
    if a.kind == TypeKind::TyFn && b.kind == TypeKind::TyFn {
        return a.fn_sig_id == b.fn_sig_id
    }

    // Knowledge types: inner type must be compatible + epsilon subsumption
    // Knowledge<T, ε1> is compatible with Knowledge<T, ε2> if ε1 <= ε2
    // (tighter bound satisfies looser requirement)
    // Negative epsilon (-1.0) means unspecified — always compatible
    if a.kind == TypeKind::TyKnowledge && b.kind == TypeKind::TyKnowledge {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        // If either epsilon is unspecified, accept
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        // a is the provided value, b is the expected type
        // a.epsilon must be <= b.epsilon (tighter bound ok)
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }

    if a.kind == TypeKind::TyModel && b.kind == TypeKind::TyModel {
        return tuple_types_compatible(a.tuple_elems, b.tuple_elems)
    }

    if a.kind == TypeKind::TyModelFamily && b.kind == TypeKind::TyModelFamily {
        if !tuple_types_compatible(a.tuple_elems, b.tuple_elems) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyPolicy && b.kind == TypeKind::TyPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyAcquisitionPolicy && b.kind == TypeKind::TyAcquisitionPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyAcquisitionPlan && b.kind == TypeKind::TyAcquisitionPlan {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyRecoursePolicy && b.kind == TypeKind::TyRecoursePolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyRecoursePlan && b.kind == TypeKind::TyRecoursePlan {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyTransitionPolicy && b.kind == TypeKind::TyTransitionPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyTransitionPlan && b.kind == TypeKind::TyTransitionPlan {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyMonitoringPolicy && b.kind == TypeKind::TyMonitoringPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyObservedTransition && b.kind == TypeKind::TyObservedTransition {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyRollbackCertificate && b.kind == TypeKind::TyRollbackCertificate {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyAlternativePolicy && b.kind == TypeKind::TyAlternativePolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyAlternativeSet && b.kind == TypeKind::TyAlternativeSet {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyAlternativeOption && b.kind == TypeKind::TyAlternativeOption {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyDecisionPolicy && b.kind == TypeKind::TyDecisionPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyDeferralPolicy && b.kind == TypeKind::TyDeferralPolicy {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyContest && b.kind == TypeKind::TyContest {
        return types_compatible_inner(a.inner, b.inner)
    }

    if a.kind == TypeKind::TyRobust && b.kind == TypeKind::TyRobust {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.robustness_level_id >= 0 && b.robustness_level_id >= 0 && a.robustness_level_id != b.robustness_level_id {
            return false
        }
        if a.robustness_scope_id >= 0 && b.robustness_scope_id >= 0 && a.robustness_scope_id != b.robustness_scope_id {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyIntervention && b.kind == TypeKind::TyIntervention {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }

    if a.kind == TypeKind::TyCounterfactual && b.kind == TypeKind::TyCounterfactual {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }

    if a.kind == TypeKind::TyValidated && b.kind == TypeKind::TyValidated {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 && a.epistemic_meta_id != b.epistemic_meta_id {
            return false
        }
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }

    if a.kind == TypeKind::TyAdmissible && b.kind == TypeKind::TyAdmissible {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyDeferred && b.kind == TypeKind::TyDeferred {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    if a.kind == TypeKind::TyValidation && b.kind == TypeKind::TyValidation {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.epistemic_meta_id >= 0 && b.epistemic_meta_id >= 0 {
            return a.epistemic_meta_id == b.epistemic_meta_id
        }
        return true
    }

    // Session types (Track S): structural protocol compatibility
    // TyChan compatible iff inner protocols are compatible
    if a.kind == TypeKind::TyChan && b.kind == TypeKind::TyChan {
        return types_compatible_inner(a.inner, b.inner)
    }
    // TySession compatible iff step_kind matches AND continuation compatible
    if a.kind == TypeKind::TySession && b.kind == TypeKind::TySession {
        if a.array_size != b.array_size {
            return false
        }
        return types_compatible_inner(a.inner, b.inner)
    }
    // TySessionEnd is only compatible with itself
    if a.kind == TypeKind::TySessionEnd && b.kind == TypeKind::TySessionEnd {
        return true
    }

    // Aleatoric types (H6.3): same kind, inner compatible, epsilon ordering
    // Aleatoric <: Knowledge (upcast allowed), but NOT Aleatoric <: Epistemic
    if a.kind == TypeKind::TyAleatoric && b.kind == TypeKind::TyAleatoric {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }
    if a.kind == TypeKind::TyAleatoric && b.kind == TypeKind::TyKnowledge {
        return types_compatible_inner(a.inner, b.inner)
    }

    // Epistemic types (H6.3): same kind, inner compatible, epsilon ordering
    // Epistemic <: Knowledge (upcast allowed), but NOT Epistemic <: Aleatoric
    if a.kind == TypeKind::TyEpistemic && b.kind == TypeKind::TyEpistemic {
        if !types_compatible_inner(a.inner, b.inner) {
            return false
        }
        if a.knowledge_epsilon < 0.0 || b.knowledge_epsilon < 0.0 {
            return true
        }
        return a.knowledge_epsilon <= b.knowledge_epsilon
    }
    if a.kind == TypeKind::TyEpistemic && b.kind == TypeKind::TyKnowledge {
        return types_compatible_inner(a.inner, b.inner)
    }

    // Irreducibility boundary: Aleatoric and Epistemic are INCOMPATIBLE with each other
    if a.kind == TypeKind::TyAleatoric && b.kind == TypeKind::TyEpistemic {
        return false
    }
    if a.kind == TypeKind::TyEpistemic && b.kind == TypeKind::TyAleatoric {
        return false
    }

    // CausalEffect compatibility (H6.4): same kind, inner (effect type) compatible
    if a.kind == TypeKind::TyCausalEffect && b.kind == TypeKind::TyCausalEffect {
        return types_compatible_inner(a.inner, b.inner)
    }

    // Singleton constants (Sprint 20 SC): same constant name and inner type
    if a.kind == TypeKind::TySingleton && b.kind == TypeKind::TySingleton {
        if !name_eq(a.name, b.name) {
            return false
        }
        return types_compatible_inner(a.inner, b.inner)
    }

    // ScopedEffect (Sprint 20 SE): same effect label and compatible inner type
    if a.kind == TypeKind::TyScopedEffect && b.kind == TypeKind::TyScopedEffect {
        if !name_eq(a.name, b.name) {
            return false
        }
        return types_compatible_inner(a.inner, b.inner)
    }

    // ConditionalIndependence (Sprint 20 CI): same var_a, var_b, cond_set, compatible inner
    if a.kind == TypeKind::TyCondIndep && b.kind == TypeKind::TyCondIndep {
        if a.array_size != b.array_size { return false }
        if a.fn_sig_id != b.fn_sig_id { return false }
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // Introduction: a value of the base type T initialises an
    // IndepKnowledge<T, A, B | Z> binding. The claim is a statement ABOUT that
    // value carried in its type, and there is no separate constructor -- the
    // corpus writes `let a: IndepKnowledge<f64, hrv, kp | hora> = 1.0`, and the
    // obligation was already discharged against the declared graph when the
    // annotation was lowered.
    //
    // Both orders, because callers disagree on which side is expected:
    // checker_check_let_stmt_inplace passes (init, annotation) while
    // checker_check_call_args and others pass (expected, actual). Erasing the
    // claim is harmless in either direction -- what makes the claim mean
    // something is not this rule but the d-separation obligation discharged
    // when the annotation was lowered, which a value can neither create nor
    // escape.
    if a.kind == TypeKind::TyCondIndep && b.kind != TypeKind::TyCondIndep {
        return types_compatible_inner(a.inner, Some(Box::new(b)))
    }
    if b.kind == TypeKind::TyCondIndep && a.kind != TypeKind::TyCondIndep {
        return types_compatible_inner(Some(Box::new(a)), b.inner)
    }

    // PotentialOutcome (Sprint 20 PO): same policy and compatible inner
    if a.kind == TypeKind::TyPotentialOutcome && b.kind == TypeKind::TyPotentialOutcome {
        if a.fn_sig_id != b.fn_sig_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // ATE (Sprint 20 PO): compatible inner type
    if a.kind == TypeKind::TyATE && b.kind == TypeKind::TyATE {
        return types_compatible_inner(a.inner, b.inner)
    }

    // DiffPrivate (Sprint 21 DP): same ε budget (milli-ratio in knowledge_epsilon) + compatible inner
    if a.kind == TypeKind::TyDiffPrivate && b.kind == TypeKind::TyDiffPrivate {
        if a.knowledge_epsilon != b.knowledge_epsilon { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // DPBudget (Sprint 21 DP): same ε_total; ε_spent must not exceed ε_total
    if a.kind == TypeKind::TyDPBudget && b.kind == TypeKind::TyDPBudget {
        if a.knowledge_epsilon != b.knowledge_epsilon { return false }
        if (a.array_size as f64) > a.knowledge_epsilon { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyTransportable (Sprint 22 T): same source/target domain + selection diagram + compatible inner
    // Two transportable claims are compatible when they refer to the same cross-domain transfer.
    if a.kind == TypeKind::TyTransportable && b.kind == TypeKind::TyTransportable {
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }  // source domain
        if a.robustness_level_id != b.robustness_level_id { return false }  // target domain
        return types_compatible_inner(a.inner, b.inner)
    }

    // TySelectionDiagram (Sprint 22 T): same diagram + compatible inner
    if a.kind == TypeKind::TySelectionDiagram && b.kind == TypeKind::TySelectionDiagram {
        if a.fn_sig_id != b.fn_sig_id { return false }  // diagram_id
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyFairPrediction (Sprint 22 F): same criterion + same protected attribute + compatible inner
    // Slack is covariant: narrower slack (less tolerance) is compatible with wider slack.
    if a.kind == TypeKind::TyFairPrediction && b.kind == TypeKind::TyFairPrediction {
        if a.array_size != b.array_size { return false }  // criterion
        if a.fn_sig_id != b.fn_sig_id { return false }    // protected attribute
        if a.knowledge_epsilon > b.knowledge_epsilon { return false }  // a's slack ≤ b's slack
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyFairnessGap (Sprint 22 F): same criterion; gap on a must be ≤ gap on b
    if a.kind == TypeKind::TyFairnessGap && b.kind == TypeKind::TyFairnessGap {
        if a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyDistribution (Sprint 23 P): same dist kind + compatible inner
    if a.kind == TypeKind::TyDistribution && b.kind == TypeKind::TyDistribution {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TySample (Sprint 23 P): same dist kind + fn_sig_id matches (or either is -1)
    if a.kind == TypeKind::TySample && b.kind == TypeKind::TySample {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if a.fn_sig_id != -1 && b.fn_sig_id != -1 && a.fn_sig_id != b.fn_sig_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyConditionalDist (Sprint 23 P): same lik kind + sub.robustness_level_id <= sup
    if a.kind == TypeKind::TyConditionalDist && b.kind == TypeKind::TyConditionalDist {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if b.robustness_level_id != -1 && a.robustness_level_id > b.robustness_level_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyEntropic (Sprint 23 I): sub.knowledge_epsilon <= sup (smaller entropy = more specific)
    if a.kind == TypeKind::TyEntropic && b.kind == TypeKind::TyEntropic {
        if b.knowledge_epsilon >= 0.0 && a.knowledge_epsilon > b.knowledge_epsilon { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyMutualInfo (Sprint 23 I): same Y variable (fn_sig_id)
    if a.kind == TypeKind::TyMutualInfo && b.kind == TypeKind::TyMutualInfo {
        if a.fn_sig_id != -1 && b.fn_sig_id != -1 && a.fn_sig_id != b.fn_sig_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyKLBounded (Sprint 23 I): sub.knowledge_epsilon <= sup
    if a.kind == TypeKind::TyKLBounded && b.kind == TypeKind::TyKLBounded {
        if b.knowledge_epsilon >= 0.0 && a.knowledge_epsilon > b.knowledge_epsilon { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyVecShaped (Sprint 23 V): same array_size OR one is -1
    if a.kind == TypeKind::TyVecShaped && b.kind == TypeKind::TyVecShaped {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyMatrixShaped (Sprint 23 V): same array_size (n) + same algebra_kind (m) OR either -1
    if a.kind == TypeKind::TyMatrixShaped && b.kind == TypeKind::TyMatrixShaped {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if a.algebra_kind != -1 && b.algebra_kind != -1 && a.algebra_kind != b.algebra_kind { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyBroadcastable (Sprint 23 V): actual_m = 1 OR actual_m = m_target; same for n
    if a.kind == TypeKind::TyBroadcastable && b.kind == TypeKind::TyBroadcastable {
        // Check m compatibility
        let a_m_ok = (a.clifford_p == 1) || (a.clifford_p == -1) || (a.clifford_p == b.algebra_kind)
        let b_m_ok = (b.clifford_p == 1) || (b.clifford_p == -1) || (b.clifford_p == a.algebra_kind)
        if !a_m_ok && !b_m_ok { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyELBO (Sprint 23 X): sub.knowledge_epsilon <= sup (tighter KL gap = more specific)
    if a.kind == TypeKind::TyELBO && b.kind == TypeKind::TyELBO {
        if b.knowledge_epsilon >= 0.0 && a.knowledge_epsilon > b.knowledge_epsilon { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // TyVariationalFamily (Sprint 23 X): same family kind + fn_sig_id compatible
    if a.kind == TypeKind::TyVariationalFamily && b.kind == TypeKind::TyVariationalFamily {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if a.fn_sig_id != -1 && b.fn_sig_id != -1 && a.fn_sig_id != b.fn_sig_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // Sprint 24 Track A: Differentiable Programming
    if a.kind == TypeKind::TyDifferentiable && b.kind == TypeKind::TyDifferentiable {
        // sub.array_size >= sup.array_size (higher smoothness = more specific subtype)
        if a.array_size != -1 && b.array_size != -1 {
            if a.array_size < b.array_size { return false }
        }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyGradient && b.kind == TypeKind::TyGradient {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if a.algebra_kind != -1 && b.algebra_kind != -1 && a.algebra_kind != b.algebra_kind { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyJacobian && b.kind == TypeKind::TyJacobian {
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        if a.algebra_kind != -1 && b.algebra_kind != -1 && a.algebra_kind != b.algebra_kind { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    // Sprint 24 Track B: Stochastic Process
    if a.kind == TypeKind::TyMarkovChain && b.kind == TypeKind::TyMarkovChain {
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TySDE && b.kind == TypeKind::TySDE {
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }
        if a.array_size != -1 && b.array_size != -1 && a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyMartingale && b.kind == TypeKind::TyMartingale {
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyStationaryDist && b.kind == TypeKind::TyStationaryDist {
        if a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    // Sprint 24 Track C: Complexity
    if a.kind == TypeKind::TyBigO && b.kind == TypeKind::TyBigO {
        // b subsumes a: sup.degree >= sub.degree
        if a.array_size != -1 && b.array_size != -1 {
            if b.array_size < a.array_size { return false }
        }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyAmortized && b.kind == TypeKind::TyAmortized {
        if a.epistemic_meta_id != b.epistemic_meta_id { return false }
        if a.array_size > b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    // Sprint 24 Track D: Proof Certificates
    if a.kind == TypeKind::TyProof && b.kind == TypeKind::TyProof {
        if a.array_size != b.array_size { return false }
        // higher confidence = more specific (sub has >= confidence of sup)
        if a.knowledge_epsilon >= 0.0 && b.knowledge_epsilon >= 0.0 {
            if a.knowledge_epsilon < b.knowledge_epsilon { return false }
        }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyLemma && b.kind == TypeKind::TyLemma {
        if a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }
    if a.kind == TypeKind::TyAxiom && b.kind == TypeKind::TyAxiom {
        if a.array_size != b.array_size { return false }
        return types_compatible_inner(a.inner, b.inner)
    }

    // Hyper types: algebra kind must match, inner compatible
    // For Clifford: (p,q) signatures must also match
    if a.kind == TypeKind::TyHyper && b.kind == TypeKind::TyHyper {
        if a.algebra_kind != b.algebra_kind {
            return false
        }
        // Clifford: check signature match
        if a.algebra_kind == 5 {
            if a.clifford_p != b.clifford_p || a.clifford_q != b.clifford_q {
                return false
            }
        }
        return types_compatible_inner(a.inner, b.inner)
    }

    false
}

pub fn types_compatible_inner(a: Option<Box<TypeEntry>>, b: Option<Box<TypeEntry>>) -> bool with Mut, Panic, Div, Alloc {
    match a {
        None => {
            match b {
                None => true
                Some(_) => false
            }
        }
        Some(a_inner) => {
            match b {
                None => false
                Some(b_inner) => types_compatible(*a_inner, *b_inner)
            }
        }
    }
}

pub fn tuple_types_compatible(a: Option<Box<TypeEntryList>>, b: Option<Box<TypeEntryList>>) -> bool with Mut, Panic, Div, Alloc {
    match a {
        None => {
            match b {
                None => true
                Some(_) => false
            }
        }
        Some(a_list) => {
            match b {
                None => false
                Some(b_list) => {
                    if !types_compatible((*a_list).head, (*b_list).head) {
                        false
                    } else {
                        tuple_types_compatible((*a_list).tail, (*b_list).tail)
                    }
                }
            }
        }
    }
}

// ============================================================
// Type kind queries
// ============================================================

pub fn is_numeric_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyI8 || ty.kind == TypeKind::TyI32 || ty.kind == TypeKind::TyI64 ||
    ty.kind == TypeKind::TyI128 ||
    ty.kind == TypeKind::TyU8 || ty.kind == TypeKind::TyU32 || ty.kind == TypeKind::TyU64 ||
    ty.kind == TypeKind::TyU128 ||
    ty.kind == TypeKind::TyF32 || ty.kind == TypeKind::TyF64
}

pub fn is_integer_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyI8 || ty.kind == TypeKind::TyI32 || ty.kind == TypeKind::TyI64 ||
    ty.kind == TypeKind::TyI128 ||
    ty.kind == TypeKind::TyU8 || ty.kind == TypeKind::TyU32 || ty.kind == TypeKind::TyU64 ||
    ty.kind == TypeKind::TyU128
}

pub fn is_float_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyF32 || ty.kind == TypeKind::TyF64
}

// Wide-float format identity (TyF128/TyF256). Value ops are admitted for
// same-format arithmetic/comparison as of V0-E.2 (see wide_float_binary_result_type).
pub fn is_wide_float_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyF128 || ty.kind == TypeKind::TyF256
}

pub fn wide_float_binary_result_type(op: BinaryOp, left: TypeEntry, right: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    // Mixed f128/f256 or wide↔narrow stays rejected (no implicit conversion).
    if !is_wide_float_type(left) || !is_wide_float_type(right) {
        return ty_error()
    }
    if !types_compatible(left, right) {
        return ty_error()
    }
    match op {
        BinaryOp::OpAdd => left
        BinaryOp::OpSub => left
        BinaryOp::OpMul => left
        BinaryOp::OpDiv => left
        BinaryOp::OpEq => ty_bool()
        BinaryOp::OpNe => ty_bool()
        BinaryOp::OpLt => ty_bool()
        BinaryOp::OpLe => ty_bool()
        BinaryOp::OpGt => ty_bool()
        BinaryOp::OpGe => ty_bool()
        _ => ty_error()
    }
}

pub fn f128_f256_compatibility_probe_code() -> i64 with Mut, Panic, Div, Alloc {
    let t128 = ty_f128()
    let t256 = ty_f256()
    let f64 = ty_f64()
    if !types_compatible(t128, t128) { return 40 }
    if !types_compatible(t256, t256) { return 41 }
    if types_compatible(t128, t256) || types_compatible(t256, t128) { return 42 }
    if types_compatible(t128, f64) || types_compatible(f64, t128) { return 43 }
    if types_compatible(t256, f64) || types_compatible(f64, t256) { return 44 }
    // Still not in the generic is_numeric_type set — ops go through the
    // wide_float_* dispatch (keeps f64/f32 numeric paths distinct).
    if is_numeric_type(t128) || is_numeric_type(t256) { return 45 }
    if is_float_type(t128) || is_float_type(t256) { return 46 }
    if !is_wide_float_type(t128) || !is_wide_float_type(t256) { return 47 }
    // V0-E.2: same-format add typechecks; cross-format stays error.
    let add128 = wide_float_binary_result_type(BinaryOp::OpAdd, t128, t128)
    if add128.kind != TypeKind::TyF128 { return 48 }
    let add256 = wide_float_binary_result_type(BinaryOp::OpAdd, t256, t256)
    if add256.kind != TypeKind::TyF256 { return 49 }
    let mixed = wide_float_binary_result_type(BinaryOp::OpAdd, t128, t256)
    if mixed.kind != TypeKind::TyError { return 50 }
    let cmp = wide_float_binary_result_type(BinaryOp::OpLt, t128, t128)
    if cmp.kind != TypeKind::TyBool { return 51 }
    0
}

pub fn is_bool_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyBool
}

pub fn is_error_or_unknown(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyError || ty.kind == TypeKind::TyUnknown || ty.kind == TypeKind::TyNever
}

pub fn compat_is_hyper_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyHyper
}

// Primitive scalar kinds that can be the receiver of a trait/inherent method
// (impl R for i64 { fn m(self, ...) }). These types have empty .name, so
// method resolution disambiguates on kind via fn_sig_table_find_method_semantic.
// Excludes TyString (handled by its own builtin-method branch) and aggregates.
pub fn is_primitive_receiver_type(ty: TypeEntry) -> bool {
    is_numeric_type(ty) || ty.kind == TypeKind::TyBool || ty.kind == TypeKind::TyChar
}

// ============================================================
// Binary operator result types
// ============================================================

pub fn binary_result_type(op: BinaryOp, left: TypeEntry, right: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    // If either side is error/unknown/never, propagate
    if is_error_or_unknown(left) {
        return left
    }
    if is_error_or_unknown(right) {
        return right
    }
    if is_wide_float_type(left) || is_wide_float_type(right) {
        return wide_float_binary_result_type(op, left, right)
    }

    // Feature B: Invariant<T,G> arithmetic/comparison resolves on the inner T (an
    // opaque TyNamed is not numeric, which would otherwise make every op ty_error and
    // false-reject the §4.4 ratio). The group-comparability gate is enforced separately
    // in check.sio; here we only compute the result type on the unwrapped operands.
    if compat_invariant_rank(left) > 0 && compat_invariant_rank(right) > 0 {
        match left.inner {
            Some(li) => match right.inner {
                Some(ri) => return binary_result_type(op, *li, *ri),
                None => {},
            },
            None => {},
        }
    }
    // IndepKnowledge<T, A, B | Z> is transparent to T under every operator: the
    // claim is an obligation on the PROGRAM, discharged against the declared
    // causal graph when the annotation was lowered, not a value the program
    // carries around. Same shape as the Invariant unwrap above, and for the same
    // reason -- an opaque wrapper is not numeric, so without this every use of a
    // claimed value is a false E004.
    if left.kind == TypeKind::TyCondIndep {
        match left.inner {
            Some(li) => return binary_result_type(op, *li, right),
            None => {},
        }
    }
    if right.kind == TypeKind::TyCondIndep {
        match right.inner {
            Some(ri) => return binary_result_type(op, left, *ri),
            None => {},
        }
    }


    match op {
        // Arithmetic: both numeric, result = left type
        BinaryOp::OpAdd => {
            if is_numeric_type(left) && types_compatible(left, right) {
                left
            } else if left.kind == TypeKind::TyString && right.kind == TypeKind::TyString {
                ty_string()
            } else if compat_is_hyper_type(left) && compat_is_hyper_type(right) {
                hyper_binary_result_type(left, right)
            } else {
                ty_error()
            }
        }
        BinaryOp::OpSub => {
            if is_numeric_type(left) && types_compatible(left, right) {
                left
            } else if compat_is_hyper_type(left) && compat_is_hyper_type(right) {
                hyper_binary_result_type(left, right)
            } else {
                ty_error()
            }
        }
        BinaryOp::OpMul => {
            if is_numeric_type(left) && types_compatible(left, right) {
                left
            } else if compat_is_hyper_type(left) && compat_is_hyper_type(right) {
                hyper_binary_result_type(left, right)
            } else {
                ty_error()
            }
        }
        BinaryOp::OpDiv => {
            if is_numeric_type(left) && types_compatible(left, right) {
                left
            } else if compat_is_hyper_type(left) && compat_is_hyper_type(right) {
                hyper_division_result_type(left, right)
            } else {
                ty_error()
            }
        }
        BinaryOp::OpRem => {
            if is_numeric_type(left) && types_compatible(left, right) {
                left
            } else {
                ty_error()
            }
        }

        // Comparison: both same type, result = bool
        BinaryOp::OpEq => {
            if types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpNe => {
            if types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpLt => {
            if is_numeric_type(left) && types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpLe => {
            if is_numeric_type(left) && types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpGt => {
            if is_numeric_type(left) && types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpGe => {
            if is_numeric_type(left) && types_compatible(left, right) {
                ty_bool()
            } else {
                ty_error()
            }
        }

        // Logical: both bool, result = bool
        BinaryOp::OpAnd => {
            if is_bool_type(left) && is_bool_type(right) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        BinaryOp::OpOr => {
            if is_bool_type(left) && is_bool_type(right) {
                ty_bool()
            } else {
                ty_error()
            }
        }

        // Bitwise: both integer, result = LEFT operand type (#638: the old always-i64
        // result poisoned every i32 shift/mask context, e.g. `let half = 1 << (bits-1)`
        // with bits: i32 — the whole f64 Cayley-Dickson layer failed to import).
        // Acceptance domain unchanged (both integer, mixed widths still accepted);
        // only the RESULT type follows the left operand, mirroring the arithmetic arms.
        BinaryOp::OpBitAnd => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpBitOr => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpBitXor => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpShl => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpShr => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        // Findings 11 (#2084): unsigned counterparts share the rule shape with
        // their signed siblings -- both operands must be integer, the result
        // type follows the LEFT operand (matches OpBitAnd/OpShl pattern
        // established in #638). The runtime emits div/shr with the
        // unsigned variant; the type system does not need to know which
        // arithmetic signedness a /, %, or >> at this site will pick --
        // it only enforces the integer-domain precondition.
        BinaryOp::OpUDiv => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpURem => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }
        BinaryOp::OpUShr => {
            if is_integer_type(left) && is_integer_type(right) {
                left
            } else {
                ty_error()
            }
        }

        // Concat: arrays or strings
        BinaryOp::OpConcat => {
            if left.kind == TypeKind::TyString && right.kind == TypeKind::TyString {
                ty_string()
            } else if left.kind == TypeKind::TyArray && right.kind == TypeKind::TyArray {
                left
            } else {
                ty_error()
            }
        }

        // Range
        BinaryOp::OpRange => ty_unit()
        BinaryOp::OpRangeInclusive => ty_unit()
    }
}

// ============================================================
// Unary operator result types
// ============================================================

pub fn unary_result_type(op: UnaryOp, operand: TypeEntry) -> TypeEntry with Alloc {
    if is_error_or_unknown(operand) {
        return operand
    }
    if is_wide_float_type(operand) {
        match op {
            UnaryOp::OpNeg => return operand
            _ => return ty_error()
        }
    }

    match op {
        UnaryOp::OpNeg => {
            if is_numeric_type(operand) {
                operand
            } else {
                ty_error()
            }
        }
        UnaryOp::OpNot => {
            if is_bool_type(operand) {
                ty_bool()
            } else {
                ty_error()
            }
        }
        UnaryOp::OpRef => ty_ref(operand)
        UnaryOp::OpRefMut => ty_ref_mut(operand)
        UnaryOp::OpDeref => {
            if operand.kind == TypeKind::TyRawPtr {
                match operand.inner {
                    Some(inner_ty) => return *inner_ty,
                    None => return ty_error()
                }
            }
            match operand.inner {
                Some(inner_ty) => *inner_ty
                None => ty_error()
            }
        }
    }
}

// ============================================================
// Hypercomplex binary result types
// ============================================================

// Hyper binary result: both must be same algebra (or Cayley-Dickson widening)
pub fn hyper_binary_result_type(left: TypeEntry, right: TypeEntry) -> TypeEntry with Alloc {
    // Same algebra: result is same type
    if left.algebra_kind == right.algebra_kind {
        // Clifford: signatures must match
        if left.algebra_kind == 5 {
            if left.clifford_p != right.clifford_p || left.clifford_q != right.clifford_q {
                return ty_error()  // E030: incompatible Clifford signatures
            }
        }
        return left
    }
    // Cayley-Dickson tower widening: R < C < H < O < S
    if left.algebra_kind <= 4 && right.algebra_kind <= 4 {
        if left.algebra_kind > right.algebra_kind {
            return left
        }
        return right
    }
    // Clifford + Cayley-Dickson or different Clifford: incompatible
    ty_error()
}

// Division: only allowed for division algebras (R, C, H, O)
pub fn hyper_division_result_type(left: TypeEntry, right: TypeEntry) -> TypeEntry with Alloc {
    let result = hyper_binary_result_type(left, right)
    if result.kind == TypeKind::TyError {
        return result
    }
    // Division only valid for division algebras (Hurwitz: alg <= 3)
    if result.algebra_kind > 3 {
        return ty_error()  // E032: division on non-division algebra
    }
    result
}

// ============================================================
// Name helpers for builtin type checking
// ============================================================

// ============================================================
// Compound assignment to binary operator
// ============================================================

pub fn compound_assign_to_binop(op: AssignOp) -> BinaryOp {
    match op {
        AssignOp::AssignAdd => BinaryOp::OpAdd
        AssignOp::AssignSub => BinaryOp::OpSub
        AssignOp::AssignMul => BinaryOp::OpMul
        AssignOp::AssignDiv => BinaryOp::OpDiv
        AssignOp::AssignRem => BinaryOp::OpRem
        AssignOp::AssignEq => BinaryOp::OpAdd  // should not happen, fallback
    }
}

