pub fn name_is_char(n: Name) -> bool with Panic, Div {
    name_matches_str4(n, 99, 104, 97, 114)
}

// "string" = [115, 116, 114, 105, 110, 103]
pub fn name_is_string(n: Name) -> bool with Panic, Div {
    name_matches_str6(n, 115, 116, 114, 105, 110, 103)
}
