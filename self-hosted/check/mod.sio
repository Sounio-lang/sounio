fn check_mod_ontocache_knowledge_path_first_name(path: AstPath) -> Name {
    Name {
        buf: path.segments.head_buf,
        len: path.segments.head_len,
    }
}

fn check_mod_ontocache_knowledge_empty_name() -> Name {
    Name { buf: [0; 384], len: 0 }
}

fn check_mod_ontocache_knowledge_is_digit(ch: i8) -> bool {
    ch >= (48 as i8) && ch <= (57 as i8)
}

fn check_mod_ontocache_knowledge_suffix_id(name: Name) -> i64 {
    if name.len <= 2 {
        return 0 - 1
    }

    var end = name.len - 1
    if end >= 128 {
        end = 127
    }
    if !check_mod_ontocache_knowledge_is_digit(name.buf[end as usize]) {
        return 0 - 1
    }

    var start = end
    while start >= 0 && check_mod_ontocache_knowledge_is_digit(name.buf[start as usize]) {
        start = start - 1
    }
    if start < 0 || name.buf[start as usize] != (95 as i8) {
        return 0 - 1
    }

    var value: i64 = 0
    var i = start + 1
    while i <= end {
        value = (value * 10) + ((name.buf[i as usize] as i64) - 48)
        i = i + 1
    }
    value
}

fn check_mod_ontocache_knowledge_name_to_id(name: Name) -> i64 with Mut, Panic, Div {
    if ir_name_eq(name, make_name("cache_slot0")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[0] }
    if ir_name_eq(name, make_name("cache_slot1")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[1] }
    if ir_name_eq(name, make_name("cache_slot2")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[2] }
    if ir_name_eq(name, make_name("cache_slot3")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[3] }
    if ir_name_eq(name, make_name("cache_slot4")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[4] }
    if ir_name_eq(name, make_name("cache_slot5")) { return CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[5] }
    check_mod_ontocache_knowledge_suffix_id(name)
}

fn check_mod_ontocache_knowledge_field_type_in_fields(fields: Option<Box<FieldDefList> >, field_name: Name) -> Name with Mut, Panic, Div, Alloc {
    match fields {
        Some(list) => {
            let field = (*list).head
            if ir_name_eq(field.name, field_name) {
                if field.ty.kind == TypeExprKind::TypeNamed {
                    return check_mod_ontocache_knowledge_path_first_name(field.ty.path)
                }
                return check_mod_ontocache_knowledge_empty_name()
            }
            check_mod_ontocache_knowledge_field_type_in_fields((*list).tail, field_name)
        }
        None => check_mod_ontocache_knowledge_empty_name()
    }
}

fn check_mod_ontocache_knowledge_find_struct_field_type(items: Option<Box<ItemList> >, struct_name: Name, field_name: Name) -> Name with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemStruct && ir_name_eq(item.name, struct_name) {
                match item.struct_def {
                    Some(sd) => check_mod_ontocache_knowledge_field_type_in_fields((*sd).fields, field_name)
                    None => check_mod_ontocache_knowledge_empty_name()
                }
            } else {
                check_mod_ontocache_knowledge_find_struct_field_type((*list).tail, struct_name, field_name)
            }
        }
        None => check_mod_ontocache_knowledge_empty_name()
    }
}

fn check_mod_ontocache_knowledge_validate_constraints(items: Option<Box<ItemList> >, inner_name: Name, constraints: Option<Box<KnowledgeConstraintList> >) -> i64 with Mut, Panic, Div, Alloc {
    match constraints {
        Some(list) => {
            let constraint = (*list).head
            if constraint.kind == KnowledgeConstraintKind::KnowledgeConstraintSubclassOf {
                let field_type_name = check_mod_ontocache_knowledge_find_struct_field_type(items, inner_name, constraint.field)
                let field_id = check_mod_ontocache_knowledge_name_to_id(field_type_name)
                let target_id = check_mod_ontocache_knowledge_name_to_id(constraint.target_name)
                if field_id < 0 || target_id < 0 {
                    return 1
                }
                if check_mod_ontocache_sidecar_is_subclass(field_id, target_id) {
                    return check_mod_ontocache_knowledge_validate_constraints(items, inner_name, (*list).tail)
                }
                if check_mod_ontocache_sidecar_is_disjoint(field_id, target_id) {
                    return 1
                }
                return 1
            }
            check_mod_ontocache_knowledge_validate_constraints(items, inner_name, (*list).tail)
        }
        None => 0
    }
}

fn check_mod_ontocache_knowledge_validate_type(items: Option<Box<ItemList> >, ty: TypeExpr) -> i64 with Mut, Panic, Div, Alloc {
    if ty.kind != TypeExprKind::TypeKnowledge {
        return 0
    }
    match ty.knowledge_info {
        Some(info) => {
            let inner_ty = *(*info).inner_type
            if inner_ty.kind != TypeExprKind::TypeNamed {
                return 1
            }
            let inner_name = check_mod_ontocache_knowledge_path_first_name(inner_ty.path)
            check_mod_ontocache_knowledge_validate_constraints(items, inner_name, (*info).proof_constraints)
        }
        None => 0
    }
}

fn check_mod_ontocache_knowledge_validate_params(items: Option<Box<ItemList> >, params: Option<Box<ParamList> >) -> i64 with Mut, Panic, Div, Alloc {
    match params {
        Some(list) => {
            if check_mod_ontocache_knowledge_validate_type(items, (*list).head.ty) != 0 {
                return 1
            }
            check_mod_ontocache_knowledge_validate_params(items, (*list).tail)
        }
        None => 0
    }
}

fn check_mod_ontocache_knowledge_validate_fn(items: Option<Box<ItemList> >, opt: Option<Box<FnDef> >) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        Some(fd) => {
            if check_mod_ontocache_knowledge_validate_params(items, (*fd).params) != 0 {
                return 1
            }
            match (*fd).return_type {
                Some(ret_ty) => check_mod_ontocache_knowledge_validate_type(items, *ret_ty)
                None => 0
            }
        }
        None => 0
    }
}

fn check_mod_ontocache_knowledge_validate_from(root: Option<Box<ItemList> >, cursor: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc {
    match cursor {
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                if check_mod_ontocache_knowledge_validate_fn(root, item.fn_def) != 0 {
                    return 1
                }
            }
            check_mod_ontocache_knowledge_validate_from(root, (*list).tail)
        }
        None => 0
    }
}

pub fn check_knowledge_context_ontocache_sidecar_verdict_probe(items: Option<Box<ItemList>>, source_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    print("check_mod_knowledge_context_ontocache_sidecar=enter\n")
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    print("check_mod_knowledge_context_ontocache_sidecar=cache_valid\n")
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    checker_collect_items_mut(checker_ptr, items)
    print("check_mod_knowledge_context_ontocache_sidecar=collect_ok\n")
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker_ptr, items)
    print("check_mod_knowledge_context_ontocache_sidecar=check_ok\n")
    if had_error == 1 {
        heap_free(checker_ptr as i64)
        return 1
    }
    check_mod_ontocache_sidecar_hydrate_from_source(source_path)
    print("check_mod_knowledge_context_ontocache_sidecar=sidecar_hydrate_ok\n")
    print("check_mod_knowledge_context_ontocache_sidecar=sidecar_count=")
    print_int(CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT)
    print("\n")
    if check_mod_ontocache_knowledge_validate_from(items, items) == 0 {
        print("check_mod_knowledge_context_ontocache_sidecar=query_ok\n")
        heap_free(checker_ptr as i64)
        return ontology_side_table_cache_verdict_ok()
    }
    print("check_mod_knowledge_context_ontocache_sidecar=query_reject\n")
    heap_free(checker_ptr as i64)
    ontology_side_table_cache_verdict_reject()
}

pub fn check_items_verdict_boot4_with_ontocache_sidecar(items: Option<Box<ItemList>>, source_path: string, module_path: AstPath) -> i64 with IO, Mut, Panic, Div, Alloc {
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    (*checker_ptr).current_module = module_path
    (*checker_ptr).crate_root = module_path
    checker_collect_items_mut(checker_ptr, items)
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker_ptr, items)
    if had_error == 1 {
        heap_free(checker_ptr as i64)
        return 1
    }
    if check_items_ontology_verdict(items) != 0 {
        heap_free(checker_ptr as i64)
        return 1
    }
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        heap_free(checker_ptr as i64)
        return 0
    }
    check_mod_ontocache_sidecar_hydrate_from_source(source_path)
    if check_mod_ontocache_knowledge_validate_from(items, items) != 0 {
        heap_free(checker_ptr as i64)
        return 1
    }
    heap_free(checker_ptr as i64)
    0
}

pub fn check_ontology_side_table_cache_sourcecheck_disjoint_verdict_probe(items: Option<Box<ItemList>>, source_path: string, left_id: i64, right_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    let left_idx = check_mod_ontology_cache_slot_index(source_path, left_id)
    let right_idx = check_mod_ontology_cache_slot_index(source_path, right_id)
    if left_idx < 0 || right_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    checker_collect_items_mut(checker_ptr, items)
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker_ptr, items)
    if had_error == 1 {
        heap_free(checker_ptr as i64)
        return 1
    }
    var cache_checker = checker_new()
    cache_checker = check_mod_hydrate_ontology_kernel_from_side_table_cache(cache_checker, source_path)
    if ontology_kernel_is_disjoint(cache_checker.ontology_kernel, left_idx, right_idx) {
        heap_free(checker_ptr as i64)
        return ontology_side_table_cache_verdict_ok()
    }
    heap_free(checker_ptr as i64)
    ontology_side_table_cache_verdict_reject()
}

pub fn check_items_witness_from_seed(items: Option<Box<ItemList>>, seed: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
    var witness = seed
    var checker = checker_new()
    checker = checker.collect_items(items)
    witness = check_witness_mark_collect_ok(witness)
    checker = checker.check_items(items)
    witness = check_witness_mark_check_ok(witness)
    if checker.had_error {
        return check_witness_set_verdict(witness, check_witness_reject())
    }
    if checker.error_count > 0 {
        return check_witness_set_verdict(witness, check_witness_unknown())
    }
    check_witness_set_verdict(witness, check_witness_ok())
}

// Legacy driver-facing scalar verdict surface.
// Kept for compatibility, but prefer the richer witness helpers above.
fn check_program_verdict(prog: Program) -> i64 with Mut, Panic, Div, Alloc, IO {
    let witness = check_program_witness(prog)
    if check_witness_verdict(witness) == check_witness_reject() {
        1
    } else {
        0
    }
}

pub fn check_program_with_artifacts(prog: Program) -> CheckArtifactsResult with Mut, Panic, Div, Alloc, IO {
    var checker = checker_new()
    checker.current_module = prog.module_path
    // The crate root is the module being checked in single-module contexts.
    checker.crate_root = prog.module_path
    checker = checker.collect_items(prog.items)
    checker = checker.check_items(prog.items)
    checker = checker_verify_dsep_claims(checker)
    CheckArtifactsResult {
        error_count: checker.error_count,
        had_error: checker.had_error,
        checker: checker,
    }
}

fn check_program_epistemic(prog: Program) -> CheckEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: epistemic,
    }
}

fn check_program_boxed_ir_epistemic(prog: Program) -> CheckBoxedEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckBoxedEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: Box::new(epistemic),
    }
}
