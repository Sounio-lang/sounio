// Type Checker — entry point
//
// Runs the two-pass type checking algorithm on a Program AST:
//   Pass 1: collect struct/enum/fn definitions into tables
//   Pass 2: check function bodies for type consistency
//
// Returns a CheckResult with the error count.

module check::mod

use ir::ir::*
use parser::ast::*
use check::check::*
use check::defs::*
use check::types::{TypeEntry, TypeEntryList, TypeKind}
use check::ontology_side_table_cache::{
    ontology_side_table_cache_disjoint_verdict,
    ontology_side_table_cache_subclass_verdict,
    ontology_side_table_cache_source_disjoint_axiom_count,
    ontology_side_table_cache_source_disjoint_object0,
    ontology_side_table_cache_source_disjoint_subject0,
    ontology_side_table_cache_source_plan_valid,
    ontology_side_table_cache_source_slot_at,
    ontology_side_table_cache_source_slot_count,
    ontology_side_table_cache_source_subclass_axiom_count,
    ontology_side_table_cache_source_subclass_object_at,
    ontology_side_table_cache_source_subclass_subject_at,
    ontology_side_table_cache_verdict_invalid_cache,
    ontology_side_table_cache_verdict_ok,
    ontology_side_table_cache_verdict_reject,
}

pub struct CheckResult {
    error_count: i64,
    had_error: bool,
}

pub struct CheckArtifactsResult {
    error_count: i64,
    had_error: bool,
    checker: Checker,
}

pub struct CheckEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: IrEpistemicSection,
}

pub struct CheckBoxedEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: Box<IrEpistemicSection>,
}

var CHECK_MOD_ONTOCACHE_SIDECAR_VALID: bool = false
var CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT: i64 = 0
var CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS: [i64; 6] = [0; 6]
var CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS: [bool; 36] = [false; 36]
var CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT: [bool; 36] = [false; 36]

fn check_mod_alloc_checker() -> *mut Checker with Alloc {
    // The checker grew with the wider FnSigTable and TypeEnv capacities.
    // Keep boot4/probe heap allocations ahead of the struct size so in-place
    // checker paths cannot scribble past a stale literal allocation.
    heap_alloc(134217728) as *mut Checker
}

pub fn check_policy_requirements_to_ir(
    opt: Option<Box<PolicyRequirementInfoList>>,
    out: [IrPolicyRequirementInfo; 8],
    idx: i64
) -> [IrPolicyRequirementInfo; 8] with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = out
            if idx < 8 {
                next[idx as usize] = IrPolicyRequirementInfo {
                    metric_id: (*list).head.metric_id,
                    metric_name: (*list).head.metric_name,
                    op: (*list).head.op,
                    threshold: (*list).head.threshold,
                    threshold_kind: (*list).head.threshold_kind,
                    bool_threshold: (*list).head.bool_threshold,
                    name_threshold: (*list).head.name_threshold,
                }
            }
            check_policy_requirements_to_ir((*list).tail, next, idx + 1)
        }
        None => out
    }
}

pub fn checker_to_ir_epistemic_into(checker: &Checker, ep: &! IrEpistemicSection) with Mut, Panic, Div, Alloc {
    checker_export_ir_epistemic_into_local(checker, ep)
}

fn checker_to_ir_epistemic(checker: Checker) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    var ep = ir_empty_epistemic_section()
    checker_export_ir_epistemic_into_local(&checker, &!ep)
    ep
}

fn check_result_to_ir_epistemic(result: &CheckArtifactsResult) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    checker_to_ir_epistemic(result.checker)
}

fn checker_to_ir_algebras(checker: &Checker) -> IrAlgebraTable with Mut, Panic, Div, Alloc {
    var out = ir_empty_algebra_table()
    var i: i64 = 0
    while i < checker.algebras.count && i < 32 {
        let src = checker.algebras.entries[i]
        out.entries[i] = IrAlgebraInfo {
            name: src.name,
            add_commutative: src.add_commutative,
            add_associative: src.add_associative,
            mul_commutative: src.mul_commutative,
            mul_associative: src.mul_associative,
            mul_alternative: src.mul_alternative,
            reassoc_strategy: src.reassoc_strategy,
            algebra_tag: src.algebra_tag,
            is_valid: src.is_valid,
        }
        i = i + 1
    }
    out.count = if checker.algebras.count > 32 { 32 } else { checker.algebras.count }
    out
}

fn checker_to_ir_ontologies(checker: &Checker) -> IrOntologyTable with Mut, Panic, Div, Alloc {
    var out = ir_empty_ontology_table()
    var i: i64 = 0
    while i < checker.ontology_kernel.classes.count && i < 64 {
        let src = checker.ontology_kernel.classes.entries[i as usize]
        var superclass_count: i64 = 0
        var j: i64 = 0
        while j < checker.ontology_kernel.classes.count && j < 64 {
            if i != j && ontology_kernel_is_subclass(checker.ontology_kernel, i, j) {
                superclass_count = superclass_count + 1
            }
            j = j + 1
        }
        out.entries[i as usize] = IrOntologyClassInfo {
            name: src.name,
            ontology_name: src.ontology_name,
            class_index: src.class_index,
            superclass_count: superclass_count,
            is_valid: src.is_valid,
        }
        i = i + 1
    }
    out.count = if checker.ontology_kernel.classes.count > 64 { 64 } else { checker.ontology_kernel.classes.count }

    i = 0
    while i < checker.ontology_kernel.properties.count && i < 32 {
        let src = checker.ontology_kernel.properties.entries[i as usize]
        out.properties[i as usize] = IrOntologyPropertyInfo {
            name: src.name,
            property_index: src.property_index,
            domain_class_idx: src.domain_class_idx,
            range_class_idx: src.range_class_idx,
        }
        i = i + 1
    }
    out.property_count = if checker.ontology_kernel.properties.count > 32 { 32 } else { checker.ontology_kernel.properties.count }

    // Preserve source signature identity after type erasure. This remains
    // audit metadata: ontology-typed parameters can request evidence but do
    // not authorize optimizer rewrites.
    var sig_i: i64 = 0
    while sig_i < (*checker.fn_sigs).count && out.parameter_link_count < 128 {
        let sig = fn_sig_table_get(checker.fn_sigs, sig_i)
        var param_i: i64 = 0
        while param_i < sig.param_count && out.parameter_link_count < 128 {
            let param = fn_param_list_get(sig.params, param_i)
            let ontology_id = param.ty.ontology_id
            if ontology_id >= 0 && ontology_id < checker.ontologies.count {
                let cls = checker.ontologies.entries[ontology_id as usize]
                if cls.is_valid {
                    ir_ontology_table_record_parameter_link(&! out, sig.name, param_i, cls.name)
                }
            }
            param_i = param_i + 1
        }
        sig_i = sig_i + 1
    }
    out
}

// Mixed-Hyper optimizer metadata fix (Sprint ∞):
//
// When a function mixes Hyper algebras, instead of bailing entirely we compute
// the intersection of their reassociation rule sets — that is, we pick the most
// restrictive algebra kind present (the one whose reassoc_strategy is least
// permissive).  ocp_configure_small_context in opt_cleanup.sio then applies
// that conservative strategy to the small e-graph.
//
// Restrictiveness order:
//   free(0) < fano_selective(2) < blocked(1)
//   kind <= 2  → strategy 0 (free — always associative)
//   kind == 3  → strategy 2 (fano_selective — Octonion, alternative)
//   kind >= 4  → strategy 1 (blocked — Sedenion/Clifford, non-associative)
//
// When we mix e.g. Octonion(3) + Sedenion(4), the intersection is "blocked" →
// we stamp kind 4 (Sedenion) so the optimizer sees strategy 1 (blocked).
// When we mix Quaternion(2) + Octonion(3), we stamp kind 3 → fano_selective.

// Return the reassoc_strategy for a given algebra kind.
// Mirrors ocp_configure_small_context fallback logic in opt_cleanup.sio.
fn checker_reassoc_strategy_for_kind(kind: i64) -> i64 {
    if kind <= 2 { return 0 }  // Real/Complex/Quaternion: always associative
    if kind == 3 { return 2 }  // Octonion: fano_selective
    return 1                   // Sedenion, Clifford, unknown-large: blocked
}

// Given two algebra kinds, return the one whose reassoc_strategy is more
// restrictive (free=0 < fano_selective=2 < blocked=1).
fn checker_more_restrictive_alg_kind(a: i64, b: i64) -> i64 {
    let sa = checker_reassoc_strategy_for_kind(a)
    let sb = checker_reassoc_strategy_for_kind(b)
    // Restrictiveness: blocked(1) > fano_selective(2) > free(0).
    // We encode: blocked=10, fano_selective=2, free=0 for comparison.
    let ra = if sa == 1 { 10 } else { sa }
    let rb = if sb == 1 { 10 } else { sb }
    if rb > ra { return b }
    return a
}

pub struct CheckerHyperAlgCollectState {
    found_alg: i64,
    found_any: i64,
    ambiguous: i64,
}

fn checker_collect_hyper_alg_from_type_list(
    elems: Option<Box<TypeEntryList>>,
    state: CheckerHyperAlgCollectState
) -> CheckerHyperAlgCollectState with Mut, Panic, Div, Alloc {
    match elems {
        None => state
        Some(list) => {
            let after_head = checker_collect_hyper_alg_from_type((*list).head, state)
            checker_collect_hyper_alg_from_type_list((*list).tail, after_head)
        }
    }
}

fn checker_collect_hyper_alg_from_type(
    ty: TypeEntry,
    state: CheckerHyperAlgCollectState
) -> CheckerHyperAlgCollectState with Mut, Panic, Div, Alloc {
    var out = state
    if ty.kind == TypeKind::TyHyper {
        if out.found_any == 0 {
            out.found_any = 1
            out.found_alg = ty.algebra_kind
        } else if out.found_alg != ty.algebra_kind {
            // Mixed-Hyper: record as ambiguous but keep the more restrictive kind
            // so that callers can apply intersection strategy instead of bailing.
            out.ambiguous = 1
            out.found_alg = checker_more_restrictive_alg_kind(out.found_alg, ty.algebra_kind)
        }
    }
    match ty.inner {
        None => {}
        Some(inner) => {
            out = checker_collect_hyper_alg_from_type(*inner, out)
        }
    }
    checker_collect_hyper_alg_from_type_list(ty.tuple_elems, out)
}

fn checker_infer_fn_hyper_algebra(checker: &Checker, fn_name: Name) -> i64 with Mut, Panic, Div, Alloc {
    let sig_idx = fn_sig_table_find(checker.fn_sigs, fn_name)
    if sig_idx < 0 { return -1 }
    let sig = fn_sig_table_get(checker.fn_sigs, sig_idx)
    var state = CheckerHyperAlgCollectState { found_alg: -1, found_any: 0, ambiguous: 0 }

    state = checker_collect_hyper_alg_from_type(sig.return_type, state)
    if sig.is_method {
        state = checker_collect_hyper_alg_from_type(sig.self_type_entry, state)
    }

    var i: i64 = 0
    while i < sig.param_count {
        let param = fn_param_list_get(sig.params, i)
        state = checker_collect_hyper_alg_from_type(param.ty, state)
        i = i + 1
    }

    // Mixed-Hyper: if ambiguous (2+ distinct algebra kinds in signature), return the
    // most-restrictive kind computed by checker_collect_hyper_alg_from_type rather
    // than bailing with -1.  The optimizer (ocp_configure_small_context) then applies
    // the conservative intersection strategy for that kind.
    if state.found_any == 0 { return -1 }
    state.found_alg  // single kind OR most-restrictive kind when ambiguous
}

pub fn checker_apply_ir_metadata(checker: &Checker, module: &! IrModule) with Mut, Panic, Div, Alloc {
    (*module).algebras = checker_to_ir_algebras(checker)
    (*module).ontologies = checker_to_ir_ontologies(checker)
    var i: i64 = 0
    while i < (*module).fn_count {
        var fn_slot = ir_fn_get(&(*module), i)
        let fn_name = fn_slot.name
        fn_slot.hyper_algebra_kind = checker_infer_fn_hyper_algebra(checker, fn_name)
        ir_fn_set(&! (*module), i, fn_slot)
        i = i + 1
    }
}

// The caller must have completed its authoritative single- or multi-module
// typecheck first. This collection-only replay exports compact source metadata
// after lowering without making a second checker verdict authoritative.
pub fn checker_apply_ir_ontology_parameter_links_from_items(
    items: &Option<Box<ItemList>>,
    module: &! IrModule,
) with Mut, Panic, Div, Alloc, IO {
    var checker = checker_new()
    checker = checker.collect_items(*items)
    let collected = checker_to_ir_ontologies(&checker)
    // Preserve any semantic ontology table already installed by the
    // authoritative checker. This replay exports only audit identities.
    (*module).ontologies = ir_merge_ontology_parameter_links((*module).ontologies, collected)
}

fn check_program_ok(prog: Program) -> bool with Mut, Panic, Div, Alloc, IO {
    let result = check_program(prog)
    !result.had_error
}

pub fn check_program_epistemic_into(prog: Program, out: &! IrEpistemicSection) -> bool with Mut, Panic, Div, Alloc, IO {
    // Keep the wide Checker heap-owned through collection, checking, and
    // export. The artifact-returning path remains the by-value oracle.
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    (*checker_ptr).current_module = prog.module_path
    (*checker_ptr).crate_root = prog.module_path
    checker_collect_items_mut(checker_ptr, prog.items)
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker_ptr, prog.items)
    if had_error == 1 || (*checker_ptr).error_count > 0 {
        heap_free(checker_ptr as i64)
        return false
    }
    if check_items_ontology_verdict(prog.items) != 0 {
        heap_free(checker_ptr as i64)
        return false
    }
    checker_export_ir_epistemic_into_local(&(*checker_ptr), out)
    heap_free(checker_ptr as i64)
    true
}

fn make_hyper_expr_info(span: Span, algebra_tag: i64, op_kind: i64, knowledge_wrapped: bool, algebra_info: AlgebraInfo) -> IrHyperExprInfo with Mut, Panic, Div {
    IrHyperExprInfo {
        span_start: span.start,
        span_end: span.end,
        algebra_tag: algebra_tag,
        op_kind: op_kind,
        knowledge_wrapped: knowledge_wrapped,
        grade_mask: -1,
        grade_known: false,
        cl_p: 0,
        cl_q: 0,
        reassoc_strategy: algebra_info.reassoc_strategy,
        forbidden_law_mask: algebra_info.forbidden_law_mask,
        law_profile_source: 0,
        law_profile_fingerprint: 0,
    }
}

fn cd_hyper_law_profile_fingerprint(algebra_tag: i64, op_kind: i64, reassoc_strategy: i64, forbidden_law_mask: i64, law_profile_source: i64) -> i64 {
    0
}

pub(crate) fn check_hyper_expr_law_profile_probe(
    algebra_tag: i64,
    registry_reassoc_strategy: i64,
    registry_forbidden_law_mask: i64,
    register_algebra: bool
) -> IrHyperExprInfo with Mut, Panic, Div, Alloc {
    var algebra_info = empty_algebra_info()
    if register_algebra {
        algebra_info.is_valid = true
        algebra_info.algebra_tag = algebra_tag
        algebra_info.reassoc_strategy = registry_reassoc_strategy
        algebra_info.forbidden_law_mask = registry_forbidden_law_mask
    }
    let info = make_hyper_expr_info(Span { file_id: 0, start: 11, end: 29 }, algebra_tag, 1, false, algebra_info)
    IrHyperExprInfo {
        span_start: info.span_start,
        span_end: info.span_end,
        algebra_tag: info.algebra_tag,
        op_kind: info.op_kind,
        knowledge_wrapped: info.knowledge_wrapped,
        grade_mask: -1,
        grade_known: false,
        cl_p: 0,
        cl_q: 0,
        reassoc_strategy: 0,
        forbidden_law_mask: 0,
        law_profile_source: 0,
        law_profile_fingerprint: 0,
    }
}

pub(crate) fn check_hyper_expr_law_profile_audit_tag(info: IrHyperExprInfo) -> i64 with Mut, Panic, Div {
    let expected_fingerprint = cd_hyper_law_profile_fingerprint(
        info.algebra_tag,
        info.op_kind,
        info.reassoc_strategy,
        info.forbidden_law_mask,
        info.law_profile_source,
    )
    if expected_fingerprint != info.law_profile_fingerprint {
        return -1
    }

    let packed_algebra = (info.algebra_tag & 255) << 24
    let packed_op = (info.op_kind & 255) << 16
    let packed_reassoc = (info.reassoc_strategy & 255) << 8
    let packed_source = info.law_profile_source & 255
    packed_algebra + packed_op + packed_reassoc + packed_source
}


pub(crate) fn check_program(prog: Program) -> CheckResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    CheckResult {
        error_count: artifacts.error_count,
        had_error: artifacts.had_error,
    }
}

// Driver-facing scalar witness surface.
// Low nibble stores verdict:
//   0 = OK
//   1 = REJECT
//   2 = UNKNOWN
//   3 = INTERNAL_ERROR
// Higher bits store stage witnesses:
//   16  = load_ok
//   32  = parse_ok
//   64  = collect_ok
//   128 = check_ok
fn check_witness_ok() -> i64 with Div {
    0
}

fn check_witness_reject() -> i64 with Div {
    1
}

fn check_witness_unknown() -> i64 with Div {
    2
}

fn check_witness_internal_error() -> i64 with Div {
    3
}

fn check_witness_stage_load_ok() -> i64 with Div {
    16
}

fn check_witness_stage_parse_ok() -> i64 with Div {
    32
}

fn check_witness_stage_collect_ok() -> i64 with Div {
    64
}

fn check_witness_stage_check_ok() -> i64 with Div {
    128
}

fn check_witness_verdict(witness: i64) -> i64 with Div {
    witness % 16
}

fn check_witness_set_verdict(witness: i64, verdict: i64) -> i64 with Div {
    witness - (witness % 16) + verdict
}

fn check_witness_has_stage(witness: i64, flag: i64) -> bool with Div {
    ((witness / flag) % 2) == 1
}

fn check_witness_mark_stage(witness: i64, flag: i64) -> i64 with Div {
    if check_witness_has_stage(witness, flag) {
        witness
    } else {
        witness + flag
    }
}

fn check_witness_mark_load_ok(witness: i64) -> i64 with Div {
    check_witness_mark_stage(witness, check_witness_stage_load_ok())
}

fn check_witness_mark_parse_ok(witness: i64) -> i64 with Div {
    check_witness_mark_stage(witness, check_witness_stage_parse_ok())
}

fn check_witness_mark_collect_ok(witness: i64) -> i64 with Div {
    check_witness_mark_stage(witness, check_witness_stage_collect_ok())
}

fn check_witness_mark_check_ok(witness: i64) -> i64 with Div {
    check_witness_mark_stage(witness, check_witness_stage_check_ok())
}

fn check_witness_has_load_ok(witness: i64) -> bool with Div {
    check_witness_has_stage(witness, check_witness_stage_load_ok())
}

fn check_witness_has_parse_ok(witness: i64) -> bool with Div {
    check_witness_has_stage(witness, check_witness_stage_parse_ok())
}

fn check_witness_has_collect_ok(witness: i64) -> bool with Div {
    check_witness_has_stage(witness, check_witness_stage_collect_ok())
}

fn check_witness_has_check_ok(witness: i64) -> bool with Div {
    check_witness_has_stage(witness, check_witness_stage_check_ok())
}

fn check_program_witness_from_seed(prog: Program, seed: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
    var witness = seed
    var checker = checker_new()
    checker = checker.collect_items(prog.items)
    witness = check_witness_mark_collect_ok(witness)
    checker = checker.check_items(prog.items)
    witness = check_witness_mark_check_ok(witness)
    if checker.had_error {
        return check_witness_set_verdict(witness, check_witness_reject())
    }
    if checker.error_count > 0 {
        return check_witness_set_verdict(witness, check_witness_unknown())
    }
    check_witness_set_verdict(witness, check_witness_ok())
}

fn check_program_witness(prog: Program) -> i64 with Mut, Panic, Div, Alloc, IO {
    check_program_witness_from_seed(prog, check_witness_unknown())
}

// boot4-safe items verdict: uses *mut Checker to avoid IS_SPTR=4 struct-return corruption.
// Returns 0=ok, 1=reject, 2=unknown. Takes same items pointer as check_items_witness_from_seed.
pub fn check_items_verdict_boot4(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div, Alloc, IO {
    check_items_verdict_boot4_with_module_path(items, empty_path())
}

pub fn check_items_verdict_boot4_with_module_path(items: Option<Box<ItemList>>, module_path: AstPath) -> i64 with Mut, Panic, Div, Alloc, IO {
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    (*checker_ptr).current_module = module_path
    (*checker_ptr).crate_root = module_path
    checker_collect_items_mut(checker_ptr, items)
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker_ptr, items)
    // Collect lowers parameter types. A diagnostic recorded there (E201 on
    // ExactlyPrivate without ZD, or the always-refuse control) used to be
    // discarded: this verdict only inspected the check-pass had_error bit,
    // so `check: OK` and rc=0 while the checker had already failed. Honour
    // the recorded count before freeing the checker.
    let recorded = (*checker_ptr).error_count
    let noted = (*checker_ptr).had_error
    if had_error == 1 || recorded > 0 || noted {
        heap_free(checker_ptr as i64)
        return 1
    }
    heap_free(checker_ptr as i64)
    if check_items_ontology_verdict(items) != 0 {
        return 1
    }
    0
}

// Multi-module typecheck verdict: load all programs into a single checker so
// cross-module names are resolvable, but perform the visibility check with
// each program's real module_path as current_module.  Returns 0=ok, 1=reject.
// Ontology semantic verdict. The boot4/Madaros in-place checker spine
// (checker_collect_item_inplace) does not collect ItemOntology, so ontology
// role/property/inverse axiom violations (E156–E160) slip through. The by-value
// collect_ontology_def path cannot be reused here: threading the ~164KB Checker
// through its deep recursion is miscompiled by the native backend (the large-
// struct copy bug the *mut spine exists to avoid), so its error state is lost.
// Instead validate axioms in place over the parsed AST via
// checker_validate_ontology_items_inplace (no large copies). Returns 1 on any
// ontology axiom error, 0 when clean.
pub fn check_items_ontology_verdict(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div, Alloc, IO {
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    checker_validate_ontology_items_inplace(checker_ptr, items)
    let bad = if (*checker_ptr).had_error || (*checker_ptr).error_count > 0 { 1 } else { 0 }
    heap_free(checker_ptr as i64)
    bad
}

pub fn check_modules_verdict_boot4(programs: &! [Program; 256], count: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
    check_modules_verdict_boot4_with_visibility(programs, count, false)
}

pub fn check_modules_verdict_boot4_with_visibility(programs: &! [Program; 256], count: i64, enforce_visibility: bool) -> i64 with Mut, Panic, Div, Alloc, IO {
    if count <= 0 {
        return 0
    }
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    (*checker_ptr).crate_root = (*programs)[0].module_path
    // Visibility is authoritatively enforced by the per-module frontend pass
    // (load_multimodule_ir), which has each module's `use`-import context and grants
    // access to imported items. This all-modules-merged pass lacks that per-module
    // import context, so re-enforcing definition-visibility here produces false E175/
    // E176/E177 on the (legitimately imported) cross-module private functions that the
    // single-crate compiler relies on. Defer visibility to the frontend.
    (*checker_ptr).enforce_visibility = enforce_visibility

    // Pass 1: collect signatures/definitions from every module into one shared
    // set of tables.  Each item is stamped with its real defining_module so
    // visibility checks can distinguish same-module from cross-module access.
    var i: i64 = 0
    while i < count && i < 256 {
        (*checker_ptr).current_module = (*programs)[i as usize].module_path
        (*checker_ptr).current_module_id = i
        checker_collect_items_inplace(checker_ptr, (*programs)[i as usize].items)
        i = i + 1
    }

    // Pass 2: check function bodies module-by-module, with current_module set
    // to the module being checked.  This is what makes E175/E176/E177 fire on
    // cross-module access to private items.
    i = 0
    while i < count && i < 256 {
        (*checker_ptr).current_module = (*programs)[i as usize].module_path
        (*checker_ptr).current_module_id = i
        checker_check_items_mut(checker_ptr, (*programs)[i as usize].items)
        i = i + 1
    }

    // After every module: the graph and the claims are unit-global, and a claim
    // in one module may name a graph declared in another.
    checker_verify_dsep_claims_mut(checker_ptr)

    if (*checker_ptr).had_error || (*checker_ptr).error_count > 0 {
        heap_free(checker_ptr as i64)
        return 1
    }
    heap_free(checker_ptr as i64)

    // Ontology axiom validation per module (see check_items_ontology_verdict).
    var k: i64 = 0
    while k < count && k < 256 {
        if check_items_ontology_verdict((*programs)[k as usize].items) != 0 {
            return 1
        }
        k = k + 1
    }
    0
}

pub fn check_ontology_side_table_cache_subclass_verdict_probe(source_path: string, child_id: i64, parent_id: i64) -> i64 with IO, Mut, Panic, Div {
    ontology_side_table_cache_subclass_verdict(source_path, child_id, parent_id)
}

pub fn check_ontology_side_table_cache_disjoint_verdict_probe(source_path: string, left_id: i64, right_id: i64) -> i64 with IO, Mut, Panic, Div {
    ontology_side_table_cache_disjoint_verdict(source_path, left_id, right_id)
}

fn check_mod_ontology_cache_slot_name(idx: i64) -> Name with Mut, Panic, Div {
    if idx == 0 { return make_name("cache_slot0") }
    if idx == 1 { return make_name("cache_slot1") }
    if idx == 2 { return make_name("cache_slot2") }
    if idx == 3 { return make_name("cache_slot3") }
    if idx == 4 { return make_name("cache_slot4") }
    if idx == 5 { return make_name("cache_slot5") }
    make_name("cache_slot")
}

fn check_mod_ontology_cache_slot_index(source_path: string, id: i64) -> i64 with IO, Mut, Panic, Div {
    let count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < count && i < 6 {
        if ontology_side_table_cache_source_slot_at(source_path, i) == id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn check_mod_hydrate_ontology_kernel_from_side_table_cache(checker: Checker, source_path: string) -> Checker with IO, Mut, Panic, Div, Alloc {
    var c = checker
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return c
    }

    c.ontology_kernel = ontology_kernel_empty()
    let slot_count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < slot_count && i < 6 {
        let pair = ontology_kernel_add_class(c.ontology_kernel, check_mod_ontology_cache_slot_name(i), make_name("cache"))
        c.ontology_kernel = pair.0
        i = i + 1
    }

    let subclass_count = ontology_side_table_cache_source_subclass_axiom_count(source_path)
    i = 0
    while i < subclass_count && i < 4 {
        let subject = ontology_side_table_cache_source_subclass_subject_at(source_path, i)
        let object = ontology_side_table_cache_source_subclass_object_at(source_path, i)
        c.ontology_kernel = ontology_kernel_add_axiom(c.ontology_kernel, OntologyAxiom {
            axiom_type: owl_subclass_of(),
            subject_idx: subject,
            object_idx: object,
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        })
        i = i + 1
    }

    if ontology_side_table_cache_source_disjoint_axiom_count(source_path) > 0 {
        c.ontology_kernel = ontology_kernel_add_axiom(c.ontology_kernel, OntologyAxiom {
            axiom_type: owl_disjoint_classes(),
            subject_idx: ontology_side_table_cache_source_disjoint_subject0(source_path),
            object_idx: ontology_side_table_cache_source_disjoint_object0(source_path),
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        })
    }

    c.ontology_kernel = ontology_kernel_materialize(c.ontology_kernel)
    c.ontology_kernel.profile = ontology_kernel_check_profile(c.ontology_kernel)
    c
}

fn check_mod_hydrate_ontology_kernel_ptr_from_side_table_cache(checker_ptr: *mut Checker, source_path: string) with IO, Mut, Panic, Div, Alloc {
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return
    }

    (*checker_ptr).ontology_kernel.classes.count = 0
    (*checker_ptr).ontology_kernel.properties.count = 0
    (*checker_ptr).ontology_kernel.axioms.count = 0
    (*checker_ptr).ontology_kernel.profile.is_el = true
    (*checker_ptr).ontology_kernel.profile.is_ql = true
    (*checker_ptr).ontology_kernel.profile.is_rl = true
    (*checker_ptr).ontology_kernel.profile.is_dl = true

    var clear_idx: i64 = 0
    while clear_idx < 4096 {
        (*checker_ptr).ontology_kernel.materialized.subclass_matrix[clear_idx as usize] = false
        (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[clear_idx as usize] = false
        clear_idx = clear_idx + 1
    }

    clear_idx = 0
    while clear_idx < 1024 {
        (*checker_ptr).ontology_kernel.materialized.sub_property_matrix[clear_idx as usize] = false
        clear_idx = clear_idx + 1
    }

    clear_idx = 0
    while clear_idx < 512 {
        (*checker_ptr).ontology_kernel.materialized.class_property_axioms[clear_idx as usize] = 0 - 1
        clear_idx = clear_idx + 1
    }

    clear_idx = 0
    while clear_idx < 64 {
        (*checker_ptr).ontology_kernel.materialized.class_property_counts[clear_idx as usize] = 0
        clear_idx = clear_idx + 1
    }

    let slot_count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < slot_count && i < 6 {
        (*checker_ptr).ontology_kernel.classes.entries[i as usize] = OntologyClassEntry {
            name: check_mod_ontology_cache_slot_name(i),
            ontology_name: make_name("cache"),
            class_index: i,
            is_valid: true,
        }
        (*checker_ptr).ontology_kernel.classes.count = i + 1
        i = i + 1
    }

    let subclass_count = ontology_side_table_cache_source_subclass_axiom_count(source_path)
    i = 0
    while i < subclass_count && i < 4 {
        let subject = ontology_side_table_cache_source_subclass_subject_at(source_path, i)
        let object = ontology_side_table_cache_source_subclass_object_at(source_path, i)
        (*checker_ptr).ontology_kernel.axioms.axioms[(*checker_ptr).ontology_kernel.axioms.count as usize] = OntologyAxiom {
            axiom_type: owl_subclass_of(),
            subject_idx: subject,
            object_idx: object,
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        }
        (*checker_ptr).ontology_kernel.axioms.count = (*checker_ptr).ontology_kernel.axioms.count + 1
        i = i + 1
    }

    if ontology_side_table_cache_source_disjoint_axiom_count(source_path) > 0 {
        (*checker_ptr).ontology_kernel.axioms.axioms[(*checker_ptr).ontology_kernel.axioms.count as usize] = OntologyAxiom {
            axiom_type: owl_disjoint_classes(),
            subject_idx: ontology_side_table_cache_source_disjoint_subject0(source_path),
            object_idx: ontology_side_table_cache_source_disjoint_object0(source_path),
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        }
        (*checker_ptr).ontology_kernel.axioms.count = (*checker_ptr).ontology_kernel.axioms.count + 1
    }

    i = 0
    while i < (*checker_ptr).ontology_kernel.classes.count {
        (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(i, i) as usize] = true
        i = i + 1
    }

    i = 0
    while i < (*checker_ptr).ontology_kernel.axioms.count {
        let ax = (*checker_ptr).ontology_kernel.axioms.axioms[i as usize]
        if ax.axiom_type == owl_subclass_of() {
            if ax.subject_idx >= 0 && ax.subject_idx < (*checker_ptr).ontology_kernel.classes.count && ax.object_idx >= 0 && ax.object_idx < (*checker_ptr).ontology_kernel.classes.count {
                (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
            }
        }
        else if ax.axiom_type == owl_disjoint_classes() {
            if ax.subject_idx >= 0 && ax.subject_idx < (*checker_ptr).ontology_kernel.classes.count && ax.object_idx >= 0 && ax.object_idx < (*checker_ptr).ontology_kernel.classes.count {
                (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
                (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(ax.object_idx, ax.subject_idx) as usize] = true
                (*checker_ptr).ontology_kernel.profile.is_el = false
            }
        }
        i = i + 1
    }

    var mid: i64 = 0
    while mid < (*checker_ptr).ontology_kernel.classes.count {
        var src: i64 = 0
        while src < (*checker_ptr).ontology_kernel.classes.count {
            if (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(src, mid) as usize] {
                var dst: i64 = 0
                while dst < (*checker_ptr).ontology_kernel.classes.count {
                    if (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(mid, dst) as usize] {
                        (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(src, dst) as usize] = true
                    }
                    dst = dst + 1
                }
            }
            src = src + 1
        }
        mid = mid + 1
    }

    var x: i64 = 0
    while x < (*checker_ptr).ontology_kernel.classes.count {
        var a: i64 = 0
        while a < (*checker_ptr).ontology_kernel.classes.count {
            if (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(x, a) as usize] {
                var b: i64 = 0
                while b < (*checker_ptr).ontology_kernel.classes.count {
                    if (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(a, b) as usize] {
                        (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(x, b) as usize] = true
                        (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(b, x) as usize] = true
                    }
                    b = b + 1
                }
            }
            a = a + 1
        }
        x = x + 1
    }
}

fn check_mod_ontology_kernel_ptr_is_subclass(checker_ptr: *mut Checker, child_idx: i64, parent_idx: i64) -> bool with Mut, Panic, Div {
    if child_idx < 0 || parent_idx < 0 || child_idx >= (*checker_ptr).ontology_kernel.classes.count || parent_idx >= (*checker_ptr).ontology_kernel.classes.count {
        return false
    }
    (*checker_ptr).ontology_kernel.materialized.subclass_matrix[ontology_kernel_class_matrix_index(child_idx, parent_idx) as usize]
}

fn check_mod_ontology_kernel_ptr_is_disjoint(checker_ptr: *mut Checker, left_idx: i64, right_idx: i64) -> bool with Mut, Panic, Div {
    if left_idx < 0 || right_idx < 0 || left_idx >= (*checker_ptr).ontology_kernel.classes.count || right_idx >= (*checker_ptr).ontology_kernel.classes.count {
        return false
    }
    (*checker_ptr).ontology_kernel.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(left_idx, right_idx) as usize]
}

fn check_mod_cache_shadow_matrix_index(child_idx: i64, parent_idx: i64) -> i64 {
    child_idx * 6 + parent_idx
}

fn check_mod_ontocache_sidecar_reset() with Mut {
    CHECK_MOD_ONTOCACHE_SIDECAR_VALID = false
    CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT = 0
    var i: i64 = 0
    while i < 6 {
        CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[i as usize] = 0 - 1
        i = i + 1
    }
    i = 0
    while i < 36 {
        CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[i as usize] = false
        CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[i as usize] = false
        i = i + 1
    }
}

fn check_mod_ontocache_sidecar_hydrate_from_source(source_path: string) with IO, Mut, Panic, Div {
    check_mod_ontocache_sidecar_reset()
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return
    }

    let slot_count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < slot_count && i < 6 {
        CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[i as usize] = ontology_side_table_cache_source_slot_at(source_path, i)
        CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT = i + 1
        i = i + 1
    }

    i = 0
    while i < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
        CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(i, i) as usize] = true
        i = i + 1
    }

    let subclass_count = ontology_side_table_cache_source_subclass_axiom_count(source_path)
    i = 0
    while i < subclass_count && i < 4 {
        let subject = ontology_side_table_cache_source_subclass_subject_at(source_path, i)
        let object = ontology_side_table_cache_source_subclass_object_at(source_path, i)
        if subject >= 0 && subject < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT && object >= 0 && object < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
            CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(subject, object) as usize] = true
        }
        i = i + 1
    }

    if ontology_side_table_cache_source_disjoint_axiom_count(source_path) > 0 {
        let left = ontology_side_table_cache_source_disjoint_subject0(source_path)
        let right = ontology_side_table_cache_source_disjoint_object0(source_path)
        if left >= 0 && left < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT && right >= 0 && right < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
            CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(left, right) as usize] = true
            CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(right, left) as usize] = true
        }
    }

    var mid: i64 = 0
    while mid < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
        var src: i64 = 0
        while src < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
            if CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(src, mid) as usize] {
                var dst: i64 = 0
                while dst < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
                    if CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(mid, dst) as usize] {
                        CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(src, dst) as usize] = true
                    }
                    dst = dst + 1
                }
            }
            src = src + 1
        }
        mid = mid + 1
    }

    var x: i64 = 0
    while x < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
        var a: i64 = 0
        while a < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
            if CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(x, a) as usize] {
                var b: i64 = 0
                while b < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT {
                    if CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(a, b) as usize] {
                        CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(x, b) as usize] = true
                        CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(b, x) as usize] = true
                    }
                    b = b + 1
                }
            }
            a = a + 1
        }
        x = x + 1
    }

    CHECK_MOD_ONTOCACHE_SIDECAR_VALID = CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT > 0
}

fn check_mod_ontocache_sidecar_slot_index(id: i64) -> i64 {
    var i: i64 = 0
    while i < CHECK_MOD_ONTOCACHE_SIDECAR_SLOT_COUNT && i < 6 {
        if CHECK_MOD_ONTOCACHE_SIDECAR_SLOTS[i as usize] == id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn check_mod_ontocache_sidecar_is_subclass(child_id: i64, parent_id: i64) -> bool {
    if !CHECK_MOD_ONTOCACHE_SIDECAR_VALID {
        return false
    }
    let child_idx = check_mod_ontocache_sidecar_slot_index(child_id)
    let parent_idx = check_mod_ontocache_sidecar_slot_index(parent_id)
    if child_idx < 0 || parent_idx < 0 {
        return false
    }
    CHECK_MOD_ONTOCACHE_SIDECAR_SUBCLASS[check_mod_cache_shadow_matrix_index(child_idx, parent_idx) as usize]
}

fn check_mod_ontocache_sidecar_is_disjoint(left_id: i64, right_id: i64) -> bool {
    if !CHECK_MOD_ONTOCACHE_SIDECAR_VALID {
        return false
    }
    let left_idx = check_mod_ontocache_sidecar_slot_index(left_id)
    let right_idx = check_mod_ontocache_sidecar_slot_index(right_id)
    if left_idx < 0 || right_idx < 0 {
        return false
    }
    CHECK_MOD_ONTOCACHE_SIDECAR_DISJOINT[check_mod_cache_shadow_matrix_index(left_idx, right_idx) as usize]
}

fn check_mod_hydrate_cache_shadow_ptr_from_side_table_cache(checker_ptr: *mut Checker, source_path: string) with IO, Mut, Panic, Div, Alloc {
    (*checker_ptr).ontology_cache_shadow_slot_count = 0
    (*checker_ptr).ontology_cache_shadow_slots = [0; 6]
    (*checker_ptr).ontology_cache_shadow_subclass_matrix = [false; 36]
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return
    }

    let slot_count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < slot_count && i < 6 {
        (*checker_ptr).ontology_cache_shadow_slots[i as usize] = ontology_side_table_cache_source_slot_at(source_path, i)
        (*checker_ptr).ontology_cache_shadow_slot_count = i + 1
        i = i + 1
    }

    i = 0
    while i < (*checker_ptr).ontology_cache_shadow_slot_count {
        (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(i, i) as usize] = true
        i = i + 1
    }

    let subclass_count = ontology_side_table_cache_source_subclass_axiom_count(source_path)
    i = 0
    while i < subclass_count && i < 4 {
        let subject = ontology_side_table_cache_source_subclass_subject_at(source_path, i)
        let object = ontology_side_table_cache_source_subclass_object_at(source_path, i)
        if subject >= 0 && subject < (*checker_ptr).ontology_cache_shadow_slot_count && object >= 0 && object < (*checker_ptr).ontology_cache_shadow_slot_count {
            (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(subject, object) as usize] = true
        }
        i = i + 1
    }

    var mid: i64 = 0
    while mid < (*checker_ptr).ontology_cache_shadow_slot_count {
        var src: i64 = 0
        while src < (*checker_ptr).ontology_cache_shadow_slot_count {
            if (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(src, mid) as usize] {
                var dst: i64 = 0
                while dst < (*checker_ptr).ontology_cache_shadow_slot_count {
                    if (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(mid, dst) as usize] {
                        (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(src, dst) as usize] = true
                    }
                    dst = dst + 1
                }
            }
            src = src + 1
        }
        mid = mid + 1
    }
}

fn check_mod_cache_shadow_ptr_is_subclass(checker_ptr: *mut Checker, child_id: i64, parent_id: i64) -> bool with Mut, Panic, Div {
    var child_idx: i64 = 0 - 1
    var parent_idx: i64 = 0 - 1
    var i: i64 = 0
    while i < (*checker_ptr).ontology_cache_shadow_slot_count && i < 6 {
        if (*checker_ptr).ontology_cache_shadow_slots[i as usize] == child_id {
            child_idx = i
        }
        if (*checker_ptr).ontology_cache_shadow_slots[i as usize] == parent_id {
            parent_idx = i
        }
        i = i + 1
    }
    if child_idx < 0 || parent_idx < 0 {
        return false
    }
    (*checker_ptr).ontology_cache_shadow_subclass_matrix[check_mod_cache_shadow_matrix_index(child_idx, parent_idx) as usize]
}

pub fn check_ontology_side_table_cache_sourcecheck_subclass_verdict_probe(items: Option<Box<ItemList>>, source_path: string, child_id: i64, parent_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    print("check_mod_sourcecheck_cache_subclass_verdict=enter\n")
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    print("check_mod_sourcecheck_cache_subclass_verdict=cache_valid\n")
    let child_idx = check_mod_ontology_cache_slot_index(source_path, child_id)
    let parent_idx = check_mod_ontology_cache_slot_index(source_path, parent_id)
    print("check_mod_sourcecheck_cache_subclass_verdict=child_idx=")
    print_int(child_idx)
    print("\n")
    print("check_mod_sourcecheck_cache_subclass_verdict=parent_idx=")
    print_int(parent_idx)
    print("\n")
    if child_idx < 0 || parent_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    print("check_mod_sourcecheck_cache_subclass_verdict=idx_ok\n")
    let checker_ptr = check_mod_alloc_checker()
    checker_init_in_place(checker_ptr)
    checker_collect_items_mut(checker_ptr, items)
    print("check_mod_sourcecheck_cache_subclass_verdict=collect_ok\n")
