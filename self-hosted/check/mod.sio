// Type Checker — entry point
//
// Runs the two-pass type checking algorithm on a Program AST:
//   Pass 1: collect struct/enum/fn definitions into tables
//   Pass 2: check function bodies for type consistency
//
// Returns a CheckResult with the error count.

use parser::ast::*

struct CheckResult {
    error_count: i64,
    had_error: bool,
}

fn check_program(prog: Program) -> CheckResult with Mut, Panic, Div, Alloc, IO {
    var c = checker_new()

    // Pass 1: collect definitions
    c = c.collect_items(prog.items)

    // Pass 2: check bodies
    c = c.check_items(prog.items)

    CheckResult {
        error_count: c.error_count,
        had_error: c.had_error,
    }
}
