// ============================================================
// TEST 26: Compile — single wildcard produces leaf
// ============================================================

fn test_pdt_compile_single_wild_leaf() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1
    m = pdt_matrix_add_row(m, pdt_make_wild_row(99))
    let tree = pdt_compile(m, PDT_HEURISTIC_LEFTMOST)
    let root = pdt_tree_get_node(tree, tree.root_idx)
