// ============================================================
// TEST 35: Specialize preserves action IDs
// ============================================================

fn test_pdt_specialize_preserves_actions() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_make_bool_matrix()
    m = pdt_matrix_add_row(m, pdt_make_bool_row(1, 100))
    m = pdt_matrix_add_row(m, pdt_make_bool_row(0, 200))
    m = pdt_matrix_add_row(m, pdt_make_wild_row(300))

    let spec_false = pdt_specialize(m, 0, 0)
    // Should have rows: false (200) and wildcard (300)
    let ok1 = spec_false.row_count == 2
    let r0 = pdt_matrix_get_row(spec_false, 0)
    let r1 = pdt_matrix_get_row(spec_false, 1)
    let ok2 = r0.action_id == 200
    let ok3 = r1.action_id == 300
    pdt_assert_true(ok1 && ok2 && ok3, 35)
}

// ============================================================
// TEST 36: Multiple bindings in a row
// ============================================================

fn test_pdt_multiple_bindings() -> i64 with IO, Mut, Panic, Div {
    var row = pdt_row_new()
    row.col_count = 3
    row.action_id = 7
    row = pdt_row_set_col(row, 0, PDT_WILDCARD, 0)
    row = pdt_row_set_binding(row, 0, 10)
    row = pdt_row_set_col(row, 1, PDT_WILDCARD, 0)
    row = pdt_row_set_binding(row, 1, 20)
    row = pdt_row_set_col(row, 2, PDT_WILDCARD, 0)
    row = pdt_row_set_binding(row, 2, 30)

    let result = pdt_collect_bindings(row)
    let count = result.0
    let binds = result.1
    let ok1 = count == 3
    let ok2 = binds[0].name_id == 10
    let ok3 = binds[1].name_id == 20
    let ok4 = binds[2].name_id == 30
    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 36)
}

// ============================================================
// TEST 37: Compile with binding propagation
// ============================================================

fn test_pdt_compile_with_bindings() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1

    var row = pdt_row_new()
    row.col_count = 1
    row.action_id = 55
    row = pdt_row_set_col(row, 0, PDT_WILDCARD, 0)
    row = pdt_row_set_binding(row, 0, 77)
    m = pdt_matrix_add_row(m, row)

    let tree = pdt_compile(m, PDT_HEURISTIC_LEFTMOST)
    let root = pdt_tree_get_node(tree, tree.root_idx)
    let ok1 = root.kind == PDT_NODE_LEAF
    let ok2 = root.leaf_action_id == 55
    let ok3 = root.bind_count == 1
    let ok4 = root.var_bindings[0].name_id == 77
    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 37)
}

// ============================================================
// TEST 38: 3-constructor enum — decision tree has test chain
// ============================================================

fn test_pdt_compile_enum_3() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1
    var meta = pdt_column_new(0)
    meta.is_variant = true
    meta.variant_count = 3
    m = pdt_matrix_set_col_meta(m, 0, meta)

    m = pdt_matrix_add_row(m, pdt_make_ctor_row(0, 10))
    m = pdt_matrix_add_row(m, pdt_make_ctor_row(1, 20))
    m = pdt_matrix_add_row(m, pdt_make_ctor_row(2, 30))

    let tree = pdt_compile(m, PDT_HEURISTIC_LEFTMOST)
    let root = pdt_tree_get_node(tree, tree.root_idx)

    // Root should be a TEST node (first constructor in chain)
    let ok1 = root.kind == PDT_NODE_TEST
    // Walk the true branch: should lead to a leaf
    let t_node = pdt_tree_get_node(tree, root.true_child)
    let ok2 = t_node.kind == PDT_NODE_LEAF

    pdt_assert_true(ok1 && ok2, 38)
}

// ============================================================
// TEST 39: Decision tree node accessors
// ============================================================

fn test_pdt_tree_node_accessors() -> i64 with IO, Mut, Panic, Div {
    var tree = pdt_decision_tree_new()

    let leaf = pdt_node_leaf(42)
    let p1 = pdt_tree_add_node(tree, leaf)
    tree = p1.0
    let leaf_idx = p1.1

    let test = pdt_node_test(3, 7, leaf_idx, leaf_idx)
    let p2 = pdt_tree_add_node(tree, test)
    tree = p2.0
    let test_idx = p2.1

    let fail = pdt_node_fail()
    let p3 = pdt_tree_add_node(tree, fail)
    tree = p3.0
    let fail_idx = p3.1

    let n_leaf = pdt_tree_get_node(tree, leaf_idx)
    let n_test = pdt_tree_get_node(tree, test_idx)
    let n_fail = pdt_tree_get_node(tree, fail_idx)

    let ok1 = n_leaf.kind == PDT_NODE_LEAF && n_leaf.leaf_action_id == 42
    let ok2 = n_test.kind == PDT_NODE_TEST && n_test.column_idx == 3
    let ok3 = n_test.test_value == 7
    let ok4 = n_fail.kind == PDT_NODE_FAIL
    let ok5 = tree.node_count == 3

    pdt_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 39)
}

// ============================================================
// TEST 40: Specialize multi-column matrix
// ============================================================

fn test_pdt_specialize_multi_col() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 2

    var r1 = pdt_row_new()
    r1.col_count = 2
    r1.action_id = 1
    r1 = pdt_row_set_col(r1, 0, PDT_LITERAL, 10)
    r1 = pdt_row_set_col(r1, 1, PDT_LITERAL, 20)
    m = pdt_matrix_add_row(m, r1)

    var r2 = pdt_row_new()
    r2.col_count = 2
    r2.action_id = 2
    r2 = pdt_row_set_col(r2, 0, PDT_LITERAL, 10)
    r2 = pdt_row_set_col(r2, 1, PDT_LITERAL, 30)
    m = pdt_matrix_add_row(m, r2)

    var r3 = pdt_row_new()
    r3.col_count = 2
    r3.action_id = 3
    r3 = pdt_row_set_col(r3, 0, PDT_WILDCARD, 0)
    r3 = pdt_row_set_col(r3, 1, PDT_LITERAL, 40)
    m = pdt_matrix_add_row(m, r3)

    // Specialize col 0 for value 10
    let spec = pdt_specialize(m, 0, 10)
    // Should have 3 rows (rows 1, 2 match ctor 10; row 3 is wildcard)
    let ok1 = spec.row_count == 3
    // All should have col_count = 1 (column 0 removed)
    let ok2 = spec.col_count == 1
    // Check action IDs preserved
    let sr0 = pdt_matrix_get_row(spec, 0)
    let sr1 = pdt_matrix_get_row(spec, 1)
    let sr2 = pdt_matrix_get_row(spec, 2)
    let ok3 = sr0.action_id == 1
    let ok4 = sr1.action_id == 2
    let ok5 = sr2.action_id == 3

    pdt_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 40)
}

// ============================================================
// TEST 41: Collect constructors
// ============================================================

fn test_pdt_collect_ctors() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1

    m = pdt_matrix_add_row(m, pdt_make_ctor_row(5, 0))
    m = pdt_matrix_add_row(m, pdt_make_ctor_row(3, 1))
    m = pdt_matrix_add_row(m, pdt_make_ctor_row(5, 2))
    m = pdt_matrix_add_row(m, pdt_make_wild_row(3))

    let ctors = pdt_collect_ctors(m, 0)
    // Should have 2 unique: 5 and 3
    let ok1 = ctors.count == 2
    // Order: 5 first, then 3
    let ok2 = ctors.values[0] == 5
    let ok3 = ctors.values[1] == 3
    pdt_assert_true(ok1 && ok2 && ok3, 41)
}

// ============================================================
// TEST 42: Guard row counted as wildcard for default matrix
// ============================================================

fn test_pdt_guard_default_matrix() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_make_bool_matrix()
    m = pdt_matrix_add_row(m, pdt_make_bool_row(1, 0))

    var guarded = pdt_make_wild_row(1)
    guarded = pdt_row_set_guard(guarded, 3)
    m = pdt_matrix_add_row(m, guarded)

    // Default matrix (wildcard rows)
    let def = pdt_default_matrix(m, 0)
    // The guarded wildcard row should appear in the default
    let ok1 = def.row_count == 1
    let r0 = pdt_matrix_get_row(def, 0)
    let ok2 = r0.action_id == 1
    let ok3 = r0.guard_id == 3
    pdt_assert_true(ok1 && ok2 && ok3, 42)
}

// ============================================================
// TEST 43: Row kind/value encoding
// ============================================================

fn test_pdt_row_encoding() -> i64 with IO, Mut, Panic, Div {
    var r = pdt_row_new()
    r = pdt_row_set_col(r, 0, PDT_LITERAL, 42)
    r = pdt_row_set_col(r, 1, PDT_CONSTRUCTOR, 7)
    r = pdt_row_set_col(r, 2, PDT_WILDCARD, 0)

    let ok1 = pdt_row_get_kind(r, 0) == PDT_LITERAL
    let ok2 = pdt_row_get_value(r, 0) == 42
    let ok3 = pdt_row_get_kind(r, 1) == PDT_CONSTRUCTOR
    let ok4 = pdt_row_get_value(r, 1) == 7
    let ok5 = pdt_row_get_kind(r, 2) == PDT_WILDCARD
    let ok6 = pdt_row_is_wild(r, 2)
    let ok7 = !pdt_row_is_wild(r, 0)

    pdt_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7, 43)
}

// ============================================================
// TEST 44: PdtCompiler error tracking
// ============================================================

fn test_pdt_compiler_errors() -> i64 with IO, Mut, Panic, Div {
    var pc = pdt_compiler_new()
    pc = pdt_compiler_add_error(pc, 10)
    pc = pdt_compiler_add_error(pc, 20)
    pc = pdt_compiler_add_error(pc, 30)

    let ok1 = pc.error_count == 3
    let ok2 = pc.errors[0] == 10
    let ok3 = pc.errors[1] == 20
    let ok4 = pc.errors[2] == 30
    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 44)
}

// ============================================================
// TEST 45: Compile 2-column matrix with heuristic
// ============================================================

fn test_pdt_compile_2col_heuristic() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 2

    var meta0 = pdt_column_new(0)
    m = pdt_matrix_set_col_meta(m, 0, meta0)

    var meta1 = pdt_column_new(1)
    meta1.is_variant = true
    meta1.variant_count = 2
    m = pdt_matrix_set_col_meta(m, 1, meta1)

    // Col 0: all wildcards.  Col 1: bool patterns
    var r1 = pdt_row_new()
    r1.col_count = 2
    r1.action_id = 10
    r1 = pdt_row_set_col(r1, 0, PDT_WILDCARD, 0)
    r1 = pdt_row_set_col(r1, 1, PDT_LITERAL, 1)
    m = pdt_matrix_add_row(m, r1)

    var r2 = pdt_row_new()
    r2.col_count = 2
    r2.action_id = 20
    r2 = pdt_row_set_col(r2, 0, PDT_WILDCARD, 0)
    r2 = pdt_row_set_col(r2, 1, PDT_LITERAL, 0)
    m = pdt_matrix_add_row(m, r2)

    // With MOST_CONSTRUCTORS, col 1 should be picked (2 unique ctors vs 0)
    let tree = pdt_compile(m, PDT_HEURISTIC_MOST_CONSTRUCTORS)
    let root = pdt_tree_get_node(tree, tree.root_idx)
    // Root should be a TEST on column 1
    let ok1 = root.kind == PDT_NODE_TEST
    let ok2 = root.column_idx == 1
    pdt_assert_true(ok1 && ok2, 45)
}

// ============================================================
// TEST 46: Find missing ctor — all covered returns -1
// ============================================================

fn test_pdt_find_missing_none() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1
    var meta = pdt_column_new(0)
    meta.is_variant = true
    meta.variant_count = 2
    m = pdt_matrix_set_col_meta(m, 0, meta)

    m = pdt_matrix_add_row(m, pdt_make_ctor_row(0, 0))
    m = pdt_matrix_add_row(m, pdt_make_ctor_row(1, 1))

    let missing = pdt_find_missing_ctor(m, 0)
    pdt_assert_true(missing == 0 - 1, 46)
}

// ============================================================
// TEST 47: PdtRow has_guard
// ============================================================

fn test_pdt_row_has_guard() -> i64 with IO, Mut, Panic, Div {
    var r1 = pdt_row_new()
    let ok1 = !pdt_row_has_guard(r1)

    var r2 = pdt_row_new()
    r2 = pdt_row_set_guard(r2, 5)
    let ok2 = pdt_row_has_guard(r2)

    pdt_assert_true(ok1 && ok2, 47)
}

// ============================================================
// TEST 48: Wildcard + literal exhaustive for open type
// ============================================================

fn test_pdt_open_type_with_wildcard() -> i64 with IO, Mut, Panic, Div {
    // Open type (variant_count=0): wildcards make it exhaustive
    var m = pdt_matrix_new()
    m.col_count = 1
    var meta = pdt_column_new(0)
    meta.is_variant = false
    meta.variant_count = 0
    m = pdt_matrix_set_col_meta(m, 0, meta)

    var r1 = pdt_row_new()
    r1.col_count = 1
    r1.action_id = 0
    r1 = pdt_row_set_col(r1, 0, PDT_LITERAL, 42)
    m = pdt_matrix_add_row(m, r1)

    m = pdt_matrix_add_row(m, pdt_make_wild_row(1))

    let result = pdt_is_exhaustive(m)
    pdt_assert_true(result, 48)
}

// ============================================================
// TEST 49: Open type without wildcard — NOT exhaustive
// ============================================================

fn test_pdt_open_type_no_wildcard() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 1
    var meta = pdt_column_new(0)
    meta.is_variant = false
    meta.variant_count = 0
    m = pdt_matrix_set_col_meta(m, 0, meta)

    var r1 = pdt_row_new()
    r1.col_count = 1
    r1.action_id = 0
    r1 = pdt_row_set_col(r1, 0, PDT_LITERAL, 42)
    m = pdt_matrix_add_row(m, r1)

    let result = pdt_is_exhaustive(m)
    pdt_assert_true(!result, 49)
}

// ============================================================
// TEST 50: Compile — wildcard fallback in test chain
// ============================================================

fn test_pdt_compile_with_wildcard_fallback() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_make_bool_matrix()
    m = pdt_matrix_add_row(m, pdt_make_bool_row(1, 10))
    m = pdt_matrix_add_row(m, pdt_make_wild_row(99))

    let tree = pdt_compile(m, PDT_HEURISTIC_LEFTMOST)
    let root = pdt_tree_get_node(tree, tree.root_idx)

    // Root is a TEST for value 1 (true)
    let ok1 = root.kind == PDT_NODE_TEST
    let ok2 = root.test_value == 1

    // false_child should lead to the wildcard's leaf (action 99)
    let false_node = pdt_tree_get_node(tree, root.false_child)
    let ok3 = false_node.kind == PDT_NODE_LEAF
    let ok4 = false_node.leaf_action_id == 99

    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 50)
}

