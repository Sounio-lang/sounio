    r2 = pdt_row_set_col(r2, 0, PDT_WILDCARD, 0)
    r2 = pdt_row_set_col(r2, 1, PDT_LITERAL, 6)
    m = pdt_matrix_add_row(m, r2)

    let ok1 = pdt_column_all_wild(m, 0)
    let ok2 = !pdt_column_all_wild(m, 1)
    pdt_assert_true(ok1 && ok2, 33)
}

// ============================================================
