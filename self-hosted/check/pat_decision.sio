// ============================================================
// TEST 27: Compile — bool match produces test chain
// ============================================================

fn test_pdt_compile_bool_match() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_make_bool_matrix()
    m = pdt_matrix_add_row(m, pdt_make_bool_row(1, 10))
    m = pdt_matrix_add_row(m, pdt_make_bool_row(0, 20))

    let tree = pdt_compile(m, PDT_HEURISTIC_LEFTMOST)
    let root = pdt_tree_get_node(tree, tree.root_idx)

    // Root should be a test node
    let ok1 = root.kind == PDT_NODE_TEST

    // The true_child should lead to a leaf with action 10
    let true_node = pdt_tree_get_node(tree, root.true_child)
    let ok2 = true_node.kind == PDT_NODE_LEAF
    let ok3 = true_node.leaf_action_id == 10

    pdt_assert_true(ok1 && ok2 && ok3, 27)
}

// ============================================================
// TEST 28: Range containment
// ============================================================

fn test_pdt_range_contains() -> i64 with IO, Mut, Panic, Div {
    let ok1 = pdt_range_contains(0, 10, 5)
    let ok2 = pdt_range_contains(0, 10, 0)
    let ok3 = pdt_range_contains(0, 10, 10)
    let ok4 = !pdt_range_contains(0, 10, 11)
    let ok5 = !pdt_range_contains(5, 10, 4)
    pdt_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 28)
}

// ============================================================
// TEST 29: Range overlap
// ============================================================

fn test_pdt_range_overlap() -> i64 with IO, Mut, Panic, Div {
    let ok1 = pdt_ranges_overlap(0, 5, 3, 8)
    let ok2 = pdt_ranges_overlap(0, 5, 5, 10)
    let ok3 = !pdt_ranges_overlap(0, 5, 6, 10)
    let ok4 = pdt_ranges_overlap(3, 3, 3, 3)
    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 29)
}

// ============================================================
// TEST 30: Ranges cover
// ============================================================

fn test_pdt_ranges_cover() -> i64 with IO, Mut, Panic, Div {
    // [0,2] + [3,5] covers [0,5]
    var ranges: [i64; 64] = [0; 64]
    ranges[0] = 0
    ranges[1] = 2
    ranges[2] = 3
    ranges[3] = 5
    let ok1 = pdt_ranges_cover(ranges, 2, 0, 5)

    // [0,2] + [4,5] does NOT cover [0,5] (gap at 3)
    var ranges2: [i64; 64] = [0; 64]
    ranges2[0] = 0
    ranges2[1] = 2
    ranges2[2] = 4
    ranges2[3] = 5
    let ok2 = !pdt_ranges_cover(ranges2, 2, 0, 5)

    pdt_assert_true(ok1 && ok2, 30)
}

// ============================================================
// TEST 31: Find gap in ranges
// ============================================================

fn test_pdt_ranges_find_gap() -> i64 with IO, Mut, Panic, Div {
    var ranges: [i64; 64] = [0; 64]
    ranges[0] = 0
    ranges[1] = 2
    ranges[2] = 4
    ranges[3] = 5
    let gap = pdt_ranges_find_gap(ranges, 2, 0, 5)
    pdt_assert_true(gap == 3, 31)
}

// ============================================================
// TEST 32: Column swap
// ============================================================

fn test_pdt_column_swap() -> i64 with IO, Mut, Panic, Div {
    var m = pdt_matrix_new()
    m.col_count = 2
    var meta0 = pdt_column_new(0)
    meta0.type_id = 100
    var meta1 = pdt_column_new(1)
    meta1.type_id = 200
    m = pdt_matrix_set_col_meta(m, 0, meta0)
    m = pdt_matrix_set_col_meta(m, 1, meta1)

    var r = pdt_row_new()
    r.col_count = 2
    r = pdt_row_set_col(r, 0, PDT_LITERAL, 1)
    r = pdt_row_set_col(r, 1, PDT_LITERAL, 2)
    m = pdt_matrix_add_row(m, r)

    m = pdt_matrix_swap_columns(m, 0, 1)

    // After swap: column 0 should have type_id 200, column 1 should have 100
    let new_meta0 = pdt_matrix_get_col_meta(m, 0)
    let new_meta1 = pdt_matrix_get_col_meta(m, 1)
    let ok1 = new_meta0.type_id == 200
    let ok2 = new_meta1.type_id == 100

    // Row values should be swapped too
    let row0 = pdt_matrix_get_row(m, 0)
    let ok3 = pdt_row_get_value(row0, 0) == 2
    let ok4 = pdt_row_get_value(row0, 1) == 1

    pdt_assert_true(ok1 && ok2 && ok3 && ok4, 32)
}

