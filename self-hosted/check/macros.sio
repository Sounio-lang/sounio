    tmpl = macro_template_add_gensym(tmpl)
    tmpl = macro_template_add_param_ref(tmpl, 1)

    let lc = macro_template_count_kind(tmpl, TOK_LITERAL)
    let pc = macro_template_count_kind(tmpl, TOK_PARAM_REF)
    let gc = macro_template_count_kind(tmpl, TOK_GENSYM)
    let ok1 = lc == 2
    let ok2 = pc == 2
    let ok3 = gc == 1
    macro_assert_true(ok1 && ok2 && ok3, 32)
}

