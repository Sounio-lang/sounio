// ============================================================
// Test 19: Pattern matching — exact match
// ============================================================

fn test_macro_match_exact() -> i64 with IO, Mut, Panic, Div {
    var d = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    var p = macro_param_new()
    p.kind = MACRO_PARAM_EXPR
    d = macro_def_add_param(d, p)
    var p2 = macro_param_new()
    p2.kind = MACRO_PARAM_TYPE
    d = macro_def_add_param(d, p2)

    // 2 args, kinds match
    var args = macro_args_new()
    var toks1: [i64; 32] = [0; 32]
    toks1[0] = 42
    args = macro_args_add(args, toks1, 1, MACRO_PARAM_EXPR)
    var toks2: [i64; 32] = [0; 32]
    toks2[0] = 7
    args = macro_args_add(args, toks2, 1, MACRO_PARAM_TYPE)

    let ok1 = macro_match_pattern(d, args)

    // Wrong count
    var args2 = macro_args_new()
    args2 = macro_args_add(args2, toks1, 1, MACRO_PARAM_EXPR)
    let ok2 = !macro_match_pattern(d, args2)

    macro_assert_true(ok1 && ok2, 19)
}

// ============================================================
// Test 20: Pattern matching — variadic
// ============================================================

fn test_macro_match_variadic() -> i64 with IO, Mut, Panic, Div {
    var d = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    var p1 = macro_param_new()
    p1.kind = MACRO_PARAM_EXPR
    d = macro_def_add_param(d, p1)
    var p2 = macro_param_new()
    p2.kind = MACRO_PARAM_EXPR
    p2.is_variadic = true
    d = macro_def_add_param(d, p2)

    // 3 args with variadic — should match (need >= 1 fixed)
    var args = macro_args_new()
    var toks: [i64; 32] = [0; 32]
    args = macro_args_add(args, toks, 1, MACRO_PARAM_EXPR)
    args = macro_args_add(args, toks, 1, MACRO_PARAM_EXPR)
    args = macro_args_add(args, toks, 1, MACRO_PARAM_EXPR)
    let ok1 = macro_match_pattern(d, args)

    // 1 arg — should match (1 fixed, 0 variadic)
    var args2 = macro_args_new()
    args2 = macro_args_add(args2, toks, 1, MACRO_PARAM_EXPR)
    let ok2 = macro_match_pattern(d, args2)

    // 0 args — should fail (need at least 1 for fixed param)
    let args3 = macro_args_new()
    let ok3 = !macro_match_pattern(d, args3)

    macro_assert_true(ok1 && ok2 && ok3, 20)
}

// ============================================================
// Test 21: Simple expansion with substitution
// ============================================================

fn test_macro_simple_expand() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    // Define macro "add" with 2 params, template: [PARAM_REF(0), LIT(+), PARAM_REF(1)]
    var d = macro_def_new()
    let nm = test_make_name(97, 100, 100, 3)  // "add"
    d = macro_def_set_name(d, nm, 3)

    var p1 = macro_param_new()
    d = macro_def_add_param(d, p1)
    var p2 = macro_param_new()
    d = macro_def_add_param(d, p2)

    var tmpl = macro_template_new()
    tmpl = macro_template_add_param_ref(tmpl, 0)
    let plus = test_make_name(43, 0, 0, 1)  // "+"
    tmpl = macro_template_add_literal(tmpl, plus)
    tmpl = macro_template_add_param_ref(tmpl, 1)
    d.template = tmpl

    exp = macro_register(exp, d)

    // Expand with args: [10], [20]
    var args = macro_args_new()
    var toks1: [i64; 32] = [0; 32]
    toks1[0] = 10
    args = macro_args_add(args, toks1, 1, MACRO_PARAM_EXPR)
    var toks2: [i64; 32] = [0; 32]
    toks2[0] = 20
    args = macro_args_add(args, toks2, 1, MACRO_PARAM_EXPR)

    let result = macro_expand(exp, nm, 3, args)
    exp = result.0
    let out = result.1

    let ok1 = out.status == EXPAND_OK
    let ok2 = out.token_count > 0
    let ok3 = exp.total_expansions == 1
    macro_assert_true(ok1 && ok2 && ok3, 21)
}

// ============================================================
// Test 22: Expansion with gensym in template
// ============================================================

fn test_macro_gensym_expand() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    var d = macro_def_new()
    let nm = test_make_name(103, 115, 0, 2)  // "gs"
    d = macro_def_set_name(d, nm, 2)

    var tmpl = macro_template_new()
    tmpl = macro_template_add_gensym(tmpl)
    tmpl = macro_template_add_gensym(tmpl)
    d.template = tmpl

    exp = macro_register(exp, d)

    let args = macro_args_new()
    let result = macro_expand(exp, nm, 2, args)
    exp = result.0
    let out = result.1

    let ok1 = out.status == EXPAND_OK
    // Two gensym tokens should have been generated
    let ok2 = exp.gensym_counter == 2
    // Output should have names for gensyms
    let ok3 = out.name_count == 2
    macro_assert_true(ok1 && ok2 && ok3, 22)
}

// ============================================================
// Test 23: Expansion fails for unknown macro
