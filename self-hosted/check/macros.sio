// ============================================================
// Test 43: Pattern mismatch on kind
// ============================================================

fn test_macro_match_kind_mismatch() -> i64 with IO, Mut, Panic, Div {
    var d = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    var p = macro_param_new()
    p.kind = MACRO_PARAM_TYPE
    d = macro_def_add_param(d, p)

    // Provide EXPR kind when TYPE is expected
    var args = macro_args_new()
    var toks: [i64; 32] = [0; 32]
    args = macro_args_add(args, toks, 1, MACRO_PARAM_EXPR)
    let ok1 = !macro_match_pattern(d, args)

    // Kind 0 means "any" — should match
    var args2 = macro_args_new()
    args2 = macro_args_add(args2, toks, 1, 0)
    let ok2 = macro_match_pattern(d, args2)

    macro_assert_true(ok1 && ok2, 43)
}

// ============================================================
// Test 44: Expansion preserves stack depth (push/pop balanced)
// ============================================================

fn test_macro_expand_stack_balanced() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    var d = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    d.template = macro_template_new()
    exp = macro_register(exp, d)

    let ok1 = macro_stack_depth(exp) == 0
    let args = macro_args_new()
    let result = macro_expand(exp, nm, 1, args)
    exp = result.0
    let ok2 = macro_stack_depth(exp) == 0  // should be balanced
    let ok3 = result.1.status == EXPAND_OK
    macro_assert_true(ok1 && ok2 && ok3, 44)
}

