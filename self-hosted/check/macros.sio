// ============================================================
// Test 34: macro_depth_exceeded
// ============================================================

fn test_macro_depth_exceeded() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()
    let ok1 = !macro_depth_exceeded(exp)

    // Fill the stack to max
    var i: i64 = 0
    while i < 32 {
        exp = macro_push_stack(exp, i)
        i = i + 1
    }
    let ok2 = macro_depth_exceeded(exp)
    macro_assert_true(ok1 && ok2, 34)
}

// ============================================================
// Test 35: Expansion counter tracks correctly
// ============================================================

fn test_macro_expansion_counter() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    // Register a simple zero-param macro
    var d = macro_def_new()
    let nm = test_make_name(120, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    d.template = macro_template_new()
    exp = macro_register(exp, d)

    let ok1 = macro_count_expansions(exp) == 0

    let args = macro_args_new()
    let r1 = macro_expand(exp, nm, 1, args)
    exp = r1.0
    let ok2 = macro_count_expansions(exp) == 1

    let r2 = macro_expand(exp, nm, 1, args)
    exp = r2.0
    let ok3 = macro_count_expansions(exp) == 2

    let r3 = macro_expand(exp, nm, 1, args)
    exp = r3.0
    let ok4 = macro_count_expansions(exp) == 3

    macro_assert_true(ok1 && ok2 && ok3 && ok4, 35)
}

// ============================================================
// Test 36: Validate def — bad param ref in template
