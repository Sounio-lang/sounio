    p.kind = MACRO_PARAM_EXPR
    d = macro_def_add_param(d, p)
    // Template with one param ref
    d.template = macro_template_add_param_ref(d.template, 0)
    let err = macro_validate_def(d)
    macro_assert_true(err == 0, 14)
}

