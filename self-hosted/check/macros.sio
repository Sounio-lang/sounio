// ============================================================
// Test 24: Expansion fails on argument count mismatch
// ============================================================

fn test_macro_expand_arg_mismatch() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()
    var d = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d = macro_def_set_name(d, nm, 1)
    var p = macro_param_new()
    d = macro_def_add_param(d, p)
    exp = macro_register(exp, d)

    // No args when 1 is expected
    let args = macro_args_new()
    let result = macro_expand(exp, nm, 1, args)
    let out = result.1
    macro_assert_true(out.status == EXPAND_ERR_ARG_COUNT, 24)
}

// ============================================================
// Test 25: Recursion detection during expansion
// ============================================================

fn test_macro_expand_recursion() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    // Register macro "rec"
    var d = macro_def_new()
    let nm = test_make_name5(114, 101, 99, 0, 0)  // "rec"
    d = macro_def_set_name(d, nm, 3)
    d.template = macro_template_new()
    exp = macro_register(exp, d)

    // Manually push it onto the stack to simulate recursion
    exp = macro_push_stack(exp, 0)

    let args = macro_args_new()
    let result = macro_expand(exp, nm, 3, args)
    let out = result.1
    macro_assert_true(out.status == EXPAND_ERR_RECURSION, 25)
}

// ============================================================
// Test 26: Register builtins
// ============================================================

fn test_macro_builtins() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()
    exp = macro_register_builtins(exp)

    let ok1 = exp.def_count == 5  // line, column, file, stringify, concat
    let bc = macro_expander_builtin_count(exp)
    let ok2 = bc == 5

    // Lookup "line"
    var line_name: [i8; 64] = [0; 64]
    line_name[0] = 108
    line_name[1] = 105
    line_name[2] = 110
    line_name[3] = 101
    let idx = macro_lookup(exp, line_name, 4)
    let ok3 = idx >= 0

    // Verify it is builtin
    let def = macro_get_def(exp, idx)
    let ok4 = def.is_builtin
    macro_assert_true(ok1 && ok2 && ok3 && ok4, 26)
}

// ============================================================
// Test 27: name64_eq helper
