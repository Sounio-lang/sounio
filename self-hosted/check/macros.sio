// ============================================================
// Test 37: Scoped lookup
// ============================================================

fn test_macro_scoped_lookup() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    var d1 = macro_def_new()
    let nm = test_make_name(97, 0, 0, 1)
    d1 = macro_def_set_name(d1, nm, 1)
    d1.scope_id = 10
    exp = macro_register(exp, d1)

    // Lookup at scope 5 should fail (macro at scope 10)
    let idx1 = macro_lookup_in_scope(exp, nm, 1, 5)
    let ok1 = idx1 == (0 - 1)

    // Lookup at scope 10 should succeed
    let idx2 = macro_lookup_in_scope(exp, nm, 1, 10)
    let ok2 = idx2 == 0

    // Lookup at scope 20 should succeed
    let idx3 = macro_lookup_in_scope(exp, nm, 1, 20)
    let ok3 = idx3 == 0

    macro_assert_true(ok1 && ok2 && ok3, 37)
}

// ============================================================
// Test 38: MacroArgs construction and add
// ============================================================

fn test_macro_args() -> i64 with IO, Mut, Panic, Div {
    var args = macro_args_new()
    let ok1 = args.arg_count == 0

    var toks: [i64; 32] = [0; 32]
    toks[0] = 42
    toks[1] = 99
    args = macro_args_add(args, toks, 2, MACRO_PARAM_EXPR)

    let ok2 = args.arg_count == 1
    let ok3 = macro_args_get_count(args, 0) == 2
    let ok4 = args.tokens[0][0] == 42
    let ok5 = args.tokens[0][1] == 99
    let ok6 = macro_args_get_count(args, 1) == 0  // out of bounds
    macro_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6, 38)
}

// ============================================================
// Test 39: ExpansionOutput overflow handling
// ============================================================

fn test_expansion_output_overflow() -> i64 with IO, Mut, Panic, Div {
    var out = expansion_output_new()
    let ok1 = out.status == EXPAND_OK

    // Push up to limit
    var i: i64 = 0
    while i < 1024 {
        out = expansion_output_push(out, i)
        i = i + 1
    }
    let ok2 = out.token_count == 1024
    let ok3 = out.status == EXPAND_OK

    // One more should overflow
    out = expansion_output_push(out, 999)
    let ok4 = out.status == EXPAND_ERR_OVERFLOW
    macro_assert_true(ok1 && ok2 && ok3 && ok4, 39)
}

// ============================================================
// Test 40: Multiple macro shadowing
// ============================================================

fn test_macro_shadowing() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    // Register "m" at scope 0
    var d1 = macro_def_new()
    let nm = test_make_name(109, 0, 0, 1)  // "m"
    d1 = macro_def_set_name(d1, nm, 1)
    d1.scope_id = 0
    exp = macro_register(exp, d1)

    // Register "m" again at scope 5 (shadows first)
    var d2 = macro_def_new()
    d2 = macro_def_set_name(d2, nm, 1)
    d2.scope_id = 5
    d2.is_builtin = true  // mark differently to distinguish
    exp = macro_register(exp, d2)

    // Lookup should find the most recent (index 1)
    let idx = macro_lookup(exp, nm, 1)
    let ok1 = idx == 1
    let def = macro_get_def(exp, idx)
    let ok2 = def.is_builtin  // should be the shadowing definition
    let ok3 = exp.def_count == 2
    macro_assert_true(ok1 && ok2 && ok3, 40)
}

