// ============================================================
// Test 29: macro_unregister
// ============================================================

fn test_macro_unregister() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()
    var d1 = macro_def_new()
    let nm1 = test_make_name(97, 0, 0, 1)
    d1 = macro_def_set_name(d1, nm1, 1)
    exp = macro_register(exp, d1)

    var d2 = macro_def_new()
    let nm2 = test_make_name(98, 0, 0, 1)
    d2 = macro_def_set_name(d2, nm2, 1)
    exp = macro_register(exp, d2)

    let ok1 = exp.def_count == 2
    exp = macro_unregister(exp, 0)
    let ok2 = exp.def_count == 1
    // After removing index 0, "b" should now be at index 0
    let ok3 = macro_def_name_eq(exp.defs[0], nm2, 1)
    macro_assert_true(ok1 && ok2 && ok3, 29)
}

// ============================================================
// Test 30: macro_reset_stack
// ============================================================

fn test_macro_reset_stack() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()
    exp = macro_push_stack(exp, 1)
    exp = macro_push_stack(exp, 2)
    exp = macro_push_stack(exp, 3)
    let ok1 = exp.stack_depth == 3
    exp = macro_reset_stack(exp)
    let ok2 = exp.stack_depth == 0
    let ok3 = !macro_check_recursion(exp, 1)
    macro_assert_true(ok1 && ok2 && ok3, 30)
}

// ============================================================
// Test 31: macro_count_in_scope
// ============================================================

fn test_macro_count_in_scope() -> i64 with IO, Mut, Panic, Div {
    var exp = macro_expander_new()

    var d1 = macro_def_new()
    let nm1 = test_make_name(97, 0, 0, 1)
    d1 = macro_def_set_name(d1, nm1, 1)
    d1.scope_id = 0
    exp = macro_register(exp, d1)

    var d2 = macro_def_new()
    let nm2 = test_make_name(98, 0, 0, 1)
    d2 = macro_def_set_name(d2, nm2, 1)
    d2.scope_id = 5
    exp = macro_register(exp, d2)

    var d3 = macro_def_new()
    let nm3 = test_make_name(99, 0, 0, 1)
    d3 = macro_def_set_name(d3, nm3, 1)
    d3.scope_id = 10
    exp = macro_register(exp, d3)

    let c1 = macro_count_in_scope(exp, 0)
    let ok1 = c1 == 1  // only scope 0
    let c2 = macro_count_in_scope(exp, 5)
    let ok2 = c2 == 2  // scope 0 and 5
    let c3 = macro_count_in_scope(exp, 100)
    let ok3 = c3 == 3  // all visible
    macro_assert_true(ok1 && ok2 && ok3, 31)
}

