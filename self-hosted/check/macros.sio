// Test runner
// ============================================================

fn macro_check_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Macro expansion tests ===\n")
    var fails: i64 = 0
    fails = fails + test_macro_param_new()
    fails = fails + test_macro_param_kind()
    fails = fails + test_macro_param_name()
    fails = fails + test_macro_template_literal()
    fails = fails + test_macro_template_param_ref()
    fails = fails + test_macro_template_mixed()
    fails = fails + test_macro_def_new()
    fails = fails + test_macro_def_name()
    fails = fails + test_macro_def_params()
    fails = fails + test_macro_expander_new()
    fails = fails + test_macro_register_lookup()
    fails = fails + test_macro_gensym()
    fails = fails + test_macro_recursion_check()
    fails = fails + test_macro_validate_valid()
    fails = fails + test_macro_validate_empty_name()
    fails = fails + test_macro_validate_bad_kind()
    fails = fails + test_macro_validate_dup_params()
    fails = fails + test_macro_validate_variadic_not_last()
    fails = fails + test_macro_match_exact()
    fails = fails + test_macro_match_variadic()
    fails = fails + test_macro_simple_expand()
    fails = fails + test_macro_gensym_expand()
    fails = fails + test_macro_expand_not_found()
    fails = fails + test_macro_expand_arg_mismatch()
    fails = fails + test_macro_expand_recursion()
    fails = fails + test_macro_builtins()
    fails = fails + test_name64_eq()
    fails = fails + test_macro_is_defined()
    fails = fails + test_macro_unregister()
    fails = fails + test_macro_reset_stack()
    fails = fails + test_macro_count_in_scope()
    fails = fails + test_macro_template_count_kind()
    fails = fails + test_macro_template_uses_param()
    fails = fails + test_macro_depth_exceeded()
    fails = fails + test_macro_expansion_counter()
    fails = fails + test_macro_validate_bad_ref()
    fails = fails + test_macro_scoped_lookup()
    fails = fails + test_macro_args()
    fails = fails + test_expansion_output_overflow()
    fails = fails + test_macro_shadowing()
    fails = fails + test_macro_validate_variadic_last()
    fails = fails + test_macro_gensym_counter()
    fails = fails + test_macro_match_kind_mismatch()
    fails = fails + test_macro_expand_stack_balanced()

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}
