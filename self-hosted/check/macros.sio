fn test_name64_eq() -> i64 with IO, Mut, Panic, Div {
    let a = test_make_name(65, 66, 67, 3)
    let b = test_make_name(65, 66, 67, 3)
    let c = test_make_name(65, 66, 68, 3)
    let ok1 = name64_eq(a, 3, b, 3)
    let ok2 = !name64_eq(a, 3, c, 3)
    let ok3 = !name64_eq(a, 3, b, 2)
    macro_assert_true(ok1 && ok2 && ok3, 27)
}

