// Seq<T>: language-level heap-backed growable sequence (lean_single TY_SEQ=12).
// Represented as TyNamed("Seq") with element type in `inner` — same shape as Box<T>
// / ty_knowledge. Caller supplies the Name (typically make_name("Seq")) so we do
// not rebuild Name bytes here (empty_name+mutate was a SEGV suspect under the
// seed compiler when returned through type-lower SRET).
// See docs/audit/MADAROS_SEQ_SURFACE_2026-08-17.md.
pub fn ty_seq_named(seq_name: Name, elem: TypeEntry) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyNamed,
        name: seq_name,
        inner: Some(Box::new(elem)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
        ontology_id: -1,
        noise_set_id: -1,
        knowledge_provenance_kind: -1,
    }
}

pub fn is_seq_type(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyNamed { return false }
    let n = ty.name
    n.len == 3
        && n.buf[0] == 83 as i8
        && n.buf[1] == 101 as i8
        && n.buf[2] == 113 as i8
}

pub fn seq_elem_type(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if !is_seq_type(ty) {
        return ty_error()
    }
    match ty.inner {
        Some(elem) => *elem
        None => ty_error()
    }
}

