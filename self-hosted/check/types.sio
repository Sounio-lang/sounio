// ============================================================
// Unit-typed constructor
// ============================================================

fn ty_with_unit(base: TypeEntry, uid: i64) -> TypeEntry {
    TypeEntry {
        kind: base.kind,
        name: base.name,
        inner: base.inner,
        array_size: base.array_size,
        fn_sig_id: base.fn_sig_id,
        tuple_elems: base.tuple_elems,
        knowledge_epsilon: base.knowledge_epsilon,
        algebra_kind: base.algebra_kind,
        clifford_p: base.clifford_p,
        clifford_q: base.clifford_q,
        unit_id: uid,
        refinement_id: base.refinement_id,
        epistemic_meta_id: base.epistemic_meta_id,
        robustness_level_id: base.robustness_level_id,
        robustness_scope_id: base.robustness_scope_id,
    }
}

fn ty_with_refinement(base: TypeEntry, rid: i64) -> TypeEntry {
    TypeEntry {
        kind: base.kind,
        name: base.name,
        inner: base.inner,
        array_size: base.array_size,
        fn_sig_id: base.fn_sig_id,
        tuple_elems: base.tuple_elems,
        knowledge_epsilon: base.knowledge_epsilon,
        algebra_kind: base.algebra_kind,
        clifford_p: base.clifford_p,
        clifford_q: base.clifford_q,
        unit_id: base.unit_id,
        refinement_id: rid,
        epistemic_meta_id: base.epistemic_meta_id,
        robustness_level_id: base.robustness_level_id,
        robustness_scope_id: base.robustness_scope_id,
    }
}

// ============================================================
// TypeEntryList helpers
// ============================================================

fn type_entry_list_append(list: TypeEntryList, node: TypeEntryList) -> TypeEntryList with Mut, Alloc {
    match list.tail {
        None => TypeEntryList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => TypeEntryList {
            head: list.head,
            tail: Some(Box::new(type_entry_list_append(*rest, node))),
        }
    }
}

fn type_entry_list_count(opt: Option<Box<TypeEntryList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + type_entry_list_count((*list).tail)
    }
}

fn type_entry_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                type_entry_list_get((*list).tail, idx - 1)
            }
        }
    }
}
