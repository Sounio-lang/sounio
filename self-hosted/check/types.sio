fn ty_model(input_ty: TypeEntry, output_ty: TypeEntry) -> TypeEntry with Alloc {
    let elems = TypeEntryList {
        head: input_ty,
        tail: Some(Box::new(TypeEntryList { head: output_ty, tail: None })),
    }
    TypeEntry {
        kind: TypeKind::TyModel,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(output_ty)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: Some(Box::new(elems)),
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn ty_model_family(input_ty: TypeEntry, output_ty: TypeEntry, family_id: i64) -> TypeEntry with Alloc {
    let elems = TypeEntryList {
        head: input_ty,
        tail: Some(Box::new(TypeEntryList { head: output_ty, tail: None })),
    }
    TypeEntry {
        kind: TypeKind::TyModelFamily,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(output_ty)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: Some(Box::new(elems)),
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: family_id,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

