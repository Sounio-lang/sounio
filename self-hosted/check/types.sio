pub fn ty_ref(inner: TypeEntry) -> TypeEntry with Alloc {
    ty_ref_with_idx(inner, -1)
}

pub fn ty_ref_with_idx(inner: TypeEntry, struct_idx: i64) -> TypeEntry with Alloc {
    // Encode struct_idx in name.buf[0] (TypeEntry byte 8 — within the *mut SRET window).
    // Caller: checker_lower_ref_like_type_mut, which has already looked up the struct table
    // via find_by_buf8 and encodes -1 for non-struct refs (primitives, slices, etc.).
    // The field-access handler decodes this directly, avoiding name.len (offset 136, unreliable).
    var enc: Name = Name { buf: [0; 384], len: 0 }
    let enc_idx = struct_idx + 1
    enc.buf[0] = (enc_idx % 256) as i8
    enc.buf[1] = (enc_idx / 256) as i8
    TypeEntry {
        kind: TypeKind::TyRef,
        name: enc,
        inner: Some(Box::new(inner)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
        ontology_id: -1,
        noise_set_id: -1,
        knowledge_provenance_kind: -1,
    }
}

pub fn ty_ref_mut(inner: TypeEntry) -> TypeEntry with Alloc {
    ty_ref_mut_with_idx(inner, -1)
}

pub fn ty_raw_ptr(inner: TypeEntry, is_mut: bool) -> TypeEntry with Alloc {
    var enc: Name = Name { buf: [0; 384], len: 0 }
    if is_mut {
        enc.buf[0] = 1
    }
    TypeEntry {
        kind: TypeKind::TyRawPtr,
        name: enc,
        inner: Some(Box::new(inner)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
