// Wide integers (i128/u128/i256/... arbitrary iN/uN) reuse the otherwise-unused
// `clifford_p` field to carry the declared bit-WIDTH (>0). Plain integer kinds never
// read clifford_p, so this is collision-free; it lets one TyI128/TyU128 kind represent
// every width (i128=128, i256=256, ...). limbs = ceil(bits/64).
pub fn ty_wide_int(bits: i64, signed: bool) -> TypeEntry {
    var k = TypeKind::TyU128
    if signed { k = TypeKind::TyI128 }
    TypeEntry {
        kind: k,
        name: Name { buf: [0; 384], len: 0 },
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: bits,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
        ontology_id: -1,
        noise_set_id: -1,
        knowledge_provenance_kind: -1,
    }
}

