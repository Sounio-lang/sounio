// Type representation for the self-hosted type checker

module check::types

use parser::ast::{Name}
//
// TypeKind tags the kind of type; TypeEntry is the full type node.
// Constructors: ty_i64(), ty_bool(), etc. for convenience.
// TypeEntryList is a linked list for tuple element types.

// ============================================================
// Type kinds
// ============================================================

enum TypeKind {
    TyI64,
    TyF64,
    TyBool,
    TyUnit,
    TyString,
    TyChar,
    TyNamed,
    TyArray,
    TyRef,
    TyRefMut,
    TyTuple,
    TyFn,
    TyNever,
    TyI8,
    TyI32,
    TyU8,
    TyU32,
    TyU64,
    TyF32,
    TyError,
    TyUnknown,
    TyKnowledge,
    TyPolicy,
    TyContest,
    TyRobust,
    TyHyper,       // Hypercomplex: Hyper<Algebra, T> — tag 22
    TyIntervention,     // Intervention<T> — causal: do(X=x)
    TyCounterfactual,   // Counterfactual<T> — causal: Y(x)
    TyValidated,        // Validated<T> — compile-time validated
}

// ============================================================
// Type entry
// ============================================================

struct TypeEntry {
    kind: TypeKind,
    name: Name,
    inner: Option<Box<TypeEntry>>,
    array_size: i64,
    fn_sig_id: i64,
    tuple_elems: Option<Box<TypeEntryList>>,
    knowledge_epsilon: f64,
    algebra_kind: i64,   // ALG_REAL..ALG_CLIFFORD (-1 if not Hyper)
    clifford_p: i64,     // Clifford signature p (-1 if not Clifford)
    clifford_q: i64,     // Clifford signature q (-1 if not Clifford)
    unit_id: i64,        // Unit registry index (-1 if not a unit type)
    refinement_id: i64,  // RefinementTable index (-1 if not a refinement type)
    epistemic_meta_id: i64,      // Contest/Policy metadata (-1 if absent)
    robustness_level_id: i64,    // RobustnessLevel tag (-1 if absent)
    robustness_scope_id: i64,    // RobustnessScope tag (-1 if absent)
}

struct TypeEntryList {
    head: TypeEntry,
    tail: Option<Box<TypeEntryList>>,
}

// ============================================================
// Default / empty type entry
// ============================================================

fn empty_type_entry() -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyError,
        name: Name { buf: [0; 128], len: 0 },
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

