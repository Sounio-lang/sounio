}

// ============================================================
// TypeEntryList helpers
// ============================================================

fn type_entry_list_append(list: TypeEntryList, node: TypeEntryList) -> TypeEntryList with Mut, Alloc {
    match list.tail {
        None => TypeEntryList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => TypeEntryList {
            head: list.head,
            tail: Some(Box::new(type_entry_list_append(*rest, node))),
        }
    }
}

fn type_entry_list_count(opt: Option<Box<TypeEntryList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + type_entry_list_count((*list).tail)
    }
}

fn type_entry_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                type_entry_list_get((*list).tail, idx - 1)
            }
        }
    }
}

// ============================================================
// Effect row type constructors (H6.2 — row-polymorphic effects)
// ============================================================

// TyEffectVar: array_size stores the variable id (unique row-poly variable)
fn ty_effect_var(var_id: i64) -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyEffectVar,
        name: Name { buf: [0; 128], len: 0 },
        inner: None,
        array_size: var_id,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

// TyEffectRow: name stores label, inner stores row tail type, fn_sig_id stores effect def id
fn ty_effect_row(label: Name, effect_id: i64, tail: TypeEntry) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyEffectRow,
        name: label,
        inner: Some(Box::new(tail)),
        array_size: -1,
        fn_sig_id: effect_id,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn is_effect_row_type(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyEffectRow => true
        TypeKind::TyEffectVar => true
        _ => false
    }
}

// ============================================================
// Aleatoric/Epistemic uncertainty constructors (H6.3)
// ============================================================

// TyAleatoric: inner=wrapped type, knowledge_epsilon=uncertainty bound
// Aleatoric uncertainty is irreducible (sensor noise, quantum effects).
fn ty_aleatoric(inner_ty: TypeEntry, epsilon: f64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyAleatoric,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(inner_ty)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: epsilon,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

// TyEpistemic: inner=wrapped type, knowledge_epsilon=uncertainty bound
// Epistemic uncertainty is reducible by more data or a better model.
fn ty_epistemic(inner_ty: TypeEntry, epsilon: f64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyEpistemic,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(inner_ty)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: epsilon,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn is_aleatoric_type(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyAleatoric => true
        _ => false
    }
}

fn is_epistemic_uncertain_kind(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyEpistemic => true
        _ => false
    }
}

fn is_reducible_uncertainty(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyEpistemic => true
        TypeKind::TyKnowledge => true
        _ => false
    }
}

// ============================================================
// CausalEffect constructor and predicates (H6.4)
// ============================================================

// TyCausalEffect:
//   inner = effect type (Y in CausalEffect<X, Y, do(Z=z)>)
//   fn_sig_id = intervention meta id (causal table index, or -1)
//   epistemic_meta_id = identifiability: 0=identifiable, 1=non-identifiable, -1=unknown
fn ty_causal_effect(effect_ty: TypeEntry, intervention_id: i64, identifiable: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyCausalEffect,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(effect_ty)),
        array_size: -1,
        fn_sig_id: intervention_id,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: identifiable,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn is_causal_effect_type(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyCausalEffect => true
        _ => false
    }
}

fn causal_effect_is_identifiable(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyCausalEffect => ty.epistemic_meta_id == 0
        _ => false
    }
}

// ============================================================
// GradedEffect constructor and predicates (H6.5 — Sprint 18)
// ============================================================

// TyGradedEffect: effect row graded by uncertainty bound ε.
// Represents `Prob<ε>` — a graded modality fusing row-poly effects + epistemic uncertainty.
//   name         = effect label (e.g. "Prob")
//   knowledge_epsilon = grade ε ∈ [0,1]
//   inner        = tail type (the residual effect row)
//   epistemic_meta_id = 0: epistemic grade (quadrature composition); 1: aleatoric grade (additive)
fn ty_graded_effect(label: Name, epsilon: f64, tail: TypeEntry, aleatoric: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyGradedEffect,
        name: label,
        inner: Some(Box::new(tail)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: epsilon,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: aleatoric,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn is_graded_effect_type(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyGradedEffect => true
        _ => false
    }
}

// Grade subsumption: Prob<ε_provided> satisfies Prob<ε_required> iff ε_provided <= ε_required.
// A tighter bound (smaller ε) is always acceptable where a looser bound is required.
fn graded_effect_subsumes(provided: TypeEntry, required: TypeEntry) -> bool {
    match provided.kind {
        TypeKind::TyGradedEffect => {
            match required.kind {
                TypeKind::TyGradedEffect => {
                    // provided.ε ≤ required.ε (provided is at least as precise)
                    provided.knowledge_epsilon <= required.knowledge_epsilon
                }
                _ => false
            }
        }
        _ => false
    }
}

// Grade composition: Prob<ε1> ∘ Prob<ε2>
// Epistemic (aleatoric=0): quadrature — ε_out = sqrt(ε1² + ε2²)
// Aleatoric  (aleatoric=1): additive  — ε_out = ε1 + ε2
fn graded_effect_compose(a: TypeEntry, b: TypeEntry) -> f64 with Div, Mut, Panic {
    if a.epistemic_meta_id == 1 {
        // Aleatoric: additive
        a.knowledge_epsilon + b.knowledge_epsilon
    } else {
        // Epistemic: quadrature sqrt(a² + b²)
        let sum_sq = a.knowledge_epsilon * a.knowledge_epsilon + b.knowledge_epsilon * b.knowledge_epsilon
        var est: f64 = sum_sq
        var i: i64 = 0
        while i < 10 {
            est = (est + sum_sq / est) / 2.0
            i = i + 1
        }
        est
    }
}
