    }
}

fn is_aleatoric_type(ty: TypeEntry) -> bool {
    match ty.kind {
        TypeKind::TyAleatoric => true
        _ => false
    }
}

fn is_epistemic_uncertain_kind(ty: TypeEntry) -> bool {
