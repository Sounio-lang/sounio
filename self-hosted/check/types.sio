// TySessionEnd: terminal — no inner
// ============================================================

fn ty_session(step_kind: i64, msg_type_id: i64, continuation: TypeEntry) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TySession,
        name: empty_name(),
