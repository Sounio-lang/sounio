fn ty_named(n: Name) -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyNamed,
        name: n,
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

fn ty_array(elem: TypeEntry, size: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyArray,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(elem)),
        array_size: size,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

