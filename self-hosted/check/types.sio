// ============================================================
// Compound constructors
// ============================================================

fn ty_named(n: Name) -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyNamed,
        name: n,
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
    }
}

fn ty_array(elem: TypeEntry, size: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyArray,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(elem)),
        array_size: size,
        fn_sig_id: -1,
        tuple_elems: None,
    }
}

fn ty_ref(inner: TypeEntry) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyRef,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(inner)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
    }
}

fn ty_ref_mut(inner: TypeEntry) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyRefMut,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(inner)),
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
    }
}

fn ty_fn(sig_id: i64) -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyFn,
        name: Name { buf: [0; 128], len: 0 },
        inner: None,
        array_size: -1,
        fn_sig_id: sig_id,
        tuple_elems: None,
    }
}

fn ty_tuple(elems: TypeEntryList) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyTuple,
        name: Name { buf: [0; 128], len: 0 },
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: Some(Box::new(elems)),
    }
}

// ============================================================
// TypeEntryList helpers
// ============================================================

fn type_entry_list_append(list: TypeEntryList, node: TypeEntryList) -> TypeEntryList with Mut, Alloc {
    match list.tail {
        None => TypeEntryList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => TypeEntryList {
            head: list.head,
            tail: Some(Box::new(type_entry_list_append(*rest, node))),
        }
    }
}

fn type_entry_list_count(opt: Option<Box<TypeEntryList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + type_entry_list_count((*list).tail)
    }
}

fn type_entry_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                type_entry_list_get((*list).tail, idx - 1)
            }
        }
    }
}
