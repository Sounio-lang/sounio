        array_size: step_kind,
        fn_sig_id: msg_type_id,
        tuple_elems: None,
        knowledge_epsilon: 0.0 - 1.0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
