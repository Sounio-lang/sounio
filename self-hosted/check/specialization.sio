// T54: Queue FIFO order with three elements.
fn test_spec_queue_three_fifo_inner(q: &! SpecQueue, k1: SpecKey, k2: SpecKey, k3: SpecKey) -> bool with Mut, Panic {
    let p1 = spec_queue_pop(q)
    let p2 = spec_queue_pop(q)
    let p3 = spec_queue_pop(q)
    spec_key_eq(p1, k1) && spec_key_eq(p2, k2) && spec_key_eq(p3, k3)
}
fn test_spec_queue_three_fifo() -> bool with Mut, Panic {
    var q = spec_queue_new()
    let k1 = spec_key_prim(TEST_FN_MAP, SPEC_TY_I64)
    let k2 = spec_key_prim(TEST_FN_FILTER, SPEC_TY_F64)
    let k3 = spec_key_prim(TEST_FN_FOLD, SPEC_TY_BOOL)
    spec_queue_push(&! q, k1)
    spec_queue_push(&! q, k2)
    spec_queue_push(&! q, k3)
    test_spec_queue_three_fifo_inner(&! q, k1, k2, k3)
}

