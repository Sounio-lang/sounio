// T69: spec_mix_hash result is non-negative.
fn test_spec_mix_hash_nonneg() -> bool {
    let h = spec_mix_hash(123456789, 987654321)
    h >= 0
}

// T70: spec_mangle_hash result is non-negative.
fn test_spec_mangle_hash_nonneg() -> bool {
    let fh = TEST_FN_MAP
    let th = spec_hash_type_tag(SPEC_TY_I64)
    spec_mangle_hash(fh, th) >= 0
}

