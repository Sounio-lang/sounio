    let ok2 = spec_type_tag_name_code(SPEC_TY_F64) == 2
    let ok3 = spec_type_tag_name_code(SPEC_TY_BOOL) == 3
    let ok4 = spec_type_tag_name_code(SPEC_TY_STRING) == 4
    let ok5 = spec_type_tag_name_code(SPEC_TY_I32) == 5
    let ok6 = spec_type_tag_name_code(SPEC_TY_U8) == 6
    let ok7 = spec_type_tag_name_code(SPEC_TY_U32) == 7
    let ok8 = spec_type_tag_name_code(SPEC_TY_U64) == 8
    let ok9 = spec_type_tag_name_code(SPEC_TY_F32) == 9
    let ok10 = spec_type_tag_name_code(SPEC_TY_I8) == 10
    let ok11 = spec_type_tag_name_code(SPEC_TY_UNIT) == 11
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10 && ok11
}

