// Target-independent fixed binary-format identity.

module check::numeric_format

pub struct BinaryFormatDescriptor {
    format_id: i64,
    storage_bits: i64,
    exponent_bits: i64,
    precision_bits: i64,
    trailing_significand_bits: i64,
}

pub fn numeric_format_binary128_id() -> i64 { 128 }
pub fn numeric_format_binary256_id() -> i64 { 256 }

pub fn invalid_binary_format_descriptor() -> BinaryFormatDescriptor {
    BinaryFormatDescriptor {
        format_id: 0,
        storage_bits: 0,
        exponent_bits: 0,
        precision_bits: 0,
        trailing_significand_bits: 0,
    }
}

pub fn binary_format_binary128_descriptor() -> BinaryFormatDescriptor {
    BinaryFormatDescriptor {
        format_id: numeric_format_binary128_id(),
        storage_bits: 128,
        exponent_bits: 15,
        precision_bits: 113,
        trailing_significand_bits: 112,
    }
}

pub fn binary_format_binary256_descriptor() -> BinaryFormatDescriptor {
    BinaryFormatDescriptor {
        format_id: numeric_format_binary256_id(),
        storage_bits: 256,
        exponent_bits: 19,
        precision_bits: 237,
        trailing_significand_bits: 236,
    }
}
