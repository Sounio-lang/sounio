// ============================================================
// Test 36: Layout for TeType entries
// ============================================================

fn test_te_layout_for_type() -> i32 with IO, Mut, Div, Panic {
    let tc = te_type_concrete(1, 24, 8)
    let lc = te_layout_for_type(tc)
    if lc.size != 24 {
        print("FAIL: test_te_layout_for_type - concrete_size\n")
        return 1
    }
    if lc.alignment != 8 {
        print("FAIL: test_te_layout_for_type - concrete_align\n")
        return 1
    }
    let te = te_type_erased(2)
    let tle = te_layout_for_type(te)
    if tle.size != TE_PTR_SIZE {
        print("FAIL: test_te_layout_for_type - erased_size\n")
        return 1
    }
    let tb = te_type_boxed(3, 16, 8)
    let tlb = te_layout_for_type(tb)
    if tlb.size != TE_PTR_SIZE {
        print("FAIL: test_te_layout_for_type - boxed_size\n")
        return 1
    }
    let tv = te_type_vtable(4, 0)
    let tlv = te_layout_for_type(tv)
    if tlv.size != TE_PTR_SIZE * 2 {
        print("FAIL: test_te_layout_for_type - vtable_size\n")
        return 1
    }
    print("PASS: test_te_layout_for_type\n")
    return 0
}

