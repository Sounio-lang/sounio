// ============================================================

fn test_te_get_erased_fn_id() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let params = te_make_param_kinds_1(TE_TY_VAR)
    ctx = te_erase_fn_signature(ctx, 42, params, 1, TE_TY_I64)
    let eid = te_get_erased_fn_id(ctx, 42)
    if eid == TE_NOT_FOUND {
        print("FAIL: test_te_get_erased_fn_id - found\n")
        return 1
    }
    if eid == 42 {
        print("FAIL: test_te_get_erased_fn_id - different\n")
        return 1
    }
    let miss = te_get_erased_fn_id(ctx, 999)
    if miss != TE_NOT_FOUND {
        print("FAIL: test_te_get_erased_fn_id - miss\n")
        return 1
    }
    print("PASS: test_te_get_erased_fn_id\n")
    return 0
}

// ============================================================
// Test 41: TeType predicate functions
// ============================================================

fn test_te_type_predicates() -> i32 with IO, Mut, Div, Panic {
    let tc = te_type_concrete(1, 8, 8)
    if te_type_is_concrete(tc) == false {
        print("FAIL: test_te_type_predicates - concrete\n")
        return 1
    }
    if te_type_is_erased(tc) {
        print("FAIL: test_te_type_predicates - not_erased\n")
        return 1
    }
    let te = te_type_erased(2)
    if te_type_is_erased(te) == false {
        print("FAIL: test_te_type_predicates - erased\n")
        return 1
    }
    if te_type_needs_erasure(te) == false {
        print("FAIL: test_te_type_predicates - needs_erasure\n")
        return 1
    }
    let tb = te_type_boxed(3, 8, 8)
    if te_type_is_boxed(tb) == false {
        print("FAIL: test_te_type_predicates - boxed\n")
        return 1
    }
    if te_type_needs_erasure(tb) {
        print("FAIL: test_te_type_predicates - boxed_no_erasure\n")
        return 1
    }
    let tv = te_type_vtable(4, 0)
    if te_type_is_vtable(tv) == false {
        print("FAIL: test_te_type_predicates - vtable\n")
        return 1
    }
    if te_type_needs_erasure(tv) == false {
        print("FAIL: test_te_type_predicates - vtable_erasure\n")
        return 1
    }
    print("PASS: test_te_type_predicates\n")
    return 0
}

// ============================================================
// Test 42: Erase function idempotency
// ============================================================

fn test_te_erase_fn_idempotent() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
