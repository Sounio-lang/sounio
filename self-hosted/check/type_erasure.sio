    let m2 = te_make_methods_1_set(200)
    ctx = te_build_witness(ctx, 10, 20, 8, 8, TE_NOT_FOUND, m1, 1)
    ctx = te_build_witness(ctx, 11, 21, 16, 8, TE_NOT_FOUND, m2, 1)
    let idx0 = te_find_witness(ctx, 10, 20)
    if idx0 != 0 {
        print("FAIL: test_te_find_witness - 0\n")
