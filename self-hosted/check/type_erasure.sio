    return 0
}

// ============================================================
// Test 26: Statistics tracking
// ============================================================

fn test_te_stats_tracking() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Classify types
    ctx = te_classify_and_register(ctx, TE_TY_I64, 1, 8, 8)
    ctx = te_classify_and_register(ctx, TE_TY_VAR, 2, 0, 0)
    ctx = te_classify_and_register(ctx, TE_TY_TRAIT_OBJ, 3, 0, 0)
    if ctx.stats.types_classified != 3 {
        print("FAIL: test_te_stats_tracking - classified\n")
        return 1
    }
    if ctx.stats.types_concrete != 1 {
        print("FAIL: test_te_stats_tracking - concrete\n")
        return 1
    }
    if ctx.stats.types_erased != 1 {
        print("FAIL: test_te_stats_tracking - erased\n")
        return 1
    }
    if ctx.stats.types_vtable != 1 {
        print("FAIL: test_te_stats_tracking - vtable\n")
        return 1
    }
    print("PASS: test_te_stats_tracking\n")
    return 0
}

// ============================================================
// Test 27: Type map insert and lookup
// ============================================================

fn test_te_type_map() -> i32 with IO, Mut, Div, Panic {
    var map = te_type_map_new()
    let t1 = te_type_concrete(1, 8, 8)
    let t2 = te_type_erased(2)
    map = te_type_map_insert(map, 100, t1)
    map = te_type_map_insert(map, 200, t2)
    if map.count != 2 {
        print("FAIL: test_te_type_map - count\n")
        return 1
    }
    let r1 = te_type_map_lookup(map, 100)
    if r1.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_type_map - lookup1\n")
        return 1
    }
    let r2 = te_type_map_lookup(map, 200)
    if r2.kind != TE_KIND_ERASED {
        print("FAIL: test_te_type_map - lookup2\n")
        return 1
    }
    let r3 = te_type_map_lookup(map, 999)
    if r3.kind != TE_KIND_ERASED {
        // default empty is erased kind
        print("FAIL: test_te_type_map - miss\n")
        return 1
    }
    print("PASS: test_te_type_map\n")
    return 0
}

// ============================================================
// Test 28: Type map overwrite
// ============================================================

fn test_te_type_map_overwrite() -> i32 with IO, Mut, Div, Panic {
    var map = te_type_map_new()
    let t1 = te_type_concrete(1, 8, 8)
    let t2 = te_type_boxed(1, 8, 8)
    map = te_type_map_insert(map, 100, t1)
    map = te_type_map_insert(map, 100, t2)
    if map.count != 1 {
        print("FAIL: test_te_type_map_overwrite - count\n")
        return 1
    }
    let r = te_type_map_lookup(map, 100)
    if r.kind != TE_KIND_BOXED {
        print("FAIL: test_te_type_map_overwrite - kind\n")
        return 1
    }
    print("PASS: test_te_type_map_overwrite\n")
    return 0
}

// ============================================================
// Test 29: Type map has
// ============================================================

fn test_te_type_map_has() -> i32 with IO, Mut, Div, Panic {
    var map = te_type_map_new()
    let t1 = te_type_concrete(1, 8, 8)
    map = te_type_map_insert(map, 50, t1)
    if te_type_map_has(map, 50) == false {
        print("FAIL: test_te_type_map_has - yes\n")
        return 1
    }
    if te_type_map_has(map, 51) {
        print("FAIL: test_te_type_map_has - no\n")
