    print("PASS: test_te_type_map_has\n")
    return 0
}

// ============================================================
// Test 30: Multiple trait impls for same type
// ============================================================

fn test_te_multiple_trait_impls() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let m1 = te_make_methods_1_set(100)
    let m2 = te_make_methods_2_set(200, 201)
    let m3 = te_make_methods_1_set(300)
    // Type 10 implements trait 20
    ctx = te_build_vtable(ctx, 10, 20, m1, 1, 8, 8, TE_NOT_FOUND)
    // Type 10 also implements trait 21
    ctx = te_build_vtable(ctx, 10, 21, m2, 2, 8, 8, TE_NOT_FOUND)
    // Type 11 implements trait 20
    ctx = te_build_vtable(ctx, 11, 20, m3, 1, 16, 8, TE_NOT_FOUND)
    if ctx.vtable_count != 3 {
        print("FAIL: test_te_multiple_trait_impls - count\n")
        return 1
    }
    let count_10 = te_count_vtables_for_type(ctx, 10)
    if count_10 != 2 {
        print("FAIL: test_te_multiple_trait_impls - type10\n")
        return 1
    }
    let count_11 = te_count_vtables_for_type(ctx, 11)
    if count_11 != 1 {
        print("FAIL: test_te_multiple_trait_impls - type11\n")
        return 1
    }
    let count_99 = te_count_vtables_for_type(ctx, 99)
    if count_99 != 0 {
        print("FAIL: test_te_multiple_trait_impls - miss\n")
        return 1
    }
    print("PASS: test_te_multiple_trait_impls\n")
    return 0
}

