// ============================================================
// Test 12: Function signature erasure — single generic param
// ============================================================

fn test_te_erase_fn_single_param() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let params = te_make_param_kinds_1(TE_TY_VAR)
    ctx = te_erase_fn_signature(ctx, 42, params, 1, TE_TY_I64)
    if ctx.erased_fn_count != 1 {
        print("FAIL: test_te_erase_fn_single_param - count\n")
        return 1
    }
    let ef = ctx.erased_fns[0 as usize]
    if ef.original_fn_id != 42 {
        print("FAIL: test_te_erase_fn_single_param - orig\n")
        return 1
    }
    if te_erased_fn_is_param_erased(ef, 0) == false {
        print("FAIL: test_te_erase_fn_single_param - erased\n")
        return 1
    }
    if ef.return_erased {
        print("FAIL: test_te_erase_fn_single_param - ret\n")
        return 1
    }
    if ef.cast_ops_needed != 1 {
        print("FAIL: test_te_erase_fn_single_param - casts\n")
        return 1
    }
    print("PASS: test_te_erase_fn_single_param\n")
    return 0
}

