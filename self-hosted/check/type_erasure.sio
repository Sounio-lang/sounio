// ============================================================
// Test helpers
// ============================================================

fn te_test_make_context() -> TeContext {
    return te_context_new()
}

// ============================================================
// Test 1: Type classification — concrete i64
// ============================================================

fn test_te_classify_concrete_i64() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_I64, 1, 8, 8)
    if te.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_classify_concrete_i64 - kind\n")
        return 1
    }
    if te.size != 8 {
        print("FAIL: test_te_classify_concrete_i64 - size\n")
        return 1
    }
    if te.alignment != 8 {
        print("FAIL: test_te_classify_concrete_i64 - align\n")
        return 1
    }
    if te.is_pointer {
        print("FAIL: test_te_classify_concrete_i64 - pointer\n")
        return 1
    }
    print("PASS: test_te_classify_concrete_i64\n")
    return 0
}

