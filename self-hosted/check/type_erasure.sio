// ============================================================
// Test 51: Cast predicate functions
// ============================================================

fn test_te_cast_predicates() -> i32 with IO, Mut, Div, Panic {
    let b = te_cast_box(0, 0, 0, 0, 0)
    if te_cast_is_box(b) == false {
        print("FAIL: test_te_cast_predicates - box\n")
        return 1
    }
    if te_cast_is_unbox(b) {
        print("FAIL: test_te_cast_predicates - box_not_unbox\n")
        return 1
    }
    let u = te_cast_unbox(0, 0, 0, 0, 0)
    if te_cast_is_unbox(u) == false {
        print("FAIL: test_te_cast_predicates - unbox\n")
        return 1
    }
    let v = te_cast_vtable_lookup(0, 0, 0, 0)
    if te_cast_is_vtable_lookup(v) == false {
        print("FAIL: test_te_cast_predicates - vtable\n")
        return 1
    }
    print("PASS: test_te_cast_predicates\n")
    return 0
}

// ============================================================
// Test 52: Layout equality
// ============================================================

fn test_te_layout_eq() -> i32 with IO, Mut, Div, Panic {
    let l1 = te_layout_new(8, 8)
    let l2 = te_layout_new(8, 8)
    let l3 = te_layout_new(8, 4)
    let l4 = te_layout_new(4, 8)
    if te_layout_eq(l1, l2) == false {
        print("FAIL: test_te_layout_eq - eq\n")
        return 1
    }
    if te_layout_eq(l1, l3) {
        print("FAIL: test_te_layout_eq - diff_align\n")
        return 1
    }
    if te_layout_eq(l1, l4) {
        print("FAIL: test_te_layout_eq - diff_size\n")
        return 1
    }
    print("PASS: test_te_layout_eq\n")
    return 0
}

// ============================================================
// Test 53: Classify and register — context integration
// ============================================================

fn test_te_classify_and_register() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    ctx = te_classify_and_register(ctx, TE_TY_I64, 1, 8, 8)
    ctx = te_classify_and_register(ctx, TE_TY_F64, 2, 8, 8)
    ctx = te_classify_and_register(ctx, TE_TY_VAR, 100, 0, 0)
    if ctx.type_map.count != 3 {
        print("FAIL: test_te_classify_and_register - count\n")
        return 1
    }
    let r = te_type_map_lookup(ctx.type_map, 1)
    if r.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_classify_and_register - kind\n")
        return 1
    }
    let rv = te_type_map_lookup(ctx.type_map, 100)
    if rv.kind != TE_KIND_ERASED {
        print("FAIL: test_te_classify_and_register - var\n")
        return 1
    }
    print("PASS: test_te_classify_and_register\n")
    return 0
}

// ============================================================
// Test 54: Primitive kind check
// ============================================================

fn test_te_is_primitive_kind() -> i32 with IO, Mut, Div, Panic {
    if te_is_primitive_kind(TE_TY_I64) == false {
        print("FAIL: test_te_is_primitive_kind - i64\n")
        return 1
    }
    if te_is_primitive_kind(TE_TY_BOOL) == false {
        print("FAIL: test_te_is_primitive_kind - bool\n")
        return 1
    }
    if te_is_primitive_kind(TE_TY_I8) == false {
        print("FAIL: test_te_is_primitive_kind - i8\n")
        return 1
    }
    if te_is_primitive_kind(TE_TY_VAR) {
        print("FAIL: test_te_is_primitive_kind - var\n")
        return 1
    }
    if te_is_primitive_kind(TE_TY_FN) {
        print("FAIL: test_te_is_primitive_kind - fn\n")
        return 1
    }
    if te_is_primitive_kind(TE_TY_TRAIT_OBJ) {
        print("FAIL: test_te_is_primitive_kind - trait\n")
        return 1
    }
    print("PASS: test_te_is_primitive_kind\n")
    return 0
}

// ============================================================
// Test 55: Context alloc reg and fn id
// ============================================================

fn test_te_context_alloc() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let r1 = te_context_alloc_reg(ctx)
    let r2 = te_context_alloc_reg(ctx)
    if r1 == r2 {
        print("FAIL: test_te_context_alloc - reg_unique\n")
        return 1
    }
    let f1 = te_context_alloc_fn_id(ctx)
    let f2 = te_context_alloc_fn_id(ctx)
    if f1 == f2 {
        print("FAIL: test_te_context_alloc - fn_unique\n")
        return 1
    }
    print("PASS: test_te_context_alloc\n")
    return 0
}

// ============================================================
// Test 56: Mixed optimization — box-unbox pair + trivial align
// ============================================================

fn test_te_optimize_mixed() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // box→unbox pair (should be removed)
    ctx.cast_ops[0 as usize] = te_cast_box(10, 20, 5, 8, 8)
    ctx.cast_ops[1 as usize] = te_cast_unbox(20, 30, 5, 8, 8)
    // Standalone box (keep)
    ctx.cast_ops[2 as usize] = te_cast_box(40, 50, 6, 4, 4)
    // Trivial align (remove)
    ctx.cast_ops[3 as usize] = te_cast_align(60, 70, 7, 1)
    ctx.cast_op_count = 4
    ctx = te_optimize_casts(ctx)
    // Should keep only the standalone box
    if ctx.cast_op_count != 1 {
        print("FAIL: test_te_optimize_mixed - count\n")
        return 1
    }
    if ctx.cast_ops[0 as usize].kind != TE_CAST_BOX {
        print("FAIL: test_te_optimize_mixed - remaining_kind\n")
        return 1
    }
    if ctx.cast_ops[0 as usize].src_reg != 40 {
        print("FAIL: test_te_optimize_mixed - remaining_reg\n")
        return 1
    }
    if ctx.stats.casts_optimized_away != 3 {
        print("FAIL: test_te_optimize_mixed - stat\n")
        return 1
    }
    print("PASS: test_te_optimize_mixed\n")
    return 0
}

// ============================================================
// Test 57: Witness entry constructors
// ============================================================

fn test_te_witness_entries() -> i32 with IO, Mut, Div, Panic {
    let es = te_witness_entry_size(32)
    if es.kind != TE_WITNESS_SIZE {
        print("FAIL: test_te_witness_entries - size_kind\n")
        return 1
    }
    if es.value != 32 {
        print("FAIL: test_te_witness_entries - size_val\n")
        return 1
    }
    let ea = te_witness_entry_align(8)
    if ea.kind != TE_WITNESS_ALIGN {
        print("FAIL: test_te_witness_entries - align_kind\n")
        return 1
    }
    let ed = te_witness_entry_drop(42)
    if ed.kind != TE_WITNESS_DROP {
        print("FAIL: test_te_witness_entries - drop_kind\n")
        return 1
    }
    if ed.method_fn_id != 42 {
        print("FAIL: test_te_witness_entries - drop_fn\n")
        return 1
    }
    let em = te_witness_entry_method(99)
    if em.kind != TE_WITNESS_METHOD {
        print("FAIL: test_te_witness_entries - method_kind\n")
        return 1
    }
    if em.method_fn_id != 99 {
        print("FAIL: test_te_witness_entries - method_fn\n")
        return 1
    }
    print("PASS: test_te_witness_entries\n")
    return 0
}

// ============================================================
// Test 58: Erase trait object param
// ============================================================

fn test_te_erase_trait_obj_param() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let params = te_make_param_kinds_2(TE_TY_TRAIT_OBJ, TE_TY_I64)
    ctx = te_erase_fn_signature(ctx, 55, params, 2, TE_TY_TRAIT_OBJ)
    let ef = ctx.erased_fns[0 as usize]
    if te_erased_fn_is_param_erased(ef, 0) == false {
        print("FAIL: test_te_erase_trait_obj_param - p0\n")
        return 1
    }
    if te_erased_fn_is_param_erased(ef, 1) {
        print("FAIL: test_te_erase_trait_obj_param - p1\n")
        return 1
    }
    if ef.return_erased == false {
        print("FAIL: test_te_erase_trait_obj_param - ret\n")
        return 1
    }
    if ef.cast_ops_needed != 2 {
        print("FAIL: test_te_erase_trait_obj_param - casts\n")
        return 1
    }
    print("PASS: test_te_erase_trait_obj_param\n")
    return 0
}

// ============================================================
// Test 59: Full pipeline run
// ============================================================

fn test_te_full_pipeline() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()

    // 1. Classify types
    ctx = te_classify_and_register(ctx, TE_TY_I64, 1, 8, 8)
    ctx = te_classify_and_register(ctx, TE_TY_VAR, 100, 0, 0)

    // 2. Erase a function
    let params = te_make_param_kinds_2(TE_TY_VAR, TE_TY_I64)
    ctx = te_erase_fn_signature(ctx, 42, params, 2, TE_TY_I64)

    // 3. Build vtable
    let methods = te_make_methods_2_set(200, 201)
    ctx = te_build_vtable(ctx, 1, 10, methods, 2, 8, 8, 300)

    // 4. Build witness
    ctx = te_build_witness(ctx, 1, 10, 8, 8, 300, methods, 2)

    // 5. Insert some casts (box-unbox pair + standalone)
    ctx.cast_ops[ctx.cast_op_count as usize] = te_cast_box(10, 20, 1, 8, 8)
    ctx.cast_op_count = ctx.cast_op_count + 1
    ctx.cast_ops[ctx.cast_op_count as usize] = te_cast_unbox(20, 30, 1, 8, 8)
    ctx.cast_op_count = ctx.cast_op_count + 1
    ctx.cast_ops[ctx.cast_op_count as usize] = te_cast_box(40, 50, 2, 4, 4)
    ctx.cast_op_count = ctx.cast_op_count + 1

    // 6. Run optimization
    ctx = te_run_erasure_pass(ctx)

    // Verify final state
    if ctx.stats.types_classified != 2 {
        print("FAIL: test_te_full_pipeline - types\n")
        return 1
    }
    if ctx.erased_fn_count != 1 {
        print("FAIL: test_te_full_pipeline - fns\n")
        return 1
    }
    if ctx.vtable_count != 1 {
        print("FAIL: test_te_full_pipeline - vtables\n")
        return 1
    }
    if ctx.witness_count != 1 {
        print("FAIL: test_te_full_pipeline - witnesses\n")
        return 1
    }
    // box-unbox pair removed, standalone box kept
    if ctx.cast_op_count != 1 {
        print("FAIL: test_te_full_pipeline - casts\n")
        return 1
    }
    if ctx.stats.casts_optimized_away != 2 {
        print("FAIL: test_te_full_pipeline - optimized\n")
        return 1
    }
    if te_has_errors(ctx) {
        print("FAIL: test_te_full_pipeline - errors\n")
        return 1
    }
    print("PASS: test_te_full_pipeline\n")
    return 0
}

// ============================================================
// Test 60: Empty context queries
// ============================================================

fn test_te_empty_context_queries() -> i32 with IO, Mut, Div, Panic {
    let ctx = te_context_new()
    if te_total_vtable_methods(ctx) != 0 {
        print("FAIL: test_te_empty_context_queries - vtable_methods\n")
        return 1
    }
    if te_total_erased_params(ctx) != 0 {
        print("FAIL: test_te_empty_context_queries - erased_params\n")
        return 1
    }
    if te_total_witness_entries(ctx) != 0 {
        print("FAIL: test_te_empty_context_queries - witness_entries\n")
        return 1
    }
    if te_has_errors(ctx) {
        print("FAIL: test_te_empty_context_queries - no_errors\n")
        return 1
    }
    if te_find_vtable(ctx, 0, 0) != TE_NOT_FOUND {
        print("FAIL: test_te_empty_context_queries - find_vtable\n")
        return 1
    }
    if te_find_erased_fn(ctx, 0) != TE_NOT_FOUND {
        print("FAIL: test_te_empty_context_queries - find_fn\n")
        return 1
    }
    if te_find_witness(ctx, 0, 0) != TE_NOT_FOUND {
        print("FAIL: test_te_empty_context_queries - find_witness\n")
        return 1
    }
    print("PASS: test_te_empty_context_queries\n")
    return 0
}

// ============================================================
// Main test runner
// ============================================================

fn run_te_tests() -> i32 with IO, Mut, Div, Panic {
    var failures: i32 = 0
    failures = failures + test_te_classify_concrete_i64()
    failures = failures + test_te_classify_erased_var()
    failures = failures + test_te_classify_trait_obj()
    failures = failures + test_te_classify_concrete_bool()
    failures = failures + test_te_classify_ref()
    failures = failures + test_te_vtable_basic()
    failures = failures + test_te_vtable_method_lookup()
    failures = failures + test_te_vtable_drop()
    failures = failures + test_te_find_vtable()
    failures = failures + test_te_insert_box_op()
    failures = failures + test_te_insert_unbox_op()
    failures = failures + test_te_erase_fn_single_param()
    failures = failures + test_te_erase_fn_mixed_params()
    failures = failures + test_te_erase_fn_all_concrete()
    failures = failures + test_te_find_erased_fn()
    failures = failures + test_te_witness_basic()
    failures = failures + test_te_witness_find_entries()
    failures = failures + test_te_witness_method_count()
    failures = failures + test_te_layout_primitives()
    failures = failures + test_te_layout_erased_boxed()
    failures = failures + test_te_layout_aggregate()
    failures = failures + test_te_align_up()
    failures = failures + test_te_optimize_box_unbox()
    failures = failures + test_te_optimize_no_collapse()
    failures = failures + test_te_optimize_trivial_align()
    failures = failures + test_te_stats_tracking()
    failures = failures + test_te_type_map()
    failures = failures + test_te_type_map_overwrite()
    failures = failures + test_te_type_map_has()
    failures = failures + test_te_multiple_trait_impls()
    failures = failures + test_te_vtable_lookup_cast()
    failures = failures + test_te_size_assert_cast()
    failures = failures + test_te_align_cast()
    failures = failures + test_te_cast_count_by_kind()
    failures = failures + test_te_erased_fn_param_counting()
    failures = failures + test_te_layout_for_type()
    failures = failures + test_te_vtable_find_method()
    failures = failures + test_te_witness_no_drop()
    failures = failures + test_te_find_witness()
    failures = failures + test_te_get_erased_fn_id()
    failures = failures + test_te_type_predicates()
    failures = failures + test_te_erase_fn_idempotent()
    failures = failures + test_te_total_vtable_methods()
    failures = failures + test_te_total_erased_params()
    failures = failures + test_te_total_witness_entries()
    failures = failures + test_te_error_tracking()
    failures = failures + test_te_box_unbox_pair_detection()
    failures = failures + test_te_noop_size_assert()
    failures = failures + test_te_trivial_align_detection()
    failures = failures + test_te_cast_op_fields()
    failures = failures + test_te_cast_predicates()
    failures = failures + test_te_layout_eq()
    failures = failures + test_te_classify_and_register()
    failures = failures + test_te_is_primitive_kind()
    failures = failures + test_te_context_alloc()
    failures = failures + test_te_optimize_mixed()
    failures = failures + test_te_witness_entries()
    failures = failures + test_te_erase_trait_obj_param()
    failures = failures + test_te_full_pipeline()
    failures = failures + test_te_empty_context_queries()

    if failures == 0 {
        print("All type erasure tests passed.\n")
    } else {
        print("Some type erasure tests FAILED.\n")
    }
    return failures
}
