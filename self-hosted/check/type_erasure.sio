    ctx = te_erase_function(ctx, 42, params, 1, TE_TY_I64)
    if ctx.erased_fn_count != 1 {
        print("FAIL: test_te_erase_fn_idempotent - first\n")
        return 1
    }
    // Second call should be a no-op
    ctx = te_erase_function(ctx, 42, params, 1, TE_TY_I64)
    if ctx.erased_fn_count != 1 {
        print("FAIL: test_te_erase_fn_idempotent - second\n")
        return 1
    }
    print("PASS: test_te_erase_fn_idempotent\n")
    return 0
}

