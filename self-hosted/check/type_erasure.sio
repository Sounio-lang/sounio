// ============================================================
// Test 47: Box-unbox pair detection
// ============================================================

fn test_te_box_unbox_pair_detection() -> i32 with IO, Mut, Div, Panic {
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    let unbox_op = te_cast_unbox(20, 30, 5, 8, 8)
    if te_is_box_unbox_pair(box_op, unbox_op) == false {
        print("FAIL: test_te_box_unbox_pair_detection - yes\n")
        return 1
    }
    // Wrong order
    if te_is_box_unbox_pair(unbox_op, box_op) {
        print("FAIL: test_te_box_unbox_pair_detection - order\n")
        return 1
    }
    // Different type
    let unbox_diff = te_cast_unbox(20, 30, 6, 8, 8)
    if te_is_box_unbox_pair(box_op, unbox_diff) {
        print("FAIL: test_te_box_unbox_pair_detection - type\n")
        return 1
    }
    // Register mismatch
    let unbox_reg = te_cast_unbox(99, 30, 5, 8, 8)
    if te_is_box_unbox_pair(box_op, unbox_reg) {
        print("FAIL: test_te_box_unbox_pair_detection - reg\n")
        return 1
    }
    print("PASS: test_te_box_unbox_pair_detection\n")
    return 0
}

// ============================================================
// Test 48: Noop size assert detection
// ============================================================

fn test_te_noop_size_assert() -> i32 with IO, Mut, Div, Panic {
    let op = te_cast_size_assert(10, 20, 5, 8)
    if te_is_noop_size_assert(op, 8) == false {
        print("FAIL: test_te_noop_size_assert - match\n")
        return 1
    }
    if te_is_noop_size_assert(op, 16) {
        print("FAIL: test_te_noop_size_assert - mismatch\n")
        return 1
    }
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    if te_is_noop_size_assert(box_op, 8) {
        print("FAIL: test_te_noop_size_assert - wrong_kind\n")
        return 1
    }
    print("PASS: test_te_noop_size_assert\n")
    return 0
}

// ============================================================
// Test 49: Trivial align detection
// ============================================================

fn test_te_trivial_align_detection() -> i32 with IO, Mut, Div, Panic {
    let a1 = te_cast_align(10, 20, 5, 1)
    if te_is_trivial_align(a1) == false {
        print("FAIL: test_te_trivial_align_detection - 1\n")
        return 1
    }
    let a0 = te_cast_align(10, 20, 5, 0)
    if te_is_trivial_align(a0) == false {
        print("FAIL: test_te_trivial_align_detection - 0\n")
        return 1
    }
    let a8 = te_cast_align(10, 20, 5, 8)
    if te_is_trivial_align(a8) {
        print("FAIL: test_te_trivial_align_detection - 8\n")
        return 1
    }
    let box_op = te_cast_box(10, 20, 5, 8, 1)
    if te_is_trivial_align(box_op) {
        print("FAIL: test_te_trivial_align_detection - wrong_kind\n")
        return 1
    }
    print("PASS: test_te_trivial_align_detection\n")
    return 0
}

// ============================================================
