    ctx = te_build_witness(ctx, 10, 20, 8, 4, TE_NOT_FOUND, methods, 1)
    let w = ctx.witnesses[0 as usize]
    let dr = te_witness_find_drop(w)
    if dr != TE_NOT_FOUND {
        print("FAIL: test_te_witness_no_drop\n")
        return 1
    }
    // Should have size + align + 1 method = 3 entries (no drop)
    if w.entry_count != 3 {
        print("FAIL: test_te_witness_no_drop - count\n")
        return 1
    }
    print("PASS: test_te_witness_no_drop\n")
    return 0
}

