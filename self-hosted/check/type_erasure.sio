// ============================================================
// Test 21: Layout aggregate computation
// ============================================================

fn test_te_layout_aggregate() -> i32 with IO, Mut, Div, Panic {
    // Struct { a: i32, b: i64 } → align=8, size=16 (4 padded to 8, + 8)
    var sizes: [i64; 16] = [0; 16]
    var aligns: [i64; 16] = [0; 16]
    sizes[0 as usize] = 4
    aligns[0 as usize] = 4
    sizes[1 as usize] = 8
    aligns[1 as usize] = 8
    let layout = te_layout_aggregate(sizes, aligns, 2)
    if layout.alignment != 8 {
        print("FAIL: test_te_layout_aggregate - align\n")
        return 1
    }
    if layout.size != 16 {
        print("FAIL: test_te_layout_aggregate - size\n")
        return 1
    }
    print("PASS: test_te_layout_aggregate\n")
    return 0
}

