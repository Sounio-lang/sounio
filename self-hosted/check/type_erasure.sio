    var ctx = te_context_new()
    let m1 = te_make_methods_1_set(100)
    let m2 = te_make_methods_2_set(200, 201)
    ctx = te_build_witness(ctx, 10, 20, 8, 8, 999, m1, 1)
    ctx = te_build_witness(ctx, 11, 21, 16, 8, TE_NOT_FOUND, m2, 2)
