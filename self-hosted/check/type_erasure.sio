// ============================================================
// Test 34: Cast count by kind
// ============================================================

fn test_te_cast_count_by_kind() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    ctx = te_insert_box(ctx, 1, 0, 8, 8)
    ctx = te_insert_box(ctx, 2, 0, 8, 8)
    ctx = te_insert_unbox(ctx, 3, 0, 8, 8)
    ctx = te_insert_vtable_lookup(ctx, 4, 0, 0)
    let box_count = te_cast_count_by_kind(ctx, TE_CAST_BOX)
    if box_count != 2 {
        print("FAIL: test_te_cast_count_by_kind - box\n")
        return 1
    }
    let unbox_count = te_cast_count_by_kind(ctx, TE_CAST_UNBOX)
    if unbox_count != 1 {
        print("FAIL: test_te_cast_count_by_kind - unbox\n")
        return 1
    }
    let vt_count = te_cast_count_by_kind(ctx, TE_CAST_VTABLE_LOOKUP)
    if vt_count != 1 {
        print("FAIL: test_te_cast_count_by_kind - vt\n")
        return 1
    }
    print("PASS: test_te_cast_count_by_kind\n")
    return 0
}

