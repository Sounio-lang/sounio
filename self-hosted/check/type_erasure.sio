    }
    print("PASS: test_te_align_up\n")
    return 0
}

// ============================================================
// Test 23: Cast chain optimization — box-unbox collapse
// ============================================================

fn test_te_optimize_box_unbox() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Insert a box followed by matching unbox (same dst→src chain, same type)
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    let unbox_op = te_cast_unbox(20, 30, 5, 8, 8)
    ctx.cast_ops[0 as usize] = box_op
    ctx.cast_ops[1 as usize] = unbox_op
    ctx.cast_op_count = 2
    ctx = te_optimize_casts(ctx)
    if ctx.cast_op_count != 0 {
        print("FAIL: test_te_optimize_box_unbox - count\n")
        return 1
    }
    if ctx.stats.casts_optimized_away != 2 {
        print("FAIL: test_te_optimize_box_unbox - optimized\n")
        return 1
    }
    print("PASS: test_te_optimize_box_unbox\n")
    return 0
}

// ============================================================
// Test 24: Cast chain optimization — non-matching pair kept
// ============================================================

fn test_te_optimize_no_collapse() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Different type indices — should NOT collapse
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    let unbox_op = te_cast_unbox(20, 30, 6, 8, 8)
    ctx.cast_ops[0 as usize] = box_op
    ctx.cast_ops[1 as usize] = unbox_op
    ctx.cast_op_count = 2
    ctx = te_optimize_casts(ctx)
    if ctx.cast_op_count != 2 {
        print("FAIL: test_te_optimize_no_collapse\n")
        return 1
    }
    print("PASS: test_te_optimize_no_collapse\n")
    return 0
}

