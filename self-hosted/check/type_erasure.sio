    vt = te_vtable_add_method(vt, 100)
    vt = te_vtable_add_method(vt, 200)
    vt = te_vtable_add_method(vt, 300)
    let idx = te_vtable_find_method(vt, 200)
    if idx != 1 {
        print("FAIL: test_te_vtable_find_method - found\n")
        return 1
    }
    let miss = te_vtable_find_method(vt, 999)
