// ============================================================
// Test 24: Live ranges overlap detection
// ============================================================

fn lt_test_live_ranges_overlap() -> i64 with IO, Mut, Panic, Div {
    let a = LiveRange { borrow_id: 0, start_point: 10, end_point: 50 }
    let b = LiveRange { borrow_id: 1, start_point: 40, end_point: 80 }
    let c = LiveRange { borrow_id: 2, start_point: 60, end_point: 90 }

    let ok1 = lt_live_ranges_overlap(a, b)   // overlap at [40,50]
    let ok2 = !lt_live_ranges_overlap(a, c)  // no overlap
    let ok3 = lt_live_ranges_overlap(b, c)   // overlap at [60,80]
    lt_assert_true(ok1 && ok2 && ok3, 24)
}

// ============================================================
// Test 25: Dangling detection — borrow escapes its region
// ============================================================

fn lt_test_dangling_detection() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    // Inner block region [20, 50]
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0

    // Borrow in the fn region (1) pointing to a place defined in the block region (2)
    // region_id=1 (fn, [10,100]), place_id=2 (block, [20,50])
    // Fn region is NOT contained in block region, so this is dangling
    let b1 = borrow_info_new(0, 1, 2, BORROW_SHARED(), false, 15)
    let bp = lt_add_borrow(c3, b1)
    let c4 = bp.0

    let is_dangling = lt_check_dangling_single(c4, 0)
    lt_assert_true(is_dangling, 25)
}

// ============================================================
// Test 26: Non-dangling borrow (contained in place region)
// ============================================================

fn lt_test_non_dangling() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0

    // Borrow in block region (2) pointing to place in fn region (1)
    // Block [20,50] is contained in fn [10,100], so NOT dangling
    let b1 = borrow_info_new(0, 2, 1, BORROW_SHARED(), false, 25)
    let bp = lt_add_borrow(c3, b1)
    let c4 = bp.0

    let is_dangling = lt_check_dangling_single(c4, 0)
    lt_assert_true(!is_dangling, 26)
}

// ============================================================
// Test 27: Region child count
// ============================================================

fn lt_test_region_child_count() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0
    let p4 = lt_add_block_region(c3, 1, 60, 90)
    let c4 = p4.0

    let children_of_fn = lt_region_child_count(c4, 1)
    let children_of_static = lt_region_child_count(c4, 0)
    let ok = children_of_fn == 2 && children_of_static == 1
    lt_assert_true(ok, 27)
}

// ============================================================
// Test 28: Full analysis pipeline — no errors for clean program
// ============================================================

fn lt_test_clean_analysis() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 80)
    let c3 = p3.0

    // Two shared borrows in block, referencing place in fn — safe
    let b1 = lt_add_shared_borrow(c3, 2, 1, 25)
    let c4 = b1.0
    let b2 = lt_add_shared_borrow(c4, 2, 1, 30)
    let c5 = b2.0

    // Add an outlives constraint that is already satisfied (fn outlives block)
    let c6 = lt_add_outlives(c5, 1, 2, 0)

    // Run full analysis
    let c7 = lt_analyze(c6)
    lt_assert_true(c7.error_count == 0, 28)
}

// ============================================================
// Test 29: Full analysis pipeline — detects mutable conflict
// ============================================================

fn lt_test_analysis_detects_conflict() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    // Two mutable borrows on same place in the same region — conflict
    let b1 = lt_add_mutable_borrow(c2, 1, 5, 20)
    let c3 = b1.0
    let b2 = lt_add_mutable_borrow(c3, 1, 5, 40)
    let c4 = b2.0

    let c5 = lt_analyze(c4)
    // Should have at least 1 error from borrow conflict
    lt_assert_true(c5.error_count >= 1, 29)
}

// ============================================================
// Test 30: Region kind queries
// ============================================================

fn lt_test_region_kind_queries() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 80)
    let c3 = p3.0
    let p4 = lt_add_expr_region(c3, 2, 30, 50)
    let c4 = p4.0

    let ok = lt_region_kind(c4, 0) == REGION_STATIC()
             && lt_region_kind(c4, 1) == REGION_FN()
             && lt_region_kind(c4, 2) == REGION_BLOCK()
             && lt_region_kind(c4, 3) == REGION_EXPR()
    lt_assert_true(ok, 30)
}

// ============================================================
// Test 31: is_static check
// ============================================================

fn lt_test_is_static() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    let ok = lt_is_static(c2, 0) && !lt_is_static(c2, 1)
    lt_assert_true(ok, 31)
}

// ============================================================
// Test 32: Borrow place and region accessors
// ============================================================

fn lt_test_borrow_accessors() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    let b1 = lt_add_shared_borrow(c2, 1, 42, 20)
    let c3 = b1.0

    let ok = lt_borrow_place(c3, 0) == 42
             && lt_borrow_region(c3, 0) == 1
             && lt_borrow_kind(c3, 0) == BORROW_SHARED()
    lt_assert_true(ok, 32)
}

// ============================================================
// Test 33: Count unsatisfied constraints
// ============================================================

fn lt_test_count_unsatisfied() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    // Region 1: [10, 50], Region 2: [10, 100]
    let p2 = lt_add_fn_region(c1, 0, 10, 50)
    let c2 = p2.0
    let p3 = lt_add_fn_region(c2, 0, 10, 100)
    let c3 = p3.0

    // Constraint: region 1 outlives region 2 — NOT satisfied initially
    // because region 1 [10,50] does not cover region 2 [10,100]
    let c4 = lt_add_outlives(c3, 1, 2, 0)
    let count = lt_count_unsatisfied(c4)
    lt_assert_true(count == 1, 33)
}

// ============================================================
// Test 34: Count conflicts diagnostic
// ============================================================

fn lt_test_count_conflicts() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    // Three mutable borrows on same place -> 3 pairwise conflicts
    let b1 = lt_add_mutable_borrow(c2, 1, 5, 20)
    let c3 = b1.0
    let b2 = lt_add_mutable_borrow(c3, 1, 5, 30)
    let c4 = b2.0
    let b3 = lt_add_mutable_borrow(c4, 1, 5, 40)
    let c5 = b3.0

    let count = lt_count_conflicts(c5)
    // C(3,2) = 3 pairwise conflicts
    lt_assert_true(count == 3, 34)
}

// ============================================================
// Test 35: Compute all live ranges
// ============================================================

fn lt_test_compute_all_live_ranges() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0

    let b1 = lt_add_shared_borrow(c3, 1, 5, 15)
    let c4 = b1.0
    let b2 = lt_add_mutable_borrow(c4, 2, 6, 25)
    let c5 = b2.0

    let result = lt_compute_live_ranges(c5)
    let ranges = result.0
    let count = result.1

    let ok = count == 2
             && ranges[0].start_point == 15 && ranges[0].end_point == 100
             && ranges[1].start_point == 25 && ranges[1].end_point == 50
    lt_assert_true(ok, 35)
}

// ============================================================
// Test 36: Solver with chained outlives constraints
// ============================================================

fn lt_test_solver_chain() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    // Region 1: [10, 30], Region 2: [10, 60], Region 3: [10, 90]
    let p2 = lt_add_fn_region(c1, 0, 10, 30)
    let c2 = p2.0
    let p3 = lt_add_fn_region(c2, 0, 10, 60)
    let c3 = p3.0
    let p4 = lt_add_fn_region(c3, 0, 10, 90)
    let c4 = p4.0

    // Chain: region 1 outlives region 2, region 2 outlives region 3
    let c5 = lt_add_outlives(c4, 1, 2, 0)
    let c6 = lt_add_outlives(c5, 2, 3, 0)
    let c7 = lt_solve_constraints(c6)

    // After solving: region 1 end >= 90, region 2 end >= 90
    let ok = c7.regions[1].end_point >= 90
             && c7.regions[2].end_point >= 90
             && c7.error_count == 0
    lt_assert_true(ok, 36)
}

// ============================================================
// Test 37: Region parent accessor
// ============================================================

fn lt_test_region_parent_accessor() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    let parent_of_fn = lt_region_parent(c2, 1)
    let parent_of_static = lt_region_parent(c2, 0)

    let ok = parent_of_fn == 0 && parent_of_static == (0 - 1)
    lt_assert_true(ok, 37)
}

// ============================================================
// Test 38: Region span accessors
// ============================================================

fn lt_test_region_span_accessors() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 42, 99)
    let c2 = p2.0

    let start = lt_region_span_start(c2, 1)
    let end = lt_region_span_end(c2, 1)
    let ok = start == 42 && end == 99
    lt_assert_true(ok, 38)
}

// ============================================================
// Test 39: Out of bounds region queries return safe defaults
// ============================================================

fn lt_test_bounds_safety() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()

    let depth = lt_region_depth(c, 999)
    let kind = lt_region_kind(c, 999)
    let parent = lt_region_parent(c, 999)
    let start = lt_region_span_start(c, 999)
    let end = lt_region_span_end(c, 999)
    let is_s = lt_is_static(c, 999)

    let ok = depth == 0 && kind == (0 - 1) && parent == (0 - 1)
             && start == 0 && end == 0 && !is_s
    lt_assert_true(ok, 39)
}

// ============================================================
// Test 40: Count dangling borrows utility
// ============================================================

fn lt_test_count_dangling() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0

    // Borrow in fn region referencing place in block region — dangling
    let b1 = borrow_info_new(0, 1, 2, BORROW_SHARED(), false, 15)
    let bp1 = lt_add_borrow(c3, b1)
    let c4 = bp1.0

    // Borrow in block region referencing place in fn region — safe
    let b2 = borrow_info_new(1, 2, 1, BORROW_SHARED(), false, 25)
    let bp2 = lt_add_borrow(c4, b2)
    let c5 = bp2.0

    let dangling = lt_count_dangling(c5)
    lt_assert_true(dangling == 1, 40)
}

// ============================================================
// Test runner
// ============================================================

fn lifetime_check_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Lifetime checker tests ===\n")
    var fails: i64 = 0
    fails = fails + lt_test_empty_checker()
    fails = fails + lt_test_add_static_region()
    fails = fails + lt_test_nested_regions()
    fails = fails + lt_test_region_contains_self()
    fails = fails + lt_test_static_contains_children()
    fails = fails + lt_test_child_not_contains_parent()
    fails = fails + lt_test_region_depth()
    fails = fails + lt_test_common_ancestor_siblings()
    fails = fails + lt_test_common_ancestor_parent_child()
    fails = fails + lt_test_add_borrows()
    fails = fails + lt_test_shared_no_conflict()
    fails = fails + lt_test_mut_shared_conflict()
    fails = fails + lt_test_mut_mut_conflict()
    fails = fails + lt_test_different_places_no_conflict()
    fails = fails + lt_test_non_overlapping_no_conflict()
    fails = fails + lt_test_move_conflicts_shared()
    fails = fails + lt_test_static_outlives_all()
    fails = fails + lt_test_block_not_outlives_fn()
    fails = fails + lt_test_solver_widens()
    fails = fails + lt_test_solver_equality()
    fails = fails + lt_test_check_borrows_count()
    fails = fails + lt_test_find_conflicts_pairs()
    fails = fails + lt_test_live_ranges()
    fails = fails + lt_test_live_ranges_overlap()
    fails = fails + lt_test_dangling_detection()
    fails = fails + lt_test_non_dangling()
    fails = fails + lt_test_region_child_count()
    fails = fails + lt_test_clean_analysis()
    fails = fails + lt_test_analysis_detects_conflict()
    fails = fails + lt_test_region_kind_queries()
    fails = fails + lt_test_is_static()
    fails = fails + lt_test_borrow_accessors()
    fails = fails + lt_test_count_unsatisfied()
    fails = fails + lt_test_count_conflicts()
    fails = fails + lt_test_compute_all_live_ranges()
    fails = fails + lt_test_solver_chain()
    fails = fails + lt_test_region_parent_accessor()
    fails = fails + lt_test_region_span_accessors()
    fails = fails + lt_test_bounds_safety()
    fails = fails + lt_test_count_dangling()

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}
