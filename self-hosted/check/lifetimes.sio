// ============================================================
// Test 22: lt_find_conflicts returns correct pairs
// ============================================================

fn lt_test_find_conflicts_pairs() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0

    // Mutable + shared on place 9 -> conflict
    let b1 = lt_add_mutable_borrow(c2, 1, 9, 20)
    let c3 = b1.0
    let b2 = lt_add_shared_borrow(c3, 1, 9, 30)
    let c4 = b2.0
    // Shared + shared on place 9 -> no conflict
    let b3 = lt_add_shared_borrow(c4, 1, 9, 40)
    let c5 = b3.0

    let result = lt_find_conflicts(c5)
    let conflicts = result.0
    let count = result.1
    // Borrow 0 (mut) conflicts with borrow 1 (shared) and borrow 2 (shared)
    // Borrow 1 (shared) and borrow 2 (shared) do not conflict
    let ok = count == 2
             && conflicts[0].borrow_a == 0 && conflicts[0].borrow_b == 1
             && conflicts[1].borrow_a == 0 && conflicts[1].borrow_b == 2
    lt_assert_true(ok, 22)
}

