// ============================================================
// Test 19: Constraint solver widens region
// ============================================================

fn lt_test_solver_widens() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    // Region 1: [10, 50]
    let p2 = lt_add_fn_region(c1, 0, 10, 50)
    let c2 = p2.0
    // Region 2: [10, 100]
    let p3 = lt_add_fn_region(c2, 0, 10, 100)
    let c3 = p3.0

    // Constraint: region 1 must outlive region 2 (1 outlives 2)
    // This should widen region 1's end from 50 to 100
    let c4 = lt_add_outlives(c3, 1, 2, 0)
    let c5 = lt_solve_constraints(c4)

    let ok = c5.regions[1].end_point >= 100 && c5.error_count == 0
    lt_assert_true(ok, 19)
}

// ============================================================
// Test 20: Constraint solver equality propagation
// ============================================================

fn lt_test_solver_equality() -> i64 with IO, Mut, Panic, Div {
    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    // Region 1: [10, 50]
    let p2 = lt_add_fn_region(c1, 0, 10, 50)
    let c2 = p2.0
    // Region 2: [10, 80]
    let p3 = lt_add_fn_region(c2, 0, 10, 80)
    let c3 = p3.0

    // Equality: both must end at max(50, 80) = 80
    let c4 = lt_add_equal(c3, 1, 2, 0)
    let c5 = lt_solve_constraints(c4)

    let ok = c5.regions[1].end_point == 80
             && c5.regions[2].end_point == 80
             && c5.error_count == 0
    lt_assert_true(ok, 20)
}

