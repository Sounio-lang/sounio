    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 100)
    let c2 = p2.0
    let p3 = lt_add_block_region(c2, 1, 20, 80)
    let c3 = p3.0

    let ok1 = lt_region_contains(c3, 0, 1)
    let ok2 = lt_region_contains(c3, 0, 2)
    let ok3 = lt_region_contains(c3, 1, 2)
    lt_assert_true(ok1 && ok2 && ok3, 5)
}

