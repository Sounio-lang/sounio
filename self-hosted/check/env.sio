// Type environment for the type checker
//
// Scope-stack pattern (same as resolver), but stores TypeBinding
// with name, type, mutability, and scope depth.

use parser::ast::{Name, name_eq}
use check::types::{TypeEntry, empty_type_entry, ty_error}

// ============================================================
// Type binding
// ============================================================

pub struct TypeBinding {
    pub name: Name,
    pub ty: TypeEntry,
    pub is_mutable: bool,
    pub scope_depth: i64,
}

fn empty_type_binding() -> TypeBinding {
    TypeBinding {
        name: Name { buf: [0; 384], len: 0 },
        ty: empty_type_entry(),
        is_mutable: false,
        scope_depth: 0,
    }
}

// ============================================================
// Type environment
// ============================================================

// Shared module globals and function locals use this bounded table. The
// combined compiler crossed 4096 after the const-fold tracking tables moved
// to BSS. Keep the storage and insertion limits identical; overflow is sticky
// across scope exits so the checker must refuse rather than lose bindings.
// The advertised 8191 BSS globals must also leave room for checker bindings
// and lexical locals; 8192 total entries refused the global-boundary gate.
// This table has its own explicit limit; BSS and IR limits are unchanged.
pub let TYPE_ENV_CAPACITY: i64 = 12288

pub struct TypeEnv {
    pub bindings: [TypeBinding; 12288],
    pub count: i64,
    pub scope_starts: [i64; 64],
    pub scope_depth: i64,
    pub overflowed: bool,
    pub overflow_reported: bool,
}

// By-value constructor for the oracle. The compile path must not call this:
// the return is the whole 12288-binding table. Use type_env_reset_into.
pub fn type_env_new() -> TypeEnv {
    TypeEnv {
        bindings: [empty_type_binding(); 12288],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
        overflowed: false,
        overflow_reported: false,
    }
}

// Reset a heap TypeEnv without materializing the table on the stack. Bindings
// past count are unread; lookup walks 0..count-1 only.
pub fn type_env_reset_into(env: &!TypeEnv) with Mut, Panic, Div {
    env.count = 0
    env.scope_depth = 0
    env.overflowed = false
    env.overflow_reported = false
    var i: i64 = 0
    while i < 64 {
        env.scope_starts[i as usize] = 0
        i = i + 1
    }
}

pub fn type_env_bind_mut(env: &!TypeEnv, name: Name, ty: TypeEntry, is_mutable: bool) with Mut, Panic, Div {
    if env.count < TYPE_ENV_CAPACITY {
        let idx = env.count
        env.bindings[idx as usize] = TypeBinding {
            name: name,
            ty: ty,
            is_mutable: is_mutable,
            scope_depth: env.scope_depth,
        }
        env.count = idx + 1
    } else {
        env.overflowed = true
    }
}

pub fn type_env_push_scope_mut(env: &!TypeEnv) with Mut, Panic, Div {
    if env.scope_depth < 64 {
        let depth = env.scope_depth
        env.scope_starts[depth as usize] = env.count
        env.scope_depth = depth + 1
    }
}

pub fn type_env_pop_scope_mut(env: &!TypeEnv) with Mut, Panic, Div {
    if env.scope_depth > 0 {
        env.scope_depth = env.scope_depth - 1
        let depth = env.scope_depth
        env.count = env.scope_starts[depth as usize]
    }
}

pub fn type_env_lookup(env: &TypeEnv, name: Name) -> TypeEntry with Mut, Panic, Div {
    var i = env.count - 1
    while i >= 0 {
        if name_eq(env.bindings[i as usize].name, name) {
            return env.bindings[i as usize].ty
        }
        i = i - 1
    }
    ty_error()
}

pub fn type_env_has_binding(env: &TypeEnv, name: Name) -> bool with Mut, Panic, Div {
    var i = env.count - 1
    while i >= 0 {
        if name_eq(env.bindings[i as usize].name, name) {
            return true
        }
        i = i - 1
    }
    false
}

pub fn type_env_lookup_is_mutable(env: &TypeEnv, name: Name) -> bool with Mut, Panic, Div {
    var i = env.count - 1
    while i >= 0 {
        if name_eq(env.bindings[i as usize].name, name) {
            return env.bindings[i as usize].is_mutable
        }
        i = i - 1
    }
    false
}

// Oracle wrappers. Each copies the table once so a by-value caller can keep the
// old `env = env.bind(...)` shape. The checker must call the pointer functions.
impl TypeEnv {
    fn push_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        type_env_push_scope_mut(&!env)
        env
    }

    fn pop_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        type_env_pop_scope_mut(&!env)
        env
    }

    fn bind(self, name: Name, ty: TypeEntry, is_mutable: bool) -> TypeEnv with Mut, Panic, Div {
        var env = self
        type_env_bind_mut(&!env, name, ty, is_mutable)
        env
    }

    fn lookup(self, name: Name) -> TypeEntry with Mut, Panic, Div {
        type_env_lookup(&self, name)
    }

    fn has_binding(self, name: Name) -> bool with Mut, Panic, Div {
        type_env_has_binding(&self, name)
    }

    fn lookup_is_mutable(self, name: Name) -> bool with Mut, Panic, Div {
        type_env_lookup_is_mutable(&self, name)
    }
}
