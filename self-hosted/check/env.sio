// Type environment for the type checker
//
// Scope-stack pattern (same as resolver), but stores TypeBinding
// with name, type, mutability, and scope depth.

use parser::ast::{Name, name_eq}
use check::types::{TypeEntry, empty_type_entry, ty_error}

// ============================================================
// Type binding
// ============================================================

pub struct TypeBinding {
    pub name: Name,
    pub ty: TypeEntry,
    pub is_mutable: bool,
    pub scope_depth: i64,
}

fn empty_type_binding() -> TypeBinding {
    TypeBinding {
        name: Name { buf: [0; 384], len: 0 },
        ty: empty_type_entry(),
        is_mutable: false,
        scope_depth: 0,
    }
}

// ============================================================
// Type environment
// ============================================================

// Shared module globals and function locals use this bounded table. The
// combined compiler crossed 4096 after the const-fold tracking tables moved
// to BSS. Keep the storage and insertion limits identical; overflow is sticky
// across scope exits so the checker must refuse rather than lose bindings.
// The advertised 8191 BSS globals must also leave room for checker bindings
// and lexical locals; 8192 total entries refused the global-boundary gate.
// This table has its own explicit limit; BSS and IR limits are unchanged.
pub let TYPE_ENV_CAPACITY: i64 = 12288

// 48 lazy chunks * 256 slots/chunk == 12288 exact capacity.
// Unallocated chunks stay None so checker_init_in_place does not materialize
// a 4.86 MiB inline table on the 8 MiB stack, and small modules allocate
// only the chunks they actually touch.
pub struct TypeBindingChunk {
    pub slots: [TypeBinding; 256],
}

fn empty_type_binding_chunk() -> TypeBindingChunk {
    TypeBindingChunk {
        slots: [empty_type_binding(); 256],
    }
}

pub struct TypeBindingChunkSlot {
    pub ptr: Option<Box<TypeBindingChunk> >,
}

fn empty_type_binding_chunk_slot() -> TypeBindingChunkSlot {
    TypeBindingChunkSlot {
        ptr: None,
    }
}

pub struct TypeEnv {
    pub chunks: [TypeBindingChunkSlot; 48],
    pub count: i64,
    pub scope_starts: [i64; 64],
    pub scope_depth: i64,
    pub overflowed: bool,
    pub overflow_reported: bool,
}

pub fn type_env_new() -> TypeEnv {
    TypeEnv {
        chunks: [empty_type_binding_chunk_slot(); 48],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
        overflowed: false,
        overflow_reported: false,
    }
}

// Reset a heap TypeEnv without reallocating existing chunks. Bindings
// past count are unread; lookup walks 0..count-1 only.
pub fn type_env_reset_into(env: &!TypeEnv) with Mut, Panic, Div {
    env.count = 0
    env.scope_depth = 0
    env.overflowed = false
    env.overflow_reported = false
    var i: i64 = 0
    while i < 64 {
        env.scope_starts[i as usize] = 0
        i = i + 1
    }
}

fn type_chunk_get_slot(chunk_ref: &TypeBindingChunk, si: i64) -> TypeBinding with Mut, Panic, Div {
    (*chunk_ref).slots[si as usize]
}

fn type_chunk_set_slot_mut(chunk_ref: &!TypeBindingChunk, si: i64, b: TypeBinding) with Mut, Panic, Div {
    (*chunk_ref).slots[si as usize] = b
}

fn type_chunk_find_slot_rev(chunk_ref: &TypeBindingChunk, start_si: i64, name: &Name) -> i64 with Mut, Panic, Div {
    let nlen = (*name).len
    var si = start_si
    while si >= 0 {
        if (*chunk_ref).slots[si as usize].name.len == nlen {
            var eq = true
            var k: i64 = 0
            while k < nlen {
                if (*chunk_ref).slots[si as usize].name.buf[k as usize] != (*name).buf[k as usize] {
                    eq = false
                    break
                }
                k = k + 1
            }
            if eq {
                return si
            }
        }
        si = si - 1
    }
    0 - 1
}

pub fn type_env_get_binding(env: &TypeEnv, idx: i64) -> TypeBinding with Mut, Panic, Div {
    if idx < 0 || idx >= (*env).count || idx >= TYPE_ENV_CAPACITY {
        return empty_type_binding()
    }
    let ci = idx / 256
    let si = idx % 256
    match (*env).chunks[ci as usize].ptr {
        Some(chunk) => type_chunk_get_slot(&(*chunk), si),
        None => empty_type_binding(),
    }
}

pub fn type_env_set_binding_mut(env: &!TypeEnv, idx: i64, b: TypeBinding) with Mut, Panic, Div, Alloc {
    if idx < 0 || idx >= TYPE_ENV_CAPACITY {
        return
    }
    let ci = idx / 256
    let si = idx % 256
    match (*env).chunks[ci as usize].ptr {
        Some(chunk) => {
            var ch = chunk
            type_chunk_set_slot_mut(&!(*ch), si, b)
        }
        None => {
            var fresh = Box::new(empty_type_binding_chunk())
            type_chunk_set_slot_mut(&!(*fresh), si, b)
            (*env).chunks[ci as usize] = TypeBindingChunkSlot { ptr: Some(fresh) }
        }
    }
}

pub fn type_env_bind_mut(env: &!TypeEnv, name: Name, ty: TypeEntry, is_mutable: bool) with Mut, Panic, Div, Alloc {
    if env.count < TYPE_ENV_CAPACITY {
        let idx = env.count
        let b = TypeBinding {
            name: name,
            ty: ty,
            is_mutable: is_mutable,
            scope_depth: env.scope_depth,
        }
        type_env_set_binding_mut(env, idx, b)
        env.count = idx + 1
    } else {
        env.overflowed = true
    }
}

pub fn type_env_push_scope_mut(env: &!TypeEnv) with Mut, Panic, Div {
    if env.scope_depth < 64 {
        let depth = env.scope_depth
        env.scope_starts[depth as usize] = env.count
        env.scope_depth = depth + 1
    }
}

pub fn type_env_pop_scope_mut(env: &!TypeEnv) with Mut, Panic, Div {
    if env.scope_depth > 0 {
        env.scope_depth = env.scope_depth - 1
        let depth = env.scope_depth
        env.count = env.scope_starts[depth as usize]
    }
}

pub fn type_env_lookup(env: &TypeEnv, name: Name) -> TypeEntry with Mut, Panic, Div {
    let total = (*env).count
    if total <= 0 {
        return ty_error()
    }
    let last = total - 1
    var ci = last / 256
    var start_si = last % 256
    while ci >= 0 {
        match (*env).chunks[ci as usize].ptr {
            Some(chunk) => {
                let hit = type_chunk_find_slot_rev(&(*chunk), start_si, &name)
                if hit >= 0 {
                    return type_chunk_get_slot(&(*chunk), hit).ty
                }
            }
            None => {}
        }
        ci = ci - 1
        start_si = 255
    }
    ty_error()
}

pub fn type_env_has_binding(env: &TypeEnv, name: Name) -> bool with Mut, Panic, Div {
    let total = (*env).count
    if total <= 0 {
        return false
    }
    let last = total - 1
    var ci = last / 256
    var start_si = last % 256
    while ci >= 0 {
        match (*env).chunks[ci as usize].ptr {
            Some(chunk) => {
                if type_chunk_find_slot_rev(&(*chunk), start_si, &name) >= 0 {
                    return true
                }
            }
            None => {}
        }
        ci = ci - 1
        start_si = 255
    }
    false
}

pub fn type_env_lookup_is_mutable(env: &TypeEnv, name: Name) -> bool with Mut, Panic, Div {
    let total = (*env).count
    if total <= 0 {
        return false
    }
    let last = total - 1
    var ci = last / 256
    var start_si = last % 256
    while ci >= 0 {
        match (*env).chunks[ci as usize].ptr {
            Some(chunk) => {
                let hit = type_chunk_find_slot_rev(&(*chunk), start_si, &name)
                if hit >= 0 {
                    return type_chunk_get_slot(&(*chunk), hit).is_mutable
                }
            }
            None => {}
        }
        ci = ci - 1
        start_si = 255
    }
    false
}

// Oracle wrappers.
impl TypeEnv {
    fn push_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        type_env_push_scope_mut(&!env)
        env
    }

    fn pop_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        type_env_pop_scope_mut(&!env)
        env
    }

    fn bind(self, name: Name, ty: TypeEntry, is_mutable: bool) -> TypeEnv with Mut, Panic, Div, Alloc {
        var env = self
        type_env_bind_mut(&!env, name, ty, is_mutable)
        env
    }

    fn lookup(self, name: Name) -> TypeEntry with Mut, Panic, Div {
        type_env_lookup(&self, name)
    }

    fn has_binding(self, name: Name) -> bool with Mut, Panic, Div {
        type_env_has_binding(&self, name)
    }

    fn lookup_is_mutable(self, name: Name) -> bool with Mut, Panic, Div {
        type_env_lookup_is_mutable(&self, name)
    }
}
