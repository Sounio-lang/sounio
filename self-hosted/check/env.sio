// Type environment for the type checker
//
// Scope-stack pattern (same as resolver), but stores TypeBinding
// with name, type, mutability, and scope depth.

use parser::ast::{Name, name_eq}
use check::types::{TypeEntry, empty_type_entry, ty_error}

// ============================================================
// Type binding
// ============================================================

pub struct TypeBinding {
    pub name: Name,
    pub ty: TypeEntry,
    pub is_mutable: bool,
    pub scope_depth: i64,
}

fn empty_type_binding() -> TypeBinding {
    TypeBinding {
        name: Name { buf: [0; 384], len: 0 },
        ty: empty_type_entry(),
        is_mutable: false,
        scope_depth: 0,
    }
}

// ============================================================
// Type environment
// ============================================================

// Shared module globals and function locals use this bounded table. The
// combined compiler crossed 4096 after the const-fold tracking tables moved
// to BSS. Keep the storage and insertion limits identical; overflow is sticky
// across scope exits so the checker must refuse rather than lose bindings.
// The advertised 8191 BSS globals must also leave room for checker bindings
// and lexical locals; 8192 total entries refused the global-boundary gate.
// This table has its own explicit limit; BSS and IR limits are unchanged.
pub let TYPE_ENV_CAPACITY: i64 = 12288

pub struct TypeEnv {
    pub bindings: [TypeBinding; 12288],
    pub count: i64,
    pub scope_starts: [i64; 64],
    pub scope_depth: i64,
    pub overflowed: bool,
    pub overflow_reported: bool,
}

pub fn type_env_new() -> TypeEnv {
    TypeEnv {
        bindings: [empty_type_binding(); 12288],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
        overflowed: false,
        overflow_reported: false,
    }
}

fn type_env_bind_mut(env: *mut TypeEnv, name: Name, ty: TypeEntry, is_mutable: bool) with Mut, Panic, Div {
    if (*env).count < TYPE_ENV_CAPACITY {
        let idx = (*env).count
        (*env).bindings[idx as usize] = TypeBinding {
            name: name,
            ty: ty,
            is_mutable: is_mutable,
            scope_depth: (*env).scope_depth,
        }
        (*env).count = idx + 1
    } else {
        (*env).overflowed = true
    }
}

impl TypeEnv {
    fn push_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth < 64 {
            env.scope_starts[env.scope_depth] = env.count
            env.scope_depth = env.scope_depth + 1
        }
        env
    }

    fn pop_scope(self) -> TypeEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth > 0 {
            env.scope_depth = env.scope_depth - 1
            env.count = env.scope_starts[env.scope_depth]
        }
        env
    }

    fn bind(self, name: Name, ty: TypeEntry, is_mutable: bool) -> TypeEnv with Mut, Panic, Div {
        var env = self
        if env.count < TYPE_ENV_CAPACITY {
            env.bindings[env.count] = TypeBinding {
                name: name,
                ty: ty,
                is_mutable: is_mutable,
                scope_depth: env.scope_depth,
            }
            env.count = env.count + 1
        } else {
            env.overflowed = true
        }
        env
    }

    fn lookup(self, name: Name) -> TypeEntry with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.bindings[i].name, name) {
                return self.bindings[i].ty
            }
            i = i - 1
        }
        ty_error()
    }

    fn has_binding(self, name: Name) -> bool with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.bindings[i].name, name) {
                return true
            }
            i = i - 1
        }
        false
    }

    fn lookup_is_mutable(self, name: Name) -> bool with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.bindings[i].name, name) {
                return self.bindings[i].is_mutable
            }
            i = i - 1
        }
        false
    }
}
