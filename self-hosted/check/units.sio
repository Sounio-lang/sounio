// Units and dimensional analysis for the type checker
//
// Represents physical quantities as vectors of base dimension exponents:
//   [mass, length, time, temperature, amount, current, luminosity]
//
// Examples:
//   mg, kg, g   -> [1, 0, 0, 0, 0, 0, 0]  (mass)
//   m, km       -> [0, 1, 0, 0, 0, 0, 0]  (length)
//   s, ms       -> [0, 0, 1, 0, 0, 0, 0]  (time)
//   K           -> [0, 0, 0, 1, 0, 0, 0]  (temperature)
//   mol         -> [0, 0, 0, 0, 1, 0, 0]  (amount)
//   m/s         -> [0, 1, -1, 0, 0, 0, 0] (velocity)
//   kg*m/s^2    -> [1, 1, -2, 0, 0, 0, 0] (force = Newton)
//
// Unit arithmetic:
//   a * b -> add dimension vectors
//   a / b -> subtract dimension vectors
//   a + b -> dimensions must match exactly
//   a - b -> dimensions must match exactly

// ============================================================
// Unit dimension vector (7 base SI dimensions)
// ============================================================

pub struct UnitDim {
    pub exponents: [i64; 7],   // [mass, length, time, temp, amount, current, luminosity]
    pub scale_num: i64,        // Scale factor numerator (for unit conversions)
    pub scale_den: i64,        // Scale factor denominator
}

pub fn unit_dim_dimensionless() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_mass() -> UnitDim {
    UnitDim {
        exponents: [1, 0, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

pub fn unit_dim_length() -> UnitDim {
    UnitDim {
        exponents: [0, 1, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

pub fn unit_dim_time() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 1, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_temperature() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 1, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_amount() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 0, 1, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_mass_concentration() -> UnitDim {
    UnitDim {
        exponents: [1, -3, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_amount_concentration() -> UnitDim {
    UnitDim {
        exponents: [0, -3, 0, 0, 1, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_activity_concentration() -> UnitDim {
    UnitDim {
        exponents: [0, -3, -1, 0, 1, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_volume() -> UnitDim {
    UnitDim {
        exponents: [0, 3, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_energy() -> UnitDim {
    UnitDim {
        exponents: [1, 2, 0 - 2, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_pressure() -> UnitDim {
    UnitDim {
        exponents: [1, 0 - 1, 0 - 2, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_length_per_time() -> UnitDim with Mut, Panic, Div {
    unit_dim_div(unit_dim_length(), unit_dim_time())
}

// ============================================================
// Dimension arithmetic
// ============================================================

// Multiply: add exponents
pub fn unit_dim_mul(a: UnitDim, b: UnitDim) -> UnitDim with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < 7 {
        result.exponents[i as usize] = a.exponents[i as usize] + b.exponents[i as usize]
        i = i + 1
    }
    result.scale_num = a.scale_num * b.scale_num
    result.scale_den = a.scale_den * b.scale_den
    result
}

// Divide: subtract exponents
pub fn unit_dim_div(a: UnitDim, b: UnitDim) -> UnitDim with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < 7 {
        result.exponents[i as usize] = a.exponents[i as usize] - b.exponents[i as usize]
        i = i + 1
    }
    // Scale: a/b
    result.scale_num = a.scale_num * b.scale_den
    result.scale_den = a.scale_den * b.scale_num
    result
}

// Check if two dimensions are compatible (same exponents, scale may differ)
pub fn unit_dim_compatible(a: UnitDim, b: UnitDim) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 7 {
        if a.exponents[i as usize] != b.exponents[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Find a registry slot whose dimension AND scale match, so a derived
// dimension produced by multiplication or division can be named by an
// existing entry instead of allocating a new one on every operation.
//
// unit_dim_compatible compares only the seven exponents; two entries can
// share a dimension and differ in scale (mg, g and kg are all mass^1), and
// for the purpose of branding a result they are NOT interchangeable. Hence
// the explicit scale comparison here.
pub fn unit_registry_find_dim(reg: UnitRegistry, d: UnitDim) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < reg.count {
        let e = reg.entries[i as usize].dim
        if unit_dim_compatible(e, d) && e.scale_num == d.scale_num && e.scale_den == d.scale_den {
            return i
        }
        i = i + 1
    }
    -1
}

// Brand a derived dimension: reuse an existing slot when one matches, and
// otherwise append an anonymous entry so that `mg * mg` can be typed as
// mass^2 rather than silently collapsing to "no unit", which in this
// representation is indistinguishable from dimensionless.
//
// The registry is fixed at 32 entries. When it is full the result is
// returned unbranded, which is a REPRESENTATIONAL limit and is not a claim
// that the quantity is dimensionless -- the honest fix is a TypeEntry that
// carries a UnitDim rather than an index into a bounded table.
pub fn unit_registry_intern_dim(reg: UnitRegistry, d: UnitDim) -> (UnitRegistry, i64) with Mut, Panic, Div {
    let existing = unit_registry_find_dim(reg, d)
    if existing >= 0 {
        return (reg, existing)
    }
    if reg.count >= 32 {
        return (reg, 0 - 1)
    }
    var r = reg
    let idx = r.count
    r = r.register(Name { buf: [0; 384], len: 0 }, d)
    (r, idx)
}

// Check if dimension is dimensionless
pub fn unit_dim_is_dimensionless(d: UnitDim) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 7 {
        if d.exponents[i as usize] != 0 {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// Named unit registry
// ============================================================

pub struct UnitEntry {
    pub name: Name,
    pub dim: UnitDim,
}

fn empty_unit_entry() -> UnitEntry {
    UnitEntry {
        name: Name { buf: [0; 384], len: 0 },
        dim: unit_dim_dimensionless(),
    }
}

// 128, not 32: register_builtin_units alone now claims 27 of a 32-entry table
// (5 free), and every `unit NAME [= conv];` declaration in the source under
// check, plus every anonymous derived-dimension a product/quotient/annotation
// needs a slot for, shares that same table. `register` silently drops the
// entry past capacity -- see UNIT_REGISTRY_OVERFLOW below for why a silent
// drop there is a correctness bug, not a usability one.
pub struct UnitRegistry {
    pub entries: [UnitEntry; 128],
    pub count: i64,
}

pub fn unit_registry_new() -> UnitRegistry {
    UnitRegistry {
        entries: [empty_unit_entry(); 128],
        count: 0,
    }
}

// Set when `register` refuses an entry because the table is full. A dropped
// unit does not vanish from the source -- checker_collect_unit_decl_inplace
// still lowers its annotation to ty_with_unit(ty_f64(), idx) using whatever
// idx .find() next returns for that name, which is -1 (unregistered) or, worse,
// a DIFFERENT unit's idx if the name happens to prefix-match nothing and the
// caller does not check for -1. Either way the compile proceeds with a unit
// identity nothing verified. Reported through the same fail-closed hook chain
// as the specializer and type-parameter-registry overflows (see
// spec_report_any_specializer_failure).
pub var UNIT_REGISTRY_OVERFLOW: bool = false

pub fn unit_report_registry_overflow() -> bool with IO {
    if !UNIT_REGISTRY_OVERFLOW { return false }
    print("error: unit registry capacity exceeded: a compilation supports at most 128 distinct units (builtin, user-declared and anonymous derived combined)\n")
    print("  note: compilation is refused because a dropped unit would leave its declared type unverified rather than absent\n")
    true
}

impl UnitRegistry {
    fn register(self, name: Name, dim: UnitDim) -> UnitRegistry with Mut, Panic, Div {
        var reg = self
        if reg.count < 128 {
            reg.entries[reg.count] = UnitEntry { name: name, dim: dim }
            reg.count = reg.count + 1
        } else {
            UNIT_REGISTRY_OVERFLOW = true
        }
        reg
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get_dim(self, idx: i64) -> UnitDim with Panic, Div {
        self.entries[idx].dim
    }

    // Find a registered unit whose dimension vector matches `dim` (scale ignored).
    // Used when a quotient/product or bare `mol/cm3` annotation must reattach a
    // named unit_id for call-boundary checks.
    fn find_by_dim(self, dim: UnitDim) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if unit_dim_compatible(self.entries[i].dim, dim) {
                return i
            }
            i = i + 1
        }
        -1
    }
}

// ============================================================
// Builtin unit definitions
// ============================================================

fn unit_dim_with_scale(base: UnitDim, num: i64, den: i64) -> UnitDim {
    UnitDim {
        exponents: base.exponents,
        scale_num: num,
        scale_den: den,
    }
}

pub fn register_builtin_units(reg: UnitRegistry) -> UnitRegistry with Mut, Panic, Div {
    var r = reg

    // Mass units (base: g)
    r = r.register(name_from_str2(109, 103), unit_dim_with_scale(unit_dim_mass(), 1, 1000))    // "mg" = 1/1000 g
    r = r.register(name_from_str1(103), unit_dim_mass())                                       // "g"  = 1 g
    r = r.register(name_from_str2(107, 103), unit_dim_with_scale(unit_dim_mass(), 1000, 1))    // "kg" = 1000 g

    // Length units (base: m)
    r = r.register(name_from_str1(109), unit_dim_length())                                     // "m"  = 1 m
    r = r.register(name_from_str2(107, 109), unit_dim_with_scale(unit_dim_length(), 1000, 1))  // "km" = 1000 m
    r = r.register(name_from_str2(99, 109), unit_dim_with_scale(unit_dim_length(), 1, 100))    // "cm" = 1/100 m
    r = r.register(name_from_str2(109, 109), unit_dim_with_scale(unit_dim_length(), 1, 1000))  // "mm" = 1/1000 m

    // Time units (base: s)
    r = r.register(name_from_str1(115), unit_dim_time())                                       // "s"   = 1 s
    r = r.register(name_from_str2(109, 115), unit_dim_with_scale(unit_dim_time(), 1, 1000))    // "ms"  = 1/1000 s
    r = r.register(name_from_str3(109, 105, 110), unit_dim_with_scale(unit_dim_time(), 60, 1)) // "min" = 60 s
    r = r.register(name_from_str1(104), unit_dim_with_scale(unit_dim_time(), 3600, 1))         // "h"   = 3600 s

    // Temperature
    r = r.register(name_from_str1(75), unit_dim_temperature())         // "K"

    // Amount (moles)
    r = r.register(name_from_str3(109, 111, 108), unit_dim_amount())   // "mol"
    // Volume / energy aliases used by chemistry fixtures (mol/cm3, cal/mol).
    r = r.register(name_from_str3(99, 109, 51), UnitDim {
        exponents: [0, 3, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1000000,
    }) // "cm3"
    r = r.register(name_from_str3(99, 97, 108), UnitDim {
        exponents: [1, 2, 0 - 2, 0, 0, 0, 0],
        scale_num: 4184,
        scale_den: 1000,
    }) // "cal"

    // Internal validation-data labels mirrored from the current-source unit table.
    // These are dimensional labels only, not clinical or terminology authority.
    r = r.register(name_from_str5(109, 103, 95, 100, 76), unit_dim_mass_concentration())        // "mg_dL"
    r = r.register(name_from_str6(109, 109, 111, 108, 95, 76), unit_dim_amount_concentration()) // "mmol_L"
    r = r.register(name_from_str3(85, 95, 76), unit_dim_activity_concentration())               // "U_L"
    r = r.register(name_from_str4(109, 109, 95, 104), unit_dim_length_per_time())               // "mm_h"

    // Volume -- concentration is built on it.
    r = r.register(name_from_str1(76), unit_dim_with_scale(unit_dim_volume(), 1, 1000))          // "L"
    r = r.register(name_from_str2(109, 76), unit_dim_with_scale(unit_dim_volume(), 1, 1000000))  // "mL"
    r = r.register(name_from_str2(100, 76), unit_dim_with_scale(unit_dim_volume(), 1, 10000))    // "dL"

    // Volume. Without these there is no concentration: the amount-per-volume
    // units below are unusable, and a volume annotation degraded to an opaque
    // nominal type (which is how tests/compile-fail/unit_mismatch_call_arg.sio
    // reported "expected mL, found f64" instead of a unit mismatch).

    // Chemistry: amount concentration, energy, pressure.
    r = r.register(name_from_str5(109, 111, 108, 95, 76), unit_dim_with_scale(unit_dim_amount_concentration(), 1000, 1)) // "mol_L"
    // unit_dim_energy/unit_dim_pressure both carry a MASS exponent, and this
    // registry's mass base is grams (g scale=1, kg scale=1000 -- "Mass units
    // (base: g)" above). Their natural (scale=1) combination is therefore
    // g*m^2/s^2 and g/(m*s^2) -- a milliJoule and a milliPascal, not a Joule
    // and a Pascal. Every scale below is the g-relative one, ×1000 of what a
    // kg-based derivation would read: J and Pa now, kJ and atm carry that same
    // ×1000 through their own multiplier.
    r = r.register(name_from_str1(74), unit_dim_with_scale(unit_dim_energy(), 1000, 1))          // "J" = 1000 (g*m^2/s^2)
    r = r.register(name_from_str2(107, 74), unit_dim_with_scale(unit_dim_energy(), 1000000, 1))  // "kJ" = 1e6 (g*m^2/s^2)
    r = r.register(name_from_str2(80, 97), unit_dim_with_scale(unit_dim_pressure(), 1000, 1))    // "Pa" = 1000 (g/(m*s^2))
    r = r.register(name_from_str3(97, 116, 109), unit_dim_with_scale(unit_dim_pressure(), 101325000, 1)) // "atm" = 101325000 (g/(m*s^2))

    r
}

// ============================================================
// Name construction helpers (for builtin registration)
// ============================================================

fn name_from_str1(a: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 1 }
    n.buf[0] = a as i8
    n
}

fn name_from_str2(a: i64, b: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 2 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n
}

fn name_from_str3(a: i64, b: i64, c: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 3 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n.buf[2] = c as i8
    n
}

fn name_from_str4(a: i64, b: i64, c: i64, d: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 4 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n.buf[2] = c as i8
    n.buf[3] = d as i8
    n
}

fn name_from_str5(a: i64, b: i64, c: i64, d: i64, e: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 5 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n.buf[2] = c as i8
    n.buf[3] = d as i8
    n.buf[4] = e as i8
    n
}

fn name_from_str6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 6 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n.buf[2] = c as i8
    n.buf[3] = d as i8
    n.buf[4] = e as i8
    n.buf[5] = f as i8
    n
}

// ============================================================
// Unit error printing
// ============================================================

pub fn print_unit_dim(d: UnitDim) with IO, Mut, Panic, Div {
    var first = true
    if d.exponents[0] != 0 { print("mass^"); print_int(d.exponents[0]); first = false }
    if d.exponents[1] != 0 { if !first { print("*") }; print("length^"); print_int(d.exponents[1]); first = false }
    if d.exponents[2] != 0 { if !first { print("*") }; print("time^"); print_int(d.exponents[2]); first = false }
    if d.exponents[3] != 0 { if !first { print("*") }; print("temp^"); print_int(d.exponents[3]); first = false }
    if d.exponents[4] != 0 { if !first { print("*") }; print("amount^"); print_int(d.exponents[4]); first = false }
    if d.exponents[5] != 0 { if !first { print("*") }; print("current^"); print_int(d.exponents[5]); first = false }
    if d.exponents[6] != 0 { if !first { print("*") }; print("luminosity^"); print_int(d.exponents[6]); first = false }
    if first { print("dimensionless") }
}

// The builtin unit names, for code outside the checker that must agree with it on
// which type names are units. The IR lowering needs exactly this: the checker types
// a registered unit name as f64 carrying that unit (checker_lower_named_type_mut),
// and lower_type_expr_is_f64 in ir/lower.sio has to classify the same names as
// float, or a `-> mg` call result is read back as the integer bit pattern of the
// double. Built from register_builtin_units itself so the two lists cannot drift.
pub fn builtin_unit_count() -> i64 with Mut, Panic, Div {
    let reg = register_builtin_units(unit_registry_new())
    reg.count
}

pub fn builtin_unit_name_at(i: i64) -> Name with Mut, Panic, Div {
    let reg = register_builtin_units(unit_registry_new())
    reg.entries[i].name
}
