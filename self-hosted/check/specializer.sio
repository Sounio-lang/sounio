// AST-level generic-fn specializer (monomorphizer).
//
// Runs AFTER parsing, BEFORE type checking. A fn is generic when it declares
// type parameters (`fn f<T, U>`, FnDef.type_params); up to 4 are specialized.
//
// Algorithm:
//   1. Collect every top-level ItemFn that declares type parameters into a
//      table; collect generic struct templates (StructDef.type_params).
//   2. READ-ONLY scan of all non-generic fn and impl-method bodies for Call
//      exprs carrying turbofish type_args whose callee matches a collected
//      generic fn AND whose arg count matches its parameter count. Count
//      mismatches leave the call site untouched and pin the template so the
//      checker's own E010 still fires; so does a call without type args.
//   3. Every distinct instantiation: clone + substitute the FnDef and scan the
//      clone's body (transitive turbofish calls, incl. self-recursion; the
//      instance is reserved first, so this terminates). Instance identity is
//      the template slot plus the COMPLETE canonical argument key
//      (spec_fn_key: every source name length-prefixed, every constructor
//      tagged, every argument list delimited), compared exactly -- never a
//      hash of the emitted symbol. An argument with no canonical key (an
//      unsupported or overlong type) refuses the program instead of guessing.
//   4. Naming (spec_assign_instance_names): a template with exactly one
//      instantiation and no call that still needs it keeps the same-name
//      scheme -- its clone replaces it and no call site changes. Otherwise
//      every instantiation is emitted under the symbol `__sp_<key>` and the
//      calls it serves are rewritten to that name. Because the key is
//      injective, underscores or marker spellings in source identifiers
//      cannot alias two instances; a symbol that collides with a source item
//      is refused (capacity code 7).
//   5. Finalize: replace each same-name template item with its clone; keep
//      still-referenced templates verbatim; drop the rest. Generic-struct instances
//      (CDExact<i64> -> struct CDExact__i64 items) referenced from clone
//      signatures/bodies are appended, with type annotations and struct
//      literals inside clones rewritten to the mangled concrete names
//      (the checker's signature lowering erases generic struct args, and
//      its literal inference is TyNamed-only, so only concrete names
//      survive both).
//   5. Generic IMPL blocks (`impl S<T>` / `impl<T> S<T>` on a generic struct
//      template) are not same-name generic methods: the receiver binds T.
//      Each emitted struct instance S__args gets a clone `impl S__args` with
//      every method substituted, placed at the FRONT of the item list so it
//      precedes every caller (the template is dropped). Non-generic bodies that name S<args> in a
//      type or a `S::<args>::f(..)` path are rewritten to S__args, so the
//      checker's `Type::method` lookup and lowering's `Type_method` mangle
//      both land on the clone, and S<i64> and S<f64> coexist in one unit.
//
// Backend-safety notes (this file runs inside the lean_single-compiled
// Madaros binary, so it must stay inside the proven-safe subset):
//   - No Name/struct-typed GLOBAL arrays: global aggregate array elements
//     read back corrupted (witnessed on this exact pass).
//   - No Option<Box<...>> globals either: a global Option<Box<Node>> does
//     not round-trip (store-then-load returns garbage; witnessed with a
//     standalone probe). The ONLY safe global state is flat i64/bool
//     arrays + scalars (check/mod.sio sidecar precedent).
//   - Heap state therefore lives behind raw pointers from heap_alloc,
//     accessed via *mut field reads/writes and parked in i64 globals —
//     the check/mod.sio *mut-Checker-spine pattern (probe-validated for
//     both scalar and big-aggregate fields, including Option<Box<T>>
//     fields THROUGH the *mut node).
//   - Type-param and dedup lookups compare ast_name_hash i64 values, the
//     module_frontend hash-table pattern.

module check::specializer

use parser::ast::*
use parser::parser::{dummy_type_expr, mk_expr}
use io::env::{read_env}
use check::units::{unit_report_registry_overflow}

// ============================================================
// Small fixed-capacity LOCAL helper structs (never stored in globals)
// ============================================================

struct SpecKnownNames { names: [Name; 32], count: i64 }
struct SpecNameBuf { names: [Name; 4], count: i64 }

// ============================================================
// Generic-fn table: heap_alloc'd all-scalar nodes reached through raw
// pointers parked in a flat i64 global array (*mut spine pattern).
// ============================================================

struct SpecGfNode {
    name_hash: i64,
    tp_count: i64,
    tp_h0: i64,
    tp_h1: i64,
    tp_h2: i64,
    tp_h3: i64,
    fd: Option<Box<FnDef>>,
}

// Generic STRUCT template node (StructDef carries real type_params, so no
// heuristic recovery is needed for structs).
struct SpecStNode {
    name_hash: i64,
    tp_count: i64,
    tp_h0: i64,
    tp_h1: i64,
    tp_h2: i64,
    tp_h3: i64,
    sd: Option<Box<StructDef>>,
}

// Substitution context: the ACTIVE type-param set during one clone's
// substitution (either a generic fn's recovered params or a generic
// struct's declared params). Reached via raw pointer like the table nodes.
struct SpecCtxNode {
    tp_count: i64,
    h0: i64,
    h1: i64,
    h2: i64,
    h3: i64,
}

// Chain node for freshly instantiated items (Item stored inline in the
// heap node; `next` is a raw pointer, 0 = end of chain).
struct SpecItemNode {
    it: Item,
    next: i64,
}

// Staging wrappers: WHOLE-struct stores through *mut ((*q) = v) are
// miscompiled (probe-witnessed: destination stays zeroed), while FIELD
// stores through *mut ((*q).e = v) work. All big AST values are therefore
// staged inside single-field wrapper nodes.
struct SpecExprStage { e: Expr }
struct SpecStmtStage { s: Stmt }
struct SpecFnDefStage { fd: FnDef }
struct SpecStructDefStage { sd: StructDef }
struct SpecImplDefStage { id: ImplDef }
struct SpecNameStage { n: Name }
struct SpecItemsStage { items: Option<Box<ItemList>> }
struct SpecTypeStage { t: TypeExpr }
struct SpecBindStage { slots: [i64; 4] }

// Generic IMPL template node: `impl S<A, ..>` whose header args are all type
// params of struct template slot st_idx, hashed in header order (= the
// struct's param order, which is also the instance's type-arg order).
struct SpecGiNode {
    st_idx: i64,
    tp_count: i64,
    h0: i64,
    h1: i64,
    h2: i64,
    h3: i64,
    id: Option<Box<ImplDef>>,
}

// Chain node for one `impl S__args` clone; `scanned` marks clones whose method
// bodies were already walked for transitive turbofish instantiations. `ctx` is the
// clone's scan/rename context (100000 + creation order): clones of one impl share
// the template's call spans, so inferred and renamed calls are keyed by it.
struct SpecGiCloneNode {
    it: Item,
    next: i64,
    scanned: bool,
    ctx: i64,
}

// Mutable driver state. Reset unconditionally at the top of every
// specialize_generics() call — this pass may run more than once per
// process (preflight + IR-lowering both invoke it on independently
// re-parsed item lists), so no state may leak across invocations.
var SPEC_GF_COUNT: i64 = 0
var SPEC_GF_PTRS: [i64; 256] = [0; 256]
var SPEC_GF_NEEDED: [bool; 256] = [false; 256]
// How many distinct instantiations each template slot has (SPEC_FI_* entries).
var SPEC_GF_INST_COUNT: [i64; 256] = [0; 256]
// Slots registered from impl methods (`fn pick<T>(self: &S, ...)`): their clones are
// emitted inside the impl (spec_finalize_method_items), never as top-level fns.
var SPEC_GF_IS_METHOD: [bool; 256] = [false; 256]
// Every distinct instantiation, in creation order: its template slot, the
// *mut SpecNameStage holding its canonical argument key (spec_fn_key; identity is
// compared exactly, never by hash), the *mut SpecFnDefStage holding the substituted
// clone, the *mut SpecNameStage holding the symbol `__sp_<key>`, and whether it is
// emitted under that symbol -- decided only after the whole scan
// (spec_assign_instance_names).
var SPEC_FI_COUNT: i64 = 0
var SPEC_FI_GT: [i64; 1024] = [0; 1024]
var SPEC_FI_KEYNAME: [i64; 1024] = [0; 1024]
var SPEC_FI_STAGE: [i64; 1024] = [0; 1024]
var SPEC_FI_NAME: [i64; 1024] = [0; 1024]
var SPEC_FI_MANGLED: [bool; 1024] = [false; 1024]
var SPEC_ANY_MANGLED: i64 = 0
// *mut SpecItemsStage over the ORIGINAL item list, set by specialize_generics; a
// generated `__sp_<key>` symbol is checked against it (capacity code 7).
var SPEC_SOURCE_ITEMS: i64 = 0
// Type-argument inference state (spec_infer_call_targs). Local-type scope: name
// hash -> *mut SpecTypeStage, searched from the top. Declared return types of
// non-generic fns. Inferred call sites: (span, the instance whose clone body the call
// sits in or -1, the instance it was specialized to), so the renaming pass can find a
// call that carries no type arguments of its own.
var SPEC_SC_TOP: i64 = 0
var SPEC_SC_HASH: [i64; 4096] = [0; 4096]
var SPEC_SC_TYPE: [i64; 4096] = [0; 4096]
// Hash-only local names collide (`az`/`bY` -- same ast_name_hash), and this
// stack is the generic-call inference scope: looking up the wrong one of two
// colliding locals selects the wrong type for a generic call's inferred
// argument. *mut SpecNameStage per entry, same as SPEC_EMITTED_NAMES: a Name
// held across deep calls arrives corrupted, so it is staged to the heap
// before anything else touches it.
var SPEC_SC_NAMES: [i64; 4096] = [0; 4096]
var SPEC_RT_COUNT: i64 = 0
var SPEC_RT_HASH: [i64; 4096] = [0; 4096]
var SPEC_RT_TYPE: [i64; 4096] = [0; 4096]
// Same hash-as-identity gap as SPEC_SC_NAMES / SPEC_EMITTED_NAMES: two
// functions with colliding names (the az/bY pair used elsewhere in this
// file collides) made a nested generic call infer the WRONG function's
// return type and instantiate the wrong clone. *mut SpecNameStage per
// entry, same reason -- a Name held across deep calls arrives corrupted.
var SPEC_RT_NAMES: [i64; 4096] = [0; 4096]
var SPEC_CS_COUNT: i64 = 0
var SPEC_CS_FILE: [i64; 4096] = [0; 4096]
var SPEC_CS_START: [i64; 4096] = [0; 4096]
var SPEC_CS_END: [i64; 4096] = [0; 4096]
var SPEC_CS_CTX: [i64; 4096] = [0; 4096]
var SPEC_CS_FI: [i64; 4096] = [0; 4096]
var SPEC_SCAN_CTX: i64 = 0
var SPEC_RENAME_CTX: i64 = 0
// Set when an instantiation cannot be named injectively (a type argument with no
// canonical key: unsupported or overlong). Every representable distinct
// instantiation gets its own clone (spec_ensure_instance), so no template is
// poisoned back to its unspecialized body; this fails the compile closed instead
// (spec_report_unsound_poison).
// See docs/handoff/BLK-20260903-specializer-nested-targ-collision.md.
var SPEC_UNSOUND_POISON: bool = false
// Fail-closed state for formerly silent fixed-capacity truncation.
// Codes: 1=>4 type params, 2=>256 generic fns, 3=>256 generic structs,
// 4=>1024 emitted specialization hashes, 5=>1024 generic fn instantiations,
// 6=>64 generic impl blocks, 7=>a `__sp_<key>` symbol collides with a source item.
var SPEC_CAP_OVERFLOW: bool = false
var SPEC_CAP_OVERFLOW_CODE: i64 = 0
// Generic methods require an explicit, unambiguous turbofish so the
// specializer can choose the same-name clone before IR lowering.
var SPEC_METHOD_TARG_UNSUPPORTED: bool = false
var SPEC_ST_COUNT: i64 = 0
var SPEC_ST_PTRS: [i64; 256] = [0; 256]
// Emitted struct-instance names. The hash only nominates a candidate; the *mut
// SpecNameStage kept beside it decides (two valid names can share a hash: the
// suffixes `B0` and `AQ` give `Cell__B0` and `Cell__AQ` the same DJB2 value).
var SPEC_EMITTED_HASHES: [i64; 1024] = [0; 1024]
var SPEC_EMITTED_NAMES: [i64; 1024] = [0; 1024]
var SPEC_EMITTED_COUNT: i64 = 0
var SPEC_EXTRA_HEAD: i64 = 0
// Generic impl templates and, per slot, the chain of their instance clones.
var SPEC_GI_COUNT: i64 = 0
var SPEC_GI_PTRS: [i64; 64] = [0; 64]
var SPEC_GI_CLONE_HEAD: [i64; 64] = [0; 64]
// Clones emitted so far, for each clone's scan/rename context (SpecGiCloneNode.ctx).
var SPEC_GI_CLONE_SEQ: i64 = 0
// Set by the read-only scan when a body names a generic-impl struct with
// type arguments, i.e. needs the rewrite pass.
var SPEC_RW_HIT: bool = false
// True while spec_rewrite_fn_item rewrites an ordinary (non-generic) fn: only a struct with
// a generic impl is replaced by its instance there. A struct without one (`Cell<T>` with only
// `impl Cell<f64>`) has no instance impl to reach, so naming its instance `Cell__f64` in one
// fn made the call `c.twice(..)` look for `Cell__f64_twice` while the concrete impl lowers as
// `Cell_twice`: the call hit a body-less stub and the program died with SIGILL. Measured
// (b5/b6 and c1 in the probe set): a `Cell<i64>` or `Cell<f64>` with a concrete impl beside an
// instantiated `Pair<T, U>` compiled and crashed on the first method call. Generic fn clones
// keep rewriting every generic struct they name; their bodies are all that consumers see.
var SPEC_RW_GI_ONLY: bool = false
// `S::f(..)` on a generic-impl struct with no type arguments: no clone can be
// named, and the template impl is dropped, so the call would reach lowering
// as a body-less `S_f` (measured: compiled, then SIGILL on the ud2 stub).
var SPEC_GI_STATIC_TARG_MISSING: bool = false

fn spec_reset_state() with Mut {
    SPEC_EMITTED_COUNT = 0
    SPEC_EXTRA_HEAD = 0
    SPEC_GI_COUNT = 0
    SPEC_RW_HIT = false
    SPEC_RW_GI_ONLY = false
    SPEC_GI_STATIC_TARG_MISSING = false
    SPEC_GI_CLONE_SEQ = 0
    var g: i64 = 0
    while g < 64 {
        SPEC_GI_PTRS[g as usize] = 0
        SPEC_GI_CLONE_HEAD[g as usize] = 0
        g = g + 1
    }
    var i: i64 = 0
    while i < 256 {
        SPEC_GF_PTRS[i as usize] = 0
        SPEC_GF_NEEDED[i as usize] = false
        SPEC_GF_INST_COUNT[i as usize] = 0
        SPEC_GF_IS_METHOD[i as usize] = false
        SPEC_ST_PTRS[i as usize] = 0
        i = i + 1
    }
    var f: i64 = 0
    while f < 1024 {
        SPEC_FI_GT[f as usize] = 0
        SPEC_FI_KEYNAME[f as usize] = 0
        SPEC_FI_STAGE[f as usize] = 0
        SPEC_FI_NAME[f as usize] = 0
        SPEC_FI_MANGLED[f as usize] = false
        f = f + 1
    }
    SPEC_FI_COUNT = 0
    SPEC_ANY_MANGLED = 0
    SPEC_SOURCE_ITEMS = 0
    SPEC_SC_TOP = 0
    SPEC_RT_COUNT = 0
    SPEC_CS_COUNT = 0
    SPEC_SCAN_CTX = 0 - 1
    SPEC_RENAME_CTX = 0 - 1
    SPEC_GF_COUNT = 0
    SPEC_ST_COUNT = 0
    SPEC_UNSOUND_POISON = false
    SPEC_CAP_OVERFLOW = false
    SPEC_CAP_OVERFLOW_CODE = 0
    SPEC_METHOD_TARG_UNSUPPORTED = false
}

// True when this pass poisoned a template whose instantiations cannot survive
// unspecialized lowering. The caller must refuse to emit code: the alternative
// is a program that compiles and returns zeros.
pub fn spec_unsound_poison_detected() -> bool {
    SPEC_UNSOUND_POISON
}

// Report the refusal and return true when the caller must fail. Callers fold
// this into their existing verdict check, so the message only appears when the
// program would otherwise have been accepted.
pub fn spec_report_unsound_poison() -> bool with IO {
    if !SPEC_UNSOUND_POISON { return false }
    print("error: generic specialization cannot be represented safely\n")
    print("  note: a type argument has an unsupported or overlong identity, so the instantiation cannot be named without risking aliasing another one\n")
    print("  help: provide supported concrete type arguments, or use separate concrete functions\n")
    true
}

fn spec_mark_cap_overflow(code: i64) with Mut {
    SPEC_CAP_OVERFLOW = true
    if SPEC_CAP_OVERFLOW_CODE == 0 {
        SPEC_CAP_OVERFLOW_CODE = code
    }
}

pub fn spec_report_cap_overflow() -> bool with IO {
    if !SPEC_CAP_OVERFLOW { return false }
    print("error: specializer capacity exceeded: ")
    if SPEC_CAP_OVERFLOW_CODE == 1 {
        print("generic declarations support at most 4 type parameters")
    } else if SPEC_CAP_OVERFLOW_CODE == 2 {
        print("a compilation unit supports at most 256 generic functions or methods")
    } else if SPEC_CAP_OVERFLOW_CODE == 3 {
        print("a compilation unit supports at most 256 generic structs")
    } else if SPEC_CAP_OVERFLOW_CODE == 4 {
        print("a compilation unit supports at most 1024 emitted generic struct specializations")
    } else if SPEC_CAP_OVERFLOW_CODE == 5 {
        print("a compilation unit supports at most 1024 distinct generic function instantiations")
    } else if SPEC_CAP_OVERFLOW_CODE == 6 {
        print("a compilation unit supports at most 64 generic impl blocks")
    } else if SPEC_CAP_OVERFLOW_CODE == 7 {
        print("a generated specialization symbol collides with a source item")
    } else {
        print("an internal fixed-capacity specializer table was exhausted")
    }
    print("\n")
    print("  note: compilation is refused because silently truncating specialization would produce unspecialized or aliased code\n")
    true
}

pub fn spec_report_unsupported_method_generic() -> bool with IO {
    if !SPEC_METHOD_TARG_UNSUPPORTED { return false }
    print("error: generic method specialization requires one unambiguous explicit turbofish type-argument list\n")
    print("  help: call the method as receiver.method::<T>(...), and use a unique generic method name in this compilation unit\n")
    true
}

pub fn spec_report_generic_impl_static_targs() -> bool with IO {
    if !SPEC_GI_STATIC_TARG_MISSING { return false }
    print("error: an associated function of a generic struct must be called with explicit type arguments\n")
    print("  help: write Type::<T>::function(...); the impl is specialized per instance and a call without type arguments names none of them\n")
    true
}

// Report every specializer-side refusal. Call this before folding a typecheck
// verdict so short-circuit `||` on the checker result cannot hide these errors.
pub fn spec_report_any_specializer_failure() -> bool with IO {
    spec_report_unsound_poison() || spec_report_cap_overflow() || spec_report_unsupported_method_generic() || spec_report_generic_impl_static_targs() || ast_report_type_param_registry_overflow() || unit_report_registry_overflow()
}

// ============================================================
// Name / string helpers
// ============================================================

fn spec_name_to_string(name: Name) -> string with Mut, Panic, Div {
    var buf: [i8; 384] = name.buf
    str_from_bytes(buf, name.len)
}

fn spec_path_single_name(path: AstPath) -> Name {
    if path.seg_count != 1 { return empty_name() }
    Name { buf: path.segments.head_buf, len: path.segments.head_len }
}

// ============================================================
// Known type names (structs/enums declared in this item list)
// ============================================================

fn spec_known_names_has(kn: SpecKnownNames, n: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < kn.count {
        if name_eq(kn.names[i as usize], n) { return true }
        i = i + 1
    }
    false
}

fn spec_known_names_push(kn: SpecKnownNames, n: Name) -> SpecKnownNames with Mut, Panic, Div {
    var out = kn
    if out.count < 32 && !spec_known_names_has(out, n) {
        out.names[out.count as usize] = n
        out.count = out.count + 1
    }
    out
}

fn spec_collect_known_names(items: Option<Box<ItemList>>, acc: SpecKnownNames) -> SpecKnownNames with Mut, Panic, Div {
    match items {
        None => acc
        Some(list) => {
            var out = acc
            let it = (*list).head
            if it.kind == ItemKind::ItemStruct || it.kind == ItemKind::ItemEnum {
                out = spec_known_names_push(out, it.name)
            }
            spec_collect_known_names((*list).tail, out)
        }
    }
}

// ============================================================
// Free-type-variable detection
// ============================================================

// A candidate type parameter must be a single UPPERCASE letter (T, U, F, K,
// V, ...). The single-letter restriction keeps stdlib named types (Option,
// Box, ...) from being misread as free type variables; generic fns with
// multi-character param names simply stay on the baseline checker path.
fn spec_type_is_free_var(te: TypeExpr, known: SpecKnownNames) -> bool with Mut, Panic, Div {
    if te.kind != TypeExprKind::TypeNamed { return false }
    if te.path.seg_count != 1 { return false }
    let seg = spec_path_single_name(te.path)
    if seg.len != 1 { return false }
    let c0 = seg.buf[0] as i64
    if c0 < 65 || c0 > 90 { return false }
    if spec_known_names_has(known, seg) { return false }
    true
}

fn spec_name_buf_has(buf: SpecNameBuf, n: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.count {
        if name_eq(buf.names[i as usize], n) { return true }
        i = i + 1
    }
    false
}

fn spec_name_buf_push(buf: SpecNameBuf, n: Name) -> SpecNameBuf with Mut, Panic, Div {
    var out = buf
    if !spec_name_buf_has(out, n) {
        if out.count < 4 {
            out.names[out.count as usize] = n
            out.count = out.count + 1
        } else {
            spec_mark_cap_overflow(1)
        }
    }
    out
}

fn spec_collect_free_vars_from_type(te: TypeExpr, known: SpecKnownNames, buf: SpecNameBuf) -> SpecNameBuf with Mut, Panic, Div {
    var out = buf
    if spec_type_is_free_var(te, known) {
        out = spec_name_buf_push(out, spec_path_single_name(te.path))
    }
    match te.inner {
        Some(inner) => out = spec_collect_free_vars_from_type(*inner, known, out)
        None => {}
    }
    match te.type_args {
        Some(list) => out = spec_collect_free_vars_from_type_list(*list, known, out)
        None => {}
    }
    out
}

fn spec_collect_free_vars_from_type_list(list: TypeExprList, known: SpecKnownNames, buf: SpecNameBuf) -> SpecNameBuf with Mut, Panic, Div {
    let with_head = spec_collect_free_vars_from_type(list.head, known, buf)
    match list.tail {
        Some(rest) => spec_collect_free_vars_from_type_list(*rest, known, with_head)
        None => with_head
    }
}

fn spec_collect_free_vars_from_params(opt: Option<Box<ParamList>>, known: SpecKnownNames, buf: SpecNameBuf) -> SpecNameBuf with Mut, Panic, Div {
    match opt {
        None => buf
        Some(list) => {
            let with_head = spec_collect_free_vars_from_type((*list).head.ty, known, buf)
            spec_collect_free_vars_from_params((*list).tail, known, with_head)
        }
    }
}

// A fn's type parameters are the ones it DECLARES (`fn f<T, U>`). The parser
// used to drop that list, so this guessed them from the signature instead: any
// single uppercase letter that is not a struct or enum name. That registered
// `fn warm(t: K) -> K` (K the kelvin unit) as a generic template, and could
// never see a declared multi-letter parameter. More than 4 declared parameters
// does not fit the substitution context: the program is refused (capacity code
// 1) rather than compiled with the fn left unspecialized.
fn spec_collect_free_vars_from_fndef(fd: FnDef, known: SpecKnownNames) -> SpecNameBuf with Mut, Panic, Div {
    var buf = SpecNameBuf { names: [empty_name(); 4], count: 0 }
    if spec_struct_tp_count_of(fd.type_params) > 4 {
        spec_mark_cap_overflow(1)
        return buf
    }
    var cur = fd.type_params
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(node) => {
                buf = spec_name_buf_push(buf, (*node).head.name)
                cur = (*node).tail
            }
        }
    }
    buf
}

// ============================================================
// Generic-fn table operations (hash-keyed *mut arena)
// ============================================================

fn spec_generic_table_find(name: Name) -> i64 with Mut, Panic, Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < SPEC_GF_COUNT {
        let p = SPEC_GF_PTRS[i as usize] as *mut SpecGfNode
        if (*p).name_hash == h {
            // The hash only nominates a candidate: confirm the exact name, so two
            // different templates whose names hash alike never share a slot.
            match (*p).fd {
                Some(fd) => { if name_eq((*fd).name, name) { return i } }
                None => {}
            }
        }
        i = i + 1
    }
    0 - 1
}

fn spec_generic_table_tp_count(slot: i64) -> i64 with Mut, Panic, Div {
    if slot < 0 || slot >= SPEC_GF_COUNT { return 0 - 1 }
    let p = SPEC_GF_PTRS[slot as usize] as *mut SpecGfNode
    (*p).tp_count
}

// The template FnDef box for a slot (shared pointer, read-only use).
fn spec_generic_table_fd(slot: i64) -> Option<Box<FnDef>> with Mut, Panic, Div {
    if slot < 0 || slot >= SPEC_GF_COUNT { return None }
    let p = SPEC_GF_PTRS[slot as usize] as *mut SpecGfNode
    (*p).fd
}

fn spec_tp_hash_at(buf: SpecNameBuf, i: i64) -> i64 with Mut, Panic, Div {
    if i < buf.count && i < 4 {
        return ast_name_hash(buf.names[i as usize])
    }
    0 - 1
}

// ============================================================
// Substitution contexts
// ============================================================

fn spec_ctx_new(count: i64, h0: i64, h1: i64, h2: i64, h3: i64) -> i64 with Mut, Panic, Div, Alloc {
    let p = heap_alloc(256) as *mut SpecCtxNode
    (*p).tp_count = count
    (*p).h0 = h0
    (*p).h1 = h1
    (*p).h2 = h2
    (*p).h3 = h3
    p as i64
}

fn spec_ctx_tp_index(ctx: i64, h: i64) -> i64 with Mut, Panic, Div {
    if ctx == 0 { return 0 - 1 }
    let p = ctx as *mut SpecCtxNode
    if (*p).tp_count > 0 && (*p).h0 == h { return 0 }
    if (*p).tp_count > 1 && (*p).h1 == h { return 1 }
    if (*p).tp_count > 2 && (*p).h2 == h { return 2 }
    if (*p).tp_count > 3 && (*p).h3 == h { return 3 }
    0 - 1
}

fn spec_ctx_from_fn_slot(slot: i64) -> i64 with Mut, Panic, Div, Alloc {
    if slot < 0 || slot >= SPEC_GF_COUNT { return 0 }
    let p = SPEC_GF_PTRS[slot as usize] as *mut SpecGfNode
    spec_ctx_new((*p).tp_count, (*p).tp_h0, (*p).tp_h1, (*p).tp_h2, (*p).tp_h3)
}

fn spec_ctx_from_struct_slot(slot: i64) -> i64 with Mut, Panic, Div, Alloc {
    if slot < 0 || slot >= SPEC_ST_COUNT { return 0 }
    let p = SPEC_ST_PTRS[slot as usize] as *mut SpecStNode
    spec_ctx_new((*p).tp_count, (*p).tp_h0, (*p).tp_h1, (*p).tp_h2, (*p).tp_h3)
}

// ============================================================
// Generic-struct template table (*mut arena)
// ============================================================

fn spec_struct_table_find(name: Name) -> i64 with Mut, Panic, Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < SPEC_ST_COUNT {
        let p = SPEC_ST_PTRS[i as usize] as *mut SpecStNode
        if (*p).name_hash == h {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn spec_struct_table_tp_count(slot: i64) -> i64 with Mut, Panic, Div {
    if slot < 0 || slot >= SPEC_ST_COUNT { return 0 - 1 }
    let p = SPEC_ST_PTRS[slot as usize] as *mut SpecStNode
    (*p).tp_count
}

fn spec_struct_table_tp_hash(slot: i64, k: i64) -> i64 with Mut, Panic, Div {
    if slot < 0 || slot >= SPEC_ST_COUNT { return 0 - 1 }
    let p = SPEC_ST_PTRS[slot as usize] as *mut SpecStNode
    if k == 0 { return (*p).tp_h0 }
    if k == 1 { return (*p).tp_h1 }
    if k == 2 { return (*p).tp_h2 }
    if k == 3 { return (*p).tp_h3 }
    0 - 1
}

fn spec_struct_table_sd(slot: i64) -> Option<Box<StructDef>> with Mut, Panic, Div {
    if slot < 0 || slot >= SPEC_ST_COUNT { return None }
    let p = SPEC_ST_PTRS[slot as usize] as *mut SpecStNode
    (*p).sd
}

fn spec_struct_tp_count_of(opt: Option<Box<TypeParamDefList>>) -> i64 with Mut, Panic, Div {
    match opt {
        None => 0
        Some(list) => 1 + spec_struct_tp_count_of((*list).tail)
    }
}

fn spec_struct_tp_hash_of(opt: Option<Box<TypeParamDefList>>, n: i64) -> i64 with Mut, Panic, Div {
    match opt {
        None => 0 - 1
        Some(list) => {
            if n <= 0 {
                ast_name_hash((*list).head.name)
            } else {
                spec_struct_tp_hash_of((*list).tail, n - 1)
            }
        }
    }
}

fn spec_collect_generic_structs(items: Option<Box<ItemList>>) with Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemStruct {
                match it.struct_def {
                    Some(sd_box) => {
                        let tp_count = spec_struct_tp_count_of((*sd_box).type_params)
                        if tp_count > 4 {
                            spec_mark_cap_overflow(1)
                        } else if tp_count > 0 && spec_struct_table_find(it.name) < 0 {
                            if SPEC_ST_COUNT >= 256 {
                                spec_mark_cap_overflow(3)
                            } else {
                                let slot = SPEC_ST_COUNT
                                let p = heap_alloc(4096) as *mut SpecStNode
                                (*p).name_hash = ast_name_hash(it.name)
                                (*p).tp_count = tp_count
                                (*p).tp_h0 = spec_struct_tp_hash_of((*sd_box).type_params, 0)
                                (*p).tp_h1 = spec_struct_tp_hash_of((*sd_box).type_params, 1)
                                (*p).tp_h2 = spec_struct_tp_hash_of((*sd_box).type_params, 2)
                                (*p).tp_h3 = spec_struct_tp_hash_of((*sd_box).type_params, 3)
                                (*p).sd = it.struct_def
                                SPEC_ST_PTRS[slot as usize] = p as i64
                                SPEC_ST_COUNT = SPEC_ST_COUNT + 1
                            }
                        }
                    }
                    None => {}
                }
            }
            spec_collect_generic_structs((*list).tail)
        }
    }
}

fn spec_collect_generic_fns(items: Option<Box<ItemList>>, known: SpecKnownNames) with IO, Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemFn {
                match it.fn_def {
                    Some(fd_box) => {
                        let tp = spec_collect_free_vars_from_fndef((*fd_box), known)
                        if tp.count > 0 && spec_generic_table_find(it.name) < 0 {
                            if SPEC_GF_COUNT >= 256 {
                                spec_mark_cap_overflow(2)
                            } else {
                                let slot = SPEC_GF_COUNT
                                let p = heap_alloc(4096) as *mut SpecGfNode
                                (*p).name_hash = ast_name_hash(it.name)
                                (*p).tp_count = tp.count
                                (*p).tp_h0 = spec_tp_hash_at(tp, 0)
                                (*p).tp_h1 = spec_tp_hash_at(tp, 1)
                                (*p).tp_h2 = spec_tp_hash_at(tp, 2)
                                (*p).tp_h3 = spec_tp_hash_at(tp, 3)
                                (*p).fd = it.fn_def
                                SPEC_GF_PTRS[slot as usize] = p as i64
                                SPEC_GF_NEEDED[slot as usize] = false
                                SPEC_GF_COUNT = SPEC_GF_COUNT + 1
                                if spec_trace_enabled() {
                                    print("specializer: registered=")
                                    print(spec_name_to_string(it.name))
                                    print(" slot=")
                                    print_int(spec_generic_table_find(it.name))
                                    print(" tp=")
                                    print_int(spec_generic_table_tp_count(slot))
                                    print("\n")
                                }
                            }
                        }
                    }
                    None => {}
                }
            }
            spec_collect_generic_fns((*list).tail, known)
        }
    }
}

fn spec_collect_generic_method_items(methods: Option<Box<ItemList>>, known: SpecKnownNames) with IO, Mut, Panic, Div, Alloc {
    match methods {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemFn {
                match it.fn_def {
                    Some(fd_box) => {
                        let tp = spec_collect_free_vars_from_fndef((*fd_box), known)
                        if tp.count > 0 {
                            if spec_generic_table_find(it.name) >= 0 {
                                // Receiver types are unavailable to this AST-only
                                // pass. Two same-named generic methods cannot be
                                // selected safely from ExprMethodCall alone.
                                SPEC_METHOD_TARG_UNSUPPORTED = true
                            } else if SPEC_GF_COUNT >= 256 {
                                spec_mark_cap_overflow(2)
                            } else {
                                let slot = SPEC_GF_COUNT
                                let p = heap_alloc(4096) as *mut SpecGfNode
                                (*p).name_hash = ast_name_hash(it.name)
                                (*p).tp_count = tp.count
                                (*p).tp_h0 = spec_tp_hash_at(tp, 0)
                                (*p).tp_h1 = spec_tp_hash_at(tp, 1)
                                (*p).tp_h2 = spec_tp_hash_at(tp, 2)
                                (*p).tp_h3 = spec_tp_hash_at(tp, 3)
                                (*p).fd = it.fn_def
                                SPEC_GF_PTRS[slot as usize] = p as i64
                                SPEC_GF_NEEDED[slot as usize] = false
                                SPEC_GF_IS_METHOD[slot as usize] = true
                                SPEC_GF_COUNT = SPEC_GF_COUNT + 1
                            }
                        }
                    }
                    None => {}
                }
            }
            spec_collect_generic_method_items((*list).tail, known)
        }
    }
}

// Does any method in this list declare its own type parameters?
fn spec_methods_declare_type_params(methods: Option<Box<ItemList>>) -> bool with Mut, Panic, Div {
    var cur = methods
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                match (*list).head.fn_def {
                    Some(fd_box) => {
                        match (*fd_box).type_params {
                            Some(_tps) => { return true }
                            None => {}
                        }
                    }
                    None => {}
                }
                cur = (*list).tail
            }
        }
    }
    false
}

// Needs the struct table: spec_collect_generic_structs runs first.
fn spec_collect_generic_methods(items: Option<Box<ItemList>>, known: SpecKnownNames) with IO, Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemImpl {
                match it.impl_def {
                    Some(id) => {
                        if spec_impl_generic_struct_slot((*id)) >= 0 {
                            // Methods of a generic impl are bound by the receiver's type
                            // args and cloned per struct instance
                            // (spec_emit_generic_impl_instances). A method in it that also
                            // declares type parameters would need both substitutions, so it
                            // is refused rather than half done.
                            if spec_methods_declare_type_params((*id).methods) {
                                SPEC_METHOD_TARG_UNSUPPORTED = true
                            }
                        } else {
                            spec_collect_generic_method_items((*id).methods, known)
                        }
                    }
                    None => {}
                }
            }
            spec_collect_generic_methods((*list).tail, known)
        }
    }
}

// ============================================================
// Turbofish type-arg list helpers (work on the parsed list in place;
// no array-of-TypeExpr copies)
// ============================================================

fn spec_type_args_count(opt: Option<Box<TypeExprList>>) -> i64 with Mut, Panic, Div {
    match opt {
        None => 0
        Some(list) => 1 + spec_type_args_count((*list).tail)
    }
}

fn spec_type_args_nth(opt: Option<Box<TypeExprList>>, n: i64) -> TypeExpr with Mut, Panic, Div, Alloc {
    match opt {
        None => dummy_type_expr()
        Some(list) => {
            if n <= 0 {
                (*list).head
            } else {
                spec_type_args_nth((*list).tail, n - 1)
            }
        }
    }
}

// Render a type argument as a mangle fragment.
//
// Returns "" for any shape this scheme cannot render *injectively*; every
// caller treats "" as "cannot mangle" and falls back to unspecialized
// behaviour. Rendering a shape we cannot distinguish is not an option.
//
// What this replaces: the previous version returned the head name of any
// single-segment named type and DROPPED its type arguments, falling back to
// the literal "T" for everything else. So `pick::<Cell<i64>>` and
// `pick::<Cell<f64>>` both mangled to `pick__Cell`, hashed equal, and the
// second instantiation silently reused the first one's clone — and
// `Cell<Cell<i64>>` / `Cell<Cell<f64>>` both emitted one struct named
// `Cell__Cell`. Witnessed on Madaros v0.80.0.
//
// Nesting is encoded with `_Lb_` / `_Rb_` / `_Cm_` so the result stays in
// [A-Za-z0-9_] for the backend. Residual: a source identifier that literally
// contains one of those markers could still alias. That is a far narrower
// surface than the previous collapse-everything-to-T behaviour, and it is
// documented in docs/compiler/KNOWN_LIMITATIONS.md rather than hidden.
fn spec_render_type_string(te: TypeExpr) -> string with Mut, Panic, Div, Alloc {
    if te.kind == TypeExprKind::TypeUnit {
        return "Unit"
    }
    if te.kind == TypeExprKind::TypeReference {
        match te.inner {
            None => { return "" }
            Some(b) => {
                let s = spec_render_type_string(*b)
                if str_len(s) == 0 { return "" }
                return str_concat("Ref_", s)
            }
        }
    }
    if te.kind == TypeExprKind::TypeRefMut {
        match te.inner {
            None => { return "" }
            Some(b) => {
                let s = spec_render_type_string(*b)
                if str_len(s) == 0 { return "" }
                return str_concat("RefMut_", s)
            }
        }
    }
    if te.kind != TypeExprKind::TypeNamed {
        // Tuples, fn types, arrays (whose size lives in an Expr we cannot
        // render), Knowledge/refinement types and the ZD wrappers: no
        // injective spelling here.
        return ""
    }
    if te.path.seg_count != 1 {
        // Qualified paths would need a segment walk and a separator that
        // cannot alias `_`; not attempted.
        return ""
    }

    var s = spec_name_to_string(spec_path_single_name(te.path))
    if str_len(s) == 0 { return "" }

    match te.type_args {
        None => { return s }
        Some(_args) => {
            var out = str_concat(s, "_Lb_")
            var cur = te.type_args
            var first = true
            var going = true
            while going {
                match cur {
                    None => { going = false }
                    Some(list) => {
                        let arg = spec_render_type_string((*list).head)
                        if str_len(arg) == 0 { return "" }
                        if first {
                            out = str_concat(out, arg)
                            first = false
                        } else {
                            out = str_concat(str_concat(out, "_Cm_"), arg)
                        }
                        cur = (*list).tail
                    }
                }
            }
            return str_concat(out, "_Rb_")
        }
    }
}

// Thin Name wrapper. `empty_name()` is the "unrenderable" sentinel.
fn spec_render_type_name(te: TypeExpr) -> Name with Mut, Panic, Div, Alloc {
    let s = spec_render_type_string(te)
    if str_len(s) == 0 { return empty_name() }
    make_name(s)
}

// Mangle `base` with its turbofish args. Returns `empty_name()` when the
// instantiation cannot be named injectively (unrenderable argument, or a
// name that would overrun Name.buf). Callers must check.
fn spec_mangle_name(base: Name, targs: Option<Box<TypeExprList>>) -> Name with Mut, Panic, Div, Alloc {
    var s = spec_name_to_string(base)
    if str_len(s) == 0 { return empty_name() }
    var cur = targs
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                let arg = spec_render_type_string((*list).head)
                if str_len(arg) == 0 { return empty_name() }
                s = str_concat(str_concat(s, "__"), arg)
                cur = (*list).tail
            }
        }
    }
    // Name.buf is [i8; 128] but make_name sets `len` from the *string*
    // length while copying only the first 128 bytes, so a longer string
    // yields a Name whose `len` runs past its own buffer and name_eq /
    // ast_name_hash then read out of bounds. Fail closed rather than
    // truncate: truncation would reintroduce the very collision this guard
    // exists to prevent. (Literal, not a module-level const — D6.)
    if str_len(s) > 120 { return empty_name() }
    make_name(s)
}

fn spec_name_is_empty(n: Name) -> bool {
    n.len == 0
}

// Is this type argument a primitive scalar?
//
// Scalars survive an unspecialized template body: lowering passes them in a
// register and the value arrives intact (measured: `pick::<i64>` + `pick::<f64>`
// in one unit prints 7 and 1.5 correctly even though the template is poisoned).
// Anything else — a struct, a generic instance, a reference — arrives as zero,
// because lowering has no generics concept and the handle is dropped. Measured
// on Madaros v0.80.0 with both `pick::<Cell<i64>>` / `pick::<Cell<f64>>` and
// `pick::<P>` / `pick::<Q>` for plain structs P and Q: both print zeros, on the
// committed binary as well as this one. The second shape is a pre-existing
// wrong-code path on the default engine, not a consequence of the mangling fix.
fn spec_type_arg_is_scalar(te: TypeExpr) -> bool with Mut, Panic, Div, Alloc {
    if te.kind != TypeExprKind::TypeNamed { return false }
    if te.path.seg_count != 1 { return false }
    match te.type_args {
        Some(_a) => { return false }
        None => {}
    }
    let n = spec_name_to_string(spec_path_single_name(te.path))
    if str_eq(n, "i8") { return true }
    if str_eq(n, "i16") { return true }
    if str_eq(n, "i32") { return true }
    if str_eq(n, "i64") { return true }
    if str_eq(n, "u8") { return true }
    if str_eq(n, "u16") { return true }
    if str_eq(n, "u32") { return true }
    if str_eq(n, "u64") { return true }
    if str_eq(n, "f32") { return true }
    if str_eq(n, "f64") { return true }
    if str_eq(n, "bool") { return true }
    if str_eq(n, "char") { return true }
    if str_eq(n, "usize") { return true }
    if str_eq(n, "isize") { return true }
    false
}

fn spec_type_args_all_scalar(targs: Option<Box<TypeExprList>>) -> bool with Mut, Panic, Div, Alloc {
    var cur = targs
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if !spec_type_arg_is_scalar((*list).head) { return false }
                cur = (*list).tail
            }
        }
    }
    true
}

// ============================================================
// Type-substitution visitor. Context = (ctx, targs): a type param is any
// single-segment TypeNamed whose name-hash matches one of the ctx's
// registered params; it is replaced by the corresponding turbofish arg.
// Recurses into every TypeExpr-bearing AST slot, including nested turbofish
// `type_args` on calls inside the body — that is what makes generic-to-
// generic chaining (the transitive case) resolve correctly.
// After substitution, a reference to a LOCAL generic struct with concrete
// args (e.g. Wrapper<i64>) is rewritten to the checker's mangled instance
// name (Wrapper__i64) and the concrete struct item is emitted — the
// checker's fn-signature lowering erases generic struct args, so only
// plain concrete names survive it.
// ============================================================

fn spec_name_to_path(n: Name) -> AstPath {
    AstPath {
        segments: StringList { head_buf: n.buf, head_len: n.len, tail: None },
        seg_count: 1,
    }
}

fn spec_subst_type(te: TypeExpr, ctx: i64, targs: Option<Box<TypeExprList>>) -> TypeExpr with Mut, Panic, Div, Alloc {
    if te.kind == TypeExprKind::TypeNamed && te.path.seg_count == 1 {
        let idx = spec_ctx_tp_index(ctx, ast_name_hash(spec_path_single_name(te.path)))
        if idx >= 0 {
            return spec_type_args_nth(targs, idx)
        }
    }
    var out = te
    out.inner = spec_subst_type_opt(te.inner, ctx, targs)
    out.type_args = spec_subst_type_list_opt(te.type_args, ctx, targs)

    // Local generic struct with (now concrete) args -> mangled instance name.
    if out.kind == TypeExprKind::TypeNamed && out.path.seg_count == 1 {
        match out.type_args {
            Some(al) => {
                let base = spec_path_single_name(out.path)
                let st_idx = spec_struct_table_find(base)
                // In an ordinary fn only a struct with a generic impl is replaced by its
                // instance (see SPEC_RW_GI_ONLY); any other stays as written for the checker.
                if st_idx >= 0 && spec_type_args_count(Some(al)) == spec_struct_table_tp_count(st_idx) && (!SPEC_RW_GI_ONLY || spec_gi_has_struct(st_idx)) {
                    let mangled = spec_get_or_create_struct_instance(st_idx, base, Some(al))
                    out.path = spec_name_to_path(mangled)
                    out.type_args = None
                }
            }
            None => {}
        }
    }
    out
}

fn spec_subst_type_opt(opt: Option<Box<TypeExpr>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<TypeExpr>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(t) => Some(Box::new(spec_subst_type(*t, ctx, targs)))
    }
}

fn spec_subst_type_list_opt(opt: Option<Box<TypeExprList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<TypeExprList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => Some(Box::new(TypeExprList { head: spec_subst_type((*list).head, ctx, targs), tail: spec_subst_type_list_opt((*list).tail, ctx, targs) }))
    }
}

// In-place substitution over an Expr staged in a heap buffer. Every write
// goes through the *mut node: direct field writes on big Expr LOCALS are
// silently dropped by the bundle backend (witnessed via trace), while
// *mut field writes are its proven-safe path (check/mod.sio spine).
fn spec_subst_expr_mut(p: *mut SpecExprStage, ctx: i64, targs: Option<Box<TypeExprList>>) with Mut, Panic, Div, Alloc {
    (*p).e.left = spec_subst_expr_opt((*p).e.left, ctx, targs)
    (*p).e.right = spec_subst_expr_opt((*p).e.right, ctx, targs)
    (*p).e.block = spec_subst_block_opt((*p).e.block, ctx, targs)
    (*p).e.else_expr = spec_subst_expr_opt((*p).e.else_expr, ctx, targs)
    (*p).e.args = spec_subst_expr_list_opt((*p).e.args, ctx, targs)
    (*p).e.arms = spec_subst_match_arm_list_opt((*p).e.arms, ctx, targs)
    (*p).e.fields = spec_subst_struct_field_list_opt((*p).e.fields, ctx, targs)
    (*p).e.cast_type = spec_subst_type_opt((*p).e.cast_type, ctx, targs)
    (*p).e.handler_block = spec_subst_block_opt((*p).e.handler_block, ctx, targs)
    (*p).e.closure_return = spec_subst_type_opt((*p).e.closure_return, ctx, targs)
    (*p).e.closure_body = spec_subst_expr_opt((*p).e.closure_body, ctx, targs)
    (*p).e.closure_params = spec_subst_closure_param_list_opt((*p).e.closure_params, ctx, targs)
    (*p).e.type_args = spec_subst_type_list_opt((*p).e.type_args, ctx, targs)

    // Struct literal of a LOCAL generic struct template inside a substituted
    // body: `CDExact { ... }` written in a fn generic over F names the
    // instantiation CDExact<F> — resolvable only when the struct's param
    // names appear in the active ctx (the common same-name convention).
    // When every struct param resolves through ctx, rewrite the literal to
    // the concrete instance name; otherwise leave it for the checker's own
    // literal-inference path (baseline behavior).
    if (*p).e.kind == ExprKind::ExprStructLit && (*p).e.path.seg_count == 1 {
        let base = spec_path_single_name((*p).e.path)
        let st_idx = spec_struct_table_find(base)
        if st_idx >= 0 && (!SPEC_RW_GI_ONLY || spec_gi_has_struct(st_idx)) {
            let st_count = spec_struct_table_tp_count(st_idx)
            var all_resolved = true
            var k: i64 = 0
            while k < st_count {
                if spec_ctx_tp_index(ctx, spec_struct_table_tp_hash(st_idx, k)) < 0 {
                    all_resolved = false
                }
                k = k + 1
            }
            if all_resolved && st_count > 0 {
                // Build the concrete arg list in param order.
                var args_list: Option<Box<TypeExprList>> = None
                var r: i64 = st_count - 1
                while r >= 0 {
                    let pick = spec_ctx_tp_index(ctx, spec_struct_table_tp_hash(st_idx, r))
                    args_list = Some(Box::new(TypeExprList { head: spec_type_args_nth(targs, pick), tail: args_list }))
                    r = r - 1
                }
                spec_get_or_create_struct_instance(st_idx, base, args_list)
                // Recompute the mangled name AFTER the deep instantiation
                // call (Name values held across deep calls arrive corrupted).
                var args_list2: Option<Box<TypeExprList>> = None
                var r2 = spec_struct_table_tp_count(st_idx) - 1
                while r2 >= 0 {
                    let pick2 = spec_ctx_tp_index(ctx, spec_struct_table_tp_hash(st_idx, r2))
                    args_list2 = Some(Box::new(TypeExprList { head: spec_type_args_nth(targs, pick2), tail: args_list2 }))
                    r2 = r2 - 1
                }
                let base2 = spec_path_single_name((*p).e.path)
                let mangled2 = spec_mangle_name(base2, args_list2)
                // Only rewrite when the instance was actually nameable; an
                // empty mangle means no instance was emitted above.
                if !spec_name_is_empty(mangled2) {
                    (*p).e.path = spec_name_to_path(mangled2)
                }
            } else if st_count > 0 {
                // Outside a context that names the struct's parameters: infer the
                // arguments from the field initializers, as for a generic fn call.
                match spec_infer_struct_lit_targs(st_idx, (*p).e.fields) {
                    Some(inferred) => {
                        spec_get_or_create_struct_instance(st_idx, base, Some(inferred))
                        let base3 = spec_path_single_name((*p).e.path)
                        (*p).e.path = spec_name_to_path(spec_mangle_name(base3, Some(inferred)))
                    }
                    None => {}
                }
            }
        }
    }

    if (*p).e.kind == ExprKind::ExprCall {
        spec_subst_static_generic_path(p)
    }
}

fn spec_struct_field_type_stage(opt: Option<Box<FieldDefList>>, name: Name) -> i64 with Mut, Panic, Div, Alloc {
    var cur = opt
    while true {
        match cur {
            None => { return 0 }
            Some(list) => {
                if name_eq((*list).head.name, name) { return spec_stage_type((*list).head.ty) }
                cur = (*list).tail
            }
        }
    }
    0
}

// The type arguments of a generic struct literal, from its field initializers; None
// when a parameter is left unbound.
fn spec_infer_struct_lit_targs(st_idx: i64, fields: Option<Box<StructFieldList>>) -> Option<Box<TypeExprList>> with Mut, Panic, Div, Alloc {
    let tp_count = spec_struct_table_tp_count(st_idx)
    if tp_count <= 0 || tp_count > 4 { return None }
    match spec_struct_table_sd(st_idx) {
        None => None
        Some(sd_box) => {
            let ctx = spec_ctx_from_struct_slot(st_idx)
            let binds = heap_alloc(64) as *mut SpecBindStage
            (*binds).slots = [0; 4]
            var fcur = fields
            var going = true
            while going {
                match fcur {
                    None => { going = false }
                    Some(fl) => {
                        let decl_ptr = spec_struct_field_type_stage((*sd_box).fields, (*fl).head.name)
                        if decl_ptr != 0 {
                            let arg_ptr = spec_infer_expr_type((*fl).head.value)
                            let decl = decl_ptr as *mut SpecTypeStage
                            spec_unify_param((*decl).t, arg_ptr, ctx, binds)
                        }
                        fcur = (*fl).tail
                    }
                }
            }
            var out: Option<Box<TypeExprList>> = None
            var k: i64 = tp_count - 1
            while k >= 0 {
                let slot = (*binds).slots[k as usize]
                if slot == 0 { return None }
                let st = slot as *mut SpecTypeStage
                out = Some(Box::new(TypeExprList { head: (*st).t, tail: out }))
                k = k - 1
            }
            out
        }
    }
}

fn spec_subst_expr_opt(opt: Option<Box<Expr>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<Expr>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(b) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = *b
            (*q).e = tmp
            spec_subst_expr_mut(q, ctx, targs)
            Some(Box::new((*q).e))
        }
    }
}

fn spec_subst_block(b: Block, ctx: i64, targs: Option<Box<TypeExprList>>) -> Block with Mut, Panic, Div, Alloc {
    Block { stmts: spec_subst_stmt_list_opt(b.stmts, ctx, targs), span: b.span }
}

fn spec_subst_block_opt(opt: Option<Box<Block>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<Block>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(b) => Some(Box::new(spec_subst_block(*b, ctx, targs)))
    }
}

fn spec_subst_stmt_list_opt(opt: Option<Box<StmtList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<StmtList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let sp = heap_alloc(16384) as *mut SpecStmtStage
            let tmp = (*list).head
            (*sp).s = tmp
            (*sp).s.ty = spec_subst_type_opt((*sp).s.ty, ctx, targs)
            (*sp).s.expr = spec_subst_expr_opt((*sp).s.expr, ctx, targs)
            (*sp).s.target = spec_subst_expr_opt((*sp).s.target, ctx, targs)
            Some(Box::new(StmtList { head: (*sp).s, tail: spec_subst_stmt_list_opt((*list).tail, ctx, targs) }))
        }
    }
}

fn spec_subst_expr_list_opt(opt: Option<Box<ExprList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<ExprList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head
            (*q).e = tmp
            spec_subst_expr_mut(q, ctx, targs)
            Some(Box::new(ExprList { label: (*list).label, head: (*q).e, tail: spec_subst_expr_list_opt((*list).tail, ctx, targs) }))
        }
    }
}

fn spec_subst_match_arm_list_opt(opt: Option<Box<MatchArmList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<MatchArmList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head.body
            (*q).e = tmp
            spec_subst_expr_mut(q, ctx, targs)
            let new_arm = MatchArm {
                pattern: (*list).head.pattern,
                guard: spec_subst_expr_opt((*list).head.guard, ctx, targs),
                body: (*q).e,
                span: (*list).head.span,
            }
            Some(Box::new(MatchArmList { head: new_arm, tail: spec_subst_match_arm_list_opt((*list).tail, ctx, targs) }))
        }
    }
}

fn spec_subst_struct_field_list_opt(opt: Option<Box<StructFieldList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<StructFieldList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head.value
            (*q).e = tmp
            spec_subst_expr_mut(q, ctx, targs)
            let new_init = StructFieldInit { name: (*list).head.name, value: (*q).e }
            Some(Box::new(StructFieldList { head: new_init, tail: spec_subst_struct_field_list_opt((*list).tail, ctx, targs) }))
        }
    }
}

fn spec_subst_closure_param(cp: ClosureParam, ctx: i64, targs: Option<Box<TypeExprList>>) -> ClosureParam with Mut, Panic, Div, Alloc {
    ClosureParam { name: cp.name, ty: spec_subst_type(cp.ty, ctx, targs), span: cp.span }
}

fn spec_subst_closure_param_list_opt(opt: Option<Box<ClosureParamList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<ClosureParamList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => Some(Box::new(ClosureParamList { head: spec_subst_closure_param((*list).head, ctx, targs), tail: spec_subst_closure_param_list_opt((*list).tail, ctx, targs) }))
    }
}

fn spec_subst_param(p: Param, ctx: i64, targs: Option<Box<TypeExprList>>) -> Param with Mut, Panic, Div, Alloc {
    Param { name: p.name, ty: spec_subst_type(p.ty, ctx, targs), is_self: p.is_self, is_self_mut: p.is_self_mut, span: p.span }
}

fn spec_subst_param_list_opt(opt: Option<Box<ParamList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<ParamList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => Some(Box::new(ParamList { head: spec_subst_param((*list).head, ctx, targs), tail: spec_subst_param_list_opt((*list).tail, ctx, targs) }))
    }
}


// ============================================================
// Struct monomorphization: emit `struct S__i64 { ... }` items so the
// checker only ever sees concrete named structs in signatures.
// ============================================================

fn spec_subst_field_list_opt(opt: Option<Box<FieldDefList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<FieldDefList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let f = (*list).head
            let new_f = FieldDef { name: f.name, ty: spec_subst_type(f.ty, ctx, targs), is_pub: f.is_pub, span: f.span }
            Some(Box::new(FieldDefList { head: new_f, tail: spec_subst_field_list_opt((*list).tail, ctx, targs) }))
        }
    }
}

fn spec_make_struct_item(name: Name, sd: StructDef) -> Item with Mut, Panic, Div, Alloc {
    Item {
        kind: ItemKind::ItemStruct, span: sd.span, visibility: visibility_private(), name: name, fn_def: None,
        struct_def: Some(Box::new(sd)), enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None,
        acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None,
        transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None,
        alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(),
        use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None,
        study_def: None, ontology_def: None,
    }
}

fn spec_extra_push_item(it: Item) with Mut, Panic, Div, Alloc {
    let np = heap_alloc(16384) as *mut SpecItemNode
    (*np).it = it
    (*np).next = SPEC_EXTRA_HEAD
    SPEC_EXTRA_HEAD = np as i64
}

// ============================================================
// Generic impl blocks: one `impl S__args` clone per struct instance
// ============================================================

// A bare single-uppercase-letter named type that is not a generic struct:
// the type-param shape of an impl header argument.
fn spec_type_is_param_letter(te: TypeExpr) -> bool with Mut, Panic, Div {
    if te.kind != TypeExprKind::TypeNamed { return false }
    if te.path.seg_count != 1 { return false }
    match te.type_args {
        Some(_a) => { return false }
        None => {}
    }
    let seg = spec_path_single_name(te.path)
    if seg.len != 1 { return false }
    let c0 = seg.buf[0] as i64
    c0 >= 65 && c0 <= 90 && spec_struct_table_find(seg) < 0
}

// Struct-template slot for a generic impl header `S<A, ..>` whose arguments are
// all type params and match the struct's arity; -1 for any other impl.
fn spec_impl_generic_struct_slot(id: ImplDef) -> i64 with Mut, Panic, Div {
    let te = id.target_type
    if te.kind != TypeExprKind::TypeNamed || te.path.seg_count != 1 { return 0 - 1 }
    let st_idx = spec_struct_table_find(spec_path_single_name(te.path))
    if st_idx < 0 { return 0 - 1 }
    if spec_type_args_count(te.type_args) != spec_struct_table_tp_count(st_idx) { return 0 - 1 }
    var cur = te.type_args
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if !spec_type_is_param_letter((*list).head) { return 0 - 1 }
                cur = (*list).tail
            }
        }
    }
    st_idx
}

fn spec_type_args_letter_hash(opt: Option<Box<TypeExprList>>, n: i64) -> i64 with Mut, Panic, Div, Alloc {
    if n >= spec_type_args_count(opt) { return 0 - 1 }
    ast_name_hash(spec_path_single_name(spec_type_args_nth(opt, n).path))
}

fn spec_collect_generic_impls(items: Option<Box<ItemList>>) with Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemImpl {
                match it.impl_def {
                    Some(id) => {
                        let st_idx = spec_impl_generic_struct_slot((*id))
                        if st_idx >= 0 {
                            if SPEC_GI_COUNT >= 64 {
                                spec_mark_cap_overflow(6)
                            } else {
                                let hdr = (*id).target_type.type_args
                                let gp = heap_alloc(4096) as *mut SpecGiNode
                                (*gp).st_idx = st_idx
                                (*gp).tp_count = spec_type_args_count(hdr)
                                (*gp).h0 = spec_type_args_letter_hash(hdr, 0)
                                (*gp).h1 = spec_type_args_letter_hash(hdr, 1)
                                (*gp).h2 = spec_type_args_letter_hash(hdr, 2)
                                (*gp).h3 = spec_type_args_letter_hash(hdr, 3)
                                (*gp).id = it.impl_def
                                SPEC_GI_PTRS[SPEC_GI_COUNT as usize] = gp as i64
                                SPEC_GI_CLONE_HEAD[SPEC_GI_COUNT as usize] = 0
                                SPEC_GI_COUNT = SPEC_GI_COUNT + 1
                            }
                        }
                    }
                    None => {}
                }
            }
            spec_collect_generic_impls((*list).tail)
        }
    }
}

fn spec_gi_has_struct(st_idx: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < SPEC_GI_COUNT {
        let gp = SPEC_GI_PTRS[i as usize] as *mut SpecGiNode
        if (*gp).st_idx == st_idx { return true }
        i = i + 1
    }
    false
}

// Does this type name a generic-impl struct with type arguments anywhere?
fn spec_type_mentions_gi_struct(te: TypeExpr) -> bool with Mut, Panic, Div {
    if te.kind == TypeExprKind::TypeNamed && te.path.seg_count == 1 {
        match te.type_args {
            Some(_a) => {
                let st_idx = spec_struct_table_find(spec_path_single_name(te.path))
                if st_idx >= 0 && spec_gi_has_struct(st_idx) { return true }
            }
            None => {}
        }
    }
    match te.inner {
        Some(b) => {
            if spec_type_mentions_gi_struct(*b) { return true }
        }
        None => {}
    }
    spec_type_list_mentions_gi_struct(te.type_args)
}

fn spec_type_list_mentions_gi_struct(opt: Option<Box<TypeExprList>>) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if spec_type_mentions_gi_struct((*list).head) { return true }
            spec_type_list_mentions_gi_struct((*list).tail)
        }
    }
}

fn spec_params_mention_gi_struct(opt: Option<Box<ParamList>>) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if spec_type_mentions_gi_struct((*list).head.ty) { return true }
            spec_params_mention_gi_struct((*list).tail)
        }
    }
}

fn spec_type_args_no_param_letter(opt: Option<Box<TypeExprList>>) -> bool with Mut, Panic, Div {
    var cur = opt
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if spec_type_is_param_letter((*list).head) { return false }
                cur = (*list).tail
            }
        }
    }
    true
}

// `S::<A>::f(..)` on a generic-impl struct -> `S__A::f(..)`, emitting the
// instance (struct + impl clone). The checker resolves `Type::method` by the
// path's first segment and lowering names the call `Type_method`, so only the
// concrete instance name lines both up with the cloned impl.
fn spec_subst_static_generic_path(p: *mut SpecExprStage) with Mut, Panic, Div, Alloc {
    match (*p).e.left {
        None => {}
        Some(callee) => {
            if (*callee).kind != ExprKind::ExprPath || (*callee).path.seg_count != 2 { return }
            var targs: Option<Box<TypeExprList>> = (*callee).type_args
            match (*p).e.type_args {
                Some(ta) => { targs = Some(ta) }
                None => {}
            }
            let base = Name { buf: (*callee).path.segments.head_buf, len: (*callee).path.segments.head_len }
            let st_idx = spec_struct_table_find(base)
            if st_idx < 0 || !spec_gi_has_struct(st_idx) { return }
            if spec_type_args_count(targs) != spec_struct_table_tp_count(st_idx) { return }
            if !spec_type_args_no_param_letter(targs) { return }
            spec_get_or_create_struct_instance(st_idx, base, targs)
            // Recompute the name after the deep instantiation call (Name
            // locals held across deep calls arrive corrupted).
            let base2 = Name { buf: (*callee).path.segments.head_buf, len: (*callee).path.segments.head_len }
            let mangled = spec_mangle_name(base2, targs)
            if spec_name_is_empty(mangled) { return }
            let cq = heap_alloc(32768) as *mut SpecExprStage
            let ctmp = *callee
            (*cq).e = ctmp
            let seg_tail = (*cq).e.path.segments.tail
            (*cq).e.path = AstPath { segments: StringList { head_buf: mangled.buf, head_len: mangled.len, tail: seg_tail }, seg_count: 2 }
            (*cq).e.type_args = None
            (*p).e.left = Some(Box::new((*cq).e))
            (*p).e.type_args = None
        }
    }
}

fn spec_impl_instance_target(te: TypeExpr, inst: Name) -> TypeExpr with Mut, Panic, Div {
    var out = te
    out.path = spec_name_to_path(inst)
    out.type_args = None
    out
}

fn spec_make_impl_item(name: Name, id: ImplDef) -> Item with Mut, Panic, Div, Alloc {
    Item {
        kind: ItemKind::ItemImpl, span: id.span, visibility: visibility_private(), name: name, fn_def: None,
        struct_def: None, enum_def: None, impl_def: Some(Box::new(id)), type_alias_ty: None, policy_def: None,
        acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None,
        transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None,
        alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(),
        use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None,
        study_def: None, ontology_def: None,
    }
}

// Substitute every method's signature and body under the impl's context.
fn spec_subst_method_items(methods: Option<Box<ItemList>>, ctx: i64, targs: Option<Box<TypeExprList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    match methods {
        None => None
        Some(list) => {
            let it = (*list).head
            let rest = spec_subst_method_items((*list).tail, ctx, targs)
            if it.kind == ItemKind::ItemFn {
                match it.fn_def {
                    Some(fd_box) => {
                        let fp = heap_alloc(32768) as *mut SpecFnDefStage
                        let tmp_fd = (*fd_box)
                        (*fp).fd = tmp_fd
                        (*fp).fd.params = spec_subst_param_list_opt((*fp).fd.params, ctx, targs)
                        (*fp).fd.return_type = spec_subst_type_opt((*fp).fd.return_type, ctx, targs)
                        (*fp).fd.body = spec_subst_block((*fp).fd.body, ctx, targs)
                        var out_it = it
                        out_it.fn_def = Some(Box::new((*fp).fd))
                        return Some(Box::new(ItemList { head: out_it, tail: rest }))
                    }
                    None => {}
                }
            }
            Some(Box::new(ItemList { head: it, tail: rest }))
        }
    }
}

// Clone every generic impl of struct slot st_idx as `impl <inst_name>`.
fn spec_emit_generic_impl_instances(st_idx: i64, inst_name: Name, targs: Option<Box<TypeExprList>>) with Mut, Panic, Div, Alloc {
    let ns = heap_alloc(1024) as *mut SpecNameStage
    (*ns).n = inst_name
    var i: i64 = 0
    while i < SPEC_GI_COUNT {
        let gp = SPEC_GI_PTRS[i as usize] as *mut SpecGiNode
        if (*gp).st_idx == st_idx {
            match (*gp).id {
                None => {}
                Some(id_box) => {
                    let ip = heap_alloc(16384) as *mut SpecImplDefStage
                    let tmp_id = (*id_box)
                    (*ip).id = tmp_id
                    (*ip).id.target_type = spec_impl_instance_target((*ip).id.target_type, (*ns).n)
                    let impl_ctx = spec_ctx_new((*gp).tp_count, (*gp).h0, (*gp).h1, (*gp).h2, (*gp).h3)
                    (*ip).id.methods = spec_subst_method_items((*ip).id.methods, impl_ctx, targs)
                    let np = heap_alloc(16384) as *mut SpecGiCloneNode
                    (*np).it = spec_make_impl_item((*ns).n, (*ip).id)
                    (*np).scanned = false
                    (*np).ctx = 100000 + SPEC_GI_CLONE_SEQ
                    SPEC_GI_CLONE_SEQ = SPEC_GI_CLONE_SEQ + 1
                    (*np).next = SPEC_GI_CLONE_HEAD[i as usize]
                    SPEC_GI_CLONE_HEAD[i as usize] = np as i64
                }
            }
        }
        i = i + 1
    }
}

// Get-or-create a monomorphized struct instance `S__Args` for struct
// template slot st_idx. Dedup shares the emitted-hash cache; nested
// generic-struct fields recurse through spec_subst_type (terminating via
// the same cache).
fn spec_get_or_create_struct_instance(st_idx: i64, base: Name, targs: Option<Box<TypeExprList>>) -> Name with Mut, Panic, Div, Alloc {
    let mangled = spec_mangle_name(base, targs)
    // Unnameable instantiation: emit nothing and hand back the template name.
    // The checker's signature lowering then erases the generic args, which is
    // the pre-existing baseline — wrong-but-uniform, not two distinct types
    // silently sharing one emitted struct.
    if spec_name_is_empty(mangled) { return base }
    if spec_emitted_has(mangled) { return mangled }
    if !spec_emitted_push(mangled) { return base }

    // The instance and its impl clones are built with the full rewrite, whatever mode the
    // fn that named them is in (see SPEC_RW_GI_ONLY): their bodies are consumed as before.
    let saved_gi_only = SPEC_RW_GI_ONLY
    SPEC_RW_GI_ONLY = false
    match spec_struct_table_sd(st_idx) {
        None => {}
        Some(sd_box) => {
            // Stage the struct clone in a *mut heap node; write the mangled
            // name before the deep field-substitution call (see fn-instance
            // note about Name locals across deep calls).
            let sp = heap_alloc(16384) as *mut SpecStructDefStage
            let tmp_sd = (*sd_box)
            (*sp).sd = tmp_sd
            (*sp).sd.name = mangled
            (*sp).sd.type_params = None
            let st_ctx = spec_ctx_from_struct_slot(st_idx)
            (*sp).sd.fields = spec_subst_field_list_opt((*sp).sd.fields, st_ctx, targs)
            spec_extra_push_item(spec_make_struct_item((*sp).sd.name, (*sp).sd))
            spec_emit_generic_impl_instances(st_idx, (*sp).sd.name, targs)
            SPEC_RW_GI_ONLY = saved_gi_only
            return (*sp).sd.name
        }
    }
    SPEC_RW_GI_ONLY = saved_gi_only
    mangled
}

fn spec_scan_impl_methods(opt: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            match (*list).head.fn_def {
                Some(fd_box) => {
                    let saved_top = SPEC_SC_TOP
                    spec_scope_push_params((*fd_box).params)
                    spec_scan_block((*fd_box).body)
                    SPEC_SC_TOP = saved_top
                }
                None => {}
            }
            spec_scan_impl_methods((*list).tail)
        }
    }
}

// The first segment of a path of any length: `Cell` in `Cell::make`.
// spec_path_single_name is empty for every path but a one-segment one, so the
// `S::<Args>::name` checks below never matched `Cell::<i64>::make` through it.
fn spec_path_head_name(path: AstPath) -> Name {
    if path.seg_count < 1 { return empty_name() }
    Name { buf: path.segments.head_buf, len: path.segments.head_len }
}

// ============================================================
// Dedup / instantiation cache (name-hash nominated, exact-name confirmed)
// ============================================================

fn spec_emitted_has(n: Name) -> bool with Mut, Panic, Div {
    let h = ast_name_hash(n)
    var i: i64 = 0
    while i < SPEC_EMITTED_COUNT {
        if SPEC_EMITTED_HASHES[i as usize] == h {
            let np = SPEC_EMITTED_NAMES[i as usize] as *mut SpecNameStage
            if name_eq((*np).n, n) { return true }
        }
        i = i + 1
    }
    false
}

fn spec_emitted_push(n: Name) -> bool with Mut, Panic, Div, Alloc {
    if SPEC_EMITTED_COUNT < 1024 {
        // Stored before anything else touches n: a Name held across deep calls
        // arrives corrupted (see spec_subst_expr_mut).
        let ns = heap_alloc(1024) as *mut SpecNameStage
        (*ns).n = n
        SPEC_EMITTED_NAMES[SPEC_EMITTED_COUNT as usize] = ns as i64
        SPEC_EMITTED_HASHES[SPEC_EMITTED_COUNT as usize] = ast_name_hash(n)
        SPEC_EMITTED_COUNT = SPEC_EMITTED_COUNT + 1
        return true
    }
    spec_mark_cap_overflow(4)
    false
}

fn spec_make_fn_item(name: Name, fd: FnDef) -> Item with Mut, Panic, Div, Alloc {
    Item {
        kind: ItemKind::ItemFn, span: fd.span, visibility: visibility_private(), name: name, fn_def: Some(Box::new(fd)),
        struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None,
        acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None,
        transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None,
        alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(),
        use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None,
        study_def: None, ontology_def: None,
    }
}

fn spec_int_key(v: i64) -> string with Mut, Panic, Div {
    var digits: [i8; 32] = [0; 32]
    var count: i64 = 0
    var n = v
    var negative = false
    if n < 0 {
        negative = true
        n = 0 - n
    }
    if n == 0 {
        digits[0] = 48 as i8
        count = 1
    }
    while n > 0 && count < 32 {
        digits[count as usize] = (48 + n % 10) as i8
        n = n / 10
        count = count + 1
    }
    var buf: [i8; 384] = [0; 384]
    var len: i64 = 0
    if negative {
        buf[0] = 109 as i8   // 'm'
        len = 1
    }
    var k = count - 1
    while k >= 0 {
        buf[len as usize] = digits[k as usize]
        len = len + 1
        k = k - 1
    }
    str_from_bytes(buf, len)
}

// Length-prefix every source name; tag every constructor and delimit every
// type-argument list. Unlike the legacy struct mangle, underscores and marker
// spellings in source identifiers cannot alias a type constructor or a list.
// Tags: U unit, R &T, M &!T, P *T, Y [T; N], N named type, A list item, E list end.
// A type with no tag here (tuple, function type, multi-segment path, non-literal
// array length) has no key and is refused rather than aliased.
fn spec_key_length(n: i64) -> string with Mut, Panic, Div {
    var b: [i8; 384] = [0; 384]
    b[0] = (48 + n / 100) as i8
    b[1] = (48 + (n / 10) % 10) as i8
    b[2] = (48 + n % 10) as i8
    // str_from_bytes borrows this scratch buffer in the bootstrap runtime.
    // Copy before returning; the next name conversion reuses the same stack.
    let view = str_from_bytes(b, 3)
    str_concat(view, "")
}

fn spec_key_name(n: Name) -> string with Mut, Panic, Div {
    // Keep the owned prefix separate from the temporary name spelling.
    let length = spec_key_length(n.len)
    let spelling = spec_name_to_string(n)
    str_concat(length, spelling)
}

// Array length: a literal is length-prefixed decimal (`L`), a named constant is a
// length-prefixed name (`I`). Any other length expression is not comparable, so it
// has no key.
fn spec_fn_array_size_key(opt: Option<Box<Expr>>) -> string with Mut, Panic, Div {
    match opt {
        None => { return "" }
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                // spec_int_key returns a borrowed scratch view: copy it before any
                // other string is built.
                let digits = str_concat(spec_int_key((*e).int_val), "")
                if str_len(digits) == 0 || str_len(digits) > 32 { return "" }
                let prefix = spec_key_length(str_len(digits))
                return str_concat(str_concat("L", prefix), digits)
            }
            if (*e).kind == ExprKind::ExprIdent {
                if (*e).name.len <= 0 || (*e).name.len > 384 { return "" }
                return str_concat("I", spec_key_name((*e).name))
            }
            return ""
        }
    }
}

fn spec_fn_type_key(te: TypeExpr) -> string with Mut, Panic, Div, Alloc {
    if te.kind == TypeExprKind::TypeUnit { return "U" }
    if te.kind == TypeExprKind::TypeReference || te.kind == TypeExprKind::TypeRefMut {
        match te.inner {
            None => { return "" }
            Some(t) => {
                let inner = spec_fn_type_key(*t)
                if str_len(inner) == 0 { return "" }
                if te.kind == TypeExprKind::TypeRefMut { return str_concat("M", inner) }
                return str_concat("R", inner)
            }
        }
    }
    if te.kind == TypeExprKind::TypeRawPtr {
        match te.inner {
            None => { return "" }
            Some(t) => {
                let inner = spec_fn_type_key(*t)
                if str_len(inner) == 0 { return "" }
                return str_concat("P", inner)
            }
        }
    }
    if te.kind == TypeExprKind::TypeArray {
        let size = spec_fn_array_size_key(te.array_size)
        if str_len(size) == 0 { return "" }
        match te.inner {
            None => { return "" }
            Some(t) => {
                let inner = spec_fn_type_key(*t)
                if str_len(inner) == 0 { return "" }
                return str_concat(str_concat("Y", size), inner)
            }
        }
    }
    if te.kind != TypeExprKind::TypeNamed || te.path.seg_count != 1 { return "" }
    let name = spec_path_single_name(te.path)
    if name.len <= 0 || name.len > 384 { return "" }
    let spelling = spec_key_name(name)
    let prefix = str_concat("N", spelling)
    let args = spec_fn_args_key(te.type_args)
    if str_len(args) == 0 { return "" }
    str_concat(prefix, args)
}

fn spec_fn_args_key(args: Option<Box<TypeExprList>>) -> string with Mut, Panic, Div, Alloc {
    match args {
        None => "E"
        Some(list) => {
            let head = spec_fn_type_key((*list).head)
            let tail = spec_fn_args_key((*list).tail)
            if str_len(head) == 0 || str_len(tail) == 0 { return "" }
            str_concat(str_concat("A", head), tail)
        }
    }
}

fn spec_fn_key(base: Name, args: Option<Box<TypeExprList>>) -> Name with Mut, Panic, Div, Alloc {
    let template = spec_key_name(base)
    let types = spec_fn_args_key(args)
    if str_len(types) == 0 { return empty_name() }
    let key = str_concat(template, types)
    // Keep both key and emitted name inside the conservative backend limit.
    if str_len(key) > 110 { return empty_name() }
    make_name(key)
}

// Instance identity is exact: the template slot plus the COMPLETE canonical key
// (see spec_fn_key), compared name-for-name. An empty key (an unsupported or
// overlong type argument) never matches, so callers fall through to "no instance".
fn spec_fn_instance_find(gt_idx: i64, key: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < SPEC_FI_COUNT {
        if SPEC_FI_GT[i as usize] == gt_idx {
            let kp = SPEC_FI_KEYNAME[i as usize] as *mut SpecNameStage
            if name_eq((*kp).n, key) { return i }
        }
        i = i + 1
    }
    0 - 1
}

fn spec_items_have_symbol(items: Option<Box<ItemList>>, symbol: Name) -> bool with Mut, Panic, Div {
    match items {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, symbol) { return true }
            spec_items_have_symbol((*list).tail, symbol)
        }
    }
}

// ============================================================
// Type-argument inference for calls without a turbofish
// ============================================================
//
// The specializer runs before the checker, so it infers from syntax: a literal's
// type, a parameter's declared type, a local's annotation or inferable initializer,
// `&e` / `&!e`, an array literal, a cast, a non-generic struct literal, and the return
// type of a non-generic fn or of a generic call specialized the same way. The call's
// arguments are matched against the template's parameter types; when every declared
// parameter is bound, the call is specialized exactly like its turbofish form. When
// one is not, the call is left for the checker, which refuses it (E263) rather than
// letting it be lowered against the erased template.

fn spec_stage_type(te: TypeExpr) -> i64 with Mut, Alloc {
    let s = heap_alloc(4096) as *mut SpecTypeStage
    (*s).t = te
    s as i64
}

// The synthesized types are built as one struct literal, the way the parser builds
// them, and staged through spec_stage_type. Built from dummy_type_expr() and then
// patched field by field, a literal argument's type reached the checker as a
// TypeNamed with an empty name (`identity(42)`: "expected , found i64") while the
// same call with `42 as i64` -- a parser-built type -- checked.
fn spec_named_type_stage(text: string, sp: Span) -> i64 with Mut, Panic, Div, Alloc {
    let nm = make_name(text)
    let path = spec_name_to_path(nm)
    let te = TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: sp,
        path: path,
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
    spec_stage_type(te)
}

fn spec_wrap_type_stage(kind: TypeExprKind, inner_ptr: i64) -> i64 with Mut, Panic, Div, Alloc {
    if inner_ptr == 0 { return 0 }
    let inner_stage = inner_ptr as *mut SpecTypeStage
    let inner_te = (*inner_stage).t
    let te = TypeExpr {
        kind: kind,
        span: inner_te.span,
        path: empty_path(),
        type_args: None,
        inner: Some(Box::new(inner_te)),
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
    spec_stage_type(te)
}

fn spec_array_type_stage(elem_ptr: i64, count: i64) -> i64 with Mut, Panic, Div, Alloc {
    if elem_ptr == 0 { return 0 }
    let elem = elem_ptr as *mut SpecTypeStage
    let elem_te = (*elem).t
    let q = heap_alloc(32768) as *mut SpecExprStage
    (*q).e = mk_expr(ExprKind::ExprIntLit, elem_te.span)
    (*q).e.int_val = count
    let te = TypeExpr {
        kind: TypeExprKind::TypeArray,
        span: elem_te.span,
        path: empty_path(),
        type_args: None,
        inner: Some(Box::new(elem_te)),
        array_size: Some(Box::new((*q).e)),
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
    spec_stage_type(te)
}

fn spec_scope_bind(name: Name, type_ptr: i64) with Mut, Panic, Div, Alloc {
    if type_ptr == 0 || SPEC_SC_TOP >= 4096 { return }
    let ns = heap_alloc(1024) as *mut SpecNameStage
    (*ns).n = name
    SPEC_SC_NAMES[SPEC_SC_TOP as usize] = ns as i64
    SPEC_SC_HASH[SPEC_SC_TOP as usize] = ast_name_hash(name)
    SPEC_SC_TYPE[SPEC_SC_TOP as usize] = type_ptr
    SPEC_SC_TOP = SPEC_SC_TOP + 1
}

fn spec_scope_lookup(name: Name) -> i64 with Mut, Panic, Div {
    let h = ast_name_hash(name)
    var i: i64 = SPEC_SC_TOP - 1
    while i >= 0 {
        if SPEC_SC_HASH[i as usize] == h {
            let np = SPEC_SC_NAMES[i as usize] as *mut SpecNameStage
            if name_eq((*np).n, name) { return SPEC_SC_TYPE[i as usize] }
        }
        i = i - 1
    }
    0
}

fn spec_scope_push_params(opt: Option<Box<ParamList>>) with Mut, Panic, Div, Alloc {
    var cur = opt
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if !(*list).head.is_self {
                    let ty_ptr = spec_stage_type((*list).head.ty)
                    spec_scope_bind((*list).head.name, ty_ptr)
                }
                cur = (*list).tail
            }
        }
    }
}

// A `let`/`var` binding: its annotation, else what its initializer infers to.
fn spec_scope_bind_stmt(s: Stmt) with IO, Mut, Panic, Div, Alloc {
    // Staged first: inferring the initializer can instantiate a clone (a deep call),
    // and Name values held across deep calls arrive corrupted.
    let ns = heap_alloc(1024) as *mut SpecNameStage
    (*ns).n = s.name
    var ty_ptr: i64 = 0
    match s.ty {
        Some(te) => { ty_ptr = spec_stage_type(*te) }
        None => {
            match s.expr {
                Some(init) => { ty_ptr = spec_infer_expr_type(*init) }
                None => {}
            }
        }
    }
    spec_scope_bind((*ns).n, ty_ptr)
}

fn spec_collect_return_types(items: Option<Box<ItemList>>) with Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemFn && SPEC_RT_COUNT < 4096 {
                match it.fn_def {
                    Some(fd_box) => {
                        match (*fd_box).type_params {
                            Some(_tps) => {}
                            None => {
                                match (*fd_box).return_type {
                                    Some(rt) => {
                                        let rns = heap_alloc(1024) as *mut SpecNameStage
                                        (*rns).n = it.name
                                        SPEC_RT_NAMES[SPEC_RT_COUNT as usize] = rns as i64
                                        SPEC_RT_HASH[SPEC_RT_COUNT as usize] = ast_name_hash(it.name)
                                        SPEC_RT_TYPE[SPEC_RT_COUNT as usize] = spec_stage_type(*rt)
                                        SPEC_RT_COUNT = SPEC_RT_COUNT + 1
                                    }
                                    None => {}
                                }
                            }
                        }
                    }
                    None => {}
                }
            }
            spec_collect_return_types((*list).tail)
        }
    }
}

fn spec_return_type_lookup(name: Name) -> i64 with Mut, Panic, Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < SPEC_RT_COUNT {
        if SPEC_RT_HASH[i as usize] == h {
            let np = SPEC_RT_NAMES[i as usize] as *mut SpecNameStage
            if name_eq((*np).n, name) { return SPEC_RT_TYPE[i as usize] }
        }
        i = i + 1
    }
    0
}

fn spec_record_inferred_call(span: Span, callee: Name, targs: Option<Box<TypeExprList>>) with Mut, Panic, Div, Alloc {
    if SPEC_CS_COUNT >= 4096 {
        // An inferred call left unrecorded is never renamed to its instance.
        spec_mark_cap_overflow(0)
        return
    }
    let gt_idx = spec_generic_table_find(callee)
    if gt_idx < 0 { return }
    let fi = spec_fn_instance_find(gt_idx, spec_fn_key(callee, targs))
    if fi < 0 { return }
    let i = SPEC_CS_COUNT
    SPEC_CS_FILE[i as usize] = span.file_id as i64
    SPEC_CS_START[i as usize] = span.start
    SPEC_CS_END[i as usize] = span.end
    SPEC_CS_CTX[i as usize] = SPEC_SCAN_CTX
    SPEC_CS_FI[i as usize] = fi
    SPEC_CS_COUNT = i + 1
}

fn spec_inferred_call_lookup(span: Span, ctx: i64) -> i64 with Mut, Panic, Div {
    let fid = span.file_id as i64
    var i: i64 = 0
    while i < SPEC_CS_COUNT {
        if SPEC_CS_START[i as usize] == span.start && SPEC_CS_END[i as usize] == span.end
            && SPEC_CS_FILE[i as usize] == fid && SPEC_CS_CTX[i as usize] == ctx {
            return SPEC_CS_FI[i as usize]
        }
        i = i + 1
    }
    0 - 1
}

fn spec_expr_list_count(opt: Option<Box<ExprList>>) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var cur = opt
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                n = n + 1
                cur = (*list).tail
            }
        }
    }
    n
}

fn spec_infer_expr_opt_type(opt: Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(b) => spec_infer_expr_type(*b)
    }
}

// The syntactic type of an argument expression, as a *mut SpecTypeStage; 0 = unknown.
fn spec_infer_expr_type(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprIntLit { return spec_named_type_stage("i64", e.span) }
    if e.kind == ExprKind::ExprFloatLit { return spec_named_type_stage("f64", e.span) }
    if e.kind == ExprKind::ExprBoolTrue || e.kind == ExprKind::ExprBoolFalse { return spec_named_type_stage("bool", e.span) }
    if e.kind == ExprKind::ExprStringLit { return spec_named_type_stage("string", e.span) }
    if e.kind == ExprKind::ExprCharLit { return spec_named_type_stage("char", e.span) }
    if e.kind == ExprKind::ExprIdent { return spec_scope_lookup(e.name) }
    if e.kind == ExprKind::ExprPath && e.path.seg_count == 1 { return spec_scope_lookup(spec_path_single_name(e.path)) }
    if e.kind == ExprKind::ExprUnary {
        if e.un_op == UnaryOp::OpRef { return spec_wrap_type_stage(TypeExprKind::TypeReference, spec_infer_expr_opt_type(e.left)) }
        if e.un_op == UnaryOp::OpRefMut { return spec_wrap_type_stage(TypeExprKind::TypeRefMut, spec_infer_expr_opt_type(e.left)) }
        return 0
    }
    if e.kind == ExprKind::ExprCast {
        match e.cast_type {
            Some(ct) => { return spec_stage_type(*ct) }
            None => { return 0 }
        }
    }
    if e.kind == ExprKind::ExprArrayLit {
        match e.args {
            Some(list) => {
                let count = spec_expr_list_count(e.args)
                let elem_ptr = spec_infer_expr_type((*list).head)
                return spec_array_type_stage(elem_ptr, count)
            }
            None => { return 0 }
        }
    }
    if e.kind == ExprKind::ExprStructLit && e.path.seg_count == 1 {
        // A generic struct literal's arguments are the checker's to infer.
        if spec_struct_table_find(spec_path_single_name(e.path)) >= 0 { return 0 }
        return spec_named_type_stage(spec_name_to_string(spec_path_single_name(e.path)), e.span)
    }
    if e.kind == ExprKind::ExprCall {
        let callee = spec_call_expr_callee_name(e)
        if name_is_empty(callee) { return 0 }
        let gt_idx = spec_generic_table_find(callee)
        if gt_idx < 0 { return spec_return_type_lookup(callee) }
        // A generic call as an argument was scanned (and specialized) first: its
        // instance's substituted return type.
        var fi: i64 = 0 - 1
        match spec_call_expr_type_args(e) {
            Some(targs) => { fi = spec_fn_instance_find(gt_idx, spec_fn_key(callee, Some(targs))) }
            None => { fi = spec_inferred_call_lookup(e.span, SPEC_SCAN_CTX) }
        }
        if fi < 0 || SPEC_FI_STAGE[fi as usize] == 0 { return 0 }
        let fp = SPEC_FI_STAGE[fi as usize] as *mut SpecFnDefStage
        match (*fp).fd.return_type {
            Some(rt) => { return spec_stage_type(*rt) }
            None => { return 0 }
        }
    }
    0
}

fn spec_unify_type_lists(p: Option<Box<TypeExprList>>, a: Option<Box<TypeExprList>>, ctx: i64, binds: *mut SpecBindStage) with Mut, Panic, Div, Alloc {
    match p {
        None => {}
        Some(pl) => {
            match a {
                None => {}
                Some(al) => {
                    let head_ptr = spec_stage_type((*al).head)
                    spec_unify_param((*pl).head, head_ptr, ctx, binds)
                    spec_unify_type_lists((*pl).tail, (*al).tail, ctx, binds)
                }
            }
        }
    }
}

// Bind the template's type parameters that `param` mentions from the argument type.
// The first binding wins; a conflicting later one is left for the checker to report.
fn spec_unify_param(param: TypeExpr, arg_ptr: i64, ctx: i64, binds: *mut SpecBindStage) with Mut, Panic, Div, Alloc {
    if arg_ptr == 0 { return }
    let arg = arg_ptr as *mut SpecTypeStage
    if param.kind == TypeExprKind::TypeNamed && param.path.seg_count == 1 {
        match param.type_args {
            None => {
                let idx = spec_ctx_tp_index(ctx, ast_name_hash(spec_path_single_name(param.path)))
                if idx >= 0 && idx < 4 && (*binds).slots[idx as usize] == 0 {
                    (*binds).slots[idx as usize] = arg_ptr
                }
            }
            Some(pargs) => {
                if (*arg).t.kind == TypeExprKind::TypeNamed {
                    spec_unify_type_lists(Some(pargs), (*arg).t.type_args, ctx, binds)
                }
            }
        }
        return
    }
    if param.kind == (*arg).t.kind {
        match param.inner {
            Some(pin) => {
                match (*arg).t.inner {
                    Some(ain) => {
                        let inner_ptr = spec_stage_type(*ain)
                        spec_unify_param(*pin, inner_ptr, ctx, binds)
                    }
                    None => {}
                }
            }
            None => {}
        }
    }
}

// The type arguments of a turbofish-less call to template slot `gt_idx`, or None.
fn spec_infer_call_targs(gt_idx: i64, args: Option<Box<ExprList>>) -> Option<Box<TypeExprList>> with IO, Mut, Panic, Div, Alloc {
    let tp_count = spec_generic_table_tp_count(gt_idx)
    if tp_count <= 0 || tp_count > 4 { return None }
    match spec_generic_table_fd(gt_idx) {
        None => None
        Some(fd_box) => {
            let ctx = spec_ctx_from_fn_slot(gt_idx)
            let binds = heap_alloc(64) as *mut SpecBindStage
            (*binds).slots = [0; 4]
            var pcur = (*fd_box).params
            var acur = args
            var going = true
            while going {
                match pcur {
                    None => { going = false }
                    Some(pl) => {
                        match acur {
                            None => { going = false }
                            Some(al) => {
                                let arg_ptr = spec_infer_expr_type((*al).head)
                                spec_unify_param((*pl).head.ty, arg_ptr, ctx, binds)
                                pcur = (*pl).tail
                                acur = (*al).tail
                            }
                        }
                    }
                }
            }
            var out: Option<Box<TypeExprList>> = None
            var k: i64 = tp_count - 1
            while k >= 0 {
                let slot = (*binds).slots[k as usize]
                if slot == 0 { return None }
                let st = slot as *mut SpecTypeStage
                out = Some(Box::new(TypeExprList { head: (*st).t, tail: out }))
                k = k - 1
            }
            out
        }
    }
}

// Ensure a monomorphized clone of template `base_name` for `targs` exists.
//
// Every distinct type-argument list gets its own clone. Until this recorded
// instances per argument list, a template's SECOND distinct instantiation
// POISONED it: the template was kept verbatim and lowered with its parameters
// erased, which is right for word-sized arguments and silently wrong for f64 --
// `identity::<i64>(5)` beside `identity::<f64>(2.5)` compiled, and the f64 call
// returned garbage. Whether a clone keeps the template's name or is emitted under
// its instance name is decided after the whole scan (spec_assign_instance_names).
//
// The instance is reserved BEFORE the clone's own body is processed, so a
// self-recursive generic fn terminates.
fn spec_ensure_instance(base_name: Name, targs: Option<Box<TypeExprList>>) with IO, Mut, Panic, Div, Alloc {
    let gt_idx = spec_generic_table_find(base_name)
    if gt_idx < 0 { return }
    if spec_type_args_count(targs) != spec_generic_table_tp_count(gt_idx) { return }

    let key = spec_fn_key(base_name, targs)
    if spec_name_is_empty(key) {
        // No canonical key (an unsupported or overlong type argument): refuse the
        // program rather than guess a name that could alias another instantiation.
        SPEC_GF_NEEDED[gt_idx as usize] = true
        SPEC_UNSOUND_POISON = true
        return
    }
    if spec_fn_instance_find(gt_idx, key) >= 0 { return }
    if SPEC_FI_COUNT >= 1024 {
        // Out of instance slots: refuse the program (capacity code 5) rather than
        // hand this call its erased template.
        SPEC_GF_NEEDED[gt_idx as usize] = true
        spec_mark_cap_overflow(5)
        return
    }
    let symbol = make_name(str_concat("__sp_", spec_name_to_string(key)))
    if SPEC_SOURCE_ITEMS != 0 {
        let roots = SPEC_SOURCE_ITEMS as *mut SpecItemsStage
        if spec_items_have_symbol((*roots).items, symbol) {
            // A source item already owns this symbol: emitting the clone would
            // shadow it (capacity code 7).
            SPEC_GF_NEEDED[gt_idx as usize] = true
            spec_mark_cap_overflow(7)
            return
        }
    }
    let fi = SPEC_FI_COUNT
    SPEC_FI_GT[fi as usize] = gt_idx
    SPEC_FI_STAGE[fi as usize] = 0
    SPEC_FI_MANGLED[fi as usize] = false
    SPEC_FI_COUNT = fi + 1
    SPEC_GF_INST_COUNT[gt_idx as usize] = SPEC_GF_INST_COUNT[gt_idx as usize] + 1
    // Key and symbol are stored before any deep call: Name values held across deep
    // calls arrive corrupted (see spec_subst_expr_mut).
    let kn = heap_alloc(1024) as *mut SpecNameStage
    (*kn).n = key
    SPEC_FI_KEYNAME[fi as usize] = kn as i64
    let ns = heap_alloc(1024) as *mut SpecNameStage
    (*ns).n = symbol
    SPEC_FI_NAME[fi as usize] = ns as i64

    match spec_generic_table_fd(gt_idx) {
        None => {}
        Some(fd_box) => {
            let fp = heap_alloc(32768) as *mut SpecFnDefStage
            let tmp_fd = (*fd_box)
            (*fp).fd = tmp_fd
            let fn_ctx = spec_ctx_from_fn_slot(gt_idx)
            (*fp).fd.params = spec_subst_param_list_opt((*fp).fd.params, fn_ctx, targs)
            (*fp).fd.return_type = spec_subst_type_opt((*fp).fd.return_type, fn_ctx, targs)
            (*fp).fd.body = spec_subst_block((*fp).fd.body, fn_ctx, targs)
            // Every declared parameter is substituted above, so the clone is a
            // concrete fn: later stages must not scope the old names.
            (*fp).fd.type_params = None
            SPEC_FI_STAGE[fi as usize] = fp as i64
            // Scan the clone body for transitive instantiations (read-only walk; no
            // tree mutation), with the clone's now-concrete parameters in scope and its
            // inferred call sites recorded against this instance.
            let saved_top = SPEC_SC_TOP
            let saved_ctx = SPEC_SCAN_CTX
            spec_scope_push_params((*fp).fd.params)
            SPEC_SCAN_CTX = fi
            spec_scan_block((*fp).fd.body)
            SPEC_SCAN_CTX = saved_ctx
            SPEC_SC_TOP = saved_top
            if spec_trace_enabled() {
                print("specializer: clone_ready=")
                print(spec_name_to_string((*ns).n))
                print("\n")
            }
        }
    }
}

// ============================================================
// Call-site rewriting visitor: finds turbofish Call exprs targeting a
// collected generic fn and rewrites callee+type_args in place. Mirrors
// check.sio's call_expr_type_args lookup (type_args lives on the call node
// itself OR on its callee ident — the parser stamps both).
// ============================================================

fn spec_call_expr_type_args(e: Expr) -> Option<Box<TypeExprList>> with Mut, Panic, Div {
    match e.type_args {
        Some(args) => Some(args)
        None => {
            match e.left {
                Some(callee) => (*callee).type_args
                None => None
            }
        }
    }
}

fn spec_call_expr_callee_name(e: Expr) -> Name with Mut, Panic, Div {
    match e.left {
        None => empty_name()
        Some(callee) => {
            let c = *callee
            if c.kind == ExprKind::ExprIdent {
                c.name
            } else if c.kind == ExprKind::ExprPath && c.path.seg_count == 1 {
                spec_path_single_name(c.path)
            } else {
                empty_name()
            }
        }
    }
}

// Rewrite a call's callee to the mangled instance name, returning the new
// callee box. IMPORTANT: this deliberately returns only the small
// Option<Box<Expr>> — an earlier version returned the whole rewritten Expr
// and the caller's `out = rewrite(out, ...)` self-assignment silently lost
// the update (the large-struct SRET self-by-value hazard documented in
// compiler/main.sio). Callers assign the returned box into out.left and
// clear out.type_args themselves.
// Read-only scanner: walks fn bodies looking for turbofish calls that
// target a collected generic template, instantiating clones as a side
// effect. NO tree mutation happens here (call sites are deliberately left
// untouched — see spec_ensure_instance's same-name scheme).
fn spec_scan_expr_opt(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(b) => spec_scan_expr((*b))
    }
}

fn spec_scan_expr(e: Expr) with IO, Mut, Panic, Div, Alloc {
    spec_scan_expr_opt(e.left)
    spec_scan_expr_opt(e.right)
    spec_scan_block_opt(e.block)
    spec_scan_expr_opt(e.else_expr)
    spec_scan_expr_list_opt(e.args)
    spec_scan_match_arm_list_opt(e.arms)
    spec_scan_struct_field_list_opt(e.fields)
    spec_scan_block_opt(e.handler_block)
    spec_scan_expr_opt(e.closure_body)

    if SPEC_GI_COUNT > 0 {
        if e.kind == ExprKind::ExprCall {
            match e.left {
                Some(callee) => {
                    if (*callee).kind == ExprKind::ExprPath && (*callee).path.seg_count == 2 {
                        let head = Name { buf: (*callee).path.segments.head_buf, len: (*callee).path.segments.head_len }
                        let head_st = spec_struct_table_find(head)
                        if head_st >= 0 && spec_gi_has_struct(head_st) {
                            SPEC_RW_HIT = true
                            let call_targs_missing = match e.type_args {
                                Some(_a) => false,
                                None => true,
                            }
                            let callee_targs_missing = match (*callee).type_args {
                                Some(_b) => false,
                                None => true,
                            }
                            if call_targs_missing && callee_targs_missing {
                                SPEC_GI_STATIC_TARG_MISSING = true
                            }
                        }
                    }
                }
                None => {}
            }
        }
        match e.cast_type {
            Some(ct) => {
                if spec_type_mentions_gi_struct(*ct) { SPEC_RW_HIT = true }
            }
            None => {}
        }
        // A generic-impl struct literal carries no type arguments: it names an instance
        // only once the rewrite pass infers them from its fields
        // (spec_infer_struct_lit_targs), so its fn needs that pass.
        if e.kind == ExprKind::ExprStructLit && e.path.seg_count == 1 {
            let lit_st = spec_struct_table_find(spec_path_single_name(e.path))
            if lit_st >= 0 && spec_gi_has_struct(lit_st) { SPEC_RW_HIT = true }
        }
    }

    // A generic method's slot is never the target of a free call.
    if e.kind == ExprKind::ExprCall {
        let callee_name = spec_call_expr_callee_name(e)
        if !name_is_empty(callee_name) {
            let gt_idx = spec_generic_table_find(callee_name)
            if gt_idx >= 0 && !SPEC_GF_IS_METHOD[gt_idx as usize] {
                var specialized = false
                match spec_call_expr_type_args(e) {
                    Some(targs) => {
                        let provided = spec_type_args_count(Some(targs))
                        if spec_trace_enabled() {
                            print("specializer: call=")
                            print(spec_name_to_string(callee_name))
                            print(" gt=")
                            print_int(gt_idx)
                            print(" targs=")
                            print_int(provided)
                            print(" want=")
                            print_int(spec_generic_table_tp_count(gt_idx))
                            print("\n")
                        }
                        if provided == spec_generic_table_tp_count(gt_idx) {
                            spec_ensure_instance(callee_name, Some(targs))
                            specialized = true
                        }
                    }
                    None => {
                        // No turbofish: determine the type arguments from the arguments.
                        match spec_infer_call_targs(gt_idx, e.args) {
                            Some(inferred) => {
                                spec_ensure_instance(callee_name, Some(inferred))
                                // Recomputed after the deep instantiation call (Name
                                // values held across deep calls arrive corrupted).
                                spec_record_inferred_call(e.span, spec_call_expr_callee_name(e), Some(inferred))
                                specialized = true
                            }
                            None => {}
                        }
                    }
                }
                if !specialized {
                    SPEC_GF_NEEDED[gt_idx as usize] = true
                }
            }
        }
    }

    // `recv.method::<A>(...)`: a generic method is instantiated from its own
    // turbofish only. Its arguments are not inferred here, so a call without one is
    // refused; a turbofish on a method that declares no type parameters is refused
    // too, so type arguments are never silently discarded.
    if e.kind == ExprKind::ExprMethodCall {
        let gt_m = spec_generic_table_find(e.name)
        if gt_m >= 0 && SPEC_GF_IS_METHOD[gt_m as usize] {
            var method_specialized = false
            match spec_call_expr_type_args(e) {
                Some(mtargs) => {
                    if spec_type_args_count(Some(mtargs)) == spec_generic_table_tp_count(gt_m) {
                        spec_ensure_instance(e.name, Some(mtargs))
                        method_specialized = true
                    }
                }
                None => {}
            }
            if !method_specialized {
                SPEC_GF_NEEDED[gt_m as usize] = true
                SPEC_METHOD_TARG_UNSUPPORTED = true
            }
        } else {
            match spec_call_expr_type_args(e) {
                Some(_mt) => { SPEC_METHOD_TARG_UNSUPPORTED = true }
                None => {}
            }
        }
    }
}

fn spec_scan_block(b: Block) with IO, Mut, Panic, Div, Alloc {
    spec_scan_stmt_list_opt(b.stmts)
}

fn spec_scan_block_opt(opt: Option<Box<Block>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(b) => spec_scan_stmt_list_opt((*b).stmts)
    }
}

fn spec_scan_stmt_list_opt(opt: Option<Box<StmtList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            if SPEC_GI_COUNT > 0 {
                match (*list).head.ty {
                    Some(t) => {
                        if spec_type_mentions_gi_struct(*t) { SPEC_RW_HIT = true }
                    }
                    None => {}
                }
            }
            spec_scan_expr_opt((*list).head.expr)
            spec_scan_expr_opt((*list).head.target)
            if (*list).head.kind == StmtKind::StmtLet || (*list).head.kind == StmtKind::StmtVar {
                spec_scope_bind_stmt((*list).head)
            }
            spec_scan_stmt_list_opt((*list).tail)
        }
    }
}

fn spec_scan_expr_list_opt(opt: Option<Box<ExprList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            spec_scan_expr((*list).head)
            spec_scan_expr_list_opt((*list).tail)
        }
    }
}

fn spec_scan_match_arm_list_opt(opt: Option<Box<MatchArmList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            spec_scan_expr_opt((*list).head.guard)
            spec_scan_expr((*list).head.body)
            spec_scan_match_arm_list_opt((*list).tail)
        }
    }
}

fn spec_scan_struct_field_list_opt(opt: Option<Box<StructFieldList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            spec_scan_expr((*list).head.value)
            spec_scan_struct_field_list_opt((*list).tail)
        }
    }
}

fn spec_scan_items(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemFn && spec_generic_table_find(it.name) < 0 {
                match it.fn_def {
                    Some(fd_box) => {
                        let saved_top = SPEC_SC_TOP
                        spec_scope_push_params((*fd_box).params)
                        spec_scan_block((*fd_box).body)
                        SPEC_SC_TOP = saved_top
                    }
                    None => {}
                }
            } else if it.kind == ItemKind::ItemImpl {
                // Method bodies call generic fns too; unscanned, such a call never
                // instantiated its template, which could then be dropped outright. A
                // generic impl's own bodies still name its parameters: its clones are
                // scanned per instance (spec_scan_generic_impl_clones).
                match it.impl_def {
                    Some(id_box) => {
                        if spec_impl_generic_struct_slot((*id_box)) < 0 {
                            spec_scan_items((*id_box).methods)
                        }
                    }
                    None => {}
                }
            }
            spec_scan_items((*list).tail)
        }
    }
}

// ============================================================
// Instance naming and call-site renaming
// ============================================================
//
// A template with exactly one instantiation and no call that still needs it
// keeps the same-name scheme: its clone replaces it and no call site changes, so
// such programs lower byte-identically. Otherwise every instantiation is emitted
// under its instance name, and each call `f::<A>(...)` it serves is rewritten to
// call that name without type arguments. The rename writes go through
// heap-staged *mut nodes, the pattern spec_subst_expr_mut documents, and a body
// is rebuilt only when a read-only pass finds something in it to rename.

fn spec_assign_instance_names() with Mut, Panic, Div {
    var any: i64 = 0
    var i: i64 = 0
    while i < SPEC_FI_COUNT {
        let gt = SPEC_FI_GT[i as usize]
        if SPEC_GF_NEEDED[gt as usize] || SPEC_GF_INST_COUNT[gt as usize] > 1 {
            SPEC_FI_MANGLED[i as usize] = true
            any = any + 1
        }
        i = i + 1
    }
    SPEC_ANY_MANGLED = any
}

// The instance a call is rewritten to, or -1.
fn spec_rename_call_target(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprCall { return 0 - 1 }
    let callee_name = spec_call_expr_callee_name(e)
    if name_is_empty(callee_name) { return 0 - 1 }
    let gt_idx = spec_generic_table_find(callee_name)
    if gt_idx < 0 || SPEC_GF_IS_METHOD[gt_idx as usize] { return 0 - 1 }
    match spec_call_expr_type_args(e) {
        None => {
            // An inferred call carries no type args; the scan recorded its instance.
            let fi_inferred = spec_inferred_call_lookup(e.span, SPEC_RENAME_CTX)
            if fi_inferred >= 0 && SPEC_FI_MANGLED[fi_inferred as usize] { fi_inferred } else { 0 - 1 }
        }
        Some(targs) => {
            if spec_type_args_count(Some(targs)) != spec_generic_table_tp_count(gt_idx) {
                return 0 - 1
            }
            let fi = spec_fn_instance_find(gt_idx, spec_fn_key(callee_name, Some(targs)))
            if fi >= 0 && SPEC_FI_MANGLED[fi as usize] { fi } else { 0 - 1 }
        }
    }
}

// The mangled instance a `recv.method::<A>(...)` call is rewritten to, or -1. A
// generic method used with one argument list keeps its name and its clone replaces
// it inside the impl, so its calls stay as written.
fn spec_rename_method_target(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprMethodCall { return 0 - 1 }
    let gt_idx = spec_generic_table_find(e.name)
    if gt_idx < 0 || !SPEC_GF_IS_METHOD[gt_idx as usize] { return 0 - 1 }
    match spec_call_expr_type_args(e) {
        None => 0 - 1
        Some(targs) => {
            if spec_type_args_count(Some(targs)) != spec_generic_table_tp_count(gt_idx) {
                return 0 - 1
            }
            let fi = spec_fn_instance_find(gt_idx, spec_fn_key(e.name, Some(targs)))
            if fi >= 0 && SPEC_FI_MANGLED[fi as usize] { fi } else { 0 - 1 }
        }
    }
}

fn spec_expr_opt_has_rename(opt: Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(b) => spec_expr_has_rename(*b)
    }
}

fn spec_expr_has_rename(e: Expr) -> bool with Mut, Panic, Div, Alloc {
    if spec_rename_call_target(e) >= 0 { return true }
    if spec_rename_method_target(e) >= 0 { return true }
    if spec_expr_opt_has_rename(e.left) { return true }
    if spec_expr_opt_has_rename(e.right) { return true }
    if spec_block_opt_has_rename(e.block) { return true }
    if spec_expr_opt_has_rename(e.else_expr) { return true }
    if spec_expr_list_opt_has_rename(e.args) { return true }
    if spec_arm_list_opt_has_rename(e.arms) { return true }
    if spec_field_list_opt_has_rename(e.fields) { return true }
    if spec_block_opt_has_rename(e.handler_block) { return true }
    spec_expr_opt_has_rename(e.closure_body)
}

fn spec_block_has_rename(b: Block) -> bool with Mut, Panic, Div, Alloc {
    spec_stmt_list_opt_has_rename(b.stmts)
}

fn spec_block_opt_has_rename(opt: Option<Box<Block>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(b) => spec_stmt_list_opt_has_rename((*b).stmts)
    }
}

fn spec_stmt_list_opt_has_rename(opt: Option<Box<StmtList>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(list) => {
            if spec_expr_opt_has_rename((*list).head.expr) { return true }
            if spec_expr_opt_has_rename((*list).head.target) { return true }
            spec_stmt_list_opt_has_rename((*list).tail)
        }
    }
}

fn spec_expr_list_opt_has_rename(opt: Option<Box<ExprList>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(list) => {
            if spec_expr_has_rename((*list).head) { return true }
            spec_expr_list_opt_has_rename((*list).tail)
        }
    }
}

fn spec_arm_list_opt_has_rename(opt: Option<Box<MatchArmList>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(list) => {
            if spec_expr_opt_has_rename((*list).head.guard) { return true }
            if spec_expr_has_rename((*list).head.body) { return true }
            spec_arm_list_opt_has_rename((*list).tail)
        }
    }
}

fn spec_field_list_opt_has_rename(opt: Option<Box<StructFieldList>>) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(list) => {
            if spec_expr_has_rename((*list).head.value) { return true }
            spec_field_list_opt_has_rename((*list).tail)
        }
    }
}

fn spec_rename_expr_mut(p: *mut SpecExprStage) with Mut, Panic, Div, Alloc {
    (*p).e.left = spec_rename_expr_opt((*p).e.left)
    (*p).e.right = spec_rename_expr_opt((*p).e.right)
    (*p).e.block = spec_rename_block_opt((*p).e.block)
    (*p).e.else_expr = spec_rename_expr_opt((*p).e.else_expr)
    (*p).e.args = spec_rename_expr_list_opt((*p).e.args)
    (*p).e.arms = spec_rename_match_arm_list_opt((*p).e.arms)
    (*p).e.fields = spec_rename_struct_field_list_opt((*p).e.fields)
    (*p).e.handler_block = spec_rename_block_opt((*p).e.handler_block)
    (*p).e.closure_body = spec_rename_expr_opt((*p).e.closure_body)
    let fi = spec_rename_call_target((*p).e)
    if fi >= 0 {
        match (*p).e.left {
            Some(callee_box) => {
                let cq = heap_alloc(32768) as *mut SpecExprStage
                let callee_tmp = *callee_box
                (*cq).e = callee_tmp
                let ns = SPEC_FI_NAME[fi as usize] as *mut SpecNameStage
                (*cq).e.name = (*ns).n
                (*cq).e.path = spec_name_to_path((*ns).n)
                (*cq).e.type_args = None
                (*p).e.left = Some(Box::new((*cq).e))
            }
            None => {}
        }
        // The parser stamps turbofish args on the call node as well as the callee.
        (*p).e.type_args = None
    }
    // `recv.method::<A>(...)` with a mangled instance: call it by that name. Its
    // clone is emitted inside the impl (spec_finalize_method_items).
    let mfi = spec_rename_method_target((*p).e)
    if mfi >= 0 {
        let mns = SPEC_FI_NAME[mfi as usize] as *mut SpecNameStage
        (*p).e.name = (*mns).n
        (*p).e.type_args = None
    }
}

fn spec_rename_expr_opt(opt: Option<Box<Expr>>) -> Option<Box<Expr>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(b) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = *b
            (*q).e = tmp
            spec_rename_expr_mut(q)
            Some(Box::new((*q).e))
        }
    }
}

fn spec_rename_block(b: Block) -> Block with Mut, Panic, Div, Alloc {
    Block { stmts: spec_rename_stmt_list_opt(b.stmts), span: b.span }
}

fn spec_rename_block_opt(opt: Option<Box<Block>>) -> Option<Box<Block>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(b) => Some(Box::new(spec_rename_block(*b)))
    }
}

fn spec_rename_stmt_list_opt(opt: Option<Box<StmtList>>) -> Option<Box<StmtList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let sp = heap_alloc(16384) as *mut SpecStmtStage
            let tmp = (*list).head
            (*sp).s = tmp
            (*sp).s.expr = spec_rename_expr_opt((*sp).s.expr)
            (*sp).s.target = spec_rename_expr_opt((*sp).s.target)
            Some(Box::new(StmtList { head: (*sp).s, tail: spec_rename_stmt_list_opt((*list).tail) }))
        }
    }
}

fn spec_rename_expr_list_opt(opt: Option<Box<ExprList>>) -> Option<Box<ExprList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head
            (*q).e = tmp
            spec_rename_expr_mut(q)
            Some(Box::new(ExprList { label: (*list).label, head: (*q).e, tail: spec_rename_expr_list_opt((*list).tail) }))
        }
    }
}

fn spec_rename_match_arm_list_opt(opt: Option<Box<MatchArmList>>) -> Option<Box<MatchArmList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head.body
            (*q).e = tmp
            spec_rename_expr_mut(q)
            let new_arm = MatchArm {
                pattern: (*list).head.pattern,
                guard: spec_rename_expr_opt((*list).head.guard),
                body: (*q).e,
                span: (*list).head.span,
            }
            Some(Box::new(MatchArmList { head: new_arm, tail: spec_rename_match_arm_list_opt((*list).tail) }))
        }
    }
}

fn spec_rename_struct_field_list_opt(opt: Option<Box<StructFieldList>>) -> Option<Box<StructFieldList>> with Mut, Panic, Div, Alloc {
    match opt {
        None => None
        Some(list) => {
            let q = heap_alloc(32768) as *mut SpecExprStage
            let tmp = (*list).head.value
            (*q).e = tmp
            spec_rename_expr_mut(q)
            let new_init = StructFieldInit { name: (*list).head.name, value: (*q).e }
            Some(Box::new(StructFieldList { head: new_init, tail: spec_rename_struct_field_list_opt((*list).tail) }))
        }
    }
}

// Rewrite call sites in every fn and impl-method body that has one to rewrite.
fn spec_rename_items(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    match items {
        None => None
        Some(list) => {
            let rest = spec_rename_items((*list).tail)
            let node = heap_alloc(16384) as *mut SpecItemNode
            let it_tmp = (*list).head
            (*node).it = it_tmp
            (*node).next = 0
            if (*node).it.kind == ItemKind::ItemFn {
                match (*node).it.fn_def {
                    Some(fd_box) => {
                        if spec_block_has_rename((*fd_box).body) {
                            let fp = heap_alloc(32768) as *mut SpecFnDefStage
                            let fd_tmp = *fd_box
                            (*fp).fd = fd_tmp
                            (*fp).fd.body = spec_rename_block((*fp).fd.body)
                            (*node).it.fn_def = Some(Box::new((*fp).fd))
                        }
                    }
                    None => {}
                }
            } else if (*node).it.kind == ItemKind::ItemImpl {
                match (*node).it.impl_def {
                    Some(id_box) => {
                        let ip = heap_alloc(16384) as *mut SpecImplDefStage
                        let id_tmp = *id_box
                        (*ip).id = id_tmp
                        (*ip).id.methods = spec_rename_items((*ip).id.methods)
                        (*node).it.impl_def = Some(Box::new((*ip).id))
                    }
                    None => {}
                }
            }
            Some(Box::new(ItemList { head: (*node).it, tail: rest }))
        }
    }
}

// The item for instance `fi`: its clone under the template's name or, when mangled,
// under its instance name, with its own call sites renamed.
fn spec_instance_item(fi: i64) -> Item with Mut, Panic, Div, Alloc {
    let fp = SPEC_FI_STAGE[fi as usize] as *mut SpecFnDefStage
    if SPEC_FI_MANGLED[fi as usize] {
        let ns = SPEC_FI_NAME[fi as usize] as *mut SpecNameStage
        (*fp).fd.name = (*ns).n
    }
    // Calls inside this clone were recorded against it (spec_record_inferred_call).
    let saved_rename_ctx = SPEC_RENAME_CTX
    SPEC_RENAME_CTX = fi
    if SPEC_ANY_MANGLED > 0 && spec_block_has_rename((*fp).fd.body) {
        (*fp).fd.body = spec_rename_block((*fp).fd.body)
    }
    SPEC_RENAME_CTX = saved_rename_ctx
    spec_make_fn_item((*fp).fd.name, (*fp).fd)
}

// The one instance of a template that keeps the template's name, or -1.
fn spec_same_name_instance(gt_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < SPEC_FI_COUNT {
        if SPEC_FI_GT[i as usize] == gt_idx && !SPEC_FI_MANGLED[i as usize] && SPEC_FI_STAGE[i as usize] != 0 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn spec_mangled_instance_items() -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    var out: Option<Box<ItemList>> = None
    var i: i64 = SPEC_FI_COUNT - 1
    while i >= 0 {
        // A generic method's instances are emitted inside its impl instead.
        if SPEC_FI_MANGLED[i as usize] && SPEC_FI_STAGE[i as usize] != 0 && !SPEC_GF_IS_METHOD[SPEC_FI_GT[i as usize] as usize] {
            out = Some(Box::new(ItemList { head: spec_instance_item(i), tail: out }))
        }
        i = i - 1
    }
    out
}

// ============================================================
// Top-level driver
// ============================================================

// Walk every impl clone's methods for transitive turbofish instantiations.
// Scanning can emit further instances (and clones), so repeat to a fixed
// point; the emitted-hash cap bounds it.
fn spec_scan_generic_impl_clones() with IO, Mut, Panic, Div, Alloc {
    var changed = true
    while changed {
        changed = false
        var i: i64 = 0
        while i < SPEC_GI_COUNT {
            var cur = SPEC_GI_CLONE_HEAD[i as usize]
            while cur != 0 {
                let np = cur as *mut SpecGiCloneNode
                if !(*np).scanned {
                    (*np).scanned = true
                    match (*np).it.impl_def {
                        Some(id) => {
                            // Under the clone's own context, with each method's params in
                            // scope: an inferred call is recorded per clone.
                            let saved_ctx = SPEC_SCAN_CTX
                            SPEC_SCAN_CTX = (*np).ctx
                            spec_scan_impl_methods((*id).methods)
                            SPEC_SCAN_CTX = saved_ctx
                        }
                        None => {}
                    }
                    changed = true
                }
                cur = (*np).next
            }
            i = i + 1
        }
    }
}

// Rename the call sites inside every impl clone under that clone's context, as
// spec_rename_items does for ordinary code once instance names are assigned.
fn spec_rename_gi_clones() with Mut, Panic, Div, Alloc {
    var slot: i64 = 0
    while slot < SPEC_GI_COUNT {
        var cur = SPEC_GI_CLONE_HEAD[slot as usize]
        while cur != 0 {
            let np = cur as *mut SpecGiCloneNode
            match (*np).it.impl_def {
                Some(id_box) => {
                    let saved_ctx = SPEC_RENAME_CTX
                    SPEC_RENAME_CTX = (*np).ctx
                    let ip = heap_alloc(16384) as *mut SpecImplDefStage
                    let id_tmp = *id_box
                    (*ip).id = id_tmp
                    (*ip).id.methods = spec_rename_items((*ip).id.methods)
                    (*np).it.impl_def = Some(Box::new((*ip).id))
                    SPEC_RENAME_CTX = saved_ctx
                }
                None => {}
            }
            cur = (*np).next
        }
        slot = slot + 1
    }
}

// Prepend every impl clone. They must precede their callers: lowering binds a
// local's struct type from a static call's return only once the method is
// lowered, and a collapsed multi-module list starts with main's module, so at
// the template's position `var v = S__i64::new()` left v untyped and every
// `v.push(..)` became a call to a body-less bare `push` (measured: SIGILL).
fn spec_gi_clones_prepend_all(rest: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    var out = rest
    var slot: i64 = 0
    while slot < SPEC_GI_COUNT {
        var cur = SPEC_GI_CLONE_HEAD[slot as usize]
        while cur != 0 {
            let np = cur as *mut SpecGiCloneNode
            out = Some(Box::new(ItemList { head: (*np).it, tail: out }))
            cur = (*np).next
        }
        slot = slot + 1
    }
    out
}

// Rewrite one non-generic fn whose signature or body names a generic-impl
// struct with type args: `S<A>` types and `S::<A>::f` paths become `S__A`.
// Bodies that never name one are returned untouched (no staging cost).
fn spec_rewrite_fn_item(it: Item) -> Item with IO, Mut, Panic, Div, Alloc {
    match it.fn_def {
        None => it
        Some(fd_box) => {
            SPEC_RW_HIT = false
            if spec_params_mention_gi_struct((*fd_box).params) { SPEC_RW_HIT = true }
            match (*fd_box).return_type {
                Some(rt) => {
                    if spec_type_mentions_gi_struct(*rt) { SPEC_RW_HIT = true }
                }
                None => {}
            }
            // Params in scope, as in the first scan: a call whose type arguments are
            // inferred from them must not mark its template as still needed here.
            let saved_top = SPEC_SC_TOP
            spec_scope_push_params((*fd_box).params)
            spec_scan_block((*fd_box).body)
            SPEC_SC_TOP = saved_top
            if !SPEC_RW_HIT { return it }
            let fp = heap_alloc(32768) as *mut SpecFnDefStage
            let tmp_fd = (*fd_box)
            (*fp).fd = tmp_fd
            SPEC_RW_GI_ONLY = true
            (*fp).fd.params = spec_subst_param_list_opt((*fp).fd.params, 0, None)
            (*fp).fd.return_type = spec_subst_type_opt((*fp).fd.return_type, 0, None)
            (*fp).fd.body = spec_subst_block((*fp).fd.body, 0, None)
            SPEC_RW_GI_ONLY = false
            var out_it = it
            out_it.fn_def = Some(Box::new((*fp).fd))
            out_it
        }
    }
}

fn spec_rewrite_method_items(methods: Option<Box<ItemList>>) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    match methods {
        None => None
        Some(list) => {
            let it = (*list).head
            let rest = spec_rewrite_method_items((*list).tail)
            if it.kind == ItemKind::ItemFn && spec_generic_table_find(it.name) < 0 {
                return Some(Box::new(ItemList { head: spec_rewrite_fn_item(it), tail: rest }))
            }
            Some(Box::new(ItemList { head: it, tail: rest }))
        }
    }
}

fn spec_rewrite_items(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    match items {
        None => None
        Some(list) => {
            let it = (*list).head
            let rest = spec_rewrite_items((*list).tail)
            if it.kind == ItemKind::ItemFn && spec_generic_table_find(it.name) < 0 {
                return Some(Box::new(ItemList { head: spec_rewrite_fn_item(it), tail: rest }))
            }
            if it.kind == ItemKind::ItemImpl {
                match it.impl_def {
                    Some(id) => {
                        if spec_impl_generic_struct_slot((*id)) < 0 {
                            let ip = heap_alloc(16384) as *mut SpecImplDefStage
                            let tmp_id = (*id)
                            (*ip).id = tmp_id
                            (*ip).id.methods = spec_rewrite_method_items((*ip).id.methods)
                            var out_it = it
                            out_it.impl_def = Some(Box::new((*ip).id))
                            return Some(Box::new(ItemList { head: out_it, tail: rest }))
                        }
                    }
                    None => {}
                }
            }
            Some(Box::new(ItemList { head: it, tail: rest }))
        }
    }
}

fn spec_append_items(a: Option<Box<ItemList>>, b: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Alloc {
    match a {
        None => b
        Some(list) => Some(Box::new(ItemList { head: (*list).head, tail: spec_append_items((*list).tail, b) }))
    }
}

// Materialize the *mut chain of freshly instantiated items into a real
// Option<Box<ItemList>> (order does not matter for top-level fns).
fn spec_extra_items_to_list() -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    var out: Option<Box<ItemList>> = None
    var cur = SPEC_EXTRA_HEAD
    while cur != 0 {
        let p = cur as *mut SpecItemNode
        out = Some(Box::new(ItemList { head: (*p).it, tail: out }))
        cur = (*p).next
    }
    out
}

// Finalize phase (runs after ALL bodies have been scanned, so every call
// site has voted): for each generic template item —
//   - poisoned (2+ distinct instantiations) or still referenced by a
//     turbofish-less/arity-mismatched call: keep the template verbatim so
//     the checker\'s existing diagnostics (e.g. E010) keep firing;
//   - exactly one instantiation: REPLACE the template with its concrete
//     same-name clone;
//   - never referenced: drop it so the checker never sees a body with free
//     type vars.
// The method item for instance `fi` of a generic method: its clone under the
// method's name or, when mangled, its instance name, with its own call sites
// renamed. The template's kind, span and visibility are kept, so a `pub fn pick<T>`
// clone stays pub. The template is staged first: values carrying Names that are
// held across the deep rename call arrive corrupted.
fn spec_method_instance_item(fi: i64, tmpl: Item) -> Item with Mut, Panic, Div, Alloc {
    let tn = heap_alloc(16384) as *mut SpecItemNode
    (*tn).it = tmpl
    (*tn).next = 0
    let fp = SPEC_FI_STAGE[fi as usize] as *mut SpecFnDefStage
    if SPEC_FI_MANGLED[fi as usize] {
        let ns = SPEC_FI_NAME[fi as usize] as *mut SpecNameStage
        (*fp).fd.name = (*ns).n
    }
    let saved_rename_ctx = SPEC_RENAME_CTX
    SPEC_RENAME_CTX = fi
    if SPEC_ANY_MANGLED > 0 && spec_block_has_rename((*fp).fd.body) {
        (*fp).fd.body = spec_rename_block((*fp).fd.body)
    }
    SPEC_RENAME_CTX = saved_rename_ctx
    Item {
        kind: (*tn).it.kind, span: (*tn).it.span, visibility: (*tn).it.visibility, name: (*fp).fd.name, fn_def: Some(Box::new((*fp).fd)),
        struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None,
        acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None,
        transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None,
        alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(),
        use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None,
        study_def: None, ontology_def: None,
    }
}

// The mangled instances of generic method slot `gt_idx`, in creation order, ahead of
// `tail`.
fn spec_method_mangled_instances(gt_idx: i64, tmpl: Item, tail: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    let tn = heap_alloc(16384) as *mut SpecItemNode
    (*tn).it = tmpl
    (*tn).next = 0
    var out = tail
    var i: i64 = SPEC_FI_COUNT - 1
    while i >= 0 {
        if SPEC_FI_GT[i as usize] == gt_idx && SPEC_FI_MANGLED[i as usize] && SPEC_FI_STAGE[i as usize] != 0 {
            out = Some(Box::new(ItemList { head: spec_method_instance_item(i, (*tn).it), tail: out }))
        }
        i = i - 1
    }
    out
}

// An impl's methods with its generic methods resolved: a method used with one
// type-argument list is replaced by its same-name clone; one used with several gets a
// clone per list under each instance name, beside it (its calls were renamed to
// match); one still called without a turbofish is kept as written, and the program
// is refused (spec_report_unsupported_method_generic); one never called is dropped.
fn spec_finalize_method_items(methods: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    match methods {
        None => None
        Some(list) => {
            let rest = spec_finalize_method_items((*list).tail)
            let tn = heap_alloc(16384) as *mut SpecItemNode
            let it_tmp = (*list).head
            (*tn).it = it_tmp
            (*tn).next = 0
            if (*tn).it.kind == ItemKind::ItemFn {
                let gt_idx = spec_generic_table_find((*tn).it.name)
                if gt_idx >= 0 && SPEC_GF_IS_METHOD[gt_idx as usize] {
                    let with_mangled = spec_method_mangled_instances(gt_idx, (*tn).it, rest)
                    if SPEC_GF_NEEDED[gt_idx as usize] {
                        return Some(Box::new(ItemList { head: (*tn).it, tail: with_mangled }))
                    }
                    let fi = spec_same_name_instance(gt_idx)
                    if fi >= 0 {
                        return Some(Box::new(ItemList { head: spec_method_instance_item(fi, (*tn).it), tail: with_mangled }))
                    }
                    return with_mangled
                }
            }
            Some(Box::new(ItemList { head: (*tn).it, tail: rest }))
        }
    }
}

// Does this impl hold a generic method slot (one spec_finalize_method_items rewrites)?
fn spec_methods_have_generic_slot(methods: Option<Box<ItemList>>) -> bool with Mut, Panic, Div {
    var cur = methods
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if (*list).head.kind == ItemKind::ItemFn {
                    let g = spec_generic_table_find((*list).head.name)
                    if g >= 0 && SPEC_GF_IS_METHOD[g as usize] { return true }
                }
                cur = (*list).tail
            }
        }
    }
    false
}

fn spec_finalize_items(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Panic, Div, Alloc {
    match items {
        None => None
        Some(list) => {
            let it = (*list).head
            let rest = spec_finalize_items((*list).tail)
            if it.kind == ItemKind::ItemFn {
                let gt_idx = spec_generic_table_find(it.name)
                if gt_idx >= 0 {
                    // Still called without type arguments (or out of instance slots):
                    // keep the template; its instances are emitted under their own
                    // names (spec_mangled_instance_items).
                    if SPEC_GF_NEEDED[gt_idx as usize] {
                        return Some(Box::new(ItemList { head: it, tail: rest }))
                    }
                    let fi = spec_same_name_instance(gt_idx)
                    if fi >= 0 {
                        return Some(Box::new(ItemList { head: spec_instance_item(fi), tail: rest }))
                    }
                    return rest
                }
            } else if it.kind == ItemKind::ItemImpl {
                match it.impl_def {
                    Some(id_box) => {
                        // Generic impl template: dropped. Its instance clones go to the
                        // front of the list (spec_gi_clones_prepend_all).
                        if spec_impl_generic_struct_slot((*id_box)) >= 0 {
                            return rest
                        }
                        // An impl holding a generic method: its methods are resolved in place.
                        if spec_methods_have_generic_slot((*id_box).methods) {
                            let ip = heap_alloc(16384) as *mut SpecImplDefStage
                            let tmp_id = (*id_box)
                            (*ip).id = tmp_id
                            (*ip).id.methods = spec_finalize_method_items((*ip).id.methods)
                            var out_it = it
                            out_it.impl_def = Some(Box::new((*ip).id))
                            return Some(Box::new(ItemList { head: out_it, tail: rest }))
                        }
                    }
                    None => {}
                }
            }
            Some(Box::new(ItemList { head: it, tail: rest }))
        }
    }
}

// Memoised: read_env allocates and the runtime allocator never reclaims,
// so a gate evaluated at every call site leaks on every call. CHECKED is
// separate from the value because "off" and "not yet read" are different.
var SPEC_TRACE_ENABLED_ON: i64 = 0
var SPEC_TRACE_ENABLED_CHECKED: i64 = 0

fn spec_trace_enabled() -> bool with IO, Mut, Panic, Div {
    if SPEC_TRACE_ENABLED_CHECKED == 0 {
        SPEC_TRACE_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_SPEC_TRACE"), "1") {
            SPEC_TRACE_ENABLED_ON = 1
        }
    }
    SPEC_TRACE_ENABLED_ON == 1
}

// `&Box1__f64` / `T` / `f64`: the head name of a type, through references.
fn spec_trace_type_head(te: TypeExpr) with IO, Mut, Panic, Div {
    if te.kind == TypeExprKind::TypeReference || te.kind == TypeExprKind::TypeRefMut {
        print("&")
        match te.inner {
            Some(inner) => { spec_trace_type_head(*inner) }
            None => { print("?") }
        }
        return
    }
    if te.kind == TypeExprKind::TypeNamed {
        print(spec_name_to_string(spec_path_head_name(te.path)))
        match te.type_args {
            Some(_ta) => { print("<..>") }
            None => {}
        }
        return
    }
    print("_")
}

fn spec_trace_out_method_names(opt: Option<Box<ItemList>>) with IO, Mut, Panic, Div {
    var cur = opt
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                print(" ")
                print(spec_name_to_string((*list).head.name))
                // Parameter and return type heads, so the trace shows whether an
                // instance's methods were substituted (`x:f64`) or kept erased (`x:T`).
                match (*list).head.fn_def {
                    Some(fd_box) => {
                        print("(")
                        var pc = (*fd_box).params
                        var pgoing = true
                        while pgoing {
                            match pc {
                                None => { pgoing = false }
                                Some(pl) => {
                                    print(spec_name_to_string((*pl).head.name))
                                    print(":")
                                    spec_trace_type_head((*pl).head.ty)
                                    print(",")
                                    pc = (*pl).tail
                                }
                            }
                        }
                        print(")->")
                        match (*fd_box).return_type {
                            Some(rt) => { spec_trace_type_head(*rt) }
                            None => { print("()") }
                        }
                    }
                    None => {}
                }
                cur = (*list).tail
            }
        }
    }
}

fn spec_trace_out_items(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div {
    match items {
        None => {}
        Some(list) => {
            let it = (*list).head
            if it.kind == ItemKind::ItemFn {
                print("specializer: out_fn ")
                print(spec_name_to_string(it.name))
                print("\n")
            } else if it.kind == ItemKind::ItemStruct {
                print("specializer: out_struct ")
                print(spec_name_to_string(it.name))
                print("\n")
            } else if it.kind == ItemKind::ItemImpl {
                match it.impl_def {
                    Some(id_box) => {
                        print("specializer: out_impl ")
                        print(spec_name_to_string(spec_path_head_name((*id_box).target_type.path)))
                        match (*id_box).target_type.type_args {
                            Some(_ta) => { print("<..>") }
                            None => {}
                        }
                        print(" methods:")
                        spec_trace_out_method_names((*id_box).methods)
                        print("\n")
                    }
                    None => {}
                }
            }
            spec_trace_out_items((*list).tail)
        }
    }
}

pub fn specialize_generics(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    spec_reset_state()
    let known = spec_collect_known_names(items, SpecKnownNames { names: [empty_name(); 32], count: 0 })
    // Structs first: generic impl detection and method collection consult
    // the struct template table.
    spec_collect_generic_structs(items)
    spec_collect_generic_impls(items)
    spec_collect_generic_fns(items, known)
    spec_collect_generic_methods(items, known)
    if spec_trace_enabled() {
        print("specializer: generic_fns=")
        print_int(SPEC_GF_COUNT)
        print(" generic_impls=")
        print_int(SPEC_GI_COUNT)
        print("\n")
    }
    if SPEC_GF_COUNT == 0 && SPEC_GI_COUNT == 0 {
        return items
    }
    let roots = heap_alloc(4096) as *mut SpecItemsStage
    (*roots).items = items
    SPEC_SOURCE_ITEMS = roots as i64
    spec_collect_return_types(items)
    spec_scan_items(items)
    var work_items = items
    if SPEC_GI_COUNT > 0 {
        // Ordinary code naming a generic-impl struct is rewritten to its instances,
        // then every impl clone -- including those the rewrite emitted -- is scanned.
        work_items = spec_rewrite_items(items)
        spec_scan_generic_impl_clones()
    }
    spec_assign_instance_names()
    var source_items = work_items
    if SPEC_ANY_MANGLED > 0 {
        source_items = spec_rename_items(work_items)
        spec_rename_gi_clones()
    }
    let finalized = spec_finalize_items(source_items)
    let with_extras = spec_append_items(finalized, spec_extra_items_to_list())
    let with_instances = spec_append_items(with_extras, spec_mangled_instance_items())
    // Impl clones go to the front: they must precede their callers.
    let out = spec_gi_clones_prepend_all(with_instances)
    if spec_trace_enabled() {
        print("specializer: instances=")
        print_int(SPEC_EMITTED_COUNT)
        print("\n")
        spec_trace_out_items(out)
    }
    out
}

// ============================================================
// Multi-module lane support (WP-A3)
// ============================================================
//
// The multi-module driver (compiler/module_frontend.sio) merges every module's
// item list into ONE list and calls specialize_generics over it (design (a):
// with all imported structs/enums present, the "locally declared struct/enum"
// exclusion in spec_type_is_free_var covers imported single-letter type names
// too, so a real imported `struct F {..}` is never misread as a free type var).
// It then needs two things this state exposes AFTER a specialize_generics call:
//   1. spec_last_instantiated() — did the pass actually replace a generic fn
//      template with a concrete clone, or emit a concrete struct instance?
//      Only then does the driver collapse the merged+specialized list into one
//      module. When false, the merged list differs from the inputs by at most
//      dropped never-referenced templates, so the driver leaves the per-module
//      programs untouched (plain multi-module code stays byte-identical).
//   2. spec_append_item_lists() — a public wrapper over the proven internal
//      concat, used to build the merged list without duplicating the pattern.

pub fn spec_last_instantiated() -> bool with Mut, Panic, Div {
    spec_mono_marker_count() > 0
}

// Seed-safe i64 count of monomorphization markers after specialize_generics:
// emitted struct instances + same-name fn clones. Drivers that arm IR collapse
// should prefer this over bare bool negation — CI-seed rebuilds miscompiled
// `if !spec_last_instantiated() { return … }` so non-generic multi-mod still
// collapsed (generic_fns=0 → ir_summary_failed on imported_deref_f64_array).
pub fn spec_mono_marker_count() -> i64 with Mut, Panic, Div {
    var n: i64 = SPEC_EMITTED_COUNT
    var i: i64 = 0
    while i < SPEC_FI_COUNT {
        if SPEC_FI_STAGE[i as usize] != 0 {
            n = n + 1
        }
        i = i + 1
    }
    n
}

pub fn spec_append_item_lists(a: Option<Box<ItemList>>, b: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Alloc {
    spec_append_items(a, b)
}

// ============================================================
// Specialized-list reachability DCE (Wave13)
// ============================================================
//
// After merge→specialize, the monomorphized ItemList still carries every
// top-level ItemFn from every imported module (e.g. full f64 cayley_dickson
// arithmetic when only `cd_sigma` is used). Body-lowering those unused
// aggregate f64 CD helpers is a known SEGV surface (Wave12 residual class:
// float-layout poison / large [f64;2048] loops). This pass marks callables
// reachable from `main` via fixed-point BFS over ExprCall + ExprMethodCall
// edges, then drops unmarked top-level ItemFns. Non-fn items (structs,
// impls, traits, …) are always kept so layout + method dispatch survive.
//
// Seed-safe: local i64 hash tables only (no Name/Option globals).

// WHY THIS TABLE IS A HASH SET AND NOT A LIST.
//
// It used to be `[i64; 512]` scanned linearly, and both halves of that were
// load-bearing in the wrong direction.
//
// The FATAL half: when the list was full, spec_dce_hash_insert returned false
// and inserted nothing — silently. A callee whose mark could not be recorded is
// then not found by spec_dce_filter_items, and filter_items DELETES every
// top-level ItemFn it cannot find. So past 512 distinct reachable names this
// pass did not merely stop optimising, it started removing live functions from
// the program. Measured on 2026-08-04: a name-based reachability census over
// main.sio's own 120-module closure marks 5889 names. The compiler was 11x past
// the point where its own dead-code pass begins deleting reachable code.
//
// It compounded: spec_dce_scan_item_if_marked reports "changed" as
// `*count > before`, and once the table is full nothing can be inserted, so
// `changed` is false and the fixed-point loop EXITS SATISFIED with the mark set
// incomplete. A saturated table looked exactly like convergence.
//
// The LINEAR half is why the cap could not simply be raised: find is O(count),
// run for every item on every round, so at 16k marks over ~10k items the pass
// would be quadratic and the build would not finish. Open addressing makes the
// cap affordable, which is what makes the refusal below affordable too.
//
// The table is a power of two so the probe wraps by mask, and 0 stays the empty
// sentinel — ast_name_hash returns |hash| and insert rejects 0, so no live name
// can be confused with an empty slot.
let SPEC_DCE_SLOTS: i64 = 16384
let SPEC_DCE_SLOT_MASK: i64 = 16383
// 50% load. Past this the probe lengths stop being constant and, more to the
// point, the pass must refuse rather than guess.
let SPEC_DCE_MAX: i64 = 8192
// Fixed-point rounds. Was the same constant as the table size, which meant
// nothing in particular; reachability over this graph converges in far fewer.
let SPEC_DCE_MAX_ROUNDS: i64 = 64

fn spec_dce_hash_find(marks: &[i64; 16384], count: i64, h: i64) -> bool with Mut, Panic, Div {
    if h == 0 {
        return false
    }
    var slot = h % SPEC_DCE_SLOTS
    var probes: i64 = 0
    while probes < SPEC_DCE_SLOTS {
        let cur = marks[slot as usize]
        if cur == 0 {
            return false
        }
        if cur == h {
            return true
        }
        slot = (slot + 1) % SPEC_DCE_SLOTS
        probes = probes + 1
    }
    false
}

fn spec_dce_hash_insert(marks: &! [i64; 16384], count: &! i64, h: i64) -> bool with Mut, Panic, Div {
    if h == 0 {
        return false
    }
    if *count >= SPEC_DCE_MAX {
        // Do NOT insert and do NOT pretend this was a no-op: the caller reads
        // *count against SPEC_DCE_MAX and abandons filtering entirely. Silence
        // here is what deleted live code before.
        return false
    }
    var slot = h % SPEC_DCE_SLOTS
    var probes: i64 = 0
    while probes < SPEC_DCE_SLOTS {
        let cur = marks[slot as usize]
        if cur == h {
            return false
        }
        if cur == 0 {
            marks[slot as usize] = h
            *count = *count + 1
            return true
        }
        slot = (slot + 1) % SPEC_DCE_SLOTS
        probes = probes + 1
    }
    false
}

// Walk an expression tree; insert callee / method name hashes into `marks`.
fn spec_dce_scan_expr(e: Expr, marks: &! [i64; 16384], count: &! i64) with Mut, Panic, Div {
    if e.kind == ExprKind::ExprCall {
        let callee = spec_call_expr_callee_name(e)
        if !name_is_empty(callee) {
            var _ins = spec_dce_hash_insert(marks, count, ast_name_hash(callee))
        }
    } else if e.kind == ExprKind::ExprMethodCall {
        if !name_is_empty(e.name) {
            var _ins = spec_dce_hash_insert(marks, count, ast_name_hash(e.name))
        }
    } else if e.kind == ExprKind::ExprIdent {
        // First-class fn refs (`call_it(square, x)`, `let f = square`) are
        // ExprIdent, not ExprCall. Without marking the name, spec_dce deletes
        // the target function and LoadFnRef binds to a stale/wrong fn_id.
        if !name_is_empty(e.name) {
            var _ins = spec_dce_hash_insert(marks, count, ast_name_hash(e.name))
        }
    } else if e.kind == ExprKind::ExprPath {
        if e.path.seg_count == 1 {
            let n = spec_path_single_name(e.path)
            if !name_is_empty(n) {
                var _ins = spec_dce_hash_insert(marks, count, ast_name_hash(n))
            }
        }
    }
    match e.left {
        Some(b) => spec_dce_scan_expr(*b, marks, count)
        None => {}
    }
    match e.right {
        Some(b) => spec_dce_scan_expr(*b, marks, count)
        None => {}
    }
    match e.else_expr {
        Some(b) => spec_dce_scan_expr(*b, marks, count)
        None => {}
    }
    match e.closure_body {
        Some(b) => spec_dce_scan_expr(*b, marks, count)
        None => {}
    }
    match e.block {
        Some(b) => spec_dce_scan_block(*b, marks, count)
        None => {}
    }
    match e.handler_block {
        Some(b) => spec_dce_scan_block(*b, marks, count)
        None => {}
    }
    match e.args {
        Some(list) => {
            spec_dce_scan_expr((*list).head, marks, count)
            var cur = (*list).tail
            var going = true
            while going {
                match cur {
                    None => { going = false }
                    Some(rest) => {
                        spec_dce_scan_expr((*rest).head, marks, count)
                        cur = (*rest).tail
                    }
                }
            }
        }
        None => {}
    }
    match e.arms {
        Some(list) => {
            match (*list).head.guard {
                Some(g) => spec_dce_scan_expr(*g, marks, count)
                None => {}
            }
            spec_dce_scan_expr((*list).head.body, marks, count)
            var cur = (*list).tail
            var going = true
            while going {
                match cur {
                    None => { going = false }
                    Some(rest) => {
                        match (*rest).head.guard {
                            Some(g) => spec_dce_scan_expr(*g, marks, count)
                            None => {}
                        }
                        spec_dce_scan_expr((*rest).head.body, marks, count)
                        cur = (*rest).tail
                    }
                }
            }
        }
        None => {}
    }
    match e.fields {
        Some(list) => {
            spec_dce_scan_expr((*list).head.value, marks, count)
            var cur = (*list).tail
            var going = true
            while going {
                match cur {
                    None => { going = false }
                    Some(rest) => {
                        spec_dce_scan_expr((*rest).head.value, marks, count)
                        cur = (*rest).tail
                    }
                }
            }
        }
        None => {}
    }
}

// `let x: f128 = ...` (TypeNamed, single segment "f128"), or — V0-E.5.7 — a
// `[f128; N]` / `&[f128; N]` array of them (see spec_dce_type_expr_mentions_f128).
fn spec_dce_opt_type_is_f128(opt: Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match opt {
        Some(te) => spec_dce_type_expr_mentions_f128(&(*te)),
        None => false,
    }
}

// V0-E.5.7: does a type expression carry a language f128 anywhere an element
// read can surface as a softfloat operand? `f128` itself, `[f128; N]`, and one
// or more reference layers over either (`&[f128; N]`, `&![f128; N]`, `&f128`).
// A `[f128; N]` local/param/field is an AST-visible trigger for the desugar
// exactly like a bare f128 (`fn sum(a: &[f128; 3]) -> i64 { if a[0] < a[1]
// ... }` has no scalar f128 anywhere). Seq<f128> and tuples stay out: the
// lowerer does not classify their elements as f128 yet, so marking for them
// would claim a path that does not exist.
fn spec_dce_type_expr_mentions_f128(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind == TypeExprKind::TypeArray
        || (*te).kind == TypeExprKind::TypeReference
        || (*te).kind == TypeExprKind::TypeRefMut {
        match (*te).inner {
            Some(inner) => return spec_dce_type_expr_mentions_f128(&(*inner)),
            None => return false,
        }
    }
    spec_dce_type_expr_is_f128(te)
}

// V0-E.5.4: an f128 param or `-> f128` return is another AST-visible trigger
// for the lowering-introduced softfloat calls (`fn add128(a: f128, b: f128) ->
// f128 { a + b }` has no f128 let at all), so a scanned fn body whose signature
// mentions f128 marks the desugar targets before its statements are walked.
fn spec_dce_fn_sig_uses_f128(fd: &FnDef) -> bool with Mut, Panic, Div {
    if spec_dce_opt_type_is_f128((*fd).return_type) { return true }
    var cur = (*fd).params
    var going = true
    var found = false
    while going {
        match cur {
            Some(list) => {
                // V0-E.5.7: `a: &[f128; N]` / `a: [f128; N]` params count too.
                if spec_dce_type_expr_mentions_f128(&(*list).head.ty) { found = true }
                cur = (*list).tail
            }
            None => { going = false }
        }
    }
    found
}

fn spec_dce_type_expr_is_f128(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 4 { return false }
    if seg.head_buf[0] as i64 != 102 { return false }
    seg.head_buf[1] as i64 == 49 && seg.head_buf[2] as i64 == 50 && seg.head_buf[3] as i64 == 56
}

// V0-E.5.5: a struct with an f128 field is the third AST-visible trigger — its
// fields are read/written as softfloat operands anywhere the struct flows, so
// a program can reach the desugar with no f128 let, param, or return at all
// (`fn lt(p: &P) -> bool { p.x < p.y }`). Structs are never deleted by this
// pass, so the check is unconditional on the item.
fn spec_dce_struct_has_f128_field(sd: &StructDef) -> bool with Mut, Panic, Div {
    var cur = (*sd).fields
    var going = true
    var found = false
    while going {
        match cur {
            Some(list) => {
                // V0-E.5.7: an `arr: [f128; N]` field is the same trigger.
                if spec_dce_type_expr_mentions_f128(&(*list).head.ty) { found = true }
                cur = (*list).tail
            }
            None => { going = false }
        }
    }
    found
}

fn spec_dce_scan_fn_def(fd: &FnDef, marks: &! [i64; 16384], count: &! i64) with Mut, Panic, Div {
    if spec_dce_fn_sig_uses_f128(fd) {
        spec_dce_mark_f128_desugar_targets(marks, count)
    }
    spec_dce_scan_block((*fd).body, marks, count)
}

// V0-E.5.1: language `f128` `+`/`-` on annotated locals is desugared by
// ir/lower.sio into IrCall f128_bits_soft_add / f128_bits_soft_sub. Those calls
// do not exist in the AST this pass walks, so with only source-visible callees
// marked the two bodies were deleted as unreachable, the lowerer's find-or-add
// left a body-less stub, and the backend refused it with ud2 (SIGILL, exit 132
// on Linux x86_64) unless main happened to call one of them itself. An f128
// let is the AST-visible trigger for that desugar, so it marks both names.
fn spec_dce_mark_f128_desugar_targets(marks: &! [i64; 16384], count: &! i64) with Mut, Panic, Div {
    var _a = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_add")))
    var _b = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_sub")))
    // V0-E.5.2: `*`, unary `-`, and the six comparisons are also lowering-introduced.
    var _c = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_mul")))
    var _d = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_neg")))
    var _e = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_lt")))
    var _f = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_le")))
    var _g = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_gt")))
    var _h = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_ge")))
    var _i = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_eq")))
    var _j = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_ne")))
    // V0-E.5.3: `/`. KL-8: `%`.
    var _k = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_div")))
    var _l = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("f128_bits_soft_rem")))
    // KL-8: builtin println/print of language f128 desugars to fmt helpers.
    var _m = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("println_f128")))
    var _n = spec_dce_hash_insert(marks, count, ast_name_hash(make_name("print_f128")))
}

// ── V0-E.5.10: "does this program mention language f128 anywhere?" ─────────
//
// Boolean twin of the marking scanners above, with no mark set. The driver
// (module_frontend_compile_imported_to_file) asks this for every loaded module
// and, if any says yes, adds stdlib math/softfloat_f128.sio to the module
// graph itself — the desugar targets (f128_bits_soft_*) live there, and before
// this rung a program that forgot `use math::softfloat_f128::...` linked to a
// body-less stub and died with SIGILL (exit 132). Same AST-visible triggers as
// the DCE marks: an f128 (or [f128; N], &f128 ...) let/var type, param, return,
// or struct field, anywhere in a fn body including nested blocks, closures,
// match arms and handler blocks. Item-level fns, structs and impl methods are
// walked; nothing else carries a type annotation the lowerer classifies wide.
fn spec_mentions_f128_opt_expr(opt: Option<Box<Expr>>) -> bool with Mut, Panic, Div {
    match opt {
        Some(b) => spec_mentions_f128_expr(*b),
        None => false,
    }
}

fn spec_mentions_f128_opt_block(opt: Option<Box<Block>>) -> bool with Mut, Panic, Div {
    match opt {
        Some(b) => spec_mentions_f128_block(*b),
        None => false,
    }
}

fn spec_mentions_f128_expr(e: Expr) -> bool with Mut, Panic, Div {
    if spec_mentions_f128_opt_expr(e.left) { return true }
    if spec_mentions_f128_opt_expr(e.right) { return true }
    if spec_mentions_f128_opt_expr(e.else_expr) { return true }
    if spec_mentions_f128_opt_expr(e.closure_body) { return true }
    if spec_mentions_f128_opt_block(e.block) { return true }
    if spec_mentions_f128_opt_block(e.handler_block) { return true }
    var acur = e.args
    var agoing = true
    while agoing {
        match acur {
            Some(list) => {
                if spec_mentions_f128_expr((*list).head) { return true }
                acur = (*list).tail
            }
            None => { agoing = false }
        }
    }
    var mcur = e.arms
    var mgoing = true
    while mgoing {
        match mcur {
            Some(list) => {
                if spec_mentions_f128_opt_expr((*list).head.guard) { return true }
                if spec_mentions_f128_expr((*list).head.body) { return true }
                mcur = (*list).tail
            }
            None => { mgoing = false }
        }
    }
    false
}

fn spec_mentions_f128_block(b: Block) -> bool with Mut, Panic, Div {
    var cur = b.stmts
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if (*list).head.kind == StmtKind::StmtLet || (*list).head.kind == StmtKind::StmtVar {
                    if spec_dce_opt_type_is_f128((*list).head.ty) { return true }
                }
                if spec_mentions_f128_opt_expr((*list).head.expr) { return true }
                if spec_mentions_f128_opt_expr((*list).head.target) { return true }
                cur = (*list).tail
            }
        }
    }
    false
}

fn spec_mentions_f128_item(it: Item) -> bool with Mut, Panic, Div {
    if it.kind == ItemKind::ItemFn {
        match it.fn_def {
            Some(fd) => {
                if spec_dce_fn_sig_uses_f128(&(*fd)) { return true }
                return spec_mentions_f128_block((*fd).body)
            }
            None => { return false }
        }
    }
    if it.kind == ItemKind::ItemStruct {
        match it.struct_def {
            Some(sd) => { return spec_dce_struct_has_f128_field(&(*sd)) }
            None => { return false }
        }
    }
    if it.kind == ItemKind::ItemImpl {
        match it.impl_def {
            Some(id) => {
                var mcur = (*id).methods
                var mgoing = true
                while mgoing {
                    match mcur {
                        Some(ml) => {
                            if spec_mentions_f128_item((*ml).head) { return true }
                            mcur = (*ml).tail
                        }
                        None => { mgoing = false }
                    }
                }
            }
            None => {}
        }
    }
    false
}

pub fn spec_program_mentions_f128(prog: &Program) -> bool with Mut, Panic, Div {
    var cur = (*prog).items
    var going = true
    while going {
        match cur {
            Some(list) => {
                if spec_mentions_f128_item((*list).head) { return true }
                cur = (*list).tail
            }
            None => { going = false }
        }
    }
    false
}

fn spec_dce_scan_block(b: Block, marks: &! [i64; 16384], count: &! i64) with Mut, Panic, Div {
    var cur = b.stmts
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if (*list).head.kind == StmtKind::StmtLet || (*list).head.kind == StmtKind::StmtVar {
                    if spec_dce_opt_type_is_f128((*list).head.ty) {
                        spec_dce_mark_f128_desugar_targets(marks, count)
                    }
                }
                match (*list).head.expr {
                    Some(ex) => spec_dce_scan_expr(*ex, marks, count)
                    None => {}
                }
                match (*list).head.target {
                    Some(ex) => spec_dce_scan_expr(*ex, marks, count)
                    None => {}
                }
                cur = (*list).tail
            }
        }
    }
}

// If item is a body the filter can delete (a top-level ItemFn), scan its
// body only when it is marked. Impl and trait methods are never deleted by
// the filter, so their bodies are scanned unconditionally — a retained body
// must contribute its callees to the mark set. Returns true if any new hash
// was inserted.
fn spec_dce_scan_item_if_marked(
    it: Item,
    marks: &! [i64; 16384],
    count: &! i64
) -> bool with Mut, Panic, Div {
    let before = *count
    if it.kind == ItemKind::ItemFn {
        let h = ast_name_hash(it.name)
        if spec_dce_hash_find(marks, *count, h) {
            match it.fn_def {
                Some(fd) => spec_dce_scan_fn_def(&(*fd), marks, count)
                None => {}
            }
        }
    } else if it.kind == ItemKind::ItemStruct {
        match it.struct_def {
            Some(sd) => {
                if spec_dce_struct_has_f128_field(&(*sd)) {
                    spec_dce_mark_f128_desugar_targets(marks, count)
                }
            }
            None => {}
        }
    } else if it.kind == ItemKind::ItemImpl {
        // Method bodies are scanned UNCONDITIONALLY, not only when the bare
        // method name is marked. The filter below never deletes an ItemImpl,
        // and the dep body pass lowers every method of a kept impl, so a
        // method body is retained even when nothing reachable calls it. A
        // retained body's callees must therefore be marked, or the callee is
        // deleted from the item list while the wrapper that calls it still
        // lowers — the call then binds to an instr_count==0 stub and native
        // codegen traps it (ud2). Measured 2026-08-19 on madaros_root2_associated_
        // import: Epistemic::measured lowered with a real delegation body while
        // ep_measured (called only from that impl) was filtered out — SIGILL
        // rc=132; the same program runs green with SOUNIO_DISABLE_MM_DCE=1. The
        // associated call could not mark "measured" either, because
        // spec_call_expr_callee_name returns empty for multi-segment paths —
        // so the gate could never open for this shape at all.
        match it.impl_def {
            Some(id) => {
                var mcur = (*id).methods
                var mgoing = true
                while mgoing {
                    match mcur {
                        None => { mgoing = false }
                        Some(mlist) => {
                            let mit = (*mlist).head
                            if mit.kind == ItemKind::ItemFn {
                                match mit.fn_def {
                                    Some(fd) => spec_dce_scan_fn_def(&(*fd), marks, count)
                                    None => {}
                                }
                            }
                            mcur = (*mlist).tail
                        }
                    }
                }
            }
            None => {}
        }
    } else if it.kind == ItemKind::ItemTrait {
        // Same unconditional scan as ItemImpl above: the filter keeps
        // ItemTrait whole, so a default-method body is retained and its
        // callees must be marked.
        match it.trait_def {
            Some(td) => {
                var mcur = (*td).methods
                var mgoing = true
                while mgoing {
                    match mcur {
                        None => { mgoing = false }
                        Some(mlist) => {
                            let mit = (*mlist).head
                            if mit.kind == ItemKind::ItemFn {
                                match mit.fn_def {
                                    Some(fd) => spec_dce_scan_fn_def(&(*fd), marks, count)
                                    None => {}
                                }
                            }
                            mcur = (*mlist).tail
                        }
                    }
                }
            }
            None => {}
        }
    }
    *count > before
}

fn spec_dce_scan_list_if_marked(
    items: Option<Box<ItemList>>,
    marks: &! [i64; 16384],
    count: &! i64
) -> bool with Mut, Panic, Div {
    var changed = false
    var cur = items
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if spec_dce_scan_item_if_marked((*list).head, marks, count) {
                    changed = true
                }
                cur = (*list).tail
            }
        }
    }
    changed
}

fn spec_dce_has_main(items: Option<Box<ItemList>>) -> bool with Mut, Panic, Div {
    let main_h = ast_name_hash(make_name("main"))
    var cur = items
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                let it = (*list).head
                if it.kind == ItemKind::ItemFn {
                    if ast_name_hash(it.name) == main_h {
                        return true
                    }
                }
                cur = (*list).tail
            }
        }
    }
    false
}

fn spec_dce_count_item_fns(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var cur = items
    var going = true
    while going {
        match cur {
            None => { going = false }
            Some(list) => {
                if (*list).head.kind == ItemKind::ItemFn {
                    n = n + 1
                }
                cur = (*list).tail
            }
        }
    }
    n
}

// Drop top-level ItemFns whose name hash is not in `marks`. Keep every
// non-fn item (and keep order of survivors).
fn spec_dce_filter_items(
    items: Option<Box<ItemList>>,
    marks: &[i64; 16384],
    mark_count: i64
) -> Option<Box<ItemList>> with Mut, Alloc, Panic, Div {
    match items {
        None => None
        Some(list) => {
            let it = (*list).head
            let rest = spec_dce_filter_items((*list).tail, marks, mark_count)
            if it.kind == ItemKind::ItemFn {
                // A MODULE-LEVEL GLOBAL IS ALSO AN ItemFn. parse_global_var_item
                // and parse_global_let_item (parser/items.sio:1394, :1338) both
                // build `kind: ItemKind::ItemFn` with `fn_def: None` -- there is
                // no ItemVar in the enum. Lowering then gives each one an
                // IrFunction slot with compile_strategy = IR_STRATEGY_BSS_GLOBAL,
                // carrying its BSS offset and size (ir/lower.sio:1609).
                //
                // Nothing CALLS a global -- globals are read, not called -- so no
                // reachability scan rooted at `main` can ever mark one, and
                // filtering by marks alone deletes the program's BSS slots.
                //
                // Measured 2026-08-06, before this guard, on the ordinary
                // multi-module path:
                //
                //   var G: [i64; 4]                    merged 4 -> 3, and
                //   fn main() { print_int(G[0]) ... }  the binary printed NOTHING
                //
                // No crash and no diagnostic: bss_total_size is accumulated as
                // the slots are lowered, so dropping one shifts every global
                // after it and the program reads someone else's storage. A
                // struct-typed global then segfaults outright. Confirmed by
                // A/B against SOUNIO_DISABLE_MM_DCE=1 on the same binary.
                //
                // `fn_def: None` is the discriminator, and it is the RIGHT one:
                // a real function always carries a body here, and the other
                // fn_def-less ItemFns the parser builds are error-recovery
                // stubs, which are harmless to keep and dangerous to guess at.
                match it.fn_def {
                    None => return Some(Box::new(ItemList { head: it, tail: rest }))
                    Some(_) => {}
                }
                let h = ast_name_hash(it.name)
                if spec_dce_hash_find(marks, mark_count, h) {
                    return Some(Box::new(ItemList { head: it, tail: rest }))
                }
                return rest
            }
            Some(Box::new(ItemList { head: it, tail: rest }))
        }
    }
}

// Public entry: reachability-DCE unused top-level ItemFns from a specialized
// (or otherwise merged) item list, rooted at `main`. No-op when main is
// missing (caller keeps the list for hollow-main fallback paths).
// ---------------------------------------------------------------------------
// Cross-module reachability DCE for the ORDINARY multi-module path.
//
// spec_dce_unreachable_item_fns below only runs on the specialized-collapse
// path (module_frontend_specialized_prepare returns early when there are no
// monomorphisation markers), so a program with no generics gets no pruning at
// all. Measured 2026-08-05: compiling self-hosted/compiler/main.sio loads 120
// modules, typechecks clean, lowers, and then dies in the merge —
// "too many functions: shared IR module capacity exceeded (max 8191 slots)" —
// with 10705 declared functions, of which a reachability census from `main`
// says 5997 are live. The pruning that would have fitted it already exists and
// was simply never asked to run here.
//
// MARKS LIVE IN GLOBALS, and that is not a style choice. Filtering in place
// would mean `(*programs)[k].items = filtered`, a nested field-in-array store
// through `&!` — the shape module_frontend.sio's own comments record as
// dropped by lean_single ("Handoff MUST NOT rely on nested field-in-array
// store"). So the marks are computed once into globals and the caller filters
// at its two READ sites, where the result is an ordinary local.
var SPEC_DCE_G_MARKS: [i64; 16384]
var SPEC_DCE_G_COUNT: i64 = 0
var SPEC_DCE_G_READY: i64 = 0

// Memoised for the same reason as every other read_env in this file: the
// runtime allocator never reclaims, so a call per invocation is a per-compile
// leak.
var SPEC_DCE_MM_OFF: i64 = 0
var SPEC_DCE_MM_OFF_CHECKED: i64 = 0

fn spec_dce_mm_disabled() -> bool with IO, Mut, Panic, Div {
    if SPEC_DCE_MM_OFF_CHECKED == 0 {
        SPEC_DCE_MM_OFF_CHECKED = 1
        if str_eq(read_env("SOUNIO_DISABLE_MM_DCE"), "1") {
            SPEC_DCE_MM_OFF = 1
        }
    }
    SPEC_DCE_MM_OFF == 1
}

// Compute the live set across every loaded program. Returns the mark count, 0
// if there is no `main` to root from, or -1 if the mark set could not be
// completed — in which case the caller must NOT filter.
pub fn spec_dce_mark_across_programs(
    programs: &! [Program; 256],
    loaded: i64
) -> i64 with IO, Mut, Panic, Div, Alloc {
    SPEC_DCE_G_READY = 0
    SPEC_DCE_G_COUNT = 0

    // SOUNIO_DISABLE_MM_DCE=1 forces the refusal path. Two reasons it exists.
    //
    // First, it is the only cheap way to attribute a miscompile to this pass. A
    // Madaros built before cross-module DCE ran on the ordinary path and one
    // built after are ~100 MB binaries from tree states that cannot be diffed,
    // so "did the DCE do this?" otherwise costs a 40-minute rebuild per guess.
    //
    // Second, this pass deletes by SOURCE-LEVEL reachability, and lowering
    // emits calls that no source-level scan can see. Measured 2026-08-06 on a
    // 5-function program with a struct-typed global: 9 merged functions before,
    // 7 after, and the emitted binary SILENTLY SKIPS `print_int(G.len)` -- no
    // crash, no diagnostic, a statement that simply does not execute. The
    // filter's own contract ("returns its input unchanged unless a COMPLETE
    // mark set is ready") was honoured: the mark set was complete for the AST
    // and still wrong for the program.
    //
    // Until the seed set covers what lowering synthesises, this knob is the
    // difference between a suspected miscompile and a demonstrated one.
    if spec_dce_mm_disabled() {
        return 0 - 1
    }

    var z: i64 = 0
    while z < SPEC_DCE_SLOTS {
        SPEC_DCE_G_MARKS[z as usize] = 0
        z = z + 1
    }

    var has_main = false
    var i: i64 = 0
    while i < loaded && i < 256 {
        if spec_dce_has_main((*programs)[i as usize].items) {
            has_main = true
        }
        i = i + 1
    }
    if !has_main {
        return 0
    }

    var count: i64 = 0
    let main_h = ast_name_hash(make_name("main"))
    var _seeded = spec_dce_hash_insert(&! SPEC_DCE_G_MARKS, &! count, main_h)

    // Fixed point over ALL programs at once: a callee in module B reached from
    // a body in module A must extend the same mark set, which is the whole
    // reason this cannot be done per module.
    var fuel: i64 = 0
    var going = true
    while going {
        var changed = false
        var m: i64 = 0
        while m < loaded && m < 256 {
            if spec_dce_scan_list_if_marked((*programs)[m as usize].items, &! SPEC_DCE_G_MARKS, &! count) {
                changed = true
            }
            m = m + 1
        }
        fuel = fuel + 1
        if !changed || fuel > SPEC_DCE_MAX_ROUNDS {
            going = false
        }
    }

    // Same refusal as the single-list entry point, and for the same reason: a
    // saturated table and a converged one look identical from inside the loop,
    // so the test is on capacity. Filtering against an incomplete mark set
    // deletes reachable code.
    if count >= SPEC_DCE_MAX || fuel > SPEC_DCE_MAX_ROUNDS {
        print("spec_dce_mm: REFUSING to filter — mark set incomplete (marks ")
        print_int(count)
        print(" of ")
        print_int(SPEC_DCE_MAX)
        print(", rounds ")
        print_int(fuel)
        print(")\n")
        return 0 - 1
    }

    SPEC_DCE_G_COUNT = count
    SPEC_DCE_G_READY = 1
    count
}

// Filter one module's items against the marks computed above. Returns the input
// unchanged unless a complete mark set is ready, so a refusal upstream cannot
// silently become a deletion here.
pub fn spec_dce_filter_with_global_marks(
    items: Option<Box<ItemList>>
) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    if SPEC_DCE_G_READY != 1 {
        return items
    }
    spec_dce_filter_items(items, &SPEC_DCE_G_MARKS, SPEC_DCE_G_COUNT)
}

pub fn spec_dce_global_marks_ready() -> bool {
    SPEC_DCE_G_READY == 1
}

// How many top-level fns survive in `items` under the current marks. Lets the
// caller's capacity preflight count what will ACTUALLY be lowered rather than
// what was parsed.
pub fn spec_dce_live_item_fns(items: Option<Box<ItemList>>) -> i64 with IO, Mut, Panic, Div, Alloc {
    if SPEC_DCE_G_READY != 1 {
        return spec_dce_count_item_fns(items)
    }
    spec_dce_count_item_fns(spec_dce_filter_items(items, &SPEC_DCE_G_MARKS, SPEC_DCE_G_COUNT))
}

pub fn spec_dce_unreachable_item_fns(
    items: Option<Box<ItemList>>
) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    if !spec_dce_has_main(items) {
        return items
    }
    var marks: [i64; 16384] = [0; 16384]
    var mark_count: i64 = 0
    let main_h = ast_name_hash(make_name("main"))
    var _seeded = spec_dce_hash_insert(&! marks, &! mark_count, main_h)

    // Fixed-point: scan bodies of marked callables, extend mark set.
    //
    // `changed` is only trustworthy while the table can still accept marks.
    // When it cannot, `changed` is false for a reason that has nothing to do
    // with convergence, so the round count alone must not be read as "done" —
    // that is checked separately below, against mark_count, not against this
    // loop's exit.
    var fuel: i64 = 0
    var going = true
    while going {
        let changed = spec_dce_scan_list_if_marked(items, &! marks, &! mark_count)
        fuel = fuel + 1
        if !changed || fuel > SPEC_DCE_MAX_ROUNDS {
            going = false
        }
    }

    // REFUSE RATHER THAN DELETE. Filtering is only sound if the mark set is
    // complete, and it is complete only if nothing was ever turned away. A
    // saturated table and a converged one are indistinguishable from the loop
    // above, so the test is on capacity: at the limit, hand back the input
    // untouched. The cost of refusing is a larger IrModule; the cost of
    // filtering against a truncated mark set is a compiler with live functions
    // missing, which is what this pass did before.
    //
    // Rounds are checked too, for the same reason: exhausting them means the
    // reachable set was still growing when the loop stopped.
    if mark_count >= SPEC_DCE_MAX || fuel > SPEC_DCE_MAX_ROUNDS {
        print("spec_dce: REFUSING to filter — the mark set is not complete (marks ")
        print_int(mark_count)
        print(" of ")
        print_int(SPEC_DCE_MAX)
        print(", rounds ")
        print_int(fuel)
        print(" of ")
        print_int(SPEC_DCE_MAX_ROUNDS)
        print("). Every top-level fn is kept; the module will be larger than it needs to be.\n")
        return items
    }

    let before_fns = spec_dce_count_item_fns(items)
    let out = spec_dce_filter_items(items, &marks, mark_count)
    let after_fns = spec_dce_count_item_fns(out)
    if str_eq(read_env("SOUNIO_MM_SPEC_TRACE"), "1") {
        print("spec_dce: item_fns ")
        print_int(before_fns)
        print(" -> ")
        print_int(after_fns)
        print(" marks=")
        print_int(mark_count)
        print("\n")
    }
    out
}
