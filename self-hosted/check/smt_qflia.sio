// QF_LIA SMT solver — Fourier-Motzkin elimination
//
// Sits between the static refinement proof engine (refinement.sio) and
// runtime assertion fallback.  When static analysis returns UNKNOWN,
// this solver attempts Fourier-Motzkin variable elimination over the
// system of linear integer inequalities derived from the predicate.
//
// Implementation notes:
//   The JIT has a known bug where writing a struct value to an array-of-struct
//   slot via &! corrupts slot 0.  To work around this, all constraint state
//   is stored in parallel global i64 arrays (flat, no nested structs).
//
//   Constraint i, variable slot j is stored at flat index i*8 + j.
//   Maximum 32 constraints × 8 variables = 256 slots.
//
// Canonical form:  sum(FM_COEFFS[i*8+j] * FM_VARIDS[i*8+j]) + FM_CONSTS[i] ≤ 0
//                  FM_STRICT[i] == 1 means strict (<)
//
// Predicate op constants (match refinement.sio):
//   0=None, 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq

// ── Result codes ───────────────────────────────────────────────────────────────
fn fm_result_unknown() -> i64 { 0 }
fn fm_result_sat()     -> i64 { 1 }
fn fm_result_unsat()   -> i64 { 2 }

// ── Predicate op tags ──────────────────────────────────────────────────────────
fn fm_op_gt()    -> i64 { 1 }
fn fm_op_gt_eq() -> i64 { 2 }
fn fm_op_lt()    -> i64 { 3 }
fn fm_op_lt_eq() -> i64 { 4 }
fn fm_op_eq()    -> i64 { 5 }
fn fm_op_neq()   -> i64 { 6 }

// ── Global constraint store (one active system at a time) ─────────────────────
// Flat layout: constraint i, variable slot j → index i*8 + j
var FM_COEFFS: [i64; 256] = [0; 256]
var FM_VARIDS: [i64; 256] = [0; 256]   // 0 = empty (var_id -1 used as sentinel)
var FM_NVARS:  [i64; 32]  = [0; 32]
var FM_CONSTS: [i64; 32]  = [0; 32]
var FM_STRICT: [i64; 32]  = [0; 32]
var FM_NINEQS: i64         = 0

// Temp constraint store for FM elimination (second buffer)
var FM2_COEFFS: [i64; 256] = [0; 256]
var FM2_VARIDS: [i64; 256] = [0; 256]
var FM2_NVARS:  [i64; 32]  = [0; 32]
var FM2_CONSTS: [i64; 32]  = [0; 32]
var FM2_STRICT: [i64; 32]  = [0; 32]
var FM2_NINEQS: i64         = 0

// Sentinel for "no variable": use -1 encoded as a constant 0 in VARIDS
// We encode var_id+1 in FM_VARIDS to allow var_id=0 to be distinguished from
// "empty slot".  Empty = 0.  Occupied var_id k → stored as k+1.

// ── System reset ──────────────────────────────────────────────────────────────

fn fm_reset() with Mut {
    var i: i64 = 0
    while i < 256 {
        FM_COEFFS[i as usize] = 0
        FM_VARIDS[i as usize] = 0
        i = i + 1
    }
    i = 0
    while i < 32 {
        FM_NVARS[i as usize]  = 0
        FM_CONSTS[i as usize] = 0
        FM_STRICT[i as usize] = 0
        i = i + 1
    }
    FM_NINEQS = 0
}

fn fm2_reset() with Mut {
    var i: i64 = 0
    while i < 256 {
        FM2_COEFFS[i as usize] = 0
        FM2_VARIDS[i as usize] = 0
        i = i + 1
    }
    i = 0
    while i < 32 {
        FM2_NVARS[i as usize]  = 0
        FM2_CONSTS[i as usize] = 0
        FM2_STRICT[i as usize] = 0
        i = i + 1
    }
    FM2_NINEQS = 0
}

// ── Constraint accessors ──────────────────────────────────────────────────────

// Get coefficient of var_id in constraint row (from primary store)
fn fm_coeff(row: i64, var_id: i64) -> i64 {
    let nvars = FM_NVARS[row as usize]
    var j: i64 = 0
    while j < nvars {
        let stored_vid = FM_VARIDS[(row * 8 + j) as usize]
        // stored as var_id+1; 0 = empty
        if stored_vid == var_id + 1 {
            return FM_COEFFS[(row * 8 + j) as usize]
        }
        j = j + 1
    }
    0
}

// ── Add constraint to primary store ───────────────────────────────────────────

fn fm_add_ineq(nvars: i64, varids_0: i64, coeffs_0: i64,
               varids_1: i64, coeffs_1: i64,
               constant: i64, is_strict: i64) with Mut {
    if FM_NINEQS >= 32 { return }
    let row = FM_NINEQS as usize
    FM_NVARS[row]  = nvars
    FM_CONSTS[row] = constant
    FM_STRICT[row] = is_strict
    FM_COEFFS[row * 8 + 0] = coeffs_0
    FM_VARIDS[row * 8 + 0] = if nvars > 0 { varids_0 + 1 } else { 0 }
    FM_COEFFS[row * 8 + 1] = coeffs_1
    FM_VARIDS[row * 8 + 1] = if nvars > 1 { varids_1 + 1 } else { 0 }
    FM_NINEQS = FM_NINEQS + 1
}

// ── Parse predicate into primary store ────────────────────────────────────────
//
// Converts "var_id op constant" into canonical inequality:
//   var_id > c   →  -var - c < 0    (coeff=-1, const=-c, strict=1)
//   var_id >= c  →  -var - c ≤ 0    (coeff=-1, const=-c, strict=0)
//   var_id < c   →   var - c < 0    (coeff=+1, const=-c, strict=1)
//   var_id <= c  →   var - c ≤ 0    (coeff=+1, const=-c, strict=0)
//   var_id == c  →  both >= and <=
//
// Wait — let me be careful. Canonical form is:  coeff*var + const ≤ 0
//   var > c   ⟺  c - var < 0   ⟺  -var + c < 0   coeff=-1, const=c, strict
//   var >= c  ⟺  c - var ≤ 0   ⟺  -var + c ≤ 0   coeff=-1, const=c
//   var < c   ⟺  var - c < 0               coeff=+1, const=-c, strict
//   var <= c  ⟺  var - c ≤ 0               coeff=+1, const=-c

fn fm_parse_pred(var_id: i64, op: i64, constant: i64) with Mut {
    if op == fm_op_gt() {
        fm_add_ineq(1, var_id, -1, 0, 0, constant, 1)
    } else if op == fm_op_gt_eq() {
        fm_add_ineq(1, var_id, -1, 0, 0, constant, 0)
    } else if op == fm_op_lt() {
        fm_add_ineq(1, var_id, 1, 0, 0, 0 - constant, 1)
    } else if op == fm_op_lt_eq() {
        fm_add_ineq(1, var_id, 1, 0, 0, 0 - constant, 0)
    } else if op == fm_op_eq() {
        fm_add_ineq(1, var_id, -1, 0, 0, constant, 0)
        fm_add_ineq(1, var_id,  1, 0, 0, 0 - constant, 0)
    }
    // fm_op_neq: not representable in FM — skip
}

// Add a two-variable constraint: coeff_a*var_a + coeff_b*var_b + constant ≤ 0
fn fm_parse_binvar(var_a: i64, coeff_a: i64, var_b: i64, coeff_b: i64,
                   constant: i64, is_strict: i64) with Mut {
    fm_add_ineq(2, var_a, coeff_a, var_b, coeff_b, constant, is_strict)
}

// ── Variable collection ───────────────────────────────────────────────────────

var FM_VARLIST:  [i64; 8] = [0; 8]
var FM_VARCOUNT: i64 = 0

fn fm_collect_vars() with Mut {
    FM_VARCOUNT = 0
    var i: i64 = 0
    while i < FM_NINEQS {
        let nvars = FM_NVARS[i as usize]
        var j: i64 = 0
        while j < nvars {
            let stored = FM_VARIDS[(i * 8 + j) as usize]
            if stored > 0 {
                let vid = stored - 1
                var found = false
                var k: i64 = 0
                while k < FM_VARCOUNT {
                    if FM_VARLIST[k as usize] == vid { found = true }
                    k = k + 1
                }
                if !found && FM_VARCOUNT < 8 {
                    FM_VARLIST[FM_VARCOUNT as usize] = vid
                    FM_VARCOUNT = FM_VARCOUNT + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

// ── Check if ground constraint is a contradiction ─────────────────────────────
// Ground = nvars == 0.  Contradiction:
//   non-strict: constant > 0
//   strict:     constant >= 0

fn fm_is_ground_contradiction(row: i64) -> bool {
    if FM_NVARS[row as usize] != 0 { return false }
    let c = FM_CONSTS[row as usize]
    let s = FM_STRICT[row as usize]
    if s == 1 { return c >= 0 }
    c > 0
}

// ── Fourier-Motzkin elimination of one variable ───────────────────────────────
// Eliminates var_id from the primary store (FM_*).
// Builds result in FM2_* then copies back.
// Returns fm_result_unsat() if contradiction, fm_result_unknown() otherwise.

fn fm_eliminate(var_id: i64) -> i64 with Mut {
    // Partition rows by sign of coefficient on var_id
    var pos_rows: [i64; 32] = [0; 32]; var npos: i64 = 0
    var neg_rows: [i64; 32] = [0; 32]; var nneg: i64 = 0
    var zer_rows: [i64; 32] = [0; 32]; var nzer: i64 = 0

    var i: i64 = 0
    while i < FM_NINEQS {
        let c = fm_coeff(i, var_id)
        if c > 0 {
            pos_rows[npos as usize] = i; npos = npos + 1
        } else if c < 0 {
            neg_rows[nneg as usize] = i; nneg = nneg + 1
        } else {
            zer_rows[nzer as usize] = i; nzer = nzer + 1
        }
        i = i + 1
    }

    fm2_reset()

    // Copy zero-coefficient rows to FM2
    var z: i64 = 0
    while z < nzer {
        let ri = zer_rows[z as usize]
        let dst = FM2_NINEQS as usize
        FM2_NVARS[dst]  = FM_NVARS[ri as usize]
        FM2_CONSTS[dst] = FM_CONSTS[ri as usize]
        FM2_STRICT[dst] = FM_STRICT[ri as usize]
        var j: i64 = 0
        while j < FM_NVARS[ri as usize] {
            FM2_COEFFS[dst * 8 + j as usize] = FM_COEFFS[ri * 8 + j as usize]
            FM2_VARIDS[dst * 8 + j as usize] = FM_VARIDS[ri * 8 + j as usize]
            j = j + 1
        }
        FM2_NINEQS = FM2_NINEQS + 1
        z = z + 1
    }

    // Pairwise FM derivation
    var pi: i64 = 0
    while pi < npos {
        let pr = pos_rows[pi as usize]
        let cp = fm_coeff(pr, var_id)   // > 0
        var ni: i64 = 0
        while ni < nneg {
            let nr = neg_rows[ni as usize]
            let cn = fm_coeff(nr, var_id)   // < 0
            let abs_cn = 0 - cn

            // Derived: abs_cn * row_pr + cp * row_nr  (var_id cancels)
            let new_const  = abs_cn * FM_CONSTS[pr as usize] + cp * FM_CONSTS[nr as usize]
            let new_strict = if FM_STRICT[pr as usize] == 1 || FM_STRICT[nr as usize] == 1 { 1 } else { 0 }

            // Collect non-var_id variables (up to 8 slots)
            var dv_varids: [i64; 8] = [0; 8]
            var dv_coeffs: [i64; 8] = [0; 8]
            var dv_n: i64 = 0

            // From pos row (scaled by abs_cn)
            var ti: i64 = 0
            while ti < FM_NVARS[pr as usize] {
                let vid_s = FM_VARIDS[(pr * 8 + ti) as usize]
                let vid   = vid_s - 1     // decode
                let cef   = FM_COEFFS[(pr * 8 + ti) as usize]
                if vid_s > 0 && vid != var_id && dv_n < 8 {
                    dv_varids[dv_n as usize] = vid_s  // keep encoded
                    dv_coeffs[dv_n as usize] = abs_cn * cef
                    dv_n = dv_n + 1
                }
                ti = ti + 1
            }

            // From neg row (scaled by cp), merge or append
            var ti2: i64 = 0
            while ti2 < FM_NVARS[nr as usize] {
                let vid_s = FM_VARIDS[(nr * 8 + ti2) as usize]
                let vid   = vid_s - 1
                let cef   = FM_COEFFS[(nr * 8 + ti2) as usize]
                if vid_s > 0 && vid != var_id {
                    var found_at: i64 = -1
                    var si: i64 = 0
                    while si < dv_n {
                        if dv_varids[si as usize] == vid_s { found_at = si }
                        si = si + 1
                    }
                    if found_at >= 0 {
                        dv_coeffs[found_at as usize] = dv_coeffs[found_at as usize] + cp * cef
                    } else if dv_n < 8 {
                        dv_varids[dv_n as usize] = vid_s
                        dv_coeffs[dv_n as usize] = cp * cef
                        dv_n = dv_n + 1
                    }
                }
                ti2 = ti2 + 1
            }

            // Count active (nonzero-coefficient) variables
            var active: i64 = 0
            var ai: i64 = 0
            while ai < dv_n {
                if dv_coeffs[ai as usize] != 0 { active = active + 1 }
                ai = ai + 1
            }

            if active == 0 {
                // Ground constraint — check immediately
                let contradiction = if new_strict == 1 { new_const >= 0 } else { new_const > 0 }
                if contradiction {
                    // Copy FM2 back to FM and return UNSAT
                    FM_NINEQS = FM2_NINEQS
                    var ci: i64 = 0
                    while ci < FM2_NINEQS {
                        FM_NVARS[ci as usize]  = FM2_NVARS[ci as usize]
                        FM_CONSTS[ci as usize] = FM2_CONSTS[ci as usize]
                        FM_STRICT[ci as usize] = FM2_STRICT[ci as usize]
                        var cj: i64 = 0
                        while cj < FM2_NVARS[ci as usize] {
                            FM_COEFFS[(ci * 8 + cj) as usize] = FM2_COEFFS[(ci * 8 + cj) as usize]
                            FM_VARIDS[(ci * 8 + cj) as usize] = FM2_VARIDS[(ci * 8 + cj) as usize]
                            cj = cj + 1
                        }
                        ci = ci + 1
                    }
                    return fm_result_unsat()
                }
                // Trivially satisfied — drop
            } else {
                // Add to FM2
                if FM2_NINEQS < 32 {
                    let dst = FM2_NINEQS as usize
                    FM2_NVARS[dst]  = active
                    FM2_CONSTS[dst] = new_const
                    FM2_STRICT[dst] = new_strict
                    var si2: i64 = 0; var slot2: i64 = 0
                    while si2 < dv_n {
                        if dv_coeffs[si2 as usize] != 0 && slot2 < 8 {
                            FM2_COEFFS[dst * 8 + slot2 as usize] = dv_coeffs[si2 as usize]
                            FM2_VARIDS[dst * 8 + slot2 as usize] = dv_varids[si2 as usize]
                            slot2 = slot2 + 1
                        }
                        si2 = si2 + 1
                    }
                    FM2_NINEQS = FM2_NINEQS + 1
                }
            }

            ni = ni + 1
        }
        pi = pi + 1
    }

    // Copy FM2 back to FM
    FM_NINEQS = FM2_NINEQS
    var ci: i64 = 0
    while ci < FM2_NINEQS {
        FM_NVARS[ci as usize]  = FM2_NVARS[ci as usize]
        FM_CONSTS[ci as usize] = FM2_CONSTS[ci as usize]
        FM_STRICT[ci as usize] = FM2_STRICT[ci as usize]
        var cj: i64 = 0
        while cj < FM2_NVARS[ci as usize] {
            FM_COEFFS[(ci * 8 + cj) as usize] = FM2_COEFFS[(ci * 8 + cj) as usize]
            FM_VARIDS[(ci * 8 + cj) as usize] = FM2_VARIDS[(ci * 8 + cj) as usize]
            cj = cj + 1
        }
        ci = ci + 1
    }
    fm_result_unknown()
}

// ── Top-level satisfiability check ───────────────────────────────────────────
// Call fm_reset() and fm_parse_pred()/fm_parse_binvar() first.
// Modifies the global FM_* arrays.

fn fm_check_sat() -> i64 with Mut {
    if FM_NINEQS == 0 { return fm_result_sat() }

    fm_collect_vars()

    if FM_VARCOUNT == 0 {
        var i: i64 = 0
        while i < FM_NINEQS {
            if fm_is_ground_contradiction(i) { return fm_result_unsat() }
            i = i + 1
        }
        return fm_result_sat()
    }

    var vi: i64 = 0
    while vi < FM_VARCOUNT {
        let vid = FM_VARLIST[vi as usize]
        let r = fm_eliminate(vid)
        if r == fm_result_unsat() { return fm_result_unsat() }
        vi = vi + 1
    }

    // Final ground-constraint check
    var i: i64 = 0
    while i < FM_NINEQS {
        if fm_is_ground_contradiction(i) { return fm_result_unsat() }
        i = i + 1
    }
    fm_result_sat()
}
