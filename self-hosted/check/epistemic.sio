pub fn check_validated_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_validated(inner_ty, eps_val)
    (c, ty)
}

pub fn knowledge_validity_expr_non_negative(opt: Option<Box<Expr>>) -> bool {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                return (*e).int_val >= 0
            }
            if (*e).kind == ExprKind::ExprFloatLit {
                return (*e).float_val >= 0.0
            }
            true
        }
        None => false
    }
}

pub fn knowledge_metadata_is_valid(validity_opt: Option<Box<ValidityCondition>>) -> bool {
    match validity_opt {
        Some(vc) => knowledge_validity_expr_non_negative((*vc).expr)
        None => true
    }
}

pub fn validity_from_ast(opt: Option<Box<ValidityCondition>>) -> Validity {
    match opt {
        Some(vc) => {
            let value = if knowledge_validity_expr_non_negative((*vc).expr) {
                knowledge_validity_expr_to_f64((*vc).expr)
            } else {
                0.0
            }
            if (*vc).kind == AstValidityKind::ValidDuration {
                return validity_duration(value)
            }
            if (*vc).kind == AstValidityKind::ValidUntilTime {
                return validity_until(value)
            }
            if (*vc).kind == AstValidityKind::ValidWhileCond {
                return validity_while()
            }
            validity_always()
        }
        None => validity_always()
    }
}

pub fn knowledge_validity_expr_to_f64(opt: Option<Box<Expr>>) -> f64 {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                (*e).int_val as f64
            } else if (*e).kind == ExprKind::ExprFloatLit {
                (*e).float_val
            } else {
                0.0
            }
        }
        None => 0.0
    }
}

// ============================================================
// Provenance tracking
// ============================================================

// Classification of knowledge sources for audit trails
// and trust boundary tracking. Stored as integer tags to avoid
// depending on local-enum variant resolution in checker fragments.
const PROVENANCE_KIND_DERIVED: i64 = 0
const PROVENANCE_KIND_SOURCE: i64 = 1
const PROVENANCE_KIND_COMPUTED: i64 = 2
const PROVENANCE_KIND_LITERATURE: i64 = 3
const PROVENANCE_KIND_MEASURED: i64 = 4
const PROVENANCE_KIND_INPUT: i64 = 5

// Provenance metadata tracking source and lineage
pub struct Provenance {
    kind: i64,
    source_id: i64
}

// Construct provenance with a specific kind
// source_id is initialized to 0 (unknown)
pub fn provenance_new(kind: i64) -> Provenance {
    Provenance {
        kind: kind,
        source_id: 0
    }
}

// Construct provenance with explicit source identifier
pub fn provenance_with_source(kind: i64, source_id: i64) -> Provenance {
    Provenance {
        kind: kind,
        source_id: source_id
    }
}

pub fn provenance_from_ast(opt: Option<Box<AstProvenanceKind>>) -> Provenance {
    match opt {
        Some(p) => {
            if *p == AstProvenanceKind::AstProvSource {
                return provenance_new(PROVENANCE_KIND_SOURCE)
            }
            if *p == AstProvenanceKind::AstProvComputed {
                return provenance_new(PROVENANCE_KIND_COMPUTED)
            }
            if *p == AstProvenanceKind::AstProvLiterature {
                return provenance_new(PROVENANCE_KIND_LITERATURE)
            }
            if *p == AstProvenanceKind::AstProvMeasured {
                return provenance_new(PROVENANCE_KIND_MEASURED)
            }
            if *p == AstProvenanceKind::AstProvInput {
                return provenance_new(PROVENANCE_KIND_INPUT)
            }
            provenance_new(PROVENANCE_KIND_DERIVED)
        }
        None => provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

pub fn knowledge_meta_from_type_info(info: KnowledgeTypeInfo) -> KnowledgeMeta {
    let base_eps = match info.epsilon {
        Some(eb) => (*eb).value
        None => -1.0
    }
    knowledge_meta_full(base_eps, validity_from_ast(info.validity), provenance_from_ast(info.provenance))
}

// ============================================================
// Knowledge type queries
// ============================================================

pub fn is_knowledge_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge
}

pub fn is_intervention_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyIntervention
}

pub fn is_counterfactual_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyCounterfactual
}

pub fn is_validated_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyValidated
}

pub fn is_epistemic_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge || ty.kind == TypeKind::TyIntervention || ty.kind == TypeKind::TyCounterfactual || ty.kind == TypeKind::TyValidated
}

pub fn knowledge_inner(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    match ty.inner {
        Some(inner_box) => *inner_box
        None => ty_error()
    }
}

pub fn check_knowledge_unwrap(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if is_knowledge_type(ty) {
        knowledge_inner(ty)
    } else {
        ty_error()
    }
}

pub fn check_knowledge_epsilon(ty: TypeEntry) -> TypeEntry {
    // .epsilon field access on Knowledge<T> returns f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

pub fn check_knowledge_epsilon_of(ty: TypeEntry) -> TypeEntry {
    // epsilonOf(k) returns the epsilon bound as f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

// Check if provenance is from a trusted source
pub fn provenance_is_trusted(prov: Provenance) -> bool {
    match prov.kind {
        PROVENANCE_KIND_SOURCE => true,
        PROVENANCE_KIND_LITERATURE => true,
        PROVENANCE_KIND_MEASURED => true,
        PROVENANCE_KIND_DERIVED => false,
        PROVENANCE_KIND_COMPUTED => false,
        PROVENANCE_KIND_INPUT => false
    }
}

// Get string representation of provenance kind
pub fn provenance_kind_name(kind: i64) -> string with Alloc {
    match kind {
        PROVENANCE_KIND_DERIVED => "derived",
        PROVENANCE_KIND_SOURCE => "source",
        PROVENANCE_KIND_COMPUTED => "computed",
        PROVENANCE_KIND_LITERATURE => "literature",
        PROVENANCE_KIND_MEASURED => "measured",
        PROVENANCE_KIND_INPUT => "input"
    }
}

// Check if provenance kind requires verification
pub fn provenance_kind_needs_verification(kind: i64) -> bool {
    match kind {
        PROVENANCE_KIND_INPUT => true,
        PROVENANCE_KIND_MEASURED => true,
        PROVENANCE_KIND_DERIVED => false,
        PROVENANCE_KIND_SOURCE => false,
        PROVENANCE_KIND_COMPUTED => false,
        PROVENANCE_KIND_LITERATURE => false
    }
}

// Compare two provenance entries for equality
pub fn provenance_eq(a: Provenance, b: Provenance) -> bool {
    a.kind == b.kind && a.source_id == b.source_id
}

// ============================================================
// Validity conditions (lines 151-220)
// ============================================================

// Classification of validity conditions for knowledge
// Determines when knowledge remains valid/usable
const VALIDITY_KIND_ALWAYS: i64 = 0
const VALIDITY_KIND_DURATION: i64 = 1
const VALIDITY_KIND_UNTIL_TIME: i64 = 2
const VALIDITY_KIND_WHILE_COND: i64 = 3

// Validity metadata for knowledge temporal bounds
pub struct Validity {
    kind: i64,
    duration_sec: f64,
    until_timestamp: f64
}

// Create always-valid validity (no expiration)
pub fn validity_always() -> Validity {
    Validity {
        kind: VALIDITY_KIND_ALWAYS,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Create duration-based validity
pub fn validity_duration(seconds: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_DURATION,
        duration_sec: seconds,
        until_timestamp: 0.0
    }
}

// Create timestamp-based validity (valid until specific time)
pub fn validity_until(timestamp: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_UNTIL_TIME,
        duration_sec: 0.0,
        until_timestamp: timestamp
    }
}

// Create condition-based validity
pub fn validity_while() -> Validity {
    Validity {
        kind: VALIDITY_KIND_WHILE_COND,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Check if validity has expired based on current time
pub fn validity_is_expired(validity: Validity, current_time: f64) -> bool {
    match validity.kind {
        VALIDITY_KIND_ALWAYS => false,
        VALIDITY_KIND_DURATION => false,  // Need creation time to check
        VALIDITY_KIND_UNTIL_TIME => current_time > validity.until_timestamp,
        VALIDITY_KIND_WHILE_COND => false  // Condition checked at runtime
    }
}

// Get a conservative validity that combines two validity constraints
pub fn validity_intersect(a: Validity, b: Validity) -> Validity {
    // The intersection is the more restrictive of the two
    match a.kind {
        VALIDITY_KIND_ALWAYS => b,
        VALIDITY_KIND_DURATION => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_DURATION => {
                    if a.duration_sec < b.duration_sec { a } else { b }
                }
                VALIDITY_KIND_UNTIL_TIME => b,
                VALIDITY_KIND_WHILE_COND => b
            }
        }
        VALIDITY_KIND_UNTIL_TIME => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_UNTIL_TIME => {
                    if a.until_timestamp < b.until_timestamp { a } else { b }
                }
                _ => a
            }
        }
        VALIDITY_KIND_WHILE_COND => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                _ => b
            }
        }
    }
}

// ============================================================
// Knowledge metadata (lines 221-300)
// ============================================================

// Combined metadata for Knowledge types including
// epsilon bound, validity conditions, and provenance
pub struct KnowledgeMeta {
    epsilon: f64,
    validity: Validity,
    provenance: Provenance
}

// Create default metadata with always-valid and unknown provenance
pub fn knowledge_meta_default(epsilon: f64) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

// Create metadata from type entry
// Extracts epsilon from Knowledge types, uses defaults otherwise
pub fn knowledge_meta_from_ty(ty: TypeEntry) -> KnowledgeMeta with Mut, Panic, Div, Alloc {
    match ty.kind {
        TypeKind::TyKnowledge => {
            let eps = ty.knowledge_epsilon
            KnowledgeMeta {
                epsilon: eps,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyIntervention => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyCounterfactual => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyValidated => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        _ => knowledge_meta_default(-1.0)
    }
}

// Create metadata with specified validity
pub fn knowledge_meta_with_validity(epsilon: f64, validity: Validity) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

// Create metadata with specified provenance
pub fn knowledge_meta_with_provenance(epsilon: f64, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance
    }
}

// Create fully specified metadata
pub fn knowledge_meta_full(epsilon: f64, validity: Validity, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance
    }
}

// Get epsilon from knowledge metadata
pub fn knowledge_meta_epsilon(meta: KnowledgeMeta) -> f64 {
    meta.epsilon
}

// Get validity from knowledge metadata
pub fn knowledge_meta_validity(meta: KnowledgeMeta) -> Validity {
    meta.validity
}

// Get provenance from knowledge metadata
pub fn knowledge_meta_provenance(meta: KnowledgeMeta) -> Provenance {
    meta.provenance
}

pub fn epsilon_is_valid(eps: f64) -> bool {
    eps >= 0.0 && eps <= 1.0
}

// Check if metadata represents valid knowledge
pub fn knowledge_meta_is_valid(meta: KnowledgeMeta) -> bool {
    meta.epsilon < 0.0 || epsilon_is_valid(meta.epsilon)
}

// ============================================================
// Confidence subsumption lattice (lines 301-380)
// ============================================================

// Confidence subsumption: lower epsilon = higher confidence
// epsilon_subsumes(eps_a, eps_b) returns true if a is at least as
// confident as b (eps_a <= eps_b)
//
// This defines a partial order where:
//   0.0 (certain) > 0.1 > 0.5 > 1.0 (unknown)
//
// Returns true if eps_a <= eps_b
pub fn epsilon_subsumes(eps_a: f64, eps_b: f64) -> bool {
    eps_a <= eps_b
}

// Function-call boundaries fail closed on unknown/invalid provided epsilon.
// Required epsilon < 0.0 means "unspecified requirement".
pub fn epsilon_subsumes_call_boundary(provided_eps: f64, required_eps: f64) -> bool {
    if !epsilon_is_valid(provided_eps) {
        return false
    }
    if required_eps < 0.0 {
        return true
    }
    if !epsilon_is_valid(required_eps) {
        return false
    }
    epsilon_subsumes(provided_eps, required_eps)
}

// Get the more confident (lower) epsilon
pub fn epsilon_meet(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a < eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Get the less confident (higher) epsilon
pub fn epsilon_join(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a > eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Check if two knowledge types are compatible
// Compatible if:
//   1. Inner types match (structural equality)
//   2. Epsilon subsumption holds (a is at least as confident as b)
//
// Returns true if ty_a can be used where ty_b is expected
pub fn knowledge_compatible(ty_a: TypeEntry, ty_b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    let inner_a = knowledge_inner(ty_a)
    let inner_b = knowledge_inner(ty_b)

    // Check inner types match
    let types_match = types_equal(inner_a, inner_b)
    if !types_match {
        false
    } else {
        // Check epsilon subsumption
        epsilon_subsumes(ty_a.knowledge_epsilon, ty_b.knowledge_epsilon)
    }
}

// Check type equality (structural)
pub fn types_equal(a: TypeEntry, b: TypeEntry) -> bool {
    if a.kind != b.kind {
        false
    } else {
        match (a.inner, b.inner) {
            (Some(inner_a), Some(inner_b)) => types_equal(*inner_a, *inner_b),
            (None, None) => true,
            _ => false
        }
    }
}

// Check if knowledge type meets epsilon requirement
pub fn knowledge_meets_epsilon(ty: TypeEntry, required_epsilon: f64) -> bool {
    if is_knowledge_type(ty) {
        epsilon_subsumes(ty.knowledge_epsilon, required_epsilon)
    } else {
        false
    }
}

// Subsumption for provenance
pub fn provenance_subsumes(provided: Provenance, required: Provenance) -> bool {
    // If caller requires a trusted source, callee argument must be trusted.
    if provenance_is_trusted(required) {
        provenance_is_trusted(provided)
    } else {
        true
    }
}

// Subsumption for validity
pub fn validity_subsumes(provided: Validity, required: Validity) -> bool {
    if required.kind == VALIDITY_KIND_ALWAYS {
        return provided.kind == VALIDITY_KIND_ALWAYS
    }
    if required.kind == VALIDITY_KIND_DURATION {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_DURATION {
            return provided.duration_sec >= required.duration_sec
        }
        return false
    }
    if required.kind == VALIDITY_KIND_UNTIL_TIME {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_UNTIL_TIME {
            return provided.until_timestamp >= required.until_timestamp
        }
        return false
    }
    if required.kind == VALIDITY_KIND_WHILE_COND {
        return provided.kind == VALIDITY_KIND_ALWAYS || provided.kind == VALIDITY_KIND_WHILE_COND
    }
    false
}

// ============================================================
// Epsilon propagation (lines 381-480)
// ============================================================

// Clamp epsilon to valid range [0.0, 1.0]
pub fn epsilon_clamp(eps: f64) -> f64 {
    if eps < 0.0 {
        0.0
    } else if eps > 1.0 {
        1.0
    } else {
        eps
    }
}

// Approximate sqrt for values in [0, 2] using one Newton iteration
// Initial guess: x/2 + 0.5, then refine: (guess + x/guess) / 2
pub fn sqrt_approx(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x * 0.5 + 0.5
    guess = (guess + x / guess) * 0.5
    epsilon_clamp(guess)
}

// Combine independent errors: sqrt(eps_a^2 + eps_b^2)
// Quadrature sum for independent random variables (standard error propagation)
// Clamped to [0.0, 1.0]
pub fn epsilon_combine_independent(eps_a: f64, eps_b: f64) -> f64 with Mut, Panic, Div {
    let sum_sq = eps_a * eps_a + eps_b * eps_b
    sqrt_approx(sum_sq)
}

// Combine correlated errors: eps_a + eps_b (linear sum, conservative)
// For perfectly correlated or unknown correlation, linear sum is the
// sound upper bound.
pub fn epsilon_combine_correlated(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine relative errors for multiplication/division
// Relative errors add: (da/a) + (db/b)
pub fn epsilon_combine_relative(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine errors with unknown correlation (most conservative)
// Defaults to linear sum — sound upper bound for any correlation rho in [0,1]
pub fn epsilon_combine_unknown(eps_a: f64, eps_b: f64) -> f64 {
    epsilon_combine_correlated(eps_a, eps_b)
}

// Weighted combination for weighted averages
pub fn epsilon_combine_weighted(eps_a: f64, eps_b: f64, weight_a: f64, weight_b: f64) -> f64 with Panic, Div {
    let weighted_sum = weight_a * eps_a + weight_b * eps_b
    let total_weight = weight_a + weight_b
    if total_weight == 0.0 {
        1.0
    } else {
        epsilon_clamp(weighted_sum / total_weight)
    }
}

// BinaryOp enum is defined in parser/ast.sio and shared via concatenation.
// When checking this file standalone, the pinned binary's resolver provides it.

// Compute result type for binary operations on Knowledge types
// Handles epsilon propagation according to operation semantics
pub fn knowledge_binary_result(op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    // If neither operand is Knowledge, return error
    let left_is_knowledge = is_knowledge_type(left_ty)
    let right_is_knowledge = is_knowledge_type(right_ty)

    if !left_is_knowledge && !right_is_knowledge {
        ty_error()
    } else {
        // Extract inner types and epsilons
        let left_inner = if left_is_knowledge {
            knowledge_inner(left_ty)
        } else {
            left_ty
        }
        let right_inner = if right_is_knowledge {
            knowledge_inner(right_ty)
        } else {
            right_ty
        }

        let left_eps = if left_is_knowledge {
            left_ty.knowledge_epsilon
        } else {
            0.0
        }
        let right_eps = if right_is_knowledge {
            right_ty.knowledge_epsilon
        } else {
            0.0
        }

        if !knowledge_op_supported(op) {
            return ty_error()
        }

        if !types_compatible(left_inner, right_inner) {
            return ty_error()
        }

        // Determine result epsilon based on operation
        let result_epsilon = match op {
            BinaryOp::OpAdd => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpSub => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpMul => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpDiv => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpRem => epsilon_combine_independent(left_eps, right_eps),
            _ => 0.0
        }

        // Determine result type based on operation
        match op {
            // Comparisons on Knowledge require explicit unwrap.
            BinaryOp::OpEq => ty_error(),
            BinaryOp::OpNe => ty_error(),
            BinaryOp::OpLt => ty_error(),
            BinaryOp::OpLe => ty_error(),
            BinaryOp::OpGt => ty_error(),
            BinaryOp::OpGe => ty_error(),
            // All other operations return Knowledge with combined epsilon
            _ => {
                // For arithmetic operations, result is Knowledge with combined epsilon
                // Inner type is the same as input inner types (assuming they match)
                ty_knowledge(left_inner, result_epsilon)
            }
        }
    }
}

// Check if binary operation is supported for Knowledge types
pub fn knowledge_op_supported(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpAdd => true,
        BinaryOp::OpSub => true,
        BinaryOp::OpMul => true,
        BinaryOp::OpDiv => true,
        BinaryOp::OpRem => true,
        BinaryOp::OpEq => false,
        BinaryOp::OpNe => false,
        BinaryOp::OpLt => false,
        BinaryOp::OpLe => false,
        BinaryOp::OpGt => false,
        BinaryOp::OpGe => false,
        BinaryOp::OpAnd => false,  // Logical ops not supported for Knowledge directly
        BinaryOp::OpOr => false,
        BinaryOp::OpBitAnd => false,
        BinaryOp::OpBitOr => false,
        BinaryOp::OpBitXor => false,
        BinaryOp::OpShl => false,  // Shift not typically used with Knowledge
        BinaryOp::OpShr => false,
        BinaryOp::OpConcat => false,
        BinaryOp::OpRange => false,
        BinaryOp::OpRangeInclusive => false,
        // Findings 11 (#2084): unsigned counterparts. Knowledge<T>
        // arithmetic is unsupported (matches signed fallthrough above), so
        // these also return false.
        BinaryOp::OpUDiv => false,
        BinaryOp::OpURem => false,
        BinaryOp::OpUShr => false
    }
}

// ============================================================
// Call boundary compatibility (lines 481-500)
// ============================================================

// Check knowledge compatibility at function call boundaries
// Considers epsilon, validity, and provenance
pub fn knowledge_call_boundary_compatible(provided: TypeEntry, required: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if !is_epistemic_type(provided) || !is_epistemic_type(required) {
        return false
    }
    if !types_equal(knowledge_inner(provided), knowledge_inner(required)) {
        return false
    }
    let pmeta = knowledge_meta_from_ty(provided)
    let rmeta = knowledge_meta_from_ty(required)
    if !epsilon_subsumes_call_boundary(knowledge_meta_epsilon(pmeta), knowledge_meta_epsilon(rmeta)) {
        return false
    }
    if !validity_subsumes(knowledge_meta_validity(pmeta), knowledge_meta_validity(rmeta)) {
        return false
    }
    provenance_subsumes(knowledge_meta_provenance(pmeta), knowledge_meta_provenance(rmeta))
}

// ============================================================
// Contest / Policy / Robust type checkers
// ============================================================

pub fn check_contest_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_contest(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

pub fn check_policy_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_policy(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

pub fn check_robust_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_robust(inner_ty, -1, -1, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

// ============================================================
// Epistemic/Aleatoric uncertainty kind checking (H6.3)
// ============================================================

// Check that a type is not being incorrectly used as epistemic
// when it is actually aleatoric. Returns error code 0 (ok) or 56/57 (error).
// E056: cannot reduce aleatoric uncertainty (it is irreducible)
// E057: cannot coerce epistemic to aleatoric
pub fn check_uncertainty_kind_reduction(source_ty: TypeEntry, target_ty: TypeEntry) -> i64 {
    match source_ty.kind {
        TypeKind::TyAleatoric => {
            match target_ty.kind {
                TypeKind::TyEpistemic => 56  // E056: aleatoric is irreducible
                TypeKind::TyKnowledge => 0   // OK: aleatoric <: Knowledge
                TypeKind::TyAleatoric => 0   // OK: same kind
                _ => 0
            }
        }
        TypeKind::TyEpistemic => {
            match target_ty.kind {
                TypeKind::TyAleatoric => 57  // E057: cannot coerce epistemic to aleatoric
                TypeKind::TyEpistemic => 0
                TypeKind::TyKnowledge => 0   // OK: epistemic <: Knowledge
                _ => 0
            }
        }
        _ => 0
    }
}

// Returns the resulting uncertainty TypeKind for a binary operation.
// Propagation rules:
//   Epistemic op Epistemic -> Epistemic (quadrature combination)
//   Aleatoric op Aleatoric -> Aleatoric (irreducible, stays aleatoric)
//   Epistemic op Aleatoric -> Knowledge  (mixed, conservative)
//   Knowledge  op anything  -> Knowledge
pub fn uncertainty_binary_result_kind(a: TypeEntry, b: TypeEntry) -> TypeKind {
    match a.kind {
        TypeKind::TyEpistemic => {
            match b.kind {
                TypeKind::TyEpistemic => TypeKind::TyEpistemic
                TypeKind::TyAleatoric => TypeKind::TyKnowledge
                TypeKind::TyKnowledge => TypeKind::TyKnowledge
                _ => TypeKind::TyEpistemic
            }
        }
        TypeKind::TyAleatoric => {
            match b.kind {
                TypeKind::TyAleatoric => TypeKind::TyAleatoric
                TypeKind::TyEpistemic => TypeKind::TyKnowledge
                TypeKind::TyKnowledge => TypeKind::TyKnowledge
                _ => TypeKind::TyAleatoric
            }
        }
        TypeKind::TyKnowledge => TypeKind::TyKnowledge
        _ => TypeKind::TyKnowledge
    }
}

// ============================================================
// Sprint 20 Track SC: Singleton physical constant checking
// ============================================================
// check_singleton_type: verifies that a Singleton<T, name> type annotation
// is valid. Rules:
//   1. The constant name must be non-empty.
//   2. The inner type must be f64 (physical constants are always real-valued).
//   3. The unit_id must match a known SI unit (-1 is allowed for dimensionless).
// Returns an error code (0 = ok, E070 = invalid singleton).
pub fn check_singleton_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TySingleton {
        return 0
    }
    if ty.name.len <= 0 {
        return 70  // E070: singleton constant name must be non-empty
    }
    match ty.inner {
        None => return 70
        Some(inner) => {
            // Physical constants must be f64 or f32
            if (*inner).kind != TypeKind::TyF64 && (*inner).kind != TypeKind::TyF32 {
                return 70
            }
        }
    }
    0
}

pub fn is_valid_singleton(ty: TypeEntry) -> bool {
    check_singleton_type(ty) == 0
}

// singleton_names_match: true if both are singleton types with equal constant names
pub fn singleton_names_match(a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div {
    if a.kind != TypeKind::TySingleton { return false }
    if b.kind != TypeKind::TySingleton { return false }
    name_eq(a.name, b.name)
}

// ============================================================
// Sprint 20 Track SE: Scoped effect type checking
// ============================================================
// check_scoped_effect_type: verifies ScopedEffect<E, ε> is well-formed.
// Rules:
//   1. The effect label (name) must be non-empty.
//   2. The epsilon budget must be >= 0.0.
//   3. Inner type (computation result) must be present.
// Returns error code (0 = ok, E071 = malformed scoped effect).
pub fn check_scoped_effect_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyScopedEffect {
        return 0
    }
    if ty.name.len <= 0 {
        return 71  // E071: scoped effect label must be non-empty
    }
    // Epsilon must be non-negative (or unset = -1.0)
    if ty.knowledge_epsilon >= 0.0 || ty.knowledge_epsilon == (0.0 - 1.0) {
        // ok
    } else {
        return 71
    }
    0
}

pub fn scoped_effect_budget_ok(ty: TypeEntry, actual_epsilon: f64) -> bool {
    if ty.kind != TypeKind::TyScopedEffect { return true }
    // If budget is unset (-1.0), any epsilon is fine
    if ty.knowledge_epsilon < 0.0 { return true }
    actual_epsilon <= ty.knowledge_epsilon
}

// ============================================================
// Sprint 20 Track CI: Conditional independence type checking
// ============================================================
// check_cond_indep_type: verifies IndepKnowledge<T, A, B | Z> is well-formed.
// Rules:
//   1. var_a != var_b (a variable is trivially independent of itself — degenerate).
//   2. The base type (inner) must be present.
//   3. Confidence must be in (0, 1] or unset (-1.0).
// Returns error code (0 = ok, E072 = malformed CI claim).
pub fn check_cond_indep_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyCondIndep {
        return 0
    }
    // var_a must differ from var_b (degenerate independence)
    if ty.array_size == ty.fn_sig_id && ty.array_size >= 0 {
        return 72  // E072: a variable cannot be declared independent of itself
    }
    match ty.inner {
        None => return 72
        Some(_) => {}
    }
    // Confidence must be in (0, 1] or unset
    if ty.knowledge_epsilon > 1.0 || ty.knowledge_epsilon == 0.0 {
        return 72
    }
    0
}

pub fn is_valid_cond_indep(ty: TypeEntry) -> bool {
    check_cond_indep_type(ty) == 0
}

// cond_indep_structurally_holds: structural check for d-separation.
// Returns true if the claimed independence is plausibly structurally valid.
// Full SMT-backed graph check is wired through causal.sio; this is the
// lightweight fallback for common cases.
// var_a=-1 or var_b=-1 means the variable IDs are unresolved — allow.
pub fn cond_indep_structurally_holds(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyCondIndep { return false }
    if ty.array_size < 0 || ty.fn_sig_id < 0 {
        return true  // unresolved ids: structural check deferred
    }
    if ty.array_size == ty.fn_sig_id {
        return false  // degenerate
    }
    true  // conservative: structural check passes, full d-sep via causal graph in causal.sio
}

// ============================================================
// Sprint 20 Track PO: Potential outcomes type checking
// ============================================================
// check_potential_outcome_type: verifies PotentialOutcome<T, T0, T1> is well-formed.
// Rules:
//   1. inner type must be present (the outcome type T).
//   2. policy_id must be set (>= 0) — cannot have anonymous potential outcome.
//   3. ctrl_id and treat_id can be -1 (unresolved) but not equal (collapses to triviality).
// Linear type: once observed (outcome extracted), the PotentialOutcome is consumed.
// Returns error code (0 = ok, E073 = malformed potential outcome).
pub fn check_potential_outcome_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyPotentialOutcome {
        return 0
    }
    match ty.inner {
        None => return 73  // E073: potential outcome must have an inner type
        Some(_) => {}
    }
    // ctrl and treat ids must not be identical (would collapse to trivial observation)
    if ty.epistemic_meta_id >= 0 && ty.robustness_level_id >= 0 {
        if ty.epistemic_meta_id == ty.robustness_level_id {
            return 73  // E073: control and treatment worlds must differ
        }
    }
    0
}

pub fn is_valid_potential_outcome(ty: TypeEntry) -> bool {
    check_potential_outcome_type(ty) == 0
}

// check_ate_type: verifies ATE<T> is well-formed.
// Rules:
//   1. inner type must be numeric (f64 or f32 — ATE is always a real-valued estimand).
pub fn check_ate_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyATE {
        return 0
    }
    match ty.inner {
        None => return 74  // E074: ATE must have an inner type
        Some(inner) => {
            if (*inner).kind != TypeKind::TyF64 && (*inner).kind != TypeKind::TyF32 {
                return 74  // E074: ATE inner type must be f64 (estimand is a real number)
            }
        }
    }
    0
}

pub fn is_valid_ate(ty: TypeEntry) -> bool {
    check_ate_type(ty) == 0
}

// potential_outcome_to_ate: type-level transformation PotentialOutcome<f64> -> ATE<f64>
// Models: from potential outcomes, derive average treatment effect estimand.
pub fn potential_outcome_to_ate(po_ty: TypeEntry, po_id: i64) -> TypeEntry with Alloc {
    match po_ty.inner {
        None => ty_ate(ty_f64(), po_id)
        Some(inner) => ty_ate(*inner, po_id)
    }
}

// ============================================================
// Track DP: Differential Privacy types (Sprint 21)
// ============================================================
// Reference: Dwork et al. 2006 "Calibrating Noise to Sensitivity in Private Data Analysis"
//   Theorem 3.14: Sequential composition — ε_total = Σεᵢ
//   Theorem 3.20: Parallel composition (disjoint datasets) — ε_total = max(εᵢ)
//
// SOTA novelty: No prior type system encodes ε as a type-level quantity with composition.
//   DFuzz (POPL 2013), Fuzzi (PLDI 2019), Duet (POPL 2020) track *sensitivity* (Δf).
//   Sounio tracks the *budget* (ε) — first language with DP budget as a graded type.

// E075: DiffPrivate type invalid — ε must be positive, inner must be valid
pub fn check_diff_private_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyDiffPrivate {
        return 1
    }
    // ε must be positive (milli-ratio > 0)
    if ty.knowledge_epsilon <= 0.0 {
        return 75
    }
    // inner type must be present
    match ty.inner {
        None => 75
        Some(_) => 0
    }
}

pub fn is_valid_diff_private(ty: TypeEntry) -> bool {
    check_diff_private_type(ty) == 0
}

// Sequential composition: DiffPrivate<T, ε1> ; DiffPrivate<T, ε2> → DiffPrivate<T, ε1+ε2>
// Theorem 3.14 (Dwork 2006): privacy degrades additively under sequential composition.
pub fn dp_sequential_compose(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with Alloc {
    let combined_eps = ty_a.knowledge_epsilon + ty_b.knowledge_epsilon
    let inner_ty = match ty_a.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_diff_private(inner_ty, combined_eps as i64, ty_a.fn_sig_id)
}

// Parallel composition: DiffPrivate<T, ε1> || DiffPrivate<T, ε2> → DiffPrivate<T, max(ε1,ε2)>
// Theorem 3.20 (Dwork 2006): on disjoint datasets, worst-case ε is the maximum.
pub fn dp_parallel_compose(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with Alloc {
    let max_eps = if ty_a.knowledge_epsilon > ty_b.knowledge_epsilon {
        ty_a.knowledge_epsilon
    } else {
        ty_b.knowledge_epsilon
    }
    let inner_ty = match ty_a.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_diff_private(inner_ty, max_eps as i64, ty_a.fn_sig_id)
}

// E076: Privacy budget exhausted — ε_spent > ε_total
pub fn check_dp_budget_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyDPBudget {
        return 1
    }
    // ε_total must be positive
    if ty.knowledge_epsilon <= 0.0 {
        return 76
    }
    // ε_spent must not exceed ε_total (budget exhausted)
    if (ty.array_size as f64) > ty.knowledge_epsilon {
        return 76
    }
    // inner type must be present
    match ty.inner {
        None => 76
        Some(_) => 0
    }
}

pub fn is_valid_dp_budget(ty: TypeEntry) -> bool {
    check_dp_budget_type(ty) == 0
}

// Remaining budget: ε_total - ε_spent (in milli-ratio units)
pub fn dp_budget_remaining(budget_ty: TypeEntry) -> i64 {
    (budget_ty.knowledge_epsilon as i64) - budget_ty.array_size
}

// Consume ε from the budget: produces new DPBudget with ε_spent incremented.
// Returns the original if inner is missing (error recovery).
pub fn dp_budget_consume(budget_ty: TypeEntry, epsilon_to_spend_milli: i64) -> TypeEntry with Alloc {
    let new_spent = budget_ty.array_size + epsilon_to_spend_milli
    let inner_ty = match budget_ty.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_dp_budget(inner_ty, budget_ty.knowledge_epsilon as i64, new_spent)
}

// ============================================================
// Track T: Causal Transportability types (Sprint 22)
// ============================================================
// Reference: Pearl & Bareinboim (2014) "External Validity: From Do-Calculus to Transportability"
//   Bareinboim & Pearl (2016) "Causal inference and the data-fusion problem"
//   S-admissibility (Def 3, Pearl & Bareinboim 2014): a set of covariates Z is S-admissible
//   if (Y ⊥⊥ S | Z, do(X)) in the augmented causal DAG with selection node S.
//   When satisfied: P*(Y|do(X)) = Σ_z P(Y|do(X), Z=z) P*(Z=z)
//
// SOTA novelty: No prior type system encodes causal transportability or S-admissibility.
//   This completes Pearl's Layer 4 (transportability) in Sounio's type system.

// E078: transport not S-admissible — selection bias blocks cross-domain identification
pub fn check_transportable_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyTransportable {
        return 1
    }
    // confidence=0 means S-admissibility was not established
    if ty.knowledge_epsilon <= 0.0 {
        return 78
    }
    // Must have a valid effect type
    match ty.inner {
        None => 78
        Some(_) => 0
    }
}

pub fn is_valid_transportable(ty: TypeEntry) -> bool {
    check_transportable_type(ty) == 0
}

// S-admissibility structural check: selection_bias_id < 0 means no selection detected
// (trivially S-admissible). Positive selection_bias_id means a selection node was found
// and the transport must use the reweighting formula.
pub fn is_s_admissible(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyTransportable {
        return false
    }
    // confidence_milli == 1000 means fully identified (S-admissible confirmed)
    // confidence_milli == 0 means unknown (cannot confirm transport)
    ty.knowledge_epsilon >= 1000.0
}

// transport_to_ate: type-level transport identification
// Transport<f64, src, tgt, S> → ATE<f64> when S-admissible.
// Corresponds to: P*(Y|do(X)) = Σ_z P(Y|do(X), Z=z) * P*(Z=z)
pub fn transport_to_ate(transport_ty: TypeEntry, po_id: i64) -> TypeEntry with Alloc {
    match transport_ty.inner {
        None => ty_ate(ty_f64(), po_id)
        Some(inner) => ty_ate(*inner, po_id)
    }
}

// E079: invalid selection diagram — must have non-negative diagram_id and s_node_count
pub fn check_selection_diagram_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TySelectionDiagram {
        return 1
    }
    // s_node_count must be non-negative
    if ty.array_size < 0 {
        return 79
    }
    match ty.inner {
        None => 79
        Some(_) => 0
    }
}

pub fn is_valid_selection_diagram(ty: TypeEntry) -> bool {
    check_selection_diagram_type(ty) == 0
}

// ============================================================
// Track F: ML Fairness types (Sprint 22)
// ============================================================
// References:
//   Dwork et al. (2012) "Fairness Through Awareness" — individual + demographic parity
//   Hardt et al. (2016) "Equality of Opportunity in Supervised Learning" — equalized odds
//   Chouldechova (2017) "Fair Prediction with Disparate Impact" — impossibility theorem
//   Kusner et al. (2017) "Counterfactual Fairness" — counterfactual criterion
//
// SOTA novelty: No prior type system encodes demographic parity / equalized odds / counterfactual
//   fairness as a type-level constraint. Chouldechova impossibility theorem as type predicate (E082)
//   is also completely novel.
//
// Fairness criterion codes (array_size):
//   0 = demographic_parity, 1 = equalized_odds, 2 = individual_fairness,
//   3 = calibration_within_group, 4 = counterfactual_fairness

let FAIRNESS_CRITERION_DP: i64 = 0
let FAIRNESS_CRITERION_EO: i64 = 1
let FAIRNESS_CRITERION_IF: i64 = 2
let FAIRNESS_CRITERION_CWG: i64 = 3
let FAIRNESS_CRITERION_CF: i64 = 4

// E080: invalid fairness type — criterion out of range or attribute_id < -1
pub fn check_fair_prediction_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyFairPrediction {
        return 1
    }
    // criterion must be in [0, 4]
    if ty.array_size < 0 || ty.array_size > 4 {
        return 80
    }
    // slack must be non-negative
    if ty.knowledge_epsilon < 0.0 {
        return 80
    }
    match ty.inner {
        None => 80
        Some(_) => 0
    }
}

pub fn is_valid_fair_prediction(ty: TypeEntry) -> bool {
    check_fair_prediction_type(ty) == 0
}

// E081: fairness gap exceeds declared slack — actual disparity > tolerance
pub fn check_fairness_gap_type(gap_ty: TypeEntry, fair_ty: TypeEntry) -> i64 {
    if gap_ty.kind != TypeKind::TyFairnessGap {
        return 1
    }
    // Criteria must match
    if gap_ty.array_size != fair_ty.array_size {
        return 81
    }
    // measured_gap_milli must not exceed the declared slack_milli
    if gap_ty.knowledge_epsilon > fair_ty.knowledge_epsilon {
        return 81
    }
    0
}

// fairness_impossibility_holds — Chouldechova 2017 impossibility theorem:
// Demographic parity ∧ Equalized odds ∧ Calibration-within-group cannot ALL hold
// simultaneously when base rates differ across groups.
// Returns true if the combination of two criteria is contradictory (triggers E082).
pub fn fairness_impossibility_holds(criterion_a: i64, criterion_b: i64) -> bool {
    // Chouldechova (2017): the tension is between DP/EO and Calibration.
    // In a binary prediction setting with unequal base rates (prevalence p_a ≠ p_b):
    //   - DP (criterion 0) and Calibration (criterion 3) cannot both hold
    //   - EO (criterion 1) and Calibration (criterion 3) cannot both hold
    //   - DP and EO can only simultaneously hold when base rates are equal
    let dp_and_cal = (criterion_a == FAIRNESS_CRITERION_DP && criterion_b == FAIRNESS_CRITERION_CWG)
        || (criterion_a == FAIRNESS_CRITERION_CWG && criterion_b == FAIRNESS_CRITERION_DP)
    let eo_and_cal = (criterion_a == FAIRNESS_CRITERION_EO && criterion_b == FAIRNESS_CRITERION_CWG)
        || (criterion_a == FAIRNESS_CRITERION_CWG && criterion_b == FAIRNESS_CRITERION_EO)
    dp_and_cal || eo_and_cal
}

// counterfactual_fairness_from_potential_outcome:
// TyPotentialOutcome<T> → TyFairPrediction<T, counterfactual_fairness, attr>
// Bridges Sprint 20 PO track with Sprint 22 fairness track.
//
// Kusner et al. (2017): a predictor Ŷ is counterfactually fair if for every individual
// and value of the protected attribute A, the potential outcome Ŷ(A←a) equals Ŷ(A←a').
// This corresponds to: TyPotentialOutcome<T> (linear-consumed) guarantees the "one arm"
// property, which is exactly the requirement for counterfactual fairness.
pub fn counterfactual_fairness_from_potential_outcome(po_ty: TypeEntry, attr_id: i64) -> TypeEntry with Alloc {
    let inner_ty = match po_ty.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    // criterion=4 (counterfactual_fairness), slack=0 (exact, not approximate)
    ty_fair_prediction(inner_ty, FAIRNESS_CRITERION_CF, attr_id, 0)
}

// ============================================================
// Sprint 23 Track P: Probabilistic Types (E083-E086)
// ============================================================
// Distribution kind constants (mirrors types.sio)
let DIST_NORMAL_EP: i64 = 0
let DIST_BERNOULLI_EP: i64 = 1
let DIST_POISSON_EP: i64 = 2
let DIST_EXPONENTIAL_EP: i64 = 3
let DIST_UNIFORM_EP: i64 = 4
let DIST_BETA_EP: i64 = 5
let DIST_DIRICHLET_EP: i64 = 6
let DIST_CATEGORICAL_EP: i64 = 7

pub fn is_valid_distribution(ty: TypeEntry) -> bool with IO {
    // Valid: kind in [-1, 7], inner must be present
    if ty.array_size < -1 { return false }
    if ty.array_size > 7 { return false }
    if ty.knowledge_epsilon != -1.0 && ty.knowledge_epsilon < 0.0 { return false }
    true
}

pub fn check_distribution_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_distribution(ty) { return 0 }
    83  // E083
}

pub fn is_valid_sample(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 7 { return false }
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    true
}

pub fn check_sample_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_sample(ty) { return 0 }
    84  // E084
}

pub fn check_sample_dist_compat(sample_ty: TypeEntry, dist_ty: TypeEntry) -> i64 with IO {
    // E084 if distribution kinds don't match (and neither is -1=parametric)
    if sample_ty.array_size == -1 { return 0 }
    if dist_ty.array_size == -1 { return 0 }
    if sample_ty.array_size == dist_ty.array_size { return 0 }
    84
}

pub fn is_valid_conditional_dist(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    true
}

pub fn check_conditional_dist_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_conditional_dist(ty) { return 0 }
    85  // E085
}

pub fn check_conditional_normalized(ty: TypeEntry) -> bool with IO {
    // log_normalizer_milli = 0 means unnormalized
    ty.knowledge_epsilon != 0.0
}

// Conjugacy check: prior kind x likelihood kind
pub fn is_conjugate_pair(prior_kind: i64, likelihood_kind: i64) -> bool with IO {
    // Normal + Normal -> Normal
    if prior_kind == DIST_NORMAL_EP && likelihood_kind == DIST_NORMAL_EP { return true }
    // Beta + Bernoulli -> Beta
    if prior_kind == DIST_BETA_EP && likelihood_kind == DIST_BERNOULLI_EP { return true }
    // Dirichlet + Categorical -> Dirichlet
    if prior_kind == DIST_DIRICHLET_EP && likelihood_kind == DIST_CATEGORICAL_EP { return true }
    // Gamma + Poisson -> Gamma (Gamma not yet in DIST_ constants; use Exponential as proxy)
    if prior_kind == DIST_EXPONENTIAL_EP && likelihood_kind == DIST_POISSON_EP { return true }
    false
}

pub fn check_conjugate_update(prior_ty: TypeEntry, likelihood_ty: TypeEntry) -> i64 with IO {
    if is_conjugate_pair(prior_ty.array_size, likelihood_ty.array_size) { return 0 }
    86  // E086: non-conjugate pair
}

// Bridge: Distribution -> Contest (model disagreement across distributions)
pub fn dist_to_contest(dist_ty: TypeEntry, model_count: i64) -> TypeEntry with IO, Alloc {
    // Wraps distribution in a Contest with model_count witnesses
    ty_contest(dist_ty, model_count)
}

// Bridge: Conditional -> Robust (posterior with proof of correctness)
pub fn conditional_to_robust(cond_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    ty_robust(cond_ty, proof_id, 0, -1)
}

pub fn sample_from_distribution(dist_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    ty_sample(dist_ty, dist_ty.array_size, -1, 1000.0, -1)
}

pub fn dist_marginalize(joint_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // Returns a distribution with same kind but wrapped inner
    ty_distribution(joint_ty, joint_ty.array_size, -1, -1.0, -1)
}

pub fn dist_product(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with IO, Alloc {
    // Independent joint: family stays general (-1)
    ty_distribution(ty_a, -1, -1, -1.0, -1)
}

// ============================================================
// Sprint 23 Track I: Information-Theoretic Types (E087-E090)
// ============================================================

pub fn is_valid_entropic(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    if ty.knowledge_epsilon != -1.0 && ty.knowledge_epsilon < 0.0 { return false }
    true
}

pub fn check_entropic_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_entropic(ty) { return 0 }
    87  // E087
}

pub fn is_valid_mutual_info(ty: TypeEntry) -> bool with IO {
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    true
}

pub fn check_mutual_info_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_mutual_info(ty) { return 0 }
    88  // E088
}

pub fn check_dpi_step(before_ty: TypeEntry, after_ty: TypeEntry) -> i64 with IO {
    // Data Processing Inequality: I(X;Z) <= I(X;Y) after processing
    // after.knowledge_epsilon <= before.knowledge_epsilon (both in milli-nats)
    if before_ty.knowledge_epsilon < 0.0 { return 0 }  // no bound -> always ok
    if after_ty.knowledge_epsilon < 0.0 { return 88 }  // after unbounded but before bounded -> E088
    if after_ty.knowledge_epsilon <= before_ty.knowledge_epsilon { return 0 }
    88  // E088: MI increased after processing (DPI violated)
}

pub fn is_valid_kl_bounded(ty: TypeEntry) -> bool with IO {
    // KL divergence >= 0 always (Gibbs inequality)
    if ty.knowledge_epsilon < 0.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 2 { return false }
    true
}

pub fn check_kl_bounded_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_kl_bounded(ty) { return 0 }
    89  // E089: KL bound negative
}

pub fn check_entropy_subsumes(sub_ty: TypeEntry, sup_ty: TypeEntry) -> i64 with IO {
    // Entropic<T,H1> <= Entropic<T,H2> iff H1 <= H2
    // sub has MORE entropy than sup -> contradiction
    if sub_ty.knowledge_epsilon < 0.0 { return 0 }  // sub unbounded -> always fits
    if sup_ty.knowledge_epsilon < 0.0 { return 0 }  // sup unbounded -> always accepts
    if sub_ty.knowledge_epsilon <= sup_ty.knowledge_epsilon { return 0 }
    90  // E090: entropy ordering contradiction
}

pub fn entropy_combine_independent(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with IO, Alloc {
    // H(X,Y) = H(X) + H(Y) for independent X, Y
    let combined_milli = ty_a.knowledge_epsilon + ty_b.knowledge_epsilon
    ty_entropic(ty_a, combined_milli, 0, -1, 0)
}

pub fn entropy_chain_rule(joint_ty: TypeEntry, cond_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // H(X,Y) = H(X) + H(Y|X); returns H(X) given joint and conditional
    let hx_milli = joint_ty.knowledge_epsilon + (0.0 - cond_ty.knowledge_epsilon)
    ty_entropic(joint_ty, hx_milli, 0, -1, 0)
}

pub fn kl_to_tv_pinsker(kl_ty: TypeEntry) -> TypeEntry with IO, Alloc, Panic {
    // Pinsker's inequality: TV(P,Q)^2 <= KL(P||Q)/2
    // tv_bound_milli = sqrt(kl_milli / 2000) * 1000 (approximate)
    let half_kl = kl_ty.knowledge_epsilon / 2.0
    // sqrt via 1-step Newton: sqrt(x) ~= x/2 for x << 1
    let tv_milli = half_kl / 2.0
    ty_kl_bounded(kl_ty, tv_milli, -1, 0, -1, -1)
}

pub fn mutual_info_from_entropics(hx_ty: TypeEntry, hy_ty: TypeEntry, hxy_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // I(X;Y) = H(X) + H(Y) - H(X,Y)
    let mi_milli = hx_ty.knowledge_epsilon + hy_ty.knowledge_epsilon + (0.0 - hxy_ty.knowledge_epsilon)
    ty_mutual_info(hx_ty, -1, mi_milli, 3, 0)
}

// Bridge: KLBounded -> ELBO (KL gap directly gives ELBO gap)
pub fn kl_bounded_to_elbo(kl_ty: TypeEntry, model_id: i64) -> TypeEntry with IO, Alloc {
    ty_elbo(kl_ty, -1, model_id, kl_ty.knowledge_epsilon, -1, 0)
}

// ============================================================
// Sprint 23 Track V: Shape-Typed Linear Algebra (E091-E094)
// ============================================================

pub fn is_valid_vec_shaped(ty: TypeEntry) -> bool with IO {
    if ty.array_size == 0 { return false }  // zero-length degenerate
    true
}

pub fn check_vec_shaped_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_vec_shaped(ty) { return 0 }
    91  // E091
}

pub fn check_vec_length_compat(v1: TypeEntry, v2: TypeEntry) -> i64 with IO {
    if v1.array_size == -1 { return 0 }  // polymorphic
    if v2.array_size == -1 { return 0 }  // polymorphic
    if v1.array_size == v2.array_size { return 0 }
    91  // E091: length mismatch
}

pub fn is_valid_matrix_shaped(ty: TypeEntry) -> bool with IO {
    if ty.array_size == 0 { return false }   // zero columns
    if ty.algebra_kind == 0 { return false } // zero rows
    true
}

pub fn check_matrix_shaped_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_matrix_shaped(ty) { return 0 }
    92  // E092
}

pub fn check_matmul_dims(left: TypeEntry, right: TypeEntry) -> i64 with IO {
    // Matrix<T, m, k> x Matrix<T, k, n>: left.n (array_size) must equal right.m (algebra_kind)
    if left.array_size == -1 { return 0 }
    if right.algebra_kind == -1 { return 0 }
    if left.array_size == right.algebra_kind { return 0 }
    92  // E092: dimension mismatch
}

pub fn matmul_result_type(left: TypeEntry, right: TypeEntry) -> TypeEntry with IO, Alloc {
    // Matrix<T, m, k> x Matrix<T, k, n> -> Matrix<T, m, n>
    // result.m = left.algebra_kind (m), result.n = right.array_size (n)
    ty_matrix_shaped(left, left.algebra_kind, right.array_size, left.fn_sig_id, -1.0, 0)
}

pub fn check_decomp_shape(ty: TypeEntry, decomp_kind: i64) -> i64 with IO {
    // decomp_kind: 0=Cholesky, 1=QR, 2=LU, 3=SVD, 4=eig
    if decomp_kind == 3 { return 0 }  // SVD always valid
    let m = ty.algebra_kind
    let n = ty.array_size
    if decomp_kind == 0 {
        // Cholesky: square AND SPD (symmetry_tag=2)
        if m != n { return 93 }
        if ty.epistemic_meta_id != 2 { return 93 }
        return 0
    }
    if decomp_kind == 1 {
        // QR: m >= n (overdetermined)
        if m == -1 || n == -1 { return 0 }
        if m < n { return 93 }
        return 0
    }
    if decomp_kind == 2 {
        // LU: square
        if m != n { return 93 }
        return 0
    }
    if decomp_kind == 4 {
        // Eigendecomp: square
        if m != n { return 93 }
        return 0
    }
    0
}

pub fn is_valid_broadcastable(ty: TypeEntry) -> bool with IO {
    // actual_m must be 1 OR equal m_target (algebra_kind)
    let m_target = ty.algebra_kind
    let actual_m = ty.clifford_p
    let n_target = ty.array_size
    let actual_n = ty.fn_sig_id
    if m_target == -1 { return true }
    if actual_m == -1 { return true }
    if actual_m == 1 { return true }
    if actual_m != m_target { return false }
    if n_target == -1 { return true }
    if actual_n == -1 { return true }
    if actual_n == 1 { return true }
    if actual_n != n_target { return false }
    true
}

pub fn check_broadcastable_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_broadcastable(ty) { return 0 }
    94  // E094
}

pub fn matrix_transpose_type(ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // Matrix<T, m, n> -> Matrix<T, n, m>
    ty_matrix_shaped(ty, ty.array_size, ty.algebra_kind, ty.fn_sig_id, ty.knowledge_epsilon, ty.epistemic_meta_id)
}

pub fn broadcast_result_type(a: TypeEntry, b: TypeEntry) -> TypeEntry with IO, Alloc {
    // NumPy broadcast: max of dimensions
    let m_out = if a.algebra_kind > b.algebra_kind { a.algebra_kind } else { b.algebra_kind }
    let n_out = if a.array_size > b.array_size { a.array_size } else { b.array_size }
    ty_matrix_shaped(a, m_out, n_out, a.fn_sig_id, -1.0, 0)
}

pub fn vec_outer_product_type(v1: TypeEntry, v2: TypeEntry) -> TypeEntry with IO, Alloc {
    // Vec<T,m> x Vec<T,n> -> Matrix<T, m, n>
    ty_matrix_shaped(v1, v1.array_size, v2.array_size, 0, -1.0, 0)
}

// ============================================================
// Sprint 23 Track X: Variational Inference Types (E095-E096)
// ============================================================

pub fn is_valid_elbo(ty: TypeEntry) -> bool with IO {
    // KL gap must be non-negative (KL >= 0 always)
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    true
}

pub fn check_elbo_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_elbo(ty) { return 0 }
    95  // E095
}

pub fn is_valid_variational_family(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 4 { return false }
    if ty.knowledge_epsilon < 0.0 { return false }
    true
}

pub fn check_variational_family_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_variational_family(ty) { return 0 }
    96  // E096
}

pub fn elbo_from_kl_bounded(q_ty: TypeEntry, kl_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // KLBounded<Q, delta> -> ELBO<Q, P, delta>
    ty_elbo(q_ty, -1, kl_ty.fn_sig_id, kl_ty.knowledge_epsilon, -1, 0)
}

pub fn elbo_tighten(elbo_ty: TypeEntry, new_kl_milli: f64) -> TypeEntry with IO, Alloc {
    // Monotone refinement: new_kl_milli must be <= elbo_ty.knowledge_epsilon
    let kl = if new_kl_milli < elbo_ty.knowledge_epsilon { new_kl_milli } else { elbo_ty.knowledge_epsilon }
    ty_elbo(elbo_ty, elbo_ty.array_size, elbo_ty.fn_sig_id, kl, elbo_ty.epistemic_meta_id, elbo_ty.algebra_kind)
}

// Bridge: ELBO -> Contest (VI result lifted to contested posterior)
pub fn vi_to_contest(elbo_ty: TypeEntry, model_count: i64) -> TypeEntry with IO, Alloc {
    // The approximation gap (kl_gap_milli) becomes the epistemic uncertainty in Contest
    ty_contest(elbo_ty, model_count)
}

// Bridge: ELBO -> Robust (when ELBO has converged -- epistemic_meta_id > 0)
pub fn elbo_to_robust(elbo_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    ty_robust(elbo_ty, proof_id, 0, -1)
}

pub fn variational_family_expressiveness(family_ty: TypeEntry) -> i64 with IO {
    // Returns capacity bound based on family kind
    // 0=mean_field_gaussian: low (1), 1=full_rank: medium (2),
    // 2=IAF: high (3), 3=RNVP: high (3), 4=planar_flow: medium (2)
    if family_ty.array_size == 0 { return 1 }
    if family_ty.array_size == 1 { return 2 }
    if family_ty.array_size == 2 { return 3 }
    if family_ty.array_size == 3 { return 3 }
    if family_ty.array_size == 4 { return 2 }
    1
}

// ================================================================
// Sprint 24 Track A: Differentiable Programming Types (E100-E103)
// References: Elliott ICFP 2018, Huot et al. LICS 2020,
//             Pearlmutter & Siskind POPL 2008
// ================================================================

pub fn is_valid_differentiable(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyDifferentiable { return false }
    if ty.array_size < -1 { return false }
    true
}

pub fn check_differentiable_type(ty: TypeEntry) -> i64 with IO {
    // E100: invalid differentiable type
    if ty.kind != TypeKind::TyDifferentiable { return 100 }
    if ty.array_size < -1 { return 100 }
    0
}

pub fn is_valid_gradient(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyGradient { return false }
    if ty.array_size == 0 { return false }
    true
}

pub fn check_gradient_type(grad_ty: TypeEntry, fn_ty: TypeEntry) -> i64 with IO {
    // E101: gradient dimension mismatch
    if grad_ty.kind != TypeKind::TyGradient { return 101 }
    if grad_ty.array_size != -1 && fn_ty.array_size != -1 {
        if grad_ty.array_size != fn_ty.array_size { return 101 }
    }
    if grad_ty.algebra_kind == 0 { return 101 }
    0
}

pub fn is_valid_jacobian(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyJacobian { return false }
    if ty.array_size == 0 { return false }
    if ty.algebra_kind == 0 { return false }
    true
}

pub fn check_jacobian_type(jac_ty: TypeEntry) -> i64 with IO {
    // E102: Jacobian dimension invalid
    if jac_ty.kind != TypeKind::TyJacobian { return 102 }
    if jac_ty.array_size == 0 { return 102 }
    if jac_ty.algebra_kind == 0 { return 102 }
    0
}

pub fn check_ad_mode_compat(grad_ty: TypeEntry, requires_reverse: bool) -> i64 with IO {
    // E103: forward-only mode incompatible with Langevin/reverse-mode context
    if grad_ty.kind != TypeKind::TyGradient { return 103 }
    if requires_reverse {
        if grad_ty.epistemic_meta_id == 0 { return 103 }
    }
    0
}

pub fn diff_compose(outer: TypeEntry, inner_fn: TypeEntry) -> TypeEntry with IO, Alloc, Mut {
    // Chain rule: C^k o C^j = C^min(k,j)
    var k: i64 = outer.array_size
    let j: i64 = inner_fn.array_size
    if j != -1 && k != -1 {
        if j < k { k = j }
    } else {
        if j == -1 && k == -1 { k = -1 }
        else if j == -1 { k = k }
        else { k = j }
    }
    ty_differentiable(inner_fn, k, -1, 0.0 - 1.0, outer.epistemic_meta_id)
}

pub fn gradient_norm_check(grad_ty: TypeEntry, actual_norm_milli: f64) -> i64 with IO {
    if grad_ty.knowledge_epsilon < 0.0 { return 0 }
    if actual_norm_milli <= grad_ty.knowledge_epsilon { return 0 }
    103
}

pub fn jacobian_from_matrix_shape(mat_ty: TypeEntry, base_fn_id: i64) -> TypeEntry with IO, Alloc {
    // BRIDGE: TyMatrixShaped -> TyJacobian
    ty_jacobian(mat_ty, mat_ty.array_size, mat_ty.algebra_kind, base_fn_id, mat_ty.knowledge_epsilon, 0)
}

pub fn langevin_from_gradient(grad_ty: TypeEntry, temperature_milli: i64) -> TypeEntry with IO, Alloc {
    // MOONSHOT BRIDGE A->B: TyGradient<loss,n,1> -> TySDE<x, -grad_f, sqrt(2*eta*T)>
    // Langevin: dX = -grad_f(X) dt + sqrt(2T) dW, sde_kind=2 (Langevin)
    let state_dim: i64 = grad_ty.array_size
    let drift_id: i64 = grad_ty.fn_sig_id
    let diffusion_bound: f64 = temperature_milli as f64
    ty_sde(grad_ty, state_dim, drift_id, -1, diffusion_bound, 2)
}

// ================================================================
// Sprint 24 Track B: Stochastic Process Types (E104-E107)
// References: Oksendal (2003) SDEs, Doob (1953) martingales,
//             Aguirre et al. POPL 2018
// ================================================================

pub fn is_valid_markov_chain(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyMarkovChain { return false }
    let ck: i64 = ty.epistemic_meta_id
    if ck < 0 { return false }
    if ck > 2 { return false }
    true
}

pub fn check_markov_chain_type(ty: TypeEntry) -> i64 with IO {
    // E104: Markov chain kind invalid
    if ty.kind != TypeKind::TyMarkovChain { return 104 }
    let ck: i64 = ty.epistemic_meta_id
    if ck < 0 { return 104 }
    if ck > 2 { return 104 }
    if ty.array_size == 0 { return 104 }
    0
}

pub fn is_valid_sde(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TySDE { return false }
    if ty.array_size == 0 { return false }
    let sk: i64 = ty.epistemic_meta_id
    if sk < 0 { return false }
    if sk > 3 { return false }
    true
}

pub fn check_sde_type(ty: TypeEntry) -> i64 with IO {
    // E105: SDE state_dim invalid or sde_kind out of range
    if ty.kind != TypeKind::TySDE { return 105 }
    if ty.array_size == 0 { return 105 }
    let sk: i64 = ty.epistemic_meta_id
    if sk < 0 { return 105 }
    if sk > 3 { return 105 }
    0
}

pub fn is_valid_martingale(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyMartingale { return false }
    let mk: i64 = ty.epistemic_meta_id
    if mk < 0 { return false }
    if mk > 2 { return false }
    true
}

pub fn check_martingale_type(ty: TypeEntry) -> i64 with IO {
    // E106: martingale kind invalid or Doob bound negative
    if ty.kind != TypeKind::TyMartingale { return 106 }
    let mk: i64 = ty.epistemic_meta_id
    if mk < 0 { return 106 }
    if mk > 2 { return 106 }
    0
}

pub fn is_valid_stationary_dist(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyStationaryDist { return false }
    let pk: i64 = ty.array_size
    if pk != 0 && pk != 1 { return false }
    true
}

pub fn check_stationary_dist_type(ty: TypeEntry) -> i64 with IO {
    // E107: process_kind not in {0, 1}
    if ty.kind != TypeKind::TyStationaryDist { return 107 }
    let pk: i64 = ty.array_size
    if pk != 0 && pk != 1 { return 107 }
    0
}

pub fn markov_to_distribution(mc_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE: TyMarkovChain -> TyDistribution (parametric, kind=-1)
    ty_distribution(mc_ty, -1, mc_ty.robustness_level_id, mc_ty.knowledge_epsilon, mc_ty.epistemic_meta_id)
}

pub fn sde_stationary_to_dist(sde_ty: TypeEntry, beta_milli: i64) -> TypeEntry with IO, Alloc {
    // MOONSHOT BRIDGE B->Sprint23P:
    // Ergodic Langevin SDE -> Gibbs/Boltzmann stationary distribution
    // pi(x) proportional to exp(-beta U(x)), where drift = -grad_U
    ty_distribution(sde_ty, -1, sde_ty.fn_sig_id, 1000.0, 0)
}

pub fn ergodic_to_robust(mc_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    // BRIDGE B->Sprint7: ergodic Markov chain -> TyRobust (stability guarantee)
    ty_robust(mc_ty, proof_id, 0, -1)
}

// ================================================================
// Sprint 24 Track C: Complexity/Resource Types (E108-E109)
// References: Hoffmann & Hofmann POPL 2010, Hoffmann et al. POPL 2012
// ================================================================

pub fn is_valid_bigO(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyBigO { return false }
    if ty.array_size < -1 { return false }
    let rk: i64 = ty.epistemic_meta_id
    if rk < -1 { return false }
    if rk > 2 { return false }
    true
}

pub fn check_bigO_type(ty: TypeEntry) -> i64 with IO {
    // E108: degree < -1 or resource_kind out of range
    if ty.kind != TypeKind::TyBigO { return 108 }
    if ty.array_size < -1 { return 108 }
    let rk: i64 = ty.epistemic_meta_id
    if rk < -1 { return 108 }
    if rk > 2 { return 108 }
    0
}

pub fn is_valid_amortized(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyAmortized { return false }
    let pm: i64 = ty.epistemic_meta_id
    if pm < 0 { return false }
    if pm > 2 { return false }
    true
}

pub fn check_amortized_type(ty: TypeEntry) -> i64 with IO {
    // E109: amortized per_op_degree > worst_case_degree
    if ty.kind != TypeKind::TyAmortized { return 109 }
    let pm: i64 = ty.epistemic_meta_id
    if pm < 0 { return 109 }
    if pm > 2 { return 109 }
    if ty.robustness_level_id != -1 {
        if ty.array_size > ty.robustness_level_id { return 109 }
    }
    0
}

pub fn bigO_subsumes(outer: TypeEntry, inner_ty: TypeEntry) -> bool with IO {
    // O(n^k) subsumes O(n^j) iff k >= j
    if outer.array_size == -1 { return true }
    if inner_ty.array_size == -1 { return false }
    outer.array_size >= inner_ty.array_size
}

pub fn bigO_compose(f_ty: TypeEntry, g_ty: TypeEntry) -> TypeEntry with IO, Alloc, Mut {
    // O(n^a) composed with O(n^b): O(n^(a*b)), capped at degree 6
    let a: i64 = f_ty.array_size
    let b: i64 = g_ty.array_size
    var deg: i64 = 0
    if a == -1 || b == -1 {
        deg = -1
    } else {
        deg = a * b
        if deg > 6 { deg = 6 }
    }
    ty_bigO(f_ty, deg, -1, f_ty.knowledge_epsilon, f_ty.epistemic_meta_id, f_ty.algebra_kind)
}

pub fn matmul_complexity(left_mat: TypeEntry, right_mat: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE C<-Sprint23V: Matrix<T,m,k> x Matrix<T,k,n> -> BigO<T, degree=3>
    ty_bigO(left_mat, 3, -1, 1000.0, 0, 0)
}

pub fn jacobian_complexity(jac_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE C<-Track A: TyJacobian<f,n,m> -> BigO<T, degree=2>
    ty_bigO(jac_ty, 2, -1, jac_ty.knowledge_epsilon, 0, 0)
}

// ================================================================
// Sprint 24 Track D: Proof Certificate Types (E110-E113)
// References: Wadler (2015) "Propositions as Types",
//             Chlipala CPDT, Martin-Lof (1984)
// ================================================================

pub fn is_valid_proof(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyProof { return false }
    let pk: i64 = ty.array_size
    if pk < 0 { return false }
    if pk > 3 { return false }
    if ty.epistemic_meta_id < 0 { return false }
    true
}

pub fn check_proof_type(ty: TypeEntry) -> i64 with IO {
    // E110: proof_kind invalid or axiom_count negative
    if ty.kind != TypeKind::TyProof { return 110 }
    let pk: i64 = ty.array_size
    if pk < 0 { return 110 }
    if pk > 3 { return 110 }
    if ty.epistemic_meta_id < 0 { return 110 }
    0
}

pub fn check_proof_completeness(ty: TypeEntry) -> i64 with IO {
    // E110: proof has holes (fn_sig_id=-1) unless proof_kind=3 (witnessed)
    if ty.kind != TypeKind::TyProof { return 110 }
    if ty.fn_sig_id == -1 {
        if ty.array_size != 3 { return 110 }
    }
    0
}

pub fn is_valid_lemma(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyLemma { return false }
    if ty.epistemic_meta_id < 0 { return false }
    let st: i64 = ty.robustness_level_id
    if st < 0 { return false }
    if st > 2 { return false }
    true
}

pub fn check_lemma_type(ty: TypeEntry) -> i64 with IO {
    // E111: dependency_count negative or strength_tag invalid
    if ty.kind != TypeKind::TyLemma { return 111 }
    if ty.epistemic_meta_id < 0 { return 111 }
    let st: i64 = ty.robustness_level_id
    if st < 0 { return 111 }
    if st > 2 { return 111 }
    0
}

pub fn check_lemma_acyclic(lemma_ty: TypeEntry, dep_id: i64) -> i64 with IO {
    // E111: self-reference (circular dependency)
    if lemma_ty.array_size == dep_id { return 111 }
    0
}

pub fn is_valid_axiom(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyAxiom { return false }
    let ac: i64 = ty.epistemic_meta_id
    if ac < 0 { return false }
    if ac > 3 { return false }
    if ty.robustness_level_id < 0 { return false }
    true
}

pub fn check_axiom_type(ty: TypeEntry) -> i64 with IO {
    // E112: axiom_class not in [0,3]
    if ty.kind != TypeKind::TyAxiom { return 112 }
    let ac: i64 = ty.epistemic_meta_id
    if ac < 0 { return 112 }
    if ac > 3 { return 112 }
    if ty.robustness_level_id < 0 { return 112 }
    0
}

pub fn check_axiom_constructive(proof_ty: TypeEntry) -> i64 with IO {
    // E112: axiom used as inner of constructive proof (proof_kind=0)
    if proof_ty.kind != TypeKind::TyProof { return 0 }
    if proof_ty.array_size != 0 { return 0 }
    match proof_ty.inner {
        Some(inner) => {
            if (*inner).kind == TypeKind::TyAxiom { return 112 }
            0
        }
        None => 0
    }
}

pub fn check_proof_confidence(ty: TypeEntry, required_milli: f64) -> i64 with IO {
    // E113: weak proof certificate (confidence < required)
    if ty.kind != TypeKind::TyProof { return 113 }
    if ty.knowledge_epsilon >= 0.0 {
        if ty.knowledge_epsilon < required_milli { return 113 }
    }
    0
}

pub fn proof_to_robust(proof_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE D->Sprint7: TyProof<robust(T)> -> TyRobust<T>
    ty_robust(proof_ty, proof_ty.fn_sig_id, proof_ty.robustness_level_id, -1)
}

pub fn proof_to_validated(proof_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE D->Sprint8: Proof<P> -> Validated<T>
    ty_validated(proof_ty, proof_ty.knowledge_epsilon)
}

pub fn lemma_chain(l1: TypeEntry, l2: TypeEntry) -> TypeEntry with IO, Alloc {
    // (A->B) ^ (B->C) -> (A->C): modus ponens composition
    let new_dep: i64 = l1.epistemic_meta_id + l2.epistemic_meta_id + 1
    ty_lemma(l2, l2.array_size, l2.fn_sig_id, l2.knowledge_epsilon, new_dep, l2.robustness_level_id)
}

pub fn axiom_to_proof(ax_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // TyAxiom -> TyProof: probabilistic proof, no proof term, axiom_count=1
    ty_proof(ax_ty, 2, -1, ax_ty.knowledge_epsilon, 1, -1)
}

// ================================================================
// Sprint 24 Moonshot: SGD -> Langevin -> Gibbs -> Contest Bridge
// References: Welling & Teh (2011) SGLD, Roberts & Tweedie (1996)
// ================================================================

pub fn gradient_bridge_complete(diff_ty: TypeEntry, temp_milli: i64, beta_milli: i64, model_count: i64) -> TypeEntry with IO, Alloc {
    // Full chain: Differentiable -> Gradient -> SDE(Langevin) -> Distribution(Gibbs) -> Contest
    let gradient_ty: TypeEntry = ty_gradient(diff_ty, diff_ty.array_size, 1, diff_ty.fn_sig_id, 0.0 - 1.0, 1)
    let sde_ty: TypeEntry = langevin_from_gradient(gradient_ty, temp_milli)
    let dist_ty: TypeEntry = sde_stationary_to_dist(sde_ty, beta_milli)
    dist_to_contest(dist_ty, model_count)
}

// ================================================================
// FSNN Orbit Epistemic Classification (Horizon 5.1)
//
// When a Mandelbrot orbit is near the escape boundary
// (|z_n| ∈ [0.8R, R] where R = escape_radius), the classification
// "escaped" vs "bounded" is epistemically contested.
//
// Orbit result classification rules:
//   1. OrbitResult with |z_final| < 0.8*R     → bounded, uncontested
//   2. OrbitResult with |z_final| > R          → escaped, uncontested
//   3. OrbitResult with |z_final| ∈ [0.8R, R]  → Contest<OrbitResult>
//
// Propagation:
//   Contest<OrbitResult> → fsnn_extract_features → Contest<FSNNFeatures>
//   (boundary sensitivity contaminates downstream features)
//
// Zero-divisor proximity also introduces Contest when zd_proximity < 0.1:
//   Near zero-divisor ⇒ putative inverse is ill-conditioned
//   ⇒ Contest wrapping with PROVENANCE_KIND_COMPUTED
// ================================================================

const PROVENANCE_KIND_ORBIT_BOUNDARY: i64 = 6

// Classify orbit result epsilon based on distance to escape boundary.
// Returns epsilon in [0, 1]: 0 = confidently classified, 1 = on boundary.
// Linear interpolation within the boundary band [0.8R, R].
pub fn orbit_boundary_epsilon(terminal_norm: f64, escape_radius: f64) -> f64 {
    let lower = 0.8 * escape_radius
    let upper = escape_radius
    if terminal_norm < lower {
        // Confidently bounded
        0.0
    } else if terminal_norm > upper {
        // Confidently escaped
        0.0
    } else {
        // In boundary band: epsilon scales linearly from 0 at edges to 1 at midpoint
        let mid = 0.5 * (lower + upper)
        let half_width = 0.5 * (upper - lower)
        if half_width < 1e-30 { return 1.0 }
        let dist_from_mid = terminal_norm - mid
        let abs_dist = if dist_from_mid < 0.0 { 0.0 - dist_from_mid } else { dist_from_mid }
        1.0 - abs_dist / half_width
    }
}

// Classify zero-divisor proximity epsilon.
// When the orbit passes near the zero-divisor variety Z,
// the sedenionic inverse becomes ill-conditioned and the
// Jacobian norm may spike. This introduces epistemic uncertainty.
pub fn zero_divisor_epsilon(zd_proximity: f64) -> f64 {
    if zd_proximity > 0.1 {
        0.0
    } else if zd_proximity < 1e-10 {
        1.0
    } else {
        // Linear interpolation: closer to Z → higher epsilon
        1.0 - zd_proximity / 0.1
    }
}

// Combine orbit boundary and zero-divisor epsilon into a single
// epistemic uncertainty for the FSNN feature vector.
// Uses quadrature combination: epsilon = sqrt(e1^2 + e2^2), clamped to [0,1].
pub fn orbit_combined_epsilon(boundary_eps: f64, zd_eps: f64) -> f64 with Mut, Div {
    let combined_sq = boundary_eps * boundary_eps + zd_eps * zd_eps
    if combined_sq <= 0.0 { return 0.0 }
    // Newton-Raphson sqrt (6 iterations, sufficient for epsilon precision)
    var y = combined_sq
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    if y > 1.0 { 1.0 } else { y }
}

// Check whether an orbit result should be wrapped in Contest<T>.
// Returns 1 if the result is epistemically contested (near boundary or near Z),
// 0 if uncontested.
pub fn orbit_is_contested(terminal_norm: f64, escape_radius: f64, zd_proximity: f64) -> i64 with Mut, Div {
    let eps = orbit_combined_epsilon(
        orbit_boundary_epsilon(terminal_norm, escape_radius),
        zero_divisor_epsilon(zd_proximity)
    )
    if eps > 0.01 { 1 } else { 0 }
}
