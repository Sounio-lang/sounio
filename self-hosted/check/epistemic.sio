            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_counterfactual(inner_ty, eps_val)
