// Epistemic type checking for Knowledge[T, epsilon, validity, provenance]
//
// Provides type-level support for the 4-layer epistemic type:
//   Knowledge[T, epsilon < bound, Valid(...), Provenance]
//
// Functions:
//   check_knowledge_type      — validate and lower a KnowledgeTypeInfo AST node
//   check_knowledge_unwrap    — extract inner type from Knowledge wrapper
//   is_knowledge_type         — predicate
//   knowledge_inner           — extract wrapped type entry
//   check_knowledge_epsilon   — field access for epsilon
//   check_knowledge_epsilon_of — epsilonOf intrinsic
//
// Provenance tracking:
//   ProvenanceKind enum       — source classification
//   Provenance struct         — source metadata
//   provenance_new            — constructor
//
// Validity conditions:
//   ValidityKind enum         — validity classification
//   Validity struct           — validity metadata
//   validity_always           — always valid constructor
//   validity_duration         — duration-based validity
//
// Knowledge metadata:
//   KnowledgeMeta struct      — combined epsilon, validity, provenance
//   knowledge_meta_from_ty    — extract from type
//
// Confidence subsumption:
//   epsilon_subsumes          — lattice ordering (lower = more confident)
//   knowledge_compatible      — type compatibility with epsilon ordering
//
// Epsilon propagation:
//   epsilon_combine_independent — add for independent errors
//   epsilon_combine_correlated  — max for correlated errors
//   knowledge_binary_result     — binary op epsilon propagation

// ============================================================
// Knowledge type construction and validation
// ============================================================

fn check_knowledge_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    // Lower the inner type
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    // Validate metadata constraints that we can prove at type-check time.
    // (TypeEntry does not yet persist full validity/provenance metadata.)
    if !knowledge_metadata_is_valid(info.validity) {
        c = c.report_error_at(Span::dummy(), 54, 0, 0, 0)
    }
    let meta = knowledge_meta_from_type_info(info)
    if !knowledge_meta_is_valid(meta) {
        c = c.report_error_at(Span::dummy(), 54, 0, 0, 0)
    }

    // Validate epsilon bound if present
    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_knowledge(inner_ty, eps_val)
    (c, ty)
}

fn check_intervention_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_intervention(inner_ty, eps_val)
    (c, ty)
}

fn check_counterfactual_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_counterfactual(inner_ty, eps_val)
    (c, ty)
}

fn check_validated_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span::dummy(), 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_validated(inner_ty, eps_val)
    (c, ty)
}

fn knowledge_validity_expr_non_negative(opt: Option<Box<Expr>>) -> bool {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                return (*e).int_val >= 0
            }
            if (*e).kind == ExprKind::ExprFloatLit {
                return (*e).float_val >= 0.0
            }
            true
        }
        None => false
    }
}

fn knowledge_metadata_is_valid(validity_opt: Option<Box<ValidityCondition>>) -> bool {
    match validity_opt {
        Some(vc) => knowledge_validity_expr_non_negative((*vc).expr)
        None => true
    }
}

fn validity_from_ast(opt: Option<Box<ValidityCondition>>) -> Validity {
    match opt {
        Some(vc) => {
            let value = if knowledge_validity_expr_non_negative((*vc).expr) {
                knowledge_validity_expr_to_f64((*vc).expr)
            } else {
                0.0
            }
            match (*vc).kind {
                AstValidityKind::ValidDuration => validity_duration(value)
                AstValidityKind::ValidUntilTime => validity_until(value)
                AstValidityKind::ValidWhileCond => validity_while()
            }
        }
        None => validity_always()
    }
}

fn knowledge_validity_expr_to_f64(opt: Option<Box<Expr>>) -> f64 {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                (*e).int_val as f64
            } else if (*e).kind == ExprKind::ExprFloatLit {
                (*e).float_val
            } else {
                0.0
            }
        }
        None => 0.0
    }
}

// ============================================================
// Provenance tracking
// ============================================================

// Classification of knowledge sources for audit trails
// and trust boundary tracking
enum ProvenanceKind {
    ProvDerived,    // Derived from other Knowledge via computation
    ProvSource,     // Original authoritative source
    ProvComputed,   // Algorithmic computation result
    ProvLiterature, // Published literature reference
    ProvMeasured,   // Physical measurement or sensor data
    ProvInput       // External user/system input
}

// Provenance metadata tracking source and lineage
struct Provenance {
    kind: ProvenanceKind,
    source_id: i64
}

// Construct provenance with a specific kind
// source_id is initialized to 0 (unknown)
fn provenance_new(kind: ProvenanceKind) -> Provenance {
    Provenance {
        kind: kind,
        source_id: 0
    }
}

// Construct provenance with explicit source identifier
fn provenance_with_source(kind: ProvenanceKind, source_id: i64) -> Provenance {
    Provenance {
        kind: kind,
        source_id: source_id
    }
}

fn provenance_from_ast(opt: Option<Box<AstProvenanceKind>>) -> Provenance {
    match opt {
        Some(p) => {
            match *p {
                AstProvenanceKind::AstProvDerived => provenance_new(ProvenanceKind::ProvDerived)
                AstProvenanceKind::AstProvSource => provenance_new(ProvenanceKind::ProvSource)
                AstProvenanceKind::AstProvComputed => provenance_new(ProvenanceKind::ProvComputed)
                AstProvenanceKind::AstProvLiterature => provenance_new(ProvenanceKind::ProvLiterature)
                AstProvenanceKind::AstProvMeasured => provenance_new(ProvenanceKind::ProvMeasured)
                AstProvenanceKind::AstProvInput => provenance_new(ProvenanceKind::ProvInput)
            }
        }
        None => provenance_new(ProvenanceKind::ProvDerived)
    }
}

fn knowledge_meta_from_type_info(info: KnowledgeTypeInfo) -> KnowledgeMeta {
    let base_eps = match info.epsilon {
        Some(eb) => (*eb).value
        None => -1.0
    }
    knowledge_meta_full(base_eps, validity_from_ast(info.validity), provenance_from_ast(info.provenance))
}

// ============================================================
// Knowledge type queries
// ============================================================

fn is_knowledge_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge
}

fn is_intervention_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyIntervention
}

fn is_counterfactual_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyCounterfactual
}

fn is_validated_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyValidated
}

fn is_epistemic_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge || ty.kind == TypeKind::TyIntervention || ty.kind == TypeKind::TyCounterfactual || ty.kind == TypeKind::TyValidated
}

fn knowledge_inner(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    match ty.inner {
        Some(inner_box) => *inner_box
        None => ty_error()
    }
}

fn check_knowledge_unwrap(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if is_knowledge_type(ty) {
        knowledge_inner(ty)
    } else {
        ty_error()
    }
}

fn check_knowledge_epsilon(ty: TypeEntry) -> TypeEntry {
    // .epsilon field access on Knowledge<T> returns f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

fn check_knowledge_epsilon_of(ty: TypeEntry) -> TypeEntry {
    // epsilonOf(k) returns the epsilon bound as f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

// Check if provenance is from a trusted source
fn provenance_is_trusted(prov: Provenance) -> bool {
    match prov.kind {
        ProvenanceKind::ProvSource => true,
        ProvenanceKind::ProvLiterature => true,
        ProvenanceKind::ProvMeasured => true,
        ProvenanceKind::ProvDerived => false,
        ProvenanceKind::ProvComputed => false,
        ProvenanceKind::ProvInput => false
    }
}

// Get string representation of provenance kind
fn provenance_kind_name(kind: ProvenanceKind) -> String with Alloc {
    match kind {
        ProvenanceKind::ProvDerived => "derived",
        ProvenanceKind::ProvSource => "source",
        ProvenanceKind::ProvComputed => "computed",
        ProvenanceKind::ProvLiterature => "literature",
        ProvenanceKind::ProvMeasured => "measured",
        ProvenanceKind::ProvInput => "input"
    }
}

// Check if provenance kind requires verification
fn provenance_kind_needs_verification(kind: ProvenanceKind) -> bool {
    match kind {
        ProvenanceKind::ProvInput => true,
        ProvenanceKind::ProvMeasured => true,
        ProvenanceKind::ProvDerived => false,
        ProvenanceKind::ProvSource => false,
        ProvenanceKind::ProvComputed => false,
        ProvenanceKind::ProvLiterature => false
    }
}

// Compare two provenance entries for equality
fn provenance_eq(a: Provenance, b: Provenance) -> bool {
    a.kind == b.kind && a.source_id == b.source_id
}

// ============================================================
// Validity conditions (lines 151-220)
// ============================================================

// Classification of validity conditions for knowledge
// Determines when knowledge remains valid/usable
const VALIDITY_KIND_ALWAYS: i64 = 0
const VALIDITY_KIND_DURATION: i64 = 1
const VALIDITY_KIND_UNTIL_TIME: i64 = 2
const VALIDITY_KIND_WHILE_COND: i64 = 3

// Validity metadata for knowledge temporal bounds
struct Validity {
    kind: i64,
    duration_sec: f64,
    until_timestamp: f64
}

// Create always-valid validity (no expiration)
fn validity_always() -> Validity {
    Validity {
        kind: VALIDITY_KIND_ALWAYS,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Create duration-based validity
fn validity_duration(seconds: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_DURATION,
        duration_sec: seconds,
        until_timestamp: 0.0
    }
}

// Create timestamp-based validity (valid until specific time)
fn validity_until(timestamp: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_UNTIL_TIME,
        duration_sec: 0.0,
        until_timestamp: timestamp
    }
}

// Create condition-based validity
fn validity_while() -> Validity {
    Validity {
        kind: VALIDITY_KIND_WHILE_COND,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Check if validity has expired based on current time
fn validity_is_expired(validity: Validity, current_time: f64) -> bool {
    match validity.kind {
        VALIDITY_KIND_ALWAYS => false,
        VALIDITY_KIND_DURATION => false,  // Need creation time to check
        VALIDITY_KIND_UNTIL_TIME => current_time > validity.until_timestamp,
        VALIDITY_KIND_WHILE_COND => false  // Condition checked at runtime
    }
}

// Get a conservative validity that combines two validity constraints
fn validity_intersect(a: Validity, b: Validity) -> Validity {
    // The intersection is the more restrictive of the two
    match a.kind {
        VALIDITY_KIND_ALWAYS => b,
        VALIDITY_KIND_DURATION => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_DURATION => {
                    if a.duration_sec < b.duration_sec { a } else { b }
                }
                VALIDITY_KIND_UNTIL_TIME => b,
                VALIDITY_KIND_WHILE_COND => b
            }
        }
        VALIDITY_KIND_UNTIL_TIME => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_UNTIL_TIME => {
                    if a.until_timestamp < b.until_timestamp { a } else { b }
                }
                _ => a
            }
        }
        VALIDITY_KIND_WHILE_COND => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                _ => b
            }
        }
    }
}

// ============================================================
// Knowledge metadata (lines 221-300)
// ============================================================

// Combined metadata for Knowledge types including
// epsilon bound, validity conditions, and provenance
struct KnowledgeMeta {
    epsilon: f64,
    validity: Validity,
    provenance: Provenance
}

// Create default metadata with always-valid and unknown provenance
fn knowledge_meta_default(epsilon: f64) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance_new(ProvenanceKind::ProvDerived)
    }
}

// Create metadata from type entry
// Extracts epsilon from Knowledge types, uses defaults otherwise
fn knowledge_meta_from_ty(ty: TypeEntry) -> KnowledgeMeta with Mut, Panic, Div, Alloc {
    match ty.kind {
        TypeKind::TyKnowledge => {
            let eps = ty.knowledge_epsilon
            KnowledgeMeta {
                epsilon: eps,
                validity: validity_always(),
                provenance: provenance_new(ProvenanceKind::ProvDerived)
            }
        }
        TypeKind::TyIntervention => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(ProvenanceKind::ProvDerived)
            }
        }
        TypeKind::TyCounterfactual => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(ProvenanceKind::ProvDerived)
            }
        }
        TypeKind::TyValidated => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(ProvenanceKind::ProvDerived)
            }
        }
        _ => knowledge_meta_default(-1.0)
    }
}

// Create metadata with specified validity
fn knowledge_meta_with_validity(epsilon: f64, validity: Validity) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance_new(ProvenanceKind::ProvDerived)
    }
}

// Create metadata with specified provenance
fn knowledge_meta_with_provenance(epsilon: f64, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance
    }
}

// Create fully specified metadata
fn knowledge_meta_full(epsilon: f64, validity: Validity, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance
    }
}

// Get epsilon from knowledge metadata
fn knowledge_meta_epsilon(meta: KnowledgeMeta) -> f64 {
    meta.epsilon
}

// Get validity from knowledge metadata
fn knowledge_meta_validity(meta: KnowledgeMeta) -> Validity {
    meta.validity
}

// Get provenance from knowledge metadata
fn knowledge_meta_provenance(meta: KnowledgeMeta) -> Provenance {
    meta.provenance
}

fn epsilon_is_valid(eps: f64) -> bool {
    eps >= 0.0 && eps <= 1.0
}

// Check if metadata represents valid knowledge
fn knowledge_meta_is_valid(meta: KnowledgeMeta) -> bool {
    epsilon_is_valid(meta.epsilon)
}

// ============================================================
// Confidence subsumption lattice (lines 301-380)
// ============================================================

// Confidence subsumption: lower epsilon = higher confidence
// epsilon_subsumes(eps_a, eps_b) returns true if a is at least as
// confident as b (eps_a <= eps_b)
//
// This defines a partial order where:
//   0.0 (certain) > 0.1 > 0.5 > 1.0 (unknown)
//
// Returns true if eps_a <= eps_b
fn epsilon_subsumes(eps_a: f64, eps_b: f64) -> bool {
    eps_a <= eps_b
}

// Function-call boundaries fail closed on unknown/invalid provided epsilon.
// Required epsilon < 0.0 means "unspecified requirement".
fn epsilon_subsumes_call_boundary(provided_eps: f64, required_eps: f64) -> bool {
    if !epsilon_is_valid(provided_eps) {
        return false
    }
    if required_eps < 0.0 {
        return true
    }
    if !epsilon_is_valid(required_eps) {
        return false
    }
    epsilon_subsumes(provided_eps, required_eps)
}

// Get the more confident (lower) epsilon
fn epsilon_meet(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a < eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Get the less confident (higher) epsilon
fn epsilon_join(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a > eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Check if two knowledge types are compatible
// Compatible if:
//   1. Inner types match (structural equality)
//   2. Epsilon subsumption holds (a is at least as confident as b)
//
// Returns true if ty_a can be used where ty_b is expected
fn knowledge_compatible(ty_a: TypeEntry, ty_b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    let inner_a = knowledge_inner(ty_a)
    let inner_b = knowledge_inner(ty_b)

    // Check inner types match
    let types_match = types_equal(inner_a, inner_b)
    if !types_match {
        false
    } else {
        // Check epsilon subsumption
        epsilon_subsumes(ty_a.knowledge_epsilon, ty_b.knowledge_epsilon)
    }
}

// Check type equality (structural)
fn types_equal(a: TypeEntry, b: TypeEntry) -> bool {
    if a.kind != b.kind {
        false
    } else {
        match (a.inner, b.inner) {
            (Some(inner_a), Some(inner_b)) => types_equal(*inner_a, *inner_b),
            (None, None) => true,
            _ => false
        }
    }
}

// Check if knowledge type meets epsilon requirement
fn knowledge_meets_epsilon(ty: TypeEntry, required_epsilon: f64) -> bool {
    if is_knowledge_type(ty) {
        epsilon_subsumes(ty.knowledge_epsilon, required_epsilon)
    } else {
        false
    }
}

// Subsumption for provenance
fn provenance_subsumes(provided: Provenance, required: Provenance) -> bool {
    // If caller requires a trusted source, callee argument must be trusted.
    if provenance_is_trusted(required) {
        provenance_is_trusted(provided)
    } else {
        true
    }
}

// Subsumption for validity
fn validity_subsumes(provided: Validity, required: Validity) -> bool {
    if required.kind == VALIDITY_KIND_ALWAYS {
        return provided.kind == VALIDITY_KIND_ALWAYS
    }
    if required.kind == VALIDITY_KIND_DURATION {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_DURATION {
            return provided.duration_sec >= required.duration_sec
        }
        return false
    }
    if required.kind == VALIDITY_KIND_UNTIL_TIME {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_UNTIL_TIME {
            return provided.until_timestamp >= required.until_timestamp
        }
        return false
    }
    if required.kind == VALIDITY_KIND_WHILE_COND {
        return provided.kind == VALIDITY_KIND_ALWAYS || provided.kind == VALIDITY_KIND_WHILE_COND
    }
    false
}

// ============================================================
// Epsilon propagation (lines 381-480)
// ============================================================

// Clamp epsilon to valid range [0.0, 1.0]
fn epsilon_clamp(eps: f64) -> f64 {
    if eps < 0.0 {
        0.0
    } else if eps > 1.0 {
        1.0
    } else {
        eps
    }
}

// Approximate sqrt for values in [0, 2] using one Newton iteration
// Initial guess: x/2 + 0.5, then refine: (guess + x/guess) / 2
fn sqrt_approx(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x * 0.5 + 0.5
    guess = (guess + x / guess) * 0.5
    epsilon_clamp(guess)
}

// Combine independent errors: sqrt(eps_a^2 + eps_b^2)
// Quadrature sum for independent random variables (standard error propagation)
// Clamped to [0.0, 1.0]
fn epsilon_combine_independent(eps_a: f64, eps_b: f64) -> f64 with Mut, Panic, Div {
    let sum_sq = eps_a * eps_a + eps_b * eps_b
    sqrt_approx(sum_sq)
}

// Combine correlated errors: eps_a + eps_b (linear sum, conservative)
// For perfectly correlated or unknown correlation, linear sum is the
// sound upper bound.
fn epsilon_combine_correlated(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine relative errors for multiplication/division
// Relative errors add: (da/a) + (db/b)
fn epsilon_combine_relative(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine errors with unknown correlation (most conservative)
// Defaults to linear sum — sound upper bound for any correlation rho in [0,1]
fn epsilon_combine_unknown(eps_a: f64, eps_b: f64) -> f64 {
    epsilon_combine_correlated(eps_a, eps_b)
}

// Weighted combination for weighted averages
fn epsilon_combine_weighted(eps_a: f64, eps_b: f64, weight_a: f64, weight_b: f64) -> f64 with Panic, Div {
    let weighted_sum = weight_a * eps_a + weight_b * eps_b
    let total_weight = weight_a + weight_b
    if total_weight == 0.0 {
        1.0
    } else {
        epsilon_clamp(weighted_sum / total_weight)
    }
}

// BinaryOp enum is defined in parser/ast.sio and shared via concatenation.
// When checking this file standalone, the pinned binary's resolver provides it.

// Compute result type for binary operations on Knowledge types
// Handles epsilon propagation according to operation semantics
fn knowledge_binary_result(op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    // If neither operand is Knowledge, return error
    let left_is_knowledge = is_knowledge_type(left_ty)
    let right_is_knowledge = is_knowledge_type(right_ty)

    if !left_is_knowledge && !right_is_knowledge {
        ty_error()
    } else {
        // Extract inner types and epsilons
        let left_inner = if left_is_knowledge {
            knowledge_inner(left_ty)
        } else {
            left_ty
        }
        let right_inner = if right_is_knowledge {
            knowledge_inner(right_ty)
        } else {
            right_ty
        }

        let left_eps = if left_is_knowledge {
            left_ty.knowledge_epsilon
        } else {
            0.0
        }
        let right_eps = if right_is_knowledge {
            right_ty.knowledge_epsilon
        } else {
            0.0
        }

        if !knowledge_op_supported(op) {
            return ty_error()
        }

        if !types_compatible(left_inner, right_inner) {
            return ty_error()
        }

        // Determine result epsilon based on operation
        let result_epsilon = match op {
            BinaryOp::OpAdd => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpSub => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpMul => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpDiv => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpRem => epsilon_combine_independent(left_eps, right_eps),
            _ => 0.0
        }

        // Determine result type based on operation
        match op {
            // Comparisons on Knowledge require explicit unwrap.
            BinaryOp::OpEq => ty_error(),
            BinaryOp::OpNe => ty_error(),
            BinaryOp::OpLt => ty_error(),
            BinaryOp::OpLe => ty_error(),
            BinaryOp::OpGt => ty_error(),
            BinaryOp::OpGe => ty_error(),
            // All other operations return Knowledge with combined epsilon
            _ => {
                // For arithmetic operations, result is Knowledge with combined epsilon
                // Inner type is the same as input inner types (assuming they match)
                ty_knowledge(left_inner, result_epsilon)
            }
        }
    }
}

// Check if binary operation is supported for Knowledge types
fn knowledge_op_supported(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpAdd => true,
        BinaryOp::OpSub => true,
        BinaryOp::OpMul => true,
        BinaryOp::OpDiv => true,
        BinaryOp::OpRem => true,
        BinaryOp::OpEq => false,
        BinaryOp::OpNe => false,
        BinaryOp::OpLt => false,
        BinaryOp::OpLe => false,
        BinaryOp::OpGt => false,
        BinaryOp::OpGe => false,
        BinaryOp::OpAnd => false,  // Logical ops not supported for Knowledge directly
        BinaryOp::OpOr => false,
        BinaryOp::OpBitAnd => false,
        BinaryOp::OpBitOr => false,
        BinaryOp::OpBitXor => false,
        BinaryOp::OpShl => false,  // Shift not typically used with Knowledge
        BinaryOp::OpShr => false,
        BinaryOp::OpConcat => false,
        BinaryOp::OpRange => false,
        BinaryOp::OpRangeInclusive => false
    }
}

// ============================================================
// Call boundary compatibility (lines 481-500)
// ============================================================

// Check knowledge compatibility at function call boundaries
// Considers epsilon, validity, and provenance
fn knowledge_call_boundary_compatible(provided: TypeEntry, required: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if !is_epistemic_type(provided) || !is_epistemic_type(required) {
        return false
    }
    if !types_equal(knowledge_inner(provided), knowledge_inner(required)) {
        return false
    }
    let pmeta = knowledge_meta_from_ty(provided)
    let rmeta = knowledge_meta_from_ty(required)
    if !epsilon_subsumes_call_boundary(knowledge_meta_epsilon(pmeta), knowledge_meta_epsilon(rmeta)) {
        return false
    }
    if !validity_subsumes(knowledge_meta_validity(pmeta), knowledge_meta_validity(rmeta)) {
        return false
    }
    provenance_subsumes(knowledge_meta_provenance(pmeta), knowledge_meta_provenance(rmeta))
}

// ============================================================
// Contest / Policy / Robust type checkers
// ============================================================

fn check_contest_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_contest(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

fn check_policy_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_policy(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

fn check_robust_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_robust(inner_ty, -1, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}
