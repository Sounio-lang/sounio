    if exh_test_get_returns_correct_pattern() { pass = pass + 1 } else { fail = fail + 1 }
    if exh_test_bool_both_arms_exhaustive() { pass = pass + 1 } else { fail = fail + 1 }
    if exh_test_bool_true_only_not_exhaustive() { pass = pass + 1 } else { fail = fail + 1 }
