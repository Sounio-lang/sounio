    if exh_test_enum_wildcard_exhaustive() { pass = pass + 1 } else { fail = fail + 1 }
    if exh_test_enum_variable_wildcard_exhaustive() { pass = pass + 1 } else { fail = fail + 1 }
    if exh_test_enum_full_5_exhaustive() { pass = pass + 1 } else { fail = fail + 1 }
    if exh_test_enum_skip_last_missing() { pass = pass + 1 } else { fail = fail + 1 }
