// Effect processing for type checker
//
// Converts parsed EffectList from AST to effect ID arrays in FnSig.
// Effect IDs are EffectKind discriminants in declaration order (ID order,
// not the historical source-arm order).
//
// Production ids 0-22 (phase 2a, unchanged):
//   0=IO 1=Mut 2=Alloc 3=Panic 4=Div 5=GPU 6=Async 7=Prob
//   8=Epistemic 9=Causal 10=Network 11=Sensor 12=Render 13=Observe
//   14=NonAssoc 15=Audit 16=Hypothesis 17=MultiTest 18=ZD 19=Witness
//   20=Temporal 21=Learn 22=Chaotic
//
// Production ids 23-28 (phase 2b). These are NEW consecutive ids.
// They are NOT seed FN_EFFECTS bits. Mixing the two numberings
// silently aliases Perturbative onto Chaotic (production id 22).
//   23=Approx          seed bit 18 = 262144
//   24=NaturalityG2    seed bit 20 = 1048576
//   25=Deterministic   seed bit 12 = 4096
//   26=Perturbative    stdlib comment "bit 23" = 8388608 (a BIT, not id 23)
//   27=NarrowWidthApproximation  stdlib comment "bit 24" = 16777216
//   28=NonUnitary      stdlib comment "bit 22" = 4194304 (a BIT; id 22 is Chaotic)
//
// Mod is HELD, not forgotten (founder 2026-08-19, hold_mod_claude1).
// 360 files / 2800 `with Mod` still return -1. If those sites are Mut
// misspellings, adding Mod would consecrate the error. No reserved
// hole: a vacant id invites someone to fill it.
//
// Confidence is an alias of Epistemic (id 8). Same id, not a new variant.
//
// EffVar is the row-polymorphism slot (discriminant 29 after 2b hold).
// It is not a user-facing `with` name and effect_name_to_id never returns it.

// ============================================================
// Production effect enum — ID order
// ============================================================

enum EffectKind {
    EffIO,
    EffMut,
    EffAlloc,
    EffPanic,
    EffDiv,
    EffGPU,
    EffAsync,
    EffProb,
    EffEpistemic,
    EffCausal,
    EffNetwork,
    EffSensor,
    EffRender,
    EffObserve,
    EffNonAssoc,
    EffAudit,
    EffHypothesis,
    EffMultiTest,
    EffZD,
    EffWitness,
    EffTemporal,
    EffLearn,
    EffChaotic,
    EffApprox,
    EffNaturalityG2,
    EffDeterministic,
    EffPerturbative,
    EffNarrowWidthApproximation,
    EffNonUnitary,
    EffVar,
}

fn effect_named_id_max() -> i64 {
    28
}

fn effect_kind_name_len(k: i64) -> i64 {
    if k == 0 { 2 }
    else if k == 1 { 3 }
    else if k == 2 { 5 }
    else if k == 3 { 5 }
    else if k == 4 { 3 }
    else if k == 5 { 3 }
    else if k == 6 { 5 }
    else if k == 7 { 4 }
    else if k == 8 { 9 }
    else if k == 9 { 6 }
    else if k == 10 { 7 }
    else if k == 11 { 6 }
    else if k == 12 { 6 }
    else if k == 13 { 7 }
    else if k == 14 { 8 }
    else if k == 15 { 5 }
    else if k == 16 { 10 }
    else if k == 17 { 9 }
    else if k == 18 { 2 }
    else if k == 19 { 7 }
    else if k == 20 { 8 }
    else if k == 21 { 5 }
    else if k == 22 { 7 }
    else if k == 23 { 6 }
    else if k == 24 { 12 }
    else if k == 25 { 13 }
    else if k == 26 { 12 }
    else if k == 27 { 24 }
    else if k == 28 { 10 }
    else { 0 }
}

fn effect_kind_name_byte(k: i64, i: i64) -> i8 {
    if k == 0 {
        if i == 0 { 73 as i8 } else { 79 as i8 }
    } else if k == 1 {
        if i == 0 { 77 as i8 } else if i == 1 { 117 as i8 } else { 116 as i8 }
    } else if k == 2 {
        if i == 0 { 65 as i8 } else if i == 1 { 108 as i8 } else if i == 2 { 108 as i8 } else if i == 3 { 111 as i8 } else { 99 as i8 }
    } else if k == 3 {
        if i == 0 { 80 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 105 as i8 } else { 99 as i8 }
    } else if k == 4 {
        if i == 0 { 68 as i8 } else if i == 1 { 105 as i8 } else { 118 as i8 }
    } else if k == 5 {
        if i == 0 { 71 as i8 } else if i == 1 { 80 as i8 } else { 85 as i8 }
    } else if k == 6 {
        if i == 0 { 65 as i8 } else if i == 1 { 115 as i8 } else if i == 2 { 121 as i8 } else if i == 3 { 110 as i8 } else { 99 as i8 }
    } else if k == 7 {
        if i == 0 { 80 as i8 } else if i == 1 { 114 as i8 } else if i == 2 { 111 as i8 } else { 98 as i8 }
    } else if k == 8 {
        if i == 0 { 69 as i8 } else if i == 1 { 112 as i8 } else if i == 2 { 105 as i8 } else if i == 3 { 115 as i8 } else if i == 4 { 116 as i8 } else if i == 5 { 101 as i8 } else if i == 6 { 109 as i8 } else if i == 7 { 105 as i8 } else { 99 as i8 }
    } else if k == 9 {
        if i == 0 { 67 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 117 as i8 } else if i == 3 { 115 as i8 } else if i == 4 { 97 as i8 } else { 108 as i8 }
    } else if k == 10 {
        if i == 0 { 78 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 119 as i8 } else if i == 4 { 111 as i8 } else if i == 5 { 114 as i8 } else { 107 as i8 }
    } else if k == 11 {
        if i == 0 { 83 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 115 as i8 } else if i == 4 { 111 as i8 } else { 114 as i8 }
    } else if k == 12 {
        if i == 0 { 82 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 100 as i8 } else if i == 4 { 101 as i8 } else { 114 as i8 }
    } else if k == 13 {
        if i == 0 { 79 as i8 } else if i == 1 { 98 as i8 } else if i == 2 { 115 as i8 } else if i == 3 { 101 as i8 } else if i == 4 { 114 as i8 } else if i == 5 { 118 as i8 } else { 101 as i8 }
    } else if k == 14 {
        if i == 0 { 78 as i8 } else if i == 1 { 111 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 65 as i8 } else if i == 4 { 115 as i8 } else if i == 5 { 115 as i8 } else if i == 6 { 111 as i8 } else { 99 as i8 }
    } else if k == 15 {
        if i == 0 { 65 as i8 } else if i == 1 { 117 as i8 } else if i == 2 { 100 as i8 } else if i == 3 { 105 as i8 } else { 116 as i8 }
    } else if k == 16 {
        if i == 0 { 72 as i8 } else if i == 1 { 121 as i8 } else if i == 2 { 112 as i8 } else if i == 3 { 111 as i8 } else if i == 4 { 116 as i8 } else if i == 5 { 104 as i8 } else if i == 6 { 101 as i8 } else if i == 7 { 115 as i8 } else if i == 8 { 105 as i8 } else { 115 as i8 }
    } else if k == 17 {
        if i == 0 { 77 as i8 } else if i == 1 { 117 as i8 } else if i == 2 { 108 as i8 } else if i == 3 { 116 as i8 } else if i == 4 { 105 as i8 } else if i == 5 { 84 as i8 } else if i == 6 { 101 as i8 } else if i == 7 { 115 as i8 } else { 116 as i8 }
    } else if k == 18 {
        if i == 0 { 90 as i8 } else { 68 as i8 }
    } else if k == 19 {
        if i == 0 { 87 as i8 } else if i == 1 { 105 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 110 as i8 } else if i == 4 { 101 as i8 } else if i == 5 { 115 as i8 } else { 115 as i8 }
    } else if k == 20 {
        if i == 0 { 84 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 109 as i8 } else if i == 3 { 112 as i8 } else if i == 4 { 111 as i8 } else if i == 5 { 114 as i8 } else if i == 6 { 97 as i8 } else { 108 as i8 }
    } else if k == 21 {
        if i == 0 { 76 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 97 as i8 } else if i == 3 { 114 as i8 } else { 110 as i8 }
    } else if k == 22 {
        if i == 0 { 67 as i8 } else if i == 1 { 104 as i8 } else if i == 2 { 97 as i8 } else if i == 3 { 111 as i8 } else if i == 4 { 116 as i8 } else if i == 5 { 105 as i8 } else { 99 as i8 }
    } else if k == 23 {
        if i == 0 { 65 as i8 } else if i == 1 { 112 as i8 } else if i == 2 { 112 as i8 } else if i == 3 { 114 as i8 } else if i == 4 { 111 as i8 } else { 120 as i8 }
    } else if k == 24 {
        if i == 0 { 78 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 117 as i8 } else if i == 4 { 114 as i8 } else if i == 5 { 97 as i8 } else if i == 6 { 108 as i8 } else if i == 7 { 105 as i8 } else if i == 8 { 116 as i8 } else if i == 9 { 121 as i8 } else if i == 10 { 71 as i8 } else { 50 as i8 }
    } else if k == 25 {
        if i == 0 { 68 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 101 as i8 } else if i == 4 { 114 as i8 } else if i == 5 { 109 as i8 } else if i == 6 { 105 as i8 } else if i == 7 { 110 as i8 } else if i == 8 { 105 as i8 } else if i == 9 { 115 as i8 } else if i == 10 { 116 as i8 } else if i == 11 { 105 as i8 } else { 99 as i8 }
    } else if k == 26 {
        if i == 0 { 80 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 114 as i8 } else if i == 3 { 116 as i8 } else if i == 4 { 117 as i8 } else if i == 5 { 114 as i8 } else if i == 6 { 98 as i8 } else if i == 7 { 97 as i8 } else if i == 8 { 116 as i8 } else if i == 9 { 105 as i8 } else if i == 10 { 118 as i8 } else { 101 as i8 }
    } else if k == 27 {
        if i == 0 { 78 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 114 as i8 } else if i == 3 { 114 as i8 } else if i == 4 { 111 as i8 } else if i == 5 { 119 as i8 } else if i == 6 { 87 as i8 } else if i == 7 { 105 as i8 } else if i == 8 { 100 as i8 } else if i == 9 { 116 as i8 } else if i == 10 { 104 as i8 } else if i == 11 { 65 as i8 } else if i == 12 { 112 as i8 } else if i == 13 { 112 as i8 } else if i == 14 { 114 as i8 } else if i == 15 { 111 as i8 } else if i == 16 { 120 as i8 } else if i == 17 { 105 as i8 } else if i == 18 { 109 as i8 } else if i == 19 { 97 as i8 } else if i == 20 { 116 as i8 } else if i == 21 { 105 as i8 } else if i == 22 { 111 as i8 } else { 110 as i8 }
    } else if k == 28 {
        if i == 0 { 78 as i8 } else if i == 1 { 111 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 85 as i8 } else if i == 4 { 110 as i8 } else if i == 5 { 105 as i8 } else if i == 6 { 116 as i8 } else if i == 7 { 97 as i8 } else if i == 8 { 114 as i8 } else { 121 as i8 }
    } else {
        0 as i8
    }
}

// ============================================================
// Effect name to ID mapping — enum lookup, not 23 handwritten arms
// ============================================================

fn name_is_confidence(name_buf: [i8; 64], name_len: i64) -> bool {
    if name_len != 10 { return false }
    if name_buf[0] != 67 as i8 { return false }
    if name_buf[1] != 111 as i8 { return false }
    if name_buf[2] != 110 as i8 { return false }
    if name_buf[3] != 102 as i8 { return false }
    if name_buf[4] != 105 as i8 { return false }
    if name_buf[5] != 100 as i8 { return false }
    if name_buf[6] != 101 as i8 { return false }
    if name_buf[7] != 110 as i8 { return false }
    if name_buf[8] != 99 as i8 { return false }
    if name_buf[9] != 101 as i8 { return false }
    true
}

pub fn effect_name_to_id(name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    // Confidence is an alias of Epistemic (id 8). Not a new variant.
    if name_is_confidence(name_buf, name_len) {
        return 8
    }
    var k: i64 = 0
    let last = effect_named_id_max()
    while k <= last {
        let nlen = effect_kind_name_len(k)
        if nlen == name_len {
            var i: i64 = 0
            var ok = true
            while i < nlen {
                if name_buf[i as usize] != effect_kind_name_byte(k, i) {
                    ok = false
                }
                i = i + 1
            }
            if ok {
                return k
            }
        }
        k = k + 1
    }
    0 - 1
}

// ============================================================
// Extract effects from EffectList
// ============================================================

pub fn collect_effects_from_list(list: EffectList, effects: [i64; 8], count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var effs = effects
    var n = count

    // Convert this effect to ID
    let eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)

    // Add if valid and not duplicate
    if eff_id >= 0 && n < 8 {
        var already_present = false
        var i: i64 = 0
        while i < n {
            if effs[i as usize] == eff_id {
                already_present = true
            }
            i = i + 1
        }

        if !already_present {
            effs[n as usize] = eff_id
            n = n + 1
        }
    }

    // Process tail
    match list.tail {
        None => (effs, n)
        Some(next) => collect_effects_from_list(*next, effs, n)
    }
}

pub fn extract_effects(opt: Option<Box<EffectList>>) -> ([i64; 8], i64) with Mut, Panic, Div {
    match opt {
        None => ([0; 8], 0)
        Some(list) => collect_effects_from_list(*list, [0; 8], 0)
    }
}

// ============================================================
// Effect checking helpers (for future use)
// ============================================================

// Check if effect ID is present in array
pub fn has_effect_id(effects: [i64; 8], count: i64, target_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        if effects[i as usize] == target_id {
            return true
        }
        i = i + 1
    }
    false
}

// Check if required effects are subset of declared effects
pub fn effects_subset(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) {
            return false
        }
        i = i + 1
    }
    true
}

// Print one ASCII byte. The print table is the lookup table: print_effect_name
// walks effect_kind_name_byte so an id with a name cannot fall through to
// Effect#N. Digits + A-Z + a-z; anything else is the generic fallback.
fn print_ascii_i8(b: i8) with IO {
    let c = b as i64
    if c == 48 { print("0") }
    else if c == 49 { print("1") }
    else if c == 50 { print("2") }
    else if c == 51 { print("3") }
    else if c == 52 { print("4") }
    else if c == 53 { print("5") }
    else if c == 54 { print("6") }
    else if c == 55 { print("7") }
    else if c == 56 { print("8") }
    else if c == 57 { print("9") }
    else if c == 65 { print("A") }
    else if c == 66 { print("B") }
    else if c == 67 { print("C") }
    else if c == 68 { print("D") }
    else if c == 69 { print("E") }
    else if c == 70 { print("F") }
    else if c == 71 { print("G") }
    else if c == 72 { print("H") }
    else if c == 73 { print("I") }
    else if c == 74 { print("J") }
    else if c == 75 { print("K") }
    else if c == 76 { print("L") }
    else if c == 77 { print("M") }
    else if c == 78 { print("N") }
    else if c == 79 { print("O") }
    else if c == 80 { print("P") }
    else if c == 81 { print("Q") }
    else if c == 82 { print("R") }
    else if c == 83 { print("S") }
    else if c == 84 { print("T") }
    else if c == 85 { print("U") }
    else if c == 86 { print("V") }
    else if c == 87 { print("W") }
    else if c == 88 { print("X") }
    else if c == 89 { print("Y") }
    else if c == 90 { print("Z") }
    else if c == 97 { print("a") }
    else if c == 98 { print("b") }
    else if c == 99 { print("c") }
    else if c == 100 { print("d") }
    else if c == 101 { print("e") }
    else if c == 102 { print("f") }
    else if c == 103 { print("g") }
    else if c == 104 { print("h") }
    else if c == 105 { print("i") }
    else if c == 106 { print("j") }
    else if c == 107 { print("k") }
    else if c == 108 { print("l") }
    else if c == 109 { print("m") }
    else if c == 110 { print("n") }
    else if c == 111 { print("o") }
    else if c == 112 { print("p") }
    else if c == 113 { print("q") }
    else if c == 114 { print("r") }
    else if c == 115 { print("s") }
    else if c == 116 { print("t") }
    else if c == 117 { print("u") }
    else if c == 118 { print("v") }
    else if c == 119 { print("w") }
    else if c == 120 { print("x") }
    else if c == 121 { print("y") }
    else if c == 122 { print("z") }
    else { print("?") }
}

// Print effect name by ID. One table: if name_len(id) > 0 the name is printed
// from the same bytes lookup uses. Generic Effect#N only when the id has no
// name (EffVar, unknown). Chaotic is id 22 and must print "Chaotic".
pub fn print_effect_name(id: i64) with IO, Mut, Panic, Div {
    let nlen = effect_kind_name_len(id)
    if nlen <= 0 {
        print("Effect#")
        print_int(id)
        return
    }
    var i: i64 = 0
    while i < nlen {
        print_ascii_i8(effect_kind_name_byte(id, i))
        i = i + 1
    }
}

// Find missing effects: returns effects in required that are not in declared
pub fn find_missing_effects(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var missing: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    var missing_count: i64 = 0
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) && missing_count < 8 {
            missing[missing_count as usize] = req_id
            missing_count = missing_count + 1
        }
        i = i + 1
    }
    (missing, missing_count)
}

// Merge two effect sets (union)
pub fn merge_effects(a: [i64; 8], a_count: i64, b: [i64; 8], b_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var result = a
    var result_count = a_count

    // Add effects from b that aren't in a
    var i: i64 = 0
    while i < b_count && result_count < 8 {
        let b_id = b[i as usize]
        if !has_effect_id(result, result_count, b_id) {
            result[result_count as usize] = b_id
            result_count = result_count + 1
        }
        i = i + 1
    }

    (result, result_count)
}

// ── Per-call-site Equivalence Theory obligation recording ────────────────────
// During `madaros emit-lean-obligations`, the checker records each Invariant
// comparison's concrete groups + frame relation and whether any Chaotic function was
// seen; emit reads these to write one Lean obligation per distinct call-site
// configuration (deduplicated). All decidable; discharged in formal/EquivalenceTheory.lean.
var EQUIV_RECORDING: i64 = 0
var EQUIV_OBL_COUNT: i64 = 0
var EQUIV_OBL_L: [i64; 256] = [0; 256]    // left operand group rank 1..4
var EQUIV_OBL_R: [i64; 256] = [0; 256]    // right operand group rank
var EQUIV_OBL_SF: [i64; 256] = [0; 256]   // 1 = same frame
var EQUIV_OBL_RES: [i64; 256] = [0; 256]  // 1 = comparable (accept), 0 = reject
var EQUIV_CHAOTIC: i64 = 0

pub fn equiv_begin_recording() with Mut, Panic, Div {
    EQUIV_RECORDING = 1
    EQUIV_OBL_COUNT = 0
    EQUIV_CHAOTIC = 0
}

pub fn equiv_end_recording() with Mut, Panic, Div {
    EQUIV_RECORDING = 0
}

pub fn equiv_set_chaotic() with Mut, Panic, Div {
    if EQUIV_RECORDING == 1 { EQUIV_CHAOTIC = 1 }
}

pub fn equiv_record_invariant(rank_l: i64, rank_r: i64, same_frame: i64, comparable: i64) with Mut, Panic, Div {
    if EQUIV_RECORDING == 0 { return }
    if EQUIV_OBL_COUNT >= 256 { return }
    var i: i64 = 0
    while i < EQUIV_OBL_COUNT {
        if EQUIV_OBL_L[i as usize] == rank_l && EQUIV_OBL_R[i as usize] == rank_r
            && EQUIV_OBL_SF[i as usize] == same_frame && EQUIV_OBL_RES[i as usize] == comparable {
            return
        }
        i = i + 1
    }
    let idx = EQUIV_OBL_COUNT
    EQUIV_OBL_L[idx as usize] = rank_l
    EQUIV_OBL_R[idx as usize] = rank_r
    EQUIV_OBL_SF[idx as usize] = same_frame
    EQUIV_OBL_RES[idx as usize] = comparable
    EQUIV_OBL_COUNT = idx + 1
}

fn equiv_group_name(rank: i64) -> string {
    if rank == 1 { "DiffInf" }
    else if rank == 2 { "Diff1" }
    else if rank == 3 { "BiLip" }
    else { "Homeo" }
}

fn equiv_digit(d: i64) -> string {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" } else if d == 3 { "3" }
    else if d == 4 { "4" } else if d == 5 { "5" } else if d == 6 { "6" } else if d == 7 { "7" }
    else if d == 8 { "8" } else { "9" }
}

fn equiv_itoa(n: i64) -> string with Mut, Panic, Div {
    if n <= 0 { return "0" }
    var x = n
    var s = ""
    while x > 0 {
        s = equiv_digit(x % 10) + s
        x = x / 10
    }
    s
}

// Build the obligation .lean body from the recorded sites. Mathlib-free; each obligation
// references the discharged definitions in formal/EquivalenceTheory.lean.
pub fn equiv_emit_body(src: string) -> string with Mut, Panic, Div {
    var body = "-- Auto-emitted Equivalence Theory obligations (per call-site, Mathlib-free).\n"
    body = body + "-- Source: " + src + "\n"
    body = body + "-- Decidable obligations; discharged in formal/EquivalenceTheory.lean.\n"
    body = body + "import EquivalenceTheory\nopen Sounio.EquivalenceTheory\n\n"
    var i: i64 = 0
    while i < EQUIV_OBL_COUNT {
        let gl = equiv_group_name(EQUIV_OBL_L[i as usize])
        let gr = equiv_group_name(EQUIV_OBL_R[i as usize])
        let res = if EQUIV_OBL_RES[i as usize] == 1 { "true" } else { "false" }
        body = body + "theorem obl_site_" + equiv_itoa(i) + " : "
        if EQUIV_OBL_SF[i as usize] == 1 {
            body = body + "framesComparable Group." + gl + " Group." + gr + " Group.DiffInf = " + res + " := by decide\n"
        } else {
            body = body + "comparableDefault Group." + gl + " Group." + gr + " = " + res + " := by decide\n"
        }
        i = i + 1
    }
    if EQUIV_CHAOTIC == 1 {
        body = body + "theorem obl_chaos : reassocAllowed true true true = false := by decide\n"
    }
    body
}
