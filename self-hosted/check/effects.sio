        return 0 as i8
    }
    if i == 17 {
        if j == 0 { return 77 as i8 }
        if j == 1 { return 117 as i8 }
        if j == 2 { return 108 as i8 }
        if j == 3 { return 116 as i8 }
        if j == 4 { return 105 as i8 }
        if j == 5 { return 84 as i8 }
        if j == 6 { return 101 as i8 }
        if j == 7 { return 115 as i8 }
        if j == 8 { return 116 as i8 }
        return 0 as i8
    }
    if i == 18 {
        if j == 0 { return 90 as i8 }
        if j == 1 { return 68 as i8 }
        return 0 as i8
    }
    if i == 19 {
        if j == 0 { return 87 as i8 }
        if j == 1 { return 105 as i8 }
        if j == 2 { return 116 as i8 }
        if j == 3 { return 110 as i8 }
        if j == 4 { return 101 as i8 }
        if j == 5 { return 115 as i8 }
        if j == 6 { return 115 as i8 }
        return 0 as i8
    }
    if i == 20 {
        if j == 0 { return 84 as i8 }
        if j == 1 { return 101 as i8 }
        if j == 2 { return 109 as i8 }
        if j == 3 { return 112 as i8 }
        if j == 4 { return 111 as i8 }
        if j == 5 { return 114 as i8 }
        if j == 6 { return 97 as i8 }
        if j == 7 { return 108 as i8 }
        return 0 as i8
    }
    if i == 21 {
        if j == 0 { return 76 as i8 }
        if j == 1 { return 101 as i8 }
        if j == 2 { return 97 as i8 }
        if j == 3 { return 114 as i8 }
        if j == 4 { return 110 as i8 }
        return 0 as i8
    }
    if i == 22 {
        if j == 0 { return 67 as i8 }
        if j == 1 { return 104 as i8 }
        if j == 2 { return 97 as i8 }
        if j == 3 { return 111 as i8 }
        if j == 4 { return 116 as i8 }
        if j == 5 { return 105 as i8 }
        if j == 6 { return 99 as i8 }
        return 0 as i8
    }
    0 as i8
}

fn effect_row_matches(i: i64, name_buf: [i8; 64], name_len: i64) -> bool {
    let want_len = builtin_effect_len_at(i)
    if name_len != want_len {
        return false
    }
    var j: i64 = 0
    while j < want_len {
        if name_buf[j as usize] != builtin_effect_byte_at(i, j) {
            return false
        }
        j = j + 1
    }
    true
}

pub fn effect_name_to_id(name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < builtin_effect_count() {
        if effect_row_matches(i, name_buf, name_len) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn print_effect_ident_bytes(name_buf: [i8; 64], name_len: i64) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name_len {
        if i < 64 {
            print_char(name_buf[i as usize] as i64)
        }
        i = i + 1
    }
}

// ============================================================
// Extract effects from EffectList
// ============================================================

pub fn collect_effects_from_list(list: EffectList, effects: [i64; 8], count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var effs = effects
    var n = count

    // Convert this effect to ID
    let eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)

    // Add if valid and not duplicate
    if eff_id >= 0 && n < 8 {
        var already_present = false
        var i: i64 = 0
        while i < n {
            if effs[i as usize] == eff_id {
                already_present = true
            }
            i = i + 1
        }

        if !already_present {
            effs[n as usize] = eff_id
            n = n + 1
        }
    }

    // Process tail
    match list.tail {
        None => (effs, n)
        Some(next) => collect_effects_from_list(*next, effs, n)
    }
}

pub fn extract_effects(opt: Option<Box<EffectList>>) -> ([i64; 8], i64) with Mut, Panic, Div {
    match opt {
        None => ([0; 8], 0)
        Some(list) => collect_effects_from_list(*list, [0; 8], 0)
    }
}

// ============================================================
// Effect checking helpers (for future use)
// ============================================================

// Check if effect ID is present in array
pub fn has_effect_id(effects: [i64; 8], count: i64, target_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        if effects[i as usize] == target_id {
            return true
        }
        i = i + 1
    }
    false
}

// Check if required effects are subset of declared effects
pub fn effects_subset(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) {
            return false
        }
        i = i + 1
    }
    true
}

// Print effect name by ID (for diagnostics)
pub fn print_effect_name(id: i64) with IO, Mut, Panic, Div {
    if id == 0 { print("IO") }
    else if id == 1 { print("Mut") }
    else if id == 2 { print("Alloc") }
    else if id == 3 { print("Panic") }
    else if id == 4 { print("Div") }
    else if id == 5 { print("GPU") }
    else if id == 6 { print("Async") }
    else if id == 7 { print("Prob") }
    else if id == 8 { print("Epistemic") }
    else if id == 9 { print("Causal") }
    else if id == 10 { print("Network") }
    else if id == 11 { print("Sensor") }
    else if id == 12 { print("Render") }
    else if id == 13 { print("Observe") }
    else if id == 14 { print("NonAssoc") }
    else if id == 15 { print("Audit") }
    else if id == 16 { print("Hypothesis") }
    else if id == 17 { print("MultiTest") }
    else if id == 18 { print("ZD") }
    else if id == 19 { print("Witness") }
    else if id == 20 { print("Temporal") }
    else if id == 21 { print("Learn") }
    else if id == 22 { print("Chaotic") }
    else { print("Effect#"); print_int(id) }
}

// Find missing effects: returns effects in required that are not in declared
pub fn find_missing_effects(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var missing: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    var missing_count: i64 = 0
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) && missing_count < 8 {
            missing[missing_count as usize] = req_id
            missing_count = missing_count + 1
        }
        i = i + 1
    }
    (missing, missing_count)
}

// Merge two effect sets (union)
pub fn merge_effects(a: [i64; 8], a_count: i64, b: [i64; 8], b_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var result = a
    var result_count = a_count

    // Add effects from b that aren't in a
    var i: i64 = 0
    while i < b_count && result_count < 8 {
        let b_id = b[i as usize]
        if !has_effect_id(result, result_count, b_id) {
            result[result_count as usize] = b_id
            result_count = result_count + 1
        }
        i = i + 1
    }

    (result, result_count)
}

// ── Per-call-site Equivalence Theory obligation recording ────────────────────
// During `madaros emit-lean-obligations`, the checker records each Invariant
// comparison's concrete groups + frame relation and whether any Chaotic function was
// seen; emit reads these to write one Lean obligation per distinct call-site
// configuration (deduplicated). All decidable; discharged in formal/EquivalenceTheory.lean.
var EQUIV_RECORDING: i64 = 0
var EQUIV_OBL_COUNT: i64 = 0
var EQUIV_OBL_L: [i64; 256] = [0; 256]    // left operand group rank 1..4
var EQUIV_OBL_R: [i64; 256] = [0; 256]    // right operand group rank
var EQUIV_OBL_SF: [i64; 256] = [0; 256]   // 1 = same frame
var EQUIV_OBL_RES: [i64; 256] = [0; 256]  // 1 = comparable (accept), 0 = reject
var EQUIV_CHAOTIC: i64 = 0

pub fn equiv_begin_recording() with Mut, Panic, Div {
    EQUIV_RECORDING = 1
    EQUIV_OBL_COUNT = 0
    EQUIV_CHAOTIC = 0
}

pub fn equiv_end_recording() with Mut, Panic, Div {
    EQUIV_RECORDING = 0
}

pub fn equiv_set_chaotic() with Mut, Panic, Div {
    if EQUIV_RECORDING == 1 { EQUIV_CHAOTIC = 1 }
}

pub fn equiv_record_invariant(rank_l: i64, rank_r: i64, same_frame: i64, comparable: i64) with Mut, Panic, Div {
    if EQUIV_RECORDING == 0 { return }
    if EQUIV_OBL_COUNT >= 256 { return }
    var i: i64 = 0
    while i < EQUIV_OBL_COUNT {
        if EQUIV_OBL_L[i as usize] == rank_l && EQUIV_OBL_R[i as usize] == rank_r
            && EQUIV_OBL_SF[i as usize] == same_frame && EQUIV_OBL_RES[i as usize] == comparable {
            return
        }
        i = i + 1
    }
    let idx = EQUIV_OBL_COUNT
    EQUIV_OBL_L[idx as usize] = rank_l
    EQUIV_OBL_R[idx as usize] = rank_r
    EQUIV_OBL_SF[idx as usize] = same_frame
    EQUIV_OBL_RES[idx as usize] = comparable
    EQUIV_OBL_COUNT = idx + 1
}

fn equiv_group_name(rank: i64) -> string {
    if rank == 1 { "DiffInf" }
    else if rank == 2 { "Diff1" }
    else if rank == 3 { "BiLip" }
    else { "Homeo" }
}

fn equiv_digit(d: i64) -> string {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" } else if d == 3 { "3" }
    else if d == 4 { "4" } else if d == 5 { "5" } else if d == 6 { "6" } else if d == 7 { "7" }
    else if d == 8 { "8" } else { "9" }
}

fn equiv_itoa(n: i64) -> string with Mut, Panic, Div {
    if n <= 0 { return "0" }
    var x = n
    var s = ""
    while x > 0 {
        s = equiv_digit(x % 10) + s
        x = x / 10
    }
    s
}

// Build the obligation .lean body from the recorded sites. Mathlib-free; each obligation
// references the discharged definitions in formal/EquivalenceTheory.lean.
pub fn equiv_emit_body(src: string) -> string with Mut, Panic, Div {
    var body = "-- Auto-emitted Equivalence Theory obligations (per call-site, Mathlib-free).\n"
    body = body + "-- Source: " + src + "\n"
    body = body + "-- Decidable obligations; discharged in formal/EquivalenceTheory.lean.\n"
    body = body + "import EquivalenceTheory\nopen Sounio.EquivalenceTheory\n\n"
    var i: i64 = 0
    while i < EQUIV_OBL_COUNT {
        let gl = equiv_group_name(EQUIV_OBL_L[i as usize])
        let gr = equiv_group_name(EQUIV_OBL_R[i as usize])
        let res = if EQUIV_OBL_RES[i as usize] == 1 { "true" } else { "false" }
        body = body + "theorem obl_site_" + equiv_itoa(i) + " : "
        if EQUIV_OBL_SF[i as usize] == 1 {
            body = body + "framesComparable Group." + gl + " Group." + gr + " Group.DiffInf = " + res + " := by decide\n"
        } else {
            body = body + "comparableDefault Group." + gl + " Group." + gr + " = " + res + " := by decide\n"
        }
        i = i + 1
    }
    if EQUIV_CHAOTIC == 1 {
        body = body + "theorem obl_chaos : reassocAllowed true true true = false := by decide\n"
    }
    body
}
