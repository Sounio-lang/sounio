// Effect processing for type checker
//
// Converts parsed EffectList from AST to effect ID arrays in FnSig.
// Effect IDs: 0=IO, 1=Mut, 2=Alloc, 3=Panic, 4=Div, 5=GPU, 6=Async,
// 7=Prob, 8=Epistemic, 9=Causal, 10=Network, 11=Sensor, 12=Render,
// 13=Observe, 14=NonAssoc, 15=Audit, 16=Hypothesis, 17=MultiTest,
// 18=ZD (zero-divisor effect for Forgettable<T>),
// 19=Witness (emits machine-checkable Lean witness, required by Audited<T>),
// 20=Temporal (time-bounded reversibility, required by Revivable<T>),
// 21=Learn (gradient production; required by SurgicalOptimizer)

// ============================================================
// Built-in effect table. The set is data. Recognition is a walk.
// Row index == effect id (0..22). Adding a name is adding a row.
// Unknown is not purity: the checker must emit E231.
// ============================================================

pub fn builtin_effect_count() -> i64 {
    23
}

pub fn builtin_effect_len_at(i: i64) -> i64 {
    let lens: [i64; 23] = [2, 3, 5, 5, 3, 3, 5, 4, 9, 6, 7, 6, 6, 7, 8, 5, 10, 9, 2, 7, 8, 5, 7]
    if i < 0 {
        return 0
    }
    if i >= 23 {
        return 0
    }
    lens[i as usize]
}

fn builtin_effect_byte_at(i: i64, j: i64) -> i8 {
    if j < 0 {
        return 0 as i8
    }
    if i == 0 {
        if j == 0 { return 73 as i8 }
        if j == 1 { return 79 as i8 }
        return 0 as i8
    }
    if i == 1 {
        if j == 0 { return 77 as i8 }
        if j == 1 { return 117 as i8 }
        if j == 2 { return 116 as i8 }
        return 0 as i8
    }
    if i == 2 {
        if j == 0 { return 65 as i8 }
        if j == 1 { return 108 as i8 }
        if j == 2 { return 108 as i8 }
        if j == 3 { return 111 as i8 }
        if j == 4 { return 99 as i8 }
        return 0 as i8
    }
    if i == 3 {
        if j == 0 { return 80 as i8 }
        if j == 1 { return 97 as i8 }
        if j == 2 { return 110 as i8 }
        if j == 3 { return 105 as i8 }
        if j == 4 { return 99 as i8 }
        return 0 as i8
    }
    if i == 4 {
        if j == 0 { return 68 as i8 }
        if j == 1 { return 105 as i8 }
        if j == 2 { return 118 as i8 }
        return 0 as i8
    }
    if i == 5 {
        if j == 0 { return 71 as i8 }
        if j == 1 { return 80 as i8 }
        if j == 2 { return 85 as i8 }
        return 0 as i8
    }
    if i == 6 {
        if j == 0 { return 65 as i8 }
        if j == 1 { return 115 as i8 }
        if j == 2 { return 121 as i8 }
        if j == 3 { return 110 as i8 }
        if j == 4 { return 99 as i8 }
        return 0 as i8
    }
    if i == 7 {
        if j == 0 { return 80 as i8 }
        if j == 1 { return 114 as i8 }
        if j == 2 { return 111 as i8 }
        if j == 3 { return 98 as i8 }
        return 0 as i8
    }
    if i == 8 {
        if j == 0 { return 69 as i8 }
        if j == 1 { return 112 as i8 }
        if j == 2 { return 105 as i8 }
        if j == 3 { return 115 as i8 }
        if j == 4 { return 116 as i8 }
        if j == 5 { return 101 as i8 }
        if j == 6 { return 109 as i8 }
        if j == 7 { return 105 as i8 }
        if j == 8 { return 99 as i8 }
        return 0 as i8
    }
    if i == 9 {
        if j == 0 { return 67 as i8 }
        if j == 1 { return 97 as i8 }
        if j == 2 { return 117 as i8 }
        if j == 3 { return 115 as i8 }
        if j == 4 { return 97 as i8 }
        if j == 5 { return 108 as i8 }
        return 0 as i8
    }
    if i == 10 {
        if j == 0 { return 78 as i8 }
        if j == 1 { return 101 as i8 }
        if j == 2 { return 116 as i8 }
        if j == 3 { return 119 as i8 }
        if j == 4 { return 111 as i8 }
        if j == 5 { return 114 as i8 }
        if j == 6 { return 107 as i8 }
        return 0 as i8
    }
    if i == 11 {
        if j == 0 { return 83 as i8 }
        if j == 1 { return 101 as i8 }
        if j == 2 { return 110 as i8 }
        if j == 3 { return 115 as i8 }
        if j == 4 { return 111 as i8 }
        if j == 5 { return 114 as i8 }
        return 0 as i8
    }
    if i == 12 {
        if j == 0 { return 82 as i8 }
        if j == 1 { return 101 as i8 }
        if j == 2 { return 110 as i8 }
        if j == 3 { return 100 as i8 }
        if j == 4 { return 101 as i8 }
        if j == 5 { return 114 as i8 }
        return 0 as i8
    }
    if i == 13 {
        if j == 0 { return 79 as i8 }
        if j == 1 { return 98 as i8 }
        if j == 2 { return 115 as i8 }
        if j == 3 { return 101 as i8 }
        if j == 4 { return 114 as i8 }
        if j == 5 { return 118 as i8 }
        if j == 6 { return 101 as i8 }
        return 0 as i8
    }
    if i == 14 {
        if j == 0 { return 78 as i8 }
        if j == 1 { return 111 as i8 }
        if j == 2 { return 110 as i8 }
        if j == 3 { return 65 as i8 }
        if j == 4 { return 115 as i8 }
        if j == 5 { return 115 as i8 }
        if j == 6 { return 111 as i8 }
        if j == 7 { return 99 as i8 }
        return 0 as i8
    }
    if i == 15 {
        if j == 0 { return 65 as i8 }
        if j == 1 { return 117 as i8 }
        if j == 2 { return 100 as i8 }
        if j == 3 { return 105 as i8 }
        if j == 4 { return 116 as i8 }
        return 0 as i8
    }
    if i == 16 {
        if j == 0 { return 72 as i8 }
        if j == 1 { return 121 as i8 }
        if j == 2 { return 112 as i8 }
        if j == 3 { return 111 as i8 }
        if j == 4 { return 116 as i8 }
        if j == 5 { return 104 as i8 }
