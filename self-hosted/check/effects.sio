// Effect processing for type checker
//
// Converts parsed EffectList from AST to effect ID arrays in FnSig.
// Effect IDs: 0=IO, 1=Mut, 2=Alloc, 3=Panic, 4=Div, 5=GPU, 6=Async, etc.

// ============================================================
// Effect name to ID mapping
// ============================================================

fn effect_name_to_id(name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    // IO
    if name_len == 2 {
        if name_buf[0] == 73 && name_buf[1] == 79 {  // "IO"
            return 0
        }
    }

    // Mut
    if name_len == 3 {
        if name_buf[0] == 77 && name_buf[1] == 117 && name_buf[2] == 116 {  // "Mut"
            return 1
        }
        // Div
        if name_buf[0] == 68 && name_buf[1] == 105 && name_buf[2] == 118 {  // "Div"
            return 4
        }
        // GPU
        if name_buf[0] == 71 && name_buf[1] == 80 && name_buf[2] == 85 {  // "GPU"
            return 5
        }
    }

    // Alloc
    if name_len == 5 {
        if name_buf[0] == 65 && name_buf[1] == 108 && name_buf[2] == 108
           && name_buf[3] == 111 && name_buf[4] == 99 {  // "Alloc"
            return 2
        }
        // Async
        if name_buf[0] == 65 && name_buf[1] == 115 && name_buf[2] == 121
           && name_buf[3] == 110 && name_buf[4] == 99 {  // "Async"
            return 6
        }
        // Panic
        if name_buf[0] == 80 && name_buf[1] == 97 && name_buf[2] == 110
           && name_buf[3] == 105 && name_buf[4] == 99 {  // "Panic"
            return 3
        }
    }

    // Prob
    if name_len == 4 {
        if name_buf[0] == 80 && name_buf[1] == 114 && name_buf[2] == 111
           && name_buf[3] == 98 {  // "Prob"
            return 7
        }
    }

    // Epistemic (9 chars)
    if name_len == 9 {
        if name_buf[0] == 69 && name_buf[1] == 112 && name_buf[2] == 105
           && name_buf[3] == 115 && name_buf[4] == 116 && name_buf[5] == 101
           && name_buf[6] == 109 && name_buf[7] == 105 && name_buf[8] == 99 {
            return 8
        }
    }

    // Causal (6 chars)
    if name_len == 6 {
        if name_buf[0] == 67 && name_buf[1] == 97 && name_buf[2] == 117
           && name_buf[3] == 115 && name_buf[4] == 97 && name_buf[5] == 108 {
            return 9
        }
    }

    // Network (7 chars)
    if name_len == 7 {
        if name_buf[0] == 78 && name_buf[1] == 101 && name_buf[2] == 116
           && name_buf[3] == 119 && name_buf[4] == 111 && name_buf[5] == 114
           && name_buf[6] == 107 {
            return 10
        }
    }

    // Sensor (6 chars)
    if name_len == 6 {
        if name_buf[0] == 83 && name_buf[1] == 101 && name_buf[2] == 110
           && name_buf[3] == 115 && name_buf[4] == 111 && name_buf[5] == 114 {
            return 11
        }
    }

    // Unknown effect
    -1
}

// ============================================================
// Extract effects from EffectList
// ============================================================

fn collect_effects_from_list(list: EffectList, effects: [i64; 8], count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var effs = effects
    var n = count

    // Convert this effect to ID
    let eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)

    // Add if valid and not duplicate
    if eff_id >= 0 && n < 8 {
        var already_present = false
        var i: i64 = 0
        while i < n {
            if effs[i as usize] == eff_id {
                already_present = true
            }
            i = i + 1
        }

        if !already_present {
            effs[n as usize] = eff_id
            n = n + 1
        }
    }

    // Process tail
    match list.tail {
        None => (effs, n)
        Some(next) => collect_effects_from_list(*next, effs, n)
    }
}

fn extract_effects(opt: Option<Box<EffectList>>) -> ([i64; 8], i64) with Mut, Panic, Div {
    match opt {
        None => ([0; 8], 0)
        Some(list) => collect_effects_from_list(*list, [0; 8], 0)
    }
}

// ============================================================
// Effect checking helpers (for future use)
// ============================================================

// Check if effect ID is present in array
fn has_effect_id(effects: [i64; 8], count: i64, target_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        if effects[i as usize] == target_id {
            return true
        }
        i = i + 1
    }
    false
}

// Check if required effects are subset of declared effects
fn effects_subset(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) {
            return false
        }
        i = i + 1
    }
    true
}

// Merge two effect sets (union)
fn merge_effects(a: [i64; 8], a_count: i64, b: [i64; 8], b_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var result = a
    var result_count = a_count

    // Add effects from b that aren't in a
    var i: i64 = 0
    while i < b_count && result_count < 8 {
        let b_id = b[i as usize]
        if !has_effect_id(result, result_count, b_id) {
            result[result_count as usize] = b_id
            result_count = result_count + 1
        }
        i = i + 1
    }

    (result, result_count)
}
