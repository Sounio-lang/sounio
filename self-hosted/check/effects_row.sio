// Effect row type-checking utilities for self-hosted checker
//
// Functions:
//   effect_row_label_eq      — byte-by-byte Name equality
//   effect_row_contains      — check if a row contains a given effect label
//   effect_row_subset        — check if all effects in a are also in b
//   check_handler_coverage   — validate handler arms cover required ops
//
// These utilities implement the structural rules for row-polymorphic effects:
//   { IO | r } ≤ { IO, Mut | r' }   if r ≤ r'
//
// The row tail is encoded as the `inner` field of TyEffectRow; an empty
// tail is represented by TyUnit, and TyEffectVar represents an open row.


// Byte-by-byte Name equality. Names are fixed-width (buf: [i8; 128], len: i64).
fn effect_row_label_eq(a: Name, b: Name) -> bool {
    if a.len != b.len {
        false
    } else {
        var i: i64 = 0
        var eq: bool = true
        while i < a.len {
            if a.buf[i as usize] != b.buf[i as usize] {
                eq = false
            }
            i = i + 1
        }
        eq
    }
}

// Returns true if ty is an effect row that contains the named effect label.
// Traverses the linked-list of TyEffectRow nodes following the `inner` tail.
fn effect_row_contains(ty: TypeEntry, label: Name) -> bool {
    match ty.kind {
        TypeKind::TyEffectRow => {
            if effect_row_label_eq(ty.name, label) {
                true
            } else {
                match ty.inner {
                    Some(tail_box) => effect_row_contains(*tail_box, label)
                    None => false
                }
            }
        }
        TypeKind::TyEffectVar => false
        _ => false
    }
}

// Returns true if effect row `a` is a subset of effect row `b`.
// All effects present in `a` must also appear in `b`.
// An open row variable (TyEffectVar) or empty row (TyUnit) is always a subset.
fn effect_row_subset(a: TypeEntry, b: TypeEntry) -> bool {
    match a.kind {
        TypeKind::TyEffectRow => {
            if !effect_row_contains(b, a.name) {
                false
            } else {
                match a.inner {
                    Some(tail_box) => effect_row_subset(*tail_box, b)
                    None => true
                }
            }
        }
        TypeKind::TyEffectVar => true
        TypeKind::TyUnit => true
        _ => true
    }
}

// Check that a handler block covers sufficient operation arms.
// arms_covered: number of handler arms present in the handle block
// ops_required: number of operations declared in the effect definition
// Returns 0 on success, error code on failure.
// E035: missing effect operation coverage in handler
fn check_handler_coverage(arms_covered: i64, ops_required: i64) -> i64 {
    if arms_covered < ops_required {
        35
    } else {
        0
    }
}
