    fn add(self, info: DeferralPolicyInfo) -> (DeferralPolicyTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 16 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> DeferralPolicyInfo with Panic, Div {
        self.entries[idx]
    }
}

