        count: 0,
    }
}

impl ContestTable {
    fn add(self, info: ContestInfo) -> (ContestTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 8 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn get(self, idx: i64) -> ContestInfo with Panic, Div {
        self.entries[idx]
    }
}

fn contest_info_set_metric(info: ContestInfo, metric_id: i64, value: f64) -> ContestInfo with Mut, Panic {
    var next = info
    if metric_id >= 0 && metric_id < 8 {
        next.metric_known[metric_id as usize] = 1
        next.metric_values[metric_id as usize] = value
    }
    next
}

pub fn contest_info_get_metric(info: ContestInfo, metric_id: i64) -> (bool, f64) {
    if metric_id >= 0 && metric_id < 8 && info.metric_known[metric_id as usize] == 1 {
        (true, info.metric_values[metric_id as usize])
    } else {
        (false, 0.0)
    }
}

