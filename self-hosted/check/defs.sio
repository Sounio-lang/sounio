    ContestInfo {
        span_start: 0,
        span_end: 0,
        audit_id: -1,
        family_id: -1,
        policy_id: -1,
        model_names: [Name { buf: [0; 128], len: 0 }; 16],
        model_count: 0,
        metric_known: [0; 8],
        metric_values: [0.0; 8],
        mechanistic_report_id: -1,
        posterior_weights_id: -1,
        counterexample_id: -1,
        provenance_bundle_id: -1,
    }
}

struct ContestTable {
    entries: [ContestInfo; 8],
    count: i64,
}

fn contest_table_new() -> ContestTable {
    ContestTable {
        entries: [empty_contest_info(); 8],
        count: 0,
    }
}

impl ContestTable {
    fn add(self, info: ContestInfo) -> (ContestTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 8 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn get(self, idx: i64) -> ContestInfo with Panic, Div {
        self.entries[idx]
    }
}

fn contest_info_set_metric(info: ContestInfo, metric_id: i64, value: f64) -> ContestInfo with Mut, Panic {
    var next = info
    if metric_id >= 0 && metric_id < 8 {
        next.metric_known[metric_id as usize] = 1
        next.metric_values[metric_id as usize] = value
    }
    next
}

fn contest_info_get_metric(info: ContestInfo, metric_id: i64) -> (bool, f64) {
    if metric_id >= 0 && metric_id < 8 && info.metric_known[metric_id as usize] == 1 {
        (true, info.metric_values[metric_id as usize])
    } else {
        (false, 0.0)
    }
}

