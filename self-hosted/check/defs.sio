// ============================================================
// Effect tables (H6.1)
// ============================================================

struct EffectOpInfo {
    name: Name,
    effect_id: i64,
    param_count: i64,
    ret_ty: TypeEntry,
}

fn empty_effect_op_info() -> EffectOpInfo {
    EffectOpInfo {
        name: Name { buf: [0; 128], len: 0 },
        effect_id: -1,
        param_count: 0,
        ret_ty: empty_type_entry(),
    }
}

struct EffectOpTable {
    entries: [EffectOpInfo; 128],
    count: i64,
}

fn effect_op_table_new() -> EffectOpTable {
    EffectOpTable {
        entries: [empty_effect_op_info(); 128],
        count: 0,
    }
}

impl EffectOpTable {
    fn add(self, info: EffectOpInfo) -> (EffectOpTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 128 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find_by_name_and_effect(self, name: Name, effect_id: i64) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        var result: i64 = -1
        while i < self.count {
            let entry = self.entries[i as usize]
            if entry.effect_id == effect_id && name_eq(entry.name, name) {
                result = i
            }
            i = i + 1
        }
        result
    }
}

struct EffectInfo {
    name: Name,
    op_count: i64,
    first_op_id: i64,
}

fn empty_effect_info() -> EffectInfo {
    EffectInfo {
        name: Name { buf: [0; 128], len: 0 },
        op_count: 0,
        first_op_id: -1,
    }
}

struct EffectTable {
    entries: [EffectInfo; 32],
    count: i64,
}

fn effect_table_new() -> EffectTable {
    EffectTable {
        entries: [empty_effect_info(); 32],
        count: 0,
    }
}

impl EffectTable {
    fn add(self, info: EffectInfo) -> (EffectTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 32 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find_by_name(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        var result: i64 = -1
        while i < self.count {
            if name_eq(self.entries[i as usize].name, name) {
                result = i
            }
            i = i + 1
        }
        result
    }
}
