    outcome_count: i32,
    is_valid: bool,
}

pub struct StudyTable {
    entries: [StudyInfo; 16],
    count: i64,
}

pub fn empty_study_info() -> StudyInfo {
    StudyInfo {
        name: empty_name(),
        title: empty_name(),
        registration: empty_name(),
        design: 0,
        sample_size: 0,
        power: 0.0,
        alpha: 0.0,
        correction: 0,
        hypotheses: [empty_study_hypothesis(); 8],
        hypothesis_count: 0,
        outcomes: [empty_study_outcome(); 16],
        outcome_count: 0,
        is_valid: false,
    }
}

pub fn empty_study_table() -> StudyTable {
    StudyTable {
        entries: [empty_study_info(); 16],
        count: 0,
    }
}

// ============================================================
// Ontology class registry
// ============================================================

pub struct OntologyClassInfo {
    name: Name,
    ontology_name: Name,
    class_index: i64,
    superclass_indices: [i64; 8],
    superclass_count: i64,
    all_ancestor_indices: [i64; 64],
    all_ancestor_count: i64,
    disjoint_indices: [i64; 8],
    disjoint_count: i64,
    property_names: [Name; 8],
    property_ref_ids: [i64; 8],
    property_count: i64,
    is_valid: bool,
}

pub struct OntologyTable {
    entries: [OntologyClassInfo; 64],
    count: i64,
}

pub fn empty_ontology_class_info() -> OntologyClassInfo {
    OntologyClassInfo {
        name: empty_name(),
        ontology_name: empty_name(),
        class_index: -1,
        superclass_indices: [-1; 8],
        superclass_count: 0,
        all_ancestor_indices: [-1; 64],
        all_ancestor_count: 0,
        disjoint_indices: [-1; 8],
        disjoint_count: 0,
        property_names: [empty_name(); 8],
        property_ref_ids: [-1; 8],
        property_count: 0,
        is_valid: false,
    }
}

pub fn empty_ontology_table() -> OntologyTable {
    OntologyTable {
        entries: [empty_ontology_class_info(); 64],
        count: 0,
    }
}

pub fn ontology_table_find(t: OntologyTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < t.count {
        if name_eq(t.entries[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn ontology_table_is_subclass(t: OntologyTable, sub_idx: i64, super_idx: i64) -> bool with Mut, Panic, Div {
    if sub_idx < 0 || sub_idx >= t.count { return false }
    if sub_idx == super_idx { return true }
    var i: i64 = 0
    while i < t.entries[sub_idx as usize].all_ancestor_count {
        if t.entries[sub_idx as usize].all_ancestor_indices[i as usize] == super_idx {
            return true
        }
        i = i + 1
    }
    false
}

fn ontology_table_is_disjoint(t: OntologyTable, a_idx: i64, b_idx: i64) -> bool with Mut, Panic, Div {
    if a_idx < 0 || b_idx < 0 || a_idx >= t.count || b_idx >= t.count { return false }
    var i: i64 = 0
    while i < t.entries[a_idx as usize].disjoint_count {
        if t.entries[a_idx as usize].disjoint_indices[i as usize] == b_idx {
            return true
        }
        i = i + 1
    }
    false
}

// Returns true if class at idx has itself in its ancestor list (cycle).
fn ontology_table_has_cycle(t: OntologyTable, idx: i64) -> bool with Mut, Panic, Div {
    if idx < 0 || idx >= t.count { return false }
    var i: i64 = 0
    while i < t.entries[idx as usize].all_ancestor_count {
        if t.entries[idx as usize].all_ancestor_indices[i as usize] == idx {
            return true
        }
        i = i + 1
    }
    false
}

pub fn ontology_table_compute_closure(t: OntologyTable) -> OntologyTable with Mut, Panic, Div {
    var out = t
    // Seed: each class has its direct superclasses as ancestors
    var i: i64 = 0
    while i < out.count {
        var j: i64 = 0
        while j < out.entries[i as usize].superclass_count {
            let sup = out.entries[i as usize].superclass_indices[j as usize]
            // Reject self-loops immediately
            if sup == i { j = j + 1 }
            else if sup >= 0 && out.entries[i as usize].all_ancestor_count < 64 {
                out.entries[i as usize].all_ancestor_indices[out.entries[i as usize].all_ancestor_count as usize] = sup
                out.entries[i as usize].all_ancestor_count = out.entries[i as usize].all_ancestor_count + 1
                j = j + 1
            } else {
                j = j + 1
            }
        }
        i = i + 1
    }
    // Fixed-point: propagate through hierarchy
    var changed = true
    var iterations: i64 = 0
    while changed && iterations < 256 {
        changed = false
        iterations = iterations + 1
        i = 0
        while i < out.count {
            var j: i64 = 0
            while j < out.entries[i as usize].all_ancestor_count {
                let anc_idx = out.entries[i as usize].all_ancestor_indices[j as usize]
                if anc_idx >= 0 && anc_idx < out.count {
                    var k: i64 = 0
                    while k < out.entries[anc_idx as usize].all_ancestor_count {
                        let transitive = out.entries[anc_idx as usize].all_ancestor_indices[k as usize]
                        // Skip if transitive ancestor is self (cycle)
                        if transitive == i {
                            k = k + 1
                        } else {
                            // Check if already present
                            var found = false
                            var m: i64 = 0
                            while m < out.entries[i as usize].all_ancestor_count {
                                if out.entries[i as usize].all_ancestor_indices[m as usize] == transitive {
                                    found = true
                                }
                                m = m + 1
                            }
                            if !found && out.entries[i as usize].all_ancestor_count < 64 {
                                out.entries[i as usize].all_ancestor_indices[out.entries[i as usize].all_ancestor_count as usize] = transitive
                                out.entries[i as usize].all_ancestor_count = out.entries[i as usize].all_ancestor_count + 1
                                changed = true
                            }
                            k = k + 1
                        }
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    // Post-closure cycle check: invalidate classes that ended up in cycles
    i = 0
    while i < out.count {
        if ontology_table_has_cycle(out, i) {
            out.entries[i as usize].is_valid = false
        }
        i = i + 1
    }
    out
}

// ============================================================
// Ontology axiom-centric kernel
// ============================================================

pub fn owl_subclass_of() -> i64 { 1 }
fn owl_equivalent_classes() -> i64 { 2 }
pub fn owl_disjoint_classes() -> i64 { 3 }
pub fn owl_object_property_domain() -> i64 { 4 }
pub fn owl_object_property_range() -> i64 { 5 }
pub fn owl_inverse_object_properties() -> i64 { 6 }
fn owl_sub_object_property_of() -> i64 { 7 }
pub fn owl_transitive_property() -> i64 { 8 }
pub fn owl_symmetric_property() -> i64 { 9 }
pub fn owl_functional_property() -> i64 { 10 }
pub fn owl_data_property_constraint() -> i64 { 11 }

pub struct OntologyClassEntry {
    name: Name,
    ontology_name: Name,
    class_index: i64,
    is_valid: bool,
}

pub struct OntologyClassRegistry {
    entries: [OntologyClassEntry; 64],
    count: i64,
}

pub struct OntologyObjectProperty {
    name: Name,
    property_index: i64,
    domain_class_idx: i64,
    range_class_idx: i64,
    inverse_property_idx: i64,
    is_transitive: bool,
    is_functional: bool,
    is_symmetric: bool,
    is_valid: bool,
}

pub struct OntologyPropertyRegistry {
    entries: [OntologyObjectProperty; 32],
    count: i64,
}

pub struct OntologyAxiom {
    axiom_type: i64,
    subject_idx: i64,
    object_idx: i64,
    refinement_ref_id: i64,
    property_name: Name,
    is_property_axiom: bool,
}

pub struct OntologyAxiomStore {
    axioms: [OntologyAxiom; 256],
    count: i64,
}

pub struct OntologyMaterialized {
    subclass_matrix: [bool; 4096],
    disjoint_matrix: [bool; 4096],
    sub_property_matrix: [bool; 1024],
    class_property_axioms: [i64; 512],
    class_property_counts: [i64; 64],
}

pub struct OntologyProfile {
    is_el: bool,
    is_ql: bool,
    is_rl: bool,
    is_dl: bool,
}

pub struct OntologyKernel {
    classes: OntologyClassRegistry,
    properties: OntologyPropertyRegistry,
    axioms: OntologyAxiomStore,
    materialized: OntologyMaterialized,
    profile: OntologyProfile,
}

fn empty_ontology_class_entry() -> OntologyClassEntry {
    OntologyClassEntry {
        name: empty_name(),
        ontology_name: empty_name(),
        class_index: -1,
        is_valid: false,
    }
}

fn empty_ontology_class_registry() -> OntologyClassRegistry {
    OntologyClassRegistry {
        entries: [empty_ontology_class_entry(); 64],
        count: 0,
    }
}

fn empty_ontology_object_property() -> OntologyObjectProperty {
    OntologyObjectProperty {
        name: empty_name(),
        property_index: -1,
        domain_class_idx: -1,
        range_class_idx: -1,
        inverse_property_idx: -1,
        is_transitive: false,
        is_functional: false,
        is_symmetric: false,
        is_valid: false,
    }
}

fn empty_ontology_property_registry() -> OntologyPropertyRegistry {
    OntologyPropertyRegistry {
        entries: [empty_ontology_object_property(); 32],
        count: 0,
    }
}

fn empty_ontology_axiom() -> OntologyAxiom {
    OntologyAxiom {
        axiom_type: 0,
        subject_idx: -1,
        object_idx: -1,
        refinement_ref_id: -1,
        property_name: empty_name(),
        is_property_axiom: false,
    }
}

fn empty_ontology_axiom_store() -> OntologyAxiomStore {
    OntologyAxiomStore {
        axioms: [empty_ontology_axiom(); 256],
        count: 0,
    }
}

fn empty_ontology_materialized() -> OntologyMaterialized {
    OntologyMaterialized {
        subclass_matrix: [false; 4096],
        disjoint_matrix: [false; 4096],
        sub_property_matrix: [false; 1024],
        class_property_axioms: [-1; 512],
        class_property_counts: [0; 64],
    }
}

fn empty_ontology_profile() -> OntologyProfile {
    OntologyProfile {
        is_el: true,
        is_ql: true,
        is_rl: true,
        is_dl: true,
    }
}

pub fn ontology_kernel_empty() -> OntologyKernel {
    OntologyKernel {
        classes: empty_ontology_class_registry(),
        properties: empty_ontology_property_registry(),
        axioms: empty_ontology_axiom_store(),
        materialized: empty_ontology_materialized(),
        profile: empty_ontology_profile(),
    }
}

pub fn ontology_kernel_class_matrix_index(sub_idx: i64, super_idx: i64) -> i64 {
    sub_idx * 64 + super_idx
}

fn ontology_kernel_property_matrix_index(sub_idx: i64, super_idx: i64) -> i64 {
    sub_idx * 32 + super_idx
}

pub fn ontology_kernel_find_class(k: OntologyKernel, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < k.classes.count {
        if name_eq(k.classes.entries[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn ontology_kernel_find_property(k: OntologyKernel, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < k.properties.count {
        if name_eq(k.properties.entries[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn ontology_kernel_can_add_axiom(k: OntologyKernel) -> bool {
    k.axioms.count < 256
}

pub fn ontology_kernel_can_add_class(k: OntologyKernel) -> bool {
    k.classes.count < 64
}

pub fn ontology_kernel_can_add_property(k: OntologyKernel) -> bool {
    k.properties.count < 32
}

pub fn ontology_kernel_add_class(k: OntologyKernel, name: Name, ontology_name: Name) -> (OntologyKernel, i64) with Mut, Panic, Div {
    var out = k
    if out.classes.count >= 64 {
        return (out, -1)
    }
    let idx = out.classes.count
    out.classes.entries[idx as usize] = OntologyClassEntry {
        name: name,
        ontology_name: ontology_name,
        class_index: idx,
        is_valid: true,
    }
    out.classes.count = idx + 1
    (out, idx)
}

pub fn ontology_kernel_add_property(k: OntologyKernel, name: Name) -> (OntologyKernel, i64) with Mut, Panic, Div {
    var out = k
    if out.properties.count >= 32 {
        return (out, -1)
    }
    let idx = out.properties.count
    out.properties.entries[idx as usize] = OntologyObjectProperty {
        name: name,
        property_index: idx,
        domain_class_idx: -1,
        range_class_idx: -1,
        inverse_property_idx: -1,
        is_transitive: false,
        is_functional: false,
        is_symmetric: false,
        is_valid: true,
    }
    out.properties.count = idx + 1
    (out, idx)
}

pub fn ontology_kernel_add_axiom(k: OntologyKernel, axiom: OntologyAxiom) -> OntologyKernel with Mut, Panic, Div {
    var out = k
    if out.axioms.count < 256 {
        out.axioms.axioms[out.axioms.count as usize] = axiom
        out.axioms.count = out.axioms.count + 1
    }
    out
}

pub fn ontology_kernel_is_subclass(k: OntologyKernel, sub_idx: i64, super_idx: i64) -> bool with Mut, Panic, Div {
    if sub_idx < 0 || super_idx < 0 || sub_idx >= k.classes.count || super_idx >= k.classes.count {
        return false
    }
    k.materialized.subclass_matrix[ontology_kernel_class_matrix_index(sub_idx, super_idx) as usize]
}

pub fn ontology_kernel_is_disjoint(k: OntologyKernel, a_idx: i64, b_idx: i64) -> bool with Mut, Panic, Div {
    if a_idx < 0 || b_idx < 0 || a_idx >= k.classes.count || b_idx >= k.classes.count {
        return false
    }
    k.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(a_idx, b_idx) as usize]
}

fn ontology_kernel_is_sub_property(k: OntologyKernel, sub_idx: i64, super_idx: i64) -> bool with Mut, Panic, Div {
    if sub_idx < 0 || super_idx < 0 || sub_idx >= k.properties.count || super_idx >= k.properties.count {
        return false
    }
    k.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(sub_idx, super_idx) as usize]
}

pub fn ontology_kernel_check_profile(k: OntologyKernel) -> OntologyProfile with Mut, Panic, Div {
    var out = empty_ontology_profile()
    var i: i64 = 0
    while i < k.axioms.count {
        let ax = k.axioms.axioms[i as usize]
        if ax.axiom_type == owl_equivalent_classes() || ax.axiom_type == owl_disjoint_classes() {
            out.is_el = false
        }
        if ax.axiom_type == owl_transitive_property() {
            out.is_ql = false
        }
        if ax.axiom_type == owl_inverse_object_properties() || ax.axiom_type == owl_symmetric_property() || ax.axiom_type == owl_functional_property() {
            out.is_el = false
            out.is_ql = false
        }
        if ax.axiom_type == owl_data_property_constraint() {
            out.is_el = false
            out.is_ql = false
        }
        i = i + 1
    }
    out
}

pub fn ontology_kernel_materialize(k: OntologyKernel) -> OntologyKernel with Mut, Panic, Div {
    var out = k
    out.materialized = empty_ontology_materialized()

    var pi: i64 = 0
    while pi < out.properties.count {
        out.properties.entries[pi as usize].domain_class_idx = -1
        out.properties.entries[pi as usize].range_class_idx = -1
        out.properties.entries[pi as usize].inverse_property_idx = -1
        out.properties.entries[pi as usize].is_transitive = false
        out.properties.entries[pi as usize].is_functional = false
        out.properties.entries[pi as usize].is_symmetric = false
        pi = pi + 1
    }

    var i: i64 = 0
    while i < out.classes.count {
        out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(i, i) as usize] = true
        i = i + 1
    }

    i = 0
    while i < out.properties.count {
        out.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(i, i) as usize] = true
        i = i + 1
    }

    i = 0
    while i < out.axioms.count {
        let ax = out.axioms.axioms[i as usize]
        if ax.axiom_type == owl_subclass_of() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.classes.count && ax.object_idx >= 0 && ax.object_idx < out.classes.count {
                out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
            }
        }
        else if ax.axiom_type == owl_equivalent_classes() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.classes.count && ax.object_idx >= 0 && ax.object_idx < out.classes.count {
                out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
                out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(ax.object_idx, ax.subject_idx) as usize] = true
            }
        }
        else if ax.axiom_type == owl_disjoint_classes() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.classes.count && ax.object_idx >= 0 && ax.object_idx < out.classes.count {
                out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
                out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(ax.object_idx, ax.subject_idx) as usize] = true
            }
        }
        else if ax.axiom_type == owl_object_property_domain() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count && ax.object_idx >= 0 && ax.object_idx < out.classes.count {
                out.properties.entries[ax.subject_idx as usize].domain_class_idx = ax.object_idx
            }
        }
        else if ax.axiom_type == owl_object_property_range() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count && ax.object_idx >= 0 && ax.object_idx < out.classes.count {
                out.properties.entries[ax.subject_idx as usize].range_class_idx = ax.object_idx
            }
        }
        else if ax.axiom_type == owl_inverse_object_properties() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count && ax.object_idx >= 0 && ax.object_idx < out.properties.count {
                out.properties.entries[ax.subject_idx as usize].inverse_property_idx = ax.object_idx
                out.properties.entries[ax.object_idx as usize].inverse_property_idx = ax.subject_idx
            }
        }
        else if ax.axiom_type == owl_sub_object_property_of() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count && ax.object_idx >= 0 && ax.object_idx < out.properties.count {
                out.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(ax.subject_idx, ax.object_idx) as usize] = true
            }
        }
        else if ax.axiom_type == owl_transitive_property() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count {
                out.properties.entries[ax.subject_idx as usize].is_transitive = true
            }
        }
        else if ax.axiom_type == owl_symmetric_property() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count {
                out.properties.entries[ax.subject_idx as usize].is_symmetric = true
            }
        }
        else if ax.axiom_type == owl_functional_property() {
            if ax.subject_idx >= 0 && ax.subject_idx < out.properties.count {
                out.properties.entries[ax.subject_idx as usize].is_functional = true
            }
        }
        i = i + 1
    }

    var mid: i64 = 0
    while mid < out.classes.count {
        var src: i64 = 0
        while src < out.classes.count {
            if out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(src, mid) as usize] {
                var dst: i64 = 0
                while dst < out.classes.count {
                    if out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(mid, dst) as usize] {
                        out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(src, dst) as usize] = true
                    }
                    dst = dst + 1
                }
            }
            src = src + 1
        }
        mid = mid + 1
    }

    mid = 0
    while mid < out.properties.count {
        var psrc: i64 = 0
        while psrc < out.properties.count {
            if out.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(psrc, mid) as usize] {
                var pdst: i64 = 0
                while pdst < out.properties.count {
                    if out.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(mid, pdst) as usize] {
                        out.materialized.sub_property_matrix[ontology_kernel_property_matrix_index(psrc, pdst) as usize] = true
                    }
                    pdst = pdst + 1
                }
            }
            psrc = psrc + 1
        }
        mid = mid + 1
    }

    var changed = true
    var iterations: i64 = 0
    while changed && iterations < 64 {
        changed = false
        iterations = iterations + 1
        var x: i64 = 0
        while x < out.classes.count {
            var a: i64 = 0
            while a < out.classes.count {
                if out.materialized.subclass_matrix[ontology_kernel_class_matrix_index(x, a) as usize] {
                    var b: i64 = 0
                    while b < out.classes.count {
                        if out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(a, b) as usize] &&
                           !out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(x, b) as usize] {
                            out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(x, b) as usize] = true
                            out.materialized.disjoint_matrix[ontology_kernel_class_matrix_index(b, x) as usize] = true
                            changed = true
                        }
                        b = b + 1
                    }
                }
                a = a + 1
            }
            x = x + 1
        }
    }

    pi = 0
    while pi < out.properties.count {
        let inv_idx = out.properties.entries[pi as usize].inverse_property_idx
        if inv_idx >= 0 && inv_idx < out.properties.count {
            let prop_domain = out.properties.entries[pi as usize].domain_class_idx
            let prop_range = out.properties.entries[pi as usize].range_class_idx
            let inv_domain = out.properties.entries[inv_idx as usize].domain_class_idx
            let inv_range = out.properties.entries[inv_idx as usize].range_class_idx
            if prop_domain >= 0 && inv_range < 0 {
                out.properties.entries[inv_idx as usize].range_class_idx = prop_domain
            }
            if prop_range >= 0 && inv_domain < 0 {
                out.properties.entries[inv_idx as usize].domain_class_idx = prop_range
            }
            if inv_domain >= 0 && prop_range < 0 {
                out.properties.entries[pi as usize].range_class_idx = inv_domain
            }
            if inv_range >= 0 && prop_domain < 0 {
                out.properties.entries[pi as usize].domain_class_idx = inv_range
            }
        }
        pi = pi + 1
    }

    i = 0
    while i < out.axioms.count {
        let ax = out.axioms.axioms[i as usize]
        if ax.axiom_type == owl_data_property_constraint() && ax.subject_idx >= 0 && ax.subject_idx < out.classes.count {
            let slot = out.materialized.class_property_counts[ax.subject_idx as usize]
            if slot < 8 {
                out.materialized.class_property_axioms[(ax.subject_idx * 8 + slot) as usize] = i
                out.materialized.class_property_counts[ax.subject_idx as usize] = slot + 1
            }
        }
        i = i + 1
    }

    out.profile = ontology_kernel_check_profile(out)
    out
}

// ============================================================
// Hyper expression metadata
// ============================================================

pub struct HyperExprInfo {
    span_start: i64,
    span_end: i64,
    algebra_tag: i64,
    op_kind: i64,  // 1 = multiply
    knowledge_wrapped: bool,
}

fn empty_hyper_expr_info() -> HyperExprInfo {
    HyperExprInfo {
        span_start: 0,
        span_end: 0,
        algebra_tag: -1,
        op_kind: 0,
        knowledge_wrapped: false,
    }
}

pub struct HyperExprTable {
    entries: [HyperExprInfo; 128],
    count: i64,
}

pub fn hyper_expr_table_new() -> HyperExprTable {
    HyperExprTable {
        entries: [empty_hyper_expr_info(); 128],
        count: 0,
    }
}

impl HyperExprTable {
    fn add(self, info: HyperExprInfo) -> (HyperExprTable, i64) with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 128 {
            let idx = tbl.count
            tbl.entries[idx as usize] = info
            tbl.count = idx + 1
            return (tbl, idx)
        }
        (tbl, -1)
    }
}

// ============================================================
// Function signature
// ============================================================

pub struct FnSig {
    name: Name,
    params: Option<Box<FnParamList>>,
    param_count: i64,
    return_type: TypeEntry,
    is_method: bool,
    self_type_name: Name,
    self_type_entry: TypeEntry,   // Semantic receiver type (replaces string heuristic)
    effects: [i64; 8],        // Effect IDs (encoded as integers for now)
    effect_count: i64,
    is_kernel: bool,
    is_epistemic_kernel: bool,
    // #1622: true for a body-less `extern "C"` declaration. The native backend
    // has no dynamic linker — an extern name it does not implement as a builtin
    // compiles to an empty stub and every call reads whatever is in rax (0).
    // Carried here so check_call_expr can refuse the call instead.
    is_extern: bool,
    // Sprint 231: Unified closure type theory
    is_linear_closure: bool,      // true if captures linear resources => call exactly once
    linear_capture_count: i64,    // number of linear captures
    epistemic_epsilon: f64,       // combined GUM epsilon from Knowledge captures (-1.0 = none)
    epistemic_min_confidence: i64, // Epistemic(N) floor on the 1..1000 scale (-1 = absent)
    visibility_kind: i64,
    defining_module_seg_count: i64,
    defining_module_id: i64,
    visibility: Visibility,
    defining_module: AstPath,
}

fn empty_fn_sig() -> FnSig {
    FnSig {
        name: Name { buf: [0; 384], len: 0 },
        params: None,
        param_count: 0,
        return_type: ty_unit(),
        is_method: false,
        self_type_name: Name { buf: [0; 384], len: 0 },
        self_type_entry: ty_unit(),
        effects: [0; 8],
        effect_count: 0,
        is_kernel: false,
        is_epistemic_kernel: false,
        is_extern: false,
        is_linear_closure: false,
        linear_capture_count: 0,
        epistemic_epsilon: 0.0 - 1.0,
        epistemic_min_confidence: 0 - 1,
        visibility_kind: VISIBILITY_PRIVATE,
        defining_module_seg_count: 0,
        defining_module_id: 0,
        visibility: visibility_private(),
        defining_module: empty_path(),
    }
}

// ============================================================
// FnSig table
// ============================================================

// FnSigTable (CHUNKED, heap-indirect): the table lives behind a `*mut FnSigTable`
// in the Checker so by-value Checker copies share ONE table. Storage is a linked
// list of fixed-size chunks rather than one giant `[FnSig; N]` array. A per-module
// checker with a handful of signatures uses a single ~0.75MB chunk; the cross-module
// accumulator grows chunks on demand. This BOUNDS memory under the multi-module
// frontend (which holds many checkers at once) -- a fixed huge cap allocated the
// full array in every checker and exhausted memory on the self-compile. Chunks hold
// inline `[FnSig; 512]` arrays, so element access is a single deref + array index
// (Sounio has no raw-pointer `p[i]` and no sizeof, so neither flat-growable storage).

pub struct FnSigChunk {
    entries: [FnSig; 512],
    next: *mut FnSigChunk,    // 0 == last chunk
}

pub struct FnSigTable {
    head: *mut FnSigChunk,    // 0 == empty
    count: i64,
}

// One zeroed chunk via heap_alloc (calloc): entries start empty, next == 0.
//
// THIS NUMBER IS NOT CHECKED AGAINST sizeof(FnSigChunk) BY ANYTHING. It was
// 786432 = 512 * 1536, sized against an FnSig that the comment above called
// "<=1.5KB" -- and #1622 added a field to FnSig without touching it. That is a
// silent overflow waiting on one more field, so the budget is raised here to
// 4 MB = 512 * 8192 B/entry. The pages are mmap-lazy: an oversized chunk costs
// address space, not memory.
//
// Honest note on provenance: this was written while chasing spurious E219
// diagnostics, on the theory that tail-entry writes were corrupting neighbouring
// FnSigs. That theory was WRONG -- the diagnostics came from the compiler
// reading a different stdlib via SOUNIO_STDLIB_PATH. The headroom is kept
// because the hazard is real, not because it fixed anything.
fn fn_sig_chunk_alloc() -> *mut FnSigChunk with Alloc {
    heap_alloc(4194304) as *mut FnSigChunk
}

// Small table header (head ptr + count); calloc zeroes head to 0 and count to 0.
pub fn fn_sig_table_alloc() -> *mut FnSigTable with Alloc {
    heap_alloc(64) as *mut FnSigTable
}

// Walk to (allocating chunks as needed) the chunk holding global index `gi`.
fn fn_sig_table_chunk_for(t: *mut FnSigTable, gi: i64) -> *mut FnSigChunk with Mut, Panic, Div, Alloc {
    if (*t).head == (0 as *mut FnSigChunk) {
        (*t).head = fn_sig_chunk_alloc()
    }
    let chunk_no = gi / 512
    var cur = (*t).head
    var n: i64 = 0
    while n < chunk_no {
        if (*cur).next == (0 as *mut FnSigChunk) {
            (*cur).next = fn_sig_chunk_alloc()
        }
        cur = (*cur).next
        n = n + 1
    }
    cur
}

pub fn fn_sig_table_add(t: *mut FnSigTable, sig: FnSig) -> i64 with Mut, Panic, Div, Alloc {
    let idx = (*t).count
    // Bound runaway growth (never reached by a well-formed program).
    if idx >= 1048576 {
        return 0 - 1
    }
    let chunk = fn_sig_table_chunk_for(t, idx)
    (*chunk).entries[(idx % 512) as usize] = sig
    (*t).count = idx + 1
    idx
}

pub fn fn_sig_table_get(t: *mut FnSigTable, idx: i64) -> FnSig with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        return empty_fn_sig()
    }
    let chunk_no = idx / 512
    var cur = (*t).head
    var n: i64 = 0
    while n < chunk_no {
        if cur == (0 as *mut FnSigChunk) {
            return empty_fn_sig()
        }
        cur = (*cur).next
        n = n + 1
    }
    if cur == (0 as *mut FnSigChunk) {
        return empty_fn_sig()
    }
    (*cur).entries[(idx % 512) as usize]
}

// Widen an entry's effect set in place, for effect INFERENCE (spec §7.2.1: the checker infers the
// effect from the body and the annotation is a declaration of the inferred fact). Returns true when
// something was added. Only ever ADDS — an inferred set can grow as callees are discovered, never
// shrink, so this cannot silently drop a declared effect.
pub fn fn_sig_table_widen_effects(t: *mut FnSigTable, idx: i64, extra: [i64; 8], extra_count: i64) -> bool with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        return false
    }
    let chunk_no = idx / 512
    var cur = (*t).head
    var n: i64 = 0
    while n < chunk_no {
        if cur == (0 as *mut FnSigChunk) {
            return false
        }
        cur = (*cur).next
        n = n + 1
    }
    if cur == (0 as *mut FnSigChunk) {
        return false
    }
    let slot = idx % 512
    var changed = false
    var i: i64 = 0
    while i < extra_count && i < 8 {
        let e = extra[i as usize]
        var seen = false
        var j: i64 = 0
        while j < (*cur).entries[slot as usize].effect_count && j < 8 {
            if (*cur).entries[slot as usize].effects[j as usize] == e {
                seen = true
            }
            j = j + 1
        }
        if !seen && (*cur).entries[slot as usize].effect_count < 8 {
            let k = (*cur).entries[slot as usize].effect_count
            (*cur).entries[slot as usize].effects[k as usize] = e
            (*cur).entries[slot as usize].effect_count = k + 1
            changed = true
        }
        i = i + 1
    }
    changed
}

pub fn fn_sig_table_find(t: *mut FnSigTable, name: Name) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    var cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { return 0 - 1 }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if name_eq((*cur).entries[local as usize].name, name) && !(*cur).entries[local as usize].is_method {
                return gi
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    0 - 1
}

// Multi-module free-function lookup used by the visibility preflight.
//
// `fn_sig_table_find` returns the *first* free function with a given name.
// When two modules both define a private helper of the same name (e.g.
// `chk` / `near` / `test_combine` in epistemic::gum and epistemic::knowledge),
// the later module's body calls resolve to the earlier module's private sig
// and trip false E175 ("function is private in its defining module") even
// though the call is same-module. Prefer:
//   1. free fn defined in `prefer_module_id` (private helpers of the module
//      currently being checked)
//   2. any non-private free fn (legitimate cross-module import target)
//   3. first free-fn match that is not a foreign private extern stub
//      (#1627: those shadow native builtins and false-E175 siblings)
pub fn fn_sig_table_find_prefer_module(t: *mut FnSigTable, name: Name, prefer_module_id: i64) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    var cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { break }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if !(*cur).entries[local as usize].is_method
                && name_eq((*cur).entries[local as usize].name, name)
                && (*cur).entries[local as usize].defining_module_id == prefer_module_id {
                return gi
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    gi = 0
    cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { break }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if !(*cur).entries[local as usize].is_method
                && name_eq((*cur).entries[local as usize].name, name)
                && (*cur).entries[local as usize].visibility_kind != VISIBILITY_PRIVATE {
                return gi
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    // Legacy first-match, but skip cross-module private `extern "C"` stubs.
    // Those shadow native builtins (#1627 / particle E175). Same-module private
    // externs still resolve here (local declaration).
    gi = 0
    cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { break }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if !(*cur).entries[local as usize].is_method
                && name_eq((*cur).entries[local as usize].name, name) {
                let foreign_private_extern = (*cur).entries[local as usize].is_extern
                    && (*cur).entries[local as usize].visibility_kind == VISIBILITY_PRIVATE
                    && (*cur).entries[local as usize].defining_module_id != prefer_module_id
                if !foreign_private_extern {
                    return gi
                }
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    0 - 1
}

pub fn fn_sig_table_find_method(t: *mut FnSigTable, type_name: Name, method_name: Name) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    var cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { return 0 - 1 }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if (*cur).entries[local as usize].is_method && name_eq((*cur).entries[local as usize].self_type_name, type_name) && name_eq((*cur).entries[local as usize].name, method_name) {
                return gi
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    0 - 1
}

// Semantic method lookup: matches by TypeEntry kind+name instead of Name alone.
pub fn fn_sig_table_find_method_semantic(t: *mut FnSigTable, receiver_ty: TypeEntry, method_name: Name) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    var cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { return 0 - 1 }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if (*cur).entries[local as usize].is_method && name_eq((*cur).entries[local as usize].name, method_name) {
                let sig_ty = (*cur).entries[local as usize].self_type_entry
                if sig_ty.kind == receiver_ty.kind && name_eq(sig_ty.name, receiver_ty.name) {
                    return gi
                }
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    // Fallback to string-based lookup for backward compatibility
    fn_sig_table_find_method(t, receiver_ty.name, method_name)
}

// Any-type method name probe: true if some registered impl method has this name.
// Used when the receiver failed to type (TyUnknown/TyError) so that nonexistent
// methods (e.mean) still fail at multi-module check with E011, while known
// method names (e.val) remain soft-accepted under an untyped receiver.
pub fn fn_sig_table_has_method_name(t: *mut FnSigTable, method_name: Name) -> bool with Mut, Panic, Div {
    var gi: i64 = 0
    var cur = (*t).head
    while gi < (*t).count {
        if cur == (0 as *mut FnSigChunk) { return false }
        var local: i64 = 0
        while local < 512 && gi < (*t).count {
            if (*cur).entries[local as usize].is_method
                && name_eq((*cur).entries[local as usize].name, method_name) {
                return true
            }
            local = local + 1
            gi = gi + 1
        }
        cur = (*cur).next
    }
    false
}

fn fn_sig_table_get_visibility(t: *mut FnSigTable, idx: i64) -> Visibility with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        return visibility_private()
    }
    fn_sig_table_get(t, idx).visibility
}

fn fn_sig_table_get_defining_module(t: *mut FnSigTable, idx: i64) -> AstPath with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        return empty_path()
    }
    fn_sig_table_get(t, idx).defining_module
}

