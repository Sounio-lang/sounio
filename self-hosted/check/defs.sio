    algebra_tag: i64,
    is_valid: bool,
    forbidden_law_mask: i64,
}

pub struct AlgebraTable {
    entries: [AlgebraInfo; 16],
    count: i64,
}

pub fn empty_algebra_info() -> AlgebraInfo {
    AlgebraInfo {
        name: empty_name(),
        add_commutative: true,
        add_associative: true,
        mul_commutative: true,
        mul_associative: true,
        mul_alternative: false,
        reassoc_strategy: 0,
        algebra_tag: 0,
        is_valid: false,
        forbidden_law_mask: 0,
    }
}

pub fn empty_algebra_table() -> AlgebraTable {
    AlgebraTable {
        entries: [empty_algebra_info(); 16],
        count: 0,
    }
}

