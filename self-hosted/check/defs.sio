struct AcquisitionPolicyTable {
    entries: [AcquisitionPolicyInfo; 16],
    count: i64,
}

fn acquisition_policy_table_new() -> AcquisitionPolicyTable {
    AcquisitionPolicyTable {
        entries: [empty_acquisition_policy_info(); 16],
        count: 0,
    }
}

impl AcquisitionPolicyTable {
    fn add(self, info: AcquisitionPolicyInfo) -> (AcquisitionPolicyTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 16 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> AcquisitionPolicyInfo with Panic, Div {
        self.entries[idx]
    }
}

