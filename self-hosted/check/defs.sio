// Definition tables for the type checker
//
// Three flat-array tables with linear scan lookup:
//   StructTable  — struct name + fields
//   EnumTable    — enum name + variants
//   FnSigTable   — fn name + params + return type + method info

use parser::ast::{BinaryOp, CompareOp, Expr, ExprKind, Name, StudyHypothesis, StudyOutcome, UnaryOp, Visibility, empty_name, empty_path, empty_study_hypothesis, empty_study_outcome, name_eq, visibility_private, visibility_pub}
use lexer::span::{Span}
use check::types::*

// ============================================================
// Field info (for struct fields)
// ============================================================

pub struct FieldInfo {
    name: Name,
    ty: TypeEntry,
}

fn empty_field_info() -> FieldInfo {
    FieldInfo {
        name: Name { buf: [0; 384], len: 0 },
        ty: empty_type_entry(),
    }
}

fn field_info_clone(info: &FieldInfo) -> FieldInfo with Mut, Alloc {
    FieldInfo {
        name: (*info).name,
        ty: type_entry_clone(&(*info).ty),
    }
}

pub struct FieldInfoList {
    head: FieldInfo,
    tail: Option<Box<FieldInfoList>>,
}

fn field_info_list_append(list: FieldInfoList, node: FieldInfoList) -> FieldInfoList with Mut, Alloc {
    match list.tail {
        None => FieldInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FieldInfoList {
            head: list.head,
            tail: Some(Box::new(field_info_list_append(*rest, node))),
        }
    }
}

pub fn field_info_list_find(opt: Option<Box<FieldInfoList>>, name: Name) -> TypeEntry with Mut, Panic, Div {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.ty
            } else {
                field_info_list_find((*list).tail, name)
            }
        }
    }
}

pub fn field_info_list_has(opt: Option<Box<FieldInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                field_info_list_has((*list).tail, name)
            }
        }
    }
}

pub fn field_info_list_count(opt: Option<Box<FieldInfoList>>) -> i64 with Mut, Panic, Div {
    match opt {
        None => 0
        Some(list) => 1 + field_info_list_count((*list).tail)
    }
}

pub fn field_info_list_clone(opt: &Option<Box<FieldInfoList>>) -> Option<Box<FieldInfoList>> with Mut, Alloc {
    match *opt {
        None => None
        Some(list) => Some(Box::new(FieldInfoList {
            head: field_info_clone(&(*list).head),
            tail: field_info_list_clone(&(*list).tail),
        }))
    }
}

// ============================================================
// Struct info
// ============================================================

pub struct StructInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
    field_count: i64,
    is_linear: bool,
    type_param_count: i64,
    type_param_names: [Name; 8],
    is_generic_template: bool,
    visibility_kind: i64,
    defining_module_id: i64,
    visibility: Visibility,
    defining_module: AstPath,
}

fn empty_struct_info() -> StructInfo {
    StructInfo {
        name: Name { buf: [0; 384], len: 0 },
        fields: None,
        field_count: 0,
        is_linear: false,
        type_param_count: 0,
        type_param_names: [Name { buf: [0; 384], len: 0 }; 8],
        is_generic_template: false,
        visibility_kind: VISIBILITY_PRIVATE,
        defining_module_id: 0,
        visibility: visibility_private(),
        defining_module: empty_path(),
    }
}

// ============================================================
// Struct table
// ============================================================

pub struct StructTable {
    entries: [StructInfo; 4096],
    count: i64,
}

fn struct_table_new() -> StructTable {
    StructTable {
        entries: [empty_struct_info(); 4096],
        count: 0,
    }
}

// StructTable accessors (heap-indirect): table lives behind a `*mut StructTable`
// in the Checker so by-value Checker copies share ONE table. See the FnSigTable
// note above; same rationale and the same "never bind (*t) to a value" rule.

pub fn struct_table_add(t: *mut StructTable, info: StructInfo) with Mut, Panic, Div {
    let idx = (*t).count
    if idx < 4096 {
        (*t).entries[idx as usize] = info
        (*t).count = idx + 1
    }
}

pub fn struct_table_find(t: *mut StructTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*t).count {
        if name_eq((*t).entries[i].name, name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn struct_table_find_by_buf8(t: *mut StructTable, buf: [i8; 384]) -> i64 with Mut, Panic, Div {
    // Match the struct whose name equals the first 8 bytes of buf (zero-padded).
    // Called from checker_lower_ref_like_type_mut where only name.buf[0..7]
    // (TypeEntry bytes 8-15, the *mut SRET window) are reliable.
    //
    // The compare is over a FIXED 8-byte window, treating each entry-name byte
    // past its length as 0. A shorter entry name must therefore be an EXACT
    // match (its trailing window bytes are 0, matching the zero-padded `buf`),
    // not a mere prefix of `buf`. Without this a short struct (e.g. `Str`,
    // len 3) shadowed any longer struct sharing that prefix (`StrSplit`) when
    // both are present in one merged multi-module table: `&StrSplit` refs then
    // resolved to `Str`, and every `StrSplit`-only field read (`.count`,`.lens`)
    // reported a spurious E012. make_name zero-fills Name.buf past len and the
    // SRET window preserves those 8 bytes verbatim, so buf[len..7] == 0 for any
    // name of length < 8; the 8-byte zero-padded compare is exact there.
    var i: i64 = 0
    while i < (*t).count {
        let en = (*t).entries[i as usize]
        if en.name.len > 0 {
            var ok: bool = true
            var j: i64 = 0
            while j < 8 {
                let en_byte: i8 = if j < en.name.len { en.name.buf[j as usize] } else { 0 as i8 }
                if en_byte != buf[j as usize] { ok = false }
                j = j + 1
            }
            if ok { return i }
        }
        i = i + 1
    }
    0 - 1
}

pub fn struct_table_get(t: *mut StructTable, idx: i64) -> StructInfo with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        empty_struct_info()
    } else {
        (*t).entries[idx as usize]
    }
}

fn struct_table_get_visibility(t: *mut StructTable, idx: i64) -> Visibility with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        visibility_private()
    } else {
        (*t).entries[idx as usize].visibility
    }
}

fn struct_table_get_defining_module(t: *mut StructTable, idx: i64) -> AstPath with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        empty_path()
    } else {
        (*t).entries[idx as usize].defining_module
    }
}

pub fn struct_table_alloc() -> *mut StructTable with Mut, Panic, Div, Alloc {
    heap_alloc(8388608) as *mut StructTable
}

// ============================================================
// Variant info (for enum variants)
// ============================================================

pub struct VariantInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
}

fn empty_variant_info() -> VariantInfo {
    VariantInfo {
        name: Name { buf: [0; 384], len: 0 },
        fields: None,
    }
}

pub struct VariantInfoList {
    head: VariantInfo,
    tail: Option<Box<VariantInfoList>>,
}

pub fn variant_info_list_has(opt: Option<Box<VariantInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                variant_info_list_has((*list).tail, name)
            }
        }
    }
}

// Find a variant by name and return its fields (or None)
pub fn variant_info_list_find_fields(opt: Option<Box<VariantInfoList>>, name: Name) -> Option<Box<FieldInfoList>> with Mut, Panic, Div {
    match opt {
        None => None
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.fields
            } else {
                variant_info_list_find_fields((*list).tail, name)
            }
        }
    }
}

// Search all variants for a field by name, return its type
pub fn variant_fields_find_field(variants: Option<Box<VariantInfoList>>, field_name: Name) -> TypeEntry with Mut, Panic, Div {
    match variants {
        None => ty_unknown()
        Some(vlist) => {
            let result = field_info_list_find((*vlist).head.fields, field_name)
            if result.kind != TypeKind::TyUnknown {
                result
            } else {
                variant_fields_find_field((*vlist).tail, field_name)
            }
        }
    }
}

fn variant_info_list_append(list: VariantInfoList, node: VariantInfoList) -> VariantInfoList with Mut, Alloc {
    match list.tail {
        None => VariantInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => VariantInfoList {
            head: list.head,
            tail: Some(Box::new(variant_info_list_append(*rest, node))),
        }
    }
}

// ============================================================
// Enum info
// ============================================================

pub struct EnumInfo {
    name: Name,
    variants: Option<Box<VariantInfoList>>,
    variant_count: i64,
    visibility_kind: i64,
    defining_module_id: i64,
    visibility: Visibility,
    defining_module: AstPath,
}

fn empty_enum_info() -> EnumInfo {
    EnumInfo {
        name: Name { buf: [0; 384], len: 0 },
        variants: None,
        variant_count: 0,
        visibility_kind: VISIBILITY_PRIVATE,
        defining_module_id: 0,
        visibility: visibility_private(),
        defining_module: empty_path(),
    }
}

// ============================================================
// Enum table
// ============================================================

pub struct EnumTable {
    entries: [EnumInfo; 256],
    count: i64,
}

fn enum_table_new() -> EnumTable {
    EnumTable {
        entries: [empty_enum_info(); 256],
        count: 0,
    }
}

// EnumTable accessors (heap-indirect): table behind a `*mut EnumTable` in the
// Checker; by-value Checker copies share ONE table. See FnSigTable note above.

pub fn enum_table_add(t: *mut EnumTable, info: EnumInfo) with Mut, Panic, Div {
    let idx = (*t).count
    if idx < 256 {
        (*t).entries[idx as usize] = info
        (*t).count = idx + 1
    }
}

pub fn enum_table_find(t: *mut EnumTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*t).count {
        if name_eq((*t).entries[i].name, name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn enum_table_get(t: *mut EnumTable, idx: i64) -> EnumInfo with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        empty_enum_info()
    } else {
        (*t).entries[idx as usize]
    }
}

fn enum_table_get_visibility(t: *mut EnumTable, idx: i64) -> Visibility with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        visibility_private()
    } else {
        (*t).entries[idx as usize].visibility
    }
}

fn enum_table_get_defining_module(t: *mut EnumTable, idx: i64) -> AstPath with Mut, Panic, Div {
    if idx < 0 || idx >= (*t).count {
        empty_path()
    } else {
        (*t).entries[idx as usize].defining_module
    }
}

pub fn enum_table_find_variant_enum(t: *mut EnumTable, variant_name: Name) -> i64 with Mut, Panic, Div, Alloc {
    var i: i64 = 0
    while i < (*t).count {
        if variant_info_list_has((*t).entries[i].variants, variant_name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn enum_table_alloc() -> *mut EnumTable with Mut, Panic, Div, Alloc {
    heap_alloc(524288) as *mut EnumTable
}

// ============================================================
// Function parameter info
// ============================================================

pub struct FnParamInfo {
    name: Name,
    ty: TypeEntry,
}

pub fn empty_fn_param_info() -> FnParamInfo {
    FnParamInfo {
        name: Name { buf: [0; 384], len: 0 },
        ty: empty_type_entry(),
    }
}

fn fn_param_info_clone(info: &FnParamInfo) -> FnParamInfo with Mut, Alloc {
    FnParamInfo {
        name: (*info).name,
        ty: type_entry_clone(&(*info).ty),
    }
}

pub struct FnParamList {
    head: FnParamInfo,
    tail: Option<Box<FnParamList>>,
}

fn fn_param_list_append(list: FnParamList, node: FnParamList) -> FnParamList with Mut, Alloc {
    match list.tail {
        None => FnParamList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FnParamList {
            head: list.head,
            tail: Some(Box::new(fn_param_list_append(*rest, node))),
        }
    }
}

fn fn_param_list_count(opt: Option<Box<FnParamList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + fn_param_list_count((*list).tail)
    }
}

pub fn fn_param_list_get(opt: Option<Box<FnParamList>>, idx: i64) -> FnParamInfo with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_fn_param_info()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                fn_param_list_get((*list).tail, idx - 1)
            }
        }
    }
}

pub fn fn_param_list_clone(opt: &Option<Box<FnParamList>>) -> Option<Box<FnParamList>> with Mut, Alloc {
    match *opt {
        None => None
        Some(list) => Some(Box::new(FnParamList {
            head: fn_param_info_clone(&(*list).head),
            tail: fn_param_list_clone(&(*list).tail),
        }))
    }
}

// ============================================================
