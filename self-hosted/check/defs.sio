    head: PolicyRequirementInfo,
    tail: Option<Box<PolicyRequirementInfoList>>,
}

pub struct PolicyInfo {
    name: Name,
    target_ty: TypeEntry,
    level_name: Name,
    scope_name: Name,
    level_id: i64,
    scope_id: i64,
    requirements: Option<Box<PolicyRequirementInfoList>>,
    requirement_count: i64,
}

fn empty_policy_info() -> PolicyInfo {
    PolicyInfo {
        name: Name { buf: [0; 128], len: 0 },
        target_ty: empty_type_entry(),
        level_name: Name { buf: [0; 128], len: 0 },
        scope_name: Name { buf: [0; 128], len: 0 },
        level_id: -1,
        scope_id: -1,
        requirements: None,
        requirement_count: 0,
    }
}

pub struct PolicyTable {
    entries: [PolicyInfo; 16],
    count: i64,
}

fn policy_table_new() -> PolicyTable {
    PolicyTable {
        entries: [empty_policy_info(); 16],
        count: 0,
    }
}

impl PolicyTable {
    fn add(self, info: PolicyInfo) -> (PolicyTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 16 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> PolicyInfo with Panic, Div {
        self.entries[idx]
    }
}

