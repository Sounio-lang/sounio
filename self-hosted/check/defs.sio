// Definition tables for the type checker
//
// Three flat-array tables with linear scan lookup:
//   StructTable  — struct name + fields
//   EnumTable    — enum name + variants
//   FnSigTable   — fn name + params + return type + method info

use parser::ast::{BinaryOp, CompareOp, Expr, ExprKind, Name, UnaryOp, empty_path, name_eq}
use lexer::span::Span

// ============================================================
// Field info (for struct fields)
// ============================================================

struct FieldInfo {
    name: Name,
    ty: TypeEntry,
}

fn empty_field_info() -> FieldInfo {
    FieldInfo {
        name: Name { buf: [0; 128], len: 0 },
        ty: empty_type_entry(),
    }
}

struct FieldInfoList {
    head: FieldInfo,
    tail: Option<Box<FieldInfoList>>,
}

fn field_info_list_append(list: FieldInfoList, node: FieldInfoList) -> FieldInfoList with Mut, Alloc {
    match list.tail {
        None => FieldInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FieldInfoList {
            head: list.head,
            tail: Some(Box::new(field_info_list_append(*rest, node))),
        }
    }
}

fn field_info_list_find(opt: Option<Box<FieldInfoList>>, name: Name) -> TypeEntry with Mut, Panic, Div {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.ty
            } else {
                field_info_list_find((*list).tail, name)
            }
        }
    }
}

fn field_info_list_has(opt: Option<Box<FieldInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                field_info_list_has((*list).tail, name)
            }
        }
    }
}

// ============================================================
// Struct info
// ============================================================

struct StructInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
    field_count: i64,
    is_linear: bool,
    type_param_count: i64,
    type_param_names: [Name; 8],
    is_generic_template: bool,
}

fn empty_struct_info() -> StructInfo {
    StructInfo {
        name: Name { buf: [0; 128], len: 0 },
        fields: None,
        field_count: 0,
        is_linear: false,
        type_param_count: 0,
        type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
        is_generic_template: false,
    }
}

// ============================================================
// Struct table
// ============================================================

struct StructTable {
    entries: [StructInfo; 128],
    count: i64,
}

fn struct_table_new() -> StructTable {
    StructTable {
        entries: [empty_struct_info(); 128],
        count: 0,
    }
}

impl StructTable {
    fn add(self, info: StructInfo) -> StructTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 128 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> StructInfo with Panic, Div {
        self.entries[idx]
    }
}

// ============================================================
// Variant info (for enum variants)
// ============================================================

struct VariantInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
}

fn empty_variant_info() -> VariantInfo {
    VariantInfo {
        name: Name { buf: [0; 128], len: 0 },
        fields: None,
    }
}

struct VariantInfoList {
    head: VariantInfo,
    tail: Option<Box<VariantInfoList>>,
}

fn variant_info_list_has(opt: Option<Box<VariantInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                variant_info_list_has((*list).tail, name)
            }
        }
    }
}

// Find a variant by name and return its fields (or None)
fn variant_info_list_find_fields(opt: Option<Box<VariantInfoList>>, name: Name) -> Option<Box<FieldInfoList>> with Mut, Panic, Div {
    match opt {
        None => None
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.fields
            } else {
                variant_info_list_find_fields((*list).tail, name)
            }
        }
    }
}

// Search all variants for a field by name, return its type
fn variant_fields_find_field(variants: Option<Box<VariantInfoList>>, field_name: Name) -> TypeEntry with Mut, Panic, Div {
    match variants {
        None => ty_unknown()
        Some(vlist) => {
            let result = field_info_list_find((*vlist).head.fields, field_name)
            if result.kind != TypeKind::TyUnknown {
                result
            } else {
                variant_fields_find_field((*vlist).tail, field_name)
            }
        }
    }
}

fn variant_info_list_append(list: VariantInfoList, node: VariantInfoList) -> VariantInfoList with Mut, Alloc {
    match list.tail {
        None => VariantInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => VariantInfoList {
            head: list.head,
            tail: Some(Box::new(variant_info_list_append(*rest, node))),
        }
    }
}

// ============================================================
// Enum info
// ============================================================

struct EnumInfo {
    name: Name,
    variants: Option<Box<VariantInfoList>>,
    variant_count: i64,
}

fn empty_enum_info() -> EnumInfo {
    EnumInfo {
        name: Name { buf: [0; 128], len: 0 },
        variants: None,
        variant_count: 0,
    }
}

// ============================================================
// Enum table
// ============================================================

struct EnumTable {
    entries: [EnumInfo; 32],
    count: i64,
}

fn enum_table_new() -> EnumTable {
    EnumTable {
        entries: [empty_enum_info(); 32],
        count: 0,
    }
}

impl EnumTable {
    fn add(self, info: EnumInfo) -> EnumTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 32 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> EnumInfo with Panic, Div {
        self.entries[idx]
    }

    fn find_variant_enum(self, variant_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i: i64 = 0
        while i < self.count {
            if variant_info_list_has(self.entries[i].variants, variant_name) {
                return i
            }
            i = i + 1
        }
        -1
    }
}

// ============================================================
// Function parameter info
// ============================================================

struct FnParamInfo {
    name: Name,
    ty: TypeEntry,
}

fn empty_fn_param_info() -> FnParamInfo {
    FnParamInfo {
        name: Name { buf: [0; 128], len: 0 },
        ty: empty_type_entry(),
    }
}

struct FnParamList {
    head: FnParamInfo,
    tail: Option<Box<FnParamList>>,
}

fn fn_param_list_append(list: FnParamList, node: FnParamList) -> FnParamList with Mut, Alloc {
    match list.tail {
        None => FnParamList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FnParamList {
            head: list.head,
            tail: Some(Box::new(fn_param_list_append(*rest, node))),
        }
    }
}

fn fn_param_list_count(opt: Option<Box<FnParamList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + fn_param_list_count((*list).tail)
    }
}

fn fn_param_list_get(opt: Option<Box<FnParamList>>, idx: i64) -> FnParamInfo with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_fn_param_info()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                fn_param_list_get((*list).tail, idx - 1)
            }
        }
    }
}

// ============================================================
// Algebra registry
// ============================================================

struct AlgebraInfo {
    name: Name,
    add_commutative: bool,
    add_associative: bool,
    mul_commutative: bool,
    mul_associative: bool,
    mul_alternative: bool,
    reassoc_strategy: i64,   // 0=free, 1=blocked, 2=fano_selective
    algebra_tag: i64,        // backward compat with IR_ALG_* (3=Octonion, etc.)
    is_valid: bool,
}

struct AlgebraTable {
    entries: [AlgebraInfo; 16],
    count: i64,
}

fn empty_algebra_info() -> AlgebraInfo {
    AlgebraInfo {
        name: empty_name(),
        add_commutative: true,
        add_associative: true,
        mul_commutative: true,
        mul_associative: true,
        mul_alternative: false,
        reassoc_strategy: 0,
        algebra_tag: 0,
        is_valid: false,
    }
}

fn empty_algebra_table() -> AlgebraTable {
    AlgebraTable {
        entries: [empty_algebra_info(); 16],
        count: 0,
    }
}

// ============================================================
// Hyper expression metadata
// ============================================================

struct HyperExprInfo {
    span_start: i64,
    span_end: i64,
    algebra_tag: i64,
    op_kind: i64,  // 1 = multiply
    knowledge_wrapped: bool,
}

fn empty_hyper_expr_info() -> HyperExprInfo {
    HyperExprInfo {
        span_start: 0,
        span_end: 0,
        algebra_tag: -1,
        op_kind: 0,
        knowledge_wrapped: false,
    }
}

struct HyperExprTable {
    entries: [HyperExprInfo; 128],
    count: i64,
}

fn hyper_expr_table_new() -> HyperExprTable {
    HyperExprTable {
        entries: [empty_hyper_expr_info(); 128],
        count: 0,
    }
}

impl HyperExprTable {
    fn add(self, info: HyperExprInfo) -> (HyperExprTable, i64) with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 128 {
            let idx = tbl.count
            tbl.entries[idx as usize] = info
            tbl.count = idx + 1
            return (tbl, idx)
        }
        (tbl, -1)
    }
}

// ============================================================
// Function signature
// ============================================================

struct FnSig {
    name: Name,
    params: Option<Box<FnParamList>>,
    param_count: i64,
    return_type: TypeEntry,
    is_method: bool,
    self_type_name: Name,
    self_type_entry: TypeEntry,   // Semantic receiver type (replaces string heuristic)
    effects: [i64; 8],        // Effect IDs (encoded as integers for now)
    effect_count: i64,
    is_kernel: bool,
    is_epistemic_kernel: bool,
    // Sprint 231: Unified closure type theory
    is_linear_closure: bool,      // true if captures linear resources => call exactly once
    linear_capture_count: i64,    // number of linear captures
    epistemic_epsilon: f64,       // combined GUM epsilon from Knowledge captures (-1.0 = none)
}

fn empty_fn_sig() -> FnSig {
    FnSig {
        name: Name { buf: [0; 128], len: 0 },
        params: None,
        param_count: 0,
        return_type: ty_unit(),
        is_method: false,
        self_type_name: Name { buf: [0; 128], len: 0 },
        self_type_entry: ty_unit(),
        effects: [0; 8],
        effect_count: 0,
        is_kernel: false,
        is_epistemic_kernel: false,
        is_linear_closure: false,
        linear_capture_count: 0,
        epistemic_epsilon: 0.0 - 1.0,
    }
}

// ============================================================
// FnSig table
// ============================================================

struct FnSigTable {
    entries: [FnSig; 64],
    count: i64,
}

fn fn_sig_table_new() -> FnSigTable {
    FnSigTable {
        entries: [empty_fn_sig(); 64],
        count: 0,
    }
}

impl FnSigTable {
    fn add(self, sig: FnSig) -> (FnSigTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 64 {
            tbl.entries[tbl.count] = sig
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) && !self.entries[i].is_method {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn find_method(self, type_name: Name, method_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.entries[i].is_method && name_eq(self.entries[i].self_type_name, type_name) && name_eq(self.entries[i].name, method_name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    // Semantic method lookup: matches by TypeEntry kind+name instead of Name alone.
    // Resolves ambiguity when two types in different modules share a name.
    fn find_method_semantic(self, receiver_ty: TypeEntry, method_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.entries[i].is_method && name_eq(self.entries[i].name, method_name) {
                // Semantic match: compare type kind and name
                let sig_ty = self.entries[i].self_type_entry
                if sig_ty.kind == receiver_ty.kind && name_eq(sig_ty.name, receiver_ty.name) {
                    return i
                }
            }
            i = i + 1
        }
        // Fallback to string-based lookup for backward compatibility
        self.find_method(receiver_ty.name, method_name)
    }

    fn get(self, idx: i64) -> FnSig with Panic, Div {
        self.entries[idx]
    }
}

// ============================================================
// Contest / robustness policy metadata
// ============================================================

let CONTEST_METRIC_SIGN_CONSENSUS: i64 = 0
let CONTEST_METRIC_RELATIVE_BAND: i64 = 1
let CONTEST_METRIC_MAX_TAIL_RISK: i64 = 2
let CONTEST_METRIC_MECHANISTIC_DIVERGENCE: i64 = 3
let CONTEST_METRIC_IDENTIFIABILITY_FLOOR: i64 = 4
let CONTEST_METRIC_COUNTEREXAMPLE_PRESENT: i64 = 5
let CONTEST_METRIC_DEFERRED_REASON: i64 = 6
let CONTEST_METRIC_COUNT: i64 = 7

let POLICY_THRESHOLD_F64: i64 = 0
let POLICY_THRESHOLD_BOOL: i64 = 1
let POLICY_THRESHOLD_NAME: i64 = 2

struct PolicyRequirementInfo {
    metric_id: i64,
    metric_name: Name,
    op: CompareOp,
    threshold: f64,
    threshold_kind: i64,
    bool_threshold: bool,
    name_threshold: Name,
}

fn empty_policy_requirement_info() -> PolicyRequirementInfo {
    PolicyRequirementInfo {
        metric_id: -1,
        metric_name: Name { buf: [0; 128], len: 0 },
        op: CompareOp::CmpEq,
        threshold: 0.0,
        threshold_kind: POLICY_THRESHOLD_F64,
        bool_threshold: false,
        name_threshold: Name { buf: [0; 128], len: 0 },
    }
}

struct PolicyRequirementInfoList {
    head: PolicyRequirementInfo,
    tail: Option<Box<PolicyRequirementInfoList>>,
}

struct PolicyInfo {
    name: Name,
    target_ty: TypeEntry,
    level_name: Name,
    scope_name: Name,
    level_id: i64,
    scope_id: i64,
    requirements: Option<Box<PolicyRequirementInfoList>>,
    requirement_count: i64,
}

fn empty_policy_info() -> PolicyInfo {
    PolicyInfo {
        name: Name { buf: [0; 128], len: 0 },
        target_ty: empty_type_entry(),
        level_name: Name { buf: [0; 128], len: 0 },
        scope_name: Name { buf: [0; 128], len: 0 },
        level_id: -1,
        scope_id: -1,
        requirements: None,
        requirement_count: 0,
    }
}

struct PolicyTable {
    entries: [PolicyInfo; 16],
    count: i64,
}

fn policy_table_new() -> PolicyTable {
    PolicyTable {
        entries: [empty_policy_info(); 16],
        count: 0,
    }
}

impl PolicyTable {
    fn add(self, info: PolicyInfo) -> (PolicyTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 16 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> PolicyInfo with Panic, Div {
        self.entries[idx]
    }
}

