fn test_dep_sigma_fst_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // fst of a Sigma (pair) should extract fst type
    let fst_ty = dep_term_int(ctx, 3)
    let snd_ty = dep_term_int(ctx, 7)
    let pair = dep_term_sigma(ctx, 1, fst_ty, snd_ty)
    let proj = dep_term_fst(ctx, pair)
    let normed = dep_normalize(ctx, proj)
