fn test_dep_norm_nested_arith_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (2 + 3) * (4 - 1) normalizes to 15
    let two = dep_term_int(ctx, 2)
    let three = dep_term_int(ctx, 3)
    let four = dep_term_int(ctx, 4)
    let one = dep_term_int(ctx, 1)
    let sum = dep_term_add(ctx, two, three)
    let diff = dep_term_sub(ctx, four, one)
    let prod = dep_term_mul(ctx, sum, diff)
    let n = dep_normalize(ctx, prod)
