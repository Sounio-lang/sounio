// ============================================================
// Test Category 5: Pi Types (8 tests)
// ============================================================

fn test_dep_pi_construct_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let ty = dep_term_type(ctx)
    let body = dep_term_type(ctx)
    let pi = dep_term_pi(ctx, 1, ty, body)
    if pi < 0 { return false }
    let k = dep_get_kind(ctx, pi)
    if dep_term_kind_is_pi(k) == false { return false }
    if dep_get_var_id(ctx, pi) != 1 { return false }
    if dep_get_left(ctx, pi) != ty { return false }
    dep_get_right(ctx, pi) == body
}
fn test_dep_pi_construct() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_construct_inner(&! ctx)
}

fn test_dep_pi_elaborate_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let ty = dep_term_type(ctx)
    let body = dep_term_type(ctx)
    let pi = dep_elaborate_pi(ctx, 50, ty, body)
    if pi < 0 { return false }
    // Should have bound var 50 in the environment
    let found = dep_lookup_var(ctx, 50)
    found == ty
}
fn test_dep_pi_elaborate() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_elaborate_inner(&! ctx)
}

fn test_dep_pi_apply_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Pi(x : Type, x) applied to Int(5) gives Int(5)
    let ty = dep_term_type(ctx)
    let x = dep_term_var(ctx, 1)
    let pi = dep_term_pi(ctx, 1, ty, x)
    let five = dep_term_int(ctx, 5)
    let result = dep_apply_pi(ctx, pi, five)
    // body[x := 5] = 5
    dep_term_to_i64(ctx, result) == 5
}
fn test_dep_pi_apply() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_apply_inner(&! ctx)
}

fn test_dep_pi_subst_body_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Pi(x : Type, x + 1) applied to 10 normalizes to 11
    let ty = dep_term_type(ctx)
    let x = dep_term_var(ctx, 1)
    let one = dep_term_int(ctx, 1)
    let body = dep_term_add(ctx, x, one)
    let pi = dep_term_pi(ctx, 1, ty, body)
    let ten = dep_term_int(ctx, 10)
    let result = dep_apply_pi(ctx, pi, ten)
    let normed = dep_normalize(ctx, result)
    dep_term_to_i64(ctx, normed) == 11
}
fn test_dep_pi_subst_body() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_subst_body_inner(&! ctx)
}

fn test_dep_pi_well_formed_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let ty = dep_term_type(ctx)
    let body = dep_term_type(ctx)
    let pi = dep_term_pi(ctx, 1, ty, body)
    dep_pi_well_formed(ctx, pi)
}
fn test_dep_pi_well_formed() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_well_formed_inner(&! ctx)
}

fn test_dep_pi_not_well_formed_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // A non-Pi term should fail well-formedness
    let t = dep_term_int(ctx, 5)
    dep_pi_well_formed(ctx, t) == false
}
fn test_dep_pi_not_well_formed() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_pi_not_well_formed_inner(&! ctx)
}

fn test_dep_pi_unify_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
