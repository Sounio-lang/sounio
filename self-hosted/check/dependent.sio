// Check whether a kind is a binary arithmetic/comparison operator
fn dep_term_kind_is_binop(k: DepTermKind) -> bool {
    match k {
        DepTermKind::TermAdd => true,
        DepTermKind::TermSub => true,
        DepTermKind::TermMul => true,
        DepTermKind::TermDiv => true,
        DepTermKind::TermMod => true,
        DepTermKind::TermEq  => true,
        DepTermKind::TermLt  => true,
        DepTermKind::TermLe  => true,
        DepTermKind::TermGt  => true,
        DepTermKind::TermGe  => true,
        DepTermKind::TermAnd => true,
        DepTermKind::TermOr  => true,
        _ => false,
    }
}

// Check whether a kind is a unary operator
fn dep_term_kind_is_unop(k: DepTermKind) -> bool {
    match k {
        DepTermKind::TermNeg => true,
        DepTermKind::TermNot => true,
        _ => false,
    }
}

// ============================================================
// Section 7: Core Term Allocation
// ============================================================

// Allocate a term node in the arena. Returns the term ID (index).
fn dep_alloc_term(ctx: &! DepContext, kind: DepTermKind, val: i64, left: i64, right: i64) -> i64 with Mut, Div, Panic {
    let idx = ctx.term_count
    if idx >= DEP_MAX_TERMS {
        return DEP_INVALID
    }
    ctx.terms[idx as usize] = DepTerm {
        kind: kind,
        val: val,
        left: left,
        right: right,
        var_id: DEP_INVALID,
        body: DEP_INVALID,
    }
    ctx.term_count = idx + 1
    idx
}

// Allocate a term with all six fields specified.
fn dep_alloc_term_full(ctx: &! DepContext, kind: DepTermKind, val: i64, left: i64, right: i64, var_id: i64, body: i64) -> i64 with Mut, Div, Panic {
    let idx = ctx.term_count
    if idx >= DEP_MAX_TERMS {
        return DEP_INVALID
    }
    ctx.terms[idx as usize] = DepTerm {
        kind: kind,
        val: val,
        left: left,
        right: right,
        var_id: var_id,
        body: body,
    }
    ctx.term_count = idx + 1
    idx
}

// ============================================================
// Section 8: Convenience Term Constructors
// ============================================================

// Integer literal term
fn dep_term_int(ctx: &! DepContext, val: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermIntLit, val, DEP_INVALID, DEP_INVALID)
}

// Boolean literal term (val: 1 = true, 0 = false)
fn dep_term_bool(ctx: &! DepContext, val: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermBoolLit, val, DEP_INVALID, DEP_INVALID)
}

// Variable reference term
fn dep_term_var(ctx: &! DepContext, var_id: i64) -> i64 with Mut, Div, Panic {
    let idx = ctx.term_count
    if idx >= DEP_MAX_TERMS {
        return DEP_INVALID
    }
    ctx.terms[idx as usize] = DepTerm {
        kind: DepTermKind::TermVar,
        val: 0,
        left: DEP_INVALID,
        right: DEP_INVALID,
        var_id: var_id,
        body: DEP_INVALID,
    }
    ctx.term_count = idx + 1
    idx
}

// Addition: left + right
fn dep_term_add(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermAdd, 0, l, r)
}

// Subtraction: left - right
fn dep_term_sub(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermSub, 0, l, r)
}

// Multiplication: left * right
fn dep_term_mul(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermMul, 0, l, r)
}

// Division: left / right
fn dep_term_div(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermDiv, 0, l, r)
}

// Modulo: left % right
fn dep_term_mod(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermMod, 0, l, r)
}

// Negation: -operand
fn dep_term_neg(ctx: &! DepContext, operand: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermNeg, 0, operand, DEP_INVALID)
}

// Equality: left == right
fn dep_term_eq(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermEq, 0, l, r)
}

// Less-than: left < right
fn dep_term_lt(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermLt, 0, l, r)
}

// Less-or-equal: left <= right
fn dep_term_le(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermLe, 0, l, r)
}

// Greater-than: left > right
fn dep_term_gt(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermGt, 0, l, r)
}

// Greater-or-equal: left >= right
fn dep_term_ge(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermGe, 0, l, r)
}

// Logical AND: left && right
fn dep_term_and(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermAnd, 0, l, r)
}

// Logical OR: left || right
fn dep_term_or(ctx: &! DepContext, l: i64, r: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermOr, 0, l, r)
}

// Logical NOT: !operand
fn dep_term_not(ctx: &! DepContext, operand: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermNot, 0, operand, DEP_INVALID)
}

// Application: func(arg)
fn dep_term_app(ctx: &! DepContext, func: i64, arg: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermApp, 0, func, arg)
}

// Lambda: \var_id. body
fn dep_term_lam(ctx: &! DepContext, var_id: i64, body: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term_full(ctx, DepTermKind::TermLam, 0, DEP_INVALID, DEP_INVALID, var_id, body)
}

// Pi type: (var_id : param_type) -> body_type
fn dep_term_pi(ctx: &! DepContext, var_id: i64, param_type: i64, body_type: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term_full(ctx, DepTermKind::TermPi, 0, param_type, body_type, var_id, DEP_INVALID)
}

// Sigma type: (var_id : fst_type, snd_type)
fn dep_term_sigma(ctx: &! DepContext, var_id: i64, fst_type: i64, snd_type: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term_full(ctx, DepTermKind::TermSigma, 0, fst_type, snd_type, var_id, DEP_INVALID)
}

// First projection: fst(pair)
fn dep_term_fst(ctx: &! DepContext, pair: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermFst, 0, pair, DEP_INVALID)
}

// Second projection: snd(pair)
fn dep_term_snd(ctx: &! DepContext, pair: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermSnd, 0, pair, DEP_INVALID)
}

// Conditional: if cond then then_t else else_t
fn dep_term_if(ctx: &! DepContext, cond: i64, then_t: i64, else_t: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term_full(ctx, DepTermKind::TermIf, 0, cond, then_t, DEP_INVALID, else_t)
}

// Let binding: let var_id = bound_val in body
fn dep_term_let(ctx: &! DepContext, var_id: i64, bound_val: i64, body: i64) -> i64 with Mut, Div, Panic {
    dep_alloc_term_full(ctx, DepTermKind::TermLet, 0, bound_val, DEP_INVALID, var_id, body)
}

// Type universe: Type
fn dep_term_type(ctx: &! DepContext) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermType, 0, DEP_INVALID, DEP_INVALID)
}

// Bottom / absurd type
fn dep_term_bottom(ctx: &! DepContext) -> i64 with Mut, Div, Panic {
    dep_alloc_term(ctx, DepTermKind::TermBottom, 0, DEP_INVALID, DEP_INVALID)
}

// ============================================================
// Section 9: Term Field Accessors
// ============================================================

// Get the kind of a term by ID. Returns TermBottom for invalid IDs.
fn dep_get_kind(ctx: &DepContext, term: i64) -> DepTermKind with Div, Panic {
    if term < 0 { return DepTermKind::TermBottom }
    if term >= ctx.term_count { return DepTermKind::TermBottom }
    ctx.terms[term as usize].kind
}

// Get the val field of a term
fn dep_get_val(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return 0 }
    if term >= ctx.term_count { return 0 }
    ctx.terms[term as usize].val
}

// Get the left child of a term
fn dep_get_left(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    ctx.terms[term as usize].left
}

// Get the right child of a term
fn dep_get_right(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    ctx.terms[term as usize].right
}

// Get the var_id field of a term
fn dep_get_var_id(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    ctx.terms[term as usize].var_id
}

// Get the body field of a term
fn dep_get_body(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    ctx.terms[term as usize].body
}

// ============================================================
// Section 10: Fresh Variable Generation
// ============================================================

// Generate a fresh variable ID, guaranteed unique within this context.
fn dep_fresh_var(ctx: &! DepContext) -> i64 with Mut {
    let v = ctx.next_var
    ctx.next_var = v + 1
    v
}

// ============================================================
// Section 11: Variable Environment
// ============================================================

// Bind a variable name to a type in the environment.
fn dep_bind_var(ctx: &! DepContext, name: i64, type_id: i64) -> bool with Mut, Div, Panic {
    if ctx.var_count >= DEP_MAX_VARS {
        return false
    }
    let idx = ctx.var_count
    ctx.var_names[idx as usize] = name
    ctx.var_types[idx as usize] = type_id
    ctx.var_count = idx + 1
    true
}

// Look up the type of a variable. Returns DEP_INVALID if not found.
// Searches from the end (most recent binding) to handle shadowing.
fn dep_lookup_var(ctx: &DepContext, name: i64) -> i64 with Mut, Div, Panic {
    var i = ctx.var_count - 1
    while i >= 0 {
        if ctx.var_names[i as usize] == name {
            return ctx.var_types[i as usize]
        }
        i = i - 1
    }
    DEP_INVALID
}

// Pop n variable bindings from the environment.
fn dep_pop_vars(ctx: &! DepContext, n: i64) with Mut {
    var new_count = ctx.var_count - n
    if new_count < 0 {
        new_count = 0
    }
    ctx.var_count = new_count
}

// ============================================================
// Section 12: Error Recording
// ============================================================

// Record an error code in the context.
fn dep_record_error(ctx: &! DepContext, code: i64) with Mut, Div, Panic {
    if ctx.error_count >= DEP_MAX_VARS {
        return
    }
    let idx = ctx.error_count
    ctx.errors[idx as usize] = code
    ctx.error_count = idx + 1
}

// Check if any errors have been recorded.
fn dep_has_errors(ctx: &DepContext) -> bool {
    ctx.error_count > 0
}

// Get the number of recorded errors.
fn dep_error_count(ctx: &DepContext) -> i64 {
    ctx.error_count
}

// Clear all recorded errors.
fn dep_clear_errors(ctx: &! DepContext) with Mut {
    ctx.error_count = 0
}

// ============================================================
// Section 13: Term Value Queries
// ============================================================

// Check if a term is a value (fully reduced: literal, lambda, pi, sigma, type, bottom).
fn dep_is_value(ctx: &DepContext, term: i64) -> bool with Div, Panic {
    if term < 0 { return false }
    if term >= ctx.term_count { return false }
    let k = ctx.terms[term as usize].kind
    match k {
        DepTermKind::TermIntLit  => true,
        DepTermKind::TermBoolLit => true,
        DepTermKind::TermLam     => true,
        DepTermKind::TermPi      => true,
        DepTermKind::TermSigma   => true,
        DepTermKind::TermType    => true,
        DepTermKind::TermBottom  => true,
        _ => false,
    }
}

// Extract integer from TermIntLit. Returns DEP_INVALID for non-integer terms.
fn dep_term_to_i64(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    let k = ctx.terms[term as usize].kind
    if dep_term_kind_is_int_lit(k) {
        return ctx.terms[term as usize].val
    }
    DEP_INVALID
}

// Extract boolean from TermBoolLit. Returns DEP_INVALID for non-boolean terms.
fn dep_term_to_bool(ctx: &DepContext, term: i64) -> i64 with Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }
    let k = ctx.terms[term as usize].kind
    if dep_term_kind_is_bool_lit(k) {
        return ctx.terms[term as usize].val
    }
    DEP_INVALID
}

// Check if a term is valid (non-negative and within bounds).
fn dep_term_valid(ctx: &DepContext, term: i64) -> bool {
    if term < 0 { return false }
    if term >= ctx.term_count { return false }
    true
}

// ============================================================
// Section 14: Occurs Check
// ============================================================

// Check if a variable (by var_id) occurs anywhere in a term.
// Uses iterative worklist to avoid stack overflow on deep terms.
fn dep_occurs_check(ctx: &! DepContext, var_id: i64, term: i64) -> bool with Mut, Div, Panic {
    // Iterative worklist approach: we check up to 256 pending items
    var worklist: [i64; 256] = [0; 256]
    var wl_count: i64 = 0

    // Seed with the initial term
    if term >= 0 {
        worklist[0 as usize] = term
        wl_count = 1
    }

    while wl_count > 0 {
        wl_count = wl_count - 1
        let current = worklist[wl_count as usize]

        if current < 0 { continue }
        if current >= ctx.term_count { continue }

        let k = ctx.terms[current as usize].kind

        // Check if this is the variable we are looking for
        if dep_term_kind_is_var(k) {
            if ctx.terms[current as usize].var_id == var_id {
                return true
            }
            continue
        }

        // For literals, Type, Bottom: no children to inspect
        if dep_term_kind_is_int_lit(k) { continue }
        if dep_term_kind_is_bool_lit(k) { continue }
        if dep_term_kind_is_type(k) { continue }
        if dep_term_kind_is_bottom(k) { continue }

        // Push children onto worklist
        let t_left = ctx.terms[current as usize].left
        let t_right = ctx.terms[current as usize].right
        let t_body = ctx.terms[current as usize].body
        let t_var = ctx.terms[current as usize].var_id

        // For lambda/pi/sigma: check if the binder shadows the variable
        if dep_term_kind_is_lam(k) {
            if t_var == var_id {
                // Variable is shadowed by this lambda binder; skip body
                continue
            }
        }
        if dep_term_kind_is_pi(k) {
            if t_var == var_id {
                // Shadowed by Pi binder; still check param type (left)
                if t_left >= 0 {
                    if wl_count < 256 {
                        worklist[wl_count as usize] = t_left
                        wl_count = wl_count + 1
                    }
                }
                continue
            }
        }
        if dep_term_kind_is_sigma(k) {
            if t_var == var_id {
                // Shadowed by Sigma binder; still check fst type (left)
                if t_left >= 0 {
                    if wl_count < 256 {
                        worklist[wl_count as usize] = t_left
                        wl_count = wl_count + 1
                    }
                }
                continue
            }
        }
        if dep_term_kind_is_let(k) {
            // Push bound value
            if t_left >= 0 {
                if wl_count < 256 {
                    worklist[wl_count as usize] = t_left
                    wl_count = wl_count + 1
                }
            }
            if t_var == var_id {
                // Shadowed in body
                continue
            }
        }

        // Push left child
        if t_left >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_left
                wl_count = wl_count + 1
            }
        }
        // Push right child
        if t_right >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_right
                wl_count = wl_count + 1
            }
        }
        // Push body
        if t_body >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_body
                wl_count = wl_count + 1
            }
        }
    }

    false
}

// ============================================================
// Section 15: Capture-Avoiding Substitution
// ============================================================

// Substitute all free occurrences of var_id with replacement in term.
// Capture-avoiding: if a binder shadows var_id, its body is not traversed.
// If a binder would capture a free variable in replacement, we alpha-rename.
// This creates new term nodes in the arena (does not mutate existing terms).
fn dep_substitute(ctx: &! DepContext, term: i64, var_id: i64, replacement: i64) -> i64 with Mut, Div, Panic {
    if term < 0 { return term }
    if term >= ctx.term_count { return term }

    let k = ctx.terms[term as usize].kind

    // Variable: if it matches, return replacement; otherwise unchanged
    if dep_term_kind_is_var(k) {
        if ctx.terms[term as usize].var_id == var_id {
            return replacement
        }
        return term
    }

    // Literals, Type, Bottom: no substitution needed
    if dep_term_kind_is_int_lit(k) { return term }
    if dep_term_kind_is_bool_lit(k) { return term }
    if dep_term_kind_is_type(k) { return term }
    if dep_term_kind_is_bottom(k) { return term }

    // Unary operators
    if dep_term_kind_is_neg(k) {
        let new_inner = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        return dep_term_neg(ctx, new_inner)
    }
    if dep_term_kind_is_not(k) {
        let new_inner = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        return dep_term_not(ctx, new_inner)
    }

    // Binary operators
    if dep_term_kind_is_binop(k) {
        let new_left = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        let new_right = dep_substitute(ctx, ctx.terms[term as usize].right, var_id, replacement)
        match k {
            DepTermKind::TermAdd => { return dep_term_add(ctx, new_left, new_right) },
            DepTermKind::TermSub => { return dep_term_sub(ctx, new_left, new_right) },
            DepTermKind::TermMul => { return dep_term_mul(ctx, new_left, new_right) },
            DepTermKind::TermDiv => { return dep_term_div(ctx, new_left, new_right) },
            DepTermKind::TermMod => { return dep_term_mod(ctx, new_left, new_right) },
            DepTermKind::TermEq  => { return dep_term_eq(ctx, new_left, new_right) },
            DepTermKind::TermLt  => { return dep_term_lt(ctx, new_left, new_right) },
            DepTermKind::TermLe  => { return dep_term_le(ctx, new_left, new_right) },
            DepTermKind::TermGt  => { return dep_term_gt(ctx, new_left, new_right) },
            DepTermKind::TermGe  => { return dep_term_ge(ctx, new_left, new_right) },
            DepTermKind::TermAnd => { return dep_term_and(ctx, new_left, new_right) },
            DepTermKind::TermOr  => { return dep_term_or(ctx, new_left, new_right) },
            _ => { return term },
        }
    }

    // Application: substitute in both function and argument
    if dep_term_kind_is_app(k) {
        let new_func = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        let new_arg = dep_substitute(ctx, ctx.terms[term as usize].right, var_id, replacement)
        return dep_term_app(ctx, new_func, new_arg)
    }

    // Lambda: \binder. body
    if dep_term_kind_is_lam(k) {
        let binder = ctx.terms[term as usize].var_id
        let body = ctx.terms[term as usize].body
        // If the binder shadows var_id, no substitution in body
        if binder == var_id {
            return term
        }
        // Capture avoidance: if binder occurs free in replacement, alpha-rename
        if dep_occurs_check(ctx, binder, replacement) {
            let fresh = dep_fresh_var(ctx)
            // Rename binder -> fresh in body first
            // Hoisted: dep_term_var and dep_substitute BOTH take `&! DepContext`, so
            // nesting the call inside the argument list takes two exclusive borrows
            // of ctx at once (E038). Binding first sequences them. Same expression,
            // same order of effects — dep_term_var already ran before dep_substitute.
            let fresh_term = dep_term_var(ctx, fresh)
            let renamed_body = dep_substitute(ctx, body, binder, fresh_term)
            // Now substitute var_id -> replacement in renamed body
            let new_body = dep_substitute(ctx, renamed_body, var_id, replacement)
            return dep_term_lam(ctx, fresh, new_body)
        }
        let new_body = dep_substitute(ctx, body, var_id, replacement)
        return dep_term_lam(ctx, binder, new_body)
    }

    // Pi type: (binder : param_type) -> body_type
    if dep_term_kind_is_pi(k) {
        let binder = ctx.terms[term as usize].var_id
        let param_type = ctx.terms[term as usize].left
        let body_type = ctx.terms[term as usize].right
        let new_param = dep_substitute(ctx, param_type, var_id, replacement)
        if binder == var_id {
            // Shadowed: only substitute in param type
            return dep_term_pi(ctx, binder, new_param, body_type)
        }
        if dep_occurs_check(ctx, binder, replacement) {
            let fresh = dep_fresh_var(ctx)
            let fresh_term = dep_term_var(ctx, fresh)
            let renamed_body = dep_substitute(ctx, body_type, binder, fresh_term)
            let new_body = dep_substitute(ctx, renamed_body, var_id, replacement)
            return dep_term_pi(ctx, fresh, new_param, new_body)
        }
        let new_body = dep_substitute(ctx, body_type, var_id, replacement)
        return dep_term_pi(ctx, binder, new_param, new_body)
    }

    // Sigma type: (binder : fst_type, snd_type)
    if dep_term_kind_is_sigma(k) {
        let binder = ctx.terms[term as usize].var_id
        let fst_type = ctx.terms[term as usize].left
        let snd_type = ctx.terms[term as usize].right
        let new_fst = dep_substitute(ctx, fst_type, var_id, replacement)
        if binder == var_id {
            return dep_term_sigma(ctx, binder, new_fst, snd_type)
        }
        if dep_occurs_check(ctx, binder, replacement) {
            let fresh = dep_fresh_var(ctx)
            let fresh_term = dep_term_var(ctx, fresh)
            let renamed_snd = dep_substitute(ctx, snd_type, binder, fresh_term)
            let new_snd = dep_substitute(ctx, renamed_snd, var_id, replacement)
            return dep_term_sigma(ctx, fresh, new_fst, new_snd)
        }
        let new_snd = dep_substitute(ctx, snd_type, var_id, replacement)
        return dep_term_sigma(ctx, binder, new_fst, new_snd)
    }

    // Projections
    if dep_term_kind_is_fst(k) {
        let new_pair = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        return dep_term_fst(ctx, new_pair)
    }
    if dep_term_kind_is_snd(k) {
        let new_pair = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        return dep_term_snd(ctx, new_pair)
    }

    // If-then-else: cond is in left, then is in right, else is in body
    if dep_term_kind_is_if(k) {
        let new_cond = dep_substitute(ctx, ctx.terms[term as usize].left, var_id, replacement)
        let new_then = dep_substitute(ctx, ctx.terms[term as usize].right, var_id, replacement)
        let new_else = dep_substitute(ctx, ctx.terms[term as usize].body, var_id, replacement)
        return dep_term_if(ctx, new_cond, new_then, new_else)
    }

    // Let binding: let binder = bound_val in body
    if dep_term_kind_is_let(k) {
        let binder = ctx.terms[term as usize].var_id
        let bound_val = ctx.terms[term as usize].left
        let body = ctx.terms[term as usize].body
        let new_bound = dep_substitute(ctx, bound_val, var_id, replacement)
        if binder == var_id {
            return dep_term_let(ctx, binder, new_bound, body)
        }
        if dep_occurs_check(ctx, binder, replacement) {
            let fresh = dep_fresh_var(ctx)
            let fresh_term = dep_term_var(ctx, fresh)
            let renamed_body = dep_substitute(ctx, body, binder, fresh_term)
            let new_body = dep_substitute(ctx, renamed_body, var_id, replacement)
            return dep_term_let(ctx, fresh, new_bound, new_body)
        }
        let new_body = dep_substitute(ctx, body, var_id, replacement)
        return dep_term_let(ctx, binder, new_bound, new_body)
    }

    // Fallthrough: unknown kind, return unchanged
    term
}

// ============================================================
// Section 16: Single-Step Normalization
// ============================================================

// Perform a single reduction step on a term. Returns the reduced term ID,
// or the original term if no reduction is possible.
fn dep_normalize_step(ctx: &! DepContext, term: i64) -> i64 with Mut, Div, Panic {
    if term < 0 { return term }
    if term >= ctx.term_count { return term }

    let k = ctx.terms[term as usize].kind

    // Values are already reduced
    if dep_term_kind_is_int_lit(k) { return term }
    if dep_term_kind_is_bool_lit(k) { return term }
    if dep_term_kind_is_lam(k) { return term }
    if dep_term_kind_is_type(k) { return term }
    if dep_term_kind_is_bottom(k) { return term }

    // Variable: look up in substitutions
    if dep_term_kind_is_var(k) {
        let vid = ctx.terms[term as usize].var_id
        var si: i64 = 0
        while si < ctx.subst_count {
            if ctx.subst[si as usize].var_id == vid {
                return ctx.subst[si as usize].replacement
            }
            si = si + 1
        }
        return term
    }

    // Negation
    if dep_term_kind_is_neg(k) {
        let inner = ctx.terms[term as usize].left
        if dep_term_kind_is_int_lit(dep_get_kind(ctx, inner)) {
            let v = dep_get_val(ctx, inner)
            return dep_term_int(ctx, 0 - v)
        }
        return term
    }

    // Logical NOT
    if dep_term_kind_is_not(k) {
        let inner = ctx.terms[term as usize].left
        if dep_term_kind_is_bool_lit(dep_get_kind(ctx, inner)) {
            let v = dep_get_val(ctx, inner)
            if v == 0 {
                return dep_term_bool(ctx, 1)
            }
            return dep_term_bool(ctx, 0)
        }
        return term
    }

    // Arithmetic binary operators on integer literals
    if dep_term_kind_is_add(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                return dep_term_int(ctx, lv + rv)
            }
        }
        return term
    }

    if dep_term_kind_is_sub(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                return dep_term_int(ctx, lv - rv)
            }
        }
        return term
    }

    if dep_term_kind_is_mul(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                return dep_term_int(ctx, lv * rv)
            }
        }
        return term
    }

    if dep_term_kind_is_div(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if rv == 0 { return term }  // Division by zero: stuck
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                return dep_term_int(ctx, lv / rv)
            }
        }
        return term
    }

    if dep_term_kind_is_mod(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if rv == 0 { return term }
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                return dep_term_int(ctx, lv % rv)
            }
        }
        return term
    }

    // Comparison operators
    if dep_term_kind_is_eq(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if lv == rv { return dep_term_bool(ctx, 1) }
                return dep_term_bool(ctx, 0)
            }
        }
        return term
    }

    if dep_term_kind_is_lt(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if lv < rv { return dep_term_bool(ctx, 1) }
                return dep_term_bool(ctx, 0)
            }
        }
        return term
    }

    if dep_term_kind_is_le(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if lv <= rv { return dep_term_bool(ctx, 1) }
                return dep_term_bool(ctx, 0)
            }
        }
        return term
    }

    if dep_term_kind_is_gt(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if lv > rv { return dep_term_bool(ctx, 1) }
                return dep_term_bool(ctx, 0)
            }
        }
        return term
    }

    if dep_term_kind_is_ge(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_int_lit(lk) {
            if dep_term_kind_is_int_lit(rk) {
                let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                if lv >= rv { return dep_term_bool(ctx, 1) }
                return dep_term_bool(ctx, 0)
            }
        }
        return term
    }

    // Logical AND
    if dep_term_kind_is_and(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_bool_lit(lk) {
            let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
            if lv == 0 { return dep_term_bool(ctx, 0) }
            if dep_term_kind_is_bool_lit(rk) {
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                return dep_term_bool(ctx, rv)
            }
        }
        return term
    }

    // Logical OR
    if dep_term_kind_is_or(k) {
        let lk = dep_get_kind(ctx, ctx.terms[term as usize].left)
        let rk = dep_get_kind(ctx, ctx.terms[term as usize].right)
        if dep_term_kind_is_bool_lit(lk) {
            let lv = dep_get_val(ctx, ctx.terms[term as usize].left)
            if lv == 1 { return dep_term_bool(ctx, 1) }
            if dep_term_kind_is_bool_lit(rk) {
                let rv = dep_get_val(ctx, ctx.terms[term as usize].right)
                return dep_term_bool(ctx, rv)
            }
        }
        return term
    }

    // Beta reduction: (\x. body)(arg) -> body[x := arg]
    if dep_term_kind_is_app(k) {
        let func = ctx.terms[term as usize].left
        let arg = ctx.terms[term as usize].right
        if func >= 0 {
            if func < ctx.term_count {
                let fk = ctx.terms[func as usize].kind
                if dep_term_kind_is_lam(fk) {
                    let param = ctx.terms[func as usize].var_id
                    let body = ctx.terms[func as usize].body
                    return dep_substitute(ctx, body, param, arg)
                }
            }
        }
        return term
    }

    // First projection
    if dep_term_kind_is_fst(k) {
        let pair = ctx.terms[term as usize].left
        if pair >= 0 {
            if pair < ctx.term_count {
                let pk = ctx.terms[pair as usize].kind
                if dep_term_kind_is_sigma(pk) {
                    return ctx.terms[pair as usize].left
                }
            }
        }
        return term
    }

    // Second projection
    if dep_term_kind_is_snd(k) {
        let pair = ctx.terms[term as usize].left
        if pair >= 0 {
            if pair < ctx.term_count {
                let pk = ctx.terms[pair as usize].kind
                if dep_term_kind_is_sigma(pk) {
                    return ctx.terms[pair as usize].right
                }
            }
        }
        return term
    }

    // If-then-else: reduce if condition is a boolean literal
    if dep_term_kind_is_if(k) {
        let cond = ctx.terms[term as usize].left
        if cond >= 0 {
            if cond < ctx.term_count {
                let ck = ctx.terms[cond as usize].kind
                if dep_term_kind_is_bool_lit(ck) {
                    let cv = ctx.terms[cond as usize].val
                    if cv == 1 {
                        return ctx.terms[term as usize].right  // then branch
                    }
                    return ctx.terms[term as usize].body  // else branch
                }
            }
        }
        return term
    }

    // Let binding: let x = v in body -> body[x := v]
    if dep_term_kind_is_let(k) {
        let binder = ctx.terms[term as usize].var_id
        let bound = ctx.terms[term as usize].left
        let body = ctx.terms[term as usize].body
        return dep_substitute(ctx, body, binder, bound)
    }

    // Pi and Sigma are values (type formers), no reduction
    if dep_term_kind_is_pi(k) { return term }
    if dep_term_kind_is_sigma(k) { return term }

    term
}

// ============================================================
// Section 17: Full Normalization (with fuel)
// ============================================================

// Normalize a term to its normal form. Uses fuel to bound evaluation
// of potentially divergent terms. Returns the fully-reduced term ID.
fn dep_normalize(ctx: &! DepContext, term: i64) -> i64 with Mut, Div, Panic {
    var current = term
    var fuel = ctx.norm_fuel

    while fuel > 0 {
        let next = dep_normalize_step(ctx, current)
        if next == current {
            // No reduction happened; we are at normal form
            return current
        }
        current = next
        fuel = fuel - 1
    }

    // Ran out of fuel; return whatever we have
    current
}

// Normalize with explicit fuel limit (does not use context's norm_fuel).
fn dep_normalize_with_fuel(ctx: &! DepContext, term: i64, max_fuel: i64) -> i64 with Mut, Div, Panic {
    var current = term
    var fuel = max_fuel

    while fuel > 0 {
        let next = dep_normalize_step(ctx, current)
        if next == current {
            return current
        }
        current = next
        fuel = fuel - 1
    }

    current
}

// ============================================================
// Section 18: Structural Equality
// ============================================================

// Check structural equality of two terms after normalization.
// Both terms are first normalized, then compared structurally.
fn dep_terms_equal(ctx: &! DepContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let na = dep_normalize(ctx, a)
    let nb = dep_normalize(ctx, b)
    return dep_terms_equal_raw(ctx, na, nb)
}

// Raw structural equality (no normalization). Compares term trees.
fn dep_terms_equal_raw(ctx: &! DepContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    // Same ID => same term
    if a == b { return true }

    // Bounds checks
    if a < 0 { return b < 0 }
    if b < 0 { return false }
    if a >= ctx.term_count { return false }
    if b >= ctx.term_count { return false }

    let ka = ctx.terms[a as usize].kind
    let kb = ctx.terms[b as usize].kind

    // Different kinds => not equal (with enum matching)
    // We compare kind tags by checking all combinations
    if dep_term_kind_tag(ka) != dep_term_kind_tag(kb) {
        return false
    }

    // Same kind: compare fields based on kind
    if dep_term_kind_is_int_lit(ka) {
        return ctx.terms[a as usize].val == ctx.terms[b as usize].val
    }

    if dep_term_kind_is_bool_lit(ka) {
        return ctx.terms[a as usize].val == ctx.terms[b as usize].val
    }

    if dep_term_kind_is_var(ka) {
        return ctx.terms[a as usize].var_id == ctx.terms[b as usize].var_id
    }

    if dep_term_kind_is_type(ka) { return true }
    if dep_term_kind_is_bottom(ka) { return true }

    // Unary: compare operand
    if dep_term_kind_is_neg(ka) {
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left)
    }
    if dep_term_kind_is_not(ka) {
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left)
    }

    // Binary: compare left and right
    if dep_term_kind_is_binop(ka) {
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].right, ctx.terms[b as usize].right)
    }

    // Application
    if dep_term_kind_is_app(ka) {
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].right, ctx.terms[b as usize].right)
    }

    // Lambda: compare binder and body (alpha-equivalence would be better,
    // but we use structural equality for simplicity)
    if dep_term_kind_is_lam(ka) {
        if ctx.terms[a as usize].var_id != ctx.terms[b as usize].var_id {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].body, ctx.terms[b as usize].body)
    }

    // Pi type
    if dep_term_kind_is_pi(ka) {
        if ctx.terms[a as usize].var_id != ctx.terms[b as usize].var_id {
            return false
        }
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].right, ctx.terms[b as usize].right)
    }

    // Sigma type
    if dep_term_kind_is_sigma(ka) {
        if ctx.terms[a as usize].var_id != ctx.terms[b as usize].var_id {
            return false
        }
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].right, ctx.terms[b as usize].right)
    }

    // Projections
    if dep_term_kind_is_fst(ka) {
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left)
    }
    if dep_term_kind_is_snd(ka) {
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left)
    }

    // If-then-else
    if dep_term_kind_is_if(ka) {
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].right, ctx.terms[b as usize].right) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].body, ctx.terms[b as usize].body)
    }

    // Let
    if dep_term_kind_is_let(ka) {
        if ctx.terms[a as usize].var_id != ctx.terms[b as usize].var_id {
            return false
        }
        if dep_terms_equal_raw(ctx, ctx.terms[a as usize].left, ctx.terms[b as usize].left) == false {
            return false
        }
        return dep_terms_equal_raw(ctx, ctx.terms[a as usize].body, ctx.terms[b as usize].body)
    }

    false
}

// Assign a numeric tag to each DepTermKind for comparison.
fn dep_term_kind_tag(k: DepTermKind) -> i64 {
    match k {
        DepTermKind::TermVar     => 0,
        DepTermKind::TermIntLit  => 1,
        DepTermKind::TermBoolLit => 2,
        DepTermKind::TermAdd     => 3,
        DepTermKind::TermSub     => 4,
        DepTermKind::TermMul     => 5,
        DepTermKind::TermDiv     => 6,
        DepTermKind::TermMod     => 7,
        DepTermKind::TermNeg     => 8,
        DepTermKind::TermEq      => 9,
        DepTermKind::TermLt      => 10,
        DepTermKind::TermLe      => 11,
        DepTermKind::TermGt      => 12,
        DepTermKind::TermGe      => 13,
        DepTermKind::TermAnd     => 14,
        DepTermKind::TermOr      => 15,
        DepTermKind::TermNot     => 16,
        DepTermKind::TermApp     => 17,
        DepTermKind::TermLam     => 18,
        DepTermKind::TermPi      => 19,
        DepTermKind::TermSigma   => 20,
        DepTermKind::TermFst     => 21,
        DepTermKind::TermSnd     => 22,
        DepTermKind::TermIf      => 23,
        DepTermKind::TermLet     => 24,
        DepTermKind::TermType    => 25,
        DepTermKind::TermBottom  => 26,
    }
}

// ============================================================
// Section 19: Unification
// ============================================================

// Structural unification of two terms. Records substitutions for variables.
// Returns UnifyOk on success, UnifyFail on structural mismatch,
// UnifyStuck when terms cannot be compared (e.g. open variables).
fn dep_unify(ctx: &! DepContext, a: i64, b: i64) -> DepUnifyResult with Mut, Div, Panic {
    // Normalize both sides first
    let na = dep_normalize(ctx, a)
    let nb = dep_normalize(ctx, b)

    // Same term after normalization
    if na == nb { return DepUnifyResult::UnifyOk }

    // Bounds checks
    if na < 0 { return DepUnifyResult::UnifyFail }
    if nb < 0 { return DepUnifyResult::UnifyFail }
    if na >= ctx.term_count { return DepUnifyResult::UnifyFail }
    if nb >= ctx.term_count { return DepUnifyResult::UnifyFail }

    let ka = ctx.terms[na as usize].kind
    let kb = ctx.terms[nb as usize].kind

    // If either is a variable, bind it to the other
    if dep_term_kind_is_var(ka) {
        let vid = ctx.terms[na as usize].var_id
        // Occurs check
        if dep_occurs_check(ctx, vid, nb) {
            return DepUnifyResult::UnifyFail
        }
        return dep_add_subst(ctx, vid, nb)
    }

    if dep_term_kind_is_var(kb) {
        let vid = ctx.terms[nb as usize].var_id
        if dep_occurs_check(ctx, vid, na) {
            return DepUnifyResult::UnifyFail
        }
        return dep_add_subst(ctx, vid, na)
    }

    // Different kinds: fail
    if dep_term_kind_tag(ka) != dep_term_kind_tag(kb) {
        return DepUnifyResult::UnifyFail
    }

    // Same kind: unify sub-terms
    if dep_term_kind_is_int_lit(ka) {
        if ctx.terms[na as usize].val == ctx.terms[nb as usize].val {
            return DepUnifyResult::UnifyOk
        }
        return DepUnifyResult::UnifyFail
    }

    if dep_term_kind_is_bool_lit(ka) {
        if ctx.terms[na as usize].val == ctx.terms[nb as usize].val {
            return DepUnifyResult::UnifyOk
        }
        return DepUnifyResult::UnifyFail
    }

    if dep_term_kind_is_type(ka) { return DepUnifyResult::UnifyOk }
    if dep_term_kind_is_bottom(ka) { return DepUnifyResult::UnifyOk }

    // Binary operators
    if dep_term_kind_is_binop(ka) {
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                return dep_unify(ctx, ctx.terms[na as usize].right, ctx.terms[nb as usize].right)
            },
            _ => { return r1 },
        }
    }

    // Application
    if dep_term_kind_is_app(ka) {
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                return dep_unify(ctx, ctx.terms[na as usize].right, ctx.terms[nb as usize].right)
            },
            _ => { return r1 },
        }
    }

    // Lambda
    if dep_term_kind_is_lam(ka) {
        // Binders must match (structural, not alpha)
        if ctx.terms[na as usize].var_id != ctx.terms[nb as usize].var_id {
            return DepUnifyResult::UnifyStuck
        }
        return dep_unify(ctx, ctx.terms[na as usize].body, ctx.terms[nb as usize].body)
    }

    // Pi type
    if dep_term_kind_is_pi(ka) {
        if ctx.terms[na as usize].var_id != ctx.terms[nb as usize].var_id {
            return DepUnifyResult::UnifyStuck
        }
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                return dep_unify(ctx, ctx.terms[na as usize].right, ctx.terms[nb as usize].right)
            },
            _ => { return r1 },
        }
    }

    // Sigma type
    if dep_term_kind_is_sigma(ka) {
        if ctx.terms[na as usize].var_id != ctx.terms[nb as usize].var_id {
            return DepUnifyResult::UnifyStuck
        }
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                return dep_unify(ctx, ctx.terms[na as usize].right, ctx.terms[nb as usize].right)
            },
            _ => { return r1 },
        }
    }

    // Projections
    if dep_term_kind_is_fst(ka) {
        return dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
    }
    if dep_term_kind_is_snd(ka) {
        return dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
    }

    // If-then-else
    if dep_term_kind_is_if(ka) {
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                let r2 = dep_unify(ctx, ctx.terms[na as usize].right, ctx.terms[nb as usize].right)
                match r2 {
                    DepUnifyResult::UnifyOk => {
                        return dep_unify(ctx, ctx.terms[na as usize].body, ctx.terms[nb as usize].body)
                    },
                    _ => { return r2 },
                }
            },
            _ => { return r1 },
        }
    }

    // Negation / Not
    if dep_term_kind_is_neg(ka) {
        return dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
    }
    if dep_term_kind_is_not(ka) {
        return dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
    }

    // Let
    if dep_term_kind_is_let(ka) {
        if ctx.terms[na as usize].var_id != ctx.terms[nb as usize].var_id {
            return DepUnifyResult::UnifyStuck
        }
        let r1 = dep_unify(ctx, ctx.terms[na as usize].left, ctx.terms[nb as usize].left)
        match r1 {
            DepUnifyResult::UnifyOk => {
                return dep_unify(ctx, ctx.terms[na as usize].body, ctx.terms[nb as usize].body)
            },
            _ => { return r1 },
        }
    }

    DepUnifyResult::UnifyStuck
}

// Helper: add a substitution to the context. Returns UnifyOk on success.
fn dep_add_subst(ctx: &! DepContext, var_id: i64, replacement: i64) -> DepUnifyResult with Mut, Div, Panic {
    if ctx.subst_count >= DEP_MAX_SUBST {
        return DepUnifyResult::UnifyFail
    }
    let idx = ctx.subst_count
    ctx.subst[idx as usize] = DepSubstitution {
        var_id: var_id,
        replacement: replacement,
    }
    ctx.subst_count = idx + 1
    DepUnifyResult::UnifyOk
}

// ============================================================
// Section 20: Apply All Substitutions
// ============================================================

// Apply all pending substitutions to a term, iterating until fixed point.
fn dep_apply_subst(ctx: &! DepContext, term: i64) -> i64 with Mut, Div, Panic {
    var current = term
    var iterations: i64 = 0
    let max_iterations: i64 = 100

    while iterations < max_iterations {
        var changed = false
        var si: i64 = 0
        while si < ctx.subst_count {
            let vid = ctx.subst[si as usize].var_id
            let rep = ctx.subst[si as usize].replacement
            let new_term = dep_substitute(ctx, current, vid, rep)
            if new_term != current {
                current = new_term
                changed = true
            }
            si = si + 1
        }
        if changed == false {
            return current
        }
        iterations = iterations + 1
    }

    current
}

// ============================================================
// Section 21: Constraint Management
// ============================================================

// Add a constraint to the context.
fn dep_add_constraint(ctx: &! DepContext, kind: i64, lhs: i64, rhs: i64, span: i64) with Mut, Div, Panic {
    if ctx.constraint_count >= DEP_MAX_CONSTRAINTS {
        return
    }
    let idx = ctx.constraint_count
    ctx.constraints[idx as usize] = DepConstraint {
        kind: kind,
        lhs: lhs,
        rhs: rhs,
        span_line: span,
    }
    ctx.constraint_count = idx + 1
}

// Check a single constraint. Normalizes both sides, then compares.
fn dep_check_single_constraint(ctx: &! DepContext, idx: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= ctx.constraint_count { return false }

    let c_kind = ctx.constraints[idx as usize].kind
    let c_lhs = ctx.constraints[idx as usize].lhs
    let c_rhs = ctx.constraints[idx as usize].rhs

    let nl = dep_normalize(ctx, c_lhs)
    let nr = dep_normalize(ctx, c_rhs)

    match c_kind {
        DEP_CONSTRAINT_KIND_EQUAL => {
            return dep_terms_equal_raw(ctx, nl, nr)
        },
        DEP_CONSTRAINT_KIND_LESS_THAN => {
            let lv = dep_term_to_i64(ctx, nl)
            let rv = dep_term_to_i64(ctx, nr)
            if lv == DEP_INVALID { return false }
            if rv == DEP_INVALID { return false }
            return lv < rv
        },
        DEP_CONSTRAINT_KIND_LESS_EQ => {
            let lv = dep_term_to_i64(ctx, nl)
            let rv = dep_term_to_i64(ctx, nr)
            if lv == DEP_INVALID { return false }
            if rv == DEP_INVALID { return false }
            return lv <= rv
        },
        DEP_CONSTRAINT_KIND_GREATER_THAN => {
            let lv = dep_term_to_i64(ctx, nl)
            let rv = dep_term_to_i64(ctx, nr)
            if lv == DEP_INVALID { return false }
            if rv == DEP_INVALID { return false }
            return lv > rv
        },
        DEP_CONSTRAINT_KIND_GREATER_EQ => {
            let lv = dep_term_to_i64(ctx, nl)
            let rv = dep_term_to_i64(ctx, nr)
            if lv == DEP_INVALID { return false }
            if rv == DEP_INVALID { return false }
            return lv >= rv
        },
        DEP_CONSTRAINT_KIND_NON_ZERO => {
            let lv = dep_term_to_i64(ctx, nl)
            if lv == DEP_INVALID { return false }
            return lv != 0
        },
        DEP_CONSTRAINT_KIND_POSITIVE => {
            let lv = dep_term_to_i64(ctx, nl)
            if lv == DEP_INVALID { return false }
            return lv > 0
        },
    }
}

// Check all constraints in the context. Returns true if all pass.
fn dep_check_constraints(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.constraint_count {
        if dep_check_single_constraint(ctx, i) == false {
            return false
        }
        i = i + 1
    }
    true
}

// Clear all constraints.
fn dep_clear_constraints(ctx: &! DepContext) with Mut {
    ctx.constraint_count = 0
}

// Clear all substitutions.
fn dep_clear_subst(ctx: &! DepContext) with Mut {
    ctx.subst_count = 0
}

// ============================================================
// Section 22: Pi and Sigma Type Elaboration
// ============================================================

// Elaborate a Pi type: (param_name : param_type) -> body_type.
// Allocates the Pi term in the arena and binds param_name in the environment.
fn dep_elaborate_pi(ctx: &! DepContext, param_name: i64, param_type: i64, body_type: i64) -> i64 with Mut, Div, Panic {
    // Create the Pi term
    let pi_id = dep_term_pi(ctx, param_name, param_type, body_type)
    if pi_id == DEP_INVALID {
        dep_record_error(ctx, 100)
        return DEP_INVALID
    }

    // Bind the parameter in the variable environment
    let bound = dep_bind_var(ctx, param_name, param_type)
    if bound == false {
        dep_record_error(ctx, 101)
    }

    pi_id
}

// Elaborate a Sigma type: (fst_name : fst_type, snd_type).
// Allocates the Sigma term and binds fst_name.
fn dep_elaborate_sigma(ctx: &! DepContext, fst_name: i64, fst_type: i64, snd_type: i64) -> i64 with Mut, Div, Panic {
    let sigma_id = dep_term_sigma(ctx, fst_name, fst_type, snd_type)
    if sigma_id == DEP_INVALID {
        dep_record_error(ctx, 200)
        return DEP_INVALID
    }

    let bound = dep_bind_var(ctx, fst_name, fst_type)
    if bound == false {
        dep_record_error(ctx, 201)
    }

    sigma_id
}

// ============================================================
// Section 23: Pi Type Application (Dependent Elimination)
// ============================================================

// Apply a Pi type to an argument: given (x : A) -> B and arg : A,
// compute B[x := arg]. This is the key dependent elimination rule.
fn dep_apply_pi(ctx: &! DepContext, pi_term: i64, arg: i64) -> i64 with Mut, Div, Panic {
    if pi_term < 0 { return DEP_INVALID }
    if pi_term >= ctx.term_count { return DEP_INVALID }

    let k = ctx.terms[pi_term as usize].kind
    if dep_term_kind_is_pi(k) == false {
        return DEP_INVALID
    }

    let param = ctx.terms[pi_term as usize].var_id
    let body_type = ctx.terms[pi_term as usize].right
    dep_substitute(ctx, body_type, param, arg)
}

// ============================================================
// Section 24: Sigma Pair Construction and Projection
// ============================================================

// Build a dependent pair: given (x : A, B(x)), construct the pair
// holding (fst_val : A, snd_val : B[x := fst_val]).
fn dep_make_pair(ctx: &! DepContext, sigma_term: i64, fst_val: i64, snd_val: i64) -> i64 with Mut, Div, Panic {
    if sigma_term < 0 { return DEP_INVALID }
    if sigma_term >= ctx.term_count { return DEP_INVALID }

    // We reuse the Sigma kind but store fst_val/snd_val in left/right
    // This is a value-level pair, distinct from the type-level Sigma
    dep_alloc_term_full(ctx, DepTermKind::TermSigma, 0, fst_val, snd_val, DEP_INVALID, DEP_INVALID)
}

// ============================================================
// Section 25: Type Checking Helpers
// ============================================================

// Check whether term has the expected type (by unification after normalization).
fn dep_check_type(ctx: &! DepContext, term: i64, expected: i64) -> bool with Mut, Div, Panic {
    let nt = dep_normalize(ctx, term)
    let ne = dep_normalize(ctx, expected)
    let r = dep_unify(ctx, nt, ne)
    match r {
        DepUnifyResult::UnifyOk => true,
        _ => false,
    }
}

// Infer the type of a term (simplified: only handles literals and Type).
fn dep_infer_type(ctx: &! DepContext, term: i64) -> i64 with Mut, Div, Panic {
    if term < 0 { return DEP_INVALID }
    if term >= ctx.term_count { return DEP_INVALID }

    let k = ctx.terms[term as usize].kind

    if dep_term_kind_is_int_lit(k) {
        return dep_term_type(ctx)
    }

    if dep_term_kind_is_bool_lit(k) {
        return dep_term_type(ctx)
    }

    if dep_term_kind_is_type(k) {
        return dep_term_type(ctx)
    }

    if dep_term_kind_is_var(k) {
        let vid = ctx.terms[term as usize].var_id
        return dep_lookup_var(ctx, vid)
    }

    if dep_term_kind_is_lam(k) {
        // Lambda needs annotation; return invalid for now
        return DEP_INVALID
    }

    if dep_term_kind_is_pi(k) {
        return dep_term_type(ctx)
    }

    if dep_term_kind_is_sigma(k) {
        return dep_term_type(ctx)
    }

    DEP_INVALID
}

// ============================================================
// Section 26: Context Reset / Snapshot
// ============================================================

// Snapshot the current state of the context for later rollback.
// Returns a tuple-like set of counts packed into a single i64.
// For simplicity, we just track term_count since that is the main arena.
fn dep_snapshot_term_count(ctx: &DepContext) -> i64 {
    ctx.term_count
}

fn dep_snapshot_subst_count(ctx: &DepContext) -> i64 {
    ctx.subst_count
}

fn dep_snapshot_constraint_count(ctx: &DepContext) -> i64 {
    ctx.constraint_count
}

fn dep_snapshot_var_count(ctx: &DepContext) -> i64 {
    ctx.var_count
}

// Rollback term arena to a snapshot
fn dep_rollback_terms(ctx: &! DepContext, snapshot: i64) with Mut {
    if snapshot >= 0 {
        if snapshot <= ctx.term_count {
            ctx.term_count = snapshot
        }
    }
}

// Rollback substitutions to a snapshot
fn dep_rollback_subst(ctx: &! DepContext, snapshot: i64) with Mut {
    if snapshot >= 0 {
        if snapshot <= ctx.subst_count {
            ctx.subst_count = snapshot
        }
    }
}

// ============================================================
// Section 27: Utility — Term Size
// ============================================================

// Count the number of nodes in a term (iterative worklist).
fn dep_term_size(ctx: &DepContext, term: i64) -> i64 with Mut, Div, Panic {
    var worklist: [i64; 256] = [0; 256]
    var wl_count: i64 = 0
    var size: i64 = 0

    if term >= 0 {
        worklist[0 as usize] = term
        wl_count = 1
    }

    while wl_count > 0 {
        wl_count = wl_count - 1
        let current = worklist[wl_count as usize]

        if current < 0 { continue }
        if current >= ctx.term_count { continue }

        size = size + 1

        let t_left = ctx.terms[current as usize].left
        let t_right = ctx.terms[current as usize].right
        let t_body = ctx.terms[current as usize].body

        if t_left >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_left
                wl_count = wl_count + 1
            }
        }
        if t_right >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_right
                wl_count = wl_count + 1
            }
        }
        if t_body >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_body
                wl_count = wl_count + 1
            }
        }
    }

    size
}

// ============================================================
// Section 28: Utility — Term Depth
// ============================================================

// Compute the maximum depth of a term tree. Iterative with explicit stack.
fn dep_term_depth(ctx: &DepContext, term: i64) -> i64 with Mut, Div, Panic {
    // Stack entries: (term_id, depth)
    var stack_terms: [i64; 256] = [0; 256]
    var stack_depths: [i64; 256] = [0; 256]
    var sp: i64 = 0
    var max_depth: i64 = 0

    if term >= 0 {
        stack_terms[0 as usize] = term
        stack_depths[0 as usize] = 1
        sp = 1
    }

    while sp > 0 {
        sp = sp - 1
        let current = stack_terms[sp as usize]
        let depth = stack_depths[sp as usize]

        if current < 0 { continue }
        if current >= ctx.term_count { continue }

        if depth > max_depth {
            max_depth = depth
        }

        let t_left = ctx.terms[current as usize].left
        let t_right = ctx.terms[current as usize].right
        let t_body = ctx.terms[current as usize].body

        if t_left >= 0 {
            if sp < 256 {
                stack_terms[sp as usize] = t_left
                stack_depths[sp as usize] = depth + 1
                sp = sp + 1
            }
        }
        if t_right >= 0 {
            if sp < 256 {
                stack_terms[sp as usize] = t_right
                stack_depths[sp as usize] = depth + 1
                sp = sp + 1
            }
        }
        if t_body >= 0 {
            if sp < 256 {
                stack_terms[sp as usize] = t_body
                stack_depths[sp as usize] = depth + 1
                sp = sp + 1
            }
        }
    }

    max_depth
}

// ============================================================
// Section 29: Utility — Free Variables
// ============================================================

// Count free variables in a term. Uses worklist approach.
fn dep_count_free_vars(ctx: &! DepContext, term: i64) -> i64 with Mut, Div, Panic {
    var worklist: [i64; 256] = [0; 256]
    var wl_count: i64 = 0
    var bound_vars: [i64; 256] = [0; 256]
    var bound_count: i64 = 0
    var free_count: i64 = 0

    if term >= 0 {
        worklist[0 as usize] = term
        wl_count = 1
    }

    while wl_count > 0 {
        wl_count = wl_count - 1
        let current = worklist[wl_count as usize]

        if current < 0 { continue }
        if current >= ctx.term_count { continue }

        let k = ctx.terms[current as usize].kind

        if dep_term_kind_is_var(k) {
            let vid = ctx.terms[current as usize].var_id
            // Check if vid is in bound_vars
            var is_bound = false
            var bi: i64 = 0
            while bi < bound_count {
                if bound_vars[bi as usize] == vid {
                    is_bound = true
                }
                bi = bi + 1
            }
            if is_bound == false {
                free_count = free_count + 1
            }
            continue
        }

        // For binders, record the bound variable
        if dep_term_kind_is_lam(k) {
            if bound_count < 256 {
                bound_vars[bound_count as usize] = ctx.terms[current as usize].var_id
                bound_count = bound_count + 1
            }
        }
        if dep_term_kind_is_pi(k) {
            if bound_count < 256 {
                bound_vars[bound_count as usize] = ctx.terms[current as usize].var_id
                bound_count = bound_count + 1
            }
        }
        if dep_term_kind_is_sigma(k) {
            if bound_count < 256 {
                bound_vars[bound_count as usize] = ctx.terms[current as usize].var_id
                bound_count = bound_count + 1
            }
        }

        // Push children
        let t_left = ctx.terms[current as usize].left
        let t_right = ctx.terms[current as usize].right
        let t_body = ctx.terms[current as usize].body

        if t_left >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_left
                wl_count = wl_count + 1
            }
        }
        if t_right >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_right
                wl_count = wl_count + 1
            }
        }
        if t_body >= 0 {
            if wl_count < 256 {
                worklist[wl_count as usize] = t_body
                wl_count = wl_count + 1
            }
        }
    }

    free_count
}

// ============================================================
// Section 30: Dependent Pattern Matching Support
// ============================================================

// Refine a Pi type by unifying its parameter type with a known value,
// then substituting into the body. Used in dependent pattern matching
// where matching a constructor reveals type information.
fn dep_refine_pi(ctx: &! DepContext, pi_term: i64, known_val: i64) -> i64 with Mut, Div, Panic {
    if pi_term < 0 { return DEP_INVALID }
    if pi_term >= ctx.term_count { return DEP_INVALID }

    let k = ctx.terms[pi_term as usize].kind
    if dep_term_kind_is_pi(k) == false {
        return DEP_INVALID
    }

    let param = ctx.terms[pi_term as usize].var_id
    let param_type = ctx.terms[pi_term as usize].left
    let body_type = ctx.terms[pi_term as usize].right

    // Unify param_type with the type of known_val
    let val_type = dep_infer_type(ctx, known_val)
    if val_type != DEP_INVALID {
        let r = dep_unify(ctx, param_type, val_type)
        match r {
            DepUnifyResult::UnifyFail => { return DEP_INVALID },
            _ => {},
        }
    }

    // Substitute param -> known_val in body_type
    dep_substitute(ctx, body_type, param, known_val)
}

// ============================================================
// Section 31: Well-Formedness Checks
// ============================================================

// Check if a Pi type is well-formed: param type and body type must be valid.
fn dep_pi_well_formed(ctx: &! DepContext, pi_term: i64) -> bool with Mut, Div, Panic {
    if pi_term < 0 { return false }
    if pi_term >= ctx.term_count { return false }

    let k = ctx.terms[pi_term as usize].kind
    if dep_term_kind_is_pi(k) == false { return false }

    let param_type = ctx.terms[pi_term as usize].left
    let body_type = ctx.terms[pi_term as usize].right

    if dep_term_valid(ctx, param_type) == false { return false }
    if dep_term_valid(ctx, body_type) == false { return false }

    true
}

// Check if a Sigma type is well-formed.
fn dep_sigma_well_formed(ctx: &! DepContext, sigma_term: i64) -> bool with Mut, Div, Panic {
    if sigma_term < 0 { return false }
    if sigma_term >= ctx.term_count { return false }

    let k = ctx.terms[sigma_term as usize].kind
    if dep_term_kind_is_sigma(k) == false { return false }

    let fst_type = ctx.terms[sigma_term as usize].left
    let snd_type = ctx.terms[sigma_term as usize].right

    if dep_term_valid(ctx, fst_type) == false { return false }
    if dep_term_valid(ctx, snd_type) == false { return false }

    true
}

// ============================================================
// Section 32: Constraint Kind Tag (for testing)
// ============================================================

fn dep_constraint_kind_tag(k: i64) -> i64 {
    match k {
        DEP_CONSTRAINT_KIND_EQUAL => 0,
        DEP_CONSTRAINT_KIND_LESS_THAN => 1,
        DEP_CONSTRAINT_KIND_LESS_EQ => 2,
        DEP_CONSTRAINT_KIND_GREATER_THAN => 3,
        DEP_CONSTRAINT_KIND_GREATER_EQ => 4,
        DEP_CONSTRAINT_KIND_NON_ZERO => 5,
        DEP_CONSTRAINT_KIND_POSITIVE => 6,
        _ => DEP_INVALID,
    }
}

// ============================================================
// Section 33: Unify Result Tag (for testing)
// ============================================================

fn dep_unify_result_is_ok(r: DepUnifyResult) -> bool {
    match r {
        DepUnifyResult::UnifyOk => true,
        _ => false,
    }
}

fn dep_unify_result_is_fail(r: DepUnifyResult) -> bool {
    match r {
        DepUnifyResult::UnifyFail => true,
        _ => false,
    }
}

fn dep_unify_result_is_stuck(r: DepUnifyResult) -> bool {
    match r {
        DepUnifyResult::UnifyStuck => true,
        _ => false,
    }
}

