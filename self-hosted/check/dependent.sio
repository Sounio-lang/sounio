// ============================================================
// Test Category 8: Integration (6 tests)
// ============================================================

fn test_dep_elaborate_normalize_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Elaborate a Pi type, then apply it, then normalize
    // Pi(n : Type, n + 1) applied to 10 -> 11
    let ty = dep_term_type(ctx)
    let n = dep_term_var(ctx, 1)
    let one = dep_term_int(ctx, 1)
    let body = dep_term_add(ctx, n, one)
    let pi = dep_elaborate_pi(ctx, 1, ty, body)
    let ten = dep_term_int(ctx, 10)
    let applied = dep_apply_pi(ctx, pi, ten)
    let normed = dep_normalize(ctx, applied)
    dep_term_to_i64(ctx, normed) == 11
}
fn test_dep_elaborate_normalize() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_elaborate_normalize_inner(&! ctx)
}

fn test_dep_unify_constraint_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Unify (x) with (3 + 4), then check constraint that result == 7
    let x = dep_term_var(ctx, 1)
    let three = dep_term_int(ctx, 3)
    let four = dep_term_int(ctx, 4)
    let sum = dep_term_add(ctx, three, four)
    let r = dep_unify(ctx, x, sum)
    if dep_unify_result_is_ok(r) == false { return false }
    // Now apply substitution to x
    let resolved = dep_apply_subst(ctx, x)
    let normed = dep_normalize(ctx, resolved)
    // Check that the result is 7
    let seven = dep_term_int(ctx, 7)
    dep_add_constraint(ctx, DEP_CONSTRAINT_KIND_EQUAL, normed, seven, 1)
    dep_check_constraints(ctx)
}
fn test_dep_unify_constraint() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_constraint_inner(&! ctx)
}

fn test_dep_full_pipeline_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Build: (\f. \x. f(x))((\n. n * 2))(5) -> 10
    // Inner function: \n. n * 2
    let n = dep_term_var(ctx, 1)
    let two = dep_term_int(ctx, 2)
    let body_inner = dep_term_mul(ctx, n, two)
    let double = dep_term_lam(ctx, 1, body_inner)

    // Outer function: \f. \x. f(x)
    let f = dep_term_var(ctx, 2)
    let x = dep_term_var(ctx, 3)
    let app_fx = dep_term_app(ctx, f, x)
    let lam_x = dep_term_lam(ctx, 3, app_fx)
    let apply_fn = dep_term_lam(ctx, 2, lam_x)

    // apply_fn(double)
    let step1 = dep_term_app(ctx, apply_fn, double)
    // (apply_fn(double))(5)
    let five = dep_term_int(ctx, 5)
    let step2 = dep_term_app(ctx, step1, five)

    let normed = dep_normalize(ctx, step2)
    dep_term_to_i64(ctx, normed) == 10
}
fn test_dep_full_pipeline() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_full_pipeline_inner(&! ctx)
}

fn test_dep_occurs_check_positive_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // x + 1 contains x
    let x = dep_term_var(ctx, 1)
    let one = dep_term_int(ctx, 1)
    let sum = dep_term_add(ctx, x, one)
    dep_occurs_check(ctx, 1, sum)
}
fn test_dep_occurs_check_positive() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_occurs_check_positive_inner(&! ctx)
}

fn test_dep_occurs_check_negative_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // y + 1 does not contain x
    let y = dep_term_var(ctx, 2)
    let one = dep_term_int(ctx, 1)
    let sum = dep_term_add(ctx, y, one)
    dep_occurs_check(ctx, 1, sum) == false
}
fn test_dep_occurs_check_negative() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_occurs_check_negative_inner(&! ctx)
}

fn test_dep_term_size_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Term: (3 + 5) has 3 nodes
    let a = dep_term_int(ctx, 3)
    let b = dep_term_int(ctx, 5)
    let sum = dep_term_add(ctx, a, b)
    let sz = dep_term_size(ctx, sum)
    sz == 3
}
fn test_dep_term_size() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_size_inner(&! ctx)
}

// ============================================================
// Test Runner — 70 tests
// ============================================================

fn dep_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // --- Term construction (10 tests) ---
    if test_dep_term_int() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_int_negative() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_bool() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_var() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_app() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_lam() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_type() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_if() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Substitution (10 tests) ---
    if test_dep_subst_var_match() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_var_no_match() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_int_noop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_in_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_in_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_nested() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_lam_shadow() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_lam_no_shadow() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_pi_shadow() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_subst_if() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Normalization (12 tests) ---
    if test_dep_norm_int() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_sub() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_div() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_div_by_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_mod() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_beta() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_if_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_if_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_let() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_norm_nested_arith() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Unification (10 tests) ---
    if test_dep_unify_same_int() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_diff_int() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_var_binds() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_var_right() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_same_bool() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_diff_kind() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_add_terms() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_occurs_fail() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_type_type() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_normalized() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Pi types (8 tests) ---
    if test_dep_pi_construct() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_elaborate() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_apply() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_subst_body() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_well_formed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_not_well_formed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_unify() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_pi_is_value() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Sigma types (6 tests) ---
    if test_dep_sigma_construct() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_sigma_elaborate() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_sigma_well_formed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_sigma_not_well_formed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_sigma_fst() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_sigma_snd() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Constraints (8 tests) ---
    if test_dep_constraint_equal_ok() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_equal_fail() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_less_than() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_less_than_fail() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_non_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_non_zero_fail() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_positive() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_constraint_greater_eq() { passed = passed + 1 } else { failed = failed + 1 }

    // --- Integration (6 tests) ---
    if test_dep_elaborate_normalize() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_unify_constraint() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_full_pipeline() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_occurs_check_positive() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_occurs_check_negative() { passed = passed + 1 } else { failed = failed + 1 }
    if test_dep_term_size() { passed = passed + 1 } else { failed = failed + 1 }

    if failed > 0 {
        return 0 - failed
    }
    passed
}
