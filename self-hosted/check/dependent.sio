    let sig = dep_term_sigma(ctx, 1, ty, body)
    if sig < 0 { return false }
    let k = dep_get_kind(ctx, sig)
    if dep_term_kind_is_sigma(k) == false { return false }
    if dep_get_var_id(ctx, sig) != 1 { return false }
    if dep_get_left(ctx, sig) != ty { return false }
    dep_get_right(ctx, sig) == body
}
