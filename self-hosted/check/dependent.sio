}

fn test_dep_unify_diff_int_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let a = dep_term_int(ctx, 42)
    let b = dep_term_int(ctx, 43)
    let r = dep_unify(ctx, a, b)
    dep_unify_result_is_fail(r)
}
