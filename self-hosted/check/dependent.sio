fn test_dep_norm_div_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // 20 / 4 normalizes to 5
    let a = dep_term_int(ctx, 20)
    let b = dep_term_int(ctx, 4)
    let quot = dep_term_div(ctx, a, b)
    let n = dep_normalize(ctx, quot)
    dep_term_to_i64(ctx, n) == 5
}
fn test_dep_norm_div() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_norm_div_inner(&! ctx)
}

fn test_dep_norm_div_by_zero_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // 10 / 0 stays stuck (no reduction)
    let a = dep_term_int(ctx, 10)
    let b = dep_term_int(ctx, 0)
    let quot = dep_term_div(ctx, a, b)
    let n = dep_normalize(ctx, quot)
    // Should be stuck: the result is the original div term
    let k = dep_get_kind(ctx, n)
    dep_term_kind_is_div(k)
}
fn test_dep_norm_div_by_zero() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_norm_div_by_zero_inner(&! ctx)
}

