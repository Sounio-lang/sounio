fn test_dep_unify_var_binds_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Unifying x with 5 should succeed and record substitution
    let x = dep_term_var(ctx, 1)
    let five = dep_term_int(ctx, 5)
    let old_subst = ctx.subst_count
    let r = dep_unify(ctx, x, five)
    if dep_unify_result_is_ok(r) == false { return false }
    // Should have added one substitution
    ctx.subst_count == old_subst + 1
}
fn test_dep_unify_var_binds() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_var_binds_inner(&! ctx)
}

