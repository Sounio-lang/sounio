// Dependent type elaboration for the self-hosted type checker
//
// Implements dependent type checking with Pi types (dependent function types),
// Sigma types (dependent pair types), value-indexed types, term-level
// normalization, capture-avoiding substitution, and first-order unification.
//
// Architecture:
//   DepTerm         — term representation with kind tag, value, children
//   DepConstraint   — type-level constraint (equality, ordering, etc.)
//   DepSubstitution — pending var -> term substitution
//   DepContext      — flat-array arena holding all dependent-type state
//
// Algorithm:
//   1. Build terms via dep_term_* constructors (all return arena IDs)
//   2. Elaborate Pi/Sigma types by allocating structured terms
//   3. Normalize terms via beta-reduction with fuel-limited evaluation
//   4. Unify terms structurally, recording substitutions
//   5. Check constraints against normalized term values
//
// Uses flat-array arena pattern (no recursive types, no heap allocation)
// consistent with the self-hosted checker's design.

// ============================================================
// Section 1: Constants
// ============================================================

let DEP_MAX_TERMS: i64 = 4096
let DEP_MAX_CONSTRAINTS: i64 = 1024
let DEP_MAX_SUBST: i64 = 512
let DEP_MAX_VARS: i64 = 256
let DEP_INVALID: i64 = 0 - 1
let DEP_DEFAULT_FUEL: i64 = 1000
let DEP_CONSTRAINT_KIND_EQUAL: i64 = 0
let DEP_CONSTRAINT_KIND_LESS_THAN: i64 = 1
let DEP_CONSTRAINT_KIND_LESS_EQ: i64 = 2
let DEP_CONSTRAINT_KIND_GREATER_THAN: i64 = 3
let DEP_CONSTRAINT_KIND_GREATER_EQ: i64 = 4
let DEP_CONSTRAINT_KIND_NON_ZERO: i64 = 5
let DEP_CONSTRAINT_KIND_POSITIVE: i64 = 6

// ============================================================
// Section 2: Enums
// ============================================================

enum DepTermKind {
    TermVar,
    TermIntLit,
    TermBoolLit,
    TermAdd,
    TermSub,
    TermMul,
    TermDiv,
    TermMod,
    TermNeg,
    TermEq,
    TermLt,
    TermLe,
    TermGt,
    TermGe,
    TermAnd,
    TermOr,
    TermNot,
    TermApp,
    TermLam,
    TermPi,
    TermSigma,
    TermFst,
    TermSnd,
    TermIf,
    TermLet,
    TermType,
    TermBottom,
}

enum DepNormResult {
    NormOk,
    NormStuck,
    NormError,
}

enum DepUnifyResult {
    UnifyOk,
    UnifyFail,
    UnifyStuck,
}

// ============================================================
// Section 3: Structs
// ============================================================

// A single term node in the arena. Fields serve double duty depending on kind:
//   TermVar:     var_id = variable identifier
//   TermIntLit:  val = integer value
//   TermBoolLit: val = 0 or 1
//   TermAdd/Sub/Mul/Div/Mod/Eq/Lt/Le/Gt/Ge/And/Or: left, right = operand IDs
//   TermNeg/Not: left = operand ID
//   TermApp:     left = function term, right = argument term
//   TermLam:     var_id = parameter, body = body term
//   TermPi:      var_id = parameter, left = param type, right = body type
//   TermSigma:   var_id = fst name, left = fst type, right = snd type
//   TermFst/Snd: left = pair term
//   TermIf:      left = condition, right = then branch, body = else branch
//   TermLet:     var_id = bound variable, left = bound value, body = body term
//   TermType:    (no additional fields)
//   TermBottom:  (no additional fields)
pub struct DepTerm {
    kind: DepTermKind,
    val: i64,
    left: i64,
    right: i64,
    var_id: i64,
    body: i64,
}

// Pi type: (param_name : param_type) -> body_type
pub struct DepPiType {
    param_name: i64,
    param_type: i64,
    body_type: i64,
    is_implicit: bool,
}

// Sigma type: (fst_name : fst_type, snd_type)
pub struct DepSigmaType {
    fst_name: i64,
    fst_type: i64,
    snd_type: i64,
}

// A pending substitution: replace var_id with replacement term
pub struct DepSubstitution {
    var_id: i64,
    replacement: i64,
}

// A constraint on term values
pub struct DepConstraint {
    kind: i64,
    lhs: i64,
    rhs: i64,
    span_line: i64,
}

// The main context: flat arena of all dependent-type state
pub struct DepContext {
    terms: [DepTerm; 4096],
    term_count: i64,
    constraints: [DepConstraint; 1024],
    constraint_count: i64,
    subst: [DepSubstitution; 512],
    subst_count: i64,
    var_names: [i64; 256],
    var_types: [i64; 256],
    var_count: i64,
    errors: [i64; 256],
    error_count: i64,
    norm_fuel: i64,
    next_var: i64,
}

// ============================================================
// Section 4: Empty / Default Constructors
// ============================================================

fn dep_empty_term() -> DepTerm {
    DepTerm {
        kind: DepTermKind::TermBottom,
        val: 0,
        left: DEP_INVALID,
        right: DEP_INVALID,
        var_id: DEP_INVALID,
        body: DEP_INVALID,
    }
}

fn dep_empty_constraint() -> DepConstraint {
    DepConstraint {
        kind: DEP_CONSTRAINT_KIND_EQUAL,
        lhs: DEP_INVALID,
        rhs: DEP_INVALID,
        span_line: 0,
    }
}

fn dep_empty_substitution() -> DepSubstitution {
    DepSubstitution {
        var_id: DEP_INVALID,
        replacement: DEP_INVALID,
    }
}

fn dep_empty_pi() -> DepPiType {
    DepPiType {
        param_name: DEP_INVALID,
        param_type: DEP_INVALID,
        body_type: DEP_INVALID,
        is_implicit: false,
    }
}

fn dep_empty_sigma() -> DepSigmaType {
    DepSigmaType {
        fst_name: DEP_INVALID,
        fst_type: DEP_INVALID,
        snd_type: DEP_INVALID,
    }
}

// ============================================================
// Section 5: Context Construction
// ============================================================

fn dep_context_new() -> DepContext {
    DepContext {
        terms: [dep_empty_term(); 4096],
        term_count: 0,
        constraints: [dep_empty_constraint(); 1024],
        constraint_count: 0,
        subst: [dep_empty_substitution(); 512],
        subst_count: 0,
        var_names: [0; 256],
        var_types: [0; 256],
        var_count: 0,
        errors: [0; 256],
        error_count: 0,
        norm_fuel: DEP_DEFAULT_FUEL,
        next_var: 10000,
    }
}

// ============================================================
// Section 6: Term Kind Queries (helpers, must precede callers)
// ============================================================

fn dep_term_kind_is_var(k: DepTermKind) -> bool {
    match k {
        DepTermKind::TermVar => true,
        _ => false,
    }
}

fn dep_term_kind_is_int_lit(k: DepTermKind) -> bool {
    match k {
        DepTermKind::TermIntLit => true,
        _ => false,
    }
}

fn dep_term_kind_is_bool_lit(k: DepTermKind) -> bool {
