}

fn test_dep_subst_in_add_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (x + 3)[x := 10] normalizes to 13
    let x = dep_term_var(ctx, 1)
    let three = dep_term_int(ctx, 3)
    let sum = dep_term_add(ctx, x, three)
    let ten = dep_term_int(ctx, 10)
    let substituted = dep_substitute(ctx, sum, 1, ten)
    let normed = dep_normalize(ctx, substituted)
    dep_term_to_i64(ctx, normed) == 13
}
fn test_dep_subst_in_add() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_in_add_inner(&! ctx)
}

fn test_dep_subst_in_mul_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (x * 4)[x := 3] normalizes to 12
    let x = dep_term_var(ctx, 1)
    let four = dep_term_int(ctx, 4)
    let prod = dep_term_mul(ctx, x, four)
    let three = dep_term_int(ctx, 3)
    let substituted = dep_substitute(ctx, prod, 1, three)
    let normed = dep_normalize(ctx, substituted)
    dep_term_to_i64(ctx, normed) == 12
}
fn test_dep_subst_in_mul() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_in_mul_inner(&! ctx)
}

fn test_dep_subst_nested_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // ((x + x) * 2)[x := 5] normalizes to 20
    let x = dep_term_var(ctx, 1)
    let sum = dep_term_add(ctx, x, x)
    let two = dep_term_int(ctx, 2)
    let prod = dep_term_mul(ctx, sum, two)
    let five = dep_term_int(ctx, 5)
    let substituted = dep_substitute(ctx, prod, 1, five)
    let normed = dep_normalize(ctx, substituted)
    dep_term_to_i64(ctx, normed) == 20
}
fn test_dep_subst_nested() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_nested_inner(&! ctx)
}

fn test_dep_subst_lam_shadow_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (\x. x)[x := 5] should NOT substitute (binder shadows)
    let body_var = dep_term_var(ctx, 1)
    let lam = dep_term_lam(ctx, 1, body_var)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, lam, 1, five)
    // The lambda should be unchanged
    result == lam
}
fn test_dep_subst_lam_shadow() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_lam_shadow_inner(&! ctx)
}

fn test_dep_subst_lam_no_shadow_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (\y. x)[x := 5] should substitute in body
    let x = dep_term_var(ctx, 1)
    let lam = dep_term_lam(ctx, 2, x)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, lam, 1, five)
    // Result is \y. 5 — body should be five
    let new_body = dep_get_body(ctx, result)
    dep_term_to_i64(ctx, new_body) == 5
}
fn test_dep_subst_lam_no_shadow() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_lam_no_shadow_inner(&! ctx)
}

fn test_dep_subst_pi_shadow_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Pi(x : Int, x)[x := 5] — body should NOT be substituted
    let int_ty = dep_term_type(ctx)
    let body_var = dep_term_var(ctx, 1)
    let pi = dep_term_pi(ctx, 1, int_ty, body_var)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, pi, 1, five)
    // Pi param type might be substituted, but body is shadowed
    let new_body = dep_get_right(ctx, result)
    // Body should still be a variable reference to 1
    dep_get_var_id(ctx, new_body) == 1
}
fn test_dep_subst_pi_shadow() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_pi_shadow_inner(&! ctx)
}

fn test_dep_subst_if_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // if x then 1 else 2, [x := true] normalizes to 1
    let x = dep_term_var(ctx, 1)
    let one = dep_term_int(ctx, 1)
    let two = dep_term_int(ctx, 2)
    let ite = dep_term_if(ctx, x, one, two)
    let t = dep_term_bool(ctx, 1)
    let substituted = dep_substitute(ctx, ite, 1, t)
    let normed = dep_normalize(ctx, substituted)
    dep_term_to_i64(ctx, normed) == 1
}
fn test_dep_subst_if() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_if_inner(&! ctx)
}

