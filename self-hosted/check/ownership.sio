// Test 71: Full function check — all copy variables, passes
fn own_test_71_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let a = own_declare_var(ctx, OwnTypeKind::TyCopy, 1)
    let b = own_declare_var(ctx, OwnTypeKind::TyCopy, 2)
    let c = own_declare_var(ctx, OwnTypeKind::TyCopy, 3)
    let ok1 = own_check_use(ctx, a, 5)
    let ok2 = own_check_use(ctx, b, 6)
    let ok3 = own_check_use(ctx, c, 7)
    let fok = own_check_function(ctx)
    ok1 && ok2 && ok3 && fok
}

fn own_test_71() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_71_inner(&! ctx), 71)
}

// Test 72: Full function check — linear consumed, affine unused, passes
fn own_test_72_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let lin = own_declare_var(ctx, OwnTypeKind::TyLinear, 1)
    let aff = own_declare_var(ctx, OwnTypeKind::TyAffine, 2)
    let m = own_transfer(ctx, lin, 10)
    // aff is not consumed, which is fine for affine
    let fok = own_check_function(ctx)
    m && fok
}

fn own_test_72() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_72_inner(&! ctx), 72)
}

// Test 73: Full function check — linear NOT consumed, fails
fn own_test_73_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let lin = own_declare_var(ctx, OwnTypeKind::TyLinear, 1)
    // Do not consume lin
    let fok = own_check_function(ctx)
    fok == false
    && own_count_errors_of_kind(ctx, OwnErrorKind::ErrMissingDrop) >= 1
}

fn own_test_73() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_73_inner(&! ctx), 73)
}

// Test 74: Full pipeline — declare, scope, borrow, release, move, drop check
fn own_test_74_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    // Declare two variables at the top scope
    let outer_lin = own_declare_var(ctx, OwnTypeKind::TyLinear, 1)
    let outer_copy = own_declare_var(ctx, OwnTypeKind::TyCopy, 2)

    // Enter a scope
    own_enter_scope(ctx, false)
    let inner_aff = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Borrow the outer copy var
    let bid = own_borrow_shared(ctx, outer_copy, 12)
    let use_ok = own_check_use(ctx, outer_copy, 13)

    // Move the inner affine var
    let m = own_transfer(ctx, inner_aff, 15)

    // Exit inner scope (releases borrow, drops nothing since inner_aff is moved)
    own_exit_scope(ctx)

    // Consume the linear var
    let lm = own_transfer(ctx, outer_lin, 20)

    // Final check
    let fok = own_check_function(ctx)
    use_ok && m && lm && fok
}

fn own_test_74() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_74_inner(&! ctx), 74)
}

// Test 75: Reset and reuse context
fn own_test_75_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    // First use
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)
    let m = own_transfer(ctx, id, 15)
    let c1 = own_var_count(ctx)

    // Reset
    own_reset(ctx)
    let c2 = own_var_count(ctx)
    let e2 = own_error_count(ctx)

    // Second use
    let id2 = own_declare_var(ctx, OwnTypeKind::TyCopy, 1)
    let c3 = own_var_count(ctx)

    m && c1 == 1 && c2 == 0 && e2 == 0 && c3 == 1 && id2 == 0
}

fn own_test_75() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_75_inner(&! ctx), 75)
}

// ============================================================
//                    TEST RUNNER
// ============================================================

fn own_run_tests() -> i64 with IO, Mut, Div, Panic {
    print("=== Ownership checker tests ===\n")
    var fails: i64 = 0

    // Category 1: Basic ownership (12 tests)
    fails = fails + own_test_1()
    fails = fails + own_test_2()
    fails = fails + own_test_3()
    fails = fails + own_test_4()
    fails = fails + own_test_5()
    fails = fails + own_test_6()
    fails = fails + own_test_7()
    fails = fails + own_test_8()
    fails = fails + own_test_9()
    fails = fails + own_test_10()
    fails = fails + own_test_11()
    fails = fails + own_test_12()

    // Category 2: Use-after-move (8 tests)
    fails = fails + own_test_13()
    fails = fails + own_test_14()
    fails = fails + own_test_15()
    fails = fails + own_test_16()
    fails = fails + own_test_17()
    fails = fails + own_test_18()
    fails = fails + own_test_19()
    fails = fails + own_test_20()

    // Category 3: Shared borrows (10 tests)
