fn own_test_63_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var_uninit(ctx, OwnTypeKind::TyCopy, 10)
    let snap1 = own_snapshot_mut(ctx)
