// Ownership checker — move semantics, linear/affine enforcement, borrow
// validation, and automatic drop insertion for the self-hosted compiler.
//
// This module implements a single-pass ownership analysis over a flat arena
// of variable-info records.  Every variable has a state machine:
//
//   Uninit -> Owned -> { Moved | Borrowed | BorrowedMut | Dropped }
//
// The checker enforces:
//   - Use-after-move detection
//   - Double-free prevention
//   - Borrow conflicts (shared+exclusive, double exclusive)
//   - Linear types must be consumed exactly once
//   - Affine types may be consumed at most once
//   - Copy types may be freely duplicated
//   - Scope-based automatic drop insertion
//   - Branch merging (if/else ownership state join)
//
// All data structures are flat arrays (arena pattern) for self-hosted use.
// All function and struct names use the `own_` prefix to avoid namespace
// collisions.

// ============================================================
// Constants
// ============================================================

let OWN_MAX_VARS: i64 = 1024
let OWN_MAX_BORROWS: i64 = 512
let OWN_MAX_DROPS: i64 = 512
let OWN_MAX_SCOPES: i64 = 128
let OWN_MAX_ERRORS: i64 = 256
let OWN_MAX_PATHS: i64 = 2048

// ============================================================
// Enum: OwnState — variable ownership state
// ============================================================

enum OwnState {
    StateUninit,
    StateOwned,
    StateMoved,
    StateBorrowed,
    StateBorrowedMut,
    StatePartiallyMoved,
    StateDropped,
}

// ============================================================
// Enum: OwnBorrowKind — borrow flavour
// ============================================================

enum OwnBorrowKind {
    BorrowShared,
    BorrowExclusive,
}

// ============================================================
// Enum: OwnErrorKind — ownership error classification
// ============================================================

enum OwnErrorKind {
    ErrUseAfterMove,
    ErrDoubleFree,
    ErrMissingDrop,
    ErrBorrowWhileMutBorrowed,
    ErrMutBorrowWhileBorrowed,
    ErrMoveWhileBorrowed,
    ErrUninitUse,
    ErrPartialMove,
}

// ============================================================
// Enum: OwnDropStrategy — how a variable should be dropped
// ============================================================

enum OwnDropStrategy {
    DropAtScopeEnd,
    DropAtLastUse,
    DropManual,
    DropNever,
}

// ============================================================
// Enum: OwnTypeKind — type linearity classification
// ============================================================

enum OwnTypeKind {
    TyLinear,
    TyAffine,
    TyCopy,
    TyDrop,
}

// ============================================================
// Struct: OwnVarInfo — per-variable ownership metadata
// ============================================================

pub struct OwnVarInfo {
    id: i64,
    state: OwnState,
    type_kind: OwnTypeKind,
    borrow_count: i64,
    mut_borrow_count: i64,
    scope_depth: i64,
    defined_at: i64,
    moved_at: i64,
    dropped_at: i64,
}

fn own_empty_var_info() -> OwnVarInfo {
    OwnVarInfo {
        id: 0 - 1,
        state: OwnState::StateUninit,
        type_kind: OwnTypeKind::TyCopy,
        borrow_count: 0,
        mut_borrow_count: 0,
        scope_depth: 0,
        defined_at: 0,
        moved_at: 0 - 1,
        dropped_at: 0 - 1,
    }
}

// ============================================================
// Struct: OwnBorrowInfo — active borrow record
// ============================================================

pub struct OwnBorrowInfo {
    borrow_id: i64,
    var_id: i64,
    kind: OwnBorrowKind,
    scope_depth: i64,
    created_at: i64,
}

fn own_empty_borrow_info() -> OwnBorrowInfo {
    OwnBorrowInfo {
        borrow_id: 0 - 1,
        var_id: 0 - 1,
        kind: OwnBorrowKind::BorrowShared,
        scope_depth: 0,
        created_at: 0,
    }
}

// ============================================================
// Struct: OwnDropPoint — scheduled drop location
// ============================================================

pub struct OwnDropPoint {
    var_id: i64,
    scope_depth: i64,
    line: i64,
    strategy: OwnDropStrategy,
}

fn own_empty_drop_point() -> OwnDropPoint {
    OwnDropPoint {
        var_id: 0 - 1,
        scope_depth: 0,
        line: 0,
        strategy: OwnDropStrategy::DropNever,
    }
}

// ============================================================
// Struct: OwnScope — scope boundary
// ============================================================

pub struct OwnScope {
    depth: i64,
    var_start: i64,
    var_end: i64,
    borrow_start: i64,
    is_loop: bool,
}

fn own_empty_scope() -> OwnScope {
    OwnScope {
        depth: 0,
        var_start: 0,
        var_end: 0,
        borrow_start: 0,
        is_loop: false,
    }
}

// ============================================================
// Struct: OwnError — recorded ownership violation
// ============================================================

pub struct OwnError {
    kind: OwnErrorKind,
    var_id: i64,
    line: i64,
    detail: i64,
}

fn own_empty_error() -> OwnError {
    OwnError {
        kind: OwnErrorKind::ErrUseAfterMove,
        var_id: 0 - 1,
        line: 0,
        detail: 0,
    }
}

// ============================================================
// Struct: OwnContext — the full ownership-checking arena
// ============================================================

pub struct OwnContext {
    vars: [OwnVarInfo; 1024],
    var_count: i64,
    borrows: [OwnBorrowInfo; 512],
    borrow_count: i64,
    drops: [OwnDropPoint; 512],
    drop_count: i64,
    scopes: [OwnScope; 128],
    scope_depth: i64,
    errors: [OwnError; 256],
    error_count: i64,
    paths: [i64; 2048],
    path_count: i64,
}

// ============================================================
// Context constructor
// ============================================================

pub fn own_context_new() -> OwnContext {
    OwnContext {
        vars: [own_empty_var_info(); 1024],
        var_count: 0,
        borrows: [own_empty_borrow_info(); 512],
        borrow_count: 0,
        drops: [own_empty_drop_point(); 512],
        drop_count: 0,
        scopes: [own_empty_scope(); 128],
        scope_depth: 0,
        errors: [own_empty_error(); 256],
        error_count: 0,
        paths: [0; 2048],
        path_count: 0,
    }
}

// ============================================================
// State comparison helpers (must precede callers)
// ============================================================

fn own_state_eq(a: OwnState, b: OwnState) -> bool {
    match a {
        OwnState::StateUninit => match b {
            OwnState::StateUninit => true
            _ => false
        }
        OwnState::StateOwned => match b {
            OwnState::StateOwned => true
            _ => false
        }
        OwnState::StateMoved => match b {
            OwnState::StateMoved => true
            _ => false
        }
        OwnState::StateBorrowed => match b {
            OwnState::StateBorrowed => true
            _ => false
        }
        OwnState::StateBorrowedMut => match b {
            OwnState::StateBorrowedMut => true
            _ => false
        }
        OwnState::StatePartiallyMoved => match b {
            OwnState::StatePartiallyMoved => true
            _ => false
        }
        OwnState::StateDropped => match b {
            OwnState::StateDropped => true
            _ => false
        }
    }
}

fn own_state_is_uninit(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateUninit)
}

fn own_state_is_owned(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateOwned)
}

fn own_state_is_moved(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateMoved)
}

fn own_state_is_borrowed(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateBorrowed)
}

fn own_state_is_borrowed_mut(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateBorrowedMut)
}

fn own_state_is_partially_moved(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StatePartiallyMoved)
}

fn own_state_is_dropped(s: OwnState) -> bool {
    own_state_eq(s, OwnState::StateDropped)
}

// ============================================================
// Type-kind comparison helpers
// ============================================================

fn own_type_kind_eq(a: OwnTypeKind, b: OwnTypeKind) -> bool {
    match a {
        OwnTypeKind::TyLinear => match b {
            OwnTypeKind::TyLinear => true
            _ => false
        }
        OwnTypeKind::TyAffine => match b {
            OwnTypeKind::TyAffine => true
            _ => false
        }
        OwnTypeKind::TyCopy => match b {
            OwnTypeKind::TyCopy => true
            _ => false
        }
        OwnTypeKind::TyDrop => match b {
            OwnTypeKind::TyDrop => true
            _ => false
        }
    }
}

fn own_type_is_linear(k: OwnTypeKind) -> bool {
    own_type_kind_eq(k, OwnTypeKind::TyLinear)
}

fn own_type_is_affine(k: OwnTypeKind) -> bool {
    own_type_kind_eq(k, OwnTypeKind::TyAffine)
}

fn own_type_is_copy(k: OwnTypeKind) -> bool {
    own_type_kind_eq(k, OwnTypeKind::TyCopy)
}

fn own_type_is_drop(k: OwnTypeKind) -> bool {
    own_type_kind_eq(k, OwnTypeKind::TyDrop)
}

// ============================================================
// Borrow-kind comparison helpers
// ============================================================

fn own_borrow_kind_eq(a: OwnBorrowKind, b: OwnBorrowKind) -> bool {
    match a {
        OwnBorrowKind::BorrowShared => match b {
            OwnBorrowKind::BorrowShared => true
            _ => false
        }
        OwnBorrowKind::BorrowExclusive => match b {
            OwnBorrowKind::BorrowExclusive => true
            _ => false
        }
    }
}

fn own_borrow_is_shared(k: OwnBorrowKind) -> bool {
    own_borrow_kind_eq(k, OwnBorrowKind::BorrowShared)
}

fn own_borrow_is_exclusive(k: OwnBorrowKind) -> bool {
    own_borrow_kind_eq(k, OwnBorrowKind::BorrowExclusive)
}

// ============================================================
// Error-kind comparison helper
// ============================================================

fn own_error_kind_eq(a: OwnErrorKind, b: OwnErrorKind) -> bool {
    match a {
        OwnErrorKind::ErrUseAfterMove => match b {
            OwnErrorKind::ErrUseAfterMove => true
            _ => false
        }
        OwnErrorKind::ErrDoubleFree => match b {
            OwnErrorKind::ErrDoubleFree => true
            _ => false
        }
        OwnErrorKind::ErrMissingDrop => match b {
            OwnErrorKind::ErrMissingDrop => true
            _ => false
        }
        OwnErrorKind::ErrBorrowWhileMutBorrowed => match b {
            OwnErrorKind::ErrBorrowWhileMutBorrowed => true
            _ => false
        }
        OwnErrorKind::ErrMutBorrowWhileBorrowed => match b {
            OwnErrorKind::ErrMutBorrowWhileBorrowed => true
            _ => false
        }
        OwnErrorKind::ErrMoveWhileBorrowed => match b {
            OwnErrorKind::ErrMoveWhileBorrowed => true
            _ => false
        }
        OwnErrorKind::ErrUninitUse => match b {
            OwnErrorKind::ErrUninitUse => true
            _ => false
        }
        OwnErrorKind::ErrPartialMove => match b {
            OwnErrorKind::ErrPartialMove => true
            _ => false
        }
    }
}

// ============================================================
// Drop-strategy comparison helper
// ============================================================

fn own_drop_strategy_eq(a: OwnDropStrategy, b: OwnDropStrategy) -> bool {
    match a {
        OwnDropStrategy::DropAtScopeEnd => match b {
            OwnDropStrategy::DropAtScopeEnd => true
            _ => false
        }
        OwnDropStrategy::DropAtLastUse => match b {
            OwnDropStrategy::DropAtLastUse => true
            _ => false
        }
        OwnDropStrategy::DropManual => match b {
            OwnDropStrategy::DropManual => true
            _ => false
        }
        OwnDropStrategy::DropNever => match b {
            OwnDropStrategy::DropNever => true
            _ => false
        }
    }
}

// ============================================================
// Bounds-checking helpers
// ============================================================

fn own_var_in_bounds(ctx: &OwnContext, var_id: i64) -> bool {
    if var_id < 0 { return false }
    if var_id >= ctx.var_count { return false }
    true
}

fn own_borrow_in_bounds(ctx: &OwnContext, borrow_id: i64) -> bool {
    if borrow_id < 0 { return false }
    if borrow_id >= ctx.borrow_count { return false }
    true
}

// ============================================================
// Error recording
// ============================================================

fn own_add_error(ctx: &! OwnContext, kind: OwnErrorKind, var_id: i64, line: i64) with Mut, Div, Panic {
    if ctx.error_count < OWN_MAX_ERRORS {
        ctx.errors[ctx.error_count as usize] = OwnError {
            kind: kind,
            var_id: var_id,
            line: line,
            detail: 0,
        }
        ctx.error_count = ctx.error_count + 1
    }
}

fn own_add_error_with_detail(ctx: &! OwnContext, kind: OwnErrorKind, var_id: i64, line: i64, detail: i64) with Mut, Div, Panic {
    if ctx.error_count < OWN_MAX_ERRORS {
        ctx.errors[ctx.error_count as usize] = OwnError {
            kind: kind,
            var_id: var_id,
            line: line,
            detail: detail,
        }
        ctx.error_count = ctx.error_count + 1
    }
}

fn own_has_errors(ctx: &OwnContext) -> bool {
    ctx.error_count > 0
}

fn own_error_count(ctx: &OwnContext) -> i64 {
    ctx.error_count
}

fn own_get_error(ctx: &OwnContext, idx: i64) -> OwnError with Div, Panic {
    if idx >= 0 && idx < ctx.error_count {
        return ctx.errors[idx as usize]
    }
    own_empty_error()
}

fn own_last_error_kind(ctx: &OwnContext) -> OwnErrorKind with Div, Panic {
    if ctx.error_count > 0 {
        return ctx.errors[(ctx.error_count - 1) as usize].kind
    }
    OwnErrorKind::ErrUseAfterMove
}

// ============================================================
// Variable declaration and state management
// ============================================================

fn own_declare_var(ctx: &! OwnContext, type_kind: OwnTypeKind, line: i64) -> i64 with Mut, Div, Panic {
    if ctx.var_count >= OWN_MAX_VARS {
        return 0 - 1
    }
    let id = ctx.var_count
    ctx.vars[id as usize] = OwnVarInfo {
        id: id,
        state: OwnState::StateOwned,
        type_kind: type_kind,
        borrow_count: 0,
        mut_borrow_count: 0,
        scope_depth: ctx.scope_depth,
        defined_at: line,
        moved_at: 0 - 1,
        dropped_at: 0 - 1,
    }
    ctx.var_count = ctx.var_count + 1
    id
}

fn own_declare_var_uninit(ctx: &! OwnContext, type_kind: OwnTypeKind, line: i64) -> i64 with Mut, Div, Panic {
    if ctx.var_count >= OWN_MAX_VARS {
        return 0 - 1
    }
    let id = ctx.var_count
    ctx.vars[id as usize] = OwnVarInfo {
        id: id,
        state: OwnState::StateUninit,
        type_kind: type_kind,
        borrow_count: 0,
        mut_borrow_count: 0,
        scope_depth: ctx.scope_depth,
        defined_at: line,
        moved_at: 0 - 1,
        dropped_at: 0 - 1,
    }
    ctx.var_count = ctx.var_count + 1
    id
}

fn own_set_state(ctx: &! OwnContext, var_id: i64, state: OwnState) with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        ctx.vars[var_id as usize].state = state
    }
}

fn own_get_state(ctx: &OwnContext, var_id: i64) -> OwnState with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return ctx.vars[var_id as usize].state
    }
    OwnState::StateUninit
}

fn own_get_type_kind(ctx: &OwnContext, var_id: i64) -> OwnTypeKind with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return ctx.vars[var_id as usize].type_kind
    }
    OwnTypeKind::TyCopy
}

fn own_get_scope_depth(ctx: &OwnContext, var_id: i64) -> i64 with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return ctx.vars[var_id as usize].scope_depth
    }
    0
}

fn own_get_defined_at(ctx: &OwnContext, var_id: i64) -> i64 with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return ctx.vars[var_id as usize].defined_at
    }
    0 - 1
}

fn own_get_moved_at(ctx: &OwnContext, var_id: i64) -> i64 with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return ctx.vars[var_id as usize].moved_at
    }
    0 - 1
}

// ============================================================
// Query helpers — active borrows for a variable
// ============================================================

fn own_active_borrows_for(ctx: &OwnContext, var_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.borrow_count {
        if ctx.borrows[i as usize].var_id == var_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn own_active_mut_borrows_for(ctx: &OwnContext, var_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.borrow_count {
        if ctx.borrows[i as usize].var_id == var_id {
            if own_borrow_is_exclusive(ctx.borrows[i as usize].kind) {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

fn own_active_shared_borrows_for(ctx: &OwnContext, var_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.borrow_count {
        if ctx.borrows[i as usize].var_id == var_id {
            if own_borrow_is_shared(ctx.borrows[i as usize].kind) {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// ============================================================
// Type-kind queries on variables
// ============================================================

fn own_is_linear(ctx: &OwnContext, var_id: i64) -> bool with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return own_type_is_linear(ctx.vars[var_id as usize].type_kind)
    }
    false
}

fn own_is_affine(ctx: &OwnContext, var_id: i64) -> bool with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return own_type_is_affine(ctx.vars[var_id as usize].type_kind)
    }
    false
}

fn own_is_copy(ctx: &OwnContext, var_id: i64) -> bool with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return own_type_is_copy(ctx.vars[var_id as usize].type_kind)
    }
    false
}

fn own_is_drop(ctx: &OwnContext, var_id: i64) -> bool with Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        return own_type_is_drop(ctx.vars[var_id as usize].type_kind)
    }
    false
}

// ============================================================
// Variable use checking — can this variable be read right now?
// ============================================================

fn own_check_use(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let state = ctx.vars[var_id as usize].state

    // Uninit: cannot use
    if own_state_is_uninit(state) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }

    // Moved: cannot use
    if own_state_is_moved(state) {
        own_add_error_with_detail(ctx, OwnErrorKind::ErrUseAfterMove, var_id, line, ctx.vars[var_id as usize].moved_at)
        return false
    }

    // Dropped: cannot use
    if own_state_is_dropped(state) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }

    // Partially moved: cannot use (must reinitialize first)
    if own_state_is_partially_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrPartialMove, var_id, line)
        return false
    }

    // Owned, Borrowed, BorrowedMut: all fine for read access
    true
}

// ============================================================
// Move checking — can this variable be moved right now?
// ============================================================

fn own_check_move(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let state = ctx.vars[var_id as usize].state

    // Copy types are never moved, they are implicitly copied
    if own_is_copy(ctx, var_id) {
        return true
    }

    // Uninit: cannot move
    if own_state_is_uninit(state) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }

    // Already moved
    if own_state_is_moved(state) {
        own_add_error_with_detail(ctx, OwnErrorKind::ErrUseAfterMove, var_id, line, ctx.vars[var_id as usize].moved_at)
        return false
    }

    // Already dropped
    if own_state_is_dropped(state) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }

    // Cannot move while borrowed
    if own_state_is_borrowed(state) {
        own_add_error(ctx, OwnErrorKind::ErrMoveWhileBorrowed, var_id, line)
        return false
    }
    if own_state_is_borrowed_mut(state) {
        own_add_error(ctx, OwnErrorKind::ErrMoveWhileBorrowed, var_id, line)
        return false
    }

    // Partially moved
    if own_state_is_partially_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrPartialMove, var_id, line)
        return false
    }

    true
}

// ============================================================
// Ownership transfer (move)
// ============================================================

fn own_transfer(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }

    // Copy types: no state change, always succeeds
    if own_is_copy(ctx, var_id) {
        return true
    }

    let ok = own_check_move(ctx, var_id, line)
    if ok == false {
        return false
    }

    ctx.vars[var_id as usize].state = OwnState::StateMoved
    ctx.vars[var_id as usize].moved_at = line
    true
}

// ============================================================
// Shared borrow checking and creation
// ============================================================

fn own_check_borrow_shared(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let state = ctx.vars[var_id as usize].state

    // Cannot borrow uninit, moved, or dropped
    if own_state_is_uninit(state) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }
    if own_state_is_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrUseAfterMove, var_id, line)
        return false
    }
    if own_state_is_dropped(state) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }

    // Cannot shared-borrow while exclusively borrowed
    if own_state_is_borrowed_mut(state) {
        own_add_error(ctx, OwnErrorKind::ErrBorrowWhileMutBorrowed, var_id, line)
        return false
    }

    // Partially moved: disallow borrow
    if own_state_is_partially_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrPartialMove, var_id, line)
        return false
    }

    true
}

fn own_borrow_shared(ctx: &! OwnContext, var_id: i64, line: i64) -> i64 with Mut, Div, Panic {
    let ok = own_check_borrow_shared(ctx, var_id, line)
    if ok == false {
        return 0 - 1
    }

    if ctx.borrow_count >= OWN_MAX_BORROWS {
        return 0 - 1
    }

    let bid = ctx.borrow_count
    ctx.borrows[bid as usize] = OwnBorrowInfo {
        borrow_id: bid,
        var_id: var_id,
        kind: OwnBorrowKind::BorrowShared,
        scope_depth: ctx.scope_depth,
        created_at: line,
    }
    ctx.borrow_count = ctx.borrow_count + 1

    // Update variable state
    ctx.vars[var_id as usize].borrow_count = ctx.vars[var_id as usize].borrow_count + 1
    ctx.vars[var_id as usize].state = OwnState::StateBorrowed
    bid
}

// ============================================================
// Exclusive borrow checking and creation
// ============================================================

fn own_check_borrow_exclusive(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let state = ctx.vars[var_id as usize].state

    // Cannot borrow uninit, moved, or dropped
    if own_state_is_uninit(state) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }
    if own_state_is_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrUseAfterMove, var_id, line)
        return false
    }
    if own_state_is_dropped(state) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }

    // Cannot exclusive-borrow while any borrow is active
    if own_state_is_borrowed(state) {
        own_add_error(ctx, OwnErrorKind::ErrMutBorrowWhileBorrowed, var_id, line)
        return false
    }
    if own_state_is_borrowed_mut(state) {
        own_add_error(ctx, OwnErrorKind::ErrBorrowWhileMutBorrowed, var_id, line)
        return false
    }

    // Partially moved: disallow borrow
    if own_state_is_partially_moved(state) {
        own_add_error(ctx, OwnErrorKind::ErrPartialMove, var_id, line)
        return false
    }

    true
}

fn own_borrow_exclusive(ctx: &! OwnContext, var_id: i64, line: i64) -> i64 with Mut, Div, Panic {
    let ok = own_check_borrow_exclusive(ctx, var_id, line)
    if ok == false {
        return 0 - 1
    }

    if ctx.borrow_count >= OWN_MAX_BORROWS {
        return 0 - 1
    }

    let bid = ctx.borrow_count
    ctx.borrows[bid as usize] = OwnBorrowInfo {
        borrow_id: bid,
        var_id: var_id,
        kind: OwnBorrowKind::BorrowExclusive,
        scope_depth: ctx.scope_depth,
        created_at: line,
    }
    ctx.borrow_count = ctx.borrow_count + 1

    // Update variable state
    ctx.vars[var_id as usize].mut_borrow_count = ctx.vars[var_id as usize].mut_borrow_count + 1
    ctx.vars[var_id as usize].state = OwnState::StateBorrowedMut
    bid
}

// ============================================================
// Borrow release
// ============================================================

fn own_release_borrow(ctx: &! OwnContext, borrow_id: i64) with Mut, Div, Panic {
    if own_borrow_in_bounds(ctx, borrow_id) == false {
        return
    }

    let info = ctx.borrows[borrow_id as usize]
    let vid = info.var_id

    if own_var_in_bounds(ctx, vid) == false {
        return
    }

    // Decrement the appropriate borrow counter
    if own_borrow_is_shared(info.kind) {
        if ctx.vars[vid as usize].borrow_count > 0 {
            ctx.vars[vid as usize].borrow_count = ctx.vars[vid as usize].borrow_count - 1
        }
    } else {
        if ctx.vars[vid as usize].mut_borrow_count > 0 {
            ctx.vars[vid as usize].mut_borrow_count = ctx.vars[vid as usize].mut_borrow_count - 1
        }
    }

    // Remove the borrow by shifting remaining borrows down
    var i = borrow_id
    while i < ctx.borrow_count - 1 {
        ctx.borrows[i as usize] = ctx.borrows[(i + 1) as usize]
        // Fix up borrow IDs after shift
        ctx.borrows[i as usize].borrow_id = i
        i = i + 1
    }
    ctx.borrow_count = ctx.borrow_count - 1

    // Restore variable state based on remaining borrows
    if ctx.vars[vid as usize].mut_borrow_count > 0 {
        ctx.vars[vid as usize].state = OwnState::StateBorrowedMut
    } else if ctx.vars[vid as usize].borrow_count > 0 {
        ctx.vars[vid as usize].state = OwnState::StateBorrowed
    } else {
        // No borrows remaining — back to owned (if not moved/dropped)
        let cur = ctx.vars[vid as usize].state
        if own_state_is_borrowed(cur) || own_state_is_borrowed_mut(cur) {
            ctx.vars[vid as usize].state = OwnState::StateOwned
        }
    }
}

// ============================================================
// Release all borrows for a specific variable
// ============================================================

fn own_release_all_borrows_for(ctx: &! OwnContext, var_id: i64) with Mut, Div, Panic {
    // Walk backwards to avoid index shifting issues
    var i = ctx.borrow_count - 1
    while i >= 0 {
        if ctx.borrows[i as usize].var_id == var_id {
            own_release_borrow(ctx, i)
        }
        i = i - 1
    }
}

// ============================================================
// Scope management
// ============================================================

fn own_enter_scope(ctx: &! OwnContext, is_loop: bool) with Mut, Div, Panic {
    if ctx.scope_depth >= OWN_MAX_SCOPES {
        return
    }
    ctx.scopes[ctx.scope_depth as usize] = OwnScope {
        depth: ctx.scope_depth,
        var_start: ctx.var_count,
        var_end: ctx.var_count,
        borrow_start: ctx.borrow_count,
        is_loop: is_loop,
    }
    ctx.scope_depth = ctx.scope_depth + 1
}

fn own_exit_scope(ctx: &! OwnContext) with Mut, Div, Panic {
    if ctx.scope_depth <= 0 {
        return
    }
    let scope_idx = ctx.scope_depth - 1
    // Soft-keyword: Madaros parser rejects `let scope` as binding name.
    let scope_frame = ctx.scopes[scope_idx as usize]

    // Release borrows created in this scope
    var bi = ctx.borrow_count - 1
    while bi >= scope_frame.borrow_start {
        own_release_borrow(ctx, bi)
        bi = bi - 1
    }

    // Insert drops for variables declared in this scope that are still owned
    var vi = scope_frame.var_start
    while vi < ctx.var_count {
        let st = ctx.vars[vi as usize].state
        if own_state_is_owned(st) || own_state_is_borrowed(st) || own_state_is_borrowed_mut(st) {
            // Linear types must be consumed — error if still owned at scope end
            if own_type_is_linear(ctx.vars[vi as usize].type_kind) {
                own_add_error(ctx, OwnErrorKind::ErrMissingDrop, vi, ctx.vars[vi as usize].defined_at)
            }
            // Insert a drop point
            own_insert_drop(ctx, vi, 0 - 1, OwnDropStrategy::DropAtScopeEnd)
            ctx.vars[vi as usize].state = OwnState::StateDropped
        }
        vi = vi + 1
    }

    ctx.scope_depth = ctx.scope_depth - 1
}

fn own_current_scope_depth(ctx: &OwnContext) -> i64 {
    ctx.scope_depth
}

fn own_scope_is_loop(ctx: &OwnContext, depth: i64) -> bool with Div, Panic {
    if depth >= 0 && depth < ctx.scope_depth {
        return ctx.scopes[depth as usize].is_loop
    }
    false
}

// ============================================================
// Drop insertion
// ============================================================

fn own_insert_drop(ctx: &! OwnContext, var_id: i64, line: i64, strategy: OwnDropStrategy) with Mut, Div, Panic {
    if ctx.drop_count >= OWN_MAX_DROPS {
        return
    }
    ctx.drops[ctx.drop_count as usize] = OwnDropPoint {
        var_id: var_id,
        scope_depth: ctx.scope_depth,
        line: line,
        strategy: strategy,
    }
    ctx.drop_count = ctx.drop_count + 1
}

fn own_drop_count(ctx: &OwnContext) -> i64 {
    ctx.drop_count
}

fn own_get_drop(ctx: &OwnContext, idx: i64) -> OwnDropPoint with Div, Panic {
    if idx >= 0 && idx < ctx.drop_count {
        return ctx.drops[idx as usize]
    }
    own_empty_drop_point()
}

// ============================================================
// Compute drops — schedule drop points for all live variables
// that need deterministic destruction
// ============================================================

fn own_compute_drops(ctx: &! OwnContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.var_count {
        let st = ctx.vars[i as usize].state
        let tk = ctx.vars[i as usize].type_kind

        // Copy types never need explicit drops
        if own_type_is_copy(tk) {
            i = i + 1
            // continue — skip to next iteration
        } else if own_state_is_owned(st) {
            // Owned and not consumed — needs a drop
            if own_type_is_linear(tk) {
                // Linear type still alive — this is an error (should have been consumed)
                own_add_error(ctx, OwnErrorKind::ErrMissingDrop, i, ctx.vars[i as usize].defined_at)
            }
            // Schedule drop at scope end for affine/drop types
            own_insert_drop(ctx, i, 0 - 1, OwnDropStrategy::DropAtScopeEnd)
            ctx.vars[i as usize].state = OwnState::StateDropped
            i = i + 1
        } else if own_state_is_borrowed(st) || own_state_is_borrowed_mut(st) {
            // Still borrowed — release borrows first, then schedule drop
            own_release_all_borrows_for(ctx, i)
            own_insert_drop(ctx, i, 0 - 1, OwnDropStrategy::DropAtScopeEnd)
            ctx.vars[i as usize].state = OwnState::StateDropped
            i = i + 1
        } else {
            // Moved, dropped, uninit, or partially moved — no drop needed
            i = i + 1
        }
    }
}

// ============================================================
// Snapshot / restore — for branch merging
// ============================================================

fn own_snapshot(ctx: &OwnContext) -> i64 with Mut, Div, Panic {
    // Store variable states into the paths array
    // Returns the starting index in ctx.paths
    let snap_start = ctx.path_count
    var i: i64 = 0
    while i < ctx.var_count {
        if snap_start + i < OWN_MAX_PATHS {
            // Encode state as integer for storage
            let state = ctx.vars[i as usize].state
            var code: i64 = 0
            if own_state_is_uninit(state) { code = 0 }
            if own_state_is_owned(state) { code = 1 }
            if own_state_is_moved(state) { code = 2 }
            if own_state_is_borrowed(state) { code = 3 }
            if own_state_is_borrowed_mut(state) { code = 4 }
            if own_state_is_partially_moved(state) { code = 5 }
            if own_state_is_dropped(state) { code = 6 }
            // We cannot mutate ctx here since it is &OwnContext,
            // so we just return snap_start — the caller must use
            // own_snapshot_mut instead.
        }
        i = i + 1
    }
    snap_start
}

fn own_snapshot_mut(ctx: &! OwnContext) -> i64 with Mut, Div, Panic {
    let snap_start = ctx.path_count
    var i: i64 = 0
    while i < ctx.var_count {
        let slot = snap_start + i
        if slot < OWN_MAX_PATHS {
            let state = ctx.vars[i as usize].state
            var code: i64 = 0
            if own_state_is_uninit(state) { code = 0 }
            if own_state_is_owned(state) { code = 1 }
            if own_state_is_moved(state) { code = 2 }
            if own_state_is_borrowed(state) { code = 3 }
            if own_state_is_borrowed_mut(state) { code = 4 }
            if own_state_is_partially_moved(state) { code = 5 }
            if own_state_is_dropped(state) { code = 6 }
            ctx.paths[slot as usize] = code
        }
        i = i + 1
    }
    ctx.path_count = snap_start + ctx.var_count
    snap_start
}

fn own_state_from_code(code: i64) -> OwnState {
    if code == 0 { return OwnState::StateUninit }
    if code == 1 { return OwnState::StateOwned }
    if code == 2 { return OwnState::StateMoved }
    if code == 3 { return OwnState::StateBorrowed }
    if code == 4 { return OwnState::StateBorrowedMut }
    if code == 5 { return OwnState::StatePartiallyMoved }
    if code == 6 { return OwnState::StateDropped }
    OwnState::StateUninit
}

fn own_state_to_code(state: OwnState) -> i64 {
    if own_state_is_uninit(state) { return 0 }
    if own_state_is_owned(state) { return 1 }
    if own_state_is_moved(state) { return 2 }
    if own_state_is_borrowed(state) { return 3 }
    if own_state_is_borrowed_mut(state) { return 4 }
    if own_state_is_partially_moved(state) { return 5 }
    if own_state_is_dropped(state) { return 6 }
    0
}

fn own_restore_snapshot(ctx: &! OwnContext, snap: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.var_count {
        let slot = snap + i
        if slot < OWN_MAX_PATHS {
            let code = ctx.paths[slot as usize]
            ctx.vars[i as usize].state = own_state_from_code(code)
        }
        i = i + 1
    }
}

// ============================================================
// Branch merging — join states from two control flow branches
//
// Rules:
//   Owned + Owned   => Owned
//   Moved + Moved   => Moved
//   Owned + Moved   => PartiallyMoved (inconsistent — warning)
//   Dropped + Owned => PartiallyMoved
//   Borrowed + *    => use the non-borrowed side (borrows are scoped)
//   same + same     => same
//   otherwise       => PartiallyMoved
// ============================================================

fn own_merge_state(a: OwnState, b: OwnState) -> OwnState {
    // Same state: keep it
    if own_state_eq(a, b) {
        return a
    }

    // Both uninit: uninit
    if own_state_is_uninit(a) && own_state_is_uninit(b) {
        return OwnState::StateUninit
    }

    // Both moved or both dropped: keep that
    if own_state_is_moved(a) && own_state_is_dropped(b) {
        return OwnState::StateMoved
    }
    if own_state_is_dropped(a) && own_state_is_moved(b) {
        return OwnState::StateMoved
    }

    // Owned in one branch, moved/dropped in other: partially moved
    if own_state_is_owned(a) && own_state_is_moved(b) {
        return OwnState::StatePartiallyMoved
    }
    if own_state_is_moved(a) && own_state_is_owned(b) {
        return OwnState::StatePartiallyMoved
    }
    if own_state_is_owned(a) && own_state_is_dropped(b) {
        return OwnState::StatePartiallyMoved
    }
    if own_state_is_dropped(a) && own_state_is_owned(b) {
        return OwnState::StatePartiallyMoved
    }

    // Borrowed states — prefer non-borrow for merge (borrows are scope-local)
    if own_state_is_borrowed(a) || own_state_is_borrowed_mut(a) {
        return b
    }
    if own_state_is_borrowed(b) || own_state_is_borrowed_mut(b) {
        return a
    }

    // Default: partially moved
    OwnState::StatePartiallyMoved
}

fn own_merge_branches(ctx: &! OwnContext, then_snap: i64, else_snap: i64) -> bool with Mut, Div, Panic {
    var ok = true
    var i: i64 = 0
    while i < ctx.var_count {
        let then_slot = then_snap + i
        let else_slot = else_snap + i
        if then_slot < OWN_MAX_PATHS && else_slot < OWN_MAX_PATHS {
            let then_state = own_state_from_code(ctx.paths[then_slot as usize])
            let else_state = own_state_from_code(ctx.paths[else_slot as usize])
            let merged = own_merge_state(then_state, else_state)

            // If the merged result is partially moved and the original
            // type is linear, this is an error — linear values must be
            // consumed on ALL paths, not just some.
            if own_state_is_partially_moved(merged) {
                if own_type_is_linear(ctx.vars[i as usize].type_kind) {
                    own_add_error(ctx, OwnErrorKind::ErrPartialMove, i, ctx.vars[i as usize].defined_at)
                    ok = false
                }
            }

            ctx.vars[i as usize].state = merged
        }
        i = i + 1
    }
    ok
}

// ============================================================
// Full function check — validate all variables reach a valid
// end state by function exit
// ============================================================

fn own_check_linear_at_end(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    var ok = true
    var i: i64 = 0
    while i < ctx.var_count {
        let tk = ctx.vars[i as usize].type_kind
        let st = ctx.vars[i as usize].state

        if own_type_is_linear(tk) {
            // Linear vars must be moved or dropped — not owned at end
            if own_state_is_owned(st) || own_state_is_borrowed(st) || own_state_is_borrowed_mut(st) {
                own_add_error(ctx, OwnErrorKind::ErrMissingDrop, i, ctx.vars[i as usize].defined_at)
                ok = false
            }
        }
        i = i + 1
    }
    ok
}

fn own_check_no_dangling_borrows(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    // At function end, no borrows should be active
    if ctx.borrow_count > 0 {
        // Release remaining borrows
        while ctx.borrow_count > 0 {
            own_release_borrow(ctx, ctx.borrow_count - 1)
        }
    }
    true
}

fn own_check_function(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    // 1. Check for linear values that were never consumed
    let linear_ok = own_check_linear_at_end(ctx)

    // 2. Release dangling borrows
    let borrow_ok = own_check_no_dangling_borrows(ctx)

    // 3. Compute drop points for remaining owned values
    own_compute_drops(ctx)

    let err_ok = own_has_errors(ctx) == false
    linear_ok && borrow_ok && err_ok
}

// ============================================================
// Utility: count variables in a given state
// ============================================================

fn own_count_in_state(ctx: &OwnContext, state: OwnState) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.var_count {
        if own_state_eq(ctx.vars[i as usize].state, state) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// Utility: reset context for fresh analysis
// ============================================================

fn own_reset(ctx: &! OwnContext) with Mut, Div, Panic {
    ctx.var_count = 0
    ctx.borrow_count = 0
    ctx.drop_count = 0
    ctx.scope_depth = 0
    ctx.error_count = 0
    ctx.path_count = 0
}

// ============================================================
// Utility: find the first error of a given kind
// ============================================================

fn own_find_error(ctx: &OwnContext, kind: OwnErrorKind) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.error_count {
        if own_error_kind_eq(ctx.errors[i as usize].kind, kind) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// ============================================================
// Utility: count errors of a given kind
// ============================================================

fn own_count_errors_of_kind(ctx: &OwnContext, kind: OwnErrorKind) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.error_count {
        if own_error_kind_eq(ctx.errors[i as usize].kind, kind) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// Utility: get the number of variables in the current scope
// ============================================================

fn own_scope_var_count(ctx: &OwnContext) -> i64 with Div, Panic {
    if ctx.scope_depth <= 0 {
        return ctx.var_count
    }
    let scope_start = ctx.scopes[(ctx.scope_depth - 1) as usize].var_start
    ctx.var_count - scope_start
}

// ============================================================
// Utility: mark a variable as initialized (Uninit -> Owned)
// ============================================================

fn own_initialize(ctx: &! OwnContext, var_id: i64) with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        let st = ctx.vars[var_id as usize].state
        if own_state_is_uninit(st) {
            ctx.vars[var_id as usize].state = OwnState::StateOwned
        }
    }
}

// ============================================================
// Utility: explicitly drop a variable
// ============================================================

fn own_explicit_drop(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let st = ctx.vars[var_id as usize].state

    if own_state_is_dropped(st) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }
    if own_state_is_moved(st) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }
    if own_state_is_uninit(st) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }

    // Release borrows if any
    own_release_all_borrows_for(ctx, var_id)

    ctx.vars[var_id as usize].state = OwnState::StateDropped
    ctx.vars[var_id as usize].dropped_at = line
    own_insert_drop(ctx, var_id, line, OwnDropStrategy::DropManual)
    true
}

// ============================================================
// Utility: reinitialize a moved variable (for patterns like
// "move out, then reassign")
// ============================================================

fn own_reinitialize(ctx: &! OwnContext, var_id: i64, line: i64) with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) {
        let st = ctx.vars[var_id as usize].state
        if own_state_is_moved(st) || own_state_is_partially_moved(st) || own_state_is_uninit(st) {
            ctx.vars[var_id as usize].state = OwnState::StateOwned
            ctx.vars[var_id as usize].moved_at = 0 - 1
            ctx.vars[var_id as usize].borrow_count = 0
            ctx.vars[var_id as usize].mut_borrow_count = 0
        }
    }
}

// ============================================================
// Utility: partial move of a field (for struct field access)
// ============================================================

fn own_partial_move(ctx: &! OwnContext, var_id: i64, line: i64) -> bool with Mut, Div, Panic {
    if own_var_in_bounds(ctx, var_id) == false {
        return false
    }
    let st = ctx.vars[var_id as usize].state

    // Copy types cannot be partially moved
    if own_is_copy(ctx, var_id) {
        return true
    }

    if own_state_is_uninit(st) {
        own_add_error(ctx, OwnErrorKind::ErrUninitUse, var_id, line)
        return false
    }
    if own_state_is_moved(st) {
        own_add_error(ctx, OwnErrorKind::ErrUseAfterMove, var_id, line)
        return false
    }
    if own_state_is_dropped(st) {
        own_add_error(ctx, OwnErrorKind::ErrDoubleFree, var_id, line)
        return false
    }
    if own_state_is_borrowed(st) || own_state_is_borrowed_mut(st) {
        own_add_error(ctx, OwnErrorKind::ErrMoveWhileBorrowed, var_id, line)
        return false
    }

    ctx.vars[var_id as usize].state = OwnState::StatePartiallyMoved
    ctx.vars[var_id as usize].moved_at = line
    true
}

// ============================================================
// Utility: count of drops scheduled for a variable
// ============================================================

fn own_drops_for_var(ctx: &OwnContext, var_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.drop_count {
        if ctx.drops[i as usize].var_id == var_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// Utility: check if any borrow is active
// ============================================================

fn own_any_borrows_active(ctx: &OwnContext) -> bool {
    ctx.borrow_count > 0
}

// ============================================================
// Utility: total var count
// ============================================================

fn own_var_count(ctx: &OwnContext) -> i64 {
    ctx.var_count
}

// ============================================================
// Utility: get borrow info
// ============================================================

fn own_get_borrow(ctx: &OwnContext, borrow_id: i64) -> OwnBorrowInfo with Div, Panic {
    if own_borrow_in_bounds(ctx, borrow_id) {
        return ctx.borrows[borrow_id as usize]
    }
    own_empty_borrow_info()
}

// ============================================================
//                    TEST INFRASTRUCTURE
// ============================================================

fn own_assert_true(cond: bool, test_id: i64) -> i64 with IO, Mut, Panic, Div {
    if cond {
        print("  PASS test ")
        print_int(test_id)
        print("\n")
        return 0
    } else {
        print("  FAIL test ")
        print_int(test_id)
        print("\n")
        return 1
    }
}

// ============================================================
//             CATEGORY 1: Basic Ownership (12 tests)
// ============================================================

// Test 1: Context construction produces empty context
fn own_test_1_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    own_var_count(ctx) == 0
    && own_error_count(ctx) == 0
    && own_drop_count(ctx) == 0
    && own_current_scope_depth(ctx) == 0
    && own_any_borrows_active(ctx) == false
}

fn own_test_1() -> i64 with IO, Mut, Div, Panic {
