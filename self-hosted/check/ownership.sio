// Test 64: Merge Dropped + Moved => Moved
fn own_test_64_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyDrop, 10)

    // Branch 1: drop it
    let d = own_explicit_drop(ctx, id, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: simulate moved
    own_set_state(ctx, id, OwnState::StateMoved)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    own_state_is_moved(own_get_state(ctx, id))
}

fn own_test_64() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_64_inner(&! ctx), 64)
}

// Test 65: Merge preserves multiple variables independently
fn own_test_65_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let a = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)
    let b = own_declare_var(ctx, OwnTypeKind::TyAffine, 11)

    // Branch 1: move a, keep b
    let m = own_transfer(ctx, a, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: keep a, move b — restore a first
    own_set_state(ctx, a, OwnState::StateOwned)
    let m2 = own_transfer(ctx, b, 20)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    // Both should be partially moved (for affine, no error)
    own_state_is_partially_moved(own_get_state(ctx, a))
    && own_state_is_partially_moved(own_get_state(ctx, b))
}

fn own_test_65() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_65_inner(&! ctx), 65)
}

