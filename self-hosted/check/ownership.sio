//          CATEGORY 7: Branch Merging (7 tests)
// ============================================================

// Test 59: Merge Owned + Owned => Owned
fn own_test_59_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Snapshot current (Owned)
    let snap1 = own_snapshot_mut(ctx)
    // Both branches leave it as Owned — same snapshot
    let snap2 = own_snapshot_mut(ctx)
    let ok = own_merge_branches(ctx, snap1, snap2)
    ok && own_state_is_owned(own_get_state(ctx, id))
}

fn own_test_59() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_59_inner(&! ctx), 59)
}

// Test 60: Merge Moved + Moved => Moved
fn own_test_60_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Branch 1: move it
    let m1 = own_transfer(ctx, id, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: also move it (simulate by restoring to Moved via set_state)
    // Already moved, so snap2 = same state
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    ok && own_state_is_moved(own_get_state(ctx, id))
}

fn own_test_60() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_60_inner(&! ctx), 60)
}

// Test 61: Merge Owned + Moved => PartiallyMoved
fn own_test_61_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Branch 1: keep owned
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: move it
    let m = own_transfer(ctx, id, 15)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    // For affine types, partial move is OK (no error)
    own_state_is_partially_moved(own_get_state(ctx, id))
}

fn own_test_61() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_61_inner(&! ctx), 61)
}

// Test 62: Merge Owned + Moved for linear type => error
fn own_test_62_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyLinear, 10)

    // Branch 1: keep owned
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: move it
    let m = own_transfer(ctx, id, 15)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    ok == false
    && own_error_kind_eq(own_last_error_kind(ctx), OwnErrorKind::ErrPartialMove)
}

fn own_test_62() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_62_inner(&! ctx), 62)
}

