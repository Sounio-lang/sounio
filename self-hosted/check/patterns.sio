    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, bind_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(result, 12)
}

// ============================================================
// Test 13: Or-pattern exhaustiveness (true | false covers bool)
// ============================================================

fn test_or_pattern_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    let pair3 = pat_pool_add_or(pool, true_id, false_id)
    pool = pair3.0
    let or_id = pair3.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, or_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 2)
    assert_true(result, 13)
}

