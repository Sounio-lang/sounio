// ============================================================
// Test 15: Usefulness — wildcard after exhaustive bool is NOT useful
// ============================================================

fn test_usefulness_redundant_after_bool() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    // Matrix with true and false
    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, false_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    // New row: wildcard — should NOT be useful
    var new_row = pat_row_with_action(2)
    new_row = pat_row_set(new_row, 0, wc_id)

    let useful = pat_is_useful(matrix, pool, new_row, 2)
    assert_true(!useful, 15)
}

// ============================================================
// Test 16: Usefulness — false is useful when only true exists
// ============================================================

fn test_usefulness_false_after_true() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    var new_row = pat_row_with_action(1)
    new_row = pat_row_set(new_row, 0, false_id)

    let useful = pat_is_useful(matrix, pool, new_row, 2)
    assert_true(useful, 16)
}

// ============================================================
// Test 17: Decision tree — single wildcard produces leaf
// ============================================================

fn test_decision_tree_leaf() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    var row1 = pat_row_with_action(42)
    row1 = pat_row_set(row1, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let tree = pat_compile_to_decision_tree(matrix, pool)
    // Should have at least one node, and it should be a leaf
    let ok1 = tree.node_count >= 1
    // Find the root node (last one added by compile)
    let root_idx = tree.node_count - 1
    let kind = decision_tree_node_kind(tree, root_idx)
    let ok2 = kind == DECISION_LEAF
    let action = decision_tree_node_action(tree, root_idx)
    let ok3 = action == 42
    assert_true(ok1 && ok2 && ok3, 17)
}

// ============================================================
// Test 18: Int literal patterns (two ints, no exhaustiveness)
// ============================================================

fn test_int_literal_not_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 0)
    pool = pair1.0
    let zero_id = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 1)
    pool = pair2.0
    let one_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, zero_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, one_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    // i64 is an open type, so 2 literals cannot be exhaustive
    // (type_ctor_count=0 means open type, checked via default matrix)
    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(!result, 18)
}

// ============================================================
// Test 19: Int literals + wildcard IS exhaustive
// ============================================================

fn test_int_with_wildcard_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_int(pool, 42)
    pool = pair1.0
    let forty_two_id = pair1.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, forty_two_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(result, 19)
}

// ============================================================
// Test 20: Duplicate int literal is redundant
// ============================================================

fn test_duplicate_int_redundant() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 5)
    pool = pair1.0
    let five_a = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 5)
    pool = pair2.0
    let five_b = pair2.1

    let pair3 = pat_pool_add_wildcard(pool)
    pool = pair3.0
    let wc_id = pair3.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, five_a)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, five_b)
    var row3 = pat_row_with_action(2)
    row3 = pat_row_set(row3, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)
    matrix = pat_matrix_add_row(matrix, row3)

    let redundant = pat_find_redundant(matrix, pool, 0)
    // Row 1 (second literal 5) is redundant
    assert_true(redundant == 1, 20)
}

// ============================================================
// Test 21: Or-pattern usefulness
// ============================================================

fn test_or_pattern_usefulness() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 1)
    pool = pair1.0
    let one_id = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 2)
    pool = pair2.0
    let two_id = pair2.1

    let pair3 = pat_pool_add_literal_int(pool, 3)
    pool = pair3.0
    let three_id = pair3.1

    // Matrix: 1 | 2
    let pair4 = pat_pool_add_or(pool, one_id, two_id)
    pool = pair4.0
    let or_id = pair4.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, or_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    // New row: 3 should be useful
    var new_row = pat_row_with_action(1)
    new_row = pat_row_set(new_row, 0, three_id)

    let useful = pat_is_useful(matrix, pool, new_row, 0)
    assert_true(useful, 21)
}

// ============================================================
// Test 22: Pool child access correctness
// ============================================================

fn test_pool_children() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()

    // Add a wildcard at index 0
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    // Add a variant with 2 children (both wildcard)
    var children: [i64; 16] = [0; 16]
    children[0] = wc_id
    children[1] = wc_id
    let pair1 = pat_pool_add_variant(pool, 5, children, 2)
    pool = pair1.0
    let var_id = pair1.1

    // Check child access
    let c0 = pat_pool_get_child(pool, var_id, 0)
    let c1 = pat_pool_get_child(pool, var_id, 1)
    let ok1 = c0 == wc_id
    let ok2 = c1 == wc_id
    let ok3 = pool.child_counts[var_id as usize] == 2
    let ok4 = pool.values[var_id as usize] == 5
    assert_true(ok1 && ok2 && ok3 && ok4, 22)
}

// ============================================================
// Test 23: Decision tree — empty matrix produces fail
// ============================================================

fn test_decision_tree_fail() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let matrix = pat_matrix_new()
    let tree = pat_compile_to_decision_tree(matrix, pool)
    let ok1 = tree.node_count >= 1
    let root_idx = tree.node_count - 1
    let kind = decision_tree_node_kind(tree, root_idx)
    let ok2 = kind == DECISION_FAIL
    assert_true(ok1 && ok2, 23)
}

// ============================================================
// Test runner
// ============================================================

fn pattern_check_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Pattern check tests ===\n")
    var fails: i64 = 0
    fails = fails + test_empty_not_exhaustive()
    fails = fails + test_wildcard_exhaustive()
    fails = fails + test_bool_exhaustive()
    fails = fails + test_bool_not_exhaustive()
    fails = fails + test_find_missing_bool()
    fails = fails + test_variant_exhaustive()
    fails = fails + test_missing_variant()
    fails = fails + test_redundant_wildcard()
    fails = fails + test_no_redundant()
    fails = fails + test_specialize_bool()
    fails = fails + test_default_matrix()
    fails = fails + test_binding_as_wildcard()
    fails = fails + test_or_pattern_exhaustive()
    fails = fails + test_or_pattern_not_exhaustive()
    fails = fails + test_usefulness_redundant_after_bool()
    fails = fails + test_usefulness_false_after_true()
    fails = fails + test_decision_tree_leaf()
    fails = fails + test_int_literal_not_exhaustive()
    fails = fails + test_int_with_wildcard_exhaustive()
    fails = fails + test_duplicate_int_redundant()
    fails = fails + test_or_pattern_usefulness()
    fails = fails + test_pool_children()
    fails = fails + test_decision_tree_fail()

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}
