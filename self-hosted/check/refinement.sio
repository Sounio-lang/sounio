// Refinement types — predicate representation + SMT-lite checks
//
// Predicate op tags:
// 0=None, 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq, 7=And, 8=Or

pub fn refinement_op_none() -> i64 { 0 }
pub fn refinement_op_gt() -> i64 { 1 }
pub fn refinement_op_gt_eq() -> i64 { 2 }
pub fn refinement_op_lt() -> i64 { 3 }
pub fn refinement_op_lt_eq() -> i64 { 4 }
pub fn refinement_op_eq() -> i64 { 5 }
pub fn refinement_op_neq() -> i64 { 6 }
fn refinement_op_and() -> i64 { 7 }
fn refinement_op_or() -> i64 { 8 }

pub struct RefinementPred {
    op: i64,
    var_name: Name,
    rhs_int: i64,
    rhs_float: f64,
    is_float: bool,
    left: Option<Box<RefinementPred> >,
    right: Option<Box<RefinementPred> >,
}

pub struct RefinementType {
    base_type: TypeEntry,
    var_name: Name,
    predicate: RefinementPred,
}

pub struct RefinementTable {
    entries: [RefinementType; 64],
    names: [Name; 64],
    count: i64,
}

pub fn empty_refinement_pred() -> RefinementPred {
    RefinementPred {
        op: refinement_op_none(),
        var_name: Name { buf: [0; 128], len: 0 },
        rhs_int: 0,
        rhs_float: 0.0,
        is_float: false,
        left: None,
        right: None,
    }
}

fn empty_refinement_type() -> RefinementType {
    RefinementType {
        base_type: ty_error(),
        var_name: Name { buf: [0; 128], len: 0 },
        predicate: empty_refinement_pred(),
    }
}

pub fn refinement_table_new() -> RefinementTable {
    RefinementTable {
        entries: [empty_refinement_type(); 64],
        names: [Name { buf: [0; 128], len: 0 }; 64],
        count: 0,
    }
}

pub fn refinement_table_find(t: RefinementTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < t.count {
        if name_eq(t.names[i as usize], name) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn refinement_table_add(t: RefinementTable, name: Name, rt: RefinementType) -> RefinementTable with Mut, Panic, Div {
    var out = t
    let idx = refinement_table_find(out, name)
    if idx >= 0 {
        out.entries[idx as usize] = rt
        out.names[idx as usize] = name
        return out
    }
    if out.count < 64 {
        out.entries[out.count as usize] = rt
        out.names[out.count as usize] = name
        out.count = out.count + 1
    }
    out
}

pub fn make_refinement_synth_name(idx: i64) -> Name with Mut, Panic {
    var n = Name { buf: [0; 128], len: 0 }
    // Write "__ref" prefix
    n.buf[0] = 95   // '_'
    n.buf[1] = 95   // '_'
    n.buf[2] = 114  // 'r'
    n.buf[3] = 101  // 'e'
    n.buf[4] = 102  // 'f'
    if idx < 10 {
        n.buf[5] = (48 + idx) as i8   // '0'..'9'
        n.len = 6
    } else {
        let tens = idx / 10
        let ones = idx % 10
        n.buf[5] = (48 + tens) as i8
        n.buf[6] = (48 + ones) as i8
        n.len = 7
    }
    n
}

pub fn pred_make_int(op: i64, var_name: Name, val: i64) -> RefinementPred {
    RefinementPred {
        op: op,
        var_name: var_name,
        rhs_int: val,
        rhs_float: val as f64,
        is_float: false,
        left: None,
        right: None,
    }
}

pub fn pred_make_float(op: i64, var_name: Name, val: f64) -> RefinementPred {
    RefinementPred {
        op: op,
        var_name: var_name,
        rhs_int: val as i64,
        rhs_float: val,
        is_float: true,
        left: None,
        right: None,
    }
}

fn pred_make_compound(op: i64, left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    RefinementPred {
        op: op,
        var_name: left.var_name,
        rhs_int: 0,
        rhs_float: 0.0,
        is_float: false,
        left: Some(Box::new(left)),
        right: Some(Box::new(right)),
    }
}

fn pred_gt(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_gt(), var_name, val)
}

fn pred_gt_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_gt_eq(), var_name, val)
}

fn pred_lt(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_lt(), var_name, val)
}

fn pred_lt_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_lt_eq(), var_name, val)
}

fn pred_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_eq(), var_name, val)
}

fn pred_neq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_neq(), var_name, val)
}

fn pred_gt_f(var_name: Name, val: f64) -> RefinementPred {
    pred_make_float(refinement_op_gt(), var_name, val)
}

pub fn pred_and(left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    pred_make_compound(refinement_op_and(), left, right)
}

pub fn pred_or(left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    pred_make_compound(refinement_op_or(), left, right)
}

fn pred_check_cmp_int(op: i64, lhs: i64, rhs: i64) -> bool {
    if op == refinement_op_gt() {
        lhs > rhs
    } else if op == refinement_op_gt_eq() {
        lhs >= rhs
    } else if op == refinement_op_lt() {
        lhs < rhs
    } else if op == refinement_op_lt_eq() {
        lhs <= rhs
    } else if op == refinement_op_eq() {
        lhs == rhs
    } else if op == refinement_op_neq() {
        lhs != rhs
    } else {
        false
    }
}

fn pred_check_cmp_float(op: i64, lhs: f64, rhs: f64) -> bool {
    if op == refinement_op_gt() {
        lhs > rhs
    } else if op == refinement_op_gt_eq() {
        lhs >= rhs
    } else if op == refinement_op_lt() {
        lhs < rhs
    } else if op == refinement_op_lt_eq() {
        lhs <= rhs
    } else if op == refinement_op_eq() {
        lhs == rhs
    } else if op == refinement_op_neq() {
        lhs != rhs
    } else {
        false
    }
}

fn pred_check_int(pred: RefinementPred, val: i64) -> bool with Mut, Panic, Div {
    if pred.op == refinement_op_and() {
        let left_ok = match pred.left {
            Some(l) => pred_check_int(*l, val)
            None => false
        }
        if !left_ok { return false }
        let right_ok = match pred.right {
            Some(r) => pred_check_int(*r, val)
            None => false
        }
        left_ok && right_ok
    } else if pred.op == refinement_op_or() {
        let left_ok = match pred.left {
            Some(l) => pred_check_int(*l, val)
            None => false
        }
        if left_ok { return true }
        match pred.right {
            Some(r) => pred_check_int(*r, val)
            None => false
        }
    } else if pred.is_float {
        pred_check_cmp_float(pred.op, val as f64, pred.rhs_float)
    } else {
        pred_check_cmp_int(pred.op, val, pred.rhs_int)
    }
}

fn pred_check_float(pred: RefinementPred, val: f64) -> bool with Mut, Panic, Div {
    if pred.op == refinement_op_and() {
        let left_ok = match pred.left {
            Some(l) => pred_check_float(*l, val)
            None => false
        }
        if !left_ok { return false }
        let right_ok = match pred.right {
            Some(r) => pred_check_float(*r, val)
            None => false
        }
        left_ok && right_ok
    } else if pred.op == refinement_op_or() {
        let left_ok = match pred.left {
            Some(l) => pred_check_float(*l, val)
            None => false
        }
        if left_ok { return true }
        match pred.right {
            Some(r) => pred_check_float(*r, val)
            None => false
        }
    } else if pred.is_float {
        pred_check_cmp_float(pred.op, val, pred.rhs_float)
    } else {
        pred_check_cmp_float(pred.op, val, pred.rhs_int as f64)
    }
}

fn pred_is_atomic(pred: RefinementPred) -> bool {
    pred.op >= refinement_op_gt() && pred.op <= refinement_op_neq()
}

fn pred_equals(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    if a.op != b.op { return false }
    if !name_eq(a.var_name, b.var_name) { return false }
    if a.is_float != b.is_float { return false }
    if a.is_float {
        if a.rhs_float != b.rhs_float { return false }
    } else {
        if a.rhs_int != b.rhs_int { return false }
    }
    if a.op == refinement_op_and() || a.op == refinement_op_or() {
        let left_eq = match a.left {
            Some(la) => {
                match b.left {
                    Some(lb) => pred_equals(*la, *lb)
                    None => false
                }
            }
            None => false
        }
        if !left_eq { return false }
        match a.right {
            Some(ra) => {
                match b.right {
                    Some(rb) => pred_equals(*ra, *rb)
                    None => false
                }
            }
            None => false
        }
    } else {
        true
    }
}

fn pred_implies_atomic_int(a: RefinementPred, b: RefinementPred) -> bool {
    let av = a.rhs_int
    let bv = b.rhs_int

    if a.op == refinement_op_gt() {
        if b.op == refinement_op_gt() { return av >= bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        if b.op == refinement_op_neq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_gt_eq() {
        if b.op == refinement_op_gt() { return av > bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        if b.op == refinement_op_neq() { return av > bv || av < bv }
        return false
    }
    if a.op == refinement_op_lt() {
        if b.op == refinement_op_lt() { return av <= bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        if b.op == refinement_op_neq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_lt_eq() {
        if b.op == refinement_op_lt() { return av < bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        if b.op == refinement_op_neq() { return av < bv || av > bv }
        return false
    }
    if a.op == refinement_op_eq() {
        if b.op == refinement_op_eq() { return av == bv }
        if b.op == refinement_op_neq() { return av != bv }
        return pred_check_cmp_int(b.op, av, bv)
    }
    if a.op == refinement_op_neq() {
        if b.op == refinement_op_neq() { return av == bv }
        return false
    }
    false
}

fn pred_implies_atomic_float(a: RefinementPred, b: RefinementPred) -> bool {
    let av = if a.is_float { a.rhs_float } else { a.rhs_int as f64 }
    let bv = if b.is_float { b.rhs_float } else { b.rhs_int as f64 }

    if a.op == refinement_op_gt() {
        if b.op == refinement_op_gt() { return av >= bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_gt_eq() {
        if b.op == refinement_op_gt() { return av > bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_lt() {
        if b.op == refinement_op_lt() { return av <= bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_lt_eq() {
        if b.op == refinement_op_lt() { return av < bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_eq() {
        if b.op == refinement_op_eq() { return av == bv }
        return pred_check_cmp_float(b.op, av, bv)
    }
    if a.op == refinement_op_neq() {
        if b.op == refinement_op_neq() { return av == bv }
        return false
    }
    false
}

pub fn pred_implies(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    if pred_equals(a, b) { return true }

    // A implies (B1 or B2) iff A implies B1 or A implies B2
    if b.op == refinement_op_or() {
        let left_ok = match b.left {
            Some(bl) => pred_implies(a, *bl)
            None => false
        }
        if left_ok { return true }
        return match b.right {
            Some(br) => pred_implies(a, *br)
            None => false
        }
    }

    // A implies (B1 and B2) iff A implies both B1 and B2
    if b.op == refinement_op_and() {
        let left_ok = match b.left {
            Some(bl) => pred_implies(a, *bl)
            None => false
        }
        if !left_ok { return false }
        return match b.right {
            Some(br) => pred_implies(a, *br)
            None => false
        }
    }

    // (A1 and A2) implies B if either conjunct alone implies B (safe under-approx)
    if a.op == refinement_op_and() {
        let left_ok = match a.left {
            Some(al) => pred_implies(*al, b)
            None => false
        }
        if left_ok { return true }
        return match a.right {
            Some(ar) => pred_implies(*ar, b)
            None => false
        }
    }

    // (A1 or A2) implies B only if both imply B
    if a.op == refinement_op_or() {
        let left_ok = match a.left {
            Some(al) => pred_implies(*al, b)
            None => false
        }
        if !left_ok { return false }
        return match a.right {
            Some(ar) => pred_implies(*ar, b)
            None => false
        }
    }

    if !pred_is_atomic(a) || !pred_is_atomic(b) { return false }
    if !name_eq(a.var_name, b.var_name) { return false }

    if a.is_float || b.is_float {
        pred_implies_atomic_float(a, b)
    } else {
        if pred_implies_atomic_int(a, b) {
            true
        } else {
            pred_interval_implies(a, b)
        }
    }
}

// Structural implication: same as pred_implies but ignores var_name.
// Used for ontology property axiom injection where the property's bound
// variable ("potency") and the refinement's bound variable ("v") differ
// but the predicate structure is semantically equivalent.
// This is correct because ontology properties are universally quantified
// over class instances — the name is just a binder, not an identity.
pub fn pred_implies_structural(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    // Structurally equal (ignoring var_name)?
    if a.op == b.op && a.rhs_int == b.rhs_int && a.is_float == b.is_float {
        if a.is_float {
            if a.rhs_float == b.rhs_float { return true }
        } else {
            return true
        }
    }

    // Compound cases: same decomposition as pred_implies
    if b.op == refinement_op_or() {
        let left_ok = match b.left {
            Some(bl) => pred_implies_structural(a, *bl)
            None => false
        }
        if left_ok { return true }
        return match b.right {
            Some(br) => pred_implies_structural(a, *br)
            None => false
        }
    }
    if b.op == refinement_op_and() {
        let left_ok = match b.left {
            Some(bl) => pred_implies_structural(a, *bl)
            None => false
        }
        if !left_ok { return false }
        return match b.right {
            Some(br) => pred_implies_structural(a, *br)
            None => false
        }
    }
    if a.op == refinement_op_and() {
        let left_ok = match a.left {
            Some(al) => pred_implies_structural(*al, b)
            None => false
        }
        if left_ok { return true }
        return match a.right {
            Some(ar) => pred_implies_structural(*ar, b)
            None => false
        }
    }
    if a.op == refinement_op_or() {
        let left_ok = match a.left {
            Some(al) => pred_implies_structural(*al, b)
            None => false
        }
        if !left_ok { return false }
        return match a.right {
            Some(ar) => pred_implies_structural(*ar, b)
            None => false
        }
    }

    if !pred_is_atomic(a) || !pred_is_atomic(b) { return false }
    // NO var_name check — this is the key difference from pred_implies

    if a.is_float || b.is_float {
        pred_implies_atomic_float(a, b)
    } else {
        if pred_implies_atomic_int(a, b) {
            true
        } else {
            // pred_interval_implies works purely on numeric bounds — no var_name needed
            pred_interval_implies(a, b)
        }
    }
}

fn print_pred_op(op: i64) with IO {
    if op == refinement_op_gt() { print(">") }
    else if op == refinement_op_gt_eq() { print(">=") }
    else if op == refinement_op_lt() { print("<") }
    else if op == refinement_op_lt_eq() { print("<=") }
    else if op == refinement_op_eq() { print("==") }
    else if op == refinement_op_neq() { print("!=") }
    else if op == refinement_op_and() { print("&&") }
    else if op == refinement_op_or() { print("||") }
    else { print("?") }
}

fn print_pred_name(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i as usize] as i64)
        i = i + 1
    }
}

fn print_pred(pred: RefinementPred) with IO, Mut, Panic, Div {
    if pred.op == refinement_op_and() || pred.op == refinement_op_or() {
        print("(")
        match pred.left {
            Some(l) => print_pred(*l)
            None => print("?")
        }
        print(" ")
        print_pred_op(pred.op)
        print(" ")
        match pred.right {
            Some(r) => print_pred(*r)
            None => print("?")
        }
        print(")")
        return
    }

    print_pred_name(pred.var_name)
    print(" ")
    print_pred_op(pred.op)
    print(" ")
    if pred.is_float {
        let rhs_milli = (pred.rhs_float * 1000.0) as i64
        print_int(rhs_milli)
        print("/1000")
    } else {
        print_int(pred.rhs_int)
    }
}

// Interval representation for refinement predicate proving.
// Used by pred_interval_implies as an SMT-lite solver.
pub struct Interval {
    lo: i64,
    hi: i64,
    lo_strict: bool,  // true means exclusive Gt, false means inclusive GteEq
    hi_strict: bool,   // true means exclusive Lt, false means inclusive LtEq
    lo_unbounded: bool,
    hi_unbounded: bool,
}

fn interval_full() -> Interval {
    Interval { lo: 0, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: true, hi_unbounded: true }
}

fn interval_empty() -> Interval {
    Interval { lo: 1, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: false }
}

fn interval_is_empty(iv: Interval) -> bool {
    if iv.lo_unbounded || iv.hi_unbounded { false }
    else if iv.lo > iv.hi { true }
    else if iv.lo == iv.hi && (iv.lo_strict || iv.hi_strict) { true }
    else { false }
}

// Convert a single atomic predicate to an interval.
fn pred_to_interval(p: RefinementPred) -> Interval with Mut {
    let v = p.rhs_int
    if p.op == refinement_op_gt() {
        Interval { lo: v, hi: 0, lo_strict: true, hi_strict: false, lo_unbounded: false, hi_unbounded: true }
    } else if p.op == refinement_op_gt_eq() {
        Interval { lo: v, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: true }
    } else if p.op == refinement_op_lt() {
        Interval { lo: 0, hi: v, lo_strict: false, hi_strict: true, lo_unbounded: true, hi_unbounded: false }
    } else if p.op == refinement_op_lt_eq() {
        Interval { lo: 0, hi: v, lo_strict: false, hi_strict: false, lo_unbounded: true, hi_unbounded: false }
    } else if p.op == refinement_op_eq() {
        Interval { lo: v, hi: v, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: false }
    } else {
        interval_full()
    }
}

// Intersect two intervals (for And predicates).
fn interval_intersect(a: Interval, b: Interval) -> Interval with Mut {
    var lo = a.lo
    var lo_strict = a.lo_strict
    var lo_unbounded = a.lo_unbounded
    var hi = a.hi
    var hi_strict = a.hi_strict
    var hi_unbounded = a.hi_unbounded

    if !b.lo_unbounded {
        if lo_unbounded || b.lo > lo || (b.lo == lo && b.lo_strict && !lo_strict) {
            lo = b.lo
            lo_strict = b.lo_strict
            lo_unbounded = false
        }
    }
    if !b.hi_unbounded {
        if hi_unbounded || b.hi < hi || (b.hi == hi && b.hi_strict && !hi_strict) {
            hi = b.hi
            hi_strict = b.hi_strict
            hi_unbounded = false
        }
    }
    Interval { lo: lo, hi: hi, lo_strict: lo_strict, hi_strict: hi_strict, lo_unbounded: lo_unbounded, hi_unbounded: hi_unbounded }
}

// Convert a compound predicate to an interval (handles And chains).
fn pred_to_interval_compound(p: RefinementPred) -> Interval with Mut, Panic, Div {
    if pred_is_atomic(p) {
        pred_to_interval(p)
    } else if p.op == refinement_op_and() {
        var iv = interval_full()
        match p.left {
            Some(lp) => {
                let left_iv = pred_to_interval_compound(*lp)
                iv = interval_intersect(iv, left_iv)
            }
            None => {}
        }
        match p.right {
            Some(rp) => {
                let right_iv = pred_to_interval_compound(*rp)
                iv = interval_intersect(iv, right_iv)
            }
            None => {}
        }
        iv
    } else {
        interval_full()
    }
}

// Check if interval `iv` satisfies predicate `target`.
fn interval_implies_pred(iv: Interval, target: RefinementPred) -> bool with Mut {
    if interval_is_empty(iv) { return true }
    let tv = target.rhs_int
    if target.op == refinement_op_gt() {
        if iv.lo_unbounded { false }
        else if iv.lo > tv { true }
        else if iv.lo == tv && iv.lo_strict { true }
        else { false }
    } else if target.op == refinement_op_gt_eq() {
        if iv.lo_unbounded { false }
        else if iv.lo > tv { true }
        else if iv.lo == tv && !iv.lo_strict { true }
        else { false }
    } else if target.op == refinement_op_lt() {
        if iv.hi_unbounded { false }
        else if iv.hi < tv { true }
        else if iv.hi == tv && iv.hi_strict { true }
        else { false }
    } else if target.op == refinement_op_lt_eq() {
        if iv.hi_unbounded { false }
        else if iv.hi < tv { true }
        else if iv.hi == tv && !iv.hi_strict { true }
        else { false }
    } else {
        false
    }
}

// Interval-based entailment: does predicate `a` imply predicate `b`?
fn pred_interval_implies(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    let iv = pred_to_interval_compound(a)
    if interval_is_empty(iv) { return true }
    if pred_is_atomic(b) {
        interval_implies_pred(iv, b)
    } else if b.op == refinement_op_and() {
        var left_ok = true
        match b.left {
            Some(bl) => { left_ok = pred_interval_implies(a, *bl) }
            None => {}
        }
        if !left_ok { return false }
        var right_ok = true
        match b.right {
            Some(br) => { right_ok = pred_interval_implies(a, *br) }
            None => {}
        }
        right_ok
    } else if b.op == refinement_op_or() {
        var left_ok = false
        match b.left {
            Some(bl) => { left_ok = pred_interval_implies(a, *bl) }
            None => {}
        }
        if left_ok { return true }
        var right_ok = false
        match b.right {
            Some(br) => { right_ok = pred_interval_implies(a, *br) }
            None => {}
        }
        right_ok
    } else {
        false
    }
}

// ─── Static Refinement Environment ────────────────────────────────────────────
//
// Lightweight static proof engine — no Z3 required.
// Handles:
//   1. Constant folding: value is a known literal → evaluate predicate directly.
//   2. Condition narrowing: inside `if x > 0 { ... }`, x > 0 is known true.
//   3. Arithmetic monotonicity: x > 0 && y > 0 ⟹ x + y > 0 (via interval lattice).
//
// The environment is a flat array of up to 16 guard predicates accumulated from
// enclosing `if`-condition branches.  Each predicate is a single RefinementPred.
// When checking `x` against a target pred, we conjoin all guards whose var_name
// matches `x` and ask whether the conjunction implies the target.
//
// If static proof fails → fallback to runtime assertion (current behaviour) +
// emit `refine_hint: static_unknown` diagnostic (W041-range, code 45).

pub struct RefineStaticEnv {
    preds: [RefinementPred; 16],
    count: i64,
}

pub fn refine_static_env_new() -> RefineStaticEnv {
    RefineStaticEnv {
        preds: [empty_refinement_pred(); 16],
        count: 0,
    }
}

pub fn refine_static_env_push(env: RefineStaticEnv, p: RefinementPred) -> RefineStaticEnv with Mut {
    var out = env
    if out.count < 16 {
        out.preds[out.count as usize] = p
        out.count = out.count + 1
    }
    out
}

// Build the conjunction of all guard predicates that share the same var_name
// as `target`.  Returns (found, conjoined_pred).
fn refine_static_env_gather(env: RefineStaticEnv, target_var: Name) -> (bool, RefinementPred) with Mut, Panic, Div {
    var found = false
    var conjoined = empty_refinement_pred()
    var i: i64 = 0
    while i < env.count {
        let p = env.preds[i as usize]
        if name_eq(p.var_name, target_var) {
            if found {
                // Already have one — extend to an And node using structural combine.
                // We reuse pred_and but note it requires Alloc; to avoid that here we
                // just check each guard individually — sufficient for atomic guards.
                if pred_implies(p, conjoined) {
                    // p is at least as strong; replace
                    conjoined = p
                }
                // Otherwise keep the existing conjoined (under-approx).
            } else {
                conjoined = p
                found = true
            }
        }
        i = i + 1
    }
    (found, conjoined)
}

// Probe result codes (returned as i64, not an enum, to stay allocation-free):
//   0 = StaticUnknown  — cannot prove statically
//   1 = StaticProved   — proved without Z3
//   2 = StaticViolated — definitely violated (compile-time error)

fn refine_static_result_unknown() -> i64 { 0 }
pub fn refine_static_result_proved() -> i64 { 1 }
fn refine_static_result_violated() -> i64 { 2 }

// Check whether a known integer literal `val` satisfies `pred`.
// Returns StaticProved or StaticViolated.
pub fn refine_static_check_int_literal(pred: RefinementPred, val: i64) -> i64 with Mut, Panic, Div {
    if pred_check_int(pred, val) {
        refine_static_result_proved()
    } else {
        refine_static_result_violated()
    }
}

// Check whether a known float literal `val` satisfies `pred`.
pub fn refine_static_check_float_literal(pred: RefinementPred, val: f64) -> i64 with Mut, Panic, Div {
    if pred_check_float(pred, val) {
        refine_static_result_proved()
    } else {
        refine_static_result_violated()
    }
}

// Attempt to prove `target_pred` for variable `var_name` using guards in `env`.
// Returns StaticProved, StaticViolated, or StaticUnknown.
pub fn refine_static_check_var(env: RefineStaticEnv, var_name: Name, target_pred: RefinementPred) -> i64 with Mut, Panic, Div {
    let gather = refine_static_env_gather(env, var_name)
    if gather.0 == false {
        return refine_static_result_unknown()
    }
    let guard = gather.1
    if pred_implies(guard, target_pred) {
        refine_static_result_proved()
    } else {
        refine_static_result_unknown()
    }
}

// Try to prove `target_pred` for the conjunction of two positive-integer guards
// (arithmetic monotonicity): if `a > 0` and `b > 0` and target is `result > 0`
// where result = a + b, this is trivially provable.
// This is a special-case shortcut for the most common pattern.
fn refine_static_check_add_monotone(env: RefineStaticEnv, la: Name, lb: Name, target_pred: RefinementPred) -> i64 with Mut, Panic, Div {
    // Only handle target predicate of form: var > 0 or var >= 0
    if target_pred.op != refinement_op_gt() && target_pred.op != refinement_op_gt_eq() {
        return refine_static_result_unknown()
    }
    if target_pred.rhs_int != 0 {
        return refine_static_result_unknown()
    }
    // Check if both summands are proven positive
    let ga = refine_static_env_gather(env, la)
    let gb = refine_static_env_gather(env, lb)
    if ga.0 == false || gb.0 == false {
        return refine_static_result_unknown()
    }
    let pos_pred_gt = pred_make_int(refinement_op_gt(), la, 0)
    let pos_pred_ge = pred_make_int(refinement_op_gt_eq(), la, 0)
    let a_positive = pred_implies(ga.1, pos_pred_gt) || pred_implies(ga.1, pos_pred_ge)
    let pos_pred_gt_b = pred_make_int(refinement_op_gt(), lb, 0)
    let pos_pred_ge_b = pred_make_int(refinement_op_gt_eq(), lb, 0)
    let b_positive = pred_implies(gb.1, pos_pred_gt_b) || pred_implies(gb.1, pos_pred_ge_b)
    if a_positive && b_positive {
        refine_static_result_proved()
    } else {
        refine_static_result_unknown()
    }
}

// Print the refinement proof summary line.
// Format: "refine: proved N statically, M runtime-checked, K violations\n"
pub fn refine_print_summary(n_proved: i64, n_runtime: i64, n_violated: i64) with IO {
    print("refine: proved ")
    print_int(n_proved)
    print(" statically, ")
    print_int(n_runtime)
    print(" runtime-checked, ")
    print_int(n_violated)
    print(" violations\n")
}
