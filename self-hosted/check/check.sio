        }
        i = i + 1
    }

    ep.contest_count = checker.contests.count
    if ep.contest_count > IR_MAX_EPI_CONTESTS {
        ep.contest_count = IR_MAX_EPI_CONTESTS
    }
    i = 0
    while i < ep.contest_count {
        ep.contests[i as usize].id = i
        ep.contests[i as usize].span_start = checker.contests.entries[i as usize].span_start
        ep.contests[i as usize].span_end = checker.contests.entries[i as usize].span_end
        ep.contests[i as usize].audit_id = checker.contests.entries[i as usize].audit_id
