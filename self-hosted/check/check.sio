// Main type checker — Checker struct, two passes, expression dispatch
//
// Pass 1: collect struct/enum/fn definitions into tables
// Pass 2: check function/method bodies for type consistency
//
// Methods return (Checker, ...) to thread state through value semantics.

// ============================================================
// Security limits
// ============================================================

const MAX_TYPE_DEPTH: i64 = 64
const MAX_EXPR_DEPTH: i64 = 256
const MAX_LOOP_DEPTH: i64 = 1024
const MAX_TYPE_COMPLEXITY: i64 = 1000
const MAX_BORROW_ENTRIES: i64 = 2048
const MAX_SCOPE_DEPTH: i64 = 256
const MAX_REFINEMENT_ENTRIES: i64 = 128

// ============================================================
// Checker state
// ============================================================

struct Checker {
    env: TypeEnv,
    borrows: BorrowEnv,
    units: UnitRegistry,
    refinements: RefinementTable,
    structs: StructTable,
    enums: EnumTable,
    fn_sigs: FnSigTable,
    error_count: i64,
    had_error: bool,
    current_return_type: TypeEntry,
    current_impl_type: TypeEntry,
    current_effects: [i64; 8],
    current_effect_count: i64,
    last_literal_int: i64,
    last_literal_float: f64,
    last_literal_kind: i64,   // 0=none, 1=int, 2=float
    loop_depth: i64,
    suppress_linear_consume_depth: i64,
    type_depth: i64,
    expr_depth: i64,
    complexity_budget: i64,
}

fn checker_new() -> Checker with Mut, Panic, Div {
    Checker {
        env: type_env_new(),
        borrows: borrow_env_new(),
        units: register_builtin_units(unit_registry_new()),
        refinements: refinement_table_new(),
        structs: struct_table_new(),
        enums: enum_table_new(),
        fn_sigs: fn_sig_table_new(),
        error_count: 0,
        had_error: false,
        current_return_type: ty_unit(),
        current_impl_type: ty_error(),
        current_effects: [0; 8],
        current_effect_count: 0,
        last_literal_int: 0,
        last_literal_float: 0.0,
        last_literal_kind: 0,
        loop_depth: 0,
        suppress_linear_consume_depth: 0,
        type_depth: 0,
        expr_depth: 0,
        complexity_budget: 0,
    }
}

// ============================================================
// Error reporting
// ============================================================

// ============================================================
// Type pretty-printing for diagnostics
// ============================================================

fn print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    match ty.kind {
        TyI8 => print("i8")
        TyI32 => print("i32")
        TyI64 => print("i64")
        TyU8 => print("u8")
        TyU32 => print("u32")
        TyU64 => print("u64")
        TyF32 => print("f32")
        TyF64 => print("f64")
        TyBool => print("bool")
        TyUnit => print("()")
        TyString => print("string")
        TyChar => print("char")
        TyNamed => {
            var i: i64 = 0
            while i < ty.name.len {
                print_char(ty.name.buf[i] as i64)
                i = i + 1
            }
        }
        TyArray => {
            print("[")
            match ty.inner {
                Some(elem) => print_type_name(*elem)
                None => print("?")
            }
            if ty.array_size >= 0 {
                print("; ")
                print_int(ty.array_size)
            }
            print("]")
        }
        TyRef => {
            print("&")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyRefMut => {
            print("&!")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyTuple => {
            print("(")
            print_tuple_type_elems(ty.tuple_elems)
            print(")")
        }
        TyFn => {
            print("fn#")
            print_int(ty.fn_sig_id)
        }
        TyKnowledge => {
            print("Knowledge<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            if ty.knowledge_epsilon >= 0.0 {
                // Print epsilon as integer percentage for diagnostics
                // (no float printing in Poseidon VM)
                print(", eps=")
                let eps_pct = (ty.knowledge_epsilon * 1000.0) as i64
                print_int(eps_pct)
                print("/1000")
            }
            print(">")
        }
        TyHyper => {
            print("Hyper<")
            if ty.algebra_kind == 0 { print("Real") }
            else if ty.algebra_kind == 1 { print("Complex") }
            else if ty.algebra_kind == 2 { print("Quaternion") }
            else if ty.algebra_kind == 3 { print("Octonion") }
            else if ty.algebra_kind == 4 { print("Sedenion") }
            else if ty.algebra_kind == 5 {
                print("Clifford(")
                print_int(ty.clifford_p)
                print(",")
                print_int(ty.clifford_q)
                print(")")
            }
            else { print("?") }
            print(", ")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyNever => print("!")
        TyError => print("<error>")
        TyUnknown => print("<unknown>")
    }
}

fn print_tuple_type_elems(opt: Option<Box<TypeEntryList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            print_type_name((*list).head)
            match (*list).tail {
                Some(_) => {
                    print(", ")
                    print_tuple_type_elems((*list).tail)
                }
                None => {}
            }
        }
    }
}

// ============================================================
// Error reporting with diagnostics
// ============================================================

impl Checker {
    fn report_error(self) -> Checker with Mut {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        c
    }

    fn report_error_at(self, span: Span, code: i64, msg_a: i64, msg_b: i64, msg_c: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        print_error_message(code)
        print("\n")
        // Print help and note if available
        print_error_help(code)
        print_error_note(code)
        c
    }



    fn report_mismatch(self, span: Span, code: i64, expected: TypeEntry, got: TypeEntry) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        print_error_message(code)
        print("\n   |\n   = expected ")
        print_type_name(expected)
        print("\n   = found ")
        print_type_name(got)
        print("\n")
        // Print help and note for this error code
        print_error_help(code)
        print_error_note(code)
        c
    }



    fn report_effect_error(self, span: Span, missing: [i64; 8], missing_count: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E035]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": effect not declared in function signature (missing: ")
        var i: i64 = 0
        while i < missing_count {
            if i > 0 { print(", ") }
            print_effect_name(missing[i as usize])
            i = i + 1
        }
        print(")\n")
        c
    }

    fn check_callee_effects(self, span: Span, callee_effects: [i64; 8], callee_effect_count: i64) -> Checker with Mut, IO, Panic, Div {
        if callee_effect_count == 0 {
            return self
        }
        if effects_subset(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count) {
            return self
        }
        let missing_pair = find_missing_effects(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count)
        self.report_effect_error(span, missing_pair.0, missing_pair.1)
    }

    // --------------------------------------------------------
    // Security hardening: depth and complexity tracking
    // --------------------------------------------------------

    fn check_type_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.type_depth >= MAX_TYPE_DEPTH {
            c = c.report_error_at(span, 60, c.type_depth, MAX_TYPE_DEPTH, 0)
            return (c, false)
        }
        c.type_depth = c.type_depth + 1
        (c, true)
    }

    fn exit_type_depth(self) -> Checker with Mut {
        var c = self
        if c.type_depth > 0 {
            c.type_depth = c.type_depth - 1
        }
        c
    }

    fn check_expr_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.expr_depth >= MAX_EXPR_DEPTH {
            c = c.report_error_at(span, 61, c.expr_depth, MAX_EXPR_DEPTH, 0)
            return (c, false)
        }
        c.expr_depth = c.expr_depth + 1
        (c, true)
    }

    fn exit_expr_depth(self) -> Checker with Mut {
        var c = self
        if c.expr_depth > 0 {
            c.expr_depth = c.expr_depth - 1
        }
        c
    }

    fn check_loop_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.loop_depth >= MAX_LOOP_DEPTH {
            c = c.report_error_at(span, 62, c.loop_depth, MAX_LOOP_DEPTH, 0)
            return (c, false)
        }
        (c, true)
    }

    fn check_complexity(self, cost: i64, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.complexity_budget + cost > MAX_TYPE_COMPLEXITY {
            c = c.report_error_at(span, 64, c.complexity_budget, MAX_TYPE_COMPLEXITY, 0)
            return (c, false)
        }
        c.complexity_budget = c.complexity_budget + cost
        (c, true)
    }
}

fn print_error_message(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10)
    if code == 1 { print("this binding expects a different type") }
    else if code == 2 { print("cannot assign this value to the target") }
    else if code == 3 { print("cannot modify an immutable binding") }
    else if code == 4 { print("these types cannot be combined with this operator") }
    else if code == 5 { print("this unary operation is not defined for the type") }
    else if code == 6 { print("conditions must be of type `bool`") }
    else if code == 7 { print("branches have incompatible types") }
    else if code == 8 { print("return value does not match function's declared return type") }
    else if code == 9 { print("argument type does not match parameter") }
    else if code == 10 { print("wrong number of arguments in this call") }
    // Member access (11-16)
    else if code == 11 { print("no method named for this type") }
    else if code == 12 { print("this type has no field named") }
    else if code == 13 { print("indexing requires an array type") }
    else if code == 14 { print("array indices must be integers") }
    else if code == 15 { print("unknown struct type") }
    else if code == 16 { print("field initializer has wrong type") }
    // Callables/control flow (17-21)
    else if code == 17 { print("this expression cannot be called") }
    else if code == 18 { print("match arms have incompatible types") }
    else if code == 19 { print("method calls are not supported for this type") }
    else if code == 20 { print("array elements must all have the same type") }
    else if code == 21 { print("compound assignment requires compatible types") }
    // Epistemic (22)
    else if code == 22 { print("epsilon bound must be between 0.0 and 1.0") }
    // Hypercomplex (30-34)
    else if code == 30 { print("cannot combine values from different hypercomplex algebras") }
    else if code == 31 { print("division requires the `Div` effect") }
    else if code == 32 { print("this algebra does not support division") }
    else if code == 33 { print("Clifford algebras have different signatures") }
    else if code == 34 { print("cannot narrow hypercomplex algebra") }
    // Effects (35)
    else if code == 35 { print("function uses effects not declared in its signature") }
    // Epistemic propagation (36)
    else if code == 36 { print("confidence bound is not tight enough") }
    // Borrow checker (37-40)
    else if code == 37 { print("cannot borrow sharedly while exclusive borrow is active") }
    else if code == 38 { print("cannot borrow exclusively while other borrows are active") }
    else if code == 39 { print("linear value has already been used") }
    else if code == 40 { print("linear value must be used") }
    // Units/refinement (41-43)
    else if code == 41 { print("units are incompatible in this operation") }
    else if code == 42 { print("value does not satisfy the refinement predicate") }
    else if code == 43 { print("incompatible unit dimensions in conversion") }
    // Phase A additions (44-51)
    else if code == 44 { print("`break` can only be used inside a loop") }
    else if code == 45 { print("`continue` can only be used inside a loop") }
    else if code == 46 { print("struct literal has wrong number of fields") }
    else if code == 47 { print("tuple index is out of bounds") }
    else if code == 48 { print("bitwise operations require integer types") }
    else if code == 49 { print("shift operations require integer types") }
    else if code == 50 { print("modulo requires integer types") }
    else if code == 51 { print("logical operations require boolean types") }
    // Phase B.3 additions (52-54)
    else if code == 52 { print("cannot prove refinement requirement at this call site") }
    else if code == 53 { print("closure may use undeclared effects") }
    else if code == 54 { print("invalid Knowledge metadata constraint") }
    else if code == 60 { print("type nesting exceeds maximum depth") }
    else if code == 61 { print("expression nesting exceeds maximum depth") }
    else if code == 62 { print("loop nesting exceeds maximum depth") }
    else if code == 64 { print("type complexity budget exceeded") }
    else { print("unknown error") }
}

// Print help text for error codes (actionable fix suggestions)
fn print_error_help(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10) - top 10 most common errors
    if code == 1 {
        print("   |\n   = help: the variable declaration and assigned value have incompatible types\n")
    }
    else if code == 2 {
        print("   |\n   = help: ensure the value type matches the target type for this assignment\n")
    }
    else if code == 3 {
        print("   |\n   = help: declare the variable with `var` instead of `let` to allow mutation\n")
    }
    else if code == 4 {
        print("   |\n   = help: use explicit type conversion with `as` if the types are compatible\n")
    }
    else if code == 5 {
        print("   |\n   = help: check that the operator is valid for this type (e.g., `-x` for numbers, `!x` for bools)\n")
    }
    else if code == 6 {
        print("   |\n   = help: use a comparison operator (e.g., `==`, `!=`, `<`, `>`) to produce a boolean\n")
    }
    else if code == 7 {
        print("   |\n   = help: ensure both branches return the same type, or use explicit conversion\n")
    }
    else if code == 8 {
        print("   |\n   = help: change the return value type to match the function's declared return type\n")
    }
    else if code == 9 {
        print("   |\n   = help: check the function signature and provide an argument of the correct type\n")
    }
    else if code == 10 {
        print("   |\n   = help: check the function signature for the correct number of arguments\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   |\n   = help: check the method name and ensure it is defined for this type\n")
    }
    else if code == 12 {
        print("   |\n   = help: check the field name in the type definition\n")
    }
    else if code == 13 {
        print("   |\n   = help: use square brackets `[]` only on array types\n")
    }
    else if code == 14 {
        print("   |\n   = help: use an integer type (i8, i32, i64, u8, u32, u64) for array indices\n")
    }
    else if code == 15 {
        print("   |\n   = help: ensure the struct is defined or imported in this module\n")
    }
    else if code == 16 {
        print("   |\n   = help: ensure the field initializer matches the declared field type\n")
    }
    // Callables/control flow (17-21)
    else if code == 17 {
        print("   |\n   = help: only functions and methods can be called with parentheses\n")
    }
    else if code == 18 {
        print("   |\n   = help: all match arms must return the same type\n")
    }
    else if code == 19 {
        print("   |\n   = help: method calls using `.` syntax are only supported on structs and built-in types\n")
    }
    else if code == 20 {
        print("   |\n   = help: arrays require all elements to have the same type; consider using a tuple for mixed types\n")
    }
    else if code == 21 {
        print("   |\n   = help: compound assignments like `+=` require the operands to be compatible\n")
    }
    // Epistemic (22)
    else if code == 22 {
        print("   |\n   = help: epsilon must be a value between 0.0 (certain) and 1.0 (unknown)\n")
    }
    // Hypercomplex (30-34)
    else if code == 30 {
        print("   |\n   = help: values from different hypercomplex algebras cannot be combined directly\n")
    }
    else if code == 31 {
        print("   |\n   = help: add `with Div` to the function signature to enable division\n")
    }
    else if code == 32 {
        print("   |\n   = help: octonions, sedenions, and clifford algebras do not support division\n")
    }
    else if code == 33 {
        print("   |\n   = help: clifford algebras must have the same (p,q) signature to be combined\n")
    }
    else if code == 34 {
        print("   |\n   = help: hypercomplex algebras cannot be narrowed to a lower-dimensional algebra\n")
    }
    // Effects (35)
    else if code == 35 {
        print("   |\n   = help: add the missing effect to the function's `with` clause\n")
    }
    // Epistemic propagation (36)
    else if code == 36 {
        print("   |\n   = help: tighten the epsilon bound or use a more precise measurement\n")
    }
    // Borrow checker (37-40)
    else if code == 37 {
        print("   |\n   = help: shared borrows (`&x`) cannot coexist with exclusive borrows (`&!x`)\n")
    }
    else if code == 38 {
        print("   |\n   = help: drop other borrows before acquiring an exclusive borrow (`&!x`)\n")
    }
    else if code == 39 {
        print("   |\n   = help: linear values can only be used once; clone the value if needed\n")
    }
    else if code == 40 {
        print("   |\n   = help: consume the linear value by using it in a function call or assignment\n")
    }
    // Units/refinement (41-43)
    else if code == 41 {
        print("   |\n   = help: convert units before combining values in arithmetic operations\n")
    }
    else if code == 42 {
        print("   |\n   = help: the value violates the refinement type constraint\n")
    }
    else if code == 43 {
        print("   |\n   = help: unit conversions require compatible dimensions (e.g., meters to kilometers)\n")
    }
    // Phase A additions (44-51)
    else if code == 44 {
        print("   |\n   = help: move `break` inside a `while` or `loop` block\n")
    }
    else if code == 45 {
        print("   |\n   = help: move `continue` inside a `while` or `loop` block\n")
    }
    else if code == 46 {
        print("   |\n   = help: provide values for all fields declared in the struct definition\n")
    }
    else if code == 47 {
        print("   |\n   = help: tuple indices must be within the tuple's element count\n")
    }
    else if code == 48 {
        print("   |\n   = help: bitwise operators (`&`, `|`, `^`) require integer operands\n")
    }
    else if code == 49 {
        print("   |\n   = help: shift operators (`<<`, `>>`) require integer operands\n")
    }
    else if code == 50 {
        print("   |\n   = help: modulo operator (`%`) requires integer operands\n")
    }
    else if code == 51 {
        print("   |\n   = help: logical operators (`&&`, `||`) require boolean operands\n")
    }
    // Phase B.3 additions (52-54)
    else if code == 52 {
        print("   |\n   = help: provide a value that satisfies the refinement predicate\n")
    }
    else if code == 53 {
        print("   |\n   = help: add the required effect to the closure's signature\n")
    }
    else if code == 54 {
        print("   |\n   = help: check the Knowledge metadata for valid constraint syntax\n")
    }
    else {
        // No help available for unknown errors
    }
}

// Print note text for error codes (additional context)
fn print_error_note(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10)
    if code == 1 {
        print("   = note: Sounio requires explicit type conversions—use `as` to convert between compatible types\n")
    }
    else if code == 2 {
        print("   = note: assignment requires type compatibility; consider using an explicit cast or conversion\n")
    }
    else if code == 3 {
        print("   = note: `let` bindings are immutable by default; use `var` for mutable variables\n")
    }
    else if code == 4 {
        print("   = note: binary operators require operands of compatible types\n")
    }
    else if code == 5 {
        print("   = note: unary operators are type-specific (e.g., `-` for numbers, `!` for bools, `&`/`&!` for borrows)\n")
    }
    else if code == 6 {
        print("   = note: condition expressions must evaluate to a boolean value\n")
    }
    else if code == 7 {
        print("   = note: the type of an if-expression is determined by its branches\n")
    }
    else if code == 8 {
        print("   = note: the return type is declared in the function signature\n")
    }
    else if code == 9 {
        print("   = note: function arguments are checked against the declared parameter types\n")
    }
    else if code == 10 {
        print("   = note: argument count must match the function's parameter list\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   = note: methods are resolved based on the type of the receiver\n")
    }
    else if code == 12 {
        print("   = note: field names must match the struct definition exactly\n")
    }
    else if code == 13 {
        print("   = note: arrays are indexed with square brackets using integer indices\n")
    }
    else if code == 14 {
        print("   = note: array indexing requires an integer type\n")
    }
    else if code == 15 {
        print("   = note: struct types must be defined before use\n")
    }
    else if code == 16 {
        print("   = note: struct field initializers must match the field's declared type\n")
    }
    // Callables/control flow (17-21)
    else if code == 17 {
        print("   = note: call expressions require a function or callable value\n")
    }
    else if code == 18 {
        print("   = note: match expressions require all arms to have the same type\n")
    }
    else if code == 19 {
        print("   = note: method call syntax (`.method()`) is only valid for certain types\n")
    }
    else if code == 20 {
        print("   = note: arrays are homogeneous—all elements must have the same type\n")
    }
    else if code == 21 {
        print("   = note: compound assignment operators require type compatibility\n")
    }
    // Epistemic (22)
    else if code == 22 {
        print("   = note: epsilon bounds represent confidence levels (0.0 = certain, 1.0 = unknown)\n")
    }
    // Hypercomplex (30-34)
    else if code == 30 {
        print("   = note: hypercomplex algebras (Real, Complex, Quaternion, etc.) are distinct type families\n")
    }
    else if code == 31 {
        print("   = note: division is an effect that must be declared in the function signature\n")
    }
    else if code == 32 {
        print("   = note: division is only supported for Real, Complex, and Quaternion algebras\n")
    }
    else if code == 33 {
        print("   = note: clifford algebra signatures (p,q) define the algebra's properties\n")
    }
    else if code == 34 {
        print("   = note: narrowing would lose information about the hypercomplex structure\n")
    }
    // Effects (35)
    else if code == 35 {
        print("   = note: effects must be explicitly declared in function signatures\n")
    }
    // Epistemic propagation (36)
    else if code == 36 {
        print("   = note: epistemic values carry confidence bounds that must be preserved\n")
    }
    // Borrow checker (37-40)
    else if code == 37 {
        print("   = note: shared borrows (`&T`) allow multiple readers; exclusive borrows (`&!T`) allow one writer\n")
    }
    else if code == 38 {
        print("   = note: exclusive borrows require exclusive access to the value\n")
    }
    else if code == 39 {
        print("   = note: linear types enforce single-use semantics for resources\n")
    }
    else if code == 40 {
        print("   = note: linear types must be consumed exactly once\n")
    }
    // Units/refinement (41-43)
    else if code == 41 {
        print("   = note: unit dimensions must match for addition and subtraction\n")
    }
    else if code == 42 {
        print("   = note: refinement types constrain values to satisfy predicates\n")
    }
    else if code == 43 {
        print("   = note: unit conversions preserve dimensionality (e.g., length to length)\n")
    }
    // Phase A additions (44-51)
    else if code == 44 {
        print("   = note: `break` terminates the nearest enclosing loop\n")
    }
    else if code == 45 {
        print("   = note: `continue` skips to the next iteration of the nearest enclosing loop\n")
    }
    else if code == 46 {
        print("   = note: struct literals must initialize all declared fields\n")
    }
    else if code == 47 {
        print("   = note: tuple indices are 0-based and must be within bounds\n")
    }
    else if code == 48 {
        print("   = note: bitwise operations work on integer representations\n")
    }
    else if code == 49 {
        print("   = note: shift operations move bits left or right in the integer representation\n")
    }
    else if code == 50 {
        print("   = note: modulo returns the remainder of integer division\n")
    }
    else if code == 51 {
        print("   = note: logical operations combine boolean values\n")
    }
    // Phase B.3 additions (52-54)
    else if code == 52 {
        print("   = note: refinement types are checked at call boundaries\n")
    }
    else if code == 53 {
        print("   = note: closures inherit effect requirements from their body\n")
    }
    else if code == 54 {
        print("   = note: Knowledge metadata constrains epistemic values\n")
    }
    else {
        // No note available for unknown errors
    }
}

// ============================================================
// Borrow checking helpers
// ============================================================

// Extract variable name from unary operand (if it's a simple ident)
fn unary_operand_name(opt: Option<Box<Expr>>) -> Name {
    match opt {
        Some(inner) => {
            if (*inner).kind == ExprKind::ExprIdent {
                (*inner).name
            } else {
                Name { buf: [0; 128], len: 0 }
            }
        }
        None => Name { buf: [0; 128], len: 0 }
    }
}

fn call_ref_inner_or_self(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyRef || ty.kind == TypeKind::TyRefMut {
        match ty.inner {
            Some(inner) => *inner
            None => ty_error()
        }
    } else {
        ty
    }
}

fn call_arg_types_compatible(arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if types_compatible(arg_ty, param_ty) {
        return true
    }
    // Directional borrow boundary: &!T can flow to &T.
    if param_ty.kind == TypeKind::TyRef && arg_ty.kind == TypeKind::TyRefMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    // Allow implicit borrow syntax at call boundaries: f(&T) <- x
    if arg_expr.kind == ExprKind::ExprIdent &&
       (param_ty.kind == TypeKind::TyRef || param_ty.kind == TypeKind::TyRefMut) {
        return types_compatible(arg_ty, call_ref_inner_or_self(param_ty))
    }
    false
}

// ============================================================
// Lower AST TypeExpr to internal TypeEntry
// ============================================================

impl Checker {
    fn lower_type_expr(self, te: TypeExpr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check type depth limit
        let depth_pair = self.check_type_depth(te.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        // Check complexity budget (cost = 1 for each type node)
        let complexity_pair = c.check_complexity(1, te.span)
        c = complexity_pair.0
        if !complexity_pair.1 {
            return (c.exit_type_depth(), ty_error())
        }
        let result = match te.kind {
            TypeNamed => c.lower_named_type(te.path)
            TypeUnit => (c, ty_unit())
            TypeNever => (c, ty_never())
            TypeInfer => (c, ty_unknown())
            TypeSelfUpper => (c, c.current_impl_type)
            TypeReference => c.lower_ref_type(te.inner)
            TypeRefMut => c.lower_ref_mut_type(te.inner)
            TypeArray => c.lower_array_type(te.inner, te.array_size)
            TypeTuple => c.lower_tuple_type(te.type_args)
            TypeFn => (c, ty_unknown())
            TypeKnowledge => c.lower_knowledge_type(te.knowledge_info)
            TypeRefinement => c.lower_refinement_type(te.refinement_info)
        }
        (result.0.exit_type_depth(), result.1)
    }

    fn lower_named_type(self, path: AstPath) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let name = copy_string_list_to_name(path.segments)
        if name_is_i8(name) {
            (self, ty_i8())
        } else if name_is_i32(name) {
            (self, ty_i32())
        } else if name_is_i64(name) {
            (self, ty_i64())
        } else if name_is_u8(name) {
            (self, ty_u8())
        } else if name_is_u32(name) {
            (self, ty_u32())
        } else if name_is_u64(name) {
            (self, ty_u64())
        } else if name_is_f32(name) {
            (self, ty_f32())
        } else if name_is_f64(name) {
            (self, ty_f64())
        } else if name_is_bool(name) {
            (self, ty_bool())
        } else if name_is_string(name) {
            (self, ty_string())
        } else if name_is_char(name) {
            (self, ty_char())
        } else {
            // Check if it's a registered unit name (mg, kg, m, s, etc.)
            let unit_idx = self.units.find(name)
            if unit_idx >= 0 {
                // Units resolve to f64 with a unit_id annotation
                (self, ty_with_unit(ty_f64(), unit_idx))
            } else {
                // Check if it's a refinement type alias
                let ref_idx = refinement_table_find(self.refinements, name)
                if ref_idx >= 0 {
                    // Resolve to base type with refinement_id annotation
                    let rt = self.refinements.entries[ref_idx as usize]
                    (self, ty_with_refinement(rt.base_type, ref_idx))
                } else {
                    (self, ty_named(name))
                }
            }
        }
    }

    fn lower_ref_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let inner_ty = pair.1
                (c, ty_ref(inner_ty))
            }
            None => (self, ty_error())
        }
    }

    fn lower_ref_mut_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let inner_ty = pair.1
                (c, ty_ref_mut(inner_ty))
            }
            None => (self, ty_error())
        }
    }

    fn lower_array_type(self, inner_opt: Option<Box<TypeExpr>>, size_opt: Option<Box<Expr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let elem_ty = pair.1
                let size = lower_array_size(size_opt)
                (c, ty_array(elem_ty, size))
            }
            None => (self, ty_error())
        }
    }

    fn lower_tuple_type(self, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tel) => {
                let pair = self.lower_type_expr_list(*tel)
                (pair.0, ty_tuple(pair.1))
            }
            None => (self, ty_unit())
        }
    }

    fn lower_type_expr_list(self, tel: TypeExprList) -> (Checker, TypeEntryList) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(tel.head)
        var c = pair.0
        let head_ty = pair.1
        let head_entry = TypeEntryList { head: head_ty, tail: None }
        match tel.tail {
            None => (c, head_entry)
            Some(rest) => {
                let pair2 = c.lower_type_expr_list(*rest)
                c = pair2.0
                let rest_list = pair2.1
                (c, TypeEntryList { head: head_ty, tail: Some(Box::new(rest_list)) })
            }
        }
    }

    fn lower_opt_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    fn lower_knowledge_type(self, opt: Option<Box<KnowledgeTypeInfo>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_knowledge_type(self, *info)
            None => (self, ty_error())
        }
    }

    fn lower_refinement_type(self, opt: Option<Box<RefinementInfo>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => {
                let ri = *info
                // Lower the base type
                match ri.base_type {
                    Some(bte) => {
                        let pair = self.lower_type_expr(*bte)
                        (pair.0, pair.1)
                    }
                    None => (self, ty_error())
                }
            }
            None => (self, ty_error())
        }
    }
}

fn lower_array_size(opt: Option<Box<Expr>>) -> i64 {
    match opt {
        Some(e) => (*e).int_val
        None => -1
    }
}

// ============================================================
// Pass 1: Collect top-level declarations
// ============================================================

impl Checker {
    fn collect_items(self, items: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var c = self.collect_item((*list).head)
                c.collect_items((*list).tail)
            }
            None => self
        }
    }

    fn collect_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.collect_fn_def(item.name, item.fn_def)
            ItemStruct => self.collect_struct_def(item.name, item.struct_def)
            ItemEnum => self.collect_enum_def(item.name, item.enum_def)
            ItemImpl => self.collect_impl_def(item.impl_def)
            ItemTypeAlias => self.collect_type_alias(item.name, item.type_alias_ty)
            ItemUse => self
            ItemUnit => self.collect_unit_decl(item.name)
        }
    }

    fn collect_type_alias(self, name: Name, ty_opt: Option<Box<TypeExpr>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match ty_opt {
            Some(te_box) => {
                let te = *te_box
                if te.kind == TypeExprKind::TypeRefinement {
                    // Register refinement type: type Pos = { x: i64 | x > 0 }
                    match te.refinement_info {
                        Some(ri_box) => {
                            let ri = *ri_box
                            // Lower base type
                            let pair = match ri.base_type {
                                Some(bte) => self.lower_type_expr(*bte)
                                None => (self, ty_error())
                            }
                            var c = pair.0
                            let base_ty = pair.1
                            // Build predicate from parsed op + value
                            let pred = if ri.pred_is_float {
                                pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
                            } else {
                                pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
                            }
                            let rt = RefinementType {
                                base_type: base_ty,
                                var_name: ri.var_name,
                                predicate: pred,
                            }
                            c.refinements = refinement_table_add(c.refinements, name, rt)
                            c
                        }
                        None => self
                    }
                } else {
                    // Plain type alias — no refinement, pass through
                    self
                }
            }
            None => self
        }
    }

    fn collect_unit_decl(self, name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Register user-defined unit as a mass-like dimension (f64 base)
        // For now, user-defined units get a generic dimension
        c.units = c.units.register(name, unit_dim_dimensionless())
        c
    }

    // --------------------------------------------------------
    // Collect function signature
    // --------------------------------------------------------

    fn collect_fn_def(self, name: Name, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let pair = self.collect_fn_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from function signature
                let eff_pair = extract_effects((*fd).effects)
                let fn_effects = eff_pair.0
                let fn_effect_count = eff_pair.1

                let sig = FnSig {
                    name: name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: false,
                    self_type_name: Name { buf: [0; 128], len: 0 },
                    effects: fn_effects,
                    effect_count: fn_effect_count,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                let sig_id = add_result.1
                c.env = c.env.bind(name, ty_fn(sig_id), false)
                c
            }
            None => self
        }
    }

    fn collect_fn_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_fn_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_fn_param_list(self, pl: ParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_fn_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn lower_opt_return_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    // --------------------------------------------------------
    // Collect struct definition
    // --------------------------------------------------------

    fn collect_struct_def(self, name: Name, opt: Option<Box<StructDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => {
                let pair = self.collect_field_defs((*sd).fields)
                var c = pair.0
                let fields = pair.1
                let field_count = pair.2
                let info = StructInfo {
                    name: name,
                    fields: fields,
                    field_count: field_count,
                    is_linear: (*sd).is_linear,
                }
                c.structs = c.structs.add(info)
                c
            }
            None => self
        }
    }

    fn collect_field_defs(self, opt: Option<Box<FieldDefList>>) -> (Checker, Option<Box<FieldInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fdl) => {
                let pair = self.collect_field_def_list(*fdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_field_def_list(self, fdl: FieldDefList) -> (Checker, FieldInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(fdl.head.ty)
        var c = pair.0
        let field_ty = pair.1
        let head_info = FieldInfo { name: fdl.head.name, ty: field_ty }
        let head_list = FieldInfoList { head: head_info, tail: None }
        match fdl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_field_def_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FieldInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect enum definition
    // --------------------------------------------------------

    fn collect_enum_def(self, name: Name, opt: Option<Box<EnumDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ed) => {
                let pair = self.collect_variants((*ed).variants)
                var c = pair.0
                let variants = pair.1
                let variant_count = pair.2
                let info = EnumInfo {
                    name: name,
                    variants: variants,
                    variant_count: variant_count,
                }
                c.enums = c.enums.add(info)
                c
            }
            None => self
        }
    }

    fn collect_variants(self, opt: Option<Box<VariantDefList>>) -> (Checker, Option<Box<VariantInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vdl) => {
                let pair = self.collect_variant_list(*vdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_variant_list(self, vdl: VariantDefList) -> (Checker, VariantInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let head_info = VariantInfo { name: vdl.head.name }
        let head_list = VariantInfoList { head: head_info, tail: None }
        match vdl.tail {
            None => (self, head_list, 1)
            Some(rest) => {
                let rest_result = self.collect_variant_list(*rest)
                let c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, VariantInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect impl methods
    // --------------------------------------------------------

    fn collect_impl_def(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.collect_impl_methods((*id).methods, impl_ty.name)
                c
            }
            None => self
        }
    }

    fn collect_impl_methods(self, opt: Option<Box<ItemList>>, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.collect_impl_method((*list).head, type_name)
                c.collect_impl_methods((*list).tail, type_name)
            }
            None => self
        }
    }

    fn collect_impl_method(self, item: Item, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                let pair = self.collect_method_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from method signature
                let eff_pair = extract_effects((*fd).effects)
                let fn_effects = eff_pair.0
                let fn_effect_count = eff_pair.1

                let sig = FnSig {
                    name: item.name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: true,
                    self_type_name: type_name,
                    effects: fn_effects,
                    effect_count: fn_effect_count,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_method_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                // Skip self param for method signatures
                if (*pl).head.is_self {
                    self.collect_fn_params((*pl).tail)
                } else {
                    let pair = self.collect_fn_param_list(*pl)
                    (pair.0, Some(Box::new(pair.1)), pair.2)
                }
            }
            None => (self, None, 0)
        }
    }
}

// ============================================================
// Pass 2: Check all items
// ============================================================

impl Checker {
    fn check_items(self, items: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var c = self.check_item((*list).head)
                c.check_items((*list).tail)
            }
            None => self
        }
    }

    fn check_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.check_fn_item(item.fn_def)
            ItemStruct => self
            ItemEnum => self
            ItemImpl => self.check_impl_item(item.impl_def)
            ItemTypeAlias => self
            ItemUse => self
            ItemUnit => self  // Already handled in collect pass
        }
    }

    // --------------------------------------------------------
    // Check function definition
    // --------------------------------------------------------

    fn check_fn_item(self, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let sig_id = c.fn_sigs.find((*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                // Check return type compatibility
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c
            }
            None => self
        }
    }

    fn bind_fn_params(self, opt: Option<Box<ParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_fn_param((*pl).head)
                c.bind_fn_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_fn_param(self, p: Param) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        if p.is_self {
            c.env = c.env.bind(p.name, c.current_impl_type, p.is_self_mut)
            // Track self parameter for borrow checking
            let self_linear = c.is_linear_type(c.current_impl_type)
            c.borrows = c.borrows.track(p.name, self_linear)
            c
        } else {
            let pair = c.lower_type_expr(p.ty)
            c = pair.0
            let param_ty = pair.1
            c.env = c.env.bind(p.name, param_ty, false)
            // Track parameter for borrow checking (linear if struct is declared linear)
            let lin = c.is_linear_type(param_ty)
            c.borrows = c.borrows.track(p.name, lin)
            c
        }
    }

    // --------------------------------------------------------
    // Check impl definition
    // --------------------------------------------------------

    fn check_impl_item(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.check_impl_methods((*id).methods)
                c.current_impl_type = ty_error()
                c
            }
            None => self
        }
    }

    fn check_impl_methods(self, opt: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.check_impl_method((*list).head)
                c.check_impl_methods((*list).tail)
            }
            None => self
        }
    }

    fn check_impl_method(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let sig_id = c.fn_sigs.find_method(c.current_impl_type.name, (*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement checking
// ============================================================

impl Checker {
    fn check_block(self, blk: Block) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        let pair = c.check_stmts(blk.stmts)
        c = pair.0
        let result_ty = pair.1
        // Check that all linear variables in this scope have been consumed
        let linear_check = c.borrows.check_linear_consumed()
        c.borrows = linear_check.0
        if linear_check.1 > 0 {
            c.had_error = true
            c.error_count = c.error_count + 1
            print("error[E040]: linear value not consumed (")
            print_int(linear_check.1)
            print(" unconsumed)\n")
        }
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, result_ty)
    }

    fn check_stmts(self, opt: Option<Box<StmtList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_stmt((*list).head)
                var c = pair.0
                let stmt_ty = pair.1
                match (*list).tail {
                    Some(_) => c.check_stmts((*list).tail)
                    None => (c, stmt_ty)
                }
            }
            None => (self, ty_unit())
        }
    }

    fn check_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtLet => self.check_let_stmt(s)
            StmtVar => self.check_var_stmt(s)
            StmtExpr => self.check_expr_stmt(s)
            StmtAssign => self.check_assign_stmt(s)
        }
    }

    fn check_let_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_opt_expr(s.expr)
        c = init_pair.0
        let init_ty = init_pair.1
        // Determine binding type: annotation if present, else init type
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(init_ty, ann_ty) {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            bind_ty = ann_ty
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let cur_env = c.env
        c.env = cur_env.bind(s.name, bind_ty, false)
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_var_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_opt_expr(s.expr)
        c = init_pair.0
        let init_ty = init_pair.1
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(init_ty, ann_ty) {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            bind_ty = ann_ty
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        c.env = c.env.bind(s.name, bind_ty, true)
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_refinement_literal(self, span: Span, ty: TypeEntry) -> Checker with Mut, Panic, Div {
        if ty.refinement_id < 0 || ty.refinement_id >= 128 { return self }
        let rt = self.refinements.entries[ty.refinement_id as usize]
        var c = self
        if c.last_literal_kind == 1 {
            // Integer literal — check predicate
            if !pred_check_int(rt.predicate, c.last_literal_int) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        } else if c.last_literal_kind == 2 {
            // Float literal — check predicate
            if !pred_check_float(rt.predicate, c.last_literal_float) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        }
        // Reset literal tracking
        c.last_literal_kind = 0
        c
    }

    fn is_linear_type(self, ty: TypeEntry) -> bool with Mut, Panic, Div {
        if ty.kind == TypeKind::TyNamed {
            let idx = self.structs.find(ty.name)
            if idx >= 0 {
                return self.structs.entries[idx].is_linear
            }
        }
        false
    }

    fn check_expr_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_expr(s.expr)
    }

    fn check_assign_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let target_pair = c.check_opt_expr(s.target)
        c = target_pair.0
        let target_ty = target_pair.1
        let val_pair = c.check_opt_expr(s.expr)
        c = val_pair.0
        let val_ty = val_pair.1
        // Compound assignments (+=, -=, etc.) require numeric operands
        if s.assign_op != AssignOp::AssignEq {
            if !is_error_or_unknown(target_ty) && !is_error_or_unknown(val_ty) {
                let compound_result = binary_result_type(compound_assign_to_binop(s.assign_op), target_ty, val_ty)
                if compound_result.kind == TypeKind::TyError {
                    c = c.report_mismatch(s.span, 21, target_ty, val_ty)
                }
            }
        } else {
            // Simple assignment: check compatibility
            if !types_compatible(target_ty, val_ty) {
                c = c.report_mismatch(s.span, 2, target_ty, val_ty)
            }
        }
        // Check mutability: if target is an ident, it must be mutable
        c = c.check_assign_mutability(s.target, s.span)
        (c, ty_unit())
    }

    fn check_assign_mutability(self, opt: Option<Box<Expr>>, span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprIdent {
                    if !self.env.lookup_is_mutable((*e).name) {
                        self.report_error_at(span, 3, 0, 0, 0)
                    } else {
                        self
                    }
                } else {
                    // Field access, index — assume mutable for now
                    self
                }
            }
            None => self
        }
    }

    fn check_opt_expr(self, opt: Option<Box<Expr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.check_expr(*e)
            None => (self, ty_unit())
        }
    }
}

// ============================================================
// Expression type checking — dispatch
// ============================================================

impl Checker {
    fn check_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check expression depth limit
        let depth_pair = self.check_expr_depth(e.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        let result = match e.kind {
            ExprIntLit => {
                c.last_literal_int = e.int_val
                c.last_literal_kind = 1
                (c, ty_i64())
            }
            ExprFloatLit => {
                c.last_literal_float = e.float_val
                c.last_literal_kind = 2
                (c, ty_f64())
            }
            ExprBoolTrue => (c, ty_bool())
            ExprBoolFalse => (c, ty_bool())
            ExprStringLit => (c, ty_string())
            ExprCharLit => (c, ty_char())
            ExprIdent => {
                let ident_ty = c.env.lookup(e.name)
                // If this is a linear type variable, mark it as consumed
                var c2 = c
                if c2.is_linear_type(ident_ty) && c2.suppress_linear_consume_depth == 0 {
                    // CRITICAL FIX: Check if borrowed before consuming
                    if c2.borrows.is_borrowed(e.name) {
                        c2 = c2.report_error_at(e.span, 38, 0, 0, 0)  // Cannot consume borrowed value
                    } else {
                        let consume_result = c2.borrows.consume_linear(e.name)
                        c2.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c2 = c2.report_error_at(e.span, consume_result.1, 0, 0, 0)
                        }
                    }
                }
                (c2, ident_ty)
            }
            ExprPath => c.check_path_expr(e)
            ExprBinary => c.check_binary_expr(e)
            ExprUnary => c.check_unary_expr(e)
            ExprFieldAccess => c.check_field_access(e)
            ExprIndex => c.check_index_expr(e)
            ExprMethodCall => c.check_method_call(e)
            ExprCall => c.check_call_expr(e)
            ExprIf => c.check_if_expr(e)
            ExprMatch => c.check_match_expr(e)
            ExprWhile => c.check_while_expr(e)
            ExprLoop => c.check_loop_expr(e)
            ExprBlock => c.check_block_expr(e)
            ExprReturn => c.check_return_expr(e)
            ExprBreak => c.check_break_expr(e)
            ExprContinue => c.check_continue_expr(e)
            ExprStructLit => c.check_struct_lit(e)
            ExprArrayLit => c.check_array_lit(e)
            ExprTupleLit => c.check_tuple_lit(e)
            ExprRange => c.check_range_expr(e)
            ExprCast => c.check_cast_expr(e)
            ExprHandle => c.check_handle_expr(e)
            ExprClosure => c.check_closure_expr(e)
            ExprError => (c, ty_error())
        }
        (result.0.exit_expr_depth(), result.1)
    }

    // --------------------------------------------------------
    // Path expression — enum variant
    // --------------------------------------------------------

    fn check_path_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // First segment is enum/type name, last is variant
        // For now, look up first segment as enum name
        let first_name = copy_string_list_to_name(e.path.segments)
        let enum_idx = self.enums.find(first_name)
        if enum_idx >= 0 {
            (self, ty_named(first_name))
        } else {
            // Could be a variant name directly (e.g. None, Some)
            let variant_enum_idx = self.enums.find_variant_enum(first_name)
            if variant_enum_idx >= 0 {
                let ei = self.enums.get(variant_enum_idx)
                (self, ty_named(ei.name))
            } else {
                // Look up in env as a regular binding
                (self, self.env.lookup(first_name))
            }
        }
    }

    // --------------------------------------------------------
    // Binary expression
    // --------------------------------------------------------

    fn check_binary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1

        // Validate binary operator type constraints
        c = c.check_binary_op_types(e.span, e.bin_op, left_ty, right_ty)

        // Epsilon propagation for Knowledge types
        // If either operand is Knowledge<T, epsilon>, propagate epsilon bounds
        if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
            let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty)
            if knowledge_result.kind == TypeKind::TyError {
                c = c.report_error_at(e.span, 36, 0, 0, 0)
            }
            // Continue with normal checking for inner type compatibility
            // The knowledge_binary_result handles epsilon propagation
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, knowledge_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            return (c, final_result)
        }

        let result = binary_result_type(e.bin_op, left_ty, right_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
            c = c.report_mismatch(e.span, 4, left_ty, right_ty)
        }
        // Unit checking for arithmetic on unit-typed values
        let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, result)
        c = result_with_units.0
        let final_result = result_with_units.1
        (c, final_result)
    }

    fn check_binary_op_types(self, span: Span, op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        if is_error_or_unknown(left_ty) || is_error_or_unknown(right_ty) {
            return self
        }
        match op {
            OpBitAnd => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitOr => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitXor => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpShl => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpShr => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpRem => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 50, 0, 0, 0)
                }
                self
            }
            OpAnd => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            OpOr => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            _ => self
        }
    }

    fn check_binary_units(self, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry, result: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let lu = left.unit_id
        let ru = right.unit_id
        // If neither side has units, nothing to check
        if lu < 0 && ru < 0 {
            return (c, result)
        }
        match op {
            // Addition/subtraction: units must match exactly
            OpAdd => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            OpSub => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            // Multiplication: combine unit dimensions
            OpMul => {
                if lu >= 0 && ru >= 0 {
                    // Both have units — product gets combined dimensions
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let prod = unit_dim_mul(ld, rd)
                    // For now, result is f64 with no named unit (product unit)
                    // A future pass could register the product unit
                    (c, result)
                } else {
                    // One side has units, other is scalar — keep the unit
                    let uid = if lu >= 0 { lu } else { ru }
                    (c, ty_with_unit(result, uid))
                }
            }
            // Division: combine unit dimensions
            OpDiv => {
                if lu >= 0 && ru >= 0 {
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let quot = unit_dim_div(ld, rd)
                    if unit_dim_is_dimensionless(quot) {
                        // Units cancel out — result is dimensionless
                        (c, result)
                    } else {
                        // Quotient has dimensions — result is f64 (unnamed unit)
                        (c, result)
                    }
                } else if lu >= 0 {
                    // numerator has units, denominator is scalar — keep unit
                    (c, ty_with_unit(result, lu))
                } else {
                    // numerator is scalar, denominator has units — inverse unit
                    (c, result)
                }
            }
            // Comparison operators: units must match
            OpEq => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpNe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            // Other operators: pass through
            _ => (c, result)
        }
    }

    fn report_unit_mismatch(self, span: Span, left_uid: i64, right_uid: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.had_error = true
        c.error_count = c.error_count + 1
        print("error[E041]: unit mismatch in arithmetic operation\n")
        print("  left unit: ")
        if left_uid >= 0 {
            print_unit_dim(c.units.get_dim(left_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n  right unit: ")
        if right_uid >= 0 {
            print_unit_dim(c.units.get_dim(right_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n")
        c
    }

    // --------------------------------------------------------
    // Unary expression
    // --------------------------------------------------------

    fn check_unary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let operand_ty = pair.1
        let result = unary_result_type(e.un_op, operand_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
            c = c.report_error_at(e.span, 5, 0, 0, 0)
        }
        // Borrow checking: if this is &x or &!x on a named variable
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            let borrow_name = unary_operand_name(e.left)
            if borrow_name.len > 0 {
                if e.un_op == UnaryOp::OpRef {
                    let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                } else {
                    let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                }
            }
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Field access
    // --------------------------------------------------------

    fn check_field_access(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let base_ty = pair.1
        if base_ty.kind == TypeKind::TyNamed {
            let struct_idx = c.structs.find(base_ty.name)
            if struct_idx >= 0 {
                let si = c.structs.get(struct_idx)
                let field_ty = field_info_list_find(si.fields, e.name)
                if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                }
                (c, field_ty)
            } else {
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T> field access: .value -> T, .epsilon -> f64
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                // "value" = [118, 97, 108, 117, 101]
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                // "epsilon" = [101, 112, 115, 105, 108, 111, 110]
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper field access: delegates to hyper.sio predicates
            // Complex: .real, .imag -> inner type
            // Quaternion: .w, .x, .y, .z -> inner type
            // Octonion: .e0.e7 -> inner type
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // Complex fields
            if alg == 1 {
                // "real" = [114, 101, 97, 108], "imag" = [105, 109, 97, 103]
                if name_matches_str4(e.name, 114, 101, 97, 108) { (c, inner_ty) }
                else if name_matches_str4(e.name, 105, 109, 97, 103) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            // Quaternion fields
            } else if alg == 2 {
                // .w .x .y .z (119, 120, 121, 122)
                if name_matches_str1(e.name, 119) { (c, inner_ty) }
                else if name_matches_str1(e.name, 120) { (c, inner_ty) }
                else if name_matches_str1(e.name, 121) { (c, inner_ty) }
                else if name_matches_str1(e.name, 122) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            } else {
                // Octonion/Sedenion/Clifford: field access by component index
                // For now accept any short field name and return inner type
                (c, inner_ty)
            }
        } else if base_ty.kind == TypeKind::TyTuple {
            // Tuple field access by index (e.g. t.0, t.1)
            // The field name contains the index as ascii digits
            let idx = (e.name.buf[0] as i64) - 48
            let tuple_count = type_entry_list_count(base_ty.tuple_elems)
            if idx >= tuple_count {
                c = c.report_error_at(e.span, 47, 0, 0, 0)
                (c, ty_error())
            } else {
                let elem = type_entry_list_get(base_ty.tuple_elems, idx)
                (c, elem)
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 12, 0, 0, 0)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Index expression
    // --------------------------------------------------------

    fn check_index_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let base_pair = self.check_opt_expr(e.left)
        var c = base_pair.0
        let base_ty = base_pair.1
        let idx_pair = c.check_opt_expr(e.right)
        c = idx_pair.0
        let idx_ty = idx_pair.1
        // Index must be i64
        if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
            c = c.report_error_at(e.span, 14, 0, 0, 0)
        }
        // Base must be array
        if base_ty.kind == TypeKind::TyArray {
            match base_ty.inner {
                Some(elem_ty) => (c, *elem_ty)
                None => (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 13, 0, 0, 0)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Method call
    // --------------------------------------------------------

    fn check_method_call(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let base_pair = self.check_opt_expr(e.left)
        var c = base_pair.0
        let base_ty = base_pair.1
        if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T>.unwrap() -> T
            if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
                // "unwrap" = [117, 110, 119, 114, 97, 112]
                c = c.check_expr_list_no_type(e.args)
                (c, knowledge_inner(base_ty))
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                c = c.check_expr_list_no_type(e.args)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper method calls: .conjugate() .norm() .inverse()
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // "conjugate" = [99,111,110,106,117,103,97,116,101] (9 chars)
            if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
                c = c.check_expr_list_no_type(e.args)
                (c, base_ty)  // conjugate returns same Hyper type
            // "norm" = [110,111,114,109] (4 chars)
            } else if name_matches_str4(e.name, 110, 111, 114, 109) {
                c = c.check_expr_list_no_type(e.args)
                (c, inner_ty)  // norm returns scalar
            // "inverse" = [105,110,118,101,114,115,101] (7 chars)
            } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
                c = c.check_expr_list_no_type(e.args)
                // Only division algebras have inverse (alg <= 3)
                if alg > 3 {
                    c = c.report_error_at(e.span, 32, 0, 0, 0)
                    (c, ty_error())
                } else {
                    (c, base_ty)
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                c = c.check_expr_list_no_type(e.args)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyNamed {
            let sig_id = c.fn_sigs.find_method(base_ty.name, e.name)
            if sig_id >= 0 {
                let sig = c.fn_sigs.get(sig_id)
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                // Verify callee method's effects are subset of caller's effects
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                // Release borrows taken for method call arguments
                c = c.release_call_arg_borrows(e.args, sig.params)
                (c, sig.return_type)
            } else {
                // Method not found
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                // Still check args to accumulate errors
                c = c.check_expr_list_no_type(e.args)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            c = c.check_expr_list_no_type(e.args)
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 19, 0, 0, 0)
            c = c.check_expr_list_no_type(e.args)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Function call
    // --------------------------------------------------------

    fn check_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let callee_pair = self.check_opt_expr(e.left)
        var c = callee_pair.0
        let callee_ty = callee_pair.1
        if callee_ty.kind == TypeKind::TyFn && callee_ty.fn_sig_id >= 0 {
            let sig = c.fn_sigs.get(callee_ty.fn_sig_id)
            c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
            // Verify callee's effects are subset of caller's effects
            c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
            // Release borrows taken for call arguments — the call has returned,
            // so exclusive/shared borrows on arguments are no longer active.
            c = c.release_call_arg_borrows(e.args, sig.params)
            (c, sig.return_type)
        } else if is_error_or_unknown(callee_ty) {
            c = c.check_expr_list_no_type(e.args)
            (c, callee_ty)
        } else {
            c = c.report_error_at(e.span, 17, 0, 0, 0)
            c = c.check_expr_list_no_type(e.args)
            (c, ty_error())
        }
    }

    // Release borrows taken for function call arguments after the call returns.
    // For each arg that is a named variable passed as &x or &!x, reset borrow state.
    fn release_call_arg_borrows(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        match args {
            None => c
            Some(arg_list) => {
                match params {
                    None => c
                    Some(param_list) => {
                        let arg_expr = (*arg_list).head
                        let param = (*param_list).head
                        if arg_expr.kind == ExprKind::ExprIdent {
                            if param.ty.kind == TypeKind::TyRef || param.ty.kind == TypeKind::TyRefMut {
                                c.borrows = c.borrows.release_borrow(arg_expr.name)
                            }
                        }
                        c.release_call_arg_borrows((*arg_list).tail, (*param_list).tail)
                    }
                }
            }
        }
    }

    fn check_call_args(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.check_call_args_inner(args, params, 0, expected_count, call_span)
        c
    }

    fn check_call_arg_borrow_boundary(self, arg_expr: Expr, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        if arg_expr.kind != ExprKind::ExprIdent {
            return self
        }
        var c = self
        if param_ty.kind == TypeKind::TyRef {
            let borrow_result = c.borrows.try_shared_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        } else if param_ty.kind == TypeKind::TyRefMut {
            let borrow_result = c.borrows.try_exclusive_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        }
        c
    }

    fn check_call_arg_refinement_boundary(self, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.refinement_id < 0 || expected_ty.refinement_id >= 128 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }

        let expected_ref = self.refinements.entries[expected_ty.refinement_id as usize]
        var c = self

        if arg_expr.kind == ExprKind::ExprIntLit {
            if !pred_check_int(expected_ref.predicate, arg_expr.int_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }
        if arg_expr.kind == ExprKind::ExprFloatLit {
            if !pred_check_float(expected_ref.predicate, arg_expr.float_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        if provided_ty.refinement_id >= 0 && provided_ty.refinement_id < 128 {
            let provided_ref = c.refinements.entries[provided_ty.refinement_id as usize]
            if !pred_implies(provided_ref.predicate, expected_ref.predicate) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        c.report_error_at(call_span, 52, 0, 0, 0)
    }

    fn check_call_arg_knowledge_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.kind != TypeKind::TyKnowledge {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if provided_ty.kind != TypeKind::TyKnowledge || is_error_or_unknown(provided_ty) {
            return self
        }
        if knowledge_call_boundary_compatible(provided_ty, expected_ty) {
            self
        } else {
            self.report_error_at(call_span, 36, 0, 0, 0)
        }
    }

    fn check_call_args_inner(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, idx: i64, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                let param_info = fn_param_list_get(params, idx)
                let implicit_borrow =
                    arg_expr.kind == ExprKind::ExprIdent &&
                    (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)

                var checker_for_arg = self
                if implicit_borrow {
                    checker_for_arg.suppress_linear_consume_depth = checker_for_arg.suppress_linear_consume_depth + 1
                }

                let pair = checker_for_arg.check_expr(arg_expr)
                var c = pair.0
                if implicit_borrow && c.suppress_linear_consume_depth > 0 {
                    c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
                }
                let arg_ty = pair.1

                // Check against parameter type and boundary contracts
                if !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError {
                    if !call_arg_types_compatible(arg_expr, arg_ty, param_info.ty) {
                        c = c.report_mismatch(call_span, 9, param_info.ty, arg_ty)
                    }
                    c = c.check_call_arg_borrow_boundary(arg_expr, param_info.ty, call_span)
                    c = c.check_call_arg_refinement_boundary(arg_expr, arg_ty, param_info.ty, call_span)
                    c = c.check_call_arg_knowledge_boundary(arg_ty, param_info.ty, call_span)
                }
                // Linear type consumption: if arg is linear and not implicitly borrowed, consume it
                if arg_expr.kind == ExprKind::ExprIdent && c.is_linear_type(arg_ty) && !implicit_borrow && c.suppress_linear_consume_depth == 0 {
                    if c.borrows.is_borrowed(arg_expr.name) {
                        c = c.report_error_at(call_span, 38, 0, 0, 0)
                    } else {
                        let consume_result = c.borrows.consume_linear(arg_expr.name)
                        c.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c = c.report_error_at(call_span, 39, 0, 0, 0)
                        }
                    }
                }
                c.check_call_args_inner((*arg_list).tail, params, idx + 1, expected_count, call_span)
            }
            None => {
                // Check arity: idx should equal expected_count
                if idx != expected_count && expected_count >= 0 {
                    self.report_error_at(call_span, 10, 0, 0, 0)
                } else {
                    self
                }
            }
        }
    }

    fn check_expr_list_no_type(self, opt: Option<Box<ExprList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                c.check_expr_list_no_type((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // If expression
    // --------------------------------------------------------

    fn check_if_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        // Condition must be bool
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check then block
        let then_pair = c.check_opt_block(e.block)
        c = then_pair.0
        let then_ty = then_pair.1
        // Check else
        match e.else_expr {
            Some(else_e) => {
                let else_pair = c.check_expr(*else_e)
                c = else_pair.0
                let else_ty = else_pair.1
                if !types_compatible(then_ty, else_ty) {
                    c = c.report_mismatch(e.span, 7, then_ty, else_ty)
                }
                (c, then_ty)
            }
            None => (c, ty_unit())
        }
    }

    fn check_opt_block(self, opt: Option<Box<Block>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.check_block(*blk)
            None => (self, ty_unit())
        }
    }

    // --------------------------------------------------------
    // Match expression
    // --------------------------------------------------------

    fn check_match_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let scrut_pair = self.check_opt_expr(e.left)
        var c = scrut_pair.0
        let scrut_ty = scrut_pair.1
        c.check_match_arms(e.arms, scrut_ty)
    }

    fn check_match_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let first_ty = pair.1
                c = c.check_remaining_arms((*list).tail, scrut_ty, first_ty)
                (c, first_ty)
            }
            None => (self, ty_unit())
        }
    }

    fn check_match_arm(self, arm: MatchArm, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.bind_pattern(arm.pattern, scrut_ty)
        let pair = c.check_expr(arm.body)
        c = pair.0
        let body_ty = pair.1
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, body_ty)
    }

    fn check_remaining_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry, expected_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let arm_ty = pair.1
                if !types_compatible(arm_ty, expected_ty) {
                    c = c.report_mismatch((*list).head.span, 18, expected_ty, arm_ty)
                }
                c.check_remaining_arms((*list).tail, scrut_ty, expected_ty)
            }
            None => self
        }
    }

    fn bind_pattern(self, pat: Pattern, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatWildcard => self
            PatBinding => {
                var c = self
                c.env = c.env.bind(pat.name, scrut_ty, pat.is_mut)
                // Track pattern binding for borrow checking (linear if type is linear)
                let lin = c.is_linear_type(scrut_ty)
                c.borrows = c.borrows.track(pat.name, lin)
                c
            }
            PatIntLit => self
            PatBoolTrue => self
            PatBoolFalse => self
            PatStringLit => self
            PatEnum => {
                // Enum variant pattern — bind sub-patterns with scrut_ty
                // (variant field types not tracked yet, use scrut_ty as fallback)
                self.bind_pattern_list(pat.sub_patterns, scrut_ty)
            }
            PatStruct => {
                // Struct destructuring — bind field patterns with their field types
                self.bind_struct_pat_fields(pat.pat_fields, scrut_ty)
            }
            PatTuple => self.bind_tuple_pattern_list(pat.sub_patterns, scrut_ty)
            PatOr => self.bind_pattern_list(pat.sub_patterns, scrut_ty)
        }
    }

    fn bind_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.bind_pattern((*list).head, scrut_ty)
                c.bind_pattern_list((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_struct_pat_fields(self, opt: Option<Box<PatFieldList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                // Look up the field type from the struct definition
                var field_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyNamed {
                    let struct_idx = c.structs.find(scrut_ty.name)
                    if struct_idx >= 0 {
                        let si = c.structs.get(struct_idx)
                        field_ty = field_info_list_find(si.fields, (*list).head.name)
                    }
                }
                c = c.bind_pattern((*list).head.pattern, field_ty)
                c.bind_struct_pat_fields((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_tuple_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        // For tuple patterns, assign each sub-pattern the corresponding tuple element type
        self.bind_tuple_pattern_list_idx(opt, scrut_ty, 0)
    }

    fn bind_tuple_pattern_list_idx(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var elem_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyTuple {
                    elem_ty = type_entry_list_get(scrut_ty.tuple_elems, idx)
                }
                var c = self.bind_pattern((*list).head, elem_ty)
                c.bind_tuple_pattern_list_idx((*list).tail, scrut_ty, idx + 1)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // While, Loop, Block, Return
    // --------------------------------------------------------

    fn check_break_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 44, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_continue_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 45, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_while_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body.
        // In a while loop, each iteration may re-borrow the same variables.
        // Without this, the second iteration would fail because the first
        // iteration's exclusive borrows are still active.
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_loop_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body (same as while loops)
        c.borrows = c.borrows.release_exclusive_borrows()
        let pair = c.check_opt_block(e.block)
        c = pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_block_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_block(e.block)
    }

    fn check_return_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let val_ty = pair.1
        if !types_compatible(val_ty, c.current_return_type) {
            c = c.report_mismatch(e.span, 8, c.current_return_type, val_ty)
        }
        (c, ty_never())
    }

    // --------------------------------------------------------
    // Struct literal
    // --------------------------------------------------------

    fn check_struct_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let struct_name = copy_string_list_to_name(e.path.segments)
        let struct_idx = self.structs.find(struct_name)
        if struct_idx >= 0 {
            let si = self.structs.get(struct_idx)
            var c = self.check_struct_field_inits(e.fields, si, e.span)
            (c, ty_named(struct_name))
        } else {
            var c = self.report_error_at(e.span, 15, 0, 0, 0)
            c = c.check_struct_field_inits_no_type(e.fields)
            (c, ty_error())
        }
    }

    fn check_struct_field_inits(self, opt: Option<Box<StructFieldList>>, si: StructInfo, lit_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let init_count = struct_field_list_count(opt)
        if init_count != si.field_count {
            var c = self.report_error_at(lit_span, 46, 0, 0, 0)
            // Still check field types to report additional errors
            return c.check_struct_field_inits_with_type(opt, si)
        }
        self.check_struct_field_inits_with_type(opt, si)
    }

    fn check_struct_field_inits_with_type(self, opt: Option<Box<StructFieldList>>, si: StructInfo) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                let field_ty = field_info_list_find(si.fields, (*list).head.name)
                let pair = c.check_expr((*list).head.value)
                c = pair.0
                let init_ty = pair.1
                if !types_compatible(init_ty, field_ty) {
                    c = c.report_mismatch((*list).head.span, 16, field_ty, init_ty)
                }
                c.check_struct_field_inits_with_type((*list).tail, si)
            }
            None => self
        }
    }

    fn check_struct_field_inits_no_type(self, opt: Option<Box<StructFieldList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head.value)
                var c = pair.0
                c.check_struct_field_inits_no_type((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Array literal
    // --------------------------------------------------------

    fn check_array_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_array_elems(e.args)
        let c = pair.0
        let elem_ty = pair.1
        let count = pair.2
        (c, ty_array(elem_ty, count))
    }

    fn check_array_elems(self, opt: Option<Box<ExprList>>) -> (Checker, TypeEntry, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let first_ty = pair.1
                let rest = c.check_array_rest((*list).tail, first_ty)
                (rest.0, first_ty, 1 + rest.1)
            }
            None => (self, ty_error(), 0)
        }
    }

    fn check_array_rest(self, opt: Option<Box<ExprList>>, expected: TypeEntry) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let elem_ty = pair.1
                if !types_compatible(elem_ty, expected) {
                    c = c.report_mismatch((*list).head.span, 20, expected, elem_ty)
                }
                let rest = c.check_array_rest((*list).tail, expected)
                (rest.0, 1 + rest.1)
            }
            None => (self, 0)
        }
    }

    // --------------------------------------------------------
    // Tuple literal
    // --------------------------------------------------------

    fn check_tuple_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_tuple_elems(e.args)
        let c = pair.0
        match pair.1 {
            Some(elem_list) => (c, ty_tuple(*elem_list))
            None => (c, ty_unit())
        }
    }

    fn check_tuple_elems(self, opt: Option<Box<ExprList>>) -> (Checker, Option<Box<TypeEntryList>>) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let head_ty = pair.1
                let rest = c.check_tuple_elems((*list).tail)
                c = rest.0
                let head_entry = TypeEntryList { head: head_ty, tail: None }
                match rest.1 {
                    Some(rest_list) => {
                        (c, Some(Box::new(TypeEntryList { head: head_ty, tail: Some(rest_list) })))
                    }
                    None => (c, Some(Box::new(head_entry)))
                }
            }
            None => (self, None)
        }
    }

    // --------------------------------------------------------
    // Range expression
    // --------------------------------------------------------

    fn check_range_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        (c, ty_unit())
    }

    fn check_cast_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let src_ty = pair.1
        // Resolve the target type from the cast_type annotation
        match e.cast_type {
            Some(ty) => {
                let ty_pair = c.lower_type_expr(*ty)
                c = ty_pair.0
                let target_ty = ty_pair.1
                // Unit conversion check: if both are unit-typed, dimensions must be compatible
                if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
                    let src_dim = c.units.get_dim(src_ty.unit_id)
                    let tgt_dim = c.units.get_dim(target_ty.unit_id)
                    if !unit_dim_compatible(src_dim, tgt_dim) {
                        c = c.report_error_at(e.span, 43, 0, 0, 0)
                    }
                }
                (c, target_ty)
            }
            None => (c, ty_error())
        }
    }

    fn check_handle_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // handle<Effect> { body } with { handlers }
        // The handler discharges the named effect within the body.
        var c = self

        // Resolve the effect name to an ID
        var eff_name_buf: [i8; 64] = [0; 64]
        var i: i64 = 0
        while i < e.name.len && i < 64 {
            eff_name_buf[i as usize] = e.name.buf[i as usize]
            i = i + 1
        }
        let eff_id = effect_name_to_id(eff_name_buf, e.name.len)

        // Add the handled effect to the current effects (body may use it)
        var saved_effects = c.current_effects
        var saved_count = c.current_effect_count
        if eff_id >= 0 && c.current_effect_count < 8 {
            if !has_effect_id(c.current_effects, c.current_effect_count, eff_id) {
                c.current_effects[c.current_effect_count as usize] = eff_id
                c.current_effect_count = c.current_effect_count + 1
            }
        }

        // Check the body block
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        let body_ty = body_pair.1

        // Restore original effects (handler discharges the effect)
        c.current_effects = saved_effects
        c.current_effect_count = saved_count

        // Check the handler block (with { ... }) if present
        match e.handler_block {
            Some(hb) => {
                let hpair = c.check_block(*hb)
                c = hpair.0
            }
            None => {}
        }

        (c, body_ty)
    }

    // --------------------------------------------------------
    // Closure expression checking with effect inference
    // --------------------------------------------------------

    fn check_closure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self

        // Convert closure params to FnParamList for signature
        let params_pair = c.collect_closure_params(e.closure_params)
        c = params_pair.0
        let params = params_pair.1
        let param_count = params_pair.2

        // Lower return type annotation (if present) or use unknown
        let ret_pair = c.lower_opt_closure_return(e.closure_return)
        c = ret_pair.0
        let ret_ty = ret_pair.1

        // Save current effects, clear for inference
        let saved_effects = c.current_effects
        let saved_effect_count = c.current_effect_count
        c.current_effects = [0; 8]
        c.current_effect_count = 0

        // Push scope for parameters
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()

        // Bind closure params in environment
        c = c.bind_closure_params(e.closure_params)

        // Check body expression
        let body_pair = c.check_opt_expr(e.closure_body)
        c = body_pair.0
        let body_ty = body_pair.1

        // Infer return type from body if not annotated
        let inferred_ret_ty = if ret_ty.kind == TypeKind::TyUnknown {
            body_ty
        } else {
            ret_ty
        }

        // Check body type against return type if annotated
        if ret_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(body_ty, ret_ty) {
                c = c.report_mismatch(e.span, 8, ret_ty, body_ty)
            }
        }

        // Get inferred effects from current_effects
        let inferred_effects = c.current_effects
        let inferred_effect_count = c.current_effect_count

        // Pop scope
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()

        // Restore outer effects context
        c.current_effects = saved_effects
        c.current_effect_count = saved_effect_count

        // Create FnSig with inferred effects
        let closure_sig = FnSig {
            name: Name { buf: [0; 128], len: 0 },  // Anonymous closure
            params: params,
            param_count: param_count,
            return_type: inferred_ret_ty,
            is_method: false,
            self_type_name: Name { buf: [0; 128], len: 0 },
            effects: inferred_effects,
            effect_count: inferred_effect_count,
        }

        // Add to fn_sigs table
        let add_result = c.fn_sigs.add(closure_sig)
        c.fn_sigs = add_result.0
        let sig_id = add_result.1

        (c, ty_fn(sig_id))
    }

    fn collect_closure_params(self, opt: Option<Box<ClosureParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_closure_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_closure_param_list(self, pl: ClosureParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_closure_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn bind_closure_params(self, opt: Option<Box<ClosureParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_closure_param((*pl).head)
                c.bind_closure_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_closure_param(self, p: ClosureParam) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        let pair = c.lower_type_expr(p.ty)
        c = pair.0
        let param_ty = pair.1
        c.env = c.env.bind(p.name, param_ty, false)
        c
    }

    fn lower_opt_closure_return(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }
}

// ============================================================
// Struct field list helper
// ============================================================

fn struct_field_list_count(opt: Option<Box<StructFieldList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + struct_field_list_count((*list).tail)
    }
}
