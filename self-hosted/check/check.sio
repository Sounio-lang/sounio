    fn lower_contest_type(self, opt: Option<Box<TypeExprList>>, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                match (*args).tail {
                    None => {
                        let pair = self.lower_type_expr((*args).head)
                        if pair.1.kind == TypeKind::TyError {
                            pair
                        } else {
                            (pair.0, ty_contest(pair.1, -1))
                        }
                    }
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let family_pair = c.lower_type_expr((*rest).head)
                                        c = family_pair.0
                                        let family_ty = family_pair.1
                                        let policy_pair = c.lower_type_expr((*last).head)
                                        c = policy_pair.0
                                        let policy_ty = policy_pair.1
                                        if family_ty.kind != TypeKind::TyModelFamily {
                                            return (c.report_missing_model_family_metadata(span), ty_error())
                                        }
                                        if policy_ty.kind != TypeKind::TyPolicy {
                                            return (c.report_policy_requires_named_definition(span), ty_error())
                                        }
                                        if !types_compatible(model_output_ty(family_ty), inner_ty) || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                            return (c.report_error_at(span, 58, 0, 0, 0), ty_error())
                                        }
                                        let family_info = c.model_families.get(family_ty.epistemic_meta_id)
                                        var info = contest_info_from_family_signature(family_info, policy_ty.epistemic_meta_id)
                                        info = contest_info_attach_span(info, span)
                                        info = contest_info_attach_family_id(info, family_ty.epistemic_meta_id)
                                        let add_result = c.contests.add(info)
                                        c.contests = add_result.0
                                        (c, ty_contest(inner_ty, add_result.1))
                                    }
                                }
                            }
                            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                        }
                    }
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

    fn lower_robust_type(self, opt: Option<Box<TypeExprList>>, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                match (*args).tail {
                    None => {
                        let pair = self.lower_type_expr((*args).head)
                        if pair.1.kind == TypeKind::TyError {
                            pair
                        } else {
                            (pair.0, ty_robust(pair.1, -1, -1, -1))
                        }
                    }
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let level_id = c.robust_type_tag_from_type_expr((*rest).head, true)
                                        let scope_id = c.robust_type_tag_from_type_expr((*last).head, false)
                                        if level_id < 0 || scope_id < 0 {
                                            c = c.report_error_at(span, 63, 0, 0, 0)
                                            return (c, ty_error())
                                        }
                                        (c, ty_robust(inner_ty, -1, level_id, scope_id))
                                    }
                                }
                            }
                            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                        }
                    }
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

