    fn collect_transition_protocol_def(self, name: Name, opt: Option<Box<TransitionProtocolDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(proto) => {
                let target_pair = self.lower_type_expr((*proto).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                if target_ty.kind != TypeKind::TyAlternativeOption {
                    c = c.report_transition_protocol_target_mismatch((*proto).span, name, target_ty)
                    return c
                }

                let policy_id = c.transition_policies.find((*proto).policy_name)
                if policy_id < 0 || policy_id >= c.transition_policies.count {
                    c = c.report_transition_policy_target_mismatch((*proto).span, (*proto).policy_name, knowledge_inner(target_ty), ty_error())
                    return c
                }
                let policy_info = c.transition_policies.get(policy_id)
                let inner_ty = knowledge_inner(target_ty)
                if !types_compatible(policy_info.target_ty, inner_ty) {
                    c = c.report_transition_policy_target_mismatch((*proto).span, policy_info.name, policy_info.target_ty, inner_ty)
                    return c
                }

                let step_pair = c.collect_transition_step_defs((*proto).steps)
                c = step_pair.0
                let info = TransitionProtocolInfo {
                    name: name,
                    target_ty: target_ty,
                    transition_policy_id: policy_id,
                    step_ids: step_pair.1,
                    step_count: step_pair.2,
                }
                let add_result = c.transition_protocols.add(info)
                c.transition_protocols = add_result.0
                c.env = c.env.bind(name, ty_unknown(), false)
                c = c.const_int_bind_unknown(name)

                var i: i64 = 0
                while i < step_pair.2 && i < 16 {
                    let step_id = step_pair.1[i as usize]
                    if step_id >= 0 && step_id < c.transition_steps.count {
                        var step_info = c.transition_steps.get(step_id)
                        step_info.protocol_id = add_result.1
                        c.transition_steps.entries[step_id as usize] = step_info
                    }
                    i = i + 1
                }
                c
            }
            None => self
        }
    }

    fn collect_transition_step_defs(self, opt: Option<Box<TransitionStepDefList>>) -> (Checker, [i64; 16], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var ids: [i64; 16] = [-1; 16]
                var count: i64 = 0
                let rest_pair = c.collect_transition_step_defs((*list).tail)
                c = rest_pair.0
                ids = rest_pair.1
                count = rest_pair.2
                if count < 16 {
                    let req_pair = c.collect_transition_policy_requirements((*list).head.requirements)
                    c = req_pair.0
                    let info = TransitionStepInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        protocol_id: -1,
                        name: (*list).head.name,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        requirements: req_pair.1,
                        requirement_count: req_pair.2,
                    }
                    let add_result = c.transition_steps.add(info)
                    c.transition_steps = add_result.0
                    var shifted: [i64; 16] = [-1; 16]
                    shifted[0] = add_result.1
                    var i: i64 = 0
                    while i < count && i + 1 < 16 {
                        shifted[(i + 1) as usize] = ids[i as usize]
                        i = i + 1
                    }
                    ids = shifted
                    count = count + 1
                }
                (c, ids, count)
            }
            None => (self, [-1; 16], 0)
        }
    }

    fn collect_transition_policy_requirements(self, opt: Option<Box<PolicyRequirementList>>) -> (Checker, Option<Box<PolicyRequirementInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_transition_policy_requirement_list(*list)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_transition_policy_requirement_list(self, list: PolicyRequirementList) -> (Checker, PolicyRequirementInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = transition_policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_pair = c.collect_transition_policy_requirement_list(*rest)
                c = rest_pair.0
                let rest_list = rest_pair.1
                let rest_count = rest_pair.2
                (c, PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn collect_alternative_policy_def(self, name: Name, opt: Option<Box<AlternativePolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => {
                let target_pair = self.lower_type_expr((*ap).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let seed_metric_ids: [i64; 8] = [-1; 8]
                let seed_directions: [i64; 8] = [0; 8]
                let obj_pair = c.collect_alternative_objectives((*ap).objectives, seed_metric_ids, seed_directions, 0)
                c = obj_pair.0
                let info = AlternativePolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    frontier_name: (*ap).frontier_name,
                    objective_metric_ids: obj_pair.1,
                    objective_directions: obj_pair.2,
                    objective_count: obj_pair.3,
                    max_options: (*ap).max_options,
                }
                let add_result = c.alternative_policies.add(info)
                c.alternative_policies = add_result.0
                c.env = c.env.bind(name, ty_alternative_policy(target_ty, add_result.1), false)
                c
            }
            None => self
        }
    }

    fn collect_alternative_frontier_def(self, name: Name, opt: Option<Box<AlternativeFrontierDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let target_pair = self.lower_type_expr((*fd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1

                var target_kind: i64 = -1
                var inner_ty = ty_error()
                if target_ty.kind == TypeKind::TyDeferred {
                    target_kind = ALTERNATIVE_SOURCE_DEFERRED
                    inner_ty = knowledge_inner(target_ty)
                } else if target_ty.kind == TypeKind::TyRecoursePlan {
                    target_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
                    inner_ty = knowledge_inner(target_ty)
                } else {
                    c = c.report_error_at((*fd).span, 114, 0, 0, 0)
                }

                let policy_id = c.alternative_policies.find((*fd).policy_name)
                if policy_id < 0 {
                    c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                } else {
                    let policy_info = c.alternative_policies.get(policy_id)
                    if !types_compatible(policy_info.target_ty, inner_ty) {
                        c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                    }
                }

                let cand_pair = c.collect_alternative_candidates((*fd).candidates)
                c = cand_pair.0
                let info = AlternativeFrontierInfo {
                    name: name,
                    target_kind: target_kind,
                    target_ty: target_ty,
                    policy_id: policy_id,
                    candidate_ids: cand_pair.1,
                    candidate_count: cand_pair.2,
                }
                let add_result = c.alternative_frontiers.add(info)
                c.alternative_frontiers = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_alternative_objectives(
        self,
        opt: Option<Box<AlternativeObjectiveDefList>>,
        metric_ids: [i64; 8],
        directions: [i64; 8],
        count: i64
    ) -> (Checker, [i64; 8], [i64; 8], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var mids = metric_ids
                var dirs = directions
                var next_count = count
                let metric_id = alternative_metric_id_from_name((*list).head.metric_name)
                if metric_id < 0 || count >= 8 {
                    c = c.report_error_at((*list).head.span, 119, 0, 0, 0)
                } else {
                    mids[count as usize] = metric_id
                    dirs[count as usize] =
                        if (*list).head.direction == AlternativeObjectiveDirection::AlternativeObjectiveMaximize { 1 } else { 0 }
                    next_count = count + 1
                }
                c.collect_alternative_objectives((*list).tail, mids, dirs, next_count)
            }
            None => (self, metric_ids, directions, count)
        }
    }

    fn collect_alternative_candidates(self, opt: Option<Box<AlternativeCandidateDefList>>) -> (Checker, [i64; 16], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_alternative_candidates((*list).tail)
                var c = pair.0
                var ids = pair.1
                var count = pair.2
                if count < 16 {
                    let seed_known: [i64; 8] = [0; 8]
                    let seed_values: [f64; 8] = [0.0; 8]
                    let metric_pair = c.collect_alternative_candidate_metrics((*list).head.metrics, seed_known, seed_values)
                    c = metric_pair.0
                    let info = AlternativeCandidateInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        frontier_id: -1,
                        name: (*list).head.name,
                        via_recourse_policy_name: (*list).head.via_name,
                        uses_via: (*list).head.uses_via,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        metric_known: metric_pair.1,
                        metric_values: metric_pair.2,
                        source_kind: -1,
                        deferred_certificate_id: -1,
                        source_policy_id: -1,
                        source_plan_id: -1,
                        strategy_name: empty_name(),
                        route_name: empty_name(),
                        audit_id: -1,
                        contest_id: -1,
                        dominance_rank: -1,
                    }
                    let add_result = c.alternative_candidates.add(info)
                    c.alternative_candidates = add_result.0
                    ids[count as usize] = add_result.1
                    count = count + 1
                }
                (c, ids, count)
            }
            None => (self, [-1; 16], 0)
        }
    }

    fn collect_alternative_candidate_metrics(
        self,
        opt: Option<Box<AuditFieldEntryList>>,
        known: [i64; 8],
        values: [f64; 8]
    ) -> (Checker, [i64; 8], [f64; 8]) with Mut, Panic, Div, Alloc, IO {
        var c = self
        var out_known = known
        var out_values = values
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let metric_id = alternative_metric_id_from_name((*list).head.name)
                    if metric_id < 0
                    || metric_id >= 4
                    || out_known[metric_id as usize] == 1
                    || (*list).head.value_kind != AuditValueKind::AuditValueFloat {
                        c = c.report_error_at((*list).head.span, 116, 0, 0, 0)
                    } else {
                        out_known[metric_id as usize] = 1
                        out_values[metric_id as usize] = (*list).head.value_f64
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        (c, out_known, out_values)
    }

