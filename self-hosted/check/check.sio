// ============================================================
// Visibility / module-path helpers
// ============================================================

// Head-only segment comparison. Touches NO Option<Box<T>> field, which is the whole point:
// reading `tail` — even as `tail == None` — is a read through a Box-typed struct field, and
// Madaros miscompiles those (StructFieldEntry at ir/ir.sio:2175 carries no pointer metadata,
// so field access computes base+off+off, correct for an inline field and wrong for a Box).
// The note that used to sit on the tail comparison below tried to dodge this by replacing
// `match` with `== None`; that does not help, because the read itself is the defect.
fn string_list_head_eq_sl(a: StringList, b: StringList) -> bool with Mut, Panic, Div {
    if a.head_len != b.head_len { return false }
    var i: i64 = 0
    while i < a.head_len && i < 128 {
        if a.head_buf[i as usize] != b.head_buf[i as usize] { return false }
        i = i + 1
    }
    true
}

fn string_list_eq_sl(a: StringList, b: StringList) -> bool with Mut, Panic, Div {
    if !string_list_head_eq_sl(a, b) { return false }
    // Reached only for genuinely multi-segment paths. Module identity is single-segment
    // (compiler/module_loader.sio file_path_to_module_path returns seg_count 1), so
    // ast_path_eq below never routes here today.
    // `*a.tail` unwraps the Option and stops at the Box, so it types as Box and
    // not StringList. The tree's working idiom for a boxed tail is to match the
    // Option and deref the Box the match binds — see substitute_type_param_list
    // (check.sio:770) and mangle_append_args (:593).
    match a.tail {
        None => {
            match b.tail {
                None => true
                Some(_) => false
            }
        }
        Some(at) => {
            match b.tail {
                None => false
                Some(bt) => string_list_eq_sl(*at, *bt)
            }
        }
    }
}

// A ZD locus names a pair of sedenion imaginary units, written `eIeJ`, with
// 1 <= I < J <= 15. Well-formedness is decidable by inspection of the name.
// Narrowing this from "well-formed pair" to "one of the 84 validPrims" needs
// the zero-divisor predicate over cd_sigma_ct and is OWED — see
// docs/audit/EXACTLY_PRIVATE_TA_DISPATCH_2026-08-19.md. Refusing e3e3 and
// e3e99 today is strictly more interrogation than refusing nothing.
fn zd_locus_is_wellformed(n: Name) -> bool with Mut, Panic, Div {
    var ok = true
    if n.len < 4 { ok = false }
    if ok && n.buf[0] != 101 { ok = false }
    var idx = 1
    var a = 0
    var adig = 0
    while ok && idx < n.len && n.buf[idx] >= 48 && n.buf[idx] <= 57 {
        a = a * 10 + (n.buf[idx] as i64 - 48)
        adig = adig + 1
        idx = idx + 1
    }
    if ok && adig == 0 { ok = false }
    if ok && idx >= n.len { ok = false }
    if ok && n.buf[idx] != 101 { ok = false }
    if ok { idx = idx + 1 }
    var b = 0
    var bdig = 0
    while ok && idx < n.len && n.buf[idx] >= 48 && n.buf[idx] <= 57 {
        b = b * 10 + (n.buf[idx] as i64 - 48)
        bdig = bdig + 1
        idx = idx + 1
    }
    if ok && bdig == 0 { ok = false }
    if ok && idx != n.len { ok = false }
    if ok && a < 1 { ok = false }
    if ok && b > 15 { ok = false }
    if ok && a >= b { ok = false }
    ok
}

fn ast_path_eq(a: AstPath, b: AstPath) -> bool with Mut, Panic, Div {
    if a.seg_count != b.seg_count { return false }
    if a.seg_count == 0 { return true }
    // seg_count 1 means the tail carries nothing to compare, so compare heads and return.
    // This is not an optimisation: it is what stops the ONLY caller of ast_path_eq
    // (visibility_allows_access, check.sio:90) from crashing the compiler. Two modules whose
    // first segment bytes are EQUAL used to fall through to the tail walk above, and reading
    // that Option<Box<StringList>> field SIGSEGVs with no diagnostic — reproduced with a
    // deterministic 3-file witness: colliding basenames plus a private cross-module access,
    // rc=139. Making the callee public (short-circuits at :6574) or the basenames distinct
    // (byte loop exits early) both avoid the read, which is why the crash stayed hidden.
    if a.seg_count == 1 { return string_list_head_eq_sl(a.segments, b.segments) }
    string_list_eq_sl(a.segments, b.segments)
}

fn ast_path_is_prefix(ancestor: AstPath, descendant: AstPath) -> bool with Mut, Panic, Div {
    if ancestor.seg_count == 0 { return true }
    if descendant.seg_count < ancestor.seg_count { return false }
    var a_segs = ancestor.segments
    var d_segs = descendant.segments
    var i: i64 = 0
    while i < ancestor.seg_count {
        if a_segs.head_len != d_segs.head_len { return false }
        var j: i64 = 0
        while j < a_segs.head_len && j < 128 {
            if a_segs.head_buf[j as usize] != d_segs.head_buf[j as usize] { return false }
            j = j + 1
        }
        i = i + 1
        if i < ancestor.seg_count {
            // Same as string_list_eq_sl: match the Option, deref the Box it binds.
            match a_segs.tail {
                None => return false
                Some(at) => {
                    match d_segs.tail {
                        None => return false
                        Some(dt) => {
                            a_segs = *at
                            d_segs = *dt
                        }
                    }
                }
            }
        }
    }
    true
}

fn visibility_allows_access(vis: Visibility, defining_module: AstPath, current_module: AstPath, crate_root: AstPath) -> bool with Mut, Panic, Div {
    if vis.kind == VISIBILITY_PUB {
        return true
    }
    if vis.kind == VISIBILITY_PRIVATE {
        return ast_path_eq(defining_module, current_module)
    }
    if vis.kind == VISIBILITY_PUB_CRATE {
        // All loaded modules are considered part of the current crate for now.
        return true
    }
    if vis.kind == VISIBILITY_PUB_SUPER {
        // Without a true parent module hierarchy, treat pub(super) as pub(crate).
        return true
    }
    if vis.kind == VISIBILITY_PUB_IN {
        return ast_path_is_prefix(vis.path, current_module)
    }
    false
}

