        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E084]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": posterior weight witness is unavailable for this contest\n")
        if contest_id >= 0 && contest_id < self.contests.count {
            let contest_info = self.contests.get(contest_id)
            if contest_info.model_count > 0 {
                print("   |\n   = model family ")
                print_contest_model_family(contest_info)
                print("\n")
            }
        }
        print("   = help: attach posterior weights before calling posterior_weights(contest_value)\n")
        c
    }

