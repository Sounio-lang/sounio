    fn report_failed_deferral_policy_requirement(self, span: Span, policy_name: Name, req: PolicyRequirementInfo, observed: f64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E100]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": deferral policy obligation failed\n")
        print("   |\n   = deferral policy ")
        print_name_value(policy_name)
        print(" requires ")
        print_contest_metric_name(req.metric_id)
        print(" ")
        print_compare_op_value(req.op)
        print(" ")
        print_milli_ratio(req.threshold)
        print("\n   = observed ")
        print_contest_metric_name(req.metric_id)
        print(" = ")
        print_milli_ratio(observed)
        print("\n   = help: keep using the non-deferred path until the deferral condition is explicitly satisfied\n")
        c
    }

