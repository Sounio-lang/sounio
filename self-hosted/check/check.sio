        && name.buf[12] == 120 as i8 && name.buf[13] == 112 as i8 && name.buf[14] == 108 as i8
        && name.buf[15] == 97 as i8 && name.buf[16] == 110 as i8 && name.buf[17] == 97 as i8
        && name.buf[18] == 116 as i8 && name.buf[19] == 105 as i8 && name.buf[20] == 111 as i8
        && name.buf[21] == 110 as i8 && name.buf[22] == 95 as i8 && name.buf[23] == 100 as i8
        && name.buf[24] == 105 as i8 && name.buf[25] == 115 as i8 && name.buf[26] == 116 as i8
        && name.buf[27] == 97 as i8 && name.buf[28] == 110 as i8 && name.buf[29] == 99 as i8
        && name.buf[30] == 101 as i8 {
        return 5
    }
    -1
}

fn audit_counterexample_field_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str10(name, 109, 111, 100, 101, 108, 95, 110, 97, 109, 101) { return 0 }
    if name_matches_str13(name, 115, 117, 98, 103, 114, 111, 117, 112, 95, 110, 97, 109, 101) { return 1 }
    if name_matches_str11(name, 109, 101, 116, 114, 105, 99, 95, 110, 97, 109, 101) { return 2 }
    if name_matches_str14(name, 111, 98, 115, 101, 114, 118, 101, 100, 95, 118, 97, 108, 117, 101) { return 3 }
    if name.len == 15
        && name.buf[0] == 116 as i8 && name.buf[1] == 104 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 104 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 100 as i8
        && name.buf[9] == 95 as i8 && name.buf[10] == 118 as i8 && name.buf[11] == 97 as i8
        && name.buf[12] == 108 as i8 && name.buf[13] == 117 as i8 && name.buf[14] == 101 as i8 {
        return 4
    }
    if name_matches_str7(name, 115, 117, 109, 109, 97, 114, 121) { return 5 }
    -1
}

fn contest_info_apply_audit(contest_info: ContestInfo, audit_info: AuditInfo, audit_id: i64) -> ContestInfo with Mut, Panic, Div {
    var next = contest_info
    next.audit_id = audit_id
    var i: i64 = 0
    while i < 8 {
        if audit_info.metric_known[i as usize] == 1 {
            next.metric_known[i as usize] = 1
            next.metric_values[i as usize] = audit_info.metric_values[i as usize]
        }
        i = i + 1
    }
    if audit_info.mechanistic_report_id >= 0 {
        next.mechanistic_report_id = audit_info.mechanistic_report_id
    }
    if audit_info.posterior_weights_id >= 0 {
        next.posterior_weights_id = audit_info.posterior_weights_id
    }
    if audit_info.counterexample_id >= 0 {
        next.counterexample_id = audit_info.counterexample_id
    }
    next
}

fn contest_matches_audit_target(contest_ty: TypeEntry, contest_info: ContestInfo, audit_info: AuditInfo) -> bool with Mut, Panic, Div, Alloc {
    contest_ty.kind == TypeKind::TyContest
    && types_compatible(knowledge_inner(contest_ty), audit_info.target_inner_ty)
    && contest_info.family_id == audit_info.family_id
    && contest_info.policy_id == audit_info.policy_id
}

fn contest_type_seeded_from_audit(self: Checker, audit_info: AuditInfo, audit_id: i64, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc {
    var c = self
    if audit_info.family_id < 0 || audit_info.family_id >= c.model_families.count {
        return (c.report_missing_model_family_metadata(span), ty_error())
    }
    let family_info = c.model_families.get(audit_info.family_id)
    var info = contest_info_from_family_signature(family_info, audit_info.policy_id)
    info = contest_info_attach_span(info, span)
    info = contest_info_attach_family_id(info, audit_info.family_id)
    info = contest_info_apply_audit(info, audit_info, audit_id)
    let add_result = c.contests.add(info)
    c.contests = add_result.0
    (c, ty_contest(audit_info.target_inner_ty, add_result.1))
}

fn audit_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn model_family_model_index(family: ModelFamilyInfo, model_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < family.model_count && i < 16 {
        if name_eq(family.model_names[i as usize], model_name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn contest_witness_metric_id(kind: i64) -> i64 {
    if kind == CONTEST_WITNESS_SIGN_CONSENSUS { CONTEST_METRIC_SIGN_CONSENSUS }
    else if kind == CONTEST_WITNESS_RELATIVE_BAND { CONTEST_METRIC_RELATIVE_BAND }
    else if kind == CONTEST_WITNESS_MAX_TAIL_RISK { CONTEST_METRIC_MAX_TAIL_RISK }
    else if kind == CONTEST_WITNESS_MECHANISTIC_DIVERGENCE { CONTEST_METRIC_MECHANISTIC_DIVERGENCE }
    else if kind == CONTEST_WITNESS_IDENTIFIABILITY_FLOOR { CONTEST_METRIC_IDENTIFIABILITY_FLOOR }
    else { -1 }
}

fn contest_witness_info_new(span: Span, witness_kind: i64, contest_id: i64) -> ContestWitnessInfo {
    ContestWitnessInfo {
        span_start: span.start,
        span_end: span.end,
        witness_kind: witness_kind,
        contest_id: contest_id,
    }
}

fn contest_witness_result_type(kind: i64) -> TypeEntry with Mut, Panic, Div {
    if kind == CONTEST_WITNESS_DISAGREEMENT {
        return ty_named(contest_disagreement_type_name())
    }
    if kind == CONTEST_WITNESS_COUNTEREXAMPLE {
        return ty_named(contest_counterexample_type_name())
    }
    if kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
        return ty_named(contest_weights_type_name())
    }
    ty_f64()
}

fn contest_witness_requires_metric(kind: i64) -> bool {
    kind == CONTEST_WITNESS_SIGN_CONSENSUS
    || kind == CONTEST_WITNESS_RELATIVE_BAND
    || kind == CONTEST_WITNESS_MAX_TAIL_RISK
    || kind == CONTEST_WITNESS_IDENTIFIABILITY_FLOOR
}

fn contest_witness_requires_mechanistic(kind: i64) -> bool {
    kind == CONTEST_WITNESS_MECHANISTIC_DIVERGENCE || kind == CONTEST_WITNESS_DISAGREEMENT
}

fn robust_proof_info_from_contest(contest_id: i64, contest_info: ContestInfo, policy_info: PolicyInfo, span: Span) -> RobustProofInfo with Mut, Panic, Div {
    var rp = empty_robust_proof_info()
    rp.span_start = span.start
    rp.span_end = span.end
    rp.audit_id = contest_info.audit_id
    rp.contest_id = contest_id
    rp.policy_id = contest_info.policy_id
    rp.level_id = policy_info.level_id
    rp.scope_id = policy_info.scope_id
    var i: i64 = 0
    while i < 8 {
        rp.metric_known[i as usize] = contest_info.metric_known[i as usize]
        rp.metric_values[i as usize] = contest_info.metric_values[i as usize]
        i = i + 1
    }
    rp
}

fn robustness_level_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 7
        && name.buf[0] == 70 as i8 && name.buf[1] == 114 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 103 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 108 as i8
        && name.buf[6] == 101 as i8 {
        return ROBUST_LEVEL_FRAGILE
    }
    if name.len == 11
        && name.buf[0] == 67 as i8 && name.buf[1] == 111 as i8 && name.buf[2] == 110 as i8
        && name.buf[3] == 100 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 111 as i8 && name.buf[8] == 110 as i8
        && name.buf[9] == 97 as i8 && name.buf[10] == 108 as i8 {
        return ROBUST_LEVEL_CONDITIONAL
    }
    if name.len == 6
        && name.buf[0] == 83 as i8 && name.buf[1] == 116 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 98 as i8 && name.buf[4] == 108 as i8 && name.buf[5] == 101 as i8 {
        return ROBUST_LEVEL_STABLE
    }
    if name.len == 6
        && name.buf[0] == 83 as i8 && name.buf[1] == 116 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 111 as i8 && name.buf[4] == 110 as i8 && name.buf[5] == 103 as i8 {
        return ROBUST_LEVEL_STRONG
    }
    if name.len == 9
        && name.buf[0] == 73 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 118 as i8
        && name.buf[3] == 97 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 97 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 116 as i8 {
        return ROBUST_LEVEL_INVARIANT
    }
    -1
}

fn robustness_scope_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 14
        && name.buf[0] == 73 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 68 as i8
        && name.buf[3] == 105 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 114 as i8 && name.buf[7] == 105 as i8 && name.buf[8] == 98 as i8
        && name.buf[9] == 117 as i8 && name.buf[10] == 116 as i8 && name.buf[11] == 105 as i8
        && name.buf[12] == 111 as i8 && name.buf[13] == 110 as i8 {
        return ROBUST_SCOPE_IN_DISTRIBUTION
    }
    if name.len == 13
        && name.buf[0] == 69 as i8 && name.buf[1] == 120 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 114 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 112 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 97 as i8
        && name.buf[9] == 116 as i8 && name.buf[10] == 105 as i8 && name.buf[11] == 118 as i8
        && name.buf[12] == 101 as i8 {
        return ROBUST_SCOPE_EXTRAPOLATIVE
    }
    if name.len == 16
        && name.buf[0] == 83 as i8 && name.buf[1] == 117 as i8 && name.buf[2] == 98 as i8
        && name.buf[3] == 103 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 111 as i8
        && name.buf[6] == 117 as i8 && name.buf[7] == 112 as i8 && name.buf[8] == 83 as i8
        && name.buf[9] == 112 as i8 && name.buf[10] == 101 as i8 && name.buf[11] == 99 as i8
        && name.buf[12] == 105 as i8 && name.buf[13] == 102 as i8 && name.buf[14] == 105 as i8
        && name.buf[15] == 99 as i8 {
        return ROBUST_SCOPE_SUBGROUP_SPECIFIC
    }
    if name.len == 16
        && name.buf[0] == 73 as i8 && name.buf[1] == 100 as i8 && name.buf[2] == 101 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 102 as i8 && name.buf[7] == 105 as i8 && name.buf[8] == 101 as i8
        && name.buf[9] == 100 as i8 && name.buf[10] == 70 as i8 && name.buf[11] == 97 as i8
        && name.buf[12] == 109 as i8 && name.buf[13] == 105 as i8 && name.buf[14] == 108 as i8
        && name.buf[15] == 121 as i8 {
        return ROBUST_SCOPE_IDENTIFIED_FAMILY
    }
    if name.len == 17
        && name.buf[0] == 84 as i8 && name.buf[1] == 114 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 112 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 114 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 101 as i8 && name.buf[10] == 100 as i8 && name.buf[11] == 68 as i8
        && name.buf[12] == 111 as i8 && name.buf[13] == 109 as i8 && name.buf[14] == 97 as i8
        && name.buf[15] == 105 as i8 && name.buf[16] == 110 as i8 {
        return ROBUST_SCOPE_TRANSPORTED_DOMAIN
    }
    -1
}

fn check_policy_requirements_against_contest(
    checker: Checker,
    span: Span,
    policy_name: Name,
    reqs: Option<Box<PolicyRequirementInfoList>>,
    contest_id: i64
) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
    match reqs {
        None => (checker, true)
        Some(list) => {
            let req = (*list).head
            if req.metric_id < 0 {
                return (checker.report_unknown_policy_metric(span, req.metric_name), false)
            }
            if contest_id < 0 || contest_id >= checker.contests.count {
                return (checker.report_missing_contest_diagnostic(span, policy_name, req, contest_id), false)
            }
            let contest_info = checker.contests.get(contest_id)
            let metric_pair = contest_info_get_metric(contest_info, req.metric_id)
            if !metric_pair.0 {
                return (checker.report_missing_contest_diagnostic(span, policy_name, req, contest_id), false)
            }
            if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                return (checker.report_failed_policy_requirement(span, policy_name, req, metric_pair.1, contest_id), false)
            }
            check_policy_requirements_against_contest(checker, span, policy_name, (*list).tail, contest_id)
        }
    }
}

// Extract variable name from unary operand (if it's a simple ident)
fn unary_operand_name(opt: Option<Box<Expr>>) -> Name {
    match opt {
        Some(inner) => {
            if (*inner).kind == ExprKind::ExprIdent {
                (*inner).name
            } else {
                Name { buf: [0; 128], len: 0 }
            }
        }
        None => Name { buf: [0; 128], len: 0 }
    }
}

fn call_ref_inner_or_self(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyRef || ty.kind == TypeKind::TyRefMut {
        match ty.inner {
            Some(inner) => *inner
            None => ty_error()
        }
    } else {
        ty
    }
}

fn eval_const_int_opt_expr(c: Checker, opt: Option<Box<Expr>>) -> (bool, i64) with Mut, Panic, Div, Alloc {
    match opt {
        Some(inner) => {
            let e = *inner
            if e.kind == ExprKind::ExprIntLit {
                return (true, e.int_val)
            }
            if e.kind == ExprKind::ExprIdent {
                return c.const_int_lookup(e.name)
            }
            if e.kind == ExprKind::ExprUnary && e.un_op == UnaryOp::OpNeg {
                let inner_pair = eval_const_int_opt_expr(c, e.left)
                if inner_pair.0 {
                    return (true, 0 - inner_pair.1)
                }
                return (false, 0)
            }
            if e.kind == ExprKind::ExprBinary {
                let left_pair = eval_const_int_opt_expr(c, e.left)
                let right_pair = eval_const_int_opt_expr(c, e.right)
                if !left_pair.0 || !right_pair.0 {
                    return (false, 0)
                }
                let lv = left_pair.1
                let rv = right_pair.1
                if e.bin_op == BinaryOp::OpAdd {
                    return (true, lv + rv)
                } else if e.bin_op == BinaryOp::OpSub {
                    return (true, lv - rv)
                } else if e.bin_op == BinaryOp::OpMul {
                    return (true, lv * rv)
                } else if e.bin_op == BinaryOp::OpDiv {
                    if rv == 0 { return (false, 0) }
                    return (true, lv / rv)
                } else if e.bin_op == BinaryOp::OpRem {
                    if rv == 0 { return (false, 0) }
                    return (true, lv % rv)
                }
            }
            (false, 0)
        }
        None => (false, 0)
    }
}

fn call_arg_types_compatible(arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if types_compatible(arg_ty, param_ty) {
        return true
    }
    // Directional borrow boundary: &!T can flow to &T.
    if param_ty.kind == TypeKind::TyRef && arg_ty.kind == TypeKind::TyRefMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    // Allow implicit borrow syntax at call boundaries: f(&T) <- x
    if arg_expr.kind == ExprKind::ExprIdent &&
       (param_ty.kind == TypeKind::TyRef || param_ty.kind == TypeKind::TyRefMut) {
        return types_compatible(arg_ty, call_ref_inner_or_self(param_ty))
    }
    false
}

// ============================================================
// Lower AST TypeExpr to internal TypeEntry
// ============================================================

impl Checker {
    fn lower_type_expr(self, te: TypeExpr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check type depth limit
        let depth_pair = self.check_type_depth(te.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        // Check complexity budget (cost = 1 for each type node)
        let complexity_pair = c.check_complexity(1, te.span)
        c = complexity_pair.0
        if !complexity_pair.1 {
            return (c.exit_type_depth(), ty_error())
        }
        let result = match te.kind {
            TypeNamed => c.lower_named_type(te.path)
            TypeUnit => (c, ty_unit())
            TypeNever => (c, ty_never())
            TypeInfer => (c, ty_unknown())
            TypeSelfUpper => (c, c.current_impl_type)
            TypeReference => c.lower_ref_type(te.inner)
            TypeRefMut => c.lower_ref_mut_type(te.inner)
            TypeArray => c.lower_array_type(te.inner, te.array_size)
            TypeTuple => c.lower_tuple_type(te.type_args)
            TypeFn => (c, ty_unknown())
            TypeKnowledge => c.lower_knowledge_type(te.knowledge_info)
            TypeModel => c.lower_model_type(te.type_args, te.span)
            TypePolicy => c.lower_policy_type(te.type_args, te.span)
            TypeAcquisitionPolicy => c.lower_acquisition_policy_type(te.type_args, te.span)
            TypeAcquisitionPlan => c.lower_acquisition_plan_type(te.type_args, te.span)
            TypeRecoursePolicy => c.lower_recourse_policy_type(te.type_args, te.span)
            TypeRecoursePlan => c.lower_recourse_plan_type(te.type_args, te.span)
            TypeTransitionPolicy => c.lower_transition_policy_type(te.type_args, te.span)
            TypeTransitionPlan => c.lower_transition_plan_type(te.type_args, te.span)
            TypeMonitoringPolicy => c.lower_monitoring_policy_type(te.type_args, te.span)
            TypeObservedTransition => c.lower_observed_transition_type(te.type_args, te.span)
            TypeRollbackCertificate => c.lower_rollback_certificate_type(te.type_args, te.span)
            TypeAlternativePolicy => c.lower_alternative_policy_type(te.type_args, te.span)
            TypeAlternativeSet => c.lower_alternative_set_type(te.type_args, te.span)
            TypeAlternativeOption => c.lower_alternative_option_type(te.type_args, te.span)
            TypeDecisionPolicy => c.lower_decision_policy_type(te.type_args, te.span)
            TypeDeferralPolicy => c.lower_deferral_policy_type(te.type_args, te.span)
            TypeContest => c.lower_contest_type(te.type_args, te.span)
            TypeRobust => c.lower_robust_type(te.type_args, te.span)
            TypeIntervention => c.lower_intervention_type(te.knowledge_info)
            TypeCounterfactual => c.lower_counterfactual_type(te.knowledge_info)
            TypeValidated => c.lower_validated_type(te.type_args, te.knowledge_info, te.span)
            TypeAdmissible => c.lower_admissible_type(te.type_args, te.span)
            TypeDeferred => c.lower_deferred_type(te.type_args, te.span)
            TypeRefinement => c.lower_refinement_type(te.refinement_info)
            TypeChan => c.lower_chan_type(te.inner)
            TypeSession => (c, ty_session_end())
            // Sprint 27: Annotation syntax
            TypeDiffPrivate => c.lower_diffprivate_type(te.type_args, te.span)
            TypeDPBudget => c.lower_dp_budget_type(te.type_args, te.span)
            TypeCausalEffect => c.lower_causal_effect_annotation(te.type_args, te.span)
            TypeAleatoric => c.lower_aleatoric_annotation(te.type_args, te.span)
            TypePotentialOutcome => c.lower_potential_outcome_type(te.type_args, te.span)
            TypeProof => c.lower_proof_annotation(te.type_args, te.span)
            TypeLemma => c.lower_lemma_annotation(te.type_args, te.span)
            TypeAxiom => c.lower_axiom_annotation(te.type_args, te.span)
        }
        (result.0.exit_type_depth(), result.1)
    }

    fn lower_chan_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let proto = pair.1
                (c, ty_chan(proto))
            }
            None => (self, ty_session_end())
        }
    }

    fn lower_named_type(self, path: AstPath) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let name = checker_copy_string_list_to_name(path.segments)
        if name_is_i8(name) {
            (self, ty_i8())
        } else if name_is_i32(name) {
            (self, ty_i32())
        } else if name_is_i64(name) {
            (self, ty_i64())
        } else if name_is_u8(name) {
            (self, ty_u8())
        } else if name_is_u32(name) {
            (self, ty_u32())
        } else if name_is_u64(name) {
            (self, ty_u64())
        } else if name_is_f32(name) {
            (self, ty_f32())
        } else if name_is_f64(name) {
            (self, ty_f64())
        } else if name_is_bool(name) {
            (self, ty_bool())
        } else if name_is_string(name) {
            (self, ty_string())
        } else if name_is_char(name) {
            (self, ty_char())
        } else {
            // Check if it's a registered unit name (mg, kg, m, s, etc.)
            let unit_idx = self.units.find(name)
            if unit_idx >= 0 {
                // Units resolve to f64 with a unit_id annotation
                (self, ty_with_unit(ty_f64(), unit_idx))
            } else {
                // Check if it's a refinement type alias
                let ref_idx = refinement_table_find(self.refinements, name)
                if ref_idx >= 0 {
                    // Resolve to base type with refinement_id annotation
                    let rt = self.refinements.entries[ref_idx as usize]
                    (self, ty_with_refinement(rt.base_type, ref_idx))
                } else {
                    let bound_ty = self.env.lookup(name)
                    if bound_ty.kind == TypeKind::TyModel
                        || bound_ty.kind == TypeKind::TyModelFamily
                        || bound_ty.kind == TypeKind::TyPolicy
                        || bound_ty.kind == TypeKind::TyAcquisitionPolicy
                        || bound_ty.kind == TypeKind::TyAcquisitionPlan
                        || bound_ty.kind == TypeKind::TyRecoursePolicy
                        || bound_ty.kind == TypeKind::TyRecoursePlan
                        || bound_ty.kind == TypeKind::TyTransitionPolicy
                        || bound_ty.kind == TypeKind::TyTransitionPlan
                        || bound_ty.kind == TypeKind::TyMonitoringPolicy
                        || bound_ty.kind == TypeKind::TyDecisionPolicy
                        || bound_ty.kind == TypeKind::TyDeferralPolicy
                        || bound_ty.kind == TypeKind::TyValidation {
                        (self, bound_ty)
                    } else {
                        (self, ty_named(name))
                    }
                }
            }
        }
    }

    fn lower_ref_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let inner_ty = pair.1
                (c, ty_ref(inner_ty))
            }
            None => (self, ty_error())
        }
    }

    fn lower_ref_mut_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let inner_ty = pair.1
                (c, ty_ref_mut(inner_ty))
            }
            None => (self, ty_error())
        }
    }

    fn lower_array_type(self, inner_opt: Option<Box<TypeExpr>>, size_opt: Option<Box<Expr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let elem_ty = pair.1
                let size = lower_array_size(size_opt)
                (c, ty_array(elem_ty, size))
            }
            None => (self, ty_error())
        }
    }

    fn lower_tuple_type(self, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tel) => {
                let pair = self.lower_type_expr_list(*tel)
                (pair.0, ty_tuple(pair.1))
            }
            None => (self, ty_unit())
        }
    }

    fn lower_type_expr_list(self, tel: TypeExprList) -> (Checker, TypeEntryList) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(tel.head)
        var c = pair.0
        let head_ty = pair.1
        let head_entry = TypeEntryList { head: head_ty, tail: None }
        match tel.tail {
            None => (c, head_entry)
            Some(rest) => {
                let pair2 = c.lower_type_expr_list(*rest)
                c = pair2.0
                let rest_list = pair2.1
                (c, TypeEntryList { head: head_ty, tail: Some(Box::new(rest_list)) })
            }
        }
    }

    fn lower_opt_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    fn robust_type_tag_from_type_expr(self, te: TypeExpr, is_level: bool) -> i64 with Mut, Panic, Div, Alloc, IO {
        if te.kind != TypeExprKind::TypeNamed {
            return -1
        }
        let name = checker_copy_string_list_to_name(te.path.segments)
        if is_level {
            robustness_level_id_from_name(name)
        } else {
            robustness_scope_id_from_name(name)
        }
    }

    fn lower_knowledge_type(self, opt: Option<Box<KnowledgeTypeInfo>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_knowledge_type(self, *info)
            None => (self, ty_error())
        }
    }

    fn lower_single_wrapper_arg(self, opt: Option<Box<TypeExprList>>, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                let first = (*args).head
                match (*args).tail {
                    Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                    None => self.lower_type_expr(first)
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

    fn lower_model_type(self, opt: Option<Box<TypeExprList>>, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                match (*args).tail {
                    Some(rest) => {
                        match (*rest).tail {
                            Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                            None => {
                                let in_pair = self.lower_type_expr((*args).head)
                                let out_pair = in_pair.0.lower_type_expr((*rest).head)
                                (out_pair.0, ty_model(in_pair.1, out_pair.1))
                            }
                        }
                    }
                    None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

    fn lower_policy_type(self, opt: Option<Box<TypeExprList>>, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_policy(pair.1, -1))
        }
    }

