// Main type checker — Checker struct, two passes, expression dispatch
//
// Pass 1: collect struct/enum/fn definitions into tables
// Pass 2: check function/method bodies for type consistency
//
// Methods return (Checker, ...) to thread state through value semantics.

use check::refinement::*

// ============================================================
// Security limits
// ============================================================

const MAX_TYPE_DEPTH: i64 = 64
const MAX_EXPR_DEPTH: i64 = 256
const MAX_LOOP_DEPTH: i64 = 1024
const MAX_TYPE_COMPLEXITY: i64 = 1000
const MAX_BORROW_ENTRIES: i64 = 128
const MAX_SCOPE_DEPTH: i64 = 64
const MAX_REFINEMENT_ENTRIES: i64 = 16
const MAX_CONST_INT_BINDINGS: i64 = 128
const ROBUST_LEVEL_FRAGILE: i64 = 0
const ROBUST_LEVEL_CONDITIONAL: i64 = 1
const ROBUST_LEVEL_STABLE: i64 = 2
const ROBUST_LEVEL_STRONG: i64 = 3
const ROBUST_LEVEL_INVARIANT: i64 = 4
const ROBUST_SCOPE_IN_DISTRIBUTION: i64 = 0
const ROBUST_SCOPE_EXTRAPOLATIVE: i64 = 1
const ROBUST_SCOPE_SUBGROUP_SPECIFIC: i64 = 2
const ROBUST_SCOPE_IDENTIFIED_FAMILY: i64 = 3
const ROBUST_SCOPE_TRANSPORTED_DOMAIN: i64 = 4
const CONTEST_WITNESS_SIGN_CONSENSUS: i64 = 0
const CONTEST_WITNESS_RELATIVE_BAND: i64 = 1
const CONTEST_WITNESS_MAX_TAIL_RISK: i64 = 2
const CONTEST_WITNESS_MECHANISTIC_DIVERGENCE: i64 = 3
const CONTEST_WITNESS_IDENTIFIABILITY_FLOOR: i64 = 4
const CONTEST_WITNESS_DISAGREEMENT: i64 = 5
const CONTEST_WITNESS_COUNTEREXAMPLE: i64 = 6
const CONTEST_WITNESS_POSTERIOR_WEIGHTS: i64 = 7
const DEFERRAL_EVIDENCE_CONTEST: i64 = 0
const DEFERRAL_EVIDENCE_ROBUST: i64 = 1
const DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT: i64 = 0
const DEFERRAL_REASON_MECHANISTIC_CONFLICT: i64 = 1
const DEFERRAL_REASON_COUNTEREXAMPLE_HAZARD: i64 = 2
const DEFERRAL_REASON_TAIL_RISK: i64 = 3
const DEFERRAL_REASON_IDENTIFIABILITY_GAP: i64 = 4
const DEFERRAL_REASON_TRANSPORT_GAP: i64 = 5
const DEFERRAL_REASON_POLICY_INCOMPLETE: i64 = 6
const ALTERNATIVE_SOURCE_DEFERRED: i64 = 0
const ALTERNATIVE_SOURCE_RECOURSE_PLAN: i64 = 1
const ALTERNATIVE_METRIC_INTERVENTION_COST: i64 = 0
const ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK: i64 = 1
const ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE: i64 = 2
const ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN: i64 = 3
const TRANSITION_METRIC_INTERVENTION_COST: i64 = 100
const TRANSITION_METRIC_RESIDUAL_TAIL_RISK: i64 = 101
const TRANSITION_METRIC_MECHANISTIC_DIVERGENCE: i64 = 102
const TRANSITION_METRIC_ADMISSIBILITY_MARGIN: i64 = 103

fn ir_alternative_metric_name(metric_id: i64) -> Name with Mut, Panic, Div {
    if metric_id == ALTERNATIVE_METRIC_INTERVENTION_COST {
        make_name("intervention_cost")
    } else if metric_id == ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK {
        make_name("residual_tail_risk")
    } else if metric_id == ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE {
        make_name("mechanistic_divergence")
    } else if metric_id == ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN {
        make_name("admissibility_margin")
    } else {
        make_name("unknown_metric")
    }
}

// ============================================================
// Checker state
// ============================================================

struct Checker {
    env: TypeEnv,
    borrows: BorrowEnv,
    units: UnitRegistry,
    refinements: RefinementTable,
    structs: StructTable,
    enums: EnumTable,
    fn_sigs: FnSigTable,
    models: ModelTable,
    model_families: ModelFamilyTable,
    policies: PolicyTable,
    decision_policies: DecisionPolicyTable,
    deferral_policies: DeferralPolicyTable,
    acquisition_policies: AcquisitionPolicyTable,
    recourse_policies: RecoursePolicyTable,
    alternative_policies: AlternativePolicyTable,
    validations: ValidationPolicyTable,
    contests: ContestTable,
    audits: AuditTable,
    mechanistic_reports: MechanisticReportTable,
    posterior_weights: PosteriorWeightsTable,
    counterexamples: CounterexampleTable,
    contest_witnesses: ContestWitnessTable,
    robust_proofs: RobustProofTable,
    decision_certificates: DecisionCertificateTable,
    deferred_certificates: DeferredCertificateTable,
    deferred_reason_witnesses: DeferredReasonWitnessTable,
    acquisition_plans: AcquisitionPlanTable,
    acquisition_reason_witnesses: AcquisitionReasonWitnessTable,
    recourse_plans: RecoursePlanTable,
    recourse_reason_witnesses: RecourseReasonWitnessTable,
    transition_policies: TransitionPolicyTable,
    transition_protocols: TransitionProtocolTable,
    transition_steps: TransitionStepTable,
    transition_plans: TransitionPlanTable,
    transition_reason_witnesses: TransitionReasonWitnessTable,
    monitoring_policies: MonitoringPolicyTable,
    observed_transitions: ObservedTransitionTable,
    rollback_certificates: RollbackCertificateTable,
    alternative_frontiers: AlternativeFrontierTable,
    alternative_candidates: AlternativeCandidateTable,
    alternative_sets: AlternativeSetTable,
    alternative_reason_witnesses: AlternativeReasonWitnessTable,
    validated_manifests: ValidatedManifestTable,
    error_count: i64,
    had_error: bool,
    current_return_type: TypeEntry,
    current_impl_type: TypeEntry,
    current_effects: [i64; 8],
    current_effect_count: i64,
    last_literal_int: i64,
    last_literal_float: f64,
    last_literal_kind: i64,   // 0=none, 1=int, 2=float
    loop_depth: i64,
    suppress_linear_consume_depth: i64,
    type_depth: i64,
    expr_depth: i64,
    complexity_budget: i64,
    const_int_names: [Name; 128],
    const_int_values: [i64; 128],
    const_int_known: [i64; 128], // 1=known constant int, 0=shadow/unknown
    const_int_count: i64,
    const_int_scope_marks: [i64; 64],
    const_int_scope_depth: i64,
    effects: EffectTable,
    effect_ops: EffectOpTable,
    handler_depth: i64,
    current_handler_op_id: i64,
}

fn checker_new() -> Checker with Mut, Panic, Div {
    Checker {
        env: type_env_new(),
        borrows: borrow_env_new(),
        units: register_builtin_units(unit_registry_new()),
        refinements: refinement_table_new(),
        structs: struct_table_new(),
        enums: enum_table_new(),
        fn_sigs: fn_sig_table_new(),
        models: model_table_new(),
        model_families: model_family_table_new(),
        policies: policy_table_new(),
        decision_policies: decision_policy_table_new(),
        deferral_policies: deferral_policy_table_new(),
        acquisition_policies: acquisition_policy_table_new(),
        recourse_policies: recourse_policy_table_new(),
        alternative_policies: alternative_policy_table_new(),
        validations: validation_policy_table_new(),
        contests: contest_table_new(),
        audits: audit_table_new(),
        mechanistic_reports: mechanistic_report_table_new(),
        posterior_weights: posterior_weights_table_new(),
        counterexamples: counterexample_table_new(),
        contest_witnesses: contest_witness_table_new(),
        robust_proofs: robust_proof_table_new(),
        decision_certificates: decision_certificate_table_new(),
        deferred_certificates: deferred_certificate_table_new(),
        deferred_reason_witnesses: deferred_reason_witness_table_new(),
        acquisition_plans: acquisition_plan_table_new(),
        acquisition_reason_witnesses: acquisition_reason_witness_table_new(),
        recourse_plans: recourse_plan_table_new(),
        recourse_reason_witnesses: recourse_reason_witness_table_new(),
        transition_policies: transition_policy_table_new(),
        transition_protocols: transition_protocol_table_new(),
        transition_steps: transition_step_table_new(),
        transition_plans: transition_plan_table_new(),
        transition_reason_witnesses: transition_reason_witness_table_new(),
        monitoring_policies: monitoring_policy_table_new(),
        observed_transitions: observed_transition_table_new(),
        rollback_certificates: rollback_certificate_table_new(),
        alternative_frontiers: alternative_frontier_table_new(),
        alternative_candidates: alternative_candidate_table_new(),
        alternative_sets: alternative_set_table_new(),
        alternative_reason_witnesses: alternative_reason_witness_table_new(),
        validated_manifests: validated_manifest_table_new(),
        error_count: 0,
        had_error: false,
        current_return_type: ty_unit(),
        current_impl_type: ty_error(),
        current_effects: [0; 8],
        current_effect_count: 0,
        last_literal_int: 0,
        last_literal_float: 0.0,
        last_literal_kind: 0,
        loop_depth: 0,
        suppress_linear_consume_depth: 0,
        type_depth: 0,
        expr_depth: 0,
        complexity_budget: 0,
        const_int_names: [Name { buf: [0; 128], len: 0 }; 128],
        const_int_values: [0; 128],
        const_int_known: [0; 128],
        const_int_count: 0,
        const_int_scope_marks: [0; 64],
        const_int_scope_depth: 0,
        effects: effect_table_new(),
        effect_ops: effect_op_table_new(),
        handler_depth: 0,
        current_handler_op_id: -1,
    }
}

fn check_policy_requirements_to_ir_export(
    opt: Option<Box<PolicyRequirementInfoList>>,
    out: [IrPolicyRequirementInfo; 8],
    idx: i64
) -> [IrPolicyRequirementInfo; 8] with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = out
            if idx < 8 {
                next[idx as usize] = IrPolicyRequirementInfo {
                    metric_id: (*list).head.metric_id,
                    metric_name: (*list).head.metric_name,
                    op: (*list).head.op,
                    threshold: (*list).head.threshold,
                    threshold_kind: (*list).head.threshold_kind,
                    bool_threshold: (*list).head.bool_threshold,
                    name_threshold: (*list).head.name_threshold,
                }
            }
            check_policy_requirements_to_ir_export((*list).tail, next, idx + 1)
        }
        None => out
    }
}

fn checker_export_ir_epistemic_into_local(checker: &Checker, ep: &! IrEpistemicSection) with Mut, Panic, Div, Alloc {
    ep.model_family_count = checker.model_families.count
    if ep.model_family_count > IR_MAX_EPI_MODEL_FAMILIES {
        ep.model_family_count = IR_MAX_EPI_MODEL_FAMILIES
    }
    var i: i64 = 0
    while i < ep.model_family_count {
        let info = checker.model_families.get(i)
        ep.model_families[i as usize] = IrModelFamilyInfo {
            id: i,
            name: info.name,
            model_names: info.model_names,
            model_count: info.model_count,
            input_ty: info.input_ty,
            output_ty: info.output_ty,
        }
        i = i + 1
    }

    ep.policy_count = checker.policies.count
    if ep.policy_count > IR_MAX_EPI_POLICIES {
        ep.policy_count = IR_MAX_EPI_POLICIES
    }
    i = 0
    while i < ep.policy_count {
        let info = checker.policies.get(i)
        ep.policies[i as usize] = IrPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            level_name: info.level_name,
            scope_name: info.scope_name,
            level_id: info.level_id,
            scope_id: info.scope_id,
            requirements: check_policy_requirements_to_ir_export(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: if info.requirement_count < 8 { info.requirement_count } else { 8 },
        }
        i = i + 1
    }

    ep.decision_policy_count = checker.decision_policies.count
    if ep.decision_policy_count > IR_MAX_EPI_DECISION_POLICIES {
        ep.decision_policy_count = IR_MAX_EPI_DECISION_POLICIES
    }
    i = 0
    while i < ep.decision_policy_count {
        let info = checker.decision_policies.get(i)
        ep.decision_policies[i as usize] = IrDecisionPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            requirements: check_policy_requirements_to_ir_export(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: if info.requirement_count < 8 { info.requirement_count } else { 8 },
        }
        i = i + 1
    }

    ep.deferral_policy_count = checker.deferral_policies.count
    if ep.deferral_policy_count > IR_MAX_EPI_DEFERRAL_POLICIES {
        ep.deferral_policy_count = IR_MAX_EPI_DEFERRAL_POLICIES
    }
    i = 0
    while i < ep.deferral_policy_count {
        let info = checker.deferral_policies.get(i)
        ep.deferral_policies[i as usize] = IrDeferralPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir_export(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: if info.requirement_count < 8 { info.requirement_count } else { 8 },
        }
        i = i + 1
    }

    ep.acquisition_policy_count = checker.acquisition_policies.count
    if ep.acquisition_policy_count > IR_MAX_EPI_ACQUISITION_POLICIES {
        ep.acquisition_policy_count = IR_MAX_EPI_ACQUISITION_POLICIES
    }
    i = 0
    while i < ep.acquisition_policy_count {
        let info = checker.acquisition_policies.get(i)
        ep.acquisition_policies[i as usize] = IrAcquisitionPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            objective_name: info.objective_name,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir_export(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: if info.requirement_count < 8 { info.requirement_count } else { 8 },
        }
        i = i + 1
    }

    ep.recourse_policy_count = checker.recourse_policies.count
    if ep.recourse_policy_count > IR_MAX_EPI_RECOURSE_POLICIES {
        ep.recourse_policy_count = IR_MAX_EPI_RECOURSE_POLICIES
    }
    i = 0
    while i < ep.recourse_policy_count {
        let info = checker.recourse_policies.get(i)
        ep.recourse_policies[i as usize] = IrRecoursePolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            strategy_name: info.strategy_name,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir_export(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: if info.requirement_count < 8 { info.requirement_count } else { 8 },
        }
        i = i + 1
    }

    ep.validation_count = checker.validations.count
    if ep.validation_count > IR_MAX_EPI_VALIDATIONS {
        ep.validation_count = IR_MAX_EPI_VALIDATIONS
    }
    i = 0
    while i < ep.validation_count {
        let info = checker.validations.get(i)
        ep.validations[i as usize] = IrValidationPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
        }
        i = i + 1
    }

    ep.mechanistic_report_count = checker.mechanistic_reports.count
    if ep.mechanistic_report_count > IR_MAX_EPI_MECHANISTIC_REPORTS {
        ep.mechanistic_report_count = IR_MAX_EPI_MECHANISTIC_REPORTS
    }
    i = 0
    while i < ep.mechanistic_report_count {
        let info = checker.mechanistic_reports.get(i)
        ep.mechanistic_reports[i as usize] = IrMechanisticReportInfo {
            id: i,
            latent_state_divergence: info.latent_state_divergence,
            causal_decomposition_divergence: info.causal_decomposition_divergence,
            intervention_response_divergence: info.intervention_response_divergence,
            parameter_role_divergence: info.parameter_role_divergence,
            structural_explanation_distance: info.structural_explanation_distance,
            aggregate_divergence: info.aggregate_divergence,
        }
        i = i + 1
    }

    ep.posterior_weights_count = checker.posterior_weights.count
    if ep.posterior_weights_count > IR_MAX_EPI_POSTERIOR_WEIGHTS {
        ep.posterior_weights_count = IR_MAX_EPI_POSTERIOR_WEIGHTS
    }
    i = 0
    while i < ep.posterior_weights_count {
        let info = checker.posterior_weights.get(i)
        ep.posterior_weights[i as usize] = IrPosteriorWeightsInfo {
            id: i,
            model_names: info.model_names,
            weights: info.weights,
            count: info.count,
        }
        i = i + 1
    }

    ep.counterexample_count = checker.counterexamples.count
    if ep.counterexample_count > IR_MAX_EPI_COUNTEREXAMPLES {
        ep.counterexample_count = IR_MAX_EPI_COUNTEREXAMPLES
    }
    i = 0
    while i < ep.counterexample_count {
        let info = checker.counterexamples.get(i)
        ep.counterexamples[i as usize] = IrCounterexampleInfo {
            id: i,
            model_name: info.model_name,
            subgroup_name: info.subgroup_name,
            metric_name: info.metric_name,
            observed_value: info.observed_value,
            threshold_value: info.threshold_value,
            summary: info.summary,
        }
        i = i + 1
    }

    ep.audit_count = checker.audits.count
    if ep.audit_count > IR_MAX_EPI_AUDITS {
        ep.audit_count = IR_MAX_EPI_AUDITS
    }
    i = 0
    while i < ep.audit_count {
        let info = checker.audits.get(i)
        ep.audits[i as usize] = IrAuditInfo {
            id: i,
            name: info.name,
            span_start: info.span_start,
            span_end: info.span_end,
            target_inner_ty: info.target_inner_ty,
            family_id: info.family_id,
            policy_id: info.policy_id,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
            mechanistic_report_id: info.mechanistic_report_id,
            posterior_weights_id: info.posterior_weights_id,
            counterexample_id: info.counterexample_id,
        }
        i = i + 1
    }

    ep.contest_count = checker.contests.count
    if ep.contest_count > IR_MAX_EPI_CONTESTS {
        ep.contest_count = IR_MAX_EPI_CONTESTS
    }
    i = 0
    while i < ep.contest_count {
        let info = checker.contests.get(i)
        ep.contests[i as usize] = IrContestInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            family_id: info.family_id,
            policy_id: info.policy_id,
            model_names: info.model_names,
            model_count: info.model_count,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
            mechanistic_report_id: info.mechanistic_report_id,
            posterior_weights_id: info.posterior_weights_id,
            counterexample_id: info.counterexample_id,
            provenance_bundle_id: info.provenance_bundle_id,
        }
        i = i + 1
    }

    ep.contest_witness_count = checker.contest_witnesses.count
    if ep.contest_witness_count > IR_MAX_EPI_CONTEST_WITNESSES {
        ep.contest_witness_count = IR_MAX_EPI_CONTEST_WITNESSES
    }
    i = 0
    while i < ep.contest_witness_count {
        let info = checker.contest_witnesses.get(i)
        ep.contest_witnesses[i as usize] = IrContestWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            witness_kind: info.witness_kind,
            contest_id: info.contest_id,
        }
        i = i + 1
    }

    ep.robust_proof_count = checker.robust_proofs.count
    if ep.robust_proof_count > IR_MAX_EPI_ROBUST_PROOFS {
        ep.robust_proof_count = IR_MAX_EPI_ROBUST_PROOFS
    }
    i = 0
    while i < ep.robust_proof_count {
        let info = checker.robust_proofs.get(i)
        ep.robust_proofs[i as usize] = IrRobustProofInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            policy_id: info.policy_id,
            level_id: info.level_id,
            scope_id: info.scope_id,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.decision_certificate_count = checker.decision_certificates.count
    if ep.decision_certificate_count > IR_MAX_EPI_DECISION_CERTIFICATES {
        ep.decision_certificate_count = IR_MAX_EPI_DECISION_CERTIFICATES
    }
    i = 0
    while i < ep.decision_certificate_count {
        let info = checker.decision_certificates.get(i)
        ep.decision_certificates[i as usize] = IrDecisionCertificateInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            robust_proof_id: info.robust_proof_id,
            decision_policy_id: info.decision_policy_id,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.deferred_certificate_count = checker.deferred_certificates.count
    if ep.deferred_certificate_count > IR_MAX_EPI_DEFERRED_CERTIFICATES {
        ep.deferred_certificate_count = IR_MAX_EPI_DEFERRED_CERTIFICATES
    }
    i = 0
    while i < ep.deferred_certificate_count {
        let info = checker.deferred_certificates.get(i)
        ep.deferred_certificates[i as usize] = IrDeferredCertificateInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            robust_proof_id: info.robust_proof_id,
            deferral_policy_id: info.deferral_policy_id,
            evidence_kind: info.evidence_kind,
            reason_code: info.reason_code,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.deferred_reason_witness_count = checker.deferred_reason_witnesses.count
    if ep.deferred_reason_witness_count > IR_MAX_EPI_DEFERRED_REASON_WITNESSES {
        ep.deferred_reason_witness_count = IR_MAX_EPI_DEFERRED_REASON_WITNESSES
    }
    i = 0
    while i < ep.deferred_reason_witness_count {
        let info = checker.deferred_reason_witnesses.get(i)
        ep.deferred_reason_witnesses[i as usize] = IrDeferredReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            deferred_certificate_id: info.deferred_certificate_id,
        }
        i = i + 1
    }

    ep.acquisition_plan_count = checker.acquisition_plans.count
    if ep.acquisition_plan_count > IR_MAX_EPI_ACQUISITION_PLANS {
        ep.acquisition_plan_count = IR_MAX_EPI_ACQUISITION_PLANS
    }
    i = 0
    while i < ep.acquisition_plan_count {
        let info = checker.acquisition_plans.get(i)
        ep.acquisition_plans[i as usize] = IrAcquisitionPlanInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            deferred_certificate_id: info.deferred_certificate_id,
            acquisition_policy_id: info.acquisition_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            objective_name: info.objective_name,
            route_name: info.route_name,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.acquisition_reason_witness_count = checker.acquisition_reason_witnesses.count
    if ep.acquisition_reason_witness_count > IR_MAX_EPI_ACQUISITION_REASON_WITNESSES {
        ep.acquisition_reason_witness_count = IR_MAX_EPI_ACQUISITION_REASON_WITNESSES
    }
    i = 0
    while i < ep.acquisition_reason_witness_count {
        let info = checker.acquisition_reason_witnesses.get(i)
        ep.acquisition_reason_witnesses[i as usize] = IrAcquisitionReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            acquisition_plan_id: info.acquisition_plan_id,
        }
        i = i + 1
    }

    ep.recourse_plan_count = checker.recourse_plans.count
    if ep.recourse_plan_count > IR_MAX_EPI_RECOURSE_PLANS {
        ep.recourse_plan_count = IR_MAX_EPI_RECOURSE_PLANS
    }
    i = 0
    while i < ep.recourse_plan_count {
        let info = checker.recourse_plans.get(i)
        ep.recourse_plans[i as usize] = IrRecoursePlanInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            deferred_certificate_id: info.deferred_certificate_id,
            recourse_policy_id: info.recourse_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            strategy_name: info.strategy_name,
            route_name: info.route_name,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.recourse_reason_witness_count = checker.recourse_reason_witnesses.count
    if ep.recourse_reason_witness_count > IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        ep.recourse_reason_witness_count = IR_MAX_EPI_RECOURSE_REASON_WITNESSES
    }
    i = 0
    while i < ep.recourse_reason_witness_count {
        let info = checker.recourse_reason_witnesses.get(i)
        ep.recourse_reason_witnesses[i as usize] = IrRecourseReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            recourse_plan_id: info.recourse_plan_id,
        }
        i = i + 1
    }

    ep.transition_policy_count = checker.transition_policies.count
    if ep.transition_policy_count > IR_MAX_EPI_TRANSITION_POLICIES {
        ep.transition_policy_count = IR_MAX_EPI_TRANSITION_POLICIES
    }
    i = 0
    while i < ep.transition_policy_count {
        let info = checker.transition_policies.get(i)
        ep.transition_policies[i as usize] = IrTransitionPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
            max_steps: info.max_steps,
            rollback_route_name: info.rollback_route_name,
        }
        i = i + 1
    }

    ep.transition_protocol_count = checker.transition_protocols.count
    if ep.transition_protocol_count > IR_MAX_EPI_TRANSITION_PROTOCOLS {
        ep.transition_protocol_count = IR_MAX_EPI_TRANSITION_PROTOCOLS
    }
    i = 0
    while i < ep.transition_protocol_count {
        let info = checker.transition_protocols.get(i)
        let step_start: i64 = if info.step_count > 0 { info.step_ids[0] } else { -1 }
        ep.transition_protocols[i as usize] = IrTransitionProtocolInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            transition_policy_id: info.transition_policy_id,
            step_start: step_start,
            step_count: info.step_count,
        }
        i = i + 1
    }

    ep.transition_step_count = checker.transition_steps.count
    if ep.transition_step_count > IR_MAX_EPI_TRANSITION_STEPS {
        ep.transition_step_count = IR_MAX_EPI_TRANSITION_STEPS
    }
    i = 0
    while i < ep.transition_step_count {
        let info = checker.transition_steps.get(i)
        ep.transition_steps[i as usize] = IrTransitionStepInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            protocol_id: info.protocol_id,
            name: info.name,
            value_repr: info.value_repr,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
        }
        i = i + 1
    }

    ep.transition_plan_count = checker.transition_plans.count
    if ep.transition_plan_count > IR_MAX_EPI_TRANSITION_PLANS {
        ep.transition_plan_count = IR_MAX_EPI_TRANSITION_PLANS
    }
    i = 0
    while i < ep.transition_plan_count {
        let info = checker.transition_plans.get(i)
        ep.transition_plans[i as usize] = IrTransitionPlanInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_policy_id: info.transition_policy_id,
            transition_protocol_id: info.transition_protocol_id,
            alternative_option_id: info.alternative_option_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            step_count: info.step_count,
            final_value_repr: info.final_value_repr,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.transition_reason_witness_count = checker.transition_reason_witnesses.count
    if ep.transition_reason_witness_count > IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        ep.transition_reason_witness_count = IR_MAX_EPI_TRANSITION_REASON_WITNESSES
    }
    i = 0
    while i < ep.transition_reason_witness_count {
        let info = checker.transition_reason_witnesses.get(i)
        ep.transition_reason_witnesses[i as usize] = IrTransitionReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
        }
        i = i + 1
    }

    ep.monitoring_policy_count = checker.monitoring_policies.count
    if ep.monitoring_policy_count > IR_MAX_EPI_MONITORING_POLICIES {
        ep.monitoring_policy_count = IR_MAX_EPI_MONITORING_POLICIES
    }
    i = 0
    while i < ep.monitoring_policy_count {
        let info = checker.monitoring_policies.get(i)
        ep.monitoring_policies[i as usize] = IrMonitoringPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
            rollback_route_name: info.rollback_route_name,
        }
        i = i + 1
    }

    ep.observed_transition_count = checker.observed_transitions.count
    if ep.observed_transition_count > IR_MAX_EPI_OBSERVED_TRANSITIONS {
        ep.observed_transition_count = IR_MAX_EPI_OBSERVED_TRANSITIONS
    }
    i = 0
    while i < ep.observed_transition_count {
        let info = checker.observed_transitions.get(i)
        ep.observed_transitions[i as usize] = IrObservedTransitionInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
            monitoring_policy_id: info.monitoring_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.rollback_certificate_count = checker.rollback_certificates.count
    if ep.rollback_certificate_count > IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        ep.rollback_certificate_count = IR_MAX_EPI_ROLLBACK_CERTIFICATES
    }
    i = 0
    while i < ep.rollback_certificate_count {
        let info = checker.rollback_certificates.get(i)
        ep.rollback_certificates[i as usize] = IrRollbackCertificateInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
            monitoring_policy_id: info.monitoring_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            reason_code: info.reason_code,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.alternative_policy_count = checker.alternative_policies.count
    if ep.alternative_policy_count > IR_MAX_EPI_ALTERNATIVE_POLICIES {
        ep.alternative_policy_count = IR_MAX_EPI_ALTERNATIVE_POLICIES
    }
    i = 0
    while i < ep.alternative_policy_count {
        let info = checker.alternative_policies.get(i)
        var objective_names: [Name; 8] = [ir_empty_name(); 8]
        var j: i64 = 0
        while j < info.objective_count && j < 8 {
            objective_names[j as usize] = ir_alternative_metric_name(info.objective_metric_ids[j as usize])
            j = j + 1
        }
        ep.alternative_policies[i as usize] = IrAlternativePolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            frontier_kind: info.frontier_name,
            objective_names: objective_names,
            objective_directions: info.objective_directions,
            objective_count: info.objective_count,
            max_options: info.max_options,
        }
        i = i + 1
    }

    ep.alternative_frontier_count = checker.alternative_frontiers.count
    if ep.alternative_frontier_count > IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        ep.alternative_frontier_count = IR_MAX_EPI_ALTERNATIVE_FRONTIERS
    }
    i = 0
    while i < ep.alternative_frontier_count {
        let info = checker.alternative_frontiers.get(i)
        let candidate_start: i64 = if info.candidate_count > 0 { info.candidate_ids[0] } else { -1 }
        ep.alternative_frontiers[i as usize] = IrAlternativeFrontierInfo {
            id: i,
            name: info.name,
            target_kind: info.target_kind,
            target_ty: info.target_ty,
            alternative_policy_id: info.policy_id,
            audit_id: -1,
            contest_id: -1,
            source_policy_id: -1,
            source_plan_id: -1,
            candidate_start: candidate_start,
            candidate_count: info.candidate_count,
        }
        i = i + 1
    }

    ep.alternative_candidate_count = checker.alternative_candidates.count
    if ep.alternative_candidate_count > IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        ep.alternative_candidate_count = IR_MAX_EPI_ALTERNATIVE_CANDIDATES
    }
    i = 0
    while i < ep.alternative_candidate_count {
        let info = checker.alternative_candidates.get(i)
        ep.alternative_candidates[i as usize] = IrAlternativeCandidateInfo {
            id: i,
            frontier_id: info.frontier_id,
            name: info.name,
            value_repr: info.value_repr,
            source_kind: info.source_kind,
            source_policy_id: info.source_policy_id,
            source_plan_id: info.source_plan_id,
            strategy_name: info.strategy_name,
            route_name: info.route_name,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            intervention_cost: info.metric_values[ALTERNATIVE_METRIC_INTERVENTION_COST as usize],
            residual_tail_risk: info.metric_values[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize],
            mechanistic_divergence: info.metric_values[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize],
            admissibility_margin: info.metric_values[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize],
            dominance_rank: info.dominance_rank,
        }
        i = i + 1
    }

    ep.alternative_set_count = checker.alternative_sets.count
    if ep.alternative_set_count > IR_MAX_EPI_ALTERNATIVE_SETS {
        ep.alternative_set_count = IR_MAX_EPI_ALTERNATIVE_SETS
    }
    i = 0
    while i < ep.alternative_set_count {
        let info = checker.alternative_sets.get(i)
        let candidate_start: i64 = if info.candidate_count > 0 { info.candidate_ids[0] } else { -1 }
        ep.alternative_sets[i as usize] = IrAlternativeSetInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            frontier_id: info.frontier_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            inner_ty: info.inner_ty,
            candidate_start: candidate_start,
            candidate_count: info.candidate_count,
        }
        i = i + 1
    }

    ep.alternative_reason_witness_count = checker.alternative_reason_witnesses.count
    if ep.alternative_reason_witness_count > IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        ep.alternative_reason_witness_count = IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES
    }
    i = 0
    while i < ep.alternative_reason_witness_count {
        let info = checker.alternative_reason_witnesses.get(i)
        ep.alternative_reason_witnesses[i as usize] = IrAlternativeReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            alternative_set_id: -1,
            candidate_id: info.candidate_id,
        }
        i = i + 1
    }

    ep.validated_manifest_count = checker.validated_manifests.count
    if ep.validated_manifest_count > IR_MAX_EPI_VALIDATED_MANIFESTS {
        ep.validated_manifest_count = IR_MAX_EPI_VALIDATED_MANIFESTS
    }
    i = 0
    while i < ep.validated_manifest_count {
        let info = checker.validated_manifests.get(i)
        ep.validated_manifests[i as usize] = IrValidatedManifestInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            robust_proof_id: info.robust_proof_id,
            validation_id: info.validation_id,
            inner_ty: info.inner_ty,
        }
        i = i + 1
    }
}

// ============================================================
// Error reporting
// ============================================================

// ============================================================
// Type pretty-printing for diagnostics
// ============================================================

fn print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    match ty.kind {
        TyI8 => print("i8")
        TyI32 => print("i32")
        TyI64 => print("i64")
        TyU8 => print("u8")
        TyU32 => print("u32")
        TyU64 => print("u64")
        TyF32 => print("f32")
        TyF64 => print("f64")
        TyBool => print("bool")
        TyUnit => print("()")
        TyString => print("string")
        TyChar => print("char")
        TyNamed => {
            var i: i64 = 0
            while i < ty.name.len {
                print_char(ty.name.buf[i] as i64)
                i = i + 1
            }
        }
        TyArray => {
            print("[")
            match ty.inner {
                Some(elem) => print_type_name(*elem)
                None => print("?")
            }
            if ty.array_size >= 0 {
                print("; ")
                print_int(ty.array_size)
            }
            print("]")
        }
        TyRef => {
            print("&")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyRefMut => {
            print("&!")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyTuple => {
            print("(")
            print_tuple_type_elems(ty.tuple_elems)
            print(")")
        }
        TyFn => {
            print("fn#")
            print_int(ty.fn_sig_id)
        }
        TyKnowledge => {
            print("Knowledge<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            if ty.knowledge_epsilon >= 0.0 {
                // Print epsilon as integer percentage for diagnostics
                // (no float printing in Poseidon VM)
                print(", eps=")
                print_milli_ratio(ty.knowledge_epsilon)
            }
            print(">")
        }
        TyModel => {
            print("Model<")
            print_type_name(type_entry_list_get(ty.tuple_elems, 0))
            print(", ")
            print_type_name(type_entry_list_get(ty.tuple_elems, 1))
            print(">")
        }
        TyModelFamily => {
            print("ModelFamily<")
            print_type_name(type_entry_list_get(ty.tuple_elems, 0))
            print(", ")
            print_type_name(type_entry_list_get(ty.tuple_elems, 1))
            print(">")
        }
        TyPolicy => {
            print("Policy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAcquisitionPolicy => {
            print("AcquisitionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAcquisitionPlan => {
            print("AcquisitionPlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRecoursePolicy => {
            print("RecoursePolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRecoursePlan => {
            print("RecoursePlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativePolicy => {
            print("AlternativePolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativeSet => {
            print("AlternativeSet<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativeOption => {
            print("AlternativeOption<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyTransitionPolicy => {
            print("TransitionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyTransitionPlan => {
            print("TransitionPlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDecisionPolicy => {
            print("DecisionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDeferralPolicy => {
            print("DeferralPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyContest => {
            print("Contest<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRobust => {
            print("Robust<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            if ty.robustness_level_id >= 0 || ty.robustness_scope_id >= 0 {
                print(", level=")
                print_int(ty.robustness_level_id)
                print(", scope=")
                print_int(ty.robustness_scope_id)
            }
            print(">")
        }
        TyIntervention => {
            print("Intervention<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyCounterfactual => {
            print("Counterfactual<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyValidated => {
            print("Validated<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAdmissible => {
            print("Admissible<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDeferred => {
            print("Deferred<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyValidation => {
            print("Validation<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyHyper => {
            print("Hyper<")
            if ty.algebra_kind == 0 { print("Real") }
            else if ty.algebra_kind == 1 { print("Complex") }
            else if ty.algebra_kind == 2 { print("Quaternion") }
            else if ty.algebra_kind == 3 { print("Octonion") }
            else if ty.algebra_kind == 4 { print("Sedenion") }
            else if ty.algebra_kind == 5 {
                print("Clifford(")
                print_int(ty.clifford_p)
                print(",")
                print_int(ty.clifford_q)
                print(")")
            }
            else { print("?") }
            print(", ")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TySession => {
            let step_label = if ty.array_size == 0 { "send" } else if ty.array_size == 1 { "recv" } else { "close" }
            print("Session(")
            print(step_label)
            print(")")
        }
        TyChan => {
            print("chan ")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TySessionEnd => print("SessionEnd")
        TySingleton => {
            print("Singleton<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", ")
            print_name_value(ty.name)
            print(">")
        }
        TyScopedEffect => {
            print("ScopedEffect<")
            print_name_value(ty.name)
            print(", ε=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyCondIndep => {
            print("IndepKnowledge<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", a=")
            print_int(ty.array_size)
            print(", b=")
            print_int(ty.fn_sig_id)
            if ty.epistemic_meta_id >= 0 {
                print(" | cond=")
                print_int(ty.epistemic_meta_id)
            }
            print(">")
        }
        TyPotentialOutcome => {
            print("PotentialOutcome<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", ctrl=")
            print_int(ty.epistemic_meta_id)
            print(", treat=")
            print_int(ty.robustness_level_id)
            print(">")
        }
        TyATE => {
            print("ATE<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDiffPrivate => {
            print("DiffPrivate<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", e=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyDPBudget => {
            print("DPBudget<total=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(", spent=")
            print_milli_ratio_i64(ty.array_size)
            print(">")
        }
