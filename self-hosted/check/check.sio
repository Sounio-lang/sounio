// acknowledge(k: Knowledge<T>, reason: string) -> T. lean_single builtin.
fn checker_check_acknowledge_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let k_ty = checker_check_opt_expr_inplace(c, first_arg)
    let _reason_ty = checker_check_opt_expr_inplace(c, second_arg)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    // acknowledge is the explicit discharge operation. Requiring Epistemic
    // here would make the E170 help ("use acknowledge") self-contradictory.
    if k_ty.kind == TypeKind::TyKnowledge {
        return knowledge_inner(k_ty)
    }
    if !is_error_or_unknown(k_ty) {
        checker_report_error_at_inplace(c, e.span, 9, 0, 0, 0)
    }
    ty_error()
}

fn knowledge_confidence_label(name: Name) -> bool with Panic, Div {
    if name_matches_str1(name, 101) { return true } // e
    if name_matches_str7(name, 101, 112, 115, 105, 108, 111, 110) { return true } // epsilon
    // UTF-8 epsilon (U+03B5): 0xCE 0xB5, stored in the parser's i8 name buffer.
    name.len == 2 && name.buf[0] == 206 as i8 && name.buf[1] == 181 as i8
}

fn knowledge_ctor_confidence(args: Option<Box<ExprList> >) -> f64 with Mut, Panic, Div, Alloc {
    var cursor = args
    var position: i64 = 0
    while true {
        match cursor {
            Some(list) => {
                // The lexer recovery path accepts the Unicode epsilon label but
                // may not preserve its bytes in ExprList.label. The constructor
                // ABI is stable: confidence is argument 2, so position is the
                // authoritative fallback when the label is unavailable.
                if knowledge_confidence_label((*list).label) || position == 1 {
                    if (*list).head.kind == ExprKind::ExprFloatLit {
                        return (*list).head.float_val
                    }
                    if (*list).head.kind == ExprKind::ExprIntLit {
                        return (*list).head.int_val as f64
                    }
                    return 0.0 - 1.0
                }
                cursor = (*list).tail
                position = position + 1
            }
            None => return 0.0 - 1.0
        }
    }
    0.0 - 1.0
}

fn checker_current_epistemic_min_inplace(c: *mut Checker) -> i64 with Mut, Panic, Div {
    let sig_id = (*c).current_sig_id
    if sig_id < 0 { return 0 - 1 }
    let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
    if !name_eq(sig.name, (*c).current_sig_name) { return 0 - 1 }
    sig.epistemic_min_confidence
}

fn checker_enforce_knowledge_confidence_inplace(c: *mut Checker, args: Option<Box<ExprList> >, span: Span) -> f64 with Mut, Panic, Div, Alloc, IO {
    let confidence = knowledge_ctor_confidence(args)
    let minimum = checker_current_epistemic_min_inplace(c)
    let confidence_milli = if confidence < 0.0 { 1 } else { (confidence * 1000.0 + 0.5) as i64 }
    if minimum > 0 && confidence_milli < minimum {
        checker_report_error_at_inplace(c, span, 215, confidence_milli, minimum, 0)
    }
    confidence
}

fn checker_check_knowledge_ctor_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // Knowledge(v, e=<confidence>, prov=<provenance>) -> Knowledge<T>.
    let first_arg = expr_list_head(e.args)
    let v_ty = checker_check_opt_expr_inplace(c, first_arg)
    let confidence = checker_enforce_knowledge_confidence_inplace(c, e.args, e.span)
    var result = ty_knowledge(v_ty, confidence)
    // N2 (REQ-2): this ctor wraps a plain value directly -- no independent
    // measurement source is created (that is measure()'s job, above), so the
    // result carries NO uncertainty sources: empty (0), not unknown (-1).
    // Sabotage leaves it at ty_knowledge's -1 default instead.
    if !checker_ns_sabotage() {
        result.noise_set_id = ns_empty()
    }
    checker_ns_trace_emit("knowledge_ctor", result.noise_set_id)
    result
}

fn checker_check_variance_metric_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        None => {}
    }
    checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
    ty_f64()
}

// hessian_of(x, j, k) -> f64. THREE arguments.

// correlate(a, b, rho) -> f64. THREE arguments, all required. Neither the
// variance form (one) nor the sensitivity form (two) will do: each reports E010
// on the argument it does not expect. A missing rho must be an error rather
// than a silent 0.0, which would read as "these are independent" -- the very
// assumption this builtin exists to let you deny.
// A compile-time correlation coefficient, or (false, 0.0) when it is not one.
//
// Same two forms as epistemic_index_literal, for the same reason: this dialect
// writes a negative literal as `0.0 - 0.5`, an ExprBinary. The lowerer read
// only ExprFloatLit, so a negative rho -- the one case in GUM where
// correlation is interesting -- folded to 0.0 in silence, which is the exact
// assumption `correlate` exists to deny.
fn correlate_rho_literal(opt: Option<Box<Expr> >) -> (bool, f64) with Mut, Panic, Div, Alloc, IO {
    match opt {
        None => (false, 0.0)
        Some(ex) => {
            if (*ex).kind == ExprKind::ExprFloatLit {
                return (true, (*ex).float_val)
            }
            if (*ex).kind == ExprKind::ExprBinary && (*ex).bin_op == BinaryOp::OpSub {
                let l = expr_opt_get((*ex).left)
                let r = expr_opt_get((*ex).right)
                if (*l).kind == ExprKind::ExprFloatLit && (*r).kind == ExprKind::ExprFloatLit {
                    if (*l).float_val == 0.0 {
                        return (true, 0.0 - (*r).float_val)
                    }
                }
            }
            (false, 0.0)
        }
    }
}

fn checker_check_correlate_metric_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let third_arg = expr_list_third(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match third_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(rho_ex) => {
            // rho must fold at compile time. The lowerer keeps a f64, not a
            // register, so a runtime third argument never propagates -- it
            // silently leaves rho at 0.0, fabricating the very independence
            // this builtin exists to deny. There is no lowering to fall back
            // on, so refusing is the only honest answer.
            let rho_lit_7930 = correlate_rho_literal(Some(rho_ex))
            if !rho_lit_7930.0 {
                checker_report_error_at_inplace(c, e.span, 243, 0, 0, 0)
            }
        }
    }
    checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
    ty_f64()
}
// slice_len(s: &[T]) -> i64. Inplace transcription of check_slice_len_call_expr —
// the by-value bridge SRET-smashed on populated enum tables (slice_fat_pointers crash).
fn checker_check_assert_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        None => {}
    }
    let cond_ty = checker_check_opt_expr_inplace(c, first_arg)
    if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
        checker_report_mismatch_inplace(c, e.span, 174, ty_bool(), cond_ty)
    }
    ty_unit()
}

// A compile-time channel index, or (false, 0) when it is not one.
//
// Two forms, because this dialect writes a negative literal as `0 - 1`: an
// ExprIntLit, and an ExprBinary OpSub whose left is the literal 0. Reading only
// the first let hessian_of(x*x, 0 - 1, 0) through -- the refusal gate caught it
// on the very run that was meant to prove the gate green, which is the whole
// point of writing the expected numbers down first.
fn epistemic_index_literal(opt: Option<Box<Expr> >) -> (bool, i64) with Mut, Panic, Div, Alloc, IO {
    match opt {
        None => (false, 0)
        Some(ex) => {
            if (*ex).kind == ExprKind::ExprIntLit {
                return (true, (*ex).int_val)
            }
            if (*ex).kind == ExprKind::ExprBinary && (*ex).bin_op == BinaryOp::OpSub {
                let l = expr_opt_get((*ex).left)
                let r = expr_opt_get((*ex).right)
                if (*l).kind == ExprKind::ExprIntLit && (*r).kind == ExprKind::ExprIntLit {
                    if (*l).int_val == 0 {
                        return (true, 0 - (*r).int_val)
                    }
                }
            }
            (false, 0)
        }
    }
}

fn checker_check_hessian_metric_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // hessian_of(expr, j, k) -> f64. THREE arguments, and j,k inside 0..8.
    //
    // It used to require only the first. hessian_of(x*x) then type-checked,
    // lowered through `if j >= 0 && j < 8 && k >= 0 && k < 8` with j = k = -1,
    // missed, and returned 0.0 -- while the true H_00 is 2.0. Out-of-range
    // literals did the same. In this algebra a zero Hessian is the claim "no
    // second-order dependence", which is the strongest thing the system can
    // say, handed back silently in the case where it knows least.
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let third_arg = expr_list_third(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(idx) => {
            let lit_idx_7927 = epistemic_index_literal(Some(idx))
            if lit_idx_7927.0 {
                if lit_idx_7927.1 < 0 || lit_idx_7927.1 >= 8 {
                    checker_report_error_at_inplace(c, e.span, 242, lit_idx_7927.1, 8, 0)
                }
            }
        }
    }
    match third_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(idx2) => {
            let lit_idx2_7937 = epistemic_index_literal(Some(idx2))
            if lit_idx2_7937.0 {
                if lit_idx2_7937.1 < 0 || lit_idx2_7937.1 >= 8 {
                    checker_report_error_at_inplace(c, e.span, 242, lit_idx2_7937.1, 8, 0)
                }
            }
        }
    }
    checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
    ty_f64()
}

// sensitivity_of(x, k) -> f64. TWO arguments, so it cannot reuse
// checker_check_variance_metric_expr_inplace, which reports E010 on a second one.
fn checker_check_sensitivity_metric_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // sensitivity_of(x, k) -> f64, k inside 0..32.
    //
    // Same reason as hessian_of above: sensitivity_of(x, 99) lowered through
    // `if chan >= 0 && chan < 32`, missed, and returned 0.0 -- "x does not
    // depend on channel 99", stated with confidence about a channel that
    // cannot exist.
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(idx) => {
            let lit_idx_7966 = epistemic_index_literal(Some(idx))
            if lit_idx_7966.0 {
                if lit_idx_7966.1 < 0 || lit_idx_7966.1 >= 32 {
                    checker_report_error_at_inplace(c, e.span, 242, lit_idx_7966.1, 32, 0)
                }
            }
        }
    }
    checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
    ty_f64()
}

fn checker_check_print_i64_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        None => {}
    }
    let arg_ty = checker_check_opt_expr_inplace(c, first_arg)
    if checker_type_is_unobserved_like(arg_ty) {
        if !has_effect_id((*c).current_effects, (*c).current_effect_count, 13) {
            checker_report_unobserved_print_inplace(c, e.span)
        }
        var effects_unobserved: [i64; 8] = [0; 8]
        effects_unobserved[0] = 0
        checker_check_callee_effects_inplace(c, e.span, effects_unobserved, 1)
        return ty_unit()
    }
    if !is_error_or_unknown(arg_ty) && !checker_types_compatible_inplace(c, arg_ty, ty_i64()) {
        checker_report_mismatch_inplace(c, e.span, 9, ty_i64(), arg_ty)
    }
    var effects: [i64; 8] = [0; 8]
    effects[0] = 0
    checker_check_callee_effects_inplace(c, e.span, effects, 1)
    ty_unit()
}

fn checker_check_slice_len_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let call_start_borrows = (*c).borrows
    let arg_ty = checker_check_opt_expr_inplace(c, first_arg)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        None => {}
    }
    let is_ok =
        arg_ty.kind == TypeKind::TySlice
        || arg_ty.kind == TypeKind::TySliceMut
        || slice_param_accepts_array_ref(arg_ty, ty_slice(ty_unknown()))
    if !is_ok && !is_error_or_unknown(arg_ty) {
        checker_report_error_at_inplace(c, e.span, 9, 0, 0, 0)
    }
    checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
    ty_i64()
}

// Enum tuple-variant constructor detection (`Enum::Variant(args)`). Given the callee
// opt-expr, returns the enum table index if the callee is a 2+-segment path whose HEAD
// names an enum and whose LAST segment names a variant of it (e.g. `Event::B`); else -1.
// Mirrors checker_check_path_expr_inplace's head/last split. A tuple-variant call types
// as ty_named(enum_name) (like the path-expr handler), so it isn't a plain callable and
// would otherwise fall to E017. Single-segment paths have head==last; a bare enum name
// alone won't match a variant, so this stays scoped to true `Enum::Variant` callees.
fn call_expr_enum_variant_ctor_enum_idx(c: *mut Checker, opt: Option<Box<Expr> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprPath {
                return -1
            }
            let head_name = checker_copy_string_list_to_name((*expr).path.segments)
            let enum_idx = enum_table_find((*c).enums, head_name)
            if enum_idx < 0 {
                return -1
            }
            let variant_name = checker_copy_string_list_tail_to_name((*expr).path.segments)
            let ei = enum_table_get((*c).enums, enum_idx)
            if variant_info_list_has(ei.variants, variant_name) {
                return enum_idx
            }
            -1
        }
        None => -1
    }
}

fn call_expr_is_box_new(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprPath {
                return false
            }
            if (*expr).path.seg_count != 2 {
                return false
            }
            let head_name = checker_copy_string_list_to_name((*expr).path.segments)
            let tail_name = checker_copy_string_list_tail_to_name((*expr).path.segments)
            let head_ok = name_matches_str3(head_name, 66, 111, 120)
            let tail_ok = name_matches_str3(tail_name, 110, 101, 119)
            head_ok && tail_ok
        }
        None => false
    }
}

fn checker_check_box_new_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let call_start_borrows = (*c).borrows
    let arg_ty = checker_check_opt_expr_inplace(c, first_arg)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        Some(extra) => {
            let _extra_ty = checker_check_expr_inplace(c, *extra)
            checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        }
        None => {}
    }
    checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
    var box_ty = ty_named(make_name("Box"))
    box_ty.inner = Some(Box::new(arg_ty))
    box_ty
}

fn checker_fn_sigs_find_inplace(c: *mut Checker, name: Name) -> i64 with Mut, Panic, Div, Alloc, IO {
    // Prefer the free function defined in the module currently being checked.
    // Without this, multi-module visibility preflight (enforce_visibility=true)
    // resolves same-named private helpers to whichever module was collected
    // first and false-rejects later modules with E175. See
    // docs/audit/MADAROS_DUAL_GUM_KNOWLEDGE_IMPORT_2026-07-19.md.
    fn_sig_table_find_prefer_module((*c).fn_sigs, name, (*c).current_module_id)
}

fn checker_fn_sig_visible_inplace(c: *mut Checker, sig_id: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
    // #1627 / E175: a private `extern "C"` stub for a native-backend builtin must
    // not false-reject sibling modules that call the builtin by name. Same
    // allow-list as E250 (#1622). Without this, the first module that declared
    // `extern "C" { fn sqrt; }` owns a private sig that prefer_module falls
    // through to, and every later module's `sqrt(...)` becomes E175.
    if sig.is_extern && name_is_native_backend_builtin(sig.name) {
        return true
    }
    let vis_kind = sig.visibility_kind
    if vis_kind == VISIBILITY_PUB {
        return true
    }
    if vis_kind == VISIBILITY_PUB_CRATE {
        return true
    }
    if vis_kind == VISIBILITY_PUB_SUPER {
        return true
    }
    if vis_kind == VISIBILITY_PRIVATE {
        if sig.defining_module_id == (*c).current_module_id {
            return true
        }
    }
    visibility_allows_access(
        sig.visibility,
        sig.defining_module,
        (*c).current_module,
        (*c).crate_root,
    )
}

fn checker_struct_visible_inplace(c: *mut Checker, struct_idx: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    let vis_kind = (*(*c).structs).entries[struct_idx as usize].visibility_kind
    if vis_kind == VISIBILITY_PUB {
        return true
    }
    if vis_kind == VISIBILITY_PUB_CRATE {
        return true
    }
    if vis_kind == VISIBILITY_PUB_SUPER {
        return true
    }
    if vis_kind == VISIBILITY_PRIVATE {
        if (*(*c).structs).entries[struct_idx as usize].defining_module_id == (*c).current_module_id {
            return true
        }
    }
    visibility_allows_access(
        (*(*c).structs).entries[struct_idx as usize].visibility,
        (*(*c).structs).entries[struct_idx as usize].defining_module,
        (*c).current_module,
        (*c).crate_root,
    )
}

fn checker_enum_visible_inplace(c: *mut Checker, enum_idx: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    let vis_kind = (*(*c).enums).entries[enum_idx as usize].visibility_kind
    if vis_kind == VISIBILITY_PUB {
        return true
    }
    if vis_kind == VISIBILITY_PUB_CRATE {
        return true
    }
    if vis_kind == VISIBILITY_PUB_SUPER {
        return true
    }
    if vis_kind == VISIBILITY_PRIVATE {
        if (*(*c).enums).entries[enum_idx as usize].defining_module_id == (*c).current_module_id {
            return true
        }
    }
    visibility_allows_access(
        (*(*c).enums).entries[enum_idx as usize].visibility,
        (*(*c).enums).entries[enum_idx as usize].defining_module,
        (*c).current_module,
        (*c).crate_root,
    )
}

fn checker_reject_invalid_implicit_native_builtin_arity_inplace(c: *mut Checker, e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    match e.left {
        Some(callee) => {
            if (*callee).kind != ExprKind::ExprIdent {
                return false
            }
            let name = (*callee).name
            if !name_is_native_backend_builtin(name) {
                return false
            }
            // A declared function, including an extern declaration, has a real
            // FnSig and is checked by checker_check_call_args_inplace below.
            // This guard is only for implicit runtime builtins bound as TyUnknown.
            if checker_fn_sigs_find_inplace(c, name) >= 0 {
                return false
            }
            let argc = expr_list_handle_count(expr_list_handle(e.args))
            if native_backend_builtin_arity_is_valid(name, argc) {
                return false
            }
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
            return true
        }
        None => false
    }
}

fn checker_check_call_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if checker_reject_invalid_implicit_native_builtin_arity_inplace(c, e) {
        return ty_error()
    }
    if checker_expr_is_gpu_launch_invocation_call(e) {
        match e.left {
            Some(desc) => {
                checker_check_expr_list_no_type_no_linear_consume_inplace(c, (*desc).args)
            }
            None => {}
        }
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        return ty_unit()
    }
    if checker_expr_is_gpu_launch_descriptor_call(e) || checker_expr_is_gpu_sync_call(e) {
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        return ty_unit()
    }
    // Intercept the common epistemic builtin measure() with an inplace handler before the
    // by-value bridge below (which SRET-smashes on the 164KB Checker return).
    if call_expr_is_builtin_measure(e.left) {
        return checker_check_measure_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_new(e.left) {
        return checker_check_seq_new_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_push(e.left) {
        return checker_check_seq_push_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_get(e.left) {
        return checker_check_seq_get_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_set(e.left) {
        return checker_check_seq_set_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_len(e.left) {
        return checker_check_seq_len_expr_inplace(c, e)
    }
    if call_expr_is_builtin_seq_count(e.left) {
        return checker_check_seq_count_expr_inplace(c, e)
    }
    if call_expr_is_builtin_acknowledge(e.left) {
        return checker_check_acknowledge_expr_inplace(c, e)
    }
    if call_expr_is_builtin_knowledge_ctor(e.left) {
        return checker_check_knowledge_ctor_expr_inplace(c, e)
    }
    if call_expr_is_builtin_variance_of(e.left) {
        return checker_check_variance_metric_expr_inplace(c, e)
    }
    if call_expr_is_builtin_uncertainty_of(e.left) {
        return checker_check_variance_metric_expr_inplace(c, e)
    }
    if call_expr_is_builtin_sensitivity_of(e.left) {
        return checker_check_sensitivity_metric_expr_inplace(c, e)
    }
    if call_expr_is_builtin_hessian_of(e.left) {
        return checker_check_hessian_metric_expr_inplace(c, e)
    }
    // E2 is a mean, not a spread: it type-checks as the variance-family
    // metric -- one expression argument, f64 result, same as variance_of.
    if call_expr_is_builtin_second_order_mean(e.left) {
        return checker_check_variance_metric_expr_inplace(c, e)
    }
    // correlate(a, b, rho) is three arguments, not one. Routing it to
    // checker_check_variance_metric_expr_inplace reports E010 on the second --
    // exactly what the comment on checker_check_sensitivity_metric_expr_inplace
    // warns about, and exactly what I did on the first attempt.
    if call_expr_is_builtin_correlate(e.left) {
        return checker_check_correlate_metric_expr_inplace(c, e)
    }
    if call_expr_is_builtin_slice_len(e.left) {
        return checker_check_slice_len_expr_inplace(c, e)
    }
    if call_expr_is_builtin_assert(e.left) {
        return checker_check_assert_expr_inplace(c, e)
    }
    if call_expr_is_builtin_print_int(e.left) {
        return checker_check_print_i64_expr_inplace(c, e)
    }
    if call_expr_is_builtin_print_char(e.left) {
        return checker_check_print_i64_expr_inplace(c, e)
    }
    if call_expr_is_builtin_println(e.left) {
        let first_arg = expr_list_head(e.args)
        let arg_ty = checker_check_opt_expr_inplace(c, first_arg)
        if checker_type_is_unobserved_like(arg_ty) {
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, 13) {
                checker_report_unobserved_print_inplace(c, e.span)
            }
            var effects_unobserved: [i64; 8] = [0; 8]
            effects_unobserved[0] = 0
            checker_check_callee_effects_inplace(c, e.span, effects_unobserved, 1)
            return ty_unit()
        }
    }
    // Read-only GPU thread-index intrinsics (gpu_thread_id_*, gpu_block_id_*,
    // gpu_block_dim_*, gpu_barrier, gpu_sync_threads): implicit kernel builtins
    // with no user signature. Resolve their result type to u32 directly so the
    // callee ident does not fall through to the unbound-identifier check (E137).
    // The GPU backend lowers these by name to PTX sregs (%tid.x / %ctaid.x /
    // %ntid.x, etc.); see hlir_to_gpu.sio / lower_to_ptx.sio.
    if call_expr_is_gpu_builtin(e.left) {
        // Barriers (gpu_barrier, gpu_barrier_sync, gpu_sync_threads) are void
        // side-effects; the thread-index/dim intrinsics return a u32 coordinate.
        if call_expr_is_gpu_barrier(e.left) {
            return ty_unit()
        }
        // E004: thread/block coordinate intrinsics return the language's native
        // index type i64 (not u32), so cast-free witness kernels typecheck as
        // written — `let i = bid*bdim + tid; if i < n` where `n: i64` no longer
        // reports a u32/i64 mismatch. The GPU backend lowers GpuGetTid/Bid/Ntid
        // by NAME to 32-bit PTX sregs (%tid.x etc.) independent of this checker
        // type (hlir_to_gpu.sio hardcodes GpuU32 for the read; all integer binops
        // lower as i32), so widening the checker type to i64 keeps strict integer
        // typing intact without changing the emitted register width.
        return ty_i64()
    }
    // syscall6(nr, a1..a6) -> i64 with IO: raw Linux syscall escape hatch,
    // mirroring the lean_single builtin (lean_single.sio emit_syscall6_x86).
    // No user-declared signature exists; without this arm the callee ident
    // falls through to the unbound-identifier check (E137). Codegen emits the
    // SysV->kernel register shuffle (rcx->r10, nr->rax) as a named builtin.
    if call_expr_is_syscall6(e.left) {
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        var effects_io: [i64; 8] = [0; 8]
        effects_io[0] = 0  // IO (effects.sio: 0=IO)
        checker_check_callee_effects_inplace(c, e.span, effects_io, 1)
        return ty_i64()
    }
    if call_expr_is_box_new(e.left) {
        return checker_check_box_new_expr_inplace(c, e)
    }
    if call_expr_should_bridge_by_value(e) {
        return checker_check_expr_mut(c, e)
    }
    // Preamble: multitest then hypothesis effects (shallow state, no sub-expr check).
    if multitest_effect_enabled((*c).current_effects, (*c).current_effect_count) {
        let callee_name = multitest_call_name(e.left)
        if multitest_is_stat_test_name(callee_name) {
            (*c).multitest_count = (*c).multitest_count + 1
        } else if multitest_is_correction_name(callee_name) {
            (*c).multitest_corrected = true
        }
    }
    if hypothesis_effect_enabled((*c).current_effects, (*c).current_effect_count) {
        let callee_name = multitest_call_name(e.left)
        if (*c).studies.count > 0 && multitest_is_stat_test_name(callee_name) {
            let outcome_name = hypothesis_outcome_name_from_args(e.args)
            if !name_is_empty(outcome_name) && !active_study_has_hypothesis_outcome((*c).studies, outcome_name) {
                let pen = (*c).report_hypothesis_penalty_warning(e.span, outcome_name)
                checker_store_from_value(c, pen)
            }
        }
    }
    var direct_sig_id: i64 = -1
    // Type::method associated-function path (e.g. E::of / Epistemic::measured).
    // When the method is registered, resolve it so the return type is known and
    // subsequent instance methods typecheck. When lookup misses (multi-module
    // residual for some imported associated forms), fall through to the legacy
    // path-as-first-segment behaviour rather than hard-rejecting — unknown
    // *instance* methods are rejected in checker_check_method_call_with_base_ty
    // even under TyUnknown receivers (see is_error_or_unknown branch).
    match e.left {
        Some(callee_expr) => {
            if (*callee_expr).kind == ExprKind::ExprIdent {
                direct_sig_id = checker_fn_sigs_find_inplace(c, (*callee_expr).name)
            } else if (*callee_expr).kind == ExprKind::ExprPath && (*callee_expr).path.seg_count >= 2 {
                let path_type_name = checker_copy_string_list_to_name((*callee_expr).path.segments)
                let path_method_name = checker_copy_string_list_tail_to_name((*callee_expr).path.segments)
                // Prefer semantic match (kind+name) then name-only self_type_name.
                let recv_ty = ty_named(path_type_name)
                direct_sig_id = fn_sig_table_find_method_semantic((*c).fn_sigs, recv_ty, path_method_name)
                // W044. The fallthrough documented just above is also what lets an
                // associated-function call whose target resolves to NOTHING be accepted
                // silently, evaluating to 0 and propagating that 0 as a pointer. The plain
                // form `nao_existe(3)` is correctly rejected (E137); only the path form
                // escaped, so ANY `Tipo::metodo(...)` typechecks, including invented ones --
                // `Coisa::inexistente(9)` compiles clean and evaluates to 0. That is the
                // mechanism that turned a missing `Box::new` lowering case into a call to a
                // bodyless stub returning 0 rather than a diagnostic.
                //
                // print_warning_message already carries the text for code 44; only the
                // detection was missing, so W044 was documented but dead until now.
                //
                // Reported only when the first segment names NO known type at all. That is
                // what preserves the residual the comment above protects: a KNOWN type whose
                // associated-fn lookup misses across modules stays silent, while an unknown
                // receiver is named. A free fn matching the last segment also suppresses it,
                // so module-qualified calls (`gpu::launch`, `wmma::mma_sync`) are unaffected.
                // `Box::new` returns at call_expr_is_box_new above and never arrives here.
                //
                // Warning, not error, because it fires on live code: `Vec::new()` appears 20
                // times across stdlib (qnn, pbpk, nn, compiler/epistemic, epistemic) while NO
                // `Vec` type exists anywhere in the tree, so those field initialisers are
                // already 0 today. Promoting to an error requires deciding what they should
                // be, which is stdlib semantics work, not a checker change.
                if direct_sig_id < 0 {
                    if struct_table_find((*c).structs, path_type_name) < 0 {
                        if enum_table_find((*c).enums, path_type_name) < 0 {
                            if checker_fn_sigs_find_inplace(c, path_method_name) < 0 {
                                checker_report_warning_at_mut(c, e.span, 44, 0, 0, 0)
                            }
                        }
                    }
                }
            }
        }
        None => {}
    }
    // #2164: a bare call to a math name the native backend cannot emit. Guarded
    // on direct_sig_id < 0 so it fires only where the name resolves to nothing
    // real -- the phantom-builtin case that produces a runtime SIGILL.
    if direct_sig_id < 0 {
        match e.left {
            Some(callee_expr) => {
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    if name_is_unimplemented_native_math((*callee_expr).name) {
                        checker_report_error_at_inplace(c, e.span, 221, 0, 0, 0)
                    }
                }
            }
            None => {}
        }
    }
    if direct_sig_id >= 0 {
        if (*c).enforce_visibility && !checker_fn_sig_visible_inplace(c, direct_sig_id) {
            checker_report_private_fn_inplace(c, e.span, direct_sig_id)
        }
        let call_start_borrows = (*c).borrows
        let direct_sig = fn_sig_table_get((*c).fn_sigs, direct_sig_id)
        // #1622: calling an `extern "C"` name the native backend does not
        // implement. This is the live arm -- a plain ident callee resolves via
        // direct_sig_id and returns below, never reaching the TyFn fallback.
        var refused_unimplemented = false
        if direct_sig.is_extern && !name_is_native_backend_builtin(direct_sig.name) {
            checker_report_error_at_inplace(c, e.span, 250, 0, 0, 0)
            refused_unimplemented = true
        }
        var effective_params = fn_param_list_clone(&direct_sig.params)
        var effective_return_type = direct_sig.return_type
        match call_expr_type_args(e) {
            Some(type_arg_exprs) => {
                let lowered_type_args = checker_lower_type_expr_list_mut(c, *type_arg_exprs)
                var generic_names = collect_fn_generic_names_from_params_in_tables((*c).structs, (*c).enums, fn_param_list_clone(&direct_sig.params), empty_type_param_buf())
                generic_names = collect_fn_generic_names_from_type_in_tables((*c).structs, (*c).enums, direct_sig.return_type, generic_names)
                if generic_names.count > 0 {
                    let provided_type_arg_count = type_entry_list_count_value(&lowered_type_args)
                    if provided_type_arg_count != generic_names.count {
                        checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
                    }
                    effective_params = checker_substitute_fn_params(effective_params, generic_names, type_entry_list_clone(&lowered_type_args))
                    effective_return_type = substitute_type_param(direct_sig.return_type, generic_names, type_entry_list_clone(&lowered_type_args))
                }
            }
            None => {}
        }
        // N2 (REQ-5, codex ruling 2026-08-23): save/reset the noise-set
        // scratch around this call's argument walk, so a nested call in an
        // argument position cannot leave its own noise_set_id behind for the
        // outer call. ns_proj_d is this callee's
        // proven-projection verdict (fail-closed: not-a-projection -> -1,
        // "watch nothing").
        let outer_arg_ns_d = (*c).last_call_arg_ns
        (*c).last_call_arg_ns = ns_arg_sentinel()
        let ns_proj_d = ns_proj_table_get((*c).ns_proj, direct_sig_id)
        let ns_watch_d = if ns_proj_d.0 { ns_proj_d.1 } else { 0 - 1 }
        checker_check_call_args_inplace(
            c,
            expr_list_handle(e.args),
            fn_param_list_handle(effective_params),
            direct_sig.param_count,
            e.span,
            ns_watch_d,
        )
        checker_check_callee_effects_named_inplace(c, e.span, direct_sig.effects, direct_sig.effect_count, direct_sig.name)
        checker_release_call_arg_borrows_inplace(c, e.args, effective_params, call_start_borrows)
        if refused_unimplemented {
            (*c).last_call_arg_ns = outer_arg_ns_d
            return ty_error()
        }
        let ns_result = checker_propagate_call_result_ns_inplace(c, effective_return_type, ns_proj_d.0)
        (*c).last_call_arg_ns = outer_arg_ns_d
        return ns_result
    }
    // Callee via the *mut spine, matched locally so the call path does not pass
    // Option<Box<Expr>> through another *mut helper boundary.
    let callee_ty =
        match e.left {
            Some(callee_expr) => checker_check_expr_inplace(c, *callee_expr)
            None => ty_error()
        }
    let array_like_ty =
        if callee_ty.kind == TypeKind::TyArray {
            callee_ty
        } else if callee_ty.kind == TypeKind::TyRef || callee_ty.kind == TypeKind::TyRefMut {
            match callee_ty.inner {
                Some(inner_ty) => *inner_ty
                None => ty_error()
            }
        } else {
            ty_error()
        }
    if array_like_ty.kind == TypeKind::TyArray {
        let idx_arg = expr_list_head(e.args)
        let extra_arg = expr_list_second(e.args)
        match idx_arg {
            Some(arg) => {
                let idx_ty = checker_check_expr_inplace(c, *arg)
                if !is_error_or_unknown(idx_ty) && !is_integer_type(idx_ty) {
                    checker_report_error_at_inplace(c, e.span, 14, 0, 0, 0)
                }
                match extra_arg {
                    Some(extra) => {
                        let _ety = checker_check_expr_inplace(c, *extra)
                        checker_report_error_at_inplace(c, e.span, 17, 0, 0, 0)
                        return ty_error()
                    }
                    None => {
                        match array_like_ty.inner {
                            Some(elem_ty) => return *elem_ty
                            None => return ty_error()
                        }
                    }
                }
            }
            None => {}
        }
    }
    if callee_ty.kind == TypeKind::TyFn && callee_ty.fn_sig_id >= 0 {
        let sig = fn_sig_table_get((*c).fn_sigs, callee_ty.fn_sig_id)
        if (*c).enforce_visibility && !checker_fn_sig_visible_inplace(c, callee_ty.fn_sig_id) {
            checker_report_private_fn_inplace(c, e.span, callee_ty.fn_sig_id)
        }
        // #1622: calling an `extern "C"` name the native backend does not
        // implement. Refuse here rather than emit a call that reads 0.
        // Checked at the CALL, not at the declaration. A bindings module
        // declares many names and a program calls few, so a declaration-site
        // refusal would break the declarations for no gain:
        // parser_card_a_raw_pointer_types.sio declares malloc and never calls
        // it, and tests/run-pass/ffi_declared_never_called_is_legal.sio pins
        // the case this rule exists for -- a declared, never-called name with
        // no intrinsic at all. That fixture is also the guard on the parser:
        // it only holds while parser/items.sio leaves such a declaration
        // bodyless instead of giving it a ffi_<name> forwarding body, because
        // a wrapper body carries is_extern false and this arm never fires.
        var refused_unimplemented = false
        if sig.is_extern && !name_is_native_backend_builtin(sig.name) {
            checker_report_error_at_inplace(c, e.span, 250, 0, 0, 0)
            refused_unimplemented = true
        }
        let call_start_borrows = (*c).borrows
        var effective_params = fn_param_list_clone(&sig.params)
        var effective_return_type = sig.return_type
        match call_expr_type_args(e) {
            Some(type_arg_exprs) => {
                let lowered_type_args = checker_lower_type_expr_list_mut(c, *type_arg_exprs)
                var generic_names = collect_fn_generic_names_from_params_in_tables((*c).structs, (*c).enums, fn_param_list_clone(&sig.params), empty_type_param_buf())
                generic_names = collect_fn_generic_names_from_type_in_tables((*c).structs, (*c).enums, sig.return_type, generic_names)
                if generic_names.count > 0 {
                    let provided_type_arg_count = type_entry_list_count_value(&lowered_type_args)
                    if provided_type_arg_count != generic_names.count {
                        checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
                    }
                    effective_params = checker_substitute_fn_params(effective_params, generic_names, type_entry_list_clone(&lowered_type_args))
                    effective_return_type = substitute_type_param(sig.return_type, generic_names, type_entry_list_clone(&lowered_type_args))
                }
            }
            None => {}
        }
        // N2 (REQ-5, codex ruling 2026-08-23): same save/reset/restore
        // discipline as the direct_sig_id path above, applied to the
        // noise-set scratch, plus the callee's proven-projection verdict.
        let outer_arg_ns = (*c).last_call_arg_ns
        (*c).last_call_arg_ns = ns_arg_sentinel()
        // Fail-closed (grok-4.6 re-review 2026-08-23): an INDIRECT call through a
        // first-class function VALUE must NEVER project. callee_ty.fn_sig_id can be
        // stale — assignment and CFG-join do not rebind a TyFn value's sig_id
        // (var f = id; f = add_noise; f(k) would else trust id's projection over
        // the real callee). Only the DIRECT named-call path (direct_sig_id above)
        // may project; here we watch nothing so the result defaults to top.
        let ns_watch = 0 - 1
        checker_check_call_args_inplace(c, expr_list_handle(e.args), fn_param_list_handle(effective_params), sig.param_count, e.span, ns_watch)
        checker_check_callee_effects_named_inplace(c, e.span, sig.effects, sig.effect_count, sig.name)
        checker_release_call_arg_borrows_inplace(c, e.args, effective_params, call_start_borrows)
        if refused_unimplemented {
            (*c).last_call_arg_ns = outer_arg_ns
            ty_error()
        } else {
            let ns_result = checker_propagate_call_result_ns_inplace(c, effective_return_type, false)
            (*c).last_call_arg_ns = outer_arg_ns
            ns_result
        }
    } else if is_error_or_unknown(callee_ty) {
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        callee_ty
    } else {
        // Enum tuple-variant constructor (`Event::B(42)`): the callee path typed as
        // ty_named(enum_name) (not TyFn), so it would otherwise hit E017. Check the args for
        // side effects / nested diagnostics and yield ty_named(enum_name) so a later
        // `match b { Event::B(n) => .. }` resolves via enum_table_find((*c).enums, scrut_ty.name).
        let variant_enum_idx = call_expr_enum_variant_ctor_enum_idx(c, e.left)
        if variant_enum_idx >= 0 {
            let ei = enum_table_get((*c).enums, variant_enum_idx)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_named(ei.name)
        }
        checker_report_error_at_inplace(c, e.span, 17, 0, 0, 0)
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        ty_error()
    }
}


// Effect INFERENCE, spec §7.2.1: "the checker is intended to infer this from the function body
// rather than require the author to reason about it; the annotation is a declaration of the
// inferred fact, not an independent obligation."
//
// STEP 1 of that, behind SOUNIO_EFFECT_INFER=1 and off by default so the shipped behaviour is
// unchanged while this is measured. Instead of reporting E035, the effect the callee needs is
// ADDED to the effect set in force for the function being checked. Adding only: an inferred set
// grows as callees are discovered and never shrinks, so a declared effect cannot be dropped.
//
// What this step does NOT yet do is write the widened set back into the caller's FnSig, so a
// caller-of-a-caller still sees the narrow DECLARED set and the inference stops after one level.
// Doing that needs the checker to know which signature it is currently inside, and the only handle
// would be a `current_sig_id` field kept in sync across 13 assignment sites and 6 save/restore
// pairs — where a stale id would widen the WRONG function's effects, a silent semantic corruption
// rather than a wrong message. Measured first, then decided.
fn checker_widen_current_effects_inplace(c: *mut Checker, extra: [i64; 8], extra_count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < extra_count && i < 8 {
        let e = extra[i as usize]
        var seen = false
        var j: i64 = 0
        while j < (*c).current_effect_count && j < 8 {
            if (*c).current_effects[j as usize] == e {
                seen = true
            }
            j = j + 1
        }
        if !seen && (*c).current_effect_count < 8 {
            let k = (*c).current_effect_count
            (*c).current_effects[k as usize] = e
            (*c).current_effect_count = k + 1
        }
        i = i + 1
    }
}

// Memoised: read_env allocates and the runtime allocator never reclaims,
// so a gate evaluated at every call site leaks on every call. CHECKED is
// separate from the value because "off" and "not yet read" are different.
var CHECKER_EFFECT_INFERENCE_ENABLED_ON: i64 = 0
var CHECKER_EFFECT_INFERENCE_ENABLED_CHECKED: i64 = 0

fn checker_effect_inference_enabled() -> bool with IO, Mut, Panic, Div {
    if CHECKER_EFFECT_INFERENCE_ENABLED_CHECKED == 0 {
        CHECKER_EFFECT_INFERENCE_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_EFFECT_INFER"), "1") {
            CHECKER_EFFECT_INFERENCE_ENABLED_ON = 1
        }
    }
    CHECKER_EFFECT_INFERENCE_ENABLED_ON == 1
}

// ============================================================
// NS noise-source dataflow -- sabotage + trace knobs.
//
// The sabotage control follows the witness-sabotage discipline of
// scripts/ci/witness_declares_its_sabotage_gate.sh (SOUNIO_SABOTAGE_*), for the
// same reason: a control that makes the invariant DISAPPEAR is the only control
// that proves the rule under test produced it, rather than something
// upstream. SOUNIO_NS_SABOTAGE=1 disables ONLY the propagation WRITES --
// the seed at measure()/Knowledge(), the union at Knowledge binary ops, and
// the call-return substitution -- so noise_set_id is left at whatever its
// caller already carried (the TypeEntry default, -1, for anything not
// explicitly re-seeded). E230 is wired separately and has its own diagnostic
// negative control, SOUNIO_NS_DISABLE; this dataflow sabotage knob does not
// disable the refusal predicate.
//
// Memoised for the same reason as CHECKER_PROVENANCE_SABOTAGE_ON: read_env
// allocates and the runtime allocator never reclaims.
var CHECKER_NS_SABOTAGE_ON: i64 = 0
var CHECKER_NS_SABOTAGE_CHECKED: i64 = 0

pub fn checker_ns_sabotage() -> bool with IO, Mut, Panic, Div {
    if CHECKER_NS_SABOTAGE_CHECKED == 0 {
        CHECKER_NS_SABOTAGE_CHECKED = 1
        if str_eq(read_env("SOUNIO_NS_SABOTAGE"), "1") {
            CHECKER_NS_SABOTAGE_ON = 1
        }
    }
    CHECKER_NS_SABOTAGE_ON == 1
}

// SOUNIO_NS_TRACE=1 exposes the abstract-domain state directly: it prints one
// "NS_TRACE <context>=<handle>" line per Knowledge value at each of the
// write sites (measure seed, deterministic-ctor empty, binary-op union,
// call-return substitution). The trace knob itself changes no checker
// behavior; the propagated handles remain inputs to E230 when tracing is off.
var CHECKER_NS_TRACE_ON: i64 = 0
var CHECKER_NS_TRACE_CHECKED: i64 = 0

pub fn checker_ns_trace_enabled() -> bool with IO, Mut, Panic, Div {
    if CHECKER_NS_TRACE_CHECKED == 0 {
        CHECKER_NS_TRACE_CHECKED = 1
        if str_eq(read_env("SOUNIO_NS_TRACE"), "1") {
            CHECKER_NS_TRACE_ON = 1
        }
    }
    CHECKER_NS_TRACE_ON == 1
}

pub fn checker_ns_trace_emit(context: string, handle: i64) with IO, Mut, Panic, Div {
    if checker_ns_trace_enabled() {
        print("NS_TRACE ")
        print(context)
        print("=")
        print_int(handle)
        print("\n")
    }
}

// ============================================================
// Per-rule sabotage knobs (codex ruling 2026-08-23).
//
// grok-4.6's review demanded each individual N2 dataflow rule (call-
// projection substitution, CFG-join union, loop widening) be independently
// disableable, so a negative control can show THAT rule's invariant vanish
// without also silencing the others. These are separate from the general
// checker_ns_sabotage() above, which still gates seed/union-at-binary-op/
// deterministic-ctor.
var CHECKER_NS_SABOTAGE_CALL_PROJ_ON: i64 = 0
var CHECKER_NS_SABOTAGE_CALL_PROJ_CHECKED: i64 = 0
pub fn checker_ns_sabotage_call_proj() -> bool with IO, Mut, Panic, Div {
    if CHECKER_NS_SABOTAGE_CALL_PROJ_CHECKED == 0 {
        CHECKER_NS_SABOTAGE_CALL_PROJ_CHECKED = 1
        if str_eq(read_env("SOUNIO_NS_SABOTAGE_CALL_PROJ"), "1") {
            CHECKER_NS_SABOTAGE_CALL_PROJ_ON = 1
        }
    }
    CHECKER_NS_SABOTAGE_CALL_PROJ_ON == 1
}

var CHECKER_NS_SABOTAGE_JOIN_ON: i64 = 0
var CHECKER_NS_SABOTAGE_JOIN_CHECKED: i64 = 0
pub fn checker_ns_sabotage_join() -> bool with IO, Mut, Panic, Div {
    if CHECKER_NS_SABOTAGE_JOIN_CHECKED == 0 {
        CHECKER_NS_SABOTAGE_JOIN_CHECKED = 1
        if str_eq(read_env("SOUNIO_NS_SABOTAGE_JOIN"), "1") {
            CHECKER_NS_SABOTAGE_JOIN_ON = 1
        }
    }
    CHECKER_NS_SABOTAGE_JOIN_ON == 1
}

// (N2 note: a SOUNIO_NS_SABOTAGE_LOOP_WIDEN knob was defined and removed as
// dead — there is no separate loop-widen mechanism to gate; loop-carried
// Knowledge joins through the reassignment path, so SOUNIO_NS_SABOTAGE_JOIN
// already disables it. See ns_loop_widen_top_trace.sio.)

// Parametric call-result substitution (REQ-5), FAIL-CLOSED (codex ruling
// 2026-08-23, replacing the fail-open "last Knowledge arg wins" grok-4.6
// found). DEFAULT is top (unknown, -1) for every call to a user fn returning
// Knowledge. Substitution is preserved ONLY when `is_projection` is true --
// ns_proj_table proved the callee's body is EXACTLY `{ param }` or
// `{ return param }` for the parameter whose argument
// checker_check_call_args_inplace captured into (*c).last_call_arg_ns (see
// ns_watch_idx there). SOUNIO_NS_SABOTAGE_CALL_PROJ=1 disables the
// preservation specifically -- even a genuine ident(x) then collapses to
// top, which is the per-rule negative control.
fn checker_propagate_call_result_ns_inplace(c: *mut Checker, ret_ty: TypeEntry, is_projection: bool) -> TypeEntry with IO, Mut, Panic, Div {
    var carried = ret_ty
    if carried.kind == TypeKind::TyKnowledge {
        if is_projection && !checker_ns_sabotage_call_proj() && (*c).last_call_arg_ns != ns_arg_sentinel() {
            carried.noise_set_id = (*c).last_call_arg_ns
        } else {
            // Not a proven projection (the general, dangerous-if-narrowed
            // case), OR the projection rule itself is sabotaged, OR a
            // projection fn whose projected-parameter argument was not
            // Knowledge-typed (sentinel never overwritten) -- top either way.
            carried.noise_set_id = 0 - 1
        }
        checker_ns_trace_emit("call", carried.noise_set_id)
    }
    carried
}

// The sabotage knob for E230, and the reason it exists.
//
// Same discipline as the SOUNIO_SABOTAGE_* witness knobs: a compile-fail witness
// proves nothing by "it also failed under sabotage" -- a refusal fails either
// way. The control that means something is a knob that makes E230 DISAPPEAR
// while every unrelated refusal (E245 in particular, which sits at the SAME
// kadd/kmul site) stays, because then the E230 under test is provably the
// noise-symbol rule and not an error further up. SOUNIO_NS_DISABLE=1 turns off
// ONLY the anti-garbling refusal; the noise_set_id field, the N2 dataflow and
// the union all still run.
var CHECKER_NS_DISABLE_ON: i64 = 0
var CHECKER_NS_DISABLE_CHECKED: i64 = 0

pub fn checker_ns_disable() -> bool with IO, Mut, Panic, Div {
    if CHECKER_NS_DISABLE_CHECKED == 0 {
        CHECKER_NS_DISABLE_CHECKED = 1
        if str_eq(read_env("SOUNIO_NS_DISABLE"), "1") {
            CHECKER_NS_DISABLE_ON = 1
        }
    }
    CHECKER_NS_DISABLE_ON == 1
}

// E230 -- anti-garbling. The predicate, in ONE place, called from both
// binary-op checking paths (the *mut Checker in-place path and the value path)
// so the rule cannot go inert on one of them.
//
// An independence-assuming operator (OpAdd, OpMul) over two Knowledge operands
// whose sources are not provably disjoint CAN understate the propagated variance
// (it drops the covariance term). For Add the assumed a^2+b^2 vs true (a+b)^2 on a
// shared symbol understates iff the coefficient product ab>0 and OVERstates iff
// ab<0; refusing every non-disjoint pair is therefore CONSERVATIVE (it never
// admits an understatement, though it also refuses the ab<0 pairs that were safe).
// ns_disjoint fails closed: unknown (-1) and any unrepresentable set are NEVER
// disjoint. A non-Knowledge operand carries no source of its own and never
// triggers the rule (both operands must be Knowledge to reach the disjointness
// test). Sub/Div are NOT gated here -- a SCOPE decision, not a safety one: the
// SAME-sign correlated case of subtraction overstates (safe), but an OPPOSITE-sign
// shared source makes Sub (and Div, sign-dependent) a genuine ungated anti-garbling
// (math-review, zai, 2026-08-25). A full sign-of-covariance treatment of Sub/Div is
// future work; today they pass unrefused.
fn checker_ns_should_refuse(table: *mut NoiseSetTable, bin_op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> bool with IO, Mut, Panic, Div {
    if checker_ns_disable() { return false }
    let is_indep_op = bin_op == BinaryOp::OpAdd || bin_op == BinaryOp::OpMul
    if !is_indep_op { return false }
    if !is_knowledge_type(left_ty) { return false }
    if !is_knowledge_type(right_ty) { return false }
    let a = left_ty.noise_set_id
    let b = right_ty.noise_set_id
    // An empty source-set is a deterministic value: it carries no measurement
    // source, so it cannot share one with the other operand and never causes an
    // anti-garbling -- even against an unknown (top) operand. ns_disjoint fails
    // closed on top BEFORE its empty shortcut, so empty-vs-top would read as
    // "not disjoint"; short-circuit it here to avoid a false refusal of
    // `deterministic + anything` (e.g. the N2 `x + w` witnesses where x is top).
    if a == ns_empty() { return false }
    if b == ns_empty() { return false }
    !ns_disjoint(&(*table), a, b)
}

fn checker_check_callee_effects_named_inplace(c: *mut Checker, span: Span, callee_effects: [i64; 8], callee_effect_count: i64, source: Name) with Mut, IO, Panic, Div, Alloc {
    if callee_effect_count == 0 {
        return
    }
    if effects_subset(callee_effects, callee_effect_count, (*c).current_effects, (*c).current_effect_count) {
        return
    }
    let missing_pair = find_missing_effects(callee_effects, callee_effect_count, (*c).current_effects, (*c).current_effect_count)
    if checker_effect_inference_enabled() {
        checker_widen_current_effects_inplace(c, missing_pair.0, missing_pair.1)
        // STEP 2: publish the inferred set into this function's own signature, so that ITS callers
        // see the effect too and inference is transitive rather than one level deep. Without this,
        // widening only silences the check locally — a pub fn could declare nothing and reach IO
        // through two hops with nobody noticing.
        //
        // Guarded by name: current_sig_id is only trusted when the signature it points at still
        // carries current_sig_name. A set-site that failed to update the pair leaves a stale index,
        // and the guard turns that into a skipped write (lost propagation) instead of effects
        // written onto an unrelated function.
        if (*c).current_sig_id >= 0 {
            let owner = fn_sig_table_get((*c).fn_sigs, (*c).current_sig_id)
            if name_eq(owner.name, (*c).current_sig_name) {
                let widened = fn_sig_table_widen_effects((*c).fn_sigs, (*c).current_sig_id, missing_pair.0, missing_pair.1)
                // SOUNIO_EFFECT_INFER_TRACE makes the propagation OBSERVABLE. Without it, step 1
                // (local widening) and step 2 (write-back) are indistinguishable by error count —
                // both drive E035 to 0 — so there would be no evidence the publication happens at
                // all. Prints once per effect actually added to a signature.
                // BOUNDARY CHECK (W045). The widening event itself is the proof that the
                // declaration is narrower than the inferred set — no snapshot or extra pass is
                // needed, because a widen only happens when something was missing. Reported for
                // `pub` only: outside a module the declaration is all a caller can read, so that is
                // where the annotation earns its keep. Private functions stay silent, which is the
                // whole point of inference — the author does not reason about effects internally.
                //
                // A WARNING and not an error, deliberately: 409 functions in main.sio's closure
                // already declare Mut without reaching any store, so this class is demonstrably
                // noisy in both directions today, and turning a measurement into a build failure
                // before the noise is understood would be the wrong order.
                if widened && owner.visibility_kind != VISIBILITY_PRIVATE {
                    checker_report_warning_at_mut(c, span, 45, 0, 0, 0)
                }
                if widened && str_eq(read_env("SOUNIO_EFFECT_INFER_TRACE"), "1") {
                    print("effect_infer: ")
                    e035_print_ident(owner.name)
                    print(" += ")
                    var ti: i64 = 0
                    while ti < missing_pair.1 {
                        if ti > 0 { print(", ") }
                        print_effect_name(missing_pair.0[ti as usize])
                        ti = ti + 1
                    }
                    print(" (from ")
                    e035_print_ident(source)
                    print(")\n")
                }
            }
        }
        return
    }
    let t = (*c).report_effect_error_from(span, missing_pair.0, missing_pair.1, source)
    checker_store_from_value(c, t)
}

// Retained for the arms that synthesise an effect list with no signature behind it (Observe on
// println, IO on syscall6, the store-site Mut from #1522): there is no callee name to report.
fn checker_check_callee_effects_inplace(c: *mut Checker, span: Span, callee_effects: [i64; 8], callee_effect_count: i64) with Mut, IO, Panic, Div, Alloc {
    checker_check_callee_effects_named_inplace(c, span, callee_effects, callee_effect_count, empty_name())
}

    fn checker_release_call_arg_borrows_inplace(c: *mut Checker, args: Option<Box<ExprList> >, params: Option<Box<FnParamList> >, call_start_borrows: BorrowEnv) with Mut, Panic, Div, Alloc, IO {
        match args {
            None => {}
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                var implicit_release_kind: i64 = 0  // 0=none, 1=shared, 2=exclusive
                var next_params: Option<Box<FnParamList> > = None

                match params {
                    None => {}
                    Some(param_list) => {
                        let param = (*param_list).head
                        if param.ty.kind == TypeKind::TyRef {
                            implicit_release_kind = 1
                        } else if param.ty.kind == TypeKind::TyRefMut {
                            implicit_release_kind = 2
                        }
                        next_params = (*param_list).tail
                    }
                }

                if arg_expr.kind == ExprKind::ExprIdent && implicit_release_kind != 0 {
                    // Release borrows unconditionally after call returns.
                    // Previous logic used state delta (before_pair vs current_pair)
                    // which failed when consecutive calls borrow the same variable
                    // (the second call saw before_pair.0 == 2 from the first call's
                    // un-released borrow, and skipped the release).
                    if implicit_release_kind == 1 || implicit_release_kind == 2 {
                        (*c).borrows = (*c).borrows.release_borrow(arg_expr.name)
                    }
                }

                if arg_expr.kind == ExprKind::ExprUnary &&
                   (arg_expr.un_op == UnaryOp::OpRef || arg_expr.un_op == UnaryOp::OpRefMut) {
                    let borrow_name = unary_operand_name(arg_expr.left)
                    if !name_is_empty(borrow_name) {
                        // Unconditionally release call-site borrows after call returns
                        (*c).borrows = (*c).borrows.release_borrow(borrow_name)
                    }
                }

                checker_release_call_arg_borrows_inplace(c, (*arg_list).tail, next_params, call_start_borrows)
            }
        }
    }

fn checker_check_call_arg_borrow_boundary_inplace(c: *mut Checker, arg_expr: Expr, param_ty: TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    if arg_expr.kind != ExprKind::ExprIdent {
        return
    }
    if param_ty.kind == TypeKind::TyRef {
        let borrow_result = (*c).borrows.try_shared_borrow(arg_expr.name)
        (*c).borrows = borrow_result.0
        if borrow_result.1 != 0 {
            checker_report_error_at_inplace(c, call_span, borrow_result.1, 0, 0, 0)
        }
    } else if param_ty.kind == TypeKind::TyRefMut {
        let borrow_result = (*c).borrows.try_exclusive_borrow(arg_expr.name)
        (*c).borrows = borrow_result.0
        if borrow_result.1 != 0 {
            checker_report_error_at_inplace(c, call_span, borrow_result.1, 0, 0, 0)
        }
    }
}

fn checker_check_call_arg_refinement_boundary_inplace(c: *mut Checker, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    let expected_ty = call_ref_inner_or_self(param_ty)
    if expected_ty.refinement_id < 0 || expected_ty.refinement_id >= 128 || is_error_or_unknown(expected_ty) {
        return
    }
    let provided_ty = call_ref_inner_or_self(arg_ty)
    if is_error_or_unknown(provided_ty) {
        return
    }

    let expected_ref = (*c).refinements.entries[expected_ty.refinement_id as usize]

    if arg_expr.kind == ExprKind::ExprIntLit {
        // Constant folding: literal known at compile time.
        let result = refine_static_check_int_literal(expected_ref.predicate, arg_expr.int_val)
        if result == refine_static_result_proved() {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
        } else {
            (*c).refine_violations = (*c).refine_violations + 1
            checker_report_error_at_inplace(c, call_span, 42, 0, 0, 0)
        }
        return
    }
    if arg_expr.kind == ExprKind::ExprFloatLit {
        let result = refine_static_check_float_literal(expected_ref.predicate, arg_expr.float_val)
        if result == refine_static_result_proved() {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
        } else {
            (*c).refine_violations = (*c).refine_violations + 1
            checker_report_error_at_inplace(c, call_span, 42, 0, 0, 0)
        }
        return
    }

    if provided_ty.refinement_id >= 0 && provided_ty.refinement_id < 128 {
        let provided_ref = (*c).refinements.entries[provided_ty.refinement_id as usize]
        if pred_implies(provided_ref.predicate, expected_ref.predicate) {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
        } else {
            (*c).refine_violations = (*c).refine_violations + 1
            checker_report_error_at_inplace(c, call_span, 42, 0, 0, 0)
        }
        return
    }

    // Try known-constant lookup for identifiers
    if arg_expr.kind == ExprKind::ExprIdent {
        let const_result = checker_const_int_lookup_mut(c, arg_expr.name)
        if const_result.0 != false {
            let result = refine_static_check_int_literal(expected_ref.predicate, const_result.1)
            if result == refine_static_result_proved() {
                (*c).refine_static_proved = (*c).refine_static_proved + 1
                return
            } else {
                (*c).refine_violations = (*c).refine_violations + 1
                checker_report_error_at_inplace(c, call_span, 42, 0, 0, 0)
                return
            }
        }
    }

    // Try environment-based proof: look up arg type for refinement
    if arg_expr.kind == ExprKind::ExprIdent {
        let env_lookup = (*c).env.lookup(arg_expr.name)
        if env_lookup.refinement_id >= 0 && env_lookup.refinement_id < 128 {
            let env_ref = (*c).refinements.entries[env_lookup.refinement_id as usize]
            if pred_implies(env_ref.predicate, expected_ref.predicate) {
                (*c).refine_static_proved = (*c).refine_static_proved + 1
                return
            }
        }

        // Condition-narrowing proof: use guard predicates accumulated from
        // enclosing `if` conditions.  E.g., inside `if x > 0 { f(x) }`,
        // x > 0 is a guard — sufficient to prove `x` satisfies `{ x > 0 }`.
        let cond_result = refine_static_check_var((*c).refine_cond_env, arg_expr.name, expected_ref.predicate)
        if cond_result == refine_static_result_proved() {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
            return
        }

        // Ontology-aware proof: collect ALL property predicates from
        // class + ancestors into a single conjunction, then check once.
        //
        // This is the canonical form for compound property reasoning:
        //   axioms = {potency >= 0.0, mw < 1000.0, ...}
        //   conjoined = (potency >= 0.0) AND (mw < 1000.0) AND ...
        //   pred_implies_structural(conjoined, expected) succeeds when the
        //   collected conjunction is strong enough to discharge expected.
        // Failure is still only an under-approximation of semantic proof.
        //
        // Uses pred_implies_structural (var_name independent) because
        // properties are universally quantified — the bound variable name
        // is a binder artifact, not a semantic identity.
        if env_lookup.ontology_id >= 0 {
            let arg_oid = env_lookup.ontology_id
            var axiom_preds: [RefinementPred; 16] = [empty_refinement_pred(); 16]
            var axiom_count: i64 = 0
            var axiom_overflow = false

            if arg_oid >= 0 && arg_oid < (*c).ontology_kernel.classes.count {
                // Collect own class property axioms first.
                var pi: i64 = 0
                let own_axiom_count = (*c).ontology_kernel.materialized.class_property_counts[arg_oid as usize]
                while pi < own_axiom_count {
                    let axiom_idx = (*c).ontology_kernel.materialized.class_property_axioms[(arg_oid * 8 + pi) as usize]
                    if axiom_idx >= 0 && axiom_idx < (*c).ontology_kernel.axioms.count {
                        let ontology_axiom = (*c).ontology_kernel.axioms.axioms[axiom_idx as usize]
                        let prop_ref_id = ontology_axiom.refinement_ref_id
                        if prop_ref_id >= 0 && prop_ref_id < 128 {
                            if axiom_count < 16 {
                                axiom_preds[axiom_count as usize] = (*c).refinements.entries[prop_ref_id as usize].predicate
                                axiom_count = axiom_count + 1
                            } else {
                                axiom_overflow = true
                            }
                        }
                    }
                    pi = pi + 1
                }

                // Collect superclass property axioms via the materialized subclass matrix.
                var anc_idx: i64 = 0
                while anc_idx < (*c).ontology_kernel.classes.count {
                    if anc_idx != arg_oid && ontology_kernel_is_subclass((*c).ontology_kernel, arg_oid, anc_idx) {
                        var pj: i64 = 0
                        let anc_axiom_count = (*c).ontology_kernel.materialized.class_property_counts[anc_idx as usize]
                        while pj < anc_axiom_count {
                            let anc_axiom_idx = (*c).ontology_kernel.materialized.class_property_axioms[(anc_idx * 8 + pj) as usize]
                            if anc_axiom_idx >= 0 && anc_axiom_idx < (*c).ontology_kernel.axioms.count {
                                let anc_axiom = (*c).ontology_kernel.axioms.axioms[anc_axiom_idx as usize]
                                let anc_prop_ref_id = anc_axiom.refinement_ref_id
                                if anc_prop_ref_id >= 0 && anc_prop_ref_id < 128 {
                                    if axiom_count < 16 {
                                        axiom_preds[axiom_count as usize] = (*c).refinements.entries[anc_prop_ref_id as usize].predicate
                                        axiom_count = axiom_count + 1
                                    } else {
                                        axiom_overflow = true
                                    }
                                }
                            }
                            pj = pj + 1
                        }
                    }
                    anc_idx = anc_idx + 1
                }
            }

            // Build conjunction and discharge with one call
            if axiom_count > 0 {
                if axiom_overflow {
                    let t = (*c).report_warning_at(call_span, 42, 0, 0, 0)
                    checker_store_from_value(c, t)
                }
                var conjoined = axiom_preds[0]
                var ci: i64 = 1
                while ci < axiom_count {
                    conjoined = pred_and(conjoined, axiom_preds[ci as usize])
                    ci = ci + 1
                }
                if pred_implies_structural(conjoined, expected_ref.predicate) {
                    (*c).refine_static_proved = (*c).refine_static_proved + 1
                    return
                }
            }
        }
    }

    // Epistemic fallback: static analysis exhausted — defer to runtime assertion.
    // W040 semantics: the call compiles. The predicate is NOT proven statically.
    //   Emit refine_hint: static_unknown diagnostic (W045) alongside W040.
    //   - Debug mode (future): codegen inserts runtime assertion at this call site.
    //     If the predicate fails at runtime, panic with "refinement predicate violated".
    //   - Release mode: trust the programmer. The warning was sufficient notice.
    // To suppress: #[allow(W040)] on the call site (not yet implemented).
    // To force proof: annotate the argument with an explicit refinement type.
    (*c).refine_runtime_checked = (*c).refine_runtime_checked + 1
    let t = (*c).report_warning_at(call_span, 40, 0, 0, 0)
    checker_store_from_value(c, t)
}

fn checker_check_call_arg_knowledge_boundary_inplace(c: *mut Checker, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    let expected_ty = call_ref_inner_or_self(param_ty)
    if !is_epistemic_type(expected_ty) {
        return
    }
    let provided_ty = call_ref_inner_or_self(arg_ty)
    if !is_epistemic_type(provided_ty) || is_error_or_unknown(provided_ty) {
        return
    }
    if provided_ty.kind != expected_ty.kind {
        checker_report_error_at_inplace(c, call_span, 36, 0, 0, 0)
        return
    }
    // Knowledge<_> with unspecified epsilon is a generic wrapper constraint,
    // not a concrete confidence contract. Intrinsic signatures use this shape
    // to retain the operand kind without inventing a confidence bound.
    if knowledge_inner(expected_ty).kind == TypeKind::TyUnknown &&
       knowledge_meta_epsilon(knowledge_meta_from_ty(expected_ty)) < 0.0 {
        return
    }
    if !knowledge_call_boundary_compatible(provided_ty, expected_ty) {
        // Name the failing slot: a refusal is evidence for the cause it
        // names. Epsilon keeps E036 (it predates this); a provenance-leg
        // failure is E244. (The validity leg is payload-flattened until the
        // date-parser slice of SOUNIO-KNOWLEDGE-BOUNDARY-PROVENANCE lands.)
        let pmeta2 = knowledge_meta_from_ty(provided_ty)
        let rmeta2 = knowledge_meta_from_ty(expected_ty)
        if !provenance_subsumes(knowledge_meta_provenance(pmeta2), knowledge_meta_provenance(rmeta2)) {
            checker_report_error_at_inplace(c, call_span, 244, 0, 0, 0)
        } else {
            checker_report_error_at_inplace(c, call_span, 36, 0, 0, 0)
        }
    }
}

fn checker_check_call_arg_unit_boundary_inplace(c: *mut Checker, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    let expected_ty = call_ref_inner_or_self(param_ty)
    let provided_ty = call_ref_inner_or_self(arg_ty)
    let expected_unit = expected_ty.unit_id
    let provided_unit = provided_ty.unit_id
    if expected_unit < 0 || provided_unit < 0 {
        return
    }
    if expected_ty.kind == TypeKind::TyError || expected_ty.kind == TypeKind::TyUnknown || expected_ty.kind == TypeKind::TyNever {
        return
    }
    if provided_ty.kind == TypeKind::TyError || provided_ty.kind == TypeKind::TyUnknown || provided_ty.kind == TypeKind::TyNever {
        return
    }
    if expected_unit != provided_unit {
        let t = (*c).report_unit_call_mismatch(call_span, provided_unit, expected_unit)
        checker_store_from_value(c, t)
        return
    }
}

fn checker_ontology_boundary_check_call_arg_contract_inplace(c: *mut Checker, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    // Cheap guard hoisted from check_call_arg_ontology_boundary's own early-out: the boundary
    // is a no-op unless the PARAM type carries an ontology contract. Without this guard the
    // by-value `(*c).check_call_arg_ontology_boundary(...)` call copies the 8MB Checker as
    // `self` on EVERY user-fn call arg (even `id(5)`) — the stack smash that crashed the
    // modular checker. The other four arg-boundary checks are already true *mut; this one
    // was missed. Behaviour-identical: the by-value method returns self in exactly these cases.
    let expected_ty = call_ref_inner_or_self(param_ty)
    if expected_ty.ontology_id < 0 || is_error_or_unknown(expected_ty) {
        return
    }
    let t = (*c).check_call_arg_ontology_boundary(arg_ty, param_ty, call_span)
    checker_store_from_value(c, t)
}



// *mut ExprIdent leaf — transcription of the by-value ExprIdent arm (13856). env lookup +
// linear-consume in place; returns only the TypeEntry (no 164KB self SRET — the by-value
// arm's `(c2, ident_ty)` return was the last bridge before crash in 165 deeply-nested cases).
fn checker_check_ident_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if !(*c).env.has_binding(e.name) {
        // Functions are not bound in env (collect keeps them in fn_sigs only) — resolve a bare
        // function reference via the chunked fn_sigs before reporting E137.
        let fn_sig_id = checker_fn_sigs_find_inplace(c, e.name)
        if fn_sig_id >= 0 {
            return ty_fn(fn_sig_id)
        }
        checker_report_undeclared_inplace(c, e.span, e.name)
        return ty_error()
    }
    let ident_ty = (*c).env.lookup(e.name)
    if checker_is_linear_type_inplace(c, ident_ty) && (*c).suppress_linear_consume_depth == 0 {
        if (*c).borrows.is_borrowed(e.name) {
            checker_report_error_at_inplace(c, e.span, 38, 0, 0, 0)
        } else {
            let consume_result = (*c).borrows.consume_linear(e.name)
            (*c).borrows = consume_result.0
            if consume_result.1 != 0 {
                checker_report_error_at_inplace(c, e.span, consume_result.1, 0, 0, 0)
            }
        }
    }
    ident_ty
}

// *mut ExprCast — transcription of check_cast_expr: operand via the spine, target type via
// the *mut type-lowering, epistemic + unit-dimension checks in place.
fn checker_check_cast_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let src_ty = checker_check_opt_expr_inplace(c, e.left)
    match e.cast_type {
        Some(ty) => {
            let target_ty = checker_lower_type_expr_mut(c, *ty)
            if is_wide_float_type(src_ty) || is_wide_float_type(target_ty) {
                checker_report_error_at_inplace(c, e.span, 248, 0, 0, 0)
                return ty_error()
            }
            let src_is_epistemic = src_ty.kind == TypeKind::TyKnowledge
                || src_ty.kind == TypeKind::TyIntervention
                || src_ty.kind == TypeKind::TyCounterfactual
                || src_ty.kind == TypeKind::TyValidated
            let tgt_is_epistemic = target_ty.kind == TypeKind::TyKnowledge
                || target_ty.kind == TypeKind::TyIntervention
                || target_ty.kind == TypeKind::TyCounterfactual
                || target_ty.kind == TypeKind::TyValidated
            if src_is_epistemic && !tgt_is_epistemic {
                checker_report_error_at_inplace(c, e.span, 171, 0, 0, 0)
            }
            if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
                let src_dim = (*c).units.get_dim(src_ty.unit_id)
                let tgt_dim = (*c).units.get_dim(target_ty.unit_id)
                if !unit_dim_compatible(src_dim, tgt_dim) {
                    checker_report_error_at_inplace(c, e.span, 43, 0, 0, 0)
                }
            }
            target_ty
        }
        None => ty_error()
    }
}


// One match arm via the *mut spine — FULL transcription of check_match_arm (16396):
// push env/borrows/const scopes, bind the pattern, check the arm body, pop the scopes in
// reverse order. Faithful to the by-value original's scope discipline (env.push_scope /
// borrows.push_scope / push_const_scope on entry; pop_const_scope / borrows.pop_scope /
// env.pop_scope on exit, in that exact order). The body is checked via the *mut spine.
fn checker_check_match_arm_inplace(c: *mut Checker, arm: MatchArm, scrut_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    (*c).env = (*c).env.push_scope()
    (*c).borrows = (*c).borrows.push_scope()
    checker_push_const_scope_inplace(c)
    checker_bind_pattern_inplace(c, arm.pattern, scrut_ty)
    // Type-check the `if <cond>` guard (if any) with the pattern variables in scope.
    match arm.guard {
        Some(g) => {
            let _guard_ty = checker_check_expr_inplace(c, *g)
        }
        _ => {}
    }
    let body_ty = checker_check_expr_inplace(c, arm.body)
    checker_require_current_linear_scope_consumed_inplace(c)
    checker_pop_const_scope_inplace(c)
    (*c).borrows = (*c).borrows.pop_scope()
    (*c).env = (*c).env.pop_scope()
    body_ty
}

// Bridge for bind_pattern (16426). Pattern binding mutates the Checker (env binds, const
// binds, borrow tracking) but contains NO sub-EXPRESSIONS — it only walks sub-PATTERNS —
// so there is nothing here that could recurse back into the by-value expr checker. Bridging
// the by-value bind_pattern once and storing the result back via checker_store_from_value
// is the standard split-and-bridge move (same shape as checker_check_binary_expr_inplace's
// bridge to check_binary_with_operand_types). Faithful: identical env/const/borrow effects —
// checker_store_from_value copies env, borrows, AND every const_int_* field (verified
// check.sio:780,781,848-854), so the PatBinding env/const-int/borrow mutations round-trip.
// Full *mut recursive transcription of bind_pattern + its list helpers. The old version
// bridged the by-value (*c).bind_pattern, whose tuple/struct/enum-payload recursion returns
// a ~164KB Checker per level — once (*c).enums is populated that SRET-move smashes the
// return address (match-with-tuple `match t {(a,b)=>}` crashed --check, while the
// non-recursive `let (a,b)=..` survived). This version mutates (*c) directly and returns
// nothing, so no Checker is ever moved. if/else-if (not match on pat.kind) dodges the
// discriminant-0 *mut match miscompile.
fn pattern_list_count(opt: Option<Box<PatternList> >) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + pattern_list_count((*list).tail)
    }
}

fn checker_bind_pattern_inplace(c: *mut Checker, pat: Pattern, scrut_ty: TypeEntry) with Mut, Panic, Div, Alloc, IO {
    if pat.kind == PatternKind::PatBinding {
        (*c).env = (*c).env.bind(pat.name, scrut_ty, pat.is_mut)
        checker_const_int_bind_unknown_inplace(c, pat.name)
        let lin = checker_is_linear_type_inplace(c, scrut_ty)
        (*c).borrows = (*c).borrows.track(pat.name, lin)
    } else if pat.kind == PatternKind::PatEnum {
        // Single-payload variant (e.g. Some(x) on Option<T>/Box<T>): the scrutinee
        // carries the payload type in .inner (Box/Option lowering). Bind the payload
        // sub-pattern to that inner type so (*x) / (*x).field type correctly. Fall
        // back to scrut_ty when there is no inner (other enums — positional variant
        // field types are not otherwise tracked).
        match scrut_ty.inner {
            Some(inner_box) => checker_bind_pattern_list_inplace(c, pat.sub_patterns, *inner_box)
            None => checker_bind_pattern_list_inplace(c, pat.sub_patterns, scrut_ty)
        }
    } else if pat.kind == PatternKind::PatStruct {
        checker_bind_struct_pat_fields_inplace(c, pat.pat_fields, scrut_ty)
    } else if pat.kind == PatternKind::PatTuple {
        // E213: tuple-destructure arity must match the scrutinee tuple's element
        // count. Fire ONLY on a KNOWN tuple type (never on unknown/incomplete
        // inference), so valid code with matching arity is untouched. Sounio has
        // no tuple rest-pattern (`(a, ..)`), so strict equality is correct.
        if scrut_ty.kind == TypeKind::TyTuple {
            let pat_n = pattern_list_count(pat.sub_patterns)
            let ty_n = type_entry_list_count(scrut_ty.tuple_elems)
            if pat_n != ty_n {
                checker_report_error_at_inplace(c, pat.span, 213, pat_n, ty_n, 0)
            }
        }
        checker_bind_tuple_pattern_list_idx_inplace(c, pat.sub_patterns, scrut_ty, 0)
    } else if pat.kind == PatternKind::PatOr {
        checker_bind_pattern_list_inplace(c, pat.sub_patterns, scrut_ty)
    }
    // PatWildcard / PatIntLit / PatBoolTrue / PatBoolFalse / PatStringLit bind nothing.
}

fn checker_bind_pattern_list_inplace(c: *mut Checker, opt: Option<Box<PatternList> >, scrut_ty: TypeEntry) with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    while true {
        match cur {
            Some(list) => {
                checker_bind_pattern_inplace(c, (*list).head, scrut_ty)
                cur = (*list).tail
            }
            None => break
        }
    }
}

fn checker_bind_tuple_pattern_list_idx_inplace(c: *mut Checker, opt: Option<Box<PatternList> >, scrut_ty: TypeEntry, start_idx: i64) with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    var idx = start_idx
    while true {
        match cur {
            Some(list) => {
                var elem_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyTuple {
                    elem_ty = type_entry_list_get(scrut_ty.tuple_elems, idx)
                }
                checker_bind_pattern_inplace(c, (*list).head, elem_ty)
                cur = (*list).tail
                idx = idx + 1
            }
            None => break
        }
    }
}

fn checker_bind_struct_pat_fields_inplace(c: *mut Checker, opt: Option<Box<PatFieldList> >, scrut_ty: TypeEntry) with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    while true {
        match cur {
            Some(list) => {
                var field_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyNamed {
                    let struct_idx = struct_table_find((*c).structs, scrut_ty.name)
                    if struct_idx >= 0 {
                        let si = struct_table_get((*c).structs, struct_idx)
                        field_ty = field_info_list_find(si.fields, (*list).head.name)
                    } else {
                        let enum_idx = enum_table_find((*c).enums, scrut_ty.name)
                        if enum_idx >= 0 {
                            let ei = enum_table_get((*c).enums, enum_idx)
                            field_ty = variant_fields_find_field(ei.variants, (*list).head.name)
                        }
                    }
                }
                checker_bind_pattern_inplace(c, (*list).head.pattern, field_ty)
                cur = (*list).tail
            }
            None => break
        }
    }
}



// ============================================================
// G1: *mut StmtLet spine — converts the let-statement check path off the
// by-value Checker copies (the 8MB SRET frames that crash `let x = 1` at 8MB).
// bin/souc UNTOUCHED. Mirrors the by-value check_let_stmt (12208) faithfully.
// ============================================================

// *mut const-int bind helper (mirrors const_int_bind_value @6389 = raw with known=1).
fn checker_const_int_bind_value_inplace(c: *mut Checker, name: Name, value: i64) with Mut, Div, Panic {
    checker_const_int_bind_raw_inplace(c, name, 1, value)
}

// *mut transcription of const_int_lookup (6390) — reads the const-int table
// through (*c) instead of copying the whole Checker by value.
fn checker_const_int_lookup_mut(c: *mut Checker, name: Name) -> (bool, i64) with Mut, Panic, Div {
    var i = (*c).const_int_count - 1
    while i >= 0 {
        if checker_const_name_eq(&(*c).const_int_name_bufs, &(*c).const_int_name_lens, i, name) {
            if (*c).const_int_known[i as usize] == 1 {
                return (true, (*c).const_int_values[i as usize])
            }
            return (false, 0)
        }
        i = i - 1
    }
    (false, 0)
}

// *mut transcription of eval_const_int_opt_expr (8400) — faithful to the
// original (binop arms inlined; field is e.bin_op), avoiding the by-value
// Checker parameter (an 8MB frame hazard).
fn checker_eval_const_int_opt_expr_mut(c: *mut Checker, opt: Option<Box<Expr> >) -> (i64, i64) with Mut, Panic, Div, Alloc {
    match opt {
        Some(inner) => {
            let e = *inner
            if e.kind == ExprKind::ExprIntLit {
                return (1, e.int_val)
            }
            if e.kind == ExprKind::ExprIdent {
                let lookup_pair = checker_const_int_lookup_mut(c, e.name)
                if lookup_pair.0 != false {
                    return (1, lookup_pair.1)
                }
                return (0, 0)
            }
            if e.kind == ExprKind::ExprUnary && e.un_op == UnaryOp::OpNeg {
                let inner_pair = checker_eval_const_int_opt_expr_mut(c, e.left)
                if inner_pair.0 != 0 {
                    return (1, 0 - inner_pair.1)
                }
                return (0, 0)
            }
            if e.kind == ExprKind::ExprBinary {
                let left_pair = checker_eval_const_int_opt_expr_mut(c, e.left)
                let right_pair = checker_eval_const_int_opt_expr_mut(c, e.right)
                if left_pair.0 == 0 || right_pair.0 == 0 {
                    return (0, 0)
                }
                let lv = left_pair.1
                let rv = right_pair.1
                if e.bin_op == BinaryOp::OpAdd {
                    return (1, lv + rv)
                } else if e.bin_op == BinaryOp::OpSub {
                    return (1, lv - rv)
                } else if e.bin_op == BinaryOp::OpMul {
                    return (1, lv * rv)
                } else if e.bin_op == BinaryOp::OpDiv {
                    if rv == 0 { return (0, 0) }
                    return (1, lv / rv)
                } else if e.bin_op == BinaryOp::OpRem {
                    if rv == 0 { return (0, 0) }
                    return (1, lv % rv)
                }
            }
            (0, 0)
        }
        None => (0, 0)
    }
}

// *mut transcription of lower_opt_type (8925) — wraps the existing
// checker_lower_type_expr_mut (1031).
fn checker_lower_opt_type_inplace(c: *mut Checker, opt: Option<Box<TypeExpr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(te) => checker_lower_type_expr_mut(c, *te)
        None => ty_unknown()
    }
}

// *mut transcription of check_refinement_literal (12312). Reads refinements via
// (*c); emits E042 through checker_report_error_at_inplace. Replicates the final
// last_literal_kind = 0 reset (12338) so downstream stmts see clean state.
fn checker_check_refinement_literal_inplace(c: *mut Checker, span: Span, ty: TypeEntry) with Mut, Panic, Div, IO, Alloc {
    if ty.refinement_id < 0 || ty.refinement_id >= 128 {
        return
    }
    let rt = (*c).refinements.entries[ty.refinement_id as usize]
    if (*c).last_literal_kind == 1 {
        let result = refine_static_check_int_literal(rt.predicate, (*c).last_literal_int)
        if result == refine_static_result_proved() {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
        } else {
            (*c).refine_violations = (*c).refine_violations + 1
            checker_report_error_at_inplace(c, span, 42, 0, 0, 0)
        }
    } else if (*c).last_literal_kind == 2 {
        let result = refine_static_check_float_literal(rt.predicate, (*c).last_literal_float)
        if result == refine_static_result_proved() {
            (*c).refine_static_proved = (*c).refine_static_proved + 1
        } else {
            (*c).refine_violations = (*c).refine_violations + 1
            checker_report_error_at_inplace(c, span, 42, 0, 0, 0)
        }
    }
    (*c).last_literal_kind = 0
}

// Predicate: does this binding-init expr need the epistemic special handling in
// check_binding_init_expr (Contest / lift_knowledge / AuditAttach / Path-TyNamed)?
fn checker_binding_init_is_special(e: Expr, ann_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprContest {
        return true
    }
    if e.kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge(e.left) {
        return true
    }
    if e.kind == ExprKind::ExprAuditAttach {
        return true
    }
    if e.kind == ExprKind::ExprPath && ann_ty.kind == TypeKind::TyNamed {
        return true
    }
    false
}

// Isolated by-value leaf for the epistemic special cases. ONE by-value call site
// (the existing check_binding_init_expr method, which handles all four branches
// internally) → exactly one 8MB SRET buffer, kept OUT of the hot frame. Never
// reached by `let x = 1` (IntLit is not special), so it does not affect the gate.
fn checker_check_binding_init_expr_bridge(c: *mut Checker, opt: Option<Box<Expr> >, ann_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let pair = (*c).check_binding_init_expr(opt, ann_ty)
    checker_store_from_value(c, pair.0)
    pair.1
}

// *mut binding-init dispatch: simple exprs run on the *mut expr spine (which
// handles IntLit inline and sets last_literal_*); epistemic cases bridge.
fn checker_check_binding_init_expr_inplace(c: *mut Checker, opt: Option<Box<Expr> >, ann_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprPath && ann_ty.kind == TypeKind::TyNamed {
                // Bidirectional inference for enum/named variants (e.g. `Option::None` with
                // annotation `Option<i32>` → keep the annotation type so generic params are
                // preserved). Mirrors the by-value check_binding_init_expr ExprPath case, but
                // via the *mut path handler — the by-value check_path_expr SRET-smashes once
                // the enum is collected (the p7 latent crash on `let x: E = E::A`).
                let path_ty = checker_check_path_expr_inplace(c, *e)
                if path_ty.kind == TypeKind::TyNamed && name_eq(path_ty.name, ann_ty.name) {
                    ann_ty
                } else {
                    path_ty
                }
            } else if (*e).kind == ExprKind::ExprContest && ann_ty.kind == TypeKind::TyContest {
                // The ref-safe helper currently owns the identifier-subject
                // slice. Preserve the legacy checker for richer subjects until
                // their recursive expression checking is ported in-place.
                match (*e).left {
                    Some(subject) => {
                        if (*subject).kind == ExprKind::ExprIdent {
                            checker_check_contest_expr_expected_mut(c, *e, ann_ty)
                        } else {
                            checker_check_binding_init_expr_bridge(c, opt, ann_ty)
                        }
                    }
                    None => checker_check_binding_init_expr_bridge(c, opt, ann_ty)
                }
            } else if checker_binding_init_is_special(*e, ann_ty) {
                checker_check_binding_init_expr_bridge(c, opt, ann_ty)
            } else {
                checker_check_expr_inplace(c, *e)
            }
        }
        None => {
            if ann_ty.kind != TypeKind::TyUnknown {
                ann_ty
            } else {
                ty_unit()
            }
        }
    }
}

// *mut transcription of check_let_stmt (12208). No inline by-value Checker call:
// every helper is *mut or an isolated leaf, so the hot frame stays KB-scale.
fn checker_check_let_stmt_inplace(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    (*c).last_literal_kind = 0  // reset before checking init expr
    let ann_ty = checker_lower_opt_type_inplace(c, s.ty)
    let init_ty = checker_check_binding_init_expr_inplace(c, s.expr, ann_ty)
    // Determine binding type: annotation if present, else init type
    var bind_ty = init_ty
    if ann_ty.kind != TypeKind::TyUnknown {
        // Integer literal narrowing: literal 5 (i64) is compatible with i32/i8 annotations
        let int_lit_narrow = (*c).last_literal_kind == 1
            && init_ty.kind == TypeKind::TyI64
            && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
        // C-style enum↔int assignment: a fieldless enum value coerces to/from a numeric
        // type (canonical bin/souc accepts `let x: i64 = E::A`). Matches the binary ==/!=
        // rule; this *mut fn has (*c).enums to detect enum-named types.
        let init_enum = init_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, init_ty.name) >= 0
        let ann_enum = ann_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, ann_ty.name) >= 0
        let enum_int_ok = (init_enum && is_numeric_type(ann_ty)) || (is_numeric_type(init_ty) && ann_enum)
        var init_context_ok = false
        match s.expr {
            Some(init_expr) => {
                init_context_ok = checker_contextual_expr_compatible(*init_expr, init_ty, ann_ty)
            }
            None => {
                init_context_ok = checker_types_compatible_inplace(c, init_ty, ann_ty)
            }
        }
        if !init_context_ok && !int_lit_narrow && !enum_int_ok {
            checker_report_mismatch_inplace(c, s.span, 1, ann_ty, init_ty)
        }
        if ann_ty.kind == init_ty.kind
            && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                || ann_ty.kind == TypeKind::TyValidated
                || ann_ty.kind == TypeKind::TyAdmissible
                || ann_ty.kind == TypeKind::TyDeferred
                || ann_ty.kind == TypeKind::TyAcquisitionPlan
                || ann_ty.kind == TypeKind::TyRecoursePlan
                || ann_ty.kind == TypeKind::TyTransitionPlan
                || ann_ty.kind == TypeKind::TyObservedTransition
                || ann_ty.kind == TypeKind::TyRollbackCertificate
                || ann_ty.kind == TypeKind::TyAlternativeSet
                || ann_ty.kind == TypeKind::TyAlternativeOption) {
            bind_ty = init_ty
        } else {
            bind_ty = ann_ty
            // N2: noise_set_id has no source-level annotation syntax (unlike
            // provenance/epsilon, which a `Knowledge[T, Measured]`-style
            // annotation legitimately DOES override -- that is the whole
            // point of ascribing it). checker_lower_knowledge_type_mut always
            // defaults an annotation's noise_set_id to -1, so taking ann_ty
            // verbatim here would silently erase whatever the RHS expression
            // actually seeded/unioned/substituted -- for EVERY explicitly-
            // typed Knowledge let, which is the common case in this corpus.
            // Carry the inferred RHS's noise_set_id through the ascription.
            if ann_ty.kind == TypeKind::TyKnowledge && init_ty.kind == TypeKind::TyKnowledge {
                bind_ty.noise_set_id = init_ty.noise_set_id
            }
        }
    }
    // Validate refinement predicate on literal initializers
    checker_check_refinement_literal_inplace(c, s.span, bind_ty)
    let const_pair = checker_eval_const_int_opt_expr_mut(c, s.expr)
    let cur_env = (*c).env
    (*c).env = cur_env.bind(s.name, bind_ty, false)
    if const_pair.0 != 0 {
        checker_const_int_bind_value_inplace(c, s.name, const_pair.1)
    } else {
        checker_const_int_bind_unknown_inplace(c, s.name)
    }
    // Track variable for borrow checking (linear if struct is declared linear)
    let lin = checker_is_linear_type_inplace(c, bind_ty)
    (*c).borrows = (*c).borrows.track(s.name, lin)
    // Propagate escape provenance: `let r = &x` taints r LOCAL; `let r = &self.f` keeps it first-class.
    (*c).borrows = (*c).borrows.set_provenance(s.name, checker_expr_provenance_opt(c, s.expr))
    ty_unit()
}


// *mut StmtVar handler — transcription of check_var_stmt (14041); mirrors the StmtLet
// handler but binds mutable. The init expr goes through the *mut spine (was: bridged to
// by-value check_stmt -> by-value check_expr -> the SRET-smash on assign/var RHS exprs).
fn checker_check_var_stmt_inplace(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    (*c).last_literal_kind = 0
    let ann_ty = checker_lower_opt_type_inplace(c, s.ty)
    let init_ty = checker_check_binding_init_expr_inplace(c, s.expr, ann_ty)
    var bind_ty = init_ty
    if ann_ty.kind != TypeKind::TyUnknown {
        let int_lit_narrow = (*c).last_literal_kind == 1
            && init_ty.kind == TypeKind::TyI64
            && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
        var init_context_ok = false
        match s.expr {
            Some(init_expr) => {
                init_context_ok = checker_contextual_expr_compatible(*init_expr, init_ty, ann_ty)
            }
            None => {
                init_context_ok = checker_types_compatible_inplace(c, init_ty, ann_ty)
            }
        }
        if !init_context_ok && !int_lit_narrow {
            checker_report_mismatch_inplace(c, s.span, 1, ann_ty, init_ty)
        }
        if ann_ty.kind == init_ty.kind
            && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                || ann_ty.kind == TypeKind::TyValidated
                || ann_ty.kind == TypeKind::TyAdmissible
                || ann_ty.kind == TypeKind::TyDeferred
                || ann_ty.kind == TypeKind::TyAcquisitionPlan
                || ann_ty.kind == TypeKind::TyRecoursePlan
                || ann_ty.kind == TypeKind::TyTransitionPlan
                || ann_ty.kind == TypeKind::TyObservedTransition
                || ann_ty.kind == TypeKind::TyRollbackCertificate
                || ann_ty.kind == TypeKind::TyAlternativeSet
                || ann_ty.kind == TypeKind::TyAlternativeOption) {
            bind_ty = init_ty
        } else {
            bind_ty = ann_ty
            // N2: see the matching comment in checker_check_let_stmt_inplace
            // -- noise_set_id has no annotation syntax, so carry it from the
            // inferred RHS rather than resetting it to the annotation's -1.
            if ann_ty.kind == TypeKind::TyKnowledge && init_ty.kind == TypeKind::TyKnowledge {
                bind_ty.noise_set_id = init_ty.noise_set_id
            }
        }
    }
    checker_check_refinement_literal_inplace(c, s.span, bind_ty)
    let const_pair = checker_eval_const_int_opt_expr_mut(c, s.expr)
    (*c).env = (*c).env.bind(s.name, bind_ty, true)
    if const_pair.0 != 0 {
        checker_const_int_bind_value_inplace(c, s.name, const_pair.1)
    } else {
        checker_const_int_bind_unknown_inplace(c, s.name)
    }
    let lin = checker_is_linear_type_inplace(c, bind_ty)
    (*c).borrows = (*c).borrows.track(s.name, lin)
    (*c).borrows = (*c).borrows.set_provenance(s.name, checker_expr_provenance_opt(c, s.expr))
    ty_unit()
}

// *mut assign-mutability (E003) — transcription of check_assign_mutability (14176).
fn checker_check_assign_mutability_inplace(c: *mut Checker, opt: Option<Box<Expr> >, span: Span) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIdent {
                // E003 only for a name that IS bound (a local) and is immutable (a `let`).
                // Module-level globals are not bound into env, so an unbound name is NOT a
                // local `let` — it's a global (mutable, per the oracle) or genuinely
                // undefined (a different error). Guarding on has_binding avoids a spurious
                // E003 on `GLOBAL = …` while preserving the true positive on local `let`.
                if (*c).env.has_binding((*e).name) && !(*c).env.lookup_is_mutable((*e).name) {
                    checker_report_error_at_inplace(c, span, 3, 0, 0, 0)
                }
            }
        }
        None => {}
    }
}

// *mut StmtAssign handler — transcription of check_assign_stmt (14136). The target and
// value exprs go through the *mut spine (was: by-value check_opt_expr -> SRET-smash).
// True if `ty` is a reference, or transitively contains one (array element, struct field).
// Used to reject storing a value that smuggles a reference inside an aggregate (a struct
// field or array element), which the bare-ref-type / provenance checks miss. Self-recursive,
// depth-bounded; conservative (an unregistered named type is treated as ref-free).
fn checker_type_has_ref(c: *mut Checker, ty: TypeEntry, depth: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    if depth > 16 { return false }
    if ty.kind == TypeKind::TyRef || ty.kind == TypeKind::TyRefMut
        || ty.kind == TypeKind::TySlice || ty.kind == TypeKind::TySliceMut {
        return true
    }
    if ty.kind == TypeKind::TyArray {
        match ty.inner {
            Some(el) => { return checker_type_has_ref(c, *el, depth + 1) }
            None => { return false }
        }
    }
    if ty.kind == TypeKind::TyNamed {
        let sidx = struct_table_find((*c).structs, ty.name)
        if sidx >= 0 && sidx < (*(*c).structs).count {
            let si = struct_table_get((*c).structs, sidx)
            var cur = si.fields
            var guard = 0
            while guard < 1024 {
                guard = guard + 1
                match cur {
                    Some(list) => {
                        if checker_type_has_ref(c, (*list).head.ty, depth + 1) { return true }
                        cur = (*list).tail
                    }
                    None => break
                }
            }
        }
        return false
    }
    false
}

fn checker_check_assign_stmt_inplace(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let target_ty = checker_check_opt_expr_inplace(c, s.target)
    let val_ty = checker_check_opt_expr_inplace(c, s.expr)
    if s.assign_op != AssignOp::AssignEq {
        if !is_error_or_unknown(target_ty) && !is_error_or_unknown(val_ty) {
            let compound_result = binary_result_type(compound_assign_to_binop(s.assign_op), target_ty, val_ty)
            if compound_result.kind == TypeKind::TyError {
                checker_report_mismatch_inplace(c, s.span, 21, target_ty, val_ty)
            }
        }
    } else {
        match s.expr {
            Some(val_expr) => {
                if !checker_contextual_expr_compatible(*val_expr, val_ty, target_ty) {
                    checker_report_mismatch_inplace(c, s.span, 2, target_ty, val_ty)
                }
            }
            None => {
                if !checker_types_compatible_inplace(c, target_ty, val_ty) {
                    checker_report_mismatch_inplace(c, s.span, 2, target_ty, val_ty)
                }
            }
        }
    }
    checker_check_assign_mutability_inplace(c, s.target, s.span)
    // Effect GENERATION at the store site (#1488).
    //
    // Madaros propagated declared effects correctly — a caller of a `with Mut`
    // callee was required to declare it — but had no leaf-level SOURCE of Mut.
    // Nothing anywhere introduced the effect at the point where mutation actually
    // happens, so `fn poke(x: &!i64) { *x = 42 }` type-checked with no `with Mut`
    // and every caller above it was unconstrained. The effect system propagated a
    // fact nobody ever asserted: `with Mut` was true only where a human had written
    // it, which makes the guarantee vacuous exactly at the leaves.
    //
    // Reuses checker_check_callee_effects_inplace rather than a new reporting path:
    // requiring Mut here is the same question as requiring a callee's effect, and
    // it already emits E035 with the missing-effect list.
    match s.target {
        Some(effect_target) => {
            if checker_place_excl_ref_root(c, *effect_target, 0) {
                var store_effects: [i64; 8] = [0; 8]
                // 1 = Mut (effect_name_to_id, self-hosted/check/effects.sio:26)
                store_effects[0] = 1
                checker_check_callee_effects_inplace(c, s.span, store_effects, 1)
            }
        }
        None => {}
    }
    // Raw-reference escape (store sites): a reference may not be stored into a struct field,
    // an array element, or through a pointer — doing so lets it outlive its referent → a
    // dangling reference. References are second-class: pass them to functions and read/write
    // through them, but do not store them. This catches both a frame-local reference
    // (provenance) and a reference-typed value of unknown origin such as a stored ref param
    // (interproc), the latter via the value type. Return escapes are caught at return sites.
    match s.target {
        Some(stgt) => {
            let stk = (*stgt).kind
            let is_store_place = stk == ExprKind::ExprFieldAccess
                || stk == ExprKind::ExprIndex
                || (stk == ExprKind::ExprUnary && (*stgt).un_op == UnaryOp::OpDeref)
            // A reference value (or an aggregate transitively containing a reference, e.g.
            // a stored ref parameter, or `H{p:r}`) may not be stored; or a frame-local
            // reference by provenance.
            let rhs_is_ref = checker_type_has_ref(c, val_ty, 0)
            if is_store_place && (rhs_is_ref || checker_expr_provenance_opt(c, s.expr) == 1) {
                checker_report_error_at_inplace(c, s.span, 91, 0, 0, 0)
            }
        }
        None => {}
    }
    match s.target {
        Some(target) => {
            if (*target).kind == ExprKind::ExprIdent {
                let rhs_pair = checker_eval_const_int_opt_expr_mut(c, s.expr)
                if rhs_pair.0 != 0 {
                    checker_const_int_bind_value_inplace(c, (*target).name, rhs_pair.1)
                } else {
                    checker_const_int_bind_unknown_inplace(c, (*target).name)
                }
                // N2 reassignment join (codex ruling 2026-08-23; env-φ
                // refinement round 3). `var x = measure(1); x = measure(2)`
                // must not leave x's env binding pinned to measure(1)'s
                // stale singleton forever -- this checker has no flow-
                // sensitive re-narrowing (nothing above rebinds env's TYPE
                // on assignment at all otherwise).
                //
                // TWO cases, because a rebind written HERE does not survive
                // equally in both:
                //
                // ns_branch_depth > 0 (inside an if/match branch body): a
                // `.bind()` here would just be discarded by that branch's
                // own block-scope pop_scope (checker_check_block_inplace) --
                // see checker_merge_ns_reassigned_inplace's header comment.
                // Go conservative locally (top, not union -- the sound
                // fallback for a value that might or might not have taken
                // this path) and record the name; the merge point (called
                // once the branch construct finishes, back in the outer,
                // SURVIVING scope) is what actually fixes the env.
                //
                // ns_branch_depth == 0 (straight-line, top-level code ONLY):
                // while/for loop bodies now DO participate (their check wraps
                // call checker_ns_branch_enter_inplace/_merge, so a
                // reassignment inside a loop body takes the depth>0 path above
                // and is widened to top at the post-loop merge -- see
                // ns_loop_widen_top_trace.sio). At depth 0 there is no
                // enclosing branch to discard the rebind before it's read, so
                // the monotone union with the OLD noise_set_id is sound and
                // sufficient.
                //
                // SOUNIO_NS_SABOTAGE_JOIN=1 disables BOTH cases, reproducing
                // the pre-fix "stays at the first value's set forever" bug.
                if target_ty.kind == TypeKind::TyKnowledge && val_ty.kind == TypeKind::TyKnowledge && !checker_ns_sabotage_join() {
                    if (*c).ns_branch_depth > 0 {
                        var forced = target_ty
                        forced.noise_set_id = 0 - 1
                        (*c).env = (*c).env.bind((*target).name, forced, true)
                        if (*c).ns_reassigned_count < 64 {
                            (*c).ns_reassigned_names[(*c).ns_reassigned_count as usize] = (*target).name
                            (*c).ns_reassigned_count = (*c).ns_reassigned_count + 1
                        } else {
                            // Cap reached: cannot record this name, so the
                            // depth-0 merge could not re-force it and it would
                            // revert to its pre-branch set (a fail-open). Mark
                            // overflow -> the merge forces ALL Knowledge to top.
                            (*c).ns_reassigned_overflow = true
                        }
                        checker_ns_trace_emit("env_reassign_branch", forced.noise_set_id)
                    } else {
                        var rebound = target_ty
                        rebound.noise_set_id = ns_union(&!(*(*c).ns_table), target_ty.noise_set_id, val_ty.noise_set_id)
                        (*c).env = (*c).env.bind((*target).name, rebound, true)
                        checker_ns_trace_emit("reassign_join", rebound.noise_set_id)
                    }
                }
            }
        }
        None => {}
    }
    ty_unit()
}

fn checker_check_items_inner_return_error_count_mut(c: *mut Checker, items: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    let next = (*c).check_items(items)
    next.error_count
}

fn checker_check_items_inner_store_stop_mut(c: *mut Checker, items: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    let next = (*c).check_items(items)
    checker_store_from_value(c, next)
    0
}

fn checker_check_items_inner_store_return_error_count_mut(c: *mut Checker, items: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    let next = (*c).check_items(items)
    checker_store_from_value(c, next)
    (*c).error_count
}

pub fn checker_check_items_inner_store_return_had_error_mut(c: *mut Checker, items: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    // Route through the true *mut spine: no 164KB by-value Checker copy
    // ever lands on the hot path, so the layout-sensitive stale-stack
    // codegen crash never fires. (Was: `(*c).check_items(items)` by value.)
    checker_check_items_inplace(c, items)
    checker_verify_dsep_claims_mut(c)
    checker_flush_unemitted_type_errors_mut(c)
    if (*c).had_error {
        1
    } else {
        0
    }
}

fn checker_collect_then_check_inner_emit_status_mut(c: *mut Checker, items: Option<Box<ItemList> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    let collected = (*c).collect_items(items)
    checker_store_from_value(c, collected)
    let next = (*c).check_items(items)
    checker_store_from_value(c, next)
    print("inner_had_error=")
    if (*c).had_error {
        print("1\n")
        1
    } else {
        print("0\n")
        0
    }
}

fn checker_error_count_scalar(c: *mut Checker) -> i64 with Mut, Panic, Div, Alloc, IO {
    (*c).error_count
}

fn checker_ontology_cache_slot_name(idx: i64) -> Name with Mut, Panic, Div {
    if idx == 0 { return make_name("cache_slot0") }
    if idx == 1 { return make_name("cache_slot1") }
    if idx == 2 { return make_name("cache_slot2") }
    if idx == 3 { return make_name("cache_slot3") }
    if idx == 4 { return make_name("cache_slot4") }
    if idx == 5 { return make_name("cache_slot5") }
    make_name("cache_slot")
}

fn checker_ontology_cache_slot_index(source_path: string, id: i64) -> i64 with IO, Mut, Panic, Div {
    let count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < count && i < 6 {
        if ontology_side_table_cache_source_slot_at(source_path, i) == id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn checker_hydrate_ontology_kernel_from_side_table_cache(checker: Checker, source_path: string) -> Checker with IO, Mut, Panic, Div, Alloc {
    var c = checker
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return c
    }

    c.ontology_kernel = ontology_kernel_empty()
    let slot_count = ontology_side_table_cache_source_slot_count(source_path)
    var i: i64 = 0
    while i < slot_count && i < 6 {
        let pair = ontology_kernel_add_class(c.ontology_kernel, checker_ontology_cache_slot_name(i), make_name("cache"))
        c.ontology_kernel = pair.0
        i = i + 1
    }

    let subclass_count = ontology_side_table_cache_source_subclass_axiom_count(source_path)
    i = 0
    while i < subclass_count && i < 4 {
        let subject = ontology_side_table_cache_source_subclass_subject_at(source_path, i)
        let object = ontology_side_table_cache_source_subclass_object_at(source_path, i)
        c.ontology_kernel = ontology_kernel_add_axiom(c.ontology_kernel, OntologyAxiom {
            axiom_type: owl_subclass_of(),
            subject_idx: subject,
            object_idx: object,
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        })
        i = i + 1
    }

    if ontology_side_table_cache_source_disjoint_axiom_count(source_path) > 0 {
        c.ontology_kernel = ontology_kernel_add_axiom(c.ontology_kernel, OntologyAxiom {
            axiom_type: owl_disjoint_classes(),
            subject_idx: ontology_side_table_cache_source_disjoint_subject0(source_path),
            object_idx: ontology_side_table_cache_source_disjoint_object0(source_path),
            refinement_ref_id: 0 - 1,
            property_name: empty_name(),
            is_property_axiom: false,
        })
    }

    c.ontology_kernel = ontology_kernel_materialize(c.ontology_kernel)
    c.ontology_kernel.profile = ontology_kernel_check_profile(c.ontology_kernel)
    c
}

pub fn checker_ontology_side_table_cache_kernel_subclass_verdict(source_path: string, child_id: i64, parent_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    let child_idx = checker_ontology_cache_slot_index(source_path, child_id)
    let parent_idx = checker_ontology_cache_slot_index(source_path, parent_id)
    if child_idx < 0 || parent_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    var checker = checker_new()
    checker = checker_hydrate_ontology_kernel_from_side_table_cache(checker, source_path)
    if ontology_kernel_is_subclass(checker.ontology_kernel, child_idx, parent_idx) {
        return ontology_side_table_cache_verdict_ok()
    }
    ontology_side_table_cache_verdict_reject()
}

pub fn checker_ontology_side_table_cache_kernel_disjoint_verdict(source_path: string, left_id: i64, right_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    let left_idx = checker_ontology_cache_slot_index(source_path, left_id)
    let right_idx = checker_ontology_cache_slot_index(source_path, right_id)
    if left_idx < 0 || right_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    var checker = checker_new()
    checker = checker_hydrate_ontology_kernel_from_side_table_cache(checker, source_path)
    if ontology_kernel_is_disjoint(checker.ontology_kernel, left_idx, right_idx) {
        return ontology_side_table_cache_verdict_ok()
    }
    ontology_side_table_cache_verdict_reject()
}

pub fn checker_check_items_with_ontology_cache_subclass_verdict(items: Option<Box<ItemList> >, source_path: string, child_id: i64, parent_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    print("checker_check_items_with_ontology_cache_subclass_verdict=enter\n")
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    print("checker_check_items_with_ontology_cache_subclass_verdict=cache_valid\n")
    let child_idx = checker_ontology_cache_slot_index(source_path, child_id)
    let parent_idx = checker_ontology_cache_slot_index(source_path, parent_id)
    if child_idx < 0 || parent_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    print("checker_check_items_with_ontology_cache_subclass_verdict=idx_ok\n")
    var checker = checker_new()
    checker = checker.collect_items(items)
    print("checker_check_items_with_ontology_cache_subclass_verdict=collect_ok\n")
    checker = checker_hydrate_ontology_kernel_from_side_table_cache(checker, source_path)
    print("checker_check_items_with_ontology_cache_subclass_verdict=hydrate_ok\n")
    checker = checker.check_items(items)
    print("checker_check_items_with_ontology_cache_subclass_verdict=check_ok\n")
    if checker.had_error {
        return 1
    }
    if ontology_kernel_is_subclass(checker.ontology_kernel, child_idx, parent_idx) {
        return ontology_side_table_cache_verdict_ok()
    }
    ontology_side_table_cache_verdict_reject()
}

pub fn checker_check_items_with_ontology_cache_disjoint_verdict(items: Option<Box<ItemList> >, source_path: string, left_id: i64, right_id: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    if !ontology_side_table_cache_source_plan_valid(source_path) {
        return ontology_side_table_cache_verdict_invalid_cache()
    }
    let left_idx = checker_ontology_cache_slot_index(source_path, left_id)
    let right_idx = checker_ontology_cache_slot_index(source_path, right_id)
    if left_idx < 0 || right_idx < 0 {
        return ontology_side_table_cache_verdict_reject()
    }
    var checker = checker_new()
    checker = checker.collect_items(items)
    checker = checker_hydrate_ontology_kernel_from_side_table_cache(checker, source_path)
    checker = checker.check_items(items)
    if checker.had_error {
        return 1
    }
    if ontology_kernel_is_disjoint(checker.ontology_kernel, left_idx, right_idx) {
        return ontology_side_table_cache_verdict_ok()
    }
    ontology_side_table_cache_verdict_reject()
}

