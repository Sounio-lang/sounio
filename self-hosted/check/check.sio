fn checker_lower_type_expr_mut(c: *mut Checker, te: TypeExpr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if !checker_enter_type_expr_mut(c) {
        return ty_error()
    }
    if checker_type_expr_contains_reserved_wide_float(&te) {
        checker_report_error_at_inplace(c, te.span, 249, 0, 0, 0)
        checker_exit_type_expr_mut(c)
        return ty_error()
    }

    let kind_tag = checker_type_expr_kind_tag(te)
    if kind_tag == 13 {
        let lowered = checker_lower_exactly_private_type_mut(c, te.inner, te.type_args, te.span)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 12 {
        let lowered = checker_lower_zd_wrapper_mut(c, te.inner, te.span, 200)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 14 {
        let lowered = checker_lower_zd_wrapper_mut(c, te.inner, te.span, 202)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 15 {
        let lowered = checker_lower_zd_wrapper_mut(c, te.inner, te.span, 203)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 16 {
        let lowered = checker_lower_zd_wrapper_mut(c, te.inner, te.span, 204)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 17 {
        let lowered = checker_lower_audited_type_mut(c, te.inner, te.span)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 18 {
        let lowered = checker_lower_revivable_type_mut(c, te.inner, te.span)
        checker_exit_type_expr_mut(c)
        return lowered
    }
    if kind_tag == 19 {
        let lowered = checker_lower_zd_wrapper_mut(c, te.inner, te.span, 207)
        checker_exit_type_expr_mut(c)
        return lowered
    }

    let lowered = match te.kind {
        TypeExprKind::TypeNamed => checker_lower_named_type_with_args_mut(c, te.path, te.type_args, te.span)
        TypeExprKind::TypeUnit => ty_unit()
        TypeExprKind::TypeNever => ty_never()
        TypeExprKind::TypeInfer => ty_unknown()
        TypeExprKind::TypeSelfUpper => (*c).current_impl_type
        TypeExprKind::TypeKnowledge => checker_lower_knowledge_type_mut(c, te.knowledge_info)
        TypeExprKind::TypeModel => checker_lower_model_type_mut(c, te.type_args, te.span)
        TypeExprKind::TypePolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeDecisionPolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_decision_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeDeferralPolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_deferral_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeAcquisitionPolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_acquisition_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeAcquisitionPlan => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_acquisition_plan(inner_ty, -1) }
        }
        TypeExprKind::TypeRecoursePolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_recourse_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeRecoursePlan => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_recourse_plan(inner_ty, -1) }
        }
        TypeExprKind::TypeTransitionPolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_transition_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeTransitionPlan => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_transition_plan(inner_ty, -1) }
        }
        TypeExprKind::TypeMonitoringPolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_monitoring_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeObservedTransition => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_observed_transition(inner_ty, -1) }
        }
        TypeExprKind::TypeRollbackCertificate => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_rollback_certificate(inner_ty, -1) }
        }
        TypeExprKind::TypeAlternativePolicy => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_alternative_policy(inner_ty, -1) }
        }
        TypeExprKind::TypeAlternativeSet => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_alternative_set(inner_ty, -1) }
        }
        TypeExprKind::TypeAlternativeOption => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_alternative_option(inner_ty, -1) }
        }
        TypeExprKind::TypeAdmissible => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_admissible(inner_ty, -1) }
        }
        TypeExprKind::TypeDeferred => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_deferred(inner_ty, -1) }
        }
        TypeExprKind::TypeContest => checker_lower_contest_type_mut(c, te.type_args, te.span)
        TypeExprKind::TypeRobust => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_robust(inner_ty, -1, -1, -1) }
        }
        TypeExprKind::TypeValidated => {
            let inner_ty = checker_lower_single_wrapper_arg_mut(c, te.type_args)
            if inner_ty.kind == TypeKind::TyError { ty_error() } else { ty_validated(inner_ty, -1.0) }
        }
        TypeExprKind::TypeFn => checker_lower_fn_type_expr_mut(c, te)
        TypeExprKind::TypeArray => checker_lower_array_type_mut(c, te.inner, te.array_size)
        TypeExprKind::TypeTuple => checker_lower_tuple_type_mut(c, te.type_args)
        TypeExprKind::TypeReference => checker_lower_ref_type_mut(c, te.inner)
        TypeExprKind::TypeRefMut => checker_lower_ref_mut_type_mut(c, te.inner)
        TypeExprKind::TypeRawPtr => checker_lower_raw_ptr_type_mut(c, te.inner, te.array_size)
        TypeExprKind::TypeRefinement => checker_lower_refinement_type_mut(c, te.refinement_info)
        _ => {
            checker_note_type_error_mut(c)
            ty_error()
        }
    }

    checker_exit_type_expr_mut(c)
    lowered
}

pub fn checker_collect_items_mut(c: *mut Checker, items: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    // Route through the true *mut collect spine (ItemFn handled in place,
    // other item kinds bridge by value). The crash lived here: the by-value
    // (*c).collect_items(items) copied the 164KB Checker into `self` and
    // tripped the layout-sensitive stale-stack codegen bug. (Was: that call.)
    checker_collect_items_inplace(c, items)
}

pub fn checker_check_items_mut(c: *mut Checker, items: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    checker_check_items_inplace(c, items)
}

fn checker_check_expr_mut(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let pair = (*c).check_expr(e)
    checker_store_from_value(c, pair.0)
    pair.1
}

fn checker_check_contest_expr_expected_mut(c: *mut Checker, e: Expr, expected_contest_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if expected_contest_ty.kind != TypeKind::TyContest {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if !contest_model_list_present(e.args) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    var subject_ty = ty_error()
    match e.left {
        Some(subject_expr) => {
            if (*subject_expr).kind == ExprKind::ExprIdent {
                subject_ty = (*c).env.lookup((*subject_expr).name)
            } else {
                checker_note_type_error_mut(c)
                return ty_error()
            }
        }
        None => {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    if !types_compatible(subject_ty, knowledge_inner(expected_contest_ty)) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    var info = contest_info_from_expr_models(e.args)
    info.span_start = e.span.start
    info.span_end = e.span.end
    if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < (*c).contests.count {
        let expected_info = (*c).contests.get(expected_contest_ty.epistemic_meta_id)
        info.family_id = expected_info.family_id
        info.policy_id = expected_info.policy_id
        info.audit_id = expected_info.audit_id
        var i: i64 = 0
        while i < 8 {
            info.metric_known[i as usize] = expected_info.metric_known[i as usize]
            info.metric_values[i as usize] = expected_info.metric_values[i as usize]
            i = i + 1
        }
        info.mechanistic_report_id = expected_info.mechanistic_report_id
        info.posterior_weights_id = expected_info.posterior_weights_id
        info.counterexample_id = expected_info.counterexample_id
        info.provenance_bundle_id = expected_info.provenance_bundle_id
        if expected_info.family_id >= 0 {
            if expected_info.family_id >= (*c).model_families.count {
                checker_note_type_error_mut(c)
                return ty_error()
            }
            let family_info = (*c).model_families.get(expected_info.family_id)
            if !contest_model_lists_match(e.args, family_info, 0) {
                checker_note_type_error_mut(c)
                return ty_error()
            }
            if !types_compatible(subject_ty, family_info.input_ty) {
                checker_note_type_error_mut(c)
                return ty_error()
            }
        }
        (*c).contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
        ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id)
    } else {
        let add_result = (*c).contests.add(info)
        (*c).contests = add_result.0
        ty_contest(knowledge_inner(expected_contest_ty), add_result.1)
    }
}

fn checker_check_contest_witness_names_mut(c: *mut Checker, witness_name: Name, contest_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let witness_kind = contest_witness_kind_from_name(witness_name)
    if witness_kind < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let contest_ty = (*c).env.lookup(contest_name)
    if contest_ty.kind != TypeKind::TyContest {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= (*c).contests.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let contest_id = contest_ty.epistemic_meta_id
    let contest_info = (*c).contests.get(contest_id)
    if contest_info.family_id < 0 || contest_info.policy_id < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if contest_witness_requires_metric(witness_kind) {
        let metric_id = contest_witness_metric_id(witness_kind)
        if metric_id < 0 || contest_info.metric_known[metric_id as usize] == 0 {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    if contest_witness_requires_mechanistic(witness_kind) {
        if contest_info.mechanistic_report_id < 0 || contest_info.mechanistic_report_id >= (*c).mechanistic_reports.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    if witness_kind == CONTEST_WITNESS_DISAGREEMENT {
        if contest_info.metric_known[CONTEST_METRIC_SIGN_CONSENSUS as usize] == 0
        || contest_info.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 0
        || contest_info.metric_known[CONTEST_METRIC_MAX_TAIL_RISK as usize] == 0
        || contest_info.metric_known[CONTEST_METRIC_IDENTIFIABILITY_FLOOR as usize] == 0 {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= (*c).counterexamples.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= (*c).posterior_weights.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    if witness_kind == CONTEST_WITNESS_COUNTEREXAMPLE {
        if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= (*c).counterexamples.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    if witness_kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
        if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= (*c).posterior_weights.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
    }
    let add_result = (*c).contest_witnesses.add(contest_witness_info_new(span, witness_kind, contest_id))
    (*c).contest_witnesses = add_result.0
    contest_witness_result_type(witness_kind)
}

fn checker_decision_policy_requirements_hold_mut(c: *mut Checker, reqs: Option<Box<PolicyRequirementInfoList> >, proof_info: RobustProofInfo) -> bool with Mut, Panic, Div, Alloc {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || proof_info.metric_known[req.metric_id as usize] == 0 {
                    checker_note_type_error_mut(c)
                    return false
                }
                let metric_value = proof_info.metric_values[req.metric_id as usize]
                if !policy_requirement_holds(metric_value, req.op, req.threshold) {
                    checker_note_type_error_mut(c)
                    return false
                }
                cursor = (*list).tail
            }
            None => {
                return true
            }
        }
    }
    true
}

fn checker_admit_action_names_mut(c: *mut Checker, value_name: Name, robust_ty: TypeEntry, decision_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let value_ty = (*c).env.lookup(value_name)
    if robust_ty.kind != TypeKind::TyRobust {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if robust_ty.robustness_level_id < 0 || robust_ty.robustness_scope_id < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= (*c).robust_proofs.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let decision_ty = (*c).env.lookup(decision_name)
    if decision_ty.kind != TypeKind::TyDecisionPolicy {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if decision_ty.epistemic_meta_id < 0 || decision_ty.epistemic_meta_id >= (*c).decision_policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let inner_ty = knowledge_inner(robust_ty)
    if !types_compatible(inner_ty, value_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_info = (*c).decision_policies.get(decision_ty.epistemic_meta_id)
    if !types_compatible(policy_info.target_ty, inner_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let proof_info = (*c).robust_proofs.get(robust_ty.epistemic_meta_id)
    if policy_info.requirement_count > 0 {
        if !checker_decision_policy_requirements_hold_mut(c, policy_info.requirements, proof_info) {
            return ty_error()
        }
    }
    let cert_info = DecisionCertificateInfo {
        span_start: span.start,
        span_end: span.end,
        audit_id: proof_info.audit_id,
        robust_proof_id: robust_ty.epistemic_meta_id,
        decision_policy_id: decision_ty.epistemic_meta_id,
        inner_ty: inner_ty,
        metric_known: proof_info.metric_known,
        metric_values: proof_info.metric_values,
    }
    let add_result = (*c).decision_certificates.add(cert_info)
    (*c).decision_certificates = add_result.0
    ty_admissible(inner_ty, add_result.1)
}

fn checker_defer_action_with_evidence_mut(c: *mut Checker, value_name: Name, evidence_ty: TypeEntry, deferral_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let value_ty = (*c).env.lookup(value_name)
    let policy_ty = (*c).env.lookup(deferral_name)
    if policy_ty.kind != TypeKind::TyDeferralPolicy {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= (*c).deferral_policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_info = (*c).deferral_policies.get(policy_ty.epistemic_meta_id)

    if evidence_ty.kind == TypeKind::TyContest {
        let inner_ty = knowledge_inner(evidence_ty)
        if !types_compatible(inner_ty, value_ty) || !types_compatible(policy_info.target_ty, inner_ty) {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= (*c).contests.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        let contest_info = (*c).contests.get(evidence_ty.epistemic_meta_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if policy_info.requirement_count > 0 {
            if !checker_policy_requirements_hold_mut(c, policy_info.requirements, evidence_ty.epistemic_meta_id) {
                return ty_error()
            }
        }
        let cert_info = DeferredCertificateInfo {
            span_start: span.start,
            span_end: span.end,
            audit_id: contest_info.audit_id,
            contest_id: evidence_ty.epistemic_meta_id,
            robust_proof_id: -1,
            deferral_policy_id: policy_ty.epistemic_meta_id,
            evidence_kind: DEFERRAL_EVIDENCE_CONTEST,
            reason_code: DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT,
            inner_ty: inner_ty,
            metric_known: contest_info.metric_known,
            metric_values: contest_info.metric_values,
        }
        let add_result = (*c).deferred_certificates.add(cert_info)
        (*c).deferred_certificates = add_result.0
        return ty_deferred(inner_ty, add_result.1)
    }

    if evidence_ty.kind == TypeKind::TyRobust {
        let inner_ty = knowledge_inner(evidence_ty)
        if !types_compatible(inner_ty, value_ty) || !types_compatible(policy_info.target_ty, inner_ty) {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if evidence_ty.robustness_level_id < 0 || evidence_ty.robustness_scope_id < 0 {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= (*c).robust_proofs.count {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        let proof_info = (*c).robust_proofs.get(evidence_ty.epistemic_meta_id)
        if proof_info.contest_id < 0 {
            checker_note_type_error_mut(c)
            return ty_error()
        }
        if policy_info.requirement_count > 0 {
            if !checker_decision_policy_requirements_hold_mut(c, policy_info.requirements, proof_info) {
                return ty_error()
            }
        }
        let cert_info = DeferredCertificateInfo {
            span_start: span.start,
            span_end: span.end,
            audit_id: proof_info.audit_id,
            contest_id: proof_info.contest_id,
            robust_proof_id: evidence_ty.epistemic_meta_id,
            deferral_policy_id: policy_ty.epistemic_meta_id,
            evidence_kind: DEFERRAL_EVIDENCE_ROBUST,
            reason_code: DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT,
            inner_ty: inner_ty,
            metric_known: proof_info.metric_known,
            metric_values: proof_info.metric_values,
        }
        let add_result = (*c).deferred_certificates.add(cert_info)
        (*c).deferred_certificates = add_result.0
        return ty_deferred(inner_ty, add_result.1)
    }

    checker_note_type_error_mut(c)
    ty_error()
}

fn checker_deferral_reason_from_deferred_mut(c: *mut Checker, deferred_ty: TypeEntry, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    if deferred_ty.kind != TypeKind::TyDeferred {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= (*c).deferred_certificates.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let info = DeferredReasonWitnessInfo {
        span_start: span.start,
        span_end: span.end,
        deferred_certificate_id: deferred_ty.epistemic_meta_id,
    }
    let add_result = (*c).deferred_reason_witnesses.add(info)
    (*c).deferred_reason_witnesses = add_result.0
    ty_named(deferral_reason_type_name())
}

fn checker_transition_step_value_ty_mut(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprIntLit {
        return ty_i64()
    }
    if e.kind == ExprKind::ExprFloatLit {
        return ty_f64()
    }
    if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
        return (*c).env.lookup(contest_model_name(e))
    }
    ty_error()
}

fn checker_transition_expr_value_repr_mut(e: Expr) -> Name with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
        return contest_model_name(e)
    }
    if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
        return make_name("literal")
    }
    make_name("transition_value")
}

fn checker_transition_expr_value_matches_candidate_mut(step_expr: Expr, candidate_expr: Expr) -> bool with Mut, Panic, Div, Alloc {
    if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprIntLit {
        return step_expr.int_val == candidate_expr.int_val
    }
    if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprFloatLit {
        return step_expr.float_val == candidate_expr.float_val
    }
    if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprFloatLit {
        return (step_expr.int_val as f64) == candidate_expr.float_val
    }
    if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprIntLit {
        return step_expr.float_val == (candidate_expr.int_val as f64)
    }
    if (step_expr.kind == ExprKind::ExprIdent || step_expr.kind == ExprKind::ExprPath)
        && (candidate_expr.kind == ExprKind::ExprIdent || candidate_expr.kind == ExprKind::ExprPath) {
        return name_eq(contest_model_name(step_expr), contest_model_name(candidate_expr))
    }
    false
}

fn checker_transition_metric_from_candidate_mut(candidate: AlternativeCandidateInfo, metric_id: i64) -> (i64, f64) with Mut, Panic, Div {
    if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
        if candidate.metric_known[ALTERNATIVE_METRIC_INTERVENTION_COST as usize] == 1 {
            return (1, candidate.metric_values[ALTERNATIVE_METRIC_INTERVENTION_COST as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
        if candidate.metric_known[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize] == 1 {
            return (1, candidate.metric_values[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
        if candidate.metric_known[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize] == 1 {
            return (1, candidate.metric_values[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
        if candidate.metric_known[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize] == 1 {
            return (1, candidate.metric_values[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize])
        }
    }
    (0, 0.0)
}

fn checker_transition_requirements_hold_mut(c: *mut Checker, reqs: Option<Box<PolicyRequirementInfoList> >, candidate: AlternativeCandidateInfo) -> bool with Mut, Panic, Div, Alloc {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                let metric_pair = checker_transition_metric_from_candidate_mut(candidate, req.metric_id)
                if metric_pair.0 == 0 {
                    checker_note_type_error_mut(c)
                    return false
                }
                if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                    checker_note_type_error_mut(c)
                    return false
                }
                cursor = (*list).tail
            }
            None => {
                return true
            }
        }
    }
    true
}

fn checker_transition_metric_from_plan_mut(plan: TransitionPlanInfo, metric_id: i64) -> (i64, f64) with Mut, Panic, Div {
    if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
        if plan.metric_known[ALTERNATIVE_METRIC_INTERVENTION_COST as usize] == 1 {
            return (1, plan.metric_values[ALTERNATIVE_METRIC_INTERVENTION_COST as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
        if plan.metric_known[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize] == 1 {
            return (1, plan.metric_values[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
        if plan.metric_known[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize] == 1 {
            return (1, plan.metric_values[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize])
        }
    }
    if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
        if plan.metric_known[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize] == 1 {
            return (1, plan.metric_values[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize])
        }
    }
    (0, 0.0)
}

fn checker_monitoring_requirements_hold_mut(c: *mut Checker, reqs: Option<Box<PolicyRequirementInfoList> >, plan: TransitionPlanInfo) -> bool with Mut, Panic, Div, Alloc {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                let metric_pair = checker_transition_metric_from_plan_mut(plan, req.metric_id)
                if metric_pair.0 == 0 {
                    checker_note_type_error_mut(c)
                    return false
                }
                if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                    checker_note_type_error_mut(c)
                    return false
                }
                cursor = (*list).tail
            }
            None => {
                return true
            }
        }
    }
    true
}

fn checker_monitoring_requirements_hold_silent_mut(reqs: Option<Box<PolicyRequirementInfoList> >, plan: TransitionPlanInfo) -> bool with Mut, Panic, Div {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                let metric_pair = checker_transition_metric_from_plan_mut(plan, req.metric_id)
                if metric_pair.0 == 0 {
                    return false
                }
                if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                    return false
                }
                cursor = (*list).tail
            }
            None => {
                return true
            }
        }
    }
    true
}

fn checker_monitoring_reason_code_from_reqs_mut(reqs: Option<Box<PolicyRequirementInfoList> >, plan: TransitionPlanInfo) -> i64 with Mut, Panic, Div {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                let metric_pair = checker_transition_metric_from_plan_mut(plan, req.metric_id)
                if metric_pair.0 == 0 || !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                    if req.metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
                        return DEFERRAL_REASON_MECHANISTIC_CONFLICT
                    }
                    if req.metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
                        return DEFERRAL_REASON_TAIL_RISK
                    }
                    return DEFERRAL_REASON_POLICY_INCOMPLETE
                }
                cursor = (*list).tail
            }
            None => {
                return DEFERRAL_REASON_POLICY_INCOMPLETE
            }
        }
    }
    DEFERRAL_REASON_POLICY_INCOMPLETE
}

fn checker_commit_alternative_names_mut(c: *mut Checker, value_name: Name, option_name: Name, protocol_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let value_ty = (*c).env.lookup(value_name)
    let option_ty = (*c).env.lookup(option_name)
    if option_ty.kind != TypeKind::TyAlternativeOption
        || option_ty.epistemic_meta_id < 0
        || option_ty.epistemic_meta_id >= (*c).alternative_candidates.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let candidate_info = (*c).alternative_candidates.get(option_ty.epistemic_meta_id)
    let inner_ty = knowledge_inner(option_ty)
    if !types_compatible(inner_ty, value_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let protocol_id = (*c).transition_protocols.find(protocol_name)
    if protocol_id < 0 || protocol_id >= (*c).transition_protocols.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let protocol_info = (*c).transition_protocols.get(protocol_id)
    if !types_compatible(protocol_info.target_ty, option_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_id = protocol_info.transition_policy_id
    if policy_id < 0 || policy_id >= (*c).transition_policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_info = (*c).transition_policies.get(policy_id)
    if !types_compatible(policy_info.target_ty, inner_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_info.max_steps >= 0 && protocol_info.step_count > policy_info.max_steps {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_info.requirement_count > 0 {
        if !checker_transition_requirements_hold_mut(c, policy_info.requirements, candidate_info) {
            return ty_error()
        }
    }

    var final_step_expr = candidate_info.value_expr
    var final_step_repr = candidate_info.value_repr
    var i: i64 = 0
    while i < protocol_info.step_count && i < 16 {
        let step_id = protocol_info.step_ids[i as usize]
        if step_id >= 0 && step_id < (*c).transition_steps.count {
            let step_info = (*c).transition_steps.get(step_id)
            let step_value_ty = checker_transition_step_value_ty_mut(c, step_info.value_expr)
            if !types_compatible(inner_ty, step_value_ty) {
                checker_note_type_error_mut(c)
                return ty_error()
            }
            if step_info.requirement_count > 0 {
                if !checker_transition_requirements_hold_mut(c, step_info.requirements, candidate_info) {
                    return ty_error()
                }
            }
            final_step_expr = step_info.value_expr
            final_step_repr = checker_transition_expr_value_repr_mut(step_info.value_expr)
        }
        i = i + 1
    }
    if protocol_info.step_count <= 0 || !checker_transition_expr_value_matches_candidate_mut(final_step_expr, candidate_info.value_expr) {
        checker_note_type_error_mut(c)
        return ty_error()
    }

    let plan_info = TransitionPlanInfo {
        span_start: span.start,
        span_end: span.end,
        transition_policy_id: policy_id,
        transition_protocol_id: protocol_id,
        alternative_option_id: option_ty.epistemic_meta_id,
        audit_id: candidate_info.audit_id,
        contest_id: candidate_info.contest_id,
        route_name: policy_info.route_name,
        rollback_route_name: policy_info.rollback_route_name,
        step_count: protocol_info.step_count,
        final_value_repr: final_step_repr,
        inner_ty: inner_ty,
        metric_known: candidate_info.metric_known,
        metric_values: candidate_info.metric_values,
    }
    let add_result = (*c).transition_plans.add(plan_info)
    (*c).transition_plans = add_result.0
    ty_transition_plan(inner_ty, add_result.1)
}

fn checker_transition_reason_from_plan_mut(c: *mut Checker, plan_ty: TypeEntry, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    if plan_ty.kind != TypeKind::TyTransitionPlan {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= (*c).transition_plans.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let info = TransitionReasonWitnessInfo {
        span_start: span.start,
        span_end: span.end,
        transition_plan_id: plan_ty.epistemic_meta_id,
    }
    let add_result = (*c).transition_reason_witnesses.add(info)
    (*c).transition_reason_witnesses = add_result.0
    ty_named(transition_reason_type_name())
}

fn checker_observe_transition_names_mut(c: *mut Checker, value_name: Name, plan_ty: TypeEntry, monitoring_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let value_ty = (*c).env.lookup(value_name)
    if plan_ty.kind != TypeKind::TyTransitionPlan
        || plan_ty.epistemic_meta_id < 0
        || plan_ty.epistemic_meta_id >= (*c).transition_plans.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let inner_ty = knowledge_inner(plan_ty)
    if !types_compatible(inner_ty, value_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_ty = (*c).env.lookup(monitoring_name)
    if policy_ty.kind != TypeKind::TyMonitoringPolicy
        || policy_ty.epistemic_meta_id < 0
        || policy_ty.epistemic_meta_id >= (*c).monitoring_policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let plan_info = (*c).transition_plans.get(plan_ty.epistemic_meta_id)
    let policy_info = (*c).monitoring_policies.get(policy_ty.epistemic_meta_id)
    if !types_compatible(policy_info.target_ty, inner_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_info.requirement_count > 0 {
        if !checker_monitoring_requirements_hold_mut(c, policy_info.requirements, plan_info) {
            return ty_error()
        }
    }
    let observed_info = ObservedTransitionInfo {
        span_start: span.start,
        span_end: span.end,
        transition_plan_id: plan_ty.epistemic_meta_id,
        monitoring_policy_id: policy_ty.epistemic_meta_id,
        audit_id: plan_info.audit_id,
        contest_id: plan_info.contest_id,
        route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
        rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
        inner_ty: inner_ty,
        metric_known: plan_info.metric_known,
        metric_values: plan_info.metric_values,
    }
    let add_result = (*c).observed_transitions.add(observed_info)
    (*c).observed_transitions = add_result.0
    ty_observed_transition(inner_ty, add_result.1)
}

fn checker_rollback_transition_names_mut(c: *mut Checker, value_name: Name, plan_ty: TypeEntry, monitoring_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc {
    let value_ty = (*c).env.lookup(value_name)
    if plan_ty.kind != TypeKind::TyTransitionPlan
        || plan_ty.epistemic_meta_id < 0
        || plan_ty.epistemic_meta_id >= (*c).transition_plans.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let inner_ty = knowledge_inner(plan_ty)
    if !types_compatible(inner_ty, value_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_ty = (*c).env.lookup(monitoring_name)
    if policy_ty.kind != TypeKind::TyMonitoringPolicy
        || policy_ty.epistemic_meta_id < 0
        || policy_ty.epistemic_meta_id >= (*c).monitoring_policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let plan_info = (*c).transition_plans.get(plan_ty.epistemic_meta_id)
    let policy_info = (*c).monitoring_policies.get(policy_ty.epistemic_meta_id)
    if !types_compatible(policy_info.target_ty, inner_ty) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_info.requirement_count <= 0 || checker_monitoring_requirements_hold_silent_mut(policy_info.requirements, plan_info) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let rollback_info = RollbackCertificateInfo {
        span_start: span.start,
        span_end: span.end,
        transition_plan_id: plan_ty.epistemic_meta_id,
        monitoring_policy_id: policy_ty.epistemic_meta_id,
        audit_id: plan_info.audit_id,
        contest_id: plan_info.contest_id,
        route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
        rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
        reason_code: checker_monitoring_reason_code_from_reqs_mut(policy_info.requirements, plan_info),
        inner_ty: inner_ty,
        metric_known: plan_info.metric_known,
        metric_values: plan_info.metric_values,
    }
    let add_result = (*c).rollback_certificates.add(rollback_info)
    (*c).rollback_certificates = add_result.0
    ty_rollback_certificate(inner_ty, add_result.1)
}

fn checker_policy_requirements_hold_mut(c: *mut Checker, reqs: Option<Box<PolicyRequirementInfoList> >, contest_id: i64) -> bool with Mut, Panic, Div, Alloc {
    var cursor = reqs
    while true {
        match cursor {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || contest_id < 0 || contest_id >= (*c).contests.count {
                    checker_note_type_error_mut(c)
                    return false
                }
                let contest_info = (*c).contests.get(contest_id)
                if contest_info.metric_known[req.metric_id as usize] != 1 {
                    checker_note_type_error_mut(c)
                    return false
                }
                let metric_value = contest_info.metric_values[req.metric_id as usize]
                if !policy_requirement_holds(metric_value, req.op, req.threshold) {
                    checker_note_type_error_mut(c)
                    return false
                }
                cursor = (*list).tail
            }
            None => {
                return true
            }
        }
    }
    true
}

fn checker_prove_robust_names_mut(c: *mut Checker, contest_name: Name, policy_name: Name, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let policy_ty = (*c).env.lookup(policy_name)
    if policy_ty.kind != TypeKind::TyPolicy {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= (*c).policies.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let policy_info = (*c).policies.get(policy_ty.epistemic_meta_id)
    if policy_info.level_id < 0 || policy_info.scope_id < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }

    let contest_ty = (*c).env.lookup(contest_name)
    if contest_ty.kind != TypeKind::TyContest {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let contest_inner = knowledge_inner(policy_ty)
    if !types_compatible(knowledge_inner(contest_ty), contest_inner) {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= (*c).contests.count {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    let contest_info = (*c).contests.get(contest_ty.epistemic_meta_id)
    if contest_info.family_id < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    if contest_info.policy_id >= 0 && contest_info.policy_id != policy_ty.epistemic_meta_id {
        checker_note_type_error_mut(c)
        return ty_error()
    }

    if policy_info.requirement_count > 0 {
        if !checker_policy_requirements_hold_mut(c, policy_info.requirements, contest_ty.epistemic_meta_id) {
            return ty_error()
        }
    }

    let proof_info = robust_proof_info_from_contest(contest_ty.epistemic_meta_id, contest_info, policy_info, span)
    let add_result = (*c).robust_proofs.add(proof_info)
    (*c).robust_proofs = add_result.0
    ty_robust(contest_inner, add_result.1, policy_info.level_id, policy_info.scope_id)
}

// ============================================================
// True *mut Checker hot-path spine.
//
// The by-value check_* method chain threads a 164KB Checker struct
// through dozens of (Checker, X) returns and `c = c.method()` hops.
// On the deep recursion that chain trips a layout-sensitive
// stale-stack codegen bug (see docs/audit/...STACK_CLASH...), which
// SIGSEGVs even on a trivial `fn main() { return 0 }`. These
// functions operate directly on `*mut Checker` via `(*c).field`,
// so no full-Checker copy ever lands on the hot path. Expression
// kinds not yet ported fall back to the by-value bridge
// `checker_check_expr_mut` (a single copy, off the hello.sio path).
// ============================================================

fn checker_report_error_at_inplace(c: *mut Checker, span: Span, code: i64, msg_a: i64, msg_b: i64, msg_c: i64) with Mut, IO, Panic, Div, Alloc {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
    (*c).diag_emitted = true
    print("error[E")
    if code < 100 { print("0") }
    if code < 10 { print("0") }
    print_int(code)
    print("]")
    // WHERE, for the third time and the same reason as E035 and E002. This is
    // the widest reporter in the checker -- E175 among many others -- and it
    // printed a bare span. On the self-hosted sources that span is a BUNDLE
    // offset with start pinned at 0, so a reader is handed "at 0..79850" and
    // cannot open a single one of the 2 269 E175s that lean.sio produces. The
    // module and the function are already on the Checker; they cost two prints.
    print(" in ")
    e035_print_module_path((*c).current_module)
    print("::")
    e035_print_ident((*c).current_fn_name)
    if span.start > 0 || span.end > 0 {
        print(" at ")
        print_int(span.start)
        print("..")
        print_int(span.end)
    }
    print(": ")
    print_error_message(code)
    print("\n")
    print_error_help(code)
    print_error_note(code)
}

// E175 says a function is private in its defining module without saying WHICH
// function or WHOSE module, which makes it unactionable at scale and, worse,
// indistinguishable from the known false positive: two modules each owning a
// private function of the same name, where name-only lookup resolves the call
// to the wrong table entry (tests/compiler/madaros_visibility_context). The
// callee's path plus both module ids separate the two cases on sight -- equal
// paths with different ids is the lookup bug, different paths is a real
// violation.
fn checker_report_private_fn_inplace(c: *mut Checker, span: Span, sig_id: i64) with Mut, IO, Panic, Div, Alloc {
    checker_report_error_at_inplace(c, span, 175, 0, 0, 0)
    let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
    print("   = callee ")
    e035_print_module_path(sig.defining_module)
    print("::")
    e035_print_ident(sig.name)
    print("\n   = defining module id ")
    print_int(sig.defining_module_id)
    print(", calling from module id ")
    print_int((*c).current_module_id)
    print("\n")
}

// E177 is E175 one wall further in: "enum constructor is private in its defining
// module", 820 of them on lean.sio, and until now none said which enum or whose
// module. It also has a second ambiguity E175 does not, because a path
// expression reaches an enum two ways -- by the enum's own name, or by a bare
// variant name that resolves back to it. Printing what was WRITTEN alongside
// what it RESOLVED TO separates "you named a private enum" from "you named a
// variant whose enum happens to be private", which are different fixes.
fn checker_report_private_enum_inplace(c: *mut Checker, span: Span, enum_idx: i64, referenced: Name) with Mut, IO, Panic, Div, Alloc {
    checker_report_error_at_inplace(c, span, 177, 0, 0, 0)
    let ei = enum_table_get((*c).enums, enum_idx)
    print("   = enum ")
    e035_print_module_path(ei.defining_module)
    print("::")
    e035_print_ident(ei.name)
    print("\n   = written as ")
    e035_print_ident(referenced)
    print("\n   = defining module id ")
    print_int(ei.defining_module_id)
    print(", used from module id ")
    print_int((*c).current_module_id)
    print("\n")
}

// E012 said "this type has no field named" and then named neither the field nor
// the type, which on a bundle span leaves the reader with nothing at all. Both
// are in scope at every site that can say them: the field is the accessor's own
// name, the owner is the base type already computed to reach the check.
fn checker_report_no_field_inplace(c: *mut Checker, span: Span, field: Name, owner: TypeEntry) with Mut, IO, Panic, Div, Alloc {
    checker_report_error_at_inplace(c, span, 12, 0, 0, 0)
    print("   = no field ")
    e035_print_ident(field)
    print(" on type ")
    print_type_name(owner)
    print("\n")
}

// E137 said "use of undeclared variable" and then did not say which one. Both
// emission sites hold the identifier that failed to resolve, and on a bundle
// span the name is the only thing that lets a reader find it at all. Same
// omission as E175, E177 and E012 had, same fix.
fn checker_report_undeclared_inplace(c: *mut Checker, span: Span, ident: Name) with Mut, IO, Panic, Div, Alloc {
    checker_report_error_at_inplace(c, span, 137, 0, 0, 0)
    print("   = name ")
    e035_print_ident(ident)
    print("\n")
}

fn checker_report_mismatch_inplace(c: *mut Checker, span: Span, code: i64, expected: TypeEntry, got: TypeEntry) with Mut, IO, Panic, Div, Alloc {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
    (*c).diag_emitted = true
    print("error[E")
    if code < 100 { print("0") }
    if code < 10 { print("0") }
    print_int(code)
    print("]")
    // WHERE, for the same reason E035 needed it. This reporter carries a Span,
    // but for assignment statements that span is unusable: every E002 in the
    // driver's closure came out exactly 32 bytes wide and starting mid-token, so
    // it indexes nothing a reader can open. Module and function are on the
    // Checker already -- current_module for E175, current_fn_name added with the
    // E035 fix -- and cost two prints.
    print(" in ")
    e035_print_module_path((*c).current_module)
    print("::")
    e035_print_ident((*c).current_fn_name)
    if span.start > 0 || span.end > 0 {
        print(" at ")
        print_int(span.start)
        print("..")
        print_int(span.end)
    }
    print(": ")
    if got.kind == TypeKind::TyContest && expected.kind != TypeKind::TyContest {
        print("cannot implicitly coerce contested evidence into this type")
    } else {
        print_error_message(code)
    }
    print("\n   |\n   = expected ")
    print_type_name(expected)
    print("\n   = found ")
    print_type_name(got)
    print("\n")
    print_error_help(code)
    print_error_note(code)
}

fn checker_report_unobserved_print_inplace(c: *mut Checker, span: Span) with Mut, IO, Panic, Div {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
    (*c).diag_emitted = true
    print("error[E036]")
    if span.start > 0 || span.end > 0 {
        print(" at ")
        print_int(span.start)
        print("..")
        print_int(span.end)
    }
    print(": cannot print Unobserved<T>\n")
    print("   |\n   = help: Unobserved<T> requires `with Observe` before IO can inspect it\n")
}

fn checker_type_is_unobserved_like(ty: TypeEntry) -> bool with Panic, Div {
    if ty.kind == TypeKind::TyUnobserved {
        return true
    }
    ty.kind == TypeKind::TyNamed && name_matches_str10(ty.name, 85, 110, 111, 98, 115, 101, 114, 118, 101, 100)
}

fn checker_push_const_scope_inplace(c: *mut Checker) with Mut, Div, Panic {
    if (*c).const_int_scope_depth < MAX_SCOPE_DEPTH {
        (*c).const_int_scope_marks[(*c).const_int_scope_depth as usize] = (*c).const_int_count
        (*c).const_int_scope_depth = (*c).const_int_scope_depth + 1
    }
}

fn checker_pop_const_scope_inplace(c: *mut Checker) with Mut, Div, Panic {
    if (*c).const_int_scope_depth > 0 {
        (*c).const_int_scope_depth = (*c).const_int_scope_depth - 1
        let mark = (*c).const_int_scope_marks[(*c).const_int_scope_depth as usize]
        if mark >= 0 && mark <= (*c).const_int_count {
            (*c).const_int_count = mark
        }
    }
}

fn checker_const_int_bind_raw_inplace(c: *mut Checker, name: Name, known: i64, value: i64) with Mut, Div, Panic {
    var idx = (*c).const_int_count
    if idx >= MAX_CONST_INT_BINDINGS {
        idx = MAX_CONST_INT_BINDINGS - 1
    } else {
        (*c).const_int_count = (*c).const_int_count + 1
    }
    var bufs = (*c).const_int_name_bufs
    var lens = (*c).const_int_name_lens
    checker_const_name_write(&! bufs, &! lens, idx, name)
    (*c).const_int_name_bufs = bufs
    (*c).const_int_name_lens = lens
    (*c).const_int_known[idx as usize] = known
    (*c).const_int_values[idx as usize] = value
}

fn checker_const_int_bind_unknown_inplace(c: *mut Checker, name: Name) with Mut, Div, Panic {
    checker_const_int_bind_raw_inplace(c, name, 0, 0)
}

fn checker_is_linear_type_inplace(c: *mut Checker, ty: TypeEntry) -> bool with Mut, Panic, Div {
    if ty.kind == TypeKind::TyNamed {
        let idx = struct_table_find((*c).structs, ty.name)
        if idx >= 0 {
            return (*(*c).structs).entries[idx].is_linear
        }
    }
    if ty.kind == TypeKind::TyFn && ty.fn_sig_id >= 0 {
        return fn_sig_table_get((*c).fn_sigs, ty.fn_sig_id).is_linear_closure
    }
    false
}

// ---- collect phase, true *mut (the crash is HERE, in collect, not check) ----

fn checker_lookup_user_effect_id_mut(c: *mut Checker, name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*c).effects.count {
        let entry = (*c).effects.entries[i as usize]
        if entry.name.len == name_len {
            var j: i64 = 0
            var matched = true
            while j < name_len && j < 64 {
                if entry.name.buf[j as usize] != name_buf[j as usize] {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return 100 + i
            }
        }
        i = i + 1
    }
    0 - 1
}

// E246: an effect name the programmer wrote is being discarded. One code for
// both faces because they are one mechanism (S06_EFFECTS_ROWS.md 6.1.0: the
// unknown-name hole and the ninth-effect hole are the same `eff_id >= 0 &&
// n < 8` guard; re-separating them was ruled a regression against 6.1.1).
// face 0: the name is in no list - not the closed 30, not the user-effect
//         registry, not the held transition list (effects.sio).
// face 1: the name resolves, but the 8-slot signature table is full and this
//         would be a 9th distinct effect.
fn checker_emit_e246(c: *mut Checker, face: i64, name_buf: [i8; 64], name_len: i64) with Mut, IO, Panic, Div, Alloc {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
    print("error[E246]")
    print(" in ")
    e035_print_module_path((*c).current_module)
    print("::")
    e035_print_ident((*c).current_fn_name)
    print(": ")
    if face == 0 {
        print("unknown effect '")
    } else {
        print("effect '")
    }
    var i: i64 = 0
    while i < name_len && i < 64 {
        print_ascii_i8(name_buf[i as usize])
        i = i + 1
    }
    print("'")
    if face == 0 {
        println(": not in the closed effect list (S06 6.1.0), not a declared user effect, not held")
    } else {
        println(": dropped, a signature holds 8 distinct effects and this is a 9th")
    }
}

fn checker_collect_effects_mut(c: *mut Checker, list: EffectList, effects: [i64; 8], count: i64) -> MutEffectsResult with Mut, Panic, Div, IO, Alloc {
    var effs = effects
    var n = count
    var eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)
    if eff_id < 0 {
        eff_id = checker_lookup_user_effect_id_mut(c, list.head.name_buf, list.head.name_len)
    }
    if eff_id < 0 {
        // Held names keep today's silent behaviour by the founder's hold
        // ruling (effects.sio header, hold_mod_claude1): the corpus
        // load-bearingly depends on them pending the misspelling audit.
        // Anything else is refused instead of silently dropped.
        if !effect_name_is_held(list.head.name_buf, list.head.name_len) {
            checker_emit_e246(c, 0, list.head.name_buf, list.head.name_len)
        }
    } else {
        var already_present = false
        var i: i64 = 0
        while i < n {
            if effs[i as usize] == eff_id {
                already_present = true
            }
            i = i + 1
        }
        if !already_present {
            if n >= 8 {
                // The ninth distinct effect: dropped silently before E246.
                // Widening the slot table is a separate conversation; this
                // refusal only stops the discard from being invisible.
                checker_emit_e246(c, 1, list.head.name_buf, list.head.name_len)
            } else {
                effs[n as usize] = eff_id
                n = n + 1
            }
        }
    }
    match list.tail {
        None => MutEffectsResult { effects: effs, count: n }
        Some(next) => checker_collect_effects_mut(c, *next, effs, n)
    }
}

fn checker_extract_effects_mut(c: *mut Checker, opt: Option<Box<EffectList> >) -> MutEffectsResult with Mut, Panic, Div, IO, Alloc {
    match opt {
        None => MutEffectsResult { effects: [0; 8], count: 0 }
        Some(list) => checker_collect_effects_mut(c, *list, [0; 8], 0)
    }
}

fn epistemic_min_confidence_from_effects(opt: Option<Box<EffectList> >) -> i64 with Mut, Panic, Div {
    var cursor = opt
    while true {
        match cursor {
            Some(list) => {
                if effect_name_to_id((*list).head.name_buf, (*list).head.name_len) == 8 && (*list).head.payload >= 0 {
                    return (*list).head.payload
                }
                cursor = (*list).tail
            }
            None => return 0 - 1
        }
    }
    0 - 1
}

// ============================================================
// N2 call-projection table (codex ruling 2026-08-23, fail-closed fix)
// ============================================================
//
// grok-4.6 found the original REQ-5 substitution ("last Knowledge arg
// wins") FAIL-OPEN: add_noise(x){x+measure(0)}, first(a,b){a}, and
// add_cap(x){x+cap} all narrowed to a real handle instead of top, which is
// the DANGEROUS direction for a domain meant to certify independence. The
// fix: substitution is preserved ONLY when the callee is a syntactically-
// proven, effect-free EXACT parameter projection -- body is exactly one
// statement, a bare tail identifier or `return <ident>`, naming one of the
// function's own parameters. A single-statement bare-identifier body cannot
// contain a capture, a measure()/Knowledge ctor, or control flow -- ruling
// those out is structural, not a separate check. Everything else defaults
// to top (unknown, -1) at the call site (see
// checker_propagate_call_result_ns_inplace below).
//
// Storage: a flat table parallel to FnSigTable, indexed by the SAME sig_id
// (fn_sig_table_add's return value) so lookup is O(1) at the call site.
// heap_alloc zeroes it, so any sig_id this module never explicitly writes
// (closures, methods, monomorphized/type-expr signatures, intrinsics) reads
// back as is_proj=false/param_idx=-1 -- i.e. top -- for free: only the ONE
// real user-fn collection site needs to call ns_proj_table_set, not every
// fn_sig_table_add call site in this file. Sized to FnSigTable's own
// documented cap (fn_sig_table_add refuses idx >= 1048576) so every valid
// sig_id is addressable; the byte budget is rounded up generously (matches
// fn_sig_chunk_alloc's "not checked against sizeof, headroom is deliberate"
// precedent below) since bool/i64 array layout is not sizeof-verified here.
pub struct NsProjTable {
    is_proj: [bool; 1048576],
    param_idx: [i64; 1048576],
}

pub fn ns_proj_table_alloc() -> *mut NsProjTable with Alloc {
    heap_alloc(16777216) as *mut NsProjTable
}

pub fn ns_proj_table_set(t: *mut NsProjTable, sig_id: i64, is_proj: bool, param_idx: i64) with Mut, Panic, Div {
    if sig_id < 0 || sig_id >= 1048576 { return }
    (*t).is_proj[sig_id as usize] = is_proj
    (*t).param_idx[sig_id as usize] = param_idx
}

pub fn ns_proj_table_get(t: *mut NsProjTable, sig_id: i64) -> (bool, i64) with Mut, Panic, Div {
    if sig_id < 0 || sig_id >= 1048576 { return (false, 0 - 1) }
    ((*t).is_proj[sig_id as usize], (*t).param_idx[sig_id as usize])
}

// Walk a fn's ORIGINAL (unlowered) parameter list looking for `name`,
// returning (found, index). Index order matches checker_collect_fn_param_list_mut's
// walk of the same ParamList, so it lines up with FnSig.params/param_count.
fn ns_param_index_of(params: Option<Box<ParamList> >, name: Name, idx: i64) -> (bool, i64) with Mut, Panic, Div {
    match params {
        None => (false, 0 - 1)
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (true, idx)
            } else {
                ns_param_index_of((*list).tail, name, idx + 1)
            }
        }
    }
}

// The projection predicate itself. body.stmts must hold EXACTLY one
// statement: either a bare tail-expression identifier (`{ x }`, the
// implicit-return shape) or `{ return x }` (ExprReturn's payload lives in
// Expr.left per parser/ast.sio). Anything else -- more statements, a
// non-identifier tail, an identifier that is not one of this fn's own
// parameters -- is NOT a projection.
fn ns_body_projected_param_index(body: Block, params: Option<Box<ParamList> >) -> (bool, i64) with Mut, Panic, Div {
    match body.stmts {
        None => (false, 0 - 1)
        Some(list) => {
            match (*list).tail {
                Some(_) => (false, 0 - 1)
                None => {
                    let s = (*list).head
                    if s.kind != StmtKind::StmtExpr {
                        (false, 0 - 1)
                    } else {
                        match s.expr {
                            None => (false, 0 - 1)
                            Some(eb) => {
                                let e = *eb
                                if e.kind == ExprKind::ExprIdent {
                                    ns_param_index_of(params, e.name, 0)
                                } else if e.kind == ExprKind::ExprReturn {
                                    match e.left {
                                        Some(rv) => {
                                            let rve = *rv
                                            if rve.kind == ExprKind::ExprIdent {
                                                ns_param_index_of(params, rve.name, 0)
                                            } else {
                                                (false, 0 - 1)
                                            }
                                        }
                                        None => (false, 0 - 1)
                                    }
                                } else {
                                    (false, 0 - 1)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn checker_collect_fn_param_list_mut(c: *mut Checker, pl: ParamList) -> MutParamListResult with Mut, Panic, Div, Alloc, IO {
    let head_ty = checker_lower_type_expr_mut(c, pl.head.ty)
    let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
    match pl.tail {
        None => MutParamListResult { list: FnParamList { head: head_param, tail: None }, count: 1 }
        Some(rest) => {
            let r = checker_collect_fn_param_list_mut(c, *rest)
            MutParamListResult { list: FnParamList { head: head_param, tail: Some(Box::new(r.list)) }, count: 1 + r.count }
        }
    }
}

fn checker_collect_fn_params_mut(c: *mut Checker, opt: Option<Box<ParamList> >) -> MutParamsResult with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(pl) => {
            let r = checker_collect_fn_param_list_mut(c, *pl)
            MutParamsResult { params: Some(Box::new(r.list)), count: r.count }
        }
        None => MutParamsResult { params: None, count: 0 }
    }
}

fn checker_collect_fn_def_inplace(c: *mut Checker, opt: Option<Box<FnDef> >, visibility: Visibility, defining_module: AstPath) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(fd) => {
            let name = (*fd).name
            // E246 identity: the effect collector reports module::fn, but
            // current_fn_name was only recorded on impl-body paths. Record the
            // fn being collected for the extraction window and restore it
            // after, mirroring the saved_effects pair below.
            let saved_fn_name = (*c).current_fn_name
            (*c).current_fn_name = name
            // Effects must be current BEFORE parameter types lower. The ZD
            // family interrogates `with ZD` at the parameter; collecting the
            // signature with an empty effect set would refuse every `with ZD`
            // function and the positive control would be indistinguishable
            // from a dead arm.
            let saved_effects = (*c).current_effects
            let saved_effect_count = (*c).current_effect_count
            let eff_pair = checker_extract_effects_mut(c, (*fd).effects)
            (*c).current_effects = eff_pair.effects
            (*c).current_effect_count = eff_pair.count
            let params_pair = checker_collect_fn_params_mut(c, (*fd).params)
            let params = params_pair.params
            let param_count = params_pair.count
            let ret_ty = match (*fd).return_type {
                Some(te) => checker_lower_type_expr_mut(c, *te)
                None => ty_unknown()
            }
            (*c).current_effects = saved_effects
            (*c).current_effect_count = saved_effect_count
            (*c).current_fn_name = saved_fn_name
            let fn_effects = eff_pair.effects
            let fn_effect_count = eff_pair.count
            let epistemic_min_confidence = epistemic_min_confidence_from_effects((*fd).effects)

            let is_kernel_fn = (*fd).is_kernel
            var kernel_effects = fn_effects
            var kernel_effect_count = fn_effect_count

            if is_kernel_fn {
                var has_gpu = false
                var ei = 0
                while ei < kernel_effect_count {
                    if kernel_effects[ei as usize] == 5 { has_gpu = true }
                    ei = ei + 1
                }
                if has_gpu == false {
                    if kernel_effect_count < 8 {
                        kernel_effects[kernel_effect_count as usize] = 5
                        kernel_effect_count = kernel_effect_count + 1
                    }
                }
                var ri = 0
                while ri < kernel_effect_count {
                    if kernel_effects[ri as usize] == 0 {
                        checker_report_error_at_inplace(c, (*fd).span, 70, 0, 0, 0)
                    }
                    if kernel_effects[ri as usize] == 1 {
                        checker_report_error_at_inplace(c, (*fd).span, 70, 0, 0, 0)
                    }
                    if kernel_effects[ri as usize] == 2 {
                        checker_report_error_at_inplace(c, (*fd).span, 70, 0, 0, 0)
                    }
                    ri = ri + 1
                }
                // E253: a missing return annotation lowers to TyUnknown and is
                // implicitly unit for a void kernel — accept it; only an EXPLICIT
                // non-unit return type is an error. (Mirrors the collect_fn_def site.)
                if ret_ty.kind != TypeKind::TyUnit && ret_ty.kind != TypeKind::TyUnknown {
                    checker_report_error_at_inplace(c, (*fd).span, 253, 0, 0, 0)
                }
            }

            var has_epistemic_param = false
            if is_kernel_fn {
                var walk_params = params
                var walk_i: i64 = 0
                while walk_i < param_count {
                    match walk_params {
                        Some(plist) => {
                            let pty = (*plist).head.ty
                            if is_epistemic_type(pty) || pty.kind == TypeKind::TyEpistemic || pty.kind == TypeKind::TyAleatoric {
                                has_epistemic_param = true
                            }
                            walk_params = (*plist).tail
                        }
                        None => { walk_i = param_count }
                    }
                    walk_i = walk_i + 1
                }
            }

            let sig = FnSig {
                name: name,
                params: params,
                param_count: param_count,
                return_type: ret_ty,
                is_method: false,
                self_type_name: Name { buf: [0; 128], len: 0 },
                self_type_entry: ty_unit(),
                effects: kernel_effects,
                effect_count: kernel_effect_count,
                is_kernel: is_kernel_fn,
                is_epistemic_kernel: has_epistemic_param,
                is_extern: (*fd).is_extern,
                is_linear_closure: false,
                linear_capture_count: 0,
                epistemic_epsilon: 0.0 - 1.0,
                epistemic_min_confidence: epistemic_min_confidence,
                visibility_kind: visibility.kind,
                defining_module_seg_count: defining_module.seg_count,
                defining_module_id: (*c).current_module_id,
                visibility: visibility,
                defining_module: defining_module,
            }
            // In-place insert mirrors FnSigTable::add — avoids copying the 45KB
            // FnSigTable by value (one of the large-aggregate copies the *mut
            // conversion eliminates).
            let sig_id = fn_sig_table_add((*c).fn_sigs, sig)
            // N2 (codex ruling 2026-08-23): register this fn's call-projection
            // verdict at the SAME index fn_sig_table_add just returned, so
            // checker_propagate_call_result_ns_inplace can look it up in O(1)
            // at every call site. See ns_body_projected_param_index's comment.
            var proj = ns_body_projected_param_index((*fd).body, (*fd).params)
            // Codex ruling: arity-1 ONLY. first(a, b) { a } does NOT qualify
            // even though its body is a bare reference to one of its own
            // parameters -- restricting to single-parameter signatures keeps
            // "exact parameter projection" to the one archetype (ident(x){x})
            // it is meant to cover and removes an entire class of positional-
            // argument-mismatch risk from ever being a concern.
            if param_count != 1 {
                proj = (false, 0 - 1)
            }
            ns_proj_table_set((*c).ns_proj, sig_id, proj.0, proj.1)
            // Functions are NOT bound in env — they live in the chunked fn_sigs and resolve via
            // the fn_sigs fallback in checker_check_ident_expr_inplace. Binding ~15K module-level
            // fns into the ONE shared env (check_modules_verdict_boot4) overflowed bindings[4096],
            // so function-body LOCALS could not bind -> E137. Keeping env for locals only avoids it.
            checker_const_int_bind_unknown_inplace(c, name)
        }
        None => {}
    }
}

fn checker_collect_global_item_inplace(
    c: *mut Checker,
    name: Name,
    declared_ty: Option<Box<TypeExpr>>
) with Mut, Panic, Div, Alloc, IO {
    match declared_ty {
        Some(te) => {
            // Validate the annotation at the checker boundary, but preserve the
            // legacy TyUnknown binding until global typing has its own milestone.
            let _validated_global_ty = checker_lower_type_expr_mut(c, *te)
        }
        None => {}
    }
    let benv_idx = (*c).env.count
    if benv_idx < 4096 {
        (*c).env.bindings[benv_idx as usize] = TypeBinding {
            name: name,
            ty: ty_unknown(),
            is_mutable: true,
            scope_depth: (*c).env.scope_depth,
        }
        (*c).env.count = benv_idx + 1
    }
    checker_const_int_bind_unknown_inplace(c, name)
}

fn checker_env_has_binding_inplace(c: *mut Checker, name: Name) -> bool with Mut, Panic, Div {
    var i = (*c).env.count - 1
    while i >= 0 {
        if name_eq((*c).env.bindings[i as usize].name, name) {
            return true
        }
        i = i - 1
    }
    false
}

fn checker_bind_import_unknown_with_mutability_inplace(c: *mut Checker, name: Name, is_mutable: bool) with Mut, Panic, Div {
    if name.len <= 0 {
        return
    }
    var i = (*c).env.count - 1
    while i >= 0 {
        if name_eq((*c).env.bindings[i as usize].name, name) {
            if is_mutable {
                var _b = (*c).env.bindings[i as usize]
                _b.is_mutable = true
                (*c).env.bindings[i as usize] = _b
            }
            return
        }
        i = i - 1
    }
    let benv_idx = (*c).env.count
    if benv_idx < 4096 {
        (*c).env.bindings[benv_idx as usize] = TypeBinding {
            name: name,
            ty: ty_unknown(),
            is_mutable: is_mutable,
            scope_depth: (*c).env.scope_depth,
        }
        (*c).env.count = benv_idx + 1
    }
    checker_const_int_bind_unknown_inplace(c, name)
}

fn checker_bind_import_unknown_inplace(c: *mut Checker, name: Name) with Mut, Panic, Div {
    checker_bind_import_unknown_with_mutability_inplace(c, name, false)
}

fn checker_bind_import_mutable_unknown_inplace(c: *mut Checker, name: Name) with Mut, Panic, Div {
    checker_bind_import_unknown_with_mutability_inplace(c, name, true)
}

fn checker_collect_import_item_list_inplace(c: *mut Checker, opt: Option<Box<ImportItemList> >) with Mut, Panic, Div {
    var cursor = opt
    while true {
        match cursor {
            Some(node) => {
                checker_bind_import_unknown_inplace(c, (*node).head)
                cursor = (*node).tail
            }
            None => break
        }
    }
}

fn checker_string_list_head_eq(sl: StringList, text: string) -> bool with Mut, Panic, Div {
    let len = str_len(text)
    if sl.head_len != len {
        return false
    }
    var i: i64 = 0
    while i < len && i < 128 {
        if sl.head_buf[i as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn checker_path_first_two_eq(path: AstPath, first: string, second: string) -> bool with Mut, Panic, Div {
    if path.seg_count < 2 {
        return false
    }
    if !checker_string_list_head_eq(path.segments, first) {
        return false
    }
    match path.segments.tail {
        Some(rest) => checker_string_list_head_eq(*rest, second)
        None => false
    }
}

fn checker_collect_known_module_backing_imports_inplace(c: *mut Checker, path: AstPath) with Mut, Panic, Div {
    // The boot4/raw checker currently type-checks modules with a shared symbol
    // table but without a full import namespace. Keep the stopgap narrow:
    // native-v2 imports scalar bootstrap stores directly from a few modules.
    if checker_path_first_two_eq(path, "lexer", "cursor") {
        checker_bind_import_mutable_unknown_inplace(c, make_name("CURSOR_SOURCE"))
        checker_bind_import_mutable_unknown_inplace(c, make_name("CURSOR_SOURCE_LEN"))
    }
    if checker_path_first_two_eq(path, "parser", "parser") {
        checker_bind_import_mutable_unknown_inplace(c, make_name("PT_KIND_CODE"))
        checker_bind_import_mutable_unknown_inplace(c, make_name("PT_START"))
        checker_bind_import_mutable_unknown_inplace(c, make_name("PT_END"))
        checker_bind_import_mutable_unknown_inplace(c, make_name("PT_INT_VALUE"))
    }
    if checker_path_first_two_eq(path, "io", "file_write") {
        checker_bind_import_unknown_inplace(c, make_name("io_write_meg_binary"))
        checker_bind_import_unknown_inplace(c, make_name("io_make_executable"))
    }
}

fn checker_collect_use_item_inplace(c: *mut Checker, item: Item) with Mut, Panic, Div, Alloc {
    checker_collect_import_item_list_inplace(c, item.use_items)
    // Path-form named import `use module::symbol` (no braces, no glob): the
    // parser leaves the symbol as the last path segment with use_items=None.
    // Bind that last segment so visibility preflight does not E137 it when the
    // multi-module collector has not yet (or will not) surface the export as a
    // free fn. Whole-module multi-segment imports that resolve as real files
    // still work: binding an extra name is harmless if unused.
    if !item.use_glob && item.use_items == None && item.use_path.seg_count >= 2 {
        let last = checker_copy_string_list_tail_to_name(item.use_path.segments)
        if !name_is_empty(last) {
            checker_bind_import_unknown_inplace(c, last)
        }
    }
    checker_collect_known_module_backing_imports_inplace(c, item.use_path)
}

fn checker_collect_runtime_builtins_inplace(c: *mut Checker) with Mut, Panic, Div {
    checker_bind_import_unknown_inplace(c, make_name("arg_count"))
    checker_bind_import_unknown_inplace(c, make_name("get_arg"))
    checker_bind_import_unknown_inplace(c, make_name("str_len"))
    checker_bind_import_unknown_inplace(c, make_name("str_char_at"))
    checker_bind_import_unknown_inplace(c, make_name("str_eq"))
    checker_bind_import_unknown_inplace(c, make_name("file_size"))
    checker_bind_import_unknown_inplace(c, make_name("read_file"))
    checker_bind_import_unknown_inplace(c, make_name("read_i64"))
    // Defect A (docs/audit/MADAROS_PBPK28_NN_TENSOR_COMPILE_RUNTIME_DIVERGENCE_2026-08-17.md):
    // read_i64 was bound here already; write_i64/read_f64/write_f64 were not,
    // which is the exact E137 this dispatch reproduced (stdlib/nn/optimizer.sio,
    // stdlib/tensor/tape.sio, stdlib/data/bigframe*.sio, stdlib/collections/heap_vec.sio).
    checker_bind_import_unknown_inplace(c, make_name("write_i64"))
    checker_bind_import_unknown_inplace(c, make_name("read_f64"))
    checker_bind_import_unknown_inplace(c, make_name("write_f64"))
    checker_bind_import_unknown_inplace(c, make_name("write_file"))
    checker_bind_import_unknown_inplace(c, make_name("print"))
    checker_bind_import_unknown_inplace(c, make_name("print_int"))
    checker_bind_import_unknown_inplace(c, make_name("print_char"))
    checker_bind_import_unknown_inplace(c, make_name("println"))
    // print_f64 + math intrinsics emitted by native codegen
    // (native_v2_builtin_id_for_func_ref ids 14-19). Without these entries,
    // any 2+-module program that calls one of them trips E137 in the
    // visibility-preflight pass even though the codegen lane would resolve
    // the call correctly. See docs/audit/MADAROS_MULTIMODULE_PRINT_IMPORT_BUGS_2026-07-13.md
    // defect 2 for the original report on print_f64.
    // Raw syscall + arena/pool/mmap runtime intrinsics. Same defect the print_f64
    // block above records, one layer down: native codegen resolves these (they
    // are emitted by codegen_x86_linux.sio, and io/file_write.sio + lsp/server.sio
    // call syscall6 directly), but the checker never had them bound, so every
    // multi-module program that reaches them tripped E137 "use of undeclared
    // variable" on a name that is not a variable at all. Nine of the twenty-nine
    // errors on native_compile_driver.sio were exactly this, which is what made
    // the whole driver-self-compile chain — five umbrella gates — unbuildable.
    checker_bind_import_unknown_inplace(c, make_name("syscall6"))
    checker_bind_import_unknown_inplace(c, make_name("__arena_mark"))
    checker_bind_import_unknown_inplace(c, make_name("__arena_reset"))
    checker_bind_import_unknown_inplace(c, make_name("__arena_refill_bytes"))
    checker_bind_import_unknown_inplace(c, make_name("__arena_unmap_bytes"))
    checker_bind_import_unknown_inplace(c, make_name("__pool_mark"))
    checker_bind_import_unknown_inplace(c, make_name("__pool_refill_bytes"))
    checker_bind_import_unknown_inplace(c, make_name("__rtmmap_count"))
    checker_bind_import_unknown_inplace(c, make_name("__rtmmap_bytes"))
    checker_bind_import_unknown_inplace(c, make_name("print_f64"))
    checker_bind_import_unknown_inplace(c, make_name("sqrt"))
    checker_bind_import_unknown_inplace(c, make_name("exp"))
    checker_bind_import_unknown_inplace(c, make_name("log"))
    checker_bind_import_unknown_inplace(c, make_name("sin"))
    checker_bind_import_unknown_inplace(c, make_name("cos"))
    checker_bind_import_unknown_inplace(c, make_name("tan"))
    checker_bind_import_unknown_inplace(c, make_name("atan"))
    checker_bind_import_unknown_inplace(c, make_name("tanh"))
    checker_bind_import_unknown_inplace(c, make_name("asin"))
    checker_bind_import_unknown_inplace(c, make_name("acos"))
    checker_bind_import_unknown_inplace(c, make_name("pow"))
    // Track A extern "C" wrapper intrinsics (docs/audit/MADAROS_EXTERN_C_
    // BUILTIN_PORT_DISPATCH_2026-08-16): the parser rewrites an extern
    // declaration into a fn forwarding to ffi_<name>; these entries let the
    // inner call resolve.
    //
    // The list is closed and the parser knows it. parser/items.sio's
    // extern_name_has_ffi_intrinsic carries the same twelve names and rewrites
    // ONLY them, so an extern that is absent here never grows a wrapper body
    // and never trips E137 on an unbound ffi_<name>. It keeps the bodyless
    // declaration instead: legal to declare, refused at the CALL by E250.
    // An earlier draft rewrote every declaration and, with is_extern false on
    // the wrapper, E250 could no longer fire at all -- the refusal moved to
    // the declaration site and a bindings module stopped compiling.
    // scripts/ci/extern_builtin_mirror_gate.sh diffs the two lists against the
    // backend registry arms that actually emit these intrinsics.
    checker_bind_import_unknown_inplace(c, make_name("ffi_getpid"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_getppid"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_exit"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_abort"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_malloc"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_free"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_system"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_sqrt"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_floor"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_ceil"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_pow"))
    checker_bind_import_unknown_inplace(c, make_name("ffi_tgamma"))
    checker_bind_import_unknown_inplace(c, make_name("hessian_diag_of"))
    checker_bind_import_unknown_inplace(c, make_name("second_order_mean"))
    checker_bind_import_unknown_inplace(c, make_name("correlate"))
    checker_bind_import_unknown_inplace(c, make_name("assert"))
    // Standard enum constructors used like values/functions by user code.
    checker_bind_import_unknown_inplace(c, make_name("Some"))
    checker_bind_import_unknown_inplace(c, make_name("None"))
    checker_bind_import_unknown_inplace(c, make_name("Ok"))
    checker_bind_import_unknown_inplace(c, make_name("Err"))
    checker_bind_import_unknown_inplace(c, make_name("str_from_bytes"))
    checker_bind_import_unknown_inplace(c, make_name("str_slice"))
    checker_bind_import_unknown_inplace(c, make_name("str_to_int"))
    checker_bind_import_unknown_inplace(c, make_name("str_concat"))
    checker_bind_import_unknown_inplace(c, make_name("panic"))
    checker_bind_import_unknown_inplace(c, make_name("exit"))
    checker_bind_import_unknown_inplace(c, make_name("variance_of"))
    checker_bind_import_unknown_inplace(c, make_name("sensitivity_of"))
    checker_bind_import_unknown_inplace(c, make_name("uncertainty_of"))
    checker_bind_import_unknown_inplace(c, make_name("hessian_of"))
    checker_bind_import_unknown_inplace(c, make_name("chain_to_knowledge_into"))
    // syscall6: raw syscall builtin emitted by native codegen (no .sio
    // definition). Same E137 preflight hazard as print_f64 above for any
    // 2+-module program that calls it (self-hosted/io/file_write.sio,
    // self-hosted/lsp/server.sio).
    checker_bind_import_unknown_inplace(c, make_name("syscall6"))
    // Runtime memory / float / string intrinsics emitted directly by codegen (no .sio
    // definition), referenced across the self-hosted compiler. The per-module frontend
    // resolves these; the imported all-modules typecheck must register them too or they
    // surface as E137 undeclared (heap_free, f64_to_bits, ...).
    checker_bind_import_unknown_inplace(c, make_name("heap_alloc"))
    checker_bind_import_unknown_inplace(c, make_name("heap_free"))
    // heap_realloc has a real definition (stdlib/mem/box.sio, extern "C" realloc)
    // -- unlike read_f64 etc it is NOT a compiler-codegen builtin, it just needs
    // the same implicit-global registration heap_alloc/heap_free already have,
    // or callers that don't `use` it explicitly (stdlib/data/bigframe.sio,
    // stdlib/collections/heap_vec.sio) trip E137. Found alongside Defect A
    // while validating its fix against a real bigframe consumer test, not part
    // of the read_i64/write_i64/read_f64/write_f64 family itself.
    checker_bind_import_unknown_inplace(c, make_name("heap_realloc"))
    checker_bind_import_unknown_inplace(c, make_name("f64_to_bits"))
    checker_bind_import_unknown_inplace(c, make_name("bits_to_f64"))
    checker_bind_import_unknown_inplace(c, make_name("starts_with"))
    checker_bind_import_unknown_inplace(c, make_name("read_byte"))
    // Seq / acknowledge language surface (lean_single builtins). Without these,
    // multi-module and single-module check both E137 on seq_new / acknowledge —
    // the residual that blocks rapamycin_kaxi_fuse_prior and ontology/model.sio.
    checker_bind_import_unknown_inplace(c, make_name("seq_new"))
    checker_bind_import_unknown_inplace(c, make_name("seq_push"))
    checker_bind_import_unknown_inplace(c, make_name("seq_get"))
    checker_bind_import_unknown_inplace(c, make_name("seq_set"))
    checker_bind_import_unknown_inplace(c, make_name("seq_len"))
    checker_bind_import_unknown_inplace(c, make_name("seq_count"))
    checker_bind_import_unknown_inplace(c, make_name("acknowledge"))
}

// *mut declaration collectors — port of the by-value collect_struct_def /
// collect_enum_def (check.sio ~11225) to mutate (*c) IN PLACE, avoiding the 8MB
// Checker SRET copy that forced the `_ => {}` skip below. Fills (*c).structs /
// (*c).enums so programs that USE structs/enums type-check. Modeled on the proven
// checker_collect_fn_param_list_mut idiom (lowers types via checker_lower_type_expr_mut).
// Returns MutFieldsResult (boxed head + count) — NOT MutFieldListResult (FieldInfoList
// by value ~368B). lean_single miscompiles SRET of large aggregates out of *mut fns
// (value-move/SRET-return family, same root as the enum path fix at line 2735).
// Mirror the enum path: box the node into a local, return a small {Option<Box>, i64}.
fn checker_collect_field_def_list_mut(c: *mut Checker, fdl: FieldDefList) -> MutFieldsResult with Mut, Panic, Div, Alloc, IO {
    let head_ty = checker_lower_type_expr_mut(c, fdl.head.ty)
    let head_info = FieldInfo { name: fdl.head.name, ty: head_ty }
    match fdl.tail {
        None => {
            var flist = FieldInfoList { head: head_info, tail: None }
            MutFieldsResult { fields: Some(Box::new(flist)), count: 1 }
        }
        Some(rest) => {
            let r = checker_collect_field_def_list_mut(c, *rest)
            var flist = FieldInfoList { head: head_info, tail: r.fields }
            MutFieldsResult { fields: Some(Box::new(flist)), count: 1 + r.count }
        }
    }
}

fn checker_collect_field_defs_mut(c: *mut Checker, opt: Option<Box<FieldDefList> >) -> MutFieldsResult with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(fdl) => checker_collect_field_def_list_mut(c, *fdl)
        None => MutFieldsResult { fields: None, count: 0 }
    }
}

// E216: a struct whose field is the struct itself, by value (TyNamed == own
// name), has infinite size. `Box<Node>` lowers to ty_named("Box") and `&Node`
// to TyRef, so neither matches — pointer-wrapped recursion stays valid. Scope:
// DIRECT self-reference only; mutual/transitive recursion is a documented
// follow-on (needs a post-collection occurs-check over the struct graph).
fn struct_field_list_has_direct_self_ref(opt: Option<Box<FieldInfoList> >, self_name: Name) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        None => false
        Some(list) => {
            let f = (*list).head
            if f.ty.kind == TypeKind::TyNamed && name_eq(f.ty.name, self_name) {
                true
            } else {
                struct_field_list_has_direct_self_ref((*list).tail, self_name)
            }
        }
    }
}

fn checker_collect_struct_def_inplace(c: *mut Checker, name: Name, opt: Option<Box<StructDef> >, visibility: Visibility, defining_module: AstPath) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(sd) => {
            let tp_result = collect_type_params((*sd).type_params)
            let fc = checker_collect_field_defs_mut(c, (*sd).fields)
            if struct_field_list_has_direct_self_ref(fc.fields, name) {
                checker_report_error_at_inplace(c, (*sd).span, 216, 0, 0, 0)
            }
            let info = StructInfo {
                name: name,
                fields: fc.fields,
                field_count: fc.count,
                is_linear: (*sd).is_linear,
                type_param_count: tp_result.count,
                type_param_names: tp_result.names,
                is_generic_template: tp_result.count > 0,
                visibility_kind: visibility.kind,
                defining_module_id: (*c).current_module_id,
                visibility: visibility,
                defining_module: defining_module,
            }
            struct_table_add((*c).structs, info)
        }
        None => {}
    }
}

// Returns the boxed list HEAD (small MutVariantsResult = {Option<Box>, count}), NOT a
// MutVariantListResult that carries a VariantInfoList by value. bin/souc miscompiles the
// SRET return of that large aggregate out of a *mut fn (the value-move/SRET-return family
// — same root as the largestruct miscompile), SIGSEGVing right after the deepest variant
// builds its result. Boxing the node into a local then returning a pointer keeps every
// return small (pointer + int) and mirrors the struct path's known-good `Box::new(local)`.
fn checker_collect_variant_list_mut(c: *mut Checker, vdl: VariantDefList) -> MutVariantsResult with Mut, Panic, Div, Alloc, IO {
    let vf = checker_collect_field_defs_mut(c, vdl.head.fields)
    let head_info = VariantInfo { name: vdl.head.name, fields: vf.fields }
    match vdl.tail {
        None => {
            let node = VariantInfoList { head: head_info, tail: None }
            MutVariantsResult { variants: Some(Box::new(node)), count: 1 }
        }
        Some(rest) => {
            let r = checker_collect_variant_list_mut(c, *rest)
            let node = VariantInfoList { head: head_info, tail: r.variants }
            MutVariantsResult { variants: Some(Box::new(node)), count: 1 + r.count }
        }
    }
}

fn checker_collect_variants_mut(c: *mut Checker, opt: Option<Box<VariantDefList> >) -> MutVariantsResult with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(vdl) => checker_collect_variant_list_mut(c, *vdl)
        None => MutVariantsResult { variants: None, count: 0 }
    }
}

fn checker_bind_enum_variant_constructors_inplace(c: *mut Checker, variants: Option<Box<VariantInfoList>>) with Mut, Panic, Div {
    var cur = variants
    while true {
        match cur {
            Some(list) => {
                checker_bind_import_unknown_inplace(c, (*list).head.name)
                cur = (*list).tail
            }
            None => break
        }
    }
}

fn checker_collect_enum_def_inplace(c: *mut Checker, name: Name, opt: Option<Box<EnumDef> >, visibility: Visibility, defining_module: AstPath) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(ed) => {
            let vr = checker_collect_variants_mut(c, (*ed).variants)
            let info = EnumInfo {
                name: name,
                variants: vr.variants,
                variant_count: vr.count,
                visibility_kind: visibility.kind,
                defining_module_id: (*c).current_module_id,
                visibility: visibility,
                defining_module: defining_module,
            }
            enum_table_add((*c).enums, info)
            checker_bind_enum_variant_constructors_inplace(c, vr.variants)
        }
        None => {}
    }
}

fn checker_collect_models_def_inplace(c: *mut Checker, name: Name, opt: Option<Box<ModelsDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(md) => {
            var info = empty_model_family_info()
            var cursor = (*md).models
            var valid = true
            while true {
                match cursor {
                    Some(list) => {
                        let model_name = checker_copy_string_list_tail_to_name((*list).head.segments)
                        let model_ty = (*c).env.lookup(model_name)
                        if model_ty.kind != TypeKind::TyModel {
                            checker_report_error_at_inplace(c, (*md).span, 63, 0, 0, 0)
                            valid = false
                            break
                        }
                        let input_ty = model_input_ty(model_ty)
                        let output_ty = model_output_ty(model_ty)
                        if info.model_count == 0 {
                            info.input_ty = input_ty
                            info.output_ty = output_ty
                        } else if !types_compatible(info.input_ty, input_ty) || !types_compatible(info.output_ty, output_ty) {
                            checker_report_error_at_inplace(c, (*md).span, 63, 0, 0, 0)
                            valid = false
                            break
                        }
                        if info.model_count >= 16 {
                            checker_report_error_at_inplace(c, (*md).span, 63, 0, 0, 0)
                            valid = false
                            break
                        }
                        info.model_names[info.model_count as usize] = model_name
                        info.model_count = info.model_count + 1
                        cursor = (*list).tail
                    }
                    None => break
                }
            }
            if !valid {
                return
            }
            let family_id = (*c).model_families.count
            if family_id >= 8 {
                checker_report_error_at_inplace(c, (*md).span, 63, 0, 0, 0)
                return
            }
            info.name = name
            (*c).model_families.entries[family_id as usize] = info
            (*c).model_families.count = family_id + 1
            (*c).env = (*c).env.bind(name, ty_model_family(info.input_ty, info.output_ty, family_id), false)
            checker_const_int_bind_unknown_inplace(c, name)
        }
        None => {}
    }
}

fn checker_collect_policy_def_inplace(c: *mut Checker, name: Name, opt: Option<Box<PolicyDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(pd) => {
            match (*pd).requirements {
                Some(_) => {
                    checker_report_error_at_inplace(c, (*pd).span, 63, 0, 0, 0)
                    return
                }
                None => {}
            }
            let target_ty = checker_lower_type_expr_mut(c, (*pd).target_type)
            if target_ty.kind == TypeKind::TyError {
                return
            }
            let policy_id = (*c).policies.count
            if policy_id >= 16 {
                checker_report_error_at_inplace(c, (*pd).span, 63, 0, 0, 0)
                return
            }
            let info = PolicyInfo {
                name: name,
                target_ty: target_ty,
                level_name: (*pd).level_name,
                scope_name: (*pd).scope_name,
                level_id: robustness_level_id_from_name((*pd).level_name),
                scope_id: robustness_scope_id_from_name((*pd).scope_name),
                requirements: None,
                requirement_count: 0,
            }
            (*c).policies.entries[policy_id as usize] = info
            (*c).policies.count = policy_id + 1
            (*c).env = (*c).env.bind(name, ty_policy(target_ty, policy_id), false)
            checker_const_int_bind_unknown_inplace(c, name)
        }
        None => {}
    }
}

fn checker_collect_item_inplace(c: *mut Checker, item: Item) with Mut, Panic, Div, Alloc, IO {
    // Dispatch via explicit `if item.kind == ItemKind::X`, NOT `match item.kind`: bin/souc
    // miscompiles a `match <enum-field>` inside a *mut fn (discriminant-0 → wildcard;
    // root-caused 0afad182c). ItemEnum is WIRED: the collector body returns a small
    // boxed-head MutVariantsResult (no large value-move), the enum-READ path is handled in
    // place (checker_check_path_expr_inplace / checker_check_binary_expr_inplace /
    // checker_check_if_expr_inplace — no 8MB self SRET), and i64==enum compares are accepted
    // (C-style, matching canonical). See docs/audit/g1_wip/ENUM_PATH_TYPING_DESIGN_2026-06-01.md.
    if item.kind == ItemKind::ItemFn {
        match item.fn_def {
            Some(fd) => checker_collect_fn_def_inplace(c, Some(fd), item.visibility, (*c).current_module)
            None => checker_collect_global_item_inplace(c, item.name, item.type_alias_ty)
        }
    } else if item.kind == ItemKind::ItemStruct {
        checker_collect_struct_def_inplace(c, item.name, item.struct_def, item.visibility, (*c).current_module)
    } else if item.kind == ItemKind::ItemEnum {
        checker_collect_enum_def_inplace(c, item.name, item.enum_def, item.visibility, (*c).current_module)
    } else if item.kind == ItemKind::ItemUse {
        checker_collect_use_item_inplace(c, item)
    } else if item.kind == ItemKind::ItemImpl {
        // Collect impl method signatures so `obj.method()` resolves at call sites.
        // Without this the *mut spine no-op'd impl, leaving methods unregistered (E011).
        // Bridged to the by-value collect_impl_def (mirrors checker_check_impl_item_bridge);
        // its ~8MB SRET frame stays isolated in the bridge leaf.
        checker_collect_impl_item_bridge(c, item.impl_def)
    } else if item.kind == ItemKind::ItemTypeAlias {
        checker_collect_type_alias_inplace(c, item.name, item.type_alias_ty)
    } else if item.kind == ItemKind::ItemModels {
        checker_collect_models_def_inplace(c, item.name, item.models_def)
    } else if item.kind == ItemKind::ItemPolicy {
        checker_collect_policy_def_inplace(c, item.name, item.policy_def)
    } else if item.kind == ItemKind::ItemAlgebra {
        // Until 2026-09-01 this arm did not exist: every `algebra ... { }` declaration was
        // INERT in the Madaros checker (registry never populated; check_hyper_binary fell
        // back to the hard-coded predicates; the IR algebra table saw only name-derived
        // defaults). Measured with SOUNIO_E252_TRACE=1 on a source build: the by-value
        // collect_algebra_def never ran. Wired here, with the Axis-1 certificate (E252).
        checker_collect_algebra_def_inplace(c, item.algebra_def)
    } else {
        // ItemSession / typealias / policy / … — not yet collected by the
        // *mut spine (no-op, same as before). *mut collectors pending.
    }
}

// Declared laws of an algebra as a bitmask, first line per op wins:
//   bit0 add_commutative, bit1 add_associative, bit2 mul_commutative,
//   bit3 mul_associative, bit4 mul_alternative. Defaults = `empty_algebra_info` (15).
fn checker_algebra_def_law_mask(ops: Option<Box<AlgebraOpDeclList> >) -> i64 with Mut, Panic, Div {
    match ops {
        None => 15
        Some(list) => {
            var mask = checker_algebra_def_law_mask((*list).tail)
            let op = (*list).head
            if op.op_name.len == 3 && op.op_name.buf[0] == 97 as i8 {
                mask = mask & (0 - 4)  // clear bits 0,1
                if op.is_commutative { mask = mask | 1 }
                if op.is_associative { mask = mask | 2 }
            } else if op.op_name.len == 3 && op.op_name.buf[0] == 109 as i8 {
                mask = mask & (0 - 29)  // clear bits 2,3,4  (~28)
                if op.is_commutative { mask = mask | 4 }
                if op.is_associative { mask = mask | 8 }
                if op.is_alternative { mask = mask | 16 }
            }
            mask
        }
    }
}

// *mut collector for `algebra Name over T { add: ...; mul: ...; reassociate: ... }`.
// Registers the algebra (name-derived Cayley-Dickson tag, declared laws) and checks the
// Axis-1 order certificate at the declaration -- mirrors formal/lean4/EpistemicEffectsNSA.lean
// `assocCert`: `free` needs an associative product, `fano_selective` needs the octonion
// level; an OMITTED clause (parser -1) derives the most permissive certified strategy.
fn checker_collect_algebra_def_inplace(c: *mut Checker, opt: Option<Box<AlgebraDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        None => {}
        Some(adef) => {
            let idx = (*c).algebras.count
            if idx >= 16 { return }
            var info = empty_algebra_info()
            info.name = (*adef).name
            info.is_valid = true
            if info.name.len == 8 && info.name.buf[0] == 79 as i8 {
                info.algebra_tag = 3  // Octonion
            } else if info.name.len == 8 && info.name.buf[0] == 83 as i8 {
                info.algebra_tag = 4  // Sedenion
            } else if info.name.len == 10 && info.name.buf[0] == 81 as i8 {
                info.algebra_tag = 2  // Quaternion
            }
            let mask = checker_algebra_def_law_mask((*adef).ops)
            info.add_commutative = (mask & 1) != 0
            info.add_associative = (mask & 2) != 0
            info.mul_commutative = (mask & 4) != 0
            info.mul_associative = (mask & 8) != 0
            info.mul_alternative = (mask & 16) != 0
            let mul_assoc = info.mul_associative
            let mul_alt = info.mul_alternative
            let declared = (*adef).reassoc_strategy
            if str_eq(read_env("SOUNIO_E252_TRACE"), "1") {
                print("e252-trace: tag=") print_int(info.algebra_tag)
                print(" declared=") print_int(declared)
                print(" mask=") print_int(mask)
                print("\n")
            }
            var strategy = declared
            if declared < 0 {
                if mul_assoc { strategy = 0 }
                else if mul_alt && info.algebra_tag == 3 { strategy = 2 }
                else { strategy = 1 }
            } else if declared == 0 && !mul_assoc {
                checker_report_error_at_inplace(c, (*adef).span, 252, 0, 0, 0)
                strategy = 1
            } else if declared == 2 && info.algebra_tag >= 4 {
                checker_report_error_at_inplace(c, (*adef).span, 252, 0, 0, 0)
                strategy = 1
            }
            info.reassoc_strategy = strategy
            (*c).algebras.entries[idx] = info
            (*c).algebras.count = idx + 1
        }
    }
}

fn checker_collect_type_alias_inplace(c: *mut Checker, name: Name, ty_opt: Option<Box<TypeExpr> >) with Mut, Panic, Div, Alloc, IO {
    match ty_opt {
        Some(te_box) => {
            let te = *te_box
            if te.kind == TypeExprKind::TypeRefinement {
                match te.refinement_info {
                    Some(ri_box) => {
                        let ri = *ri_box
                        match ri.base_type {
                            Some(bte) => {
                                let base_ty = checker_lower_type_expr_mut(c, *bte)
                                let pred = checker_refinement_pred_from_info(ri)
                                let rt = RefinementType { base_type: base_ty, var_name: ri.var_name, predicate: pred }
                                (*c).refinements = refinement_table_add((*c).refinements, name, rt)
                            }
                            None => {}
                        }
                    }
                    None => {}
                }
            } else {
                let alias_ty = checker_lower_type_expr_mut(c, te)
                if alias_ty.kind == TypeKind::TyModel {
                    let model_id = (*c).models.count
                    if model_id >= 16 {
                        checker_report_error_at_inplace(c, te.span, 63, 0, 0, 0)
                        return
                    }
                    let info = ModelInfo {
                        name: name,
                        input_ty: model_input_ty(alias_ty),
                        output_ty: model_output_ty(alias_ty),
                    }
                    (*c).models.entries[model_id as usize] = info
                    (*c).models.count = model_id + 1
                }
                (*c).env = (*c).env.bind(name, alias_ty, false)
                checker_const_int_bind_unknown_inplace(c, name)
            }
        }
        None => {}
    }
}

pub fn checker_collect_items_inplace(c: *mut Checker, items: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    // Stash the program items so the deep call-arg compat path can resolve
    // ontology subclass relations by name (E009 subsumption). Single shallow
    // pointer write — persists where deep ontology_kernel mutation does not.
    (*c).ontology_items = items
    checker_collect_runtime_builtins_inplace(c)
    var cursor = items
    while true {
        match cursor {
            Some(list) => {
                checker_collect_item_inplace(c, (*list).head)
                cursor = (*list).tail
            }
            None => break
        }
    }
}

fn checker_check_items_inplace(c: *mut Checker, items: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    var cursor = items
    while true {
        match cursor {
            Some(list) => {
                checker_check_item_inplace(c, (*list).head)
                cursor = (*list).tail
            }
            None => break
        }
    }
}

// ============================================================================
// In-place ontology axiom validation (Madaros boot4 path).
//
// The by-value collect_ontology_def path loses its error state in Madaros: it
// threads a ~164KB Checker through deep `c = c.method()` recursion, which the
// native codegen miscompiles (the same large-struct copy bug the *mut spine
// exists to avoid). These helpers validate ontology axioms directly on the
// parsed AST lists (pointer-sized, no large copies) and report through
// checker_report_error_at_inplace:
//   E156 role domain class not found, E157 role range class not found,
//   E158 inverse_of target role not found, E159 duplicate role declaration,
//   E041 ontology subsumption could not be verified (child property weakens parent).
// ============================================================================

fn onto_class_list_has(classes: Option<Box<OntologyClassDeclList> >, target: Name) -> bool with Mut, Panic, Div {
    var cur = classes
    while true {
        match cur {
            Some(list) => {
                if name_eq((*list).head.name, target) {
                    return true
                }
                cur = (*list).tail
            }
            None => break
        }
    }
    false
}

fn onto_role_list_has(roles: Option<Box<OntologyRoleDeclList> >, target: Name) -> bool with Mut, Panic, Div {
    var cur = roles
    while true {
        match cur {
            Some(list) => {
                if name_eq((*list).head.name, target) {
                    return true
                }
                cur = (*list).tail
            }
            None => break
        }
    }
    false
}

fn onto_role_count_in_prefix(roles: Option<Box<OntologyRoleDeclList> >, k: i64, target: Name) -> i64 with Mut, Panic, Div {
    var cur = roles
    var j: i64 = 0
    var n: i64 = 0
    while j < k {
        match cur {
            Some(list) => {
                if name_eq((*list).head.name, target) {
                    n = n + 1
                }
                cur = (*list).tail
            }
            None => break
        }
        j = j + 1
    }
    n
}

fn onto_prop_pred(p: OntologyPropertyDecl) -> RefinementPred with Mut, Panic, Div {
    RefinementPred {
        op: p.pred_op,
        var_name: p.name,
        rhs_int: p.pred_rhs_int,
        rhs_float: p.pred_rhs_float,
        is_float: p.is_float,
        left: None,
        right: None,
    }
}

// Field-wise RefinementPred constructor — the weakening check builds a predicate
// from scalar fields read directly off the inline property array (no struct copy).
fn onto_prop_pred_fields(op: i64, rhs_int: i64, rhs_float: f64, is_float: bool) -> RefinementPred with Mut, Panic, Div {
    RefinementPred {
        op: op,
        var_name: empty_name(),
        rhs_int: rhs_int,
        rhs_float: rhs_float,
        is_float: is_float,
        left: None,
        right: None,
    }
}

fn checker_onto_check_roles_inplace(c: *mut Checker, roles: Option<Box<OntologyRoleDeclList> >, classes: Option<Box<OntologyClassDeclList> >) with Mut, Panic, Div, Alloc, IO {
    var cur = roles
    var k: i64 = 0
    while true {
        match cur {
            Some(list) => {
                let decl = (*list).head
                let dup_before = onto_role_count_in_prefix(roles, k, decl.name)
                if dup_before > 0 || decl.duplicate_modifier_bits != 0 {
                    checker_report_error_at_inplace(c, decl.span, 159, 0, 0, 0)
                } else {
                    if decl.has_domain && !onto_class_list_has(classes, decl.domain_name) {
                        checker_report_error_at_inplace(c, decl.span, 156, 0, 0, 0)
                    }
                    if decl.has_range && !onto_class_list_has(classes, decl.range_name) {
                        checker_report_error_at_inplace(c, decl.span, 157, 0, 0, 0)
                    }
                    // Role lists are stored in reverse source order, so this
                    // node's tail contains exactly the declarations that came
                    // before it in the source. Match the canonical collector's
                    // declaration-order boundary instead of searching the whole
                    // list: lean_single rejects forward inverse targets with E158.
                    if decl.has_inverse && !onto_role_list_has((*list).tail, decl.inverse_name) {
                        checker_report_error_at_inplace(c, decl.span, 158, 0, 0, 0)
                    }
                }
                cur = (*list).tail
                k = k + 1
            }
            None => break
        }
    }
}

fn checker_onto_check_weakening_inplace(c: *mut Checker, classes: Option<Box<OntologyClassDeclList> >) with Mut, Panic, Div, Alloc, IO {
    var ci = classes
    while true {
        match ci {
            Some(clist) => {
                // Read property predicate fields DIRECTLY off the inline array
                // elements — do NOT copy the whole OntologyPropertyDecl (two embedded
                // [i8;128] Names). The large-boxed-struct codegen was fixed by the
                // bump-arena Box::new rework (#430); a direct
                // `(*clist).head.properties[a].pred_op` through the boxed list is now
                // correct, while copying the ~290 B struct out is unreliable.
                var si: i64 = 0
                while si < (*clist).head.superclass_count && si < 8 {
                    let sname = (*clist).head.superclass_names[si as usize]
                    var pi = classes
                    while true {
                        match pi {
                            Some(plist) => {
                                if name_eq((*plist).head.name, sname) {
                                    var a: i64 = 0
                                    while a < (*clist).head.property_count && a < 8 {
                                        let c_op = (*clist).head.properties[a as usize].pred_op
                                        if c_op > 0 {
                                            let c_name = (*clist).head.properties[a as usize].name
                                            var b: i64 = 0
                                            while b < (*plist).head.property_count && b < 8 {
                                                let p_op = (*plist).head.properties[b as usize].pred_op
                                                if p_op > 0 && name_eq(c_name, (*plist).head.properties[b as usize].name) {
                                                    let child_pred = onto_prop_pred_fields(
                                                        c_op,
                                                        (*clist).head.properties[a as usize].pred_rhs_int,
                                                        (*clist).head.properties[a as usize].pred_rhs_float,
                                                        (*clist).head.properties[a as usize].is_float)
                                                    let parent_pred = onto_prop_pred_fields(
                                                        p_op,
                                                        (*plist).head.properties[b as usize].pred_rhs_int,
                                                        (*plist).head.properties[b as usize].pred_rhs_float,
                                                        (*plist).head.properties[b as usize].is_float)
                                                    if !pred_implies(child_pred, parent_pred) {
                                                        checker_report_error_at_inplace(c, (*clist).head.properties[a as usize].span, 41, 0, 0, 0)
                                                    }
                                                }
                                                b = b + 1
                                            }
                                        }
                                        a = a + 1
                                    }
                                }
                                pi = (*plist).tail
                            }
                            None => break
                        }
                    }
                    si = si + 1
                }
                ci = (*clist).tail
            }
            None => break
        }
    }
}

pub fn checker_validate_ontology_items_inplace(c: *mut Checker, items: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    var cur = items
    while true {
        match cur {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemOntology {
                    match item.ontology_def {
                        Some(odef) => {
                            checker_onto_check_roles_inplace(c, (*odef).roles, (*odef).classes)
                            checker_onto_check_weakening_inplace(c, (*odef).classes)
                        }
                        None => {}
                    }
                }
                cur = (*list).tail
            }
            None => break
        }
    }
}

// *mut E042 emitter — mirrors report_multitest_correction_required (6140) but
// mutates (*c) in place instead of copying the 8MB Checker by value.
fn checker_report_multitest_correction_required_inplace(c: *mut Checker, span: Span, test_count: i64) with Mut, IO, Panic, Div {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
    (*c).diag_emitted = true
    print("error[E042]")
    if span.start > 0 || span.end > 0 {
        print(" at ")
        print_int(span.start)
        print("..")
        print_int(span.end)
    }
    print(": multiple tests (")
    print_int(test_count)
    print(") performed without correction\n")
    print("   |\n   = help: call bonferroni() or benjamini_hochberg() before leaving this function\n")
    print("   = note: functions with `with MultiTest` must record an explicit multiple-testing correction once they perform more than one statistical test\n")
}

// The caller must invoke this before popping the scope whose bindings it owns.
fn checker_require_current_linear_scope_consumed_inplace(c: *mut Checker) with Mut, IO, Panic, Div {
    let linear_check = (*c).borrows.check_linear_consumed()
    (*c).borrows = linear_check.0
    if linear_check.1 > 0 {
        (*c).had_error = true
        (*c).error_count = (*c).error_count + 1
        (*c).diag_emitted = true
        print("error[E040]: linear value not consumed (")
        print_int(linear_check.1)
        print(" unconsumed)\n")
    }
}

// Dedicated leaf for the by-value check_impl_item bridge. Isolating it here
// keeps its 8MB SRET frame OUT of checker_check_item_inplace (which else would
// carry the frame at compile time even for impl-free programs like `fn main(){}`).
// *mut in-place impl-method BODY check. Eliminates the ~8MB by-value Checker SRET of the
// old check_impl_def chain (the analogous module-76 crash in the CHECK pass). Mirrors
// checker_check_fn_item_inplace but resolves the sig via find_method + current_impl_type.
fn checker_check_impl_method_inplace(c: *mut Checker, item: Item) with Mut, Panic, Div, Alloc, IO {
    match item.fn_def {
        Some(fd) => {
            let saved_effects = (*c).current_effects
            let saved_effect_count = (*c).current_effect_count
            let saved_multitest_count = (*c).multitest_count
            let saved_multitest_corrected = (*c).multitest_corrected
            // Resolve the method signature by the FULL impl-type ENTRY (kind + name),
            // not by name alone. Imported types bound via `use` lower to ty_unknown()
            // (empty name) and builtins (i64, ...) also carry an empty TypeEntry name,
            // so two `impl Trait for {i64, ImportedType}` blocks both register their
            // methods with an empty self_type_name. The name-only find_method then
            // returned the FIRST empty-name match (e.g. the effect-empty `impl … for
            // i64` er_add) when checking a DIFFERENT impl's body (e.g. `impl … for
            // Rational` er_add, which carries `with Mut, Div, Panic`), leaving
            // current_effects empty and firing a spurious E035 on the merged/imported
            // lane. The semantic lookup disambiguates by TypeKind (TyUnknown vs TyI64),
            // so each impl body sees ITS OWN declared effects.
            (*c).current_fn_name = (*fd).name
            let sig_id = fn_sig_table_find_method_semantic((*c).fn_sigs, (*c).current_impl_type, (*fd).name)
            if sig_id >= 0 {
                let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
                (*c).current_return_type = sig.return_type
                (*c).current_effects = sig.effects
                (*c).current_effect_count = sig.effect_count
                (*c).current_sig_id = sig_id
                (*c).current_sig_name = sig.name
            } else {
                // An imported named impl can remain unresolved while its own body
                // is checked. Its declaration is nevertheless authoritative for
                // effect checking; do not silently treat that body as effect-free.
                let declared_effects = checker_extract_effects_mut(c, (*fd).effects)
                (*c).current_effects = declared_effects.effects
                (*c).current_effect_count = declared_effects.count
            }
            (*c).multitest_count = 0
            (*c).multitest_corrected = false
            (*c).env = (*c).env.push_scope()
            (*c).borrows = (*c).borrows.push_scope()
            checker_push_const_scope_inplace(c)
            checker_bind_fn_params_inplace(c, (*fd).params)
            let body_ty = checker_check_block_inplace(c, (*fd).body)
            if sig_id >= 0 {
                let sig2 = fn_sig_table_get((*c).fn_sigs, sig_id)
                if !checker_fn_body_return_compatible_inplace(c, body_ty, sig2.return_type) {
                    checker_report_mismatch_inplace(c, (*fd).span, 8, sig2.return_type, body_ty)
                }
                // The implicit tail return carries the same obligation as an
                // explicit one: `fn f() -> T { 2000000000 }` and
                // `fn f() -> T { return 2000000000 }` are the same claim. AFTER
                // the compatibility call above, which reads last_literal_kind for
                // its int-literal narrowing; this helper zeroes that flag, and the
                // zeroing is also what stops an explicit `return` inside the body
                // from being reported a second time here.
                checker_check_refinement_literal_inplace(c, (*fd).span, sig2.return_type)
            }
            if (*c).multitest_count > 1 && !(*c).multitest_corrected {
                checker_report_multitest_correction_required_inplace(c, (*fd).span, (*c).multitest_count)
            }
            checker_require_current_linear_scope_consumed_inplace(c)
            checker_pop_const_scope_inplace(c)
            (*c).borrows = (*c).borrows.pop_scope()
            (*c).env = (*c).env.pop_scope()
            (*c).current_return_type = ty_unit()
            (*c).current_sig_id = 0 - 1
            (*c).current_effects = saved_effects
            (*c).current_effect_count = saved_effect_count
            (*c).multitest_count = saved_multitest_count
            (*c).multitest_corrected = saved_multitest_corrected
        }
        None => {}
    }
}

fn checker_check_impl_methods_inplace(c: *mut Checker, opt: Option<Box<ItemList> >) with Mut, Panic, Div, Alloc, IO {
    var cursor = opt
    while true {
        match cursor {
            Some(list) => {
                checker_check_impl_method_inplace(c, (*list).head)
                cursor = (*list).tail
            }
            None => break
        }
    }
}

fn checker_check_impl_def_inplace(c: *mut Checker, opt: Option<Box<ImplDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(id) => {
            let impl_ty = checker_lower_type_expr_mut(c, (*id).target_type)
            (*c).current_impl_type = impl_ty
            checker_check_impl_methods_inplace(c, (*id).methods)
            (*c).current_impl_type = ty_error()
        }
        None => {}
    }
}

fn checker_check_impl_item_bridge(c: *mut Checker, opt: Option<Box<ImplDef> >) with Mut, Panic, Div, Alloc, IO {
    // *mut in-place (no SRET); replaces the by-value `checker_store_from_value(c, (*c).check_impl_item(opt))`.
    checker_check_impl_def_inplace(c, opt)
}

// Dedicated leaf for the by-value collect_impl_def bridge (registers impl method
// signatures). Same isolation rationale as the check bridge above.
// *mut in-place impl-method collection. Eliminates the ~8MB by-value Checker SRET of the
// old collect_impl_def chain (the module-76 self-compile crash: a method's collection
// copied + returned the whole Checker, corrupting the stack). Mirrors
// checker_collect_fn_def_inplace + the self-param skip from collect_method_params, using
// the existing *mut spine (checker_collect_fn_params_mut / _lower_type_expr_mut /
// _extract_effects_mut). No copy or return of the Checker.
fn checker_collect_impl_method_inplace(c: *mut Checker, item: Item, type_name: Name) with Mut, Panic, Div, Alloc, IO {
    match item.fn_def {
        Some(fd) => {
            // Skip the self param for method signatures (mirror collect_method_params).
            let saved_effects = (*c).current_effects
            let saved_effect_count = (*c).current_effect_count
            let eff_pair_early = checker_extract_effects_mut(c, (*fd).effects)
            (*c).current_effects = eff_pair_early.effects
            (*c).current_effect_count = eff_pair_early.count
            let params_pair = match (*fd).params {
                Some(pl) => {
                    if (*pl).head.is_self {
                        checker_collect_fn_params_mut(c, (*pl).tail)
                    } else {
                        checker_collect_fn_params_mut(c, (*fd).params)
                    }
                }
                None => checker_collect_fn_params_mut(c, None)
            }
            let params = params_pair.params
            let param_count = params_pair.count
            let ret_ty = match (*fd).return_type {
                Some(te) => checker_lower_type_expr_mut(c, *te)
                None => ty_unknown()
            }
            (*c).current_effects = saved_effects
            (*c).current_effect_count = saved_effect_count
            let fn_effects = eff_pair_early.effects
            let fn_effect_count = eff_pair_early.count
            let epistemic_min_confidence = epistemic_min_confidence_from_effects((*fd).effects)
            let sig = FnSig {
                name: item.name,
                params: params,
                param_count: param_count,
                return_type: ret_ty,
                is_method: true,
                self_type_name: type_name,
                self_type_entry: (*c).current_impl_type,
                effects: fn_effects,
                effect_count: fn_effect_count,
                is_kernel: false,
                is_epistemic_kernel: false,
                is_extern: false,
                is_linear_closure: false,
                linear_capture_count: 0,
                epistemic_epsilon: 0.0 - 1.0,
                epistemic_min_confidence: epistemic_min_confidence,
                visibility_kind: item.visibility.kind,
                defining_module_seg_count: (*c).current_module.seg_count,
                defining_module_id: (*c).current_module_id,
                visibility: item.visibility,
                defining_module: (*c).current_module,
            }
            let _added = fn_sig_table_add((*c).fn_sigs, sig)
        }
        None => {}
    }
}

fn checker_collect_impl_methods_inplace(c: *mut Checker, opt: Option<Box<ItemList> >, type_name: Name) with Mut, Panic, Div, Alloc, IO {
    var cursor = opt
    while true {
        match cursor {
            Some(list) => {
                checker_collect_impl_method_inplace(c, (*list).head, type_name)
                cursor = (*list).tail
            }
            None => break
        }
    }
}

fn checker_collect_impl_def_inplace(c: *mut Checker, opt: Option<Box<ImplDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(id) => {
            let impl_ty = checker_lower_type_expr_mut(c, (*id).target_type)
            (*c).current_impl_type = impl_ty
            checker_collect_impl_methods_inplace(c, (*id).methods, impl_ty.name)
        }
        None => {}
    }
}

fn checker_collect_impl_item_bridge(c: *mut Checker, opt: Option<Box<ImplDef> >) with Mut, Panic, Div, Alloc, IO {
    // *mut in-place (no SRET); replaces the by-value `checker_store_from_value(c, (*c).collect_impl_def(opt))`.
    checker_collect_impl_def_inplace(c, opt)
}

fn checker_check_item_inplace(c: *mut Checker, item: Item) with Mut, Panic, Div, Alloc, IO {
    if item.kind == ItemKind::ItemFn {
        checker_check_fn_item_inplace(c, item.fn_def)
    } else if item.kind == ItemKind::ItemImpl {
        checker_check_impl_item_bridge(c, item.impl_def)
    }
}

// Loud-failure guard for oversized by-value frames (#187). lean_single warns
// when a function frame exceeds max_frame_bytes(); the Madaros/boot4 spine had
// no equivalent, so e.g. an 18 MB TiledSurface passed/returned by value
// SIGSEGV'd silently at runtime. These helpers size a by-value aggregate
// TypeEntry and warn when a param or return exceeds the budget.
fn large_frame_warn_bytes() -> i64 { return 4194304 }

fn checker_type_byte_size_inplace(c: *mut Checker, ty: TypeEntry, depth: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
    if depth > 32 {
        return 0
    }
    if is_error_or_unknown(ty) {
        return 0
    }
    if ty.kind == TypeKind::TyArray {
        var elem_sz: i64 = 8
        match ty.inner {
            Some(e) => { elem_sz = checker_type_byte_size_inplace(c, *e, depth + 1) }
            None => {}
        }
        return ty.array_size * elem_sz
    }
    if ty.kind == TypeKind::TyRef || ty.kind == TypeKind::TyRefMut {
        return 8
    }
    if ty.kind == TypeKind::TyNamed {
        // Box<T> is a pointer (8); recursing into its inner would over-count.
        if name_matches_str3(ty.name, 66, 111, 120) {
            return 8
        }
        let sidx = struct_table_find((*c).structs, ty.name)
        if sidx >= 0 {
            let si = struct_table_get((*c).structs, sidx)
            return checker_fieldlist_byte_size_inplace(c, si.fields, depth + 1)
        }
        // Enums / opaque named types: conservative pointer-sized estimate.
        return 8
    }
    if ty.kind == TypeKind::TyI8 || ty.kind == TypeKind::TyU8 || ty.kind == TypeKind::TyBool {
        return 1
    }
    if ty.kind == TypeKind::TyI32 || ty.kind == TypeKind::TyU32 || ty.kind == TypeKind::TyF32 {
        return 4
    }
    // i64 / f64 / u64 / pointers / default.
    return 8
}

fn checker_fieldlist_byte_size_inplace(c: *mut Checker, opt: Option<Box<FieldInfoList> >, depth: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    var total: i64 = 0
    while true {
        match cur {
            Some(list) => {
                total = total + checker_type_byte_size_inplace(c, (*list).head.ty, depth)
                cur = (*list).tail
            }
            None => break
        }
    }
    total
}

fn checker_warn_large_by_value_inplace(c: *mut Checker, fn_name: Name, role: i64, bytes: i64) with Mut, IO, Panic, Div {
    (*c).warning_count = (*c).warning_count + 1
    print("warning: stack frame too large (")
    print_int(bytes)
    print(" bytes) — ")
    if role == 0 {
        print("return of fn ")
    } else {
        print("by-value parameter of fn ")
    }
    print_name_value(fn_name)
    print(" — consider passing by &!/reference or using heap/global storage\n")
}

fn checker_warn_large_params_inplace(c: *mut Checker, fn_name: Name, opt: Option<Box<ParamList> >) with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    while true {
        match cur {
            Some(pl) => {
                if !(*pl).head.is_self {
                    let pty = checker_lower_type_expr_mut(c, (*pl).head.ty)
                    let psz = checker_type_byte_size_inplace(c, pty, 0)
                    if psz > large_frame_warn_bytes() {
                        checker_warn_large_by_value_inplace(c, fn_name, 1, psz)
                    }
                }
                cur = (*pl).tail
            }
            None => break
        }
    }
}

fn checker_bind_fn_param_inplace(c: *mut Checker, p: Param) with Mut, Panic, Div, Alloc, IO {
    if p.is_self {
        (*c).env = (*c).env.bind(p.name, (*c).current_impl_type, p.is_self_mut)
        checker_const_int_bind_unknown_inplace(c, p.name)
        let self_linear = checker_is_linear_type_inplace(c, (*c).current_impl_type)
        (*c).borrows = (*c).borrows.track(p.name, self_linear)
    } else {
        let param_ty = checker_lower_type_expr_mut(c, p.ty)
        (*c).env = (*c).env.bind(p.name, param_ty, false)
        checker_const_int_bind_unknown_inplace(c, p.name)
        let lin = checker_is_linear_type_inplace(c, param_ty)
        (*c).borrows = (*c).borrows.track(p.name, lin)
    }
}

fn checker_bind_fn_params_inplace(c: *mut Checker, opt: Option<Box<ParamList> >) with Mut, Panic, Div, Alloc, IO {
    var cursor = opt
    while true {
        match cursor {
            Some(pl) => {
                checker_bind_fn_param_inplace(c, (*pl).head)
                cursor = (*pl).tail
            }
            None => break
        }
    }
}

fn checker_check_fn_item_inplace(c: *mut Checker, opt: Option<Box<FnDef> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(fd) => {
            let saved_effects = (*c).current_effects
            let saved_effect_count = (*c).current_effect_count
            let saved_multitest_count = (*c).multitest_count
            let saved_multitest_corrected = (*c).multitest_corrected
            // Proven by-value reads: .find/.get copy only the ~38KB FnSigTable,
            // never the 8MB Checker, so they're harmless against the 8MB budget.
            // Direct (*(*c).fn_sigs).entries[idx].field reads were tried but CANNOT
            // be validated this session — no checkable program reaches the
            // return-type path until the expr spine lands — so the conservative
            // proven path ships. Revisit direct-read with a real return-mismatch
            // gate once `return <expr>` no longer crashes the check spine.
            (*c).current_fn_name = (*fd).name
            // Defect B (docs/audit/MADAROS_PBPK28_NN_TENSOR_COMPILE_RUNTIME_DIVERGENCE_2026-08-17.md):
            // a bare-name fn_sig_table_find here is the exact same disease the
            // fn_sig_table_find_prefer_module doc comment describes for E175 --
            // "the later module's body calls resolve to the earlier module's
            // private sig" -- just for effect-checking (E035) rather than
            // visibility. Two modules each declaring their own `fn main` (a
            // real shape: an entry file importing specific names from a module
            // that also happens to define its own main) collide on this
            // self-lookup: whichever module's `main` sits earlier in the shared
            // fn_sigs table wins, so the OTHER module's `main` gets checked
            // against the wrong function's declared effects/return type.
            // current_module_id is already correctly tracked per-module by
            // this pass's caller (check_modules_verdict_boot4_with_visibility)
            // -- prefer it, exactly as the sibling E175 fix already does at
            // check.sio:7120.
            let sig_id = fn_sig_table_find_prefer_module((*c).fn_sigs, (*fd).name, (*c).current_module_id)
            if sig_id >= 0 {
                let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
                (*c).current_return_type = sig.return_type
                (*c).current_effects = sig.effects
                (*c).current_effect_count = sig.effect_count
                (*c).current_sig_id = sig_id
                (*c).current_sig_name = sig.name
                // Per-call-site recording: note a `with Chaotic` (effect id 22) function.
                if has_effect_id(sig.effects, sig.effect_count, 22) { equiv_set_chaotic() }
                // Loud-failure guard (#187): warn on oversized by-value return.
                let ret_sz = checker_type_byte_size_inplace(c, sig.return_type, 0)
                if ret_sz > large_frame_warn_bytes() {
                    checker_warn_large_by_value_inplace(c, (*fd).name, 0, ret_sz)
                }
            }
            // Loud-failure guard (#187): warn on oversized by-value parameters.
            checker_warn_large_params_inplace(c, (*fd).name, (*fd).params)
            (*c).multitest_count = 0
            (*c).multitest_corrected = false
            if (*fd).is_extern {
                (*c).current_return_type = ty_unit()
                (*c).current_sig_id = 0 - 1
                (*c).current_effects = saved_effects
                (*c).current_effect_count = saved_effect_count
                (*c).multitest_count = saved_multitest_count
                (*c).multitest_corrected = saved_multitest_corrected
                return
            }
            (*c).env = (*c).env.push_scope()
            (*c).borrows = (*c).borrows.push_scope()
            checker_push_const_scope_inplace(c)
            checker_bind_fn_params_inplace(c, (*fd).params)
            (*c).escape_provenance = 0
            let body_ty = checker_check_block_inplace(c, (*fd).body)
            if sig_id >= 0 {
                let sig2 = fn_sig_table_get((*c).fn_sigs, sig_id)
                if !checker_fn_body_return_compatible_inplace(c, body_ty, sig2.return_type) {
                    checker_report_mismatch_inplace(c, (*fd).span, 8, sig2.return_type, body_ty)
                }
                // Free-function implicit tail return. Same obligation and same
                // ordering constraint as the impl-method site above; see the
                // comment there.
                checker_check_refinement_literal_inplace(c, (*fd).span, sig2.return_type)
            }
            // Raw-reference escape: the body tail yields a reference rooted in a
            // frame-local (e.g. `let r = &x; r` or `Holder { p: &x }`) → dangling.
            if (*c).escape_provenance == 1 {
                checker_report_error_at_inplace(c, (*fd).span, 91, 0, 0, 0)
            }
            if (*c).multitest_count > 1 && !(*c).multitest_corrected {
                checker_report_multitest_correction_required_inplace(c, (*fd).span, (*c).multitest_count)
            }
            checker_require_current_linear_scope_consumed_inplace(c)
            checker_pop_const_scope_inplace(c)
            (*c).borrows = (*c).borrows.pop_scope()
            (*c).env = (*c).env.pop_scope()
            (*c).current_return_type = ty_unit()
            (*c).current_sig_id = 0 - 1
            (*c).current_effects = saved_effects
            (*c).current_effect_count = saved_effect_count
            (*c).multitest_count = saved_multitest_count
            (*c).multitest_corrected = saved_multitest_corrected
        }
        None => {}
    }
}

fn checker_check_block_inplace(c: *mut Checker, blk: Block) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    (*c).env = (*c).env.push_scope()
    (*c).borrows = (*c).borrows.push_scope()
    checker_push_const_scope_inplace(c)
    let result_ty = checker_check_stmts_inplace(c, blk.stmts)
    checker_require_current_linear_scope_consumed_inplace(c)
    checker_pop_const_scope_inplace(c)
    (*c).borrows = (*c).borrows.pop_scope()
    (*c).env = (*c).env.pop_scope()
    result_ty
}

// ============================================================
// Escape provenance (raw-reference escape analysis)
//
// 0 = first-class: rooted in a reference parameter / global → outlives the frame.
// 1 = LOCAL: rooted in a frame-bound let/var local → must NOT escape via return or
// an escaping store. Propagated by the capture-calculus cv-taint rule (see
// docs/audit/MADAROS_RAW_REFERENCE_CODEGEN_2026-06-21.md §7): cv(&x)=LOCAL iff x is a
// frame-local; let r=e gives r the provenance of e; &self.f keeps the root (param)
// provenance; a struct literal is tainted LOCAL if any field is.
// ============================================================

// Is the ROOT of a borrowed place a frame-bound local? Walks ident / field-access /
// unary chains to the root variable and tests its borrow scope_depth (params live at
// depth 1, body-locals at depth >= 2). Unknown roots → false (conservative: never a
// false-reject; an unhandled escape would still hit the codegen loud-fail, not a
// silent miscompile).
fn checker_place_root_local(c: *mut Checker, place: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if place.kind == ExprKind::ExprIdent {
        (*c).borrows.scope_depth_of(place.name) >= 2
    } else if place.kind == ExprKind::ExprFieldAccess {
        let ptr = expr_opt_get(place.left)
        if ptr == 0 as *mut Expr { return false }
        checker_place_root_local(c, *ptr)
    } else if place.kind == ExprKind::ExprUnary {
        let ptr = expr_opt_get(place.left)
        if ptr == 0 as *mut Expr { return false }
        checker_place_root_local(c, *ptr)
    } else {
        false
    }
}

// True when an assignment target writes THROUGH an exclusive reference:
//
//     *p = v        p: &!T
//     p.f = v       p: &!S
//     p[i] = v      p: &![T; N] / &![T]
//
// Walks the place to its root binding — same shape as checker_place_root_local
// above — and asks whether that binding is an exclusive reference.
//
// Only this shape generates `Mut` (#1488). The two authorities on what `Mut`
// means disagree about a plain local `var`: docs/guide/LLM_PROGRAMMING_GUIDE.md:230
// says "mutating `&!` refs or arrays" (narrow, what Madaros implements) and
// docs/spec/LANGUAGE_SPECIFICATION.md:965 says "reading/writing mutable variables"
// (broad, what lean_single implements). They AGREE about a write through an
// exclusive reference. Generating the effect only where both readings agree closes
// the unsound case without pre-empting an operator ruling on the other — and the
// broad reading is viral over every loop counter in 1113 stdlib files, so adopting
// it is a language decision, not a compiler fix.
//
// Conservative by construction: an unknown root yields false, so this can add a
// required effect but never remove one, and cannot false-reject a program whose
// place shape it does not recognise.
fn checker_place_excl_ref_root(c: *mut Checker, place: Expr, depth: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    if depth > 16 { return false }
    if place.kind == ExprKind::ExprIdent {
        if !(*c).env.has_binding(place.name) { return false }
        let root_ty = (*c).env.lookup(place.name)
        // TyRefMut only — deliberately NOT TySliceMut.
        //
        // Measured 2026-07-26: lean_single requires Mut for a write through
        // `&!T`, `&!S` and `&![T; N]`, and does NOT require it for a write
        // through a slice `&![T]`. Including TySliceMut here made Madaros
        // stricter than the seed and rejected existing intentional code —
        // `kernel fn vec_add_in_place(n: i64, a: &![f64], …) with GPU` writes
        // `a[tid] = …` and declares only GPU.
        //
        // Whether a slice write is Mut is a language question of the same kind
        // as the local-`var` one, and answering it unilaterally inside a fix for
        // a different defect would be drift. This closes the shapes on which
        // both engines already agree; the slice case is left open and recorded.
        return root_ty.kind == TypeKind::TyRefMut
    }
    if place.kind == ExprKind::ExprFieldAccess
        || place.kind == ExprKind::ExprIndex
        || place.kind == ExprKind::ExprUnary {
        let base = expr_opt_get(place.left)
        if base == 0 as *mut Expr { return false }
        return checker_place_excl_ref_root(c, *base, depth + 1)
    }
    false
}

fn checker_expr_provenance(c: *mut Checker, e: Expr) -> i64 with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprUnary {
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            let ptr = expr_opt_get(e.left)
            if ptr == 0 as *mut Expr { return 0 }
            if checker_place_root_local(c, *ptr) { 1 } else { 0 }
        } else {
            0
        }
    } else if e.kind == ExprKind::ExprIdent {
        (*c).borrows.provenance_of(e.name)
    } else if e.kind == ExprKind::ExprStructLit {
        var prov = 0
        var cur = e.fields
        var guard = 0
        while guard < 1024 {
            guard = guard + 1
            match cur {
                Some(list) => {
                    if checker_expr_provenance(c, (*list).head.value) == 1 { prov = 1 }
                    cur = (*list).tail
                }
                None => break
            }
        }
        prov
    } else if e.kind == ExprKind::ExprIf {
        // An `if` used as a value/return tail escapes if either branch tail yields a
        // frame-local reference: `if c { &x } else { &x }`. Recurse into the else expression
        // (also covers else-if chains) and the then-block's tail expression.
        var iprov = 0
        match e.else_expr {
            Some(ee) => { if checker_expr_provenance(c, *ee) == 1 { iprov = 1 } }
            _ => {}
        }
        match e.block {
            Some(blk) => {
                var bcur = (*blk).stmts
                var bg = 0
                while bg < 4096 {
                    bg = bg + 1
                    match bcur {
                        Some(list) => {
                            match (*list).tail {
                                None => {
                                    if (*list).head.kind == StmtKind::StmtExpr {
                                        match (*list).head.expr {
                                            Some(te) => { if checker_expr_provenance(c, *te) == 1 { iprov = 1 } }
                                            _ => {}
                                        }
                                    }
                                }
                                _ => {}
                            }
                            bcur = (*list).tail
                        }
                        None => break
                    }
                }
            }
            _ => {}
        }
        iprov
    } else if e.kind == ExprKind::ExprMatch {
        // A `match` used as a value/return tail escapes if any arm body yields a frame-local
        // reference: `match c { _ => &x }`.
        var mprov = 0
        var mcur = e.arms
        var mg = 0
        while mg < 4096 {
            mg = mg + 1
            match mcur {
                Some(list) => {
                    if checker_expr_provenance(c, (*list).head.body) == 1 { mprov = 1 }
                    mcur = (*list).tail
                }
                None => break
            }
        }
        mprov
    } else if e.kind == ExprKind::ExprBlock {
        // A block as a value/return tail (e.g. a block-bodied match arm or `if` branch)
        // escapes if its tail expression yields a frame-local reference.
        var bprov = 0
        match e.block {
            Some(blk) => {
                var bc = (*blk).stmts
                var bgg = 0
                while bgg < 4096 {
                    bgg = bgg + 1
                    match bc {
                        Some(list) => {
                            match (*list).tail {
                                None => {
                                    if (*list).head.kind == StmtKind::StmtExpr {
                                        match (*list).head.expr {
                                            Some(te) => { if checker_expr_provenance(c, *te) == 1 { bprov = 1 } }
                                            _ => {}
                                        }
                                    }
                                }
                                _ => {}
                            }
                            bc = (*list).tail
                        }
                        None => break
                    }
                }
            }
            _ => {}
        }
        bprov
    } else {
        0
    }
}

fn checker_expr_provenance_opt(c: *mut Checker, opt: Option<Box<Expr> >) -> i64 with Mut, Panic, Div, Alloc, IO {
    let ptr = expr_opt_get(opt)
    if ptr == 0 as *mut Expr { return 0 }
    checker_expr_provenance(c, *ptr)
}

fn checker_check_stmts_inplace(c: *mut Checker, opt: Option<Box<StmtList> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    var cursor = opt
    var last_ty = ty_unit()
    while true {
        match cursor {
            Some(list) => {
                // Reset the int-literal flag before each stmt so that after the
                // loop (*c).last_literal_kind reflects ONLY the block's tail
                // statement — a bare `0` leaves it set, a non-literal tail (call,
                // ident, binary) leaves it clear, never stale from an earlier
                // statement's literal. The E008 return-narrow (checker_collect_fn_
                // def_inplace) depends on this being the tail's literalness.
                (*c).last_literal_kind = 0
                last_ty = checker_check_stmt_inplace(c, (*list).head)
                // Capture the escape provenance of the block's TAIL expression
                // (the value the block/function yields) while the AST is still live;
                // the return-compatibility site only sees the TypeEntry.
                match (*list).tail {
                    None => {
                        if (*list).head.kind == StmtKind::StmtExpr {
                            (*c).escape_provenance = checker_expr_provenance_opt(c, (*list).head.expr)
                        } else {
                            (*c).escape_provenance = 0
                        }
                    }
                    Some(_) => {}
                }
                cursor = (*list).tail
            }
            None => break
        }
    }
    last_ty
}

fn checker_check_stmt_bridge(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let pair = (*c).check_stmt(s)
    checker_store_from_value(c, pair.0)
    pair.1
}

fn checker_check_stmt_inplace(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // NOTE: dispatch via explicit if-equality, NOT `match s.kind`. bin/souc
    // miscompiles a `match <enum-field>` inside a *mut function — the first
    // variant silently falls through to the wildcard/last arm (root-caused on
    // ExprKind in checker_check_expr_inplace, where ExprIntLit fell to `_` →
    // by-value check_expr → runaway recursion). StmtKind has the same exposure.
    if s.kind == StmtKind::StmtLet {
        checker_check_let_stmt_inplace(c, s)
    } else if s.kind == StmtKind::StmtVar {
        checker_check_var_stmt_inplace(c, s)
    } else if s.kind == StmtKind::StmtExpr {
        checker_check_expr_stmt_inplace(c, s)
    } else if s.kind == StmtKind::StmtAssign {
        checker_check_assign_stmt_inplace(c, s)
    } else {
        checker_check_stmt_bridge(c, s)
    }
}

fn checker_check_expr_stmt_inplace(c: *mut Checker, s: Stmt) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    checker_check_opt_expr_inplace(c, s.expr)
}

fn expr_opt_get(opt: Option<Box<Expr> >) -> *mut Expr with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => e as *mut Expr
        None => 0 as *mut Expr
    }
}

fn checker_check_opt_expr_inplace(c: *mut Checker, opt: Option<Box<Expr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let ptr = expr_opt_get(opt)
    if ptr == 0 as *mut Expr { return ty_unit() }
    checker_check_expr_inplace(c, *ptr)
}

fn checker_check_return_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    (*c).last_literal_kind = 0  // so the flag reflects ONLY this return value expr
    let val_ty = checker_check_opt_expr_inplace(c, e.left)
    match e.left {
        Some(val_expr) => {
            if !checker_contextual_expr_compatible(*val_expr, val_ty, (*c).current_return_type) {
                checker_report_mismatch_inplace(c, e.span, 8, (*c).current_return_type, val_ty)
            }
            // A refinement must hold at the RETURN too, not only at a binding.
            //
            // Measured on main@88c2ab8ee8: checker_check_refinement_literal_inplace
            // had exactly two callers (9627, 9687), both in the let/var handlers,
            // and check/compat.sio has zero references to refinement_id. So under
            // Madaros a refinement was enforced where a value is BOUND and nowhere
            // else, and
            //
            //     fn f() -> { n: i64 | n >= 0 } { return 0 - 5 }
            //
            // was accepted. lean_single rejects it; tests/known_failures/
            // hardened_diagnostics_full_suite.txt records the split and calls the
            // Madaros side "a compiler defect, not a manifest one" (2026-08-23).
            //
            // Scope: the helper only acts when last_literal_kind is 1 or 2, so
            // this closes the LITERAL return. `return x` for an ident, and a
            // literal propagated through a let, are still accepted here -- they
            // need dataflow this site does not have.
            //
            // Placed AFTER the compatibility check on purpose: this helper zeroes
            // last_literal_kind on exit, and checker_fn_body_return_compatible_inplace
            // reads that same flag for its int-literal return narrowing.
            checker_check_refinement_literal_inplace(c, e.span, (*c).current_return_type)
            // Raw-reference escape: `return &local` / `return r` where r is rooted
            // in a frame-local → dangling reference.
            if checker_expr_provenance(c, *val_expr) == 1 {
                checker_report_error_at_inplace(c, e.span, 91, 0, 0, 0)
            }
        }
        None => {
            if !checker_types_compatible_inplace(c, val_ty, (*c).current_return_type) {
                checker_report_mismatch_inplace(c, e.span, 8, (*c).current_return_type, val_ty)
            }
        }
    }
    ty_never()
}

fn checker_check_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if (*c).expr_depth >= MAX_EXPR_DEPTH {
        checker_report_error_at_inplace(c, e.span, 61, (*c).expr_depth, MAX_EXPR_DEPTH, 0)
        return ty_error()
    }
    (*c).expr_depth = (*c).expr_depth + 1
    // Dispatch via explicit if-equality, NOT `match e.kind`. bin/souc miscompiles
    // a `match <enum-field>` inside a *mut function: ExprIntLit (discriminant 0)
    // silently fell through to the `_` wildcard → by-value check_expr → runaway
    // recursion that SIGSEGVs/OOMs on any function body (`fn main(){1}`). The
    // if-chain compiles correctly. Root-caused 2026-06-01 by 10-step bisection.
    var result = ty_error()
    if e.kind == ExprKind::ExprIntLit {
        (*c).last_literal_int = e.int_val
        (*c).last_literal_kind = 1
        result = ty_i64()
    } else if e.kind == ExprKind::ExprFloatLit {
        (*c).last_literal_float = e.float_val
        (*c).last_literal_kind = 2
        result = ty_f64()
    } else if e.kind == ExprKind::ExprBoolTrue {
        result = ty_bool()
    } else if e.kind == ExprKind::ExprBoolFalse {
        result = ty_bool()
    } else if e.kind == ExprKind::ExprStringLit {
        result = ty_string()
    } else if e.kind == ExprKind::ExprCharLit {
        result = ty_char()
    } else if e.kind == ExprKind::ExprReturn {
        result = checker_check_return_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprPath {
        result = checker_check_path_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprBinary {
        result = checker_check_binary_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprIf {
        result = checker_check_if_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprWhile {
        result = checker_check_while_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprBlock {
        result = checker_check_block_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprArrayLit {
        result = checker_check_array_lit_inplace(c, e)
    } else if e.kind == ExprKind::ExprUnary {
        result = checker_check_unary_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprFieldAccess {
        result = checker_check_field_access_inplace(c, e)
    } else if e.kind == ExprKind::ExprIndex {
        result = checker_check_index_inplace(c, e)
    } else if e.kind == ExprKind::ExprMatch {
        result = checker_check_match_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprStructLit {
        result = checker_check_struct_lit_inplace(c, e)
    } else if e.kind == ExprKind::ExprMethodCall {
        result = checker_check_method_call_inplace(c, e)
    } else if e.kind == ExprKind::ExprCall {
        result = checker_check_call_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprIdent {
        result = checker_check_ident_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprCast {
        result = checker_check_cast_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprClosure {
        result = checker_check_closure_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprForIn {
        result = checker_check_for_in_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprRange {
        result = checker_check_range_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprTupleLit {
        result = checker_check_tuple_lit_inplace(c, e)
    } else if e.kind == ExprKind::ExprBreak {
        result = checker_check_break_expr_inplace(c, e)
    } else if e.kind == ExprKind::ExprContinue {
        result = checker_check_continue_expr_inplace(c, e)
    } else {
        result = checker_check_expr_mut(c, e)
    }
    if (*c).expr_depth > 0 {
        (*c).expr_depth = (*c).expr_depth - 1
    }
    result
}

// *mut ExprRange handler: checks both endpoints in place (returns only TypeEntry),
// so the ~164KB `self` Checker is never SRET-moved. ExprRange previously fell to the
// by-value `checker_check_expr_mut` else-branch, whose (Checker,TypeEntry) return
// became a return-address-smash SIGSEGV once (*c).enums was populated — i.e. ANY
// program with a range/for-loop crashed --check. Faithful transcription of the
// by-value check_range_expr.
fn checker_check_range_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let left_ty = checker_check_opt_expr_inplace(c, e.left)
    let right_ty = checker_check_opt_expr_inplace(c, e.right)
    if !is_error_or_unknown(left_ty) && !is_integer_type(left_ty) {
        checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), left_ty)
    }
    if !is_error_or_unknown(right_ty) && !is_integer_type(right_ty) {
        checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), right_ty)
    }
    ty_unit()
}

// *mut ExprTupleLit handler. Was missing from the inplace dispatch → fell to by-value
// checker_check_expr_mut → 164KB Checker SRET-smash. ANY tuple literal as a value
// expression (`let t = (1,2)`) crashed --check (destructuring `let (a,b)=..` survived via
// a different path). Checks each element in place (no per-element Checker copy) and builds
// the tuple type. Faithful to by-value check_tuple_lit + check_tuple_elems.
fn checker_check_tuple_elems_inplace(c: *mut Checker, opt: Option<Box<ExprList> >) -> Option<Box<TypeEntryList> > with Mut, Panic, Div, Alloc, IO {
    var types: [TypeEntry; 16] = [empty_type_entry(); 16]
    var count: i64 = 0
    var cur = opt
    var done = false
    while !done {
        match cur {
            Some(list) => {
                if count < 16 {
                    types[count] = checker_check_expr_inplace(c, (*list).head)
                    count = count + 1
                    cur = (*list).tail
                } else {
                    done = true
                }
            }
            None => {
                done = true
            }
        }
    }
    if count == 0 {
        return None
    }
    var result: Option<Box<TypeEntryList> > = None
    var j = count - 1
    while j >= 0 {
        result = Some(Box::new(TypeEntryList { head: types[j as usize], tail: result }))
        j = j - 1
    }
    result
}

fn checker_check_tuple_lit_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let elems = checker_check_tuple_elems_inplace(c, e.args)
    match elems {
        Some(elem_list) => ty_tuple(*elem_list)
        None => ty_unit()
    }
}

// *mut ExprBreak / ExprContinue handlers. Both were missing from the inplace dispatch
// → fell to by-value checker_check_expr_mut → 164KB Checker SRET-smash. ANY loop using
// break/continue crashed --check (in larger enum-populated files). Faithful to the
// by-value check_break_expr / check_continue_expr (codes 44/45, return ty_never()).
fn checker_check_break_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if (*c).loop_depth == 0 {
        checker_report_error_at_inplace(c, e.span, 44, 0, 0, 0)
    }
    ty_never()
}

fn checker_check_continue_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if (*c).loop_depth == 0 {
        checker_report_error_at_inplace(c, e.span, 45, 0, 0, 0)
    }
    ty_never()
}

// FIX #2 (spine-completion): *mut ExprPath leaf handler. Faithful in-place transcription
// of by-value check_path_expr (a PURE READ — returns `self` unchanged in every branch).
// Returns only the TypeEntry, so it never moves the ~164KB `self` Checker by SRET — that
// move is what bin/souc miscompiles into a return-address smash once (*c).enums is
// populated. See docs/audit/g1_wip/ENUM_COLLECTOR_READPATH_BLOCKER_2026-06-01.md.
fn checker_check_path_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_name = checker_copy_string_list_to_name(e.path.segments)
    let enum_idx = enum_table_find((*c).enums, first_name)
    if enum_idx >= 0 {
        let ei = enum_table_get((*c).enums, enum_idx)
        if (*c).enforce_visibility && !checker_enum_visible_inplace(c, enum_idx) {
            checker_report_private_enum_inplace(c, e.span, enum_idx, first_name)
        }
        ty_named(first_name)
    } else {
        // Could be a variant name directly (e.g. None, Some)
        let variant_enum_idx = enum_table_find_variant_enum((*c).enums, first_name)
        if variant_enum_idx >= 0 {
            let ei = enum_table_get((*c).enums, variant_enum_idx)
            if (*c).enforce_visibility && !checker_enum_visible_inplace(c, variant_enum_idx) {
                checker_report_private_enum_inplace(c, e.span, variant_enum_idx, first_name)
            }
            ty_named(ei.name)
        } else {
            // Look up in env as a regular binding; functions live in fn_sigs (not env), so
            // fall back to fn_sigs for a bare function reference before yielding ty_error.
            if !(*c).env.has_binding(first_name) {
                let fn_sig_id = checker_fn_sigs_find_inplace(c, first_name)
                if fn_sig_id >= 0 {
                    ty_fn(fn_sig_id)
                } else {
                    (*c).env.lookup(first_name)
                }
            } else {
                (*c).env.lookup(first_name)
            }
        }
    }
}

// Narrow a default i64 int-literal operand to a narrower integer peer (e.g. `a: i32 + 10`).
fn checker_narrow_literal_operand_ty(operand_ty: TypeEntry, operand_was_int_lit: bool, peer_ty: TypeEntry) -> TypeEntry {
    if !operand_was_int_lit {
        return operand_ty
    }
    if operand_ty.kind != TypeKind::TyI64 {
        return operand_ty
    }
    if is_integer_type(peer_ty) && peer_ty.kind != TypeKind::TyI64 {
        return peer_ty
    }
    operand_ty
}

// Float mirror of checker_narrow_literal_operand_ty. `i32 + 1` already worked
// because an i64 literal operand adopts a non-i64 integer peer; `f32 + 1.0` did
// not, because nothing adopted the float peer. Same asymmetry as the contextual
// path, one level down.
// The magnitude guard lives on the LET/ARG path (checker_expected_accepts_float_literal);
// here the literal is already bounded by having a f32 peer that type-checked.
fn checker_narrow_float_literal_operand_ty(operand_ty: TypeEntry, operand_was_float_lit: bool, peer_ty: TypeEntry) -> TypeEntry {
    if !operand_was_float_lit {
        return operand_ty
    }
    if operand_ty.kind != TypeKind::TyF64 {
        return operand_ty
    }
    if is_float_type(peer_ty) && peer_ty.kind != TypeKind::TyF64 {
        return peer_ty
    }
    operand_ty
}

// *mut ExprBinary handler (split-and-bridge): check the OPERANDS in place — so a nested
// enum path-expr (e.g. `c == Color::Red`) reaches checker_check_path_expr_inplace and
// dodges the by-value check_path_expr SRET crash — then bridge to the by-value op-typing
// tail (check_binary_with_operand_types), which is driven by the already-computed operand
// types and never re-checks operands, so it never recurses into check_path_expr.
fn checker_check_binary_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let left_ty = checker_check_opt_expr_inplace(c, e.left)
    let left_was_int_lit = (*c).last_literal_kind == 1
    let left_was_float_lit = (*c).last_literal_kind == 2
    (*c).last_literal_kind = 0
    let right_ty = checker_check_opt_expr_inplace(c, e.right)
    let right_was_int_lit = (*c).last_literal_kind == 1
    let right_was_float_lit = (*c).last_literal_kind == 2
    (*c).last_literal_kind = 0
    let narrowed_left = checker_narrow_literal_operand_ty(left_ty, left_was_int_lit, right_ty)
    let narrowed_right = checker_narrow_literal_operand_ty(right_ty, right_was_int_lit, left_ty)
    let narrowed_left_f = checker_narrow_float_literal_operand_ty(narrowed_left, left_was_float_lit, right_ty)
    let narrowed_right_f = checker_narrow_float_literal_operand_ty(narrowed_right, right_was_float_lit, left_ty)
    // Call the *mut tail (returns only TypeEntry) — NOT the by-value bridge, whose
    // (Checker, TypeEntry) return became a 12MB local held across this fn's recursion
    // → N-deep stack overflow on deeply-nested exprs. The tail is non-recursive.
    checker_check_binary_with_operand_types_inplace(c, e, narrowed_left_f, narrowed_right_f)
}


// *mut transcription of check_binary_with_operand_types (13983). Returns ONLY the TypeEntry
// so the RECURSIVE checker_check_binary_expr_inplace no longer holds a 12MB (Checker,
// TypeEntry) `pair` local across its operand recursion (that N-deep 12MB frame was the
// stack overflow on deeply-nested / algebra-heavy exprs). This tail is NOT recursive, so its
// own internal by-value bridges (one Checker frame at a time) are fine. Faithful to the
// by-value original: same order, same error codes, same result TypeEntry per branch.
fn checker_check_binary_op_types_inplace(c: *mut Checker, span: Span, op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) with Mut, Panic, Div, Alloc, IO {
    if is_error_or_unknown(left_ty) || is_error_or_unknown(right_ty) {
        return
    }
    match op {
        BinaryOp::OpBitAnd => {
            if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 48, 0, 0, 0)
            }
        }
        BinaryOp::OpBitOr => {
            if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 48, 0, 0, 0)
            }
        }
        BinaryOp::OpBitXor => {
            if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 48, 0, 0, 0)
            }
        }
        BinaryOp::OpShl => {
            if !is_integer_type(left_ty) {
                checker_report_error_at_inplace(c, span, 49, 0, 0, 0)
            }
            if !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 49, 0, 0, 0)
            }
        }
        BinaryOp::OpShr => {
            if !is_integer_type(left_ty) {
                checker_report_error_at_inplace(c, span, 49, 0, 0, 0)
            }
            if !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 49, 0, 0, 0)
            }
        }
        BinaryOp::OpRem => {
            if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                checker_report_error_at_inplace(c, span, 50, 0, 0, 0)
            }
        }
        BinaryOp::OpAnd => {
            if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                checker_report_error_at_inplace(c, span, 51, 0, 0, 0)
            }
        }
        BinaryOp::OpOr => {
            if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                checker_report_error_at_inplace(c, span, 51, 0, 0, 0)
            }
        }
        _ => { }
    }
}

fn checker_finish_binary_units_inplace(c: *mut Checker, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry, result: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let lu = left.unit_id
    let ru = right.unit_id
    if lu < 0 && ru < 0 {
        return result
    }
    let pair = (*c).check_binary_units(span, op, left, right, result)
    checker_store_from_value(c, pair.0)
    pair.1
}

fn checker_check_binary_with_operand_types_inplace(c: *mut Checker, e: Expr, left_ty: TypeEntry, right_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if left_ty.kind == TypeKind::TyUnobserved || right_ty.kind == TypeKind::TyUnobserved {
        let is_cmp = e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
            || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
            || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
        if is_cmp {
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, 13) {
                checker_report_error_at_inplace(c, e.span, 36, 0, 0, 0)
            }
        }
    }
    checker_check_binary_op_types_inplace(c, e.span, e.bin_op, left_ty, right_ty)
    // Feature B: Invariant<T,G> comparability gate. Two invariant observables may be
    // added/compared/ratioed only if the (conservative Homeo-default) frame relation
    // lies in the intersection of their groups — i.e. both must be Homeo-group until a
    // Lean frame-obligation is discharged. All lattice semantics live in check::invariance.
    let inv_l = invariant_group_rank_of_type(left_ty)
    let inv_r = invariant_group_rank_of_type(right_ty)
    if inv_l > 0 && inv_r > 0 {
        let inv_combine = e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpSub
            || e.bin_op == BinaryOp::OpMul || e.bin_op == BinaryOp::OpDiv || e.bin_op == BinaryOp::OpRem
            || e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
            || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
            || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
        // Same frame (Invariant<T,G,F> with matching F) ⇒ the relating transform is the
        // identity (DiffInf ∈ every group) ⇒ comparable at any group. Otherwise fall
        // back to the conservative cross-frame default (only Homeo-group comparable).
        let same_frame = compat_invariant_same_frame(left_ty, right_ty)
        // Per-call-site Lean obligation recording (emit-lean-obligations): record this
        // comparison's concrete groups, frame relation and outcome.
        if inv_combine {
            let comparable = if same_frame || invariant_comparable_default_ranks(inv_l, inv_r) { 1 } else { 0 }
            equiv_record_invariant(inv_l, inv_r, if same_frame { 1 } else { 0 }, comparable)
        }
        if inv_combine && !same_frame && !invariant_comparable_default_ranks(inv_l, inv_r) {
            checker_report_mismatch_inplace(c, e.span, 4, left_ty, right_ty)
        }
    }
    // Hypercomplex operands (Octonion/Sedenion/Quaternion/Clifford) are validated by the
    // check_hyper_binary dispatch below (algebra compatibility + non-associativity effects).
    // Skip the generic types_compatible mismatch, which would otherwise reject two hyper values
    // with a spurious E004 "cannot be combined" before hyper dispatch runs.
    let both_hyper = left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper
    // Same exemption, same reason, for IndepKnowledge. Two claims over the same
    // base type are deliberately INCOMPATIBLE as types -- `a ⊥ b | Z` is not
    // `c ⊥ d` and neither may be assigned to the other -- but both erase to T
    // under an operator, and binary_result_type unwraps them. Without this the
    // generic identity check rejects `a + b` between two different claims over
    // the same f64 before the unwrap ever runs.
    let either_cond_indep = left_ty.kind == TypeKind::TyCondIndep || right_ty.kind == TypeKind::TyCondIndep
    if !both_hyper && !either_cond_indep && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) && !types_compatible(left_ty, right_ty) {
        let is_arith = e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpSub
            || e.bin_op == BinaryOp::OpMul || e.bin_op == BinaryOp::OpDiv || e.bin_op == BinaryOp::OpRem
        let is_cmp = e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
            || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
            || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
        if is_arith || is_cmp {
            checker_report_mismatch_inplace(c, e.span, 4, left_ty, right_ty)
        }
    }
    if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
        let left_inner = if is_knowledge_type(left_ty) { knowledge_inner(left_ty) } else { left_ty }
        let right_inner = if is_knowledge_type(right_ty) { knowledge_inner(right_ty) } else { right_ty }
        if left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
            let hc = check_hyper_binary(*c, e.span, e.bin_op, left_inner, right_inner)
            checker_store_from_value(c, hc.0)
        }
        // Knowledge (x) Knowledge arithmetic typechecks here but has no lowering:
        // lower_binary_expr_ref (ir/lower.sio) has no Knowledge arm, so both
        // operands lower as scalars -- and a Knowledge operand lowers to the
        // object handle. `kA * kB` therefore multiplies two pointers, and
        // `.value` on the result dereferences an arbitrary address. Measured on
        // Madaros: `*` returns the right operand's value (silently wrong), while
        // `+`, `-` and `/` segfault at runtime. Refuse it rather than answer
        // wrongly. The mixed Knowledge/scalar forms are already refused above,
        // and lean_single implements all of this correctly -- see #1706.
        let kk_both = is_knowledge_type(left_ty) && is_knowledge_type(right_ty)
        let kk_arith = e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpSub
            || e.bin_op == BinaryOp::OpMul || e.bin_op == BinaryOp::OpDiv
            || e.bin_op == BinaryOp::OpRem
        // Hypercomplex inners take the check_hyper_binary path above, so spare them
        // rather than refuse on an untested guess. Measured caveat: this guard is
        // narrower than it looks. `Knowledge<Octonion>` built from the
        // algebra::octonion STRUCT does not carry TyHyper inners, so it does NOT
        // take this exemption and IS refused below -- correctly, since it has no
        // lowering either. What the guard actually spares is only inners the
        // checker itself classifies as TyHyper, and that case remains unmeasured.
        let kk_hyper = left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper
        if kk_both && kk_arith && !kk_hyper {
            checker_report_error_at_inplace(c, e.span, 245, 0, 0, 0)
        }
        // Third axis of anti-garbling (formal/lean4/EpistemicEffectsNSA.lean §J-§K). The
        // product's variance is propagated by the GUM shortcut Var(x*y) = |y|^2 Var x +
        // |x|^2 Var y (knowledge_binary_result -> epsilon_combine_relative). That formula
        // silently imposes |xy| = |x||y| -- norm multiplicativity -- which holds exactly on
        // the composition algebras R, C, H, O (`norm_mult_of_polarBasis`, levels <= 3) and is
        // FALSE from the sedenions up (`not_polarBasis4`; `sed_shortcut_understates`: reported
        // 4, true first-order variance 8, with disjoint sources and no re-association). So a
        // Knowledge<Hyper<Sedenion|Clifford, _>> product would fabricate precision that NS
        // (E230) cannot see. Refuse it: E251. Addition is unaffected (no norm identity).
        if kk_both && kk_hyper && e.bin_op == BinaryOp::OpMul
            && (left_inner.algebra_kind >= 4 || right_inner.algebra_kind >= 4) {
            checker_report_error_at_inplace(c, e.span, 251, 0, 0, 0)
        }
        let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty, (*c).ns_table)
        if knowledge_result.kind == TypeKind::TyError {
            checker_report_error_at_inplace(c, e.span, 36, 0, 0, 0)
        }
        // N3: anti-garbling gate. An independence-assuming op over operands whose
        // noise-symbol sets are not provably disjoint understates variance -- E230.
        if checker_ns_should_refuse((*c).ns_table, e.bin_op, left_ty, right_ty) {
            checker_report_error_at_inplace(c, e.span, 230, 0, 0, 0)
        }
        let final_result = checker_finish_binary_units_inplace(c, e.span, e.bin_op, left_ty, right_ty, knowledge_result)
        if e.bin_op == BinaryOp::OpMul && left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
            let final_inner = if final_result.kind == TypeKind::TyKnowledge {
                knowledge_inner(final_result)
            } else {
                final_result
            }
            if final_inner.kind == TypeKind::TyHyper {
                let rh = (*c).record_hyper_expr(e.span, final_inner.algebra_kind, 1, true)
                checker_store_from_value(c, rh)
            }
        }
        return final_result
    }
    if left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper {
        let hr = check_hyper_binary(*c, e.span, e.bin_op, left_ty, right_ty)
        checker_store_from_value(c, hr.0)
        let typed_result = hr.1
        let final_result = checker_finish_binary_units_inplace(c, e.span, e.bin_op, left_ty, right_ty, typed_result)
        if e.bin_op == BinaryOp::OpMul && final_result.kind == TypeKind::TyHyper {
            let rh = (*c).record_hyper_expr(e.span, final_result.algebra_kind, 1, false)
            checker_store_from_value(c, rh)
        }
        return final_result
    }
    var result = binary_result_type(e.bin_op, left_ty, right_ty)
    if result.kind == TypeKind::TyError && (e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe) {
        let l_enum = left_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, left_ty.name) >= 0
        let r_enum = right_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, right_ty.name) >= 0
        if (l_enum && is_numeric_type(right_ty)) || (is_numeric_type(left_ty) && r_enum) {
            result = ty_bool()
        }
    }
    // Type-directed == lift (warn-only): boolean equality on the stdlib uncertain
    // scalar (a struct literally named "Epistemic") ignores uncertainty. Result
    // stays bool — no semantic change. "Epistemic" = E p i s t e m i c (9 chars).
    if result.kind == TypeKind::TyBool && (e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe) {
        let l_ep = left_ty.kind == TypeKind::TyNamed && name_matches_str9(left_ty.name, 69, 112, 105, 115, 116, 101, 109, 105, 99)
        let r_ep = right_ty.kind == TypeKind::TyNamed && name_matches_str9(right_ty.name, 69, 112, 105, 115, 116, 101, 109, 105, 99)
        if l_ep || r_ep {
            checker_report_warning_at_mut(c, e.span, 43, 0, 0, 0)
        }
    }
    if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
        checker_report_mismatch_inplace(c, e.span, 4, left_ty, right_ty)
    }
    if e.bin_op == BinaryOp::OpDiv {
        let denom_pair = checker_eval_const_int_opt_expr_mut(c, e.right)
        if denom_pair.0 != 0 && denom_pair.1 == 0 {
            checker_report_error_at_inplace(c, e.span, 56, 0, 0, 0)
        }
    } else if e.bin_op == BinaryOp::OpRem {
        let denom_pair = checker_eval_const_int_opt_expr_mut(c, e.right)
        if denom_pair.0 != 0 && denom_pair.1 == 0 {
            checker_report_error_at_inplace(c, e.span, 57, 0, 0, 0)
        }
    }
    checker_finish_binary_units_inplace(c, e.span, e.bin_op, left_ty, right_ty, result)
}

fn checker_check_opt_block_inplace(c: *mut Checker, opt: Option<Box<Block> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(blk) => checker_check_block_inplace(c, *blk)
        None => ty_unit()
    }
}

// *mut ExprIf handler — FULL transcription of check_if_expr (16122), not a bridge: the
// condition, then-block, AND else are all checked via the *mut spine so a nested enum
// path-expr anywhere in an `if … else if …` chain reaches checker_check_path_expr_inplace
// and dodges the by-value check_path_expr SRET crash. The non-recursive work (bool check,
// condition narrowing, branch-type compat) is faithful to the by-value original.
// ============================================================
// Branch-aware merge of linear consumption
//
// A linear value must be consumed on EVERY path, so the two arms of an `if` are
// alternatives, not a sequence. Threading them sequentially -- what happens
// without these three calls -- is wrong in both directions:
//
//   if c { use(t) } else { use(t) }   E039, though sound (the else-arm
//                                     inherited the then-arm's consumption)
//   if c { use(t) }                   accepted, though `t` survives unconsumed
//                                     on the implicit else path
//
// These mutate (*c).borrows fields in place rather than going through BorrowEnv
// methods. Two other shapes were built and measured and neither is usable:
// by-value `self -> BorrowEnv` methods (three aggregate round-trips per `if`),
// and `&!BorrowEnv` methods (mutations never land; reaching one through a
// pointer segfaults).
// ============================================================

// Record the on-entry `consumed` state for this branch level.
fn checker_branch_enter_inplace(c: *mut Checker) with Mut, Panic, Div, Alloc, IO {
    let d = (*c).borrows.branch_depth
    (*c).borrows.branch_depth = d + 1
    // Beyond the tracked nesting depth the counter stays balanced but nothing is
    // stored; the merge then leaves state alone, degrading to the old sequential
    // behaviour rather than merging against a stale snapshot.
    if d < MAX_BRANCH_LEVELS {
        var i: i64 = 0
        while i < (*c).borrows.count {
            (*c).borrows.branch_snap[i * MAX_BRANCH_SNAP + 2 * d] = (*c).borrows.entries[i].consumed
            i = i + 1
        }
    }
}

// Stash the end-of-then-arm state and rewind to the on-entry state, so the
// else-arm is checked from the same starting point the then-arm had.
fn checker_branch_then_done_inplace(c: *mut Checker) with Mut, Panic, Div, Alloc, IO {
    let d = (*c).borrows.branch_depth - 1
    if d >= 0 && d < MAX_BRANCH_LEVELS {
        var i: i64 = 0
        while i < (*c).borrows.count {
            (*c).borrows.branch_snap[i * MAX_BRANCH_SNAP + 2 * d + 1] = (*c).borrows.entries[i].consumed
            // Whole-element read-modify-write. Assigning THROUGH a nested place --
            // `(*c).borrows.entries[i].consumed = ...`, i.e. deref -> field -> index ->
            // field -- is not resolved by the lean_single front end, which is the seed
            // that builds Madaros. It reports `unknown identifier consumed` and the
            // emitted store lands somewhere else in the Checker (issue #1471). The rest
            // of this file already uses this idiom for the same reason; see the
            // TypeEnv.bindings update in checker_env_mark_mutable_inplace.
            var be_rewind = (*c).borrows.entries[i as usize]
            be_rewind.consumed = (*c).borrows.branch_snap[i * MAX_BRANCH_SNAP + 2 * d]
            (*c).borrows.entries[i as usize] = be_rewind
            i = i + 1
        }
    }
}

// Combine the two arms and report values consumed on only one path. A linear
// binding is consumed after the `if` only if BOTH arms consumed it; if exactly
// one did, its fate depends on a runtime condition, which linearity forbids.
fn checker_merge_if_branches_inplace(c: *mut Checker) with Mut, Panic, Div, Alloc, IO {
    let d = (*c).borrows.branch_depth - 1
    if d < 0 {
        return
    }
    (*c).borrows.branch_depth = d
    if d >= MAX_BRANCH_LEVELS {
        return
    }
    var mismatch: i64 = 0
    var i: i64 = 0
    while i < (*c).borrows.count {
        if (*c).borrows.entries[i].is_linear && !(*c).borrows.branch_snap[i * MAX_BRANCH_SNAP + 2 * d] {
            let then_consumed = (*c).borrows.branch_snap[i * MAX_BRANCH_SNAP + 2 * d + 1]
            let else_consumed = (*c).borrows.entries[i].consumed
            var be_merge = (*c).borrows.entries[i as usize]
            if then_consumed != else_consumed {
                mismatch = mismatch + 1
                be_merge.consumed = true
            } else {
                be_merge.consumed = then_consumed
            }
            (*c).borrows.entries[i as usize] = be_merge
        }
        i = i + 1
    }
    if mismatch > 0 {
        (*c).had_error = true
        (*c).error_count = (*c).error_count + 1
        (*c).diag_emitted = true
        print("error[E040]: linear value not consumed on every path (")
        print_int(mismatch)
        print(" value(s) consumed in one branch only)\n")
        print("   = help: a linear value must be consumed on both branches of an `if`, or on neither\n")
        print("   = note: linear types enforce single-use semantics for resources\n")
    }
}

// ============================================================
// N2 env-φ fix (codex ruling 2026-08-23, round 3): the env-merge site.
// ============================================================
//
// grok-4.6's round-3 finding: a Knowledge var REASSIGNED inside an if/match
// branch is not ns-union'd (or forced to top) across the merge --
// checker_merge_if_branches_inplace above only merges LINEAR-CONSUME flags,
// never a binding's noise_set_id, and there was no TypeEnv snapshot/merge
// machinery at all (unlike (*c).borrows' branch_snap array). Worse: the
// reassignment inside the branch does not even SURVIVE past the branch's own
// block scope -- checker_check_block_inplace push_scope()s on entry and
// pop_scope()s on exit around every block, including if/else arms and match
// arm bodies, and pop_scope only rewinds env.count back to the scope's
// starting count; it does not (and structurally cannot, from outside that
// generic, reused block-checking function) hand back what happened inside.
// So `var x = measure(1); if c { x = measure(2) }` left x's env entry
// completely untouched by the branch -- not "then-branch-wins", literally
// AS IF the reassignment never happened, once you're back outside the `if`.
//
// The fix does NOT try to diff per-branch env snapshots (infeasible without
// invasively changing the generic block-checker used everywhere): it
// implements the codex-sanctioned sound fallback -- any TyKnowledge binding
// reassigned anywhere inside a branch is forced to top (-1) once merge sees
// it again in the surviving outer scope. Mechanism: ns_branch_depth (>0
// means "inside some if/match branch body", independent of the borrow
// system's own branch_depth since match arms never touch that one) gates
// checker_check_assign_stmt_inplace into recording the reassigned NAME
// (ns_reassigned_names/_count) instead of writing a rebind that would just
// be discarded; checker_merge_ns_reassigned_inplace, called at every if/
// match merge point (both with and without an else-arm), looks each
// recorded name up in the NOW-restored outer scope and re-binds it there
// with noise_set_id forced to top. The list is flat (not per-nesting-level
// stacked) and only cleared once ns_branch_depth returns to 0: a nested
// if's own merge forces a name to top in ITS still-branch-nested scope, and
// the enclosing merge forces it again one scope further out when it exits
// -- forcing top twice is idempotent, so this needs no nesting-aware
// bookkeeping to be correct.
fn checker_ns_branch_enter_inplace(c: *mut Checker) with Mut, Panic, Div {
    (*c).ns_branch_depth = (*c).ns_branch_depth + 1
}

fn checker_merge_ns_reassigned_inplace(c: *mut Checker) with Mut, Panic, Div, IO {
    if (*c).ns_branch_depth > 0 {
        (*c).ns_branch_depth = (*c).ns_branch_depth - 1
    }
    if checker_ns_sabotage_join() {
        // Per-rule negative control: skip the env-merge entirely, so a
        // branch-reassigned Knowledge var reverts to whatever the block's
        // own pop_scope left behind -- the pre-fix fail-open bug, reproduced
        // on demand. Still clear the list at depth 0 so it cannot leak into
        // a later, unrelated if/match.
        if (*c).ns_branch_depth == 0 {
            (*c).ns_reassigned_count = 0
            (*c).ns_reassigned_overflow = false
        }
        return
    }
    var i: i64 = 0
    while i < (*c).ns_reassigned_count {
        let nm = (*c).ns_reassigned_names[i as usize]
        let cur_ty = (*c).env.lookup(nm)
        if cur_ty.kind == TypeKind::TyKnowledge {
            var forced = cur_ty
            forced.noise_set_id = 0 - 1
            (*c).env = (*c).env.bind(nm, forced, true)
            checker_ns_trace_emit("env_join", forced.noise_set_id)
        }
        i = i + 1
    }
    if (*c).ns_branch_depth == 0 {
        // Overflow fallback: the recorded-name list could not hold every
        // branch-reassigned Knowledge var, so re-forcing by name is
        // insufficient. Force EVERY live TyKnowledge binding to top -- sound
        // over-approximation (some never-reassigned vars are widened too, but
        // never wrongly narrowed). Only at the outermost merge, before clear.
        if (*c).ns_reassigned_overflow {
            var j: i64 = 0
            while j < (*c).env.count {
                var b = (*c).env.bindings[j as usize]
                if b.ty.kind == TypeKind::TyKnowledge && b.ty.noise_set_id != (0 - 1) {
                    b.ty.noise_set_id = 0 - 1
                    (*c).env.bindings[j as usize] = b
                    checker_ns_trace_emit("env_join_overflow", 0 - 1)
                }
                j = j + 1
            }
            (*c).ns_reassigned_overflow = false
        }
        (*c).ns_reassigned_count = 0
    }
}

fn checker_check_if_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let cond_ty = checker_check_opt_expr_inplace(c, e.left)
    // Condition must be bool (skip E006 when the condition already failed typechecking).
    if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
        let cond_is_cmp = match e.left {
            Some(cond_box) => {
                let cond_expr = *cond_box
                cond_expr.bin_op == BinaryOp::OpEq || cond_expr.bin_op == BinaryOp::OpNe
                    || cond_expr.bin_op == BinaryOp::OpLt || cond_expr.bin_op == BinaryOp::OpLe
                    || cond_expr.bin_op == BinaryOp::OpGt || cond_expr.bin_op == BinaryOp::OpGe
            }
            None => false
        }
        if !cond_is_cmp {
            checker_report_mismatch_inplace(c, e.span, 6, ty_bool(), cond_ty)
        }
    }
    // Condition narrowing (mirrors check_if_expr: push a refinement guard for the then-branch)
    let saved_cond_env = (*c).refine_cond_env
    let cond_guard = if_cond_extract_pred(e.left)
    if cond_guard.0 != 0 {
        (*c).refine_cond_env = refine_static_env_push((*c).refine_cond_env, cond_guard.1)
    }
    checker_branch_enter_inplace(c)
    checker_ns_branch_enter_inplace(c)
    let then_ty = checker_check_opt_block_inplace(c, e.block)
    checker_branch_then_done_inplace(c)
    (*c).refine_cond_env = saved_cond_env
    // The `match` stays the TAIL expression and the merge is called from inside
    // each arm: hoisting it into `let result = match { ... }` with trailing
    // statements is a shape this compiler miscompiles.
    match e.else_expr {
        Some(else_e) => {
            // NOTE: only ONE checker_ns_branch_enter_inplace call covers this
            // whole if-statement (called once, above, before the then-block)
            // -- ns_branch_depth counts "inside this if-statement's branch
            // context" per STATEMENT, not per arm, so checker_merge_ns_
            // reassigned_inplace's single decrement below balances it
            // exactly. A second enter here would double-count against that
            // one decrement and leave ns_branch_depth permanently elevated.
            let else_ty = checker_check_expr_inplace(c, *else_e)
            (*c).refine_cond_env = saved_cond_env
            if !checker_types_compatible_inplace(c, then_ty, else_ty) {
                checker_report_mismatch_inplace(c, e.span, 7, then_ty, else_ty)
            }
            checker_merge_if_branches_inplace(c)
            // N2 CFG join (codex ruling 2026-08-23, closes the missing-join
            // gap grok-4.6 flagged): `if c {measure(1)} else {measure(2)}`
            // must not silently keep only the then-branch's noise_set_id.
            // ns_union already treats a negative (top/unknown) operand as
            // absorbing (REQ-4), so this single call gives exactly "union of
            // the incoming known IDs; top if either incoming is top".
            // SOUNIO_NS_SABOTAGE_JOIN=1 skips the union, reproducing the
            // pre-fix "one branch" bug as the per-rule negative control.
            var joined = then_ty
            if then_ty.kind == TypeKind::TyKnowledge && else_ty.kind == TypeKind::TyKnowledge {
                if !checker_ns_sabotage_join() {
                    joined.noise_set_id = ns_union(&!(*(*c).ns_table), then_ty.noise_set_id, else_ty.noise_set_id)
                }
                checker_ns_trace_emit("if_join", joined.noise_set_id)
            }
            // env-φ (round 3): force top on any Knowledge var REASSIGNED
            // inside either branch, in the now-restored outer scope. This is
            // the RESULT-value join above's counterpart for BINDINGS -- two
            // different fail-open holes, both closed at this same merge point.
            checker_merge_ns_reassigned_inplace(c)
            joined
        }
        None => {
            // No else-arm: nothing is consumed on that path, which is what
            // branch_then_done rewound to, so the merge flags a value the
            // then-arm consumed.
            (*c).refine_cond_env = saved_cond_env
            checker_merge_if_branches_inplace(c)
            // env-φ (round 3): a bare `if c { x = measure(2) }` -- codex's
            // OWN literal example -- has no else-arm to union against, but
            // still needs x forced to top: the implicit else path never
            // reassigned it, so ns_branch_depth is still 1 here (only the
            // then-side ever called checker_ns_branch_enter_inplace) and
            // this call correctly decrements it back to 0 and clears the list.
            checker_merge_ns_reassigned_inplace(c)
            ty_unit()
        }
    }
}

// *mut ExprWhile handler — FULL transcription of check_while_expr (16436), not a bridge:
// the condition and the loop body block are both checked via the *mut spine so a nested
// enum path-expr anywhere in the condition or body reaches checker_check_path_expr_inplace
// and dodges the by-value check_path_expr/check_while_expr SRET crash (the ~164KB Checker
// self-move that bin/souc miscompiles). The non-recursive work — bool check on the
// condition, the inlined check_loop_depth limit, loop_depth inc/dec, and the
// release_exclusive_borrows before the body — is faithful to the by-value original.
// While is SIMPLER than if: it has NO refine_cond_env narrowing, so none is added here.
fn checker_check_while_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // Condition (via the *mut spine). Must be bool.
    let cond_ty = checker_check_opt_expr_inplace(c, e.left)
    if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
        checker_report_mismatch_inplace(c, e.span, 6, ty_bool(), cond_ty)
    }
    // Inlined check_loop_depth (6763): read loop_depth BEFORE incrementing; on
    // over-limit, emit E062 and bail with ty_error(), touching nothing else.
    if (*c).loop_depth >= MAX_LOOP_DEPTH {
        checker_report_error_at_inplace(c, e.span, 62, (*c).loop_depth, MAX_LOOP_DEPTH, 0)
        return ty_error()
    }
    (*c).loop_depth = (*c).loop_depth + 1
    // Release exclusive borrows before checking the loop body. In a while loop each
    // iteration may re-borrow the same variables; without this the second iteration
    // would fail because the first iteration's exclusive borrows are still active.
    (*c).borrows = (*c).borrows.release_exclusive_borrows()
    // env-φ loop widen (codex ruling 2026-08-23, round 4 -- grok-4.6 measured
    // this as a REAL fail-open, not theoretical: `var x=measure(1); while
    // ... {x=x+measure(2)}; let y=x+x` traced union=1 after the loop, i.e.
    // x silently reverted to {s1} -- the SAME block-scope-pop-discards-the-
    // rebind hole as if/match, just not yet closed for loop bodies. A loop
    // body runs 0+ times and accumulates, so the sound post-loop value for
    // ANY Knowledge var reassigned in the body is TOP -- identical hammer to
    // if/match, deliberately NOT a per-binding fixpoint union (no such pass
    // exists, or is being added, here).
    checker_ns_branch_enter_inplace(c)
    // Loop body block (via the *mut spine; its type is discarded, exactly as the
    // by-value original discards body_pair.1).
    let _body_ty = checker_check_opt_block_inplace(c, e.block)
    checker_merge_ns_reassigned_inplace(c)
    (*c).loop_depth = (*c).loop_depth - 1
    ty_unit()
}

// *mut transcription of check_for_in_expr (18227). It had NO in-place case (unlike ExprWhile),
// so a `for` loop fell to the by-value bridge → 8MB Checker copy, then the loop BODY checked by
// value → a body containing a CALL re-copied the Checker per sub-expr → stack smash (the
// seq_borrow survivor: `for i in 0..n { eq(&bag.items[i], needle) }`). Here the body is checked
// in place (checker_check_opt_block_inplace). Faithful to the by-value original (no loop-depth
// limit on for-in; body type discarded).
fn checker_check_for_in_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let _iter_ty = checker_check_opt_expr_inplace(c, e.left)
    (*c).env = (*c).env.push_scope()
    (*c).borrows = (*c).borrows.push_scope()
    checker_push_const_scope_inplace(c)
    (*c).env = (*c).env.bind(e.name, ty_i64(), false)
    (*c).loop_depth = (*c).loop_depth + 1
    (*c).borrows = (*c).borrows.release_exclusive_borrows()
    // env-φ loop widen (codex ruling 2026-08-23, round 4) -- see the matching
    // comment in checker_check_while_expr_inplace. A `for` body runs 0+
    // times exactly like `while`, so the same top-widen hammer applies.
    //
    // IMPORTANT (found while verifying this fix, not while writing it): the
    // merge call must run AFTER (*c).env.pop_scope() below, not before it --
    // unlike checker_check_while_expr_inplace, this function pushes its OWN
    // outer scope (for the loop variable `e.name`) around the whole body,
    // one level further out than the body block's own push/pop. Calling the
    // merge before that outer pop_scope writes the forced-top rebind into
    // the loop-variable's scope, which the very next line then discards --
    // the identical bug one level deeper. Verified by trace: with the merge
    // called too early, env_join=-1 fired (the merge DID run) but a
    // subsequent read of the reassigned var after the loop still saw the
    // stale pre-loop handle -- the merge's own write was thrown away before
    // it could be read back.
    checker_ns_branch_enter_inplace(c)
    let _body_ty = checker_check_opt_block_inplace(c, e.block)
    (*c).loop_depth = (*c).loop_depth - 1
    checker_pop_const_scope_inplace(c)
    (*c).borrows = (*c).borrows.pop_scope()
    (*c).env = (*c).env.pop_scope()
    checker_merge_ns_reassigned_inplace(c)
    ty_unit()
}

fn checker_check_block_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    checker_check_opt_block_inplace(c, e.block)
}

// *mut ExprArrayLit handler — FULL transcription of check_array_lit (16637) and its
// recursive helpers check_array_elems (16669) / check_array_rest (16690). All element
// (and the repeat-form elem + count) sub-expressions are checked via the *mut spine so a
// nested enum path-expr / call / if anywhere inside an array literal reaches the *mut
// handlers and dodges the by-value check_path_expr / check_call SRET crash. The two
// recursive Checker-copying helpers (check_array_elems/check_array_rest) are replaced by a
// single ITERATIVE while-loop over the ExprList (mirroring check_tuple_elems @16719) so no
// per-element by-value Checker copy ever occurs. The non-recursive tail logic
// (count-type-compat check, IntLit-literal check, element-type unification) is faithful to
// the by-value originals: same error codes (20), same spans, same TypeEntry returns.
fn checker_check_array_lit_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // ---- Repeat form: [elem; count] ----------------------------------------
    // Original (check_array_lit 16638): triggers only when BOTH e.left (elem) and
    // e.right (count) are present.
    match e.left {
        Some(elem_box) => match e.right {
            Some(count_box) => {
                // Route elem and count through the *mut spine (faithful to the two
                // self.check_expr calls in the original, in the same left-then-right order).
                let elem_ty = checker_check_expr_inplace(c, *elem_box)
                let count_ty = checker_check_expr_inplace(c, *count_box)
                let count_e = *count_box
                // count must be i64
                if !types_compatible(count_ty, ty_i64()) {
                    checker_report_mismatch_inplace(c, count_e.span, 20, ty_i64(), count_ty)
                    return ty_array(elem_ty, 0)
                }
                // count must be an integer literal
                if count_e.kind != ExprKind::ExprIntLit {
                    checker_report_error_at_inplace(c, count_e.span, 20, 0, 0, 0)
                    return ty_array(elem_ty, 0)
                }
                return ty_array(elem_ty, count_e.int_val)
            }
            None => ()
        }
        None => ()
    }

    // ---- List form: [a, b, c, ...] -----------------------------------------
    // Original: check_array_elems (16669) checks the FIRST element to fix the expected
    // element type, then check_array_rest (16690) checks each remaining element and reports
    // a mismatch (code 20, span = that element's head.span) against the first element's
    // type. Empty list => (ty_error, count 0). Replicated here as one iterative loop
    // (no recursive Checker copies).
    var first_ty = ty_error()
    var count: i64 = 0
    var cur = e.args
    var have_first = false
    var done = false
    while !done {
        match cur {
            Some(list) => {
                let elem_ty = checker_check_expr_inplace(c, (*list).head)
                if !have_first {
                    first_ty = elem_ty
                    have_first = true
                } else {
                    if !types_compatible(elem_ty, first_ty) {
                        checker_report_mismatch_inplace(c, (*list).head.span, 20, first_ty, elem_ty)
                    }
                }
                count = count + 1
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    // Faithful to check_array_elems: empty literal yields ty_error element type, count 0.
    ty_array(first_ty, count)
}


// *mut ExprUnary handler — FULL transcription of check_unary_expr (13491). The operand
// (and, for the slice-borrow form, the index base and the range start/end) are checked
// via the *mut spine so a nested enum path-expr / call / if inside the operand reaches the
// *mut handlers and dodges the by-value check_path_expr / check_call SRET crash (the ~164KB
// Checker self-move bin/souc miscompiles). The non-recursive work — unary_result_type
// op-typing (E005 on bad operand), and &x / &!x borrow tracking via the BorrowEnv methods —
// is faithful to the by-value original: same error codes (5, and the 37/38 conflict codes
// returned by try_shared_borrow/try_exclusive_borrow), same spans, same TypeEntry returns.
// The half-open slice-borrow special case (&arr[a..b]) is delegated to a sibling *mut
// transcription of check_slice_borrow_expr so its sub-expressions also route through the
// spine. unary_result_type / slice_borrow_result_type / unary_operand_name are pure helpers
// (TypeEntry/Name in, TypeEntry/Name out — no Checker copy), so they are called directly.
fn checker_check_unary_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // Half-open slice borrow: &arr[a..b] / &!arr[a..b]
    if (e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut) && expr_is_half_open_range(e.left) {
        return checker_check_slice_borrow_expr_inplace(c, e)
    }
    // Operand via the *mut spine (faithful to self.check_opt_expr(e.left)).
    let operand_ty = checker_check_opt_expr_inplace(c, e.left)
    // Op-typing (pure helper).
    let result = unary_result_type(e.un_op, operand_ty)
    if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
        checker_report_error_at_inplace(c, e.span, 5, 0, 0, 0)
    }
    // Borrow checking for &x / &!x on a named variable.
    if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
        let borrow_name = unary_operand_name(e.left)
        if borrow_name.len > 0 {
            if e.un_op == UnaryOp::OpRef {
                let borrow_result = (*c).borrows.try_shared_borrow(borrow_name)
                (*c).borrows = borrow_result.0
                if borrow_result.1 != 0 {
                    checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
                }
            } else {
                let borrow_result = (*c).borrows.try_exclusive_borrow(borrow_name)
                (*c).borrows = borrow_result.0
                if borrow_result.1 != 0 {
                    checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
                }
            }
        }
    }
    result
}

// *mut transcription of check_slice_borrow_expr (13419): the index base (idx_expr.left)
// and the range start/end are all checked via the *mut spine. Faithful to the by-value
// original: same E013 (malformed slice-borrow) / E055 (non-integer range bound) error
// codes, same spans, same borrow tracking, same result TypeEntry. slice_borrow_result_type
// is a pure helper (TypeEntry in/out). On the outer-None and non-ExprIndex paths the
// original returns ty_error() after reporting E013.
fn checker_check_slice_borrow_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let want_mut = e.un_op == UnaryOp::OpRefMut
    let borrow_name = unary_operand_name(e.left)
    match e.left {
        Some(index_expr) => {
            let idx_expr = *index_expr
            if idx_expr.kind != ExprKind::ExprIndex {
                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
                return ty_error()
            }
            // Index base via the *mut spine (faithful to self.check_opt_expr(idx_expr.left)).
            let base_ty = checker_check_opt_expr_inplace(c, idx_expr.left)
            let result_ty = slice_borrow_result_type(base_ty, want_mut)
            if result_ty.kind == TypeKind::TyError && !is_error_or_unknown(base_ty) {
                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
            }
            match idx_expr.right {
                Some(range_expr) => {
                    if (*range_expr).kind != ExprKind::ExprRange || (*range_expr).bin_op != BinaryOp::OpRange {
                        checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
                    } else {
                        match (*range_expr).left {
                            Some(start_expr) => {
                                let start_ty = checker_check_expr_inplace(c, *start_expr)
                                if !is_error_or_unknown(start_ty) && !is_integer_type(start_ty) {
                                    checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), start_ty)
                                }
                            }
                            None => {
                                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
                            }
                        }
                        match (*range_expr).right {
                            Some(end_expr) => {
                                let end_ty = checker_check_expr_inplace(c, *end_expr)
                                if !is_error_or_unknown(end_ty) && !is_integer_type(end_ty) {
                                    checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), end_ty)
                                }
                            }
                            None => {
                                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
                            }
                        }
                    }
                }
                None => {
                    checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
                }
            }
            if borrow_name.len > 0 {
                if want_mut {
                    let borrow_result = (*c).borrows.try_exclusive_borrow(borrow_name)
                    (*c).borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
                    }
                } else {
                    let borrow_result = (*c).borrows.try_shared_borrow(borrow_name)
                    (*c).borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
                    }
                }
            }
            result_ty
        }
        None => {
            checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
            ty_error()
        }
    }
}

fn checker_expr_is_gpu_axis_root(e: Expr) -> bool with Mut, Panic, Div {
    e.kind == ExprKind::ExprIdent && name_eq(e.name, make_name("gpu"))
}

fn checker_expr_gpu_axis_base_kind(e: Expr) -> i64 with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprFieldAccess {
        match e.left {
            Some(base) => {
                if checker_expr_is_gpu_axis_root(*base) {
                    if name_eq(e.name, make_name("thread_id")) { return 1 }
                    if name_eq(e.name, make_name("block_id")) { return 2 }
                    if name_eq(e.name, make_name("block_dim")) { return 3 }
                }
            }
            None => {}
        }
    } else if e.kind == ExprKind::ExprMethodCall {
        match e.left {
            Some(base) => {
                if checker_expr_is_gpu_axis_root(*base) {
                    if name_eq(e.name, make_name("thread_id")) { return 1 }
                    if name_eq(e.name, make_name("block_id")) { return 2 }
                    if name_eq(e.name, make_name("block_dim")) { return 3 }
                }
            }
            None => {}
        }
    }
    0
}

fn checker_expr_is_gpu_axis_field(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind != ExprKind::ExprFieldAccess {
        return false
    }
    if !name_eq(e.name, make_name("x")) {
        return false
    }
    match e.left {
        Some(base) => checker_expr_gpu_axis_base_kind(*base) > 0,
        None => false,
    }
}

// *mut ExprFieldAccess handler — FULL transcription of check_field_access (13528), not a
// bridge. The ONLY sub-expression is the object (e.left); it is routed through the *mut
// spine via checker_check_opt_expr_inplace so a nested enum path-expr / binary / etc. in
// the object position reaches its in-place handler and dodges the by-value SRET crash.
// Everything else is a PURE READ: struct field-type lookup against (*c).structs, the
// Knowledge/Intervention/Counterfactual/Validated .value/.epsilon shapes (with the same
// `with Epistemic` effect-id-8 enforcement), Hyper component access, Tuple-by-index, and
// the error/unknown passthrough. Every `c = c.report_error_at(span, code, 0,0,0)` becomes a
// side-effecting checker_report_error_at_inplace(c, ...) call; every `(c, X)` tuple return
// becomes returning the TypeEntry X. Branch order, error codes, and per-case TypeEntry are
// byte-for-byte faithful to the by-value original. No (*c).expr_depth management here (the
// dispatch owns it).
fn checker_check_field_access_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if checker_expr_is_gpu_axis_field(e) {
        return ty_i64()
    }
    let base_ty = checker_check_opt_expr_inplace(c, e.left)
    if base_ty.kind == TypeKind::TyNamed {
        let struct_idx = struct_table_find((*c).structs, base_ty.name)
        if struct_idx >= 0 {
            let si = struct_table_get((*c).structs, struct_idx)
                    let field_ty = field_info_list_find(si.fields, e.name)
            if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            }
            field_ty
        } else {
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyKnowledge {
        // Knowledge<T> field access: .value -> T, .epsilon -> f64
        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
            // "value" = [118, 97, 108, 117, 101]
            // Epistemic enforcement: .value requires `with Epistemic` effect
            let epistemic_id: i64 = 8
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
            }
            knowledge_inner(base_ty)
        } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
            // "epsilon" = [101, 112, 115, 105, 108, 111, 110]
            ty_f64()
        } else if name_matches_str8(e.name, 118, 97, 114, 105, 97, 110, 99, 101) {
            // "variance" = [118, 97, 114, 105, 97, 110, 99, 101] — GUM sigma^2, IR field 1
            // (ir_register_knowledge_layout, lower.sio). UNGATED, matching lean_single:
            // only .value carries the `with Epistemic` gate (E170); .variance/.confidence
            // read the uncertainty channel itself, not the point estimate.
            ty_f64()
        } else if name_matches_str10(e.name, 99, 111, 110, 102, 105, 100, 101, 110, 99, 101) {
            // "confidence" = IR field 2 (ir_register_knowledge_layout).
            // NOT an alias of `.epsilon` at runtime under Madaros: `.epsilon` typechecks
            // as f64 but the lowering has no slot for it and reads 0.0, while lean_single
            // returns the confidence. That is a separate PRE-EXISTING silent wrong-value
            // defect (reproduced on both the unpatched and patched Madaros); `.confidence`
            // reads the correct value and is what the darwin_pbpk sources use.
            ty_f64()
        } else {
            checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyIntervention {
        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
            let epistemic_id: i64 = 8
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
            }
            knowledge_inner(base_ty)
        } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
            ty_f64()
        } else {
            checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyCounterfactual {
        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
            let epistemic_id: i64 = 8
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
            }
            knowledge_inner(base_ty)
        } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
            ty_f64()
        } else {
            checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyValidated {
        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
            let epistemic_id: i64 = 8
            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
            }
            knowledge_inner(base_ty)
        } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
            ty_f64()
        } else {
            checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyHyper {
        // Hyper field access: delegates to hyper.sio predicates
        // Complex: .real, .imag -> inner type
        // Quaternion: .w, .x, .y, .z -> inner type
        // Octonion: .e0.e7 -> inner type
        let alg = base_ty.algebra_kind
        let inner_ty = match base_ty.inner {
            Some(inner) => *inner
            None => ty_error()
        }
        // Complex fields
        if alg == 1 {
            // "real" = [114, 101, 97, 108], "imag" = [105, 109, 97, 103]
            if name_matches_str4(e.name, 114, 101, 97, 108) { inner_ty }
            else if name_matches_str4(e.name, 105, 109, 97, 103) { inner_ty }
            else {
                checker_report_no_field_inplace(c, e.span, e.name, base_ty)
                ty_error()
            }
        // Quaternion fields
        } else if alg == 2 {
            // .w .x .y .z (119, 120, 121, 122)
            if name_matches_str1(e.name, 119) { inner_ty }
            else if name_matches_str1(e.name, 120) { inner_ty }
            else if name_matches_str1(e.name, 121) { inner_ty }
            else if name_matches_str1(e.name, 122) { inner_ty }
            else {
                checker_report_no_field_inplace(c, e.span, e.name, base_ty)
                ty_error()
            }
        } else {
            // Octonion/Sedenion/Clifford: field access by component index
            // For now accept any short field name and return inner type
            inner_ty
        }
    } else if base_ty.kind == TypeKind::TyTuple {
        // Tuple field access by index (e.g. t.0, t.1, t.10)
        // The field name contains the index as ascii digits
        var idx: i64 = 0
        var di: i64 = 0
        while di < e.name.len && di < 8 {
            let ch = (e.name.buf[di as usize] as i64) - 48
            if ch < 0 || ch > 9 { break }
            idx = idx * 10 + ch
            di = di + 1
        }
        let tuple_count = type_entry_list_count(base_ty.tuple_elems)
        if idx >= tuple_count {
            checker_report_error_at_inplace(c, e.span, 47, 0, 0, 0)
            ty_error()
        } else {
            let elem = type_entry_list_get(base_ty.tuple_elems, idx)
            elem
        }
    } else if base_ty.kind == TypeKind::TyRef || base_ty.kind == TypeKind::TyRefMut {
        // name.buf[0] (TypeEntry byte 8 — within the *mut SRET window) holds the struct_idx
        // encoded by ty_ref_with_idx / ty_ref_mut_with_idx at signature-lowering time.
        // -1 means "not a struct ref" (primitive, slice, etc.) → return ty_error() silently.
        //
        // The packed index is a CACHE of a lookup done when the signature was
        // lowered, and it is only as good as the struct table was at that
        // moment. Resolve by the pointee's own name first, exactly as the
        // by-value twin at check_field_access has always done, and keep the
        // packed index only as the fallback for a pointee that is not named.
        // Trusting the index alone is what produced "no field guard on type
        // &MatchArm" against a MatchArm that has a guard: the printed type came
        // from `inner`, the fields came from whatever struct the stale index
        // happened to address.
        let ref_inner = call_ref_inner_or_self(base_ty)
        var struct_idx: i64 = -1
        if ref_inner.kind == TypeKind::TyNamed {
            struct_idx = struct_table_find((*c).structs, ref_inner.name)
        }
        if struct_idx < 0 {
            let dec_lo = (base_ty.name.buf[0] as i64 + 256) % 256
            let dec_hi = (base_ty.name.buf[1] as i64 + 256) % 256
            struct_idx = dec_lo + dec_hi * 256 - 1
        }
        if struct_idx >= 0 && struct_idx < (*(*c).structs).count {
            let si = struct_table_get((*c).structs, struct_idx)
            let field_ty = field_info_list_find(si.fields, e.name)
            if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                checker_report_no_field_inplace(c, e.span, e.name, base_ty)
            }
            field_ty
        } else {
            ty_error()
        }
    } else if is_error_or_unknown(base_ty) {
        base_ty
    } else {
        checker_report_no_field_inplace(c, e.span, e.name, base_ty)
        ty_error()
    }
}

// *mut ExprIndex handler — FULL transcription of check_index_expr (13659), not a bridge:
// the base (e.left) and index (e.right) sub-expressions are both checked via the *mut spine
// so a nested enum path-expr / call / if anywhere in `base[idx]` reaches the *mut handlers
// and dodges the by-value check_path_expr / check_call SRET crash (the ~164KB Checker
// self-move that bin/souc miscompiles). The tail is non-recursive: it never re-checks a
// sub-expression — it only inspects the already-computed base_ty / idx_ty via the free
// functions is_error_or_unknown / indexable_elem_type (neither takes a Checker), then emits
// E14 (non-i64 index) and E13 (not indexable) exactly as the by-value original, in the same
// order, with the same spans and TypeEntry returns. No scope push/pop, no borrow tracking,
// no loop_depth, no refine_cond_env — index has none. expr_depth is owned by the dispatch.
fn checker_check_index_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // Base then index, in left->right order (faithful to the by-value c threading:
    // base_pair = check_opt_expr(e.left); then idx_pair = c.check_opt_expr(e.right)).
    let base_ty = checker_check_opt_expr_inplace(c, e.left)
    let idx_ty = checker_check_opt_expr_inplace(c, e.right)
    // Index must be an integer type (E14). Non-returning: continues to the indexability check below.
    if !is_error_or_unknown(idx_ty) && !is_integer_type(idx_ty) {
        checker_report_error_at_inplace(c, e.span, 14, 0, 0, 0)
    }
    // Seq<T>[i] -> T. Inlined here (not only via indexable_elem_type) because the
    // free-function path was observed to still E013 on TyNamed("Seq") while the
    // method path's is_seq_type(base) succeeded on the same binding.
    if base_ty.kind == TypeKind::TyNamed {
        let bn = base_ty.name
        if bn.len == 3 && (bn.buf[0] as i64) == 83 && (bn.buf[1] as i64) == 101 && (bn.buf[2] as i64) == 113 {
            match base_ty.inner {
                Some(elem) => return *elem
                None => return ty_error()
            }
        }
    }
    let elem_ty = indexable_elem_type(base_ty)
    if !is_error_or_unknown(base_ty) && elem_ty.kind == TypeKind::TyError {
        // base is a concrete-but-not-indexable type (E13).
        checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
        ty_error()
    } else if is_error_or_unknown(base_ty) {
        // Propagate the base's error/unknown type unchanged.
        base_ty
    } else {
        // Indexable: yield the element type.
        elem_ty
    }
}

// *mut ExprMatch handler — FULL transcription of check_match_expr (16376) and its
// recursive helpers check_match_arms (16383) / check_match_arm (16396) /
// check_remaining_arms (16411). The scrutinee and every arm body are checked via the
// *mut spine so a nested enum path-expr / call / if anywhere in the scrutinee or any
// arm body reaches the *mut handlers (checker_check_path_expr_inplace et al.) and dodges
// the by-value check_path_expr / check_call SRET crash (the ~164KB Checker self-move
// that bin/souc miscompiles). The two recursive Checker-copying helpers
// (check_match_arms / check_remaining_arms) are replaced by a single ITERATIVE
// while-loop over the MatchArmList (mirroring checker_check_stmts_inplace's iterative
// transcription) so no per-arm by-value Checker copy ever occurs. The pattern binding
// (bind_pattern — a pure scope/env mutation that contains NO sub-expressions to re-check)
// is bridged once per arm via checker_bind_pattern_inplace (store-back). The non-recursive
// tail logic — first-arm type becomes the result, each remaining arm's body type compared
// for compatibility (error code 18 on the remaining arm's span) — is faithful to the
// by-value originals: same error code, same span, same TypeEntry returns. Empty arm list
// returns ty_unit() exactly as check_match_arms' None branch.
fn checker_check_match_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // Scrutinee via the *mut spine (faithful to check_match_expr's self.check_opt_expr(e.left)).
    let scrut_ty = checker_check_opt_expr_inplace(c, e.left)
    // Iterate the arm list. The FIRST arm's body type is the match result type
    // (check_match_arms' first_ty); each REMAINING arm's body type is compared against it
    // (check_remaining_arms). No arms => ty_unit() (check_match_arms' None branch).
    var cursor = e.arms
    var result_ty = ty_unit()
    var seen_first = false
    // env-φ (round 3): one enter covers the WHOLE match (all arms are
    // mutually exclusive branches of one construct, exactly like if/else's
    // single enter above) -- balanced by the single
    // checker_merge_ns_reassigned_inplace call after the arm loop below.
    checker_ns_branch_enter_inplace(c)
    while true {
        match cursor {
            Some(list) => {
                let arm = (*list).head
                let arm_ty = checker_check_match_arm_inplace(c, arm, scrut_ty)
                if !seen_first {
                    // First arm: its body type becomes the expected/result type.
                    result_ty = arm_ty
                    seen_first = true
                } else {
                    // Remaining arm: compare against the first arm's type (check_remaining_arms,
                    // code 18, span = this arm's span == (*list).head.span, expected = result_ty,
                    // got = arm_ty).
                    if !checker_types_compatible_inplace(c, arm_ty, result_ty) {
                        checker_report_mismatch_inplace(c, arm.span, 18, result_ty, arm_ty)
                    }
                    // N2 CFG join (codex ruling 2026-08-23, closes the missing-
                    // join gap grok-4.6 flagged): accumulate this arm's
                    // noise_set_id into the running result via ns_union -- same
                    // "union of the known IDs, top if either is top" semantics
                    // as the if/else join. Without this, result_ty silently
                    // kept only the FIRST arm's set forever. SOUNIO_NS_SABOTAGE_
                    // JOIN=1 skips the union, reproducing that pre-fix bug as
                    // the per-rule negative control.
                    if result_ty.kind == TypeKind::TyKnowledge && arm_ty.kind == TypeKind::TyKnowledge {
                        if !checker_ns_sabotage_join() {
                            result_ty.noise_set_id = ns_union(&!(*(*c).ns_table), result_ty.noise_set_id, arm_ty.noise_set_id)
                        }
                    }
                }
                cursor = (*list).tail
            }
            None => break
        }
    }
    if result_ty.kind == TypeKind::TyKnowledge {
        checker_ns_trace_emit("match_join", result_ty.noise_set_id)
    }
    // env-φ (round 3): force top on any Knowledge var reassigned inside any
    // arm, in the now-restored outer scope -- same counterpart-to-the-
    // result-value-join role as the if/else site.
    checker_merge_ns_reassigned_inplace(c)
    result_ty
}


// *mut ExprStructLit handler — FULL transcription of check_struct_lit (16614) and its
// recursive helpers: check_struct_field_inits / check_struct_field_inits_with_type (16723) /
// check_struct_field_inits_no_type (16740), plus the generic path check_generic_struct_lit
// (16633) / infer_type_params_from_fields (16642) / finalize_generic_struct_lit (16670).
// Every field-initializer sub-expr is checked via the *mut spine (checker_check_expr_inplace)
// so a nested enum path-expr / call / if inside any field init reaches the *mut leaf handlers
// and dodges the by-value check_path_expr / check_call ~164KB-self SRET crash. The two
// recursive Checker-copying field-init helpers are replaced by interleaved per-field
// lookup-then-check loops over the StructFieldList (no fixed-size array → no field truncation).
// The generic path is INLINED here (StructInfo obtained as a local via struct_table_get, NOT
// passed as a by-value arg into a new helper — large-struct-by-value arg passing is the crash
// model; the EnumInfo read in checker_check_path_expr_inplace proves the get-into-local form is
// safe). mangle_generic_name / monomorphize_fields are reused verbatim (pure free fns).
// NOTE: the generic leg's `struct_table_add((*c).structs, ...)` is now an in-place insert
// through the heap-indirect *mut StructTable — no whole-table SRET-store-back (the prior
// ~160KB store-back risk is gone). The mono add is idempotent-guarded by a prior find.
// Fidelity: codes 15 (not-found) / 16 (field compat) / 46 (count mismatch); returns
// ty_named(struct_name) | ty_named(mangled) | ty_error(); per-field order = lookup-then-check;
// count mismatch returns ty_named(struct_name) (NOT ty_error — the outer by-value wraps it so);
// generic-with-zero-type-params (args_list None edge, 16680) returns ty_error(); both generic
// passes check each field expr (faithful to the by-value double-check); no expr_depth mgmt.
fn checker_check_struct_lit_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let struct_name = checker_copy_string_list_to_name(e.path.segments)
    let struct_idx = struct_table_find((*c).structs, struct_name)
    if struct_idx >= 0 {
        let si = struct_table_get((*c).structs, struct_idx)
        if (*c).enforce_visibility && !checker_struct_visible_inplace(c, struct_idx) {
            checker_report_error_at_inplace(c, e.span, 176, 0, 0, 0)
        }
        if si.is_generic_template {
            // ---- Generic struct literal (inlined check_generic_struct_lit 16633) ----
            // Pass 1: infer type params from field initializers (infer_type_params_from_fields
            // 16642). Walk the field list via the *mut spine, recording each inferred type into
            // a per-template-param slot, exactly as the by-value original.
            var inferred = InferBuf { args: [ty_error(); 8] }
            var cur_inf = e.fields
            var done_inf = false
            while !done_inf {
                match cur_inf {
                    Some(fl) => {
                        let field_name = (*fl).head.name
                        let tmpl_field_ty = field_info_list_find(si.fields, field_name)
                        let init_ty = checker_check_expr_inplace(c, (*fl).head.value)
                        // Bind direct (`v: F`) and one-level array (`c: [F; N]`)
                        // type parameters without copying StructInfo recursively.
                        inferred = infer_bind_array_type_param(tmpl_field_ty, init_ty, &si, inferred)
                        cur_inf = (*fl).tail
                    }
                    None => {
                        done_inf = true
                    }
                }
            }

            // Build the TypeEntryList from inferred args, in reverse (finalize 16671-16677).
            var args_list_opt: Option<Box<TypeEntryList> > = None
            var ai: i64 = si.type_param_count - 1
            while ai >= 0 {
                args_list_opt = Some(Box::new(TypeEntryList { head: inferred.args[ai], tail: args_list_opt }))
                ai = ai - 1
            }

            match args_list_opt {
                None => ty_error()
                Some(args_box) => {
                    let args = *args_box
                    let si_name = si.name
                    let si_fields = field_info_list_clone(&si.fields)
                    let si_type_param_count = si.type_param_count
                    let si_type_param_names = si.type_param_names
                    let si_is_linear = si.is_linear
                    let si_visibility_kind = si.visibility_kind
                    let si_defining_module_id = si.defining_module_id
                    let si_visibility = si.visibility
                    let si_defining_module = si.defining_module
                    // Mangled name (finalize 16683-16684).
                    let mangled = mangle_generic_name(&si_name, &args)
                    // Monomorphize if not already present (finalize 16687-16702).
                    let existing_idx = struct_table_find((*c).structs, mangled)
                    if existing_idx < 0 {
                    let si_tp_buf = TypeParamBuf { names: si.type_param_names, count: si.type_param_count }
                    let mono_fields = monomorphize_fields(si_fields, si_tp_buf, &args)
                        let mono_info = StructInfo {
                            name: mangled,
                            fields: mono_fields.0,
                            field_count: mono_fields.1,
                            is_linear: si_is_linear,
                            type_param_count: 0,
                            type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
                            is_generic_template: false,
                            visibility_kind: si_visibility_kind,
                            defining_module_id: si_defining_module_id,
                            visibility: si_visibility,
                            defining_module: si_defining_module,
                        }
                        // RUNTIME-RISK: ~160KB StructTable by-value SRET-store-back (see review).
                        struct_table_add((*c).structs, mono_info)
                    }
                    // Pass 2: validate fields against the monomorphized struct (finalize
                    // 16705-16709 → check_struct_field_inits 16715). Count check first (E046),
                    // then interleaved per-field lookup-then-check (E016), all via the *mut spine.
                    let mono_idx = struct_table_find((*c).structs, mangled)
                    if mono_idx >= 0 {
                        let mono_si = struct_table_get((*c).structs, mono_idx)
                        let init_count = struct_field_list_count(e.fields)
                        if init_count != mono_si.field_count {
                            checker_report_error_at_inplace(c, e.span, 46, 0, 0, 0)
                        } else {
                            var cur_v = e.fields
                            var done_v = false
                            while !done_v {
                                match cur_v {
                                    Some(list) => {
                                        if !field_info_list_has(mono_si.fields, (*list).head.name) {
                                            checker_report_error_at_inplace(c, (*list).head.value.span, 12, 0, 0, 0)
                                        } else {
                                            let field_ty = field_info_list_find(mono_si.fields, (*list).head.name)
                                            let val_init_ty = checker_check_expr_inplace(c, (*list).head.value)
                                            if !checker_contextual_expr_compatible((*list).head.value, val_init_ty, field_ty) {
                                                checker_report_mismatch_inplace(c, (*list).head.value.span, 16, field_ty, val_init_ty)
                                            }
                                        }
                                        cur_v = (*list).tail
                                    }
                                    None => {
                                        done_v = true
                                    }
                                }
                            }
                        }
                    }
                    ty_named(mangled)
                }
            }
        } else {
            // ---- Non-generic struct literal (check_struct_lit else-branch 16622-16625 →
            // check_struct_field_inits 16715). Count check first (E046, return ty_named NOT
            // ty_error — the outer by-value wraps the result as ty_named(struct_name)
            // regardless), then interleaved per-field lookup-then-check (E016). ----
            let init_count = struct_field_list_count(e.fields)
            if init_count != si.field_count {
                checker_report_error_at_inplace(c, e.span, 46, 0, 0, 0)
                return ty_named(struct_name)
            }
            var cur = e.fields
            var done = false
            while !done {
                match cur {
                    Some(list) => {
                        if !field_info_list_has(si.fields, (*list).head.name) {
                            checker_report_error_at_inplace(c, (*list).head.value.span, 12, 0, 0, 0)
                        } else {
                            let field_ty = field_info_list_find(si.fields, (*list).head.name)
                            let init_ty = checker_check_expr_inplace(c, (*list).head.value)
                            if !checker_contextual_expr_compatible((*list).head.value, init_ty, field_ty) {
                                checker_report_mismatch_inplace(c, (*list).head.value.span, 16, field_ty, init_ty)
                            }
                        }
                        cur = (*list).tail
                    }
                    None => {
                        done = true
                    }
                }
            }
            // The same array local may not initialise two fields.
            //
            // `Trajectory { speakers: zi, hashes: zi, ... }` reads as "both start
            // zeroed" and is that under lean_single. Under Madaros the value copy
            // is shallow, so the two fields are ONE array: traj_push's five writes
            // landed in the same place and only the last survived, and every read
            // of speakers returned the dim (#2152).
            //
            // The engines disagree about whether a struct literal copies an array
            // field by value. That is a language decision and lean_single, the
            // fixed point, already answers it -- but until Madaros copies deep,
            // the honest move is that neither reading may be depended on. So the
            // ambiguous form is refused rather than resolved silently either way.
            //
            // Cost of refusing, measured across stdlib/, self-hosted/ and tests/
            // with both controls (Trajectory must appear, PBPKState28 must not):
            // FIVE sites, three real, all already rewritten with one literal per
            // field. Nothing legitimate is outlawed -- the fix is to write the
            // literal twice, which is what the code meant.
            var oi = e.fields
            var odone = false
            while !odone {
                match oi {
                    Some(ol) => {
                        if (*ol).head.value.kind == ExprKind::ExprIdent {
                            let oty = field_info_list_find(si.fields, (*ol).head.name)
                            if oty.kind == TypeKind::TyArray {
                                var ij = (*ol).tail
                                var idone = false
                                while !idone {
                                    match ij {
                                        Some(il) => {
                                            if (*il).head.value.kind == ExprKind::ExprIdent && name_eq((*il).head.value.name, (*ol).head.value.name) {
                                                checker_report_error_at_inplace(c, (*il).head.value.span, 232, 0, 0, 0)
                                            }
                                            ij = (*il).tail
                                        }
                                        None => {
                                            idone = true
                                        }
                                    }
                                }
                            }
                        }
                        oi = (*ol).tail
                    }
                    None => {
                        odone = true
                    }
                }
            }
            ty_named(struct_name)
        }
    } else {
        if name_eq(struct_name, make_name("Knowledge")) {
            var cur_k = e.fields
            var seen_value = false
            var value_ty = ty_error()
            while true {
                match cur_k {
                    Some(list) => {
                        let init_ty = checker_check_expr_inplace(c, (*list).head.value)
                        if name_eq((*list).head.name, make_name("value")) {
                            value_ty = init_ty
                            seen_value = true
                        }
                        cur_k = (*list).tail
                    }
                    None => break
                }
            }
            if !seen_value {
                checker_report_error_at_inplace(c, e.span, 12, 0, 0, 0)
                return ty_error()
            }
            // N2 seeding (false-positive fix, 2026-08-25): a struct-literal
            // `Knowledge { value: .. }` with a SCALAR payload is a deterministic
            // construction carrying no measurement source, so its noise-symbol set is
            // EMPTY, not the top default. Mirror the inline-ctor path. Without this, N3
            // wrongly refuses `Knowledge{..} + Knowledge{..}` (E230).
            // Defensive (math-review, zai, 2026-08-25): if the payload is itself a
            // noise-bearing Knowledge, INHERIT its source-set rather than laundering it
            // to empty (which would let `Knowledge{value:x} + x` bypass E230). The
            // current type system rejects a Knowledge payload here (E001), so this arm
            // is belt-and-suspenders, but it makes the seeding sound by construction
            // rather than by relying on that check elsewhere.
            var k_struct_result = ty_knowledge(value_ty, 0.0 - 1.0)
            if is_knowledge_type(value_ty) {
                k_struct_result.noise_set_id = value_ty.noise_set_id
            } else {
                k_struct_result.noise_set_id = ns_empty()
            }
            checker_ns_trace_emit("knowledge_struct_lit", k_struct_result.noise_set_id)
            return k_struct_result
        }
        // ---- Enum struct-variant constructor (`Enum::Variant { field: val }`). The head
        // segment ("Event") is the enum name; the last segment ("C") names a struct variant.
        // checker_copy_string_list_to_name returns the HEAD; _tail_to_name returns the LAST
        // segment. If head is an enum AND last is a struct-variant of it, validate the field
        // inits against the variant's declared fields and yield ty_named(enum_name) — matching
        // how checker_check_path_expr_inplace types a variant path, so a later
        // `match c { Event::C { x: cx } => .. }` resolves via enum_table_find((*c).enums, scrut_ty.name). ----
        let enum_idx = enum_table_find((*c).enums, struct_name)
        if enum_idx >= 0 {
            let variant_name = checker_copy_string_list_tail_to_name(e.path.segments)
            let ei = enum_table_get((*c).enums, enum_idx)
            if variant_info_list_has(ei.variants, variant_name) {
                let vfields = variant_info_list_find_fields(ei.variants, variant_name)
                // Count check first (E046), mirroring the non-generic struct branch:
                // report and still yield ty_named so the variant type is known downstream.
                let ev_init_count = struct_field_list_count(e.fields)
                if ev_init_count != field_info_list_count(vfields) {
                    checker_report_error_at_inplace(c, e.span, 46, 0, 0, 0)
                    return ty_named(struct_name)
                }
                var cur_ev = e.fields
                var done_ev = false
                while !done_ev {
                    match cur_ev {
                        Some(list) => {
                            if !field_info_list_has(vfields, (*list).head.name) {
                                checker_report_error_at_inplace(c, (*list).head.value.span, 12, 0, 0, 0)
                            } else {
                                let field_ty = field_info_list_find(vfields, (*list).head.name)
                                let init_ty = checker_check_expr_inplace(c, (*list).head.value)
                                if !checker_contextual_expr_compatible((*list).head.value, init_ty, field_ty) {
                                    checker_report_mismatch_inplace(c, (*list).head.value.span, 16, field_ty, init_ty)
                                }
                            }
                            cur_ev = (*list).tail
                        }
                        None => {
                            done_ev = true
                        }
                    }
                }
                return ty_named(struct_name)
            }
        }
        // ---- Unknown struct (check_struct_lit else-branch 16626-16630 →
        // check_struct_field_inits_no_type 16740). Report E015, then check every field-init
        // expr via the *mut spine (for side effects / nested-expr diagnostics), no type compat. ----
        checker_report_error_at_inplace(c, e.span, 15, 0, 0, 0)
        var cur_nt = e.fields
        var done_nt = false
        while !done_nt {
            match cur_nt {
                Some(list) => {
                    let _unused = checker_check_expr_inplace(c, (*list).head.value)
                    cur_nt = (*list).tail
                }
                None => {
                    done_nt = true
                }
            }
        }
        ty_error()
    }
}

// *mut transcription of check_closure_expr (18449). The by-value version was reached via the
// final bridge (checker_check_expr_mut → (*c).check_expr → check_closure_expr), copying the 8MB
// Checker, and then checked the closure BODY by value — so a body containing a CALL recursively
// re-copied the Checker per sub-expr → stack smash (the typed-closure crasher). Here the body is
// checked IN PLACE (checker_check_opt_expr_inplace); the shallow setup (param collect / return
// lower / param bind) stays bridged-by-value (single copies, survivable). Faithful to the
// by-value logic incl. Sprint-231 capture analysis + Epistemic auto-inject.
// --- *mut closure setup helpers (replace the by-value collect/lower/bind bridges whose
// 164KB Checker returns SRET-smashed once (*c).enums was populated → every closure crashed
// --check). Each mutates (*c) directly and returns only small data; lower_type_expr is the
// one remaining bridge (it survives in isolation, e.g. `let x: i64`). ---
fn checker_collect_closure_param_list_inplace(c: *mut Checker, pl: ClosureParamList) -> (FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
    let head_ty = checker_lower_type_expr_mut(c, pl.head.ty)
    let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
    match pl.tail {
        None => (FnParamList { head: head_param, tail: None }, 1)
        Some(rest) => {
            let rest_pair = checker_collect_closure_param_list_inplace(c, *rest)
            (FnParamList { head: head_param, tail: Some(Box::new(rest_pair.0)) }, 1 + rest_pair.1)
        }
    }
}

fn checker_collect_closure_params_inplace(c: *mut Checker, opt: Option<Box<ClosureParamList> >) -> (Option<Box<FnParamList> >, i64) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(pl) => {
            let r = checker_collect_closure_param_list_inplace(c, *pl)
            (Some(Box::new(r.0)), r.1)
        }
        None => (None, 0)
    }
}

fn checker_lower_opt_closure_return_inplace(c: *mut Checker, opt: Option<Box<TypeExpr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    checker_lower_opt_type_inplace(c, opt)
}

fn checker_bind_closure_param_inplace(c: *mut Checker, p: ClosureParam) with Mut, Panic, Div, Alloc, IO {
    let param_ty = checker_lower_type_expr_mut(c, p.ty)
    (*c).env = (*c).env.bind(p.name, param_ty, false)
    checker_const_int_bind_unknown_inplace(c, p.name)
    let lin = checker_is_linear_type_inplace(c, param_ty)
    (*c).borrows = (*c).borrows.track(p.name, lin)
}

fn checker_bind_closure_params_inplace(c: *mut Checker, opt: Option<Box<ClosureParamList> >) with Mut, Panic, Div, Alloc, IO {
    var cur = opt
    while true {
        match cur {
            Some(pl) => {
                checker_bind_closure_param_inplace(c, (*pl).head)
                cur = (*pl).tail
            }
            None => break
        }
    }
}

fn checker_check_closure_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // *mut closure helpers (no 164KB Checker SRET-move; only lower_type_expr is bridged,
    // which works in isolation — the crash was the ACCUMULATED by-value Checker returns of
    // collect_closure_params / lower_opt_closure_return / bind_closure_params).
    let params_pair = checker_collect_closure_params_inplace(c, e.closure_params)
    let params = params_pair.0
    let param_count = params_pair.1

    let ret_ty = checker_lower_opt_closure_return_inplace(c, e.closure_return)

    let saved_effects = (*c).current_effects
    let saved_effect_count = (*c).current_effect_count
    (*c).current_effects = [0; 8]
    (*c).current_effect_count = 0

    let outer_borrow_count = (*c).borrows.count
    (*c).env = (*c).env.push_scope()
    (*c).borrows = (*c).borrows.push_scope()
    checker_push_const_scope_inplace(c)

    checker_bind_closure_params_inplace(c, e.closure_params)
    var capture_candidates: [bool; 128] = [false; 128]
    var capture_seed_i: i64 = 0
    while capture_seed_i < outer_borrow_count {
        let entry = (*c).borrows.entries[capture_seed_i as usize]
        capture_candidates[capture_seed_i as usize] = entry.is_linear && !entry.consumed
        capture_seed_i = capture_seed_i + 1
    }

    // THE FIX: body checked in place (was the by-value c.check_opt_expr recursion).
    let body_ty = checker_check_opt_expr_inplace(c, e.closure_body)

    let inferred_ret_ty = if ret_ty.kind == TypeKind::TyUnknown {
        body_ty
    } else {
        ret_ty
    }
    if ret_ty.kind != TypeKind::TyUnknown {
        if !checker_types_compatible_inplace(c, body_ty, ret_ty) {
            checker_report_mismatch_inplace(c, e.span, 8, ret_ty, body_ty)
        }
    }

    var inferred_effects = (*c).current_effects
    var inferred_effect_count = (*c).current_effect_count

    // An outer linear binding is captured exactly when checking the closure body
    // transfers it from owned to consumed. Closure parameters start after this range.
    var capture_linear = false
    var capture_linear_count: i64 = 0
    var capture_i: i64 = 0
    while capture_i < outer_borrow_count {
        let after = (*c).borrows.entries[capture_i as usize]
        if capture_candidates[capture_i as usize] && after.consumed {
            capture_linear = true
            capture_linear_count = capture_linear_count + 1
        }
        capture_i = capture_i + 1
    }

    checker_require_current_linear_scope_consumed_inplace(c)
    checker_pop_const_scope_inplace(c)
    (*c).borrows = (*c).borrows.pop_scope()
    (*c).env = (*c).env.pop_scope()
    (*c).current_sig_id = 0 - 1
    (*c).current_effects = saved_effects
    (*c).current_effect_count = saved_effect_count

    var capture_epsilon: f64 = 0.0 - 1.0
    var ci: i64 = 0
    let env_count = (*c).env.count
    while ci < env_count {
        let binding = (*c).env.bindings[ci as usize]
        let binding_ty = binding.ty
        if binding_ty.kind == TypeKind::TyKnowledge {
            let eps = binding_ty.knowledge_epsilon
            if eps >= 0.0 {
                if capture_epsilon < 0.0 {
                    capture_epsilon = eps
                } else {
                    capture_epsilon = capture_epsilon + eps
                }
            }
        }
        ci = ci + 1
    }
    if capture_epsilon >= 0.0 {
        var has_epistemic = false
        var ei: i64 = 0
        while ei < inferred_effect_count {
            if inferred_effects[ei] == 8 { has_epistemic = true }
            ei = ei + 1
        }
        if !has_epistemic && inferred_effect_count < 8 {
            inferred_effects[inferred_effect_count] = 8
            inferred_effect_count = inferred_effect_count + 1
        }
    }

    let closure_sig = FnSig {
        name: Name { buf: [0; 128], len: 0 },
        params: params,
        param_count: param_count,
        return_type: inferred_ret_ty,
        is_method: false,
        self_type_name: Name { buf: [0; 128], len: 0 },
        self_type_entry: ty_unit(),
        effects: inferred_effects,
        effect_count: inferred_effect_count,
        is_kernel: false,
        is_epistemic_kernel: false,
        is_extern: false,
        is_linear_closure: capture_linear,
        linear_capture_count: capture_linear_count,
        epistemic_epsilon: capture_epsilon,
        epistemic_min_confidence: 0 - 1,
        visibility_kind: VISIBILITY_PRIVATE,
        defining_module_seg_count: (*c).current_module.seg_count,
        defining_module_id: (*c).current_module_id,
        visibility: visibility_private(),
        defining_module: (*c).current_module,
    }
    let sig_id = fn_sig_table_add((*c).fn_sigs, closure_sig)
    ty_fn(sig_id)
}

// *mut transcription of check_method_call_with_base_ty (15287). The by-value version copied the
// 8MB Checker as `self` on every method call, and checked ARGS by value
// (check_expr_list_no_type_no_linear_consume) — so an arg that is a struct-returning CALL
// (v.push(mk(1))) re-copied the Checker per sub-expr → stack smash (the Seq survivor). Every
// branch here mirrors the by-value logic but routes arg-checking through the *mut spine
// (checker_check_expr_list_no_type_no_linear_consume_inplace / checker_check_call_args_inplace /
// checker_release_call_arg_borrows_inplace / checker_report_error_at_inplace). Faithful: the
// pure helpers (name_matches_*, knowledge_inner, ty_*) are unchanged.
fn checker_check_method_call_with_base_ty_inplace(c: *mut Checker, e: Expr, base_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if name_matches_str3(e.name, 108, 101, 110) && len_method_supported(base_ty) {
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        match e.args {
            Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
            None => {}
        }
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        // Seq.len() returns Knowledge<i64> under lean_single; arrays/slices stay i64.
        if is_seq_type(base_ty) {
            return ty_knowledge(ty_i64(), 0.0 - 1.0)
        }
        return ty_i64()
    }
    // Seq<T> methods: .push / .count / .get / .set / .push_uncertain (lean_single surface).
    if is_seq_type(base_ty) {
        let elem_ty = seq_elem_type(base_ty)
        let call_start_borrows = (*c).borrows
        // push(v) / push_uncertain(v, conf, var)
        if name_matches_str4(e.name, 112, 117, 115, 104) {
            let first = expr_list_head(e.args)
            match first {
                None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
                Some(_) => {
                    let arg_ty = checker_check_opt_expr_inplace(c, first)
                    if !is_error_or_unknown(arg_ty) && !is_error_or_unknown(elem_ty) {
                        if !checker_types_compatible_inplace(c, arg_ty, elem_ty) {
                            checker_report_mismatch_inplace(c, e.span, 9, elem_ty, arg_ty)
                        }
                    }
                }
            }
            // Consume remaining args (push_uncertain has conf/var) without re-typing first.
            match e.args {
                Some(list) => {
                    checker_check_expr_list_no_type_no_linear_consume_inplace(c, (*list).tail)
                }
                None => {}
            }
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_unit()
        }
        if name_matches_str14(e.name, 112, 117, 115, 104, 95, 117, 110, 99, 101, 114, 116, 97, 105, 110) {
            // push_uncertain
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_unit()
        }
        if name_matches_str5(e.name, 99, 111, 117, 110, 116) {
            // count() -> i64
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            match e.args {
                Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
                None => {}
            }
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_i64()
        }
        if name_matches_str3(e.name, 103, 101, 116) {
            // get(i) -> T
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return elem_ty
        }
        if name_matches_str3(e.name, 115, 101, 116) {
            // set(i, v)
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_unit()
        }
        checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        return ty_error()
    }
    if base_ty.kind == TypeKind::TyKnowledge {
        if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
            let call_start_borrows = (*c).borrows
            match e.args {
                None => {
                    checker_report_error_at_inplace(c, e.span, 172, 0, 0, 0)
                    checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
                    knowledge_inner(base_ty)
                }
                Some(arg_list) => {
                    if (*arg_list).head.kind != ExprKind::ExprStringLit {
                        checker_report_error_at_inplace(c, e.span, 173, 0, 0, 0)
                    }
                    checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
                    checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
                    knowledge_inner(base_ty)
                }
            }
        } else {
            checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyHyper {
        let alg = base_ty.algebra_kind
        let inner_ty = match base_ty.inner {
            Some(inner) => *inner
            None => ty_error()
        }
        if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            base_ty
        } else if name_matches_str4(e.name, 110, 111, 114, 109) {
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            inner_ty
        } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            if alg > 3 {
                checker_report_error_at_inplace(c, e.span, 32, 0, 0, 0)
                ty_error()
            } else {
                base_ty
            }
        } else {
            checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyNamed {
        let sig_id = fn_sig_table_find_method_semantic((*c).fn_sigs, base_ty, e.name)
        if sig_id >= 0 {
            let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
            let call_start_borrows = (*c).borrows
            checker_check_call_args_inplace(c, expr_list_handle(e.args), fn_param_list_handle(fn_param_list_clone(&sig.params)), sig.param_count, e.span, 0 - 1)
            checker_check_callee_effects_named_inplace(c, e.span, sig.effects, sig.effect_count, sig.name)
            checker_release_call_arg_borrows_inplace(c, e.args, fn_param_list_clone(&sig.params), call_start_borrows)
            sig.return_type
        } else {
            checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            ty_error()
        }
    } else if base_ty.kind == TypeKind::TyString {
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        if name_matches_str8(e.name, 97, 115, 95, 98, 121, 116, 101, 115) {
            ty_ref(ty_i8())
        } else if name_matches_str3(e.name, 108, 101, 110) {
            ty_i64()
        } else {
            checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
            ty_error()
        }
    } else if is_primitive_receiver_type(base_ty) {
        // Primitive receiver (i64/f64/bool/…): `impl R for i64 { fn m(self,…) }`
        // registers the method with self_type_entry = the primitive TypeEntry
        // (empty name). The semantic lookup disambiguates on kind, so route the
        // call here exactly like the struct (TyNamed) branch. On lookup miss keep
        // the original E019 to preserve rejection of bogus primitive methods.
        let sig_id = fn_sig_table_find_method_semantic((*c).fn_sigs, base_ty, e.name)
        if sig_id >= 0 {
            let sig = fn_sig_table_get((*c).fn_sigs, sig_id)
            let call_start_borrows = (*c).borrows
            checker_check_call_args_inplace(c, expr_list_handle(e.args), fn_param_list_handle(fn_param_list_clone(&sig.params)), sig.param_count, e.span, 0 - 1)
            checker_check_callee_effects_named_inplace(c, e.span, sig.effects, sig.effect_count, sig.name)
            checker_release_call_arg_borrows_inplace(c, e.args, fn_param_list_clone(&sig.params), call_start_borrows)
            sig.return_type
        } else {
            checker_report_error_at_inplace(c, e.span, 19, 0, 0, 0)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            ty_error()
        }
    } else if is_error_or_unknown(base_ty) {
        // Receiver failed to type (common multi-module residual when
        // Type::method associated constructors leave TyUnknown). Still reject
        // method names that match *no* registered impl method — so e.mean()
        // fails at check (E011) instead of SEGV at lower preseed — while
        // known names (e.val / e.std / e.add) soft-accept for cascade.
        // See docs/audit/MADAROS_DUAL_GUM_KNOWLEDGE_IMPORT_2026-07-19.md.
        if !fn_sig_table_has_method_name((*c).fn_sigs, e.name) {
            checker_report_error_at_inplace(c, e.span, 11, 0, 0, 0)
            let call_start_borrows = (*c).borrows
            checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
            checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
            return ty_error()
        }
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        base_ty
    } else {
        checker_report_error_at_inplace(c, e.span, 19, 0, 0, 0)
        let call_start_borrows = (*c).borrows
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        checker_release_call_arg_borrows_inplace(c, e.args, None, call_start_borrows)
        ty_error()
    }
}

fn checker_check_method_call_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if checker_expr_is_gpu_launch_descriptor_call(e) || checker_expr_is_gpu_sync_call(e) {
        checker_check_expr_list_no_type_no_linear_consume_inplace(c, e.args)
        return ty_unit()
    }
    (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth + 1
    let base_ty = checker_check_opt_expr_inplace(c, e.left)
    if (*c).suppress_linear_consume_depth > 0 {
        (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth - 1
    }
    checker_check_method_call_with_base_ty_inplace(c, e, base_ty)
}


// ============================================================================
// *mut ExprCall spine — the keystone (Call dominated the remaining crashes).
// The by-value check_call_expr (14531) checks the callee + every arg via by-value
// check_expr; in a call-heavy / nested body each sub-expr copies the ~164KB Checker
// again, and a callee/arg that is an ExprPath hits the SRET miscompile → SIGSEGV.
// This routes the callee AND every arg through the *mut spine; the per-arg boundary
// contracts (which never re-check the arg — they inspect the already-computed arg_ty)
// are bridged by value. The fan of non-crash early returns (ExprIndex redirect, 21
// builtin predicates, contest-witness) is bridged WHOLE by value — faithful, since
// call_expr_should_bridge_by_value is the exact disjunction of check_call_expr's guards.
// ============================================================================

fn call_expr_should_bridge_by_value(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    match e.right {
        Some(_) => return true
        None => {}
    }
    if call_expr_is_builtin_prove_robust(e.left) { return true }
    if call_expr_is_builtin_validate_manifest(e.left) { return true }
    if call_expr_is_builtin_admit_action(e.left) { return true }
    if call_expr_is_builtin_defer_action(e.left) { return true }
    if call_expr_is_builtin_deferral_reason(e.left) { return true }
    if call_expr_is_builtin_plan_acquisition(e.left) { return true }
    if call_expr_is_builtin_acquisition_reason(e.left) { return true }
    if call_expr_is_builtin_plan_recourse(e.left) { return true }
    if call_expr_is_builtin_recourse_reason(e.left) { return true }
    if call_expr_is_builtin_propose_alternatives(e.left) { return true }
    if call_expr_is_builtin_alternative_count(e.left) { return true }
    if call_expr_is_builtin_alternative_option(e.left) { return true }
    if call_expr_is_builtin_alternative_reason(e.left) { return true }
    if call_expr_is_builtin_commit_alternative(e.left) { return true }
    if call_expr_is_builtin_transition_reason(e.left) { return true }
    if call_expr_is_builtin_transition_step_count(e.left) { return true }
    if call_expr_is_builtin_observe_transition(e.left) { return true }
    if call_expr_is_builtin_rollback_transition(e.left) { return true }
    if call_expr_is_builtin_lift_knowledge(e.left) { return true }
    if call_expr_is_builtin_measure(e.left) { return true }
    if call_expr_is_builtin_variance_of(e.left) { return true }
    if call_expr_is_builtin_uncertainty_of(e.left) { return true }
    if call_expr_is_builtin_sensitivity_of(e.left) { return true }
    if call_expr_is_builtin_hessian_of(e.left) { return true }
    if call_expr_is_builtin_second_order_mean(e.left) { return true }
    if call_expr_is_builtin_correlate(e.left) { return true }
    if call_expr_contest_witness_kind(e.left) >= 0 { return true }
    false
}

// *mut transcription of check_expr_list_no_type (16969): check each arg via the spine.
fn checker_check_expr_list_no_type_inplace(c: *mut Checker, opt: Option<Box<ExprList> >) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(list) => {
            let _aty = checker_check_expr_inplace(c, (*list).head)
            checker_check_expr_list_no_type_inplace(c, (*list).tail)
        }
        None => {}
    }
}

// *mut transcription of check_expr_list_no_type_no_linear_consume (16982).
fn checker_check_expr_list_no_type_no_linear_consume_inplace(c: *mut Checker, opt: Option<Box<ExprList> >) with Mut, Panic, Div, Alloc, IO {
    (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth + 1
    checker_check_expr_list_no_type_inplace(c, opt)
    if (*c).suppress_linear_consume_depth > 0 {
        (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth - 1
    }
}

fn checker_check_one_call_arg_inplace(c: *mut Checker, arg_expr: Expr, param_info: FnParamInfo, call_span: Span) with Mut, Panic, Div, Alloc, IO {
    let implicit_borrow =
        arg_expr.kind == ExprKind::ExprIdent &&
        (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)
    if implicit_borrow {
        (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth + 1
    }
    let arg_ty = checker_check_expr_inplace(c, arg_expr)
    if implicit_borrow && (*c).suppress_linear_consume_depth > 0 {
        (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth - 1
    }
    if arg_ty.kind == param_info.ty.kind {
        if arg_ty.kind == TypeKind::TyI64
        || arg_ty.kind == TypeKind::TyF64
        || arg_ty.kind == TypeKind::TyBool
        || arg_ty.kind == TypeKind::TyUnit
        || arg_ty.kind == TypeKind::TyString
        || arg_ty.kind == TypeKind::TyChar {
            return
        }
    }
    let has_param_info = !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError
    if has_param_info {
        if !checker_call_arg_types_compatible_inplace(c, arg_expr, arg_ty, param_info.ty) {
            checker_report_mismatch_inplace(c, call_span, 9, param_info.ty, arg_ty)
        }
        if arg_ty.kind != TypeKind::TyFn && param_info.ty.kind != TypeKind::TyFn {
            // Direct *mut void calls (no Checker locals — was bb/rb/kb/ub/ob, ~12MB+
            // held across this fn's nested-call recursion → the stack overflow).
            checker_check_call_arg_borrow_boundary_inplace(c, arg_expr, param_info.ty, call_span)
            checker_check_call_arg_refinement_boundary_inplace(c, arg_expr, arg_ty, param_info.ty, call_span)
            checker_check_call_arg_knowledge_boundary_inplace(c, arg_ty, param_info.ty, call_span)
            checker_check_call_arg_unit_boundary_inplace(c, arg_ty, param_info.ty, call_span)
            checker_ontology_boundary_check_call_arg_contract_inplace(c, arg_ty, param_info.ty, call_span)
        }
    }
    if has_param_info &&
       arg_expr.kind == ExprKind::ExprIdent &&
       checker_is_linear_type_inplace(c, arg_ty) &&
       !implicit_borrow &&
       (*c).suppress_linear_consume_depth == 0 {
        if (*c).borrows.is_borrowed(arg_expr.name) {
            checker_report_error_at_inplace(c, call_span, 38, 0, 0, 0)
        } else {
            let consume_result = (*c).borrows.consume_linear(arg_expr.name)
            (*c).borrows = consume_result.0
            if consume_result.1 != 0 {
                checker_report_error_at_inplace(c, call_span, 39, 0, 0, 0)
            }
        }
    }
}

// *mut transcription of check_call_args_inner (16907): the arg is checked via the spine;
// the boundary contracts inspect the already-computed arg_ty (no re-check) and are bridged.
// ns_watch_idx: codex ruling 2026-08-23 (fail-closed call-projection fix).
// -1 means "this callee is not a proven exact-parameter-projection -- do not
// capture anything, checker_propagate_call_result_ns_inplace will force top."
// A value >= 0 is the ONE parameter index ns_proj_table proved this callee's
// body is exactly `{ param }`/`{ return param }` for; only THAT argument's
// noise_set_id is captured into (*c).last_call_arg_ns, never "last Knowledge
// arg wins" (grok-4.6 found that fail-open: add_noise(x){x+measure(0)} and
// first(a,b){a} both narrowed to a real handle instead of top).
fn checker_check_call_args_inplace(c: *mut Checker, args: ExprListHandle, params: FnParamListHandle, expected_count: i64, call_span: Span, ns_watch_idx: i64) with Mut, Panic, Div, Alloc, IO {
    var current = args
    var idx: i64 = 0
    while current.ptr != 0 as *mut ExprList {
        let param_info = fn_param_list_handle_get(params, idx)
        let arg_expr = (*current.ptr).head
        let implicit_borrow =
            arg_expr.kind == ExprKind::ExprIdent &&
            (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)
        // Suppress consumption while TYPING an identifier argument, for every
        // argument — not only implicit borrows. Evaluating an identifier goes
        // through checker_check_ident_expr_inplace, which consumes any linear it
        // names; the explicit block further down then consumed it a second time
        // whenever the parameter was by value, producing a spurious E039 on the
        // FIRST use (issue #1464). Ownership transfer is decided below, where the
        // by-ref/by-value distinction is known; typing the argument must not
        // itself transfer. Non-identifier arguments are unaffected: they name no
        // binding, so there is nothing to consume either way.
        let suppress_arg_consume = arg_expr.kind == ExprKind::ExprIdent
        if suppress_arg_consume {
            (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth + 1
        }
        let arg_ty = checker_check_expr_inplace(c, arg_expr)
        // N2 (REQ-5, codex ruling 2026-08-23): capture ONLY the argument at
        // the callee's proven-projection parameter index -- never "last
        // Knowledge arg wins" (that was fail-open; see the fn comment above).
        if idx == ns_watch_idx && arg_ty.kind == TypeKind::TyKnowledge {
            (*c).last_call_arg_ns = arg_ty.noise_set_id
        }
        if suppress_arg_consume && (*c).suppress_linear_consume_depth > 0 {
            (*c).suppress_linear_consume_depth = (*c).suppress_linear_consume_depth - 1
        }
        var primitive_exact = false
        if arg_ty.kind == param_info.ty.kind {
            if arg_ty.kind == TypeKind::TyI64
            || arg_ty.kind == TypeKind::TyF64
            || arg_ty.kind == TypeKind::TyBool
            || arg_ty.kind == TypeKind::TyUnit
            || arg_ty.kind == TypeKind::TyString
            || arg_ty.kind == TypeKind::TyChar {
                primitive_exact = true
            }
        }
        let has_param_info = !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError
        if has_param_info && !primitive_exact {
            if !checker_call_arg_types_compatible_inplace(c, arg_expr, arg_ty, param_info.ty) {
                checker_report_mismatch_inplace(c, call_span, 9, param_info.ty, arg_ty)
            }
            if arg_ty.kind != TypeKind::TyFn && param_info.ty.kind != TypeKind::TyFn {
                checker_check_call_arg_borrow_boundary_inplace(c, arg_expr, param_info.ty, call_span)
                checker_check_call_arg_refinement_boundary_inplace(c, arg_expr, arg_ty, param_info.ty, call_span)
                checker_check_call_arg_knowledge_boundary_inplace(c, arg_ty, param_info.ty, call_span)
                checker_check_call_arg_unit_boundary_inplace(c, arg_ty, param_info.ty, call_span)
                checker_ontology_boundary_check_call_arg_contract_inplace(c, arg_ty, param_info.ty, call_span)
            }
        }
        if has_param_info &&
           arg_expr.kind == ExprKind::ExprIdent &&
           checker_is_linear_type_inplace(c, arg_ty) &&
           !implicit_borrow &&
           (*c).suppress_linear_consume_depth == 0 {
            if (*c).borrows.is_borrowed(arg_expr.name) {
                checker_report_error_at_inplace(c, call_span, 38, 0, 0, 0)
            } else {
                let consume_result = (*c).borrows.consume_linear(arg_expr.name)
                (*c).borrows = consume_result.0
                if consume_result.1 != 0 {
                    checker_report_error_at_inplace(c, call_span, 39, 0, 0, 0)
                }
            }
        }
        current = expr_list_handle_next(current)
        idx = idx + 1
    }
    if expected_count >= 0 && idx != expected_count {
        checker_report_error_at_inplace(c, call_span, 10, 0, 0, 0)
    }
}

// *mut ExprCall handler — transcription of check_call_expr's normal path (14605-14687).
fn checker_check_measure_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    // measure(v: T, uncertainty: f64) -> Knowledge<T>. Inplace transcription of
    // check_measure_expr — the by-value bridge (checker_check_expr_mut) SRET-smashed
    // the 164KB Checker once enums were populated, so EVERY measure() crashed --check
    // (~41% of remaining checker crashers).
    let first_arg = expr_list_head(e.args)
    let v_ty = checker_check_opt_expr_inplace(c, first_arg)
    var result = ty_knowledge(v_ty, 0.0 - 1.0)
    // N2 seed (REQ-2): a measured value is a fresh independent source, so it
    // becomes a NEW singleton set -- never empty (that would claim it shares
    // no uncertainty with itself) and never a leftover handle from an
    // earlier measure() call in the same checker run. The source id comes
    // from ns_source_issued, NOT from ns_table's interned-set count (REQ-1) --
    // see the field comment on Checker.
    if !checker_ns_sabotage() {
        let src = (*c).ns_source_issued
        (*c).ns_source_issued = src + 1
        result.noise_set_id = ns_singleton(&!(*(*c).ns_table), src)
    }
    checker_ns_trace_emit("measure", result.noise_set_id)
    result
}

// seq_new() -> Seq<_>. Element type comes from the binding annotation
// (`var s: Seq<T> = seq_new()`): return ty_unknown so types_compatible accepts
// any Seq annotation (compat treats bare/unknown Seq as wildcard).
fn checker_check_seq_new_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match e.args {
        Some(_) => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        None => {}
    }
    // Bare element; binding annotation `var s: Seq<T> = seq_new()` supplies T
    // via types_compatible Seq wildcard (missing/unknown inners).
    ty_seq_named(make_name("Seq"), ty_unknown())
}

fn checker_check_seq_push_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let first_arg = expr_list_head(e.args)
    let second_arg = expr_list_second(e.args)
    let seq_ty = checker_check_opt_expr_inplace(c, first_arg)
    let v_ty = checker_check_opt_expr_inplace(c, second_arg)
    match first_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    match second_arg {
        None => checker_report_error_at_inplace(c, e.span, 10, 0, 0, 0)
        Some(_) => {}
    }
    if !is_error_or_unknown(seq_ty) && !is_seq_type(seq_ty) {
        checker_report_error_at_inplace(c, e.span, 9, 0, 0, 0)
    }
    if is_seq_type(seq_ty) {
        let elem = seq_elem_type(seq_ty)
        if !is_error_or_unknown(v_ty) && !is_error_or_unknown(elem) {
            if !checker_types_compatible_inplace(c, v_ty, elem) {
                checker_report_mismatch_inplace(c, e.span, 9, elem, v_ty)
            }
        }
    }
    ty_unit()
}

fn checker_check_seq_get_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
