        Some(_) => {}
    }
    if is_seq_type(seq_ty) {
        return seq_elem_type(seq_ty)
    }
    if !is_error_or_unknown(seq_ty) {
        checker_report_error_at_inplace(c, e.span, 9, 0, 0, 0)
    }
    ty_error()
}

