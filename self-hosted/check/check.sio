        ep.contests[i as usize].mechanistic_report_id = checker.contests.entries[i as usize].mechanistic_report_id
        ep.contests[i as usize].posterior_weights_id = checker.contests.entries[i as usize].posterior_weights_id
        ep.contests[i as usize].counterexample_id = checker.contests.entries[i as usize].counterexample_id
