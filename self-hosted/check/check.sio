    else if code == 177 { print("enum constructor is private in its defining module") }
    else if code == 221 { print("this math function is bound for typechecking but the native backend cannot emit it; the call would compile and then die on an illegal instruction at run time") }
    else if code == 244 { print("Knowledge provenance boundary mismatch: the argument's provenance cannot satisfy the parameter's requirement (trusted classes: Source, Literature, Measured)") }
    else if code == 245 { print("arithmetic between two Knowledge<T> values is not supported by this compiler; the operation typechecks but has no lowering, so it would produce a wrong value or crash at runtime") }
    else if code == 200 { print("Forgettable type requires ZD effect: exact annihilation is only possible via zero-divisor algebra (sedenions). Division algebras cannot satisfy this guarantee. Add `with ZD` to your function signature.") }
    else if code == 201 { print("ExactlyPrivate<T> requires ZD effect: exact data-contribution removal is only possible via sedenion annihilation. Differential privacy (epsilon-bounded) does not suffice. Add `with ZD` to your function signature.") }
    else if code == 202 { print("Editable<T> requires ZD effect: locality-bounded edits (G5) require ZD-based kernel annihilation. Ripple-free editing is not achievable via rank-1 or mask-based updates. Add `with ZD` to your function signature.") }
    else if code == 203 { print("CapabilityGated<T> requires ZD effect: capability containment requires exact ZD annihilation of the gated subspace. Activation patching and masking leave residual. Add `with ZD` to your function signature.") }
    else if code == 204 { print("Composable<T> requires ZD effect: ZD-orthogonal model merge (G8) relies on the 4D annihilator complement — two models can only be composed without mutual perturbation when their capabilities live in ZD-orthogonal subspaces. Parameter averaging leaks across capabilities. Add `with ZD` to your function signature.") }
    else if code == 205 { print("Audited<T> requires ZD and Witness effects: witness-bearing surgery (G9) must emit a machine-checkable Lean derivation of the ZD-kernel action. `with ZD` alone produces the erasure without evidence; Witness is what makes it checkable. Add `with ZD, Witness` to your function signature.") }
    else if code == 206 { print("Revivable<T> requires ZD and Temporal effects: time-bounded reversible surgery (G10) needs both the ZD annihilator algebra and an explicit Temporal window in which the op can be inverted. After the window, the surgery is irrevocable. Add `with ZD, Temporal` to your function signature.") }
    else if code == 207 { print("Interpretable<T> requires ZD effect: the 168-class canonical basis is the projective ZD-graph of sedenions. Without the ZD effect the compiler cannot guarantee that decomposition/reconstruction is fp-exact. Add `with ZD` to your function signature.") }
    else if code == 247 { print("ZD locus is not a well-formed sedenion pair eIeJ with 1 <= I < J <= 15") }
    else if code == 213 { print("tuple destructure arity mismatch") }
    else if code == 215 { print("EpistemicComplete violation") }
    else if code == 216 { print("infinite recursive type") }
    else if code == 248 { print("f128/f256 value conversion is not implemented; wide-float casts fail closed") }
    else if code == 249 { print("f128/f256 is reserved for compiler-owned format identity; source values are unavailable in V0-A") }
    else if code == 250 { print("call to an `extern \"C\"` function the native backend does not implement") }
    else if code == 242 { print("epistemic channel index is out of range") }
    else if code == 232 { print("the same array local initialises two fields; the value copy is shallow, so they would be one array -- give each field its own literal") }
    else if code == 243 { print("the correlation coefficient must be a compile-time literal; a runtime value silently becomes 0.0, which asserts independence") }
    else if code == 230 { print("independence-assuming operation over correlated uncertainty") }
    else if code == 72 { print("malformed conditional-independence claim: IndepKnowledge<T, A, B | Z> needs two distinct variables") }
    else if code == 254 { print("this variable is not a node of the declared causal graph") }
    else if code == 255 { print("the claimed independence does not hold: an active path remains open in the declared causal graph") }
    else if code == 256 { print("`d_separated` needs a declared causal graph and exactly two variable names, with an optional `| Z`") }
    else if code == 251 { print("product variance shortcut is unsound beyond the octonions: |xy| != |x||y| on Sedenion/Clifford, so Var(x*y) = |y|^2 Var x + |x|^2 Var y fabricates precision") }
    else if code == 252 { print("algebra declares a reassociation strategy its multiplication law cannot certify: `free` needs an associative product, `fano_selective` needs the octonion level") }
    else { print("unknown error") }
}

// Print help text for error codes (actionable fix suggestions)
fn print_error_help(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10) - top 10 most common errors
    if code == 1 {
        print("   |\n   = help: the variable declaration and assigned value have incompatible types\n")
    }
    else if code == 2 {
        print("   |\n   = help: ensure the value type matches the target type for this assignment\n")
    }
    else if code == 3 {
        print("   |\n   = help: declare the variable with `var` instead of `let` to allow mutation\n")
    }
    else if code == 4 {
        print("   |\n   = help: use explicit type conversion with `as` if the types are compatible\n")
    }
    else if code == 5 {
        print("   |\n   = help: check that the operator is valid for this type (e.g., `-x` for numbers, `!x` for bools)\n")
    }
    else if code == 6 {
        print("   |\n   = help: use a comparison operator (e.g., `==`, `!=`, `<`, `>`) to produce a boolean\n")
    }
    else if code == 7 {
        print("   |\n   = help: ensure both branches return the same type, or use explicit conversion\n")
    }
    else if code == 8 {
        print("   |\n   = help: change the return value type to match the function's declared return type\n")
    }
    else if code == 9 {
        print("   |\n   = help: check the function signature and provide an argument of the correct type\n")
    }
    else if code == 10 {
        print("   |\n   = help: check the function signature for the correct number of arguments\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   |\n   = help: check the method name and ensure it is defined for this type\n")
    }
    else if code == 12 {
        print("   |\n   = help: check the field name in the type definition\n")
    }
    else if code == 13 {
        print("   |\n   = help: use square brackets `[]` only on array types\n")
    }
    else if code == 14 {
        print("   |\n   = help: use an integer type (i8, i32, i64, u8, u32, u64) for array indices\n")
    }
    else if code == 15 {
        print("   |\n   = help: ensure the struct is defined or imported in this module\n")
    }
    else if code == 16 {
        print("   |\n   = help: ensure the field initializer matches the declared field type\n")
    }
    // Callables/control flow (17-21)
    else if code == 17 {
        print("   |\n   = help: only functions and methods can be called with parentheses\n")
    }
    else if code == 18 {
        print("   |\n   = help: all match arms must return the same type\n")
    }
    else if code == 19 {
        print("   |\n   = help: method calls using `.` syntax are only supported on structs and built-in types\n")
    }
    else if code == 20 {
        print("   |\n   = help: arrays require all elements to have the same type; consider using a tuple for mixed types\n")
    }
    else if code == 21 {
        print("   |\n   = help: compound assignments like `+=` require the operands to be compatible\n")
    }
    // Epistemic (22)
    else if code == 22 {
        print("   |\n   = help: epsilon must be a value between 0.0 (certain) and 1.0 (unknown)\n")
    }
    // Hypercomplex (30-34)
    else if code == 30 {
        print("   |\n   = help: values from different hypercomplex algebras cannot be combined directly\n")
    }
    else if code == 31 {
        print("   |\n   = help: add `with Div` to the function signature to enable division\n")
    }
    else if code == 32 {
        print("   |\n   = help: octonions, sedenions, and clifford algebras do not support division\n")
    }
    else if code == 33 {
        print("   |\n   = help: clifford algebras must have the same (p,q) signature to be combined\n")
    }
    else if code == 34 {
        print("   |\n   = help: hypercomplex algebras cannot be narrowed to a lower-dimensional algebra\n")
    }
    // Effects (35)
    else if code == 35 {
        print("   |\n   = help: add the missing effect to the function's `with` clause\n")
    }
    // Epistemic propagation (36)
    else if code == 36 {
        print("   |\n   = help: tighten the epsilon bound or use a more precise measurement\n")
    }
    // Borrow checker (37-40)
    else if code == 37 {
        print("   |\n   = help: shared borrows (`&x`) cannot coexist with exclusive borrows (`&!x`)\n")
    }
    else if code == 38 {
        print("   |\n   = help: drop other borrows before acquiring an exclusive borrow (`&!x`)\n")
    }
    else if code == 39 {
        print("   |\n   = help: linear values can only be used once; clone the value if needed\n")
    }
    else if code == 40 {
        print("   |\n   = help: consume the linear value by using it in a function call or assignment\n")
    }
    // Units/refinement (41-43)
    else if code == 41 {
        print("   |\n   = help: convert units before combining values in arithmetic operations\n")
    }
    else if code == 42 {
        print("   |\n   = help: the value violates the refinement type constraint\n")
    }
    else if code == 43 {
        print("   |\n   = help: unit conversions require compatible dimensions (e.g., meters to kilometers)\n")
    }
    // Phase A additions (44-51)
    else if code == 44 {
        print("   |\n   = help: move `break` inside a `while` or `loop` block\n")
    }
    else if code == 45 {
        print("   |\n   = help: move `continue` inside a `while` or `loop` block\n")
    }
    else if code == 46 {
        print("   |\n   = help: provide values for all fields declared in the struct definition\n")
    }
    else if code == 47 {
        print("   |\n   = help: tuple indices must be within the tuple's element count\n")
    }
    else if code == 48 {
        print("   |\n   = help: bitwise operators (`&`, `|`, `^`) require integer operands\n")
    }
    else if code == 49 {
        print("   |\n   = help: shift operators (`<<`, `> >`) require integer operands\n")
    }
    else if code == 50 {
        print("   |\n   = help: modulo operator (`%`) requires integer operands\n")
    }
    else if code == 51 {
        print("   |\n   = help: logical operators (`&&`, `||`) require boolean operands\n")
    }
    // Phase B.3 additions (52-54)
    else if code == 52 {
        print("   |\n   = help: provide a value that satisfies the refinement predicate\n")
    }
    else if code == 53 {
        print("   |\n   = help: add the required effect to the closure's signature\n")
    }
    else if code == 54 {
        print("   |\n   = help: check the Knowledge metadata for valid constraint syntax\n")
    }
    else if code == 55 {
        print("   |\n   = help: range endpoints must be integers (i32 or i64)\n")
    }
    else if code == 56 {
        print("   |\n   = help: dividing by zero is undefined; check the denominator\n")
    }
    else if code == 57 {
        print("   |\n   = help: modulo by zero is undefined; check the divisor\n")
    }
    else if code == 58 {
        print("   |\n   = help: call prove_robust(contest_expr, policy_expr) with Contest<T> and Policy<T> over the same T\n")
    }
    else if code == 59 {
        print("   |\n   = help: bind the expression with an explicit type such as `let c: Contest<T> = contest [...] on data`\n")
    }
    else if code == 63 {
        print("   |\n   = help: use Model<I, O>, Contest<T, Family, Policy>, Robust<T, Level, Scope>, or the legacy single-argument migration forms with the correct arity\n")
    }
    else if code == 79 {
        print("   |\n   = help: pass a Contest<T, Family, Policy> value instead of a plain datum or downstream proof token\n")
    }
    else if code == 80 {
        print("   |\n   = help: ensure the contest was realized through an explicit Contest<T, Family, Policy> annotation before calling witness builtins\n")
    }
    else if code == 81 {
        print("   |\n   = help: attach or compute the missing contest metric before projecting it\n")
