fn call_expr_is_builtin_plan_recourse(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str13((*expr).name, 112, 108, 97, 110, 95, 114, 101, 99, 111, 117, 114, 115, 101)
        }
        None => false
