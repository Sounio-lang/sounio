fn expr_list_head(opt: Option<Box<ExprList>>) -> Option<Box<Expr>> with Alloc {
    match opt {
        Some(list) => Some(Box::new((*list).head))
        None => None
    }
}

fn expr_list_second(opt: Option<Box<ExprList>>) -> Option<Box<Expr>> with Alloc {
    match opt {
        Some(list) => {
            match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
        }
        None => None
    }
}

fn expr_list_third(opt: Option<Box<ExprList>>) -> Option<Box<Expr>> with Alloc {
    match opt {
        Some(list) => {
            match (*list).tail {
                Some(rest) => {
                    match (*rest).tail {
                        Some(last) => Some(Box::new((*last).head))
                        None => None
                    }
                }
                None => None
            }
        }
        None => None
    }
}

fn checker_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn checker_copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => checker_copy_string_list_tail_to_name(*rest)
        None => checker_copy_string_list_to_name(seg)
    }
}

fn contest_model_list_present(opt: Option<Box<ExprList>>) -> bool {
    match opt {
        Some(_) => true
        None => false
    }
}

fn contest_model_name(e: Expr) -> Name with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprPath {
        checker_copy_string_list_tail_to_name(e.path.segments)
    } else if e.kind == ExprKind::ExprIdent {
        e.name
    } else {
        empty_name()
    }
}

fn contest_info_from_expr_models(opt: Option<Box<ExprList>>) -> ContestInfo with Mut, Panic, Div, Alloc {
    let info = empty_contest_info()
    contest_info_from_expr_models_loop(opt, info, 0)
}

fn contest_info_from_expr_models_loop(opt: Option<Box<ExprList>>, info: ContestInfo, idx: i64) -> ContestInfo with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = info
            if idx < 16 {
                next.model_names[idx as usize] = contest_model_name((*list).head)
                next.model_count = idx + 1
            }
            contest_info_from_expr_models_loop((*list).tail, next, idx + 1)
        }
        None => info
    }
}

fn model_input_ty(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    type_entry_list_get(ty.tuple_elems, 0)
}

fn model_output_ty(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    type_entry_list_get(ty.tuple_elems, 1)
}

fn contest_model_lists_match(opt: Option<Box<ExprList>>, family: ModelFamilyInfo, idx: i64) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            if idx >= family.model_count || idx >= 16 {
                return false
            }
            if !name_eq(contest_model_name((*list).head), family.model_names[idx as usize]) {
                return false
            }
            contest_model_lists_match((*list).tail, family, idx + 1)
        }
        None => idx == family.model_count
    }
}

fn contest_info_from_family_signature(family: ModelFamilyInfo, policy_id: i64) -> ContestInfo with Mut, Panic, Div {
    var info = empty_contest_info()
    info.family_id = -1
    info.policy_id = policy_id
    info.model_count = family.model_count
    var i: i64 = 0
    while i < family.model_count && i < 16 {
        info.model_names[i as usize] = family.model_names[i as usize]
        i = i + 1
    }
    info
}

fn contest_info_attach_span(info: ContestInfo, span: Span) -> ContestInfo {
    var next = info
    next.span_start = span.start
    next.span_end = span.end
    next
}

fn contest_info_attach_family_id(info: ContestInfo, family_id: i64) -> ContestInfo {
    var next = info
    next.family_id = family_id
    next
}

fn audit_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str14(name, 115, 105, 103, 110, 95, 99, 111, 110, 115, 101, 110, 115, 117, 115) {
        return CONTEST_METRIC_SIGN_CONSENSUS
    }
    if name_matches_str13(name, 114, 101, 108, 97, 116, 105, 118, 101, 95, 98, 97, 110, 100) {
        return CONTEST_METRIC_RELATIVE_BAND
    }
    if name_matches_str13(name, 109, 97, 120, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return CONTEST_METRIC_MAX_TAIL_RISK
    }
    if name_matches_str21(name, 105, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 95, 102, 108, 111, 111, 114) {
        return CONTEST_METRIC_IDENTIFIABILITY_FLOOR
    }
    -1
}

fn audit_mechanistic_field_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str20(name, 97, 103, 103, 114, 101, 103, 97, 116, 101, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return 0
    }
    if name.len == 23
        && name.buf[0] == 108 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 110 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 95 as i8 && name.buf[7] == 115 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 97 as i8 && name.buf[10] == 116 as i8 && name.buf[11] == 101 as i8
        && name.buf[12] == 95 as i8 && name.buf[13] == 100 as i8 && name.buf[14] == 105 as i8
        && name.buf[15] == 118 as i8 && name.buf[16] == 101 as i8 && name.buf[17] == 114 as i8
        && name.buf[18] == 103 as i8 && name.buf[19] == 101 as i8 && name.buf[20] == 110 as i8
        && name.buf[21] == 99 as i8 && name.buf[22] == 101 as i8 {
        return 1
    }
    if name.len == 31
        && name.buf[0] == 99 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 117 as i8
        && name.buf[3] == 115 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 108 as i8
        && name.buf[6] == 95 as i8 && name.buf[7] == 100 as i8 && name.buf[8] == 101 as i8
        && name.buf[9] == 99 as i8 && name.buf[10] == 111 as i8 && name.buf[11] == 109 as i8
        && name.buf[12] == 112 as i8 && name.buf[13] == 111 as i8 && name.buf[14] == 115 as i8
        && name.buf[15] == 105 as i8 && name.buf[16] == 116 as i8 && name.buf[17] == 105 as i8
        && name.buf[18] == 111 as i8 && name.buf[19] == 110 as i8 && name.buf[20] == 95 as i8
        && name.buf[21] == 100 as i8 && name.buf[22] == 105 as i8 && name.buf[23] == 118 as i8
        && name.buf[24] == 101 as i8 && name.buf[25] == 114 as i8 && name.buf[26] == 103 as i8
        && name.buf[27] == 101 as i8 && name.buf[28] == 110 as i8 && name.buf[29] == 99 as i8
        && name.buf[30] == 101 as i8 {
        return 2
    }
    if name.len == 32
        && name.buf[0] == 105 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 118 as i8
        && name.buf[6] == 101 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 105 as i8 && name.buf[10] == 111 as i8 && name.buf[11] == 110 as i8
        && name.buf[12] == 95 as i8 && name.buf[13] == 114 as i8 && name.buf[14] == 101 as i8
        && name.buf[15] == 115 as i8 && name.buf[16] == 112 as i8 && name.buf[17] == 111 as i8
        && name.buf[18] == 110 as i8 && name.buf[19] == 115 as i8 && name.buf[20] == 101 as i8
        && name.buf[21] == 95 as i8 && name.buf[22] == 100 as i8 && name.buf[23] == 105 as i8
        && name.buf[24] == 118 as i8 && name.buf[25] == 101 as i8 && name.buf[26] == 114 as i8
        && name.buf[27] == 103 as i8 && name.buf[28] == 101 as i8 && name.buf[29] == 110 as i8
        && name.buf[30] == 99 as i8 && name.buf[31] == 101 as i8 {
