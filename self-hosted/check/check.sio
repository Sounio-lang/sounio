            }
            print(", id=")
            print_int(ty.array_size)
            print(", class=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        // Ten TypeKind variants had no arm here. The build printed
        //   error: match must be exhaustive at self-hosted/check/check.sio:11624
        // and exited 0 -- the arms were missing, not merely unreachable. They
        // became visible only once #2215 stopped a nested `match ty.inner` from
        // clobbering this outer match's scrutinee identity, so exhaustiveness had
        // been decided against the wrong enum. This is a diagnostic printer: a
        // missing arm is a type that renders as nothing in an error message.
        //
        // Nine of the ten wrap an inner type, so they follow the TyLemma/TyAxiom
        // shape rather than printing a bare name and losing what they wrap.
        TypeKind::TyEpistemic => {
            print("Epistemic<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
