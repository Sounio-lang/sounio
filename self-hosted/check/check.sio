fn checker_store_from_value(dst: *mut Checker, src: Checker) with Mut, Panic, Div, Alloc {
    let prev_error_count = (*dst).error_count
    (*dst).env = src.env
    (*dst).borrows = src.borrows
    (*dst).units = src.units
    (*dst).refinements = src.refinements
    (*dst).structs = src.structs
    (*dst).enums = src.enums
    (*dst).fn_sigs = src.fn_sigs
    (*dst).algebras = src.algebras
    (*dst).studies = src.studies
    (*dst).ontologies = src.ontologies
    (*dst).ontology_kernel = src.ontology_kernel
    (*dst).ontology_cache_shadow_slot_count = src.ontology_cache_shadow_slot_count
    (*dst).ontology_cache_shadow_slots = src.ontology_cache_shadow_slots
    (*dst).ontology_cache_shadow_subclass_matrix = src.ontology_cache_shadow_subclass_matrix
    (*dst).hyper_exprs = src.hyper_exprs
    (*dst).models = src.models
    (*dst).model_families = src.model_families
    (*dst).policies = src.policies
    (*dst).decision_policies = src.decision_policies
    (*dst).deferral_policies = src.deferral_policies
    (*dst).acquisition_policies = src.acquisition_policies
    (*dst).recourse_policies = src.recourse_policies
    (*dst).alternative_policies = src.alternative_policies
    (*dst).validations = src.validations
    (*dst).contests = src.contests
    (*dst).audits = src.audits
    (*dst).mechanistic_reports = src.mechanistic_reports
    (*dst).posterior_weights = src.posterior_weights
    (*dst).counterexamples = src.counterexamples
    (*dst).contest_witnesses = src.contest_witnesses
    (*dst).robust_proofs = src.robust_proofs
    (*dst).decision_certificates = src.decision_certificates
    (*dst).deferred_certificates = src.deferred_certificates
    (*dst).deferred_reason_witnesses = src.deferred_reason_witnesses
    (*dst).acquisition_plans = src.acquisition_plans
    (*dst).acquisition_reason_witnesses = src.acquisition_reason_witnesses
    (*dst).recourse_plans = src.recourse_plans
    (*dst).recourse_reason_witnesses = src.recourse_reason_witnesses
    (*dst).transition_policies = src.transition_policies
    (*dst).transition_protocols = src.transition_protocols
    (*dst).transition_steps = src.transition_steps
    (*dst).transition_plans = src.transition_plans
    (*dst).transition_reason_witnesses = src.transition_reason_witnesses
    (*dst).monitoring_policies = src.monitoring_policies
    (*dst).observed_transitions = src.observed_transitions
    (*dst).rollback_certificates = src.rollback_certificates
    (*dst).alternative_frontiers = src.alternative_frontiers
    (*dst).alternative_candidates = src.alternative_candidates
    (*dst).alternative_sets = src.alternative_sets
    (*dst).alternative_reason_witnesses = src.alternative_reason_witnesses
    (*dst).validated_manifests = src.validated_manifests
    (*dst).error_count = src.error_count
    (*dst).warning_count = src.warning_count
    (*dst).had_error = src.had_error
    if src.error_count > prev_error_count {
        (*dst).diag_emitted = true
    } else {
        (*dst).diag_emitted = (*dst).diag_emitted || src.diag_emitted
    }
    (*dst).current_return_type = src.current_return_type
    (*dst).current_impl_type = src.current_impl_type
    (*dst).current_effects = src.current_effects
    (*dst).current_effect_count = src.current_effect_count
    (*dst).current_sig_id = src.current_sig_id
    (*dst).current_sig_name = src.current_sig_name
    (*dst).multitest_count = src.multitest_count
    (*dst).multitest_corrected = src.multitest_corrected
    (*dst).last_literal_int = src.last_literal_int
    (*dst).last_literal_float = src.last_literal_float
    (*dst).last_literal_kind = src.last_literal_kind
    (*dst).loop_depth = src.loop_depth
    (*dst).suppress_linear_consume_depth = src.suppress_linear_consume_depth
    (*dst).type_depth = src.type_depth
    (*dst).expr_depth = src.expr_depth
    (*dst).complexity_budget = src.complexity_budget
    (*dst).const_int_name_bufs = src.const_int_name_bufs
    (*dst).const_int_name_lens = src.const_int_name_lens
    (*dst).const_int_values = src.const_int_values
    (*dst).const_int_known = src.const_int_known
    (*dst).const_int_count = src.const_int_count
    (*dst).const_int_scope_marks = src.const_int_scope_marks
    (*dst).const_int_scope_depth = src.const_int_scope_depth
    (*dst).effects = src.effects
    (*dst).effect_ops = src.effect_ops
    (*dst).handler_depth = src.handler_depth
    (*dst).current_handler_op_id = src.current_handler_op_id
    (*dst).ownership = src.ownership
    (*dst).trait_registry = src.trait_registry
    (*dst).impl_registry = src.impl_registry
    (*dst).refine_static_proved = src.refine_static_proved
    (*dst).refine_runtime_checked = src.refine_runtime_checked
    (*dst).refine_violations = src.refine_violations
    (*dst).refine_cond_env = src.refine_cond_env
    (*dst).ontology_items = src.ontology_items
    (*dst).ns_table = src.ns_table
    (*dst).ns_source_issued = src.ns_source_issued
    (*dst).last_call_arg_ns = src.last_call_arg_ns
    (*dst).ns_proj = src.ns_proj
    (*dst).ns_branch_depth = src.ns_branch_depth
    (*dst).ns_reassigned_names = src.ns_reassigned_names
    (*dst).ns_reassigned_count = src.ns_reassigned_count
    (*dst).ns_reassigned_overflow = src.ns_reassigned_overflow
}

fn checker_note_type_error_mut(c: *mut Checker) with Mut {
    (*c).error_count = (*c).error_count + 1
    (*c).had_error = true
}

// Emit a fallback diagnostic when had_error was recorded without printing.
// Boot4/modular path uses checker_check_items_inplace which notes errors via
// checker_note_type_error_mut without emitting; this closes the silent gap.
fn checker_flush_unemitted_type_errors_mut(c: *mut Checker) with Mut, IO {
    if (*c).had_error && !(*c).diag_emitted {
        print("error[E000]: type checking failed\n")
        (*c).diag_emitted = true
    }
}

fn checker_enter_type_expr_mut(c: *mut Checker) -> bool with Mut, Panic, Div {
    if (*c).type_depth >= MAX_TYPE_DEPTH {
        checker_note_type_error_mut(c)
        return false
    }
    if (*c).complexity_budget + 1 > MAX_TYPE_COMPLEXITY {
        checker_note_type_error_mut(c)
        return false
    }
    (*c).type_depth = (*c).type_depth + 1
    (*c).complexity_budget = (*c).complexity_budget + 1
    true
}

fn checker_exit_type_expr_mut(c: *mut Checker) with Mut {
    if (*c).type_depth > 0 {
        (*c).type_depth = (*c).type_depth - 1
    }
    if (*c).complexity_budget > 0 {
        (*c).complexity_budget = (*c).complexity_budget - 1
    }
}

fn checker_lower_named_type_mut(c: *mut Checker, path: AstPath) -> TypeEntry with Mut, Panic, Div, Alloc {
    let name = checker_copy_string_list_to_name(path.segments)
    if name_is_i8(name) {
        ty_i8()
    } else if name_is_i32(name) {
        ty_i32()
    } else if name_is_i64(name) {
        ty_i64()
    } else if name_is_u8(name) {
        ty_u8()
    } else if name_is_u32(name) {
        ty_u32()
    } else if name_is_u64(name) {
        ty_u64()
    } else if name_is_usize(name) {
        ty_i64()
    } else if name_is_f32(name) {
        ty_f32()
    } else if name_is_f64(name) {
        ty_f64()
    } else if name_is_f128(name) {
        ty_f128()
    } else if name_is_f256(name) {
        ty_f256()
    } else if name_is_bool(name) {
        ty_bool()
    } else if name_is_string(name) {
        ty_string()
    } else if name_is_char(name) {
        ty_char()
    } else if name_is_i128(name) {
        ty_i128()
    } else if name_is_u128(name) {
        ty_u128()
    } else if name_wide_int_bits(name) > 0 {
        ty_wide_int(name_wide_int_bits(name), (name.buf[0] as i64) == 105)
    } else {
        let bound_ty = (*c).env.lookup(name)
        // A type-position name resolves against the VALUE environment first so
        // that type aliases and ontology bindings win. But `use m::{S}` binds
        // every imported name here as TyUnknown — see
        // checker_collect_use_item_inplace, whose comment calls binding an
        // extra name "harmless if unused". It is not harmless: an imported
        // STRUCT name lands in env carrying no information, and this lookup
        // then returned that TyUnknown in place of the struct.
        //
        // The whole of it: single-module code has no `use`, so nothing shadows
        // and `ty_named` is reached; the moment the same file is compiled as
        // part of a closure, every annotation, parameter and return type naming
        // an imported struct silently became unknown, every field access on one
        // read `()`, and the constructors written `var out: T` had nothing left
        // to take a type from. Struct literals kept working because they go to
        // struct_table_find directly and never come through here, which is why
        // this looked like a let/var bug for hours.
        //
        // A binding that carries no information must not outrank a type that
        // does. Imported names are bound as TyUnknown even when the struct is
        // not yet in this module's table — treating that Unknown as informative
        // made `fn forge() -> Epistemic { 1.0 }` typecheck. Match the
        // by-value spine: Unknown/Error/Never fall through to ty_named.
        let bound_is_informative = bound_ty.kind != TypeKind::TyError
            && bound_ty.kind != TypeKind::TyUnknown
            && bound_ty.kind != TypeKind::TyNever
        if bound_is_informative || bound_ty.ontology_id >= 0 {
            bound_ty
        } else {
            ty_named(name)
        }
    }
}

fn checker_lower_single_wrapper_arg_mut(c: *mut Checker, opt: Option<Box<TypeExprList> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args) => {
            match (*args).tail {
                None => checker_lower_type_expr_mut(c, (*args).head)
                Some(_) => {
                    checker_note_type_error_mut(c)
                    ty_error()
                }
            }
        }
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
    }
}

fn checker_lower_model_type_mut(c: *mut Checker, opt: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args) => {
            match (*args).tail {
                Some(rest) => {
                    match (*rest).tail {
                        None => {
                            let input_ty = checker_lower_type_expr_mut(c, (*args).head)
                            let output_ty = checker_lower_type_expr_mut(c, (*rest).head)
                            if input_ty.kind == TypeKind::TyError || output_ty.kind == TypeKind::TyError {
                                ty_error()
                            } else {
                                ty_model(input_ty, output_ty)
                            }
                        }
                        Some(_) => {
                            checker_report_error_at_inplace(c, span, 63, 0, 0, 0)
                            ty_error()
                        }
                    }
                }
                None => {
                    checker_report_error_at_inplace(c, span, 63, 0, 0, 0)
                    ty_error()
                }
            }
        }
        None => {
            checker_report_error_at_inplace(c, span, 63, 0, 0, 0)
            ty_error()
        }
    }
}

// In-place TypeNamed lowering, with Box<T> carrying its element type as `inner`.
// The in-place spine otherwise drops type_args for named types, so a declared
// `Box<T>` parameter lost T and `*b` reported E005. Here Box<T> lowers to
// ty_named("Box") with inner=Some(T) (mirrors how &T carries its pointee), so
// deref types as T. Every other named type — and bare/ill-arity `Box` — defers
// to checker_lower_named_type_mut unchanged. type_args is taken by value into
// this *mut helper exactly as checker_lower_single_wrapper_arg_mut does.
// Feature B (Invariant<T,G>): map the group type-argument's name to its lattice rank
// 1..4 (DiffInf<Diff1<BiLip<Homeo); 0 if it is not one of the four named groups.
fn invariance_rank_from_group_name(n: Name) -> i64 with Panic, Div {
    if name_matches_str7(n, 68, 105, 102, 102, 73, 110, 102) { return 1 }  // DiffInf
    if name_matches_str5(n, 68, 105, 102, 102, 49) { return 2 }            // Diff1
    if name_matches_str5(n, 66, 105, 76, 105, 112) { return 3 }            // BiLip
    if name_matches_str5(n, 72, 111, 109, 101, 111) { return 4 }           // Homeo
    0
}

// Feature B: recover the group rank 1..4 of an Invariant<T,G> type; 0 otherwise.
// The mangled-name encoding lives in one place — compat::compat_invariant_rank.
fn invariant_group_rank_of_type(ty: TypeEntry) -> i64 with Panic, Div {
    compat_invariant_rank(ty)
}

// Feature B: build the mangled TyNamed for Invariant<T,G> from a group rank.
fn invariant_named_type(rank: i64, inner_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div {
    let nm = if rank == 1 { make_name("Invariant1") }
        else if rank == 2 { make_name("Invariant2") }
        else if rank == 3 { make_name("Invariant3") }
        else { make_name("Invariant4") }
    var bte = ty_named(nm)
    bte.inner = Some(Box::new(inner_ty))
    bte
}

// Feature B (FrameId): Invariant<T,G,F> lowers to TyNamed "Invariant<rank>$<frame>",
// inner = T. The frame name lets two same-group invariants in the SAME frame be
// compared (identity transform), while different/absent frames fall back to the
// conservative cross-frame rule. Mirrors the rank/frame decode in compat.sio.
fn invariant_framed_named_type(rank: i64, frame: Name, inner_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div {
    var nm = make_name("Invariant0")     // 10-char base; overwrite the digit, then append
    nm.buf[9] = (48 + rank) as i8        // rank digit '1'..'4'
    nm.buf[10] = 36 as i8                // '$'
    var i: i64 = 0
    while i < frame.len && (11 + i) < 128 {
        nm.buf[(11 + i) as usize] = frame.buf[i as usize]
        i = i + 1
    }
    var newlen = 11 + frame.len
    if newlen > 128 { newlen = 128 }
    nm.len = newlen
    var bte = ty_named(nm)
    bte.inner = Some(Box::new(inner_ty))
    bte
}

fn checker_lower_named_type_with_args_mut(c: *mut Checker, path: AstPath, type_args: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let name = checker_copy_string_list_to_name(path.segments)
    // ZD surgical family. The *mut match on TypeExprKind maps every
    // discriminant onto TypeNamed, so ExactlyPrivate<T> arrives here as a
    // name + type_args, the same way Seq and Hyper already do. Interrogate
    // the name and do what the by-value spine does: lower the inner type
    // and demand the enclosing `with` clause.
    if name_matches_str11(name, 70, 111, 114, 103, 101, 116, 116, 97, 98, 108, 101) {
        return checker_lower_zd_named_mut(c, type_args, span, 200)
    }

    // IndepKnowledge<T, A, B | Z> -- conditional independence as a type.
    //
    // This is the PRODUCTION spine. The by-value lower_named_type_with_args
    // carries the same rule, but nothing outside tests/ calls it, so a guard
    // that lives only there passes every claim while appearing to check them.
    if name_matches_str14(name, 73, 110, 100, 101, 112, 75, 110, 111, 119, 108, 101, 100, 103, 101) {
        match type_args {
            None => {
                checker_report_error_at_inplace(c, span, 72, 0, 0, 0)
                return ty_error()
            }
            Some(args) => {
                let t_expr = (*args).head
                let rest1 = match (*args).tail {
                    None => {
                        checker_report_error_at_inplace(c, span, 72, 0, 0, 0)
                        return ty_error()
                    }
                    Some(r) => *r
                }
                let a_expr = rest1.head
                let rest2 = match rest1.tail {
                    None => {
                        checker_report_error_at_inplace(c, span, 72, 0, 0, 0)
                        return ty_error()
                    }
                    Some(r) => *r
                }
                let b_expr = rest2.head

                // A and B name variables, not types.
                if a_expr.kind != TypeExprKind::TypeNamed {
                    checker_report_error_at_inplace(c, a_expr.span, 72, 0, 0, 0)
                    return ty_error()
                }
                if b_expr.kind != TypeExprKind::TypeNamed {
                    checker_report_error_at_inplace(c, b_expr.span, 72, 0, 0, 0)
                    return ty_error()
                }

                let cond_id = match rest2.tail {
                    None => 0 - 1
                    Some(r) => indep_cond_set_id((*r).head)
                }
                let base_ty = checker_lower_type_expr_mut(c, t_expr)
                let a_id = indep_var_id(checker_copy_string_list_to_name(a_expr.path.segments))
                let b_id = indep_var_id(checker_copy_string_list_to_name(b_expr.path.segments))

                // A variable is not independent of itself; the claim asserts
                // nothing, and asserting nothing is how an unfounded quadrature
                // gets licensed.
                if a_id == b_id {
                    checker_report_error_at_inplace(c, b_expr.span, 72, 0, 0, 0)
                    return ty_error()
                }

                // With a graph declared in source the claim becomes an
                // obligation discharged by d-separation. Without one, only the
                // degeneracy rule above can be known.
                if CG_DECLARED == 1 {
                    let a_node = ast_cg_find_node(a_id)
                    if a_node < 0 {
                        checker_report_error_at_inplace(c, a_expr.span, 254, 0, 0, 0)
                        return ty_error()
                    }
                    let b_node = ast_cg_find_node(b_id)
                    if b_node < 0 {
                        checker_report_error_at_inplace(c, b_expr.span, 254, 0, 0, 0)
                        return ty_error()
                    }
                    let cond_args = match rest2.tail {
                        None => None
                        Some(zr) => (*zr).head.type_args
                    }
                    let zpair = checker_cg_zset(cond_args)
                    if !zpair.0 {
                        checker_report_error_at_inplace(c, b_expr.span, 254, 0, 0, 0)
                        return ty_error()
                    }
                    let g = checker_cg_build()
                    if !causal_d_separated(g, a_node, b_node, zpair.1) {
                        checker_report_error_at_inplace(c, b_expr.span, 255, 0, 0, 0)
                        return ty_error()
                    }
                }

                return ty_cond_indep(base_ty, a_id, b_id, cond_id, 0.0 - 1.0)
            }
        }
    }
    if name_matches_str14(name, 69, 120, 97, 99, 116, 108, 121, 80, 114, 105, 118, 97, 116, 101) {
        return checker_lower_exactly_private_named_mut(c, type_args, span)
    }
    if name_matches_str8(name, 69, 100, 105, 116, 97, 98, 108, 101) {
        return checker_lower_zd_named_mut(c, type_args, span, 202)
    }
    if name_matches_str15(name, 67, 97, 112, 97, 98, 105, 108, 105, 116, 121, 71, 97, 116, 101, 100) {
        return checker_lower_zd_named_mut(c, type_args, span, 203)
    }
    if name_matches_str10(name, 67, 111, 109, 112, 111, 115, 97, 98, 108, 101) {
        return checker_lower_zd_named_mut(c, type_args, span, 204)
    }
    if name_matches_str7(name, 65, 117, 100, 105, 116, 101, 100) {
        return checker_lower_audited_named_mut(c, type_args, span)
    }
    if name_matches_str9(name, 82, 101, 118, 105, 118, 97, 98, 108, 101) {
        return checker_lower_revivable_named_mut(c, type_args, span)
    }
    if name_matches_str13(name, 73, 110, 116, 101, 114, 112, 114, 101, 116, 97, 98, 108, 101) {
        return checker_lower_zd_named_mut(c, type_args, span, 207)
    }
    // Seq<T>: language-level growable sequence (lean_single TY_SEQ). Lower to
    // ty_seq(elem) so methods/index see the element type. Without this, Seq is a
    // bare TyNamed and kaxi/ontology/model fail under Madaros check.
    // NOTE: checker_lower_type_expr_list_mut returns TypeEntryList (not Option).
    if name_matches_str3(name, 83, 101, 113) {
        match type_args {
            Some(args) => {
                let lowered = checker_lower_type_expr_list_mut(c, *args)
                // One type argument only (Seq<T>).
                match lowered.tail {
                    None => {
                        return ty_seq_named(make_name("Seq"), lowered.head)
                    }
                    Some(_) => {}
                }
            }
            None => {
                // Bare Seq — element unknown until annotation/use.
                return ty_seq_named(make_name("Seq"), ty_unknown())
            }
        }
    }
    // Hyper<Algebra, T> — first-class hypercomplex type (Octonion/Sedenion/…). The non-inplace
    // resolver lower_named_type_with_args handles this at :14322; the inplace resolver (the one
    // that actually runs during checking) was missing it, so `Hyper<Octonion, f64>` degraded to
    // TyNamed("Hyper") and `a * h` never reached check_hyper_binary. Mirror the branch here.
    if name_matches_str5(name, 72, 121, 112, 101, 114) {
        match type_args {
            Some(args) => {
                let alg_expr = (*args).head
                var elem_expr = alg_expr
                match (*args).tail {
                    Some(rest) => { elem_expr = (*rest).head }
                    None => { checker_note_type_error_mut(c) return ty_error() }
                }
                if alg_expr.kind != TypeExprKind::TypeNamed {
                    checker_note_type_error_mut(c)
                    return ty_error()
                }
                let alg_name = checker_copy_string_list_to_name(alg_expr.path.segments)
                let algebra_tag = resolve_algebra_name(alg_name)
                if algebra_tag < 0 {
                    checker_note_type_error_mut(c)
                    return ty_error()
                }
                let elem_ty = checker_lower_type_expr_mut(c, elem_expr)
                return ty_hyper(algebra_tag, elem_ty)
            }
            None => { checker_note_type_error_mut(c) return ty_error() }
        }
    }
    // Feature B: Invariant<T, G> — second type-arg G is one of the four named
    // invariance groups; lower to TyNamed "Invariant<rank>" with inner = T.
    if name_matches_str9(name, 73, 110, 118, 97, 114, 105, 97, 110, 116) {
        match type_args {
            Some(args) => {
                match (*args).tail {
                    Some(rest) => {
                        match (*rest).tail {
                            None => {
                                let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
                                if inner_ty.kind == TypeKind::TyError {
                                    return ty_error()
                                }
                                let g_name = checker_copy_string_list_to_name((*rest).head.path.segments)
                                let rank = invariance_rank_from_group_name(g_name)
                                if rank == 0 {
                                    checker_note_type_error_mut(c)
                                    return ty_error()
                                }
                                return invariant_named_type(rank, inner_ty)
                            }
                            Some(third) => {
                                match (*third).tail {
                                    None => {
                                        // 3 args: Invariant<T, G, F>
                                        let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
                                        if inner_ty.kind == TypeKind::TyError {
                                            return ty_error()
                                        }
                                        let g_name = checker_copy_string_list_to_name((*rest).head.path.segments)
                                        let rank = invariance_rank_from_group_name(g_name)
                                        if rank == 0 {
                                            checker_note_type_error_mut(c)
                                            return ty_error()
                                        }
                                        let f_name = checker_copy_string_list_to_name((*third).head.path.segments)
                                        return invariant_framed_named_type(rank, f_name, inner_ty)
                                    }
                                    Some(_) => {
                                        checker_note_type_error_mut(c)
                                        return ty_error()
                                    }
                                }
                            }
                        }
                    }
                    None => {
                        checker_note_type_error_mut(c)
                        return ty_error()
                    }
                }
            }
            None => {
                checker_note_type_error_mut(c)
                return ty_error()
            }
        }
    }
    // Carry the single type argument in .inner for Box<T> and Option<T>. Box was
    // already handled (so `*b` on a Box<T> param types as T); Option<T> needs the
    // same so that `match opt { Some(x) => ... }` can bind x to the payload type
    // T (the PatEnum binder reads scrut_ty.inner). "Box"=66,111,120 ;
    // "Option"=79,112,116,105,111,110. Other named types defer unchanged.
    if name_matches_str3(name, 66, 111, 120) || name_matches_str6(name, 79, 112, 116, 105, 111, 110) {
        match type_args {
            Some(args) => {
                match (*args).tail {
                    None => {
                        let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
                        if inner_ty.kind == TypeKind::TyError {
                            return ty_error()
                        }
                        var bte = ty_named(name)
                        bte.inner = Some(Box::new(inner_ty))
                        return bte
                    }
                    Some(_) => {
                        return checker_lower_named_type_mut(c, path)
                    }
                }
            }
            None => {
                return checker_lower_named_type_mut(c, path)
            }
        }
    }
    // Generic struct type application: `S<T>` / `S<F>` must monomorphize to the
    // mangled name `S__T` / `S__F` — matching the by-value lower_named_type_with_args
    // and checker_check_struct_lit_inplace paths. Without this the *mut spine (the
    // path that actually runs during check) dropped type_args and returned bare
    // `ty_named(S)`, so a body `return S { .. }` typed as `S__F` failed E008
    // (expected S / found S__F) and field element methods on F failed E011.
    // See Wave11 cd_exact_generic_i64 / ExactRing residual.
    match type_args {
        Some(args) => {
            let tmpl_idx = struct_table_find((*c).structs, name)
            if tmpl_idx >= 0 {
                let tmpl = struct_table_get((*c).structs, tmpl_idx)
                if tmpl.is_generic_template {
                    let lowered_args = checker_lower_type_expr_list_mut(c, *args)
                    let tmpl_name = tmpl.name
                    let tmpl_fields = field_info_list_clone(&tmpl.fields)
                    let tmpl_tp_buf = TypeParamBuf { names: tmpl.type_param_names, count: tmpl.type_param_count }
                    let tmpl_is_linear = tmpl.is_linear
                    let tmpl_visibility_kind = tmpl.visibility_kind
                    let tmpl_defining_module_id = tmpl.defining_module_id
                    let tmpl_visibility = tmpl.visibility
                    let tmpl_defining_module = tmpl.defining_module
                    let mangled = mangle_generic_name(&tmpl_name, &lowered_args)
                    let existing_idx = struct_table_find((*c).structs, mangled)
                    if existing_idx >= 0 {
                        return ty_named(mangled)
                    }
                    let mono_fields = monomorphize_fields(tmpl_fields, tmpl_tp_buf, &lowered_args)
                    let mono_info = StructInfo {
                        name: mangled,
                        fields: mono_fields.0,
                        field_count: mono_fields.1,
                        is_linear: tmpl_is_linear,
                        type_param_count: 0,
                        type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
                        is_generic_template: false,
                        visibility_kind: tmpl_visibility_kind,
                        defining_module_id: tmpl_defining_module_id,
                        visibility: tmpl_visibility,
                        defining_module: tmpl_defining_module,
                    }
                    struct_table_add((*c).structs, mono_info)
                    return ty_named(mangled)
                }
            }
        }
        None => {}
    }
    checker_lower_named_type_mut(c, path)
}

fn checker_lower_knowledge_type_mut(c: *mut Checker, opt: Option<Box<KnowledgeTypeInfo> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(info_box) => {
            let info = *info_box
            let inner_ty = checker_lower_type_expr_mut(c, *info.inner_type)
            if !knowledge_metadata_is_valid(info.validity) {
                checker_note_type_error_mut(c)
            }
            let meta = knowledge_meta_from_type_info(info)
            if !knowledge_meta_is_valid(meta) {
                checker_note_type_error_mut(c)
            }
            var eps_val: f64 = -1.0
            match info.epsilon {
                Some(eb) => {
                    let bound = *eb
                    if bound.value < 0.0 || bound.value > 1.0 {
                        checker_note_type_error_mut(c)
                    } else {
                        eps_val = bound.value
                    }
                }
                None => {}
            }
            // Mirror of the persistence in epistemic.sio's check_knowledge_type:
            // the annotation's provenance category becomes TypeEntry payload
            // (dropped here until 2026-09-01). This is the path Madaros actually
            // takes; leaving this twin unwired would keep the erasure alive in
            // exactly the engine that matters. Lane: SOUNIO-KNOWLEDGE-BOUNDARY-PROVENANCE.
            var ty = ty_knowledge(inner_ty, eps_val)
            let prov = meta.provenance
            ty.knowledge_provenance_kind = prov.kind
            ty
        }
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
    }
}

fn checker_lower_contest_type_mut(c: *mut Checker, opt: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args) => {
            match (*args).tail {
                None => {
                    let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
                    if inner_ty.kind == TypeKind::TyError {
                        ty_error()
                    } else {
                        ty_contest(inner_ty, -1)
                    }
                }
                Some(rest) => {
                    match (*rest).tail {
                        Some(last) => {
                            match (*last).tail {
                                Some(_) => {
                                    checker_note_type_error_mut(c)
                                    ty_error()
                                }
                                None => {
                                    let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
                                    let family_ty = checker_lower_type_expr_mut(c, (*rest).head)
                                    let policy_ty = checker_lower_type_expr_mut(c, (*last).head)
                                    if inner_ty.kind == TypeKind::TyError || family_ty.kind == TypeKind::TyError || policy_ty.kind == TypeKind::TyError {
                                        return ty_error()
                                    }
                                    if family_ty.kind != TypeKind::TyModelFamily {
                                        checker_note_type_error_mut(c)
                                        return ty_error()
                                    }
                                    if policy_ty.kind != TypeKind::TyPolicy {
                                        checker_note_type_error_mut(c)
                                        return ty_error()
                                    }
                                    if !types_compatible(model_output_ty(family_ty), inner_ty) || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                        checker_note_type_error_mut(c)
                                        return ty_error()
                                    }
                                    if family_ty.epistemic_meta_id < 0 || family_ty.epistemic_meta_id >= (*c).model_families.count {
                                        checker_note_type_error_mut(c)
                                        return ty_error()
                                    }
                                    let family_info = (*c).model_families.get(family_ty.epistemic_meta_id)
                                    var info = contest_info_from_family_signature(family_info, policy_ty.epistemic_meta_id)
                                    info.span_start = span.start
                                    info.span_end = span.end
                                    info.family_id = family_ty.epistemic_meta_id
                                    let add_result = (*c).contests.add(info)
                                    (*c).contests = add_result.0
                                    ty_contest(inner_ty, add_result.1)
                                }
                            }
                        }
                        None => {
                            checker_note_type_error_mut(c)
                            ty_error()
                        }
                    }
                }
            }
        }
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
    }
}

// *mut [T;N] lowering — transcription of lower_array_type (10651). The element type goes
// through the *mut spine (was: the `_ =>` default silently noted a type-error → spurious
// E-mismatch on `let/var x: [T;N] = …`). Returning only TypeEntry keeps the recursive frame
// small (no held Checker-by-value), so it can never re-introduce the SRET-smash class.
fn checker_lower_array_type_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, size_opt: Option<Box<Expr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match inner_opt {
        Some(inner_te) => {
            let elem_ty = checker_lower_type_expr_mut(c, *inner_te)
            let size = lower_array_size(size_opt)
            ty_array(elem_ty, size)
        }
        None => ty_error()
    }
}

// *mut ref lowering — transcription of lower_ref_like_type (11027). Without this arm,
// `&[T]` / `&![T]` param types hit the `_ =>` default in checker_lower_type_expr_mut
// (ty_error + silent E000) and downstream slice indexing can SIGSEGV.
fn checker_lower_ref_like_type_mut(c: *mut Checker, inner_te: TypeExpr, is_mut_ref: bool) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    if inner_te.kind == TypeExprKind::TypeArray {
        match inner_te.array_size {
            None => {
                match inner_te.inner {
                    Some(elem_te) => {
                        let elem_ty = checker_lower_type_expr_mut(c, *elem_te)
                        if is_mut_ref {
                            return ty_slice_mut(elem_ty)
                        }
                        return ty_slice(elem_ty)
                    }
                    None => return ty_error()
                }
            }
            Some(_) => {}
        }
    }
    // Exact whole-name resolution FIRST. `inner_te` still carries the full path here, so the
    // struct can be resolved by name_eq before the TypeEntry round-trip truncates the name to
    // its 8-byte SRET window. Without this, ANY two structs sharing an 8-character prefix
    // collide inside struct_table_find_by_buf8 and the FIRST one wins: `&TacrolimusEpParam`
    // resolved to `TacrolimusOralParams`, so every field read through the ref (`ep.variance`,
    // `ep.mean`) reported a spurious E012.
    var named_struct_idx: i64 = 0 - 1
    if inner_te.kind == TypeExprKind::TypeNamed {
        let inner_full_name = checker_copy_string_list_to_name(inner_te.path.segments)
        named_struct_idx = struct_table_find((*c).structs, inner_full_name)
    }
    let inner_ty = checker_lower_type_expr_mut(c, inner_te)
    // inner_ty.name.buf[0..7] = first 8 chars of struct name (TypeEntry bytes 8-15 — SRET window).
    // Look up the struct table now (while the full Checker is accessible) and encode the index
    // in name.buf[0] so the field-access handler can find the struct without relying on name.len.
    // The buf8 scan stays as the FALLBACK for shapes the exact lookup cannot serve
    // (monomorphised generic names, module-qualified paths, non-named inner types).
    var struct_idx = named_struct_idx
    if struct_idx < 0 {
        struct_idx = struct_table_find_by_buf8((*c).structs, inner_ty.name.buf)
    }
    if is_mut_ref {
        ty_ref_mut_with_idx(inner_ty, struct_idx)
    } else {
        ty_ref_with_idx(inner_ty, struct_idx)
    }
}

fn checker_lower_ref_type_mut(c: *mut Checker, opt: Option<Box<TypeExpr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(inner_te) => checker_lower_ref_like_type_mut(c, *inner_te, false)
        None => ty_error()
    }
}

fn checker_lower_ref_mut_type_mut(c: *mut Checker, opt: Option<Box<TypeExpr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(inner_te) => checker_lower_ref_like_type_mut(c, *inner_te, true)
        None => ty_error()
    }
}

fn checker_lower_fn_type_params_mut(c: *mut Checker, tel: TypeExprList, idx: i64) -> MutParamsResult with Mut, Panic, Div, Alloc, IO {
    let param_ty = checker_lower_type_expr_mut(c, tel.head)
    var pname = Name { buf: [0; 128], len: 0 }
    pname.buf[0] = 95   // '_'
    pname.buf[1] = 112  // 'p'
    pname.buf[2] = (48 + idx) as i8
    pname.len = 3
    let param_info = FnParamInfo { name: pname, ty: param_ty }
    match tel.tail {
        None => {
            let pl = FnParamList { head: param_info, tail: None }
            MutParamsResult { params: Some(Box::new(pl)), count: idx + 1 }
        }
        Some(rest) => {
            let r = checker_lower_fn_type_params_mut(c, *rest, idx + 1)
            let pl = FnParamList { head: param_info, tail: r.params }
            MutParamsResult { params: Some(Box::new(pl)), count: r.count }
        }
    }
}

fn checker_lower_fn_type_expr_mut(c: *mut Checker, te: TypeExpr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    var params: Option<Box<FnParamList> > = None
    var param_count: i64 = 0
    match te.type_args {
        Some(tel) => {
            let r = checker_lower_fn_type_params_mut(c, *tel, 0)
            params = r.params
            param_count = r.count
        }
        None => {}
    }

    var ret_ty = ty_unit()
    match te.inner {
        Some(inner_te) => {
            ret_ty = checker_lower_type_expr_mut(c, *inner_te)
        }
        None => {}
    }

    let eff_pair = checker_extract_effects_mut(c, te.effects)
    let epistemic_min_confidence = epistemic_min_confidence_from_effects(te.effects)
    let sig = FnSig {
        name: Name { buf: [0; 128], len: 0 },
        params: params,
        param_count: param_count,
        return_type: ret_ty,
        is_method: false,
        self_type_name: Name { buf: [0; 128], len: 0 },
        self_type_entry: ty_unit(),
        effects: eff_pair.effects,
        effect_count: eff_pair.count,
        is_kernel: false,
        is_epistemic_kernel: false,
        is_extern: false,
        is_linear_closure: false,
        linear_capture_count: 0,
        epistemic_epsilon: 0.0 - 1.0,
        epistemic_min_confidence: epistemic_min_confidence,
        visibility_kind: VISIBILITY_PUB,
        defining_module_seg_count: 0,
        defining_module_id: 0,
        visibility: visibility_pub(),
        defining_module: empty_path(),
    }
    let sig_id = fn_sig_table_add((*c).fn_sigs, sig)
    if sig_id < 0 {
        checker_note_type_error_mut(c)
        return ty_error()
    }
    ty_fn(sig_id)
}

fn checker_lower_type_expr_list_mut(c: *mut Checker, tel: TypeExprList) -> TypeEntryList with Mut, Panic, Div, Alloc, IO {
    let head_ty = checker_lower_type_expr_mut(c, tel.head)
    match tel.tail {
        None => TypeEntryList { head: head_ty, tail: None }
        Some(rest) => {
            let rest_list = checker_lower_type_expr_list_mut(c, *rest)
            TypeEntryList { head: head_ty, tail: Some(Box::new(rest_list)) }
        }
    }
}

fn checker_lower_tuple_type_mut(c: *mut Checker, opt: Option<Box<TypeExprList> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(tel) => ty_tuple(checker_lower_type_expr_list_mut(c, *tel))
        None => ty_unit()
    }
}

fn option_expr_is_some(opt: Option<Box<Expr> >) -> bool {
    match opt {
        Some(_) => true,
        None => false
    }
}

fn checker_lower_raw_ptr_type_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, mut_flag: Option<Box<Expr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match inner_opt {
        Some(inner_te) => {
            let inner_ty = checker_lower_type_expr_mut(c, *inner_te)
            ty_raw_ptr(inner_ty, option_expr_is_some(mut_flag))
        }
        None => ty_error()
    }
}

fn checker_refinement_pred_from_info(ri: RefinementInfo) -> RefinementPred with Alloc {
    let pred = if ri.pred_is_float {
        pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
    } else {
        pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
    }
    if ri.compound_op == 7 || ri.compound_op == 8 {
        let pred2 = if ri.pred2_is_float {
            pred_make_float(ri.pred2_op, ri.var_name, ri.pred2_float_val)
        } else {
            pred_make_int(ri.pred2_op, ri.var_name, ri.pred2_int_val)
        }
        if ri.compound_op == 7 {
            pred_and(pred, pred2)
        } else {
            pred_or(pred, pred2)
        }
    } else {
        pred
    }
}

fn checker_lower_refinement_type_mut(c: *mut Checker, opt: Option<Box<RefinementInfo> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(info) => {
            let ri = *info
            match ri.base_type {
                Some(bte) => {
                    let base_ty = checker_lower_type_expr_mut(c, *bte)
                    if ri.pred_op > 0 {
                        let pred = checker_refinement_pred_from_info(ri)
                        let rt = RefinementType { base_type: base_ty, var_name: ri.var_name, predicate: pred }
                        let synth_name = make_refinement_synth_name((*c).refinements.count)
                        (*c).refinements = refinement_table_add((*c).refinements, synth_name, rt)
                        let ref_idx = (*c).refinements.count - 1
                        ty_with_refinement(base_ty, ref_idx)
                    } else {
                        base_ty
                    }
                }
                None => ty_error()
            }
        }
        None => ty_error()
    }
}

fn checker_type_expr_list_contains_reserved_wide_float(
    types: &Option<Box<TypeExprList>>
) -> bool with Mut, Panic, Div, Alloc {
    var current = types
    while true {
        match *current {
            Some(list) => {
                if checker_type_expr_contains_reserved_wide_float(&(*list).head) { return true }
                current = &(*list).tail
            }
            None => return false
        }
    }
    false
}

fn checker_type_expr_contains_reserved_wide_float(te: &TypeExpr) -> bool with Mut, Panic, Div, Alloc {
    if (*te).kind == TypeExprKind::TypeNamed {
        let source_name = checker_copy_string_list_to_name((*te).path.segments)
        if name_is_f128(source_name) || name_is_f256(source_name) { return true }
    }
    match (*te).inner {
        Some(inner) => {
            if checker_type_expr_contains_reserved_wide_float(&(*inner)) { return true }
        }
        None => {}
    }
    if checker_type_expr_list_contains_reserved_wide_float(&(*te).type_args) { return true }
    match (*te).knowledge_info {
        Some(info) => {
            if checker_type_expr_contains_reserved_wide_float(&(*(*info).inner_type)) { return true }
        }
        None => {}
    }
    match (*te).refinement_info {
        Some(info) => {
            match (*info).base_type {
                Some(base) => {
                    if checker_type_expr_contains_reserved_wide_float(&(*base)) { return true }
                }
                None => {}
            }
        }
        None => {}
    }
    false
}

// Match TypeExprKind OUTSIDE a *mut function. Seed codegen of
// `match enum_field` inside a *mut fn maps discriminant 0 onto the first
// arm (TypeNamed), so ExactlyPrivate never arrived at a dedicated arm.
// A helper that does not take *mut Checker can see the real kind.
fn checker_type_expr_kind_tag(te: TypeExpr) -> i64 {
    match te.kind {
        TypeExprKind::TypeNamed => 0
        TypeExprKind::TypeForgettable => 12
        TypeExprKind::TypeExactlyPrivate => 13
        TypeExprKind::TypeEditable => 14
        TypeExprKind::TypeCapabilityGated => 15
        TypeExprKind::TypeComposable => 16
        TypeExprKind::TypeAudited => 17
        TypeExprKind::TypeRevivable => 18
        TypeExprKind::TypeInterpretable => 19
        _ => -1
    }
}

fn checker_lower_opt_inner_type_mut(c: *mut Checker, opt: Option<Box<TypeExpr> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(inner_te) => checker_lower_type_expr_mut(c, *inner_te)
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
    }
}

fn checker_require_effect_mut(c: *mut Checker, span: Span, effect_id: i64, code: i64) with Mut, IO, Panic, Div, Alloc {
    if !has_effect_id((*c).current_effects, (*c).current_effect_count, effect_id) {
        checker_report_error_at_inplace(c, span, code, 0, 0, 0)
    }
}

// ZD wrappers lower to the inner type and demand the enclosing function
// declare the named effect. Parameter position goes through this spine;
// the by-value spine already did the same work and was never reached from
// a parameter.
fn checker_lower_zd_wrapper_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, span: Span, code: i64) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let inner_ty = checker_lower_opt_inner_type_mut(c, inner_opt)
    checker_require_effect_mut(c, span, 18, code)
    inner_ty
}

fn checker_lower_exactly_private_type_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, locus_opt: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let inner_ty = checker_lower_opt_inner_type_mut(c, inner_opt)
    checker_require_effect_mut(c, span, 18, 201)
    match locus_opt {
        None => {}
        Some(largs) => {
            let lname = checker_copy_string_list_to_name((*largs).head.path.segments)
            if !zd_locus_is_wellformed(lname) {
                checker_report_error_at_inplace(c, span, 247, 0, 0, 0)
            }
        }
    }
    inner_ty
}

fn checker_lower_audited_type_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let inner_ty = checker_lower_opt_inner_type_mut(c, inner_opt)
    let has_zd = has_effect_id((*c).current_effects, (*c).current_effect_count, 18)
    let has_wit = has_effect_id((*c).current_effects, (*c).current_effect_count, 19)
    if !has_zd || !has_wit {
        checker_report_error_at_inplace(c, span, 205, 0, 0, 0)
    }
    inner_ty
}

fn checker_lower_revivable_type_mut(c: *mut Checker, inner_opt: Option<Box<TypeExpr> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    let inner_ty = checker_lower_opt_inner_type_mut(c, inner_opt)
    let has_zd = has_effect_id((*c).current_effects, (*c).current_effect_count, 18)
    let has_temp = has_effect_id((*c).current_effects, (*c).current_effect_count, 20)
    if !has_zd || !has_temp {
        checker_report_error_at_inplace(c, span, 206, 0, 0, 0)
    }
    inner_ty
}

fn checker_lower_zd_named_mut(c: *mut Checker, type_args: Option<Box<TypeExprList> >, span: Span, code: i64) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match type_args {
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
        Some(args) => {
            let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
            checker_require_effect_mut(c, span, 18, code)
            inner_ty
        }
    }
}

fn checker_lower_exactly_private_named_mut(c: *mut Checker, type_args: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match type_args {
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
        Some(args) => {
            let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
            checker_require_effect_mut(c, span, 18, 201)
            match (*args).tail {
                None => {}
                Some(rest) => {
                    let lname = checker_copy_string_list_to_name((*rest).head.path.segments)
                    if !zd_locus_is_wellformed(lname) {
                        checker_report_error_at_inplace(c, span, 247, 0, 0, 0)
                    }
                }
            }
            inner_ty
        }
    }
}

fn checker_lower_audited_named_mut(c: *mut Checker, type_args: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match type_args {
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
        Some(args) => {
            let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
            let has_zd = has_effect_id((*c).current_effects, (*c).current_effect_count, 18)
            let has_wit = has_effect_id((*c).current_effects, (*c).current_effect_count, 19)
            if !has_zd || !has_wit {
                checker_report_error_at_inplace(c, span, 205, 0, 0, 0)
            }
            inner_ty
        }
    }
}

fn checker_lower_revivable_named_mut(c: *mut Checker, type_args: Option<Box<TypeExprList> >, span: Span) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
    match type_args {
        None => {
            checker_note_type_error_mut(c)
            ty_error()
        }
        Some(args) => {
            let inner_ty = checker_lower_type_expr_mut(c, (*args).head)
            let has_zd = has_effect_id((*c).current_effects, (*c).current_effect_count, 18)
            let has_temp = has_effect_id((*c).current_effects, (*c).current_effect_count, 20)
            if !has_zd || !has_temp {
                checker_report_error_at_inplace(c, span, 206, 0, 0, 0)
            }
            inner_ty
        }
    }
