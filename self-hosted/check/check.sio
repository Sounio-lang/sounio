    fn collect_deferral_policy_def(self, name: Name, opt: Option<Box<DeferralPolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => {
                let target_pair = self.lower_type_expr((*dd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_policy_requirements((*dd).requirements)
                c = req_pair.0
                let requirements = req_pair.1
                let requirement_count = req_pair.2
                let info = DeferralPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    route_name: (*dd).route_name,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.deferral_policies.add(info)
                c.deferral_policies = add_result.0
                c.env = c.env.bind(name, ty_deferral_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_models_def(self, name: Name, opt: Option<Box<ModelsDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => {
                let pair = self.collect_model_family_members((*md).models, empty_model_family_info(), (*md).span)
                var c = pair.0
                var info = pair.1
                info.name = name
                let add_result = c.model_families.add(info)
                c.model_families = add_result.0
                let family_info = c.model_families.get(add_result.1)
                c.env = c.env.bind(name, ty_model_family(family_info.input_ty, family_info.output_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_model_family_members(self, opt: Option<Box<AstPathList>>, seed: ModelFamilyInfo, span: Span) -> (Checker, ModelFamilyInfo) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let model_name = checker_copy_string_list_tail_to_name((*list).head.segments)
                var c = self
                let model_ty = c.env.lookup(model_name)
                var info = seed
                if model_ty.kind != TypeKind::TyModel {
                    c = c.report_model_type_incompatibility(span, model_name, model_ty)
                } else {
                    let input_ty = model_input_ty(model_ty)
                    let output_ty = model_output_ty(model_ty)
                    if info.model_count == 0 {
                        info.input_ty = input_ty
                        info.output_ty = output_ty
                    } else if !types_compatible(info.input_ty, input_ty) || !types_compatible(info.output_ty, output_ty) {
                        c = c.report_model_family_member_mismatch(span, model_name, info.input_ty, info.output_ty, input_ty, output_ty)
                    }
                    if info.model_count < 16 {
                        info.model_names[info.model_count as usize] = model_name
                    }
                    info.model_count = info.model_count + 1
                }
                c.collect_model_family_members((*list).tail, info, span)
            }
            None => (self, seed)
        }
    }

    fn collect_validation_def(self, name: Name, opt: Option<Box<ValidationDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vd) => {
                let target_pair = self.lower_type_expr((*vd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let info = ValidationPolicyInfo { name: name, target_ty: target_ty }
                let add_result = c.validations.add(info)
                c.validations = add_result.0
                c.env = c.env.bind(name, ty_validation(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn lower_audit_target_type(self, te: TypeExpr, span: Span) -> (Checker, bool, TypeEntry, i64, i64) with Mut, Panic, Div, Alloc, IO {
        if te.kind != TypeExprKind::TypeContest {
            return (self, false, ty_error(), -1, -1)
        }
        match te.type_args {
            Some(args) => {
                match (*args).tail {
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self, false, ty_error(), -1, -1)
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let family_pair = c.lower_type_expr((*rest).head)
                                        c = family_pair.0
                                        let family_ty = family_pair.1
                                        let policy_pair = c.lower_type_expr((*last).head)
                                        c = policy_pair.0
                                        let policy_ty = policy_pair.1
                                        if family_ty.kind != TypeKind::TyModelFamily
                                            || policy_ty.kind != TypeKind::TyPolicy
                                            || family_ty.epistemic_meta_id < 0
                                            || policy_ty.epistemic_meta_id < 0 {
                                            return (c, false, ty_error(), -1, -1)
                                        }
                                        if !types_compatible(model_output_ty(family_ty), inner_ty)
                                            || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                            c = c.report_error_at(span, 58, 0, 0, 0)
                                            return (c, false, ty_error(), -1, -1)
                                        }
                                        (c, true, inner_ty, family_ty.epistemic_meta_id, policy_ty.epistemic_meta_id)
                                    }
                                }
                            }
                            None => (self, false, ty_error(), -1, -1)
                        }
                    }
                    None => (self, false, ty_error(), -1, -1)
                }
            }
            None => (self, false, ty_error(), -1, -1)
        }
    }

    fn collect_audit_def(self, name: Name, opt: Option<Box<AuditDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => {
                let target_pair = self.lower_audit_target_type((*ad).target_type, (*ad).span)
                var c = target_pair.0
                let ok = target_pair.1
                let target_inner_ty = target_pair.2
                let family_id = target_pair.3
                let policy_id = target_pair.4
                if !ok {
                    return c.report_audit_definition_requires_full_contest((*ad).span, ty_error())
                }

                var info = empty_audit_info()
                info.name = name
                info.span_start = (*ad).span.start
                info.span_end = (*ad).span.end
                info.target_inner_ty = target_inner_ty
                info.family_id = family_id
                info.policy_id = policy_id

                let sec_pair = c.collect_audit_sections(name, (*ad).sections, info, [0; 4])
                c = sec_pair.0
                info = sec_pair.1

                let add_result = c.audits.add(info)
                c.audits = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_audit_sections(
        self,
        audit_name: Name,
        opt: Option<Box<AuditSectionList>>,
        seed: AuditInfo,
        section_seen: [i64; 4]
    ) -> (Checker, AuditInfo, [i64; 4]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let section = (*list).head
                var c = self
                var info = seed
                var seen = section_seen
                let section_idx =
                    if section.kind == AuditSectionKind::AuditSectionMetrics { 0 }
                    else if section.kind == AuditSectionKind::AuditSectionMechanistic { 1 }
                    else if section.kind == AuditSectionKind::AuditSectionCounterexample { 2 }
                    else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights { 3 }
                    else { -1 }

                if section_idx < 0 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else if seen[section_idx as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else {
                    seen[section_idx as usize] = 1
                    if section.kind == AuditSectionKind::AuditSectionMetrics {
                        let pair = c.collect_audit_metrics_section(section.name, section.fields, info, [0; 8])
                        c = pair.0
                        info = pair.1
                    } else if section.kind == AuditSectionKind::AuditSectionMechanistic {
                        let pair = c.collect_audit_mechanistic_section(audit_name, section.name, section.fields)
                        c = pair.0
                        info.mechanistic_report_id = pair.1
                        if pair.1 >= 0 && pair.1 < c.mechanistic_reports.count {
                            let report = c.mechanistic_reports.get(pair.1)
                            info.metric_known[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = 1
                            info.metric_values[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = report.aggregate_divergence
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionCounterexample {
                        let pair = c.collect_audit_counterexample_section(audit_name, section.name, section.fields)
                        c = pair.0
                        info.counterexample_id = pair.1
                        if pair.1 >= 0 {
                            info.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
                            info.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights {
                        if info.family_id < 0 || info.family_id >= c.model_families.count {
                            c = c.report_audit_weights_family_mismatch(section.span, audit_name)
                        } else {
                            let family = c.model_families.get(info.family_id)
                            let pair = c.collect_audit_posterior_weights_section(audit_name, section.name, family, section.fields)
                            c = pair.0
                            info.posterior_weights_id = pair.1
                        }
                    }
                }
                c.collect_audit_sections(audit_name, (*list).tail, info, seen)
            }
            None => (self, seed, section_seen)
        }
    }

    fn collect_audit_metrics_section(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seed: AuditInfo,
        seen_fields: [i64; 8]
    ) -> (Checker, AuditInfo, [i64; 8]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var info = seed
                var seen = seen_fields
                let metric_id = audit_metric_id_from_name(field.name)
                if metric_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[metric_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[metric_id as usize] = 1
                    info.metric_known[metric_id as usize] = 1
                    info.metric_values[metric_id as usize] = field.value_f64
                }
                c.collect_audit_metrics_section(section_name, (*list).tail, info, seen)
            }
            None => (self, seed, seen_fields)
        }
    }

    fn collect_audit_mechanistic_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_mechanistic_fields(section_name, opt, [0; 6], [0.0; 6])
        var c = pair.0
        let seen = pair.1
        let values = pair.2
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_mechanistic_incomplete(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            i = i + 1
        }
        let report = MechanisticReportInfo {
            latent_state_divergence: values[1],
            causal_decomposition_divergence: values[2],
            intervention_response_divergence: values[3],
            parameter_role_divergence: values[4],
            structural_explanation_distance: values[5],
            aggregate_divergence: values[0],
        }
        let add_result = c.mechanistic_reports.add(report)
        c.mechanistic_reports = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_mechanistic_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 6],
        values: [f64; 6]
    ) -> (Checker, [i64; 6], [f64; 6]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var vals = values
                let field_id = audit_mechanistic_field_id_from_name(field.name)
                if field_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    vals[field_id as usize] = field.value_f64
                }
                c.collect_audit_mechanistic_fields(section_name, (*list).tail, seen, vals)
            }
            None => (self, seen_fields, values)
        }
    }

    fn collect_audit_counterexample_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_counterexample_fields(
            section_name,
            opt,
            [0; 6],
            [Name { buf: [0; 128], len: 0 }; 6],
            [0.0; 6]
        )
        var c = pair.0
        let seen = pair.1
        let names = pair.2
        let values = pair.3
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_counterexample_incomplete(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            i = i + 1
        }
        let info = CounterexampleInfo {
            model_name: names[0],
            subgroup_name: names[1],
            metric_name: names[2],
            observed_value: values[3],
            threshold_value: values[4],
            summary: names[5],
        }
        let add_result = c.counterexamples.add(info)
        c.counterexamples = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_counterexample_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 6],
        names: [Name; 6],
        values: [f64; 6]
    ) -> (Checker, [i64; 6], [Name; 6], [f64; 6]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_names = names
                var next_values = values
                let field_id = audit_counterexample_field_id_from_name(field.name)
                if field_id < 0 || seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if (field_id == 3 || field_id == 4) && field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field_id != 3 && field_id != 4 && field.value_kind != AuditValueKind::AuditValueName {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    if field_id == 3 || field_id == 4 {
                        next_values[field_id as usize] = field.value_f64
                    } else {
                        next_names[field_id as usize] = field.value_name
                    }
                }
                c.collect_audit_counterexample_fields(section_name, (*list).tail, seen, next_names, next_values)
            }
            None => (self, seen_fields, names, values)
        }
    }

    fn collect_audit_posterior_weights_section(
        self,
        audit_name: Name,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        if family.model_count > 16 {
            let c = self.report_audit_weights_family_mismatch(Span { start: 0, end: 0 }, audit_name)
            return (c, -1)
        }
        let pair = self.collect_audit_posterior_weight_fields(section_name, family, opt, [0; 16], [0.0; 16])
        var c = pair.0
        let seen = pair.1
        let weights = pair.2
        var i: i64 = 0
        var total: f64 = 0.0
        while i < family.model_count && i < 16 {
            if seen[i as usize] != 1 {
                c = c.report_audit_weights_family_mismatch(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            total = total + weights[i as usize]
            i = i + 1
        }
        if audit_abs_f64(total - 1.0) > 0.000001 {
            c = c.report_audit_weights_not_normalized(Span { start: 0, end: 0 }, audit_name, total)
            return (c, -1)
        }
        let info = PosteriorWeightsInfo {
            model_names: family.model_names,
            weights: weights,
            count: family.model_count,
        }
        let add_result = c.posterior_weights.add(info)
        c.posterior_weights = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_posterior_weight_fields(
        self,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 16],
        weights: [f64; 16]
    ) -> (Checker, [i64; 16], [f64; 16]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_weights = weights
                let model_idx = model_family_model_index(family, field.name)
                if field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field.value_f64 < 0.0 {
                    c = c.report_audit_weights_not_normalized(field.span, section_name, field.value_f64)
                } else if model_idx < 0 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else if seen[model_idx as usize] == 1 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else {
                    seen[model_idx as usize] = 1
                    next_weights[model_idx as usize] = field.value_f64
                }
                c.collect_audit_posterior_weight_fields(section_name, family, (*list).tail, seen, next_weights)
            }
            None => (self, seen_fields, weights)
        }
    }

    fn collect_policy_requirements(self, opt: Option<Box<PolicyRequirementList>>) -> (Checker, Option<Box<PolicyRequirementInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_policy_requirement_list(*list)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_policy_requirement_list(self, list: PolicyRequirementList) -> (Checker, PolicyRequirementInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_pair = c.collect_policy_requirement_list(*rest)
                c = rest_pair.0
                let rest_list = rest_pair.1
                let rest_count = rest_pair.2
                (c, PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect function signature
    // --------------------------------------------------------

    fn collect_fn_def(self, name: Name, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let pair = self.collect_fn_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from function signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.0
                let fn_effects = eff_pair.1
                let fn_effect_count = eff_pair.2

                // Kernel function enforcement
                let is_kernel_fn = (*fd).is_kernel
                var kernel_effects = fn_effects
                var kernel_effect_count = fn_effect_count

                if is_kernel_fn {
                    // Auto-inject GPU effect (ID 5) if not already present
                    var has_gpu = false
                    var ei = 0
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if has_gpu == false {
                        if kernel_effect_count < 8 {
                            kernel_effects[kernel_effect_count] = 5
                            kernel_effect_count = kernel_effect_count + 1
                        }
                    }

                    // E070: Reject IO(0), Mut(1), Alloc(2) effects
                    var ri = 0
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }

                    // E072: Kernel must return unit type
                    if ret_ty.kind != TypeKind::TyUnit {
                        c = c.report_error_at((*fd).span, 72, 0, 0, 0)
                    }
                }

                // Detect epistemic kernel: any param with Knowledge/Epistemic type
                var has_epistemic_param = false
                if is_kernel_fn {
                    var walk_params = params
                    var walk_i: i64 = 0
                    while walk_i < param_count {
                        match walk_params {
                            Some(plist) => {
                                let pty = (*plist).head.ty
                                if is_epistemic_type(pty) || pty.kind == TypeKind::TyEpistemic || pty.kind == TypeKind::TyAleatoric {
                                    has_epistemic_param = true
                                }
                                walk_params = (*plist).tail
                            }
                            None => { walk_i = param_count }
                        }
                        walk_i = walk_i + 1
                    }
                }

                let sig = FnSig {
                    name: name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: false,
                    self_type_name: Name { buf: [0; 128], len: 0 },
                    effects: kernel_effects,
                    effect_count: kernel_effect_count,
                    is_kernel: is_kernel_fn,
                    is_epistemic_kernel: has_epistemic_param,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                let sig_id = add_result.1
                c.env = c.env.bind(name, ty_fn(sig_id), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_fn_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_fn_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_fn_param_list(self, pl: ParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_fn_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn lower_opt_return_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    // --------------------------------------------------------
    // Collect struct definition
    // --------------------------------------------------------

    fn collect_struct_def(self, name: Name, opt: Option<Box<StructDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => {
                let pair = self.collect_field_defs((*sd).fields)
                var c = pair.0
                let fields = pair.1
                let field_count = pair.2
                let info = StructInfo {
                    name: name,
                    fields: fields,
                    field_count: field_count,
                    is_linear: (*sd).is_linear,
                }
                c.structs = c.structs.add(info)
                c
            }
            None => self
        }
    }

    fn collect_field_defs(self, opt: Option<Box<FieldDefList>>) -> (Checker, Option<Box<FieldInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fdl) => {
                let pair = self.collect_field_def_list(*fdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_field_def_list(self, fdl: FieldDefList) -> (Checker, FieldInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(fdl.head.ty)
        var c = pair.0
        let field_ty = pair.1
        let head_info = FieldInfo { name: fdl.head.name, ty: field_ty }
        let head_list = FieldInfoList { head: head_info, tail: None }
        match fdl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_field_def_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FieldInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect enum definition
    // --------------------------------------------------------

    fn collect_enum_def(self, name: Name, opt: Option<Box<EnumDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ed) => {
                let pair = self.collect_variants((*ed).variants)
                var c = pair.0
                let variants = pair.1
                let variant_count = pair.2
                let info = EnumInfo {
                    name: name,
                    variants: variants,
                    variant_count: variant_count,
                }
                c.enums = c.enums.add(info)
                c
            }
            None => self
        }
    }

    fn collect_variants(self, opt: Option<Box<VariantDefList>>) -> (Checker, Option<Box<VariantInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vdl) => {
                let pair = self.collect_variant_list(*vdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_variant_list(self, vdl: VariantDefList) -> (Checker, VariantInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let head_info = VariantInfo { name: vdl.head.name }
        let head_list = VariantInfoList { head: head_info, tail: None }
        match vdl.tail {
            None => (self, head_list, 1)
            Some(rest) => {
                let rest_result = self.collect_variant_list(*rest)
                let c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, VariantInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect impl methods
    // --------------------------------------------------------

    fn collect_impl_def(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.collect_impl_methods((*id).methods, impl_ty.name)
                c
            }
            None => self
        }
    }

    fn collect_impl_methods(self, opt: Option<Box<ItemList>>, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.collect_impl_method((*list).head, type_name)
                c.collect_impl_methods((*list).tail, type_name)
            }
            None => self
        }
    }

    fn collect_impl_method(self, item: Item, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                let pair = self.collect_method_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from method signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.0
                let fn_effects = eff_pair.1
                let fn_effect_count = eff_pair.2

                let sig = FnSig {
                    name: item.name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: true,
                    self_type_name: type_name,
                    effects: fn_effects,
                    effect_count: fn_effect_count,
                    is_kernel: false,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_method_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                // Skip self param for method signatures
                if (*pl).head.is_self {
                    self.collect_fn_params((*pl).tail)
                } else {
                    let pair = self.collect_fn_param_list(*pl)
                    (pair.0, Some(Box::new(pair.1)), pair.2)
                }
            }
            None => (self, None, 0)
        }
    }
}

// ============================================================
// Pass 2: Check all items
// ============================================================

impl Checker {
    fn check_items(self, items: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cursor = items
        while true {
            match cursor {
                Some(list) => {
                    c = c.check_item((*list).head)
                    cursor = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn check_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.check_fn_item(item.fn_def)
            ItemStruct => self
            ItemEnum => self
            ItemImpl => self.check_impl_item(item.impl_def)
            ItemTypeAlias => self
            ItemModels => self
            ItemPolicy => self
            ItemAcquisitionPolicy => self
            ItemRecoursePolicy => self
            ItemTransitionPolicy => self
            ItemTransitionProtocol => self
            ItemMonitoringPolicy => self
            ItemAlternativePolicy => self
            ItemAlternativeFrontier => self
            ItemDecisionPolicy => self
            ItemDeferralPolicy => self
            ItemValidation => self
            ItemAudit => self
            ItemUse => self
            ItemUnit => self  // Already handled in collect pass
            ItemEffect => self  // Already handled in collect pass
            ItemSession => self  // Session protocol declaration — type-checking is structural
        }
    }

    // --------------------------------------------------------
    // Check function definition
    // --------------------------------------------------------

    fn check_fn_item(self, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let sig_id = c.fn_sigs.find((*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                // Check return type compatibility
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c
            }
            None => self
        }
    }

    fn bind_fn_params(self, opt: Option<Box<ParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_fn_param((*pl).head)
                c.bind_fn_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_fn_param(self, p: Param) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        if p.is_self {
            c.env = c.env.bind(p.name, c.current_impl_type, p.is_self_mut)
            c = c.const_int_bind_unknown(p.name)
            // Track self parameter for borrow checking
            let self_linear = c.is_linear_type(c.current_impl_type)
            c.borrows = c.borrows.track(p.name, self_linear)
            c
        } else {
            let pair = c.lower_type_expr(p.ty)
            c = pair.0
            let param_ty = pair.1
            c.env = c.env.bind(p.name, param_ty, false)
            c = c.const_int_bind_unknown(p.name)
            // Track parameter for borrow checking (linear if struct is declared linear)
            let lin = c.is_linear_type(param_ty)
            c.borrows = c.borrows.track(p.name, lin)
            c
        }
    }

    // --------------------------------------------------------
    // Check impl definition
    // --------------------------------------------------------

    fn check_impl_item(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.check_impl_methods((*id).methods)
                c.current_impl_type = ty_error()
                c
            }
            None => self
        }
    }

    fn check_impl_methods(self, opt: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.check_impl_method((*list).head)
                c.check_impl_methods((*list).tail)
            }
            None => self
        }
    }

    fn check_impl_method(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let sig_id = c.fn_sigs.find_method(c.current_impl_type.name, (*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement checking
// ============================================================

impl Checker {
    fn check_block(self, blk: Block) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        let pair = c.check_stmts(blk.stmts)
        c = pair.0
        let result_ty = pair.1
        // Check that all linear variables in this scope have been consumed
        let linear_check = c.borrows.check_linear_consumed()
        c.borrows = linear_check.0
        if linear_check.1 > 0 {
            c.had_error = true
            c.error_count = c.error_count + 1
            print("error[E040]: linear value not consumed (")
            print_int(linear_check.1)
            print(" unconsumed)\n")
        }
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, result_ty)
    }

    fn check_stmts(self, opt: Option<Box<StmtList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_stmt((*list).head)
                var c = pair.0
                let stmt_ty = pair.1
                match (*list).tail {
                    Some(_) => c.check_stmts((*list).tail)
                    None => (c, stmt_ty)
                }
            }
            None => (self, ty_unit())
        }
    }

    fn check_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtLet => self.check_let_stmt(s)
            StmtVar => self.check_var_stmt(s)
            StmtExpr => self.check_expr_stmt(s)
            StmtAssign => self.check_assign_stmt(s)
        }
    }

    fn check_let_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        let init_ty = init_pair.1
        // Determine binding type: annotation if present, else init type
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(init_ty, ann_ty) {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        let cur_env = c.env
        c.env = cur_env.bind(s.name, bind_ty, false)
        if const_pair.0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_var_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        let init_ty = init_pair.1
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(init_ty, ann_ty) {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        c.env = c.env.bind(s.name, bind_ty, true)
        if const_pair.0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_refinement_literal(self, span: Span, ty: TypeEntry) -> Checker with Mut, Panic, Div {
        if ty.refinement_id < 0 || ty.refinement_id >= 128 { return self }
        let rt = self.refinements.entries[ty.refinement_id as usize]
        var c = self
        if c.last_literal_kind == 1 {
            // Integer literal — check predicate
            if !pred_check_int(rt.predicate, c.last_literal_int) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        } else if c.last_literal_kind == 2 {
            // Float literal — check predicate
            if !pred_check_float(rt.predicate, c.last_literal_float) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        }
        // Reset literal tracking
        c.last_literal_kind = 0
        c
    }

    fn is_linear_type(self, ty: TypeEntry) -> bool with Mut, Panic, Div {
        if ty.kind == TypeKind::TyNamed {
            let idx = self.structs.find(ty.name)
            if idx >= 0 {
                return self.structs.entries[idx].is_linear
            }
        }
        false
    }

    fn check_expr_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_expr(s.expr)
    }

    fn check_assign_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let target_pair = c.check_opt_expr(s.target)
        c = target_pair.0
        let target_ty = target_pair.1
        let val_pair = c.check_opt_expr(s.expr)
        c = val_pair.0
        let val_ty = val_pair.1
        // Compound assignments (+=, -=, etc.) require numeric operands
        if s.assign_op != AssignOp::AssignEq {
            if !is_error_or_unknown(target_ty) && !is_error_or_unknown(val_ty) {
                let compound_result = binary_result_type(compound_assign_to_binop(s.assign_op), target_ty, val_ty)
                if compound_result.kind == TypeKind::TyError {
                    c = c.report_mismatch(s.span, 21, target_ty, val_ty)
                }
            }
        } else {
            // Simple assignment: check compatibility
            if !types_compatible(target_ty, val_ty) {
                c = c.report_mismatch(s.span, 2, target_ty, val_ty)
            }
        }
        // Check mutability: if target is an ident, it must be mutable
        c = c.check_assign_mutability(s.target, s.span)
        match s.target {
            Some(target) => {
                if (*target).kind == ExprKind::ExprIdent {
                    let rhs_pair = eval_const_int_opt_expr(c, s.expr)
                    if rhs_pair.0 {
                        c = c.const_int_bind_value((*target).name, rhs_pair.1)
                    } else {
                        c = c.const_int_bind_unknown((*target).name)
                    }
                }
            }
            None => {}
        }
        (c, ty_unit())
    }

    fn check_assign_mutability(self, opt: Option<Box<Expr>>, span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprIdent {
                    if !self.env.lookup_is_mutable((*e).name) {
                        self.report_error_at(span, 3, 0, 0, 0)
                    } else {
                        self
                    }
                } else {
                    // Field access, index — assume mutable for now
                    self
                }
            }
            None => self
        }
    }

    fn check_opt_expr(self, opt: Option<Box<Expr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.check_expr(*e)
            None => (self, ty_unit())
        }
    }

    fn check_binding_init_expr(self, opt: Option<Box<Expr>>, ann_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprContest {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_contest_expr_expected(*e, ann_ty)
                    } else {
                        self.check_contest_expr_no_annotation(*e)
                    }
                } else if (*e).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*e).left) {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_lift_knowledge_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else if (*e).kind == ExprKind::ExprAuditAttach {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_audit_attach_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else {
                    self.check_expr(*e)
                }
            }
            None => (self, ty_unit())
        }
    }
}

// ============================================================
// Expression type checking — dispatch
// ============================================================

impl Checker {
    fn check_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check expression depth limit
        let depth_pair = self.check_expr_depth(e.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        let result = match e.kind {
            ExprIntLit => {
                c.last_literal_int = e.int_val
                c.last_literal_kind = 1
                (c, ty_i64())
            }
            ExprFloatLit => {
                c.last_literal_float = e.float_val
                c.last_literal_kind = 2
                (c, ty_f64())
            }
            ExprBoolTrue => (c, ty_bool())
            ExprBoolFalse => (c, ty_bool())
            ExprStringLit => (c, ty_string())
            ExprCharLit => (c, ty_char())
            ExprIdent => {
                let ident_ty = c.env.lookup(e.name)
                // If this is a linear type variable, mark it as consumed
                var c2 = c
                if c2.is_linear_type(ident_ty) && c2.suppress_linear_consume_depth == 0 {
                    // CRITICAL FIX: Check if borrowed before consuming
                    if c2.borrows.is_borrowed(e.name) {
                        c2 = c2.report_error_at(e.span, 38, 0, 0, 0)  // Cannot consume borrowed value
                    } else {
                        let consume_result = c2.borrows.consume_linear(e.name)
                        c2.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c2 = c2.report_error_at(e.span, consume_result.1, 0, 0, 0)
                        }
                    }
                }
                (c2, ident_ty)
            }
            ExprPath => c.check_path_expr(e)
            ExprBinary => c.check_binary_expr(e)
            ExprUnary => c.check_unary_expr(e)
            ExprFieldAccess => c.check_field_access(e)
            ExprIndex => c.check_index_expr(e)
            ExprMethodCall => c.check_method_call(e)
            ExprCall => c.check_call_expr(e)
            ExprIf => c.check_if_expr(e)
            ExprMatch => c.check_match_expr(e)
            ExprWhile => c.check_while_expr(e)
            ExprLoop => c.check_loop_expr(e)
            ExprBlock => c.check_block_expr(e)
            ExprReturn => c.check_return_expr(e)
            ExprBreak => c.check_break_expr(e)
            ExprContinue => c.check_continue_expr(e)
            ExprStructLit => c.check_struct_lit(e)
            ExprArrayLit => c.check_array_lit(e)
            ExprTupleLit => c.check_tuple_lit(e)
            ExprRange => c.check_range_expr(e)
            ExprCast => c.check_cast_expr(e)
            ExprHandle => c.check_handle_expr(e)
            ExprClosure => c.check_closure_expr(e)
            ExprContest => c.check_contest_expr_no_annotation(e)
            ExprAuditAttach => c.check_audit_attach_expr(e)
            ExprForIn => c.check_for_in_expr(e)
            ExprError => (c, ty_error())
        }
        (result.0.exit_expr_depth(), result.1)
    }

    // --------------------------------------------------------
    // Path expression — enum variant
    // --------------------------------------------------------

    fn check_path_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // First segment is enum/type name, last is variant
        // For now, look up first segment as enum name
        let first_name = checker_copy_string_list_to_name(e.path.segments)
        let enum_idx = self.enums.find(first_name)
        if enum_idx >= 0 {
            (self, ty_named(first_name))
        } else {
            // Could be a variant name directly (e.g. None, Some)
            let variant_enum_idx = self.enums.find_variant_enum(first_name)
            if variant_enum_idx >= 0 {
                let ei = self.enums.get(variant_enum_idx)
                (self, ty_named(ei.name))
            } else {
                // Look up in env as a regular binding
                (self, self.env.lookup(first_name))
            }
        }
    }

    // --------------------------------------------------------
    // Binary expression
    // --------------------------------------------------------

    fn check_binary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1

        // Validate binary operator type constraints
        c = c.check_binary_op_types(e.span, e.bin_op, left_ty, right_ty)

        // Epsilon propagation for Knowledge types
        // If either operand is Knowledge<T, epsilon>, propagate epsilon bounds
        if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
            let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty)
            if knowledge_result.kind == TypeKind::TyError {
                c = c.report_error_at(e.span, 36, 0, 0, 0)
            }
            // Continue with normal checking for inner type compatibility
            // The knowledge_binary_result handles epsilon propagation
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, knowledge_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            return (c, final_result)
        }

        let result = binary_result_type(e.bin_op, left_ty, right_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
            c = c.report_mismatch(e.span, 4, left_ty, right_ty)
        }
        // Division/modulo by zero: detect denominators that fold to a constant integer zero.
        if e.bin_op == BinaryOp::OpDiv {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 56, 0, 0, 0)
            }
        } else if e.bin_op == BinaryOp::OpRem {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 57, 0, 0, 0)
            }
        }
        // Unit checking for arithmetic on unit-typed values
        let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, result)
        c = result_with_units.0
        let final_result = result_with_units.1
        (c, final_result)
    }

    fn check_binary_op_types(self, span: Span, op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        if is_error_or_unknown(left_ty) || is_error_or_unknown(right_ty) {
            return self
        }
        match op {
            OpBitAnd => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitOr => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitXor => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpShl => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpShr => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpRem => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 50, 0, 0, 0)
                }
                self
            }
            OpAnd => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            OpOr => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            _ => self
        }
    }

    fn check_binary_units(self, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry, result: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let lu = left.unit_id
        let ru = right.unit_id
        // If neither side has units, nothing to check
        if lu < 0 && ru < 0 {
            return (c, result)
        }
        match op {
            // Addition/subtraction: units must match exactly
            OpAdd => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            OpSub => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            // Multiplication: combine unit dimensions
            OpMul => {
                if lu >= 0 && ru >= 0 {
                    // Both have units — product gets combined dimensions
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let prod = unit_dim_mul(ld, rd)
                    // For now, result is f64 with no named unit (product unit)
                    // A future pass could register the product unit
                    (c, result)
                } else {
                    // One side has units, other is scalar — keep the unit
                    let uid = if lu >= 0 { lu } else { ru }
                    (c, ty_with_unit(result, uid))
                }
            }
            // Division: combine unit dimensions
            OpDiv => {
                if lu >= 0 && ru >= 0 {
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let quot = unit_dim_div(ld, rd)
                    if unit_dim_is_dimensionless(quot) {
                        // Units cancel out — result is dimensionless
                        (c, result)
                    } else {
                        // Quotient has dimensions — result is f64 (unnamed unit)
                        (c, result)
                    }
                } else if lu >= 0 {
                    // numerator has units, denominator is scalar — keep unit
                    (c, ty_with_unit(result, lu))
                } else {
                    // numerator is scalar, denominator has units — inverse unit
                    (c, result)
                }
            }
            // Comparison operators: units must match
            OpEq => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpNe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            // Other operators: pass through
            _ => (c, result)
        }
    }

    fn report_unit_mismatch(self, span: Span, left_uid: i64, right_uid: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.had_error = true
        c.error_count = c.error_count + 1
        print("error[E041]: unit mismatch in arithmetic operation\n")
        print("  left unit: ")
        if left_uid >= 0 {
            print_unit_dim(c.units.get_dim(left_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n  right unit: ")
        if right_uid >= 0 {
            print_unit_dim(c.units.get_dim(right_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n")
        c
    }

    // --------------------------------------------------------
    // Unary expression
    // --------------------------------------------------------

    fn check_unary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let operand_ty = pair.1
        let result = unary_result_type(e.un_op, operand_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
            c = c.report_error_at(e.span, 5, 0, 0, 0)
        }
        // Borrow checking: if this is &x or &!x on a named variable
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            let borrow_name = unary_operand_name(e.left)
            if borrow_name.len > 0 {
                if e.un_op == UnaryOp::OpRef {
                    let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                } else {
                    let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                }
            }
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Field access
    // --------------------------------------------------------

    fn check_field_access(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let base_ty = pair.1
        if base_ty.kind == TypeKind::TyNamed {
            let struct_idx = c.structs.find(base_ty.name)
            if struct_idx >= 0 {
                let si = c.structs.get(struct_idx)
                let field_ty = field_info_list_find(si.fields, e.name)
                if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                }
                (c, field_ty)
            } else {
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T> field access: .value -> T, .epsilon -> f64
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                // "value" = [118, 97, 108, 117, 101]
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                // "epsilon" = [101, 112, 115, 105, 108, 111, 110]
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyIntervention {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyCounterfactual {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyValidated {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper field access: delegates to hyper.sio predicates
            // Complex: .real, .imag -> inner type
            // Quaternion: .w, .x, .y, .z -> inner type
            // Octonion: .e0.e7 -> inner type
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // Complex fields
            if alg == 1 {
                // "real" = [114, 101, 97, 108], "imag" = [105, 109, 97, 103]
                if name_matches_str4(e.name, 114, 101, 97, 108) { (c, inner_ty) }
                else if name_matches_str4(e.name, 105, 109, 97, 103) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            // Quaternion fields
            } else if alg == 2 {
                // .w .x .y .z (119, 120, 121, 122)
                if name_matches_str1(e.name, 119) { (c, inner_ty) }
                else if name_matches_str1(e.name, 120) { (c, inner_ty) }
                else if name_matches_str1(e.name, 121) { (c, inner_ty) }
                else if name_matches_str1(e.name, 122) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            } else {
                // Octonion/Sedenion/Clifford: field access by component index
                // For now accept any short field name and return inner type
                (c, inner_ty)
            }
        } else if base_ty.kind == TypeKind::TyTuple {
            // Tuple field access by index (e.g. t.0, t.1)
            // The field name contains the index as ascii digits
            let idx = (e.name.buf[0] as i64) - 48
            let tuple_count = type_entry_list_count(base_ty.tuple_elems)
            if idx >= tuple_count {
                c = c.report_error_at(e.span, 47, 0, 0, 0)
                (c, ty_error())
            } else {
                let elem = type_entry_list_get(base_ty.tuple_elems, idx)
                (c, elem)
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 12, 0, 0, 0)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Index expression
    // --------------------------------------------------------

    fn check_index_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let base_pair = self.check_opt_expr(e.left)
        var c = base_pair.0
        let base_ty = base_pair.1
        let idx_pair = c.check_opt_expr(e.right)
        c = idx_pair.0
        let idx_ty = idx_pair.1
        // Index must be i64
        if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
            c = c.report_error_at(e.span, 14, 0, 0, 0)
        }
        // Base must be array
        if base_ty.kind == TypeKind::TyArray {
            match base_ty.inner {
                Some(elem_ty) => (c, *elem_ty)
                None => (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 13, 0, 0, 0)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Method call
    // --------------------------------------------------------

    fn check_method_call(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Method receiver evaluation should not eagerly consume linear values,
        // because receiver passing mode is method-signature dependent.
        var checker_for_base = self
        checker_for_base.suppress_linear_consume_depth = checker_for_base.suppress_linear_consume_depth + 1
        let base_pair = checker_for_base.check_opt_expr(e.left)
        var c = base_pair.0
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        let base_ty = base_pair.1
        if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T>.unwrap() -> T
            if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
                // "unwrap" = [117, 110, 119, 114, 97, 112]
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, knowledge_inner(base_ty))
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper method calls: .conjugate() .norm() .inverse()
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // "conjugate" = [99,111,110,106,117,103,97,116,101] (9 chars)
            if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, base_ty)  // conjugate returns same Hyper type
            // "norm" = [110,111,114,109] (4 chars)
            } else if name_matches_str4(e.name, 110, 111, 114, 109) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, inner_ty)  // norm returns scalar
            // "inverse" = [105,110,118,101,114,115,101] (7 chars)
            } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                // Only division algebras have inverse (alg <= 3)
                if alg > 3 {
                    c = c.report_error_at(e.span, 32, 0, 0, 0)
                    (c, ty_error())
                } else {
                    (c, base_ty)
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyNamed {
            let sig_id = c.fn_sigs.find_method(base_ty.name, e.name)
            if sig_id >= 0 {
                let sig = c.fn_sigs.get(sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                // Verify callee method's effects are subset of caller's effects
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                // Release borrows taken for method call arguments
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                // Method not found
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                // Still check args to accumulate errors
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 19, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Function call
    // --------------------------------------------------------

    fn check_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if call_expr_is_builtin_prove_robust(e.left) {
            return self.check_prove_robust_expr(e)
        }
        if call_expr_is_builtin_validate_manifest(e.left) {
            return self.check_validate_manifest_expr(e)
        }
        if call_expr_is_builtin_admit_action(e.left) {
            return self.check_admit_action_expr(e)
        }
        if call_expr_is_builtin_defer_action(e.left) {
            return self.check_defer_action_expr(e)
        }
        if call_expr_is_builtin_deferral_reason(e.left) {
            return self.check_deferral_reason_expr(e)
        }
        if call_expr_is_builtin_plan_acquisition(e.left) {
            return self.check_plan_acquisition_expr(e)
        }
        if call_expr_is_builtin_acquisition_reason(e.left) {
            return self.check_acquisition_reason_expr(e)
        }
        if call_expr_is_builtin_plan_recourse(e.left) {
            return self.check_plan_recourse_expr(e)
        }
        if call_expr_is_builtin_recourse_reason(e.left) {
            return self.check_recourse_reason_expr(e)
        }
        if call_expr_is_builtin_propose_alternatives(e.left) {
            return self.check_propose_alternatives_expr(e)
        }
        if call_expr_is_builtin_alternative_count(e.left) {
            return self.check_alternative_count_expr(e)
        }
        if call_expr_is_builtin_alternative_option(e.left) {
            return self.check_alternative_option_expr(e)
        }
        if call_expr_is_builtin_alternative_reason(e.left) {
            return self.check_alternative_reason_expr(e)
        }
        if call_expr_is_builtin_commit_alternative(e.left) {
            return self.check_commit_alternative_expr(e)
        }
        if call_expr_is_builtin_transition_reason(e.left) {
            return self.check_transition_reason_expr(e)
        }
        if call_expr_is_builtin_transition_step_count(e.left) {
            return self.check_transition_step_count_expr(e)
        }
        if call_expr_is_builtin_observe_transition(e.left) {
            return self.check_observe_transition_expr(e)
        }
        if call_expr_is_builtin_rollback_transition(e.left) {
            return self.check_rollback_transition_expr(e)
        }
        if call_expr_is_builtin_lift_knowledge(e.left) {
            return self.check_lift_knowledge_expr(e)
        }
        if call_expr_is_builtin_measure(e.left) {
            return self.check_measure_expr(e)
        }
        let witness_kind = call_expr_contest_witness_kind(e.left)
        if witness_kind >= 0 {
            return self.check_contest_witness_expr(e, witness_kind)
        }
        let callee_pair = self.check_opt_expr(e.left)
        var c = callee_pair.0
        let callee_ty = callee_pair.1
        if callee_ty.kind == TypeKind::TyFn && callee_ty.fn_sig_id >= 0 {
            let sig = c.fn_sigs.get(callee_ty.fn_sig_id)
            let call_start_borrows = c.borrows
            c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
            // Verify callee's effects are subset of caller's effects
            c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
            // Release borrows taken for call arguments — the call has returned,
            // so exclusive/shared borrows on arguments are no longer active.
            c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
            (c, sig.return_type)
        } else if is_error_or_unknown(callee_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, callee_ty)
        } else {
            c = c.report_error_at(e.span, 17, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    fn check_contest_expr_no_annotation(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_contest_expr_expected(e, ty_error())
        (pair.0.report_error_at(e.span, 59, 0, 0, 0), ty_error())
    }

    fn check_contest_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let subject_pair = c.check_opt_expr(e.left)
        c = subject_pair.0
        let subject_ty = subject_pair.1
        if !contest_model_list_present(e.args) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
        }
        if expected_contest_ty.kind == TypeKind::TyError || expected_contest_ty.kind != TypeKind::TyContest {
            (c, ty_error())
        } else {
            var info = contest_info_from_expr_models(e.args)
            info = contest_info_attach_span(info, e.span)
            if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
                let expected_info = c.contests.get(expected_contest_ty.epistemic_meta_id)
                info.family_id = expected_info.family_id
                info.policy_id = expected_info.policy_id
                info.audit_id = expected_info.audit_id
                var i: i64 = 0
                while i < 8 {
                    info.metric_known[i as usize] = expected_info.metric_known[i as usize]
                    info.metric_values[i as usize] = expected_info.metric_values[i as usize]
                    i = i + 1
                }
                info.mechanistic_report_id = expected_info.mechanistic_report_id
                info.posterior_weights_id = expected_info.posterior_weights_id
                info.counterexample_id = expected_info.counterexample_id
                info.provenance_bundle_id = expected_info.provenance_bundle_id
                if expected_info.family_id >= 0 {
                    if expected_info.family_id >= c.model_families.count {
                        c = c.report_missing_model_family_metadata(e.span)
                    } else {
                        let family_info = c.model_families.get(expected_info.family_id)
                        if !contest_model_lists_match(e.args, family_info, 0) {
                            c = c.report_model_family_mismatch(e.span, family_info, info)
                        }
                        if !types_compatible(subject_ty, family_info.input_ty) {
                            c = c.report_mismatch(e.span, 1, family_info.input_ty, subject_ty)
                        }
                    }
                }
                c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
                (c, ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id))
            } else {
                let add_result = c.contests.add(info)
                c.contests = add_result.0
                (c, ty_contest(knowledge_inner(expected_contest_ty), add_result.1))
            }
        }
    }

    fn check_audit_attach_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_audit_attach_expr_expected(e, ty_error())
    }

    fn check_audit_attach_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let audit_id = self.audits.find(e.name)
        if audit_id < 0 || audit_id >= self.audits.count {
            return (self.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        let audit_info = self.audits.get(audit_id)
        var seeded_expected_ty = expected_contest_ty
        var seeded_checker = self
        if expected_contest_ty.kind == TypeKind::TyContest
        && expected_contest_ty.epistemic_meta_id >= 0
        && expected_contest_ty.epistemic_meta_id < self.contests.count {
            let expected_info = self.contests.get(expected_contest_ty.epistemic_meta_id)
            if expected_info.family_id >= 0 && expected_info.policy_id >= 0 {
                if !contest_matches_audit_target(expected_contest_ty, expected_info, audit_info) {
                    return (self.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(expected_contest_ty), expected_info), ty_error())
                }
                var merged_expected = contest_info_apply_audit(expected_info, audit_info, audit_id)
                merged_expected = contest_info_attach_span(merged_expected, e.span)
                seeded_checker.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = merged_expected
                seeded_expected_ty = ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id)
            }
        }
        let contest_pair = match e.left {
            Some(left_expr) => {
                if (*left_expr).kind == ExprKind::ExprContest {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { self.contest_type_seeded_from_audit(audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_contest_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else if (*left_expr).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*left_expr).left) {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { self.contest_type_seeded_from_audit(audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_lift_knowledge_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else {
                    seeded_checker.check_expr(*left_expr)
                }
            }
            None => (seeded_checker.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if !contest_matches_audit_target(contest_ty, contest_info, audit_info) {
            return (c.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(contest_ty), contest_info), ty_error())
        }

        var merged = contest_info_apply_audit(contest_info, audit_info, audit_id)
        merged = contest_info_attach_span(merged, e.span)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = merged
        (c, ty_contest(knowledge_inner(contest_ty), contest_ty.epistemic_meta_id))
    }

    fn check_prove_robust_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)

        let policy_pair = self.check_opt_expr(second_arg)
        var c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyPolicy {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.policies.count {
            c = c.report_policy_requires_named_definition(e.span)
            return (c, ty_error())
        }

        let policy_info = c.policies.get(policy_ty.epistemic_meta_id)
        if policy_info.level_id < 0 || policy_info.scope_id < 0 {
            c = c.report_policy_missing_robustness_metadata(e.span, policy_info.name)
            return (c, ty_error())
        }

        let contest_inner = knowledge_inner(policy_ty)
        let contest_pair = match first_arg {
            Some(arg) => c.check_expr(*arg)
            None => (c.report_error_at(e.span, 58, 0, 0, 0), ty_error())
        }
        c = contest_pair.0
        let contest_ty = contest_pair.1

        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if !types_compatible(knowledge_inner(contest_ty), contest_inner) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }
        if contest_info.policy_id >= 0 && contest_info.policy_id != policy_ty.epistemic_meta_id {
            c = c.report_contest_policy_mismatch(e.span, contest_info.policy_id, policy_ty.epistemic_meta_id)
            return (c, ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = check_policy_requirements_against_contest(
                c,
                e.span,
                policy_info.name,
                policy_info.requirements,
                contest_ty.epistemic_meta_id
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let proof_info = robust_proof_info_from_contest(contest_ty.epistemic_meta_id, contest_info, policy_info, e.span)
        let add_result = c.robust_proofs.add(proof_info)
        c.robust_proofs = add_result.0
        (c, ty_robust(contest_inner, add_result.1, policy_info.level_id, policy_info.scope_id))
    }

    // validate_manifest(robust: Robust<T>) -> Validated<T>
    // Terminal epistemic chain step: a Robust<T> that has been manifestly validated
    // becomes Validated<T>. Policy satisfaction was proven at check time; this call
    // serves as the explicit compile-time gate that produces the Validated<T> token.
    fn check_validate_manifest_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let robust_pair = self.check_opt_expr(first_arg)
        var c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let validation_pair = c.check_opt_expr(second_arg)
        c = validation_pair.0
        let validation_ty = validation_pair.1
        if validation_ty.kind != TypeKind::TyValidation {
            c = c.report_missing_validation_policy(e.span)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, knowledge_inner(validation_ty)) {
            c = c.report_validation_target_mismatch(e.span, knowledge_inner(validation_ty), inner_ty)
            return (c, ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            c = c.report_missing_robust_proof(e.span)
            return (c, ty_error())
        }
        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        let manifest_info = ValidatedManifestInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            validation_id: validation_ty.epistemic_meta_id,
            inner_ty: inner_ty,
        }
        let add_result = c.validated_manifests.add(manifest_info)
        c.validated_manifests = add_result.0
        (c, ty_validated_with_policy(inner_ty, 0.0 - 1.0, add_result.1))
    }

    fn check_decision_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_decision_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_decision_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_decision_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferral_reason_code_from_metric_id(self, metric_id: i64) -> i64 {
        if metric_id == CONTEST_METRIC_SIGN_CONSENSUS || metric_id == CONTEST_METRIC_RELATIVE_BAND {
            return DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT
        }
        if metric_id == CONTEST_METRIC_MECHANISTIC_DIVERGENCE {
            return DEFERRAL_REASON_MECHANISTIC_CONFLICT
        }
        if metric_id == CONTEST_METRIC_MAX_TAIL_RISK {
            return DEFERRAL_REASON_TAIL_RISK
        }
        if metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR {
            return DEFERRAL_REASON_IDENTIFIABILITY_GAP
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn deferral_reason_code_from_requirements(self, opt: Option<Box<PolicyRequirementInfoList>>) -> i64 with Mut, Panic, Div {
        match opt {
            Some(list) => self.deferral_reason_code_from_metric_id((*list).head.metric_id)
            None => DEFERRAL_REASON_POLICY_INCOMPLETE
        }
    }

    fn check_deferral_policy_requirements_against_contest(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        contest_info: ContestInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = contest_info_get_metric(contest_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_contest(span, policy_name, (*list).tail, contest_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_deferral_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_acquisition_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_acquisition_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_acquisition_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_acquisition_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_recourse_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_recourse_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_recourse_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_recourse_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferred_reason_witness_info_new(self, span: Span, certificate_id: i64) -> DeferredReasonWitnessInfo {
        DeferredReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            deferred_certificate_id: certificate_id,
        }
    }

    fn acquisition_reason_witness_info_new(self, span: Span, plan_id: i64) -> AcquisitionReasonWitnessInfo {
        AcquisitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            acquisition_plan_id: plan_id,
        }
    }

    fn recourse_reason_witness_info_new(self, span: Span, plan_id: i64) -> RecourseReasonWitnessInfo {
        RecourseReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            recourse_plan_id: plan_id,
        }
    }

    fn transition_reason_witness_info_new(self, span: Span, plan_id: i64) -> TransitionReasonWitnessInfo {
        TransitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            transition_plan_id: plan_id,
        }
    }

    fn alternative_reason_witness_info_new(self, span: Span, candidate_id: i64) -> AlternativeReasonWitnessInfo {
        AlternativeReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            candidate_id: candidate_id,
        }
    }

    fn alternative_frontier_name_from_expr(self, opt: Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }

    fn transition_protocol_name_from_expr(self, opt: Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }

    fn alternative_metric_name(metric_id: i64) -> Name with Mut, Panic, Div {
        if metric_id == ALTERNATIVE_METRIC_INTERVENTION_COST {
            make_name("intervention_cost")
        } else if metric_id == ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK {
            make_name("residual_tail_risk")
        } else if metric_id == ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE {
            make_name("mechanistic_divergence")
        } else if metric_id == ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN {
            make_name("admissibility_margin")
        } else {
            make_name("unknown_metric")
        }
    }

    fn transition_metric_is_candidate(metric_id: i64) -> bool {
        metric_id == TRANSITION_METRIC_INTERVENTION_COST
        || metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK
        || metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE
        || metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN
    }

    fn transition_metric_to_candidate_metric(metric_id: i64) -> i64 {
        if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
            ALTERNATIVE_METRIC_INTERVENTION_COST
        } else if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
            ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK
        } else if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
            ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE
        } else if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
            ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN
        } else {
            -1
        }
    }

    fn transition_candidate_metric_pair(self, candidate: AlternativeCandidateInfo, metric_id: i64) -> (bool, f64) with Mut, Panic, Div {
        if self.transition_metric_is_candidate(metric_id) {
            let alt_metric_id = self.transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && candidate.metric_known[alt_metric_id as usize] == 1 {
                return (true, candidate.metric_values[alt_metric_id as usize])
            }
            return (false, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_DEFERRED {
            if candidate.deferred_certificate_id >= 0 && candidate.deferred_certificate_id < self.deferred_certificates.count {
                return deferred_certificate_get_metric(self.deferred_certificates.get(candidate.deferred_certificate_id), metric_id)
            }
            return (false, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_RECOURSE_PLAN {
            if candidate.source_plan_id >= 0 && candidate.source_plan_id < self.recourse_plans.count {
                let plan_info = self.recourse_plans.get(candidate.source_plan_id)
                if metric_id >= 0 && metric_id < 8 && plan_info.metric_known[metric_id as usize] == 1 {
                    return (true, plan_info.metric_values[metric_id as usize])
                }
            }
            return (false, 0.0)
        }

        (false, 0.0)
    }

    fn transition_plan_metric_pair(self, plan: TransitionPlanInfo, metric_id: i64) -> (bool, f64) with Mut, Panic, Div {
        if self.transition_metric_is_candidate(metric_id) {
            let alt_metric_id = self.transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && plan.metric_known[alt_metric_id as usize] == 1 {
                return (true, plan.metric_values[alt_metric_id as usize])
            }
        }

        if plan.alternative_option_id >= 0 && plan.alternative_option_id < self.alternative_candidates.count {
            return self.transition_candidate_metric_pair(self.alternative_candidates.get(plan.alternative_option_id), metric_id)
        }

        if plan.contest_id >= 0 && plan.contest_id < self.contests.count {
            return contest_info_get_metric(self.contests.get(plan.contest_id), metric_id)
        }

        (false, 0.0)
    }

    fn transition_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("transition_value")
    }

    fn transition_expr_value_matches_candidate(self, step_expr: Expr, candidate_expr: Expr) -> bool with Mut, Panic, Div, Alloc {
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.int_val == candidate_expr.int_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return step_expr.float_val == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return (step_expr.int_val as f64) == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.float_val == (candidate_expr.int_val as f64)
        }
        if (step_expr.kind == ExprKind::ExprIdent || step_expr.kind == ExprKind::ExprPath)
            && (candidate_expr.kind == ExprKind::ExprIdent || candidate_expr.kind == ExprKind::ExprPath) {
            return name_eq(contest_model_name(step_expr), contest_model_name(candidate_expr))
        }
        false
    }

    fn check_transition_requirements_against_candidate(
        self,
        span: Span,
        owner_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        candidate: AlternativeCandidateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_candidate_metric_pair(candidate, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                        (c, false)
                    } else {
                        self.check_transition_requirements_against_candidate(span, owner_name, (*list).tail, candidate)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn alternative_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("value")
    }

    fn alternative_candidate_metric_known(self, info: AlternativeCandidateInfo, metric_id: i64) -> bool with Mut, Panic, Div {
        metric_id >= 0 && metric_id < 8 && info.metric_known[metric_id as usize] == 1
    }

    fn alternative_candidate_metric_value(self, info: AlternativeCandidateInfo, metric_id: i64) -> f64 with Mut, Panic, Div {
        if metric_id >= 0 && metric_id < 8 {
            info.metric_values[metric_id as usize]
        } else {
            0.0
        }
    }

    fn alternative_candidate_metrics_complete(self, info: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> (bool, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if !self.alternative_candidate_metric_known(info, metric_id) {
                return (false, metric_id)
            }
            i = i + 1
        }
        (true, -1)
    }

    fn alternative_candidate_no_worse(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r >= l } else { r <= l }
    }

    fn alternative_candidate_strictly_better(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r > l } else { r < l }
    }

    fn alternative_candidate_is_duplicate(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        if !name_eq(lhs.value_repr, rhs.value_repr) {
            return false
        }
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if self.alternative_candidate_metric_value(lhs, metric_id) != self.alternative_candidate_metric_value(rhs, metric_id) {
                return false
            }
            i = i + 1
        }
        true
    }

    fn alternative_candidate_is_dominated(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        var all_no_worse = true
        var any_better = false
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            let direction = policy_info.objective_directions[i as usize]
            if !self.alternative_candidate_no_worse(lhs, rhs, metric_id, direction) {
                all_no_worse = false
            }
            if self.alternative_candidate_strictly_better(lhs, rhs, metric_id, direction) {
                any_better = true
            }
            i = i + 1
        }
        all_no_worse && any_better
    }

    fn alternative_candidate_attach_realized(
        self,
        info: AlternativeCandidateInfo,
        frontier_id: i64,
        source_kind: i64,
        deferred_certificate_id: i64,
        source_policy_id: i64,
        source_plan_id: i64,
        strategy_name: Name,
        route_name: Name,
        audit_id: i64,
        contest_id: i64,
        value_repr: Name
    ) -> AlternativeCandidateInfo with Mut, Panic, Div {
        var next = info
        next.frontier_id = frontier_id
        next.source_kind = source_kind
        next.deferred_certificate_id = deferred_certificate_id
        next.source_policy_id = source_policy_id
        next.source_plan_id = source_plan_id
        next.strategy_name = strategy_name
        next.route_name = route_name
        next.audit_id = audit_id
        next.contest_id = contest_id
        next.value_repr = value_repr
        next.dominance_rank = 0
        next
    }

    fn contest_has_counterexample(self, contest_id: i64) -> bool with Mut, Panic, Div {
        if contest_id < 0 || contest_id >= self.contests.count {
            return false
        }
        let contest_info = self.contests.get(contest_id)
        if contest_info.counterexample_id >= 0 {
            return true
        }
        let metric_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_COUNTEREXAMPLE_PRESENT)
        metric_pair.0 && metric_pair.1 > 0.0
    }

    fn deferred_certificate_attach_resolution_metrics(self, cert: DeferredCertificateInfo) -> DeferredCertificateInfo with Mut, Panic, Div {
        var next = cert
        if next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] != 1
        && self.contest_has_counterexample(next.contest_id) {
            next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
            next.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
        }
        next.metric_known[CONTEST_METRIC_DEFERRED_REASON as usize] = 1
        next.metric_values[CONTEST_METRIC_DEFERRED_REASON as usize] = next.reason_code as f64
        next
    }

    fn check_admit_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let robust_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let robust_pair = c.check_opt_expr(robust_arg)
        c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.robustness_level_id < 0 || robust_ty.robustness_scope_id < 0 {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }

        let decision_pair = c.check_opt_expr(policy_arg)
        c = decision_pair.0
        let decision_ty = decision_pair.1
        if decision_ty.kind != TypeKind::TyDecisionPolicy {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }
        if decision_ty.epistemic_meta_id < 0 || decision_ty.epistemic_meta_id >= c.decision_policies.count {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_decision_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.decision_policies.get(decision_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_decision_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_decision_policy_requirements_against_proof(
                e.span,
                policy_info.name,
                policy_info.requirements,
                proof_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let cert_info = DecisionCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            decision_policy_id: decision_ty.epistemic_meta_id,
            inner_ty: inner_ty,
            metric_known: proof_info.metric_known,
            metric_values: proof_info.metric_values,
        }
        let add_result = c.decision_certificates.add(cert_info)
        c.decision_certificates = add_result.0
        (c, ty_admissible(inner_ty, add_result.1))
    }

    fn check_defer_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyDeferralPolicy {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.deferral_policies.count {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        let policy_info = c.deferral_policies.get(policy_ty.epistemic_meta_id)

        if evidence_ty.kind == TypeKind::TyContest {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.contests.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let contest_info = c.contests.get(evidence_ty.epistemic_meta_id)
            if contest_info.family_id < 0 || contest_info.policy_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_contest(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    contest_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: contest_info.audit_id,
                contest_id: evidence_ty.epistemic_meta_id,
                robust_proof_id: -1,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_CONTEST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: contest_info.metric_known,
                metric_values: contest_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        if evidence_ty.kind == TypeKind::TyRobust {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.robustness_level_id < 0 || evidence_ty.robustness_scope_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.robust_proofs.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let proof_info = c.robust_proofs.get(evidence_ty.epistemic_meta_id)
            if proof_info.contest_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_proof(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    proof_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: proof_info.audit_id,
                contest_id: proof_info.contest_id,
                robust_proof_id: evidence_ty.epistemic_meta_id,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_ROBUST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: proof_info.metric_known,
                metric_values: proof_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
    }

    fn check_deferral_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let deferred_pair = self.check_opt_expr(first_arg)
        var c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_deferral_reason_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }
        let add_result = c.deferred_reason_witnesses.add(c.deferred_reason_witness_info_new(e.span, deferred_ty.epistemic_meta_id))
        c.deferred_reason_witnesses = add_result.0
        (c, ty_named(deferral_reason_type_name()))
    }

    fn check_plan_acquisition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_acquisition_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyAcquisitionPolicy {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.acquisition_policies.count {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_acquisition_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.acquisition_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_acquisition_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_acquisition_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = AcquisitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            acquisition_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            objective_name: policy_info.objective_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.acquisition_plans.add(plan_info)
        c.acquisition_plans = add_result.0
        (c, ty_acquisition_plan(inner_ty, add_result.1))
    }

    fn check_acquisition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyAcquisitionPlan {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.acquisition_plans.count {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.acquisition_reason_witnesses.add(c.acquisition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.acquisition_reason_witnesses = add_result.0
        (c, ty_named(acquisition_reason_type_name()))
    }

    fn check_plan_recourse_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_recourse_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyRecoursePolicy {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.recourse_policies.count {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_recourse_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.recourse_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_recourse_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_recourse_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = RecoursePlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            recourse_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            strategy_name: policy_info.strategy_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.recourse_plans.add(plan_info)
        c.recourse_plans = add_result.0
        (c, ty_recourse_plan(inner_ty, add_result.1))
    }

    fn check_recourse_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyRecoursePlan {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.recourse_plans.count {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.recourse_reason_witnesses.add(c.recourse_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.recourse_reason_witnesses = add_result.0
        (c, ty_named(recourse_reason_type_name()))
    }

    fn check_propose_alternatives_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let frontier_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        var source_kind: i64 = -1
        var inner_ty = ty_error()
        var deferred_certificate_id: i64 = -1
        var recourse_plan_id: i64 = -1
        var audit_id: i64 = -1
        var contest_id: i64 = -1
        var strategy_name = empty_name()
        var route_name = empty_name()
        var recourse_policy_id: i64 = -1
        var cert_info = empty_deferred_certificate_info()

        if evidence_ty.kind == TypeKind::TyDeferred {
            source_kind = ALTERNATIVE_SOURCE_DEFERRED
            inner_ty = knowledge_inner(evidence_ty)
            deferred_certificate_id = evidence_ty.epistemic_meta_id
            if deferred_certificate_id < 0 || deferred_certificate_id >= c.deferred_certificates.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            cert_info = c.deferred_certificates.get(deferred_certificate_id)
            audit_id = cert_info.audit_id
            contest_id = cert_info.contest_id
        } else if evidence_ty.kind == TypeKind::TyRecoursePlan {
            source_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
            inner_ty = knowledge_inner(evidence_ty)
            recourse_plan_id = evidence_ty.epistemic_meta_id
            if recourse_plan_id < 0 || recourse_plan_id >= c.recourse_plans.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            let plan_info = c.recourse_plans.get(recourse_plan_id)
            audit_id = plan_info.audit_id
            contest_id = plan_info.contest_id
            strategy_name = plan_info.strategy_name
            route_name = plan_info.route_name
            recourse_policy_id = plan_info.recourse_policy_id
            if plan_info.deferred_certificate_id >= 0 && plan_info.deferred_certificate_id < c.deferred_certificates.count {
                cert_info = c.deferred_certificates.get(plan_info.deferred_certificate_id)
            }
        } else {
            return (c.report_propose_alternatives_requires_evidence(e.span, evidence_ty), ty_error())
        }

        if !types_compatible(inner_ty, value_ty) {
            return (c.report_mismatch(e.span, 1, inner_ty, value_ty), ty_error())
        }

        let frontier_name = c.alternative_frontier_name_from_expr(frontier_arg)
        let frontier_id = c.alternative_frontiers.find(frontier_name)
        if frontier_id < 0 || frontier_id >= c.alternative_frontiers.count {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        let frontier_info = c.alternative_frontiers.get(frontier_id)
        if frontier_info.target_kind != source_kind || !types_compatible(frontier_info.target_ty, evidence_ty) {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        if audit_id < 0 || contest_id < 0 {
            return (c.report_alternative_requires_metadata(e.span, frontier_name), ty_error())
        }
        if frontier_info.policy_id < 0 || frontier_info.policy_id >= c.alternative_policies.count {
            return (c.report_alternative_policy_target_mismatch(e.span, frontier_name), ty_error())
        }
        let policy_info = c.alternative_policies.get(frontier_info.policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_alternative_policy_target_mismatch(e.span, policy_info.name), ty_error())
        }

        if policy_info.max_options >= 0 && frontier_info.candidate_count > policy_info.max_options {
            return (c.report_alternative_candidate_dominated_or_duplicate(e.span, frontier_name), ty_error())
        }

        var realized_candidate_ids: [i64; 16] = [-1; 16]
        var realized_count: i64 = 0
        var idx: i64 = frontier_info.candidate_count - 1
        while idx >= 0 {
            let candidate_id = frontier_info.candidate_ids[idx as usize]
            if candidate_id >= 0 && candidate_id < c.alternative_candidates.count {
                let template = c.alternative_candidates.get(candidate_id)
                let complete_pair = c.alternative_candidate_metrics_complete(template, policy_info)
                if !complete_pair.0 {
                    return (c.report_alternative_candidate_metrics_incomplete(e.span, template.name, c.alternative_metric_name(complete_pair.1)), ty_error())
                }

                let value_check = c.check_expr(template.value_expr)
                c = value_check.0
                let candidate_value_ty = value_check.1
                if !types_compatible(inner_ty, candidate_value_ty) {
                    return (c.report_alternative_candidate_value_mismatch(e.span, template.name, inner_ty, candidate_value_ty), ty_error())
                }

                var realized = template
                if source_kind == ALTERNATIVE_SOURCE_DEFERRED {
                    if !template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, empty_name()), ty_error())
                    }
                    let via_policy_id = c.recourse_policies.find(template.via_recourse_policy_name)
                    if via_policy_id < 0 || via_policy_id >= c.recourse_policies.count {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    let via_policy = c.recourse_policies.get(via_policy_id)
                    if !types_compatible(via_policy.target_ty, inner_ty) {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    if via_policy.requirement_count > 0 {
                        let req_pair = c.check_recourse_policy_requirements_against_deferred(e.span, via_policy.name, via_policy.requirements, cert_info)
                        c = req_pair.0
                        if !req_pair.1 {
                            return (c, ty_error())
                        }
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_DEFERRED,
                        deferred_certificate_id,
                        via_policy_id,
                        -1,
                        via_policy.strategy_name,
                        via_policy.route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                } else {
                    if template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_RECOURSE_PLAN,
                        -1,
                        recourse_policy_id,
                        recourse_plan_id,
                        strategy_name,
                        route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                }
                c.alternative_candidates.entries[candidate_id as usize] = realized
                realized_candidate_ids[realized_count as usize] = candidate_id
                realized_count = realized_count + 1
            }
            idx = idx - 1
        }

        var i: i64 = 0
        while i < realized_count {
            let lhs_id = realized_candidate_ids[i as usize]
            let lhs = c.alternative_candidates.get(lhs_id)
            var j: i64 = 0
            while j < realized_count {
                if i != j {
                    let rhs_id = realized_candidate_ids[j as usize]
                    let rhs = c.alternative_candidates.get(rhs_id)
                    if c.alternative_candidate_is_duplicate(lhs, rhs, policy_info) || c.alternative_candidate_is_dominated(lhs, rhs, policy_info) {
                        return (c.report_alternative_candidate_dominated_or_duplicate(e.span, lhs.name), ty_error())
                    }
                }
                j = j + 1
            }
            i = i + 1
        }

        let set_info = AlternativeSetInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            source_kind: source_kind,
            frontier_id: frontier_id,
            deferred_certificate_id: deferred_certificate_id,
            recourse_plan_id: recourse_plan_id,
            audit_id: audit_id,
            contest_id: contest_id,
            inner_ty: inner_ty,
            candidate_ids: realized_candidate_ids,
            candidate_count: realized_count,
        }
        let add_result = c.alternative_sets.add(set_info)
        c.alternative_sets = add_result.0
        (c, ty_alternative_set(inner_ty, add_result.1))
    }

    fn check_alternative_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_alternative_option_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let idx_arg = expr_list_second(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let idx_pair = eval_const_int_opt_expr(c, idx_arg)
        if !idx_pair.0 {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let set_info = c.alternative_sets.get(set_ty.epistemic_meta_id)
        if idx_pair.1 < 0 || idx_pair.1 >= set_info.candidate_count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let candidate_id = set_info.candidate_ids[idx_pair.1 as usize]
        (c, ty_alternative_option(knowledge_inner(set_ty), candidate_id))
    }

    fn check_alternative_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let option_pair = self.check_opt_expr(first_arg)
        var c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
        || option_ty.epistemic_meta_id < 0
        || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_alternative_reason_requires_option(e.span, option_ty), ty_error())
        }
        let add_result = c.alternative_reason_witnesses.add(c.alternative_reason_witness_info_new(e.span, option_ty.epistemic_meta_id))
        c.alternative_reason_witnesses = add_result.0
        (c, ty_named(alternative_reason_type_name()))
    }

    fn check_commit_alternative_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let option_arg = expr_list_second(e.args)
        let protocol_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let option_pair = c.check_opt_expr(option_arg)
        c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
            || option_ty.epistemic_meta_id < 0
            || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_commit_alternative_requires_option(e.span, option_ty), ty_error())
        }
        let candidate_info = c.alternative_candidates.get(option_ty.epistemic_meta_id)
        let inner_ty = knowledge_inner(option_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let protocol_name = c.transition_protocol_name_from_expr(protocol_arg)
        let protocol_id = c.transition_protocols.find(protocol_name)
        if protocol_id < 0 || protocol_id >= c.transition_protocols.count {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }
        let protocol_info = c.transition_protocols.get(protocol_id)
        if !types_compatible(protocol_info.target_ty, option_ty) {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }

        let policy_id = protocol_info.transition_policy_id
        if policy_id < 0 || policy_id >= c.transition_policies.count {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, option_ty), ty_error())
        }
        let policy_info = c.transition_policies.get(policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.max_steps >= 0 && protocol_info.step_count > policy_info.max_steps {
            return (c.report_transition_steps_exceed_max(e.span, protocol_info.name, policy_info.max_steps, protocol_info.step_count), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_transition_requirements_against_candidate(e.span, policy_info.name, policy_info.requirements, candidate_info)
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        var final_step_expr = candidate_info.value_expr
        var final_step_repr = candidate_info.value_repr
        var i: i64 = 0
        while i < protocol_info.step_count && i < 16 {
            let step_id = protocol_info.step_ids[i as usize]
            if step_id >= 0 && step_id < c.transition_steps.count {
                let step_info = c.transition_steps.get(step_id)
                let step_value_pair = c.check_expr(step_info.value_expr)
                c = step_value_pair.0
                let step_value_ty = step_value_pair.1
                if !types_compatible(inner_ty, step_value_ty) {
                    return (c.report_transition_step_value_mismatch(e.span, step_info.name, inner_ty, step_value_ty), ty_error())
                }
                if step_info.requirement_count > 0 {
                    let req_pair = c.check_transition_requirements_against_candidate(e.span, step_info.name, step_info.requirements, candidate_info)
                    c = req_pair.0
                    if !req_pair.1 {
                        return (c, ty_error())
                    }
                }
                final_step_expr = step_info.value_expr
                final_step_repr = c.transition_expr_value_repr(step_info.value_expr)
            }
            i = i + 1
        }

        if protocol_info.step_count <= 0 || !c.transition_expr_value_matches_candidate(final_step_expr, candidate_info.value_expr) {
            return (c.report_transition_final_step_mismatch(e.span, protocol_info.name, candidate_info.name), ty_error())
        }

        let plan_info = TransitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_policy_id: policy_id,
            transition_protocol_id: protocol_id,
            alternative_option_id: option_ty.epistemic_meta_id,
            audit_id: candidate_info.audit_id,
            contest_id: candidate_info.contest_id,
            route_name: policy_info.route_name,
            rollback_route_name: policy_info.rollback_route_name,
            step_count: protocol_info.step_count,
            final_value_repr: final_step_repr,
            inner_ty: inner_ty,
            metric_known: candidate_info.metric_known,
            metric_values: candidate_info.metric_values,
        }
        let add_result = c.transition_plans.add(plan_info)
        c.transition_plans = add_result.0
        (c, ty_transition_plan(inner_ty, add_result.1))
    }

    fn check_monitoring_policy_requirements_against_plan(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_monitoring_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_monitoring_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_monitoring_policy_requirements_against_plan(span, policy_name, (*list).tail, plan_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn monitoring_policy_has_violation_or_unavailable(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 {
                        return true
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return true
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        false
    }

    fn monitoring_policy_reason_code_from_plan(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> i64 with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 || !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return self.deferral_reason_code_from_metric_id(req.metric_id)
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn monitoring_policy_requirements_hold_silent(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 {
                        return false
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return false
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        true
    }

    fn check_transition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.transition_reason_witnesses.add(c.transition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.transition_reason_witnesses = add_result.0
        (c, ty_named(transition_reason_type_name()))
    }

    fn check_transition_step_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_step_count_requires_plan(e.span, plan_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_observe_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_observe_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_monitoring_policy_requirements_against_plan(
                e.span,
                policy_info.name,
                policy_info.requirements,
                plan_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let observed_info = ObservedTransitionInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.observed_transitions.add(observed_info)
        c.observed_transitions = add_result.0
        (c, ty_observed_transition(inner_ty, add_result.1))
    }

    fn check_rollback_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_rollback_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count <= 0
        || c.monitoring_policy_requirements_hold_silent(policy_info.requirements, plan_info) {
            return (c.report_rollback_transition_requires_failure(e.span, policy_info.name), ty_error())
        }

        let rollback_info = RollbackCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            reason_code: c.monitoring_policy_reason_code_from_plan(policy_info.requirements, plan_info),
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.rollback_certificates.add(rollback_info)
        c.rollback_certificates = add_result.0
        (c, ty_rollback_certificate(inner_ty, add_result.1))
    }

    fn check_contest_witness_expr(self, e: Expr, witness_kind: i64) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let builtin_name = match e.left {
            Some(callee) => if (*callee).kind == ExprKind::ExprIdent { (*callee).name } else { empty_name() }
            None => empty_name()
        }
        let first_arg = expr_list_head(e.args)
        let contest_pair = self.check_opt_expr(first_arg)
        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_contest_witness_requires_contest(e.span, builtin_name, contest_ty)
            return (c, ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }
        let contest_id = contest_ty.epistemic_meta_id
        let contest_info = c.contests.get(contest_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }

        if contest_witness_requires_metric(witness_kind) {
            let metric_id = contest_witness_metric_id(witness_kind)
            let metric_pair = contest_info_get_metric(contest_info, metric_id)
            if !metric_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, metric_id, contest_id)
                return (c, ty_error())
            }
        }

        if contest_witness_requires_mechanistic(witness_kind) {
            if contest_info.mechanistic_report_id < 0 || contest_info.mechanistic_report_id >= c.mechanistic_reports.count {
                c = c.report_mechanistic_report_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_DISAGREEMENT {
            let sign_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_SIGN_CONSENSUS)
            if !sign_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_SIGN_CONSENSUS, contest_id)
                return (c, ty_error())
            }
            let band_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_RELATIVE_BAND)
            if !band_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_RELATIVE_BAND, contest_id)
                return (c, ty_error())
            }
            let tail_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_MAX_TAIL_RISK)
            if !tail_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_MAX_TAIL_RISK, contest_id)
                return (c, ty_error())
            }
            let ident_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_IDENTIFIABILITY_FLOOR)
            if !ident_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_IDENTIFIABILITY_FLOOR, contest_id)
                return (c, ty_error())
            }
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_COUNTEREXAMPLE {
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        let add_result = c.contest_witnesses.add(contest_witness_info_new(e.span, witness_kind, contest_id))
        c.contest_witnesses = add_result.0
        (c, contest_witness_result_type(witness_kind))
    }

    fn check_lift_knowledge_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // lift_knowledge(k: Knowledge<T>) -> Contest<T>
        // Type-check first arg; must be Knowledge<T>; produce Contest<T>
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        (c, ty_contest(inner_ty, k_ty.epistemic_meta_id))
    }

    fn check_lift_knowledge_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        let expected_inner = knowledge_inner(expected_contest_ty)
        if !types_compatible(inner_ty, expected_inner) {
            c = c.report_mismatch(e.span, 1, expected_inner, inner_ty)
            return (c, ty_error())
        }
        if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
            var info = c.contests.get(expected_contest_ty.epistemic_meta_id)
            info = contest_info_attach_span(info, e.span)
            c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
            return (c, ty_contest(expected_inner, expected_contest_ty.epistemic_meta_id))
        }
        (c, expected_contest_ty)
    }

    fn check_measure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // measure(v: T, uncertainty: f64) -> Knowledge<T>
        // Type-check first arg; T = type of value; result = Knowledge<T> with epsilon=-1 (unspecified)
        let first_arg = expr_list_head(e.args)
        let v_pair = self.check_opt_expr(first_arg)
        let c = v_pair.0
        let v_ty = v_pair.1
        (c, ty_knowledge(v_ty, 0.0 - 1.0))
    }

    fn borrow_state_and_shared_count(self, name: Name) -> (i64, i64) with Mut, Panic, Div, Alloc, IO {
        let idx = self.borrows.find(name)
        if idx >= 0 {
            let entry = self.borrows.entries[idx]
            (entry.state, entry.shared_count)
        } else {
            (0, 0)
        }
    }

    // Release borrows taken for function call arguments after the call returns.
    // Handles:
    //   1) implicit boundary borrows: f(x) where param is &T / &!T
    //   2) explicit unary borrows:   f(&x) / f(&!x)
    // Release only borrows introduced by this call expression; pre-existing
    // borrows must remain active even if a call-site borrow attempt fails.
    fn release_call_arg_borrows(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, call_start_borrows: BorrowEnv) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        match args {
            None => c
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                var implicit_release_kind: i64 = 0  // 0=none, 1=shared, 2=exclusive
                var next_params: Option<Box<FnParamList>> = None

                match params {
                    None => {}
                    Some(param_list) => {
                        let param = (*param_list).head
                        if param.ty.kind == TypeKind::TyRef {
                            implicit_release_kind = 1
                        } else if param.ty.kind == TypeKind::TyRefMut {
                            implicit_release_kind = 2
                        }
                        next_params = (*param_list).tail
                    }
                }

                if arg_expr.kind == ExprKind::ExprIdent && implicit_release_kind != 0 {
                    let current_pair = c.borrow_state_and_shared_count(arg_expr.name)
                    let before_idx = call_start_borrows.find(arg_expr.name)
                    let before_pair = if before_idx >= 0 {
                        let before_entry = call_start_borrows.entries[before_idx]
                        (before_entry.state, before_entry.shared_count)
                    } else {
                        (0, 0)
                    }

                    if implicit_release_kind == 1 {
                        if current_pair.1 > before_pair.1 {
                            c.borrows = c.borrows.release_borrow(arg_expr.name)
                        }
                    } else if current_pair.0 == 2 && before_pair.0 != 2 {
                        c.borrows = c.borrows.release_borrow(arg_expr.name)
                    }
                }

                if arg_expr.kind == ExprKind::ExprUnary &&
                   (arg_expr.un_op == UnaryOp::OpRef || arg_expr.un_op == UnaryOp::OpRefMut) {
                    let borrow_name = unary_operand_name(arg_expr.left)
                    if !name_is_empty(borrow_name) {
                        let current_pair = c.borrow_state_and_shared_count(borrow_name)
                        let before_idx = call_start_borrows.find(borrow_name)
                        let before_pair = if before_idx >= 0 {
                            let before_entry = call_start_borrows.entries[before_idx]
                            (before_entry.state, before_entry.shared_count)
                        } else {
                            (0, 0)
                        }

                        if arg_expr.un_op == UnaryOp::OpRef {
                            if current_pair.1 > before_pair.1 {
                                c.borrows = c.borrows.release_borrow(borrow_name)
                            }
                        } else if current_pair.0 == 2 && before_pair.0 != 2 {
                            c.borrows = c.borrows.release_borrow(borrow_name)
                        }
                    }
                }

                c.release_call_arg_borrows((*arg_list).tail, next_params, call_start_borrows)
            }
        }
    }

    fn check_call_args(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.check_call_args_inner(args, params, 0, expected_count, call_span)
        c
    }

    fn check_call_arg_borrow_boundary(self, arg_expr: Expr, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        if arg_expr.kind != ExprKind::ExprIdent {
            return self
        }
        var c = self
        if param_ty.kind == TypeKind::TyRef {
            let borrow_result = c.borrows.try_shared_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        } else if param_ty.kind == TypeKind::TyRefMut {
            let borrow_result = c.borrows.try_exclusive_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        }
        c
    }

    fn check_call_arg_refinement_boundary(self, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.refinement_id < 0 || expected_ty.refinement_id >= 128 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }

        let expected_ref = self.refinements.entries[expected_ty.refinement_id as usize]
        var c = self

        if arg_expr.kind == ExprKind::ExprIntLit {
            if !pred_check_int(expected_ref.predicate, arg_expr.int_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }
        if arg_expr.kind == ExprKind::ExprFloatLit {
            if !pred_check_float(expected_ref.predicate, arg_expr.float_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        if provided_ty.refinement_id >= 0 && provided_ty.refinement_id < 128 {
            let provided_ref = c.refinements.entries[provided_ty.refinement_id as usize]
            if !pred_implies(provided_ref.predicate, expected_ref.predicate) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        c.report_error_at(call_span, 52, 0, 0, 0)
    }

    fn check_call_arg_knowledge_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if !is_epistemic_type(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if !is_epistemic_type(provided_ty) || is_error_or_unknown(provided_ty) {
            return self
        }
        if provided_ty.kind != expected_ty.kind {
            return self.report_error_at(call_span, 36, 0, 0, 0)
        }
        if knowledge_call_boundary_compatible(provided_ty, expected_ty) {
            self
        } else {
            self.report_error_at(call_span, 36, 0, 0, 0)
        }
    }

    fn check_call_args_inner(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, idx: i64, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                let param_info = fn_param_list_get(params, idx)
                let implicit_borrow =
                    arg_expr.kind == ExprKind::ExprIdent &&
                    (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)

                var checker_for_arg = self
                if implicit_borrow {
                    checker_for_arg.suppress_linear_consume_depth = checker_for_arg.suppress_linear_consume_depth + 1
                }

                let pair = checker_for_arg.check_expr(arg_expr)
                var c = pair.0
                if implicit_borrow && c.suppress_linear_consume_depth > 0 {
                    c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
                }
                let arg_ty = pair.1

                // Check against parameter type and boundary contracts
                let has_param_info = !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError
                if has_param_info {
                    if !call_arg_types_compatible(arg_expr, arg_ty, param_info.ty) {
                        c = c.report_mismatch(call_span, 9, param_info.ty, arg_ty)
                    }
                    c = c.check_call_arg_borrow_boundary(arg_expr, param_info.ty, call_span)
                    c = c.check_call_arg_refinement_boundary(arg_expr, arg_ty, param_info.ty, call_span)
                    c = c.check_call_arg_knowledge_boundary(arg_ty, param_info.ty, call_span)
                }
                // Linear type consumption: if arg is linear and not implicitly borrowed, consume it
                if has_param_info &&
                   arg_expr.kind == ExprKind::ExprIdent &&
                   c.is_linear_type(arg_ty) &&
                   !implicit_borrow &&
                   c.suppress_linear_consume_depth == 0 {
                    if c.borrows.is_borrowed(arg_expr.name) {
                        c = c.report_error_at(call_span, 38, 0, 0, 0)
                    } else {
                        let consume_result = c.borrows.consume_linear(arg_expr.name)
                        c.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c = c.report_error_at(call_span, 39, 0, 0, 0)
                        }
                    }
                }
                c.check_call_args_inner((*arg_list).tail, params, idx + 1, expected_count, call_span)
            }
            None => {
                // Check arity: idx should equal expected_count
                if idx != expected_count && expected_count >= 0 {
                    self.report_error_at(call_span, 10, 0, 0, 0)
                } else {
                    self
                }
            }
        }
    }

    fn check_expr_list_no_type(self, opt: Option<Box<ExprList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                c.check_expr_list_no_type((*list).tail)
            }
            None => self
        }
    }

    // Diagnostic-only argument checking helper: validate expression shape/type
    // without consuming linear values from identifier reads.
    fn check_expr_list_no_type_no_linear_consume(self, opt: Option<Box<ExprList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.suppress_linear_consume_depth = c.suppress_linear_consume_depth + 1
        c = c.check_expr_list_no_type(opt)
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        c
    }

    // --------------------------------------------------------
    // If expression
    // --------------------------------------------------------

    fn check_if_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        // Condition must be bool
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check then block
        let then_pair = c.check_opt_block(e.block)
        c = then_pair.0
        let then_ty = then_pair.1
        // Check else
        match e.else_expr {
            Some(else_e) => {
                let else_pair = c.check_expr(*else_e)
                c = else_pair.0
                let else_ty = else_pair.1
                if !types_compatible(then_ty, else_ty) {
                    c = c.report_mismatch(e.span, 7, then_ty, else_ty)
                }
                (c, then_ty)
            }
            None => (c, ty_unit())
        }
    }

    fn check_opt_block(self, opt: Option<Box<Block>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.check_block(*blk)
            None => (self, ty_unit())
        }
    }

    // --------------------------------------------------------
    // Match expression
    // --------------------------------------------------------

    fn check_match_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let scrut_pair = self.check_opt_expr(e.left)
        var c = scrut_pair.0
        let scrut_ty = scrut_pair.1
        c.check_match_arms(e.arms, scrut_ty)
    }

    fn check_match_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let first_ty = pair.1
                c = c.check_remaining_arms((*list).tail, scrut_ty, first_ty)
                (c, first_ty)
            }
            None => (self, ty_unit())
        }
    }

    fn check_match_arm(self, arm: MatchArm, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c = c.bind_pattern(arm.pattern, scrut_ty)
        let pair = c.check_expr(arm.body)
        c = pair.0
        let body_ty = pair.1
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, body_ty)
    }

    fn check_remaining_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry, expected_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let arm_ty = pair.1
                if !types_compatible(arm_ty, expected_ty) {
                    c = c.report_mismatch((*list).head.span, 18, expected_ty, arm_ty)
                }
                c.check_remaining_arms((*list).tail, scrut_ty, expected_ty)
            }
            None => self
        }
    }

    fn bind_pattern(self, pat: Pattern, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatWildcard => self
            PatBinding => {
                var c = self
                c.env = c.env.bind(pat.name, scrut_ty, pat.is_mut)
                c = c.const_int_bind_unknown(pat.name)
                // Track pattern binding for borrow checking (linear if type is linear)
                let lin = c.is_linear_type(scrut_ty)
                c.borrows = c.borrows.track(pat.name, lin)
                c
            }
            PatIntLit => self
            PatBoolTrue => self
            PatBoolFalse => self
            PatStringLit => self
            PatEnum => {
                // Enum variant pattern — bind sub-patterns with scrut_ty
                // (variant field types not tracked yet, use scrut_ty as fallback)
                self.bind_pattern_list(pat.sub_patterns, scrut_ty)
            }
            PatStruct => {
                // Struct destructuring — bind field patterns with their field types
                self.bind_struct_pat_fields(pat.pat_fields, scrut_ty)
            }
            PatTuple => self.bind_tuple_pattern_list(pat.sub_patterns, scrut_ty)
            PatOr => self.bind_pattern_list(pat.sub_patterns, scrut_ty)
        }
    }

    fn bind_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.bind_pattern((*list).head, scrut_ty)
                c.bind_pattern_list((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_struct_pat_fields(self, opt: Option<Box<PatFieldList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                // Look up the field type from the struct definition
                var field_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyNamed {
                    let struct_idx = c.structs.find(scrut_ty.name)
                    if struct_idx >= 0 {
                        let si = c.structs.get(struct_idx)
                        field_ty = field_info_list_find(si.fields, (*list).head.name)
                    }
                }
                c = c.bind_pattern((*list).head.pattern, field_ty)
                c.bind_struct_pat_fields((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_tuple_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        // For tuple patterns, assign each sub-pattern the corresponding tuple element type
        self.bind_tuple_pattern_list_idx(opt, scrut_ty, 0)
    }

    fn bind_tuple_pattern_list_idx(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var elem_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyTuple {
                    elem_ty = type_entry_list_get(scrut_ty.tuple_elems, idx)
                }
                var c = self.bind_pattern((*list).head, elem_ty)
                c.bind_tuple_pattern_list_idx((*list).tail, scrut_ty, idx + 1)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // While, Loop, Block, Return
    // --------------------------------------------------------

    fn check_break_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 44, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_continue_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 45, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_for_in_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check iterator expression (range)
        let iter_pair = self.check_opt_expr(e.left)
        var c = iter_pair.0
        // Push scope for loop variable
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c.env = c.env.bind(e.name, ty_i64(), false)
        c.loop_depth = c.loop_depth + 1
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, ty_unit())
    }

    fn check_while_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body.
        // In a while loop, each iteration may re-borrow the same variables.
        // Without this, the second iteration would fail because the first
        // iteration's exclusive borrows are still active.
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_loop_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body (same as while loops)
        c.borrows = c.borrows.release_exclusive_borrows()
        let pair = c.check_opt_block(e.block)
        c = pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_block_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_block(e.block)
    }

    fn check_return_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let val_ty = pair.1
        if !types_compatible(val_ty, c.current_return_type) {
            c = c.report_mismatch(e.span, 8, c.current_return_type, val_ty)
        }
        (c, ty_never())
    }

    // --------------------------------------------------------
    // Struct literal
    // --------------------------------------------------------

    fn check_struct_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let struct_name = checker_copy_string_list_to_name(e.path.segments)
        let struct_idx = self.structs.find(struct_name)
        if struct_idx >= 0 {
            let si = self.structs.get(struct_idx)
            var c = self.check_struct_field_inits(e.fields, si, e.span)
            (c, ty_named(struct_name))
        } else {
            var c = self.report_error_at(e.span, 15, 0, 0, 0)
            c = c.check_struct_field_inits_no_type(e.fields)
            (c, ty_error())
        }
    }

    fn check_struct_field_inits(self, opt: Option<Box<StructFieldList>>, si: StructInfo, lit_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let init_count = struct_field_list_count(opt)
        if init_count != si.field_count {
            return self.report_error_at(lit_span, 46, 0, 0, 0)
        }
        self.check_struct_field_inits_with_type(opt, si)
    }

    fn check_struct_field_inits_with_type(self, opt: Option<Box<StructFieldList>>, si: StructInfo) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                let field_ty = field_info_list_find(si.fields, (*list).head.name)
                let pair = c.check_expr((*list).head.value)
                c = pair.0
                let init_ty = pair.1
                if !types_compatible(init_ty, field_ty) {
                    c = c.report_mismatch((*list).head.value.span, 16, field_ty, init_ty)
                }
                c.check_struct_field_inits_with_type((*list).tail, si)
            }
            None => self
        }
    }

    fn check_struct_field_inits_no_type(self, opt: Option<Box<StructFieldList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head.value)
                var c = pair.0
                c.check_struct_field_inits_no_type((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Array literal
    // --------------------------------------------------------

    fn check_array_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_array_elems(e.args)
        let c = pair.0
        let elem_ty = pair.1
        let count = pair.2
        (c, ty_array(elem_ty, count))
    }

    fn check_array_elems(self, opt: Option<Box<ExprList>>) -> (Checker, TypeEntry, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let first_ty = pair.1
                let rest = c.check_array_rest((*list).tail, first_ty)
                (rest.0, first_ty, 1 + rest.1)
            }
            None => (self, ty_error(), 0)
        }
    }

    fn check_array_rest(self, opt: Option<Box<ExprList>>, expected: TypeEntry) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let elem_ty = pair.1
                if !types_compatible(elem_ty, expected) {
                    c = c.report_mismatch((*list).head.span, 20, expected, elem_ty)
                }
                let rest = c.check_array_rest((*list).tail, expected)
                (rest.0, 1 + rest.1)
            }
            None => (self, 0)
        }
    }

    // --------------------------------------------------------
    // Tuple literal
    // --------------------------------------------------------

    fn check_tuple_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_tuple_elems(e.args)
        let c = pair.0
        match pair.1 {
            Some(elem_list) => (c, ty_tuple(*elem_list))
            None => (c, ty_unit())
        }
    }

    fn check_tuple_elems(self, opt: Option<Box<ExprList>>) -> (Checker, Option<Box<TypeEntryList>>) with Mut, Panic, Div, Alloc, IO {
        // Iterative: collect element types into array, then build list in reverse.
        // Avoids recursive Checker copies that overflow the SOBC VM stack.
        var c = self
        var types: [TypeEntry; 16] = [empty_type_entry(); 16]
        var count: i64 = 0
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    if count < 16 {
                        let pair = c.check_expr((*list).head)
                        c = pair.0
                        types[count] = pair.1
                        count = count + 1
                        cur = (*list).tail
                    } else {
                        done = true
                    }
                }
                None => {
                    done = true
                }
            }
        }
        if count == 0 {
            return (c, None)
        }
        // Build TypeEntryList in reverse order (last element first)
        var result: Option<Box<TypeEntryList>> = None
        var j = count - 1
        while j >= 0 {
            result = Some(Box::new(TypeEntryList { head: types[j], tail: result }))
            j = j - 1
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Range expression
    // --------------------------------------------------------

    fn check_range_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1
        // Range endpoints must be integer types
        if !is_error_or_unknown(left_ty) && !is_integer_type(left_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), left_ty)
        }
        if !is_error_or_unknown(right_ty) && !is_integer_type(right_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), right_ty)
        }
        (c, ty_unit())
    }

    fn check_cast_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let src_ty = pair.1
        // Resolve the target type from the cast_type annotation
        match e.cast_type {
            Some(ty) => {
                let ty_pair = c.lower_type_expr(*ty)
                c = ty_pair.0
                let target_ty = ty_pair.1
                // Unit conversion check: if both are unit-typed, dimensions must be compatible
                if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
                    let src_dim = c.units.get_dim(src_ty.unit_id)
                    let tgt_dim = c.units.get_dim(target_ty.unit_id)
                    if !unit_dim_compatible(src_dim, tgt_dim) {
                        c = c.report_error_at(e.span, 43, 0, 0, 0)
                    }
                }
                (c, target_ty)
            }
            None => (c, ty_error())
        }
    }

    fn check_handle_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // handle<Effect> { body } with { handlers }
        // The handler discharges the named effect within the body.
        var c = self

        // Resolve the effect name to an ID
        var eff_name_buf: [i8; 64] = [0; 64]
        var i: i64 = 0
        while i < e.name.len && i < 64 {
            eff_name_buf[i as usize] = e.name.buf[i as usize]
            i = i + 1
        }
        let eff_id = effect_name_to_id(eff_name_buf, e.name.len)

        // Add the handled effect to the current effects (body may use it)
        var saved_effects = c.current_effects
        var saved_count = c.current_effect_count
        if eff_id >= 0 && c.current_effect_count < 8 {
            if !has_effect_id(c.current_effects, c.current_effect_count, eff_id) {
                c.current_effects[c.current_effect_count as usize] = eff_id
                c.current_effect_count = c.current_effect_count + 1
            }
        }

        // Check the body block
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        let body_ty = body_pair.1

        // Restore original effects (handler discharges the effect)
        c.current_effects = saved_effects
        c.current_effect_count = saved_count

        // Check the handler block (with { ... }) if present
        match e.handler_block {
            Some(hb) => {
                let hpair = c.check_block(*hb)
                c = hpair.0
            }
            None => {}
        }

        (c, body_ty)
    }

    // --------------------------------------------------------
    // Closure expression checking with effect inference
    // --------------------------------------------------------

    fn check_closure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self

        // Convert closure params to FnParamList for signature
        let params_pair = c.collect_closure_params(e.closure_params)
        c = params_pair.0
        let params = params_pair.1
        let param_count = params_pair.2

        // Lower return type annotation (if present) or use unknown
        let ret_pair = c.lower_opt_closure_return(e.closure_return)
        c = ret_pair.0
        let ret_ty = ret_pair.1

        // Save current effects, clear for inference
        let saved_effects = c.current_effects
        let saved_effect_count = c.current_effect_count
        c.current_effects = [0; 8]
        c.current_effect_count = 0

        // Push scope for parameters
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()

        // Bind closure params in environment
        c = c.bind_closure_params(e.closure_params)

        // Check body expression
        let body_pair = c.check_opt_expr(e.closure_body)
        c = body_pair.0
        let body_ty = body_pair.1

        // Infer return type from body if not annotated
        let inferred_ret_ty = if ret_ty.kind == TypeKind::TyUnknown {
            body_ty
        } else {
            ret_ty
        }

        // Check body type against return type if annotated
        if ret_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(body_ty, ret_ty) {
                c = c.report_mismatch(e.span, 8, ret_ty, body_ty)
            }
        }

        // Get inferred effects from current_effects
        let inferred_effects = c.current_effects
        let inferred_effect_count = c.current_effect_count

        // Pop scope
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()

        // Restore outer effects context
        c.current_effects = saved_effects
        c.current_effect_count = saved_effect_count

        // Create FnSig with inferred effects
        let closure_sig = FnSig {
            name: Name { buf: [0; 128], len: 0 },  // Anonymous closure
            params: params,
            param_count: param_count,
            return_type: inferred_ret_ty,
            is_method: false,
            self_type_name: Name { buf: [0; 128], len: 0 },
            effects: inferred_effects,
            effect_count: inferred_effect_count,
            is_kernel: false,
        }

        // Add to fn_sigs table
        let add_result = c.fn_sigs.add(closure_sig)
        c.fn_sigs = add_result.0
        let sig_id = add_result.1

        (c, ty_fn(sig_id))
    }

    fn collect_closure_params(self, opt: Option<Box<ClosureParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_closure_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_closure_param_list(self, pl: ClosureParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_closure_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn bind_closure_params(self, opt: Option<Box<ClosureParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_closure_param((*pl).head)
                c.bind_closure_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_closure_param(self, p: ClosureParam) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        let pair = c.lower_type_expr(p.ty)
        c = pair.0
        let param_ty = pair.1
        c.env = c.env.bind(p.name, param_ty, false)
        c = c.const_int_bind_unknown(p.name)
        c
    }

    fn lower_opt_closure_return(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }
}

// ============================================================
// Struct field list helper
// ============================================================

fn struct_field_list_count(opt: Option<Box<StructFieldList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + struct_field_list_count((*list).tail)
    }
}
