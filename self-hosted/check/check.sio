            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": model family members must be declared as Model<I, O>\n")
        print("   |\n   = member ")
        print_name_value(model_name)
        print(" has type ")
        print_type_name(got)
        print("\n   = help: declare the model alias as `type ")
        print_name_value(model_name)
        print(" = Model<Input, Output>` before using it in a models family\n")
        c
    }

    fn report_model_family_member_mismatch(
        self,
        span: Span,
        model_name: Name,
        expected_input: TypeEntry,
        expected_output: TypeEntry,
        got_input: TypeEntry,
        got_output: TypeEntry
    ) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E071]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": model family members must share the same Model<I, O> signature\n")
        print("   |\n   = member ")
        print_name_value(model_name)
        print(" has Model<")
        print_type_name(got_input)
        print(", ")
        print_type_name(got_output)
        print(">\n   = expected Model<")
        print_type_name(expected_input)
        print(", ")
        print_type_name(expected_output)
        print(">\n")
        c
    }

    fn report_missing_validation_policy(self, span: Span) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E074]")
