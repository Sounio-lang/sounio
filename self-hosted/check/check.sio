    fn report_mismatch(self, span: Span, code: i64, expected: TypeEntry, got: TypeEntry) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        if got.kind == TypeKind::TyContest && expected.kind != TypeKind::TyContest {
            print("cannot implicitly coerce contested evidence into this type")
        } else {
            print_error_message(code)
        }
        print("\n   |\n   = expected ")
        print_type_name(expected)
        print("\n   = found ")
        print_type_name(got)
        print("\n")
        // Print help and note for this error code
        print_error_help(code)
        print_error_note(code)
        c
    }



    fn report_effect_error(self, span: Span, missing: [i64; 8], missing_count: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E035]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": effect not declared in function signature (missing: ")
        var i: i64 = 0
        while i < missing_count {
            if i > 0 { print(", ") }
            print_effect_name(missing[i as usize])
            i = i + 1
        }
        print(")\n")
        c
    }

    fn check_callee_effects(self, span: Span, callee_effects: [i64; 8], callee_effect_count: i64) -> Checker with Mut, IO, Panic, Div {
        if callee_effect_count == 0 {
            return self
        }
        if effects_subset(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count) {
            return self
        }
        let missing_pair = find_missing_effects(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count)
        self.report_effect_error(span, missing_pair.0, missing_pair.1)
    }

    // --------------------------------------------------------
    // Security hardening: depth and complexity tracking
    // --------------------------------------------------------

    fn check_type_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.type_depth >= MAX_TYPE_DEPTH {
            c = c.report_error_at(span, 60, c.type_depth, MAX_TYPE_DEPTH, 0)
            return (c, false)
        }
        c.type_depth = c.type_depth + 1
        (c, true)
    }

    fn exit_type_depth(self) -> Checker with Mut {
        var c = self
        if c.type_depth > 0 {
            c.type_depth = c.type_depth - 1
        }
        c
    }

    fn check_expr_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.expr_depth >= MAX_EXPR_DEPTH {
            c = c.report_error_at(span, 61, c.expr_depth, MAX_EXPR_DEPTH, 0)
            return (c, false)
        }
        c.expr_depth = c.expr_depth + 1
        (c, true)
    }

    fn exit_expr_depth(self) -> Checker with Mut {
        var c = self
        if c.expr_depth > 0 {
            c.expr_depth = c.expr_depth - 1
        }
        c
    }

    fn check_loop_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.loop_depth >= MAX_LOOP_DEPTH {
            c = c.report_error_at(span, 62, c.loop_depth, MAX_LOOP_DEPTH, 0)
            return (c, false)
        }
        (c, true)
    }

    fn check_complexity(self, cost: i64, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.complexity_budget + cost > MAX_TYPE_COMPLEXITY {
            c = c.report_error_at(span, 64, c.complexity_budget, MAX_TYPE_COMPLEXITY, 0)
            return (c, false)
        }
        c.complexity_budget = c.complexity_budget + cost
        (c, true)
    }

    fn push_const_scope(self) -> Checker with Mut, Div, Panic {
        var c = self
        if c.const_int_scope_depth < MAX_SCOPE_DEPTH {
            c.const_int_scope_marks[c.const_int_scope_depth as usize] = c.const_int_count
            c.const_int_scope_depth = c.const_int_scope_depth + 1
        }
        c
    }

    fn pop_const_scope(self) -> Checker with Mut, Div, Panic {
        var c = self
        if c.const_int_scope_depth > 0 {
            c.const_int_scope_depth = c.const_int_scope_depth - 1
            let mark = c.const_int_scope_marks[c.const_int_scope_depth as usize]
            if mark >= 0 && mark <= c.const_int_count {
                c.const_int_count = mark
            }
        }
        c
    }

    fn const_int_bind_raw(self, name: Name, known: i64, value: i64) -> Checker with Mut, Div, Panic {
        var c = self
        var idx = c.const_int_count
        if idx >= MAX_CONST_INT_BINDINGS {
            idx = MAX_CONST_INT_BINDINGS - 1
        } else {
            c.const_int_count = c.const_int_count + 1
        }
        c.const_int_names[idx as usize] = name
        c.const_int_known[idx as usize] = known
        c.const_int_values[idx as usize] = value
        c
    }

    fn const_int_bind_unknown(self, name: Name) -> Checker with Mut {
        self.const_int_bind_raw(name, 0, 0)
    }

    fn const_int_bind_value(self, name: Name, value: i64) -> Checker with Mut {
        self.const_int_bind_raw(name, 1, value)
    }

    fn const_int_lookup(self, name: Name) -> (bool, i64) with Mut, Panic, Div {
        var i = self.const_int_count - 1
        while i >= 0 {
            if name_eq(self.const_int_names[i as usize], name) {
                if self.const_int_known[i as usize] == 1 {
                    return (true, self.const_int_values[i as usize])
                }
                return (false, 0)
            }
            i = i - 1
        }
        (false, 0)
    }
}

fn print_error_message(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10)
    if code == 1 { print("this binding expects a different type") }
    else if code == 2 { print("cannot assign this value to the target") }
    else if code == 3 { print("cannot modify an immutable binding") }
    else if code == 4 { print("these types cannot be combined with this operator") }
    else if code == 5 { print("this unary operation is not defined for the type") }
    else if code == 6 { print("conditions must be of type `bool`") }
    else if code == 7 { print("branches have incompatible types") }
    else if code == 8 { print("return value does not match function's declared return type") }
    else if code == 9 { print("argument type does not match parameter") }
    else if code == 10 { print("wrong number of arguments in this call") }
    // Member access (11-16)
    else if code == 11 { print("no method named for this type") }
    else if code == 12 { print("this type has no field named") }
    else if code == 13 { print("indexing requires an array type") }
    else if code == 14 { print("array indices must be integers") }
    else if code == 15 { print("unknown struct type") }
    else if code == 16 { print("field initializer has wrong type") }
    // Callables/control flow (17-21)
    else if code == 17 { print("this expression cannot be called") }
    else if code == 18 { print("match arms have incompatible types") }
    else if code == 19 { print("method calls are not supported for this type") }
    else if code == 20 { print("array elements must all have the same type") }
    else if code == 21 { print("compound assignment requires compatible types") }
    // Epistemic (22)
    else if code == 22 { print("epsilon bound must be between 0.0 and 1.0") }
    // Hypercomplex (30-34)
    else if code == 30 { print("cannot combine values from different hypercomplex algebras") }
    else if code == 31 { print("division requires the `Div` effect") }
    else if code == 32 { print("this algebra does not support division") }
    else if code == 33 { print("Clifford algebras have different signatures") }
    else if code == 34 { print("cannot narrow hypercomplex algebra") }
    // Effects (35)
    else if code == 35 { print("function uses effects not declared in its signature") }
    // Epistemic propagation (36)
    else if code == 36 { print("confidence bound is not tight enough") }
    // Borrow checker (37-40)
    else if code == 37 { print("cannot borrow sharedly while exclusive borrow is active") }
    else if code == 38 { print("cannot borrow exclusively while other borrows are active") }
    else if code == 39 { print("linear value has already been used") }
    else if code == 40 { print("linear value must be used") }
    // Units/refinement (41-43)
    else if code == 41 { print("units are incompatible in this operation") }
    else if code == 42 { print("value does not satisfy the refinement predicate") }
    else if code == 43 { print("incompatible unit dimensions in conversion") }
    // Phase A additions (44-51)
    else if code == 44 { print("`break` can only be used inside a loop") }
    else if code == 45 { print("`continue` can only be used inside a loop") }
    else if code == 46 { print("struct literal has wrong number of fields") }
    else if code == 47 { print("tuple index is out of bounds") }
    else if code == 48 { print("bitwise operations require integer types") }
    else if code == 49 { print("shift operations require integer types") }
    else if code == 50 { print("modulo requires integer types") }
    else if code == 51 { print("logical operations require boolean types") }
    // Phase B.3 additions (52-54)
    else if code == 52 { print("cannot prove refinement requirement at this call site") }
    else if code == 53 { print("closure may use undeclared effects") }
    else if code == 54 { print("invalid Knowledge metadata constraint") }
    else if code == 60 { print("type nesting exceeds maximum depth") }
    else if code == 61 { print("expression nesting exceeds maximum depth") }
    else if code == 62 { print("loop nesting exceeds maximum depth") }
    else if code == 64 { print("type complexity budget exceeded") }
    // Causal identifiability (67-68)
    else if code == 67 { print("causal query is non-identifiable: no valid adjustment set blocks all backdoor paths") }
    else if code == 68 { print("causal graph has unblocked backdoor path between cause and effect") }
    // Range / constant (55-57)
    else if code == 55 { print("range endpoints must be integer types") }
    else if code == 56 { print("division by zero detected at compile time") }
    else if code == 57 { print("modulo by zero detected at compile time") }
    else if code == 58 { print("prove_robust(...) requires Contest<T> and Policy<T> with the same inner type") }
    else if code == 59 { print("contest expressions require an explicit Contest<T> annotation") }
    else if code == 63 { print("epistemic wrapper metadata is malformed or unsupported in this compiler slice") }
    else if code == 79 { print("contest witness builtin requires Contest<T, Family, Policy>") }
    else if code == 80 { print("contest metadata is incomplete for witness projection") }
    else if code == 81 { print("requested contest metric is unavailable") }
    else if code == 82 { print("mechanistic report is unavailable for this contest") }
    else if code == 83 { print("counterexample witness is unavailable for this contest") }
    else if code == 84 { print("posterior weight witness is unavailable for this contest") }
    else if code == 85 { print("audit definition requires full Contest<T, Family, Policy>") }
    else if code == 86 { print("audit attachment requires Contest<T, Family, Policy>") }
    else if code == 87 { print("audit target does not match the attached contest") }
    else if code == 88 { print("posterior weights do not match the declared model family") }
    else if code == 89 { print("posterior weights are not normalized") }
    else if code == 90 { print("mechanistic section is incomplete") }
    else if code == 91 { print("counterexample section is incomplete") }
    else if code == 92 { print("duplicate or unknown audit field") }
    else if code == 93 { print("admit_action(...) requires a declared decision_policy item") }
    else if code == 94 { print("decision policy target does not match the admitted action type") }
    else if code == 95 { print("admit_action(...) requires a proof-carrying Robust<T> value") }
    else if code == 96 { print("decision admissibility obligation failed") }
    else if code == 97 { print("defer_action(...) requires a declared deferral_policy item") }
    else if code == 98 { print("deferral policy target does not match the deferred action type") }
    else if code == 99 { print("defer_action(...) requires Contest<T, Family, Policy> or proof-carrying Robust<T> evidence") }
    else if code == 100 { print("deferral policy obligation failed") }
    else if code == 101 { print("deferral_reason(...) requires Deferred<T>") }
    else if code == 102 { print("plan_acquisition(...) requires Deferred<T>") }
    else if code == 103 { print("plan_recourse(...) requires Deferred<T>") }
    else if code == 104 { print("acquisition policy target does not match the deferred subject type") }
    else if code == 105 { print("recourse policy target does not match the deferred subject type") }
    else if code == 106 { print("acquisition policy requires unavailable contest or audit data") }
    else if code == 107 { print("recourse policy requires unavailable contest or audit data") }
    else if code == 108 { print("acquisition_reason(...) requires AcquisitionPlan<T>") }
    else if code == 109 { print("recourse_reason(...) requires RecoursePlan<T>") }
    else if code == 110 { print("deferral_reason(...) requires a recorded deferral certificate") }
    else if code == 111 { print("plan_acquisition(...) requires a declared acquisition_policy item") }
    else if code == 112 { print("plan_recourse(...) requires a declared recourse_policy item") }
    else if code == 113 { print("propose_alternatives(...) requires Deferred<T> or RecoursePlan<T>") }
    else if code == 114 { print("alternative frontier target does not match the supplied evidence type") }
    else if code == 115 { print("alternative frontier candidate references an incompatible or missing recourse_policy") }
    else if code == 116 { print("alternative frontier candidate metrics are incomplete") }
    else if code == 117 { print("alternative frontier candidate value does not match the frontier subject type") }
    else if code == 118 { print("alternative frontier contains a dominated or duplicate candidate") }
    else if code == 119 { print("alternative policy target or objective metadata is invalid for this frontier") }
    else if code == 120 { print("alternative_option(...) requires AlternativeSet<T> and a literal in-range index") }
    else if code == 121 { print("alternative_reason(...) requires AlternativeOption<T>") }
    else if code == 122 { print("alternative frontier requires unavailable deferred, audit, or contest metadata") }
    else if code == 123 { print("commit_alternative(...) requires AlternativeOption<T>") }
    else if code == 124 { print("transition protocol target does not match the supplied alternative type") }
    else if code == 125 { print("transition policy target does not match the supplied alternative type") }
    else if code == 126 { print("final transition step does not equal the selected alternative value") }
    else if code == 127 { print("transition step value does not match the underlying subject type") }
    else if code == 128 { print("transition protocol exceeds the declared max_steps bound") }
    else if code == 129 { print("transition requirement references unavailable evidence") }
    else if code == 130 { print("transition_reason(...) requires TransitionPlan<T>") }
    else if code == 131 { print("observe_transition(...) requires TransitionPlan<T>") }
    else if code == 132 { print("monitoring policy target does not match the supplied transition subject type") }
    else if code == 133 { print("rollback_transition(...) requires TransitionPlan<T>") }
    else if code == 134 { print("rollback_transition(...) requires a violated or unavailable monitoring guard") }
    else if code == 135 { print("monitoring policy requires unavailable transition evidence") }
    else if code == 136 { print("monitoring policy obligation failed") }
    // Sprint 29: Do-calculus type checking errors (138-141)
    else if code == 138 { print("front-door criterion failed: no mediator set intercepts all directed paths from cause to effect") }
    else if code == 139 { print("do-calculus Rule 1 violated: observation is not d-separated from outcome given intervention") }
    else if code == 140 { print("do-calculus Rule 2 violated: action cannot be replaced by observation in this graph") }
    else if code == 141 { print("do-calculus Rule 3 violated: action cannot be deleted from this graph") }
    // GPU kernel constraints (70-72)
    else if code == 70 { print("kernel function cannot have IO, Mut, or Alloc effect") }
    else if code == 71 { print("kernel function parameter type is not GPU-compatible") }
    else if code == 72 { print("kernel function must return unit type") }
    else { print("unknown error") }
}

// Print help text for error codes (actionable fix suggestions)
fn print_error_help(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10) - top 10 most common errors
    if code == 1 {
        print("   |\n   = help: the variable declaration and assigned value have incompatible types\n")
    }
    else if code == 2 {
        print("   |\n   = help: ensure the value type matches the target type for this assignment\n")
    }
    else if code == 3 {
        print("   |\n   = help: declare the variable with `var` instead of `let` to allow mutation\n")
    }
    else if code == 4 {
        print("   |\n   = help: use explicit type conversion with `as` if the types are compatible\n")
    }
    else if code == 5 {
        print("   |\n   = help: check that the operator is valid for this type (e.g., `-x` for numbers, `!x` for bools)\n")
    }
    else if code == 6 {
        print("   |\n   = help: use a comparison operator (e.g., `==`, `!=`, `<`, `>`) to produce a boolean\n")
    }
    else if code == 7 {
        print("   |\n   = help: ensure both branches return the same type, or use explicit conversion\n")
    }
    else if code == 8 {
        print("   |\n   = help: change the return value type to match the function's declared return type\n")
    }
    else if code == 9 {
        print("   |\n   = help: check the function signature and provide an argument of the correct type\n")
    }
    else if code == 10 {
        print("   |\n   = help: check the function signature for the correct number of arguments\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   |\n   = help: check the method name and ensure it is defined for this type\n")
    }
    else if code == 12 {
        print("   |\n   = help: check the field name in the type definition\n")
    }
    else if code == 13 {
        print("   |\n   = help: use square brackets `[]` only on array types\n")
    }
    else if code == 14 {
        print("   |\n   = help: use an integer type (i8, i32, i64, u8, u32, u64) for array indices\n")
    }
