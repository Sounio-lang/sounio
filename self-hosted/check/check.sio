fn print_tuple_type_elems(opt: Option<Box<TypeEntryList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            print_type_name((*list).head)
            match (*list).tail {
                Some(_) => {
                    print(", ")
                    print_tuple_type_elems((*list).tail)
                }
                None => {}
            }
        }
    }
}

fn print_name_value(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i] as i64)
        i = i + 1
    }
}

fn print_compare_op_value(op: CompareOp) with IO {
    match op {
        CmpLt => print("<")
        CmpLe => print("<=")
        CmpEq => print("==")
        CmpGe => print(">=")
        CmpGt => print(">")
    }
}

fn print_milli_ratio(value: f64) with IO {
    let milli = (value * 1000.0) as i64
    print_int(milli)
    print("/1000")
}

fn print_milli_ratio_i64(value: i64) with IO {
    print_int(value)
    print("/1000")
}

fn print_contest_metric_name(metric_id: i64) with IO {
    if metric_id == CONTEST_METRIC_SIGN_CONSENSUS { print("sign_consensus") }
    else if metric_id == CONTEST_METRIC_RELATIVE_BAND { print("relative_band") }
    else if metric_id == CONTEST_METRIC_MAX_TAIL_RISK { print("max_tail_risk") }
    else if metric_id == CONTEST_METRIC_MECHANISTIC_DIVERGENCE { print("mechanistic_divergence") }
    else if metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR { print("identifiability_floor") }
    else if metric_id == CONTEST_METRIC_COUNTEREXAMPLE_PRESENT { print("counterexample_present") }
    else if metric_id == CONTEST_METRIC_DEFERRED_REASON { print("deferred_reason") }
    else { print("unknown_metric") }
}

fn print_transition_metric_name(metric_id: i64) with IO {
    if metric_id == CONTEST_METRIC_SIGN_CONSENSUS
        || metric_id == CONTEST_METRIC_RELATIVE_BAND
        || metric_id == CONTEST_METRIC_MAX_TAIL_RISK
        || metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR
        || metric_id == CONTEST_METRIC_COUNTEREXAMPLE_PRESENT
        || metric_id == CONTEST_METRIC_DEFERRED_REASON {
        print_contest_metric_name(metric_id)
    } else if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
        print("intervention_cost")
    } else if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
        print("residual_tail_risk")
    } else if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
        print("mechanistic_divergence")
    } else if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
        print("admissibility_margin")
    } else {
        print("unknown_metric")
    }
}

fn policy_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 14
        && name.buf[0] == 115 as i8 && name.buf[1] == 105 as i8 && name.buf[2] == 103 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 95 as i8 && name.buf[5] == 99 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 115 as i8
        && name.buf[9] == 101 as i8 && name.buf[10] == 110 as i8 && name.buf[11] == 115 as i8
        && name.buf[12] == 117 as i8 && name.buf[13] == 115 as i8 {
        return CONTEST_METRIC_SIGN_CONSENSUS
    }
    if name.len == 13
        && name.buf[0] == 114 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 108 as i8
        && name.buf[3] == 97 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 118 as i8 && name.buf[7] == 101 as i8 && name.buf[8] == 95 as i8
        && name.buf[9] == 98 as i8 && name.buf[10] == 97 as i8 && name.buf[11] == 110 as i8
        && name.buf[12] == 100 as i8 {
        return CONTEST_METRIC_RELATIVE_BAND
    }
    if name.len == 13
        && name.buf[0] == 109 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 120 as i8
        && name.buf[3] == 95 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 97 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 95 as i8
        && name.buf[9] == 114 as i8 && name.buf[10] == 105 as i8 && name.buf[11] == 115 as i8
        && name.buf[12] == 107 as i8 {
        return CONTEST_METRIC_MAX_TAIL_RISK
    }
    if name.len == 22
        && name.buf[0] == 109 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 99 as i8
        && name.buf[3] == 104 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 110 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 115 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 105 as i8 && name.buf[10] == 99 as i8 && name.buf[11] == 95 as i8
        && name.buf[12] == 100 as i8 && name.buf[13] == 105 as i8 && name.buf[14] == 118 as i8
        && name.buf[15] == 101 as i8 && name.buf[16] == 114 as i8 && name.buf[17] == 103 as i8
        && name.buf[18] == 101 as i8 && name.buf[19] == 110 as i8 && name.buf[20] == 99 as i8
        && name.buf[21] == 101 as i8 {
        return CONTEST_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str21(name,
        105, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 95, 102, 108, 111, 111, 114) {
        return CONTEST_METRIC_IDENTIFIABILITY_FLOOR
    }
    if name_matches_str22(name,
        99, 111, 117, 110, 116, 101, 114, 101, 120, 97, 109, 112, 108, 101, 95, 112, 114, 101, 115, 101, 110, 116) {
        return CONTEST_METRIC_COUNTEREXAMPLE_PRESENT
    }
    if name_matches_str15(name,
        100, 101, 102, 101, 114, 114, 101, 100, 95, 114, 101, 97, 115, 111, 110) {
        return CONTEST_METRIC_DEFERRED_REASON
    }
    -1
}

fn transition_policy_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str17(name,
        105, 110, 116, 101, 114, 118, 101, 110, 116, 105, 111, 110, 95, 99, 111, 115, 116) {
        return TRANSITION_METRIC_INTERVENTION_COST
    }
    if name_matches_str18(name,
        114, 101, 115, 105, 100, 117, 97, 108, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return TRANSITION_METRIC_RESIDUAL_TAIL_RISK
    }
    if name_matches_str22(name,
        109, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return TRANSITION_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str20(name,
        97, 100, 109, 105, 115, 115, 105, 98, 105, 108, 105, 116, 121, 95, 109, 97, 114, 103, 105, 110) {
        return TRANSITION_METRIC_ADMISSIBILITY_MARGIN
    }
    policy_metric_id_from_name(name)
}

fn alternative_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str17(name,
        105, 110, 116, 101, 114, 118, 101, 110, 116, 105, 111, 110, 95, 99, 111, 115, 116) {
        return ALTERNATIVE_METRIC_INTERVENTION_COST
    }
    if name_matches_str18(name,
        114, 101, 115, 105, 100, 117, 97, 108, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK
    }
    if name_matches_str22(name,
        109, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str20(name,
        97, 100, 109, 105, 115, 115, 105, 98, 105, 108, 105, 116, 121, 95, 109, 97, 114, 103, 105, 110) {
        return ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN
    }
    -1
}

fn policy_requirement_holds(value: f64, op: CompareOp, threshold: f64) -> bool {
    if op == CompareOp::CmpLt { return value < threshold }
    if op == CompareOp::CmpLe { return value <= threshold }
    if op == CompareOp::CmpEq { return value == threshold }
    if op == CompareOp::CmpGe { return value >= threshold }
    value > threshold
}

fn print_policy_requirement_value(req: PolicyRequirementInfo) with IO, Mut, Panic, Div {
    if req.threshold_kind == POLICY_THRESHOLD_BOOL {
        if req.bool_threshold { print("true") } else { print("false") }
        return
    }
    if req.threshold_kind == POLICY_THRESHOLD_NAME && req.name_threshold.len > 0 {
        print_name_value(req.name_threshold)
        return
    }
    print_milli_ratio(req.threshold)
}

fn deferral_reason_code_from_name_value(name: Name) -> i64 with Panic, Div {
    if name_matches_str22(name,
        83, 116, 114, 117, 99, 116, 117, 114, 97, 108, 68, 105, 115, 97, 103, 114, 101, 101, 109, 101, 110, 116) {
        return DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT
    }
    if name_matches_str19(name,
        77, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 67, 111, 110, 102, 108, 105, 99, 116) {
        return DEFERRAL_REASON_MECHANISTIC_CONFLICT
    }
    if name_matches_str20(name,
        67, 111, 117, 110, 116, 101, 114, 101, 120, 97, 109, 112, 108, 101, 72, 97, 122, 97, 114, 100) {
        return DEFERRAL_REASON_COUNTEREXAMPLE_HAZARD
    }
    if name_matches_str8(name, 84, 97, 105, 108, 82, 105, 115, 107) {
        return DEFERRAL_REASON_TAIL_RISK
    }
    if name_matches_str18(name,
        73, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 71, 97, 112) {
        return DEFERRAL_REASON_IDENTIFIABILITY_GAP
    }
    if name_matches_str12(name, 84, 114, 97, 110, 115, 112, 111, 114, 116, 71, 97, 112) {
        return DEFERRAL_REASON_TRANSPORT_GAP
    }
    if name_matches_str16(name,
        80, 111, 108, 105, 99, 121, 73, 110, 99, 111, 109, 112, 108, 101, 116, 101) {
        return DEFERRAL_REASON_POLICY_INCOMPLETE
    }
    -1
}

fn print_contest_model_family(info: ContestInfo) with IO, Mut, Panic, Div {
    print("[")
    var i: i64 = 0
    while i < info.model_count && i < 16 {
        if i > 0 { print(", ") }
        print_name_value(info.model_names[i as usize])
        i = i + 1
    }
    print("]")
}

// ============================================================
// Error reporting with diagnostics
// ============================================================

impl Checker {
    fn report_error(self) -> Checker with Mut {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        c
    }

    fn report_error_at(self, span: Span, code: i64, msg_a: i64, msg_b: i64, msg_c: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        print_error_message(code)
        print("\n")
        // Print help and note if available
        print_error_help(code)
        print_error_note(code)
        c
    }

    fn report_unknown_policy_metric(self, span: Span, metric_name: Name) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E065]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": unknown contest diagnostic in policy declaration\n")
        print("   |\n   = metric ")
        print_name_value(metric_name)
        print(" is not supported by the current Contest robustness MVP\n")
        print("   = help: use one of sign_consensus, relative_band, max_tail_risk, mechanistic_divergence, identifiability_floor\n")
        c
    }

    fn report_policy_requires_named_definition(self, span: Span) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E066]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": prove_robust(...) requires a declared policy item\n")
        print("   |\n   = help: declare a named policy such as `policy DoseRobustnessPolicy for Dose { ... }`\n")
        print("   = note: plain Policy<T> annotations do not carry auditable robustness obligations\n")
        c
    }

    fn report_missing_contest_diagnostic(self, span: Span, policy_name: Name, req: PolicyRequirementInfo, contest_id: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E072]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": cannot prove robustness because required contest diagnostics are unavailable\n")
        print("   |\n   = policy ")
        print_name_value(policy_name)
        print(" requires ")
        print_contest_metric_name(req.metric_id)
        print(" ")
        print_compare_op_value(req.op)
        print(" ")
        print_milli_ratio(req.threshold)
        print("\n")
        if contest_id >= 0 && contest_id < self.contests.count {
            let contest_info = self.contests.get(contest_id)
            if contest_info.model_count > 0 {
                print("   = model family ")
                print_contest_model_family(contest_info)
                print("\n")
            }
        }
        print("   = help: attach explicit contest diagnostics before calling prove_robust, or use an empty policy block for a vacuous fence\n")
        print("   = note: the current parser/checker slice preserves disagreement structure but does not infer diagnostic metrics from raw contest terms\n")
        c
    }

    fn report_failed_policy_requirement(self, span: Span, policy_name: Name, req: PolicyRequirementInfo, observed: f64, contest_id: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E073]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": robustness policy obligation failed\n")
        print("   |\n   = policy ")
        print_name_value(policy_name)
        print(" requires ")
        print_contest_metric_name(req.metric_id)
        print(" ")
        print_compare_op_value(req.op)
        print(" ")
        print_milli_ratio(req.threshold)
        print("\n   = observed ")
        print_contest_metric_name(req.metric_id)
        print(" = ")
        print_milli_ratio(observed)
        print("\n")
        if contest_id >= 0 && contest_id < self.contests.count {
            let contest_info = self.contests.get(contest_id)
            if contest_info.model_count > 0 {
                print("   = model family ")
                print_contest_model_family(contest_info)
                print("\n")
            }
        }
        print("   = help: narrow the admissible model family with explicit justification, or strengthen the policy diagnostics before promotion\n")
        c
    }

