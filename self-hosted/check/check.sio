    fn report_model_family_mismatch(self, span: Span, family: ModelFamilyInfo, contest_info: ContestInfo) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E070]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": contest model list does not match the declared family\n")
        print("   |\n   = declared family ")
        print_name_value(family.name)
        print(" = [")
        var i: i64 = 0
        while i < family.model_count && i < 16 {
            if i > 0 { print(", ") }
            print_name_value(family.model_names[i as usize])
            i = i + 1
        }
        print("]\n   = found contest [")
        i = 0
        while i < contest_info.model_count && i < 16 {
            if i > 0 { print(", ") }
            print_name_value(contest_info.model_names[i as usize])
            i = i + 1
        }
        print("]\n")
        print("   = help: keep the inline contest list identical to the named family in both membership and order\n")
        c
    }

