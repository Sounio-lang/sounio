    // Audited<T> (G9): every surgical op emits a machine-checkable Lean
    // derivation. Requires both ZD (annihilation) and Witness (checkability).
    // Error 205 when either is missing.
    fn lower_audited_type(self, inner_opt: Option<Box<TypeExpr> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            None => (self, ty_error())
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                var c = pair.0
                let inner_ty = pair.1
                let zd_id = 18
                let witness_id = 19
                let has_zd = has_effect_id(c.current_effects, c.current_effect_count, zd_id)
                let has_wit = has_effect_id(c.current_effects, c.current_effect_count, witness_id)
                if !has_zd || !has_wit {
                    c = c.report_error_at(span, 205, 0, 0, 0)
                }
                (c, inner_ty)
            }
        }
    }

