fn print_warning_message(code: i64) with IO, Mut, Panic, Div {
    if code == 40 {
        print("cannot statically verify refinement predicate at this call site\n")
        print("   = note: the compiler could not prove the argument satisfies the parameter's refinement type\n")
        print("   = note: this compiles but may fail at runtime; annotate with an explicit refinement type to prove statically\n")
    }
    else if code == 41 { print("ontology subsumption could not be verified") }
    else if code == 42 { print("ontology axiom overflow - more than 16 property axioms available; proof may be incomplete") }
    else if code == 43 {
        print("boolean equality on uncertain value: exact == ignores uncertainty\n")
        print("   = help: use ep_eq_prob + ep_decide (epistemic::uncertain_eq) or claim exactness")
    }
    else if code == 45 {
        print("public function performs an effect its signature does not declare\n")
        print("   = note: the effect was INFERRED from the body (spec 7.2.1); callers outside this module read the declaration, not the inference\n")
        print("   = help: add the inferred effect to the `with` clause, or make the function private")
    }
    else if code == 44 {
        print("associated-function call on an unknown type: the target resolves to no definition\n")
        print("   = note: this compiles and evaluates to 0 -- it does not allocate or call anything\n")
        print("   = help: define the type and its associated function, or call an existing one")
    }
    else {
        print("unknown warning")
    }
}

// ============================================================
// Borrow checking helpers
// ============================================================

fn call_expr_is_builtin_prove_robust(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str12((*expr).name, 112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
        }
        None => false
    }
}

// "validate_manifest" = v(118) a(97) l(108) i(105) d(100) a(97) t(116) e(101)
//                       _(95) m(109) a(97) n(110) i(105) f(102) e(101) s(115) t(116), len=17
fn call_expr_is_builtin_validate_manifest(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str17((*expr).name,
                118, 97, 108, 105, 100, 97, 116, 101, 95,
                109, 97, 110, 105, 102, 101, 115, 116)
        }
        None => false
    }
}

