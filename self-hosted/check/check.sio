    fn lower_contest_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                match (*args).tail {
                    None => {
                        let pair = self.lower_type_expr((*args).head)
                        if pair.1.kind == TypeKind::TyError {
                            pair
                        } else {
                            (pair.0, ty_contest(pair.1, -1))
                        }
                    }
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let family_pair = c.lower_type_expr((*rest).head)
                                        c = family_pair.0
                                        let family_ty = family_pair.1
                                        let policy_pair = c.lower_type_expr((*last).head)
                                        c = policy_pair.0
                                        let policy_ty = policy_pair.1
                                        if family_ty.kind != TypeKind::TyModelFamily {
                                            return (c.report_missing_model_family_metadata(span), ty_error())
                                        }
                                        if policy_ty.kind != TypeKind::TyPolicy {
                                            return (c.report_policy_requires_named_definition(span), ty_error())
                                        }
                                        if !types_compatible(model_output_ty(family_ty), inner_ty) || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                            return (c.report_error_at(span, 58, 0, 0, 0), ty_error())
                                        }
                                        let family_info = c.model_families.get(family_ty.epistemic_meta_id)
                                        var info = contest_info_from_family_signature(family_info, policy_ty.epistemic_meta_id)
                                        info = contest_info_attach_span(info, span)
                                        info = contest_info_attach_family_id(info, family_ty.epistemic_meta_id)
                                        let add_result = c.contests.add(info)
                                        c.contests = add_result.0
                                        (c, ty_contest(inner_ty, add_result.1))
                                    }
                                }
                            }
                            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                        }
                    }
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

    fn lower_robust_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(args) => {
                match (*args).tail {
                    None => {
                        let pair = self.lower_type_expr((*args).head)
                        if pair.1.kind == TypeKind::TyError {
                            pair
                        } else {
                            (pair.0, ty_robust(pair.1, -1, -1, -1))
                        }
                    }
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let level_id = c.robust_type_tag_from_type_expr((*rest).head, true)
                                        let scope_id = c.robust_type_tag_from_type_expr((*last).head, false)
                                        if level_id < 0 || scope_id < 0 {
                                            c = c.report_error_at(span, 63, 0, 0, 0)
                                            return (c, ty_error())
                                        }
                                        (c, ty_robust(inner_ty, -1, level_id, scope_id))
                                    }
                                }
                            }
                            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
                        }
                    }
                }
            }
            None => (self.report_error_at(span, 63, 0, 0, 0), ty_error())
        }
    }

    fn lower_intervention_type(self, opt: Option<Box<KnowledgeTypeInfo> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_intervention_type(self, *info)
            None => (self, ty_error())
        }
    }

    fn lower_counterfactual_type(self, opt: Option<Box<KnowledgeTypeInfo> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_counterfactual_type(self, *info)
            None => (self, ty_error())
        }
    }

    fn lower_validated_type(
        self,
        type_args: Option<Box<TypeExprList> >,
        opt: Option<Box<KnowledgeTypeInfo> >,
        span: Span
    ) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_validated_type(self, *info)
            None => {
                let pair = self.lower_single_wrapper_arg(type_args, span)
                if pair.1.kind == TypeKind::TyError {
                    pair
                } else {
                    (pair.0, ty_validated(pair.1, -1.0))
                }
            }
        }
    }

    fn lower_admissible_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_admissible(pair.1, -1))
        }
    }

    fn lower_deferred_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_deferred(pair.1, -1))
        }
    }

    // ============================================================
    // Sprint 27: Annotation syntax lowering
    // ============================================================

    fn lower_diffprivate_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_diff_private(pair.1, 1000, -1))
        }
    }

    fn lower_dp_budget_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_dp_budget(pair.1, 1000, 0))
        }
    }

    fn lower_causal_effect_annotation(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_causal_effect(pair.1, -1, 0))
        }
    }

    fn lower_aleatoric_annotation(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_aleatoric(pair.1, -1.0))
        }
    }

    fn lower_potential_outcome_type(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_potential_outcome(pair.1, -1, -1, -1))
        }
    }

    fn lower_proof_annotation(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_proof(pair.1, 0, -1, 1000.0, 0, -1))
        }
    }

    fn lower_lemma_annotation(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_lemma(pair.1, -1, -1, 1000.0, 0, -1))
        }
    }

    fn lower_axiom_annotation(self, opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_single_wrapper_arg(opt, span)
        if pair.1.kind == TypeKind::TyError {
            pair
        } else {
            (pair.0, ty_axiom(pair.1, -1, -1, 1000.0, -1, 0))
        }
    }

    fn lower_refinement_type(self, opt: Option<Box<RefinementInfo> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => {
                let ri = *info
                match ri.base_type {
                    Some(bte) => {
                        let pair = self.lower_type_expr(*bte)
                        var c = pair.0
                        let base_ty = pair.1
                        // Build refinement predicate from inline annotation
                        if ri.pred_op > 0 {
                            let pred = if ri.pred_is_float {
                                pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
                            } else {
                                pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
                            }
                            var full_pred = pred
                            if ri.compound_op == 7 || ri.compound_op == 8 {
                                let pred2 = if ri.pred2_is_float {
                                    pred_make_float(ri.pred2_op, ri.var_name, ri.pred2_float_val)
                                } else {
                                    pred_make_int(ri.pred2_op, ri.var_name, ri.pred2_int_val)
                                }
                                if ri.compound_op == 7 {
                                    full_pred = pred_and(pred, pred2)
                                } else {
                                    full_pred = pred_or(pred, pred2)
                                }
                            }
                            let rt = RefinementType { base_type: base_ty, var_name: ri.var_name, predicate: full_pred }
                            let synth_name = make_refinement_synth_name(c.refinements.count)
                            c.refinements = refinement_table_add(c.refinements, synth_name, rt)
                            let ref_idx = c.refinements.count - 1
                            (c, ty_with_refinement(base_ty, ref_idx))
                        } else {
                            (c, base_ty)
                        }
                    }
                    None => (self, ty_error())
                }
            }
            None => (self, ty_error())
        }
    }
}

fn lower_array_size(opt: Option<Box<Expr> >) -> i64 {
    match opt {
        Some(e) => (*e).int_val
        None => -1
    }
}

// ============================================================
// Pass 1: Collect top-level declarations
// ============================================================

impl Checker {
    fn collect_items(self, items: Option<Box<ItemList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cursor = items
        while true {
            match cursor {
                Some(list) => {
                    c = c.collect_item((*list).head)
                    cursor = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn collect_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemKind::ItemFn => {
                match item.fn_def {
                    Some(fd) => self.collect_fn_def(item.name, Some(fd), item.visibility, self.current_module)
                    None => self.collect_global_item_annotation(item.type_alias_ty)
                }
            }
            ItemKind::ItemStruct => self.collect_struct_def(item.name, item.struct_def, item.visibility, self.current_module)
            ItemKind::ItemEnum => self.collect_enum_def(item.name, item.enum_def, item.visibility, self.current_module)
            ItemKind::ItemImpl => self.collect_impl_def(item.impl_def)
            ItemKind::ItemTypeAlias => self.collect_type_alias(item.name, item.type_alias_ty)
            ItemKind::ItemModels => self.collect_models_def(item.name, item.models_def)
            ItemKind::ItemPolicy => self.collect_policy_def(item.name, item.policy_def)
            ItemKind::ItemAcquisitionPolicy => self.collect_acquisition_policy_def(item.name, item.acquisition_policy_def)
            ItemKind::ItemRecoursePolicy => self.collect_recourse_policy_def(item.name, item.recourse_policy_def)
            ItemKind::ItemTransitionPolicy => self.collect_transition_policy_def(item.name, item.transition_policy_def)
            ItemKind::ItemTransitionProtocol => self.collect_transition_protocol_def(item.name, item.transition_protocol_def)
            ItemKind::ItemMonitoringPolicy => self.collect_monitoring_policy_def(item.name, item.monitoring_policy_def)
            ItemKind::ItemAlternativePolicy => self.collect_alternative_policy_def(item.name, item.alternative_policy_def)
            ItemKind::ItemAlternativeFrontier => self.collect_alternative_frontier_def(item.name, item.alternative_frontier_def)
            ItemKind::ItemDecisionPolicy => self.collect_decision_policy_def(item.name, item.decision_policy_def)
            ItemKind::ItemDeferralPolicy => self.collect_deferral_policy_def(item.name, item.deferral_policy_def)
            ItemKind::ItemValidation => self.collect_validation_def(item.name, item.validation_def)
            ItemKind::ItemAudit => self.collect_audit_def(item.name, item.audit_def)
            ItemKind::ItemUse => self
            ItemKind::ItemUnit => self.collect_unit_decl(item.name)
            ItemKind::ItemEffect => self.collect_item_effect(item.effect_def)
            ItemKind::ItemSession => self  // Session protocol registered in collect pass (no-op for now)
            ItemKind::ItemTrait => self.collect_trait_def(item.name, item.trait_def)
            ItemKind::ItemAlgebra => self.collect_algebra_def(item.algebra_def)
            ItemKind::ItemStudy => self.collect_study_def(item.span, item.study_def)
            ItemKind::ItemOntology => self.collect_ontology_def(item.ontology_def)
            // Claim metadata is removed from the item stream by the parse
            // driver, so collection has no work to perform for this variant.
            ItemKind::ItemClaim => self
            // Same for a causal graph: the parse driver drops it, and the graph
            // itself is already in the CG_* registry by the time we get here.
            ItemKind::ItemCausalGraph => self
        }
    }

    fn collect_global_item_annotation(self, declared_ty: Option<Box<TypeExpr>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match declared_ty {
            Some(te) => self.lower_type_expr(*te).0
            None => self
        }
    }

    fn collect_item_effect(self, opt: Option<Box<EffectDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(edef) => {
                var c = self
                let eid = 100 + c.effects.count
                let first_op_id = c.effect_ops.count
                c = c.collect_effect_op_defs((*edef).ops, eid)
                let op_count = c.effect_ops.count - first_op_id
                let info = EffectInfo {
                    name: (*edef).name,
                    op_count: op_count,
                    first_op_id: first_op_id,
                }
                let add_result = c.effects.add(info)
                c.effects = add_result.0
                c
            }
        }
    }

    fn collect_effect_op_defs(self, opt: Option<Box<EffectOpDefList> >, effect_id: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(node) => {
                var c = self
                let head = (*node).head
                let ret_pair = match head.ret_ty {
                    None => (c, ty_unit())
                    Some(te_box) => c.lower_type_expr(*te_box)
                }
                c = ret_pair.0
                let ret_ty = ret_pair.1
                let op_info = EffectOpInfo {
                    name: head.name,
                    effect_id: effect_id,
                    param_count: 0,
                    ret_ty: ret_ty,
                }
                let add_result = c.effect_ops.add(op_info)
                c.effect_ops = add_result.0
                c.collect_effect_op_defs((*node).tail, effect_id)
            }
        }
    }

    fn lookup_user_effect_id(self, name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.effects.count {
            let entry = self.effects.entries[i as usize]
            if entry.name.len == name_len {
                var j: i64 = 0
                var matched = true
                while j < name_len && j < 64 {
                    if entry.name.buf[j as usize] != name_buf[j as usize] {
                        matched = false
                    }
                    j = j + 1
                }
                if matched {
                    return 100 + i
                }
            }
            i = i + 1
        }
        -1
    }

    fn extract_effects_with_checker(self, opt: Option<Box<EffectList> >) -> ExtractEffectsResult with Mut, Panic, Div {
        match opt {
            None => ExtractEffectsResult { checker: self, effects: [0; 8], count: 0 }
            Some(list) => self.collect_effects_with_checker(*list, [0; 8], 0)
        }
    }

    fn collect_effects_with_checker(self, list: EffectList, effects: [i64; 8], count: i64) -> ExtractEffectsResult with Mut, Panic, Div {
        var effs = effects
        var n = count
        var eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)
        if eff_id < 0 {
            eff_id = self.lookup_user_effect_id(list.head.name_buf, list.head.name_len)
        }
        if eff_id >= 0 && n < 8 {
            var already_present = false
            var i: i64 = 0
            while i < n {
                if effs[i as usize] == eff_id {
                    already_present = true
                }
                i = i + 1
            }
            if !already_present {
                effs[n as usize] = eff_id
                n = n + 1
            }
        }
        match list.tail {
            None => ExtractEffectsResult { checker: self, effects: effs, count: n }
            Some(next) => self.collect_effects_with_checker(*next, effs, n)
        }
    }

    fn collect_type_alias(self, name: Name, ty_opt: Option<Box<TypeExpr> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match ty_opt {
            Some(te_box) => {
                let te = *te_box
                if te.kind == TypeExprKind::TypeRefinement {
                    // Register refinement type: type Pos = { x: i64 | x > 0 }
                    match te.refinement_info {
                        Some(ri_box) => {
                            let ri = *ri_box
                            // Lower base type
                            let pair = match ri.base_type {
                                Some(bte) => self.lower_type_expr(*bte)
                                None => (self, ty_error())
                            }
                            var c = pair.0
                            let base_ty = pair.1
                            // Build predicate from parsed op + value
                            let pred = if ri.pred_is_float {
                                pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
                            } else {
                                pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
                            }
                            var full_pred = pred
                            if ri.compound_op == 7 || ri.compound_op == 8 {
                                let pred2 = if ri.pred2_is_float {
                                    pred_make_float(ri.pred2_op, ri.var_name, ri.pred2_float_val)
                                } else {
                                    pred_make_int(ri.pred2_op, ri.var_name, ri.pred2_int_val)
                                }
                                if ri.compound_op == 7 {
                                    full_pred = pred_and(pred, pred2)
                                } else {
                                    full_pred = pred_or(pred, pred2)
                                }
                            }
                            let rt = RefinementType {
                                base_type: base_ty,
                                var_name: ri.var_name,
                                predicate: full_pred,
                            }
                            c.refinements = refinement_table_add(c.refinements, name, rt)
                            c
                        }
                        None => self
                    }
                } else {
                    let pair = self.lower_type_expr(te)
                    var c = pair.0
                    let alias_ty = pair.1
                    c.env = c.env.bind(name, alias_ty, false)
                    c = c.const_int_bind_unknown(name)
                    if alias_ty.kind == TypeKind::TyModel {
                        let info = ModelInfo {
                            name: name,
                            input_ty: model_input_ty(alias_ty),
                            output_ty: model_output_ty(alias_ty),
                        }
                        let add_result = c.models.add(info)
                        c.models = add_result.0
                    }
                    c
                }
            }
            None => self
        }
    }

    fn collect_unit_decl(self, name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Register user-defined unit as a mass-like dimension (f64 base)
        // For now, user-defined units get a generic dimension
        c.units = c.units.register(name, unit_dim_dimensionless())
        c
    }

    fn collect_policy_def(self, name: Name, opt: Option<Box<PolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pd) => {
                let target_pair = self.lower_type_expr((*pd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let __r = c.collect_policy_requirements((*pd).requirements)
                c = __r.checker
                let requirements = __r.requirements
                let requirement_count = __r.count
                let info = PolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    level_name: (*pd).level_name,
                    scope_name: (*pd).scope_name,
                    level_id: robustness_level_id_from_name((*pd).level_name),
                    scope_id: robustness_scope_id_from_name((*pd).scope_name),
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.policies.add(info)
                c.policies = add_result.0
                c.env = c.env.bind(name, ty_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_acquisition_policy_def(self, name: Name, opt: Option<Box<AcquisitionPolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => {
                let target_pair = self.lower_type_expr((*ap).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let __r = c.collect_policy_requirements((*ap).requirements)
                c = __r.checker
                let requirements = __r.requirements
                let requirement_count = __r.count
                let info = AcquisitionPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    objective_name: (*ap).objective_name,
                    route_name: (*ap).route_name,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.acquisition_policies.add(info)
                c.acquisition_policies = add_result.0
                c.env = c.env.bind(name, ty_acquisition_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_recourse_policy_def(self, name: Name, opt: Option<Box<RecoursePolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(rp) => {
                let target_pair = self.lower_type_expr((*rp).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let __r = c.collect_policy_requirements((*rp).requirements)
                c = __r.checker
                let requirements = __r.requirements
                let requirement_count = __r.count
                let info = RecoursePolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    strategy_name: (*rp).strategy_name,
                    route_name: (*rp).route_name,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.recourse_policies.add(info)
                c.recourse_policies = add_result.0
                c.env = c.env.bind(name, ty_recourse_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_transition_policy_def(self, name: Name, opt: Option<Box<TransitionPolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tp) => {
                let target_pair = self.lower_type_expr((*tp).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_transition_policy_requirements((*tp).requirements)
                c = req_pair.checker
                let info = TransitionPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    route_name: (*tp).route_name,
                    requirements: req_pair.requirements,
                    requirement_count: req_pair.count,
                    max_steps: (*tp).max_steps,
                    rollback_route_name: (*tp).rollback_route_name,
                }
                let add_result = c.transition_policies.add(info)
                c.transition_policies = add_result.0
                c.env = c.env.bind(name, ty_transition_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_monitoring_policy_def(self, name: Name, opt: Option<Box<MonitoringPolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(mp) => {
                let target_pair = self.lower_type_expr((*mp).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_transition_policy_requirements((*mp).requirements)
                c = req_pair.checker
                let info = MonitoringPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    route_name: (*mp).route_name,
                    requirements: req_pair.requirements,
                    requirement_count: req_pair.count,
                    rollback_route_name: (*mp).rollback_route_name,
                }
                let add_result = c.monitoring_policies.add(info)
                c.monitoring_policies = add_result.0
                c.env = c.env.bind(name, ty_monitoring_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_transition_protocol_def(self, name: Name, opt: Option<Box<TransitionProtocolDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(proto) => {
                let target_pair = self.lower_type_expr((*proto).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                if target_ty.kind != TypeKind::TyAlternativeOption {
                    c = c.report_transition_protocol_target_mismatch((*proto).span, name, target_ty)
                    return c
                }

                let policy_id = c.transition_policies.find((*proto).policy_name)
                if policy_id < 0 || policy_id >= c.transition_policies.count {
                    c = c.report_transition_policy_target_mismatch((*proto).span, (*proto).policy_name, knowledge_inner(target_ty), ty_error())
                    return c
                }
                let policy_info = c.transition_policies.get(policy_id)
                let inner_ty = knowledge_inner(target_ty)
                if !types_compatible(policy_info.target_ty, inner_ty) {
                    c = c.report_transition_policy_target_mismatch((*proto).span, policy_info.name, policy_info.target_ty, inner_ty)
                    return c
                }

                let step_pair = c.collect_transition_step_defs((*proto).steps)
                c = step_pair.checker
                let info = TransitionProtocolInfo {
                    name: name,
                    target_ty: target_ty,
                    transition_policy_id: policy_id,
                    step_ids: step_pair.steps,
                    step_count: step_pair.count,
                }
                let add_result = c.transition_protocols.add(info)
                c.transition_protocols = add_result.0
                c.env = c.env.bind(name, ty_unknown(), false)
                c = c.const_int_bind_unknown(name)

                var i: i64 = 0
                while i < step_pair.count && i < 16 {
                    let step_id = step_pair.steps[i as usize]
                    if step_id >= 0 && step_id < c.transition_steps.count {
                        var step_info = c.transition_steps.get(step_id)
                        step_info.protocol_id = add_result.1
                        c.transition_steps.entries[step_id as usize] = step_info
                    }
                    i = i + 1
                }
                c
            }
            None => self
        }
    }

    fn collect_transition_step_defs(self, opt: Option<Box<TransitionStepDefList> >) -> CollectTransitionStepDefsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var ids: [i64; 16] = [-1; 16]
                var count: i64 = 0
                let rest_pair = c.collect_transition_step_defs((*list).tail)
                c = rest_pair.checker
                ids = rest_pair.steps
                count = rest_pair.count
                if count < 16 {
                    let req_pair = c.collect_transition_policy_requirements((*list).head.requirements)
                    c = req_pair.checker
                    let info = TransitionStepInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        protocol_id: -1,
                        name: (*list).head.name,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        requirements: req_pair.requirements,
                        requirement_count: req_pair.count,
                    }
                    let add_result = c.transition_steps.add(info)
                    c.transition_steps = add_result.0
                    var shifted: [i64; 16] = [-1; 16]
                    shifted[0] = add_result.1
                    var i: i64 = 0
                    while i < count && i + 1 < 16 {
                        shifted[(i + 1) as usize] = ids[i as usize]
                        i = i + 1
                    }
                    ids = shifted
                    count = count + 1
                }
                CollectTransitionStepDefsResult { checker: c, steps: ids, count: count }
            }
            None => CollectTransitionStepDefsResult { checker: self, steps: [-1; 16], count: 0 }
        }
    }

    fn collect_transition_policy_requirements(self, opt: Option<Box<PolicyRequirementList> >) -> CollectTransitionPolicyRequirementsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_transition_policy_requirement_list(*list)
                CollectTransitionPolicyRequirementsResult { checker: pair.checker, requirements: Some(Box::new(pair.list)), count: pair.count }
            }
            None => CollectTransitionPolicyRequirementsResult { checker: self, requirements: None, count: 0 }
        }
    }

    fn collect_transition_policy_requirement_list(self, list: PolicyRequirementList) -> CollectTransitionPolicyRequirementListResult with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = transition_policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => CollectTransitionPolicyRequirementListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let rest_pair = c.collect_transition_policy_requirement_list(*rest)
                c = rest_pair.checker
                let rest_list = rest_pair.list
                let rest_count = rest_pair.count
                CollectTransitionPolicyRequirementListResult { checker: c, list: PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, count: 1 + rest_count }
            }
        }
    }

    fn collect_alternative_policy_def(self, name: Name, opt: Option<Box<AlternativePolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => {
                let target_pair = self.lower_type_expr((*ap).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let seed_metric_ids: [i64; 8] = [-1; 8]
                let seed_directions: [i64; 8] = [0; 8]
                let obj_pair = c.collect_alternative_objectives((*ap).objectives, seed_metric_ids, seed_directions, 0)
                c = obj_pair.checker
                let info = AlternativePolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    frontier_name: (*ap).frontier_name,
                    objective_metric_ids: obj_pair.metric_ids,
                    objective_directions: obj_pair.directions,
                    objective_count: obj_pair.count,
                    max_options: (*ap).max_options,
                }
                let add_result = c.alternative_policies.add(info)
                c.alternative_policies = add_result.0
                c.env = c.env.bind(name, ty_alternative_policy(target_ty, add_result.1), false)
                c
            }
            None => self
        }
    }

    fn collect_alternative_frontier_def(self, name: Name, opt: Option<Box<AlternativeFrontierDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let target_pair = self.lower_type_expr((*fd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1

                var target_kind: i64 = -1
                var inner_ty = ty_error()
                if target_ty.kind == TypeKind::TyDeferred {
                    target_kind = ALTERNATIVE_SOURCE_DEFERRED
                    inner_ty = knowledge_inner(target_ty)
                } else if target_ty.kind == TypeKind::TyRecoursePlan {
                    target_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
                    inner_ty = knowledge_inner(target_ty)
                } else {
                    c = c.report_error_at((*fd).span, 114, 0, 0, 0)
                }

                let policy_id = c.alternative_policies.find((*fd).policy_name)
                if policy_id < 0 {
                    c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                } else {
                    let policy_info = c.alternative_policies.get(policy_id)
                    if !types_compatible(policy_info.target_ty, inner_ty) {
                        c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                    }
                }

                let cand_pair = c.collect_alternative_candidates((*fd).candidates)
                c = cand_pair.checker
                let info = AlternativeFrontierInfo {
                    name: name,
                    target_kind: target_kind,
                    target_ty: target_ty,
                    policy_id: policy_id,
                    candidate_ids: cand_pair.candidates,
                    candidate_count: cand_pair.count,
                }
                let add_result = c.alternative_frontiers.add(info)
                c.alternative_frontiers = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_alternative_objectives(
        self,
        opt: Option<Box<AlternativeObjectiveDefList> >,
        metric_ids: [i64; 8],
        directions: [i64; 8],
        count: i64
    ) -> CollectAlternativeObjectivesResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var mids = metric_ids
                var dirs = directions
                var next_count = count
                let metric_id = alternative_metric_id_from_name((*list).head.metric_name)
                if metric_id < 0 || count >= 8 {
                    c = c.report_error_at((*list).head.span, 119, 0, 0, 0)
                } else {
                    mids[count as usize] = metric_id
                    dirs[count as usize] =
                        if (*list).head.direction == AlternativeObjectiveDirection::AlternativeObjectiveMaximize { 1 } else { 0 }
                    next_count = count + 1
                }
                c.collect_alternative_objectives((*list).tail, mids, dirs, next_count)
            }
            None => CollectAlternativeObjectivesResult { checker: self, metric_ids: metric_ids, directions: directions, count: count }
        }
    }

    fn collect_alternative_candidates(self, opt: Option<Box<AlternativeCandidateDefList> >) -> CollectAlternativeCandidatesResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_alternative_candidates((*list).tail)
                var c = pair.checker
                var ids = pair.candidates
                var count = pair.count
                if count < 16 {
                    let seed_known: [i64; 8] = [0; 8]
                    let seed_values: [f64; 8] = [0.0; 8]
                    let metric_pair = c.collect_alternative_candidate_metrics((*list).head.metrics, seed_known, seed_values)
                    c = metric_pair.checker
                    let info = AlternativeCandidateInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        frontier_id: -1,
                        name: (*list).head.name,
                        via_recourse_policy_name: (*list).head.via_name,
                        uses_via: (*list).head.uses_via,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        metric_known: metric_pair.known,
                        metric_values: metric_pair.values,
                        source_kind: -1,
                        deferred_certificate_id: -1,
                        source_policy_id: -1,
                        source_plan_id: -1,
                        strategy_name: empty_name(),
                        route_name: empty_name(),
                        audit_id: -1,
                        contest_id: -1,
                        dominance_rank: -1,
                    }
                    let add_result = c.alternative_candidates.add(info)
                    c.alternative_candidates = add_result.0
                    ids[count as usize] = add_result.1
                    count = count + 1
                }
                CollectAlternativeCandidatesResult { checker: c, candidates: ids, count: count }
            }
            None => CollectAlternativeCandidatesResult { checker: self, candidates: [-1; 16], count: 0 }
        }
    }

    fn collect_alternative_candidate_metrics(
        self,
        opt: Option<Box<AuditFieldEntryList> >,
        known: [i64; 8],
        values: [f64; 8]
    ) -> CollectAlternativeCandidateMetricsResult with Mut, Panic, Div, Alloc, IO {
        var c = self
        var out_known = known
        var out_values = values
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let metric_id = alternative_metric_id_from_name((*list).head.name)
                    if metric_id < 0
                    || metric_id >= 4
                    || out_known[metric_id as usize] == 1
                    || (*list).head.value_kind != AuditValueKind::AuditValueFloat {
                        c = c.report_error_at((*list).head.span, 116, 0, 0, 0)
                    } else {
                        out_known[metric_id as usize] = 1
                        out_values[metric_id as usize] = (*list).head.value_f64
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        CollectAlternativeCandidateMetricsResult { checker: c, known: out_known, values: out_values }
    }

    fn collect_decision_policy_def(self, name: Name, opt: Option<Box<DecisionPolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => {
                let target_pair = self.lower_type_expr((*dd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let __r = c.collect_policy_requirements((*dd).requirements)
                c = __r.checker
                let requirements = __r.requirements
                let requirement_count = __r.count
                let info = DecisionPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.decision_policies.add(info)
                c.decision_policies = add_result.0
                c.env = c.env.bind(name, ty_decision_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_deferral_policy_def(self, name: Name, opt: Option<Box<DeferralPolicyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => {
                let target_pair = self.lower_type_expr((*dd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let __r = c.collect_policy_requirements((*dd).requirements)
                c = __r.checker
                let requirements = __r.requirements
                let requirement_count = __r.count
                let info = DeferralPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    route_name: (*dd).route_name,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.deferral_policies.add(info)
                c.deferral_policies = add_result.0
                c.env = c.env.bind(name, ty_deferral_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_models_def(self, name: Name, opt: Option<Box<ModelsDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => {
                let pair = self.collect_model_family_members((*md).models, empty_model_family_info(), (*md).span)
                var c = pair.0
                var info = pair.1
                info.name = name
                let add_result = c.model_families.add(info)
                c.model_families = add_result.0
                let family_info = c.model_families.get(add_result.1)
                c.env = c.env.bind(name, ty_model_family(family_info.input_ty, family_info.output_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_model_family_members(self, opt: Option<Box<AstPathList> >, seed: ModelFamilyInfo, span: Span) -> (Checker, ModelFamilyInfo) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let model_name = checker_copy_string_list_tail_to_name((*list).head.segments)
                var c = self
                let model_ty = c.env.lookup(model_name)
                var info = seed
                if model_ty.kind != TypeKind::TyModel {
                    c = c.report_model_type_incompatibility(span, model_name, model_ty)
                } else {
                    let input_ty = model_input_ty(model_ty)
                    let output_ty = model_output_ty(model_ty)
                    if info.model_count == 0 {
                        info.input_ty = input_ty
                        info.output_ty = output_ty
                    } else if !types_compatible(info.input_ty, input_ty) || !types_compatible(info.output_ty, output_ty) {
                        c = c.report_model_family_member_mismatch(span, model_name, info.input_ty, info.output_ty, input_ty, output_ty)
                    }
                    if info.model_count < 16 {
                        info.model_names[info.model_count as usize] = model_name
                    }
                    info.model_count = info.model_count + 1
                }
                c.collect_model_family_members((*list).tail, info, span)
            }
            None => (self, seed)
        }
    }

    fn collect_validation_def(self, name: Name, opt: Option<Box<ValidationDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vd) => {
                let target_pair = self.lower_type_expr((*vd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let info = ValidationPolicyInfo { name: name, target_ty: target_ty }
                let add_result = c.validations.add(info)
                c.validations = add_result.0
                c.env = c.env.bind(name, ty_validation(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn lower_audit_target_type(self, te: TypeExpr, span: Span) -> LowerAuditTargetTypeResult with Mut, Panic, Div, Alloc, IO {
        if te.kind != TypeExprKind::TypeContest {
            return LowerAuditTargetTypeResult { checker: self, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
        }
        match te.type_args {
            Some(args) => {
                match (*args).tail {
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => LowerAuditTargetTypeResult { checker: self, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let family_pair = c.lower_type_expr((*rest).head)
                                        c = family_pair.0
                                        let family_ty = family_pair.1
                                        let policy_pair = c.lower_type_expr((*last).head)
                                        c = policy_pair.0
                                        let policy_ty = policy_pair.1
                                        if family_ty.kind != TypeKind::TyModelFamily
                                            || policy_ty.kind != TypeKind::TyPolicy
                                            || family_ty.epistemic_meta_id < 0
                                            || policy_ty.epistemic_meta_id < 0 {
                                            return LowerAuditTargetTypeResult { checker: c, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
                                        }
                                        if !types_compatible(model_output_ty(family_ty), inner_ty)
                                            || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                            c = c.report_error_at(span, 58, 0, 0, 0)
                                            return LowerAuditTargetTypeResult { checker: c, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
                                        }
                                        LowerAuditTargetTypeResult { checker: c, ok: true, ty: inner_ty, family_id: family_ty.epistemic_meta_id, policy_id: policy_ty.epistemic_meta_id }
                                    }
                                }
                            }
                            None => LowerAuditTargetTypeResult { checker: self, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
                        }
                    }
                    None => LowerAuditTargetTypeResult { checker: self, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
                }
            }
            None => LowerAuditTargetTypeResult { checker: self, ok: false, ty: ty_error(), family_id: -1, policy_id: -1 }
        }
    }

    fn collect_audit_def(self, name: Name, opt: Option<Box<AuditDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => {
                let __r = self.lower_audit_target_type((*ad).target_type, (*ad).span)
                var c = __r.checker
                let ok = __r.ok
                let target_inner_ty = __r.ty
                let family_id = __r.family_id
                let policy_id = __r.policy_id
                if !ok {
                    return c.report_audit_definition_requires_full_contest((*ad).span, ty_error())
                }

                var info = empty_audit_info()
                info.name = name
                info.span_start = (*ad).span.start
                info.span_end = (*ad).span.end
                info.target_inner_ty = target_inner_ty
                info.family_id = family_id
                info.policy_id = policy_id

                let sec_pair = c.collect_audit_sections(name, (*ad).sections, info, [0; 4])
                c = sec_pair.checker
                info = sec_pair.info

                let add_result = c.audits.add(info)
                c.audits = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_audit_sections(
        self,
        audit_name: Name,
        opt: Option<Box<AuditSectionList> >,
        seed: AuditInfo,
        section_seen: [i64; 4]
    ) -> CollectAuditSectionsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let section = (*list).head
                var c = self
                var info = seed
                var seen = section_seen
                let section_idx =
                    if section.kind == AuditSectionKind::AuditSectionMetrics { 0 }
                    else if section.kind == AuditSectionKind::AuditSectionMechanistic { 1 }
                    else if section.kind == AuditSectionKind::AuditSectionCounterexample { 2 }
                    else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights { 3 }
                    else { -1 }

                if section_idx < 0 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else if seen[section_idx as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else {
                    seen[section_idx as usize] = 1
                    if section.kind == AuditSectionKind::AuditSectionMetrics {
                        let pair = c.collect_audit_metrics_section(section.name, section.fields, info, [0; 8])
                        c = pair.checker
                        info = pair.info
                    } else if section.kind == AuditSectionKind::AuditSectionMechanistic {
                        let pair = c.collect_audit_mechanistic_section(audit_name, section.name, section.fields)
                        c = pair.checker
                        info.mechanistic_report_id = pair.id
                        if pair.id >= 0 && pair.id < c.mechanistic_reports.count {
                            let report = c.mechanistic_reports.get(pair.id)
                            info.metric_known[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = 1
                            info.metric_values[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = report.aggregate_divergence
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionCounterexample {
                        let pair = c.collect_audit_counterexample_section(audit_name, section.name, section.fields)
                        c = pair.checker
                        info.counterexample_id = pair.id
                        if pair.id >= 0 {
                            info.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
                            info.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights {
                        if info.family_id < 0 || info.family_id >= c.model_families.count {
                            c = c.report_audit_weights_family_mismatch(section.span, audit_name)
                        } else {
                            let family = c.model_families.get(info.family_id)
                            let pair = c.collect_audit_posterior_weights_section(audit_name, section.name, family, section.fields)
                            c = pair.checker
                            info.posterior_weights_id = pair.id
                        }
                    }
                }
                c.collect_audit_sections(audit_name, (*list).tail, info, seen)
            }
            None => CollectAuditSectionsResult { checker: self, info: seed, seen: section_seen }
        }
    }

    fn collect_audit_metrics_section(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList> >,
        seed: AuditInfo,
        seen_fields: [i64; 8]
    ) -> CollectAuditMetricsSectionResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var info = seed
                var seen = seen_fields
                let metric_id = audit_metric_id_from_name(field.name)
                if metric_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[metric_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[metric_id as usize] = 1
                    info.metric_known[metric_id as usize] = 1
                    info.metric_values[metric_id as usize] = field.value_f64
                }
                c.collect_audit_metrics_section(section_name, (*list).tail, info, seen)
            }
            None => CollectAuditMetricsSectionResult { checker: self, info: seed, seen: seen_fields }
        }
    }

    fn collect_audit_mechanistic_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList> >
    ) -> CollectAuditIdResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_mechanistic_fields(section_name, opt, [0; 6], [0.0; 6])
        var c = pair.checker
        let seen = pair.seen
        let values = pair.values
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_mechanistic_incomplete(Span { file_id: 0, start: 0, end: 0 }, audit_name)
                return CollectAuditIdResult { checker: c, id: -1 }
            }
            i = i + 1
        }
        let report = MechanisticReportInfo {
            latent_state_divergence: values[1],
            causal_decomposition_divergence: values[2],
            intervention_response_divergence: values[3],
            parameter_role_divergence: values[4],
            structural_explanation_distance: values[5],
            aggregate_divergence: values[0],
        }
        let add_result = c.mechanistic_reports.add(report)
        c.mechanistic_reports = add_result.0
        CollectAuditIdResult { checker: c, id: add_result.1 }
    }

    fn collect_audit_mechanistic_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList> >,
        seen_fields: [i64; 6],
        values: [f64; 6]
    ) -> CollectAuditMechanisticFieldsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var vals = values
                let field_id = audit_mechanistic_field_id_from_name(field.name)
                if field_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    vals[field_id as usize] = field.value_f64
                }
                c.collect_audit_mechanistic_fields(section_name, (*list).tail, seen, vals)
            }
            None => CollectAuditMechanisticFieldsResult { checker: self, seen: seen_fields, values: values }
        }
    }

    fn collect_audit_counterexample_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList> >
    ) -> CollectAuditIdResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_counterexample_fields(
            section_name,
            opt,
            [0; 6],
            [Name { buf: [0; 128], len: 0 }; 6],
            [0.0; 6]
        )
        var c = pair.checker
        let seen = pair.seen
        let names = pair.names
        let values = pair.values
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_counterexample_incomplete(Span { file_id: 0, start: 0, end: 0 }, audit_name)
                return CollectAuditIdResult { checker: c, id: -1 }
            }
            i = i + 1
        }
        let info = CounterexampleInfo {
            model_name: names[0],
            subgroup_name: names[1],
            metric_name: names[2],
            observed_value: values[3],
            threshold_value: values[4],
            summary: names[5],
        }
        let add_result = c.counterexamples.add(info)
        c.counterexamples = add_result.0
        CollectAuditIdResult { checker: c, id: add_result.1 }
    }

    fn collect_audit_counterexample_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList> >,
        seen_fields: [i64; 6],
        names: [Name; 6],
        values: [f64; 6]
    ) -> CollectAuditCounterexampleFieldsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_names = names
                var next_values = values
                let field_id = audit_counterexample_field_id_from_name(field.name)
                if field_id < 0 || seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if (field_id == 3 || field_id == 4) && field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field_id != 3 && field_id != 4 && field.value_kind != AuditValueKind::AuditValueName {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    if field_id == 3 || field_id == 4 {
                        next_values[field_id as usize] = field.value_f64
                    } else {
                        next_names[field_id as usize] = field.value_name
                    }
                }
                c.collect_audit_counterexample_fields(section_name, (*list).tail, seen, next_names, next_values)
            }
            None => {
                var result = CollectAuditCounterexampleFieldsResult {
                    checker: self,
                    seen: [0; 6],
                    names: [Name { buf: [0 as i8; 128], len: 0 }; 6],
                    values: [0.0; 6],
                }
                var ri: i64 = 0
                while ri < 6 {
                    result.seen[ri as usize] = seen_fields[ri as usize]
                    result.names[ri as usize] = names[ri as usize]
                    result.values[ri as usize] = values[ri as usize]
                    ri = ri + 1
                }
                result
            }
        }
    }

    fn collect_audit_posterior_weights_section(
        self,
        audit_name: Name,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList> >
    ) -> CollectAuditIdResult with Mut, Panic, Div, Alloc, IO {
        if family.model_count > 16 {
            let c = self.report_audit_weights_family_mismatch(Span { file_id: 0, start: 0, end: 0 }, audit_name)
            return CollectAuditIdResult { checker: c, id: -1 }
        }
        let pair = self.collect_audit_posterior_weight_fields(section_name, family, opt, [0; 16], [0.0; 16])
        var c = pair.checker
        let seen = pair.seen
        let weights = pair.weights
        var i: i64 = 0
        var total: f64 = 0.0
        while i < family.model_count && i < 16 {
            if seen[i as usize] != 1 {
                c = c.report_audit_weights_family_mismatch(Span { file_id: 0, start: 0, end: 0 }, audit_name)
                return CollectAuditIdResult { checker: c, id: -1 }
            }
            total = total + weights[i as usize]
            i = i + 1
        }
        if audit_abs_f64(total - 1.0) > 0.000001 {
            c = c.report_audit_weights_not_normalized(Span { file_id: 0, start: 0, end: 0 }, audit_name, total)
            return CollectAuditIdResult { checker: c, id: -1 }
        }
        let info = PosteriorWeightsInfo {
            model_names: family.model_names,
            weights: weights,
            count: family.model_count,
        }
        let add_result = c.posterior_weights.add(info)
        c.posterior_weights = add_result.0
        CollectAuditIdResult { checker: c, id: add_result.1 }
    }

    fn collect_audit_posterior_weight_fields(
        self,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList> >,
        seen_fields: [i64; 16],
        weights: [f64; 16]
    ) -> CollectAuditPosteriorWeightFieldsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_weights = weights
                let model_idx = model_family_model_index(family, field.name)
                if field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field.value_f64 < 0.0 {
                    c = c.report_audit_weights_not_normalized(field.span, section_name, field.value_f64)
                } else if model_idx < 0 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else if seen[model_idx as usize] == 1 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else {
                    seen[model_idx as usize] = 1
                    next_weights[model_idx as usize] = field.value_f64
                }
                c.collect_audit_posterior_weight_fields(section_name, family, (*list).tail, seen, next_weights)
            }
            None => CollectAuditPosteriorWeightFieldsResult { checker: self, seen: seen_fields, weights: weights }
        }
    }

    fn collect_policy_requirements(self, opt: Option<Box<PolicyRequirementList> >) -> CollectPolicyRequirementsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let __r = self.collect_policy_requirement_list(*list)
                CollectPolicyRequirementsResult { checker: __r.checker, requirements: Some(Box::new(__r.list)), count: __r.count }
            }
            None => CollectPolicyRequirementsResult { checker: self, requirements: None, count: 0 }
        }
    }

    fn collect_policy_requirement_list(self, list: PolicyRequirementList) -> CollectPolicyRequirementListResult with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => CollectPolicyRequirementListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let __r = c.collect_policy_requirement_list(*rest)
                c = __r.checker
                let rest_list = __r.list
                let rest_count = __r.count
                CollectPolicyRequirementListResult { checker: c, list: PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, count: 1 + rest_count }
            }
        }
    }

    // --------------------------------------------------------
    // Collect function signature
    // --------------------------------------------------------

    fn collect_fn_def(self, name: Name, opt: Option<Box<FnDef> >, visibility: Visibility, defining_module: AstPath) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let __r = self.collect_fn_params((*fd).params)
                var c = __r.checker
                let params = __r.params
                let param_count = __r.count
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from function signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.checker
                let fn_effects = eff_pair.effects
                let fn_effect_count = eff_pair.count
                let epistemic_min_confidence = epistemic_min_confidence_from_effects((*fd).effects)

                // Kernel function enforcement
                let is_kernel_fn = (*fd).is_kernel
                var kernel_effects = fn_effects
                var kernel_effect_count = fn_effect_count

                if is_kernel_fn {
                    // Auto-inject GPU effect (ID 5) if not already present
                    var has_gpu = false
                    var ei = 0
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if has_gpu == false {
                        if kernel_effect_count < 8 {
                            kernel_effects[kernel_effect_count] = 5
                            kernel_effect_count = kernel_effect_count + 1
                        }
                    }

                    // E070: Reject IO(0), Mut(1), Alloc(2) effects
                    var ri = 0
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }

                    // E253: Kernel must return unit type. A missing return
                    // annotation lowers to TyUnknown (lower_opt_return_type's
                    // None case), which is implicitly unit for a void kernel —
                    // accept it; only an EXPLICIT non-unit return type is an error.
                    if ret_ty.kind != TypeKind::TyUnit && ret_ty.kind != TypeKind::TyUnknown {
                        c = c.report_error_at((*fd).span, 253, 0, 0, 0)
                    }
                }

                // Detect epistemic kernel: any param with Knowledge/Epistemic type
                var has_epistemic_param = false
                if is_kernel_fn {
                    var walk_params = params
                    var walk_i: i64 = 0
                    while walk_i < param_count {
                        match walk_params {
                            Some(plist) => {
                                let pty = (*plist).head.ty
                                if is_epistemic_type(pty) || pty.kind == TypeKind::TyEpistemic || pty.kind == TypeKind::TyAleatoric {
                                    has_epistemic_param = true
                                }
                                walk_params = (*plist).tail
                            }
                            None => { walk_i = param_count }
                        }
                        walk_i = walk_i + 1
                    }
                }

                let sig = FnSig {
                    name: name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: false,
                    self_type_name: Name { buf: [0; 128], len: 0 },
                    self_type_entry: ty_unit(),
                    effects: kernel_effects,
                    effect_count: kernel_effect_count,
                    is_kernel: is_kernel_fn,
                    is_epistemic_kernel: has_epistemic_param,
                    is_extern: (*fd).is_extern,
                    is_linear_closure: false,
                    linear_capture_count: 0,
                    epistemic_epsilon: 0.0 - 1.0,
                    epistemic_min_confidence: epistemic_min_confidence,
                    visibility_kind: visibility.kind,
                    defining_module_seg_count: defining_module.seg_count,
                    defining_module_id: c.current_module_id,
                    visibility: visibility,
                    defining_module: defining_module,
                }
                let sig_id = fn_sig_table_add(c.fn_sigs, sig)
                // N2 (codex ruling 2026-08-23, call-projection fail-closed
                // fix): by-value twin of the registration in
                // checker_collect_fn_def_inplace -- see that site's comment.
                var proj = ns_body_projected_param_index((*fd).body, (*fd).params)
                // Codex ruling: arity-1 only -- see the matching comment in
                // checker_collect_fn_def_inplace.
                if param_count != 1 {
                    proj = (false, 0 - 1)
                }
                ns_proj_table_set(c.ns_proj, sig_id, proj.0, proj.1)
                c.env = c.env.bind(name, ty_fn(sig_id), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_fn_params(self, opt: Option<Box<ParamList> >) -> CollectFnParamsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let __r = self.collect_fn_param_list(*pl)
                CollectFnParamsResult { checker: __r.checker, params: Some(Box::new(__r.list)), count: __r.count }
            }
            None => CollectFnParamsResult { checker: self, params: None, count: 0 }
        }
    }

    fn collect_fn_param_list(self, pl: ParamList) -> CollectFnParamListResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => CollectFnParamListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let __r = c.collect_fn_param_list(*rest)
                c = __r.checker
                let rest_list = __r.list
                let rest_count = __r.count
                CollectFnParamListResult { checker: c, list: FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, count: 1 + rest_count }
            }
        }
    }

    fn lower_opt_return_type(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    // --------------------------------------------------------
    // Collect struct definition
    // --------------------------------------------------------

    fn collect_struct_def(self, name: Name, opt: Option<Box<StructDef> >, visibility: Visibility, defining_module: AstPath) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => {
                // Extract type parameters if present
                let tp_result = collect_type_params((*sd).type_params)
                let tp_count = tp_result.count
                let tp_names = tp_result.names
                let is_generic = tp_count > 0

                let __r = self.collect_field_defs((*sd).fields)
                var c = __r.checker
                let fields = __r.fields
                let field_count = __r.count
                let info = StructInfo {
                    name: name,
                    fields: fields,
                    field_count: field_count,
                    is_linear: (*sd).is_linear,
                    type_param_count: tp_count,
                    type_param_names: tp_names,
                    is_generic_template: is_generic,
                    visibility_kind: visibility.kind,
                    defining_module_id: c.current_module_id,
                    visibility: visibility,
                    defining_module: defining_module,
                }
                struct_table_add(c.structs, info)
                c
            }
            None => self
        }
    }

    fn collect_field_defs(self, opt: Option<Box<FieldDefList> >) -> CollectFieldDefsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fdl) => {
                let __r = self.collect_field_def_list(*fdl)
                CollectFieldDefsResult { checker: __r.checker, fields: Some(Box::new(__r.list)), count: __r.count }
            }
            None => CollectFieldDefsResult { checker: self, fields: None, count: 0 }
        }
    }

    fn collect_field_def_list(self, fdl: FieldDefList) -> CollectFieldDefListResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(fdl.head.ty)
        var c = pair.0
        let field_ty = pair.1
        let head_info = FieldInfo { name: fdl.head.name, ty: field_ty }
        let head_list = FieldInfoList { head: head_info, tail: None }
        match fdl.tail {
            None => CollectFieldDefListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let __r = c.collect_field_def_list(*rest)
                c = __r.checker
                let rest_list = __r.list
                let rest_count = __r.count
                CollectFieldDefListResult { checker: c, list: FieldInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, count: 1 + rest_count }
            }
        }
    }

    // --------------------------------------------------------
    // Collect enum definition
    // --------------------------------------------------------

    fn bind_enum_variant_constructors(self, variants: Option<Box<VariantInfoList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cur = variants
        while true {
            match cur {
                Some(list) => {
                    c.env = c.env.bind((*list).head.name, ty_unknown(), false)
                    c = c.const_int_bind_unknown((*list).head.name)
                    cur = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn collect_enum_def(self, name: Name, opt: Option<Box<EnumDef> >, visibility: Visibility, defining_module: AstPath) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ed) => {
                let pair = self.collect_variants((*ed).variants)
                var c = pair.checker
                let variants = pair.variants
                let variant_count = pair.count
                let info = EnumInfo {
                    name: name,
                    variants: variants,
                    variant_count: variant_count,
                    visibility_kind: visibility.kind,
                    defining_module_id: c.current_module_id,
                    visibility: visibility,
                    defining_module: defining_module,
                }
                enum_table_add(c.enums, info)
                c = c.bind_enum_variant_constructors(variants)
                c
            }
            None => self
        }
    }

    fn collect_variants(self, opt: Option<Box<VariantDefList> >) -> CollectVariantsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vdl) => {
                let pair = self.collect_variant_list(*vdl)
                CollectVariantsResult { checker: pair.checker, variants: Some(Box::new(pair.list)), count: pair.count }
            }
            None => CollectVariantsResult { checker: self, variants: None, count: 0 }
        }
    }

    fn collect_variant_list(self, vdl: VariantDefList) -> CollectVariantListResult with Mut, Panic, Div, Alloc, IO {
        // Collect variant fields (if any) using the same mechanism as struct fields
        let __r = self.collect_field_defs(vdl.head.fields)
        var c = __r.checker
        let v_fields = __r.fields
        let head_info = VariantInfo { name: vdl.head.name, fields: v_fields }
        let head_list = VariantInfoList { head: head_info, tail: None }
        match vdl.tail {
            None => CollectVariantListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let rest_result = c.collect_variant_list(*rest)
                c = rest_result.checker
                let rest_list = rest_result.list
                let rest_count = rest_result.count
                CollectVariantListResult {
                    checker: c,
                    list: VariantInfoList { head: head_info, tail: Some(Box::new(rest_list)) },
                    count: 1 + rest_count,
                }
            }
        }
    }

    // --------------------------------------------------------
    // Collect trait definitions
    // --------------------------------------------------------

    fn collect_trait_def(self, name: Name, opt: Option<Box<TraitItemDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(td) => {
                // Register trait in the trait registry (sequential ID from count)
                var c = self
                let trait_id = c.trait_registry.count + 100  // offset past builtins
                var tdef = trait_def_new(trait_id)
                // Collect method signatures from the trait body
                c = c.collect_trait_methods((*td).methods, trait_id)
                c.trait_registry = trait_register(c.trait_registry, tdef)
                c
            }
            None => self
        }
    }

    fn collect_trait_methods(self, methods: Option<Box<ItemList> >, trait_id: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match methods {
            None => self
            Some(list) => {
                var c = self
                let item = (*list).head
                if item.kind == ItemKind::ItemFn {
                    // collect_fn_def takes visibility and the defining module too;
                    // this call passed two of four. The sibling call site
                    // (check.sio:16372) is the shape: item.visibility and the
                    // module currently being collected. A trait method is
                    // declared in the module its trait is.
                    c = c.collect_fn_def(item.name, item.fn_def, item.visibility, c.current_module)
                }
                c.collect_trait_methods((*list).tail, trait_id)
            }
        }
    }

    // --------------------------------------------------------
    // Collect algebra declaration
    // --------------------------------------------------------

    fn collect_algebra_def(self, opt: Option<Box<AlgebraDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(adef) => {
                var c = self
                let idx = c.algebras.count
                if idx >= 16 { return c }  // table full

                var info = empty_algebra_info()
                info.name = (*adef).name
                info.is_valid = true

                // Derive algebra_tag from name for backward compat
                // "Octonion" = 8 chars, O=79
                // "Sedenion" = 8 chars, S=83
                // "Quaternion" = 10 chars, Q=81
                if info.name.len == 8 && info.name.buf[0] == 79 as i8 {
                    info.algebra_tag = 3  // Octonion
                } else if info.name.len == 8 && info.name.buf[0] == 83 as i8 {
                    info.algebra_tag = 4  // Sedenion
                } else if info.name.len == 10 && info.name.buf[0] == 81 as i8 {
                    info.algebra_tag = 2  // Quaternion
                }

                // Reassociation strategy: the Axis-1 (order) certificate at the declaration.
                //
                // A `reassociate:` clause is a CLAIM about which product re-orderings the compiler
                // may perform. The claim is licensed only when the declared multiplication law
                // backs it (formal/lean4/EpistemicEffectsNSA.lean, `assocCert`): `free` needs an
                // associative product; `fano_selective` needs the octonion level (a non-Fano
                // triple there already changes the value by the associator, W1); from the
                // sedenions up nothing is certified, so the product must be `blocked`. A
                // declaration that claims more is an order-fabrication licence -- E252.
                //
                // An OMITTED clause (parser value -1) is not a claim: derive the most permissive
                // strategy the laws certify (associative -> free; alternative at the octonion
                // level -> fano_selective; otherwise blocked). Before this, an omitted clause
                // silently meant `free` -- an alternative algebra got free reassociation.
                let mul_assoc = checker_algebra_def_mul_assoc((*adef).ops)
                let mul_alt = checker_algebra_def_mul_alt((*adef).ops)
                let declared = (*adef).reassoc_strategy
                var strategy = declared
                if declared < 0 {
                    if mul_assoc { strategy = 0 }
                    else if mul_alt && info.algebra_tag == 3 { strategy = 2 }
                    else { strategy = 1 }
                } else if declared == 0 && !mul_assoc {
                    c = c.report_error_at((*adef).span, 252, 0, 0, 0)
                    strategy = 1
                } else if declared == 2 && info.algebra_tag >= 4 {
                    c = c.report_error_at((*adef).span, 252, 0, 0, 0)
                    strategy = 1
                }
                info.reassoc_strategy = strategy

                // Store the entry FIRST, then walk the op declarations INTO the stored entry.
                // (Until 2026-09-01 the order was reversed: collect_algebra_ops wrote the
                // declared laws into entries[idx] and the very next line overwrote them with
                // `info`'s defaults -- mul_associative = true -- so the registry never saw
                // `alternative`, and check_hyper_binary's NonAssoc requirement for a declared
                // alternative algebra could never fire. Measured by reading, fixed by ordering.)
                c.algebras.entries[idx] = info
                c.algebras.count = idx + 1
                c = c.collect_algebra_ops((*adef).ops, idx)
                c
            }
        }
    }

    // Read the multiplication laws straight from the declaration's op list:
    // (is_associative, is_alternative). Defaults when no `mul:` line is declared mirror
    // `empty_algebra_info` (associative, not alternative).

    fn collect_algebra_ops(self, ops: Option<Box<AlgebraOpDeclList> >, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match ops {
            None => self
            Some(list) => {
                var c = self
                let op = (*list).head
                // Check op name: "add" (3 chars, a=97,d=100,d=100) or "mul" (3, m=109)
                if op.op_name.len == 3 && op.op_name.buf[0] == 97 as i8 {
                    // add
                    c.algebras.entries[idx].add_commutative = op.is_commutative
                    c.algebras.entries[idx].add_associative = op.is_associative
                } else if op.op_name.len == 3 && op.op_name.buf[0] == 109 as i8 {
                    // mul
                    c.algebras.entries[idx].mul_commutative = op.is_commutative
                    c.algebras.entries[idx].mul_associative = op.is_associative
                    c.algebras.entries[idx].mul_alternative = op.is_alternative
                }
                c.collect_algebra_ops((*list).tail, idx)
            }
        }
    }

    // --------------------------------------------------------
    // Collect study declaration
    // --------------------------------------------------------

    fn collect_study_def(self, span: Span, opt: Option<Box<StudyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(sdef) => {
                var c = self
                let idx = c.studies.count
                if idx >= 16 {
                    c = c.report_error_at(span, 154, 0, 0, 0)
                    return c
                }

                var info = empty_study_info()
                info.name = (*sdef).name
                info.title = (*sdef).title
                info.registration = (*sdef).registration
                info.design = (*sdef).design
                info.sample_size = (*sdef).sample_size
                info.power = (*sdef).power
                info.alpha = (*sdef).alpha
                info.correction = (*sdef).correction
                var hi: i64 = 0
                while hi < 8 {
                    info.hypotheses[hi as usize] = (*sdef).hypotheses[hi as usize]
                    hi = hi + 1
                }
                info.hypothesis_count = (*sdef).n_hypotheses
                var oi: i64 = 0
                while oi < 16 {
                    info.outcomes[oi as usize] = (*sdef).outcomes[oi as usize]
                    oi = oi + 1
                }
                info.outcome_count = (*sdef).n_outcomes
                info.is_valid = (*sdef).n_hypotheses > 0 as i32

                if !info.is_valid {
                    c = c.report_error_at(span, 155, 0, 0, 0)
                }

                c.studies.entries[idx as usize] = info
                c.studies.count = idx + 1
                c
            }
        }
    }

    // --------------------------------------------------------
    // Collect ontology definitions
    // --------------------------------------------------------

    fn ontology_inference_collect_kernel(self, classes: Option<Box<OntologyClassDeclList> >, disjoints: Option<Box<OntologyDisjointDeclList> >, roles: Option<Box<OntologyRoleDeclList> >, ont_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.collect_ontology_kernel_classes(classes, ont_name)
        c = c.collect_ontology_kernel_property_axioms_from_legacy(ont_name)
        c = c.collect_ontology_kernel_disjoints(disjoints)
        c = c.collect_ontology_roles(roles)
        c.ontology_kernel = ontology_kernel_materialize(c.ontology_kernel)
        c.ontology_kernel.profile = ontology_kernel_check_profile(c.ontology_kernel)
        c
    }

    fn ontology_validation_apply_decl_constraints(self) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.validate_ontology_kernel_inverse_consistency()
        c = c.validate_ontology_kernel_strengthening()
        c
    }

    fn ontology_boundary_bind_named_types(self) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var i: i64 = 0
        while i < c.ontologies.count {
            if c.ontologies.entries[i as usize].is_valid {
                let cls_name = c.ontologies.entries[i as usize].name
                let ty = ty_with_ontology(ty_named(cls_name), i)
                c.env = c.env.bind(cls_name, ty, false)
            }
            i = i + 1
        }
        c
    }

    fn collect_ontology_def(self, opt: Option<Box<OntologyDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(odef) => {
                var c = self
                let ont_name = (*odef).name
                // Walk class declarations and register each class
                c = c.collect_ontology_classes((*odef).classes, ont_name)
                // Walk disjoint declarations
                c = c.collect_ontology_disjoints((*odef).disjoints)
                // Compute transitive closure of superclass relationships
                c.ontologies = ontology_table_compute_closure(c.ontologies)
                // S2 semantic contract split: keep behavior the same while naming
                // the kernel, validation, and compiler-boundary layers explicitly.
                c = c.ontology_inference_collect_kernel((*odef).classes, (*odef).disjoints, (*odef).roles, ont_name)
                c = c.ontology_validation_apply_decl_constraints()
                c = c.ontology_boundary_bind_named_types()
                c
            }
        }
    }

    fn collect_ontology_classes(self, classes: Option<Box<OntologyClassDeclList> >, ont_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match classes {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let idx = c.ontologies.count
                if idx >= 64 {
                    c = c.report_error_at(decl.span, 153, 0, 0, 0)
                    return c
                }

                var info = empty_ontology_class_info()
                info.name = decl.name
                info.ontology_name = ont_name
                info.class_index = idx
                info.is_valid = true

                // Resolve superclass names to indices
                var i: i64 = 0
                while i < decl.superclass_count && i < 8 {
                    let sc_name = decl.superclass_names[i as usize]
                    let sc_idx = ontology_table_find(c.ontologies, sc_name)
                    if sc_idx >= 0 {
                        info.superclass_indices[info.superclass_count as usize] = sc_idx
                        info.superclass_count = info.superclass_count + 1
                    }
                    i = i + 1
                }

                // Register properties as refinements
                i = 0
                while i < decl.property_count && i < 8 {
                    let prop = decl.properties[i as usize]
                    info.property_names[info.property_count as usize] = prop.name
                    if prop.pred_op > 0 {
                        // Build a RefinementPred from the property declaration
                        let pred = RefinementPred {
                            op: prop.pred_op,
                            var_name: prop.name,
                            rhs_int: prop.pred_rhs_int,
                            rhs_float: prop.pred_rhs_float,
                            is_float: prop.is_float,
                            left: None,
                            right: None,
                        }
                        let base_ty = if prop.is_float { ty_f64() } else { ty_i64() }
                        let rt = RefinementType {
                            base_type: base_ty,
                            var_name: prop.name,
                            predicate: pred,
                        }
                        // Synthesize a unique name for this property refinement
                        let synth_name = make_refinement_synth_name(c.refinements.count)
                        c.refinements = refinement_table_add(c.refinements, synth_name, rt)
                        info.property_ref_ids[info.property_count as usize] = c.refinements.count - 1
                    }
                    info.property_count = info.property_count + 1
                    i = i + 1
                }

                c.ontologies.entries[idx as usize] = info
                c.ontologies.count = idx + 1
                c.collect_ontology_classes((*list).tail, ont_name)
            }
        }
    }

    fn collect_ontology_disjoints(self, disjoints: Option<Box<OntologyDisjointDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match disjoints {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let a_idx = ontology_table_find(c.ontologies, decl.name_a)
                let b_idx = ontology_table_find(c.ontologies, decl.name_b)
                if a_idx >= 0 && b_idx >= 0 {
                    // Add disjoint in both directions
                    let a_dc = c.ontologies.entries[a_idx as usize].disjoint_count
                    if a_dc < 8 {
                        c.ontologies.entries[a_idx as usize].disjoint_indices[a_dc as usize] = b_idx
                        c.ontologies.entries[a_idx as usize].disjoint_count = a_dc + 1
                    }
                    let b_dc = c.ontologies.entries[b_idx as usize].disjoint_count
                    if b_dc < 8 {
                        c.ontologies.entries[b_idx as usize].disjoint_indices[b_dc as usize] = a_idx
                        c.ontologies.entries[b_idx as usize].disjoint_count = b_dc + 1
                    }
                }
                c.collect_ontology_disjoints((*list).tail)
            }
        }
    }

    fn collect_ontology_kernel_add_axiom(self, span: Span, axiom: OntologyAxiom) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        if ontology_kernel_can_add_axiom(c.ontology_kernel) {
            c.ontology_kernel = ontology_kernel_add_axiom(c.ontology_kernel, axiom)
        } else {
            c = c.report_error_at(span, 160, 0, 0, 0)
        }
        c
    }

    fn collect_ontology_kernel_classes(self, classes: Option<Box<OntologyClassDeclList> >, ont_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match classes {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                if ontology_kernel_can_add_class(c.ontology_kernel) {
                    let pair = ontology_kernel_add_class(c.ontology_kernel, decl.name, ont_name)
                    c.ontology_kernel = pair.0
                    let class_idx = pair.1
                    if class_idx >= 0 {
                        var i: i64 = 0
                        while i < decl.superclass_count && i < 8 {
                            let sc_name = decl.superclass_names[i as usize]
                            let sc_idx = ontology_kernel_find_class(c.ontology_kernel, sc_name)
                            if sc_idx >= 0 {
                                c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                    axiom_type: owl_subclass_of(),
                                    subject_idx: class_idx,
                                    object_idx: sc_idx,
                                    refinement_ref_id: -1,
                                    property_name: empty_name(),
                                    is_property_axiom: false,
                                })
                            }
                            i = i + 1
                        }
                    }
                }
                c.collect_ontology_kernel_classes((*list).tail, ont_name)
            }
        }
    }

    fn collect_ontology_kernel_property_axioms_from_legacy(self, ont_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var i: i64 = 0
        while i < c.ontologies.count {
            let cls = c.ontologies.entries[i as usize]
            if cls.is_valid && name_eq(cls.ontology_name, ont_name) {
                var j: i64 = 0
                while j < cls.property_count {
                    let ref_id = cls.property_ref_ids[j as usize]
                    if ref_id >= 0 && ref_id < 128 {
                        c = c.collect_ontology_kernel_add_axiom(Span { file_id: 0, start: 0, end: 0 }, OntologyAxiom {
                            axiom_type: owl_data_property_constraint(),
                            subject_idx: i,
                            object_idx: -1,
                            refinement_ref_id: ref_id,
                            property_name: cls.property_names[j as usize],
                            is_property_axiom: false,
                        })
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        c
    }

    fn collect_ontology_kernel_disjoints(self, disjoints: Option<Box<OntologyDisjointDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match disjoints {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let a_idx = ontology_kernel_find_class(c.ontology_kernel, decl.name_a)
                let b_idx = ontology_kernel_find_class(c.ontology_kernel, decl.name_b)
                if a_idx >= 0 && b_idx >= 0 {
                    c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                        axiom_type: owl_disjoint_classes(),
                        subject_idx: a_idx,
                        object_idx: b_idx,
                        refinement_ref_id: -1,
                        property_name: empty_name(),
                        is_property_axiom: false,
                    })
                }
                c.collect_ontology_kernel_disjoints((*list).tail)
            }
        }
    }

    fn ontology_role_decl_count(self, roles: Option<Box<OntologyRoleDeclList> >, target: Name) -> i64 with Mut, Panic, Div, Alloc, IO {
        match roles {
            None => 0
            Some(list) => {
                let count_here = if name_eq((*list).head.name, target) { 1 } else { 0 }
                count_here + self.ontology_role_decl_count((*list).tail, target)
            }
        }
    }

    fn collect_ontology_roles(self, roles: Option<Box<OntologyRoleDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match roles {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let duplicate_in_tail = c.ontology_role_decl_count((*list).tail, decl.name) > 0
                let already_registered = ontology_kernel_find_property(c.ontology_kernel, decl.name) >= 0

                if !already_registered && ontology_kernel_can_add_property(c.ontology_kernel) {
                    let pair = ontology_kernel_add_property(c.ontology_kernel, decl.name)
                    c.ontology_kernel = pair.0
                }

                if already_registered || decl.duplicate_modifier_bits != 0 {
                    c = c.report_error_at(decl.span, 159, 0, 0, 0)
                }

                c = c.collect_ontology_roles((*list).tail)

                if already_registered || duplicate_in_tail || decl.duplicate_modifier_bits != 0 {
                    return c
                }

                let prop_idx = ontology_kernel_find_property(c.ontology_kernel, decl.name)
                if prop_idx >= 0 {
                    if decl.has_domain {
                        let domain_idx = ontology_kernel_find_class(c.ontology_kernel, decl.domain_name)
                        if domain_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_object_property_domain(),
                                subject_idx: prop_idx,
                                object_idx: domain_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 156, 0, 0, 0)
                        }
                    }

                    if decl.has_range {
                        let range_idx = ontology_kernel_find_class(c.ontology_kernel, decl.range_name)
                        if range_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_object_property_range(),
                                subject_idx: prop_idx,
                                object_idx: range_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 157, 0, 0, 0)
                        }
                    }

                    if decl.has_inverse {
                        let inverse_idx = ontology_kernel_find_property(c.ontology_kernel, decl.inverse_name)
                        if inverse_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_inverse_object_properties(),
                                subject_idx: prop_idx,
                                object_idx: inverse_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 158, 0, 0, 0)
                        }
                    }

                    if decl.is_transitive {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_transitive_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                    if decl.is_symmetric {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_symmetric_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                    if decl.is_functional {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_functional_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                }

                c
            }
        }
    }

    fn collect_ontology_role_registry(self, roles: Option<Box<OntologyRoleDeclList> >, all_roles: Option<Box<OntologyRoleDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match roles {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                if ontology_kernel_find_property(c.ontology_kernel, decl.name) >= 0 {
                    c = c.report_error_at(decl.span, 159, 0, 0, 0)
                    return c.collect_ontology_role_registry((*list).tail, all_roles)
                }
                if ontology_kernel_can_add_property(c.ontology_kernel) {
                    let pair = ontology_kernel_add_property(c.ontology_kernel, decl.name)
                    c.ontology_kernel = pair.0
                }
                if decl.duplicate_modifier_bits != 0 || c.ontology_role_decl_count(all_roles, decl.name) > 1 {
                    c = c.report_error_at(decl.span, 159, 0, 0, 0)
                }
                c.collect_ontology_role_registry((*list).tail, all_roles)
            }
        }
    }

    fn collect_ontology_role_axioms(self, roles: Option<Box<OntologyRoleDeclList> >, all_roles: Option<Box<OntologyRoleDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match roles {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                if decl.duplicate_modifier_bits != 0 || c.ontology_role_decl_count(all_roles, decl.name) > 1 {
                    return c.collect_ontology_role_axioms((*list).tail, all_roles)
                }

                let prop_idx = ontology_kernel_find_property(c.ontology_kernel, decl.name)
                if prop_idx >= 0 {
                    if decl.has_domain {
                        let domain_idx = ontology_kernel_find_class(c.ontology_kernel, decl.domain_name)
                        if domain_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_object_property_domain(),
                                subject_idx: prop_idx,
                                object_idx: domain_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 156, 0, 0, 0)
                        }
                    }

                    if decl.has_range {
                        let range_idx = ontology_kernel_find_class(c.ontology_kernel, decl.range_name)
                        if range_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_object_property_range(),
                                subject_idx: prop_idx,
                                object_idx: range_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 157, 0, 0, 0)
                        }
                    }

                    if decl.has_inverse {
                        let inverse_idx = ontology_kernel_find_property(c.ontology_kernel, decl.inverse_name)
                        if inverse_idx >= 0 {
                            c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                                axiom_type: owl_inverse_object_properties(),
                                subject_idx: prop_idx,
                                object_idx: inverse_idx,
                                refinement_ref_id: -1,
                                property_name: empty_name(),
                                is_property_axiom: true,
                            })
                        } else {
                            c = c.report_error_at(decl.span, 158, 0, 0, 0)
                        }
                    }

                    if decl.is_transitive {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_transitive_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                    if decl.is_symmetric {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_symmetric_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                    if decl.is_functional {
                        c = c.collect_ontology_kernel_add_axiom(decl.span, OntologyAxiom {
                            axiom_type: owl_functional_property(),
                            subject_idx: prop_idx,
                            object_idx: -1,
                            refinement_ref_id: -1,
                            property_name: empty_name(),
                            is_property_axiom: true,
                        })
                    }
                }

                c.collect_ontology_role_axioms((*list).tail, all_roles)
            }
        }
    }

    fn ontology_inference_query_subclass(self, provided_ty_id: i64, expected_ty_id: i64) -> bool with Mut, Panic, Div, Alloc, IO {
        ontology_kernel_is_subclass(self.ontology_kernel, provided_ty_id, expected_ty_id)
    }

    fn ontology_inference_query_disjoint(self, provided_ty_id: i64, expected_ty_id: i64) -> bool with Mut, Panic, Div, Alloc, IO {
        ontology_kernel_is_disjoint(self.ontology_kernel, provided_ty_id, expected_ty_id)
    }

    fn validate_ontology_kernel_inverse_consistency(self) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var i: i64 = 0
        while i < c.ontology_kernel.properties.count {
            let prop_info = c.ontology_kernel.properties.entries[i as usize]
            let inverse_idx = prop_info.inverse_property_idx
            if inverse_idx >= 0 && inverse_idx < c.ontology_kernel.properties.count {
                let inverse_info = c.ontology_kernel.properties.entries[inverse_idx as usize]
                if inverse_info.inverse_property_idx != i {
                    c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 159, 0, 0, 0)
                }
                if prop_info.domain_class_idx >= 0 && inverse_info.range_class_idx >= 0 && prop_info.domain_class_idx != inverse_info.range_class_idx {
                    c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 159, 0, 0, 0)
                }
                if prop_info.range_class_idx >= 0 && inverse_info.domain_class_idx >= 0 && prop_info.range_class_idx != inverse_info.domain_class_idx {
                    c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 159, 0, 0, 0)
                }
            }
            i = i + 1
        }
        c
    }

    fn validate_ontology_kernel_role_constraints(self, roles: Option<Box<OntologyRoleDeclList> >, all_roles: Option<Box<OntologyRoleDeclList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match roles {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                if decl.duplicate_modifier_bits != 0 || c.ontology_role_decl_count(all_roles, decl.name) > 1 {
                    return c.validate_ontology_kernel_role_constraints((*list).tail, all_roles)
                }

                if decl.has_inverse {
                    let prop_idx = ontology_kernel_find_property(c.ontology_kernel, decl.name)
                    let inverse_idx = ontology_kernel_find_property(c.ontology_kernel, decl.inverse_name)
                    if prop_idx >= 0 && inverse_idx >= 0 {
                        let prop_info = c.ontology_kernel.properties.entries[prop_idx as usize]
                        let inverse_info = c.ontology_kernel.properties.entries[inverse_idx as usize]
                        if prop_info.inverse_property_idx != inverse_idx || inverse_info.inverse_property_idx != prop_idx {
                            c = c.report_error_at(decl.span, 159, 0, 0, 0)
                        }
                        if prop_info.domain_class_idx >= 0 && inverse_info.range_class_idx >= 0 && prop_info.domain_class_idx != inverse_info.range_class_idx {
                            c = c.report_error_at(decl.span, 159, 0, 0, 0)
                        }
                        if prop_info.range_class_idx >= 0 && inverse_info.domain_class_idx >= 0 && prop_info.range_class_idx != inverse_info.domain_class_idx {
                            c = c.report_error_at(decl.span, 159, 0, 0, 0)
                        }
                    }
                }

                c.validate_ontology_kernel_role_constraints((*list).tail, all_roles)
            }
        }
    }

    fn validate_ontology_kernel_strengthening(self) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var child_idx: i64 = 0
        while child_idx < c.ontology_kernel.classes.count {
            let child_property_count = c.ontology_kernel.materialized.class_property_counts[child_idx as usize]
            if child_property_count > 0 {
                var ancestor_idx: i64 = 0
                while ancestor_idx < c.ontology_kernel.classes.count {
                    if child_idx != ancestor_idx && ontology_kernel_is_subclass(c.ontology_kernel, child_idx, ancestor_idx) {
                        let ancestor_property_count = c.ontology_kernel.materialized.class_property_counts[ancestor_idx as usize]
                        var ci: i64 = 0
                        while ci < child_property_count {
                            let child_axiom_idx = c.ontology_kernel.materialized.class_property_axioms[(child_idx * 8 + ci) as usize]
                            if child_axiom_idx >= 0 && child_axiom_idx < c.ontology_kernel.axioms.count {
                                let child_axiom = c.ontology_kernel.axioms.axioms[child_axiom_idx as usize]
                                var pi: i64 = 0
                                while pi < ancestor_property_count {
                                    let ancestor_axiom_idx = c.ontology_kernel.materialized.class_property_axioms[(ancestor_idx * 8 + pi) as usize]
                                    if ancestor_axiom_idx >= 0 && ancestor_axiom_idx < c.ontology_kernel.axioms.count {
                                        let ancestor_axiom = c.ontology_kernel.axioms.axioms[ancestor_axiom_idx as usize]
                                        if name_eq(child_axiom.property_name, ancestor_axiom.property_name) {
                                            let child_ref_id = child_axiom.refinement_ref_id
                                            let ancestor_ref_id = ancestor_axiom.refinement_ref_id
                                            if child_ref_id >= 0 && child_ref_id < 128 && ancestor_ref_id >= 0 && ancestor_ref_id < 128 {
                                                let child_pred = c.refinements.entries[child_ref_id as usize].predicate
                                                let ancestor_pred = c.refinements.entries[ancestor_ref_id as usize].predicate
                                                if !pred_implies(child_pred, ancestor_pred) {
                                                    c = c.report_warning_at(Span { file_id: 0, start: 0, end: 0 }, 41, 0, 0, 0)
                                                }
                                            }
                                        }
                                    }
                                    pi = pi + 1
                                }
                            }
                            ci = ci + 1
                        }
                    }
                    ancestor_idx = ancestor_idx + 1
                }
            }
            child_idx = child_idx + 1
        }
        c
    }

    // --------------------------------------------------------
    // Collect impl methods
    // --------------------------------------------------------

    fn collect_impl_def(self, opt: Option<Box<ImplDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.collect_impl_methods((*id).methods, impl_ty.name)
                c
            }
            None => self
        }
    }

    fn collect_impl_methods(self, opt: Option<Box<ItemList> >, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.collect_impl_method((*list).head, type_name)
                c.collect_impl_methods((*list).tail, type_name)
            }
            None => self
        }
    }

    fn collect_impl_method(self, item: Item, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                let result = self.collect_method_params((*fd).params)
                var c = result.checker
                let params = result.params
                let param_count = result.count
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from method signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.checker
                let fn_effects = eff_pair.effects
                let fn_effect_count = eff_pair.count
                let epistemic_min_confidence = epistemic_min_confidence_from_effects((*fd).effects)

                let sig = FnSig {
                    name: item.name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: true,
                    self_type_name: type_name,
                    self_type_entry: c.current_impl_type,
                    effects: fn_effects,
                    effect_count: fn_effect_count,
                    is_kernel: false,
                    is_epistemic_kernel: false,
                    is_extern: false,
                    is_linear_closure: false,
                    linear_capture_count: 0,
                    epistemic_epsilon: 0.0 - 1.0,
                    epistemic_min_confidence: epistemic_min_confidence,
                    visibility_kind: item.visibility.kind,
                    defining_module_seg_count: c.current_module.seg_count,
                    defining_module_id: c.current_module_id,
                    visibility: item.visibility,
                    defining_module: c.current_module,
                }
                let _added = fn_sig_table_add(c.fn_sigs, sig)
                c
            }
            None => self
        }
    }

    fn collect_method_params(self, opt: Option<Box<ParamList> >) -> CollectMethodParamsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                // Skip self param for method signatures
                if (*pl).head.is_self {
                    let inner = self.collect_fn_params((*pl).tail)
                    CollectMethodParamsResult { checker: inner.checker, params: inner.params, count: inner.count }
                } else {
                    let pair = self.collect_fn_param_list(*pl)
                    CollectMethodParamsResult { checker: pair.checker, params: Some(Box::new(pair.list)), count: pair.count }
                }
            }
            None => CollectMethodParamsResult { checker: self, params: None, count: 0 }
        }
    }
}

// ============================================================
// Pass 2: Check all items
// ============================================================

impl Checker {
    fn check_items(self, items: Option<Box<ItemList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cursor = items
        while true {
            match cursor {
                Some(list) => {
                    c = c.check_item((*list).head)
                    cursor = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn check_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemKind::ItemFn => self.check_fn_item(item.fn_def)
            ItemKind::ItemStruct => self
            ItemKind::ItemEnum => self
            ItemKind::ItemImpl => self.check_impl_item(item.impl_def)
            ItemKind::ItemTypeAlias => self
            ItemKind::ItemModels => self
            ItemKind::ItemPolicy => self
            ItemKind::ItemAcquisitionPolicy => self
            ItemKind::ItemRecoursePolicy => self
            ItemKind::ItemTransitionPolicy => self
            ItemKind::ItemTransitionProtocol => self
            ItemKind::ItemMonitoringPolicy => self
            ItemKind::ItemAlternativePolicy => self
            ItemKind::ItemAlternativeFrontier => self
            ItemKind::ItemDecisionPolicy => self
            ItemKind::ItemDeferralPolicy => self
            ItemKind::ItemValidation => self
            ItemKind::ItemAudit => self
            ItemKind::ItemUse => self
            ItemKind::ItemUnit => self  // Already handled in collect pass
            ItemKind::ItemEffect => self  // Already handled in collect pass
            ItemKind::ItemSession => self  // Session protocol declaration — type-checking is structural
            ItemKind::ItemTrait => self  // Trait methods already collected in pass 1
            ItemKind::ItemAlgebra => self  // Already handled in collect pass
            ItemKind::ItemStudy => self  // Already handled in collect pass
            ItemKind::ItemOntology => self  // Already handled in collect pass
            // Claim metadata never reaches check: the parse driver drops
            // ItemKind::ItemClaim from the item stream (parser/mod.sio:41).
            // The arm exists so the match is exhaustive — without it the build
            // prints `error: match must be exhaustive` and still exits 0.
            ItemKind::ItemClaim => self
            // Same for a causal graph: the parse driver drops it, and the graph
            // itself is already in the CG_* registry by the time we get here.
            ItemKind::ItemCausalGraph => self
        }
    }

    // --------------------------------------------------------
    // Check function definition
    // --------------------------------------------------------

    fn check_fn_item(self, opt: Option<Box<FnDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var c = self
                // The in-place checker records this at its two fn entry points;
                // the value path never did, so every diagnostic reported through
                // `report_error_at` would have named its caller `<unnamed>`.
                c.current_fn_name = (*fd).name
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let saved_multitest_count = c.multitest_count
                let saved_multitest_corrected = c.multitest_corrected
                let sig_id = fn_sig_table_find(c.fn_sigs, (*fd).name)
                if sig_id >= 0 {
                    let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                    c.current_sig_id = sig_id
                    c.current_sig_name = sig.name
                }
                c.multitest_count = 0
                c.multitest_corrected = false
                if (*fd).is_extern {
                    c.current_return_type = ty_unit()
                    c.current_sig_id = 0 - 1
                    c.current_effects = saved_effects
                    c.current_effect_count = saved_effect_count
                    c.multitest_count = saved_multitest_count
                    c.multitest_corrected = saved_multitest_corrected
                    return c
                }
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                // Check return type compatibility (allow integer-literal narrowing and
                // fieldless-enum↔int coercion, matching let/var assignment).
                if sig_id >= 0 {
                    let sig2 = fn_sig_table_get(c.fn_sigs, sig_id)
                    let int_lit_narrow = c.last_literal_kind == 1
                        && body_ty.kind == TypeKind::TyI64
                        && is_integer_type(sig2.return_type)
                    let body_enum = body_ty.kind == TypeKind::TyNamed && enum_table_find(c.enums, body_ty.name) >= 0
                    let ret_enum = sig2.return_type.kind == TypeKind::TyNamed && enum_table_find(c.enums, sig2.return_type.name) >= 0
                    let enum_int_ok = (body_enum && is_numeric_type(sig2.return_type))
                        || (is_numeric_type(body_ty) && ret_enum)
                    if !c.types_compatible_structural(body_ty, sig2.return_type)
                        && !int_lit_narrow && !enum_int_ok {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                if c.multitest_count > 1 && !c.multitest_corrected {
                    c = c.report_multitest_correction_required((*fd).span, c.multitest_count)
                }
                c = c.require_current_linear_scope_consumed()
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_sig_id = 0 - 1
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c.multitest_count = saved_multitest_count
                c.multitest_corrected = saved_multitest_corrected
                c
            }
            None => self
        }
    }

    fn bind_fn_params(self, opt: Option<Box<ParamList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_fn_param((*pl).head)
                c.bind_fn_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_fn_param(self, p: Param) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        if p.is_self {
            c.env = c.env.bind(p.name, c.current_impl_type, p.is_self_mut)
            c = c.const_int_bind_unknown(p.name)
            // Track self parameter for borrow checking
            let self_linear = c.is_linear_type(c.current_impl_type)
            c.borrows = c.borrows.track(p.name, self_linear)
            c
        } else {
            let pair = c.lower_type_expr(p.ty)
            c = pair.0
            let param_ty = pair.1
            c.env = c.env.bind(p.name, param_ty, false)
            c = c.const_int_bind_unknown(p.name)
            // Track parameter for borrow checking (linear if struct is declared linear)
            let lin = c.is_linear_type(param_ty)
            c.borrows = c.borrows.track(p.name, lin)
            c
        }
    }

    // --------------------------------------------------------
    // Check impl definition
    // --------------------------------------------------------

    fn check_impl_item(self, opt: Option<Box<ImplDef> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.check_impl_methods((*id).methods)
                c.current_impl_type = ty_error()
                c
            }
            None => self
        }
    }

    fn check_impl_methods(self, opt: Option<Box<ItemList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.check_impl_method((*list).head)
                c.check_impl_methods((*list).tail)
            }
            None => self
        }
    }

    fn check_impl_method(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let saved_multitest_count = c.multitest_count
                let saved_multitest_corrected = c.multitest_corrected
                let sig_id = fn_sig_table_find_method(c.fn_sigs, c.current_impl_type.name, (*fd).name)
                if sig_id >= 0 {
                    let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                    c.current_sig_id = sig_id
                    c.current_sig_name = sig.name
                }
                c.multitest_count = 0
                c.multitest_corrected = false
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                if sig_id >= 0 {
                    let sig2 = fn_sig_table_get(c.fn_sigs, sig_id)
                    if !c.types_compatible_structural(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                if c.multitest_count > 1 && !c.multitest_corrected {
                    c = c.report_multitest_correction_required((*fd).span, c.multitest_count)
                }
                c = c.require_current_linear_scope_consumed()
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_sig_id = 0 - 1
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c.multitest_count = saved_multitest_count
                c.multitest_corrected = saved_multitest_corrected
                c
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement checking
// ============================================================

impl Checker {
    // The caller must invoke this before popping the scope whose bindings it owns.
    fn require_current_linear_scope_consumed(self) -> Checker with Mut, Panic, Div, IO {
        var c = self
        let linear_check = c.borrows.check_linear_consumed()
        c.borrows = linear_check.0
        if linear_check.1 > 0 {
            c.had_error = true
            c.error_count = c.error_count + 1
            c.diag_emitted = true
            print("error[E040]: linear value not consumed (")
            print_int(linear_check.1)
            print(" unconsumed)\n")
        }
        c
    }

    fn check_block(self, blk: Block) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        let pair = c.check_stmts(blk.stmts)
        c = pair.0
        let result_ty = pair.1
        // Check that all linear variables in this scope have been consumed
        c = c.require_current_linear_scope_consumed()
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, result_ty)
    }

    fn check_stmts(self, opt: Option<Box<StmtList> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_stmt((*list).head)
                var c = pair.0
                let stmt_ty = pair.1
                match (*list).tail {
                    Some(_) => c.check_stmts((*list).tail)
                    None => (c, stmt_ty)
                }
            }
            None => (self, ty_unit())
        }
    }

    fn check_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtKind::StmtLet => self.check_let_stmt(s)
            StmtKind::StmtVar => self.check_var_stmt(s)
            StmtKind::StmtExpr => self.check_expr_stmt(s)
            StmtKind::StmtAssign => self.check_assign_stmt(s)
        }
    }

    fn check_let_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        let init_ty = init_pair.1
        // Determine binding type: annotation if present, else init type
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            // Integer literal narrowing: literal 5 (i64) is compatible with i32/i8 annotations
            let int_lit_narrow = c.last_literal_kind == 1
                && init_ty.kind == TypeKind::TyI64
                && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
            if !c.types_compatible_structural(init_ty, ann_ty) && !int_lit_narrow {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
                // N2: see checker_check_let_stmt_inplace's matching comment --
                // noise_set_id has no annotation syntax, so carry it from the
                // inferred RHS rather than resetting it to the annotation's -1.
                if ann_ty.kind == TypeKind::TyKnowledge && init_ty.kind == TypeKind::TyKnowledge {
                    bind_ty.noise_set_id = init_ty.noise_set_id
                }
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        let cur_env = c.env
        c.env = cur_env.bind(s.name, bind_ty, false)
        if const_pair.0 != 0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_var_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        var init_ty = init_pair.1
        if ann_ty.kind == TypeKind::TyRawPtr {
            match s.expr {
                None => { init_ty = ann_ty }
                Some(_) => {}
            }
        }
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            // Integer literal narrowing: literal 5 (i64) is compatible with i32/i8 annotations
            let int_lit_narrow = c.last_literal_kind == 1
                && init_ty.kind == TypeKind::TyI64
                && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
            if !c.types_compatible_structural(init_ty, ann_ty) && !int_lit_narrow {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
                // N2: see checker_check_let_stmt_inplace's matching comment --
                // noise_set_id has no annotation syntax, so carry it from the
                // inferred RHS rather than resetting it to the annotation's -1.
                if ann_ty.kind == TypeKind::TyKnowledge && init_ty.kind == TypeKind::TyKnowledge {
                    bind_ty.noise_set_id = init_ty.noise_set_id
                }
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        c.env = c.env.bind(s.name, bind_ty, true)
        if const_pair.0 != 0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        (c, ty_unit())
    }

    fn check_refinement_literal(self, span: Span, ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        if ty.refinement_id < 0 || ty.refinement_id >= 128 { return self }
        let rt = self.refinements.entries[ty.refinement_id as usize]
        var c = self
        if c.last_literal_kind == 1 {
            // Integer literal — static constant folding proof.
            let result = refine_static_check_int_literal(rt.predicate, c.last_literal_int)
            if result == refine_static_result_proved() {
                // Statically proved: no runtime assertion needed.
                c.refine_static_proved = c.refine_static_proved + 1
            } else {
                // Definitely violated at compile time.
                c.refine_violations = c.refine_violations + 1
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        } else if c.last_literal_kind == 2 {
            // Float literal — static constant folding proof.
            let result = refine_static_check_float_literal(rt.predicate, c.last_literal_float)
            if result == refine_static_result_proved() {
                c.refine_static_proved = c.refine_static_proved + 1
            } else {
                c.refine_violations = c.refine_violations + 1
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        }
        // Reset literal tracking
        c.last_literal_kind = 0
        c
    }

    fn is_linear_type(self, ty: TypeEntry) -> bool with Mut, Panic, Div {
        if ty.kind == TypeKind::TyNamed {
            let idx = struct_table_find(self.structs, ty.name)
            if idx >= 0 {
                return (*self.structs).entries[idx].is_linear
            }
        }
        if ty.kind == TypeKind::TyFn && ty.fn_sig_id >= 0 {
            return fn_sig_table_get(self.fn_sigs, ty.fn_sig_id).is_linear_closure
        }
        false
    }

    fn check_expr_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_expr(s.expr)
    }

    fn check_assign_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let target_pair = c.check_opt_expr(s.target)
        c = target_pair.0
        let target_ty = target_pair.1
        let val_pair = c.check_opt_expr(s.expr)
        c = val_pair.0
        let val_ty = val_pair.1
        // Compound assignments (PlusEq MinusEq etc.) require numeric operands
        if s.assign_op != AssignOp::AssignEq {
            if !is_error_or_unknown(target_ty) && !is_error_or_unknown(val_ty) {
                let compound_result = binary_result_type(compound_assign_to_binop(s.assign_op), target_ty, val_ty)
                if compound_result.kind == TypeKind::TyError {
                    c = c.report_mismatch(s.span, 21, target_ty, val_ty)
                }
            }
        } else {
            // Simple assignment: check compatibility
            match s.expr {
                Some(val_expr) => {
                    if !checker_contextual_expr_compatible(*val_expr, val_ty, target_ty) {
                        c = c.report_mismatch(s.span, 2, target_ty, val_ty)
                    }
                }
                None => {
                    if !c.types_compatible_structural(target_ty, val_ty) {
                        c = c.report_mismatch(s.span, 2, target_ty, val_ty)
                    }
                }
            }
        }
        // Check mutability: if target is an ident, it must be mutable
        c = c.check_assign_mutability(s.target, s.span)
        match s.target {
            Some(target) => {
                if (*target).kind == ExprKind::ExprIdent {
                    let rhs_pair = eval_const_int_opt_expr(c, s.expr)
                    if rhs_pair.0 != 0 {
                        c = c.const_int_bind_value((*target).name, rhs_pair.1)
                    } else {
                        c = c.const_int_bind_unknown((*target).name)
                    }
                }
            }
            None => {}
        }
        (c, ty_unit())
    }

    fn check_assign_mutability(self, opt: Option<Box<Expr> >, span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprIdent {
                    // See checker_check_assign_mutability_inplace: E003 only for a bound
                    // (local) immutable `let`; unbound names are globals (mutable) or
                    // undefined, not local `let`s.
                    if self.env.has_binding((*e).name) && !self.env.lookup_is_mutable((*e).name) {
                        self.report_error_at(span, 3, 0, 0, 0)
                    } else {
                        self
                    }
                } else {
                    // Field access, index — assume mutable for now
                    self
                }
            }
            None => self
        }
    }

    fn check_opt_expr(self, opt: Option<Box<Expr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.check_expr(*e)
            None => (self, ty_unit())
        }
    }

    fn check_binding_init_expr(self, opt: Option<Box<Expr> >, ann_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprContest {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_contest_expr_expected(*e, ann_ty)
                    } else {
                        self.check_contest_expr_no_annotation(*e)
                    }
                } else if (*e).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*e).left) {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_lift_knowledge_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else if (*e).kind == ExprKind::ExprAuditAttach {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_audit_attach_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else if (*e).kind == ExprKind::ExprPath && ann_ty.kind == TypeKind::TyNamed {
                    // Bidirectional inference for enum variants: Option::None with
                    // annotation Option<i32> → use the annotation type so generic
                    // parameters are preserved.
                    let path_pair = self.check_path_expr(*e)
                    let c = path_pair.0
                    let path_ty = path_pair.1
                    if path_ty.kind == TypeKind::TyNamed && name_eq(path_ty.name, ann_ty.name) {
                        (c, ann_ty)
                    } else {
                        (c, path_ty)
                    }
                } else {
                    self.check_expr(*e)
                }
            }
            None => {
                if ann_ty.kind != TypeKind::TyUnknown {
                    (self, ann_ty)
                } else {
                    (self, ty_unit())
                }
            }
        }
    }
}

// ============================================================
// Expression type checking — dispatch
// ============================================================

impl Checker {
    fn check_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check expression depth limit
        let depth_pair = self.check_expr_depth(e.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        let result = match e.kind {
            ExprKind::ExprIntLit => {
                c.last_literal_int = e.int_val
                c.last_literal_kind = 1
                (c, ty_i64())
            }
            ExprKind::ExprFloatLit => {
                c.last_literal_float = e.float_val
                c.last_literal_kind = 2
                (c, ty_f64())
            }
            ExprKind::ExprBoolTrue => (c, ty_bool())
            ExprKind::ExprBoolFalse => (c, ty_bool())
            ExprKind::ExprStringLit => (c, ty_string())
            ExprKind::ExprCharLit => (c, ty_char())
            ExprKind::ExprIdent => {
                if !c.env.has_binding(e.name) {
                    // Functions live in fn_sigs (not env) — resolve a bare fn reference there.
                    let fn_sig_id = fn_sig_table_find(c.fn_sigs, e.name)
                    if fn_sig_id >= 0 {
                        return (c, ty_fn(fn_sig_id))
                    }
                    let c_err = c.report_undeclared(e.span, e.name)
                    return (c_err, ty_error())
                }
                let ident_ty = c.env.lookup(e.name)
                // If this is a linear type variable, mark it as consumed
                var c2 = c
                if c2.is_linear_type(ident_ty) && c2.suppress_linear_consume_depth == 0 {
                    // CRITICAL FIX: Check if borrowed before consuming
                    if c2.borrows.is_borrowed(e.name) {
                        c2 = c2.report_error_at(e.span, 38, 0, 0, 0)  // Cannot consume borrowed value
                    } else {
                        let consume_result = c2.borrows.consume_linear(e.name)
                        c2.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c2 = c2.report_error_at(e.span, consume_result.1, 0, 0, 0)
                        }
                    }
                }
                (c2, ident_ty)
            }
            ExprKind::ExprPath => c.check_path_expr(e)
            ExprKind::ExprBinary => c.check_binary_expr(e)
            ExprKind::ExprUnary => c.check_unary_expr(e)
            ExprKind::ExprFieldAccess => c.check_field_access(e)
            ExprKind::ExprIndex => c.check_index_expr(e)
            ExprKind::ExprMethodCall => c.check_method_call(e)
            ExprKind::ExprCall => c.check_call_expr(e)
            ExprKind::ExprIf => c.check_if_expr(e)
            ExprKind::ExprMatch => c.check_match_expr(e)
            ExprKind::ExprWhile => c.check_while_expr(e)
            ExprKind::ExprLoop => c.check_loop_expr(e)
            ExprKind::ExprBlock => c.check_block_expr(e)
            ExprKind::ExprReturn => c.check_return_expr(e)
            ExprKind::ExprBreak => c.check_break_expr(e)
            ExprKind::ExprContinue => c.check_continue_expr(e)
            ExprKind::ExprStructLit => c.check_struct_lit(e)
            ExprKind::ExprArrayLit => c.check_array_lit(e)
            ExprKind::ExprTupleLit => c.check_tuple_lit(e)
            ExprKind::ExprRange => c.check_range_expr(e)
            ExprKind::ExprCast => c.check_cast_expr(e)
            ExprKind::ExprHandle => c.check_handle_expr(e)
            ExprKind::ExprClosure => c.check_closure_expr(e)
            ExprKind::ExprContest => c.check_contest_expr_no_annotation(e)
            ExprKind::ExprAuditAttach => c.check_audit_attach_expr(e)
            ExprKind::ExprForIn => c.check_for_in_expr(e)
            ExprKind::ExprError => (c, ty_error())
        }
        (result.0.exit_expr_depth(), result.1)
    }

    // --------------------------------------------------------
    // Path expression — enum variant
    // --------------------------------------------------------

    fn check_path_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // First segment is enum/type name, last is variant
        // For now, look up first segment as enum name
        let first_name = checker_copy_string_list_to_name(e.path.segments)
        let enum_idx = enum_table_find(self.enums, first_name)
        if enum_idx >= 0 {
            let ei = enum_table_get(self.enums, enum_idx)
            if self.enforce_visibility && !visibility_allows_access(ei.visibility, ei.defining_module, self.current_module, self.crate_root) {
                let c = self.report_private_enum(e.span, enum_idx, first_name)
                return (c, ty_named(first_name))
            }
            (self, ty_named(first_name))
        } else {
            // Could be a variant name directly (e.g. None, Some)
            let variant_enum_idx = enum_table_find_variant_enum(self.enums, first_name)
            if variant_enum_idx >= 0 {
                let ei = enum_table_get(self.enums, variant_enum_idx)
                if self.enforce_visibility && !visibility_allows_access(ei.visibility, ei.defining_module, self.current_module, self.crate_root) {
                    let c = self.report_private_enum(e.span, variant_enum_idx, first_name)
                    return (c, ty_named(ei.name))
                }
                (self, ty_named(ei.name))
            } else {
                // Look up in env as a regular binding
                (self, self.env.lookup(first_name))
            }
        }
    }

    // --------------------------------------------------------
    // Binary expression
    // --------------------------------------------------------

    fn check_binary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1
        c.check_binary_with_operand_types(e, left_ty, right_ty)
    }

    // Op-typing tail of check_binary_expr, split out so the *mut spine
    // (checker_check_binary_expr_inplace) can check the OPERANDS in place and bridge here
    // for the operand-type-driven validation. This body never re-checks operands, so it
    // never recurses into check_path_expr — faithful by construction (verbatim move).
    fn check_binary_with_operand_types(self, e: Expr, left_ty: TypeEntry, right_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self

        // Observer semantics: comparing Unobserved<T> requires with Observe
        if left_ty.kind == TypeKind::TyUnobserved || right_ty.kind == TypeKind::TyUnobserved {
            let is_cmp = e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
                || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
                || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
            if is_cmp {
                let observe_id: i64 = 13
                if !has_effect_id(c.current_effects, c.current_effect_count, observe_id) {
                    c = c.report_error_at(e.span, 36, 0, 0, 0)
                }
            }
        }

        // Validate binary operator type constraints
        c = c.check_binary_op_types(e.span, e.bin_op, left_ty, right_ty)

        // Epsilon propagation for Knowledge types
        // If either operand is Knowledge<T, epsilon>, propagate epsilon bounds
        if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
            let left_inner = if is_knowledge_type(left_ty) { knowledge_inner(left_ty) } else { left_ty }
            let right_inner = if is_knowledge_type(right_ty) { knowledge_inner(right_ty) } else { right_ty }
            if left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
                let hyper_checked = check_hyper_binary(c, e.span, e.bin_op, left_inner, right_inner)
                c = hyper_checked.0
            }
            // Mirror of the E245 refusal in
            // checker_check_binary_with_operand_types_inplace. check.sio carries two
            // parallel implementations of this rule, and leaving one without the
            // refusal is a trap for whoever edits the other next.
            //
            // Honest limit: I could not demonstrate which engine reaches THIS copy.
            // Madaros demonstrably takes the in-place one (that is where the probes
            // fire), and CI's Full Test Suite runs souc-stage2, which
            // selfhost_host_gate.sh builds from self-hosted/compiler/lean_single.sio
            // -- a self-contained file with its own checker that neither copy feeds.
            // Both copies carry the rule for consistency, not on a measured claim
            // that this one runs.
            let kk_both = is_knowledge_type(left_ty) && is_knowledge_type(right_ty)
            let kk_arith = e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpSub
                || e.bin_op == BinaryOp::OpMul || e.bin_op == BinaryOp::OpDiv
                || e.bin_op == BinaryOp::OpRem
            let kk_hyper = left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper
            if kk_both && kk_arith && !kk_hyper {
                c = c.report_error_at(e.span, 245, 0, 0, 0)
            }
            let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty, c.ns_table)
            if knowledge_result.kind == TypeKind::TyError {
                c = c.report_error_at(e.span, 36, 0, 0, 0)
            }
            // N3: anti-garbling gate (value path). Mirrors the in-place path so
            // the E230 rule cannot go inert on plain named-call binary checking.
            if checker_ns_should_refuse(c.ns_table, e.bin_op, left_ty, right_ty) {
                c = c.report_error_at(e.span, 230, 0, 0, 0)
            }
            // Continue with normal checking for inner type compatibility
            // The knowledge_binary_result handles epsilon propagation
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, knowledge_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            if e.bin_op == BinaryOp::OpMul && left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
                let final_inner = if final_result.kind == TypeKind::TyKnowledge {
                    knowledge_inner(final_result)
                } else {
                    final_result
                }
                if final_inner.kind == TypeKind::TyHyper {
                    c = c.record_hyper_expr(e.span, final_inner.algebra_kind, 1, true)
                }
            }
            return (c, final_result)
        }

        if left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper {
            let hyper_result = check_hyper_binary(c, e.span, e.bin_op, left_ty, right_ty)
            c = hyper_result.0
            let typed_result = hyper_result.1
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, typed_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            if e.bin_op == BinaryOp::OpMul && final_result.kind == TypeKind::TyHyper {
                c = c.record_hyper_expr(e.span, final_result.algebra_kind, 1, false)
            }
            return (c, final_result)
        }

        var result = binary_result_type(e.bin_op, left_ty, right_ty)
        // C-style enum compare: a fieldless enum value is i64-compatible for ==/!=.
        // Canonical bin/souc accepts `i64 == Color::Red`; the pure binary_result_type can't
        // see the enum table, so override here (this Checker method has c.enums). Only ==/!=
        // and only enum-vs-numeric (enum-vs-same-enum already passes via name_eq in
        // binary_result_type; arithmetic stays rejected → matches canonical's `E::A + 1`).
        if result.kind == TypeKind::TyError && (e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe) {
            let l_enum = left_ty.kind == TypeKind::TyNamed && enum_table_find(c.enums, left_ty.name) >= 0
            let r_enum = right_ty.kind == TypeKind::TyNamed && enum_table_find(c.enums, right_ty.name) >= 0
            if (l_enum && is_numeric_type(right_ty)) || (is_numeric_type(left_ty) && r_enum) {
                result = ty_bool()
            }
        }
        // Type-directed == lift (warn-only): boolean equality on the stdlib uncertain
        // scalar (a struct literally named "Epistemic") ignores uncertainty. Result
        // stays bool — no semantic change. "Epistemic" = E p i s t e m i c (9 chars).
        if result.kind == TypeKind::TyBool && (e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe) {
            let l_ep = left_ty.kind == TypeKind::TyNamed && name_matches_str9(left_ty.name, 69, 112, 105, 115, 116, 101, 109, 105, 99)
            let r_ep = right_ty.kind == TypeKind::TyNamed && name_matches_str9(right_ty.name, 69, 112, 105, 115, 116, 101, 109, 105, 99)
            if l_ep || r_ep {
                c = c.report_warning_at(e.span, 43, 0, 0, 0)
            }
        }
        if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
            c = c.report_mismatch(e.span, 4, left_ty, right_ty)
        }
        // Division/modulo by zero: detect denominators that fold to a constant integer zero.
        if e.bin_op == BinaryOp::OpDiv {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 != 0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 56, 0, 0, 0)
            }
        } else if e.bin_op == BinaryOp::OpRem {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 != 0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 57, 0, 0, 0)
            }
        }
        // Unit checking for arithmetic on unit-typed values
        let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, result)
        c = result_with_units.0
        let final_result = result_with_units.1
        (c, final_result)
    }

    fn check_binary_op_types(self, span: Span, op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        if is_error_or_unknown(left_ty) || is_error_or_unknown(right_ty) {
            return self
        }
        // Hypercomplex operands (Octonion/Sedenion/Quaternion/Clifford) are validated by
        // check_hyper_binary at the call site (algebra compatibility + non-associativity effects).
        // Skip the generic structural type-compatibility check, which would otherwise reject two
        // hyper values with a spurious E004 "cannot be combined" before hyper dispatch runs.
        if left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper {
            return self
        }
        match op {
            BinaryOp::OpBitAnd => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpBitOr => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpBitXor => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpShl => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpShr => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpRem => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 50, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpAnd => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            BinaryOp::OpOr => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            _ => self
        }
    }

    fn check_binary_units(self, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry, result: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let lu = left.unit_id
        let ru = right.unit_id
        // If neither side has units, nothing to check
        if lu < 0 && ru < 0 {
            return (c, result)
        }
        match op {
            // Addition/subtraction: units must match exactly
            BinaryOp::OpAdd => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            BinaryOp::OpSub => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            // Multiplication: combine unit dimensions
            BinaryOp::OpMul => {
                if lu >= 0 && ru >= 0 {
                    // Both have units — product gets combined dimensions
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let prod = unit_dim_mul(ld, rd)
                    // For now, result is f64 with no named unit (product unit)
                    // A future pass could register the product unit
                    (c, result)
                } else {
                    // One side has units, other is scalar — keep the unit
                    let uid = if lu >= 0 { lu } else { ru }
                    (c, ty_with_unit(result, uid))
                }
            }
            // Division: combine unit dimensions
            BinaryOp::OpDiv => {
                if lu >= 0 && ru >= 0 {
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let quot = unit_dim_div(ld, rd)
                    if unit_dim_is_dimensionless(quot) {
                        // Units cancel out — result is dimensionless
                        (c, result)
                    } else {
                        // Quotient has dimensions — result is f64 (unnamed unit)
                        (c, result)
                    }
                } else if lu >= 0 {
                    // numerator has units, denominator is scalar — keep unit
                    (c, ty_with_unit(result, lu))
                } else {
                    // numerator is scalar, denominator has units — inverse unit
                    (c, result)
                }
            }
            // Comparison operators: units must match
            BinaryOp::OpEq => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            BinaryOp::OpNe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            BinaryOp::OpLt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            BinaryOp::OpLe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            BinaryOp::OpGt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            BinaryOp::OpGe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            // Other operators: pass through
            _ => (c, result)
        }
    }

    fn report_unit_mismatch(self, span: Span, left_uid: i64, right_uid: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.had_error = true
        c.error_count = c.error_count + 1
        print("error[E041]: unit mismatch in arithmetic operation\n")
        print("  left unit: ")
        if left_uid >= 0 {
            print_unit_dim(c.units.get_dim(left_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n  right unit: ")
        if right_uid >= 0 {
            print_unit_dim(c.units.get_dim(right_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n")
        c
    }

    fn report_unit_call_mismatch(self, span: Span, arg_uid: i64, param_uid: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.had_error = true
        c.error_count = c.error_count + 1
        print("error[E041]: unit mismatch in call argument\n")
        print("  argument unit: ")
        if arg_uid >= 0 {
            print_unit_dim(c.units.get_dim(arg_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n  parameter unit: ")
        if param_uid >= 0 {
            print_unit_dim(c.units.get_dim(param_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n")
        c
    }

    // --------------------------------------------------------
    // Unary expression
    // --------------------------------------------------------

    fn check_slice_borrow_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let want_mut = e.un_op == UnaryOp::OpRefMut
        let borrow_name = unary_operand_name(e.left)
        match e.left {
            Some(index_expr) => {
                let idx_expr = *index_expr
                if idx_expr.kind != ExprKind::ExprIndex {
                    return (self.report_error_at(e.span, 13, 0, 0, 0), ty_error())
                }
                let base_pair = self.check_opt_expr(idx_expr.left)
                var c = base_pair.0
                let base_ty = base_pair.1
                let result_ty = slice_borrow_result_type(base_ty, want_mut)
                if result_ty.kind == TypeKind::TyError && !is_error_or_unknown(base_ty) {
                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                }
                match idx_expr.right {
                    Some(range_expr) => {
                        if (*range_expr).kind != ExprKind::ExprRange || (*range_expr).bin_op != BinaryOp::OpRange {
                            c = c.report_error_at(e.span, 13, 0, 0, 0)
                        } else {
                            match (*range_expr).left {
                                Some(start_expr) => {
                                    let start_pair = c.check_expr(*start_expr)
                                    c = start_pair.0
                                    if !is_error_or_unknown(start_pair.1) && !is_integer_type(start_pair.1) {
                                        c = c.report_mismatch(e.span, 55, ty_i64(), start_pair.1)
                                    }
                                }
                                None => {
                                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                                }
                            }
                            match (*range_expr).right {
                                Some(end_expr) => {
                                    let end_pair = c.check_expr(*end_expr)
                                    c = end_pair.0
                                    if !is_error_or_unknown(end_pair.1) && !is_integer_type(end_pair.1) {
                                        c = c.report_mismatch(e.span, 55, ty_i64(), end_pair.1)
                                    }
                                }
                                None => {
                                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                                }
                            }
                        }
                    }
                    None => {
                        c = c.report_error_at(e.span, 13, 0, 0, 0)
                    }
                }
                if borrow_name.len > 0 {
                    if want_mut {
                        let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                        c.borrows = borrow_result.0
                        if borrow_result.1 != 0 {
                            c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                        }
                    } else {
                        let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                        c.borrows = borrow_result.0
                        if borrow_result.1 != 0 {
                            c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                        }
                    }
                }
                (c, result_ty)
            }
            None => (self.report_error_at(e.span, 13, 0, 0, 0), ty_error())
        }
    }

    fn check_unary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if (e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut) && expr_is_half_open_range(e.left) {
            return self.check_slice_borrow_expr(e)
        }
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let operand_ty = pair.1
        let result = unary_result_type(e.un_op, operand_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
            c = c.report_error_at(e.span, 5, 0, 0, 0)
        }
        // Borrow checking: if this is &x or &!x on a named variable
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            let borrow_name = unary_operand_name(e.left)
            if borrow_name.len > 0 {
                if e.un_op == UnaryOp::OpRef {
                    let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                } else {
                    let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                }
            }
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Field access
    // --------------------------------------------------------

    fn check_field_access(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if checker_expr_is_gpu_axis_field(e) {
            return (self, ty_i64())
        }
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let base_ty = pair.1
        if base_ty.kind == TypeKind::TyNamed {
            let struct_idx = struct_table_find(c.structs, base_ty.name)
            if struct_idx >= 0 {
                let si = struct_table_get(c.structs, struct_idx)
                let field_ty = field_info_list_find(si.fields, e.name)
                if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                    c = c.report_no_field(e.span, e.name, base_ty)
                }
                (c, field_ty)
            } else {
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T> field access: .value -> T, .epsilon -> f64
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                // "value" = [118, 97, 108, 117, 101]
                // Epistemic enforcement: .value requires `with Epistemic` effect
                let epistemic_id: i64 = 8
                if !has_effect_id(c.current_effects, c.current_effect_count, epistemic_id) {
                    c = c.report_error_at(e.span, 170, 0, 0, 0)
                }
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                // "epsilon" = [101, 112, 115, 105, 108, 111, 110]
                (c, ty_f64())
            } else if name_matches_str8(e.name, 118, 97, 114, 105, 97, 110, 99, 101) {
                // "variance" — GUM sigma^2, IR field 1. Ungated (see the *mut twin above).
                (c, ty_f64())
            } else if name_matches_str10(e.name, 99, 111, 110, 102, 105, 100, 101, 110, 99, 101) {
                // "confidence" — IR field 2.
                (c, ty_f64())
            } else {
                c = c.report_no_field(e.span, e.name, base_ty)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyIntervention {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                let epistemic_id: i64 = 8
                if !has_effect_id(c.current_effects, c.current_effect_count, epistemic_id) {
                    c = c.report_error_at(e.span, 170, 0, 0, 0)
                }
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_no_field(e.span, e.name, base_ty)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyCounterfactual {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                let epistemic_id: i64 = 8
                if !has_effect_id(c.current_effects, c.current_effect_count, epistemic_id) {
                    c = c.report_error_at(e.span, 170, 0, 0, 0)
                }
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_no_field(e.span, e.name, base_ty)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyValidated {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                let epistemic_id: i64 = 8
                if !has_effect_id(c.current_effects, c.current_effect_count, epistemic_id) {
                    c = c.report_error_at(e.span, 170, 0, 0, 0)
                }
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_no_field(e.span, e.name, base_ty)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper field access: delegates to hyper.sio predicates
            // Complex: .real, .imag -> inner type
            // Quaternion: .w, .x, .y, .z -> inner type
            // Octonion: .e0.e7 -> inner type
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // Complex fields
            if alg == 1 {
                // "real" = [114, 101, 97, 108], "imag" = [105, 109, 97, 103]
                if name_matches_str4(e.name, 114, 101, 97, 108) { (c, inner_ty) }
                else if name_matches_str4(e.name, 105, 109, 97, 103) { (c, inner_ty) }
                else {
                    c = c.report_no_field(e.span, e.name, base_ty)
                    (c, ty_error())
                }
            // Quaternion fields
            } else if alg == 2 {
                // .w .x .y .z (119, 120, 121, 122)
                if name_matches_str1(e.name, 119) { (c, inner_ty) }
                else if name_matches_str1(e.name, 120) { (c, inner_ty) }
                else if name_matches_str1(e.name, 121) { (c, inner_ty) }
                else if name_matches_str1(e.name, 122) { (c, inner_ty) }
                else {
                    c = c.report_no_field(e.span, e.name, base_ty)
                    (c, ty_error())
                }
            } else {
                // Octonion/Sedenion/Clifford: field access by component index
                // For now accept any short field name and return inner type
                (c, inner_ty)
            }
        } else if base_ty.kind == TypeKind::TyTuple {
            // Tuple field access by index (e.g. t.0, t.1)
            // The field name contains the index as ascii digits
            let idx = (e.name.buf[0] as i64) - 48
            let tuple_count = type_entry_list_count(base_ty.tuple_elems)
            if idx >= tuple_count {
                c = c.report_error_at(e.span, 47, 0, 0, 0)
                (c, ty_error())
            } else {
                let elem = type_entry_list_get(base_ty.tuple_elems, idx)
                (c, elem)
            }
        } else if base_ty.kind == TypeKind::TyRef || base_ty.kind == TypeKind::TyRefMut {
            let inner = call_ref_inner_or_self(base_ty)
            if inner.kind == TypeKind::TyNamed {
                let struct_idx = struct_table_find(c.structs, inner.name)
                if struct_idx >= 0 {
                    let si = struct_table_get(c.structs, struct_idx)
                    let field_ty = field_info_list_find(si.fields, e.name)
                    if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                        c = c.report_no_field(e.span, e.name, base_ty)
                    }
                    (c, field_ty)
                } else {
                    (c, ty_error())
                }
            } else {
                c = c.report_no_field(e.span, e.name, base_ty)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_no_field(e.span, e.name, base_ty)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Index expression
    // --------------------------------------------------------

    fn check_index_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let base_pair = self.check_opt_expr(e.left)
        var c = base_pair.0
        let base_ty = base_pair.1
        let idx_pair = c.check_opt_expr(e.right)
        c = idx_pair.0
        let idx_ty = idx_pair.1
        // Index must be i64
        if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
            c = c.report_error_at(e.span, 14, 0, 0, 0)
        }
        // Seq<T>[i] -> T (mirror of checker_check_index_inplace).
        if base_ty.kind == TypeKind::TyNamed {
            let bn = base_ty.name
            if bn.len == 3 && (bn.buf[0] as i64) == 83 && (bn.buf[1] as i64) == 101 && (bn.buf[2] as i64) == 113 {
                match base_ty.inner {
                    Some(elem) => return (c, *elem)
                    None => return (c, ty_error())
                }
            }
        }
        let elem_ty = indexable_elem_type(base_ty)
        if !is_error_or_unknown(base_ty) && elem_ty.kind == TypeKind::TyError {
            c = c.report_error_at(e.span, 13, 0, 0, 0)
            (c, ty_error())
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            (c, elem_ty)
        }
    }

    // --------------------------------------------------------
    // Method call
    // --------------------------------------------------------

    fn check_method_call(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if checker_expr_is_gpu_launch_descriptor_call(e) || checker_expr_is_gpu_sync_call(e) {
            let c_gpu = self.check_expr_list_no_type_no_linear_consume(e.args)
            return (c_gpu, ty_unit())
        }
        // Method receiver evaluation should not eagerly consume linear values,
        // because receiver passing mode is method-signature dependent.
        var checker_for_base = self
        checker_for_base.suppress_linear_consume_depth = checker_for_base.suppress_linear_consume_depth + 1
        let base_pair = checker_for_base.check_opt_expr(e.left)
        var c = base_pair.0
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        let base_ty = base_pair.1
        if name_matches_str3(e.name, 108, 101, 110) && len_method_supported(base_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            match e.args {
                Some(_) => { c = c.report_error_at(e.span, 10, 0, 0, 0) }
                None => {}
            }
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            if is_seq_type(base_ty) {
                return (c, ty_knowledge(ty_i64(), 0.0 - 1.0))
            }
            return (c, ty_i64())
        }
        if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T>.unwrap() -> T
            if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
                // "unwrap" = [117, 110, 119, 114, 97, 112]
                let call_start_borrows = c.borrows
                match e.args {
                    None => {
                        c = c.report_error_at(e.span, 172, 0, 0, 0)
                        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                        (c, knowledge_inner(base_ty))
                    }
                    Some(arg_list) => {
                        if (*arg_list).head.kind != ExprKind::ExprStringLit {
                            c = c.report_error_at(e.span, 173, 0, 0, 0)
                        }
                        c = c.check_expr_list_no_type_no_linear_consume(e.args)
                        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                        (c, knowledge_inner(base_ty))
                    }
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper method calls: .conjugate() .norm() .inverse()
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // "conjugate" = [99,111,110,106,117,103,97,116,101] (9 chars)
            if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, base_ty)  // conjugate returns same Hyper type
            // "norm" = [110,111,114,109] (4 chars)
            } else if name_matches_str4(e.name, 110, 111, 114, 109) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, inner_ty)  // norm returns scalar
            // "inverse" = [105,110,118,101,114,115,101] (7 chars)
            } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                // Only division algebras have inverse (alg <= 3)
                if alg > 3 {
                    c = c.report_error_at(e.span, 32, 0, 0, 0)
                    (c, ty_error())
                } else {
                    (c, base_ty)
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyNamed {
            let sig_id = fn_sig_table_find_method_semantic(c.fn_sigs, base_ty, e.name)
            if sig_id >= 0 {
                let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                // Verify callee method's effects are subset of caller's effects
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                // Release borrows taken for method call arguments
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                // A named type which is not a declared struct/enum is an unresolved
                // function type parameter. Its trait contract was accepted at the
                // generic declaration boundary, so defer concrete method selection
                // until monomorphization instead of issuing E011 for `F.er_add`.
                if type_is_unresolved_type_param_in_tables(c.structs, c.enums, base_ty) {
                    let call_start_borrows = c.borrows
                    c = c.check_expr_list_no_type_no_linear_consume(e.args)
                    c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                    return (c, base_ty)
                }
                // Method not found
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                // Still check args to accumulate errors
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyString {
            // String methods: .as_bytes() -> &[i8], .len() -> i64
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            // "as_bytes" = [97,115,95,98,121,116,101,115]
            if name_matches_str8(e.name, 97, 115, 95, 98, 121, 116, 101, 115) {
                (c, ty_ref(ty_i8()))
            // "len" = [108,101,110]
            } else if name_matches_str3(e.name, 108, 101, 110) {
                (c, ty_i64())
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                (c, ty_error())
            }
        } else if is_primitive_receiver_type(base_ty) {
            // Primitive receiver (i64/f64/bool/…): mirror the TyNamed (struct)
            // branch — the method registered via `impl R for i64` is found by
            // fn_sig_table_find_method_semantic (kind-disambiguated, empty name).
            // Lookup miss keeps the original E019 so bogus primitive methods reject.
            let sig_id = fn_sig_table_find_method_semantic(c.fn_sigs, base_ty, e.name)
            if sig_id >= 0 {
                let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                c = c.report_error_at(e.span, 19, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            // Mirror inplace: reject nonexistent method names under untyped receivers.
            if !fn_sig_table_has_method_name(c.fn_sigs, e.name) {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                return (c, ty_error())
            }
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 19, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    fn check_method_call_with_base_ty(self, e: Expr, base_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if name_matches_str3(e.name, 108, 101, 110) && len_method_supported(base_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            match e.args {
                Some(_) => { c = c.report_error_at(e.span, 10, 0, 0, 0) }
                None => {}
            }
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            return (c, ty_i64())
        }
        if base_ty.kind == TypeKind::TyKnowledge {
            if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
                let call_start_borrows = c.borrows
                match e.args {
                    None => {
                        c = c.report_error_at(e.span, 172, 0, 0, 0)
                        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                        (c, knowledge_inner(base_ty))
                    }
                    Some(arg_list) => {
                        if (*arg_list).head.kind != ExprKind::ExprStringLit {
                            c = c.report_error_at(e.span, 173, 0, 0, 0)
                        }
                        c = c.check_expr_list_no_type_no_linear_consume(e.args)
                        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                        (c, knowledge_inner(base_ty))
                    }
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, base_ty)
            } else if name_matches_str4(e.name, 110, 111, 114, 109) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, inner_ty)
            } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                if alg > 3 {
                    c = c.report_error_at(e.span, 32, 0, 0, 0)
                    (c, ty_error())
                } else {
                    (c, base_ty)
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyNamed {
            let sig_id = fn_sig_table_find_method_semantic(c.fn_sigs, base_ty, e.name)
            if sig_id >= 0 {
                let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                if type_is_unresolved_type_param_in_tables(c.structs, c.enums, base_ty) {
                    let call_start_borrows = c.borrows
                    c = c.check_expr_list_no_type_no_linear_consume(e.args)
                    c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                    (c, base_ty)
                } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
                }
            }
        } else if base_ty.kind == TypeKind::TyString {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            if name_matches_str8(e.name, 97, 115, 95, 98, 121, 116, 101, 115) {
                (c, ty_ref(ty_i8()))
            } else if name_matches_str3(e.name, 108, 101, 110) {
                (c, ty_i64())
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                (c, ty_error())
            }
        } else if is_primitive_receiver_type(base_ty) {
            // Primitive receiver (i64/f64/bool/…): mirror the TyNamed (struct)
            // branch — the method registered via `impl R for i64` is found by
            // fn_sig_table_find_method_semantic (kind-disambiguated, empty name).
            // Lookup miss keeps the original E019 so bogus primitive methods reject.
            let sig_id = fn_sig_table_find_method_semantic(c.fn_sigs, base_ty, e.name)
            if sig_id >= 0 {
                let sig = fn_sig_table_get(c.fn_sigs, sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                c = c.report_error_at(e.span, 19, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            // Mirror inplace: reject nonexistent method names under untyped receivers.
            if !fn_sig_table_has_method_name(c.fn_sigs, e.name) {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                return (c, ty_error())
            }
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 19, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }


    // --------------------------------------------------------
    // Function call
    // --------------------------------------------------------

    fn check_slice_len_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let call_start_borrows = self.borrows
        let first_pair = self.check_opt_expr(first_arg)
        var c = first_pair.0
        let arg_ty = first_pair.1
        match first_arg {
            None => c = c.report_error_at(e.span, 10, 0, 0, 0)
            Some(_) => {}
        }
        match second_arg {
            Some(_) => c = c.report_error_at(e.span, 10, 0, 0, 0)
            None => {}
        }
        let is_ok =
            arg_ty.kind == TypeKind::TySlice
            || arg_ty.kind == TypeKind::TySliceMut
            || slice_param_accepts_array_ref(arg_ty, ty_slice(ty_unknown()))
        if !is_ok && !is_error_or_unknown(arg_ty) {
            c = c.report_error_at(e.span, 9, 0, 0, 0)
        }
        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
        (c, ty_i64())
    }

    fn check_print_i64_builtin_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let first_pair = self.check_opt_expr(first_arg)
        var c = first_pair.0
        let arg_ty = first_pair.1
        match first_arg {
            None => c = c.report_error_at(e.span, 10, 0, 0, 0)
            Some(_) => {}
        }
        match second_arg {
            Some(_) => c = c.report_error_at(e.span, 10, 0, 0, 0)
            None => {}
        }
        if checker_type_is_unobserved_like(arg_ty) {
            if !has_effect_id(c.current_effects, c.current_effect_count, 13) {
                c = c.report_unobserved_print(e.span)
            }
            var effects_unobserved: [i64; 8] = [0; 8]
            effects_unobserved[0] = 0
            c = c.check_callee_effects(e.span, effects_unobserved, 1)
            return (c, ty_unit())
        }
        if !is_error_or_unknown(arg_ty) && !c.types_compatible_structural(arg_ty, ty_i64()) {
            c = c.report_mismatch(e.span, 9, ty_i64(), arg_ty)
        }
        var effects: [i64; 8] = [0; 8]
        effects[0] = 0
        c = c.check_callee_effects(e.span, effects, 1)
        (c, ty_unit())
    }

    fn check_box_new_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let call_start_borrows = self.borrows
        let first_pair = self.check_opt_expr(first_arg)
        var c = first_pair.0
        let arg_ty = first_pair.1
        match first_arg {
            None => c = c.report_error_at(e.span, 10, 0, 0, 0)
            Some(_) => {}
        }
        match second_arg {
            Some(extra) => {
                let extra_pair = c.check_expr(*extra)
                c = extra_pair.0
                c = c.report_error_at(e.span, 10, 0, 0, 0)
            }
            None => {}
        }
        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
        var box_ty = ty_named(make_name("Box"))
        box_ty.inner = Some(Box::new(arg_ty))
        (c, box_ty)
    }

    fn check_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Safety guard: ExprIndex nodes (e.right=Some) are occasionally dispatched here
        // due to a VM-level kind mismatch. ExprCall never sets e.right; ExprIndex always does.
        match e.right {
            Some(_) => return self.check_index_expr(e)
            None => {}
        }
        if checker_expr_is_gpu_launch_invocation_call(e) {
            var c_launch = self
            match e.left {
                Some(desc) => {
                    c_launch = c_launch.check_expr_list_no_type_no_linear_consume((*desc).args)
                }
                None => {}
            }
            c_launch = c_launch.check_expr_list_no_type_no_linear_consume(e.args)
            return (c_launch, ty_unit())
        }
        if checker_expr_is_gpu_launch_descriptor_call(e) || checker_expr_is_gpu_sync_call(e) {
            let c_gpu = self.check_expr_list_no_type_no_linear_consume(e.args)
            return (c_gpu, ty_unit())
        }
        if call_expr_is_builtin_prove_robust(e.left) {
            return self.check_prove_robust_expr(e)
        }
        if call_expr_is_builtin_validate_manifest(e.left) {
            return self.check_validate_manifest_expr(e)
        }
        if call_expr_is_builtin_admit_action(e.left) {
            return self.check_admit_action_expr(e)
        }
        if call_expr_is_builtin_defer_action(e.left) {
            return self.check_defer_action_expr(e)
        }
        if call_expr_is_builtin_deferral_reason(e.left) {
            return self.check_deferral_reason_expr(e)
        }
        if call_expr_is_builtin_plan_acquisition(e.left) {
            return self.check_plan_acquisition_expr(e)
        }
        if call_expr_is_builtin_acquisition_reason(e.left) {
            return self.check_acquisition_reason_expr(e)
        }
        if call_expr_is_builtin_plan_recourse(e.left) {
            return self.check_plan_recourse_expr(e)
        }
        if call_expr_is_builtin_recourse_reason(e.left) {
            return self.check_recourse_reason_expr(e)
        }
        if call_expr_is_builtin_propose_alternatives(e.left) {
            return self.check_propose_alternatives_expr(e)
        }
        if call_expr_is_builtin_alternative_count(e.left) {
            return self.check_alternative_count_expr(e)
        }
        if call_expr_is_builtin_alternative_option(e.left) {
            return self.check_alternative_option_expr(e)
        }
        if call_expr_is_builtin_alternative_reason(e.left) {
            return self.check_alternative_reason_expr(e)
        }
        if call_expr_is_builtin_commit_alternative(e.left) {
            return self.check_commit_alternative_expr(e)
        }
        if call_expr_is_builtin_transition_reason(e.left) {
            return self.check_transition_reason_expr(e)
        }
        if call_expr_is_builtin_transition_step_count(e.left) {
            return self.check_transition_step_count_expr(e)
        }
        if call_expr_is_builtin_observe_transition(e.left) {
            return self.check_observe_transition_expr(e)
        }
        if call_expr_is_builtin_rollback_transition(e.left) {
            return self.check_rollback_transition_expr(e)
        }
        if call_expr_is_builtin_lift_knowledge(e.left) {
            return self.check_lift_knowledge_expr(e)
        }
        if call_expr_is_builtin_measure(e.left) {
            return self.check_measure_expr(e)
        }
        if call_expr_is_builtin_knowledge_ctor(e.left) {
            return self.check_knowledge_ctor_expr(e)
        }
        if call_expr_is_builtin_variance_of(e.left) {
            return self.check_variance_metric_expr(e)
        }
        if call_expr_is_builtin_uncertainty_of(e.left) {
            return self.check_variance_metric_expr(e)
        }
        if call_expr_is_builtin_slice_len(e.left) {
            return self.check_slice_len_call_expr(e)
        }
        if call_expr_is_box_new(e.left) {
            return self.check_box_new_expr(e)
        }
        if call_expr_is_builtin_print_int(e.left) {
            return self.check_print_i64_builtin_expr(e)
        }
        if call_expr_is_builtin_print_char(e.left) {
            return self.check_print_i64_builtin_expr(e)
        }
        if call_expr_is_builtin_println(e.left) {
            let first_arg = expr_list_head(e.args)
            let first_pair = self.check_opt_expr(first_arg)
            var c_println = first_pair.0
            let arg_ty = first_pair.1
            if checker_type_is_unobserved_like(arg_ty) {
                if !has_effect_id(c_println.current_effects, c_println.current_effect_count, 13) {
                    c_println = c_println.report_unobserved_print(e.span)
                }
                var effects_unobserved: [i64; 8] = [0; 8]
                effects_unobserved[0] = 0
                c_println = c_println.check_callee_effects(e.span, effects_unobserved, 1)
                return (c_println, ty_unit())
            }
        }
        let witness_kind = call_expr_contest_witness_kind(e.left)
        if witness_kind >= 0 {
            return self.check_contest_witness_expr(e, witness_kind)
        }
        var c = self
        if multitest_effect_enabled(c.current_effects, c.current_effect_count) {
            let callee_name = multitest_call_name(e.left)
            if multitest_is_stat_test_name(callee_name) {
                c.multitest_count = c.multitest_count + 1
            } else if multitest_is_correction_name(callee_name) {
                c.multitest_corrected = true
            }
        }
        if hypothesis_effect_enabled(c.current_effects, c.current_effect_count) {
            let callee_name = multitest_call_name(e.left)
            if c.studies.count > 0 && multitest_is_stat_test_name(callee_name) {
                let outcome_name = hypothesis_outcome_name_from_args(e.args)
                if !name_is_empty(outcome_name) && !active_study_has_hypothesis_outcome(c.studies, outcome_name) {
                    c = c.report_hypothesis_penalty_warning(e.span, outcome_name)
                }
            }
        }
        let callee_pair = c.check_opt_expr(e.left)
        c = callee_pair.0
        let callee_ty = callee_pair.1
        let array_like_ty =
            if callee_ty.kind == TypeKind::TyArray {
                callee_ty
            } else if callee_ty.kind == TypeKind::TyRef || callee_ty.kind == TypeKind::TyRefMut {
                match callee_ty.inner {
                    Some(inner_ty) => *inner_ty
                    None => ty_error()
                }
            } else {
                ty_error()
            }
        if array_like_ty.kind == TypeKind::TyArray {
            let idx_arg = expr_list_head(e.args)
            let extra_arg = expr_list_second(e.args)
            match idx_arg {
                Some(arg) => {
                    let idx_pair = c.check_expr(*arg)
                    c = idx_pair.0
                    let idx_ty = idx_pair.1
                    if !is_error_or_unknown(idx_ty) && !is_integer_type(idx_ty) {
                        c = c.report_error_at(e.span, 14, 0, 0, 0)
                    }
                    match extra_arg {
                        Some(extra) => {
                            let extra_pair = c.check_expr(*extra)
                            c = extra_pair.0
                            c = c.report_error_at(e.span, 17, 0, 0, 0)
                            // The `(c, ty_error())` that used to close this arm was
                            // DISCARDED — the enclosing match is a statement — and it
                            // was what made this arm yield a pair while the outer
                            // `None => {}` yields unit, i.e. the E018. Deleted rather
                            // than turned into `return (c, ty_error())`: that would
                            // also typecheck, but it would change behaviour, since the
                            // code currently reports error 17 and falls through to the
                            // TyFn check below. Fixing a type error is not the place to
                            // decide that.
                        }
                        None => {
                            match array_like_ty.inner {
                                Some(elem_ty) => return (c, *elem_ty)
                                None => return (c, ty_error())
                            }
                        }
                    }
                }
                None => {}
            }
        }
        if callee_ty.kind == TypeKind::TyFn && callee_ty.fn_sig_id >= 0 {
            let sig = fn_sig_table_get(c.fn_sigs, callee_ty.fn_sig_id)
            if c.enforce_visibility && !visibility_allows_access(sig.visibility, sig.defining_module, c.current_module, c.crate_root) {
                c = c.report_private_fn(e.span, callee_ty.fn_sig_id)
            }
            // #1622: calling an `extern "C"` name the native backend does not
            // implement. Refuse here rather than emit a call that reads 0.
            // Checked at the CALL, not at the declaration -- see the same note
            // on the in-place arm above, and the fixture that pins it,
            // tests/run-pass/ffi_declared_never_called_is_legal.sio.
            var refused_unimplemented = false
            if sig.is_extern && !name_is_native_backend_builtin(sig.name) {
                c = c.report_error_at(e.span, 250, 0, 0, 0)
                refused_unimplemented = true
            }
            let call_start_borrows = c.borrows
            var effective_params = fn_param_list_clone(&sig.params)
            var effective_return_type = sig.return_type
            match call_expr_type_args(e) {
                Some(type_arg_exprs) => {
                    let lowered_type_args_pair = c.lower_type_expr_list(*type_arg_exprs)
                    c = lowered_type_args_pair.0
                    let lowered_type_args = lowered_type_args_pair.1
                    var generic_names = collect_fn_generic_names_from_params_in_tables(c.structs, c.enums, fn_param_list_clone(&sig.params), empty_type_param_buf())
                    generic_names = collect_fn_generic_names_from_type_in_tables(c.structs, c.enums, sig.return_type, generic_names)
                    if generic_names.count > 0 {
                        let provided_type_arg_count = type_entry_list_count_value(&lowered_type_args)
                        if provided_type_arg_count != generic_names.count {
                            c = c.report_error_at(e.span, 10, 0, 0, 0)
                        }
                        effective_params = checker_substitute_fn_params(effective_params, generic_names, type_entry_list_clone(&lowered_type_args))
                        effective_return_type = substitute_type_param(sig.return_type, generic_names, type_entry_list_clone(&lowered_type_args))
                    }
                }
                None => {}
            }
            c = c.check_call_args(e.args, effective_params, sig.param_count, e.span)
            // Verify callee's effects are subset of caller's effects
            c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
            // Release borrows taken for call arguments — the call has returned,
            // so exclusive/shared borrows on arguments are no longer active.
            c = c.release_call_arg_borrows(e.args, effective_params, call_start_borrows)
            if refused_unimplemented {
                (c, ty_error())
            } else {
                (c, effective_return_type)
            }
        } else if is_error_or_unknown(callee_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, callee_ty)
        } else {
            c = c.report_error_at(e.span, 17, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    fn check_contest_expr_no_annotation(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_contest_expr_expected(e, ty_error())
        (pair.0.report_error_at(e.span, 59, 0, 0, 0), ty_error())
    }

    fn check_contest_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let subject_pair = c.check_opt_expr(e.left)
        c = subject_pair.0
        let subject_ty = subject_pair.1
        if !contest_model_list_present(e.args) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
        }
        if expected_contest_ty.kind == TypeKind::TyError || expected_contest_ty.kind != TypeKind::TyContest {
            (c, ty_error())
        } else {
            var info = contest_info_from_expr_models(e.args)
            info = contest_info_attach_span(info, e.span)
            if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
                let expected_info = c.contests.get(expected_contest_ty.epistemic_meta_id)
                info.family_id = expected_info.family_id
                info.policy_id = expected_info.policy_id
                info.audit_id = expected_info.audit_id
                var i: i64 = 0
                while i < 8 {
                    info.metric_known[i as usize] = expected_info.metric_known[i as usize]
                    info.metric_values[i as usize] = expected_info.metric_values[i as usize]
                    i = i + 1
                }
                info.mechanistic_report_id = expected_info.mechanistic_report_id
                info.posterior_weights_id = expected_info.posterior_weights_id
                info.counterexample_id = expected_info.counterexample_id
                info.provenance_bundle_id = expected_info.provenance_bundle_id
                if expected_info.family_id >= 0 {
                    if expected_info.family_id >= c.model_families.count {
                        c = c.report_missing_model_family_metadata(e.span)
                    } else {
                        let family_info = c.model_families.get(expected_info.family_id)
                        if !contest_model_lists_match(e.args, family_info, 0) {
                            c = c.report_model_family_mismatch(e.span, family_info, info)
                        }
                        if !types_compatible(subject_ty, family_info.input_ty) {
                            c = c.report_mismatch(e.span, 1, family_info.input_ty, subject_ty)
                        }
                    }
                }
                c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
                (c, ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id))
            } else {
                let add_result = c.contests.add(info)
                c.contests = add_result.0
                (c, ty_contest(knowledge_inner(expected_contest_ty), add_result.1))
            }
        }
    }

    fn check_audit_attach_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_audit_attach_expr_expected(e, ty_error())
    }

    fn check_audit_attach_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let audit_id = self.audits.find(e.name)
        if audit_id < 0 || audit_id >= self.audits.count {
            return (self.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        let audit_info = self.audits.get(audit_id)
        var seeded_expected_ty = expected_contest_ty
        var seeded_checker = self
        if expected_contest_ty.kind == TypeKind::TyContest
        && expected_contest_ty.epistemic_meta_id >= 0
        && expected_contest_ty.epistemic_meta_id < self.contests.count {
            let expected_info = self.contests.get(expected_contest_ty.epistemic_meta_id)
            if expected_info.family_id >= 0 && expected_info.policy_id >= 0 {
                if !contest_matches_audit_target(expected_contest_ty, expected_info, audit_info) {
                    return (self.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(expected_contest_ty), expected_info), ty_error())
                }
                var merged_expected = contest_info_apply_audit(expected_info, audit_info, audit_id)
                merged_expected = contest_info_attach_span(merged_expected, e.span)
                seeded_checker.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = merged_expected
                seeded_expected_ty = ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id)
            }
        }
        let contest_pair = match e.left {
            Some(left_expr) => {
                if (*left_expr).kind == ExprKind::ExprContest {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { contest_type_seeded_from_audit(self, audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_contest_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else if (*left_expr).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*left_expr).left) {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { contest_type_seeded_from_audit(self, audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_lift_knowledge_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else {
                    seeded_checker.check_expr(*left_expr)
                }
            }
            None => (seeded_checker.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if !contest_matches_audit_target(contest_ty, contest_info, audit_info) {
            return (c.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(contest_ty), contest_info), ty_error())
        }

        var merged = contest_info_apply_audit(contest_info, audit_info, audit_id)
        merged = contest_info_attach_span(merged, e.span)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = merged
        (c, ty_contest(knowledge_inner(contest_ty), contest_ty.epistemic_meta_id))
    }

    fn check_prove_robust_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)

        let policy_pair = self.check_opt_expr(second_arg)
        var c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyPolicy {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.policies.count {
            c = c.report_policy_requires_named_definition(e.span)
            return (c, ty_error())
        }

        let policy_info = c.policies.get(policy_ty.epistemic_meta_id)
        if policy_info.level_id < 0 || policy_info.scope_id < 0 {
            c = c.report_policy_missing_robustness_metadata(e.span, policy_info.name)
            return (c, ty_error())
        }

        let contest_inner = knowledge_inner(policy_ty)
        let contest_pair = match first_arg {
            Some(arg) => c.check_expr(*arg)
            None => (c.report_error_at(e.span, 58, 0, 0, 0), ty_error())
        }
        c = contest_pair.0
        let contest_ty = contest_pair.1

        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if !types_compatible(knowledge_inner(contest_ty), contest_inner) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }
        if contest_info.policy_id >= 0 && contest_info.policy_id != policy_ty.epistemic_meta_id {
            c = c.report_contest_policy_mismatch(e.span, contest_info.policy_id, policy_ty.epistemic_meta_id)
            return (c, ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = check_policy_requirements_against_contest(
                c,
                e.span,
                policy_info.name,
                policy_info.requirements,
                contest_ty.epistemic_meta_id
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let proof_info = robust_proof_info_from_contest(contest_ty.epistemic_meta_id, contest_info, policy_info, e.span)
        let add_result = c.robust_proofs.add(proof_info)
        c.robust_proofs = add_result.0
        (c, ty_robust(contest_inner, add_result.1, policy_info.level_id, policy_info.scope_id))
    }

    // validate_manifest(robust: Robust<T>) -> Validated<T>
    // Terminal epistemic chain step: a Robust<T> that has been manifestly validated
    // becomes Validated<T>. Policy satisfaction was proven at check time; this call
    // serves as the explicit compile-time gate that produces the Validated<T> token.
    fn check_validate_manifest_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let robust_pair = self.check_opt_expr(first_arg)
        var c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let validation_pair = c.check_opt_expr(second_arg)
        c = validation_pair.0
        let validation_ty = validation_pair.1
        if validation_ty.kind != TypeKind::TyValidation {
            c = c.report_missing_validation_policy(e.span)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, knowledge_inner(validation_ty)) {
            c = c.report_validation_target_mismatch(e.span, knowledge_inner(validation_ty), inner_ty)
            return (c, ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            c = c.report_missing_robust_proof(e.span)
            return (c, ty_error())
        }
        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        let manifest_info = ValidatedManifestInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            validation_id: validation_ty.epistemic_meta_id,
            inner_ty: inner_ty,
        }
        let add_result = c.validated_manifests.add(manifest_info)
        c.validated_manifests = add_result.0
        (c, ty_validated_with_policy(inner_ty, 0.0 - 1.0, add_result.1))
    }

    fn check_decision_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_decision_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_decision_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_decision_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferral_reason_code_from_metric_id(self, metric_id: i64) -> i64 {
        if metric_id == CONTEST_METRIC_SIGN_CONSENSUS || metric_id == CONTEST_METRIC_RELATIVE_BAND {
            return DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT
        }
        if metric_id == CONTEST_METRIC_MECHANISTIC_DIVERGENCE {
            return DEFERRAL_REASON_MECHANISTIC_CONFLICT
        }
        if metric_id == CONTEST_METRIC_MAX_TAIL_RISK {
            return DEFERRAL_REASON_TAIL_RISK
        }
        if metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR {
            return DEFERRAL_REASON_IDENTIFIABILITY_GAP
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn deferral_reason_code_from_requirements(self, opt: Option<Box<PolicyRequirementInfoList> >) -> i64 with Mut, Panic, Div {
        match opt {
            Some(list) => self.deferral_reason_code_from_metric_id((*list).head.metric_id)
            None => DEFERRAL_REASON_POLICY_INCOMPLETE
        }
    }

    fn check_deferral_policy_requirements_against_contest(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        contest_info: ContestInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = contest_info_get_metric(contest_info, req.metric_id)
                if metric_pair.0 == false {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_contest(span, policy_name, (*list).tail, contest_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_deferral_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_acquisition_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if metric_pair.0 == false {
                    let c = self.report_missing_acquisition_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_acquisition_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_acquisition_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_recourse_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if metric_pair.0 == false {
                    let c = self.report_missing_recourse_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_recourse_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_recourse_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferred_reason_witness_info_new(self, span: Span, certificate_id: i64) -> DeferredReasonWitnessInfo {
        DeferredReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            deferred_certificate_id: certificate_id,
        }
    }

    fn acquisition_reason_witness_info_new(self, span: Span, plan_id: i64) -> AcquisitionReasonWitnessInfo {
        AcquisitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            acquisition_plan_id: plan_id,
        }
    }

    fn recourse_reason_witness_info_new(self, span: Span, plan_id: i64) -> RecourseReasonWitnessInfo {
        RecourseReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            recourse_plan_id: plan_id,
        }
    }

    fn transition_reason_witness_info_new(self, span: Span, plan_id: i64) -> TransitionReasonWitnessInfo {
        TransitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            transition_plan_id: plan_id,
        }
    }

    fn alternative_reason_witness_info_new(self, span: Span, candidate_id: i64) -> AlternativeReasonWitnessInfo {
        AlternativeReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            candidate_id: candidate_id,
        }
    }

    fn alternative_frontier_name_from_expr(self, opt: Option<Box<Expr> >) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }

    fn transition_protocol_name_from_expr(self, opt: Option<Box<Expr> >) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }




    fn transition_candidate_metric_pair(self, candidate: AlternativeCandidateInfo, metric_id: i64) -> (i64, f64) with Mut, Panic, Div {
        if transition_metric_is_candidate(metric_id) {
            let alt_metric_id = transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && candidate.metric_known[alt_metric_id as usize] == 1 {
                return (1, candidate.metric_values[alt_metric_id as usize])
            }
            return (0, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_DEFERRED {
            if candidate.deferred_certificate_id >= 0 && candidate.deferred_certificate_id < self.deferred_certificates.count {
                let pair = deferred_certificate_get_metric(self.deferred_certificates.get(candidate.deferred_certificate_id), metric_id)
                if pair.0 != false {
                    return (1, pair.1)
                }
            }
            return (0, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_RECOURSE_PLAN {
            if candidate.source_plan_id >= 0 && candidate.source_plan_id < self.recourse_plans.count {
                let plan_info = self.recourse_plans.get(candidate.source_plan_id)
                if metric_id >= 0 && metric_id < 8 && plan_info.metric_known[metric_id as usize] == 1 {
                    return (1, plan_info.metric_values[metric_id as usize])
                }
            }
            return (0, 0.0)
        }

        (0, 0.0)
    }

    fn transition_plan_metric_pair(self, plan: TransitionPlanInfo, metric_id: i64) -> (i64, f64) with Mut, Panic, Div {
        if transition_metric_is_candidate(metric_id) {
            let alt_metric_id = transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && plan.metric_known[alt_metric_id as usize] == 1 {
                return (1, plan.metric_values[alt_metric_id as usize])
            }
        }

        if plan.alternative_option_id >= 0 && plan.alternative_option_id < self.alternative_candidates.count {
            return self.transition_candidate_metric_pair(self.alternative_candidates.get(plan.alternative_option_id), metric_id)
        }

        if plan.contest_id >= 0 && plan.contest_id < self.contests.count {
            let pair = contest_info_get_metric(self.contests.get(plan.contest_id), metric_id)
            if pair.0 != false {
                return (1, pair.1)
            }
        }

        (0, 0.0)
    }

    fn transition_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("transition_value")
    }

    fn transition_expr_value_matches_candidate(self, step_expr: Expr, candidate_expr: Expr) -> bool with Mut, Panic, Div, Alloc {
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.int_val == candidate_expr.int_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return step_expr.float_val == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return (step_expr.int_val as f64) == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.float_val == (candidate_expr.int_val as f64)
        }
        if (step_expr.kind == ExprKind::ExprIdent || step_expr.kind == ExprKind::ExprPath)
            && (candidate_expr.kind == ExprKind::ExprIdent || candidate_expr.kind == ExprKind::ExprPath) {
            return name_eq(contest_model_name(step_expr), contest_model_name(candidate_expr))
        }
        false
    }

    fn check_transition_requirements_against_candidate(
        self,
        span: Span,
        owner_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        candidate: AlternativeCandidateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_candidate_metric_pair(candidate, req.metric_id)
                if metric_pair.0 == 0 {
                    let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                        (c, false)
                    } else {
                        self.check_transition_requirements_against_candidate(span, owner_name, (*list).tail, candidate)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn alternative_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("value")
    }

    fn alternative_candidate_metric_known(self, info: AlternativeCandidateInfo, metric_id: i64) -> bool with Mut, Panic, Div {
        metric_id >= 0 && metric_id < 8 && info.metric_known[metric_id as usize] == 1
    }

    fn alternative_candidate_metric_value(self, info: AlternativeCandidateInfo, metric_id: i64) -> f64 with Mut, Panic, Div {
        if metric_id >= 0 && metric_id < 8 {
            info.metric_values[metric_id as usize]
        } else {
            0.0
        }
    }

    fn alternative_candidate_metrics_complete(self, info: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> (bool, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if !self.alternative_candidate_metric_known(info, metric_id) {
                return (false, metric_id)
            }
            i = i + 1
        }
        (true, -1)
    }

    fn alternative_candidate_no_worse(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r >= l } else { r <= l }
    }

    fn alternative_candidate_strictly_better(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r > l } else { r < l }
    }

    fn alternative_candidate_is_duplicate(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        if !name_eq(lhs.value_repr, rhs.value_repr) {
            return false
        }
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if self.alternative_candidate_metric_value(lhs, metric_id) != self.alternative_candidate_metric_value(rhs, metric_id) {
                return false
            }
            i = i + 1
        }
        true
    }

    fn alternative_candidate_is_dominated(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        var all_no_worse = true
        var any_better = false
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            let direction = policy_info.objective_directions[i as usize]
            if !self.alternative_candidate_no_worse(lhs, rhs, metric_id, direction) {
                all_no_worse = false
            }
            if self.alternative_candidate_strictly_better(lhs, rhs, metric_id, direction) {
                any_better = true
            }
            i = i + 1
        }
        all_no_worse && any_better
    }

    fn alternative_candidate_attach_realized(
        self,
        info: AlternativeCandidateInfo,
        frontier_id: i64,
        source_kind: i64,
        deferred_certificate_id: i64,
        source_policy_id: i64,
        source_plan_id: i64,
        strategy_name: Name,
        route_name: Name,
        audit_id: i64,
        contest_id: i64,
        value_repr: Name
    ) -> AlternativeCandidateInfo with Mut, Panic, Div {
        var next = info
        next.frontier_id = frontier_id
        next.source_kind = source_kind
        next.deferred_certificate_id = deferred_certificate_id
        next.source_policy_id = source_policy_id
        next.source_plan_id = source_plan_id
        next.strategy_name = strategy_name
        next.route_name = route_name
        next.audit_id = audit_id
        next.contest_id = contest_id
        next.value_repr = value_repr
        next.dominance_rank = 0
        next
    }

    fn contest_has_counterexample(self, contest_id: i64) -> bool with Mut, Panic, Div {
        if contest_id < 0 || contest_id >= self.contests.count {
            return false
        }
        let contest_info = self.contests.get(contest_id)
        if contest_info.counterexample_id >= 0 {
            return true
        }
        let metric_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_COUNTEREXAMPLE_PRESENT)
        metric_pair.0 != false && metric_pair.1 > 0.0
    }

    fn deferred_certificate_attach_resolution_metrics(self, cert: DeferredCertificateInfo) -> DeferredCertificateInfo with Mut, Panic, Div {
        var next = cert
        if next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] != 1
        && self.contest_has_counterexample(next.contest_id) {
            next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
            next.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
        }
        next.metric_known[CONTEST_METRIC_DEFERRED_REASON as usize] = 1
        next.metric_values[CONTEST_METRIC_DEFERRED_REASON as usize] = next.reason_code as f64
        next
    }

    fn check_admit_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let robust_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let robust_pair = c.check_opt_expr(robust_arg)
        c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.robustness_level_id < 0 || robust_ty.robustness_scope_id < 0 {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }

        let decision_pair = c.check_opt_expr(policy_arg)
        c = decision_pair.0
        let decision_ty = decision_pair.1
        if decision_ty.kind != TypeKind::TyDecisionPolicy {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }
        if decision_ty.epistemic_meta_id < 0 || decision_ty.epistemic_meta_id >= c.decision_policies.count {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_decision_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.decision_policies.get(decision_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_decision_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_decision_policy_requirements_against_proof(
                e.span,
                policy_info.name,
                policy_info.requirements,
                proof_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let cert_info = DecisionCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            decision_policy_id: decision_ty.epistemic_meta_id,
            inner_ty: inner_ty,
            metric_known: proof_info.metric_known,
            metric_values: proof_info.metric_values,
        }
        let add_result = c.decision_certificates.add(cert_info)
        c.decision_certificates = add_result.0
        (c, ty_admissible(inner_ty, add_result.1))
    }

    fn check_defer_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyDeferralPolicy {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.deferral_policies.count {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        let policy_info = c.deferral_policies.get(policy_ty.epistemic_meta_id)

        if evidence_ty.kind == TypeKind::TyContest {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.contests.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let contest_info = c.contests.get(evidence_ty.epistemic_meta_id)
            if contest_info.family_id < 0 || contest_info.policy_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_contest(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    contest_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: contest_info.audit_id,
                contest_id: evidence_ty.epistemic_meta_id,
                robust_proof_id: -1,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_CONTEST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: contest_info.metric_known,
                metric_values: contest_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        if evidence_ty.kind == TypeKind::TyRobust {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.robustness_level_id < 0 || evidence_ty.robustness_scope_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.robust_proofs.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let proof_info = c.robust_proofs.get(evidence_ty.epistemic_meta_id)
            if proof_info.contest_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_proof(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    proof_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: proof_info.audit_id,
                contest_id: proof_info.contest_id,
                robust_proof_id: evidence_ty.epistemic_meta_id,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_ROBUST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: proof_info.metric_known,
                metric_values: proof_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
    }

    fn check_deferral_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let deferred_pair = self.check_opt_expr(first_arg)
        var c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_deferral_reason_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }
        let add_result = c.deferred_reason_witnesses.add(c.deferred_reason_witness_info_new(e.span, deferred_ty.epistemic_meta_id))
        c.deferred_reason_witnesses = add_result.0
        (c, ty_named(deferral_reason_type_name()))
    }

    fn check_plan_acquisition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_acquisition_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyAcquisitionPolicy {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.acquisition_policies.count {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_acquisition_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.acquisition_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_acquisition_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_acquisition_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = AcquisitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            acquisition_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            objective_name: policy_info.objective_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.acquisition_plans.add(plan_info)
        c.acquisition_plans = add_result.0
        (c, ty_acquisition_plan(inner_ty, add_result.1))
    }

    fn check_acquisition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyAcquisitionPlan {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.acquisition_plans.count {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.acquisition_reason_witnesses.add(c.acquisition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.acquisition_reason_witnesses = add_result.0
        (c, ty_named(acquisition_reason_type_name()))
    }

    fn check_plan_recourse_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_recourse_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyRecoursePolicy {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.recourse_policies.count {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_recourse_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.recourse_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_recourse_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_recourse_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = RecoursePlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            recourse_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            strategy_name: policy_info.strategy_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.recourse_plans.add(plan_info)
        c.recourse_plans = add_result.0
        (c, ty_recourse_plan(inner_ty, add_result.1))
    }

    fn check_recourse_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyRecoursePlan {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.recourse_plans.count {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.recourse_reason_witnesses.add(c.recourse_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.recourse_reason_witnesses = add_result.0
        (c, ty_named(recourse_reason_type_name()))
    }

    fn check_propose_alternatives_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let frontier_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        var source_kind: i64 = -1
        var inner_ty = ty_error()
        var deferred_certificate_id: i64 = -1
        var recourse_plan_id: i64 = -1
        var audit_id: i64 = -1
        var contest_id: i64 = -1
        var strategy_name = empty_name()
        var route_name = empty_name()
        var recourse_policy_id: i64 = -1
        var cert_info = empty_deferred_certificate_info()

        if evidence_ty.kind == TypeKind::TyDeferred {
            source_kind = ALTERNATIVE_SOURCE_DEFERRED
            inner_ty = knowledge_inner(evidence_ty)
            deferred_certificate_id = evidence_ty.epistemic_meta_id
            if deferred_certificate_id < 0 || deferred_certificate_id >= c.deferred_certificates.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            cert_info = c.deferred_certificates.get(deferred_certificate_id)
            audit_id = cert_info.audit_id
            contest_id = cert_info.contest_id
        } else if evidence_ty.kind == TypeKind::TyRecoursePlan {
            source_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
            inner_ty = knowledge_inner(evidence_ty)
            recourse_plan_id = evidence_ty.epistemic_meta_id
            if recourse_plan_id < 0 || recourse_plan_id >= c.recourse_plans.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            let plan_info = c.recourse_plans.get(recourse_plan_id)
            audit_id = plan_info.audit_id
            contest_id = plan_info.contest_id
            strategy_name = plan_info.strategy_name
            route_name = plan_info.route_name
            recourse_policy_id = plan_info.recourse_policy_id
            if plan_info.deferred_certificate_id >= 0 && plan_info.deferred_certificate_id < c.deferred_certificates.count {
                cert_info = c.deferred_certificates.get(plan_info.deferred_certificate_id)
            }
        } else {
            return (c.report_propose_alternatives_requires_evidence(e.span, evidence_ty), ty_error())
        }

        if !types_compatible(inner_ty, value_ty) {
            return (c.report_mismatch(e.span, 1, inner_ty, value_ty), ty_error())
        }

        let frontier_name = c.alternative_frontier_name_from_expr(frontier_arg)
        let frontier_id = c.alternative_frontiers.find(frontier_name)
        if frontier_id < 0 || frontier_id >= c.alternative_frontiers.count {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        let frontier_info = c.alternative_frontiers.get(frontier_id)
        if frontier_info.target_kind != source_kind || !types_compatible(frontier_info.target_ty, evidence_ty) {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        if audit_id < 0 || contest_id < 0 {
            return (c.report_alternative_requires_metadata(e.span, frontier_name), ty_error())
        }
        if frontier_info.policy_id < 0 || frontier_info.policy_id >= c.alternative_policies.count {
            return (c.report_alternative_policy_target_mismatch(e.span, frontier_name), ty_error())
        }
        let policy_info = c.alternative_policies.get(frontier_info.policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_alternative_policy_target_mismatch(e.span, policy_info.name), ty_error())
        }

        if policy_info.max_options >= 0 && frontier_info.candidate_count > policy_info.max_options {
            return (c.report_alternative_candidate_dominated_or_duplicate(e.span, frontier_name), ty_error())
        }

        var realized_candidate_ids: [i64; 16] = [-1; 16]
        var realized_count: i64 = 0
        var idx: i64 = frontier_info.candidate_count - 1
        while idx >= 0 {
            let candidate_id = frontier_info.candidate_ids[idx as usize]
            if candidate_id >= 0 && candidate_id < c.alternative_candidates.count {
                let template = c.alternative_candidates.get(candidate_id)
                let complete_pair = c.alternative_candidate_metrics_complete(template, policy_info)
                if complete_pair.0 == false {
                    return (c.report_alternative_candidate_metrics_incomplete(e.span, template.name, alternative_metric_name(complete_pair.1)), ty_error())
                }

                let value_check = c.check_expr(template.value_expr)
                c = value_check.0
                let candidate_value_ty = value_check.1
                if !types_compatible(inner_ty, candidate_value_ty) {
                    return (c.report_alternative_candidate_value_mismatch(e.span, template.name, inner_ty, candidate_value_ty), ty_error())
                }

                var realized = template
                if source_kind == ALTERNATIVE_SOURCE_DEFERRED {
                    if !template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, empty_name()), ty_error())
                    }
                    let via_policy_id = c.recourse_policies.find(template.via_recourse_policy_name)
                    if via_policy_id < 0 || via_policy_id >= c.recourse_policies.count {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    let via_policy = c.recourse_policies.get(via_policy_id)
                    if !types_compatible(via_policy.target_ty, inner_ty) {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    if via_policy.requirement_count > 0 {
                        let req_pair = c.check_recourse_policy_requirements_against_deferred(e.span, via_policy.name, via_policy.requirements, cert_info)
                        c = req_pair.0
                        if !req_pair.1 {
                            return (c, ty_error())
                        }
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_DEFERRED,
                        deferred_certificate_id,
                        via_policy_id,
                        -1,
                        via_policy.strategy_name,
                        via_policy.route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                } else {
                    if template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_RECOURSE_PLAN,
                        -1,
                        recourse_policy_id,
                        recourse_plan_id,
                        strategy_name,
                        route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                }
                c.alternative_candidates.entries[candidate_id as usize] = realized
                realized_candidate_ids[realized_count as usize] = candidate_id
                realized_count = realized_count + 1
            }
            idx = idx - 1
        }

        var i: i64 = 0
        while i < realized_count {
            let lhs_id = realized_candidate_ids[i as usize]
            let lhs = c.alternative_candidates.get(lhs_id)
            var j: i64 = 0
            while j < realized_count {
                if i != j {
                    let rhs_id = realized_candidate_ids[j as usize]
                    let rhs = c.alternative_candidates.get(rhs_id)
                    if c.alternative_candidate_is_duplicate(lhs, rhs, policy_info) || c.alternative_candidate_is_dominated(lhs, rhs, policy_info) {
                        return (c.report_alternative_candidate_dominated_or_duplicate(e.span, lhs.name), ty_error())
                    }
                }
                j = j + 1
            }
            i = i + 1
        }

        let set_info = AlternativeSetInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            source_kind: source_kind,
            frontier_id: frontier_id,
            deferred_certificate_id: deferred_certificate_id,
            recourse_plan_id: recourse_plan_id,
            audit_id: audit_id,
            contest_id: contest_id,
            inner_ty: inner_ty,
            candidate_ids: realized_candidate_ids,
            candidate_count: realized_count,
        }
        let add_result = c.alternative_sets.add(set_info)
        c.alternative_sets = add_result.0
        (c, ty_alternative_set(inner_ty, add_result.1))
    }

    fn check_alternative_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_alternative_option_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let idx_arg = expr_list_second(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let idx_pair = eval_const_int_opt_expr(c, idx_arg)
        if idx_pair.0 == 0 {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let set_info = c.alternative_sets.get(set_ty.epistemic_meta_id)
        if idx_pair.1 < 0 || idx_pair.1 >= set_info.candidate_count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let candidate_id = set_info.candidate_ids[idx_pair.1 as usize]
        (c, ty_alternative_option(knowledge_inner(set_ty), candidate_id))
    }

    fn check_alternative_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let option_pair = self.check_opt_expr(first_arg)
        var c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
        || option_ty.epistemic_meta_id < 0
        || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_alternative_reason_requires_option(e.span, option_ty), ty_error())
        }
        let add_result = c.alternative_reason_witnesses.add(c.alternative_reason_witness_info_new(e.span, option_ty.epistemic_meta_id))
        c.alternative_reason_witnesses = add_result.0
        (c, ty_named(alternative_reason_type_name()))
    }

    fn check_commit_alternative_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let option_arg = expr_list_second(e.args)
        let protocol_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let option_pair = c.check_opt_expr(option_arg)
        c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
            || option_ty.epistemic_meta_id < 0
            || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_commit_alternative_requires_option(e.span, option_ty), ty_error())
        }
        let candidate_info = c.alternative_candidates.get(option_ty.epistemic_meta_id)
        let inner_ty = knowledge_inner(option_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let protocol_name = c.transition_protocol_name_from_expr(protocol_arg)
        let protocol_id = c.transition_protocols.find(protocol_name)
        if protocol_id < 0 || protocol_id >= c.transition_protocols.count {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }
        let protocol_info = c.transition_protocols.get(protocol_id)
        if !types_compatible(protocol_info.target_ty, option_ty) {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }

        let policy_id = protocol_info.transition_policy_id
        if policy_id < 0 || policy_id >= c.transition_policies.count {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, option_ty), ty_error())
        }
        let policy_info = c.transition_policies.get(policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.max_steps >= 0 && protocol_info.step_count > policy_info.max_steps {
            return (c.report_transition_steps_exceed_max(e.span, protocol_info.name, policy_info.max_steps, protocol_info.step_count), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_transition_requirements_against_candidate(e.span, policy_info.name, policy_info.requirements, candidate_info)
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        var final_step_expr = candidate_info.value_expr
        var final_step_repr = candidate_info.value_repr
        var i: i64 = 0
        while i < protocol_info.step_count && i < 16 {
            let step_id = protocol_info.step_ids[i as usize]
            if step_id >= 0 && step_id < c.transition_steps.count {
                let step_info = c.transition_steps.get(step_id)
                let step_value_pair = c.check_expr(step_info.value_expr)
                c = step_value_pair.0
                let step_value_ty = step_value_pair.1
                if !types_compatible(inner_ty, step_value_ty) {
                    return (c.report_transition_step_value_mismatch(e.span, step_info.name, inner_ty, step_value_ty), ty_error())
                }
                if step_info.requirement_count > 0 {
                    let req_pair = c.check_transition_requirements_against_candidate(e.span, step_info.name, step_info.requirements, candidate_info)
                    c = req_pair.0
                    if !req_pair.1 {
                        return (c, ty_error())
                    }
                }
                final_step_expr = step_info.value_expr
                final_step_repr = c.transition_expr_value_repr(step_info.value_expr)
            }
            i = i + 1
        }

        if protocol_info.step_count <= 0 || !c.transition_expr_value_matches_candidate(final_step_expr, candidate_info.value_expr) {
            return (c.report_transition_final_step_mismatch(e.span, protocol_info.name, candidate_info.name), ty_error())
        }

        let plan_info = TransitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_policy_id: policy_id,
            transition_protocol_id: protocol_id,
            alternative_option_id: option_ty.epistemic_meta_id,
            audit_id: candidate_info.audit_id,
            contest_id: candidate_info.contest_id,
            route_name: policy_info.route_name,
            rollback_route_name: policy_info.rollback_route_name,
            step_count: protocol_info.step_count,
            final_value_repr: final_step_repr,
            inner_ty: inner_ty,
            metric_known: candidate_info.metric_known,
            metric_values: candidate_info.metric_values,
        }
        let add_result = c.transition_plans.add(plan_info)
        c.transition_plans = add_result.0
        (c, ty_transition_plan(inner_ty, add_result.1))
    }

    fn check_monitoring_policy_requirements_against_plan(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList> >,
        plan_info: TransitionPlanInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                if metric_pair.0 == 0 {
                    let c = self.report_missing_monitoring_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_monitoring_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_monitoring_policy_requirements_against_plan(span, policy_name, (*list).tail, plan_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn monitoring_policy_has_violation_or_unavailable(
        self,
        opt: Option<Box<PolicyRequirementInfoList> >,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if metric_pair.0 == 0 {
                        return true
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return true
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        false
    }

    fn monitoring_policy_reason_code_from_plan(
        self,
        opt: Option<Box<PolicyRequirementInfoList> >,
        plan_info: TransitionPlanInfo
    ) -> i64 with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if metric_pair.0 == 0 {
                        return self.deferral_reason_code_from_metric_id(req.metric_id)
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return self.deferral_reason_code_from_metric_id(req.metric_id)
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn monitoring_policy_requirements_hold_silent(
        self,
        opt: Option<Box<PolicyRequirementInfoList> >,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if metric_pair.0 == 0 {
                        return false
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return false
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        true
    }

    fn check_transition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.transition_reason_witnesses.add(c.transition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.transition_reason_witnesses = add_result.0
        (c, ty_named(transition_reason_type_name()))
    }

    fn check_transition_step_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_step_count_requires_plan(e.span, plan_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_observe_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_observe_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_monitoring_policy_requirements_against_plan(
                e.span,
                policy_info.name,
                policy_info.requirements,
                plan_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let observed_info = ObservedTransitionInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.observed_transitions.add(observed_info)
        c.observed_transitions = add_result.0
        (c, ty_observed_transition(inner_ty, add_result.1))
    }

    fn check_rollback_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_rollback_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count <= 0
        || c.monitoring_policy_requirements_hold_silent(policy_info.requirements, plan_info) {
            return (c.report_rollback_transition_requires_failure(e.span, policy_info.name), ty_error())
        }

        let rollback_info = RollbackCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            reason_code: c.monitoring_policy_reason_code_from_plan(policy_info.requirements, plan_info),
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.rollback_certificates.add(rollback_info)
        c.rollback_certificates = add_result.0
        (c, ty_rollback_certificate(inner_ty, add_result.1))
    }

    fn check_contest_witness_expr(self, e: Expr, witness_kind: i64) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let builtin_name = match e.left {
            Some(callee) => if (*callee).kind == ExprKind::ExprIdent { (*callee).name } else { empty_name() }
            None => empty_name()
        }
        let first_arg = expr_list_head(e.args)
        let contest_pair = self.check_opt_expr(first_arg)
        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_contest_witness_requires_contest(e.span, builtin_name, contest_ty)
            return (c, ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }
        let contest_id = contest_ty.epistemic_meta_id
        let contest_info = c.contests.get(contest_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }

        if contest_witness_requires_metric(witness_kind) {
            let metric_id = contest_witness_metric_id(witness_kind)
            let metric_pair = contest_info_get_metric(contest_info, metric_id)
            if metric_pair.0 == false {
                c = c.report_contest_metric_unavailable(e.span, metric_id, contest_id)
                return (c, ty_error())
            }
        }

        if contest_witness_requires_mechanistic(witness_kind) {
            if contest_info.mechanistic_report_id < 0 || contest_info.mechanistic_report_id >= c.mechanistic_reports.count {
                c = c.report_mechanistic_report_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_DISAGREEMENT {
            let sign_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_SIGN_CONSENSUS)
            if sign_pair.0 == false {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_SIGN_CONSENSUS, contest_id)
                return (c, ty_error())
            }
            let band_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_RELATIVE_BAND)
            if band_pair.0 == false {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_RELATIVE_BAND, contest_id)
                return (c, ty_error())
            }
            let tail_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_MAX_TAIL_RISK)
            if tail_pair.0 == false {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_MAX_TAIL_RISK, contest_id)
                return (c, ty_error())
            }
            let ident_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_IDENTIFIABILITY_FLOOR)
            if ident_pair.0 == false {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_IDENTIFIABILITY_FLOOR, contest_id)
                return (c, ty_error())
            }
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_COUNTEREXAMPLE {
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        let add_result = c.contest_witnesses.add(contest_witness_info_new(e.span, witness_kind, contest_id))
        c.contest_witnesses = add_result.0
        (c, contest_witness_result_type(witness_kind))
    }

    fn check_lift_knowledge_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // lift_knowledge(k: Knowledge<T>) -> Contest<T>
        // Type-check first arg; must be Knowledge<T>; produce Contest<T>
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        (c, ty_contest(inner_ty, k_ty.epistemic_meta_id))
    }

    fn check_lift_knowledge_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        let expected_inner = knowledge_inner(expected_contest_ty)
        if !types_compatible(inner_ty, expected_inner) {
            c = c.report_mismatch(e.span, 1, expected_inner, inner_ty)
            return (c, ty_error())
        }
        if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
            var info = c.contests.get(expected_contest_ty.epistemic_meta_id)
            info = contest_info_attach_span(info, e.span)
            c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
            return (c, ty_contest(expected_inner, expected_contest_ty.epistemic_meta_id))
        }
        (c, expected_contest_ty)
    }

    fn check_measure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // measure(v: T, uncertainty: f64) -> Knowledge<T>
        // Type-check first arg; T = type of value; result = Knowledge<T> with epsilon=-1 (unspecified)
        let first_arg = expr_list_head(e.args)
        let v_pair = self.check_opt_expr(first_arg)
        let c = v_pair.0
        let v_ty = v_pair.1
        (c, ty_knowledge(v_ty, 0.0 - 1.0))
    }

    fn check_knowledge_ctor_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Knowledge(v, e=<confidence>, prov=<provenance>) -> Knowledge<T>; by-value twin of
        // checker_check_knowledge_ctor_expr_inplace.
        let first_arg = expr_list_head(e.args)
        let v_pair = self.check_opt_expr(first_arg)
        var c = v_pair.0
        let v_ty = v_pair.1
        let confidence = knowledge_ctor_confidence(e.args)
        var minimum: i64 = 0 - 1
        if c.current_sig_id >= 0 {
            let sig = fn_sig_table_get(c.fn_sigs, c.current_sig_id)
            if name_eq(sig.name, c.current_sig_name) {
                minimum = sig.epistemic_min_confidence
            }
        }
        let confidence_milli = if confidence < 0.0 { 1 } else { (confidence * 1000.0 + 0.5) as i64 }
        if minimum > 0 && confidence_milli < minimum {
            c = c.report_error_at(e.span, 215, confidence_milli, minimum, 0)
        }
        (c, ty_knowledge(v_ty, confidence))
    }

    fn check_variance_metric_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        var c = self
        match first_arg {
            None => c = c.report_error_at(e.span, 10, 0, 0, 0)
            Some(_) => {}
        }
        match second_arg {
            Some(_) => c = c.report_error_at(e.span, 10, 0, 0, 0)
            None => {}
        }
        c = c.check_expr_list_no_type_no_linear_consume(e.args)
        (c, ty_f64())
    }

    fn borrow_state_and_shared_count(self, name: Name) -> (i64, i64) with Mut, Panic, Div, Alloc, IO {
        let idx = self.borrows.find(name)
        if idx >= 0 {
            let entry = self.borrows.entries[idx]
            (entry.state, entry.shared_count)
        } else {
            (0, 0)
        }
    }

    // Release borrows taken for function call arguments after the call returns.
    // Handles:
    //   1) implicit boundary borrows: f(x) where param is &T / &!T
    //   2) explicit unary borrows:   f(&x) / f(&!x)
    // Release only borrows introduced by this call expression; pre-existing
    // borrows must remain active even if a call-site borrow attempt fails.
    fn release_call_arg_borrows(self, args: Option<Box<ExprList> >, params: Option<Box<FnParamList> >, call_start_borrows: BorrowEnv) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        match args {
            None => c
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                var implicit_release_kind: i64 = 0  // 0=none, 1=shared, 2=exclusive
                var next_params: Option<Box<FnParamList> > = None

                match params {
                    None => {}
                    Some(param_list) => {
                        let param = (*param_list).head
                        if param.ty.kind == TypeKind::TyRef {
                            implicit_release_kind = 1
                        } else if param.ty.kind == TypeKind::TyRefMut {
                            implicit_release_kind = 2
                        }
                        next_params = (*param_list).tail
                    }
                }

                if arg_expr.kind == ExprKind::ExprIdent && implicit_release_kind != 0 {
                    // Release borrows unconditionally after call returns.
                    // Previous logic used state delta (before_pair vs current_pair)
                    // which failed when consecutive calls borrow the same variable
                    // (the second call saw before_pair.0 == 2 from the first call's
                    // un-released borrow, and skipped the release).
                    if implicit_release_kind == 1 || implicit_release_kind == 2 {
                        c.borrows = c.borrows.release_borrow(arg_expr.name)
                    }
                }

                if arg_expr.kind == ExprKind::ExprUnary &&
                   (arg_expr.un_op == UnaryOp::OpRef || arg_expr.un_op == UnaryOp::OpRefMut) {
                    let borrow_name = unary_operand_name(arg_expr.left)
                    if !name_is_empty(borrow_name) {
                        // Unconditionally release call-site borrows after call returns
                        c.borrows = c.borrows.release_borrow(borrow_name)
                    }
                }

                c.release_call_arg_borrows((*arg_list).tail, next_params, call_start_borrows)
            }
        }
    }

    fn check_call_args(self, args: Option<Box<ExprList> >, params: Option<Box<FnParamList> >, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.check_call_args_inner(args, params, 0, expected_count, call_span)
        c
    }

    fn check_call_arg_borrow_boundary(self, arg_expr: Expr, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        if arg_expr.kind != ExprKind::ExprIdent {
            return self
        }
        var c = self
        if param_ty.kind == TypeKind::TyRef {
            let borrow_result = c.borrows.try_shared_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        } else if param_ty.kind == TypeKind::TyRefMut {
            let borrow_result = c.borrows.try_exclusive_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        }
        c
    }

    fn check_call_arg_refinement_boundary(self, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.refinement_id < 0 || expected_ty.refinement_id >= 128 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }

        let expected_ref = self.refinements.entries[expected_ty.refinement_id as usize]
        var c = self

        if arg_expr.kind == ExprKind::ExprIntLit {
            // Constant folding: literal known at compile time.
            let result = refine_static_check_int_literal(expected_ref.predicate, arg_expr.int_val)
            if result == refine_static_result_proved() {
                c.refine_static_proved = c.refine_static_proved + 1
            } else {
                c.refine_violations = c.refine_violations + 1
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }
        if arg_expr.kind == ExprKind::ExprFloatLit {
            let result = refine_static_check_float_literal(expected_ref.predicate, arg_expr.float_val)
            if result == refine_static_result_proved() {
                c.refine_static_proved = c.refine_static_proved + 1
            } else {
                c.refine_violations = c.refine_violations + 1
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        if provided_ty.refinement_id >= 0 && provided_ty.refinement_id < 128 {
            let provided_ref = c.refinements.entries[provided_ty.refinement_id as usize]
            if pred_implies(provided_ref.predicate, expected_ref.predicate) {
                c.refine_static_proved = c.refine_static_proved + 1
            } else {
                c.refine_violations = c.refine_violations + 1
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        // Try known-constant lookup for identifiers
        if arg_expr.kind == ExprKind::ExprIdent {
            let const_result = c.const_int_lookup(arg_expr.name)
            if const_result.0 != false {
                let result = refine_static_check_int_literal(expected_ref.predicate, const_result.1)
                if result == refine_static_result_proved() {
                    c.refine_static_proved = c.refine_static_proved + 1
                    return c
                } else {
                    c.refine_violations = c.refine_violations + 1
                    return c.report_error_at(call_span, 42, 0, 0, 0)
                }
            }
        }

        // Try environment-based proof: look up arg type for refinement
        if arg_expr.kind == ExprKind::ExprIdent {
            let env_lookup = c.env.lookup(arg_expr.name)
            if env_lookup.refinement_id >= 0 && env_lookup.refinement_id < 128 {
                let env_ref = c.refinements.entries[env_lookup.refinement_id as usize]
                if pred_implies(env_ref.predicate, expected_ref.predicate) {
                    c.refine_static_proved = c.refine_static_proved + 1
                    return c
                }
            }

            // Condition-narrowing proof: use guard predicates accumulated from
            // enclosing `if` conditions.  E.g., inside `if x > 0 { f(x) }`,
            // x > 0 is a guard — sufficient to prove `x` satisfies `{ x > 0 }`.
            let cond_result = refine_static_check_var(c.refine_cond_env, arg_expr.name, expected_ref.predicate)
            if cond_result == refine_static_result_proved() {
                c.refine_static_proved = c.refine_static_proved + 1
                return c
            }

            // Ontology-aware proof: collect ALL property predicates from
            // class + ancestors into a single conjunction, then check once.
            //
            // This is the canonical form for compound property reasoning:
            //   axioms = {potency >= 0.0, mw < 1000.0, ...}
            //   conjoined = (potency >= 0.0) AND (mw < 1000.0) AND ...
            //   pred_implies_structural(conjoined, expected) succeeds when the
            //   collected conjunction is strong enough to discharge expected.
            // Failure is still only an under-approximation of semantic proof.
            //
            // Uses pred_implies_structural (var_name independent) because
            // properties are universally quantified — the bound variable name
            // is a binder artifact, not a semantic identity.
            if env_lookup.ontology_id >= 0 {
                let arg_oid = env_lookup.ontology_id
                var axiom_preds: [RefinementPred; 16] = [empty_refinement_pred(); 16]
                var axiom_count: i64 = 0
                var axiom_overflow = false

                if arg_oid >= 0 && arg_oid < c.ontology_kernel.classes.count {
                    // Collect own class property axioms first.
                    var pi: i64 = 0
                    let own_axiom_count = c.ontology_kernel.materialized.class_property_counts[arg_oid as usize]
                    while pi < own_axiom_count {
                        let axiom_idx = c.ontology_kernel.materialized.class_property_axioms[(arg_oid * 8 + pi) as usize]
                        if axiom_idx >= 0 && axiom_idx < c.ontology_kernel.axioms.count {
                            let ontology_axiom = c.ontology_kernel.axioms.axioms[axiom_idx as usize]
                            let prop_ref_id = ontology_axiom.refinement_ref_id
                            if prop_ref_id >= 0 && prop_ref_id < 128 {
                                if axiom_count < 16 {
                                    axiom_preds[axiom_count as usize] = c.refinements.entries[prop_ref_id as usize].predicate
                                    axiom_count = axiom_count + 1
                                } else {
                                    axiom_overflow = true
                                }
                            }
                        }
                        pi = pi + 1
                    }

                    // Collect superclass property axioms via the materialized subclass matrix.
                    var anc_idx: i64 = 0
                    while anc_idx < c.ontology_kernel.classes.count {
                        if anc_idx != arg_oid && ontology_kernel_is_subclass(c.ontology_kernel, arg_oid, anc_idx) {
                            var pj: i64 = 0
                            let anc_axiom_count = c.ontology_kernel.materialized.class_property_counts[anc_idx as usize]
                            while pj < anc_axiom_count {
                                let anc_axiom_idx = c.ontology_kernel.materialized.class_property_axioms[(anc_idx * 8 + pj) as usize]
                                if anc_axiom_idx >= 0 && anc_axiom_idx < c.ontology_kernel.axioms.count {
                                    let anc_axiom = c.ontology_kernel.axioms.axioms[anc_axiom_idx as usize]
                                    let anc_prop_ref_id = anc_axiom.refinement_ref_id
                                    if anc_prop_ref_id >= 0 && anc_prop_ref_id < 128 {
                                        if axiom_count < 16 {
                                            axiom_preds[axiom_count as usize] = c.refinements.entries[anc_prop_ref_id as usize].predicate
                                            axiom_count = axiom_count + 1
                                        } else {
                                            axiom_overflow = true
                                        }
                                    }
                                }
                                pj = pj + 1
                            }
                        }
                        anc_idx = anc_idx + 1
                    }
                }

                // Build conjunction and discharge with one call
                if axiom_count > 0 {
                    if axiom_overflow {
                        c = c.report_warning_at(call_span, 42, 0, 0, 0)
                    }
                    var conjoined = axiom_preds[0]
                    var ci: i64 = 1
                    while ci < axiom_count {
                        conjoined = pred_and(conjoined, axiom_preds[ci as usize])
                        ci = ci + 1
                    }
                    if pred_implies_structural(conjoined, expected_ref.predicate) {
                        c.refine_static_proved = c.refine_static_proved + 1
                        return c
                    }
                }
            }
        }

        // Epistemic fallback: static analysis exhausted — defer to runtime assertion.
        // W040 semantics: the call compiles. The predicate is NOT proven statically.
        //   Emit refine_hint: static_unknown diagnostic (W045) alongside W040.
        //   - Debug mode (future): codegen inserts runtime assertion at this call site.
        //     If the predicate fails at runtime, panic with "refinement predicate violated".
        //   - Release mode: trust the programmer. The warning was sufficient notice.
        // To suppress: #[allow(W040)] on the call site (not yet implemented).
        // To force proof: annotate the argument with an explicit refinement type.
        c.refine_runtime_checked = c.refine_runtime_checked + 1
        c.report_warning_at(call_span, 40, 0, 0, 0)
    }

    fn check_call_arg_knowledge_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if !is_epistemic_type(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if !is_epistemic_type(provided_ty) || is_error_or_unknown(provided_ty) {
            return self
        }
        if provided_ty.kind != expected_ty.kind {
            return self.report_error_at(call_span, 36, 0, 0, 0)
        }
        if knowledge_inner(expected_ty).kind == TypeKind::TyUnknown &&
           knowledge_meta_epsilon(knowledge_meta_from_ty(expected_ty)) < 0.0 {
            return self
        }
        if knowledge_call_boundary_compatible(provided_ty, expected_ty) {
            self
        } else {
            // Mirror of the in-place site: name the failing slot (E244 for
            // provenance, E036 otherwise). Both copies carry the rule — the
            // codebase's twin-drift history says so.
            let pm = knowledge_meta_from_ty(provided_ty)
            let rm = knowledge_meta_from_ty(expected_ty)
            if !provenance_subsumes(knowledge_meta_provenance(pm), knowledge_meta_provenance(rm)) {
                self.report_error_at(call_span, 244, 0, 0, 0)
            } else {
                self.report_error_at(call_span, 36, 0, 0, 0)
            }
        }
    }

    fn check_call_arg_unit_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(expected_ty) || is_error_or_unknown(provided_ty) {
            return self
        }
        if expected_ty.unit_id >= 0 && provided_ty.unit_id >= 0 && expected_ty.unit_id != provided_ty.unit_id {
            return self.report_unit_call_mismatch(call_span, provided_ty.unit_id, expected_ty.unit_id)
        }
        self
    }

    fn check_call_arg_ontology_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.ontology_id < 0 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }
        if provided_ty.ontology_id < 0 {
            // Non-ontology value passed where ontology type expected
            return self.report_error_at(call_span, 150, 0, 0, 0)
        }
        // Check subsumption: provided must be subclass of expected
        if self.ontology_inference_query_subclass(provided_ty.ontology_id, expected_ty.ontology_id) {
            return self
        }
        // Check disjointness for better error
        if self.ontology_inference_query_disjoint(provided_ty.ontology_id, expected_ty.ontology_id) {
            return self.report_error_at(call_span, 151, 0, 0, 0)
        }
        self.report_error_at(call_span, 152, 0, 0, 0)
    }

    fn ontology_boundary_check_call_arg_contract(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        self.check_call_arg_ontology_boundary(arg_ty, param_ty, call_span)
    }

    fn types_compatible_structural(self, a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
        checker_types_compatible_table(self.fn_sigs, a, b)
    }

    fn call_arg_types_compatible_structural(self, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
        checker_call_arg_types_compatible_table(self.fn_sigs, arg_expr, arg_ty, param_ty)
    }

    fn check_call_args_inner(self, args: Option<Box<ExprList> >, params: Option<Box<FnParamList> >, idx: i64, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                let param_info = fn_param_list_get(params, idx)
                let implicit_borrow =
                    arg_expr.kind == ExprKind::ExprIdent &&
                    (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)

                var checker_for_arg = self
                if implicit_borrow {
                    checker_for_arg.suppress_linear_consume_depth = checker_for_arg.suppress_linear_consume_depth + 1
                }

                let pair = checker_for_arg.check_expr(arg_expr)
                var c = pair.0
                if implicit_borrow && c.suppress_linear_consume_depth > 0 {
                    c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
                }
                let arg_ty = pair.1

                // Check against parameter type and boundary contracts
                let has_param_info = !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError
                if has_param_info {
                    if !c.call_arg_types_compatible_structural(arg_expr, arg_ty, param_info.ty) {
                        c = c.report_mismatch(call_span, 9, param_info.ty, arg_ty)
                    }
                    if arg_ty.kind != TypeKind::TyFn && param_info.ty.kind != TypeKind::TyFn {
                        c = c.check_call_arg_borrow_boundary(arg_expr, param_info.ty, call_span)
                        c = c.check_call_arg_refinement_boundary(arg_expr, arg_ty, param_info.ty, call_span)
                        c = c.check_call_arg_knowledge_boundary(arg_ty, param_info.ty, call_span)
                        c = c.check_call_arg_unit_boundary(arg_ty, param_info.ty, call_span)
                        c = c.ontology_boundary_check_call_arg_contract(arg_ty, param_info.ty, call_span)
                    }
                }
                // Linear type consumption: if arg is linear and not implicitly borrowed, consume it
                if has_param_info &&
                   arg_expr.kind == ExprKind::ExprIdent &&
                   c.is_linear_type(arg_ty) &&
                   !implicit_borrow &&
                   c.suppress_linear_consume_depth == 0 {
                    if c.borrows.is_borrowed(arg_expr.name) {
                        c = c.report_error_at(call_span, 38, 0, 0, 0)
                    } else {
                        let consume_result = c.borrows.consume_linear(arg_expr.name)
                        c.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c = c.report_error_at(call_span, 39, 0, 0, 0)
                        }
                    }
                }
                c.check_call_args_inner((*arg_list).tail, params, idx + 1, expected_count, call_span)
            }
            None => {
                // Check arity: idx should equal expected_count
                if idx != expected_count && expected_count >= 0 {
                    self.report_error_at(call_span, 10, 0, 0, 0)
                } else {
                    self
                }
            }
        }
    }

    fn check_expr_list_no_type(self, opt: Option<Box<ExprList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                c.check_expr_list_no_type((*list).tail)
            }
            None => self
        }
    }

    // Diagnostic-only argument checking helper: validate expression shape/type
    // without consuming linear values from identifier reads.
    fn check_expr_list_no_type_no_linear_consume(self, opt: Option<Box<ExprList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.suppress_linear_consume_depth = c.suppress_linear_consume_depth + 1
        c = c.check_expr_list_no_type(opt)
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        c
    }

    // --------------------------------------------------------
    // If expression
    // --------------------------------------------------------

    fn check_if_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        c.check_if_with_cond_type(e, cond_ty)
    }

    // Tail of check_if_expr split out so the *mut spine (checker_check_if_expr_inplace)
    // checks the CONDITION via the *mut spine — routing a nested enum path-expr (e.g.
    // `if c == Color::Red`) to the in-place handler that dodges the by-value check_path_expr
    // crash — then bridges here for the branch / type-compat work (faithful verbatim move).
    fn check_if_with_cond_type(self, e: Expr, cond_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Condition must be bool
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // ── Condition narrowing ──────────────────────────────────────────────
        // Attempt to extract a refinement predicate from the `if` condition so
        // the then-branch can prove refinement requirements without Z3.
        // E.g.: `if x > 0 { f(x as Pos) }` — we push `x > 0` as a guard.
        // The saved env is restored after both branches so guards don't leak.
        let saved_cond_env = c.refine_cond_env
        let cond_guard = if_cond_extract_pred(e.left)
        if cond_guard.0 != 0 {
            c.refine_cond_env = refine_static_env_push(c.refine_cond_env, cond_guard.1)
        }
        // Check then block (with narrowed env)
        let then_pair = c.check_opt_block(e.block)
        c = then_pair.0
        let then_ty = then_pair.1
        // Restore env before else branch (negation narrowing is not yet implemented
        // — the safe choice is no narrowing in the else branch).
        c.refine_cond_env = saved_cond_env
        // Check else
        match e.else_expr {
            Some(else_e) => {
                let else_pair = c.check_expr(*else_e)
                c = else_pair.0
                let else_ty = else_pair.1
                // Restore after else branch
                c.refine_cond_env = saved_cond_env
                if !c.types_compatible_structural(then_ty, else_ty) {
                    c = c.report_mismatch(e.span, 7, then_ty, else_ty)
                }
                (c, then_ty)
            }
            None => {
                c.refine_cond_env = saved_cond_env
                (c, ty_unit())
            }
        }
    }
    fn check_opt_block(self, opt: Option<Box<Block> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.check_block(*blk)
            None => (self, ty_unit())
        }
    }

    // --------------------------------------------------------
    // Match expression
    // --------------------------------------------------------

    fn check_match_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let scrut_pair = self.check_opt_expr(e.left)
        var c = scrut_pair.0
        let scrut_ty = scrut_pair.1
        c.check_match_arms(e.arms, scrut_ty)
    }

    fn check_match_arms(self, opt: Option<Box<MatchArmList> >, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let first_ty = pair.1
                c = c.check_remaining_arms((*list).tail, scrut_ty, first_ty)
                (c, first_ty)
            }
            None => (self, ty_unit())
        }
    }

    fn check_match_arm(self, arm: MatchArm, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c = c.bind_pattern(arm.pattern, scrut_ty)
        let pair = c.check_expr(arm.body)
        c = pair.0
        let body_ty = pair.1
        c = c.require_current_linear_scope_consumed()
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, body_ty)
    }

    fn check_remaining_arms(self, opt: Option<Box<MatchArmList> >, scrut_ty: TypeEntry, expected_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let arm_ty = pair.1
                if !c.types_compatible_structural(arm_ty, expected_ty) {
                    c = c.report_mismatch((*list).head.span, 18, expected_ty, arm_ty)
                }
                c.check_remaining_arms((*list).tail, scrut_ty, expected_ty)
            }
            None => self
        }
    }

    fn bind_pattern(self, pat: Pattern, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatternKind::PatWildcard => self
            PatternKind::PatBinding => {
                var c = self
                c.env = c.env.bind(pat.name, scrut_ty, pat.is_mut)
                c = c.const_int_bind_unknown(pat.name)
                // Track pattern binding for borrow checking (linear if type is linear)
                let lin = c.is_linear_type(scrut_ty)
                c.borrows = c.borrows.track(pat.name, lin)
                c
            }
            PatternKind::PatIntLit => self
            PatternKind::PatBoolTrue => self
            PatternKind::PatBoolFalse => self
            PatternKind::PatStringLit => self
            PatternKind::PatEnum => {
                // Enum variant pattern — bind sub-patterns with scrut_ty
                // (variant field types not tracked yet, use scrut_ty as fallback)
                self.bind_pattern_list(pat.sub_patterns, scrut_ty)
            }
            PatternKind::PatStruct => {
                // Struct destructuring — bind field patterns with their field types
                self.bind_struct_pat_fields(pat.pat_fields, scrut_ty)
            }
            PatternKind::PatTuple => self.bind_tuple_pattern_list(pat.sub_patterns, scrut_ty)
            PatternKind::PatOr => self.bind_pattern_list(pat.sub_patterns, scrut_ty)
        }
    }

    fn bind_pattern_list(self, opt: Option<Box<PatternList> >, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.bind_pattern((*list).head, scrut_ty)
                c.bind_pattern_list((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_struct_pat_fields(self, opt: Option<Box<PatFieldList> >, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                // Look up the field type from either a struct or enum variant
                var field_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyNamed {
                    // First try: look up as struct
                    let struct_idx = struct_table_find(c.structs, scrut_ty.name)
                    if struct_idx >= 0 {
                        let si = struct_table_get(c.structs, struct_idx)
                        field_ty = field_info_list_find(si.fields, (*list).head.name)
                    } else {
                        // Second try: look up as enum — find which variant has this field
                        let enum_idx = enum_table_find(c.enums, scrut_ty.name)
                        if enum_idx >= 0 {
                            let ei = enum_table_get(c.enums, enum_idx)
                            // Search all variants for one that has this field
                            field_ty = variant_fields_find_field(ei.variants, (*list).head.name)
                        }
                    }
                }
                c = c.bind_pattern((*list).head.pattern, field_ty)
                c.bind_struct_pat_fields((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_tuple_pattern_list(self, opt: Option<Box<PatternList> >, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        // For tuple patterns, assign each sub-pattern the corresponding tuple element type
        self.bind_tuple_pattern_list_idx(opt, scrut_ty, 0)
    }

    fn bind_tuple_pattern_list_idx(self, opt: Option<Box<PatternList> >, scrut_ty: TypeEntry, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var elem_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyTuple {
                    elem_ty = type_entry_list_get(scrut_ty.tuple_elems, idx)
                }
                var c = self.bind_pattern((*list).head, elem_ty)
                c.bind_tuple_pattern_list_idx((*list).tail, scrut_ty, idx + 1)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // While, Loop, Block, Return
    // --------------------------------------------------------

    fn check_break_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 44, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_continue_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 45, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_for_in_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check iterator expression (range)
        let iter_pair = self.check_opt_expr(e.left)
        var c = iter_pair.0
        // Push scope for loop variable
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c.env = c.env.bind(e.name, ty_i64(), false)
        c.loop_depth = c.loop_depth + 1
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, ty_unit())
    }

    fn check_while_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body.
        // In a while loop, each iteration may re-borrow the same variables.
        // Without this, the second iteration would fail because the first
        // iteration's exclusive borrows are still active.
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_loop_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body (same as while loops)
        c.borrows = c.borrows.release_exclusive_borrows()
        let pair = c.check_opt_block(e.block)
        c = pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_block_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_block(e.block)
    }

    fn check_return_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let val_ty = pair.1
        match e.left {
            Some(val_expr) => {
                if !checker_contextual_expr_compatible(*val_expr, val_ty, c.current_return_type) {
                    c = c.report_mismatch(e.span, 8, c.current_return_type, val_ty)
                }
            }
            None => {
                if !c.types_compatible_structural(val_ty, c.current_return_type) {
                    c = c.report_mismatch(e.span, 8, c.current_return_type, val_ty)
                }
            }
        }
        (c, ty_never())
    }

    // --------------------------------------------------------
    // Struct literal
    // --------------------------------------------------------

    fn check_struct_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let struct_name = checker_copy_string_list_to_name(e.path.segments)
        let struct_idx = struct_table_find(self.structs, struct_name)
        if struct_idx >= 0 {
            let si = struct_table_get(self.structs, struct_idx)
            if self.enforce_visibility && !visibility_allows_access(si.visibility, si.defining_module, self.current_module, self.crate_root) {
                let c = self.report_error_at(e.span, 176, 0, 0, 0)
                return (c, ty_named(struct_name))
            }
            if si.is_generic_template {
                // Generic struct: infer type params from field initializers
                self.check_generic_struct_lit(e, si)
            } else {
                var c = self.check_struct_field_inits(e.fields, si, e.span)
                (c, ty_named(struct_name))
            }
        } else {
            if name_eq(struct_name, make_name("Knowledge")) {
                return self.check_knowledge_struct_lit(e)
            }
            var c = self.report_error_at(e.span, 15, 0, 0, 0)
            c = c.check_struct_field_inits_no_type(e.fields)
            (c, ty_error())
        }
    }

    fn check_knowledge_struct_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cur = e.fields
        var seen_value = false
        var value_ty = ty_error()
        while true {
            match cur {
                Some(list) => {
                    let pair = c.check_expr((*list).head.value)
                    c = pair.0
                    if name_eq((*list).head.name, make_name("value")) {
                        value_ty = pair.1
                        seen_value = true
                    }
                    cur = (*list).tail
                }
                None => break
            }
        }
        if !seen_value {
            c = c.report_error_at(e.span, 12, 0, 0, 0)
            return (c, ty_error())
        }
        (c, ty_knowledge(value_ty, 0.0 - 1.0))
    }

    fn check_generic_struct_lit(self, e: Expr, tmpl: StructInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Infer type arguments from field initializers, then monomorphize.
        var inferred = InferBuf { args: [ty_error(); 8] }
        let pair = self.infer_type_params_from_fields(e.fields, tmpl, inferred)
        var c = pair.0
        inferred = pair.1
        c.finalize_generic_struct_lit(e, tmpl, inferred.args)
    }

    fn infer_type_params_from_fields(self, opt: Option<Box<StructFieldList> >, tmpl: StructInfo, acc: InferBuf) -> (Checker, InferBuf) with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => (self, acc)
            Some(fl) => {
                let field_name = (*fl).head.name
                let tmpl_field_ty = field_info_list_find(tmpl.fields, field_name)
                let pair = self.check_expr((*fl).head.value)
                var c = pair.0
                let init_ty = pair.1

                // Bind direct (`v: F`) and one-level array (`c: [F; N]`)
                // type parameters. Other compound forms remain unclaimed.
                var buf = infer_bind_array_type_param(tmpl_field_ty, init_ty, &tmpl, acc)
                c.infer_type_params_from_fields((*fl).tail, tmpl, buf)
            }
        }
    }

    fn finalize_generic_struct_lit(self, e: Expr, tmpl: StructInfo, inferred_args: [TypeEntry; 8]) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Build the TypeEntryList from inferred args
        var args_list_opt: Option<Box<TypeEntryList> > = None
        var ai: i64 = tmpl.type_param_count - 1
        while ai >= 0 {
            args_list_opt = Some(Box::new(TypeEntryList { head: inferred_args[ai], tail: args_list_opt }))
            ai = ai - 1
        }

        match args_list_opt {
            None => (self, ty_error())
            Some(args_box) => {
                let args = *args_box
                let tmpl_name = tmpl.name
                let tmpl_fields = field_info_list_clone(&tmpl.fields)
                let tmpl_tp_buf = TypeParamBuf { names: tmpl.type_param_names, count: tmpl.type_param_count }
                let tmpl_is_linear = tmpl.is_linear
                let tmpl_visibility_kind = tmpl.visibility_kind
                let tmpl_defining_module_id = tmpl.defining_module_id
                let tmpl_visibility = tmpl.visibility
                let tmpl_defining_module = tmpl.defining_module
                // Build mangled name
                let mangled = mangle_generic_name(&tmpl_name, &args)

                // Check if already monomorphized
                var c = self
                let existing_idx = struct_table_find(c.structs, mangled)
                if existing_idx < 0 {
                    // Monomorphize
                    let mono_fields = monomorphize_fields(tmpl_fields, tmpl_tp_buf, &args)
                    let mono_info = StructInfo {
                        name: mangled,
                        fields: mono_fields.0,
                        field_count: mono_fields.1,
                        is_linear: tmpl_is_linear,
                    type_param_count: 0,
                    type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
                    is_generic_template: false,
                    visibility_kind: tmpl_visibility_kind,
                    defining_module_id: tmpl_defining_module_id,
                    visibility: tmpl_visibility,
                    defining_module: tmpl_defining_module,
                    }
                    struct_table_add(c.structs, mono_info)
                }

                // Now validate fields against the monomorphized struct
                let mono_idx = struct_table_find(c.structs, mangled)
                if mono_idx >= 0 {
                    let mono_si = struct_table_get(c.structs, mono_idx)
                    c = c.check_struct_field_inits(e.fields, mono_si, e.span)
                }
                (c, ty_named(mangled))
            }
        }
    }

    fn check_struct_field_inits(self, opt: Option<Box<StructFieldList> >, si: StructInfo, lit_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let init_count = struct_field_list_count(opt)
        if init_count != si.field_count {
            return self.report_error_at(lit_span, 46, 0, 0, 0)
        }
        self.check_struct_field_inits_with_type(opt, si)
    }

    fn check_struct_field_inits_with_type(self, opt: Option<Box<StructFieldList> >, si: StructInfo) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                let field_ty = field_info_list_find(si.fields, (*list).head.name)
                let pair = c.check_expr((*list).head.value)
                c = pair.0
                let init_ty = pair.1
                if !checker_contextual_expr_compatible((*list).head.value, init_ty, field_ty) {
                    c = c.report_mismatch((*list).head.value.span, 16, field_ty, init_ty)
                }
                c.check_struct_field_inits_with_type((*list).tail, si)
            }
            None => self
        }
    }

    fn check_struct_field_inits_no_type(self, opt: Option<Box<StructFieldList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head.value)
                var c = pair.0
                c.check_struct_field_inits_no_type((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Array literal
    // --------------------------------------------------------

    fn check_array_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match e.left {
            Some(elem_expr) => match e.right {
                Some(count_expr) => {
                    let elem_pair = self.check_expr(*elem_expr)
                    var c = elem_pair.0
                    let elem_ty = elem_pair.1
                    let count_pair = c.check_expr(*count_expr)
                    c = count_pair.0
                    let count_ty = count_pair.1
                    if !types_compatible(count_ty, ty_i64()) {
                        c = c.report_mismatch((*count_expr).span, 20, ty_i64(), count_ty)
                        return (c, ty_array(elem_ty, 0))
                    }
                    if (*count_expr).kind != ExprKind::ExprIntLit {
                        c = c.report_error_at((*count_expr).span, 20, 0, 0, 0)
                        return (c, ty_array(elem_ty, 0))
                    }
                    return (c, ty_array(elem_ty, (*count_expr).int_val))
                }
                None => ()
            }
            None => ()
        }

        let result = self.check_array_elems(e.args)
        let c = result.checker
        let elem_ty = result.ty
        let count = result.count
        (c, ty_array(elem_ty, count))
    }

    fn check_array_elems(self, opt: Option<Box<ExprList> >) -> CheckArrayElemsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let first_ty = pair.1
                let rest = c.check_array_rest((*list).tail, first_ty)
                CheckArrayElemsResult {
                    checker: rest.checker,
                    ty: first_ty,
                    count: (1 as i64) + rest.count,
                }
            }
            None => CheckArrayElemsResult {
                checker: self,
                ty: ty_error(),
                count: 0,
            }
        }
    }

    fn check_array_rest(self, opt: Option<Box<ExprList> >, expected: TypeEntry) -> CheckArrayRestResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let elem_ty = pair.1
                if !types_compatible(elem_ty, expected) {
                    c = c.report_mismatch((*list).head.span, 20, expected, elem_ty)
                }
                let rest = c.check_array_rest((*list).tail, expected)
                CheckArrayRestResult { checker: rest.checker, count: (1 as i64) + rest.count }
            }
            None => CheckArrayRestResult { checker: self, count: 0 }
        }
    }

    // --------------------------------------------------------
    // Tuple literal
    // --------------------------------------------------------

    fn check_tuple_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_tuple_elems(e.args)
        let c = pair.checker
        match pair.elems {
            Some(elem_list) => (c, ty_tuple(*elem_list))
            None => (c, ty_unit())
        }
    }

    fn check_tuple_elems(self, opt: Option<Box<ExprList> >) -> CheckTupleElemsResult with Mut, Panic, Div, Alloc, IO {
        // Iterative: collect element types into array, then build list in reverse.
        // Avoids recursive Checker copies that overflow the SOBC VM stack.
        var c = self
        var types: [TypeEntry; 16] = [empty_type_entry(); 16]
        var count: i64 = 0
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    if count < 16 {
                        let pair = c.check_expr((*list).head)
                        c = pair.0
                        types[count] = pair.1
                        count = count + 1
                        cur = (*list).tail
                    } else {
                        done = true
                    }
                }
                None => {
                    done = true
                }
            }
        }
        if count == 0 {
            return CheckTupleElemsResult { checker: c, elems: None }
        }
        // Build TypeEntryList in reverse order (last element first)
        var result: Option<Box<TypeEntryList> > = None
        var j = count - 1
        while j >= 0 {
            result = Some(Box::new(TypeEntryList { head: types[j], tail: result }))
            j = j - 1
        }
        CheckTupleElemsResult { checker: c, elems: result }
    }

    // --------------------------------------------------------
    // Range expression
    // --------------------------------------------------------

    fn check_range_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1
        // Range endpoints must be integer types
        if !is_error_or_unknown(left_ty) && !is_integer_type(left_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), left_ty)
        }
        if !is_error_or_unknown(right_ty) && !is_integer_type(right_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), right_ty)
        }
        (c, ty_unit())
    }

    fn check_cast_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let src_ty = pair.1
        // Resolve the target type from the cast_type annotation
        match e.cast_type {
            Some(ty) => {
                let ty_pair = c.lower_type_expr(*ty)
                c = ty_pair.0
                let target_ty = ty_pair.1
                if is_wide_float_type(src_ty) || is_wide_float_type(target_ty) {
                    c = c.report_error_at(e.span, 248, 0, 0, 0)
                    return (c, ty_error())
                }
                // Epistemic enforcement: cannot cast Knowledge<T> to T via `as`
                let src_is_epistemic = src_ty.kind == TypeKind::TyKnowledge
                    || src_ty.kind == TypeKind::TyIntervention
                    || src_ty.kind == TypeKind::TyCounterfactual
                    || src_ty.kind == TypeKind::TyValidated
                let tgt_is_epistemic = target_ty.kind == TypeKind::TyKnowledge
                    || target_ty.kind == TypeKind::TyIntervention
                    || target_ty.kind == TypeKind::TyCounterfactual
                    || target_ty.kind == TypeKind::TyValidated
                if src_is_epistemic && !tgt_is_epistemic {
                    c = c.report_error_at(e.span, 171, 0, 0, 0)
                }
                // Unit conversion check: if both are unit-typed, dimensions must be compatible
                if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
                    let src_dim = c.units.get_dim(src_ty.unit_id)
                    let tgt_dim = c.units.get_dim(target_ty.unit_id)
                    if !unit_dim_compatible(src_dim, tgt_dim) {
                        c = c.report_error_at(e.span, 43, 0, 0, 0)
                    }
                }
                (c, target_ty)
            }
            None => (c, ty_error())
        }
    }

    fn check_handle_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // handle<Effect> { body } with { handlers }
        // The handler discharges the named effect within the body.
        var c = self

        // Resolve the effect name to an ID
        var eff_name_buf: [i8; 64] = [0; 64]
        var i: i64 = 0
        while i < e.name.len && i < 64 {
            eff_name_buf[i as usize] = e.name.buf[i as usize]
            i = i + 1
        }
        let eff_id = effect_name_to_id(eff_name_buf, e.name.len)

        // Add the handled effect to the current effects (body may use it)
        var saved_effects = c.current_effects
        var saved_count = c.current_effect_count
        if eff_id >= 0 && c.current_effect_count < 8 {
            if !has_effect_id(c.current_effects, c.current_effect_count, eff_id) {
                c.current_effects[c.current_effect_count as usize] = eff_id
                c.current_effect_count = c.current_effect_count + 1
            }
        }

        // Check the body block
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        let body_ty = body_pair.1

        // Restore original effects (handler discharges the effect)
        c.current_sig_id = 0 - 1
        c.current_effects = saved_effects
        c.current_effect_count = saved_count

        // Check the handler block (with { ... }) if present
        match e.handler_block {
            Some(hb) => {
                let hpair = c.check_block(*hb)
                c = hpair.0
            }
            None => {}
        }

        (c, body_ty)
    }

    // --------------------------------------------------------
    // Closure expression checking with effect inference
    // --------------------------------------------------------

    fn check_closure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self

        // Convert closure params to FnParamList for signature
        let params_result = c.collect_closure_params(e.closure_params)
        c = params_result.checker
        let params = params_result.params
        let param_count = params_result.count

        // Lower return type annotation (if present) or use unknown
        let ret_pair = c.lower_opt_closure_return(e.closure_return)
        c = ret_pair.0
        let ret_ty = ret_pair.1

        // Save current effects, clear for inference
        let saved_effects = c.current_effects
        let saved_effect_count = c.current_effect_count
        c.current_effects = [0; 8]
        c.current_effect_count = 0

        // Push scope for parameters
        let outer_borrow_count = c.borrows.count
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()

        // Bind closure params in environment
        c = c.bind_closure_params(e.closure_params)
        var capture_candidates: [bool; 128] = [false; 128]
        var capture_seed_i: i64 = 0
        while capture_seed_i < outer_borrow_count {
            let entry = c.borrows.entries[capture_seed_i as usize]
            capture_candidates[capture_seed_i as usize] = entry.is_linear && !entry.consumed
            capture_seed_i = capture_seed_i + 1
        }

        // Check body expression
        let body_pair = c.check_opt_expr(e.closure_body)
        c = body_pair.0
        let body_ty = body_pair.1

        // Infer return type from body if not annotated
        let inferred_ret_ty = if ret_ty.kind == TypeKind::TyUnknown {
            body_ty
        } else {
            ret_ty
        }

        // Check body type against return type if annotated
        if ret_ty.kind != TypeKind::TyUnknown {
            if !c.types_compatible_structural(body_ty, ret_ty) {
                c = c.report_mismatch(e.span, 8, ret_ty, body_ty)
            }
        }

        // Get inferred effects from current_effects
        var inferred_effects = c.current_effects
        var inferred_effect_count = c.current_effect_count

        // An outer linear binding is captured exactly when checking the closure body
        // transfers it from owned to consumed. Closure parameters start after this range.
        var capture_linear = false
        var capture_linear_count: i64 = 0
        var capture_i: i64 = 0
        while capture_i < outer_borrow_count {
            let after = c.borrows.entries[capture_i as usize]
            if capture_candidates[capture_i as usize] && after.consumed {
                capture_linear = true
                capture_linear_count = capture_linear_count + 1
            }
            capture_i = capture_i + 1
        }

        // Pop scope
        c = c.require_current_linear_scope_consumed()
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()

        // Restore outer effects context
        c.current_sig_id = 0 - 1
        c.current_effects = saved_effects
        c.current_effect_count = saved_effect_count

        // Epistemic capture inference remains conservative over visible outer bindings.
        var capture_epsilon: f64 = 0.0 - 1.0
        var ci: i64 = 0
        let env_count = c.env.count
        while ci < env_count {
            let binding = c.env.bindings[ci as usize]
            let binding_ty = binding.ty
            if binding_ty.kind == TypeKind::TyKnowledge {
                let eps = binding_ty.knowledge_epsilon
                if eps >= 0.0 {
                    if capture_epsilon < 0.0 {
                        capture_epsilon = eps
                    } else {
                        capture_epsilon = capture_epsilon + eps
                    }
                }
            }
            ci = ci + 1
        }
        // Sprint 231: Auto-inject Epistemic effect if Knowledge values captured
        if capture_epsilon >= 0.0 {
            var has_epistemic = false
            var ei: i64 = 0
            while ei < inferred_effect_count {
                if inferred_effects[ei] == 8 { has_epistemic = true }
                ei = ei + 1
            }
            if !has_epistemic && inferred_effect_count < 8 {
                inferred_effects[inferred_effect_count] = 8
                inferred_effect_count = inferred_effect_count + 1
            }
        }
        // Create FnSig with inferred effects + capture metadata
        let closure_sig = FnSig {
            name: Name { buf: [0; 128], len: 0 },  // Anonymous closure
            params: params,
            param_count: param_count,
            return_type: inferred_ret_ty,
            is_method: false,
            self_type_name: Name { buf: [0; 128], len: 0 },
            self_type_entry: ty_unit(),
            effects: inferred_effects,
            effect_count: inferred_effect_count,
            is_kernel: false,
            is_epistemic_kernel: false,
            is_extern: false,
            is_linear_closure: capture_linear,
            linear_capture_count: capture_linear_count,
            epistemic_epsilon: capture_epsilon,
            epistemic_min_confidence: 0 - 1,
            visibility_kind: VISIBILITY_PRIVATE,
            defining_module_seg_count: c.current_module.seg_count,
            defining_module_id: c.current_module_id,
            visibility: visibility_private(),
            defining_module: c.current_module,
        }

        // Add to fn_sigs table
        let sig_id = fn_sig_table_add(c.fn_sigs, closure_sig)

        (c, ty_fn(sig_id))
    }

    fn collect_closure_params(self, opt: Option<Box<ClosureParamList> >) -> CollectClosureParamsResult with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_closure_param_list(*pl)
                CollectClosureParamsResult { checker: pair.checker, params: Some(Box::new(pair.list)), count: pair.count }
            }
            None => CollectClosureParamsResult { checker: self, params: None, count: 0 }
        }
    }

    fn collect_closure_param_list(self, pl: ClosureParamList) -> CollectClosureParamListResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => CollectClosureParamListResult { checker: c, list: head_list, count: 1 }
            Some(rest) => {
                let rest_result = c.collect_closure_param_list(*rest)
                c = rest_result.checker
                let rest_list = rest_result.list
                let rest_count = rest_result.count
                CollectClosureParamListResult { checker: c, list: FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, count: 1 + rest_count }
            }
        }
    }

    fn bind_closure_params(self, opt: Option<Box<ClosureParamList> >) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_closure_param((*pl).head)
                c.bind_closure_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_closure_param(self, p: ClosureParam) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        let pair = c.lower_type_expr(p.ty)
        c = pair.0
        let param_ty = pair.1
        c.env = c.env.bind(p.name, param_ty, false)
        c = c.const_int_bind_unknown(p.name)
        let lin = c.is_linear_type(param_ty)
        c.borrows = c.borrows.track(p.name, lin)
        c
    }

    fn lower_opt_closure_return(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }
}

fn transition_metric_to_candidate_metric(metric_id: i64) -> i64 {
    if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
        ALTERNATIVE_METRIC_INTERVENTION_COST
    } else if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
        ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK
    } else if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
        ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE
    } else if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
        ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN
    } else {
        -1
    }
}

fn transition_metric_is_candidate(metric_id: i64) -> bool {
    metric_id == TRANSITION_METRIC_INTERVENTION_COST
    || metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK
    || metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE
    || metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN
}

fn alternative_metric_name(metric_id: i64) -> Name with Mut, Panic, Div {
    if metric_id == ALTERNATIVE_METRIC_INTERVENTION_COST {
        make_name("intervention_cost")
    } else if metric_id == ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK {
        make_name("residual_tail_risk")
    } else if metric_id == ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE {
        make_name("mechanistic_divergence")
    } else if metric_id == ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN {
        make_name("admissibility_margin")
    } else {
        make_name("unknown_metric")
    }
}

// ============================================================
// Struct field list helper
// ============================================================

fn struct_field_list_count(opt: Option<Box<StructFieldList> >) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + struct_field_list_count((*list).tail)
    }
}

// ============================================================
// Static refinement: condition guard extraction
// ============================================================
//
// Extract a RefinementPred from a simple boolean expression used as an `if`
// condition.  Recognised forms:
//   <ident> > <int_lit>    →  pred_gt(ident, n)
//   <ident> >= <int_lit>   →  pred_gt_eq(ident, n)
//   <ident> < <int_lit>    →  pred_lt(ident, n)
//   <ident> <= <int_lit>   →  pred_lt_eq(ident, n)
//   <ident> == <int_lit>   →  pred_eq(ident, n)
//   <ident> != <int_lit>   →  pred_neq(ident, n)
//
// Returns (true, pred) on success, (false, _) when the form is unrecognised.
// Handles atomic comparisons (x > 0), AND conjunctions (x > 0 && x < 100),
// and OR disjunctions (x < 0 || x > 100) by recursing on both sides.
// Partial extraction: if only one side of a compound is recognisable, that
// side's predicate is returned (conservative but sound under-approximation).
fn if_cond_extract_pred(opt: Option<Box<Expr> >) -> (i64, RefinementPred) with Mut, Panic, Div, Alloc {
    let no_pred = (0, empty_refinement_pred())
    match opt {
        None => no_pred
        Some(e) => {
            let expr = *e
            if expr.kind != ExprKind::ExprBinary {
                return no_pred
            }
            // Compound conditions: recurse on both sides and combine.
            if expr.bin_op == BinaryOp::OpAnd || expr.bin_op == BinaryOp::OpOr {
                let left_pair  = if_cond_extract_pred(expr.left)
                let right_pair = if_cond_extract_pred(expr.right)
                let found_l = left_pair.0
                let pred_l  = left_pair.1
                let found_r = right_pair.0
                let pred_r  = right_pair.1
                if found_l != 0 && found_r != 0 {
                    let combined = if expr.bin_op == BinaryOp::OpAnd {
                        pred_and(pred_l, pred_r)
                    } else {
                        pred_or(pred_l, pred_r)
                    }
                    return (1, combined)
                }
                if found_l != 0 { return (1, pred_l) }
                if found_r != 0 { return (1, pred_r) }
                return no_pred
            }
            // LHS must be an identifier
            let lhs_ok = match expr.left {
                Some(lhs_e) => (*lhs_e).kind == ExprKind::ExprIdent
                None => false
            }
            if !lhs_ok {
                return no_pred
            }
            let lhs_name = match expr.left {
                Some(lhs_e) => (*lhs_e).name
                None => Name { buf: [0; 128], len: 0 }
            }
            // RHS must be an integer literal
            let rhs_ok = match expr.right {
                Some(rhs_e) => (*rhs_e).kind == ExprKind::ExprIntLit
                None => false
            }
            if !rhs_ok {
                return no_pred
            }
            let rhs_val = match expr.right {
                Some(rhs_e) => (*rhs_e).int_val
                None => 0
            }
            // Map BinaryOp → refinement_op
            let op = if expr.bin_op == BinaryOp::OpGt {
                refinement_op_gt()
            } else if expr.bin_op == BinaryOp::OpGe {
                refinement_op_gt_eq()
            } else if expr.bin_op == BinaryOp::OpLt {
                refinement_op_lt()
            } else if expr.bin_op == BinaryOp::OpLe {
                refinement_op_lt_eq()
            } else if expr.bin_op == BinaryOp::OpEq {
                refinement_op_eq()
            } else if expr.bin_op == BinaryOp::OpNe {
                refinement_op_neq()
            } else {
                refinement_op_none()
            }
            if op == refinement_op_none() {
                return no_pred
            }
            (1, pred_make_int(op, lhs_name, rhs_val))
        }
    }
}

// Multiplication laws of an algebra declaration, read straight from the AST op list
// (first `mul:` line wins; no `mul:` line = associative, not alternative, matching
// `empty_algebra_info`). Recursive like collect_algebra_ops. Used by collect_algebra_def for
// the E252 order-fabrication check and the fail-closed reassociation default.
fn checker_algebra_def_mul_assoc(ops: Option<Box<AlgebraOpDeclList> >) -> bool with Mut, Panic, Div {
    match ops {
        None => true
        Some(list) => {
            let op = (*list).head
            if op.op_name.len == 3 && op.op_name.buf[0] == 109 as i8 { return op.is_associative }
            checker_algebra_def_mul_assoc((*list).tail)
        }
    }
}
fn checker_algebra_def_mul_alt(ops: Option<Box<AlgebraOpDeclList> >) -> bool with Mut, Panic, Div {
    match ops {
        None => false
        Some(list) => {
            let op = (*list).head
            if op.op_name.len == 3 && op.op_name.buf[0] == 109 as i8 { return op.is_alternative }
            checker_algebra_def_mul_alt((*list).tail)
        }
    }
}
