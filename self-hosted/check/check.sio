// Read-only GPU thread/block coordinate intrinsics. These are implicit
// kernel-scope builtins with no user-declared signature, so the call checker
// must recognise them by name and assign their result type directly —
// otherwise the callee ident falls through to the unbound-identifier check
// (E137) just as the name resolver would reject it without its allowlist.
// MUST stay in sync with name_is_gpu_builtin() in self-hosted/resolve/resolve.sio
// and token_is_gpu_builtin_name() in self-hosted/compiler/lean_single.sio.
// The subset of call_expr_is_gpu_builtin names that are void barriers (return
// unit), as opposed to the thread-index/dim coordinate reads (return i64).
fn call_expr_is_gpu_barrier(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            let n = (*expr).name
            if name_eq(n, make_name("gpu_barrier")) { return true }
            if name_eq(n, make_name("gpu_barrier_sync")) { return true }
            if name_eq(n, make_name("gpu_sync_threads")) { return true }
            false
        }
        None => false
    }
}

// syscall6(nr, a1..a6): raw Linux syscall escape hatch, implicit builtin with
// no user-declared signature (same recognition-by-name pattern as the GPU
// intrinsics above). MUST stay in sync with the lowering arm in
// self-hosted/ir/lower.sio (lower_call_expr_ref) and the codegen builtin in
// self-hosted/native/codegen_x86_linux.sio (emit_builtin_syscall6_into).
fn call_expr_is_syscall6(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_eq((*expr).name, make_name("syscall6"))
        }
        None => false
    }
}

// #1622: the names the native backend implements for a body-less function.
//
// MIRROR of native_v2_builtin_id_for_func_ref in
// self-hosted/native/codegen_x86_linux.sio (~:1116), which is the authority:
// it maps an instr_count == 0 IrFunction to a builtin id 1..27, and returns 0 —
// "emit nothing" — for every other name. An `extern "C"` declaration reaches
// codegen as exactly such a stub (ir/lower.sio:3498 flushes it that way), so a
// name absent from this list compiles to an empty function and every call to it
// silently reads 0. That is what this list exists to refuse.
//
// Kept in sync by scripts/ci/extern_builtin_mirror_gate.sh, which diffs the two
// lists and fails if they drift. Verified empirically as well: of 19 non-listed
// extern names probed under Madaros (fabs, pow, floor, ceil, malloc, getpid,
// tgamma, ...) all 19 returned 0, and heap_alloc — listed but dispatched
// elsewhere — returned a real pointer.
// #2164: bound for checking, absent from the backend.
//
// checker_bind_import_unknown_inplace binds these five so a multi-module program
// does not trip E137 on them, exactly as it does for sin/cos/exp. The difference
// is that sin/cos/exp have builtin ids and these do not: native_v2_builtin_id_
// for_func_ref -- which the comment above calls the authority -- maps neither
// tan, atan, tanh, asin nor acos. A call therefore typechecks, compiles to an
// ELF, and dies on an illegal instruction at run time. `print_f64(atan(0.5))`
// alone is enough; measured rc=132 on all five.
//
// Refusing is the honest answer until the backend emits them. Each needs a
// hand-written x86-64 kernel with its own range reduction, the way
// emit_builtin_sin already is -- and a subtly wrong one would be worse than the
// crash, which at least announces itself.
//
// This refuses ONLY the unresolved bare name: a program that DEFINES the
// function resolves through direct_sig_id and never reaches the check, which is
// why the whole stdlib is unaffected -- measured, 2 files refused across
// stdlib+tests+examples, and both are the known-broken ones.
//
// The help line points at stdlib/math/pure.sio, whose implementations are
// correct (verified: copied verbatim under another name, atan(0.5) = 0.463648).
// They were not `pub` until this change, so importing them failed with E175 and
// the refusal would have been a dead end -- measured, not assumed.
fn name_is_unimplemented_native_math(n: Name) -> bool with Mut, Panic, Div, Alloc, IO {
    if name_eq(n, make_name("tan")) { return true }
    if name_eq(n, make_name("atan")) { return true }
    if name_eq(n, make_name("tanh")) { return true }
    if name_eq(n, make_name("asin")) { return true }
    if name_eq(n, make_name("acos")) { return true }
    false
}

fn name_is_native_backend_builtin(n: Name) -> bool with Mut, Panic, Div, Alloc, IO {
    if name_eq(n, make_name("print_int")) { return true }        // id 1
    if name_eq(n, make_name("print_char")) { return true }       // id 2
    if name_eq(n, make_name("print")) { return true }            // id 3
    if name_eq(n, make_name("get_arg_count")) { return true }    // id 4
    if name_eq(n, make_name("get_arg")) { return true }          // id 5
    if name_eq(n, make_name("str_len")) { return true }          // id 6
    if name_eq(n, make_name("str_eq")) { return true }           // id 7
    if name_eq(n, make_name("str_slice")) { return true }        // id 8
    if name_eq(n, make_name("starts_with")) { return true }      // id 9
    if name_eq(n, make_name("str_concat")) { return true }       // id 10
    if name_eq(n, make_name("read_file")) { return true }        // id 11
    if name_eq(n, make_name("write_file")) { return true }       // id 12
    if name_eq(n, make_name("file_size")) { return true }        // id 13
    if name_eq(n, make_name("sqrt")) { return true }             // id 14
    if name_eq(n, make_name("print_f64")) { return true }        // id 15
    if name_eq(n, make_name("exp")) { return true }              // id 16
    if name_eq(n, make_name("log")) { return true }              // id 17
    if name_eq(n, make_name("sin")) { return true }              // id 18
    if name_eq(n, make_name("cos")) { return true }              // id 19
    if name_eq(n, make_name("str_char_at")) { return true }      // id 20
    if name_eq(n, make_name("assert")) { return true }           // id 21
    if name_eq(n, make_name("str_from_bytes")) { return true }   // id 22
    if name_eq(n, make_name("heap_alloc")) { return true }       // id 23
    if name_eq(n, make_name("heap_free")) { return true }        // id 24
    if name_eq(n, make_name("f64_to_bits")) { return true }      // id 25
    if name_eq(n, make_name("bits_to_f64")) { return true }      // id 26
    if name_eq(n, make_name("syscall6")) { return true }         // id 27
    // P0-F allowlisted POSIX externs. Adding a name here REMOVES the E250
    // fail-closed guard for it, so each MUST have a working native emitter in
    // codegen_x86_linux.sio (native_v2_emit_builtin_by_id_into + the two
    // name-based emit blocks) or it silently returns a fabricated 0. Per-name
    // EXECUTION witnesses gate this in CI.
    if name_eq(n, make_name("malloc")) { return true }           // id 23 (heap_alloc)
    if name_eq(n, make_name("free")) { return true }             // id 24 (heap_free)
    if name_eq(n, make_name("getpid")) { return true }           // id 28
    if name_eq(n, make_name("getppid")) { return true }          // id 29
    if name_eq(n, make_name("exit")) { return true }             // id 30
    if name_eq(n, make_name("abort")) { return true }            // id 31
    if name_eq(n, make_name("system")) { return true }           // id 32
    // Defect A: raw pointer-indexed accessor family (see check.sio's
    // checker_collect_runtime_builtins_inplace and codegen_x86_linux.sio's
    // emit_builtin_read_offset64_into / emit_builtin_write_offset64_into).
    if name_eq(n, make_name("read_i64")) { return true }         // id 33
    if name_eq(n, make_name("write_i64")) { return true }        // id 34
    if name_eq(n, make_name("read_f64")) { return true }         // id 35
    if name_eq(n, make_name("write_f64")) { return true }        // id 36
    if name_eq(n, make_name("acknowledge")) { return true }      // id 37
    if name_eq(n, make_name("require_confidence")) { return true } // id 38
    // libm names this backend answers with an exact hardware instruction:
    // sqrt (id 14, already allowlisted above as a plain builtin) plus these
    // two. Both are ROUNDSD with an explicit rounding mode, correctly rounded
    // by the ISA including -0.0, the infinities and NaN, so neither carries an
    // error budget. pow and tgamma are deliberately NOT here -- they are
    // approximations and belong behind their own witnesses.
    if name_eq(n, make_name("floor")) { return true }            // id 47
    if name_eq(n, make_name("ceil")) { return true }             // id 48
    // pow and tgamma. These two ARE approximations, so the paragraph above
    // deliberately excluded them; they are listed now because they finally
    // have emitters -- emit_builtin_ffi_pow / emit_builtin_ffi_tgamma in
    // native::math_ffi_emitters, wrapping the native::math_ffi kernels. The
    // oracle measures 0.76 ulp (pow) and 3.64 ulp (tgamma), so both still
    // belong behind their own reference vectors; what changes here is only
    // that a call no longer fabricates 0.
    if name_eq(n, make_name("pow")) { return true }              // id 49
    if name_eq(n, make_name("tgamma")) { return true }           // id 50
    if name_eq(n, make_name("__sounio_seq_push")) { return true } // id 51
    if name_eq(n, make_name("__sounio_seq_get")) { return true }  // id 52
    if name_eq(n, make_name("__sounio_seq_set")) { return true }  // id 53
    false
}

// Closed source-level ABI for unresolved native-backend builtins. These names
// are installed as TyUnknown by checker_collect_runtime_builtins_inplace, so
// without this table they never reach checker_check_call_args_inplace. Keep the
// default fail-closed: adding an implicit backend builtin without declaring its
// arity must produce E010 instead of silently dropping machine arguments.
fn native_backend_builtin_arity_is_valid(n: Name, argc: i64) -> bool with Mut, Panic, Div, Alloc, IO {
    if name_eq(n, make_name("str_slice")) {
        return argc == 2 || argc == 3
    }
    if argc == 0 {
        return name_eq(n, make_name("get_arg_count"))
            || name_eq(n, make_name("getpid"))
            || name_eq(n, make_name("getppid"))
            || name_eq(n, make_name("abort"))
    }
    if argc == 1 {
        return name_eq(n, make_name("print_int"))
            || name_eq(n, make_name("print_char"))
            || name_eq(n, make_name("print"))
            || name_eq(n, make_name("get_arg"))
            || name_eq(n, make_name("str_len"))
            || name_eq(n, make_name("read_file"))
            || name_eq(n, make_name("file_size"))
            || name_eq(n, make_name("sqrt"))
            || name_eq(n, make_name("print_f64"))
            || name_eq(n, make_name("exp"))
            || name_eq(n, make_name("log"))
            || name_eq(n, make_name("sin"))
            || name_eq(n, make_name("cos"))
            || name_eq(n, make_name("assert"))
            || name_eq(n, make_name("heap_alloc"))
            || name_eq(n, make_name("heap_free"))
            || name_eq(n, make_name("f64_to_bits"))
            || name_eq(n, make_name("bits_to_f64"))
            || name_eq(n, make_name("malloc"))
            || name_eq(n, make_name("free"))
            || name_eq(n, make_name("exit"))
            || name_eq(n, make_name("system"))
            || name_eq(n, make_name("floor"))
            || name_eq(n, make_name("ceil"))
            || name_eq(n, make_name("tgamma"))
    }
    if argc == 2 {
        return name_eq(n, make_name("str_eq"))
            || name_eq(n, make_name("starts_with"))
            || name_eq(n, make_name("str_concat"))
            || name_eq(n, make_name("str_char_at"))
            || name_eq(n, make_name("str_from_bytes"))
            || name_eq(n, make_name("read_i64"))
            || name_eq(n, make_name("read_f64"))
            || name_eq(n, make_name("acknowledge"))
            || name_eq(n, make_name("require_confidence"))
            || name_eq(n, make_name("pow"))
            || name_eq(n, make_name("__sounio_seq_push"))
            || name_eq(n, make_name("__sounio_seq_get"))
    }
    if argc == 3 {
        return name_eq(n, make_name("write_file"))
            || name_eq(n, make_name("write_i64"))
            || name_eq(n, make_name("write_f64"))
            || name_eq(n, make_name("__sounio_seq_set"))
    }
    if argc == 7 {
        return name_eq(n, make_name("syscall6"))
    }
    false
}

fn call_expr_is_gpu_builtin(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            let n = (*expr).name
            if name_eq(n, make_name("gpu_thread_id_x")) { return true }
            if name_eq(n, make_name("gpu_thread_id_y")) { return true }
            if name_eq(n, make_name("gpu_thread_id_z")) { return true }
            if name_eq(n, make_name("gpu_block_id_x")) { return true }
            if name_eq(n, make_name("gpu_block_id_y")) { return true }
            if name_eq(n, make_name("gpu_block_id_z")) { return true }
            if name_eq(n, make_name("gpu_block_dim_x")) { return true }
            if name_eq(n, make_name("gpu_block_dim_y")) { return true }
            if name_eq(n, make_name("gpu_block_dim_z")) { return true }
            if name_eq(n, make_name("gpu_barrier")) { return true }
            if name_eq(n, make_name("gpu_barrier_sync")) { return true }
            if name_eq(n, make_name("gpu_sync_threads")) { return true }
            false
        }
        None => false
    }
}

fn checker_expr_is_gpu_effect_root(e: Expr) -> bool with Mut, Panic, Div {
    e.kind == ExprKind::ExprIdent && name_eq(e.name, make_name("GPU"))
}

fn checker_expr_is_gpu_effect_field(e: Expr, field: Name) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprPath && e.path.seg_count == 2 {
        let head = checker_copy_string_list_to_name(e.path.segments)
        let tail = checker_copy_string_list_tail_to_name(e.path.segments)
        return name_eq(head, make_name("GPU")) && name_eq(tail, field)
    }
    if e.kind != ExprKind::ExprFieldAccess {
        return false
    }
    if !name_eq(e.name, field) { return false }
    match e.left {
        Some(base) => checker_expr_is_gpu_effect_root(*base),
        None => false,
    }
}

fn checker_expr_is_gpu_launch_descriptor_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprMethodCall {
        if !name_eq(e.name, make_name("launch")) { return false }
        match e.left {
            Some(base) => return checker_expr_is_gpu_effect_root(*base),
            None => return false,
        }
    }
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => checker_expr_is_gpu_effect_field(*callee, make_name("launch")),
        None => false,
    }
}

fn checker_expr_is_gpu_launch_invocation_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => checker_expr_is_gpu_launch_descriptor_call(*callee),
        None => false,
    }
}

fn checker_expr_is_gpu_sync_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprMethodCall {
        if !name_eq(e.name, make_name("sync")) { return false }
        match e.left {
            Some(base) => return checker_expr_is_gpu_effect_root(*base),
            None => return false,
        }
    }
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => checker_expr_is_gpu_effect_field(*callee, make_name("sync")),
        None => false,
    }
}

fn call_expr_is_builtin_assert(opt: Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str6((*expr).name, 97, 115, 115, 101, 114, 116)
        }
        None => false
    }
}

