// ============================================================
// Borrow checking helpers
// ============================================================

fn call_expr_is_builtin_prove_robust(opt: Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str12((*expr).name, 112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
        }
        None => false
    }
}

// "validate_manifest" = v(118) a(97) l(108) i(105) d(100) a(97) t(116) e(101)
//                       _(95) m(109) a(97) n(110) i(105) f(102) e(101) s(115) t(116), len=17
fn call_expr_is_builtin_validate_manifest(opt: Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str17((*expr).name,
                118, 97, 108, 105, 100, 97, 116, 101, 95,
                109, 97, 110, 105, 102, 101, 115, 116)
        }
        None => false
    }
}

