const MAX_TYPE_DEPTH: i64 = 64
const MAX_EXPR_DEPTH: i64 = 256
const MAX_LOOP_DEPTH: i64 = 1024
const MAX_TYPE_COMPLEXITY: i64 = 1000
const MAX_BORROW_ENTRIES: i64 = 128
const MAX_SCOPE_DEPTH: i64 = 64
const MAX_REFINEMENT_ENTRIES: i64 = 16
const MAX_CONST_INT_BINDINGS: i64 = 128
const ROBUST_LEVEL_FRAGILE: i64 = 0
const ROBUST_LEVEL_CONDITIONAL: i64 = 1
const ROBUST_LEVEL_STABLE: i64 = 2
const ROBUST_LEVEL_STRONG: i64 = 3
const ROBUST_LEVEL_INVARIANT: i64 = 4
const ROBUST_SCOPE_IN_DISTRIBUTION: i64 = 0
const ROBUST_SCOPE_EXTRAPOLATIVE: i64 = 1
const ROBUST_SCOPE_SUBGROUP_SPECIFIC: i64 = 2
const ROBUST_SCOPE_IDENTIFIED_FAMILY: i64 = 3
const ROBUST_SCOPE_TRANSPORTED_DOMAIN: i64 = 4
const CONTEST_WITNESS_SIGN_CONSENSUS: i64 = 0
const CONTEST_WITNESS_RELATIVE_BAND: i64 = 1
const CONTEST_WITNESS_MAX_TAIL_RISK: i64 = 2
const CONTEST_WITNESS_MECHANISTIC_DIVERGENCE: i64 = 3
const CONTEST_WITNESS_IDENTIFIABILITY_FLOOR: i64 = 4
const CONTEST_WITNESS_DISAGREEMENT: i64 = 5
const CONTEST_WITNESS_COUNTEREXAMPLE: i64 = 6
const CONTEST_WITNESS_POSTERIOR_WEIGHTS: i64 = 7
const DEFERRAL_EVIDENCE_CONTEST: i64 = 0
const DEFERRAL_EVIDENCE_ROBUST: i64 = 1
const DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT: i64 = 0
const DEFERRAL_REASON_MECHANISTIC_CONFLICT: i64 = 1
const DEFERRAL_REASON_COUNTEREXAMPLE_HAZARD: i64 = 2
const DEFERRAL_REASON_TAIL_RISK: i64 = 3
const DEFERRAL_REASON_IDENTIFIABILITY_GAP: i64 = 4
const DEFERRAL_REASON_TRANSPORT_GAP: i64 = 5
const DEFERRAL_REASON_POLICY_INCOMPLETE: i64 = 6
const ALTERNATIVE_SOURCE_DEFERRED: i64 = 0
const ALTERNATIVE_SOURCE_RECOURSE_PLAN: i64 = 1
const ALTERNATIVE_METRIC_INTERVENTION_COST: i64 = 0
const ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK: i64 = 1
const ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE: i64 = 2
const ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN: i64 = 3
const TRANSITION_METRIC_INTERVENTION_COST: i64 = 100
const TRANSITION_METRIC_RESIDUAL_TAIL_RISK: i64 = 101
const TRANSITION_METRIC_MECHANISTIC_DIVERGENCE: i64 = 102
const TRANSITION_METRIC_ADMISSIBILITY_MARGIN: i64 = 103

fn ir_alternative_metric_name(metric_id: i64) -> Name with Mut, Panic, Div {
    if metric_id == ALTERNATIVE_METRIC_INTERVENTION_COST {
        make_name("intervention_cost")
    } else if metric_id == ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK {
        make_name("residual_tail_risk")
    } else if metric_id == ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE {
        make_name("mechanistic_divergence")
    } else if metric_id == ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN {
        make_name("admissibility_margin")
    } else {
        make_name("unknown_metric")
    }
}

// ============================================================
// Checker state
// ============================================================

pub struct Checker {
    env: TypeEnv,
    borrows: BorrowEnv,
    units: UnitRegistry,
    refinements: RefinementTable,
    structs: *mut StructTable,
    enums: *mut EnumTable,
    fn_sigs: *mut FnSigTable,
    algebras: AlgebraTable,
    studies: StudyTable,
    ontologies: OntologyTable,
    ontology_kernel: OntologyKernel,
    ontology_cache_shadow_slot_count: i64,
    ontology_cache_shadow_slots: [i64; 6],
    ontology_cache_shadow_subclass_matrix: [bool; 36],
    hyper_exprs: HyperExprTable,
    models: ModelTable,
    model_families: ModelFamilyTable,
    policies: PolicyTable,
    decision_policies: DecisionPolicyTable,
    deferral_policies: DeferralPolicyTable,
    acquisition_policies: AcquisitionPolicyTable,
    recourse_policies: RecoursePolicyTable,
    alternative_policies: AlternativePolicyTable,
    validations: ValidationPolicyTable,
    contests: ContestTable,
    audits: AuditTable,
    mechanistic_reports: MechanisticReportTable,
    posterior_weights: PosteriorWeightsTable,
    counterexamples: CounterexampleTable,
    contest_witnesses: ContestWitnessTable,
    robust_proofs: RobustProofTable,
    decision_certificates: DecisionCertificateTable,
    deferred_certificates: DeferredCertificateTable,
    deferred_reason_witnesses: DeferredReasonWitnessTable,
    acquisition_plans: AcquisitionPlanTable,
    acquisition_reason_witnesses: AcquisitionReasonWitnessTable,
    recourse_plans: RecoursePlanTable,
    recourse_reason_witnesses: RecourseReasonWitnessTable,
    transition_policies: TransitionPolicyTable,
    transition_protocols: TransitionProtocolTable,
    transition_steps: TransitionStepTable,
    transition_plans: TransitionPlanTable,
    transition_reason_witnesses: TransitionReasonWitnessTable,
    monitoring_policies: MonitoringPolicyTable,
    observed_transitions: ObservedTransitionTable,
    rollback_certificates: RollbackCertificateTable,
    alternative_frontiers: AlternativeFrontierTable,
    alternative_candidates: AlternativeCandidateTable,
    alternative_sets: AlternativeSetTable,
    alternative_reason_witnesses: AlternativeReasonWitnessTable,
    validated_manifests: ValidatedManifestTable,
    error_count: i64,
    warning_count: i64,
    had_error: bool,
    diag_emitted: bool,
    // Module/crate context for visibility checking.
    current_module: AstPath,
    current_module_id: i64,
    crate_root: AstPath,
    enforce_visibility: bool,
    current_return_type: TypeEntry,
    current_impl_type: TypeEntry,
    current_effects: [i64; 8],
    current_effect_count: i64,
    // Which function is being checked. current_module was already tracked (it is
    // what makes E175 fire across modules); the FUNCTION was not, so E035 could
    // name neither, and in a multi-module check its span -- which starts at 0 and
    // carries no module identity -- pointed into whichever buffer the reader
    // guessed. Two of them were attributed to the wrong file that way.
    current_fn_name: Name,
    // Effect inference (§7.2.1) publishes the inferred set into the signature of the function being
    // checked, which means knowing WHICH signature that is. The name is stored beside the index as
    // a GUARD: at a set-site this pair is not updated at, the index would still point at an earlier
    // function and writing there would corrupt an unrelated signature silently. The write-back
    // checks the name first and skips on mismatch, so a missed site costs lost propagation rather
    // than a wrong effect set. -1 disables the write outright.
    current_sig_id: i64,
    current_sig_name: Name,
    multitest_count: i64,
    multitest_corrected: bool,
    last_literal_int: i64,
    last_literal_float: f64,
    last_literal_kind: i64,   // 0=none, 1=int, 2=float
    escape_provenance: i64,   // tail-expr escape provenance: 0=safe, 1=local ref escapes the frame
    loop_depth: i64,
    suppress_linear_consume_depth: i64,
    type_depth: i64,
    expr_depth: i64,
    complexity_budget: i64,
    const_int_name_bufs: [i8; 16384],
    const_int_name_lens: [i64; 128],
    const_int_values: [i64; 128],
    const_int_known: [i64; 128], // 1=known constant int, 0=shadow/unknown
    const_int_count: i64,
    const_int_scope_marks: [i64; 64],
    const_int_scope_depth: i64,
    effects: EffectTable,
    effect_ops: EffectOpTable,
    handler_depth: i64,
    current_handler_op_id: i64,
    ownership: OwnContext,
    trait_registry: TraitRegistry,
    impl_registry: ImplRegistry,
    // ── Static refinement proof engine (no Z3) ──────────────────────────────
    // Counters updated by check_refinement_literal / check_call_arg_refinement_boundary.
    refine_static_proved: i64,    // predicates proved at compile time
    refine_runtime_checked: i64,  // predicates deferred to runtime assertion
    refine_violations: i64,       // predicates definitely violated (compile error)
    // Condition-narrowing guard stack: up to 8 nested if-conditions.
    refine_cond_env: RefineStaticEnv,
    // Program items pointer, stored once during the in-place collect spine, so the
    // deep expression-checking compat path can walk ontology class declarations
    // for E009 subclass→parent subsumption. A single Option<Box<…>> field (one
    // shallow write that persists, unlike deep ontology_kernel mutation) avoids
    // both the un-writable kernel and threading the list through the call chain.
    // Placed at struct end to keep all existing field offsets unchanged.
    ontology_items: Option<Box<ItemList> >,
    // ---- NS noise-source dataflow ------------------------------------------
    // Noise-symbol interning table, heap-allocated like structs/enums/fn_sigs
    // (see ns_table_alloc, check::noise_sets) -- NOT inlined, so it does not
    // grow the by-value Checker (already ~164KB and SRET-fragile; see
    // checker_check_measure_expr_inplace's comment below). Shared by pointer
    // across every by-value copy of Checker, exactly like fn_sigs.
    ns_table: *mut NoiseSetTable,
    // Counter of measurement SOURCES issued this checker run. Deliberately
    // SEPARATE from ns_table's interned SET count: many distinct sources can
    // union into fewer distinct interned sets, so the two counters diverge on
    // real programs. Reset to 0 in checker_new/checker_init_in_place;
    // saturates to unknown via ns_singleton's own src>63 guard once 64
    // sources have been issued (the issuer does not duplicate that cap).
    ns_source_issued: i64,
    // Scratch set during checker_check_call_args_inplace to the noise_set_id
    // of the most recently seen Knowledge-typed call argument (parametric
    // call-result substitution). ns_arg_sentinel() (-2) means "no Knowledge
    // argument observed this call" -- distinct from all three valid handle
    // states (-1 unknown / 0 empty / >0 interned), so a call with no
    // Knowledge argument leaves the callee's declared return noise_set_id
    // untouched rather than being forced to unknown.
    last_call_arg_ns: i64,
    // Call-projection verdict table (codex ruling 2026-08-23) -- see
    // ns_proj_table_get/set and ns_body_projected_param_index above
    // checker_collect_fn_param_list_mut.
    ns_proj: *mut NsProjTable,
    // ---- env-φ fix (codex ruling 2026-08-23, round 3) ----------------------
    // A Knowledge var reassigned INSIDE an if/match branch does not survive
    // that branch's own block-scope pop (checker_check_block_inplace's
    // push_scope/pop_scope discards any shadow binding pushed inside it), so
    // the merge that matters happens back in the OUTER, surviving scope, at
    // checker_merge_ns_reassigned_inplace -- not at the reassignment site
    // itself. ns_branch_depth tracks "are we currently inside some if/match
    // branch's body" (incremented by checker_ns_branch_enter_inplace,
    // decremented by checker_merge_ns_reassigned_inplace, independent of the
    // borrow system's own branch_depth since match arms don't participate in
    // that one). ns_reassigned_names/_count is the flat, non-nesting-scoped
    // list of outer-scope Knowledge var names reassigned since the
    // OUTERMOST branch context began; only cleared when ns_branch_depth
    // returns to 0, so a nested if/match's merge can force a name to top in
    // its own (still-branch-nested) scope and the ENCLOSING merge can force
    // it again one scope further out -- forcing top twice is idempotent.
    ns_branch_depth: i64,
    ns_reassigned_names: [Name; 64],
    ns_reassigned_count: i64,
    // Sticky: set when ns_reassigned_names overflows its 64-slot cap inside a
    // branch context (a 65th distinct reassigned Knowledge var cannot be
    // recorded). At the depth-0 merge this forces EVERY live TyKnowledge
    // binding to top -- the sound fallback, since we can no longer name which
    // vars were reassigned. Mirrors the source-cap-64 -> unknown saturation in
    // noise_sets.sio: on overflow we must lose precision, never soundness.
    ns_reassigned_overflow: bool,
}

