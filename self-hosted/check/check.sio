    fn lower_validated_type(
        self,
        type_args: Option<Box<TypeExprList>>,
        opt: Option<Box<KnowledgeTypeInfo>>,
        span: Span
    ) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_validated_type(self, *info)
            None => {
                let pair = self.lower_single_wrapper_arg(type_args, span)
                if pair.1.kind == TypeKind::TyError {
                    pair
                } else {
                    (pair.0, ty_validated(pair.1, -1.0))
                }
            }
        }
    }

