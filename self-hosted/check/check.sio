fn contest_witness_kind_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str14(name, 115, 105, 103, 110, 95, 99, 111, 110, 115, 101, 110, 115, 117, 115) {
        return CONTEST_WITNESS_SIGN_CONSENSUS
    }
    if name_matches_str13(name, 114, 101, 108, 97, 116, 105, 118, 101, 95, 98, 97, 110, 100) {
        return CONTEST_WITNESS_RELATIVE_BAND
    }
    if name_matches_str13(name, 109, 97, 120, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return CONTEST_WITNESS_MAX_TAIL_RISK
    }
    if name_matches_str22(name, 109, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return CONTEST_WITNESS_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str21(name, 105, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 95, 102, 108, 111, 111, 114) {
        return CONTEST_WITNESS_IDENTIFIABILITY_FLOOR
    }
    if name_matches_str12(name, 100, 105, 115, 97, 103, 114, 101, 101, 109, 101, 110, 116) {
        return CONTEST_WITNESS_DISAGREEMENT
    }
    if name_matches_str14(name, 99, 111, 117, 110, 116, 101, 114, 101, 120, 97, 109, 112, 108, 101) {
        return CONTEST_WITNESS_COUNTEREXAMPLE
    }
    if name_matches_str17(name, 112, 111, 115, 116, 101, 114, 105, 111, 114, 95, 119, 101, 105, 103, 104, 116, 115) {
        return CONTEST_WITNESS_POSTERIOR_WEIGHTS
    }
    -1
}

fn call_expr_contest_witness_kind(opt: Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return -1
            }
            contest_witness_kind_from_name((*expr).name)
        }
        None => -1
    }
}

