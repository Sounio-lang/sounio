                let has_temp = has_effect_id(c.current_effects, c.current_effect_count, temporal_id)
                if !has_zd || !has_temp {
                    c = c.report_error_at(span, 206, 0, 0, 0)
                }
                (c, inner_ty)
            }
        }
    }

