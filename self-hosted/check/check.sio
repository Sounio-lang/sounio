    fn lower_refinement_type(self, opt: Option<Box<RefinementInfo>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => {
                let ri = *info
                match ri.base_type {
                    Some(bte) => {
                        let pair = self.lower_type_expr(*bte)
                        var c = pair.0
                        let base_ty = pair.1
                        // Build refinement predicate from inline annotation
                        if ri.pred_op > 0 {
                            let pred = if ri.pred_is_float {
                                pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
                            } else {
                                pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
                            }
                            let rt = RefinementType { base_type: base_ty, var_name: ri.var_name, predicate: pred }
                            let synth_name = make_refinement_synth_name(c.refinements.count)
                            c.refinements = refinement_table_add(c.refinements, synth_name, rt)
                            let ref_idx = c.refinements.count - 1
                            (c, ty_with_refinement(base_ty, ref_idx))
                        } else {
                            (c, base_ty)
                        }
                    }
                    None => (self, ty_error())
                }
            }
            None => (self, ty_error())
        }
    }
}

fn lower_array_size(opt: Option<Box<Expr>>) -> i64 {
    match opt {
        Some(e) => (*e).int_val
        None => -1
    }
}

// ============================================================
// Pass 1: Collect top-level declarations
// ============================================================

impl Checker {
    fn collect_items(self, items: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cursor = items
        while true {
            match cursor {
                Some(list) => {
                    c = c.collect_item((*list).head)
                    cursor = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn collect_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.collect_fn_def(item.name, item.fn_def)
            ItemStruct => self.collect_struct_def(item.name, item.struct_def)
            ItemEnum => self.collect_enum_def(item.name, item.enum_def)
            ItemImpl => self.collect_impl_def(item.impl_def)
            ItemTypeAlias => self.collect_type_alias(item.name, item.type_alias_ty)
            ItemModels => self.collect_models_def(item.name, item.models_def)
            ItemPolicy => self.collect_policy_def(item.name, item.policy_def)
            ItemAcquisitionPolicy => self.collect_acquisition_policy_def(item.name, item.acquisition_policy_def)
            ItemRecoursePolicy => self.collect_recourse_policy_def(item.name, item.recourse_policy_def)
            ItemTransitionPolicy => self.collect_transition_policy_def(item.name, item.transition_policy_def)
            ItemTransitionProtocol => self.collect_transition_protocol_def(item.name, item.transition_protocol_def)
            ItemMonitoringPolicy => self.collect_monitoring_policy_def(item.name, item.monitoring_policy_def)
            ItemAlternativePolicy => self.collect_alternative_policy_def(item.name, item.alternative_policy_def)
            ItemAlternativeFrontier => self.collect_alternative_frontier_def(item.name, item.alternative_frontier_def)
            ItemDecisionPolicy => self.collect_decision_policy_def(item.name, item.decision_policy_def)
            ItemDeferralPolicy => self.collect_deferral_policy_def(item.name, item.deferral_policy_def)
            ItemValidation => self.collect_validation_def(item.name, item.validation_def)
            ItemAudit => self.collect_audit_def(item.name, item.audit_def)
            ItemUse => self
            ItemUnit => self.collect_unit_decl(item.name)
            ItemEffect => self.collect_item_effect(item.effect_def)
            ItemSession => self  // Session protocol registered in collect pass (no-op for now)
        }
    }

    fn collect_item_effect(self, opt: Option<Box<EffectDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(edef) => {
                var c = self
                let eid = 100 + c.effects.count
                let first_op_id = c.effect_ops.count
                let op_pair = c.collect_effect_op_defs((*edef).ops, eid)
                c = op_pair.0
                let op_count = op_pair.1
                let info = EffectInfo {
                    name: (*edef).name,
                    op_count: op_count,
                    first_op_id: first_op_id,
                }
                let add_result = c.effects.add(info)
                c.effects = add_result.0
                c
            }
        }
    }

    fn collect_effect_op_defs(self, opt: Option<Box<EffectOpDefList>>, effect_id: i64) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => (self, 0)
            Some(node) => {
                var c = self
                let head = (*node).head
                let ret_pair = match head.ret_ty {
                    None => (c, ty_unit())
                    Some(te_box) => c.lower_type_expr(*te_box)
                }
                c = ret_pair.0
                let ret_ty = ret_pair.1
                let op_info = EffectOpInfo {
                    name: head.name,
                    effect_id: effect_id,
                    param_count: 0,
                    ret_ty: ret_ty,
                }
                let add_result = c.effect_ops.add(op_info)
                c.effect_ops = add_result.0
                let tail_pair = c.collect_effect_op_defs((*node).tail, effect_id)
                c = tail_pair.0
                let count = 1 + tail_pair.1
                (c, count)
            }
        }
    }

    fn lookup_user_effect_id(self, name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.effects.count {
            let entry = self.effects.entries[i as usize]
            if entry.name.len == name_len {
                var j: i64 = 0
                var matched = true
                while j < name_len && j < 64 {
                    if entry.name.buf[j as usize] != name_buf[j as usize] {
                        matched = false
                    }
                    j = j + 1
                }
                if matched {
                    return 100 + i
                }
            }
            i = i + 1
        }
        -1
    }

    fn extract_effects_with_checker(self, opt: Option<Box<EffectList>>) -> (Checker, [i64; 8], i64) with Mut, Panic, Div {
        match opt {
            None => (self, [0; 8], 0)
            Some(list) => self.collect_effects_with_checker(*list, [0; 8], 0)
        }
    }

    fn collect_effects_with_checker(self, list: EffectList, effects: [i64; 8], count: i64) -> (Checker, [i64; 8], i64) with Mut, Panic, Div {
        var effs = effects
        var n = count
        var eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)
        if eff_id < 0 {
            eff_id = self.lookup_user_effect_id(list.head.name_buf, list.head.name_len)
        }
        if eff_id >= 0 && n < 8 {
            var already_present = false
            var i: i64 = 0
            while i < n {
                if effs[i as usize] == eff_id {
                    already_present = true
                }
                i = i + 1
            }
            if !already_present {
                effs[n as usize] = eff_id
                n = n + 1
            }
        }
        match list.tail {
            None => (self, effs, n)
            Some(next) => self.collect_effects_with_checker(*next, effs, n)
        }
    }

    fn collect_type_alias(self, name: Name, ty_opt: Option<Box<TypeExpr>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match ty_opt {
            Some(te_box) => {
                let te = *te_box
                if te.kind == TypeExprKind::TypeRefinement {
                    // Register refinement type: type Pos = { x: i64 | x > 0 }
                    match te.refinement_info {
                        Some(ri_box) => {
                            let ri = *ri_box
                            // Lower base type
                            let pair = match ri.base_type {
                                Some(bte) => self.lower_type_expr(*bte)
                                None => (self, ty_error())
                            }
                            var c = pair.0
                            let base_ty = pair.1
                            // Build predicate from parsed op + value
                            let pred = if ri.pred_is_float {
                                pred_make_float(ri.pred_op, ri.var_name, ri.pred_float_val)
                            } else {
                                pred_make_int(ri.pred_op, ri.var_name, ri.pred_int_val)
                            }
                            let rt = RefinementType {
                                base_type: base_ty,
                                var_name: ri.var_name,
                                predicate: pred,
                            }
                            c.refinements = refinement_table_add(c.refinements, name, rt)
                            c
                        }
                        None => self
                    }
                } else {
                    let pair = self.lower_type_expr(te)
                    var c = pair.0
                    let alias_ty = pair.1
                    c.env = c.env.bind(name, alias_ty, false)
                    c = c.const_int_bind_unknown(name)
                    if alias_ty.kind == TypeKind::TyModel {
                        let info = ModelInfo {
                            name: name,
                            input_ty: model_input_ty(alias_ty),
                            output_ty: model_output_ty(alias_ty),
                        }
                        let add_result = c.models.add(info)
                        c.models = add_result.0
                    }
                    c
                }
            }
            None => self
        }
    }

    fn collect_unit_decl(self, name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Register user-defined unit as a mass-like dimension (f64 base)
        // For now, user-defined units get a generic dimension
        c.units = c.units.register(name, unit_dim_dimensionless())
        c
    }

    fn collect_policy_def(self, name: Name, opt: Option<Box<PolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pd) => {
                let target_pair = self.lower_type_expr((*pd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_policy_requirements((*pd).requirements)
                c = req_pair.0
                let requirements = req_pair.1
                let requirement_count = req_pair.2
                let info = PolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    level_name: (*pd).level_name,
                    scope_name: (*pd).scope_name,
                    level_id: robustness_level_id_from_name((*pd).level_name),
                    scope_id: robustness_scope_id_from_name((*pd).scope_name),
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.policies.add(info)
                c.policies = add_result.0
                c.env = c.env.bind(name, ty_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

