fn expr_list_head(opt: Option<Box<ExprList> >) -> Option<Box<Expr> > with Alloc {
    match opt {
        Some(list) => Some(Box::new((*list).head))
        None => None
    }
}

fn expr_list_tail(opt: Option<Box<ExprList> >) -> Option<Box<ExprList> > with Alloc {
    match opt {
        Some(list) => (*list).tail
        None => None
    }
}

// Stage0 miscompiles passing Option<Box<T>> by value into *mut functions.
// Use an explicit raw-pointer handle built in a non-*mut helper instead.
pub struct ExprListHandle {
    ptr: *mut ExprList,
}

fn expr_list_handle(opt: Option<Box<ExprList> >) -> ExprListHandle with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            let result = list as *mut ExprList
            ExprListHandle { ptr: result }
        }
        None => ExprListHandle { ptr: 0 as *mut ExprList }
    }
}

fn expr_list_handle_next(h: ExprListHandle) -> ExprListHandle with Mut, Panic, Div {
    if h.ptr == 0 as *mut ExprList { return ExprListHandle { ptr: 0 as *mut ExprList } }
    match (*h.ptr).tail {
        Some(next) => ExprListHandle { ptr: next as *mut ExprList }
        None => ExprListHandle { ptr: 0 as *mut ExprList }
    }
}

fn expr_list_handle_count(h: ExprListHandle) -> i64 with Mut, Panic, Div {
    if h.ptr == 0 as *mut ExprList { return 0 }
    1 + expr_list_handle_count(expr_list_handle_next(h))
}

pub struct FnParamListHandle {
    ptr: *mut FnParamList,
}

fn fn_param_list_handle(opt: Option<Box<FnParamList> >) -> FnParamListHandle with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            let result = FnParamListHandle { ptr: list as *mut FnParamList }
            result
        }
        None => FnParamListHandle { ptr: 0 as *mut FnParamList }
    }
}

fn fn_param_list_handle_get(h: FnParamListHandle, idx: i64) -> FnParamInfo with Mut, Panic, Div {
    var current = h
    var i: i64 = idx
    while current.ptr != 0 as *mut FnParamList {
        if i == 0 {
            let result = (*current.ptr).head
            return result
        }
        match (*current.ptr).tail {
            Some(next) => {
                current = FnParamListHandle { ptr: next as *mut FnParamList }
                i = i - 1
            }
            None => { break }
        }
    }
    empty_fn_param_info()
}

fn checker_fn_sig_has_effect(sig: FnSig, effect_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < sig.effect_count && i < 8 {
        if sig.effects[i] == effect_id {
            return true
        }
        i = i + 1
    }
    false
}

fn checker_fn_sig_effects_compatible(a: FnSig, b: FnSig) -> bool with Mut, Panic, Div {
    // Function values are compatible when the provided effect row is a subset
    // of the expected effect row: a pure fn can flow to `fn ... with Panic`,
    // but an effectful fn cannot flow to a pure fn slot.
    var i: i64 = 0
    while i < a.effect_count && i < 8 {
        if !checker_fn_sig_has_effect(b, a.effects[i]) {
            return false
        }
        i = i + 1
    }
    true
}

fn checker_types_compatible_table_deep(tbl: *mut FnSigTable, a: TypeEntry, b: TypeEntry, depth: i64) -> bool with Mut, Panic, Div, Alloc {
    if types_compatible(a, b) {
        return true
    }
    if depth > 16 {
        return false
    }
    if a.kind != TypeKind::TyFn || b.kind != TypeKind::TyFn {
        return false
    }
    if a.fn_sig_id < 0 || b.fn_sig_id < 0 {
        return false
    }
    if a.fn_sig_id >= (*tbl).count || b.fn_sig_id >= (*tbl).count {
        return false
    }
    let asig = fn_sig_table_get(tbl, a.fn_sig_id)
    let bsig = fn_sig_table_get(tbl, b.fn_sig_id)
    if !checker_types_compatible_table_deep(tbl, asig.return_type, bsig.return_type, depth + 1) {
        return false
    }
    if !checker_fn_sig_params_compatible_table_deep(tbl, asig, bsig, depth + 1) {
        return false
    }
    checker_fn_sig_effects_compatible(asig, bsig)
}

fn checker_fn_sig_params_compatible_table_deep(tbl: *mut FnSigTable, a: FnSig, b: FnSig, depth: i64) -> bool with Mut, Panic, Div, Alloc {
    if a.param_count != b.param_count {
        return false
    }
    let ah = fn_param_list_handle(a.params)
    let bh = fn_param_list_handle(b.params)
    var i: i64 = 0
    while i < a.param_count {
        let ap = fn_param_list_handle_get(ah, i)
        let bp = fn_param_list_handle_get(bh, i)
        if !checker_types_compatible_table_deep(tbl, ap.ty, bp.ty, depth + 1) {
            return false
        }
        i = i + 1
    }
    true
}

fn checker_fn_types_structurally_compatible_table(tbl: *mut FnSigTable, a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if a.kind != TypeKind::TyFn || b.kind != TypeKind::TyFn {
        return false
    }
    if a.fn_sig_id == b.fn_sig_id {
        return true
    }
    if a.fn_sig_id < 0 || b.fn_sig_id < 0 {
        return false
    }
    if a.fn_sig_id >= (*tbl).count || b.fn_sig_id >= (*tbl).count {
        return false
    }
    let asig = fn_sig_table_get(tbl, a.fn_sig_id)
    let bsig = fn_sig_table_get(tbl, b.fn_sig_id)
    if !checker_types_compatible_table_deep(tbl, asig.return_type, bsig.return_type, 0) {
        return false
    }
    if !checker_fn_sig_params_compatible_table_deep(tbl, asig, bsig, 0) {
        return false
    }
    checker_fn_sig_effects_compatible(asig, bsig)
}

fn checker_types_compatible_table(tbl: *mut FnSigTable, a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if types_compatible(a, b) {
        return true
    }
    checker_fn_types_structurally_compatible_table(tbl, a, b)
}

fn checker_call_arg_types_compatible_table(tbl: *mut FnSigTable, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if checker_types_compatible_table(tbl, arg_ty, param_ty) {
        return true
    }
    if checker_contextual_expr_compatible(arg_expr, arg_ty, param_ty) {
        return true
    }
    if param_ty.kind == TypeKind::TyRef && arg_ty.kind == TypeKind::TyRefMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if param_ty.kind == TypeKind::TySlice && arg_ty.kind == TypeKind::TySliceMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if slice_param_accepts_array_ref(arg_ty, param_ty) {
        return true
    }
    if arg_expr.kind == ExprKind::ExprIdent &&
       (param_ty.kind == TypeKind::TyRef || param_ty.kind == TypeKind::TyRefMut) {
        return checker_types_compatible_table(tbl, arg_ty, call_ref_inner_or_self(param_ty))
    }
    false
}

fn checker_fn_types_structurally_compatible_inplace(c: *mut Checker, a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc, IO {
    if a.kind != TypeKind::TyFn || b.kind != TypeKind::TyFn {
        return false
    }
    if a.fn_sig_id == b.fn_sig_id {
        return true
    }
    if a.fn_sig_id < 0 || b.fn_sig_id < 0 {
        return false
    }
    if a.fn_sig_id >= (*(*c).fn_sigs).count || b.fn_sig_id >= (*(*c).fn_sigs).count {
        return false
    }
    checker_types_compatible_table_deep((*c).fn_sigs, a, b, 0)
}

fn checker_types_compatible_inplace(c: *mut Checker, a: TypeEntry, b: TypeEntry) -> bool with Mut, Panic, Div, Alloc, IO {
    if types_compatible(a, b) {
        return true
    }
    checker_fn_types_structurally_compatible_inplace(c, a, b)
}

// E009 ontology subsumption by name: walk the stored program items for child_name's
// class declaration and recurse up its superclasses; true if parent_name is reached
// (reflexive + transitive). Pure read-walk — works in the *mut spine where deep
// ontology_kernel mutation does not. Depth-bounded against pathological cycles.
fn checker_onto_name_subclass_walk(items: Option<Box<ItemList> >, child_name: Name, parent_name: Name, depth: i64) -> bool with Mut, Panic, Div, Alloc {
    if name_eq(child_name, parent_name) {
        return true
    }
    if depth > 64 {
        return false
    }
    var cur = items
    while true {
        match cur {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemOntology {
                    match item.ontology_def {
                        Some(odef) => {
                            var ci = (*odef).classes
                            while true {
                                match ci {
                                    Some(clist) => {
                                        if name_eq((*clist).head.name, child_name) {
                                            var s: i64 = 0
                                            while s < (*clist).head.superclass_count && s < 8 {
                                                let sname = (*clist).head.superclass_names[s as usize]
                                                if checker_onto_name_subclass_walk(items, sname, parent_name, depth + 1) {
                                                    return true
                                                }
                                                s = s + 1
                                            }
                                        }
                                        ci = (*clist).tail
                                    }
                                    None => break
                                }
                            }
                        }
                        None => {}
                    }
                }
                cur = (*list).tail
            }
            None => break
        }
    }
    false
}

fn checker_call_arg_types_compatible_inplace(c: *mut Checker, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc, IO {
    if checker_types_compatible_inplace(c, arg_ty, param_ty) {
        return true
    }
    if checker_contextual_expr_compatible(arg_expr, arg_ty, param_ty) {
        return true
    }
    if param_ty.kind == TypeKind::TyRef && arg_ty.kind == TypeKind::TyRefMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if param_ty.kind == TypeKind::TySlice && arg_ty.kind == TypeKind::TySliceMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if slice_param_accepts_array_ref(arg_ty, param_ty) {
        return true
    }
    if arg_expr.kind == ExprKind::ExprIdent &&
       (param_ty.kind == TypeKind::TyRef || param_ty.kind == TypeKind::TyRefMut) {
        return checker_types_compatible_inplace(c, arg_ty, call_ref_inner_or_self(param_ty))
    }
    // Ontology subsumption: a subclass argument satisfies a parent-class parameter.
    let exp_ty = call_ref_inner_or_self(param_ty)
    let got_ty = call_ref_inner_or_self(arg_ty)
    if !name_is_empty(got_ty.name) && !name_is_empty(exp_ty.name) && !name_eq(got_ty.name, exp_ty.name) {
        if checker_onto_name_subclass_walk((*c).ontology_items, got_ty.name, exp_ty.name, 0) {
            return true
        }
    }
    false
}

fn expr_list_second(opt: Option<Box<ExprList> >) -> Option<Box<Expr> > with Alloc {
    match opt {
        Some(list) => {
            match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
        }
        None => None
    }
}

fn expr_list_third(opt: Option<Box<ExprList> >) -> Option<Box<Expr> > with Alloc {
    match opt {
        Some(list) => {
            match (*list).tail {
                Some(rest) => {
                    match (*rest).tail {
                        Some(last) => Some(Box::new((*last).head))
                        None => None
                    }
                }
                None => None
            }
        }
        None => None
    }
}

// ============================================================
// IndepKnowledge<T, A, B | Z> — variable identity (Sprint 20 Track CI)
// ============================================================
//
// A claim of independence only has to tell its variables apart, so a name
// identity is exactly the semantics available today. It is NOT a causal-graph
// node index: no surface syntax declares a causal graph yet, so nothing can
// discharge the claim by d-separation. When that surface exists these ids
// become indices into the declared graph and causal_d_separated becomes the
// discharge. Until then the checker enforces only what it can actually know —
// that a variable is not independent of itself.
//
// FNV-1a, reduced modulo a prime each step so the product cannot overflow i64.
fn indep_var_id(n: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 2166136261
    var i: i64 = 0
    while i < n.len && i < 128 {
        h = h ^ (n.buf[i as usize] as i64)
        h = (h * 16777619) % 1073741789
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    h
}

// Identity of the conditioning set Z. Summed rather than folded in sequence
// because Z is a SET: {hora, plantao} and {plantao, hora} are the same claim
// and must produce the same type.
fn indep_cond_set_id(cond: TypeExpr) -> i64 with Mut, Panic, Div {
    match cond.type_args {
        None => 0 - 1
        Some(list) => {
            var cur = *list
            var acc: i64 = 0
            var more = true
            while more {
                let vid = indep_var_id(checker_copy_string_list_to_name(cur.head.path.segments))
                acc = (acc + vid) % 1073741789
                match cur.tail {
                    Some(rest) => { cur = *rest }
                    None => { more = false }
                }
            }
            // -1 is reserved for "empty set"; a non-empty set must never collide
            // with it, so a zero sum is nudged to a distinct sentinel.
            if acc == 0 { 1073741788 } else { acc }
        }
    }
}

// Rebuild the declared graph from the CG_* registry the parser filled. Node
// names are not carried: causal_d_separated works on indices, and the indices
// here are the registry's own, so a name would be a second source of truth.
fn checker_cg_build() -> CausalGraph with Mut, Panic, Div {
    var g = causal_graph_new()
    var i: i64 = 0
    while i < CG_NODE_COUNT && i < 16 {
        let pair = causal_graph_add_node(g, Name { buf: [0; 128], len: 0 }, true)
        g = pair.0
        i = i + 1
    }
    var e: i64 = 0
    while e < CG_EDGE_COUNT && e < 32 {
        if CG_EDGE_DIRECTED[e as usize] == 1 {
            g = causal_graph_add_edge(g, CG_EDGE_FROM[e as usize], CG_EDGE_TO[e as usize])
        } else {
            g = causal_graph_add_confound(g, CG_EDGE_FROM[e as usize], CG_EDGE_TO[e as usize])
        }
        e = e + 1
    }
    g
}

// The conditioning set as node indices. `ok` is false when Z names a variable
// the graph does not declare -- which must be rejected, not treated as an empty
// conditioning set: silently dropping an unknown Z would turn a conditioned
// claim into a marginal one and d-separate pairs the author never claimed.
fn checker_cg_zset(cond_args: Option<Box<TypeExprList>>) -> (bool, [bool; 16]) with Mut, Panic, Div {
    var z_set: [bool; 16] = [false; 16]
    match cond_args {
        None => (true, z_set)
        Some(zl) => {
            var cur = *zl
            var more = true
            var ok = true
            while more {
                let zh = indep_var_id(checker_copy_string_list_to_name(cur.head.path.segments))
                let zn = ast_cg_find_node(zh)
                if zn < 0 {
                    ok = false
                    more = false
                } else {
                    z_set[zn as usize] = true
                    match cur.tail {
                        Some(rest) => { cur = *rest }
                        None => { more = false }
                    }
                }
            }
            (ok, z_set)
        }
    }
}

// Verify every d_separated(A, B | Z) the parser recorded and rewrote to the
// proof token. Deferred to here, after all items are parsed, so a graph declared
// below its use still counts -- the parser cannot know the whole graph yet.
//
// A claim that fails is an error at the call site; the token it produced stays a
// 1, but the compilation does not succeed, so no proof escapes a failed check.
// The *mut spine's copy. Every driver that checks a program routes through
// checker_check_items_inner_store_return_had_error_mut, so this is where the
// verification actually runs; the by-value one below serves
// check_program_with_artifacts.
pub fn checker_verify_dsep_claims_mut(c: *mut Checker) with Mut, Panic, Div, Alloc, IO {
    var i: i64 = 0
    while i < DSEP_COUNT && i < 64 {
        // A multi-module check runs this once per module. Mark each claim
        // instead of clearing the registry: clearing on the first module wiped
        // claims belonging to a module not yet checked, and they vanished.
        if DSEP_DONE[i as usize] == 1 {
            i = i + 1
            continue
        }
        DSEP_DONE[i as usize] = 1
        let sp = Span {
            file_id: DSEP_SPAN_FILE[i as usize] as i32,
            start: DSEP_SPAN_START[i as usize],
            end: DSEP_SPAN_END[i as usize],
        }
        if DSEP_FORM_OK[i as usize] == 0 || CG_DECLARED == 0 {
            checker_report_error_at_inplace(c, sp, 256, 0, 0, 0)
        } else {
            let a_node = ast_cg_find_node(DSEP_A[i as usize])
            let b_node = ast_cg_find_node(DSEP_B[i as usize])
            var z_node: i64 = 0 - 1
            var z_known = true
            if DSEP_Z[i as usize] >= 0 {
                z_node = ast_cg_find_node(DSEP_Z[i as usize])
                if z_node < 0 { z_known = false }
            }
            if a_node < 0 || b_node < 0 || !z_known {
                checker_report_error_at_inplace(c, sp, 254, 0, 0, 0)
            } else {
                var z_set: [bool; 16] = [false; 16]
                if z_node >= 0 { z_set[z_node as usize] = true }
                let g = checker_cg_build()
                if !causal_d_separated(g, a_node, b_node, z_set) {
                    checker_report_error_at_inplace(c, sp, 255, 0, 0, 0)
                }
            }
        }
        i = i + 1
    }
}

pub fn checker_verify_dsep_claims(c: Checker) -> Checker with Mut, Panic, Div, Alloc, IO {
    var out = c
    var i: i64 = 0
    while i < DSEP_COUNT && i < 64 {
        let sp = Span {
            file_id: DSEP_SPAN_FILE[i as usize] as i32,
            start: DSEP_SPAN_START[i as usize],
            end: DSEP_SPAN_END[i as usize],
        }
        if DSEP_FORM_OK[i as usize] == 0 || CG_DECLARED == 0 {
            out = out.report_error_at(sp, 256, 0, 0, 0)
        } else {
            let a_node = ast_cg_find_node(DSEP_A[i as usize])
            let b_node = ast_cg_find_node(DSEP_B[i as usize])
            var z_node: i64 = 0 - 1
            var z_known = true
            if DSEP_Z[i as usize] >= 0 {
                z_node = ast_cg_find_node(DSEP_Z[i as usize])
                if z_node < 0 { z_known = false }
            }
            if a_node < 0 || b_node < 0 || !z_known {
                out = out.report_error_at(sp, 254, 0, 0, 0)
            } else {
                var z_set: [bool; 16] = [false; 16]
                if z_node >= 0 { z_set[z_node as usize] = true }
                let g = checker_cg_build()
                if !causal_d_separated(g, a_node, b_node, z_set) {
                    out = out.report_error_at(sp, 255, 0, 0, 0)
                }
            }
        }
        i = i + 1
    }
    out
}

fn checker_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn checker_copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => checker_copy_string_list_tail_to_name(*rest)
        None => checker_copy_string_list_to_name(seg)
    }
}

fn contest_model_list_present(opt: Option<Box<ExprList> >) -> bool {
    match opt {
        Some(_) => true
        None => false
    }
}

fn contest_model_name(e: Expr) -> Name with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprPath {
        checker_copy_string_list_tail_to_name(e.path.segments)
    } else if e.kind == ExprKind::ExprIdent {
        e.name
    } else {
        empty_name()
    }
}

fn multitest_call_name(opt: Option<Box<Expr> >) -> Name with Mut, Panic, Div, Alloc {
    match opt {
        Some(callee) => {
            if (*callee).kind == ExprKind::ExprPath {
                checker_copy_string_list_tail_to_name((*callee).path.segments)
            } else if (*callee).kind == ExprKind::ExprIdent {
                (*callee).name
            } else {
                empty_name()
            }
        }
        None => empty_name()
    }
}

fn multitest_effect_enabled(effects: [i64; 8], count: i64) -> bool with Mut, Panic, Div {
    has_effect_id(effects, count, 17)
}

fn hypothesis_effect_enabled(effects: [i64; 8], count: i64) -> bool with Mut, Panic, Div {
    has_effect_id(effects, count, 16)
}

fn multitest_is_stat_test_name(name: Name) -> bool with Mut, Panic, Div {
    name_eq(name, make_name("z_test_one_sample"))
        || name_eq(name, make_name("z_test_two_sample"))
        || name_eq(name, make_name("t_test_one_sample"))
        || name_eq(name, make_name("t_test_two_sample"))
        || name_eq(name, make_name("t_test_paired"))
        || name_eq(name, make_name("chi2_goodness_of_fit"))
        || name_eq(name, make_name("f_test"))
        || name_eq(name, make_name("mann_whitney_u"))
        || name_eq(name, make_name("permutation_test"))
}

fn multitest_is_correction_name(name: Name) -> bool with Mut, Panic, Div {
    name_eq(name, make_name("bonferroni"))
        || name_eq(name, make_name("benjamini_hochberg"))
}

fn hypothesis_outcome_name_from_expr(e: Expr) -> Name with Mut, Panic, Div, Alloc {
    if e.kind == ExprKind::ExprIdent {
        e.name
    } else if e.kind == ExprKind::ExprPath {
        checker_copy_string_list_tail_to_name(e.path.segments)
    } else if e.kind == ExprKind::ExprFieldAccess {
        e.name
    } else if e.kind == ExprKind::ExprUnary {
        match e.left {
            Some(inner) => hypothesis_outcome_name_from_expr(*inner)
            None => empty_name()
        }
    } else {
        empty_name()
    }
}

fn hypothesis_outcome_name_from_args(opt: Option<Box<ExprList> >) -> Name with Mut, Panic, Div, Alloc {
    match expr_list_head(opt) {
        Some(arg) => hypothesis_outcome_name_from_expr(*arg)
        None => empty_name()
    }
}

fn active_study_has_hypothesis_outcome(studies: StudyTable, outcome_name: Name) -> bool with Mut, Panic, Div {
    if studies.count <= 0 || name_is_empty(outcome_name) {
        return false
    }
    let study = studies.entries[(studies.count - 1) as usize]
    var i: i64 = 0
    while i < study.hypothesis_count {
        if name_eq(study.hypotheses[i as usize].outcome, outcome_name) {
            return true
        }
        i = i + 1
    }
    false
}

fn contest_info_from_expr_models(opt: Option<Box<ExprList> >) -> ContestInfo with Mut, Panic, Div, Alloc {
    let info = empty_contest_info()
    contest_info_from_expr_models_loop(opt, info, 0)
}

fn contest_info_from_expr_models_loop(opt: Option<Box<ExprList> >, info: ContestInfo, idx: i64) -> ContestInfo with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = info
            if idx < 16 {
                next.model_names[idx as usize] = contest_model_name((*list).head)
                next.model_count = idx + 1
            }
            contest_info_from_expr_models_loop((*list).tail, next, idx + 1)
        }
        None => info
    }
}

fn model_input_ty(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    type_entry_list_get(ty.tuple_elems, 0)
}

fn model_output_ty(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    type_entry_list_get(ty.tuple_elems, 1)
}

fn contest_model_lists_match(opt: Option<Box<ExprList> >, family: ModelFamilyInfo, idx: i64) -> bool with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            if idx >= family.model_count || idx >= 16 {
                return false
            }
            if !name_eq(contest_model_name((*list).head), family.model_names[idx as usize]) {
                return false
            }
            contest_model_lists_match((*list).tail, family, idx + 1)
        }
        None => idx == family.model_count
    }
}

fn contest_info_from_family_signature(family: ModelFamilyInfo, policy_id: i64) -> ContestInfo with Mut, Panic, Div {
    var info = empty_contest_info()
    info.family_id = -1
    info.policy_id = policy_id
    info.model_count = family.model_count
    var i: i64 = 0
    while i < family.model_count && i < 16 {
        info.model_names[i as usize] = family.model_names[i as usize]
        i = i + 1
    }
    info
}

fn contest_info_attach_span(info: ContestInfo, span: Span) -> ContestInfo with Mut, Panic {
    var next = info
    next.span_start = span.start
    next.span_end = span.end
    next
}

fn contest_info_attach_family_id(info: ContestInfo, family_id: i64) -> ContestInfo with Mut, Panic {
    var next = info
    next.family_id = family_id
    next
}

fn audit_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str14(name, 115, 105, 103, 110, 95, 99, 111, 110, 115, 101, 110, 115, 117, 115) {
        return CONTEST_METRIC_SIGN_CONSENSUS
    }
    if name_matches_str13(name, 114, 101, 108, 97, 116, 105, 118, 101, 95, 98, 97, 110, 100) {
        return CONTEST_METRIC_RELATIVE_BAND
    }
    if name_matches_str13(name, 109, 97, 120, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return CONTEST_METRIC_MAX_TAIL_RISK
    }
    if name_matches_str21(name, 105, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 95, 102, 108, 111, 111, 114) {
        return CONTEST_METRIC_IDENTIFIABILITY_FLOOR
    }
    -1
}

fn audit_mechanistic_field_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str20(name, 97, 103, 103, 114, 101, 103, 97, 116, 101, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return 0
    }
    if name.len == 23
        && name.buf[0] == 108 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 110 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 95 as i8 && name.buf[7] == 115 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 97 as i8 && name.buf[10] == 116 as i8 && name.buf[11] == 101 as i8
        && name.buf[12] == 95 as i8 && name.buf[13] == 100 as i8 && name.buf[14] == 105 as i8
        && name.buf[15] == 118 as i8 && name.buf[16] == 101 as i8 && name.buf[17] == 114 as i8
        && name.buf[18] == 103 as i8 && name.buf[19] == 101 as i8 && name.buf[20] == 110 as i8
        && name.buf[21] == 99 as i8 && name.buf[22] == 101 as i8 {
        return 1
    }
    if name.len == 31
        && name.buf[0] == 99 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 117 as i8
        && name.buf[3] == 115 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 108 as i8
        && name.buf[6] == 95 as i8 && name.buf[7] == 100 as i8 && name.buf[8] == 101 as i8
        && name.buf[9] == 99 as i8 && name.buf[10] == 111 as i8 && name.buf[11] == 109 as i8
        && name.buf[12] == 112 as i8 && name.buf[13] == 111 as i8 && name.buf[14] == 115 as i8
        && name.buf[15] == 105 as i8 && name.buf[16] == 116 as i8 && name.buf[17] == 105 as i8
        && name.buf[18] == 111 as i8 && name.buf[19] == 110 as i8 && name.buf[20] == 95 as i8
        && name.buf[21] == 100 as i8 && name.buf[22] == 105 as i8 && name.buf[23] == 118 as i8
        && name.buf[24] == 101 as i8 && name.buf[25] == 114 as i8 && name.buf[26] == 103 as i8
        && name.buf[27] == 101 as i8 && name.buf[28] == 110 as i8 && name.buf[29] == 99 as i8
        && name.buf[30] == 101 as i8 {
        return 2
    }
    if name.len == 32
        && name.buf[0] == 105 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 118 as i8
        && name.buf[6] == 101 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 105 as i8 && name.buf[10] == 111 as i8 && name.buf[11] == 110 as i8
        && name.buf[12] == 95 as i8 && name.buf[13] == 114 as i8 && name.buf[14] == 101 as i8
        && name.buf[15] == 115 as i8 && name.buf[16] == 112 as i8 && name.buf[17] == 111 as i8
        && name.buf[18] == 110 as i8 && name.buf[19] == 115 as i8 && name.buf[20] == 101 as i8
        && name.buf[21] == 95 as i8 && name.buf[22] == 100 as i8 && name.buf[23] == 105 as i8
        && name.buf[24] == 118 as i8 && name.buf[25] == 101 as i8 && name.buf[26] == 114 as i8
        && name.buf[27] == 103 as i8 && name.buf[28] == 101 as i8 && name.buf[29] == 110 as i8
        && name.buf[30] == 99 as i8 && name.buf[31] == 101 as i8 {
        return 3
    }
    if name.len == 25
        && name.buf[0] == 112 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 97 as i8 && name.buf[4] == 109 as i8 && name.buf[5] == 101 as i8
        && name.buf[6] == 116 as i8 && name.buf[7] == 101 as i8 && name.buf[8] == 114 as i8
        && name.buf[9] == 95 as i8 && name.buf[10] == 114 as i8 && name.buf[11] == 111 as i8
        && name.buf[12] == 108 as i8 && name.buf[13] == 101 as i8 && name.buf[14] == 95 as i8
        && name.buf[15] == 100 as i8 && name.buf[16] == 105 as i8 && name.buf[17] == 118 as i8
        && name.buf[18] == 101 as i8 && name.buf[19] == 114 as i8 && name.buf[20] == 103 as i8
        && name.buf[21] == 101 as i8 && name.buf[22] == 110 as i8 && name.buf[23] == 99 as i8
        && name.buf[24] == 101 as i8 {
        return 4
    }
    if name.len == 31
        && name.buf[0] == 115 as i8 && name.buf[1] == 116 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 117 as i8 && name.buf[4] == 99 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 117 as i8 && name.buf[7] == 114 as i8 && name.buf[8] == 97 as i8
        && name.buf[9] == 108 as i8 && name.buf[10] == 95 as i8 && name.buf[11] == 101 as i8
        && name.buf[12] == 120 as i8 && name.buf[13] == 112 as i8 && name.buf[14] == 108 as i8
        && name.buf[15] == 97 as i8 && name.buf[16] == 110 as i8 && name.buf[17] == 97 as i8
        && name.buf[18] == 116 as i8 && name.buf[19] == 105 as i8 && name.buf[20] == 111 as i8
        && name.buf[21] == 110 as i8 && name.buf[22] == 95 as i8 && name.buf[23] == 100 as i8
        && name.buf[24] == 105 as i8 && name.buf[25] == 115 as i8 && name.buf[26] == 116 as i8
        && name.buf[27] == 97 as i8 && name.buf[28] == 110 as i8 && name.buf[29] == 99 as i8
        && name.buf[30] == 101 as i8 {
        return 5
    }
    -1
}

fn audit_counterexample_field_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str10(name, 109, 111, 100, 101, 108, 95, 110, 97, 109, 101) { return 0 }
    if name_matches_str13(name, 115, 117, 98, 103, 114, 111, 117, 112, 95, 110, 97, 109, 101) { return 1 }
    if name_matches_str11(name, 109, 101, 116, 114, 105, 99, 95, 110, 97, 109, 101) { return 2 }
    if name_matches_str14(name, 111, 98, 115, 101, 114, 118, 101, 100, 95, 118, 97, 108, 117, 101) { return 3 }
    if name.len == 15
        && name.buf[0] == 116 as i8 && name.buf[1] == 104 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 104 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 100 as i8
        && name.buf[9] == 95 as i8 && name.buf[10] == 118 as i8 && name.buf[11] == 97 as i8
        && name.buf[12] == 108 as i8 && name.buf[13] == 117 as i8 && name.buf[14] == 101 as i8 {
        return 4
    }
    if name_matches_str7(name, 115, 117, 109, 109, 97, 114, 121) { return 5 }
    -1
}

fn contest_info_apply_audit(contest_info: ContestInfo, audit_info: AuditInfo, audit_id: i64) -> ContestInfo with Mut, Panic, Div {
    var next = contest_info
    next.audit_id = audit_id
    var i: i64 = 0
    while i < 8 {
        if audit_info.metric_known[i as usize] == 1 {
            next.metric_known[i as usize] = 1
            next.metric_values[i as usize] = audit_info.metric_values[i as usize]
        }
        i = i + 1
    }
    if audit_info.mechanistic_report_id >= 0 {
        next.mechanistic_report_id = audit_info.mechanistic_report_id
    }
    if audit_info.posterior_weights_id >= 0 {
        next.posterior_weights_id = audit_info.posterior_weights_id
    }
    if audit_info.counterexample_id >= 0 {
        next.counterexample_id = audit_info.counterexample_id
    }
    next
}

fn contest_matches_audit_target(contest_ty: TypeEntry, contest_info: ContestInfo, audit_info: AuditInfo) -> bool with Mut, Panic, Div, Alloc {
    contest_ty.kind == TypeKind::TyContest
    && types_compatible(knowledge_inner(contest_ty), audit_info.target_inner_ty)
    && contest_info.family_id == audit_info.family_id
    && contest_info.policy_id == audit_info.policy_id
}

// Free function, not a method: declared at column 0 with an explicit
// `self: Checker` parameter rather than inside `impl Checker`. Its two call
// sites used method syntax and drew E011 "no method named for this type" —
// the mirror of the four functions on this branch that sat INSIDE an impl and
// were called bare. Callers now use the free-function form; moving the
// declaration into the impl would work too, but relocating a 100-line body in
// a 24k-line file to fix a call syntax is the larger change.
fn contest_type_seeded_from_audit(self: Checker, audit_info: AuditInfo, audit_id: i64, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc {
    var c = self
    if audit_info.family_id < 0 || audit_info.family_id >= c.model_families.count {
        return (c.report_missing_model_family_metadata(span), ty_error())
    }
    let family_info = c.model_families.get(audit_info.family_id)
    var info = contest_info_from_family_signature(family_info, audit_info.policy_id)
    info = contest_info_attach_span(info, span)
    info = contest_info_attach_family_id(info, audit_info.family_id)
    info = contest_info_apply_audit(info, audit_info, audit_id)
    let add_result = c.contests.add(info)
    c.contests = add_result.0
    (c, ty_contest(audit_info.target_inner_ty, add_result.1))
}

fn audit_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn model_family_model_index(family: ModelFamilyInfo, model_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < family.model_count && i < 16 {
        if name_eq(family.model_names[i as usize], model_name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn contest_witness_metric_id(kind: i64) -> i64 {
    if kind == CONTEST_WITNESS_SIGN_CONSENSUS { CONTEST_METRIC_SIGN_CONSENSUS }
    else if kind == CONTEST_WITNESS_RELATIVE_BAND { CONTEST_METRIC_RELATIVE_BAND }
    else if kind == CONTEST_WITNESS_MAX_TAIL_RISK { CONTEST_METRIC_MAX_TAIL_RISK }
    else if kind == CONTEST_WITNESS_MECHANISTIC_DIVERGENCE { CONTEST_METRIC_MECHANISTIC_DIVERGENCE }
    else if kind == CONTEST_WITNESS_IDENTIFIABILITY_FLOOR { CONTEST_METRIC_IDENTIFIABILITY_FLOOR }
    else { -1 }
}

fn contest_witness_info_new(span: Span, witness_kind: i64, contest_id: i64) -> ContestWitnessInfo {
    ContestWitnessInfo {
        span_start: span.start,
        span_end: span.end,
        witness_kind: witness_kind,
        contest_id: contest_id,
    }
}

fn contest_witness_result_type(kind: i64) -> TypeEntry with Mut, Panic, Div {
    if kind == CONTEST_WITNESS_DISAGREEMENT {
        return ty_named(contest_disagreement_type_name())
    }
    if kind == CONTEST_WITNESS_COUNTEREXAMPLE {
        return ty_named(contest_counterexample_type_name())
    }
    if kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
        return ty_named(contest_weights_type_name())
    }
    ty_f64()
}

fn contest_witness_requires_metric(kind: i64) -> bool {
    kind == CONTEST_WITNESS_SIGN_CONSENSUS
    || kind == CONTEST_WITNESS_RELATIVE_BAND
    || kind == CONTEST_WITNESS_MAX_TAIL_RISK
    || kind == CONTEST_WITNESS_IDENTIFIABILITY_FLOOR
}

fn contest_witness_requires_mechanistic(kind: i64) -> bool {
    kind == CONTEST_WITNESS_MECHANISTIC_DIVERGENCE || kind == CONTEST_WITNESS_DISAGREEMENT
}

fn robust_proof_info_from_contest(contest_id: i64, contest_info: ContestInfo, policy_info: PolicyInfo, span: Span) -> RobustProofInfo with Mut, Panic, Div {
    var rp = empty_robust_proof_info()
    rp.span_start = span.start
    rp.span_end = span.end
    rp.audit_id = contest_info.audit_id
    rp.contest_id = contest_id
    rp.policy_id = contest_info.policy_id
    rp.level_id = policy_info.level_id
    rp.scope_id = policy_info.scope_id
    var i: i64 = 0
    while i < 8 {
        rp.metric_known[i as usize] = contest_info.metric_known[i as usize]
        rp.metric_values[i as usize] = contest_info.metric_values[i as usize]
        i = i + 1
    }
    rp
}

fn robustness_level_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 7
        && name.buf[0] == 70 as i8 && name.buf[1] == 114 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 103 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 108 as i8
        && name.buf[6] == 101 as i8 {
        return ROBUST_LEVEL_FRAGILE
    }
    if name.len == 11
        && name.buf[0] == 67 as i8 && name.buf[1] == 111 as i8 && name.buf[2] == 110 as i8
        && name.buf[3] == 100 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 111 as i8 && name.buf[8] == 110 as i8
        && name.buf[9] == 97 as i8 && name.buf[10] == 108 as i8 {
        return ROBUST_LEVEL_CONDITIONAL
    }
    if name.len == 6
        && name.buf[0] == 83 as i8 && name.buf[1] == 116 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 98 as i8 && name.buf[4] == 108 as i8 && name.buf[5] == 101 as i8 {
        return ROBUST_LEVEL_STABLE
    }
    if name.len == 6
        && name.buf[0] == 83 as i8 && name.buf[1] == 116 as i8 && name.buf[2] == 114 as i8
        && name.buf[3] == 111 as i8 && name.buf[4] == 110 as i8 && name.buf[5] == 103 as i8 {
        return ROBUST_LEVEL_STRONG
    }
    if name.len == 9
        && name.buf[0] == 73 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 118 as i8
        && name.buf[3] == 97 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 97 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 116 as i8 {
        return ROBUST_LEVEL_INVARIANT
    }
    -1
}

fn robustness_scope_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 14
        && name.buf[0] == 73 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 68 as i8
        && name.buf[3] == 105 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 116 as i8
        && name.buf[6] == 114 as i8 && name.buf[7] == 105 as i8 && name.buf[8] == 98 as i8
        && name.buf[9] == 117 as i8 && name.buf[10] == 116 as i8 && name.buf[11] == 105 as i8
        && name.buf[12] == 111 as i8 && name.buf[13] == 110 as i8 {
        return ROBUST_SCOPE_IN_DISTRIBUTION
    }
    if name.len == 13
        && name.buf[0] == 69 as i8 && name.buf[1] == 120 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 114 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 112 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 97 as i8
        && name.buf[9] == 116 as i8 && name.buf[10] == 105 as i8 && name.buf[11] == 118 as i8
        && name.buf[12] == 101 as i8 {
        return ROBUST_SCOPE_EXTRAPOLATIVE
    }
    if name.len == 16
        && name.buf[0] == 83 as i8 && name.buf[1] == 117 as i8 && name.buf[2] == 98 as i8
        && name.buf[3] == 103 as i8 && name.buf[4] == 114 as i8 && name.buf[5] == 111 as i8
        && name.buf[6] == 117 as i8 && name.buf[7] == 112 as i8 && name.buf[8] == 83 as i8
        && name.buf[9] == 112 as i8 && name.buf[10] == 101 as i8 && name.buf[11] == 99 as i8
        && name.buf[12] == 105 as i8 && name.buf[13] == 102 as i8 && name.buf[14] == 105 as i8
        && name.buf[15] == 99 as i8 {
        return ROBUST_SCOPE_SUBGROUP_SPECIFIC
    }
    if name.len == 16
        && name.buf[0] == 73 as i8 && name.buf[1] == 100 as i8 && name.buf[2] == 101 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 102 as i8 && name.buf[7] == 105 as i8 && name.buf[8] == 101 as i8
        && name.buf[9] == 100 as i8 && name.buf[10] == 70 as i8 && name.buf[11] == 97 as i8
        && name.buf[12] == 109 as i8 && name.buf[13] == 105 as i8 && name.buf[14] == 108 as i8
        && name.buf[15] == 121 as i8 {
        return ROBUST_SCOPE_IDENTIFIED_FAMILY
    }
    if name.len == 17
        && name.buf[0] == 84 as i8 && name.buf[1] == 114 as i8 && name.buf[2] == 97 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 115 as i8 && name.buf[5] == 112 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 114 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 101 as i8 && name.buf[10] == 100 as i8 && name.buf[11] == 68 as i8
        && name.buf[12] == 111 as i8 && name.buf[13] == 109 as i8 && name.buf[14] == 97 as i8
        && name.buf[15] == 105 as i8 && name.buf[16] == 110 as i8 {
        return ROBUST_SCOPE_TRANSPORTED_DOMAIN
    }
    -1
}

fn check_policy_requirements_against_contest(
    checker: Checker,
    span: Span,
    policy_name: Name,
    reqs: Option<Box<PolicyRequirementInfoList> >,
    contest_id: i64
) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
    match reqs {
        None => (checker, true)
        Some(list) => {
            let req = (*list).head
            if req.metric_id < 0 {
                return (checker.report_unknown_policy_metric(span, req.metric_name), false)
            }
            if contest_id < 0 || contest_id >= checker.contests.count {
                return (checker.report_missing_contest_diagnostic(span, policy_name, req, contest_id), false)
            }
            let contest_info = checker.contests.get(contest_id)
            let metric_pair = contest_info_get_metric(contest_info, req.metric_id)
            if metric_pair.0 == false {
                return (checker.report_missing_contest_diagnostic(span, policy_name, req, contest_id), false)
            }
            if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                return (checker.report_failed_policy_requirement(span, policy_name, req, metric_pair.1, contest_id), false)
            }
            check_policy_requirements_against_contest(checker, span, policy_name, (*list).tail, contest_id)
        }
    }
}

// Extract variable name from unary operand (if it's a simple ident)
fn empty_type_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn unary_operand_root_name(expr: Expr) -> Name {
    if expr.kind == ExprKind::ExprIdent {
        return expr.name
    }
    if expr.kind == ExprKind::ExprIndex {
        return unary_operand_name(expr.left)
    }
    empty_type_name()
}

fn unary_operand_name(opt: Option<Box<Expr> >) -> Name {
    match opt {
        Some(inner) => unary_operand_root_name(*inner)
        None => empty_type_name()
    }
}

fn call_ref_inner_or_self(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyRef || ty.kind == TypeKind::TyRefMut {
        match ty.inner {
            Some(inner) => *inner
            None => ty_error()
        }
    } else {
        ty
    }
}

fn indexable_elem_type(base_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if is_error_or_unknown(base_ty) {
        return base_ty
    }
    // Packed *u8 string: `s[i]` yields the zero-extended byte as i64 (same
    // surface as str_char_at). Lowering uses IrIndexGet label_id=3 (raw byte).
    if base_ty.kind == TypeKind::TyString {
        return ty_i64()
    }
    // Seq<T>[i] -> T (lean_single TY_SEQ index path).
    if is_seq_type(base_ty) {
        return seq_elem_type(base_ty)
    }
    if base_ty.kind == TypeKind::TyArray
        || base_ty.kind == TypeKind::TySlice
        || base_ty.kind == TypeKind::TySliceMut {
        match base_ty.inner {
            Some(elem_ty) => return *elem_ty
            None => return ty_error()
        }
    }
    if base_ty.kind == TypeKind::TyRef || base_ty.kind == TypeKind::TyRefMut {
        match base_ty.inner {
            Some(inner_ty) => {
                if (*inner_ty).kind == TypeKind::TyArray
                    || (*inner_ty).kind == TypeKind::TySlice
                    || (*inner_ty).kind == TypeKind::TySliceMut {
                    match (*inner_ty).inner {
                        Some(elem_ty) => return *elem_ty
                        None => return ty_error()
                    }
                }
                return ty_error()
            }
            None => return ty_error()
        }
    }
    ty_error()
}

fn len_method_supported(base_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if is_seq_type(base_ty) {
        return true
    }
    if base_ty.kind == TypeKind::TyString
        || base_ty.kind == TypeKind::TyArray
        || base_ty.kind == TypeKind::TySlice
        || base_ty.kind == TypeKind::TySliceMut {
        return true
    }
    if base_ty.kind == TypeKind::TyRef || base_ty.kind == TypeKind::TyRefMut {
        match base_ty.inner {
            Some(inner_ty) => {
                return (*inner_ty).kind == TypeKind::TyArray
                    || (*inner_ty).kind == TypeKind::TySlice
                    || (*inner_ty).kind == TypeKind::TySliceMut
            }
            None => return false
        }
    }
    false
}

fn slice_param_accepts_array_ref(arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if param_ty.kind != TypeKind::TySlice && param_ty.kind != TypeKind::TySliceMut {
        return false
    }
    if arg_ty.kind != TypeKind::TyRef && arg_ty.kind != TypeKind::TyRefMut {
        return false
    }
    if param_ty.kind == TypeKind::TySliceMut && arg_ty.kind != TypeKind::TyRefMut {
        return false
    }
    match arg_ty.inner {
        Some(arg_inner) => {
            if (*arg_inner).kind != TypeKind::TyArray {
                return false
            }
            match ((*arg_inner).inner, param_ty.inner) {
                (Some(arg_elem), Some(param_elem)) => types_compatible(*arg_elem, *param_elem),
                _ => false
            }
        }
        None => false
    }
}

fn slice_borrow_result_type(base_ty: TypeEntry, want_mut: bool) -> TypeEntry with Mut, Panic, Div, Alloc {
    if is_error_or_unknown(base_ty) {
        return base_ty
    }
    if base_ty.kind == TypeKind::TyArray {
        match base_ty.inner {
            Some(elem_ty) => {
                if want_mut { return ty_slice_mut(*elem_ty) }
                return ty_slice(*elem_ty)
            }
            None => return ty_error()
        }
    }
    if base_ty.kind == TypeKind::TySlice {
        if want_mut {
            return ty_error()
        }
        match base_ty.inner {
            Some(elem_ty) => return ty_slice(*elem_ty)
            None => return ty_error()
        }
    }
    if base_ty.kind == TypeKind::TySliceMut {
        match base_ty.inner {
            Some(elem_ty) => {
                if want_mut { return ty_slice_mut(*elem_ty) }
                return ty_slice(*elem_ty)
            }
            None => return ty_error()
        }
    }
    if base_ty.kind == TypeKind::TyRef || base_ty.kind == TypeKind::TyRefMut {
        match base_ty.inner {
            Some(inner_ty) => {
                if (*inner_ty).kind == TypeKind::TyArray {
                    match (*inner_ty).inner {
                        Some(elem_ty) => {
                            if want_mut {
                                if base_ty.kind == TypeKind::TyRefMut { return ty_slice_mut(*elem_ty) }
                                return ty_error()
                            }
                            return ty_slice(*elem_ty)
                        }
                        None => return ty_error()
                    }
                }
                if (*inner_ty).kind == TypeKind::TySlice {
                    if want_mut {
                        return ty_error()
                    }
                    match (*inner_ty).inner {
                        Some(elem_ty) => return ty_slice(*elem_ty)
                        None => return ty_error()
                    }
                }
                if (*inner_ty).kind == TypeKind::TySliceMut {
                    match (*inner_ty).inner {
                        Some(elem_ty) => {
                            if want_mut {
                                if base_ty.kind == TypeKind::TyRefMut { return ty_slice_mut(*elem_ty) }
                                return ty_error()
                            }
                            return ty_slice(*elem_ty)
                        }
                        None => return ty_error()
                    }
                }
                ty_error()
            }
            None => ty_error()
        }
    } else {
        ty_error()
    }
}

fn expr_is_half_open_range(opt: Option<Box<Expr> >) -> bool {
    match opt {
        Some(expr) => (*expr).kind == ExprKind::ExprRange && (*expr).bin_op == BinaryOp::OpRange
        None => false
    }
}

fn eval_const_int_opt_expr(c: Checker, opt: Option<Box<Expr> >) -> (i64, i64) with Mut, Panic, Div, Alloc {
    match opt {
        Some(inner) => {
            let e = *inner
            if e.kind == ExprKind::ExprIntLit {
                return (1, e.int_val)
            }
            if e.kind == ExprKind::ExprIdent {
                let lookup_pair = c.const_int_lookup(e.name)
                if lookup_pair.0 != false {
                    return (1, lookup_pair.1)
                }
                return (0, 0)
            }
            if e.kind == ExprKind::ExprUnary && e.un_op == UnaryOp::OpNeg {
                let inner_pair = eval_const_int_opt_expr(c, e.left)
                if inner_pair.0 != 0 {
                    return (1, 0 - inner_pair.1)
                }
                return (0, 0)
            }
            if e.kind == ExprKind::ExprBinary {
                let left_pair = eval_const_int_opt_expr(c, e.left)
                let right_pair = eval_const_int_opt_expr(c, e.right)
                if left_pair.0 == 0 || right_pair.0 == 0 {
                    return (0, 0)
                }
                let lv = left_pair.1
                let rv = right_pair.1
                if e.bin_op == BinaryOp::OpAdd {
                    return (1, lv + rv)
                } else if e.bin_op == BinaryOp::OpSub {
                    return (1, lv - rv)
                } else if e.bin_op == BinaryOp::OpMul {
                    return (1, lv * rv)
                } else if e.bin_op == BinaryOp::OpDiv {
                    if rv == 0 { return (0, 0) }
                    return (1, lv / rv)
                } else if e.bin_op == BinaryOp::OpRem {
                    if rv == 0 { return (0, 0) }
                    return (1, lv % rv)
                }
            }
            (0, 0)
        }
        None => (0, 0)
    }
}

fn checker_expr_is_int_literal_like(e: Expr) -> bool {
    if e.kind == ExprKind::ExprIntLit {
        return true
    }
    if e.kind == ExprKind::ExprUnary && e.un_op == UnaryOp::OpNeg {
        match e.left {
            Some(inner) => (*inner).kind == ExprKind::ExprIntLit
            None => false
        }
    } else {
        false
    }
}

fn checker_expr_list_all_int_literals(opt: Option<Box<ExprList> >) -> bool with Mut {
    var cur = opt
    var done = false
    while !done {
        match cur {
            Some(list) => {
                if !checker_expr_is_int_literal_like((*list).head) {
                    return false
                }
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    true
}

fn checker_expected_accepts_int_literal(actual_ty: TypeEntry, expected_ty: TypeEntry) -> bool {
    actual_ty.kind == TypeKind::TyI64 && is_integer_type(expected_ty)
}

// Float-literal contextual coercion, the mirror of the int-literal path above.
// Int literals are born i64 and adopt any integer type; float literals are born
// f64 and adopted NOTHING, so `let x: f32 = 1.5` and passing 1.5 to an f32
// parameter both rejected. That is what forced `as f32` everywhere -- and the
// as-f32 lowering was silently truncating (see tests/witness_matrix w4b).
fn checker_expr_is_float_literal_like(e: Expr) -> bool {
    if e.kind == ExprKind::ExprFloatLit {
        return true
    }
    if e.kind == ExprKind::ExprUnary && e.un_op == UnaryOp::OpNeg {
        match e.left {
            Some(inner) => (*inner).kind == ExprKind::ExprFloatLit
            None => false
        }
    } else {
        false
    }
}

fn checker_float_literal_magnitude(e: Expr) -> f64 {
    var v: f64 = 0.0
    if e.kind == ExprKind::ExprFloatLit {
        v = e.float_val
    } else {
        match e.left {
            Some(inner) => { v = (*inner).float_val }
            None => { v = 0.0 }
        }
    }
    if v < 0.0 { 0.0 - v } else { v }
}

// CARDINAL: only LITERALS coerce, and never out of range. A float literal wider
// than f32 max must still REJECT -- the literal-holes round found `let x: f32 =
// 1e300` being accepted once the coercion was added without this guard.
fn checker_expected_accepts_float_literal(e: Expr, actual_ty: TypeEntry, expected_ty: TypeEntry) -> bool {
    if actual_ty.kind != TypeKind::TyF64 {
        return false
    }
    if !is_float_type(expected_ty) {
        return false
    }
    if expected_ty.kind == TypeKind::TyF64 {
        return true
    }
    checker_float_literal_magnitude(e) <= 3.4028235e38
}

fn checker_array_sizes_compatible(actual_ty: TypeEntry, expected_ty: TypeEntry) -> bool {
    if actual_ty.array_size == -1 || expected_ty.array_size == -1 {
        return true
    }
    actual_ty.array_size == expected_ty.array_size
}

fn checker_array_int_literal_compatible(e: Expr, actual_ty: TypeEntry, expected_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprArrayLit {
        return false
    }
    if actual_ty.kind != TypeKind::TyArray || expected_ty.kind != TypeKind::TyArray {
        return false
    }
    if !checker_array_sizes_compatible(actual_ty, expected_ty) {
        return false
    }
    match actual_ty.inner {
        Some(actual_inner) => match expected_ty.inner {
            Some(expected_inner) => {
                if !checker_expected_accepts_int_literal(*actual_inner, *expected_inner) {
                    return false
                }
                match e.left {
                    Some(elem_box) => checker_expr_is_int_literal_like(*elem_box)
                    None => checker_expr_list_all_int_literals(e.args)
                }
            }
            None => false
        }
        None => false
    }
}

fn checker_contextual_expr_compatible(expr: Expr, actual_ty: TypeEntry, expected_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if types_compatible(actual_ty, expected_ty) {
        return true
    }
    if checker_expr_is_int_literal_like(expr) && checker_expected_accepts_int_literal(actual_ty, expected_ty) {
        return true
    }
    if checker_expr_is_float_literal_like(expr) && checker_expected_accepts_float_literal(expr, actual_ty, expected_ty) {
        return true
    }
    checker_array_int_literal_compatible(expr, actual_ty, expected_ty)
}

// Function-body return compatibility: like contextual expr compatibility, but the body
// expression is not directly available here. Use the checker's last_literal_kind to detect
// that the final expression was an integer literal, so `fn f() -> i32 { 0 }` checks OK.
fn checker_fn_body_return_compatible_inplace(c: *mut Checker, body_ty: TypeEntry, return_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc, IO {
    if checker_types_compatible_inplace(c, body_ty, return_ty) {
        return true
    }
    let int_lit_narrow = (*c).last_literal_kind == 1
        && body_ty.kind == TypeKind::TyI64
        && is_integer_type(return_ty)
    let body_enum = body_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, body_ty.name) >= 0
    let ret_enum = return_ty.kind == TypeKind::TyNamed && enum_table_find((*c).enums, return_ty.name) >= 0
    let enum_int_ok = (body_enum && is_numeric_type(return_ty)) || (is_numeric_type(body_ty) && ret_enum)
    int_lit_narrow || enum_int_ok
}

fn call_arg_types_compatible(arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if checker_contextual_expr_compatible(arg_expr, arg_ty, param_ty) {
        return true
    }
    // Directional borrow boundary: &!T can flow to &T.
    if param_ty.kind == TypeKind::TyRef && arg_ty.kind == TypeKind::TyRefMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if param_ty.kind == TypeKind::TySlice && arg_ty.kind == TypeKind::TySliceMut {
        return types_compatible_inner(arg_ty.inner, param_ty.inner)
    }
    if slice_param_accepts_array_ref(arg_ty, param_ty) {
        return true
    }
    // Allow implicit borrow syntax at call boundaries: f(&T) <- x
    if arg_expr.kind == ExprKind::ExprIdent &&
       (param_ty.kind == TypeKind::TyRef || param_ty.kind == TypeKind::TyRefMut) {
        return types_compatible(arg_ty, call_ref_inner_or_self(param_ty))
    }
    false
}

// ============================================================
// Lower AST TypeExpr to internal TypeEntry
// ============================================================

impl Checker {
    fn lower_ref_like_type(self, inner_te: TypeExpr, is_mut_ref: bool) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if inner_te.kind == TypeExprKind::TypeArray {
            match inner_te.array_size {
                None => {
                    match inner_te.inner {
                        Some(elem_te) => {
                            let pair = self.lower_type_expr(*elem_te)
                            let c = pair.0
                            if is_mut_ref {
                                return (c, ty_slice_mut(pair.1))
                            }
                            return (c, ty_slice(pair.1))
                        }
                        None => return (self, ty_error())
                    }
                }
                Some(_) => {}
            }
        }
        let pair = self.lower_type_expr(inner_te)
        let c = pair.0
        let inner_ty = pair.1
        if is_mut_ref {
            (c, ty_ref_mut(inner_ty))
        } else {
            (c, ty_ref(inner_ty))
        }
    }

    fn lower_type_expr(self, te: TypeExpr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check type depth limit
        let depth_pair = self.check_type_depth(te.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        // Check complexity budget (cost = 1 for each type node)
        let complexity_pair = c.check_complexity(1, te.span)
        c = complexity_pair.0
        if !complexity_pair.1 {
            return (c.exit_type_depth(), ty_error())
        }
        if checker_type_expr_contains_reserved_wide_float(&te) {
            let blocked = c.report_error_at(te.span, 249, 0, 0, 0)
            return (blocked.exit_type_depth(), ty_error())
        }
        let result = match te.kind {
            TypeExprKind::TypeNamed => c.lower_named_type_with_args(te.path, te.type_args)
            TypeExprKind::TypeUnit => (c, ty_unit())
            TypeExprKind::TypeNever => (c, ty_never())
            TypeExprKind::TypeInfer => (c, ty_unknown())
            TypeExprKind::TypeSelfUpper => (c, c.current_impl_type)
            TypeExprKind::TypeReference => c.lower_ref_type(te.inner)
            TypeExprKind::TypeRefMut => c.lower_ref_mut_type(te.inner)
            TypeExprKind::TypeRawPtr => c.lower_raw_ptr_type(te.inner, te.array_size)
            TypeExprKind::TypeArray => c.lower_array_type(te.inner, te.array_size)
            TypeExprKind::TypeTuple => c.lower_tuple_type(te.type_args)
            TypeExprKind::TypeFn => c.lower_fn_type_expr(te)
            TypeExprKind::TypeKnowledge => c.lower_knowledge_type(te.knowledge_info)
            TypeExprKind::TypeModel => c.lower_model_type(te.type_args, te.span)
            TypeExprKind::TypePolicy => c.lower_policy_type(te.type_args, te.span)
            TypeExprKind::TypeAcquisitionPolicy => c.lower_acquisition_policy_type(te.type_args, te.span)
            TypeExprKind::TypeAcquisitionPlan => c.lower_acquisition_plan_type(te.type_args, te.span)
            TypeExprKind::TypeRecoursePolicy => c.lower_recourse_policy_type(te.type_args, te.span)
            TypeExprKind::TypeRecoursePlan => c.lower_recourse_plan_type(te.type_args, te.span)
            TypeExprKind::TypeTransitionPolicy => c.lower_transition_policy_type(te.type_args, te.span)
            TypeExprKind::TypeTransitionPlan => c.lower_transition_plan_type(te.type_args, te.span)
            TypeExprKind::TypeMonitoringPolicy => c.lower_monitoring_policy_type(te.type_args, te.span)
            TypeExprKind::TypeObservedTransition => c.lower_observed_transition_type(te.type_args, te.span)
            TypeExprKind::TypeRollbackCertificate => c.lower_rollback_certificate_type(te.type_args, te.span)
            TypeExprKind::TypeAlternativePolicy => c.lower_alternative_policy_type(te.type_args, te.span)
            TypeExprKind::TypeAlternativeSet => c.lower_alternative_set_type(te.type_args, te.span)
            TypeExprKind::TypeAlternativeOption => c.lower_alternative_option_type(te.type_args, te.span)
            TypeExprKind::TypeDecisionPolicy => c.lower_decision_policy_type(te.type_args, te.span)
            TypeExprKind::TypeDeferralPolicy => c.lower_deferral_policy_type(te.type_args, te.span)
            TypeExprKind::TypeContest => c.lower_contest_type(te.type_args, te.span)
            TypeExprKind::TypeRobust => c.lower_robust_type(te.type_args, te.span)
            TypeExprKind::TypeIntervention => c.lower_intervention_type(te.knowledge_info)
            TypeExprKind::TypeCounterfactual => c.lower_counterfactual_type(te.knowledge_info)
            TypeExprKind::TypeValidated => c.lower_validated_type(te.type_args, te.knowledge_info, te.span)
            TypeExprKind::TypeAdmissible => c.lower_admissible_type(te.type_args, te.span)
            TypeExprKind::TypeDeferred => c.lower_deferred_type(te.type_args, te.span)
            TypeExprKind::TypeRefinement => c.lower_refinement_type(te.refinement_info)
            TypeExprKind::TypeChan => c.lower_chan_type(te.inner)
            TypeExprKind::TypeSession => (c, ty_session_end())
            // Sprint 27: Annotation syntax
            TypeExprKind::TypeDiffPrivate => c.lower_diffprivate_type(te.type_args, te.span)
            TypeExprKind::TypeDPBudget => c.lower_dp_budget_type(te.type_args, te.span)
            TypeExprKind::TypeCausalEffect => c.lower_causal_effect_annotation(te.type_args, te.span)
            TypeExprKind::TypeAleatoric => c.lower_aleatoric_annotation(te.type_args, te.span)
            TypeExprKind::TypePotentialOutcome => c.lower_potential_outcome_type(te.type_args, te.span)
            TypeExprKind::TypeProof => c.lower_proof_annotation(te.type_args, te.span)
            TypeExprKind::TypeLemma => c.lower_lemma_annotation(te.type_args, te.span)
            TypeExprKind::TypeAxiom => c.lower_axiom_annotation(te.type_args, te.span)
            TypeExprKind::TypeForgettable => c.lower_forgettable_type(te.inner, te.span)
            TypeExprKind::TypeExactlyPrivate => c.lower_exactly_private_type(te.inner, te.type_args, te.span)
            TypeExprKind::TypeEditable => c.lower_editable_type(te.inner, te.span)
            TypeExprKind::TypeCapabilityGated => c.lower_capability_gated_type(te.inner, te.span)
            TypeExprKind::TypeComposable => c.lower_composable_type(te.inner, te.span)
            TypeExprKind::TypeAudited => c.lower_audited_type(te.inner, te.span)
            TypeExprKind::TypeRevivable => c.lower_revivable_type(te.inner, te.span)
            TypeExprKind::TypeInterpretable => c.lower_interpretable_type(te.inner, te.span)
        }
        (result.0.exit_type_depth(), result.1)
    }

    fn lower_chan_type(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let proto = pair.1
                (c, ty_chan(proto))
            }
            None => (self, ty_session_end())
        }
    }

    fn lower_named_type_with_args(self, path: AstPath, type_args: Option<Box<TypeExprList> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match type_args {
            None => self.lower_named_type(path)
            Some(args) => {
                let name = checker_copy_string_list_to_name(path.segments)

                // Hyper<Algebra, T> — checker-level hyper type now lowered from source.
                if name_matches_str5(name, 72, 121, 112, 101, 114) {
                    let alg_expr = (*args).head
                    var elem_expr = alg_expr
                    match (*args).tail {
                        Some(rest) => {
                            elem_expr = (*rest).head
                        }
                        None => {
                            let c = self.report_error_at(alg_expr.span, 1, 0, 0, 0)
                            return (c, ty_error())
                        }
                    }
                    if alg_expr.kind != TypeExprKind::TypeNamed {
                        let c = self.report_error_at(alg_expr.span, 1, 0, 0, 0)
                        return (c, ty_error())
                    }
                    let alg_name = checker_copy_string_list_to_name(alg_expr.path.segments)
                    let algebra_tag = resolve_algebra_name(alg_name)
                    if algebra_tag < 0 {
                        let c = self.report_error_at(alg_expr.span, 1, 0, 0, 0)
                        return (c, ty_error())
                    }
                    let elem_pair = self.lower_type_expr(elem_expr)
                    let c = elem_pair.0
                    let elem_ty = elem_pair.1
                    return (c, ty_hyper(algebra_tag, elem_ty))
                }

                // Unobserved<T> — observer type-state wrapper
                if name_matches_str10(name, 85, 110, 111, 98, 115, 101, 114, 118, 101, 100) {
                    let inner_result = self.lower_type_expr_list(*args)
                    let c = inner_result.0
                    let inner_args = inner_result.1
                    let inner_ty = inner_args.head
                    var te = ty_error()
                    te.kind = TypeKind::TyUnobserved
                    te.name = name
                    te.inner = Some(Box::new(inner_ty))
                    return (c, te)
                }

                // Box<T> — heap pointer wrapper. Carry the element type T as
                // `inner` so deref (`*b`) of a declared `Box<T>` parameter types
                // as T (via unary_result_type's OpDeref) instead of E005. kind
                // stays TyNamed("Box"), so call-site matching is unchanged
                // (Box::new(...) is TyUnknown and matches regardless), and this
                // mirrors how `&T` carries its pointee via ty_ref.
                if name_matches_str3(name, 66, 111, 120) {
                    let inner_result = self.lower_type_expr_list(*args)
                    let c = inner_result.0
                    let inner_args = inner_result.1
                    let inner_ty = inner_args.head
                    var te = ty_named(name)
                    te.inner = Some(Box::new(inner_ty))
                    return (c, te)
                }

                // IndepKnowledge<T, A, B | Z> — conditional independence as a type.
                // The parser guarantees the shape [T, A, B] or [T, A, B, Tuple(Z)];
                // a shorter list can only come from a malformed claim.
                if name_matches_str14(name, 73, 110, 100, 101, 112, 75, 110, 111, 119, 108, 101, 100, 103, 101) {
                    let t_expr = (*args).head
                    let rest1 = match (*args).tail {
                        None => {
                            let c = self.report_error_at(t_expr.span, 72, 0, 0, 0)
                            return (c, ty_error())
                        }
                        Some(r) => *r
                    }
                    let a_expr = rest1.head
                    let rest2 = match rest1.tail {
                        None => {
                            let c = self.report_error_at(a_expr.span, 72, 0, 0, 0)
                            return (c, ty_error())
                        }
                        Some(r) => *r
                    }
                    let b_expr = rest2.head

                    // A and B name variables, not types. Anything else is a claim
                    // about something that cannot be a variable, and the checker
                    // would otherwise silently give both the same empty identity.
                    if a_expr.kind != TypeExprKind::TypeNamed {
                        let c = self.report_error_at(a_expr.span, 72, 0, 0, 0)
                        return (c, ty_error())
                    }
                    if b_expr.kind != TypeExprKind::TypeNamed {
                        let c = self.report_error_at(b_expr.span, 72, 0, 0, 0)
                        return (c, ty_error())
                    }

                    let cond_id = match rest2.tail {
                        None => 0 - 1
                        Some(r) => indep_cond_set_id((*r).head)
                    }

                    let t_pair = self.lower_type_expr(t_expr)
                    var c = t_pair.0
                    let base_ty = t_pair.1

                    let a_id = indep_var_id(checker_copy_string_list_to_name(a_expr.path.segments))
                    let b_id = indep_var_id(checker_copy_string_list_to_name(b_expr.path.segments))

                    // The rule is spelled out here rather than delegated to
                    // check_cond_indep_type in check/epistemic.sio: that module is
                    // imported by nothing, and an unresolved name in this compiler
                    // is a warning that compiles to zero — the guard would pass
                    // every claim while appearing to check them.
                    //
                    // A variable is not independent of itself. The claim would
                    // assert nothing, and asserting nothing is how an unfounded
                    // quadrature gets licensed.
                    if a_id == b_id {
                        let c2 = c.report_error_at(b_expr.span, 72, 0, 0, 0)
                        return (c2, ty_error())
                    }

                    // With a graph declared in source, the claim stops being an
                    // assertion and becomes an obligation: A and B must name
                    // nodes of that graph, and the graph must d-separate them
                    // given Z. Without a declared graph nothing can discharge
                    // it, and only the degeneracy rule above applies.
                    if CG_DECLARED == 1 {
                        let a_node = ast_cg_find_node(a_id)
                        if a_node < 0 {
                            let c3 = c.report_error_at(a_expr.span, 254, 0, 0, 0)
                            return (c3, ty_error())
                        }
                        let b_node = ast_cg_find_node(b_id)
                        if b_node < 0 {
                            let c4 = c.report_error_at(b_expr.span, 254, 0, 0, 0)
                            return (c4, ty_error())
                        }
                        let cond_args = match rest2.tail {
                            None => None
                            Some(zr) => (*zr).head.type_args
                        }
                        let zpair = checker_cg_zset(cond_args)
                        if !zpair.0 {
                            let c5 = c.report_error_at(b_expr.span, 254, 0, 0, 0)
                            return (c5, ty_error())
                        }
                        let g = checker_cg_build()
                        if !causal_d_separated(g, a_node, b_node, zpair.1) {
                            let c6 = c.report_error_at(b_expr.span, 255, 0, 0, 0)
                            return (c6, ty_error())
                        }
                    }

                    // confidence unset (-1.0): the claim carries no probability
                    // level of its own, only the structural assertion.
                    let ci = ty_cond_indep(base_ty, a_id, b_id, cond_id, 0.0 - 1.0)
                    return (c, ci)
                }

                let tmpl_idx = struct_table_find(self.structs, name)
                if tmpl_idx >= 0 {
                    let tmpl = struct_table_get(self.structs, tmpl_idx)
                    if tmpl.is_generic_template {
                        // Lower the type arguments
                        let args_result = self.lower_type_expr_list(*args)
                        var c = args_result.0
                        let lowered_args = args_result.1
                        let tmpl_name = tmpl.name
                        let tmpl_fields = field_info_list_clone(&tmpl.fields)
                        let tmpl_tp_buf = TypeParamBuf { names: tmpl.type_param_names, count: tmpl.type_param_count }
                        let tmpl_is_linear = tmpl.is_linear
                        let tmpl_visibility_kind = tmpl.visibility_kind
                        let tmpl_defining_module_id = tmpl.defining_module_id
                        let tmpl_visibility = tmpl.visibility
                        let tmpl_defining_module = tmpl.defining_module

                        // Build mangled name: Name__arg1__arg2
                        let mangled = mangle_generic_name(&tmpl_name, &lowered_args)

                        // Check if already monomorphized
                        let existing_idx = struct_table_find(c.structs, mangled)
                        if existing_idx >= 0 {
                            (c, ty_named(mangled))
                        } else {
                            // Monomorphize: substitute type params in fields
                            let mono_fields = monomorphize_fields(tmpl_fields, tmpl_tp_buf, &lowered_args)
                            let mono_info = StructInfo {
                                name: mangled,
                                fields: mono_fields.0,
                                field_count: mono_fields.1,
                                is_linear: tmpl_is_linear,
                            type_param_count: 0,
                            type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
                            is_generic_template: false,
                            visibility_kind: tmpl_visibility_kind,
                            defining_module_id: tmpl_defining_module_id,
                            visibility: tmpl_visibility,
                            defining_module: tmpl_defining_module,
                            }
                            struct_table_add(c.structs, mono_info)
                            (c, ty_named(mangled))
                        }
                    } else {
                        // Non-generic struct used with type args — fall through to named
                        self.lower_named_type(path)
                    }
                } else {
                    // Not a struct — try standard named type resolution
                    self.lower_named_type(path)
                }
            }
        }
    }

    fn record_hyper_expr(self, span: Span, algebra_tag: i64, op_kind: i64, knowledge_wrapped: bool) -> Checker with Mut, Panic, Div {
        if algebra_tag < 0 || op_kind <= 0 {
            return self
        }
        var c = self
        let info = HyperExprInfo {
            span_start: span.start,
            span_end: span.end,
            algebra_tag: algebra_tag,
            op_kind: op_kind,
            knowledge_wrapped: knowledge_wrapped,
        }
        let add_result = c.hyper_exprs.add(info)
        c.hyper_exprs = add_result.0
        c
    }

    fn lower_named_type(self, path: AstPath) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let name = checker_copy_string_list_to_name(path.segments)
        if name_is_i8(name) {
            (self, ty_i8())
        } else if name_is_i32(name) {
            (self, ty_i32())
        } else if name_is_i64(name) {
            (self, ty_i64())
        } else if name_is_u8(name) {
            (self, ty_u8())
        } else if name_is_u32(name) {
            (self, ty_u32())
        } else if name_is_u64(name) {
            (self, ty_u64())
        } else if name_is_usize(name) {
            (self, ty_i64())
        } else if name_is_f32(name) {
            (self, ty_f32())
        } else if name_is_f64(name) {
            (self, ty_f64())
        } else if name_is_f128(name) {
            (self, ty_f128())
        } else if name_is_f256(name) {
            (self, ty_f256())
        } else if name_is_bool(name) {
            (self, ty_bool())
        } else if name_is_string(name) {
            (self, ty_string())
        } else if name_is_char(name) {
            (self, ty_char())
        } else if name_is_i128(name) {
            (self, ty_i128())
        } else if name_is_u128(name) {
            (self, ty_u128())
        } else if name_wide_int_bits(name) > 0 {
            (self, ty_wide_int(name_wide_int_bits(name), (name.buf[0] as i64) == 105))
        } else {
            // Check if it's a registered unit name (mg, kg, m, s, etc.)
            let unit_idx = self.units.find(name)
            if unit_idx >= 0 {
                // Units resolve to f64 with a unit_id annotation
                (self, ty_with_unit(ty_f64(), unit_idx))
            } else {
                // Check if it's a refinement type alias
                let ref_idx = refinement_table_find(self.refinements, name)
                if ref_idx >= 0 {
                    // Resolve to base type with refinement_id annotation
                    let rt = self.refinements.entries[ref_idx as usize]
                    (self, ty_with_refinement(rt.base_type, ref_idx))
                } else {
                    let bound_ty = self.env.lookup(name)
                    if bound_ty.ontology_id >= 0
                        || bound_ty.kind == TypeKind::TyModel
                        || bound_ty.kind == TypeKind::TyModelFamily
                        || bound_ty.kind == TypeKind::TyPolicy
                        || bound_ty.kind == TypeKind::TyAcquisitionPolicy
                        || bound_ty.kind == TypeKind::TyAcquisitionPlan
                        || bound_ty.kind == TypeKind::TyRecoursePolicy
                        || bound_ty.kind == TypeKind::TyRecoursePlan
                        || bound_ty.kind == TypeKind::TyTransitionPolicy
                        || bound_ty.kind == TypeKind::TyTransitionPlan
                        || bound_ty.kind == TypeKind::TyMonitoringPolicy
                        || bound_ty.kind == TypeKind::TyDecisionPolicy
                        || bound_ty.kind == TypeKind::TyDeferralPolicy
                        || bound_ty.kind == TypeKind::TyValidation {
                        (self, bound_ty)
                    } else if bound_ty.kind != TypeKind::TyUnknown && bound_ty.kind != TypeKind::TyError && bound_ty.kind != TypeKind::TyNever {
                        (self, bound_ty)
                    } else {
                        (self, ty_named(name))
                    }
                }
            }
        }
    }

    fn lower_ref_type(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => self.lower_ref_like_type(*inner_te, false)
            None => (self, ty_error())
        }
    }

    fn lower_ref_mut_type(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => self.lower_ref_like_type(*inner_te, true)
            None => (self, ty_error())
        }
    }

    fn lower_raw_ptr_type(self, opt: Option<Box<TypeExpr> >, mut_flag: Option<Box<Expr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                (pair.0, ty_raw_ptr(pair.1, option_expr_is_some(mut_flag)))
            }
            None => (self, ty_error())
        }
    }

    fn lower_array_type(self, inner_opt: Option<Box<TypeExpr> >, size_opt: Option<Box<Expr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                let c = pair.0
                let elem_ty = pair.1
                let size = lower_array_size(size_opt)
                (c, ty_array(elem_ty, size))
            }
            None => (self, ty_error())
        }
    }

    fn lower_tuple_type(self, opt: Option<Box<TypeExprList> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tel) => {
                let pair = self.lower_type_expr_list(*tel)
                (pair.0, ty_tuple(pair.1))
            }
            None => (self, ty_unit())
        }
    }

    fn lower_type_expr_list(self, tel: TypeExprList) -> (Checker, TypeEntryList) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(tel.head)
        var c = pair.0
        let head_ty = pair.1
        let head_entry = TypeEntryList { head: head_ty, tail: None }
        match tel.tail {
            None => (c, head_entry)
            Some(rest) => {
                let pair2 = c.lower_type_expr_list(*rest)
                c = pair2.0
                let rest_list = pair2.1
                (c, TypeEntryList { head: head_ty, tail: Some(Box::new(rest_list)) })
            }
        }
    }

    // Sprint 231: Lower fn(T1, T2) -> U with E1, E2 into a proper TyFn
    fn lower_fn_type_expr(self, te: TypeExpr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // 1. Lower parameter types from te.type_args (TypeExprList)
        var params: Option<Box<FnParamList> > = None
        var param_count: i64 = 0
        match te.type_args {
            Some(tel) => {
                let r = c.lower_fn_type_params(*tel, 0)
                c = r.checker
                params = r.params
                param_count = r.count
            }
            _ => {}
        }
        // 2. Lower return type from te.inner
        var ret_ty = ty_unit()
        match te.inner {
            Some(inner_te) => {
                let pair = c.lower_type_expr(*inner_te)
                c = pair.0
                ret_ty = pair.1
            }
            _ => {}
        }
        // 3. Extract effects from te.effects (EffectList)
        var effects: [i64; 8] = [0; 8]
        var effect_count: i64 = 0
        let epistemic_min_confidence = epistemic_min_confidence_from_effects(te.effects)
        match te.effects {
            Some(eff_list) => {
                let ep = c.extract_effect_ids(*eff_list)
                effects = ep.0
                effect_count = ep.1
            }
            _ => {}
        }
        // 4. Create FnSig and add to table
        let sig = FnSig {
            name: Name { buf: [0; 128], len: 0 },
            params: params,
            param_count: param_count,
            return_type: ret_ty,
            is_method: false,
            self_type_name: Name { buf: [0; 128], len: 0 },
            self_type_entry: ty_unit(),
            effects: effects,
            effect_count: effect_count,
            is_kernel: false,
            is_epistemic_kernel: false,
            is_extern: false,
            is_linear_closure: false,
            linear_capture_count: 0,
            epistemic_epsilon: 0.0 - 1.0,
            epistemic_min_confidence: epistemic_min_confidence,
            visibility_kind: VISIBILITY_PUB,
            defining_module_seg_count: 0,
            defining_module_id: 0,
            visibility: visibility_pub(),
            defining_module: empty_path(),
        }
        let sig_id = fn_sig_table_add(c.fn_sigs, sig)
        (c, ty_fn(sig_id))
    }

    // Sprint 231: Convert TypeExprList (fn type params) to FnParamList
    fn lower_fn_type_params(self, tel: TypeExprList, idx: i64) -> LowerFnTypeParamsResult with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(tel.head)
        var c = pair.0
        let param_ty = pair.1
        // Synthesize parameter name: _p0, _p1, ...
        var pname = Name { buf: [0; 128], len: 0 }
        pname.buf[0] = 95   // '_'
        pname.buf[1] = 112  // 'p'
        pname.buf[2] = (48 + idx) as i8  // '0'+idx
        pname.len = 3
        let param_info = FnParamInfo { name: pname, ty: param_ty }
        match tel.tail {
            None => {
                let pl = FnParamList { head: param_info, tail: None }
                LowerFnTypeParamsResult { checker: c, params: Some(Box::new(pl)), count: idx + 1 }
            }
            Some(rest) => {
                let r2 = c.lower_fn_type_params(*rest, idx + 1)
                c = r2.checker
                let rest_params = r2.params
                let total = r2.count
                let pl = FnParamList { head: param_info, tail: rest_params }
                LowerFnTypeParamsResult { checker: c, params: Some(Box::new(pl)), count: total }
            }
        }
    }

    // Sprint 231: Extract effect IDs from EffectList
    fn extract_effect_ids(self, eff_list: EffectList) -> ([i64; 8], i64) with Mut, Panic, Div {
        var effects: [i64; 8] = [0; 8]
        var count: i64 = 0
        let eid = effect_name_to_id(eff_list.head.name_buf, eff_list.head.name_len)
        if eid >= 0 && count < 8 {
            effects[count] = eid
            count = count + 1
        }
        var current = eff_list.tail
        while true {
            match current {
                Some(rest) => {
                    let rid = effect_name_to_id((*rest).head.name_buf, (*rest).head.name_len)
                    if rid >= 0 && count < 8 {
                        effects[count] = rid
                        count = count + 1
                    }
                    current = (*rest).tail
                }
                _ => break
            }
        }
        (effects, count)
    }

    fn lower_opt_type(self, opt: Option<Box<TypeExpr> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    fn robust_type_tag_from_type_expr(self, te: TypeExpr, is_level: bool) -> i64 with Mut, Panic, Div, Alloc, IO {
        if te.kind != TypeExprKind::TypeNamed {
            return -1
        }
        let name = checker_copy_string_list_to_name(te.path.segments)
        if is_level {
            robustness_level_id_from_name(name)
        } else {
            robustness_scope_id_from_name(name)
        }
    }

    fn lower_knowledge_type(self, opt: Option<Box<KnowledgeTypeInfo> >) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(info) => check_knowledge_type(self, *info)
            None => (self, ty_error())
        }
    }

    // Forgettable<T>: lowers to the inner type T while enforcing that the
    // enclosing function declares the ZD effect (ID 18). If not declared,
    // error code 200 is emitted:
    // "Forgettable type requires ZD effect: exact annihilation is only possible
    //  via zero-divisor algebra. Division algebras cannot satisfy this guarantee."
    fn lower_forgettable_type(self, inner_opt: Option<Box<TypeExpr> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            None => (self, ty_error())
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                var c = pair.0
                let inner_ty = pair.1
                let zd_id = 18  // ZD effect ID from effects.sio
                if !has_effect_id(c.current_effects, c.current_effect_count, zd_id) {
                    c = c.report_error_at(span, 200, 0, 0, 0)
                }
                (c, inner_ty)
            }
        }
    }

    // ExactlyPrivate<T> (G3): training-data contribution algebraically zero in the
    // ZD kernel. Requires `with ZD`; missing effect emits error 201.
    fn lower_exactly_private_type(self, inner_opt: Option<Box<TypeExpr> >, locus_opt: Option<Box<TypeExprList> >, span: Span) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match inner_opt {
            None => (self, ty_error())
            Some(inner_te) => {
                let pair = self.lower_type_expr(*inner_te)
                var c = pair.0
                let inner_ty = pair.1
                let zd_id = 18
                if !has_effect_id(c.current_effects, c.current_effect_count, zd_id) {
                    c = c.report_error_at(span, 201, 0, 0, 0)
                }
                match locus_opt {
                    None => {}
                    Some(largs) => {
                        let lname = checker_copy_string_list_to_name((*largs).head.path.segments)
                        if !zd_locus_is_wellformed(lname) {
                            c = c.report_error_at(span, 247, 0, 0, 0)
                        }
                    }
                }
                (c, inner_ty)
            }
        }
    }

