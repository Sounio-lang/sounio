// Borrow checker — single-pass ownership and borrowing verification
//
// Tracks per-variable borrow state: Owned, SharedBorrow(n), ExclusiveBorrow
// Enforces:
//   - &x: fails if exclusive borrow is active
//   - &!x: fails if any borrow is active
//   - linear struct: must be consumed exactly once
//   - Scope exit: releases borrows created in that scope

// ============================================================
// Borrow state per variable
// ============================================================

// State values: 0 = Owned (unborrowed), 1 = SharedBorrow, 2 = ExclusiveBorrow
// shared_count tracks number of active shared borrows

// Two snapshot slots per nested `if` level; 16 levels of nesting are tracked.
// Beyond that the merge degrades to the old sequential behaviour rather than
// misreporting.
pub const MAX_BRANCH_LEVELS: i64 = 16
pub const MAX_BRANCH_SNAP: i64 = 32
const BRANCH_SNAP_PLANE: i64 = 4096   // 128 entries * MAX_BRANCH_SNAP

pub struct BorrowEntry {
    name: Name,
    state: i64,          // 0=Owned, 1=SharedBorrow, 2=ExclusiveBorrow
    shared_count: i64,   // Number of active shared borrows
    is_linear: bool,     // Whether this is a linear type variable
    consumed: bool,      // Whether a linear variable has been consumed
    scope_depth: i64,    // Scope where this entry was created
    provenance: i64,     // escape provenance: 0=first-class (param/global/safe), 1=local (frame-bound ref)
}

fn empty_borrow_entry() -> BorrowEntry {
    BorrowEntry {
        name: Name { buf: [0; 128], len: 0 },
        state: 0,
        shared_count: 0,
        is_linear: false,
        consumed: false,
        scope_depth: 0,
        provenance: 0,
    }
}

// ============================================================
// Borrow environment
// ============================================================

pub struct BorrowEnv {
    entries: [BorrowEntry; 128],
    count: i64,
    scope_starts: [i64; 64],
    scope_depth: i64,
    branch_depth: i64,   // nesting level of `if` currently being checked
    // Snapshots of `consumed`, laid out FLAT as entry-major
    // [entry * MAX_BRANCH_SNAP + 2*level (+1)], so the write is a single-level
    // indexed store rather than the known-fragile `entries[i].snap[j]` shape.
    //
    // The length is spelled as a LITERAL, not as BRANCH_SNAP_PLANE. A named const
    // in an array-type position is not resolved by the lean_single front end -- the
    // seed that builds Madaros -- and the field is then dropped from the struct
    // entirely: every BorrowEnv literal reports `missing field in struct literal`
    // and stores through the field get no valid offset (issue #1471). A const in a
    // repeat-literal LENGTH is NOT fine either (see borrow_env_new below); only
    // index arithmetic, as in check.sio, resolves the const correctly.
    branch_snap: [bool; 4096],
}

pub fn borrow_env_new() -> BorrowEnv {
    BorrowEnv {
        entries: [empty_borrow_entry(); 128],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
        branch_depth: 0,
        // Literal length, matching the declaration above. The comment there said a
        // named const was safe in a repeat-literal LENGTH and unsafe only in a TYPE
        // position; measured against the self-compilation ratchet that is not true --
        // `[false; BRANCH_SNAP_PLANE]` here produced E020 (array elements must all have
        // the same type) + E016 (field initializer has wrong type) when Madaros
        // typechecks its own source. Both spellings must be the literal 4096.
        branch_snap: [false; 4096],
    }
}

impl BorrowEnv {
    fn push_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth < 64 {
            env.scope_starts[env.scope_depth] = env.count
            env.scope_depth = env.scope_depth + 1
        }
        env
    }

    fn pop_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth > 0 {
            env.scope_depth = env.scope_depth - 1
            // Release borrows created in this scope by resetting state
            let scope_start = env.scope_starts[env.scope_depth]
            var i = scope_start
            while i < env.count {
                env.entries[i].state = 0
                env.entries[i].shared_count = 0
                i = i + 1
            }
            env.count = scope_start
        }
        env
    }

    // Register a variable for borrow tracking
    fn track(self, name: Name, is_linear: bool) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.count < 128 {
            env.entries[env.count] = BorrowEntry {
                name: name,
                state: 0,
                shared_count: 0,
                is_linear: is_linear,
                consumed: false,
                scope_depth: env.scope_depth,
                provenance: 0,
            }
            env.count = env.count + 1
        }
        env
    }

    // Find entry index for a variable (most recent binding)
    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i - 1
        }
        -1
    }

    // Scope depth where a name was bound (-1 if not tracked). Params are bound at
    // depth 1 (the fn param scope); body-locals at depth >= 2 (the body block pushes
    // a second scope). So scope_depth_of(name) >= 2 iff name is a frame-bound local.
    fn scope_depth_of(self, name: Name) -> i64 with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 { return -1 }
        self.entries[idx].scope_depth
    }

    // Escape provenance of a binding (0=first-class, 1=local); 0 if not tracked.
    fn provenance_of(self, name: Name) -> i64 with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 { return 0 }
        self.entries[idx].provenance
    }

    // Record the escape provenance of a binding (set after track at let/var sites).
    fn set_provenance(self, name: Name, prov: i64) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx >= 0 {
            env.entries[idx].provenance = prov
        }
        env
    }

    // Try to take a shared borrow (&x)
    // Returns (updated env, error_code) where error_code 0 = ok, 37 = conflict
    fn try_shared_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            // Variable not tracked — allow (may be a global or external)
            return (env, 0)
        }
        let entry = env.entries[idx]
        if entry.state == 2 {
            // Cannot take shared borrow while exclusive borrow is active
            return (env, 37)
        }
        // Increment shared borrow count
        env.entries[idx].state = 1
        env.entries[idx].shared_count = entry.shared_count + 1
        (env, 0)
    }

    // Try to take an exclusive borrow (&!x)
    // Returns (updated env, error_code) where error_code 0 = ok, 38 = conflict
    fn try_exclusive_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        if entry.state != 0 {
            // Cannot take exclusive borrow while any borrow is active
            return (env, 38)
        }
        env.entries[idx].state = 2
        (env, 0)
    }

    // Mark a linear variable as consumed (moved)
    // Returns (updated env, error_code) where 0 = ok, 39 = already consumed
    fn consume_linear(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        if !entry.is_linear {
            return (env, 0)
        }
        if entry.consumed {
            // Double consumption of linear value
            return (env, 39)
        }
        env.entries[idx].consumed = true
        (env, 0)
    }

    // Check that all linear variables in the current scope have been consumed
    // Returns (env, unconsumed_count)
    fn check_linear_consumed(self) -> (BorrowEnv, i64) with Mut, Panic, Div {
        let env = self
        var unconsumed: i64 = 0
        let scope_start = if env.scope_depth > 0 {
            env.scope_starts[env.scope_depth - 1]
        } else {
            0
        }
        var i = scope_start
        while i < env.count {
            if env.entries[i].is_linear && !env.entries[i].consumed {
                unconsumed = unconsumed + 1
            }
            i = i + 1
        }
        (env, unconsumed)
    }

    // Check if a variable is currently borrowed (state != 0)
    // Returns true if the variable has an active shared or exclusive borrow
    fn is_borrowed(self, name: Name) -> bool with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 {
            return false
        }
        let entry = self.entries[idx]
        entry.state != 0  // 0 = Owned, 1 = SharedBorrow, 2 = ExclusiveBorrow
    }

    // Release a borrow on a named variable, restoring it to Owned state.
    // Called after a function call returns to release borrows taken for parameters.
    fn release_borrow(self, name: Name) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx >= 0 {
            if env.entries[idx].state == 2 {
                // Exclusive borrow -> Owned
                env.entries[idx].state = 0
            } else if env.entries[idx].state == 1 {
                // Decrement shared borrow count
                env.entries[idx].shared_count = env.entries[idx].shared_count - 1
                if env.entries[idx].shared_count <= 0 {
                    env.entries[idx].state = 0
                    env.entries[idx].shared_count = 0
                }
            }
        }
        env
    }

    // Release all exclusive borrows in the current scope.
    // Used at loop iteration boundaries to allow re-borrowing in the next iteration.
    fn release_exclusive_borrows(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        var i: i64 = 0
        while i < env.count {
            if env.entries[i].state == 2 {
                env.entries[i].state = 0
            }
            i = i + 1
        }
        env
    }
}
