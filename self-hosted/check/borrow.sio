// Borrow checker — single-pass ownership and borrowing verification
//
// Tracks per-variable borrow state: Owned, SharedBorrow(n), ExclusiveBorrow
// Enforces:
//   - &x: fails if exclusive borrow is active
//   - &!x: fails if any borrow is active
//   - linear struct: must be consumed exactly once
//   - Scope exit: releases borrows created in that scope

// ============================================================
// Borrow state per variable
// ============================================================

// State values: 0 = Owned (unborrowed), 1 = SharedBorrow, 2 = ExclusiveBorrow
// shared_count tracks number of active shared borrows

// Two snapshot slots per nested `if` level; 16 levels of nesting are tracked.
// Beyond that the merge degrades to the old sequential behaviour rather than
// misreporting.
pub const MAX_BRANCH_LEVELS: i64 = 16
pub const MAX_BRANCH_SNAP: i64 = 32
const BRANCH_SNAP_PLANE: i64 = 4096   // 128 entries * MAX_BRANCH_SNAP

pub struct BorrowEntry {
    // Stable identity, independent of a reused slot or shadowed name.
    pub binding_id:i64,
    pub name: Name,
    pub state: i64,          // 0=Owned, 1=SharedBorrow, 2=ExclusiveBorrow
    pub shared_count: i64,   // Number of active shared borrows
    pub loan_live:bool,
    pub loan_temporary:bool,
    pub loan_pinned:bool,
    pub is_affine:bool,
    pub is_linear: bool,     // Whether this is a linear type variable
    pub consumed: bool,      // Whether a linear variable has been consumed
    pub scope_depth: i64,    // Scope where this entry was created
    pub provenance: i64,     // escape provenance: 0=first-class (param/global/safe), 1=local (frame-bound ref)
}

fn empty_borrow_entry() -> BorrowEntry {
    BorrowEntry {
        binding_id:0,
        name: Name { buf: [0; 384], len: 0 },
        state: 0,
        shared_count: 0,
        loan_live:true,loan_temporary:false,loan_pinned:false,
        is_affine:false,
        is_linear: false,
        consumed: false,
        scope_depth: 0,
        provenance: 0,
    }
}

// ============================================================
// Borrow environment
// ============================================================

pub struct BorrowEnv {
    pub next_binding_id:i64,
    pub loan_head:i64,
    pub loan_count:i64,
    pub loan_overflow:bool,
    pub entries: [BorrowEntry; 128],
    pub count: i64,
    pub scope_starts: [i64; 64],
    pub scope_depth: i64,
    pub branch_depth: i64,   // nesting level of `if` currently being checked
    // Snapshots of `consumed`, laid out FLAT as entry-major
    // [entry * MAX_BRANCH_SNAP + 2*level (+1)], so the write is a single-level
    // indexed store rather than the known-fragile `entries[i].snap[j]` shape.
    //
    // The length is spelled as a LITERAL, not as BRANCH_SNAP_PLANE. A named const
    // in an array-type position is not resolved by the lean_single front end -- the
    // seed that builds Madaros -- and the field is then dropped from the struct
    // entirely: every BorrowEnv literal reports `missing field in struct literal`
    // and stores through the field get no valid offset (issue #1471). A const in a
    // repeat-literal LENGTH is NOT fine either (see borrow_env_new below); only
    // index arithmetic, as in check.sio, resolves the const correctly.
    pub branch_snap: [bool; 4096],
}

// #1581 field-path helpers (path names are "root.f1.f2").
pub fn borrow_name_is_path(n: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        if n.buf[i as usize] == 46 as i8 { return true }
        i = i + 1
    }
    false
}

pub fn borrow_path_root(n: Name) -> Name with Mut, Panic, Div {
    var r = Name { buf: [0; 384], len: 0 }
    var i: i64 = 0
    while i < n.len && n.buf[i as usize] != 46 as i8 {
        r.buf[i as usize] = n.buf[i as usize]
        i = i + 1
    }
    r.len = i
    r
}

// `a` and `b` name the same storage or one contains the other: equal, or one
// is a prefix of the other ending exactly at a `.`.
pub fn borrow_paths_overlap(a: Name, b: Name) -> bool with Mut, Panic, Div {
    var short = a
    var long = b
    if a.len > b.len {
        short = b
        long = a
    }
    var i: i64 = 0
    while i < short.len {
        if short.buf[i as usize] != long.buf[i as usize] { return false }
        i = i + 1
    }
    if long.len == short.len { return true }
    long.buf[short.len as usize] == 46 as i8
}

pub fn borrow_env_new() -> BorrowEnv {
    BorrowEnv {
        next_binding_id:1,loan_head:0,loan_count:0,loan_overflow:false,
        entries: [empty_borrow_entry(); 128],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
        branch_depth: 0,
        // Literal length, matching the declaration above. The comment there said a
        // named const was safe in a repeat-literal LENGTH and unsafe only in a TYPE
        // position; measured against the self-compilation ratchet that is not true --
        // `[false; BRANCH_SNAP_PLANE]` here produced E020 (array elements must all have
        // the same type) + E016 (field initializer has wrong type) when Madaros
        // typechecks its own source. Both spellings must be the literal 4096.
        branch_snap: [false; 4096],
    }
}

// Persistent loans belong to a carrier binding and point to its actual owner
// identity. Call-site borrow release changes transient state only. Scope exit
// removes carrier identities from the active environment; old edges cannot bind
// a later shadow that reuses their entry index. Nodes are immutable so copying a
// BorrowEnv does not let a sibling mutate its graph.
pub struct PersistentLoanEdge {
    pub owner:i64,
    pub carrier:i64,
    pub kind:i64,
    pub next:i64,
}
pub fn borrow_binding_id(env:&BorrowEnv,name:Name)->i64 with Mut,Panic,Div {
    let root=borrow_path_root(name)
    var i=env.count-1
    while i>=0 {
        if name_eq(env.entries[i as usize].name,root) {return env.entries[i as usize].binding_id}
        i=i-1
    }
    0
}
pub fn borrow_binding_live(env:&BorrowEnv,id:i64)->bool with Mut,Panic,Div {
    if id<=0 {return false}
    var i:i64=0
    while i<env.count {
        if env.entries[i as usize].binding_id==id {return true}
        i=i+1
    }
    false
}
pub fn borrow_persistent_state(env:&BorrowEnv,name:Name)->i64 with Mut,Panic,Div {
    if env.loan_overflow {return 2}
    let owner=borrow_binding_id(env,name)
    if owner==0 {return 0}
    var cursor=env.loan_head
    var count:i64=0
    var state:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).owner==owner && borrow_carrier_live(env,(*edge).carrier) {
            if (*edge).kind==2 || (*edge).kind==4 {return 2}
            state=1
        }
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 {return 2}
    state
}
fn borrow_persist_edge(env:BorrowEnv,carrier:i64,owner:i64,kind:i64)->BorrowEnv with Mut,Panic,Div,Alloc {
    var out=env
    if out.loan_overflow {return out}
    if carrier<=0 || owner<=0 || (kind<1 || kind>4) {out.loan_overflow=true;return out}
    if !borrow_binding_live(&out,carrier) {out.loan_overflow=true;return out}
    if !borrow_binding_live(&out,owner) {if kind>=3 {return out};out.loan_overflow=true;return out}
    var cursor=out.loan_head
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).owner==owner && (*edge).carrier==carrier && (*edge).kind==kind {return out}
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 || out.loan_count>=4096 {out.loan_overflow=true;return out}
    let edge=heap_alloc(64) as *mut PersistentLoanEdge
    if (edge as i64)<=0 {out.loan_overflow=true;return out}
    (*edge).owner=owner
    (*edge).carrier=carrier
    (*edge).kind=kind
    (*edge).next=out.loan_head
    out.loan_head=edge as i64
    out.loan_count=out.loan_count+1
    out
}
pub fn borrow_persist_owner(env:BorrowEnv,carrier:Name,owner:Name,kind:i64)->BorrowEnv with Mut,Panic,Div,Alloc {
    borrow_persist_edge(env,borrow_binding_id(&env,carrier),borrow_binding_id(&env,owner),kind)
}
pub fn borrow_persist_alias(env:BorrowEnv,carrier:Name,source:Name)->BorrowEnv with Mut,Panic,Div,Alloc {
    var out=env
    let carrier_id=borrow_binding_id(&out,carrier)
    let source_id=borrow_binding_id(&out,source)
    if carrier_id<=0 || source_id<=0 {out.loan_overflow=true;return out}
    // Traverse the original immutable list, never newly added alias edges.
    var cursor=env.loan_head
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).carrier==source_id {
            out=borrow_persist_edge(out,carrier_id,(*edge).owner,(*edge).kind)
        }
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 {out.loan_overflow=true}
    out
}

impl BorrowEnv {
    fn push_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth < 64 {
            env.scope_starts[env.scope_depth] = env.count
            env.scope_depth = env.scope_depth + 1
        }
        env
    }

    fn pop_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth > 0 {
            env.scope_depth = env.scope_depth - 1
            // Release borrows created in this scope by resetting state
            let scope_start = env.scope_starts[env.scope_depth]
            var i = scope_start
            while i < env.count {
                env.entries[i].state = 0
                env.entries[i].shared_count = 0
                i = i + 1
            }
            env.count = scope_start
            if env.count==0 {env.loan_head=0;env.loan_count=0;env.loan_overflow=false}
        }
        env
    }

    // Register a variable for borrow tracking
    fn track(self, name: Name, is_linear: bool) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.count < 128 {
            env.entries[env.count] = BorrowEntry {
                binding_id:env.next_binding_id,
                name: name,
                state: 0,
                shared_count: 0,
                loan_live:true,loan_temporary:false,loan_pinned:false,
                is_affine:false,
                is_linear: is_linear,
                consumed: false,
                scope_depth: env.scope_depth,
                provenance: 0,
            }
            env.count = env.count + 1
            if env.next_binding_id>=9223372036854775806 {env.loan_overflow=true} else {env.next_binding_id=env.next_binding_id+1}
        } else {env.loan_overflow=true}
        env
    }

    // Find entry index for a variable (most recent binding)
    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i - 1
        }
        -1
    }

    // Scope depth where a name was bound (-1 if not tracked). Params are bound at
    // depth 1 (the fn param scope); body-locals at depth >= 2 (the body block pushes
    // a second scope). So scope_depth_of(name) >= 2 iff name is a frame-bound local.
    fn scope_depth_of(self, name: Name) -> i64 with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 { return -1 }
        self.entries[idx].scope_depth
    }

    // Escape provenance of a binding (0=first-class, 1=local); 0 if not tracked.
    fn provenance_of(self, name: Name) -> i64 with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 { return 0 }
        self.entries[idx].provenance
    }

    // Record the escape provenance of a binding (set after track at let/var sites).
    fn set_provenance(self, name: Name, prov: i64) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx >= 0 {
            env.entries[idx].provenance = prov
        }
        env
    }

    // Try to take a shared borrow (&x)
    // Returns (updated env, error_code) where error_code 0 = ok, 37 = conflict
    fn try_shared_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            // Variable not tracked — allow (may be a global or external)
            return (env, 0)
        }
        let entry = env.entries[idx]
        // Borrowing a moved linear owner must remain a use-after-move error.
        if entry.is_linear && entry.consumed { return (env, 39) }
        if entry.state == 2 || borrow_persistent_state(&env,name)==2 {
            // Cannot take shared borrow while exclusive borrow is active
            return (env, 37)
        }
        // Increment shared borrow count
        env.entries[idx].state = 1
        env.entries[idx].shared_count = entry.shared_count + 1
        (env, 0)
    }

    // Try to take an exclusive borrow (&!x)
    // Returns (updated env, error_code) where error_code 0 = ok, 38 = conflict
    fn try_exclusive_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        // Borrowing a moved linear owner must remain a use-after-move error.
        if entry.is_linear && entry.consumed { return (env, 39) }
        if entry.state != 0 || borrow_persistent_state(&env,name)!=0 {
            // Cannot take exclusive borrow while any borrow is active
            return (env, 38)
        }
        env.entries[idx].state = 2
        (env, 0)
    }

    // Mark a linear variable as consumed (moved)
    // Returns (updated env, error_code) where 0 = ok, 39 = already consumed
    fn consume_linear(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        if !entry.is_linear {
            return (env, 0)
        }
        if borrow_persistent_state(&env,name)!=0 {return (env,38)}
        if entry.consumed {
            // Double consumption of linear value
            return (env, 39)
        }
        env.entries[idx].consumed = true
        (env, 0)
    }

    // Check that all linear variables in the current scope have been consumed
    // Returns (env, unconsumed_count)
    fn check_linear_consumed(self) -> (BorrowEnv, i64) with Mut, Panic, Div {
        let env = self
        var unconsumed: i64 = 0
        let scope_start = if env.scope_depth > 0 {
            env.scope_starts[env.scope_depth - 1]
        } else {
            0
        }
        var i = scope_start
        while i < env.count {
            if env.entries[i].is_linear && !env.entries[i].consumed {
                unconsumed = unconsumed + 1
            }
            i = i + 1
        }
        (env, unconsumed)
    }

    // Check if a variable is currently borrowed (state != 0)
    // Returns true if the variable has an active shared or exclusive borrow
    fn is_borrowed(self, name: Name) -> bool with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 {
            return false
        }
        let entry = self.entries[idx]
        entry.state != 0 || borrow_persistent_state(&self,name)!=0
    }

    // Release a borrow on a named variable, restoring it to Owned state.
    // Called after a function call returns to release borrows taken for parameters.
    fn release_borrow(self, name: Name) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx >= 0 {
            if env.entries[idx].state == 2 {
                // Exclusive borrow -> Owned
                env.entries[idx].state = 0
            } else if env.entries[idx].state == 1 {
                // Decrement shared borrow count
                env.entries[idx].shared_count = env.entries[idx].shared_count - 1
                if env.entries[idx].shared_count <= 0 {
                    env.entries[idx].state = 0
                    env.entries[idx].shared_count = 0
                }
            }
        }
        env
    }

    // Release all exclusive borrows in the current scope.
    // Used at loop iteration boundaries to allow re-borrowing in the next iteration.
    fn release_exclusive_borrows(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        var i: i64 = 0
        while i < env.count {
            if env.entries[i].state == 2 {
                env.entries[i].state = 0
            }
            i = i + 1
        }
        env
    }
}

// Stage source identities before a new name is bound: shadowing in an
// initializer must keep the previous binding's identity.
pub fn borrow_sources_add(head:i64,owner:i64,kind:i64)->i64 with Mut,Panic,Div,Alloc {
    if head<0 {return head}
    if owner==0 {return head}
    if owner<0 || (kind<1 || kind>4) {return 0-1}
    var cursor=head
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).owner==owner && (*edge).kind==kind {return head}
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 || count>=4096 {return 0-1}
    let edge=heap_alloc(64) as *mut PersistentLoanEdge
    if (edge as i64)<=0 {return 0-1}
    (*edge).owner=owner
    (*edge).carrier=0
    (*edge).kind=kind
    (*edge).next=head
    edge as i64
}
pub fn borrow_sources_alias(env:&BorrowEnv,name:Name,head:i64,kind:i64)->i64 with Mut,Panic,Div,Alloc {
    let source=borrow_binding_id(env,name)
    if source==0 {return head}
    var out=head
    var found=false
    var cursor=env.loan_head
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).carrier==source {
            out=borrow_sources_add(out,(*edge).owner,(*edge).kind)
            found=true
        }
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 {return 0-1}
    if !found {out=borrow_sources_add(out,source,kind)}
    out
}
pub fn borrow_persist_sources(env:BorrowEnv,name:Name,sources:i64)->BorrowEnv with Mut,Panic,Div,Alloc {
    var out=env
    if sources<0 {out.loan_overflow=true;return out}
    let carrier=borrow_binding_id(&out,name)
    var cursor=sources
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        out=borrow_persist_edge(out,carrier,(*edge).owner,(*edge).kind)
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 {out.loan_overflow=true}
    out
}

pub fn borrow_sources_union(left:i64,right:i64)->i64 with Mut,Panic,Div,Alloc {
    if left<0 || right<0 {return 0-1}
    var out=left
    var cursor=right
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        out=borrow_sources_add(out,(*edge).owner,(*edge).kind)
        cursor=(*edge).next
        count=count+1
    }
    if cursor!=0 {return 0-1}
    out
}

pub fn borrow_sources_all_live(env:&BorrowEnv,sources:i64)->bool with Mut,Panic,Div {
    if sources<0 {return false}
    var cursor=sources
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).kind<=2 {if !borrow_binding_live(env,(*edge).owner) {return false}}
        cursor=(*edge).next
        count=count+1
    }
    cursor==0
}

// Affine carriers may be moved or discarded; they never acquire a Drop duty.
pub fn borrow_carrier_live(env:&BorrowEnv,id:i64)->bool with Mut,Panic,Div {
    if id<=0 {return false}
    var i:i64=0
    while i<env.count {
        let entry=env.entries[i as usize]
        if entry.binding_id==id {return entry.loan_live && (entry.loan_pinned || !(entry.is_affine && entry.consumed))}
        i=i+1
    }
    false
}

pub fn borrow_end_temporaries_since(env:BorrowEnv,start:i64)->BorrowEnv with Mut,Panic,Div {
    var out=env
    var i:i64=0
    while i<out.count {
        var entry=out.entries[i as usize]
        if entry.loan_temporary && entry.binding_id>=start {
            entry.loan_live=false
            out.entries[i as usize]=entry
        }
        i=i+1
    }
    out
}
pub fn borrow_add_temporary(env:BorrowEnv,sources:i64)->BorrowEnv with Mut,Panic,Div,Alloc {
    if sources==0 {return env}
    if sources<0 {var failed=env;failed.loan_overflow=true;return failed}
    var out=env.track(Name{buf:[0;384],len:0},false)
    if out.count<=0 || out.loan_overflow {return out}
    var entry=out.entries[(out.count-1) as usize]
    // Empty source names cannot be spelled as a user binding.
    entry.loan_temporary=true
    out.entries[(out.count-1) as usize]=entry
    var cursor=sources
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        out=borrow_persist_edge(out,entry.binding_id,(*edge).owner,(*edge).kind)
        cursor=(*edge).next
        count=count+1
    }
    if sources<0 || cursor!=0 {out.loan_overflow=true}
    out
}
pub fn borrow_compact_temporaries(env:BorrowEnv)->BorrowEnv with Mut,Panic,Div {
    var out=env
    // Only call between full statements at the function-body level; there is
    // no active branch snapshot or nested scope index to shift at that point.
    if out.scope_depth!=2 || out.branch_depth!=0 {return out}
    var read:i64=0
    var write:i64=0
    while read<out.count {
        let entry=out.entries[read as usize]
        if !entry.loan_temporary || entry.scope_depth<2 {
            if write!=read {out.entries[write as usize]=entry}
            write=write+1
        }
        read=read+1
    }
    out.count=write
    out
}
pub fn borrow_has_carrier_edge(env:&BorrowEnv,id:i64)->bool with Mut,Panic,Div {
    var cursor=env.loan_head
    var count:i64=0
    while cursor!=0 && count<4096 {
        let edge=cursor as *mut PersistentLoanEdge
        if (*edge).carrier==id {return true}
        cursor=(*edge).next
        count=count+1
    }
    cursor!=0
}
