// Causal type checking — CausalEffect<X, Y, do(Z=z)> type system
//
// Provides structural identifiability checking for causal queries via
// Pearl's backdoor criterion with graph traversal on a 16-node DAG.
//
// A causal query P(Y|do(X)) is identifiable if there exists a valid
// adjustment set Z such that:
//   1. No node in Z is a descendant of X (the cause)
//   2. Z blocks every backdoor path from X to Y
//
// Error codes:
//   E067: non_identifiable_query — no valid adjustment set exists
//   E068: causal_type_mismatch   — cause/effect types incompatible


// CausalGraph: simple adjacency structure for causal DAG verification.
// Stores up to 16 nodes and 32 edges (sufficient for pharmacokinetic models).
const CAUSAL_MAX_NODES: i64 = 16
const CAUSAL_MAX_EDGES: i64 = 32

pub struct CausalNode {
    name: Name,
    is_observed: bool,
    is_intervention_target: bool,
}

pub struct CausalEdge {
    from_idx: i64,  // index into CausalGraph.nodes
    to_idx: i64,    // index into CausalGraph.nodes
    is_directed: bool,  // true = causal edge X->Y, false = bidirected X<->Y (confounding)
}

pub struct CausalGraph {
    nodes: [CausalNode; 16],
    node_count: i64,
    edges: [CausalEdge; 32],
    edge_count: i64,
}

pub fn causal_graph_new() -> CausalGraph {
    CausalGraph {
        nodes: [CausalNode { name: Name { buf: [0; 128], len: 0 }, is_observed: false, is_intervention_target: false }; 16],
        node_count: 0,
        edges: [CausalEdge { from_idx: -1, to_idx: -1, is_directed: true }; 32],
        edge_count: 0,
    }
}

// Add a node to the causal graph. Returns the node index.
pub fn causal_graph_add_node(g: CausalGraph, name: Name, observed: bool) -> (CausalGraph, i64) with Mut {
    var out = g
    if out.node_count >= CAUSAL_MAX_NODES {
        (out, -1)
    } else {
        let idx = out.node_count
        out.nodes[idx as usize] = CausalNode { name: name, is_observed: observed, is_intervention_target: false }
        out.node_count = out.node_count + 1
        (out, idx)
    }
}

// Add a directed edge X -> Y. Returns modified graph.
pub fn causal_graph_add_edge(g: CausalGraph, from: i64, to: i64) -> CausalGraph with Mut {
    var out = g
    if out.edge_count >= CAUSAL_MAX_EDGES {
        out
    } else {
        out.edges[out.edge_count as usize] = CausalEdge { from_idx: from, to_idx: to, is_directed: true }
        out.edge_count = out.edge_count + 1
        out
    }
}

// Add a bidirected (confounding) edge X <-> Y.
pub fn causal_graph_add_confound(g: CausalGraph, from: i64, to: i64) -> CausalGraph with Mut {
    var out = g
    if out.edge_count >= CAUSAL_MAX_EDGES {
        out
    } else {
        out.edges[out.edge_count as usize] = CausalEdge { from_idx: from, to_idx: to, is_directed: false }
        out.edge_count = out.edge_count + 1
        out
    }
}

// Check if there is a direct directed path from `from` to `to`.
fn causal_has_direct_edge(g: CausalGraph, from: i64, to: i64) -> bool {
    var i: i64 = 0
    var found: bool = false
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && e.from_idx == from && e.to_idx == to {
            found = true
        }
        i = i + 1
    }
    found
}

// Check for any confounding edge between two nodes.
fn causal_has_confound(g: CausalGraph, a: i64, b: i64) -> bool {
    var i: i64 = 0
    var found: bool = false
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if !e.is_directed {
            if (e.from_idx == a && e.to_idx == b) || (e.from_idx == b && e.to_idx == a) {
                found = true
            }
        }
        i = i + 1
    }
    found
}

// ============================================================
// Graph traversal algorithms for Pearl's backdoor criterion
// ============================================================

// Compute the descendant set of a node following directed edges only.
// Returns a boolean mask: descendants[i] == true iff node i is reachable
// from `start` via directed edges (X -> ... -> i).
fn causal_get_descendants(g: CausalGraph, start: i64) -> [bool; 16] with Mut {
    var desc: [bool; 16] = [false; 16]
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    // Seed with direct children of start
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if e.is_directed && e.from_idx == start && !desc[e.to_idx as usize] {
            desc[e.to_idx as usize] = true
            queue[q_tail as usize] = e.to_idx
            q_tail = q_tail + 1
        }
        ei = ei + 1
    }
    // BFS
    while q_head < q_tail {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        var ej: i64 = 0
        while ej < g.edge_count {
            let e = g.edges[ej as usize]
            if e.is_directed && e.from_idx == cur && !desc[e.to_idx as usize] {
                desc[e.to_idx as usize] = true
                if q_tail < 16 {
                    queue[q_tail as usize] = e.to_idx
                    q_tail = q_tail + 1
                }
            }
            ej = ej + 1
        }
    }
    desc
}

// Check if `target` is a descendant of `start` (directed reachability).
fn causal_is_descendant(g: CausalGraph, start: i64, target: i64) -> bool {
    let desc = causal_get_descendants(g, start)
    desc[target as usize]
}

// Get all parent nodes of `node` — nodes with a directed edge into `node`.
// Returns count and array of parent indices.
fn causal_get_parents(g: CausalGraph, node: i64) -> (i64, [i64; 16]) with Mut {
    var parents: [i64; 16] = [0 - 1; 16]
    var count: i64 = 0
    var i: i64 = 0
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && e.to_idx == node {
            parents[count as usize] = e.from_idx
            count = count + 1
        }
        i = i + 1
    }
    (count, parents)
}

// Check if there exists a backdoor path from cause to effect.
// A backdoor path is any path that enters `cause` via a non-causal direction:
//   - A directed edge pointing INTO cause (parent -> cause)
//   - A bidirected confounding edge (cause <-> neighbor)
// Then connects to effect via any path (directed or bidirected, any direction).
//
// We check this by BFS from effect through the "ancestral" graph (ignoring
// edges out of cause), seeing if we reach any parent/confounder of cause.
fn causal_has_backdoor_path(g: CausalGraph, cause: i64, effect: i64) -> bool with Mut {
    // BFS from effect through all edges except those LEAVING cause
    var visited: [bool; 16] = [false; 16]
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    visited[effect as usize] = true
    queue[0] = effect
    q_tail = 1
    while q_head < q_tail {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        var ei: i64 = 0
        while ei < g.edge_count {
            let e = g.edges[ei as usize]
            if e.is_directed {
                // Follow directed edges in REVERSE (parent <- child) to find ancestors
                if e.to_idx == cur && e.from_idx != cause && !visited[e.from_idx as usize] {
                    visited[e.from_idx as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = e.from_idx
                        q_tail = q_tail + 1
                    }
                }
                // Also follow directed edges FORWARD for paths through descendants
                if e.from_idx == cur && e.to_idx != cause && !visited[e.to_idx as usize] {
                    visited[e.to_idx as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = e.to_idx
                        q_tail = q_tail + 1
                    }
                }
            } else {
                // Bidirected (confounding) edges — traverse both directions
                var neighbor: i64 = 0 - 1
                if e.from_idx == cur && e.to_idx != cause {
                    neighbor = e.to_idx
                }
                if e.to_idx == cur && e.from_idx != cause {
                    neighbor = e.from_idx
                }
                if neighbor >= 0 && !visited[neighbor as usize] {
                    visited[neighbor as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = neighbor
                        q_tail = q_tail + 1
                    }
                }
            }
            ei = ei + 1
        }
    }
    // A backdoor path exists if we can reach any parent or confounder of cause
    var has_backdoor: bool = false
    var pi: i64 = 0
    while pi < g.edge_count {
        let e = g.edges[pi as usize]
        if e.is_directed && e.to_idx == cause {
            // e.from_idx is a parent of cause
            if visited[e.from_idx as usize] {
                has_backdoor = true
            }
        }
        if !e.is_directed {
            // Confounding edge — check both endpoints
            if e.from_idx == cause && visited[e.to_idx as usize] {
                has_backdoor = true
            }
            if e.to_idx == cause && visited[e.from_idx as usize] {
                has_backdoor = true
            }
        }
        pi = pi + 1
    }
    has_backdoor
}

// Check if backdoor paths are blocked by conditioning on nodes in `blocked`.
// Same as causal_has_backdoor_path but skips blocked nodes during traversal.
fn causal_has_backdoor_path_blocked_by(g: CausalGraph, cause: i64, effect: i64, blocked: [bool; 16]) -> bool with Mut {
    var visited: [bool; 16] = [false; 16]
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    visited[effect as usize] = true
    queue[0] = effect
    q_tail = 1
    while q_head < q_tail {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        var ei: i64 = 0
        while ei < g.edge_count {
            let e = g.edges[ei as usize]
            if e.is_directed {
                if e.to_idx == cur && e.from_idx != cause && !visited[e.from_idx as usize] && !blocked[e.from_idx as usize] {
                    visited[e.from_idx as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = e.from_idx
                        q_tail = q_tail + 1
                    }
                }
                if e.from_idx == cur && e.to_idx != cause && !visited[e.to_idx as usize] && !blocked[e.to_idx as usize] {
                    visited[e.to_idx as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = e.to_idx
                        q_tail = q_tail + 1
                    }
                }
            } else {
                var neighbor: i64 = 0 - 1
                if e.from_idx == cur && e.to_idx != cause {
                    neighbor = e.to_idx
                }
                if e.to_idx == cur && e.from_idx != cause {
                    neighbor = e.from_idx
                }
                if neighbor >= 0 && !visited[neighbor as usize] && !blocked[neighbor as usize] {
                    visited[neighbor as usize] = true
                    if q_tail < 16 {
                        queue[q_tail as usize] = neighbor
                        q_tail = q_tail + 1
                    }
                }
            }
            ei = ei + 1
        }
    }
    var has_backdoor: bool = false
    var pi: i64 = 0
    while pi < g.edge_count {
        let e = g.edges[pi as usize]
        if e.is_directed && e.to_idx == cause {
            if visited[e.from_idx as usize] && !blocked[e.from_idx as usize] {
                has_backdoor = true
            }
        }
        if !e.is_directed {
            if e.from_idx == cause && visited[e.to_idx as usize] && !blocked[e.to_idx as usize] {
                has_backdoor = true
            }
            if e.to_idx == cause && visited[e.from_idx as usize] && !blocked[e.from_idx as usize] {
                has_backdoor = true
            }
        }
        pi = pi + 1
    }
    has_backdoor
}

// Find a valid adjustment set using Pearl's backdoor criterion.
// Returns (0, adjustment_set) if found, (1, empty) if no valid set exists.
//
// Pearl's backdoor criterion: Z is valid if:
//   1. No node in Z is a descendant of cause
//   2. Z blocks every backdoor path from cause to effect
//
// Strategy: greedily include all observed non-descendants of cause,
// then verify this maximal set blocks all backdoor paths. If the
// maximal set doesn't work, no subset will either (monotonicity).
fn causal_find_adjustment_set(g: CausalGraph, cause: i64, effect: i64) -> (i64, [bool; 16]) with Mut {
    let desc = causal_get_descendants(g, cause)
    // Build candidate set: all observed, non-descendant, non-cause, non-effect nodes
    var adj_set: [bool; 16] = [false; 16]
    var ni: i64 = 0
    while ni < g.node_count {
        if ni != cause && ni != effect && !desc[ni as usize] && g.nodes[ni as usize].is_observed {
            adj_set[ni as usize] = true
        }
        ni = ni + 1
    }
    // Check if this adjustment set blocks all backdoor paths
    if causal_has_backdoor_path_blocked_by(g, cause, effect, adj_set) {
        // Maximal observed non-descendant set doesn't block — non-identifiable
        (1, [false; 16])
    } else {
        (0, adj_set)
    }
}

// ============================================================
// Identifiability checking — integrates graph algorithms
// ============================================================

// Structural identifiability check via Pearl's backdoor criterion.
// Returns 0 if identifiable, 1 if non-identifiable.
//
// Algorithm:
//   1. If no backdoor path exists, trivially identifiable
//   2. Otherwise, build maximal adjustment set (all observed non-descendants
//      of cause, excluding cause and effect)
//   3. If this set blocks all backdoor paths, identifiable; otherwise not
fn check_causal_identifiability(g: CausalGraph, cause_idx: i64, effect_idx: i64) -> i64 with Mut {
    if !causal_has_backdoor_path(g, cause_idx, effect_idx) {
        0  // No backdoor paths — identifiable
    } else {
        // Build maximal adjustment set: observed non-descendants of cause
        let desc = causal_get_descendants(g, cause_idx)
        var adj_set: [bool; 16] = [false; 16]
        var ni: i64 = 0
        while ni < g.node_count {
            if ni != cause_idx && ni != effect_idx && !desc[ni as usize] && g.nodes[ni as usize].is_observed {
                adj_set[ni as usize] = true
            }
            ni = ni + 1
        }
        if causal_has_backdoor_path_blocked_by(g, cause_idx, effect_idx, adj_set) {
            1  // Non-identifiable: maximal set doesn't block
        } else {
            0  // Identifiable: adjustment set found
        }
    }
}

// Validate a CausalEffect type annotation.
// Returns error code: 0=ok, 67=non_identifiable_query
fn check_causal_effect_type(effect_ty: TypeEntry) -> i64 {
    match effect_ty.kind {
        TypeKind::TyCausalEffect => {
            if effect_ty.epistemic_meta_id == 1 {
                67  // E067: non_identifiable_query
            } else {
                0
            }
        }
        _ => 0
    }
}

// ============================================================
// Sprint 29: Do-Calculus Type Checking
// D-separation (Bayes-Ball), front-door criterion, Rules 1-3
// References: Pearl (1995), Shpitser-Pearl (2006), Shachter (1998)
// ============================================================

// BFS upward through directed edges. Returns [bool; 16] ancestor mask.
fn causal_get_ancestors(g: CausalGraph, node: i64) -> [bool; 16] with Mut {
    var anc: [bool; 16] = [false; 16]
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if e.is_directed && e.to_idx == node && !anc[e.from_idx as usize] {
            anc[e.from_idx as usize] = true
            queue[q_tail as usize] = e.from_idx
            q_tail = q_tail + 1
        }
        ei = ei + 1
    }
    while q_head < q_tail {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        var ej: i64 = 0
        while ej < g.edge_count {
            let e = g.edges[ej as usize]
            if e.is_directed && e.to_idx == cur && !anc[e.from_idx as usize] {
                anc[e.from_idx as usize] = true
                if q_tail < 16 {
                    queue[q_tail as usize] = e.from_idx
                    q_tail = q_tail + 1
                }
            }
            ej = ej + 1
        }
    }
    anc
}

// Remove all directed edges pointing INTO `node`. Produces G_{X-bar} (intervention graph).
fn causal_graph_remove_incoming(g: CausalGraph, node: i64) -> CausalGraph with Mut {
    var result = g
    var new_count: i64 = 0
    var i: i64 = 0
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && e.to_idx == node {
            // Skip (remove incoming edge)
            i = i + 1
        } else {
            result.edges[new_count as usize] = e
            new_count = new_count + 1
            i = i + 1
        }
    }
    result.edge_count = new_count
    result
}

// Remove all directed edges leaving `node`. Produces G_{X_} (underbar).
fn causal_graph_remove_outgoing(g: CausalGraph, node: i64) -> CausalGraph with Mut {
    var result = g
    var new_count: i64 = 0
    var i: i64 = 0
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && e.from_idx == node {
            i = i + 1
        } else {
            result.edges[new_count as usize] = e
            new_count = new_count + 1
            i = i + 1
        }
    }
    result.edge_count = new_count
    result
}

// Remove incoming edges for all nodes in set.
fn causal_graph_remove_incoming_set(g: CausalGraph, set: [bool; 16]) -> CausalGraph with Mut {
    var result = g
    var new_count: i64 = 0
    var i: i64 = 0
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && set[e.to_idx as usize] {
            i = i + 1
        } else {
            result.edges[new_count as usize] = e
            new_count = new_count + 1
            i = i + 1
        }
    }
    result.edge_count = new_count
    result
}

// Remove outgoing edges for all nodes in set.
fn causal_graph_remove_outgoing_set(g: CausalGraph, set: [bool; 16]) -> CausalGraph with Mut {
    var result = g
    var new_count: i64 = 0
    var i: i64 = 0
    while i < g.edge_count {
        let e = g.edges[i as usize]
        if e.is_directed && set[e.from_idx as usize] {
            i = i + 1
        } else {
            result.edges[new_count as usize] = e
            new_count = new_count + 1
            i = i + 1
        }
    }
    result.edge_count = new_count
    result
}

// ============================================================
// D-Separation (Bayes-Ball algorithm, Shachter 1998)
// ============================================================

// D-separation test: Is X independent of Y given conditioning set Z in graph G?
// Uses Bayes-Ball algorithm with (node, direction) state pairs.
// visited[node*2 + direction]: direction 0=from_parent, 1=from_child.
pub fn causal_d_separated(g: CausalGraph, x: i64, y: i64, z_set: [bool; 16]) -> bool with Mut {
    var visited: [bool; 32] = [false; 32]
    var queue: [i64; 64] = [0 - 1; 64]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    var reached_y: bool = false

    // Get descendants of Z nodes (needed for collider activation)
    var z_or_desc: [bool; 16] = z_set
    var zi: i64 = 0
    while zi < g.node_count {
        if z_set[zi as usize] {
            let desc = causal_get_descendants(g, zi)
            var di: i64 = 0
            while di < g.node_count {
                if desc[di as usize] {
                    z_or_desc[di as usize] = true
                }
                di = di + 1
            }
        }
        zi = zi + 1
    }

    // Seed: edges from X
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if e.is_directed && e.from_idx == x {
            let state = e.to_idx * 2 + 0
            if !visited[state as usize] {
                visited[state as usize] = true
                queue[q_tail as usize] = state
                q_tail = q_tail + 1
            }
        }
        if e.is_directed && e.to_idx == x {
            let state = e.from_idx * 2 + 1
            if !visited[state as usize] {
                visited[state as usize] = true
                queue[q_tail as usize] = state
                q_tail = q_tail + 1
            }
        }
        if !e.is_directed {
            var other: i64 = 0 - 1
            if e.from_idx == x {
                other = e.to_idx
            }
            if e.to_idx == x {
                other = e.from_idx
            }
            if other >= 0 {
                let state = other * 2 + 0
                if !visited[state as usize] {
                    visited[state as usize] = true
                    queue[q_tail as usize] = state
                    q_tail = q_tail + 1
                }
            }
        }
        ei = ei + 1
    }

    // BFS
    while q_head < q_tail && !reached_y {
        let state = queue[q_head as usize]
        q_head = q_head + 1
        let node = state / 2
        let from_parent = (state % 2) == 0

        if node == y {
            reached_y = true
        }

        if !reached_y {
            if from_parent {
                // Arrived via directed edge from parent
                if !z_set[node as usize] {
                    // Not conditioned: pass to children and through bidirected
                    var ej: i64 = 0
                    while ej < g.edge_count {
                        let e = g.edges[ej as usize]
                        if e.is_directed && e.from_idx == node {
                            let ns = e.to_idx * 2 + 0
                            if !visited[ns as usize] && q_tail < 64 {
                                visited[ns as usize] = true
                                queue[q_tail as usize] = ns
                                q_tail = q_tail + 1
                            }
                        }
                        if !e.is_directed {
                            var other: i64 = 0 - 1
                            if e.from_idx == node {
                                other = e.to_idx
                            }
                            if e.to_idx == node {
                                other = e.from_idx
                            }
                            if other >= 0 {
                                let ns = other * 2 + 0
                                if !visited[ns as usize] && q_tail < 64 {
                                    visited[ns as usize] = true
                                    queue[q_tail as usize] = ns
                                    q_tail = q_tail + 1
                                }
                            }
                        }
                        ej = ej + 1
                    }
                }
                // Collider activation: if node or descendant is in Z
                if z_or_desc[node as usize] {
                    var ek: i64 = 0
                    while ek < g.edge_count {
                        let e = g.edges[ek as usize]
                        if e.is_directed && e.to_idx == node {
                            let ns = e.from_idx * 2 + 1
                            if !visited[ns as usize] && q_tail < 64 {
                                visited[ns as usize] = true
                                queue[q_tail as usize] = ns
                                q_tail = q_tail + 1
                            }
                        }
                        ek = ek + 1
                    }
                }
            } else {
                // Arrived from child (going backward along directed edge)
                if !z_set[node as usize] {
                    // Not conditioned: continue to parents and fork to children
                    var ej: i64 = 0
                    while ej < g.edge_count {
                        let e = g.edges[ej as usize]
                        if e.is_directed && e.to_idx == node {
                            let ns = e.from_idx * 2 + 1
                            if !visited[ns as usize] && q_tail < 64 {
                                visited[ns as usize] = true
                                queue[q_tail as usize] = ns
                                q_tail = q_tail + 1
                            }
                        }
                        if e.is_directed && e.from_idx == node {
                            let ns = e.to_idx * 2 + 0
                            if !visited[ns as usize] && q_tail < 64 {
                                visited[ns as usize] = true
                                queue[q_tail as usize] = ns
                                q_tail = q_tail + 1
                            }
                        }
                        if !e.is_directed {
                            var other: i64 = 0 - 1
                            if e.from_idx == node {
                                other = e.to_idx
                            }
                            if e.to_idx == node {
                                other = e.from_idx
                            }
                            if other >= 0 {
                                let ns = other * 2 + 0
                                if !visited[ns as usize] && q_tail < 64 {
                                    visited[ns as usize] = true
                                    queue[q_tail as usize] = ns
                                    q_tail = q_tail + 1
                                }
                            }
                        }
                        ej = ej + 1
                    }
                }
                // If conditioned, block the path (chain/fork blocked)
            }
        }
    }
    !reached_y
}

// ============================================================
// Front-Door Criterion
// ============================================================

// Check if all directed paths from `from` to `to` are intercepted by z_set.
// BFS from `from` following only directed edges, skipping z_set nodes.
// Returns true if `to` is NOT reachable (all paths intercepted).
fn causal_intercepts_all_directed_paths(g: CausalGraph, from: i64, to: i64, z_set: [bool; 16]) -> bool with Mut {
    var visited: [bool; 16] = [false; 16]
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    var reached_to: bool = false
    visited[from as usize] = true
    queue[0] = from
    q_tail = 1
    while q_head < q_tail && !reached_to {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        if cur == to {
            reached_to = true
        }
        if !reached_to {
            var ei: i64 = 0
            while ei < g.edge_count {
                let e = g.edges[ei as usize]
                if e.is_directed && e.from_idx == cur {
                    let next = e.to_idx
                    if !visited[next as usize] && !z_set[next as usize] {
                        visited[next as usize] = true
                        if q_tail < 16 {
                            queue[q_tail as usize] = next
                            q_tail = q_tail + 1
                        }
                    }
                }
                ei = ei + 1
            }
        }
    }
    !reached_to
}

// Find a front-door adjustment set for (cause, effect).
// Returns (status, set): status 0=found, 1=not found.
// Brute-force over single-node mediator candidates (max 16 iterations).
fn causal_find_front_door_set(g: CausalGraph, cause: i64, effect: i64) -> (i64, [bool; 16]) with Mut {
    var found_status: i64 = 1
    var found_set: [bool; 16] = [false; 16]
    var m: i64 = 0
    while m < g.node_count && found_status == 1 {
        if m != cause && m != effect && g.nodes[m as usize].is_observed {
            var z_set: [bool; 16] = [false; 16]
            z_set[m as usize] = true
            // Condition 1: Z intercepts all directed paths from cause to effect
            let cond1 = causal_intercepts_all_directed_paths(g, cause, effect, z_set)
            if cond1 {
                // Condition 2: No unblocked backdoor from cause to Z in G_{X-bar}
                let g_xbar = causal_graph_remove_incoming(g, cause)
                let cond2 = !causal_has_backdoor_path(g_xbar, cause, m)
                if cond2 {
                    // Condition 3: All backdoor paths from Z to Y blocked by X
                    var x_cond: [bool; 16] = [false; 16]
                    x_cond[cause as usize] = true
                    let g_zbar = causal_graph_remove_incoming(g, m)
                    let cond3 = causal_d_separated(g_zbar, m, effect, x_cond)
                    if !cond3 {
                        found_status = 0
                        found_set = z_set
                    }
                }
            }
        }
        m = m + 1
    }
    (found_status, found_set)
}

// Wrapper: check front-door identifiability. Returns 0 if identifiable, 1 if not.
fn causal_check_front_door(g: CausalGraph, cause: i64, effect: i64) -> i64 with Mut {
    let result = causal_find_front_door_set(g, cause, effect)
    result.0
}

// ============================================================
// Do-Calculus Rules 1-3 (Pearl 1995)
// ============================================================

// Rule 1: Insertion/deletion of observations.
// P(y|do(x),z,w) = P(y|do(x),w) if (Y ⊥ Z | X,W) in G_{X-bar}
fn do_calculus_rule1(g: CausalGraph, y: i64, x: i64, z: i64, w_set: [bool; 16]) -> bool with Mut {
    let g_xbar = causal_graph_remove_incoming(g, x)
    var cond_set: [bool; 16] = w_set
    cond_set[x as usize] = true
    causal_d_separated(g_xbar, y, z, cond_set)
}

// Rule 2: Action/observation exchange.
// P(y|do(x),do(z),w) = P(y|do(x),z,w) if (Y ⊥ Z | X,W) in G_{X-bar, Z_}
fn do_calculus_rule2(g: CausalGraph, y: i64, x: i64, z: i64, w_set: [bool; 16]) -> bool with Mut {
    let g_xbar = causal_graph_remove_incoming(g, x)
    let g_xbar_zunder = causal_graph_remove_outgoing(g_xbar, z)
    var cond_set: [bool; 16] = w_set
    cond_set[x as usize] = true
    causal_d_separated(g_xbar_zunder, y, z, cond_set)
}

// Rule 3: Insertion/deletion of actions.
// P(y|do(x),do(z),w) = P(y|do(x),w) if (Y ⊥ Z | X,W) in G_{X-bar, Z-bar(S)}
// where S = An(W) in G_{X-bar}, excluding Z nodes not ancestral to W.
fn do_calculus_rule3(g: CausalGraph, y: i64, x: i64, z: i64, w_set: [bool; 16]) -> bool with Mut {
    let g_xbar = causal_graph_remove_incoming(g, x)
    // Compute ancestors of W in G_{X-bar}
    var ancestors_of_w: [bool; 16] = [false; 16]
    var wi: i64 = 0
    while wi < g.node_count {
        if w_set[wi as usize] {
            let anc = causal_get_ancestors(g_xbar, wi)
            var ai: i64 = 0
            while ai < g.node_count {
                if anc[ai as usize] {
                    ancestors_of_w[ai as usize] = true
                }
                ai = ai + 1
            }
            ancestors_of_w[wi as usize] = true
        }
        wi = wi + 1
    }
    // Build Z-bar(S): remove incoming to Z only if Z is NOT in An(W) ∪ W
    var g_modified = g_xbar
    if !ancestors_of_w[z as usize] {
        g_modified = causal_graph_remove_incoming(g_xbar, z)
    }
    var cond_set: [bool; 16] = w_set
    cond_set[x as usize] = true
    causal_d_separated(g_modified, y, z, cond_set)
}

// ============================================================
// Extended Identifiability Cascade
// ============================================================

// Extended identifiability: backdoor → front-door → do-calculus Rule 2.
// Returns (status, method): status 0=identifiable, 1=non-identifiable.
// method: 0=backdoor, 1=front-door, 2=do-calculus-rule2, -1=none.
fn check_causal_identifiability_extended(g: CausalGraph, cause_idx: i64, effect_idx: i64) -> (i64, i64) with Mut {
    // Try backdoor criterion first
    let bd = check_causal_identifiability(g, cause_idx, effect_idx)
    if bd == 0 {
        (0, 0)
    } else {
        // Try front-door criterion
        let fd = causal_check_front_door(g, cause_idx, effect_idx)
        if fd == 0 {
            (0, 1)
        } else {
            // Try do-calculus Rule 2 with each intermediate node as Z
            var found_r2: bool = false
            var zi: i64 = 0
            while zi < g.node_count && !found_r2 {
                if zi != cause_idx && zi != effect_idx {
                    var empty_w: [bool; 16] = [false; 16]
                    let r2 = do_calculus_rule2(g, effect_idx, cause_idx, zi, empty_w)
                    if r2 {
                        found_r2 = true
                    }
                }
                zi = zi + 1
            }
            if found_r2 {
                (0, 2)
            } else {
                // Full Shpitser-Pearl ID algorithm
                var x_set: [bool; 16] = [false; 16]
                x_set[cause_idx as usize] = true
                var y_set: [bool; 16] = [false; 16]
                y_set[effect_idx as usize] = true
                let id_result = id_algorithm(g, x_set, y_set, 0)
                if id_result.0 == 0 {
                    (0, 3)
                } else {
                    (1, 0 - 1)
                }
            }
        }
    }
}

// ============================================================
// Sprint 31: Shpitser-Pearl ID Algorithm (AAAI 2006)
// Sound and complete causal identification via C-component decomposition.
// ============================================================

pub struct CComponent {
    members: [bool; 16],
    count: i64,
}

fn c_component_empty() -> CComponent {
    CComponent { members: [false; 16], count: 0 }
}

fn c_component_contains(c: CComponent, node: i64) -> bool {
    c.members[node as usize]
}

fn c_component_add(c: CComponent, node: i64) -> CComponent with Mut {
    var out = c
    if !out.members[node as usize] {
        out.members[node as usize] = true
        out.count = out.count + 1
    }
    out
}

pub struct CComponentList {
    components: [CComponent; 16],
    count: i64,
}

fn c_component_list_empty() -> CComponentList {
    CComponentList { components: [c_component_empty(); 16], count: 0 }
}

// Compute C-components: connected components in the bidirected edge subgraph.
// Two nodes are in the same C-component iff connected by bidirected (confounding) edges.
fn causal_compute_c_components(g: CausalGraph) -> CComponentList with Mut {
    var assigned: [i64; 16] = [0 - 1; 16]
    var result = c_component_list_empty()

    var ni: i64 = 0
    while ni < g.node_count {
        if assigned[ni as usize] < 0 {
            // BFS from ni through bidirected edges
            var comp = c_component_empty()
            var queue: [i64; 16] = [0 - 1; 16]
            var q_head: i64 = 0
            var q_tail: i64 = 0
            comp = c_component_add(comp, ni)
            assigned[ni as usize] = result.count
            queue[0] = ni
            q_tail = 1
            while q_head < q_tail {
                let cur = queue[q_head as usize]
                q_head = q_head + 1
                var ei: i64 = 0
                while ei < g.edge_count {
                    let e = g.edges[ei as usize]
                    if !e.is_directed {
                        var neighbor: i64 = 0 - 1
                        if e.from_idx == cur && assigned[e.to_idx as usize] < 0 {
                            neighbor = e.to_idx
                        }
                        if e.to_idx == cur && assigned[e.from_idx as usize] < 0 {
                            neighbor = e.from_idx
                        }
                        if neighbor >= 0 {
                            comp = c_component_add(comp, neighbor)
                            assigned[neighbor as usize] = result.count
                            if q_tail < 16 {
                                queue[q_tail as usize] = neighbor
                                q_tail = q_tail + 1
                            }
                        }
                    }
                    ei = ei + 1
                }
            }
            result.components[result.count as usize] = comp
            result.count = result.count + 1
        }
        ni = ni + 1
    }
    result
}

// Find the C-component containing a specific node.
fn causal_find_c_component_of(g: CausalGraph, node: i64) -> CComponent with Mut {
    let ccs = causal_compute_c_components(g)
    var i: i64 = 0
    while i < ccs.count {
        if c_component_contains(ccs.components[i as usize], node) {
            return ccs.components[i as usize]
        }
        i = i + 1
    }
    c_component_empty()
}

// Topological sort via Kahn's algorithm. Returns sorted node indices + count.
fn causal_topological_sort(g: CausalGraph) -> ([i64; 16], i64) with Mut {
    var in_degree: [i64; 16] = [0; 16]
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if e.is_directed {
            in_degree[e.to_idx as usize] = in_degree[e.to_idx as usize] + 1
        }
        ei = ei + 1
    }
    var queue: [i64; 16] = [0 - 1; 16]
    var q_head: i64 = 0
    var q_tail: i64 = 0
    var ni: i64 = 0
    while ni < g.node_count {
        if in_degree[ni as usize] == 0 {
            queue[q_tail as usize] = ni
            q_tail = q_tail + 1
        }
        ni = ni + 1
    }
    var sorted: [i64; 16] = [0 - 1; 16]
    var s_count: i64 = 0
    while q_head < q_tail {
        let cur = queue[q_head as usize]
        q_head = q_head + 1
        sorted[s_count as usize] = cur
        s_count = s_count + 1
        var ej: i64 = 0
        while ej < g.edge_count {
            let e = g.edges[ej as usize]
            if e.is_directed && e.from_idx == cur {
                in_degree[e.to_idx as usize] = in_degree[e.to_idx as usize] - 1
                if in_degree[e.to_idx as usize] == 0 && q_tail < 16 {
                    queue[q_tail as usize] = e.to_idx
                    q_tail = q_tail + 1
                }
            }
            ej = ej + 1
        }
    }
    (sorted, s_count)
}

// Extract subgraph induced by nodes in `keep` set.
fn causal_subgraph(g: CausalGraph, keep: [bool; 16]) -> CausalGraph with Mut {
    // Build node mapping: old index -> new index
    var old_to_new: [i64; 16] = [0 - 1; 16]
    var new_graph = causal_graph_new()
    var ni: i64 = 0
    while ni < g.node_count {
        if keep[ni as usize] {
            let new_idx = new_graph.node_count
            old_to_new[ni as usize] = new_idx
            new_graph.nodes[new_idx as usize] = g.nodes[ni as usize]
            new_graph.node_count = new_graph.node_count + 1
        }
        ni = ni + 1
    }
    // Copy edges where both endpoints are in keep
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if keep[e.from_idx as usize] && keep[e.to_idx as usize] {
            let new_from = old_to_new[e.from_idx as usize]
            let new_to = old_to_new[e.to_idx as usize]
            if new_from >= 0 && new_to >= 0 && new_graph.edge_count < 32 {
                new_graph.edges[new_graph.edge_count as usize] = CausalEdge {
                    from_idx: new_from,
                    to_idx: new_to,
                    is_directed: e.is_directed,
                }
                new_graph.edge_count = new_graph.edge_count + 1
            }
        }
        ei = ei + 1
    }
    new_graph
}

// Set operations on [bool; 16] node sets.
fn set_union(a: [bool; 16], b: [bool; 16]) -> [bool; 16] with Mut {
    var out: [bool; 16] = a
    var i: i64 = 0
    while i < 16 {
        if b[i as usize] { out[i as usize] = true }
        i = i + 1
    }
    out
}

fn set_subtract(a: [bool; 16], b: [bool; 16]) -> [bool; 16] with Mut {
    var out: [bool; 16] = a
    var i: i64 = 0
    while i < 16 {
        if b[i as usize] { out[i as usize] = false }
        i = i + 1
    }
    out
}

fn set_is_subset(a: [bool; 16], b: [bool; 16]) -> bool {
    var i: i64 = 0
    while i < 16 {
        if a[i as usize] && !b[i as usize] { return false }
        i = i + 1
    }
    true
}

fn set_equals(a: [bool; 16], b: [bool; 16]) -> bool {
    var i: i64 = 0
    while i < 16 {
        if a[i as usize] != b[i as usize] { return false }
        i = i + 1
    }
    true
}

fn set_is_empty(s: [bool; 16]) -> bool {
    var i: i64 = 0
    while i < 16 {
        if s[i as usize] { return false }
        i = i + 1
    }
    true
}

fn set_count(s: [bool; 16]) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < 16 {
        if s[i as usize] { count = count + 1 }
        i = i + 1
    }
    count
}

// Get all ancestors of all nodes in a set.
fn causal_get_ancestors_set(g: CausalGraph, s: [bool; 16]) -> [bool; 16] with Mut {
    var result = s
    var i: i64 = 0
    while i < 16 {
        if s[i as usize] {
            let anc = causal_get_ancestors(g, i)
            result = set_union(result, anc)
        }
        i = i + 1
    }
    result
}

// Build V set (all nodes).
fn causal_v_set(g: CausalGraph) -> [bool; 16] with Mut {
    var v: [bool; 16] = [false; 16]
    var i: i64 = 0
    while i < g.node_count {
        v[i as usize] = true
        i = i + 1
    }
    v
}

// Shpitser-Pearl ID Algorithm (AAAI 2006).
// Sound and complete for identification of causal effects in semi-Markovian models.
//
// Input:
//   g = causal graph (DAG with bidirected confounding edges)
//   x_set = intervention set (cause nodes)
//   y_set = outcome set (effect nodes)
//   depth = recursion depth (for termination safety, max 16)
//
// Returns:
//   (status, step): status 0=identifiable, 1=non-identifiable (hedge found)
//   step = which ID line resolved (1-7, or -1 for failure)
fn id_algorithm(g: CausalGraph, x_set: [bool; 16], y_set: [bool; 16], depth: i64) -> (i64, i64) with Mut {
    // Safety: prevent infinite recursion
    if depth > 16 {
        return (1, 0 - 1)
    }

    let v = causal_v_set(g)

    // Line 1: If X is empty, trivially identifiable (marginalization)
    if set_is_empty(x_set) {
        return (0, 1)
    }

    // Line 2: If An(Y) in G != V, recurse on An(Y) subgraph
    let an_y = causal_get_ancestors_set(g, y_set)
    if !set_equals(an_y, v) {
        // Restrict to ancestors of Y
        let g_an = causal_subgraph(g, an_y)
        // Remap x_set to only include nodes in An(Y)
        var x_restricted: [bool; 16] = [false; 16]
        var xi: i64 = 0
        while xi < 16 {
            if x_set[xi as usize] && an_y[xi as usize] {
                x_restricted[xi as usize] = true
            }
            xi = xi + 1
        }
        return id_algorithm(g_an, x_restricted, y_set, depth + 1)
    }

    // Line 3: Let W = (V \ X) \ An(Y)_{G_Xbar}
    let g_xbar = causal_graph_remove_incoming_set(g, x_set)
    let an_y_xbar = causal_get_ancestors_set(g_xbar, y_set)
    let v_minus_x = set_subtract(v, x_set)
    let w = set_subtract(v_minus_x, an_y_xbar)
    if !set_is_empty(w) {
        let x_union_w = set_union(x_set, w)
        return id_algorithm(g, x_union_w, y_set, depth + 1)
    }

    // Line 4: Compute C-components of G[V\X]
    let g_vx = causal_subgraph(g, v_minus_x)
    let ccs_vx = causal_compute_c_components(g_vx)

    // Lines 5-7 depend on C-component structure
    if ccs_vx.count == 1 {
        // Line 5: If C(G[V\X]) has a single component equal to C(G), non-identifiable (hedge)
        let ccs_g = causal_compute_c_components(g)
        if ccs_g.count == 1 {
            // The whole graph is one C-component and V\X is one C-component -> hedge
            return (1, 5)
        }
        // Otherwise fall through to check if it's a subset of some C-component of G
    }

    // Line 6 & 7: Check each C-component of G[V\X]
    if ccs_vx.count > 1 {
        // Line 6: Multiple C-components -> identifiable via product formula
        // Each component can be identified separately
        var ci: i64 = 0
        while ci < ccs_vx.count {
            let comp = ccs_vx.components[ci as usize]
            // Recursively identify P(S_i | do(V \ S_i))
            let s_i = comp.members
            let do_set = set_subtract(v, s_i)
            let sub_result = id_algorithm(g, do_set, s_i, depth + 1)
            if sub_result.0 != 0 {
                return (1, 6)
            }
            ci = ci + 1
        }
        return (0, 6)
    }

    // Single C-component in G[V\X]: check against C-components of G
    let ccs_g = causal_compute_c_components(g)
    let single_comp = ccs_vx.components[0]

    // Line 7: Find a C-component S_i of G such that S(G[V\X]) is a proper subset of S_i
    var si: i64 = 0
    while si < ccs_g.count {
        let s_i = ccs_g.components[si as usize]
        if set_is_subset(single_comp.members, s_i.members) && !set_equals(single_comp.members, s_i.members) {
            // S(G[V\X]) is a proper subset of S_i
            // Recurse on subgraph G[S_i] with restricted intervention
            let g_si = causal_subgraph(g, s_i.members)
            let x_si = set_subtract(s_i.members, single_comp.members)
            return id_algorithm(g_si, x_si, y_set, depth + 1)
        }
        si = si + 1
    }

    // No matching C-component found -- non-identifiable
    (1, 0 - 1)
}
