// self-hosted/check/hyper.sio
// Production machine-level hypercomplex type checker predicates
//
// Implements type checking rules for Hyper<Algebra, T> types:
//   - Binary operation compatibility (Quaternion * Quaternion -> Quaternion)
//   - Effect requirements (Div required for types with zero divisors)
//   - Division rejection for non-division algebras (error E032)
//   - Cayley-Dickson tower embedding (R -> C -> H -> O -> S)
//   - Clifford(p,q) parametric constraints
//
// STATUS: Compilable Sounio. Origin: Grok 4.2 spec, manually translated.
//   Uses: Checker.report_error_at(span, code, a, b, c) for diagnostics
//   Uses: name_matches_strN() from compat.sio for name resolution
//   Uses: ty_hyper(), ty_clifford() from types.sio for construction
//   Pattern follows: self-hosted/check/epistemic.sio
//
// Error codes:
//   E030: binary operation on incompatible Hyper algebras
//   E031: missing Div effect for type with zero divisors
//   E032: division on non-division algebra
//   E033: Clifford embedding mismatch (different signatures)
//   E034: Cayley-Dickson coercion direction error (no narrowing)

// --- Algebra kind tag constants (must match ir/algebra.sio) ---
let ALG_REAL: i64 = 0
let ALG_COMPLEX: i64 = 1
let ALG_QUATERNION: i64 = 2
let ALG_OCTONION: i64 = 3
let ALG_SEDENION: i64 = 4
let ALG_CLIFFORD: i64 = 5

// --- Type predicates ---

fn is_hyper_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyHyper
}

fn hyper_algebra(ty: TypeEntry) -> i64 with Panic {
    if ty.kind != TypeKind::TyHyper { return 0 - 1 }
    return ty.algebra_kind
}

fn hyper_inner(ty: TypeEntry) -> TypeEntry with Panic, Alloc {
    match ty.inner {
        Some(inner) => *inner
        None => ty_error()
    }
}

// --- Division algebra check (Hurwitz) ---

fn is_division_algebra(alg: i64) -> bool {
    alg <= 3  // R, C, H, O
}

// --- Associativity check ---

fn is_associative(alg: i64) -> bool {
    if alg == 0 { return true }  // Real
    if alg == 1 { return true }  // Complex
    if alg == 2 { return true }  // Quaternion
    if alg == 5 { return true }  // Clifford (always)
    return false
}

// --- Zero divisor check ---

fn has_zero_divisors(alg: i64) -> bool {
    alg >= 4  // Sedenion + Clifford(p,q) for p+q >= 2
}

// --- Binary operation result type ---
// Returns the algebra tag for the result of a binary op, or -1 if incompatible.

fn hyper_binary_result(left_alg: i64, right_alg: i64) -> i64 {
    // Same algebra: result is same algebra
    if left_alg == right_alg { return left_alg }
    // Cayley-Dickson tower: R < C < H < O < S — widen to larger
    if left_alg <= 4 && right_alg <= 4 {
        if left_alg > right_alg { return left_alg }
        return right_alg
    }
    // Clifford + Clifford with different signatures: incompatible
    // Clifford + Cayley-Dickson: incompatible
    return 0 - 1
}

// --- Check binary expression involving Hyper types ---

pub fn check_hyper_binary(c: Checker, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let left_alg = hyper_algebra(left)
    let right_alg = hyper_algebra(right)
    let result_alg = hyper_binary_result(left_alg, right_alg)
    var checker = c

    if result_alg < 0 {
        // E030: incompatible algebras
        checker = checker.report_error_at(span, 30, 0, 0, 0)
        return (checker, ty_error())
    }

    // Check division: only allowed for division algebras
    if op == BinaryOp::OpDiv && !is_division_algebra(result_alg) {
        // E032: division on non-division algebra
        checker = checker.report_error_at(span, 32, 0, 0, 0)
        return (checker, ty_error())
    }

    // Check Div effect requirement for types with zero divisors
    if has_zero_divisors(result_alg) {
        // E031 if Div effect not in scope (requires checker effect tracking)
        // For now: warn only — full effect checking comes via effects.sio
    }

    // Check NonAssoc effect requirement for non-associative algebras.
    // First check the algebra registry (Phase 1: first-class algebra declarations).
    // If no algebra is registered, fall back to hardcoded is_associative().
    var mul_needs_nonassoc = false
    if op == BinaryOp::OpMul {
        // Query algebra registry by tag
        var found_algebra = false
        var ai: i64 = 0
        while ai < checker.algebras.count {
            let info = checker.algebras.entries[ai]
            if info.is_valid && info.algebra_tag == result_alg {
                found_algebra = true
                if info.mul_alternative && !info.mul_associative {
                    mul_needs_nonassoc = true
                }
            }
            ai = ai + 1
        }
        // Fallback: hardcoded predicate for unregistered algebras
        if !found_algebra && !is_associative(result_alg) {
            mul_needs_nonassoc = true
        }
    }
    if mul_needs_nonassoc {
        let non_assoc_id: i64 = 14
        if !has_effect_id(checker.current_effects, checker.current_effect_count, non_assoc_id) {
            checker = checker.report_error_at(span, 35, result_alg, 0, 0)
        }
    }

    let inner = hyper_inner(left)
    (checker, ty_hyper(result_alg, inner))
}

// --- Cayley-Dickson tower coercion ---
// Can widen: R -> C -> H -> O -> S (embedding)
// Cannot narrow: H -> C is NOT implicit

fn can_coerce_hyper(from_alg: i64, to_alg: i64) -> bool {
    // Same: always ok
    if from_alg == to_alg { return true }
    // Cayley-Dickson widening: from < to in tower ordering
    if from_alg <= 4 && to_alg <= 4 && from_alg < to_alg { return true }
    // Clifford: no implicit coercion between different signatures
    return false
}

// --- Resolve algebra name to tag ---
// Uses byte-comparison helpers from compat.sio

pub fn resolve_algebra_name(n: Name) -> i64 with Panic, Div {
    // "Real" = 4 chars: 82, 101, 97, 108
    if name_matches_str4(n, 82, 101, 97, 108) { return 0 }
    // "Complex" = 7 chars: 67, 111, 109, 112, 108, 101, 120
    if name_matches_str7(n, 67, 111, 109, 112, 108, 101, 120) { return 1 }
    // "Quaternion" = 10 chars
    if name_matches_str10(n, 81, 117, 97, 116, 101, 114, 110, 105, 111, 110) { return 2 }
    // "Octonion" = 8 chars: 79, 99, 116, 111, 110, 105, 111, 110
    if name_matches_str8(n, 79, 99, 116, 111, 110, 105, 111, 110) { return 3 }
    // "Sedenion" = 8 chars: 83, 101, 100, 101, 110, 105, 111, 110
    if name_matches_str8(n, 83, 101, 100, 101, 110, 105, 111, 110) { return 4 }
    // "Clifford" = 8 chars: 67, 108, 105, 102, 102, 111, 114, 100
    if name_matches_str8(n, 67, 108, 105, 102, 102, 111, 114, 100) { return 5 }
    return 0 - 1
}

// --- Type constructor ---

// ty_hyper constructor is defined in types.sio — this re-export is for
// direct use within hyper.sio predicates.
// See: ty_hyper(alg, elem) and ty_clifford(p, q, elem) in types.sio

// --- Field access for Hyper types ---
// Quaternion: .w, .x, .y, .z (or .real, .i, .j, .k)
// Complex: .real, .imag
// Octonion: .e0 through .e7

fn check_hyper_field_access(c: Checker, span: Span, ty: TypeEntry, field: Name) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let alg = hyper_algebra(ty)
    let inner = hyper_inner(ty)
    var checker = c

    // Complex: .real, .imag
    if alg == 1 {
        if name_matches_str4(field, 114, 101, 97, 108) { return (checker, inner) }  // "real"
        if name_matches_str4(field, 105, 109, 97, 103) { return (checker, inner) }  // "imag"
    }

    // Quaternion: .w, .x, .y, .z
    if alg == 2 {
        if name_matches_str1(field, 119) { return (checker, inner) }  // "w"
        if name_matches_str1(field, 120) { return (checker, inner) }  // "x"
        if name_matches_str1(field, 121) { return (checker, inner) }  // "y"
        if name_matches_str1(field, 122) { return (checker, inner) }  // "z"
    }

    // Octonion/Sedenion/Clifford: accept any component field, return inner
    if alg >= 3 {
        return (checker, inner)
    }

    checker = checker.report_error_at(span, 12, 0, 0, 0)  // E012: unknown field
    // Return inner (plausible field type) after error to keep tail return types consistent
    // (avoids tail type mismatch / return-sig warnings in self-host build).
    (checker, inner)
}

// --- Method calls for Hyper types ---
// .conjugate(), .norm(), .inverse() (if division algebra)

fn check_hyper_method_call(c: Checker, span: Span, ty: TypeEntry, method: Name) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let alg = hyper_algebra(ty)
    var checker = c
    var result_ty: TypeEntry = ty   // default to receiver; assigned per method. Single tail return avoids tail type / sig mismatch in branches.

    // .conjugate() -> same Hyper type
    if name_matches_str9(method, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
        result_ty = ty
        return (checker, result_ty)
    }

    // .norm() -> inner element type (scalar)
    if name_matches_str4(method, 110, 111, 114, 109) {
        result_ty = hyper_inner(ty)
        return (checker, result_ty)
    }

    // .inverse() -> same Hyper type (only for division algebras)
    if name_matches_str7(method, 105, 110, 118, 101, 114, 115, 101) {
        if !is_division_algebra(alg) {
            checker = checker.report_error_at(span, 32, 0, 0, 0)  // E032
            result_ty = ty_error()
            return (checker, result_ty)
        }
        result_ty = ty
        return (checker, result_ty)
    }

    checker = checker.report_error_at(span, 11, 0, 0, 0)  // E011: method not found
    result_ty = ty_error()
    (checker, result_ty)
}

// --- Print helpers ---

fn print_algebra_name(alg: i64) with IO {
    if alg == 0 { print("Real") }
    else if alg == 1 { print("Complex") }
    else if alg == 2 { print("Quaternion") }
    else if alg == 3 { print("Octonion") }
    else if alg == 4 { print("Sedenion") }
    else if alg == 5 { print("Clifford") }
    else { print("Unknown") }
}
