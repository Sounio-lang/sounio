// ----- Test 43: Count generic functions -----
fn test_mono_count_generics() -> i32 with IO, Mut, Div, Panic {
    var table = mono_fn_table_new()
    var s1 = mono_empty_fn_sig()
    s1.is_generic = true
    var s2 = mono_empty_fn_sig()
    s2.is_generic = false
    var s3 = mono_empty_fn_sig()
    s3.is_generic = true
    let i1 = mono_fn_table_add(table, s1)
    let i2 = mono_fn_table_add(table, s2)
    let i3 = mono_fn_table_add(table, s3)
    if mono_count_generic_fns(table) != 2 {
        print("FAIL: test_mono_count_generics\n")
        return 1
    }
    if mono_count_concrete_fns(table) != 1 {
        print("FAIL: test_mono_count_generics - concrete\n")
        return 1
    }
    print("PASS: test_mono_count_generics\n")
    return 0
}

