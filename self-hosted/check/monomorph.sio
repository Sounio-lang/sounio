fn test_mono_cache_four_args() -> i32 with IO, Mut, Div, Panic {
    var cache = mono_cache_new()
    let ta = mono_make_type_args_4(0, 1, 2, 3)
    let ins = mono_cache_insert(cache, 77, ta, 4, 300, 0)
    if mono_cache_lookup(cache, 77, ta, 4) != 300 {
        print("FAIL: test_mono_cache_four_args\n")
        return 1
    }
    if mono_cache_lookup(cache, 77, mono_make_type_args_3(0, 1, 2), 3) != MONO_NOT_FOUND {
