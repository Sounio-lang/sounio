}

// ----- Test 36: Multi-param type args -----
fn test_mono_multi_type_args() -> i32 with IO, Mut, Div, Panic {
    var cache = mono_cache_new()
    let ta = mono_make_type_args_3(0, 1, 2)
    let ins = mono_cache_insert(cache, 50, ta, 3, 200, 0)
    if mono_cache_lookup(cache, 50, ta, 3) != 200 {
        print("FAIL: test_mono_multi_type_args\n")
        return 1
    }
    if mono_cache_lookup(cache, 50, mono_make_type_args_3(2, 1, 0), 3) != MONO_NOT_FOUND {
