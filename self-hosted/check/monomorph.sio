// ----- Test 33: Rewrite call in body -----
fn test_mono_rewrite_call() -> i32 with IO, Mut, Div, Panic {
    var body = mono_empty_fn_body()
    var cn = mono_empty_body_node()
    cn.kind = MONO_NODE_CALL
    cn.callee_fn_id = 42
    cn.callee_type_args = mono_make_type_args_1(0)
    cn.callee_type_arg_count = 1
    body.nodes[0 as usize] = cn
    body.count = 1
    var cache = mono_cache_new()
    let ins = mono_cache_insert(cache, 42, mono_make_type_args_1(0), 1, 100, 0)
    let rw = mono_rewrite_call_in_body(body, cache)
    if rw.nodes[0 as usize].callee_fn_id != 100 {
        print("FAIL: test_mono_rewrite_call - id\n")
        return 1
    }
    if rw.nodes[0 as usize].callee_type_arg_count != 0 {
        print("FAIL: test_mono_rewrite_call - args\n")
        return 1
    }
    print("PASS: test_mono_rewrite_call\n")
    return 0
}

// ----- Test 34: Specialized name hash -----
fn test_mono_specialized_name_hash() -> i32 with IO, Mut, Div, Panic {
    let h1 = mono_specialized_name_hash(12345, mono_make_type_args_1(0), 1)
    let h2 = mono_specialized_name_hash(12345, mono_make_type_args_1(1), 1)
