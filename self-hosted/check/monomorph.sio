}

// ----- Test 37: Ref type substitution -----
fn test_mono_subst_ref() -> i32 with IO, Mut, Div, Panic {
    var pool = test_mono_make_pool()
    let vt = mono_type_pool_alloc_var(pool, 1000)
    let rt = mono_type_pool_alloc_ref(pool, 5, false)
    let rmt = mono_type_pool_alloc_ref(pool, 5, true)
    var m = mono_type_map_new()
    m = mono_type_map_insert(m, 1000, 0)
    let r1 = mono_substitute_type(pool, 6, m)
    let n1 = mono_type_pool_get(pool, r1)
    if n1.kind != MONO_TY_REF {
        print("FAIL: test_mono_subst_ref - ref\n")
        return 1
    }
    if n1.children[0 as usize] != 0 {
        print("FAIL: test_mono_subst_ref - inner\n")
        return 1
    }
    let r2 = mono_substitute_type(pool, 7, m)
    let n2 = mono_type_pool_get(pool, r2)
    if n2.kind != MONO_TY_REF_MUT {
        print("FAIL: test_mono_subst_ref - ref_mut\n")
        return 1
    }
    print("PASS: test_mono_subst_ref\n")
    return 0
}

// ----- Test 38: Tuple type substitution -----
fn test_mono_subst_tuple() -> i32 with IO, Mut, Div, Panic {
    var pool = test_mono_make_pool()
    let vt = mono_type_pool_alloc_var(pool, 1000)
    let vu = mono_type_pool_alloc_var(pool, 1001)
    var elems: [i64; 8] = [5, 6, 0, 0, 0, 0, 0, 0]
    let tup = mono_type_pool_alloc_tuple(pool, elems, 2)
    var m = mono_type_map_new()
    m = mono_type_map_insert(m, 1000, 0)
    m = mono_type_map_insert(m, 1001, 2)
    let result = mono_substitute_type(pool, 7, m)
    let rn = mono_type_pool_get(pool, result)
    if rn.kind != MONO_TY_TUPLE {
        print("FAIL: test_mono_subst_tuple - kind\n")
        return 1
    }
    if rn.children[0 as usize] != 0 {
        print("FAIL: test_mono_subst_tuple - 0\n")
        return 1
    }
    if rn.children[1 as usize] != 2 {
        print("FAIL: test_mono_subst_tuple - 1\n")
        return 1
    }
    print("PASS: test_mono_subst_tuple\n")
    return 0
}

// ----- Test 39: Validate clean body -----
