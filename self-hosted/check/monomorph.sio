}

// ----- Test 35: Duplicate instantiation -----
fn test_mono_duplicate_instantiation() -> i32 with IO, Mut, Div, Panic {
    var cache = mono_cache_new()
    let ta = mono_make_type_args_1(0)
    let ins = mono_cache_insert(cache, 42, ta, 1, 100, 0)
    if mono_is_duplicate_instantiation(cache, 42, ta, 1) == false {
        print("FAIL: test_mono_duplicate_instantiation - dup\n")
        return 1
    }
    if mono_is_duplicate_instantiation(cache, 42, mono_make_type_args_1(1), 1) {
