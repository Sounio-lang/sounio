}

// ----- Test 53: Worklist ordering -----
fn test_mono_worklist_ordering() -> i32 with IO, Mut, Div, Panic {
    var wl = mono_worklist_new()
    let e1 = MonoEntry {
        original_fn_id: 10, type_args: mono_make_type_args_1(0), type_arg_count: 1,
        specialized_fn_id: 0 - 1, depth: 0, is_valid: true,
    }
    let e2 = MonoEntry {
        original_fn_id: 20, type_args: mono_make_type_args_1(1), type_arg_count: 1,
        specialized_fn_id: 0 - 1, depth: 0, is_valid: true,
    }
    wl = mono_worklist_push(wl, e1)
    wl = mono_worklist_push(wl, e2)
    let p = mono_worklist_pop(wl)
    if p.original_fn_id != 10 {
        print("FAIL: test_mono_worklist_ordering\n")
        return 1
    }
    print("PASS: test_mono_worklist_ordering\n")
    return 0
}

// ----- Test 54: fn_is_generic -----
fn test_mono_fn_is_generic() -> i32 with IO, Mut, Div, Panic {
    var table = mono_fn_table_new()
    var s1 = mono_empty_fn_sig()
    s1.is_generic = true
    var s2 = mono_empty_fn_sig()
    s2.is_generic = false
    let i1 = mono_fn_table_add(table, s1)
    let i2 = mono_fn_table_add(table, s2)
    if mono_fn_is_generic(table, 0) == false {
        print("FAIL: test_mono_fn_is_generic - yes\n")
        return 1
    }
    if mono_fn_is_generic(table, 1) {
        print("FAIL: test_mono_fn_is_generic - no\n")
        return 1
    }
    print("PASS: test_mono_fn_is_generic\n")
    return 0
}

// ----- Test 55: Call site list add -----
fn test_mono_call_site_add() -> i32 with IO, Mut, Div, Panic {
    var list = mono_call_site_list_new()
    let site = MonoCallSite {
        callee_fn_id: 10, type_args: mono_make_type_args_1(0), type_arg_count: 1,
        caller_fn_id: 5, node_index: 0,
    }
    list = mono_call_site_list_add(list, site)
    if list.count != 1 {
        print("FAIL: test_mono_call_site_add\n")
        return 1
    }
    if list.sites[0 as usize].callee_fn_id != 10 {
        print("FAIL: test_mono_call_site_add - callee\n")
        return 1
    }
    print("PASS: test_mono_call_site_add\n")
    return 0
}

// ============================================================
// Main test runner
// ============================================================

fn run_mono_tests() -> i32 with IO, Mut, Div, Panic {
    var failures: i32 = 0
    failures = failures + test_mono_cache_insert()
    failures = failures + test_mono_cache_lookup_miss()
    failures = failures + test_mono_cache_no_duplicate()
    failures = failures + test_mono_cache_multiple()
    failures = failures + test_mono_cache_different_fns()
    failures = failures + test_mono_type_map_basic()
    failures = failures + test_mono_type_map_overwrite()
    failures = failures + test_mono_type_map_has()
    failures = failures + test_mono_type_map_clear()
    failures = failures + test_mono_type_map_eq()
    failures = failures + test_mono_subst_simple()
    failures = failures + test_mono_subst_fn_type()
    failures = failures + test_mono_subst_array()
    failures = failures + test_mono_subst_no_change()
    failures = failures + test_mono_subst_nested()
    failures = failures + test_mono_type_has_vars()
    failures = failures + test_mono_type_eq()
    failures = failures + test_mono_type_args_eq_test()
    failures = failures + test_mono_hash_deterministic()
    failures = failures + test_mono_worklist_basic()
    failures = failures + test_mono_worklist_has()
    failures = failures + test_mono_depth_stack_basic()
    failures = failures + test_mono_depth_stack_count()
    failures = failures + test_mono_error_kinds()
    failures = failures + test_mono_error_list()
    failures = failures + test_mono_fn_table_basic()
    failures = failures + test_mono_fn_table_find()
    failures = failures + test_mono_specialize_identity_sig()
    failures = failures + test_mono_specialize_identity_body()
    failures = failures + test_mono_build_type_map()
    failures = failures + test_mono_scan_calls()
    failures = failures + test_mono_scan_dedup()
    failures = failures + test_mono_rewrite_call()
    failures = failures + test_mono_specialized_name_hash()
    failures = failures + test_mono_duplicate_instantiation()
    failures = failures + test_mono_multi_type_args()
    failures = failures + test_mono_subst_ref()
    failures = failures + test_mono_subst_tuple()
    failures = failures + test_mono_validate_clean()
    failures = failures + test_mono_validate_dirty()
    failures = failures + test_mono_validate_generic_call()
    failures = failures + test_mono_pool_roundtrip()
    failures = failures + test_mono_count_generics()
    failures = failures + test_mono_cache_count()
    failures = failures + test_mono_cache_get_entry()
    failures = failures + test_mono_entry_fields()
    failures = failures + test_mono_empty_cache_queries()
    failures = failures + test_mono_type_map_copy()
    failures = failures + test_mono_stats()
    failures = failures + test_mono_error_arg_mismatch()
    failures = failures + test_mono_pool_boundary()
    failures = failures + test_mono_cache_four_args()
    failures = failures + test_mono_worklist_ordering()
    failures = failures + test_mono_fn_is_generic()
    failures = failures + test_mono_call_site_add()

    if failures == 0 {
        print("All monomorph tests passed.\n")
    } else {
        print("Some monomorph tests FAILED.\n")
    }
    return failures
}

