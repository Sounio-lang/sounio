// ============================================================
// Section 20: Tests — Struct layout (tests 9-18)
// ============================================================

// Test 9: Simple struct {i32, i32} — size=8, align=4
fn test_lay_09_simple_struct_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i32
    types[1 as usize] = t_i32
    names[0 as usize] = 100
    names[1 as usize] = 200
    lay_set_fields(ctx, s, &types, &names, 2)
    let l = lay_compute(ctx, s)
    l.size == 8 && l.align == 4 && l.field_count == 2
}
fn test_lay_09_simple_struct() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_09_simple_struct_inner(&! ctx), 9)
}

// Test 10: Struct {i8, i64} — size=16 (padding after i8), align=8
fn test_lay_10_padding_struct_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8 = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i8
    types[1 as usize] = t_i64
    names[0 as usize] = 100
    names[1 as usize] = 200
    lay_set_fields(ctx, s, &types, &names, 2)
    let l = lay_compute(ctx, s)
    // i8 at 0 (1 byte), then 7 bytes padding, i64 at 8, total = 16, align = 8
    l.size == 16 && l.align == 8 && l.fields[1 as usize].offset == 8
}
fn test_lay_10_padding_struct() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_10_padding_struct_inner(&! ctx), 10)
}

// Test 11: Struct {i64, i8} — trailing padding, size=16, align=8
