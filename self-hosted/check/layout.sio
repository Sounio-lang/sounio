// Section 23: Tests — Optimized layout (tests 30-35)
// ============================================================

// Test 30: Optimized {i8, i64, i8} — reorders to {i64, i8, i8}
fn test_lay_30_opt_reorder_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i8
    types[1 as usize] = t_i64
    types[2 as usize] = t_i8
    names[0 as usize] = 1
    names[1 as usize] = 2
    names[2 as usize] = 3
    lay_set_fields(ctx, s, &types, &names, 3)
    let l = lay_compute_struct_optimized(ctx, s)
    // Sorted: i64(align=8), i8(align=1), i8(align=1)
    // i64@0(8), i8@8(1), i8@9(1) => size = align_up(10, 8) = 16
    l.size == 16 && l.align == 8
}
fn test_lay_30_opt_reorder() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_30_opt_reorder_inner(&! ctx), 30)
}

// Test 31: Optimized reduces padding vs declared order
fn test_lay_31_opt_less_padding_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    // Declared: i8, i64, i8, i32 => many gaps
    types[0 as usize] = t_i8
    types[1 as usize] = t_i64
    types[2 as usize] = t_i8
    types[3 as usize] = t_i32
    names[0 as usize] = 1
    names[1 as usize] = 2
    names[2 as usize] = 3
    names[3 as usize] = 4
    lay_set_fields(ctx, s, &types, &names, 4)
    let declared = lay_compute_struct(ctx, s)
    lay_cache_invalidate(ctx, s)
    let optimized = lay_compute_struct_optimized(ctx, s)
    let pad_declared = lay_total_padding(&declared)
    let pad_optimized = lay_total_padding(&optimized)
    pad_optimized <= pad_declared
}
fn test_lay_31_opt_less_padding() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_31_opt_less_padding_inner(&! ctx), 31)
}

