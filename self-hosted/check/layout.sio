    let a4 = lay_align_up(5, 8)
    let a5 = lay_align_up(7, 1)
    a1 == 0 && a2 == 4 && a3 == 4 && a4 == 8 && a5 == 7
}
fn test_lay_49_align_up() -> i64 with IO {
    lay_assert(test_lay_49_align_up_inner(), 49)
}

