// ============================================================
// Section 27: Tests — Caching (tests 55-57)
// ============================================================

// Test 55: Cache hit — second compute is cached
fn test_lay_55_cache_hit_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    // First compute — should miss cache and insert
    let l1 = lay_compute(ctx, t_i32)
    // Second compute — should hit cache
    let cidx = lay_cache_lookup(ctx, t_i32)
    cidx != LAY_INVALID && l1.size == 4
}
fn test_lay_55_cache_hit() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_55_cache_hit_inner(&! ctx), 55)
}

// Test 56: Cache miss — unregistered type
fn test_lay_56_cache_miss_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let cidx = lay_cache_lookup(ctx, 999)
    cidx == LAY_INVALID
}
fn test_lay_56_cache_miss() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_56_cache_miss_inner(&! ctx), 56)
}

// Test 57: Cache invalidation
fn test_lay_57_cache_invalidate_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let l1 = lay_compute(ctx, t_i64)
    // Verify cached
    let before = lay_cache_lookup(ctx, t_i64)
    let ok_before = before != LAY_INVALID
    // Invalidate
    lay_cache_invalidate(ctx, t_i64)
    let after = lay_cache_lookup(ctx, t_i64)
    let ok_after = after == LAY_INVALID
    ok_before && ok_after
}
fn test_lay_57_cache_invalidate() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_57_cache_invalidate_inner(&! ctx), 57)
}

// ============================================================
// Section 28: Tests — Integration (tests 58-60)
// ============================================================

// Test 58: Complex nested type — struct containing array and another struct
fn test_lay_58_complex_nested_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    // Inner struct: {i32, i8} => size=8, align=4
    let inner = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var inner_types: [i64; 256] = [0; 256]
    var inner_names: [i64; 256] = [0; 256]
    inner_types[0 as usize] = t_i32
    inner_types[1 as usize] = t_i8
    inner_names[0 as usize] = 10
    inner_names[1 as usize] = 20
    lay_set_fields(ctx, inner, &inner_types, &inner_names, 2)
    // Array: [i32; 4] => size=16, align=4
    let arr = lay_register_type(ctx, LayTypeKind::TkArray, LayRepr::ReprDefault)
    lay_set_array_info(ctx, arr, t_i32, 4)
    // Outer struct: {i64, inner, arr}
    let outer = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var outer_types: [i64; 256] = [0; 256]
    var outer_names: [i64; 256] = [0; 256]
    outer_types[0 as usize] = t_i64
    outer_types[1 as usize] = inner
    outer_types[2 as usize] = arr
    outer_names[0 as usize] = 30
    outer_names[1 as usize] = 40
    outer_names[2 as usize] = 50
    lay_set_fields(ctx, outer, &outer_types, &outer_names, 3)
    let l = lay_compute(ctx, outer)
    // i64@0(8), inner@8(8, align=4), arr@16(16, align=4) => total=32, align=8
    l.size == 32 && l.align == 8 && l.fields[1 as usize].offset == 8
}
fn test_lay_58_complex_nested() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_58_complex_nested_inner(&! ctx), 58)
}

// Test 59: Layout equality comparison
fn test_lay_59_layout_eq_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t1 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let t2 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let l1 = lay_compute(ctx, t1)
    let l2 = lay_compute(ctx, t2)
    // Both are i32 with identical layout
    let eq = lay_layout_eq(&l1, &l2)
    // Compare with a different type
    let t3 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let l3 = lay_compute(ctx, t3)
    let neq = lay_layout_eq(&l1, &l3) == false
    eq && neq
}
fn test_lay_59_layout_eq() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_59_layout_eq_inner(&! ctx), 59)
}

// Test 60: Ref and MutRef layout on 64-bit target
fn test_lay_60_ref_layout_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_ref = lay_register_type(ctx, LayTypeKind::TkRef, LayRepr::ReprDefault)
    let t_mut = lay_register_type(ctx, LayTypeKind::TkMutRef, LayRepr::ReprDefault)
    let l_ref = lay_compute(ctx, t_ref)
    let l_mut = lay_compute(ctx, t_mut)
    let ok_ref = l_ref.size == 8 && l_ref.align == 8
    let ok_mut = l_mut.size == 8 && l_mut.align == 8
    let eq = lay_layout_eq(&l_ref, &l_mut)
    ok_ref && ok_mut && eq
}
fn test_lay_60_ref_layout() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_60_ref_layout_inner(&! ctx), 60)
}

