    let s1 = lay_stride(5, 4)
    let s2 = lay_stride(8, 8)
    let s3 = lay_stride(1, 1)
    let s4 = lay_stride(9, 8)
    s1 == 8 && s2 == 8 && s3 == 1 && s4 == 16
}
fn test_lay_50_stride() -> i64 with IO {
    lay_assert(test_lay_50_stride_inner(), 50)
}

// Test 51: Extra alignment override
fn test_lay_51_extra_align_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprAligned)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprAligned)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i32
    names[0 as usize] = 1
    lay_set_fields(ctx, s, &types, &names, 1)
    lay_set_extra_align(ctx, s, 16)
    let l = lay_compute(ctx, s)
    // i32 is 4 bytes but align overridden to 16 => size = 16, align = 16
    l.align == 16 && l.size == 16
}
fn test_lay_51_extra_align() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_51_extra_align_inner(&! ctx), 51)
}

