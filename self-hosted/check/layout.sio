// Type layout computation for the self-hosted Sounio compiler
//
// Computes size, alignment, field offsets, ABI padding, and discriminant
// layout for all type kinds.  Supports default (Sounio), C-compatible,
// packed, transparent, and alignment-overridden representations.
//
// Architecture:
//   LayTypeKind       — tag for primitive / composite type kinds
//   LayRepr           — representation strategy (default, C, packed, etc.)
//   LayDiscriminantSize — discriminant width for enums
//   LayFieldOrder     — field ordering strategy for struct layout
//   LayField          — single field: offset, size, align, padding
//   LayLayout         — complete layout: size, align, stride, fields
//   LayVariantLayout  — single enum variant layout
//   LayEnumLayout     — full enum layout with discriminant + variants
//   LayTypeDesc       — type descriptor registered in the context
//   LayCacheEntry     — layout cache entry
//   LayContext        — flat arena holding types and cache
//
// All names use the `lay_` prefix to avoid global namespace collisions.
// Helpers always precede their callers (no forward references).
//
// The key design decision: lay_compute is the single recursive entry
// point.  All specific layout functions (struct, array, enum, tuple)
// accept pre-resolved field sizes and alignments as arrays, avoiding
// circular dependencies between functions.

// ============================================================
// Section 1: Constants
// ============================================================

let LAY_MAX_FIELDS: i64 = 256
let LAY_MAX_VARIANTS: i64 = 128
let LAY_MAX_TYPES: i64 = 1024
let LAY_MAX_CACHE: i64 = 512
let LAY_PTR_SIZE: i64 = 8
let LAY_PTR_ALIGN: i64 = 8
let LAY_MAX_ALIGN: i64 = 64
let LAY_INVALID: i64 = 0 - 1

// ============================================================
// Section 2: Enumerations
// ============================================================

enum LayTypeKind {
    TkI8,
    TkI16,
    TkI32,
    TkI64,
    TkF32,
    TkF64,
    TkBool,
    TkPtr,
    TkRef,
    TkMutRef,
    TkArray,
    TkStruct,
    TkEnum,
    TkTuple,
    TkUnit,
    TkNever,
    TkOpaque,
}

enum LayRepr {
    ReprDefault,
    ReprC,
    ReprPacked,
    ReprTransparent,
    ReprAligned,
}

enum LayDiscriminantSize {
    Disc8,
    Disc16,
    Disc32,
    Disc64,
}

enum LayFieldOrder {
    OrderDeclared,
    OrderOptimized,
    OrderAlphabetical,
}

// ============================================================
// Section 3: Structs
// ============================================================

pub struct LayField {
    name_hash: i64,
    type_id: i64,
    offset: i64,
    size: i64,
    align: i64,
    padding_before: i64,
}

pub struct LayLayout {
    size: i64,
    align: i64,
    stride: i64,
    field_count: i64,
    fields: [LayField; 256],
}

pub struct LayVariantLayout {
    variant_id: i64,
    payload_size: i64,
    payload_align: i64,
    field_count: i64,
    fields: [LayField; 64],
}

pub struct LayEnumLayout {
    disc_size: LayDiscriminantSize,
    disc_offset: i64,
    total_size: i64,
    total_align: i64,
    variant_count: i64,
    variants: [LayVariantLayout; 128],
    is_niche_opt: bool,
}

pub struct LayTypeDesc {
    id: i64,
    kind: LayTypeKind,
    repr: LayRepr,
    extra_align: i64,
    element_type: i64,
    element_count: i64,
    field_types: [i64; 256],
    field_names: [i64; 256],
    field_count: i64,
    variant_count: i64,
}

pub struct LayCacheEntry {
    type_id: i64,
    layout: LayLayout,
    valid: bool,
}

pub struct LayContext {
    types: [LayTypeDesc; 1024],
    type_count: i64,
    cache: [LayCacheEntry; 512],
    cache_count: i64,
    target_ptr_size: i64,
    target_max_align: i64,
}

// Pre-resolved field information for passing to layout functions.
// Avoids circular dependencies: lay_compute resolves fields, then
// passes the resolved sizes/alignments to the specific layout function.
pub struct LayResolvedFields {
    sizes: [i64; 256],
    aligns: [i64; 256],
    name_hashes: [i64; 256],
    type_ids: [i64; 256],
    count: i64,
}

// ============================================================
// Section 4: Default constructors
// ============================================================

fn lay_field_empty() -> LayField {
    LayField {
        name_hash: 0,
        type_id: 0,
        offset: 0,
        size: 0,
        align: 0,
        padding_before: 0,
    }
}

fn lay_layout_empty() -> LayLayout {
    LayLayout {
        size: 0,
        align: 1,
        stride: 0,
        field_count: 0,
        fields: [lay_field_empty(); 256],
    }
}

fn lay_variant_layout_empty() -> LayVariantLayout {
    LayVariantLayout {
        variant_id: 0,
        payload_size: 0,
        payload_align: 1,
        field_count: 0,
        fields: [lay_field_empty(); 64],
    }
}

fn lay_enum_layout_empty() -> LayEnumLayout {
    LayEnumLayout {
        disc_size: LayDiscriminantSize::Disc8,
        disc_offset: 0,
        total_size: 0,
        total_align: 1,
        variant_count: 0,
        variants: [lay_variant_layout_empty(); 128],
        is_niche_opt: false,
    }
}

fn lay_type_desc_empty() -> LayTypeDesc {
    LayTypeDesc {
        id: 0,
        kind: LayTypeKind::TkUnit,
        repr: LayRepr::ReprDefault,
        extra_align: 0,
        element_type: 0,
        element_count: 0,
        field_types: [0; 256],
        field_names: [0; 256],
        field_count: 0,
        variant_count: 0,
    }
}

fn lay_cache_entry_empty() -> LayCacheEntry {
    LayCacheEntry {
        type_id: LAY_INVALID,
        layout: lay_layout_empty(),
        valid: false,
    }
}

fn lay_resolved_fields_empty() -> LayResolvedFields {
    LayResolvedFields {
        sizes: [0; 256],
        aligns: [0; 256],
        name_hashes: [0; 256],
        type_ids: [0; 256],
        count: 0,
    }
}

// ============================================================
// Section 5: Alignment and stride helpers
// ============================================================

// Round `offset` up to the next multiple of `align`.
// Precondition: align > 0.
fn lay_align_up(offset: i64, align: i64) -> i64 {
    if align <= 1 {
        return offset
    }
    let remainder = offset - (offset / align) * align
    if remainder == 0 {
        return offset
    }
    return offset + (align - remainder)
}

// Compute stride: the distance between consecutive array elements.
// stride = align_up(size, align)
fn lay_stride(size: i64, align: i64) -> i64 {
    lay_align_up(size, align)
}

// Check whether a value is a power of two (positive only).
fn lay_is_power_of_two(v: i64) -> bool {
    if v <= 0 { return false }
    if v == 1 { return true }
    if v == 2 { return true }
    if v == 4 { return true }
    if v == 8 { return true }
    if v == 16 { return true }
    if v == 32 { return true }
    if v == 64 { return true }
    if v == 128 { return true }
    if v == 256 { return true }
    if v == 512 { return true }
    if v == 1024 { return true }
    if v == 2048 { return true }
    if v == 4096 { return true }
    return false
}

// Return the maximum of two values.
fn lay_max(a: i64, b: i64) -> i64 {
    if a >= b { return a }
    return b
}

// Return the minimum of two values.
fn lay_min(a: i64, b: i64) -> i64 {
    if a <= b { return a }
    return b
}

// ============================================================
// Section 6: Primitive size and alignment
// ============================================================

// Size of a primitive type in bytes.
fn lay_primitive_size(kind: LayTypeKind) -> i64 {
    match kind {
        LayTypeKind::TkI8    => 1,
        LayTypeKind::TkBool  => 1,
        LayTypeKind::TkI16   => 2,
        LayTypeKind::TkI32   => 4,
        LayTypeKind::TkF32   => 4,
        LayTypeKind::TkI64   => 8,
        LayTypeKind::TkF64   => 8,
        LayTypeKind::TkPtr   => LAY_PTR_SIZE,
        LayTypeKind::TkRef   => LAY_PTR_SIZE,
        LayTypeKind::TkMutRef => LAY_PTR_SIZE,
        LayTypeKind::TkUnit   => 0,
        LayTypeKind::TkNever  => 0,
        LayTypeKind::TkOpaque => 0,
        LayTypeKind::TkArray  => 0,
        LayTypeKind::TkStruct => 0,
        LayTypeKind::TkEnum   => 0,
        LayTypeKind::TkTuple  => 0
    }
}

// Natural alignment of a primitive type in bytes.
fn lay_primitive_align(kind: LayTypeKind) -> i64 {
    match kind {
        LayTypeKind::TkI8    => 1,
        LayTypeKind::TkBool  => 1,
        LayTypeKind::TkI16   => 2,
        LayTypeKind::TkI32   => 4,
        LayTypeKind::TkF32   => 4,
        LayTypeKind::TkI64   => 8,
        LayTypeKind::TkF64   => 8,
        LayTypeKind::TkPtr   => LAY_PTR_ALIGN,
        LayTypeKind::TkRef   => LAY_PTR_ALIGN,
        LayTypeKind::TkMutRef => LAY_PTR_ALIGN,
        LayTypeKind::TkUnit   => 1,
        LayTypeKind::TkNever  => 1,
        LayTypeKind::TkOpaque => 1,
        LayTypeKind::TkArray  => 1,
        LayTypeKind::TkStruct => 1,
        LayTypeKind::TkEnum   => 1,
        LayTypeKind::TkTuple  => 1
    }
}

// Check if a type kind is primitive (has known size without recursion).
fn lay_is_primitive(kind: LayTypeKind) -> bool {
    match kind {
        LayTypeKind::TkI8     => true,
        LayTypeKind::TkI16    => true,
        LayTypeKind::TkI32    => true,
        LayTypeKind::TkI64    => true,
        LayTypeKind::TkF32    => true,
        LayTypeKind::TkF64    => true,
        LayTypeKind::TkBool   => true,
        LayTypeKind::TkPtr    => true,
        LayTypeKind::TkRef    => true,
        LayTypeKind::TkMutRef => true,
        LayTypeKind::TkUnit   => true,
        LayTypeKind::TkNever  => true,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkArray  => false,
        LayTypeKind::TkStruct => false,
        LayTypeKind::TkEnum   => false,
        LayTypeKind::TkTuple  => false
    }
}

// Helper: check if kind is TkStruct
fn lay_is_struct(kind: LayTypeKind) -> bool {
    match kind {
        LayTypeKind::TkStruct => true,
        LayTypeKind::TkI8     => false,
        LayTypeKind::TkI16    => false,
        LayTypeKind::TkI32    => false,
        LayTypeKind::TkI64    => false,
        LayTypeKind::TkF32    => false,
        LayTypeKind::TkF64    => false,
        LayTypeKind::TkBool   => false,
        LayTypeKind::TkPtr    => false,
        LayTypeKind::TkRef    => false,
        LayTypeKind::TkMutRef => false,
        LayTypeKind::TkUnit   => false,
        LayTypeKind::TkNever  => false,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkArray  => false,
        LayTypeKind::TkEnum   => false,
        LayTypeKind::TkTuple  => false
    }
}

// Helper: check if kind is TkArray
fn lay_is_array(kind: LayTypeKind) -> bool {
    match kind {
        LayTypeKind::TkArray  => true,
        LayTypeKind::TkI8     => false,
        LayTypeKind::TkI16    => false,
        LayTypeKind::TkI32    => false,
        LayTypeKind::TkI64    => false,
        LayTypeKind::TkF32    => false,
        LayTypeKind::TkF64    => false,
        LayTypeKind::TkBool   => false,
        LayTypeKind::TkPtr    => false,
        LayTypeKind::TkRef    => false,
        LayTypeKind::TkMutRef => false,
        LayTypeKind::TkUnit   => false,
        LayTypeKind::TkNever  => false,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkStruct => false,
        LayTypeKind::TkEnum   => false,
        LayTypeKind::TkTuple  => false
    }
}

// Helper: check if kind is TkTuple
fn lay_is_tuple(kind: LayTypeKind) -> bool {
    match kind {
        LayTypeKind::TkTuple  => true,
        LayTypeKind::TkI8     => false,
        LayTypeKind::TkI16    => false,
        LayTypeKind::TkI32    => false,
        LayTypeKind::TkI64    => false,
        LayTypeKind::TkF32    => false,
        LayTypeKind::TkF64    => false,
        LayTypeKind::TkBool   => false,
        LayTypeKind::TkPtr    => false,
        LayTypeKind::TkRef    => false,
        LayTypeKind::TkMutRef => false,
        LayTypeKind::TkUnit   => false,
        LayTypeKind::TkNever  => false,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkStruct => false,
        LayTypeKind::TkArray  => false,
        LayTypeKind::TkEnum   => false
    }
}

// Helper: check if kind is TkEnum
fn lay_is_enum(kind: LayTypeKind) -> bool {
    match kind {
        LayTypeKind::TkEnum   => true,
        LayTypeKind::TkI8     => false,
        LayTypeKind::TkI16    => false,
        LayTypeKind::TkI32    => false,
        LayTypeKind::TkI64    => false,
        LayTypeKind::TkF32    => false,
        LayTypeKind::TkF64    => false,
        LayTypeKind::TkBool   => false,
        LayTypeKind::TkPtr    => false,
        LayTypeKind::TkRef    => false,
        LayTypeKind::TkMutRef => false,
        LayTypeKind::TkUnit   => false,
        LayTypeKind::TkNever  => false,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkStruct => false,
        LayTypeKind::TkArray  => false,
        LayTypeKind::TkTuple  => false
    }
}

// Helper: check if repr is ReprC
fn lay_is_repr_c(repr: LayRepr) -> bool {
    match repr {
        LayRepr::ReprC           => true,
        LayRepr::ReprDefault     => false,
        LayRepr::ReprPacked      => false,
        LayRepr::ReprTransparent => false,
        LayRepr::ReprAligned     => false
    }
}

// Helper: check if repr is ReprPacked
fn lay_is_repr_packed(repr: LayRepr) -> bool {
    match repr {
        LayRepr::ReprPacked      => true,
        LayRepr::ReprDefault     => false,
        LayRepr::ReprC           => false,
        LayRepr::ReprTransparent => false,
        LayRepr::ReprAligned     => false
    }
}

// ============================================================
// Section 7: Discriminant helpers
// ============================================================

// Determine the minimum discriminant size for a given variant count.
fn lay_discriminant_size(variant_count: i64) -> LayDiscriminantSize {
    if variant_count <= 256 {
        return LayDiscriminantSize::Disc8
    }
    if variant_count <= 65536 {
        return LayDiscriminantSize::Disc16
    }
    if variant_count <= 2147483647 {
        return LayDiscriminantSize::Disc32
    }
    return LayDiscriminantSize::Disc64
}

// Convert a discriminant size tag to its byte count.
fn lay_disc_size_bytes(disc: LayDiscriminantSize) -> i64 {
    match disc {
        LayDiscriminantSize::Disc8  => 1,
        LayDiscriminantSize::Disc16 => 2,
        LayDiscriminantSize::Disc32 => 4,
        LayDiscriminantSize::Disc64 => 8
    }
}

// Natural alignment of a discriminant (same as its size).
fn lay_disc_align(disc: LayDiscriminantSize) -> i64 {
    lay_disc_size_bytes(disc)
}

// ============================================================
// Section 8: Context construction
// ============================================================

// Create a new layout context targeting x86-64 (8-byte pointers).
fn lay_context_new() -> LayContext {
    LayContext {
        types: [lay_type_desc_empty(); 1024],
        type_count: 0,
        cache: [lay_cache_entry_empty(); 512],
        cache_count: 0,
        target_ptr_size: 8,
        target_max_align: 64,
    }
}

// Create a new layout context targeting 32-bit (4-byte pointers).
fn lay_context_new_32bit() -> LayContext {
    LayContext {
        types: [lay_type_desc_empty(); 1024],
        type_count: 0,
        cache: [lay_cache_entry_empty(); 512],
        cache_count: 0,
        target_ptr_size: 4,
        target_max_align: 32,
    }
}

// ============================================================
// Section 9: Type registration
// ============================================================

// Register a new type in the context and return its type ID.
// Returns LAY_INVALID if the type table is full.
fn lay_register_type(ctx: &! LayContext, kind: LayTypeKind, repr: LayRepr) -> i64 with Mut, Div, Panic {
    if ctx.type_count >= LAY_MAX_TYPES {
        return LAY_INVALID
    }
    let id = ctx.type_count
    var desc = lay_type_desc_empty()
    desc.id = id
    desc.kind = kind
    desc.repr = repr
    ctx.types[id as usize] = desc
    ctx.type_count = ctx.type_count + 1
    return id
}

// Set the field types and name hashes for a struct or tuple type.
fn lay_set_fields(ctx: &! LayContext, type_id: i64, types: &[i64; 256], names: &[i64; 256], count: i64) with Mut, Div, Panic {
    if type_id < 0 { return }
    if type_id >= ctx.type_count { return }
    let limit = lay_min(count, LAY_MAX_FIELDS)
    var desc = ctx.types[type_id as usize]
    var i = 0
    while i < limit {
        desc.field_types[i as usize] = types[i as usize]
        desc.field_names[i as usize] = names[i as usize]
        i = i + 1
    }
    desc.field_count = limit
    ctx.types[type_id as usize] = desc
}

// Set array element type and element count for an array type.
fn lay_set_array_info(ctx: &! LayContext, type_id: i64, element_type: i64, count: i64) with Mut, Div, Panic {
    if type_id < 0 { return }
    if type_id >= ctx.type_count { return }
    var desc = ctx.types[type_id as usize]
    desc.element_type = element_type
    desc.element_count = count
    ctx.types[type_id as usize] = desc
}

// Set extra alignment override for a type (used by ReprAligned).
fn lay_set_extra_align(ctx: &! LayContext, type_id: i64, align: i64) with Mut, Div, Panic {
    if type_id < 0 { return }
    if type_id >= ctx.type_count { return }
    var desc = ctx.types[type_id as usize]
    desc.extra_align = align
    ctx.types[type_id as usize] = desc
}

// Set the number of variants for an enum type.
fn lay_set_variant_count(ctx: &! LayContext, type_id: i64, count: i64) with Mut, Div, Panic {
    if type_id < 0 { return }
    if type_id >= ctx.type_count { return }
    var desc = ctx.types[type_id as usize]
    desc.variant_count = count
    ctx.types[type_id as usize] = desc
}

// ============================================================
// Section 10: Cache operations
// ============================================================

// Look up a type layout in the cache.
// Returns the cache index if found, or LAY_INVALID on cache miss.
fn lay_cache_lookup(ctx: &LayContext, type_id: i64) -> i64 with Mut, Div, Panic {
    var i = 0
    while i < ctx.cache_count {
        let entry = ctx.cache[i as usize]
        if entry.valid && entry.type_id == type_id {
            return i
        }
        i = i + 1
    }
    return LAY_INVALID
}

// Insert a layout into the cache.
fn lay_cache_insert(ctx: &! LayContext, type_id: i64, layout: &LayLayout) with Mut, Div, Panic {
    // Check if already cached; update in place
    var i = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].type_id == type_id {
            var entry = ctx.cache[i as usize]
            entry.layout = *layout
            entry.valid = true
            ctx.cache[i as usize] = entry
            return
        }
        i = i + 1
    }
    // Insert new entry
    if ctx.cache_count < LAY_MAX_CACHE {
        var entry = lay_cache_entry_empty()
        entry.type_id = type_id
        entry.layout = *layout
        entry.valid = true
        ctx.cache[ctx.cache_count as usize] = entry
        ctx.cache_count = ctx.cache_count + 1
    } else {
        // Ring buffer: overwrite at position (type_id mod capacity)
        var slot = type_id
        if slot < 0 { slot = 0 - slot }
        slot = slot - (slot / LAY_MAX_CACHE) * LAY_MAX_CACHE
        var entry = ctx.cache[slot as usize]
        entry.type_id = type_id
        entry.layout = *layout
        entry.valid = true
        ctx.cache[slot as usize] = entry
    }
}

// Retrieve a cached layout by cache index.
fn lay_cache_get(ctx: &LayContext, cache_idx: i64) -> LayLayout with Div, Panic {
    if cache_idx < 0 { return lay_layout_empty() }
    if cache_idx >= ctx.cache_count { return lay_layout_empty() }
    return ctx.cache[cache_idx as usize].layout
}

// Invalidate a specific type's cache entry.
fn lay_cache_invalidate(ctx: &! LayContext, type_id: i64) with Mut, Div, Panic {
    var i = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].type_id == type_id {
            var entry = ctx.cache[i as usize]
            entry.valid = false
            ctx.cache[i as usize] = entry
            return
        }
        i = i + 1
    }
}

// ============================================================
// Section 11: Primitive layout computation
// ============================================================

// Compute layout for a primitive type kind.
// For pointer-sized types, uses the context's target pointer size.
fn lay_compute_primitive(ctx: &LayContext, kind: LayTypeKind) -> LayLayout with Mut {
    var result = lay_layout_empty()
    let is_ptr = match kind {
        LayTypeKind::TkPtr    => true,
        LayTypeKind::TkRef    => true,
        LayTypeKind::TkMutRef => true,
        LayTypeKind::TkI8     => false,
        LayTypeKind::TkI16    => false,
        LayTypeKind::TkI32    => false,
        LayTypeKind::TkI64    => false,
        LayTypeKind::TkF32    => false,
        LayTypeKind::TkF64    => false,
        LayTypeKind::TkBool   => false,
        LayTypeKind::TkUnit   => false,
        LayTypeKind::TkNever  => false,
        LayTypeKind::TkOpaque => false,
        LayTypeKind::TkArray  => false,
        LayTypeKind::TkStruct => false,
        LayTypeKind::TkEnum   => false,
        LayTypeKind::TkTuple  => false
    }
    if is_ptr {
        result.size = ctx.target_ptr_size
        result.align = ctx.target_ptr_size
        result.stride = ctx.target_ptr_size
    } else {
        result.size = lay_primitive_size(kind)
        result.align = lay_primitive_align(kind)
        if result.size == 0 {
            result.stride = 0
        } else {
            result.stride = lay_stride(result.size, result.align)
        }
    }
    return result
}

// ============================================================
// Section 12: Non-recursive layout functions
// These accept pre-resolved field sizes/alignments, avoiding
// any need to call lay_compute (which is defined later).
// ============================================================

// Compute struct layout from pre-resolved fields.
// Fields laid out in declaration order with natural alignment padding.
fn lay_layout_struct_from_resolved(rf: &LayResolvedFields) -> LayLayout with Mut, Div, Panic {
    var result = lay_layout_empty()
    var offset = 0
    var max_align = 1
    var i = 0
    while i < rf.count {
        var f = lay_field_empty()
        f.name_hash = rf.name_hashes[i as usize]
        f.type_id = rf.type_ids[i as usize]
        f.size = rf.sizes[i as usize]
        f.align = rf.aligns[i as usize]
        let aligned_offset = lay_align_up(offset, f.align)
        f.padding_before = aligned_offset - offset
        f.offset = aligned_offset
        result.fields[i as usize] = f
        offset = aligned_offset + f.size
        if f.align > max_align {
            max_align = f.align
        }
        i = i + 1
    }
    result.field_count = rf.count
    result.align = max_align
    result.size = lay_align_up(offset, max_align)
    result.stride = lay_stride(result.size, result.align)
    return result
}

// Compute C-compatible struct layout from pre-resolved fields.
// Follows the System V ABI: declaration order, natural alignment,
// total size padded to struct alignment.
fn lay_layout_struct_c_from_resolved(rf: &LayResolvedFields) -> LayLayout with Mut, Div, Panic {
    // C-compatible layout follows the same rules as default Sounio layout
    return lay_layout_struct_from_resolved(rf)
}

// Compute packed struct layout from pre-resolved fields.
// All fields packed with no alignment padding (align = 1).
fn lay_layout_struct_packed_from_resolved(rf: &LayResolvedFields) -> LayLayout with Mut, Div, Panic {
    var result = lay_layout_empty()
    var offset = 0
    var i = 0
    while i < rf.count {
        var f = lay_field_empty()
        f.name_hash = rf.name_hashes[i as usize]
        f.type_id = rf.type_ids[i as usize]
        f.size = rf.sizes[i as usize]
        f.align = 1
        f.padding_before = 0
        f.offset = offset
        result.fields[i as usize] = f
        offset = offset + f.size
        i = i + 1
    }
    result.field_count = rf.count
    result.align = 1
    result.size = offset
    result.stride = offset
    return result
}

// Sort resolved fields by alignment descending (for optimized layout).
// Insertion sort, stable for equal alignment.
fn lay_sort_resolved_by_align(rf: &! LayResolvedFields) with Mut, Div, Panic {
    if rf.count <= 1 { return }
    var i = 1
    while i < rf.count {
        let key_size = rf.sizes[i as usize]
        let key_align = rf.aligns[i as usize]
        let key_name = rf.name_hashes[i as usize]
        let key_tid = rf.type_ids[i as usize]
        var j = i - 1
        var done = false
        while j >= 0 && done == false {
            if rf.aligns[j as usize] < key_align {
                rf.sizes[(j + 1) as usize] = rf.sizes[j as usize]
                rf.aligns[(j + 1) as usize] = rf.aligns[j as usize]
                rf.name_hashes[(j + 1) as usize] = rf.name_hashes[j as usize]
                rf.type_ids[(j + 1) as usize] = rf.type_ids[j as usize]
                j = j - 1
            } else {
                done = true
            }
        }
        rf.sizes[(j + 1) as usize] = key_size
        rf.aligns[(j + 1) as usize] = key_align
        rf.name_hashes[(j + 1) as usize] = key_name
        rf.type_ids[(j + 1) as usize] = key_tid
        i = i + 1
    }
}

// Compute optimized struct layout from pre-resolved fields.
// Fields are sorted by alignment (descending) before layout.
fn lay_layout_struct_optimized_from_resolved(rf: &! LayResolvedFields) -> LayLayout with Mut, Div, Panic {
    lay_sort_resolved_by_align(rf)
    return lay_layout_struct_from_resolved(rf)
}

// ============================================================
// Section 13: Enum layout from pre-resolved variant payloads
// ============================================================

// Compute full enum layout given variant count and the pre-resolved
// variant payloads.  Each variant's payload size and alignment are
// provided in the resolved fields structure (one entry per variant).
fn lay_layout_enum_from_resolved(
    vcount: i64,
    variant_sizes: &[i64; 128],
    variant_aligns: &[i64; 128],
    extra_align: i64
) -> LayEnumLayout with Mut, Div, Panic {
    var result = lay_enum_layout_empty()
    if vcount <= 0 { return result }
    result.variant_count = vcount
    result.disc_size = lay_discriminant_size(vcount)
    let disc_bytes = lay_disc_size_bytes(result.disc_size)
    let disc_a = lay_disc_align(result.disc_size)
    // Find the maximum payload size and alignment
    var max_payload_size = 0
    var max_payload_align = 1
    var vi = 0
    while vi < vcount {
        if vi < LAY_MAX_VARIANTS {
            var vl = lay_variant_layout_empty()
            vl.variant_id = vi
            vl.payload_size = variant_sizes[vi as usize]
            vl.payload_align = variant_aligns[vi as usize]
            result.variants[vi as usize] = vl
            if vl.payload_size > max_payload_size {
                max_payload_size = vl.payload_size
            }
            if vl.payload_align > max_payload_align {
                max_payload_align = vl.payload_align
            }
        }
        vi = vi + 1
    }
    // Discriminant first, then payload with alignment
    result.disc_offset = 0
    let overall_align = lay_max(disc_a, max_payload_align)
    let payload_offset = lay_align_up(disc_bytes, max_payload_align)
    let total_raw = payload_offset + max_payload_size
    result.total_align = overall_align
    result.total_size = lay_align_up(total_raw, overall_align)
    // Apply extra alignment
    if extra_align > result.total_align {
        result.total_align = extra_align
        result.total_size = lay_align_up(result.total_size, result.total_align)
    }
    // Niche optimization: single-variant enums need no discriminant
    if vcount == 1 {
        result.is_niche_opt = true
        result.disc_size = LayDiscriminantSize::Disc8
        result.total_size = max_payload_size
        if max_payload_size == 0 {
            result.total_align = 1
        } else {
            result.total_align = max_payload_align
        }
        result.total_size = lay_align_up(result.total_size, result.total_align)
    }
    return result
}

// ============================================================
// Section 14: Field query helpers
// ============================================================

// Get the offset of a field by index from a completed layout.
fn lay_field_offset(layout: &LayLayout, field_idx: i64) -> i64 with Div, Panic {
    if field_idx < 0 { return 0 }
    if field_idx >= layout.field_count { return 0 }
    return layout.fields[field_idx as usize].offset
}

// Compute total padding bytes in a layout (size minus sum of field sizes).
fn lay_total_padding(layout: &LayLayout) -> i64 with Mut, Div, Panic {
    var field_sizes = 0
    var i = 0
    while i < layout.field_count {
        field_sizes = field_sizes + layout.fields[i as usize].size
        i = i + 1
    }
    let padding = layout.size - field_sizes
    if padding < 0 { return 0 }
    return padding
}

// Return the trailing padding of a layout (after the last field to the end).
fn lay_trailing_padding(layout: &LayLayout) -> i64 with Div, Panic {
    if layout.field_count == 0 { return layout.size }
    let last_idx = layout.field_count - 1
    let last_field = layout.fields[last_idx as usize]
    let end_of_last = last_field.offset + last_field.size
    let trailing = layout.size - end_of_last
    if trailing < 0 { return 0 }
    return trailing
}

// Check if two layouts have the same size, alignment, and stride.
fn lay_layout_eq(a: &LayLayout, b: &LayLayout) -> bool {
    a.size == b.size && a.align == b.align && a.stride == b.stride
}

// Check if a layout has zero size (ZST).
fn lay_is_zst(layout: &LayLayout) -> bool {
    layout.size == 0
}

// Return the number of padding bytes before a specific field.
fn lay_field_padding(layout: &LayLayout, field_idx: i64) -> i64 with Div, Panic {
    if field_idx < 0 { return 0 }
    if field_idx >= layout.field_count { return 0 }
    return layout.fields[field_idx as usize].padding_before
}

// ============================================================
// Section 15: Deprecated standalone sort (for direct calls)
// ============================================================

// Sort fields descending by alignment (largest alignment first).
// Uses insertion sort (suitable for field counts up to 256).
fn lay_sort_fields_by_align(fields: &! [LayField; 256], count: i64) with Mut, Div, Panic {
    if count <= 1 { return }
    var i = 1
    while i < count {
        let key = fields[i as usize]
        var j = i - 1
        var done = false
        while j >= 0 && done == false {
            if fields[j as usize].align < key.align {
                fields[(j + 1) as usize] = fields[j as usize]
                j = j - 1
            } else {
                done = true
            }
        }
        fields[(j + 1) as usize] = key
        i = i + 1
    }
}

// ============================================================
// Section 16: Top-level recursive layout dispatcher
// ============================================================

// Compute the layout for any registered type.
// This is the single recursive entry point.  It resolves field
// layouts by calling itself recursively, then passes pre-resolved
// data to the non-recursive layout functions defined above.
fn lay_compute(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_layout_empty() }
    if type_id >= ctx.type_count { return lay_layout_empty() }
    // Check cache
    let cidx = lay_cache_lookup(ctx, type_id)
    if cidx != LAY_INVALID {
        return lay_cache_get(ctx, cidx)
    }
    let desc = ctx.types[type_id as usize]
    var result = lay_layout_empty()
    let is_prim = lay_is_primitive(desc.kind)
    if is_prim {
        result = lay_compute_primitive(ctx, desc.kind)
    } else {
        if lay_is_struct(desc.kind) || lay_is_tuple(desc.kind) {
            // Resolve all field sizes and alignments recursively
            var rf = lay_resolved_fields_empty()
            rf.count = desc.field_count
            var fi = 0
            while fi < desc.field_count {
                let ft = desc.field_types[fi as usize]
                let fl = lay_compute(ctx, ft)
                rf.sizes[fi as usize] = fl.size
                rf.aligns[fi as usize] = fl.align
                rf.name_hashes[fi as usize] = desc.field_names[fi as usize]
                rf.type_ids[fi as usize] = ft
                fi = fi + 1
            }
            // Dispatch by repr
            if lay_is_repr_c(desc.repr) {
                result = lay_layout_struct_c_from_resolved(&rf)
            } else {
                if lay_is_repr_packed(desc.repr) {
                    result = lay_layout_struct_packed_from_resolved(&rf)
                } else {
                    result = lay_layout_struct_from_resolved(&rf)
                }
            }
        } else {
            if lay_is_array(desc.kind) {
                // Resolve element layout recursively
                let elem_type = desc.element_type
                var elem_size = 0
                var elem_align = 1
                if elem_type >= 0 && elem_type < ctx.type_count {
                    let el = lay_compute(ctx, elem_type)
                    elem_size = el.size
                    elem_align = el.align
                }
                let elem_stride = lay_stride(elem_size, elem_align)
                let count = desc.element_count
                if count <= 0 {
                    result.size = 0
                    result.align = elem_align
                    result.stride = 0
                } else {
                    result.size = elem_stride * count
                    result.align = elem_align
                    result.stride = lay_stride(result.size, result.align)
                }
                // Record a single "field" representing the element
                var ef = lay_field_empty()
                ef.size = elem_size
                ef.align = elem_align
                ef.type_id = elem_type
                ef.offset = 0
                result.fields[0 as usize] = ef
                result.field_count = 1
            } else {
                if lay_is_enum(desc.kind) {
                    // For enums, resolve each variant's payload.
                    // Variant i uses fields from (i * 64) to ((i+1)*64 - 1).
                    var vsizes: [i64; 128] = [0; 128]
                    var valigns: [i64; 128] = [0; 128]
                    var vi = 0
                    while vi < desc.variant_count && vi < LAY_MAX_VARIANTS {
                        let base = vi * 64
                        // Lay out variant fields to get payload size/align
                        var voffset = 0
                        var vmax_align = 1
                        var vfi = 0
                        var vdone = false
                        while vfi < 64 && vdone == false {
                            let idx = base + vfi
                            if idx >= LAY_MAX_FIELDS {
                                vdone = true
                            } else {
                                let ft = desc.field_types[idx as usize]
                                if ft == 0 && vfi > 0 {
                                    vdone = true
                                } else {
                                    if ft != 0 {
                                        let fl = lay_compute(ctx, ft)
                                        let ao = lay_align_up(voffset, fl.align)
                                        voffset = ao + fl.size
                                        if fl.align > vmax_align {
                                            vmax_align = fl.align
                                        }
                                    }
                                    vfi = vfi + 1
                                }
                            }
                        }
                        vsizes[vi as usize] = voffset
                        valigns[vi as usize] = vmax_align
                        vi = vi + 1
                    }
                    let el = lay_layout_enum_from_resolved(
                        desc.variant_count, &vsizes, &valigns, desc.extra_align
                    )
                    result.size = el.total_size
                    result.align = el.total_align
                    result.stride = lay_stride(el.total_size, el.total_align)
                }
            }
        }
    }
    // Apply extra alignment override
    let desc2 = ctx.types[type_id as usize]
    if desc2.extra_align > result.align {
        result.align = desc2.extra_align
        result.size = lay_align_up(result.size, result.align)
        result.stride = lay_stride(result.size, result.align)
    }
    // Insert into cache
    lay_cache_insert(ctx, type_id, &result)
    return result
}

// ============================================================
// Section 17: Convenience wrappers that use lay_compute
// These functions exist for the public API specified in the module
// spec; they call lay_compute which handles caching and recursion.
// ============================================================

// Compute struct layout with default Sounio rules.
fn lay_compute_struct(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_layout_empty() }
    if type_id >= ctx.type_count { return lay_layout_empty() }
    let desc = ctx.types[type_id as usize]
    var rf = lay_resolved_fields_empty()
    rf.count = desc.field_count
    var i = 0
    while i < desc.field_count {
        let ft = desc.field_types[i as usize]
        let fl = lay_compute(ctx, ft)
        rf.sizes[i as usize] = fl.size
        rf.aligns[i as usize] = fl.align
        rf.name_hashes[i as usize] = desc.field_names[i as usize]
        rf.type_ids[i as usize] = ft
        i = i + 1
    }
    return lay_layout_struct_from_resolved(&rf)
}

// Compute C-compatible struct layout.
fn lay_compute_struct_c(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_layout_empty() }
    if type_id >= ctx.type_count { return lay_layout_empty() }
    let desc = ctx.types[type_id as usize]
    var rf = lay_resolved_fields_empty()
    rf.count = desc.field_count
    var i = 0
    while i < desc.field_count {
        let ft = desc.field_types[i as usize]
        let fl = lay_compute(ctx, ft)
        rf.sizes[i as usize] = fl.size
        rf.aligns[i as usize] = fl.align
        rf.name_hashes[i as usize] = desc.field_names[i as usize]
        rf.type_ids[i as usize] = ft
        i = i + 1
    }
    return lay_layout_struct_c_from_resolved(&rf)
}

// Compute packed struct layout.
fn lay_compute_struct_packed(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_layout_empty() }
    if type_id >= ctx.type_count { return lay_layout_empty() }
    let desc = ctx.types[type_id as usize]
    var rf = lay_resolved_fields_empty()
    rf.count = desc.field_count
    var i = 0
    while i < desc.field_count {
        let ft = desc.field_types[i as usize]
        let fl = lay_compute(ctx, ft)
        rf.sizes[i as usize] = fl.size
        rf.aligns[i as usize] = fl.align
        rf.name_hashes[i as usize] = desc.field_names[i as usize]
        rf.type_ids[i as usize] = ft
        i = i + 1
    }
    return lay_layout_struct_packed_from_resolved(&rf)
}

// Compute optimized struct layout (field reordering).
fn lay_compute_struct_optimized(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_layout_empty() }
    if type_id >= ctx.type_count { return lay_layout_empty() }
    let desc = ctx.types[type_id as usize]
    var rf = lay_resolved_fields_empty()
    rf.count = desc.field_count
    var i = 0
    while i < desc.field_count {
        let ft = desc.field_types[i as usize]
        let fl = lay_compute(ctx, ft)
        rf.sizes[i as usize] = fl.size
        rf.aligns[i as usize] = fl.align
        rf.name_hashes[i as usize] = desc.field_names[i as usize]
        rf.type_ids[i as usize] = ft
        i = i + 1
    }
    return lay_layout_struct_optimized_from_resolved(&! rf)
}

// Compute array layout.
fn lay_compute_array(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    return lay_compute(ctx, type_id)
}

// Compute tuple layout.
fn lay_compute_tuple(ctx: &! LayContext, type_id: i64) -> LayLayout with Mut, Div, Panic {
    return lay_compute(ctx, type_id)
}

// Compute enum layout.
fn lay_compute_enum(ctx: &! LayContext, type_id: i64) -> LayEnumLayout with Mut, Div, Panic {
    if type_id < 0 { return lay_enum_layout_empty() }
    if type_id >= ctx.type_count { return lay_enum_layout_empty() }
    let desc = ctx.types[type_id as usize]
    var vsizes: [i64; 128] = [0; 128]
    var valigns: [i64; 128] = [0; 128]
    var vi = 0
    while vi < desc.variant_count && vi < LAY_MAX_VARIANTS {
        let base = vi * 64
        var voffset = 0
        var vmax_align = 1
        var vfi = 0
        var vdone = false
        while vfi < 64 && vdone == false {
            let idx = base + vfi
            if idx >= LAY_MAX_FIELDS {
                vdone = true
            } else {
                let ft = desc.field_types[idx as usize]
                if ft == 0 && vfi > 0 {
                    vdone = true
                } else {
                    if ft != 0 {
                        let fl = lay_compute(ctx, ft)
                        let ao = lay_align_up(voffset, fl.align)
                        voffset = ao + fl.size
                        if fl.align > vmax_align {
                            vmax_align = fl.align
                        }
                    }
                    vfi = vfi + 1
                }
            }
        }
        vsizes[vi as usize] = voffset
        valigns[vi as usize] = vmax_align
        vi = vi + 1
    }
    return lay_layout_enum_from_resolved(
        desc.variant_count, &vsizes, &valigns, desc.extra_align
    )
}

// ============================================================
// Section 18: Test assertion helper
// ============================================================

fn lay_assert(cond: bool, test_num: i64) -> i64 with IO {
    if cond {
        print("PASS: layout test ")
        print_int(test_num)
        print("\n")
        return 0
    }
    print("FAIL: layout test ")
    print_int(test_num)
    print("\n")
    return 1
}

// ============================================================
// Section 19: Tests — Primitive layouts (tests 1-8)
// ============================================================

// Test 1: i8 layout — size=1, align=1
fn test_lay_01_i8_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let id = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let l = lay_compute(ctx, id)
    l.size == 1 && l.align == 1 && l.stride == 1
}
fn test_lay_01_i8() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_01_i8_inner(&! ctx), 1)
}

