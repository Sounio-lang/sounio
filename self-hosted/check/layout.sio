// Test 16: Struct {i8, i16, i32, i64} — increasing sizes
fn test_lay_16_increasing_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i16 = lay_register_type(ctx, LayTypeKind::TkI16, LayRepr::ReprDefault)
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let t_i64 = lay_register_type(ctx, LayTypeKind::TkI64, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i8
    types[1 as usize] = t_i16
    types[2 as usize] = t_i32
    types[3 as usize] = t_i64
    names[0 as usize] = 1
    names[1 as usize] = 2
    names[2 as usize] = 3
    names[3 as usize] = 4
    lay_set_fields(ctx, s, &types, &names, 4)
    let l = lay_compute(ctx, s)
    // i8@0(1), pad 1, i16@2(2), i32@4(4), i64@8(8) => total=16, align=8
    let ok_size = l.size == 16
    let ok_align = l.align == 8
    let ok_f0 = l.fields[0 as usize].offset == 0
    let ok_f1 = l.fields[1 as usize].offset == 2
    let ok_f2 = l.fields[2 as usize].offset == 4
    let ok_f3 = l.fields[3 as usize].offset == 8
    ok_size && ok_align && ok_f0 && ok_f1 && ok_f2 && ok_f3
}
fn test_lay_16_increasing() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_16_increasing_inner(&! ctx), 16)
}

// Test 17: Struct total padding calculation
