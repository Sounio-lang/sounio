// Test 41: Enum with payload variant
fn test_lay_41_enum_payload_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let e = lay_register_type(ctx, LayTypeKind::TkEnum, LayRepr::ReprDefault)
    // Set variant 0 with one i32 field (stored in field_types[0])
    var desc = ctx.types[e as usize]
    desc.variant_count = 2
    desc.field_types[0 as usize] = t_i32
    ctx.types[e as usize] = desc
    let el = lay_compute_enum(ctx, e)
    // disc(1) + pad to align 4 + payload(4) => total = 8, align = 4
    el.total_size == 8 && el.total_align == 4
}
fn test_lay_41_enum_payload() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_41_enum_payload_inner(&! ctx), 41)
}

