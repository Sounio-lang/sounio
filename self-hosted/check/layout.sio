// Test 34: Optimized {i8, i32, i8, i16} — sorted by descending align
fn test_lay_34_opt_4fields_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i16 = lay_register_type(ctx, LayTypeKind::TkI16, LayRepr::ReprDefault)
