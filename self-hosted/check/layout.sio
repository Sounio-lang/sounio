    inner_types[1 as usize] = t_i32
    inner_names[0 as usize] = 10
    inner_names[1 as usize] = 20
    lay_set_fields(ctx, inner, &inner_types, &inner_names, 2)
    // Outer struct: {i32, inner_struct} — should be size=12, align=4
    let outer = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var outer_types: [i64; 256] = [0; 256]
    var outer_names: [i64; 256] = [0; 256]
    outer_types[0 as usize] = t_i32
    outer_types[1 as usize] = inner
    outer_names[0 as usize] = 30
    outer_names[1 as usize] = 40
    lay_set_fields(ctx, outer, &outer_types, &outer_names, 2)
    let l = lay_compute(ctx, outer)
    // i32 at 0 (4), inner at 4 (size=8, align=4) -> total=12, align=4
    l.size == 12 && l.align == 4 && l.fields[1 as usize].offset == 4
}
fn test_lay_13_nested_struct() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_13_nested_struct_inner(&! ctx), 13)
}

