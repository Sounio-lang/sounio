// Test 48: Nested array — array of structs
fn test_lay_48_array_of_struct_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    // struct {i32, i8} => size=8, align=4 (trailing pad)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i32
    types[1 as usize] = t_i8
    names[0 as usize] = 1
    names[1 as usize] = 2
    lay_set_fields(ctx, s, &types, &names, 2)
    // Array of 3 such structs
    let a = lay_register_type(ctx, LayTypeKind::TkArray, LayRepr::ReprDefault)
    lay_set_array_info(ctx, a, s, 3)
    let l = lay_compute(ctx, a)
    // struct stride = 8, array size = 8 * 3 = 24
    l.size == 24 && l.align == 4
}
fn test_lay_48_array_of_struct() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_48_array_of_struct_inner(&! ctx), 48)
}

