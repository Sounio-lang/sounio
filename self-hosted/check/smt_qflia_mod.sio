// Module: check::smt_qflia
//
// QF_LIA Fourier-Motzkin SMT solver.
// Called from the refinement checker when static analysis (refinement.sio)
// returns UNKNOWN — this tier attempts FM variable elimination before
// the caller falls back to runtime assertions (W040).
//
// Usage pattern:
//   fm_reset()                          // clear the global store
//   fm_parse_pred(var_id, op, constant) // add each predicate
//   fm_parse_binvar(va, ca, vb, cb, k, strict) // two-variable predicates
//   let result = fm_check_sat()         // 1=SAT, 2=UNSAT, 0=UNKNOWN
//
// Result codes:
//   fm_result_unknown() -> 0
//   fm_result_sat()     -> 1
//   fm_result_unsat()   -> 2
//
// Predicate op tags (match refinement.sio):
//   fm_op_gt()=1, fm_op_gt_eq()=2, fm_op_lt()=3
//   fm_op_lt_eq()=4, fm_op_eq()=5, fm_op_neq()=6
//
// Type definitions:
//   FmIneq  — describes a single linear inequality (interface type)
//   FmSystem — describes a conjunction of inequalities (interface type)
//
// Note: FmIneq and FmSystem are defined for interface documentation.
// Internal storage uses flat global arrays to avoid a JIT bug with
// struct values in array-of-struct assignments via chained &! refs.

module check::smt_qflia

use check::smt_qflia::*
