// Module: check::smt_qflia
//
// Exports the QF_LIA Fourier-Motzkin SMT solver.
// Called from the refinement checker when static analysis (refinement.sio)
// returns UNKNOWN — this tier attempts Fourier-Motzkin variable elimination
// before falling back to runtime assertions with W040.
//
// Public API:
//   FmIneq          — a single linear inequality in canonical form
//   FmSystem        — conjunction of FmIneq constraints
//   FmVarList       — list of distinct variable IDs in a system
//   fm_result_unknown / fm_result_sat / fm_result_unsat — result codes
//   fm_system_new   — construct an empty system
//   fm_parse_pred   — parse "var op constant" into FmSystem
//   fm_parse_binvar — parse "coeff_a*var_a + coeff_b*var_b + c op 0" into FmSystem
//   fm_check_sat    — run FM elimination; returns result code
//   fm_eliminate    — eliminate a single variable (one FM step)
//   fm_collect_vars — collect all distinct var IDs from a system

module check::smt_qflia

use check::smt_qflia::*
