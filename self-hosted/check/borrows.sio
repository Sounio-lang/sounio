// ============================================================
// Test 29: Reset clears state
// ============================================================

fn bc_test_29_reset() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p = place_new(0, 1)
    bc = bc_add_borrow(bc, p, BC_SHARED)
    bc = bc_add_move(bc, 1, false)
    bc = bc_report_error(bc, 999)
    bc = bc_advance_point(bc)
    // Reset
    bc = bc_reset(bc)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.borrow_count == 0, 29)
    fails = fails + bc_assert_true(bc.move_count == 0, 29)
    fails = fails + bc_assert_true(bc.error_count == 0, 29)
    fails = fails + bc_assert_true(bc.current_point == 0, 29)
    fails
}

// ============================================================
// Test 30: try_move detects move while borrowed
// ============================================================

fn bc_test_30_try_move_while_borrowed() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p = place_new(0, 1)
    bc = bc_add_borrow(bc, p, BC_EXCLUSIVE)
    bc = bc_try_move(bc, p, 1, false)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.error_count > 0, 30)
    fails = fails + bc_assert_true(bc_has_error_code(bc, ERR_MOVE_WHILE_BORROWED), 30)
    fails
}

// ============================================================
// Test 31: Kill all borrows
// ============================================================

fn bc_test_31_kill_all() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p1 = place_new(0, 1)
    let p2 = place_new(1, 2)
    let p3 = place_new(2, 3)
    bc = bc_add_borrow(bc, p1, BC_SHARED)
    bc = bc_add_borrow(bc, p2, BC_EXCLUSIVE)
    bc = bc_add_borrow(bc, p3, BC_SHARED)
    bc = bc_kill_all_borrows(bc)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc_active_borrow_count(bc) == 0, 31)
    fails = fails + bc_assert_true(bc.borrow_count == 3, 31)  // entries still there, just not active
    fails
}

// ============================================================
// Test 32: Deref place construction
// ============================================================

fn bc_test_32_deref_place() -> i64 with IO, Mut, Div, Panic {
    let dp = bc_deref_place(5)
    var fails: i64 = 0
    fails = fails + bc_assert_true(dp.base_var == 5, 32)
    fails = fails + bc_assert_true(dp.proj_count == 1, 32)
    fails = fails + bc_assert_true(dp.proj_kinds[0] == PROJ_DEREF, 32)
    fails
}

// ============================================================
// Test runner
// ============================================================

fn run_borrow_checker_tests() -> i32 with IO, Mut, Div, Panic {
    var total: i64 = 0
    var failed: i64 = 0

    total = total + 1
    failed = failed + bc_test_01_place_new()

    total = total + 1
    failed = failed + bc_test_02_place_eq()

    total = total + 1
    failed = failed + bc_test_03_place_field()

    total = total + 1
    failed = failed + bc_test_04_place_overlap_same_base()

    total = total + 1
    failed = failed + bc_test_05_place_no_overlap_diff_base()

    total = total + 1
    failed = failed + bc_test_06_place_overlap_parent_child()

    total = total + 1
    failed = failed + bc_test_07_place_sibling_no_overlap()

    total = total + 1
    failed = failed + bc_test_08_checker_new()

    total = total + 1
    failed = failed + bc_test_09_add_borrow()

    total = total + 1
    failed = failed + bc_test_10_multiple_shared()

    total = total + 1
    failed = failed + bc_test_11_double_exclusive()

    total = total + 1
    failed = failed + bc_test_12_shared_then_exclusive()

    total = total + 1
    failed = failed + bc_test_13_exclusive_then_shared()

    total = total + 1
    failed = failed + bc_test_14_kill_resolves_conflict()

    total = total + 1
    failed = failed + bc_test_15_use_after_move()

    total = total + 1
    failed = failed + bc_test_16_move_while_borrowed()

    total = total + 1
    failed = failed + bc_test_17_clean_use()

    total = total + 1
    failed = failed + bc_test_18_reinit_after_move()

    total = total + 1
    failed = failed + bc_test_19_advance_point()

    total = total + 1
    failed = failed + bc_test_20_kill_borrows_after_point()

    total = total + 1
    failed = failed + bc_test_21_field_overlap_conflict()

    total = total + 1
    failed = failed + bc_test_22_disjoint_fields_ok()

    total = total + 1
    failed = failed + bc_test_23_borrow_liveness()

    total = total + 1
    failed = failed + bc_test_24_place_prefix()

    total = total + 1
    failed = failed + bc_test_25_place_names()

    total = total + 1
    failed = failed + bc_test_26_partial_move()

    total = total + 1
    failed = failed + bc_test_27_validate_ids()

    total = total + 1
    failed = failed + bc_test_28_active_count()

    total = total + 1
    failed = failed + bc_test_29_reset()

    total = total + 1
    failed = failed + bc_test_30_try_move_while_borrowed()

    total = total + 1
    failed = failed + bc_test_31_kill_all()

    total = total + 1
    failed = failed + bc_test_32_deref_place()

    print("Borrow checker tests: ")
    print_int(total - failed)
    print("/")
    print_int(total)
    print(" passed\n")

    if failed > 0 {
        return 1
    }
    0
}
