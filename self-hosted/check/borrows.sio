    bc = bc_advance_point(bc)
    // place 5 is moved
    var is_moved = bc_is_place_moved(bc, 5)
    // Reinit it
    bc = bc_reinit_place(bc, 5)
    var is_moved_after = bc_is_place_moved(bc, 5)
    var fails: i64 = 0
    fails = fails + bc_assert_true(is_moved, 18)
    fails = fails + bc_assert_true(!is_moved_after, 18)
    fails
}

