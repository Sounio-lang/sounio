// ============================================================
// Test 14: Kill borrow resolves conflict
// ============================================================

fn bc_test_14_kill_resolves_conflict() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p = place_new(0, 1)
    bc = bc_try_borrow(bc, p, BC_EXCLUSIVE)
    // Kill the first borrow
    bc = bc_kill_borrow(bc, 0)
    // Now a new exclusive borrow should succeed
    bc = bc_reset_errors(bc)
    bc = bc_try_borrow(bc, p, BC_EXCLUSIVE)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.error_count == 0, 14)
    fails = fails + bc_assert_true(bc.borrow_count == 2, 14)
    fails
}

