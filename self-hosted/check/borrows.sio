    bc = pair2.0
    let idx2 = pair2.1
    var fails: i64 = 0
    fails = fails + bc_assert_true(idx1 == 0, 25)
    fails = fails + bc_assert_true(idx2 == 1, 25)
    fails = fails + bc_assert_true(bc_find_place_name(bc, name1) == 0, 25)
    fails = fails + bc_assert_true(bc_find_place_name(bc, name2) == 1, 25)
    fails
}

