    let f2 = place_with_field(place_new(1, 1), 20)
    // Exclusive borrow on field 10
    bc = bc_try_borrow(bc, f1, BC_EXCLUSIVE)
    // Exclusive borrow on field 20 — different field, should be fine
    bc = bc_try_borrow(bc, f2, BC_EXCLUSIVE)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.error_count == 0, 22)
    fails
}

// ============================================================
// Test 23: Borrow liveness at point
// ============================================================

fn bc_test_23_borrow_liveness() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p = place_new(0, 1)
    // Borrow activated at point 0
    bc = bc_add_borrow(bc, p, BC_SHARED)
    bc = bc_advance_point(bc)
    bc = bc_advance_point(bc)
    // Kill at point 2
    bc = bc_kill_borrow(bc, 0)
    var fails: i64 = 0
    // Should be alive at point 0, 1
    fails = fails + bc_assert_true(bc_borrow_alive_at(bc, 0, 0), 23)
    fails = fails + bc_assert_true(bc_borrow_alive_at(bc, 0, 1), 23)
    // Should not be alive at point 2 or later
    fails = fails + bc_assert_true(!bc_borrow_alive_at(bc, 0, 2), 23)
    fails = fails + bc_assert_true(!bc_borrow_alive_at(bc, 0, 5), 23)
    fails
}

// ============================================================
// Test 24: Place is_prefix_of
// ============================================================

fn bc_test_24_place_prefix() -> i64 with IO, Mut, Div, Panic {
    let base = place_new(0, 10)
    let child = place_with_field(place_new(1, 10), 3)
    let grandchild = bc_field_field_place(10, 3, 7)
    var fails: i64 = 0
    fails = fails + bc_assert_true(place_is_prefix_of(base, child), 24)
    fails = fails + bc_assert_true(place_is_prefix_of(child, grandchild), 24)
    fails = fails + bc_assert_true(!place_is_prefix_of(child, base), 24)
    fails = fails + bc_assert_true(!place_is_prefix_of(base, base), 24)  // not strict prefix
    fails
}

