// ============================================================
// Test 20: Kill borrows activated after a point
// ============================================================

fn bc_test_20_kill_borrows_after_point() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let p1 = place_new(0, 1)
    let p2 = place_new(1, 2)
    // Borrow at point 0
    bc = bc_add_borrow(bc, p1, BC_SHARED)
    bc = bc_advance_point(bc)
    // Borrow at point 1
    bc = bc_add_borrow(bc, p2, BC_SHARED)
    bc = bc_advance_point(bc)
    // Kill borrows activated at or after point 1
    bc = bc_kill_borrows_activated_after(bc, 1)
    var fails: i64 = 0
    // First borrow (activated at 0) should still be active
    fails = fails + bc_assert_true(bc.borrows[0].is_active, 20)
    // Second borrow (activated at 1) should be killed
    fails = fails + bc_assert_true(!bc.borrows[1].is_active, 20)
    fails
}

// ============================================================
// Test 21: Field overlap — parent borrow blocks child exclusive
// ============================================================

fn bc_test_21_field_overlap_conflict() -> i64 with IO, Mut, Div, Panic {
    var bc = borrow_checker_new()
    let parent = place_new(0, 1)
    let child = place_with_field(place_new(1, 1), 3)
    // Borrow the parent shared
    bc = bc_try_borrow(bc, parent, BC_SHARED)
    // Try to borrow a child exclusively — should conflict
    bc = bc_try_borrow(bc, child, BC_EXCLUSIVE)
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.error_count > 0, 21)
    fails
}

