}

fn test_gadt_unify_var_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 50)
    let ti = gadt_mk_int(env)
    let ok = gadt_unify(env, v, ti)
    if ok == false { return false }
