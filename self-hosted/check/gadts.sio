    return test_gadt_multiple_defs_inner(&! env)
}

fn test_gadt_def_ctor_start_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let d0 = gadt_add_def(env, 10, 1, pn)
