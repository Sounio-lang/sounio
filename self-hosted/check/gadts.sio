// ---- Pattern Matching Tests (5 tests) ----

fn test_gadt_check_match_arm_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    // Set up: GADT Expr<T> with ctor IntLit : Expr<Int>
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 1000  // formal param T
    let did = gadt_add_def(env, 42, 1, pn)
    let int_ty = gadt_mk_int(env)
    var fields: [i64; 32] = [0; 32]
    fields[0 as usize] = int_ty
    var rp: [i64; 16] = [0; 16]
    rp[0 as usize] = int_ty  // result param: T = Int
    let cid = gadt_add_ctor(env, did, 100, fields, 1, rp, 1)
    // Now check the match arm
    let scru_ty = gadt_mk_int(env)
    let ok = gadt_check_match_arm(env, scru_ty, cid)
    ok
}
fn test_gadt_check_match_arm() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_check_match_arm_inner(&! env)
}

fn test_gadt_check_match_arm_invalid_ctor_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    // No constructors registered; check should fail
    let ok = gadt_check_match_arm(env, ti, 999)
    ok == false
}
fn test_gadt_check_match_arm_invalid_ctor() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_check_match_arm_invalid_ctor_inner(&! env)
}

fn test_gadt_infer_ctor_result_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let did = gadt_add_def(env, 50, 1, pn)
    var fields: [i64; 32] = [0; 32]
    var rp: [i64; 16] = [0; 16]
    let cid = gadt_add_ctor(env, did, 200, fields, 0, rp, 0)
    var ap: [i64; 16] = [0; 16]
    let result = gadt_infer_ctor_result(env, cid, ap, 0)
    // Should return the gadt_id
    result == did
}
fn test_gadt_infer_ctor_result() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_infer_ctor_result_inner(&! env)
}

fn test_gadt_match_arm_pushes_evidence_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 800  // formal param T
    let did = gadt_add_def(env, 70, 1, pn)
    let bool_ty = gadt_mk_bool(env)
    var fields: [i64; 32] = [0; 32]
    var rp: [i64; 16] = [0; 16]
    rp[0 as usize] = bool_ty  // T = Bool
    let cid = gadt_add_ctor(env, did, 300, fields, 0, rp, 1)
    let scru = gadt_mk_int(env)
    let old_ec = env.evidence_count
    let ok = gadt_check_match_arm(env, scru, cid)
    if ok == false { return false }
    // Should have pushed evidence for param 800 -> bool_ty
    env.evidence_count > old_ec
}
fn test_gadt_match_arm_pushes_evidence() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_match_arm_pushes_evidence_inner(&! env)
}

fn test_gadt_match_arm_evidence_correct_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 900  // formal param T
    let did = gadt_add_def(env, 80, 1, pn)
    let float_ty = gadt_mk_float(env)
    var fields: [i64; 32] = [0; 32]
    var rp: [i64; 16] = [0; 16]
    rp[0 as usize] = float_ty  // T = Float
    let cid = gadt_add_ctor(env, did, 400, fields, 0, rp, 1)
    let scru = gadt_mk_int(env)
    let ok = gadt_check_match_arm(env, scru, cid)
    if ok == false { return false }
    let ev = gadt_find_evidence(env, 900)
    ev == float_ty
}
fn test_gadt_match_arm_evidence_correct() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_match_arm_evidence_correct_inner(&! env)
}

