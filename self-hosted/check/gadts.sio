    var rp: [i64; 16] = [0; 16]
    let c0 = gadt_add_ctor(env, did, 600, fields, 0, rp, 0)
    let c1 = gadt_add_ctor(env, did, 601, fields, 0, rp, 0)
    let c2 = gadt_add_ctor(env, did, 602, fields, 0, rp, 0)
    env.defs[did as usize].ctor_count == 3
}
fn test_gadt_ctor_increments_def_count() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_ctor_increments_def_count_inner(&! env)
}

// ---- Type Substitution Tests (5 tests) ----

fn test_gadt_subst_var_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 10)
    let ti = gadt_mk_int(env)
    let result = gadt_subst_type(env, v, 10, ti)
    result == ti
}
fn test_gadt_subst_var() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_subst_var_inner(&! env)
}

fn test_gadt_subst_no_match_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 10)
    let ti = gadt_mk_int(env)
    let result = gadt_subst_type(env, v, 99, ti)
    // Should not substitute — different var_id
    result == v
}
fn test_gadt_subst_no_match() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_subst_no_match_inner(&! env)
}

fn test_gadt_subst_app_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let con = gadt_mk_con(env, 5)
    let v = gadt_mk_var(env, 10)
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = v
    let app = gadt_mk_app(env, con, params, 1)
    let ti = gadt_mk_int(env)
    let result = gadt_subst_type(env, app, 10, ti)
    // Should get a new app with Int in place of the variable
    if result == app { return false }
    let k = gadt_type_kind(env, result)
    k == GADT_TY_APP
}
fn test_gadt_subst_app() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_subst_app_inner(&! env)
}

fn test_gadt_subst_func_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 20)
    let tb = gadt_mk_bool(env)
    let ft = gadt_mk_func(env, v, tb)
    let ti = gadt_mk_int(env)
    let result = gadt_subst_type(env, ft, 20, ti)
    if result == ft { return false }
    let k = gadt_type_kind(env, result)
    k == GADT_TY_FUNC
}
fn test_gadt_subst_func() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_subst_func_inner(&! env)
}

fn test_gadt_apply_subst_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v0 = gadt_mk_var(env, 10)
    let v1 = gadt_mk_var(env, 20)
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let ft = gadt_mk_func(env, v0, v1)
    var sv: [i64; 16] = [0; 16]
    var st: [i64; 16] = [0; 16]
    sv[0 as usize] = 10
    sv[1 as usize] = 20
    st[0 as usize] = ti
    st[1 as usize] = tb
    let result = gadt_apply_subst(env, ft, sv, st, 2)
    // Should produce Int -> Bool
    let k = gadt_type_kind(env, result)
    k == GADT_TY_FUNC
}
fn test_gadt_apply_subst() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_apply_subst_inner(&! env)
}

