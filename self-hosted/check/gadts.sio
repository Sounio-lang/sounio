fn test_gadt_add_constraint_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let cid = gadt_add_constraint(env, ti, tb, 0)
    if cid != 0 { return false }
    if env.constraint_count != 1 { return false }
    env.constraints[0 as usize].lhs_type == ti && env.constraints[0 as usize].rhs_type == tb
}
fn test_gadt_add_constraint() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_add_constraint_inner(&! env)
}

fn test_gadt_activate_constraints_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let c0 = gadt_add_constraint(env, ti, tb, 5)
    let c1 = gadt_add_constraint(env, tb, ti, 5)
    let c2 = gadt_add_constraint(env, ti, ti, 6)
    let activated = gadt_activate_constraints(env, 5)
    if activated != 2 { return false }
    let active_count = gadt_get_active_constraints(env)
    active_count == 2
}
fn test_gadt_activate_constraints() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_activate_constraints_inner(&! env)
}

fn test_gadt_deactivate_constraints_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let c0 = gadt_add_constraint(env, ti, tb, 7)
    let c1 = gadt_add_constraint(env, tb, ti, 7)
    let activated = gadt_activate_constraints(env, 7)
    let deactivated = gadt_deactivate_constraints(env, 7)
    if deactivated != 2 { return false }
    let active_count = gadt_get_active_constraints(env)
    active_count == 0
}
fn test_gadt_deactivate_constraints() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_deactivate_constraints_inner(&! env)
}

