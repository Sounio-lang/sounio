fn test_gadt_check_ctor_types_ok_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let did = gadt_add_def(env, 10, 0, pn)
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    var fields: [i64; 32] = [0; 32]
    fields[0 as usize] = ti
    fields[1 as usize] = tb
    var rp: [i64; 16] = [0; 16]
    let cid = gadt_add_ctor(env, did, 300, fields, 2, rp, 0)
    gadt_check_ctor_types(env, cid)
}
fn test_gadt_check_ctor_types_ok() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_check_ctor_types_ok_inner(&! env)
}

fn test_gadt_is_recursive_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    // Create a GADT that references itself: List<T> = Cons(T, List<T>) | Nil
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 1000
    let did = gadt_add_def(env, 42, 1, pn)
    let ti = gadt_mk_int(env)
    // Create a type that references the GADT itself (con_id = did)
    let self_ref = gadt_mk_con(env, did)
    var params_app: [i64; 16] = [0; 16]
    params_app[0 as usize] = ti
    let list_int = gadt_mk_app(env, self_ref, params_app, 1)

    // Cons ctor with fields [T, List<T>]
    var fields_cons: [i64; 32] = [0; 32]
    fields_cons[0 as usize] = ti
    fields_cons[1 as usize] = list_int
    var rp: [i64; 16] = [0; 16]
    let cons_id = gadt_add_ctor(env, did, 100, fields_cons, 2, rp, 0)

    // Nil ctor with no fields
    var fields_nil: [i64; 32] = [0; 32]
    let nil_id = gadt_add_ctor(env, did, 101, fields_nil, 0, rp, 0)

    gadt_is_recursive(env, did)
}
fn test_gadt_is_recursive() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_is_recursive_inner(&! env)
}

// ---- Scope Tests (5 additional tests for scoping) ----

fn test_gadt_enter_exit_scope_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let d0 = env.scope_depth
    let d1 = gadt_enter_scope(env)
    if d1 != d0 + 1 { return false }
    let d2 = gadt_enter_scope(env)
    if d2 != d0 + 2 { return false }
    let removed = gadt_exit_scope(env, d1)
    env.scope_depth == d1
}
fn test_gadt_enter_exit_scope() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_enter_exit_scope_inner(&! env)
}

fn test_gadt_scope_pops_evidence_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let saved = env.scope_depth
    let d1 = gadt_enter_scope(env)
    let e0 = gadt_push_evidence(env, 100, ti, GADT_INVALID)
    let e1 = gadt_push_evidence(env, 200, tb, GADT_INVALID)
    if env.evidence_count != 2 { return false }
    let removed = gadt_exit_scope(env, saved)
    if removed != 2 { return false }
    env.evidence_count == 0
}
fn test_gadt_scope_pops_evidence() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_scope_pops_evidence_inner(&! env)
}

fn test_gadt_nested_scopes_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let tf = gadt_mk_float(env)
    let saved0 = env.scope_depth
    let d1 = gadt_enter_scope(env)
    let e0 = gadt_push_evidence(env, 100, ti, GADT_INVALID)
    let saved1 = env.scope_depth
    let d2 = gadt_enter_scope(env)
    let e1 = gadt_push_evidence(env, 200, tb, GADT_INVALID)
    let e2 = gadt_push_evidence(env, 300, tf, GADT_INVALID)
    if env.evidence_count != 3 { return false }
    // Exit inner scope — should pop 2 entries (those at depth d2)
    let removed_inner = gadt_exit_scope(env, saved1)
    if removed_inner != 2 { return false }
    if env.evidence_count != 1 { return false }
    // Evidence from outer scope should still be there
    let ev100 = gadt_find_evidence(env, 100)
    if ev100 != ti { return false }
    // Exit outer scope
    let removed_outer = gadt_exit_scope(env, saved0)
    env.evidence_count == 0
}
fn test_gadt_nested_scopes() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_nested_scopes_inner(&! env)
}

fn test_gadt_scope_preserves_outer_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    // Push evidence at depth 0
    let e0 = gadt_push_evidence(env, 500, ti, GADT_INVALID)
    let saved = env.scope_depth
    let d1 = gadt_enter_scope(env)
    let e1 = gadt_push_evidence(env, 600, tb, GADT_INVALID)
    let removed = gadt_exit_scope(env, saved)
    if removed != 1 { return false }
    // Evidence from depth 0 should remain
    let ev500 = gadt_find_evidence(env, 500)
    ev500 == ti
}
fn test_gadt_scope_preserves_outer() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_scope_preserves_outer_inner(&! env)
}

fn test_gadt_pop_evidence_to_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let tf = gadt_mk_float(env)
    let d1 = gadt_enter_scope(env)
    let e0 = gadt_push_evidence(env, 10, ti, GADT_INVALID)
    let d2 = gadt_enter_scope(env)
    let e1 = gadt_push_evidence(env, 20, tb, GADT_INVALID)
    let d3 = gadt_enter_scope(env)
    let e2 = gadt_push_evidence(env, 30, tf, GADT_INVALID)
    // Pop to depth d1 — should remove entries at d2 and d3
    let removed = gadt_pop_evidence_to(env, d1)
    removed == 2
}
fn test_gadt_pop_evidence_to() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_pop_evidence_to_inner(&! env)
}

