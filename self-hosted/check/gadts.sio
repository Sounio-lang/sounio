// Generalized Algebraic Data Types (GADTs) for the self-hosted type checker
//
// Implements GADT type refinement in pattern match arms, evidence-based type
// equality, and GADT constructor checking.
//
// Architecture:
//   GadtType       — type representation with kind tag and params
//   GadtConstraint — type equality constraint (lhs ~ rhs) from constructor
//   GadtEvidence   — type refinement evidence for scope-bounded var refinement
//   GadtCtor       — constructor with fields and result type params
//   GadtDef        — GADT definition with type params and constructors
//   GadtEnv        — flat-array arena holding all GADT state
//
// Algorithm:
//   1. Register GADT definitions and constructors
//   2. When pattern matching on a GADT value, activate constraints from the
//      matched constructor
//   3. Constraints produce evidence: type variable refinements scoped to
//      the match arm
//   4. Evidence is consulted during type checking within the arm body
//   5. On exiting the arm, evidence is popped (scope-based)
//
// Uses flat-array arena pattern (no recursive types) consistent with the
// self-hosted checker's design.

// ============================================================
// Section 1: Constants
// ============================================================

let GADT_MAX_CTORS: i64 = 512
let GADT_MAX_PARAMS: i64 = 16
let GADT_MAX_FIELDS: i64 = 32
let GADT_MAX_CONSTRAINTS: i64 = 256
let GADT_MAX_EVIDENCE: i64 = 512
let GADT_MAX_TYPES: i64 = 128
let GADT_MAX_DEFS: i64 = 64
let GADT_INVALID: i64 = 0 - 1

// ============================================================
// Section 2: Type Representations
// ============================================================

let GADT_TY_VAR: i64 = 0
let GADT_TY_APP: i64 = 1
let GADT_TY_CON: i64 = 2
let GADT_TY_INT: i64 = 3
let GADT_TY_BOOL: i64 = 4
let GADT_TY_FLOAT: i64 = 5
let GADT_TY_STRING: i64 = 6
let GADT_TY_UNIT: i64 = 7
let GADT_TY_FUNC: i64 = 8
let GADT_TY_ARRAY: i64 = 9

pub struct GadtType {
    kind: i64,
    var_id: i64,
    con_id: i64,
    param_count: i64,
    params: [i64; 16],
    return_ty: i64,
}

pub struct GadtConstraint {
    lhs_type: i64,
    rhs_type: i64,
    source_ctor: i64,
    active: bool,
}

pub struct GadtEvidence {
    var_id: i64,
    refined_type: i64,
    from_constraint: i64,
    scope_depth: i64,
}

// ============================================================
// Section 3: GADT Definitions
// ============================================================

pub struct GadtCtor {
    name_id: i64,
    gadt_id: i64,
    field_count: i64,
    field_types: [i64; 32],
    result_params: [i64; 16],
    result_param_count: i64,
    constraint_start: i64,
    constraint_count: i64,
}

pub struct GadtDef {
    name_id: i64,
    param_count: i64,
    param_names: [i64; 16],
    ctor_start: i64,
    ctor_count: i64,
}

pub struct GadtEnv {
    types: [GadtType; 128],
    type_count: i64,
    defs: [GadtDef; 64],
    def_count: i64,
    ctors: [GadtCtor; 512],
    ctor_count: i64,
    constraints: [GadtConstraint; 256],
    constraint_count: i64,
    evidence: [GadtEvidence; 512],
    evidence_count: i64,
    scope_depth: i64,
}

// ============================================================
// Section 4: Constructor Functions
// ============================================================

fn gadt_empty_type() -> GadtType {
    GadtType {
        kind: GADT_TY_UNIT,
        var_id: 0 - 1,
        con_id: 0 - 1,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
}

fn gadt_empty_ctor() -> GadtCtor {
    GadtCtor {
        name_id: 0 - 1,
        gadt_id: 0 - 1,
        field_count: 0,
        field_types: [0; 32],
        result_params: [0; 16],
        result_param_count: 0,
        constraint_start: 0 - 1,
        constraint_count: 0,
    }
}

fn gadt_empty_def() -> GadtDef {
    GadtDef {
        name_id: 0 - 1,
        param_count: 0,
        param_names: [0; 16],
        ctor_start: 0 - 1,
        ctor_count: 0,
    }
}

fn gadt_empty_constraint() -> GadtConstraint {
    GadtConstraint {
        lhs_type: 0 - 1,
        rhs_type: 0 - 1,
        source_ctor: 0 - 1,
        active: false,
    }
}

fn gadt_empty_evidence() -> GadtEvidence {
    GadtEvidence {
        var_id: 0 - 1,
        refined_type: 0 - 1,
        from_constraint: 0 - 1,
        scope_depth: 0,
    }
}

fn gadt_env_new() -> GadtEnv {
    GadtEnv {
        types: [gadt_empty_type(); 128],
        type_count: 0,
        defs: [gadt_empty_def(); 64],
        def_count: 0,
        ctors: [gadt_empty_ctor(); 512],
        ctor_count: 0,
        constraints: [gadt_empty_constraint(); 256],
        constraint_count: 0,
        evidence: [gadt_empty_evidence(); 512],
        evidence_count: 0,
        scope_depth: 0,
    }
}

// ============================================================
// Section 5: Type Construction Helpers
// ============================================================

// Allocate a type-variable node in the type pool.  Returns the index.
fn gadt_mk_var(env: &! GadtEnv, var_id: i64) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_VAR,
        var_id: var_id,
        con_id: 0 - 1,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate a type constructor (no params applied yet).
fn gadt_mk_con(env: &! GadtEnv, con_id: i64) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_CON,
        var_id: 0 - 1,
        con_id: con_id,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate a type application: con applied to params.
fn gadt_mk_app(env: &! GadtEnv, con: i64, params: [i64; 16], param_count: i64) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    var p: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < param_count {
        if i < GADT_MAX_PARAMS {
            p[i as usize] = params[i as usize]
        }
        i = i + 1
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_APP,
        var_id: 0 - 1,
        con_id: con,
        param_count: param_count,
        params: p,
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate the built-in Int type.
fn gadt_mk_int(env: &! GadtEnv) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_INT,
        var_id: 0 - 1,
        con_id: 0 - 1,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate the built-in Bool type.
fn gadt_mk_bool(env: &! GadtEnv) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_BOOL,
        var_id: 0 - 1,
        con_id: 0 - 1,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate the built-in Float type.
fn gadt_mk_float(env: &! GadtEnv) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_FLOAT,
        var_id: 0 - 1,
        con_id: 0 - 1,
        param_count: 0,
        params: [0; 16],
        return_ty: 0 - 1,
    }
    env.type_count = idx + 1
    idx
}

// Allocate a function type: param_ty -> ret_ty.
fn gadt_mk_func(env: &! GadtEnv, param_ty: i64, ret_ty: i64) -> i64 with Mut, Div, Panic {
    let idx = env.type_count
    if idx >= GADT_MAX_TYPES {
        return GADT_INVALID
    }
    var p: [i64; 16] = [0; 16]
    p[0 as usize] = param_ty
    env.types[idx as usize] = GadtType {
        kind: GADT_TY_FUNC,
        var_id: 0 - 1,
        con_id: 0 - 1,
        param_count: 1,
        params: p,
        return_ty: ret_ty,
    }
    env.type_count = idx + 1
    idx
}

// Query the kind of a type at a given index.
fn gadt_type_kind(env: &GadtEnv, ty: i64) -> i64 with Div, Panic {
    if ty < 0 || ty >= env.type_count {
        return GADT_TY_UNIT
    }
    env.types[ty as usize].kind
}

// ============================================================
// Section 6: GADT Definition Management
// ============================================================

// Register a new GADT definition.  Returns the def index.
fn gadt_add_def(env: &! GadtEnv, name_id: i64, param_count: i64, param_names: [i64; 16]) -> i64 with Mut, Div, Panic {
    let idx = env.def_count
    if idx >= GADT_MAX_DEFS {
        return GADT_INVALID
    }
    env.defs[idx as usize] = GadtDef {
        name_id: name_id,
        param_count: param_count,
        param_names: param_names,
        ctor_start: env.ctor_count,
        ctor_count: 0,
    }
    env.def_count = idx + 1
    idx
}

// Register a new constructor for a GADT.  Returns the ctor index.
fn gadt_add_ctor(env: &! GadtEnv, gadt_id: i64, name_id: i64, field_types: [i64; 32], field_count: i64, result_params: [i64; 16], result_param_count: i64) -> i64 with Mut, Div, Panic {
    let idx = env.ctor_count
    if idx >= GADT_MAX_CTORS {
        return GADT_INVALID
    }
    if gadt_id < 0 || gadt_id >= env.def_count {
        return GADT_INVALID
    }
    let cstart = env.constraint_count
    env.ctors[idx as usize] = GadtCtor {
        name_id: name_id,
        gadt_id: gadt_id,
        field_count: field_count,
        field_types: field_types,
        result_params: result_params,
        result_param_count: result_param_count,
        constraint_start: cstart,
        constraint_count: 0,
    }
    env.ctor_count = idx + 1

    // Increment the GADT def's ctor_count
    let old_count = env.defs[gadt_id as usize].ctor_count
    env.defs[gadt_id as usize].ctor_count = old_count + 1

    // Generate type equality constraints from the constructor's result params
    // compared to the GADT's formal params.
    let def_param_count = env.defs[gadt_id as usize].param_count
    var ci: i64 = 0
    var generated: i64 = 0
    while ci < result_param_count {
        if ci < def_param_count {
            // Constraint: formal_param[ci] ~ result_param[ci]
            let formal_var = env.defs[gadt_id as usize].param_names[ci as usize]
            let actual_ty = result_params[ci as usize]
            let cid = gadt_add_constraint_raw(env, formal_var, actual_ty, idx)
            generated = generated + 1
        }
        ci = ci + 1
    }
    env.ctors[idx as usize].constraint_count = generated

    idx
}

// Internal: add a raw constraint without going through the public API.
fn gadt_add_constraint_raw(env: &! GadtEnv, lhs: i64, rhs: i64, ctor: i64) -> i64 with Mut, Div, Panic {
    let idx = env.constraint_count
    if idx >= GADT_MAX_CONSTRAINTS {
        return GADT_INVALID
    }
    env.constraints[idx as usize] = GadtConstraint {
        lhs_type: lhs,
        rhs_type: rhs,
        source_ctor: ctor,
        active: false,
    }
    env.constraint_count = idx + 1
    idx
}

// Find a GADT definition by name_id.  Returns def index or GADT_INVALID.
fn gadt_find_def(env: &GadtEnv, name_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < env.def_count {
        if env.defs[i as usize].name_id == name_id {
            return i
        }
        i = i + 1
    }
    GADT_INVALID
}

// Find a constructor by name_id.  Returns ctor index or GADT_INVALID.
fn gadt_find_ctor(env: &GadtEnv, name_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < env.ctor_count {
        if env.ctors[i as usize].name_id == name_id {
            return i
        }
        i = i + 1
    }
    GADT_INVALID
}

// Given a ctor index, return the GADT def index it belongs to.
fn gadt_ctor_gadt(env: &GadtEnv, ctor_idx: i64) -> i64 with Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return GADT_INVALID
    }
    env.ctors[ctor_idx as usize].gadt_id
}

// ============================================================
// Section 7: Type Substitution
// ============================================================

// Substitute all occurrences of type variable from_var with to_type in ty.
// Returns the resulting type index (may allocate new types).
fn gadt_subst_type(env: &! GadtEnv, ty: i64, from_var: i64, to_type: i64) -> i64 with Mut, Div, Panic {
    if ty < 0 || ty >= env.type_count {
        return ty
    }
    let k = env.types[ty as usize].kind
    // If this is a type variable matching from_var, replace it.
    if k == GADT_TY_VAR {
        if env.types[ty as usize].var_id == from_var {
            return to_type
        }
        return ty
    }
    // If it is a type application, substitute in all children.
    if k == GADT_TY_APP {
        let con = env.types[ty as usize].con_id
        let pc = env.types[ty as usize].param_count
        var new_params: [i64; 16] = [0; 16]
        var changed = false
        var i: i64 = 0
        while i < pc {
            let old_p = env.types[ty as usize].params[i as usize]
            let new_p = gadt_subst_type(env, old_p, from_var, to_type)
            new_params[i as usize] = new_p
            if new_p != old_p {
                changed = true
            }
            i = i + 1
        }
        if changed {
            return gadt_mk_app(env, con, new_params, pc)
        }
        return ty
    }
    // If it is a function type, substitute in domain and codomain.
    if k == GADT_TY_FUNC {
        let dom = env.types[ty as usize].params[0 as usize]
        let cod = env.types[ty as usize].return_ty
        let new_dom = gadt_subst_type(env, dom, from_var, to_type)
        let new_cod = gadt_subst_type(env, cod, from_var, to_type)
        if new_dom != dom || new_cod != cod {
            return gadt_mk_func(env, new_dom, new_cod)
        }
        return ty
    }
    // Primitive types do not contain type variables.
    ty
}

// Apply a parallel substitution: subst_vars[i] -> subst_types[i].
fn gadt_apply_subst(env: &! GadtEnv, ty: i64, subst_vars: [i64; 16], subst_types: [i64; 16], subst_count: i64) -> i64 with Mut, Div, Panic {
    var result = ty
    var i: i64 = 0
    while i < subst_count {
        result = gadt_subst_type(env, result, subst_vars[i as usize], subst_types[i as usize])
        i = i + 1
    }
    result
}

// Substitute all formal GADT params in a constructor's field types
// with actual_params.  Returns the ctor index unchanged (fields are
// resolved via gadt_apply_subst on each field type when needed).
// This convenience function returns the substituted result type index.
fn gadt_subst_all_params(env: &! GadtEnv, ctor_idx: i64, actual_params: [i64; 16], param_count: i64) -> i64 with Mut, Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return GADT_INVALID
    }
    let gadt_id = env.ctors[ctor_idx as usize].gadt_id
    if gadt_id < 0 || gadt_id >= env.def_count {
        return GADT_INVALID
    }
    let def_pc = env.defs[gadt_id as usize].param_count
    // Build substitution: param_names[i] -> actual_params[i]
    var subst_vars: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < def_pc {
        if i < param_count {
            subst_vars[i as usize] = env.defs[gadt_id as usize].param_names[i as usize]
        }
        i = i + 1
    }
    // Build result type: apply the GADT con to actual params
    let con = gadt_mk_con(env, gadt_id)
    let result = gadt_mk_app(env, con, actual_params, param_count)
    result
}

// ============================================================
// Section 8: Type Unification
// ============================================================

// Structural equality of two types (without variable instantiation).
fn gadt_types_equal(env: &GadtEnv, a: i64, b: i64) -> bool with Mut, Div, Panic {
    if a == b {
        return true
    }
    if a < 0 || a >= env.type_count || b < 0 || b >= env.type_count {
        return false
    }
    let ka = env.types[a as usize].kind
    let kb = env.types[b as usize].kind
    if ka != kb {
        return false
    }
    // Type variables are equal iff they have the same var_id
    if ka == GADT_TY_VAR {
        return env.types[a as usize].var_id == env.types[b as usize].var_id
    }
    // Type constructors are equal iff they have the same con_id
    if ka == GADT_TY_CON {
        return env.types[a as usize].con_id == env.types[b as usize].con_id
    }
    // Type applications: constructor must be equal and all params
    if ka == GADT_TY_APP {
        if env.types[a as usize].con_id != env.types[b as usize].con_id {
            return false
        }
        let pc = env.types[a as usize].param_count
        if pc != env.types[b as usize].param_count {
            return false
        }
        var i: i64 = 0
        while i < pc {
            if gadt_types_equal(env, env.types[a as usize].params[i as usize], env.types[b as usize].params[i as usize]) == false {
                return false
            }
            i = i + 1
        }
        return true
    }
    // Function types: domain and codomain must match
    if ka == GADT_TY_FUNC {
        let dom_eq = gadt_types_equal(env, env.types[a as usize].params[0 as usize], env.types[b as usize].params[0 as usize])
        let cod_eq = gadt_types_equal(env, env.types[a as usize].return_ty, env.types[b as usize].return_ty)
        return dom_eq && cod_eq
    }
    // Primitive types of the same kind are always equal (Int == Int, etc.)
    true
}

// Occurs check: does var_id appear anywhere inside ty?
fn gadt_occurs_check(env: &GadtEnv, var_id: i64, ty: i64) -> bool with Mut, Div, Panic {
    if ty < 0 || ty >= env.type_count {
        return false
    }
    let k = env.types[ty as usize].kind
    if k == GADT_TY_VAR {
        return env.types[ty as usize].var_id == var_id
    }
    if k == GADT_TY_APP {
        var i: i64 = 0
        let pc = env.types[ty as usize].param_count
        while i < pc {
            if gadt_occurs_check(env, var_id, env.types[ty as usize].params[i as usize]) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if k == GADT_TY_FUNC {
        if gadt_occurs_check(env, var_id, env.types[ty as usize].params[0 as usize]) {
            return true
        }
        return gadt_occurs_check(env, var_id, env.types[ty as usize].return_ty)
    }
    false
}

// Attempt to unify two types.  Returns true if unifiable.
// For variables, records evidence (substitution) as a side effect.
fn gadt_unify(env: &! GadtEnv, a: i64, b: i64) -> bool with Mut, Div, Panic {
    if a == b {
        return true
    }
    if a < 0 || a >= env.type_count || b < 0 || b >= env.type_count {
        return false
    }
    let ka = env.types[a as usize].kind
    let kb = env.types[b as usize].kind
    // Variable on the left: bind it to the right (with occurs check)
    if ka == GADT_TY_VAR {
        let vid = env.types[a as usize].var_id
        if gadt_occurs_check(env, vid, b) {
            return false
        }
        let eidx = gadt_push_evidence(env, vid, b, GADT_INVALID)
        return true
    }
    // Variable on the right: bind it to the left
    if kb == GADT_TY_VAR {
        let vid = env.types[b as usize].var_id
        if gadt_occurs_check(env, vid, a) {
            return false
        }
        let eidx = gadt_push_evidence(env, vid, a, GADT_INVALID)
        return true
    }
    // Kind mismatch => not unifiable
    if ka != kb {
        return false
    }
    // Type constructors: must have the same con_id
    if ka == GADT_TY_CON {
        return env.types[a as usize].con_id == env.types[b as usize].con_id
    }
    // Type applications: unify constructor and all params
    if ka == GADT_TY_APP {
        if env.types[a as usize].con_id != env.types[b as usize].con_id {
            return false
        }
        let pc = env.types[a as usize].param_count
        if pc != env.types[b as usize].param_count {
            return false
        }
        return gadt_unify_params(env, env.types[a as usize].params, env.types[b as usize].params, pc)
    }
    // Function types
    if ka == GADT_TY_FUNC {
        let dom_ok = gadt_unify(env, env.types[a as usize].params[0 as usize], env.types[b as usize].params[0 as usize])
        if dom_ok == false {
            return false
        }
        return gadt_unify(env, env.types[a as usize].return_ty, env.types[b as usize].return_ty)
    }
    // Primitives of the same kind are unifiable
    true
}

// Unify arrays of type parameters element-wise.
fn gadt_unify_params(env: &! GadtEnv, params_a: [i64; 16], params_b: [i64; 16], count: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < count {
        if gadt_unify(env, params_a[i as usize], params_b[i as usize]) == false {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// Section 9: Constraint Management
// ============================================================

// Add a type equality constraint.  Returns constraint index.
fn gadt_add_constraint(env: &! GadtEnv, lhs: i64, rhs: i64, ctor: i64) -> i64 with Mut, Div, Panic {
    gadt_add_constraint_raw(env, lhs, rhs, ctor)
}

// Activate all constraints sourced from a given constructor.
// Returns the number of constraints activated.
fn gadt_activate_constraints(env: &! GadtEnv, ctor_idx: i64) -> i64 with Mut, Div, Panic {
    var activated: i64 = 0
    var i: i64 = 0
    while i < env.constraint_count {
        if env.constraints[i as usize].source_ctor == ctor_idx {
            if env.constraints[i as usize].active == false {
                env.constraints[i as usize].active = true
                activated = activated + 1
            }
        }
        i = i + 1
    }
    activated
}

// Deactivate all constraints sourced from a given constructor.
// Returns the number of constraints deactivated.
fn gadt_deactivate_constraints(env: &! GadtEnv, ctor_idx: i64) -> i64 with Mut, Div, Panic {
    var deactivated: i64 = 0
    var i: i64 = 0
    while i < env.constraint_count {
        if env.constraints[i as usize].source_ctor == ctor_idx {
            if env.constraints[i as usize].active {
                env.constraints[i as usize].active = false
                deactivated = deactivated + 1
            }
        }
        i = i + 1
    }
    deactivated
}

// Count active constraints.
fn gadt_get_active_constraints(env: &GadtEnv) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < env.constraint_count {
        if env.constraints[i as usize].active {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// Section 10: Evidence and Refinement
// ============================================================

// Push a type refinement evidence entry.  Returns the evidence index.
fn gadt_push_evidence(env: &! GadtEnv, var_id: i64, refined_type: i64, from_constraint: i64) -> i64 with Mut, Div, Panic {
    let idx = env.evidence_count
    if idx >= GADT_MAX_EVIDENCE {
        return GADT_INVALID
    }
    env.evidence[idx as usize] = GadtEvidence {
        var_id: var_id,
        refined_type: refined_type,
        from_constraint: from_constraint,
        scope_depth: env.scope_depth,
    }
    env.evidence_count = idx + 1
    idx
}

// Pop all evidence entries above the given depth.
// Returns the number of entries removed.
fn gadt_pop_evidence_to(env: &! GadtEnv, depth: i64) -> i64 with Mut, Div, Panic {
    var removed: i64 = 0
    while env.evidence_count > 0 {
        let top = env.evidence_count - 1
        if env.evidence[top as usize].scope_depth > depth {
            env.evidence_count = top
            removed = removed + 1
        } else {
            return removed
        }
    }
    removed
}

// Find the most recent evidence for a type variable.
// Returns the refined_type or GADT_INVALID if none found.
fn gadt_find_evidence(env: &GadtEnv, var_id: i64) -> i64 with Mut, Div, Panic {
    // Search from most recent to oldest for last-write-wins semantics.
    var i = env.evidence_count - 1
    while i >= 0 {
        if env.evidence[i as usize].var_id == var_id {
            return env.evidence[i as usize].refined_type
        }
        i = i - 1
    }
    GADT_INVALID
}

// Apply all active evidence to refine a type.
// If the type is a variable and we have evidence for it, return the refined type.
// Recursively applies evidence for compound types.
fn gadt_refine_type(env: &GadtEnv, ty: i64) -> i64 with Mut, Div, Panic {
    if ty < 0 || ty >= env.type_count {
        return ty
    }
    let k = env.types[ty as usize].kind
    if k == GADT_TY_VAR {
        let vid = env.types[ty as usize].var_id
        let refined = gadt_find_evidence(env, vid)
        if refined != GADT_INVALID {
            return refined
        }
        return ty
    }
    // For compound types, we would need to recursively refine.
    // Refinement of application / function types requires mutation for
    // new type allocation, so this read-only version handles only variables.
    ty
}

// Enter a new evidence scope.  Returns the new depth.
fn gadt_enter_scope(env: &! GadtEnv) -> i64 with Mut {
    env.scope_depth = env.scope_depth + 1
    env.scope_depth
}

// Exit to a previous scope depth.  Pops evidence and returns the count removed.
fn gadt_exit_scope(env: &! GadtEnv, saved_depth: i64) -> i64 with Mut, Div, Panic {
    let removed = gadt_pop_evidence_to(env, saved_depth)
    env.scope_depth = saved_depth
    removed
}

// ============================================================
// Section 11: Pattern Match Integration
// ============================================================

// Check a match arm against a GADT scrutinee type and constructor.
// Activates constraints from the matched constructor, pushes evidence
// from unifying formal params with the scrutinee's actual params.
// Returns true if the arm is well-typed.
fn gadt_check_match_arm(env: &! GadtEnv, scrutinee_ty: i64, ctor_idx: i64) -> bool with Mut, Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return false
    }
    let gadt_id = env.ctors[ctor_idx as usize].gadt_id
    if gadt_id < 0 || gadt_id >= env.def_count {
        return false
    }

    // Activate this constructor's constraints
    let activated = gadt_activate_constraints(env, ctor_idx)

    // Generate evidence from the constructor's result_params.
    // Each result_param refines the corresponding GADT formal param.
    let rpc = env.ctors[ctor_idx as usize].result_param_count
    let dpc = env.defs[gadt_id as usize].param_count
    var i: i64 = 0
    while i < rpc {
        if i < dpc {
            let formal = env.defs[gadt_id as usize].param_names[i as usize]
            let actual = env.ctors[ctor_idx as usize].result_params[i as usize]
            let eidx = gadt_push_evidence(env, formal, actual, i)
        }
        i = i + 1
    }

    true
}

// Infer the result type of a constructor applied to actual type params.
// Returns the inferred type index.
fn gadt_infer_ctor_result(env: &GadtEnv, ctor_idx: i64, actual_params: [i64; 16], param_count: i64) -> i64 with Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return GADT_INVALID
    }
    let gadt_id = env.ctors[ctor_idx as usize].gadt_id
    if gadt_id < 0 || gadt_id >= env.def_count {
        return GADT_INVALID
    }
    // The result type is the GADT applied to the constructor's result_params.
    // But we need to substitute the formal params with actual_params.
    // For now, return the gadt_id to indicate which GADT this belongs to.
    gadt_id
}

// Check exhaustiveness: given a GADT and the set of covered constructors,
// return true if all constructors are covered.
fn gadt_check_exhaustiveness(env: &GadtEnv, gadt_id: i64, covered_ctors: [i64; 512], covered_count: i64) -> bool with Mut, Div, Panic {
    if gadt_id < 0 || gadt_id >= env.def_count {
        return false
    }
    let total_ctors = env.defs[gadt_id as usize].ctor_count
    let missing = gadt_missing_ctors_count(env, gadt_id, covered_ctors, covered_count)
    missing == 0
}

// Count missing constructors (those not in covered_ctors).
fn gadt_missing_ctors(env: &GadtEnv, gadt_id: i64, covered_ctors: [i64; 512], covered_count: i64) -> i64 with Mut, Div, Panic {
    gadt_missing_ctors_count(env, gadt_id, covered_ctors, covered_count)
}

// Internal helper for missing ctor counting.
fn gadt_missing_ctors_count(env: &GadtEnv, gadt_id: i64, covered_ctors: [i64; 512], covered_count: i64) -> i64 with Mut, Div, Panic {
    if gadt_id < 0 || gadt_id >= env.def_count {
        return 0
    }
    let ctor_start = env.defs[gadt_id as usize].ctor_start
    let ctor_count = env.defs[gadt_id as usize].ctor_count
    var missing: i64 = 0
    var ci: i64 = 0
    while ci < ctor_count {
        let ctor_idx = ctor_start + ci
        var found = false
        var j: i64 = 0
        while j < covered_count {
            if covered_ctors[j as usize] == ctor_idx {
                found = true
            }
            j = j + 1
        }
        if found == false {
            missing = missing + 1
        }
        ci = ci + 1
    }
    missing
}

// ============================================================
// Section 12: Validation
// ============================================================

// Validate a GADT definition: check that name_id is set, param_count
// is within bounds, and all constructors reference valid types.
fn gadt_validate_def(env: &GadtEnv, def_idx: i64) -> bool with Mut, Div, Panic {
    if def_idx < 0 || def_idx >= env.def_count {
        return false
    }
    let def = env.defs[def_idx as usize]
    if def.name_id < 0 {
        return false
    }
    if def.param_count < 0 || def.param_count > GADT_MAX_PARAMS {
        return false
    }
    // Check all constructors belonging to this GADT
    var i: i64 = 0
    while i < def.ctor_count {
        let ctor_idx = def.ctor_start + i
        if gadt_validate_ctor(env, ctor_idx) == false {
            return false
        }
        i = i + 1
    }
    true
}

// Validate a constructor: check field counts, gadt_id references.
fn gadt_validate_ctor(env: &GadtEnv, ctor_idx: i64) -> bool with Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return false
    }
    let ctor = env.ctors[ctor_idx as usize]
    if ctor.name_id < 0 {
        return false
    }
    if ctor.gadt_id < 0 || ctor.gadt_id >= env.def_count {
        return false
    }
    if ctor.field_count < 0 || ctor.field_count > GADT_MAX_FIELDS {
        return false
    }
    if ctor.result_param_count < 0 || ctor.result_param_count > GADT_MAX_PARAMS {
        return false
    }
    true
}

// Check that all field types in a constructor reference valid type indices.
fn gadt_check_ctor_types(env: &GadtEnv, ctor_idx: i64) -> bool with Mut, Div, Panic {
    if ctor_idx < 0 || ctor_idx >= env.ctor_count {
        return false
    }
    let ctor = env.ctors[ctor_idx as usize]
    var i: i64 = 0
    while i < ctor.field_count {
        let ft = ctor.field_types[i as usize]
        if ft < 0 || ft >= env.type_count {
            return false
        }
        i = i + 1
    }
    true
}

// Check if a GADT definition is recursive: does any constructor's field types
// reference the GADT itself (directly or through a type application)?
fn gadt_is_recursive(env: &GadtEnv, def_idx: i64) -> bool with Mut, Div, Panic {
    if def_idx < 0 || def_idx >= env.def_count {
        return false
    }
    let def = env.defs[def_idx as usize]
    var ci: i64 = 0
    while ci < def.ctor_count {
        let ctor_idx = def.ctor_start + ci
        if ctor_idx >= 0 && ctor_idx < env.ctor_count {
            let ctor = env.ctors[ctor_idx as usize]
            var fi: i64 = 0
            while fi < ctor.field_count {
                let ft = ctor.field_types[fi as usize]
                if gadt_type_mentions_def(env, ft, def_idx) {
                    return true
                }
                fi = fi + 1
            }
        }
        ci = ci + 1
    }
    false
}

// Helper: check if a type references a GADT def (by con_id match).
fn gadt_type_mentions_def(env: &GadtEnv, ty: i64, def_idx: i64) -> bool with Mut, Div, Panic {
    if ty < 0 || ty >= env.type_count {
        return false
    }
    let k = env.types[ty as usize].kind
    if k == GADT_TY_CON {
        return env.types[ty as usize].con_id == def_idx
    }
    if k == GADT_TY_APP {
        // Check the constructor
        let con = env.types[ty as usize].con_id
        if con >= 0 && con < env.type_count {
            if gadt_type_mentions_def(env, con, def_idx) {
                return true
            }
        }
        // Also check the applied con_id directly (often it is the def index)
        if env.types[ty as usize].con_id == def_idx {
            return true
        }
        // Check params
        let pc = env.types[ty as usize].param_count
        var i: i64 = 0
        while i < pc {
            if gadt_type_mentions_def(env, env.types[ty as usize].params[i as usize], def_idx) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if k == GADT_TY_FUNC {
        if gadt_type_mentions_def(env, env.types[ty as usize].params[0 as usize], def_idx) {
            return true
        }
        return gadt_type_mentions_def(env, env.types[ty as usize].return_ty, def_idx)
    }
    false
}

// ============================================================
// Section 13: Tests
// ============================================================
// All tests use the _inner pattern: the inner function takes &! GadtEnv,
// the outer function creates var env = gadt_env_new() and passes &! env.

// ---- Type Construction Tests (5 tests) ----

fn test_gadt_mk_var_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v0 = gadt_mk_var(env, 100)
    let v1 = gadt_mk_var(env, 200)
    if v0 != 0 { return false }
    if v1 != 1 { return false }
    if env.type_count != 2 { return false }
    let k0 = gadt_type_kind(env, v0)
    let k1 = gadt_type_kind(env, v1)
    k0 == GADT_TY_VAR && k1 == GADT_TY_VAR
}
fn test_gadt_mk_var() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_mk_var_inner(&! env)
}

fn test_gadt_mk_con_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let c0 = gadt_mk_con(env, 10)
    let c1 = gadt_mk_con(env, 20)
    if c0 != 0 { return false }
    if c1 != 1 { return false }
    let k = gadt_type_kind(env, c0)
    k == GADT_TY_CON && env.types[c0 as usize].con_id == 10
}
fn test_gadt_mk_con() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_mk_con_inner(&! env)
}

fn test_gadt_mk_app_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let con = gadt_mk_con(env, 5)
    let p0 = gadt_mk_int(env)
    let p1 = gadt_mk_bool(env)
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = p0
    params[1 as usize] = p1
    let app = gadt_mk_app(env, con, params, 2)
    let k = gadt_type_kind(env, app)
    if k != GADT_TY_APP { return false }
    env.types[app as usize].param_count == 2
}
fn test_gadt_mk_app() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_mk_app_inner(&! env)
}

fn test_gadt_mk_primitives_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let tf = gadt_mk_float(env)
    let ki = gadt_type_kind(env, ti)
    let kb = gadt_type_kind(env, tb)
    let kf = gadt_type_kind(env, tf)
    ki == GADT_TY_INT && kb == GADT_TY_BOOL && kf == GADT_TY_FLOAT
}
fn test_gadt_mk_primitives() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_mk_primitives_inner(&! env)
}

fn test_gadt_mk_func_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let ft = gadt_mk_func(env, ti, tb)
    let k = gadt_type_kind(env, ft)
    if k != GADT_TY_FUNC { return false }
    if env.types[ft as usize].params[0 as usize] != ti { return false }
    env.types[ft as usize].return_ty == tb
}
fn test_gadt_mk_func() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_mk_func_inner(&! env)
}

// ---- GADT Definition Tests (5 tests) ----

fn test_gadt_add_def_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pnames: [i64; 16] = [0; 16]
    pnames[0 as usize] = 1000
    pnames[1 as usize] = 1001
    let def_id = gadt_add_def(env, 42, 2, pnames)
    if def_id != 0 { return false }
    if env.def_count != 1 { return false }
    if env.defs[0 as usize].name_id != 42 { return false }
    env.defs[0 as usize].param_count == 2
}
fn test_gadt_add_def() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_add_def_inner(&! env)
}

fn test_gadt_find_def_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let d0 = gadt_add_def(env, 100, 1, pn)
    let d1 = gadt_add_def(env, 200, 1, pn)
    let d2 = gadt_add_def(env, 300, 1, pn)
    let f0 = gadt_find_def(env, 100)
    let f1 = gadt_find_def(env, 200)
    let f2 = gadt_find_def(env, 300)
    let fmiss = gadt_find_def(env, 999)
    f0 == 0 && f1 == 1 && f2 == 2 && fmiss == GADT_INVALID
}
fn test_gadt_find_def() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_find_def_inner(&! env)
}

fn test_gadt_def_param_names_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 500
    pn[1 as usize] = 501
    pn[2 as usize] = 502
    let did = gadt_add_def(env, 77, 3, pn)
    if env.defs[did as usize].param_names[0 as usize] != 500 { return false }
    if env.defs[did as usize].param_names[1 as usize] != 501 { return false }
    env.defs[did as usize].param_names[2 as usize] == 502
}
fn test_gadt_def_param_names() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_def_param_names_inner(&! env)
}

fn test_gadt_multiple_defs_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let d0 = gadt_add_def(env, 10, 1, pn)
    let d1 = gadt_add_def(env, 20, 2, pn)
    let d2 = gadt_add_def(env, 30, 0, pn)
    if env.def_count != 3 { return false }
    if env.defs[0 as usize].param_count != 1 { return false }
    if env.defs[1 as usize].param_count != 2 { return false }
