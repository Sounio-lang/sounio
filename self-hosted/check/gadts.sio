// ---- Advanced Unification Tests (5 additional) ----

fn test_gadt_unify_primitives_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let i1 = gadt_mk_int(env)
    let i2 = gadt_mk_int(env)
    let b1 = gadt_mk_bool(env)
    if gadt_unify(env, i1, i2) == false { return false }
    gadt_unify(env, i1, b1) == false
}
fn test_gadt_unify_primitives() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_primitives_inner(&! env)
}

fn test_gadt_unify_var_right_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let v = gadt_mk_var(env, 88)
    let ok = gadt_unify(env, ti, v)
    if ok == false { return false }
    let refined = gadt_find_evidence(env, 88)
    refined == ti
}
fn test_gadt_unify_var_right() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_var_right_inner(&! env)
}

fn test_gadt_unify_occurs_fail_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 99)
    let con = gadt_mk_con(env, 1)
    var p: [i64; 16] = [0; 16]
    p[0 as usize] = v
    let app = gadt_mk_app(env, con, p, 1)
    // Should fail: v occurs in app
    gadt_unify(env, v, app) == false
}
fn test_gadt_unify_occurs_fail() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_occurs_fail_inner(&! env)
}

fn test_gadt_unify_func_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let f1 = gadt_mk_func(env, ti, tb)
    let f2 = gadt_mk_func(env, ti, tb)
    let f3 = gadt_mk_func(env, tb, ti)
    if gadt_unify(env, f1, f2) == false { return false }
    // f1 and f3 have different domain/codomain
    gadt_unify(env, f1, f3) == false
}
fn test_gadt_unify_func() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_func_inner(&! env)
}

fn test_gadt_unify_params_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    var pa: [i64; 16] = [0; 16]
    var pb: [i64; 16] = [0; 16]
    pa[0 as usize] = ti
    pa[1 as usize] = tb
    pb[0 as usize] = ti
    pb[1 as usize] = tb
    let ok = gadt_unify_params(env, pa, pb, 2)
    if ok == false { return false }
    // Mismatch case
    var pc: [i64; 16] = [0; 16]
    pc[0 as usize] = tb
    pc[1 as usize] = ti
    gadt_unify_params(env, pa, pc, 2) == false
}
fn test_gadt_unify_params() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_params_inner(&! env)
}

// ---- Integration Tests (5 additional) ----

// Full GADT Expr<T> scenario: IntLit : Expr<Int>, BoolLit : Expr<Bool>
fn test_gadt_expr_scenario_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    // Define Expr<T>
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 7000  // T
    let expr_id = gadt_add_def(env, 999, 1, pn)

    let int_ty = gadt_mk_int(env)
    let bool_ty = gadt_mk_bool(env)

    // IntLit : Expr<Int>
    var fields_il: [i64; 32] = [0; 32]
    fields_il[0 as usize] = int_ty
    var rp_il: [i64; 16] = [0; 16]
    rp_il[0 as usize] = int_ty
    let intlit_id = gadt_add_ctor(env, expr_id, 5000, fields_il, 1, rp_il, 1)

    // BoolLit : Expr<Bool>
    var fields_bl: [i64; 32] = [0; 32]
    fields_bl[0 as usize] = bool_ty
    var rp_bl: [i64; 16] = [0; 16]
    rp_bl[0 as usize] = bool_ty
    let boollit_id = gadt_add_ctor(env, expr_id, 5001, fields_bl, 1, rp_bl, 1)

    // Validate definition
    if gadt_validate_def(env, expr_id) == false { return false }

    // Check exhaustiveness with both ctors
    var covered: [i64; 512] = [0; 512]
    covered[0 as usize] = intlit_id
    covered[1 as usize] = boollit_id
    if gadt_check_exhaustiveness(env, expr_id, covered, 2) == false { return false }

    // Match on IntLit arm: should refine T to Int
    let saved = env.scope_depth
    let d1 = gadt_enter_scope(env)
    let arm_ok = gadt_check_match_arm(env, int_ty, intlit_id)
    if arm_ok == false { return false }
    let ev = gadt_find_evidence(env, 7000)
    if ev != int_ty { return false }
    let removed = gadt_exit_scope(env, saved)

    // After exiting, evidence should be gone
    let ev_after = gadt_find_evidence(env, 7000)
    ev_after == GADT_INVALID
}
fn test_gadt_expr_scenario() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_expr_scenario_inner(&! env)
}

// Non-recursive GADT should report not recursive
fn test_gadt_not_recursive_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let did = gadt_add_def(env, 1, 0, pn)
    let ti = gadt_mk_int(env)
    var fields: [i64; 32] = [0; 32]
    fields[0 as usize] = ti
    var rp: [i64; 16] = [0; 16]
    let cid = gadt_add_ctor(env, did, 10, fields, 1, rp, 0)
    gadt_is_recursive(env, did) == false
}
fn test_gadt_not_recursive() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_not_recursive_inner(&! env)
}

// Type pool capacity: fill up and check GADT_INVALID is returned
fn test_gadt_type_pool_overflow_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < GADT_MAX_TYPES {
        let t = gadt_mk_int(env)
        i = i + 1
    }
    // Next allocation should return GADT_INVALID
    let overflow = gadt_mk_int(env)
    overflow == GADT_INVALID
}
fn test_gadt_type_pool_overflow() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_type_pool_overflow_inner(&! env)
}

// Substitution on primitives is a no-op
fn test_gadt_subst_primitive_noop_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let result = gadt_subst_type(env, ti, 999, tb)
    result == ti
}
fn test_gadt_subst_primitive_noop() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_subst_primitive_noop_inner(&! env)
}

// Multi-param GADT: Pair<A, B> with MkPair(A, B) : Pair<A, B>
fn test_gadt_multi_param_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    pn[0 as usize] = 8000  // A
    pn[1 as usize] = 8001  // B
    let pair_id = gadt_add_def(env, 555, 2, pn)

    let int_ty = gadt_mk_int(env)
    let bool_ty = gadt_mk_bool(env)

    var fields: [i64; 32] = [0; 32]
    fields[0 as usize] = int_ty
    fields[1 as usize] = bool_ty
    var rp: [i64; 16] = [0; 16]
    rp[0 as usize] = int_ty
    rp[1 as usize] = bool_ty
    let mkpair_id = gadt_add_ctor(env, pair_id, 6000, fields, 2, rp, 2)

    if gadt_validate_def(env, pair_id) == false { return false }
    if env.defs[pair_id as usize].param_count != 2 { return false }

    // Check match arm
    let saved = env.scope_depth
    let d1 = gadt_enter_scope(env)
    let arm_ok = gadt_check_match_arm(env, int_ty, mkpair_id)
    if arm_ok == false { return false }
    let ev_a = gadt_find_evidence(env, 8000)
    let ev_b = gadt_find_evidence(env, 8001)
    if ev_a != int_ty { return false }
    if ev_b != bool_ty { return false }
    let removed = gadt_exit_scope(env, saved)
    true
}
fn test_gadt_multi_param() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_multi_param_inner(&! env)
}

// ============================================================
// Test Runner
// ============================================================

fn gadt_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0

    // Type construction (5)
    if test_gadt_mk_var() { passed = passed + 1 }
    if test_gadt_mk_con() { passed = passed + 1 }
    if test_gadt_mk_app() { passed = passed + 1 }
    if test_gadt_mk_primitives() { passed = passed + 1 }
    if test_gadt_mk_func() { passed = passed + 1 }

    // GADT definition (5)
    if test_gadt_add_def() { passed = passed + 1 }
    if test_gadt_find_def() { passed = passed + 1 }
    if test_gadt_def_param_names() { passed = passed + 1 }
    if test_gadt_multiple_defs() { passed = passed + 1 }
    if test_gadt_def_ctor_start() { passed = passed + 1 }

    // Constructor operations (5)
    if test_gadt_add_ctor() { passed = passed + 1 }
    if test_gadt_find_ctor() { passed = passed + 1 }
    if test_gadt_ctor_gadt() { passed = passed + 1 }
    if test_gadt_ctor_field_types() { passed = passed + 1 }
    if test_gadt_ctor_increments_def_count() { passed = passed + 1 }

    // Type substitution (5)
    if test_gadt_subst_var() { passed = passed + 1 }
    if test_gadt_subst_no_match() { passed = passed + 1 }
    if test_gadt_subst_app() { passed = passed + 1 }
    if test_gadt_subst_func() { passed = passed + 1 }
    if test_gadt_apply_subst() { passed = passed + 1 }

    // Unification (5)
    if test_gadt_types_equal_same() { passed = passed + 1 }
    if test_gadt_types_equal_diff_kind() { passed = passed + 1 }
    if test_gadt_unify_var() { passed = passed + 1 }
    if test_gadt_unify_app() { passed = passed + 1 }
    if test_gadt_occurs_check() { passed = passed + 1 }

    // Constraints (5)
    if test_gadt_add_constraint() { passed = passed + 1 }
    if test_gadt_activate_constraints() { passed = passed + 1 }
    if test_gadt_deactivate_constraints() { passed = passed + 1 }
    if test_gadt_constraint_inactive_by_default() { passed = passed + 1 }
    if test_gadt_activate_only_matching_ctor() { passed = passed + 1 }

    // Evidence / refinement (5)
    if test_gadt_push_evidence() { passed = passed + 1 }
    if test_gadt_find_evidence() { passed = passed + 1 }
    if test_gadt_evidence_shadowing() { passed = passed + 1 }
    if test_gadt_refine_type() { passed = passed + 1 }
    if test_gadt_refine_no_evidence() { passed = passed + 1 }

    // Pattern matching (5)
    if test_gadt_check_match_arm() { passed = passed + 1 }
    if test_gadt_check_match_arm_invalid_ctor() { passed = passed + 1 }
    if test_gadt_infer_ctor_result() { passed = passed + 1 }
    if test_gadt_match_arm_pushes_evidence() { passed = passed + 1 }
    if test_gadt_match_arm_evidence_correct() { passed = passed + 1 }

    // Exhaustiveness (5)
    if test_gadt_exhaustive_all_covered() { passed = passed + 1 }
    if test_gadt_exhaustive_missing_one() { passed = passed + 1 }
    if test_gadt_missing_ctors_count() { passed = passed + 1 }
    if test_gadt_exhaustive_single_ctor() { passed = passed + 1 }
    if test_gadt_exhaustive_empty_covered() { passed = passed + 1 }

    // Validation (5)
    if test_gadt_validate_def_ok() { passed = passed + 1 }
    if test_gadt_validate_def_invalid_idx() { passed = passed + 1 }
    if test_gadt_validate_ctor_ok() { passed = passed + 1 }
    if test_gadt_check_ctor_types_ok() { passed = passed + 1 }
    if test_gadt_is_recursive() { passed = passed + 1 }

    // Scope (5)
    if test_gadt_enter_exit_scope() { passed = passed + 1 }
    if test_gadt_scope_pops_evidence() { passed = passed + 1 }
    if test_gadt_nested_scopes() { passed = passed + 1 }
    if test_gadt_scope_preserves_outer() { passed = passed + 1 }
    if test_gadt_pop_evidence_to() { passed = passed + 1 }

    // Advanced type equality (5)
    if test_gadt_types_equal_vars_same() { passed = passed + 1 }
    if test_gadt_types_equal_vars_diff() { passed = passed + 1 }
    if test_gadt_types_equal_apps() { passed = passed + 1 }
    if test_gadt_types_equal_apps_diff() { passed = passed + 1 }
    if test_gadt_types_equal_funcs() { passed = passed + 1 }

    // Advanced unification (5)
