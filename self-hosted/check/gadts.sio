    let e0 = gadt_push_evidence(env, 100, ti, GADT_INVALID)
    let e1 = gadt_push_evidence(env, 100, tb, GADT_INVALID)
    // Most recent should win
    let result = gadt_find_evidence(env, 100)
    result == tb
}
fn test_gadt_evidence_shadowing() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
