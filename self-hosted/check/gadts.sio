}

fn test_gadt_find_evidence_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let ti = gadt_mk_int(env)
    let tb = gadt_mk_bool(env)
    let e0 = gadt_push_evidence(env, 100, ti, GADT_INVALID)
    let e1 = gadt_push_evidence(env, 200, tb, GADT_INVALID)
    let f100 = gadt_find_evidence(env, 100)
    let f200 = gadt_find_evidence(env, 200)
    let fmiss = gadt_find_evidence(env, 999)
    f100 == ti && f200 == tb && fmiss == GADT_INVALID
}
fn test_gadt_find_evidence() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_find_evidence_inner(&! env)
