    p2[0 as usize] = ti
    let a1 = gadt_mk_app(env, con, p1, 1)
    let a2 = gadt_mk_app(env, con, p2, 1)
    gadt_unify(env, a1, a2)
}
fn test_gadt_unify_app() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_app_inner(&! env)
}

fn test_gadt_occurs_check_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 77)
    let con = gadt_mk_con(env, 1)
    var p: [i64; 16] = [0; 16]
    p[0 as usize] = v
    let app = gadt_mk_app(env, con, p, 1)
    // v occurs in app, so occurs check should find it
    let found = gadt_occurs_check(env, 77, app)
    if found == false { return false }
    // v does not occur in a separate int type
    let ti = gadt_mk_int(env)
    let not_found = gadt_occurs_check(env, 77, ti)
    not_found == false
}
fn test_gadt_occurs_check() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_occurs_check_inner(&! env)
}

