// micro_bootstrap.sio — Zero-import single-file Sounio→x86-64 ELF compiler
// Flat-array AST, stack-slot codegen, inline ELF writer

// Native runtime helpers for file reading without [i8; 1048576] arrays.
// In native ELF: load_source mmaps + reads file, source_byte reads from buffer.
// Under JIT: implemented as wrappers around read_file/file_size.
// load_source: Under JIT, reads file and copies to SRC.
// Under native, this is overridden by a builtin (mmap + read → native buffer).
fn load_source(path: string) -> i64 with IO, Mut, Panic, Div {
    let data = read_file(path)
    let sz = file_size(path)
    var i: i64 = 0
    while i < sz && i < 1048576 {
        SRC[i as usize] = data[i as usize]
        i = i + 1
    }
    SRC_LEN = sz
    sz
}
// source_byte: Under JIT, reads from SRC global array.
// Under native, overridden by builtin that reads from mmap'd buffer.
fn source_byte(idx: i64) -> i64 { SRC[idx as usize] as i64 }

// ============================================================================
// Global state
// ============================================================================

// Source text
var SRC: [i8; 1048576] = [0; 1048576]
var SRC_LEN: i64 = 0
var SRC_BUF: i64 = 0  // native: mmap'd source buffer pointer

// Token storage
var TK_KIND: [i64; 65536] = [0; 65536]
var TK_START: [i64; 65536] = [0; 65536]
var TK_END: [i64; 65536] = [0; 65536]
var TK_IVAL: [i64; 65536] = [0; 65536]
var TK_COUNT: i64 = 0

// String pool for identifiers/strings
var POOL: [i8; 262144] = [0; 262144]
var POOL_POS: i64 = 0

// AST nodes (flat array)
var ND_KIND: [i64; 32768] = [0; 32768]
var ND_IVAL: [i64; 32768] = [0; 32768]
var ND_LEFT: [i64; 32768] = [-1; 32768]
var ND_RIGHT: [i64; 32768] = [-1; 32768]
var ND_EXTRA: [i64; 32768] = [-1; 32768]
var ND_EXTRA2: [i64; 32768] = [-1; 32768]
var ND_STR_OFF: [i64; 32768] = [0; 32768]
var ND_STR_LEN: [i64; 32768] = [0; 32768]
var ND_COUNT: i64 = 0

// Function registry
var FN_NAME_OFF: [i64; 512] = [0; 512]
var FN_NAME_LEN: [i64; 512] = [0; 512]
var FN_PARAM_COUNT: [i64; 512] = [0; 512]
var FN_BODY_NODE: [i64; 512] = [-1; 512]
var FN_COUNT: i64 = 0

// Param registry: for each fn, up to 8 params
var FN_PARAM_NAME_OFF: [i64; 4096] = [0; 4096]
var FN_PARAM_NAME_LEN: [i64; 4096] = [0; 4096]
var FN_PARAM_BASE: [i64; 512] = [0; 512]

// Local variable slots
var LOCAL_NAME_OFF: [i64; 4096] = [0; 4096]
var LOCAL_NAME_LEN: [i64; 4096] = [0; 4096]
var LOCAL_SLOT: [i64; 4096] = [0; 4096]
var LOCAL_COUNT: i64 = 0
var NEXT_SLOT: i64 = 0

// Code output
var CODE: [i8; 262144] = [0; 262144]
var CODE_LEN: i64 = 0
var PRINT_INT_OFF: i64 = 0  // CODE offset of print_int helper (emitted first)

// Function offsets in code
var FN_CODE_OFF: [i64; 512] = [0; 512]

// Fixup table for call patches
var FIX_OFF: [i64; 4096] = [0; 4096]
var FIX_TARGET: [i64; 4096] = [0; 4096]
var FIX_COUNT: i64 = 0

// Parser position
var POS: i64 = 0
// Loop context: current while-loop top (for continue); 0 = no active loop
var LOOP_TOP: i64 = 0
// Break fixup: forward JMP offsets emitted by NK_BREAK, patched after loop
var BREAK_FIXUP_OFF: [i64; 64] = [0; 64]
var BREAK_FIXUP_COUNT: i64 = 0

// Global variable tracking for compiler output
var MB_GL_NS: [i64; 256] = [0; 256]
var MB_GL_NE: [i64; 256] = [0; 256]
var MB_GL_OFF: [i64; 256] = [0; 256]
var MB_GL_SZ: [i64; 256] = [0; 256]
var MB_GL_COUNT: i64 = 0
var MB_BSS_TOTAL: i64 = 0
// BSS addresses for SRC_BUF and SRC_LEN (populated after mb_collect_globals)
var MB_SRC_BUF_GADDR: i64 = 0
var MB_SRC_LEN_GADDR: i64 = 0
// BSS addresses for IMP_FNAME_BUF and IMP_FNAME_PTR (for import file loading)
var MB_IMP_FNAME_BUF_GADDR: i64 = 0
var MB_IMP_FNAME_PTR_GADDR: i64 = 0

// ============================================================================
// Constants
// ============================================================================

// Token kinds
fn TK_EOF() -> i64 { 0 }
fn TK_IDENT() -> i64 { 1 }
fn TK_INT() -> i64 { 2 }
fn TK_STR() -> i64 { 3 }
fn TK_PLUS() -> i64 { 10 }
fn TK_MINUS() -> i64 { 11 }
fn TK_STAR() -> i64 { 12 }
fn TK_SLASH() -> i64 { 13 }
fn TK_PERCENT() -> i64 { 14 }
fn TK_AMP() -> i64 { 15 }
fn TK_PIPE() -> i64 { 16 }
fn TK_CARET() -> i64 { 17 }
fn TK_SHL() -> i64 { 18 }
fn TK_SHR() -> i64 { 19 }
fn TK_AMPAMP() -> i64 { 20 }
fn TK_PIPEPIPE() -> i64 { 21 }
fn TK_BANG() -> i64 { 22 }
fn TK_EQ() -> i64 { 23 }
fn TK_NE() -> i64 { 24 }
fn TK_LT() -> i64 { 25 }
fn TK_LE() -> i64 { 26 }
fn TK_GT() -> i64 { 27 }
fn TK_GE() -> i64 { 28 }
fn TK_ASSIGN() -> i64 { 30 }
fn TK_LPAREN() -> i64 { 31 }
fn TK_RPAREN() -> i64 { 32 }
fn TK_LBRACE() -> i64 { 33 }
fn TK_RBRACE() -> i64 { 34 }
fn TK_LBRACKET() -> i64 { 35 }
fn TK_RBRACKET() -> i64 { 36 }
fn TK_COMMA() -> i64 { 37 }
fn TK_COLON() -> i64 { 38 }
fn TK_SEMI() -> i64 { 39 }
fn TK_DOT() -> i64 { 40 }
fn TK_ARROW() -> i64 { 42 }
fn TK_FN() -> i64 { 50 }
fn TK_LET() -> i64 { 51 }
fn TK_VAR() -> i64 { 52 }
fn TK_IF() -> i64 { 53 }
fn TK_ELSE() -> i64 { 54 }
fn TK_WHILE() -> i64 { 55 }
fn TK_RETURN() -> i64 { 56 }
fn TK_TRUE() -> i64 { 61 }
fn TK_FALSE() -> i64 { 62 }
fn TK_BREAK() -> i64 { 63 }
fn TK_CONTINUE() -> i64 { 64 }
fn TK_AS() -> i64 { 65 }
fn TK_WITH() -> i64 { 66 }
fn TK_STRUCT() -> i64 { 58 }
fn TK_AMPBANG() -> i64 { 70 }

// AST node kinds
fn NK_INT() -> i64 { 1 }
fn NK_IDENT() -> i64 { 2 }
fn NK_STR() -> i64 { 3 }
fn NK_BOOL() -> i64 { 4 }
fn NK_BINOP() -> i64 { 10 }
fn NK_UNARY() -> i64 { 11 }
fn NK_CALL() -> i64 { 12 }
fn NK_INDEX() -> i64 { 13 }
fn NK_FIELD() -> i64 { 14 }
fn NK_CAST() -> i64 { 16 }
fn NK_IF() -> i64 { 30 }
fn NK_WHILE() -> i64 { 31 }
fn NK_BLOCK() -> i64 { 33 }
fn NK_RETURN() -> i64 { 34 }
fn NK_BREAK() -> i64 { 35 }
fn NK_LET() -> i64 { 40 }
fn NK_VAR() -> i64 { 41 }
fn NK_ASSIGN() -> i64 { 42 }
fn NK_EXPR_STMT() -> i64 { 43 }

// ============================================================================
// Lexer helpers
// ============================================================================

fn src_byte(pos: i64) -> i64 with Panic {
    if pos < 0 || pos >= SRC_LEN { return 0 }
    source_byte(pos)
}

fn is_ws(ch: i64) -> bool {
    ch == 32 || ch == 9 || ch == 10 || ch == 13
}

fn is_digit(ch: i64) -> bool {
    ch >= 48 && ch <= 57
}

fn is_alpha(ch: i64) -> bool {
    (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn is_alnum(ch: i64) -> bool {
    is_alpha(ch) || is_digit(ch)
}

fn pool_add(b: i64) with Mut, Panic {
    POOL[POOL_POS as usize] = b as i8
    POOL_POS = POOL_POS + 1
}

fn pool_match(off: i64, len: i64, target: string) -> bool with Mut, Panic, Div {
    if len != str_len(target) { return false }
    var i: i64 = 0
    while i < len {
        let a = POOL[(off + i) as usize] as i64
        let b = str_char_at(target, i) as i64
        if a != b { return false }
        i = i + 1
    }
    true
}

fn classify_keyword(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    if len == 2 {
        if pool_match(off, len, "fn") { return 50 }
        if pool_match(off, len, "if") { return 53 }
        if pool_match(off, len, "as") { return 65 }
    } else if len == 3 {
        if pool_match(off, len, "let") { return 51 }
        if pool_match(off, len, "var") { return 52 }
        if pool_match(off, len, "for") { return 55 }
    } else if len == 4 {
        if pool_match(off, len, "else") { return 54 }
        if pool_match(off, len, "true") { return 61 }
        if pool_match(off, len, "with") { return 66 }
        if pool_match(off, len, "None") { return 68 }
        if pool_match(off, len, "Some") { return 67 }
        if pool_match(off, len, "self") { return 1 }
        if pool_match(off, len, "Self") { return 1 }
        if pool_match(off, len, "type") { return 1 }
        if pool_match(off, len, "impl") { return 60 }
        if pool_match(off, len, "enum") { return 59 }
        if pool_match(off, len, "loop") { return 55 }
    } else if len == 5 {
        if pool_match(off, len, "while") { return 55 }
        if pool_match(off, len, "break") { return 63 }
        if pool_match(off, len, "false") { return 62 }
        if pool_match(off, len, "match") { return 57 }
    } else if len == 6 {
        if pool_match(off, len, "return") { return 56 }
        if pool_match(off, len, "struct") { return 58 }
        if pool_match(off, len, "module") { return 1 }
        if pool_match(off, len, "linear") { return 1 }
    } else if len == 8 {
        if pool_match(off, len, "continue") { return 64 }
    }
    0
}

// ============================================================================
// Lexer
// ============================================================================

fn add_token(kind: i64, start: i64, end: i64, ival: i64) with Mut, Panic {
    let idx = TK_COUNT
    TK_KIND[idx as usize] = kind
    TK_START[idx as usize] = start
    TK_END[idx as usize] = end
    TK_IVAL[idx as usize] = ival
    TK_COUNT = TK_COUNT + 1
}

fn lex() with Mut, Panic, Div {
    var p: i64 = 0
    while p < SRC_LEN {
        let ch = src_byte(p)
        // Skip whitespace
        if is_ws(ch) {
            p = p + 1
            continue
        }
        // Skip line comments
        if ch == 47 && src_byte(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && src_byte(p) != 10 {
                p = p + 1
            }
            continue
        }
        // Numbers (decimal and hex 0x...)
        if is_digit(ch) {
            let start = p
            var val: i64 = 0
            // Check for 0x hex prefix
            if ch == 48 && p + 1 < SRC_LEN && src_byte(p + 1) == 120 {
                // hex literal
                p = p + 2  // skip 0x
                while p < SRC_LEN {
                    let hc = src_byte(p)
                    if hc >= 48 && hc <= 57 {
                        val = val * 16 + (hc - 48)
                        p = p + 1
                    } else if hc >= 65 && hc <= 70 {
                        val = val * 16 + (hc - 55)
                        p = p + 1
                    } else if hc >= 97 && hc <= 102 {
                        val = val * 16 + (hc - 87)
                        p = p + 1
                    } else {
                        break
                    }
                }
            } else {
                while p < SRC_LEN && is_digit(src_byte(p)) {
                    val = val * 10 + (src_byte(p) - 48)
                    p = p + 1
                }
            }
            add_token(2, start, p, val)
            continue
        }
        // Identifiers and keywords
        if is_alpha(ch) {
            let start = p
            let pool_start = POOL_POS
            while p < SRC_LEN && is_alnum(src_byte(p)) {
                pool_add(src_byte(p))
                p = p + 1
            }
            let ilen = p - start
            let kw = classify_keyword(pool_start, ilen)
            if kw != 0 {
                add_token(kw, start, p, pool_start)
            } else {
                add_token(1, start, p, pool_start)
            }
            continue
        }
        // String literals
        if ch == 34 {
            p = p + 1
            let start = p
            let pool_start = POOL_POS
            while p < SRC_LEN && src_byte(p) != 34 {
                if src_byte(p) == 92 {
                    p = p + 1
                    let esc = src_byte(p)
                    if esc == 110 { pool_add(10) }
                    else if esc == 116 { pool_add(9) }
                    else if esc == 92 { pool_add(92) }
                    else if esc == 34 { pool_add(34) }
                    else if esc == 48 { pool_add(0) }
                    else { pool_add(esc) }
                } else {
                    pool_add(src_byte(p))
                }
                p = p + 1
            }
            let slen = POOL_POS - pool_start
            p = p + 1
            add_token(3, start, p, pool_start)
            // Store string length in TK_END for strings (overload)
            TK_END[(TK_COUNT - 1) as usize] = slen
            continue
        }
        // Two-char operators
        let ch2 = src_byte(p + 1)
        if ch == 38 && ch2 == 38 { add_token(20, p, p + 2, 0); p = p + 2; continue }
        if ch == 124 && ch2 == 124 { add_token(21, p, p + 2, 0); p = p + 2; continue }
        if ch == 61 && ch2 == 61 { add_token(23, p, p + 2, 0); p = p + 2; continue }
        if ch == 33 && ch2 == 61 { add_token(24, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 61 { add_token(26, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 61 { add_token(28, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 60 { add_token(18, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 62 { add_token(19, p, p + 2, 0); p = p + 2; continue }
        if ch == 45 && ch2 == 62 { add_token(42, p, p + 2, 0); p = p + 2; continue }
        if ch == 38 && ch2 == 33 { add_token(70, p, p + 2, 0); p = p + 2; continue }
        if ch == 58 && ch2 == 58 { add_token(41, p, p + 2, 0); p = p + 2; continue }
        if ch == 46 && ch2 == 46 { add_token(43, p, p + 2, 0); p = p + 2; continue }
        // Single-char operators
        if ch == 43 { add_token(10, p, p + 1, 0); p = p + 1; continue }
        if ch == 45 { add_token(11, p, p + 1, 0); p = p + 1; continue }
        if ch == 42 { add_token(12, p, p + 1, 0); p = p + 1; continue }
        if ch == 47 { add_token(13, p, p + 1, 0); p = p + 1; continue }
        if ch == 37 { add_token(14, p, p + 1, 0); p = p + 1; continue }
        if ch == 38 { add_token(15, p, p + 1, 0); p = p + 1; continue }
        if ch == 124 { add_token(16, p, p + 1, 0); p = p + 1; continue }
        if ch == 94 { add_token(17, p, p + 1, 0); p = p + 1; continue }
        if ch == 33 { add_token(22, p, p + 1, 0); p = p + 1; continue }
        if ch == 61 { add_token(30, p, p + 1, 0); p = p + 1; continue }
        if ch == 40 { add_token(31, p, p + 1, 0); p = p + 1; continue }
        if ch == 41 { add_token(32, p, p + 1, 0); p = p + 1; continue }
        if ch == 123 { add_token(33, p, p + 1, 0); p = p + 1; continue }
        if ch == 125 { add_token(34, p, p + 1, 0); p = p + 1; continue }
        if ch == 91 { add_token(35, p, p + 1, 0); p = p + 1; continue }
        if ch == 93 { add_token(36, p, p + 1, 0); p = p + 1; continue }
        if ch == 44 { add_token(37, p, p + 1, 0); p = p + 1; continue }
        if ch == 58 { add_token(38, p, p + 1, 0); p = p + 1; continue }
        if ch == 59 { add_token(39, p, p + 1, 0); p = p + 1; continue }
        if ch == 46 { add_token(40, p, p + 1, 0); p = p + 1; continue }
        if ch == 60 { add_token(25, p, p + 1, 0); p = p + 1; continue }
        if ch == 62 { add_token(27, p, p + 1, 0); p = p + 1; continue }
        // Skip unknown
        p = p + 1
    }
    add_token(0, SRC_LEN, SRC_LEN, 0)
}

// ============================================================================
// Parser helpers
// ============================================================================

fn cur_kind() -> i64 with Panic {
    TK_KIND[POS as usize]
}

fn cur_ival() -> i64 with Panic {
    TK_IVAL[POS as usize]
}

fn cur_start() -> i64 with Panic {
    TK_START[POS as usize]
}

fn cur_end() -> i64 with Panic {
    TK_END[POS as usize]
}

fn advance() with Mut, Panic {
    POS = POS + 1
}

fn expect(kind: i64) with Mut, Panic {
    if cur_kind() != kind {
        print("parse error: expected ")
        print_int(kind)
        print(" got ")
        print_int(cur_kind())
        print(" at ")
        print_int(POS)
        print("\n")
    }
    advance()
}

fn new_node(kind: i64, ival: i64) -> i64 with Mut, Panic {
    let idx = ND_COUNT
    if idx >= 32768 {
        print("NODE OVERFLOW idx=")
        print_int(idx)
        print("\n")
    }
    ND_KIND[idx as usize] = kind
    ND_IVAL[idx as usize] = ival
    ND_LEFT[idx as usize] = -1
    ND_RIGHT[idx as usize] = -1
    ND_EXTRA[idx as usize] = -1
    ND_EXTRA2[idx as usize] = -1
    ND_STR_OFF[idx as usize] = 0
    ND_STR_LEN[idx as usize] = 0
    ND_COUNT = ND_COUNT + 1
    idx
}

fn tok_pool_off() -> i64 with Panic {
    TK_IVAL[POS as usize]
}

fn tok_ident_len() -> i64 with Panic {
    TK_END[POS as usize] - TK_START[POS as usize]
}

// ============================================================================
// Parser: expressions
// ============================================================================

// Forward-reference workaround: parse_expr calls parse_primary which calls parse_expr.
// In Sounio, no forward refs. We use parse_block/parse_expr/parse_primary in mutual recursion.
// Solution: combine into one big function is impractical. Instead use the flat-recurse approach
// where parse_expr_bp calls itself. We'll structure carefully.

// We need: parse_expr -> parse_expr_bp -> parse_primary -> parse_expr (for sub-expressions)
// This is impossible without forward refs. Workaround: parse_atom and parse_expr in one function
// using a "mode" parameter wouldn't work either.
//
// ACTUAL SOLUTION: Sounio supports recursion within a single function. So parse_expr can call
// itself. The issue is parse_primary calling parse_expr. We define parse_primary AFTER parse_expr
// but parse_expr calls parse_primary... That's a forward ref.
//
// TRUE SOLUTION: Use a single parse_expr function that handles both atom and infix parsing
// via Pratt precedence. The "atom" part is inlined at the start.

fn binop_prec(kind: i64) -> i64 {
    if kind == 21 { 1 }       // ||
    else if kind == 20 { 2 }  // &&
    else if kind == 16 { 3 }  // |
    else if kind == 17 { 4 }  // ^
    else if kind == 15 { 5 }  // &
    else if kind == 23 || kind == 24 { 6 }  // == !=
    else if kind == 25 || kind == 26 || kind == 27 || kind == 28 { 7 }  // < <= > >=
    else if kind == 18 || kind == 19 { 8 }  // << >>
    else if kind == 10 || kind == 11 { 9 }  // + -
    else if kind == 12 || kind == 13 || kind == 14 { 10 }  // * / %
    else { 0 }
}

fn tok_to_binop(kind: i64) -> i64 {
    if kind == 10 { 0 }       // + -> add
    else if kind == 11 { 1 }  // - -> sub
    else if kind == 12 { 2 }  // * -> mul
    else if kind == 13 { 3 }  // / -> div
    else if kind == 14 { 4 }  // % -> mod
    else if kind == 23 { 5 }  // == -> eq
    else if kind == 24 { 6 }  // != -> ne
    else if kind == 25 { 7 }  // < -> lt
    else if kind == 26 { 8 }  // <= -> le
    else if kind == 27 { 9 }  // > -> gt
    else if kind == 28 { 10 } // >= -> ge
    else if kind == 20 { 11 } // && -> and
    else if kind == 21 { 12 } // || -> or
    else if kind == 15 { 13 } // & -> bitand
    else if kind == 16 { 14 } // | -> bitor
    else if kind == 17 { 15 } // ^ -> bitxor
    else if kind == 18 { 16 } // << -> shl
    else if kind == 19 { 17 } // >> -> shr
    else { -1 }
}

fn parse_block() -> i64 with Mut, Panic, Div {
    expect(33)  // {
    // Build a linked list of statements via ND_RIGHT
    let block_node = new_node(33, 0)  // NK_BLOCK
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        let stmt = parse_stmt()
        if first == -1 {
            first = stmt
        } else {
            ND_RIGHT[last as usize] = stmt
        }
        last = stmt
        // optional semicolons
        if cur_kind() == 39 { advance() }
    }
    expect(34)  // }
    ND_LEFT[block_node as usize] = first
    block_node
}

fn parse_args() -> i64 with Mut, Panic, Div {
    // Parse comma-separated exprs, return first node (linked via ND_EXTRA)
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 32 && cur_kind() != 0 {
        let arg = parse_expr(0)
        if first == -1 {
            first = arg
        } else {
            ND_EXTRA[last as usize] = arg
        }
        last = arg
        if cur_kind() == 37 { advance() }  // comma
    }
    first
}

fn parse_expr(min_prec: i64) -> i64 with Mut, Panic, Div {
    // Parse atom (primary)
    var left: i64 = -1
    let k = cur_kind()

    if k == 2 {
        // Integer literal
        left = new_node(1, cur_ival())
        advance()
    } else if k == 3 {
        // String literal
        left = new_node(3, 0)
        ND_STR_OFF[left as usize] = cur_ival()
        ND_STR_LEN[left as usize] = cur_end()  // overloaded: string length
        advance()
    } else if k == 61 {
        // true
        left = new_node(4, 1)
        advance()
    } else if k == 62 {
        // false
        left = new_node(4, 0)
        advance()
    } else if k == 1 {
        // Identifier
        let off = tok_pool_off()
        let ilen = tok_ident_len()
        left = new_node(2, 0)
        ND_STR_OFF[left as usize] = off
        ND_STR_LEN[left as usize] = ilen
        advance()
        // Check for function call
        if cur_kind() == 31 {
            advance()  // (
            let args = parse_args()
            expect(32)  // )
            let call_node = new_node(12, 0)
            ND_LEFT[call_node as usize] = left
            ND_EXTRA[call_node as usize] = args
            left = call_node
        }
    } else if k == 31 {
        // Parenthesized expression
        advance()  // (
        left = parse_expr(0)
        expect(32)  // )
    } else if k == 11 {
        // Unary minus
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 1)  // unary sub
        ND_LEFT[left as usize] = operand
    } else if k == 22 {
        // Unary not
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 0)  // unary not
        ND_LEFT[left as usize] = operand
    } else if k == 33 {
        // Block expression
        left = parse_block()
    } else if k == 53 {
        // if expression
        left = parse_if_expr()
    } else if k == 55 {
        // while expression
        left = parse_while_expr()
    } else if k == 35 {
        // Array literal [expr; N] or [expr, expr, ...]
        advance()  // [
        let fill_val = parse_expr(0)
        var arr_count: i64 = 1
        if cur_kind() == 39 {  // ;
            advance()  // ;
            if cur_kind() == 2 {
                arr_count = cur_ival()
                advance()  // N
            }
        }
        if cur_kind() == 36 { advance() }  // ]
        // NK_ARRAY_LIT (kind 50): ND_LEFT = fill value, ND_IVAL = count
        left = new_node(50, arr_count)
        ND_LEFT[left as usize] = fill_val
    } else {
        // Unknown token, create a dummy
        left = new_node(1, 0)
        advance()
    }

    // Postfix: as cast and array indexing
    var postfix_done: i64 = 0
    while postfix_done == 0 {
        if cur_kind() == 65 {
            advance()  // as
            // skip the type name
            if cur_kind() == 1 || cur_kind() >= 50 {
                advance()
            }
            // 'as' is a no-op cast in our codegen (everything is i64)
        } else if cur_kind() == 35 {
            // postfix array indexing: left[idx]
            advance()  // [
            let idx_expr = parse_expr(0)
            if cur_kind() == 36 { advance() }  // ]
            let inode = new_node(13, 0)  // NK_INDEX
            ND_LEFT[inode as usize] = left
            ND_RIGHT[inode as usize] = idx_expr
            left = inode
        } else {
            postfix_done = 1
        }
    }

    // Infix loop (Pratt precedence)
    while true {
        let op_kind = cur_kind()
        let prec = binop_prec(op_kind)
        if prec == 0 || prec < min_prec { break }
        let binop_code = tok_to_binop(op_kind)
        advance()
        let right = parse_expr(prec + 1)
        let bin_node = new_node(10, binop_code)  // NK_BINOP
        ND_LEFT[bin_node as usize] = left
        ND_RIGHT[bin_node as usize] = right
        // Save right's next pointer
        left = bin_node
    }

    left
}

fn parse_if_expr() -> i64 with Mut, Panic, Div {
    expect(53)  // if
    let cond = parse_expr(0)
    let then_block = parse_block()
    let if_node = new_node(30, 0)  // NK_IF
    ND_LEFT[if_node as usize] = cond
    ND_EXTRA[if_node as usize] = then_block
    if cur_kind() == 54 {
        advance()  // else
        if cur_kind() == 53 {
            let else_part = parse_if_expr()
            ND_EXTRA2[if_node as usize] = else_part
        } else {
            let else_block = parse_block()
            ND_EXTRA2[if_node as usize] = else_block
        }
    }
    if_node
}

fn parse_while_expr() -> i64 with Mut, Panic, Div {
    expect(55)  // while
    let cond = parse_expr(0)
    let body = parse_block()
    let wh_node = new_node(31, 0)  // NK_WHILE
    ND_LEFT[wh_node as usize] = cond
    ND_EXTRA[wh_node as usize] = body
    wh_node
}

// ============================================================================
// Parser: statements
// ============================================================================

fn skip_type_annotation() with Mut, Panic, Div {
    // Skip a type annotation after ':'
    // Handles simple types, arrays, references, generics (roughly)
    if cur_kind() == 38 {
        advance()  // :
        skip_type_expr()
    }
}

fn skip_type_expr() with Mut, Panic, Div {
    // Skip type expressions: ident, &T, &!T, [T; N], (T, T)
    if cur_kind() == 15 {
        advance()  // &
        skip_type_expr()
    } else if cur_kind() == 70 {
        advance()  // &!
        skip_type_expr()
    } else if cur_kind() == 35 {
        // Array type [T; N]
        advance()  // [
        skip_type_expr()
        if cur_kind() == 39 { advance() }  // ;
        if cur_kind() == 2 { advance() }   // size
        if cur_kind() == 36 { advance() }  // ]
    } else if cur_kind() == 31 {
        // Tuple type (T, T)
        advance()  // (
        while cur_kind() != 32 && cur_kind() != 0 {
            skip_type_expr()
            if cur_kind() == 37 { advance() }
        }
        if cur_kind() == 32 { advance() }
    } else if cur_kind() == 1 || cur_kind() >= 50 {
        advance()  // type name
        // Might have generic params <T>
        if cur_kind() == 25 {
            // < ... > but be careful not to confuse with comparison
            // Simple heuristic: skip until matching >
            advance()
            var depth: i64 = 1
            while depth > 0 && cur_kind() != 0 {
                if cur_kind() == 25 { depth = depth + 1 }
                else if cur_kind() == 27 { depth = depth - 1 }
                if depth > 0 { advance() }
            }
            if cur_kind() == 27 { advance() }
        }
    } else if cur_kind() == 2 {
        advance()  // numeric literal in type position (e.g., array size)
    }
}

fn parse_stmt() -> i64 with Mut, Panic, Div {
    let k = cur_kind()
    if k == 51 || k == 52 {
        // let / var
        let is_var = k == 52
        advance()
        let name_off = tok_pool_off()
        let name_len = tok_ident_len()
        advance()  // ident
        skip_type_annotation()
        expect(30)  // =
        let init = parse_expr(0)
        var node_kind: i64 = 40
        if is_var { node_kind = 41 }
        let node = new_node(node_kind, 0)
        ND_STR_OFF[node as usize] = name_off
        ND_STR_LEN[node as usize] = name_len
        ND_LEFT[node as usize] = init
        return node
    }
    if k == 56 {
        // return
        advance()
        let val = if cur_kind() != 34 && cur_kind() != 39 { parse_expr(0) } else { -1 }
        let node = new_node(34, 0)  // NK_RETURN
        ND_LEFT[node as usize] = val
        return node
    }
    if k == 63 {
        // break
        advance()
        return new_node(35, 0)
    }
    if k == 64 {
        // continue
        advance()
        return new_node(36, 0)
    }
    if k == 53 {
        return parse_if_expr()
    }
    if k == 55 {
        return parse_while_expr()
    }
    // Expression statement, possibly assignment
    let expr = parse_expr(0)
    if cur_kind() == 30 {
        // Assignment
        advance()
        let rhs = parse_expr(0)
        let asgn = new_node(42, 0)  // NK_ASSIGN
        ND_LEFT[asgn as usize] = expr
        ND_EXTRA[asgn as usize] = rhs
        return asgn
    }
    // Wrap as expression statement
    let es = new_node(43, 0)
    ND_LEFT[es as usize] = expr
    es
}

// ============================================================================
// Parser: top-level
// ============================================================================

fn skip_effects() with Mut, Panic, Div {
    // Skip 'with Effect, Effect, ...'
    if cur_kind() == 66 {
        advance()  // with
        while cur_kind() == 1 || cur_kind() >= 50 {
            advance()
            if cur_kind() == 37 { advance() }  // comma
        }
    }
}

fn skip_return_type() with Mut, Panic, Div {
    if cur_kind() == 42 {
        advance()  // ->
        skip_type_expr()
    }
}

fn parse_fn_def() with Mut, Panic, Div {
    expect(50)  // fn
    let fn_idx = FN_COUNT
    let name_off = tok_pool_off()
    let name_len = tok_ident_len()
    FN_NAME_OFF[fn_idx as usize] = name_off
    FN_NAME_LEN[fn_idx as usize] = name_len
    advance()  // name

    // Parse params
    expect(31)  // (
    var pcount: i64 = 0
    let pbase = fn_idx * 8
    FN_PARAM_BASE[fn_idx as usize] = pbase
    while cur_kind() != 32 && cur_kind() != 0 {
        let poff = tok_pool_off()
        let plen = tok_ident_len()
        FN_PARAM_NAME_OFF[(pbase + pcount) as usize] = poff
        FN_PARAM_NAME_LEN[(pbase + pcount) as usize] = plen
        advance()  // param name
        skip_type_annotation()
        pcount = pcount + 1
        if cur_kind() == 37 { advance() }  // comma
    }
    expect(32)  // )
    FN_PARAM_COUNT[fn_idx as usize] = pcount

    skip_return_type()
    skip_effects()

    let body = parse_block()
    FN_BODY_NODE[fn_idx as usize] = body
    FN_COUNT = FN_COUNT + 1
}

fn skip_braces() with Mut, Panic, Div {
    if cur_kind() == 33 {
        advance()
        var depth: i64 = 1
        while depth > 0 && cur_kind() != 0 {
            if cur_kind() == 33 { depth = depth + 1 }
            else if cur_kind() == 34 { depth = depth - 1 }
            if depth > 0 { advance() }
        }
        if cur_kind() == 34 { advance() }
    }
}

fn skip_to_next_top_level() with Mut, Panic, Div {
    // Skip until we find fn/struct/let/var/EOF at top level
    while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 51 && cur_kind() != 52 && cur_kind() != 59 && cur_kind() != 60 {
        if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
}

fn parse_program() with Mut, Panic, Div {
    while cur_kind() != 0 {
        let k = cur_kind()
        if k == 50 {
            parse_fn_def()
        } else if k == 58 || k == 59 || k == 60 {
            // struct / enum / impl: skip for now
            advance()
            if cur_kind() == 1 { advance() }
            skip_braces()
        } else if k == 51 || k == 52 {
            // top-level let/var: skip
            while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 59 && cur_kind() != 60 {
                advance()
            }
        } else {
            skip_to_next_top_level()
        }
    }
}

// ============================================================================
// Codegen helpers
// ============================================================================

fn emit(b: i64) with Mut, Panic {
    if CODE_LEN < 0 || CODE_LEN >= 262144 {
        print("EMIT OVERFLOW CODE_LEN=")
        print_int(CODE_LEN)
        print("\n")
        return
    }
    CODE[CODE_LEN as usize] = b as i8
    CODE_LEN = CODE_LEN + 1
}

fn emit_u32(v: i64) with Mut, Panic {
    emit(v & 0xFF)
    emit((v >> 8) & 0xFF)
    emit((v >> 16) & 0xFF)
    emit((v >> 24) & 0xFF)
}

fn emit_u64(v: i64) with Mut, Panic {
    emit_u32(v)
    emit_u32(v >> 32)
}

fn emit_mov_rax_imm(val: i64) with Mut, Panic {
    emit(0x48); emit(0xB8)
    emit_u64(val)
}

fn emit_store_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x89); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rcx(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x8D)
    emit_u32(disp)
}

fn emit_prologue() with Mut, Panic {
    // push rbp
    emit(0x55)
    // mov rbp, rsp
    emit(0x48); emit(0x89); emit(0xE5)
    // sub rsp, 32768 (0x8000)
    emit(0x48); emit(0x81); emit(0xEC)
    emit_u32(32768)
}

fn emit_epilogue() with Mut, Panic {
    // mov rsp, rbp
    emit(0x48); emit(0x89); emit(0xEC)
    // pop rbp
    emit(0x5D)
    // ret
    emit(0xC3)
}

// Emit precompiled print_int helper into CODE (107 bytes)
// Call convention: rdi = integer to print (decimal + no newline)
// Must be emitted before any user functions (called first in main)
fn emit_print_int_helper() with Mut, Panic {
    PRINT_INT_OFF = CODE_LEN
    // prologue
    emit(0x55)                                                      // push rbp
    emit(0x48); emit(0x89); emit(0xE5)                              // mov rbp, rsp
    emit(0x48); emit(0x83); emit(0xEC); emit(0x30)                  // sub rsp, 48
    emit(0x48); emit(0x89); emit(0xF8)                              // mov rax, rdi
    emit(0x4C); emit(0x8D); emit(0x45); emit(0xFF)                  // lea r8, [rbp-1]
    // sign handling
    emit(0x45); emit(0x31); emit(0xC9)                              // xor r9d, r9d
    emit(0x48); emit(0x85); emit(0xC0)                              // test rax, rax
    emit(0x79); emit(0x06)                                          // jns +6 (skip neg+sign_set)
    emit(0x48); emit(0xF7); emit(0xD8)                              // neg rax
    emit(0x41); emit(0xB1); emit(0x01)                              // mov r9b, 1
    // zero check: jnz +9 skips zero-special to itoa_loop
    emit(0x48); emit(0x85); emit(0xC0)                              // test rax, rax
    emit(0x75); emit(0x09)                                          // jnz +9
    emit(0x41); emit(0xC6); emit(0x00); emit(0x30)                  // mov byte [r8], '0'
    emit(0x49); emit(0xFF); emit(0xC8)                              // dec r8
    emit(0xEB); emit(0x26)                                          // jmp do_write (+38)
    // itoa_loop (offset 43 from PRINT_INT_OFF):
    emit(0x31); emit(0xD2)                                          // xor edx, edx
    emit(0x48); emit(0xC7); emit(0xC1); emit(0x0A); emit(0x00); emit(0x00); emit(0x00)  // mov rcx, 10
    emit(0x48); emit(0xF7); emit(0xF1)                              // div rcx
    emit(0x80); emit(0xC2); emit(0x30)                              // add dl, '0'
    emit(0x41); emit(0x88); emit(0x10)                              // mov [r8], dl
    emit(0x49); emit(0xFF); emit(0xC8)                              // dec r8
    emit(0x48); emit(0x85); emit(0xC0)                              // test rax, rax
    emit(0x75); emit(0xE6)                                          // jnz itoa_loop (-26)
    // sign append
    emit(0x45); emit(0x84); emit(0xC9)                              // test r9b, r9b
    emit(0x74); emit(0x07)                                          // jz do_write (+7)
    emit(0x41); emit(0xC6); emit(0x00); emit(0x2D)                  // mov byte [r8], '-'
    emit(0x49); emit(0xFF); emit(0xC8)                              // dec r8
    // do_write (offset 81 from PRINT_INT_OFF):
    emit(0x49); emit(0xFF); emit(0xC0)                              // inc r8
    emit(0x4C); emit(0x89); emit(0xC6)                              // mov rsi, r8
    emit(0x48); emit(0x89); emit(0xEA)                              // mov rdx, rbp
    emit(0x4C); emit(0x29); emit(0xC2)                              // sub rdx, r8
    emit(0xBF); emit(0x01); emit(0x00); emit(0x00); emit(0x00)      // mov edi, 1
    emit(0xB8); emit(0x01); emit(0x00); emit(0x00); emit(0x00)      // mov eax, 1
    emit(0x0F); emit(0x05)                                          // syscall
    emit(0xC9)                                                      // leave
    emit(0xC3)                                                      // ret
}

// ============================================================================
// Codegen: local variable management
// ============================================================================

fn locals_reset() with Mut {
    LOCAL_COUNT = 0
    NEXT_SLOT = 0
}

fn alloc_slot() -> i64 with Mut {
    let s = NEXT_SLOT
    if s > 4000 {
        print("SLOT OVERFLOW slot=")
        print_int(s)
        print("\n")
    }
    NEXT_SLOT = NEXT_SLOT + 1
    s
}

fn add_local(off: i64, len: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    let slot = alloc_slot()
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_SLOT[idx as usize] = slot
    LOCAL_COUNT = LOCAL_COUNT + 1
    slot
}

fn find_local(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = LOCAL_COUNT - 1
    while i >= 0 {
        let lo = LOCAL_NAME_OFF[i as usize]
        let ll = LOCAL_NAME_LEN[i as usize]
        if ll == len {
            var match_ok: bool = true
            var j: i64 = 0
            while j < len {
                if POOL[(lo + j) as usize] != POOL[(off + j) as usize] {
                    match_ok = false
                    break
                }
                j = j + 1
            }
            if match_ok {
                return LOCAL_SLOT[i as usize]
            }
        }
        i = i - 1
    }
    -1
}

fn find_fn_by_name(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FN_COUNT {
        let fo = FN_NAME_OFF[i as usize]
        let fl = FN_NAME_LEN[i as usize]
        if fl == len {
            var match_ok: bool = true
            var j: i64 = 0
            while j < len {
                if POOL[(fo + j) as usize] != POOL[(off + j) as usize] {
                    match_ok = false
                    break
                }
                j = j + 1
            }
            if match_ok { return i }
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// Global variable collection (scans tokens for file-scope var declarations)
// ============================================================================

fn mb_collect_globals() with Mut, Panic, Div {
    var ti: i64 = 0
    var depth: i64 = 0
    while ti < TK_COUNT {
        let k = TK_KIND[ti as usize]
        if k == 0 { break }
        if k == 33 { depth = depth + 1 }
        else if k == 34 { depth = depth - 1 }
        else if k == 52 && depth == 0 {
            // TK_VAR at top level: var NAME : TYPE = INIT
            ti = ti + 1
            let ns = TK_START[ti as usize]
            let ne = TK_END[ti as usize]
            let gi = MB_GL_COUNT
            MB_GL_NS[gi as usize] = ns
            MB_GL_NE[gi as usize] = ne
            MB_GL_OFF[gi as usize] = MB_BSS_TOTAL
            ti = ti + 1  // skip name
            var sz: i64 = 8
            var count: i64 = 1
            // check for : type annotation
            if TK_KIND[ti as usize] == 38 {
                ti = ti + 1  // skip :
                // check for [T; N] array type
                if TK_KIND[ti as usize] == 35 {
                    ti = ti + 1  // skip [
                    // type name (ident)
                    if TK_KIND[ti as usize] == 1 {
                        let tns = TK_START[ti as usize]
                        let tne = TK_END[ti as usize]
                        // check if type is "i8" (bytes 105, 56)
                        if tne - tns == 2 {
                            let b0 = source_byte(tns)
                            let b1 = source_byte(tns + 1)
                            if b0 == 105 && b1 == 56 { sz = 1 }
                        }
                        ti = ti + 1  // skip type name
                    }
                    // skip ; size ]
                    if TK_KIND[ti as usize] == 39 { ti = ti + 1 }  // ;
                    if TK_KIND[ti as usize] == 2 {
                        count = TK_IVAL[ti as usize]
                        ti = ti + 1
                    }
                    if TK_KIND[ti as usize] == 36 { ti = ti + 1 }  // ]
                } else {
                    // scalar type: skip type name token
                    if TK_KIND[ti as usize] == 1 || TK_KIND[ti as usize] >= 50 { ti = ti + 1 }
                }
            }
            MB_GL_SZ[gi as usize] = sz
            MB_BSS_TOTAL = MB_BSS_TOTAL + count * sz
            let rem = MB_BSS_TOTAL - (MB_BSS_TOTAL / 8) * 8
            if rem != 0 { MB_BSS_TOTAL = MB_BSS_TOTAL + (8 - rem) }
            MB_GL_COUNT = MB_GL_COUNT + 1
        }
        ti = ti + 1
    }
}

fn mb_find_global(pool_off: i64, pool_len: i64) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if pool_len == ne - ns {
            var match_ok: i64 = 1
            var ci: i64 = 0
            while ci < pool_len {
                let pb = POOL[(pool_off + ci) as usize] as i64
                let sb = source_byte(ns + ci)
                if pb != sb { match_ok = 0 }
                ci = ci + 1
            }
            if match_ok == 1 { return gi }
        }
        gi = gi + 1
    }
    0 - 1
}

// Scan MB_GL_* for "SRC_BUF" and "SRC_LEN" by source bytes, set MB_SRC_BUF_GADDR / MB_SRC_LEN_GADDR
// SRC_BUF = bytes 83,82,67,95,66,85,70 (7 chars)
// SRC_LEN = bytes 83,82,67,95,76,69,78 (7 chars)
fn mb_resolve_src_globals() with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if ne - ns == 7 {
            let b0 = source_byte(ns)
            let b1 = source_byte(ns + 1)
            let b2 = source_byte(ns + 2)
            let b3 = source_byte(ns + 3)
            let b4 = source_byte(ns + 4)
            let b5 = source_byte(ns + 5)
            let b6 = source_byte(ns + 6)
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 66 && b5 == 85 && b6 == 70 {
                MB_SRC_BUF_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 76 && b5 == 69 && b6 == 78 {
                MB_SRC_LEN_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
        }
        // IMP_FNAME_BUF (13 chars) = 73 77 80 95 70 78 65 77 69 95 66 85 70
        // IMP_FNAME_PTR (13 chars) = 73 77 80 95 70 78 65 77 69 95 80 84 82
        if ne - ns == 13 {
            let c0 = source_byte(ns)
            let c1 = source_byte(ns + 1)
            let c2 = source_byte(ns + 2)
            let c3 = source_byte(ns + 3)
            let c4 = source_byte(ns + 4)
            let c5 = source_byte(ns + 5)
            let c6 = source_byte(ns + 6)
            let c7 = source_byte(ns + 7)
            let c8 = source_byte(ns + 8)
            let c9 = source_byte(ns + 9)
            if c0==73 && c1==77 && c2==80 && c3==95 && c4==70 && c5==78 && c6==65 && c7==77 && c8==69 && c9==95 {
                let c10 = source_byte(ns + 10)
                let c11 = source_byte(ns + 11)
                let c12 = source_byte(ns + 12)
                if c10==66 && c11==85 && c12==70 {
                    MB_IMP_FNAME_BUF_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
                }
                if c10==80 && c11==84 && c12==82 {
                    MB_IMP_FNAME_PTR_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
                }
            }
        }
        gi = gi + 1
    }
}

// ============================================================================
// Codegen: compile AST nodes
// ============================================================================

fn compile_node(node: i64) -> i64 with Mut, Panic, Div {
    if node == -1 {
        emit_mov_rax_imm(0)
        return 0
    }
    if node < 0 || node >= 32768 {
        print("BAD NODE node=")
        print_int(node)
        print("\n")
        return 0
    }
    let kind = ND_KIND[node as usize]
    let ival = ND_IVAL[node as usize]

    if kind == 1 {
        // NK_INT
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 4 {
        // NK_BOOL
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 3 {
        // NK_STR — emit string data inline (null-terminated), load address
        let soff = ND_STR_OFF[node as usize]
        let slen = ND_STR_LEN[node as usize]
        // JMP over the string data
        emit(0xEB)  // JMP rel8
        let jmp_pos = CODE_LEN
        emit(0x00)  // placeholder
        let str_addr = CODE_LEN
        // Emit string bytes + null terminator
        var si: i64 = 0
        while si < slen {
            let pool_idx = soff + si
            emit(POOL[(soff + si) as usize] as i64)
            si = si + 1
        }
        emit(0)  // null terminator for str_len compatibility
        // Patch jump
        let dist = CODE_LEN - jmp_pos - 1
        CODE[jmp_pos as usize] = dist as i8
        // LEA rax, [rip + offset_to_string]
        emit(0x48); emit(0x8D); emit(0x05)
        let rel = str_addr - (CODE_LEN + 4)
        emit_u32(rel)
        return 0
    }
    if kind == 2 {
        // NK_IDENT — load variable
        let voff = ND_STR_OFF[node as usize]
        let vlen = ND_STR_LEN[node as usize]
        let slot = find_local(voff, vlen)
        if slot >= 0 {
            emit_load_rax(slot)
        } else {
            let gi = mb_find_global(voff, vlen)
            if gi >= 0 {
                let gaddr = 0x700000 + MB_GL_OFF[gi as usize]
                // movabs rcx, gaddr
                emit(0x48); emit(0xB9); emit_u64(gaddr)
                if MB_GL_SZ[gi as usize] == 1 {
                    // movzx rax, byte [rcx]
                    emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
                } else {
                    // mov rax, [rcx]
                    emit(0x48); emit(0x8B); emit(0x01)
                }
            } else {
                emit_mov_rax_imm(0)
            }
        }
        return 0
    }
    if kind == 10 {
        // NK_BINOP
        let left = ND_LEFT[node as usize]
        let right = ND_RIGHT[node as usize]
        compile_node(right)
        let tmp = alloc_slot()
        emit_store_rax(tmp)
        compile_node(left)
        emit_load_rcx(tmp)
        // rax = left, rcx = right
        if ival == 0 { emit(0x48); emit(0x01); emit(0xC8) }       // add rax, rcx
        else if ival == 1 { emit(0x48); emit(0x29); emit(0xC8) }  // sub rax, rcx
        else if ival == 2 { emit(0x48); emit(0x0F); emit(0xAF); emit(0xC1) }  // imul rax, rcx
        else if ival == 3 {
            // div: rax / rcx -> cqo; idiv rcx
            emit(0x48); emit(0x99)  // cqo
            emit(0x48); emit(0xF7); emit(0xF9)  // idiv rcx
        }
        else if ival == 4 {
            // mod
            emit(0x48); emit(0x99)  // cqo
            emit(0x48); emit(0xF7); emit(0xF9)  // idiv rcx
            // remainder in rdx -> mov rax, rdx
            emit(0x48); emit(0x89); emit(0xD0)
        }
        else if ival == 5 {
            // eq: cmp rax, rcx; sete al; movzx rax, al
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x94); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 6 {
            // ne
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x95); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 7 {
            // lt
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9C); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 8 {
            // le
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9E); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 9 {
            // gt
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9F); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 10 {
            // ge
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9D); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 13 { emit(0x48); emit(0x21); emit(0xC8) }  // and rax, rcx
        else if ival == 14 { emit(0x48); emit(0x09); emit(0xC8) }  // or rax, rcx
        else if ival == 15 { emit(0x48); emit(0x31); emit(0xC8) }  // xor rax, rcx
        else if ival == 16 {
            // shl: mov cl byte already in rcx low
            emit(0x48); emit(0xD3); emit(0xE0)  // shl rax, cl
        }
        else if ival == 17 {
            // shr
            emit(0x48); emit(0xD3); emit(0xF8)  // sar rax, cl
        }
        else if ival == 11 {
            // logical and: both nonzero
            emit(0x48); emit(0x85); emit(0xC0)  // test rax, rax
            emit(0x0F); emit(0x95); emit(0xC0)  // setne al
            emit(0x48); emit(0x85); emit(0xC9)  // test rcx, rcx
            emit(0x0F); emit(0x95); emit(0xC1)  // setne cl
            emit(0x20); emit(0xC8)               // and al, cl
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)  // movzx rax, al
        }
        else if ival == 12 {
            // logical or
            emit(0x48); emit(0x09); emit(0xC8)  // or rax, rcx
            emit(0x48); emit(0x85); emit(0xC0)  // test rax, rax
            emit(0x0F); emit(0x95); emit(0xC0)  // setne al
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        return 0
    }
    if kind == 11 {
        // NK_UNARY
        let operand = ND_LEFT[node as usize]
        compile_node(operand)
        if ival == 1 {
            // negate
            emit(0x48); emit(0xF7); emit(0xD8)  // neg rax
        } else {
            // logical not: test rax; sete al; movzx
            emit(0x48); emit(0x85); emit(0xC0)
            emit(0x0F); emit(0x94); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        return 0
    }
    if kind == 13 {
        // NK_INDEX: arr[idx] — read
        let arr_nd = ND_LEFT[node as usize]
        let idx_nd = ND_RIGHT[node as usize]
        let avoff = ND_STR_OFF[arr_nd as usize]
        let avlen = ND_STR_LEN[arr_nd as usize]
        var asz: i64 = 1
        let aslot = find_local(avoff, avlen)
        if aslot >= 0 {
            let adisp = 0 - ((aslot + 1) * 8)
            // local holds a pointer — load it into rcx (byte access: asz=1)
            emit(0x48); emit(0x8B); emit(0x8D); emit_u32(adisp)  // mov rcx, [rbp+disp]
        } else {
            let agi = mb_find_global(avoff, avlen)
            if agi >= 0 {
                let gaaddr = 0x700000 + MB_GL_OFF[agi as usize]
                emit(0x48); emit(0xB9); emit_u64(gaaddr)  // movabs rcx, gaaddr
                asz = MB_GL_SZ[agi as usize]
            } else {
                emit(0x48); emit(0x31); emit(0xC9)  // xor rcx, rcx
            }
        }
        // save rcx (base) to a temp slot
        let idx_save = alloc_slot()
        emit(0x48); emit(0x89); emit(0x8D); emit_u32(0 - ((idx_save + 1) * 8))  // mov [rbp+disp], rcx
        // compile index → rax
        compile_node(idx_nd)
        // restore base into rcx
        emit(0x48); emit(0x8B); emit(0x8D); emit_u32(0 - ((idx_save + 1) * 8))  // mov rcx, [rbp+disp]
        // compute effective address
        if asz == 1 {
            emit(0x48); emit(0x01); emit(0xC1)               // add rcx, rax
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)   // movzx rax, byte [rcx]
        } else {
            emit(0x48); emit(0xC1); emit(0xE0); emit(0x03)   // shl rax, 3
            emit(0x48); emit(0x01); emit(0xC1)               // add rcx, rax
            emit(0x48); emit(0x8B); emit(0x01)               // mov rax, [rcx]
        }
        return 0
    }
    if kind == 12 {
        // NK_CALL
        let callee = ND_LEFT[node as usize]
        let c_off = ND_STR_OFF[callee as usize]
        let c_len = ND_STR_LEN[callee as usize]

        // Check for built-in print(str_lit)
        // str_len(s) — inline strlen: count bytes until null
        // Structure:
        //   mov rdi, rax           ; 3 bytes [A]
        //   xor rcx, rcx           ; 3 bytes [B]
        //   cmp byte [rdi+rcx], 0  ; 4 bytes [C] ← loop_start
        //   jz +5                  ; 2 bytes [D] → [H]
        //   inc rcx                ; 3 bytes [E]
        //   jmp -11                ; 2 bytes [F] → [C]
        //   mov rax, rcx           ; 3 bytes [H]
        // jz offset: skips [E](3) + [F](2) = 5 bytes ✓
        // jmp offset: from after [F] to [C] = -(4+2+3+2) = -11 ✓
        if pool_match(c_off, c_len, "str_len") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = str ptr
            emit(0x48); emit(0x89); emit(0xC7)  // [A] mov rdi, rax (3)
            emit(0x48); emit(0x31); emit(0xC9)  // [B] xor rcx, rcx (3)
            // [C] loop_start:
            emit(0x80); emit(0x3C); emit(0x0F); emit(0x00)  // [C] cmp byte [rdi+rcx], 0 (4)
            emit(0x74); emit(0x05)               // [D] jz +5 (2)
            emit(0x48); emit(0xFF); emit(0xC1)   // [E] inc rcx (3)
            emit(0xEB); emit(0 - 11)             // [F] jmp -11 → [C] (2)
            // [H] done:
            emit(0x48); emit(0x89); emit(0xC8)   // [H] mov rax, rcx (3)
            return 0
        }

        // str_char_at(s, i) — return byte at position i in string s
        if pool_match(c_off, c_len, "str_char_at") {
            let arg0 = ND_EXTRA[node as usize]
            var arg1: i64 = -1
            if arg0 != -1 { arg1 = ND_EXTRA[arg0 as usize] }
            // compile both args using temp slots
            let s0 = alloc_slot()
            let s1 = alloc_slot()
            if arg0 != -1 { compile_node(arg0); emit_store_rax(s0) }
            if arg1 != -1 { compile_node(arg1); emit_store_rax(s1) }
            emit_load_rax(s0)
            emit(0x48); emit(0x89); emit(0xC7)  // mov rdi, rax (str ptr)
            emit_load_rax(s1)
            emit(0x48); emit(0x89); emit(0xC6)  // mov rsi, rax (index)
            // movzx rax, byte [rdi + rsi]
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x04); emit(0x37)
            return 0
        }

        if pool_match(c_off, c_len, "print") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                let slen = ND_STR_LEN[arg as usize]
                compile_node(arg)           // rax = string pointer (from LEA)
                // mov rsi, rax  (buf)
                emit(0x48); emit(0x89); emit(0xC6)
                // mov edx, slen  (count; zero-extends to rdx)
                emit(0xBA); emit_u32(slen)
                // mov edi, 1  (fd = stdout; zero-extends to rdi)
                emit(0xBF); emit_u32(1)
                // mov eax, 1  (SYS_write; zero-extends to rax)
                emit(0xB8); emit_u32(1)
                // syscall
                emit(0x0F); emit(0x05)
            }
            emit_mov_rax_imm(0)
            return 0
        }

        // Check for built-in print_int
        if pool_match(c_off, c_len, "print_int") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)           // rax = integer value
            }
            // mov rdi, rax  (pass arg in rdi per System V ABI)
            emit(0x48); emit(0x89); emit(0xC7)
            // call print_int helper (rel32 backward to PRINT_INT_OFF)
            emit(0xE8)
            let rel = PRINT_INT_OFF - (CODE_LEN + 4)
            emit_u32(rel)
            return 0
        }

        // Check for built-in exit
        if pool_match(c_off, c_len, "exit") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)
            }
            // mov rdi, rax; mov rax, 60; syscall
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0xC7); emit(0xC0); emit_u32(60)
            emit(0x0F); emit(0x05)
            return 0
        }

        // arg_count() — reads from saved rsp at BSS base 0x700000
        // [0x700000] = rsp at entry = &argc; *rsp = argc; return argc - 1 (skip argv[0])
        if pool_match(c_off, c_len, "arg_count") {
            // movabs rax, 0x700000
            emit(0x48); emit(0xB8); emit_u64(0x700000)
            // mov rax, [rax]    ; rax = saved rsp
            emit(0x48); emit(0x8B); emit(0x00)
            // mov rax, [rax]    ; rax = argc
            emit(0x48); emit(0x8B); emit(0x00)
            // dec rax           ; argc - 1 (exclude argv[0] = program name)
            emit(0x48); emit(0xFF); emit(0xC8)
            return 0
        }

        // get_arg(n) — returns argv[n+1] (0-indexed, skipping program name)
        if pool_match(c_off, c_len, "get_arg") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = n
            // add rax, 2  (n+2 to get to argv[n+1] as qword index from &argc)
            emit(0x48); emit(0x83); emit(0xC0); emit(2)
            // mov rdx, rax   (save n+2 in rdx, no push/pop needed)
            emit(0x48); emit(0x89); emit(0xC2)
            // movabs rcx, 0x700000
            emit(0x48); emit(0xB9); emit_u64(0x700000)
            // mov rcx, [rcx]    ; rcx = saved rsp = &argc
            emit(0x48); emit(0x8B); emit(0x09)
            // mov rax, [rcx + rdx*8]  ; argv[n+1]
            emit(0x48); emit(0x8B); emit(0x04); emit(0xD1)
            return 0
        }

        // file_size(path) — open + fstat + close; returns file size in rax
        // Mirrors boot2 file_size: open→mov rdi,rax(fd)→sub rsp,176→mov rsi,rsp→push rdi→fstat→read st_size→close
        if pool_match(c_off, c_len, "file_size") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = path ptr
            // open(path, 0, 0) → rax = fd
            emit(0x48); emit(0x89); emit(0xC7)    // mov rdi, rax (path)
            emit(0x48); emit(0x31); emit(0xF6)    // xor rsi, rsi
            emit(0x48); emit(0x31); emit(0xD2)    // xor rdx, rdx
            emit(0xB8); emit_u32(2)               // mov eax, 2 (SYS_open)
            emit(0x0F); emit(0x05)                // syscall → rax = fd
            // mov rdi, rax  (fd into rdi for fstat)
            emit(0x48); emit(0x89); emit(0xC7)
            // sub rsp, 176  (allocate stat buffer)
            emit(0x48); emit(0x81); emit(0xEC); emit_u32(176)
            // mov rsi, rsp  (rsi = &stat_buf)
            emit(0x48); emit(0x89); emit(0xE6)
            // push rdi  (save fd)
            emit(0x57)
            // fstat(fd, &stat_buf) → rax = 0 on success
            emit(0xB8); emit_u32(5)               // mov eax, 5 (SYS_fstat)
            emit(0x0F); emit(0x05)
            // st_size is at stat+48 bytes; after push rdi, rsp is at (buf_base - 8)
            // so stat_buf starts at [rsp+8], and st_size is at [rsp+8+48] = [rsp+56]
            emit(0x48); emit(0x8B); emit(0x44); emit(0x24); emit(56)  // mov rax, [rsp+56]
            // push rax  (save file size)
            emit(0x50)
            // mov rdi, [rsp+8]  (fd is at [rsp+8] now: top=size, next=old_rdi(=fd))
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)
            // close(fd)
            emit(0xB8); emit_u32(3)               // mov eax, 3 (SYS_close)
            emit(0x0F); emit(0x05)
            // pop rax  (file size)
            emit(0x58)
            // cleanup: add rsp, 184 (176 + 8 for push rdi)
            emit(0x48); emit(0x81); emit(0xC4); emit_u32(184)
            return 0
        }

        // read_file(path) — mmap anonymous, open, read, close; returns ptr in rax
        if pool_match(c_off, c_len, "read_file") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = path ptr
            // push rax (save path)
            emit(0x50)
            // mmap(NULL, 1MB, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
            emit(0x48); emit(0x31); emit(0xFF)    // xor rdi, rdi
            emit(0x48); emit(0xBE); emit_u64(1048576)  // mov rsi, 1048576
            emit(0xBA); emit_u32(3)               // mov edx, 3 (PROT_R|W)
            emit(0x41); emit(0xBA); emit_u32(0x22) // mov r10d, MAP_PRIVATE|MAP_ANON
            emit(0x49); emit(0xC7); emit(0xC0); emit_u32(0 - 1)  // mov r8, -1
            emit(0x4D); emit(0x31); emit(0xC9)    // xor r9, r9
            emit(0xB8); emit_u32(9)               // mov eax, 9 (SYS_mmap)
            emit(0x0F); emit(0x05)
            // push mmap ptr (buf)
            emit(0x50)
            // open path
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)  // mov rdi, [rsp+8] (path)
            emit(0x48); emit(0x31); emit(0xF6)    // xor rsi, rsi
            emit(0x48); emit(0x31); emit(0xD2)    // xor rdx, rdx
            emit(0xB8); emit_u32(2)               // mov eax, 2 (SYS_open)
            emit(0x0F); emit(0x05)
            // rax = fd; push fd
            emit(0x50)
            // read(fd, buf, 1MB) — stack: [rsp]=fd, [rsp+8]=buf, [rsp+16]=path
            emit(0x48); emit(0x8B); emit(0x3C); emit(0x24)            // mov rdi, [rsp] (fd)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(8)  // mov rsi, [rsp+8] (buf)
            emit(0x48); emit(0xBA); emit_u64(1048576)  // mov rdx, 1048576
            emit(0xB8); emit_u32(0)               // mov eax, 0 (SYS_read)
            emit(0x0F); emit(0x05)
            // close(fd)
            emit(0x5F)                            // pop rdi (fd)
            emit(0xB8); emit_u32(3)               // mov eax, 3 (SYS_close)
            emit(0x0F); emit(0x05)
            // pop buf ptr into rax
            emit(0x58)                             // pop rax (buf)
            // cleanup: add rsp, 8 (path push)
            emit(0x48); emit(0x83); emit(0xC4); emit(8)
            return 0
        }

        // write_file(path, data, len) — open create+trunc, write, close
        if pool_match(c_off, c_len, "write_file") {
            // compile 3 args and push them (path, data, len)
            // arg1 (data) must be the BASE ADDRESS of an array global — emit movabs rax, gaddr
            var wf_argc: i64 = 0
            var wf_node = ND_EXTRA[node as usize]
            while wf_node != -1 && wf_argc < 3 {
                if wf_argc == 1 && ND_KIND[wf_node as usize] == 2 {
                    // arg1 is array pointer: emit address of global, not byte load
                    let wf_voff = ND_STR_OFF[wf_node as usize]
                    let wf_vlen = ND_STR_LEN[wf_node as usize]
                    let wf_gi = mb_find_global(wf_voff, wf_vlen)
                    if wf_gi >= 0 {
                        let wf_gaddr = 0x700000 + MB_GL_OFF[wf_gi as usize]
                        emit_mov_rax_imm(wf_gaddr)  // rax = base address of array
                    } else {
                        compile_node(wf_node)
                    }
                } else {
                    compile_node(wf_node)
                }
                emit(0x50)  // push rax
                wf_argc = wf_argc + 1
                wf_node = ND_EXTRA[wf_node as usize]
            }
            // stack: [rsp]=len [rsp+8]=data [rsp+16]=path
            // pop len→rcx, pop data→rsi, pop path→rdi
            emit(0x59)  // pop rcx (len)
            emit(0x5E)  // pop rsi (data)
            emit(0x5F)  // pop rdi (path)
            // push rcx (len), push rsi (data) for later
            emit(0x51); emit(0x56)
            // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
            emit(0x48); emit(0xBE); emit_u64(0x241)  // mov rsi, O_WRONLY|O_CREAT|O_TRUNC
            emit(0xBA); emit_u32(420)                  // mov edx, 0644
            emit(0xB8); emit_u32(2)                    // mov eax, SYS_open
            emit(0x0F); emit(0x05)
            // rax = fd; write(fd, data, len)
            emit(0x48); emit(0x89); emit(0xC7)         // mov rdi, rax (fd)
            emit(0x57)                                  // push rdi (save fd)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(8)  // mov rsi, [rsp+8] (data)
            emit(0x48); emit(0x8B); emit(0x54); emit(0x24); emit(16) // mov rdx, [rsp+16] (len)
            emit(0xB8); emit_u32(1)                    // mov eax, SYS_write
            emit(0x0F); emit(0x05)
            // close(fd)
            emit(0x5F)                                  // pop rdi (fd)
            emit(0xB8); emit_u32(3)                    // mov eax, SYS_close
            emit(0x0F); emit(0x05)
            // cleanup: add rsp, 16 (data+len pushes)
            emit(0x48); emit(0x83); emit(0xC4); emit(16)
            emit_mov_rax_imm(0)
            return 0
        }

        // load_source(path) — native builtin: open+mmap+read, store buf to SRC_BUF global, size to SRC_LEN
        // Only active when compiling source that has SRC_BUF/SRC_LEN globals (e.g. micro_bootstrap itself)
        if pool_match(c_off, c_len, "load_source") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = path ptr
            // open(path, O_RDONLY, 0) → fd in rax
            emit(0x48); emit(0x89); emit(0xC7)    // mov rdi, rax (path)
            emit(0x48); emit(0x31); emit(0xF6)    // xor rsi, rsi
            emit(0x48); emit(0x31); emit(0xD2)    // xor rdx, rdx
            emit(0xB8); emit_u32(2)               // mov eax, 2 (SYS_open)
            emit(0x0F); emit(0x05)                // syscall → rax = fd
            emit(0x50)                            // push rax (save fd)
            // mmap(NULL, 1MB, PROT_RW, MAP_PRIV|MAP_ANON, -1, 0) → buf
            emit(0x48); emit(0x31); emit(0xFF)    // xor rdi, rdi
            emit(0x48); emit(0xBE); emit_u64(1048576)  // mov rsi, 1MB
            emit(0xBA); emit_u32(3)               // mov edx, 3 PROT_RW
            emit(0x41); emit(0xBA); emit_u32(0x22) // mov r10d, MAP_PRIV|MAP_ANON
            emit(0x49); emit(0xC7); emit(0xC0); emit_u32(0 - 1)  // mov r8, -1
            emit(0x4D); emit(0x31); emit(0xC9)    // xor r9, r9
            emit(0xB8); emit_u32(9)               // mov eax, 9 SYS_mmap
            emit(0x0F); emit(0x05)                // syscall → rax = buf
            emit(0x50)                            // push rax (save buf)
            // read(fd, buf, 1MB) → bytes read in rax
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)   // mov rdi, [rsp+8] (fd)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(0)   // mov rsi, [rsp] (buf)
            emit(0x48); emit(0xBA); emit_u64(1048576)                  // mov rdx, 1MB
            emit(0xB8); emit_u32(0)               // mov eax, 0 SYS_read
            emit(0x0F); emit(0x05)                // syscall → rax = bytes read
            emit(0x50)                            // push rax (save sz)
            // close(fd)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(16)  // mov rdi, [rsp+16] (fd)
            emit(0xB8); emit_u32(3)               // mov eax, 3 SYS_close
            emit(0x0F); emit(0x05)
            // pop sz, pop buf, pop fd
            emit(0x58)                            // pop rax (sz)
            emit(0x59)                            // pop rcx (buf)
            emit(0x5A)                            // pop rdx (fd, discard)
            // store buf to SRC_BUF global
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_BUF_GADDR)       // movabs rdx, SRC_BUF_addr
            emit(0x48); emit(0x89); emit(0x0A)                         // mov [rdx], rcx
            // store sz to SRC_LEN global
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_LEN_GADDR)       // movabs rdx, SRC_LEN_addr
            emit(0x48); emit(0x89); emit(0x02)                         // mov [rdx], rax
            return 0
        }

        // append_source_file(path) — open+read, append to SRC_BUF at SRC_LEN, update SRC_LEN+1 ('\n')
        // Stack during: [rsp]=fd [rsp+8]=path; then pushes bytes_read on top
        if pool_match(c_off, c_len, "append_source_file") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }   // rax = path ptr
            emit(0x50)                              // push path
            // open(path, O_RDONLY, 0) → fd
            emit(0x48); emit(0x89); emit(0xC7)     // mov rdi, rax
            emit(0x48); emit(0x31); emit(0xF6)     // xor rsi, rsi
            emit(0x48); emit(0x31); emit(0xD2)     // xor rdx, rdx
            emit(0xB8); emit_u32(2)                // mov eax, 2 SYS_open
            emit(0x0F); emit(0x05)                 // syscall → fd
            emit(0x50)                             // push fd  [rsp]=fd [rsp+8]=path
            // guard: if fd < 0 (open failed), skip read/write block (102 bytes) → land at add rsp,16
            emit(0x48); emit(0x85); emit(0xC0)   // test rax, rax
            emit(0x78); emit(0x66)               // js +102 (0x66=102)
            // r9 = SRC_LEN
            emit(0x49); emit(0xB9); emit_u64(MB_SRC_LEN_GADDR)   // movabs r9, SRC_LEN_addr
            emit(0x4D); emit(0x8B); emit(0x09)                    // mov r9, [r9]
            // r10 = SRC_BUF + SRC_LEN
            emit(0x4D); emit(0xBA); emit_u64(MB_SRC_BUF_GADDR)   // movabs r10, SRC_BUF_addr
            emit(0x4D); emit(0x8B); emit(0x12)                    // mov r10, [r10]
            emit(0x4D); emit(0x01); emit(0xCA)                    // add r10, r9
            // read(fd, r10, 1MB-r9) → rax = bytes_read
            emit(0x48); emit(0x8B); emit(0x3C); emit(0x24)        // mov rdi, [rsp] (fd)
            emit(0x4C); emit(0x89); emit(0xD6)                    // mov rsi, r10
            emit(0x48); emit(0xBA); emit_u64(1048576)             // movabs rdx, 1048576
            emit(0x4C); emit(0x29); emit(0xCA)                    // sub rdx, r9
            emit(0xB8); emit_u32(0)                               // mov eax, 0 SYS_read
            emit(0x0F); emit(0x05)                                // syscall → bytes_read
            emit(0x50)                                            // push bytes_read
            // write '\n' separator at r10+bytes_read
            emit(0x4D); emit(0x89); emit(0xD3)                    // mov r11, r10
            emit(0x4C); emit(0x03); emit(0x1C); emit(0x24)        // add r11, [rsp]
            emit(0x41); emit(0xC6); emit(0x03); emit(0x0A)        // mov byte [r11], '\n'
            // SRC_LEN = r9 + bytes_read + 1
            emit(0x4C); emit(0x03); emit(0x0C); emit(0x24)        // add r9, [rsp]
            emit(0x49); emit(0xFF); emit(0xC1)                    // inc r9
            emit(0x48); emit(0xB9); emit_u64(MB_SRC_LEN_GADDR)   // movabs rcx, SRC_LEN_addr
            emit(0x4C); emit(0x89); emit(0x09)                    // mov [rcx], r9
            // close(fd), preserve bytes_read
            emit(0x58)                                            // pop rax (bytes_read)
            emit(0x48); emit(0x8B); emit(0x3C); emit(0x24)        // mov rdi, [rsp] (fd)
            emit(0x50)                                            // push rax (re-push bytes_read)
            emit(0xB8); emit_u32(3)                               // mov eax, 3 SYS_close
            emit(0x0F); emit(0x05)                                // syscall
            emit(0x58)                                            // pop rax (bytes_read)
            emit(0x48); emit(0x83); emit(0xC4); emit(16)          // add rsp, 16 (discard fd,path)
            return 0
        }

        // init_imp_fname_ptr() — sets IMP_FNAME_PTR = BSS address of IMP_FNAME_BUF
        if pool_match(c_off, c_len, "init_imp_fname_ptr") && MB_IMP_FNAME_BUF_GADDR != 0 && MB_IMP_FNAME_PTR_GADDR != 0 {
            emit(0x48); emit(0xB8); emit_u64(MB_IMP_FNAME_BUF_GADDR)  // movabs rax, IMP_FNAME_BUF_addr
            emit(0x48); emit(0xB9); emit_u64(MB_IMP_FNAME_PTR_GADDR)  // movabs rcx, IMP_FNAME_PTR_addr
            emit(0x48); emit(0x89); emit(0x01)                         // mov [rcx], rax
            return 0
        }

        // source_byte(idx) — native builtin: read byte from SRC_BUF[idx]
        if pool_match(c_off, c_len, "source_byte") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }  // rax = idx
            // movabs rcx, SRC_BUF_addr
            emit(0x48); emit(0xB9); emit_u64(MB_SRC_BUF_GADDR)
            // mov rcx, [rcx]   (rcx = buf ptr)
            emit(0x48); emit(0x8B); emit(0x09)
            // add rcx, rax     (ptr + idx)
            emit(0x48); emit(0x01); emit(0xC1)
            // movzx rax, byte [rcx]
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
            return 0
        }

        // Generic function call
        // Push args to stack, then CALL
        // Count args
        var argc: i64 = 0
        var arg_node = ND_EXTRA[node as usize]
        // First compile all args and store to temp slots (up to 4 args)
        var arg_slot0: i64 = 0
        var arg_slot1: i64 = 0
        var arg_slot2: i64 = 0
        var arg_slot3: i64 = 0
        while arg_node != -1 && argc < 4 {
            compile_node(arg_node)
            let s = alloc_slot()
            emit_store_rax(s)
            if argc == 0 { arg_slot0 = s }
            else if argc == 1 { arg_slot1 = s }
            else if argc == 2 { arg_slot2 = s }
            else { arg_slot3 = s }
            argc = argc + 1
            arg_node = ND_EXTRA[arg_node as usize]
        }
        // Load args into registers (System V: rdi, rsi, rdx, rcx, r8, r9)
        if argc > 0 {
            emit_load_rax(arg_slot0)
            emit(0x48); emit(0x89); emit(0xC7)  // mov rdi, rax
        }
        if argc > 1 {
            emit_load_rax(arg_slot1)
            emit(0x48); emit(0x89); emit(0xC6)  // mov rsi, rax
        }
        if argc > 2 {
            emit_load_rax(arg_slot2)
            emit(0x48); emit(0x89); emit(0xC2)  // mov rdx, rax
        }
        if argc > 3 {
            emit_load_rax(arg_slot3)
            emit(0x48); emit(0x89); emit(0xC1)  // mov rcx, rax
        }

        // Emit CALL with fixup
        let fn_idx = find_fn_by_name(c_off, c_len)
        emit(0xE8)
        let fix_pos = CODE_LEN
        emit_u32(0)  // placeholder
        if fn_idx >= 0 {
            FIX_OFF[FIX_COUNT as usize] = fix_pos
            FIX_TARGET[FIX_COUNT as usize] = fn_idx
            FIX_COUNT = FIX_COUNT + 1
        }
        return 0
    }
    if kind == 33 {
        // NK_BLOCK — compile all statements in the linked list
        var stmt = ND_LEFT[node as usize]
        while stmt != -1 {
            let next = ND_RIGHT[stmt as usize]
            compile_node(stmt)
            stmt = next
        }
        return 0
    }
    if kind == 40 || kind == 41 {
        // NK_LET / NK_VAR
        let name_off = ND_STR_OFF[node as usize]
        let name_len = ND_STR_LEN[node as usize]
        let init = ND_LEFT[node as usize]
        if init != -1 && ND_KIND[init as usize] == 50 {
            // NK_ARRAY_LIT: allocate N consecutive slots, store base address in name slot
            let arr_count = ND_IVAL[init as usize]
            // allocate the name slot first (holds pointer)
            let ptr_slot = add_local(name_off, name_len)
            // allocate N data slots (consecutive)
            var ai: i64 = 0
            while ai < arr_count {
                alloc_slot()
                ai = ai + 1
            }
            // compute address of first data slot = rbp - (ptr_slot + 2)*8
            let data_disp = 0 - ((ptr_slot + 2) * 8)
            // lea rax, [rbp + data_disp]
            emit(0x48); emit(0x8D); emit(0x85); emit_u32(data_disp)
            emit_store_rax(ptr_slot)
            // zero-initialize: fill N slots with 0
            // fill_val from ND_LEFT[init] — compile it for each slot
            // (simpler: just zero the slots since fill_val is usually 0)
            var zi: i64 = 0
            while zi < arr_count {
                let zdisp = 0 - ((ptr_slot + 2 + zi) * 8)
                compile_node(ND_LEFT[init as usize])  // fill value
                emit(0x48); emit(0x89); emit(0x85); emit_u32(zdisp)  // mov [rbp+disp], rax
                zi = zi + 1
            }
        } else {
            compile_node(init)
            let slot = add_local(name_off, name_len)
            emit_store_rax(slot)
        }
        return 0
    }
    if kind == 42 {
        // NK_ASSIGN
        let target = ND_LEFT[node as usize]
        let rhs = ND_EXTRA[node as usize]
        let tk2 = ND_KIND[target as usize]
        if tk2 == 2 {
            // Assign to scalar variable (local or global)
            compile_node(rhs)
            let voff2 = ND_STR_OFF[target as usize]
            let vlen2 = ND_STR_LEN[target as usize]
            let slot2 = find_local(voff2, vlen2)
            if slot2 >= 0 {
                emit_store_rax(slot2)
            } else {
                let gi2 = mb_find_global(voff2, vlen2)
                if gi2 >= 0 {
                    let gaddr2 = 0x700000 + MB_GL_OFF[gi2 as usize]
                    let gsave2 = alloc_slot()
                    emit_store_rax(gsave2)                        // mov [rbp-(gsave2+1)*8], rax
                    emit(0x48); emit(0xB9); emit_u64(gaddr2)      // movabs rcx, addr
                    emit_load_rax(gsave2)                         // mov rax, [rbp-(gsave2+1)*8]
                    if MB_GL_SZ[gi2 as usize] == 1 {
                        emit(0x88); emit(0x01)                    // mov [rcx], al
                    } else {
                        emit(0x48); emit(0x89); emit(0x01)        // mov [rcx], rax
                    }
                }
            }
        } else if tk2 == 13 {
            // Assign to arr[idx] — compile rhs first
            compile_node(rhs)
            // save value in temp slot
            let val_save = alloc_slot()
            emit_store_rax(val_save)
            // get array base address into rcx
            let arr_nd2 = ND_LEFT[target as usize]
            let idx_nd2 = ND_RIGHT[target as usize]
            let avoff2 = ND_STR_OFF[arr_nd2 as usize]
            let avlen2 = ND_STR_LEN[arr_nd2 as usize]
            var asz2: i64 = 8
            let aslot2 = find_local(avoff2, avlen2)
            if aslot2 >= 0 {
                let adisp2 = 0 - ((aslot2 + 1) * 8)
                // local holds a pointer — load it into rcx
                emit(0x48); emit(0x8B); emit(0x8D); emit_u32(adisp2)  // mov rcx, [rbp+disp]
            } else {
                let agi2 = mb_find_global(avoff2, avlen2)
                if agi2 >= 0 {
                    let gaaddr2 = 0x700000 + MB_GL_OFF[agi2 as usize]
                    emit(0x48); emit(0xB9); emit_u64(gaaddr2)           // movabs rcx, base
                    asz2 = MB_GL_SZ[agi2 as usize]
                } else {
                    emit(0x48); emit(0x31); emit(0xC9)                  // xor rcx, rcx
                }
            }
            // save base into another temp slot
            let base_save = alloc_slot()
            emit(0x48); emit(0x89); emit(0x8D); emit_u32(0 - ((base_save + 1) * 8))  // mov [rbp+disp], rcx
            // compile index → rax
            compile_node(idx_nd2)
            // restore base into rcx
            emit(0x48); emit(0x8B); emit(0x8D); emit_u32(0 - ((base_save + 1) * 8))  // mov rcx, [rbp+disp]
            // compute effective address in rcx
            if asz2 == 1 {
                emit(0x48); emit(0x01); emit(0xC1)                      // add rcx, rax
            } else {
                emit(0x48); emit(0xC1); emit(0xE0); emit(0x03)          // shl rax, 3
                emit(0x48); emit(0x01); emit(0xC1)                      // add rcx, rax
            }
            // load value → rdx
            emit(0x48); emit(0x8B); emit(0x95); emit_u32(0 - ((val_save + 1) * 8))  // mov rdx, [rbp+disp]
            // store
            if asz2 == 1 {
                emit(0x88); emit(0x11)                                   // mov [rcx], dl
            } else {
                emit(0x48); emit(0x89); emit(0x11)                       // mov [rcx], rdx
            }
        }
        return 0
    }
    if kind == 43 {
        // NK_EXPR_STMT
        let expr = ND_LEFT[node as usize]
        compile_node(expr)
        return 0
    }
    if kind == 34 {
        // NK_RETURN
        let val = ND_LEFT[node as usize]
        compile_node(val)
        emit_epilogue()
        return 0
    }
    if kind == 30 {
        // NK_IF
        let cond = ND_LEFT[node as usize]
        let then_body = ND_EXTRA[node as usize]
        let else_body = ND_EXTRA2[node as usize]
        compile_node(cond)
        // test rax, rax
        emit(0x48); emit(0x85); emit(0xC0)
        // je else_label (JE rel32)
        emit(0x0F); emit(0x84)
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(then_body)
        if else_body != -1 {
            // jmp end_label
            emit(0xE9)
            let jmp_pos = CODE_LEN
            emit_u32(0)
            // Patch je to here
            let else_off = CODE_LEN - je_pos - 4
            CODE[je_pos as usize] = (else_off & 0xFF) as i8
            CODE[(je_pos + 1) as usize] = ((else_off >> 8) & 0xFF) as i8
            CODE[(je_pos + 2) as usize] = ((else_off >> 16) & 0xFF) as i8
            CODE[(je_pos + 3) as usize] = ((else_off >> 24) & 0xFF) as i8
            compile_node(else_body)
            // Patch jmp to here
            let end_off = CODE_LEN - jmp_pos - 4
            CODE[jmp_pos as usize] = (end_off & 0xFF) as i8
            CODE[(jmp_pos + 1) as usize] = ((end_off >> 8) & 0xFF) as i8
            CODE[(jmp_pos + 2) as usize] = ((end_off >> 16) & 0xFF) as i8
            CODE[(jmp_pos + 3) as usize] = ((end_off >> 24) & 0xFF) as i8
        } else {
            // Patch je to here
            let skip_off = CODE_LEN - je_pos - 4
            CODE[je_pos as usize] = (skip_off & 0xFF) as i8
            CODE[(je_pos + 1) as usize] = ((skip_off >> 8) & 0xFF) as i8
            CODE[(je_pos + 2) as usize] = ((skip_off >> 16) & 0xFF) as i8
            CODE[(je_pos + 3) as usize] = ((skip_off >> 24) & 0xFF) as i8
        }
        return 0
    }
    if kind == 31 {
        // NK_WHILE — save/restore LOOP_TOP for nested loops; handle break fixups
        let cond = ND_LEFT[node as usize]
        let body = ND_EXTRA[node as usize]
        let prev_loop_top = LOOP_TOP
        let prev_break_count = BREAK_FIXUP_COUNT
        let loop_top = CODE_LEN
        LOOP_TOP = loop_top
        compile_node(cond)
        emit(0x48); emit(0x85); emit(0xC0)  // test rax, rax
        emit(0x0F); emit(0x84)              // je exit
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(body)
        // jmp loop_top
        emit(0xE9)
        let jmp_rel = loop_top - (CODE_LEN + 4)
        emit_u32(jmp_rel)
        // loop exit point
        let loop_exit = CODE_LEN
        // Patch je to here
        let exit_off = loop_exit - je_pos - 4
        CODE[je_pos as usize] = (exit_off & 0xFF) as i8
        CODE[(je_pos + 1) as usize] = ((exit_off >> 8) & 0xFF) as i8
        CODE[(je_pos + 2) as usize] = ((exit_off >> 16) & 0xFF) as i8
        CODE[(je_pos + 3) as usize] = ((exit_off >> 24) & 0xFF) as i8
        // Patch all break fixups emitted inside this loop
        var bfi: i64 = prev_break_count
        while bfi < BREAK_FIXUP_COUNT {
            let bpos = BREAK_FIXUP_OFF[bfi as usize]
            let brel = loop_exit - bpos - 4
            CODE[bpos as usize] = (brel & 0xFF) as i8
            CODE[(bpos + 1) as usize] = ((brel >> 8) & 0xFF) as i8
            CODE[(bpos + 2) as usize] = ((brel >> 16) & 0xFF) as i8
            CODE[(bpos + 3) as usize] = ((brel >> 24) & 0xFF) as i8
            bfi = bfi + 1
        }
        BREAK_FIXUP_COUNT = prev_break_count  // restore for outer loops
        LOOP_TOP = prev_loop_top
        return 0
    }
    if kind == 35 {
        // NK_BREAK — emit forward JMP, record for patch after loop exit
        emit(0xE9)
        let brk_pos = CODE_LEN
        emit_u32(0)  // placeholder, patched after loop
        let bfi = BREAK_FIXUP_COUNT
        BREAK_FIXUP_OFF[bfi as usize] = brk_pos
        BREAK_FIXUP_COUNT = BREAK_FIXUP_COUNT + 1
        return 0
    }
    if kind == 36 {
        // NK_CONTINUE — jump back to current loop top
        if LOOP_TOP > 0 {
            emit(0xE9)
            let cont_rel = LOOP_TOP - (CODE_LEN + 4)
            emit_u32(cont_rel)
        }
        return 0
    }
    // Default: nop
    0
}

fn compile_fn(fn_idx: i64) with Mut, Panic, Div {
    FN_CODE_OFF[fn_idx as usize] = CODE_LEN
    locals_reset()
    emit_prologue()

    // Set up params as locals (passed in rdi, rsi, rdx, rcx, r8, r9)
    let pcount = FN_PARAM_COUNT[fn_idx as usize]
    let pbase = FN_PARAM_BASE[fn_idx as usize]
    if pcount > 0 {
        // param 0 from rdi: mov [rbp-8], rdi
        let s0 = add_local(FN_PARAM_NAME_OFF[pbase as usize], FN_PARAM_NAME_LEN[pbase as usize])
        emit(0x48); emit(0x89); emit(0xBD)  // mov [rbp+disp32], rdi
        emit_u32(0 - ((s0 + 1) * 8))
    }
    if pcount > 1 {
        let s1 = add_local(FN_PARAM_NAME_OFF[(pbase + 1) as usize], FN_PARAM_NAME_LEN[(pbase + 1) as usize])
        emit(0x48); emit(0x89); emit(0xB5)  // mov [rbp+disp32], rsi
        emit_u32(0 - ((s1 + 1) * 8))
    }
    if pcount > 2 {
        let s2 = add_local(FN_PARAM_NAME_OFF[(pbase + 2) as usize], FN_PARAM_NAME_LEN[(pbase + 2) as usize])
        emit(0x48); emit(0x89); emit(0x95)  // mov [rbp+disp32], rdx
        emit_u32(0 - ((s2 + 1) * 8))
    }
    if pcount > 3 {
        let s3 = add_local(FN_PARAM_NAME_OFF[(pbase + 3) as usize], FN_PARAM_NAME_LEN[(pbase + 3) as usize])
        emit(0x48); emit(0x89); emit(0x8D)  // mov [rbp+disp32], rcx
        emit_u32(0 - ((s3 + 1) * 8))
    }
    let body = FN_BODY_NODE[fn_idx as usize]
    compile_node(body)
    emit_epilogue()
}

// ============================================================================
// ELF writer
// ============================================================================

var ELF: [i8; 524288] = [0; 524288]
var ELF_LEN: i64 = 0

fn elf_emit(b: i64) with Mut, Panic {
    ELF[ELF_LEN as usize] = b as i8
    ELF_LEN = ELF_LEN + 1
}

fn elf_emit_u16(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
}

fn elf_emit_u32(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
    elf_emit((v >> 16) & 0xFF)
    elf_emit((v >> 24) & 0xFF)
}

fn elf_emit_u64(v: i64) with Mut, Panic {
    elf_emit_u32(v)
    elf_emit_u32(v >> 32)
}

fn write_elf(entry_fn: i64) with Mut, Panic, Div {
    let base_addr: i64 = 0x400000
    let text_off: i64 = 4096

    // ELF header (64 bytes)
    elf_emit(0x7F); elf_emit(0x45); elf_emit(0x4C); elf_emit(0x46)  // magic
    elf_emit(2)   // 64-bit
    elf_emit(1)   // little endian
    elf_emit(1)   // ELF version
    elf_emit(0)   // OS/ABI
    // padding 8 bytes
    var pi: i64 = 0
    while pi < 8 { elf_emit(0); pi = pi + 1 }
    elf_emit_u16(2)   // ET_EXEC
    elf_emit_u16(0x3E) // x86_64
    elf_emit_u32(1)    // version
    // entry point: base_addr + text_off
    elf_emit_u64(base_addr + text_off)
    elf_emit_u64(64)   // phdr offset
    elf_emit_u64(0)    // shdr offset
    elf_emit_u32(0)    // flags
    elf_emit_u16(64)   // ehdr size
    elf_emit_u16(56)   // phdr entry size
    // Always emit 2 PHDRs: code (RX) + BSS (RW)
    // BSS at 0x700000 always has at least 8 bytes for saved-rsp slot
    elf_emit_u16(2)
    elf_emit_u16(0)    // shdr entry size
    elf_emit_u16(0)    // shdr count
    elf_emit_u16(0)    // shstrndx

    // Program header 0: PT_LOAD RX (code)
    let total_size = text_off + CODE_LEN
    elf_emit_u32(1)    // PT_LOAD
    elf_emit_u32(5)    // PF_R | PF_X
    elf_emit_u64(0)    // offset
    elf_emit_u64(base_addr)  // vaddr
    elf_emit_u64(base_addr)  // paddr
    elf_emit_u64(total_size)  // filesz
    elf_emit_u64(total_size)  // memsz
    elf_emit_u64(0x1000)      // align

    // Program header 1: PT_LOAD RW (BSS at 0x700000)
    // BSS size = user globals + 8 bytes for saved-rsp slot (always >= 8)
    let bss_size = if MB_BSS_TOTAL > 0 { MB_BSS_TOTAL + 4096 } else { 4096 }
    elf_emit_u32(1)             // PT_LOAD
    elf_emit_u32(6)             // PF_R | PF_W
    elf_emit_u64(total_size)    // file offset (past code, filesz=0)
    elf_emit_u64(0x700000)      // vaddr
    elf_emit_u64(0x700000)      // paddr
    elf_emit_u64(0)             // filesz (BSS: no file data)
    elf_emit_u64(bss_size)      // memsz (zero-initialized by loader)
    elf_emit_u64(0x1000)        // align

    // Pad to text_off
    while ELF_LEN < text_off {
        elf_emit(0)
    }

    // Entry trampoline: save rsp for arg builtins, call main, then exit
    // Find "main" function
    let main_off = FN_CODE_OFF[entry_fn as usize]
    // Trampoline layout:
    //   movabs rdx, 0x700000  (10 bytes: 48 BA + 8 bytes addr)
    //   mov [rdx], rsp         (3 bytes: 48 89 22)
    //   call <main_rel>        (5 bytes: E8 + rel32)
    //   mov rdi, rax           (3 bytes: 48 89 C7)
    //   mov rax, 60            (7 bytes: 48 C7 C0 3C 00 00 00)
    //   syscall                (2 bytes: 0F 05)
    //   total = 30 bytes
    let trampoline_size: i64 = 30
    let code_start = trampoline_size
    let main_abs = code_start + main_off
    let call_rel = main_abs - (trampoline_size - 5 + 5)
    // Actually: call instruction is at offset 13 in trampoline (after movabs+mov[rdx])
    // call_rel = main_abs - (13 + 5) = main_abs - 18
    let actual_call_rel = main_abs - 18
    // movabs rdx, 0x700000
    elf_emit(0x48); elf_emit(0xBA); elf_emit_u64(0x700000)
    // mov [rdx], rsp
    elf_emit(0x48); elf_emit(0x89); elf_emit(0x22)
    // call rel32
    elf_emit(0xE8); elf_emit_u32(actual_call_rel)
    // mov rdi, rax
    elf_emit(0x48); elf_emit(0x89); elf_emit(0xC7)
    // mov rax, 60
    elf_emit(0x48); elf_emit(0xC7); elf_emit(0xC0)
    elf_emit_u32(60)
    // syscall
    elf_emit(0x0F); elf_emit(0x05)

    // Copy code
    var ci: i64 = 0
    while ci < CODE_LEN {
        elf_emit(CODE[ci as usize] as i64)
        ci = ci + 1
    }
}

fn patch_calls(trampoline_size: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < FIX_COUNT {
        let fix_off = FIX_OFF[i as usize]
        let target_fn = FIX_TARGET[i as usize]
        let target_off = FN_CODE_OFF[target_fn as usize]
        let rel = target_off - (fix_off + 4)
        CODE[fix_off as usize] = (rel & 0xFF) as i8
        CODE[(fix_off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
        CODE[(fix_off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
        CODE[(fix_off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
        i = i + 1
    }
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: micro_bootstrap <source.sio> <output>")
        return 1
    }
    let src_path = get_arg(0)
    let out_path = get_arg(1)

    // Read source — load_source reads file into native buffer, returns size
    let size = load_source(src_path)
    SRC_LEN = size
    print("loaded size=")
    print_int(size)
    print("\n")

    // Lex
    print("lexing...\n")
    lex()
    print("tokens=")
    print_int(TK_COUNT)
    print("\n")

    // Parse
    print("parsing...\n")
    parse_program()
    print("fns=")
    print_int(FN_COUNT)
    print("\n")

    // Find main function
    var main_fn: i64 = -1
    var fi: i64 = 0
    while fi < FN_COUNT {
        let fo = FN_NAME_OFF[fi as usize]
        let fl = FN_NAME_LEN[fi as usize]
        if pool_match(fo, fl, "main") {
            main_fn = fi
        }
        fi = fi + 1
    }

    if main_fn == -1 {
        print("error: no main function found")
        return 1
    }

    // Reserve first 8 bytes of BSS for saved-rsp (arg_count/get_arg builtins)
    MB_BSS_TOTAL = 8

    // Collect global variable declarations for BSS layout
    mb_collect_globals()
    // Resolve BSS addresses for SRC_BUF and SRC_LEN (needed by load_source/source_byte builtins)
    mb_resolve_src_globals()
    print("globals=")
    print_int(MB_GL_COUNT)
    print(" bss=")
    print_int(MB_BSS_TOTAL)
    print("\n")

    // Emit print_int helper first (at CODE offset 0, before user functions)
    emit_print_int_helper()

    // Compile all functions
    var ci: i64 = 0
    while ci < FN_COUNT {
        compile_fn(ci)
        ci = ci + 1
    }

    // Patch calls
    patch_calls(17)

    // Write ELF
    write_elf(main_fn)

    // Output
    let wr = write_file(out_path, ELF, ELF_LEN)
    print("ok")
    0
}
