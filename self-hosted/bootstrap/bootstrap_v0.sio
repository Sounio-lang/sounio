        if text[0] == 86 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 && text[5] == 87 as i8 && text[6] == 104 as i8 && text[7] == 105 as i8 && text[8] == 108 as i8 && text[9] == 101 as i8 { return TokenKind::ValidWhile }    // "ValidWhile"
