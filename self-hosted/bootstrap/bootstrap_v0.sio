            if p.peek() == TokenKind::Objective {
                let obj_pair = p.parse_alternative_objective_def()
                p = obj_pair.0
                rev_objectives_opt = Some(Box::new(AlternativeObjectiveDefList {
                    head: obj_pair.1,
                    tail: rev_objectives_opt,
                }))
