// ============================================================
// Function definition
// ============================================================
struct FnDef {
    name: Name,
    params: Option<Box<ParamList>>,
    return_type: Option<Box<TypeExpr>>,
    effects: Option<Box<EffectList>>,
    body: Block,
    span: Span,
    is_kernel: bool,
}
struct Param {
    name: Name,
    ty: TypeExpr,
    is_self: bool,
    is_self_mut: bool,
    span: Span,
}
// ============================================================
// Struct definition
// ============================================================
struct TypeParamDef {
    name: Name,
    span: Span,
}

struct TypeParamDefList {
    head: TypeParamDef,
    tail: Option<Box<TypeParamDefList>>,
}

struct StructDef {
    name: Name,
    type_params: Option<Box<TypeParamDefList>>,
    fields: Option<Box<FieldDefList>>,
    is_linear: bool,
    is_affine: bool,
    span: Span,
}
struct FieldDef {
    name: Name,
    ty: TypeExpr,
    span: Span,
}
// ============================================================
// Enum definition
// ============================================================
struct EnumDef {
    name: Name,
    variants: Option<Box<VariantDefList>>,
    span: Span,
}
struct VariantDef {
    name: Name,
    span: Span,
}
// ============================================================
// Impl definition
// ============================================================
struct ImplDef {
    target_type: TypeExpr,
    methods: Option<Box<ItemList>>,
    span: Span,
}
// ============================================================
// Top-level program
// ============================================================
struct Program {
    // Identity of this program when treated as a module.
    // For flat compilation (single unit), this is typically empty.
    module_path: AstPath,
    items: Option<Box<ItemList>>,
}
// Construct an empty AstPath (used by module_loader and other consumers)
fn empty_path() -> AstPath {
    AstPath { segments: StringList { head_buf: [0; 384], head_len: 0, tail: None }, seg_count: 0 }
}
// Check if a Name is empty (zero-length)
fn name_is_empty(n: Name) -> bool {
    n.len == 0
}
// Construct an empty Name
fn empty_name() -> Name {
    Name { buf: [0; 384], len: 0 }
}
// Name comparison — byte-by-byte equality
fn name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// ============================================================
// Inlined from: self-hosted/parser/parser.sio
// ============================================================
// Parser core: token stream navigation, error recovery, node construction helpers.
// Keep token storage out of Parser state so Parser method calls don't
// repeatedly copy a 65k token array by value.
var PARSER_TOKENS: [Token; 1048576] = [Token::new(); 1048576]
var PARSER_FAST_SKIP_BLOCKS: bool = false
var PARSER_LAST_HAD_ERROR: bool = false
var PARSER_LAST_ERROR_COUNT: i64 = 0
struct Parser {
    token_count: i64,
    pos: i64,
    next_id: i64,
    had_error: bool,
    error_count: i64,
    no_struct_lit: bool,
    // When parsing nested generic type args like `Option<Box<T>>`, the lexer
    // produces a single `>>` token. In type contexts we need to treat that as
    // two consecutive `>` tokens. This counter tracks pending synthetic `>`
    // tokens to emit before consuming the underlying `>>`.
    pending_gt: i64,
}
// ============================================================
// Construction
// ============================================================
fn parser_new() -> Parser {
    Parser {
        token_count: 0,
        pos: 0,
        next_id: 1,
        had_error: false,
        error_count: 0,
        no_struct_lit: false,
        pending_gt: 0,
    }
}
fn parser_set_tokens(tokens: [Token; 1048576], token_count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count && i < 1048576 {
        PARSER_TOKENS[i as usize] = tokens[i as usize]
        i = i + 1
    }
}
fn parser_set_token_at(idx: i64, tok: Token) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        PARSER_TOKENS[idx as usize] = tok
    }
}
fn parser_set_fast_skip_blocks(enabled: bool) with Mut {
    PARSER_FAST_SKIP_BLOCKS = enabled
}
fn parser_reset_last_errors() with Mut {
    PARSER_LAST_HAD_ERROR = false
    PARSER_LAST_ERROR_COUNT = 0
}
fn parser_set_last_errors(had_error: bool, error_count: i64) with Mut {
    PARSER_LAST_HAD_ERROR = had_error
    PARSER_LAST_ERROR_COUNT = error_count
}
fn parser_last_had_error() -> bool {
    PARSER_LAST_HAD_ERROR
}
fn parser_last_error_count() -> i64 {
    PARSER_LAST_ERROR_COUNT
}
// ============================================================
// Token access
// ============================================================
impl Parser {
    fn current(self) -> Token with Panic, Div {
        if self.pos < self.token_count {
            PARSER_TOKENS[self.pos as usize]
        } else {
            Token::eof(0, 0, 0)
        }
    }
    fn peek(self) -> TokenKind with Panic, Div {
        if self.pending_gt > 0 {
            TokenKind::Gt
        } else {
            if self.pos < self.token_count {
                PARSER_TOKENS[self.pos as usize].kind
            } else {
                TokenKind::Eof
            }
        }
    }
    fn peek_ahead(self, offset: i64) -> TokenKind with Panic, Div {
        if self.pending_gt > 0 {
            if offset < self.pending_gt {
                TokenKind::Gt
            } else {
                let idx = self.pos + 1 + (offset - self.pending_gt)
                if idx < self.token_count {
                    PARSER_TOKENS[idx as usize].kind
                } else {
                    TokenKind::Eof
                }
            }
        } else {
            let idx = self.pos + offset
            if idx < self.token_count {
                PARSER_TOKENS[idx as usize].kind
            } else {
                TokenKind::Eof
            }
        }
    }
    fn at(self, kind: TokenKind) -> bool with Panic, Div {
        self.peek() == kind
    }
    fn at_eof(self) -> bool with Panic, Div {
        self.peek() == TokenKind::Eof
    }
    // Returns true if the current token is on a later line than the previous token.
    // Used by the Pratt parser to prevent `ident\n(` from being parsed as a call.
    // The self-hosted lexer discards newline tokens, so we compare line numbers.
    fn had_newline_before(self) -> bool with Panic, Div {
        if self.pos <= 0 { return false }
        let prev_line = PARSER_TOKENS[(self.pos - 1) as usize].line
        let cur_line = PARSER_TOKENS[self.pos as usize].line
        prev_line < cur_line
    }
    // ============================================================
    // Advance
    // ============================================================
    fn advance(self) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt > 0 {
                return p
            }
            // Consumed the last synthetic `>`; now consume the underlying token.
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
        } else if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
        // Skip newlines automatically (they're insignificant in most contexts)
        while p.pos < p.token_count && PARSER_TOKENS[p.pos as usize].kind == TokenKind::Newline {
            p.pos = p.pos + 1
        }
        p
    }
    fn advance_raw(self) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt == 0 && p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        } else {
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        }
    }
    // ============================================================
    // Expect
    // ============================================================
    fn expect(self, kind: TokenKind) -> Parser with Mut, IO, Panic, Div {
        // In type contexts, allow `>>` to act as two consecutive `>` tokens.
        if kind == TokenKind::Gt && self.pending_gt == 0 && self.peek() == TokenKind::Shr {
            var p = self
            p.pending_gt = 2
            p.advance()
        } else if self.peek() == kind {
            self.advance()
        } else {
            var p = self
            let tok = p.current()
            p.had_error = true
            p.error_count = p.error_count + 1
            print("parse error: expected token at line ")
            print_int(tok.line)
            print(", col ")
            print_int(tok.col)
            print(" (span ")
            print_int(tok.start)
            print("..")
            print_int(tok.end)
            print(")\n")
            p
        }
    }
    fn expect_ident(self) -> Parser with Mut, IO, Panic, Div {
        let k = self.peek()
        if k == TokenKind::Ident || tk_is_keyword(k) {
            self.advance()
        } else {
            // Avoid infinite loops on identifier mismatches by consuming a token.
            var p = self
            p = p.expect(TokenKind::Ident)
            p.advance()
        }
    }
    // ============================================================
    // Node ID allocation
    // ============================================================
    fn alloc_id(self) -> Parser with Mut {
        var p = self
        p.next_id = p.next_id + 1
        p
    }
    fn current_id(self) -> NodeId {
        NodeId { id: self.next_id }
    }
    // ============================================================
    // Span helpers
    // ============================================================
    fn current_span(self) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(
                0,
                PARSER_TOKENS[self.pos as usize].start,
                PARSER_TOKENS[self.pos as usize].end
            )
        } else {
            Span::new(0, 0, 0)
        }
    }
    fn span_from(self, start: Span) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(start.file_id, start.start, PARSER_TOKENS[self.pos as usize].end)
        } else {
            Span::new(start.file_id, start.start, start.end)
        }
    }
    // ============================================================
    // Name extraction from current token
    // ============================================================
    fn current_name(self) -> Name with Mut, Panic, Div {
        if self.pos < self.token_count {
            let tok = PARSER_TOKENS[self.pos as usize]
            var name = Name { buf: [0; 384], len: tok.text_len }
            var i: i64 = 0
            while i < tok.text_len && i < 128 {
                name.buf[i as usize] = tok.text[i as usize]
                i = i + 1
            }
            name
        } else {
            Name { buf: [0; 384], len: 0 }
        }
    }
    // ============================================================
    // Utility: check if current token starts an expression
    // ============================================================
    fn at_expr_start(self) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::IntLit
            || k == TokenKind::FloatLit
            || k == TokenKind::StringLit
            || k == TokenKind::CharLit
            || k == TokenKind::True
            || k == TokenKind::False
            || k == TokenKind::Ident
            || k == TokenKind::LParen
            || k == TokenKind::LBracket
            || k == TokenKind::LBrace
            || k == TokenKind::Minus
            || k == TokenKind::Bang
            || k == TokenKind::Amp
            || k == TokenKind::AmpBang
            || k == TokenKind::Star
            || k == TokenKind::If
            || k == TokenKind::Match
            || k == TokenKind::While
            || k == TokenKind::Loop
            || k == TokenKind::Return
            || k == TokenKind::Break
            || k == TokenKind::Continue
            || k == TokenKind::SelfLower
            || k == TokenKind::ContestLower
    }
    // ============================================================
    // Utility: check if current token starts an item
    // ============================================================
    fn at_item_start(self) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::Fn
            || k == TokenKind::Struct
            || k == TokenKind::Enum
            || k == TokenKind::Impl
            || k == TokenKind::Type
            || k == TokenKind::PolicyLower
            || k == TokenKind::Use
            || k == TokenKind::Import
            || k == TokenKind::Linear
            || k == TokenKind::Pub
    }
}
