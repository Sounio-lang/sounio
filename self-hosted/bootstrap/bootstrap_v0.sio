// ============================================================
// Inlined from: self-hosted/parser/types.sio
// ============================================================
// Parser — type expression parsing
//
// Handles: named types, references, arrays, tuples, function types,
// generic arguments, and effect lists.
impl Parser {
    // ============================================================
    // Type expression entry point
    // ============================================================
    fn parse_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let k = self.peek()
        if k == TokenKind::Amp {
            self.parse_ref_type()
        } else if k == TokenKind::AmpBang {
            self.parse_ref_mut_type()
        } else if k == TokenKind::LBracket {
            self.parse_array_type()
        } else if k == TokenKind::LParen {
            self.parse_tuple_or_fn_type()
        } else if k == TokenKind::Bang {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeNever,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::SelfUpper {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeSelfUpper,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::Underscore {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeInfer,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::Fn {
            self.parse_fn_type()
        } else if k == TokenKind::Knowledge {
            self.parse_knowledge_type()
        } else if k == TokenKind::Model {
            self.parse_generic_wrapper_type(TypeExprKind::TypeModel)
        } else if k == TokenKind::Policy {
            self.parse_generic_wrapper_type(TypeExprKind::TypePolicy)
        } else if k == TokenKind::AcquisitionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAcquisitionPolicy)
        } else if k == TokenKind::AcquisitionPlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAcquisitionPlan)
        } else if k == TokenKind::AlternativePolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativePolicy)
        } else if k == TokenKind::AlternativeSet {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativeSet)
        } else if k == TokenKind::AlternativeOption {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativeOption)
        } else if k == TokenKind::RecoursePolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRecoursePolicy)
        } else if k == TokenKind::RecoursePlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRecoursePlan)
        } else if k == TokenKind::TransitionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeTransitionPolicy)
        } else if k == TokenKind::TransitionPlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeTransitionPlan)
        } else if k == TokenKind::MonitoringPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeMonitoringPolicy)
        } else if k == TokenKind::ObservedTransition {
            self.parse_generic_wrapper_type(TypeExprKind::TypeObservedTransition)
        } else if k == TokenKind::RollbackCertificate {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRollbackCertificate)
        } else if k == TokenKind::DecisionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDecisionPolicy)
        } else if k == TokenKind::DeferralPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDeferralPolicy)
        } else if k == TokenKind::Contest {
            self.parse_generic_wrapper_type(TypeExprKind::TypeContest)
        } else if k == TokenKind::Robust {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRobust)
        } else if k == TokenKind::Intervention {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeIntervention)
        } else if k == TokenKind::Counterfactual {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeCounterfactual)
        } else if k == TokenKind::Validated {
            self.parse_validated_type()
        } else if k == TokenKind::Admissible {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAdmissible)
        } else if k == TokenKind::Deferred {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDeferred)
        } else if k == TokenKind::Chan {
            self.parse_chan_type()
        // Sprint 27: Annotation syntax for epistemic types
        } else if k == TokenKind::DiffPrivate {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDiffPrivate)
        } else if k == TokenKind::DPBudget {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDPBudget)
        } else if k == TokenKind::CausalEffect {
            self.parse_generic_wrapper_type(TypeExprKind::TypeCausalEffect)
        } else if k == TokenKind::Aleatoric {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAleatoric)
        } else if k == TokenKind::PotentialOutcome {
            self.parse_generic_wrapper_type(TypeExprKind::TypePotentialOutcome)
        } else if k == TokenKind::Proof {
            self.parse_generic_wrapper_type(TypeExprKind::TypeProof)
        } else if k == TokenKind::Lemma {
            self.parse_generic_wrapper_type(TypeExprKind::TypeLemma)
        } else if k == TokenKind::Axiom {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAxiom)
        } else {
            // Named type (possibly with :: path and <> generic args)
            self.parse_named_type()
        }
    }
    // ============================================================
    // Named type: Foo, Foo::Bar, Option<Box<T>>
    // ============================================================
    fn parse_named_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        let pair = self.parse_type_path()
        let p1 = pair.0
        let path = pair.1
        // Check for generic arguments <T, U>
        if p1.peek() == TokenKind::Lt {
            let pair2 = p1.parse_type_args()
            let span = pair2.0.span_from(start)
            (pair2.0, TypeExpr {
                kind: TypeExprKind::TypeNamed,
                span: span,
                path: path,
                type_args: Some(Box::new(pair2.1)),
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else {
            let span = p1.span_from(start)
            (p1, TypeExpr {
                kind: TypeExprKind::TypeNamed,
                span: span,
                path: path,
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        }
    }
    // ============================================================
    // Type path: Foo or Foo::Bar::Baz
    // ============================================================
    fn parse_type_path(self) -> (Parser, AstPath) with Mut, IO, Panic, Div {
        let name = self.current_name()
        var p = self.advance()
        var rev_segs = StringList { head_buf: name.buf, head_len: name.len, tail: None }
        var count: i64 = 1
        while p.peek() == TokenKind::ColonColon && (p.peek_ahead(1) == TokenKind::Ident || tk_is_keyword(p.peek_ahead(1))) {
            p = p.advance()  // skip ::
            let seg_name = p.current_name()
            rev_segs = StringList {
                head_buf: seg_name.buf,
                head_len: seg_name.len,
                tail: Some(Box::new(rev_segs)),
            }
            count = count + 1
            p = p.advance()  // skip ident
        }
        let segs = reverse_string_list(rev_segs)
        (p, AstPath { segments: segs, seg_count: count })
    }
    // ============================================================
    // Generic arguments: <T, U, V>
    // ============================================================
    fn parse_type_args(self) -> (Parser, TypeExprList) with Mut, IO, Panic, Div {
        var p = self.advance()  // skip <
        let pair = p.parse_type()
        p = pair.0
        let first_ty = pair.1
        var rev_list = TypeExprList { head: first_ty, tail: None }
        while p.peek() == TokenKind::Comma {
            p = p.advance()  // skip ,
            let pair2 = p.parse_type()
            p = pair2.0
            let next_ty = pair2.1
            rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
        }
        p = p.expect(TokenKind::Gt)
        (p, reverse_type_expr_list(rev_list))
    }
    // ============================================================
    // Reference type: &T
    // ============================================================
    fn parse_ref_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip &
        let pair = p.parse_type()
        let span = pair.0.span_from(start)
        (pair.0, TypeExpr {
            kind: TypeExprKind::TypeReference,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(pair.1)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
    // ============================================================
    // Exclusive reference type: &!T
    // ============================================================
    fn parse_ref_mut_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip &!
        let pair = p.parse_type()
        let span = pair.0.span_from(start)
        (pair.0, TypeExpr {
            kind: TypeExprKind::TypeRefMut,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(pair.1)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
    // ============================================================
    // Array or slice element type: [T; N] or [T]
    // ============================================================
    fn parse_array_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip [
        let pair = p.parse_type()
        let elem_ty = pair.1
        p = pair.0
        var size_expr: Option<Box<Expr>> = None
        if p.peek() == TokenKind::Semi {
            p = p.advance()
            let pair2 = p.parse_expr()
            p = pair2.0
            size_expr = Some(Box::new(pair2.1))
        }
        p = p.expect(TokenKind::RBracket)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeArray,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(elem_ty)),
            array_size: size_expr,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
    // ============================================================
    // Tuple type: (T, U) or unit type: ()
    // ============================================================
    fn parse_tuple_or_fn_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip (
        // Unit type ()
        if p.peek() == TokenKind::RParen {
            p = p.advance()
            let span = p.span_from(start)
            (p, TypeExpr {
                kind: TypeExprKind::TypeUnit,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else {
            // Parse first type
            let pair = p.parse_type()
            p = pair.0
            let first_ty = pair.1
            if p.peek() == TokenKind::Comma {
                // Tuple type
                p = p.advance()  // skip ,
                var rev_list = TypeExprList { head: first_ty, tail: None }
                while p.peek() != TokenKind::RParen && p.peek() != TokenKind::Eof {
                    let pair2 = p.parse_type()
                    p = pair2.0
                    let next_ty = pair2.1
                    rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
                    if p.peek() == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                (p, TypeExpr {
                    kind: TypeExprKind::TypeTuple,
                    span: span,
                    path: empty_path(),
                    type_args: Some(Box::new(reverse_type_expr_list(rev_list))),
                    inner: None,
                    array_size: None,
                    effects: None,
                    knowledge_info: None,
                    refinement_info: None,
                })
            } else {
                // Parenthesized single type
                p = p.expect(TokenKind::RParen)
                (p, first_ty)
            }
        }
    }
    // ============================================================
    // Function type: fn(T, U) -> V with E1, E2
    // ============================================================
    fn parse_fn_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip fn
        p = p.expect(TokenKind::LParen)
        // Parse parameter types
        var has_params = false
        var param_list = TypeExprList { head: dummy_type_expr(), tail: None }
        if p.peek() != TokenKind::RParen {
            let pair = p.parse_type()
            p = pair.0
            var rev_param_list = TypeExprList { head: pair.1, tail: None }
            has_params = true
            while p.peek() == TokenKind::Comma {
                p = p.advance()
                let pair2 = p.parse_type()
                p = pair2.0
                rev_param_list = TypeExprList { head: pair2.1, tail: Some(Box::new(rev_param_list)) }
            }
            param_list = reverse_type_expr_list(rev_param_list)
        }
        p = p.expect(TokenKind::RParen)
        // Parse return type
        var ret_ty = dummy_type_expr()
        var has_ret = false
        if p.peek() == TokenKind::Arrow {
            p = p.advance()
            let pair = p.parse_type()
            p = pair.0
            ret_ty = pair.1
            has_ret = true
        }
        // Parse effects
        var effs: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let pair2 = p.parse_effect_list()
            p = pair2.0
            effs = Some(Box::new(pair2.1))
        }
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeFn,
            span: span,
            path: empty_path(),
            type_args: if has_params { Some(Box::new(param_list)) } else { None },
            inner: if has_ret { Some(Box::new(ret_ty)) } else { None },
            array_size: None,
            effects: effs,
            knowledge_info: None,
            refinement_info: None,
        })
    }
    // ============================================================
    // Effect list: with IO, Mut, Alloc
    // ============================================================
    fn parse_effect_list(self) -> (Parser, EffectList) with Mut, IO, Panic, Div {
        var p = self.advance()  // skip 'with'
        let first_name = p.current_name()
        let first_eff = EffectRef { name_buf: [0; 64], name_len: first_name.len }
        var first = copy_name_to_effect(first_name, first_eff)
        p = p.advance()  // skip effect name
        var rev_list = EffectList { head: first, tail: None }
        while p.peek() == TokenKind::Comma {
            p = p.advance()  // skip ,
            let eff_name = p.current_name()
            let eff = EffectRef { name_buf: [0; 64], name_len: eff_name.len }
            var e = copy_name_to_effect(eff_name, eff)
            rev_list = EffectList { head: e, tail: Some(Box::new(rev_list)) }
            p = p.advance()  // skip effect name
        }
        (p, reverse_effect_list(rev_list))
    }
    // ============================================================
    // Optional type annotation: ': Type'
    // ============================================================
    fn parse_optional_type(self) -> (Parser, Option<Box<TypeExpr>>) with Mut, IO, Panic, Div {
        if self.peek() == TokenKind::Colon {
            var p = self.advance()  // skip :
            let pair = p.parse_type()
            (pair.0, Some(Box::new(pair.1)))
        } else {
            (self, None)
        }
    }
    // ============================================================
    // Optional return type: '-> Type'
    // ============================================================
    fn parse_optional_return_type(self) -> (Parser, Option<Box<TypeExpr>>) with Mut, IO, Panic, Div {
        if self.peek() == TokenKind::Arrow {
            var p = self.advance()  // skip ->
            let pair = p.parse_type()
            (pair.0, Some(Box::new(pair.1)))
        } else {
            (self, None)
        }
    }
    // ============================================================
    // Knowledge type: Knowledge<T> or Knowledge[T, ε < 0.05, Valid(...), Derived]
    // ============================================================
    fn parse_knowledge_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'Knowledge'
        // Determine delimiter: < (shorthand) or [ (extended)
        let delim = p.peek()
        var use_bracket = false
        if delim == TokenKind::LBracket {
            use_bracket = true
            p = p.advance()  // skip [
        } else {
            p = p.expect(TokenKind::Lt)  // skip <
        }
        // Parse inner type T
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        // Parse optional comma-separated components (only in bracket form)
        var epsilon_opt: Option<Box<EpsilonBound>> = None
        var validity_opt: Option<Box<ValidityCondition>> = None
        var provenance_opt: Option<Box<AstProvenanceKind>> = None
        if use_bracket {
            while p.peek() == TokenKind::Comma {
                p = p.advance()  // skip ,
                let ck = p.peek()
                // Check for epsilon bound: identifier followed by comparison op
                if ck == TokenKind::Ident {
                    // Assume epsilon identifier: parse op + value
                    p = p.advance()  // skip epsilon identifier
                    var cmp_op = CompareOp::CmpLt
                    if p.peek() == TokenKind::Lt {
                        cmp_op = CompareOp::CmpLt
                        p = p.advance()
                    } else if p.peek() == TokenKind::LtEq {
                        cmp_op = CompareOp::CmpLe
                        p = p.advance()
                    } else if p.peek() == TokenKind::Gt {
                        cmp_op = CompareOp::CmpGt
                        p = p.advance()
                    } else if p.peek() == TokenKind::GtEq {
                        cmp_op = CompareOp::CmpGe
                        p = p.advance()
                    } else if p.peek() == TokenKind::EqEq {
                        cmp_op = CompareOp::CmpEq
                        p = p.advance()
                    }
                    // Parse float value
                    let eps_tok = p.current()
                    let eps_val = eps_tok.float_value
                    p = p.advance()  // skip float literal
                    epsilon_opt = Some(Box::new(EpsilonBound { op: cmp_op, value: eps_val }))
                } else if ck == TokenKind::Valid {
                    p = p.advance()  // skip 'Valid'
                    let vkind = AstValidityKind::ValidDuration
                    var vexpr: Option<Box<Expr>> = None
                    if p.peek() == TokenKind::LParen {
                        p = p.advance()  // skip (
                        let epair = p.parse_expr()
                        p = epair.0
                        vexpr = Some(Box::new(epair.1))
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::ValidUntil {
                    p = p.advance()  // skip 'ValidUntil'
                    let vkind = AstValidityKind::ValidUntilTime
                    var vexpr: Option<Box<Expr>> = None
                    if p.peek() == TokenKind::LParen {
                        p = p.advance()
                        let epair = p.parse_expr()
                        p = epair.0
                        vexpr = Some(Box::new(epair.1))
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::ValidWhile {
                    p = p.advance()  // skip 'ValidWhile'
                    let vkind = AstValidityKind::ValidWhileCond
                    var vexpr: Option<Box<Expr>> = None
                    if p.peek() == TokenKind::LParen {
                        p = p.advance()
                        let epair = p.parse_expr()
                        p = epair.0
                        vexpr = Some(Box::new(epair.1))
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::Derived {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvDerived))
                } else if ck == TokenKind::Computed {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvComputed))
                } else if ck == TokenKind::Measured {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvMeasured))
                } else {
                    // Unknown component — skip
                    p = p.advance()
                }
            }
        }
        // Expect closing delimiter
        if use_bracket {
            p = p.expect(TokenKind::RBracket)
        } else {
            p = p.expect(TokenKind::Gt)
        }
        let span = p.span_from(start)
        let info = KnowledgeTypeInfo {
            inner_type: Box::new(inner_ty),
            epsilon: epsilon_opt,
            validity: validity_opt,
            provenance: provenance_opt,
        }
        (p, TypeExpr {
            kind: TypeExprKind::TypeKnowledge,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: Some(Box::new(info)),
            refinement_info: None,
        })
    }
    fn parse_epistemic_wrapper_type(self, wrapper_kind: TypeExprKind) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        let delim = p.peek()
        var use_bracket = false
        if delim == TokenKind::LBracket {
            use_bracket = true
            p = p.advance()
        } else {
            p = p.expect(TokenKind::Lt)
        }
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        var epsilon_opt: Option<Box<EpsilonBound>> = None
        var validity_opt: Option<Box<ValidityCondition>> = None
        var provenance_opt: Option<Box<AstProvenanceKind>> = None
        if use_bracket {
            while p.peek() == TokenKind::Comma {
                p = p.advance()
                let component_tok = p.peek()
                if component_tok == TokenKind::Valid {
                    p = p.advance()
                    p = p.expect(TokenKind::LParen)
                    let expr_pair = p.parse_expr()
                    p = expr_pair.0
                    p = p.expect(TokenKind::RParen)
                    validity_opt = Some(Box::new(ValidityCondition { kind: AstValidityKind::ValidDuration, expr: Some(Box::new(expr_pair.1)) }))
                } else if component_tok == TokenKind::Derived {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvDerived))
                } else if component_tok == TokenKind::Computed {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvComputed))
                } else if component_tok == TokenKind::Measured {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvMeasured))
                } else {
                    p = p.advance()
                }
            }
            p = p.expect(TokenKind::RBracket)
        } else {
            p = p.expect(TokenKind::Gt)
        }
        let span = p.span_from(start)
        let info = KnowledgeTypeInfo {
            inner_type: Box::new(inner_ty),
            epsilon: epsilon_opt,
            validity: validity_opt,
            provenance: provenance_opt,
        }
        (p, TypeExpr {
            kind: wrapper_kind,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: Some(Box::new(info)),
            refinement_info: None,
        })
    }
    fn parse_validated_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let after_keyword = self.peek_ahead(1)
        if after_keyword == TokenKind::LBracket {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeValidated)
        } else {
            self.parse_generic_wrapper_type(TypeExprKind::TypeValidated)
        }
    }
    fn parse_generic_wrapper_type(self, wrapper_kind: TypeExprKind) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let args_pair = p.parse_type_args_after_lt()
        p = args_pair.0
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: wrapper_kind,
            span: span,
            path: empty_path(),
            type_args: Some(Box::new(args_pair.1)),
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
    fn parse_type_args_after_lt(self) -> (Parser, TypeExprList) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_type()
        var p = pair.0
        let first_ty = pair.1
        var rev_list = TypeExprList { head: first_ty, tail: None }
        while p.peek() == TokenKind::Comma {
            p = p.advance()
            let pair2 = p.parse_type()
            p = pair2.0
            let next_ty = pair2.1
            rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
        }
        p = p.expect(TokenKind::Gt)
        (p, reverse_type_expr_list(rev_list))
    }
    // ============================================================
    // chan T — session channel type carrying protocol T
    // ============================================================
    fn parse_chan_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'chan'
        let inner_pair = p.parse_type()
        p = inner_pair.0
        let inner_ty = inner_pair.1
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeChan,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
}
// ============================================================
// Linked-list helpers for type parsing
// ============================================================
fn reverse_type_expr_list(list: TypeExprList) -> TypeExprList with Mut, Alloc {
    reverse_type_expr_list_loop(list, None)
}
fn reverse_type_expr_list_loop(current: TypeExprList, acc: Option<Box<TypeExprList>>) -> TypeExprList with Mut, Alloc {
    let next = current.tail
    let rev_node = TypeExprList { head: current.head, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_type_expr_list_loop(*rest, Some(Box::new(rev_node))),
    }
}
fn reverse_effect_list(list: EffectList) -> EffectList with Mut, Alloc {
    reverse_effect_list_loop(list, None)
}
fn reverse_effect_list_loop(current: EffectList, acc: Option<Box<EffectList>>) -> EffectList with Mut, Alloc {
    let next = current.tail
    let rev_node = EffectList { head: current.head, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_effect_list_loop(*rest, Some(Box::new(rev_node))),
    }
}
fn reverse_string_list(list: StringList) -> StringList with Mut, Alloc {
    reverse_string_list_loop(list, None)
}
fn reverse_string_list_loop(current: StringList, acc: Option<Box<StringList>>) -> StringList with Mut, Alloc {
    let next = current.tail
    let rev_node = StringList { head_buf: current.head_buf, head_len: current.head_len, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_string_list_loop(*rest, Some(Box::new(rev_node))),
    }
}
fn copy_name_to_effect(name: Name, eff: EffectRef) -> EffectRef with Mut, Panic, Div {
    var result = eff
    var i: i64 = 0
    while i < name.len && i < 64 {
        result.name_buf[i] = name.buf[i]
        i = i + 1
    }
    result.name_len = name.len
    result
}

// ============================================================
// Inlined from: self-hosted/parser/patterns.sio
// ============================================================
// Parser — pattern parsing
//
// Handles: wildcard, binding, literal, enum variant, struct, tuple, or-patterns.
fn empty_pattern(span: Span) -> Pattern {
    Pattern {
        kind: PatternKind::PatWildcard,
        span: span,
        name: empty_name(),
        int_val: 0,
        path: empty_path(),
        sub_patterns: None,
        pat_fields: None,
        is_mut: false,
    }
}
impl Parser {
    // ============================================================
    // Pattern entry point
    // ============================================================
    fn parse_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_pattern_atom()
        let p1 = pair.0
        let first = pair.1
        // Check for or-pattern: pat1 | pat2 | pat3
        if p1.peek() == TokenKind::Pipe {
            var p = p1
            var rev_list_opt: Option<Box<PatternList>> = Some(Box::new(PatternList { head: first, tail: None }))
            while p.peek() == TokenKind::Pipe {
                p = p.advance()  // skip |
                let pair2 = p.parse_pattern_atom()
                p = pair2.0
                let next_pat = pair2.1
                rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
            }
            let span = p.span_from(first.span)
            (p, Pattern {
                kind: PatternKind::PatOr,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        } else {
            (p1, first)
        }
    }
    // ============================================================
    // Pattern atom (no or-pattern at this level)
    // ============================================================
    fn parse_pattern_atom(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()
        if k == TokenKind::Underscore {
            self.parse_wildcard_pattern()
        } else if k == TokenKind::True {
            let span = self.current_span()
            let p = self.advance()
            (p, Pattern {
                kind: PatternKind::PatBoolTrue,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else if k == TokenKind::False {
            let span = self.current_span()
            let p = self.advance()
            (p, Pattern {
                kind: PatternKind::PatBoolFalse,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else if k == TokenKind::IntLit || k == TokenKind::HexLit || k == TokenKind::BinLit || k == TokenKind::OctLit {
            self.parse_int_pattern()
        } else if k == TokenKind::Minus {
            // Negative int pattern
            self.parse_neg_int_pattern()
        } else if k == TokenKind::StringLit {
            self.parse_string_pattern()
        } else if k == TokenKind::LParen {
            self.parse_tuple_pattern()
        } else if k == TokenKind::Ident {
            self.parse_ident_or_enum_pattern()
        } else if k == TokenKind::Var {
            self.parse_mut_binding_pattern()
        } else {
            // Error recovery: advance past unrecognized token to avoid infinite loops
            let span = self.current_span()
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            (p, empty_pattern(span))
        }
    }
    // ============================================================
    // Wildcard: _
    // ============================================================
    fn parse_wildcard_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatWildcard,
            span: span,
            name: empty_name(),
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }
    // ============================================================
    // Integer literal pattern
    // ============================================================
    fn parse_int_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatIntLit,
            span: span,
            name: empty_name(),
            int_val: tok.int_value,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }
    // ============================================================
    // Negative integer pattern: -42
    // ============================================================
    fn parse_neg_int_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip -
        let tok = p.current()
        let span = p.span_from(start)
        p = p.advance()
        (p, Pattern {
            kind: PatternKind::PatIntLit,
            span: span,
            name: empty_name(),
            int_val: 0 - tok.int_value,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }
    // ============================================================
    // String literal pattern
    // ============================================================
    fn parse_string_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatStringLit,
            span: span,
            name: name,
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }
    // ============================================================
    // Tuple pattern: (a, b, c)
    // ============================================================
    fn parse_tuple_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (
        if p.peek() == TokenKind::RParen {
            // Empty tuple pattern
            p = p.advance()
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatTuple,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else {
            let pair = p.parse_pattern()
            p = pair.0
            let first = pair.1
            var rev_list_opt: Option<Box<PatternList>> = Some(Box::new(PatternList { head: first, tail: None }))
            while p.peek() == TokenKind::Comma {
                p = p.advance()
                if p.peek() == TokenKind::RParen { break }
                let pair2 = p.parse_pattern()
                p = pair2.0
                let next_pat = pair2.1
                rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
            }
            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatTuple,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        }
    }
    // ============================================================
    // Identifier-leading: binding, enum variant, struct pattern
    // ============================================================
    fn parse_ident_or_enum_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let name = self.current_name()
        // Check for :: => enum variant path
        if self.peek_ahead(1) == TokenKind::ColonColon {
            let pair = self.parse_type_path()
            let p1 = pair.0
            let path = pair.1
            if p1.peek() == TokenKind::LParen {
                // Enum variant with sub-patterns: Some(x), Ok(v)
                var p = p1.advance()  // skip (
                var rev_list_opt: Option<Box<PatternList>> = None
                if p.peek() != TokenKind::RParen {
                    let pair2 = p.parse_pattern()
                    p = pair2.0
                    let first = pair2.1
                    rev_list_opt = Some(Box::new(PatternList { head: first, tail: None }))
                    while p.peek() == TokenKind::Comma {
                        p = p.advance()
                        let pair3 = p.parse_pattern()
                        p = pair3.0
                        let next_pat = pair3.1
                        rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                (p, Pattern {
                    kind: PatternKind::PatEnum,
                    span: span,
                    name: empty_name(),
                    int_val: 0,
                    path: path,
                    sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                    pat_fields: None,
                    is_mut: false,
                })
            } else if p1.peek() == TokenKind::LBrace {
                // Struct pattern: Foo { x, y: pat }
                self.parse_struct_pattern_body(p1, path, start)
            } else {
                // Enum unit variant: None, MyEnum::Variant
                let span = p1.span_from(start)
                (p1, Pattern {
                    kind: PatternKind::PatEnum,
                    span: span,
                    name: empty_name(),
                    int_val: 0,
                    path: path,
                    sub_patterns: None,
                    pat_fields: None,
                    is_mut: false,
                })
            }
        } else if self.peek_ahead(1) == TokenKind::LParen {
            // Bare name with parens: Some(x), None is handled below
            // Build single-segment path
            var p = self.advance()  // skip ident
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            // Enum variant with sub-patterns
            p = p.advance()  // skip (
            var rev_list_opt: Option<Box<PatternList>> = None
            if p.peek() != TokenKind::RParen {
                let pair = p.parse_pattern()
                p = pair.0
                let first = pair.1
                rev_list_opt = Some(Box::new(PatternList { head: first, tail: None }))
                while p.peek() == TokenKind::Comma {
                    p = p.advance()
                    let pair2 = p.parse_pattern()
                    p = pair2.0
                    let next_pat = pair2.1
                    rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
                }
            }
            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatEnum,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: path,
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        } else if self.peek_ahead(1) == TokenKind::LBrace {
            // Struct pattern: MyStruct { field: pat }
            var p = self.advance()
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            self.parse_struct_pattern_body(p, path, start)
        } else {
            // Simple binding
            let span = self.current_span()
            let p = self.advance()
            (p, Pattern {
                kind: PatternKind::PatBinding,
                span: span,
                name: name,
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        }
    }
    // ============================================================
    // Struct pattern body: { field1: pat1, field2: pat2 }
    // ============================================================
    fn parse_struct_pattern_body(self, p: Parser, path: AstPath, start: Span) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        var parser = p.advance()  // skip {
        var rev_fields_opt: Option<Box<PatFieldList>> = None
        if parser.peek() != TokenKind::RBrace {
            let pair = parser.parse_pat_field()
            parser = pair.0
            let first_field = pair.1
            rev_fields_opt = Some(Box::new(PatFieldList { head: first_field, tail: None }))
            while parser.peek() == TokenKind::Comma {
                parser = parser.advance()
                if parser.peek() == TokenKind::RBrace { break }
                let pair2 = parser.parse_pat_field()
                parser = pair2.0
                let next_field = pair2.1
                rev_fields_opt = Some(Box::new(PatFieldList { head: next_field, tail: rev_fields_opt }))
            }
        }
        parser = parser.expect(TokenKind::RBrace)
        let span = parser.span_from(start)
        (parser, Pattern {
            kind: PatternKind::PatStruct,
            span: span,
            name: empty_name(),
            int_val: 0,
            path: path,
            sub_patterns: None,
            pat_fields: reverse_pat_field_list_opt(rev_fields_opt),
            is_mut: false,
        })
    }
    // ============================================================
    // Pattern field: name: pattern  OR  name (shorthand binding)
    // ============================================================
    fn parse_pat_field(self) -> (Parser, PatField) with Mut, IO, Panic, Div, Alloc {
        let name = self.current_name()
        var p = self.advance()  // skip field name
        if p.peek() == TokenKind::Colon {
            p = p.advance()  // skip :
            let pair = p.parse_pattern()
            (pair.0, PatField { name: name, pattern: pair.1 })
        } else {
            // Shorthand: field name is also binding name
            let span = self.current_span()
            (p, PatField {
                name: name,
                pattern: Pattern {
                    kind: PatternKind::PatBinding,
                    span: span,
                    name: name,
                    int_val: 0,
                    path: empty_path(),
                    sub_patterns: None,
                    pat_fields: None,
                    is_mut: false,
                },
            })
        }
    }
    // ============================================================
    // Mutable binding: var x
    // ============================================================
    fn parse_mut_binding_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip var
        let name = p.current_name()
        let span = p.span_from(start)
        p = p.advance()
        (p, Pattern {
            kind: PatternKind::PatBinding,
            span: span,
            name: name,
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: true,
        })
    }
}
// ============================================================
// Linked-list helpers for pattern parsing
// ============================================================
fn reverse_pattern_list_opt(list: Option<Box<PatternList>>) -> Option<Box<PatternList>> with Mut, Alloc {
    reverse_pattern_list_loop(list, None)
}
fn reverse_pattern_list_loop(
    current: Option<Box<PatternList>>,
    acc: Option<Box<PatternList>>,
) -> Option<Box<PatternList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = PatternList { head: (*node).head, tail: acc }
            reverse_pattern_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
fn reverse_pat_field_list_opt(list: Option<Box<PatFieldList>>) -> Option<Box<PatFieldList>> with Mut, Alloc {
    reverse_pat_field_list_loop(list, None)
}
fn reverse_pat_field_list_loop(
    current: Option<Box<PatFieldList>>,
    acc: Option<Box<PatFieldList>>,
) -> Option<Box<PatFieldList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = PatFieldList { head: (*node).head, tail: acc }
            reverse_pat_field_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

// ============================================================
// Inlined from: self-hosted/parser/stmts.sio
// ============================================================
// Parser — statement and block parsing
//
// Handles: let bindings, var declarations, expression statements,
// assignment statements, and blocks.
impl Parser {
    // ============================================================
    // Block: { stmt; stmt; expr }
    // ============================================================
    fn parse_block(self) -> (Parser, Block) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.expect(TokenKind::LBrace)
        // Fast-path for large corpus scans: keep top-level parsing intact while
        // skipping nested block bodies in linear time.
        if PARSER_FAST_SKIP_BLOCKS {
            var depth: i64 = 1
            while depth > 0 && !p.at_eof() {
                let k = p.peek()
                if k == TokenKind::LBrace {
                    depth = depth + 1
                } else if k == TokenKind::RBrace {
                    depth = depth - 1
                }
                p = p.advance_raw()
            }
            let span = p.span_from(start)
            return (p, Block { stmts: None, span: span })
        }
        // Build in reverse for O(1) cons, reverse once at block end.
        var rev_stmts_opt: Option<Box<StmtList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let pair = p.parse_stmt()
            p = pair.0
            let stmt = pair.1
            rev_stmts_opt = Some(Box::new(StmtList { head: stmt, tail: rev_stmts_opt }))
            // Skip optional semicolons between statements
            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        (p, Block { stmts: reverse_stmt_list_opt(rev_stmts_opt), span: span })
    }
    // ============================================================
    // Statement
    // ============================================================
    fn parse_stmt(self) -> (Parser, Stmt) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()
        if k == TokenKind::Let {
            self.parse_let_stmt()
        } else if k == TokenKind::Var {
            self.parse_var_stmt()
        } else {
            // Expression statement or assignment
            self.parse_expr_or_assign_stmt()
        }
    }
    // ============================================================
    // Let binding: let name [: Type] = expr
    // ============================================================
    fn parse_let_stmt(self) -> (Parser, Stmt) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'
        let name = p.current_name()
        p = p.expect_ident()
        // Optional type annotation
        let pair = p.parse_optional_type()
        p = pair.0
        let ty_opt = pair.1
        // = expr
        p = p.expect(TokenKind::Eq)
        let pair2 = p.parse_expr()
        p = pair2.0
        let init_expr = pair2.1
        let span = p.span_from(start)
        (p, Stmt {
            kind: StmtKind::StmtLet,
            span: span,
            name: name,
            ty: ty_opt,
            expr: Some(Box::new(init_expr)),
            target: None,
            assign_op: AssignOp::AssignEq,
        })
    }
    // ============================================================
    // Var declaration: var name [: Type] = expr
    // ============================================================
    fn parse_var_stmt(self) -> (Parser, Stmt) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'
        let name = p.current_name()
        p = p.expect_ident()
        // Optional type annotation
        let pair = p.parse_optional_type()
        p = pair.0
        let ty_opt = pair.1
        // = expr
        p = p.expect(TokenKind::Eq)
        let pair2 = p.parse_expr()
        p = pair2.0
        let init_expr = pair2.1
        let span = p.span_from(start)
        (p, Stmt {
            kind: StmtKind::StmtVar,
            span: span,
            name: name,
            ty: ty_opt,
            expr: Some(Box::new(init_expr)),
            target: None,
            assign_op: AssignOp::AssignEq,
        })
    }
    // ============================================================
    // Expression or assignment statement
    // ============================================================
    fn parse_expr_or_assign_stmt(self) -> (Parser, Stmt) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let pair = self.parse_expr()
        let p1 = pair.0
        let lhs = pair.1
        let k = p1.peek()
        if k == TokenKind::Eq || k == TokenKind::PlusEq || k == TokenKind::MinusEq
            || k == TokenKind::StarEq || k == TokenKind::SlashEq || k == TokenKind::PercentEq {
            // Assignment
            let op = parse_assign_op(k)
            var p = p1.advance()  // skip operator
            let pair2 = p.parse_expr()
            p = pair2.0
            let rhs = pair2.1
            let span = p.span_from(start)
            (p, Stmt {
                kind: StmtKind::StmtAssign,
                span: span,
                name: empty_name(),
                ty: None,
                expr: Some(Box::new(rhs)),
                target: Some(Box::new(lhs)),
                assign_op: op,
            })
        } else {
            // Expression statement
            let span = p1.span_from(start)
            (p1, Stmt {
                kind: StmtKind::StmtExpr,
                span: span,
                name: empty_name(),
                ty: None,
                expr: Some(Box::new(lhs)),
                target: None,
                assign_op: AssignOp::AssignEq,
            })
        }
    }
}
// ============================================================
// Helpers
// ============================================================
fn parse_assign_op(kind: TokenKind) -> AssignOp {
    match kind {
        TokenKind::Eq => AssignOp::AssignEq,
        TokenKind::PlusEq => AssignOp::AssignAdd,
        TokenKind::MinusEq => AssignOp::AssignSub,
        TokenKind::StarEq => AssignOp::AssignMul,
        TokenKind::SlashEq => AssignOp::AssignDiv,
        TokenKind::PercentEq => AssignOp::AssignRem,
        _ => AssignOp::AssignEq,
    }
}
fn stmt_list_append(list: StmtList, node: StmtList) -> StmtList with Mut, Alloc {
    match list.tail {
        None => StmtList { head: list.head, tail: Some(Box::new(node)) },
        Some(rest) => StmtList {
            head: list.head,
            tail: Some(Box::new(stmt_list_append(*rest, node))),
        },
    }
}
fn reverse_stmt_list_opt(list: Option<Box<StmtList>>) -> Option<Box<StmtList>> with Mut, Alloc {
    reverse_stmt_list_loop(list, None)
}
fn reverse_stmt_list_loop(
    current: Option<Box<StmtList>>,
    acc: Option<Box<StmtList>>,
) -> Option<Box<StmtList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = StmtList { head: (*node).head, tail: acc }
            reverse_stmt_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

// ============================================================
// Inlined from: self-hosted/parser/exprs.sio
// ============================================================
// Parser — Pratt expression parser
//
// Precedence-climbing for binary operators, prefix/postfix handling,
// and all expression forms (literals, calls, field access, if, match, etc).
impl Parser {
    // ============================================================
    // Expression entry point (dispatches to Pratt parser)
    // ============================================================
    fn parse_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        self.parse_expr_bp(0)
    }
    // ============================================================
    // Pratt parser: parse expression with minimum binding power
    // ============================================================
    fn parse_expr_bp(self, min_bp: i64) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        // Parse prefix / atom
        let pair = self.parse_prefix()
        var p = pair.0
        var lhs = pair.1
        // Parse infix operators
        while !p.at_eof() {
            let op_kind = p.peek()
            let prec = tk_precedence(op_kind)
            // Stop if current operator has lower or equal precedence
            if prec <= min_bp { break }
            // Postfix: function call, method call, field access, index
            // A `(` after a newline is NOT a call — it starts a new expression.
            // e.g. `v\n    (*b)[0]` must not be parsed as `v((*b)[0])`.
            if op_kind == TokenKind::LParen {
                if p.had_newline_before() { break }
                let pair2 = p.parse_call_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }
            if op_kind == TokenKind::LBracket {
                let pair2 = p.parse_index_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }
            if op_kind == TokenKind::Dot {
                let pair2 = p.parse_dot_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }
            if op_kind == TokenKind::AuditLower {
                p = p.advance()
                let audit_name = p.current_name()
                p = p.expect_ident()
                let span = p.span_from(lhs.span)
                var audit_e = mk_expr(ExprKind::ExprAuditAttach, span)
                audit_e.left = Some(Box::new(lhs))
                audit_e.name = audit_name
                lhs = audit_e
                continue
            }
            // Range operators (non-associative)
            if op_kind == TokenKind::DotDot || op_kind == TokenKind::DotDotEq {
                let bin_op = if op_kind == TokenKind::DotDot { BinaryOp::OpRange } else { BinaryOp::OpRangeInclusive }
                p = p.advance()
                if p.at_expr_start() {
                    let pair2 = p.parse_expr_bp(prec)
                    p = pair2.0
                    let rhs = pair2.1
                    let span = p.span_from(lhs.span)
                    lhs = Expr {
                        kind: ExprKind::ExprRange,
                        span: span,
                        int_val: 0,
                        float_val: 0.0,
                        name: empty_name(),
                        path: empty_path(),
                        bin_op: bin_op,
                        un_op: UnaryOp::OpNeg,
                        left: Some(Box::new(lhs)),
                        right: Some(Box::new(rhs)),
                        block: None,
                        else_expr: None,
                        args: None,
                        arms: None,
                        fields: None,
                        cast_type: None,
                        handler_block: None,
                        closure_params: None,
                        closure_return: None,
                        closure_effects: None,
                        closure_body: None,
                    }
                } else {
                    // Half-open range: expr..
                    let span = p.span_from(lhs.span)
                    lhs = Expr {
                        kind: ExprKind::ExprRange,
                        span: span,
                        int_val: 0,
                        float_val: 0.0,
                        name: empty_name(),
                        path: empty_path(),
                        bin_op: bin_op,
                        un_op: UnaryOp::OpNeg,
                        left: Some(Box::new(lhs)),
                        right: None,
                        block: None,
                        else_expr: None,
                        args: None,
                        arms: None,
                        fields: None,
                        cast_type: None,
                        handler_block: None,
                        closure_params: None,
                        closure_return: None,
                        closure_effects: None,
                        closure_body: None,
                    }
                }
                continue
            }
            // Type cast: expr as Type
            if op_kind == TokenKind::As {
                p = p.advance()  // skip 'as'
                let pair2 = p.parse_type()
                p = pair2.0
                let target_ty = pair2.1
                let span = p.span_from(lhs.span)
                var cast_e = mk_expr(ExprKind::ExprCast, span)
                cast_e.left = Some(Box::new(lhs))
                cast_e.cast_type = Some(Box::new(target_ty))
                lhs = cast_e
                continue
            }
            // Standard binary operator
            if prec == 0 { break }
            let bin_op = token_to_binop(op_kind)
            p = p.advance()
            // Right-hand side: use prec for left-associativity
            let pair2 = p.parse_expr_bp(prec)
            p = pair2.0
            let rhs = pair2.1
            let span = p.span_from(lhs.span)
            var bin_e = mk_expr(ExprKind::ExprBinary, span)
            bin_e.bin_op = bin_op
            bin_e.left = Some(Box::new(lhs))
            bin_e.right = Some(Box::new(rhs))
            lhs = bin_e
        }
        (p, lhs)
    }
    // ============================================================
    // Prefix / atom expressions
    // ============================================================
    fn parse_prefix(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()
        // Unary operators
        if k == TokenKind::Minus {
            self.parse_unary(UnaryOp::OpNeg)
        } else if k == TokenKind::Bang {
            self.parse_unary(UnaryOp::OpNot)
        } else if k == TokenKind::Amp {
            self.parse_unary(UnaryOp::OpRef)
        } else if k == TokenKind::AmpBang {
            self.parse_unary(UnaryOp::OpRefMut)
        } else if k == TokenKind::Star {
            self.parse_unary(UnaryOp::OpDeref)
        }
        // Literals
        else if k == TokenKind::IntLit || k == TokenKind::HexLit || k == TokenKind::BinLit || k == TokenKind::OctLit {
            self.parse_int_literal()
        } else if k == TokenKind::FloatLit {
            self.parse_float_literal()
        } else if k == TokenKind::StringLit {
            self.parse_string_literal()
        } else if k == TokenKind::CharLit {
            self.parse_char_literal()
        } else if k == TokenKind::True {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprBoolTrue, span))
        } else if k == TokenKind::False {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprBoolFalse, span))
        }
        // Grouping / tuple
        else if k == TokenKind::LParen {
            self.parse_paren_expr()
        }
        // Array literal
        else if k == TokenKind::LBracket {
            self.parse_array_literal()
        }
        // Block expression
        else if k == TokenKind::LBrace {
            self.parse_block_expr()
        }
        // Control flow
        else if k == TokenKind::If {
            self.parse_if_expr()
        } else if k == TokenKind::Match {
            self.parse_match_expr()
        } else if k == TokenKind::While {
            self.parse_while_expr()
        } else if k == TokenKind::Loop {
            self.parse_loop_expr()
        } else if k == TokenKind::For {
            self.parse_for_in_expr()
        } else if k == TokenKind::Return {
            self.parse_return_expr()
        } else if k == TokenKind::Break {
            self.parse_break_expr()
        } else if k == TokenKind::Continue {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprContinue, span))
        }
        // Self
        else if k == TokenKind::SelfLower {
            let span = self.current_span()
            let name = self.current_name()
            let p = self.advance()
            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            (p, e)
        }
        // Effect handler: handle<Effect> { body } with { handlers }
        else if k == TokenKind::Handle {
            self.parse_handle_expr()
        }
        // Closure: |params| body  or  || body
        else if k == TokenKind::Pipe {
            self.parse_closure_expr()
        } else if k == TokenKind::PipePipe {
            self.parse_closure_no_params()
        } else if k == TokenKind::ContestLower {
            self.parse_contest_expr()
        }
        // Identifier (variable, function name, enum path, struct literal)
        else if k == TokenKind::Ident {
            self.parse_ident_expr()
        }
        // Error recovery: advance past unrecognized token to avoid infinite loops
        else {
            let span = self.current_span()
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            (p, error_expr(span))
        }
    }
    // ============================================================
    // Unary expression: -x, !x, &x, &!x, *x
    // ============================================================
    fn parse_unary(self, op: UnaryOp) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip operator
        let pair = p.parse_expr_bp(13)  // unary precedence
        p = pair.0
        let operand = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprUnary, span)
        e.un_op = op
        e.left = Some(Box::new(operand))
        (p, e)
    }
    // ============================================================
    // Integer literal
    // ============================================================
    fn parse_int_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprIntLit, span)
        e.int_val = tok.int_value
        (p, e)
    }
    // ============================================================
    // Float literal
    // ============================================================
    fn parse_float_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprFloatLit, span)
        e.float_val = tok.float_value
        (p, e)
    }
    // ============================================================
    // String literal
    // ============================================================
    fn parse_string_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprStringLit, span)
        e.name = name
        (p, e)
    }
    // ============================================================
    // Char literal
    // ============================================================
    fn parse_char_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprCharLit, span)
        e.int_val = tok.int_value
        (p, e)
    }
    fn parse_contest_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip contest
        p = p.expect(TokenKind::LBracket)
        var rev_models_opt: Option<Box<ExprList>> = None
        if p.peek() != TokenKind::RBracket {
            let first_pair = p.parse_contest_model_expr()
            p = first_pair.0
            rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: first_pair.1, tail: None }))
            while p.peek() == TokenKind::Comma {
                p = p.advance()
                let next_pair = p.parse_contest_model_expr()
                p = next_pair.0
                rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: next_pair.1, tail: rev_models_opt }))
            }
        }
        p = p.expect(TokenKind::RBracket)
        p = p.expect(TokenKind::On)
        let subject_pair = p.parse_expr()
        p = subject_pair.0
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprContest, span)
        e.args = reverse_expr_list_opt(rev_models_opt)
        e.left = Some(Box::new(subject_pair.1))
        (p, e)
    }
    fn parse_contest_model_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        let pair = self.parse_type_path()
        let span = pair.0.span_from(start)
        var e = mk_expr(ExprKind::ExprPath, span)
        e.path = pair.1
        (pair.0, e)
    }
    // ============================================================
    // Parenthesized expression or tuple: (expr) or (a, b, c)
    // ============================================================
    fn parse_paren_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (
        if p.peek() == TokenKind::RParen {
            // Unit value ()
            p = p.advance()
            let span = p.span_from(start)
            (p, mk_expr(ExprKind::ExprTupleLit, span))
        } else {
            let pair = p.parse_expr()
            p = pair.0
            let first = pair.1
            if p.peek() == TokenKind::Comma {
                // Tuple literal
                p = p.advance()
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(ExprList { label: empty_name(), head: first, tail: None }))
                while p.peek() != TokenKind::RParen && p.peek() != TokenKind::Eof {
                    let pair2 = p.parse_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: empty_name(), head: next, tail: rev_list_opt }))
                    if p.peek() == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprTupleLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                (p, e)
            } else {
                // Just grouping
                p = p.expect(TokenKind::RParen)
                (p, first)
            }
        }
    }
    // ============================================================
    // Array literal: [a, b, c] or [val; count]
    // ============================================================
    fn parse_array_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip [
        if p.peek() == TokenKind::RBracket {
            // Empty array
            p = p.advance()
            let span = p.span_from(start)
            (p, mk_expr(ExprKind::ExprArrayLit, span))
        } else {
            let pair = p.parse_expr()
            p = pair.0
            let first = pair.1
            if p.peek() == TokenKind::Semi {
                // Array repeat: [val; count]
                p = p.advance()  // skip ;
                let pair2 = p.parse_expr()
                p = pair2.0.expect(TokenKind::RBracket)
                let count = pair2.1
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.left = Some(Box::new(first))
                e.right = Some(Box::new(count))
                (p, e)
            } else {
                // Array elements: [a, b, c]
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(ExprList { label: empty_name(), head: first, tail: None }))
                while p.peek() == TokenKind::Comma {
                    p = p.advance()
                    if p.peek() == TokenKind::RBracket { break }
                    let pair2 = p.parse_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: empty_name(), head: next, tail: rev_list_opt }))
                }
                p = p.expect(TokenKind::RBracket)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                (p, e)
            }
        }
    }
    // ============================================================
    // Block expression: { ... }
    // ============================================================
    fn parse_block_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let pair = self.parse_block()
        let p = pair.0
        let blk = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprBlock, span)
        e.block = Some(Box::new(blk))
        (p, e)
    }
    // ============================================================
    // Handle expression: handle<Effect> { body } with { handlers }
    // ============================================================
    fn parse_handle_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'handle'
        // Parse effect name: handle<Effect>
        p = p.expect(TokenKind::Lt)
        let effect_name = p.current_name()
        p = p.advance()  // skip effect ident
        p = p.expect(TokenKind::Gt)
        // Parse body block: { ... }
        let body_pair = p.parse_block()
        p = body_pair.0
        let body = body_pair.1
        // Parse optional handler: with { ... }
        var handler_opt: Option<Box<Block>> = None
        if p.peek() == TokenKind::With {
            p = p.advance()  // skip 'with'
            let handler_pair = p.parse_block()
            p = handler_pair.0
            handler_opt = Some(Box::new(handler_pair.1))
        }
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprHandle, span)
        e.name = effect_name
        e.block = Some(Box::new(body))
        e.handler_block = handler_opt
        (p, e)
    }
    // ============================================================
    // Closure expression: |x: T, y: U| body  or  |x: T| -> R with E { body }
    // ============================================================
    fn parse_closure_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip opening '|'
        // Parse params until closing '|'
        var params: Option<Box<ClosureParamList>> = None
        if p.peek() != TokenKind::Pipe {
            let params_pair = p.parse_closure_params()
            p = params_pair.0
            params = params_pair.1
        }
        p = p.expect(TokenKind::Pipe)  // skip closing '|'
        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if p.peek() == TokenKind::Arrow {
            p = p.advance()  // skip '->'
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }
        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }
        // Parse body: block { ... } or single expression
        let body_pair = if p.peek() == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            (blk_p, blk_expr)
        } else {
            p.parse_expr()
        }
        p = body_pair.0
        let body = body_pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = params
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(Box::new(body))
        (p, e)
    }
    // Zero-param closure: || body  (PipePipe token)
    fn parse_closure_no_params(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip '||'
        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if p.peek() == TokenKind::Arrow {
            p = p.advance()
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }
        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }
        // Parse body
        let body_pair = if p.peek() == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            (blk_p, blk_expr)
        } else {
            p.parse_expr()
        }
        p = body_pair.0
        let body = body_pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = None
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(Box::new(body))
        (p, e)
    }
    // Parse comma-separated closure params: name: Type, name: Type
    fn parse_closure_params(self) -> (Parser, Option<Box<ClosureParamList>>) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_closure_param()
        var p = pair.0
        let head = pair.1
        var tail: Option<Box<ClosureParamList>> = None
        if p.peek() == TokenKind::Comma {
            p = p.advance()  // skip ','
            if p.peek() != TokenKind::Pipe {
                let rest_pair = p.parse_closure_params()
                p = rest_pair.0
                tail = rest_pair.1
            }
        }
        let node = ClosureParamList { head: head, tail: tail }
        (p, Some(Box::new(node)))
    }
    // Parse single closure param: name: Type
    fn parse_closure_param(self) -> (Parser, ClosureParam) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        var p = self.advance()  // skip param name
        p = p.expect(TokenKind::Colon)
        let ty_pair = p.parse_type()
        p = ty_pair.0
        let ty = ty_pair.1
        (p, ClosureParam { name: name, ty: ty, span: span })
    }
    // ============================================================
    // If expression: if cond { ... } [else { ... }]
    // ============================================================
    fn parse_if_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'if'
        // Restrict struct literals in condition to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let cond = pair.1
        p.no_struct_lit = false
        let pair2 = p.parse_block()
        p = pair2.0
        let then_block = pair2.1
        var else_opt: Option<Box<Expr>> = None
        if p.peek() == TokenKind::Else {
            p = p.advance()  // skip 'else'
            if p.peek() == TokenKind::If {
                // else if
                let pair3 = p.parse_if_expr()
                p = pair3.0
                else_opt = Some(Box::new(pair3.1))
            } else {
                // else { ... }
                let pair3 = p.parse_block()
                p = pair3.0
                let else_block = pair3.1
                let else_span = p.span_from(start)
                var else_expr = mk_expr(ExprKind::ExprBlock, else_span)
                else_expr.block = Some(Box::new(else_block))
                else_opt = Some(Box::new(else_expr))
            }
        }
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIf, span)
        e.left = Some(Box::new(cond))
        e.block = Some(Box::new(then_block))
        e.else_expr = else_opt
        (p, e)
    }
    // ============================================================
    // Match expression: match expr { pat => body, ... }
    // ============================================================
    fn parse_match_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'match'
        // Restrict struct literals in scrutinee to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let scrutinee = pair.1
        p.no_struct_lit = false
        p = p.expect(TokenKind::LBrace)
        // Parse arms
        var rev_arms_opt: Option<Box<MatchArmList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let arm_start = p.current_span()
            let pair2 = p.parse_pattern()
            p = pair2.0
            let pattern = pair2.1
            p = p.expect(TokenKind::FatArrow)
            let pair3 = if p.peek() == TokenKind::LBrace {
                // Block body
                let pair4 = p.parse_block()
                let pb = pair4.0
                let blk = pair4.1
                let blk_span = pb.span_from(arm_start)
                var be = mk_expr(ExprKind::ExprBlock, blk_span)
                be.block = Some(Box::new(blk))
                (pb, be)
            } else {
                p.parse_expr()
            }
            p = pair3.0
            let body = pair3.1
            let arm = MatchArm { pattern: pattern, body: body, span: p.span_from(arm_start) }
            rev_arms_opt = Some(Box::new(MatchArmList { head: arm, tail: rev_arms_opt }))
            // Skip comma between arms
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprMatch, span)
        e.left = Some(Box::new(scrutinee))
        e.arms = reverse_match_arm_list_opt(rev_arms_opt)
        (p, e)
    }
    // ============================================================
    // While expression: while cond { ... }
    // ============================================================
    fn parse_while_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'while'
        // Restrict struct literals in condition to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let cond = pair.1
        p.no_struct_lit = false
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprWhile, span)
        e.left = Some(Box::new(cond))
        e.block = Some(Box::new(body))
        (p, e)
    }
    // ============================================================
    // Loop expression: loop { ... }
    // ============================================================
    fn parse_loop_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'loop'
        let pair = p.parse_block()
        p = pair.0
        let body = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprLoop, span)
        e.block = Some(Box::new(body))
        (p, e)
    }
    // ============================================================
    // For-in expression: for x in iter_expr { body }
    // ============================================================
    fn parse_for_in_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'for'
        // Parse binding name
        let binding_name = p.current_name()
        p = p.advance()  // skip ident
        // Expect 'in'
        p = p.expect(TokenKind::In)
        // Parse iterator expression (restrict struct lits to avoid { ambiguity)
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let iter_expr = pair.1
        p.no_struct_lit = false
        // Parse body block
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprForIn, span)
        e.name = binding_name
        e.left = Some(Box::new(iter_expr))
        e.block = Some(Box::new(body))
        (p, e)
    }
    // ============================================================
    // Return expression: return [expr]
    // ============================================================
    fn parse_return_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'return'
        var e = mk_expr(ExprKind::ExprReturn, start)
        if p.at_expr_start() {
            let pair = p.parse_expr()
            p = pair.0
            e.left = Some(Box::new(pair.1))
            e.span = p.span_from(start)
        }
        (p, e)
    }
    // ============================================================
    // Break expression: break [expr]
    // ============================================================
    fn parse_break_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'break'
        var e = mk_expr(ExprKind::ExprBreak, start)
        if p.at_expr_start() {
            let pair = p.parse_expr()
            p = pair.0
            e.left = Some(Box::new(pair.1))
            e.span = p.span_from(start)
        }
        (p, e)
    }
    // ============================================================
    // Identifier expression (variable, path, struct literal, call)
    // ============================================================
    fn parse_ident_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let name = self.current_name()
        // Check for path: Foo::Bar::baz
        if self.peek_ahead(1) == TokenKind::ColonColon {
            let pair = self.parse_type_path()
            let p1 = pair.0
            let path = pair.1
            if !p1.no_struct_lit && p1.peek() == TokenKind::LBrace {
                // Struct literal: Foo { x: 1, y: 2 }
                p1.parse_struct_literal(path, start)
            } else {
                // Path expression: Foo::Bar
                let span = p1.span_from(start)
                var e = mk_expr(ExprKind::ExprPath, span)
                e.path = path
                (p1, e)
            }
        } else if !self.no_struct_lit && self.peek_ahead(1) == TokenKind::LBrace {
            // Struct literal with simple name: Point { x: 1, y: 2 }
            var p = self.advance()
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            p.parse_struct_literal(path, start)
        } else {
            // Simple identifier
            let span = self.current_span()
            let p = self.advance()
            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            (p, e)
        }
    }
    // ============================================================
    // Struct literal: Path { field: expr, ... }
    // ============================================================
    fn parse_struct_literal(self, path: AstPath, start: Span) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip {
        var rev_fields_opt: Option<Box<StructFieldList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_expr()
            p = pair.0
            let field_val = pair.1
            let field = StructFieldInit { name: field_name, value: field_val }
            rev_fields_opt = Some(Box::new(StructFieldList { head: field, tail: rev_fields_opt }))
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprStructLit, span)
        e.path = path
        e.fields = reverse_struct_field_list_opt(rev_fields_opt)
        (p, e)
    }
    // ============================================================
    // Call expression: callee(arg1, arg2)
    // ============================================================
    fn parse_call_arg_expr(self) -> (Parser, ExprList) with Mut, IO, Panic, Div, Alloc {
        var p = self
        var label = empty_name()
        if p.peek() == TokenKind::Ident && p.peek_ahead(1) == TokenKind::Colon {
            label = p.current_name()
            p = p.advance()
            p = p.expect(TokenKind::Colon)
        }
        let pair = p.parse_expr()
        (pair.0, ExprList { label: label, head: pair.1, tail: None })
    }
    fn parse_call_expr(self, callee: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = callee.span
        var p = self.advance()  // skip (
        var args_opt: Option<Box<ExprList>> = None
        if p.peek() != TokenKind::RParen {
            let pair = p.parse_call_arg_expr()
            p = pair.0
            let first = pair.1
            var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first))
            while p.peek() == TokenKind::Comma {
                p = p.advance()
                if p.peek() == TokenKind::RParen { break }
                let pair2 = p.parse_call_arg_expr()
                p = pair2.0
                let next = pair2.1
                rev_list_opt = Some(Box::new(ExprList { label: next.label, head: next.head, tail: rev_list_opt }))
            }
            args_opt = reverse_expr_list_opt(rev_list_opt)
        }
        p = p.expect(TokenKind::RParen)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprCall, span)
        e.left = Some(Box::new(callee))
        e.args = args_opt
        e = rewrite_hardware_publish_call(e)
        (p, e)
    }
    // ============================================================
    // Index expression: base[index]
    // ============================================================
    fn parse_index_expr(self, base: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = self.advance()  // skip [
        let pair = p.parse_expr()
        p = pair.0.expect(TokenKind::RBracket)
        let index = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIndex, span)
        e.left = Some(Box::new(base))
        e.right = Some(Box::new(index))
        (p, e)
    }
    // ============================================================
    // Dot expression: field access or method call
    // ============================================================
    fn parse_dot_expr(self, base: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = self.advance()  // skip .
        let name = p.current_name()
        p = p.advance()  // skip field/method name
        if p.peek() == TokenKind::LParen {
            // Method call: base.method(args)
            p = p.advance()  // skip (
            var args_opt: Option<Box<ExprList>> = None
            if p.peek() != TokenKind::RParen {
                let pair = p.parse_call_arg_expr()
                p = pair.0
                let first = pair.1
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first))
                while p.peek() == TokenKind::Comma {
                    p = p.advance()
                    if p.peek() == TokenKind::RParen { break }
                    let pair2 = p.parse_call_arg_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: next.label, head: next.head, tail: rev_list_opt }))
                }
                args_opt = reverse_expr_list_opt(rev_list_opt)
            }
            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprMethodCall, span)
            e.name = name
            e.left = Some(Box::new(base))
            e.args = args_opt
            (p, e)
        } else {
            // Field access: base.field
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprFieldAccess, span)
            e.name = name
            e.left = Some(Box::new(base))
            (p, e)
        }
    }
}
// ============================================================
// hardware_publish canonicalization helpers
// ============================================================
fn rewrite_hardware_publish_call(call_expr: Expr) -> Expr with Mut, Panic, Div, Alloc {
    if call_expr.kind != ExprKind::ExprCall {
        return call_expr
    }
    match call_expr.left {
        Some(callee_box) => {
            let callee = *callee_box
            if callee.kind != ExprKind::ExprIdent || !exprs_name_is_hardware_publish(callee.name) {
                return call_expr
            }
            let args_pair = rewrite_hardware_publish_args(call_expr.args)
            let rewritten_args = args_pair.0
            let op_kind = args_pair.1
            if op_kind < 0 {
                return call_expr
            }
            var rewritten = call_expr
            var intrinsic = callee
            intrinsic.name = exprs_name_knowledge_kaxi_publish()
            rewritten.left = Some(Box::new(intrinsic))
            rewritten.args = rewritten_args
            rewritten
        }
        _ => call_expr,
    }
}
fn rewrite_hardware_publish_args(
    args: Option<Box<ExprList>>
) -> (Option<Box<ExprList>>, i64) with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            let arg0 = (*list).head
            match (*list).tail {
                Some(tail1) => {
                    let arg1 = (*tail1).head
                    let arg_rest = (*tail1).tail
                    let op_kind = kaxi_op_kind_from_expr(arg1)
                    if op_kind < 0 {
                        let original_tail = Some(Box::new(ExprList { label: empty_name(), head: arg1, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: original_tail })), -1)
                    } else {
                        let op_lit = expr_int_lit(arg1.span, op_kind)
                        let rewritten_tail = Some(Box::new(ExprList { label: empty_name(), head: op_lit, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: rewritten_tail })), op_kind)
                    }
                }
                _ => (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: None })), -1),
            }
        }
        _ => (None, -1),
    }
}
fn kaxi_op_kind_from_expr(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprPath {
        return -1
    }
    if e.path.seg_count < 2 {
        return -1
    }
    if !path_first_is_kaxi(e.path) {
        return -1
    }
    let op = path_last_name(e.path)
    if name_eq3(op, 97 as i8, 100 as i8, 100 as i8) { return 1 }               // add
    if name_eq3(op, 109 as i8, 117 as i8, 108 as i8) { return 2 }              // mul
    if name_eq3(op, 100 as i8, 105 as i8, 118 as i8) { return 3 }              // div
    if name_eq3(op, 102 as i8, 109 as i8, 97 as i8) { return 4 }               // fma
    if name_eq4(op, 112 as i8, 97 as i8, 115 as i8, 115 as i8) { return 0 }    // pass
    if name_eq8(op,
        112 as i8, 114 as i8, 111 as i8, 112 as i8,
        95 as i8, 118 as i8, 97 as i8, 114 as i8) { return 5 }                 // prop_var
    -1
}
fn expr_int_lit(span: Span, value: i64) -> Expr {
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = value
    e
}
fn exprs_name_is_hardware_publish(n: Name) -> bool {
    name_eq16(n,
        104 as i8, 97 as i8, 114 as i8, 100 as i8,
        119 as i8, 97 as i8, 114 as i8, 101 as i8,
        95 as i8, 112 as i8, 117 as i8, 98 as i8,
        108 as i8, 105 as i8, 115 as i8, 104 as i8
    )
}
fn exprs_name_knowledge_kaxi_publish() -> Name with Mut, Panic {
    var n = Name { buf: [0; 384], len: 24 }
    // "__knowledge_kaxi_publish"
    n.buf[0] = 95 as i8
    n.buf[1] = 95 as i8
    n.buf[2] = 107 as i8
    n.buf[3] = 110 as i8
    n.buf[4] = 111 as i8
    n.buf[5] = 119 as i8
    n.buf[6] = 108 as i8
    n.buf[7] = 101 as i8
    n.buf[8] = 100 as i8
    n.buf[9] = 103 as i8
    n.buf[10] = 101 as i8
    n.buf[11] = 95 as i8
    n.buf[12] = 107 as i8
    n.buf[13] = 97 as i8
    n.buf[14] = 120 as i8
    n.buf[15] = 105 as i8
    n.buf[16] = 95 as i8
    n.buf[17] = 112 as i8
    n.buf[18] = 117 as i8
    n.buf[19] = 98 as i8
    n.buf[20] = 108 as i8
    n.buf[21] = 105 as i8
    n.buf[22] = 115 as i8
    n.buf[23] = 104 as i8
    n
}
fn path_first_is_kaxi(path: AstPath) -> bool {
    if path.seg_count < 2 {
        return false
    }
    let seg = path.segments
    seg.head_len == 4 &&
    seg.head_buf[0] == 75 as i8 &&  // K
    seg.head_buf[1] == 65 as i8 &&  // A
    seg.head_buf[2] == 88 as i8 &&  // X
    seg.head_buf[3] == 73 as i8     // I
}
fn exprs_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 384 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}
fn path_last_name(path: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if path.seg_count <= 0 {
        return empty_name()
    }
    if path.seg_count == 1 {
        return exprs_copy_string_list_to_name(path.segments)
    }
    string_list_last_name(path.segments)
}
fn string_list_last_name(list: StringList) -> Name with Mut, Panic, Div, Alloc {
    match list.tail {
        Some(rest) => string_list_last_name(*rest),
        _ => exprs_copy_string_list_to_name(list),
    }
}
fn name_eq3(n: Name, a: i8, b: i8, c: i8) -> bool {
    n.len == 3 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c
}
fn name_eq4(n: Name, a: i8, b: i8, c: i8, d: i8) -> bool {
    n.len == 4 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c && n.buf[3] == d
}
fn name_eq8(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8
) -> bool {
    n.len == 8 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7
}
fn name_eq16(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8,
    a8: i8, a9: i8, a10: i8, a11: i8,
    a12: i8, a13: i8, a14: i8, a15: i8
) -> bool {
    n.len == 16 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7 &&
    n.buf[8] == a8 && n.buf[9] == a9 && n.buf[10] == a10 && n.buf[11] == a11 &&
    n.buf[12] == a12 && n.buf[13] == a13 && n.buf[14] == a14 && n.buf[15] == a15
}
// ============================================================
// Token to binary operator mapping
// ============================================================
fn token_to_binop(kind: TokenKind) -> BinaryOp {
    match kind {
        TokenKind::Plus => BinaryOp::OpAdd,
        TokenKind::Minus => BinaryOp::OpSub,
        TokenKind::Star => BinaryOp::OpMul,
        TokenKind::Slash => BinaryOp::OpDiv,
        TokenKind::Percent => BinaryOp::OpRem,
        TokenKind::EqEq => BinaryOp::OpEq,
        TokenKind::BangEq => BinaryOp::OpNe,
        TokenKind::Lt => BinaryOp::OpLt,
        TokenKind::LtEq => BinaryOp::OpLe,
        TokenKind::Gt => BinaryOp::OpGt,
        TokenKind::GtEq => BinaryOp::OpGe,
        TokenKind::AmpAmp => BinaryOp::OpAnd,
        TokenKind::PipePipe => BinaryOp::OpOr,
        TokenKind::Amp => BinaryOp::OpBitAnd,
        TokenKind::Pipe => BinaryOp::OpBitOr,
        TokenKind::Caret => BinaryOp::OpBitXor,
        TokenKind::Shl => BinaryOp::OpShl,
        TokenKind::Shr => BinaryOp::OpShr,
        TokenKind::PlusPlus => BinaryOp::OpConcat,
        TokenKind::DotDot => BinaryOp::OpRange,
        TokenKind::DotDotEq => BinaryOp::OpRangeInclusive,
        _ => BinaryOp::OpAdd,
    }
}
// ============================================================
// Linked-list helpers for expression parsing
// ============================================================
fn reverse_expr_list_opt(list: Option<Box<ExprList>>) -> Option<Box<ExprList>> with Mut, Alloc {
    reverse_expr_list_loop(list, None)
}
fn reverse_expr_list_loop(
    current: Option<Box<ExprList>>,
    acc: Option<Box<ExprList>>,
) -> Option<Box<ExprList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ExprList { label: (*node).label, head: (*node).head, tail: acc }
            reverse_expr_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
fn reverse_match_arm_list_opt(list: Option<Box<MatchArmList>>) -> Option<Box<MatchArmList>> with Mut, Alloc {
    reverse_match_arm_list_loop(list, None)
}
fn reverse_match_arm_list_loop(
    current: Option<Box<MatchArmList>>,
    acc: Option<Box<MatchArmList>>,
) -> Option<Box<MatchArmList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = MatchArmList { head: (*node).head, tail: acc }
            reverse_match_arm_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
fn reverse_struct_field_list_opt(list: Option<Box<StructFieldList>>) -> Option<Box<StructFieldList>> with Mut, Alloc {
    reverse_struct_field_list_loop(list, None)
}
fn reverse_struct_field_list_loop(
    current: Option<Box<StructFieldList>>,
    acc: Option<Box<StructFieldList>>,
) -> Option<Box<StructFieldList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = StructFieldList { head: (*node).head, tail: acc }
            reverse_struct_field_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

// ============================================================
// Inlined from: self-hosted/parser/items.sio
// ============================================================
// Parser — top-level item parsing
//
// Handles: fn, struct, enum, impl, type alias, use declarations.
impl Parser {
    // ============================================================
    // Parse a single item
    // ============================================================
    fn parse_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()
        // Handle optional 'pub' visibility
        var is_pub = false
        var p = self
        if k == TokenKind::Pub {
            is_pub = true
            p = p.advance()
        }
        // Handle optional 'linear' or 'affine' modifier
        var is_linear = false
        var is_affine = false
        if p.peek() == TokenKind::Linear {
            is_linear = true
            p = p.advance()
        } else if p.peek() == TokenKind::Affine {
            is_affine = true
            p = p.advance()
        }
        // Handle optional 'kernel' modifier for GPU kernel functions
        var is_kernel = false
        if p.peek() == TokenKind::Kernel {
            is_kernel = true
            p = p.advance()
        }
        let item_kind = p.peek()
        if item_kind == TokenKind::Fn {
            p.parse_fn_item(is_pub, is_kernel)
        } else if item_kind == TokenKind::Struct {
            p.parse_struct_item(is_linear, is_affine, is_pub)
        } else if item_kind == TokenKind::Enum {
            p.parse_enum_item(is_pub)
        } else if item_kind == TokenKind::Impl {
            p.parse_impl_item(is_pub)
        } else if item_kind == TokenKind::Type {
            p.parse_type_alias_item(is_pub)
        } else if item_kind == TokenKind::ModelsLower {
            p.parse_models_item(is_pub)
        } else if item_kind == TokenKind::PolicyLower {
            p.parse_policy_item(is_pub)
        } else if item_kind == TokenKind::AcquisitionPolicyLower {
            p.parse_acquisition_policy_item(is_pub)
        } else if item_kind == TokenKind::RecoursePolicyLower {
            p.parse_recourse_policy_item(is_pub)
        } else if item_kind == TokenKind::MonitoringPolicyLower {
            p.parse_monitoring_policy_item(is_pub)
        } else if item_kind == TokenKind::TransitionPolicyLower {
            p.parse_transition_policy_item(is_pub)
        } else if item_kind == TokenKind::TransitionProtocolLower {
            p.parse_transition_protocol_item(is_pub)
        } else if item_kind == TokenKind::AlternativePolicyLower {
            p.parse_alternative_policy_item(is_pub)
        } else if item_kind == TokenKind::AlternativeFrontierLower {
            p.parse_alternative_frontier_item(is_pub)
        } else if item_kind == TokenKind::DecisionPolicyLower {
            p.parse_decision_policy_item(is_pub)
        } else if item_kind == TokenKind::DeferralPolicyLower {
            p.parse_deferral_policy_item(is_pub)
        } else if item_kind == TokenKind::ValidationLower {
            p.parse_validation_item(is_pub)
        } else if item_kind == TokenKind::AuditLower {
            p.parse_audit_item(is_pub)
        } else if item_kind == TokenKind::Use {
            p.parse_use_item(is_pub)
        } else if item_kind == TokenKind::Import {
            p.parse_use_item(is_pub)
        } else if item_kind == TokenKind::Let {
            p.parse_global_let_item(is_pub)
        } else if item_kind == TokenKind::Var {
            p.parse_global_var_item(is_pub)
        } else if item_kind == TokenKind::Unit {
            p.parse_unit_item(is_pub)
        } else if item_kind == TokenKind::Effect {
            p.parse_effect_item(is_pub)
        } else if item_kind == TokenKind::Session {
            p.parse_session_item(is_pub)
        } else if item_kind == TokenKind::Extern {
            p.parse_extern_fn_item(is_pub)
        } else if item_kind == TokenKind::Export {
            p.parse_export_fn_item(is_pub)
        } else {
            // Error recovery: skip token
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            let pa = p.advance()
            (pa, Item {
                kind: ItemKind::ItemFn,
                span: span,
                is_pub: is_pub,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }
    }
    // ============================================================
    // Global bindings (top-level): let/var NAME [: Type] = expr
    // ============================================================
    fn parse_global_let_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'
        let name = p.current_name()
        p = p.expect_ident()
        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0
        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0
        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    fn parse_global_var_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'
        let name = p.current_name()
        p = p.expect_ident()
        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0
        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0
        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Function: fn name(params) -> RetType with Effects { body }
    // ============================================================
    fn parse_fn_item(self, is_pub: bool, is_kernel: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        if self.peek() != TokenKind::Fn {
            // Recovery: consume one token so callers never stall.
            let span = self.current_span()
            var p_bad = self
            p_bad.had_error = true
            p_bad.error_count = p_bad.error_count + 1
            p_bad = p_bad.advance()
            return (p_bad, Item {
                kind: ItemKind::ItemFn,
                span: span,
                is_pub: is_pub,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }
        let start = self.current_span()
        var p = self.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        // Parameters
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        // Return type
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        // Effects
        var effects_opt: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }
        // Body
        let pair4 = p.parse_block()
        p = pair4.0
        let body = pair4.1
        let span = p.span_from(start)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
            is_kernel: is_kernel,
        }
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Parameter list
    // ============================================================
    fn parse_param_list(self) -> (Parser, Option<Box<ParamList>>) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::RParen {
            return (self, None)
        }
        let pair = self.parse_param()
        var p = pair.0
        let first = pair.1
        var rev_params_opt: Option<Box<ParamList>> = Some(Box::new(ParamList { head: first, tail: None }))
        while p.peek() == TokenKind::Comma {
            p = p.advance()
            if p.peek() == TokenKind::RParen { break }
            let pair2 = p.parse_param()
            p = pair2.0
            let next = pair2.1
            rev_params_opt = Some(Box::new(ParamList { head: next, tail: rev_params_opt }))
        }
        (p, reverse_param_list_opt(rev_params_opt))
    }
    // ============================================================
    // Single parameter: name: Type  or  self
    // ============================================================
    fn parse_param(self) -> (Parser, Param) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        if self.peek() == TokenKind::SelfLower {
            // self parameter
            let name = self.current_name()
            let p = self.advance()
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: dummy_type_expr(),
                is_self: true,
                is_self_mut: false,
                span: span,
            })
        } else {
            let name = self.current_name()
            var p = self.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let ty = pair.1
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: false,
                is_self_mut: false,
                span: span,
            })
        }
    }
    // ============================================================
    // Struct: struct Name { field: Type, ... }
    // ============================================================
    fn parse_struct_item(self, is_linear: bool, is_affine: bool, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'struct'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)
        // Parse fields
        var rev_fields_opt: Option<Box<FieldDefList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let field_start = p.current_span()
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let field_ty = pair.1
            let field = FieldDef { name: field_name, ty: field_ty, span: p.span_from(field_start) }
            rev_fields_opt = Some(Box::new(FieldDefList { head: field, tail: rev_fields_opt }))
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let fields_opt = reverse_field_def_list_opt(rev_fields_opt)
        let span = p.span_from(start)
        let sdef = StructDef { name: name, type_params: None, fields: fields_opt, is_linear: is_linear, is_affine: is_affine, span: span }
        (p, Item {
            kind: ItemKind::ItemStruct,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: Some(Box::new(sdef)),
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Enum: enum Name { Variant1, Variant2, ... }
    // ============================================================
    fn parse_enum_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'enum'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)
        var rev_variants_opt: Option<Box<VariantDefList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let v_start = p.current_span()
            let v_name = p.current_name()
            p = p.expect_ident()
            let v_span = p.span_from(v_start)
            let variant = VariantDef { name: v_name, span: v_span }
            rev_variants_opt = Some(Box::new(VariantDefList { head: variant, tail: rev_variants_opt }))
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let variants_opt = reverse_variant_def_list_opt(rev_variants_opt)
        let span = p.span_from(start)
        let edef = EnumDef { name: name, variants: variants_opt, span: span }
        (p, Item {
            kind: ItemKind::ItemEnum,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: Some(Box::new(edef)),
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Impl: impl Type { fn method() { } ... }
    // ============================================================
    fn parse_impl_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'impl'
        let pair = p.parse_type()
        p = pair.0
        let target_ty = pair.1
        p = p.expect(TokenKind::LBrace)
        // Build methods in reverse for O(1) cons, reverse once at the end.
        var rev_methods_opt: Option<Box<ItemList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            // Ignore trivia and doc comments between methods.
            while p.peek() == TokenKind::Newline || p.peek() == TokenKind::Semi || tk_is_doc_comment(p.peek()) {
                p = p.advance()
            }
            if p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
                if p.peek() == TokenKind::Fn {
                    let pair2 = p.parse_fn_item(false, false)
                    p = pair2.0
                    let method = pair2.1
                    rev_methods_opt = Some(Box::new(ItemList { head: method, tail: rev_methods_opt }))
                } else {
                    // Recovery: consume one unexpected token inside impl body.
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            }
        }
        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let methods_opt = reverse_item_list_opt(rev_methods_opt)
        // Extract name from target type path
        let impl_name = extract_impl_name(target_ty)
        let idef = ImplDef { target_type: target_ty, methods: methods_opt, span: span }
        (p, Item {
            kind: ItemKind::ItemImpl,
            span: span,
            is_pub: is_pub,
            name: impl_name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: Some(Box::new(idef)),
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Type alias: type Name = Type
    // ============================================================
    fn parse_type_alias_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'type'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)
        // Check for refinement type: { var: Type | predicate }
        if p.peek() == TokenKind::LBrace {
            let ref_pair = p.parse_refinement_type()
            p = ref_pair.0
            let ref_ty = ref_pair.1
            let span = p.span_from(start)
            return (p, Item {
                kind: ItemKind::ItemTypeAlias,
                span: span,
                is_pub: is_pub,
                name: name,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: Some(Box::new(ref_ty)),
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }
        let pair = p.parse_type()
        p = pair.0
        let ty = pair.1
        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemTypeAlias,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: Some(Box::new(ty)),
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
    // ============================================================
    // Policy: policy Name for Type { require metric >= value }
    // ============================================================
    fn parse_policy_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'policy'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)
        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1
        var level_name = empty_name()
        var scope_name = empty_name()
        if p.peek() == TokenKind::Level {
            p = p.advance()
            level_name = p.current_name()
            p = p.expect_ident()
        }
        if p.peek() == TokenKind::Scope {
            p = p.advance()
            scope_name = p.current_name()
            p = p.expect_ident()
        }
        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }
            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))
            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let pdef = PolicyDef {
            name: name,
            target_type: target_ty,
            level_name: level_name,
            scope_name: scope_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }
        (p, Item {
            kind: ItemKind::ItemPolicy,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: Some(Box::new(pdef)),
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }
