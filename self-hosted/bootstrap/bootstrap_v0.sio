            p = p.advance()
            frontier_name = p.current_name()
            p = p.expect_ident()
        }
        p = p.expect(TokenKind::LBrace)
        var rev_objectives_opt: Option<Box<AlternativeObjectiveDefList>> = None
        var max_options: i64 = -1
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
