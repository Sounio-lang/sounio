fn tk_is_delimiter(kind: TokenKind) -> bool {
    match kind {
        TokenKind::LParen => true,
        TokenKind::RParen => true,
        TokenKind::LBrace => true,
        TokenKind::RBrace => true,
        TokenKind::LBracket => true,
        TokenKind::RBracket => true,
        _ => false,
    }
}
fn tk_is_punctuation(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Semi => true,
        TokenKind::Colon => true,
        TokenKind::Comma => true,
        TokenKind::Dot => true,
        TokenKind::At => true,
        TokenKind::Hash => true,
        TokenKind::Underscore => true,
        _ => false,
    }
}
fn tk_is_doc_comment(kind: TokenKind) -> bool {
    match kind {
        TokenKind::DocOuter => true,
        TokenKind::DocInner => true,
        TokenKind::DocBlockOuter => true,
        TokenKind::DocBlockInner => true,
        _ => false,
    }
}
// Pratt parser precedence (for future use)
fn tk_precedence(kind: TokenKind) -> i64 {
    match kind {
        // Assignment operators are NOT expression operators.
        // They are handled by parse_expr_or_assign_stmt in the statement parser.
        // Logical OR = 2
        TokenKind::PipePipe => 2,
        // Logical AND = 3
        TokenKind::AmpAmp => 3,
        // Equality = 4
        TokenKind::EqEq => 4,
        TokenKind::BangEq => 4,
        // Comparison = 5
        TokenKind::Lt => 5,
        TokenKind::Gt => 5,
        TokenKind::LtEq => 5,
        TokenKind::GtEq => 5,
        // Bitwise OR = 6
        TokenKind::Pipe => 6,
        // Bitwise XOR = 7
        TokenKind::Caret => 7,
        // Bitwise AND = 8
        TokenKind::Amp => 8,
        // Shift = 9
        TokenKind::Shl => 9,
        TokenKind::Shr => 9,
        // Range = 10
        TokenKind::DotDot => 10,
        TokenKind::DotDotEq => 10,
        // Additive = 11
        TokenKind::Plus => 11,
        TokenKind::Minus => 11,
        TokenKind::PlusPlus => 11,
        // Multiplicative = 12
        TokenKind::Star => 12,
        TokenKind::Slash => 12,
        TokenKind::Percent => 12,
        // Cast = 13
        TokenKind::As => 13,
        // Unary = 13
        TokenKind::Bang => 13,
        TokenKind::Tilde => 13,
        // Call/Index = 14
        TokenKind::LParen => 14,
        TokenKind::LBracket => 14,
        TokenKind::Dot => 14,
        TokenKind::AuditLower => 14,
        // Assignment — MUST be 0 so Pratt loop breaks before consuming `=`.
        // Root cause of H4.3 binary-patch: compiled bytecode had prec=1 for Eq,
        // causing Pratt parser to swallow `=` as infix OpAdd.
        // Explicit arms as defensive documentation (default also returns 0).
        TokenKind::Eq => 0,
        TokenKind::PlusEq => 0,
        TokenKind::MinusEq => 0,
        TokenKind::StarEq => 0,
        TokenKind::SlashEq => 0,
        TokenKind::PercentEq => 0,
        _ => 0,
    }
}

// ============================================================
// Inlined from: self-hosted/lexer/errors.sio
// ============================================================
// self-hosted::lexer::errors — Lexer diagnostic errors
//
// LexErrorKind is a proper enum replacing i32 constants.
// Each error carries position info and optional context character.
enum LexErrorKind {
    None,
    UnexpectedChar,
    UnterminatedString,
    UnterminatedBlockComment,
    InvalidEscape,
    InvalidNumber,
    NumberOverflow,
    UnterminatedChar,
    EmptyCharLiteral,
}
struct LexError {
    kind: LexErrorKind,
    pos: i64,
    line: i64,
    col: i64,
    // Context character (for unexpected char / invalid escape)
    context_char: i8,
}
impl LexError {
    fn new(kind: LexErrorKind, pos: i64, line: i64, col: i64) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: 0,
        }
    }
    fn with_char(kind: LexErrorKind, pos: i64, line: i64, col: i64, ch: i8) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: ch,
        }
    }
}

// ============================================================
// Inlined from: self-hosted/lexer/reader.sio
// ============================================================
// self-hosted::lexer::reader — Read stdin into a LexerState
//
// Provides read_stdin_with_first() which reads all of stdin into
// a 1MB source buffer and lexes it. The first byte is passed in
// separately (already read by main for mode detection).
fn read_stdin_with_first(first_byte: i64) -> LexerState with IO, Mut, Div, Panic {
    var buf: [i8; 1048576] = [0; 1048576]
    buf[0] = first_byte as i8
    var len: i64 = 1
    var byte = read_byte()
    while byte != -1 && len < 1048576 {
        buf[len as usize] = byte as i8
        len = len + 1
        byte = read_byte()
    }
    lex(buf, len, 0)
}

// ============================================================
// Inlined from: self-hosted/lexer/numparse.sio
// ============================================================
// self-hosted::lexer::numparse — Parse numeric literal text into values
//
// Converts source byte ranges into i64/f64 values.
// Handles decimal, hex, binary, octal, float, and scientific notation.
// Underscore separators are skipped.
// Dispatches by TokenKind instead of i32 constants.
// ============================================================================
// DECIMAL INTEGER PARSING
// ============================================================================
fn num_parse_decimal(start: i64, end: i64) -> i64 with Mut, Div, Panic {
    var result: i64 = 0
    var i = start
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == 95 {  // '_' separator
            i = i + 1
            continue
        }
        // Stop at suffix characters (i, u, f)
        if ch == 105 || ch == 117 || ch == 102 { break }
        // Stop at dot or 'e'/'E' (float territory)
        if ch == 46 || ch == 101 || ch == 69 { break }
        if ch >= 48 && ch <= 57 {
            result = result * 10 + (ch - 48) as i64
        }
        i = i + 1
    }
    result
}
// ============================================================================
// HEXADECIMAL INTEGER PARSING (0x...)
// ============================================================================
fn num_parse_hex(start: i64, end: i64) -> i64 with Mut, Div, Panic {
    var result: i64 = 0
    var i = start + 2  // skip "0x"
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == 95 { i = i + 1; continue }
        if ch == 105 || ch == 117 { break }  // suffix
        if ch >= 48 && ch <= 57 {
            result = result * 16 + (ch - 48) as i64
        } else if ch >= 97 && ch <= 102 {
            result = result * 16 + (ch - 97 + 10) as i64
        } else if ch >= 65 && ch <= 70 {
            result = result * 16 + (ch - 65 + 10) as i64
        } else {
            break
        }
        i = i + 1
    }
    result
}
// ============================================================================
// BINARY INTEGER PARSING (0b...)
// ============================================================================
fn num_parse_binary(start: i64, end: i64) -> i64 with Mut, Div, Panic {
    var result: i64 = 0
    var i = start + 2  // skip "0b"
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == 95 { i = i + 1; continue }
        if ch == 105 || ch == 117 { break }  // suffix
        if ch == 48 {
            result = result * 2
        } else if ch == 49 {
            result = result * 2 + 1
        } else {
            break
        }
        i = i + 1
    }
    result
}
// ============================================================================
// OCTAL INTEGER PARSING (0o...)
// ============================================================================
fn num_parse_octal(start: i64, end: i64) -> i64 with Mut, Div, Panic {
    var result: i64 = 0
    var i = start + 2  // skip "0o"
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == 95 { i = i + 1; continue }
        if ch == 105 || ch == 117 { break }  // suffix
        if ch >= 48 && ch <= 55 {
            result = result * 8 + (ch - 48) as i64
        } else {
            break
        }
        i = i + 1
    }
    result
}
// ============================================================================
// FLOAT PARSING (with scientific notation)
// ============================================================================
fn num_parse_float(start: i64, end: i64) -> f64 with Mut, Div, Panic {
    // Parse integer part
    var result: f64 = 0.0
    var i = start
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == 95 { i = i + 1; continue }
        if ch == 46 || ch == 101 || ch == 69 || ch == 102 { break }
        if ch >= 48 && ch <= 57 {
            result = result * 10.0 + (ch - 48) as f64
        } else {
            break
        }
        i = i + 1
    }
    // Parse fractional part
    if i < end && cursor_source_byte(i) == 46 {  // '.'
        i = i + 1
        var frac: f64 = 0.1
        while i < end {
            let ch = cursor_source_byte(i)
            if ch == 95 { i = i + 1; continue }
            if ch == 101 || ch == 69 || ch == 102 { break }
            if ch >= 48 && ch <= 57 {
                result = result + (ch - 48) as f64 * frac
                frac = frac * 0.1
            } else {
                break
            }
            i = i + 1
        }
    }
    // Parse exponent
    if i < end && (cursor_source_byte(i) == 101 || cursor_source_byte(i) == 69) {  // 'e' or 'E'
        i = i + 1
        var exp_negative = false
        if i < end && cursor_source_byte(i) == 45 {  // '-'
