                p = p.advance()
                if p.peek() == TokenKind::IntLit {
                    max_options = p.current().int_value
                    p = p.advance()
                } else {
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }
            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
