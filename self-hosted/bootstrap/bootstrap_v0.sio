}
// Refinement predicate — parsed from `{ x: T | x > 0 }`
// pred_op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq
struct RefinementInfo {
    var_name: Name,
    base_type: Option<Box<TypeExpr>>,
    pred_op: i64,
    pred_int_val: i64,
    pred_float_val: f64,
    pred_is_float: bool,
}
struct TypeExpr {
    kind: TypeExprKind,
    span: Span,
    // For Named: type path (e.g. Vec, Option, Foo::Bar)
    path: AstPath,
    // For Named: generic args; Tuple: elements; Fn: params
    type_args: Option<Box<TypeExprList>>,
    // For Reference, RefMut, Array: inner type; Fn: return type
    inner: Option<Box<TypeExpr>>,
    // For Array: size expression
    array_size: Option<Box<Expr>>,
    // For Fn: effect list
    effects: Option<Box<EffectList>>,
    // For Knowledge: full epistemic type info
    knowledge_info: Option<Box<KnowledgeTypeInfo>>,
    // For Refinement: { var: Type | predicate }
    refinement_info: Option<Box<RefinementInfo>>,
}
// ============================================================
// Items (top-level declarations)
