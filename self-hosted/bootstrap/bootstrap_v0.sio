    recv_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, label.0, label.1)
}
// T19: Suggest deletion records RECV_ERR_EXTRA
fn recv_test_suggest_deletion() -> bool with IO, Mut, Panic, Div {
    var s = recv_state_new()
    var msg: [i8; 128] = [0; 128]
    s = recv_suggest_deletion(s, 3, 9, 55, msg, 0)
    let ok1 = recv_error_count(s) == 1
    let err = recv_get_error(s, 0)
    let ok2 = err.kind == RECV_ERR_EXTRA()
    let ok3 = err.token_kind == 55
    let label = recv_test_label(
