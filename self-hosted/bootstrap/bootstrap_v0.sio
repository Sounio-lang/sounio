        if text[0] == 65 as i8 && text[1] == 100 as i8 && text[2] == 109 as i8 && text[3] == 105 as i8 && text[4] == 115 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 98 as i8 && text[8] == 108 as i8 && text[9] == 101 as i8 { return TokenKind::Admissible }    // "Admissible"
