    // For DecisionPolicy
    decision_policy_def: Option<Box<DecisionPolicyDef>>,
    // For DeferralPolicy
    deferral_policy_def: Option<Box<DeferralPolicyDef>>,
    // For TransitionPolicy
    transition_policy_def: Option<Box<TransitionPolicyDef>>,
    // For TransitionProtocol
    transition_protocol_def: Option<Box<TransitionProtocolDef>>,
    // For MonitoringPolicy
    monitoring_policy_def: Option<Box<MonitoringPolicyDef>>,
    // For AlternativePolicy
    alternative_policy_def: Option<Box<AlternativePolicyDef>>,
    // For AlternativeFrontier
    alternative_frontier_def: Option<Box<AlternativeFrontierDef>>,
    // For Models
    models_def: Option<Box<ModelsDef>>,
    // For Validation
    validation_def: Option<Box<ValidationDef>>,
    // For Audit
    audit_def: Option<Box<AuditDef>>,
    // For Use
    use_path: AstPath,
