// Bootstrap compiler v0 — zero-import single-file Sounio compiler
// Assembles: lexer + parser + AST + IR types + CodeBuffer + lean driver
// Usage: souc run self-hosted/bootstrap/bootstrap_v0.sio -- <source.sio> <output.elf>
// JIT memory: ~3MB (zero imports = no Rust module loading overhead)

// ============================================================
// Inlined from: self-hosted/lexer/span.sio
// ============================================================
// self-hosted::lexer::span — Source location tracking
//
// Span represents a byte-offset range in source code.
// Used for error messages and diagnostics.
// Impl block provides constructors and utility methods.
struct Span {
    file_id: i32,
    start: i64,
    end: i64,
}
impl Span {
    fn new(file_id: i32, start: i64, end: i64) -> Span {
        Span { file_id: file_id, start: start, end: end }
    }
    fn dummy() -> Span {
        Span { file_id: 0, start: 0, end: 0 }
    }
    fn len(self) -> i64 {
        self.end - self.start
    }
    fn contains(self, pos: i64) -> bool {
        pos >= self.start && pos < self.end
    }
    fn merge(self, other: Span) -> Span with Mut {
        var start = self.start
        if other.start < start {
            start = other.start
        }
        var end = self.end
        if other.end > end {
            end = other.end
        }
        Span { file_id: self.file_id, start: start, end: end }
    }
}

