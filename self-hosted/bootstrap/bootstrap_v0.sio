            i = i + 1
        } else if i < end && cursor_source_byte(i) == 43 {  // '+'
            i = i + 1
        }
        var exp: i64 = 0
        while i < end {
            let ch = cursor_source_byte(i)
            if ch >= 48 && ch <= 57 {
                exp = exp * 10 + (ch - 48) as i64
            } else {
                break
            }
            i = i + 1
        }
        // Apply exponent: result * 10^exp
        var power: f64 = 1.0
        var e = exp
        while e > 0 {
            power = power * 10.0
            e = e - 1
        }
        if exp_negative {
            result = result / power
        } else {
            result = result * power
        }
    }
    result
}
// ============================================================================
// UNIFIED NUMERIC PARSE (dispatches by TokenKind)
// ============================================================================
struct NumericValue {
    int_val: i64,
    float_val: f64,
    is_float: bool,
}
fn parse_numeric(start: i64, end: i64, kind: TokenKind) -> NumericValue with Mut, Div, Panic {
    if kind == TokenKind::FloatLit {
        let v = num_parse_float(start, end)
        return NumericValue { int_val: 0, float_val: v, is_float: true }
    }
    if kind == TokenKind::HexLit {
        let v = num_parse_hex(start, end)
        return NumericValue { int_val: v, float_val: 0.0, is_float: false }
    }
    if kind == TokenKind::BinLit {
        let v = num_parse_binary(start, end)
        return NumericValue { int_val: v, float_val: 0.0, is_float: false }
    }
    if kind == TokenKind::OctLit {
        let v = num_parse_octal(start, end)
        return NumericValue { int_val: v, float_val: 0.0, is_float: false }
    }
    // Default: decimal integer
    let v = num_parse_decimal(start, end)
    NumericValue { int_val: v, float_val: 0.0, is_float: false }
}

