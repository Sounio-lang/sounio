        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 79 as i8 && text[12] == 112 as i8 && text[13] == 116 as i8 && text[14] == 105 as i8 && text[15] == 111 as i8 && text[16] == 110 as i8 { return TokenKind::AlternativeOption }   // "AlternativeOption"
        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 80 as i8 && text[12] == 111 as i8 && text[13] == 108 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 121 as i8 { return TokenKind::AlternativePolicy }   // "AlternativePolicy"
    }
    // Length 18: acquisition_policy, alternative_policy, ObservedTransition
    if len == 18 {
        if text[0] == 79 as i8 && text[1] == 98 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 118 as i8 && text[6] == 101 as i8 && text[7] == 100 as i8 && text[8] == 84 as i8 && text[9] == 114 as i8 && text[10] == 97 as i8 && text[11] == 110 as i8 && text[12] == 115 as i8 && text[13] == 105 as i8 && text[14] == 116 as i8 && text[15] == 105 as i8 && text[16] == 111 as i8 && text[17] == 110 as i8 { return TokenKind::ObservedTransition }   // "ObservedTransition"
        if text[0] == 97 as i8 && text[1] == 99 as i8 && text[2] == 113 as i8 && text[3] == 117 as i8 && text[4] == 105 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 111 as i8 && text[10] == 110 as i8 && text[11] == 95 as i8 && text[12] == 112 as i8 && text[13] == 111 as i8 && text[14] == 108 as i8 && text[15] == 105 as i8 && text[16] == 99 as i8 && text[17] == 121 as i8 { return TokenKind::AcquisitionPolicyLower }   // "acquisition_policy"
        if text[0] == 97 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 95 as i8 && text[12] == 112 as i8 && text[13] == 111 as i8 && text[14] == 108 as i8 && text[15] == 105 as i8 && text[16] == 99 as i8 && text[17] == 121 as i8 { return TokenKind::AlternativePolicyLower }   // "alternative_policy"
    }
    // Length 19: RollbackCertificate
    if len == 19 {
        if text[0] == 82 as i8 && text[1] == 111 as i8 && text[2] == 108 as i8 && text[3] == 108 as i8 && text[4] == 98 as i8 && text[5] == 97 as i8 && text[6] == 99 as i8 && text[7] == 107 as i8 && text[8] == 67 as i8 && text[9] == 101 as i8 && text[10] == 114 as i8 && text[11] == 116 as i8 && text[12] == 105 as i8 && text[13] == 102 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 97 as i8 && text[17] == 116 as i8 && text[18] == 101 as i8 { return TokenKind::RollbackCertificate }   // "RollbackCertificate"
    }
    // Length 20: alternative_frontier
    if len == 20 {
        if text[0] == 97 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 95 as i8 && text[12] == 102 as i8 && text[13] == 114 as i8 && text[14] == 111 as i8 && text[15] == 110 as i8 && text[16] == 116 as i8 && text[17] == 105 as i8 && text[18] == 101 as i8 && text[19] == 114 as i8 { return TokenKind::AlternativeFrontierLower }   // "alternative_frontier"
    }
    // Length 5: route
    if len == 5 {
        if text[0] == 114 as i8 && text[1] == 111 as i8 && text[2] == 117 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 { return TokenKind::Route }   // "route"
    }
    TokenKind::Ident
}
// ============================================================================
// SCAN RESULT
// ============================================================================
struct ScanResult {
    cursor: Cursor,
    kind: TokenKind,
    start: i64,
    end: i64,
    text: [i8; 256],
    text_len: i64,
}
impl ScanResult {
    fn new(cur: Cursor, kind: TokenKind, start: i64, end: i64) -> ScanResult {
        ScanResult {
            cursor: cur,
            kind: kind,
            start: start,
            end: end,
            text: [0; 256],
            text_len: 0,
        }
    }
    fn with_text(cur: Cursor, kind: TokenKind, start: i64, end: i64, text: [i8; 256], text_len: i64) -> ScanResult {
        ScanResult {
            cursor: cur,
            kind: kind,
            start: start,
            end: end,
            text: text,
            text_len: text_len,
        }
    }
}
// ============================================================================
// OPERATOR SCANNING (longest match)
// ============================================================================
fn scan_operator(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error
    let c1 = cur.current
    let c2 = cur.peek()
    let c3 = cur.peek_n(2)
    // 3-char operators
    if c1 == 46 && c2 == 46 && c3 == 46 {  // "..."
        cur = cur.advance_n(3)
        kind = TokenKind::DotDotDot
    } else if c1 == 46 && c2 == 46 && c3 == 61 {  // "..="
        cur = cur.advance_n(3)
        kind = TokenKind::DotDotEq
    } else if c1 == 60 && c2 == 60 && c3 == 61 {  // "<<="
        cur = cur.advance_n(3)
        kind = TokenKind::ShlEq
    } else if c1 == 62 && c2 == 62 && c3 == 61 {  // ">>="
        cur = cur.advance_n(3)
        kind = TokenKind::ShrEq
    }
    // 2-char operators
    else if c1 == 61 && c2 == 61 {  // "=="
        cur = cur.advance_n(2)
        kind = TokenKind::EqEq
    } else if c1 == 33 && c2 == 61 {  // "!="
        cur = cur.advance_n(2)
        kind = TokenKind::BangEq
    } else if c1 == 60 && c2 == 61 {  // "<="
        cur = cur.advance_n(2)
        kind = TokenKind::LtEq
    } else if c1 == 62 && c2 == 61 {  // ">="
        cur = cur.advance_n(2)
        kind = TokenKind::GtEq
    } else if c1 == 38 && c2 == 38 {  // "&&"
        cur = cur.advance_n(2)
        kind = TokenKind::AmpAmp
    } else if c1 == 124 && c2 == 124 {  // "||"
        cur = cur.advance_n(2)
        kind = TokenKind::PipePipe
    } else if c1 == 60 && c2 == 60 {  // "<<"
        cur = cur.advance_n(2)
        kind = TokenKind::Shl
    } else if c1 == 62 && c2 == 62 {  // ">>"
        cur = cur.advance_n(2)
        kind = TokenKind::Shr
    } else if c1 == 43 && c2 == 61 {  // "+="
        cur = cur.advance_n(2)
        kind = TokenKind::PlusEq
    } else if c1 == 45 && c2 == 61 {  // "-="
        cur = cur.advance_n(2)
        kind = TokenKind::MinusEq
    } else if c1 == 42 && c2 == 61 {  // "*="
        cur = cur.advance_n(2)
        kind = TokenKind::StarEq
    } else if c1 == 47 && c2 == 61 {  // "/="
        cur = cur.advance_n(2)
        kind = TokenKind::SlashEq
    } else if c1 == 37 && c2 == 61 {  // "%="
        cur = cur.advance_n(2)
        kind = TokenKind::PercentEq
    } else if c1 == 38 && c2 == 61 {  // "&="
        cur = cur.advance_n(2)
        kind = TokenKind::AmpEq
    } else if c1 == 124 && c2 == 61 {  // "|="
        cur = cur.advance_n(2)
        kind = TokenKind::PipeEq
    } else if c1 == 94 && c2 == 61 {  // "^="
        cur = cur.advance_n(2)
        kind = TokenKind::CaretEq
    } else if c1 == 45 && c2 == 62 {  // "->"
        cur = cur.advance_n(2)
        kind = TokenKind::Arrow
    } else if c1 == 61 && c2 == 62 {  // "=>"
        cur = cur.advance_n(2)
        kind = TokenKind::FatArrow
    } else if c1 == 60 && c2 == 45 {  // "<-"
        cur = cur.advance_n(2)
        kind = TokenKind::LeftArrow
    } else if c1 == 38 && c2 == 33 {  // "&!"
        cur = cur.advance_n(2)
        kind = TokenKind::AmpBang
    } else if c1 == 58 && c2 == 58 {  // "::"
        cur = cur.advance_n(2)
        kind = TokenKind::ColonColon
    } else if c1 == 46 && c2 == 46 {  // ".."
        cur = cur.advance_n(2)
        kind = TokenKind::DotDot
    } else if c1 == 43 && c2 == 43 {  // "++"
        cur = cur.advance_n(2)
        kind = TokenKind::PlusPlus
    } else if c1 == 43 && c2 == 45 {  // "+-" (±)
        cur = cur.advance_n(2)
        kind = TokenKind::PlusMinus
    }
    // 1-char operators
    else if c1 == 43 {  // "+"
        cur = cur.advance()
        kind = TokenKind::Plus
    } else if c1 == 45 {  // "-"
        cur = cur.advance()
        kind = TokenKind::Minus
    } else if c1 == 42 {  // "*"
        cur = cur.advance()
        kind = TokenKind::Star
    } else if c1 == 47 {  // "/"
        cur = cur.advance()
        kind = TokenKind::Slash
    } else if c1 == 37 {  // "%"
        cur = cur.advance()
        kind = TokenKind::Percent
    } else if c1 == 61 {  // "="
        cur = cur.advance()
        kind = TokenKind::Eq
    } else if c1 == 60 {  // "<"
        cur = cur.advance()
        kind = TokenKind::Lt
    } else if c1 == 62 {  // ">"
        cur = cur.advance()
        kind = TokenKind::Gt
    } else if c1 == 33 {  // "!"
        cur = cur.advance()
        kind = TokenKind::Bang
    } else if c1 == 38 {  // "&"
        cur = cur.advance()
        kind = TokenKind::Amp
    } else if c1 == 124 {  // "|"
        cur = cur.advance()
        kind = TokenKind::Pipe
    } else if c1 == 94 {  // "^"
        cur = cur.advance()
        kind = TokenKind::Caret
    } else if c1 == 126 {  // "~"
        cur = cur.advance()
        kind = TokenKind::Tilde
    } else if c1 == 63 {  // "?"
        cur = cur.advance()
        kind = TokenKind::Question
    }
    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}
// ============================================================================
// DELIMITER AND PUNCTUATION SCANNING
// ============================================================================
fn scan_delimiter(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error
    var matched = false
    let ch = cur.current
    if ch == 40 { kind = TokenKind::LParen; matched = true }
    else if ch == 41 { kind = TokenKind::RParen; matched = true }
    else if ch == 123 { kind = TokenKind::LBrace; matched = true }
    else if ch == 125 { kind = TokenKind::RBrace; matched = true }
    else if ch == 91 { kind = TokenKind::LBracket; matched = true }
    else if ch == 93 { kind = TokenKind::RBracket; matched = true }
    if matched {
        cur = cur.advance()
    }
    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}
fn scan_punctuation(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error
    var matched = false
    let ch = cur.current
    if ch == 59 { kind = TokenKind::Semi; matched = true }
    else if ch == 58 { kind = TokenKind::Colon; matched = true }
    else if ch == 44 { kind = TokenKind::Comma; matched = true }
    else if ch == 46 { kind = TokenKind::Dot; matched = true }
    else if ch == 64 { kind = TokenKind::At; matched = true }
    else if ch == 35 { kind = TokenKind::Hash; matched = true }
    if matched {
        cur = cur.advance()
    }
    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}

// ============================================================
// Inlined from: self-hosted/lexer/cursor.sio
// ============================================================
// self-hosted::lexer::cursor — Character-level source code iteration
//
// Cursor tracks position, line, and column through source bytes.
// All character comparisons use ASCII i8 values.
// Impl block provides navigation methods; character classification
// remains as free functions.
// ============================================================================
// CURSOR STATE
// ============================================================================
// Keep source storage out of Cursor values so advance/peek operations do not
// copy a 1MB array on each call.
var CURSOR_SOURCE: [i8; 1048576] = [0; 1048576]
var CURSOR_SOURCE_LEN: i64 = 0
fn cursor_set_source(source: [i8; 1048576], len: i64) with Mut, Panic, Div {
    var n = len
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }
    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = source[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
}
fn cursor_source_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < CURSOR_SOURCE_LEN {
        CURSOR_SOURCE[idx as usize]
    } else {
        0 as i8
    }
}
struct Cursor {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}
struct BumpResult {
    cursor: Cursor,
    text: [i8; 256],
    text_len: i64,
}
// ============================================================================
// CHARACTER CLASSIFICATION
// ============================================================================
fn is_whitespace(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8  // space, tab, CR (not LF)
}
fn is_whitespace_or_newline(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8 || c == 10 as i8
}
fn is_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 57 as i8  // '0'-'9'
}
fn is_hex_digit(c: i8) -> bool {
    is_digit(c) || (c >= 97 as i8 && c <= 102 as i8) || (c >= 65 as i8 && c <= 70 as i8)  // 0-9, a-f, A-F
}
fn is_bin_digit(c: i8) -> bool {
    c == 48 as i8 || c == 49 as i8  // '0' or '1'
}
fn is_oct_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 55 as i8  // '0'-'7'
}
fn is_alpha(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) || (c >= 97 as i8 && c <= 122 as i8)  // A-Z, a-z
}
fn is_ident_start(c: i8) -> bool {
    is_alpha(c) || c == 95 as i8  // letters or '_'
}
fn is_ident_continue(c: i8) -> bool {
    is_alpha(c) || is_digit(c) || c == 95 as i8  // letters, digits, or '_'
}
fn is_operator_start(c: i8) -> bool {
    c == 43 as i8 || c == 45 as i8 || c == 42 as i8 || c == 47 as i8 || c == 37 as i8 ||  // + - * / %
    c == 61 as i8 || c == 60 as i8 || c == 62 as i8 || c == 33 as i8 || c == 38 as i8 ||  // = < > ! &
    c == 124 as i8 || c == 94 as i8 || c == 126 as i8 || c == 63 as i8               // | ^ ~ ?
}
fn is_delimiter(c: i8) -> bool {
    c == 40 as i8 || c == 41 as i8 || c == 123 as i8 || c == 125 as i8 ||  // ( ) { }
    c == 91 as i8 || c == 93 as i8                                // [ ]
}
fn is_punctuation(c: i8) -> bool {
    c == 59 as i8 || c == 58 as i8 || c == 44 as i8 || c == 46 as i8 ||  // ; : , .
    c == 64 as i8 || c == 35 as i8                             // @ #
}
// ============================================================================
// CURSOR METHODS
// ============================================================================
impl Cursor {
    fn new() -> Cursor {
        Cursor {
            source_len: 0,
            pos: 0,
            line: 1,
            col: 1,
            current: 0 as i8,
        }
    }
    fn init(source: [i8; 1048576], len: i64) -> Cursor with Mut, Panic {
        var c = Cursor::new()
        cursor_set_source(source, len)
        c.source_len = CURSOR_SOURCE_LEN
        if c.source_len > 0 {
            c.current = CURSOR_SOURCE[0]
        }
        c
    }
    fn is_eof(self) -> bool {
        self.pos >= self.source_len
    }
    fn peek(self) -> i8 with Panic {
        if self.pos + 1 < self.source_len {
            CURSOR_SOURCE[(self.pos + 1) as usize]
        } else {
            0 as i8
        }
    }
    fn peek_n(self, n: i64) -> i8 with Panic {
        if self.pos + n < self.source_len {
            CURSOR_SOURCE[(self.pos + n) as usize]
        } else {
            0 as i8
        }
    }
    fn advance(self) -> Cursor with Mut, Panic {
        var nc = self
        if nc.pos < nc.source_len {
            if nc.current == 10 as i8 {  // '\n'
                nc.line = nc.line + 1
                nc.col = 1
            } else {
                nc.col = nc.col + 1
            }
            nc.pos = nc.pos + 1
            if nc.pos < nc.source_len {
                nc.current = CURSOR_SOURCE[nc.pos as usize]
            } else {
                nc.current = 0 as i8
            }
        }
        nc
    }
    fn advance_n(self, n: i64) -> Cursor with Mut, Div, Panic {
        var cur = self
        var i: i64 = 0
        while i < n {
            cur = cur.advance()
            i = i + 1
        }
        cur
    }
    fn bump_while_ident(self) -> BumpResult with Mut, Div, Panic {
        var cur = self
        var text: [i8; 256] = [0; 256]
        var idx: i64 = 0
        while !cur.is_eof() && is_ident_continue(cur.current) && idx < 256 {
            text[idx as usize] = cur.current
            idx = idx + 1
            cur = cur.advance()
        }
        BumpResult { cursor: cur, text: text, text_len: idx }
    }
    fn bump_while_digit(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }
    fn bump_while_hex(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_hex_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }
}

// ============================================================
// Inlined from: self-hosted/lexer/mod.sio
// ============================================================
// self-hosted::lexer::mod — Main lexer entry point
//
// Tokenizes Sounio source code into a flat token array.
// Handles: identifiers, keywords, numbers (int/float/hex/bin/oct with suffixes),
// strings, chars, line comments, nestable block comments, doc comments,
// operators (max-munch), delimiters, and epistemic operators.
//
// LexerState uses impl block for constructors and emission.
// All token kinds use the TokenKind enum; error kinds use LexErrorKind.
// ============================================================================
// LEXER STATE
// ============================================================================
// Maximum tokens per file
let MAX_TOKENS: i64 = 1048576
// Maximum errors per file
let MAX_ERRORS: i64 = 256
struct LexerState {
    cursor: Cursor,
    file_id: i32,
    tokens: [Token; 1048576],
    token_count: i64,
    errors: [LexError; 256],
    error_count: i64,
}
impl LexerState {
    fn new(source: [i8; 1048576], source_len: i64, file_id: i32) -> LexerState with Mut, Panic {
        LexerState {
            cursor: Cursor::init(source, source_len),
            file_id: file_id,
            tokens: [Token::new(); 1048576],
            token_count: 0,
            errors: [LexError::new(LexErrorKind::None, 0, 0, 0); 256],
            error_count: 0,
        }
    }
    fn emit_token(self, tok: Token) -> LexerState with Mut, Panic {
        var s = self
        if s.token_count < MAX_TOKENS {
            s.tokens[s.token_count as usize] = tok
            s.token_count = s.token_count + 1
        }
        s
    }
    fn emit_error(self, err: LexError) -> LexerState with Mut, Panic {
        var s = self
        if s.error_count < MAX_ERRORS {
            s.errors[s.error_count as usize] = err
            s.error_count = s.error_count + 1
        }
        s
    }
}
// ============================================================================
// WHITESPACE AND COMMENT HANDLING
// ============================================================================
fn skip_whitespace(c: Cursor) -> Cursor with Mut, Div, Panic {
    var cur = c
    while !cur.is_eof() && is_whitespace(cur.current) {
        cur = cur.advance()
    }
    cur
}
fn skip_line_comment(c: Cursor) -> Cursor with Mut, Div, Panic {
    var cur = c
    while !cur.is_eof() && cur.current != 10 {  // until '\n'
        cur = cur.advance()
    }
    cur
}
// Skip block comment with nesting support: /* ... /* inner */ ... */
struct SkipBlockResult {
    cursor: Cursor,
    unterminated: bool,
}
fn skip_block_comment(c: Cursor) -> SkipBlockResult with Mut, Div, Panic {
    var cur = c.advance_n(2)  // skip /*
    var depth: i64 = 1
    while !cur.is_eof() && depth > 0 {
        if cur.current == 42 && cur.peek() == 47 {  // */
            cur = cur.advance_n(2)
            depth = depth - 1
        } else if cur.current == 47 && cur.peek() == 42 {  // /* (nested)
            cur = cur.advance_n(2)
            depth = depth + 1
        } else {
            cur = cur.advance()
        }
    }
    SkipBlockResult { cursor: cur, unterminated: depth > 0 }
}
// ============================================================================
// IDENTIFIER AND KEYWORD SCANNING
// ============================================================================
fn scan_identifier(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    let line = cur.line
    let col = cur.col
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    while !cur.is_eof() && is_ident_continue(cur.current) && text_idx < 256 {
        text[text_idx as usize] = cur.current
        text_idx = text_idx + 1
        cur = cur.advance()
    }
    let end = cur.pos
    let kind = keyword_lookup(text, text_idx)
    ScanResult::with_text(cur, kind, start, end, text, text_idx)
}
// ============================================================================
// NUMBER SCANNING (int, float, hex, bin, oct, suffixes)
// ============================================================================
fn scan_number(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::IntLit
    // Check for 0x, 0b, 0o prefixes
    if cur.current == 48 {  // '0'
        let next = cur.peek()
        if next == 120 || next == 88 {  // 'x' or 'X'
            cur = cur.advance_n(2)
            cur = cur.bump_while_hex()
            // Allow underscore separators
            while !cur.is_eof() && (is_hex_digit(cur.current) || cur.current == 95) {
                cur = cur.advance()
            }
            kind = TokenKind::HexLit
            // Check for suffix (u8, u16, u32, u64, i8, i16, i32, i64)
            cur = skip_numeric_suffix(cur)
            let end = cur.pos
            return ScanResult::new(cur, kind, start, end)
        }
        if next == 98 || next == 66 {  // 'b' or 'B'
            cur = cur.advance_n(2)
            while !cur.is_eof() && (is_bin_digit(cur.current) || cur.current == 95) {
                cur = cur.advance()
            }
            kind = TokenKind::BinLit
            cur = skip_numeric_suffix(cur)
            let end = cur.pos
            return ScanResult::new(cur, kind, start, end)
        }
        if next == 111 || next == 79 {  // 'o' or 'O'
            cur = cur.advance_n(2)
            while !cur.is_eof() && (is_oct_digit(cur.current) || cur.current == 95) {
                cur = cur.advance()
            }
            kind = TokenKind::OctLit
            cur = skip_numeric_suffix(cur)
            let end = cur.pos
            return ScanResult::new(cur, kind, start, end)
        }
    }
    // Decimal digits (with underscore separators)
    while !cur.is_eof() && (is_digit(cur.current) || cur.current == 95) {
        cur = cur.advance()
    }
    // Check for decimal point (but not ".." range)
    if !cur.is_eof() && cur.current == 46 {  // '.'
        let after_dot = cur.peek()
        if is_digit(after_dot) {
            // Float: consume dot and fractional part
            cur = cur.advance()
            while !cur.is_eof() && (is_digit(cur.current) || cur.current == 95) {
                cur = cur.advance()
            }
            kind = TokenKind::FloatLit
        }
        // If next is '.' it's a range operator, don't consume
    }
    // Scientific notation: e/E followed by optional +/- and digits
    if !cur.is_eof() && (cur.current == 101 || cur.current == 69) {  // 'e' or 'E'
        let after_e = cur.peek()
        if is_digit(after_e) || after_e == 43 || after_e == 45 {  // digit, '+', '-'
            cur = cur.advance()  // consume 'e'
            if !cur.is_eof() && (cur.current == 43 || cur.current == 45) {
                cur = cur.advance()  // consume sign
            }
            while !cur.is_eof() && is_digit(cur.current) {
                cur = cur.advance()
            }
            kind = TokenKind::FloatLit
        }
    }
    // Numeric suffix: i8, i16, i32, i64, u8, u16, u32, u64, f32, f64
    cur = skip_numeric_suffix(cur)
    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}
fn skip_numeric_suffix(c: Cursor) -> Cursor with Mut, Div, Panic {
    var cur = c
    if cur.is_eof() { return cur }
    // Check for i/u/f suffix
    let ch = cur.current
    if ch == 105 || ch == 117 || ch == 102 {  // 'i', 'u', 'f'
        let n1 = cur.peek()
        let n2 = cur.peek_n(2)
        // f32, f64
        if ch == 102 {
            if n1 == 51 && n2 == 50 { cur = cur.advance_n(3) }   // "f32"
            else if n1 == 54 && n2 == 52 { cur = cur.advance_n(3) }  // "f64"
        }
        // i8, i16, i32, i64
        if ch == 105 {
            if n1 == 56 { cur = cur.advance_n(2) }                      // "i8"
            else if n1 == 49 && n2 == 54 { cur = cur.advance_n(3) }     // "i16"
            else if n1 == 51 && n2 == 50 { cur = cur.advance_n(3) }     // "i32"
            else if n1 == 54 && n2 == 52 { cur = cur.advance_n(3) }     // "i64"
        }
        // u8, u16, u32, u64
        if ch == 117 {
            if n1 == 56 { cur = cur.advance_n(2) }                      // "u8"
            else if n1 == 49 && n2 == 54 { cur = cur.advance_n(3) }     // "u16"
            else if n1 == 51 && n2 == 50 { cur = cur.advance_n(3) }     // "u32"
            else if n1 == 54 && n2 == 52 { cur = cur.advance_n(3) }     // "u64"
        }
    }
    cur
}
// ============================================================================
// STRING SCANNING (with escape processing)
// ============================================================================
fn scan_string(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    cur = cur.advance()  // skip opening '"'
    while !cur.is_eof() && cur.current != 34 && text_idx < 255 {  // '"'
        if cur.current == 92 {  // backslash
            cur = cur.advance()  // skip '\'
            if !cur.is_eof() {
                let esc = cur.current
                // Translate escape sequences
                if esc == 110 { text[text_idx as usize] = 10 }       // \n -> LF
                else if esc == 116 { text[text_idx as usize] = 9 }   // \t -> TAB
                else if esc == 114 { text[text_idx as usize] = 13 }  // \r -> CR
                else if esc == 92 { text[text_idx as usize] = 92 }   // \\ -> backslash
                else if esc == 34 { text[text_idx as usize] = 34 }   // \" -> quote
                else if esc == 48 { text[text_idx as usize] = 0 }    // \0 -> null
                else { text[text_idx as usize] = esc }               // unknown escape: keep as-is
                text_idx = text_idx + 1
                cur = cur.advance()
            }
        } else {
            text[text_idx as usize] = cur.current
            text_idx = text_idx + 1
            cur = cur.advance()
        }
    }
    var unterminated = true
    if !cur.is_eof() && cur.current == 34 {
        cur = cur.advance()  // skip closing '"'
        unterminated = false
    }
    let end = cur.pos
    if unterminated {
        ScanResult::with_text(cur, TokenKind::Error, start, end, text, text_idx)
    } else {
        ScanResult::with_text(cur, TokenKind::StringLit, start, end, text, text_idx)
    }
}
// ============================================================================
// CHAR LITERAL SCANNING
// ============================================================================
fn scan_char_literal(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    cur = cur.advance()  // skip opening '\''
    // Handle escape sequence
    if !cur.is_eof() && cur.current == 92 {  // backslash
        cur = cur.advance()  // skip '\'
        if !cur.is_eof() {
            cur = cur.advance()  // skip escaped char
        }
    } else if !cur.is_eof() {
        cur = cur.advance()  // regular char
    }
    // Expect closing quote
    if !cur.is_eof() && cur.current == 39 {  // '\''
        cur = cur.advance()
    }
    let end = cur.pos
    ScanResult::new(cur, TokenKind::CharLit, start, end)
}
// ============================================================================
// DOC COMMENT SCANNING
// ============================================================================
fn scan_doc_comment_line(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocOuter
    if is_inner {
        kind = TokenKind::DocInner
        cur = cur.advance_n(3)  // skip //!
    } else {
        cur = cur.advance_n(3)  // skip ///
    }
    // Collect text until newline
    while !cur.is_eof() && cur.current != 10 && text_idx < 256 {
        text[text_idx as usize] = cur.current
        text_idx = text_idx + 1
        cur = cur.advance()
    }
    let end = cur.pos
    ScanResult::with_text(cur, kind, start, end, text, text_idx)
}
fn scan_doc_comment_block(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocBlockOuter
    if is_inner {
        kind = TokenKind::DocBlockInner
    }
    cur = cur.advance_n(3)  // skip /** or /*!
    while !cur.is_eof() && text_idx < 256 {
        if cur.current == 42 && cur.peek() == 47 {  // */
            cur = cur.advance_n(2)
            break
        }
        text[text_idx as usize] = cur.current
        text_idx = text_idx + 1
        cur = cur.advance()
    }
    let end = cur.pos
    ScanResult::with_text(cur, kind, start, end, text, text_idx)
}
// ============================================================================
// MAIN LEXER LOOP
// ============================================================================
pub fn lex(source: [i8; 1048576], source_len: i64, file_id: i32) -> LexerState with Mut, Div, Panic {
    var state = LexerState::new(source, source_len, file_id)
    while !state.cursor.is_eof() {
        let ch = state.cursor.current
        // Skip non-newline whitespace
        if is_whitespace(ch) {
            state.cursor = skip_whitespace(state.cursor)
            continue
        }
        // Newline (significant for some contexts)
        if ch == 10 {  // '\n'
            state.cursor = state.cursor.advance()
            continue
        }
        // Comments: // and /* (check before operator scanning)
        if ch == 47 {  // '/'
            let next = state.cursor.peek()
            // Doc comment: /// (but not ////)
            if next == 47 {
                let third = state.cursor.peek_n(2)
                if third == 47 && state.cursor.peek_n(3) != 47 {
                    let result = scan_doc_comment_line(state.cursor, false)
                    state.cursor = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, state.cursor.line, state.cursor.col)
                    if state.token_count < MAX_TOKENS {
                        let tok_idx = state.token_count
                        state.tokens[tok_idx as usize] = tok
                        parser_set_token_at(tok_idx, tok)
                        state.token_count = tok_idx + 1
                    }
                    continue
                }
                // Inner doc comment: //!
                if third == 33 {  // '!'
                    let result = scan_doc_comment_line(state.cursor, true)
                    state.cursor = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, state.cursor.line, state.cursor.col)
                    if state.token_count < MAX_TOKENS {
                        let tok_idx = state.token_count
                        state.tokens[tok_idx as usize] = tok
                        parser_set_token_at(tok_idx, tok)
                        state.token_count = tok_idx + 1
                    }
                    continue
                }
                // Regular line comment
                state.cursor = skip_line_comment(state.cursor)
                continue
            }
            // Block doc comment: /** or /*!
            if next == 42 {  // '*'
                let third = state.cursor.peek_n(2)
                if third == 42 && state.cursor.peek_n(3) != 47 {  // /** but not /**/
                    let result = scan_doc_comment_block(state.cursor, false)
                    state.cursor = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, state.cursor.line, state.cursor.col)
                    if state.token_count < MAX_TOKENS {
                        let tok_idx = state.token_count
                        state.tokens[tok_idx as usize] = tok
                        parser_set_token_at(tok_idx, tok)
                        state.token_count = tok_idx + 1
                    }
                    continue
                }
                if third == 33 {  // /*!
                    let result = scan_doc_comment_block(state.cursor, true)
                    state.cursor = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, state.cursor.line, state.cursor.col)
                    if state.token_count < MAX_TOKENS {
                        let tok_idx = state.token_count
                        state.tokens[tok_idx as usize] = tok
                        parser_set_token_at(tok_idx, tok)
                        state.token_count = tok_idx + 1
                    }
                    continue
                }
                // Regular block comment (nestable)
                let block_result = skip_block_comment(state.cursor)
                state.cursor = block_result.cursor
                if block_result.unterminated {
                    let err = LexError::new(LexErrorKind::UnterminatedBlockComment, state.cursor.pos, state.cursor.line, state.cursor.col)
                    if state.error_count < MAX_ERRORS {
                        state.errors[state.error_count as usize] = err
                        state.error_count = state.error_count + 1
                    }
                }
                continue
            }
            // Not a comment — fall through to operator scanning
        }
        // String literal: "..."
        if ch == 34 {  // '"'
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_string(state.cursor)
            state.cursor = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            if result.kind == TokenKind::Error {
                let err = LexError::new(LexErrorKind::UnterminatedString, result.start, line, col)
                if state.error_count < MAX_ERRORS {
                    state.errors[state.error_count as usize] = err
                    state.error_count = state.error_count + 1
                }
            }
            continue
        }
        // Char literal: '.'
        if ch == 39 {  // '\''
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_char_literal(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Numeric literals: 0-9
        if is_digit(ch) {
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_number(state.cursor)
            state.cursor = result.cursor
            let nv = parse_numeric(result.start, result.end, result.kind)
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if nv.is_float {
                tok.float_value = nv.float_val
            } else {
                tok.int_value = nv.int_val
            }
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Identifiers and keywords: a-z, A-Z, _
        if is_ident_start(ch) {
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_identifier(state.cursor)
            state.cursor = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Operators (check before delimiters for multi-char operators like .., ::, etc.)
        // Dot needs special handling: could be '.', '..', '..=', '...'
        if ch == 46 {  // '.'
            let next = state.cursor.peek()
            if next == 46 {
                // ".." or "..=" or "..."
                let line = state.cursor.line
                let col = state.cursor.col
                let result = scan_operator(state.cursor)
                state.cursor = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if state.token_count < MAX_TOKENS {
                    let tok_idx = state.token_count
                    state.tokens[tok_idx as usize] = tok
                    parser_set_token_at(tok_idx, tok)
                    state.token_count = tok_idx + 1
                }
                continue
            }
            // Single dot -> punctuation
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_punctuation(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Colon: could be ':' or '::'
        if ch == 58 {  // ':'
            let next = state.cursor.peek()
            if next == 58 {
                let line = state.cursor.line
                let col = state.cursor.col
                let result = scan_operator(state.cursor)
                state.cursor = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if state.token_count < MAX_TOKENS {
                    let tok_idx = state.token_count
                    state.tokens[tok_idx as usize] = tok
                    parser_set_token_at(tok_idx, tok)
                    state.token_count = tok_idx + 1
                }
                continue
            }
            // Single colon -> punctuation
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_punctuation(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Other operators
        if is_operator_start(ch) {
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_operator(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Delimiters: ( ) { } [ ]
        if is_delimiter(ch) {
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_delimiter(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Remaining punctuation: ; , @ #
        if is_punctuation(ch) {
            let line = state.cursor.line
            let col = state.cursor.col
            let result = scan_punctuation(state.cursor)
            state.cursor = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if state.token_count < MAX_TOKENS {
                let tok_idx = state.token_count
                state.tokens[tok_idx as usize] = tok
                parser_set_token_at(tok_idx, tok)
                state.token_count = tok_idx + 1
            }
            continue
        }
        // Unknown character
        let err = LexError::with_char(LexErrorKind::UnexpectedChar, state.cursor.pos, state.cursor.line, state.cursor.col, ch)
        if state.error_count < MAX_ERRORS {
            state.errors[state.error_count as usize] = err
            state.error_count = state.error_count + 1
        }
        state.cursor = state.cursor.advance()
    }
    // Emit EOF token
    let eof_tok = Token::eof(state.cursor.pos, state.cursor.line, state.cursor.col)
    if state.token_count < MAX_TOKENS {
        let tok_idx = state.token_count
        state.tokens[tok_idx as usize] = eof_tok
        parser_set_token_at(tok_idx, eof_tok)
        state.token_count = tok_idx + 1
    }
    state
}

// ============================================================
// Inlined from: self-hosted/parser/ast.sio
// ============================================================
// Self-hosted Sounio AST types
// Uses tagged structs with Option<Box<T>> for recursive children
// and linked lists for sequences (Vec<T> unavailable for user types).
// ============================================================
// Node ID
// ============================================================
struct NodeId { id: i64 }
fn next_node_id(current: i64) -> NodeId {
    NodeId { id: current + 1 }
}
// ============================================================
// Linked-list containers for AST node sequences
// ============================================================
struct ExprList {
    label: Name,
    head: Expr,
    tail: Option<Box<ExprList>>,
}
struct StmtList {
    head: Stmt,
    tail: Option<Box<StmtList>>,
}
struct ItemList {
    head: Item,
    tail: Option<Box<ItemList>>,
}
struct ParamList {
    head: Param,
    tail: Option<Box<ParamList>>,
}
struct ClosureParam {
    name: Name,
    ty: TypeExpr,
    span: Span,
}
struct ClosureParamList {
    head: ClosureParam,
    tail: Option<Box<ClosureParamList>>,
}
struct FieldDefList {
    head: FieldDef,
    tail: Option<Box<FieldDefList>>,
}
struct VariantDefList {
    head: VariantDef,
    tail: Option<Box<VariantDefList>>,
}
struct MatchArmList {
    head: MatchArm,
    tail: Option<Box<MatchArmList>>,
}
struct StructFieldList {
    head: StructFieldInit,
    tail: Option<Box<StructFieldList>>,
}
struct EffectList {
    head: EffectRef,
    tail: Option<Box<EffectList>>,
}
struct TypeExprList {
    head: TypeExpr,
    tail: Option<Box<TypeExprList>>,
}
struct StringList {
    head_buf: [i8; 384],
    head_len: i64,
    tail: Option<Box<StringList>>,
}
struct PatternList {
    head: Pattern,
    tail: Option<Box<PatternList>>,
}
struct PatFieldList {
    head: PatField,
    tail: Option<Box<PatFieldList>>,
}
// ============================================================
// String buffer helper (for identifiers, paths)
// ============================================================
struct Name {
    buf: [i8; 384],
    len: i64,
}
// ============================================================
// Path: qualified name like Foo::Bar::baz
// ============================================================
struct AstPath {
    segments: StringList,
    seg_count: i64,
}
struct AstPathList {
    head: AstPath,
    tail: Option<Box<AstPathList>>,
}
// ============================================================
// Effect reference: IO, Mut, Alloc, Panic, Div, GPU, Prob, Async
// ============================================================
struct EffectRef {
    name_buf: [i8; 64],
    name_len: i64,
}
// ============================================================
// Expressions
// ============================================================
enum ExprKind {
    // Literals
    ExprIntLit,
    ExprFloatLit,
    ExprBoolTrue,
    ExprBoolFalse,
    ExprStringLit,
    ExprCharLit,
    // Names
    ExprIdent,
    ExprPath,
    // Operators
    ExprBinary,
    ExprUnary,
    // Access
    ExprFieldAccess,
    ExprIndex,
    ExprMethodCall,
    // Calls
    ExprCall,
    // Control flow
    ExprIf,
    ExprMatch,
    ExprWhile,
    ExprLoop,
    ExprBlock,
    ExprReturn,
    ExprBreak,
    ExprContinue,
    // Constructors
    ExprStructLit,
    ExprArrayLit,
    ExprTupleLit,
    ExprContest,
    ExprAuditAttach,
    // Range
    ExprRange,
    // Type cast
    ExprCast,
    // Effect handler: handle<Effect> { body } { handlers }
    ExprHandle,
    // Closure: |params| body
    ExprClosure,
    // For-in: for x in iter { body }
    ExprForIn,
    // Error placeholder
    ExprError,
}
enum UnaryOp {
    OpNeg,
    OpNot,
    OpRef,
    OpRefMut,
    OpDeref,
}
enum BinaryOp {
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
    OpConcat,
    OpRange,
    OpRangeInclusive,
}
struct Expr {
    kind: ExprKind,
    span: Span,
    // For IntLit, CharLit
    int_val: i64,
    // For FloatLit
    float_val: f64,
    // For StringLit, Ident, FieldAccess (field name), MethodCall (method name)
    name: Name,
    // For Path, StructLit
    path: AstPath,
    // For Binary
    bin_op: BinaryOp,
    // For Unary
    un_op: UnaryOp,
    // For Binary(left,right), Unary(operand), FieldAccess(base),
    // Index(base), MethodCall(base), Call(callee), If(condition),
    // Match(scrutinee), While(condition), Return(value), Break(value)
    left: Option<Box<Expr>>,
    // For Binary(right), Index(index)
    right: Option<Box<Expr>>,
    // For If(then), While(body), Loop(body), Block
    block: Option<Box<Block>>,
    // For If(else)
    else_expr: Option<Box<Expr>>,
    // For Call(args), MethodCall(args), ArrayLit(elements), TupleLit(elements)
    args: Option<Box<ExprList>>,
    // For Match
    arms: Option<Box<MatchArmList>>,
    // For StructLit
    fields: Option<Box<StructFieldList>>,
    // For Cast (as)
    cast_type: Option<Box<TypeExpr>>,
    // For Handle: handler implementation block (with { ... })
    handler_block: Option<Box<Block>>,
    // For Closure:
    closure_params: Option<Box<ClosureParamList>>,
    closure_return: Option<Box<TypeExpr>>,
    closure_effects: Option<Box<EffectList>>,
    closure_body: Option<Box<Expr>>,
}
// ============================================================
// Blocks
// ============================================================
struct Block {
    stmts: Option<Box<StmtList>>,
    span: Span,
}
// ============================================================
// Statements
// ============================================================
enum StmtKind {
    StmtLet,
    StmtVar,
    StmtExpr,
    StmtAssign,
}
enum AssignOp {
    AssignEq,
    AssignAdd,
    AssignSub,
    AssignMul,
    AssignDiv,
    AssignRem,
}
struct Stmt {
    kind: StmtKind,
    span: Span,
    // For Let/Var: binding name
    name: Name,
    // For Let/Var: optional type annotation
    ty: Option<Box<TypeExpr>>,
    // For Let/Var: initializer; Expr: the expression; Assign: RHS
    expr: Option<Box<Expr>>,
    // For Assign: target (LHS)
    target: Option<Box<Expr>>,
    // For Assign: operator
    assign_op: AssignOp,
}
// ============================================================
// Match arms
// ============================================================
struct MatchArm {
    pattern: Pattern,
    body: Expr,
    span: Span,
}
// ============================================================
// Struct field initializer (in struct literals)
// ============================================================
struct StructFieldInit {
    name: Name,
    value: Expr,
}
// ============================================================
// Patterns
// ============================================================
enum PatternKind {
    PatWildcard,
    PatBinding,
    PatIntLit,
    PatBoolTrue,
    PatBoolFalse,
    PatStringLit,
    PatEnum,
    PatStruct,
    PatTuple,
    PatOr,
}
struct Pattern {
    kind: PatternKind,
    span: Span,
    // For Binding, IntLit, StringLit
    name: Name,
    // For IntLit
    int_val: i64,
    // For Enum: variant path
    path: AstPath,
    // For Enum: inner patterns; Tuple: elements; Or: alternatives
    sub_patterns: Option<Box<PatternList>>,
    // For Struct: field patterns
    pat_fields: Option<Box<PatFieldList>>,
    // For Binding: mutable?
    is_mut: bool,
}
struct PatField {
    name: Name,
    pattern: Pattern,
}
// ============================================================
// Import item list (for selective imports: use path::{A, B})
// ============================================================
struct ImportItemList {
    head: Name,
    tail: Option<Box<ImportItemList>>,
}
