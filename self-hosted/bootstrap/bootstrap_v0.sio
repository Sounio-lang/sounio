fn tk_is_causal_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Counterfactual => true,
        TokenKind::Validated => true,
        TokenKind::Session => true,
        TokenKind::Chan => true,
        TokenKind::Send => true,
        TokenKind::Recv => true,
        TokenKind::Close => true,
        TokenKind::Dual => true,
        TokenKind::MaxSteps => true,
        _ => false,
    }
}
