// file_read.sio — Wave 10 self-hosted file reading helpers.

struct FrdFile {
    buf: [i64; 65536],
    len: i64,
    pos: i64,
    error: i64,
}

struct FrdLine {
    chars: [i64; 4096],
    len: i64,
}

fn FRD_OK() -> i64 { 0 }
fn FRD_EOF() -> i64 { 1 }
fn FRD_ERR_NOT_FOUND() -> i64 { 2 }
fn FRD_ERR_PERM() -> i64 { 3 }
fn FRD_ERR_TOO_LARGE() -> i64 { 4 }

fn frd_file_empty_with_error(err: i64) -> FrdFile with Mut {
    FrdFile {
        buf: [0; 65536],
        len: 0,
        pos: 0,
        error: err,
    }
}

fn frd_line_new() -> FrdLine with Mut {
    FrdLine {
        chars: [0; 4096],
        len: 0,
    }
}

fn frd_line_clear(line: &! FrdLine) -> () with Mut {
    line.len = 0
}

fn frd_open(path: string) -> FrdFile with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size < 0 {
        return frd_file_empty_with_error(FRD_ERR_NOT_FOUND())
    }
    if size > 65536 {
        return frd_file_empty_with_error(FRD_ERR_TOO_LARGE())
    }

    let raw = read_file(path)
    var out = frd_file_empty_with_error(FRD_OK())
    var i: i64 = 0
    while i < size && i < 65536 {
        out.buf[i as usize] = raw[i as usize] as i64
        i = i + 1
    }
    out.len = i
    out
}

fn frd_read_byte(f: &! FrdFile) -> i64 with Mut, Panic {
    if f.pos >= f.len {
        f.error = FRD_EOF()
        return 0 - 1
    }
    let b = f.buf[f.pos as usize]
    f.pos = f.pos + 1
    if f.pos >= f.len {
        f.error = FRD_EOF()
    } else {
        f.error = FRD_OK()
    }
    b
}

fn frd_read_line(f: &! FrdFile, line: &! FrdLine) -> i64 with Mut, Panic, Div {
    line.len = 0
    if f.pos >= f.len {
        f.error = FRD_EOF()
        return 0
    }

    var read: i64 = 0
    while f.pos < f.len && line.len < 4096 {
        let ch = f.buf[f.pos as usize]
        f.pos = f.pos + 1
        if ch == 10 {
            break
        }
        line.chars[line.len as usize] = ch
        line.len = line.len + 1
        read = read + 1
    }

    if f.pos >= f.len {
        f.error = FRD_EOF()
    } else {
        f.error = FRD_OK()
    }
    read
}

fn frd_read_all(path: string) -> FrdFile with IO, Mut, Panic, Div {
    frd_open(path)
}

fn frd_at_eof(f: &FrdFile) -> bool {
    f.pos >= f.len
}

fn frd_error(f: &FrdFile) -> i64 {
    f.error
}

fn frd_close(f: &! FrdFile) -> () with Mut {
    f.pos = f.len
    f.error = FRD_OK()
}

fn frd_file_size(path: string) -> i64 with IO, Panic {
    file_size(path)
}

fn frd_file_exists(path: string) -> bool with IO {
    file_size(path) >= 0
}

fn frd_line_to_string(line: &FrdLine) -> string with Mut, Panic, Div {
    var out: [i8; 4096] = [0; 4096]
    var i: i64 = 0
    while i < line.len && i < 4096 {
        out[i as usize] = line.chars[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn frd_make_sample_file(seed: i64) -> FrdFile with Mut, Panic, Div {
    var f = frd_file_empty_with_error(FRD_OK())
    var n = 24 + (seed % 17)
    if n < 8 {
        n = 8
    }
    if n > 120 {
        n = 120
    }

    var i: i64 = 0
    while i < n && i < 65536 {
        var ch = 97 + ((seed + i) % 26)
        if i == (n / 2) {
            ch = 10
        }
        f.buf[i as usize] = ch
        i = i + 1
    }
    f.len = i
    f
}

fn frd_test_template(seed: i64) -> bool with Mut, Panic, Div {
    var local = frd_make_sample_file(seed)
    let b0 = frd_read_byte(&! local)
    b0 >= 0
}

fn test_001_frd_cycle_001() -> bool with Mut, Panic, Div {
    var local = frd_make_sample_file(1)
    let b0 = frd_read_byte(&! local)
    if b0 < 0 { return false }
    if b0 > 255 { return false }
    frd_test_template(1)
}

