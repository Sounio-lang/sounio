fn io_write_gpu_caps_json(path: string, caps: GpuCapability) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p1 = io_trace_append_string(buf, p, "\"has_gpu\":")
    buf = p1.0; p = p1.1
    let p2 = io_trace_append_string(buf, p, io_trace_bool_string(caps.has_gpu))
    buf = p2.0; p = p2.1
    let p3 = io_trace_append_string(buf, p, ",\"device_name\":\"")
    buf = p3.0; p = p3.1
    let p4 = io_trace_append_string(buf, p, caps.device_name)
    buf = p4.0; p = p4.1
    let p5 = io_trace_append_string(buf, p, "\",\"compute_units\":")
    buf = p5.0; p = p5.1
    let p6 = io_trace_append_string(buf, p, io_trace_i64_string(caps.compute_units))
    buf = p6.0; p = p6.1
    let p7 = io_trace_append_string(buf, p, ",\"max_workgroup_size\":")
    buf = p7.0; p = p7.1
    let p8 = io_trace_append_string(buf, p, io_trace_i64_string(caps.max_workgroup_size))
    buf = p8.0; p = p8.1
    let p9 = io_trace_append_string(buf, p, ",\"supports_f64\":")
    buf = p9.0; p = p9.1
    let p10 = io_trace_append_string(buf, p, io_trace_bool_string(caps.supports_f64))
    buf = p10.0; p = p10.1
    let p11 = io_trace_append_string(buf, p, ",\"driver_version\":\"")
    buf = p11.0; p = p11.1
    let p12 = io_trace_append_string(buf, p, caps.driver_version)
    buf = p12.0; p = p12.1
    let p13 = io_trace_append_string(buf, p, "\"")
    buf = p13.0; p = p13.1
    let p14 = io_trace_append_byte(buf, p, 125)
    buf = p14.0; p = p14.1
    let p15 = io_trace_append_byte(buf, p, 10)
    buf = p15.0; p = p15.1
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_export_metadata_json(path: string, meta: ExportMetadata) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p0a = io_trace_append_byte(buf, p, 34)
    buf = p0a.0; p = p0a.1
    let p0b = io_trace_append_string(buf, p, "exports")
    buf = p0b.0; p = p0b.1
    let p0c = io_trace_append_byte(buf, p, 34)
    buf = p0c.0; p = p0c.1
    let p0d = io_trace_append_string(buf, p, ":[")
    buf = p0d.0; p = p0d.1
    var i: i64 = 0
    while i < meta.count {
        if i > 0 {
            let pc = io_trace_append_byte(buf, p, 44)
            buf = pc.0; p = pc.1
        }
        let pa = io_trace_append_byte(buf, p, 123)
        buf = pa.0; p = pa.1
        let pa1 = io_trace_append_byte(buf, p, 34)
        buf = pa1.0; p = pa1.1
        let pa2 = io_trace_append_string(buf, p, "name")
        buf = pa2.0; p = pa2.1
        let pa3 = io_trace_append_byte(buf, p, 34)
        buf = pa3.0; p = pa3.1
        let pa4 = io_trace_append_string(buf, p, ":")
        buf = pa4.0; p = pa4.1
        let pa5 = io_trace_append_byte(buf, p, 34)
        buf = pa5.0; p = pa5.1
        let pb = io_trace_append_string(buf, p, meta.names[i as usize])
        buf = pb.0; p = pb.1
        let pb1 = io_trace_append_byte(buf, p, 34)
        buf = pb1.0; p = pb1.1
        let pd = io_trace_append_string(buf, p, ",")
        buf = pd.0; p = pd.1
        let pd1 = io_trace_append_byte(buf, p, 34)
        buf = pd1.0; p = pd1.1
        let pd2 = io_trace_append_string(buf, p, "strategy")
        buf = pd2.0; p = pd2.1
        let pd3 = io_trace_append_byte(buf, p, 34)
        buf = pd3.0; p = pd3.1
        let pd4 = io_trace_append_string(buf, p, ":")
        buf = pd4.0; p = pd4.1
        let pe = io_trace_append_string(buf, p, io_trace_i64_string(meta.strategies[i as usize]))
        buf = pe.0; p = pe.1
        let pf = io_trace_append_byte(buf, p, 125)
        buf = pf.0; p = pf.1
        i = i + 1
    }
    let pg = io_trace_append_string(buf, p, "],")
    buf = pg.0; p = pg.1
    let pg1 = io_trace_append_byte(buf, p, 34)
    buf = pg1.0; p = pg1.1
    let pg2 = io_trace_append_string(buf, p, "count")
    buf = pg2.0; p = pg2.1
    let pg3 = io_trace_append_byte(buf, p, 34)
    buf = pg3.0; p = pg3.1
    let pg4 = io_trace_append_string(buf, p, ":")
    buf = pg4.0; p = pg4.1
    let ph = io_trace_append_string(buf, p, io_trace_i64_string(meta.count))
    buf = ph.0; p = ph.1
    let pi = io_trace_append_byte(buf, p, 125)
    buf = pi.0; p = pi.1
    let pj = io_trace_append_byte(buf, p, 10)
    buf = pj.0; p = pj.1
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_provenance_json(path: string, prov: KernelProvenance) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1

    let p1 = io_trace_append_string(buf, p, "\"source_hash\":")
    buf = p1.0; p = p1.1
    let p2 = io_trace_append_string(buf, p, io_trace_i64_string(prov.source_hash))
    buf = p2.0; p = p2.1
    let p3 = io_trace_append_string(buf, p, ",")
    buf = p3.0; p = p3.1

    let p4 = io_trace_append_string(buf, p, "\"abi_version\":")
    buf = p4.0; p = p4.1
    let p5 = io_trace_append_string(buf, p, io_trace_i64_string(prov.abi_version))
    buf = p5.0; p = p5.1
    let p6 = io_trace_append_string(buf, p, ",")
    buf = p6.0; p = p6.1

    let p7 = io_trace_append_string(buf, p, "\"optimize\":")
    buf = p7.0; p = p7.1
    let p8 = io_trace_append_string(buf, p, io_trace_bool_string(prov.optimize))
    buf = p8.0; p = p8.1
    let p9 = io_trace_append_string(buf, p, ",")
    buf = p9.0; p = p9.1

    let p10 = io_trace_append_string(buf, p, "\"function_count\":")
    buf = p10.0; p = p10.1
    let p11 = io_trace_append_string(buf, p, io_trace_i64_string(prov.function_count))
    buf = p11.0; p = p11.1
    let p12 = io_trace_append_string(buf, p, ",")
    buf = p12.0; p = p12.1

    let p13 = io_trace_append_string(buf, p, "\"ir_instruction_count\":")
    buf = p13.0; p = p13.1
    let p14 = io_trace_append_string(buf, p, io_trace_i64_string(prov.ir_instruction_count))
    buf = p14.0; p = p14.1

    let p15 = io_trace_append_byte(buf, p, 125)
    buf = p15.0; p = p15.1
    let p16 = io_trace_append_byte(buf, p, 10)
    buf = p16.0; p = p16.1

    io_write_bytes_to_file(path, buf, p)
}


pub(crate) fn io_write_kernel_response_json(path: string, resp: KernelResponse) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
