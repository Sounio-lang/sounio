// file_write.sio — Shared file I/O helpers for self-hosted compile flows.

fn io_write_bytes_to_file(path: string, data: [i8; 4194304], len: i64) -> bool with IO {
    let result = write_file(path, data, len)
    result == 0
}

fn io_write_elf_to_file(path: string, elf: Elf64Binary) -> bool with IO, Mut {
    io_write_bytes_to_file(path, elf.bytes, elf.len)
}

fn io_read_source_file(path: string) -> LexerState with IO, Mut, Div, Panic {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    // Use reference-backed writes to avoid copying sparse array storage.
    let buf_ref = &!buf
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf_ref[i as usize] = data[i as usize]
        i = i + 1
    }
    lex(buf, size, 0)
}
