// file_write.sio — Shared file I/O helpers for self-hosted compile flows.

module io::file_write

use native::elf::{Elf64Binary}
use ir::ir::{SOUNIO_ABI_VERSION, SOUNIO_RUNTIME_VERSION_MAJOR, SOUNIO_RUNTIME_VERSION_MINOR, SOUNIO_RUNTIME_VERSION_PATCH}
use interop::contract::{KernelResponse, KernelDiagnostics, KernelProvenance, ExportMetadata, GpuCapability, PromotionSummary}
use io::trace::{io_trace_append_byte_mut, io_trace_append_string_mut, io_trace_append_json_string_mut, io_trace_bool_string, io_trace_i64_string, io_write_bytes_to_file}
// NOTE: lexer::mod import removed to avoid transitive parser::ast::* stack overflow.
// io_read_source_file (which needs LexerState) moved to io::source_reader.sio.

pub fn io_write_elf_to_file(path: string, elf: Elf64Binary) -> bool with IO, Mut {
    let result = write_file(path, elf.bytes, elf.len)
    result >= 0
}

pub fn io_write_native_binary(path: string, bytes: [i8; 65536], len: i64) -> bool with IO {
    io_write_bytes_to_file(path, bytes, len)
}

fn io_write_wide_binary(path: string, bytes: [i8; 262144], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result >= 0
}

pub fn io_write_meg_binary(path: string, bytes: [i8; 1048576], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result >= 0
}

pub fn io_write_huge_binary(path: string, bytes: [i8; 16777216], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result >= 0
}

// K-AXI artifacts are 2MB (KaxiAsmBuf.data is [i8; 2097152]); sits between
// io_write_meg_binary (1MB) and io_write_huge_binary (16MB).
pub fn io_write_kaxi_binary(path: string, bytes: [i8; 2097152], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result >= 0
}

pub fn io_make_executable(path: string) -> bool with IO {
    syscall6(90, path, 493, 0, 0, 0, 0) >= 0
}


pub fn io_write_native_decision_trace(
    path: string,
    requested_target: string,
    resolved_target: string,
    matrix_mode: string,
    source: string,
    fallback_reason: string,
    backend: string,
    ok: bool,
    error_code: i64
) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    p = io_trace_append_byte_mut(&! buf, p, 123) // {

    p = io_trace_append_string_mut(&! buf, p, "\"requested_target\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, requested_target)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"resolved_target\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, resolved_target)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"matrix_mode\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, matrix_mode)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"source\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, source)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"fallback_reason\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, fallback_reason)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"backend\":\"")
    p = io_trace_append_json_string_mut(&! buf, p, backend)
    p = io_trace_append_string_mut(&! buf, p, "\",")

    p = io_trace_append_string_mut(&! buf, p, "\"ok\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_bool_string(ok))
    p = io_trace_append_string_mut(&! buf, p, ",")

    p = io_trace_append_string_mut(&! buf, p, "\"error_code\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(error_code))

    p = io_trace_append_byte_mut(&! buf, p, 125) // }
    p = io_trace_append_byte_mut(&! buf, p, 10)  // newline

    io_write_bytes_to_file(path, buf, p)
}



fn io_write_diagnostics_json(path: string, diags: KernelDiagnostics) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, "diagnostics")
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, ":[")
    var i: i64 = 0
    while i < diags.count {
        if i > 0 {
            p = io_trace_append_byte_mut(&! buf, p, 44)
        }
        p = io_trace_append_byte_mut(&! buf, p, 123)
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "severity")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(diags.items[i as usize].severity))
        p = io_trace_append_string_mut(&! buf, p, ",")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "line")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(diags.items[i as usize].line))
        p = io_trace_append_string_mut(&! buf, p, ",")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "code")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(diags.items[i as usize].code))
        p = io_trace_append_byte_mut(&! buf, p, 125)
        i = i + 1
    }
    p = io_trace_append_string_mut(&! buf, p, "]}")
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_promotions_json(path: string, summary: PromotionSummary) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, "promotions")
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, ":[")
    var i: i64 = 0
    while i < summary.count {
        if i > 0 {
            p = io_trace_append_byte_mut(&! buf, p, 44)
        }
        p = io_trace_append_byte_mut(&! buf, p, 123)
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "count")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(summary.records[i as usize].call_count))
        p = io_trace_append_string_mut(&! buf, p, ",")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "new_strategy")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(summary.records[i as usize].new_strategy))
        p = io_trace_append_byte_mut(&! buf, p, 125)
        i = i + 1
    }
    p = io_trace_append_string_mut(&! buf, p, "]}")
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_gpu_caps_json(path: string, caps: GpuCapability) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_string_mut(&! buf, p, "\"has_gpu\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_bool_string(caps.has_gpu))
    p = io_trace_append_string_mut(&! buf, p, ",\"device_name\":\"")
    p = io_trace_append_string_mut(&! buf, p, caps.device_name)
    p = io_trace_append_string_mut(&! buf, p, "\",\"compute_units\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(caps.compute_units))
    p = io_trace_append_string_mut(&! buf, p, ",\"max_workgroup_size\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(caps.max_workgroup_size))
    p = io_trace_append_string_mut(&! buf, p, ",\"supports_f64\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_bool_string(caps.supports_f64))
    p = io_trace_append_string_mut(&! buf, p, ",\"driver_version\":\"")
    p = io_trace_append_string_mut(&! buf, p, caps.driver_version)
    p = io_trace_append_string_mut(&! buf, p, "\"")
    p = io_trace_append_byte_mut(&! buf, p, 125)
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_export_metadata_json(path: string, meta: ExportMetadata) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, "exports")
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, ":[")
    var i: i64 = 0
    while i < meta.count {
        if i > 0 {
            p = io_trace_append_byte_mut(&! buf, p, 44)
        }
        p = io_trace_append_byte_mut(&! buf, p, 123)
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "name")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, meta.names[i as usize])
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ",")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, "strategy")
        p = io_trace_append_byte_mut(&! buf, p, 34)
        p = io_trace_append_string_mut(&! buf, p, ":")
        p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(meta.strategies[i as usize]))
        p = io_trace_append_byte_mut(&! buf, p, 125)
        i = i + 1
    }
    p = io_trace_append_string_mut(&! buf, p, "],")
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, "count")
    p = io_trace_append_byte_mut(&! buf, p, 34)
    p = io_trace_append_string_mut(&! buf, p, ":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(meta.count))
    p = io_trace_append_byte_mut(&! buf, p, 125)
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_provenance_json(path: string, prov: KernelProvenance) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    p = io_trace_append_byte_mut(&! buf, p, 123)

    p = io_trace_append_string_mut(&! buf, p, "\"source_hash\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(prov.source_hash))
    p = io_trace_append_string_mut(&! buf, p, ",")

    p = io_trace_append_string_mut(&! buf, p, "\"abi_version\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(prov.abi_version))
    p = io_trace_append_string_mut(&! buf, p, ",")

    p = io_trace_append_string_mut(&! buf, p, "\"optimize\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_bool_string(prov.optimize))
    p = io_trace_append_string_mut(&! buf, p, ",")

    p = io_trace_append_string_mut(&! buf, p, "\"function_count\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(prov.function_count))
    p = io_trace_append_string_mut(&! buf, p, ",")

    p = io_trace_append_string_mut(&! buf, p, "\"ir_instruction_count\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(prov.ir_instruction_count))

    p = io_trace_append_byte_mut(&! buf, p, 125)
    p = io_trace_append_byte_mut(&! buf, p, 10)

    io_write_bytes_to_file(path, buf, p)
}


pub fn io_write_kernel_response_json(path: string, resp: KernelResponse) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_string_mut(&! buf, p, "\"ok\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_bool_string(resp.ok))
    p = io_trace_append_string_mut(&! buf, p, ",")
    p = io_trace_append_string_mut(&! buf, p, "\"artifact_path\":\"")
    p = io_trace_append_string_mut(&! buf, p, resp.artifact_path)
    p = io_trace_append_string_mut(&! buf, p, "\",")
    p = io_trace_append_string_mut(&! buf, p, "\"artifact_size\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(resp.artifact_size))
    p = io_trace_append_string_mut(&! buf, p, ",")
    p = io_trace_append_string_mut(&! buf, p, "\"error_code\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(resp.error_code))
    p = io_trace_append_string_mut(&! buf, p, ",")
    p = io_trace_append_string_mut(&! buf, p, "\"abi_version\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(resp.abi_version))
    p = io_trace_append_string_mut(&! buf, p, ",")
    p = io_trace_append_string_mut(&! buf, p, "\"function_count\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(resp.function_count))
    p = io_trace_append_byte_mut(&! buf, p, 125)
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

pub fn io_write_version_json(path: string) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    p = io_trace_append_byte_mut(&! buf, p, 123)
    p = io_trace_append_string_mut(&! buf, p, "\"abi_version\":")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(SOUNIO_ABI_VERSION))
    p = io_trace_append_string_mut(&! buf, p, ",")
    p = io_trace_append_string_mut(&! buf, p, "\"runtime_version\":\"")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_MAJOR))
    p = io_trace_append_string_mut(&! buf, p, ".")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_MINOR))
    p = io_trace_append_string_mut(&! buf, p, ".")
    p = io_trace_append_string_mut(&! buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_PATCH))
    p = io_trace_append_string_mut(&! buf, p, "\",")
    p = io_trace_append_string_mut(&! buf, p, "\"ir_max_funcs\":1024,")
    p = io_trace_append_string_mut(&! buf, p, "\"ir_max_instrs\":128,")
    p = io_trace_append_string_mut(&! buf, p, "\"supports_ffi\":true,")
    p = io_trace_append_string_mut(&! buf, p, "\"supports_gpu\":false")
    p = io_trace_append_byte_mut(&! buf, p, 125)
    p = io_trace_append_byte_mut(&! buf, p, 10)
    io_write_bytes_to_file(path, buf, p)
}

// io_read_source_file removed — was unused and required lexer::mod import
// which transitively pulls parser::ast::* (stack overflow trigger).
// If needed, re-add in a separate module that can tolerate the import cost.
