        let pb4 = io_trace_append_string(buf, p, ":")
        buf = pb4.0; p = pb4.1
        let pb5 = io_trace_append_string(buf, p, io_trace_i64_string(summary.records[i as usize].new_strategy))
        buf = pb5.0; p = pb5.1
        let pd = io_trace_append_byte(buf, p, 125)
        buf = pd.0; p = pd.1
        i = i + 1
    }
    let pe = io_trace_append_string(buf, p, "]}")
    buf = pe.0; p = pe.1
    let pf = io_trace_append_byte(buf, p, 10)
