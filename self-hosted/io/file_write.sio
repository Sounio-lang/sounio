pub(crate) fn io_write_version_json(path: string) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p1 = io_trace_append_string(buf, p, "\"abi_version\":")
    buf = p1.0; p = p1.1
    let p2 = io_trace_append_string(buf, p, io_trace_i64_string(SOUNIO_ABI_VERSION))
    buf = p2.0; p = p2.1
    let p3 = io_trace_append_string(buf, p, ",")
    buf = p3.0; p = p3.1
    let p4 = io_trace_append_string(buf, p, "\"runtime_version\":\"")
    buf = p4.0; p = p4.1
    let p5 = io_trace_append_string(buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_MAJOR))
    buf = p5.0; p = p5.1
    let p6 = io_trace_append_string(buf, p, ".")
    buf = p6.0; p = p6.1
    let p7 = io_trace_append_string(buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_MINOR))
    buf = p7.0; p = p7.1
    let p8 = io_trace_append_string(buf, p, ".")
    buf = p8.0; p = p8.1
    let p9 = io_trace_append_string(buf, p, io_trace_i64_string(SOUNIO_RUNTIME_VERSION_PATCH))
    buf = p9.0; p = p9.1
    let p10 = io_trace_append_string(buf, p, "\",")
    buf = p10.0; p = p10.1
    let p11 = io_trace_append_string(buf, p, "\"ir_max_funcs\":1024,")
    buf = p11.0; p = p11.1
    let p12 = io_trace_append_string(buf, p, "\"ir_max_instrs\":128,")
    buf = p12.0; p = p12.1
    let p13 = io_trace_append_string(buf, p, "\"supports_ffi\":true,")
    buf = p13.0; p = p13.1
    let p14 = io_trace_append_string(buf, p, "\"supports_gpu\":false")
    buf = p14.0; p = p14.1
    let p15 = io_trace_append_byte(buf, p, 125)
    buf = p15.0; p = p15.1
    let p16 = io_trace_append_byte(buf, p, 10)
    buf = p16.0; p = p16.1
    io_write_bytes_to_file(path, buf, p)
}

// io_read_source_file removed — was unused and required lexer::mod import
// which transitively pulls parser::ast::* (stack overflow trigger).
// If needed, re-add in a separate module that can tolerate the import cost.
