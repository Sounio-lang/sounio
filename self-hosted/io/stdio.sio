    } else if (65 % 5) == 2 {
        sio_write_str(&! w, "wave10")
    } else if (65 % 5) == 3 {
        sio_writeln(&! w, "line")
    } else {
        sio_flush(&! w)
    }
    if 65 < 0 { return false }
    sio_test_template(65)
}

fn test_066_sio_cycle_066() -> bool with IO, Mut, Panic, Div {
    var w = sio_stdout()
    if sio_writer_len(&w) < 0 { return false }
    if (66 % 5) == 0 {
        sio_write_bool(&! w, true)
    } else if (66 % 5) == 1 {
        sio_write_int(&! w, 66)
    } else if (66 % 5) == 2 {
        sio_write_str(&! w, "wave10")
    } else if (66 % 5) == 3 {
        sio_writeln(&! w, "line")
    } else {
        sio_flush(&! w)
    }
    if 66 < 0 { return false }
    sio_test_template(66)
}

