// stdio.sio — Wave 10 buffered stdio helpers.

struct SioWriter {
    buf: [i64; 65536],
    len: i64,
    fd: i64,
}

struct SioReader {
    buf: [i64; 4096],
    len: i64,
    pos: i64,
}

fn SIO_STDIN() -> i64 { 0 }
fn SIO_STDOUT() -> i64 { 1 }
fn SIO_STDERR() -> i64 { 2 }

fn sio_writer_new(fd: i64) -> SioWriter with Mut {
    SioWriter {
        buf: [0; 65536],
        len: 0,
        fd: fd,
    }
}

fn sio_reader_new() -> SioReader with Mut {
    SioReader {
        buf: [0; 4096],
        len: 0,
        pos: 0,
    }
}

fn sio_stdout() -> SioWriter with Mut {
    sio_writer_new(SIO_STDOUT())
}

fn sio_stderr() -> SioWriter with Mut {
    sio_writer_new(SIO_STDERR())
}

fn sio_write_str(w: &! SioWriter, s: string) -> () with Mut, Panic, Div {
    var i: i64 = 0
    let n = str_len(s)
    while i < n && w.len < 65536 {
        w.buf[w.len as usize] = str_char_at(s, i)
        w.len = w.len + 1
        i = i + 1
    }
}

fn sio_write_int(w: &! SioWriter, n: i64) -> () with Mut, Panic, Div {
    var value = n
    if value == 0 {
        if w.len < 65536 {
            w.buf[w.len as usize] = 48
            w.len = w.len + 1
        }
        return
    }

    var neg: bool = false
    if value < 0 {
        neg = true
        value = 0 - value
    }

    var digits: [i64; 32] = [0; 32]
    var dlen: i64 = 0
    while value > 0 && dlen < 32 {
        digits[dlen as usize] = 48 + (value % 10)
        dlen = dlen + 1
        value = value / 10
    }

    if neg && w.len < 65536 {
        w.buf[w.len as usize] = 45
        w.len = w.len + 1
    }

    var i = dlen - 1
    while dlen > 0 {
        if w.len < 65536 {
            w.buf[w.len as usize] = digits[i as usize]
            w.len = w.len + 1
        }
        if i == 0 { break }
        i = i - 1
    }
}

fn sio_write_bool(w: &! SioWriter, b: bool) -> () with Mut, Panic {
    if b {
        if w.len < 65536 { w.buf[w.len as usize] = 116; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 114; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 117; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 101; w.len = w.len + 1 }
    } else {
        if w.len < 65536 { w.buf[w.len as usize] = 102; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 97; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 108; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 115; w.len = w.len + 1 }
        if w.len < 65536 { w.buf[w.len as usize] = 101; w.len = w.len + 1 }
    }
}

fn sio_writeln(w: &! SioWriter, s: string) -> () with Mut, Panic, Div {
    var i: i64 = 0
    let n = str_len(s)
    while i < n && w.len < 65536 {
        w.buf[w.len as usize] = str_char_at(s, i)
        w.len = w.len + 1
        i = i + 1
    }
    if w.len < 65536 {
        w.buf[w.len as usize] = 10
        w.len = w.len + 1
    }
}

fn sio_flush(w: &! SioWriter) -> () with IO, Mut, Panic, Div {
    var out: [i8; 65536] = [0; 65536]
    var i: i64 = 0
    while i < w.len && i < 65536 {
        out[i as usize] = w.buf[i as usize] as i8
        i = i + 1
    }
    let s = str_from_bytes(out, i)
    print(s)
    w.len = 0
}

fn sio_print(s: string) -> () with IO, Mut, Panic {
    print(s)
}

fn sio_println(s: string) -> () with IO, Mut, Panic {
    print(s)
    print("\n")
}

fn sio_eprint(s: string) -> () with IO, Mut, Panic {
    print(s)
}

fn sio_eprintln(s: string) -> () with IO, Mut, Panic {
    print(s)
    print("\n")
}

fn sio_stdin_reader() -> SioReader with Mut {
    sio_reader_new()
}

fn sio_read_line(r: &! SioReader) -> string with IO, Mut, Panic, Div {
    var out: [i8; 4096] = [0; 4096]
    var used: i64 = 0
    while r.pos < r.len && used < 4096 {
        let ch = r.buf[r.pos as usize]
        r.pos = r.pos + 1
        if ch == 10 {
            break
        }
        out[used as usize] = ch as i8
        used = used + 1
    }
    str_from_bytes(out, used)
}

fn sio_writer_to_string(w: &SioWriter) -> string with Mut, Panic, Div {
    var out: [i8; 65536] = [0; 65536]
    var i: i64 = 0
    while i < w.len && i < 65536 {
        out[i as usize] = w.buf[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn sio_writer_len(w: &SioWriter) -> i64 {
    w.len
}

fn sio_make_reader_from_string(seed: i64) -> SioReader with Mut, Panic, Div {
    var r = sio_reader_new()
    var i: i64 = 0
    var n = 16 + (seed % 16)
    while i < n && i < 4096 {
        r.buf[i as usize] = 97 + ((seed + i) % 26)
        i = i + 1
    }
    if i < 4096 {
        r.buf[i as usize] = 10
        i = i + 1
    }
    r.len = i
    r
}

fn sio_test_template(seed: i64) -> bool with Mut, Panic, Div {
    var w = sio_stdout()
    if sio_writer_len(&w) != 0 {
        return false
    }
    sio_write_int(&! w, seed)
    true
}

fn test_001_sio_cycle_001() -> bool with IO, Mut, Panic, Div {
    var w = sio_stdout()
    if sio_writer_len(&w) < 0 { return false }
    if (1 % 5) == 0 {
        sio_write_bool(&! w, true)
    } else if (1 % 5) == 1 {
        sio_write_int(&! w, 1)
    } else if (1 % 5) == 2 {
        sio_write_str(&! w, "wave10")
    } else if (1 % 5) == 3 {
        sio_writeln(&! w, "line")
    } else {
        sio_flush(&! w)
    }
    if 1 < 0 { return false }
    sio_test_template(1)
}

