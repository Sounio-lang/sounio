// io::trace — Lightweight trace buffer operations for codegen diagnostics.
//
// Extracted from io::file_write to break a transitive import cycle:
// codegen → file_write → parser::ast::* + lexer::* + native::encode::*
// caused the type checker to overflow its stack (~2000+ symbols).
//
// These functions have NO imports — pure byte-buffer operations.

module io::trace

fn io_write_bytes_to_file(path: string, data: [i8; 65536], len: i64) -> bool with IO {
    let result = write_file(path, data, len)
    result >= 0
}

fn io_trace_append_byte(buf: [i8; 65536], pos: i64, b: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var n = b % 256
    if n < 0 { n = n + 256 }
    if p >= 0 && p < 65536 {
        out[p as usize] = n as i8
        p = p + 1
    }
    (out, p)
}

fn io_trace_append_string(buf: [i8; 65536], pos: i64, s: string) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 65536 {
        out[p as usize] = str_char_at(s, i) as i8
        p = p + 1
        i = i + 1
    }
    (out, p)
}

fn io_trace_append_json_string(buf: [i8; 65536], pos: i64, s: string) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 65536 {
        let ch = str_char_at(s, i)
        if ch == 34 {
            let pair1 = io_trace_append_byte(out, p, 92)
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 34)
            out = pair2.0
            p = pair2.1
        } else if ch == 92 {
            let pair1 = io_trace_append_byte(out, p, 92)
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 92)
            out = pair2.0
            p = pair2.1
        } else if ch == 10 {
            let pair1 = io_trace_append_byte(out, p, 92)
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 110)
            out = pair2.0
            p = pair2.1
        } else if ch == 13 {
            let pair1 = io_trace_append_byte(out, p, 92)
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 114)
            out = pair2.0
            p = pair2.1
        } else if ch == 9 {
            let pair1 = io_trace_append_byte(out, p, 92)
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 116)
            out = pair2.0
            p = pair2.1
        } else {
            let pair = io_trace_append_byte(out, p, ch)
            out = pair.0
            p = pair.1
        }
        i = i + 1
    }
    (out, p)
}

fn io_trace_bool_string(v: bool) -> string {
    if v { "true" } else { "false" }
}

fn io_trace_i64_string(v: i64) -> string with Mut, Panic, Div {
    if v == 0 { return "0" }

    var n = v
    var neg: bool = false
    if n < 0 {
        neg = true
        n = 0 - n
    }

    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    while n > 0 && rev_len < 31 {
        let digit = n % 10
        rev[rev_len as usize] = (48 + digit) as i8
        rev_len = rev_len + 1
        n = n / 10
    }

    var out: [i8; 64] = [0; 64]
    var out_len: i64 = 0
    if neg {
        out[out_len as usize] = 45 as i8
        out_len = out_len + 1
    }

    var i = rev_len - 1
    while i >= 0 {
        out[out_len as usize] = rev[i as usize]
        out_len = out_len + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(out, out_len)
}
