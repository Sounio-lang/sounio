// file_write.sio — File Write API for Self-Hosted Compiler
//
// Provides file writing functionality using VM builtins.
// Used by native backend to write ELF binaries to disk.

// Write raw bytes to a file
//
// Parameters:
//   path: Target file path
//   data: Byte array containing data to write
//   len: Number of bytes to write from data array
//
// Returns:
//   true if write succeeded, false on error
//
// Effects: IO (file system write)
fn write_bytes_to_file(path: string, data: [i8; 131072], len: i64) -> bool with IO {
    // Call the VM builtin write_file
    // This maps to __sounio_write_file FFI function
    let result = write_file(path, data, len)

    // write_file returns 0 on success, -1 on error
    result == 0
}

// Write an ELF binary to disk
//
// Helper function specifically for writing ELF64Binary structs.
// Extracts bytes from Elf64Binary and writes to file with executable permissions.
//
// Parameters:
//   path: Output file path
//   elf: Elf64Binary struct from compile_to_elf()
//
// Returns:
//   true if write succeeded, false on error
fn write_elf_to_file(path: string, elf: Elf64Binary) -> bool with IO, Mut {
    // Convert i8 bytes to proper format if needed
    // ELF bytes are stored in elf.bytes[0..elf.len]

    let success = write_bytes_to_file(path, elf.bytes, elf.len)

    if !success {
        return false
    }

    // TODO: Set executable permissions (+x)
    // For now, caller must chmod +x manually
    // Future: Add set_executable_permission() builtin

    true
}

// Test function: Write "Hello, World!" to /tmp/sounio_test_write.txt
fn test_file_write() -> bool with IO {
    // ASCII bytes for "Hello, World!\n"
    var data: [i8; 131072] = [0; 131072]
    data[0] = 72   // 'H'
    data[1] = 101  // 'e'
    data[2] = 108  // 'l'
    data[3] = 108  // 'l'
    data[4] = 111  // 'o'
    data[5] = 44   // ','
    data[6] = 32   // ' '
    data[7] = 87   // 'W'
    data[8] = 111  // 'o'
    data[9] = 114  // 'r'
    data[10] = 108 // 'l'
    data[11] = 100 // 'd'
    data[12] = 33  // '!'
    data[13] = 10  // '\n'

    write_bytes_to_file("/tmp/sounio_test_write.txt", data, 14)
}
