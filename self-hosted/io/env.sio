// self-hosted::io::env — Environment variable reader
//
// Extracted from native::codegen to break the transitive dependency chain.
// ir/lower.sio needs read_env for trace flags but should not pull in the
// entire codegen module (261KB + macho + pe_coff + aarch64 = 505KB).

module io::env

pub fn read_env(key: string) -> string with IO, Mut, Div, Panic {
    let env_path = "/proc/self/environ"
    // NOTE: file_size() returns 0 for procfs files (the kernel reports st_size=0
    // for /proc/self/environ), so it CANNOT bound the scan. read_file() mmaps a
    // zero-filled buffer and reads the full NUL-delimited environ block into it;
    // byte-indexing sees past the per-entry NULs. Derive the content length by
    // scanning to the boundary double-NUL: the kernel-written content ends at the
    // last entry's NUL, after which the mmap zero-fill yields a second NUL. Env
    // entries are never empty, so the first 0,0 pair is the true end. The 1 MiB cap
    // guards against a pathological missing terminator.
    let data = read_file(env_path)
    let key_len = str_len(key)
    var out: [i8; 512] = [0; 512]
    var out_len: i64 = 0
    if key_len <= 0 {
        return str_from_bytes(out, out_len)
    }
    var size: i64 = 0
    while size < 1048576 {
        if data[size as usize] == 0 && data[(size + 1) as usize] == 0 {
            break
        }
        size = size + 1
    }
    if size <= 0 {
        return str_from_bytes(out, out_len)
    }

    var i: i64 = 0
    while i < size {
        var j: i64 = 0
        var matches: bool = true
        while j < key_len {
            if i + j >= size {
                matches = false
                break
            }
            if data[(i + j) as usize] != (str_char_at(key, j) as i8) {
                matches = false
                break
            }
            j = j + 1
        }

        if matches && i + key_len < size && data[(i + key_len) as usize] == (61 as i8) {
            let value_start = i + key_len + 1
            var value_end = value_start
            while value_end < size && data[value_end as usize] != 0 {
                value_end = value_end + 1
            }

            var k = value_start
            while k < value_end && out_len < 512 {
                out[out_len as usize] = data[k as usize]
                out_len = out_len + 1
                k = k + 1
            }
            return str_from_bytes(out, out_len)
        }

        while i < size && data[i as usize] != 0 {
            i = i + 1
        }
        i = i + 1
    }
    str_from_bytes(out, out_len)
}
