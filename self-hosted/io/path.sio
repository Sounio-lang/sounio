// path.sio — Wave 10 path manipulation helpers.

struct PthBuf {
    chars: [i64; 4096],
    len: i64,
}

struct PthComponents {
    parts: [PthBuf; 64],
    count: i64,
}

fn PTH_SEP() -> i64 { 47 }
fn PTH_DOT() -> i64 { 46 }

fn pth_zero() -> PthBuf {
    PthBuf { chars: [0; 4096], len: 0 }
}

fn pth_components_zero() -> PthComponents {
    PthComponents {
        parts: [pth_zero(); 64],
        count: 0,
    }
}

fn pth_new() -> PthBuf with Mut {
    pth_zero()
}

fn pth_from_str(s: string) -> PthBuf with Mut, Panic, Div {
    var out = pth_zero()
    var i: i64 = 0
    let n = str_len(s)
    while i < n && i < 4096 {
        out.chars[i as usize] = str_char_at(s, i)
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn pth_to_string(p: &PthBuf) -> string with Mut, Panic, Div {
    var out: [i8; 4096] = [0; 4096]
    var i: i64 = 0
    while i < p.len && i < 4096 {
        out[i as usize] = p.chars[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn pth_push(p: &! PthBuf, component: string) -> () with Mut, Panic, Div {
    if p.len > 0 {
        let last = p.chars[(p.len - 1) as usize]
        if last != PTH_SEP() && p.len < 4096 {
            p.chars[p.len as usize] = PTH_SEP()
            p.len = p.len + 1
        }
    }

    var i: i64 = 0
    let n = str_len(component)
    while i < n && p.len < 4096 {
        p.chars[p.len as usize] = str_char_at(component, i)
        p.len = p.len + 1
        i = i + 1
    }
}

fn pth_join(a: &PthBuf, b: &PthBuf) -> PthBuf with Mut, Panic, Div {
    var out = pth_zero()
    var i: i64 = 0
    while i < a.len && out.len < 4096 {
        out.chars[out.len as usize] = a.chars[i as usize]
        out.len = out.len + 1
        i = i + 1
    }

    if out.len > 0 && b.len > 0 {
        let last = out.chars[(out.len - 1) as usize]
        let first = b.chars[0]
        if last != PTH_SEP() && first != PTH_SEP() && out.len < 4096 {
            out.chars[out.len as usize] = PTH_SEP()
            out.len = out.len + 1
        }
    }

    i = 0
    var start: i64 = 0
    if out.len > 0 && b.len > 0 && b.chars[0] == PTH_SEP() {
        start = 1
    }
    i = start
    while i < b.len && out.len < 4096 {
        out.chars[out.len as usize] = b.chars[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn pth_basename(p: &PthBuf) -> string with Panic, Div, Mut {
    let s = pth_to_string(p)
    let n = str_len(s)
    if n == 0 {
        return ""
    }

    var i = n
    while i > 0 {
        let idx = i - 1
        if str_char_at(s, idx) == PTH_SEP() {
            return str_slice(s, idx + 1, n)
        }
        i = idx
    }
    s
}

fn pth_dirname(p: &PthBuf) -> PthBuf with Mut, Panic, Div {
    let s = pth_to_string(p)
    let n = str_len(s)
    if n == 0 {
        return pth_zero()
    }

    var i = n
    while i > 0 {
        let idx = i - 1
        if str_char_at(s, idx) == PTH_SEP() {
            return pth_from_str(str_slice(s, 0, idx))
        }
        i = idx
    }
    pth_zero()
}

fn pth_extension(p: &PthBuf) -> string with Panic, Div, Mut {
    let b = pth_basename(p)
    let n = str_len(b)
    if n == 0 {
        return ""
    }

    var i = n
    while i > 0 {
        let idx = i - 1
        if str_char_at(b, idx) == PTH_DOT() {
            if idx + 1 < n {
                return str_slice(b, idx + 1, n)
            }
            return ""
        }
        i = idx
    }
    ""
}

fn pth_stem(p: &PthBuf) -> string with Panic, Div, Mut {
    let b = pth_basename(p)
    let n = str_len(b)
    if n == 0 {
        return ""
    }

    var i = n
    while i > 0 {
        let idx = i - 1
        if str_char_at(b, idx) == PTH_DOT() {
            return str_slice(b, 0, idx)
        }
        i = idx
    }
    b
}

fn pth_is_absolute(p: &PthBuf) -> bool {
    p.len > 0 && p.chars[0] == PTH_SEP()
}

fn pth_components(p: &PthBuf) -> PthComponents with Mut, Panic, Div {
    var comps = pth_components_zero()
    var cur = pth_zero()
    var i: i64 = 0
    while i < p.len {
        let ch = p.chars[i as usize]
        if ch == PTH_SEP() {
            if cur.len > 0 && comps.count < 64 {
                comps.parts[comps.count as usize] = cur
                comps.count = comps.count + 1
                cur = pth_zero()
            }
        } else {
            if cur.len < 4096 {
                cur.chars[cur.len as usize] = ch
                cur.len = cur.len + 1
            }
        }
        i = i + 1
    }

    if cur.len > 0 && comps.count < 64 {
        comps.parts[comps.count as usize] = cur
        comps.count = comps.count + 1
    }

    comps
}

fn pth_normalize(p: &PthBuf) -> PthBuf with Mut, Panic, Div {
    let comps = pth_components(p)
    var stack: [PthBuf; 64] = [pth_zero(); 64]
    var count: i64 = 0

    var i: i64 = 0
    while i < comps.count {
        let part = comps.parts[i as usize]
        let s = pth_to_string(&part)
        if s == "" || s == "." {
            // Skip empty and current-dir components.
        } else if s == ".." {
            if count > 0 {
                count = count - 1
            }
        } else {
            if count < 64 {
                stack[count as usize] = part
                count = count + 1
            }
        }
        i = i + 1
    }

    var out = pth_zero()
    if pth_is_absolute(p) && out.len < 4096 {
        out.chars[out.len as usize] = PTH_SEP()
        out.len = out.len + 1
    }

    i = 0
    while i < count {
        if out.len > 0 && out.chars[(out.len - 1) as usize] != PTH_SEP() && out.len < 4096 {
            out.chars[out.len as usize] = PTH_SEP()
            out.len = out.len + 1
        }

        let part = stack[i as usize]
        var j: i64 = 0
        while j < part.len && out.len < 4096 {
            out.chars[out.len as usize] = part.chars[j as usize]
            out.len = out.len + 1
            j = j + 1
        }
        i = i + 1
    }

    out
}

fn pth_component_count(c: &PthComponents) -> i64 {
    c.count
}

fn pth_component_get(c: &PthComponents, i: i64) -> string with Panic, Mut, Div {
    if i < 0 || i >= c.count {
        return ""
    }
    pth_to_string(&c.parts[i as usize])
}

fn pth_equals(a: &PthBuf, b: &PthBuf) -> bool with Mut, Panic, Div {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.chars[i as usize] != b.chars[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn pth_starts_with(p: &PthBuf, prefix: &PthBuf) -> bool with Mut, Panic, Div {
    if prefix.len > p.len {
        return false
    }
    var i: i64 = 0
    while i < prefix.len {
        if p.chars[i as usize] != prefix.chars[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn pth_ends_with(p: &PthBuf, suffix: string) -> bool with Panic, Div, Mut {
    let ps = pth_to_string(p)
    let pn = str_len(ps)
    let sn = str_len(suffix)
    if sn > pn {
        return false
    }
    var i: i64 = 0
    while i < sn {
        if str_char_at(ps, pn - sn + i) != str_char_at(suffix, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn pth_strip_prefix(p: &PthBuf, prefix: &PthBuf) -> PthBuf with Mut, Panic, Div {
    if !pth_starts_with(p, prefix) {
        return *p
    }
    var out = pth_zero()
    var i = prefix.len
    if i < p.len && p.chars[i as usize] == PTH_SEP() {
        i = i + 1
    }
    while i < p.len && out.len < 4096 {
        out.chars[out.len as usize] = p.chars[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn pth_with_extension(p: &PthBuf, ext: string) -> PthBuf with Mut, Panic, Div {
    let s = pth_to_string(p)
    let n = str_len(s)
    var dot = n
    var i = n
    while i > 0 {
        let idx = i - 1
        let ch = str_char_at(s, idx)
        if ch == PTH_SEP() {
            break
        }
        if ch == PTH_DOT() {
            dot = idx
            break
        }
        i = idx
    }

    var out = pth_zero()
    i = 0
    while i < dot && out.len < 4096 {
        out.chars[out.len as usize] = str_char_at(s, i)
        out.len = out.len + 1
        i = i + 1
    }

    if str_len(ext) > 0 && out.len < 4096 {
        out.chars[out.len as usize] = PTH_DOT()
        out.len = out.len + 1
    }

    i = 0
    let en = str_len(ext)
    while i < en && out.len < 4096 {
        out.chars[out.len as usize] = str_char_at(ext, i)
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn pth_test_template(seed: i64) -> bool with Mut, Panic, Div {
    var p = pth_from_str("home")
    if seed % 2 == 0 {
        pth_push(&! p, "user")
    }
    let s = pth_to_string(&p)
    str_len(s) >= 0
}

fn test_001_pth_cycle_001() -> bool with Mut, Panic, Div {
    var a = pth_from_str("alpha")
    var b = pth_from_str("beta")
    let joined = pth_join(&a, &b)
    let norm = pth_normalize(&joined)
    let base = pth_basename(&norm)
    let dir = pth_dirname(&norm)
    let extd = pth_with_extension(&norm, "txt")
    if str_len(base) < 0 { return false }
    if pth_component_count(&pth_components(&dir)) < 0 { return false }
    if !pth_ends_with(&extd, "txt") { return false }
    pth_test_template(1)
}

