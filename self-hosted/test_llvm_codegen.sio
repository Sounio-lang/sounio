// Self-hosted LLVM codegen data structure tests
//
// Validates the pure-Sounio parts of the LLVM backend: SSA value maps,
// block maps, function maps, TypeConverter cache, and LlvmCodegenState.
// No LLVM FFI calls — all tests use synthetic values.

// ── Constants ───────────────────────────────────────────────────────

fn llvm_codegen_test_01_max_values() -> bool {
    CODEGEN_MAX_VALUES == 8192
}

fn llvm_codegen_test_02_max_blocks() -> bool {
    CODEGEN_MAX_BLOCKS == 4096
}

fn llvm_codegen_test_03_max_functions() -> bool {
    CODEGEN_MAX_FUNCTIONS == 512
}

fn llvm_codegen_test_04_max_strings() -> bool {
    CODEGEN_MAX_STRINGS == 256
}

fn llvm_codegen_test_05_constants_ordering() -> bool {
    CODEGEN_MAX_VALUES > CODEGEN_MAX_BLOCKS &&
    CODEGEN_MAX_BLOCKS > CODEGEN_MAX_FUNCTIONS &&
    CODEGEN_MAX_FUNCTIONS > CODEGEN_MAX_STRINGS
}

// ── LlvmCodegenState ───────────────────────────────────────────────

fn llvm_codegen_test_06_state_new_opt0() -> bool {
    let s = codegen_state_new(0, false)
    s.opt_level == 0 && !s.debug_info
}

fn llvm_codegen_test_07_state_new_opt2_debug() -> bool {
    let s = codegen_state_new(2, true)
    s.opt_level == 2 && s.debug_info
}

fn llvm_codegen_test_08_state_maps_init() -> bool {
    let s = codegen_state_new(0, false)
    s.values.count == 0 &&
    s.blocks.count == 0 &&
    s.functions.count == 0
}

fn llvm_codegen_test_09_state_type_conv_init() -> bool {
    let s = codegen_state_new(0, false)
    s.type_conv.struct_cache_count == 0
}

// ── SsaValueMap ─────────────────────────────────────────────────────

fn llvm_codegen_test_10_ssa_new_count() -> bool {
    let m = ssa_map_new()
    m.count == 0
}

fn llvm_codegen_test_11_ssa_insert_get() -> bool with Mut, Panic {
    let m0 = ssa_map_new()
    let v = LlvmValue { ptr: 1234 }
    let m1 = ssa_map_insert(m0, 7, v, HlirTypeI32)
    let got = ssa_map_get(m1, 7)
    got.ptr == 1234
}

fn llvm_codegen_test_12_ssa_get_miss() -> bool {
    let m = ssa_map_new()
    let got = ssa_map_get(m, 99)
    got.ptr == 0
}

fn llvm_codegen_test_13_ssa_update_in_place() -> bool with Mut, Panic {
    let m0 = ssa_map_new()
    let m1 = ssa_map_insert(m0, 5, LlvmValue { ptr: 111 }, HlirTypeI32)
    let m2 = ssa_map_insert(m1, 5, LlvmValue { ptr: 222 }, HlirTypeI64)
    let got = ssa_map_get(m2, 5)
    // Update overwrites, count stays 1
    got.ptr == 222 && m2.count == 1
}

fn llvm_codegen_test_14_ssa_multiple_inserts() -> bool with Mut, Panic {
    var m = ssa_map_new()
    m = ssa_map_insert(m, 1, LlvmValue { ptr: 10 }, HlirTypeI32)
    m = ssa_map_insert(m, 2, LlvmValue { ptr: 20 }, HlirTypeI64)
    m = ssa_map_insert(m, 3, LlvmValue { ptr: 30 }, HlirTypeF32)
    m.count == 3 &&
    ssa_map_get(m, 1).ptr == 10 &&
    ssa_map_get(m, 2).ptr == 20 &&
    ssa_map_get(m, 3).ptr == 30
}

fn llvm_codegen_test_15_ssa_clear() -> bool with Mut, Panic {
    var m = ssa_map_new()
    m = ssa_map_insert(m, 1, LlvmValue { ptr: 1 }, HlirTypeI32)
    m = ssa_map_insert(m, 2, LlvmValue { ptr: 2 }, HlirTypeI32)
    m = ssa_map_clear(m)
    m.count == 0
}

// ── BlockMap ────────────────────────────────────────────────────────

fn llvm_codegen_test_16_block_new_count() -> bool {
    let m = block_map_new()
    m.count == 0
}

fn llvm_codegen_test_17_block_insert_get() -> bool with Mut, Panic {
    let m0 = block_map_new()
    let m1 = block_map_insert(m0, 42, LlvmBlock { ptr: 5678 })
    let got = block_map_get(m1, 42)
    got.ptr == 5678
}

fn llvm_codegen_test_18_block_get_miss() -> bool {
    let m = block_map_new()
    let got = block_map_get(m, 100)
    got.ptr == 0
}

fn llvm_codegen_test_19_block_clear() -> bool with Mut, Panic {
    var m = block_map_new()
    m = block_map_insert(m, 1, LlvmBlock { ptr: 10 })
    m = block_map_insert(m, 2, LlvmBlock { ptr: 20 })
    m = block_map_clear(m)
    m.count == 0
}

fn llvm_codegen_test_20_block_multiple() -> bool with Mut, Panic {
    var m = block_map_new()
    m = block_map_insert(m, 10, LlvmBlock { ptr: 100 })
    m = block_map_insert(m, 20, LlvmBlock { ptr: 200 })
    m.count == 2 &&
    block_map_get(m, 10).ptr == 100 &&
    block_map_get(m, 20).ptr == 200
}

// ── FuncMap ─────────────────────────────────────────────────────────

fn llvm_codegen_test_21_func_new_count() -> bool {
    let m = func_map_new()
    m.count == 0
}

fn llvm_codegen_test_22_func_insert_get() -> bool with Mut, Panic {
    let m0 = func_map_new()
    let m1 = func_map_insert(m0, 12345, LlvmValue { ptr: 9999 })
    let got = func_map_get(m1, 12345)
    got.ptr == 9999
}

fn llvm_codegen_test_23_func_get_miss() -> bool {
    let m = func_map_new()
    let got = func_map_get(m, 0)
    got.ptr == 0
}

fn llvm_codegen_test_24_func_multiple() -> bool with Mut, Panic {
    var m = func_map_new()
    m = func_map_insert(m, 100, LlvmValue { ptr: 1000 })
    m = func_map_insert(m, 200, LlvmValue { ptr: 2000 })
    m = func_map_insert(m, 300, LlvmValue { ptr: 3000 })
    m.count == 3 &&
    func_map_get(m, 200).ptr == 2000
}

// ── TypeConverter ───────────────────────────────────────────────────

fn llvm_codegen_test_25_tc_new_count() -> bool {
    let tc = type_converter_new()
    tc.struct_cache_count == 0
}

fn llvm_codegen_test_26_tc_cache_lookup() -> bool with Mut, Panic {
    let tc0 = type_converter_new()
    let tc1 = type_converter_cache_struct(tc0, 42, 888)
    let found = type_converter_lookup_struct(tc1, 42)
    found == 888
}

fn llvm_codegen_test_27_tc_lookup_miss() -> bool {
    let tc = type_converter_new()
    let found = type_converter_lookup_struct(tc, 99)
    found == 0
}

fn llvm_codegen_test_28_tc_count_increments() -> bool with Mut, Panic {
    let tc0 = type_converter_new()
    let tc1 = type_converter_cache_struct(tc0, 1, 100)
    let tc2 = type_converter_cache_struct(tc1, 2, 200)
    tc1.struct_cache_count == 1 && tc2.struct_cache_count == 2
}

fn llvm_codegen_test_29_tc_multiple_lookup() -> bool with Mut, Panic {
    let tc0 = type_converter_new()
    let tc1 = type_converter_cache_struct(tc0, 100, 1000)
    let tc2 = type_converter_cache_struct(tc1, 200, 2000)
    let tc3 = type_converter_cache_struct(tc2, 300, 3000)
    type_converter_lookup_struct(tc3, 100) == 1000 &&
    type_converter_lookup_struct(tc3, 200) == 2000 &&
    type_converter_lookup_struct(tc3, 300) == 3000
}

fn llvm_codegen_test_30_tc_cache_limit() -> bool {
    // TypeConverter has 256 slots
    let tc = type_converter_new()
    tc.struct_cache_keys[0] == 0 && tc.struct_cache_vals[0] == 0
}

// ── Runner ──────────────────────────────────────────────────────────

fn run_llvm_codegen_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== LLVM Codegen Data Structure Tests ===\n")

    total = total + 1
    if llvm_codegen_test_01_max_values() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 MAX_VALUES\n") }
    total = total + 1
    if llvm_codegen_test_02_max_blocks() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02 MAX_BLOCKS\n") }
    total = total + 1
    if llvm_codegen_test_03_max_functions() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03 MAX_FUNCTIONS\n") }
    total = total + 1
    if llvm_codegen_test_04_max_strings() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04 MAX_STRINGS\n") }
    total = total + 1
    if llvm_codegen_test_05_constants_ordering() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 ordering\n") }

    total = total + 1
    if llvm_codegen_test_06_state_new_opt0() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 state opt0\n") }
    total = total + 1
    if llvm_codegen_test_07_state_new_opt2_debug() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 state opt2\n") }
    total = total + 1
    if llvm_codegen_test_08_state_maps_init() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 maps init\n") }
    total = total + 1
    if llvm_codegen_test_09_state_type_conv_init() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 tc init\n") }

    total = total + 1
    if llvm_codegen_test_10_ssa_new_count() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 ssa new\n") }
    total = total + 1
    if llvm_codegen_test_11_ssa_insert_get() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 ssa insert\n") }
    total = total + 1
    if llvm_codegen_test_12_ssa_get_miss() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 ssa miss\n") }
    total = total + 1
    if llvm_codegen_test_13_ssa_update_in_place() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 ssa update\n") }
    total = total + 1
    if llvm_codegen_test_14_ssa_multiple_inserts() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14 ssa multi\n") }
    total = total + 1
    if llvm_codegen_test_15_ssa_clear() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15 ssa clear\n") }

    total = total + 1
    if llvm_codegen_test_16_block_new_count() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16 block new\n") }
    total = total + 1
    if llvm_codegen_test_17_block_insert_get() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 block insert\n") }
    total = total + 1
    if llvm_codegen_test_18_block_get_miss() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 block miss\n") }
    total = total + 1
    if llvm_codegen_test_19_block_clear() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 block clear\n") }
    total = total + 1
    if llvm_codegen_test_20_block_multiple() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20 block multi\n") }

    total = total + 1
    if llvm_codegen_test_21_func_new_count() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21 func new\n") }
    total = total + 1
    if llvm_codegen_test_22_func_insert_get() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22 func insert\n") }
    total = total + 1
    if llvm_codegen_test_23_func_get_miss() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23 func miss\n") }
    total = total + 1
    if llvm_codegen_test_24_func_multiple() { passed = passed + 1; print("  T24 OK\n") } else { print("  FAIL T24 func multi\n") }

    total = total + 1
    if llvm_codegen_test_25_tc_new_count() { passed = passed + 1; print("  T25 OK\n") } else { print("  FAIL T25 tc new\n") }
    total = total + 1
    if llvm_codegen_test_26_tc_cache_lookup() { passed = passed + 1; print("  T26 OK\n") } else { print("  FAIL T26 tc lookup\n") }
    total = total + 1
    if llvm_codegen_test_27_tc_lookup_miss() { passed = passed + 1; print("  T27 OK\n") } else { print("  FAIL T27 tc miss\n") }
    total = total + 1
    if llvm_codegen_test_28_tc_count_increments() { passed = passed + 1; print("  T28 OK\n") } else { print("  FAIL T28 tc count\n") }
    total = total + 1
    if llvm_codegen_test_29_tc_multiple_lookup() { passed = passed + 1; print("  T29 OK\n") } else { print("  FAIL T29 tc multi\n") }
    total = total + 1
    if llvm_codegen_test_30_tc_cache_limit() { passed = passed + 1; print("  T30 OK\n") } else { print("  FAIL T30 tc limit\n") }

    if passed == total {
        print("LLVM Codegen: all 30 passed\n")
    } else {
        print("LLVM Codegen: FAILED\n")
    }
    if passed == total { 0 } else { 1 }
}
