// ── Shadow Initialization PTX ───────────────────────────────────────

fn epistemic_ptx_test_41_init_shadow_mov_val() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let s = epistemic_shadow_new("x")
    let st1 = epistemic_emit_init_shadow(st0, s, "0f40400000", "0f00000000")
    eptx_buf_contains(st1.buf, "mov.f32 %r_x, 0f40400000")
}

fn epistemic_ptx_test_42_init_shadow_mov_eps() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let s = epistemic_shadow_new("x")
    let st1 = epistemic_emit_init_shadow(st0, s, "0f40400000", "0f3C23D70A")
    eptx_buf_contains(st1.buf, "mov.f32 %r_x_eps, 0f3C23D70A")
}

fn epistemic_ptx_test_43_init_shadow_validity_true() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let s = epistemic_shadow_new("x")
    let st1 = epistemic_emit_init_shadow(st0, s, "0f40400000", "0f00000000")
    eptx_buf_contains(st1.buf, "setp.eq.s32 %p_x_valid, 1, 1")
}

fn epistemic_ptx_test_44_init_shadow_prov_zero() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let s = epistemic_shadow_new("x")
    let st1 = epistemic_emit_init_shadow(st0, s, "0f40400000", "0f00000000")
    eptx_buf_contains(st1.buf, "mov.u64 %r_x_prov, 0")
}

// ── No-Quadrature Mode ──────────────────────────────────────────────

fn epistemic_ptx_test_45_no_quadrature_max() -> bool with Mut, Panic, Div, Alloc {
    var c = epistemic_config_default()
    c.quadrature_propagation = false
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    // Without quadrature, uses max instead of sqrt
    eptx_buf_contains(st1.buf, "max.f32 %r_c_eps")
}

// ── Runner ──────────────────────────────────────────────────────────

fn run_gpu_epistemic_ptx_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== Epistemic PTX Tests ===\n")

    total = total + 1
    if epistemic_ptx_test_01_config_sm() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 config sm\n") }
    total = total + 1
    if epistemic_ptx_test_02_config_threshold() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02 threshold\n") }
    total = total + 1
    if epistemic_ptx_test_03_config_default_epsilon() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03 default eps\n") }
    total = total + 1
    if epistemic_ptx_test_04_config_flags() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04 flags\n") }
    total = total + 1
    if epistemic_ptx_test_05_shadow_val_name() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 val name\n") }
    total = total + 1
    if epistemic_ptx_test_06_shadow_eps_name() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 eps name\n") }
    total = total + 1
    if epistemic_ptx_test_07_shadow_valid_name() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 valid name\n") }
    total = total + 1
    if epistemic_ptx_test_08_shadow_prov_name() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 prov name\n") }
    total = total + 1
    if epistemic_ptx_test_09_shadow_different_base() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 diff base\n") }
    total = total + 1
    if epistemic_ptx_test_10_state_init_counters() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 counters\n") }
    total = total + 1
    if epistemic_ptx_test_11_alloc_shadow_increments() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 alloc inc\n") }
    total = total + 1
    if epistemic_ptx_test_12_alloc_shadow_naming() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 alloc name\n") }
    total = total + 1
    if epistemic_ptx_test_13_alloc_temp_f32() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 temp f32\n") }
    total = total + 1
    if epistemic_ptx_test_14_alloc_temp_pred() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14 temp pred\n") }
    total = total + 1
    if epistemic_ptx_test_15_add_contains_mul_sq() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15 add mul sq\n") }
    total = total + 1
    if epistemic_ptx_test_16_add_contains_sqrt() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16 add sqrt\n") }
    total = total + 1
    if epistemic_ptx_test_17_add_contains_quadrature_sum() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 add quad\n") }
    total = total + 1
    if epistemic_ptx_test_18_add_validity_conjunction() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 add valid\n") }
    total = total + 1
    if epistemic_ptx_test_19_add_provenance_xor() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 add prov\n") }
    total = total + 1
    if epistemic_ptx_test_20_sub_uses_sub_opcode() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20 sub op\n") }
    total = total + 1
    if epistemic_ptx_test_21_mul_value_op() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21 mul val\n") }
    total = total + 1
    if epistemic_ptx_test_22_mul_abs_operands() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22 mul abs\n") }
    total = total + 1
    if epistemic_ptx_test_23_mul_first_order_sum() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23 mul sum\n") }
    total = total + 1
