// Self-hosted epistemic PTX codegen tests
//
// Validates shadow register naming, configuration defaults, and PTX
// emission for uncertainty propagation (add/mul/div), warp-level
// ballot, and epsilon tree reduction.

// ── Configuration ───────────────────────────────────────────────────

fn epistemic_ptx_test_01_config_sm() -> bool {
    let c = epistemic_config_default()
    c.sm_major == 8 && c.sm_minor == 0
}

fn epistemic_ptx_test_02_config_threshold() -> bool {
    // 0.05f in IEEE 754 = 1028443341
    let c = epistemic_config_default()
    c.confidence_threshold == 1028443341
}

fn epistemic_ptx_test_03_config_default_epsilon() -> bool {
    let c = epistemic_config_default()
    c.default_epsilon == 0
}

fn epistemic_ptx_test_04_config_flags() -> bool {
    let c = epistemic_config_default()
    c.quadrature_propagation &&
    c.warp_aggregation &&
    c.provenance_tracking &&
    c.provenance_bits == 8
}

// ── Shadow Register Naming ──────────────────────────────────────────

fn epistemic_ptx_test_05_shadow_val_name() -> bool with Alloc {
    let s = epistemic_shadow_new("a")
    s.val_name == "%r_a"
}

fn epistemic_ptx_test_06_shadow_eps_name() -> bool with Alloc {
    let s = epistemic_shadow_new("a")
    s.eps_name == "%r_a_eps"
}

fn epistemic_ptx_test_07_shadow_valid_name() -> bool with Alloc {
    let s = epistemic_shadow_new("a")
    s.valid_name == "%p_a_valid"
}

fn epistemic_ptx_test_08_shadow_prov_name() -> bool with Alloc {
    let s = epistemic_shadow_new("a")
    s.prov_name == "%r_a_prov"
}

fn epistemic_ptx_test_09_shadow_different_base() -> bool with Alloc {
    let s = epistemic_shadow_new("xyz")
    s.val_name == "%r_xyz" &&
    s.eps_name == "%r_xyz_eps" &&
    s.valid_name == "%p_xyz_valid" &&
    s.prov_name == "%r_xyz_prov"
}

// ── Emitter State ───────────────────────────────────────────────────

fn epistemic_ptx_test_10_state_init_counters() -> bool {
    let c = epistemic_config_default()
    let st = epistemic_ptx_new(c)
    st.shadow_counter == 0 &&
    st.shadow_count == 0 &&
    st.temp_f32_count == 0 &&
    st.temp_pred_count == 0 &&
    st.temp_u64_count == 0
}

fn epistemic_ptx_test_11_alloc_shadow_increments() -> bool with Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let r1 = epistemic_alloc_shadow(st0, "x")
    let st1 = r1.0
    let r2 = epistemic_alloc_shadow(st1, "y")
    let st2 = r2.0
    st1.shadow_counter == 1 && st2.shadow_counter == 2
}

fn epistemic_ptx_test_12_alloc_shadow_naming() -> bool with Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let r1 = epistemic_alloc_shadow(st0, "v")
    let shadow = r1.1
    // base = "v_0" → names: %r_v_0, %r_v_0_eps, %p_v_0_valid, %r_v_0_prov
    shadow.val_name == "%r_v_0" &&
    shadow.eps_name == "%r_v_0_eps"
}

fn epistemic_ptx_test_13_alloc_temp_f32() -> bool with Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let r1 = epistemic_alloc_temp_f32(st0)
    let st1 = r1.0
    let name = r1.1
    st1.temp_f32_count == 1 && name == "%r_eps_t0"
}

fn epistemic_ptx_test_14_alloc_temp_pred() -> bool with Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let r1 = epistemic_alloc_temp_pred(st0)
    let st1 = r1.0
    let name = r1.1
    st1.temp_pred_count == 1 && name == "%p_eps_t0"
}

// ── Additive ε Propagation PTX ──────────────────────────────────────

fn epistemic_ptx_test_15_add_contains_mul_sq() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    // ε_a² step
    eptx_buf_contains(st1.buf, "mul.f32 %r_eps_t0")
}

fn epistemic_ptx_test_16_add_contains_sqrt() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    eptx_buf_contains(st1.buf, "sqrt.approx.f32")
}

fn epistemic_ptx_test_17_add_contains_quadrature_sum() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    // ε_a² + ε_b² step
    eptx_buf_contains(st1.buf, "add.f32 %r_eps_t2, %r_eps_t0, %r_eps_t1")
}

fn epistemic_ptx_test_18_add_validity_conjunction() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    eptx_buf_contains(st1.buf, "and.pred %p_c_valid")
}

fn epistemic_ptx_test_19_add_provenance_xor() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, false)
    eptx_buf_contains(st1.buf, "xor.b64 %r_c_prov")
}

fn epistemic_ptx_test_20_sub_uses_sub_opcode() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_add(st0, r, a, b, true)
    eptx_buf_contains(st1.buf, "sub.f32 %r_c")
}

// ── Multiplicative ε Propagation PTX ────────────────────────────────

fn epistemic_ptx_test_21_mul_value_op() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_mul(st0, r, a, b)
    eptx_buf_contains(st1.buf, "mul.rn.f32 %r_c")
}

fn epistemic_ptx_test_22_mul_abs_operands() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_mul(st0, r, a, b)
    // |a| and |b| for first-order propagation
    eptx_buf_contains(st1.buf, "abs.f32 %r_eps_t0, %r_a") &&
    eptx_buf_contains(st1.buf, "abs.f32 %r_eps_t1, %r_b")
}

fn epistemic_ptx_test_23_mul_first_order_sum() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_mul(st0, r, a, b)
    // |a|·ε_b + |b|·ε_a → add.f32 result_eps
    eptx_buf_contains(st1.buf, "add.f32 %r_c_eps")
}

// ── Division ε Propagation PTX ──────────────────────────────────────

fn epistemic_ptx_test_24_div_value_op() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_div(st0, r, a, b)
    eptx_buf_contains(st1.buf, "div.approx.f32 %r_c")
}

fn epistemic_ptx_test_25_div_near_zero_guard() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_div(st0, r, a, b)
    // Near-zero check: setp.lt.f32 on |b| < 0.0001 (0f38D1B717)
    eptx_buf_contains(st1.buf, "setp.lt.f32 %p_eps_t0") &&
    eptx_buf_contains(st1.buf, "0f38D1B717")
}

fn epistemic_ptx_test_26_div_max_uncertainty() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_div(st0, r, a, b)
    // Near-zero → saturate to 1.0 (0f3F800000)
    eptx_buf_contains(st1.buf, "0f3F800000")
}

fn epistemic_ptx_test_27_div_b_squared() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let r = epistemic_shadow_new("c")
    let st1 = epistemic_emit_div(st0, r, a, b)
    // b² = b * b → mul.f32 using right.val_name twice
    eptx_buf_contains(st1.buf, "mul.f32 %r_eps_t1, %r_b, %r_b")
}

// ── FMA ε Propagation PTX ───────────────────────────────────────────

fn epistemic_ptx_test_28_fma_value_op() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let d = epistemic_shadow_new("d")
    let r = epistemic_shadow_new("r")
    let st1 = epistemic_emit_fma(st0, r, a, b, d)
    eptx_buf_contains(st1.buf, "fma.rn.f32 %r_r")
}

fn epistemic_ptx_test_29_fma_combined_sqrt() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let a = epistemic_shadow_new("a")
    let b = epistemic_shadow_new("b")
    let d = epistemic_shadow_new("d")
    let r = epistemic_shadow_new("r")
    let st1 = epistemic_emit_fma(st0, r, a, b, d)
    // sqrt(mul_part² + ε_c²)
    eptx_buf_contains(st1.buf, "sqrt.approx.f32 %r_r_eps")
}

// ── Confidence Gating ───────────────────────────────────────────────

fn epistemic_ptx_test_30_confidence_gate_branch() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let s = epistemic_shadow_new("v")
    let st1 = epistemic_emit_confidence_gate(st0, s, "3D4CCCCD", "hi", "lo")
    eptx_buf_contains(st1.buf, "setp.lt.f32 %p_eps_t0") &&
    eptx_buf_contains(st1.buf, "bra hi") &&
    eptx_buf_contains(st1.buf, "bra lo")
}

// ── Register Pool ───────────────────────────────────────────────────

fn epistemic_ptx_test_31_reg_pool_f32() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let st1 = epistemic_emit_shadow_reg_pool(st0, 4)
    eptx_buf_contains(st1.buf, ".reg .f32 %r_<8>")
}

fn epistemic_ptx_test_32_reg_pool_pred() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let st1 = epistemic_emit_shadow_reg_pool(st0, 4)
    // 4 shadows + 16 temporaries = 20
    eptx_buf_contains(st1.buf, ".reg .pred %p_<20>")
}

fn epistemic_ptx_test_33_reg_pool_provenance() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let st1 = epistemic_emit_shadow_reg_pool(st0, 4)
    eptx_buf_contains(st1.buf, ".reg .b64 %r_prov_<4>")
}

fn epistemic_ptx_test_34_reg_pool_eps_temps() -> bool with Mut, Panic, Div, Alloc {
    let c = epistemic_config_default()
    let st0 = epistemic_ptx_new(c)
    let st1 = epistemic_emit_shadow_reg_pool(st0, 2)
    eptx_buf_contains(st1.buf, ".reg .f32 %r_eps_t<16>") &&
    eptx_buf_contains(st1.buf, ".reg .pred %p_eps_t<8>")
}

