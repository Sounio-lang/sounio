// ============================================================================
// STRING AND CHAR TESTS
// ============================================================================

// T21: "hi" (with quotes) -> TK_STRING_LIT (103)
fn test_string_literal() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 34   // '"'
    input[1] = 104  // 'h'
    input[2] = 105  // 'i'
    input[3] = 34   // '"'
    let state = run_lex(input, 4)
    state.token_count == 2 && state.tokens[0].kind == 103
}

// T22: "a\nb" (with escape) -> TK_STRING_LIT, text[1] == 10 (LF)
fn test_string_escape() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 34   // '"'
    input[1] = 97   // 'a'
    input[2] = 92   // '\'
    input[3] = 110  // 'n'
    input[4] = 98   // 'b'
    input[5] = 34   // '"'
    let state = run_lex(input, 6)
    state.token_count == 2 &&
        state.tokens[0].kind == 103 &&
        state.tokens[0].text[1] == 10  // escape \n -> LF byte
}

// T23: 'x' -> TK_CHAR_LIT (104)
fn test_char_literal() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 39   // '\''
    input[1] = 120  // 'x'
    input[2] = 39   // '\''
    let state = run_lex(input, 3)
    state.token_count == 2 && state.tokens[0].kind == 104
}

