// T18: "42i32" -> TK_INT_LIT with suffix consumed
fn test_numeric_suffix_i32() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 52   // '4'
    input[1] = 50   // '2'
    input[2] = 105  // 'i'
    input[3] = 51   // '3'
    input[4] = 50   // '2'
    let state = run_lex(input, 5)
    // Should produce one INT_LIT (suffix consumed) + EOF
    state.token_count == 2 && state.tokens[0].kind == 101
}

