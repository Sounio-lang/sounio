// ============================================================================
// ARRAY REPEAT SYNTAX
// ============================================================================

// T43: "[0; 256]" -> LBRACKET INT_LIT SEMI INT_LIT RBRACKET + EOF
fn test_array_repeat() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // [  0  ;  _  2  5  6  ]
    input[0] = 91   // '['
    input[1] = 48   // '0'
    input[2] = 59   // ';'
    input[3] = 32   // ' '
    input[4] = 50   // '2'
    input[5] = 53   // '5'
    input[6] = 54   // '6'
    input[7] = 93   // ']'
    let state = run_lex(input, 8)
    state.token_count == 6 &&
        state.tokens[0].kind == 174 &&  // TK_LBRACKET
        state.tokens[1].kind == 101 &&  // TK_INT_LIT
        state.tokens[2].kind == 180 &&  // TK_SEMI
        state.tokens[3].kind == 101 &&  // TK_INT_LIT
        state.tokens[4].kind == 175     // TK_RBRACKET
}

