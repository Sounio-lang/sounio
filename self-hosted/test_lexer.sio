    var input: [i8; 256] = [0; 256]
    input[0] = 58  // ':'
    input[1] = 58  // ':'
    let state = run_lex(input, 2)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::ColonColon
}

// T46: "..." -> DotDotDot — variadic / spread
fn test_ellipsis() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 46  // '.'
    input[1] = 46  // '.'
    input[2] = 46  // '.'
    let state = run_lex(input, 3)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::DotDotDot
}

// ============================================================================
// SHIFT AND ASSIGN OPERATOR TESTS
// ============================================================================

// T47: "<<=" -> ShlEq
fn test_shl_eq() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 60  // '<'
    input[1] = 60  // '<'
    input[2] = 61  // '='
    let state = run_lex(input, 3)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::ShlEq
}

// ============================================================================
// ERROR TESTS
// ============================================================================

// T48: Unterminated string produces error
fn test_unterminated_string() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 34   // '"'
    input[1] = 104  // 'h'
    input[2] = 105  // 'i'
    // no closing quote
    let state = run_lex(input, 3)
    state.error_count > 0
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed: i64 = 0
    var total: i64 = 0

    // Edge cases
    total = total + 1
    if test_empty_input() { passed = passed + 1 } else { print("FAIL: T01 empty_input\n") }

    total = total + 1
    if test_whitespace_only() { passed = passed + 1 } else { print("FAIL: T02 whitespace_only\n") }

    total = total + 1
    if test_single_newline() { passed = passed + 1 } else { print("FAIL: T03 single_newline\n") }

    // Keywords
    total = total + 1
    if test_let_keyword() { passed = passed + 1 } else { print("FAIL: T04 let_keyword\n") }

    total = total + 1
    if test_fn_keyword() { passed = passed + 1 } else { print("FAIL: T05 fn_keyword\n") }

