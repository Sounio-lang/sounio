    input[0] = 46  // '.'
    input[1] = 46  // '.'
    input[2] = 61  // '='
    let state = run_lex(input, 3)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::DotDotEq
}

// T32: "|=" -> PipeEq
fn test_pipe_eq() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 124  // '|'
    input[1] = 61   // '='
    let state = run_lex(input, 2)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::PipeEq
}

// ============================================================================
// DELIMITER AND PUNCTUATION TESTS
// ============================================================================

// T33: "(){}" -> LParen RParen LBrace RBrace + EOF
fn test_delimiters() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 40   // '('
    input[1] = 41   // ')'
    input[2] = 123  // '{'
    input[3] = 125  // '}'
    let state = run_lex(input, 4)
    state.token_count == 5 &&
        state.tokens[0].kind == TokenKind::LParen &&
        state.tokens[1].kind == TokenKind::RParen &&
        state.tokens[2].kind == TokenKind::LBrace &&
        state.tokens[3].kind == TokenKind::RBrace
}

// ============================================================================
// COMMENT TESTS
// ============================================================================

// T34: "// comment\n42" -> line comment skipped, IntLit + EOF
fn test_line_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "// comment\n42"
    input[0] = 47   // '/'
    input[1] = 47   // '/'
    input[2] = 32   // ' '
    input[3] = 99   // 'c'
    input[4] = 111  // 'o'
    input[5] = 109  // 'm'
    input[6] = 10   // '\n'
    input[7] = 52   // '4'
    input[8] = 50   // '2'
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::IntLit
}

// T35: "/* blah */42" -> block comment skipped, IntLit + EOF
fn test_block_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 47   // '/'
    input[1] = 42   // '*'
    input[2] = 32   // ' '
    input[3] = 98   // 'b'
    input[4] = 32   // ' '
    input[5] = 42   // '*'
    input[6] = 47   // '/'
    input[7] = 52   // '4'
    input[8] = 50   // '2'
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::IntLit
}

// T36: "/* /* inner */ outer */" -> nested block comment
fn test_nested_block_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // /* /* x */ */42
    input[0] = 47    // /
    input[1] = 42    // *
    input[2] = 32    // ' '
    input[3] = 47    // /
    input[4] = 42    // *
    input[5] = 32    // ' '
    input[6] = 120   // 'x'
    input[7] = 32    // ' '
    input[8] = 42    // *
    input[9] = 47    // /
    input[10] = 32   // ' '
    input[11] = 42   // *
    input[12] = 47   // /
    input[13] = 52   // '4'
    input[14] = 50   // '2'
    let state = run_lex(input, 15)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::IntLit
}

// T37: "/// doc text" -> DocOuter
fn test_doc_comment_outer() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 47   // '/'
    input[1] = 47   // '/'
    input[2] = 47   // '/'
    input[3] = 32   // ' '
    input[4] = 100  // 'd'
    input[5] = 111  // 'o'
    input[6] = 99   // 'c'
    let state = run_lex(input, 7)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::DocOuter
}

// ============================================================================
// MULTI-TOKEN SEQUENCE TESTS
// ============================================================================

// T38: "let x = 5" -> Let Ident Eq IntLit + EOF
fn test_let_binding() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // l  e  t  _  x  _  =  _  5
    input[0] = 108  // 'l'
    input[1] = 101  // 'e'
    input[2] = 116  // 't'
    input[3] = 32   // ' '
    input[4] = 120  // 'x'
    input[5] = 32   // ' '
    input[6] = 61   // '='
    input[7] = 32   // ' '
    input[8] = 53   // '5'
    let state = run_lex(input, 9)
    state.token_count == 5 &&
        state.tokens[0].kind == TokenKind::Let &&
        state.tokens[1].kind == TokenKind::Ident &&
        state.tokens[2].kind == TokenKind::Eq &&
        state.tokens[3].kind == TokenKind::IntLit
}

// T39: "fn f() -> i32" -> Fn Ident LParen RParen Arrow Ident + EOF
fn test_fn_signature() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // f  n  _  f  (  )  _  -  >  _  i  3  2
    input[0] = 102   // 'f'
    input[1] = 110   // 'n'
    input[2] = 32    // ' '
    input[3] = 102   // 'f'
    input[4] = 40    // '('
    input[5] = 41    // ')'
    input[6] = 32    // ' '
    input[7] = 45    // '-'
    input[8] = 62    // '>'
    input[9] = 32    // ' '
    input[10] = 105  // 'i'
    input[11] = 51   // '3'
    input[12] = 50   // '2'
    let state = run_lex(input, 13)
    state.token_count == 7 &&
        state.tokens[0].kind == TokenKind::Fn &&
        state.tokens[1].kind == TokenKind::Ident &&
        state.tokens[2].kind == TokenKind::LParen &&
        state.tokens[3].kind == TokenKind::RParen &&
        state.tokens[4].kind == TokenKind::Arrow &&
        state.tokens[5].kind == TokenKind::Ident
}

// ============================================================================
// EPISTEMIC KEYWORD TESTS
// ============================================================================

// T40: "uncertain" -> Uncertain
fn test_epistemic_uncertain() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // u  n  c  e  r  t  a  i  n
    input[0] = 117  // u
    input[1] = 110  // n
    input[2] = 99   // c
    input[3] = 101  // e
    input[4] = 114  // r
    input[5] = 116  // t
    input[6] = 97   // a
    input[7] = 105  // i
    input[8] = 110  // n
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::Uncertain
}

// T41: "belief" -> Belief
fn test_epistemic_belief() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 98   // b
    input[1] = 101  // e
    input[2] = 108  // l
    input[3] = 105  // i
    input[4] = 101  // e
    input[5] = 102  // f
    let state = run_lex(input, 6)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::Belief
}

// T42: "posterior" -> Posterior
fn test_epistemic_posterior() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 112  // p
    input[1] = 111  // o
    input[2] = 115  // s
    input[3] = 116  // t
    input[4] = 101  // e
    input[5] = 114  // r
    input[6] = 105  // i
    input[7] = 111  // o
    input[8] = 114  // r
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::Posterior
}

// ============================================================================
// ARRAY REPEAT SYNTAX
// ============================================================================

// T43: "[0; 256]" -> LBracket IntLit Semi IntLit RBracket + EOF
fn test_array_repeat() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // [  0  ;  _  2  5  6  ]
    input[0] = 91   // '['
    input[1] = 48   // '0'
    input[2] = 59   // ';'
    input[3] = 32   // ' '
    input[4] = 50   // '2'
    input[5] = 53   // '5'
    input[6] = 54   // '6'
    input[7] = 93   // ']'
    let state = run_lex(input, 8)
    state.token_count == 6 &&
        state.tokens[0].kind == TokenKind::LBracket &&
        state.tokens[1].kind == TokenKind::IntLit &&
        state.tokens[2].kind == TokenKind::Semi &&
        state.tokens[3].kind == TokenKind::IntLit &&
        state.tokens[4].kind == TokenKind::RBracket
}

// ============================================================================
// COMPOUND OPERATOR TESTS
// ============================================================================

