    total = total + 1
    if test_match_keyword() { passed = passed + 1 } else { print("FAIL: T08 match_keyword\n") }

    total = total + 1
    if test_with_keyword() { passed = passed + 1 } else { print("FAIL: T09 with_keyword\n") }

    // Identifiers
    total = total + 1
    if test_identifier() { passed = passed + 1 } else { print("FAIL: T10 identifier\n") }

    total = total + 1
    if test_underscore_ident() { passed = passed + 1 } else { print("FAIL: T11 underscore_ident\n") }

    // Numeric
    total = total + 1
    if test_int_literal() { passed = passed + 1 } else { print("FAIL: T12 int_literal\n") }

    total = total + 1
    if test_float_literal() { passed = passed + 1 } else { print("FAIL: T13 float_literal\n") }

    total = total + 1
    if test_hex_literal() { passed = passed + 1 } else { print("FAIL: T14 hex_literal\n") }

    total = total + 1
    if test_bin_literal() { passed = passed + 1 } else { print("FAIL: T15 bin_literal\n") }

    total = total + 1
    if test_oct_literal() { passed = passed + 1 } else { print("FAIL: T16 oct_literal\n") }

    total = total + 1
    if test_scientific_notation() { passed = passed + 1 } else { print("FAIL: T17 scientific_notation\n") }

    total = total + 1
    if test_numeric_suffix_i32() { passed = passed + 1 } else { print("FAIL: T18 numeric_suffix_i32\n") }

    total = total + 1
    if test_numeric_suffix_f64() { passed = passed + 1 } else { print("FAIL: T19 numeric_suffix_f64\n") }

    total = total + 1
    if test_underscore_separator() { passed = passed + 1 } else { print("FAIL: T20 underscore_separator\n") }

    // Strings and chars
    total = total + 1
    if test_string_literal() { passed = passed + 1 } else { print("FAIL: T21 string_literal\n") }

    total = total + 1
    if test_string_escape() { passed = passed + 1 } else { print("FAIL: T22 string_escape\n") }

    total = total + 1
    if test_char_literal() { passed = passed + 1 } else { print("FAIL: T23 char_literal\n") }

    // Operators
    total = total + 1
    if test_plus_operator() { passed = passed + 1 } else { print("FAIL: T24 plus_operator\n") }

    total = total + 1
    if test_arrow_operator() { passed = passed + 1 } else { print("FAIL: T25 arrow_operator\n") }

    total = total + 1
    if test_fat_arrow() { passed = passed + 1 } else { print("FAIL: T26 fat_arrow\n") }

    total = total + 1
    if test_amp_bang() { passed = passed + 1 } else { print("FAIL: T27 amp_bang\n") }

    total = total + 1
    if test_tilde_operator() { passed = passed + 1 } else { print("FAIL: T28 tilde_operator\n") }

    total = total + 1
    if test_plus_minus() { passed = passed + 1 } else { print("FAIL: T29 plus_minus\n") }

    total = total + 1
    if test_range_operator() { passed = passed + 1 } else { print("FAIL: T30 range_operator\n") }

    total = total + 1
    if test_range_inclusive() { passed = passed + 1 } else { print("FAIL: T31 range_inclusive\n") }

    total = total + 1
    if test_pipe_eq() { passed = passed + 1 } else { print("FAIL: T32 pipe_eq\n") }

    // Delimiters
    total = total + 1
    if test_delimiters() { passed = passed + 1 } else { print("FAIL: T33 delimiters\n") }

    // Comments
    total = total + 1
    if test_line_comment() { passed = passed + 1 } else { print("FAIL: T34 line_comment\n") }

    total = total + 1
    if test_block_comment() { passed = passed + 1 } else { print("FAIL: T35 block_comment\n") }

    total = total + 1
    if test_nested_block_comment() { passed = passed + 1 } else { print("FAIL: T36 nested_block_comment\n") }

    total = total + 1
    if test_doc_comment_outer() { passed = passed + 1 } else { print("FAIL: T37 doc_comment_outer\n") }

    // Multi-token sequences
    total = total + 1
    if test_let_binding() { passed = passed + 1 } else { print("FAIL: T38 let_binding\n") }

    total = total + 1
    if test_fn_signature() { passed = passed + 1 } else { print("FAIL: T39 fn_signature\n") }

    // Epistemic
    total = total + 1
    if test_epistemic_uncertain() { passed = passed + 1 } else { print("FAIL: T40 epistemic_uncertain\n") }

    total = total + 1
    if test_epistemic_belief() { passed = passed + 1 } else { print("FAIL: T41 epistemic_belief\n") }

    total = total + 1
    if test_epistemic_posterior() { passed = passed + 1 } else { print("FAIL: T42 epistemic_posterior\n") }

    // Array repeat
    total = total + 1
    if test_array_repeat() { passed = passed + 1 } else { print("FAIL: T43 array_repeat\n") }

    // Compound operators
    total = total + 1
    if test_eq_eq() { passed = passed + 1 } else { print("FAIL: T44 eq_eq\n") }

    total = total + 1
    if test_colon_colon() { passed = passed + 1 } else { print("FAIL: T45 colon_colon\n") }

    total = total + 1
    if test_ellipsis() { passed = passed + 1 } else { print("FAIL: T46 ellipsis\n") }

    total = total + 1
    if test_shl_eq() { passed = passed + 1 } else { print("FAIL: T47 shl_eq\n") }

    // Errors
    total = total + 1
    if test_unterminated_string() { passed = passed + 1 } else { print("FAIL: T48 unterminated_string\n") }

    // Summary
    if passed == total {
        print("ALL TESTS PASSED\n")
    }
    print("Lexer tests: ")
    // Can't easily print integers without printf-style formatting,
    // so we return 0 for all-pass, 1 for failures.

    if passed == total { 0 } else { 1 }
}
