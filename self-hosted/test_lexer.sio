// T18: "42i32" -> IntLit with suffix consumed
fn test_numeric_suffix_i32() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 52   // '4'
    input[1] = 50   // '2'
    input[2] = 105  // 'i'
    input[3] = 51   // '3'
    input[4] = 50   // '2'
    let state = run_lex(input, 5)
    // Should produce one IntLit (suffix consumed) + EOF
    state.token_count == 2 && state.tokens[0].kind == TokenKind::IntLit
}

// T19: "3.14f64" -> FloatLit with suffix consumed
fn test_numeric_suffix_f64() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 51   // '3'
    input[1] = 46   // '.'
    input[2] = 49   // '1'
    input[3] = 52   // '4'
    input[4] = 102  // 'f'
    input[5] = 54   // '6'
    input[6] = 52   // '4'
    let state = run_lex(input, 7)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::FloatLit
}

// T20: "1_000" -> IntLit (underscore separator)
fn test_underscore_separator() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 49   // '1'
    input[1] = 95   // '_'
    input[2] = 48   // '0'
    input[3] = 48   // '0'
    input[4] = 48   // '0'
    let state = run_lex(input, 5)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::IntLit
}

// ============================================================================
// STRING AND CHAR TESTS
// ============================================================================

// T21: "hi" (with quotes) -> StringLit
fn test_string_literal() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 34   // '"'
    input[1] = 104  // 'h'
    input[2] = 105  // 'i'
    input[3] = 34   // '"'
    let state = run_lex(input, 4)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::StringLit
}

// T22: "a\nb" (with escape) -> StringLit, text[1] == 10 (LF)
fn test_string_escape() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 34   // '"'
    input[1] = 97   // 'a'
    input[2] = 92   // '\'
    input[3] = 110  // 'n'
    input[4] = 98   // 'b'
    input[5] = 34   // '"'
    let state = run_lex(input, 6)
    state.token_count == 2 &&
        state.tokens[0].kind == TokenKind::StringLit &&
        state.tokens[0].text[1] == 10  // escape \n -> LF byte
}

// T23: 'x' -> CharLit
fn test_char_literal() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 39   // '\''
    input[1] = 120  // 'x'
    input[2] = 39   // '\''
    let state = run_lex(input, 3)
    state.token_count == 2 && state.tokens[0].kind == TokenKind::CharLit
}

