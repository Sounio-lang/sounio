}

// ============================================================================
// DELIMITER AND PUNCTUATION TESTS
// ============================================================================

// T33: "(){}" -> LPAREN RPAREN LBRACE RBRACE + EOF
fn test_delimiters() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 40   // '('
    input[1] = 41   // ')'
    input[2] = 123  // '{'
    input[3] = 125  // '}'
    let state = run_lex(input, 4)
    state.token_count == 5 &&
        state.tokens[0].kind == 170 &&  // TK_LPAREN
        state.tokens[1].kind == 171 &&  // TK_RPAREN
        state.tokens[2].kind == 172 &&  // TK_LBRACE
        state.tokens[3].kind == 173     // TK_RBRACE
}

// ============================================================================
// COMMENT TESTS
// ============================================================================

// T34: "// comment\n42" -> line comment skipped, TK_INT_LIT + EOF
fn test_line_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "// comment\n42"
    input[0] = 47   // '/'
    input[1] = 47   // '/'
    input[2] = 32   // ' '
    input[3] = 99   // 'c'
    input[4] = 111  // 'o'
    input[5] = 109  // 'm'
    input[6] = 10   // '\n'
    input[7] = 52   // '4'
    input[8] = 50   // '2'
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == 101  // TK_INT_LIT
}

// T35: "/* blah */42" -> block comment skipped, TK_INT_LIT + EOF
fn test_block_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 47   // '/'
    input[1] = 42   // '*'
    input[2] = 32   // ' '
    input[3] = 98   // 'b'
    input[4] = 32   // ' '
    input[5] = 42   // '*'
    input[6] = 47   // '/'
    input[7] = 52   // '4'
    input[8] = 50   // '2'
    let state = run_lex(input, 9)
    state.token_count == 2 && state.tokens[0].kind == 101
}

// T36: "/* /* inner */ outer */" -> nested block comment
fn test_nested_block_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // /* /* x */ */42
    input[0] = 47    // /
    input[1] = 42    // *
    input[2] = 32    // ' '
    input[3] = 47    // /
    input[4] = 42    // *
    input[5] = 32    // ' '
    input[6] = 120   // 'x'
    input[7] = 32    // ' '
    input[8] = 42    // *
    input[9] = 47    // /
    input[10] = 32   // ' '
    input[11] = 42   // *
    input[12] = 47   // /
    input[13] = 52   // '4'
    input[14] = 50   // '2'
    let state = run_lex(input, 15)
    state.token_count == 2 && state.tokens[0].kind == 101  // TK_INT_LIT
}

// T37: "/// doc text" -> TK_DOC_OUTER (190)
fn test_doc_comment_outer() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 47   // '/'
    input[1] = 47   // '/'
    input[2] = 47   // '/'
    input[3] = 32   // ' '
    input[4] = 100  // 'd'
    input[5] = 111  // 'o'
    input[6] = 99   // 'c'
    let state = run_lex(input, 7)
    state.token_count == 2 && state.tokens[0].kind == 190
}

// ============================================================================
// MULTI-TOKEN SEQUENCE TESTS
// ============================================================================

// T38: "let x = 5" -> TK_LET TK_IDENT TK_EQ TK_INT_LIT + EOF
fn test_let_binding() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // l  e  t  _  x  _  =  _  5
    input[0] = 108  // 'l'
    input[1] = 101  // 'e'
    input[2] = 116  // 't'
    input[3] = 32   // ' '
    input[4] = 120  // 'x'
    input[5] = 32   // ' '
    input[6] = 61   // '='
    input[7] = 32   // ' '
    input[8] = 53   // '5'
    let state = run_lex(input, 9)
    state.token_count == 5 &&
        state.tokens[0].kind == 15 &&   // TK_LET
        state.tokens[1].kind == 100 &&  // TK_IDENT
        state.tokens[2].kind == 125 &&  // TK_EQ
        state.tokens[3].kind == 101     // TK_INT_LIT
}

// T39: "fn f() -> i32" -> TK_FN TK_IDENT TK_LPAREN TK_RPAREN TK_ARROW TK_IDENT + EOF
fn test_fn_signature() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // f  n  _  f  (  )  _  -  >  _  i  3  2
    input[0] = 102   // 'f'
    input[1] = 110   // 'n'
    input[2] = 32    // ' '
    input[3] = 102   // 'f'
    input[4] = 40    // '('
    input[5] = 41    // ')'
    input[6] = 32    // ' '
    input[7] = 45    // '-'
    input[8] = 62    // '>'
    input[9] = 32    // ' '
    input[10] = 105  // 'i'
    input[11] = 51   // '3'
    input[12] = 50   // '2'
    let state = run_lex(input, 13)
    state.token_count == 7 &&
        state.tokens[0].kind == 14 &&   // TK_FN
        state.tokens[1].kind == 100 &&  // TK_IDENT (f)
        state.tokens[2].kind == 170 &&  // TK_LPAREN
        state.tokens[3].kind == 171 &&  // TK_RPAREN
        state.tokens[4].kind == 152 &&  // TK_ARROW
        state.tokens[5].kind == 100     // TK_IDENT (i32)
}

