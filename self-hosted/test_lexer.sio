// self-hosted::test_lexer — Integration tests for the self-hosted lexer
//
// 48 test vectors covering: empty input, whitespace, keywords, identifiers,
// numbers (int/float/hex/bin/oct/scientific/suffixes), strings (with escapes),
// char literals, operators (single/compound/epistemic), delimiters, punctuation,
// comments (line/block/nested/doc), multi-token sequences, edge cases.
//
// Pattern: each test returns bool, main() aggregates with pass/fail count.
// Helpers precede callers (Sounio requirement).
// All token kind comparisons use TokenKind enum variants.

use lexer::*

// ============================================================================
// TEST SOURCE BUILDER
// ============================================================================

struct TestSource {
    data: [i8; 1048576],
    len: i64,
}

fn ts_empty() -> TestSource {
    TestSource { data: [0; 1048576], len: 0 }
}

fn ts_from(input: [i8; 256], len: i64) -> TestSource with Mut, Div, Panic {
    var ts = ts_empty()
    var i: i64 = 0
    while i < len {
        ts.data[i as usize] = input[i as usize]
        i = i + 1
    }
    ts.len = len
    ts
}

fn run_lex(input: [i8; 256], len: i64) -> LexerState with Mut, Div, Panic {
    let ts = ts_from(input, len)
    lex(ts.data, ts.len, 0)
}

// ============================================================================
// EDGE CASE TESTS
// ============================================================================

// T01: Empty input produces only EOF
fn test_empty_input() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    let state = run_lex(input, 0)
    state.token_count == 1 && state.tokens[0].kind == TokenKind::Eof
}

// T02: Whitespace-only input produces only EOF
fn test_whitespace_only() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 32   // space
    input[1] = 9    // tab
    input[2] = 32   // space
    let state = run_lex(input, 3)
    state.token_count == 1 && state.tokens[0].kind == TokenKind::Eof
}

// T03: Single newline produces only EOF
fn test_single_newline() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    input[0] = 10  // '\n'
    let state = run_lex(input, 1)
    state.token_count == 1 && state.tokens[0].kind == TokenKind::Eof
}

