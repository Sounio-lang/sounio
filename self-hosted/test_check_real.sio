// self-hosted::test_check_real — Type-check real .sio source files from disk
//
// Tests C01-C04: Read actual source files, lex + parse + check them.
//
// Note: these files are type-checked in isolation (no cross-module types).
// The self-hosted checker has limitations:
//   - No cross-module type resolution (types from other files unknown)
//   - No builtin function signatures (print, print_int, etc.)
//   - No generic type support (Option, Box used as opaque)
// Files will likely produce type errors. Tests verify the pipeline
// completes without crashing and document expected error counts.
//
// Entry point: run_check_real_tests()

// ============================================================================
// TESTS
// ============================================================================

// C01: self-hosted/lexer/span.sio — Type-check.
// Expected: errors due to missing cross-module types and builtins.
// Test verifies the checker runs to completion without crash.
fn test_C01_check_span() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/lexer/span.sio")
    let size = file_size("self-hosted/lexer/span.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program_preloaded(state.token_count)
    let result = check_program(prog)
    // Checker runs to completion (no crash). Errors expected due to
    // single-file context (no cross-module types).
    print("    C01 check errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// C02: self-hosted/lexer/errors.sio — Type-check.
// This file has enums and structs with no function bodies, so fewer errors.
fn test_C02_check_errors() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/lexer/errors.sio")
    let size = file_size("self-hosted/lexer/errors.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program_preloaded(state.token_count)
    let result = check_program(prog)
    print("    C02 check errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// C03: self-hosted/resolve/symbol.sio — Type-check.
// Structs with impl blocks — may have errors from missing cross-module types.
fn test_C03_check_symbol() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/resolve/symbol.sio")
    let size = file_size("self-hosted/resolve/symbol.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program_preloaded(state.token_count)
    let result = check_program(prog)
    print("    C03 check errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// C04: self-hosted/resolve/scope.sio — Type-check.
// Small file with structs and impl blocks. Errors expected from
// missing cross-module types.
fn test_C04_check_scope() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/resolve/scope.sio")
    let size = file_size("self-hosted/resolve/scope.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program_preloaded(state.token_count)
    let result = check_program(prog)
    print("    C04 check errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn run_check_real_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 4

    print("=== Check Real Files Tests ===\n")

    if test_C01_check_span() { passed = passed + 1; print("  C01 OK: span.sio\n") } else { print("  FAIL: C01 span.sio\n") }
    if test_C02_check_errors() { passed = passed + 1; print("  C02 OK: errors.sio\n") } else { print("  FAIL: C02 errors.sio\n") }
    if test_C03_check_symbol() { passed = passed + 1; print("  C03 OK: symbol.sio\n") } else { print("  FAIL: C03 symbol.sio\n") }
    if test_C04_check_scope() { passed = passed + 1; print("  C04 OK: scope.sio\n") } else { print("  FAIL: C04 scope.sio\n") }

    print("\nCheck real tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
