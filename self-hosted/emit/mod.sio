// Emit entry point

var EMIT_SILENT: bool = false

fn emit_set_silent(silent: bool) with Mut {
    EMIT_SILENT = silent
}

fn emit_module(m: IrModule) with IO, Mut, Panic, Div, Alloc {
    if EMIT_SILENT {
        return
    }

    var i: i64 = 0
    while i < m.fn_count {
        emit_function(m.functions[i], i)
        if i + 1 < m.fn_count {
            print("\n")
        }
        i = i + 1
    }
}
