// Emit entry point

use ir::ir::*
use emit::text::*

var EMIT_SILENT: bool = false

pub fn emit_set_silent(silent: bool) with Mut {
    EMIT_SILENT = silent
}

pub fn emit_module(m: IrModule) with IO, Mut, Panic, Div, Alloc {
    if EMIT_SILENT {
        return
    }

    var i: i64 = 0
    while i < m.fn_count {
        emit_function(ir_fn_get(&m, i), i)
        if i + 1 < m.fn_count {
            print("\n")
        }
        i = i + 1
    }
}
