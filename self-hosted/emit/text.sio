// Text emitter for IR

use ir::ir::*

fn emt_name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    ir_name_eq(a, b)
}

fn emt_print_name(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i] as i64)
        i = i + 1
    }
}

fn emt_opcode_tag(op: IrOpcode) -> i64 {
    if op == IrOpcode::IrLoadImm { 1 }
    else if op == IrOpcode::IrLoadFloat { 2 }
    else if op == IrOpcode::IrLoadBool { 3 }
    else if op == IrOpcode::IrLoadString { 4 }
    else if op == IrOpcode::IrCopy { 5 }
    else if op == IrOpcode::IrBinOp { 6 }
    else if op == IrOpcode::IrUnaryOp { 7 }
    else if op == IrOpcode::IrCall { 8 }
    else if op == IrOpcode::IrReturn { 9 }
    else if op == IrOpcode::IrJump { 10 }
    else if op == IrOpcode::IrBranchTrue { 11 }
    else if op == IrOpcode::IrBranchFalse { 12 }
    else if op == IrOpcode::IrFieldGet { 13 }
    else if op == IrOpcode::IrFieldSet { 14 }
    else if op == IrOpcode::IrIndexGet { 15 }
    else if op == IrOpcode::IrIndexSet { 16 }
    else if op == IrOpcode::IrAlloc { 17 }
    else if op == IrOpcode::IrLabel { 18 }
    else if op == IrOpcode::IrNop { 19 }
    else { 20 }
}

fn emt_binop_tag(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd { 1 }
    else if op == BinaryOp::OpSub { 2 }
    else if op == BinaryOp::OpMul { 3 }
    else if op == BinaryOp::OpDiv { 4 }
    else if op == BinaryOp::OpRem { 5 }
    else if op == BinaryOp::OpEq { 6 }
    else if op == BinaryOp::OpNe { 7 }
    else if op == BinaryOp::OpLt { 8 }
    else if op == BinaryOp::OpLe { 9 }
    else if op == BinaryOp::OpGt { 10 }
    else if op == BinaryOp::OpGe { 11 }
    else if op == BinaryOp::OpAnd { 12 }
    else if op == BinaryOp::OpOr { 13 }
    else if op == BinaryOp::OpBitAnd { 14 }
    else if op == BinaryOp::OpBitOr { 15 }
    else if op == BinaryOp::OpBitXor { 16 }
    else if op == BinaryOp::OpShl { 17 }
    else if op == BinaryOp::OpShr { 18 }
    else if op == BinaryOp::OpConcat { 19 }
    else if op == BinaryOp::OpRange { 20 }
    else { 21 }
}

fn emt_unop_tag(op: UnaryOp) -> i64 {
    if op == UnaryOp::OpNeg { 1 }
    else if op == UnaryOp::OpNot { 2 }
    else if op == UnaryOp::OpRef { 3 }
    else if op == UnaryOp::OpRefMut { 4 }
    else { 5 }
}

fn emt_print_digit(d: i64) with IO {
    if d == 0 { print("0") }
    else if d == 1 { print("1") }
    else if d == 2 { print("2") }
    else if d == 3 { print("3") }
    else if d == 4 { print("4") }
    else if d == 5 { print("5") }
    else if d == 6 { print("6") }
    else if d == 7 { print("7") }
    else if d == 8 { print("8") }
    else { print("9") }
}

fn emt_print_i64(v: i64) with IO, Mut, Panic, Div {
    if v == 0 {
        print("0")
        return
    }

    var n = v
    if n < 0 {
        print("-")
        n = -n
    }

    var digits: [i64; 32] = [0; 32]
    var len: i64 = 0
    while n > 0 && len < 32 {
        digits[len] = n % 10
        n = n / 10
        len = len + 1
    }

    while len > 0 {
        len = len - 1
        emt_print_digit(digits[len])
    }
}

fn emt_print_reg(r: i64) with IO, Mut, Panic, Div {
    print("r")
    emt_print_i64(r)
}

fn emt_print_label(l: i64) with IO, Mut, Panic, Div {
    print("L")
    emt_print_i64(l)
}

fn emt_print_binop(op: BinaryOp) with IO {
    if op == BinaryOp::OpAdd { print("add") }
    else if op == BinaryOp::OpSub { print("sub") }
    else if op == BinaryOp::OpMul { print("mul") }
    else if op == BinaryOp::OpDiv { print("div") }
    else if op == BinaryOp::OpRem { print("rem") }
    else if op == BinaryOp::OpEq { print("eq") }
    else if op == BinaryOp::OpNe { print("ne") }
    else if op == BinaryOp::OpLt { print("lt") }
    else if op == BinaryOp::OpLe { print("le") }
    else if op == BinaryOp::OpGt { print("gt") }
    else if op == BinaryOp::OpGe { print("ge") }
    else if op == BinaryOp::OpAnd { print("and") }
    else if op == BinaryOp::OpOr { print("or") }
    else if op == BinaryOp::OpBitAnd { print("bitand") }
    else if op == BinaryOp::OpBitOr { print("bitor") }
    else if op == BinaryOp::OpBitXor { print("bitxor") }
    else if op == BinaryOp::OpShl { print("shl") }
    else if op == BinaryOp::OpShr { print("shr") }
    else if op == BinaryOp::OpConcat { print("concat") }
    else if op == BinaryOp::OpRange { print("range") }
    else { print("range_inclusive") }
}

fn emt_print_unop(op: UnaryOp) with IO {
    if op == UnaryOp::OpNeg { print("neg") }
    else if op == UnaryOp::OpNot { print("not") }
    else if op == UnaryOp::OpRef { print("ref") }
    else if op == UnaryOp::OpRefMut { print("ref_mut") }
    else { print("deref") }
}

fn emt_print_args(opt: Option<Box<IrRegList>>) with IO, Mut, Panic, Div, Alloc {
    print("[")
    emt_print_args_tail(opt)
    print("]")
}

fn emt_print_args_tail(opt: Option<Box<IrRegList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            emt_print_reg((*list).head)
            match (*list).tail {
                Some(_) => {
                    print(", ")
                    emt_print_args_tail((*list).tail)
                }
                _ => {}
            }
        }
        _ => {}
    }
}

fn emt_print_call_args(i: IrInstr) with IO, Mut, Panic, Div {
    print("[")
    if i.arg_count > 0 && i.src1 >= 0 {
        emt_print_reg(i.src1)
    }
    if i.arg_count > 1 && i.src2 >= 0 {
        if i.arg_count > 0 {
            print(", ")
        }
        emt_print_reg(i.src2)
    }
    if i.arg_count > 2 {
        if i.arg_count > 1 {
            print(", ")
        }
        print("...")
    }
    print("]")
}

fn emit_instr(i: IrInstr) with IO, Mut, Panic, Div, Alloc {
    if i.op == IrOpcode::IrLoadImm {
        print("  ")
        emt_print_reg(i.dst)
        print(" = load_imm ")
        emt_print_i64(i.imm_i64)
        print("\n")
    } else if i.op == IrOpcode::IrLoadFloat {
        print("  ")
        emt_print_reg(i.dst)
        print(" = load_float\n")
    } else if i.op == IrOpcode::IrLoadBool {
        print("  ")
        emt_print_reg(i.dst)
        print(" = load_bool ")
        emt_print_i64(i.imm_i64)
        print("\n")
    } else if i.op == IrOpcode::IrLoadString {
        print("  ")
        emt_print_reg(i.dst)
        print(" = load_string #")
        emt_print_i64(i.imm_i64)
        print(" ")
        emt_print_name(i.name)
        print("\n")
    } else if i.op == IrOpcode::IrCopy {
        print("  ")
        emt_print_reg(i.dst)
        print(" = copy ")
        emt_print_reg(i.src1)
        print("\n")
    } else if i.op == IrOpcode::IrBinOp {
        print("  ")
        emt_print_reg(i.dst)
        print(" = binop ")
        emt_print_binop(i.bin_op)
        print(" ")
        emt_print_reg(i.src1)
        print(" ")
        emt_print_reg(i.src2)
        print("\n")
    } else if i.op == IrOpcode::IrUnaryOp {
        print("  ")
        emt_print_reg(i.dst)
        print(" = unary ")
        emt_print_unop(i.un_op)
        print(" ")
        emt_print_reg(i.src1)
        print("\n")
    } else if i.op == IrOpcode::IrCall {
        print("  ")
        emt_print_reg(i.dst)
        print(" = call ")
        print("fn#")
        emt_print_i64(i.fn_id)
        print(" ")
        emt_print_call_args(i)
        print("\n")
    } else if i.op == IrOpcode::IrReturn {
        print("  return ")
        emt_print_reg(i.src1)
        print("\n")
    } else if i.op == IrOpcode::IrJump {
        print("  jump ")
        emt_print_label(i.label_id)
        print("\n")
    } else if i.op == IrOpcode::IrBranchTrue {
        print("  branch_true ")
        emt_print_reg(i.src1)
        print(" ")
        emt_print_label(i.label_id)
        print("\n")
    } else if i.op == IrOpcode::IrBranchFalse {
        print("  branch_false ")
        emt_print_reg(i.src1)
        print(" ")
        emt_print_label(i.label_id)
        print("\n")
    } else if i.op == IrOpcode::IrFieldGet {
        print("  ")
        emt_print_reg(i.dst)
        print(" = field_get ")
        emt_print_reg(i.src1)
        print(" .")
        emt_print_i64(i.field_idx)
        print("\n")
    } else if i.op == IrOpcode::IrFieldSet {
        print("  field_set ")
        emt_print_reg(i.src1)
        print(" .")
        emt_print_i64(i.field_idx)
        print(" ")
        emt_print_reg(i.src2)
        print("\n")
    } else if i.op == IrOpcode::IrIndexGet {
        print("  ")
        emt_print_reg(i.dst)
        print(" = index_get ")
        emt_print_reg(i.src1)
        print("[")
        emt_print_reg(i.src2)
        print("]\n")
    } else if i.op == IrOpcode::IrIndexSet {
        print("  index_set ")
        emt_print_reg(i.src1)
        print("[")
        emt_print_reg(i.src2)
        print("] ")
        emt_print_reg(i.imm_i64)
        print("\n")
    } else if i.op == IrOpcode::IrAlloc {
        print("  ")
        emt_print_reg(i.dst)
        print(" = alloc ")
        emt_print_i64(i.imm_i64)
        print("\n")
    } else if i.op == IrOpcode::IrLabel {
        emt_print_label(i.label_id)
        print(":\n")
    } else if i.op == IrOpcode::IrNop {
        print("  nop\n")
    } else {
        print("  ")
        emt_print_reg(i.dst)
        print(" = phi\n")
    }
}

pub fn emit_function(f: IrFunction, fn_id: i64) with IO, Mut, Panic, Div, Alloc {
    print("fn ")
    print("fn#")
    emt_print_i64(fn_id)
    print("() [regs=")
    emt_print_i64(f.reg_count)
    print(", labels=")
    emt_print_i64(f.label_count)
    print("]:\n")

    var i: i64 = 0
    while i < f.instr_count {
        emit_instr(ir_arena_load(ir_region_slot_r(f.region, (i))))
        i = i + 1
    }
}
