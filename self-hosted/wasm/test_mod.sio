// self-hosted::wasm::test_mod — lightweight test runner
// Tests only wasm::mod and wasm::encode (no IrModule dependency)
//
// Run with:  souc run self-hosted/wasm/test_mod.sio

module wasm::test_mod
use wasm::emitter::*
use wasm::encode::*

fn run_mod_tests() -> i64 with Mut, Panic, Div {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_wasm_magic_header() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_magic_header\n")
        failed = failed + 1
    }

    if test_wasm_type_section_single() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_type_section_single\n")
        failed = failed + 1
    }

    if test_wasm_memory_section_min_only() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_memory_section_min_only\n")
        failed = failed + 1
    }

    if test_wasm_memory_section_min_max() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_memory_section_min_max\n")
        failed = failed + 1
    }

    if test_wasm_export_section_func() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_export_section_func\n")
        failed = failed + 1
    }

    if test_wasm_function_section() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_function_section\n")
        failed = failed + 1
    }

    if test_wasm_full_module_header() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_full_module_header\n")
        failed = failed + 1
    }

    if test_wasm_leb128_len_helper() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_leb128_len_helper\n")
        failed = failed + 1
    }

    if test_wasm_signed_leb128_positive() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_signed_leb128_positive\n")
        failed = failed + 1
    }

    if test_wasm_code_section_simple() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_code_section_simple\n")
        failed = failed + 1
    }

    if failed > 0 {
        0 - failed
    } else {
        passed
    }
}

fn run_encode_tests() -> i64 with Mut, Panic, Div {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_wasm_body_local_get() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_local_get\n")
        failed = failed + 1
    }

    if test_wasm_body_i32_const() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_i32_const\n")
        failed = failed + 1
    }

    if test_wasm_body_i32_const_negative() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_i32_const_negative\n")
        failed = failed + 1
    }

    if test_wasm_body_add_sequence() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_add_sequence\n")
        failed = failed + 1
    }

    if test_wasm_body_call() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_call\n")
        failed = failed + 1
    }

    if test_wasm_body_block_loop() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_block_loop\n")
        failed = failed + 1
    }

    if test_wasm_body_i32_load_store() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_i32_load_store\n")
        failed = failed + 1
    }

    if test_wasm_body_conversions() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_conversions\n")
        failed = failed + 1
    }

    if test_wasm_body_if_else() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_if_else\n")
        failed = failed + 1
    }

    if test_wasm_body_add_local() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_add_local\n")
        failed = failed + 1
    }

    if test_wasm_build_add_module() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_build_add_module\n")
        failed = failed + 1
    }

    if test_wasm_body_i64_const() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_i64_const\n")
        failed = failed + 1
    }

    if test_wasm_body_comparison_ops() {
        passed = passed + 1
    } else {
        print("FAIL: test_wasm_body_comparison_ops\n")
        failed = failed + 1
    }

    if failed > 0 {
        0 - failed
    } else {
        passed
    }
}

fn main() -> i64 with Mut, Panic, Div {
    print("wasm::mod tests...\n")
    let mod_result = run_mod_tests()
    if mod_result < 0 {
        print("wasm::mod: FAILED\n")
    } else {
        print("wasm::mod: PASSED (")
        print_int(mod_result)
        print(" tests)\n")
    }

    print("wasm::encode tests...\n")
    let enc_result = run_encode_tests()
    if enc_result < 0 {
        print("wasm::encode: FAILED\n")
    } else {
        print("wasm::encode: PASSED (")
        print_int(enc_result)
        print(" tests)\n")
    }

    if mod_result < 0 || enc_result < 0 {
        1
    } else {
        let total = mod_result + enc_result
        print("Total: ")
        print_int(total)
        print(" tests passed\n")
        0
    }
}
