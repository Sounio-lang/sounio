// ============================================================================
// Full module assembly helper: build a complete WASM module from
// high-level descriptions using the encode functions above
// ============================================================================

fn wasm_emit_full_module_with_bodies(
    types: WasmTypeSection,
    funcs: WasmFuncSection,
    min_pages: i64,
    max_pages: i64,
    exports: WasmExportSection,
    code: WasmCodeSection
) -> WasmBuf with Mut, Panic, Div {
    // Delegate to core.sio's full module emitter with empty imports/globals/data.
    wasm_emit_full_module(
        types,
        wasm_import_section_new(),
        funcs,
        wasm_global_section_new(),
        min_pages,
        max_pages,
        exports,
        code,
        wasm_data_section_new()
    )
}

// ============================================================================
// Convenience: build a simple add function module (for testing)
// ============================================================================

fn wasm_build_i32_add_module() -> WasmBuf with Mut, Panic, Div {
    // Type: (i32, i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("add", 0))

    // Build function body using emitters
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 0)
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_i32_add(body)
    body = wasm_body_emit_end(body)

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    wasm_emit_full_module(
        ts,
        wasm_import_section_new(),
        fs,
        wasm_global_section_new(),
        0,
        0,
        es,
        cs,
        wasm_data_section_new()
    )
}

// ============================================================================
// Convenience: build a factorial function module (iterative, for testing)
// ============================================================================

fn wasm_build_factorial_module() -> WasmBuf with Mut, Panic, Div {
    // Type: (i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("factorial", 0))

    // Build iterative factorial:
    // local $result i32
    // $result = 1
    // block $exit
    //   loop $loop
    //     br_if $exit (i32.le_s local.get 0, 1)
    //     $result = $result * $n
    //     $n = $n - 1
    //     br $loop
    //   end
    // end
    // local.get $result
    var body = wasm_body_new()
    body = wasm_body_add_local(body, 1, WASM_TYPE_I32)  // local 1 = result

    // result = 1
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_local_set(body, 1)

    // block $exit (void)
    body = wasm_body_emit_block(body, WASM_BLOCK_VOID)

    // loop $loop (void)
    body = wasm_body_emit_loop(body, WASM_BLOCK_VOID)

    // if n <= 1, break
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_i32_le_s(body)
    body = wasm_body_emit_br_if(body, 1)        // break to $exit

    // result = result * n
    body = wasm_body_emit_local_get(body, 1)    // result
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_mul(body)
    body = wasm_body_emit_local_set(body, 1)    // result = result * n

    // n = n - 1
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_i32_sub(body)
    body = wasm_body_emit_local_set(body, 0)    // n = n - 1

    // br $loop
    body = wasm_body_emit_br(body, 0)

    // end loop
    body = wasm_body_emit_end(body)
    // end block
    body = wasm_body_emit_end(body)

    // return result
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_end(body)

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    wasm_emit_full_module(
        ts,
        wasm_import_section_new(),
        fs,
        wasm_global_section_new(),
        0,
        0,
        es,
        cs,
        wasm_data_section_new()
    )
}

// ============================================================================
// Inline tests
// ============================================================================

fn wasm_body_byte_at(body: WasmFuncBody, idx: i64) -> i64 with Mut, Panic {
    if idx < 0 { return 0 }
    if idx >= body.code_len { return 0 }
    let raw = body.code[idx as usize] as i64
    if raw < 0 { return raw + 256 }
    raw
}

fn test_wasm_body_local_get() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 3)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x20
        && wasm_body_byte_at(body, 1) == 3
}

fn test_wasm_body_i32_const() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_const(body, 42)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x41
        && wasm_body_byte_at(body, 1) == 42
}

fn test_wasm_body_i32_const_negative() -> bool with Mut, Panic, Div {
    // i32.const -1 => 0x41 0x7F (signed LEB128)
    var body = wasm_body_new()
    body = wasm_body_emit_i32_const(body, 0 - 1)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x41
        && wasm_body_byte_at(body, 1) == 0x7F
}

fn test_wasm_body_add_sequence() -> bool with Mut, Panic, Div {
    // local.get 0, local.get 1, i32.add, end
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 0)
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_i32_add(body)
    body = wasm_body_emit_end(body)

    body.code_len == 6
        && wasm_body_byte_at(body, 0) == 0x20   // local.get
        && wasm_body_byte_at(body, 1) == 0x00   // 0
        && wasm_body_byte_at(body, 2) == 0x20   // local.get
        && wasm_body_byte_at(body, 3) == 0x01   // 1
        && wasm_body_byte_at(body, 4) == 0x6A   // i32.add
        && wasm_body_byte_at(body, 5) == 0x0B   // end
}

fn test_wasm_body_call() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_call(body, 5)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x10
        && wasm_body_byte_at(body, 1) == 5
}

fn test_wasm_body_block_loop() -> bool with Mut, Panic, Div {
    // block(void), loop(void), br_if 1, br 0, end, end
    var body = wasm_body_new()
    body = wasm_body_emit_block(body, WASM_BLOCK_VOID)
    body = wasm_body_emit_loop(body, WASM_BLOCK_VOID)
    body = wasm_body_emit_br_if(body, 1)
    body = wasm_body_emit_br(body, 0)
    body = wasm_body_emit_end(body)
    body = wasm_body_emit_end(body)

    body.code_len == 10
        && wasm_body_byte_at(body, 0) == 0x02   // block
        && wasm_body_byte_at(body, 1) == 0x40   // void
        && wasm_body_byte_at(body, 2) == 0x03   // loop
        && wasm_body_byte_at(body, 3) == 0x40   // void
        && wasm_body_byte_at(body, 4) == 0x0D   // br_if
        && wasm_body_byte_at(body, 5) == 0x01   // label 1
        && wasm_body_byte_at(body, 6) == 0x0C   // br
        && wasm_body_byte_at(body, 7) == 0x00   // label 0
        && wasm_body_byte_at(body, 8) == 0x0B   // end
        && wasm_body_byte_at(body, 9) == 0x0B   // end
}

fn test_wasm_body_i32_load_store() -> bool with Mut, Panic, Div {
    // i32.load align=2 offset=0, i32.store align=2 offset=4
    var body = wasm_body_new()
    body = wasm_body_emit_i32_load(body, 2, 0)
    body = wasm_body_emit_i32_store(body, 2, 4)

    body.code_len == 6
        && wasm_body_byte_at(body, 0) == 0x28   // i32.load
        && wasm_body_byte_at(body, 1) == 2      // align
        && wasm_body_byte_at(body, 2) == 0      // offset
        && wasm_body_byte_at(body, 3) == 0x36   // i32.store
        && wasm_body_byte_at(body, 4) == 2      // align
        && wasm_body_byte_at(body, 5) == 4      // offset
}

fn test_wasm_body_conversions() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_wrap_i64(body)
    body = wasm_body_emit_i64_extend_i32_s(body)
    body = wasm_body_emit_f64_convert_i64_s(body)
    body = wasm_body_emit_i64_trunc_f64_s(body)

    body.code_len == 4
        && wasm_body_byte_at(body, 0) == 0xA7   // i32.wrap_i64
        && wasm_body_byte_at(body, 1) == 0xAC   // i64.extend_i32_s
        && wasm_body_byte_at(body, 2) == 0xB9   // f64.convert_i64_s
        && wasm_body_byte_at(body, 3) == 0xB0   // i64.trunc_f64_s
}

fn test_wasm_body_if_else() -> bool with Mut, Panic, Div {
    // if(i32), i32.const 1, else, i32.const 0, end
    var body = wasm_body_new()
    body = wasm_body_emit_if(body, WASM_TYPE_I32)
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_else(body)
    body = wasm_body_emit_i32_const(body, 0)
    body = wasm_body_emit_end(body)

    body.code_len == 7
        && wasm_body_byte_at(body, 0) == 0x04   // if
        && wasm_body_byte_at(body, 1) == 0x7F   // i32 result type
        && wasm_body_byte_at(body, 2) == 0x41   // i32.const
        && wasm_body_byte_at(body, 3) == 1      // 1
        && wasm_body_byte_at(body, 4) == 0x05   // else
        && wasm_body_byte_at(body, 5) == 0x41   // i32.const
        && wasm_body_byte_at(body, 6) == 0      // 0 — end omitted for brevity, it's the next byte
}

fn test_wasm_body_add_local() -> bool with Mut, Panic {
    var body = wasm_body_new()
    body = wasm_body_add_local(body, 3, WASM_TYPE_I32)
    body = wasm_body_add_local(body, 1, WASM_TYPE_F64)

    body.local_count == 2
        && body.locals[0 as usize].count == 3
        && body.locals[0 as usize].val_type == WASM_TYPE_I32
        && body.locals[1 as usize].count == 1
        && body.locals[1 as usize].val_type == WASM_TYPE_F64
}

fn test_wasm_build_add_module() -> bool with Mut, Panic, Div {
    // Build the add module and verify the magic header
    let module = wasm_build_i32_add_module()
    module.len > 8
        && wasm_buf_byte_at(module, 0) == 0x00
        && wasm_buf_byte_at(module, 1) == 0x61
        && wasm_buf_byte_at(module, 2) == 0x73
        && wasm_buf_byte_at(module, 3) == 0x6D
        && wasm_buf_byte_at(module, 4) == 0x01
}

fn test_wasm_body_i64_const() -> bool with Mut, Panic, Div {
    // i64.const 256 => 0x42 0x80 0x02
    var body = wasm_body_new()
    body = wasm_body_emit_i64_const(body, 256)
    body.code_len == 3
        && wasm_body_byte_at(body, 0) == 0x42   // i64.const
        && wasm_body_byte_at(body, 1) == 0x80   // 256 LEB128 byte 0
        && wasm_body_byte_at(body, 2) == 0x02   // 256 LEB128 byte 1
}

fn test_wasm_body_comparison_ops() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_eqz(body)
    body = wasm_body_emit_i32_eq(body)
    body = wasm_body_emit_i32_ne(body)
    body = wasm_body_emit_i32_lt_s(body)
    body = wasm_body_emit_i32_gt_s(body)
    body = wasm_body_emit_i32_le_s(body)
    body = wasm_body_emit_i32_ge_s(body)

    body.code_len == 7
        && wasm_body_byte_at(body, 0) == 0x45
        && wasm_body_byte_at(body, 1) == 0x46
        && wasm_body_byte_at(body, 2) == 0x47
        && wasm_body_byte_at(body, 3) == 0x48
        && wasm_body_byte_at(body, 4) == 0x4A
        && wasm_body_byte_at(body, 5) == 0x4C
        && wasm_body_byte_at(body, 6) == 0x4E
}
