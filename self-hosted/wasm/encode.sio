// ============================================================================
// Memory instructions: opcode + align(LEB128) + offset(LEB128)
// ============================================================================

fn wasm_body_emit_i32_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

pub(crate) fn wasm_body_emit_i64_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I64_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

