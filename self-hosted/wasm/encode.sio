// ============================================================================
// i32 comparison instructions
// ============================================================================

fn wasm_body_emit_i32_eqz(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_EQZ)
}

fn wasm_body_emit_i32_eq(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_EQ)
}

fn wasm_body_emit_i32_ne(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_NE)
}

fn wasm_body_emit_i32_lt_s(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_LT_S)
}

fn wasm_body_emit_i32_gt_s(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_GT_S)
}

