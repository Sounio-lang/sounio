// self-hosted::wasm::encode — WebAssembly opcode emitters for function bodies
//
// Emits WASM instructions into a WasmFuncBody buffer.  Each emitter appends
// the opcode byte (and any immediate operands encoded as LEB128) to the
// body's code array, then returns the mutated body.
//
// Opcode reference: WebAssembly MVP specification, Section 5.4.
//
// Encoding conventions:
//   - Single-byte opcodes: push 1 byte.
//   - Opcodes with u32 immediate (local.get, call, br, etc.): opcode + u32 LEB128.
//   - Opcodes with i32/i64 immediate (i32.const, i64.const): opcode + signed LEB128.
//   - Memory opcodes (i32.load, etc.): opcode + alignment(LEB128) + offset(LEB128).
//   - Block-structured (block, loop, if): opcode + blocktype byte.
//     blocktype: 0x40 = void, 0x7F = i32, 0x7E = i64, etc.

module wasm::encode
use wasm::core::*
use wasm::emitter::*

// ============================================================================
// WASM opcode constants
// ============================================================================

// Control flow
let WASM_OP_UNREACHABLE: i64 = 0x00
let WASM_OP_NOP: i64 = 0x01
let WASM_OP_BLOCK: i64 = 0x02
let WASM_OP_LOOP: i64 = 0x03
let WASM_OP_IF: i64 = 0x04
let WASM_OP_ELSE: i64 = 0x05
let WASM_OP_END: i64 = 0x0B
let WASM_OP_BR: i64 = 0x0C
let WASM_OP_BR_IF: i64 = 0x0D
let WASM_OP_BR_TABLE: i64 = 0x0E
let WASM_OP_RETURN: i64 = 0x0F
let WASM_OP_CALL: i64 = 0x10
let WASM_OP_CALL_INDIRECT: i64 = 0x11

// Variable access
let WASM_OP_LOCAL_GET: i64 = 0x20
let WASM_OP_LOCAL_SET: i64 = 0x21
let WASM_OP_LOCAL_TEE: i64 = 0x22
let WASM_OP_GLOBAL_GET: i64 = 0x23
let WASM_OP_GLOBAL_SET: i64 = 0x24

// Memory access
let WASM_OP_I32_LOAD: i64 = 0x28
let WASM_OP_I64_LOAD: i64 = 0x29
let WASM_OP_F32_LOAD: i64 = 0x2A
let WASM_OP_F64_LOAD: i64 = 0x2B
let WASM_OP_I32_STORE: i64 = 0x36
let WASM_OP_I64_STORE: i64 = 0x37
let WASM_OP_F32_STORE: i64 = 0x38
let WASM_OP_F64_STORE: i64 = 0x39
let WASM_OP_MEMORY_SIZE: i64 = 0x3F
let WASM_OP_MEMORY_GROW: i64 = 0x40

// I32 load sub-widths
let WASM_OP_I32_LOAD8_S: i64 = 0x2C
let WASM_OP_I32_LOAD8_U: i64 = 0x2D
let WASM_OP_I32_LOAD16_S: i64 = 0x2E
let WASM_OP_I32_LOAD16_U: i64 = 0x2F

// I32 store sub-widths
let WASM_OP_I32_STORE8: i64 = 0x3A
let WASM_OP_I32_STORE16: i64 = 0x3B

// Constants
let WASM_OP_I32_CONST: i64 = 0x41
let WASM_OP_I64_CONST: i64 = 0x42
let WASM_OP_F32_CONST: i64 = 0x43
let WASM_OP_F64_CONST: i64 = 0x44

// i32 comparison
let WASM_OP_I32_EQZ: i64 = 0x45
let WASM_OP_I32_EQ: i64 = 0x46
let WASM_OP_I32_NE: i64 = 0x47
let WASM_OP_I32_LT_S: i64 = 0x48
let WASM_OP_I32_LT_U: i64 = 0x49
let WASM_OP_I32_GT_S: i64 = 0x4A
let WASM_OP_I32_GT_U: i64 = 0x4B
let WASM_OP_I32_LE_S: i64 = 0x4C
let WASM_OP_I32_LE_U: i64 = 0x4D
let WASM_OP_I32_GE_S: i64 = 0x4E
let WASM_OP_I32_GE_U: i64 = 0x4F

// i64 comparison
let WASM_OP_I64_EQZ: i64 = 0x50
let WASM_OP_I64_EQ: i64 = 0x51
let WASM_OP_I64_NE: i64 = 0x52
let WASM_OP_I64_LT_S: i64 = 0x53
let WASM_OP_I64_GT_S: i64 = 0x55
let WASM_OP_I64_LE_S: i64 = 0x57
let WASM_OP_I64_GE_S: i64 = 0x59

// f64 comparison
let WASM_OP_F64_EQ: i64 = 0x61
let WASM_OP_F64_NE: i64 = 0x62
let WASM_OP_F64_LT: i64 = 0x63
let WASM_OP_F64_GT: i64 = 0x64
let WASM_OP_F64_LE: i64 = 0x65
let WASM_OP_F64_GE: i64 = 0x66

// i32 arithmetic
let WASM_OP_I32_CLZ: i64 = 0x67
let WASM_OP_I32_CTZ: i64 = 0x68
let WASM_OP_I32_POPCNT: i64 = 0x69
let WASM_OP_I32_ADD: i64 = 0x6A
let WASM_OP_I32_SUB: i64 = 0x6B
let WASM_OP_I32_MUL: i64 = 0x6C
let WASM_OP_I32_DIV_S: i64 = 0x6D
let WASM_OP_I32_DIV_U: i64 = 0x6E
let WASM_OP_I32_REM_S: i64 = 0x6F
let WASM_OP_I32_REM_U: i64 = 0x70
let WASM_OP_I32_AND: i64 = 0x71
let WASM_OP_I32_OR: i64 = 0x72
let WASM_OP_I32_XOR: i64 = 0x73
let WASM_OP_I32_SHL: i64 = 0x74
let WASM_OP_I32_SHR_S: i64 = 0x75
let WASM_OP_I32_SHR_U: i64 = 0x76
let WASM_OP_I32_ROTL: i64 = 0x77
let WASM_OP_I32_ROTR: i64 = 0x78

// i64 arithmetic
let WASM_OP_I64_CLZ: i64 = 0x79
let WASM_OP_I64_CTZ: i64 = 0x7A
let WASM_OP_I64_POPCNT: i64 = 0x7B
let WASM_OP_I64_ADD: i64 = 0x7C
let WASM_OP_I64_SUB: i64 = 0x7D
let WASM_OP_I64_MUL: i64 = 0x7E
let WASM_OP_I64_DIV_S: i64 = 0x7F
let WASM_OP_I64_DIV_U: i64 = 0x80
let WASM_OP_I64_REM_S: i64 = 0x81
let WASM_OP_I64_REM_U: i64 = 0x82
let WASM_OP_I64_AND: i64 = 0x83
let WASM_OP_I64_OR: i64 = 0x84
let WASM_OP_I64_XOR: i64 = 0x85
let WASM_OP_I64_SHL: i64 = 0x86
let WASM_OP_I64_SHR_S: i64 = 0x87

// f32 arithmetic
let WASM_OP_F32_ABS: i64 = 0x8B
let WASM_OP_F32_NEG: i64 = 0x8C
let WASM_OP_F32_SQRT: i64 = 0x91
let WASM_OP_F32_ADD: i64 = 0x92
let WASM_OP_F32_SUB: i64 = 0x93
let WASM_OP_F32_MUL: i64 = 0x94
let WASM_OP_F32_DIV: i64 = 0x95

// f64 arithmetic
let WASM_OP_F64_ABS: i64 = 0x99
let WASM_OP_F64_NEG: i64 = 0x9A
let WASM_OP_F64_CEIL: i64 = 0x9B
let WASM_OP_F64_FLOOR: i64 = 0x9C
let WASM_OP_F64_TRUNC: i64 = 0x9D
let WASM_OP_F64_NEAREST: i64 = 0x9E
let WASM_OP_F64_SQRT: i64 = 0x9F
let WASM_OP_F64_ADD: i64 = 0xA0
let WASM_OP_F64_SUB: i64 = 0xA1
let WASM_OP_F64_MUL: i64 = 0xA2
let WASM_OP_F64_DIV: i64 = 0xA3
let WASM_OP_F64_MIN: i64 = 0xA4
let WASM_OP_F64_MAX: i64 = 0xA5

// Conversions
let WASM_OP_I32_WRAP_I64: i64 = 0xA7
let WASM_OP_I32_TRUNC_F32_S: i64 = 0xA8
let WASM_OP_I32_TRUNC_F64_S: i64 = 0xAA
let WASM_OP_I64_EXTEND_I32_S: i64 = 0xAC
let WASM_OP_I64_EXTEND_I32_U: i64 = 0xAD
let WASM_OP_I64_TRUNC_F64_S: i64 = 0xB0
let WASM_OP_F32_CONVERT_I32_S: i64 = 0xB2
let WASM_OP_F32_CONVERT_I64_S: i64 = 0xB4
let WASM_OP_F32_DEMOTE_F64: i64 = 0xB6
let WASM_OP_F64_CONVERT_I32_S: i64 = 0xB7
let WASM_OP_F64_CONVERT_I64_S: i64 = 0xB9
let WASM_OP_F64_PROMOTE_F32: i64 = 0xBB
let WASM_OP_I32_REINTERPRET_F32: i64 = 0xBC
let WASM_OP_I64_REINTERPRET_F64: i64 = 0xBD
let WASM_OP_F32_REINTERPRET_I32: i64 = 0xBE
let WASM_OP_F64_REINTERPRET_I64: i64 = 0xBF

// Block type for void blocks
let WASM_BLOCK_VOID: i64 = 0x40

// Drop and select
let WASM_OP_DROP: i64 = 0x1A
let WASM_OP_SELECT: i64 = 0x1B

// ============================================================================
// WasmFuncBody constructors and helpers
// ============================================================================

pub(crate) fn wasm_body_new() -> WasmFuncBody {
    var out: WasmFuncBody
    out.code_len = 0
    out.local_count = 0
    out
}

// Push a raw byte into the function body code buffer
fn wasm_body_push_byte(body: WasmFuncBody, b: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    if out.code_len < 8192 {
        let masked = b % 256
        var byte_val = masked
        if byte_val < 0 { byte_val = byte_val + 256 }
        out.code[out.code_len as usize] = byte_val as i8
        out.code_len = out.code_len + 1
    }
    out
}

// Push unsigned LEB128 into the body code buffer
fn wasm_body_push_u32_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    if v < 0 { v = v + 4294967296 }
    var done = false
    while !done {
        let low7 = v % 128
        v = v / 128
        if v == 0 {
            out = wasm_body_push_byte(out, low7)
            done = true
        } else {
            out = wasm_body_push_byte(out, low7 + 128)
        }
    }
    out
}

// Push signed LEB128 (i32) into the body code buffer
fn wasm_body_push_i32_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_body_push_byte(out, byte_val + 128)
        }
    }
    out
}

// Push signed LEB128 (i64) into the body code buffer
fn wasm_body_push_i64_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_body_push_byte(out, byte_val + 128)
        }
    }
    out
}

// ============================================================================
// Emit a single opcode byte
// ============================================================================

fn wasm_body_emit(body: WasmFuncBody, op: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_push_byte(body, op)
}

// Emit opcode + unsigned LEB128 immediate
fn wasm_body_emit_u32(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_u32_leb128(out, val)
    out
}

// Emit opcode + signed LEB128 immediate (i32)
fn wasm_body_emit_i32(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_i32_leb128(out, val)
    out
}

// Emit opcode + signed LEB128 immediate (i64)
fn wasm_body_emit_i64(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_i64_leb128(out, val)
    out
}

// ============================================================================
// Add local declarations to a function body
// ============================================================================

pub(crate) fn wasm_body_add_local(body: WasmFuncBody, count: i64, val_type: i64) -> WasmFuncBody with Mut, Panic {
    var out = body
    if out.local_count < 32 {
        out.locals[out.local_count as usize] = WasmLocal { count: count, val_type: val_type }
        out.local_count = out.local_count + 1
    }
    out
}

// ============================================================================
// Variable access instructions
// ============================================================================

pub(crate) fn wasm_body_emit_local_get(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_GET, idx)
}

pub(crate) fn wasm_body_emit_local_set(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_SET, idx)
}

fn wasm_body_emit_local_tee(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_TEE, idx)
}

pub(crate) fn wasm_body_emit_global_get(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_GLOBAL_GET, idx)
}

pub(crate) fn wasm_body_emit_global_set(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_GLOBAL_SET, idx)
}

// ============================================================================
// Control flow instructions
// ============================================================================

pub(crate) fn wasm_body_emit_unreachable(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_UNREACHABLE)
}

pub(crate) fn wasm_body_emit_nop(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_NOP)
}

pub(crate) fn wasm_body_emit_block(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_BLOCK)
    out = wasm_body_push_byte(out, block_type)
    out
}

pub(crate) fn wasm_body_emit_loop(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_LOOP)
    out = wasm_body_push_byte(out, block_type)
    out
}

fn wasm_body_emit_if(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_IF)
    out = wasm_body_push_byte(out, block_type)
    out
}

fn wasm_body_emit_else(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_ELSE)
}

pub(crate) fn wasm_body_emit_end(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_END)
}

pub(crate) fn wasm_body_emit_br(body: WasmFuncBody, label: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_BR, label)
}

pub(crate) fn wasm_body_emit_br_if(body: WasmFuncBody, label: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_BR_IF, label)
}

pub(crate) fn wasm_body_emit_return(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_RETURN)
}

pub(crate) fn wasm_body_emit_call(body: WasmFuncBody, func_idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_CALL, func_idx)
}

// ============================================================================
// Constant instructions
// ============================================================================

pub(crate) fn wasm_body_emit_i32_const(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_i32(body, WASM_OP_I32_CONST, val)
}

pub(crate) fn wasm_body_emit_i64_const(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_i64(body, WASM_OP_I64_CONST, val)
}

// f32.const: opcode + 4 bytes (IEEE 754 little-endian)
// Note: for bootstrap, emit raw 4 bytes. Full float encoding is a later phase.
fn wasm_body_emit_f32_const_raw(body: WasmFuncBody, b0: i64, b1: i64, b2: i64, b3: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F32_CONST)
    out = wasm_body_push_byte(out, b0)
    out = wasm_body_push_byte(out, b1)
    out = wasm_body_push_byte(out, b2)
    out = wasm_body_push_byte(out, b3)
    out
}

// f64.const: opcode + 8 bytes (IEEE 754 little-endian)
fn wasm_body_emit_f64_const_raw(
    body: WasmFuncBody,
    b0: i64, b1: i64, b2: i64, b3: i64,
    b4: i64, b5: i64, b6: i64, b7: i64
) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F64_CONST)
    out = wasm_body_push_byte(out, b0)
    out = wasm_body_push_byte(out, b1)
    out = wasm_body_push_byte(out, b2)
    out = wasm_body_push_byte(out, b3)
    out = wasm_body_push_byte(out, b4)
    out = wasm_body_push_byte(out, b5)
    out = wasm_body_push_byte(out, b6)
    out = wasm_body_push_byte(out, b7)
    out
}

// ============================================================================
// i32 arithmetic instructions (single-byte opcodes)
// ============================================================================

fn wasm_body_emit_i32_add(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_ADD)
}

fn wasm_body_emit_i32_sub(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_I32_SUB)
