// self-hosted::wasm::lower_ctx — lowering context types and constants
//
// Contains just the constants, WasmLabelEntry struct, and its two
// constructor functions from wasm::lower.  Split out to allow lightweight
// imports (e.g. JIT probes, diagnostic tools) without pulling in the full
// IR-to-WASM lowering pass (~1904 lines).
//
// Consumers that need the full lowering machinery: use wasm::lower::*

module wasm::lower_ctx

// ============================================================================
// Capacity constants
// ============================================================================

let WASM_LOWER_MAX_LOCALS: i64 = 512
let WASM_LOWER_MAX_FUNCS: i64 = 256
let WASM_LOWER_MAX_LABELS: i64 = 64

// ============================================================================
// Label kind flags — structured control flow stack
// ============================================================================

let WASM_LABEL_BLOCK: i64 = 0
let WASM_LABEL_LOOP: i64 = 1

// ============================================================================
// WasmLabelEntry — one entry on the structured control flow label stack
// ============================================================================

struct WasmLabelEntry {
    ir_label_id: i64,
    kind: i64,
}

fn wasm_label_entry_new(ir_label: i64, kind: i64) -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: ir_label, kind: kind }
}

fn wasm_label_entry_empty() -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: 0 - 1, kind: WASM_LABEL_BLOCK }
}
