// self-hosted::wasm::mod — WebAssembly binary format emitter
//
// Emits valid WASM 1.0 binary modules from structured section descriptors.
// Follows the PtxBuf / SpvBuf buffer pattern used elsewhere in the self-hosted
// compiler:  flat byte array + length counter, value-return mutation.
//
// WASM binary format reference (MVP):
//   Magic:   \0asm           (4 bytes: 0x00 0x61 0x73 0x6D)
//   Version: 1               (4 bytes: 0x01 0x00 0x00 0x00)
//   Sections: id(1 byte) + payload_len(LEB128) + payload
//
// Section IDs used here:
//   1 = Type    3 = Function    5 = Memory    7 = Export    10 = Code
//
// LEB128 encoding is required for all integer fields in WASM.

module wasm::emitter

// ============================================================================
// WASM value type constants
// ============================================================================

let WASM_TYPE_I32: i64 = 0x7F
let WASM_TYPE_I64: i64 = 0x7E
let WASM_TYPE_F32: i64 = 0x7D
let WASM_TYPE_F64: i64 = 0x7C
let WASM_TYPE_FUNCREF: i64 = 0x70
let WASM_TYPE_FUNC: i64 = 0x60

// Section IDs
let WASM_SECTION_TYPE: i64 = 1
let WASM_SECTION_IMPORT: i64 = 2
let WASM_SECTION_FUNCTION: i64 = 3
let WASM_SECTION_TABLE: i64 = 4
let WASM_SECTION_MEMORY: i64 = 5
let WASM_SECTION_GLOBAL: i64 = 6
let WASM_SECTION_EXPORT: i64 = 7
let WASM_SECTION_START: i64 = 8
let WASM_SECTION_ELEMENT: i64 = 9
let WASM_SECTION_CODE: i64 = 10
let WASM_SECTION_DATA: i64 = 11

// Export kinds
let WASM_EXPORT_FUNC: i64 = 0x00
let WASM_EXPORT_TABLE: i64 = 0x01
let WASM_EXPORT_MEMORY: i64 = 0x02
let WASM_EXPORT_GLOBAL: i64 = 0x03

// ============================================================================
// WasmBuf — binary byte buffer (256KB)
// ============================================================================

pub struct WasmBuf {
    data: [i8; 262144],
    len: i64,
}

pub fn wasm_buf_new() -> WasmBuf {
    var out: WasmBuf
    out.len = 0
    out
}

pub fn wasm_push_byte(buf: WasmBuf, b: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 262144 {
            let masked = b % 256
            var byte_val = masked
            if byte_val < 0 { byte_val = byte_val + 256 }
            out.data[out.len as usize] = byte_val as i8
            out.len = out.len + 1
        }
    }
    out
}

pub fn wasm_push_str(buf: WasmBuf, s: string) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 262144 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// LEB128 encoding — unsigned and signed
// ============================================================================

// Encode an unsigned 32-bit integer in LEB128 format.
// Each output byte carries 7 data bits; the high bit indicates continuation.
pub fn wasm_push_u32_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    // Mask to 32 bits to handle negative i64 representations of u32 values
    if v < 0 { v = v + 4294967296 }
    var done = false
    while !done {
        let low7 = v % 128
        v = v / 128
        if v == 0 {
            out = wasm_push_byte(out, low7)
            done = true
        } else {
            out = wasm_push_byte(out, low7 + 128)
        }
    }
    out
}

// Encode a signed 32-bit integer in LEB128 format.
pub fn wasm_push_i32_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    var done = false
    while !done {
        // Extract low 7 bits (handle negative values with masking)
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        // Floor division: Sounio uses truncated div, so (-1/128)=0 not -1.
        // For negative v: floor(v/128) = (v-127)/128 via truncated div.
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        // For negative numbers, v will be -1 eventually
        // Sign bit of the 7-bit value is bit 6 (value 64)
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            // Positive number, no more bytes needed, sign bit is 0
            out = wasm_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            // Negative number, no more bytes needed, sign bit is 1
            out = wasm_push_byte(out, byte_val)
            done = true
        } else {
            // More bytes needed — set continuation bit
            out = wasm_push_byte(out, byte_val + 128)
        }
    }
    out
}

// Encode a signed 64-bit integer in LEB128 format (for i64.const).
pub fn wasm_push_i64_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_push_byte(out, byte_val + 128)
        }
    }
    out
}

// ============================================================================
// Helper: compute LEB128 byte length of a u32 value (for size calculations)
// ============================================================================

pub fn wasm_u32_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    if v < 0 { v = v + 4294967296 }
    var count: i64 = 0
    var done = false
    while !done {
        v = v / 128
        count = count + 1
        if v == 0 {
            done = true
        }
    }
    count
}

pub fn wasm_i32_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    var count: i64 = 0
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        v = v / 128
        count = count + 1
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            done = true
        }
    }
    count
}

pub fn wasm_i64_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    // Signed LEB128 byte length for i64 (mirrors wasm_push_i64_leb128 counting logic)
    var v = val
    var count: i64 = 0
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        count = count + 1
        if v == 0 && sign_bit < 64 {
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            done = true
        }
    }
    count
}

// ============================================================================
// Section-level data structures
// ============================================================================

// A single function type: (params...) -> (results...)
pub struct WasmFuncType {
    params: [i64; 16],
    param_count: i64,
    results: [i64; 4],
    result_count: i64,
}

pub fn wasm_func_type_new() -> WasmFuncType {
    var out: WasmFuncType
    out.param_count = 0
    out.result_count = 0
    out
}

pub fn wasm_func_type_add_param(ft: WasmFuncType, val_type: i64) -> WasmFuncType with Mut, Panic {
    var out = ft
    if out.param_count < 16 {
        out.params[out.param_count as usize] = val_type
        out.param_count = out.param_count + 1
    }
    out
}

pub fn wasm_func_type_add_result(ft: WasmFuncType, val_type: i64) -> WasmFuncType with Mut, Panic {
    var out = ft
    if out.result_count < 4 {
        out.results[out.result_count as usize] = val_type
        out.result_count = out.result_count + 1
    }
    out
}

// Type section: vector of function types
pub struct WasmTypeSection {
    types: [WasmFuncType; 256],
    count: i64,
}

pub fn wasm_type_section_new() -> WasmTypeSection {
    var out: WasmTypeSection
    out.count = 0
    out
}

pub fn wasm_type_section_add(ts: WasmTypeSection, ft: WasmFuncType) -> WasmTypeSection with Mut, Panic {
    var out = ts
    if out.count < 256 {
        out.types[out.count as usize] = ft
        out.count = out.count + 1
    }
    out
}

// Function section: maps function index to type index
pub struct WasmFuncSection {
    type_indices: [i64; 256],
    count: i64,
}

pub fn wasm_func_section_new() -> WasmFuncSection {
    var out: WasmFuncSection
    out.count = 0
    out
}

pub fn wasm_func_section_add(fs: WasmFuncSection, type_idx: i64) -> WasmFuncSection with Mut, Panic {
    var out = fs
    if out.count < 256 {
        out.type_indices[out.count as usize] = type_idx
        out.count = out.count + 1
    }
    out
}

// Export entry
pub struct WasmExport {
    name_buf: [i8; 128],
    name_len: i64,
    kind: i64,
    index: i64,
}

pub fn wasm_export_new() -> WasmExport {
    var out: WasmExport
    out.name_len = 0
    out.kind = 0
    out.index = 0
    out
}

pub fn wasm_export_set_name(exp: WasmExport, name: string) -> WasmExport with Mut, Panic, Div {
    var out = exp
    let n = str_len(name)
    var i: i64 = 0
    while i < n {
        if i < 128 {
            out.name_buf[i as usize] = str_char_at(name, i) as i8
        }
        i = i + 1
    }
    out.name_len = n
    if out.name_len > 128 { out.name_len = 128 }
    out
}

pub fn wasm_export_func(name: string, func_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    exp = wasm_export_set_name(exp, name)
    exp.kind = WASM_EXPORT_FUNC
    exp.index = func_idx
    exp
}

pub fn wasm_export_memory(name: string, mem_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    exp = wasm_export_set_name(exp, name)
    exp.kind = WASM_EXPORT_MEMORY
    exp.index = mem_idx
    exp
}

// Export section
pub struct WasmExportSection {
    exports: [WasmExport; 64],
    count: i64,
}

pub fn wasm_export_section_new() -> WasmExportSection {
    var out: WasmExportSection
    out.count = 0
    out
}

pub fn wasm_export_section_add(es: WasmExportSection, exp: WasmExport) -> WasmExportSection with Mut, Panic {
    var out = es
    if out.count < 64 {
        out.exports[out.count as usize] = exp
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// Import section (ID = 2)
//
// Format:
//   section_id(2) | payload_len(LEB128)
//   count(LEB128)
//   for each import:
//     module_name_len(LEB128) | module_name_bytes...
//     func_name_len(LEB128)   | func_name_bytes...
//     kind(1 byte: 0x00=func)
//     type_index(LEB128)
// ============================================================================

let WASM_IMPORT_KIND_FUNC: i64 = 0
let WASM_IMPORT_MAX: i64 = 64

pub struct WasmImport {
    module_buf: [i8; 32],
    module_len: i64,
    name_buf:   [i8; 32],
    name_len:   i64,
    type_index: i64,
}

pub struct WasmImportSection {
    imports: [WasmImport; 64],
    count:   i64,
}

pub fn wasm_import_new() -> WasmImport {
    var out: WasmImport
    out.module_len = 0
    out.name_len = 0
    out.type_index = 0
    out
}

pub fn wasm_import_section_new() -> WasmImportSection {
    var out: WasmImportSection
    out.count = 0
    out
}

pub fn wasm_import_section_add(sec: WasmImportSection, imp: WasmImport) -> WasmImportSection with Mut, Panic {
    var out = sec
    if out.count < WASM_IMPORT_MAX {
        out.imports[out.count as usize] = imp
        out.count = out.count + 1
    }
    out
}

pub fn wasm_import_byte_size(imp: WasmImport) -> i64 with Mut, Panic, Div {
    // module_len(LEB128) + module_bytes + name_len(LEB128) + name_bytes + kind(1) + type_idx(LEB128)
    wasm_u32_leb128_len(imp.module_len) + imp.module_len
        + wasm_u32_leb128_len(imp.name_len) + imp.name_len
        + 1
        + wasm_u32_leb128_len(imp.type_index)
}

pub fn wasm_import_section_payload_size(sec: WasmImportSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.count)
    var i: i64 = 0
    while i < sec.count {
        size = size + wasm_import_byte_size(sec.imports[i as usize])
        i = i + 1
    }
    size
}

pub fn wasm_emit_import_section(buf: WasmBuf, sec: WasmImportSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.count == 0 { return out }

    let payload_size = wasm_import_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_IMPORT, payload_size)
    out = wasm_push_u32_leb128(out, sec.count)

    var i: i64 = 0
    while i < sec.count {
        let imp = sec.imports[i as usize]
        // module name length + bytes
        out = wasm_push_u32_leb128(out, imp.module_len)
        var m: i64 = 0
        while m < imp.module_len {
            out = wasm_push_byte(out, imp.module_buf[m as usize] as i64)
            m = m + 1
        }
        // function name length + bytes
        out = wasm_push_u32_leb128(out, imp.name_len)
        var n: i64 = 0
        while n < imp.name_len {
            out = wasm_push_byte(out, imp.name_buf[n as usize] as i64)
            n = n + 1
        }
        // kind = 0x00 (function)
        out = wasm_push_byte(out, WASM_IMPORT_KIND_FUNC)
        // type index
        out = wasm_push_u32_leb128(out, imp.type_index)
        i = i + 1
    }
    out
}

// Local variable declaration within a function body
pub struct WasmLocal {
    count: i64,
    val_type: i64,
}

pub fn wasm_local_new(count: i64, val_type: i64) -> WasmLocal {
    WasmLocal { count: count, val_type: val_type }
}

// Function body (code for one function)
pub struct WasmFuncBody {
    code: [i8; 8192],
    code_len: i64,
    locals: [WasmLocal; 32],
    local_count: i64,
}

pub fn wasm_func_body_new() -> WasmFuncBody {
    var out: WasmFuncBody
    out.code_len = 0
    out.local_count = 0
    out
}

// Code section: vector of function bodies
pub struct WasmCodeSection {
    bodies: [WasmFuncBody; 256],
    count: i64,
}

pub fn wasm_code_section_new() -> WasmCodeSection {
    var out: WasmCodeSection
    out.count = 0
    out
}

pub fn wasm_code_section_add(cs: WasmCodeSection, body: WasmFuncBody) -> WasmCodeSection with Mut, Panic {
    var out = cs
    if out.count < 256 {
        out.bodies[out.count as usize] = body
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// Magic + Version header
// ============================================================================

pub fn wasm_emit_magic(buf: WasmBuf) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    // \0asm = 0x00 0x61 0x73 0x6D
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x61)
    out = wasm_push_byte(out, 0x73)
    out = wasm_push_byte(out, 0x6D)
    // Version 1 = 0x01 0x00 0x00 0x00
    out = wasm_push_byte(out, 0x01)
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x00)
    out
}

// ============================================================================
// Section header: section_id(1 byte) + payload_len(LEB128)
// ============================================================================

pub fn wasm_emit_section_header(buf: WasmBuf, section_id: i64, payload_len: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    out = wasm_push_byte(out, section_id)
    out = wasm_push_u32_leb128(out, payload_len)
    out
}

// ============================================================================
// Type section (ID = 1)
//
// Format:
//   section_id(1) | payload_len(LEB128)
//   count(LEB128)
//   for each type:
//     0x60 | param_count(LEB128) | params... | result_count(LEB128) | results...
// ============================================================================

// Compute the byte size of a single func type encoding
pub fn wasm_func_type_byte_size(ft: WasmFuncType) -> i64 with Mut, Panic, Div {
    // 1 byte for 0x60 marker
    var size: i64 = 1
    // param count (LEB128)
    size = size + wasm_u32_leb128_len(ft.param_count)
    // param types (1 byte each)
    size = size + ft.param_count
    // result count (LEB128)
    size = size + wasm_u32_leb128_len(ft.result_count)
    // result types (1 byte each)
    size = size + ft.result_count
    size
}

// Compute total payload size for the type section
pub fn wasm_type_section_payload_size(ts: WasmTypeSection) -> i64 with Mut, Panic, Div {
    // count(LEB128)
    var size = wasm_u32_leb128_len(ts.count)
    var i: i64 = 0
    while i < ts.count {
        size = size + wasm_func_type_byte_size(ts.types[i as usize])
        i = i + 1
    }
    size
}

pub fn wasm_emit_type_section(buf: WasmBuf, types: WasmTypeSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if types.count == 0 { return out }

    let payload_size = wasm_type_section_payload_size(types)
    out = wasm_emit_section_header(out, WASM_SECTION_TYPE, payload_size)

    // Count of types
    out = wasm_push_u32_leb128(out, types.count)

    // Each function type
    var i: i64 = 0
    while i < types.count {
        let ft = types.types[i as usize]
        // 0x60 marker
        out = wasm_push_byte(out, WASM_TYPE_FUNC)
        // Params
        out = wasm_push_u32_leb128(out, ft.param_count)
        var p: i64 = 0
        while p < ft.param_count {
            out = wasm_push_byte(out, ft.params[p as usize])
            p = p + 1
        }
        // Results
        out = wasm_push_u32_leb128(out, ft.result_count)
        var r: i64 = 0
        while r < ft.result_count {
            out = wasm_push_byte(out, ft.results[r as usize])
            r = r + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Function section (ID = 3)
//
// Format:
//   section_id(3) | payload_len(LEB128)
//   count(LEB128)
//   for each function: type_index(LEB128)
// ============================================================================

pub fn wasm_func_section_payload_size(fs: WasmFuncSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(fs.count)
    var i: i64 = 0
    while i < fs.count {
        size = size + wasm_u32_leb128_len(fs.type_indices[i as usize])
        i = i + 1
    }
    size
}

pub fn wasm_emit_function_section(buf: WasmBuf, funcs: WasmFuncSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if funcs.count == 0 { return out }

    let payload_size = wasm_func_section_payload_size(funcs)
    out = wasm_emit_section_header(out, WASM_SECTION_FUNCTION, payload_size)

    out = wasm_push_u32_leb128(out, funcs.count)
    var i: i64 = 0
    while i < funcs.count {
        out = wasm_push_u32_leb128(out, funcs.type_indices[i as usize])
        i = i + 1
    }
    out
}

// ============================================================================
// Memory section (ID = 5)
//
// Format:
//   section_id(5) | payload_len(LEB128)
//   count(LEB128) = 1
//   limits_flag(1 byte): 0 = min only, 1 = min + max
//   min_pages(LEB128)
//   [max_pages(LEB128)]  if flag == 1
// ============================================================================

pub fn wasm_memory_payload_size(min_pages: i64, max_pages: i64) -> i64 with Mut, Panic, Div {
    // count = 1 (LEB128 len)
    var size = wasm_u32_leb128_len(1)
    if max_pages > 0 {
        // flag(1) + min(LEB128) + max(LEB128)
        size = size + 1 + wasm_u32_leb128_len(min_pages) + wasm_u32_leb128_len(max_pages)
    } else {
        // flag(1) + min(LEB128)
        size = size + 1 + wasm_u32_leb128_len(min_pages)
    }
    size
}

pub fn wasm_emit_memory_section(buf: WasmBuf, min_pages: i64, max_pages: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    let payload_size = wasm_memory_payload_size(min_pages, max_pages)
    out = wasm_emit_section_header(out, WASM_SECTION_MEMORY, payload_size)

    // Count of memories (always 1 in MVP)
    out = wasm_push_u32_leb128(out, 1)

    if max_pages > 0 {
        // Limits with max
        out = wasm_push_byte(out, 0x01)
        out = wasm_push_u32_leb128(out, min_pages)
        out = wasm_push_u32_leb128(out, max_pages)
    } else {
        // Limits without max
        out = wasm_push_byte(out, 0x00)
        out = wasm_push_u32_leb128(out, min_pages)
    }
    out
}

// ============================================================================
// Export section (ID = 7)
//
// Format:
//   section_id(7) | payload_len(LEB128)
//   count(LEB128)
//   for each export:
//     name_len(LEB128) | name(bytes) | kind(1 byte) | index(LEB128)
// ============================================================================

pub fn wasm_export_byte_size(exp: WasmExport) -> i64 with Mut, Panic, Div {
    // name_len(LEB128) + name_bytes + kind(1) + index(LEB128)
    var size = wasm_u32_leb128_len(exp.name_len)
    size = size + exp.name_len
    size = size + 1  // kind
    size = size + wasm_u32_leb128_len(exp.index)
    size
}

pub fn wasm_export_section_payload_size(es: WasmExportSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(es.count)
    var i: i64 = 0
    while i < es.count {
        size = size + wasm_export_byte_size(es.exports[i as usize])
        i = i + 1
    }
    size
}

pub fn wasm_emit_export_section(buf: WasmBuf, exports: WasmExportSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if exports.count == 0 { return out }

    let payload_size = wasm_export_section_payload_size(exports)
    out = wasm_emit_section_header(out, WASM_SECTION_EXPORT, payload_size)

    out = wasm_push_u32_leb128(out, exports.count)
    var i: i64 = 0
    while i < exports.count {
        let exp = exports.exports[i as usize]
        // Name (length-prefixed UTF-8)
        out = wasm_push_u32_leb128(out, exp.name_len)
        var j: i64 = 0
        while j < exp.name_len {
            out = wasm_push_byte(out, exp.name_buf[j as usize] as i64)
            j = j + 1
        }
        // Kind
        out = wasm_push_byte(out, exp.kind)
        // Index
        out = wasm_push_u32_leb128(out, exp.index)
        i = i + 1
    }
    out
}

// ============================================================================
// Code section (ID = 10)
//
// Format:
//   section_id(10) | payload_len(LEB128)
//   count(LEB128)
//   for each function body:
//     body_size(LEB128)
//     local_decl_count(LEB128)
//     for each local decl: count(LEB128) | type(1 byte)
//     code bytes (instructions)
// ============================================================================

// Compute byte size of a single function body entry (locals + code)
pub fn wasm_func_body_inner_size(body: WasmFuncBody) -> i64 with Mut, Panic, Div {
    // local_decl_count(LEB128)
    var size = wasm_u32_leb128_len(body.local_count)
    // each local decl: count(LEB128) + type(1 byte)
    var i: i64 = 0
    while i < body.local_count {
        size = size + wasm_u32_leb128_len(body.locals[i as usize].count)
        size = size + 1  // val_type
        i = i + 1
    }
    // instruction bytes
    size = size + body.code_len
    size
}

pub fn wasm_code_section_payload_size(cs: WasmCodeSection) -> i64 with Mut, Panic, Div {
    // count(LEB128)
    var size = wasm_u32_leb128_len(cs.count)
    var i: i64 = 0
    while i < cs.count {
        let inner = wasm_func_body_inner_size(cs.bodies[i as usize])
        // body_size(LEB128) + inner bytes
        size = size + wasm_u32_leb128_len(inner) + inner
        i = i + 1
    }
    size
}

pub fn wasm_emit_code_section(buf: WasmBuf, bodies: WasmCodeSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if bodies.count == 0 { return out }

    let payload_size = wasm_code_section_payload_size(bodies)
    out = wasm_emit_section_header(out, WASM_SECTION_CODE, payload_size)

    // Count of function bodies
    out = wasm_push_u32_leb128(out, bodies.count)

    var i: i64 = 0
    while i < bodies.count {
        let body = bodies.bodies[i as usize]
        let inner_size = wasm_func_body_inner_size(body)

        // Body size (LEB128)
        out = wasm_push_u32_leb128(out, inner_size)

        // Local declarations
        out = wasm_push_u32_leb128(out, body.local_count)
        var lc: i64 = 0
        while lc < body.local_count {
            out = wasm_push_u32_leb128(out, body.locals[lc as usize].count)
            out = wasm_push_byte(out, body.locals[lc as usize].val_type)
            lc = lc + 1
        }

        // Instruction bytes
        var ci: i64 = 0
        while ci < body.code_len {
            out = wasm_push_byte(out, body.code[ci as usize] as i64)
            ci = ci + 1
        }

        i = i + 1
    }
    out
}

// ============================================================================
// Global section (ID = 6)
//
// Holds mutable i64 globals.  We use one global (index 0) as the heap bump
// pointer, initialized to the address just past the data section.
//
// Format:
//   section_id(6) | payload_len(LEB128)
//   count(LEB128)
//   for each global:
//     val_type(1 byte: 0x7E=i64)
//     mutability(1 byte: 0=const, 1=mutable)
//     init_expr: i64.const(0x42) val(LEB128) end(0x0B)
// ============================================================================

let WASM_GLOBAL_MUTABLE: i64 = 1

// A single i64 mutable global with a known initial value.
pub struct WasmGlobal {
    init_val: i64,
}

pub struct WasmGlobalSection {
    globals: [WasmGlobal; 8],
    count:   i64,
}

pub fn wasm_global_section_new() -> WasmGlobalSection {
    var out: WasmGlobalSection
    out.count = 0
    out
}

pub fn wasm_global_section_add(sec: WasmGlobalSection, init_val: i64) -> WasmGlobalSection with Mut, Panic {
    var out = sec
    if out.count < 8 {
        out.globals[out.count as usize] = WasmGlobal { init_val: init_val }
        out.count = out.count + 1
    }
    out
}

pub fn wasm_global_entry_byte_size(g: WasmGlobal) -> i64 with Mut, Panic, Div {
    // val_type(1) + mutability(1) + i64.const(1) + val(LEB128) + end(1)
    4 + wasm_i64_leb128_len(g.init_val)
}

pub fn wasm_global_section_payload_size(sec: WasmGlobalSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.count)
    var i: i64 = 0
    while i < sec.count {
        size = size + wasm_global_entry_byte_size(sec.globals[i as usize])
        i = i + 1
    }
    size
}

pub fn wasm_emit_global_section(buf: WasmBuf, sec: WasmGlobalSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.count == 0 { return out }

    let payload_size = wasm_global_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_GLOBAL, payload_size)
    out = wasm_push_u32_leb128(out, sec.count)

    var i: i64 = 0
    while i < sec.count {
        let g = sec.globals[i as usize]
        out = wasm_push_byte(out, WASM_TYPE_I64)        // val_type = i64
        out = wasm_push_byte(out, WASM_GLOBAL_MUTABLE)  // mutable = 1
        out = wasm_push_byte(out, 0x42)                 // i64.const opcode
        out = wasm_push_i64_leb128(out, g.init_val)    // initial value
        out = wasm_push_byte(out, 0x0B)                 // end
        i = i + 1
    }
    out
}

// ============================================================================
// Data section (ID = 11)
//
// Holds constant byte strings placed in linear memory at load time.
// Each segment specifies: memory_index(0) | offset_expr | byte_count | bytes...
//
// Format (MVP active data segment):
//   section_id(11) | payload_len(LEB128)
//   count(LEB128)
//   for each segment:
//     kind(LEB128, 0 = active, memory 0, i32.const offset)
//     offset_expr: i32.const(0x41) offset(LEB128) end(0x0B)
//     byte_count(LEB128)
//     bytes...
// ============================================================================

let WASM_DATA_MAX_BYTES: i64 = 65536

pub struct WasmDataSection {
    data:       [i8; 65536],
    data_len:   i64,
    seg_count:  i64,          // number of segments (each string = one segment)
    seg_offset: [i64; 512],   // seg_offset[i] = byte offset of segment i in data[]
    seg_len:    [i64; 512],   // seg_len[i]    = byte count of segment i
}

pub fn wasm_data_section_new() -> WasmDataSection {
    var out: WasmDataSection
    out.data_len = 0
    out.seg_count = 0
    out
}

// Add a Name's bytes as a new data segment at the current offset.
// Returns updated section.  The segment is null-terminated.
pub fn wasm_data_section_add_name(sec: WasmDataSection, name: Name) -> WasmDataSection with Mut, Panic, Div {
    var out = sec
    if out.seg_count >= 512 { return out }
    let seg_idx = out.seg_count
    out.seg_offset[seg_idx as usize] = out.data_len
    var i: i64 = 0
    while i < name.len && out.data_len < WASM_DATA_MAX_BYTES {
        out.data[out.data_len as usize] = name.buf[i as usize]
        out.data_len = out.data_len + 1
        i = i + 1
    }
    // null terminator
    if out.data_len < WASM_DATA_MAX_BYTES {
        out.data[out.data_len as usize] = 0
        out.data_len = out.data_len + 1
    }
    out.seg_len[seg_idx as usize] = name.len + 1  // include null terminator
    out.seg_count = out.seg_count + 1
    out
}

pub fn wasm_data_segment_header_size(seg_offset: i64, seg_len: i64) -> i64 with Mut, Panic, Div {
    // kind(1) + i32.const(1) + offset(LEB128) + end(1) + byte_count(LEB128)
    1 + 1 + wasm_u32_leb128_len(seg_offset) + 1 + wasm_u32_leb128_len(seg_len)
}

pub fn wasm_data_section_payload_size(sec: WasmDataSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.seg_count)
    var i: i64 = 0
    while i < sec.seg_count {
        let soff = sec.seg_offset[i as usize]
        let slen = sec.seg_len[i as usize]
        size = size + wasm_data_segment_header_size(soff, slen) + slen
        i = i + 1
    }
    size
}

pub fn wasm_emit_data_section(buf: WasmBuf, sec: WasmDataSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.seg_count == 0 { return out }

    let payload_size = wasm_data_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_DATA, payload_size)
    out = wasm_push_u32_leb128(out, sec.seg_count)

    var i: i64 = 0
    while i < sec.seg_count {
        let soff = sec.seg_offset[i as usize]
        let slen = sec.seg_len[i as usize]
        // kind = 0 (active, memory 0, i32.const offset)
        out = wasm_push_u32_leb128(out, 0)
        // offset expression: i32.const <soff> end
        out = wasm_push_byte(out, 0x41)             // i32.const
        out = wasm_push_u32_leb128(out, soff)       // offset value
        out = wasm_push_byte(out, 0x0B)             // end
        // byte count
        out = wasm_push_u32_leb128(out, slen)
        // bytes
        var b: i64 = soff
        while b < soff + slen {
            out = wasm_push_byte(out, sec.data[b as usize] as i64)
            b = b + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Full module assembly
// ============================================================================

pub fn wasm_emit_full_module(
    types: WasmTypeSection,
    imports: WasmImportSection,
    funcs: WasmFuncSection,
    globals: WasmGlobalSection,
    min_pages: i64,
    max_pages: i64,
    exports: WasmExportSection,
    code: WasmCodeSection,
    data: WasmDataSection
) -> WasmBuf with Mut, Panic, Div {
    var buf = wasm_buf_new()

    // 1. Magic + version
    buf = wasm_emit_magic(buf)

    // 2. Type section (types for both imports and local functions)
    buf = wasm_emit_type_section(buf, types)

    // 3. Import section (before function section — WASM spec ordering)
    buf = wasm_emit_import_section(buf, imports)

    // 4. Function section (local functions only; indices offset by import count)
    buf = wasm_emit_function_section(buf, funcs)

    // 5. Memory section (skip if min_pages == 0 and max_pages == 0)
    if min_pages > 0 || max_pages > 0 {
        buf = wasm_emit_memory_section(buf, min_pages, max_pages)
    }

    // 6. Global section (heap bump pointer + any other globals)
    buf = wasm_emit_global_section(buf, globals)

    // 7. Export section
    buf = wasm_emit_export_section(buf, exports)

    // 8. Code section (local functions only)
    buf = wasm_emit_code_section(buf, code)

    // 9. Data section (string literals in linear memory)
    buf = wasm_emit_data_section(buf, data)

    buf
}

// ============================================================================
// Buffer inspection helpers (for testing)
// ============================================================================

pub fn wasm_buf_byte_at(buf: WasmBuf, idx: i64) -> i64 with Mut, Panic {
    if idx < 0 { return 0 }
    if idx >= buf.len { return 0 }
    let raw = buf.data[idx as usize] as i64
    // Ensure unsigned interpretation
    if raw < 0 { return raw + 256 }
    raw
}

pub fn wasm_buf_contains_bytes(buf: WasmBuf, offset: i64, expected: [i64; 16], expected_len: i64) -> bool with Mut, Panic, Div {
    if offset + expected_len > buf.len { return false }
    var i: i64 = 0
    while i < expected_len {
        let actual = wasm_buf_byte_at(buf, offset + i)
        if actual != expected[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Inline tests
// ============================================================================

pub fn test_wasm_leb128_zero() -> bool with Mut, Panic, Div {
    // LEB128 of 0 should be a single byte: 0x00
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 0)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 0
}

pub fn test_wasm_leb128_small() -> bool with Mut, Panic, Div {
    // LEB128 of 42 fits in one byte: 0x2A
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 42)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 42
}

pub fn test_wasm_leb128_127() -> bool with Mut, Panic, Div {
    // LEB128 of 127 fits in one byte: 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 127)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 127
}

pub fn test_wasm_leb128_128() -> bool with Mut, Panic, Div {
    // LEB128 of 128 requires two bytes: 0x80 0x01
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 128)
    buf.len == 2 && wasm_buf_byte_at(buf, 0) == 128 && wasm_buf_byte_at(buf, 1) == 1
}

pub fn test_wasm_leb128_624485() -> bool with Mut, Panic, Div {
    // Classic test: 624485 -> 0xE5 0x8E 0x26
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 624485)
    buf.len == 3
        && wasm_buf_byte_at(buf, 0) == 0xE5
        && wasm_buf_byte_at(buf, 1) == 0x8E
        && wasm_buf_byte_at(buf, 2) == 0x26
}

pub fn test_wasm_signed_leb128_neg1() -> bool with Mut, Panic, Div {
    // Signed LEB128 of -1 should be a single byte: 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_i32_leb128(buf, 0 - 1)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 0x7F
}

pub fn test_wasm_signed_leb128_neg128() -> bool with Mut, Panic, Div {
    // Signed LEB128 of -128 should be: 0x80 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_i32_leb128(buf, 0 - 128)
    buf.len == 2
        && wasm_buf_byte_at(buf, 0) == 0x80
        && wasm_buf_byte_at(buf, 1) == 0x7F
}

pub fn test_wasm_magic_header() -> bool with Mut, Panic, Div {
    // WASM magic: 00 61 73 6D 01 00 00 00
    var buf = wasm_buf_new()
    buf = wasm_emit_magic(buf)
    buf.len == 8
        && wasm_buf_byte_at(buf, 0) == 0x00
        && wasm_buf_byte_at(buf, 1) == 0x61
        && wasm_buf_byte_at(buf, 2) == 0x73
        && wasm_buf_byte_at(buf, 3) == 0x6D
        && wasm_buf_byte_at(buf, 4) == 0x01
        && wasm_buf_byte_at(buf, 5) == 0x00
        && wasm_buf_byte_at(buf, 6) == 0x00
        && wasm_buf_byte_at(buf, 7) == 0x00
}

pub fn test_wasm_type_section_single() -> bool with Mut, Panic, Div {
    // Type section with one func type: (i32, i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var buf = wasm_buf_new()
    buf = wasm_emit_type_section(buf, ts)

    // Section header: 0x01 (type section ID)
    // Payload: count(1) + 0x60 + param_count(2) + i32 i32 + result_count(1) + i32
    // Payload size = 1 + 1 + 1 + 2 + 1 + 1 = 7
    // Total bytes: 1(section_id) + 1(payload_len=7) + 7 = 9
    buf.len == 9
        && wasm_buf_byte_at(buf, 0) == 0x01      // section id
        && wasm_buf_byte_at(buf, 1) == 7          // payload length
        && wasm_buf_byte_at(buf, 2) == 1          // type count
        && wasm_buf_byte_at(buf, 3) == 0x60       // func type marker
        && wasm_buf_byte_at(buf, 4) == 2          // param count
        && wasm_buf_byte_at(buf, 5) == 0x7F       // i32
        && wasm_buf_byte_at(buf, 6) == 0x7F       // i32
        && wasm_buf_byte_at(buf, 7) == 1          // result count
        && wasm_buf_byte_at(buf, 8) == 0x7F       // i32
}

pub fn test_wasm_memory_section_min_only() -> bool with Mut, Panic, Div {
    // Memory section with min=1, no max
    var buf = wasm_buf_new()
    buf = wasm_emit_memory_section(buf, 1, 0)

    // Section header: 0x05, payload_len
    // Payload: count(1) + flag(0x00) + min(1)
    // Payload size = 1 + 1 + 1 = 3
    // Total: 1 + 1 + 3 = 5
    buf.len == 5
        && wasm_buf_byte_at(buf, 0) == 0x05      // section id
        && wasm_buf_byte_at(buf, 1) == 3          // payload length
        && wasm_buf_byte_at(buf, 2) == 1          // memory count
        && wasm_buf_byte_at(buf, 3) == 0x00       // limits flag (min only)
        && wasm_buf_byte_at(buf, 4) == 1          // min pages
}

pub fn test_wasm_memory_section_min_max() -> bool with Mut, Panic, Div {
    // Memory section with min=1, max=10
    var buf = wasm_buf_new()
    buf = wasm_emit_memory_section(buf, 1, 10)

    // Payload: count(1) + flag(0x01) + min(1) + max(10)
    // Payload size = 1 + 1 + 1 + 1 = 4
    // Total: 1 + 1 + 4 = 6
    buf.len == 6
        && wasm_buf_byte_at(buf, 0) == 0x05
        && wasm_buf_byte_at(buf, 1) == 4
        && wasm_buf_byte_at(buf, 2) == 1
        && wasm_buf_byte_at(buf, 3) == 0x01       // limits flag (min+max)
        && wasm_buf_byte_at(buf, 4) == 1           // min
        && wasm_buf_byte_at(buf, 5) == 10          // max
}

pub fn test_wasm_export_section_func() -> bool with Mut, Panic, Div {
    // Export "add" as function index 0
    var es = wasm_export_section_new()
    let exp = wasm_export_func("add", 0)
    es = wasm_export_section_add(es, exp)

    var buf = wasm_buf_new()
    buf = wasm_emit_export_section(buf, es)

    // Section header: 0x07, payload_len
    // Payload: count(1) + name_len(3) + "add" + kind(0x00) + index(0)
    // Payload size = 1 + 1 + 3 + 1 + 1 = 7
    buf.len == 9
        && wasm_buf_byte_at(buf, 0) == 0x07       // section id
        && wasm_buf_byte_at(buf, 1) == 7           // payload length
        && wasm_buf_byte_at(buf, 2) == 1           // export count
        && wasm_buf_byte_at(buf, 3) == 3           // name length
        && wasm_buf_byte_at(buf, 4) == 0x61        // 'a'
        && wasm_buf_byte_at(buf, 5) == 0x64        // 'd'
        && wasm_buf_byte_at(buf, 6) == 0x64        // 'd'
        && wasm_buf_byte_at(buf, 7) == 0x00        // kind = func
        && wasm_buf_byte_at(buf, 8) == 0x00        // index = 0
}

pub fn test_wasm_function_section() -> bool with Mut, Panic, Div {
    // Function section: two functions, both using type index 0
    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)
    fs = wasm_func_section_add(fs, 0)

    var buf = wasm_buf_new()
    buf = wasm_emit_function_section(buf, fs)

    // Section header: 0x03, payload_len
    // Payload: count(2) + type_idx(0) + type_idx(0) = 1 + 1 + 1 = 3
    buf.len == 5
        && wasm_buf_byte_at(buf, 0) == 0x03       // section id
        && wasm_buf_byte_at(buf, 1) == 3           // payload length
        && wasm_buf_byte_at(buf, 2) == 2           // function count
        && wasm_buf_byte_at(buf, 3) == 0           // type index 0
        && wasm_buf_byte_at(buf, 4) == 0           // type index 0
}

pub fn test_wasm_full_module_header() -> bool with Mut, Panic, Div {
    // Build a minimal module: one function (i32, i32) -> i32 that does i32.add
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("add", 0))

    // Function body: local.get 0, local.get 1, i32.add, end
    var body = wasm_func_body_new()
    // Emit instructions into body.code
    body.code[0 as usize] = 0x20 as i8  // local.get
    body.code[1 as usize] = 0x00 as i8  // index 0
    body.code[2 as usize] = 0x20 as i8  // local.get
    body.code[3 as usize] = 0x01 as i8  // index 1
    body.code[4 as usize] = 0x6A as i8  // i32.add
    body.code[5 as usize] = 0x0B as i8  // end
    body.code_len = 6

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    let module = wasm_emit_full_module(ts, wasm_import_section_new(), fs, wasm_global_section_new(), 1, 0, es, cs, wasm_data_section_new())

    // Verify magic + version at start
    module.len > 8
        && wasm_buf_byte_at(module, 0) == 0x00
        && wasm_buf_byte_at(module, 1) == 0x61
        && wasm_buf_byte_at(module, 2) == 0x73
        && wasm_buf_byte_at(module, 3) == 0x6D
        && wasm_buf_byte_at(module, 4) == 0x01
}

pub fn test_wasm_leb128_len_helper() -> bool with Mut, Panic, Div {
    // Verify the u32_leb128_len helper
    wasm_u32_leb128_len(0) == 1
        && wasm_u32_leb128_len(1) == 1
        && wasm_u32_leb128_len(127) == 1
        && wasm_u32_leb128_len(128) == 2
        && wasm_u32_leb128_len(16383) == 2
        && wasm_u32_leb128_len(16384) == 3
}

pub fn test_wasm_signed_leb128_positive() -> bool with Mut, Panic, Div {
    // Signed LEB128 of 63 fits in one byte: 0x3F
    // Signed LEB128 of 64 requires two bytes: 0xC0 0x00
    var buf1 = wasm_buf_new()
    buf1 = wasm_push_i32_leb128(buf1, 63)

    var buf2 = wasm_buf_new()
    buf2 = wasm_push_i32_leb128(buf2, 64)

    buf1.len == 1 && wasm_buf_byte_at(buf1, 0) == 63
        && buf2.len == 2 && wasm_buf_byte_at(buf2, 0) == 0xC0 && wasm_buf_byte_at(buf2, 1) == 0x00
}

pub fn test_wasm_code_section_simple() -> bool with Mut, Panic, Div {
    // A function body with no locals, just [i32.const 42, end]
    var body = wasm_func_body_new()
    body.code[0 as usize] = 0x41 as i8  // i32.const
    body.code[1 as usize] = 42 as i8    // 42 (signed LEB128)
    body.code[2 as usize] = 0x0B as i8  // end
    body.code_len = 3

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    var buf = wasm_buf_new()
    buf = wasm_emit_code_section(buf, cs)

    // Section header: 0x0A, payload
    // Payload: count(1) + body_size(LEB128) + local_count(0) + code(3 bytes)
    // inner_size = 1(local_count=0) + 3(code) = 4
    // Payload = 1(count) + 1(body_size=4) + 4(inner) = 6
    // Total: 1(section) + 1(payload_len=6) + 6 = 8
    buf.len == 8
        && wasm_buf_byte_at(buf, 0) == 0x0A       // section id = 10
        && wasm_buf_byte_at(buf, 1) == 6           // payload length
        && wasm_buf_byte_at(buf, 2) == 1           // body count
        && wasm_buf_byte_at(buf, 3) == 4           // body size (inner)
        && wasm_buf_byte_at(buf, 4) == 0           // local decl count
        && wasm_buf_byte_at(buf, 5) == 0x41        // i32.const
        && wasm_buf_byte_at(buf, 6) == 42          // 42
        && wasm_buf_byte_at(buf, 7) == 0x0B        // end
}
