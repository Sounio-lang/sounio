// self-hosted::wasm::core — Compatibility re-export layer
//
// The wasm module was refactored from a single core.sio into separate files
// (mod.sio, buf.sio, types.sio, opcodes.sio, etc.). This file re-exports
// the symbols that legacy `use wasm::core::*` importers expect, so D3-A
// (modular compiler revival) can resolve them without rewriting every
// importer.
//
// Coverage:
//   - wasm::types::*  — constant integers (WASM_TYPE_*, WASM_SECTION_*,
//     WASM_EXPORT_*, WASM_IMPORT_*, WASM_GLOBAL_*)
//   - wasm::mod::*    — struct types (WasmLocal, WasmFuncType, etc.) and
//     section-building helpers
//   - wasm::opcodes::*— opcode constants
//   - wasm::buf::*    — buffer helpers used by encode.sio
//
// Per feedback_module_let_constant_import_bug.md: wildcard `use module::*`
// does NOT carry module-level `let` constants across modules, and explicit
// `use module::{CONST}` causes a 35-second stack overflow in souc. So this
// stub also inline-defines the constants that need to leak through the
// `use wasm::core::*` boundary.

module wasm::core

use wasm::types::*
use wasm::emitter::*
use wasm::opcodes::*
use wasm::buf::*

// Inline re-definitions of let constants (wildcard `use` doesn't carry these
// per the let-constant import bug). Values match wasm/types.sio.

// WASM value type tags (valtype encoding, Section 2.3.1)
let WASM_TYPE_I32:     i64 = 0x7F
let WASM_TYPE_I64:     i64 = 0x7E
let WASM_TYPE_F32:     i64 = 0x7D
let WASM_TYPE_F64:     i64 = 0x7C
let WASM_TYPE_FUNCREF: i64 = 0x70
let WASM_TYPE_FUNC:    i64 = 0x60

// Section IDs (Section 2.5 of MVP spec)
let WASM_SECTION_TYPE:     i64 = 1
let WASM_SECTION_IMPORT:   i64 = 2
let WASM_SECTION_FUNCTION: i64 = 3
let WASM_SECTION_TABLE:    i64 = 4
let WASM_SECTION_MEMORY:   i64 = 5
let WASM_SECTION_GLOBAL:   i64 = 6
let WASM_SECTION_EXPORT:   i64 = 7
let WASM_SECTION_START:    i64 = 8
let WASM_SECTION_ELEMENT:  i64 = 9
let WASM_SECTION_CODE:     i64 = 10
let WASM_SECTION_DATA:     i64 = 11

// Export/Import kind flags
let WASM_EXPORT_FUNC:   i64 = 0
let WASM_EXPORT_TABLE:  i64 = 1
let WASM_EXPORT_MEMORY: i64 = 2

let WASM_IMPORT_KIND_FUNC: i64 = 0
let WASM_IMPORT_MAX:       i64 = 64

// Global section flags
let WASM_GLOBAL_MUTABLE: i64 = 1
