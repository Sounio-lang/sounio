// self-hosted::wasm::types — WASM binary format constants
//
// Value type tags, section IDs, export/import kinds, and other
// one-byte constants from the WebAssembly MVP binary encoding spec.
//
// Split from wasm::mod to allow lightweight imports of just constants
// without loading the full section-building machinery (~1388 lines).

module wasm::types

// ============================================================================
// WASM value type tags (valtype encoding, Section 2.3.1)
// ============================================================================

let WASM_TYPE_I32: i64 = 0x7F
let WASM_TYPE_I64: i64 = 0x7E
let WASM_TYPE_F32: i64 = 0x7D
let WASM_TYPE_F64: i64 = 0x7C

// Function type marker (0x60 prefix in type section)
let WASM_TYPE_FUNC: i64 = 0x60

// ============================================================================
// Section IDs (Section 2.5 of MVP spec)
// ============================================================================

let WASM_SECTION_TYPE:     i64 = 1
let WASM_SECTION_IMPORT:   i64 = 2
let WASM_SECTION_FUNCTION: i64 = 3
let WASM_SECTION_MEMORY:   i64 = 5
let WASM_SECTION_GLOBAL:   i64 = 6
let WASM_SECTION_EXPORT:   i64 = 7
let WASM_SECTION_CODE:     i64 = 10
let WASM_SECTION_DATA:     i64 = 11

// ============================================================================
// Export/Import kind flags
// ============================================================================

let WASM_EXPORT_FUNC:   i64 = 0
let WASM_EXPORT_MEMORY: i64 = 2

let WASM_IMPORT_KIND_FUNC: i64 = 0
let WASM_IMPORT_MAX:       i64 = 64

// ============================================================================
// Global section flags
// ============================================================================

let WASM_GLOBAL_MUTABLE: i64 = 1

// ============================================================================
// Data section limits
// ============================================================================

let WASM_DATA_MAX_BYTES: i64 = 65536
