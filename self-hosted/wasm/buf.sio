// self-hosted::wasm::buf — WASM byte buffer and LEB128 encoding
//
// WasmBuf is the flat byte-array accumulator used by all WASM section
// emitters.  Follows the value-return mutation pattern: every push function
// takes a WasmBuf by value and returns an updated copy.
//
// Also contains the LEB128 encode/length helpers required by section
// emitters for computing payload sizes before writing section headers.
//
// Split from wasm::mod to allow lightweight imports of just buffer
// operations without pulling in the full section-builder machinery.

module wasm::buf

use wasm::types::*

// ============================================================================
// Flat byte buffer
// ============================================================================

pub struct WasmBuf {
    data: [i8; 262144],
    len:  i64,
}

