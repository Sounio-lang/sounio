// self-hosted::wasm::buf — WASM byte buffer and LEB128 encoding
//
// WasmBuf is the flat byte-array accumulator used by all WASM section
// emitters.  Follows the value-return mutation pattern: every push function
// takes a WasmBuf by value and returns an updated copy.
//
// Also contains the LEB128 encode/length helpers required by section
// emitters for computing payload sizes before writing section headers.
//
// Split from wasm::mod to allow lightweight imports of just buffer
// operations without pulling in the full section-builder machinery.

module wasm::buf

use wasm::types::*

// ============================================================================
// Flat byte buffer
// ============================================================================

struct WasmBuf {
    data: [i8; 262144],
    len:  i64,
}

fn wasm_buf_new() -> WasmBuf {
    WasmBuf { data: [0; 262144], len: 0 }
}

fn wasm_push_byte(buf: WasmBuf, byte: i64) -> WasmBuf with Mut, Panic {
    var out = buf
    if out.len < 262144 {
        out.data[out.len as usize] = byte as i8
        out.len = out.len + 1
    }
    out
}

// Push a Sounio string literal as raw UTF-8 bytes (no length prefix).
fn wasm_push_str(buf: WasmBuf, s: string) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = wasm_push_byte(out, str_char_at(s, i))
        i = i + 1
    }
    out
}

// ============================================================================
// LEB128 unsigned (u32) encoding — pushes 1–5 bytes
// ============================================================================

fn wasm_push_u32_leb128(buf: WasmBuf, value: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = value
    var more = true
    while more {
        let byte = v & 0x7F
        v = v / 128
        if v == 0 {
            out = wasm_push_byte(out, byte)
            more = false
        } else {
            out = wasm_push_byte(out, byte | 0x80)
        }
    }
    out
}

// ============================================================================
// LEB128 signed (i32) encoding — pushes 1–5 bytes
// ============================================================================

fn wasm_push_i32_leb128(buf: WasmBuf, value: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = value
    var more = true
    while more {
        let byte = v & 0x7F
        v = v / 128
        let sign_bit = byte & 0x40
        if (v == 0 && sign_bit == 0) || (v == (0 - 1) && sign_bit != 0) {
            out = wasm_push_byte(out, byte)
            more = false
        } else {
            out = wasm_push_byte(out, byte | 0x80)
        }
    }
    out
}

// ============================================================================
// LEB128 signed (i64) encoding — pushes 1–10 bytes
// ============================================================================

fn wasm_push_i64_leb128(buf: WasmBuf, value: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = value
    var more = true
    while more {
        let byte = v & 0x7F
        v = v / 128
        let sign_bit = byte & 0x40
        if (v == 0 && sign_bit == 0) || (v == (0 - 1) && sign_bit != 0) {
            out = wasm_push_byte(out, byte)
            more = false
        } else {
            out = wasm_push_byte(out, byte | 0x80)
        }
    }
    out
}

// ============================================================================
// LEB128 length helpers (byte count without emitting) — used by size
// computations in section emitters before writing the section header.
// ============================================================================

// Number of bytes needed to encode `value` as unsigned LEB128.
fn wasm_u32_leb128_len(value: i64) -> i64 with Mut, Panic, Div {
    if value < 128        { return 1 }
    if value < 16384      { return 2 }
    if value < 2097152    { return 3 }
    if value < 268435456  { return 4 }
    5
}

// Number of bytes needed to encode `value` as signed LEB128 (i32).
fn wasm_i32_leb128_len(value: i64) -> i64 with Mut, Panic, Div {
    var v = value
    var len: i64 = 1
    var more = true
    while more {
        let byte = v & 0x7F
        v = v / 128
        let sign_bit = byte & 0x40
        if (v == 0 && sign_bit == 0) || (v == (0 - 1) && sign_bit != 0) {
            more = false
        } else {
            len = len + 1
        }
    }
    len
}

// Number of bytes needed to encode `value` as signed LEB128 (i64).
fn wasm_i64_leb128_len(value: i64) -> i64 with Mut, Panic, Div {
    var v = value
    var len: i64 = 1
    var more = true
    while more {
        let byte = v & 0x7F
        v = v / 128
        let sign_bit = byte & 0x40
        if (v == 0 && sign_bit == 0) || (v == (0 - 1) && sign_bit != 0) {
            more = false
        } else {
            len = len + 1
        }
    }
    len
}

// ============================================================================
// Buffer inspection helpers (for testing)
// ============================================================================

// Read one byte from buf at index idx; returns 0 for out-of-range.
// Always returns value in [0, 255] (unsigned interpretation of i8).
fn wasm_buf_byte_at(buf: WasmBuf, idx: i64) -> i64 with Mut, Panic {
    if idx < 0 { return 0 }
    if idx >= buf.len { return 0 }
    let raw = buf.data[idx as usize] as i64
    if raw < 0 { return raw + 256 }
    raw
}

// True iff buf[offset .. offset+expected_len] == expected[0..expected_len].
fn wasm_buf_contains_bytes(buf: WasmBuf, offset: i64, expected: [i64; 16], expected_len: i64) -> bool with Mut, Panic, Div {
    if offset + expected_len > buf.len { return false }
    var i: i64 = 0
    while i < expected_len {
        let actual = wasm_buf_byte_at(buf, offset + i)
        if actual != expected[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}
