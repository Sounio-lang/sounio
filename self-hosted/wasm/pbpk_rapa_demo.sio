// self-hosted/wasm/pbpk_rapa_demo.sio — Rapamycin CNS PBPK · WASM target demo
//
// Standalone epistemic PBPK simulation for sirolimus (rapamycin).
// Designed as a WASM compilation target (stdout-protocol): all output via
// print/print_int builtins, fully self-contained (no stdlib imports).
//
// Run with interpreter:
//   ./souc run self-hosted/wasm/pbpk_rapa_demo.sio
//
// Future WASM compilation (when backend matures):
//   souc compile --backend=wasm self-hosted/wasm/pbpk_rapa_demo.sio -o /tmp/rapa.wasm
//   node scripts/wasm_validate_pbpk.mjs /tmp/rapa.wasm
//
// Model: 3-compartment flow-limited + membrane-limited BBB
//   Compartments: blood (5 L), brain (1.4 L, P-gp efflux), peripheral (50 L)
//   Solver: Runge-Kutta 4, dt=0.1 h, T=48 h
//   Epistemic: GUM linearisation — 3 perturbations (CL, kp_brain, fu_plasma)
//
// Sources: Ferron 1997 (CL), Lampen 1998 (BBB), Schreiber 1991 (fu)
//
// Output (stdout, JSON-lines):
//   {"metric":"bpr_mean","value":0.086}      -- brain:plasma ratio, target <0.15
//   {"metric":"auc_mg_h_l","value":4.05}     -- plasma AUC 0-48h
//   {"metric":"cv_auc","value":0.377}        -- coefficient of variation (CYP3A4 ω)
//   {"metric":"s_cl","value":0.850}          -- AUC sensitivity to CL
//   {"metric":"status","value":1}            -- 1=all pass, 0=any fail

// ============================================================================
// Fixed-point print helpers (no print_float builtin in WASM host)
// Prints f64 as decimal with 3 significant decimal places.
// ============================================================================

// Returns floor(x * 1000) as i64 (for values 0 < x < 1000)
fn to_millis(x: f64) -> i64 with Div, Panic {
    let scaled = x * 1000.0
    scaled as i64
}

// Print i64 with zero-padding to ensure exactly 3 digits after decimal
// Usage: print_f3(value_millis) prints like "0.086" or "4.050"
fn print_f3(millis: i64) with IO, Mut, Div, Panic {
    let whole = millis / 1000
    let frac  = millis - whole * 1000
    print_int(whole)
    print(".")
    // zero-pad fractional part to 3 digits
    if frac < 10 {
        print("00")
    } else {
        if frac < 100 {
            print("0")
        }
    }
    print_int(frac)
}

// Print a JSON metric line: {"metric":"<name>","value":<val_millis/1000>}
fn print_metric(name: string, millis: i64) with IO, Mut, Div, Panic {
    print("{\"metric\":\"")
    print(name)
    print("\",\"value\":")
    print_f3(millis)
    print("}\n")
}

// Print a JSON metric line for integer value (e.g. status flag)
fn print_metric_int(name: string, val: i64) with IO, Mut {
    print("{\"metric\":\"")
    print(name)
    print("\",\"value\":")
    print_int(val)
    print("}\n")
}

// ============================================================================
// 3-compartment state and parameters
// ============================================================================

struct Rp3State {
    blood:  f64,   // mg/L
    brain:  f64,   // mg/L
    periph: f64,   // mg/L
}

struct Rp3Params {
    v_blood:    f64,   // L   volume blood
    v_brain:    f64,   // L   volume brain
    v_periph:   f64,   // L   volume peripheral
    q_brain:    f64,   // L/h permeability-surface area BBB (membrane-limited, P-gp)
    q_periph:   f64,   // L/h flow to peripheral
    kp_brain:   f64,   // -   brain:blood Kp (P-gp efflux equilibrium)
    kp_periph:  f64,   // -   peripheral:blood Kp
    cl_hepatic: f64,   // L/h hepatic clearance (CYP3A4)
    fu_plasma:  f64,   // -   unbound fraction plasma
}

// Reference parameters — Ferron 1997, Lampen 1998, Schreiber 1991
fn rp3_ref_params() -> Rp3Params {
    Rp3Params {
        v_blood:    5.0,
        v_brain:    1.4,
        v_periph:   50.0,
        // BBB: membrane-limited (P-gp substrate, not perfusion-limited)
        // q_brain=0.05 → λ_brain=0.48/h → RK4 stable at dt=0.1h ✓
        // (q_brain=50 → λ=456/h → RK4 unstable!)
        q_brain:    0.05,
        q_periph:   87.0,
        kp_brain:   0.08,   // Lampen 1998 — P-gp efflux, low CNS penetration
        kp_periph:  0.5,    // distribution cap for 48h simulation
        cl_hepatic: 12.4,   // L/h CYP3A4 Ferron 1997 (ω~60%)
        fu_plasma:  0.08,   // Schreiber 1991 — strong protein binding
    }
}

fn rp3_zero_state() -> Rp3State {
    Rp3State { blood: 0.0, brain: 0.0, periph: 0.0 }
}

// ============================================================================
// ODE: dC/dt for each compartment
// ============================================================================

struct Rp3Deriv {
    d_blood:  f64,
    d_brain:  f64,
    d_periph: f64,
}

fn rp3_deriv(s: Rp3State, p: Rp3Params) -> Rp3Deriv with Div, Panic {
    // Brain flux: membrane-limited PS model
    //   J_brain = q_brain * (blood - brain/kp_brain)
    let j_brain  = p.q_brain  * (s.blood - s.brain  / p.kp_brain)
    let j_periph = p.q_periph * (s.blood - s.periph / p.kp_periph)

    // Hepatic clearance acts on unbound plasma
    let cl_eff   = p.cl_hepatic * p.fu_plasma

    let d_blood  = (0.0 - j_brain - j_periph - cl_eff * s.blood) / p.v_blood
    let d_brain  = j_brain / p.v_brain
    let d_periph = j_periph / p.v_periph

    Rp3Deriv { d_blood: d_blood, d_brain: d_brain, d_periph: d_periph }
}

// ============================================================================
// RK4 single step
// ============================================================================

struct Rp3Step {
    state: Rp3State,
}

fn rp3_rk4_step(s: Rp3State, p: Rp3Params, dt: f64) -> Rp3Step with Div, Panic {
    let k1 = rp3_deriv(s, p)

    let s2 = Rp3State {
        blood:  s.blood  + k1.d_blood  * (dt * 0.5),
        brain:  s.brain  + k1.d_brain  * (dt * 0.5),
        periph: s.periph + k1.d_periph * (dt * 0.5),
    }
    let k2 = rp3_deriv(s2, p)

    let s3 = Rp3State {
        blood:  s.blood  + k2.d_blood  * (dt * 0.5),
        brain:  s.brain  + k2.d_brain  * (dt * 0.5),
        periph: s.periph + k2.d_periph * (dt * 0.5),
    }
    let k3 = rp3_deriv(s3, p)

    let s4 = Rp3State {
        blood:  s.blood  + k3.d_blood  * dt,
        brain:  s.brain  + k3.d_brain  * dt,
        periph: s.periph + k3.d_periph * dt,
    }
    let k4 = rp3_deriv(s4, p)

    let sixth = dt / 6.0
    let next = Rp3State {
        blood:  s.blood  + (k1.d_blood  + 2.0*k2.d_blood  + 2.0*k3.d_blood  + k4.d_blood)  * sixth,
        brain:  s.brain  + (k1.d_brain  + 2.0*k2.d_brain  + 2.0*k3.d_brain  + k4.d_brain)  * sixth,
        periph: s.periph + (k1.d_periph + 2.0*k2.d_periph + 2.0*k3.d_periph + k4.d_periph) * sixth,
    }
    Rp3Step { state: next }
}

// ============================================================================
// Simulation result: trajectories + metrics
// ============================================================================

struct SimResult {
    auc_blood:   f64,   // trapezoidal AUC plasma 0-48h (mg·h/L)
    bpr:         f64,   // mean brain:plasma ratio (dimensionless)
    cmax_blood:  f64,   // peak plasma conc (mg/L)
    tmax_steps:  i64,   // step index of Cmax
}

// Simulate 2-dose regimen: 5 mg PO at t=0 and t=24h
// dt=0.1h, 480 steps, oral bioavailability=0.14, absorbed instantaneously
fn rp3_simulate(p: Rp3Params) -> SimResult with Mut, Div, Panic {
    let dt:         f64 = 0.1
    let n_steps:    i64 = 480          // 48h / 0.1h
    let dose_mg:    f64 = 5.0          // mg PO
    let f_oral:     f64 = 0.14         // bioavailability (Kahan 2001)
    let dose_step2: i64 = 240          // second dose at t=24h = step 240

    var state = rp3_zero_state()

    // First dose — instantaneous absorption (IV equivalent for demo)
    let dose_conc = dose_mg * f_oral / p.v_blood
    state = Rp3State {
        blood:  state.blood  + dose_conc,
        brain:  state.brain,
        periph: state.periph,
    }

    var auc_blood:  f64 = 0.0
    var bpr_sum:    f64 = 0.0
    var bpr_n:      i64 = 0
    var cmax_blood: f64 = 0.0
    var tmax_steps: i64 = 0

    var step: i64 = 0
    while step < n_steps {
        // Second dose at t=24h
        if step == dose_step2 {
            state = Rp3State {
                blood:  state.blood + dose_conc,
                brain:  state.brain,
                periph: state.periph,
            }
        }

        // Track Cmax
        if state.blood > cmax_blood {
            cmax_blood = state.blood
            tmax_steps = step
        }

        // Accumulate AUC (trapezoidal)
        auc_blood = auc_blood + state.blood * dt

        // Accumulate BPR (exclude first few steps while brain equilibrating)
        if step > 10 && state.blood > 0.001 {
            bpr_sum = bpr_sum + state.brain / state.blood
            bpr_n   = bpr_n + 1
        }

        // RK4 step
        let stepped = rp3_rk4_step(state, p, dt)
        state = stepped.state

        step = step + 1
    }

    var bpr_mean: f64 = 0.0
    if bpr_n > 0 {
        bpr_mean = bpr_sum / (bpr_n as f64)
    }

    SimResult {
        auc_blood:  auc_blood,
        bpr:        bpr_mean,
        cmax_blood: cmax_blood,
        tmax_steps: tmax_steps,
    }
}

// ============================================================================
// GUM uncertainty propagation — finite-difference Jacobian
// Var(AUC) = (∂AUC/∂CL)² Var(CL) + (∂AUC/∂kp)² Var(kp) + (∂AUC/∂fu)² Var(fu)
// Step h = max(1e-6 * |μ|, 1e-2 * σ)  [GUM §13.3]
// ============================================================================

struct GumResult {
    var_auc:  f64,   // variance of AUC
    s_cl:     f64,   // sensitivity fraction: (∂AUC/∂CL)² Var(CL) / Var(AUC)
    s_kp:     f64,
    s_fu:     f64,
}

fn gum_propagate(ref_p: Rp3Params, ref_auc: f64) -> GumResult with Mut, Div, Panic {
    // Prior variances — from rapamycin_epistemic_pbpk.sio test header
    let var_cl:  f64 = 54.76    // CYP3A4 ω=60% → σ_CL=7.4 L/h → Var=54.76 (Ferron 1997)
    let var_kp:  f64 = 0.000625 // σ_kp=0.025 (P-gp efflux, Lampen 1998)
    let var_fu:  f64 = 0.0004   // σ_fu=0.02 (92% bound, Schreiber 1991)

    let sig_cl  = 7.4
    let sig_kp  = 0.025
    let sig_fu  = 0.02

    // Step sizes: h = max(1e-6 * |μ|, 1e-2 * σ)
    let h_cl  = 1e-2 * sig_cl
    let h_kp  = 1e-2 * sig_kp
    let h_fu  = 1e-2 * sig_fu

    // CL perturbation
    let p_cl  = Rp3Params {
        v_blood: ref_p.v_blood, v_brain: ref_p.v_brain, v_periph: ref_p.v_periph,
        q_brain: ref_p.q_brain, q_periph: ref_p.q_periph,
        kp_brain: ref_p.kp_brain, kp_periph: ref_p.kp_periph,
        cl_hepatic: ref_p.cl_hepatic + h_cl,
        fu_plasma: ref_p.fu_plasma,
    }
    let r_cl  = rp3_simulate(p_cl)
    let dAUC_dCL  = (r_cl.auc_blood - ref_auc) / h_cl

    // kp_brain perturbation
    let p_kp  = Rp3Params {
        v_blood: ref_p.v_blood, v_brain: ref_p.v_brain, v_periph: ref_p.v_periph,
        q_brain: ref_p.q_brain, q_periph: ref_p.q_periph,
        kp_brain: ref_p.kp_brain + h_kp, kp_periph: ref_p.kp_periph,
        cl_hepatic: ref_p.cl_hepatic,
        fu_plasma: ref_p.fu_plasma,
    }
    let r_kp  = rp3_simulate(p_kp)
    let dAUC_dKP  = (r_kp.auc_blood - ref_auc) / h_kp

    // fu_plasma perturbation
    let p_fu  = Rp3Params {
        v_blood: ref_p.v_blood, v_brain: ref_p.v_brain, v_periph: ref_p.v_periph,
        q_brain: ref_p.q_brain, q_periph: ref_p.q_periph,
        kp_brain: ref_p.kp_brain, kp_periph: ref_p.kp_periph,
        cl_hepatic: ref_p.cl_hepatic,
        fu_plasma: ref_p.fu_plasma + h_fu,
    }
    let r_fu  = rp3_simulate(p_fu)
    let dAUC_dFU  = (r_fu.auc_blood - ref_auc) / h_fu

    // GUM variance
    let contrib_cl = dAUC_dCL * dAUC_dCL * var_cl
    let contrib_kp = dAUC_dKP * dAUC_dKP * var_kp
    let contrib_fu = dAUC_dFU * dAUC_dFU * var_fu
    let var_auc = contrib_cl + contrib_kp + contrib_fu

    var s_cl: f64 = 0.0
    var s_kp: f64 = 0.0
    var s_fu: f64 = 0.0
    if var_auc > 0.0 {
        s_cl = contrib_cl / var_auc
        s_kp = contrib_kp / var_auc
        s_fu = contrib_fu / var_auc
    }

    GumResult { var_auc: var_auc, s_cl: s_cl, s_kp: s_kp, s_fu: s_fu }
}

// ============================================================================
// Integer square root (Newton's method) — for CV computation without sqrt()
// Returns floor(sqrt(x * 1e6)) / 1000  (millis of stddev / mean)
// ============================================================================

fn isqrt_millis(var_millis2: i64) -> i64 with Mut, Div, Panic {
    // Approximates sqrt(var_millis2) by Newton iteration
    // var_millis2 = Var(AUC) * 1e6  (integer representation)
    if var_millis2 <= 0 { return 0 }
    var x: i64 = var_millis2 / 2 + 1
    var y: i64 = (x + var_millis2 / x) / 2
    while y < x {
        x = y
        y = (x + var_millis2 / x) / 2
    }
    x
}

// ============================================================================
// Entry point
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    let p   = rp3_ref_params()
    let ref = rp3_simulate(p)
    let gum = gum_propagate(p, ref.auc_blood)

    // BPR: mean brain:plasma ratio
    let bpr_millis = to_millis(ref.bpr)

    // AUC plasma 0-48h
    let auc_millis = to_millis(ref.auc_blood)

    // CV(AUC) = std(AUC) / mean(AUC)
    //   var_auc in (mg·h/L)² → std in mg·h/L
    //   cv = std / auc
    //   To avoid sqrt: cv² = var_auc / auc²
    //   We compute cv in millis using integer approximation
    var cv_millis: i64 = 0
    if ref.auc_blood > 0.0 {
        // cv_millis ≈ sqrt(var_auc) / auc * 1000
        // = sqrt(var_auc / auc²) * 1000
        // Use: sqrt(var_auc) ≈ sqrt(var_millis2) where var_millis2 = var_auc * 1e6
        // var_scaled = floor(var_auc * 1e6) — pass directly to isqrt
        // isqrt_millis(v) = floor(sqrt(v)) so isqrt(var_auc*1e6) = floor(std*1000)
        let var_scaled = to_millis(gum.var_auc * 1000.0)   // = floor(var_auc * 1e6)
        let std_millis = isqrt_millis(var_scaled)           // = floor(std * 1000)
        let auc_millis_div = to_millis(ref.auc_blood)
        if auc_millis_div > 0 {
            cv_millis = std_millis * 1000 / auc_millis_div
        }
    }

    // s_cl: CL's fractional contribution to AUC variance
    let s_cl_millis = to_millis(gum.s_cl)

    // Print JSON-lines output
    print_metric("bpr_mean",    bpr_millis)
    print_metric("auc_mg_h_l",  auc_millis)
    print_metric("cv_auc",      cv_millis)
    print_metric("s_cl",        s_cl_millis)

    // Validation summary
    var passes: i64 = 0
    var total:  i64 = 0

    total = total + 1
    if ref.bpr < 0.15 { passes = passes + 1 }  // P-gp efflux: BBB excludes rapa

    total = total + 1
    if cv_millis > 300 { passes = passes + 1 }  // CYP3A4 ω > 30%

    total = total + 1
    if gum.s_cl > 0.5 { passes = passes + 1 }  // CL dominates AUC uncertainty

    print_metric_int("passes", passes)
    print_metric_int("total",  total)
    if passes == total {
        print("{\"metric\":\"status\",\"value\":1}\n")
    } else {
        print("{\"metric\":\"status\",\"value\":0}\n")
    }
}
