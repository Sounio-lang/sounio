// self-hosted::wasm::lower — IR-to-WASM lowering pass
//
// Translates IrModule (from ir/ir.sio) into WASM bytecode using the emitters
// from wasm/encode.sio and the module structures from wasm/mod.sio.
//
// Strategy: register-based IR is lowered to WASM's stack machine by mapping
// each IR register to a WASM local variable.  Each IR instruction becomes a
// sequence: push operands via local.get, execute the operation, store result
// via local.set.  Structured control flow (block/loop) is reconstructed from
// the flat IR label/branch model using a label stack.
//
// Capacities:
//   512 locals per function  (IR registers -> WASM locals)
//   256 functions per module (IR functions -> WASM function indices)
//    64 label stack depth    (nested block/loop scope)

module wasm::lower
use wasm::core::*
use wasm::emitter::*
use wasm::encode::*
use ir::ir::*
use parser::ast::{Name, StringList, AstPath, BinaryOp, UnaryOp}

// ============================================================================
// Constants
// ============================================================================

let WASM_LOWER_MAX_LOCALS: i64 = 512
let WASM_LOWER_MAX_FUNCS: i64 = 256
let WASM_LOWER_MAX_LABELS: i64 = 64

// Label kinds for the structured control flow stack
let WASM_LABEL_BLOCK: i64 = 0
let WASM_LABEL_LOOP: i64 = 1

// ============================================================================
// WasmLabelEntry — one entry on the structured control flow label stack
// ============================================================================

struct WasmLabelEntry {
    ir_label_id: i64,
    kind: i64,
}

fn wasm_label_entry_new(ir_label: i64, kind: i64) -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: ir_label, kind: kind }
}

fn wasm_label_entry_empty() -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: 0 - 1, kind: WASM_LABEL_BLOCK }
}

// ============================================================================
// WasmLowerCtx — lowering context for one module
// ============================================================================

struct WasmLowerCtx {
    body: WasmFuncBody,
    local_map: [i64; 512],      // ir_reg → wasm local index (-1 = unmapped)
    local_type: [i64; 512],     // wasm local index → WASM_TYPE_I64 or WASM_TYPE_F64
    loop_labels: [i64; 512],    // loop_labels[label_id] = 1 if backward-jump target
    loop_exit: [i64; 512],      // loop_exit[loop_lid] = exit_lid  (-1 = none found)
    is_loop_exit: [i64; 512],   // is_loop_exit[exit_lid] = loop_lid (-1 = not an exit)
    local_count: i64,
    func_map: [i64; 256],
    func_count: i64,
    label_stack: [WasmLabelEntry; 64],
    label_depth: i64,
    error_count: i64,
    string_offsets: [i64; 512], // string_idx → byte offset in data section (-1 = unmapped)
    heap_start: i64,            // first allocatable address (past string data, 8-aligned)
}

fn wasm_lower_ctx_new() -> WasmLowerCtx {
    var out: WasmLowerCtx
    out.body = wasm_body_new()
    out.local_count = 0
    out.func_count = 0
    out.label_depth = 0
    out.error_count = 0
    out.heap_start = 8
    var i: i64 = 0
    while i < WASM_LOWER_MAX_LOCALS {
        out.local_map[i as usize] = 0 - 1
        out.local_type[i as usize] = WASM_TYPE_I64
        out.loop_labels[i as usize] = 0
        out.loop_exit[i as usize] = 0 - 1
        out.is_loop_exit[i as usize] = 0 - 1
        out.string_offsets[i as usize] = 0 - 1
        i = i + 1
    }
    i = 0
    while i < WASM_LOWER_MAX_FUNCS {
        out.func_map[i as usize] = 0 - 1
        i = i + 1
    }
    out
}

fn wasm_lower_ctx_reset_body(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_new()
    out.local_count = 0
    out.label_depth = 0
    var i: i64 = 0
    while i < WASM_LOWER_MAX_LOCALS {
        out.local_map[i as usize] = 0 - 1
        out.local_type[i as usize] = WASM_TYPE_I64
        out.loop_labels[i as usize] = 0
        out.loop_exit[i as usize] = 0 - 1
        out.is_loop_exit[i as usize] = 0 - 1
        i = i + 1
    }
    out
}

// ============================================================================
// Local variable allocation
//
// Each IR register gets a dedicated WASM local.  Parameters occupy the first
// N locals (matching WASM's calling convention); additional registers are
// appended after.
// ============================================================================

fn wasm_lower_alloc_local(ctx: WasmLowerCtx, ir_reg: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        if out.local_map[ir_reg as usize] < 0 {
            out.local_map[ir_reg as usize] = out.local_count
            out.local_count = out.local_count + 1
        }
    }
    out
}

fn wasm_lower_get_local(ctx: WasmLowerCtx, ir_reg: i64) -> i64 with Mut, Panic {
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        ctx.local_map[ir_reg as usize]
    } else {
        0 - 1
    }
}

// Mark the WASM local that backs ir_reg as f64.
fn wasm_lower_mark_local_f64(ctx: WasmLowerCtx, ir_reg: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        let wasm_idx = out.local_map[ir_reg as usize]
        if wasm_idx >= 0 && wasm_idx < WASM_LOWER_MAX_LOCALS {
            out.local_type[wasm_idx as usize] = WASM_TYPE_F64
        }
    }
    out
}

// Returns true if the WASM local backing ir_reg is typed f64.
fn wasm_lower_is_float_reg(ctx: WasmLowerCtx, ir_reg: i64) -> bool with Mut, Panic {
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        let wasm_idx = ctx.local_map[ir_reg as usize]
        if wasm_idx >= 0 && wasm_idx < WASM_LOWER_MAX_LOCALS {
            return ctx.local_type[wasm_idx as usize] == WASM_TYPE_F64
        }
    }
    false
}

// ============================================================================
// Function table
// ============================================================================

fn wasm_lower_register_func(ctx: WasmLowerCtx, ir_fn_id: i64, wasm_idx: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_fn_id >= 0 && ir_fn_id < WASM_LOWER_MAX_FUNCS {
        out.func_map[ir_fn_id as usize] = wasm_idx
        out.func_count = out.func_count + 1
    }
    out
}

fn wasm_lower_get_func(ctx: WasmLowerCtx, ir_fn_id: i64) -> i64 with Mut, Panic {
    if ir_fn_id >= 0 && ir_fn_id < WASM_LOWER_MAX_FUNCS {
        ctx.func_map[ir_fn_id as usize]
    } else {
        0 - 1
    }
}

// ============================================================================
// Label stack management
//
// IR uses flat labels + branches; WASM requires structured block/loop/end.
// The label stack tracks the nesting so that `br` depth can be computed
// relative to the current position.
// ============================================================================

fn wasm_lower_push_label(ctx: WasmLowerCtx, ir_label: i64, kind: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if out.label_depth < WASM_LOWER_MAX_LABELS {
        out.label_stack[out.label_depth as usize] = wasm_label_entry_new(ir_label, kind)
        out.label_depth = out.label_depth + 1
    }
    out
}

fn wasm_lower_pop_label(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if out.label_depth > 0 {
        out.label_depth = out.label_depth - 1
    }
    out
}

// Find the WASM br depth for an IR label id.
// Scans from top of stack (most recent) outward.
// Returns the 0-based depth, or -1 if not found.
fn wasm_lower_find_label_depth(ctx: WasmLowerCtx, ir_label: i64) -> i64 with Mut, Panic, Div {
    var depth: i64 = 0
    var idx = ctx.label_depth - 1
    while idx >= 0 {
        if ctx.label_stack[idx as usize].ir_label_id == ir_label {
            return depth
        }
        depth = depth + 1
        idx = idx - 1
    }
    0 - 1
}

// ============================================================================
// Loop detection pre-pass
//
// WASM requires `loop` for back-edge targets and `block` for forward labels.
// We scan IrJump/IrBranchTrue/IrBranchFalse instructions; if the target label
// was defined at an earlier instruction index, it is a backward-jump target
// and needs a `loop` opener instead of `block`.
// ============================================================================

fn wasm_lower_detect_loops(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    // Reset all loop detection state
    var j: i64 = 0
    while j < WASM_LOWER_MAX_LOCALS {
        out.loop_labels[j as usize] = 0
        out.loop_exit[j as usize] = 0 - 1
        out.is_loop_exit[j as usize] = 0 - 1
        j = j + 1
    }

    // Pass 1: record the instruction index at which each label is defined.
    var label_pos: [i64; 512] = [0 - 1; 512]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        match instr.op {
            IrOpcode::IrLabel => {
                if instr.label_id >= 0 && instr.label_id < 512 {
                    label_pos[instr.label_id as usize] = i
                }
            }
            _ => {}
        }
        i = i + 1
    }

    // Pass 2: back-edge detection + loop exit label discovery.
    //
    // For each branch that targets a label defined BEFORE the branch (back-edge):
    //   - Mark the target as a loop label.
    //   - Scan the loop body [loop_start+1 .. back_edge-1] for branches that
    //     jump to a label defined AFTER the back-edge — those are loop exits.
    //   - Record the first such exit: loop_exit[loop_lid] = exit_lid,
    //     is_loop_exit[exit_lid] = loop_lid.
    //
    // This allows wasm_lower_label to emit:
    //     block $exit   ← findable by depth from inside the loop
    //       loop $loop
    //         ...
    //         br_if $exit  ← conditional exit (depth=1)
    //         br $loop     ← back-edge (depth=0)
    //       end
    //     end  ← emitted when IrLabel(exit_lid) is encountered
    i = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        let tgt = instr.label_id
        let is_branch = match instr.op {
            IrOpcode::IrJump        => true
            IrOpcode::IrBranchTrue  => true
            IrOpcode::IrBranchFalse => true
            _ => false
        }
        if is_branch && tgt >= 0 && tgt < 512 {
            let lpos = label_pos[tgt as usize]
            if lpos >= 0 && lpos < i {
                // Back-edge found: tgt is a loop label.
                out.loop_labels[tgt as usize] = 1
                // Scan loop body for the first forward exit (if not already found).
                if out.loop_exit[tgt as usize] < 0 {
                    var k: i64 = lpos + 1
                    while k < i {
                        let inner = ir_arena_load(ir_region_slot_r(func.region, (k)))
                        let inner_branch = match inner.op {
                            IrOpcode::IrJump        => true
                            IrOpcode::IrBranchTrue  => true
                            IrOpcode::IrBranchFalse => true
                            _ => false
                        }
                        if inner_branch && inner.label_id >= 0 && inner.label_id < 512 {
                            let exit_pos = label_pos[inner.label_id as usize]
                            if exit_pos > i {
                                // This branch exits the loop (target is after back-edge).
                                out.loop_exit[tgt as usize] = inner.label_id
                                out.is_loop_exit[inner.label_id as usize] = tgt
                                k = i  // break inner loop (no `break` in Sounio)
                            }
                        }
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Pre-scan: allocate WASM locals for all IR registers used in a function
// ============================================================================

fn wasm_lower_prescan_locals(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    // First, allocate params (they become WASM parameters, indices 0..param_count-1)
    var p: i64 = 0
    while p < func.param_count {
        let preg = func.param_regs[p as usize]
        if preg >= 0 && preg < WASM_LOWER_MAX_LOCALS {
            out.local_map[preg as usize] = p
        }
        p = p + 1
    }
    out.local_count = func.param_count

    // Then scan all instructions for dst/src registers and allocate locals.
    // IrLoadFloat dst registers are marked as f64 locals.
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.dst >= 0 {
            out = wasm_lower_alloc_local(out, instr.dst)
        }
        if instr.src1 >= 0 {
            out = wasm_lower_alloc_local(out, instr.src1)
        }
        if instr.src2 >= 0 {
            out = wasm_lower_alloc_local(out, instr.src2)
        }
        // Mark float-producing destinations (forward propagation in def-order)
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 {
                    out = wasm_lower_mark_local_f64(out, instr.dst)
                }
            }
            IrOpcode::IrBinOp => {
                // Arithmetic on f64 operands → f64 result.
                // Comparison ops (Eq/Ne/Lt/Le/Gt/Ge) → i64 boolean; no mark.
                if wasm_lower_is_float_reg(out, instr.src1) && wasm_lower_is_float_reg(out, instr.src2) {
                    match instr.bin_op {
                        BinaryOp::OpAdd => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpSub => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpMul => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpDiv => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        _ => {}
                    }
                }
            }
            IrOpcode::IrCopy => {
                // Propagate f64 type through copies.
                if instr.dst >= 0 && wasm_lower_is_float_reg(out, instr.src1) {
                    out = wasm_lower_mark_local_f64(out, instr.dst)
                }
            }
            IrOpcode::IrUnaryOp => {
                // OpNeg on a f64 operand produces a f64 result.
                match instr.un_op {
                    UnaryOp::OpNeg => {
                        if instr.dst >= 0 && wasm_lower_is_float_reg(out, instr.src1) {
                            out = wasm_lower_mark_local_f64(out, instr.dst)
                        }
                    }
                    _ => {}
                }
            }
            IrOpcode::IrPhi => {
                // Allocate locals for phi incoming values (in call_args list).
                // The dst register is already allocated above; here we ensure
                // incoming value registers are allocated too.
                match instr.call_args {
                    Some(list) => {
                        let reg = (*list).head
                        if reg >= 0 {
                            out = wasm_lower_alloc_local(out, reg)
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Individual instruction lowering
// ============================================================================

// IrLoadImm -> i64.const val; local.set dst
fn wasm_lower_load_imm(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    out.body = wasm_body_emit_i64_const(out.body, instr.imm_i64)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrLoadFloat -> i64.const <bits>; f64.reinterpret_i64; local.set dst
// The local is declared as f64 (marked in prescan). The value is pushed
// as i64 bits then reinterpreted, so no raw 8-byte f64.const encoding needed.
fn wasm_lower_load_float(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    // f64_to_bits: compiler builtin — IEEE 754 bit reinterpret, no numeric conversion
    let bits = f64_to_bits(instr.imm_f64)
    out.body = wasm_body_emit_i64_const(out.body, bits)
    out.body = wasm_body_emit_f64_reinterpret_i64(out.body)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrLoadBool -> i64.const 0/1; local.set dst
fn wasm_lower_load_bool(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let val = instr.imm_i64  // already 0 or 1 from ir_load_bool
    out.body = wasm_body_emit_i64_const(out.body, val)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrCopy -> local.get src1; local.set dst
fn wasm_lower_copy(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let src_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)
    if src_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, src_local)
    }
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrBinOp -> local.get lhs; local.get rhs; <op>; local.set dst
fn wasm_lower_binop(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let lhs_local = wasm_lower_get_local(out, instr.src1)
    let rhs_local = wasm_lower_get_local(out, instr.src2)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    // Push operands
    if lhs_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, lhs_local)
    }
    if rhs_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, rhs_local)
    }

    // Dispatch to f64 or i64 operations based on operand type.
    if wasm_lower_is_float_reg(out, instr.src1) {
        // ── f64 path ──────────────────────────────────────────────────────────
        // Arithmetic ops produce f64; comparison ops return i32 (extended to i64).
        match instr.bin_op {
            BinaryOp::OpAdd => { out.body = wasm_body_emit_f64_add(out.body) }
            BinaryOp::OpSub => { out.body = wasm_body_emit_f64_sub(out.body) }
            BinaryOp::OpMul => { out.body = wasm_body_emit_f64_mul(out.body) }
            BinaryOp::OpDiv => { out.body = wasm_body_emit_f64_div(out.body) }
            BinaryOp::OpEq => {
                out.body = wasm_body_emit_f64_eq(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpNe => {
                out.body = wasm_body_emit_f64_ne(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLt => {
                out.body = wasm_body_emit_f64_lt(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLe => {
                out.body = wasm_body_emit_f64_le(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGt => {
                out.body = wasm_body_emit_f64_gt(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGe => {
                out.body = wasm_body_emit_f64_ge(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            _ => {
                // Bitwise / shift ops on f64 are undefined; trap.
                out.body = wasm_body_emit_unreachable(out.body)
            }
        }
    } else {
        // ── i64 path ──────────────────────────────────────────────────────────
        match instr.bin_op {
            BinaryOp::OpAdd => { out.body = wasm_body_emit_i64_add(out.body) }
            BinaryOp::OpSub => { out.body = wasm_body_emit_i64_sub(out.body) }
            BinaryOp::OpMul => { out.body = wasm_body_emit_i64_mul(out.body) }
            BinaryOp::OpDiv => { out.body = wasm_body_emit_i64_div_s(out.body) }
            BinaryOp::OpRem => { out.body = wasm_body_emit_i64_rem_s(out.body) }
            BinaryOp::OpEq => {
                out.body = wasm_body_emit_i64_eq(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpNe => {
                out.body = wasm_body_emit_i64_ne(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLt => {
                out.body = wasm_body_emit_i64_lt_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLe => {
                out.body = wasm_body_emit_i64_le_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGt => {
                out.body = wasm_body_emit_i64_gt_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGe => {
                out.body = wasm_body_emit_i64_ge_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpBitAnd => { out.body = wasm_body_emit_i64_and(out.body) }
            BinaryOp::OpBitOr => { out.body = wasm_body_emit_i64_or(out.body) }
            BinaryOp::OpBitXor => { out.body = wasm_body_emit_i64_xor(out.body) }
            BinaryOp::OpShl => { out.body = wasm_body_emit_i64_shl(out.body) }
            BinaryOp::OpShr => { out.body = wasm_body_emit_i64_shr_s(out.body) }
            BinaryOp::OpAnd => { out.body = wasm_body_emit_i64_and(out.body) }
            BinaryOp::OpOr  => { out.body = wasm_body_emit_i64_or(out.body) }
            _ => {
                // OpConcat, OpRange, OpRangeInclusive: not lowered to WASM
                out.body = wasm_body_emit_unreachable(out.body)
            }
        }
    }

    // Store result
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrUnaryOp -> local.get src; <op>; local.set dst
fn wasm_lower_unaryop(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let src_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    if src_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, src_local)
    }

    if wasm_lower_is_float_reg(out, instr.src1) {
        // ── f64 unary path ────────────────────────────────────────────────────
        match instr.un_op {
            UnaryOp::OpNeg => {
                // f64.neg (0x9A): flip the sign bit — correct IEEE 754 negation.
                // The i64.const(-1)*i64.mul trick is wrong for f64 locals.
                out.body = wasm_body_emit_f64_neg(out.body)
            }
            _ => {
                // OpNot on f64 is undefined; OpRef/Deref don't apply.
            }
        }
    } else {
        // ── i64 unary path ────────────────────────────────────────────────────
        match instr.un_op {
            UnaryOp::OpNeg => {
                // Negate: val is on stack.  Multiply by -1.
                out.body = wasm_body_emit_i64_const(out.body, 0 - 1)
                out.body = wasm_body_emit_i64_mul(out.body)
            }
            UnaryOp::OpNot => {
                // Logical NOT: i64.eqz → i32; extend back to i64.
                out.body = wasm_body_emit_i64_eqz(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            _ => {
                // OpRef, OpRefMut, OpDeref: not representable in flat WASM lowering.
                // Pass through — value is already on the stack.
            }
        }
    }

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// Push all call arguments from IrRegList onto the WASM stack.
// Box dereference (*list) does not require Alloc effect — only reads existing heap.
fn wasm_lower_push_args(ctx: WasmLowerCtx, args: Option<Box<IrRegList>>) -> WasmLowerCtx with Mut, Panic, Div {
    match args {
        Some(list) => {
            let reg = (*list).head
            var out = ctx
            if reg >= 0 {
                let local_idx = wasm_lower_get_local(out, reg)
                if local_idx >= 0 {
                    out.body = wasm_body_emit_local_get(out.body, local_idx)
                }
            }
            wasm_lower_push_args(out, (*list).tail)
        }
        _ => ctx
    }
}

// IrCall -> push all args from call_args list; call func_idx; local.set dst
fn wasm_lower_call(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let wasm_func_idx = wasm_lower_get_func(out, instr.fn_id)

    // Push all args via the full call_args list (supports >2 args)
    out = wasm_lower_push_args(out, instr.call_args)

    // Emit call
    if wasm_func_idx >= 0 {
        out.body = wasm_body_emit_call(out.body, wasm_func_idx)
    } else {
        // Unknown function: emit unreachable
        out.body = wasm_body_emit_unreachable(out.body)
    }

    // Store result
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrReturn -> local.get src1; return
fn wasm_lower_return(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    if instr.src1 >= 0 {
        let src_local = wasm_lower_get_local(out, instr.src1)
        if src_local >= 0 {
            out.body = wasm_body_emit_local_get(out.body, src_local)
        }
    }
    out.body = wasm_body_emit_return(out.body)
    out
}

// IrJump -> br <label_depth>
fn wasm_lower_jump(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br(out.body, depth)
    } else {
        // Label not found on stack; emit unreachable as fallback
        out.body = wasm_body_emit_unreachable(out.body)
    }
    out
}

// IrBranchTrue -> local.get cond; br_if <label_depth>
fn wasm_lower_branch_true(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let cond_local = wasm_lower_get_local(out, instr.src1)
    if cond_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, cond_local)
        // Truncate i64 to i32 for br_if condition (WASM expects i32)
        out.body = wasm_body_emit_i32_wrap_i64(out.body)
    }
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br_if(out.body, depth)
    }
    out
}

// IrBranchFalse -> local.get cond; i64.eqz; i32.wrap_i64 already done by eqz...
//                  Actually: local.get cond; i32.wrap_i64; i32.eqz; br_if depth
fn wasm_lower_branch_false(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let cond_local = wasm_lower_get_local(out, instr.src1)
    if cond_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, cond_local)
        // i64.eqz produces i32 (1 if zero, 0 otherwise) -- inverts the condition
        out.body = wasm_body_emit_i64_eqz(out.body)
    }
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br_if(out.body, depth)
    }
    out
}

// IrLabel -> open a `loop` if the label is a backward-jump target (detected by
// IrLabel lowering — three cases:
//
//  (A) Loop exit label: is_loop_exit[lid] >= 0
//      The loop + its wrapper block were both pre-pushed onto the stack when the
//      loop header was seen.  Close all scopes up to and including the loop
//      itself, then close the exit wrapper block.  Do NOT open a new scope.
//
//  (B) Loop header: loop_labels[lid] == 1
//      Emit an outer `block` keyed to the exit label so that forward branches
//      out of the loop (br_if depth=1) can escape.  Then emit the `loop`
//      itself.  Stack depth after: [..., block-exit, loop-lid].
//
//  (C) Forward label (if/else exit, break target): plain `block`.
//
// Depth semantics inside a loop body:
//   br 0  → back to top of loop  (depth 0 = loop-lid)
//   br 1  → exit the loop        (depth 1 = block-exit wrapper)
fn wasm_lower_label(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let lid = instr.label_id
    if lid >= 0 && lid < 512 {
        let loop_owner = out.is_loop_exit[lid as usize]
        if loop_owner >= 0 {
            // ── Case A: this label is the exit point of a loop ────────────────
            // Close all open scopes up to and including the loop-owner scope,
            // then close the exit wrapper block that was pre-opened below it.
            var done = false
            while out.label_depth > 0 && !done {
                let top_id = out.label_stack[(out.label_depth - 1) as usize].ir_label_id
                out.body = wasm_body_emit_end(out.body)
                out = wasm_lower_pop_label(out)
                if top_id == loop_owner {
                    done = true
                }
            }
            // Close the exit wrapper block (should be directly below the loop).
            if out.label_depth > 0 {
                let wrapper_id = out.label_stack[(out.label_depth - 1) as usize].ir_label_id
                if wrapper_id == lid {
                    out.body = wasm_body_emit_end(out.body)
                    out = wasm_lower_pop_label(out)
                }
            }
            // Fall-through continues after the loop; no new scope opened.

        } else if out.loop_labels[lid as usize] == 1 {
            // ── Case B: loop header ───────────────────────────────────────────
            let exit_lid = out.loop_exit[lid as usize]
            if exit_lid >= 0 {
                // Pre-open an outer block for the exit label so branch_false
                // inside the loop can target it via depth=1.
                out.body = wasm_body_emit_block(out.body, WASM_BLOCK_VOID)
                out = wasm_lower_push_label(out, exit_lid, WASM_LABEL_BLOCK)
            }
            out.body = wasm_body_emit_loop(out.body, WASM_BLOCK_VOID)
            out = wasm_lower_push_label(out, lid, WASM_LABEL_LOOP)

        } else {
            // ── Case C: forward label ─────────────────────────────────────────
            out.body = wasm_body_emit_block(out.body, WASM_BLOCK_VOID)
            out = wasm_lower_push_label(out, lid, WASM_LABEL_BLOCK)
        }
    }
    out
}

// Close the current block/loop scope
fn wasm_lower_end_block(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_emit_end(out.body)
    out = wasm_lower_pop_label(out)
    out
}

// IrFieldGet -> lower as i64.load from (base_ptr + field_idx * 8)
// In this simplified lowering, struct fields are 8-byte slots in linear memory
fn wasm_lower_field_get(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let offset = instr.field_idx * 8

    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    // WASM memory ops take i32 addresses: truncate the i64 pointer.
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    // i64.load with alignment 3 (2^3 = 8 byte aligned), offset = field_idx * 8
    out.body = wasm_body_emit_i64_load(out.body, 3, offset)

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrFieldSet -> i64.store to (base_ptr + field_idx * 8)
fn wasm_lower_field_set(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let val_local = wasm_lower_get_local(out, instr.src2)
    let offset = instr.field_idx * 8

    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    // WASM store expects i32 address below the value on the stack.
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    if val_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, val_local)
    }
    out.body = wasm_body_emit_i64_store(out.body, 3, offset)
    out
}

// IrIndexGet -> i64.load from (base + idx * 8)
fn wasm_lower_index_get(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let idx_local = wasm_lower_get_local(out, instr.src2)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    // Compute address: base + idx * 8
    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    if idx_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, idx_local)
        out.body = wasm_body_emit_i64_const(out.body, 8)
        out.body = wasm_body_emit_i64_mul(out.body)
        out.body = wasm_body_emit_i64_add(out.body)
    }

    // Wrap to i32 address for WASM memory ops
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    out.body = wasm_body_emit_i64_load(out.body, 3, 0)

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrIndexSet -> i64.store to (base + idx * 8)
fn wasm_lower_index_set(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let idx_local = wasm_lower_get_local(out, instr.src2)
    // For IrIndexSet, src_reg is stored in imm_i64 (see ir.sio: ir_index_set)
    let val_local = wasm_lower_get_local(out, instr.imm_i64)

    // Compute address: base + idx * 8
    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    if idx_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, idx_local)
        out.body = wasm_body_emit_i64_const(out.body, 8)
        out.body = wasm_body_emit_i64_mul(out.body)
        out.body = wasm_body_emit_i64_add(out.body)
    }
    out.body = wasm_body_emit_i32_wrap_i64(out.body)

    // Push value
    if val_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, val_local)
    }
    out.body = wasm_body_emit_i64_store(out.body, 3, 0)
    out
}

// IrNop -> nop (no-op)
fn wasm_lower_nop(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_emit_nop(out.body)
    out
}

// IrPhi -> copy from the first incoming value register (call_args head).
//
// In a well-formed pipeline, SSA phi nodes are eliminated by the SSA-destruction
// pass before reaching this lowerer.  If a phi survives, lower it conservatively
// as a copy from the first incoming value.  Subsequent parallel-copy insertion
// would be needed for full correctness; this is a safe fallback.
fn wasm_lower_phi(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    match instr.call_args {
        Some(list) => {
            let reg = (*list).head
            if reg >= 0 {
                let src_local = wasm_lower_get_local(out, reg)
                if src_local >= 0 && dst_local >= 0 {
                    out.body = wasm_body_emit_local_get(out.body, src_local)
                    out.body = wasm_body_emit_local_set(out.body, dst_local)
                }
            }
        }
        _ => {}
    }
    out
}

// ============================================================================
// Instruction dispatch
// ============================================================================

fn wasm_lower_instruction(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    match instr.op {
        IrOpcode::IrLoadImm => wasm_lower_load_imm(ctx, instr),
        IrOpcode::IrLoadFloat => wasm_lower_load_float(ctx, instr),
        IrOpcode::IrLoadBool => wasm_lower_load_bool(ctx, instr),
        IrOpcode::IrCopy => wasm_lower_copy(ctx, instr),
        IrOpcode::IrContest => wasm_lower_copy(ctx, instr),
        IrOpcode::IrProveRobust => wasm_lower_copy(ctx, instr),
        IrOpcode::IrValidated => wasm_lower_copy(ctx, instr),
        IrOpcode::IrAdmitAction => wasm_lower_copy(ctx, instr),
        IrOpcode::IrDeferAction => wasm_lower_copy(ctx, instr),
        IrOpcode::IrPlanAcquisition => wasm_lower_copy(ctx, instr),
        IrOpcode::IrPlanRecourse => wasm_lower_copy(ctx, instr),
        IrOpcode::IrProposeAlternatives => wasm_lower_copy(ctx, instr),
        IrOpcode::IrCommitAlternative => wasm_lower_copy(ctx, instr),
        IrOpcode::IrLiftKnowledge => wasm_lower_copy(ctx, instr),
        IrOpcode::IrMeasure => wasm_lower_copy(ctx, instr),
        IrOpcode::IrDebugGuard => wasm_lower_nop(ctx),
        IrOpcode::IrBinOp => wasm_lower_binop(ctx, instr),
        IrOpcode::IrUnaryOp => wasm_lower_unaryop(ctx, instr),
        IrOpcode::IrCall => wasm_lower_call(ctx, instr),
        IrOpcode::IrReturn => wasm_lower_return(ctx, instr),
        IrOpcode::IrJump => wasm_lower_jump(ctx, instr),
        IrOpcode::IrBranchTrue => wasm_lower_branch_true(ctx, instr),
        IrOpcode::IrBranchFalse => wasm_lower_branch_false(ctx, instr),
        IrOpcode::IrLabel => wasm_lower_label(ctx, instr),
        IrOpcode::IrFieldGet => wasm_lower_field_get(ctx, instr),
        IrOpcode::IrFieldSet => wasm_lower_field_set(ctx, instr),
        IrOpcode::IrIndexGet => wasm_lower_index_get(ctx, instr),
        IrOpcode::IrIndexSet => wasm_lower_index_set(ctx, instr),
        IrOpcode::IrNop => wasm_lower_nop(ctx),
        IrOpcode::IrPhi => wasm_lower_phi(ctx, instr),
        IrOpcode::IrLoadString => wasm_lower_load_string(ctx, instr),
        IrOpcode::IrAlloc => wasm_lower_alloc(ctx, instr),
        _ => {
            wasm_lower_nop(ctx)
        }
    }
}

// ============================================================================
// Return-type inference: scan IrReturn to determine WASM result type.
// Returns WASM_TYPE_I64 or WASM_TYPE_F64 if function returns a value,
// or -1 (void) if no IrReturn with a live src, or no IrReturn at all.
// Standalone (no ctx): does a two-pass scan of the IR function.
// ============================================================================

fn wasm_lower_return_type(func: IrFunction) -> i64 with Mut, Panic, Div {
    // Pass 1: collect registers produced by IrLoadFloat (these are f64)
    var float_regs: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 && instr.dst < 512 {
                    float_regs[instr.dst as usize] = 1
                }
            }
            _ => {}
        }
        i = i + 1
    }
    // Pass 2: find IrReturn and determine type of returned value
    i = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        match instr.op {
            IrOpcode::IrReturn => {
                if instr.src1 >= 0 {
                    if instr.src1 < 512 && float_regs[instr.src1 as usize] == 1 {
                        return WASM_TYPE_F64
                    }
                    return WASM_TYPE_I64
                }
                return 0 - 1  // IrReturn with no src → void
            }
            _ => {}
        }
        i = i + 1
    }
    0 - 1  // no IrReturn found → void
}

// ============================================================================
// f64 param type inference
// ============================================================================
// Infers which of a function's param registers are f64 by:
//   Step 1: seed float_regs from all IrLoadFloat destinations.
//   Step 2: propagate forward (if any BinOp input is f64, output is f64)
//           and backward (if BinOp output is f64, both inputs are f64) — 3 passes.
//   Step 3: check each param_reg against float_regs; emit WASM_TYPE_F64 or I64.
// Returns a [i64; 32] of WASM type codes, one per param.
fn wasm_lower_infer_param_types(func: IrFunction) -> [i64; 32] with Mut, Panic, Div {
    var result: [i64; 32] = [126; 32]  // 0x7e = WASM_TYPE_I64 = 126 (default all i64)

    // Step 1: seed — mark regs written by IrLoadFloat as f64
    var float_regs: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < func.instr_count && i < 4096 {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 && instr.dst < 512 {
                    float_regs[instr.dst as usize] = 1
                }
            }
            _ => {}
        }
        i = i + 1
    }

    // Step 2: propagate — 3 passes over the instruction stream handles most
    // programs without needing full fixed-point iteration.
    var pass: i64 = 0
    while pass < 3 {
        i = 0
        while i < func.instr_count && i < 4096 {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
            match instr.op {
                IrOpcode::IrBinOp => {
                    let s1f = instr.src1 >= 0 && instr.src1 < 512
                              && float_regs[instr.src1 as usize] == 1
                    let s2f = instr.src2 >= 0 && instr.src2 < 512
                              && float_regs[instr.src2 as usize] == 1
                    let df  = instr.dst  >= 0 && instr.dst  < 512
                              && float_regs[instr.dst  as usize] == 1
                    // Forward: float input → float output
                    if (s1f || s2f) && instr.dst >= 0 && instr.dst < 512 {
                        float_regs[instr.dst as usize] = 1
                    }
                    // Backward: float output → float inputs
                    if df {
                        if instr.src1 >= 0 && instr.src1 < 512 {
                            float_regs[instr.src1 as usize] = 1
                        }
                        if instr.src2 >= 0 && instr.src2 < 512 {
                            float_regs[instr.src2 as usize] = 1
                        }
                    }
                }
                IrOpcode::IrCopy => {
                    let s1f = instr.src1 >= 0 && instr.src1 < 512
                              && float_regs[instr.src1 as usize] == 1
                    let df  = instr.dst  >= 0 && instr.dst  < 512
                              && float_regs[instr.dst  as usize] == 1
                    if s1f && instr.dst >= 0 && instr.dst < 512 {
                        float_regs[instr.dst as usize] = 1
                    }
                    if df && instr.src1 >= 0 && instr.src1 < 512 {
                        float_regs[instr.src1 as usize] = 1
                    }
                }
                _ => {}
            }
            i = i + 1
        }
        pass = pass + 1
    }

    // Step 3: assign param types
    var p: i64 = 0
    while p < func.param_count && p < 32 {
        let preg = func.param_regs[p as usize]
        if preg >= 0 && preg < 512 && float_regs[preg as usize] == 1 {
            result[p as usize] = 125  // 0x7d = WASM_TYPE_F64
        }
        p = p + 1
    }

    result
}

// ============================================================================
// IrLoadString — load string literal address
//
// IrLoadString: dst = &string_table[imm_i64]
// Strategy: the string bytes are placed in the WASM data section at a known
// offset (stored in ctx.string_offsets[string_idx]). We emit:
//   i32.const <offset>       → i32 pointer to the string's first byte
//   i64.extend_i32_u         → promote to i64 (IR convention)
//   local.set dst
// If string_idx is unknown (not found in string_offsets), emit i64.const 0.
// ============================================================================

fn wasm_lower_load_string(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let sidx = instr.imm_i64
    var offset: i64 = 0
    if sidx >= 0 && sidx < 512 {
        let stored = out.string_offsets[sidx as usize]
        if stored >= 0 { offset = stored }
    }
    out.body = wasm_body_emit_i32_const(out.body, offset)
    out.body = wasm_body_emit_i64_extend_i32_u(out.body)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// ============================================================================
// IrAlloc — heap bump allocator
//
// IrAlloc: dst = alloc(type_id)
// Strategy: global 0 is the heap bump pointer (i64).
//   1. global.get 0              → current heap ptr (i64)
//   2. local.set dst             → save as result (allocated address)
//   3. global.get 0
//   4. i64.const ALLOC_SIZE      → 64 bytes (conservative fixed size)
//   5. i64.add
//   6. global.set 0              → update heap ptr
// ============================================================================

let WASM_ALLOC_SIZE: i64 = 64   // default allocation size (8 i64 fields)
let WASM_HEAP_GLOBAL: i64 = 0   // index of the heap bump pointer global

fn wasm_lower_alloc(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    // Grab current heap pointer as the allocation result
    out.body = wasm_body_emit_global_get(out.body, WASM_HEAP_GLOBAL)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    // Bump the heap pointer by WASM_ALLOC_SIZE
    out.body = wasm_body_emit_global_get(out.body, WASM_HEAP_GLOBAL)
    out.body = wasm_body_emit_i64_const(out.body, WASM_ALLOC_SIZE)
    out.body = wasm_body_emit_i64_add(out.body)
    out.body = wasm_body_emit_global_set(out.body, WASM_HEAP_GLOBAL)
    out
}

// ============================================================================
// Basic block lowering: lower all instructions sequentially
// ============================================================================

fn wasm_lower_basic_block(ctx: WasmLowerCtx, func: IrFunction, start: i64, end_idx: i64) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    var i = start
    while i < end_idx && i < func.instr_count {
        out = wasm_lower_instruction(out, ir_arena_load(ir_region_slot_r(func.region, (i))))
        i = i + 1
    }
    out
}

// ============================================================================
// Function lowering
//
// For each IrFunction:
//   1. Reset body and allocate locals
//   2. Declare non-parameter locals as i64
//   3. Lower all instructions
//   4. Append implicit `end` opcode
//   5. Return the WasmFuncBody
// ============================================================================

fn wasm_lower_function(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = wasm_lower_ctx_reset_body(ctx)

    // Detect loop targets (back-edge labels) before main lowering.
    out = wasm_lower_detect_loops(out, func)

    // Pre-scan to allocate WASM locals for all IR registers
    out = wasm_lower_prescan_locals(out, func)

    // Declare extra locals (beyond parameters) one-by-one by type.
    // This correctly handles mixed i64/f64 extra locals.
    var e: i64 = func.param_count
    while e < out.local_count {
        let ltype = out.local_type[e as usize]
        out.body = wasm_body_add_local(out.body, 1, ltype)
        e = e + 1
    }

    // Lower all instructions
    out = wasm_lower_basic_block(out, func, 0, func.instr_count)

    // Close any remaining open label scopes
    while out.label_depth > 0 {
        out = wasm_lower_end_block(out)
    }

    // Append implicit function end
    out.body = wasm_body_emit_end(out.body)

    out
}

// ============================================================================
// Export helper
//
// Build a WasmExport from an IrFunction Name struct without going through a
// Sounio `string` (which requires a runtime allocation).  Copies the raw bytes
// from Name.buf directly into WasmExport.name_buf.
// ============================================================================

fn wasm_lower_export_from_name(name: Name, func_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    var i: i64 = 0
    while i < name.len && i < 128 {
        exp.name_buf[i as usize] = name.buf[i as usize]
        i = i + 1
    }
    exp.name_len = name.len
    exp.kind = WASM_EXPORT_FUNC
    exp.index = func_idx
    exp
}

// ============================================================================
// Builtin function detection
//
// Builtin functions are those with instr_count == 0 whose name matches one of
// the known host-provided functions (print, print_int, str_len, etc.).
// They are emitted as WASM imports (module="env") rather than local functions.
// ============================================================================

// Check if a Name is the builtin "print" (5 bytes: p-r-i-n-t)
fn wasm_lower_name_is_print(name: Name) -> bool with Mut, Panic {
    name.len == 5
        && (name.buf[0 as usize] as i64) == 112  // p
        && (name.buf[1 as usize] as i64) == 114  // r
        && (name.buf[2 as usize] as i64) == 105  // i
        && (name.buf[3 as usize] as i64) == 110  // n
        && (name.buf[4 as usize] as i64) == 116  // t
}

// Check if a Name begins with "print_" (the prefix shared by print_int, print_char)
fn wasm_lower_name_starts_print_under(name: Name) -> bool with Mut, Panic {
    name.len >= 6
        && (name.buf[0 as usize] as i64) == 112  // p
        && (name.buf[1 as usize] as i64) == 114  // r
        && (name.buf[2 as usize] as i64) == 105  // i
        && (name.buf[3 as usize] as i64) == 110  // n
        && (name.buf[4 as usize] as i64) == 116  // t
        && (name.buf[5 as usize] as i64) == 95   // _
}

// Check if a Name begins with "str_" (str_len, str_eq, str_char_at, etc.)
fn wasm_lower_name_starts_str_under(name: Name) -> bool with Mut, Panic {
    name.len >= 4
        && (name.buf[0 as usize] as i64) == 115  // s
        && (name.buf[1 as usize] as i64) == 116  // t
        && (name.buf[2 as usize] as i64) == 114  // r
        && (name.buf[3 as usize] as i64) == 95   // _
}

// Check if a Name begins with "get_arg" (get_arg, get_arg_count)
fn wasm_lower_name_starts_get_arg(name: Name) -> bool with Mut, Panic {
    name.len >= 7
        && (name.buf[0 as usize] as i64) == 103  // g
        && (name.buf[1 as usize] as i64) == 101  // e
        && (name.buf[2 as usize] as i64) == 116  // t
        && (name.buf[3 as usize] as i64) == 95   // _
        && (name.buf[4 as usize] as i64) == 97   // a
        && (name.buf[5 as usize] as i64) == 114  // r
        && (name.buf[6 as usize] as i64) == 103  // g
}

// Returns true if the function name is a known host builtin.
fn wasm_lower_is_builtin_name(name: Name) -> bool with Mut, Panic {
    if wasm_lower_name_is_print(name) { return true }
    if wasm_lower_name_starts_print_under(name) { return true }
    if wasm_lower_name_starts_str_under(name) { return true }
    if wasm_lower_name_starts_get_arg(name) { return true }
    false
}

// Returns true if this IR function is a host builtin (no body, known builtin name).
fn wasm_lower_is_builtin(func: IrFunction) -> bool with Mut, Panic {
    func.instr_count == 0 && wasm_lower_is_builtin_name(func.name)
}

// Returns the WASM param count for a known builtin.
// print / print_int / print_char → 1 param (the string/value as i64)
// str_len → 1 param (string pointer)
// All others → 2 params (two i64 args)
fn wasm_lower_builtin_param_count(name: Name) -> i64 with Mut, Panic {
    if wasm_lower_name_is_print(name) { return 1 }        // print
    if wasm_lower_name_starts_print_under(name) { return 1 }  // print_int, print_char
    if name.len == 7 { return 1 }                          // str_len (len=7: s-t-r-_-l-e-n)
    2  // str_eq, str_char_at, str_concat, str_slice, get_arg, etc.
}

// Returns true if the builtin returns i64 (false → void return).
// print / print_int / print_char return void; str_* and get_* return i64.
fn wasm_lower_builtin_returns_i64(name: Name) -> bool with Mut, Panic {
    if wasm_lower_name_is_print(name) { return false }
    if wasm_lower_name_starts_print_under(name) { return false }
    true
}

// Build a WasmImport for a builtin function.
// module = "env" (101 110 118), name = func.name bytes.
fn wasm_lower_make_builtin_import(func_name: Name, type_idx: i64) -> WasmImport with Mut, Panic, Div {
    var imp = wasm_import_new()
    // module = "env"
    imp.module_buf[0 as usize] = 101 as i8  // e
    imp.module_buf[1 as usize] = 110 as i8  // n
    imp.module_buf[2 as usize] = 118 as i8  // v
    imp.module_len = 3
    // function name
    var i: i64 = 0
    while i < func_name.len && i < 32 {
        imp.name_buf[i as usize] = func_name.buf[i as usize]
        i = i + 1
    }
    imp.name_len = func_name.len
    imp.type_index = type_idx
    imp
}

// ============================================================================
// Module lowering
//
// Translates an entire IrModule into WASM sections:
//   - Type section:     types for all functions (imports + locals)
//   - Import section:   host builtins (print, print_int, str_*, ...)
//   - Function section: local functions only (indices offset by import count)
//   - Code section:     lowered bodies for local functions only
//   - Export section:   local functions by IR name + "memory"
//   - Memory section:   1 page minimum for heap
// ============================================================================

struct WasmLowerResult {
    buf: WasmBuf,
    func_count: i64,
    error_count: i64,
}

fn wasm_lower_result_new() -> WasmLowerResult {
    WasmLowerResult {
        buf: wasm_buf_new(),
        func_count: 0,
        error_count: 0,
    }
}

fn wasm_lower_module(module: IrModule) -> WasmLowerResult with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    var types = wasm_type_section_new()
    var imports = wasm_import_section_new()
    var funcs = wasm_func_section_new()
    var code = wasm_code_section_new()
    var exports = wasm_export_section_new()

    // ── Pass 0: count imports so we can compute WASM function index offsets ──
    var n_imports: i64 = 0
    var si: i64 = 0
    while si < module.fn_count && si < WASM_LOWER_MAX_FUNCS {
        if wasm_lower_is_builtin(module.functions[si as usize]) {
            n_imports = n_imports + 1
        }
        si = si + 1
    }

    // ── Pass 1: register all IR function IDs → WASM function indices ─────────
    // Builtins get indices 0..n_imports-1 (they are imported).
    // Local functions get indices n_imports..n_imports+n_local-1.
    var import_idx: i64 = 0
    var local_idx: i64 = n_imports
    var fi: i64 = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        if wasm_lower_is_builtin(func) {
            ctx = wasm_lower_register_func(ctx, fi, import_idx)
            import_idx = import_idx + 1
        } else {
            ctx = wasm_lower_register_func(ctx, fi, local_idx)
            local_idx = local_idx + 1
        }
        fi = fi + 1
    }

    // ── Pass 2: build type section + import/function sections ─────────────────
    // All functions (builtins and locals) get a type entry.
    // The type_index for each function is its position in the type section.
    // Builtins' type entries come first (in IR order), then locals.
    // We track type indices in a temporary array.
    var type_indices: [i64; 256] = [0; 256]
    var type_idx: i64 = 0

    fi = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        var ft = wasm_func_type_new()

        if wasm_lower_is_builtin(func) {
            // Builtin: use hardcoded param count and return type.
            let n_params = wasm_lower_builtin_param_count(func.name)
            var p: i64 = 0
            while p < n_params {
                ft = wasm_func_type_add_param(ft, WASM_TYPE_I64)
                p = p + 1
            }
            if wasm_lower_builtin_returns_i64(func.name) {
                ft = wasm_func_type_add_result(ft, WASM_TYPE_I64)
            }
        } else {
            // Local function: infer param types (i64 vs f64) + return type.
            let param_types = wasm_lower_infer_param_types(func)
            var p: i64 = 0
            while p < func.param_count {
                ft = wasm_func_type_add_param(ft, param_types[p as usize])
                p = p + 1
            }
            let ret_type = wasm_lower_return_type(func)
            if ret_type >= 0 {
                ft = wasm_func_type_add_result(ft, ret_type)
            }
        }

        if fi < 256 { type_indices[fi as usize] = type_idx }
        types = wasm_type_section_add(types, ft)
        type_idx = type_idx + 1
        fi = fi + 1
    }

    // ── Pass 3: populate import section, function section, code section ───────
    fi = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        let tidx = if fi < 256 { type_indices[fi as usize] } else { 0 }
        let wasm_idx = wasm_lower_get_func(ctx, fi)

        if wasm_lower_is_builtin(func) {
            // Emit WASM import entry for this builtin.
            let imp = wasm_lower_make_builtin_import(func.name, tidx)
            imports = wasm_import_section_add(imports, imp)
        } else {
            // Emit function section entry (type index for this local function).
            funcs = wasm_func_section_add(funcs, tidx)

            // Export local function by its IR name.
            let exp = wasm_lower_export_from_name(func.name, wasm_idx)
            exports = wasm_export_section_add(exports, exp)

            // Lower the function body.
            ctx = wasm_lower_function(ctx, func)
            code = wasm_code_section_add(code, ctx.body)
        }
        fi = fi + 1
    }

    // Also export the linear memory (conventional for WASM modules)
    exports = wasm_export_section_add(exports, wasm_export_memory("memory", 0))

    // ── Pass 4: build data section + global section from string_table ─────────
    // Each string in the IR module becomes one data segment (null-terminated).
    // We populate ctx.string_offsets[si] so IrLoadString knows the right offset.
    // heap_start is placed just past the string data, aligned to 8 bytes.
    var data = wasm_data_section_new()
    var di: i64 = 0
    while di < module.string_count && di < 512 {
        let sname = module.string_table[di as usize]
        let seg_offset = data.data_len
        data = wasm_data_section_add_name(data, sname)
        ctx.string_offsets[di as usize] = seg_offset
        di = di + 1
    }
    // Align heap_start to 8 bytes, minimum 8 (avoid null pointer at address 0)
    let raw_heap = data.data_len
    let aligned = (raw_heap + 7) / 8 * 8
    let heap = if aligned < 8 { 8 } else { aligned }
    ctx.heap_start = heap

    // Global section: mutable i64 global 0 = heap_start (bump allocator pointer)
    var globals = wasm_global_section_new()
    globals = wasm_global_section_add(globals, heap)

    // Emit the full WASM module
    let buf = wasm_emit_full_module(types, imports, funcs, globals, 1, 0, exports, code, data)

    WasmLowerResult {
        buf: buf,
        func_count: module.fn_count,
        error_count: ctx.error_count,
    }
}

// ============================================================================
// Helper: build a simple IR function for testing
// ============================================================================

fn wasm_lower_test_make_add_func() -> IrFunction with Mut, Panic, Div {
    // fn add(a, b) -> a + b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    // r2 = r0 + r1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    // return r2
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(2))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_const_func() -> IrFunction with Mut, Panic, Div {
    // fn const42() -> 42
    var func = ir_empty_function()
    func.param_count = 0
    func.reg_count = 1

    // r0 = 42
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 42))
    // return r0
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_branch_func() -> IrFunction with Mut, Panic, Div {
    // fn branch_test(cond) -> cond ? 1 : 0
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // label 0 (block start)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_label(0))
    // branch_true r0, label 0
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_branch_true(0, 0))
    // r1 = 0
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(1, 0))
    // return r1
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(1))
    func.instr_count = 4

    func
}

fn wasm_lower_test_make_neg_func() -> IrFunction with Mut, Panic, Div {
    // fn negate(x) -> -x
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // r1 = -r0
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_unaryop(1, UnaryOp::OpNeg, 0))
    // return r1
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_copy_func() -> IrFunction with Mut, Panic, Div {
    // fn identity(x) -> x  (via copy)
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // r1 = r0
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_copy(1, 0))
    // return r1
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_sub_func() -> IrFunction with Mut, Panic, Div {
    // fn sub(a, b) -> a - b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_binop(2, 0, BinaryOp::OpSub, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(2))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_compare_func() -> IrFunction with Mut, Panic, Div {
    // fn lt(a, b) -> a < b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_binop(2, 0, BinaryOp::OpLt, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(2))
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_bool_func() -> IrFunction with Mut, Panic, Div {
    // fn load_true() -> true
    var func = ir_empty_function()
    func.param_count = 0
    func.reg_count = 1

    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_bool(0, true))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2

    func
}

// ============================================================================
// Inline tests
// ============================================================================

// Test 1: lowering context initialization
fn test_wasm_lower_ctx_init() -> bool with Mut, Panic, Div {
    let ctx = wasm_lower_ctx_new()
    ctx.local_count == 0
        && ctx.func_count == 0
        && ctx.label_depth == 0
        && ctx.error_count == 0
        && ctx.body.code_len == 0
}

// Test 2: local variable allocation
fn test_wasm_lower_alloc_locals() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 5)
    ctx = wasm_lower_alloc_local(ctx, 0)  // duplicate, should not increment

    let loc0 = wasm_lower_get_local(ctx, 0)
    let loc5 = wasm_lower_get_local(ctx, 5)

    ctx.local_count == 2
        && loc0 == 0
        && loc5 == 1
}

// Test 3: function table registration and lookup
fn test_wasm_lower_func_table() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_register_func(ctx, 0, 10)
    ctx = wasm_lower_register_func(ctx, 3, 42)

    let f0 = wasm_lower_get_func(ctx, 0)
    let f3 = wasm_lower_get_func(ctx, 3)
    let f1 = wasm_lower_get_func(ctx, 1)  // not registered

    f0 == 10 && f3 == 42 && f1 < 0
}

// Test 4: label stack push, find, and pop
fn test_wasm_lower_label_stack() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_push_label(ctx, 100, WASM_LABEL_BLOCK)
    ctx = wasm_lower_push_label(ctx, 200, WASM_LABEL_LOOP)

    let d200 = wasm_lower_find_label_depth(ctx, 200)
    let d100 = wasm_lower_find_label_depth(ctx, 100)
    let d999 = wasm_lower_find_label_depth(ctx, 999)

    // 200 is at depth 0 (top), 100 at depth 1
    let before_ok = d200 == 0 && d100 == 1 && d999 < 0
    ctx = wasm_lower_pop_label(ctx)
    let after_d100 = wasm_lower_find_label_depth(ctx, 100)

    before_ok && after_d100 == 0 && ctx.label_depth == 1
}

// Test 5: lowering IrLoadImm produces i64.const + local.set
fn test_wasm_lower_load_imm() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)

    let instr = ir_load_imm(0, 42)
    ctx = wasm_lower_load_imm(ctx, instr)

    // Should have emitted: i64.const(0x42) 42(LEB128) + local.set(0x21) 0(LEB128)
    // i64.const = 0x42, 42 = 0x2A (1 byte), local.set = 0x21, index 0 = 0x00
    ctx.body.code_len == 4
        && (ctx.body.code[0 as usize] as i64) == 0x42  // i64.const
        && (ctx.body.code[1 as usize] as i64) == 42     // 42 in signed LEB128
        && (ctx.body.code[2 as usize] as i64) == 0x21   // local.set
        && (ctx.body.code[3 as usize] as i64) == 0      // local index 0
}

// Test 6: lowering IrBinOp(OpAdd) produces local.get + local.get + i64.add + local.set
fn test_wasm_lower_binop_add() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)
    ctx = wasm_lower_alloc_local(ctx, 2)

    let instr = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    ctx = wasm_lower_binop(ctx, instr)

    // Expected: local.get 0, local.get 1, i64.add, local.set 2
    // Opcodes: 0x20 0x00 | 0x20 0x01 | 0x7C | 0x21 0x02
    ctx.body.code_len == 7
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[3 as usize] as i64) == 1      // index 1
        && (ctx.body.code[4 as usize] as i64) == 0x7C  // i64.add
        && (ctx.body.code[5 as usize] as i64) == 0x21  // local.set
        && (ctx.body.code[6 as usize] as i64) == 2      // index 2
}

// Test 7: lowering IrReturn produces local.get + return
fn test_wasm_lower_return_val() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 3)

    let instr = ir_return(3)
    ctx = wasm_lower_return(ctx, instr)

    // Expected: local.get 0, return
    // Opcodes: 0x20 0x00 | 0x0F
    ctx.body.code_len == 3
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0 (first allocated)
        && (ctx.body.code[2 as usize] as i64) == 0x0F  // return
}

// Test 8: lowering a complete constant function
fn test_wasm_lower_const_function() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_const_func()
    ctx = wasm_lower_function(ctx, func)

    // Body should have: local decls, i64.const 42, local.set, local.get, return, end
    ctx.body.code_len > 0 && ctx.body.local_count >= 0
}

// Test 9: lowering add function body is non-empty
fn test_wasm_lower_add_function() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_add_func()
    ctx = wasm_lower_function(ctx, func)

    // 3 locals allocated (2 params + 1 result); body has instructions + end
    ctx.body.code_len > 4 && ctx.local_count == 3
}

// Test 10: lowering IrCopy produces correct bytecode
fn test_wasm_lower_copy_op() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)

    let instr = ir_copy(1, 0)
    ctx = wasm_lower_copy(ctx, instr)

    // Expected: local.get 0, local.set 1
    ctx.body.code_len == 4
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x21  // local.set
        && (ctx.body.code[3 as usize] as i64) == 1      // index 1
}

// Test 11: label open produces block opcode + blocktype
fn test_wasm_lower_label_open() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let instr = ir_label(7)
    ctx = wasm_lower_label(ctx, instr)

    // Expected: block(0x02) void(0x40)
    ctx.body.code_len == 2
        && (ctx.body.code[0 as usize] as i64) == 0x02  // block
        && (ctx.body.code[1 as usize] as i64) == 0x40  // void block type
        && ctx.label_depth == 1
}

// Test 12: end_block produces end opcode and pops label
fn test_wasm_lower_end_block() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_push_label(ctx, 10, WASM_LABEL_BLOCK)
    ctx = wasm_lower_end_block(ctx)

    ctx.body.code_len == 1
        && (ctx.body.code[0 as usize] as i64) == 0x0B  // end
        && ctx.label_depth == 0
}

// Test 13: lowering an IrBranchFalse emits i64.eqz + br_if
fn test_wasm_lower_branch_false_op() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_push_label(ctx, 5, WASM_LABEL_BLOCK)

    let instr = ir_branch_false(0, 5)
    ctx = wasm_lower_branch_false(ctx, instr)

    // Expected: local.get 0, i64.eqz, br_if 0
    // Opcodes: 0x20 0x00 | 0x50 | 0x0D 0x00
    ctx.body.code_len == 5
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x50  // i64.eqz
        && (ctx.body.code[3 as usize] as i64) == 0x0D  // br_if
        && (ctx.body.code[4 as usize] as i64) == 0      // label depth 0
}

// Test 14: full module lowering produces valid WASM header
fn test_wasm_lower_module_header() -> bool with Mut, Panic, Div {
    var module = ir_empty_module()
    let func = wasm_lower_test_make_const_func()
    module.functions[0 as usize] = func
    module.fn_count = 1

    let result = wasm_lower_module(module)

    // Check WASM magic bytes at start of buffer
    result.buf.len > 8
        && wasm_buf_byte_at(result.buf, 0) == 0x00
        && wasm_buf_byte_at(result.buf, 1) == 0x61
        && wasm_buf_byte_at(result.buf, 2) == 0x73
        && wasm_buf_byte_at(result.buf, 3) == 0x6D
        && wasm_buf_byte_at(result.buf, 4) == 0x01
        && result.func_count == 1
        && result.error_count == 0
}

// Test 15: lowering compare (OpLt) produces i64.lt_s
fn test_wasm_lower_compare_lt() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)
    ctx = wasm_lower_alloc_local(ctx, 2)

    let instr = ir_binop(2, 0, BinaryOp::OpLt, 1)
    ctx = wasm_lower_binop(ctx, instr)

    // Expected: local.get 0, local.get 1, i64.lt_s, local.set 2
    // i64.lt_s = 0x53
    ctx.body.code_len == 7
        && (ctx.body.code[4 as usize] as i64) == 0x53  // i64.lt_s
}

// Test 16: prescan allocates locals for all used registers
fn test_wasm_lower_prescan() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_add_func()
    ctx = wasm_lower_prescan_locals(ctx, func)

    // 2 params (regs 0,1) + 1 extra (reg 2) = 3 locals
    ctx.local_count == 3
        && wasm_lower_get_local(ctx, 0) == 0
        && wasm_lower_get_local(ctx, 1) == 1
        && wasm_lower_get_local(ctx, 2) == 2
}

// ============================================================================
// Test runner
// ============================================================================

fn wasm_lower_run_tests() -> i64 with Mut, Panic, Div, IO {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_wasm_lower_ctx_init() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_alloc_locals() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_func_table() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_label_stack() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_load_imm() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_binop_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_return_val() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_const_function() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_add_function() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_copy_op() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_label_open() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_end_block() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_branch_false_op() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_module_header() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_compare_lt() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_prescan() { passed = passed + 1 } else { failed = failed + 1 }

    print_int(passed)
    print_int(failed)

    if failed > 0 { 0 - 1 } else { passed }
}
