// self-hosted::wasm::test_runner — entry point for wasm unit tests
//
// Run with:  souc run self-hosted/wasm/test_runner.sio

module wasm::test_runner
use wasm::emitter::*
use wasm::encode::*
use wasm::lower::*

fn main() -> i64 with Mut, Panic, Div {
    let result = wasm_lower_run_tests()
    if result < 0 {
        print("WASM lower tests: FAILED\n")
        1
    } else {
        print("WASM lower tests: PASSED (")
        print_int(result)
        print(" tests)\n")
        0
    }
}
