// Deterministic compiler-native hash over canonical ENIR bytes.
// SHA-256 is computed independently by the E1 gate; this bounded rolling hash
// is intentionally simple enough to cross-check in the independent verifier.

pub fn enir_canonical_hash_l64(text: string) -> i64 with Mut, Panic, Div {
    var hash: i64 = 14695981
    var i: i64 = 0
    let n = str_len(text)
    while i < n {
        let ch = str_char_at(text, i) as i64
        hash = (hash * 257 + ch) % 1000000007
        i = i + 1
    }
    hash
}
