// Native compiler-owned ENIR driver for E1 shadow validation and E2 direct
// source lowering/execution. It remains separate from production codegen.

use enir::ir::*
use enir::parser::*
use enir::canonical::*
use enir::verify::*
use enir::hash::*
use enir::shadow_fixture::*
use enir::source_lower::*
use enir::interpreter::*

fn enir_driver_read(path: string) -> string with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size <= 0 || size > 65536 { panic("ENIR input must contain 1..65536 bytes") }
    let bytes = read_file(path)
    str_from_bytes(bytes, size)
}

fn enir_driver_verify_text(input: string) -> EnirModule with IO, Mut, Panic, Div, Alloc {
    let parsed = enir_parse(input)
    if !parsed.ok {
        print("enir-shadow-error|phase=parse|code=")
        print_int(parsed.error_code)
        print("\n")
        panic("ENIR parse failed")
    }
    let rc = enir_verify(parsed.module)
    if rc != 0 {
        print("enir-shadow-error|phase=verify|code=")
        print_int(rc)
        print("\n")
        panic("ENIR semantic verification failed")
    }
    if enir_print_canonical(parsed.module) != input { panic("ENIR input is not canonical") }
    parsed.module
}

fn enir_driver_emit() with IO, Mut, Panic, Div, Alloc {
    let module = enir_shadow_fixture()
    let rc = enir_verify(module)
    if rc != 0 {
        print("enir-shadow-error|phase=fixture|code=")
        print_int(rc)
        print("\n")
        panic("compiler-owned ENIR fixture failed verification")
    }
    print(enir_print_canonical(module))
}

fn enir_driver_roundtrip(path: string) with IO, Mut, Panic, Div, Alloc {
    let input = enir_driver_read(path)
    let module = enir_driver_verify_text(input)
    let canonical = enir_print_canonical(module)
    let reparsed = enir_parse(canonical)
    if !reparsed.ok || enir_verify(reparsed.module) != 0 { panic("ENIR reparse failed") }
    if enir_print_canonical(reparsed.module) != canonical { panic("ENIR roundtrip changed bytes") }
    print(canonical)
}

fn enir_driver_verify(path: string) with IO, Mut, Panic, Div, Alloc {
    let input = enir_driver_read(path)
    let module = enir_driver_verify_text(input)
    var receipt = "enir-shadow-ok|hash=" ++ enir_i64_string(enir_canonical_hash_l64(input))
    receipt = receipt ++ "|types=" ++ enir_i64_string(module.type_count)
    receipt = receipt ++ "|values=" ++ enir_i64_string(module.value_count)
    receipt = receipt ++ "|provenance=" ++ enir_i64_string(module.provenance_count)
    receipt = receipt ++ "|policies=" ++ enir_i64_string(module.policy_count)
    receipt = receipt ++ "|ops=" ++ enir_i64_string(module.op_count)
    receipt = receipt ++ "|programs=" ++ enir_i64_string(module.program_count)
    receipt = receipt ++ "|observations=" ++ enir_i64_string(module.observation_count) ++ "\n"
    print(receipt)
}

fn enir_driver_lower(path: string, profile: i64) with IO, Mut, Panic, Div, Alloc {
    let source = enir_driver_read(path)
    let lowered = if profile == enir_profile_eisa_v1() {
        enir_lower_source_v1(source)
    } else {
        enir_lower_source(source)
    }
    if !lowered.ok {
        var error = "enir-lower-error|line=" ++ enir_i64_string(lowered.error_line)
        error = error ++ "|code=" ++ enir_i64_string(lowered.error_code) ++ "\n"
        print(error)
        panic("source-to-ENIR lowering failed")
    }
    print(enir_print_canonical(lowered.module))
}

fn enir_driver_run(path: string) with IO, Mut, Panic, Div, Alloc {
    let input = enir_driver_read(path)
    let module = enir_driver_verify_text(input)
    if module.stage != ENIR_STAGE_LOWERED { panic("ENIR run requires a lowered module") }
    let result = enir_interpret(module)
    if !result.ok {
        var error = "enir-exec-error|code=" ++ enir_i64_string(result.error_code)
        error = error ++ "|executed_ops=" ++ enir_i64_string(result.executed_ops)
        error = error ++ "|observations=" ++ enir_i64_string(result.observations) ++ "\n"
        print(error)
        panic("ENIR interpretation failed")
    }
    var receipt = "enir-exec-ok|module=" ++ enir_name_to_string(module.name)
    receipt = receipt ++ "|module_hash=" ++ enir_i64_string(enir_canonical_hash_l64(input))
    receipt = receipt ++ "|executed_ops=" ++ enir_i64_string(result.executed_ops)
    receipt = receipt ++ "|observations=" ++ enir_i64_string(result.observations) ++ "\n"
    print(receipt)
}

fn main() with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc == 1 && get_arg(0) == "emit" {
        enir_driver_emit()
        return
    }
    if argc == 2 && get_arg(0) == "roundtrip" {
        enir_driver_roundtrip(get_arg(1))
        return
    }
    if argc == 2 && get_arg(0) == "verify" {
        enir_driver_verify(get_arg(1))
        return
    }
    if argc == 2 && get_arg(0) == "lower" {
        enir_driver_lower(get_arg(1), enir_profile_eisa_v0())
        return
    }
    if argc == 2 && get_arg(0) == "lower-v1" {
        enir_driver_lower(get_arg(1), enir_profile_eisa_v1())
        return
    }
    if argc == 2 && get_arg(0) == "run" {
        enir_driver_run(get_arg(1))
        return
    }
    panic("usage: madaros-enir emit | roundtrip <enir> | verify <enir> | lower <source> | lower-v1 <source> | run <enir>")
}
