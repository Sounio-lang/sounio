// Canonical ENIR printer. Field order, decimal spelling, line order, and the
// final newline are part of the E1 byte contract.

use enir::ir::*

pub fn enir_i64_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == -9223372036854775807 - 1 { return "-9223372036854775808" }
    var out: [i8; 24] = [0; 24]
    if n == 0 {
        out[0] = 48 as i8
        return str_from_bytes(out, 1)
    }
    var value = n
    var digits: i64 = 1
    while value <= -10 || value >= 10 {
        digits = digits + 1
        value = value / 10
    }
    let negative = n < 0
    let total_len = if negative { digits + 1 } else { digits }
    var write = total_len - 1
    value = n
    while value <= -10 || value >= 10 {
        var digit = value % 10
        if digit < 0 { digit = 0 - digit }
        out[write as usize] = (48 + digit) as i8
        write = write - 1
        value = value / 10
    }
    var final_digit = value
    if final_digit < 0 { final_digit = 0 - final_digit }
    out[write as usize] = (48 + final_digit) as i8
    if negative { out[0] = 45 as i8 }
    str_from_bytes(out, total_len)
}

fn enir_append_i64(out: string, value: i64) -> string with Mut, Panic, Div, Alloc {
    out ++ "|" ++ enir_i64_string(value)
}

pub fn enir_print_canonical(module: EnirModule) -> string with Mut, Panic, Div, Alloc {
    var out = "enir"
    out = enir_append_i64(out, module.schema_version)
    out = enir_append_i64(out, module.stage)
    out = out ++ "|" ++ enir_name_to_string(module.name)
    out = enir_append_i64(out, module.profile) ++ "\n"

    if enir_schema_has_cfg(module.schema_version) {
        out = out ++ "resource"
        out = enir_append_i64(out, module.fuel_limit) ++ "\n"
    }

    var i: i64 = 0
    while i < module.type_count {
        let ty = module.types[i as usize]
        out = out ++ "type"
        out = enir_append_i64(out, ty.id)
        out = enir_append_i64(out, ty.value_kind)
        out = enir_append_i64(out, ty.error_kind)
        out = enir_append_i64(out, ty.uncertainty_kind)
        out = enir_append_i64(out, ty.status_tracked)
        out = enir_append_i64(out, ty.provenance_tracked)
        out = enir_append_i64(out, ty.profile) ++ "\n"
        i = i + 1
    }

    i = 0
    while i < module.value_count {
        let value = module.values[i as usize]
        out = out ++ "value"
        out = enir_append_i64(out, value.id)
        out = enir_append_i64(out, value.type_id)
        out = enir_append_i64(out, value.known_bits)
        out = enir_append_i64(out, value.value_bits)
        out = enir_append_i64(out, value.fp_class)
        out = enir_append_i64(out, value.error0_bits)
        out = enir_append_i64(out, value.error1_bits)
        out = enir_append_i64(out, value.error2_bits)
        out = enir_append_i64(out, value.error3_bits)
        out = enir_append_i64(out, value.uncertainty_bits)
        out = enir_append_i64(out, value.status_kind)
        out = enir_append_i64(out, value.status_reason)
        out = enir_append_i64(out, value.provenance_id) ++ "\n"
        i = i + 1
    }

    i = 0
    while i < module.provenance_count {
        let provenance = module.provenance[i as usize]
        out = out ++ "prov"
        out = enir_append_i64(out, provenance.id)
        out = enir_append_i64(out, provenance.source_span_id)
        out = enir_append_i64(out, provenance.input_origin_id)
        out = enir_append_i64(out, provenance.transform_id)
        out = enir_append_i64(out, provenance.assumption_id)
        out = enir_append_i64(out, provenance.policy_id) ++ "\n"
        i = i + 1
    }

    i = 0
    while i < module.policy_count {
        let policy = module.policies[i as usize]
        out = out ++ "policy"
        out = enir_append_i64(out, policy.id)
        out = out ++ "|" ++ enir_name_to_string(policy.name)
        out = enir_append_i64(out, policy.branch_kind)
        out = enir_append_i64(out, policy.gate_kind) ++ "\n"
        i = i + 1
    }

    if enir_schema_has_cfg(module.schema_version) {
        i = 0
        while i < module.block_count {
            let block = module.blocks[i as usize]
            out = out ++ "block"
            out = enir_append_i64(out, block.id)
            out = enir_append_i64(out, block.first_op)
            out = enir_append_i64(out, block.op_count)
            out = enir_append_i64(out, block.arg_start)
            out = enir_append_i64(out, block.arg_count)
            out = enir_append_i64(out, block.terminator_kind)
            out = enir_append_i64(out, block.condition_value)
            out = enir_append_i64(out, block.edge0)
            out = enir_append_i64(out, block.edge1)
            out = enir_append_i64(out, block.terminator_fuel_cost) ++ "\n"
            i = i + 1
        }
        i = 0
        while i < module.block_arg_count {
            let arg = module.block_args[i as usize]
            out = out ++ "barg"
            out = enir_append_i64(out, arg.id)
            out = enir_append_i64(out, arg.block_id)
            out = enir_append_i64(out, arg.ordinal)
            out = enir_append_i64(out, arg.value_id)
            out = enir_append_i64(out, arg.type_id)
            out = enir_append_i64(out, arg.provenance_id) ++ "\n"
            i = i + 1
        }
        i = 0
        while i < module.edge_count {
            let edge = module.edges[i as usize]
            out = out ++ "edge"
            out = enir_append_i64(out, edge.id)
            out = enir_append_i64(out, edge.from_block)
            out = enir_append_i64(out, edge.to_block)
            out = enir_append_i64(out, edge.arg_count)
            out = enir_append_i64(out, edge.arg0)
            out = enir_append_i64(out, edge.arg1)
            out = enir_append_i64(out, edge.arg2)
            out = enir_append_i64(out, edge.arg3) ++ "\n"
            i = i + 1
        }
    }

    i = 0
    while i < module.op_count {
        let op = module.ops[i as usize]
        out = out ++ "op"
        out = enir_append_i64(out, op.id)
        out = enir_append_i64(out, op.opcode)
        out = enir_append_i64(out, op.result_id)
        out = enir_append_i64(out, op.type_id)
        out = enir_append_i64(out, op.a)
        out = enir_append_i64(out, op.b)
        out = enir_append_i64(out, op.target)
        out = enir_append_i64(out, op.policy_id)
        out = enir_append_i64(out, op.memory_slot)
        out = enir_append_i64(out, op.fuel_cost) ++ "\n"
        i = i + 1
    }

    i = 0
    while i < module.observation_count {
        let obs = module.observations[i as usize]
        out = out ++ "obs"
        out = enir_append_i64(out, obs.id)
        out = out ++ "|" ++ enir_name_to_string(obs.program_name)
        out = enir_append_i64(out, obs.ordinal)
        out = enir_append_i64(out, obs.kind) ++ "\n"
        i = i + 1
    }

    if module.schema_version == ENIR_SCHEMA_CFG_VERSION { out = out ++ "end2" }
    else if module.schema_version == ENIR_SCHEMA_JOIN_VERSION { out = out ++ "end3" }
    else { out = out ++ "end" }
    out = enir_append_i64(out, module.type_count)
    out = enir_append_i64(out, module.value_count)
    out = enir_append_i64(out, module.provenance_count)
    out = enir_append_i64(out, module.policy_count)
    if enir_schema_has_cfg(module.schema_version) {
        out = enir_append_i64(out, module.block_count)
        out = enir_append_i64(out, module.block_arg_count)
        out = enir_append_i64(out, module.edge_count)
    }
    out = enir_append_i64(out, module.op_count)
    out = enir_append_i64(out, module.observation_count)
    out = enir_append_i64(out, module.program_count) ++ "\n"
    out
}
