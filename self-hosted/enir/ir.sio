// Madaros v2 EpistemicNumericIR (ENIR) canonical shadow data model.
//
// E1 is deliberately disconnected from lowering and codegen. These structs are
// compiler-owned semantic artifacts used by the parser, printer, verifier, and
// deterministic hash surface.

// These numeric values are stable parts of the canonical on-disk format.
pub let ENIR_SCHEMA_VERSION: i64 = 1
pub let ENIR_SCHEMA_CFG_VERSION: i64 = 2
pub let ENIR_SCHEMA_JOIN_VERSION: i64 = 3
pub let ENIR_STAGE_SHADOW: i64 = 1
pub let ENIR_STAGE_LOWERED: i64 = 2
pub let ENIR_MAX_TYPES: i64 = 16
pub let ENIR_MAX_VALUES: i64 = 128
pub let ENIR_MAX_PROVENANCE: i64 = 128
pub let ENIR_MAX_POLICIES: i64 = 16
pub let ENIR_MAX_OPS: i64 = 128
pub let ENIR_MAX_OBSERVATIONS: i64 = 64
pub let ENIR_NAME_CAP: i64 = 64
pub let ENIR_MAX_BLOCKS: i64 = 16
pub let ENIR_MAX_BLOCK_ARGS: i64 = 32
pub let ENIR_MAX_EDGES: i64 = 32
pub let ENIR_MAX_EDGE_ARGS: i64 = 4

pub fn enir_value_f64() -> i64 { 4 }

pub fn enir_error_exact() -> i64 { 0 }
pub fn enir_error_dd64() -> i64 { 1 }
pub fn enir_error_qd128() -> i64 { 2 }
pub fn enir_error_static_bound() -> i64 { 3 }

pub fn enir_uncertainty_exact() -> i64 { 0 }
pub fn enir_uncertainty_gum1() -> i64 { 1 }
pub fn enir_uncertainty_interval() -> i64 { 2 }
pub fn enir_uncertainty_pbox() -> i64 { 3 }
pub fn enir_uncertainty_unknown() -> i64 { 4 }

pub fn enir_profile_eisa_v0() -> i64 { 0 }
pub fn enir_profile_eisa_v1() -> i64 { 1 }
pub fn enir_profile_eisa_v2() -> i64 { 2 }
pub fn enir_profile_general() -> i64 { 3 }

pub fn enir_fp_positive_zero() -> i64 { 0 }
pub fn enir_fp_negative_zero() -> i64 { 1 }
pub fn enir_fp_subnormal() -> i64 { 2 }
pub fn enir_fp_normal() -> i64 { 3 }
pub fn enir_fp_positive_infinity() -> i64 { 4 }
pub fn enir_fp_negative_infinity() -> i64 { 5 }
pub fn enir_fp_quiet_nan() -> i64 { 6 }
pub fn enir_fp_signaling_nan() -> i64 { 7 }

pub fn enir_status_clean() -> i64 { 0 }
pub fn enir_status_poisoned() -> i64 { 1 }
pub fn enir_status_trapped() -> i64 { 2 }
pub fn enir_status_unsupported() -> i64 { 3 }

pub fn enir_branch_policy_count_only() -> i64 { 0 }
pub fn enir_gate_policy_10_100() -> i64 { 0 }

pub fn enir_op_econst() -> i64 { 0 }
pub fn enir_op_eload() -> i64 { 1 }
pub fn enir_op_eadd() -> i64 { 2 }
pub fn enir_op_esub() -> i64 { 3 }
pub fn enir_op_emul() -> i64 { 4 }
pub fn enir_op_ediv() -> i64 { 5 }
pub fn enir_op_esqrt() -> i64 { 6 }
pub fn enir_op_egate() -> i64 { 7 }
pub fn enir_op_estore() -> i64 { 8 }
pub fn enir_op_emov() -> i64 { 9 }
pub fn enir_op_ebr() -> i64 { 10 }
pub fn enir_op_ebrz() -> i64 { 11 }
pub fn enir_op_ebrn() -> i64 { 12 }
pub fn enir_op_ehalt() -> i64 { 13 }

pub fn enir_observation_gate() -> i64 { 0 }
pub fn enir_observation_fuel() -> i64 { 1 }

pub fn enir_term_halt() -> i64 { 0 }
pub fn enir_term_jump() -> i64 { 1 }
pub fn enir_term_branch_zero() -> i64 { 2 }
pub fn enir_term_branch_negative() -> i64 { 3 }
pub fn enir_transform_block_arg() -> i64 { 100 }

pub fn enir_schema_has_cfg(schema: i64) -> bool {
    schema == ENIR_SCHEMA_CFG_VERSION || schema == ENIR_SCHEMA_JOIN_VERSION
}

pub fn enir_cfg_op_allowed(opcode: i64) -> bool {
    opcode == enir_op_econst() || opcode == enir_op_eload() ||
    (opcode >= enir_op_eadd() && opcode <= enir_op_egate()) ||
    opcode == enir_op_estore() || opcode == enir_op_emov()
}

pub struct EnirName {
    pub buf: [i8; 64],
    pub len: i64,
}

pub fn enir_name_empty() -> EnirName {
    EnirName { buf: [0; 64], len: 0 }
}

pub fn enir_name_from_string(s: string) -> EnirName with Mut, Panic, Div {
    var out = enir_name_empty()
    let n = str_len(s)
    if n <= 0 || n > ENIR_NAME_CAP { return out }
    var i: i64 = 0
    while i < n {
        let ch = str_char_at(s, i) as i64
        // Canonical names are printable ASCII without the field/newline bytes.
        if ch < 33 || ch > 126 || ch == 124 { return enir_name_empty() }
        out.buf[i as usize] = ch as i8
        i = i + 1
    }
    out.len = n
    out
}

pub fn enir_name_eq(a: EnirName, b: EnirName) -> bool {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

pub fn enir_name_to_string(n: EnirName) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(n.buf, n.len)
}

pub struct EnirType {
    pub id: i64,
    pub value_kind: i64,
    pub error_kind: i64,
    pub uncertainty_kind: i64,
    pub status_tracked: i64,
    pub provenance_tracked: i64,
    pub profile: i64,
}

pub fn enir_type_empty() -> EnirType {
    EnirType {
        id: -1,
        value_kind: -1,
        error_kind: -1,
        uncertainty_kind: -1,
        status_tracked: 0,
        provenance_tracked: 0,
        profile: -1,
    }
}

// Symbolic SSA value descriptor. known_bits=0 means runtime bits/class/error
// words are not statically known; the fields remain present and canonical.
pub struct EnirValue {
    pub id: i64,
    pub type_id: i64,
    pub known_bits: i64,
    pub value_bits: i64,
    pub fp_class: i64,
    pub error0_bits: i64,
    pub error1_bits: i64,
    pub error2_bits: i64,
    pub error3_bits: i64,
    pub uncertainty_bits: i64,
    pub status_kind: i64,
    pub status_reason: i64,
    pub provenance_id: i64,
}

pub fn enir_value_empty() -> EnirValue {
    EnirValue {
        id: -1,
        type_id: -1,
        known_bits: 0,
        value_bits: 0,
        fp_class: -1,
        error0_bits: 0,
        error1_bits: 0,
        error2_bits: 0,
        error3_bits: 0,
        uncertainty_bits: 0,
        status_kind: -1,
        status_reason: -1,
        provenance_id: -1,
    }
}

