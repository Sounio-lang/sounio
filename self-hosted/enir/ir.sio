pub struct EnirModule {
    pub schema_version: i64,
    pub stage: i64,
    pub name: EnirName,
    pub profile: i64,
    pub fuel_limit: i64,
    pub types: [EnirType; 16],
    pub type_count: i64,
    pub values: [EnirValue; 128],
    pub value_count: i64,
    pub provenance: [EnirProvenance; 128],
    pub provenance_count: i64,
    pub policies: [EnirPolicy; 16],
    pub policy_count: i64,
    pub ops: [EnirOp; 128],
    pub op_count: i64,
    pub observations: [EnirObservation; 64],
    pub observation_count: i64,
    pub blocks: [EnirBlock; 16],
    pub block_count: i64,
    pub block_args: [EnirBlockArg; 32],
    pub block_arg_count: i64,
    pub edges: [EnirEdge; 32],
    pub edge_count: i64,
    pub program_count: i64,
    pub declared_type_count: i64,
    pub declared_value_count: i64,
    pub declared_provenance_count: i64,
    pub declared_policy_count: i64,
    pub declared_op_count: i64,
    pub declared_observation_count: i64,
    pub declared_block_count: i64,
    pub declared_block_arg_count: i64,
    pub declared_edge_count: i64,
    pub declared_program_count: i64,
}

pub fn enir_module_empty() -> EnirModule {
    EnirModule {
        schema_version: ENIR_SCHEMA_VERSION,
        stage: ENIR_STAGE_SHADOW,
        name: enir_name_empty(),
        profile: -1,
        fuel_limit: -1,
        types: [EnirType { id: -1, value_kind: -1, error_kind: -1, uncertainty_kind: -1, status_tracked: 0, provenance_tracked: 0, profile: -1 }; 16],
        type_count: 0,
        values: [EnirValue { id: -1, type_id: -1, known_bits: 0, value_bits: 0, fp_class: -1, error0_bits: 0, error1_bits: 0, error2_bits: 0, error3_bits: 0, uncertainty_bits: 0, status_kind: -1, status_reason: -1, provenance_id: -1 }; 128],
        value_count: 0,
        provenance: [EnirProvenance { id: -1, source_span_id: -1, input_origin_id: -1, transform_id: -1, assumption_id: -1, policy_id: -1 }; 128],
        provenance_count: 0,
        policies: [EnirPolicy { id: -1, name: EnirName { buf: [0; 64], len: 0 }, branch_kind: -1, gate_kind: -1 }; 16],
        policy_count: 0,
        ops: [EnirOp { id: -1, opcode: -1, result_id: -1, type_id: -1, a: -1, b: -1, target: -1, policy_id: -1, memory_slot: -1, fuel_cost: -1 }; 128],
        op_count: 0,
        observations: [EnirObservation { id: -1, program_name: EnirName { buf: [0; 64], len: 0 }, ordinal: -1, kind: -1 }; 64],
        observation_count: 0,
        blocks: [EnirBlock { id: -1, first_op: -1, op_count: -1, arg_start: -1, arg_count: 0, terminator_kind: -1, condition_value: -1, edge0: -1, edge1: -1, terminator_fuel_cost: -1 }; 16],
        block_count: 0,
        block_args: [EnirBlockArg { id: -1, block_id: -1, ordinal: -1, value_id: -1, type_id: -1, provenance_id: -1 }; 32],
        block_arg_count: 0,
        edges: [EnirEdge { id: -1, from_block: -1, to_block: -1, arg_count: 0, arg0: -1, arg1: -1, arg2: -1, arg3: -1 }; 32],
        edge_count: 0,
        program_count: 0,
        declared_type_count: -1,
        declared_value_count: -1,
        declared_provenance_count: -1,
        declared_policy_count: -1,
        declared_op_count: -1,
        declared_observation_count: -1,
        declared_block_count: -1,
        declared_block_arg_count: -1,
        declared_edge_count: -1,
        declared_program_count: -1,
    }
}

pub fn enir_module_push_value(m: EnirModule, value: EnirValue) -> EnirModule with Mut, Panic {
    var out = m
    if out.value_count >= ENIR_MAX_VALUES { return out }
    out.values[out.value_count as usize] = value
    out.value_count = out.value_count + 1
    out
}

pub fn enir_module_push_provenance(m: EnirModule, provenance: EnirProvenance) -> EnirModule with Mut, Panic {
    var out = m
    if out.provenance_count >= ENIR_MAX_PROVENANCE { return out }
    out.provenance[out.provenance_count as usize] = provenance
    out.provenance_count = out.provenance_count + 1
    out
}

pub fn enir_module_push_type(m: EnirModule, ty: EnirType) -> EnirModule with Mut, Panic {
    var out = m
    if out.type_count >= ENIR_MAX_TYPES { return out }
    out.types[out.type_count as usize] = ty
    out.type_count = out.type_count + 1
    out
}

pub fn enir_module_push_policy(m: EnirModule, policy: EnirPolicy) -> EnirModule with Mut, Panic {
    var out = m
    if out.policy_count >= ENIR_MAX_POLICIES { return out }
    out.policies[out.policy_count as usize] = policy
    out.policy_count = out.policy_count + 1
    out
}

pub fn enir_module_push_op(m: EnirModule, op: EnirOp) -> EnirModule with Mut, Panic {
    var out = m
    if out.op_count >= ENIR_MAX_OPS { return out }
    out.ops[out.op_count as usize] = op
    out.op_count = out.op_count + 1
    out
}

pub fn enir_module_push_observation(m: EnirModule, obs: EnirObservation) -> EnirModule with Mut, Panic {
    var out = m
    if out.observation_count >= ENIR_MAX_OBSERVATIONS { return out }
    out.observations[out.observation_count as usize] = obs
    out.observation_count = out.observation_count + 1
    out
}

pub fn enir_module_push_block(m: EnirModule, block: EnirBlock) -> EnirModule with Mut, Panic {
    var out = m
    if out.block_count >= ENIR_MAX_BLOCKS { return out }
    out.blocks[out.block_count as usize] = block
    out.block_count = out.block_count + 1
    out
}

pub fn enir_module_push_block_arg(m: EnirModule, arg: EnirBlockArg) -> EnirModule with Mut, Panic {
    var out = m
    if out.block_arg_count >= ENIR_MAX_BLOCK_ARGS { return out }
    out.block_args[out.block_arg_count as usize] = arg
    out.block_arg_count = out.block_arg_count + 1
    out
}

pub fn enir_module_push_edge(m: EnirModule, edge: EnirEdge) -> EnirModule with Mut, Panic {
    var out = m
    if out.edge_count >= ENIR_MAX_EDGES { return out }
    out.edges[out.edge_count as usize] = edge
    out.edge_count = out.edge_count + 1
    out
}

pub fn enir_module_finalize_counts(m: EnirModule, programs: i64) -> EnirModule with Mut {
    var out = m
    out.program_count = programs
    out.declared_type_count = out.type_count
    out.declared_value_count = out.value_count
    out.declared_provenance_count = out.provenance_count
    out.declared_policy_count = out.policy_count
    out.declared_op_count = out.op_count
    out.declared_observation_count = out.observation_count
    out.declared_program_count = programs
    out
}

pub fn enir_module_finalize_cfg_counts(m: EnirModule, programs: i64) -> EnirModule with Mut {
    var out = enir_module_finalize_counts(m, programs)
    out.declared_block_count = out.block_count
    out.declared_block_arg_count = out.block_arg_count
    out.declared_edge_count = out.edge_count
    out
}
