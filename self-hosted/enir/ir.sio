    pub id: i64,
    pub source_span_id: i64,
    pub input_origin_id: i64,
    pub transform_id: i64,
    pub assumption_id: i64,
    pub policy_id: i64,
}

pub fn enir_provenance_empty() -> EnirProvenance {
    EnirProvenance {
        id: -1,
        source_span_id: -1,
        input_origin_id: -1,
        transform_id: -1,
        assumption_id: -1,
        policy_id: -1,
    }
}

