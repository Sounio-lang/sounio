    pub terminator_kind: i64,
    pub condition_value: i64,
    pub edge0: i64,
    pub edge1: i64,
    pub terminator_fuel_cost: i64,
}

pub fn enir_block_empty() -> EnirBlock {
    EnirBlock {
        id: -1,
        first_op: -1,
        op_count: -1,
        arg_start: -1,
        arg_count: 0,
        terminator_kind: -1,
        condition_value: -1,
        edge0: -1,
        edge1: -1,
        terminator_fuel_cost: -1,
    }
}

