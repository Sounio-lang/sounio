// Canonical E1 shadow fixture: full current opcode/type-axis coverage plus the
// exact ordered 30-program/39-observation METRON oracle manifest.

use enir::ir::*

fn enir_shadow_value(id: i64, type_id: i64, known: i64, bits: i64, fp_class: i64) -> EnirValue {
    EnirValue {
        id: id,
        type_id: type_id,
        known_bits: known,
        value_bits: bits,
        fp_class: fp_class,
        error0_bits: 0,
        error1_bits: 0,
        error2_bits: 0,
        error3_bits: 0,
        uncertainty_bits: 0,
        status_kind: enir_status_clean(),
        status_reason: -1,
        provenance_id: id,
    }
}

fn enir_shadow_provenance(id: i64, transform: i64, origin: i64) -> EnirProvenance {
    EnirProvenance {
        id: id,
        source_span_id: 100 + id,
        input_origin_id: origin,
        transform_id: transform,
        assumption_id: -1,
        policy_id: -1,
    }
}

fn enir_shadow_op(id: i64, opcode: i64, result: i64, type_id: i64, a: i64, b: i64, target: i64, policy: i64, slot: i64) -> EnirOp {
    EnirOp {
        id: id,
        opcode: opcode,
        result_id: result,
        type_id: type_id,
        a: a,
        b: b,
        target: target,
        policy_id: policy,
        memory_slot: slot,
        fuel_cost: 1,
    }
}

fn enir_shadow_add_program(m: EnirModule, name: string, count: i64, kind: i64) -> EnirModule with Mut, Panic, Div {
    var out = m
    let canonical_name = enir_name_from_string(name)
    var ordinal: i64 = 0
    while ordinal < count {
        out = enir_module_push_observation(out, EnirObservation {
            id: out.observation_count,
            program_name: canonical_name,
            ordinal: ordinal,
            kind: kind,
        })
        ordinal = ordinal + 1
    }
    out
}

pub fn enir_shadow_fixture() -> EnirModule with Mut, Panic, Div, Alloc {
    var module = enir_module_empty()
    module.name = enir_name_from_string("eisa_metron_shadow")
    module.profile = enir_profile_eisa_v2()

    module = enir_module_push_type(module, EnirType {
        id: 0,
        value_kind: enir_value_f64(),
        error_kind: enir_error_exact(),
        uncertainty_kind: enir_uncertainty_exact(),
        status_tracked: 1,
        provenance_tracked: 1,
        profile: enir_profile_eisa_v2(),
    })
    module = enir_module_push_type(module, EnirType {
        id: 1,
        value_kind: enir_value_f64(),
        error_kind: enir_error_dd64(),
        uncertainty_kind: enir_uncertainty_gum1(),
        status_tracked: 1,
        provenance_tracked: 1,
        profile: enir_profile_eisa_v1(),
    })
    module = enir_module_push_type(module, EnirType {
        id: 2,
        value_kind: enir_value_f64(),
        error_kind: enir_error_qd128(),
        uncertainty_kind: enir_uncertainty_gum1(),
        status_tracked: 1,
        provenance_tracked: 1,
        profile: enir_profile_eisa_v2(),
    })

    // Constants: +1.0 exact, +2.0 qd128, and +1.0 dd64.
    module = enir_module_push_value(module, enir_shadow_value(0, 0, 1, 4607182418800017408, enir_fp_normal()))
    module = enir_module_push_value(module, enir_shadow_value(1, 2, 1, 4611686018427387904, enir_fp_normal()))
    module = enir_module_push_value(module, enir_shadow_value(2, 1, 1, 4607182418800017408, enir_fp_normal()))
    module = enir_module_push_value(module, enir_shadow_value(3, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(4, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(5, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(6, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(7, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(8, 2, 0, 0, -1))
    module = enir_module_push_value(module, enir_shadow_value(9, 2, 0, 0, -1))

    var value_id: i64 = 0
    while value_id < 10 {
        let transform = if value_id < 3 { enir_op_econst() } else { value_id }
        let origin = if value_id < 3 { value_id } else { -1 }
        module = enir_module_push_provenance(module, enir_shadow_provenance(value_id, transform, origin))
        value_id = value_id + 1
    }

    module = enir_module_push_policy(module, EnirPolicy {
        id: 0,
        name: enir_name_from_string("eisa_10_100_count_only"),
        branch_kind: enir_branch_policy_count_only(),
        gate_kind: enir_gate_policy_10_100(),
    })

    module = enir_module_push_op(module, enir_shadow_op(0, enir_op_econst(), 0, 0, -1, -1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(1, enir_op_econst(), 1, 2, -1, -1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(2, enir_op_econst(), 2, 1, -1, -1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(3, enir_op_eadd(), 3, 2, 1, 1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(4, enir_op_esub(), 4, 2, 3, 1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(5, enir_op_emul(), 5, 2, 4, 1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(6, enir_op_ediv(), 6, 2, 5, 1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(7, enir_op_esqrt(), 7, 2, 6, -1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(8, enir_op_estore(), -1, -1, 7, -1, -1, -1, 0))
    module = enir_module_push_op(module, enir_shadow_op(9, enir_op_eload(), 8, 2, -1, -1, -1, -1, 0))
    module = enir_module_push_op(module, enir_shadow_op(10, enir_op_emov(), 9, 2, 8, -1, -1, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(11, enir_op_ebr(), -1, -1, -1, -1, 14, -1, -1))
    module = enir_module_push_op(module, enir_shadow_op(12, enir_op_ebrz(), -1, -1, 9, -1, 14, 0, -1))
    module = enir_module_push_op(module, enir_shadow_op(13, enir_op_ebrn(), -1, -1, 9, -1, 14, 0, -1))
    module = enir_module_push_op(module, enir_shadow_op(14, enir_op_egate(), -1, -1, 9, -1, -1, 0, -1))
    module = enir_module_push_op(module, enir_shadow_op(15, enir_op_ehalt(), -1, -1, -1, -1, -1, -1, -1))

    module = enir_shadow_add_program(module, "golden_mul", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "golden_add", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "golden_sqrt", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "golden_poison", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "e5_cancellation", 2, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_loop", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_if_both", 2, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_i6", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_fuel", 1, enir_observation_fuel())
    module = enir_shadow_add_program(module, "v1_highreg", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1e_fixedpoint", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1e_frail", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1e_emov_negzero", 2, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_arith_high", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_fuel_high", 1, enir_observation_fuel())
    module = enir_shadow_add_program(module, "v1_branch_high", 2, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_const_gate", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_add", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_sub", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_mul", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_div", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_sqrt", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_rump_qd", 3, enir_observation_gate())
    module = enir_shadow_add_program(module, "v1_rump_dd", 3, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_fuel", 1, enir_observation_fuel())
    module = enir_shadow_add_program(module, "v2_mem", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_emov", 2, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_loop", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_frail", 1, enir_observation_gate())
    module = enir_shadow_add_program(module, "v2_mem_poison", 1, enir_observation_gate())

    enir_module_finalize_counts(module, 30)
}
