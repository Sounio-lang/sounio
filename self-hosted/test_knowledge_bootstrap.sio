    let info = TransitionPolicyInfo {
        name: name,
        target_ty: ty_i64(),
        route_name: kb_name_from_str("outpatient_review"),
        requirements: None,
        requirement_count: 0,
        max_steps: max_steps,
        rollback_route_name: kb_name_from_str("rollback_review"),
