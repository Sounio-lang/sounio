fn kb_test_full_arity_contest_realizes_single_entry() -> bool with Mut, Panic, Div, Alloc, IO {
    let family_name = kb_make_name(70, 97, 109, 3)  // "Fam"
    let policy_name = kb_make_name(80, 111, 108, 3)  // "Pol"
    let data_name = kb_make_name(100, 97, 116, 3)  // "dat"
    let contest_name = kb_make_name(99, 111, 110, 3)  // "con"
    var checker = checker_new()
    checker = kb_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kb_seed_named_model_family(checker, family_name)
    checker.env = checker.env.bind(data_name, ty_i64(), false)
    let stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: contest_name,
        ty: Some(Box::new(kb_contest_type_expr3(
            kb_named_type3(105, 54, 52),
            kb_named_type3(70, 97, 109),
            kb_named_type3(80, 111, 108),
        ))),
        expr: Some(Box::new(kb_contest_expr(data_name))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let pair = checker.check_let_stmt(stmt)
    let checked = pair.0
    let ty = checked.env.lookup(contest_name)
    let family_ty = checked.env.lookup(family_name)
    let policy_ty = checked.env.lookup(policy_name)
    checked.error_count == 0 &&
    ty.kind == TypeKind::TyContest &&
    checked.contests.count == 1 &&
    ty.epistemic_meta_id == 0 &&
    checked.contests.get(0).family_id == family_ty.epistemic_meta_id &&
    checked.contests.get(0).policy_id == policy_ty.epistemic_meta_id
}

