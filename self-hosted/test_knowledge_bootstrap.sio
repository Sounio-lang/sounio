    let robust_ty = checker_prove_robust_names_mut(checker_ptr, contest_name, policy_name, Span::dummy())
    let validated_ty = ty_validated(ty_i64(), -1.0)
    robust_ty.kind == TypeKind::TyRobust &&
    validated_ty.kind == TypeKind::TyValidated &&
    !types_compatible(robust_ty, validated_ty)
}

