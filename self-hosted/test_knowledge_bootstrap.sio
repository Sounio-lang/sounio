// Focused bootstrap-safe epistemic tests.
//
// This suite intentionally avoids the parser-construction helpers used by the
// broader knowledge tests so it can run inside a small flat bootstrap bundle.

fn kb_make_name(a: i8, b: i8, c: i8, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    n.buf[0] = a
    if count > 1 { n.buf[1] = b }
    if count > 2 { n.buf[2] = c }
    n
}

fn kb_make_name2(a: i8, b: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 2 }
    n.buf[0] = a
    n.buf[1] = b
    n
}

fn kb_make_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn kb_make_name12(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 12 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n
}

fn kb_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 128], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn kb_single_path3(a: i8, b: i8, c: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    AstPath {
        segments: StringList { head_buf: buf, head_len: 3, tail: None },
        seg_count: 1,
    }
}

fn kb_named_type3(a: i8, b: i8, c: i8) -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: kb_single_path3(a, b, c),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kb_int_expr(val: i64) -> Expr with Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprIntLit,
        span: Span::dummy(),
        int_val: val,
        float_val: 0.0,
        name: kb_make_name(0, 0, 0, 0),
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kb_ident_expr(name: Name) -> Expr {
    Expr {
        kind: ExprKind::ExprIdent,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: name,
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kb_policy_type_expr(inner: TypeExpr) -> TypeExpr with Alloc {
    TypeExpr {
        kind: TypeExprKind::TypePolicy,
        span: Span::dummy(),
        path: kb_empty_path(),
        type_args: Some(Box::new(TypeExprList { head: inner, tail: None })),
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kb_contest_type_expr(inner: TypeExpr) -> TypeExpr with Alloc {
    TypeExpr {
        kind: TypeExprKind::TypeContest,
        span: Span::dummy(),
        path: kb_empty_path(),
        type_args: Some(Box::new(TypeExprList { head: inner, tail: None })),
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kb_robust_type_expr(inner: TypeExpr) -> TypeExpr with Alloc {
    TypeExpr {
        kind: TypeExprKind::TypeRobust,
        span: Span::dummy(),
        path: kb_empty_path(),
        type_args: Some(Box::new(TypeExprList { head: inner, tail: None })),
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kb_validated_type_expr(inner: TypeExpr) -> TypeExpr with Alloc {
    TypeExpr {
        kind: TypeExprKind::TypeValidated,
        span: Span::dummy(),
        path: kb_empty_path(),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: Some(Box::new(KnowledgeTypeInfo {
            inner_type: Box::new(inner),
            epsilon: None,
            validity: None,
            provenance: None,
        })),
        refinement_info: None,
    }
}

fn kb_contest_expr(data_name: Name) -> Expr with Alloc, Mut, Panic, Div {
    let model_a = kb_ident_expr(kb_make_name2(77, 49))
    let model_b = kb_ident_expr(kb_make_name2(77, 50))
    let models = Some(Box::new(ExprList {
        head: model_a,
        tail: Some(Box::new(ExprList { head: model_b, tail: None })),
    }))
    Expr {
        kind: ExprKind::ExprContest,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: kb_make_name(0, 0, 0, 0),
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: Some(Box::new(kb_ident_expr(data_name))),
        right: None,
        block: None,
        else_expr: None,
        args: models,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kb_call_expr2(callee_name: Name, arg0: Expr, arg1: Expr) -> Expr with Alloc, Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprCall,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: kb_make_name(0, 0, 0, 0),
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: Some(Box::new(kb_ident_expr(callee_name))),
        right: None,
        block: None,
        else_expr: None,
        args: Some(Box::new(ExprList {
            head: arg0,
            tail: Some(Box::new(ExprList { head: arg1, tail: None })),
        })),
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kb_test_lex_contest_keywords() -> bool with Mut, Div, Panic {
    var policy_text: [i8; 256] = [0; 256]
    policy_text[0] = 80; policy_text[1] = 111; policy_text[2] = 108
    policy_text[3] = 105; policy_text[4] = 99; policy_text[5] = 121

    var contest_text: [i8; 256] = [0; 256]
    contest_text[0] = 67; contest_text[1] = 111; contest_text[2] = 110
    contest_text[3] = 116; contest_text[4] = 101; contest_text[5] = 115; contest_text[6] = 116

    var robust_text: [i8; 256] = [0; 256]
    robust_text[0] = 82; robust_text[1] = 111; robust_text[2] = 98
    robust_text[3] = 117; robust_text[4] = 115; robust_text[5] = 116

    var contest_lower_text: [i8; 256] = [0; 256]
    contest_lower_text[0] = 99; contest_lower_text[1] = 111; contest_lower_text[2] = 110
    contest_lower_text[3] = 116; contest_lower_text[4] = 101; contest_lower_text[5] = 115; contest_lower_text[6] = 116

    var on_text: [i8; 256] = [0; 256]
    on_text[0] = 111; on_text[1] = 110

    keyword_lookup(policy_text, 6) == TokenKind::Policy &&
    keyword_lookup(contest_text, 7) == TokenKind::Contest &&
    keyword_lookup(robust_text, 6) == TokenKind::Robust &&
    keyword_lookup(contest_lower_text, 7) == TokenKind::ContestLower &&
    keyword_lookup(on_text, 2) == TokenKind::On
}

fn kb_test_check_policy_type() -> bool with Mut, Panic, Div, Alloc, IO {
    let te = kb_policy_type_expr(kb_named_type3(105, 54, 52))
    let pair = checker_new().lower_type_expr(te)
    let ty = pair.1
    ty.kind == TypeKind::TyPolicy && knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_check_contest_type() -> bool with Mut, Panic, Div, Alloc, IO {
    let te = kb_contest_type_expr(kb_named_type3(105, 54, 52))
    let pair = checker_new().lower_type_expr(te)
    let ty = pair.1
    ty.kind == TypeKind::TyContest && knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_check_robust_type() -> bool with Mut, Panic, Div, Alloc, IO {
    let te = kb_robust_type_expr(kb_named_type3(105, 54, 52))
    let pair = checker_new().lower_type_expr(te)
    let ty = pair.1
    ty.kind == TypeKind::TyRobust && knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_prove_robust_returns_robust() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    var checker = checker_new()
    checker.env = checker.env.bind(data_name, ty_i64(), false)
    checker.env = checker.env.bind(policy_name, ty_policy(ty_i64(), -1), false)
    let expr = kb_call_expr2(prove_name, kb_contest_expr(data_name), kb_ident_expr(policy_name))
    let pair = checker.check_expr(expr)
    let checked = pair.0
    let ty = pair.1
    checked.error_count == 0 &&
    ty.kind == TypeKind::TyRobust &&
    knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_contest_annotated_ok() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let contest_name = kb_make_name(99, 0, 0, 1)
    let data_stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: data_name,
        ty: Some(Box::new(kb_named_type3(105, 54, 52))),
        expr: Some(Box::new(kb_int_expr(1))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let contest_stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: contest_name,
        ty: Some(Box::new(kb_contest_type_expr(kb_named_type3(105, 54, 52)))),
        expr: Some(Box::new(kb_contest_expr(data_name))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let body = Block {
        stmts: Some(Box::new(StmtList {
            head: data_stmt,
            tail: Some(Box::new(StmtList { head: contest_stmt, tail: None })),
        })),
        span: Span::dummy(),
    }
    let main_name = kb_make_name4(109, 97, 105, 110)
    let fd = FnDef { name: main_name, params: None, return_type: None, effects: None, body: body, span: Span::dummy() }
    let item = Item {
        kind: ItemKind::ItemFn,
        span: Span::dummy(),
        is_pub: false,
        name: main_name,
        fn_def: Some(Box::new(fd)),
        struct_def: None,
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        use_path: kb_empty_path(),
        use_glob: false,
        use_items: None,
    }
    let prog = Program { module_path: kb_empty_path(), items: Some(Box::new(ItemList { head: item, tail: None })) }
    let result = check_program(prog)
    result.error_count == 0
}

fn kb_test_contest_reject_plain() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let contest_name = kb_make_name(99, 0, 0, 1)
    let plain_name = kb_make_name(120, 0, 0, 1)
    let data_stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: data_name,
        ty: Some(Box::new(kb_named_type3(105, 54, 52))),
        expr: Some(Box::new(kb_int_expr(1))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let contest_stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: contest_name,
        ty: Some(Box::new(kb_contest_type_expr(kb_named_type3(105, 54, 52)))),
        expr: Some(Box::new(kb_contest_expr(data_name))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let plain_stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: plain_name,
        ty: Some(Box::new(kb_named_type3(105, 54, 52))),
        expr: Some(Box::new(kb_ident_expr(contest_name))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let body = Block {
        stmts: Some(Box::new(StmtList {
            head: data_stmt,
            tail: Some(Box::new(StmtList {
                head: contest_stmt,
                tail: Some(Box::new(StmtList { head: plain_stmt, tail: None })),
            })),
        })),
        span: Span::dummy(),
    }
    let main_name = kb_make_name4(109, 97, 105, 110)
    let fd = FnDef { name: main_name, params: None, return_type: None, effects: None, body: body, span: Span::dummy() }
    let item = Item {
        kind: ItemKind::ItemFn,
        span: Span::dummy(),
        is_pub: false,
        name: main_name,
        fn_def: Some(Box::new(fd)),
        struct_def: None,
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        use_path: kb_empty_path(),
        use_glob: false,
        use_items: None,
    }
    let prog = Program { module_path: kb_empty_path(), items: Some(Box::new(ItemList { head: item, tail: None })) }
    let result = check_program(prog)
    result.error_count > 0
}

