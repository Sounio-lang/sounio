fn kb_seed_alternative_option(checker: Checker, name: Name, value: i64, residual_tail_risk: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    var info = empty_alternative_candidate_info()
    info.name = name
    info.value_expr = kb_int_expr(value)
    info.value_repr = kb_name_from_str("literal")
    info.metric_known[ALTERNATIVE_METRIC_INTERVENTION_COST as usize] = 1
    info.metric_values[ALTERNATIVE_METRIC_INTERVENTION_COST as usize] = 0.10
    info.metric_known[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize] = 1
    info.metric_values[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize] = residual_tail_risk
    info.metric_known[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize] = 1
    info.metric_values[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize] = 0.08
    info.metric_known[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize] = 1
    info.metric_values[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize] = 0.12
    info.source_kind = ALTERNATIVE_SOURCE_DEFERRED
    info.audit_id = 2
    info.contest_id = 3
    let add_result = c.alternative_candidates.add(info)
    c.alternative_candidates = add_result.0
    c.env = c.env.bind(name, ty_alternative_option(ty_i64(), add_result.1), false)
    c
}

