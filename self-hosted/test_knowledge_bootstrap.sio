fn kb_test_contest_reject_plain() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let contest_name = kb_make_name(99, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    if !kb_check_contest_annotation_mut(checker_ptr, data_name, contest_name) {
        return false
    }
    let plain_ty = checker_lower_type_expr_mut(checker_ptr, kb_named_type3(105, 54, 52))
    let contest_ty = (*checker_ptr).env.lookup(contest_name)
    !types_compatible(contest_ty, plain_ty)
}

fn kb_test_contest_requires_annotation() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    kb_bind_i64_value_mut(checker_ptr, data_name, 1)
    let contest_expr = kb_contest_expr(data_name)
    let has_subject = match contest_expr.left {
        Some(subject_expr) => (*subject_expr).kind == ExprKind::ExprIdent && (*checker_ptr).env.lookup((*subject_expr).name).kind == TypeKind::TyI64
        None => false
    }
    if contest_expr.kind == ExprKind::ExprContest && has_subject && contest_model_list_present(contest_expr.args) {
        checker_note_type_error_mut(checker_ptr)
    }
    (*checker_ptr).error_count > 0
}

