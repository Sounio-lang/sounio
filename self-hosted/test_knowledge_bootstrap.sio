// Focused bootstrap-safe epistemic tests.
//
// This suite intentionally avoids the parser-construction helpers used by the
// broader knowledge tests so it can run inside a small flat bootstrap bundle.

fn kb_make_name(a: i8, b: i8, c: i8, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    n.buf[0] = a
    if count > 1 { n.buf[1] = b }
    if count > 2 { n.buf[2] = c }
    n
}

fn kb_make_name2(a: i8, b: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 2 }
    n.buf[0] = a
    n.buf[1] = b
    n
}

fn kb_make_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn kb_make_name12(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 12 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n
}

fn kb_make_name17(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8, n0: i8, o: i8, p: i8, q: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 17 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n.buf[12] = m
    n.buf[13] = n0
    n.buf[14] = o
    n.buf[15] = p
    n.buf[16] = q
    n
}

fn kb_name_from_str(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < len && i < 128 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

fn kb_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 128], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn kb_single_path3(a: i8, b: i8, c: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    AstPath {
        segments: StringList { head_buf: buf, head_len: 3, tail: None },
        seg_count: 1,
    }
}

fn kb_named_type3(a: i8, b: i8, c: i8) -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: kb_single_path3(a, b, c),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kb_int_expr(val: i64) -> Expr with Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprIntLit,
        span: Span::dummy(),
        int_val: val,
        float_val: 0.0,
        name: kb_make_name(0, 0, 0, 0),
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kb_ident_expr(name: Name) -> Expr {
    Expr {
        kind: ExprKind::ExprIdent,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: name,
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

