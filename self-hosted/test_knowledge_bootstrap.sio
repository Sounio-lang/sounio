        scope_name: kb_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: None,
        requirement_count: 0,
    }
    let add_result = (*checker_ptr).policies.add(info)
    (*checker_ptr).policies = add_result.0
    (*checker_ptr).env = (*checker_ptr).env.bind(name, ty_policy(ty_i64(), add_result.1), false)
}

fn kb_seed_relative_band_policy(checker: Checker, name: Name, op: CompareOp, threshold: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let req = PolicyRequirementInfo {
        metric_id: CONTEST_METRIC_RELATIVE_BAND,
        metric_name: kb_relative_band_name(),
        op: op,
        threshold: threshold,
        threshold_kind: POLICY_THRESHOLD_F64,
        bool_threshold: false,
        name_threshold: kb_make_name(0, 0, 0, 0),
    }
    let info = PolicyInfo {
        name: name,
        target_ty: ty_i64(),
        level_name: kb_make_name(0, 0, 0, 0),
        scope_name: kb_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: Some(Box::new(PolicyRequirementInfoList { head: req, tail: None })),
        requirement_count: 1,
    }
    let add_result = c.policies.add(info)
    c.policies = add_result.0
    c.env = c.env.bind(name, ty_policy(ty_i64(), add_result.1), false)
    c
}

