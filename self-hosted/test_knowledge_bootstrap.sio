fn kb_test_robust_not_validated() -> bool with Mut, Panic, Div, Alloc, IO {
    let data_name = kb_make_name4(100, 97, 116, 97)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let validated_name = kb_make_name(118, 0, 0, 1)
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    var checker = checker_new()
    checker.env = checker.env.bind(data_name, ty_i64(), false)
    checker.env = checker.env.bind(policy_name, ty_policy(ty_i64(), -1), false)
    let stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: validated_name,
        ty: Some(Box::new(kb_validated_type_expr(kb_named_type3(105, 54, 52)))),
        expr: Some(Box::new(kb_call_expr2(prove_name, kb_contest_expr(data_name), kb_ident_expr(policy_name)))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let pair = checker.check_let_stmt(stmt)
    pair.0.error_count > 0
}

fn run_knowledge_bootstrap_tests() -> i32 with IO, Mut, Div, Panic, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== Knowledge Bootstrap Tests ===\n")

    total = total + 1
    if kb_test_lex_contest_keywords() { passed = passed + 1; print("  B01 OK: lex Policy/Contest/Robust/contest/on\n") } else { print("  FAIL: B01 lex Policy/Contest/Robust/contest/on\n") }

    total = total + 1
    if kb_test_check_policy_type() { passed = passed + 1; print("  B02 OK: lower Policy<T>\n") } else { print("  FAIL: B02 lower Policy<T>\n") }

    total = total + 1
    if kb_test_check_contest_type() { passed = passed + 1; print("  B03 OK: lower Contest<T>\n") } else { print("  FAIL: B03 lower Contest<T>\n") }

    total = total + 1
    if kb_test_check_robust_type() { passed = passed + 1; print("  B04 OK: lower Robust<T>\n") } else { print("  FAIL: B04 lower Robust<T>\n") }

    total = total + 1
    if kb_test_prove_robust_returns_robust() { passed = passed + 1; print("  B05 OK: prove_robust yields Robust<T>\n") } else { print("  FAIL: B05 prove_robust yields Robust<T>\n") }

    total = total + 1
    if kb_test_contest_annotated_ok() { passed = passed + 1; print("  B06 OK: explicit Contest<T> annotation\n") } else { print("  FAIL: B06 explicit Contest<T> annotation\n") }

    total = total + 1
    if kb_test_contest_reject_plain() { passed = passed + 1; print("  B07 OK: reject Contest<T> to plain T\n") } else { print("  FAIL: B07 reject Contest<T> to plain T\n") }

    total = total + 1
    if kb_test_contest_requires_annotation() { passed = passed + 1; print("  B08 OK: require Contest<T> annotation\n") } else { print("  FAIL: B08 require Contest<T> annotation\n") }

    total = total + 1
    if kb_test_robust_not_validated() { passed = passed + 1; print("  B09 OK: reject Robust<T> to Validated<T>\n") } else { print("  FAIL: B09 reject Robust<T> to Validated<T>\n") }

    print("\nKnowledge bootstrap tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
