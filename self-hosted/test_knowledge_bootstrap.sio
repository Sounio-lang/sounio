fn kb_test_prove_robust_records_proof() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    kb_seed_contest_with_relative_band_mut(checker_ptr, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let contest_ty = (*checker_ptr).env.lookup(contest_name)
    let ty = checker_prove_robust_names_mut(checker_ptr, contest_name, policy_name, Span::dummy())
    if (*checker_ptr).error_count > 0 || ty.kind != TypeKind::TyRobust || (*checker_ptr).robust_proofs.count != 1 {
        return false
    }
    let proof_info = (*checker_ptr).robust_proofs.get(0)
    proof_info.contest_id == contest_ty.epistemic_meta_id &&
    proof_info.policy_id == policy_ty.epistemic_meta_id &&
    proof_info.level_id == ROBUST_LEVEL_STABLE &&
    proof_info.scope_id == ROBUST_SCOPE_IN_DISTRIBUTION &&
    proof_info.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    proof_info.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

fn kb_test_validate_manifest_records_manifest() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let validation_name = kb_make_name(118, 0, 0, 1)
