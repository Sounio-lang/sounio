fn kb_test_check_observed_transition_type() -> bool with Mut, Panic, Div, Alloc, IO {
    let te = kb_observed_transition_type_expr(kb_named_type3(105, 54, 52))
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    let ty = checker_lower_type_expr_mut(checker_ptr, te)
    ty.kind == TypeKind::TyObservedTransition && knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_check_rollback_certificate_type() -> bool with Mut, Panic, Div, Alloc, IO {
    let te = kb_rollback_certificate_type_expr(kb_named_type3(105, 54, 52))
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    let ty = checker_lower_type_expr_mut(checker_ptr, te)
    ty.kind == TypeKind::TyRollbackCertificate && knowledge_inner(ty).kind == TypeKind::TyI64
}

fn kb_test_observe_transition_records_metadata_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
    let transition_policy_name = kb_name_from_str("tp")
    let protocol_name = kb_name_from_str("proto")
    let monitoring_name = kb_name_from_str("mp")
    let value_name = kb_make_name(118, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_transition_policy_mut(checker_ptr, transition_policy_name, CompareOp::CmpLe, 0.05, 2)
    kb_seed_alternative_option_mut(checker_ptr, option_name, 45, 0.04)
    let transition_ty = (*checker_ptr).env.lookup(transition_policy_name)
    let option_ty = (*checker_ptr).env.lookup(option_name)
    kb_seed_transition_protocol_mut(checker_ptr, protocol_name, option_ty.epistemic_meta_id, transition_ty.epistemic_meta_id, 45)
    kb_seed_monitoring_policy_mut(checker_ptr, monitoring_name, -1, CompareOp::CmpLe, 0.0)
    kb_bind_i64_value_mut(checker_ptr, value_name, 50)
    let plan_ty = checker_commit_alternative_names_mut(checker_ptr, value_name, option_name, protocol_name, Span::dummy())
    let ty = checker_observe_transition_names_mut(checker_ptr, value_name, plan_ty, monitoring_name, Span::dummy())
    if (*checker_ptr).error_count > 0
        || ty.kind != TypeKind::TyObservedTransition
        || (*checker_ptr).observed_transitions.count != 1 {
        return false
    }
    let ok = (*checker_ptr).monitoring_policies.count == 1 &&
        (*checker_ptr).transition_plans.count == 1 &&
        (*checker_ptr).observed_transitions.count == 1 &&
        (*checker_ptr).observed_transitions.get(0).monitoring_policy_id == 0
    ok
}

fn kb_test_rollback_transition_records_metadata_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
    let transition_policy_name = kb_name_from_str("tp")
    let protocol_name = kb_name_from_str("proto")
    let monitoring_name = kb_name_from_str("mp")
    let value_name = kb_make_name(118, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_transition_policy_mut(checker_ptr, transition_policy_name, CompareOp::CmpLe, 0.05, 2)
    kb_seed_alternative_option_mut(checker_ptr, option_name, 45, 0.04)
    let transition_ty = (*checker_ptr).env.lookup(transition_policy_name)
    let option_ty = (*checker_ptr).env.lookup(option_name)
    kb_seed_transition_protocol_mut(checker_ptr, protocol_name, option_ty.epistemic_meta_id, transition_ty.epistemic_meta_id, 45)
    kb_seed_monitoring_policy_mut(checker_ptr, monitoring_name, TRANSITION_METRIC_MECHANISTIC_DIVERGENCE, CompareOp::CmpLe, 0.05)
    kb_bind_i64_value_mut(checker_ptr, value_name, 50)
    let plan_ty = checker_commit_alternative_names_mut(checker_ptr, value_name, option_name, protocol_name, Span::dummy())
    let ty = checker_rollback_transition_names_mut(checker_ptr, value_name, plan_ty, monitoring_name, Span::dummy())
    if (*checker_ptr).error_count > 0
        || ty.kind != TypeKind::TyRollbackCertificate
        || (*checker_ptr).rollback_certificates.count != 1 {
        return false
    }
    let ok = (*checker_ptr).monitoring_policies.count == 1 &&
        (*checker_ptr).transition_plans.count == 1 &&
        (*checker_ptr).rollback_certificates.count == 1 &&
        (*checker_ptr).rollback_certificates.get(0).monitoring_policy_id == 0
    ok
}

fn run_knowledge_bootstrap_tests() -> i32 with IO, Mut, Div, Panic, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== Knowledge Bootstrap Tests ===\n")

    total = total + 1
    if kb_test_lex_contest_keywords() { passed = passed + 1; print("  B01 OK: lex Policy/policy/Contest/Robust/contest/on/require\n") } else { print("  FAIL: B01 lex Policy/policy/Contest/Robust/contest/on/require\n") }

    total = total + 1
    if kb_test_check_policy_type() { passed = passed + 1; print("  B02 OK: lower Policy<T>\n") } else { print("  FAIL: B02 lower Policy<T>\n") }

    total = total + 1
    if kb_test_check_contest_type() { passed = passed + 1; print("  B03 OK: lower Contest<T>\n") } else { print("  FAIL: B03 lower Contest<T>\n") }

    total = total + 1
    if kb_test_check_robust_type() { passed = passed + 1; print("  B04 OK: lower Robust<T>\n") } else { print("  FAIL: B04 lower Robust<T>\n") }

    total = total + 1
    if kb_test_check_shorthand_knowledge_metadata_ok() { passed = passed + 1; print("  B05 OK: shorthand Knowledge<T> accepts unspecified epsilon\n") } else { print("  FAIL: B05 shorthand Knowledge<T> accepts unspecified epsilon\n") }

    total = total + 1
    if kb_test_prove_robust_returns_robust() { passed = passed + 1; print("  B06 OK: prove_robust yields Robust<T>\n") } else { print("  FAIL: B06 prove_robust yields Robust<T>\n") }

    total = total + 1
    if kb_test_contest_annotated_ok() { passed = passed + 1; print("  B07 OK: explicit Contest<T> annotation\n") } else { print("  FAIL: B07 explicit Contest<T> annotation\n") }

    total = total + 1
    if kb_test_contest_reject_plain() { passed = passed + 1; print("  B08 OK: reject Contest<T> to plain T\n") } else { print("  FAIL: B08 reject Contest<T> to plain T\n") }

    total = total + 1
    if kb_test_contest_requires_annotation() { passed = passed + 1; print("  B09 OK: require Contest<T> annotation\n") } else { print("  FAIL: B09 require Contest<T> annotation\n") }

    total = total + 1
    if kb_test_robust_not_validated() { passed = passed + 1; print("  B10 OK: reject Robust<T> to Validated<T>\n") } else { print("  FAIL: B10 reject Robust<T> to Validated<T>\n") }

    total = total + 1
    if kb_test_prove_robust_rejects_missing_diagnostic() { passed = passed + 1; print("  B11 OK: fail closed on missing contest diagnostics\n") } else { print("  FAIL: B11 fail closed on missing contest diagnostics\n") }

    total = total + 1
    if kb_test_prove_robust_accepts_satisfied_requirement() { passed = passed + 1; print("  B12 OK: satisfy named policy requirements\n") } else { print("  FAIL: B12 satisfy named policy requirements\n") }

    total = total + 1
    if kb_test_prove_robust_records_proof() { passed = passed + 1; print("  B13 OK: record robustness proof metadata\n") } else { print("  FAIL: B13 record robustness proof metadata\n") }

    total = total + 1
    if kb_test_validate_manifest_records_manifest() { passed = passed + 1; print("  B14 OK: record validation manifest metadata\n") } else { print("  FAIL: B14 record validation manifest metadata\n") }

    total = total + 1
    if kb_test_check_result_to_ir_epistemic() { passed = passed + 1; print("  B15 OK: export epistemic metadata into IR side tables\n") } else { print("  FAIL: B15 export epistemic metadata into IR side tables\n") }

    total = total + 1
    if kb_test_full_arity_contest_realizes_single_entry() { passed = passed + 1; print("  B16 OK: realize full-arity Contest<T, Family, Policy> without duplicate contest metadata\n") } else { print("  FAIL: B16 realize full-arity Contest<T, Family, Policy> without duplicate contest metadata\n") }

    total = total + 1
    if kb_test_contest_witness_scalar_metric() { passed = passed + 1; print("  B17 OK: scalar contest witness builtin projects seeded metric\n") } else { print("  FAIL: B17 scalar contest witness builtin projects seeded metric\n") }

    total = total + 1
    if kb_test_contest_witness_disagreement_exports_ir() { passed = passed + 1; print("  B18 OK: disagreement witness exports rich epistemic side tables\n") } else { print("  FAIL: B18 disagreement witness exports rich epistemic side tables\n") }

    total = total + 1
    if kb_test_contest_witness_counterexample_struct() { passed = passed + 1; print("  B19 OK: counterexample witness returns named struct\n") } else { print("  FAIL: B19 counterexample witness returns named struct\n") }

    total = total + 1
    if kb_test_contest_witness_posterior_weights_struct() { passed = passed + 1; print("  B20 OK: posterior weights witness returns named struct\n") } else { print("  FAIL: B20 posterior weights witness returns named struct\n") }

    total = total + 1
    if kb_test_contest_witness_rejects_plain_operand() { passed = passed + 1; print("  B21 OK: witness builtins reject non-Contest operands\n") } else { print("  FAIL: B21 witness builtins reject non-Contest operands\n") }

    total = total + 1
    if kb_test_contest_witness_rejects_missing_metric() { passed = passed + 1; print("  B22 OK: fail closed on missing scalar contest metric\n") } else { print("  FAIL: B22 fail closed on missing scalar contest metric\n") }

    total = total + 1
    if kb_test_contest_witness_rejects_missing_mechanistic_report() { passed = passed + 1; print("  B23 OK: fail closed on missing mechanistic report\n") } else { print("  FAIL: B23 fail closed on missing mechanistic report\n") }

    total = total + 1
    if kb_test_contest_witness_rejects_missing_counterexample() { passed = passed + 1; print("  B24 OK: fail closed on missing counterexample witness\n") } else { print("  FAIL: B24 fail closed on missing counterexample witness\n") }

    total = total + 1
    if kb_test_contest_witness_rejects_missing_posterior_weights() { passed = passed + 1; print("  B25 OK: fail closed on missing posterior weights witness\n") } else { print("  FAIL: B25 fail closed on missing posterior weights witness\n") }

    total = total + 1
    if kb_test_check_decision_policy_type() { passed = passed + 1; print("  B26 OK: lower DecisionPolicy<T>\n") } else { print("  FAIL: B26 lower DecisionPolicy<T>\n") }

    total = total + 1
    if kb_test_check_admissible_type() { passed = passed + 1; print("  B27 OK: lower Admissible<T>\n") } else { print("  FAIL: B27 lower Admissible<T>\n") }

    total = total + 1
    if kb_test_admit_action_records_decision_certificate() { passed = passed + 1; print("  B28 OK: admit_action records decision certificate metadata\n") } else { print("  FAIL: B28 admit_action records decision certificate metadata\n") }

    total = total + 1
    if kb_test_check_result_to_ir_exports_decision_artifacts() { passed = passed + 1; print("  B29 OK: export decision admissibility metadata into IR side tables\n") } else { print("  FAIL: B29 export decision admissibility metadata into IR side tables\n") }

    total = total + 1
    if kb_test_robust_not_admissible() { passed = passed + 1; print("  B30 OK: reject Robust<T> to Admissible<T>\n") } else { print("  FAIL: B30 reject Robust<T> to Admissible<T>\n") }

    total = total + 1
    if kb_test_check_deferral_policy_type() { passed = passed + 1; print("  B31 OK: lower DeferralPolicy<T>\n") } else { print("  FAIL: B31 lower DeferralPolicy<T>\n") }

    total = total + 1
    if kb_test_check_deferred_type() { passed = passed + 1; print("  B32 OK: lower Deferred<T>\n") } else { print("  FAIL: B32 lower Deferred<T>\n") }

    total = total + 1
    if kb_test_defer_action_records_deferred_certificate() { passed = passed + 1; print("  B33 OK: defer_action records deferred certificate metadata\n") } else { print("  FAIL: B33 defer_action records deferred certificate metadata\n") }

    total = total + 1
    if kb_test_deferral_reason_records_witness_and_ir() { passed = passed + 1; print("  B34 OK: deferral_reason records witness metadata and exports IR artifacts\n") } else { print("  FAIL: B34 deferral_reason records witness metadata and exports IR artifacts\n") }

    total = total + 1
    if kb_test_check_transition_policy_type() { passed = passed + 1; print("  B35 OK: lower TransitionPolicy<T>\n") } else { print("  FAIL: B35 lower TransitionPolicy<T>\n") }

    total = total + 1
    if kb_test_check_transition_plan_type() { passed = passed + 1; print("  B36 OK: lower TransitionPlan<T>\n") } else { print("  FAIL: B36 lower TransitionPlan<T>\n") }

    total = total + 1
    if kb_test_commit_alternative_records_transition_plan_and_ir() { passed = passed + 1; print("  B37 OK: commit_alternative records transition plan metadata and exports IR artifacts\n") } else { print("  FAIL: B37 commit_alternative records transition plan metadata and exports IR artifacts\n") }

    total = total + 1
    if kb_test_transition_reason_records_witness_and_ir() { passed = passed + 1; print("  B38 OK: transition_reason records witness metadata and exports IR artifacts\n") } else { print("  FAIL: B38 transition_reason records witness metadata and exports IR artifacts\n") }

    total = total + 1
    if kb_test_check_monitoring_policy_type() { passed = passed + 1; print("  B39 OK: lower MonitoringPolicy<T>\n") } else { print("  FAIL: B39 lower MonitoringPolicy<T>\n") }

    total = total + 1
    if kb_test_check_observed_transition_type() { passed = passed + 1; print("  B40 OK: lower ObservedTransition<T>\n") } else { print("  FAIL: B40 lower ObservedTransition<T>\n") }

    total = total + 1
    if kb_test_check_rollback_certificate_type() { passed = passed + 1; print("  B41 OK: lower RollbackCertificate<T>\n") } else { print("  FAIL: B41 lower RollbackCertificate<T>\n") }

    total = total + 1
    if kb_test_observe_transition_records_metadata_and_ir() { passed = passed + 1; print("  B42 OK: observe_transition records metadata and exports IR artifacts\n") } else { print("  FAIL: B42 observe_transition records metadata and exports IR artifacts\n") }

    total = total + 1
    if kb_test_rollback_transition_records_metadata_and_ir() { passed = passed + 1; print("  B43 OK: rollback_transition records metadata and exports IR artifacts\n") } else { print("  FAIL: B43 rollback_transition records metadata and exports IR artifacts\n") }

    print("\nKnowledge bootstrap tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
