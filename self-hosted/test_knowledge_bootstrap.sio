fn kb_seed_contest_with_full_witnesses_mut(checker_ptr: *mut Checker, name: Name, policy_id: i64) with Mut, Panic, Div, Alloc {
    kb_seed_contest_with_core_metrics_mut(checker_ptr, name, policy_id)
    kb_attach_mechanistic_report_mut(checker_ptr, name)
    kb_attach_counterexample_mut(checker_ptr, name)
    kb_attach_posterior_weights_mut(checker_ptr, name)
}

fn kb_bind_i64_value_mut(checker_ptr: *mut Checker, name: Name, value: i64) with Mut, Panic, Div, Alloc {
    (*checker_ptr).env = (*checker_ptr).env.bind(name, ty_i64(), false)
    (*checker_ptr).const_int_name_bufs[(*checker_ptr).const_int_count as usize] = 0 as i8
    (*checker_ptr).const_int_known[(*checker_ptr).const_int_count as usize] = 1
    (*checker_ptr).const_int_values[(*checker_ptr).const_int_count as usize] = value
    if (*checker_ptr).const_int_count < 128 {
        (*checker_ptr).const_int_count = (*checker_ptr).const_int_count + 1
    }
}

fn kb_check_contest_annotation_mut(checker_ptr: *mut Checker, data_name: Name, contest_name: Name) -> bool with Mut, Panic, Div, Alloc, IO {
    kb_bind_i64_value_mut(checker_ptr, data_name, 1)
    let ann_ty = checker_lower_type_expr_mut(checker_ptr, kb_contest_type_expr(kb_named_type3(105, 54, 52)))
    let contest_expr = kb_contest_expr(data_name)
    match contest_expr.left {
        Some(subject_expr) => {
            if (*subject_expr).kind != ExprKind::ExprIdent {
                checker_note_type_error_mut(checker_ptr)
                return false
            }
            let subject_ty = (*checker_ptr).env.lookup((*subject_expr).name)
            if !types_compatible(subject_ty, knowledge_inner(ann_ty)) {
                checker_note_type_error_mut(checker_ptr)
                return false
            }
        }
        None => {
            checker_note_type_error_mut(checker_ptr)
            return false
        }
    }
    if !contest_model_list_present(contest_expr.args) {
        checker_note_type_error_mut(checker_ptr)
        return false
    }
    var info = contest_info_from_expr_models(contest_expr.args)
    info = contest_info_attach_span(info, contest_expr.span)
    let add_result = (*checker_ptr).contests.add(info)
    (*checker_ptr).contests = add_result.0
    let contest_ty = ty_contest(knowledge_inner(ann_ty), add_result.1)
    (*checker_ptr).env = (*checker_ptr).env.bind(contest_name, contest_ty, false)
    (*checker_ptr).error_count == 0 && (*checker_ptr).env.lookup(contest_name).kind == TypeKind::TyContest
}

fn kb_seed_contest_with_relative_band(checker: Checker, name: Name, policy_id: i64, value: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = kb_seed_contest_for_policy(checker, name, policy_id)
    let contest_ty = c.env.lookup(name)
    if contest_ty.epistemic_meta_id >= 0 && contest_ty.epistemic_meta_id < c.contests.count {
        var info = c.contests.get(contest_ty.epistemic_meta_id)
        info = contest_info_set_metric(info, CONTEST_METRIC_RELATIVE_BAND, value)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = info
    }
    c
}

