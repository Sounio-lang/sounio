    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    kb_seed_contest_with_full_witnesses_mut(checker_ptr, contest_name, policy_ty.epistemic_meta_id)
    let contest_ty = (*checker_ptr).env.lookup(contest_name)
    let ty = checker_check_contest_witness_names_mut(checker_ptr, witness_name, contest_name, Span::dummy())
    if (*checker_ptr).error_count > 0 || ty.kind != TypeKind::TyNamed || !name_eq(ty.name, kb_name_from_str("ContestDisagreement")) {
        return false
    }
    let ok = (*checker_ptr).mechanistic_reports.count == 1 &&
        (*checker_ptr).posterior_weights.count == 1 &&
        (*checker_ptr).counterexamples.count == 1 &&
        (*checker_ptr).contest_witnesses.count == 1 &&
        (*checker_ptr).contest_witnesses.get(0).contest_id == contest_ty.epistemic_meta_id &&
        (*checker_ptr).contest_witnesses.get(0).witness_kind == 5
    ok
}

