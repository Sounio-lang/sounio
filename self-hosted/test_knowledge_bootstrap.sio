fn kb_test_admit_action_records_decision_certificate() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let decision_name = kb_make_name2(100, 112)
    let value_name = kb_make_name(118, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    kb_seed_relative_band_decision_policy_mut(checker_ptr, decision_name, CompareOp::CmpLe, 0.15)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    let decision_ty = (*checker_ptr).env.lookup(decision_name)
    kb_seed_contest_with_relative_band_mut(checker_ptr, contest_name, policy_ty.epistemic_meta_id, 0.10)
    kb_bind_i64_value_mut(checker_ptr, value_name, 1)
    let robust_ty = checker_prove_robust_names_mut(checker_ptr, contest_name, policy_name, Span::dummy())
    let ty = checker_admit_action_names_mut(checker_ptr, value_name, robust_ty, decision_name, Span::dummy())
    if (*checker_ptr).error_count > 0 || ty.kind != TypeKind::TyAdmissible || (*checker_ptr).robust_proofs.count != 1 || (*checker_ptr).decision_certificates.count != 1 {
        return false
    }
    let cert = (*checker_ptr).decision_certificates.get(0)
    cert.robust_proof_id == 0 &&
    cert.decision_policy_id == decision_ty.epistemic_meta_id &&
    cert.inner_ty.kind == TypeKind::TyI64 &&
    cert.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    cert.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

