fn kb_test_commit_alternative_records_transition_plan_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
    let policy_name = kb_name_from_str("tp")
    let protocol_name = kb_name_from_str("proto")
    let value_name = kb_make_name(118, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_transition_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.05, 2)
    kb_seed_alternative_option_mut(checker_ptr, option_name, 45, 0.04)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    let option_ty = (*checker_ptr).env.lookup(option_name)
    kb_seed_transition_protocol_mut(checker_ptr, protocol_name, option_ty.epistemic_meta_id, policy_ty.epistemic_meta_id, 45)
    kb_bind_i64_value_mut(checker_ptr, value_name, 50)
    let ty = checker_commit_alternative_names_mut(checker_ptr, value_name, option_name, protocol_name, Span::dummy())
    if (*checker_ptr).error_count > 0
        || ty.kind != TypeKind::TyTransitionPlan
        || (*checker_ptr).transition_plans.count != 1 {
        return false
    }
    let plan = (*checker_ptr).transition_plans.get(0)
    let ok = plan.transition_policy_id == policy_ty.epistemic_meta_id &&
        plan.transition_protocol_id == 0 &&
        plan.alternative_option_id == option_ty.epistemic_meta_id &&
        plan.step_count == 2 &&
        ty.epistemic_meta_id == 0 &&
        (*checker_ptr).transition_policies.count == 1 &&
        (*checker_ptr).transition_protocols.count == 1 &&
        (*checker_ptr).transition_steps.count == 2 &&
        (*checker_ptr).transition_plans.count == 1
    ok
}

