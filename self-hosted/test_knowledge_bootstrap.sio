    checker_init_in_place(checker_ptr)
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    kb_seed_contest_with_relative_band_mut(checker_ptr, contest_name, policy_ty.epistemic_meta_id, 0.10)
    kb_seed_validation_policy_mut(checker_ptr, validation_name)
    let validation_ty = (*checker_ptr).env.lookup(validation_name)
    let robust_ty = checker_prove_robust_names_mut(checker_ptr, contest_name, policy_name, Span::dummy())
    let ty = kb_validate_manifest_name_mut(checker_ptr, robust_ty, validation_name)
    if (*checker_ptr).error_count > 0 || ty.kind != TypeKind::TyValidated || (*checker_ptr).validated_manifests.count != 1 || (*checker_ptr).robust_proofs.count != 1 {
        return false
    }
    let manifest_info = (*checker_ptr).validated_manifests.get(0)
    manifest_info.robust_proof_id == 0 &&
    manifest_info.validation_id == validation_ty.epistemic_meta_id &&
    manifest_info.inner_ty.kind == TypeKind::TyI64 &&
    ty.epistemic_meta_id == 0
}

fn kb_test_check_result_to_ir_epistemic() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let validation_name = kb_make_name(118, 0, 0, 1)
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    kb_seed_contest_with_relative_band_mut(checker_ptr, contest_name, policy_ty.epistemic_meta_id, 0.10)
    kb_seed_validation_policy_mut(checker_ptr, validation_name)
    let robust_ty = checker_prove_robust_names_mut(checker_ptr, contest_name, policy_name, Span::dummy())
    let validated_ty = kb_validate_manifest_name_mut(checker_ptr, robust_ty, validation_name)
    if (*checker_ptr).error_count > 0 || validated_ty.kind != TypeKind::TyValidated {
        return false
    }
    let contest_info = (*checker_ptr).contests.get(0)
    let proof_info = (*checker_ptr).robust_proofs.get(0)
    let manifest_info = (*checker_ptr).validated_manifests.get(0)
    let ok = (*checker_ptr).policies.count == 1 &&
        (*checker_ptr).contests.count == 1 &&
        (*checker_ptr).robust_proofs.count == 1 &&
        (*checker_ptr).validated_manifests.count == 1 &&
        contest_info.policy_id == 0 &&
        proof_info.contest_id == 0 &&
        manifest_info.robust_proof_id == 0 &&
        manifest_info.validation_id == 0
    ok
}

fn kb_test_full_arity_contest_realizes_single_entry() -> bool with Mut, Panic, Div, Alloc, IO {
    let family_name = kb_make_name(70, 97, 109, 3)  // "Fam"
    let policy_name = kb_make_name(80, 111, 108, 3)  // "Pol"
    let data_name = kb_make_name(100, 97, 116, 3)  // "dat"
    let contest_name = kb_make_name(99, 111, 110, 3)  // "con"
    let checker_ptr = heap_alloc(8388608) as *mut Checker
    checker_init_in_place(checker_ptr)
    (*checker_ptr).complexity_budget = 0
    kb_seed_relative_band_policy_mut(checker_ptr, policy_name, CompareOp::CmpLe, 0.15)
    kb_seed_named_model_family_mut(checker_ptr, family_name)
    kb_bind_i64_value_mut(checker_ptr, data_name, 1)
    let contest_te = kb_contest_type_expr3(
        kb_named_type3(105, 54, 52),
        kb_named_type3(70, 97, 109),
        kb_named_type3(80, 111, 108),
    )
    let ann_ty = checker_lower_contest_type_mut(checker_ptr, contest_te.type_args, contest_te.span)
    let init_ty = checker_check_contest_expr_expected_mut(checker_ptr, kb_contest_expr(data_name), ann_ty)
    (*checker_ptr).env = (*checker_ptr).env.bind(contest_name, init_ty, false)
    let ty = (*checker_ptr).env.lookup(contest_name)
    let family_ty = (*checker_ptr).env.lookup(family_name)
    let policy_ty = (*checker_ptr).env.lookup(policy_name)
    (*checker_ptr).error_count == 0 &&
    ty.kind == TypeKind::TyContest &&
    (*checker_ptr).contests.count == 1 &&
    ty.epistemic_meta_id == 0 &&
    (*checker_ptr).contests.get(0).family_id == family_ty.epistemic_meta_id &&
    (*checker_ptr).contests.get(0).policy_id == policy_ty.epistemic_meta_id
}

