fn kb_test_prove_robust_records_proof() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    var checker = checker_new()
    checker = kb_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kb_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let contest_ty = checker.env.lookup(contest_name)
    let expr = kb_call_expr2(prove_name, kb_ident_expr(contest_name), kb_ident_expr(policy_name))
    let pair = checker.check_expr(expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyRobust || checked.robust_proofs.count != 1 {
        return false
    }
    let proof_info = checked.robust_proofs.get(0)
    proof_info.contest_id == contest_ty.epistemic_meta_id &&
    proof_info.policy_id == policy_ty.epistemic_meta_id &&
    proof_info.level_id == ROBUST_LEVEL_STABLE &&
    proof_info.scope_id == ROBUST_SCOPE_IN_DISTRIBUTION &&
    proof_info.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    proof_info.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

fn kb_test_validate_manifest_records_manifest() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let validation_name = kb_make_name(118, 0, 0, 1)
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let validate_name = kb_make_name17(118, 97, 108, 105, 100, 97, 116, 101, 95, 109, 97, 110, 105, 102, 101, 115, 116)
    var checker = checker_new()
    checker = kb_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kb_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    checker = kb_seed_validation_policy(checker, validation_name)
    let validation_ty = checker.env.lookup(validation_name)
    let robust_expr = kb_call_expr2(prove_name, kb_ident_expr(contest_name), kb_ident_expr(policy_name))
    let validate_expr = kb_call_expr2(validate_name, robust_expr, kb_ident_expr(validation_name))
    let pair = checker.check_expr(validate_expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyValidated || checked.validated_manifests.count != 1 || checked.robust_proofs.count != 1 {
        return false
    }
    let manifest_info = checked.validated_manifests.get(0)
    manifest_info.robust_proof_id == 0 &&
    manifest_info.validation_id == validation_ty.epistemic_meta_id &&
    manifest_info.inner_ty.kind == TypeKind::TyI64 &&
    ty.epistemic_meta_id == 0
}

