fn kb_test_admit_action_records_decision_certificate() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let decision_name = kb_make_name2(100, 112)
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let admit_name = kb_name_from_str("admit_action")
    var checker = checker_new()
    checker = kb_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kb_seed_relative_band_decision_policy(checker, decision_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    let decision_ty = checker.env.lookup(decision_name)
    checker = kb_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let robust_expr = kb_call_expr2(prove_name, kb_ident_expr(contest_name), kb_ident_expr(policy_name))
    let admit_expr = kb_call_expr3(admit_name, kb_int_expr(1), robust_expr, kb_ident_expr(decision_name))
    let pair = checker.check_expr(admit_expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyAdmissible || checked.robust_proofs.count != 1 || checked.decision_certificates.count != 1 {
        return false
    }
    let cert = checked.decision_certificates.get(0)
    cert.robust_proof_id == 0 &&
    cert.decision_policy_id == decision_ty.epistemic_meta_id &&
    cert.inner_ty.kind == TypeKind::TyI64 &&
    cert.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    cert.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

