fn kb_validate_manifest_name_mut(checker_ptr: *mut Checker, robust_ty: TypeEntry, validation_name: Name) -> TypeEntry with Mut, Panic, Div, Alloc {
    let validation_ty = (*checker_ptr).env.lookup(validation_name)
    if robust_ty.kind != TypeKind::TyRobust || validation_ty.kind != TypeKind::TyValidation {
        checker_note_type_error_mut(checker_ptr)
        return ty_error()
    }
    let inner_ty = knowledge_inner(robust_ty)
    if !types_compatible(inner_ty, knowledge_inner(validation_ty)) {
        checker_note_type_error_mut(checker_ptr)
        return ty_error()
    }
    if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= (*checker_ptr).robust_proofs.count {
        checker_note_type_error_mut(checker_ptr)
        return ty_error()
    }
    let proof_info = (*checker_ptr).robust_proofs.get(robust_ty.epistemic_meta_id)
    let manifest_info = ValidatedManifestInfo {
        span_start: 0,
        span_end: 0,
        audit_id: proof_info.audit_id,
        robust_proof_id: robust_ty.epistemic_meta_id,
        validation_id: validation_ty.epistemic_meta_id,
        inner_ty: inner_ty,
    }
    let add_result = (*checker_ptr).validated_manifests.add(manifest_info)
    (*checker_ptr).validated_manifests = add_result.0
    ty_validated_with_policy(inner_ty, -1.0, add_result.1)
}

fn kb_contest_expr(data_name: Name) -> Expr with Alloc, Mut, Panic, Div {
    let model_a = kb_ident_expr(kb_make_name2(77, 49))
    let model_b = kb_ident_expr(kb_make_name2(77, 50))
    let models = Some(Box::new(ExprList {
        label: kb_make_name(0, 0, 0, 0),
        head: model_a,
        tail: Some(Box::new(ExprList { label: kb_make_name(0, 0, 0, 0), head: model_b, tail: None })),
    }))
    Expr {
        kind: ExprKind::ExprContest,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: kb_make_name(0, 0, 0, 0),
        path: kb_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: Some(Box::new(kb_ident_expr(data_name))),
        right: None,
        block: None,
        else_expr: None,
        args: models,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}

