fn kb_test_defer_action_records_deferred_certificate() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let deferral_name = kb_make_name2(100, 102)
    let defer_name = kb_name_from_str("defer_action")
    var checker = checker_new()
    checker = kb_seed_empty_policy(checker, policy_name)
    checker = kb_seed_relative_band_deferral_policy(checker, deferral_name, CompareOp::CmpGe, 0.20)
    let policy_ty = checker.env.lookup(policy_name)
    let deferral_ty = checker.env.lookup(deferral_name)
    checker = kb_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.25)
    let expr = kb_call_expr3(defer_name, kb_int_expr(1), kb_ident_expr(contest_name), kb_ident_expr(deferral_name))
    let pair = checker.check_expr(expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyDeferred || checked.deferred_certificates.count != 1 {
        return false
    }
    let cert = checked.deferred_certificates.get(0)
    cert.deferral_policy_id == deferral_ty.epistemic_meta_id &&
    cert.evidence_kind == DEFERRAL_EVIDENCE_CONTEST &&
    cert.contest_id == 0 &&
    cert.robust_proof_id == -1 &&
    cert.reason_code == DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT &&
    ty.epistemic_meta_id == 0
}

fn kb_test_deferral_reason_records_witness_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kb_make_name(99, 0, 0, 1)
    let policy_name = kb_make_name(112, 0, 0, 1)
    let deferral_name = kb_name_from_str("df")
    let prove_name = kb_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let defer_name = kb_name_from_str("defer_action")
    let reason_name = kb_name_from_str("deferral_reason")
    var checker = checker_new()
    checker = kb_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kb_seed_relative_band_deferral_policy(checker, deferral_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    let deferral_ty = checker.env.lookup(deferral_name)
    checker = kb_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let robust_expr = kb_call_expr2(prove_name, kb_ident_expr(contest_name), kb_ident_expr(policy_name))
    let defer_expr = kb_call_expr3(defer_name, kb_int_expr(1), robust_expr, kb_ident_expr(deferral_name))
    let pair = checker.check_expr(kb_call_expr1(reason_name, defer_expr))
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0
        || ty.kind != TypeKind::TyNamed
        || !name_eq(ty.name, kb_name_from_str("DeferralReason"))
        || checked.deferred_certificates.count != 1
        || checked.deferred_reason_witnesses.count != 1 {
        return false
    }
    let cert = checked.deferred_certificates.get(0)
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    let ok = cert.deferral_policy_id == deferral_ty.epistemic_meta_id &&
        cert.evidence_kind == DEFERRAL_EVIDENCE_ROBUST &&
        cert.robust_proof_id == 0 &&
        ep.deferral_policy_count == 1 &&
        ep.deferred_certificate_count == 1 &&
        ep.deferred_reason_witness_count == 1 &&
        ep.deferred_certificates[0].deferral_policy_id == 0
    ok
}

