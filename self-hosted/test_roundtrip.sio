// Roundtrip tests: source → lex → parse → buf_print → re-lex → compare token kinds
//
// 6 test vectors verifying the lex→parse→print→re-lex pipeline preserves
// the TokenKind sequence. Text/spans may differ but kinds must match.
//
// Depends on: lexer/, parser/, printer/buffer_print.sio

// ============================================================================
// HELPERS
// ============================================================================

fn rt_lex(input: [i8; 256], len: i64) -> LexerState with Mut, Div, Panic {
    var source: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < len {
        source[i as usize] = input[i as usize]
        i = i + 1
    }
    lex(source, len, 0)
}

fn rt_compare(input: [i8; 256], len: i64) -> bool with Mut, Div, Panic, IO, Alloc {
    // Step 1: lex original source
    let state1 = rt_lex(input, len)

    // Step 2: parse tokens into AST
    let prog = parse_program(state1.tokens, state1.token_count)

    // Step 3: print AST to buffer
    let pb = bp_program(prog)

    // Step 4: expand buffer to 1MB for lex() and re-lex
    var source2: [i8; 1048576] = [0; 1048576]
    var j: i64 = 0
    while j < pb.len {
        source2[j as usize] = pb.data[j as usize]
        j = j + 1
    }
    let state2 = lex(source2, pb.len, 0)

    // Step 5: compare token kinds (excluding trailing Eof)
    let count1 = state1.token_count - 1
    let count2 = state2.token_count - 1
    if count1 != count2 {
        print("  roundtrip: count mismatch ")
        print_int(count1)
        print(" vs ")
        print_int(count2)
        print("\n")
        return false
    }

    var i: i64 = 0
    while i < count1 {
        if !(state1.tokens[i as usize].kind == state2.tokens[i as usize].kind) {
            print("  roundtrip: kind mismatch at token ")
            print_int(i)
            print("\n")
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// R01: fn f() -> i64 { 42 }
// Minimal function roundtrip
// ============================================================================
fn roundtrip_test_01() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "fn f() -> i64 { 42 }"
    input[0] = 102    // f
    input[1] = 110    // n
    input[2] = 32     // ' '
    input[3] = 102    // f
    input[4] = 40     // (
    input[5] = 41     // )
    input[6] = 32     // ' '
    input[7] = 45     // -
    input[8] = 62     // >
    input[9] = 32     // ' '
    input[10] = 105   // i
    input[11] = 54    // 6
    input[12] = 52    // 4
    input[13] = 32    // ' '
    input[14] = 123   // {
    input[15] = 32    // ' '
    input[16] = 52    // 4
    input[17] = 50    // 2
    input[18] = 32    // ' '
    input[19] = 125   // }
    rt_compare(input, 20)
}

// ============================================================================
// R02: struct S { x: i64, y: f64 }
// Struct declaration roundtrip
// ============================================================================
fn roundtrip_test_02() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "struct S { x: i64, y: f64 }"
    input[0] = 115    // s
    input[1] = 116    // t
    input[2] = 114    // r
    input[3] = 117    // u
    input[4] = 99     // c
    input[5] = 116    // t
    input[6] = 32     // ' '
    input[7] = 83     // S
    input[8] = 32     // ' '
    input[9] = 123    // {
    input[10] = 32    // ' '
    input[11] = 120   // x
    input[12] = 58    // :
    input[13] = 32    // ' '
    input[14] = 105   // i
    input[15] = 54    // 6
    input[16] = 52    // 4
    input[17] = 44    // ,
    input[18] = 32    // ' '
    input[19] = 121   // y
    input[20] = 58    // :
    input[21] = 32    // ' '
    input[22] = 102   // f
    input[23] = 54    // 6
    input[24] = 52    // 4
    input[25] = 32    // ' '
    input[26] = 125   // }
    rt_compare(input, 27)
}

// ============================================================================
// R03: enum E { A, B, C }
// Enum declaration roundtrip
// ============================================================================
fn roundtrip_test_03() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "enum E { A, B, C }"
    input[0] = 101    // e
    input[1] = 110    // n
    input[2] = 117    // u
    input[3] = 109    // m
    input[4] = 32     // ' '
    input[5] = 69     // E
    input[6] = 32     // ' '
    input[7] = 123    // {
    input[8] = 32     // ' '
    input[9] = 65     // A
    input[10] = 44    // ,
    input[11] = 32    // ' '
    input[12] = 66    // B
    input[13] = 44    // ,
    input[14] = 32    // ' '
    input[15] = 67    // C
    input[16] = 32    // ' '
    input[17] = 125   // }
    rt_compare(input, 18)
}

// ============================================================================
// R04: fn f(x: i64) -> bool { x > 0 }
// Params + binary expr roundtrip
// ============================================================================
fn roundtrip_test_04() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "fn f(x: i64) -> bool { x > 0 }"
    input[0] = 102    // f
    input[1] = 110    // n
    input[2] = 32     // ' '
    input[3] = 102    // f
    input[4] = 40     // (
    input[5] = 120    // x
    input[6] = 58     // :
    input[7] = 32     // ' '
    input[8] = 105    // i
    input[9] = 54     // 6
    input[10] = 52    // 4
    input[11] = 41    // )
    input[12] = 32    // ' '
    input[13] = 45    // -
    input[14] = 62    // >
    input[15] = 32    // ' '
    input[16] = 98    // b
    input[17] = 111   // o
    input[18] = 111   // o
    input[19] = 108   // l
    input[20] = 32    // ' '
    input[21] = 123   // {
    input[22] = 32    // ' '
    input[23] = 120   // x
    input[24] = 32    // ' '
    input[25] = 62    // >
    input[26] = 32    // ' '
    input[27] = 48    // 0
    input[28] = 32    // ' '
    input[29] = 125   // }
    rt_compare(input, 30)
}

// ============================================================================
// R05: fn g() { let x: i64 = 10 + 20 }
// Let statement roundtrip (wrapped in function)
// ============================================================================
fn roundtrip_test_05() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "fn g() { let x: i64 = 10 + 20 }"
    input[0] = 102    // f
    input[1] = 110    // n
    input[2] = 32     // ' '
    input[3] = 103    // g
    input[4] = 40     // (
    input[5] = 41     // )
    input[6] = 32     // ' '
    input[7] = 123    // {
    input[8] = 32     // ' '
    input[9] = 108    // l
    input[10] = 101   // e
    input[11] = 116   // t
    input[12] = 32    // ' '
    input[13] = 120   // x
    input[14] = 58    // :
    input[15] = 32    // ' '
    input[16] = 105   // i
    input[17] = 54    // 6
    input[18] = 52    // 4
    input[19] = 32    // ' '
    input[20] = 61    // =
    input[21] = 32    // ' '
    input[22] = 49    // 1
    input[23] = 48    // 0
    input[24] = 32    // ' '
    input[25] = 43    // +
    input[26] = 32    // ' '
    input[27] = 50    // 2
    input[28] = 48    // 0
    input[29] = 32    // ' '
    input[30] = 125   // }
    rt_compare(input, 31)
}

// ============================================================================
// R06: Multi-item: fn + struct
// Full program roundtrip
// ============================================================================
fn roundtrip_test_06() -> bool with Mut, Div, Panic, IO, Alloc {
    var input: [i8; 256] = [0; 256]
    // "fn f() -> i64 { 1 }\nstruct S { x: i64 }"
    // Line 1: fn f() -> i64 { 1 }
    input[0] = 102    // f
    input[1] = 110    // n
    input[2] = 32     // ' '
    input[3] = 102    // f
    input[4] = 40     // (
    input[5] = 41     // )
    input[6] = 32     // ' '
    input[7] = 45     // -
    input[8] = 62     // >
    input[9] = 32     // ' '
    input[10] = 105   // i
    input[11] = 54    // 6
    input[12] = 52    // 4
    input[13] = 32    // ' '
    input[14] = 123   // {
    input[15] = 32    // ' '
    input[16] = 49    // 1
    input[17] = 32    // ' '
    input[18] = 125   // }
    input[19] = 10    // \n
    // Line 2: struct S { x: i64 }
    input[20] = 115   // s
    input[21] = 116   // t
    input[22] = 114   // r
    input[23] = 117   // u
    input[24] = 99    // c
    input[25] = 116   // t
    input[26] = 32    // ' '
    input[27] = 83    // S
    input[28] = 32    // ' '
    input[29] = 123   // {
    input[30] = 32    // ' '
    input[31] = 120   // x
    input[32] = 58    // :
    input[33] = 32    // ' '
    input[34] = 105   // i
    input[35] = 54    // 6
    input[36] = 52    // 4
    input[37] = 32    // ' '
    input[38] = 125   // }
    rt_compare(input, 39)
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_roundtrip_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== Roundtrip Tests ===\n")

    total = total + 1
    if roundtrip_test_01() { passed = passed + 1; print("  R01 OK: fn roundtrip\n") }
    else { print("  FAIL: R01 fn roundtrip\n") }

    total = total + 1
    if roundtrip_test_02() { passed = passed + 1; print("  R02 OK: struct roundtrip\n") }
    else { print("  FAIL: R02 struct roundtrip\n") }

    total = total + 1
    if roundtrip_test_03() { passed = passed + 1; print("  R03 OK: enum roundtrip\n") }
    else { print("  FAIL: R03 enum roundtrip\n") }

    total = total + 1
    if roundtrip_test_04() { passed = passed + 1; print("  R04 OK: params + binexpr roundtrip\n") }
    else { print("  FAIL: R04 params + binexpr roundtrip\n") }

    total = total + 1
    if roundtrip_test_05() { passed = passed + 1; print("  R05 OK: let stmt roundtrip\n") }
    else { print("  FAIL: R05 let stmt roundtrip\n") }

    total = total + 1
    if roundtrip_test_06() { passed = passed + 1; print("  R06 OK: multi-item roundtrip\n") }
    else { print("  FAIL: R06 multi-item roundtrip\n") }

    if passed == total {
        print("ALL ROUNDTRIP TESTS PASSED\n")
    }

    if passed == total { 0 } else { 1 }
}
