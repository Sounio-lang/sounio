// Emit tests

fn emit_test_01_opcode_tags() -> bool {
    emt_opcode_tag(IrOpcode::IrLoadImm) == 1 && emt_opcode_tag(IrOpcode::IrCall) == 8 && emt_opcode_tag(IrOpcode::IrPhi) == 20
}

fn emit_test_02_binop_tags() -> bool {
    emt_binop_tag(BinaryOp::OpAdd) == 1 && emt_binop_tag(BinaryOp::OpConcat) == 19
}

fn emit_test_03_unop_tags() -> bool {
    emt_unop_tag(UnaryOp::OpNeg) == 1 && emt_unop_tag(UnaryOp::OpDeref) == 5
}

fn emit_test_04_emit_empty_module() -> bool with IO, Mut, Panic, Div, Alloc {
    let m = ir_empty_module()
    emit_module(m)
    true
}

fn emit_test_05_emit_simple_main() -> bool with IO, Mut, Panic, Div, Alloc {
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(irt_int_expr(1))))
    let m = irt_lower_prog1(main)
    emit_module(m)
    m.fn_count == 1
}

fn emit_test_06_emit_if() -> bool with IO, Mut, Panic, Div, Alloc {
    let then_blk = irt_block1(irt_stmt_expr(irt_int_expr(1)))
    let ife = irt_if_expr(irt_bool_expr(true), then_blk, irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(ife)))
    let m = irt_lower_prog1(main)
    emit_module(m)
    let f = ir_fn_get(&m, 0)
    irt_count_opcode(f, IrOpcode::IrBranchFalse) >= 1
}

fn emit_test_07_emit_call_args() -> bool with IO, Mut, Panic, Div, Alloc {
    let foo = irt_fn_item(irt_name3(102, 111, 111), None, irt_block1(irt_stmt_expr(irt_int_expr(0))))
    let args = Some(Box::new(ExprList { head: irt_int_expr(7), tail: None }))
    let call = irt_call_expr(irt_ident_expr(irt_name3(102, 111, 111)), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))
    let m = irt_lower_prog2(main, foo)
    emit_module(m)
    let f = ir_fn_get(&m, irt_find_fn(m, irt_name4(109, 97, 105, 110)))
    irt_has_call_argc(f, 1)
}

fn emit_test_08_emit_while() -> bool with IO, Mut, Panic, Div, Alloc {
    let w = irt_while_expr(irt_bool_expr(true), irt_block1(irt_stmt_expr(irt_break_expr(irt_int_expr(0)))))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(w)))
    let m = irt_lower_prog1(main)
    emit_module(m)
    let f = ir_fn_get(&m, 0)
    irt_count_opcode(f, IrOpcode::IrJump) >= 1
}

fn emit_test_09_emit_method_call() -> bool with IO, Mut, Panic, Div, Alloc {
    let p = irt_name1(112)
    let getx = irt_name5(103, 101, 116, 95, 120)
    let sf = StructFieldInit { name: irt_name1(120), value: irt_int_expr(1) }
    let sl = Some(Box::new(StructFieldList { head: sf, tail: None }))
    let s1 = irt_stmt_let(p, irt_struct_lit(irt_single_path3(80, 116, 0), sl))
    let me = Expr {
        kind: ExprKind::ExprMethodCall,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: getx,
        path: irt_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: Some(Box::new(irt_ident_expr(p))),
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, irt_stmt_expr(me)))
    let m = irt_lower_prog1(main)
    emit_module(m)
    let f = ir_fn_get(&m, 0)
    irt_has_call_argc(f, 1)
}

fn emit_test_10_emit_string_load() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = irt_name3(97, 98, 99)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(irt_string_expr(s))))
    let m = irt_lower_prog1(main)
    emit_module(m)
    let f = ir_fn_get(&m, 0)
    irt_count_opcode(f, IrOpcode::IrLoadString) >= 1
}

fn run_emit_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== Emit Tests ===\n")
    emit_set_silent(true)

    total = total + 1
    if emit_test_01_opcode_tags() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01\n") }
    total = total + 1
    if emit_test_02_binop_tags() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02\n") }
    total = total + 1
    if emit_test_03_unop_tags() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03\n") }
    total = total + 1
    if emit_test_04_emit_empty_module() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04\n") }
    total = total + 1
    if emit_test_05_emit_simple_main() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05\n") }
    total = total + 1
    if emit_test_06_emit_if() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06\n") }
    total = total + 1
    if emit_test_07_emit_call_args() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07\n") }
    total = total + 1
    if emit_test_08_emit_while() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08\n") }
    total = total + 1
    if emit_test_09_emit_method_call() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09\n") }
    total = total + 1
    if emit_test_10_emit_string_load() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10\n") }

    emit_set_silent(false)
    if passed == total { print("Emit tests: all passed\n") } else { print("Emit tests: suite fail\n") }

    if passed == total { 0 } else { 1 }
}
