// Self-hosted Metal MSL codegen tests
//
// Validates type mapping (gpu_type_to_msl), parameter type mapping,
// memory space qualifiers, header emission, and full kernel lowering
// for all arithmetic op types.

// ── Type Mapping ────────────────────────────────────────────────────

fn metal_test_01_type_f32() -> bool {
    gpu_type_to_msl(GpuType::GpuF32) == "float"
}

fn metal_test_02_type_f64() -> bool {
    gpu_type_to_msl(GpuType::GpuF64) == "double"
}

fn metal_test_03_type_i32() -> bool {
    gpu_type_to_msl(GpuType::GpuI32) == "int"
}

fn metal_test_04_type_i64() -> bool {
    gpu_type_to_msl(GpuType::GpuI64) == "long"
}

fn metal_test_05_type_u32() -> bool {
    gpu_type_to_msl(GpuType::GpuU32) == "uint"
}

fn metal_test_06_type_u64() -> bool {
    gpu_type_to_msl(GpuType::GpuU64) == "ulong"
}

fn metal_test_07_type_ptr() -> bool {
    gpu_type_to_msl(GpuType::GpuPtr) == "device void*"
}

// ── Parameter Type Mapping ──────────────────────────────────────────

fn metal_test_08_param_f32() -> bool {
    gpu_type_to_msl_param(GpuType::GpuF32) == "device float*"
}

fn metal_test_09_param_f64() -> bool {
    gpu_type_to_msl_param(GpuType::GpuF64) == "device double*"
}

fn metal_test_10_param_i32() -> bool {
    gpu_type_to_msl_param(GpuType::GpuI32) == "device int*"
}

fn metal_test_11_param_i64() -> bool {
    gpu_type_to_msl_param(GpuType::GpuI64) == "device long*"
}

fn metal_test_12_param_u32() -> bool {
    gpu_type_to_msl_param(GpuType::GpuU32) == "device uint*"
}

fn metal_test_13_param_u64() -> bool {
    gpu_type_to_msl_param(GpuType::GpuU64) == "device ulong*"
}

fn metal_test_14_param_ptr() -> bool {
    gpu_type_to_msl_param(GpuType::GpuPtr) == "device void*"
}

// ── Memory Space Qualifiers ─────────────────────────────────────────

fn metal_test_15_memspace_global() -> bool {
    gpu_memspace_to_msl(GpuMemorySpace::GpuMemGlobal) == "device"
}

fn metal_test_16_memspace_shared() -> bool {
    gpu_memspace_to_msl(GpuMemorySpace::GpuMemShared) == "threadgroup"
}

fn metal_test_17_memspace_constant() -> bool {
    gpu_memspace_to_msl(GpuMemorySpace::GpuMemConstant) == "constant"
}

fn metal_test_18_memspace_local() -> bool {
    gpu_memspace_to_msl(GpuMemorySpace::GpuMemLocal) == "thread"
}

// ── Header Emission ─────────────────────────────────────────────────

fn metal_test_19_header_include() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(metal_emit_header(metal_buf_new()))
    ptx_str_contains(s, "#include <metal_stdlib>")
}

fn metal_test_20_header_using_namespace() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(metal_emit_header(metal_buf_new()))
    ptx_str_contains(s, "using namespace metal;")
}

fn metal_test_21_header_exact() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(metal_emit_header(metal_buf_new()))
    s == "#include <metal_stdlib>\nusing namespace metal;\n\n"
}

// ── MetalBuf Operations ─────────────────────────────────────────────

fn metal_test_22_buf_new_len() -> bool {
    let b = metal_buf_new()
    b.len == 0
}

fn metal_test_23_buf_push_str() -> bool with Mut, Panic, Div, Alloc {
    var b = metal_buf_new()
    b = metal_push_str(b, "hello")
    b.len == 5
}

fn metal_test_24_buf_to_string() -> bool with Mut, Panic, Div, Alloc {
    var b = metal_buf_new()
    b = metal_push_str(b, "test")
    let s = metal_to_string(b)
    s == "test"
}

fn metal_test_25_buf_push_i64() -> bool with Mut, Panic, Div, Alloc {
    var b = metal_buf_new()
    b = metal_push_i64(b, 42)
    let s = metal_to_string(b)
    s == "42"
}

// ── Full Kernel Lowering: vec_add f32 ───────────────────────────────

fn metal_test_26_vec_add_kernel_void() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_ir()))
    ptx_str_contains(s, "kernel void")
}

fn metal_test_27_vec_add_entry() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_ir()))
    ptx_str_contains(s, "vec_add")
}

fn metal_test_28_vec_add_thread_position() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_ir()))
    ptx_str_contains(s, "thread_position_in_grid")
}

fn metal_test_29_vec_add_buffer_attr() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_ir()))
    ptx_str_contains(s, "[[buffer(0)]]") &&
    ptx_str_contains(s, "[[buffer(1)]]")
}

fn metal_test_30_vec_add_includes_header() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_ir()))
    ptx_str_contains(s, "#include <metal_stdlib>")
}

// ── Type-specific Kernels ───────────────────────────────────────────

fn metal_test_31_vec_add_f64() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_f64_ir()))
    ptx_str_contains(s, "double")
}

fn metal_test_32_vec_add_i32() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_add_i32_ir()))
    ptx_str_contains(s, "int")
}

fn metal_test_33_vec_sub_f32() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_sub_f32_ir()))
    ptx_str_contains(s, "kernel void") &&
    ptx_str_contains(s, "vec_sub")
}

fn metal_test_34_vec_mul_f32() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_mul_f32_ir()))
    ptx_str_contains(s, "kernel void") &&
    ptx_str_contains(s, "vec_mul")
}

fn metal_test_35_vec_div_f32() -> bool with Mut, Panic, Div, Alloc {
    let s = metal_to_string(gpu_lower_to_metal(gpu_build_vec_div_f32_ir()))
    ptx_str_contains(s, "kernel void") &&
    ptx_str_contains(s, "vec_div")
}

// ── Runner ──────────────────────────────────────────────────────────

fn run_gpu_metal_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU Metal MSL Tests ===\n")

    total = total + 1
    if metal_test_01_type_f32() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 f32\n") }
    total = total + 1
    if metal_test_02_type_f64() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02 f64\n") }
    total = total + 1
    if metal_test_03_type_i32() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03 i32\n") }
    total = total + 1
    if metal_test_04_type_i64() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04 i64\n") }
    total = total + 1
    if metal_test_05_type_u32() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 u32\n") }
    total = total + 1
    if metal_test_06_type_u64() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 u64\n") }
    total = total + 1
    if metal_test_07_type_ptr() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 ptr\n") }
    total = total + 1
    if metal_test_08_param_f32() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 p_f32\n") }
    total = total + 1
    if metal_test_09_param_f64() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 p_f64\n") }
    total = total + 1
    if metal_test_10_param_i32() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 p_i32\n") }
    total = total + 1
    if metal_test_11_param_i64() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 p_i64\n") }
    total = total + 1
    if metal_test_12_param_u32() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 p_u32\n") }
    total = total + 1
    if metal_test_13_param_u64() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 p_u64\n") }
    total = total + 1
    if metal_test_14_param_ptr() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14 p_ptr\n") }
    total = total + 1
    if metal_test_15_memspace_global() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15 global\n") }
    total = total + 1
    if metal_test_16_memspace_shared() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16 shared\n") }
    total = total + 1
    if metal_test_17_memspace_constant() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 const\n") }
    total = total + 1
    if metal_test_18_memspace_local() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 local\n") }
    total = total + 1
    if metal_test_19_header_include() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 include\n") }
    total = total + 1
    if metal_test_20_header_using_namespace() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20 using\n") }
    total = total + 1
    if metal_test_21_header_exact() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21 header\n") }
    total = total + 1
    if metal_test_22_buf_new_len() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22 buf new\n") }
    total = total + 1
    if metal_test_23_buf_push_str() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23 push str\n") }
    total = total + 1
    if metal_test_24_buf_to_string() { passed = passed + 1; print("  T24 OK\n") } else { print("  FAIL T24 to_str\n") }
    total = total + 1
    if metal_test_25_buf_push_i64() { passed = passed + 1; print("  T25 OK\n") } else { print("  FAIL T25 push i64\n") }
    total = total + 1
    if metal_test_26_vec_add_kernel_void() { passed = passed + 1; print("  T26 OK\n") } else { print("  FAIL T26 kernel\n") }
    total = total + 1
    if metal_test_27_vec_add_entry() { passed = passed + 1; print("  T27 OK\n") } else { print("  FAIL T27 entry\n") }
    total = total + 1
    if metal_test_28_vec_add_thread_position() { passed = passed + 1; print("  T28 OK\n") } else { print("  FAIL T28 tid\n") }
    total = total + 1
    if metal_test_29_vec_add_buffer_attr() { passed = passed + 1; print("  T29 OK\n") } else { print("  FAIL T29 buffer\n") }
    total = total + 1
    if metal_test_30_vec_add_includes_header() { passed = passed + 1; print("  T30 OK\n") } else { print("  FAIL T30 hdr\n") }
    total = total + 1
    if metal_test_31_vec_add_f64() { passed = passed + 1; print("  T31 OK\n") } else { print("  FAIL T31 f64 k\n") }
    total = total + 1
    if metal_test_32_vec_add_i32() { passed = passed + 1; print("  T32 OK\n") } else { print("  FAIL T32 i32 k\n") }
    total = total + 1
    if metal_test_33_vec_sub_f32() { passed = passed + 1; print("  T33 OK\n") } else { print("  FAIL T33 sub\n") }
    total = total + 1
    if metal_test_34_vec_mul_f32() { passed = passed + 1; print("  T34 OK\n") } else { print("  FAIL T34 mul\n") }
    total = total + 1
    if metal_test_35_vec_div_f32() { passed = passed + 1; print("  T35 OK\n") } else { print("  FAIL T35 div\n") }

    if passed == total {
        print("GPU Metal: all 35 passed\n")
    } else {
        print("GPU Metal: FAILED\n")
    }
    if passed == total { 0 } else { 1 }
}
