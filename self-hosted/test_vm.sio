// VM end-to-end tests

fn vmt_i64_type() -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: irt_single_path3(105, 54, 52),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn vmt_param(name: Name) -> Param with Mut, Panic, Div {
    Param {
        name: name,
        ty: vmt_i64_type(),
        is_self: false,
        is_self_mut: false,
        span: Span::dummy(),
    }
}

fn vmt_print_int_name() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 9 }
    n.buf[0] = 112
    n.buf[1] = 114
    n.buf[2] = 105
    n.buf[3] = 110
    n.buf[4] = 116
    n.buf[5] = 95
    n.buf[6] = 105
    n.buf[7] = 110
    n.buf[8] = 116
    n
}

fn vmt_name_from_string(s: string) -> Name with Mut, Panic, Div {
    let slen = str_len(s)
    var n = Name { buf: [0; 384], len: slen }
    var i: i64 = 0
    while i < slen && i < 128 {
        n.buf[i] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

fn vmt_block3(a: Stmt, b: Stmt, c: Stmt) -> Block with Alloc {
    Block {
        stmts: Some(Box::new(StmtList {
            head: a,
            tail: Some(Box::new(StmtList {
                head: b,
                tail: Some(Box::new(StmtList { head: c, tail: None })),
            })),
        })),
        span: Span::dummy(),
    }
}

fn vm_test_01_arith() -> bool with Mut, Panic, Div, Alloc, IO {
    let e = irt_bin_expr(irt_int_expr(1), BinaryOp::OpAdd, irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(e)))
    let m = irt_lower_prog1(main)
    run_module(m) == 3
}

fn vm_test_02_if_else() -> bool with Mut, Panic, Div, Alloc, IO {
    let then_blk = irt_block1(irt_stmt_expr(irt_int_expr(7)))
    let ife = irt_if_expr(irt_bool_expr(true), then_blk, irt_int_expr(9))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(ife)))
    let m = irt_lower_prog1(main)
    run_module(m) == 7
}

fn vm_test_03_while_counter() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = irt_name1(120)
    let init = irt_stmt_var(x, irt_int_expr(0))

    let cond = irt_bin_expr(irt_ident_expr(x), BinaryOp::OpLt, irt_int_expr(3))
    let inc = irt_stmt_assign(irt_ident_expr(x), irt_bin_expr(irt_ident_expr(x), BinaryOp::OpAdd, irt_int_expr(1)))
    let w = irt_while_expr(cond, irt_block1(inc))

    let body = vmt_block3(init, irt_stmt_expr(w), irt_stmt_expr(irt_ident_expr(x)))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, body)
    let m = irt_lower_prog1(main)
    run_module(m) == 3
}

fn vm_test_04_fn_call() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = vmt_param(irt_name1(120))
    let y = vmt_param(irt_name1(121))
    let params = Some(Box::new(ParamList { head: x, tail: Some(Box::new(ParamList { head: y, tail: None })) }))
    let add_body = irt_block1(irt_stmt_expr(irt_bin_expr(irt_ident_expr(irt_name1(120)), BinaryOp::OpAdd, irt_ident_expr(irt_name1(121)))))
    let add_fn = irt_fn_item(irt_name3(97, 100, 100), params, add_body)

    let args = Some(Box::new(ExprList {
        head: irt_int_expr(2),
        tail: Some(Box::new(ExprList { head: irt_int_expr(3), tail: None })),
    }))
    let call = irt_call_expr(irt_ident_expr(irt_name3(97, 100, 100)), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))

    let m = irt_lower_prog2(main, add_fn)
    run_module(m) == 5
}

fn vm_test_05_builtin_print_int() -> bool with Mut, Panic, Div, Alloc, IO {
    let print_name = vmt_print_int_name()
    let args = Some(Box::new(ExprList { head: irt_int_expr(5), tail: None }))
    let call = irt_call_expr(irt_ident_expr(print_name), args)
    let body = irt_block2(irt_stmt_expr(call), irt_stmt_expr(irt_int_expr(0)))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, body)
    let m = irt_lower_prog1(main)
    run_module(m) == 0
}

fn vm_test_06_loop_break() -> bool with Mut, Panic, Div, Alloc, IO {
    let lp = irt_loop_expr(irt_block1(irt_stmt_expr(irt_break_expr(irt_int_expr(11)))))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(lp)))
    let m = irt_lower_prog1(main)
    run_module(m) == 11 || run_module(m) == 0
}

fn vm_test_07_fn_call_3_args() -> bool with Mut, Panic, Div, Alloc, IO {
    let a = vmt_param(irt_name1(97))  // a
    let b = vmt_param(irt_name1(98))  // b
    let c = vmt_param(irt_name1(99))  // c
    let params = Some(Box::new(ParamList {
        head: a,
        tail: Some(Box::new(ParamList {
            head: b,
            tail: Some(Box::new(ParamList { head: c, tail: None })),
        })),
    }))

    let add_ab = irt_bin_expr(irt_ident_expr(irt_name1(97)), BinaryOp::OpAdd, irt_ident_expr(irt_name1(98)))
    let add_abc = irt_bin_expr(add_ab, BinaryOp::OpAdd, irt_ident_expr(irt_name1(99)))
    let add_body = irt_block1(irt_stmt_expr(add_abc))
    let add_fn = irt_fn_item(vmt_name_from_string("add3"), params, add_body)

    let args = Some(Box::new(ExprList {
        head: irt_int_expr(2),
        tail: Some(Box::new(ExprList {
            head: irt_int_expr(3),
            tail: Some(Box::new(ExprList { head: irt_int_expr(4), tail: None })),
        })),
    }))
    let call = irt_call_expr(irt_ident_expr(vmt_name_from_string("add3")), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))

    let m = irt_lower_prog2(main, add_fn)
    run_module(m) == 9
}

fn vm_test_08_float_arith_eq() -> bool with Mut, Panic, Div, Alloc, IO {
    // Return 1 if (1.5 + 2.25) == 3.75 else 0.
    let sum = irt_bin_expr(irt_float_expr(1.5), BinaryOp::OpAdd, irt_float_expr(2.25))
    let eq = irt_bin_expr(sum, BinaryOp::OpEq, irt_float_expr(3.75))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(eq)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn vm_test_09_array_runtime_index() -> bool with Mut, Panic, Div, Alloc, IO {
    let a = irt_name1(97) // a
    let elems = Some(Box::new(ExprList {
        head: irt_int_expr(1),
        tail: Some(Box::new(ExprList {
            head: irt_int_expr(2),
            tail: Some(Box::new(ExprList { head: irt_int_expr(3), tail: None })),
        })),
    }))
    let s1 = irt_stmt_let(a, irt_array_lit(elems))
    let s2 = irt_stmt_expr(irt_index_expr(irt_ident_expr(a), irt_int_expr(1)))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, s2))
    let m = irt_lower_prog1(main)
    run_module(m) == 2
}

fn vm_test_10_struct_runtime_field() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = irt_name1(120) // x
    let p = irt_name1(112) // p
    let sf = StructFieldInit { name: x, value: irt_int_expr(7) }
    let sl = Some(Box::new(StructFieldList { head: sf, tail: None }))
    let s1 = irt_stmt_let(p, irt_struct_lit(irt_single_path3(80, 116, 0), sl))
    let s2 = irt_stmt_expr(irt_field_expr(irt_ident_expr(p), x))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, s2))
    let m = irt_lower_prog1(main)
    run_module(m) == 7
}

fn vm_test_11_quat_conj_norm_property() -> bool with Mut, Panic, Div, Alloc, IO {
    // Check: ||q * conj(q)||^2 == (||q||^2)^2
    let q_args = Some(Box::new(ExprList {
        head: irt_float_expr(1.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(2.0),
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(3.0),
                tail: Some(Box::new(ExprList { head: irt_float_expr(4.0), tail: None })),
            })),
        })),
    }))
    let q = irt_call_expr(irt_ident_expr(vmt_name_from_string("quat")), q_args)
    let q_conj_args = Some(Box::new(ExprList { head: q, tail: None }))
    let qc = irt_call_expr(irt_ident_expr(vmt_name_from_string("quat_conj")), q_conj_args)
    let mul_args = Some(Box::new(ExprList { head: q, tail: Some(Box::new(ExprList { head: qc, tail: None })) }))
    let p = irt_call_expr(irt_ident_expr(vmt_name_from_string("quat_mul")), mul_args)

    let n2_args = Some(Box::new(ExprList { head: q, tail: None }))
    let n2 = irt_call_expr(irt_ident_expr(vmt_name_from_string("quat_norm_sq")), n2_args)

    let pn2_args = Some(Box::new(ExprList { head: p, tail: None }))
    let pn2 = irt_call_expr(irt_ident_expr(vmt_name_from_string("quat_norm_sq")), pn2_args)

    let rhs = irt_bin_expr(n2, BinaryOp::OpMul, n2)
    let eq = irt_bin_expr(pn2, BinaryOp::OpEq, rhs)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(eq)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn vm_test_12_oct_non_associative() -> bool with Mut, Panic, Div, Alloc, IO {
    // Basis triple (e1, e2, e4) has non-zero associator in octonions:
    // (a*b)*c != a*(b*c).
    let a = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(1.0),
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0),
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0),
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),
                                tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let b = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0),
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(1.0),
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0),
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),
                                tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let c = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0),
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0),
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(1.0),
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),
                                tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))

    let ab = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_mul")), Some(Box::new(ExprList {
        head: a,
        tail: Some(Box::new(ExprList { head: b, tail: None })),
    })))
    let left = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_mul")), Some(Box::new(ExprList {
        head: ab,
        tail: Some(Box::new(ExprList { head: c, tail: None })),
    })))

    let bc = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_mul")), Some(Box::new(ExprList {
        head: b,
        tail: Some(Box::new(ExprList { head: c, tail: None })),
    })))
    let right = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_mul")), Some(Box::new(ExprList {
        head: a,
        tail: Some(Box::new(ExprList { head: bc, tail: None })),
    })))

    let diff = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_sub")), Some(Box::new(ExprList {
        head: left,
        tail: Some(Box::new(ExprList { head: right, tail: None })),
    })))
    let n2 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_norm_sq")), Some(Box::new(ExprList {
        head: diff,
        tail: None,
    })))

    // For this triple, associator has magnitude 2, so norm_sq = 4.
    let eq = irt_bin_expr(n2, BinaryOp::OpEq, irt_float_expr(4.0))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(eq)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn vm_test_13_sed_zero_divisor_exact() -> bool with Mut, Panic, Div, Alloc, IO {
    // Known zero divisors (in this Cayley-Dickson convention):
    // x = e1 + e10, y = e4 - e15 => x*y == 0.
    let x = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),  // e0
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(1.0),  // e1
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0),  // e2
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),  // e3
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0),  // e4
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),  // e5
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),  // e6
                                tail: Some(Box::new(ExprList {
                                    head: irt_float_expr(0.0),  // e7
                                    tail: Some(Box::new(ExprList {
                                        head: irt_float_expr(0.0),  // e8
                                        tail: Some(Box::new(ExprList {
                                            head: irt_float_expr(0.0),  // e9
                                            tail: Some(Box::new(ExprList {
                                                head: irt_float_expr(1.0),  // e10
                                                tail: Some(Box::new(ExprList {
                                                    head: irt_float_expr(0.0),  // e11
                                                    tail: Some(Box::new(ExprList {
                                                        head: irt_float_expr(0.0),  // e12
                                                        tail: Some(Box::new(ExprList {
                                                            head: irt_float_expr(0.0),  // e13
                                                            tail: Some(Box::new(ExprList {
                                                                head: irt_float_expr(0.0),  // e14
                                                                tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),  // e15
                                                            })),
                                                        })),
                                                    })),
                                                })),
                                            })),
                                        })),
                                    })),
                                })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let y = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),  // e0
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0),  // e1
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0),  // e2
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),  // e3
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(1.0),  // e4
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),  // e5
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),  // e6
                                tail: Some(Box::new(ExprList {
                                    head: irt_float_expr(0.0),  // e7
                                    tail: Some(Box::new(ExprList {
                                        head: irt_float_expr(0.0),  // e8
                                        tail: Some(Box::new(ExprList {
                                            head: irt_float_expr(0.0),  // e9
                                            tail: Some(Box::new(ExprList {
                                                head: irt_float_expr(0.0),  // e10
                                                tail: Some(Box::new(ExprList {
                                                    head: irt_float_expr(0.0),  // e11
                                                    tail: Some(Box::new(ExprList {
                                                        head: irt_float_expr(0.0),  // e12
                                                        tail: Some(Box::new(ExprList {
                                                            head: irt_float_expr(0.0),  // e13
                                                            tail: Some(Box::new(ExprList {
                                                                head: irt_float_expr(0.0),  // e14
                                                                tail: Some(Box::new(ExprList { head: irt_float_expr(-1.0), tail: None })),  // e15
                                                            })),
                                                        })),
                                                    })),
                                                })),
                                            })),
                                        })),
                                    })),
                                })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))

    let is_zd = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed_is_zero_divisor_exact")), Some(Box::new(ExprList {
        head: x,
        tail: None,
    })))
    let prod = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed_mul")), Some(Box::new(ExprList {
        head: x,
        tail: Some(Box::new(ExprList { head: y, tail: None })),
    })))
    let prod_n2 = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed_norm_sq")), Some(Box::new(ExprList {
        head: prod,
        tail: None,
    })))

    // Return 1 iff (is_zd == true) && (norm_sq(x*y) == 0).
    let prod_zero = irt_bin_expr(prod_n2, BinaryOp::OpEq, irt_float_expr(0.0))
    let both = irt_bin_expr(is_zd, BinaryOp::OpAnd, prod_zero)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(both)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn vm_test_14_oct_linear_fwd_simple() -> bool with Mut, Panic, Div, Alloc, IO {
    // in=2, out=1
    // weights = [1,2], bias=[5], x=[3,4] (all purely real octonions)
    // y = 1*3 + 2*4 + 5 = 16 => norm_sq(y) = 256
    let w0 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(1.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let w1 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(2.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let b0 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(5.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let x0 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(3.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let x1 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct")), Some(Box::new(ExprList {
        head: irt_float_expr(4.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))

    let weights = irt_array_lit(Some(Box::new(ExprList { head: w0, tail: Some(Box::new(ExprList { head: w1, tail: None })) })))
    let biases = irt_array_lit(Some(Box::new(ExprList { head: b0, tail: None })))
    let x = irt_array_lit(Some(Box::new(ExprList { head: x0, tail: Some(Box::new(ExprList { head: x1, tail: None })) })))

    let call_args = Some(Box::new(ExprList {
        head: weights,
        tail: Some(Box::new(ExprList {
            head: biases,
            tail: Some(Box::new(ExprList {
                head: x,
                tail: Some(Box::new(ExprList {
                    head: irt_int_expr(2), // in_size
                    tail: Some(Box::new(ExprList {
                        head: irt_int_expr(1), // out_size
                        tail: Some(Box::new(ExprList { head: irt_int_expr(0), tail: None })), // activation
                    })),
                })),
            })),
        })),
    }))

    let out = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_linear_fwd")), call_args)
    let out0 = irt_index_expr(out, irt_int_expr(0))
    let n2 = irt_call_expr(irt_ident_expr(vmt_name_from_string("oct_norm_sq")), Some(Box::new(ExprList { head: out0, tail: None })))
    let eq = irt_bin_expr(n2, BinaryOp::OpEq, irt_float_expr(256.0))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(eq)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn vm_test_15_sed_linear_fwd_regularizes_zero_divisor() -> bool with Mut, Panic, Div, Alloc, IO {
    // Build a zero divisor input x = e1 + e10. With weights=[1], bias=[0],
    // weighted = x (zero divisor). With zd_epsilon=1.0, kernel should return
    // x + 1*identity, which is NOT a zero divisor (exact rank 16 in our convention).
    let one = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed")), Some(Box::new(ExprList {
        head: irt_float_expr(1.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                                                        })),
                                                    })),
                                                })),
                                            })),
                                        })),
                                    })),
                                })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))
    let zero = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                    head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                        head: irt_float_expr(0.0), tail: Some(Box::new(ExprList {
                                                            head: irt_float_expr(0.0), tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                                                        })),
                                                    })),
                                                })),
                                            })),
                                        })),
                                    })),
                                })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))

    let x = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed")), Some(Box::new(ExprList {
        head: irt_float_expr(0.0),
        tail: Some(Box::new(ExprList {
            head: irt_float_expr(1.0),
            tail: Some(Box::new(ExprList {
                head: irt_float_expr(0.0),
                tail: Some(Box::new(ExprList {
                    head: irt_float_expr(0.0),
                    tail: Some(Box::new(ExprList {
                        head: irt_float_expr(0.0),
                        tail: Some(Box::new(ExprList {
                            head: irt_float_expr(0.0),
                            tail: Some(Box::new(ExprList {
                                head: irt_float_expr(0.0),
                                tail: Some(Box::new(ExprList {
                                    head: irt_float_expr(0.0),
                                    tail: Some(Box::new(ExprList {
                                        head: irt_float_expr(0.0),
                                        tail: Some(Box::new(ExprList {
                                            head: irt_float_expr(0.0),
                                            tail: Some(Box::new(ExprList {
                                                head: irt_float_expr(1.0),
                                                tail: Some(Box::new(ExprList {
                                                    head: irt_float_expr(0.0),
                                                    tail: Some(Box::new(ExprList {
                                                        head: irt_float_expr(0.0),
                                                        tail: Some(Box::new(ExprList {
                                                            head: irt_float_expr(0.0),
                                                            tail: Some(Box::new(ExprList {
                                                                head: irt_float_expr(0.0),
                                                                tail: Some(Box::new(ExprList { head: irt_float_expr(0.0), tail: None })),
                                                            })),
                                                        })),
                                                    })),
                                                })),
                                            })),
                                        })),
                                    })),
                                })),
                            })),
                        })),
                    })),
                })),
            })),
        })),
    })))

    let weights = irt_array_lit(Some(Box::new(ExprList { head: one, tail: None })))
    let biases = irt_array_lit(Some(Box::new(ExprList { head: zero, tail: None })))
    let xs = irt_array_lit(Some(Box::new(ExprList { head: x, tail: None })))

    let call_args = Some(Box::new(ExprList {
        head: weights,
        tail: Some(Box::new(ExprList {
            head: biases,
            tail: Some(Box::new(ExprList {
                head: xs,
                tail: Some(Box::new(ExprList {
                    head: irt_int_expr(1), // in_size
                    tail: Some(Box::new(ExprList {
                        head: irt_int_expr(1), // out_size
                        tail: Some(Box::new(ExprList {
                            head: irt_int_expr(0), // activation
                            tail: Some(Box::new(ExprList { head: irt_float_expr(1.0), tail: None })), // zd_epsilon
                        })),
                    })),
                })),
            })),
        })),
    }))
    let out = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed_linear_fwd")), call_args)
    let out0 = irt_index_expr(out, irt_int_expr(0))

    let is_zd = irt_call_expr(irt_ident_expr(vmt_name_from_string("sed_is_zero_divisor_exact")), Some(Box::new(ExprList {
        head: out0,
        tail: None,
    })))
    let not_zd = irt_un_expr(UnaryOp::OpNot, is_zd)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(not_zd)))
    let m = irt_lower_prog1(main)
    run_module(m) == 1
}

fn run_vm_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== VM Tests ===\n")
    vm_set_io_silent(true)

    total = total + 1
    if vm_test_01_arith() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01\n") }
    total = total + 1
    if vm_test_02_if_else() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02\n") }
    total = total + 1
    if vm_test_03_while_counter() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03\n") }
    total = total + 1
    if vm_test_04_fn_call() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04\n") }
    total = total + 1
    if vm_test_05_builtin_print_int() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05\n") }
    total = total + 1
    if vm_test_06_loop_break() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06\n") }
    total = total + 1
    if vm_test_07_fn_call_3_args() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07\n") }
    total = total + 1
    if vm_test_08_float_arith_eq() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08\n") }
    total = total + 1
    if vm_test_09_array_runtime_index() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09\n") }
    total = total + 1
    if vm_test_10_struct_runtime_field() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10\n") }
    total = total + 1
    if vm_test_11_quat_conj_norm_property() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11\n") }
    total = total + 1
    if vm_test_12_oct_non_associative() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12\n") }
    total = total + 1
    if vm_test_13_sed_zero_divisor_exact() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13\n") }
    total = total + 1
    if vm_test_14_oct_linear_fwd_simple() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14\n") }
    total = total + 1
    if vm_test_15_sed_linear_fwd_regularizes_zero_divisor() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15\n") }

    vm_set_io_silent(false)
    if passed == total { print("VM tests: all passed\n") } else { print("VM tests: suite fail\n") }

    if passed == total { 0 } else { 1 }
}
