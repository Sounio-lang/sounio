// self-hosted::ir::opt_strategy — IR-level dual-path for Instrumented strategy
//
// Sprint 40: Extends the HLIR dual-path (hlir/opt_strategy.sio) to work on the
// flat IrFunction instruction array used by the native x86-64 backend.
//
// Contest<T>/Robust<T> functions carrying IR_STRATEGY_INSTRUMENTED (3) are
// transformed into a 4-block diamond (four_block_diamond) layout:
//
//   dispatch_block: IrLabel(dispatch_label) + load __validated + IrBranchTrue(fast) + IrJump(instr)
//   fast_path:      original instrs, IrReturn rewritten to IrJump(merge_label)
//   instrumented_path: IrLabel(instr_label) + cloned instrs (vreg+label offset) + IrJump(merge_label)
//   merge_block:    IrLabel(merge_label) + IrReturn
//
// Mirrors hlir_opt_apply_strategy() in hlir/opt_strategy.sio but operates on the
// flat IrFunction (no block abstraction) used by the native backend.
//
// vreg_offset  = ir_opt_max_vreg(func) + 1   (instrumented locals above original)
// label_offset = ir_opt_max_label(func) + 1   (instrumented labels above original)
// dispatch_label = label_offset
// instr_label    = label_offset + 1
// merge_label    = label_offset + 2

module ir::opt_strategy

use ir::ir::*

// ============================================================================
// Remapping helpers — parallel to hlir_opt_remap_value / hlir_opt_remap_block
// ============================================================================

// Remap a virtual register ID for the instrumented path.
// Parameters (vreg < param_count) are shared between paths and stay unchanged.
// Local vregs (vreg >= param_count) receive vreg_offset to give the instrumented
// copy a disjoint range.
fn ir_opt_remap_vreg(vreg: i64, vreg_offset: i64, param_count: i64) -> i64 {
    if vreg < 0 { return vreg }
    if vreg < param_count { return vreg }
    vreg + vreg_offset
}

// Remap a label ID for the instrumented path.
// All labels receive label_offset so the two CFG copies have disjoint label IDs.
fn ir_opt_remap_label(label_id: i64, label_offset: i64) -> i64 {
    if label_id < 0 { return label_id }
    label_id + label_offset
}

// ============================================================================
// Max-ID scan helpers — determine remapping offsets
// ============================================================================

// Scan the flat instruction array for the maximum vreg ID used (dst, src1, src2).
// Returns -1 if no valid vregs found.
fn ir_opt_max_vreg(func: IrFunction) -> i64 {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.dst > max_id { max_id = instr.dst }
        if instr.src1 > max_id { max_id = instr.src1 }
        if instr.src2 > max_id { max_id = instr.src2 }
        i = i + 1
    }
    max_id
}

// Scan the flat instruction array for the maximum label_id (IrLabel, IrJump, IrBranch*).
// Returns -1 if no labels found.
fn ir_opt_max_label(func: IrFunction) -> i64 {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.label_id > max_id { max_id = instr.label_id }
        i = i + 1
    }
    max_id
}

// ============================================================================
// Instruction cloning — parallel to hlir_opt_clone_instr
// ============================================================================

// Clone one IrInstr, remapping virtual registers (dst, src1, src2) and label IDs
// for the instrumented path.  All other fields (bin_op, imm_*, fn_id, etc.) are
// preserved unchanged.  call_args Box is shared (dual-path functions are
// arithmetic-heavy; call cloning deferred to Sprint 41).
fn ir_opt_clone_instr(
    instr: IrInstr,
    vreg_offset: i64,
    label_offset: i64,
    param_count: i64
) -> IrInstr {
    IrInstr {
        op:        instr.op,
        dst:       ir_opt_remap_vreg(instr.dst, vreg_offset, param_count),
        src1:      ir_opt_remap_vreg(instr.src1, vreg_offset, param_count),
        src2:      ir_opt_remap_vreg(instr.src2, vreg_offset, param_count),
        imm_i64:   instr.imm_i64,
        imm_f64:   instr.imm_f64,
        label_id:  ir_opt_remap_label(instr.label_id, label_offset),
        fn_id:     instr.fn_id,
        field_idx: instr.field_idx,
        imm_flags: instr.imm_flags,
        bin_op:    instr.bin_op,
        un_op:     instr.un_op,
        name:      instr.name,
        call_args: instr.call_args,
        arg_count: instr.arg_count,
    }
}

// ============================================================================
// Main transformation — ir_opt_apply_strategy
// ============================================================================

// Helper: append one instruction to the output array and advance the count.
// Mutating in place avoids copying the entire fixed-size instruction buffer
// on every append during the dual-path rewrite.
fn ir_opt_append(
    instrs: &! [IrInstr; 128],
    count: i64,
    instr: IrInstr
) -> i64 with Mut {
    if count < 128 {
        (*instrs)[count as usize] = instr
    }
    count + 1
}

// Scan flat IrFunction for the first IrReturn and return its src1 (the result vreg).
// Returns 0 as fallback if no IrReturn is found (functions with no explicit return).
// Used by ir_opt_apply_strategy() to determine what vreg to return from the merge_block.
fn ir_opt_find_return_vreg(func: IrFunction) -> i64 {
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.op == IrOpcode::IrReturn {
            return instr.src1
        }
        i = i + 1
    }
    0
}

// Transform a flat IrFunction into the 4-block diamond layout required by the
// Instrumented strategy.  The result has the same name/params/compile_strategy
// as the input but a new instrs[] and instr_count covering all four blocks.
//
// Layout in output instrs[]:
//   --- dispatch_block ---
//   IrLabel(dispatch_label)
//   IrBranchTrue(param_regs[0], fast_label=0)     // param 0 = __validated flag
//   IrJump(instr_label)
//   --- fast_path ---
//   <original instrs; IrReturn → IrJump(merge_label)>
//   IrJump(merge_label)                            // fallthrough guard
//   --- instrumented_path ---
//   IrLabel(instr_label)
//   <cloned instrs (vreg+label offset); IrReturn → IrJump(merge_label)>
//   IrJump(merge_label)                            // fallthrough guard
//   --- merge_block ---
//   IrLabel(merge_label)
//   IrReturn(merge_result_vreg)                    // actual result vreg from original IrReturn.src1
//
fn ir_opt_apply_strategy(func: IrFunction) -> IrFunction with Mut {
    let vreg_offset  = ir_opt_max_vreg(func) + 1
    let label_offset = ir_opt_max_label(func) + 1

    // New label IDs beyond the original maximum — dispatch_label, instr_label, merge_label
    let dispatch_label = label_offset
    let instr_label    = label_offset + 1
    let merge_label    = label_offset + 2

    // Build the output instruction sequence
    var out_instrs: [IrInstr; 128] = [ir_empty_instr(); 128]
    var out_count: i64 = 0

    // --- dispatch_block ---
    out_count = ir_opt_append(&! out_instrs, out_count, ir_label(dispatch_label))

    // Sprint 42: param_regs[0] is the hidden __validated param injected by
    // ir_lower_inject_validated_param() in ir/lower.sio before user params are lowered.
    // 1 → fast path (label 0), 0 → instrumented path (instr_label)
    let validated_vreg = func.param_regs[0]
    out_count = ir_opt_append(&! out_instrs, out_count, ir_branch_true(validated_vreg, 0))

    out_count = ir_opt_append(&! out_instrs, out_count, ir_jump(instr_label))

    // --- fast_path: original instructions; IrReturn → IrJump(merge_label) ---
    var fi: i64 = 0
    while fi < func.instr_count {
        var orig = func.instrs[fi as usize]
        if orig.op == IrOpcode::IrReturn {
            // Rewrite return to jump to merge block
            orig = ir_jump(merge_label)
        }
        out_count = ir_opt_append(&! out_instrs, out_count, orig)
        fi = fi + 1
    }
    // Fallthrough guard for fast path (in case original had no explicit return)
    out_count = ir_opt_append(&! out_instrs, out_count, ir_jump(merge_label))

    // --- instrumented_path: IrLabel + cloned instrs + IrJump ---
    out_count = ir_opt_append(&! out_instrs, out_count, ir_label(instr_label))

    // Sprint 44: inject profiling counter at instrumented path entry
    if func.prof_counter_id >= 0 {
        out_count = ir_opt_append(&! out_instrs, out_count, ir_prof_counter(func.prof_counter_id))
    }

    var ii: i64 = 0
    while ii < func.instr_count {
        var cloned = ir_opt_clone_instr(func.instrs[ii as usize], vreg_offset, label_offset, func.param_count)
        if cloned.op == IrOpcode::IrReturn {
            cloned = ir_jump(merge_label)
        }
        out_count = ir_opt_append(&! out_instrs, out_count, cloned)
        ii = ii + 1
    }
    // Fallthrough guard for instrumented path
    out_count = ir_opt_append(&! out_instrs, out_count, ir_jump(merge_label))

    // --- merge_block: IrLabel + IrReturn ---
    out_count = ir_opt_append(&! out_instrs, out_count, ir_label(merge_label))

    // Return the actual result vreg from the original function's IrReturn
    // (not hardcoded to vreg 0 — the result could be in any vreg).
    // ir_opt_find_return_vreg() scans for IrReturn.src1 in the original func.
    let merge_result_vreg = ir_opt_find_return_vreg(func)
    out_count = ir_opt_append(&! out_instrs, out_count, ir_return(merge_result_vreg))

    // Produce the transformed IrFunction
    // reg_count expanded to cover instrumented-path vregs (vreg_offset doubles the range)
    IrFunction {
        name:             func.name,
        instrs:           out_instrs,
        instr_count:      out_count,
        reg_count:        func.reg_count + vreg_offset,
        label_count:      func.label_count + 3,   // dispatch + instr + merge
        param_count:      func.param_count,
        param_regs:       func.param_regs,
        compile_strategy: func.compile_strategy,
        prof_counter_id: func.prof_counter_id,
    }
}
