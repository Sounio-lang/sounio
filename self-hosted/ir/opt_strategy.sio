// self-hosted::ir::opt_strategy — IR-level dual-path for Instrumented strategy
//
// Sprint 40: Extends the HLIR dual-path (hlir/opt_strategy.sio) to work on the
// flat IrFunction instruction array used by the native x86-64 backend.
//
// Contest<T>/Robust<T> functions carrying IR_STRATEGY_INSTRUMENTED (3) are
// transformed into a 4-block diamond (four_block_diamond) layout:
//
//   dispatch_block: IrLabel(dispatch_label) + load __validated + IrBranchTrue(fast) + IrJump(instr)
//   fast_path:      original instrs, IrReturn rewritten to IrJump(merge_label)
//   instrumented_path: IrLabel(instr_label) + cloned instrs (vreg+label offset) + IrJump(merge_label)
//   merge_block:    IrLabel(merge_label) + IrReturn
//
// Mirrors hlir_opt_apply_strategy() in hlir/opt_strategy.sio but operates on the
// flat IrFunction (no block abstraction) used by the native backend.
//
// vreg_offset  = ir_opt_max_vreg(func) + 1   (instrumented locals above original)
// label_offset = ir_opt_max_label(func) + 1   (instrumented labels above original)
// dispatch_label = label_offset
// instr_label    = label_offset + 1
// merge_label    = label_offset + 2

module ir::opt_strategy

use ir::ir::*

// ============================================================================
// Remapping helpers — parallel to hlir_opt_remap_value / hlir_opt_remap_block
// ============================================================================

// Remap a virtual register ID for the instrumented path.
// Parameters (vreg < param_count) are shared between paths and stay unchanged.
// Local vregs (vreg >= param_count) receive vreg_offset to give the instrumented
// copy a disjoint range.
pub fn ir_opt_remap_vreg(vreg: i64, vreg_offset: i64, param_count: i64) -> i64 {
    if vreg < 0 { return vreg }
    if vreg < param_count { return vreg }
    vreg + vreg_offset
}

// Remap a label ID for the instrumented path.
// All labels receive label_offset so the two CFG copies have disjoint label IDs.
pub fn ir_opt_remap_label(label_id: i64, label_offset: i64) -> i64 {
    if label_id < 0 { return label_id }
    label_id + label_offset
}

// ============================================================================
// Max-ID scan helpers — determine remapping offsets
// ============================================================================

// Scan the flat instruction array for the maximum vreg ID used (dst, src1, src2).
// Returns -1 if no valid vregs found.
pub fn ir_opt_max_vreg_ref(func: &IrFunction) -> i64 with Mut, Panic, Div {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < (*func).instr_count {
        let instr = ir_arena_load(ir_region_slot_r((*func).region, (i)))
        if instr.dst > max_id { max_id = instr.dst }
        if instr.src1 > max_id { max_id = instr.src1 }
        if instr.src2 > max_id { max_id = instr.src2 }
        i = i + 1
    }
    max_id
}

pub fn ir_opt_max_vreg(func: IrFunction) -> i64 with Mut, Panic, Div {
    ir_opt_max_vreg_ref(&func)
}

// Scan the flat instruction array for the maximum label_id (IrLabel, IrJump, IrBranch*).
// Returns -1 if no labels found.
pub fn ir_opt_max_label_ref(func: &IrFunction) -> i64 with Mut, Panic, Div {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < (*func).instr_count {
        let instr = ir_arena_load(ir_region_slot_r((*func).region, (i)))
        if instr.label_id > max_id { max_id = instr.label_id }
        i = i + 1
    }
    max_id
}

pub fn ir_opt_max_label(func: IrFunction) -> i64 with Mut, Panic, Div {
    ir_opt_max_label_ref(&func)
}

// ============================================================================
// Instruction cloning — parallel to hlir_opt_clone_instr
// ============================================================================

// Clone one IrInstr, remapping virtual registers (dst, src1, src2) and label IDs
// for the instrumented path.  All other fields (bin_op, imm_*, fn_id, etc.) are
// preserved unchanged.  call_args Box is shared (dual-path functions are
// arithmetic-heavy; call cloning deferred to Sprint 41).
pub fn ir_opt_clone_instr(
    instr: IrInstr,
    vreg_offset: i64,
    label_offset: i64,
    param_count: i64
) -> IrInstr {
    IrInstr {
        op:        instr.op,
        dst:       ir_opt_remap_vreg(instr.dst, vreg_offset, param_count),
        src1:      ir_opt_remap_vreg(instr.src1, vreg_offset, param_count),
        src2:      ir_opt_remap_vreg(instr.src2, vreg_offset, param_count),
        imm_i64:   instr.imm_i64,
        imm_f64:   instr.imm_f64,
        label_id:  ir_opt_remap_label(instr.label_id, label_offset),
        fn_id:     instr.fn_id,
        field_idx: instr.field_idx,
        imm_flags: instr.imm_flags,
        bin_op:    instr.bin_op,
        un_op:     instr.un_op,
        name_id: instr.name_id,
        call_args: instr.call_args,
        arg_count: instr.arg_count,
    }
}

// ============================================================================
// Main transformation — ir_opt_apply_strategy
// ============================================================================

// Helper: append one instruction to the output array and advance the count.
// Mutating in place avoids copying the entire fixed-size instruction buffer
// on every append during the dual-path rewrite.
// #1649: writes through the arena region, not an inline [IrInstr; 4096].
// IrFunction no longer HAS an inline instruction array. The reads in this file
// were converted; this write path was not, and `&! out.instrs` survived the
// build as `warning: unknown field access` rather than an error -- the checker
// rejects a value read of a missing field but only warns on a borrow of one.
// The resulting wild pointer crashed the self-test at T08 and took the
// remaining ~1140 tests with it.
pub fn ir_opt_append(
    region: IrInstrRegion,
    count: i64,
    instr: IrInstr
) -> i64 with Mut, Panic, Div {
    if count < IR_MAX_INSTRS {
        ir_arena_store(ir_region_slot_w(region, (count)), instr)
    }
    count + 1
}

pub fn ir_opt_apply_strategy_instrs_into(
    func: &IrFunction,
    out_region: IrInstrRegion,
    vreg_offset: i64,
    label_offset: i64,
    count: i64,
    merge_result_vreg: i64
) -> i64 with Mut, Panic, Div {
    let dispatch_label = label_offset
    let instr_label = label_offset + 1
    let merge_label = label_offset + 2

    var out_count = count
    out_count = ir_opt_append(out_region, out_count, ir_label(dispatch_label))
    out_count = ir_opt_append(out_region, out_count, ir_branch_true((*func).param_regs[0], 0))
    out_count = ir_opt_append(out_region, out_count, ir_jump(instr_label))

    var fi: i64 = 0
    while fi < (*func).instr_count {
        var orig = ir_arena_load(ir_region_slot_r((*func).region, (fi)))
        if orig.op == IrOpcode::IrReturn {
            orig = ir_jump(merge_label)
        }
        out_count = ir_opt_append(out_region, out_count, orig)
        fi = fi + 1
    }
    out_count = ir_opt_append(out_region, out_count, ir_jump(merge_label))
    out_count = ir_opt_append(out_region, out_count, ir_label(instr_label))

    if (*func).prof_counter_id >= 0 {
        out_count = ir_opt_append(out_region, out_count, ir_prof_counter((*func).prof_counter_id))
    }

    var ii: i64 = 0
    while ii < (*func).instr_count {
        var cloned = ir_opt_clone_instr(ir_arena_load(ir_region_slot_r((*func).region, (ii))), vreg_offset, label_offset, (*func).param_count)
        if cloned.op == IrOpcode::IrReturn {
            cloned = ir_jump(merge_label)
        }
        out_count = ir_opt_append(out_region, out_count, cloned)
        ii = ii + 1
    }
    out_count = ir_opt_append(out_region, out_count, ir_jump(merge_label))
    out_count = ir_opt_append(out_region, out_count, ir_label(merge_label))
    out_count = ir_opt_append(out_region, out_count, ir_return(merge_result_vreg))
    out_count
}

// Scan flat IrFunction for the first IrReturn and return its src1 (the result vreg).
// Returns 0 as fallback if no IrReturn is found (functions with no explicit return).
// Used by ir_opt_apply_strategy() to determine what vreg to return from the merge_block.
pub fn ir_opt_find_return_vreg_ref(func: &IrFunction) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*func).instr_count {
        let instr = ir_arena_load(ir_region_slot_r((*func).region, (i)))
        if instr.op == IrOpcode::IrReturn {
            return instr.src1
        }
        i = i + 1
    }
    0
}

pub fn ir_opt_find_return_vreg(func: IrFunction) -> i64 with Mut, Panic, Div {
    ir_opt_find_return_vreg_ref(&func)
}

// Transform a flat IrFunction into the 4-block diamond layout required by the
// Instrumented strategy. The transformed instruction stream is written through
// the fixed array reference, while scalar metadata is assigned locally before
// the final IrFunction is returned.
pub fn ir_opt_apply_strategy(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    let vreg_offset = ir_opt_max_vreg_ref(&func) + 1
    let label_offset = ir_opt_max_label_ref(&func) + 1
    let merge_result_vreg = ir_opt_find_return_vreg_ref(&func)

    var out = ir_empty_function()
    out.name = func.name
    out.reg_count = func.reg_count + vreg_offset
    out.label_count = func.label_count + 3
    out.param_count = func.param_count
    out.compile_strategy = func.compile_strategy
    out.prof_counter_id = func.prof_counter_id

    var pi: i64 = 0
    while pi < 64 {
        out.param_regs[pi as usize] = func.param_regs[pi as usize]
        pi = pi + 1
    }

    // The region cannot come from ir_empty_function(): it hands back
    // ir_region_invalid(), and a fresh module's slots would otherwise all share
    // one region. Allocate here, exactly as the lowerer does per function.
    ir_function_alloc_region(&! out)
    out.instr_count = ir_opt_apply_strategy_instrs_into(
        &func,
        out.region,
        vreg_offset,
        label_offset,
        0,
        merge_result_vreg
    )
    out
}

pub fn ir_opt_apply_strategy_box_ref(func: &IrFunction) -> Box<IrFunction> with Mut, Panic, Div, Alloc {
    Box::new(ir_opt_apply_strategy((*func)))
}

pub fn ir_opt_apply_strategy_box(func: IrFunction) -> Box<IrFunction> with Mut, Panic, Div, Alloc {
    Box::new(ir_opt_apply_strategy(func))
}

pub fn ir_opt_apply_strategy_into_ref(func: &IrFunction, out: &! IrFunction) with Mut, Panic, Div {
    let transformed = ir_opt_apply_strategy((*func))
    var i: i64 = 0
    while i < transformed.instr_count {
        ir_arena_copy_slot(ir_region_slot_w((*out).region, (i)),ir_region_slot_r(transformed.region, (i)))
        i = i + 1
    }
    var pi: i64 = 0
    while pi < 64 {
        (*out).param_regs[pi as usize] = transformed.param_regs[pi as usize]
        pi = pi + 1
    }
}
