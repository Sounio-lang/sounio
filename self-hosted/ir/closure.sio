fn test_free_var_set_empty() -> i64 with Mut, Panic, Div {
    let s = free_var_set_new()
    if s.count != 0 { return 1 }
    if free_var_contains(s, 42) { return 2 }
    0
}

fn test_free_var_add_and_contains() -> i64 with Mut, Panic, Div {
    var s = free_var_set_new()
    s = free_var_add(s, 10)
    s = free_var_add(s, 20)
    s = free_var_add(s, 30)
    if s.count != 3 { return 1 }
    if !free_var_contains(s, 10) { return 2 }
    if !free_var_contains(s, 20) { return 3 }
    if !free_var_contains(s, 30) { return 4 }
    if free_var_contains(s, 99) { return 5 }
    0
}

fn test_free_var_add_dedup() -> i64 with Mut, Panic, Div {
    var s = free_var_set_new()
    s = free_var_add(s, 5)
    s = free_var_add(s, 5)
    s = free_var_add(s, 5)
    if s.count != 1 { return 1 }
    0
}

fn test_free_var_remove() -> i64 with Mut, Panic, Div {
    var s = free_var_set_new()
    s = free_var_add(s, 1)
    s = free_var_add(s, 2)
    s = free_var_add(s, 3)
    let r = free_var_remove(s, 2)
    if r.count != 2 { return 1 }
    if free_var_contains(r, 2) { return 2 }
    if !free_var_contains(r, 1) { return 3 }
    if !free_var_contains(r, 3) { return 4 }
    0
}

fn test_free_var_union() -> i64 with Mut, Panic, Div {
    var a = free_var_set_new()
    a = free_var_add(a, 1)
    a = free_var_add(a, 2)
    var b = free_var_set_new()
    b = free_var_add(b, 2)
    b = free_var_add(b, 3)
    let u = free_var_union(a, b)
    if u.count != 3 { return 1 }
    if !free_var_contains(u, 1) { return 2 }
    if !free_var_contains(u, 2) { return 3 }
    if !free_var_contains(u, 3) { return 4 }
    0
}

fn test_free_var_difference() -> i64 with Mut, Panic, Div {
    var a = free_var_set_new()
    a = free_var_add(a, 1)
    a = free_var_add(a, 2)
    a = free_var_add(a, 3)
    var b = free_var_set_new()
    b = free_var_add(b, 2)
    let d = free_var_difference(a, b)
    if d.count != 2 { return 1 }
    if free_var_contains(d, 2) { return 2 }
    if !free_var_contains(d, 1) { return 3 }
    if !free_var_contains(d, 3) { return 4 }
    0
}

fn test_compute_free_vars_none() -> i64 with Mut, Panic, Div {
    // A function where all used registers are defined internally
    var func = ir_empty_function()
    func.reg_count = 3
    func.param_regs[0] = 0
    func.param_count = 1
    // dst=1, src1=0 (param), src2 not used (IR_INVALID_REG)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, 42))
    // dst=2, src1=1 (locally defined)
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(2))
    func.instr_count = 3

    let fv = compute_free_vars(func)
    if fv.count != 0 { return 1 }
    0
}

fn test_compute_free_vars_some() -> i64 with Mut, Panic, Div {
    // A function using registers 10 and 20 that are never defined
    var free_regs: [i64; 8] = [0; 8]
    free_regs[0] = 10
    free_regs[1] = 20
    let func = make_closure_func(free_regs, 2)
    let fv = compute_free_vars(func)
    // Registers 10 and 20 should be free (used as src but never defined)
    if fv.count != 2 { return 1 }
    if !free_var_contains(fv, 10) { return 2 }
    if !free_var_contains(fv, 20) { return 3 }
    0
}

fn test_closure_env_add_and_index() -> i64 with Mut, Panic, Div {
    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env = closure_env_add_capture(env, 20, 200)
    env = closure_env_add_capture(env, 30, 300)
    if env.count != 3 { return 1 }
    let i0 = closure_env_index_of(env, 10)
    if i0 != 0 { return 2 }
    let i1 = closure_env_index_of(env, 20)
    if i1 != 1 { return 3 }
    let i2 = closure_env_index_of(env, 30)
    if i2 != 2 { return 4 }
    let i3 = closure_env_index_of(env, 99)
    if i3 != 0 - 1 { return 5 }
    0
}

fn test_closure_env_dedup() -> i64 with Mut, Panic, Div {
    var env = closure_env_new()
    env = closure_env_add_capture(env, 5, 50)
    env = closure_env_add_capture(env, 5, 50)
    env = closure_env_add_capture(env, 5, 50)
    if env.count != 1 { return 1 }
    0
}

fn test_closure_table_new() -> i64 with Mut, Panic, Div {
    let t = closure_table_new()
    if t.count != 0 { return 1 }
    let idx = closure_table_lookup(t, 0)
    if idx != 0 - 1 { return 2 }
    0
}

fn test_closure_table_add_lookup() -> i64 with Mut, Panic, Div {
    var t = closure_table_new()
    var info = closure_info_new()
    info.original_fn_id = 42
    info.lifted_fn_id = 100
    info.is_closure = 1
    t = closure_table_add(t, info)
    if t.count != 1 { return 1 }
    let idx = closure_table_lookup(t, 42)
    if idx != 0 { return 2 }
    let miss = closure_table_lookup(t, 99)
    if miss != 0 - 1 { return 3 }
    0
}

fn test_closure_convert_no_free() -> i64 with Mut, Panic, Div {
    // A function with no free variables should not be marked as closure
    var func = ir_empty_function()
    func.reg_count = 2
    func.param_regs[0] = 0
    func.param_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, 99))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))
    func.instr_count = 2

    let parent_scope = free_var_set_new()
    let table = closure_table_new()
    let pair = closure_convert_function(func, parent_scope, table)
    let converted = pair.0
    let new_table = pair.1

    // Should be unmodified (no env param added)
    if converted.param_count != 1 { return 1 }
    // Table should have one entry with is_closure = 0
    if new_table.count != 1 { return 2 }
    if new_table.closures[0].is_closure != 0 { return 3 }
    0
}

fn test_closure_convert_with_free() -> i64 with Mut, Panic, Div {
    // Build a function that captures registers 10, 20
    var free_regs: [i64; 8] = [0; 8]
    free_regs[0] = 10
    free_regs[1] = 20
    let func = make_closure_func(free_regs, 2)

    let parent_scope = free_var_set_new()
    let table = closure_table_new()
    let pair = closure_convert_function(func, parent_scope, table)
    let converted = pair.0
    let new_table = pair.1

    // Should have one extra parameter (env)
    if converted.param_count != func.param_count + 1 { return 1 }
    // Table entry should be marked as closure
    if new_table.count != 1 { return 2 }
    if new_table.closures[0].is_closure != 1 { return 3 }
    // Env should capture 2 variables
    if new_table.closures[0].env.count != 2 { return 4 }
    0
}

fn test_lambda_lift_no_free() -> i64 with Mut, Panic, Div {
    var func = ir_empty_function()
    func.reg_count = 2
    func.param_regs[0] = 0
    func.param_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, 7))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))
    func.instr_count = 2

    let module = ir_empty_module()
    let lr = lambda_lift(func, module)
    if lr.lift_count != 1 { return 1 }
    // No patches needed
    if lr.patch_count != 0 { return 2 }
    0
}

fn test_lambda_lift_with_free() -> i64 with Mut, Panic, Div {
    var free_regs: [i64; 8] = [0; 8]
    free_regs[0] = 10
    free_regs[1] = 20
    free_regs[2] = 30
    let func = make_closure_func(free_regs, 3)

    let module = ir_empty_module()
    let lr = lambda_lift(func, module)
    if lr.lift_count != 1 { return 1 }
    // The lifted function should have original params + free var params
    let lifted = lr.lifted_functions[0]
    if lifted.param_count != func.param_count + 3 { return 2 }
    // 3 patches for the 3 free vars
    if lr.patch_count != 3 { return 3 }
    0
}

fn test_lambda_lift_module_identity() -> i64 with Mut, Panic, Div {
    // A module with only non-closure functions should pass through unchanged
    var module = ir_empty_module()
    var f1 = ir_empty_function()
    f1.reg_count = 2
    f1.param_regs[0] = 0
    f1.param_count = 1
    ir_arena_store(ir_region_slot_w(f1.region, (0)), ir_load_imm(1, 5))
    ir_arena_store(ir_region_slot_w(f1.region, (1)), ir_return(1))
    f1.instr_count = 2
    module.functions[0] = f1
    module.fn_count = 1

    let result = lambda_lift_module(module)
    if result.fn_count != 1 { return 1 }
    if result.functions[0].param_count != 1 { return 2 }
    0
}

fn test_generate_env_struct() -> i64 with Mut, Panic, Div {
    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env = closure_env_add_capture(env, 20, 200)
    env.env_struct_id = 7

    let es = generate_env_struct(env)
    if es.field_count != 2 { return 1 }
    if es.struct_id != 7 { return 2 }
    if es.field_types[0] != 100 { return 3 }
    if es.field_types[1] != 200 { return 4 }
    0
}

fn test_emit_env_alloc() -> i64 with Mut, Panic, Div {
    var func = ir_empty_function()
    func.reg_count = 2
    func.instr_count = 0
    var es = env_struct_new()
    es.struct_id = 42

    let result = emit_env_alloc(func, es)
    // Should have 1 new instruction (IrAlloc)
    if result.instr_count != 1 { return 1 }
    // The alloc instruction should target the struct id
    let alloc_instr = ir_arena_load(ir_region_slot_r(result.region, (0)))
    match alloc_instr.op {
        IrOpcode::IrAlloc => {}
        _ => { return 2 }
    }
    if alloc_instr.imm_i64 != 42 { return 3 }
    0
}

fn test_emit_env_pack() -> i64 with Mut, Panic, Div {
    // Setup: function with reg_count = 5 (so env_reg = 4)
    var func = ir_empty_function()
    func.reg_count = 5
    func.instr_count = 0

    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env = closure_env_add_capture(env, 20, 200)

    var captures: [i64; 128] = [0; 128]
    captures[0] = 1  // source register for capture 0
    captures[1] = 2  // source register for capture 1

    let result = emit_env_pack(func, env, captures)
    // Should have 2 field_set instructions
    if result.instr_count != 2 { return 1 }
    match (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) {
        IrOpcode::IrFieldSet => {}
        _ => { return 2 }
    }
    match (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) {
        IrOpcode::IrFieldSet => {}
        _ => { return 3 }
    }
    0
}

fn test_emit_env_unpack() -> i64 with Mut, Panic, Div {
    var func = ir_empty_function()
    func.reg_count = 3
    func.instr_count = 0

    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env = closure_env_add_capture(env, 20, 200)
    env = closure_env_add_capture(env, 30, 300)

    let result = emit_env_unpack(func, env, 0)
    // Should have 3 field_get instructions
    if result.instr_count != 3 { return 1 }
    match (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) {
        IrOpcode::IrFieldGet => {}
        _ => { return 2 }
    }
    // reg_count should have grown by 3
    if result.reg_count != 6 { return 3 }
    0
}

fn test_lower_closure_call_miss() -> i64 with Mut, Panic, Div {
    // Lowering a call that is NOT in the closure table should be a no-op
    var func = ir_empty_function()
    func.reg_count = 3
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_call(1, 99, ir_empty_name(), None, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(1))
    func.instr_count = 3

    let table = closure_table_new()
    let result = lower_closure_call(func, 1, table)
    // Should be unchanged
    if result.instr_count != 3 { return 1 }
    0
}

fn test_lower_closure_call_hit() -> i64 with Mut, Panic, Div {
    // Build a closure table entry
    var table = closure_table_new()
    var info = closure_info_new()
    info.original_fn_id = 5
    info.lifted_fn_id = 50
    info.is_closure = 1
    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env.env_struct_id = 7
    info.env = env
    table = closure_table_add(table, info)

    // Build a function with a call to fn_id=5
    var func = ir_empty_function()
    func.reg_count = 4
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_call(1, 5, ir_empty_name(), None, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(1))
    func.instr_count = 3

    let result = lower_closure_call(func, 1, table)
    // Should have more instructions (env load + call replaced)
    if result.instr_count < 3 { return 1 }
    // Should have the load_imm for env struct id
    match (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) {
        IrOpcode::IrLoadImm => {}
        _ => { return 2 }
    }
    // The call should target the lifted function id
    match (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) {
        IrOpcode::IrCall => {
            if IR_A_FN_ID[(ir_region_slot_r(result.region, (2))) as usize] != 50 { return 3 }
        }
        _ => { return 4 }
    }
    0
}

fn test_lower_all_closure_calls() -> i64 with Mut, Panic, Div {
    // Build module with one function containing a closure call
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.reg_count = 4
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_call(1, 5, ir_empty_name(), None, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(1))
    func.instr_count = 3
    module.functions[0] = func
    module.fn_count = 1

    var table = closure_table_new()
    var info = closure_info_new()
    info.original_fn_id = 5
    info.lifted_fn_id = 50
    info.is_closure = 1
    var env = closure_env_new()
    env = closure_env_add_capture(env, 10, 100)
    env.env_struct_id = 7
    info.env = env
    table = closure_table_add(table, info)

    let result = lower_all_closure_calls(module, table)
    // The function should have been rewritten
    if result.fn_count != 1 { return 1 }
    let rewritten = result.functions[0]
    // Should have more instructions than the original 3
    if rewritten.instr_count < 3 { return 2 }
    0
}

fn test_make_lifted_name() -> i64 with Mut, Panic, Div {
    var base = ir_empty_name()
    // "foo" = [102, 111, 111]
    base.buf[0] = 102
    base.buf[1] = 111
    base.buf[2] = 111
    base.len = 3

    let lifted = make_lifted_name(base, 3)
    // Should be "foo_lift_3"
    // f=102, o=111, o=111, _=95, l=108, i=105, f=102, t=116, _=95, 3=51
    if lifted.len != 10 { return 1 }
    if lifted.buf[3] != 95 { return 2 }   // '_'
    if lifted.buf[4] != 108 { return 3 }  // 'l'
    if lifted.buf[9] != 51 { return 4 }   // '3'
    0
}

fn test_free_var_set_large() -> i64 with Mut, Panic, Div {
    // Fill a set to capacity and verify it stops growing
    var s = free_var_set_new()
    var i: i64 = 0
    while i < 260 {
        s = free_var_add(s, i)
        i = i + 1
    }
    // Should cap at 256
    if s.count != 256 { return 1 }
    // First 256 should be present
    if !free_var_contains(s, 0) { return 2 }
    if !free_var_contains(s, 255) { return 3 }
    0
}

fn test_closure_env_full() -> i64 with Mut, Panic, Div {
    // Fill environment to capacity
    var env = closure_env_new()
    var i: i64 = 0
    while i < 130 {
        env = closure_env_add_capture(env, i, i * 10)
        i = i + 1
    }
    // Should cap at 128
    if env.count != 128 { return 1 }
    let idx = closure_env_index_of(env, 127)
    if idx != 127 { return 2 }
    // 128 and 129 should not be present
    let miss = closure_env_index_of(env, 128)
    if miss != 0 - 1 { return 3 }
    0
}

fn test_build_parent_scope() -> i64 with Mut, Panic, Div {
    var parent = ir_empty_function()
    parent.reg_count = 5
    parent.param_regs[0] = 0
    parent.param_regs[1] = 1
    parent.param_count = 2
    ir_arena_store(ir_region_slot_w(parent.region, (0)), ir_load_imm(2, 10))
    ir_arena_store(ir_region_slot_w(parent.region, (1)), ir_load_imm(3, 20))
    parent.instr_count = 2

    let parent_scope = build_parent_scope(parent)
    // Should contain param regs 0, 1 and dst regs 2, 3
    if !free_var_contains(parent_scope, 0) { return 1 }
    if !free_var_contains(parent_scope, 1) { return 2 }
    if !free_var_contains(parent_scope, 2) { return 3 }
    if !free_var_contains(parent_scope, 3) { return 4 }
    if free_var_contains(parent_scope, 4) { return 5 }
    0
}

