// Closure conversion and lambda lifting for the IR pipeline
//
// This module transforms closures (functions that capture free variables from
// enclosing scopes) into plain functions that receive an explicit environment
// parameter. The pipeline is:
//
//   1. Free variable analysis — determine which variables a function body
//      references but does not define locally.
//   2. Environment construction — build a struct that packs captured variables
//      into a single aggregate value.
//   3. Closure conversion — rewrite each closure to accept an env parameter
//      as its first argument and replace free-variable accesses with field
//      loads/stores on that env.
//   4. Lambda lifting — hoist nested lambdas to top-level functions, threading
//      captured variables as extra parameters when the capture set is small
//      enough to avoid heap allocation.
//   5. Call-site lowering — replace closure-call instructions with a pair of
//      operations: load the environment pointer, then call the lifted function
//      with the environment prepended.

// ============================================================================
// Section 1: Free variable analysis
// ============================================================================

struct FreeVarSet {
    vars: [i64; 256],
    count: i64,
}

fn free_var_set_new() -> FreeVarSet with Mut, Panic, Div {
    FreeVarSet {
        vars: [0; 256],
        count: 0,
    }
}

// Add a variable to the set (deduplicating).
fn free_var_add(set: FreeVarSet, v: i64) -> FreeVarSet with Mut, Panic, Div {
    // Check if already present
    var i: i64 = 0
    while i < set.count {
        if set.vars[i] == v {
            return set
        }
        i = i + 1
    }
    // Bounds check
    if set.count >= 256 {
        return set
    }
    var result = set
    result.vars[result.count] = v
    result.count = result.count + 1
    result
}

// Check membership.
fn free_var_contains(set: FreeVarSet, v: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < set.count {
        if set.vars[i] == v {
            return true
        }
        i = i + 1
    }
    false
}

// Remove a variable from the set.
fn free_var_remove(set: FreeVarSet, v: i64) -> FreeVarSet with Mut, Panic, Div {
    var result = free_var_set_new()
    var i: i64 = 0
    while i < set.count {
        if set.vars[i] != v {
            result.vars[result.count] = set.vars[i]
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

// Union of two sets.
fn free_var_union(a: FreeVarSet, b: FreeVarSet) -> FreeVarSet with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < b.count {
        result = free_var_add(result, b.vars[i])
        i = i + 1
    }
    result
}

// Difference: a \ b (elements in a but not in b).
fn free_var_difference(a: FreeVarSet, b: FreeVarSet) -> FreeVarSet with Mut, Panic, Div {
    var result = free_var_set_new()
    var i: i64 = 0
    while i < a.count {
        if !free_var_contains(b, a.vars[i]) {
            result.vars[result.count] = a.vars[i]
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

// Compute free variables of a function body.
// A register is "free" if it appears as a source operand (src1, src2) but is
// never the destination of any instruction within this function AND is not
// a parameter register.
fn compute_free_vars(func: IrFunction) -> FreeVarSet with Mut, Panic, Div {
    // Collect all defined registers (destinations + parameters)
    var defined = free_var_set_new()
    var i: i64 = 0
    while i < func.param_count {
        defined = free_var_add(defined, func.param_regs[i])
        i = i + 1
    }
    i = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.dst >= 0 {
            defined = free_var_add(defined, instr.dst)
        }
        i = i + 1
    }

    // Collect all used registers
    var used = free_var_set_new()
    i = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.src1 >= 0 {
            used = free_var_add(used, instr.src1)
        }
        if instr.src2 >= 0 {
            used = free_var_add(used, instr.src2)
        }
        i = i + 1
    }

    // Free = used \ defined
    free_var_difference(used, defined)
}

// ============================================================================
// Section 2: Closure environment
// ============================================================================

struct ClosureEnv {
    captures: [i64; 128],
    capture_types: [i64; 128],
    count: i64,
    env_struct_id: i64,
}

fn closure_env_new() -> ClosureEnv with Mut, Panic, Div {
    ClosureEnv {
        captures: [0; 128],
        capture_types: [0; 128],
        count: 0,
        env_struct_id: 0,
    }
}

// Add a capture (variable register + its type id) to the environment.
fn closure_env_add_capture(env: ClosureEnv, v: i64, type_id: i64) -> ClosureEnv with Mut, Panic, Div {
    // Dedup
    var i: i64 = 0
    while i < env.count {
        if env.captures[i] == v {
            return env
        }
        i = i + 1
    }
    if env.count >= 128 {
        return env
    }
    var result = env
    result.captures[result.count] = v
    result.capture_types[result.count] = type_id
    result.count = result.count + 1
    result
}

// Find the position of a variable in the environment. Returns -1 if absent.
fn closure_env_index_of(env: ClosureEnv, v: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < env.count {
        if env.captures[i] == v {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// ============================================================================
// Section 3: Closure conversion
// ============================================================================

struct ClosureInfo {
    original_fn_id: i64,
    lifted_fn_id: i64,
    env: ClosureEnv,
    is_closure: i64,
}

fn closure_info_new() -> ClosureInfo with Mut, Panic, Div {
    ClosureInfo {
        original_fn_id: 0,
        lifted_fn_id: 0,
        env: closure_env_new(),
        is_closure: 0,
    }
}

struct ClosureTable {
    closures: [ClosureInfo; 256],
    count: i64,
}

fn closure_table_new() -> ClosureTable with Mut, Panic, Div {
    ClosureTable {
        closures: [closure_info_new(); 256],
        count: 0,
    }
}

// Add an entry to the closure table. Returns updated table.
fn closure_table_add(table: ClosureTable, info: ClosureInfo) -> ClosureTable with Mut, Panic, Div {
    if table.count >= 256 {
        return table
    }
    var result = table
    result.closures[result.count] = info
    result.count = result.count + 1
    result
}

// Look up a closure by original function id. Returns index or -1.
fn closure_table_lookup(table: ClosureTable, orig_fn_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < table.count {
        if table.closures[i].original_fn_id == orig_fn_id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Build a scope set from parent parameters (the "parent_scope" tracks which
// registers are defined in the enclosing scope).
fn build_parent_scope(parent: IrFunction) -> FreeVarSet with Mut, Panic, Div {
    var scope = free_var_set_new()
    var i: i64 = 0
    while i < parent.param_count {
        scope = free_var_add(scope, parent.param_regs[i])
        i = i + 1
    }
    i = 0
    while i < parent.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(parent.region, (i)))
        if instr.dst >= 0 {
            scope = free_var_add(scope, instr.dst)
        }
        i = i + 1
    }
    scope
}

// Emit a single instruction into a function, returning the updated function.
fn closure_emit_instr(func: IrFunction, instr: IrInstr) -> IrFunction with Mut, Panic, Div {
    if func.instr_count >= 32768 {
        return func
    }
    var result = ir_function_clone(&func)
    ir_arena_store(ir_region_slot_w(result.region, (result.instr_count)), instr)
    result.instr_count = result.instr_count + 1
    result
}

// Allocate a fresh register in the function.
fn closure_alloc_reg(func: IrFunction) -> (IrFunction, i64) with Mut, Panic, Div {
    var result = func
    let reg = result.reg_count
    result.reg_count = result.reg_count + 1
    (result, reg)
}

// Convert a single function: add env parameter as first param, replace
// free-variable reads with IrFieldGet on env, writes with IrFieldSet.
// parent_scope identifies which registers come from the enclosing scope.
fn closure_convert_function(func: IrFunction, parent_scope: FreeVarSet, table: ClosureTable) -> (IrFunction, ClosureTable) with Mut, Panic, Div {
    let free = compute_free_vars(func)

    // If no free variables, the function is not a closure.
    if free.count == 0 {
        let info = ClosureInfo {
            original_fn_id: 0,
            lifted_fn_id: 0,
            env: closure_env_new(),
            is_closure: 0,
        }
        return (func, closure_table_add(table, info))
    }

    // Build environment from free variables
    var env = closure_env_new()
    var k: i64 = 0
    while k < free.count {
        // Use variable id as a placeholder type id
        env = closure_env_add_capture(env, free.vars[k], free.vars[k])
        k = k + 1
    }
    env.env_struct_id = table.count + 1

    // Build converted function: shift all existing params right by 1,
    // insert env_reg as param 0.
    var converted = ir_empty_function()
    converted.name = func.name
    converted.reg_count = func.reg_count
    converted.label_count = func.label_count

    // Env parameter gets a fresh register
    let pair = closure_alloc_reg(converted)
    converted = pair.0
    let env_reg = pair.1

    // First param is the env register
    converted.param_regs[0] = env_reg
    var p: i64 = 0
    while p < func.param_count && p < 63 {
        converted.param_regs[p + 1] = func.param_regs[p]
        p = p + 1
    }
    converted.param_count = func.param_count + 1

    // Rewrite instructions: replace free var reads with field loads from env
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        var new_instr = instr

        // Replace src1 if it is a free variable
        if instr.src1 >= 0 {
            let idx1 = closure_env_index_of(env, instr.src1)
            if idx1 >= 0 {
                // Allocate a temp register for the loaded value
                let pair1 = closure_alloc_reg(converted)
                converted = pair1.0
                let tmp1 = pair1.1
                // Emit field load: tmp1 = env_reg.field[idx1]
                converted = closure_emit_instr(converted, ir_field_get(tmp1, env_reg, idx1, ir_empty_name()))
                new_instr = IrInstr {
                    op: new_instr.op,
                    dst: new_instr.dst,
                    src1: tmp1,
                    src2: new_instr.src2,
                    imm_i64: new_instr.imm_i64,
                    imm_f64: new_instr.imm_f64,
                    label_id: new_instr.label_id,
                    fn_id: new_instr.fn_id,
                    field_idx: new_instr.field_idx,
                    imm_flags: 0,
                    bin_op: new_instr.bin_op,
                    un_op: new_instr.un_op,
                    name_id: new_instr.name_id,
                    call_args: new_instr.call_args,
                    arg_count: new_instr.arg_count,
                }
            }
        }

        // Replace src2 if it is a free variable
        if new_instr.src2 >= 0 {
            let idx2 = closure_env_index_of(env, new_instr.src2)
            if idx2 >= 0 {
                let pair2 = closure_alloc_reg(converted)
                converted = pair2.0
                let tmp2 = pair2.1
                converted = closure_emit_instr(converted, ir_field_get(tmp2, env_reg, idx2, ir_empty_name()))
                new_instr = IrInstr {
                    op: new_instr.op,
                    dst: new_instr.dst,
                    src1: new_instr.src1,
                    src2: tmp2,
                    imm_i64: new_instr.imm_i64,
                    imm_f64: new_instr.imm_f64,
                    label_id: new_instr.label_id,
                    fn_id: new_instr.fn_id,
                    field_idx: new_instr.field_idx,
                    imm_flags: 0,
                    bin_op: new_instr.bin_op,
                    un_op: new_instr.un_op,
                    name_id: new_instr.name_id,
                    call_args: new_instr.call_args,
                    arg_count: new_instr.arg_count,
                }
            }
        }

        // If the destination is a free variable, replace with field store
        if new_instr.dst >= 0 {
            let idx_dst = closure_env_index_of(env, new_instr.dst)
            if idx_dst >= 0 {
                // Emit the original instruction to a fresh temp
                let pair_d = closure_alloc_reg(converted)
                converted = pair_d.0
                let tmp_d = pair_d.1
                let store_instr = IrInstr {
                    op: new_instr.op,
                    dst: tmp_d,
                    src1: new_instr.src1,
                    src2: new_instr.src2,
                    imm_i64: new_instr.imm_i64,
                    imm_f64: new_instr.imm_f64,
                    label_id: new_instr.label_id,
                    fn_id: new_instr.fn_id,
                    field_idx: new_instr.field_idx,
                    imm_flags: 0,
                    bin_op: new_instr.bin_op,
                    un_op: new_instr.un_op,
                    name_id: new_instr.name_id,
                    call_args: new_instr.call_args,
                    arg_count: new_instr.arg_count,
                }
                converted = closure_emit_instr(converted, store_instr)
                // Then store tmp_d into env field
                converted = closure_emit_instr(converted, ir_field_set(env_reg, idx_dst, tmp_d, ir_empty_name()))
                i = i + 1
                // skip the normal emit below
                continue
            }
        }

        converted = closure_emit_instr(converted, new_instr)
        i = i + 1
    }

    let info = ClosureInfo {
        original_fn_id: table.count,
        lifted_fn_id: table.count,
        env: env,
        is_closure: 1,
    }

    (converted, closure_table_add(table, info))
}

// ============================================================================
// Section 4: Lambda lifting
// ============================================================================

struct LiftResult {
    lifted_functions: [IrFunction; 64],
    lift_count: i64,
    call_patches: [i64; 256],
    patch_count: i64,
}

fn lift_result_new() -> LiftResult with Mut, Panic, Div {
    LiftResult {
        lifted_functions: [ir_empty_function(); 64],
        lift_count: 0,
        call_patches: [0; 256],
        patch_count: 0,
    }
}

// Generate a lifted function name by appending a numeric suffix.
fn make_lifted_name(base: Name, suffix: i64) -> Name with Mut, Panic, Div {
    var result = base
    // Append "_lifted_"
    if result.len < 118 {
        result.buf[result.len] = 95   // '_'
        result.len = result.len + 1
        result.buf[result.len] = 108  // 'l'
        result.len = result.len + 1
        result.buf[result.len] = 105  // 'i'
        result.len = result.len + 1
        result.buf[result.len] = 102  // 'f'
        result.len = result.len + 1
        result.buf[result.len] = 116  // 't'
        result.len = result.len + 1
        result.buf[result.len] = 95   // '_'
        result.len = result.len + 1
    }
    // Append suffix digit(s)
    if suffix < 10 {
        result.buf[result.len] = (48 + suffix) as i8  // '0'+suffix
        result.len = result.len + 1
    } else {
        let tens = suffix / 10
        let ones = suffix % 10
        result.buf[result.len] = (48 + tens) as i8
        result.len = result.len + 1
        result.buf[result.len] = (48 + ones) as i8
        result.len = result.len + 1
    }
    result
}

// Lambda-lift a single function: extract to top-level, threading captured
// variables as additional parameters.
fn lambda_lift(func: IrFunction, module: IrModule) -> LiftResult with Mut, Panic, Div {
    var result = lift_result_new()

    let free = compute_free_vars(func)

    // If no free variables, the function is already top-level
    if free.count == 0 {
        result.lifted_functions[0] = func
        result.lift_count = 1
        return result
    }

    // Create the lifted version with extra params for captured vars
    var lifted = ir_empty_function()
    lifted.name = make_lifted_name(func.name, result.lift_count)
    lifted.reg_count = func.reg_count
    lifted.label_count = func.label_count

    // Copy original params
    var p: i64 = 0
    while p < func.param_count {
        lifted.param_regs[p] = func.param_regs[p]
        p = p + 1
    }
    lifted.param_count = func.param_count

    // Add extra params for each free variable
    var c: i64 = 0
    while c < free.count && lifted.param_count < 64 {
        // The extra parameter register IS the free variable register itself
        // so no rewriting needed in the body
        lifted.param_regs[lifted.param_count] = free.vars[c]
        lifted.param_count = lifted.param_count + 1
        c = c + 1
    }

    // Copy instructions verbatim (free vars are now parameters)
    var i: i64 = 0
    while i < func.instr_count {
        ir_arena_copy_slot(ir_region_slot_w(lifted.region, (i)),ir_region_slot_r(func.region, (i)))
        i = i + 1
    }
    lifted.instr_count = func.instr_count

    result.lifted_functions[result.lift_count] = lifted
    result.lift_count = result.lift_count + 1

    // Record which free vars need to be passed at call sites
    c = 0
    while c < free.count {
        if result.patch_count < 256 {
            result.call_patches[result.patch_count] = free.vars[c]
            result.patch_count = result.patch_count + 1
        }
        c = c + 1
    }

    result
}

// Lift all functions in a module that have free variables.
fn lambda_lift_module(module: IrModule) -> IrModule with Mut, Panic, Div {
    var result = ir_empty_module()
    result.string_table = module.string_table
    result.string_count = module.string_count

    var fn_idx: i64 = 0
    while fn_idx < module.fn_count {
        let func = module.functions[fn_idx]
        let lr = lambda_lift(func, module)

        // Add all lifted functions to the result module
        var li: i64 = 0
        while li < lr.lift_count {
            if result.fn_count < 4096 {
                result.functions[result.fn_count] = lr.lifted_functions[li]
                result.fn_count = result.fn_count + 1
            }
            li = li + 1
        }
        fn_idx = fn_idx + 1
    }

    result
}

// ============================================================================
// Section 5: Environment struct generation
// ============================================================================

struct EnvStruct {
    field_types: [i64; 128],
    field_count: i64,
    struct_id: i64,
}

fn env_struct_new() -> EnvStruct with Mut, Panic, Div {
    EnvStruct {
        field_types: [0; 128],
        field_count: 0,
        struct_id: 0,
    }
}

// Generate an environment struct descriptor from a ClosureEnv.
fn generate_env_struct(env: ClosureEnv) -> EnvStruct with Mut, Panic, Div {
    var es = env_struct_new()
    es.struct_id = env.env_struct_id
    var i: i64 = 0
    while i < env.count && i < 128 {
        es.field_types[i] = env.capture_types[i]
        i = i + 1
    }
    es.field_count = env.count
    es
}

// Emit an allocation instruction for the environment struct.
fn emit_env_alloc(func: IrFunction, env_struct: EnvStruct) -> IrFunction with Mut, Panic, Div {
    let pair = closure_alloc_reg(func)
    var result = pair.0
    let env_reg = pair.1
    result = closure_emit_instr(result, ir_alloc(env_reg, env_struct.struct_id))
    result
}

// Pack captured variables into the environment struct.
// captures is the array of source registers to store into each env field.
fn emit_env_pack(func: IrFunction, env: ClosureEnv, captures: [i64; 128]) -> IrFunction with Mut, Panic, Div {
    // We assume the env pointer register is reg_count - 1 (allocated by emit_env_alloc)
    let env_reg = func.reg_count - 1
    var result = func
    var i: i64 = 0
    while i < env.count {
        result = closure_emit_instr(result, ir_field_set(env_reg, i, captures[i], ir_empty_name()))
        i = i + 1
    }
    result
}

// Unpack environment fields into local registers at function entry.
// param_reg is the register that holds the env pointer parameter.
fn emit_env_unpack(func: IrFunction, env: ClosureEnv, param_reg: i64) -> IrFunction with Mut, Panic, Div {
    var result = func
    var i: i64 = 0
    while i < env.count {
        let pair = closure_alloc_reg(result)
        result = pair.0
        let local_reg = pair.1
        result = closure_emit_instr(result, ir_field_get(local_reg, param_reg, i, ir_empty_name()))
        i = i + 1
    }
    result
}

// ============================================================================
// Section 6: Closure call lowering
// ============================================================================

// Lower a single closure call instruction: replace it with env load + direct
// call to the lifted function with env prepended.
fn lower_closure_call(func: IrFunction, call_idx: i64, closure_table: ClosureTable) -> IrFunction with Mut, Panic, Div {
    if call_idx < 0 || call_idx >= func.instr_count {
        return func
    }

    let call_instr = ir_arena_load(ir_region_slot_r(func.region, (call_idx)))

    // Look up the target function in the closure table
    let ct_idx = closure_table_lookup(closure_table, call_instr.fn_id)
    if ct_idx < 0 {
        return func  // Not a closure call
    }

    let cinfo = closure_table.closures[ct_idx]
    if cinfo.is_closure == 0 {
        return func  // Not actually a closure
    }

    // Build a new function with the call replaced:
    // 1) Emit all instructions before the call
    // 2) Load env pointer (we use a dummy field get from a "closure object")
    // 3) Emit call to lifted function with env as first arg
    // 4) Copy remaining instructions
    var result = ir_empty_function()
    result.name = func.name
    result.reg_count = func.reg_count
    result.label_count = func.label_count
    result.param_count = func.param_count
    var p: i64 = 0
    while p < func.param_count {
        result.param_regs[p] = func.param_regs[p]
        p = p + 1
    }

    var i: i64 = 0
    while i < func.instr_count {
        if i == call_idx {
            // Allocate register for env pointer
            let pair = closure_alloc_reg(result)
            result = pair.0
            let env_ptr_reg = pair.1

            // Emit: env_ptr_reg = field_get(closure_reg, 0, "env")
            // src1 of the call was the first arg; closure object is assumed to
            // be stored at fn_id's associated env struct
            result = closure_emit_instr(result, ir_load_imm(env_ptr_reg, cinfo.env.env_struct_id))

            // Emit the direct call to the lifted function with env prepended
            let lifted_call = IrInstr {
                op: IrOpcode::IrCall,
                dst: call_instr.dst,
                src1: env_ptr_reg,
                src2: call_instr.src1,
                imm_i64: call_instr.imm_i64,
                imm_f64: call_instr.imm_f64,
                label_id: call_instr.label_id,
                fn_id: cinfo.lifted_fn_id,
                field_idx: call_instr.field_idx,
                imm_flags: 0,
                bin_op: call_instr.bin_op,
                un_op: call_instr.un_op,
                name_id: call_instr.name_id,
                call_args: call_instr.call_args,
                arg_count: call_instr.arg_count + 1,
            }
            result = closure_emit_instr(result, lifted_call)
        } else {
            result = closure_emit_instr(result, ir_arena_load(ir_region_slot_r(func.region, (i))))
        }
        i = i + 1
    }

    result
}

// Lower all closure calls in an entire module.
fn lower_all_closure_calls(module: IrModule, closure_table: ClosureTable) -> IrModule with Mut, Panic, Div {
    var result = module

    var fn_idx: i64 = 0
    while fn_idx < result.fn_count {
        var func = result.functions[fn_idx]

        // Scan for call instructions that target closures.
        // Process in reverse order so indices remain valid.
        var ci: i64 = func.instr_count - 1
        while ci >= 0 {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (ci)))
            match instr.op {
                IrOpcode::IrCall => {
                    let ct_idx = closure_table_lookup(closure_table, instr.fn_id)
                    if ct_idx >= 0 {
                        if closure_table.closures[ct_idx].is_closure != 0 {
                            func = lower_closure_call(func, ci, closure_table)
                        }
                    }
                }
                _ => {}
            }
            ci = ci - 1
        }

        result.functions[fn_idx] = func
        fn_idx = fn_idx + 1
    }

    result
}

// ============================================================================
// Section 7: Test helpers
// ============================================================================

// Build a trivial IR function with a given number of instructions.
fn make_test_func(name: Name, num_instrs: i64) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = name
    func.reg_count = num_instrs + 2
    var i: i64 = 0
    while i < num_instrs {
        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(i, i * 10))
        i = i + 1
    }
    func.instr_count = num_instrs
    func
}

// Build a function that uses registers not in its own defs (simulating free vars).
fn make_closure_func(free_regs: [i64; 8], free_count: i64) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_empty_name()
    func.reg_count = 100

    // Parameter register 0
    func.param_regs[0] = 0
    func.param_count = 1

    // Instruction: dst=1, src1=free_regs[0], src2=free_regs[1]
    // This creates free variables since those regs are not defined here
    var i: i64 = 0
    while i < free_count && i < 4 {
        let src_reg = free_regs[i]
        let dst_reg = 50 + i
        ir_arena_store(ir_region_slot_w(func.region, (func.instr_count)), ir_binop(dst_reg, src_reg, BinaryOp::OpAdd, 0))
        func.instr_count = func.instr_count + 1
        i = i + 1
    }

    // Return
    ir_arena_store(ir_region_slot_w(func.region, (func.instr_count)), ir_return(50))
    func.instr_count = func.instr_count + 1

    func
}

