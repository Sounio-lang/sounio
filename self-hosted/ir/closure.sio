// Test runner
// ============================================================================

fn closure_run_tests() -> i64 with Mut, Panic, Div {
    var fail: i64 = 0

    let t01 = test_free_var_set_empty()
    if t01 != 0 { print_int(101) fail = fail + 1 }

    let t02 = test_free_var_add_and_contains()
    if t02 != 0 { print_int(102) fail = fail + 1 }

    let t03 = test_free_var_add_dedup()
    if t03 != 0 { print_int(103) fail = fail + 1 }

    let t04 = test_free_var_remove()
    if t04 != 0 { print_int(104) fail = fail + 1 }

    let t05 = test_free_var_union()
    if t05 != 0 { print_int(105) fail = fail + 1 }

    let t06 = test_free_var_difference()
    if t06 != 0 { print_int(106) fail = fail + 1 }

    let t07 = test_compute_free_vars_none()
    if t07 != 0 { print_int(107) fail = fail + 1 }

    let t08 = test_compute_free_vars_some()
    if t08 != 0 { print_int(108) fail = fail + 1 }

    let t09 = test_closure_env_add_and_index()
    if t09 != 0 { print_int(109) fail = fail + 1 }

    let t10 = test_closure_env_dedup()
    if t10 != 0 { print_int(110) fail = fail + 1 }

    let t11 = test_closure_table_new()
    if t11 != 0 { print_int(111) fail = fail + 1 }

    let t12 = test_closure_table_add_lookup()
    if t12 != 0 { print_int(112) fail = fail + 1 }

    let t13 = test_closure_convert_no_free()
    if t13 != 0 { print_int(113) fail = fail + 1 }

    let t14 = test_closure_convert_with_free()
    if t14 != 0 { print_int(114) fail = fail + 1 }

    let t15 = test_lambda_lift_no_free()
    if t15 != 0 { print_int(115) fail = fail + 1 }

    let t16 = test_lambda_lift_with_free()
    if t16 != 0 { print_int(116) fail = fail + 1 }

    let t17 = test_lambda_lift_module_identity()
    if t17 != 0 { print_int(117) fail = fail + 1 }

    let t18 = test_generate_env_struct()
    if t18 != 0 { print_int(118) fail = fail + 1 }

    let t19 = test_emit_env_alloc()
    if t19 != 0 { print_int(119) fail = fail + 1 }

    let t20 = test_emit_env_pack()
    if t20 != 0 { print_int(120) fail = fail + 1 }

    let t21 = test_emit_env_unpack()
    if t21 != 0 { print_int(121) fail = fail + 1 }

    let t22 = test_lower_closure_call_miss()
    if t22 != 0 { print_int(122) fail = fail + 1 }

    let t23 = test_lower_closure_call_hit()
    if t23 != 0 { print_int(123) fail = fail + 1 }

    let t24 = test_lower_all_closure_calls()
    if t24 != 0 { print_int(124) fail = fail + 1 }

    let t25 = test_make_lifted_name()
    if t25 != 0 { print_int(125) fail = fail + 1 }

    let t26 = test_free_var_set_large()
    if t26 != 0 { print_int(126) fail = fail + 1 }

    let t27 = test_closure_env_full()
    if t27 != 0 { print_int(127) fail = fail + 1 }

    let t28 = test_build_parent_scope()
    if t28 != 0 { print_int(128) fail = fail + 1 }

    fail
}
