// T20 inner: run DCE and verify alloc preserved.
fn test_dce_alloc_preserved_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    dce_check_opcode(func, 0, IrOpcode::IrAlloc)
}

// T20: Alloc is side-effectful -- must not be eliminated.
fn test_dce_alloc_preserved() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_alloc(0, 0)          // side effect
    instrs[1] = ir_load_imm(1, 0)
    instrs[2] = ir_return(1)

    var func = dce_make_test_func(instrs, 3)
    test_dce_alloc_preserved_inner(&! func)
}

// T21 inner: run DCE and verify field set preserved when base is live.
fn test_dce_field_set_preserved_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    dce_check_opcode(func, 2, IrOpcode::IrFieldSet)
}

// T21: Field set is side-effectful -- preserved when base is live.
fn test_dce_field_set_preserved_live_base() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_alloc(0, 0)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_field_set(0, 0, 1, ir_empty_name())
    instrs[3] = ir_return(0)           // base reg is used by return

    var func = dce_make_test_func(instrs, 4)
    test_dce_field_set_preserved_inner(&! func)
}

// T22 inner: populate, set use_count, eliminate trivial phis, check result.
fn test_dce_trivial_phi_single_inner(ctx: &! DceContext, func: &! IrFunction) -> bool with Mut, Panic, Div {
    let pop = dce_populate(ctx, func)
    // Manually set use_count to 1 for the phi
    ctx.instrs[1].use_count = 1
    let elim = dce_eliminate_trivial_phis(ctx, func)

    // Phi should become a copy
    let is_copy = dce_check_opcode(func, 1, IrOpcode::IrCopy)
    let count_ok = elim == 1
    is_copy && count_ok
}

// T22: Trivial phi with single input -- becomes copy.
fn test_dce_trivial_phi_single_input() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = dce_make_phi(1, 0, DCE_INVALID)  // phi(r1) = r0  (single input)
    instrs[2] = ir_return(1)

    var func = dce_make_test_func(instrs, 3)
    var ctx = dce_context_new()
    test_dce_trivial_phi_single_inner(&! ctx, &! func)
}

// T23 inner: populate, set use_count/regs, eliminate trivial phis, check.
fn test_dce_trivial_phi_same_inner(ctx: &! DceContext, func: &! IrFunction) -> bool with Mut, Panic, Div {
    let pop = dce_populate(ctx, func)
    // Set use_count to 2 for the phi with both uses being r0
    ctx.instrs[1].use_count = 2
    ctx.instrs[1].use_regs[0] = 0
    ctx.instrs[1].use_regs[1] = 0
    let elim = dce_eliminate_trivial_phis(ctx, func)

    let is_copy = dce_check_opcode(func, 1, IrOpcode::IrCopy)
    let count_ok = elim == 1
    is_copy && count_ok
}

// T23: Trivial phi with identical inputs -- becomes copy.
fn test_dce_trivial_phi_same_inputs() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = dce_make_phi(1, 0, 0)  // phi(r1) = r0, r0  (same input twice)
    instrs[2] = ir_return(1)

    var func = dce_make_test_func(instrs, 3)
    var ctx = dce_context_new()
    test_dce_trivial_phi_same_inner(&! ctx, &! func)
}

// T24 inner: populate, set use_count/regs for non-trivial phi, check not eliminated.
fn test_dce_nontrivial_phi_kept_inner(ctx: &! DceContext, func: &! IrFunction) -> bool with Mut, Panic, Div {
    let pop = dce_populate(ctx, func)
    ctx.instrs[2].use_count = 2
    ctx.instrs[2].use_regs[0] = 0
    ctx.instrs[2].use_regs[1] = 1
    let elim = dce_eliminate_trivial_phis(ctx, func)

    // Phi should NOT be eliminated
    elim == 0
}

// T24: Non-trivial phi with different inputs -- not eliminated.
fn test_dce_nontrivial_phi_kept() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = dce_make_phi(2, 0, 1)  // phi(r2) = r0, r1  (different inputs)
    instrs[3] = ir_return(2)

    var func = dce_make_test_func(instrs, 4)
    var ctx = dce_context_new()
    test_dce_nontrivial_phi_kept_inner(&! ctx, &! func)
}

// T25: Empty function -- no crash, zero stats.
fn test_dce_empty_function() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    var func = dce_make_test_func(instrs, 0)
    let stats = dce_run(&! func)

    stats.total_instrs == 0 && stats.eliminated == 0
}

// T26: Single return, nothing to eliminate.
fn test_dce_single_return() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_return(0)

    var func = dce_make_test_func(instrs, 2)
    let stats = dce_run(&! func)

    // Nothing should be eliminated
    stats.eliminated == 0
}

// T27 inner: run DCE and verify long dead chain eliminated.
fn test_dce_long_dead_chain_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let d0 = dce_check_nop(func, 0)
    let d1 = dce_check_nop(func, 1)
    let d2 = dce_check_nop(func, 2)
    let d3 = dce_check_nop(func, 3)
    let d4 = dce_check_nop(func, 4)
    d0 && d1 && d2 && d3 && d4
}

// T27: Long dead chain -- r0->r1->r2->r3->r4, none used.
fn test_dce_long_dead_chain() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_copy(1, 0)
    instrs[2] = ir_copy(2, 1)
    instrs[3] = ir_copy(3, 2)
    instrs[4] = ir_copy(4, 3)
    instrs[5] = ir_load_imm(5, 0)
    instrs[6] = ir_return(5)

    var func = dce_make_test_func(instrs, 7)
    test_dce_long_dead_chain_inner(&! func)
}

// T28 inner: run DCE and verify diamond pattern branches live.
fn test_dce_diamond_live_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let br_ok = dce_check_opcode(func, 1, IrOpcode::IrBranchTrue)
    let jmp_ok = dce_check_opcode(func, 3, IrOpcode::IrJump)
    let lbl0_ok = dce_check_opcode(func, 4, IrOpcode::IrLabel)
    let lbl1_ok = dce_check_opcode(func, 6, IrOpcode::IrLabel)
    let ret_ok = dce_check_opcode(func, 8, IrOpcode::IrReturn)
    br_ok && jmp_ok && lbl0_ok && lbl1_ok && ret_ok
}

// T28: Diamond pattern -- both branches live.
fn test_dce_diamond_live() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)              // condition
    instrs[1] = ir_branch_true(0, 0)           // branch to label 0
    instrs[2] = ir_load_imm(1, 10)             // false path
    instrs[3] = ir_jump(1)                     // jump to merge
    instrs[4] = ir_label(0)                    // true path label
    instrs[5] = ir_load_imm(2, 20)             // true path value
    instrs[6] = ir_label(1)                    // merge label
    instrs[7] = ir_load_imm(3, 0)
    instrs[8] = ir_return(3)

    var func = dce_make_test_func(instrs, 9)
    test_dce_diamond_live_inner(&! func)
}

// T29 inner: run DCE and verify mixed live/dead in same block.
fn test_dce_mixed_live_dead_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let l0 = dce_check_not_nop(func, 0)
    let l1 = dce_check_not_nop(func, 1)
    let d2 = dce_check_nop(func, 2)
    let d3 = dce_check_nop(func, 3)
    let l4 = dce_check_not_nop(func, 4)
    l0 && l1 && d2 && d3 && l4
}

// T29: Mixed live and dead in same block.
fn test_dce_mixed_live_dead() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)      // live (used by add)
    instrs[1] = ir_load_imm(1, 2)      // live (used by add)
    instrs[2] = ir_load_imm(2, 3)      // dead
    instrs[3] = ir_load_imm(3, 4)      // dead
    instrs[4] = ir_binop(4, 0, BinaryOp::OpAdd, 1)  // live
    instrs[5] = ir_return(4)

    var func = dce_make_test_func(instrs, 6)
    test_dce_mixed_live_dead_inner(&! func)
}

