    instrs[0] = ir_alloc(0, 0)
    instrs[1] = ir_field_get(1, 0, 0, ir_empty_name())  // dead: r1 unused
    instrs[2] = ir_load_imm(2, 0)
    instrs[3] = ir_return(2)

    var func = dce_make_test_func(instrs, 4)
    test_dce_dead_field_get_inner(&! func)
}

// T19 inner: run DCE and verify dead index get eliminated.
