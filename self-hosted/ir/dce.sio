    let d0 = dce_check_nop(func, 0)
    let d1 = dce_check_nop(func, 1)
    let d2 = dce_check_nop(func, 2)
    d0 && d1 && d2
}

// T35: Binop dead when result unused.
fn test_dce_dead_binop() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // dead: r2 unused
    instrs[3] = ir_load_imm(3, 0)
    instrs[4] = ir_return(3)

    var func = dce_make_test_func(instrs, 5)
    test_dce_dead_binop_inner(&! func)
}

// T36: Opcode classification correctness.
fn test_dce_opcode_classification() -> bool with Mut, Panic, Div {
    let call_se = dce_has_side_effect(DCE_OP_CALL)
    let ret_se = dce_has_side_effect(DCE_OP_RETURN)
    let jmp_se = dce_has_side_effect(DCE_OP_JUMP)
    let br_se = dce_has_side_effect(DCE_OP_BRANCH_TRUE)
    let fset_se = dce_has_side_effect(DCE_OP_FIELD_SET)
    let iset_se = dce_has_side_effect(DCE_OP_INDEX_SET)
    let lbl_se = dce_has_side_effect(DCE_OP_LABEL)
    let alloc_se = dce_has_side_effect(DCE_OP_ALLOC)

    let load_no_se = !dce_has_side_effect(DCE_OP_LOAD_IMM)
    let copy_no_se = !dce_has_side_effect(DCE_OP_COPY)
    let binop_no_se = !dce_has_side_effect(DCE_OP_BINOP)
    let phi_no_se = !dce_has_side_effect(DCE_OP_PHI)

    call_se && ret_se && jmp_se && br_se && fset_se && iset_se && lbl_se && alloc_se &&
    load_no_se && copy_no_se && binop_no_se && phi_no_se
}

// T37 inner: push/pop operations on an already-borrowed ctx.
fn test_dce_worklist_operations_inner(ctx: &! DceContext) -> bool with Mut, Panic, Div {
    // Need at least one instruction for push to succeed
    ctx.instr_count = 10
    var i: i64 = 0
    while i < 10 {
        ctx.instrs[i as usize].instr_idx = i
        ctx.instrs[i as usize].is_live = false
        i = i + 1
    }

    let p1 = dce_worklist_push(ctx, 3)
    let p2 = dce_worklist_push(ctx, 7)
    let count_ok = ctx.worklist.count == 2

    let v1 = dce_worklist_pop(ctx)
    let v2 = dce_worklist_pop(ctx)
    let v3 = dce_worklist_pop(ctx)  // should be INVALID

    // Stack-like behavior: last in, first out
    let pop_ok = v1 == 7 && v2 == 3 && v3 == DCE_INVALID
    count_ok && pop_ok
}

// T37: Worklist push/pop operations.
fn test_dce_worklist_operations() -> bool with Mut, Panic, Div {
    var ctx = dce_context_new()
    test_dce_worklist_operations_inner(&! ctx)
}

// T38 inner: duplicate push prevention on already-borrowed ctx.
fn test_dce_no_duplicate_push_inner(ctx: &! DceContext) -> bool with Mut, Panic, Div {
    ctx.instr_count = 5
    var i: i64 = 0
    while i < 5 {
        ctx.instrs[i as usize].instr_idx = i
        ctx.instrs[i as usize].is_live = false
        i = i + 1
    }

    let p1 = dce_worklist_push(ctx, 2)
    // Mark it live
    ctx.instrs[2].is_live = true
    // Try to push again -- should fail
    let p2 = dce_worklist_push(ctx, 2)

    p1 && !p2
}

// T38: Duplicate push prevention (already live).
fn test_dce_no_duplicate_push() -> bool with Mut, Panic, Div {
    var ctx = dce_context_new()
    test_dce_no_duplicate_push_inner(&! ctx)
}

// T39: Context construction -- all fields initialized.
fn test_dce_context_initialization() -> bool with Mut, Panic, Div {
    let ctx = dce_context_new()

    let ic_ok = ctx.instr_count == 0
    let bc_ok = ctx.block_count == 0
    let wl_ok = ctx.worklist.count == 0
    let ud_ok = ctx.use_def.reg_count == 0
    let st_ok = ctx.stats.total_instrs == 0 && ctx.stats.eliminated == 0

    ic_ok && bc_ok && wl_ok && ud_ok && st_ok
}

// T40 inner: populate + build blocks + verify on already-borrowed ctx/func.
fn test_dce_block_building_inner(ctx: &! DceContext, func: &! IrFunction) -> bool with Mut, Panic, Div {
    let pop = dce_populate(ctx, func)
    let bc = dce_build_blocks(ctx)

    // Should have 2 blocks: [0..2) and [2..5)
    let bc_ok = bc == 2
    let b0_start = ctx.blocks[0].instr_start == 0
    let b1_start = ctx.blocks[1].instr_start == 2
    bc_ok && b0_start && b1_start
}

// T40: Block building from labels.
fn test_dce_block_building() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_load_imm(1, 0)
    instrs[4] = ir_return(1)

    var func = dce_make_test_func(instrs, 5)
    var ctx = dce_context_new()
    test_dce_block_building_inner(&! ctx, &! func)
}

// T41: Terminator classification.
fn test_dce_terminator_classification() -> bool with Mut, Panic, Div {
    let j = dce_is_terminator(DCE_OP_JUMP)
    let bt = dce_is_terminator(DCE_OP_BRANCH_TRUE)
    let bf = dce_is_terminator(DCE_OP_BRANCH_FALSE)
    let r = dce_is_terminator(DCE_OP_RETURN)
    let li = !dce_is_terminator(DCE_OP_LOAD_IMM)
    let c = !dce_is_terminator(DCE_OP_CALL)

    j && bt && bf && r && li && c
}

// T42: Store classification.
fn test_dce_store_classification() -> bool with Mut, Panic, Div {
    let fs = dce_is_store(DCE_OP_FIELD_SET)
    // Soft-keyword: Madaros parser rejects `let is` as binding name.
    let is_index_set = dce_is_store(DCE_OP_INDEX_SET)
    let li = !dce_is_store(DCE_OP_LOAD_IMM)
    let ca = !dce_is_store(DCE_OP_CALL)

    fs && is_index_set && li && ca
}

// T43 inner: populate, set use_count, eliminate trivial phis, check zero-input phi.
fn test_dce_phi_zero_inputs_inner(ctx: &! DceContext, func: &! IrFunction) -> bool with Mut, Panic, Div {
    let pop = dce_populate(ctx, func)
    ctx.instrs[0].use_count = 0
    let elim = dce_eliminate_trivial_phis(ctx, func)

    let is_nop = dce_check_nop(func, 0)
    let count_ok = elim == 1
    is_nop && count_ok
}

// T43: Phi with zero inputs eliminated.
fn test_dce_phi_zero_inputs() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_phi(0)              // phi with no inputs
    instrs[1] = ir_load_imm(1, 0)
    instrs[2] = ir_return(1)

    var func = dce_make_test_func(instrs, 3)
    var ctx = dce_context_new()
    test_dce_phi_zero_inputs_inner(&! ctx, &! func)
}

// T44 inner: run DCE and verify multiple calls preserved.
fn test_dce_multiple_calls_preserved_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let c0 = dce_check_opcode(func, 0, IrOpcode::IrCall)
    let c1 = dce_check_opcode(func, 1, IrOpcode::IrCall)
    let c2 = dce_check_opcode(func, 2, IrOpcode::IrCall)
    c0 && c1 && c2
}

// T44: Multiple calls all preserved.
fn test_dce_multiple_calls_preserved() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[1] = ir_call(1, 1, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[2] = ir_call(2, 2, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[3] = ir_load_imm(3, 0)
    instrs[4] = ir_return(3)

    var func = dce_make_test_func(instrs, 5)
    test_dce_multiple_calls_preserved_inner(&! func)
}

// T45 inner: run DCE and verify deep transitive chain all live.
fn test_dce_deep_transitive_chain_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let i0 = dce_check_not_nop(func, 0)
    let i1 = dce_check_not_nop(func, 1)
    let i2 = dce_check_not_nop(func, 2)
    let i3 = dce_check_not_nop(func, 3)
    let i4 = dce_check_not_nop(func, 4)
    let i5 = dce_check_not_nop(func, 5)
    i0 && i1 && i2 && i3 && i4 && i5
}

// T45: Deep transitive chain (5 levels).
fn test_dce_deep_transitive_chain() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    instrs[2] = ir_binop(2, 1, BinaryOp::OpAdd, 1)
    instrs[3] = ir_binop(3, 2, BinaryOp::OpAdd, 2)
    instrs[4] = ir_binop(4, 3, BinaryOp::OpAdd, 3)
    instrs[5] = ir_binop(5, 4, BinaryOp::OpAdd, 4)
    instrs[6] = ir_return(5)

    var func = dce_make_test_func(instrs, 7)
    test_dce_deep_transitive_chain_inner(&! func)
}

// T46 inner: run DCE and verify interleaved live/dead.
fn test_dce_interleaved_live_dead_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    let l0 = dce_check_not_nop(func, 0)
    let d1 = dce_check_nop(func, 1)
    let l2 = dce_check_not_nop(func, 2)
    let d3 = dce_check_nop(func, 3)
    let l4 = dce_check_not_nop(func, 4)
    l0 && d1 && l2 && d3 && l4
}

// T46: Interleaved live and dead.
fn test_dce_interleaved_live_dead() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)     // live
    instrs[1] = ir_load_imm(1, 20)     // dead
    instrs[2] = ir_load_imm(2, 30)     // live
    instrs[3] = ir_load_imm(3, 40)     // dead
    instrs[4] = ir_binop(4, 0, BinaryOp::OpAdd, 2)  // live
    instrs[5] = ir_return(4)

    var func = dce_make_test_func(instrs, 6)
    test_dce_interleaved_live_dead_inner(&! func)
}

// T47 inner: run DCE and verify index set preserved when base used.
fn test_dce_index_set_preserved_inner(func: &! IrFunction) -> bool with Mut, Panic, Div {
    let stats = dce_run(func)
    dce_check_opcode(func, 2, IrOpcode::IrIndexSet)
}

// T47: Index set side effect preserved when base used.
fn test_dce_index_set_preserved() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)      // base
    instrs[1] = ir_load_imm(1, 0)      // index
    instrs[2] = ir_index_set(0, 1, 2)  // store (side effect)
    instrs[3] = ir_return(0)

    var func = dce_make_test_func(instrs, 4)
    test_dce_index_set_preserved_inner(&! func)
}

// T48: Convenience function dce_optimize_function works.
fn test_dce_optimize_function_convenience() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)     // live
    instrs[1] = ir_load_imm(1, 99)     // dead
    instrs[2] = ir_return(0)

    let func = dce_make_test_func(instrs, 3)
    let optimized = dce_optimize_function(func)

    let dead_ok = dce_check_nop(&optimized, 1)
    let live_ok = dce_check_not_nop(&optimized, 0)
    dead_ok && live_ok
}

// T49 inner: set up blocks, propagate reachability, check results.
fn test_dce_reachability_propagation_inner(ctx: &! DceContext) -> bool with Mut, Panic, Div {
    ctx.block_count = 3

    ctx.blocks[0].block_id = 0
    ctx.blocks[0].is_reachable = true
    ctx.blocks[0].succ_count = 1
    ctx.blocks[0].succs[0] = 1

    ctx.blocks[1].block_id = 1
    ctx.blocks[1].is_reachable = false
    ctx.blocks[1].succ_count = 1
    ctx.blocks[1].succs[0] = 2

    ctx.blocks[2].block_id = 2
    ctx.blocks[2].is_reachable = false
    ctx.blocks[2].succ_count = 0

    let reach = dce_propagate_reachability(ctx)

    // All three blocks should be reachable
    let b0 = ctx.blocks[0].is_reachable
    let b1 = ctx.blocks[1].is_reachable
    let b2 = ctx.blocks[2].is_reachable
    b0 && b1 && b2
}

// T49: Reachability propagation basics.
fn test_dce_reachability_propagation() -> bool with Mut, Panic, Div {
    var ctx = dce_context_new()
    test_dce_reachability_propagation_inner(&! ctx)
}

// T50: Opcode mapping covers all IR opcodes.
fn test_dce_opcode_mapping_complete() -> bool with Mut, Panic, Div {
    let v1 = dce_classify_opcode(IrOpcode::IrLoadImm) == DCE_OP_LOAD_IMM
    let v2 = dce_classify_opcode(IrOpcode::IrLoadFloat) == DCE_OP_LOAD_FLOAT
    let v3 = dce_classify_opcode(IrOpcode::IrLoadBool) == DCE_OP_LOAD_BOOL
    let v4 = dce_classify_opcode(IrOpcode::IrCopy) == DCE_OP_COPY
    let v5 = dce_classify_opcode(IrOpcode::IrBinOp) == DCE_OP_BINOP
    let v6 = dce_classify_opcode(IrOpcode::IrUnaryOp) == DCE_OP_UNARYOP
    let v7 = dce_classify_opcode(IrOpcode::IrCall) == DCE_OP_CALL
    let v8 = dce_classify_opcode(IrOpcode::IrReturn) == DCE_OP_RETURN
    let v9 = dce_classify_opcode(IrOpcode::IrJump) == DCE_OP_JUMP
    let v10 = dce_classify_opcode(IrOpcode::IrBranchTrue) == DCE_OP_BRANCH_TRUE
    let v11 = dce_classify_opcode(IrOpcode::IrBranchFalse) == DCE_OP_BRANCH_FALSE
    let v12 = dce_classify_opcode(IrOpcode::IrFieldGet) == DCE_OP_FIELD_GET
    let v13 = dce_classify_opcode(IrOpcode::IrFieldSet) == DCE_OP_FIELD_SET
    let v14 = dce_classify_opcode(IrOpcode::IrIndexGet) == DCE_OP_INDEX_GET
    let v15 = dce_classify_opcode(IrOpcode::IrIndexSet) == DCE_OP_INDEX_SET
    let v16 = dce_classify_opcode(IrOpcode::IrAlloc) == DCE_OP_ALLOC
    let v17 = dce_classify_opcode(IrOpcode::IrLabel) == DCE_OP_LABEL
    let v18 = dce_classify_opcode(IrOpcode::IrNop) == DCE_OP_NOP
    let v19 = dce_classify_opcode(IrOpcode::IrPhi) == DCE_OP_PHI

    v1 && v2 && v3 && v4 && v5 && v6 && v7 && v8 && v9 && v10 &&
    v11 && v12 && v13 && v14 && v15 && v16 && v17 && v18 && v19
}

