    dce_check_nop(func, 2)
}

// T19: Index get is dead if result unused.
fn test_dce_dead_index_get() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)       // base
    instrs[1] = ir_load_imm(1, 0)       // index
    instrs[2] = ir_index_get(2, 0, 1)   // dead: r2 unused
    instrs[3] = ir_load_imm(3, 0)
    instrs[4] = ir_return(3)

    var func = dce_make_test_func(instrs, 5)
    test_dce_dead_index_get_inner(&! func)
