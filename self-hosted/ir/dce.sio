// T34: Side-effect count in stats.
fn test_dce_side_effect_count() -> bool with Mut, Panic, Div {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)  // SE
    instrs[1] = ir_call(1, 1, ir_empty_name(), ir_empty_reg_list(), 0)  // SE
    instrs[2] = ir_load_imm(2, 0)
    instrs[3] = ir_return(2)           // SE

    var func = dce_make_test_func(instrs, 4)
    let stats = dce_run(&! func)

    // 3 side-effectful instructions (2 calls + 1 return)
    stats.side_effect_kept >= 3
}

