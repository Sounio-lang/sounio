// T15: Full pipeline combines all passes
fn test_pipeline_combined() -> bool with Mut, Panic, Div, Alloc {
    // Build: r0 = 3, r1 = 5, r2 = r0 + r1 (folds to 8),
    //        r3 = 100 (dead), return r2
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[3] = ir_load_imm(3, 100)
    instrs[4] = ir_return(2)

    let func = opt_make_test_func(instrs, 5)
    let optimized = optimize_function(func)

    // r2 should be folded to IrLoadImm(8)
    let fold_ok = opt_check_load_imm(optimized, 2, 8)
    // r3 should be eliminated (NOP) since it is dead after folding
    // After const_fold: r0=IrLoadImm(3), r1=IrLoadImm(5), r2=IrLoadImm(8), r3=IrLoadImm(100), ret
    // After strength_reduce: no change (no patterns match)
    // After dce: r0, r1, r3 are dead (r2 is folded, only r2 used by return)
    let r0_dead = opt_check_opcode(optimized, 0, IrOpcode::IrNop)
    let r1_dead = opt_check_opcode(optimized, 1, IrOpcode::IrNop)
    let r3_dead = opt_check_opcode(optimized, 3, IrOpcode::IrNop)

    fold_ok && r0_dead && r1_dead && r3_dead
}

// T16: Constant folding through copy propagation
fn test_const_fold_through_copy() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_copy(1, 0)           // r1 = r0 = 10
    instrs[2] = ir_load_imm(2, 20)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)  // r3 = 10 + 20 = 30
    instrs[4] = ir_return(3)

    let func = opt_make_test_func(instrs, 5)
    let folded = const_fold_pass(func)

    opt_check_load_imm(folded, 3, 30)
}

// T17: Constant folding of chained operations
fn test_const_fold_chain() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 2)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)  // r2 = 2 * 3 = 6
    instrs[3] = ir_load_imm(3, 4)
    instrs[4] = ir_binop(4, 2, BinaryOp::OpAdd, 3)  // r4 = 6 + 4 = 10
    instrs[5] = ir_return(4)

    let func = opt_make_test_func(instrs, 6)
    let folded = const_fold_pass(func)

    let step1_ok = opt_check_load_imm(folded, 2, 6)
    let step2_ok = opt_check_load_imm(folded, 4, 10)
    step1_ok && step2_ok
}

// T18: Constant folding with bitwise AND
fn test_const_fold_bitwise_and() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 255)     // 0xFF
    instrs[1] = ir_load_imm(1, 15)      // 0x0F
    instrs[2] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    opt_check_load_imm(folded, 2, 15)    // 0xFF & 0x0F = 0x0F
}

// T19: Module-level optimization applies to all functions
fn test_optimize_module_all_funcs() -> bool with Mut, Panic, Div, Alloc {
    var instrs_a: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs_a[0] = ir_load_imm(0, 10)
    instrs_a[1] = ir_load_imm(1, 20)
    instrs_a[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs_a[3] = ir_return(2)

    var instrs_b: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs_b[0] = ir_load_imm(0, 3)
    instrs_b[1] = ir_load_imm(1, 7)
    instrs_b[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs_b[3] = ir_return(2)

    var module = ir_empty_module()
    ir_fn_set(&! module, 0, opt_make_test_func(instrs_a, 4))
    ir_fn_set(&! module, 1, opt_make_test_func(instrs_b, 4))
    module.fn_count = 2

    let opt = optimize_module(module)

    let fn_a_ok = opt_check_load_imm(ir_fn_get(&opt, 0), 2, 30)
    let fn_b_ok = opt_check_load_imm(ir_fn_get(&opt, 1), 2, 21)
    fn_a_ok && fn_b_ok
}

// Test runner
fn test_optimize_main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 19

    print("=== IR Optimization Tests ===\n")

    if test_const_fold_add() { passed = passed + 1; print("  T01 OK const_fold_add\n") } else { print("  FAIL: T01 const_fold_add\n") }
    if test_const_fold_mul() { passed = passed + 1; print("  T02 OK const_fold_mul\n") } else { print("  FAIL: T02 const_fold_mul\n") }
    if test_const_fold_sub() { passed = passed + 1; print("  T03 OK const_fold_sub\n") } else { print("  FAIL: T03 const_fold_sub\n") }
    if test_const_fold_eq() { passed = passed + 1; print("  T04 OK const_fold_eq\n") } else { print("  FAIL: T04 const_fold_eq\n") }
    if test_const_fold_neg() { passed = passed + 1; print("  T05 OK const_fold_neg\n") } else { print("  FAIL: T05 const_fold_neg\n") }
    if test_const_fold_div_by_zero() { passed = passed + 1; print("  T06 OK const_fold_div_by_zero\n") } else { print("  FAIL: T06 const_fold_div_by_zero\n") }
    if test_dce_removes_dead_instr() { passed = passed + 1; print("  T07 OK dce_removes_dead\n") } else { print("  FAIL: T07 dce_removes_dead\n") }
    if test_dce_keeps_side_effects() { passed = passed + 1; print("  T08 OK dce_keeps_side_effects\n") } else { print("  FAIL: T08 dce_keeps_side_effects\n") }
    if test_strength_reduce_mul_by_2() { passed = passed + 1; print("  T09 OK sr_mul_by_2\n") } else { print("  FAIL: T09 sr_mul_by_2\n") }
    if test_strength_reduce_add_zero() { passed = passed + 1; print("  T10 OK sr_add_zero\n") } else { print("  FAIL: T10 sr_add_zero\n") }
    if test_strength_reduce_mul_by_1() { passed = passed + 1; print("  T11 OK sr_mul_by_1\n") } else { print("  FAIL: T11 sr_mul_by_1\n") }
    if test_strength_reduce_mul_by_0() { passed = passed + 1; print("  T12 OK sr_mul_by_0\n") } else { print("  FAIL: T12 sr_mul_by_0\n") }
    if test_strength_reduce_div_by_1() { passed = passed + 1; print("  T13 OK sr_div_by_1\n") } else { print("  FAIL: T13 sr_div_by_1\n") }
    if test_strength_reduce_sub_zero() { passed = passed + 1; print("  T14 OK sr_sub_zero\n") } else { print("  FAIL: T14 sr_sub_zero\n") }
    if test_pipeline_combined() { passed = passed + 1; print("  T15 OK pipeline_combined\n") } else { print("  FAIL: T15 pipeline_combined\n") }
    if test_const_fold_through_copy() { passed = passed + 1; print("  T16 OK const_fold_copy_prop\n") } else { print("  FAIL: T16 const_fold_copy_prop\n") }
    if test_const_fold_chain() { passed = passed + 1; print("  T17 OK const_fold_chain\n") } else { print("  FAIL: T17 const_fold_chain\n") }
    if test_const_fold_bitwise_and() { passed = passed + 1; print("  T18 OK const_fold_bitwise_and\n") } else { print("  FAIL: T18 const_fold_bitwise_and\n") }
    if test_optimize_module_all_funcs() { passed = passed + 1; print("  T19 OK optimize_module\n") } else { print("  FAIL: T19 optimize_module\n") }

    print("\nOptimization: ")
    print_int(passed)
    print(" / ")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
