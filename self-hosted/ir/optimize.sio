// T14: Strength reduction of x - 0 -> copy x
fn test_strength_reduce_sub_zero() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
