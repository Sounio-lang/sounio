// self-hosted::ir::optimize — IR optimization passes
//
// Three passes run in sequence:
//   1. Constant folding   — evaluate constant binary/unary ops at compile time
//   2. Strength reduction — replace expensive ops with cheaper equivalents
//   3. Dead code elimination — remove instructions whose results are unused
//
// The master pipeline is: const_fold -> strength_reduce -> dce.

// ============================================================================
// Pass 1: Constant Folding
// ============================================================================

// Track which registers hold known constant values.
struct ConstInfo {
    is_const: [bool; 8192],
    const_val: [i64; 8192],
    is_float_const: [bool; 8192],
    float_val: [f64; 8192],
}

fn const_info_new() -> ConstInfo {
    ConstInfo {
        is_const: [false; 8192],
        const_val: [0; 8192],
        is_float_const: [false; 8192],
        float_val: [0.0; 8192],
    }
}

// Try to fold a binary operation on two known integer constants.
// Returns (folded?, result).
fn try_fold_binop(op: BinaryOp, a: i64, b: i64) -> (bool, i64) with Div, Panic {
    match op {
        BinaryOp::OpAdd => (true, a + b),
        BinaryOp::OpSub => (true, a - b),
        BinaryOp::OpMul => (true, a * b),
        BinaryOp::OpDiv => {
            if b == 0 {
                (false, 0)
            } else {
                (true, a / b)
            }
        }
        BinaryOp::OpRem => {
            if b == 0 {
                (false, 0)
            } else {
                (true, a % b)
            }
        }
        BinaryOp::OpEq => {
            if a == b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpNe => {
            if a != b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpLt => {
            if a < b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpGt => {
            if a > b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpLe => {
            if a <= b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpGe => {
            if a >= b { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpAnd => {
            let la = if a != 0 { 1 } else { 0 }
            let lb = if b != 0 { 1 } else { 0 }
            if la == 1 && lb == 1 { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpOr => {
            let la = if a != 0 { 1 } else { 0 }
            let lb = if b != 0 { 1 } else { 0 }
            if la == 1 || lb == 1 { (true, 1) } else { (true, 0) }
        }
        BinaryOp::OpBitAnd => (true, a & b),
        BinaryOp::OpBitOr  => (true, a | b),
        BinaryOp::OpBitXor => (true, a ^ b),
        BinaryOp::OpShl => {
            if b >= 0 && b < 64 { (true, a << b) } else { (false, 0) }
        }
        BinaryOp::OpShr => {
            if b >= 0 && b < 64 { (true, a >> b) } else { (false, 0) }
        }
        _ => (false, 0),
    }
}

// Try to fold a unary operation on a known integer constant.
// Returns (folded?, result).
fn try_fold_unop(op: UnaryOp, a: i64) -> (bool, i64) {
    match op {
        UnaryOp::OpNeg => (true, 0 - a),
        UnaryOp::OpNot => {
            if a == 0 { (true, 1) } else { (true, 0) }
        }
        _ => (false, 0),
    }
}

// Build a replacement IrLoadImm instruction, preserving the destination
// register of the original instruction.
fn make_folded_load_imm(orig: IrInstr, value: i64) -> IrInstr {
    IrInstr {
        op: IrOpcode::IrLoadImm,
        dst: orig.dst,
        src1: IR_INVALID_REG,
        src2: IR_INVALID_REG,
        imm_i64: value,
        imm_f64: 0.0,
        label_id: IR_INVALID_LABEL,
        fn_id: IR_INVALID_FN,
        field_idx: -1,
        imm_flags: 0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name_id: 0,
        call_args: ir_empty_reg_list(),
        arg_count: 0,
    }
}

// Build a replacement IrCopy instruction.
fn make_copy_instr(dst: i64, src: i64) -> IrInstr {
    IrInstr {
        op: IrOpcode::IrCopy,
        dst: dst,
        src1: src,
        src2: IR_INVALID_REG,
        imm_i64: 0,
        imm_f64: 0.0,
        label_id: IR_INVALID_LABEL,
        fn_id: IR_INVALID_FN,
        field_idx: -1,
        imm_flags: 0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name_id: 0,
        call_args: ir_empty_reg_list(),
        arg_count: 0,
    }
}

// Constant folding pass.
// Scans instructions forward, tracking which registers hold known constants.
// When both operands of a binary op (or the operand of a unary op) are known
// constants, replaces the instruction with IrLoadImm of the computed result.
fn const_fold_pass(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    var info = const_info_new()
    var result = ir_function_clone(&func)

    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        let dst = instr.dst

        match instr.op {
            IrOpcode::IrLoadImm => {
                // Record constant
                if dst >= 0 && dst < 8192 {
                    info.is_const[dst as usize] = true
                    info.const_val[dst as usize] = instr.imm_i64
                }
            }
            IrOpcode::IrLoadBool => {
                if dst >= 0 && dst < 8192 {
                    info.is_const[dst as usize] = true
                    info.const_val[dst as usize] = instr.imm_i64
                }
            }
            IrOpcode::IrLoadFloat => {
                if dst >= 0 && dst < 8192 {
                    info.is_float_const[dst as usize] = true
                    info.float_val[dst as usize] = instr.imm_f64
                    info.is_const[dst as usize] = false
                }
            }
            IrOpcode::IrBinOp => {
                let s1 = instr.src1
                let s2 = instr.src2
                if s1 >= 0 && s1 < 8192 && s2 >= 0 && s2 < 8192 {
                    if info.is_const[s1 as usize] && info.is_const[s2 as usize] {
                        let a = info.const_val[s1 as usize]
                        let b = info.const_val[s2 as usize]
                        let fold_result = try_fold_binop(instr.bin_op, a, b)
                        let folded = fold_result.0
                        let val = fold_result.1
                        if folded {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), make_folded_load_imm(instr, val))
                            if dst >= 0 && dst < 8192 {
                                info.is_const[dst as usize] = true
                                info.const_val[dst as usize] = val
                            }
                        } else {
                            // Could not fold (e.g. division by zero); invalidate dst
                            if dst >= 0 && dst < 8192 {
                                info.is_const[dst as usize] = false
                                info.is_float_const[dst as usize] = false
                            }
                        }
                    } else {
                        if dst >= 0 && dst < 8192 {
                            info.is_const[dst as usize] = false
                            info.is_float_const[dst as usize] = false
                        }
                    }
                } else {
                    if dst >= 0 && dst < 8192 {
                        info.is_const[dst as usize] = false
                        info.is_float_const[dst as usize] = false
                    }
                }
            }
            IrOpcode::IrUnaryOp => {
                let s1 = instr.src1
                if s1 >= 0 && s1 < 8192 && info.is_const[s1 as usize] {
                    let a = info.const_val[s1 as usize]
                    let fold_result = try_fold_unop(instr.un_op, a)
                    let folded = fold_result.0
                    let val = fold_result.1
                    if folded {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_folded_load_imm(instr, val))
                        if dst >= 0 && dst < 8192 {
                            info.is_const[dst as usize] = true
                            info.const_val[dst as usize] = val
                        }
                    } else {
                        if dst >= 0 && dst < 8192 {
                            info.is_const[dst as usize] = false
                            info.is_float_const[dst as usize] = false
                        }
                    }
                } else {
                    if dst >= 0 && dst < 8192 {
                        info.is_const[dst as usize] = false
                        info.is_float_const[dst as usize] = false
                    }
                }
            }
            IrOpcode::IrCopy => {
                // Propagate constant through copies
                let s1 = instr.src1
                if s1 >= 0 && s1 < 8192 && info.is_const[s1 as usize] {
                    if dst >= 0 && dst < 8192 {
                        info.is_const[dst as usize] = true
                        info.const_val[dst as usize] = info.const_val[s1 as usize]
                    }
                } else if s1 >= 0 && s1 < 8192 && info.is_float_const[s1 as usize] {
                    if dst >= 0 && dst < 8192 {
                        info.is_float_const[dst as usize] = true
                        info.float_val[dst as usize] = info.float_val[s1 as usize]
                    }
                } else {
                    if dst >= 0 && dst < 8192 {
                        info.is_const[dst as usize] = false
                        info.is_float_const[dst as usize] = false
                    }
                }
            }
            _ => {
                // Any other instruction that writes a register invalidates it
                if dst >= 0 && dst < 8192 {
                    info.is_const[dst as usize] = false
                    info.is_float_const[dst as usize] = false
                }
            }
        }

        i = i + 1
    }

    result
}

// ============================================================================
// Pass 2: Dead Code Elimination
// ============================================================================

// Count how many times each register is referenced as a source operand.
struct UseCount {
    counts: [i64; 8192],
}

fn use_count_new() -> UseCount {
    UseCount { counts: [0; 8192] }
}

// Increment use count for a register if it is valid.
fn inc_use(uc: UseCount, reg: i64) -> UseCount with Mut, Panic, Div {
    var out = uc
    if reg >= 0 && reg < 8192 {
        out.counts[reg as usize] = out.counts[reg as usize] + 1
    }
    out
}

// Walk the call_args linked list and increment use counts for each argument.
fn inc_uses_for_call_args(uc: UseCount, args: Option<Box<IrRegList>>) -> UseCount with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            var out = inc_use(uc, (*list).head)
            out = inc_uses_for_call_args(out, (*list).tail)
            out
        }
        _ => uc,
    }
}

// Count uses of all registers across the function.
fn count_uses(func: IrFunction) -> UseCount with Mut, Panic, Div, Alloc {
    var uc = use_count_new()

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))

        // Count src1
        uc = inc_use(uc, instr.src1)

        // Count src2
        uc = inc_use(uc, instr.src2)

        // Count call arguments
        uc = inc_uses_for_call_args(uc, instr.call_args)

        // For IrIndexSet, imm_i64 holds the source register
        match instr.op {
        IrOpcode::IrIndexSet => {
            uc = inc_use(uc, instr.imm_i64)
        }
        _ => {}
        }

        i = i + 1
    }

    uc
}

// Check if an instruction has side effects (should not be eliminated).
fn instr_has_side_effects(instr: IrInstr) -> bool {
    match instr.op {
        IrOpcode::IrCall       => true,
        IrOpcode::IrCallSret   => true,
        IrOpcode::IrReturn     => true,
        IrOpcode::IrReturnSret => true,
        IrOpcode::IrJump       => true,
        IrOpcode::IrBranchTrue => true,
        IrOpcode::IrBranchFalse => true,
        IrOpcode::IrFieldSet   => true,
        IrOpcode::IrIndexSet   => true,
        IrOpcode::IrLabel      => true,
        _                      => false,
    }
}

// Dead code elimination pass.
// An instruction is dead if:
//   - It writes to a destination register
//   - That register has zero uses as a source
//   - The instruction has no side effects
// Dead instructions are replaced with IrNop.
fn dce_pass(func: IrFunction) -> IrFunction with Mut, Panic, Div, Alloc {
    let uc = count_uses(func)
    var result = ir_function_clone(&func)

    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        let dst = instr.dst

        if dst >= 0 && dst < 8192 {
            if uc.counts[dst as usize] == 0 {
                if !instr_has_side_effects(instr) {
                    // Dead instruction: replace with NOP
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
                }
            }
        }

        i = i + 1
    }

    result
}

// ============================================================================
// Pass 3: Strength Reduction
// ============================================================================

// Check if a BinaryOp is OpMul
fn is_op_mul(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpMul => true,
        _ => false,
    }
}

// Check if a BinaryOp is OpAdd
fn is_op_add(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpAdd => true,
        _ => false,
    }
}

// Check if a BinaryOp is OpSub
fn is_op_sub(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpSub => true,
        _ => false,
    }
}

// Check if a BinaryOp is OpDiv
fn is_op_div(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpDiv => true,
        _ => false,
    }
}

// Make an IrBinOp instruction with OpAdd for strength reduction (x * 2 -> x + x).
fn make_add_self(dst: i64, src: i64) -> IrInstr {
    IrInstr {
        op: IrOpcode::IrBinOp,
        dst: dst,
        src1: src,
        src2: src,
        imm_i64: 0,
        imm_f64: 0.0,
        label_id: IR_INVALID_LABEL,
        fn_id: IR_INVALID_FN,
        field_idx: -1,
        imm_flags: 0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name_id: 0,
        call_args: ir_empty_reg_list(),
        arg_count: 0,
    }
}

// Strength reduction pass.
// Replaces expensive operations with cheaper equivalents:
//   x * 2     -> x + x
//   x * 1     -> copy x
//   x * 0     -> load 0
//   x + 0     -> copy x
//   0 + x     -> copy x
//   x - 0     -> copy x
//   x / 1     -> copy x
//   x * (-1)  -> negate x (via 0 - x at IR level: load 0, sub)
fn strength_reduce_pass(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    // We need constant information to know which operands are known values.
    var info = const_info_new()
    var result = ir_function_clone(&func)

    // First pass: gather constant info (same as const_fold, but we only record,
    // we don't fold -- const_fold already ran).
    var j: i64 = 0
    while j < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (j)))
        let dst = instr.dst
        match instr.op {
            IrOpcode::IrLoadImm => {
                if dst >= 0 && dst < 8192 {
                    info.is_const[dst as usize] = true
                    info.const_val[dst as usize] = instr.imm_i64
                }
            }
            IrOpcode::IrLoadBool => {
                if dst >= 0 && dst < 8192 {
                    info.is_const[dst as usize] = true
                    info.const_val[dst as usize] = instr.imm_i64
                }
            }
            _ => {}
        }
        j = j + 1
    }

    // Second pass: apply strength reduction transforms.
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))

        match instr.op {
            IrOpcode::IrBinOp => {
                let s1 = instr.src1
                let s2 = instr.src2
                let dst = instr.dst
                let s1_const = s1 >= 0 && s1 < 8192 && info.is_const[s1 as usize]
                let s2_const = s2 >= 0 && s2 < 8192 && info.is_const[s2 as usize]
                let s1_val = if s1_const { info.const_val[s1 as usize] } else { 0 }
                let s2_val = if s2_const { info.const_val[s2 as usize] } else { 0 }

                if is_op_mul(instr.bin_op) {
                    // x * 0 -> load 0
                    if s2_const && s2_val == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_folded_load_imm(instr, 0))
                        if dst >= 0 && dst < 8192 {
                            info.is_const[dst as usize] = true
                            info.const_val[dst as usize] = 0
                        }
                    // 0 * x -> load 0
                    } else if s1_const && s1_val == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_folded_load_imm(instr, 0))
                        if dst >= 0 && dst < 8192 {
                            info.is_const[dst as usize] = true
                            info.const_val[dst as usize] = 0
                        }
                    // x * 1 -> copy x
                    } else if s2_const && s2_val == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s1))
                    // 1 * x -> copy x
                    } else if s1_const && s1_val == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s2))
                    // x * 2 -> x + x
                    } else if s2_const && s2_val == 2 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_add_self(dst, s1))
                    // 2 * x -> x + x
                    } else if s1_const && s1_val == 2 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_add_self(dst, s2))
                    }
                } else if is_op_add(instr.bin_op) {
                    // x + 0 -> copy x
                    if s2_const && s2_val == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s1))
                    // 0 + x -> copy x
                    } else if s1_const && s1_val == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s2))
                    }
                } else if is_op_sub(instr.bin_op) {
                    // x - 0 -> copy x
                    if s2_const && s2_val == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s1))
                    }
                } else if is_op_div(instr.bin_op) {
                    // x / 1 -> copy x
                    if s2_const && s2_val == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), make_copy_instr(dst, s1))
                    }
                }
            }
            _ => {}
        }

        i = i + 1
    }

    result
}

// ============================================================================
// Master optimization pipeline
// ============================================================================

// Optimize a single function: const_fold -> strength_reduce -> dce.
fn optimize_function(func: IrFunction) -> IrFunction with Mut, Panic, Div, Alloc {
    let f1 = const_fold_pass(func)
    let f2 = strength_reduce_pass(f1)
    let f3 = dce_pass(f2)
    f3
}

// Optimize all functions in a module.
fn optimize_module(module: IrModule) -> IrModule with Mut, Panic, Div, Alloc {
    var result = module
    var i: i64 = 0
    while i < result.fn_count {
        ir_fn_set(&! result, i as usize, optimize_function(ir_fn_get(&result, i as usize)))
        i = i + 1
    }
    result
}

// ============================================================================
// Helpers for tests
// ============================================================================

// Check if instruction at position is a specific opcode.
fn opt_check_opcode(func: IrFunction, pos: i64, expected: IrOpcode) -> bool {
    if pos < 0 || pos >= func.instr_count {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(func.region, (pos)))
    opcodes_equal(instr.op, expected)
}

// Check if instruction at position is IrLoadImm with a specific value.
fn opt_check_load_imm(func: IrFunction, pos: i64, expected_val: i64) -> bool {
    if pos < 0 || pos >= func.instr_count {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(func.region, (pos)))
    if !opcodes_equal(instr.op, IrOpcode::IrLoadImm) {
        return false
    }
    instr.imm_i64 == expected_val
}

// Build a test function with given instruction count.
fn opt_make_test_func(instrs: [IrInstr; 1024], count: i64) -> IrFunction {
    IrFunction {
        name: ir_empty_name(),
        instrs: instrs,
        instr_count: count,
        reg_count: count + 1,
        label_count: 0,
        param_count: 0,
        param_regs: [IR_INVALID_REG; 64],
        compile_strategy: IR_STRATEGY_STANDARD,
        returns_float: 0,
        return_struct_name: ir_empty_name(),
        return_fixed_array_len: 0 - 1,
        prof_counter_id: -1,
        hyper_algebra_kind: -1,
        is_sret: 0,
        sret_dest_reg: -1,
        bss_size: 0,
        first_param_is_ref: 0,
    }
}

// ============================================================================
// Tests
// ============================================================================

// T01: Constant folding of addition (3 + 5 = 8)
fn test_const_fold_add() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    // Instruction 2 should now be IrLoadImm with value 8
    opt_check_load_imm(folded, 2, 8)
}

// T02: Constant folding of multiplication (7 * 6 = 42)
fn test_const_fold_mul() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 6)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    opt_check_load_imm(folded, 2, 42)
}

// T03: Constant folding of subtraction (10 - 3 = 7)
fn test_const_fold_sub() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    opt_check_load_imm(folded, 2, 7)
}

// T04: Constant folding of comparison (5 == 5 -> 1)
fn test_const_fold_eq() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpEq, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    opt_check_load_imm(folded, 2, 1)
}

// T05: Constant folding of unary negation (neg 42 = -42)
fn test_const_fold_neg() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    instrs[2] = ir_return(1)

    let func = opt_make_test_func(instrs, 3)
    let folded = const_fold_pass(func)

    // -42 is 0 - 42
    opt_check_load_imm(folded, 1, 0 - 42)
}

// T06: Constant folding does not fold division by zero
fn test_const_fold_div_by_zero() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_load_imm(1, 0)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let folded = const_fold_pass(func)

    // Should NOT be folded; should still be IrBinOp
    opt_check_opcode(folded, 2, IrOpcode::IrBinOp)
}

// T07: DCE removes a dead instruction
fn test_dce_removes_dead_instr() -> bool with Mut, Panic, Div, Alloc {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 100)   // used by return
    instrs[1] = ir_load_imm(1, 200)   // dead: r1 never used
    instrs[2] = ir_return(0)

    let func = opt_make_test_func(instrs, 3)
    let eliminated = dce_pass(func)

    // Instruction 1 should be replaced with IrNop (dead)
    let dead_is_nop = opt_check_opcode(eliminated, 1, IrOpcode::IrNop)
    // Instruction 0 should still be IrLoadImm (alive)
    let alive_ok = opt_check_opcode(eliminated, 0, IrOpcode::IrLoadImm)
    dead_is_nop && alive_ok
}

// T08: DCE does not remove instructions with side effects
fn test_dce_keeps_side_effects() -> bool with Mut, Panic, Div, Alloc {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    // A call whose return value is unused should NOT be eliminated
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[1] = ir_load_imm(1, 0)
    instrs[2] = ir_return(1)

    let func = opt_make_test_func(instrs, 3)
    let eliminated = dce_pass(func)

    // The call should still be present
    opt_check_opcode(eliminated, 0, IrOpcode::IrCall)
}

// T09: Strength reduction of x * 2 -> x + x
fn test_strength_reduce_mul_by_2() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_load_imm(0, 2)     // const 2
    instrs[1] = ir_load_imm(1, 100)   // this will NOT be recognized as const by SR
                                        // because SR only tracks IrLoadImm
    // Actually: we need src1 to NOT be const for this to trigger.
    // Let's use a call result for src1 and const 2 for src2.
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[1] = ir_load_imm(1, 2)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let reduced = strength_reduce_pass(func)

    // Instruction 2 should become IrBinOp with OpAdd (x + x)
    if !opt_check_opcode(reduced, 2, IrOpcode::IrBinOp) {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(reduced.region, (2)))
    // src1 and src2 should both be 0 (the non-constant operand)
    instr.src1 == 0 && instr.src2 == 0
}

// T10: Strength reduction of x + 0 -> copy x
fn test_strength_reduce_add_zero() -> bool with Mut, Panic, Div {
    var instrs: [IrInstr; 1024] = [ir_nop(); 1024]
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    instrs[1] = ir_load_imm(1, 0)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[3] = ir_return(2)

    let func = opt_make_test_func(instrs, 4)
    let reduced = strength_reduce_pass(func)

    // Instruction 2 should become IrCopy
    if !opt_check_opcode(reduced, 2, IrOpcode::IrCopy) {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(reduced.region, (2)))
    instr.src1 == 0
}

