// IR entry point

use ir::ir::*

var IR_PENDING_ITEMS: Option<Box<ItemList>> = None

fn ir_set_pending_items(items: Option<Box<ItemList>>) with Mut {
    IR_PENDING_ITEMS = items
}

fn ir_has_pending_items() -> bool with Alloc {
    IR_PENDING_ITEMS != None
}

fn sanitize_module(raw: IrModule) -> IrModule with Alloc, Mut, Panic, Div {
    var out = ir_empty_module()

    var fn_count = raw.fn_count
    if fn_count < 0 { fn_count = 0 }
    if fn_count > IR_MAX_FUNCS { fn_count = IR_MAX_FUNCS }
    out.fn_count = fn_count

    var i: i64 = 0
    while i < fn_count {
        ir_fn_set(&! out, i, ir_fn_get(&raw, i))
        i = i + 1
    }

    var str_count = raw.string_count
    if str_count < 0 { str_count = 0 }
    if str_count > IR_MAX_STRINGS { str_count = IR_MAX_STRINGS }
    out.string_count = str_count

    var j: i64 = 0
    while j < str_count {
        out.string_table[j] = raw.string_table[j]
        j = j + 1
    }

    out.epistemic = raw.epistemic

    out
}

fn lower_program(prog: Program) -> IrModule with Mut, Panic, Div, Alloc, IO {
    var items = prog.items
    if items == None {
        items = IR_PENDING_ITEMS
        IR_PENDING_ITEMS = None
    }

    let p = Program { module_path: prog.module_path, items: items }
    let lowered = lower_program_to_ir(p)
    sanitize_module(lowered.module)
}
