}

// T67 inner: analyze with escaping store prevents promotion.
fn test_mema_analyze_escape_store_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let rg = mema_alloc_region(ctx, MemRegionKind::RegGlobal, 64, 8, 2)
    let p = mema_alloc_pointer(ctx)
    let pg = mema_alloc_pointer(ctx)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p, r, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, pg, rg, 0, 0, 2)
    mema_add_instr(ctx, MemPtrOp::PtrStore, pg, p, 0, 0, 3)
    let converged = mema_analyze_function(ctx)
    converged &&
    mema_escape_eq(ctx.allocs[0].escape, MemEscapeStatus::EscapeStore) &&
    mema_promote_eq(ctx.allocs[0].promote, MemPromoteResult::PromoteNo)
}

fn test_mema_analyze_escape_store() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_analyze_escape_store_inner(&! ctx)
}

// T68 inner: analyze empty function converges immediately.
fn test_mema_analyze_empty_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let converged = mema_analyze_function(ctx)
    converged && ctx.iterations <= 1
}

fn test_mema_analyze_empty() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_analyze_empty_inner(&! ctx)
}

// T69 inner: multiple allocs, mixed escape, correct promotion count.
fn test_mema_analyze_mixed_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r0 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 8, 4, 1)
    let r1 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 16, 4, 2)
    let r2 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 3)
    let r3 = mema_alloc_region(ctx, MemRegionKind::RegGlobal, 64, 8, 4)
    let p0 = mema_alloc_pointer(ctx)
    let p1 = mema_alloc_pointer(ctx)
    let p2 = mema_alloc_pointer(ctx)
    let pg = mema_alloc_pointer(ctx)
    let a0 = mema_add_alloc(ctx, r0, 8, 1, true)
    let a1 = mema_add_alloc(ctx, r1, 16, 2, true)
    let a2 = mema_add_alloc(ctx, r2, 32, 3, true)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p0, r0, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p1, r1, 0, 0, 2)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p2, r2, 0, 0, 3)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, pg, r3, 0, 0, 4)
    // Store p1 to global (escapes).
    mema_add_instr(ctx, MemPtrOp::PtrStore, pg, p1, 0, 0, 5)
    let converged = mema_analyze_function(ctx)
    // a0 and a2 should be promotable, a1 should not.
    let promotable = mema_count_promotable(ctx)
    converged && promotable == 2
}

fn test_mema_analyze_mixed() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_analyze_mixed_inner(&! ctx)
}

// T70 inner: GEP creates field-sensitive no-alias.
fn test_mema_analyze_gep_field_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegStack, 128, 8, 1)
    let p0 = mema_alloc_pointer(ctx)
    let p1 = mema_alloc_pointer(ctx)
    let p2 = mema_alloc_pointer(ctx)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p0, r, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrGep, p1, p0, 0, 0, 2)
    mema_add_instr(ctx, MemPtrOp::PtrGep, p2, p0, 0, 8, 3)
    let converged = mema_analyze_function(ctx)
    // p1 points to r at offset 0, p2 points to r at offset 8.
    // They should be no-alias due to different field offsets.
    converged && mema_no_alias(ctx, p1, p2)
}

fn test_mema_analyze_gep_field() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_analyze_gep_field_inner(&! ctx)
}

// ============================================================================
// Section 26: Test Runner
// ============================================================================

fn mema_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // Category 1: Region/Pointer Basics (10 tests)
    if test_mema_alloc_region() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_multi_region() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_alloc_pointer() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_ptr_add_and_has_region() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_ptr_region_count() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_ptr_empty_initial() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_region_kind() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_add_alloc() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_add_instr() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_ptr_union() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 2: Bitset Operations (8 tests)
    if test_mema_bits_set_test() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_count() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_union() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_union_no_change() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_intersect() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_intersects_query() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_bits_first() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 3: Points-To Analysis (12 tests)
    if test_mema_simple_alloc_pts() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_copy_pts() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_phi_pts() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_cast_pts() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_gep_pts() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_copy_chain() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_separate_allocs() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_empty_converges() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_null_ptr() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_phi_with_null() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_singleton() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_non_singleton() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 4: Alias Queries (10 tests)
    if test_mema_self_must_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_singleton_must_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_disjoint_no_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_overlapping_may_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_field_no_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_empty_no_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_alias_after_copy() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_alias_after_phi() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_global_param_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_three_way_no_alias() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 5: Escape Analysis (10 tests)
    if test_mema_no_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_store_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_escape_merge_worst() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_escape_severity_order() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_mark_alloc_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_escape_no_downgrade() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_count_non_escaping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_escape_roundtrip() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_escape_invalid() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_mark_region_escape() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 6: Stack Promotion (8 tests)
    if test_mema_promote_non_escaping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_no_promote_escaping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_no_promote_stack() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_promote_zero_size() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_compute_promotions() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_promote_store_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_promote_call_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_promote_invalid() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 7: Worklist (5 tests)
    if test_mema_wl_push_pop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_wl_empty_pop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_wl_empty_check() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_wl_fifo() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_wl_size() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 8: Integration (7 tests)
    if test_mema_analyze_simple() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_copy_chain() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_phi_alias() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_escape_store() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_mixed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_mema_analyze_gep_field() { passed = passed + 1 } else { failed = failed + 1 }

    if failed > 0 { return 0 - failed }
    passed
}
