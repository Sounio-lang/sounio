    mema_ptr_add_region(ctx, p0, rg)
    mema_ptr_add_region(ctx, p0, rp)
    mema_ptr_add_region(ctx, p1, rp)
    mema_may_alias(ctx, p0, p1)
}

fn test_mema_global_param_alias() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_global_param_alias_inner(&! ctx)
}

// T40 inner: three-way disjoint is no-alias pairwise.
fn test_mema_three_way_no_alias_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r0 = mema_alloc_region(ctx, MemRegionKind::RegStack, 8, 4, 1)
