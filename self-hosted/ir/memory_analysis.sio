// T35 inner: field-sensitive no-alias (same region, different offsets).
fn test_mema_field_no_alias_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegStack, 64, 4, 1)
    let p0 = mema_alloc_pointer(ctx)
