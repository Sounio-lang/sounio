    mema_ptr_add_region(ctx, p0, r)
    mema_ptr_add_region(ctx, p1, r)
    ctx.pointers[0].field_offset = 0
    ctx.pointers[1].field_offset = 8
    mema_no_alias(ctx, p0, p1)
}

fn test_mema_field_no_alias() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_field_no_alias_inner(&! ctx)
}

// T36 inner: empty pointer no-aliases everything.
fn test_mema_empty_no_alias_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegStack, 8, 4, 1)
    let p0 = mema_alloc_pointer(ctx)
    let p1 = mema_alloc_pointer(ctx)
    mema_ptr_add_region(ctx, p0, r)
    // p1 has no regions.
    mema_no_alias(ctx, p0, p1)
}

fn test_mema_empty_no_alias() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_empty_no_alias_inner(&! ctx)
}

// T37 inner: alias after copy propagation.
fn test_mema_alias_after_copy_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let p0 = mema_alloc_pointer(ctx)
    let p1 = mema_alloc_pointer(ctx)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p0, r, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrCopy, p1, p0, 0, 0, 2)
    let converged = mema_compute_points_to(ctx)
    converged && mema_must_alias(ctx, p0, p1)
}

fn test_mema_alias_after_copy() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_alias_after_copy_inner(&! ctx)
}

// T38 inner: alias after phi is may-alias, not must.
fn test_mema_alias_after_phi_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r0 = mema_alloc_region(ctx, MemRegionKind::RegStack, 8, 4, 1)
    let r1 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 16, 4, 2)
    let p0 = mema_alloc_pointer(ctx)
    let p1 = mema_alloc_pointer(ctx)
    let p2 = mema_alloc_pointer(ctx)
    let p3 = mema_alloc_pointer(ctx)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p0, r0, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p1, r1, 0, 0, 2)
    mema_add_instr(ctx, MemPtrOp::PtrPhi, p2, p0, p1, 0, 3)
    mema_add_instr(ctx, MemPtrOp::PtrCopy, p3, p0, 0, 0, 4)
    let converged = mema_compute_points_to(ctx)
    // p2 has {r0, r1}, p3 has {r0} — they overlap, so may-alias but not must.
    converged && mema_may_alias(ctx, p2, p3) && (mema_must_alias(ctx, p2, p3) == false)
}

fn test_mema_alias_after_phi() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_alias_after_phi_inner(&! ctx)
}

