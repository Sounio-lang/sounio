// self-hosted::ir::memory_analysis — Memory alias analysis and escape analysis
//
// A comprehensive memory analysis module for the Sounio self-hosted compiler.
// Implements Andersen-style inclusion-based points-to analysis with
// field-sensitive extensions, alias queries, escape analysis, and
// heap-to-stack promotion.
//
// Algorithm outline:
//   1. Build the constraint graph: for each memory instruction (alloc, load,
//      store, GEP, cast, phi, copy), create an abstract pointer node and
//      edge in the constraint graph.
//   2. Initialize points-to sets: each alloc creates a fresh region, and
//      the allocating pointer is set to point to that region.
//   3. Andersen fixed-point: iteratively propagate points-to sets through
//      the constraint graph until no set changes.  Stores generate new
//      constraints, loads resolve through pointed-to regions.
//   4. Alias queries: two pointers must-alias if their points-to sets are
//      both singletons and identical; may-alias if their sets intersect;
//      no-alias if disjoint.
//   5. Escape analysis: track whether each allocation escapes the current
//      function (returned, stored to global, passed to external call).
//      Propagate escape status through the pointer graph.
//   6. Stack promotion: non-escaping heap allocations with known size can
//      be promoted to stack allocations.
//
// Points-to sets are represented as bit vectors: 8 x i64 = 512 bits,
// one bit per abstract memory region.  This keeps the representation
// compact and allows fast union/intersection via bitwise OR/AND.
//
// All arrays are fixed-size -- no heap allocation.
//
// References:
//   Andersen: "Program Analysis and Specialization for the C Programming
//              Language" (PhD thesis, 1994)
//   Steensgaard: "Points-to Analysis in Almost Linear Time" (1996)
//   Choi et al.: "Escape Analysis for Java" (OOPSLA 1999)
//   Blanchet: "Escape Analysis for JavaTM: Theory and Practice" (2003)
//   Lhotak & Hendren: "Scaling Java Points-to Analysis Using Spark" (2003)

// ============================================================================
// Section 1: Constants
// ============================================================================

let MEMA_MAX_REGIONS: i64 = 512
let MEMA_MAX_POINTERS: i64 = 1024
let MEMA_MAX_ALLOCS: i64 = 256
let MEMA_MAX_EDGES: i64 = 4096
let MEMA_MAX_INSTRS: i64 = 2048
let MEMA_WORKLIST_SIZE: i64 = 1024
let MEMA_MAX_FIELDS: i64 = 64
let MEMA_INVALID: i64 = 0 - 1
let MEMA_MAX_ITERATIONS: i64 = 100
let MEMA_BITS_PER_WORD: i64 = 64

// ============================================================================
// Section 2: Enums
// ============================================================================

// Classification of a memory region by allocation site.
enum MemRegionKind {
    RegStack,
    RegHeap,
    RegGlobal,
    RegParam,
    RegReturn,
    RegUnknown,
}

// Result of an alias query between two pointer expressions.
enum MemAliasResult {
    AliasMust,
    AliasMay,
    AliasNo,
}

// Escape status of an allocation.
enum MemEscapeStatus {
    EscapeNone,
    EscapeReturn,
    EscapeStore,
    EscapeCall,
    EscapeUnknown,
}

// Kind of pointer operation in the constraint graph.
enum MemPtrOp {
    PtrAlloc,
    PtrLoad,
    PtrStore,
    PtrGep,
    PtrCast,
    PtrPhi,
    PtrCopy,
    PtrNull,
}

// Result of stack promotion analysis.
enum MemPromoteResult {
    PromoteYes,
    PromoteNo,
    PromoteMaybe,
}

// ============================================================================
// Section 3: Data Structures
// ============================================================================

// An abstract memory region representing a possible target of a pointer.
// Each allocation site creates one region.  The escape field tracks whether
// data stored in this region can be observed outside the function.
struct MemRegion {
    id: i64,
    kind: MemRegionKind,
    size: i64,
    align: i64,
    alloc_site: i64,
    escape: MemEscapeStatus,
}

// An abstract pointer in the constraint graph.
// region_bits is a bit vector: 8 words x 64 bits = 512 possible regions.
// If bit i is set, this pointer may point to region i.
struct MemPointer {
    id: i64,
    region_bits: [i64; 8],
    field_offset: i64,
    is_null_possible: bool,
}

// A directed edge in the constraint graph connecting two pointers.
// The kind describes the relationship (copy, load, store, etc.).
struct MemEdge {
    from_ptr: i64,
    to_ptr: i64,
    kind: MemPtrOp,
    field: i64,
}

// An allocation tracked for escape analysis and promotion.
struct MemAlloc {
    id: i64,
    region_id: i64,
    size: i64,
    line: i64,
    is_heap: bool,
    escape: MemEscapeStatus,
    promote: MemPromoteResult,
}

// A single memory instruction from the IR, abstracted for analysis.
struct MemInstr {
    op: MemPtrOp,
    dst: i64,
    src1: i64,
    src2: i64,
    field: i64,
    line: i64,
}

// The main analysis context.  Flat arena -- all storage is pre-allocated
// at fixed sizes.  No heap allocation during analysis.
struct MemAnalysisContext {
    regions: [MemRegion; 512],
    region_count: i64,
    pointers: [MemPointer; 1024],
    ptr_count: i64,
    allocs: [MemAlloc; 256],
    alloc_count: i64,
    edges: [MemEdge; 4096],
    edge_count: i64,
    instrs: [MemInstr; 2048],
    instr_count: i64,
    worklist: [i64; 1024],
    wl_head: i64,
    wl_tail: i64,
    iterations: i64,
    max_iterations: i64,
    changed: bool,
}

// ============================================================================
// Section 4: Default Constructors
// ============================================================================

fn mema_region_default() -> MemRegion {
    MemRegion {
        id: MEMA_INVALID,
        kind: MemRegionKind::RegUnknown,
        size: 0,
        align: 0,
        alloc_site: MEMA_INVALID,
        escape: MemEscapeStatus::EscapeNone,
    }
}

fn mema_pointer_default() -> MemPointer {
    MemPointer {
        id: MEMA_INVALID,
        region_bits: [0; 8],
        field_offset: 0,
        is_null_possible: false,
    }
}

fn mema_edge_default() -> MemEdge {
    MemEdge {
        from_ptr: MEMA_INVALID,
        to_ptr: MEMA_INVALID,
        kind: MemPtrOp::PtrNull,
        field: 0,
    }
}

fn mema_alloc_default() -> MemAlloc {
    MemAlloc {
        id: MEMA_INVALID,
        region_id: MEMA_INVALID,
        size: 0,
        line: 0,
        is_heap: false,
        escape: MemEscapeStatus::EscapeNone,
        promote: MemPromoteResult::PromoteMaybe,
    }
}

fn mema_instr_default() -> MemInstr {
    MemInstr {
        op: MemPtrOp::PtrNull,
        dst: MEMA_INVALID,
        src1: MEMA_INVALID,
        src2: MEMA_INVALID,
        field: 0,
        line: 0,
    }
}

// ============================================================================
// Section 5: Context Constructor
// ============================================================================

fn mema_context_new() -> MemAnalysisContext {
    MemAnalysisContext {
        regions: [mema_region_default(); 512],
        region_count: 0,
        pointers: [mema_pointer_default(); 1024],
        ptr_count: 0,
        allocs: [mema_alloc_default(); 256],
        alloc_count: 0,
        edges: [mema_edge_default(); 4096],
        edge_count: 0,
        instrs: [mema_instr_default(); 2048],
        instr_count: 0,
        worklist: [0; 1024],
        wl_head: 0,
        wl_tail: 0,
        iterations: 0,
        max_iterations: MEMA_MAX_ITERATIONS,
        changed: false,
    }
}

// ============================================================================
// Section 6: Bitset Operations
// ============================================================================

// Set bit `region_id` in the 512-bit bitset.
// The bitset is 8 words of 64 bits each.
fn mema_region_bits_set(bits: &! [i64; 8], region_id: i64) with Mut, Div, Panic {
    if region_id < 0 { return }
    if region_id >= MEMA_MAX_REGIONS { return }
    let word = region_id / MEMA_BITS_PER_WORD
    let bit = region_id % MEMA_BITS_PER_WORD
    // Set the bit using OR.  We build the mask by shifting 1 left.
    // Sounio uses `<<` for left-shift.
    let mask = 1 << bit
    bits[word as usize] = bits[word as usize] | mask
}

// Test whether bit `region_id` is set in the bitset.
fn mema_region_bits_test(bits: &[i64; 8], region_id: i64) -> bool with Div, Panic {
    if region_id < 0 { return false }
    if region_id >= MEMA_MAX_REGIONS { return false }
    let word = region_id / MEMA_BITS_PER_WORD
    let bit = region_id % MEMA_BITS_PER_WORD
    let mask = 1 << bit
    let val = bits[word as usize] & mask
    val != 0
}

// Union src into dst: dst = dst | src.  Returns true if dst changed.
fn mema_region_bits_or(dst: &! [i64; 8], src: &[i64; 8]) -> bool with Mut, Div, Panic {
    var changed = false
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        let old = dst[i as usize]
        dst[i as usize] = old | src[i as usize]
        if dst[i as usize] != old {
            changed = true
        }
        i = i + 1
    }
    changed
}

// Intersect: dst = dst & src.
fn mema_region_bits_and(dst: &! [i64; 8], src: &[i64; 8]) with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        dst[i as usize] = dst[i as usize] & src[i as usize]
        i = i + 1
    }
}

// Count number of set bits across all 8 words (popcount).
fn mema_popcount_word(w: i64) -> i64 {
    // Kernighan's algorithm: clear lowest set bit each iteration.
    var count: i64 = 0
    var v = w
    loop {
        if v == 0 { break }
        v = v & (v - 1)
        count = count + 1
    }
    count
}

fn mema_region_bits_count(bits: &[i64; 8]) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        count = count + mema_popcount_word(bits[i as usize])
        i = i + 1
    }
    count
}

// Test whether two bitsets have a non-empty intersection.
fn mema_region_bits_intersects(a: &[i64; 8], b: &[i64; 8]) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        if (a[i as usize] & b[i as usize]) != 0 {
            return true
        }
        i = i + 1
    }
    false
}

// Test whether two bitsets are exactly equal.
fn mema_region_bits_equal(a: &[i64; 8], b: &[i64; 8]) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Test whether bitset is empty (all zeros).
fn mema_region_bits_empty(bits: &[i64; 8]) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        if bits[i as usize] != 0 {
            return false
        }
        i = i + 1
    }
    true
}

// Clear all bits.
fn mema_region_bits_clear(bits: &! [i64; 8]) with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        bits[i as usize] = 0
        i = i + 1
    }
}

// Copy src bitset into dst.
fn mema_region_bits_copy(dst: &! [i64; 8], src: &[i64; 8]) with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        dst[i as usize] = src[i as usize]
        i = i + 1
    }
}

// Return the index of the first set bit, or -1 if empty.
fn mema_region_bits_first(bits: &[i64; 8]) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        if bits[i as usize] != 0 {
            // Find lowest set bit in this word.
            var bit: i64 = 0
            loop {
                if bit >= 64 { break }
                let mask = 1 << bit
                if (bits[i as usize] & mask) != 0 {
                    return i * 64 + bit
                }
                bit = bit + 1
            }
        }
        i = i + 1
    }
    0 - 1
}

// Test whether a is a subset of b (every bit in a is also in b).
fn mema_region_bits_subset(a: &[i64; 8], b: &[i64; 8]) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        // a[i] & ~b[i] != 0 means a has bits not in b
        let extra = a[i as usize] & (b[i as usize] ^ (0 - 1))
        if extra != 0 {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Section 7: Worklist Operations
// ============================================================================

// Push an item onto the circular worklist.  Silently drops if full.
fn mema_worklist_push(ctx: &! MemAnalysisContext, item: i64) with Mut, Div, Panic {
    let next_tail = (ctx.wl_tail + 1) % MEMA_WORKLIST_SIZE
    // If next_tail == wl_head, the worklist is full; drop the item.
    if next_tail == ctx.wl_head {
        return
    }
    ctx.worklist[ctx.wl_tail as usize] = item
    ctx.wl_tail = next_tail
}

// Pop an item from the worklist.  Returns -1 if empty.
fn mema_worklist_pop(ctx: &! MemAnalysisContext) -> i64 with Mut, Div, Panic {
    if ctx.wl_head == ctx.wl_tail {
        return 0 - 1
    }
    let item = ctx.worklist[ctx.wl_head as usize]
    ctx.wl_head = (ctx.wl_head + 1) % MEMA_WORKLIST_SIZE
    item
}

// Test whether the worklist is empty.
fn mema_worklist_empty(ctx: &MemAnalysisContext) -> bool {
    ctx.wl_head == ctx.wl_tail
}

// Clear the worklist.
fn mema_worklist_clear(ctx: &! MemAnalysisContext) with Mut {
    ctx.wl_head = 0
    ctx.wl_tail = 0
}

// Number of items currently in the worklist.
fn mema_worklist_size(ctx: &MemAnalysisContext) -> i64 {
    if ctx.wl_tail >= ctx.wl_head {
        ctx.wl_tail - ctx.wl_head
    } else {
        MEMA_WORKLIST_SIZE - ctx.wl_head + ctx.wl_tail
    }
}

// ============================================================================
// Section 8: Region and Pointer Allocation
// ============================================================================

// Create a new abstract memory region and return its id.
fn mema_alloc_region(ctx: &! MemAnalysisContext, kind: MemRegionKind, size: i64, align: i64, site: i64) -> i64 with Mut, Div, Panic {
    if ctx.region_count >= MEMA_MAX_REGIONS {
        return 0 - 1
    }
    let id = ctx.region_count
    ctx.regions[id as usize] = MemRegion {
        id: id,
        kind: kind,
        size: size,
        align: align,
        alloc_site: site,
        escape: MemEscapeStatus::EscapeNone,
    }
    ctx.region_count = id + 1
    id
}

// Create a new abstract pointer and return its id.
fn mema_alloc_pointer(ctx: &! MemAnalysisContext) -> i64 with Mut, Div, Panic {
    if ctx.ptr_count >= MEMA_MAX_POINTERS {
        return 0 - 1
    }
    let id = ctx.ptr_count
    ctx.pointers[id as usize] = MemPointer {
        id: id,
        region_bits: [0; 8],
        field_offset: 0,
        is_null_possible: false,
    }
    ctx.ptr_count = id + 1
    id
}

// Create a new allocation record and return its id.
fn mema_add_alloc(ctx: &! MemAnalysisContext, region_id: i64, size: i64, line: i64, is_heap: bool) -> i64 with Mut, Div, Panic {
    if ctx.alloc_count >= MEMA_MAX_ALLOCS {
        return 0 - 1
    }
    let id = ctx.alloc_count
    ctx.allocs[id as usize] = MemAlloc {
        id: id,
        region_id: region_id,
        size: size,
        line: line,
        is_heap: is_heap,
        escape: MemEscapeStatus::EscapeNone,
        promote: MemPromoteResult::PromoteMaybe,
    }
    ctx.alloc_count = id + 1
    id
}

// Add an instruction to the analysis.
fn mema_add_instr(ctx: &! MemAnalysisContext, op: MemPtrOp, dst: i64, src1: i64, src2: i64, field: i64, line: i64) with Mut, Div, Panic {
    if ctx.instr_count >= MEMA_MAX_INSTRS {
        return
    }
    let idx = ctx.instr_count
    ctx.instrs[idx as usize] = MemInstr {
        op: op,
        dst: dst,
        src1: src1,
        src2: src2,
        field: field,
        line: line,
    }
    ctx.instr_count = idx + 1
}

// Add an edge to the constraint graph.
fn mema_add_edge(ctx: &! MemAnalysisContext, from_ptr: i64, to_ptr: i64, kind: MemPtrOp, field: i64) with Mut, Div, Panic {
    if ctx.edge_count >= MEMA_MAX_EDGES {
        return
    }
    let idx = ctx.edge_count
    ctx.edges[idx as usize] = MemEdge {
        from_ptr: from_ptr,
        to_ptr: to_ptr,
        kind: kind,
        field: field,
    }
    ctx.edge_count = idx + 1
}

// ============================================================================
// Section 9: Points-To Set Operations
// ============================================================================

// Add a region to a pointer's points-to set.
fn mema_ptr_add_region(ctx: &! MemAnalysisContext, ptr_id: i64, region_id: i64) with Mut, Div, Panic {
    if ptr_id < 0 { return }
    if ptr_id >= ctx.ptr_count { return }
    if region_id < 0 { return }
    if region_id >= ctx.region_count { return }
    mema_region_bits_set(&! ctx.pointers[ptr_id as usize].region_bits, region_id)
}

// Query whether a pointer may point to a region.
fn mema_ptr_has_region(ctx: &MemAnalysisContext, ptr_id: i64, region_id: i64) -> bool with Div, Panic {
    if ptr_id < 0 { return false }
    if ptr_id >= ctx.ptr_count { return false }
    if region_id < 0 { return false }
    if region_id >= ctx.region_count { return false }
    mema_region_bits_test(&ctx.pointers[ptr_id as usize].region_bits, region_id)
}

// Count how many regions a pointer may point to.
fn mema_ptr_region_count(ctx: &MemAnalysisContext, ptr_id: i64) -> i64 with Mut, Div, Panic {
    if ptr_id < 0 { return 0 }
    if ptr_id >= ctx.ptr_count { return 0 }
    mema_region_bits_count(&ctx.pointers[ptr_id as usize].region_bits)
}

// Union the points-to set of src into dst.  Returns true if dst changed.
fn mema_ptr_union(ctx: &! MemAnalysisContext, dst: i64, src: i64) -> bool with Mut, Div, Panic {
    if dst < 0 { return false }
    if dst >= ctx.ptr_count { return false }
    if src < 0 { return false }
    if src >= ctx.ptr_count { return false }

    // We need to read src bits then write dst bits.
    // Copy src bits to a temporary to avoid aliasing.
    var tmp: [i64; 8] = [0; 8]
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        tmp[i as usize] = ctx.pointers[src as usize].region_bits[i as usize]
        i = i + 1
    }
    mema_region_bits_or(&! ctx.pointers[dst as usize].region_bits, &tmp)
}

// Test whether two pointers have overlapping points-to sets.
fn mema_ptr_sets_intersect(ctx: &MemAnalysisContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    if a < 0 { return false }
    if a >= ctx.ptr_count { return false }
    if b < 0 { return false }
    if b >= ctx.ptr_count { return false }
    mema_region_bits_intersects(
        &ctx.pointers[a as usize].region_bits,
        &ctx.pointers[b as usize].region_bits
    )
}

// Test whether a pointer's points-to set is a singleton (exactly one region).
fn mema_ptr_is_singleton(ctx: &MemAnalysisContext, ptr_id: i64) -> bool with Mut, Div, Panic {
    if ptr_id < 0 { return false }
    if ptr_id >= ctx.ptr_count { return false }
    mema_region_bits_count(&ctx.pointers[ptr_id as usize].region_bits) == 1
}

// Get the single region in a singleton points-to set, or -1.
fn mema_ptr_singleton_region(ctx: &MemAnalysisContext, ptr_id: i64) -> i64 with Mut, Div, Panic {
    if ptr_id < 0 { return 0 - 1 }
    if ptr_id >= ctx.ptr_count { return 0 - 1 }
    let cnt = mema_region_bits_count(&ctx.pointers[ptr_id as usize].region_bits)
    if cnt != 1 { return 0 - 1 }
    mema_region_bits_first(&ctx.pointers[ptr_id as usize].region_bits)
}

// ============================================================================
// Section 10: Instruction Processing
// ============================================================================

// Process a single instruction and update points-to information.
// Returns true if any points-to set changed.
fn mema_process_instr(ctx: &! MemAnalysisContext, instr_idx: i64) -> bool with Mut, Div, Panic {
    if instr_idx < 0 { return false }
    if instr_idx >= ctx.instr_count { return false }

    let op = ctx.instrs[instr_idx as usize].op
    let dst = ctx.instrs[instr_idx as usize].dst
    let src1 = ctx.instrs[instr_idx as usize].src1
    let src2 = ctx.instrs[instr_idx as usize].src2
    let field = ctx.instrs[instr_idx as usize].field

    // Match on the operation kind.
    let result = mema_process_instr_dispatch(ctx, op, dst, src1, src2, field)
    result
}

// Dispatch based on operation kind.
// PtrAlloc: dst points to the region identified by src1.
// PtrCopy:  dst = src1 (union src1's set into dst).
// PtrLoad:  for each region R in src1's set, union R's stored pointers into dst.
// PtrStore: for each region R in dst's set, union src1's set into R's stored pointer.
// PtrGep:   dst = src1 (same region, different offset).
// PtrCast:  dst = src1 (same points-to set).
// PtrPhi:   dst = src1 union src2.
// PtrNull:  mark dst as possibly null.
fn mema_process_instr_dispatch(ctx: &! MemAnalysisContext, op: MemPtrOp, dst: i64, src1: i64, src2: i64, field: i64) -> bool with Mut, Div, Panic {
    var changed = false

    // Handle each operation kind.
    let is_alloc = mema_op_is_alloc(op)
    let is_copy = mema_op_is_copy(op)
    let is_load = mema_op_is_load(op)
    let is_store = mema_op_is_store(op)
    let is_gep = mema_op_is_gep(op)
    let is_cast = mema_op_is_cast(op)
    let is_phi = mema_op_is_phi(op)
    let is_null = mema_op_is_null(op)

    if is_alloc {
        // src1 is the region id.  Add it to dst's set.
        if dst >= 0 && dst < ctx.ptr_count && src1 >= 0 && src1 < ctx.region_count {
            let had = mema_region_bits_test(&ctx.pointers[dst as usize].region_bits, src1)
            if had == false {
                mema_region_bits_set(&! ctx.pointers[dst as usize].region_bits, src1)
                changed = true
            }
        }
    }

    if is_copy {
        let c = mema_ptr_union(ctx, dst, src1)
        if c { changed = true }
    }

    if is_load {
        // For load: dst = *src1.
        // For each region R that src1 points to, we need to find what
        // pointers have been stored into R and union those into dst.
        // We model this by looking at store edges targeting regions in src1's set.
        let c = mema_process_load(ctx, dst, src1, field)
        if c { changed = true }
    }

    if is_store {
        // For store: *dst = src1.
        // This creates a constraint that for each region R in dst's set,
        // anything pointing through R should include src1's targets.
        let c = mema_process_store(ctx, dst, src1, field)
        if c { changed = true }
    }

    if is_gep {
        // GEP: same regions, adjust field offset.
        let c = mema_ptr_union(ctx, dst, src1)
        if c { changed = true }
        if dst >= 0 && dst < ctx.ptr_count {
            ctx.pointers[dst as usize].field_offset = field
        }
    }

    if is_cast {
        // Cast: just copy the points-to set.
        let c = mema_ptr_union(ctx, dst, src1)
        if c { changed = true }
    }

    if is_phi {
        // Phi: union both sources.
        let c1 = mema_ptr_union(ctx, dst, src1)
        let c2 = mema_ptr_union(ctx, dst, src2)
        if c1 || c2 { changed = true }
    }

    if is_null {
        // Mark dst as possibly null.
        if dst >= 0 && dst < ctx.ptr_count {
            ctx.pointers[dst as usize].is_null_possible = true
        }
    }

    changed
}

// Process a load instruction: dst = *src_ptr.
// For each region R in src_ptr's points-to set, look for store edges
// that target R and union the stored value's set into dst.
fn mema_process_load(ctx: &! MemAnalysisContext, dst: i64, src_ptr: i64, field: i64) -> bool with Mut, Div, Panic {
    if dst < 0 || dst >= ctx.ptr_count { return false }
    if src_ptr < 0 || src_ptr >= ctx.ptr_count { return false }

    var changed = false

    // For each edge that is a store...
    var e: i64 = 0
    loop {
        if e >= ctx.edge_count { break }
        let edge_kind = ctx.edges[e as usize].kind
        let is_store_edge = mema_op_is_store(edge_kind)
        if is_store_edge {
            let store_dst_ptr = ctx.edges[e as usize].from_ptr
            let store_src_ptr = ctx.edges[e as usize].to_ptr
            let store_field = ctx.edges[e as usize].field

            // Check if the store targets any region that src_ptr also points to.
            if store_field == field || field == 0 - 1 {
                let overlaps = mema_ptr_sets_intersect_via_copy(ctx, src_ptr, store_dst_ptr)
                if overlaps {
                    let c = mema_ptr_union(ctx, dst, store_src_ptr)
                    if c { changed = true }
                }
            }
        }
        e = e + 1
    }

    changed
}

// Helper: check if two pointers' points-to sets intersect.
// We copy the sets to temps to avoid borrow conflicts on ctx.
fn mema_ptr_sets_intersect_via_copy(ctx: &! MemAnalysisContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    if a < 0 || a >= ctx.ptr_count { return false }
    if b < 0 || b >= ctx.ptr_count { return false }

    var bits_a: [i64; 8] = [0; 8]
    var bits_b: [i64; 8] = [0; 8]
    var i: i64 = 0
    loop {
        if i >= 8 { break }
        bits_a[i as usize] = ctx.pointers[a as usize].region_bits[i as usize]
        bits_b[i as usize] = ctx.pointers[b as usize].region_bits[i as usize]
        i = i + 1
    }
    mema_region_bits_intersects(&bits_a, &bits_b)
}

// Process a store instruction: *dst_ptr = src_ptr.
// Add an edge from dst_ptr to src_ptr if not already present, and
// record the constraint for future load resolution.
fn mema_process_store(ctx: &! MemAnalysisContext, dst_ptr: i64, src_ptr: i64, field: i64) -> bool with Mut, Div, Panic {
    if dst_ptr < 0 || dst_ptr >= ctx.ptr_count { return false }
    if src_ptr < 0 || src_ptr >= ctx.ptr_count { return false }

    // Check if this edge already exists.
    var exists = false
    var e: i64 = 0
    loop {
        if e >= ctx.edge_count { break }
        let ek = ctx.edges[e as usize].kind
        let is_store_edge = mema_op_is_store(ek)
        if is_store_edge {
            if ctx.edges[e as usize].from_ptr == dst_ptr &&
               ctx.edges[e as usize].to_ptr == src_ptr &&
               ctx.edges[e as usize].field == field {
                exists = true
            }
        }
        e = e + 1
    }

    if exists == false {
        mema_add_edge(ctx, dst_ptr, src_ptr, MemPtrOp::PtrStore, field)
        return true
    }
    false
}

// ============================================================================
// Section 11: Operation Kind Helpers
// ============================================================================

fn mema_op_is_alloc(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrAlloc => true,
        _ => false,
    }
    result
}

fn mema_op_is_load(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrLoad => true,
        _ => false,
    }
    result
}

fn mema_op_is_store(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrStore => true,
        _ => false,
    }
    result
}

fn mema_op_is_gep(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrGep => true,
        _ => false,
    }
    result
}

fn mema_op_is_cast(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrCast => true,
        _ => false,
    }
    result
}

fn mema_op_is_phi(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrPhi => true,
        _ => false,
    }
    result
}

fn mema_op_is_copy(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrCopy => true,
        _ => false,
    }
    result
}

fn mema_op_is_null(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrNull => true,
        _ => false,
    }
    result
}

// Test whether an operation has side effects on memory (store, call).
fn mema_op_has_side_effect(op: MemPtrOp) -> bool {
    let result = match op {
        MemPtrOp::PtrStore => true,
        MemPtrOp::PtrAlloc => true,
        _ => false,
    }
    result
}

// ============================================================================
// Section 12: Andersen Fixed-Point Iteration
// ============================================================================

// Build the initial constraint graph from the instruction list.
// For each instruction, add the appropriate edges.
fn mema_build_constraints(ctx: &! MemAnalysisContext) with Mut, Div, Panic {
    var i: i64 = 0
    loop {
        if i >= ctx.instr_count { break }
        let op = ctx.instrs[i as usize].op
        let dst = ctx.instrs[i as usize].dst
        let src1 = ctx.instrs[i as usize].src1
        let src2 = ctx.instrs[i as usize].src2
        let field = ctx.instrs[i as usize].field

        let is_copy = mema_op_is_copy(op)
        let is_load = mema_op_is_load(op)
        let is_store = mema_op_is_store(op)
        let is_gep = mema_op_is_gep(op)
        let is_cast = mema_op_is_cast(op)
        let is_phi = mema_op_is_phi(op)

        if is_copy {
            mema_add_edge(ctx, src1, dst, MemPtrOp::PtrCopy, 0)
        }
        if is_load {
            mema_add_edge(ctx, src1, dst, MemPtrOp::PtrLoad, field)
        }
        if is_store {
            mema_add_edge(ctx, dst, src1, MemPtrOp::PtrStore, field)
        }
        if is_gep {
            mema_add_edge(ctx, src1, dst, MemPtrOp::PtrGep, field)
        }
        if is_cast {
            mema_add_edge(ctx, src1, dst, MemPtrOp::PtrCast, 0)
        }
        if is_phi {
            mema_add_edge(ctx, src1, dst, MemPtrOp::PtrPhi, 0)
            if src2 >= 0 {
                mema_add_edge(ctx, src2, dst, MemPtrOp::PtrPhi, 0)
            }
        }

        i = i + 1
    }
}

// Seed the worklist with all pointer ids that have non-empty points-to sets.
fn mema_seed_worklist(ctx: &! MemAnalysisContext) with Mut, Div, Panic {
    mema_worklist_clear(ctx)
    var i: i64 = 0
    loop {
        if i >= ctx.ptr_count { break }
        let empty = mema_region_bits_empty(&ctx.pointers[i as usize].region_bits)
        if empty == false {
            mema_worklist_push(ctx, i)
        }
        i = i + 1
    }
}

// Run one iteration of the fixed-point solver.
// Process all instructions and propagate through edges.
// Returns true if any points-to set changed.
fn mema_iterate_once(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    var changed = false

    // Process all instructions.
    var i: i64 = 0
    loop {
        if i >= ctx.instr_count { break }
        let c = mema_process_instr(ctx, i)
        if c { changed = true }
        i = i + 1
    }

    // Propagate through copy/cast/gep/phi edges.
    var e: i64 = 0
    loop {
        if e >= ctx.edge_count { break }
        let kind = ctx.edges[e as usize].kind
        let from = ctx.edges[e as usize].from_ptr
        let to = ctx.edges[e as usize].to_ptr

        let is_copy = mema_op_is_copy(kind)
        let is_cast = mema_op_is_cast(kind)
        let is_gep = mema_op_is_gep(kind)
        let is_phi = mema_op_is_phi(kind)

        if is_copy || is_cast || is_gep || is_phi {
            let c = mema_ptr_union(ctx, to, from)
            if c { changed = true }
        }

        e = e + 1
    }

    changed
}

// Compute the full Andersen-style points-to analysis.
// Iterates until fixed point or max_iterations reached.
// Returns true if analysis converged.
fn mema_compute_points_to(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    ctx.iterations = 0
    ctx.changed = true

    // Build constraint graph from instructions.
    mema_build_constraints(ctx)

    loop {
        if ctx.changed == false { break }
        if ctx.iterations >= ctx.max_iterations { break }

        ctx.changed = false
        let c = mema_iterate_once(ctx)
        ctx.changed = c
        ctx.iterations = ctx.iterations + 1
    }

    // Converged if we stopped because nothing changed.
    ctx.changed == false
}

// ============================================================================
// Section 13: Alias Queries
// ============================================================================

// Query the alias relationship between two abstract pointers.
//
// AliasMust: both are singletons pointing to the same region, same field offset.
// AliasNo:   points-to sets are disjoint.
// AliasMay:  points-to sets overlap but not a definite must-alias.
fn mema_query_alias(ctx: &MemAnalysisContext, ptr_a: i64, ptr_b: i64) -> MemAliasResult with Mut, Div, Panic {
    if ptr_a < 0 || ptr_a >= ctx.ptr_count { return MemAliasResult::AliasMay }
    if ptr_b < 0 || ptr_b >= ctx.ptr_count { return MemAliasResult::AliasMay }

    // Same pointer is always must-alias.
    if ptr_a == ptr_b { return MemAliasResult::AliasMust }

    // Check if their points-to sets intersect at all.
    let intersects = mema_region_bits_intersects(
        &ctx.pointers[ptr_a as usize].region_bits,
        &ctx.pointers[ptr_b as usize].region_bits
    )

    if intersects == false {
        return MemAliasResult::AliasNo
    }

    // Both singletons pointing to same region?
    let cnt_a = mema_region_bits_count(&ctx.pointers[ptr_a as usize].region_bits)
    let cnt_b = mema_region_bits_count(&ctx.pointers[ptr_b as usize].region_bits)

    if cnt_a == 1 && cnt_b == 1 {
        // Both point to exactly one region.  Check field offsets.
        let reg_a = mema_region_bits_first(&ctx.pointers[ptr_a as usize].region_bits)
        let reg_b = mema_region_bits_first(&ctx.pointers[ptr_b as usize].region_bits)
        if reg_a == reg_b {
            let off_a = ctx.pointers[ptr_a as usize].field_offset
            let off_b = ctx.pointers[ptr_b as usize].field_offset
            if off_a == off_b {
                return MemAliasResult::AliasMust
            }
            // Same region but different offsets: field-sensitive no-alias.
            // Only if we know the offsets are distinct and non-overlapping.
            if off_a != off_b {
                return MemAliasResult::AliasNo
            }
        }
    }

    // Otherwise, may-alias.
    MemAliasResult::AliasMay
}

// Convenience: check if two pointers definitely do not alias.
fn mema_no_alias(ctx: &MemAnalysisContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let result = mema_query_alias(ctx, a, b)
    match result {
        MemAliasResult::AliasNo => true,
        _ => false,
    }
}

// Convenience: check if two pointers must alias.
fn mema_must_alias(ctx: &MemAnalysisContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let result = mema_query_alias(ctx, a, b)
    match result {
        MemAliasResult::AliasMust => true,
        _ => false,
    }
}

// Convenience: check if two pointers may alias (including must).
fn mema_may_alias(ctx: &MemAnalysisContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let result = mema_query_alias(ctx, a, b)
    match result {
        MemAliasResult::AliasNo => false,
        _ => true,
    }
}

// ============================================================================
// Section 14: Escape Analysis
// ============================================================================

// Determine the escape status of a single allocation.
// Walks the instruction list to find uses of the allocation's pointer.
fn mema_check_escape(ctx: &! MemAnalysisContext, alloc_id: i64) -> MemEscapeStatus with Mut, Div, Panic {
    if alloc_id < 0 || alloc_id >= ctx.alloc_count {
        return MemEscapeStatus::EscapeUnknown
    }

    let region_id = ctx.allocs[alloc_id as usize].region_id
    var worst = MemEscapeStatus::EscapeNone

    // Scan all instructions for uses of pointers that include this region.
    var i: i64 = 0
    loop {
        if i >= ctx.instr_count { break }
        let op = ctx.instrs[i as usize].op
        let dst = ctx.instrs[i as usize].dst
        let src1 = ctx.instrs[i as usize].src1

        // Check if any operand pointer includes our region.
        let dst_has = mema_ptr_has_region_safe(ctx, dst, region_id)
        let src1_has = mema_ptr_has_region_safe(ctx, src1, region_id)

        if dst_has || src1_has {
            let esc = mema_classify_escape_for_op(op, dst_has, src1_has)
            worst = mema_escape_merge(worst, esc)
        }

        i = i + 1
    }

    ctx.allocs[alloc_id as usize].escape = worst
    worst
}

// Safe wrapper: check if ptr_id's set includes region_id, handling invalid ids.
fn mema_ptr_has_region_safe(ctx: &! MemAnalysisContext, ptr_id: i64, region_id: i64) -> bool with Div, Panic {
    if ptr_id < 0 || ptr_id >= ctx.ptr_count { return false }
    if region_id < 0 || region_id >= ctx.region_count { return false }
    mema_region_bits_test(&ctx.pointers[ptr_id as usize].region_bits, region_id)
}

// Classify what escape an operation implies.
fn mema_classify_escape_for_op(op: MemPtrOp, in_dst: bool, in_src: bool) -> MemEscapeStatus {
    // If a pointer to our region is stored somewhere, it might escape via store.
    let is_store = mema_op_is_store(op)
    if is_store && in_src {
        return MemEscapeStatus::EscapeStore
    }

    // If it appears as a copy/cast/phi destination used later as a return,
    // we'd catch that when we see the return instruction.  But at this
    // level we just look at the immediate op.

    // For now, if it appears in a copy/phi/cast, that alone doesn't escape.
    MemEscapeStatus::EscapeNone
}

// Merge two escape statuses: the worse one wins.
// Ordering: None < Return < Store < Call < Unknown.
fn mema_escape_severity(e: MemEscapeStatus) -> i64 {
    match e {
        MemEscapeStatus::EscapeNone => 0,
        MemEscapeStatus::EscapeReturn => 1,
        MemEscapeStatus::EscapeStore => 2,
        MemEscapeStatus::EscapeCall => 3,
        MemEscapeStatus::EscapeUnknown => 4,
    }
}

fn mema_escape_from_severity(s: i64) -> MemEscapeStatus {
    if s == 0 { return MemEscapeStatus::EscapeNone }
    if s == 1 { return MemEscapeStatus::EscapeReturn }
    if s == 2 { return MemEscapeStatus::EscapeStore }
    if s == 3 { return MemEscapeStatus::EscapeCall }
    MemEscapeStatus::EscapeUnknown
}

fn mema_escape_merge(a: MemEscapeStatus, b: MemEscapeStatus) -> MemEscapeStatus {
    let sa = mema_escape_severity(a)
    let sb = mema_escape_severity(b)
    if sa >= sb { return a }
    b
}

// Propagate escape status through the pointer constraint graph.
// If pointer A escapes and A's set overlaps with alloc X's region,
// then X escapes too.  Iterate to fixed point.
fn mema_propagate_escape(ctx: &! MemAnalysisContext) with Mut, Div, Panic {
    var changed = true
    var iters: i64 = 0

    loop {
        if changed == false { break }
        if iters >= MEMA_MAX_ITERATIONS { break }
        changed = false

        // For each edge, propagate escape from the "from" side.
        var e: i64 = 0
        loop {
            if e >= ctx.edge_count { break }
            let from = ctx.edges[e as usize].from_ptr
            let to = ctx.edges[e as usize].to_ptr

            // If from_ptr's regions have escape, propagate to to_ptr's regions.
            if from >= 0 && from < ctx.ptr_count && to >= 0 && to < ctx.ptr_count {
                var r: i64 = 0
                loop {
                    if r >= ctx.region_count { break }
                    let from_has = mema_region_bits_test(
                        &ctx.pointers[from as usize].region_bits, r)
                    let to_has = mema_region_bits_test(
                        &ctx.pointers[to as usize].region_bits, r)

                    if from_has && to_has {
                        let from_esc = ctx.regions[r as usize].escape
                        let sev = mema_escape_severity(from_esc)
                        if sev > 0 {
                            // Find allocs for this region and merge escape.
                            var a: i64 = 0
                            loop {
                                if a >= ctx.alloc_count { break }
                                if ctx.allocs[a as usize].region_id == r {
                                    let old_sev = mema_escape_severity(ctx.allocs[a as usize].escape)
                                    if sev > old_sev {
                                        ctx.allocs[a as usize].escape = from_esc
                                        changed = true
                                    }
                                }
                                a = a + 1
                            }
                        }
                    }
                    r = r + 1
                }
            }

            e = e + 1
        }

        iters = iters + 1
    }
}

// Mark a region as escaping with a given status.
fn mema_mark_region_escape(ctx: &! MemAnalysisContext, region_id: i64, esc: MemEscapeStatus) with Mut, Div, Panic {
    if region_id < 0 || region_id >= ctx.region_count { return }
    let old = mema_escape_severity(ctx.regions[region_id as usize].escape)
    let new_sev = mema_escape_severity(esc)
    if new_sev > old {
        ctx.regions[region_id as usize].escape = esc
    }
}

// Mark an alloc as escaping with a given status.
fn mema_mark_alloc_escape(ctx: &! MemAnalysisContext, alloc_id: i64, esc: MemEscapeStatus) with Mut, Div, Panic {
    if alloc_id < 0 || alloc_id >= ctx.alloc_count { return }
    let old = mema_escape_severity(ctx.allocs[alloc_id as usize].escape)
    let new_sev = mema_escape_severity(esc)
    if new_sev > old {
        ctx.allocs[alloc_id as usize].escape = esc
        // Also propagate to the region.
        let rid = ctx.allocs[alloc_id as usize].region_id
        mema_mark_region_escape(ctx, rid, esc)
    }
}

// ============================================================================
// Section 15: Stack Promotion
// ============================================================================

// Determine whether a heap allocation can be promoted to stack.
// Requirements:
//   1. Must be a heap allocation.
//   2. Must not escape (EscapeNone).
//   3. Must have known, bounded size (> 0).
fn mema_promote_to_stack(ctx: &! MemAnalysisContext, alloc_id: i64) -> MemPromoteResult with Mut, Div, Panic {
    if alloc_id < 0 || alloc_id >= ctx.alloc_count {
        return MemPromoteResult::PromoteNo
    }

    let is_heap = ctx.allocs[alloc_id as usize].is_heap
    if is_heap == false {
        // Already on stack or not a heap alloc.
        ctx.allocs[alloc_id as usize].promote = MemPromoteResult::PromoteNo
        return MemPromoteResult::PromoteNo
    }

    let esc = ctx.allocs[alloc_id as usize].escape
    let sev = mema_escape_severity(esc)
    if sev > 0 {
        // Escapes -- cannot promote.
        ctx.allocs[alloc_id as usize].promote = MemPromoteResult::PromoteNo
        return MemPromoteResult::PromoteNo
    }

    let sz = ctx.allocs[alloc_id as usize].size
    if sz <= 0 {
        // Unknown or zero size -- maybe promotable with more info.
        ctx.allocs[alloc_id as usize].promote = MemPromoteResult::PromoteMaybe
        return MemPromoteResult::PromoteMaybe
    }

    // Non-escaping heap alloc with known positive size: promote.
    ctx.allocs[alloc_id as usize].promote = MemPromoteResult::PromoteYes
    MemPromoteResult::PromoteYes
}

// Compute promotions for all allocations.  Returns count of PromoteYes.
fn mema_compute_promotions(ctx: &! MemAnalysisContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= ctx.alloc_count { break }
        let result = mema_promote_to_stack(ctx, i)
        let is_yes = match result {
            MemPromoteResult::PromoteYes => true,
            _ => false,
        }
        if is_yes { count = count + 1 }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 16: Full Analysis Pipeline
// ============================================================================

// Run the complete memory analysis pipeline:
// 1. Compute points-to (Andersen fixed-point).
// 2. Run escape analysis on all allocations.
// 3. Propagate escape through pointer graph.
// 4. Compute stack promotions.
// Returns true if analysis converged.
fn mema_analyze_function(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    // Step 1: Points-to analysis.
    let converged = mema_compute_points_to(ctx)

    // Step 2: Escape analysis for each allocation.
    var i: i64 = 0
    loop {
        if i >= ctx.alloc_count { break }
        let esc = mema_check_escape(ctx, i)
        // esc is already stored in allocs[i].escape by check_escape
        i = i + 1
    }

    // Step 3: Propagate escape.
    mema_propagate_escape(ctx)

    // Step 4: Compute promotions.
    let promoted = mema_compute_promotions(ctx)

    converged
}

// ============================================================================
// Section 17: Query Helpers
// ============================================================================

// Count how many allocations have a specific escape status.
fn mema_count_escaping(ctx: &MemAnalysisContext, esc: MemEscapeStatus) -> i64 with Mut, Div, Panic {
    let target_sev = mema_escape_severity(esc)
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= ctx.alloc_count { break }
        let sev = mema_escape_severity(ctx.allocs[i as usize].escape)
        if sev == target_sev { count = count + 1 }
        i = i + 1
    }
    count
}

// Count how many allocations are non-escaping.
fn mema_count_non_escaping(ctx: &MemAnalysisContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= ctx.alloc_count { break }
        let sev = mema_escape_severity(ctx.allocs[i as usize].escape)
        if sev == 0 { count = count + 1 }
        i = i + 1
    }
    count
}

// Count how many allocations are promotable.
fn mema_count_promotable(ctx: &MemAnalysisContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= ctx.alloc_count { break }
        let p = ctx.allocs[i as usize].promote
        let is_yes = match p {
            MemPromoteResult::PromoteYes => true,
            _ => false,
        }
        if is_yes { count = count + 1 }
        i = i + 1
    }
    count
}

// Total number of edges in the constraint graph.
fn mema_edge_count(ctx: &MemAnalysisContext) -> i64 {
    ctx.edge_count
}

// Total number of iterations the solver ran.
fn mema_iteration_count(ctx: &MemAnalysisContext) -> i64 {
    ctx.iterations
}

// Check if a region is of a specific kind.
fn mema_region_is_kind(ctx: &MemAnalysisContext, region_id: i64, kind: MemRegionKind) -> bool with Div, Panic {
    if region_id < 0 || region_id >= ctx.region_count { return false }
    let rk = ctx.regions[region_id as usize].kind
    mema_region_kind_eq(rk, kind)
}

fn mema_region_kind_eq(a: MemRegionKind, b: MemRegionKind) -> bool {
    let sa = mema_region_kind_ord(a)
    let sb = mema_region_kind_ord(b)
    sa == sb
}

fn mema_region_kind_ord(k: MemRegionKind) -> i64 {
    match k {
        MemRegionKind::RegStack => 0,
        MemRegionKind::RegHeap => 1,
        MemRegionKind::RegGlobal => 2,
        MemRegionKind::RegParam => 3,
        MemRegionKind::RegReturn => 4,
        MemRegionKind::RegUnknown => 5,
    }
}

// Check alias result equality.
fn mema_alias_result_eq(a: MemAliasResult, b: MemAliasResult) -> bool {
    let oa = mema_alias_result_ord(a)
    let ob = mema_alias_result_ord(b)
    oa == ob
}

fn mema_alias_result_ord(r: MemAliasResult) -> i64 {
    match r {
        MemAliasResult::AliasMust => 0,
        MemAliasResult::AliasMay => 1,
        MemAliasResult::AliasNo => 2,
    }
}

// Check escape status equality.
fn mema_escape_eq(a: MemEscapeStatus, b: MemEscapeStatus) -> bool {
    mema_escape_severity(a) == mema_escape_severity(b)
}

// Check promote result equality.
fn mema_promote_eq(a: MemPromoteResult, b: MemPromoteResult) -> bool {
    let oa = mema_promote_ord(a)
    let ob = mema_promote_ord(b)
    oa == ob
}

fn mema_promote_ord(p: MemPromoteResult) -> i64 {
    match p {
        MemPromoteResult::PromoteYes => 0,
        MemPromoteResult::PromoteNo => 1,
        MemPromoteResult::PromoteMaybe => 2,
    }
}

