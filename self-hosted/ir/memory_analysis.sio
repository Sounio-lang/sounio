    mema_ptr_add_region(ctx, p1, r1)
    mema_ptr_add_region(ctx, p2, r2)
    mema_no_alias(ctx, p0, p1) && mema_no_alias(ctx, p1, p2) && mema_no_alias(ctx, p0, p2)
}

