fn test_mema_count_non_escaping_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r0 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 8, 4, 1)
    let r1 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 16, 4, 2)
    let r2 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 3)
