// T41 inner: alloc with no escaping uses is EscapeNone.
fn test_mema_no_escape_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let p = mema_alloc_pointer(ctx)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p, r, 0, 0, 1)
    let converged = mema_compute_points_to(ctx)
    let esc = mema_check_escape(ctx, a)
    converged && mema_escape_eq(esc, MemEscapeStatus::EscapeNone)
}

fn test_mema_no_escape() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_no_escape_inner(&! ctx)
}

// T42 inner: store to a pointer that includes the region marks EscapeStore.
fn test_mema_store_escape_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let rg = mema_alloc_region(ctx, MemRegionKind::RegGlobal, 64, 8, 2)
    let p = mema_alloc_pointer(ctx)
    let pg = mema_alloc_pointer(ctx)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p, r, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, pg, rg, 0, 0, 2)
    // Store p (which points to r) into pg (global).
    mema_add_instr(ctx, MemPtrOp::PtrStore, pg, p, 0, 0, 3)
    let converged = mema_compute_points_to(ctx)
    let esc = mema_check_escape(ctx, a)
    converged && mema_escape_eq(esc, MemEscapeStatus::EscapeStore)
}

fn test_mema_store_escape() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_store_escape_inner(&! ctx)
}

// T43 inner: escape merge picks worst.
fn test_mema_escape_merge_worst() -> bool with Mut, Div, Panic {
    let m1 = mema_escape_merge(MemEscapeStatus::EscapeNone, MemEscapeStatus::EscapeReturn)
    let m2 = mema_escape_merge(MemEscapeStatus::EscapeReturn, MemEscapeStatus::EscapeStore)
    let m3 = mema_escape_merge(MemEscapeStatus::EscapeStore, MemEscapeStatus::EscapeCall)
    let m4 = mema_escape_merge(MemEscapeStatus::EscapeCall, MemEscapeStatus::EscapeUnknown)
    mema_escape_eq(m1, MemEscapeStatus::EscapeReturn) &&
    mema_escape_eq(m2, MemEscapeStatus::EscapeStore) &&
    mema_escape_eq(m3, MemEscapeStatus::EscapeCall) &&
    mema_escape_eq(m4, MemEscapeStatus::EscapeUnknown)
}

// T44 inner: escape severity ordering.
fn test_mema_escape_severity_order() -> bool {
    let s0 = mema_escape_severity(MemEscapeStatus::EscapeNone)
    let s1 = mema_escape_severity(MemEscapeStatus::EscapeReturn)
    let s2 = mema_escape_severity(MemEscapeStatus::EscapeStore)
    let s3 = mema_escape_severity(MemEscapeStatus::EscapeCall)
    let s4 = mema_escape_severity(MemEscapeStatus::EscapeUnknown)
    s0 < s1 && s1 < s2 && s2 < s3 && s3 < s4
}

// T45 inner: mark_alloc_escape updates both alloc and region.
fn test_mema_mark_alloc_escape_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_mark_alloc_escape(ctx, a, MemEscapeStatus::EscapeCall)
    mema_escape_eq(ctx.allocs[0].escape, MemEscapeStatus::EscapeCall) &&
    mema_escape_eq(ctx.regions[0].escape, MemEscapeStatus::EscapeCall)
}

fn test_mema_mark_alloc_escape() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_mark_alloc_escape_inner(&! ctx)
}

// T46 inner: mark_alloc_escape doesn't downgrade.
fn test_mema_escape_no_downgrade_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_mark_alloc_escape(ctx, a, MemEscapeStatus::EscapeCall)
    mema_mark_alloc_escape(ctx, a, MemEscapeStatus::EscapeReturn)
    // Should still be EscapeCall since it's worse.
    mema_escape_eq(ctx.allocs[0].escape, MemEscapeStatus::EscapeCall)
}

fn test_mema_escape_no_downgrade() -> bool with Mut, Div, Panic {
    var ctx = mema_context_new()
    test_mema_escape_no_downgrade_inner(&! ctx)
}

