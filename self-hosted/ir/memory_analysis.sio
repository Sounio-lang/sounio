// ============================================================================
// Section 19: Tests — Category 2: Bitset Operations (8 tests)
// ============================================================================

// T11: set and test a single bit.
fn test_mema_bits_set_test() -> bool with Mut, Div, Panic {
    var bits: [i64; 8] = [0; 8]
    mema_region_bits_set(&! bits, 42)
    mema_region_bits_test(&bits, 42)
}

// T12: set multiple bits and count.
fn test_mema_bits_count() -> bool with Mut, Div, Panic {
    var bits: [i64; 8] = [0; 8]
    mema_region_bits_set(&! bits, 0)
    mema_region_bits_set(&! bits, 63)
    mema_region_bits_set(&! bits, 64)
    mema_region_bits_set(&! bits, 511)
    mema_region_bits_count(&bits) == 4
}

// T13: union of two bitsets.
fn test_mema_bits_union() -> bool with Mut, Div, Panic {
    var a: [i64; 8] = [0; 8]
    var b: [i64; 8] = [0; 8]
    mema_region_bits_set(&! a, 10)
    mema_region_bits_set(&! b, 20)
    var changed = false
    {
        changed = mema_region_bits_or(&! a, &b)
    }
    let has_10 = mema_region_bits_test(&a, 10)
    let has_20 = mema_region_bits_test(&a, 20)
    let count = mema_region_bits_count(&a)
    changed && has_10 && has_20 && count == 2
}

// T14: union with no change returns false.
fn test_mema_bits_union_no_change() -> bool with Mut, Div, Panic {
    var a: [i64; 8] = [0; 8]
    var b: [i64; 8] = [0; 8]
    mema_region_bits_set(&! a, 5)
    mema_region_bits_set(&! b, 5)
    var changed = false
    {
        changed = mema_region_bits_or(&! a, &b)
    }
    let count = mema_region_bits_count(&a)
    (changed == false) && count == 1
}

// T15: intersection of two bitsets.
fn test_mema_bits_intersect() -> bool with Mut, Div, Panic {
    var a: [i64; 8] = [0; 8]
    var b: [i64; 8] = [0; 8]
    mema_region_bits_set(&! a, 10)
    mema_region_bits_set(&! a, 20)
    mema_region_bits_set(&! b, 20)
    mema_region_bits_set(&! b, 30)
    mema_region_bits_and(&! a, &b)
    mema_region_bits_count(&a) == 1 && mema_region_bits_test(&a, 20)
}

// T16: intersects query.
fn test_mema_bits_intersects_query() -> bool with Mut, Div, Panic {
    var a: [i64; 8] = [0; 8]
    var b: [i64; 8] = [0; 8]
    var c: [i64; 8] = [0; 8]
    mema_region_bits_set(&! a, 100)
    mema_region_bits_set(&! b, 100)
    mema_region_bits_set(&! c, 200)
    let ab = mema_region_bits_intersects(&a, &b)
    let ac = mema_region_bits_intersects(&a, &c)
    ab && (ac == false)
}

// T17: empty check.
fn test_mema_bits_empty() -> bool with Mut, Div, Panic {
    var a: [i64; 8] = [0; 8]
    let e1 = true
    mema_region_bits_set(&! a, 0)
    let e2 = mema_region_bits_empty(&a)
    e1 && (e2 == false)
}

// T18: first bit finder.
fn test_mema_bits_first() -> bool with Mut, Div, Panic {
    var bits: [i64; 8] = [0; 8]
    mema_region_bits_set(&! bits, 130)
    mema_region_bits_set(&! bits, 250)
    mema_region_bits_first(&bits) == 130
}

