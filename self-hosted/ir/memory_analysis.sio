// T66 inner: analyze with phi and aliasing.
fn test_mema_analyze_phi_alias_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r0 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 16, 4, 1)
    let r1 = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 2)
    let p0 = mema_alloc_pointer(ctx)
