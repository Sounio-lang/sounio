    let a1 = mema_add_alloc(ctx, r1, 16, 2, true)
    let a2 = mema_add_alloc(ctx, r2, 32, 3, true)
    mema_mark_alloc_escape(ctx, a1, MemEscapeStatus::EscapeStore)
    mema_count_non_escaping(ctx) == 2
}

