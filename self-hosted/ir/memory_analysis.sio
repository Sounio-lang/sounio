// T19 inner: simple alloc sets points-to.
fn test_mema_simple_alloc_pts_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let p = mema_alloc_pointer(ctx)
    // Alloc instruction: p points to r.
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p, r, 0, 0, 1)
    let converged = mema_compute_points_to(ctx)
    converged && mema_ptr_has_region(ctx, p, r) && mema_ptr_region_count(ctx, p) == 1
}

