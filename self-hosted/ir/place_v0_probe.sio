// Bounded executable truth table for explicit Place IR v0.
// This probe does not import the legacy compiler pipeline. It crosses the
// module boundary with one scalar so aggregate ABI behavior is out of scope.

use ir::place_v0::{
    place_v0_run_self_tests,
    place_v0_default_pipeline_enabled,
    place_v0_legacy_field_label7_status,
    place_v0_legacy_field_valid_codegen_status,
    place_v0_error_legacy_label_status,
    place_v0_error_differential_only_status,
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var failures = place_v0_run_self_tests()
    let expected_invalid_label = place_v0_error_legacy_label_status()
    let expected_differential_only = place_v0_error_differential_only_status()
    let invalid_label_status = place_v0_legacy_field_label7_status()
    let codegen_status = place_v0_legacy_field_valid_codegen_status()
    if invalid_label_status != expected_invalid_label || codegen_status != expected_differential_only {
        print("PLACE_IR_V0_BOUNDARY_FAIL invalid_label_status=")
        print_int(invalid_label_status)
        print(" expected=")
        print_int(expected_invalid_label)
        print(" codegen_status=")
        print_int(codegen_status)
        print(" expected_codegen=")
        print_int(expected_differential_only)
        print("\n")
        failures = failures + 1
    }
    if failures == 0 && !place_v0_default_pipeline_enabled() {
        print("PLACE_IR_V0_PASS tests=12 mode=differential-shadow default_pipeline=off\n")
        0
    } else {
        print("PLACE_IR_V0_FAIL failures=")
        print_int(failures)
        print(" tests=12\n")
        1
    }
}
