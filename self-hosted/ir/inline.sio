    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    let dec = ctx.decisions[0]
    if !dec.should_inline || dec.reason_code != INL_REASON_SMALL {
        print("FAIL: test_inl_below_threshold\n")
        return 1
    }
    print("PASS: test_inl_below_threshold\n")
    return 0
}

// T27: Approved count matches expectations
fn test_inl_approved_count() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    let f2_name = inl_get_test_func_name(2)

    // f0 calls f1 (small, will inline) and f2 (large, won't)
    var f0 = ir_empty_function()
    f0.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_call(0, 0, f1_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (1)), ir_call(1, 0, f2_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (2)), ir_return(1))
    f0.instr_count = 3
    f0.reg_count = 2

    funcs[0] = f0
    funcs[1] = inl_make_test_func(1, 3)    // small -> inline
    funcs[2] = inl_make_test_func(2, 501)  // too large -> reject
    let module = inl_make_test_module(funcs, 3)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    let approved = inl_count_approved(ctx)
    if approved != 1 {
        print("FAIL: test_inl_approved_count\n")
        return 1
    }
    print("PASS: test_inl_approved_count\n")
    return 0
}

// T28: Rejected count by reason
fn test_inl_rejected_reason_count() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)

    var f0 = ir_empty_function()
    f0.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_call(0, 0, f1_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (1)), ir_return(0))
    f0.instr_count = 2
    f0.reg_count = 1

    funcs[0] = f0
    funcs[1] = inl_make_test_func(1, 501)  // too large
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    let rej = inl_count_rejected_by_reason(ctx, INL_REASON_TOO_LARGE)
    if rej != 1 {
        print("FAIL: test_inl_rejected_reason_count\n")
        return 1
    }
    print("PASS: test_inl_rejected_reason_count\n")
    return 0
}

// T29: Transform result — inline a 3-instr callee into caller
fn test_inl_transform_basic() -> i32 with IO, Mut, Div, Panic {
    // Caller: load 1, call f1, return
    // Callee (f1): load 42, return r0
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_load_imm(0, 1))
    let callee_name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(caller.region, (1)), ir_call(1, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (2)), ir_return(1))
    caller.instr_count = 3
    caller.reg_count = 2
    caller.label_count = 0

    var callee = ir_empty_function()
    callee.name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_load_imm(0, 42))
    ir_arena_store(ir_region_slot_w(callee.region, (1)), ir_return(0))
    callee.instr_count = 2
    callee.reg_count = 1
    callee.label_count = 0

    let xform = inl_transform(caller, callee, 1)
    if !xform.success {
        print("FAIL: test_inl_transform_basic\n")
        return 1
    }
    // Original: 3 instrs. Callee: 2 instrs. Net added = 2-1 = 1. New total = 4.
    if xform.func.instr_count != 4 {
        print("FAIL: test_inl_transform_basic\n")
        return 1
    }
    print("PASS: test_inl_transform_basic\n")
    return 0
}

// T30: Transform preserves instructions before and after call
fn test_inl_transform_preserves_context() -> i32 with IO, Mut, Div, Panic {
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_load_imm(0, 111)) // before
    ir_arena_store(ir_region_slot_w(caller.region, (1)), ir_load_imm(1, 222)) // before
    let callee_name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(caller.region, (2)), ir_call(2, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (3)), ir_load_imm(3, 333)) // after
    ir_arena_store(ir_region_slot_w(caller.region, (4)), ir_return(3))
    caller.instr_count = 5
    caller.reg_count = 4
    caller.label_count = 0

    var callee = ir_empty_function()
    callee.name = callee_name
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_load_imm(0, 99))
    ir_arena_store(ir_region_slot_w(callee.region, (1)), ir_return(0))
    callee.instr_count = 2
    callee.reg_count = 1
    callee.label_count = 0

    let xform = inl_transform(caller, callee, 2)
    if !xform.success {
        print("FAIL: test_inl_transform_preserves_context\n")
        return 1
    }

    // Instructions before call should be preserved
    let i0 = ir_arena_load(ir_region_slot_r(xform.func.region, (0)))
    let i1 = ir_arena_load(ir_region_slot_r(xform.func.region, (1)))
    if i0.imm_i64 != 111 || i1.imm_i64 != 222 {
        print("FAIL: test_inl_transform_preserves_context\n")
        return 1
    }

    // Net added = 1, so total = 6. Last two should be load 333 and return.
    if xform.func.instr_count != 6 {
        print("FAIL: test_inl_transform_preserves_context\n")
        return 1
    }
    print("PASS: test_inl_transform_preserves_context\n")
    return 0
}

// T31: Transform return becomes copy
fn test_inl_transform_return_to_copy() -> i32 with IO, Mut, Div, Panic {
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    let callee_name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_call(0, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (1)), ir_return(0))
    caller.instr_count = 2
    caller.reg_count = 1
    caller.label_count = 0

    var callee = ir_empty_function()
    callee.name = callee_name
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_load_imm(0, 77))
    ir_arena_store(ir_region_slot_w(callee.region, (1)), ir_return(0))
    callee.instr_count = 2
    callee.reg_count = 1
    callee.label_count = 0

    let xform = inl_transform(caller, callee, 0)
    if !xform.success {
        print("FAIL: test_inl_transform_return_to_copy\n")
        return 1
    }

    // The callee's return should become a copy instruction
    // Inlined body: [load_imm(remapped, 77), copy(0, remapped)]
    let copy_instr = ir_arena_load(ir_region_slot_r(xform.func.region, (1)))
    if !inl_opcodes_equal(copy_instr.op, IrOpcode::IrCopy) {
        print("FAIL: test_inl_transform_return_to_copy\n")
        return 1
    }
    // Copy destination should be the call's original dst (0)
    if copy_instr.dst != 0 {
        print("FAIL: test_inl_transform_return_to_copy\n")
        return 1
    }
    print("PASS: test_inl_transform_return_to_copy\n")
    return 0
}

// T32: Transform fails on invalid call index
fn test_inl_transform_invalid_idx() -> i32 with IO, Mut, Div, Panic {
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_return(0))
    caller.instr_count = 1
    caller.reg_count = 1

    var callee = ir_empty_function()
    callee.name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_return(0))
    callee.instr_count = 1
    callee.reg_count = 1

    let xform = inl_transform(caller, callee, 5)
    if xform.success {
        print("FAIL: test_inl_transform_invalid_idx\n")
        return 1
    }
    print("PASS: test_inl_transform_invalid_idx\n")
    return 0
}

// T33: Multiple callees — different call sites to different functions
fn test_inl_multiple_callees() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    let f2_name = inl_get_test_func_name(2)

    var f0 = ir_empty_function()
    f0.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_call(0, 0, f1_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (1)), ir_call(1, 0, f2_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (2)), ir_return(1))
    f0.instr_count = 3
    f0.reg_count = 2

    funcs[0] = f0
    funcs[1] = inl_make_test_func(1, 4)
    funcs[2] = inl_make_test_func(2, 6)
    let module = inl_make_test_module(funcs, 3)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    // Should find 2 call sites
    if ctx.call_site_count != 2 {
        print("FAIL: test_inl_multiple_callees\n")
        return 1
    }

    let sites_f1 = inl_count_sites_for_callee(ctx, 1)
    let sites_f2 = inl_count_sites_for_callee(ctx, 2)
    if sites_f1 != 1 || sites_f2 != 1 {
        print("FAIL: test_inl_multiple_callees\n")
        return 1
    }
    print("PASS: test_inl_multiple_callees\n")
    return 0
}

// T34: Chain of calls — f0 calls f1, f1 calls f2, f2 is leaf
fn test_inl_call_chain() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    let f2_name = inl_get_test_func_name(2)

    funcs[0] = inl_make_caller_func(0, f1_name, 1, 0)
    funcs[1] = inl_make_caller_func(1, f2_name, 1, 0)
    funcs[2] = inl_make_test_func(2, 4)
    let module = inl_make_test_module(funcs, 3)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    // f0->f1, f1->f2
    if ctx.call_site_count != 2 {
        print("FAIL: test_inl_call_chain\n")
        return 1
    }

    // f2 should be leaf, f1 not, f0 not
    if !ctx.func_infos[2].is_leaf {
        print("FAIL: test_inl_call_chain\n")
        return 1
    }
    if ctx.func_infos[1].is_leaf {
        print("FAIL: test_inl_call_chain\n")
        return 1
    }
    print("PASS: test_inl_call_chain\n")
    return 0
}

// T35: Bottom-up order for three-level chain
fn test_inl_three_level_order() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    let f2_name = inl_get_test_func_name(2)

    funcs[0] = inl_make_caller_func(0, f1_name, 1, 0)
    funcs[1] = inl_make_caller_func(1, f2_name, 1, 0)
    funcs[2] = inl_make_test_func(2, 4)
    let module = inl_make_test_module(funcs, 3)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)

    let order = inl_compute_order(ctx)
    if order.count < 3 {
        print("FAIL: test_inl_three_level_order\n")
        return 1
    }
    // f2 (leaf) should come first
    if order.func_ids[0] != 2 {
        print("FAIL: test_inl_three_level_order\n")
        return 1
    }
    // f1 (calls f2, 1 call) should come before f0 (calls f1, 1 call) due
    // to call_count tie-breaking. Both have 1 call, but f1 is found first
    // by the minimum-search since it has a lower index. Either order is
    // acceptable for equal call counts.
    print("PASS: test_inl_three_level_order\n")
    return 0
}

// T36: Find site helper
fn test_inl_find_site_helper() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, f1_name, 1, 0)
    funcs[1] = inl_make_test_func(1, 3)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    let idx = inl_find_site(ctx, 0, 1)
    if idx < 0 {
        print("FAIL: test_inl_find_site_helper\n")
        return 1
    }
    // Non-existent site
    let missing = inl_find_site(ctx, 0, 99)
    if missing != INL_INVALID {
        print("FAIL: test_inl_find_site_helper\n")
        return 1
    }
    print("PASS: test_inl_find_site_helper\n")
    return 0
}

// T37: Count real instructions helper
fn test_inl_count_real_instrs_helper() -> i32 with IO, Mut, Div, Panic {
    var func = ir_empty_function()
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_nop())
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_nop())
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_return(1))
    func.instr_count = 5

    let count = inl_count_real_instrs(func)
    if count != 3 {
        print("FAIL: test_inl_count_real_instrs_helper\n")
        return 1
    }
    print("PASS: test_inl_count_real_instrs_helper\n")
    return 0
}

// T38: Mutual recursion detection — A calls B, B calls A
fn test_inl_mutual_recursion() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f0_name = inl_get_test_func_name(0)
    let f1_name = inl_get_test_func_name(1)

    // f0 calls f1
    funcs[0] = inl_make_caller_func(0, f1_name, 1, 0)
    // f1 calls f0
    funcs[1] = inl_make_caller_func(1, f0_name, 1, 0)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_detect_mutual_recursion(ctx)

    // Both should be flagged as recursive
    if !ctx.func_infos[0].is_recursive || !ctx.func_infos[1].is_recursive {
        print("FAIL: test_inl_mutual_recursion\n")
        return 1
    }
    print("PASS: test_inl_mutual_recursion\n")
    return 0
}

// T39: Empty module produces empty context
fn test_inl_empty_module() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let module = inl_make_test_module(funcs, 0)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    if ctx.func_info_count != 0 || ctx.call_site_count != 0 {
        print("FAIL: test_inl_empty_module\n")
        return 1
    }
    if ctx.total_original_size != 0 {
        print("FAIL: test_inl_empty_module\n")
        return 1
    }
    print("PASS: test_inl_empty_module\n")
    return 0
}

// T40: Opcode helpers — is_call, is_return, is_label, is_nop
fn test_inl_opcode_helpers() -> i32 with IO, Mut, Div, Panic {
    let call_instr = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    let ret_instr = ir_return(0)
    let label_instr = ir_label(0)
    let nop_instr = ir_nop()
    let load_instr = ir_load_imm(0, 5)

    if !inl_is_call(call_instr) {
        print("FAIL: test_inl_opcode_helpers\n")
        return 1
    }
    if !inl_is_return(ret_instr) {
        print("FAIL: test_inl_opcode_helpers\n")
        return 1
    }
    if !inl_is_label(label_instr) {
        print("FAIL: test_inl_opcode_helpers\n")
        return 1
    }
    if !inl_is_nop(nop_instr) {
        print("FAIL: test_inl_opcode_helpers\n")
        return 1
    }
    // Negative: load is not a call
    if inl_is_call(load_instr) {
        print("FAIL: test_inl_opcode_helpers\n")
        return 1
    }
    print("PASS: test_inl_opcode_helpers\n")
    return 0
}

// T41: Backward branch detection
fn test_inl_backward_branch_detect() -> i32 with IO, Mut, Div, Panic {
    // Jump to label 2 at instruction index 10 => backward (label < idx)
    let bwd_jump = ir_jump(2)
    if !inl_is_backward_branch(bwd_jump, 10) {
        print("FAIL: test_inl_backward_branch_detect\n")
        return 1
    }
    // Jump to label 20 at instruction index 5 => forward (label >= idx)
    let fwd_jump = ir_jump(20)
    if inl_is_backward_branch(fwd_jump, 5) {
        print("FAIL: test_inl_backward_branch_detect\n")
        return 1
    }
    // Non-branch instruction
    let load_instr = ir_load_imm(0, 5)
    if inl_is_backward_branch(load_instr, 3) {
        print("FAIL: test_inl_backward_branch_detect\n")
        return 1
    }
    print("PASS: test_inl_backward_branch_detect\n")
    return 0
}

// T42: Remap instruction registers
fn test_inl_remap_instr_regs() -> i32 with IO, Mut, Div, Panic {
    var rmap = inl_reg_map_new()
    rmap = inl_reg_map_add(rmap, 0, 10)
    rmap = inl_reg_map_add(rmap, 1, 11)
    rmap = inl_reg_map_add(rmap, 2, 12)

    let orig = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let remapped = inl_remap_instr(orig, rmap)

    if remapped.dst != 12 || remapped.src1 != 10 || remapped.src2 != 11 {
        print("FAIL: test_inl_remap_instr_regs\n")
        return 1
    }
    print("PASS: test_inl_remap_instr_regs\n")
    return 0
}

// T43: Label remapping adds offset
fn test_inl_remap_label_offset() -> i32 with IO, Mut, Div, Panic {
    let orig = ir_jump(5)
    let remapped = inl_remap_label(orig, 100)

    if remapped.label_id != 105 {
        print("FAIL: test_inl_remap_label_offset\n")
        return 1
    }
    // Negative label_id should not be offset
    let no_label = ir_load_imm(0, 42)
    let remapped2 = inl_remap_label(no_label, 100)
    if remapped2.label_id != no_label.label_id {
        print("FAIL: test_inl_remap_label_offset\n")
        return 1
    }
    print("PASS: test_inl_remap_label_offset\n")
    return 0
}

// T44: Transform updates reg_count
fn test_inl_transform_reg_count() -> i32 with IO, Mut, Div, Panic {
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    let callee_name = inl_get_test_func_name(1)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_call(0, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (1)), ir_return(0))
    caller.instr_count = 2
    caller.reg_count = 1
    caller.label_count = 0

    var callee = ir_empty_function()
    callee.name = callee_name
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(callee.region, (1)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(callee.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(callee.region, (3)), ir_return(2))
    callee.instr_count = 4
    callee.reg_count = 3
    callee.label_count = 0

    let xform = inl_transform(caller, callee, 0)
    if !xform.success {
        print("FAIL: test_inl_transform_reg_count\n")
        return 1
    }
    // New reg_count = caller(1) + callee(3) = 4
    if xform.func.reg_count != 4 {
        print("FAIL: test_inl_transform_reg_count\n")
        return 1
    }
    print("PASS: test_inl_transform_reg_count\n")
    return 0
}

// T45: Decision getter for specific site
fn test_inl_get_decision_for_site() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let callee_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, callee_name, 1, 0)
    funcs[1] = inl_make_test_func(1, 3)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    let dec = inl_get_decision_for_site(ctx, 0)
    if dec.call_site_idx != 0 {
        print("FAIL: test_inl_get_decision_for_site\n")
        return 1
    }
    if !dec.should_inline {
        print("FAIL: test_inl_get_decision_for_site\n")
        return 1
    }
    print("PASS: test_inl_get_decision_for_site\n")
    return 0
}

// T46: Budget decreases after each approved inlining
fn test_inl_budget_decreases() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let callee_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, callee_name, 1, 0)
    funcs[1] = inl_make_test_func(1, 5)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    let budget_before = ctx.budget_remaining

    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    // Budget should have decreased by size_delta = 4
    let budget_after = ctx.budget_remaining
    let delta = budget_before - budget_after
    if delta != 4 {
        print("FAIL: test_inl_budget_decreases\n")
        return 1
    }
    print("PASS: test_inl_budget_decreases\n")
    return 0
}

// T47: Test func name generation
fn test_inl_func_name_gen() -> i32 with IO, Mut, Div, Panic {
    let n0 = inl_get_test_func_name(0)
    let n5 = inl_get_test_func_name(5)
    let n12 = inl_get_test_func_name(12)

    // "f0" = [102, 48], len=2
    if n0.len != 2 || n0.buf[0] != 102 as i8 || n0.buf[1] != 48 as i8 {
        print("FAIL: test_inl_func_name_gen\n")
        return 1
    }
    // "f5" = [102, 53], len=2
    if n5.len != 2 || n5.buf[1] != 53 as i8 {
        print("FAIL: test_inl_func_name_gen\n")
        return 1
    }
    // "f12" = [102, 49, 50], len=3
    if n12.len != 3 || n12.buf[1] != 49 as i8 || n12.buf[2] != 50 as i8 {
        print("FAIL: test_inl_func_name_gen\n")
        return 1
    }
    print("PASS: test_inl_func_name_gen\n")
    return 0
}

// ============================================================================
// Section 18: Test runner
// ============================================================================

fn test_inline_main() -> i32 with IO, Mut, Div, Panic {
    var passed: i64 = 0
    let total: i64 = 47

