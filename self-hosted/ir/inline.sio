// self-hosted::ir::inline — Function inlining pass
//
// Implements a complete function inlining pass for the self-hosted compiler IR:
//   1. Call graph construction — scan IR to discover all call sites
//   2. Cost model — estimate benefit/cost of inlining each call site
//   3. Bottom-up ordering — inline leaf functions first, then work upward
//   4. Budget enforcement — respect global and per-function size limits
//   5. Inline transformation — copy callee body, remap registers, adjust returns
//
// Design decisions:
//   - Small functions (< 10 instrs) are always inlined
//   - Recursive functions are never inlined
//   - Leaf functions get a bonus in the cost model
//   - Global budget limits total code growth to 2x original size
//   - Per-function limit prevents any single function from exceeding 500 instrs
//
// All arrays are fixed-size — no heap allocation.
//
// References:
//   Cooper & Torczon: "Engineering a Compiler" (2011), Ch. 8.7
//   Ayers, Gottlieb, Schooler: "Aggressive Inlining" (1997)

module ir::inline

use ir::ir::*
use ir::normalize::*
use parser::ast::{Name, empty_name}

// ============================================================================
// Section 1: Constants
// ============================================================================

let INL_MAX_CALL_SITES: i64 = 2048
let INL_MAX_FUNCS: i64 = 1024
let INL_MAX_DECISIONS: i64 = 2048

// Inlining thresholds
let INL_SMALL_FUNC_THRESHOLD: i64 = 10
let INL_MAX_FUNC_SIZE: i64 = 500
let INL_BUDGET_MULTIPLIER: i64 = 2

// Reason codes for inlining decisions
let INL_REASON_SMALL: i64 = 1
let INL_REASON_HOT: i64 = 2
let INL_REASON_LEAF: i64 = 3
let INL_REASON_TOO_LARGE: i64 = 4
let INL_REASON_RECURSIVE: i64 = 5
let INL_REASON_BUDGET: i64 = 6

// Sentinel values
let INL_INVALID: i64 = 0 - 1

// Leaf bonus multiplier: leaf functions get 3x benefit
let INL_LEAF_BONUS: i64 = 3

// Hot call site threshold: call sites with >= this many estimated
// invocations get a benefit boost
let INL_HOT_THRESHOLD: i64 = 5

// Sprint 49: Strategy-aware benefit bonuses from PGO
let INL_STRATEGY_AGGRESSIVE_BONUS: i64 = 80
let INL_STRATEGY_PRECISION_BONUS: i64 = 40

// ============================================================================
// Section 2: Structs
// ============================================================================

// Represents a single call site discovered in the IR
pub struct InlCallSite {
    caller_id: i64,
    callee_id: i64,
    call_instr_idx: i64,
    arg_count: i64,
    benefit_score: i64,
}

// Per-function metadata for inlining analysis
pub struct InlFuncInfo {
    func_id: i64,
    instr_count: i64,
    call_count: i64,
    is_recursive: bool,
    is_leaf: bool,
    has_loops: bool,
    estimated_cost: i64,
    compile_strategy: i64,
}

// An inlining decision for a specific call site
struct InlDecision {
    call_site_idx: i64,
    should_inline: bool,
    reason_code: i64,
    size_delta: i64,
}

// Overall inlining context with flat arrays for all state
pub struct InlContext {
    call_sites: [InlCallSite; 2048],
    call_site_count: i64,
    func_infos: [InlFuncInfo; 1024],
    func_info_count: i64,
    decisions: [InlDecision; 2048],
    decision_count: i64,
    total_original_size: i64,
    total_current_size: i64,
    budget_remaining: i64,
    inline_count: i64,
}

// Register remapping table used during inline transformation
struct InlRegMap {
    old_regs: [i64; 8192],
    new_regs: [i64; 8192],
    count: i64,
}

// Result of an inline transformation
struct InlTransformResult {
    func: IrFunction,
    instrs_added: i64,
    success: bool,
}

// Bottom-up ordering for functions (leaves first)
struct InlOrder {
    func_ids: [i64; 1024],
    count: i64,
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn inl_call_site_new(caller: i64, callee: i64, instr_idx: i64, args: i64) -> InlCallSite {
    InlCallSite {
        caller_id: caller,
        callee_id: callee,
        call_instr_idx: instr_idx,
        arg_count: args,
        benefit_score: 0,
    }
}

fn inl_default_call_site() -> InlCallSite {
    InlCallSite {
        caller_id: INL_INVALID,
        callee_id: INL_INVALID,
        call_instr_idx: INL_INVALID,
        arg_count: 0,
        benefit_score: 0,
    }
}

fn inl_func_info_new(fid: i64) -> InlFuncInfo {
    InlFuncInfo {
        func_id: fid,
        instr_count: 0,
        call_count: 0,
        is_recursive: false,
        is_leaf: true,
        has_loops: false,
        estimated_cost: 0,
        compile_strategy: 0,
    }
}

fn inl_default_func_info() -> InlFuncInfo {
    InlFuncInfo {
        func_id: INL_INVALID,
        instr_count: 0,
        call_count: 0,
        is_recursive: false,
        is_leaf: true,
        has_loops: false,
        estimated_cost: 0,
        compile_strategy: 0,
    }
}

fn inl_decision_new(cs_idx: i64, should: bool, reason: i64, delta: i64) -> InlDecision {
    InlDecision {
        call_site_idx: cs_idx,
        should_inline: should,
        reason_code: reason,
        size_delta: delta,
    }
}

fn inl_default_decision() -> InlDecision {
    InlDecision {
        call_site_idx: INL_INVALID,
        should_inline: false,
        reason_code: 0,
        size_delta: 0,
    }
}

pub(crate) fn inl_context_new() -> InlContext {
    InlContext {
        call_sites: [inl_default_call_site(); 2048],
        call_site_count: 0,
        func_infos: [inl_default_func_info(); 1024],
        func_info_count: 0,
        decisions: [inl_default_decision(); 2048],
        decision_count: 0,
        total_original_size: 0,
        total_current_size: 0,
        budget_remaining: 0,
        inline_count: 0,
    }
}

fn inl_reg_map_new() -> InlRegMap {
    InlRegMap {
        old_regs: [INL_INVALID; 8192],
        new_regs: [INL_INVALID; 8192],
        count: 0,
    }
}

fn inl_order_new() -> InlOrder {
    InlOrder {
        func_ids: [INL_INVALID; 1024],
        count: 0,
    }
}

// ============================================================================
// Section 3b: Local opcode comparison (module-scoped, avoids flat-namespace dep)
// ============================================================================

fn inl_matches_opcode(op: IrOpcode, target: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm => match target { IrOpcode::IrLoadImm => true, _ => false },
        IrOpcode::IrLoadFloat => match target { IrOpcode::IrLoadFloat => true, _ => false },
        IrOpcode::IrLoadBool => match target { IrOpcode::IrLoadBool => true, _ => false },
        IrOpcode::IrLoadString => match target { IrOpcode::IrLoadString => true, _ => false },
        IrOpcode::IrCopy => match target { IrOpcode::IrCopy => true, _ => false },
        IrOpcode::IrBinOp => match target { IrOpcode::IrBinOp => true, _ => false },
        IrOpcode::IrUnaryOp => match target { IrOpcode::IrUnaryOp => true, _ => false },
        IrOpcode::IrCall => match target { IrOpcode::IrCall => true, _ => false },
        IrOpcode::IrCallSret => match target { IrOpcode::IrCallSret => true, _ => false },
        IrOpcode::IrReturn => match target { IrOpcode::IrReturn => true, _ => false },
        IrOpcode::IrReturnSret => match target { IrOpcode::IrReturnSret => true, _ => false },
        IrOpcode::IrJump => match target { IrOpcode::IrJump => true, _ => false },
        IrOpcode::IrBranchTrue => match target { IrOpcode::IrBranchTrue => true, _ => false },
        IrOpcode::IrBranchFalse => match target { IrOpcode::IrBranchFalse => true, _ => false },
        IrOpcode::IrLabel => match target { IrOpcode::IrLabel => true, _ => false },
        IrOpcode::IrNop => match target { IrOpcode::IrNop => true, _ => false },
        _ => false,
    }
}

fn inl_opcodes_equal(a: IrOpcode, b: IrOpcode) -> bool {
    match a {
        IrOpcode::IrCall => inl_matches_opcode(b, IrOpcode::IrCall),
        IrOpcode::IrCallSret => inl_matches_opcode(b, IrOpcode::IrCallSret),
        IrOpcode::IrReturn => inl_matches_opcode(b, IrOpcode::IrReturn),
        IrOpcode::IrReturnSret => inl_matches_opcode(b, IrOpcode::IrReturnSret),
        IrOpcode::IrJump => inl_matches_opcode(b, IrOpcode::IrJump),
        IrOpcode::IrBranchTrue => inl_matches_opcode(b, IrOpcode::IrBranchTrue),
        IrOpcode::IrBranchFalse => inl_matches_opcode(b, IrOpcode::IrBranchFalse),
        IrOpcode::IrLabel => inl_matches_opcode(b, IrOpcode::IrLabel),
        IrOpcode::IrNop => inl_matches_opcode(b, IrOpcode::IrNop),
        IrOpcode::IrLoadImm => inl_matches_opcode(b, IrOpcode::IrLoadImm),
        IrOpcode::IrLoadFloat => inl_matches_opcode(b, IrOpcode::IrLoadFloat),
        IrOpcode::IrLoadBool => inl_matches_opcode(b, IrOpcode::IrLoadBool),
        IrOpcode::IrLoadString => inl_matches_opcode(b, IrOpcode::IrLoadString),
        IrOpcode::IrCopy => inl_matches_opcode(b, IrOpcode::IrCopy),
        IrOpcode::IrBinOp => inl_matches_opcode(b, IrOpcode::IrBinOp),
        IrOpcode::IrUnaryOp => inl_matches_opcode(b, IrOpcode::IrUnaryOp),
        _ => false,
    }
}

// ============================================================================
// Section 4: Opcode classification helpers
// ============================================================================

// Check if an instruction is a call
fn inl_is_call(instr: IrInstr) -> bool {
    inl_opcodes_equal(instr.op, IrOpcode::IrCall) || inl_opcodes_equal(instr.op, IrOpcode::IrCallSret)
}

// Check if an instruction is a return
fn inl_is_return(instr: IrInstr) -> bool {
    inl_opcodes_equal(instr.op, IrOpcode::IrReturn) || inl_opcodes_equal(instr.op, IrOpcode::IrReturnSret)
}

// Check if an instruction is a backward jump (heuristic for loop detection).
// A jump or branch_true/branch_false to a label with id <= current position
// in the instruction stream suggests a loop back-edge.
fn inl_is_backward_branch(instr: IrInstr, current_idx: i64) -> bool {
    if inl_opcodes_equal(instr.op, IrOpcode::IrJump) {
        return instr.label_id >= 0 && instr.label_id < current_idx
    }
    if inl_opcodes_equal(instr.op, IrOpcode::IrBranchTrue) {
        return instr.label_id >= 0 && instr.label_id < current_idx
    }
    if inl_opcodes_equal(instr.op, IrOpcode::IrBranchFalse) {
        return instr.label_id >= 0 && instr.label_id < current_idx
    }
    return false
}

// Check if an instruction is a label
fn inl_is_label(instr: IrInstr) -> bool {
    inl_opcodes_equal(instr.op, IrOpcode::IrLabel)
}

// Check if an instruction is a nop
fn inl_is_nop(instr: IrInstr) -> bool {
    inl_opcodes_equal(instr.op, IrOpcode::IrNop)
}

// ============================================================================
// Section 5: Function analysis — gather per-function info
// ============================================================================

// Analyze a single function to compute its InlFuncInfo
pub(crate) fn inl_analyze_function(func: IrFunction, func_id: i64) -> InlFuncInfo with Mut, Div, Panic {
    var info = inl_func_info_new(func_id)
    info.instr_count = func.instr_count
    info.compile_strategy = func.compile_strategy

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))

        // Count calls
        if inl_is_call(instr) {
            info.call_count = info.call_count + 1
            info.is_leaf = false
        }

        // Detect loops via backward branches (heuristic)
        if inl_is_backward_branch(instr, i) {
            info.has_loops = true
        }

        i = i + 1
    }

    // Estimated cost: instruction count + penalty for loops
    info.estimated_cost = info.instr_count
    if info.has_loops {
        info.estimated_cost = info.estimated_cost + info.instr_count
    }

    return info
}

// Analyze all functions in a module and populate context func_infos
fn inl_analyze_module(ctx: InlContext, module: IrModule) -> InlContext with Mut, Div, Panic {
    var out = ctx
    var total: i64 = 0

    var i: i64 = 0
    while i < module.fn_count && i < INL_MAX_FUNCS {
        let info = inl_analyze_function(module.functions[i as usize], i)
        out.func_infos[i as usize] = info
        total = total + info.instr_count
        i = i + 1
    }

    out.func_info_count = i
    out.total_original_size = total
    out.total_current_size = total
    out.budget_remaining = total * INL_BUDGET_MULTIPLIER - total

    return out
}

// ============================================================================
// Section 6: Call graph construction — discover call sites
// ============================================================================

// Find the function index by name in the module, returns INL_INVALID if not found
fn inl_find_func_by_name(module: IrModule, name: Name) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < module.fn_count {
        if ir_name_eq(module.functions[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    return INL_INVALID
}

// Scan a single function for call instructions and add them as call sites
fn inl_discover_calls_in_func(ctx: InlContext, module: IrModule, caller_id: i64) -> InlContext with Mut, Div, Panic {
    var out = ctx
    let func = module.functions[caller_id as usize]

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if inl_is_call(instr) {
            let callee_id = inl_find_func_by_name(module, ir_name_at(instr.name_id))
            if callee_id >= 0 && out.call_site_count < INL_MAX_CALL_SITES {
                var site = inl_call_site_new(caller_id, callee_id, i, instr.arg_count)
                out.call_sites[out.call_site_count as usize] = site
                out.call_site_count = out.call_site_count + 1
            }
        }
        i = i + 1
    }

    return out
}

// Discover all call sites across the entire module
fn inl_discover_all_calls(ctx: InlContext, module: IrModule) -> InlContext with Mut, Div, Panic {
    var out = ctx
    var i: i64 = 0
    while i < module.fn_count {
        out = inl_discover_calls_in_func(out, module, i)
        i = i + 1
    }
    return out
}

// ============================================================================
// Section 7: Recursion detection
// ============================================================================

// Check if function A (directly or transitively) calls itself.
// Simple direct recursion: any call site where caller_id == callee_id.
fn inl_detect_direct_recursion(ctx: InlContext) -> InlContext with Mut, Div, Panic {
    var out = ctx

    var i: i64 = 0
    while i < out.call_site_count {
        let site = out.call_sites[i as usize]
        if site.caller_id == site.callee_id {
            // Mark the function as recursive
            if site.caller_id >= 0 && site.caller_id < out.func_info_count {
                out.func_infos[site.caller_id as usize].is_recursive = true
            }
        }
        i = i + 1
    }

    return out
}

// Detect mutual recursion: if A calls B and B calls A, both are recursive.
// Uses a simple reachability check: for each function, check if it can
// reach itself through call edges within a bounded depth.
fn inl_detect_mutual_recursion(ctx: InlContext) -> InlContext with Mut, Div, Panic {
    var out = ctx

    // For each function, do a bounded BFS/DFS through call edges
    var fid: i64 = 0
    while fid < out.func_info_count {
        if !out.func_infos[fid as usize].is_recursive {
            // visited[i] = 1 means function i has been visited
            var visited: [i64; 1024] = [0; 1024]
            // work stack: function ids to explore
            var stack: [i64; 256] = [INL_INVALID; 256]
            var stack_top: i64 = 0

            // Seed with direct callees of fid
            var ci: i64 = 0
            while ci < out.call_site_count {
                let s = out.call_sites[ci as usize]
                if s.caller_id == fid && s.callee_id >= 0 && s.callee_id < INL_MAX_FUNCS {
                    if stack_top < 256 {
                        stack[stack_top as usize] = s.callee_id
                        stack_top = stack_top + 1
                    }
                }
                ci = ci + 1
            }

            // BFS
            var found_cycle: bool = false
            while stack_top > 0 && !found_cycle {
                stack_top = stack_top - 1
                let cur = stack[stack_top as usize]

                if cur == fid {
                    found_cycle = true
                } else if cur >= 0 && cur < 1024 && visited[cur as usize] == 0 {
                    visited[cur as usize] = 1
                    // Push callees of cur
                    var cj: i64 = 0
                    while cj < out.call_site_count {
                        let s2 = out.call_sites[cj as usize]
                        if s2.caller_id == cur && s2.callee_id >= 0 && s2.callee_id < INL_MAX_FUNCS {
                            if stack_top < 256 {
                                stack[stack_top as usize] = s2.callee_id
                                stack_top = stack_top + 1
                            }
                        }
                        cj = cj + 1
                    }
                }
            }

            if found_cycle {
                out.func_infos[fid as usize].is_recursive = true
            }
        }
        fid = fid + 1
    }

    return out
}

// ============================================================================
// Section 8: Cost model — compute benefit scores
// ============================================================================

// Compute the benefit score for a single call site.
// Higher score = more desirable to inline.
// Negative score = should not inline.
pub(crate) fn inl_compute_benefit(ctx: InlContext, site_idx: i64) -> i64 with Mut, Div, Panic {
    let site = ctx.call_sites[site_idx as usize]
    let callee_id = site.callee_id

    if callee_id < 0 || callee_id >= ctx.func_info_count {
        return 0 - 1
    }

    let callee_info = ctx.func_infos[callee_id as usize]

    // Never inline recursive functions
    if callee_info.is_recursive {
        return 0 - 100
    }

    // Never inline functions larger than the max size
    if callee_info.instr_count > INL_MAX_FUNC_SIZE {
        return 0 - 50
    }

    var score: i64 = 0

    // Small function bonus: always beneficial
    if callee_info.instr_count < INL_SMALL_FUNC_THRESHOLD {
        score = score + 100
    }

    // Leaf function bonus: no further call overhead
    if callee_info.is_leaf {
        score = score + 30 * INL_LEAF_BONUS
    }

    // Sprint 49: Strategy-aware benefit boost from PGO
    if callee_info.compile_strategy == 1 {
        score = score + INL_STRATEGY_AGGRESSIVE_BONUS
    }
    if callee_info.compile_strategy == 2 {
        score = score + INL_STRATEGY_PRECISION_BONUS
    }

    // Penalty for large functions
    if callee_info.instr_count > 50 {
        score = score - callee_info.instr_count
    }

    // Penalty for loops in callee
    if callee_info.has_loops {
        score = score - 20
    }

    // Benefit of eliminating call overhead (estimated ~5 instructions)
    score = score + 5

    return score
}

// Compute benefit scores for all call sites
fn inl_score_all_sites(ctx: InlContext) -> InlContext with Mut, Div, Panic {
    var out = ctx

    var i: i64 = 0
    while i < out.call_site_count {
        let score = inl_compute_benefit(out, i)
        out.call_sites[i as usize].benefit_score = score
        i = i + 1
    }

    return out
}

// ============================================================================
// Section 9: Inlining decisions
// ============================================================================

// Make the inlining decision for a single call site
fn inl_decide_site(ctx: InlContext, site_idx: i64) -> InlDecision with Mut, Div, Panic {
    let site = ctx.call_sites[site_idx as usize]
    let callee_id = site.callee_id

    if callee_id < 0 || callee_id >= ctx.func_info_count {
        return inl_decision_new(site_idx, false, INL_REASON_TOO_LARGE, 0)
    }

    let callee_info = ctx.func_infos[callee_id as usize]
    let size_delta = callee_info.instr_count - 1  // replace call with body, minus the call itself

    // Never inline recursive
    if callee_info.is_recursive {
        return inl_decision_new(site_idx, false, INL_REASON_RECURSIVE, 0)
    }

    // Never inline functions that are too large
    if callee_info.instr_count > INL_MAX_FUNC_SIZE {
        return inl_decision_new(site_idx, false, INL_REASON_TOO_LARGE, 0)
    }

    // Check budget
    if size_delta > ctx.budget_remaining {
        return inl_decision_new(site_idx, false, INL_REASON_BUDGET, size_delta)
    }

    // Always inline small functions
    if callee_info.instr_count < INL_SMALL_FUNC_THRESHOLD {
        return inl_decision_new(site_idx, true, INL_REASON_SMALL, size_delta)
    }

    // Inline leaf functions with positive benefit
    if callee_info.is_leaf && site.benefit_score > 0 {
        return inl_decision_new(site_idx, true, INL_REASON_LEAF, size_delta)
    }

    // Inline hot call sites (benefit score above threshold)
    if site.benefit_score > INL_HOT_THRESHOLD {
        return inl_decision_new(site_idx, true, INL_REASON_HOT, size_delta)
    }

    // Default: don't inline
    return inl_decision_new(site_idx, false, INL_REASON_TOO_LARGE, size_delta)
}

// Make decisions for all call sites and update context
fn inl_decide_all(ctx: InlContext) -> InlContext with Mut, Div, Panic {
    var out = ctx
    out.decision_count = 0

    var i: i64 = 0
    while i < out.call_site_count {
        let decision = inl_decide_site(out, i)
        if out.decision_count < INL_MAX_DECISIONS {
            out.decisions[out.decision_count as usize] = decision
            out.decision_count = out.decision_count + 1
        }

        // Update budget if we decided to inline
        if decision.should_inline {
            out.budget_remaining = out.budget_remaining - decision.size_delta
            out.total_current_size = out.total_current_size + decision.size_delta
            out.inline_count = out.inline_count + 1
        }

        i = i + 1
    }

    return out
}

// ============================================================================
// Section 10: Bottom-up ordering
// ============================================================================

// Compute a bottom-up ordering of functions: leaves first, then their callers.
// This ensures callees are inlined before their callers process them.
fn inl_compute_order(ctx: InlContext) -> InlOrder with Mut, Div, Panic {
    var order = inl_order_new()

    // Phase 1: add all leaf functions first
    var i: i64 = 0
    while i < ctx.func_info_count {
        if ctx.func_infos[i as usize].is_leaf && !ctx.func_infos[i as usize].is_recursive {
            if order.count < INL_MAX_FUNCS {
                order.func_ids[order.count as usize] = i
                order.count = order.count + 1
            }
        }
        i = i + 1
    }

    // Phase 2: add non-leaf, non-recursive functions sorted by call count (ascending)
    // Simple insertion: scan for minimum call count among remaining, add it
    var added: [bool; 1024] = [false; 1024]

    // Mark leaves as already added
    var k: i64 = 0
    while k < order.count {
        let fid = order.func_ids[k as usize]
        if fid >= 0 && fid < 1024 {
            added[fid as usize] = true
        }
        k = k + 1
    }

    // Also mark recursive functions — they go last
    var r: i64 = 0
    while r < ctx.func_info_count {
        if ctx.func_infos[r as usize].is_recursive {
            added[r as usize] = true
        }
        r = r + 1
    }

    // Iteratively find the non-leaf with the fewest calls among remaining
    var remaining: i64 = ctx.func_info_count - order.count
    // Count recursive separately
    var rec_count: i64 = 0
    var rc: i64 = 0
    while rc < ctx.func_info_count {
        if ctx.func_infos[rc as usize].is_recursive {
            rec_count = rec_count + 1
        }
        rc = rc + 1
    }
    remaining = remaining - rec_count

    while remaining > 0 {
        var best_id: i64 = INL_INVALID
        var best_calls: i64 = 999999

        var j: i64 = 0
        while j < ctx.func_info_count {
            if !added[j as usize] && !ctx.func_infos[j as usize].is_recursive {
                if ctx.func_infos[j as usize].call_count < best_calls {
                    best_calls = ctx.func_infos[j as usize].call_count
                    best_id = j
                }
            }
            j = j + 1
        }

        if best_id == INL_INVALID {
            remaining = 0
        } else {
            if order.count < INL_MAX_FUNCS {
                order.func_ids[order.count as usize] = best_id
                order.count = order.count + 1
            }
            added[best_id as usize] = true
            remaining = remaining - 1
        }
    }

    // Phase 3: add recursive functions last (they won't be inlined but need processing)
    var m: i64 = 0
    while m < ctx.func_info_count {
        if ctx.func_infos[m as usize].is_recursive {
            if order.count < INL_MAX_FUNCS {
                order.func_ids[order.count as usize] = m
                order.count = order.count + 1
            }
        }
        m = m + 1
    }

    return order
}

// ============================================================================
// Section 11: Register remapping
// ============================================================================

// Add a mapping from old_reg to new_reg
fn inl_reg_map_add(rmap: InlRegMap, old_reg: i64, new_reg: i64) -> InlRegMap with Mut, Div, Panic {
    var out = rmap
    if out.count < 8192 {
        out.old_regs[out.count as usize] = old_reg
        out.new_regs[out.count as usize] = new_reg
        out.count = out.count + 1
    }
    return out
}

// Look up the new register for an old register. Returns old_reg if not found.
fn inl_reg_map_lookup(rmap: InlRegMap, old_reg: i64) -> i64 with Mut, Div, Panic {
    if old_reg < 0 {
        return old_reg
    }
    var i: i64 = 0
    while i < rmap.count {
        if rmap.old_regs[i as usize] == old_reg {
            return rmap.new_regs[i as usize]
        }
        i = i + 1
    }
    return old_reg
}

// Remap a single instruction's registers using the mapping table
fn inl_remap_instr(instr: IrInstr, rmap: InlRegMap) -> IrInstr with Mut, Div, Panic {
    var out = instr
    out.dst = inl_reg_map_lookup(rmap, instr.dst)
    out.src1 = inl_reg_map_lookup(rmap, instr.src1)
    out.src2 = inl_reg_map_lookup(rmap, instr.src2)
    return out
}

// ============================================================================
// Section 12: Label remapping for inlined bodies
// ============================================================================

// Remap a label_id in an instruction by adding an offset
fn inl_remap_label(instr: IrInstr, label_offset: i64) -> IrInstr with Mut, Div, Panic {
    var out = instr
    if out.label_id >= 0 {
        out.label_id = out.label_id + label_offset
    }
    return out
}

// ============================================================================
// Section 13: Inline transformation
// ============================================================================

// Perform the actual inlining: copy callee body into caller at the call site,
// remap registers, adjust return instructions to assignments.
//
// Steps:
//   1. Allocate new registers in caller for callee's registers (offset by caller reg_count)
//   2. Map callee parameters to caller's call arguments
//   3. Copy callee instructions, remapping registers and labels
//   4. Replace callee IrReturn with IrCopy to caller's destination register
//   5. Shift all instructions after the call site
fn inl_transform(caller: IrFunction, callee: IrFunction, call_idx: i64) -> InlTransformResult with Mut, Div, Panic {
    var result = InlTransformResult {
        func: caller,
        instrs_added: 0,
        success: false,
    }

    // Validate indices
    if call_idx < 0 || call_idx >= caller.instr_count {
        return result
    }

    let call_instr = ir_arena_load(ir_region_slot_r(caller.region, (call_idx)))
    let call_dst = call_instr.dst

    // Number of callee instructions (excluding IrReturn, we replace those)
    let callee_body_size = callee.instr_count
    // Net new instructions: callee body replaces the single call instruction
    let net_added = callee_body_size - 1

    // Check we don't overflow the instruction buffer
    if caller.instr_count + net_added >= 32768 {
        return result
    }

    // Step 1: Build register mapping — callee regs get offset by caller's reg_count
    let reg_offset = caller.reg_count
    var rmap = inl_reg_map_new()

    // Map callee parameters to caller's argument registers
    var p: i64 = 0
    while p < callee.param_count && p < 64 {
        let callee_param_reg = callee.param_regs[p as usize]
        // The caller's argument for this parameter:
        // First two args are in call_instr.src1 and call_instr.src2
        var caller_arg_reg: i64 = INL_INVALID
        if p == 0 {
            caller_arg_reg = call_instr.src1
        } else if p == 1 {
            caller_arg_reg = call_instr.src2
        }
        // For p >= 2, we would need to walk call_args linked list.
        // For simplicity, map to offset register (the callee body will
        // have parameter loads that we can replace).

        if caller_arg_reg >= 0 {
            rmap = inl_reg_map_add(rmap, callee_param_reg, caller_arg_reg)
        } else {
            rmap = inl_reg_map_add(rmap, callee_param_reg, callee_param_reg + reg_offset)
        }
        p = p + 1
    }

    // Map remaining callee registers to offset registers
    var cr: i64 = 0
    while cr < callee.reg_count {
        // Only map if not already mapped (parameters were mapped above)
        let existing = inl_reg_map_lookup(rmap, cr)
        if existing == cr {
            // Not mapped yet — offset it
            rmap = inl_reg_map_add(rmap, cr, cr + reg_offset)
        }
        cr = cr + 1
    }

    let label_offset = caller.label_count

    // Step 2: Shift existing instructions after call site to make room
    var out_func = ir_function_clone(&caller)
    var shift: i64 = out_func.instr_count - 1
    while shift > call_idx {
        let new_pos = shift + net_added
        if new_pos >= 0 && new_pos < 32768 {
            ir_arena_copy_slot(ir_region_slot_w(out_func.region, (new_pos)),ir_region_slot_r(out_func.region, (shift)))
        }
        shift = shift - 1
    }

    // Step 3: Copy callee instructions into the gap, remapping registers and labels
    var write_pos: i64 = call_idx
    var ci: i64 = 0
    while ci < callee.instr_count {
        let callee_instr = ir_arena_load(ir_region_slot_r(callee.region, (ci)))

        if inl_is_return(callee_instr) {
            // Replace return with copy to caller's destination
            if call_dst >= 0 {
                let remapped_src = inl_reg_map_lookup(rmap, callee_instr.src1)
                ir_arena_store(ir_region_slot_w(out_func.region, (write_pos)), ir_copy(call_dst, remapped_src))
            } else {
                ir_arena_store(ir_region_slot_w(out_func.region, (write_pos)), ir_nop())
            }
        } else {
            var remapped = inl_remap_instr(callee_instr, rmap)
            remapped = inl_remap_label(remapped, label_offset)
            ir_arena_store(ir_region_slot_w(out_func.region, (write_pos)), remapped)
        }

        write_pos = write_pos + 1
        ci = ci + 1
    }

    out_func.instr_count = caller.instr_count + net_added
    out_func.reg_count = caller.reg_count + callee.reg_count
    out_func.label_count = caller.label_count + callee.label_count

    result.func = out_func
    result.instrs_added = net_added
    result.success = true

    return result
}

// ============================================================================
// Section 14: Master inlining pipeline
// ============================================================================

// Run the full inlining pass on a module
pub fn inl_run_pass(module: IrModule) -> IrModule with Mut, Div, Panic {
    // Phase 1: Analyze all functions
    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)

    // Phase 2: Discover call graph
    ctx = inl_discover_all_calls(ctx, module)

    // Phase 3: Detect recursion
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_detect_mutual_recursion(ctx)

    // Phase 4: Score call sites
    ctx = inl_score_all_sites(ctx)

    // Phase 5: Make inlining decisions
    ctx = inl_decide_all(ctx)

    // Phase 6: Compute bottom-up order
    let order = inl_compute_order(ctx)

    // Phase 7: Apply transformations in bottom-up order
    var result = module

    var oi: i64 = 0
    while oi < order.count {
        let func_id = order.func_ids[oi as usize]
        if func_id >= 0 && func_id < result.fn_count {
            // Process all call sites in this function that were approved
            var di: i64 = 0
            while di < ctx.decision_count {
                let dec = ctx.decisions[di as usize]
                if dec.should_inline && dec.call_site_idx >= 0 {
                    let site = ctx.call_sites[dec.call_site_idx as usize]
                    if site.caller_id == func_id {
                        let callee = result.functions[site.callee_id as usize]
                        let xform = inl_transform(
                            result.functions[func_id as usize],
                            callee,
                            site.call_instr_idx
                        )
                        if xform.success {
                            result.functions[func_id as usize] = xform.func
                        }
                    }
                }
                di = di + 1
            }
        }
        oi = oi + 1
    }

    return result
}

// ============================================================================
// Section 15: Query helpers — used by tests and other passes
// ============================================================================

// Count how many call sites target a specific callee
fn inl_count_sites_for_callee(ctx: InlContext, callee_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.call_site_count {
        if ctx.call_sites[i as usize].callee_id == callee_id {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Count how many decisions approved inlining
fn inl_count_approved(ctx: InlContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.decision_count {
        if ctx.decisions[i as usize].should_inline {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Count how many decisions were rejected for a given reason
fn inl_count_rejected_by_reason(ctx: InlContext, reason: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.decision_count {
        let d = ctx.decisions[i as usize]
        if !d.should_inline && d.reason_code == reason {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Get the decision for a specific call site index
fn inl_get_decision_for_site(ctx: InlContext, site_idx: i64) -> InlDecision with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.decision_count {
        if ctx.decisions[i as usize].call_site_idx == site_idx {
            return ctx.decisions[i as usize]
        }
        i = i + 1
    }
    return inl_default_decision()
}

// Find the call site index for a given caller/callee pair
fn inl_find_site(ctx: InlContext, caller: i64, callee: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.call_site_count {
        let s = ctx.call_sites[i as usize]
        if s.caller_id == caller && s.callee_id == callee {
            return i
        }
        i = i + 1
    }
    return INL_INVALID
}

// Count non-nop instructions in a function
fn inl_count_real_instrs(func: IrFunction) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < func.instr_count {
        if !inl_is_nop(ir_arena_load(ir_region_slot_r(func.region, (i)))) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ============================================================================
// Section 16: Test helpers — build synthetic IR for testing
// ============================================================================

// Build a simple test function with N load-imm instructions + a return.
// func_id is used to assign a unique name.
fn inl_make_test_func(func_id: i64, body_size: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()

    // Build a simple name from func_id: "f0", "f1", etc.
    var name = ir_empty_name()
    // ASCII 'f' = 102
    name.buf[0] = 102 as i8
    // Digit for func_id (works for 0-9)
    if func_id >= 0 && func_id <= 9 {
        name.buf[1] = (48 + func_id) as i8
        name.len = 2
    } else {
        // For func_id 10+, use two digits
        let tens = func_id / 10
        let ones = func_id - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    func.name = name

    // Fill body with load_imm instructions
    var i: i64 = 0
    while i < body_size - 1 && i < 32767 {
        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(i, i + 100))
        i = i + 1
    }

    // Final instruction: return
    if body_size > 0 {
        let ret_reg = if body_size > 1 { body_size - 2 } else { 0 }
        ir_arena_store(ir_region_slot_w(func.region, ((body_size - 1))), ir_return(ret_reg))
    }

    func.instr_count = body_size
    func.reg_count = body_size
    func.label_count = 0
    func.param_count = 0

    return func
}

// Build a test function that calls another function by name
fn inl_make_caller_func(func_id: i64, callee_name: Name, body_before: i64, body_after: i64) -> IrFunction with Mut, Div, Panic {
    var func = inl_make_test_func(func_id, 0)

    // Re-name with our func_id
    var name = ir_empty_name()
    name.buf[0] = 102 as i8
    if func_id >= 0 && func_id <= 9 {
        name.buf[1] = (48 + func_id) as i8
        name.len = 2
    } else {
        let tens = func_id / 10
        let ones = func_id - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    func.name = name

    var pos: i64 = 0

    // Load-imm instructions before call
    var b: i64 = 0
    while b < body_before {
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(pos, b + 200))
        pos = pos + 1
        b = b + 1
    }

    // Call instruction
    let call_dst = pos
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst, 0, callee_name, ir_empty_reg_list(), 0))
    pos = pos + 1

    // Load-imm instructions after call
    var a: i64 = 0
    while a < body_after {
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(pos, a + 300))
        pos = pos + 1
        a = a + 1
    }

    // Return
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst))
    pos = pos + 1

    func.instr_count = pos
    func.reg_count = pos

    return func
}

// Build a module with given functions
fn inl_make_test_module(funcs: [IrFunction; 1024], count: i64) -> IrModule {
    var module = ir_empty_module()
    var fi: i64 = 0
    while fi < count && fi < 1024 {
        module.functions[fi as usize] = funcs[fi as usize]
        fi = fi + 1
    }
    module.fn_count = count
    module
}

// Build a function that calls itself (directly recursive)
fn inl_make_recursive_func(func_id: i64, body_size: i64) -> IrFunction with Mut, Div, Panic {
    var func = inl_make_test_func(func_id, 0)

    // Re-build name
    var name = ir_empty_name()
    name.buf[0] = 102 as i8
    if func_id >= 0 && func_id <= 9 {
        name.buf[1] = (48 + func_id) as i8
        name.len = 2
    } else {
        let tens = func_id / 10
        let ones = func_id - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    func.name = name

    var pos: i64 = 0
    // Some body
    var b: i64 = 0
    while b < body_size - 2 && b < 32766 {
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(pos, b))
        pos = pos + 1
        b = b + 1
    }

    // Self-call
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(pos, func_id, name, ir_empty_reg_list(), 0))
    pos = pos + 1

    // Return
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(pos - 1))
    pos = pos + 1

    func.instr_count = pos
    func.reg_count = pos

    return func
}

// Build a function that contains a backward branch (loop)
fn inl_make_loop_func(func_id: i64) -> IrFunction with Mut, Div, Panic {
    var func = inl_make_test_func(func_id, 0)

    var name = ir_empty_name()
    name.buf[0] = 102 as i8
    if func_id >= 0 && func_id <= 9 {
        name.buf[1] = (48 + func_id) as i8
        name.len = 2
    } else {
        let tens = func_id / 10
        let ones = func_id - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    func.name = name

    // r0 = 0 (counter)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 0))
    // L0:
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_label(0))
    // r1 = r0 + 1
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(1, 0, BinaryOp::OpAdd, 0))
    // r2 = r1 < 10
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(2, 10))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(3, 1, BinaryOp::OpLt, 2))
    // branch back to L0 if true (backward branch: label 0, current idx 5)
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_branch_true(3, 0))
    // return r1
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_return(1))

    func.instr_count = 7
    func.reg_count = 4
    func.label_count = 1

    return func
}

// Get a function's name for test building
fn inl_get_test_func_name(func_id: i64) -> Name with Mut, Div, Panic {
    var name = ir_empty_name()
    name.buf[0] = 102 as i8
    if func_id >= 0 && func_id <= 9 {
        name.buf[1] = (48 + func_id) as i8
        name.len = 2
    } else {
        let tens = func_id / 10
        let ones = func_id - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    return name
}

// ============================================================================
// Section 17: Tests
// ============================================================================

// T01: Context initialization — all counts zero
fn test_inl_context_init() -> i32 with IO, Mut, Div, Panic {
    let ctx = inl_context_new()
    if ctx.call_site_count != 0 || ctx.func_info_count != 0 || ctx.decision_count != 0 {
        print("FAIL: test_inl_context_init\n")
        return 1
    }
    print("PASS: test_inl_context_init\n")
    return 0
}

// T02: Single leaf function analysis — is_leaf should be true
fn test_inl_leaf_detection() -> i32 with IO, Mut, Div, Panic {
    let func = inl_make_test_func(0, 5)
    let info = inl_analyze_function(func, 0)
    if !info.is_leaf || info.call_count != 0 || info.instr_count != 5 {
        print("FAIL: test_inl_leaf_detection\n")
        return 1
    }
    print("PASS: test_inl_leaf_detection\n")
    return 0
}

// T03: Non-leaf function — function with call is not a leaf
fn test_inl_non_leaf_detection() -> i32 with IO, Mut, Div, Panic {
    let callee_name = inl_get_test_func_name(1)
    let func = inl_make_caller_func(0, callee_name, 2, 1)
    let info = inl_analyze_function(func, 0)
    if info.is_leaf || info.call_count != 1 {
        print("FAIL: test_inl_non_leaf_detection\n")
        return 1
    }
    print("PASS: test_inl_non_leaf_detection\n")
    return 0
}

// T04: Loop detection — function with backward branch flagged
fn test_inl_loop_detection() -> i32 with IO, Mut, Div, Panic {
    let func = inl_make_loop_func(0)
    let info = inl_analyze_function(func, 0)
    if !info.has_loops {
        print("FAIL: test_inl_loop_detection\n")
        return 1
    }
    print("PASS: test_inl_loop_detection\n")
    return 0
}

// T05: Call site discovery — finds call from f0 to f1
fn test_inl_call_site_discovery() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let callee_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, callee_name, 2, 1)
    funcs[1] = inl_make_test_func(1, 5)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    if ctx.call_site_count != 1 {
        print("FAIL: test_inl_call_site_discovery\n")
        return 1
    }
    let site = ctx.call_sites[0]
    if site.caller_id != 0 || site.callee_id != 1 {
        print("FAIL: test_inl_call_site_discovery\n")
        return 1
    }
    print("PASS: test_inl_call_site_discovery\n")
    return 0
}

// T06: Multiple call sites — two calls from f0 to f1
fn test_inl_multiple_call_sites() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let callee_name = inl_get_test_func_name(1)

    // Build caller with two calls manually
    var caller = ir_empty_function()
    caller.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(caller.region, (1)), ir_call(1, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (2)), ir_load_imm(2, 2))
    ir_arena_store(ir_region_slot_w(caller.region, (3)), ir_call(3, 0, callee_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(caller.region, (4)), ir_return(3))
    caller.instr_count = 5
    caller.reg_count = 4

    funcs[0] = caller
    funcs[1] = inl_make_test_func(1, 5)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)

    if ctx.call_site_count != 2 {
        print("FAIL: test_inl_multiple_call_sites\n")
        return 1
    }
    let count = inl_count_sites_for_callee(ctx, 1)
    if count != 2 {
        print("FAIL: test_inl_multiple_call_sites\n")
        return 1
    }
    print("PASS: test_inl_multiple_call_sites\n")
    return 0
}

// T07: Direct recursion detected
fn test_inl_direct_recursion() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = inl_make_recursive_func(0, 6)
    let module = inl_make_test_module(funcs, 1)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)

    if !ctx.func_infos[0].is_recursive {
        print("FAIL: test_inl_direct_recursion\n")
        return 1
    }
    print("PASS: test_inl_direct_recursion\n")
    return 0
}

// T08: Non-recursive function not flagged
fn test_inl_non_recursive() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
