// T23: Leaf function gets higher benefit than non-leaf
fn test_inl_leaf_higher_benefit() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]

    // f0 calls f1 (leaf) and f2 (non-leaf which calls f3)
    let f1_name = inl_get_test_func_name(1)
    let f2_name = inl_get_test_func_name(2)
    let f3_name = inl_get_test_func_name(3)

    // f0: calls f1 and f2
    var f0 = ir_empty_function()
    f0.name = inl_get_test_func_name(0)
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_call(0, 0, f1_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (1)), ir_call(1, 0, f2_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(f0.region, (2)), ir_return(1))
    f0.instr_count = 3
    f0.reg_count = 2

    funcs[0] = f0
    funcs[1] = inl_make_test_func(1, 15)  // leaf, 15 instrs
    funcs[2] = inl_make_caller_func(2, f3_name, 5, 5)  // non-leaf, calls f3
    funcs[3] = inl_make_test_func(3, 5)   // leaf
    let module = inl_make_test_module(funcs, 4)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)

    // Find call sites: f0->f1 and f0->f2
    let site_f1 = inl_find_site(ctx, 0, 1)
    let site_f2 = inl_find_site(ctx, 0, 2)

    if site_f1 < 0 || site_f2 < 0 {
        print("FAIL: test_inl_leaf_higher_benefit\n")
        return 1
    }

    let benefit_f1 = inl_compute_benefit(ctx, site_f1)
    let benefit_f2 = inl_compute_benefit(ctx, site_f2)

    // f1 is leaf, so should have higher benefit than f2 (non-leaf)
    if benefit_f1 <= benefit_f2 {
        print("FAIL: test_inl_leaf_higher_benefit\n")
        return 1
    }
    print("PASS: test_inl_leaf_higher_benefit\n")
    return 0
}

// T24: Estimated cost includes loop penalty
fn test_inl_loop_cost_penalty() -> i32 with IO, Mut, Div, Panic {
    let func_no_loop = inl_make_test_func(0, 7)
    let func_loop = inl_make_loop_func(1)

    let info_no_loop = inl_analyze_function(func_no_loop, 0)
    let info_loop = inl_analyze_function(func_loop, 1)

    // Loop func has same instr count but higher estimated cost
    if info_loop.estimated_cost <= info_loop.instr_count {
        // Good: loop penalty applied
        if info_no_loop.estimated_cost != info_no_loop.instr_count {
            print("FAIL: test_inl_loop_cost_penalty\n")
            return 1
        }
    } else {
        print("FAIL: test_inl_loop_cost_penalty\n")
        return 1
    }
    print("PASS: test_inl_loop_cost_penalty\n")
    return 0
}

// T25: Instruction count at threshold boundary
fn test_inl_threshold_boundary() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]

    // Callee with exactly INL_SMALL_FUNC_THRESHOLD (10) instrs — NOT small
    let callee_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, callee_name, 2, 1)
    funcs[1] = inl_make_test_func(1, INL_SMALL_FUNC_THRESHOLD)
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)
    ctx = inl_decide_all(ctx)

    // 10 instrs is NOT < 10, so should NOT be INL_REASON_SMALL
    let dec = ctx.decisions[0]
    if dec.reason_code == INL_REASON_SMALL {
        print("FAIL: test_inl_threshold_boundary\n")
        return 1
    }
    print("PASS: test_inl_threshold_boundary\n")
    return 0
}

