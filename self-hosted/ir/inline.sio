// T14: Module analysis counts functions correctly
fn test_inl_module_analysis() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = inl_make_test_func(0, 10)
    funcs[1] = inl_make_test_func(1, 20)
    funcs[2] = inl_make_test_func(2, 30)
    let module = inl_make_test_module(funcs, 3)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)

    if ctx.func_info_count != 3 {
        print("FAIL: test_inl_module_analysis\n")
        return 1
    }
    if ctx.total_original_size != 60 {
        print("FAIL: test_inl_module_analysis\n")
        return 1
    }
    // Budget = 60 * 2 - 60 = 60
    if ctx.budget_remaining != 60 {
        print("FAIL: test_inl_module_analysis\n")
        return 1
    }
    print("PASS: test_inl_module_analysis\n")
    return 0
}

// T15: Budget computed correctly
fn test_inl_budget_computation() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = inl_make_test_func(0, 100)
    let module = inl_make_test_module(funcs, 1)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)

    // Budget = 100 * 2 - 100 = 100
    if ctx.budget_remaining != 100 {
        print("FAIL: test_inl_budget_computation\n")
        return 1
    }
    print("PASS: test_inl_budget_computation\n")
    return 0
}

// T16: Budget enforcement — exhausting budget rejects further inlining
fn test_inl_budget_enforcement() -> i32 with IO, Mut, Div, Panic {
    // Create a tiny module: one caller, one callee with 8 instrs (small threshold)
    // But set budget to only 2
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let callee_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, callee_name, 1, 0)
    funcs[1] = inl_make_test_func(1, 8)  // small, would normally inline
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)
    ctx = inl_score_all_sites(ctx)

    // Manually set budget to tiny value so size_delta > budget
    ctx.budget_remaining = 2

    ctx = inl_decide_all(ctx)

    // Callee has 8 instrs, so size_delta = 7, budget = 2 -> rejected
    if ctx.decision_count < 1 {
        print("FAIL: test_inl_budget_enforcement\n")
        return 1
    }
    let dec = ctx.decisions[0]
    if dec.should_inline {
        print("FAIL: test_inl_budget_enforcement\n")
        return 1
    }
    if dec.reason_code != INL_REASON_BUDGET {
        print("FAIL: test_inl_budget_enforcement\n")
        return 1
    }
    print("PASS: test_inl_budget_enforcement\n")
    return 0
}

// T17: Bottom-up order puts leaves first
fn test_inl_bottom_up_leaves_first() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let f1_name = inl_get_test_func_name(1)
    funcs[0] = inl_make_caller_func(0, f1_name, 2, 1)  // non-leaf: calls f1
    funcs[1] = inl_make_test_func(1, 5)                 // leaf
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)

    let order = inl_compute_order(ctx)
    if order.count < 2 {
        print("FAIL: test_inl_bottom_up_leaves_first\n")
        return 1
    }
    // First in order should be f1 (leaf), second should be f0 (caller)
    if order.func_ids[0] != 1 {
        print("FAIL: test_inl_bottom_up_leaves_first\n")
        return 1
    }
    if order.func_ids[1] != 0 {
        print("FAIL: test_inl_bottom_up_leaves_first\n")
        return 1
    }
    print("PASS: test_inl_bottom_up_leaves_first\n")
    return 0
}

// T18: Bottom-up order puts recursive last
fn test_inl_bottom_up_recursive_last() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = inl_make_test_func(0, 5)          // leaf
    funcs[1] = inl_make_recursive_func(1, 6)     // recursive
    let module = inl_make_test_module(funcs, 2)

    var ctx = inl_context_new()
    ctx = inl_analyze_module(ctx, module)
    ctx = inl_discover_all_calls(ctx, module)
    ctx = inl_detect_direct_recursion(ctx)

    let order = inl_compute_order(ctx)
    if order.count < 2 {
        print("FAIL: test_inl_bottom_up_recursive_last\n")
        return 1
    }
    // Leaf first, recursive last
    if order.func_ids[0] != 0 {
        print("FAIL: test_inl_bottom_up_recursive_last\n")
        return 1
    }
    if order.func_ids[1] != 1 {
        print("FAIL: test_inl_bottom_up_recursive_last\n")
        return 1
    }
    print("PASS: test_inl_bottom_up_recursive_last\n")
    return 0
}

