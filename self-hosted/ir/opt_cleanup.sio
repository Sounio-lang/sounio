                    let cs_cdef = def_at[cs_s2 as usize]
                    if cs_merged == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(cs_instr.dst, bt_add_src[cs_s1 as usize]))
                    } else if cs_cdef >= 0 {
                        if cs_merged > 0 {
                            ir_arena_store(ir_region_slot_w(result.region, (cs_cdef)), ir_load_imm(cs_s2, cs_merged))
                            const_val[cs_s2 as usize] = cs_merged
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cs_instr.dst, bt_add_src[cs_s1 as usize], BinaryOp::OpAdd, cs_s2))
                            if cs_instr.dst >= 0 && cs_instr.dst < 256 {
                                bt_add_valid[cs_instr.dst as usize] = true
                                bt_add_src[cs_instr.dst as usize]   = bt_add_src[cs_s1 as usize]
                                bt_add_cval[cs_instr.dst as usize]  = cs_merged
                            }
                        } else {
                            let cs_neg = 0 - cs_merged
                            ir_arena_store(ir_region_slot_w(result.region, (cs_cdef)), ir_load_imm(cs_s2, cs_neg))
                            const_val[cs_s2 as usize] = cs_neg
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cs_instr.dst, bt_add_src[cs_s1 as usize], BinaryOp::OpSub, cs_s2))
                            if cs_instr.dst >= 0 && cs_instr.dst < 256 {
                                bs_sub_valid[cs_instr.dst as usize] = true
                                bs_sub_src[cs_instr.dst as usize]   = bt_add_src[cs_s1 as usize]
                                bs_sub_cval[cs_instr.dst as usize]  = cs_neg
                            }
                        }
                    }
                }
            }
        }
        // Sprint 86 Block M: Negation tracking — populate.
        // Record when a register is produced by OpNeg for double-neg detection.
        if instr.op == IrOpcode::IrUnaryOp && instr.un_op == UnaryOp::OpNeg {
            if instr.dst >= 0 && instr.dst < 256 {
                is_neg[instr.dst as usize]  = true
                neg_src[instr.dst as usize] = instr.src1
            }
        }
        // Sprint 86 Block M: Negation arithmetic fold.
        // x * (-1) → 0 - x  ;  x / (-1) → 0 - x  ;  x % (-1) → 0
        // neg(neg(x)) → IrCopy(x)
        // SOTA: LLVM InstCombine; Cooper & Torczon §9 — negation is an algebraic
        //       inverse; propagating it eliminates redundant sign inversions.
        if ocp_is_binop(instr.op) {
            let mn_s1 = instr.src1
            let mn_s2 = instr.src2
            let mn_s1_ok = mn_s1 >= 0 && mn_s1 < 256
            let mn_s2_ok = mn_s2 >= 0 && mn_s2 < 256
            let mn_s2_k = mn_s2_ok && is_const[mn_s2 as usize]
            let mn_s1_k = mn_s1_ok && is_const[mn_s1 as usize]
            // x * (-1) → 0 - x  ;  x / (-1) → 0 - x
            if instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                if mn_s2_k && const_val[mn_s2 as usize] == -1 && !mn_s1_k {
                    let c_def = def_at[mn_s2 as usize]
                    if c_def >= 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (c_def)), ir_load_imm(mn_s2, 0))
                        const_val[mn_s2 as usize] = 0
                    }
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, mn_s2, BinaryOp::OpSub, mn_s1))
                }
                // (-1) * x → 0 - x  (commutative flip: s1 is const -1, s2 is var)
                if mn_s1_k && const_val[mn_s1 as usize] == -1 && !mn_s2_k {
                    let c_def = def_at[mn_s1 as usize]
                    if c_def >= 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (c_def)), ir_load_imm(mn_s1, 0))
                        const_val[mn_s1 as usize] = 0
                    }
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, mn_s1, BinaryOp::OpSub, mn_s2))
                }
            }
            // x % (-1) → IrLoadImm(0)  (remainder by -1 is always 0)
            if instr.bin_op == BinaryOp::OpRem {
                if mn_s2_k && const_val[mn_s2 as usize] == -1 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                    if instr.dst >= 0 && instr.dst < 256 {
                        is_const[instr.dst as usize] = true
                        const_val[instr.dst as usize] = 0
                    }
                }
            }
        }
        // neg(neg(x)) → IrCopy(x)  (double negation elimination)
        if (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp
            && (IR_A_UN_OP[(ir_region_slot_r(result.region, (i))) as usize] as UnaryOp) == UnaryOp::OpNeg {
            let nn_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let nn_s = nn_instr.src1
            if nn_s >= 0 && nn_s < 256 && is_neg[nn_s as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(nn_instr.dst, neg_src[nn_s as usize]))
                if nn_instr.dst >= 0 && nn_instr.dst < 256 {
                    is_neg[nn_instr.dst as usize] = false
                }
            }
        }

        // Sprint 110 Block AG: Add/sub with negated operand simplification.
        // x + neg(y) → x - y  ;  x - neg(y) → x + y  ;  neg(x) + y → y - x.
        // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let ag_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let ag_s1 = ag_instr.src1
            let ag_s2 = ag_instr.src2
            let ag_s1_ok = ag_s1 >= 0 && ag_s1 < 256
            let ag_s2_ok = ag_s2 >= 0 && ag_s2 < 256
            // x + neg(y) → x - y
            if ag_instr.bin_op == BinaryOp::OpAdd && ag_s2_ok && is_neg[ag_s2 as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ag_instr.dst, ag_s1, BinaryOp::OpSub, neg_src[ag_s2 as usize]))
            }
            // neg(x) + y → y - x  (commutative: neg on src1 of add)
            if ag_instr.bin_op == BinaryOp::OpAdd && ag_s1_ok && is_neg[ag_s1 as usize]
                && !(ag_s2_ok && is_neg[ag_s2 as usize]) {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ag_instr.dst, ag_s2, BinaryOp::OpSub, neg_src[ag_s1 as usize]))
            }
            // x - neg(y) → x + y
            if ag_instr.bin_op == BinaryOp::OpSub && ag_s2_ok && is_neg[ag_s2 as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ag_instr.dst, ag_s1, BinaryOp::OpAdd, neg_src[ag_s2 as usize]))
            }
        }
        // Sprint 69: Constant propagation through IrCopy.
        // Re-reads current instruction to catch copies created by identity folding (Sprint 67).
        // When r1 = IrCopy(r0) and r0 is a known constant, mark r1 constant too,
        // enabling subsequent BinOp folding and strength reduction at i+1, i+2, etc.
        if (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrCopy {
            let ci = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let src = ci.src1
            let dst = ci.dst
            if src >= 0 && src < 256 && dst >= 0 && dst < 256 {
                if is_const[src as usize] {
                    is_const[dst as usize] = true
                    const_val[dst as usize] = const_val[src as usize]
                    def_at[dst as usize] = def_at[src as usize]
                }
            }
        }
        // Sprint 84 Block L: Associative constant-chain folding.
        // Detects the pattern: r1 = (base assoc_op c1), r2 = r1 assoc_op c2
        // and folds to: r2 = base assoc_op (c1 assoc_op c2).
        // In-place: patches def_at[c2_reg] → IrLoadImm(c2_reg, combined)
        //           patches current instr   → IrBinOp(dst, base, op, c2_reg)
        // r1 becomes dead → DCE removes it on next pass.
        // Sub-pass 2: records has_ra metadata for future chain folding.
        // Supports Add, Mul, BitAnd, BitOr, BitXor (associative over integers).
        // Runs before power-of-two strength reduction so mul chains still see
        // their original OpMul shape long enough to reassociate.
        // SOTA: Click "Combining Reductions" PLDI 1995 §4;
        //   Aho, Lam, Sethi, Ullman "Compilers" §8.5 (reassociation of constants).
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let la_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let la_s1 = la_instr.src1
            let la_s2 = la_instr.src2
            let la_s1_ok = la_s1 >= 0 && la_s1 < 256
            let la_s2_ok = la_s2 >= 0 && la_s2 < 256
            let la_ra_key = ocp_binop_to_ra_key(la_instr.bin_op)
            // Sub-pass 1: fold (base assoc c1) assoc c2 → base assoc (c1+c2)
            if la_ra_key != 0 && la_s1_ok && la_s2_ok
                && has_ra[la_s1 as usize]
                && ra_op[la_s1 as usize] == la_ra_key
                && is_const[la_s2 as usize] {
                let la_c1 = ra_const_val[la_s1 as usize]
                let la_c2 = const_val[la_s2 as usize]
                let la_c2_def = def_at[la_s2 as usize]
                let la_base = ra_base[la_s1 as usize]
                var la_combined: i64 = 0
                var la_did = false
                if la_instr.bin_op == BinaryOp::OpAdd    { la_combined = la_c1 + la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpMul    { la_combined = la_c1 * la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitAnd { la_combined = la_c1 & la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitOr  { la_combined = la_c1 | la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitXor { la_combined = la_c1 ^ la_c2; la_did = true }
                if la_did && la_c2_def >= 0 {
                    var la_applied = false
                    if ocp_rebracket_is_exact_bitwise_op(la_instr.bin_op) {
                        // The exact bitwise slice accepts only fully modeled uses. Its
                        // private certificate separately proves local ordering or one
                        // dominated forward-CFG path.
                        // The legacy Add/Mul branch below does not call this transaction.
                        if exact_bitwise_use_model_ok {
                            let la_inner_def = ra_def_idx[la_s1 as usize]
                            let la_txn = ocp_try_exact_bitwise_rebracket(&! result, i, la_inner_def)
                            ocp_record_exact_bitwise_rebracket_audit(exact_bitwise_audit, la_txn)
                            if la_txn.application_count == 1 {
                                la_combined = la_txn.combined_const_value
                                la_applied = true
                            }
                        }
                    } else {
                        // Legacy integer Add/Mul folding is retained unchanged in this
                        // slice. It is not evidence for the exact bitwise authority gate.
                        ir_arena_store(ir_region_slot_w(result.region, (la_c2_def)), ir_load_imm(la_s2, la_combined))
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(la_instr.dst, la_base, la_instr.bin_op, la_s2))
                        la_applied = true
                    }
                    if la_applied {
                        const_val[la_s2 as usize] = la_combined
                        if la_instr.dst >= 0 && la_instr.dst < 256 {
                            has_ra[la_instr.dst as usize] = true
                            ra_base[la_instr.dst as usize] = la_base
                            ra_const_val[la_instr.dst as usize] = la_combined
                            ra_op[la_instr.dst as usize] = la_ra_key
                            ra_def_idx[la_instr.dst as usize] = i
                        }
                        if la_instr.bin_op == BinaryOp::OpMul {
                            preserve_mul_chain = true
                        }
                    }
                }
            }
            // Sub-pass 2: record has_ra for the (possibly rewritten) current instr.
            let la_rec = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let la_rec_s1 = la_rec.src1
            let la_rec_s2 = la_rec.src2
            let la_rec_s1_ok = la_rec_s1 >= 0 && la_rec_s1 < 256
            let la_rec_s2_ok = la_rec_s2 >= 0 && la_rec_s2 < 256
            let la_rec_key = ocp_binop_to_ra_key(la_rec.bin_op)
            if la_rec_key != 0 && ocp_is_binop(la_rec.op)
                && la_rec.dst >= 0 && la_rec.dst < 256
                && la_rec_s1_ok && la_rec_s2_ok {
                // s1 non-const, s2 const
                if !is_const[la_rec_s1 as usize] && is_const[la_rec_s2 as usize] {
                    has_ra[la_rec.dst as usize] = true
                    ra_base[la_rec.dst as usize] = la_rec_s1
                    ra_const_val[la_rec.dst as usize] = const_val[la_rec_s2 as usize]
                    ra_op[la_rec.dst as usize] = la_rec_key
                    ra_def_idx[la_rec.dst as usize] = i
                }
                // s1 const, s2 non-const (commutative assoc ops only)
                if is_const[la_rec_s1 as usize] && !is_const[la_rec_s2 as usize]
                    && ocp_is_commutative_op(la_rec.bin_op) {
                    has_ra[la_rec.dst as usize] = true
                    ra_base[la_rec.dst as usize] = la_rec_s2
                    ra_const_val[la_rec.dst as usize] = const_val[la_rec_s1 as usize]
                    ra_op[la_rec.dst as usize] = la_rec_key
                    ra_def_idx[la_rec.dst as usize] = i
                }
            }
        }
        // Sprint 68: Strength reduction for power-of-2 mul/div/rem.
        // Re-reads the current instruction so previous blocks' rewrites are respected.
        // Patches both the IrBinOp and the preceding IrLoadImm (via def_at) in place.
        //   x * 2^n → x << n  (OpMul → OpShl, constant patched to log2)
        //   x / 2^n → x >> n  (OpDiv → OpShr, constant patched to log2)
        //   x % 2^n → x & (2^n-1)  (OpRem → OpBitAnd, constant patched to mask)
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let cur = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let s2 = cur.src2
            let s1 = cur.src1
            let s2_ok = s2 >= 0 && s2 < 256
            if s2_ok && is_const[s2 as usize] {
                let v2 = const_val[s2 as usize]
                let def_idx = def_at[s2 as usize]
                if def_idx >= 0 && ocp_is_power_of_two(v2) {
                    if cur.bin_op == BinaryOp::OpMul && !preserve_mul_chain {
                        let shift = ocp_log2(v2)
                        ir_arena_store(ir_region_slot_w(result.region, (def_idx)), ir_load_imm(s2, shift))
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cur.dst, s1, BinaryOp::OpShl, s2))
                        const_val[s2 as usize] = shift
                    }
                    if cur.bin_op == BinaryOp::OpDiv {
                        let shift = ocp_log2(v2)
                        ir_arena_store(ir_region_slot_w(result.region, (def_idx)), ir_load_imm(s2, shift))
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cur.dst, s1, BinaryOp::OpShr, s2))
                        const_val[s2 as usize] = shift
                    }
                    if cur.bin_op == BinaryOp::OpRem {
                        let mask = v2 - 1
                        ir_arena_store(ir_region_slot_w(result.region, (def_idx)), ir_load_imm(s2, mask))
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cur.dst, s1, BinaryOp::OpBitAnd, s2))
                        const_val[s2 as usize] = mask
                    }
                }
            }
        }
        // Sprint 71 Block A: Same-register algebraic fold.
        // When src1 == src2 for certain ops the result is statically known.
        //   x - x → 0   (OpSub with same register)
        //   x ^ x → 0   (OpBitXor with same register)
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let sr_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let sr_s1 = sr_instr.src1
            let sr_s2 = sr_instr.src2
            if sr_s1 >= 0 && sr_s1 == sr_s2 {
                if sr_instr.bin_op == BinaryOp::OpSub || sr_instr.bin_op == BinaryOp::OpBitXor {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(sr_instr.dst, 0))
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 0
                        def_at[sr_instr.dst as usize] = i
                    }
                }
                // Sprint 72 Block D: Bitwise same-register idempotency.
                // x & x → IrCopy(dst, x)  ;  x | x → IrCopy(dst, x)
                if sr_instr.bin_op == BinaryOp::OpBitAnd || sr_instr.bin_op == BinaryOp::OpBitOr {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(sr_instr.dst, sr_s1))
                }
                // Sprint 95 Block S: Same-register division/remainder.
                // x / x → 1   (assuming x ≠ 0; statically sound for non-zero regs)
                if sr_instr.bin_op == BinaryOp::OpDiv {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(sr_instr.dst, 1))
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 1
                        def_at[sr_instr.dst as usize] = i
                    }
                }
                // x % x → 0
                if sr_instr.bin_op == BinaryOp::OpRem {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(sr_instr.dst, 0))
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 0
                        def_at[sr_instr.dst as usize] = i
                    }
                }
            }
        }
        // Sprint 71 Block B: Left-constant commutative strength reduction.
        // Sprint 68 SR only fires when the constant is on src2 (right).
        // For OpMul (commutative), when a power-of-2 constant is on src1 (left),
        // apply the same SR: 4 * x → x << 2.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let cm_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let cm_s1 = cm_instr.src1
            let cm_s2 = cm_instr.src2
            let cm_s1_ok = cm_s1 >= 0 && cm_s1 < 256
            let cm_s2_ok = cm_s2 >= 0 && cm_s2 < 256
            if cm_instr.bin_op == BinaryOp::OpMul {
                if cm_s1_ok && cm_s2_ok && is_const[cm_s1 as usize] && !is_const[cm_s2 as usize] {
                    let cm_v1 = const_val[cm_s1 as usize]
                    let cm_def = def_at[cm_s1 as usize]
                    if cm_def >= 0 && ocp_is_power_of_two(cm_v1) {
                        let shift = ocp_log2(cm_v1)
                        ir_arena_store(ir_region_slot_w(result.region, (cm_def)), ir_load_imm(cm_s1, shift))
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(cm_instr.dst, cm_s2, BinaryOp::OpShl, cm_s1))
                        const_val[cm_s1 as usize] = shift
                    }
                }
            }
        }
        // Sprint 74 Block E: Comparison operator constant folding.
        // References: Wegman & Zadeck, "Constant Propagation with Conditional Branches"
        //   (TOPLAS 1991) §2 — comparison lattice values are the foundation for SCCP.
        //
        // Both-constant: fold OpEq/Ne/Lt/Le/Gt/Ge when both srcs are known integers.
        //   5 == 5 → IrLoadImm(dst, 1)   5 != 5 → IrLoadImm(dst, 0)
        //   3 < 7  → IrLoadImm(dst, 1)   7 < 3  → IrLoadImm(dst, 0)
        //   3 <= 3 → IrLoadImm(dst, 1)   3 > 3  → IrLoadImm(dst, 0)
        //
        // Same-register: fold when src1 == src2 (reflexive relations).
        //   x == x → 1   x != x → 0
        //   x < x  → 0   x <= x → 1
        //   x > x  → 0   x >= x → 1
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let cmp = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let cmp_s1 = cmp.src1
            let cmp_s2 = cmp.src2
            let cmp_is_cmp =
                cmp.bin_op == BinaryOp::OpEq || cmp.bin_op == BinaryOp::OpNe
                || cmp.bin_op == BinaryOp::OpLt || cmp.bin_op == BinaryOp::OpLe
                || cmp.bin_op == BinaryOp::OpGt || cmp.bin_op == BinaryOp::OpGe
            if cmp_is_cmp {
                let cmp_s1_ok = cmp_s1 >= 0 && cmp_s1 < 256
                let cmp_s2_ok = cmp_s2 >= 0 && cmp_s2 < 256
                // Both-constant fold
                if cmp_s1_ok && cmp_s2_ok && is_const[cmp_s1 as usize] && is_const[cmp_s2 as usize] {
                    let cv1 = const_val[cmp_s1 as usize]
                    let cv2 = const_val[cmp_s2 as usize]
                    var cmp_result: i64 = 0
                    if cmp.bin_op == BinaryOp::OpEq { cmp_result = if cv1 == cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpNe { cmp_result = if cv1 != cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpLt { cmp_result = if cv1 < cv2  { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpLe { cmp_result = if cv1 <= cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpGt { cmp_result = if cv1 > cv2  { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpGe { cmp_result = if cv1 >= cv2 { 1 } else { 0 } }
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(cmp.dst, cmp_result))
                    if cmp.dst >= 0 && cmp.dst < 256 {
                        is_const[cmp.dst as usize] = true
                        const_val[cmp.dst as usize] = cmp_result
                        def_at[cmp.dst as usize] = i
                    }
                }
                // Same-register fold
                if cmp_s1_ok && cmp_s1 == cmp_s2 {
                    var sr_cmp: i64 = 0
                    if cmp.bin_op == BinaryOp::OpEq { sr_cmp = 1 }
                    if cmp.bin_op == BinaryOp::OpNe { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpLt { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpLe { sr_cmp = 1 }
                    if cmp.bin_op == BinaryOp::OpGt { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpGe { sr_cmp = 1 }
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(cmp.dst, sr_cmp))
                    if cmp.dst >= 0 && cmp.dst < 256 {
                        is_const[cmp.dst as usize] = true
                        const_val[cmp.dst as usize] = sr_cmp
                        def_at[cmp.dst as usize] = i
                    }
                }
            }
        }
        // Sprint 101 Block Y: Track comparison results for boolean simplification.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let bl = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let bl_d = bl.dst
            if bl_d >= 0 && bl_d < 256 {
                if bl.bin_op == BinaryOp::OpEq {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 1
                }
                if bl.bin_op == BinaryOp::OpNe {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 2
                }
                if bl.bin_op == BinaryOp::OpLt || bl.bin_op == BinaryOp::OpLe
                        || bl.bin_op == BinaryOp::OpGt || bl.bin_op == BinaryOp::OpGe {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 3
                }
            }
        }
        // Sprint 101 Block Y: Boolean simplification.
        // (x == 0) == 0 → IrCopy(x)  (double boolean negation)
        // (x != 0) != 0 → IrCopy(x)  (double negation via Ne)
        // bool != 0 → IrCopy(bool)   (general: any comparison result != 0 is identity)
        // 0 == (x == 0) → IrCopy(x)  (commutative variant)
        // SOTA: LLVM InstCombineCompares.cpp; Click PLDI 1995 §2.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let bl = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let bl_s1 = bl.src1
            let bl_s2 = bl.src2
            let bl_s1_ok = bl_s1 >= 0 && bl_s1 < 256
            let bl_s2_ok = bl_s2 >= 0 && bl_s2 < 256
            // (x == 0) == 0 → IrCopy(x): s2 is const 0, s1 is cmp_result with OpEq, cmp_orig_src[s1]=x
            if bl.bin_op == BinaryOp::OpEq && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize]
                    && cmp_op_code[bl_s1 as usize] == 1 {
                let orig = cmp_orig_src[bl_s1 as usize]
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, orig))
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // (x != 0) != 0 → IrCopy(x)
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize]
                    && cmp_op_code[bl_s1 as usize] == 2 {
                let orig = cmp_orig_src[bl_s1 as usize]
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, orig))
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // bool != 0 → IrCopy(bool): any comparison result != 0 is identity
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, bl_s1))
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // 0 == (x == 0) → IrCopy(x): commutative — const on left, cmp_result on right
            if bl.bin_op == BinaryOp::OpEq && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 0
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize]
                    && cmp_op_code[bl_s2 as usize] == 1 {
                let orig = cmp_orig_src[bl_s2 as usize]
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, orig))
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // Sprint 113 Block AJ: Boolean comparison with 1.
            // bool == 1 → IrCopy(bool)  (comparison results are 0 or 1)
            // 1 == bool → IrCopy(bool)  (commutative)
            // bool != 1 → (bool == 0)   (boolean negation — rewrite to Eq with 0)
            // SOTA: LLVM InstCombineCompares.cpp; standard boolean identity.
            // s2 is const 1, s1 is comparison result
            if bl.bin_op == BinaryOp::OpEq && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 1
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, bl_s1))
            }
            // s1 is const 1, s2 is comparison result (commutative)
            if bl.bin_op == BinaryOp::OpEq && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 1
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize] {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(bl.dst, bl_s2))
            }
            // bool != 1 → rewrite to (bool == 0): keeps boolean semantics,
            // enables further (x==0)==0 folding by Block Y on next pass.
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 1
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                let aj_def = def_at[bl_s2 as usize]
                if aj_def >= 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (aj_def)), ir_load_imm(bl_s2, 0))
                    const_val[bl_s2 as usize] = 0
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(bl.dst, bl_s1, BinaryOp::OpEq, bl_s2))
                }
            }
            // 1 != bool → rewrite to (bool == 0) (commutative)
            if bl.bin_op == BinaryOp::OpNe && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 1
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize] {
                let aj_def = def_at[bl_s1 as usize]
                if aj_def >= 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (aj_def)), ir_load_imm(bl_s1, 0))
                    const_val[bl_s1 as usize] = 0
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(bl.dst, bl_s2, BinaryOp::OpEq, bl_s1))
                }
            }
        }
                // Sprint 75 Block F: Conditional branch folding.
        // When a branch condition register holds a known constant, the branch outcome is static.
        // IrBranchTrue(r, L)  + is_const[r]=true + const_val[r]!=0 → IrJump(L)
        // IrBranchTrue(r, L)  + is_const[r]=true + const_val[r]==0 → IrNop
        // IrBranchFalse(r, L) + is_const[r]=true + const_val[r]==0 → IrJump(L)
        // IrBranchFalse(r, L) + is_const[r]=true + const_val[r]!=0 → IrNop
        // SOTA: Wegman & Zadeck TOPLAS 1991 §3 (executable edge marking);
        //   Cooper & Torczon §9.3 (dead-branch elimination via constant condition).
        if (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrBranchTrue
            || (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrBranchFalse {
            let br = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let br_cond = br.src1
            if br_cond >= 0 && br_cond < 256 && is_const[br_cond as usize] {
                let cv = const_val[br_cond as usize]
                let taken =
                    if br.op == IrOpcode::IrBranchTrue { cv != 0 }
                    else { cv == 0 }
                if taken {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_jump(br.label_id))
                } else {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
                }
            }
        }

        // Sprint 76 Block G: Shift identity and annihilator folding.
        // Shift-by-zero identity:  x << 0 → IrCopy(x),    x >> 0 → IrCopy(x)
        // Zero-shift annihilator:  0 << n → IrLoadImm(0), 0 >> n → IrLoadImm(0)
        // SOTA: Cooper & Torczon "Engineering a Compiler" §8.1 (algebraic identities for shifts).
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let sh = ir_arena_load(ir_region_slot_r(result.region, (i)))
            if sh.bin_op == BinaryOp::OpShl || sh.bin_op == BinaryOp::OpShr {
                let sh_s1 = sh.src1
                let sh_s2 = sh.src2
                let sh_s1_ok = sh_s1 >= 0 && sh_s1 < 256
                let sh_s2_ok = sh_s2 >= 0 && sh_s2 < 256
                // Shift-by-zero identity: x << 0 → IrCopy(x), x >> 0 → IrCopy(x)
                if sh_s2_ok && is_const[sh_s2 as usize] && const_val[sh_s2 as usize] == 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(sh.dst, sh_s1))
                // Zero-shift annihilator: 0 << n → 0, 0 >> n → 0
                } else if sh_s1_ok && is_const[sh_s1 as usize] && const_val[sh_s1 as usize] == 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(sh.dst, 0))
                    if sh.dst >= 0 && sh.dst < 256 {
                        is_const[sh.dst as usize] = true
                        const_val[sh.dst as usize] = 0
                        def_at[sh.dst as usize] = i
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

// ============================================================================
// Pass 2: Dead code elimination (mark-sweep)
// ============================================================================

// Mark which registers are used as source operands across the function.
fn ocp_mark_used(func: &IrFunction) -> [bool; 256] with Mut, Div, Panic {
    var used: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.src1 >= 0 && instr.src1 < 256 {
            used[instr.src1 as usize] = true
        }
        if instr.src2 >= 0 && instr.src2 < 256 {
            used[instr.src2 as usize] = true
        }
        i = i + 1
    }
    used
}

// Sweep: remove instructions whose dst is unused and have no side effects.
fn ocp_sweep(func: IrFunction, used: &[bool; 256]) -> (IrFunction, i64) with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var removed: i64 = 0
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if ocp_has_dst(instr.op) && !ocp_has_side_effect(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                if !used[instr.dst as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
                    removed = removed + 1
                }
            }
        }
        i = i + 1
    }
    (result, removed)
}

// Run one DCE sweep on a single function.
fn ocp_dce_once(func: IrFunction) -> (IrFunction, i64) with Mut, Div, Panic {
    let used = ocp_mark_used(&func)
    ocp_sweep(func, &used)
}

// Run DCE on a single function.
fn ocp_dce(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    let swept = ocp_dce_once(func)
    swept.0
}

// ============================================================================
// Sprint 72: E-graph equality saturation pass (full, deferred)
// ============================================================================

// E-graph equality saturation pass (Sprint 72 foundation).
//
// Architecture: IR function → EgGraph (IR opcodes mapped to EG_OP_*)
//   → eg_algebraic_saturate → cost-based extraction → patched IR.
//
// Activation guard: currently deferred (func.instr_count > 0 always skips).
// EgContext is ~4MB on the interpreter stack; activates when souc runs
// natively instead of under double-JIT interpretation.  The wiring,
// ocp_binop_to_eg_op bridge, and extract-back logic are all present and
// correct — only the guard prevents double-JIT OOM.
fn ocp_egraph_pass(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    // Deferred: activate when EgContext allocation is safe (native souc).
    // All structural integration (module import, binop bridge, call site
    // in opt_cleanup_function) is live; only this guard prevents execution.
    if func.instr_count > 0 { return func }
    func
}

// ============================================================================
// Sprint 73: Common Subexpression Elimination (CSE)
// ============================================================================
//
// Forward single-pass scan over IrBinOp instructions.  For each IrBinOp,
// check a table of previously seen (eg_op_key, src1, src2) triples.
// On match: rewrite to IrCopy(dst, prev_dst).  DCE downstream removes any
// now-dead definitions.
//
// Only mapped ops (OpAdd/Sub/Mul/Div → EG_OP_ADD/SUB/MUL/DIV) are eligible;
// unmapped ops (AND/OR/XOR → EG_OP_CONST) are excluded conservatively.
//
// References:
//   Cooper & Torczon: "Engineering a Compiler", Ch. 8 (Value Numbering / CSE)
fn ocp_cse_invalidate_reg(
    cse_op: [i64; 128],
    cse_src1: [i64; 128],
    cse_src2: [i64; 128],
    cse_dst: [i64; 128],
    cse_len: i64,
    reg: i64
) -> OcpCseTables with Mut, Div, Panic {
    var next_op = cse_op
    var next_src1 = cse_src1
    var next_src2 = cse_src2
    var next_dst = cse_dst
    var out_len: i64 = 0
    var i: i64 = 0
    while i < cse_len {
        let matches_src1 = next_src1[i as usize] == reg
        let matches_src2 = next_src2[i as usize] == reg
        let matches_dst = next_dst[i as usize] == reg
        if !(matches_src1 || matches_src2 || matches_dst) {
            next_op[out_len as usize] = next_op[i as usize]
            next_src1[out_len as usize] = next_src1[i as usize]
            next_src2[out_len as usize] = next_src2[i as usize]
            next_dst[out_len as usize] = next_dst[i as usize]
            out_len = out_len + 1
        }
        i = i + 1
    }
    OcpCseTables { op: next_op, src1: next_src1, src2: next_src2, dst: next_dst, len: out_len }
}

// Sprint 77: Return true for commutative binary ops whose operands can be
// canonicalized (src1 ← min, src2 ← max) without changing semantics.
fn ocp_is_commutative_op(bin_op: BinaryOp) -> bool {
    bin_op == BinaryOp::OpAdd || bin_op == BinaryOp::OpMul
    || bin_op == BinaryOp::OpOr || bin_op == BinaryOp::OpAnd
    || bin_op == BinaryOp::OpBitXor
}

pub(crate) fn ocp_cse(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var cse_op:   [i64; 128] = [0; 128]
    var cse_src1: [i64; 128] = [0; 128]
    var cse_src2: [i64; 128] = [0; 128]
    var cse_dst:  [i64; 128] = [0; 128]
    var cse_len: i64 = 0
    var i: i64 = 0
    while i < result.instr_count {
        let instr   = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if ocp_has_dst(instr.op) && instr.dst >= 0 {
            let invalidated = ocp_cse_invalidate_reg(cse_op, cse_src1, cse_src2, cse_dst, cse_len, instr.dst)
            cse_op = invalidated.op
            cse_src1 = invalidated.src1
            cse_src2 = invalidated.src2
            cse_dst = invalidated.dst
            cse_len = invalidated.len
        }
        if ocp_is_binop(instr.op) {
            let op_key = ocp_binop_to_cse_key(instr.bin_op)
            if op_key != 0 {
                // Sprint 77 Block H: Commutative CSE canonicalization.
                // For commutative ops, sort (src1, src2) so smaller register is first.
                // This makes a+b and b+a hash to the same CSE table entry.
                // SOTA: Click "Value Numbering" PLDI 1995 §3.1 (canonical operand ordering).
                var cse_s1 = instr.src1
                var cse_s2 = instr.src2
                if ocp_is_commutative_op(instr.bin_op) && cse_s1 > cse_s2 {
                    let tmp = cse_s1
                    cse_s1 = cse_s2
                    cse_s2 = tmp
                }
                var j: i64 = 0
                var found: i64 = 0 - 1
                while j < cse_len {
                    let same_op = cse_op[j as usize] == op_key
                    let same_src1 = cse_src1[j as usize] == cse_s1
                    let same_src2 = cse_src2[j as usize] == cse_s2
                    if same_op && same_src1 && same_src2 {
                        found = j
                        break
                    }
                    j = j + 1
                }
                if found >= 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, cse_dst[found as usize]))
                } else {
                    if cse_len < 128 {
                        cse_op[cse_len as usize]   = op_key
                        cse_src1[cse_len as usize] = cse_s1
                        cse_src2[cse_len as usize] = cse_s2
                        cse_dst[cse_len as usize]  = instr.dst
                        cse_len = cse_len + 1
                    }
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 73: Mini e-graph pass — live activation for small functions
// ============================================================================
//
// Uses EgSmallContext (~7KB stack) instead of EgContext (~4MB).
// Activates when func.instr_count <= 4: scans for the first mapped IrBinOp,
// builds a tiny e-graph with var nodes for its operands, saturates with
// algebraic rules (add-identity, mul-identity, sub-self), and patches the
// instruction if extraction finds a cheaper form (VAR or CONST).
// Inner helper: perform GUM e-graph rewrite on one binop with uncertainty annotation.
// Returns the simplified source register, or -1 if no simplification applies.
fn ocp_epi_eg_rewrite_inner(ctx: &! EgSmallContext, float_op: i64, s1: i64, s2: i64, unc1: i64, unc2: i64, lhs_observed: bool, rhs_observed: bool) -> i64 with Mut, Div, Panic {
    let lhs  = eg_small_add_var_with_unc(ctx, s1, unc1)
    let rhs  = eg_small_add_var_with_unc(ctx, s2, unc2)
    if lhs_observed { eg_small_mark_observed(ctx, lhs) }
    if rhs_observed { eg_small_mark_observed(ctx, rhs) }
    let root = eg_small_add_binop_with_unc(ctx, float_op, lhs, rhs)
    eg_small_saturate_float(ctx)
    let extracted = eg_small_extract_epistemic(ctx, root)
    if extracted.op == EG_OP_VAR {
        if extracted.value == s1 { return s1 }
        return s2
    }
    return -1
}

// ============================================================================
// Sprint 225: Uncertainty-Guided E-Graph Epistemic Pass
// ============================================================================
//
// Activates for functions with IR_STRATEGY_PRECISION_PRESERVING strategy.
// The pass scans the whole IR body, but each candidate rewrite still builds only
// a tiny local e-graph (2-leaf direct rewrite or bounded 3-leaf chain synthesis).
//
// Algorithm:
//   1. Scan sequentially for epistemic scalar sources:
//      - legacy IrMeasure(dst, value, unc)
//      - canonical Knowledge<T> struct construction from measure():
//        IrAlloc + field_set(value/variance/confidence), where variance = unc*unc
//   2. Propagate recovered uncertainty through field_get(..., "value")
//      so extracted value scalars are marked epistemic
//   3. Compute which registers actually flow to an observation site
//      (return, branch, explicit observe op)
//   4. On observed-path IrBinOp over epistemic scalars, build EgSmallContext with
//      uncertainty-annotated nodes
//   5. eg_small_saturate_float (float associativity, 8 iters)
//   6. eg_small_extract_epistemic (min-uncertainty extraction)
//   7. Patch instruction if extracted node has a different (lower-uncertainty) structure
//
// Scientific novelty: First analytically GUM-guided floating-point rewriting.
// Herbie (Panchekha et al., PLDI 2015) uses empirical sampling; Sounio uses
// GUM §5.1.2 delta-method: u(z)² = u(x)² + u(y)² (exact for additive ops).
// SOTA: JCGM 100:2008 §5.1.2; Willsey et al. egg (2021); Tate et al. (PLDI 2009)
pub(crate) fn ocp_egraph_epistemic_pass(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    ocp_egraph_epistemic_pass_with_algebras(func, ir_empty_algebra_table())
}

fn ocp_lookup_algebra_info(algebras: IrAlgebraTable, algebra_kind: i64) -> IrAlgebraInfo {
    var i: i64 = 0
    while i < algebras.count {
        let info = algebras.entries[i as usize]
        if info.is_valid && info.algebra_tag == algebra_kind {
            return info
        }
        i = i + 1
    }
    ir_empty_algebra_info()
}

// Attempt to infer a homogeneous algebra kind from the IrAlgebraTable when
// func.hyper_algebra_kind is -1 (tag lost or function has no Hyper-typed params/return).
// If the algebra table contains exactly one valid entry, adopt it — the function likely
// operates on that algebra's values even though the type signature didn't carry the tag
// through to lowering (e.g. helper functions that take f64 components directly).
// Returns the inferred algebra kind, or -1 if inference is not possible.
fn ocp_infer_algebra_from_table(algebras: IrAlgebraTable) -> i64 {
    // TODO: mixed algebra intersection — when the table has 2+ entries, compute the
    // intersection of their reassociation rule sets (apply only rules valid for ALL
    // algebras).  For now, only single-algebra programs benefit from body re-inference.
    if algebras.count == 1 && algebras.entries[0].is_valid {
        return algebras.entries[0].algebra_tag
    }
    return -1
}

pub(crate) fn ocp_configure_small_context(ctx: &! EgSmallContext, func: IrFunction, algebras: IrAlgebraTable) with Mut, Div, Panic {
    var algebra_kind = func.hyper_algebra_kind

    // Tag-lost re-inference: if the stamped kind is unknown (-1) but the compilation
    // unit has a single unambiguous algebra declaration, re-infer from the registry.
    // This covers helper functions (e.g. component arithmetic) whose parameter types
    // are plain f64/i64 even though the surrounding module is homogeneously one algebra.
    if algebra_kind < 0 {
        algebra_kind = ocp_infer_algebra_from_table(algebras)
    }

    // Still unknown after re-inference: leave the e-graph at defaults (strategy=0,
    // cd_bits=0 — Real/associative, safe for all algebras that appear in this function).
    if algebra_kind < 0 { return }

    ctx.algebra_kind = algebra_kind
    let info = ocp_lookup_algebra_info(algebras, algebra_kind)
    if info.is_valid {
        ctx.reassoc_strategy = info.reassoc_strategy
        ctx.cd_bits = info.algebra_tag
        return
    }

    // No registry entry: apply conservative defaults derived from algebra kind.
    // Restrictiveness: kind<=2 → free(0); kind==3 → fano_selective(2); kind>=4 → blocked(1).
    ctx.cd_bits = algebra_kind
    if algebra_kind <= 2 {
        ctx.reassoc_strategy = 0
    } else if algebra_kind == 3 {
        ctx.reassoc_strategy = 2  // Octonion: fano_selective via 168 theorem
    } else {
        ctx.reassoc_strategy = 1  // Sedenion/Clifford: blocked (non-associative)
    }
}

fn ocp_egraph_epistemic_pass_with_algebras(func: IrFunction, algebras: IrAlgebraTable) -> IrFunction with Mut, Div, Panic {
    // Guard: only precision-preserving functions (including the A-layer-2 chaotic
    // variant — it still runs the pass, but its EgSmall context is flagged chaotic so
    // eg_small_saturate_float refuses every reassociation). The local EgSmall contexts
    // stay tiny because we only materialize the current observed-path rewrite window.
    if func.compile_strategy != IR_STRATEGY_PRECISION_PRESERVING
        && func.compile_strategy != IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC { return func }
    let observed_regs = ocp_collect_observed_regs(func)
    var def_at: [i64; 256] = [-1; 256]

    // Track canonical measure() lowering:
    //   load_float unc
    //   variance = unc * unc
    //   field_set(k, 1, variance, "variance")
    var literal_float_reg: [bool; 256] = [false; 256]
    var literal_float_val: [f64;  256] = [0.0;   256]
    var squared_unc_reg:   [bool; 256] = [false; 256]
    var squared_unc:       [i64;  256] = [0;     256]

    // Track Knowledge<T> wrapper registers materialized by measure().
    var knowledge_has_value:      [bool; 256] = [false; 256]
    var knowledge_has_variance:   [bool; 256] = [false; 256]
    var knowledge_has_confidence: [bool; 256] = [false; 256]
    var knowledge_reg:            [bool; 256] = [false; 256]
    var knowledge_unc:            [i64;  256] = [0;     256]

    // Epistemic scalar registers participate in arithmetic after value extraction.
    var epi_reg:       [bool; 256] = [false; 256]
    var epi_value_reg: [bool; 256] = [false; 256]
    var epi_unc:       [i64;  256] = [0;     256]

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))

        // Destination registers can be reused; clear all epistemic metadata first.
        if ocp_has_dst(instr.op) && instr.dst >= 0 && instr.dst < 256 {
            literal_float_reg[instr.dst as usize] = false
            literal_float_val[instr.dst as usize] = 0.0
            squared_unc_reg[instr.dst as usize] = false
            squared_unc[instr.dst as usize] = 0
            knowledge_has_value[instr.dst as usize] = false
            knowledge_has_variance[instr.dst as usize] = false
            knowledge_has_confidence[instr.dst as usize] = false
            knowledge_reg[instr.dst as usize] = false
            knowledge_unc[instr.dst as usize] = 0
            epi_reg[instr.dst as usize] = false
            epi_value_reg[instr.dst as usize] = false
            epi_unc[instr.dst as usize] = 0
        }

        // Legacy path: older tests still model epistemic scalars as IrMeasure.
        if ocp_is_measure(instr.op) && instr.dst >= 0 && instr.dst < 256 {
            epi_reg[instr.dst as usize] = true
            epi_unc[instr.dst as usize] = eg_quantize_unc(instr.imm_f64)
        }

        if instr.op == IrOpcode::IrLoadFloat && instr.dst >= 0 && instr.dst < 256 {
            literal_float_reg[instr.dst as usize] = true
            literal_float_val[instr.dst as usize] = instr.imm_f64
        }

        if instr.op == IrOpcode::IrCopy && instr.dst >= 0 && instr.dst < 256 && instr.src1 >= 0 && instr.src1 < 256 {
            if literal_float_reg[instr.src1 as usize] {
                literal_float_reg[instr.dst as usize] = true
                literal_float_val[instr.dst as usize] = literal_float_val[instr.src1 as usize]
            }
            if squared_unc_reg[instr.src1 as usize] {
                squared_unc_reg[instr.dst as usize] = true
                squared_unc[instr.dst as usize] = squared_unc[instr.src1 as usize]
            }
            if knowledge_reg[instr.src1 as usize] {
                knowledge_has_value[instr.dst as usize] = knowledge_has_value[instr.src1 as usize]
                knowledge_has_variance[instr.dst as usize] = knowledge_has_variance[instr.src1 as usize]
                knowledge_has_confidence[instr.dst as usize] = knowledge_has_confidence[instr.src1 as usize]
                knowledge_reg[instr.dst as usize] = true
                knowledge_unc[instr.dst as usize] = knowledge_unc[instr.src1 as usize]
            }
            if epi_reg[instr.src1 as usize] {
                epi_reg[instr.dst as usize] = true
                epi_value_reg[instr.dst as usize] = epi_value_reg[instr.src1 as usize]
                epi_unc[instr.dst as usize] = epi_unc[instr.src1 as usize]
            }
        }

        // Recover "unc" from the canonical variance = unc * unc lowering.
        if instr.op == IrOpcode::IrBinOp && instr.dst >= 0 && instr.dst < 256 {
            if instr.bin_op == BinaryOp::OpMul
                && instr.src1 == instr.src2
                && instr.src1 >= 0 && instr.src1 < 256
                && literal_float_reg[instr.src1 as usize] {
                squared_unc_reg[instr.dst as usize] = true
                squared_unc[instr.dst as usize] = eg_quantize_unc(literal_float_val[instr.src1 as usize])
            }
        }

        if ocp_is_field_set_named(instr, -1, make_name("value")) && instr.src1 >= 0 && instr.src1 < 256 {
            knowledge_has_value[instr.src1 as usize] = true
        }

        if ocp_is_field_set_named(instr, -1, make_name("variance")) && instr.src1 >= 0 && instr.src1 < 256 {
            if instr.src2 >= 0 && instr.src2 < 256 && squared_unc_reg[instr.src2 as usize] {
                knowledge_has_variance[instr.src1 as usize] = true
                knowledge_unc[instr.src1 as usize] = squared_unc[instr.src2 as usize]
            } else {
                knowledge_has_variance[instr.src1 as usize] = false
                knowledge_reg[instr.src1 as usize] = false
                knowledge_unc[instr.src1 as usize] = 0
            }
        }

        if ocp_is_field_set_named(instr, -1, make_name("confidence")) && instr.src1 >= 0 && instr.src1 < 256 {
            knowledge_has_confidence[instr.src1 as usize] = true
        }

        if instr.src1 >= 0 && instr.src1 < 256
            && knowledge_has_value[instr.src1 as usize]
            && knowledge_has_variance[instr.src1 as usize]
            && knowledge_has_confidence[instr.src1 as usize] {
            knowledge_reg[instr.src1 as usize] = true
        }

        // The scalar value extracted from Knowledge<T> is what participates in
        // uncertainty-guided arithmetic. Preserve the wrapper's recovered unc.
        if ocp_is_field_get_named(instr, -1, make_name("value"))
            && instr.dst >= 0 && instr.dst < 256
            && instr.src1 >= 0 && instr.src1 < 256
            && knowledge_reg[instr.src1 as usize] {
            epi_reg[instr.dst as usize] = true
            epi_value_reg[instr.dst as usize] = true
            epi_unc[instr.dst as usize] = knowledge_unc[instr.src1 as usize]
        }

        // Scan for IrBinOp on epistemic scalar registers that actually flow to an
        // observation boundary; build uncertainty-annotated e-graph for those only.
        // Fresh ctx per binop avoids double-mut-borrow in nested scopes.
        if ocp_is_binop(instr.op) {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1_ok = s1 >= 0 && s1 < 256
            let s2_ok = s2 >= 0 && s2 < 256
            let s1_epi = s1_ok && epi_reg[s1 as usize]
            let s2_epi = s2_ok && epi_reg[s2 as usize]
            let dst_observed = instr.dst >= 0 && instr.dst < 256 && observed_regs[instr.dst as usize]
            // At least one operand must be epistemic
            if dst_observed && (s1_epi || s2_epi) {
                let float_op = ocp_binop_to_float_eg_op(instr.bin_op)
                if float_op != EG_OP_CONST {
                    let unc1 = if s1_ok { epi_unc[s1 as usize] } else { 0 }
                    let unc2 = if s2_ok { epi_unc[s2 as usize] } else { 0 }
                    let lhs_observed = s1_ok && epi_value_reg[s1 as usize] && observed_regs[s1 as usize]
                    let rhs_observed = s2_ok && epi_value_reg[s2 as usize] && observed_regs[s2 as usize]
                    let synth_pair = ocp_epi_try_synthesize_observed_chain(func, i, instr, algebras, &def_at, &epi_reg, &epi_value_reg, &epi_unc, &observed_regs)
                    if synth_pair.0 {
                        return synth_pair.1
                    }
                    // Delegate all e-graph ops to inner helper (single &! borrow)
                    var ctx = eg_small_init()
                    ocp_configure_small_context(&! ctx, func, algebras)
                    // PRECISION_PRESERVING opt-in: GUM-guided inexact (f64) reassociation.
                    ctx.allow_inexact_reassoc = true
                    // A-layer-2: chaos gate dominates the opt-in on a `with Chaotic` path.
                    ctx.chaotic = func.compile_strategy == IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC
                    let src = ocp_epi_eg_rewrite_inner(&! ctx, float_op, s1, s2, unc1, unc2, lhs_observed, rhs_observed)
                    if src >= 0 {
                        var result = ir_function_clone(&func)
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, src))
                        return result
                    }
                }
            }
        }
        if ocp_has_dst(instr.op) && instr.dst >= 0 && instr.dst < 256 {
            def_at[instr.dst as usize] = i
        }
        i = i + 1
    }
    func
}

// Inner loop for ocp_egraph_mini_pass; ctx already mutable reference, no re-borrow needed.
fn ocp_eg_mini_pass_loop(ctx: &! EgSmallContext, func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var i: i64 = 0
    while i < func.instr_count {
        let instr  = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if ocp_is_binop(instr.op) {
            let eg_op = ocp_binop_to_eg_op(instr.bin_op)
            if eg_op != EG_OP_CONST {
                let lhs  = eg_small_add_var(ctx, instr.src1)
                let rhs  = eg_small_add_var(ctx, instr.src2)
                let root = eg_small_add_binop(ctx, eg_op, lhs, rhs)
                eg_small_saturate(ctx)
                let extracted = eg_small_extract(ctx, root)
                if extracted.op == EG_OP_VAR {
                    let src = if extracted.value == instr.src1 { instr.src1 } else { instr.src2 }
                    var result = ir_function_clone(&func)
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, src))
                    return result
                }
                if extracted.op == EG_OP_CONST {
                    var result = ir_function_clone(&func)
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, extracted.value))
                    return result
                }
            }
        }
        i = i + 1
    }
    func
}

pub(crate) fn ocp_egraph_mini_pass(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    ocp_egraph_mini_pass_with_algebras(func, ir_empty_algebra_table())
}

fn ocp_egraph_mini_pass_with_algebras(func: IrFunction, algebras: IrAlgebraTable) -> IrFunction with Mut, Div, Panic {
    // Sprint 74: expanded activation from ≤4 to ≤8 instrs (EgSmallContext 64 nodes, still ~7KB)
    if func.instr_count > 8 { return func }
    var ctx = eg_small_init()
    ocp_configure_small_context(&! ctx, func, algebras)
    return ocp_eg_mini_pass_loop(&! ctx, func)
}

// ============================================================================
// Public API
// ============================================================================

struct OptCleanupResult {
    module: IrModule,
    functions_processed: i64,
    instrs_folded: i64,
}

// ============================================================================
// Sprint 87 Block N: IrLoadImm deduplication (LVN constant CSE)
// ============================================================================
// For each IrLoadImm(dst, v), if an earlier register already holds v, replace
// with IrCopy(dst, prior_reg). Reduces register pressure; downstream copy
// propagation in ocp_const_fold eliminates the redundant load.
// SOTA: Cooper & Torczon §8.4 LVN; Click PLDI 1995 §2 value numbering.
fn ocp_dedup_imm(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var seen_const: [bool; 256] = [false; 256]
    var seen_val:   [i64;  256] = [0;     256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            var found: i64 = -1
            var j: i64 = 0
            while j < 256 {
                if seen_const[j as usize] && seen_val[j as usize] == instr.imm_i64 && j != instr.dst {
                    found = j
                    j = 256
                }
                j = j + 1
            }
            if found >= 0 {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, found))
            } else {
                seen_const[instr.dst as usize] = true
                seen_val[instr.dst as usize]   = instr.imm_i64
            }
        }
        i = i + 1
    }
    result
}

// Run dedup_imm → const_fold → egraph (full, deferred) → egraph_mini → CSE → DCE on a single IrFunction.
// ============================================================================
// Pass: Copy propagation (Block Q, Sprint 93)
// ============================================================================

// When r1 = IrCopy(r0), rewrite all subsequent uses of r1 → r0.
// Chains collapse: r1=IrCopy(r0), r2=IrCopy(r1) → r2 references r0.
// After rewriting, the original IrCopy becomes dead and is removed by DCE.
// SOTA: Cytron et al. TOPLAS 1991 §5; Cooper & Torczon §8.5.
pub(crate) fn ocp_copy_prop(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // copy_target[r] = the ultimate source register for r, or -1 if not a copy.
    var copy_target: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))

        // Rewrite src1 through copy chain.
        if instr.src1 >= 0 && instr.src1 < 256 && copy_target[instr.src1 as usize] >= 0 {
            IR_A_SRC1[(ir_region_slot_w(result.region, (i))) as usize] = copy_target[instr.src1 as usize]
        }
        // Rewrite src2 through copy chain.
        if instr.src2 >= 0 && instr.src2 < 256 && copy_target[instr.src2 as usize] >= 0 {
            IR_A_SRC2[(ir_region_slot_w(result.region, (i))) as usize] = copy_target[instr.src2 as usize]
        }

        // Re-read after rewrite.
        let cur = ir_arena_load(ir_region_slot_r(result.region, (i)))

        // Record new copies (chase chains).
        if cur.op == IrOpcode::IrCopy && cur.dst >= 0 && cur.dst < 256 {
            let src = cur.src1
            if src >= 0 && src < 256 && copy_target[src as usize] >= 0 {
                // Chain collapse: r2=IrCopy(r1), r1=IrCopy(r0) → r2 maps to r0.
                copy_target[cur.dst as usize] = copy_target[src as usize]
                IR_A_SRC1[(ir_region_slot_w(result.region, (i))) as usize] = copy_target[src as usize]
            } else {
                copy_target[cur.dst as usize] = src
            }
        } else if cur.dst >= 0 && cur.dst < 256 {
            // Non-copy write to dst: invalidate copy mapping.
            copy_target[cur.dst as usize] = -1
        }

        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 94 Block R: Dead Store Elimination (DSE)
// ============================================================================
//
// Forward scan: track last_write_pos[reg] = instruction index of the most
// recent write to each register.  When a register is read (as src1/src2),
// clear its last_write entry (the store is live).  When a register is written
// again and last_write is still set, the earlier write is a dead store — NOP it.
// Skips side-effecting instructions (calls, stores, branches, labels, returns).
// SOTA: Cooper & Torczon §8.4; Bodik, Gupta & Soffa PLDI 1998.
pub(crate) fn ocp_dse(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // last_write[r] = instruction index of most recent write to r, or -1.
    var last_write: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))

        // Mark src1 as read → its store is live (clear last_write).
        if instr.src1 >= 0 && instr.src1 < 256 {
            last_write[instr.src1 as usize] = -1
        }
        // Mark src2 as read → its store is live.
        if instr.src2 >= 0 && instr.src2 < 256 {
            last_write[instr.src2 as usize] = -1
        }

        // Check if this instruction writes to dst.
        if ocp_has_dst(instr.op) && !ocp_has_side_effect(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                let prev = last_write[instr.dst as usize]
                if prev >= 0 {
                    // Previous write to this reg was never read → dead store.
                    ir_arena_store(ir_region_slot_w(result.region, (prev)), ir_nop())
                }
                last_write[instr.dst as usize] = i
            }
        }

        // Labels and branches break basic blocks — conservatively clear all.
        if instr.op == IrOpcode::IrLabel || instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrBranchTrue || instr.op == IrOpcode::IrBranchFalse {
            var k: i64 = 0
            while k < 256 {
                last_write[k as usize] = -1
                k = k + 1
            }
        }

        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 97 Block U: Redundant jump elimination
// ============================================================================
//
// When IrJump(L) is immediately followed by IrLabel(L), the jump is a no-op.
// Also handles IrBranchTrue/False(cond, L) followed by IrLabel(L) — the branch
// is redundant regardless of condition (it either falls through or jumps to
// the very next instruction).
// SOTA: Muchnick §13.1 (peephole optimization); Cooper & Torczon §8.7.
pub(crate) fn ocp_redundant_jump(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var i: i64 = 0
    while i < result.instr_count - 1 {
        let cur = ir_arena_load(ir_region_slot_r(result.region, (i)))
        let next = ir_arena_load(ir_region_slot_r(result.region, ((i + 1))))
        if next.op == IrOpcode::IrLabel {
            let target_label = next.label_id
            // IrJump(L) followed by IrLabel(L) → NOP
            if cur.op == IrOpcode::IrJump && cur.label_id == target_label {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
            }
            // IrBranchTrue(cond, L) followed by IrLabel(L) → NOP (falls through either way)
            if cur.op == IrOpcode::IrBranchTrue && cur.label_id == target_label {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
            }
            // IrBranchFalse(cond, L) followed by IrLabel(L) → NOP
            if cur.op == IrOpcode::IrBranchFalse && cur.label_id == target_label {
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
            }
        }
        i = i + 1
    }
    result
}

// Sprint 98 Block V: Unreachable code elimination
// ============================================================================
//
// After an unconditional IrJump or IrReturn, any code before the next IrLabel
// is unreachable.  NOP it out so DCE can reclaim the dead registers.
// SOTA: Muchnick §7.2 (unreachable code elimination); Cooper & Torczon §10.1.
pub(crate) fn ocp_dead_after_jump(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var dead = false
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLabel {
            dead = false
        }
        if dead && instr.op != IrOpcode::IrLabel {
            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
        }
        if instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrReturn {
            dead = true
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 99 Block W: Unreachable label elimination
// ============================================================================
//
// Scan all jump/branch instructions to build a set of referenced labels.
// Then NOP any IrLabel whose label_id is not in the set.  This enables
// ocp_dead_after_jump to see through removed labels on a subsequent pass.
// SOTA: Muchnick §7.3 (dead label elimination); Appel §8.1.
pub(crate) fn ocp_dead_label(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // Pass 1: collect referenced label_ids (max 256 labels).
    var referenced: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrBranchTrue || instr.op == IrOpcode::IrBranchFalse {
            if instr.label_id >= 0 && instr.label_id < 256 {
                referenced[instr.label_id as usize] = true
            }
        }
        i = i + 1
    }
    // Pass 2: NOP unreferenced labels.
    i = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLabel {
            if instr.label_id >= 0 && instr.label_id < 256 {
                if !referenced[instr.label_id as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_nop())
                }
            }
        }
        i = i + 1
    }
    result
}


// ============================================================================
// Sprint 102 Block Z: Non-pow-2 multiply strength reduction (x*3)
// ============================================================================
// x * 3 → (x + x) + x using two ADD instructions instead of MUL.
// Only handles constant 3; pow-2 cases handled by existing strength reduction.
// Two-pass: build constant lattice, then rewrite x*3 patterns.
// SOTA: LLVM InstCombine; Cooper & Torczon §8.4.
pub(crate) fn ocp_mul3_sr(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // Pass 1: build constant lattice
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var def_at: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            is_const[instr.dst as usize] = true
            const_val[instr.dst as usize] = instr.imm_i64
            def_at[instr.dst as usize] = i
        }
        i = i + 1
    }
    // Pass 2: rewrite x * 3 patterns
    i = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrBinOp && instr.bin_op == BinaryOp::OpMul {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1_k = s1 >= 0 && s1 < 256 && is_const[s1 as usize]
            let s2_k = s2 >= 0 && s2 < 256 && is_const[s2 as usize]
            // Skip if both const — const_fold handles that
            if s1_k && s2_k {
                i = i + 1
                continue
            }
            // x * 3: s2 is const 3, s1 is variable
            if s2_k && const_val[s2 as usize] == 3 && !s1_k {
                // Rewrite IrLoadImm(rC, 3) → IrBinOp(rC, s1, OpAdd, s1)
                let c_def = def_at[s2 as usize]
                if c_def >= 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (c_def)), ir_binop(s2, s1, BinaryOp::OpAdd, s1))
                    is_const[s2 as usize] = false
                }
                // Rewrite mul → IrBinOp(dst, rC, OpAdd, s1)
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, s2, BinaryOp::OpAdd, s1))
            }
            // 3 * x: s1 is const 3, s2 is variable
            if s1_k && const_val[s1 as usize] == 3 && !s2_k {
                let c_def = def_at[s1 as usize]
                if c_def >= 0 {
                    ir_arena_store(ir_region_slot_w(result.region, (c_def)), ir_binop(s1, s2, BinaryOp::OpAdd, s2))
                    is_const[s1 as usize] = false
                }
                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, s1, BinaryOp::OpAdd, s2))
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 103 Block AA: Loop-Invariant Code Motion (LICM)
// ============================================================================
// Detects back-edges (IrJump to earlier label) and hoists IrLoadImm
// instructions whose dst is not written elsewhere in the loop body.
// Only hoists IrLoadImm (safe: no side effects, no data dependencies).
// SOTA: Muchnick §13.2; Cooper & Torczon §10.3.
pub(crate) fn ocp_licm(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // Pass 1: record label positions
    var label_pos: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLabel && instr.label_id >= 0 && instr.label_id < 256 {
            label_pos[instr.label_id as usize] = i
        }
        i = i + 1
    }
    // Pass 2: detect back-edges and hoist
    i = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrJump && instr.label_id >= 0 && instr.label_id < 256 {
            let lp = label_pos[instr.label_id as usize]
            if lp >= 0 && lp < i {
                // Back-edge: loop from lp to i
                // Scan loop body for hoistable IrLoadImm
                var j: i64 = lp + 1
                while j < i {
                    let li = ir_arena_load(ir_region_slot_r(result.region, (j)))
                    if li.op == IrOpcode::IrLoadImm && li.dst >= 0 && li.dst < 256 {
                        // Check dst not written elsewhere in loop
                        var written_elsewhere: bool = false
                        var k: i64 = lp + 1
                        while k < i {
                            if k != j {
                                let ki = ir_arena_load(ir_region_slot_r(result.region, (k)))
                                if ki.dst == li.dst && ki.op != IrOpcode::IrNop {
                                    written_elsewhere = true
                                    k = i  // break
                                }
                            }
                            k = k + 1
                        }
                        if !written_elsewhere {
                            // Hoist: swap with loop header position
                            // Place the IrLoadImm just before the label
                            if lp > 0 {
                                // A pure exchange of slots j and lp-1. Written as
                                // two stores the second would take its arguments
                                // from a slot the first already overwrote.
                                ir_arena_swap_slots(ir_region_slot_w(result.region, ((lp - 1))), ir_region_slot_w(result.region, (j)))
                                j = i  // break after first hoist per loop
                            }
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 104 Block AB: Global Value Numbering (GVN)
// ============================================================================
// Assigns value numbers to registers; IrBinOp with matching VN pair
// is replaced with IrCopy of the first occurrence.
// Hash table: 128 entries, linear probe, key = op*10000 + vn1*100 + vn2.
// Labels invalidate the entire table (conservative).
// SOTA: Click PLDI 1995 §2; Cooper & Torczon §8.4.
pub(crate) fn ocp_gvn(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var vn: [i64; 256] = [-1; 256]
    var next_vn: i64 = 0
    // Hash table
    var ht_key:  [i64; 128] = [-1; 128]
    var ht_vn:   [i64; 128] = [-1; 128]
    var ht_reg:  [i64; 128] = [-1; 128]
    var ht_used: [bool; 128] = [false; 128]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        // IrLoadImm: fresh VN
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            vn[instr.dst as usize] = next_vn
            next_vn = next_vn + 1
        }
        // IrCopy: inherit VN from src
        if instr.op == IrOpcode::IrCopy && instr.dst >= 0 && instr.dst < 256 {
            if instr.src1 >= 0 && instr.src1 < 256 && vn[instr.src1 as usize] >= 0 {
                vn[instr.dst as usize] = vn[instr.src1 as usize]
            } else {
                vn[instr.dst as usize] = next_vn
                next_vn = next_vn + 1
            }
        }
        // IrLabel: invalidate hash table (conservative at control flow merge)
        if instr.op == IrOpcode::IrLabel {
            var ci: i64 = 0
            while ci < 128 {
                ht_used[ci as usize] = false
                ht_key[ci as usize] = -1
                ci = ci + 1
            }
        }
        // IrBinOp: compute hash, look up, replace or insert
        if instr.op == IrOpcode::IrBinOp && instr.dst >= 0 && instr.dst < 256 {
            let s1 = instr.src1
            let s2 = instr.src2
            if s1 >= 0 && s1 < 256 && s2 >= 0 && s2 < 256 {
                let vn1 = vn[s1 as usize]
                let vn2 = vn[s2 as usize]
                if vn1 >= 0 && vn2 >= 0 {
                    let op_val = ocp_binop_to_cse_key(instr.bin_op)
                    let key = op_val * 10000 + vn1 * 100 + vn2
                    var hash = key % 128
                    if hash < 0 { hash = 0 - hash }
                    // Linear probe lookup
                    var found: bool = false
                    var found_reg: i64 = -1
                    var probe: i64 = 0
                    while probe < 8 {
                        let idx = (hash + probe) % 128
                        if !ht_used[idx as usize] {
                            probe = 8  // break: empty slot, not found
                        } else {
                            if ht_key[idx as usize] == key {
                                found = true
                                found_reg = ht_reg[idx as usize]
                                probe = 8  // break
                            }
                        }
                        probe = probe + 1
                    }
                    if found && found_reg >= 0 {
                        // Replace with IrCopy
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, found_reg))
                        vn[instr.dst as usize] = vn[found_reg as usize]
                    } else {
                        // Insert into hash table
                        vn[instr.dst as usize] = next_vn
                        next_vn = next_vn + 1
                        var slot: i64 = hash
                        var sp: i64 = 0
                        while sp < 8 {
                            let idx = (slot + sp) % 128
                            if !ht_used[idx as usize] {
                                ht_used[idx as usize] = true
                                ht_key[idx as usize] = key
                                ht_vn[idx as usize] = vn[instr.dst as usize]
                                ht_reg[idx as usize] = instr.dst
                                sp = 8  // break
                            }
                            sp = sp + 1
                        }
                    }
                } else {
                    // Unknown VN for operands — assign fresh
                    vn[instr.dst as usize] = next_vn
                    next_vn = next_vn + 1
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 105 Block AC: Instruction scheduling — load sinking
// ============================================================================
// Bubble-sort adjacent swaps: IrLoadImm sinks past independent instructions
// to reduce register pressure (closer to use). Up to 4 passes.
// Only swaps if next instruction doesn't use/write dst, isn't control flow.
// SOTA: Hennessy & Patterson §A.2; Muchnick §17.
pub(crate) fn ocp_sink_loads(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var pass: i64 = 0
    while pass < 4 {
        var swapped: bool = false
        var i: i64 = 0
        while i < result.instr_count - 1 {
            let cur = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let nxt = ir_arena_load(ir_region_slot_r(result.region, ((i + 1))))
            if cur.op == IrOpcode::IrLoadImm && nxt.op != IrOpcode::IrLoadImm
                    && nxt.op != IrOpcode::IrNop && nxt.op != IrOpcode::IrLabel
                    && nxt.op != IrOpcode::IrJump && nxt.op != IrOpcode::IrBranchTrue
                    && nxt.op != IrOpcode::IrBranchFalse && nxt.op != IrOpcode::IrReturn
                    && nxt.op != IrOpcode::IrCall {
                // Check next doesn't use our dst
                let d = cur.dst
                if nxt.src1 != d && nxt.src2 != d && nxt.dst != d {
                    // Swap -- as one exchange, so the arguments travel with the
                    // instructions instead of being read from an overwritten slot.
                    ir_arena_swap_slots(ir_region_slot_w(result.region, (i)), ir_region_slot_w(result.region, ((i + 1))))
                    swapped = true
                }
            }
            i = i + 1
        }
        if !swapped {
            pass = 4  // break
        }
        pass = pass + 1
    }
    result
}

// ============================================================================
// Sprint 106 Block AD: Jump-to-return folding
// ============================================================================
// IrJump(L) where IrLabel(L) is immediately followed by IrReturn(v) →
// replace the IrJump with IrReturn(v). Eliminates one branch per tail return.
// Only unconditional jumps; conditional branches excluded.
// SOTA: Muchnick §13.1 (branch optimization); Cooper & Torczon §8.7.
pub(crate) fn ocp_jump_to_return(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    // Pass 1: find label positions
    var label_pos: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrLabel && instr.label_id >= 0 && instr.label_id < 256 {
            label_pos[instr.label_id as usize] = i
        }
        i = i + 1
    }
    // Pass 2: fold IrJump(L) where L+1 is IrReturn
    i = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        if instr.op == IrOpcode::IrJump && instr.label_id >= 0 && instr.label_id < 256 {
            let lp = label_pos[instr.label_id as usize]
            if lp >= 0 && lp + 1 < result.instr_count {
                let next = ir_arena_load(ir_region_slot_r(result.region, ((lp + 1))))
                if next.op == IrOpcode::IrReturn {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_return(next.src1))
                }
            }
        }
        i = i + 1
    }
    result
}

pub(crate) fn opt_cleanup_function(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    opt_cleanup_function_with_algebras(func, ir_empty_algebra_table())
}

fn opt_cleanup_function_with_algebras(func: IrFunction, algebras: IrAlgebraTable) -> IrFunction with Mut, Div, Panic {
    var audit = ocp_empty_exact_bitwise_rebracket_pass_audit()
    opt_cleanup_function_with_algebras_and_audit(func, algebras, &! audit)
}

fn opt_cleanup_function_with_algebras_and_audit(
    func: IrFunction,
    algebras: IrAlgebraTable,
    exact_bitwise_audit: &! OcpExactBitwiseRebracketPassAudit,
) -> IrFunction with Mut, Div, Panic {
    var current = ocp_dedup_imm(func)
    current = ocp_const_fold_with_audit(current, exact_bitwise_audit)
    current = ocp_mul3_sr(current)            // Sprint 102 Block Z: non-pow-2 multiply SR
    current = ocp_egraph_pass(current)        // full e-graph: deferred (always skips guard)
    current = ocp_egraph_mini_pass_with_algebras(current, algebras)   // mini e-graph: activates for instr_count <= 8
    current = ocp_egraph_epistemic_pass_with_algebras(current, algebras) // Sprint 225: GUM-guided float rewriting
    current = ocp_cse(current)                // CSE: always active
    current = ocp_gvn(current)                // Sprint 104 Block AB: global value numbering
    current = ocp_copy_prop(current)          // Sprint 93 Block Q: copy chain collapse
    current = ocp_dse(current)                // Sprint 94 Block R: dead store elimination
    current = ocp_redundant_jump(current)     // Sprint 97 Block U: redundant jump elimination
    current = ocp_jump_to_return(current)     // Sprint 106 Block AD: jump-to-return folding
    current = ocp_dead_after_jump(current)    // Sprint 98 Block V: unreachable code elimination
    current = ocp_dead_label(current)         // Sprint 99 Block W: unreachable label elimination
    current = ocp_licm(current)              // Sprint 103 Block AA: LICM
    current = ocp_sink_loads(current)         // Sprint 105 Block AC: load sinking
    var iter: i64 = 0
    while iter < 8 {
        let swept = ocp_dce_once(current)
        current = swept.0
        if swept.1 == 0 {
            // Sprint 78: SCCP final pass (Wegman & Zadeck TOPLAS 1991)
            current = cp_optimize_function(current)
            return ocp_compact_nops(current)  // Sprint 100 Block X
        }
        iter = iter + 1
    }
    // Sprint 78: SCCP final pass (Wegman & Zadeck TOPLAS 1991)
    current = cp_optimize_function(current)
    current = ocp_compact_nops(current)       // Sprint 100 Block X: NOP compaction
    current
}

// ============================================================================
// Sprint 100 Block X: NOP compaction
// ============================================================================
//
// Compact the instruction array by removing IrNop instructions.
// Copies non-NOP instructions to the front of the array, preserving order.
// Label references (label_id) are symbolic, not positional, so no remapping.
// Reduces instr_count, improving downstream codegen and pass performance.
// SOTA: standard peephole post-pass; Muchnick §13.1.
pub(crate) fn ocp_compact_nops(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var write: i64 = 0
    var read: i64 = 0
    while read < result.instr_count {
        // Same marker rule as ocp_mfi_compact_nops: a nop carrying
        // IR_FLOAT_REG_MARKER_FLAG tells codegen a register holds f64, and
        // deleting it makes that register read as an integer. This spine is
        // self-test/probe only today, but a self-test that exercises the wrong
        // behaviour is a trap, and the bug returns the moment anyone wires it
        // back into -O.
        let marker = IR_A_IMM_FLAGS[(ir_region_slot_r(result.region, (read))) as usize]
        if (IR_A_OP[(ir_region_slot_r(result.region, (read))) as usize] as IrOpcode) != IrOpcode::IrNop
            || marker == IR_FLOAT_REG_MARKER_FLAG {
            if write != read {
                ir_arena_copy_slot(ir_region_slot_w(result.region, (write)),ir_region_slot_r(result.region, (read)))
            }
            write = write + 1
        }
        read = read + 1
    }
    // Fill remaining slots with NOPs (clean tail).
    var fill: i64 = write
    while fill < result.instr_count {
        ir_arena_store(ir_region_slot_w(result.region, (fill)), ir_nop())
        fill = fill + 1
    }
    result.instr_count = write
    result
}

// ============================================================================
// Multi-module -O cleanup: module-index (mfi) field-wise peels
// ============================================================================
//
// Measured root causes for multi-module -O SEGV after lower_done (2026-07-20):
// 1. By-value `IrFunction` copies scramble live `IrInstr.call_args: Option<Box<…>>`
//    (A8 / A14 family — Box-carrying large-struct copy under lean_single).
// 2. Taking `&! ir_fn_get(&(*module), fi)` (exclusive ref to an array element of
//    `[IrFunction; 2048]`) is miscompiled: field reads through that ref return
//    garbage (instr_count ~1e13) and the pass loop SEGVs.
//
// Therefore the multi-module -O entry mutates ONLY via
//   `ir_fn_get(&(*module), fi as usize).field…`
// and never forms an intermediate `&! IrFunction` to a module array slot, never
// copies a whole `IrFunction` or a whole `IrInstr` with live call_args.
//
// Pass set (Wave9 full peels): constructor writebacks
// (`ir_nop` / `ir_copy` / `ir_load_imm` / `ir_return` / `ir_jump` / `ir_binop`)
// and scalar field stores (`.src1` / `.src2` / compact field-wise moves).
// Full e-graph / mul3_sr / LICM / epistemic rewrites stay on the by-value
// stack-local path used by main.sio self-tests. Const-fold / SCCP-lite /
// compact_nops are now field-wise (never by-value IrFunction).

// Dedup IrLoadImm → IrCopy when an earlier reg already holds the same imm.
fn ocp_mfi_dedup_imm(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var seen_const: [bool; 256] = [false; 256]
    var seen_val: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let imm = IR_A_IMM_I64[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // #1667: this is a LINEAR scan, so state carried across a block
        // boundary is carried between basic blocks, where it does not hold. A
        // value established in one arm of an if/else was reaching the other arm
        // and the join. Kill the table at a label (a join: incoming values are
        // unknown) and after a terminator (the next instruction is another
        // block). Conservative, not a CFG -- but sound, which it was not.
        if op == IrOpcode::IrLabel {
            var bb: i64 = 0
            while bb < 256 { seen_const[bb as usize] = false  bb = bb + 1 }
        }
        // #1667 killed the table at block boundaries but never invalidated a
        // single register. Any instruction that WRITES a tracked register makes
        // its recorded immediate stale, and the next matching IrLoadImm was
        // rewritten as a copy of it:
        //     var a = 5      // seen[ra] = 5
        //     a = a + 1      // ra is now 6, seen[ra] still says 5
        //     var b = 5      // became copy(rb, ra) -> b == 6
        // Five lines of ordinary code returning the wrong number. ocp_mfi_cse
        // invalidates on every write for this reason; this peel did not.
        // The written range, not just its base: a wide write changes every limb
        // it covers, and a record on limb k survived it.
        if ocp_has_dst(op) && dst >= 0 && dst < 256 {
            let dspan = ocp_dst_limb_count(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i)))
            var dk: i64 = 0
            while dk < dspan {
                if dst + dk < 256 { seen_const[(dst + dk) as usize] = false }
                dk = dk + 1
            }
        }
        if op == IrOpcode::IrLoadImm && dst >= 0 && dst < 256 {
            var found: i64 = 0 - 1
            var j: i64 = 0
            while j < 256 {
                if seen_const[j as usize] && seen_val[j as usize] == imm && j != dst {
                    found = j
                    j = 256
                }
                j = j + 1
            }
            if found >= 0 {
                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, found))
            } else {
                seen_const[dst as usize] = true
                seen_val[dst as usize] = imm
            }
        }
        if op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue
            || op == IrOpcode::IrBranchFalse || op == IrOpcode::IrReturn {
            var bb: i64 = 0
            while bb < 256 { seen_const[bb as usize] = false  bb = bb + 1 }
        }
        i = i + 1
    }
}

// Copy-prop: rewrite src1/src2 through IrCopy chains; scalar field stores only.
fn ocp_mfi_copy_prop(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var copy_target: [i64; 256] = [-1; 256]
    // Guard for the invalidation below: true when some entry's VALUE is this
    // register. Without it the scan runs on every instruction with a dst, the
    // common case; with it, only where a mapping could actually be stale.
    var copy_is_source: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let here = ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))
        let here_op = (IR_A_OP[here as usize] as IrOpcode)
        // A wide operand is a RANGE of consecutive registers and this table maps
        // single registers. Substituting the base of a wide read would point it
        // at a register whose FOLLOWING limbs are unrelated, so wide reads are
        // left alone -- the copy is still correct, it is only not propagated.
        let wide_here = ocp_is_wide_limb_op(here_op)
        let s1 = IR_A_SRC1[here as usize]
        if !wide_here && s1 >= 0 && s1 < 256 && copy_target[s1 as usize] >= 0 {
            IR_A_SRC1[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] = copy_target[s1 as usize]
        }
        let s2 = IR_A_SRC2[here as usize]
        // src2 is not always a register: on IrWideShr and IrWideShrLimb it is a
        // shift amount. Rewriting it substitutes a register number for a shift
        // count, and small shift counts collide with low register numbers.
        if !wide_here && ocp_src2_is_register(here_op) && s2 >= 0 && s2 < 256 && copy_target[s2 as usize] >= 0 {
            IR_A_SRC2[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] = copy_target[s2 as usize]
        }
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        // #1667: this is a LINEAR scan, so state carried across a block
        // boundary is carried between basic blocks, where it does not hold. A
        // value established in one arm of an if/else was reaching the other arm
        // and the join. Kill the table at a label (a join: incoming values are
        // unknown) and after a terminator (the next instruction is another
        // block). Conservative, not a CFG -- but sound, which it was not.
        if op == IrOpcode::IrLabel {
            var bb: i64 = 0
            while bb < 256 { copy_target[bb as usize] = 0 - 1  bb = bb + 1 }
        }
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let cur_s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // A write to `dst` invalidates the entry whose KEY is `dst` (below) and
        // also every entry whose VALUE is `dst` -- those record "read this
        // register instead", which stops being true the moment it is written.
        // Only the key was cleared, so a swap through a temporary miscompiled:
        //     tv = v0        copy_target[tv] = v0
        //     v0 = v1        clears copy_target[v0] -- not the entry tv -> v0
        //     v1 = tv        the read of tv is rewritten to v0, already changed
        // leaving v0 and v1 both holding the new value. This runs BEFORE the
        // record below, because that record's own dst is a write as well.
        // `dst >= 256` also scans: the else branch below stores an unchecked
        // cur_s1, so an entry's VALUE can name a register outside the tracked
        // window, and a write to that register must still invalidate it. The
        // guard array cannot be indexed there, so those writes always scan --
        // rare, and over-invalidating is sound where under-invalidating is not.
        // A wide definition writes its whole range, so every limb of it
        // invalidates records -- both those KEYED on the limb and those whose
        // VALUE is the limb. Handling only the base left records alive across a
        // write that had in fact changed the register they name.
        let write_span = ocp_dst_limb_count(here)
        var wk: i64 = 0
        while wk < write_span {
            let wreg = dst + wk
            if ocp_has_dst(op) && dst >= 0 && (wreg >= 256 || copy_is_source[wreg as usize]) {
                var q: i64 = 0
                while q < 256 {
                    if copy_target[q as usize] == wreg { copy_target[q as usize] = 0 - 1 }
                    q = q + 1
                }
                if wreg < 256 { copy_is_source[wreg as usize] = false }
            }
            if ocp_has_dst(op) && dst >= 0 && wk > 0 && wreg < 256 {
                copy_target[wreg as usize] = 0 - 1
            }
            wk = wk + 1
        }
        if op == IrOpcode::IrCopy && dst >= 0 && dst < 256 {
            if cur_s1 >= 0 && cur_s1 < 256 && copy_target[cur_s1 as usize] >= 0 {
                copy_target[dst as usize] = copy_target[cur_s1 as usize]
                // Both guard writes are range-checked: copy_target holds a
                // register number that was never bounded above (the else branch
                // stores an unchecked cur_s1), so indexing the guard with it
                // unchecked walks off the array -- it segfaulted the compiler
                // on the first build. A register outside the tracked window is
                // simply not guarded; the invalidation scan below is likewise
                // limited to dst < 256, so nothing new is missed.
                if copy_target[cur_s1 as usize] < 256 {
                    copy_is_source[copy_target[cur_s1 as usize] as usize] = true
                }
                IR_A_SRC1[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] = copy_target[cur_s1 as usize]
            } else {
                copy_target[dst as usize] = cur_s1
                if cur_s1 >= 0 && cur_s1 < 256 { copy_is_source[cur_s1 as usize] = true }
            }
        } else if dst >= 0 && dst < 256 {
            copy_target[dst as usize] = 0 - 1
        }
        if op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue
            || op == IrOpcode::IrBranchFalse || op == IrOpcode::IrReturn {
            var bb: i64 = 0
            while bb < 256 { copy_target[bb as usize] = 0 - 1  bb = bb + 1 }
        }
        i = i + 1
    }
}

// Dead-store elimination: NOP earlier write if never read before next write.
fn ocp_mfi_dse(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var last_write: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let s2 = IR_A_SRC2[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // A wide READ consumes every limb, so every pending write under that
        // range is live. Clearing only the base left a write to limb k killable
        // by a later store, after this instruction had already read it.
        let at_i = ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))
        let rspan = ocp_limb_count(at_i)
        let s2_span = if ocp_src2_is_register(op) { rspan } else { 1 }
        var rk: i64 = 0
        while rk < rspan {
            if s1 >= 0 && s1 + rk < 256 { last_write[(s1 + rk) as usize] = 0 - 1 }
            rk = rk + 1
        }
        rk = 0
        while rk < s2_span {
            if s2 >= 0 && s2 + rk < 256 { last_write[(s2 + rk) as usize] = 0 - 1 }
            rk = rk + 1
        }
        if ocp_has_dst(op) && !ocp_has_side_effect(op) {
            if dst >= 0 && dst < 256 {
                let wspan = ocp_dst_limb_count(at_i)
                let prev = last_write[dst as usize]
                // Neither side may be wide. NOPing a wide instruction because
                // its BASE was overwritten would delete the definitions of its
                // other limbs with it, and a wide write is not a full overwrite
                // of anything a scalar write recorded.
                if prev >= 0 && wspan == 1 {
                    let at_prev = ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (prev))
                    if ocp_dst_limb_count(at_prev) == 1 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (prev)), ir_nop())
                    }
                }
                // Limbs above the base are written here too, but recording them
                // as removable would let a later write to one of them NOP an
                // instruction that also defines the others.
                if wspan == 1 {
                    last_write[dst as usize] = i
                } else {
                    var wk: i64 = 0
                    while wk < wspan {
                        if dst + wk < 256 { last_write[(dst + wk) as usize] = 0 - 1 }
                        wk = wk + 1
                    }
                }
            }
        }
        // A call READS its arguments from instr.call_args, a Box list this pass
        // does not walk (see the note on ocp_mfi_dce_once). Those reads are
        // invisible to the SRC1/SRC2 scan above, so a store whose only consumer
        // is a call argument looked dead and was NOPed -- `x = f(x, a); x = f(x, b)`
        // lost the first assignment, every call then read the pre-loop x, and only
        // the last write survived. Treating a call as a barrier restores
        // correctness without walking the Box.
        if op == IrOpcode::IrLabel || op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue || op == IrOpcode::IrBranchFalse || op == IrOpcode::IrCall || op == IrOpcode::IrCallSret {
            var k: i64 = 0
            while k < 256 {
                last_write[k as usize] = 0 - 1
                k = k + 1
            }
        }
        i = i + 1
    }
}

// Jump/branch immediately followed by its target label → NOP.
fn ocp_mfi_redundant_jump(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i + 1 < ir_fn_get(&(*module), fi as usize).instr_count {
        let cur_op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let cur_lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let next_op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, ((i + 1)))) as usize] as IrOpcode)
        let next_lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, ((i + 1)))) as usize]
        if next_op == IrOpcode::IrLabel {
            if cur_op == IrOpcode::IrJump && cur_lab == next_lab {
                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
            }
            if cur_op == IrOpcode::IrBranchTrue && cur_lab == next_lab {
                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
            }
            if cur_op == IrOpcode::IrBranchFalse && cur_lab == next_lab {
                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
            }
        }
        i = i + 1
    }
}

// IrJump to a block whose first non-NOP is IrReturn → fold to IrReturn.
fn ocp_mfi_jump_to_return(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        if op == IrOpcode::IrJump {
            var j: i64 = 0
            while j < ir_fn_get(&(*module), fi as usize).instr_count {
                let jop = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (j))) as usize] as IrOpcode)
                let jlab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (j))) as usize]
                if jop == IrOpcode::IrLabel && jlab == lab {
                    var k = j + 1
                    while k < ir_fn_get(&(*module), fi as usize).instr_count {
                        let kop = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (k))) as usize] as IrOpcode)
                        if kop == IrOpcode::IrNop {
                            k = k + 1
                        } else {
                            if kop == IrOpcode::IrReturn {
                                let rsrc = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (k))) as usize]
                                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_return(rsrc))
                            }
                            k = ir_fn_get(&(*module), fi as usize).instr_count
                        }
                    }
                    j = ir_fn_get(&(*module), fi as usize).instr_count
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// Code after unconditional jump until next label is unreachable → NOP.
fn ocp_mfi_dead_after_jump(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        if op == IrOpcode::IrJump || op == IrOpcode::IrReturn {
            var j = i + 1
            while j < ir_fn_get(&(*module), fi as usize).instr_count {
                let jop = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (j))) as usize] as IrOpcode)
                if jop == IrOpcode::IrLabel {
                    j = ir_fn_get(&(*module), fi as usize).instr_count
                } else {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (j)), ir_nop())
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
}

// Labels never targeted by jump/branch → NOP (keeps fall-through semantics).
fn ocp_mfi_dead_label(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var targeted: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        if op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue || op == IrOpcode::IrBranchFalse {
            if lab >= 0 && lab < 256 {
                targeted[lab as usize] = true
            }
        }
        i = i + 1
    }
    i = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        if op == IrOpcode::IrLabel && lab >= 0 && lab < 256 {
            if !targeted[lab as usize] {
                ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
            }
        }
        i = i + 1
    }
}

// CSE for mapped binops → IrCopy (constructor writeback; no IrInstr copy).
fn ocp_mfi_cse(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var cse_op: [i64; 128] = [0; 128]
    var cse_src1: [i64; 128] = [0; 128]
    var cse_src2: [i64; 128] = [0; 128]
    var cse_dst: [i64; 128] = [0; 128]
    var cse_len: i64 = 0
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let bin = (IR_A_BIN_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as BinaryOp)
        let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        let s2 = IR_A_SRC2[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // Every limb of a wide write invalidates: an expression recorded over
        // limb k stops holding when the wide instruction overwrites it. Wide
        // ops are not IrBinOp so they are never RECORDED here, but they do
        // write registers that recorded expressions name.
        if ocp_has_dst(op) && dst >= 0 {
            let ispan = ocp_dst_limb_count(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i)))
            var ik: i64 = 0
            while ik < ispan {
                let invalidated = ocp_cse_invalidate_reg(cse_op, cse_src1, cse_src2, cse_dst, cse_len, dst + ik)
                cse_op = invalidated.op
                cse_src1 = invalidated.src1
                cse_src2 = invalidated.src2
                cse_dst = invalidated.dst
                cse_len = invalidated.len
                ik = ik + 1
            }
        }
        if ocp_is_binop(op) {
            let op_key = ocp_binop_to_cse_key(bin)
            if op_key != 0 {
                var cse_s1 = s1
                var cse_s2 = s2
                if ocp_is_commutative_op(bin) && cse_s1 > cse_s2 {
                    let tmp = cse_s1
                    cse_s1 = cse_s2
                    cse_s2 = tmp
                }
                var j: i64 = 0
                var found: i64 = 0 - 1
                while j < cse_len {
                    if cse_op[j as usize] == op_key && cse_src1[j as usize] == cse_s1 && cse_src2[j as usize] == cse_s2 {
                        found = j
                        j = cse_len
                    }
                    j = j + 1
                }
                if found >= 0 {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, cse_dst[found as usize]))
                } else {
                    if cse_len < 128 {
                        cse_op[cse_len as usize] = op_key
                        cse_src1[cse_len as usize] = cse_s1
                        cse_src2[cse_len as usize] = cse_s2
                        cse_dst[cse_len as usize] = dst
                        cse_len = cse_len + 1
                    }
                }
            }
        }
        // A matched entry is substitutable only where the instruction that
        // produced it DOMINATES the use. This peel has no dominance
        // information, so its table must not cross a basic-block boundary:
        //   if a { return f(e) }
        //   if b { return f(e) + k }
        // had the second occurrence rewritten as a copy of the first, whose
        // register is never written when the first branch is not taken. The
        // value read was whatever the preceding call left there -- measured as
        // atan(1.0) after a sqrt(1.0), giving pi + 0.791495 instead of pi.
        //
        // ocp_mfi_dse resets on the same opcodes for the same reason. Dropping
        // the table at control flow makes this block-local, which is what a
        // peel without dominance analysis can honestly claim.
        if op == IrOpcode::IrLabel || op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue || op == IrOpcode::IrBranchFalse {
            cse_len = 0
        }
        i = i + 1
    }
}

// One DCE sweep: NOP pure defs whose dst is never used as src1/src2.
// Note: does not walk call_args lists (would require Box walk). Side-effecting
// ops (calls) are never removed — call_args Boxes stay in place.
fn ocp_mfi_dce_once(module: &! IrModule, fi: i64) -> i64 with Mut, Div, Panic {
    var used: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let at = ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))
        let s1 = IR_A_SRC1[at as usize]
        let s2 = IR_A_SRC2[at as usize]
        // A wide operand is a RANGE of consecutive registers, not one. Marking
        // only the base left limbs 1..n-1 looking unused, and their defining
        // instructions were NOPed -- the wrong answer under -O with no runtime
        // signal. src2 is spanned only where it is a register: on the shift ops
        // it is a shift amount, and marking a span there would be marking
        // arithmetic on a number that is not a register at all.
        let span = ocp_limb_count(at)
        let s2_span = if ocp_src2_is_register((IR_A_OP[at as usize] as IrOpcode)) { span } else { 1 }
        var lk: i64 = 0
        while lk < span {
            if s1 >= 0 && s1 + lk < 256 { used[(s1 + lk) as usize] = true }
            lk = lk + 1
        }
        lk = 0
        while lk < s2_span {
            if s2 >= 0 && s2 + lk < 256 { used[(s2 + lk) as usize] = true }
            lk = lk + 1
        }
        // #1682: NOT EVERY REGISTER USE LIVES IN src1/src2, and this scan used to
        // assume it did. Two operand classes were invisible to it:
        //
        //   IrIndexSet's THIRD operand -- the value being stored -- is parked in
        //   imm_i64 (see ir_index_set). An immediate slot holding a register is
        //   exactly what a liveness scan will not look at. `var a: [i64; 4] = [7; 4]`
        //   lowers to a fill loop whose only use of the 7 is that field, so the
        //   `load_imm` defining it was removed as dead and the array was filled
        //   with garbage -- ten lines, no loop in the source, wrong answer under -O.
        //
        //   Call arguments live in the flat IR_ARG_POOL, not in src1/src2 either.
        //   No test caught that one; it is the same defect one operand class over,
        //   and it is fixed here rather than waiting for it to be found the hard way.
        //
        // ocp_rebracket_source_use_count already counted the IrIndexSet operand.
        // The two disagreed, and DCE is the one that deletes.
        if (IR_A_OP[at as usize] as IrOpcode) == IrOpcode::IrIndexSet {
            let v = IR_A_IMM_I64[at as usize]
            if v >= 0 && v < 256 {
                used[v as usize] = true
            }
        }
        var ak: i64 = 0
        while ak < IR_A_ARG_COUNT[at as usize] {
            let a = ir_arena_arg_at(at, ak)
            if a >= 0 && a < 256 {
                used[a as usize] = true
            }
            ak = ak + 1
        }
        i = i + 1
    }
    var removed: i64 = 0
    i = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        if ocp_has_dst(op) && !ocp_has_side_effect(op) {
            if dst >= 0 && dst < 256 {
                // A wide definition writes its whole range, so it is dead only
                // when EVERY limb is unused. Testing the base alone removed
                // instructions whose upper limbs were still read.
                let dspan = ocp_dst_limb_count(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i)))
                var any_used: bool = false
                var dk: i64 = 0
                while dk < dspan {
                    if dst + dk < 256 && used[(dst + dk) as usize] { any_used = true }
                    dk = dk + 1
                }
                if !any_used {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
                    removed = removed + 1
                }
            }
        }
        i = i + 1
    }
    removed
}

// Core integer const-fold via module+fi peels (no by-value IrFunction).
// Subset of ocp_const_fold_pass_b both-const arithmetic/bitwise/compare plus
// partial-constant identity/annihilation. Heavy chain rewrites (Block L/M/…)
// stay on the by-value self-test spine.
fn ocp_mfi_const_fold(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // #1667: this is a LINEAR scan, so state carried across a block
        // boundary is carried between basic blocks, where it does not hold. A
        // value established in one arm of an if/else was reaching the other arm
        // and the join. Kill the table at a label (a join: incoming values are
        // unknown) and after a terminator (the next instruction is another
        // block). Conservative, not a CFG -- but sound, which it was not.
        if op == IrOpcode::IrLabel {
            var bb: i64 = 0
            while bb < 256 { is_const[bb as usize] = false  bb = bb + 1 }
        }
        // The written RANGE: a wide write covers limb_count consecutive
        // registers, and a constant recorded on limb k outlived it.
        if dst >= 0 && dst < 256 {
            let cspan = ocp_dst_limb_count(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i)))
            var ck: i64 = 0
            while ck < cspan {
                if dst + ck < 256 { is_const[(dst + ck) as usize] = false }
                ck = ck + 1
            }
        }
        if ocp_is_load_imm(op) || op == IrOpcode::IrLoadBool {
            if dst >= 0 && dst < 256 {
                is_const[dst as usize] = true
                const_val[dst as usize] = IR_A_IMM_I64[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            }
        }
        if op == IrOpcode::IrCopy {
            let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            if s1 >= 0 && s1 < 256 && is_const[s1 as usize] {
                if dst >= 0 && dst < 256 {
                    let v = const_val[s1 as usize]
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, v))
                    is_const[dst as usize] = true
                    const_val[dst as usize] = v
                }
            }
        }
        if ocp_is_binop(op) {
            let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            let s2 = IR_A_SRC2[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            let bin = (IR_A_BIN_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as BinaryOp)
            let s1_ok = s1 >= 0 && s1 < 256
            let s2_ok = s2 >= 0 && s2 < 256
            let s1_known = s1_ok && is_const[s1 as usize]
            let s2_known = s2_ok && is_const[s2 as usize]
            // Both-constant fold (integer lattice).
            if s1_known && s2_known {
                let v1 = const_val[s1 as usize]
                let v2 = const_val[s2 as usize]
                var fold_val: i64 = 0
                var did_fold = false
                if bin == BinaryOp::OpAdd {
                    fold_val = v1 + v2
                    did_fold = true
                }
                if bin == BinaryOp::OpSub {
                    fold_val = v1 - v2
                    did_fold = true
                }
                if bin == BinaryOp::OpMul {
                    fold_val = v1 * v2
                    did_fold = true
                }
                if bin == BinaryOp::OpDiv && v2 != 0 {
                    fold_val = v1 / v2
                    did_fold = true
                }
                if bin == BinaryOp::OpRem && v2 != 0 {
                    fold_val = v1 % v2
                    did_fold = true
                }
                if bin == BinaryOp::OpBitAnd {
                    fold_val = v1 & v2
                    did_fold = true
                }
                if bin == BinaryOp::OpBitOr {
                    fold_val = v1 | v2
                    did_fold = true
                }
                if bin == BinaryOp::OpBitXor {
                    fold_val = v1 ^ v2
                    did_fold = true
                }
                if bin == BinaryOp::OpShl && v2 >= 0 && v2 < 64 {
                    fold_val = v1 << v2
                    did_fold = true
                }
                if bin == BinaryOp::OpShr && v2 >= 0 && v2 < 64 {
                    fold_val = v1 >> v2
                    did_fold = true
                }
                if bin == BinaryOp::OpEq {
                    fold_val = if v1 == v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpNe {
                    fold_val = if v1 != v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpLt {
                    fold_val = if v1 < v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpLe {
                    fold_val = if v1 <= v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpGt {
                    fold_val = if v1 > v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpGe {
                    fold_val = if v1 >= v2 { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpAnd {
                    fold_val = if (v1 != 0) && (v2 != 0) { 1 } else { 0 }
                    did_fold = true
                }
                if bin == BinaryOp::OpOr {
                    fold_val = if (v1 != 0) || (v2 != 0) { 1 } else { 0 }
                    did_fold = true
                }
                if did_fold && dst >= 0 && dst < 256 {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, fold_val))
                    is_const[dst as usize] = true
                    const_val[dst as usize] = fold_val
                }
            }
            // Partial-constant identity / annihilation (exactly one side known).
            if (s1_known && !s2_known) || (!s1_known && s2_known) {
                let v1 = if s1_known { const_val[s1 as usize] } else { 0 }
                let v2 = if s2_known { const_val[s2 as usize] } else { 0 }
                if bin == BinaryOp::OpMul {
                    if s2_known && v2 == 1 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s1))
                    }
                    if s1_known && v1 == 1 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s2))
                    }
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, 0))
                        if dst >= 0 && dst < 256 {
                            is_const[dst as usize] = true
                            const_val[dst as usize] = 0
                        }
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, 0))
                        if dst >= 0 && dst < 256 {
                            is_const[dst as usize] = true
                            const_val[dst as usize] = 0
                        }
                    }
                }
                if bin == BinaryOp::OpAdd {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s2))
                    }
                }
                if bin == BinaryOp::OpSub {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s1))
                    }
                }
                if bin == BinaryOp::OpBitOr {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s2))
                    }
                }
                if bin == BinaryOp::OpBitAnd {
                    if (s2_known && v2 == 0) || (s1_known && v1 == 0) {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, 0))
                        if dst >= 0 && dst < 256 {
                            is_const[dst as usize] = true
                            const_val[dst as usize] = 0
                        }
                    }
                }
                if bin == BinaryOp::OpBitXor {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_copy(dst, s2))
                    }
                }
            }
        }
        // Unary OpNeg of a known constant.
        if op == IrOpcode::IrUnaryOp {
            let un = (IR_A_UN_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as UnaryOp)
            let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            if un == UnaryOp::OpNeg && s1 >= 0 && s1 < 256 && is_const[s1 as usize] {
                if dst >= 0 && dst < 256 {
                    let v = 0 - const_val[s1 as usize]
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_load_imm(dst, v))
                    is_const[dst as usize] = true
                    const_val[dst as usize] = v
                }
            }
        }
        if op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue
            || op == IrOpcode::IrBranchFalse || op == IrOpcode::IrReturn {
            var bb: i64 = 0
            while bb < 256 { is_const[bb as usize] = false  bb = bb + 1 }
        }
        i = i + 1
    }
}

// SCCP-lite (Wegman & Zadeck style lattice over a linear scan): fold branches
// whose condition is a known constant; re-fold binops after copy chains.
// Does not form &! functions[fi] or invoke cp_optimize_function (by-value).
fn ocp_mfi_sccp(module: &! IrModule, fi: i64) with Mut, Div, Panic {
    // Pass 1: rebuild lattice + fold remaining both-const / copy-of-const.
    ocp_mfi_const_fold(module, fi)
    // Pass 2: branch folding on known conditions.
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < ir_fn_get(&(*module), fi as usize).instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize] as IrOpcode)
        let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
        // #1667: this is a LINEAR scan, so state carried across a block
        // boundary is carried between basic blocks, where it does not hold. A
        // value established in one arm of an if/else was reaching the other arm
        // and the join. Kill the table at a label (a join: incoming values are
        // unknown) and after a terminator (the next instruction is another
        // block). Conservative, not a CFG -- but sound, which it was not.
        if op == IrOpcode::IrLabel {
            var bb: i64 = 0
            while bb < 256 { is_const[bb as usize] = false  bb = bb + 1 }
        }
        // The written RANGE: a wide write covers limb_count consecutive
        // registers, and a constant recorded on limb k outlived it.
        if dst >= 0 && dst < 256 {
            let cspan = ocp_dst_limb_count(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i)))
            var ck: i64 = 0
            while ck < cspan {
                if dst + ck < 256 { is_const[(dst + ck) as usize] = false }
                ck = ck + 1
            }
        }
        if ocp_is_load_imm(op) || op == IrOpcode::IrLoadBool {
            if dst >= 0 && dst < 256 {
                is_const[dst as usize] = true
                const_val[dst as usize] = IR_A_IMM_I64[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            }
        }
        if op == IrOpcode::IrCopy {
            let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            if s1 >= 0 && s1 < 256 && is_const[s1 as usize] && dst >= 0 && dst < 256 {
                is_const[dst as usize] = true
                const_val[dst as usize] = const_val[s1 as usize]
            }
        }
        if op == IrOpcode::IrBranchTrue {
            let cond = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            if cond >= 0 && cond < 256 && is_const[cond as usize] {
                if const_val[cond as usize] != 0 {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_jump(lab))
                } else {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
                }
            }
        }
        if op == IrOpcode::IrBranchFalse {
            let cond = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (i))) as usize]
            if cond >= 0 && cond < 256 && is_const[cond as usize] {
                if const_val[cond as usize] == 0 {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_jump(lab))
                } else {
                    ir_arena_store(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (i)), ir_nop())
                }
            }
        }
        if op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue
            || op == IrOpcode::IrBranchFalse || op == IrOpcode::IrReturn {
            var bb: i64 = 0
            while bb < 256 { is_const[bb as usize] = false  bb = bb + 1 }
        }
        i = i + 1
    }
    // Pass 3: unreachable after unconditional jump/return (SCCP reachability).
    ocp_mfi_dead_after_jump(module, fi)
}

// Field-wise instruction move for compact_nops: never whole-IrInstr copy.
// Transfers call_args by field assign then clears the source slot (module_frontend
// already uses this pattern for call_args rebuild).
fn ocp_mfi_instr_move_fields(module: &! IrModule, fi: i64, dst_i: i64, src_i: i64) with Mut, Div, Panic {
    let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize] as IrOpcode)
    let dst = IR_A_DST[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let s1 = IR_A_SRC1[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let s2 = IR_A_SRC2[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let imm = IR_A_IMM_I64[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let immf = IR_A_IMM_F64[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let lab = IR_A_LABEL_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let fnid = IR_A_FN_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let fidx = IR_A_FIELD_IDX[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let flags = IR_A_IMM_FLAGS[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    let bin = (IR_A_BIN_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize] as BinaryOp)
    let un = (IR_A_UN_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize] as UnaryOp)
    let nm = ir_arena_name(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i)))
    let ac = IR_A_ARG_COUNT[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize]
    IR_A_OP[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = op
    IR_A_DST[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = dst
    IR_A_SRC1[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = s1
    IR_A_SRC2[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = s2
    IR_A_IMM_I64[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = imm
    IR_A_IMM_F64[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = immf
    IR_A_LABEL_ID[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = lab
    IR_A_FN_ID[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = fnid
    IR_A_FIELD_IDX[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = fidx
    IR_A_IMM_FLAGS[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = flags
    IR_A_BIN_OP[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = bin
    IR_A_UN_OP[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = un
    // #1667 / #1649: this was `ir_arena_name(<dst slot>) = nm`. ir_arena_name is
    // a GETTER returning a Name by value, so the assignment wrote nothing and the
    // destination slot kept the previous occupant's name. compact_nops moves every
    // surviving instruction down, so after any -O run that removed a nop, string
    // constants printed some other instruction's name -- `print_char` instead of
    // the literal. A transform artifact: the original `X.instrs[d].name = ...` had
    // its left-hand side rewritten into the getter.
    ir_arena_put_name(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i)), nm)
    IR_A_ARG_COUNT[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i))) as usize] = ac
    // Move call_args ownership: field assign then clear source before NOP.
    // (Same field-level call_args write pattern as module_frontend arebox.)
    if ac > 0 {
        ir_arena_move_args(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i)), ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (src_i)))
        ir_arena_clear_args(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (src_i)))
        IR_A_ARG_COUNT[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (src_i))) as usize] = 0
    } else {
        ir_arena_clear_args(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (dst_i)))
    }
}

// Compact IrNop holes by field-wise dense packing. Label ids are symbolic.
fn ocp_mfi_compact_nops(module: &! IrModule, fi: i64) with Alloc, Mut, Div, Panic {
    var write: i64 = 0
    var read: i64 = 0
    let ic = ir_fn_get(&(*module), fi as usize).instr_count
    while read < ic {
        let op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (read))) as usize] as IrOpcode)
        // A nop carrying IR_FLOAT_REG_MARKER_FLAG is NOT dead. Codegen reads it
        // to learn that a register holds f64 -- codegen_x86_linux.sio:7406,
        // "Always honor an explicit float-marker IrNop". Dropping it makes the
        // register read as an integer, so every f64 coming back from a call was
        // garbage under -O:
        //
        //     fn half(x: f64) -> f64 { x * 0.5 }
        //     half(5.0)  ->  9223372036854775808.000000   instead of 2.5
        //
        // This is also why an epistemic variance read back as 0 under -O: the
        // shadow value is an f64 reached through exactly this marker.
        let marker = IR_A_IMM_FLAGS[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (read))) as usize]
        if op != IrOpcode::IrNop || marker == IR_FLOAT_REG_MARKER_FLAG {
            if write != read {
                ocp_mfi_instr_move_fields(module, fi, write, read)
            }
            write = write + 1
        }
        read = read + 1
    }
    var fill = write
    var fn_slot = ir_fn_get(&(*module), fi as usize)
    while fill < ic {
        ir_arena_store(ir_region_slot_w(fn_slot.region, (fill)), ir_nop())
        fill = fill + 1
    }
    fn_slot.instr_count = write
    ir_fn_set(&! (*module), fi as usize, fn_slot)
}

// Safe multi-module function cleanup via module+fi field access only.
// Per-peel kill switch for the in-place -O pipeline. Bit set = peel SKIPPED.
// Default 0, so with no environment set this file behaves exactly as before.
//
// WHY THIS EXISTS. Bisecting "which peel produced this bad IR" previously cost a
// full ~15-minute Madaros rebuild per hypothesis, because the only way to remove
// a peel was to edit this list and recompile. With the switch it is one build
// and N runs. It paid for itself the first time it was used: it showed that
// skipping ALL peels is not a valid control, because skipping compaction leaves
// every nop in the stream and is independently fatal -- an experiment that had
// already produced one wrong conclusion before the switch made it visible.
//
// A global rather than read_env at each site: the peels carry Mut/Div/Panic and
// no IO, and widening them would cascade the effect to every caller. The value
// is loaded once from the compile entry, which already has IO.
pub var OCP_SKIP_MASK: i64 = 0

fn ocp_skip(bit: i64) -> bool with Div {
    (OCP_SKIP_MASK / bit) % 2 == 1
}

fn opt_cleanup_function_mfi(module: &! IrModule, fi: i64) with Alloc, Mut, Div, Panic {
    let ic = ir_fn_get(&(*module), fi as usize).instr_count
    if ic <= 0 {
        return
    }
    if !ocp_skip(1)    { ocp_mfi_dedup_imm(module, fi) }
    if !ocp_skip(2)    { ocp_mfi_const_fold(module, fi) }
    if !ocp_skip(4)    { ocp_mfi_copy_prop(module, fi) }
    if !ocp_skip(8)    { ocp_mfi_dse(module, fi) }
    if !ocp_skip(16)   { ocp_mfi_redundant_jump(module, fi) }
    if !ocp_skip(32)   { ocp_mfi_jump_to_return(module, fi) }
    if !ocp_skip(64)   { ocp_mfi_dead_after_jump(module, fi) }
    if !ocp_skip(128)  { ocp_mfi_dead_label(module, fi) }
    if !ocp_skip(256)  { ocp_mfi_cse(module, fi) }
    if !ocp_skip(512) {
        var iter: i64 = 0
        while iter < 8 {
            let removed = ocp_mfi_dce_once(module, fi)
            if removed == 0 {
                iter = 8
            }
            iter = iter + 1
        }
    }
    // SCCP-lite + compact: previously deferred (by-value path only).
    if !ocp_skip(1024) { ocp_mfi_sccp(module, fi) }
    if !ocp_skip(2048) { let _ = ocp_mfi_dce_once(module, fi) }
    if !ocp_skip(4096) { ocp_mfi_compact_nops(module, fi) }
}

// Run safe field-wise cleanup on every function without copying IrModule or
// IrFunction by value, and without taking `&! functions[fi]`.
pub fn opt_cleanup_module_inplace(module: &! IrModule) -> OcpCleanupModuleReceipt with Alloc, Mut, Div, Panic {
    // Exact-bitwise rebracket audit still lives on the by-value const-fold
    // spine (self-test / pipeline probe path). Multi-module -O uses mfi peels
    // (including core const-fold / SCCP-lite / compact_nops); heavy Block-L
    // rebracket authority is not yet field-wise, so audit deltas stay zero.
    var audit = ocp_empty_exact_bitwise_rebracket_pass_audit()
    var last_application_function_index: i64 = -1
    var transaction_ontology_parameter_link_count: i64 = 0
    var application_ontology_parameter_link_count: i64 = 0
    var last_transaction_ontology_class_hash: i64 = 0
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let transactions_before = audit.transaction_count
        let applications_before = audit.application_count
        let function_name = ir_fn_get(&(*module), fi as usize).name
        // A module-level global lowers to a PSEUDO-FUNCTION slot
        // (compile_strategy = IR_STRATEGY_BSS_GLOBAL) whose instrs[] does not
        // hold code: for a multi-element initialiser it holds the init WORDS,
        // and emit_global_var_inits_into derives each element's ADDRESS from the
        // instruction index. Running instruction peels over that is meaningless
        // at best -- compaction deletes those data-carrying nops outright and
        // destroys the initialiser. Skip them.
        if ir_fn_get(&(*module), fi as usize).compile_strategy != IR_STRATEGY_BSS_GLOBAL {
            // Inplace field-wise peels — never by-value IrFunction from the array.
            opt_cleanup_function_mfi(module, fi)
        }
        // Audit links are keyed by the lowered function name. Cleanup is not a
        // symbol-renaming pass, so fail loudly if that invariant ever changes.
        assert(ir_name_eq(function_name, ir_fn_get(&(*module), fi as usize).name))
        let transaction_delta = audit.transaction_count - transactions_before
        let application_delta = audit.application_count - applications_before
        if transaction_delta > 0 {
            let link_count = ir_ontology_parameter_link_count_for_function(&(*module).ontologies, function_name)
            transaction_ontology_parameter_link_count = transaction_ontology_parameter_link_count + link_count * transaction_delta
            if link_count > 0 {
                last_transaction_ontology_class_hash = ir_ontology_parameter_last_class_hash_for_function(
                    &(*module).ontologies,
                    function_name,
                )
            }
            if application_delta > 0 {
                application_ontology_parameter_link_count = application_ontology_parameter_link_count + link_count * application_delta
            }
        }
        if audit.application_count > applications_before {
            last_application_function_index = fi
        }
        fi = fi + 1
    }
    OcpCleanupModuleReceipt {
        function_count: (*module).fn_count,
        exact_bitwise_transaction_count: audit.transaction_count,
        exact_bitwise_authorization_count: audit.authorization_count,
        exact_bitwise_application_count: audit.application_count,
        exact_bitwise_refusal_count: audit.refusal_count,
        exact_bitwise_same_region_application_count: audit.same_region_application_count,
        exact_bitwise_cross_block_application_count: audit.cross_block_application_count,
        exact_bitwise_refusal_reason_mask: audit.refusal_reason_mask,
        exact_bitwise_transaction_ontology_parameter_link_count: transaction_ontology_parameter_link_count,
        exact_bitwise_application_ontology_parameter_link_count: application_ontology_parameter_link_count,
        last_transaction_ontology_class_hash: last_transaction_ontology_class_hash,
        exact_bitwise_operator_mask: audit.operator_mask,
        last_application_function_index: last_application_function_index,
        last_combined_const_value: audit.last_combined_const_value,
    }
}

// Legacy by-value API retained for callers that already own an IrModule value.
pub fn opt_cleanup_module(module: IrModule) -> IrModule with Alloc, Mut, Div, Panic {
    var result = module
    opt_cleanup_module_inplace(&! result)
    result
}

// Exercises the real cleanup ordering, including the pass-A1 handoff to Block L.
// Like every public value in this lane, the result is audit evidence only.
pub fn ocp_exact_bitwise_rebracket_pipeline_probe() -> OcpCleanupModuleReceipt with Mut, Div, Panic {
    var audit = ocp_empty_exact_bitwise_rebracket_pass_audit()
    let input = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitAnd, 255, 15)
    opt_cleanup_function_with_algebras_and_audit(
        input,
        ir_empty_algebra_table(),
        &! audit,
    )
    OcpCleanupModuleReceipt {
        function_count: 1,
        exact_bitwise_transaction_count: audit.transaction_count,
        exact_bitwise_authorization_count: audit.authorization_count,
        exact_bitwise_application_count: audit.application_count,
        exact_bitwise_refusal_count: audit.refusal_count,
        exact_bitwise_same_region_application_count: audit.same_region_application_count,
        exact_bitwise_cross_block_application_count: audit.cross_block_application_count,
        exact_bitwise_refusal_reason_mask: audit.refusal_reason_mask,
        exact_bitwise_transaction_ontology_parameter_link_count: 0,
        exact_bitwise_application_ontology_parameter_link_count: 0,
        last_transaction_ontology_class_hash: 0,
        exact_bitwise_operator_mask: audit.operator_mask,
        last_application_function_index: if audit.application_count == 1 { 0 } else { -1 },
        last_combined_const_value: audit.last_combined_const_value,
    }
}
