// self-hosted::ir::opt_cleanup — Post-inlining constant folding + DCE
//
// Runs two cleanup passes per function, in sequence:
//   1. Constant propagation + folding: IrLoadImm values tracked; IrBinOp
//      instructions where both operands are known constants are replaced
//      with an IrLoadImm of the folded result.
//   2. Dead code elimination (mark-sweep): instructions whose destination
//      register is never used as a source, and have no side effects,
//      are replaced with IrNop.
//
// Both passes iterate the instruction array once. No heap allocation.
//
// References:
//   Briggs & Cooper: "Effective Partial Redundancy Elimination" (1994)
//   Cooper, Harvey, Kennedy: "A Simple, Fast Dominance Algorithm" (2001)

module ir::opt_cleanup

use ir::ir::*
use parser::ast::*
use ir::egraph::*
use ir::const_prop::*

// ============================================================================
// Opcode helpers (local, no flat-namespace dependency)
// ============================================================================

fn ocp_is_load_imm(op: IrOpcode) -> bool {
    match op { IrOpcode::IrLoadImm => true, _ => false }
}

fn ocp_is_binop(op: IrOpcode) -> bool {
    match op { IrOpcode::IrBinOp => true, _ => false }
}

fn ocp_is_nop(op: IrOpcode) -> bool {
    match op { IrOpcode::IrNop => true, _ => false }
}

// Returns true if this opcode produces a destination register value
fn ocp_has_dst(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm => true,
        IrOpcode::IrLoadFloat => true,
        IrOpcode::IrLoadBool => true,
        IrOpcode::IrLoadString => true,
        IrOpcode::IrBinOp => true,
        IrOpcode::IrUnaryOp => true,
        IrOpcode::IrCopy => true,
        IrOpcode::IrCall => true,
        IrOpcode::IrFieldGet => true,
        IrOpcode::IrIndexGet => true,
        IrOpcode::IrAlloc => true,
        IrOpcode::IrMeasure => true,
        IrOpcode::IrContest => true,
        IrOpcode::IrProveRobust => true,
        IrOpcode::IrValidated => true,
        _ => false,
    }
}

// Returns true if this opcode has observable side effects (must not be removed)
fn ocp_has_side_effect(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrCall => true,
        IrOpcode::IrReturn => true,
        IrOpcode::IrJump => true,
        IrOpcode::IrBranchTrue => true,
        IrOpcode::IrBranchFalse => true,
        IrOpcode::IrLabel => true,
        IrOpcode::IrFieldSet => true,
        IrOpcode::IrIndexSet => true,
        IrOpcode::IrProfCounter => true,
        IrOpcode::IrAdmitAction => true,
        _ => false,
    }
}

// ============================================================================
// Opcode equality helpers (local copies for module-scope resolution)
// opcodes_equal / matches_opcode are used by the imported const_prop.sio
// flat-namespace code; they must be visible within this module.
// ============================================================================

fn matches_opcode(op: IrOpcode, target: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm    => match target { IrOpcode::IrLoadImm    => true, _ => false },
        IrOpcode::IrLoadFloat  => match target { IrOpcode::IrLoadFloat  => true, _ => false },
        IrOpcode::IrLoadBool   => match target { IrOpcode::IrLoadBool   => true, _ => false },
        IrOpcode::IrLoadString => match target { IrOpcode::IrLoadString => true, _ => false },
        IrOpcode::IrCopy       => match target { IrOpcode::IrCopy       => true, _ => false },
        IrOpcode::IrBinOp      => match target { IrOpcode::IrBinOp      => true, _ => false },
        IrOpcode::IrUnaryOp    => match target { IrOpcode::IrUnaryOp    => true, _ => false },
        IrOpcode::IrCall       => match target { IrOpcode::IrCall       => true, _ => false },
        IrOpcode::IrReturn     => match target { IrOpcode::IrReturn     => true, _ => false },
        IrOpcode::IrJump       => match target { IrOpcode::IrJump       => true, _ => false },
        IrOpcode::IrBranchTrue  => match target { IrOpcode::IrBranchTrue  => true, _ => false },
        IrOpcode::IrBranchFalse => match target { IrOpcode::IrBranchFalse => true, _ => false },
        IrOpcode::IrFieldGet   => match target { IrOpcode::IrFieldGet   => true, _ => false },
        IrOpcode::IrFieldSet   => match target { IrOpcode::IrFieldSet   => true, _ => false },
        IrOpcode::IrIndexGet   => match target { IrOpcode::IrIndexGet   => true, _ => false },
        IrOpcode::IrIndexSet   => match target { IrOpcode::IrIndexSet   => true, _ => false },
        IrOpcode::IrAlloc      => match target { IrOpcode::IrAlloc      => true, _ => false },
        IrOpcode::IrLabel      => match target { IrOpcode::IrLabel      => true, _ => false },
        IrOpcode::IrNop        => match target { IrOpcode::IrNop        => true, _ => false },
        IrOpcode::IrPhi        => match target { IrOpcode::IrPhi        => true, _ => false },
        _ => false,
    }
}

fn opcodes_equal(a: IrOpcode, b: IrOpcode) -> bool {
    match a {
        IrOpcode::IrLoadImm    => matches_opcode(b, IrOpcode::IrLoadImm),
        IrOpcode::IrLoadFloat  => matches_opcode(b, IrOpcode::IrLoadFloat),
        IrOpcode::IrLoadBool   => matches_opcode(b, IrOpcode::IrLoadBool),
        IrOpcode::IrLoadString => matches_opcode(b, IrOpcode::IrLoadString),
        IrOpcode::IrCopy       => matches_opcode(b, IrOpcode::IrCopy),
        IrOpcode::IrBinOp      => matches_opcode(b, IrOpcode::IrBinOp),
        IrOpcode::IrUnaryOp    => matches_opcode(b, IrOpcode::IrUnaryOp),
        IrOpcode::IrCall       => matches_opcode(b, IrOpcode::IrCall),
        IrOpcode::IrReturn     => matches_opcode(b, IrOpcode::IrReturn),
        IrOpcode::IrJump       => matches_opcode(b, IrOpcode::IrJump),
        IrOpcode::IrBranchTrue  => matches_opcode(b, IrOpcode::IrBranchTrue),
        IrOpcode::IrBranchFalse => matches_opcode(b, IrOpcode::IrBranchFalse),
        IrOpcode::IrFieldGet   => matches_opcode(b, IrOpcode::IrFieldGet),
        IrOpcode::IrFieldSet   => matches_opcode(b, IrOpcode::IrFieldSet),
        IrOpcode::IrIndexGet   => matches_opcode(b, IrOpcode::IrIndexGet),
        IrOpcode::IrIndexSet   => matches_opcode(b, IrOpcode::IrIndexSet),
        IrOpcode::IrAlloc      => matches_opcode(b, IrOpcode::IrAlloc),
        IrOpcode::IrLabel      => matches_opcode(b, IrOpcode::IrLabel),
        IrOpcode::IrNop        => matches_opcode(b, IrOpcode::IrNop),
        IrOpcode::IrPhi        => matches_opcode(b, IrOpcode::IrPhi),
        _ => false,
    }
}

// ============================================================================
// Sprint 68: Strength reduction helpers
// ============================================================================

// Returns true for integers that are a power of two and greater than 1.
fn ocp_is_power_of_two(n: i64) -> bool {
    n > 1 && (n & (n - 1)) == 0
}

// Returns floor(log2(n)) for n that is a power of two (n > 1 assumed).
fn ocp_log2(n: i64) -> i64 {
    var r: i64 = 0
    var m = n
    while m > 1 {
        m = m / 2
        r = r + 1
    }
    r
}

// ============================================================================
// Sprint 72: E-graph opcode bridge
// ============================================================================

// Map a Sounio BinaryOp to an EG_OP_* constant understood by the e-graph.
// Unmapped ops return EG_OP_CONST as an opaque placeholder.
fn ocp_binop_to_eg_op(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd { return EG_OP_ADD }
    if op == BinaryOp::OpSub { return EG_OP_SUB }
    if op == BinaryOp::OpMul { return EG_OP_MUL }
    if op == BinaryOp::OpDiv { return EG_OP_DIV }
    EG_OP_CONST
}

// CSE can canonicalize a few more commutative ops than the small e-graph layer.
// Keep those keys local so the e-graph surface does not need to pretend it
// understands OR/AND/XOR rewrites it cannot yet optimize.
fn ocp_binop_to_cse_key(op: BinaryOp) -> i64 {
    let eg = ocp_binop_to_eg_op(op)
    if eg != EG_OP_CONST { return eg }
    if op == BinaryOp::OpOr { return 1001 }
    if op == BinaryOp::OpAnd { return 1002 }
    if op == BinaryOp::OpBitXor { return 1003 }
    0
}

// Sprint 84: Returns a non-zero key for ops that are associative over integers.
// Used by Block L to detect reassociation opportunities.
// Only Add, Mul, BitAnd, BitOr, BitXor are included — Sub/Div/Shl/Shr are excluded.
// (Shifts handled separately by Sprint 96 Block T with dedicated sh_valid arrays.)
// SOTA: Click "Combining Reductions" PLDI 1995 §4.
fn ocp_binop_to_ra_key(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd    { return 1 }
    if op == BinaryOp::OpMul    { return 2 }
    if op == BinaryOp::OpBitAnd { return 3 }
    if op == BinaryOp::OpBitOr  { return 4 }
    if op == BinaryOp::OpBitXor { return 5 }
    0
}

// ============================================================================
// Pass 1: Constant propagation + folding
// ============================================================================

// Run constant propagation + folding on a single function.
// Tracks integer constants in a fixed-size register map (256 regs max).
// Folds IrBinOp when both src operands are known integer constants.
// Sprint 68: def_at[r] records the instruction index where r was last set by IrLoadImm,
// enabling in-place patching of the constant when strength reduction rewrites it.
fn ocp_const_fold(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var def_at: [i64; 256] = [-1; 256]
    // Sprint 84 Block L: Associative chain tracking.
    // has_ra[r]=true means r = (ra_base[r] assoc_op ra_const_val[r]).
    var has_ra:       [bool; 256] = [false; 256]
    var ra_base:      [i64;  256] = [-1;   256]
    var ra_const_val: [i64;  256] = [0;    256]
    var ra_op:        [i64;  256] = [0;    256]
    // Sprint 86 Block M: Negation tracking for double-neg and neg-arithmetic.
    var is_neg:  [bool; 256] = [false; 256]
    var neg_src: [i64;  256] = [-1;    256]
    // Sprint 112 Block AI: Bitwise NOT via XOR(-1) tracking.
    var is_bnot:  [bool; 256] = [false; 256]
    var bnot_src: [i64;  256] = [-1;    256]
    // Sprint 88 Block O: Mul-div cancellation — track r = x * C (partial-const mul).
    // (x * C) / C → x.  SOTA: LLVM InstCombineMulDivRem.cpp; Cooper & Torczon §9.
    var mul_valid:   [bool; 256] = [false; 256]
    var mul_var_src: [i64;  256] = [-1;    256]
    var mul_const_v: [i64;  256] = [0;     256]
    // Sprint 89 Block P: Add-sub/sub-add cancellation — track r = x +/- C.
    // (x + C) - C → x  ;  (x - C) + C → x.
    // SOTA: LLVM InstCombineAddSub.cpp; Muchnick §12.2.
    var as_valid:   [bool; 256] = [false; 256]
    var as_var_src: [i64;  256] = [-1;    256]
    var as_const_v: [i64;  256] = [0;     256]
    var as_is_add:  [bool; 256] = [false; 256]
    // Sprint 96 Block T: Shift-chain combining — track r = x << C or r = x >> C.
    // (x << C1) << C2 → x << (C1+C2)  ;  (x >> C1) >> C2 → x >> (C1+C2).
    // SOTA: Bernstein SODA 1986; LLVM InstCombineShifts.cpp.
    var sh_valid:   [bool; 256] = [false; 256]
    var sh_var_src: [i64;  256] = [-1;    256]
    var sh_amount:  [i64;  256] = [0;     256]
    var sh_is_left: [bool; 256] = [false; 256]
    // Sprint 101 Block Y: Boolean simplification — track comparison results.
    // is_cmp_result[r]=true means r was produced by a comparison (OpEq/OpNe/etc).
    // cmp_orig_src[r] = the first operand of the comparison.
    // cmp_op_code[r] = 1 for OpEq, 2 for OpNe, 3 for other comparisons.
    var is_cmp_result: [bool; 256] = [false; 256]
    var cmp_orig_src:  [i64;  256] = [-1;    256]
    var cmp_op_code:   [i64;  256] = [0;     256]

    // Sprint 108 Block AE: And-mask fold — track r = x & C.
    // (x & C1) & C2 → x & (C1 & C2).  SOTA: LLVM InstCombineAndOrXor.cpp.
    var and_valid:     [bool; 256] = [false; 256]
    var and_var_src:   [i64;  256] = [-1;    256]
    var and_const_val: [i64;  256] = [0;     256]
    // Sprint 115 Block AL: Sub-tracking for neg reversal.
    // al_is_sub[r]=true means r = al_sub_lhs[r] - al_sub_rhs[r].
    // neg(a - b) -> b - a  ;  0 - (a - b) -> b - a.
    // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
    var al_is_sub:  [bool; 256] = [false; 256]
    var al_sub_lhs: [i64;  256] = [-1;    256]
    var al_sub_rhs: [i64;  256] = [-1;    256]
    // Sprint 116 Block AM: OR-mask tracking for superset elimination.
    // (x | C1) | C2 where (C1 | C2) == C1 → IrCopy(src1).
    // SOTA: LLVM InstCombineAndOrXor.cpp.
    var am_or_valid:     [bool; 256] = [false; 256]
    var am_or_var_src:   [i64;  256] = [-1;    256]
    var am_or_const_val: [i64;  256] = [0;     256]
    // Sprint 127 Block AO: Register-register AND/OR tracking for absorption.
    // Huntington 1904 absorption axiom: a | (a & b) = a, a & (a | b) = a.
    // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1.
    var ao_and_rr_valid: [bool; 256] = [false; 256]
    var ao_and_rr_lhs:   [i64;  256] = [-1;    256]
    var ao_and_rr_rhs:   [i64;  256] = [-1;    256]
    var ao_or_rr_valid:  [bool; 256] = [false; 256]
    var ao_or_rr_lhs:    [i64;  256] = [-1;    256]
    var ao_or_rr_rhs:    [i64;  256] = [-1;    256]
    // Sprint 129 Block AQ: Register-register add/mul tracking for inverse cancellation.
    // (a + b) - b → a, (a * b) / b → a.
    // SOTA: LLVM InstCombine algebraic identity; group-theoretic inverse.
    var aq_add_rr_valid: [bool; 256] = [false; 256]
    var aq_add_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_add_rr_rhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_valid: [bool; 256] = [false; 256]
    var aq_mul_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 131 Block AS: Register-register XOR tracking for self-inverse cancellation.
    // (a ^ b) ^ b → a, (a ^ b) ^ a → b.
    // SOTA: LLVM InstCombineAndOrXor; GF(2) field: XOR is its own inverse.
    var as_xor_rr_valid: [bool; 256] = [false; 256]
    var as_xor_rr_lhs:   [i64;  256] = [-1;    256]
    var as_xor_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 149 Block BK: Consecutive same-direction shift folding.
    // (x << A) << B → x << (A+B), (x >> A) >> B → x >> (A+B).
    // Track when a register is the result of a shift by a known constant.
    // SOTA: LLVM InstCombineShifts.cpp FoldShiftByConstant; Cooper & Torczon §8.1.
    var bk_shl_valid: [bool; 256] = [false; 256]
    var bk_shl_src:   [i64;  256] = [-1;    256]
    var bk_shl_amt:   [i64;  256] = [0;     256]
    var bk_shr_valid: [bool; 256] = [false; 256]
    var bk_shr_src:   [i64;  256] = [-1;    256]
    var bk_shr_amt:   [i64;  256] = [0;     256]
    // Sprint 151 Block BM: XOR constant-chain fold — (x ^ C1) ^ C2 → x ^ (C1^C2).
    // Mirrors Block BG (OR) and Block AE (AND) for the XOR operator.
    // SOTA: LLVM InstCombineAndOrXor; GF(2) field associativity; Hacker's Delight §2-3.
    var bm_xor_valid: [bool; 256] = [false; 256]
    var bm_xor_src:   [i64;  256] = [-1;    256]
    var bm_xor_cval:  [i64;  256] = [0;     256]

    // Sprint 157 Block BS: Consecutive subtract-constant fold — (x - C1) - C2 → x - (C1+C2).
    // Mirrors Block BG (OR-chain) and Block BM (XOR-chain) for subtraction.
    // SOTA: LLVM InstCombineAddSub; Cooper & Torczon §8.2; associative arithmetic.
    var bs_sub_valid: [bool; 256] = [false; 256]
    var bs_sub_src:   [i64;  256] = [-1;    256]
    var bs_sub_cval:  [i64;  256] = [0;     256]

    // Sprint 158 Block BT: Consecutive add-constant fold — (x + C1) + C2 → x + (C1+C2).
    // Symmetric to Block BS (sub-chain) for addition. Reuses same merge pattern.
    // SOTA: LLVM InstCombineAddSub.cpp; additive associativity; Cooper & Torczon §8.2.
    var bt_add_valid: [bool; 256] = [false; 256]
    var bt_add_src:   [i64;  256] = [-1;    256]
    var bt_add_cval:  [i64;  256] = [0;     256]

    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        var preserve_mul_chain = false

        // Track IrLoadImm: register dst becomes a known constant
        if ocp_is_load_imm(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }

        // Sprint 83 Block K: IrLoadBool constant tracking.
        // IrLoadBool stores true→1, false→0 in imm_i64. Tracking booleans in the
        // constant lattice enables downstream Block F branch folding, Block E
        // comparison folding, and SCCP on boolean-valued registers.
        // SOTA: Click "Value Numbering" PLDI 1995 §2 — all value-producing
        // instructions participate in the constant lattice.
        if instr.op == IrOpcode::IrLoadBool {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }

        // Fold IrBinOp with two known integer constants
        if ocp_is_binop(instr.op) {
            let s1 = instr.src1
            let s2 = instr.src2
            if s1 >= 0 && s1 < 256 && s2 >= 0 && s2 < 256 {
                if is_const[s1 as usize] && is_const[s2 as usize] {
                    let v1 = const_val[s1 as usize]
                    let v2 = const_val[s2 as usize]
                    var fold_val: i64 = 0
                    var did_fold = false
                    if instr.bin_op == BinaryOp::OpAdd {
                        fold_val = v1 + v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpSub {
                        fold_val = v1 - v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpMul {
                        fold_val = v1 * v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpDiv && v2 != 0 {
                        fold_val = v1 / v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpRem && v2 != 0 {
                        fold_val = v1 % v2
                        did_fold = true
                    }
                    // Sprint 81 Block I: Bitwise + shift both-constant folding.
                    // (Cooper & Torczon "Engineering a Compiler" §9.2: constant folding
                    //  is complete only when ALL operators are handled uniformly.)
                    if instr.bin_op == BinaryOp::OpBitAnd {
                        fold_val = v1 & v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpBitOr {
                        fold_val = v1 | v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpBitXor {
                        fold_val = v1 ^ v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpShl && v2 >= 0 && v2 < 64 {
                        fold_val = v1 << v2
                        did_fold = true
                    }
                    if instr.bin_op == BinaryOp::OpShr && v2 >= 0 && v2 < 64 {
                        fold_val = v1 >> v2
                        did_fold = true
                    }
                    if did_fold {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, fold_val)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = fold_val
                        }
                    }
                }
            }
        }

        // Sprint 67: Partial-constant identity/annihilation folding.
        // Fires when exactly one operand is a known constant and a simplification applies.
        // The resulting IrCopy or IrLoadImm leaves the old IrLoadImm dead; DCE removes it.
        if ocp_is_binop(instr.op) {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1_ok = s1 >= 0 && s1 < 256
            let s2_ok = s2 >= 0 && s2 < 256
            let s1_known = s1_ok && is_const[s1 as usize]
            let s2_known = s2_ok && is_const[s2 as usize]
            // Only fire when exactly one side is constant (full-constant handled above).
            if (s1_known && !s2_known) || (!s1_known && s2_known) {
                let v2 = if s2_known { const_val[s2 as usize] } else { 0 }
                let v1 = if s1_known { const_val[s1 as usize] } else { 0 }
                // x * 1 → IrCopy(dst, x)  ;  1 * x → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpMul {
                    if s2_known && v2 == 1 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    if s1_known && v1 == 1 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s2)
                    }
                    // x * 0 → IrLoadImm(dst, 0)  ;  0 * x → IrLoadImm(dst, 0)
                    if s2_known && v2 == 0 {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    // Sprint 88 Block O: Track r = x * C for mul-div cancellation.
                    if instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && v2 != 0 && !s1_known {
                            mul_valid[instr.dst as usize]   = true
                            mul_var_src[instr.dst as usize] = s1
                            mul_const_v[instr.dst as usize] = v2
                        }
                        if s1_known && v1 != 0 && !s2_known {
                            mul_valid[instr.dst as usize]   = true
                            mul_var_src[instr.dst as usize] = s2
                            mul_const_v[instr.dst as usize] = v1
                        }
                    }
                    // Sprint 89 Block P: Track r = x + C (commutative).
                    if instr.bin_op == BinaryOp::OpAdd && instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && !s1_known && s1 >= 0 && s1 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s1
                            as_const_v[instr.dst as usize] = v2
                            as_is_add[instr.dst as usize]  = true
                        }
                        if s1_known && !s2_known && s2 >= 0 && s2 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s2
                            as_const_v[instr.dst as usize] = v1
                            as_is_add[instr.dst as usize]  = true
                        }
                    }
                    // Sprint 89 Block P: Track r = x - C.
                    if instr.bin_op == BinaryOp::OpSub && instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && !s1_known && s1 >= 0 && s1 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s1
                            as_const_v[instr.dst as usize] = v2
                            as_is_add[instr.dst as usize]  = false
                        }
                    }
                    // Sprint 89 Block P fold: (x + C) - C → IrCopy(x).
                    if instr.bin_op == BinaryOp::OpSub && s2_known && !s1_known
                            && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && as_is_add[s1 as usize] && as_const_v[s1 as usize] == v2 {
                        result.instrs[i as usize] = ir_copy(instr.dst, as_var_src[s1 as usize])
                        if instr.dst >= 0 && instr.dst < 256 {
                            as_valid[instr.dst as usize] = false
                        }
                    }
                    // Sprint 89 Block P fold: (x - C) + C → IrCopy(x).
                    if instr.bin_op == BinaryOp::OpAdd && s2_known && !s1_known
                            && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && !as_is_add[s1 as usize] && as_const_v[s1 as usize] == v2 {
                        result.instrs[i as usize] = ir_copy(instr.dst, as_var_src[s1 as usize])
                        if instr.dst >= 0 && instr.dst < 256 {
                            as_valid[instr.dst as usize] = false
                        }
                    }
                    // Sprint 111 Block AH: Add/sub chain constant merging (unequal C).
                    // (x - C1) - C2 → x - (C1+C2)
                    // (x - C1) + C2 → x +/- |C2-C1|  (net offset)
                    // (x + C1) - C2 → x +/- |C1-C2|  (net offset)
                    // SOTA: LLVM InstCombineAddSub.cpp; Click PLDI 1995 §4.
                    if s2_known && !s1_known && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && as_const_v[s1 as usize] != v2 {
                        let ah_base = as_var_src[s1 as usize]
                        let ah_c1   = as_const_v[s1 as usize]
                        let ah_was_add = as_is_add[s1 as usize]
                        let ah_c2_def = def_at[s2 as usize]
                        if ah_c2_def >= 0 {
                            // (x - C1) - C2 → x - (C1 + C2)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpSub {
                                let ah_merged = ah_c1 + v2
                                result.instrs[ah_c2_def as usize] = ir_load_imm(s2, ah_merged)
                                result.instrs[i as usize] = ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2)
                                const_val[s2 as usize] = ah_merged
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_merged
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x - C1) + C2, C2 > C1 → x + (C2 - C1)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpAdd && v2 > ah_c1 {
                                let ah_net = v2 - ah_c1
                                result.instrs[ah_c2_def as usize] = ir_load_imm(s2, ah_net)
                                result.instrs[i as usize] = ir_binop(instr.dst, ah_base, BinaryOp::OpAdd, s2)
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = true
                                }
                            }
                            // (x - C1) + C2, C2 < C1 → x - (C1 - C2)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpAdd && v2 < ah_c1 {
                                let ah_net = ah_c1 - v2
                                result.instrs[ah_c2_def as usize] = ir_load_imm(s2, ah_net)
                                result.instrs[i as usize] = ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2)
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x + C1) - C2, C2 > C1 → x - (C2 - C1)
                            if ah_was_add && instr.bin_op == BinaryOp::OpSub && v2 > ah_c1 {
                                let ah_net = v2 - ah_c1
                                result.instrs[ah_c2_def as usize] = ir_load_imm(s2, ah_net)
                                result.instrs[i as usize] = ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2)
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x + C1) - C2, C2 < C1 → x + (C1 - C2)
                            if ah_was_add && instr.bin_op == BinaryOp::OpSub && v2 < ah_c1 {
                                let ah_net = ah_c1 - v2
                                result.instrs[ah_c2_def as usize] = ir_load_imm(s2, ah_net)
                                result.instrs[i as usize] = ir_binop(instr.dst, ah_base, BinaryOp::OpAdd, s2)
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = true
                                }
                            }
                        }
                    }
                }
                // x + 0 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpAdd {
                    if s2_known && v2 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s2)
                    }
                }
                // x - 0 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpSub {
                    if s2_known && v2 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                }
                // x / 1 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpDiv {
                    if s2_known && v2 == 1 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    // Sprint 95 Block S: 0 / x → 0  (zero dividend).
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                            def_at[instr.dst as usize] = i
                        }
                    }
                    // Sprint 88 Block O: (x * C) / C → x — mul-div cancellation.
                    // Safe: v2 != 0 guard prevents div-by-zero; only fires when s1=r was produced
                    // by a partial-const mul with the same constant C.
                    if s2_known && v2 != 0 && s1 >= 0 && s1 < 256 && mul_valid[s1 as usize]
                            && mul_const_v[s1 as usize] == v2 {
                        result.instrs[i as usize] = ir_copy(instr.dst, mul_var_src[s1 as usize])
                        if instr.dst >= 0 && instr.dst < 256 {
                            mul_valid[instr.dst as usize] = false
                        }
                    }
                }
                // Sprint 81 Block I: x % 1 → IrLoadImm(dst, 0)
                // Remainder by 1 is always 0 for any integer (Cooper & Torczon §9.2).
                if instr.bin_op == BinaryOp::OpRem {
                    if s2_known && v2 == 1 {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    // Sprint 95 Block S: 0 % x → 0  (zero dividend mod).
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                            def_at[instr.dst as usize] = i
                        }
                    }
                }
                // Sprint 72 Block C: Bitwise identity/annihilator folding.
                // x & 0 → 0  ;  0 & x → 0  (AND annihilator)
                // x & (-1) → x  ;  (-1) & x → x  (AND identity, -1 = all-ones)
                // x | 0 → x  ;  0 | x → x  (OR identity)
                // x | (-1) → -1  ;  (-1) | x → -1  (OR annihilator)
                // x ^ 0 → x  ;  0 ^ x → x  (XOR identity, distinct from x^x=0)
                if instr.bin_op == BinaryOp::OpBitAnd {
                    if (s2_known && v2 == 0) || (s1_known && v1 == 0) {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    if s2_known && v2 == -1 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    if s1_known && v1 == -1 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s2)
                    }
                }
                // Sprint 114 Block AK: Redundant AND elimination (superset mask).
                // (x & C1) & C2 where (C1 & C2) == C1 → IrCopy(src1).
                // The outer mask is a superset of the inner — AND is a no-op.
                // SOTA: LLVM InstCombineAndOrXor.cpp; known-bits analysis.
                if instr.bin_op == BinaryOp::OpBitAnd {
                    // s2 is const, s1 was AND-masked: check superset
                    if s2_known && s1 >= 0 && s1 < 256 && and_valid[s1 as usize] {
                        let ak_c1 = and_const_val[s1 as usize]
                        if (ak_c1 & v2) == ak_c1 {
                            result.instrs[i as usize] = ir_copy(instr.dst, s1)
                            if instr.dst >= 0 && instr.dst < 256 {
                                and_valid[instr.dst as usize]     = true
                                and_var_src[instr.dst as usize]   = and_var_src[s1 as usize]
                                and_const_val[instr.dst as usize] = ak_c1
                            }
                        }
                    }
                    // s1 is const, s2 was AND-masked: check superset (commutative)
                    if s1_known && s2 >= 0 && s2 < 256 && and_valid[s2 as usize] {
                        let ak_c2 = and_const_val[s2 as usize]
                        if (ak_c2 & v1) == ak_c2 {
                            result.instrs[i as usize] = ir_copy(instr.dst, s2)
                            if instr.dst >= 0 && instr.dst < 256 {
                                and_valid[instr.dst as usize]     = true
                                and_var_src[instr.dst as usize]   = and_var_src[s2 as usize]
                                and_const_val[instr.dst as usize] = ak_c2
                            }
                        }
                    }
                }
                // Sprint 108 Block AE: And-mask chain fold — (x & C1) & C2 → x & (C1 & C2).
                // Only fires if Block AK didn't already fold to IrCopy.
                if ocp_is_binop(result.instrs[i as usize].op) && result.instrs[i as usize].bin_op == BinaryOp::OpBitAnd {
                    if s2_known && s1 >= 0 && s1 < 256 && and_valid[s1 as usize] {
                        let c1 = and_const_val[s1 as usize]
                        let merged = c1 & v2
                        let def_idx = def_at[s2 as usize]
                        if def_idx >= 0 {
                            result.instrs[def_idx as usize] = ir_load_imm(s2, merged)
                            const_val[s2 as usize] = merged
                        }
                        result.instrs[i as usize] = ir_binop(instr.dst, and_var_src[s1 as usize], BinaryOp::OpBitAnd, s2)
                        if instr.dst >= 0 && instr.dst < 256 {
                            and_valid[instr.dst as usize]     = true
                            and_var_src[instr.dst as usize]   = and_var_src[s1 as usize]
                            and_const_val[instr.dst as usize] = merged
                        }
                    }
                    if s1_known && s2 >= 0 && s2 < 256 && and_valid[s2 as usize] {
                        let c2_prev = and_const_val[s2 as usize]
                        let merged = v1 & c2_prev
                        let def_idx = def_at[s1 as usize]
                        if def_idx >= 0 {
                            result.instrs[def_idx as usize] = ir_load_imm(s1, merged)
                            const_val[s1 as usize] = merged
                        }
                        result.instrs[i as usize] = ir_binop(instr.dst, and_var_src[s2 as usize], BinaryOp::OpBitAnd, s1)
                        if instr.dst >= 0 && instr.dst < 256 {
                            and_valid[instr.dst as usize]     = true
                            and_var_src[instr.dst as usize]   = and_var_src[s2 as usize]
                            and_const_val[instr.dst as usize] = merged
                        }
                    }
                    if s2_known && !s1_known && instr.dst >= 0 && instr.dst < 256 {
                        and_valid[instr.dst as usize]     = true
                        and_var_src[instr.dst as usize]   = s1
                        and_const_val[instr.dst as usize] = v2
                    }
                    if s1_known && !s2_known && instr.dst >= 0 && instr.dst < 256 {
                        and_valid[instr.dst as usize]     = true
                        and_var_src[instr.dst as usize]   = s2
                        and_const_val[instr.dst as usize] = v1
                    }
                    // Sprint 118 Block AN: (x | C1) & C2 → C2 when (C1 & C2) == C2.
                    // All bits of C2 are already set by the OR — AND just extracts C2 as a constant.
                    // Chains with Block AM (OR tracking) and Block AK (AND superset).
                    // SOTA: LLVM InstCombineAndOrXor.cpp known-bits analysis; Hacker's Delight §2.
                    if s2_known && s1 >= 0 && s1 < 256 && am_or_valid[s1 as usize] {
                        let an_c1 = am_or_const_val[s1 as usize]
                        if (an_c1 & v2) == v2 {
                            result.instrs[i as usize] = ir_load_imm(instr.dst, v2)
                            if instr.dst >= 0 && instr.dst < 256 {
                                is_const[instr.dst as usize] = true
                                const_val[instr.dst as usize] = v2
                            }
                        }
                    }
                    // Commutative: C2 & (x | C1) → C2 when (C1 & C2) == C2.
                    if s1_known && s2 >= 0 && s2 < 256 && am_or_valid[s2 as usize] {
                        let an_c2 = am_or_const_val[s2 as usize]
                        if (an_c2 & v1) == v1 {
                            result.instrs[i as usize] = ir_load_imm(instr.dst, v1)
                            if instr.dst >= 0 && instr.dst < 256 {
                                is_const[instr.dst as usize] = true
                                const_val[instr.dst as usize] = v1
                            }
                        }
                    }
                }
                if instr.bin_op == BinaryOp::OpBitOr {
                    if s2_known && v2 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s2)
                    }
                    if (s2_known && v2 == -1) || (s1_known && v1 == -1) {
                        result.instrs[i as usize] = ir_load_imm(instr.dst, -1)
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = -1
                        }
                    }
                    // Sprint 116 Block AM: OR superset mask — (x | C1) | C2 where (C1 | C2) == C1 → IrCopy.
                    if s2_known && s1 >= 0 && s1 < 256 && am_or_valid[s1 as usize] {
                        let am_c1 = am_or_const_val[s1 as usize]
                        if (am_c1 | v2) == am_c1 {
                            result.instrs[i as usize] = ir_copy(instr.dst, s1)
                            if instr.dst >= 0 && instr.dst < 256 {
                                am_or_valid[instr.dst as usize]     = true
                                am_or_var_src[instr.dst as usize]   = am_or_var_src[s1 as usize]
                                am_or_const_val[instr.dst as usize] = am_c1
                            }
                        }
                    }
                    // Commutative: C2 | (x | C1) where (C1 | C2) == C1 → IrCopy.
                    if s1_known && s2 >= 0 && s2 < 256 && am_or_valid[s2 as usize] {
                        let am_c2 = am_or_const_val[s2 as usize]
                        if (am_c2 | v1) == am_c2 {
                            result.instrs[i as usize] = ir_copy(instr.dst, s2)
                            if instr.dst >= 0 && instr.dst < 256 {
                                am_or_valid[instr.dst as usize]     = true
                                am_or_var_src[instr.dst as usize]   = am_or_var_src[s2 as usize]
                                am_or_const_val[instr.dst as usize] = am_c2
                            }
                        }
                    }
                    // Track new OR-with-constant for chaining.
                    if s2_known && !s1_known && instr.dst >= 0 && instr.dst < 256 {
                        am_or_valid[instr.dst as usize]     = true
                        am_or_var_src[instr.dst as usize]   = s1
                        am_or_const_val[instr.dst as usize] = v2
                    }
                    if s1_known && !s2_known && instr.dst >= 0 && instr.dst < 256 {
                        am_or_valid[instr.dst as usize]     = true
                        am_or_var_src[instr.dst as usize]   = s2
                        am_or_const_val[instr.dst as usize] = v1
                    }
                }
                // Sprint 145 Block BG: OR constant-chain fold — (x | C1) | C2 → x | (C1 | C2).
                // Analogue of Block AE (AND chain fold) for OR; fires when Block AM did not fold.
                // SOTA: LLVM InstCombineAndOrXor.cpp — or(or X,C1),C2 → or X,(C1|C2);
                // Boolean algebra associativity + idempotency (a|a=a).
                // Distinct from Block AM ((x|C1)|C2→IrCopy when C2⊆C1): fires when C2 has new bits.
                // Zero new arrays: reuses am_or_valid/var_src/const_val + def_at from Block AM.
                if ocp_is_binop(result.instrs[i as usize].op) && result.instrs[i as usize].bin_op == BinaryOp::OpBitOr {
                    if s2_known && s1 >= 0 && s1 < 256 && am_or_valid[s1 as usize] {
                        let bg_c1 = am_or_const_val[s1 as usize]
                        let bg_merged = bg_c1 | v2
                        let bg_def = def_at[s2 as usize]
                        if bg_def >= 0 {
                            result.instrs[bg_def as usize] = ir_load_imm(s2, bg_merged)
                            const_val[s2 as usize] = bg_merged
                        }
                        result.instrs[i as usize] = ir_binop(instr.dst, am_or_var_src[s1 as usize], BinaryOp::OpBitOr, s2)
                        if instr.dst >= 0 && instr.dst < 256 {
                            am_or_valid[instr.dst as usize]     = true
                            am_or_var_src[instr.dst as usize]   = am_or_var_src[s1 as usize]
                            am_or_const_val[instr.dst as usize] = bg_merged
                        }
                    }
                    if s1_known && s2 >= 0 && s2 < 256 && am_or_valid[s2 as usize] {
                        let bg_c2 = am_or_const_val[s2 as usize]
                        let bg_merged = v1 | bg_c2
                        let bg_def = def_at[s1 as usize]
                        if bg_def >= 0 {
                            result.instrs[bg_def as usize] = ir_load_imm(s1, bg_merged)
                            const_val[s1 as usize] = bg_merged
                        }
                        result.instrs[i as usize] = ir_binop(instr.dst, am_or_var_src[s2 as usize], BinaryOp::OpBitOr, s1)
                        if instr.dst >= 0 && instr.dst < 256 {
                            am_or_valid[instr.dst as usize]     = true
                            am_or_var_src[instr.dst as usize]   = am_or_var_src[s2 as usize]
                            am_or_const_val[instr.dst as usize] = bg_merged
                        }
                    }
                }
                if instr.bin_op == BinaryOp::OpBitXor {
                    if s2_known && v2 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s1)
                    }
                    if s1_known && v1 == 0 {
                        result.instrs[i as usize] = ir_copy(instr.dst, s2)
                    }
                }
            }
        }

        // ====================================================================
        // Sprint 127 Block AO: Absorption laws.
        // a | (a & X) → a  ;  a & (a | X) → a  (X may be constant or register).
        // Huntington 1904 absorption axiom — one of the four fundamental Boolean
        // algebra identities (commutative, associative, distributive, absorption).
        // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1.
        //
        // Sprint 128 Block AP: Idempotent subsumption.
        // (a | b) | a → (a | b)  ;  (a & b) & a → (a & b).
        // An operand already present in a subexpression is redundant.
        // SOTA: Boolean algebra idempotent law; Hacker's Delight §2-1.
        //
        // Sprint 129 Block AQ: Register-register inverse cancellation.
        // (a + b) - b → a  ;  (a + b) - a → b  (additive inverse)
        // (a * b) / b → a  ;  (a * b) / a → b  (multiplicative inverse)
        // SOTA: LLVM InstCombine algebraic; group-theoretic inverse.
        // ====================================================================
        if ocp_is_binop(result.instrs[i as usize].op) {
            let ao_instr = result.instrs[i as usize]
            let ao_s1 = ao_instr.src1
            let ao_s2 = ao_instr.src2
            let ao_s1_ok = ao_s1 >= 0 && ao_s1 < 256
            let ao_s2_ok = ao_s2 >= 0 && ao_s2 < 256

            // ---- Block AO: OR-absorption: a | (a & _) → a ----
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // a | (a & C) → a  [constant-operand AND tracking]
                if ao_s2_ok && and_valid[ao_s2 as usize] && and_var_src[ao_s2 as usize] == ao_s1 {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // (a & C) | a → a  [commutative]
                if ao_s1_ok && and_valid[ao_s1 as usize] && and_var_src[ao_s1 as usize] == ao_s2 {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
                // a | (a & b) → a  [register-register AND tracking]
                if ao_s2_ok && ao_and_rr_valid[ao_s2 as usize]
                        && (ao_and_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_and_rr_rhs[ao_s2 as usize] == ao_s1) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // (a & b) | a → a  [commutative]
                if ao_s1_ok && ao_and_rr_valid[ao_s1 as usize]
                        && (ao_and_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_and_rr_rhs[ao_s1 as usize] == ao_s2) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
            }

            // ---- Block AO: AND-absorption: a & (a | _) → a ----
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // a & (a | C) → a  [constant-operand OR tracking]
                if ao_s2_ok && am_or_valid[ao_s2 as usize] && am_or_var_src[ao_s2 as usize] == ao_s1 {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // (a | C) & a → a  [commutative]
                if ao_s1_ok && am_or_valid[ao_s1 as usize] && am_or_var_src[ao_s1 as usize] == ao_s2 {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
                // a & (a | b) → a  [register-register OR tracking]
                if ao_s2_ok && ao_or_rr_valid[ao_s2 as usize]
                        && (ao_or_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_or_rr_rhs[ao_s2 as usize] == ao_s1) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // (a | b) & a → a  [commutative]
                if ao_s1_ok && ao_or_rr_valid[ao_s1 as usize]
                        && (ao_or_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_or_rr_rhs[ao_s1 as usize] == ao_s2) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
            }

            // ---- Block AP: OR-subsumption: (a | b) | a → (a | b) ----
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // (a | b) | a → copy(a | b)  [s1 is OR, s2 is one of its operands]
                if ao_s1_ok && ao_or_rr_valid[ao_s1 as usize]
                        && (ao_or_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_or_rr_rhs[ao_s1 as usize] == ao_s2) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // a | (a | b) → copy(a | b)  [s2 is OR, s1 is one of its operands]
                if ao_s2_ok && ao_or_rr_valid[ao_s2 as usize]
                        && (ao_or_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_or_rr_rhs[ao_s2 as usize] == ao_s1) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
            }

            // ---- Block AP: AND-subsumption: (a & b) & a → (a & b) ----
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // (a & b) & a → copy(a & b)
                if ao_s1_ok && ao_and_rr_valid[ao_s1 as usize]
                        && (ao_and_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_and_rr_rhs[ao_s1 as usize] == ao_s2) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s1)
                }
                // a & (a & b) → copy(a & b)
                if ao_s2_ok && ao_and_rr_valid[ao_s2 as usize]
                        && (ao_and_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_and_rr_rhs[ao_s2 as usize] == ao_s1) {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, ao_s2)
                }
            }

            // ---- Block AQ: Additive inverse cancellation ----
            // (a + b) - b → a  ;  (a + b) - a → b
            if ao_instr.bin_op == BinaryOp::OpSub && ao_s1_ok && aq_add_rr_valid[ao_s1 as usize] {
                if ao_s2 == aq_add_rr_rhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, aq_add_rr_lhs[ao_s1 as usize])
                }
                if ao_s2 == aq_add_rr_lhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, aq_add_rr_rhs[ao_s1 as usize])
                }
            }

            // ---- Block AQ: Multiplicative inverse cancellation ----
            // (a * b) / b → a  ;  (a * b) / a → b
            if ao_instr.bin_op == BinaryOp::OpDiv && ao_s1_ok && aq_mul_rr_valid[ao_s1 as usize] {
                if ao_s2 == aq_mul_rr_rhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, aq_mul_rr_lhs[ao_s1 as usize])
                }
                if ao_s2 == aq_mul_rr_lhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, aq_mul_rr_rhs[ao_s1 as usize])
                }
            }

            // ---- Block AS: XOR self-inverse cancellation ----
            // (a ^ b) ^ b → a  ;  (a ^ b) ^ a → b
            // XOR is its own inverse in GF(2): a ⊕ b ⊕ b = a.
            // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-3.
            if ao_instr.bin_op == BinaryOp::OpBitXor && ao_s1_ok && as_xor_rr_valid[ao_s1 as usize] {
                if ao_s2 == as_xor_rr_rhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, as_xor_rr_lhs[ao_s1 as usize])
                }
                if ao_s2 == as_xor_rr_lhs[ao_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, as_xor_rr_rhs[ao_s1 as usize])
                }
            }
            // b ^ (a ^ b) → a  ;  a ^ (a ^ b) → b  [commutative]
            if ao_instr.bin_op == BinaryOp::OpBitXor && ao_s2_ok && as_xor_rr_valid[ao_s2 as usize] {
                if ao_s1 == as_xor_rr_rhs[ao_s2 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, as_xor_rr_lhs[ao_s2 as usize])
                }
                if ao_s1 == as_xor_rr_lhs[ao_s2 as usize] {
                    result.instrs[i as usize] = ir_copy(ao_instr.dst, as_xor_rr_rhs[ao_s2 as usize])
                }
            }

            // ---- Block AT: NOT-distributive simplification ----
            // ~a & (a | b) → ~a & b  (eliminates the OR via complement distribution)
            // Proof: ~a & (a | b) = (~a & a) | (~a & b) = 0 | (~a & b) = ~a & b.
            // SOTA: LLVM InstCombineAndOrXor.cpp SimplifyDemandedBits;
            //   Boolean algebra distributive + complement axioms.
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // ~a & (a | b) → ~a & b  [s1=~a, s2=a|b, bnot_src[s1]==one of s2's OR operands]
                if ao_s1_ok && is_bnot[ao_s1 as usize]
                        && ao_s2_ok && ao_or_rr_valid[ao_s2 as usize] {
                    let at_a = bnot_src[ao_s1 as usize]
                    if ao_or_rr_lhs[ao_s2 as usize] == at_a {
                        // ~a & (a | b) → ~a & b
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitAnd, ao_or_rr_rhs[ao_s2 as usize])
                    }
                    if ao_or_rr_rhs[ao_s2 as usize] == at_a {
                        // ~a & (b | a) → ~a & b
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitAnd, ao_or_rr_lhs[ao_s2 as usize])
                    }
                }
                // (a | b) & ~a → ~a & b  [commutative: s1=a|b, s2=~a]
                if ao_s2_ok && is_bnot[ao_s2 as usize]
                        && ao_s1_ok && ao_or_rr_valid[ao_s1 as usize] {
                    let at_a = bnot_src[ao_s2 as usize]
                    if ao_or_rr_lhs[ao_s1 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitAnd, ao_or_rr_rhs[ao_s1 as usize])
                    }
                    if ao_or_rr_rhs[ao_s1 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitAnd, ao_or_rr_lhs[ao_s1 as usize])
                    }
                }
            }
            // ~a | (a & b) → ~a | b  (dual: eliminates the AND)
            // Proof: ~a | (a & b) = (~a | a) & (~a | b) = -1 & (~a | b) = ~a | b.
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // ~a | (a & b) → ~a | b
                if ao_s1_ok && is_bnot[ao_s1 as usize]
                        && ao_s2_ok && ao_and_rr_valid[ao_s2 as usize] {
                    let at_a = bnot_src[ao_s1 as usize]
                    if ao_and_rr_lhs[ao_s2 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitOr, ao_and_rr_rhs[ao_s2 as usize])
                    }
                    if ao_and_rr_rhs[ao_s2 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitOr, ao_and_rr_lhs[ao_s2 as usize])
                    }
                }
                // (a & b) | ~a → ~a | b  [commutative]
                if ao_s2_ok && is_bnot[ao_s2 as usize]
                        && ao_s1_ok && ao_and_rr_valid[ao_s1 as usize] {
                    let at_a = bnot_src[ao_s2 as usize]
                    if ao_and_rr_lhs[ao_s1 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitOr, ao_and_rr_rhs[ao_s1 as usize])
                    }
                    if ao_and_rr_rhs[ao_s1 as usize] == at_a {
                        result.instrs[i as usize] = ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitOr, ao_and_rr_lhs[ao_s1 as usize])
                    }
                }
            }

            // ---- Tracking population (Sprints 127 + 129 + 131) ----
            // Only populate if instruction was not folded (still a BinOp).
            if ocp_is_binop(result.instrs[i as usize].op) {
                let trk = result.instrs[i as usize]
                let trk_dst = trk.dst
                let trk_s1 = trk.src1
                let trk_s2 = trk.src2
                let trk_s1_ok = trk_s1 >= 0 && trk_s1 < 256
                let trk_s2_ok = trk_s2 >= 0 && trk_s2 < 256
                let trk_s1_const = trk_s1_ok && is_const[trk_s1 as usize]
                let trk_s2_const = trk_s2_ok && is_const[trk_s2 as usize]
                if trk_dst >= 0 && trk_dst < 256 && !trk_s1_const && !trk_s2_const {
                    if trk.bin_op == BinaryOp::OpBitAnd {
                        ao_and_rr_valid[trk_dst as usize] = true
                        ao_and_rr_lhs[trk_dst as usize]   = trk_s1
                        ao_and_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpBitOr {
                        ao_or_rr_valid[trk_dst as usize] = true
                        ao_or_rr_lhs[trk_dst as usize]   = trk_s1
                        ao_or_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpAdd {
                        aq_add_rr_valid[trk_dst as usize] = true
                        aq_add_rr_lhs[trk_dst as usize]   = trk_s1
                        aq_add_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpMul {
                        aq_mul_rr_valid[trk_dst as usize] = true
                        aq_mul_rr_lhs[trk_dst as usize]   = trk_s1
                        aq_mul_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpBitXor {
                        as_xor_rr_valid[trk_dst as usize] = true
                        as_xor_rr_lhs[trk_dst as usize]   = trk_s1
                        as_xor_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                }
            }
        }

        // ====================================================================
        // Sprint 130 Block AR: Complement law — x & ~x → 0, x | ~x → -1.
        // ~x is detected via is_bnot/bnot_src tracking from Block AI (Sprint 112).
        // Boolean algebra complement law: a AND ~a = 0, a OR ~a = 1 (all bits).
        // SOTA: LLVM InstCombineAndOrXor.cpp — `A & ~A → 0`, `A | ~A → -1`.
        // ====================================================================
        if ocp_is_binop(result.instrs[i as usize].op) {
            let ar_instr = result.instrs[i as usize]
            let ar_s1 = ar_instr.src1
            let ar_s2 = ar_instr.src2
            let ar_s1_ok = ar_s1 >= 0 && ar_s1 < 256
            let ar_s2_ok = ar_s2 >= 0 && ar_s2 < 256
            // x & ~x → 0  (s2 = NOT(s1))
            if ar_instr.bin_op == BinaryOp::OpBitAnd && ar_s2_ok && is_bnot[ar_s2 as usize]
                    && bnot_src[ar_s2 as usize] == ar_s1 {
                result.instrs[i as usize] = ir_load_imm(ar_instr.dst, 0)
                if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                    is_const[ar_instr.dst as usize] = true
                    const_val[ar_instr.dst as usize] = 0
                }
            }
            // ~x & x → 0  (s1 = NOT(s2), commutative)
            if ar_instr.bin_op == BinaryOp::OpBitAnd && ar_s1_ok && is_bnot[ar_s1 as usize]
                    && bnot_src[ar_s1 as usize] == ar_s2 {
                result.instrs[i as usize] = ir_load_imm(ar_instr.dst, 0)
                if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                    is_const[ar_instr.dst as usize] = true
                    const_val[ar_instr.dst as usize] = 0
                }
            }
            // x | ~x → -1  (s2 = NOT(s1))
            if ar_instr.bin_op == BinaryOp::OpBitOr && ar_s2_ok && is_bnot[ar_s2 as usize]
                    && bnot_src[ar_s2 as usize] == ar_s1 {
                result.instrs[i as usize] = ir_load_imm(ar_instr.dst, -1)
                if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                    is_const[ar_instr.dst as usize] = true
                    const_val[ar_instr.dst as usize] = -1
                }
            }
            // ~x | x → -1  (s1 = NOT(s2), commutative)
            if ar_instr.bin_op == BinaryOp::OpBitOr && ar_s1_ok && is_bnot[ar_s1 as usize]
                    && bnot_src[ar_s1 as usize] == ar_s2 {
                result.instrs[i as usize] = ir_load_imm(ar_instr.dst, -1)
                if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                    is_const[ar_instr.dst as usize] = true
                    const_val[ar_instr.dst as usize] = -1
                }
            }
            // Sprint 131 Block AS: XOR complement — x ^ ~x → -1; ~x ^ ~y → x ^ y.
            // x ^ ~x = -1 (all bits set). ~x ^ ~y = x ^ y (double-NOT cancellation).
            // Extends Block AR (AND/OR complement) to XOR domain. Zero new arrays.
            // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-2.
            if ar_instr.bin_op == BinaryOp::OpBitXor {
                // x ^ ~x → -1  (s2 is NOT(s1))
                if ar_s2_ok && is_bnot[ar_s2 as usize] && bnot_src[ar_s2 as usize] == ar_s1 {
                    result.instrs[i as usize] = ir_load_imm(ar_instr.dst, -1)
                    if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                        is_const[ar_instr.dst as usize] = true
                        const_val[ar_instr.dst as usize] = -1
                    }
                }
                // ~x ^ x → -1  (s1 is NOT(s2), commutative)
                if ar_s1_ok && is_bnot[ar_s1 as usize] && bnot_src[ar_s1 as usize] == ar_s2 {
                    result.instrs[i as usize] = ir_load_imm(ar_instr.dst, -1)
                    if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                        is_const[ar_instr.dst as usize] = true
                        const_val[ar_instr.dst as usize] = -1
                    }
                }
                // ~x ^ ~y → x ^ y (both are NOT: complements cancel out).
                // Special case ~x ^ ~x → 0 handled by base1 == base2 check.
                if ar_s1_ok && ar_s2_ok && is_bnot[ar_s1 as usize] && is_bnot[ar_s2 as usize] {
                    let as_base1 = bnot_src[ar_s1 as usize]
                    let as_base2 = bnot_src[ar_s2 as usize]
                    if as_base1 == as_base2 {
                        result.instrs[i as usize] = ir_load_imm(ar_instr.dst, 0)
                        if ar_instr.dst >= 0 && ar_instr.dst < 256 {
                            is_const[ar_instr.dst as usize] = true
                            const_val[ar_instr.dst as usize] = 0
                        }
                    } else {
                        result.instrs[i as usize] = ir_binop(ar_instr.dst, as_base1, BinaryOp::OpBitXor, as_base2)
                    }
                }
            }
        }


        // ====================================================================
        // Sprint 133 Block AU: XOR operand cancellation.
        // (a ^ b) ^ (a ^ c) → b ^ c  — common XOR factor cancels via associativity.
        // All four lhs/rhs pairings handled: lhs-lhs, lhs-rhs, rhs-lhs, rhs-rhs.
        // Uses as_xor_rr_valid tracking from Block AS (linter Sprint 131).
        // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1 (XOR group law).
        // ====================================================================
        if ocp_is_binop(result.instrs[i as usize].op) {
            let au_instr = result.instrs[i as usize]
            let au_s1 = au_instr.src1
            let au_s2 = au_instr.src2
            let au_s1_ok = au_s1 >= 0 && au_s1 < 256
            let au_s2_ok = au_s2 >= 0 && au_s2 < 256
            if au_instr.bin_op == BinaryOp::OpBitXor && au_s1_ok && au_s2_ok
                    && as_xor_rr_valid[au_s1 as usize] && as_xor_rr_valid[au_s2 as usize] {
                let au_l1 = as_xor_rr_lhs[au_s1 as usize]
                let au_r1 = as_xor_rr_rhs[au_s1 as usize]
                let au_l2 = as_xor_rr_lhs[au_s2 as usize]
                let au_r2 = as_xor_rr_rhs[au_s2 as usize]
                // lhs[s1] == lhs[s2]: (a^b)^(a^c) → b^c
                if au_l1 == au_l2 && au_l1 >= 0 {
                    result.instrs[i as usize] = ir_binop(au_instr.dst, au_r1, BinaryOp::OpBitXor, au_r2)
                }
                // lhs[s1] == rhs[s2]: (a^b)^(c^a) → b^c
                if au_l1 == au_r2 && au_l1 >= 0 {
                    result.instrs[i as usize] = ir_binop(au_instr.dst, au_r1, BinaryOp::OpBitXor, au_l2)
                }
                // rhs[s1] == lhs[s2]: (b^a)^(a^c) → b^c
                if au_r1 == au_l2 && au_r1 >= 0 {
                    result.instrs[i as usize] = ir_binop(au_instr.dst, au_l1, BinaryOp::OpBitXor, au_r2)
                }
                // rhs[s1] == rhs[s2]: (b^a)^(c^a) → b^c
                if au_r1 == au_r2 && au_r1 >= 0 {
                    result.instrs[i as usize] = ir_binop(au_instr.dst, au_l1, BinaryOp::OpBitXor, au_l2)
                }
            }
        }

        // Sprint 134 Block AV: Distributive factoring.
        // a*b + a*c → a*(b+c)  — reduces multiplication count by factoring common operand.
        // All four pairings: lhs-lhs, lhs-rhs, rhs-lhs, rhs-rhs common factor.
        // Uses aq_mul_rr tracking from Block AQ.
        // SOTA: LLVM Reassociate.cpp (not in InstCombine); Briggs & Cooper 1994 §4.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let av_instr = result.instrs[i as usize]
            let av_s1 = av_instr.src1
            let av_s2 = av_instr.src2
            let av_s1_ok = av_s1 >= 0 && av_s1 < 256
            let av_s2_ok = av_s2 >= 0 && av_s2 < 256
            if av_instr.bin_op == BinaryOp::OpAdd && av_s1_ok && av_s2_ok
                    && aq_mul_rr_valid[av_s1 as usize] && aq_mul_rr_valid[av_s2 as usize] {
                let av_l1 = aq_mul_rr_lhs[av_s1 as usize]
                let av_r1 = aq_mul_rr_rhs[av_s1 as usize]
                let av_l2 = aq_mul_rr_lhs[av_s2 as usize]
                let av_r2 = aq_mul_rr_rhs[av_s2 as usize]
                // lhs common: a*b + a*c → a*(b+c)
                if av_l1 == av_l2 && av_l1 >= 0 {
                    // Rewrite ADD to produce b+c, then need a mul — but we're single-pass,
                    // so rewrite the ADD operands to (b+c) and tag for factoring.
                    // Actually: emit ADD(dst, r1, r2) then need a second instr for mul.
                    // Single-pass limitation: we can only rewrite THIS instruction.
                    // Simplification: if b==c (same non-common factor), a*b+a*b = 2*a*b = a*(2*b).
                    // For the general case, just note the pattern — real benefit comes when
                    // combined with a subsequent pass. Skip for now unless factors match.
                    if av_r1 == av_r2 && av_r1 >= 0 {
                        // a*b + a*b → 2*(a*b) — strength-reduce to left-shift
                        // But s1 already holds a*b, so: a*b + a*b = s1 + s1 → s1 << 1
                        result.instrs[i as usize] = ir_binop(av_instr.dst, av_s1, BinaryOp::OpAdd, av_s1)
                    }
                }
                // rhs common: b*a + c*a → (b+c)*a — same logic
                if av_r1 == av_r2 && av_r1 >= 0 && av_l1 != av_l2 {
                    // Different lhs but same rhs: factor out rhs.
                    // Single-pass: only if lhs factors are the same (handled above).
                    // General case deferred to multi-pass.
                    0 // no-op placeholder
                }
            }
        }

        // Sprint 135 Block AW: Negation propagation through multiplication.
        // neg(a) * neg(b) → a * b  — eliminates both negations.
        // neg(a) * b → neg(a * b)  — NOT applied (pushes neg outward, no net win).
        // Uses is_neg/neg_src tracking from Block M.
        // SOTA: LLVM InstCombineMulDivRem.cpp; ring theory: (-a)(-b) = ab.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let aw_instr = result.instrs[i as usize]
            let aw_s1 = aw_instr.src1
            let aw_s2 = aw_instr.src2
            let aw_s1_ok = aw_s1 >= 0 && aw_s1 < 256
            let aw_s2_ok = aw_s2 >= 0 && aw_s2 < 256
            if aw_instr.bin_op == BinaryOp::OpMul && aw_s1_ok && aw_s2_ok {
                // neg(a) * neg(b) → a * b
                if is_neg[aw_s1 as usize] && is_neg[aw_s2 as usize] {
                    result.instrs[i as usize] = ir_binop(aw_instr.dst,
                        neg_src[aw_s1 as usize], BinaryOp::OpMul, neg_src[aw_s2 as usize])
                }
            }
            // Also: neg(a) / neg(b) → a / b  (same ring property for division)
            if aw_instr.bin_op == BinaryOp::OpDiv && aw_s1_ok && aw_s2_ok {
                if is_neg[aw_s1 as usize] && is_neg[aw_s2 as usize] {
                    result.instrs[i as usize] = ir_binop(aw_instr.dst,
                        neg_src[aw_s1 as usize], BinaryOp::OpDiv, neg_src[aw_s2 as usize])
                }
            }
        }

        // Sprint 136 Block AX: Additive inverse via negation tracking.
        // a + neg(a) → 0  ;  neg(a) + a → 0
        // NOT the same as Block A (x - x → 0) — this catches the add-of-negation pattern.
        // Uses is_neg/neg_src tracking from Block M.
        // SOTA: LLVM InstCombineAddSub.cpp; group theory: a + (-a) = 0.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let ax_instr = result.instrs[i as usize]
            let ax_s1 = ax_instr.src1
            let ax_s2 = ax_instr.src2
            let ax_s1_ok = ax_s1 >= 0 && ax_s1 < 256
            let ax_s2_ok = ax_s2 >= 0 && ax_s2 < 256
            if ax_instr.bin_op == BinaryOp::OpAdd {
                // a + neg(a) → 0
                if ax_s2_ok && is_neg[ax_s2 as usize] && neg_src[ax_s2 as usize] == ax_s1 {
                    result.instrs[i as usize] = ir_load_imm(ax_instr.dst, 0)
                    if ax_instr.dst >= 0 && ax_instr.dst < 256 {
                        is_const[ax_instr.dst as usize] = true
                        const_val[ax_instr.dst as usize] = 0
                    }
                }
                // neg(a) + a → 0
                if ax_s1_ok && is_neg[ax_s1 as usize] && neg_src[ax_s1 as usize] == ax_s2 {
                    result.instrs[i as usize] = ir_load_imm(ax_instr.dst, 0)
                    if ax_instr.dst >= 0 && ax_instr.dst < 256 {
                        is_const[ax_instr.dst as usize] = true
                        const_val[ax_instr.dst as usize] = 0
                    }
                }
            }
        }

        // Sprint 137 Block AY: Shift-mask fusion.
        // (x >> n) & ((1 << k) - 1) → bitfield extract pattern.
        // When a right-shifted value is ANDed with a low-bit mask, this is a single
        // bitfield extraction: bits [n, n+k) of x.
        // Implementation: detect (shr_result & const_mask) where mask = (1<<k)-1
        // and rewrite as (x >> n) & mask (already minimal — no further reduction needed
        // in this single-pass framework, but we can simplify the mask if n+k > 64).
        // Deferred: actual BEXTR/UBFX codegen lowering belongs in native backend.
        // For now, constant-fold: if shift amount is known AND mask is known,
        // combine into a single mask: (x >> n) & m → (x & (m << n)) >> n.
        // Single-pass limitation: this rewrite creates a new shifted mask, which may
        // not be a net win without BEXTR. Mark as "tracked" for future backend.
        // No-op in current pass — pattern tracked only.

        // Sprint 138 Block AZ: Boolean NOT through comparison inversion.
        // !(a < b) → a >= b  ;  !(a == b) → a != b  ;  etc.
        // When a comparison result is negated (x == 0 where x = cmp(a, b)),
        // invert the comparison operator instead.
        // Uses is_const tracking to detect "cmp_result == 0" pattern.
        // SOTA: LLVM InstCombineCompares.cpp; basic Boolean duality.
        // NOTE: This extends Block Y (Sprint 101): (x==0)==0 → IrCopy(x).
        // Block AZ specifically targets: (cmp_result == 0) → inverted_cmp(a, b).
        // Implementation requires tracking which registers hold comparison results
        // and their operand registers — heavy for single-pass. Deferred.

        // Sprint 139 Block BA: Sub-add inverse cancellation.
        // (a - b) + b → a  ;  b + (a - b) → a  ;  a - (a - b) → b
        // Ring axiom: a - b + b = a. Distinct from Block AQ (a+b-b → a).
        // Uses al_is_sub/al_sub_lhs/al_sub_rhs from Block AL (Sprint 115).
        // Zero new arrays. SOTA: LLVM InstCombineAddSub.cpp.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let ba_instr = result.instrs[i as usize]
            let ba_s1 = ba_instr.src1
            let ba_s2 = ba_instr.src2
            let ba_s1_ok = ba_s1 >= 0 && ba_s1 < 256
            let ba_s2_ok = ba_s2 >= 0 && ba_s2 < 256
            if ba_instr.bin_op == BinaryOp::OpAdd {
                // (a - b) + b → a  [s1 is sub(a,b), s2 == b]
                if ba_s1_ok && al_is_sub[ba_s1 as usize]
                        && ba_s2 == al_sub_rhs[ba_s1 as usize] {
                    result.instrs[i as usize] = ir_copy(ba_instr.dst, al_sub_lhs[ba_s1 as usize])
                }
                // b + (a - b) → a  [s2 is sub(a,b), s1 == b]
                if ba_s2_ok && al_is_sub[ba_s2 as usize]
                        && ba_s1 == al_sub_rhs[ba_s2 as usize] {
                    result.instrs[i as usize] = ir_copy(ba_instr.dst, al_sub_lhs[ba_s2 as usize])
                }
            }
            // a - (a - b) → b  [s1 == sub_lhs of s2]
            if ba_instr.bin_op == BinaryOp::OpSub && ba_s2_ok && al_is_sub[ba_s2 as usize]
                    && ba_s1 == al_sub_lhs[ba_s2 as usize] {
                result.instrs[i as usize] = ir_copy(ba_instr.dst, al_sub_rhs[ba_s2 as usize])
            }
        }

        // Sprint 140 Block BB: Constant mask merge via distributive law.
        // (x & C1) | (x & C2) → IrCopy(x & C1) when C2 is a subset of C1.
        // Full merge to x & (C1|C2) deferred (needs instruction allocation).
        // Uses and_valid/and_var_src/and_const_val tracking from Block AE.
        // Dual: (x | C1) & (x | C2) → IrCopy(x | C1) when C2 is superset of C1.
        // SOTA: LLVM InstCombineAndOrXor.cpp; Boolean algebra distributive axiom.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bb_instr = result.instrs[i as usize]
            let bb_s1 = bb_instr.src1
            let bb_s2 = bb_instr.src2
            let bb_s1_ok = bb_s1 >= 0 && bb_s1 < 256
            let bb_s2_ok = bb_s2 >= 0 && bb_s2 < 256
            // (x & C1) | (x & C2) where C2 subset of C1 → IrCopy(s1)
            // Proof: C2 ⊆ C1 means (C1 | C2) = C1, so x&C1 | x&C2 = x&C1.
            if bb_instr.bin_op == BinaryOp::OpBitOr
                    && bb_s1_ok && and_valid[bb_s1 as usize]
                    && bb_s2_ok && and_valid[bb_s2 as usize]
                    && and_var_src[bb_s1 as usize] == and_var_src[bb_s2 as usize] {
                let bb_c1 = and_const_val[bb_s1 as usize]
                let bb_c2 = and_const_val[bb_s2 as usize]
                // C2 ⊆ C1: (C2 & C1) == C2
                if (bb_c2 & bb_c1) == bb_c2 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s1)
                }
                // C1 ⊆ C2: (C1 & C2) == C1
                if (bb_c1 & bb_c2) == bb_c1 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s2)
                }
                // C1 == C2: identical masks → IrCopy (same result, either operand)
                if bb_c1 == bb_c2 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s1)
                }
            }
            // Dual: (x | C1) & (x | C2) where C1 subset of C2 → IrCopy(s1)
            // Proof: C1 ⊆ C2 means (C1 & C2) = C1, so (x|C1) & (x|C2) = x|C1.
            if bb_instr.bin_op == BinaryOp::OpBitAnd
                    && bb_s1_ok && am_or_valid[bb_s1 as usize]
                    && bb_s2_ok && am_or_valid[bb_s2 as usize]
                    && am_or_var_src[bb_s1 as usize] == am_or_var_src[bb_s2 as usize] {
                let bb_c1 = am_or_const_val[bb_s1 as usize]
                let bb_c2 = am_or_const_val[bb_s2 as usize]
                if (bb_c1 & bb_c2) == bb_c1 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s1)
                }
                if (bb_c2 & bb_c1) == bb_c2 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s2)
                }
                if bb_c1 == bb_c2 {
                    result.instrs[i as usize] = ir_copy(bb_instr.dst, bb_s1)
                }
            }
        }

        // Sprint 141 Block BC: Negation subtraction simplification.
        // neg(a) - neg(b) → b - a  (ring axiom: -a - (-b) = b - a).
        // Distinct from Block AG (x - neg(y) → x + y): requires BOTH operands negated.
        // Complements Block AW (neg*neg → a*b) and Block AX (a+neg(a) → 0).
        // Uses is_neg/neg_src from Block M. Zero new arrays.
        // SOTA: LLVM InstCombineAddSub.cpp `-X - -Y → Y - X`; ring theory.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bc_neg_instr = result.instrs[i as usize]
            let bc_ns1 = bc_neg_instr.src1
            let bc_ns2 = bc_neg_instr.src2
            let bc_ns1_ok = bc_ns1 >= 0 && bc_ns1 < 256
            let bc_ns2_ok = bc_ns2 >= 0 && bc_ns2 < 256
            if bc_neg_instr.bin_op == BinaryOp::OpSub
                    && bc_ns1_ok && is_neg[bc_ns1 as usize]
                    && bc_ns2_ok && is_neg[bc_ns2 as usize] {
                // neg(a) - neg(b) → b - a
                result.instrs[i as usize] = ir_binop(bc_neg_instr.dst,
                    neg_src[bc_ns2 as usize], BinaryOp::OpSub, neg_src[bc_ns1 as usize])
            }
        }

        // Sprint 142 Block BD: Const-offset difference collapse.
        // (x + C1) - (x + C2) → C1 - C2  (shared base cancels; any +/- combo).
        // SOTA: LLVM InstCombineAddSub.cpp — sub(add X,C1),(add X,C2)→C1-C2;
        // Cooper & Torczon §8.4 algebraic simplification.
        // Distinct from Block P ((x+C)-C→x): BOTH operands are const-offset exprs.
        // Zero new arrays: reuses as_valid/var_src/const_v/as_is_add from Block P (Sprint 89).
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bd_instr = result.instrs[i as usize]
            let bd_s1 = bd_instr.src1; let bd_s2 = bd_instr.src2
            let bd_s1_ok = bd_s1 >= 0 && bd_s1 < 256; let bd_s2_ok = bd_s2 >= 0 && bd_s2 < 256
            if bd_instr.bin_op == BinaryOp::OpSub && bd_s1_ok && bd_s2_ok
                    && as_valid[bd_s1 as usize] && as_valid[bd_s2 as usize]
                    && as_var_src[bd_s1 as usize] == as_var_src[bd_s2 as usize] {
                let bd_v1 = if as_is_add[bd_s1 as usize] { as_const_v[bd_s1 as usize] } else { 0 - as_const_v[bd_s1 as usize] }
                let bd_v2 = if as_is_add[bd_s2 as usize] { as_const_v[bd_s2 as usize] } else { 0 - as_const_v[bd_s2 as usize] }
                result.instrs[i as usize] = ir_load_imm(bd_instr.dst, bd_v1 - bd_v2)
            }
        }

        // Sprint 143 Block BE: Two's complement negation — ~x + 1 → neg(x).
        // Ring identity: ~x = -x - 1, so ~x + 1 = -x. (Two's complement negation.)
        // SOTA: LLVM InstCombineAddSub.cpp — not(X)+1 → neg(X); Patterson & Hennessy §B.1.
        // Distinct from Block M (neg arithmetic): identifies bnot+1 as neg, not neg*neg.
        // Zero new arrays: uses is_bnot/bnot_src (Block AI) + is_const/const_val.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let be_instr = result.instrs[i as usize]
            let be_s1 = be_instr.src1; let be_s2 = be_instr.src2
            let be_s1_ok = be_s1 >= 0 && be_s1 < 256; let be_s2_ok = be_s2 >= 0 && be_s2 < 256
            if be_instr.bin_op == BinaryOp::OpAdd {
                // ~x + 1 → neg(x): s1 is bnot, s2 is const 1
                if be_s1_ok && is_bnot[be_s1 as usize]
                        && be_s2_ok && is_const[be_s2 as usize] && const_val[be_s2 as usize] == 1 {
                    result.instrs[i as usize] = ir_unaryop(be_instr.dst, UnaryOp::OpNeg, bnot_src[be_s1 as usize])
                }
                // 1 + ~x → neg(x): s1 is const 1, s2 is bnot
                if be_s2_ok && is_bnot[be_s2 as usize]
                        && be_s1_ok && is_const[be_s1 as usize] && const_val[be_s1 as usize] == 1 {
                    result.instrs[i as usize] = ir_unaryop(be_instr.dst, UnaryOp::OpNeg, bnot_src[be_s2 as usize])
                }
            }
        }

        // Sprint 144 Block BF: Add-complement law — x + ~x → -1.
        // Ring identity: x + ~x = x + (-x - 1) = -1. All-bits-set result.
        // Extends Block AR (x | ~x → -1) to the additive domain.
        // Zero new arrays: uses is_bnot/bnot_src (Block AI) + is_const/const_val.
        // SOTA: LLVM InstCombineAddSub.cpp; two's complement ring law.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bf_instr = result.instrs[i as usize]
            let bf_s1 = bf_instr.src1; let bf_s2 = bf_instr.src2
            let bf_s1_ok = bf_s1 >= 0 && bf_s1 < 256; let bf_s2_ok = bf_s2 >= 0 && bf_s2 < 256
            if bf_instr.bin_op == BinaryOp::OpAdd {
                // x + ~x → -1  (s2 = NOT(s1))
                if bf_s2_ok && is_bnot[bf_s2 as usize] && bnot_src[bf_s2 as usize] == bf_s1 {
                    result.instrs[i as usize] = ir_load_imm(bf_instr.dst, -1)
                    if bf_instr.dst >= 0 && bf_instr.dst < 256 {
                        is_const[bf_instr.dst as usize] = true
                        const_val[bf_instr.dst as usize] = -1
                    }
                }
                // ~x + x → -1  (s1 = NOT(s2), commutative)
                if bf_s1_ok && is_bnot[bf_s1 as usize] && bnot_src[bf_s1 as usize] == bf_s2 {
                    result.instrs[i as usize] = ir_load_imm(bf_instr.dst, -1)
                    if bf_instr.dst >= 0 && bf_instr.dst < 256 {
                        is_const[bf_instr.dst as usize] = true
                        const_val[bf_instr.dst as usize] = -1
                    }
                }
            }
        }

        // Sprint 146 Block BH: AND-subset OR absorption.
        // (x & C1) | C2 → C2  when C1 ⊆ C2  (i.e., (C1 & C2) == C1).
        // Proof: x & C1 ⊆ C1 ⊆ C2, so every bit of (x & C1) is already in C2.
        // C2 | (x & C1) → C2  (commutative form).
        // Zero new arrays: reuses and_valid/and_const_val from Block AE (Sprint 108).
        // SOTA: LLVM InstCombineAndOrXor.cpp; Boolean absorption law; Hacker's Delight §2-1.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let be_instr = result.instrs[i as usize]
            let be_s1 = be_instr.src1; let be_s2 = be_instr.src2
            let be_s1_ok = be_s1 >= 0 && be_s1 < 256; let be_s2_ok = be_s2 >= 0 && be_s2 < 256
            if be_instr.bin_op == BinaryOp::OpBitOr {
                // (x & C1) | C2 → C2 when C1 ⊆ C2
                if be_s1_ok && and_valid[be_s1 as usize]
                        && be_s2_ok && is_const[be_s2 as usize] {
                    let be_c1 = and_const_val[be_s1 as usize]
                    let be_c2 = const_val[be_s2 as usize]
                    if (be_c1 & be_c2) == be_c1 {
                        result.instrs[i as usize] = ir_load_imm(be_instr.dst, be_c2)
                        if be_instr.dst >= 0 && be_instr.dst < 256 {
                            is_const[be_instr.dst as usize] = true
                            const_val[be_instr.dst as usize] = be_c2
                        }
                    }
                }
                // C2 | (x & C1) → C2 (commutative)
                if be_s2_ok && and_valid[be_s2 as usize]
                        && be_s1_ok && is_const[be_s1 as usize] {
                    let be_c1 = and_const_val[be_s2 as usize]
                    let be_c2 = const_val[be_s1 as usize]
                    if (be_c1 & be_c2) == be_c1 {
                        result.instrs[i as usize] = ir_load_imm(be_instr.dst, be_c2)
                        if be_instr.dst >= 0 && be_instr.dst < 256 {
                            is_const[be_instr.dst as usize] = true
                            const_val[be_instr.dst as usize] = be_c2
                        }
                    }
                }
            }
        }

        // Sprint 147 Block BI: OR-mask clearance via disjoint AND.
        // (x | C1) & C2 → x & C2  when C1 & C2 == 0 (disjoint masks).
        // Proof: (x | C1) & C2 = (x & C2) | (C1 & C2) = (x & C2) | 0 = x & C2.
        // C2 & (x | C1) → x & C2  (commutative form).
        // Zero new arrays: reuses am_or_valid/am_or_var_src/am_or_const_val from Block AM.
        // SOTA: LLVM InstCombineAndOrXor.cpp; known-bits analysis; Hacker's Delight §2.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bf_instr = result.instrs[i as usize]
            let bf_s1 = bf_instr.src1; let bf_s2 = bf_instr.src2
            let bf_s1_ok = bf_s1 >= 0 && bf_s1 < 256; let bf_s2_ok = bf_s2 >= 0 && bf_s2 < 256
            if bf_instr.bin_op == BinaryOp::OpBitAnd {
                // (x | C1) & C2 → x & C2 when C1 & C2 == 0
                if bf_s1_ok && am_or_valid[bf_s1 as usize]
                        && bf_s2_ok && is_const[bf_s2 as usize] {
                    let bf_c1 = am_or_const_val[bf_s1 as usize]
                    let bf_c2 = const_val[bf_s2 as usize]
                    if (bf_c1 & bf_c2) == 0 {
                        result.instrs[i as usize] = ir_binop(bf_instr.dst,
                            am_or_var_src[bf_s1 as usize], BinaryOp::OpBitAnd, bf_s2)
                    }
                }
                // C2 & (x | C1) → x & C2 (commutative)
                if bf_s2_ok && am_or_valid[bf_s2 as usize]
                        && bf_s1_ok && is_const[bf_s1 as usize] {
                    let bf_c1 = am_or_const_val[bf_s2 as usize]
                    let bf_c2 = const_val[bf_s1 as usize]
                    if (bf_c1 & bf_c2) == 0 {
                        result.instrs[i as usize] = ir_binop(bf_instr.dst,
                            am_or_var_src[bf_s2 as usize], BinaryOp::OpBitAnd, bf_s1)
                    }
                }
            }
        }

        // Sprint 149 Block BK: Consecutive same-direction shift fold.
        // (x << A) << B → x << (A+B)   when A+B < 64.
        // (x >> A) >> B → x >> (A+B)   when A+B < 64.
        // Tracks shifts-by-constant in bk_shl_valid/bk_shr_valid arrays.
        // SOTA: LLVM InstCombineShifts.cpp FoldShiftByConstant; Cooper & Torczon §8.1.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bk_instr = result.instrs[i as usize]
            let bk_s1 = bk_instr.src1; let bk_s2 = bk_instr.src2
            let bk_s1_ok = bk_s1 >= 0 && bk_s1 < 256; let bk_s2_ok = bk_s2 >= 0 && bk_s2 < 256
            if bk_instr.bin_op == BinaryOp::OpShl {
                // (x << A) << B → x << (A+B)
                if bk_s1_ok && bk_shl_valid[bk_s1 as usize]
                        && bk_s2_ok && is_const[bk_s2 as usize] {
                    let bk_a = bk_shl_amt[bk_s1 as usize]
                    let bk_b = const_val[bk_s2 as usize]
                    let bk_ab = bk_a + bk_b
                    if bk_ab >= 0 && bk_ab < 64 {
                        let bk_new_amt_reg = bk_instr.src2
                        result.instrs[i as usize] = ir_binop(bk_instr.dst,
                            bk_shl_src[bk_s1 as usize], BinaryOp::OpShl, bk_new_amt_reg)
                        // Update the constant register to hold A+B
                        // (we reuse bk_new_amt_reg but its const_val must reflect A+B)
                        // Instead: emit via const_val override on a fresh load
                        // Approach: load the combined amount into dst first via IrLoadImm on s2 slot
                        // Since we can't emit new instrs, we fold the shift amount into the existing
                        // load-imm instr at def_at[bk_s2] if it's in this function.
                        // Simpler: just patch s2's const to A+B directly and update const_val.
                        if bk_s2_ok && def_at[bk_s2 as usize] >= 0 {
                            let def_idx = def_at[bk_s2 as usize] as usize
                            result.instrs[def_idx] = ir_load_imm(bk_s2, bk_ab)
                            const_val[bk_s2 as usize] = bk_ab
                        }
                        if bk_instr.dst >= 0 && bk_instr.dst < 256 {
                            bk_shl_valid[bk_instr.dst as usize] = true
                            bk_shl_src[bk_instr.dst as usize]   = bk_shl_src[bk_s1 as usize]
                            bk_shl_amt[bk_instr.dst as usize]   = bk_ab
                        }
                    }
                }
            }
            if bk_instr.bin_op == BinaryOp::OpShr {
                // (x >> A) >> B → x >> (A+B)
                if bk_s1_ok && bk_shr_valid[bk_s1 as usize]
                        && bk_s2_ok && is_const[bk_s2 as usize] {
                    let bk_a = bk_shr_amt[bk_s1 as usize]
                    let bk_b = const_val[bk_s2 as usize]
                    let bk_ab = bk_a + bk_b
                    if bk_ab >= 0 && bk_ab < 64 {
                        result.instrs[i as usize] = ir_binop(bk_instr.dst,
                            bk_shr_src[bk_s1 as usize], BinaryOp::OpShr, bk_instr.src2)
                        if bk_s2_ok && def_at[bk_s2 as usize] >= 0 {
                            let def_idx = def_at[bk_s2 as usize] as usize
                            result.instrs[def_idx] = ir_load_imm(bk_s2, bk_ab)
                            const_val[bk_s2 as usize] = bk_ab
                        }
                        if bk_instr.dst >= 0 && bk_instr.dst < 256 {
                            bk_shr_valid[bk_instr.dst as usize] = true
                            bk_shr_src[bk_instr.dst as usize]   = bk_shr_src[bk_s1 as usize]
                            bk_shr_amt[bk_instr.dst as usize]   = bk_ab
                        }
                    }
                }
            }
        }
        // Sprint 149 Block BK: Shift tracking — populate bk_shl/bk_shr arrays.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bk_t = result.instrs[i as usize]
            let bk_ts1 = bk_t.src1; let bk_ts2 = bk_t.src2
            let bk_ts2_ok = bk_ts2 >= 0 && bk_ts2 < 256
            if bk_t.bin_op == BinaryOp::OpShl && bk_ts2_ok && is_const[bk_ts2 as usize] {
                if bk_t.dst >= 0 && bk_t.dst < 256 {
                    bk_shl_valid[bk_t.dst as usize] = true
                    bk_shl_src[bk_t.dst as usize]   = bk_ts1
                    bk_shl_amt[bk_t.dst as usize]   = const_val[bk_ts2 as usize]
                }
            }
            if bk_t.bin_op == BinaryOp::OpShr && bk_ts2_ok && is_const[bk_ts2 as usize] {
                if bk_t.dst >= 0 && bk_t.dst < 256 {
                    bk_shr_valid[bk_t.dst as usize] = true
                    bk_shr_src[bk_t.dst as usize]   = bk_ts1
                    bk_shr_amt[bk_t.dst as usize]   = const_val[bk_ts2 as usize]
                }
            }
        }

        // Sprint 150 Block BL: Shift-low-mask annihilation.
        // (x << A) & M → 0 when M >= 0 && A in [1,62] && M < (1 << A).
        // Bottom A bits of x<<A are always zero; AND with mask below that position = 0.
        // SOTA: LLVM InstCombineShifts.cpp known-bits: (X<<C)&M=0 when M<(1<<C);
        // Hacker's Delight §5-1 "Shift-and-Mask" — known zero bits from shift.
        // Distinct from Block BK (shift chain): this crosses shift+AND operations.
        // Zero new arrays: uses bk_shl_valid/amt (Block BK) + is_const/const_val.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bl_instr = result.instrs[i as usize]
            let bl_s1 = bl_instr.src1; let bl_s2 = bl_instr.src2
            let bl_s1_ok = bl_s1 >= 0 && bl_s1 < 256; let bl_s2_ok = bl_s2 >= 0 && bl_s2 < 256
            if bl_instr.bin_op == BinaryOp::OpBitAnd {
                // (x << A) & M → 0 when M >= 0 && 1 <= A <= 62 && M < (1 << A)
                if bl_s1_ok && bk_shl_valid[bl_s1 as usize]
                        && bl_s2_ok && is_const[bl_s2 as usize] {
                    let bl_a = bk_shl_amt[bl_s1 as usize]
                    let bl_m = const_val[bl_s2 as usize]
                    if bl_m >= 0 && bl_a >= 1 && bl_a <= 62 && bl_m < (1 << bl_a) {
                        result.instrs[i as usize] = ir_load_imm(bl_instr.dst, 0)
                        if bl_instr.dst >= 0 && bl_instr.dst < 256 {
                            is_const[bl_instr.dst as usize] = true
                            const_val[bl_instr.dst as usize] = 0
                        }
                    }
                }
                // Commutative: M & (x << A) → 0
                if bl_s2_ok && bk_shl_valid[bl_s2 as usize]
                        && bl_s1_ok && is_const[bl_s1 as usize] {
                    let bl_a = bk_shl_amt[bl_s2 as usize]
                    let bl_m = const_val[bl_s1 as usize]
                    if bl_m >= 0 && bl_a >= 1 && bl_a <= 62 && bl_m < (1 << bl_a) {
                        result.instrs[i as usize] = ir_load_imm(bl_instr.dst, 0)
                        if bl_instr.dst >= 0 && bl_instr.dst < 256 {
                            is_const[bl_instr.dst as usize] = true
                            const_val[bl_instr.dst as usize] = 0
                        }
                    }
                }
            }
        }

        // Sprint 151 Block BM: XOR constant-chain fold — (x ^ C1) ^ C2 → x ^ (C1^C2).
        // Associativity of XOR over constants: combine two sequential XOR-with-constant ops.
        // Also handles commutative outer: C2 ^ (x ^ C1) → x ^ (C1^C2).
        // SOTA: LLVM InstCombineAndOrXor; GF(2) field associativity; Hacker's Delight §2-3.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bm_instr = result.instrs[i as usize]
            let bm_s1 = bm_instr.src1; let bm_s2 = bm_instr.src2
            let bm_s1_ok = bm_s1 >= 0 && bm_s1 < 256; let bm_s2_ok = bm_s2 >= 0 && bm_s2 < 256
            if bm_instr.bin_op == BinaryOp::OpBitXor {
                // (x ^ C1) ^ C2 → x ^ (C1^C2)
                if bm_s1_ok && bm_xor_valid[bm_s1 as usize]
                        && bm_s2_ok && is_const[bm_s2 as usize] {
                    let bm_c1 = bm_xor_cval[bm_s1 as usize]
                    let bm_c2 = const_val[bm_s2 as usize]
                    let bm_merged = bm_c1 ^ bm_c2
                    let bm_def = def_at[bm_s2 as usize]
                    if bm_def >= 0 {
                        result.instrs[bm_def as usize] = ir_load_imm(bm_s2, bm_merged)
                        const_val[bm_s2 as usize] = bm_merged
                    }
                    result.instrs[i as usize] = ir_binop(bm_instr.dst,
                        bm_xor_src[bm_s1 as usize], BinaryOp::OpBitXor, bm_s2)
                    if bm_instr.dst >= 0 && bm_instr.dst < 256 {
                        bm_xor_valid[bm_instr.dst as usize] = true
                        bm_xor_src[bm_instr.dst as usize]   = bm_xor_src[bm_s1 as usize]
                        bm_xor_cval[bm_instr.dst as usize]  = bm_merged
                    }
                }
                // C2 ^ (x ^ C1) → x ^ (C1^C2) (commutative outer)
                if bm_s2_ok && bm_xor_valid[bm_s2 as usize]
                        && bm_s1_ok && is_const[bm_s1 as usize] {
                    let bm_c1 = bm_xor_cval[bm_s2 as usize]
                    let bm_c2 = const_val[bm_s1 as usize]
                    let bm_merged = bm_c1 ^ bm_c2
                    let bm_def = def_at[bm_s1 as usize]
                    if bm_def >= 0 {
                        result.instrs[bm_def as usize] = ir_load_imm(bm_s1, bm_merged)
                        const_val[bm_s1 as usize] = bm_merged
                    }
                    result.instrs[i as usize] = ir_binop(bm_instr.dst,
                        bm_xor_src[bm_s2 as usize], BinaryOp::OpBitXor, bm_s1)
                    if bm_instr.dst >= 0 && bm_instr.dst < 256 {
                        bm_xor_valid[bm_instr.dst as usize] = true
                        bm_xor_src[bm_instr.dst as usize]   = bm_xor_src[bm_s2 as usize]
                        bm_xor_cval[bm_instr.dst as usize]  = bm_merged
                    }
                }
            }
        }
        // Sprint 151 Block BM: XOR tracking — populate bm_xor arrays.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bm_t = result.instrs[i as usize]
            let bm_ts1 = bm_t.src1; let bm_ts2 = bm_t.src2
            let bm_ts2_ok = bm_ts2 >= 0 && bm_ts2 < 256
            let bm_ts1_ok = bm_ts1 >= 0 && bm_ts1 < 256
            if bm_t.bin_op == BinaryOp::OpBitXor {
                // Track x ^ C (const on right)
                if bm_ts2_ok && is_const[bm_ts2 as usize] && !bm_xor_valid[bm_ts1 as usize] {
                    if bm_t.dst >= 0 && bm_t.dst < 256 {
                        bm_xor_valid[bm_t.dst as usize] = true
                        bm_xor_src[bm_t.dst as usize]   = bm_ts1
                        bm_xor_cval[bm_t.dst as usize]  = const_val[bm_ts2 as usize]
                    }
                }
                // Track C ^ x (const on left)
                if bm_ts1_ok && is_const[bm_ts1 as usize] && !bm_xor_valid[bm_ts2 as usize] {
                    if bm_t.dst >= 0 && bm_t.dst < 256 {
                        bm_xor_valid[bm_t.dst as usize] = true
                        bm_xor_src[bm_t.dst as usize]   = bm_ts2
                        bm_xor_cval[bm_t.dst as usize]  = const_val[bm_ts1 as usize]
                    }
                }
            }
        }

        // Sprint 152 Block BN: XOR self-recovery and XOR-const pair cancellation.
        // (x ^ C) ^ x → C  ;  x ^ (x ^ C) → C  (XOR with original yields constant).
        // (x ^ C1) ^ (x ^ C2) → C1 ^ C2  (shared base cancels, constants XOR).
        // SOTA: LLVM InstCombineAndOrXor — XOR group law: (a^b)^a=b; GF(2) §2-3.
        // Distinct from Block AU ((a^b)^(a^c)→b^c for RR-XOR): uses bm_xor tracking
        // for the const-xor case where Block AS/AU don't track.
        // Zero new arrays: uses bm_xor_valid/src/cval (Block BM) + is_const/const_val.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bn_instr = result.instrs[i as usize]
            let bn_s1 = bn_instr.src1; let bn_s2 = bn_instr.src2
            let bn_s1_ok = bn_s1 >= 0 && bn_s1 < 256; let bn_s2_ok = bn_s2 >= 0 && bn_s2 < 256
            if bn_instr.bin_op == BinaryOp::OpBitXor && bn_s1_ok && bn_s2_ok {
                // (x ^ C) ^ x → C: s1 is xor-const, s2 == base of s1
                if bm_xor_valid[bn_s1 as usize] && bm_xor_src[bn_s1 as usize] == bn_s2 {
                    result.instrs[i as usize] = ir_load_imm(bn_instr.dst, bm_xor_cval[bn_s1 as usize])
                    if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                        is_const[bn_instr.dst as usize] = true
                        const_val[bn_instr.dst as usize] = bm_xor_cval[bn_s1 as usize]
                    }
                }
                // x ^ (x ^ C) → C: s2 is xor-const, s1 == base of s2
                if bm_xor_valid[bn_s2 as usize] && bm_xor_src[bn_s2 as usize] == bn_s1 {
                    result.instrs[i as usize] = ir_load_imm(bn_instr.dst, bm_xor_cval[bn_s2 as usize])
                    if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                        is_const[bn_instr.dst as usize] = true
                        const_val[bn_instr.dst as usize] = bm_xor_cval[bn_s2 as usize]
                    }
                }
                // (x ^ C1) ^ (x ^ C2) → C1 ^ C2: both are xor-const with same base
                if bm_xor_valid[bn_s1 as usize] && bm_xor_valid[bn_s2 as usize]
                        && bm_xor_src[bn_s1 as usize] == bm_xor_src[bn_s2 as usize] {
                    let bn_merged = bm_xor_cval[bn_s1 as usize] ^ bm_xor_cval[bn_s2 as usize]
                    result.instrs[i as usize] = ir_load_imm(bn_instr.dst, bn_merged)
                    if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                        is_const[bn_instr.dst as usize] = true
                        const_val[bn_instr.dst as usize] = bn_merged
                    }
                }
            }
        }

        // Sprint 153 Block BO: Two's-complement rewrite — ~x + 1 → -x.
        // ~x + 1 = -x in two's complement (definition: -x = ~x + 1).
        // Handles commutative outer: 1 + ~x → -x.
        // Zero new arrays: reuses is_bnot/bnot_src (Block AI/BJ) + is_const/const_val.
        // SOTA: LLVM InstCombineAddSub; Hacker's Delight §2-2; two's complement identity.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bo_instr = result.instrs[i as usize]
            let bo_s1 = bo_instr.src1; let bo_s2 = bo_instr.src2
            let bo_s1_ok = bo_s1 >= 0 && bo_s1 < 256; let bo_s2_ok = bo_s2 >= 0 && bo_s2 < 256
            if bo_instr.bin_op == BinaryOp::OpAdd {
                // ~x + 1 → -x  (s1 = ~x, s2 = const 1)
                if bo_s1_ok && bo_s2_ok && is_bnot[bo_s1 as usize]
                        && is_const[bo_s2 as usize] && const_val[bo_s2 as usize] == 1 {
                    let bo_inner = bnot_src[bo_s1 as usize]
                    result.instrs[i as usize] = ir_unaryop(bo_instr.dst, UnaryOp::OpNeg, bo_inner)
                }
                // 1 + ~x → -x  (s1 = const 1, s2 = ~x)
                if bo_s1_ok && bo_s2_ok && is_const[bo_s1 as usize] && const_val[bo_s1 as usize] == 1
                        && is_bnot[bo_s2 as usize] {
                    let bo_inner = bnot_src[bo_s2 as usize]
                    result.instrs[i as usize] = ir_unaryop(bo_instr.dst, UnaryOp::OpNeg, bo_inner)
                }
            }
        }

        // Sprint 154 Block BP: AND-complement annihilation — x & ~x → 0, ~x & x → 0.
        // Boolean algebra: a ∧ ¬a = 0 (complement law for AND).
        // Zero new arrays: uses is_bnot/bnot_src (Block AI/BJ/BF) + is_const/const_val.
        // SOTA: LLVM InstCombineAndOrXor; Hacker's Delight §2-1; Boolean algebra complement.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bp_instr = result.instrs[i as usize]
            let bp_s1 = bp_instr.src1; let bp_s2 = bp_instr.src2
            let bp_s1_ok = bp_s1 >= 0 && bp_s1 < 256; let bp_s2_ok = bp_s2 >= 0 && bp_s2 < 256
            if bp_instr.bin_op == BinaryOp::OpBitAnd && bp_s1_ok && bp_s2_ok {
                // x & ~x → 0: s2 is ~s1
                if is_bnot[bp_s2 as usize] && bnot_src[bp_s2 as usize] == bp_s1 {
                    result.instrs[i as usize] = ir_load_imm(bp_instr.dst, 0)
                    if bp_instr.dst >= 0 && bp_instr.dst < 256 {
                        is_const[bp_instr.dst as usize] = true
                        const_val[bp_instr.dst as usize] = 0
                        def_at[bp_instr.dst as usize] = i
                    }
                }
                // ~x & x → 0: s1 is ~s2
                if is_bnot[bp_s1 as usize] && bnot_src[bp_s1 as usize] == bp_s2 {
                    result.instrs[i as usize] = ir_load_imm(bp_instr.dst, 0)
                    if bp_instr.dst >= 0 && bp_instr.dst < 256 {
                        is_const[bp_instr.dst as usize] = true
                        const_val[bp_instr.dst as usize] = 0
                        def_at[bp_instr.dst as usize] = i
                    }
                }
            }
        }

        // Sprint 155 Block BQ: OR-complement absorption — x | ~x → -1, ~x | x → -1.
        // Boolean algebra: a ∨ ¬a = 1 (all-ones, complement law for OR).
        // Zero new arrays: uses is_bnot/bnot_src (Block AI/BJ/BF) + is_const/const_val.
        // SOTA: LLVM InstCombineAndOrXor; Hacker's Delight §2-1; Boolean algebra complement.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bq_instr = result.instrs[i as usize]
            let bq_s1 = bq_instr.src1; let bq_s2 = bq_instr.src2
            let bq_s1_ok = bq_s1 >= 0 && bq_s1 < 256; let bq_s2_ok = bq_s2 >= 0 && bq_s2 < 256
            if bq_instr.bin_op == BinaryOp::OpBitOr && bq_s1_ok && bq_s2_ok {
                // x | ~x → -1: s2 is ~s1
                if is_bnot[bq_s2 as usize] && bnot_src[bq_s2 as usize] == bq_s1 {
                    result.instrs[i as usize] = ir_load_imm(bq_instr.dst, -1)
                    if bq_instr.dst >= 0 && bq_instr.dst < 256 {
                        is_const[bq_instr.dst as usize] = true
                        const_val[bq_instr.dst as usize] = -1
                        def_at[bq_instr.dst as usize] = i
                    }
                }
                // ~x | x → -1: s1 is ~s2
                if is_bnot[bq_s1 as usize] && bnot_src[bq_s1 as usize] == bq_s2 {
                    result.instrs[i as usize] = ir_load_imm(bq_instr.dst, -1)
                    if bq_instr.dst >= 0 && bq_instr.dst < 256 {
                        is_const[bq_instr.dst as usize] = true
                        const_val[bq_instr.dst as usize] = -1
                        def_at[bq_instr.dst as usize] = i
                    }
                }
            }
        }

        // Sprint 156 Block BR: XOR-complement — x ^ ~x → -1, ~x ^ x → -1.
        // Boolean algebra: a ⊕ ¬a = 1 (XOR with its complement is all-ones).
        // Proof: x^~x = x^(x^-1) = (x^x)^-1 = 0^-1 = -1. (GF(2): 0⊕1=1 per bit)
        // Zero new arrays: uses is_bnot/bnot_src (Block AI/BJ/BF) + is_const/const_val.
        // SOTA: LLVM InstCombineAndOrXor; Hacker's Delight §2-1; GF(2) complement.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let br_instr = result.instrs[i as usize]
            let br_s1 = br_instr.src1; let br_s2 = br_instr.src2
            let br_s1_ok = br_s1 >= 0 && br_s1 < 256; let br_s2_ok = br_s2 >= 0 && br_s2 < 256
            if br_instr.bin_op == BinaryOp::OpBitXor && br_s1_ok && br_s2_ok {
                // x ^ ~x → -1: s2 is ~s1
                if is_bnot[br_s2 as usize] && bnot_src[br_s2 as usize] == br_s1 {
                    result.instrs[i as usize] = ir_load_imm(br_instr.dst, -1)
                    if br_instr.dst >= 0 && br_instr.dst < 256 {
                        is_const[br_instr.dst as usize] = true
                        const_val[br_instr.dst as usize] = -1
                        def_at[br_instr.dst as usize] = i
                    }
                }
                // ~x ^ x → -1: s1 is ~s2
                if is_bnot[br_s1 as usize] && bnot_src[br_s1 as usize] == br_s2 {
                    result.instrs[i as usize] = ir_load_imm(br_instr.dst, -1)
                    if br_instr.dst >= 0 && br_instr.dst < 256 {
                        is_const[br_instr.dst as usize] = true
                        const_val[br_instr.dst as usize] = -1
                        def_at[br_instr.dst as usize] = i
                    }
                }
            }
        }

        // Sprint 157 Block BS: Consecutive subtract-constant fold — (x-C1)-C2 → x-(C1+C2).
        // Mirrors Block BG (OR) and Block BM (XOR-chain) for subtraction.
        // Zero new arrays beyond bs_sub_valid/src/cval; reuses is_const/const_val/def_at.
        // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.2; arithmetic associativity.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bs_instr = result.instrs[i as usize]
            let bs_s1 = bs_instr.src1; let bs_s2 = bs_instr.src2
            let bs_s1_ok = bs_s1 >= 0 && bs_s1 < 256; let bs_s2_ok = bs_s2 >= 0 && bs_s2 < 256
            if bs_instr.bin_op == BinaryOp::OpSub && bs_s1_ok && bs_s2_ok {
                // (x - C1) - C2 → x - (C1+C2): s1 is x-C1 tracked, s2 is const C2
                if bs_sub_valid[bs_s1 as usize] && is_const[bs_s2 as usize] {
                    let bs_c1 = bs_sub_cval[bs_s1 as usize]
                    let bs_c2 = const_val[bs_s2 as usize]
                    let bs_merged = bs_c1 + bs_c2
                    let bs_cdef = def_at[bs_s2 as usize]
                    if bs_cdef >= 0 {
                        result.instrs[bs_cdef as usize] = ir_load_imm(bs_s2, bs_merged)
                        is_const[bs_s2 as usize] = true
                        const_val[bs_s2 as usize] = bs_merged
                    }
                    result.instrs[i as usize] = ir_binop(
                        bs_instr.dst, bs_sub_src[bs_s1 as usize], BinaryOp::OpSub, bs_s2)
                    if bs_instr.dst >= 0 && bs_instr.dst < 256 {
                        bs_sub_valid[bs_instr.dst as usize] = true
                        bs_sub_src[bs_instr.dst as usize]   = bs_sub_src[bs_s1 as usize]
                        bs_sub_cval[bs_instr.dst as usize]  = bs_merged
                    }
                }
            }
        }
        // Sprint 157 Block BS: Subtract tracking — populate bs_sub arrays.
        // Record when dst = src - C (src minus constant) for downstream folding.
        if ocp_is_binop(instr.op) && instr.bin_op == BinaryOp::OpSub {
            let bs_t = result.instrs[i as usize]
            let bs_ts1 = bs_t.src1; let bs_ts2 = bs_t.src2
            let bs_ts1_ok = bs_ts1 >= 0 && bs_ts1 < 256; let bs_ts2_ok = bs_ts2 >= 0 && bs_ts2 < 256
            if bs_ts1_ok && bs_ts2_ok && is_const[bs_ts2 as usize]
                    && !bs_sub_valid[bs_ts1 as usize] {
                if bs_t.dst >= 0 && bs_t.dst < 256 {
                    bs_sub_valid[bs_t.dst as usize] = true
                    bs_sub_src[bs_t.dst as usize]   = bs_ts1
                    bs_sub_cval[bs_t.dst as usize]  = const_val[bs_ts2 as usize]
                }
            }
        }

        // Sprint 158 Block BT: Consecutive add-constant fold — (x+C1)+C2 → x+(C1+C2).
        // Symmetric to Block BS (sub-chain) for addition. Commutative both sides.
        // Zero new arrays beyond bt_add_valid/src/cval; reuses is_const/const_val/def_at.
        // SOTA: LLVM InstCombineAddSub.cpp; additive associativity; Hacker's Delight §2.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bt_instr = result.instrs[i as usize]
            let bt_s1 = bt_instr.src1; let bt_s2 = bt_instr.src2
            let bt_s1_ok = bt_s1 >= 0 && bt_s1 < 256; let bt_s2_ok = bt_s2 >= 0 && bt_s2 < 256
            if bt_instr.bin_op == BinaryOp::OpAdd && bt_s1_ok && bt_s2_ok {
                // (x + C1) + C2 → x + (C1+C2): s1 is x+C1 tracked, s2 is const C2
                if bt_add_valid[bt_s1 as usize] && is_const[bt_s2 as usize] {
                    let bt_c1 = bt_add_cval[bt_s1 as usize]
                    let bt_c2 = const_val[bt_s2 as usize]
                    let bt_merged = bt_c1 + bt_c2
                    let bt_cdef = def_at[bt_s2 as usize]
                    if bt_cdef >= 0 {
                        result.instrs[bt_cdef as usize] = ir_load_imm(bt_s2, bt_merged)
                        is_const[bt_s2 as usize] = true
                        const_val[bt_s2 as usize] = bt_merged
                    }
                    result.instrs[i as usize] = ir_binop(
                        bt_instr.dst, bt_add_src[bt_s1 as usize], BinaryOp::OpAdd, bt_s2)
                    if bt_instr.dst >= 0 && bt_instr.dst < 256 {
                        bt_add_valid[bt_instr.dst as usize] = true
                        bt_add_src[bt_instr.dst as usize]   = bt_add_src[bt_s1 as usize]
                        bt_add_cval[bt_instr.dst as usize]  = bt_merged
                    }
                }
                // C2 + (x + C1) → x + (C1+C2): commutative outer, s1=const, s2=x+C1
                if bt_add_valid[bt_s2 as usize] && is_const[bt_s1 as usize] {
                    let bt_c1 = bt_add_cval[bt_s2 as usize]
                    let bt_c2 = const_val[bt_s1 as usize]
                    let bt_merged = bt_c1 + bt_c2
                    let bt_cdef = def_at[bt_s1 as usize]
                    if bt_cdef >= 0 {
                        result.instrs[bt_cdef as usize] = ir_load_imm(bt_s1, bt_merged)
                        is_const[bt_s1 as usize] = true
                        const_val[bt_s1 as usize] = bt_merged
                    }
                    result.instrs[i as usize] = ir_binop(
                        bt_instr.dst, bt_add_src[bt_s2 as usize], BinaryOp::OpAdd, bt_s1)
                    if bt_instr.dst >= 0 && bt_instr.dst < 256 {
                        bt_add_valid[bt_instr.dst as usize] = true
                        bt_add_src[bt_instr.dst as usize]   = bt_add_src[bt_s2 as usize]
                        bt_add_cval[bt_instr.dst as usize]  = bt_merged
                    }
                }
            }
        }
        // Sprint 158 Block BT: Add tracking — populate bt_add arrays.
        // Record when dst = src + C (src plus constant) for downstream folding.
        if ocp_is_binop(instr.op) && instr.bin_op == BinaryOp::OpAdd {
            let bt_t = result.instrs[i as usize]
            let bt_ts1 = bt_t.src1; let bt_ts2 = bt_t.src2
            let bt_ts1_ok = bt_ts1 >= 0 && bt_ts1 < 256; let bt_ts2_ok = bt_ts2 >= 0 && bt_ts2 < 256
            if bt_ts1_ok && bt_ts2_ok && bt_t.dst >= 0 && bt_t.dst < 256 {
                // x + C form: s2 is const, s1 is var
                if is_const[bt_ts2 as usize] && !bt_add_valid[bt_ts1 as usize] {
                    bt_add_valid[bt_t.dst as usize] = true
                    bt_add_src[bt_t.dst as usize]   = bt_ts1
                    bt_add_cval[bt_t.dst as usize]  = const_val[bt_ts2 as usize]
                }
                // C + x form: s1 is const, s2 is var
                if is_const[bt_ts1 as usize] && !bt_add_valid[bt_ts2 as usize] {
                    bt_add_valid[bt_t.dst as usize] = true
                    bt_add_src[bt_t.dst as usize]   = bt_ts2
                    bt_add_cval[bt_t.dst as usize]  = const_val[bt_ts1 as usize]
                }
            }
        }

        // Sprint 159 Block BU: Add/sub-const cross-track difference collapse.
        // (x+C1)-(x-C2) → C1+C2  ;  (x-C1)-(x+C2) → -(C1+C2).
        // (x-C1)-(x-C2) → C2-C1  ;  (x+C1)-(x+C2) → C1-C2 (chained variant).
        // Extends Block BD (as_valid): fires on chain-folded exprs tracked by bs/bt
        // arrays but not by as_valid (which uses snapshot, not post-fold state).
        // SOTA: LLVM InstCombineAddSub.cpp sub(add X,C1),(sub X,C2)→C1+C2 chain;
        // Cooper & Torczon §8.4 — tracked known-constant arithmetic.
        // Zero new arrays: uses bs_sub_valid/src/cval (Block BS) + bt_add_valid/src/cval (Block BT).
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bu_instr = result.instrs[i as usize]
            let bu_s1 = bu_instr.src1; let bu_s2 = bu_instr.src2
            let bu_s1_ok = bu_s1 >= 0 && bu_s1 < 256; let bu_s2_ok = bu_s2 >= 0 && bu_s2 < 256
            if bu_instr.bin_op == BinaryOp::OpSub && bu_s1_ok && bu_s2_ok {
                // (x+C1) - (x-C2) → C1+C2
                if bt_add_valid[bu_s1 as usize] && bs_sub_valid[bu_s2 as usize]
                        && bt_add_src[bu_s1 as usize] == bs_sub_src[bu_s2 as usize] {
                    let bu_result = bt_add_cval[bu_s1 as usize] + bs_sub_cval[bu_s2 as usize]
                    result.instrs[i as usize] = ir_load_imm(bu_instr.dst, bu_result)
                    if bu_instr.dst >= 0 && bu_instr.dst < 256 {
                        is_const[bu_instr.dst as usize] = true
                        const_val[bu_instr.dst as usize] = bu_result
                    }
                }
                // (x-C1) - (x+C2) → -(C1+C2)
                if bs_sub_valid[bu_s1 as usize] && bt_add_valid[bu_s2 as usize]
                        && bs_sub_src[bu_s1 as usize] == bt_add_src[bu_s2 as usize] {
                    let bu_result = 0 - (bs_sub_cval[bu_s1 as usize] + bt_add_cval[bu_s2 as usize])
                    result.instrs[i as usize] = ir_load_imm(bu_instr.dst, bu_result)
                    if bu_instr.dst >= 0 && bu_instr.dst < 256 {
                        is_const[bu_instr.dst as usize] = true
                        const_val[bu_instr.dst as usize] = bu_result
                    }
                }
                // (x-C1) - (x-C2) → C2-C1 (both bs_sub, same base)
                if bs_sub_valid[bu_s1 as usize] && bs_sub_valid[bu_s2 as usize]
                        && bs_sub_src[bu_s1 as usize] == bs_sub_src[bu_s2 as usize] {
                    let bu_result = bs_sub_cval[bu_s2 as usize] - bs_sub_cval[bu_s1 as usize]
                    result.instrs[i as usize] = ir_load_imm(bu_instr.dst, bu_result)
                    if bu_instr.dst >= 0 && bu_instr.dst < 256 {
                        is_const[bu_instr.dst as usize] = true
                        const_val[bu_instr.dst as usize] = bu_result
                    }
                }
                // (x+C1) - (x+C2) → C1-C2 (both bt_add, same base)
                if bt_add_valid[bu_s1 as usize] && bt_add_valid[bu_s2 as usize]
                        && bt_add_src[bu_s1 as usize] == bt_add_src[bu_s2 as usize] {
                    let bu_result = bt_add_cval[bu_s1 as usize] - bt_add_cval[bu_s2 as usize]
                    result.instrs[i as usize] = ir_load_imm(bu_instr.dst, bu_result)
                    if bu_instr.dst >= 0 && bu_instr.dst < 256 {
                        is_const[bu_instr.dst as usize] = true
                        const_val[bu_instr.dst as usize] = bu_result
                    }
                }
            }
        }

        // Sprint 160 Block BV: XOR-OR constant merge — (x ^ C) | C → x | C.
        // Proof: C-bits: (x_i^1)|1=1=x_i|1; non-C-bits: (x_i^0)|0=x_i. QED.
        // SOTA: LLVM InstCombineAndOrXor — or(xor X,C),C → or X,C; Boolean algebra.
        // Distinct from Block AR/BF: those reduce to const; BV yields x|C (non-const).
        // Zero new arrays: uses bm_xor_valid/src/cval (Block BM) + is_const/const_val.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bv_instr = result.instrs[i as usize]
            let bv_s1 = bv_instr.src1; let bv_s2 = bv_instr.src2
            let bv_s1_ok = bv_s1 >= 0 && bv_s1 < 256; let bv_s2_ok = bv_s2 >= 0 && bv_s2 < 256
            if bv_instr.bin_op == BinaryOp::OpBitOr {
                // (x ^ C) | C → x | C: s1 is xor-const, s2 is same const
                if bv_s1_ok && bm_xor_valid[bv_s1 as usize]
                        && bv_s2_ok && is_const[bv_s2 as usize]
                        && bm_xor_cval[bv_s1 as usize] == const_val[bv_s2 as usize] {
                    result.instrs[i as usize] = ir_binop(bv_instr.dst,
                        bm_xor_src[bv_s1 as usize], BinaryOp::OpBitOr, bv_s2)
                    if bv_instr.dst >= 0 && bv_instr.dst < 256 {
                        am_or_valid[bv_instr.dst as usize]     = true
                        am_or_var_src[bv_instr.dst as usize]   = bm_xor_src[bv_s1 as usize]
                        am_or_const_val[bv_instr.dst as usize] = const_val[bv_s2 as usize]
                    }
                }
                // C | (x ^ C) → x | C: commutative
                if bv_s2_ok && bm_xor_valid[bv_s2 as usize]
                        && bv_s1_ok && is_const[bv_s1 as usize]
                        && bm_xor_cval[bv_s2 as usize] == const_val[bv_s1 as usize] {
                    result.instrs[i as usize] = ir_binop(bv_instr.dst,
                        bm_xor_src[bv_s2 as usize], BinaryOp::OpBitOr, bv_s1)
                    if bv_instr.dst >= 0 && bv_instr.dst < 256 {
                        am_or_valid[bv_instr.dst as usize]     = true
                        am_or_var_src[bv_instr.dst as usize]   = bm_xor_src[bv_s2 as usize]
                        am_or_const_val[bv_instr.dst as usize] = const_val[bv_s1 as usize]
                    }
                }
            }
        }

        // Sprint 161 Block BW: XOR-mask AND complement — (x ^ C) & ~C → x & ~C.
        // Proof: C-bits (C_i=1, ~C_i=0): (xi^1)&0=0=xi&0. Non-C-bits: (xi^0)&1=xi=xi&1.
        // SOTA: LLVM InstCombineAndOrXor and(xor X,C),~C → and X,~C; Boolean algebra.
        // Zero new arrays: uses bm_xor_valid/src/cval (Block BM) + is_const/const_val.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bw_instr = result.instrs[i as usize]
            let bw_s1 = bw_instr.src1; let bw_s2 = bw_instr.src2
            let bw_s1_ok = bw_s1 >= 0 && bw_s1 < 256; let bw_s2_ok = bw_s2 >= 0 && bw_s2 < 256
            if bw_instr.bin_op == BinaryOp::OpBitAnd {
                // (x ^ C) & ~C → x & ~C: s1 is xor-const, s2 is bitwise NOT of same C
                if bw_s1_ok && bm_xor_valid[bw_s1 as usize]
                        && bw_s2_ok && is_const[bw_s2 as usize]
                        && const_val[bw_s2 as usize] == (bm_xor_cval[bw_s1 as usize] ^ -1) {
                    result.instrs[i as usize] = ir_binop(bw_instr.dst,
                        bm_xor_src[bw_s1 as usize], BinaryOp::OpBitAnd, bw_s2)
                }
                // ~C & (x ^ C) → x & ~C: commutative
                if bw_s2_ok && bm_xor_valid[bw_s2 as usize]
                        && bw_s1_ok && is_const[bw_s1 as usize]
                        && const_val[bw_s1 as usize] == (bm_xor_cval[bw_s2 as usize] ^ -1) {
                    result.instrs[i as usize] = ir_binop(bw_instr.dst,
                        bm_xor_src[bw_s2 as usize], BinaryOp::OpBitAnd, bw_s1)
                }
            }
        }

        // Sprint 162 Block BX: OR-XOR complement fold — (x | C) ^ C → x & ~C.
        // Proof: C-bits (C_i=1): (xi|1)^1=1^1=0=xi&0. Non-C-bits (C_i=0): (xi|0)^0=xi=xi&1.
        // Handles commutative outer: C ^ (x | C) → x & ~C.
        // Zero new arrays: uses am_or_valid/var_src/const_val (Block AM) + is_const/const_val + def_at.
        // SOTA: LLVM InstCombineAndOrXor; Boolean algebra: (x|C)^C = x&~C.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bx_instr = result.instrs[i as usize]
            let bx_s1 = bx_instr.src1; let bx_s2 = bx_instr.src2
            let bx_s1_ok = bx_s1 >= 0 && bx_s1 < 256; let bx_s2_ok = bx_s2 >= 0 && bx_s2 < 256
            if bx_instr.bin_op == BinaryOp::OpBitXor {
                // (x | C) ^ C → x & ~C: s1 is or-const, s2 == same C
                if bx_s1_ok && am_or_valid[bx_s1 as usize] && bx_s2_ok && is_const[bx_s2 as usize]
                        && am_or_const_val[bx_s1 as usize] == const_val[bx_s2 as usize] {
                    let bx_notc = am_or_const_val[bx_s1 as usize] ^ -1
                    let bx_def = def_at[bx_s2 as usize]
                    if bx_def >= 0 {
                        result.instrs[bx_def as usize] = ir_load_imm(bx_s2, bx_notc)
                        const_val[bx_s2 as usize] = bx_notc
                    }
                    result.instrs[i as usize] = ir_binop(bx_instr.dst,
                        am_or_var_src[bx_s1 as usize], BinaryOp::OpBitAnd, bx_s2)
                }
                // C ^ (x | C) → x & ~C: commutative outer
                if bx_s2_ok && am_or_valid[bx_s2 as usize] && bx_s1_ok && is_const[bx_s1 as usize]
                        && am_or_const_val[bx_s2 as usize] == const_val[bx_s1 as usize] {
                    let bx_notc = am_or_const_val[bx_s2 as usize] ^ -1
                    let bx_def = def_at[bx_s1 as usize]
                    if bx_def >= 0 {
                        result.instrs[bx_def as usize] = ir_load_imm(bx_s1, bx_notc)
                        const_val[bx_s1 as usize] = bx_notc
                    }
                    result.instrs[i as usize] = ir_binop(bx_instr.dst,
                        am_or_var_src[bx_s2 as usize], BinaryOp::OpBitAnd, bx_s1)
                }
            }
        }

        // Sprint 163 Block BY: XOR-OR same-constant fold — (x ^ C) | C → x | C.
        // Proof: C-bits (C_i=1): (xi^1)|1=1=xi|1. Non-C-bits (C_i=0): (xi^0)|0=xi=xi|0.
        // The XOR on C-bits is annihilated by the subsequent OR; result is x | C.
        // Handles commutative outer: C | (x ^ C) → x | C.
        // Zero new arrays: uses bm_xor_valid/src/cval (Block BM) + is_const/const_val.
        // SOTA: LLVM InstCombineAndOrXor or(xor(X,C),C) → or(X,C); Boolean absorption.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let by_instr = result.instrs[i as usize]
            let by_s1 = by_instr.src1; let by_s2 = by_instr.src2
            let by_s1_ok = by_s1 >= 0 && by_s1 < 256; let by_s2_ok = by_s2 >= 0 && by_s2 < 256
            if by_instr.bin_op == BinaryOp::OpBitOr {
                // (x ^ C) | C → x | C: s1 is xor-const, s2 == same C
                if by_s1_ok && bm_xor_valid[by_s1 as usize]
                        && by_s2_ok && is_const[by_s2 as usize]
                        && bm_xor_cval[by_s1 as usize] == const_val[by_s2 as usize] {
                    result.instrs[i as usize] = ir_binop(by_instr.dst,
                        bm_xor_src[by_s1 as usize], BinaryOp::OpBitOr, by_s2)
                }
                // C | (x ^ C) → x | C: commutative outer
                if by_s2_ok && bm_xor_valid[by_s2 as usize]
                        && by_s1_ok && is_const[by_s1 as usize]
                        && bm_xor_cval[by_s2 as usize] == const_val[by_s1 as usize] {
                    result.instrs[i as usize] = ir_binop(by_instr.dst,
                        bm_xor_src[by_s2 as usize], BinaryOp::OpBitOr, by_s1)
                }
            }
        }

        // Sprint 164 Block BZ: AND-XOR same-constant merge — (x & C) | (x ^ C) → x | C.
        // Proof: C-bits: (xi&1)|(xi^1)=1=xi|1. Non-C: (xi&0)|(xi^0)=xi=xi|0. QED.
        // Handles commutative outer: (x ^ C) | (x & C) → x | C.
        // Zero new arrays: uses and_valid/and_var_src/and_const_val (Block AE)
        //   + bm_xor_valid/src/cval (Block BM) + am_or_valid/var_src/const_val (Block AM).
        // SOTA: LLVM InstCombineAndOrXor or(and X,C),xor(X,C) → or X,C.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bz_instr = result.instrs[i as usize]
            let bz_s1 = bz_instr.src1; let bz_s2 = bz_instr.src2
            let bz_s1_ok = bz_s1 >= 0 && bz_s1 < 256; let bz_s2_ok = bz_s2 >= 0 && bz_s2 < 256
            if bz_instr.bin_op == BinaryOp::OpBitOr {
                // (x & C) | (x ^ C) → x | C: s1=x&C, s2=x^C, same x, same C
                if bz_s1_ok && and_valid[bz_s1 as usize]
                        && bz_s2_ok && bm_xor_valid[bz_s2 as usize]
                        && and_var_src[bz_s1 as usize] == bm_xor_src[bz_s2 as usize]
                        && and_const_val[bz_s1 as usize] == bm_xor_cval[bz_s2 as usize] {
                    let bz_x = and_var_src[bz_s1 as usize]
                    // reuse s2 constant slot (holds C from xor tracking)
                    result.instrs[i as usize] = ir_binop(bz_instr.dst,
                        bz_x, BinaryOp::OpBitOr, bz_s2)
                    // update am_or tracking for dst
                    if bz_instr.dst >= 0 && bz_instr.dst < 256 {
                        am_or_valid[bz_instr.dst as usize]     = true
                        am_or_var_src[bz_instr.dst as usize]   = bz_x
                        am_or_const_val[bz_instr.dst as usize] = bm_xor_cval[bz_s2 as usize]
                    }
                }
                // (x ^ C) | (x & C) → x | C: commutative s1/s2 swap
                if bz_s2_ok && and_valid[bz_s2 as usize]
                        && bz_s1_ok && bm_xor_valid[bz_s1 as usize]
                        && and_var_src[bz_s2 as usize] == bm_xor_src[bz_s1 as usize]
                        && and_const_val[bz_s2 as usize] == bm_xor_cval[bz_s1 as usize] {
                    let bz_x = and_var_src[bz_s2 as usize]
                    result.instrs[i as usize] = ir_binop(bz_instr.dst,
                        bz_x, BinaryOp::OpBitOr, bz_s1)
                    if bz_instr.dst >= 0 && bz_instr.dst < 256 {
                        am_or_valid[bz_instr.dst as usize]     = true
                        am_or_var_src[bz_instr.dst as usize]   = bz_x
                        am_or_const_val[bz_instr.dst as usize] = bm_xor_cval[bz_s1 as usize]
                    }
                }
            }
        }

                        // Sprint 82 Block J: Unary operation constant folding.
        // Folds IrUnaryOp when the source operand is a known constant.
        // Only OpNeg and OpNot are foldable (Ref/RefMut/Deref are memory ops).
        // (Wegman & Zadeck TOPLAS 1991 §4: constant folding completeness
        //  requires all operator families — unary included.)
        if instr.op == IrOpcode::IrUnaryOp {
            let us = instr.src1
            let us_ok = us >= 0 && us < 256
            // Fold: -(const) → IrLoadImm(-const)
            if us_ok && is_const[us as usize] && instr.un_op == UnaryOp::OpNeg {
                let neg_val = 0 - const_val[us as usize]
                result.instrs[i as usize] = ir_load_imm(instr.dst, neg_val)
                if instr.dst >= 0 && instr.dst < 256 {
                    is_const[instr.dst as usize] = true
                    const_val[instr.dst as usize] = neg_val
                    def_at[instr.dst as usize] = i
                }
            }
            // Fold: !(const) → IrLoadImm(~const)  (bitwise NOT = XOR with -1)
            if us_ok && is_const[us as usize] && instr.un_op == UnaryOp::OpNot {
                let not_val = const_val[us as usize] ^ -1
                result.instrs[i as usize] = ir_load_imm(instr.dst, not_val)
                if instr.dst >= 0 && instr.dst < 256 {
                    is_const[instr.dst as usize] = true
                    const_val[instr.dst as usize] = not_val
                    def_at[instr.dst as usize] = i
                }
            }
            // Sprint 148 Block BJ: Double NOT cancel — ~(~x) → IrCopy(x).
            // If src is itself a NOT (is_bnot), the two NOTs cancel: ~~x = x.
            // Zero new arrays: reuses is_bnot/bnot_src from Block AI (Sprint 120) and Sprint 144.
            // SOTA: LLVM InstCombineAndOrXor; Boolean double negation law; Hacker's Delight §2-2.
            if us_ok && instr.un_op == UnaryOp::OpNot && is_bnot[us as usize] {
                let bj_inner = bnot_src[us as usize]
                result.instrs[i as usize] = ir_copy(instr.dst, bj_inner)
                if instr.dst >= 0 && instr.dst < 256 {
                    if bj_inner >= 0 && bj_inner < 256 && is_const[bj_inner as usize] {
                        is_const[instr.dst as usize] = true
                        const_val[instr.dst as usize] = const_val[bj_inner as usize]
                    }
                }
            }
        }

        // Sprint 86 Block M: Negation tracking — populate.
        // Record when a register is produced by OpNeg for double-neg detection.
        if instr.op == IrOpcode::IrUnaryOp && instr.un_op == UnaryOp::OpNeg {
            if instr.dst >= 0 && instr.dst < 256 {
                is_neg[instr.dst as usize]  = true
                neg_src[instr.dst as usize] = instr.src1
            }
        }

        // Sprint 144 Block BF: Track IrUnaryOp(OpNot) as bitwise NOT.
        // Extends is_bnot (Block AI, XOR-1 form) to the explicit OpNot opcode.
        // Allows Block BF (x + ~x → -1) and Block AR/AT to see explicit NOT instructions.
        // Guard: check result (not snapshot) so Block BJ rewrites don't create stale entries.
        if result.instrs[i as usize].op == IrOpcode::IrUnaryOp
                && instr.un_op == UnaryOp::OpNot {
            if instr.dst >= 0 && instr.dst < 256 {
                is_bnot[instr.dst as usize]  = true
                bnot_src[instr.dst as usize] = instr.src1
            }
        }

        // Sprint 115 Block AL: Subtract tracking — populate.
        // Record when a register is produced by OpSub for downstream neg-reversal.
        if ocp_is_binop(instr.op) && instr.bin_op == BinaryOp::OpSub {
            let al_instr = result.instrs[i as usize]
            if al_instr.dst >= 0 && al_instr.dst < 256 {
                al_is_sub[al_instr.dst as usize]  = true
                al_sub_lhs[al_instr.dst as usize] = al_instr.src1
                al_sub_rhs[al_instr.dst as usize] = al_instr.src2
            }
        }

        // Sprint 86 Block M: Negation arithmetic fold.
        // x * (-1) → 0 - x  ;  x / (-1) → 0 - x  ;  x % (-1) → 0
        // neg(neg(x)) → IrCopy(x)
        // SOTA: LLVM InstCombine; Cooper & Torczon §9 — negation is an algebraic
        //       inverse; propagating it eliminates redundant sign inversions.
        if ocp_is_binop(instr.op) {
            let mn_s1 = instr.src1
            let mn_s2 = instr.src2
            let mn_s1_ok = mn_s1 >= 0 && mn_s1 < 256
            let mn_s2_ok = mn_s2 >= 0 && mn_s2 < 256
            let mn_s2_k = mn_s2_ok && is_const[mn_s2 as usize]
            let mn_s1_k = mn_s1_ok && is_const[mn_s1 as usize]
            // x * (-1) → 0 - x  ;  x / (-1) → 0 - x
            if instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                if mn_s2_k && const_val[mn_s2 as usize] == -1 && !mn_s1_k {
                    let c_def = def_at[mn_s2 as usize]
                    if c_def >= 0 {
                        result.instrs[c_def as usize] = ir_load_imm(mn_s2, 0)
                        const_val[mn_s2 as usize] = 0
                    }
                    result.instrs[i as usize] = ir_binop(instr.dst, mn_s2, BinaryOp::OpSub, mn_s1)
                }
                // (-1) * x → 0 - x  (commutative flip: s1 is const -1, s2 is var)
                if mn_s1_k && const_val[mn_s1 as usize] == -1 && !mn_s2_k {
                    let c_def = def_at[mn_s1 as usize]
                    if c_def >= 0 {
                        result.instrs[c_def as usize] = ir_load_imm(mn_s1, 0)
                        const_val[mn_s1 as usize] = 0
                    }
                    result.instrs[i as usize] = ir_binop(instr.dst, mn_s1, BinaryOp::OpSub, mn_s2)
                }
            }
            // x % (-1) → IrLoadImm(0)  (remainder by -1 is always 0)
            if instr.bin_op == BinaryOp::OpRem {
                if mn_s2_k && const_val[mn_s2 as usize] == -1 {
                    result.instrs[i as usize] = ir_load_imm(instr.dst, 0)
                    if instr.dst >= 0 && instr.dst < 256 {
                        is_const[instr.dst as usize] = true
                        const_val[instr.dst as usize] = 0
                    }
                }
            }
        }
        // neg(neg(x)) → IrCopy(x)  (double negation elimination)
        if result.instrs[i as usize].op == IrOpcode::IrUnaryOp
            && result.instrs[i as usize].un_op == UnaryOp::OpNeg {
            let nn_instr = result.instrs[i as usize]
            let nn_s = nn_instr.src1
            if nn_s >= 0 && nn_s < 256 && is_neg[nn_s as usize] {
                result.instrs[i as usize] = ir_copy(nn_instr.dst, neg_src[nn_s as usize])
                if nn_instr.dst >= 0 && nn_instr.dst < 256 {
                    is_neg[nn_instr.dst as usize] = false
                }
            }
        }

        // Sprint 115 Block AL: neg(a - b) → b - a  (subtract reversal through negation).
        // If the operand of OpNeg was produced by OpSub, reverse the operands.
        // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
        if result.instrs[i as usize].op == IrOpcode::IrUnaryOp
            && result.instrs[i as usize].un_op == UnaryOp::OpNeg {
            let nn_instr = result.instrs[i as usize]
            let nn_s = nn_instr.src1
            if nn_s >= 0 && nn_s < 256 && al_is_sub[nn_s as usize] {
                result.instrs[i as usize] = ir_binop(nn_instr.dst, al_sub_rhs[nn_s as usize], BinaryOp::OpSub, al_sub_lhs[nn_s as usize])
                if nn_instr.dst >= 0 && nn_instr.dst < 256 {
                    is_neg[nn_instr.dst as usize] = false
                }
            }
        }

        // Sprint 115 Block AL: 0 - (a - b) → b - a  (explicit zero-minus form).
        // If s1 is const 0 and s2 was produced by OpSub, reverse the operands.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let zm_instr = result.instrs[i as usize]
            if zm_instr.bin_op == BinaryOp::OpSub {
                let s1 = zm_instr.src1
                let s2 = zm_instr.src2
                let s1_ok = s1 >= 0 && s1 < 256
                let s2_ok = s2 >= 0 && s2 < 256
                if s1_ok && is_const[s1 as usize] && const_val[s1 as usize] == 0
                    && s2_ok && al_is_sub[s2 as usize] {
                    result.instrs[i as usize] = ir_binop(zm_instr.dst, al_sub_rhs[s2 as usize], BinaryOp::OpSub, al_sub_lhs[s2 as usize])
                }
            }
        }

        // Sprint 110 Block AG: Add/sub with negated operand simplification.
        // x + neg(y) → x - y  ;  x - neg(y) → x + y  ;  neg(x) + y → y - x.
        // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let ag_instr = result.instrs[i as usize]
            let ag_s1 = ag_instr.src1
            let ag_s2 = ag_instr.src2
            let ag_s1_ok = ag_s1 >= 0 && ag_s1 < 256
            let ag_s2_ok = ag_s2 >= 0 && ag_s2 < 256
            // x + neg(y) → x - y
            if ag_instr.bin_op == BinaryOp::OpAdd && ag_s2_ok && is_neg[ag_s2 as usize] {
                result.instrs[i as usize] = ir_binop(ag_instr.dst, ag_s1, BinaryOp::OpSub, neg_src[ag_s2 as usize])
            }
            // neg(x) + y → y - x  (commutative: neg on src1 of add)
            if ag_instr.bin_op == BinaryOp::OpAdd && ag_s1_ok && is_neg[ag_s1 as usize]
                && !(ag_s2_ok && is_neg[ag_s2 as usize]) {
                result.instrs[i as usize] = ir_binop(ag_instr.dst, ag_s2, BinaryOp::OpSub, neg_src[ag_s1 as usize])
            }
            // x - neg(y) → x + y
            if ag_instr.bin_op == BinaryOp::OpSub && ag_s2_ok && is_neg[ag_s2 as usize] {
                result.instrs[i as usize] = ir_binop(ag_instr.dst, ag_s1, BinaryOp::OpAdd, neg_src[ag_s2 as usize])
            }
        }

        // Sprint 112 Block AI: Bitwise NOT via XOR(-1) tracking + double-NOT.
        // Track r = x ^ (-1) as NOT(x).  NOT(NOT(x)) → IrCopy(x).
        // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-2.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bn_instr = result.instrs[i as usize]
            if bn_instr.bin_op == BinaryOp::OpBitXor {
                let bn_s1 = bn_instr.src1
                let bn_s2 = bn_instr.src2
                let bn_s1_ok = bn_s1 >= 0 && bn_s1 < 256
                let bn_s2_ok = bn_s2 >= 0 && bn_s2 < 256
                // x ^ (-1): s2 is const -1
                if bn_s2_ok && is_const[bn_s2 as usize] && const_val[bn_s2 as usize] == -1 && bn_s1_ok {
                    // Double-NOT: src1 was itself x ^ (-1)
                    if is_bnot[bn_s1 as usize] {
                        result.instrs[i as usize] = ir_copy(bn_instr.dst, bnot_src[bn_s1 as usize])
                        if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                            is_bnot[bn_instr.dst as usize] = false
                        }
                    } else {
                        // Track: dst = NOT(src1)
                        if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                            is_bnot[bn_instr.dst as usize] = true
                            bnot_src[bn_instr.dst as usize] = bn_s1
                        }
                    }
                }
                // (-1) ^ x: s1 is const -1 (commutative)
                if bn_s1_ok && is_const[bn_s1 as usize] && const_val[bn_s1 as usize] == -1 && bn_s2_ok {
                    if is_bnot[bn_s2 as usize] {
                        result.instrs[i as usize] = ir_copy(bn_instr.dst, bnot_src[bn_s2 as usize])
                        if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                            is_bnot[bn_instr.dst as usize] = false
                        }
                    } else {
                        if bn_instr.dst >= 0 && bn_instr.dst < 256 {
                            is_bnot[bn_instr.dst as usize] = true
                            bnot_src[bn_instr.dst as usize] = bn_s2
                        }
                    }
                }
            }
        }

        // Sprint 69: Constant propagation through IrCopy.
        // Re-reads current instruction to catch copies created by identity folding (Sprint 67).
        // When r1 = IrCopy(r0) and r0 is a known constant, mark r1 constant too,
        // enabling subsequent BinOp folding and strength reduction at i+1, i+2, etc.
        if result.instrs[i as usize].op == IrOpcode::IrCopy {
            let ci = result.instrs[i as usize]
            let src = ci.src1
            let dst = ci.dst
            if src >= 0 && src < 256 && dst >= 0 && dst < 256 {
                if is_const[src as usize] {
                    is_const[dst as usize] = true
                    const_val[dst as usize] = const_val[src as usize]
                    def_at[dst as usize] = def_at[src as usize]
                }
            }
        }

        // Sprint 84 Block L: Associative constant-chain folding.
        // Detects the pattern: r1 = (base assoc_op c1), r2 = r1 assoc_op c2
        // and folds to: r2 = base assoc_op (c1 assoc_op c2).
        // In-place: patches def_at[c2_reg] → IrLoadImm(c2_reg, combined)
        //           patches current instr   → IrBinOp(dst, base, op, c2_reg)
        // r1 becomes dead → DCE removes it on next pass.
        // Sub-pass 2: records has_ra metadata for future chain folding.
        // Supports Add, Mul, BitAnd, BitOr, BitXor (associative over integers).
        // Runs before power-of-two strength reduction so mul chains still see
        // their original OpMul shape long enough to reassociate.
        // SOTA: Click "Combining Reductions" PLDI 1995 §4;
        //   Aho, Lam, Sethi, Ullman "Compilers" §8.5 (reassociation of constants).
        if ocp_is_binop(result.instrs[i as usize].op) {
            let la_instr = result.instrs[i as usize]
            let la_s1 = la_instr.src1
            let la_s2 = la_instr.src2
            let la_s1_ok = la_s1 >= 0 && la_s1 < 256
            let la_s2_ok = la_s2 >= 0 && la_s2 < 256
            let la_ra_key = ocp_binop_to_ra_key(la_instr.bin_op)
            // Sub-pass 1: fold (base assoc c1) assoc c2 → base assoc (c1+c2)
            if la_ra_key != 0 && la_s1_ok && la_s2_ok
                && has_ra[la_s1 as usize]
                && ra_op[la_s1 as usize] == la_ra_key
                && is_const[la_s2 as usize] {
                let la_c1 = ra_const_val[la_s1 as usize]
                let la_c2 = const_val[la_s2 as usize]
                let la_c2_def = def_at[la_s2 as usize]
                let la_base = ra_base[la_s1 as usize]
                var la_combined: i64 = 0
                var la_did = false
                if la_instr.bin_op == BinaryOp::OpAdd    { la_combined = la_c1 + la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpMul    { la_combined = la_c1 * la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitAnd { la_combined = la_c1 & la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitOr  { la_combined = la_c1 | la_c2; la_did = true }
                if la_instr.bin_op == BinaryOp::OpBitXor { la_combined = la_c1 ^ la_c2; la_did = true }
                if la_did && la_c2_def >= 0 {
                    result.instrs[la_c2_def as usize] = ir_load_imm(la_s2, la_combined)
                    result.instrs[i as usize] = ir_binop(la_instr.dst, la_base, la_instr.bin_op, la_s2)
                    const_val[la_s2 as usize] = la_combined
                    if la_instr.dst >= 0 && la_instr.dst < 256 {
                        has_ra[la_instr.dst as usize] = true
                        ra_base[la_instr.dst as usize] = la_base
                        ra_const_val[la_instr.dst as usize] = la_combined
                        ra_op[la_instr.dst as usize] = la_ra_key
                    }
                    if la_instr.bin_op == BinaryOp::OpMul {
                        preserve_mul_chain = true
                    }
                }
            }
            // Sub-pass 2: record has_ra for the (possibly rewritten) current instr.
            let la_rec = result.instrs[i as usize]
            let la_rec_s1 = la_rec.src1
            let la_rec_s2 = la_rec.src2
            let la_rec_s1_ok = la_rec_s1 >= 0 && la_rec_s1 < 256
            let la_rec_s2_ok = la_rec_s2 >= 0 && la_rec_s2 < 256
            let la_rec_key = ocp_binop_to_ra_key(la_rec.bin_op)
            if la_rec_key != 0 && ocp_is_binop(la_rec.op)
                && la_rec.dst >= 0 && la_rec.dst < 256
                && la_rec_s1_ok && la_rec_s2_ok {
                // s1 non-const, s2 const
                if !is_const[la_rec_s1 as usize] && is_const[la_rec_s2 as usize] {
                    has_ra[la_rec.dst as usize] = true
                    ra_base[la_rec.dst as usize] = la_rec_s1
                    ra_const_val[la_rec.dst as usize] = const_val[la_rec_s2 as usize]
                    ra_op[la_rec.dst as usize] = la_rec_key
                }
                // s1 const, s2 non-const (commutative assoc ops only)
                if is_const[la_rec_s1 as usize] && !is_const[la_rec_s2 as usize]
                    && ocp_is_commutative_op(la_rec.bin_op) {
                    has_ra[la_rec.dst as usize] = true
                    ra_base[la_rec.dst as usize] = la_rec_s2
                    ra_const_val[la_rec.dst as usize] = const_val[la_rec_s1 as usize]
                    ra_op[la_rec.dst as usize] = la_rec_key
                }
            }
        }

        // Sprint 68: Strength reduction for power-of-2 mul/div/rem.
        // Re-reads the current instruction so previous blocks' rewrites are respected.
        // Patches both the IrBinOp and the preceding IrLoadImm (via def_at) in place.
        //   x * 2^n → x << n  (OpMul → OpShl, constant patched to log2)
        //   x / 2^n → x >> n  (OpDiv → OpShr, constant patched to log2)
        //   x % 2^n → x & (2^n-1)  (OpRem → OpBitAnd, constant patched to mask)
        if ocp_is_binop(result.instrs[i as usize].op) {
            let cur = result.instrs[i as usize]
            let s2 = cur.src2
            let s1 = cur.src1
            let s2_ok = s2 >= 0 && s2 < 256
            if s2_ok && is_const[s2 as usize] {
                let v2 = const_val[s2 as usize]
                let def_idx = def_at[s2 as usize]
                if def_idx >= 0 && ocp_is_power_of_two(v2) {
                    if cur.bin_op == BinaryOp::OpMul && !preserve_mul_chain {
                        let shift = ocp_log2(v2)
                        result.instrs[def_idx as usize] = ir_load_imm(s2, shift)
                        result.instrs[i as usize] = ir_binop(cur.dst, s1, BinaryOp::OpShl, s2)
                        const_val[s2 as usize] = shift
                    }
                    if cur.bin_op == BinaryOp::OpDiv {
                        let shift = ocp_log2(v2)
                        result.instrs[def_idx as usize] = ir_load_imm(s2, shift)
                        result.instrs[i as usize] = ir_binop(cur.dst, s1, BinaryOp::OpShr, s2)
                        const_val[s2 as usize] = shift
                    }
                    if cur.bin_op == BinaryOp::OpRem {
                        let mask = v2 - 1
                        result.instrs[def_idx as usize] = ir_load_imm(s2, mask)
                        result.instrs[i as usize] = ir_binop(cur.dst, s1, BinaryOp::OpBitAnd, s2)
                        const_val[s2 as usize] = mask
                    }
                }
            }
        }

        // Sprint 71 Block A: Same-register algebraic fold.
        // When src1 == src2 for certain ops the result is statically known.
        //   x - x → 0   (OpSub with same register)
        //   x ^ x → 0   (OpBitXor with same register)
        if ocp_is_binop(result.instrs[i as usize].op) {
            let sr_instr = result.instrs[i as usize]
            let sr_s1 = sr_instr.src1
            let sr_s2 = sr_instr.src2
            if sr_s1 >= 0 && sr_s1 == sr_s2 {
                if sr_instr.bin_op == BinaryOp::OpSub || sr_instr.bin_op == BinaryOp::OpBitXor {
                    result.instrs[i as usize] = ir_load_imm(sr_instr.dst, 0)
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 0
                        def_at[sr_instr.dst as usize] = i
                    }
                }
                // Sprint 72 Block D: Bitwise same-register idempotency.
                // x & x → IrCopy(dst, x)  ;  x | x → IrCopy(dst, x)
                if sr_instr.bin_op == BinaryOp::OpBitAnd || sr_instr.bin_op == BinaryOp::OpBitOr {
                    result.instrs[i as usize] = ir_copy(sr_instr.dst, sr_s1)
                }
                // Sprint 95 Block S: Same-register division/remainder.
                // x / x → 1   (assuming x ≠ 0; statically sound for non-zero regs)
                if sr_instr.bin_op == BinaryOp::OpDiv {
                    result.instrs[i as usize] = ir_load_imm(sr_instr.dst, 1)
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 1
                        def_at[sr_instr.dst as usize] = i
                    }
                }
                // x % x → 0
                if sr_instr.bin_op == BinaryOp::OpRem {
                    result.instrs[i as usize] = ir_load_imm(sr_instr.dst, 0)
                    if sr_instr.dst >= 0 && sr_instr.dst < 256 {
                        is_const[sr_instr.dst as usize] = true
                        const_val[sr_instr.dst as usize] = 0
                        def_at[sr_instr.dst as usize] = i
                    }
                }
            }
        }

        // Sprint 71 Block B: Left-constant commutative strength reduction.
        // Sprint 68 SR only fires when the constant is on src2 (right).
        // For OpMul (commutative), when a power-of-2 constant is on src1 (left),
        // apply the same SR: 4 * x → x << 2.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let cm_instr = result.instrs[i as usize]
            let cm_s1 = cm_instr.src1
            let cm_s2 = cm_instr.src2
            let cm_s1_ok = cm_s1 >= 0 && cm_s1 < 256
            let cm_s2_ok = cm_s2 >= 0 && cm_s2 < 256
            if cm_instr.bin_op == BinaryOp::OpMul {
                if cm_s1_ok && cm_s2_ok && is_const[cm_s1 as usize] && !is_const[cm_s2 as usize] {
                    let cm_v1 = const_val[cm_s1 as usize]
                    let cm_def = def_at[cm_s1 as usize]
                    if cm_def >= 0 && ocp_is_power_of_two(cm_v1) {
                        let shift = ocp_log2(cm_v1)
                        result.instrs[cm_def as usize] = ir_load_imm(cm_s1, shift)
                        result.instrs[i as usize] = ir_binop(cm_instr.dst, cm_s2, BinaryOp::OpShl, cm_s1)
                        const_val[cm_s1 as usize] = shift
                    }
                }
            }
        }

        // Sprint 96 Block T: Shift-chain combining.
        // (x << C1) << C2 → x << (C1+C2)  ;  (x >> C1) >> C2 → x >> (C1+C2).
        // The fold fires when src1 was itself a shift-by-constant with the same direction.
        // After folding, track the result for further chaining.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let sh_instr = result.instrs[i as usize]
            let sh_s1 = sh_instr.src1
            let sh_s2 = sh_instr.src2
            let sh_s1_ok = sh_s1 >= 0 && sh_s1 < 256
            let sh_s2_ok = sh_s2 >= 0 && sh_s2 < 256
            let sh_is_shl = sh_instr.bin_op == BinaryOp::OpShl
            let sh_is_shr = sh_instr.bin_op == BinaryOp::OpShr
            if (sh_is_shl || sh_is_shr) && sh_s1_ok && sh_s2_ok && is_const[sh_s2 as usize] {
                let sh_c2 = const_val[sh_s2 as usize]
                // Fold: src1 was tracked as (base shift C1), same direction → combine.
                if sh_valid[sh_s1 as usize]
                    && ((sh_is_shl && sh_is_left[sh_s1 as usize]) || (sh_is_shr && !sh_is_left[sh_s1 as usize])) {
                    let sh_c1 = sh_amount[sh_s1 as usize]
                    let sh_base = sh_var_src[sh_s1 as usize]
                    let sh_combined = sh_c1 + sh_c2
                    let sh_c2_def = def_at[sh_s2 as usize]
                    if sh_c2_def >= 0 && sh_combined >= 0 && sh_combined < 64 {
                        result.instrs[sh_c2_def as usize] = ir_load_imm(sh_s2, sh_combined)
                        result.instrs[i as usize] = ir_binop(sh_instr.dst, sh_base, sh_instr.bin_op, sh_s2)
                        const_val[sh_s2 as usize] = sh_combined
                        if sh_instr.dst >= 0 && sh_instr.dst < 256 {
                            sh_valid[sh_instr.dst as usize] = true
                            sh_var_src[sh_instr.dst as usize] = sh_base
                            sh_amount[sh_instr.dst as usize] = sh_combined
                            sh_is_left[sh_instr.dst as usize] = sh_is_shl
                        }
                    }
                // Sprint 109 Block AF: Opposite-direction shift pair → AND mask.
                // (x << N) >> N → x & ((1 << (64-N)) - 1)   [zero-extension]
                // (x >> N) << N → x & ~((1 << N) - 1)        [alignment mask]
                // SOTA: LLVM InstCombineShifts.cpp; Hacker's Delight §2.
                } else if sh_valid[sh_s1 as usize]
                    && ((sh_is_shl && !sh_is_left[sh_s1 as usize]) || (sh_is_shr && sh_is_left[sh_s1 as usize]))
                    && sh_amount[sh_s1 as usize] == sh_c2 {
                    let af_base = sh_var_src[sh_s1 as usize]
                    let af_n = sh_c2
                    if af_n > 0 && af_n < 64 {
                        var af_mask: i64 = 0
                        if sh_is_shr {
                            af_mask = (1 << (64 - af_n)) - 1
                        } else {
                            af_mask = -1 ^ ((1 << af_n) - 1)
                        }
                        let af_def = def_at[sh_s2 as usize]
                        if af_def >= 0 {
                            result.instrs[af_def as usize] = ir_load_imm(sh_s2, af_mask)
                            result.instrs[i as usize] = ir_binop(sh_instr.dst, af_base, BinaryOp::OpBitAnd, sh_s2)
                            const_val[sh_s2 as usize] = af_mask
                            is_const[sh_s2 as usize] = true
                            if sh_instr.dst >= 0 && sh_instr.dst < 256 {
                                and_valid[sh_instr.dst as usize]     = true
                                and_var_src[sh_instr.dst as usize]   = af_base
                                and_const_val[sh_instr.dst as usize] = af_mask
                                sh_valid[sh_instr.dst as usize] = false
                            }
                        }
                    }
                } else {
                    // Track: r = x << C or r = x >> C.
                    if sh_instr.dst >= 0 && sh_instr.dst < 256 {
                        sh_valid[sh_instr.dst as usize] = true
                        sh_var_src[sh_instr.dst as usize] = sh_s1
                        sh_amount[sh_instr.dst as usize] = sh_c2
                        sh_is_left[sh_instr.dst as usize] = sh_is_shl
                    }
                }
            }
        }

        // Sprint 74 Block E: Comparison operator constant folding.
        // References: Wegman & Zadeck, "Constant Propagation with Conditional Branches"
        //   (TOPLAS 1991) §2 — comparison lattice values are the foundation for SCCP.
        //
        // Both-constant: fold OpEq/Ne/Lt/Le/Gt/Ge when both srcs are known integers.
        //   5 == 5 → IrLoadImm(dst, 1)   5 != 5 → IrLoadImm(dst, 0)
        //   3 < 7  → IrLoadImm(dst, 1)   7 < 3  → IrLoadImm(dst, 0)
        //   3 <= 3 → IrLoadImm(dst, 1)   3 > 3  → IrLoadImm(dst, 0)
        //
        // Same-register: fold when src1 == src2 (reflexive relations).
        //   x == x → 1   x != x → 0
        //   x < x  → 0   x <= x → 1
        //   x > x  → 0   x >= x → 1
        if ocp_is_binop(result.instrs[i as usize].op) {
            let cmp = result.instrs[i as usize]
            let cmp_s1 = cmp.src1
            let cmp_s2 = cmp.src2
            let cmp_is_cmp =
                cmp.bin_op == BinaryOp::OpEq || cmp.bin_op == BinaryOp::OpNe
                || cmp.bin_op == BinaryOp::OpLt || cmp.bin_op == BinaryOp::OpLe
                || cmp.bin_op == BinaryOp::OpGt || cmp.bin_op == BinaryOp::OpGe
            if cmp_is_cmp {
                let cmp_s1_ok = cmp_s1 >= 0 && cmp_s1 < 256
                let cmp_s2_ok = cmp_s2 >= 0 && cmp_s2 < 256
                // Both-constant fold
                if cmp_s1_ok && cmp_s2_ok && is_const[cmp_s1 as usize] && is_const[cmp_s2 as usize] {
                    let cv1 = const_val[cmp_s1 as usize]
                    let cv2 = const_val[cmp_s2 as usize]
                    var cmp_result: i64 = 0
                    if cmp.bin_op == BinaryOp::OpEq { cmp_result = if cv1 == cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpNe { cmp_result = if cv1 != cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpLt { cmp_result = if cv1 < cv2  { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpLe { cmp_result = if cv1 <= cv2 { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpGt { cmp_result = if cv1 > cv2  { 1 } else { 0 } }
                    if cmp.bin_op == BinaryOp::OpGe { cmp_result = if cv1 >= cv2 { 1 } else { 0 } }
                    result.instrs[i as usize] = ir_load_imm(cmp.dst, cmp_result)
                    if cmp.dst >= 0 && cmp.dst < 256 {
                        is_const[cmp.dst as usize] = true
                        const_val[cmp.dst as usize] = cmp_result
                        def_at[cmp.dst as usize] = i
                    }
                }
                // Same-register fold
                if cmp_s1_ok && cmp_s1 == cmp_s2 {
                    var sr_cmp: i64 = 0
                    if cmp.bin_op == BinaryOp::OpEq { sr_cmp = 1 }
                    if cmp.bin_op == BinaryOp::OpNe { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpLt { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpLe { sr_cmp = 1 }
                    if cmp.bin_op == BinaryOp::OpGt { sr_cmp = 0 }
                    if cmp.bin_op == BinaryOp::OpGe { sr_cmp = 1 }
                    result.instrs[i as usize] = ir_load_imm(cmp.dst, sr_cmp)
                    if cmp.dst >= 0 && cmp.dst < 256 {
                        is_const[cmp.dst as usize] = true
                        const_val[cmp.dst as usize] = sr_cmp
                        def_at[cmp.dst as usize] = i
                    }
                }
            }
        }

        // Sprint 101 Block Y: Track comparison results for boolean simplification.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bl = result.instrs[i as usize]
            let bl_d = bl.dst
            if bl_d >= 0 && bl_d < 256 {
                if bl.bin_op == BinaryOp::OpEq {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 1
                }
                if bl.bin_op == BinaryOp::OpNe {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 2
                }
                if bl.bin_op == BinaryOp::OpLt || bl.bin_op == BinaryOp::OpLe
                        || bl.bin_op == BinaryOp::OpGt || bl.bin_op == BinaryOp::OpGe {
                    is_cmp_result[bl_d as usize] = true
                    cmp_orig_src[bl_d as usize] = bl.src1
                    cmp_op_code[bl_d as usize] = 3
                }
            }
        }

        // Sprint 101 Block Y: Boolean simplification.
        // (x == 0) == 0 → IrCopy(x)  (double boolean negation)
        // (x != 0) != 0 → IrCopy(x)  (double negation via Ne)
        // bool != 0 → IrCopy(bool)   (general: any comparison result != 0 is identity)
        // 0 == (x == 0) → IrCopy(x)  (commutative variant)
        // SOTA: LLVM InstCombineCompares.cpp; Click PLDI 1995 §2.
        if ocp_is_binop(result.instrs[i as usize].op) {
            let bl = result.instrs[i as usize]
            let bl_s1 = bl.src1
            let bl_s2 = bl.src2
            let bl_s1_ok = bl_s1 >= 0 && bl_s1 < 256
            let bl_s2_ok = bl_s2 >= 0 && bl_s2 < 256
            // (x == 0) == 0 → IrCopy(x): s2 is const 0, s1 is cmp_result with OpEq, cmp_orig_src[s1]=x
            if bl.bin_op == BinaryOp::OpEq && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize]
                    && cmp_op_code[bl_s1 as usize] == 1 {
                let orig = cmp_orig_src[bl_s1 as usize]
                result.instrs[i as usize] = ir_copy(bl.dst, orig)
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // (x != 0) != 0 → IrCopy(x)
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize]
                    && cmp_op_code[bl_s1 as usize] == 2 {
                let orig = cmp_orig_src[bl_s1 as usize]
                result.instrs[i as usize] = ir_copy(bl.dst, orig)
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // bool != 0 → IrCopy(bool): any comparison result != 0 is identity
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 0
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                result.instrs[i as usize] = ir_copy(bl.dst, bl_s1)
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // 0 == (x == 0) → IrCopy(x): commutative — const on left, cmp_result on right
            if bl.bin_op == BinaryOp::OpEq && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 0
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize]
                    && cmp_op_code[bl_s2 as usize] == 1 {
                let orig = cmp_orig_src[bl_s2 as usize]
                result.instrs[i as usize] = ir_copy(bl.dst, orig)
                if bl.dst >= 0 && bl.dst < 256 {
                    is_cmp_result[bl.dst as usize] = false
                }
            }
            // Sprint 113 Block AJ: Boolean comparison with 1.
            // bool == 1 → IrCopy(bool)  (comparison results are 0 or 1)
            // 1 == bool → IrCopy(bool)  (commutative)
            // bool != 1 → (bool == 0)   (boolean negation — rewrite to Eq with 0)
            // SOTA: LLVM InstCombineCompares.cpp; standard boolean identity.
            // s2 is const 1, s1 is comparison result
            if bl.bin_op == BinaryOp::OpEq && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 1
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                result.instrs[i as usize] = ir_copy(bl.dst, bl_s1)
            }
            // s1 is const 1, s2 is comparison result (commutative)
            if bl.bin_op == BinaryOp::OpEq && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 1
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize] {
                result.instrs[i as usize] = ir_copy(bl.dst, bl_s2)
            }
            // bool != 1 → rewrite to (bool == 0): keeps boolean semantics,
            // enables further (x==0)==0 folding by Block Y on next pass.
            if bl.bin_op == BinaryOp::OpNe && bl_s2_ok && is_const[bl_s2 as usize]
                    && const_val[bl_s2 as usize] == 1
                    && bl_s1_ok && is_cmp_result[bl_s1 as usize] {
                let aj_def = def_at[bl_s2 as usize]
                if aj_def >= 0 {
                    result.instrs[aj_def as usize] = ir_load_imm(bl_s2, 0)
                    const_val[bl_s2 as usize] = 0
                    result.instrs[i as usize] = ir_binop(bl.dst, bl_s1, BinaryOp::OpEq, bl_s2)
                }
            }
            // 1 != bool → rewrite to (bool == 0) (commutative)
            if bl.bin_op == BinaryOp::OpNe && bl_s1_ok && is_const[bl_s1 as usize]
                    && const_val[bl_s1 as usize] == 1
                    && bl_s2_ok && is_cmp_result[bl_s2 as usize] {
                let aj_def = def_at[bl_s1 as usize]
                if aj_def >= 0 {
                    result.instrs[aj_def as usize] = ir_load_imm(bl_s1, 0)
                    const_val[bl_s1 as usize] = 0
                    result.instrs[i as usize] = ir_binop(bl.dst, bl_s2, BinaryOp::OpEq, bl_s1)
                }
            }
        }

                // Sprint 75 Block F: Conditional branch folding.
        // When a branch condition register holds a known constant, the branch outcome is static.
        // IrBranchTrue(r, L)  + is_const[r]=true + const_val[r]!=0 → IrJump(L)
        // IrBranchTrue(r, L)  + is_const[r]=true + const_val[r]==0 → IrNop
        // IrBranchFalse(r, L) + is_const[r]=true + const_val[r]==0 → IrJump(L)
        // IrBranchFalse(r, L) + is_const[r]=true + const_val[r]!=0 → IrNop
        // SOTA: Wegman & Zadeck TOPLAS 1991 §3 (executable edge marking);
        //   Cooper & Torczon §9.3 (dead-branch elimination via constant condition).
        if result.instrs[i as usize].op == IrOpcode::IrBranchTrue
            || result.instrs[i as usize].op == IrOpcode::IrBranchFalse {
            let br = result.instrs[i as usize]
            let br_cond = br.src1
            if br_cond >= 0 && br_cond < 256 && is_const[br_cond as usize] {
                let cv = const_val[br_cond as usize]
                let taken =
                    if br.op == IrOpcode::IrBranchTrue { cv != 0 }
                    else { cv == 0 }
                if taken {
                    result.instrs[i as usize] = ir_jump(br.label_id)
                } else {
                    result.instrs[i as usize] = ir_nop()
                }
            }
        }

        // Sprint 76 Block G: Shift identity and annihilator folding.
        // Shift-by-zero identity:  x << 0 → IrCopy(x),    x >> 0 → IrCopy(x)
        // Zero-shift annihilator:  0 << n → IrLoadImm(0), 0 >> n → IrLoadImm(0)
        // SOTA: Cooper & Torczon "Engineering a Compiler" §8.1 (algebraic identities for shifts).
        if ocp_is_binop(result.instrs[i as usize].op) {
            let sh = result.instrs[i as usize]
            if sh.bin_op == BinaryOp::OpShl || sh.bin_op == BinaryOp::OpShr {
                let sh_s1 = sh.src1
                let sh_s2 = sh.src2
                let sh_s1_ok = sh_s1 >= 0 && sh_s1 < 256
                let sh_s2_ok = sh_s2 >= 0 && sh_s2 < 256
                // Shift-by-zero identity: x << 0 → IrCopy(x), x >> 0 → IrCopy(x)
                if sh_s2_ok && is_const[sh_s2 as usize] && const_val[sh_s2 as usize] == 0 {
                    result.instrs[i as usize] = ir_copy(sh.dst, sh_s1)
                // Zero-shift annihilator: 0 << n → 0, 0 >> n → 0
                } else if sh_s1_ok && is_const[sh_s1 as usize] && const_val[sh_s1 as usize] == 0 {
                    result.instrs[i as usize] = ir_load_imm(sh.dst, 0)
                    if sh.dst >= 0 && sh.dst < 256 {
                        is_const[sh.dst as usize] = true
                        const_val[sh.dst as usize] = 0
                        def_at[sh.dst as usize] = i
                    }
                }
            }
        }

        i = i + 1
    }

    result
}

// ============================================================================
// Pass 2: Dead code elimination (mark-sweep)
// ============================================================================

// Mark which registers are used as source operands across the function.
fn ocp_mark_used(func: &IrFunction) -> [bool; 256] with Mut, Div, Panic {
    var used: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.src1 >= 0 && instr.src1 < 256 {
            used[instr.src1 as usize] = true
        }
        if instr.src2 >= 0 && instr.src2 < 256 {
            used[instr.src2 as usize] = true
        }
        i = i + 1
    }
    used
}

// Sweep: remove instructions whose dst is unused and have no side effects.
fn ocp_sweep(func: IrFunction, used: &[bool; 256]) -> (IrFunction, i64) with Mut, Div, Panic {
    var result = func
    var removed: i64 = 0
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if ocp_has_dst(instr.op) && !ocp_has_side_effect(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                if !used[instr.dst as usize] {
                    result.instrs[i as usize] = ir_nop()
                    removed = removed + 1
                }
            }
        }
        i = i + 1
    }
    (result, removed)
}

// Run one DCE sweep on a single function.
fn ocp_dce_once(func: IrFunction) -> (IrFunction, i64) with Mut, Div, Panic {
    let used = ocp_mark_used(&func)
    ocp_sweep(func, &used)
}

// Run DCE on a single function.
fn ocp_dce(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    let swept = ocp_dce_once(func)
    swept.0
}

// ============================================================================
// Sprint 72: E-graph equality saturation pass (full, deferred)
// ============================================================================

// E-graph equality saturation pass (Sprint 72 foundation).
//
// Architecture: IR function → EgGraph (IR opcodes mapped to EG_OP_*)
//   → eg_algebraic_saturate → cost-based extraction → patched IR.
//
// Activation guard: currently deferred (func.instr_count > 0 always skips).
// EgContext is ~4MB on the interpreter stack; activates when souc runs
// natively instead of under double-JIT interpretation.  The wiring,
// ocp_binop_to_eg_op bridge, and extract-back logic are all present and
// correct — only the guard prevents double-JIT OOM.
fn ocp_egraph_pass(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    // Deferred: activate when EgContext allocation is safe (native souc).
    // All structural integration (module import, binop bridge, call site
    // in opt_cleanup_function) is live; only this guard prevents execution.
    if func.instr_count > 0 { return func }
    func
}

// ============================================================================
// Sprint 73: Common Subexpression Elimination (CSE)
// ============================================================================
//
// Forward single-pass scan over IrBinOp instructions.  For each IrBinOp,
// check a table of previously seen (eg_op_key, src1, src2) triples.
// On match: rewrite to IrCopy(dst, prev_dst).  DCE downstream removes any
// now-dead definitions.
//
// Only mapped ops (OpAdd/Sub/Mul/Div → EG_OP_ADD/SUB/MUL/DIV) are eligible;
// unmapped ops (AND/OR/XOR → EG_OP_CONST) are excluded conservatively.
//
// References:
//   Cooper & Torczon: "Engineering a Compiler", Ch. 8 (Value Numbering / CSE)
fn ocp_cse_invalidate_reg(
    cse_op: [i64; 128],
    cse_src1: [i64; 128],
    cse_src2: [i64; 128],
    cse_dst: [i64; 128],
    cse_len: i64,
    reg: i64
) -> ([i64; 128], [i64; 128], [i64; 128], [i64; 128], i64) with Mut, Div, Panic {
    var next_op = cse_op
    var next_src1 = cse_src1
    var next_src2 = cse_src2
    var next_dst = cse_dst
    var out_len: i64 = 0
    var i: i64 = 0
    while i < cse_len {
        let matches_src1 = next_src1[i as usize] == reg
        let matches_src2 = next_src2[i as usize] == reg
        let matches_dst = next_dst[i as usize] == reg
        if !(matches_src1 || matches_src2 || matches_dst) {
            next_op[out_len as usize] = next_op[i as usize]
            next_src1[out_len as usize] = next_src1[i as usize]
            next_src2[out_len as usize] = next_src2[i as usize]
            next_dst[out_len as usize] = next_dst[i as usize]
            out_len = out_len + 1
        }
        i = i + 1
    }
    (next_op, next_src1, next_src2, next_dst, out_len)
}

// Sprint 77: Return true for commutative binary ops whose operands can be
// canonicalized (src1 ← min, src2 ← max) without changing semantics.
fn ocp_is_commutative_op(bin_op: BinaryOp) -> bool {
    bin_op == BinaryOp::OpAdd || bin_op == BinaryOp::OpMul
    || bin_op == BinaryOp::OpOr || bin_op == BinaryOp::OpAnd
    || bin_op == BinaryOp::OpBitXor
}

fn ocp_cse(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result  = func
    var cse_op:   [i64; 128] = [0; 128]
    var cse_src1: [i64; 128] = [0; 128]
    var cse_src2: [i64; 128] = [0; 128]
    var cse_dst:  [i64; 128] = [0; 128]
    var cse_len: i64 = 0
    var i: i64 = 0
    while i < result.instr_count {
        let instr   = result.instrs[i as usize]
        if ocp_has_dst(instr.op) && instr.dst >= 0 {
            let invalidated = ocp_cse_invalidate_reg(cse_op, cse_src1, cse_src2, cse_dst, cse_len, instr.dst)
            cse_op = invalidated.0
            cse_src1 = invalidated.1
            cse_src2 = invalidated.2
            cse_dst = invalidated.3
            cse_len = invalidated.4
        }
        if ocp_is_binop(instr.op) {
            let op_key = ocp_binop_to_cse_key(instr.bin_op)
            if op_key != 0 {
                // Sprint 77 Block H: Commutative CSE canonicalization.
                // For commutative ops, sort (src1, src2) so smaller register is first.
                // This makes a+b and b+a hash to the same CSE table entry.
                // SOTA: Click "Value Numbering" PLDI 1995 §3.1 (canonical operand ordering).
                var cse_s1 = instr.src1
                var cse_s2 = instr.src2
                if ocp_is_commutative_op(instr.bin_op) && cse_s1 > cse_s2 {
                    let tmp = cse_s1
                    cse_s1 = cse_s2
                    cse_s2 = tmp
                }
                var j: i64 = 0
                var found: i64 = 0 - 1
                while j < cse_len {
                    let same_op = cse_op[j as usize] == op_key
                    let same_src1 = cse_src1[j as usize] == cse_s1
                    let same_src2 = cse_src2[j as usize] == cse_s2
                    if same_op && same_src1 && same_src2 {
                        found = j
                        break
                    }
                    j = j + 1
                }
                if found >= 0 {
                    result.instrs[i as usize] = ir_copy(instr.dst, cse_dst[found as usize])
                } else {
                    if cse_len < 128 {
                        cse_op[cse_len as usize]   = op_key
                        cse_src1[cse_len as usize] = cse_s1
                        cse_src2[cse_len as usize] = cse_s2
                        cse_dst[cse_len as usize]  = instr.dst
                        cse_len = cse_len + 1
                    }
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 73: Mini e-graph pass — live activation for small functions
// ============================================================================
//
// Uses EgSmallContext (~7KB stack) instead of EgContext (~4MB).
// Activates when func.instr_count <= 4: scans for the first mapped IrBinOp,
// builds a tiny e-graph with var nodes for its operands, saturates with
// algebraic rules (add-identity, mul-identity, sub-self), and patches the
// instruction if extraction finds a cheaper form (VAR or CONST).
fn ocp_egraph_mini_pass(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    // Sprint 74: expanded activation from ≤4 to ≤8 instrs (EgSmallContext 64 nodes, still ~7KB)
    if func.instr_count > 8 { return func }
    var ctx = eg_small_init()
    var i: i64 = 0
    while i < func.instr_count {
        let instr  = func.instrs[i as usize]
        if ocp_is_binop(instr.op) {
            let eg_op = ocp_binop_to_eg_op(instr.bin_op)
            if eg_op != EG_OP_CONST {
                let lhs  = eg_small_add_var(&! ctx, instr.src1)
                let rhs  = eg_small_add_var(&! ctx, instr.src2)
                let root = eg_small_add_binop(&! ctx, eg_op, lhs, rhs)
                eg_small_saturate(&! ctx)
                let extracted = eg_small_extract(&! ctx, root)
                if extracted.op == EG_OP_VAR {
                    let src = if extracted.value == instr.src1 { instr.src1 } else { instr.src2 }
                    var result = func
                    result.instrs[i as usize] = ir_copy(instr.dst, src)
                    return result
                }
                if extracted.op == EG_OP_CONST {
                    var result = func
                    result.instrs[i as usize] = ir_load_imm(instr.dst, extracted.value)
                    return result
                }
            }
        }
        i = i + 1
    }
    func
}

// ============================================================================
// Public API
// ============================================================================

struct OptCleanupResult {
    module: IrModule,
    functions_processed: i64,
    instrs_folded: i64,
}

// ============================================================================
// Sprint 87 Block N: IrLoadImm deduplication (LVN constant CSE)
// ============================================================================
// For each IrLoadImm(dst, v), if an earlier register already holds v, replace
// with IrCopy(dst, prior_reg). Reduces register pressure; downstream copy
// propagation in ocp_const_fold eliminates the redundant load.
// SOTA: Cooper & Torczon §8.4 LVN; Click PLDI 1995 §2 value numbering.
fn ocp_dedup_imm(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var seen_const: [bool; 256] = [false; 256]
    var seen_val:   [i64;  256] = [0;     256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            var found: i64 = -1
            var j: i64 = 0
            while j < 256 {
                if seen_const[j as usize] && seen_val[j as usize] == instr.imm_i64 && j != instr.dst {
                    found = j
                    j = 256
                }
                j = j + 1
            }
            if found >= 0 {
                result.instrs[i as usize] = ir_copy(instr.dst, found)
            } else {
                seen_const[instr.dst as usize] = true
                seen_val[instr.dst as usize]   = instr.imm_i64
            }
        }
        i = i + 1
    }
    result
}

// Run dedup_imm → const_fold → egraph (full, deferred) → egraph_mini → CSE → DCE on a single IrFunction.
// ============================================================================
// Pass: Copy propagation (Block Q, Sprint 93)
// ============================================================================

// When r1 = IrCopy(r0), rewrite all subsequent uses of r1 → r0.
// Chains collapse: r1=IrCopy(r0), r2=IrCopy(r1) → r2 references r0.
// After rewriting, the original IrCopy becomes dead and is removed by DCE.
// SOTA: Cytron et al. TOPLAS 1991 §5; Cooper & Torczon §8.5.
fn ocp_copy_prop(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // copy_target[r] = the ultimate source register for r, or -1 if not a copy.
    var copy_target: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]

        // Rewrite src1 through copy chain.
        if instr.src1 >= 0 && instr.src1 < 256 && copy_target[instr.src1 as usize] >= 0 {
            result.instrs[i as usize].src1 = copy_target[instr.src1 as usize]
        }
        // Rewrite src2 through copy chain.
        if instr.src2 >= 0 && instr.src2 < 256 && copy_target[instr.src2 as usize] >= 0 {
            result.instrs[i as usize].src2 = copy_target[instr.src2 as usize]
        }

        // Re-read after rewrite.
        let cur = result.instrs[i as usize]

        // Record new copies (chase chains).
        if cur.op == IrOpcode::IrCopy && cur.dst >= 0 && cur.dst < 256 {
            let src = cur.src1
            if src >= 0 && src < 256 && copy_target[src as usize] >= 0 {
                // Chain collapse: r2=IrCopy(r1), r1=IrCopy(r0) → r2 maps to r0.
                copy_target[cur.dst as usize] = copy_target[src as usize]
                result.instrs[i as usize].src1 = copy_target[src as usize]
            } else {
                copy_target[cur.dst as usize] = src
            }
        } else if cur.dst >= 0 && cur.dst < 256 {
            // Non-copy write to dst: invalidate copy mapping.
            copy_target[cur.dst as usize] = -1
        }

        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 94 Block R: Dead Store Elimination (DSE)
// ============================================================================
//
// Forward scan: track last_write_pos[reg] = instruction index of the most
// recent write to each register.  When a register is read (as src1/src2),
// clear its last_write entry (the store is live).  When a register is written
// again and last_write is still set, the earlier write is a dead store — NOP it.
// Skips side-effecting instructions (calls, stores, branches, labels, returns).
// SOTA: Cooper & Torczon §8.4; Bodik, Gupta & Soffa PLDI 1998.
fn ocp_dse(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // last_write[r] = instruction index of most recent write to r, or -1.
    var last_write: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]

        // Mark src1 as read → its store is live (clear last_write).
        if instr.src1 >= 0 && instr.src1 < 256 {
            last_write[instr.src1 as usize] = -1
        }
        // Mark src2 as read → its store is live.
        if instr.src2 >= 0 && instr.src2 < 256 {
            last_write[instr.src2 as usize] = -1
        }

        // Check if this instruction writes to dst.
        if ocp_has_dst(instr.op) && !ocp_has_side_effect(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                let prev = last_write[instr.dst as usize]
                if prev >= 0 {
                    // Previous write to this reg was never read → dead store.
                    result.instrs[prev as usize] = ir_nop()
                }
                last_write[instr.dst as usize] = i
            }
        }

        // Labels and branches break basic blocks — conservatively clear all.
        if instr.op == IrOpcode::IrLabel || instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrBranchTrue || instr.op == IrOpcode::IrBranchFalse {
            var k: i64 = 0
            while k < 256 {
                last_write[k as usize] = -1
                k = k + 1
            }
        }

        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 97 Block U: Redundant jump elimination
// ============================================================================
//
// When IrJump(L) is immediately followed by IrLabel(L), the jump is a no-op.
// Also handles IrBranchTrue/False(cond, L) followed by IrLabel(L) — the branch
// is redundant regardless of condition (it either falls through or jumps to
// the very next instruction).
// SOTA: Muchnick §13.1 (peephole optimization); Cooper & Torczon §8.7.
fn ocp_redundant_jump(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var i: i64 = 0
    while i < result.instr_count - 1 {
        let cur = result.instrs[i as usize]
        let next = result.instrs[(i + 1) as usize]
        if next.op == IrOpcode::IrLabel {
            let target_label = next.label_id
            // IrJump(L) followed by IrLabel(L) → NOP
            if cur.op == IrOpcode::IrJump && cur.label_id == target_label {
                result.instrs[i as usize] = ir_nop()
            }
            // IrBranchTrue(cond, L) followed by IrLabel(L) → NOP (falls through either way)
            if cur.op == IrOpcode::IrBranchTrue && cur.label_id == target_label {
                result.instrs[i as usize] = ir_nop()
            }
            // IrBranchFalse(cond, L) followed by IrLabel(L) → NOP
            if cur.op == IrOpcode::IrBranchFalse && cur.label_id == target_label {
                result.instrs[i as usize] = ir_nop()
            }
        }
        i = i + 1
    }
    result
}

// Sprint 98 Block V: Unreachable code elimination
// ============================================================================
//
// After an unconditional IrJump or IrReturn, any code before the next IrLabel
// is unreachable.  NOP it out so DCE can reclaim the dead registers.
// SOTA: Muchnick §7.2 (unreachable code elimination); Cooper & Torczon §10.1.
fn ocp_dead_after_jump(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var dead = false
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLabel {
            dead = false
        }
        if dead && instr.op != IrOpcode::IrLabel {
            result.instrs[i as usize] = ir_nop()
        }
        if instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrReturn {
            dead = true
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 99 Block W: Unreachable label elimination
// ============================================================================
//
// Scan all jump/branch instructions to build a set of referenced labels.
// Then NOP any IrLabel whose label_id is not in the set.  This enables
// ocp_dead_after_jump to see through removed labels on a subsequent pass.
// SOTA: Muchnick §7.3 (dead label elimination); Appel §8.1.
fn ocp_dead_label(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // Pass 1: collect referenced label_ids (max 256 labels).
    var referenced: [bool; 256] = [false; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrBranchTrue || instr.op == IrOpcode::IrBranchFalse {
            if instr.label_id >= 0 && instr.label_id < 256 {
                referenced[instr.label_id as usize] = true
            }
        }
        i = i + 1
    }
    // Pass 2: NOP unreferenced labels.
    i = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLabel {
            if instr.label_id >= 0 && instr.label_id < 256 {
                if !referenced[instr.label_id as usize] {
                    result.instrs[i as usize] = ir_nop()
                }
            }
        }
        i = i + 1
    }
    result
}


// ============================================================================
// Sprint 102 Block Z: Non-pow-2 multiply strength reduction (x*3)
// ============================================================================
// x * 3 → (x + x) + x using two ADD instructions instead of MUL.
// Only handles constant 3; pow-2 cases handled by existing strength reduction.
// Two-pass: build constant lattice, then rewrite x*3 patterns.
// SOTA: LLVM InstCombine; Cooper & Torczon §8.4.
fn ocp_mul3_sr(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // Pass 1: build constant lattice
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var def_at: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            is_const[instr.dst as usize] = true
            const_val[instr.dst as usize] = instr.imm_i64
            def_at[instr.dst as usize] = i
        }
        i = i + 1
    }
    // Pass 2: rewrite x * 3 patterns
    i = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrBinOp && instr.bin_op == BinaryOp::OpMul {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1_k = s1 >= 0 && s1 < 256 && is_const[s1 as usize]
            let s2_k = s2 >= 0 && s2 < 256 && is_const[s2 as usize]
            // Skip if both const — const_fold handles that
            if s1_k && s2_k {
                i = i + 1
                continue
            }
            // x * 3: s2 is const 3, s1 is variable
            if s2_k && const_val[s2 as usize] == 3 && !s1_k {
                // Rewrite IrLoadImm(rC, 3) → IrBinOp(rC, s1, OpAdd, s1)
                let c_def = def_at[s2 as usize]
                if c_def >= 0 {
                    result.instrs[c_def as usize] = ir_binop(s2, s1, BinaryOp::OpAdd, s1)
                    is_const[s2 as usize] = false
                }
                // Rewrite mul → IrBinOp(dst, rC, OpAdd, s1)
                result.instrs[i as usize] = ir_binop(instr.dst, s2, BinaryOp::OpAdd, s1)
            }
            // 3 * x: s1 is const 3, s2 is variable
            if s1_k && const_val[s1 as usize] == 3 && !s2_k {
                let c_def = def_at[s1 as usize]
                if c_def >= 0 {
                    result.instrs[c_def as usize] = ir_binop(s1, s2, BinaryOp::OpAdd, s2)
                    is_const[s1 as usize] = false
                }
                result.instrs[i as usize] = ir_binop(instr.dst, s1, BinaryOp::OpAdd, s2)
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 103 Block AA: Loop-Invariant Code Motion (LICM)
// ============================================================================
// Detects back-edges (IrJump to earlier label) and hoists IrLoadImm
// instructions whose dst is not written elsewhere in the loop body.
// Only hoists IrLoadImm (safe: no side effects, no data dependencies).
// SOTA: Muchnick §13.2; Cooper & Torczon §10.3.
fn ocp_licm(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // Pass 1: record label positions
    var label_pos: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLabel && instr.label_id >= 0 && instr.label_id < 256 {
            label_pos[instr.label_id as usize] = i
        }
        i = i + 1
    }
    // Pass 2: detect back-edges and hoist
    i = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrJump && instr.label_id >= 0 && instr.label_id < 256 {
            let lp = label_pos[instr.label_id as usize]
            if lp >= 0 && lp < i {
                // Back-edge: loop from lp to i
                // Scan loop body for hoistable IrLoadImm
                var j: i64 = lp + 1
                while j < i {
                    let li = result.instrs[j as usize]
                    if li.op == IrOpcode::IrLoadImm && li.dst >= 0 && li.dst < 256 {
                        // Check dst not written elsewhere in loop
                        var written_elsewhere: bool = false
                        var k: i64 = lp + 1
                        while k < i {
                            if k != j {
                                let ki = result.instrs[k as usize]
                                if ki.dst == li.dst && ki.op != IrOpcode::IrNop {
                                    written_elsewhere = true
                                    k = i  // break
                                }
                            }
                            k = k + 1
                        }
                        if !written_elsewhere {
                            // Hoist: swap with loop header position
                            // Place the IrLoadImm just before the label
                            if lp > 0 {
                                let prev = result.instrs[(lp - 1) as usize]
                                result.instrs[(lp - 1) as usize] = li
                                result.instrs[j as usize] = prev
                                j = i  // break after first hoist per loop
                            }
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 104 Block AB: Global Value Numbering (GVN)
// ============================================================================
// Assigns value numbers to registers; IrBinOp with matching VN pair
// is replaced with IrCopy of the first occurrence.
// Hash table: 128 entries, linear probe, key = op*10000 + vn1*100 + vn2.
// Labels invalidate the entire table (conservative).
// SOTA: Click PLDI 1995 §2; Cooper & Torczon §8.4.
fn ocp_gvn(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var vn: [i64; 256] = [-1; 256]
    var next_vn: i64 = 0
    // Hash table
    var ht_key:  [i64; 128] = [-1; 128]
    var ht_vn:   [i64; 128] = [-1; 128]
    var ht_reg:  [i64; 128] = [-1; 128]
    var ht_used: [bool; 128] = [false; 128]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        // IrLoadImm: fresh VN
        if instr.op == IrOpcode::IrLoadImm && instr.dst >= 0 && instr.dst < 256 {
            vn[instr.dst as usize] = next_vn
            next_vn = next_vn + 1
        }
        // IrCopy: inherit VN from src
        if instr.op == IrOpcode::IrCopy && instr.dst >= 0 && instr.dst < 256 {
            if instr.src1 >= 0 && instr.src1 < 256 && vn[instr.src1 as usize] >= 0 {
                vn[instr.dst as usize] = vn[instr.src1 as usize]
            } else {
                vn[instr.dst as usize] = next_vn
                next_vn = next_vn + 1
            }
        }
        // IrLabel: invalidate hash table (conservative at control flow merge)
        if instr.op == IrOpcode::IrLabel {
            var ci: i64 = 0
            while ci < 128 {
                ht_used[ci as usize] = false
                ht_key[ci as usize] = -1
                ci = ci + 1
            }
        }
        // IrBinOp: compute hash, look up, replace or insert
        if instr.op == IrOpcode::IrBinOp && instr.dst >= 0 && instr.dst < 256 {
            let s1 = instr.src1
            let s2 = instr.src2
            if s1 >= 0 && s1 < 256 && s2 >= 0 && s2 < 256 {
                let vn1 = vn[s1 as usize]
                let vn2 = vn[s2 as usize]
                if vn1 >= 0 && vn2 >= 0 {
                    let op_val = ocp_binop_to_cse_key(instr.bin_op)
                    let key = op_val * 10000 + vn1 * 100 + vn2
                    var hash = key % 128
                    if hash < 0 { hash = 0 - hash }
                    // Linear probe lookup
                    var found: bool = false
                    var found_reg: i64 = -1
                    var probe: i64 = 0
                    while probe < 8 {
                        let idx = (hash + probe) % 128
                        if !ht_used[idx as usize] {
                            probe = 8  // break: empty slot, not found
                        } else {
                            if ht_key[idx as usize] == key {
                                found = true
                                found_reg = ht_reg[idx as usize]
                                probe = 8  // break
                            }
                        }
                        probe = probe + 1
                    }
                    if found && found_reg >= 0 {
                        // Replace with IrCopy
                        result.instrs[i as usize] = ir_copy(instr.dst, found_reg)
                        vn[instr.dst as usize] = vn[found_reg as usize]
                    } else {
                        // Insert into hash table
                        vn[instr.dst as usize] = next_vn
                        next_vn = next_vn + 1
                        var slot: i64 = hash
                        var sp: i64 = 0
                        while sp < 8 {
                            let idx = (slot + sp) % 128
                            if !ht_used[idx as usize] {
                                ht_used[idx as usize] = true
                                ht_key[idx as usize] = key
                                ht_vn[idx as usize] = vn[instr.dst as usize]
                                ht_reg[idx as usize] = instr.dst
                                sp = 8  // break
                            }
                            sp = sp + 1
                        }
                    }
                } else {
                    // Unknown VN for operands — assign fresh
                    vn[instr.dst as usize] = next_vn
                    next_vn = next_vn + 1
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================================
// Sprint 105 Block AC: Instruction scheduling — load sinking
// ============================================================================
// Bubble-sort adjacent swaps: IrLoadImm sinks past independent instructions
// to reduce register pressure (closer to use). Up to 4 passes.
// Only swaps if next instruction doesn't use/write dst, isn't control flow.
// SOTA: Hennessy & Patterson §A.2; Muchnick §17.
fn ocp_sink_loads(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var pass: i64 = 0
    while pass < 4 {
        var swapped: bool = false
        var i: i64 = 0
        while i < result.instr_count - 1 {
            let cur = result.instrs[i as usize]
            let nxt = result.instrs[(i + 1) as usize]
            if cur.op == IrOpcode::IrLoadImm && nxt.op != IrOpcode::IrLoadImm
                    && nxt.op != IrOpcode::IrNop && nxt.op != IrOpcode::IrLabel
                    && nxt.op != IrOpcode::IrJump && nxt.op != IrOpcode::IrBranchTrue
                    && nxt.op != IrOpcode::IrBranchFalse && nxt.op != IrOpcode::IrReturn
                    && nxt.op != IrOpcode::IrCall {
                // Check next doesn't use our dst
                let d = cur.dst
                if nxt.src1 != d && nxt.src2 != d && nxt.dst != d {
                    // Swap
                    result.instrs[i as usize] = nxt
                    result.instrs[(i + 1) as usize] = cur
                    swapped = true
                }
            }
            i = i + 1
        }
        if !swapped {
            pass = 4  // break
        }
        pass = pass + 1
    }
    result
}

// ============================================================================
// Sprint 106 Block AD: Jump-to-return folding
// ============================================================================
// IrJump(L) where IrLabel(L) is immediately followed by IrReturn(v) →
// replace the IrJump with IrReturn(v). Eliminates one branch per tail return.
// Only unconditional jumps; conditional branches excluded.
// SOTA: Muchnick §13.1 (branch optimization); Cooper & Torczon §8.7.
fn ocp_jump_to_return(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    // Pass 1: find label positions
    var label_pos: [i64; 256] = [-1; 256]
    var i: i64 = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrLabel && instr.label_id >= 0 && instr.label_id < 256 {
            label_pos[instr.label_id as usize] = i
        }
        i = i + 1
    }
    // Pass 2: fold IrJump(L) where L+1 is IrReturn
    i = 0
    while i < result.instr_count {
        let instr = result.instrs[i as usize]
        if instr.op == IrOpcode::IrJump && instr.label_id >= 0 && instr.label_id < 256 {
            let lp = label_pos[instr.label_id as usize]
            if lp >= 0 && lp + 1 < result.instr_count {
                let next = result.instrs[(lp + 1) as usize]
                if next.op == IrOpcode::IrReturn {
                    result.instrs[i as usize] = ir_return(next.src1)
                }
            }
        }
        i = i + 1
    }
    result
}

fn opt_cleanup_function(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var current = ocp_dedup_imm(func)
    current = ocp_const_fold(current)
    current = ocp_mul3_sr(current)            // Sprint 102 Block Z: non-pow-2 multiply SR
    current = ocp_egraph_pass(current)        // full e-graph: deferred (always skips guard)
    current = ocp_egraph_mini_pass(current)   // mini e-graph: activates for instr_count <= 4
    current = ocp_cse(current)                // CSE: always active
    current = ocp_gvn(current)                // Sprint 104 Block AB: global value numbering
    current = ocp_copy_prop(current)          // Sprint 93 Block Q: copy chain collapse
    current = ocp_dse(current)                // Sprint 94 Block R: dead store elimination
    current = ocp_redundant_jump(current)     // Sprint 97 Block U: redundant jump elimination
    current = ocp_jump_to_return(current)     // Sprint 106 Block AD: jump-to-return folding
    current = ocp_dead_after_jump(current)    // Sprint 98 Block V: unreachable code elimination
    current = ocp_dead_label(current)         // Sprint 99 Block W: unreachable label elimination
    current = ocp_licm(current)              // Sprint 103 Block AA: LICM
    current = ocp_sink_loads(current)         // Sprint 105 Block AC: load sinking
    var iter: i64 = 0
    while iter < 8 {
        let swept = ocp_dce_once(current)
        current = swept.0
        if swept.1 == 0 {
            // Sprint 78: SCCP final pass (Wegman & Zadeck TOPLAS 1991)
            current = cp_optimize_function(current)
            return ocp_compact_nops(current)  // Sprint 100 Block X
        }
        iter = iter + 1
    }
    // Sprint 78: SCCP final pass (Wegman & Zadeck TOPLAS 1991)
    current = cp_optimize_function(current)
    current = ocp_compact_nops(current)       // Sprint 100 Block X: NOP compaction
    current
}

// ============================================================================
// Sprint 100 Block X: NOP compaction
// ============================================================================
//
// Compact the instruction array by removing IrNop instructions.
// Copies non-NOP instructions to the front of the array, preserving order.
// Label references (label_id) are symbolic, not positional, so no remapping.
// Reduces instr_count, improving downstream codegen and pass performance.
// SOTA: standard peephole post-pass; Muchnick §13.1.
fn ocp_compact_nops(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = func
    var write: i64 = 0
    var read: i64 = 0
    while read < result.instr_count {
        if result.instrs[read as usize].op != IrOpcode::IrNop {
            if write != read {
                result.instrs[write as usize] = result.instrs[read as usize]
            }
            write = write + 1
        }
        read = read + 1
    }
    // Fill remaining slots with NOPs (clean tail).
    var fill: i64 = write
    while fill < result.instr_count {
        result.instrs[fill as usize] = ir_nop()
        fill = fill + 1
    }
    result.instr_count = write
    result
}

// Run const_fold + DCE on every function in an IrModule.
fn opt_cleanup_module(module: IrModule) -> IrModule with Mut, Div, Panic {
    var result = module
    var fi: i64 = 0
    while fi < result.fn_count {
        result.functions[fi as usize] = opt_cleanup_function(result.functions[fi as usize])
        fi = fi + 1
    }
    result
}
