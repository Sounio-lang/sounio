                            || (dm_ol == dm_ar && dm_or == dm_al) {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dm_instr.dst, dm_ol, BinaryOp::OpBitXor, dm_or))
                    }
                }
            }
        }
        // Sprint 204 Block DN: Sub-sub identity — (x-y)-(x-z) → z-y.
        // Proof: (x-y)-(x-z) = x-y-x+z = z-y. QED. Outer x cancels.
        // Zero new arrays: uses al_is_sub/al_sub_lhs/al_sub_rhs (Block AL, Sprint 115).
        // SOTA: LLVM InstCombineAddSub; algebraic cancellation; symmetric to Block DL.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let dn_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let dn_s1 = dn_instr.src1; let dn_s2 = dn_instr.src2
            let dn_s1_ok = dn_s1 >= 0 && dn_s1 < 256; let dn_s2_ok = dn_s2 >= 0 && dn_s2 < 256
            if dn_instr.bin_op == BinaryOp::OpSub {
                // (x-y) - (x-z) → z-y: both are subs, same lhs (x)
                if dn_s1_ok && al_is_sub[dn_s1 as usize]
                        && dn_s2_ok && al_is_sub[dn_s2 as usize]
                        && al_sub_lhs[dn_s1 as usize] == al_sub_lhs[dn_s2 as usize] {
                    let dn_y = al_sub_rhs[dn_s1 as usize]
                    let dn_z = al_sub_rhs[dn_s2 as usize]
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dn_instr.dst, dn_z, BinaryOp::OpSub, dn_y))
                    al_is_sub[dn_instr.dst as usize] = true
                    al_sub_lhs[dn_instr.dst as usize] = dn_z
                    al_sub_rhs[dn_instr.dst as usize] = dn_y
                }
            }
        }
        // Sprint 205 Block DO: Add-sub common-addend cancel — (x+y)-(y+z) → x-z.
        // Proof: (x+y)-(y+z) = x+y-y-z = x-z. QED. Commutative in both sums.
        // Zero new arrays: uses aq_add_rr_valid/lhs/rhs (Block AQ tracking, Sprint 129).
        // SOTA: LLVM InstCombineAddSub; group-theoretic additive cancellation.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let do_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let do_s1 = do_instr.src1; let do_s2 = do_instr.src2
            let do_s1_ok = do_s1 >= 0 && do_s1 < 256; let do_s2_ok = do_s2 >= 0 && do_s2 < 256
            if do_instr.bin_op == BinaryOp::OpSub {
                if do_s1_ok && aq_add_rr_valid[do_s1 as usize]
                        && do_s2_ok && aq_add_rr_valid[do_s2 as usize] {
                    let do_al = aq_add_rr_lhs[do_s1 as usize]
                    let do_ar = aq_add_rr_rhs[do_s1 as usize]
                    let do_bl = aq_add_rr_lhs[do_s2 as usize]
                    let do_br = aq_add_rr_rhs[do_s2 as usize]
                    // shared right: do_ar == do_bl or do_ar == do_br → result = do_al - other
                    if do_ar == do_bl {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(do_instr.dst, do_al, BinaryOp::OpSub, do_br))
                        al_is_sub[do_instr.dst as usize] = true
                        al_sub_lhs[do_instr.dst as usize] = do_al
                        al_sub_rhs[do_instr.dst as usize] = do_br
                    } else if do_ar == do_br {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(do_instr.dst, do_al, BinaryOp::OpSub, do_bl))
                        al_is_sub[do_instr.dst as usize] = true
                        al_sub_lhs[do_instr.dst as usize] = do_al
                        al_sub_rhs[do_instr.dst as usize] = do_bl
                    } else if do_al == do_bl {
                        // shared left: (x+y)-(x+z) → y-z
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(do_instr.dst, do_ar, BinaryOp::OpSub, do_br))
                        al_is_sub[do_instr.dst as usize] = true
                        al_sub_lhs[do_instr.dst as usize] = do_ar
                        al_sub_rhs[do_instr.dst as usize] = do_br
                    } else if do_al == do_br {
                        // shared: (x+y)-(z+x) → y-z
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(do_instr.dst, do_ar, BinaryOp::OpSub, do_bl))
                        al_is_sub[do_instr.dst as usize] = true
                        al_sub_lhs[do_instr.dst as usize] = do_ar
                        al_sub_rhs[do_instr.dst as usize] = do_bl
                    }
                }
            }
        }
        // Sprint 206 Block DP: AND-OR XOR identity — (x&y)^(x|y) → x^y.
        // Proof: per bit, min(a,b)⊕max(a,b) = a⊕b. QED. Commutative: (x|y)^(x&y).
        // Zero new arrays: uses ao_and_rr_valid/lhs/rhs + ao_or_rr_valid/lhs/rhs (Block AO).
        // SOTA: LLVM InstCombineAndOrXor; Boolean lattice identity.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let dp_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let dp_s1 = dp_instr.src1; let dp_s2 = dp_instr.src2
            let dp_s1_ok = dp_s1 >= 0 && dp_s1 < 256; let dp_s2_ok = dp_s2 >= 0 && dp_s2 < 256
            if dp_instr.bin_op == BinaryOp::OpBitXor {
                // (x&y) ^ (x|y) → x^y
                if dp_s1_ok && ao_and_rr_valid[dp_s1 as usize]
                        && dp_s2_ok && ao_or_rr_valid[dp_s2 as usize] {
                    let dp_al = ao_and_rr_lhs[dp_s1 as usize]
                    let dp_ar = ao_and_rr_rhs[dp_s1 as usize]
                    let dp_ol = ao_or_rr_lhs[dp_s2 as usize]
                    let dp_or = ao_or_rr_rhs[dp_s2 as usize]
                    if (dp_al == dp_ol && dp_ar == dp_or)
                            || (dp_al == dp_or && dp_ar == dp_ol) {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dp_instr.dst, dp_al, BinaryOp::OpBitXor, dp_ar))
                    }
                }
                // (x|y) ^ (x&y) → x^y (commutative)
                if dp_s1_ok && ao_or_rr_valid[dp_s1 as usize]
                        && dp_s2_ok && ao_and_rr_valid[dp_s2 as usize] {
                    let dp_ol = ao_or_rr_lhs[dp_s1 as usize]
                    let dp_or = ao_or_rr_rhs[dp_s1 as usize]
                    let dp_al = ao_and_rr_lhs[dp_s2 as usize]
                    let dp_ar = ao_and_rr_rhs[dp_s2 as usize]
                    if (dp_ol == dp_al && dp_or == dp_ar)
                            || (dp_ol == dp_ar && dp_or == dp_al) {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dp_instr.dst, dp_ol, BinaryOp::OpBitXor, dp_or))
                    }
                }
            }
        }
        // Sprint 207 Block DQ: AND-XNOR to AND — x & ~(x^y) → x & y; y & ~(x^y) → x & y.
        // Proof: ~(x^y) selects bits where x==y; x & (bits where x=y) = x & y. QED.
        // Commutative in AND: ~(x^y) & x → x & y.
        // Zero new arrays: uses is_bnot/bnot_src (Block AI/BJ) + as_xor_rr_valid/lhs/rhs (Block AS).
        // SOTA: LLVM InstCombineAndOrXor; Boolean algebra XNOR = complement of XOR.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let dq_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let dq_s1 = dq_instr.src1; let dq_s2 = dq_instr.src2
            let dq_s1_ok = dq_s1 >= 0 && dq_s1 < 256; let dq_s2_ok = dq_s2 >= 0 && dq_s2 < 256
            if dq_instr.bin_op == BinaryOp::OpBitAnd {
                // x & ~(x^y) → x & y: s2 is NOT of XOR-rr containing s1
                if dq_s2_ok && is_bnot[dq_s2 as usize] {
                    let dq_xor = bnot_src[dq_s2 as usize]
                    if dq_xor >= 0 && dq_xor < 256 && as_xor_rr_valid[dq_xor as usize] {
                        let dq_xl = as_xor_rr_lhs[dq_xor as usize]
                        let dq_xr = as_xor_rr_rhs[dq_xor as usize]
                        if dq_xl == dq_s1 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dq_instr.dst, dq_s1, BinaryOp::OpBitAnd, dq_xr))
                        } else if dq_xr == dq_s1 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dq_instr.dst, dq_s1, BinaryOp::OpBitAnd, dq_xl))
                        }
                    }
                }
                // ~(x^y) & x → x & y: s1 is NOT of XOR-rr containing s2
                if dq_s1_ok && is_bnot[dq_s1 as usize] {
                    let dq_xor2 = bnot_src[dq_s1 as usize]
                    if dq_xor2 >= 0 && dq_xor2 < 256 && as_xor_rr_valid[dq_xor2 as usize] {
                        let dq_xl2 = as_xor_rr_lhs[dq_xor2 as usize]
                        let dq_xr2 = as_xor_rr_rhs[dq_xor2 as usize]
                        if dq_xl2 == dq_s2 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dq_instr.dst, dq_s2, BinaryOp::OpBitAnd, dq_xr2))
                        } else if dq_xr2 == dq_s2 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dq_instr.dst, dq_s2, BinaryOp::OpBitAnd, dq_xl2))
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

fn ocp_const_fold_pass_a2(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var def_at: [i64; 256] = [-1; 256]
    // Sprint 86 Block M: Negation tracking for double-neg and neg-arithmetic.
    var is_neg:  [bool; 256] = [false; 256]
    var neg_src: [i64;  256] = [-1;    256]
    // Sprint 112 Block AI: Bitwise NOT via XOR(-1) tracking.
    var is_bnot:  [bool; 256] = [false; 256]
    var bnot_src: [i64;  256] = [-1;    256]
    // Sprint 88 Block O: Mul-div cancellation — track r = x * C (partial-const mul).
    // (x * C) / C → x.  SOTA: LLVM InstCombineMulDivRem.cpp; Cooper & Torczon §9.
    var mul_valid:   [bool; 256] = [false; 256]
    var mul_var_src: [i64;  256] = [-1;    256]
    var mul_const_v: [i64;  256] = [0;     256]
    // Sprint 89 Block P: Add-sub/sub-add cancellation — track r = x +/- C.
    // (x + C) - C → x  ;  (x - C) + C → x.
    // SOTA: LLVM InstCombineAddSub.cpp; Muchnick §12.2.
    var as_valid:   [bool; 256] = [false; 256]
    var as_var_src: [i64;  256] = [-1;    256]
    var as_const_v: [i64;  256] = [0;     256]
    var as_is_add:  [bool; 256] = [false; 256]
    // Sprint 96 Block T: Shift-chain combining — track r = x << C or r = x >> C.
    // (x << C1) << C2 → x << (C1+C2)  ;  (x >> C1) >> C2 → x >> (C1+C2).
    // SOTA: Bernstein SODA 1986; LLVM InstCombineShifts.cpp.
    var sh_valid:   [bool; 256] = [false; 256]
    var sh_var_src: [i64;  256] = [-1;    256]
    var sh_amount:  [i64;  256] = [0;     256]
    var sh_is_left: [bool; 256] = [false; 256]
    // Sprint 108 Block AE: And-mask fold — track r = x & C.
    // (x & C1) & C2 → x & (C1 & C2).  SOTA: LLVM InstCombineAndOrXor.cpp.
    var and_valid:     [bool; 256] = [false; 256]
    var and_var_src:   [i64;  256] = [-1;    256]
    var and_const_val: [i64;  256] = [0;     256]
    // Sprint 115 Block AL: Sub-tracking for neg reversal.
    // al_is_sub[r]=true means r = al_sub_lhs[r] - al_sub_rhs[r].
    // neg(a - b) -> b - a  ;  0 - (a - b) -> b - a.
    // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
    var al_is_sub:  [bool; 256] = [false; 256]
    var al_sub_lhs: [i64;  256] = [-1;    256]
    var al_sub_rhs: [i64;  256] = [-1;    256]
    // Sprint 116 Block AM: OR-mask tracking for superset elimination.
    // (x | C1) | C2 where (C1 | C2) == C1 → IrCopy(src1).
    // SOTA: LLVM InstCombineAndOrXor.cpp.
    var am_or_valid:     [bool; 256] = [false; 256]
    var am_or_var_src:   [i64;  256] = [-1;    256]
    var am_or_const_val: [i64;  256] = [0;     256]
    // Sprint 127 Block AO: Register-register AND/OR tracking for absorption.
    // Huntington 1904 absorption axiom: a | (a & b) = a, a & (a | b) = a.
    // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1.
    var ao_and_rr_valid: [bool; 256] = [false; 256]
    var ao_and_rr_lhs:   [i64;  256] = [-1;    256]
    var ao_and_rr_rhs:   [i64;  256] = [-1;    256]
    var ao_or_rr_valid:  [bool; 256] = [false; 256]
    var ao_or_rr_lhs:    [i64;  256] = [-1;    256]
    var ao_or_rr_rhs:    [i64;  256] = [-1;    256]
    // Sprint 129 Block AQ: Register-register add/mul tracking for inverse cancellation.
    // (a + b) - b → a, (a * b) / b → a.
    // SOTA: LLVM InstCombine algebraic identity; group-theoretic inverse.
    var aq_add_rr_valid: [bool; 256] = [false; 256]
    var aq_add_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_add_rr_rhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_valid: [bool; 256] = [false; 256]
    var aq_mul_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 131 Block AS: Register-register XOR tracking for self-inverse cancellation.
    // (a ^ b) ^ b → a, (a ^ b) ^ a → b.
    // SOTA: LLVM InstCombineAndOrXor; GF(2) field: XOR is its own inverse.
    var as_xor_rr_valid: [bool; 256] = [false; 256]
    var as_xor_rr_lhs:   [i64;  256] = [-1;    256]
    var as_xor_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 149 Block BK: Consecutive same-direction shift folding.
    // (x << A) << B → x << (A+B), (x >> A) >> B → x >> (A+B).
    // Track when a register is the result of a shift by a known constant.
    // SOTA: LLVM InstCombineShifts.cpp FoldShiftByConstant; Cooper & Torczon §8.1.
    var bk_shl_valid: [bool; 256] = [false; 256]
    var bk_shl_src:   [i64;  256] = [-1;    256]
    var bk_shl_amt:   [i64;  256] = [0;     256]
    var bk_shr_valid: [bool; 256] = [false; 256]
    var bk_shr_src:   [i64;  256] = [-1;    256]
    var bk_shr_amt:   [i64;  256] = [0;     256]
    // Sprint 151 Block BM: XOR constant-chain fold — (x ^ C1) ^ C2 → x ^ (C1^C2).
    // Mirrors Block BG (OR) and Block AE (AND) for the XOR operator.
    // SOTA: LLVM InstCombineAndOrXor; GF(2) field associativity; Hacker's Delight §2-3.
    var bm_xor_valid: [bool; 256] = [false; 256]
    var bm_xor_src:   [i64;  256] = [-1;    256]
    var bm_xor_cval:  [i64;  256] = [0;     256]

    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        var preserve_mul_chain = false
        if instr.dst >= 0 && instr.dst < 256 {
            let d = instr.dst as usize
            is_const[d] = false
            is_neg[d] = false
            is_bnot[d] = false
            mul_valid[d] = false
            as_valid[d] = false
            sh_valid[d] = false
            and_valid[d] = false
            al_is_sub[d] = false
            am_or_valid[d] = false
            ao_and_rr_valid[d] = false
            ao_or_rr_valid[d] = false
            aq_add_rr_valid[d] = false
            aq_mul_rr_valid[d] = false
            as_xor_rr_valid[d] = false
            bk_shl_valid[d] = false
            bk_shr_valid[d] = false
            bm_xor_valid[d] = false
        }
        // Track IrLoadImm: register dst becomes a known constant
        if ocp_is_load_imm(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }
        // Sprint 83 Block K: IrLoadBool constant tracking.
        // IrLoadBool stores true→1, false→0 in imm_i64. Tracking booleans in the
        // constant lattice enables downstream Block F branch folding, Block E
        // comparison folding, and SCCP on boolean-valued registers.
        // SOTA: Click "Value Numbering" PLDI 1995 §2 — all value-producing
        // instructions participate in the constant lattice.
        if instr.op == IrOpcode::IrLoadBool {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }
        // Sprint 208 Block DR: De Morgan NOT-AND — ~(~x & ~y) → x | y.
        // Proof: De Morgan's theorem: ~(A & B) = ~A | ~B. With A=~x,B=~y: ~(~x&~y)=~~x|~~y=x|y. QED.
        // Zero new arrays: uses is_bnot/bnot_src (Block AI/BJ) + ao_and_rr_valid/lhs/rhs (Block AO).
        // SOTA: LLVM InstCombineAndOrXor; De Morgan's theorem; Boole 1847.
        if (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp {
            let dr_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let dr_s = dr_instr.src1
            let dr_s_ok = dr_s >= 0 && dr_s < 256
            if dr_instr.un_op == UnaryOp::OpNot && dr_s_ok && ao_and_rr_valid[dr_s as usize] {
                let dr_al = ao_and_rr_lhs[dr_s as usize]
                let dr_ar = ao_and_rr_rhs[dr_s as usize]
                let dr_al_ok = dr_al >= 0 && dr_al < 256
                let dr_ar_ok = dr_ar >= 0 && dr_ar < 256
                if dr_al_ok && is_bnot[dr_al as usize]
                        && dr_ar_ok && is_bnot[dr_ar as usize] {
                    let dr_x = bnot_src[dr_al as usize]
                    let dr_y = bnot_src[dr_ar as usize]
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dr_instr.dst, dr_x, BinaryOp::OpBitOr, dr_y))
                }
            }
        }
        // Sprint 209 Block DS: De Morgan NOT-OR — ~(~x | ~y) → x & y.
        // Proof: De Morgan's theorem: ~(A | B) = ~A & ~B. With A=~x,B=~y: ~(~x|~y)=x&y. QED.
        // Dual of Block DR (~(~x&~y)→x|y). Zero new arrays: uses is_bnot/bnot_src + ao_or_rr_valid/lhs/rhs.
        // SOTA: LLVM InstCombineAndOrXor; De Morgan 1847.
        if (IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp {
            let ds_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let ds_s = ds_instr.src1
            let ds_s_ok = ds_s >= 0 && ds_s < 256
            if ds_instr.un_op == UnaryOp::OpNot && ds_s_ok && ao_or_rr_valid[ds_s as usize] {
                let ds_ol = ao_or_rr_lhs[ds_s as usize]
                let ds_or = ao_or_rr_rhs[ds_s as usize]
                let ds_ol_ok = ds_ol >= 0 && ds_ol < 256
                let ds_or_ok = ds_or >= 0 && ds_or < 256
                if ds_ol_ok && is_bnot[ds_ol as usize]
                        && ds_or_ok && is_bnot[ds_or as usize] {
                    let ds_x = bnot_src[ds_ol as usize]
                    let ds_y = bnot_src[ds_or as usize]
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ds_instr.dst, ds_x, BinaryOp::OpBitAnd, ds_y))
                }
            }
        }
        // Sprint 210 Block DT: OR-AND complement absorption — x | (y & ~x) → x | y.
        // Proof: x|(y&~x) = (x|y)&(x|~x) = (x|y)&1 = x|y. Distributive+complement law.
        // Commutative: (y & ~x) | x → x | y.
        // Zero new arrays: uses ao_and_rr_valid/lhs/rhs (Block AO) + is_bnot/bnot_src (Block AI/BJ).
        // SOTA: LLVM InstCombineAndOrXor; Boolean absorption; Huntington 1904.
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let dt_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let dt_s1 = dt_instr.src1; let dt_s2 = dt_instr.src2
            let dt_s1_ok = dt_s1 >= 0 && dt_s1 < 256; let dt_s2_ok = dt_s2 >= 0 && dt_s2 < 256
            if dt_instr.bin_op == BinaryOp::OpBitOr && dt_s1_ok && dt_s2_ok {
                // Case 1: s2 = y & ~s1
                if ao_and_rr_valid[dt_s2 as usize] {
                    let dt_al = ao_and_rr_lhs[dt_s2 as usize]
                    let dt_ar = ao_and_rr_rhs[dt_s2 as usize]
                    let dt_al_ok = dt_al >= 0 && dt_al < 256; let dt_ar_ok = dt_ar >= 0 && dt_ar < 256
                    // Check ~s1 on rhs: ar is NOT(s1)
                    if dt_ar_ok && is_bnot[dt_ar as usize] && bnot_src[dt_ar as usize] == dt_s1 && dt_al_ok {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(dt_instr.dst, dt_s1, BinaryOp::OpBitOr, dt_al))
                    }
                    // Check ~s1 on lhs: al is NOT(s1)
