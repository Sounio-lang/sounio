// self-hosted::ir::opt_cleanup — Post-inlining constant folding + DCE
//
// Runs two cleanup passes per function, in sequence:
//   1. Constant propagation + folding: IrLoadImm values tracked; IrBinOp
//      instructions where both operands are known constants are replaced
//      with an IrLoadImm of the folded result.
//   2. Dead code elimination (mark-sweep): instructions whose destination
//      register is never used as a source, and have no side effects,
//      are replaced with IrNop.
//
// Both passes iterate the instruction array once. No heap allocation.
//
// References:
//   Briggs & Cooper: "Effective Partial Redundancy Elimination" (1994)
//   Cooper, Harvey, Kennedy: "A Simple, Fast Dominance Algorithm" (2001)

module ir::opt_cleanup

use ir::ir::*
use ir::normalize::*
use parser::ast::*
use ir::egraph::*
use ir::const_prop::*

struct OcpCseTables {
    op: [i64; 128],
    src1: [i64; 128],
    src2: [i64; 128],
    dst: [i64; 128],
    len: i64,
}

// Mirrors the fixed register-indexed tables in cleanup passes A2/B. A future
// pass-capacity change must update this named boundary and its focused gate.
// Diagnostic peel mask, set from the environment by the driver (which has IO;
// this dispatcher does not, and giving it IO would cascade -- that cascade is
// what desynchronised the checker in #1649). 0 means every peel runs, so the
// default behaviour is unchanged.
//
// THE DECLARATION AND THE BIT ASSIGNMENT LIVE WITH ocp_skip(), further down this
// file. This lane declared a SECOND `pub var OCP_SKIP_MASK` here with its own bit
// numbering (indices 0..11); main's ocp_skip() takes bit VALUES (1, 2, 4, ...) and
// its call sites are the ones kept, so that table was both duplicated and wrong.
//
// Removed rather than reconciled because a duplicate global name is exactly the
// defect that cost this lane the arity miscompile: two `IR_NAME_POOL_LEN`
// declarations, one scalar and one array, silently shared storage. Caught here by
// auditing for names declared twice in one file -- run that audit after any merge
// that adds globals.

let OCP_REBRACKET_TRACKED_REG_LIMIT: i64 = 256

// The reachability witness below is intentionally bounded to the current
// IrFunction instruction capacity. If the global IR grows, this authority
// remains fail-closed until its fixed proof storage and gate are reviewed.
let OCP_REBRACKET_CFG_CAPACITY: i64 = 2048

// Machine-readable trace schema. This versions the textual audit protocol,
// not the private authority or a serialized IR ABI.
pub let OCP_CLEANUP_RECEIPT_SCHEMA_VERSION: i64 = 1

// Compiler-internal authority for one exact bitwise reassociation.
//
// The authority is deliberately private, non-serializable, and never returned
// from this module. A transaction derives it from the current IR window and
// consumes it immediately before mutation. Audit fingerprints are computed
// only after application; authority comes from rechecking structural facts.
struct OcpExactBitwiseRebracketOccurrence {
    outer_instr_index: i64,
    inner_instr_index: i64,
    outer_const_def_index: i64,
    operator_key: i64,
    base_reg: i64,
    outer_const_reg: i64,
}

// Compact proof object for exact bitwise flow authority. The path binding
// stores the exact pair (inner block start, outer block start); the private
// constructor admits either one uninterrupted region or a validated forward
// CFG in which the inner block dominates the outer block. c2 must still have
// exactly one modeled observer.
struct OcpExactBitwiseFlowUseCertificate {
    inner_const_def_index: i64,
    path_binding: i64,
}

struct OcpSealedExactBitwiseRebracketAuthority {
    occurrence: OcpExactBitwiseRebracketOccurrence,
    flow_certificate: OcpExactBitwiseFlowUseCertificate,
}

struct OcpExactBitwiseRebracketAudit {
    authorization_count: i64,
    application_count: i64,
    refusal_count: i64,
    reason_code: i64,
    // 0=none/refusal, 1=same linear region, 2=dominated forward CFG.
    scope_key: i64,
    outer_instr_index: i64,
    operator_key: i64,
    combined_const_value: i64,
    diagnostic_fingerprint: i64,
}

// Public evidence is an audit summary, never an authority value.
pub struct OcpExactBitwiseRebracketProbeReceipt {
    pub case_count: i64,
    // Application bits: 0=AND, 1=OR, 2=XOR.
    pub application_mask: i64,
    // Refusal bits: replay, wrong occurrence, swapped, arithmetic, float,
    // shared constant, stale occurrence, call/packed/float/phi operands,
    // non-dominating or malformed CFGs, backedges, and base-register kills.
    pub refusal_mask: i64,
    pub unchanged_refusal_mask: i64,
    // Bit 0: authority is private and consumed in the local transaction.
    // Bits 1..3 would claim D7, float/GUM, or global authority and stay clear.
    // Bit 4: a same-linear-region/use certificate admits unrelated control.
    // Bit 5: a validated forward-CFG certificate admits a dominated join.
    // Bits 8..15: duplicate-label reason+1, set only if that witness fails.
    pub boundary_claim_mask: i64,
}

// Compiler-visible evidence from one module cleanup invocation. This is an
// audit receipt only: it contains no occurrence capability and cannot
// authorize a later rewrite.
pub struct OcpCleanupModuleReceipt {
    pub function_count: i64,
    pub exact_bitwise_transaction_count: i64,
    pub exact_bitwise_authorization_count: i64,
    pub exact_bitwise_application_count: i64,
    pub exact_bitwise_refusal_count: i64,
    pub exact_bitwise_same_region_application_count: i64,
    pub exact_bitwise_cross_block_application_count: i64,
    // Bit N records at least one refusal with reason code N.
    pub exact_bitwise_refusal_reason_mask: i64,
    // Source ontology-parameter links are identity evidence only. They can accompany a
    // transaction or application but cannot authorize either one.
    pub exact_bitwise_transaction_ontology_parameter_link_count: i64,
    pub exact_bitwise_application_ontology_parameter_link_count: i64,
    pub last_transaction_ontology_class_hash: i64,
    // Application bits: 0=AND, 1=OR, 2=XOR.
    pub exact_bitwise_operator_mask: i64,
    pub last_application_function_index: i64,
    pub last_combined_const_value: i64,
}

struct OcpExactBitwiseRebracketPassAudit {
    transaction_count: i64,
    authorization_count: i64,
    application_count: i64,
    refusal_count: i64,
    same_region_application_count: i64,
    cross_block_application_count: i64,
    refusal_reason_mask: i64,
    operator_mask: i64,
    last_outer_instr_index: i64,
    last_combined_const_value: i64,
    diagnostic_fingerprint: i64,
}

fn ocp_empty_exact_bitwise_rebracket_pass_audit() -> OcpExactBitwiseRebracketPassAudit {
    OcpExactBitwiseRebracketPassAudit {
        transaction_count: 0,
        authorization_count: 0,
        application_count: 0,
        refusal_count: 0,
        same_region_application_count: 0,
        cross_block_application_count: 0,
        refusal_reason_mask: 0,
        operator_mask: 0,
        last_outer_instr_index: -1,
        last_combined_const_value: 0,
        diagnostic_fingerprint: 0,
    }
}

fn ocp_record_exact_bitwise_rebracket_audit(
    aggregate: &! OcpExactBitwiseRebracketPassAudit,
    audit: OcpExactBitwiseRebracketAudit,
) with Mut {
    (*aggregate).transaction_count = (*aggregate).transaction_count + 1
    (*aggregate).authorization_count = (*aggregate).authorization_count + audit.authorization_count
    (*aggregate).application_count = (*aggregate).application_count + audit.application_count
    (*aggregate).refusal_count = (*aggregate).refusal_count + audit.refusal_count
    (*aggregate).diagnostic_fingerprint = (*aggregate).diagnostic_fingerprint ^ audit.diagnostic_fingerprint
    if audit.refusal_count == 1 && audit.reason_code > 0 && audit.reason_code < 63 {
        (*aggregate).refusal_reason_mask = (*aggregate).refusal_reason_mask | (1 << audit.reason_code)
    }
    if audit.application_count == 1 {
        if audit.scope_key == 1 {
            (*aggregate).same_region_application_count = (*aggregate).same_region_application_count + 1
        }
        if audit.scope_key == 2 {
            (*aggregate).cross_block_application_count = (*aggregate).cross_block_application_count + 1
        }
        if audit.operator_key == 3 { (*aggregate).operator_mask = (*aggregate).operator_mask | 1 }
        if audit.operator_key == 4 { (*aggregate).operator_mask = (*aggregate).operator_mask | 2 }
        if audit.operator_key == 5 { (*aggregate).operator_mask = (*aggregate).operator_mask | 4 }
        (*aggregate).last_outer_instr_index = audit.outer_instr_index
        (*aggregate).last_combined_const_value = audit.combined_const_value
    }
}

fn ocp_rebracket_occurrence_failure(
    reason_code: i64,
) -> OcpExactBitwiseRebracketOccurrence {
    OcpExactBitwiseRebracketOccurrence {
        outer_instr_index: -1,
        inner_instr_index: -1,
        outer_const_def_index: -1,
        operator_key: 0 - reason_code,
        base_reg: -1,
        outer_const_reg: -1,
    }
}

fn ocp_rebracket_occurrence_is_valid(
    occurrence: OcpExactBitwiseRebracketOccurrence,
) -> bool {
    occurrence.outer_instr_index >= 0 && occurrence.inner_instr_index >= 0 &&
        occurrence.outer_const_def_index >= 0 && occurrence.operator_key >= 3 &&
        occurrence.operator_key <= 5
}

fn ocp_rebracket_occurrence_reason(
    occurrence: OcpExactBitwiseRebracketOccurrence,
) -> i64 {
    if occurrence.operator_key < 0 {
        0 - occurrence.operator_key
    } else {
        0
    }
}

fn ocp_rebracket_flow_certificate_failure(
    reason_code: i64,
) -> OcpExactBitwiseFlowUseCertificate {
    OcpExactBitwiseFlowUseCertificate {
        inner_const_def_index: -1,
        path_binding: 0 - reason_code,
    }
}

fn ocp_rebracket_flow_certificate_is_valid(
    certificate: OcpExactBitwiseFlowUseCertificate,
) -> bool {
    certificate.inner_const_def_index >= 0 && certificate.path_binding >= 0
}

fn ocp_rebracket_flow_certificate_reason(
    certificate: OcpExactBitwiseFlowUseCertificate,
) -> i64 {
    if certificate.path_binding < 0 {
        0 - certificate.path_binding
    } else {
        0
    }
}

fn ocp_rebracket_empty_audit(reason_code: i64) -> OcpExactBitwiseRebracketAudit {
    OcpExactBitwiseRebracketAudit {
        authorization_count: 0,
        application_count: 0,
        refusal_count: 1,
        reason_code: reason_code,
        scope_key: 0,
        outer_instr_index: -1,
        operator_key: 0,
        combined_const_value: 0,
        diagnostic_fingerprint: 0,
    }
}

fn ocp_rebracket_is_exact_bitwise_op(op: BinaryOp) -> bool {
    op == BinaryOp::OpBitAnd || op == BinaryOp::OpBitOr || op == BinaryOp::OpBitXor
}

fn ocp_rebracket_operator_key(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpBitAnd { return 3 }
    if op == BinaryOp::OpBitOr { return 4 }
    if op == BinaryOp::OpBitXor { return 5 }
    0
}

fn ocp_rebracket_combine(op: BinaryOp, a: i64, b: i64) -> (bool, i64) {
    if op == BinaryOp::OpBitAnd { return (true, a & b) }
    if op == BinaryOp::OpBitOr { return (true, a | b) }
    if op == BinaryOp::OpBitXor { return (true, a ^ b) }
    (false, 0)
}

fn ocp_rebracket_is_plain_binop(instr: IrInstr) -> bool with Mut, Div, Panic {
    let empty = ir_empty_name()
    instr.op == IrOpcode::IrBinOp &&
        instr.imm_i64 == 0 && instr.imm_f64 == 0.0 &&
        instr.label_id == IR_INVALID_LABEL && instr.fn_id == IR_INVALID_FN &&
        instr.field_idx == -1 && instr.imm_flags == 0 && instr.arg_count == 0 &&
        ir_name_eq(ir_name_at(instr.name_id), empty)
}

fn ocp_rebracket_is_plain_load_imm(instr: IrInstr) -> bool with Mut, Div, Panic {
    let empty = ir_empty_name()
    instr.op == IrOpcode::IrLoadImm &&
        instr.src1 == IR_INVALID_REG && instr.src2 == IR_INVALID_REG &&
        instr.imm_f64 == 0.0 && instr.label_id == IR_INVALID_LABEL &&
        instr.fn_id == IR_INVALID_FN && instr.field_idx == -1 &&
        instr.imm_flags == 0 && instr.arg_count == 0 &&
        ir_name_eq(ir_name_at(instr.name_id), empty)
}

fn ocp_rebracket_has_no_call_args(args: Option<Box<IrRegList>>) -> bool {
    match args {
        Some(_) => false,
        _ => true,
    }
}

// Data opcodes whose register observations are fully represented by src1/src2,
// plus IrIndexSet's documented third operand. Control instructions are modeled
// separately so admitting their explicit uses cannot accidentally certify a
// candidate that crosses a basic-block boundary.
fn ocp_rebracket_has_canonical_scalar_operands(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm => true,
        IrOpcode::IrLoadBool => true,
        IrOpcode::IrLoadString => true,
        IrOpcode::IrCopy => true,
        IrOpcode::IrBinOp => true,
        IrOpcode::IrUnaryOp => true,
        IrOpcode::IrFieldGet => true,
        IrOpcode::IrFieldSet => true,
        IrOpcode::IrIndexGet => true,
        IrOpcode::IrIndexSet => true,
        IrOpcode::IrArrayLen => true,
        IrOpcode::IrAlloc => true,
        IrOpcode::IrNop => true,
        IrOpcode::IrLoadFnRef => true,
        IrOpcode::IrLoadGlobal => true,
        IrOpcode::IrStoreGlobal => true,
        IrOpcode::IrStorePtr => true,
        _ => false,
    }
}

fn ocp_rebracket_is_control_terminator(op: IrOpcode) -> bool {
    op == IrOpcode::IrJump || op == IrOpcode::IrBranchTrue ||
        op == IrOpcode::IrBranchFalse || op == IrOpcode::IrReturn ||
        op == IrOpcode::IrReturnSret
}

fn ocp_rebracket_has_supported_control_operands(op: IrOpcode) -> bool {
    op == IrOpcode::IrLabel || ocp_rebracket_is_control_terminator(op)
}

fn ocp_rebracket_has_plain_control_encoding(instr: IrInstr) -> bool with Mut, Div, Panic {
    let empty = ir_empty_name()
    let common = instr.dst == IR_INVALID_REG && instr.src2 == IR_INVALID_REG &&
        instr.imm_i64 == 0 && instr.imm_f64 == 0.0 &&
        instr.fn_id == IR_INVALID_FN && instr.field_idx == -1 &&
        instr.imm_flags == 0 && instr.arg_count == 0 &&
        ir_name_eq(ir_name_at(instr.name_id), empty) && ocp_rebracket_has_no_call_args(instr.call_args)
    if !common { return false }
    if instr.op == IrOpcode::IrLabel || instr.op == IrOpcode::IrJump {
        return instr.src1 == IR_INVALID_REG && instr.label_id >= 0
    }
    if instr.op == IrOpcode::IrBranchTrue || instr.op == IrOpcode::IrBranchFalse {
        return instr.src1 >= 0 && instr.label_id >= 0
    }
    if instr.op == IrOpcode::IrReturn || instr.op == IrOpcode::IrReturnSret {
        return instr.src1 >= 0 && instr.label_id == IR_INVALID_LABEL
    }
    false
}

fn ocp_rebracket_has_complete_use_encoding(instr: IrInstr) -> bool with Mut, Div, Panic {
    if ocp_rebracket_has_canonical_scalar_operands(instr.op) {
        return instr.arg_count == 0 && ocp_rebracket_has_no_call_args(instr.call_args)
    }
    if ocp_rebracket_has_supported_control_operands(instr.op) {
        return ocp_rebracket_has_plain_control_encoding(instr)
    }
    false
}

// 0 = complete, 14 = an opcode has unmodeled operands, 16 = a supported
// control opcode is encoded non-canonically.
fn ocp_rebracket_function_use_model_status(func: &IrFunction) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if ocp_rebracket_has_supported_control_operands(instr.op) {
            if !ocp_rebracket_has_plain_control_encoding(instr) { return 16 }
        } else if !ocp_rebracket_has_complete_use_encoding(instr) {
            return 14
        }
        i = i + 1
    }
    0
}

fn ocp_rebracket_function_has_complete_use_model(func: &IrFunction) -> bool with Mut, Div, Panic {
    ocp_rebracket_function_use_model_status(func) == 0
}

// Assigns a lexical basic-block token without constructing a global CFG. A
// label starts a block; the instruction after any terminator starts another.
fn ocp_rebracket_block_start_index(func: &IrFunction, instr_idx: i64) -> i64 with Mut, Panic, Div {
    if instr_idx < 0 || instr_idx >= func.instr_count { return -1 }
    var block_start: i64 = 0
    var i: i64 = 0
    while i <= instr_idx {
        let op = (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode)
        if op == IrOpcode::IrLabel { block_start = i }
        if i < instr_idx && ocp_rebracket_is_control_terminator(op) {
            block_start = i + 1
        }
        i = i + 1
    }
    block_start
}

fn ocp_rebracket_cfg_is_block_start(func: &IrFunction, instr_idx: i64) -> bool with Mut, Panic, Div {
    if instr_idx < 0 || instr_idx >= func.instr_count { return false }
    if instr_idx == 0 { return true }
    if (IR_A_OP[(ir_region_slot_r(func.region, (instr_idx))) as usize] as IrOpcode) == IrOpcode::IrLabel { return true }
    ocp_rebracket_is_control_terminator((IR_A_OP[(ir_region_slot_r(func.region, ((instr_idx - 1)))) as usize] as IrOpcode))
}

fn ocp_rebracket_cfg_block_end_exclusive(
    func: &IrFunction,
    block_start: i64,
) -> i64 with Mut, Panic, Div {
    if !ocp_rebracket_cfg_is_block_start(func, block_start) { return -1 }
    var i = block_start
    while i < func.instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode)
        if i > block_start && op == IrOpcode::IrLabel { return i }
        if ocp_rebracket_is_control_terminator(op) { return i + 1 }
        i = i + 1
    }
    func.instr_count
}

// Returns -1 when absent and -2 when the label is duplicated. A CFG target is
// canonical only when this function returns one exact instruction index.
fn ocp_rebracket_cfg_label_index(func: &IrFunction, label_id: i64) -> i64 with Mut, Panic, Div {
    var found: i64 = -1
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.op == IrOpcode::IrLabel && instr.label_id == label_id {
            if found >= 0 { return -2 }
            found = i
        }
        i = i + 1
    }
    found
}

fn ocp_rebracket_cfg_has_duplicate_labels(func: &IrFunction) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        let left = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if left.op == IrOpcode::IrLabel {
            var j = i + 1
            while j < func.instr_count {
                let right = ir_arena_load(ir_region_slot_r(func.region, (j)))
                if right.op == IrOpcode::IrLabel && right.label_id == left.label_id {
                    return true
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    false
}

fn ocp_rebracket_cfg_successor_count(
    func: &IrFunction,
    block_start: i64,
) -> i64 with Mut, Panic, Div {
    let block_end = ocp_rebracket_cfg_block_end_exclusive(func, block_start)
    if block_end <= block_start { return -1 }
    let last = ir_arena_load(ir_region_slot_r(func.region, ((block_end - 1))))
    if last.op == IrOpcode::IrJump { return 1 }
    if last.op == IrOpcode::IrBranchTrue || last.op == IrOpcode::IrBranchFalse {
        if block_end >= func.instr_count { return -1 }
        return 2
    }
    if last.op == IrOpcode::IrReturn || last.op == IrOpcode::IrReturnSret { return 0 }
    if block_end < func.instr_count { return 1 }
    0
}

fn ocp_rebracket_cfg_successor_at(
    func: &IrFunction,
    block_start: i64,
    successor_index: i64,
) -> i64 with Mut, Panic, Div {
    let successor_count = ocp_rebracket_cfg_successor_count(func, block_start)
    if successor_index < 0 || successor_index >= successor_count { return -1 }
    let block_end = ocp_rebracket_cfg_block_end_exclusive(func, block_start)
    let last = ir_arena_load(ir_region_slot_r(func.region, ((block_end - 1))))
    if last.op == IrOpcode::IrJump {
        return ocp_rebracket_cfg_label_index(func, last.label_id)
    }
    if last.op == IrOpcode::IrBranchTrue || last.op == IrOpcode::IrBranchFalse {
        if successor_index == 0 {
            return ocp_rebracket_cfg_label_index(func, last.label_id)
        }
        return block_end
    }
    block_end
}

// Cross-block authority deliberately starts with forward acyclic IR. This
// verifier rejects malformed labels/targets and every same-or-backward edge;
// unlike the general CFG helpers, no capacity overflow is silently truncated.
// Status: 0=valid, 17=invalid/duplicate label, 18=missing edge target or
// conditional fallthrough, 19=non-forward edge.
fn ocp_rebracket_forward_cfg_status(func: &IrFunction) -> i64 with Mut, Div, Panic {
    if func.instr_count <= 0 || func.instr_count > IR_MAX_INSTRS ||
        func.instr_count > OCP_REBRACKET_CFG_CAPACITY {
        return 17
    }
    if ocp_rebracket_cfg_has_duplicate_labels(func) { return 17 }

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.op == IrOpcode::IrLabel {
            if !ocp_rebracket_has_plain_control_encoding(instr) { return 17 }
        }
        if instr.op == IrOpcode::IrJump || instr.op == IrOpcode::IrBranchTrue ||
            instr.op == IrOpcode::IrBranchFalse {
            if ocp_rebracket_cfg_label_index(func, instr.label_id) < 0 { return 18 }
        }
        i = i + 1
    }

    var block_start: i64 = 0
    while block_start < func.instr_count {
        if ocp_rebracket_cfg_is_block_start(func, block_start) {
            let successor_count = ocp_rebracket_cfg_successor_count(func, block_start)
            if successor_count < 0 { return 18 }
            var si: i64 = 0
            while si < successor_count {
                let successor = ocp_rebracket_cfg_successor_at(func, block_start, si)
                if successor < 0 || !ocp_rebracket_cfg_is_block_start(func, successor) {
                    return 18
                }
                if successor <= block_start { return 19 }
                si = si + 1
            }
        }
        block_start = block_start + 1
    }
    0
}

// Forward-only block starts are already in topological order, so one lexical
// pass computes exact reachability without a capped worklist. excluded_start
// removes one block and all of its outgoing paths.
fn ocp_rebracket_forward_cfg_reaches_excluding(
    func: &IrFunction,
    from_start: i64,
    target_start: i64,
    excluded_start: i64,
) -> bool with Mut, Panic, Div {
    if from_start == excluded_start || target_start == excluded_start { return false }
    if !ocp_rebracket_cfg_is_block_start(func, from_start) ||
        !ocp_rebracket_cfg_is_block_start(func, target_start) {
        return false
    }
    var reached: [bool; 2048] = [false; 2048]
    reached[from_start as usize] = true
    var i: i64 = 0
    while i < func.instr_count {
        if ocp_rebracket_cfg_is_block_start(func, i) && reached[i as usize] {
            if i == target_start { return true }
            let successor_count = ocp_rebracket_cfg_successor_count(func, i)
            if successor_count < 0 { return false }
            var si: i64 = 0
            while si < successor_count {
                let successor = ocp_rebracket_cfg_successor_at(func, i, si)
                if successor >= 0 && successor < func.instr_count &&
                    successor != excluded_start {
                    reached[successor as usize] = true
                }
                si = si + 1
            }
        }
        i = i + 1
    }
    reached[target_start as usize]
}

fn ocp_rebracket_forward_cfg_dominates(
    func: &IrFunction,
    dominator_start: i64,
    dominated_start: i64,
) -> bool with Mut, Div, Panic {
    if !ocp_rebracket_forward_cfg_reaches_excluding(func, 0, dominator_start, -1) {
        return false
    }
    if !ocp_rebracket_forward_cfg_reaches_excluding(
        func,
        dominator_start,
        dominated_start,
        -1,
    ) {
        return false
    }
    !ocp_rebracket_forward_cfg_reaches_excluding(
        func,
        0,
        dominated_start,
        dominator_start,
    )
}

fn ocp_rebracket_flow_path_binding(inner_block: i64, outer_block: i64) -> i64 {
    inner_block * IR_MAX_INSTRS + outer_block
}

fn ocp_rebracket_flow_inner_block(path_binding: i64) -> i64 with Div {
    path_binding / IR_MAX_INSTRS
}

fn ocp_rebracket_flow_outer_block(path_binding: i64) -> i64 with Div {
    path_binding % IR_MAX_INSTRS
}

fn ocp_rebracket_instr_equal(a: IrInstr, b: IrInstr) -> bool with Mut, Div, Panic {
    a.op == b.op && a.dst == b.dst && a.src1 == b.src1 && a.src2 == b.src2 &&
        a.imm_i64 == b.imm_i64 && a.imm_f64 == b.imm_f64 &&
        a.label_id == b.label_id && a.fn_id == b.fn_id &&
        a.field_idx == b.field_idx && a.imm_flags == b.imm_flags &&
        a.bin_op == b.bin_op && a.un_op == b.un_op && a.arg_count == b.arg_count &&
        ir_name_eq(ir_name_at(a.name_id), ir_name_at(b.name_id)) && ocp_rebracket_has_no_call_args(a.call_args) &&
        ocp_rebracket_has_no_call_args(b.call_args)
}

fn ocp_rebracket_last_value_def_before(func: &IrFunction, reg: i64, before: i64) -> i64 with Mut, Panic, Div {
    var found: i64 = -1
    var i: i64 = 0
    while i < before && i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.op != IrOpcode::IrNop && instr.dst == reg {
            found = i
        }
        i = i + 1
    }
    found
}

fn ocp_rebracket_has_float_marker_before(func: &IrFunction, reg: i64, before: i64) -> bool with Mut, Div, Panic {
    // #1669: the function-scoped bit answers this without depending on a marker
    // still being in the stream. Whole-function rather than "before index" is
    // strictly CONSERVATIVE here: the only callers use this to VETO a rebracket,
    // so a wider true can block a fold, never enable a wrong one.
    if IR_FLOAT_BITS_TRUSTED == 1 && ir_float_bits_get(func, reg) { return true }
    var i: i64 = 0
    while i < before && i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.op == IrOpcode::IrNop && instr.dst == reg &&
            (instr.imm_flags & IR_FLOAT_REG_MARKER_FLAG) != 0 {
            return true
        }
        i = i + 1
    }
    false
}

fn ocp_rebracket_window_has_conflicting_write(
    func: &IrFunction,
    inner_idx: i64,
    outer_idx: i64,
    outer_const_def_idx: i64,
    base_reg: i64,
    inner_const_reg: i64,
    outer_const_reg: i64,
    inner_result_reg: i64,
) -> bool with Mut, Panic, Div {
    var i = inner_idx + 1
    while i < outer_idx {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if i != outer_const_def_idx && instr.op != IrOpcode::IrNop {
            if instr.dst == base_reg || instr.dst == inner_const_reg ||
                instr.dst == outer_const_reg || instr.dst == inner_result_reg {
                return true
            }
        }
        i = i + 1
    }
    false
}

// The transform rewrites the existing outer constant definition in place.
// Count its observers across the whole function, including explicitly modeled
// branch/return operands. A negative result means some use encoding is unknown.
fn ocp_rebracket_source_use_count(func: &IrFunction, reg: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if !ocp_rebracket_has_complete_use_encoding(instr) { return -1 }
        if instr.src1 == reg { count = count + 1 }
        if instr.src2 == reg { count = count + 1 }
        if instr.op == IrOpcode::IrIndexSet && instr.imm_i64 == reg {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn ocp_rebracket_flow_certificates_equal(
    a: OcpExactBitwiseFlowUseCertificate,
    b: OcpExactBitwiseFlowUseCertificate,
) -> bool {
    a.inner_const_def_index == b.inner_const_def_index &&
        a.path_binding == b.path_binding
}

// Derives one exact flow/use fact from live IR. Same-block candidates retain
// the original uninterrupted-region proof. Cross-block candidates additionally
// require a canonical forward CFG, block-local constants, and an inner block
// that dominates the outer block. The capture scan has already rejected every
// lexical write to the base and relevant registers between the two binops; in
// a forward CFG this is a conservative no-kill reaching-definition proof.
fn ocp_certify_exact_bitwise_flow_use(
    func: &IrFunction,
    occurrence: OcpExactBitwiseRebracketOccurrence,
) -> OcpExactBitwiseFlowUseCertificate with Mut, Div, Panic {
    let use_model_status = ocp_rebracket_function_use_model_status(func)
    if use_model_status != 0 {
        return ocp_rebracket_flow_certificate_failure(use_model_status)
    }

    let inner = ir_arena_load(ir_region_slot_r(func.region, (occurrence.inner_instr_index)))
    let inner_const_def_idx = ocp_rebracket_last_value_def_before(
        func,
        inner.src2,
        occurrence.inner_instr_index,
    )
    if inner_const_def_idx < 0 { return ocp_rebracket_flow_certificate_failure(7) }

    let inner_const_block = ocp_rebracket_block_start_index(func, inner_const_def_idx)
    let inner_block = ocp_rebracket_block_start_index(func, occurrence.inner_instr_index)
    let outer_const_block = ocp_rebracket_block_start_index(
        func,
        occurrence.outer_const_def_index,
    )
    let outer_block = ocp_rebracket_block_start_index(func, occurrence.outer_instr_index)
    if inner_const_block < 0 || inner_const_block != inner_block ||
        outer_const_block < 0 || outer_const_block != outer_block {
        return ocp_rebracket_flow_certificate_failure(15)
    }

    if inner_block != outer_block {
        let cfg_status = ocp_rebracket_forward_cfg_status(func)
        if cfg_status != 0 { return ocp_rebracket_flow_certificate_failure(cfg_status) }
        if !ocp_rebracket_forward_cfg_reaches_excluding(func, 0, outer_block, -1) {
            return ocp_rebracket_flow_certificate_failure(20)
        }
        if !ocp_rebracket_forward_cfg_dominates(func, inner_block, outer_block) {
            return ocp_rebracket_flow_certificate_failure(21)
        }
    }

    let outer_const_use_count = ocp_rebracket_source_use_count(func, occurrence.outer_const_reg)
    if outer_const_use_count < 0 { return ocp_rebracket_flow_certificate_failure(14) }
    if outer_const_use_count != 1 { return ocp_rebracket_flow_certificate_failure(11) }

    let certificate = OcpExactBitwiseFlowUseCertificate {
        inner_const_def_index: inner_const_def_idx,
        path_binding: ocp_rebracket_flow_path_binding(inner_block, outer_block),
    }
    certificate
}

fn ocp_capture_exact_bitwise_rebracket_occurrence(
    func: &IrFunction,
    outer_idx: i64,
    inner_idx: i64,
) -> OcpExactBitwiseRebracketOccurrence with Mut, Div, Panic {
    if inner_idx < 0 || outer_idx <= inner_idx || outer_idx >= func.instr_count {
        return ocp_rebracket_occurrence_failure(1)
    }

    let inner = ir_arena_load(ir_region_slot_r(func.region, (inner_idx)))
    let outer = ir_arena_load(ir_region_slot_r(func.region, (outer_idx)))
    if !ocp_rebracket_is_plain_binop(inner) || !ocp_rebracket_is_plain_binop(outer) {
        return ocp_rebracket_occurrence_failure(2)
    }
    if !ocp_rebracket_is_exact_bitwise_op(inner.bin_op) || inner.bin_op != outer.bin_op {
        return ocp_rebracket_occurrence_failure(3)
    }
    if outer.src1 != inner.dst {
        return ocp_rebracket_occurrence_failure(4)
    }

    let base_reg = inner.src1
    let inner_const_reg = inner.src2
    let outer_const_reg = outer.src2
    if base_reg < 0 || base_reg >= OCP_REBRACKET_TRACKED_REG_LIMIT ||
        inner_const_reg < 0 || inner_const_reg >= OCP_REBRACKET_TRACKED_REG_LIMIT ||
        outer_const_reg < 0 || outer_const_reg >= OCP_REBRACKET_TRACKED_REG_LIMIT ||
        inner.dst < 0 || inner.dst >= OCP_REBRACKET_TRACKED_REG_LIMIT ||
        outer.dst < 0 || outer.dst >= OCP_REBRACKET_TRACKED_REG_LIMIT {
        return ocp_rebracket_occurrence_failure(5)
    }
    if base_reg == inner_const_reg || base_reg == outer_const_reg ||
        inner_const_reg == outer_const_reg || inner.dst == base_reg ||
        inner.dst == inner_const_reg || inner.dst == outer_const_reg {
        return ocp_rebracket_occurrence_failure(6)
    }

    let inner_const_def_idx = ocp_rebracket_last_value_def_before(func, inner_const_reg, inner_idx)
    let outer_const_def_idx = ocp_rebracket_last_value_def_before(func, outer_const_reg, outer_idx)
    if inner_const_def_idx < 0 || outer_const_def_idx < 0 ||
        outer_const_def_idx >= outer_idx {
        return ocp_rebracket_occurrence_failure(7)
    }
    let inner_const_def = ir_arena_load(ir_region_slot_r(func.region, (inner_const_def_idx)))
    let outer_const_def = ir_arena_load(ir_region_slot_r(func.region, (outer_const_def_idx)))
    if !ocp_rebracket_is_plain_load_imm(inner_const_def) ||
        !ocp_rebracket_is_plain_load_imm(outer_const_def) ||
        inner_const_def.dst != inner_const_reg || outer_const_def.dst != outer_const_reg {
        return ocp_rebracket_occurrence_failure(8)
    }

    if ocp_rebracket_has_float_marker_before(func, base_reg, outer_idx) ||
        ocp_rebracket_has_float_marker_before(func, inner_const_reg, outer_idx) ||
        ocp_rebracket_has_float_marker_before(func, outer_const_reg, outer_idx) ||
        ocp_rebracket_has_float_marker_before(func, inner.dst, outer_idx) ||
        ocp_rebracket_has_float_marker_before(func, outer.dst, outer_idx) {
        return ocp_rebracket_occurrence_failure(9)
    }
    if ocp_rebracket_window_has_conflicting_write(
        func,
        inner_idx,
        outer_idx,
        outer_const_def_idx,
        base_reg,
        inner_const_reg,
        outer_const_reg,
        inner.dst,
    ) {
        return ocp_rebracket_occurrence_failure(10)
    }
    let combined = ocp_rebracket_combine(
        inner.bin_op,
        inner_const_def.imm_i64,
        outer_const_def.imm_i64,
    )
    if !combined.0 { return ocp_rebracket_occurrence_failure(12) }
    let operator_key = ocp_rebracket_operator_key(inner.bin_op)
    let occurrence = OcpExactBitwiseRebracketOccurrence {
        outer_instr_index: outer_idx,
        inner_instr_index: inner_idx,
        outer_const_def_index: outer_const_def_idx,
        operator_key: operator_key,
        base_reg: base_reg,
        outer_const_reg: outer_const_reg,
    }
    occurrence
}

fn ocp_rebracket_occurrences_equal(
    a: OcpExactBitwiseRebracketOccurrence,
    b: OcpExactBitwiseRebracketOccurrence,
) -> bool {
    a.outer_instr_index == b.outer_instr_index &&
        a.inner_instr_index == b.inner_instr_index &&
        a.outer_const_def_index == b.outer_const_def_index &&
        a.operator_key == b.operator_key && a.base_reg == b.base_reg &&
        a.outer_const_reg == b.outer_const_reg
}

fn ocp_issue_exact_bitwise_rebracket_authority(
    occurrence: OcpExactBitwiseRebracketOccurrence,
    flow_certificate: OcpExactBitwiseFlowUseCertificate,
) -> OcpSealedExactBitwiseRebracketAuthority with Div, Panic {
    assert(occurrence.operator_key >= 3 && occurrence.operator_key <= 5)
    assert(flow_certificate.inner_const_def_index >= 0)
    assert(flow_certificate.inner_const_def_index < occurrence.inner_instr_index)
    assert(flow_certificate.path_binding >= 0)
    let inner_block = ocp_rebracket_flow_inner_block(flow_certificate.path_binding)
    let outer_block = ocp_rebracket_flow_outer_block(flow_certificate.path_binding)
    assert(inner_block >= 0 && inner_block < IR_MAX_INSTRS)
    assert(outer_block >= inner_block && outer_block < IR_MAX_INSTRS)
    assert(inner_block <= flow_certificate.inner_const_def_index)
    assert(inner_block <= occurrence.inner_instr_index)
    assert(outer_block <= occurrence.outer_const_def_index)
    assert(outer_block <= occurrence.outer_instr_index)
    OcpSealedExactBitwiseRebracketAuthority {
        occurrence: occurrence,
        flow_certificate: flow_certificate,
    }
}

fn ocp_apply_exact_bitwise_rebracket_authority(
    func: &! IrFunction,
    authority: OcpSealedExactBitwiseRebracketAuthority,
) -> OcpExactBitwiseRebracketAudit with Mut, Div, Panic {
    // The authority never escapes this private transaction. Its occurrence is
    // checked against freshly captured current IR immediately before mutation.
    let expected = authority.occurrence
    let expected_flow = authority.flow_certificate
    let current = ocp_capture_exact_bitwise_rebracket_occurrence(
        func,
        expected.outer_instr_index,
        expected.inner_instr_index,
    )
    if !ocp_rebracket_occurrence_is_valid(current) {
        return ocp_rebracket_empty_audit(13)
    }
    let current_flow = ocp_certify_exact_bitwise_flow_use(func, current)
    if !ocp_rebracket_flow_certificate_is_valid(current_flow) ||
        !ocp_rebracket_occurrences_equal(expected, current) ||
        !ocp_rebracket_flow_certificates_equal(expected_flow, current_flow) {
        return ocp_rebracket_empty_audit(13)
    }

    let inner = ir_arena_load(ir_region_slot_r(func.region, (current.inner_instr_index)))
    let outer = ir_arena_load(ir_region_slot_r(func.region, (current.outer_instr_index)))
    let inner_const_def_idx = ocp_rebracket_last_value_def_before(
        func,
        inner.src2,
        current.inner_instr_index,
    )
    let inner_const_def = ir_arena_load(ir_region_slot_r(func.region, (inner_const_def_idx)))
    let outer_const_def = ir_arena_load(ir_region_slot_r(func.region, (current.outer_const_def_index)))
    let combined = ocp_rebracket_combine(
        outer.bin_op,
        inner_const_def.imm_i64,
        outer_const_def.imm_i64,
    )
    assert(combined.0)
    let combined_value = combined.1
    // Diagnostic only: deliberately collision-prone and overflow-free. Structural
    // revalidation above, never this fingerprint, authorizes the mutation.
    let occurrence_fingerprint = expected.operator_key ^ expected.base_reg ^ inner.src2 ^
        expected.outer_const_reg ^ expected.inner_instr_index ^ expected.outer_instr_index
    let source_tree_fingerprint = occurrence_fingerprint ^ inner_const_def.imm_i64 ^
        outer_const_def.imm_i64
    let target_tree_fingerprint = occurrence_fingerprint ^ combined_value ^ 104729
    let inner_block = ocp_rebracket_flow_inner_block(expected_flow.path_binding)
    let outer_block = ocp_rebracket_flow_outer_block(expected_flow.path_binding)
    let scope_key = if inner_block == outer_block { 1 } else { 2 }
    ir_arena_store(ir_region_slot_w(func.region, (expected.outer_const_def_index)), ir_load_imm(
        expected.outer_const_reg,
        combined_value,
    ))
    ir_arena_store(ir_region_slot_w(func.region, (expected.outer_instr_index)), ir_binop(
        outer.dst,
        expected.base_reg,
        outer.bin_op,
        expected.outer_const_reg,
    ))
    OcpExactBitwiseRebracketAudit {
        authorization_count: 1,
        application_count: 1,
        refusal_count: 0,
        reason_code: 0,
        scope_key: scope_key,
        outer_instr_index: expected.outer_instr_index,
        operator_key: expected.operator_key,
        combined_const_value: combined_value,
        diagnostic_fingerprint: source_tree_fingerprint ^ target_tree_fingerprint,
    }
}

fn ocp_try_exact_bitwise_rebracket(
    func: &! IrFunction,
    outer_idx: i64,
    inner_idx: i64,
) -> OcpExactBitwiseRebracketAudit with Mut, Div, Panic {
    let captured = ocp_capture_exact_bitwise_rebracket_occurrence(func, outer_idx, inner_idx)
    if !ocp_rebracket_occurrence_is_valid(captured) {
        return ocp_rebracket_empty_audit(ocp_rebracket_occurrence_reason(captured))
    }
    let certified = ocp_certify_exact_bitwise_flow_use(func, captured)
    if !ocp_rebracket_flow_certificate_is_valid(certified) {
        return ocp_rebracket_empty_audit(ocp_rebracket_flow_certificate_reason(certified))
    }
    let authority = ocp_issue_exact_bitwise_rebracket_authority(captured, certified)
    ocp_apply_exact_bitwise_rebracket_authority(func, authority)
}

fn ocp_rebracket_probe_chain(op: BinaryOp, c1: i64, c2: i64) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, c1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_binop(2, 0, op, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(3, c2))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_binop(4, 2, op, 3))
    func.instr_count = 4
    func.reg_count = 5
    func.param_count = 1
    func.param_regs[0] = 0
    func
}

fn ocp_rebracket_probe_control_after_chain(
    op: BinaryOp,
    c1: i64,
    c2: i64,
) -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_chain(op, c1, c2)
    var branch = ir_instr_new(IrOpcode::IrBranchTrue)
    branch.src1 = 0
    branch.label_id = 1
    var label = ir_instr_new(IrOpcode::IrLabel)
    label.label_id = 1
    ir_arena_store(ir_region_slot_w(func.region, (4)), branch)
    ir_arena_store(ir_region_slot_w(func.region, (5)), label)
    func.instr_count = 6
    func.label_count = 2
    func
}

fn ocp_rebracket_probe_cross_block_diamond(
    op: BinaryOp,
    c1: i64,
    c2: i64,
) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var branch = ir_instr_new(IrOpcode::IrBranchTrue)
    branch.src1 = 0
    branch.label_id = 1
    var fallthrough_jump = ir_instr_new(IrOpcode::IrJump)
    fallthrough_jump.label_id = 2
    var right_label = ir_instr_new(IrOpcode::IrLabel)
    right_label.label_id = 1
    var right_jump = ir_instr_new(IrOpcode::IrJump)
    right_jump.label_id = 2
    var join_label = ir_instr_new(IrOpcode::IrLabel)
    join_label.label_id = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, c1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_binop(2, 0, op, 1))
    ir_arena_store(ir_region_slot_w(func.region, (2)), branch)
    ir_arena_store(ir_region_slot_w(func.region, (3)), fallthrough_jump)
    ir_arena_store(ir_region_slot_w(func.region, (4)), right_label)
    ir_arena_store(ir_region_slot_w(func.region, (5)), right_jump)
    ir_arena_store(ir_region_slot_w(func.region, (6)), join_label)
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_load_imm(3, c2))
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_binop(4, 2, op, 3))
    func.instr_count = 9
    func.reg_count = 5
    func.label_count = 3
    func.param_count = 1
    func.param_regs[0] = 0
    func
}

fn ocp_rebracket_probe_non_dominating_join() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var branch = ir_instr_new(IrOpcode::IrBranchTrue)
    branch.src1 = 0
    branch.label_id = 1
    var left_jump = ir_instr_new(IrOpcode::IrJump)
    left_jump.label_id = 2
    var right_label = ir_instr_new(IrOpcode::IrLabel)
    right_label.label_id = 1
    var right_jump = ir_instr_new(IrOpcode::IrJump)
    right_jump.label_id = 2
    var join_label = ir_instr_new(IrOpcode::IrLabel)
    join_label.label_id = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), branch)
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 128))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpBitOr, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), left_jump)
    ir_arena_store(ir_region_slot_w(func.region, (4)), right_label)
    ir_arena_store(ir_region_slot_w(func.region, (5)), right_jump)
    ir_arena_store(ir_region_slot_w(func.region, (6)), join_label)
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_load_imm(3, 64))
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_binop(4, 2, BinaryOp::OpBitOr, 3))
    func.instr_count = 9
    func.reg_count = 5
    func.label_count = 3
    func.param_count = 1
    func.param_regs[0] = 0
    func
}

fn ocp_rebracket_probe_backward_edge() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitOr, 128, 64)
    var backward_jump = ir_arena_load(ir_region_slot_r(func.region, (5)))
    backward_jump.label_id = 1
    ir_arena_store(ir_region_slot_w(func.region, (5)), backward_jump)
    func
}

fn ocp_rebracket_probe_duplicate_label() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitOr, 128, 64)
    var duplicate_branch = ir_arena_load(ir_region_slot_r(func.region, (2)))
    duplicate_branch.label_id = 2
    ir_arena_store(ir_region_slot_w(func.region, (2)), duplicate_branch)
    var duplicate_label = ir_arena_load(ir_region_slot_r(func.region, (4)))
    duplicate_label.label_id = 2
    ir_arena_store(ir_region_slot_w(func.region, (4)), duplicate_label)
    func
}

fn ocp_rebracket_probe_missing_target() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitOr, 128, 64)
    var missing_branch = ir_arena_load(ir_region_slot_r(func.region, (2)))
    missing_branch.label_id = 99
    ir_arena_store(ir_region_slot_w(func.region, (2)), missing_branch)
    func
}

fn ocp_rebracket_probe_base_kill() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitOr, 128, 64)
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_copy(0, 0))
    func
}

fn ocp_rebracket_probe_phi_edge() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_cross_block_diamond(BinaryOp::OpBitOr, 128, 64)
    var phi = ir_instr_new(IrOpcode::IrPhi)
    phi.dst = 5
    ir_arena_store(ir_region_slot_w(func.region, (9)), phi)
    func.instr_count = 10
    func.reg_count = 6
    func
}

fn ocp_rebracket_probe_two_scopes() -> IrFunction with Mut, Panic, Div {
    var func = ocp_rebracket_probe_chain(BinaryOp::OpBitXor, 5, 3)
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_load_imm(6, 12))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_binop(7, 5, BinaryOp::OpBitXor, 6))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_load_imm(8, 10))
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_binop(9, 7, BinaryOp::OpBitXor, 8))
    func.instr_count = 8
    func.reg_count = 10
    func
}

fn ocp_rebracket_probe_float_marked_chain() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_mark_float_reg(0))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 255))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpBitAnd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(3, 15))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 2, BinaryOp::OpBitAnd, 3))
    func.instr_count = 5
    func.reg_count = 5
    func
}

pub fn ocp_exact_bitwise_rebracket_authority_probe() -> OcpExactBitwiseRebracketProbeReceipt with Mut, Div, Panic {
    var positive_input = ocp_rebracket_probe_chain(BinaryOp::OpBitAnd, 255, 15)
    let positive = ocp_try_exact_bitwise_rebracket(&! positive_input, 3, 1)
    let positive_ok = positive.application_count == 1 &&
        (IR_A_OP[(ir_region_slot_r(positive_input.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm &&
        IR_A_IMM_I64[(ir_region_slot_r(positive_input.region, (2))) as usize] == 15 &&
        IR_A_SRC1[(ir_region_slot_r(positive_input.region, (3))) as usize] == 0 &&
        IR_A_SRC2[(ir_region_slot_r(positive_input.region, (3))) as usize] == 3
    let positive_count = if positive_ok { 1 } else { 0 }

    var or_input = ocp_rebracket_probe_chain(BinaryOp::OpBitOr, 128, 64)
    let or_audit = ocp_try_exact_bitwise_rebracket(&! or_input, 3, 1)
    let or_ok = or_audit.application_count == 1 &&
        IR_A_IMM_I64[(ir_region_slot_r(or_input.region, (2))) as usize] == 192 &&
        IR_A_SRC1[(ir_region_slot_r(or_input.region, (3))) as usize] == 0
    let or_count = if or_ok { 1 } else { 0 }

    let replay_const_before = ir_arena_load(ir_region_slot_r(positive_input.region, (2)))
    let replay_outer_before = ir_arena_load(ir_region_slot_r(positive_input.region, (3)))
    let replay = ocp_try_exact_bitwise_rebracket(&! positive_input, 3, 1)
    let replay_count = replay.application_count
    let replay_unchanged = replay_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(positive_input.region, (2))), replay_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(positive_input.region, (3))), replay_outer_before)

    var scoped_input = ocp_rebracket_probe_two_scopes()
    let wrong_const_before = ir_arena_load(ir_region_slot_r(scoped_input.region, (6)))
    let wrong_outer_before = ir_arena_load(ir_region_slot_r(scoped_input.region, (7)))
    let wrong_scope = ocp_try_exact_bitwise_rebracket(&! scoped_input, 7, 1)
    let wrong_scope_count = wrong_scope.application_count
    let wrong_scope_unchanged = wrong_scope_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(scoped_input.region, (6))), wrong_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(scoped_input.region, (7))), wrong_outer_before)
    let named_scope = ocp_try_exact_bitwise_rebracket(&! scoped_input, 7, 5)
    let named_scope_ok = named_scope.application_count == 1 &&
        IR_A_SRC1[(ir_region_slot_r(scoped_input.region, (3))) as usize] == 2 &&
        IR_A_IMM_I64[(ir_region_slot_r(scoped_input.region, (6))) as usize] == 6 &&
        IR_A_SRC1[(ir_region_slot_r(scoped_input.region, (7))) as usize] == 5
    let named_scope_count = if named_scope_ok { 1 } else { 0 }

    var swapped_input = ocp_rebracket_probe_chain(BinaryOp::OpBitOr, 128, 64)
    ir_arena_store(ir_region_slot_w(swapped_input.region, (3)), ir_binop(4, 3, BinaryOp::OpBitOr, 2))
    let swapped_const_before = ir_arena_load(ir_region_slot_r(swapped_input.region, (2)))
    let swapped_before = ir_arena_load(ir_region_slot_r(swapped_input.region, (3)))
    let swapped = ocp_try_exact_bitwise_rebracket(&! swapped_input, 3, 1)
    let swapped_count = swapped.application_count
    let swapped_unchanged = swapped_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(swapped_input.region, (2))), swapped_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(swapped_input.region, (3))), swapped_before)

    var arithmetic_input = ocp_rebracket_probe_chain(BinaryOp::OpAdd, 3, 5)
    let arithmetic_const_before = ir_arena_load(ir_region_slot_r(arithmetic_input.region, (2)))
    let arithmetic_before = ir_arena_load(ir_region_slot_r(arithmetic_input.region, (3)))
    let arithmetic = ocp_try_exact_bitwise_rebracket(&! arithmetic_input, 3, 1)
    let arithmetic_count = arithmetic.application_count
    let arithmetic_unchanged = arithmetic_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(arithmetic_input.region, (2))), arithmetic_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(arithmetic_input.region, (3))), arithmetic_before)

    var float_input = ocp_rebracket_probe_float_marked_chain()
    let float_const_before = ir_arena_load(ir_region_slot_r(float_input.region, (3)))
    let float_before = ir_arena_load(ir_region_slot_r(float_input.region, (4)))
    let float_marked = ocp_try_exact_bitwise_rebracket(&! float_input, 4, 2)
    let float_count = float_marked.application_count
    let float_unchanged = float_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(float_input.region, (3))), float_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(float_input.region, (4))), float_before)

    var shared_constant_input = ocp_rebracket_probe_chain(BinaryOp::OpBitOr, 128, 64)
    ir_arena_store(ir_region_slot_w(shared_constant_input.region, (4)), ir_copy(5, 3))
    shared_constant_input.instr_count = 5
    shared_constant_input.reg_count = 6
    let shared_const_before = ir_arena_load(ir_region_slot_r(shared_constant_input.region, (2)))
    let shared_outer_before = ir_arena_load(ir_region_slot_r(shared_constant_input.region, (3)))
    let shared_use_before = ir_arena_load(ir_region_slot_r(shared_constant_input.region, (4)))
    let shared_constant = ocp_try_exact_bitwise_rebracket(&! shared_constant_input, 3, 1)
    let shared_constant_count = shared_constant.application_count
    let shared_constant_unchanged = shared_constant_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(shared_constant_input.region, (2))), shared_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(shared_constant_input.region, (3))), shared_outer_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(shared_constant_input.region, (4))), shared_use_before)

    let stale_input = ocp_rebracket_probe_chain(BinaryOp::OpBitXor, 5, 3)
    let stale_capture = ocp_capture_exact_bitwise_rebracket_occurrence(&stale_input, 3, 1)
    assert(ocp_rebracket_occurrence_is_valid(stale_capture))
    let stale_certificate = ocp_certify_exact_bitwise_flow_use(
        &stale_input,
        stale_capture,
    )
    assert(ocp_rebracket_flow_certificate_is_valid(stale_certificate))
    let stale_authority = ocp_issue_exact_bitwise_rebracket_authority(
        stale_capture,
        stale_certificate,
    )
    var stale_changed = stale_input
    ir_arena_store(ir_region_slot_w(stale_changed.region, (3)), ir_binop(4, 2, BinaryOp::OpBitOr, 3))
    let stale_const_before = ir_arena_load(ir_region_slot_r(stale_changed.region, (2)))
    let stale_before = ir_arena_load(ir_region_slot_r(stale_changed.region, (3)))
    let stale = ocp_apply_exact_bitwise_rebracket_authority(&! stale_changed, stale_authority)
    let stale_count = stale.application_count
    let stale_unchanged = stale_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(stale_changed.region, (2))), stale_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(stale_changed.region, (3))), stale_before)

    var call_input = ocp_rebracket_probe_chain(BinaryOp::OpBitAnd, 255, 15)
    var call_instr = ir_instr_new(IrOpcode::IrCallExtern)
    call_instr.arg_count = 1
    ir_arena_store(ir_region_slot_w(call_input.region, (4)), call_instr)
    call_input.instr_count = 5
    let call_const_before = ir_arena_load(ir_region_slot_r(call_input.region, (2)))
    let call_outer_before = ir_arena_load(ir_region_slot_r(call_input.region, (3)))
    let call_operand = ocp_try_exact_bitwise_rebracket(&! call_input, 3, 1)
    let call_count = call_operand.application_count
    let call_unchanged = call_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(call_input.region, (2))), call_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(call_input.region, (3))), call_outer_before)

    var packed_input = ocp_rebracket_probe_chain(BinaryOp::OpBitXor, 12, 10)
    var packed_instr = ir_instr_new(IrOpcode::IrAssociator)
    packed_instr.src1 = 6
    packed_instr.src2 = 7
    packed_instr.imm_i64 = 3
    ir_arena_store(ir_region_slot_w(packed_input.region, (4)), packed_instr)
    packed_input.instr_count = 5
    let packed_const_before = ir_arena_load(ir_region_slot_r(packed_input.region, (2)))
    let packed_outer_before = ir_arena_load(ir_region_slot_r(packed_input.region, (3)))
    let packed_operand = ocp_try_exact_bitwise_rebracket(&! packed_input, 3, 1)
    let packed_count = packed_operand.application_count
    let packed_unchanged = packed_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(packed_input.region, (2))), packed_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(packed_input.region, (3))), packed_outer_before)

    var control_after_input = ocp_rebracket_probe_control_after_chain(BinaryOp::OpBitOr, 128, 64)
    let control_after_branch_before = ir_arena_load(ir_region_slot_r(control_after_input.region, (4)))
    let control_after_label_before = ir_arena_load(ir_region_slot_r(control_after_input.region, (5)))
    let control_after = ocp_try_exact_bitwise_rebracket(&! control_after_input, 3, 1)
    let control_after_ok = control_after.application_count == 1 &&
        IR_A_IMM_I64[(ir_region_slot_r(control_after_input.region, (2))) as usize] == 192 &&
        IR_A_SRC1[(ir_region_slot_r(control_after_input.region, (3))) as usize] == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(control_after_input.region, (4))), control_after_branch_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(control_after_input.region, (5))), control_after_label_before)

    var cross_block_input = ocp_rebracket_probe_cross_block_diamond(
        BinaryOp::OpBitOr,
        128,
        64,
    )
    let cross_block_branch_before = ir_arena_load(ir_region_slot_r(cross_block_input.region, (2)))
    let cross_block_fall_jump_before = ir_arena_load(ir_region_slot_r(cross_block_input.region, (3)))
    let cross_block_right_label_before = ir_arena_load(ir_region_slot_r(cross_block_input.region, (4)))
    let cross_block_right_jump_before = ir_arena_load(ir_region_slot_r(cross_block_input.region, (5)))
    let cross_block_join_label_before = ir_arena_load(ir_region_slot_r(cross_block_input.region, (6)))
    let cross_block = ocp_try_exact_bitwise_rebracket(&! cross_block_input, 8, 1)
    let cross_block_ok = cross_block.application_count == 1 &&
        IR_A_IMM_I64[(ir_region_slot_r(cross_block_input.region, (7))) as usize] == 192 &&
        IR_A_SRC1[(ir_region_slot_r(cross_block_input.region, (8))) as usize] == 0 &&
        IR_A_SRC2[(ir_region_slot_r(cross_block_input.region, (8))) as usize] == 3 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(cross_block_input.region, (2))), cross_block_branch_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(cross_block_input.region, (3))), cross_block_fall_jump_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(cross_block_input.region, (4))), cross_block_right_label_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(cross_block_input.region, (5))), cross_block_right_jump_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(cross_block_input.region, (6))), cross_block_join_label_before)

    var nondom_input = ocp_rebracket_probe_non_dominating_join()
    let nondom_const_before = ir_arena_load(ir_region_slot_r(nondom_input.region, (7)))
    let nondom_outer_before = ir_arena_load(ir_region_slot_r(nondom_input.region, (8)))
    let nondom = ocp_try_exact_bitwise_rebracket(&! nondom_input, 8, 2)
    let nondom_count = nondom.application_count
    let nondom_unchanged = nondom_count == 0 && nondom.reason_code == 21 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(nondom_input.region, (7))), nondom_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(nondom_input.region, (8))), nondom_outer_before)

    var backward_input = ocp_rebracket_probe_backward_edge()
    let backward_const_before = ir_arena_load(ir_region_slot_r(backward_input.region, (7)))
    let backward_outer_before = ir_arena_load(ir_region_slot_r(backward_input.region, (8)))
    let backward = ocp_try_exact_bitwise_rebracket(&! backward_input, 8, 1)
    let backward_count = backward.application_count
    let backward_unchanged = backward_count == 0 && backward.reason_code == 19 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(backward_input.region, (7))), backward_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(backward_input.region, (8))), backward_outer_before)

    var duplicate_input = ocp_rebracket_probe_duplicate_label()
    let duplicate_const_before = ir_arena_load(ir_region_slot_r(duplicate_input.region, (7)))
    let duplicate_outer_before = ir_arena_load(ir_region_slot_r(duplicate_input.region, (8)))
    let duplicate = ocp_try_exact_bitwise_rebracket(&! duplicate_input, 8, 1)
    let duplicate_count = duplicate.application_count
    let duplicate_unchanged = duplicate_count == 0 && duplicate.reason_code == 17 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(duplicate_input.region, (7))), duplicate_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(duplicate_input.region, (8))), duplicate_outer_before)

    var missing_input = ocp_rebracket_probe_missing_target()
    let missing_const_before = ir_arena_load(ir_region_slot_r(missing_input.region, (7)))
    let missing_outer_before = ir_arena_load(ir_region_slot_r(missing_input.region, (8)))
    let missing = ocp_try_exact_bitwise_rebracket(&! missing_input, 8, 1)
    let missing_count = missing.application_count
    let missing_unchanged = missing_count == 0 && missing.reason_code == 18 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(missing_input.region, (7))), missing_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(missing_input.region, (8))), missing_outer_before)

    var base_kill_input = ocp_rebracket_probe_base_kill()
    let base_kill_const_before = ir_arena_load(ir_region_slot_r(base_kill_input.region, (7)))
    let base_kill_outer_before = ir_arena_load(ir_region_slot_r(base_kill_input.region, (8)))
    let base_kill = ocp_try_exact_bitwise_rebracket(&! base_kill_input, 8, 1)
    let base_kill_count = base_kill.application_count
    let base_kill_unchanged = base_kill_count == 0 && base_kill.reason_code == 10 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(base_kill_input.region, (7))), base_kill_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(base_kill_input.region, (8))), base_kill_outer_before)

    var phi_input = ocp_rebracket_probe_phi_edge()
    let phi_const_before = ir_arena_load(ir_region_slot_r(phi_input.region, (7)))
    let phi_outer_before = ir_arena_load(ir_region_slot_r(phi_input.region, (8)))
    let phi = ocp_try_exact_bitwise_rebracket(&! phi_input, 8, 1)
    let phi_count = phi.application_count
    let phi_unchanged = phi_count == 0 && phi.reason_code == 14 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(phi_input.region, (7))), phi_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(phi_input.region, (8))), phi_outer_before)

    var float_opcode_input = ocp_rebracket_probe_chain(BinaryOp::OpBitAnd, 255, 15)
    var float_opcode_instr = ir_instr_new(IrOpcode::IrLoadFloat)
    float_opcode_instr.dst = 6
    float_opcode_instr.imm_f64 = 1.0
    ir_arena_store(ir_region_slot_w(float_opcode_input.region, (4)), float_opcode_instr)
    float_opcode_input.instr_count = 5
    let float_opcode_const_before = ir_arena_load(ir_region_slot_r(float_opcode_input.region, (2)))
    let float_opcode_outer_before = ir_arena_load(ir_region_slot_r(float_opcode_input.region, (3)))
    let float_opcode = ocp_try_exact_bitwise_rebracket(&! float_opcode_input, 3, 1)
    let float_opcode_count = float_opcode.application_count
    let float_opcode_unchanged = float_opcode_count == 0 &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(float_opcode_input.region, (2))), float_opcode_const_before) &&
        ocp_rebracket_instr_equal(ir_arena_load(ir_region_slot_r(float_opcode_input.region, (3))), float_opcode_outer_before)

    var application_mask: i64 = 0
    if positive_count == 1 { application_mask = application_mask | 1 }
    if or_count == 1 { application_mask = application_mask | 2 }
    if named_scope_count == 1 { application_mask = application_mask | 4 }

    var refusal_mask: i64 = 0
    if replay_count == 0 { refusal_mask = refusal_mask | 1 }
    if wrong_scope_count == 0 { refusal_mask = refusal_mask | 2 }
    if swapped_count == 0 { refusal_mask = refusal_mask | 4 }
    if arithmetic_count == 0 { refusal_mask = refusal_mask | 8 }
    if float_count == 0 { refusal_mask = refusal_mask | 16 }
    if shared_constant_count == 0 { refusal_mask = refusal_mask | 32 }
    if stale_count == 0 { refusal_mask = refusal_mask | 64 }
    if call_count == 0 { refusal_mask = refusal_mask | 128 }
    if packed_count == 0 { refusal_mask = refusal_mask | 256 }
    if nondom_count == 0 && nondom.reason_code == 21 {
        refusal_mask = refusal_mask | 512
    }
    if float_opcode_count == 0 { refusal_mask = refusal_mask | 1024 }
    if backward_count == 0 && backward.reason_code == 19 {
        refusal_mask = refusal_mask | 2048
    }
    if duplicate_count == 0 && duplicate.reason_code == 17 {
        refusal_mask = refusal_mask | 4096
    }
    if missing_count == 0 && missing.reason_code == 18 {
        refusal_mask = refusal_mask | 8192
    }
    if base_kill_count == 0 && base_kill.reason_code == 10 {
        refusal_mask = refusal_mask | 16384
    }
    if phi_count == 0 && phi.reason_code == 14 {
        refusal_mask = refusal_mask | 32768
    }

    var unchanged_refusal_mask: i64 = 0
    if replay_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 1
    }
    if wrong_scope_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 2
    }
    if swapped_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 4
    }
    if arithmetic_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 8
    }
    if float_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 16
    }
    if shared_constant_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 32
    }
    if stale_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 64
    }
    if call_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 128
    }
    if packed_unchanged {
        unchanged_refusal_mask = unchanged_refusal_mask | 256
    }
    if nondom_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 512 }
    if float_opcode_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 1024 }
    if backward_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 2048 }
    if duplicate_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 4096 }
    if missing_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 8192 }
    if base_kill_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 16384 }
    if phi_unchanged { unchanged_refusal_mask = unchanged_refusal_mask | 32768 }
    var boundary_claim_mask: i64 = 1
    if control_after_ok { boundary_claim_mask = boundary_claim_mask | 16 }
    if !duplicate_unchanged {
        boundary_claim_mask = boundary_claim_mask |
            ((duplicate.reason_code + 1) << 8)
    }
    if cross_block_ok && nondom_unchanged && backward_unchanged &&
        duplicate_unchanged && missing_unchanged && base_kill_unchanged && phi_unchanged {
        boundary_claim_mask = boundary_claim_mask | 32
    }
    OcpExactBitwiseRebracketProbeReceipt {
        case_count: 21,
        application_mask: application_mask,
        refusal_mask: refusal_mask,
        unchanged_refusal_mask: unchanged_refusal_mask,
        boundary_claim_mask: boundary_claim_mask,
    }
}

// ============================================================================
// Opcode helpers (local, no flat-namespace dependency)
// ============================================================================

pub(crate) fn ocp_is_load_imm(op: IrOpcode) -> bool {
    match op { IrOpcode::IrLoadImm => true, _ => false }
}

pub(crate) fn ocp_is_binop(op: IrOpcode) -> bool {
    match op { IrOpcode::IrBinOp => true, _ => false }
}

fn ocp_is_nop(op: IrOpcode) -> bool {
    match op { IrOpcode::IrNop => true, _ => false }
}

// Returns true if this opcode produces a destination register value
// A wide integer is software-emulated over CONSECUTIVE registers: limb k of the
// value based at r lives at r+k (ir.sio, "limb k lives at vreg base+k"). An
// IrWide* instruction names only the BASE in dst/src1/src2 and carries the limb
// count in imm_i64.
//
// Every peel in this file tracks state per register and saw only that base, so
// limbs 1..n-1 were invisible: never used to a liveness scan, never written to
// an invalidation. Measured 2026-09-01 -- the same program diverges under -O at
// i256 (4 limbs) and i128 (2 limbs) and agrees at i64 (1 limb, nothing to be
// blind to). See docs/audit/OPTIMIZER_WIDE_LIMB_BLINDNESS_2026-09-01.md.
//
// IrWideReject is deliberately NOT in this list: it stores `base` in imm_i64,
// not a limb count, and reading it the same way would fabricate a span.
fn ocp_is_wide_limb_op(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrWideAdd => true,
        IrOpcode::IrWideSub => true,
        IrOpcode::IrWideMul => true,
        IrOpcode::IrWideDiv => true,
        IrOpcode::IrWideMod => true,
        IrOpcode::IrWideDivFull => true,
        IrOpcode::IrWideModFull => true,
        IrOpcode::IrWideCmp => true,
        IrOpcode::IrWideShr => true,
        IrOpcode::IrWideShrLimb => true,
        _ => false,
    }
}

// How many consecutive registers this instruction's wide operands occupy.
// 1 for everything that is not a wide op, so a caller can multiply blindly.
fn ocp_limb_count(at: i64) -> i64 with Div {
    if !ocp_is_wide_limb_op((IR_A_OP[at as usize] as IrOpcode)) { return 1 }
    let n = IR_A_IMM_I64[at as usize]
    if n < 1 { return 1 }
    if n > OCP_REBRACKET_TRACKED_REG_LIMIT { return OCP_REBRACKET_TRACKED_REG_LIMIT }
    return n
}

// The DESTINATION span. IrWideCmp is the exception: it reads two wide values
// and writes ONE boolean, so widening its dst would clobber whatever follows it.
fn ocp_dst_limb_count(at: i64) -> i64 with Div {
    if (IR_A_OP[at as usize] as IrOpcode) == IrOpcode::IrWideCmp { return 1 }
    return ocp_limb_count(at)
}

// Whether src2 names a REGISTER. On IrWideShr and IrWideShrLimb it does not --
// it carries the shift amount (bits, or limbs) as a plain number. A peel that
// rewrites src2 unconditionally would substitute a shift count for a register
// number, and small shift counts collide with low register numbers.
fn ocp_src2_is_register(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrWideShr => false,
        IrOpcode::IrWideShrLimb => false,
        _ => true,
    }
}

fn ocp_has_dst(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm => true,
        IrOpcode::IrLoadFloat => true,
        IrOpcode::IrLoadBool => true,
        IrOpcode::IrLoadString => true,
        IrOpcode::IrBinOp => true,
        IrOpcode::IrUnaryOp => true,
        IrOpcode::IrCopy => true,
        IrOpcode::IrCall => true,
        IrOpcode::IrCallSret => true,
        IrOpcode::IrFieldGet => true,
        IrOpcode::IrIndexGet => true,
        IrOpcode::IrAlloc => true,
        IrOpcode::IrMeasure => true,
        IrOpcode::IrContest => true,
        IrOpcode::IrProveRobust => true,
        IrOpcode::IrValidated => true,
        _ => false,
    }
}

// Returns true if this opcode has observable side effects (must not be removed)
fn ocp_has_side_effect(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrCall => true,
        IrOpcode::IrCallSret => true,
        IrOpcode::IrReturn => true,
        IrOpcode::IrReturnSret => true,
        IrOpcode::IrJump => true,
        IrOpcode::IrBranchTrue => true,
        IrOpcode::IrBranchFalse => true,
        IrOpcode::IrLabel => true,
        IrOpcode::IrFieldSet => true,
        IrOpcode::IrIndexSet => true,
        IrOpcode::IrProfCounter => true,
        IrOpcode::IrAdmitAction => true,
        _ => false,
    }
}

// ============================================================================
// Opcode equality helpers retained locally for standalone checking.
// In the full flat concat we already have a shared global opcode helper, so
// these stay prefixed to avoid duplicate definitions.
// ============================================================================

fn ocp_matches_opcode(op: IrOpcode, target: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm    => match target { IrOpcode::IrLoadImm    => true, _ => false },
        IrOpcode::IrLoadFloat  => match target { IrOpcode::IrLoadFloat  => true, _ => false },
        IrOpcode::IrLoadBool   => match target { IrOpcode::IrLoadBool   => true, _ => false },
        IrOpcode::IrLoadString => match target { IrOpcode::IrLoadString => true, _ => false },
        IrOpcode::IrCopy       => match target { IrOpcode::IrCopy       => true, _ => false },
        IrOpcode::IrBinOp      => match target { IrOpcode::IrBinOp      => true, _ => false },
        IrOpcode::IrUnaryOp    => match target { IrOpcode::IrUnaryOp    => true, _ => false },
        IrOpcode::IrCall       => match target { IrOpcode::IrCall       => true, _ => false },
        IrOpcode::IrCallSret   => match target { IrOpcode::IrCallSret   => true, _ => false },
        IrOpcode::IrReturn     => match target { IrOpcode::IrReturn     => true, _ => false },
        IrOpcode::IrReturnSret => match target { IrOpcode::IrReturnSret => true, _ => false },
        IrOpcode::IrJump       => match target { IrOpcode::IrJump       => true, _ => false },
        IrOpcode::IrBranchTrue  => match target { IrOpcode::IrBranchTrue  => true, _ => false },
        IrOpcode::IrBranchFalse => match target { IrOpcode::IrBranchFalse => true, _ => false },
        IrOpcode::IrFieldGet   => match target { IrOpcode::IrFieldGet   => true, _ => false },
        IrOpcode::IrFieldSet   => match target { IrOpcode::IrFieldSet   => true, _ => false },
        IrOpcode::IrIndexGet   => match target { IrOpcode::IrIndexGet   => true, _ => false },
        IrOpcode::IrIndexSet   => match target { IrOpcode::IrIndexSet   => true, _ => false },
        IrOpcode::IrAlloc      => match target { IrOpcode::IrAlloc      => true, _ => false },
        IrOpcode::IrLabel      => match target { IrOpcode::IrLabel      => true, _ => false },
        IrOpcode::IrNop        => match target { IrOpcode::IrNop        => true, _ => false },
        IrOpcode::IrPhi        => match target { IrOpcode::IrPhi        => true, _ => false },
        _ => false,
    }
}

fn ocp_opcodes_equal(a: IrOpcode, b: IrOpcode) -> bool {
    match a {
        IrOpcode::IrLoadImm    => ocp_matches_opcode(b, IrOpcode::IrLoadImm),
        IrOpcode::IrLoadFloat  => ocp_matches_opcode(b, IrOpcode::IrLoadFloat),
        IrOpcode::IrLoadBool   => ocp_matches_opcode(b, IrOpcode::IrLoadBool),
        IrOpcode::IrLoadString => ocp_matches_opcode(b, IrOpcode::IrLoadString),
        IrOpcode::IrCopy       => ocp_matches_opcode(b, IrOpcode::IrCopy),
        IrOpcode::IrBinOp      => ocp_matches_opcode(b, IrOpcode::IrBinOp),
        IrOpcode::IrUnaryOp    => ocp_matches_opcode(b, IrOpcode::IrUnaryOp),
        IrOpcode::IrCall       => ocp_matches_opcode(b, IrOpcode::IrCall),
        IrOpcode::IrCallSret   => ocp_matches_opcode(b, IrOpcode::IrCallSret),
        IrOpcode::IrReturn     => ocp_matches_opcode(b, IrOpcode::IrReturn),
        IrOpcode::IrReturnSret => ocp_matches_opcode(b, IrOpcode::IrReturnSret),
        IrOpcode::IrJump       => ocp_matches_opcode(b, IrOpcode::IrJump),
        IrOpcode::IrBranchTrue  => ocp_matches_opcode(b, IrOpcode::IrBranchTrue),
        IrOpcode::IrBranchFalse => ocp_matches_opcode(b, IrOpcode::IrBranchFalse),
        IrOpcode::IrFieldGet   => ocp_matches_opcode(b, IrOpcode::IrFieldGet),
        IrOpcode::IrFieldSet   => ocp_matches_opcode(b, IrOpcode::IrFieldSet),
        IrOpcode::IrIndexGet   => ocp_matches_opcode(b, IrOpcode::IrIndexGet),
        IrOpcode::IrIndexSet   => ocp_matches_opcode(b, IrOpcode::IrIndexSet),
        IrOpcode::IrAlloc      => ocp_matches_opcode(b, IrOpcode::IrAlloc),
        IrOpcode::IrLabel      => ocp_matches_opcode(b, IrOpcode::IrLabel),
        IrOpcode::IrNop        => ocp_matches_opcode(b, IrOpcode::IrNop),
        IrOpcode::IrPhi        => ocp_matches_opcode(b, IrOpcode::IrPhi),
        _ => false,
    }
}

// ============================================================================
// Sprint 68: Strength reduction helpers
// ============================================================================

// Returns true for integers that are a power of two and greater than 1.
fn ocp_is_power_of_two(n: i64) -> bool {
    n > 1 && (n & (n - 1)) == 0
}

// Returns floor(log2(n)) for n that is a power of two (n > 1 assumed).
fn ocp_log2(n: i64) -> i64 {
    var r: i64 = 0
    var m = n
    while m > 1 {
        m = m / 2
        r = r + 1
    }
    r
}

// ============================================================================
// Sprint 72: E-graph opcode bridge
// ============================================================================

// Map a Sounio BinaryOp to an EG_OP_* constant understood by the e-graph.
// Unmapped ops return EG_OP_CONST as an opaque placeholder.
pub(crate) fn ocp_binop_to_eg_op(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd { return EG_OP_ADD }
    if op == BinaryOp::OpSub { return EG_OP_SUB }
    if op == BinaryOp::OpMul { return EG_OP_MUL }
    if op == BinaryOp::OpDiv { return EG_OP_DIV }
    EG_OP_CONST
}

// Map BinaryOp to float EG opcode (Sprint 225 epistemic pass)
fn ocp_binop_to_float_eg_op(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd { return EG_OP_FADD }
    if op == BinaryOp::OpSub { return EG_OP_FSUB }
    if op == BinaryOp::OpMul { return EG_OP_FMUL }
    if op == BinaryOp::OpDiv { return EG_OP_FDIV }
    EG_OP_CONST
}

// Check if an opcode is legacy IrMeasure (Sprint 225 epistemic source detection)
fn ocp_is_measure(op: IrOpcode) -> bool {
    match op { IrOpcode::IrMeasure => true, _ => false }
}

fn ocp_is_field_get_named(instr: IrInstr, field_idx: i64, field_name: Name) -> bool with Mut, Div, Panic {
    let idx_ok = if field_idx < 0 { true } else { instr.field_idx == field_idx }
    instr.op == IrOpcode::IrFieldGet
        && idx_ok
        && ir_name_eq(ir_name_at(instr.name_id), field_name)
}

fn ocp_is_field_set_named(instr: IrInstr, field_idx: i64, field_name: Name) -> bool with Mut, Div, Panic {
    let idx_ok = if field_idx < 0 { true } else { instr.field_idx == field_idx }
    instr.op == IrOpcode::IrFieldSet
        && idx_ok
        && ir_name_eq(ir_name_at(instr.name_id), field_name)
}

fn ocp_mark_observed_reg(observed: &! [bool; 256], reg: i64) -> bool with Mut {
    if reg < 0 || reg >= 256 { return false }
    if observed[reg as usize] { return false }
    observed[reg as usize] = true
    true
}

// Observation-aware extraction starts from explicit observation sites
// (returns, branches, terminal observe ops) and walks def-use edges backward.
// This lets the epistemic pass focus on values whose uncertainty is actually
// about to matter, rather than every intermediate Knowledge-derived scalar.
fn ocp_collect_observed_regs(func: IrFunction) -> [bool; 256] with Mut, Div, Panic {
    var observed: [bool; 256] = [false; 256]

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.op == IrOpcode::IrReturn
            || instr.op == IrOpcode::IrBranchTrue
            || instr.op == IrOpcode::IrBranchFalse
            || instr.op == IrOpcode::IrObserveTransition {
            let _ = ocp_mark_observed_reg(&! observed, instr.src1)
        }
        i = i + 1
    }

    var changed = true
    while changed {
        changed = false
        var j = func.instr_count - 1
        while j >= 0 {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (j)))
            if instr.dst >= 0 && instr.dst < 256 && observed[instr.dst as usize] {
                if instr.op == IrOpcode::IrCopy
                    || instr.op == IrOpcode::IrMeasure
                    || instr.op == IrOpcode::IrLiftKnowledge
                    || instr.op == IrOpcode::IrUnaryOp
                    || instr.op == IrOpcode::IrFieldGet
                    || instr.op == IrOpcode::IrIntToFloat
                    || instr.op == IrOpcode::IrFloatToInt {
                    if ocp_mark_observed_reg(&! observed, instr.src1) {
                        changed = true
                    }
                } else if instr.op == IrOpcode::IrBinOp {
                    if ocp_mark_observed_reg(&! observed, instr.src1) {
                        changed = true
                    }
                    if ocp_mark_observed_reg(&! observed, instr.src2) {
                        changed = true
                    }
                } else if instr.op == IrOpcode::IrIndexGet {
                    if ocp_mark_observed_reg(&! observed, instr.src1) {
                        changed = true
                    }
                    if ocp_mark_observed_reg(&! observed, instr.src2) {
                        changed = true
                    }
                }
            }
            j = j - 1
        }
    }

    observed
}

pub(crate) fn ocp_reg_flows_to_observation(func: IrFunction, reg: i64) -> bool with Mut, Div, Panic {
    if reg < 0 || reg >= 256 { return false }
    let observed = ocp_collect_observed_regs(func)
    observed[reg as usize]
}

fn ocp_insert_instr_before(func: IrFunction, insert_idx: i64, instr: IrInstr) -> IrFunction with Mut, Div, Panic {
    if insert_idx < 0 || insert_idx > func.instr_count { return func }
    if func.instr_count >= IR_MAX_INSTRS { return func }

    var result = ir_function_clone(&func)
    var shift: i64 = result.instr_count - 1
    while shift >= insert_idx {
        let new_pos = shift + 1
        if new_pos >= 0 && new_pos < IR_MAX_INSTRS {
            ir_arena_copy_slot(ir_region_slot_w(result.region, (new_pos)),ir_region_slot_r(result.region, (shift)))
        }
        shift = shift - 1
    }
    ir_arena_store(ir_region_slot_w(result.region, (insert_idx)), instr)
    result.instr_count = result.instr_count + 1
    result
}

fn ocp_epi_add_leaf_class(ctx: &! EgSmallContext, reg: i64, unc: i64, observed_leaf: bool) -> i64 with Mut, Div, Panic {
    let cls = eg_small_add_var_with_unc(ctx, reg, unc)
    if observed_leaf {
        eg_small_mark_observed(ctx, cls)
    }
    cls
}

fn ocp_epi_try_synthesize_observed_chain(
    func: IrFunction,
    instr_idx: i64,
    instr: IrInstr,
    algebras: IrAlgebraTable,
    def_at: &[i64; 256],
    epi_reg: &[bool; 256],
    epi_value_reg: &[bool; 256],
    epi_unc: &[i64; 256],
    observed_regs: &[bool; 256],
) -> (bool, IrFunction) with Mut, Div, Panic {
    if instr.bin_op != BinaryOp::OpAdd && instr.bin_op != BinaryOp::OpMul {
        return (false, func)
    }
    if instr.dst < 0 || instr.dst >= 256 || !observed_regs[instr.dst as usize] {
        return (false, func)
    }

    let float_op = ocp_binop_to_float_eg_op(instr.bin_op)
    if float_op != EG_OP_FADD && float_op != EG_OP_FMUL {
        return (false, func)
    }

    let s1 = instr.src1
    let s2 = instr.src2
    let s1_ok = s1 >= 0 && s1 < 256
    let s2_ok = s2 >= 0 && s2 < 256
    if !s1_ok || !s2_ok { return (false, func) }

    let left_def = def_at[s1 as usize]
    let right_def = def_at[s2 as usize]
    let left_nested = left_def >= 0
        && observed_regs[s1 as usize]
        && (IR_A_OP[(ir_region_slot_r(func.region, (left_def))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (left_def))) as usize] as BinaryOp) == instr.bin_op
    let right_nested = right_def >= 0
        && observed_regs[s2 as usize]
        && (IR_A_OP[(ir_region_slot_r(func.region, (right_def))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (right_def))) as usize] as BinaryOp) == instr.bin_op

    if left_nested == right_nested { return (false, func) }

    let inner_instr = if left_nested {
        ir_arena_load(ir_region_slot_r(func.region, (left_def)))
    } else {
        ir_arena_load(ir_region_slot_r(func.region, (right_def)))
    }
    let outer_leaf = if left_nested { s2 } else { s1 }
    let inner_a = inner_instr.src1
    let inner_b = inner_instr.src2
    let outer_ok = outer_leaf >= 0 && outer_leaf < 256
    let inner_a_ok = inner_a >= 0 && inner_a < 256
    let inner_b_ok = inner_b >= 0 && inner_b < 256
    if !outer_ok || !inner_a_ok || !inner_b_ok { return (false, func) }

    var ctx = eg_small_init()
    ocp_configure_small_context(&! ctx, func, algebras)
    // PRECISION_PRESERVING opt-in: this GUM-guided pass deliberately reassociates
    // inexact (f64) operands to extract the lower-uncertainty evaluation order.
    ctx.allow_inexact_reassoc = true
    // A-layer-2: but on a `with Chaotic` path the chaos gate dominates and refuses all
    // reassociation (e^{λt} amplification), overriding the opt-in above.
    ctx.chaotic = func.compile_strategy == IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC

    let class_inner_a = ocp_epi_add_leaf_class(
        &! ctx,
        inner_a,
        if epi_reg[inner_a as usize] { epi_unc[inner_a as usize] } else { 0 },
        epi_value_reg[inner_a as usize] && observed_regs[inner_a as usize]
    )
    let class_inner_b = ocp_epi_add_leaf_class(
        &! ctx,
        inner_b,
        if epi_reg[inner_b as usize] { epi_unc[inner_b as usize] } else { 0 },
        epi_value_reg[inner_b as usize] && observed_regs[inner_b as usize]
    )
    let class_outer = ocp_epi_add_leaf_class(
        &! ctx,
        outer_leaf,
        if epi_reg[outer_leaf as usize] { epi_unc[outer_leaf as usize] } else { 0 },
        epi_value_reg[outer_leaf as usize] && observed_regs[outer_leaf as usize]
    )

    let current_inner = eg_small_add_binop_with_unc(&! ctx, float_op, class_inner_a, class_inner_b)
    let root = if left_nested {
        eg_small_add_binop_with_unc(&! ctx, float_op, current_inner, class_outer)
    } else {
        eg_small_add_binop_with_unc(&! ctx, float_op, class_outer, current_inner)
    }

    eg_small_saturate_float(&! ctx)
    let extracted = eg_small_extract_epistemic(&! ctx, root)
    if extracted.op == EG_OP_VAR {
        var result = ir_function_clone(&func)
        ir_arena_store(ir_region_slot_w(result.region, (instr_idx)), ir_copy(instr.dst, extracted.value))
        return (true, result)
    }
    if extracted.op != float_op || extracted.child_count != 2 {
        return (false, func)
    }

    let left_best = eg_small_extract_epistemic(&! ctx, extracted.children[0])
    let right_best = eg_small_extract_epistemic(&! ctx, extracted.children[1])
    let extracted_left_nested = left_best.op == float_op && left_best.child_count == 2 && right_best.op == EG_OP_VAR
    let extracted_right_nested = right_best.op == float_op && right_best.child_count == 2 && left_best.op == EG_OP_VAR
    if extracted_left_nested == extracted_right_nested { return (false, func) }

    let current_left_nested = left_nested
    if (extracted_left_nested && current_left_nested) || (extracted_right_nested && !current_left_nested) {
        return (false, func)
    }

    let nested_best = if extracted_left_nested { left_best } else { right_best }
    let outer_best = if extracted_left_nested { right_best } else { left_best }
    if outer_best.op != EG_OP_VAR { return (false, func) }

    let nested_a = eg_small_extract_epistemic(&! ctx, nested_best.children[0])
    let nested_b = eg_small_extract_epistemic(&! ctx, nested_best.children[1])
    if nested_a.op != EG_OP_VAR || nested_b.op != EG_OP_VAR { return (false, func) }

    let temp_reg = if func.reg_count >= 0 { func.reg_count } else { 0 }
    if temp_reg >= 256 { return (false, func) }
    let inserted = ir_binop(temp_reg, nested_a.value, instr.bin_op, nested_b.value)
    var result = ocp_insert_instr_before(func, instr_idx, inserted)
    if result.instr_count == func.instr_count { return (false, func) }
    let patched_idx = instr_idx + 1
    if extracted_left_nested {
        ir_arena_store(ir_region_slot_w(result.region, (patched_idx)), ir_binop(instr.dst, temp_reg, instr.bin_op, outer_best.value))
    } else {
        ir_arena_store(ir_region_slot_w(result.region, (patched_idx)), ir_binop(instr.dst, outer_best.value, instr.bin_op, temp_reg))
    }
    if temp_reg >= result.reg_count {
        result.reg_count = temp_reg + 1
    }
    (true, result)
}

// CSE can canonicalize a few more commutative ops than the small e-graph layer.
// Keep those keys local so the e-graph surface does not need to pretend it
// understands OR/AND/XOR rewrites it cannot yet optimize.
fn ocp_binop_to_cse_key(op: BinaryOp) -> i64 {
    let eg = ocp_binop_to_eg_op(op)
    if eg != EG_OP_CONST { return eg }
    if op == BinaryOp::OpOr { return 1001 }
    if op == BinaryOp::OpAnd { return 1002 }
    if op == BinaryOp::OpBitXor { return 1003 }
    0
}

// Sprint 84: Returns a non-zero key for ops that are associative over integers.
// Used by Block L to detect reassociation opportunities.
// Only Add, Mul, BitAnd, BitOr, BitXor are included — Sub/Div/Shl/Shr are excluded.
// (Shifts handled separately by Sprint 96 Block T with dedicated sh_valid arrays.)
// SOTA: Click "Combining Reductions" PLDI 1995 §4.
fn ocp_binop_to_ra_key(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd    { return 1 }
    if op == BinaryOp::OpMul    { return 2 }
    if op == BinaryOp::OpBitAnd { return 3 }
    if op == BinaryOp::OpBitOr  { return 4 }
    if op == BinaryOp::OpBitXor { return 5 }
    0
}

// ============================================================================
// Pass 1: Constant propagation + folding
// ============================================================================

// Run constant propagation + folding on a single function.
// Tracks integer constants in a fixed-size register map (256 regs max).
// Folds IrBinOp when both src operands are known integer constants.
// Sprint 68: def_at[r] records the instruction index where r was last set by IrLoadImm,
// enabling in-place patching of the constant when strength reduction rewrites it.
pub(crate) fn ocp_const_fold(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var audit = ocp_empty_exact_bitwise_rebracket_pass_audit()
    ocp_const_fold_with_audit(func, &! audit)
}

fn ocp_const_fold_with_audit(
    func: IrFunction,
    exact_bitwise_audit: &! OcpExactBitwiseRebracketPassAudit,
) -> IrFunction with Mut, Div, Panic {
    // Split below the gen N-1 bootstrap compiler's hard cap of 1024 local
    // variables per function. NOTE on the cap: the bootstrap counts EVERY let/var
    // DECLARATION, including mid-line ones after a semicolon (`let a = x; let b = y`
    // is two locals) — not just line-starting lets. Counted that way the original
    // single interleaved loop declared ~1170 locals, and even the round-1 partition
    // left pass_a at 1170 (still over cap). Round 2 therefore splits pass_a itself
    // into pass_a1 + pass_a2, so every function in this file has a TRUE let/var
    // token count well under the cap (verify with an awk per-fn gsub over the
    // pattern `(^|[^A-Za-z_])(let|var)[[:space:]]`).
    //
    // The passes run in order a1 -> a2 -> b; each later pass sees the earlier
    // passes' rewrites. Each pass independently re-derives its tracking state
    // (is_const/const_val/def_at and its own trackers) from the current
    // instruction stream via its replicated IrLoadImm / IrLoadBool maintenance
    // blocks. It is SAFE to separate blocks that share a tracking array ACROSS
    // passes: each pass re-derives its own state, so a separated pattern simply
    // fires on a later optimizer-fixpoint iteration instead of the same one. The
    // ONLY semantic delta versus the single interleaved loop is fold-strength per
    // iteration; folding is conservative (every fold is guarded by a *_valid /
    // is_* flag that defaults false), so a pattern whose tracking state is not
    // re-derived in the current pass simply does not fire — it never fires
    // wrongly. Correctness is unaffected and the outer fixpoint recovers it.
    //
    // a1 and a2 each carry the full tracking-array preamble verbatim (a superset
    // of what their blocks need, never a missing decl) plus the IrLoadImm /
    // IrLoadBool maintenance. The known co-located scalar dependency
    // (preserve_mul_chain written by the associative-chain block and read by the
    // Sprint 68 strength-reduction block) lives entirely in pass_b and is NOT
    // touched here. Local verification of the cap: strip the `use` lines and feed
    // the file to the bootstrap; it must report zero "too many local" errors.
    var result = func
    result = ocp_const_fold_pass_a1(result)
    result = ocp_const_fold_pass_a2(result)
    result = ocp_const_fold_pass_b(result, exact_bitwise_audit)
    return result
}

fn ocp_const_fold_pass_a1(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var is_const: [bool; 256] = [false; 256]
    var const_val: [i64; 256] = [0; 256]
    var def_at: [i64; 256] = [-1; 256]
    // Sprint 86 Block M: Negation tracking for double-neg and neg-arithmetic.
    var is_neg:  [bool; 256] = [false; 256]
    var neg_src: [i64;  256] = [-1;    256]
    // Sprint 112 Block AI: Bitwise NOT via XOR(-1) tracking.
    var is_bnot:  [bool; 256] = [false; 256]
    var bnot_src: [i64;  256] = [-1;    256]
    // Sprint 88 Block O: Mul-div cancellation — track r = x * C (partial-const mul).
    // (x * C) / C → x.  SOTA: LLVM InstCombineMulDivRem.cpp; Cooper & Torczon §9.
    var mul_valid:   [bool; 256] = [false; 256]
    var mul_var_src: [i64;  256] = [-1;    256]
    var mul_const_v: [i64;  256] = [0;     256]
    // Sprint 89 Block P: Add-sub/sub-add cancellation — track r = x +/- C.
    // (x + C) - C → x  ;  (x - C) + C → x.
    // SOTA: LLVM InstCombineAddSub.cpp; Muchnick §12.2.
    var as_valid:   [bool; 256] = [false; 256]
    var as_var_src: [i64;  256] = [-1;    256]
    var as_const_v: [i64;  256] = [0;     256]
    var as_is_add:  [bool; 256] = [false; 256]
    // Sprint 96 Block T: Shift-chain combining — track r = x << C or r = x >> C.
    // (x << C1) << C2 → x << (C1+C2)  ;  (x >> C1) >> C2 → x >> (C1+C2).
    // SOTA: Bernstein SODA 1986; LLVM InstCombineShifts.cpp.
    var sh_valid:   [bool; 256] = [false; 256]
    var sh_var_src: [i64;  256] = [-1;    256]
    var sh_amount:  [i64;  256] = [0;     256]
    var sh_is_left: [bool; 256] = [false; 256]
    // Sprint 108 Block AE: track r = x & C for non-rebracketing identities.
    // Exact constant-chain rebracketing is owned exclusively by Block L.
    var and_valid:     [bool; 256] = [false; 256]
    var and_var_src:   [i64;  256] = [-1;    256]
    var and_const_val: [i64;  256] = [0;     256]
    // Sprint 115 Block AL: Sub-tracking for neg reversal.
    // al_is_sub[r]=true means r = al_sub_lhs[r] - al_sub_rhs[r].
    // neg(a - b) -> b - a  ;  0 - (a - b) -> b - a.
    // SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.
    var al_is_sub:  [bool; 256] = [false; 256]
    var al_sub_lhs: [i64;  256] = [-1;    256]
    var al_sub_rhs: [i64;  256] = [-1;    256]
    // Sprint 116 Block AM: OR-mask tracking for superset elimination.
    // (x | C1) | C2 where (C1 | C2) == C1 → IrCopy(src1).
    // SOTA: LLVM InstCombineAndOrXor.cpp.
    var am_or_valid:     [bool; 256] = [false; 256]
    var am_or_var_src:   [i64;  256] = [-1;    256]
    var am_or_const_val: [i64;  256] = [0;     256]
    // Sprint 127 Block AO: Register-register AND/OR tracking for absorption.
    // Huntington 1904 absorption axiom: a | (a & b) = a, a & (a | b) = a.
    // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1.
    var ao_and_rr_valid: [bool; 256] = [false; 256]
    var ao_and_rr_lhs:   [i64;  256] = [-1;    256]
    var ao_and_rr_rhs:   [i64;  256] = [-1;    256]
    var ao_or_rr_valid:  [bool; 256] = [false; 256]
    var ao_or_rr_lhs:    [i64;  256] = [-1;    256]
    var ao_or_rr_rhs:    [i64;  256] = [-1;    256]
    // Sprint 129 Block AQ: Register-register add/mul tracking for inverse cancellation.
    // (a + b) - b → a, (a * b) / b → a.
    // SOTA: LLVM InstCombine algebraic identity; group-theoretic inverse.
    var aq_add_rr_valid: [bool; 256] = [false; 256]
    var aq_add_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_add_rr_rhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_valid: [bool; 256] = [false; 256]
    var aq_mul_rr_lhs:   [i64;  256] = [-1;    256]
    var aq_mul_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 131 Block AS: Register-register XOR tracking for self-inverse cancellation.
    // (a ^ b) ^ b → a, (a ^ b) ^ a → b.
    // SOTA: LLVM InstCombineAndOrXor; GF(2) field: XOR is its own inverse.
    var as_xor_rr_valid: [bool; 256] = [false; 256]
    var as_xor_rr_lhs:   [i64;  256] = [-1;    256]
    var as_xor_rr_rhs:   [i64;  256] = [-1;    256]
    // Sprint 149 Block BK: Consecutive same-direction shift folding.
    // (x << A) << B → x << (A+B), (x >> A) >> B → x >> (A+B).
    // Track when a register is the result of a shift by a known constant.
    // SOTA: LLVM InstCombineShifts.cpp FoldShiftByConstant; Cooper & Torczon §8.1.
    var bk_shl_valid: [bool; 256] = [false; 256]
    var bk_shl_src:   [i64;  256] = [-1;    256]
    var bk_shl_amt:   [i64;  256] = [0;     256]
    var bk_shr_valid: [bool; 256] = [false; 256]
    var bk_shr_src:   [i64;  256] = [-1;    256]
    var bk_shr_amt:   [i64;  256] = [0;     256]
    // Sprint 151 Block BM: track r = x ^ C for non-rebracketing identities.
    // Exact constant-chain rebracketing is owned exclusively by Block L.
    var bm_xor_valid: [bool; 256] = [false; 256]
    var bm_xor_src:   [i64;  256] = [-1;    256]
    var bm_xor_cval:  [i64;  256] = [0;     256]

    var i: i64 = 0
    while i < result.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
        var preserve_mul_chain = false
        if instr.dst >= 0 && instr.dst < 256 {
            let d = instr.dst as usize
            is_const[d] = false
            is_neg[d] = false
            is_bnot[d] = false
            mul_valid[d] = false
            as_valid[d] = false
            sh_valid[d] = false
            and_valid[d] = false
            al_is_sub[d] = false
            am_or_valid[d] = false
            ao_and_rr_valid[d] = false
            ao_or_rr_valid[d] = false
            aq_add_rr_valid[d] = false
            aq_mul_rr_valid[d] = false
            as_xor_rr_valid[d] = false
            bk_shl_valid[d] = false
            bk_shr_valid[d] = false
            bm_xor_valid[d] = false
        }
        // Track IrLoadImm: register dst becomes a known constant
        if ocp_is_load_imm(instr.op) {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }
        // Sprint 83 Block K: IrLoadBool constant tracking.
        // IrLoadBool stores true→1, false→0 in imm_i64. Tracking booleans in the
        // constant lattice enables downstream Block F branch folding, Block E
        // comparison folding, and SCCP on boolean-valued registers.
        // SOTA: Click "Value Numbering" PLDI 1995 §2 — all value-producing
        // instructions participate in the constant lattice.
        if instr.op == IrOpcode::IrLoadBool {
            if instr.dst >= 0 && instr.dst < 256 {
                is_const[instr.dst as usize] = true
                const_val[instr.dst as usize] = instr.imm_i64
                def_at[instr.dst as usize] = i
            }
        }
        // Sprint 67: Partial-constant identity/annihilation folding.
        // Fires when exactly one operand is a known constant and a simplification applies.
        // The resulting IrCopy or IrLoadImm leaves the old IrLoadImm dead; DCE removes it.
        if ocp_is_binop(instr.op) {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1_ok = s1 >= 0 && s1 < 256
            let s2_ok = s2 >= 0 && s2 < 256
            let s1_known = s1_ok && is_const[s1 as usize]
            let s2_known = s2_ok && is_const[s2 as usize]
            // Only fire when exactly one side is constant (full-constant handled above).
            if (s1_known && !s2_known) || (!s1_known && s2_known) {
                let v2 = if s2_known { const_val[s2 as usize] } else { 0 }
                let v1 = if s1_known { const_val[s1 as usize] } else { 0 }
                // x * 1 → IrCopy(dst, x)  ;  1 * x → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpMul {
                    if s2_known && v2 == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    if s1_known && v1 == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                    }
                    // x * 0 → IrLoadImm(dst, 0)  ;  0 * x → IrLoadImm(dst, 0)
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    // Sprint 88 Block O: Track r = x * C for mul-div cancellation.
                    if instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && v2 != 0 && !s1_known {
                            mul_valid[instr.dst as usize]   = true
                            mul_var_src[instr.dst as usize] = s1
                            mul_const_v[instr.dst as usize] = v2
                        }
                        if s1_known && v1 != 0 && !s2_known {
                            mul_valid[instr.dst as usize]   = true
                            mul_var_src[instr.dst as usize] = s2
                            mul_const_v[instr.dst as usize] = v1
                        }
                    }
                    // Sprint 89 Block P: Track r = x + C (commutative).
                    if instr.bin_op == BinaryOp::OpAdd && instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && !s1_known && s1 >= 0 && s1 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s1
                            as_const_v[instr.dst as usize] = v2
                            as_is_add[instr.dst as usize]  = true
                        }
                        if s1_known && !s2_known && s2 >= 0 && s2 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s2
                            as_const_v[instr.dst as usize] = v1
                            as_is_add[instr.dst as usize]  = true
                        }
                    }
                    // Sprint 89 Block P: Track r = x - C.
                    if instr.bin_op == BinaryOp::OpSub && instr.dst >= 0 && instr.dst < 256 {
                        if s2_known && !s1_known && s1 >= 0 && s1 < 256 {
                            as_valid[instr.dst as usize]   = true
                            as_var_src[instr.dst as usize] = s1
                            as_const_v[instr.dst as usize] = v2
                            as_is_add[instr.dst as usize]  = false
                        }
                    }
                    // Sprint 89 Block P fold: (x + C) - C → IrCopy(x).
                    if instr.bin_op == BinaryOp::OpSub && s2_known && !s1_known
                            && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && as_is_add[s1 as usize] && as_const_v[s1 as usize] == v2 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, as_var_src[s1 as usize]))
                        if instr.dst >= 0 && instr.dst < 256 {
                            as_valid[instr.dst as usize] = false
                        }
                    }
                    // Sprint 89 Block P fold: (x - C) + C → IrCopy(x).
                    if instr.bin_op == BinaryOp::OpAdd && s2_known && !s1_known
                            && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && !as_is_add[s1 as usize] && as_const_v[s1 as usize] == v2 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, as_var_src[s1 as usize]))
                        if instr.dst >= 0 && instr.dst < 256 {
                            as_valid[instr.dst as usize] = false
                        }
                    }
                    // Sprint 111 Block AH: Add/sub chain constant merging (unequal C).
                    // (x - C1) - C2 → x - (C1+C2)
                    // (x - C1) + C2 → x +/- |C2-C1|  (net offset)
                    // (x + C1) - C2 → x +/- |C1-C2|  (net offset)
                    // SOTA: LLVM InstCombineAddSub.cpp; Click PLDI 1995 §4.
                    if s2_known && !s1_known && s1 >= 0 && s1 < 256 && as_valid[s1 as usize]
                            && as_const_v[s1 as usize] != v2 {
                        let ah_base = as_var_src[s1 as usize]
                        let ah_c1   = as_const_v[s1 as usize]
                        let ah_was_add = as_is_add[s1 as usize]
                        let ah_c2_def = def_at[s2 as usize]
                        if ah_c2_def >= 0 {
                            // (x - C1) - C2 → x - (C1 + C2)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpSub {
                                let ah_merged = ah_c1 + v2
                                ir_arena_store(ir_region_slot_w(result.region, (ah_c2_def)), ir_load_imm(s2, ah_merged))
                                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2))
                                const_val[s2 as usize] = ah_merged
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_merged
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x - C1) + C2, C2 > C1 → x + (C2 - C1)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpAdd && v2 > ah_c1 {
                                let ah_net = v2 - ah_c1
                                ir_arena_store(ir_region_slot_w(result.region, (ah_c2_def)), ir_load_imm(s2, ah_net))
                                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, ah_base, BinaryOp::OpAdd, s2))
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = true
                                }
                            }
                            // (x - C1) + C2, C2 < C1 → x - (C1 - C2)
                            if !ah_was_add && instr.bin_op == BinaryOp::OpAdd && v2 < ah_c1 {
                                let ah_net = ah_c1 - v2
                                ir_arena_store(ir_region_slot_w(result.region, (ah_c2_def)), ir_load_imm(s2, ah_net))
                                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2))
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x + C1) - C2, C2 > C1 → x - (C2 - C1)
                            if ah_was_add && instr.bin_op == BinaryOp::OpSub && v2 > ah_c1 {
                                let ah_net = v2 - ah_c1
                                ir_arena_store(ir_region_slot_w(result.region, (ah_c2_def)), ir_load_imm(s2, ah_net))
                                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, ah_base, BinaryOp::OpSub, s2))
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = false
                                }
                            }
                            // (x + C1) - C2, C2 < C1 → x + (C1 - C2)
                            if ah_was_add && instr.bin_op == BinaryOp::OpSub && v2 < ah_c1 {
                                let ah_net = ah_c1 - v2
                                ir_arena_store(ir_region_slot_w(result.region, (ah_c2_def)), ir_load_imm(s2, ah_net))
                                ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(instr.dst, ah_base, BinaryOp::OpAdd, s2))
                                const_val[s2 as usize] = ah_net
                                if instr.dst >= 0 && instr.dst < 256 {
                                    as_valid[instr.dst as usize]   = true
                                    as_var_src[instr.dst as usize] = ah_base
                                    as_const_v[instr.dst as usize] = ah_net
                                    as_is_add[instr.dst as usize]  = true
                                }
                            }
                        }
                    }
                }
                // x + 0 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpAdd {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                    }
                }
                // x - 0 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpSub {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                }
                // x / 1 → IrCopy(dst, x)
                if instr.bin_op == BinaryOp::OpDiv {
                    if s2_known && v2 == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    // Sprint 95 Block S: 0 / x → 0  (zero dividend).
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                            def_at[instr.dst as usize] = i
                        }
                    }
                    // Sprint 88 Block O: (x * C) / C → x — mul-div cancellation.
                    // Safe: v2 != 0 guard prevents div-by-zero; only fires when s1=r was produced
                    // by a partial-const mul with the same constant C.
                    if s2_known && v2 != 0 && s1 >= 0 && s1 < 256 && mul_valid[s1 as usize]
                            && mul_const_v[s1 as usize] == v2 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, mul_var_src[s1 as usize]))
                        if instr.dst >= 0 && instr.dst < 256 {
                            mul_valid[instr.dst as usize] = false
                        }
                    }
                }
                // Sprint 81 Block I: x % 1 → IrLoadImm(dst, 0)
                // Remainder by 1 is always 0 for any integer (Cooper & Torczon §9.2).
                if instr.bin_op == BinaryOp::OpRem {
                    if s2_known && v2 == 1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    // Sprint 95 Block S: 0 % x → 0  (zero dividend mod).
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                            def_at[instr.dst as usize] = i
                        }
                    }
                }
                // Sprint 72 Block C: Bitwise identity/annihilator folding.
                // x & 0 → 0  ;  0 & x → 0  (AND annihilator)
                // x & (-1) → x  ;  (-1) & x → x  (AND identity, -1 = all-ones)
                // x | 0 → x  ;  0 | x → x  (OR identity)
                // x | (-1) → -1  ;  (-1) | x → -1  (OR annihilator)
                // x ^ 0 → x  ;  0 ^ x → x  (XOR identity, distinct from x^x=0)
                if instr.bin_op == BinaryOp::OpBitAnd {
                    if (s2_known && v2 == 0) || (s1_known && v1 == 0) {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, 0))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = 0
                        }
                    }
                    if s2_known && v2 == -1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    if s1_known && v1 == -1 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                    }
                }
                // Sprint 114 Block AK: Redundant AND elimination (superset mask).
                // (x & C1) & C2 where (C1 & C2) == C1 → IrCopy(src1).
                // The outer mask is a superset of the inner — AND is a no-op.
                // SOTA: LLVM InstCombineAndOrXor.cpp; known-bits analysis.
                if instr.bin_op == BinaryOp::OpBitAnd {
                    // s2 is const, s1 was AND-masked: check superset
                    if s2_known && s1 >= 0 && s1 < 256 && and_valid[s1 as usize] {
                        let ak_c1 = and_const_val[s1 as usize]
                        if (ak_c1 & v2) == ak_c1 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                            if instr.dst >= 0 && instr.dst < 256 {
                                and_valid[instr.dst as usize]     = true
                                and_var_src[instr.dst as usize]   = and_var_src[s1 as usize]
                                and_const_val[instr.dst as usize] = ak_c1
                            }
                        }
                    }
                    // s1 is const, s2 was AND-masked: check superset (commutative)
                    if s1_known && s2 >= 0 && s2 < 256 && and_valid[s2 as usize] {
                        let ak_c2 = and_const_val[s2 as usize]
                        if (ak_c2 & v1) == ak_c2 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                            if instr.dst >= 0 && instr.dst < 256 {
                                and_valid[instr.dst as usize]     = true
                                and_var_src[instr.dst as usize]   = and_var_src[s2 as usize]
                                and_const_val[instr.dst as usize] = ak_c2
                            }
                        }
                    }
                }
                // Block AE keeps only its shape tracking here. The former direct
                // (x & C1) & C2 rewrite bypassed occurrence-bound authority and
                // made Block L unreachable from lowered source. Block L now owns
                // that exact ordered constant-chain mutation.
                if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (i))) as usize] as BinaryOp) == BinaryOp::OpBitAnd {
                    if s2_known && !s1_known && !(s1 >= 0 && s1 < 256 && and_valid[s1 as usize]) && instr.dst >= 0 && instr.dst < 256 {
                        and_valid[instr.dst as usize]     = true
                        and_var_src[instr.dst as usize]   = s1
                        and_const_val[instr.dst as usize] = v2
                    }
                    if s1_known && !s2_known && !(s2 >= 0 && s2 < 256 && and_valid[s2 as usize]) && instr.dst >= 0 && instr.dst < 256 {
                        and_valid[instr.dst as usize]     = true
                        and_var_src[instr.dst as usize]   = s2
                        and_const_val[instr.dst as usize] = v1
                    }
                    // Sprint 118 Block AN: (x | C1) & C2 → C2 when (C1 & C2) == C2.
                    // All bits of C2 are already set by the OR — AND just extracts C2 as a constant.
                    // Chains with Block AM (OR tracking) and Block AK (AND superset).
                    // SOTA: LLVM InstCombineAndOrXor.cpp known-bits analysis; Hacker's Delight §2.
                    if s2_known && s1 >= 0 && s1 < 256 && am_or_valid[s1 as usize] {
                        let an_c1 = am_or_const_val[s1 as usize]
                        if (an_c1 & v2) == v2 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, v2))
                            if instr.dst >= 0 && instr.dst < 256 {
                                is_const[instr.dst as usize] = true
                                const_val[instr.dst as usize] = v2
                            }
                        }
                    }
                    // Commutative: C2 & (x | C1) → C2 when (C1 & C2) == C2.
                    if s1_known && s2 >= 0 && s2 < 256 && am_or_valid[s2 as usize] {
                        let an_c2 = am_or_const_val[s2 as usize]
                        if (an_c2 & v1) == v1 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, v1))
                            if instr.dst >= 0 && instr.dst < 256 {
                                is_const[instr.dst as usize] = true
                                const_val[instr.dst as usize] = v1
                            }
                        }
                    }
                }
                if instr.bin_op == BinaryOp::OpBitOr {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                    }
                    if (s2_known && v2 == -1) || (s1_known && v1 == -1) {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_load_imm(instr.dst, -1))
                        if instr.dst >= 0 && instr.dst < 256 {
                            is_const[instr.dst as usize] = true
                            const_val[instr.dst as usize] = -1
                        }
                    }
                    // Sprint 116 Block AM: OR superset mask — (x | C1) | C2 where (C1 | C2) == C1 → IrCopy.
                    if s2_known && s1 >= 0 && s1 < 256 && am_or_valid[s1 as usize] {
                        let am_c1 = am_or_const_val[s1 as usize]
                        if (am_c1 | v2) == am_c1 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                            if instr.dst >= 0 && instr.dst < 256 {
                                am_or_valid[instr.dst as usize]     = true
                                am_or_var_src[instr.dst as usize]   = am_or_var_src[s1 as usize]
                                am_or_const_val[instr.dst as usize] = am_c1
                            }
                        }
                    }
                    // Commutative: C2 | (x | C1) where (C1 | C2) == C1 → IrCopy.
                    if s1_known && s2 >= 0 && s2 < 256 && am_or_valid[s2 as usize] {
                        let am_c2 = am_or_const_val[s2 as usize]
                        if (am_c2 | v1) == am_c2 {
                            ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                            if instr.dst >= 0 && instr.dst < 256 {
                                am_or_valid[instr.dst as usize]     = true
                                am_or_var_src[instr.dst as usize]   = am_or_var_src[s2 as usize]
                                am_or_const_val[instr.dst as usize] = am_c2
                            }
                        }
                    }
                    // Track new OR-with-constant for chaining.
                    if s2_known && !s1_known && instr.dst >= 0 && instr.dst < 256 {
                        am_or_valid[instr.dst as usize]     = true
                        am_or_var_src[instr.dst as usize]   = s1
                        am_or_const_val[instr.dst as usize] = v2
                    }
                    if s1_known && !s2_known && instr.dst >= 0 && instr.dst < 256 {
                        am_or_valid[instr.dst as usize]     = true
                        am_or_var_src[instr.dst as usize]   = s2
                        am_or_const_val[instr.dst as usize] = v1
                    }
                }
                // The former Block BG direct OR-chain rewrite is deferred to
                // authority-owned Block L. Block AM tracking above remains for
                // its non-rebracketing superset and absorption consumers.
                if instr.bin_op == BinaryOp::OpBitXor {
                    if s2_known && v2 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s1))
                    }
                    if s1_known && v1 == 0 {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(instr.dst, s2))
                    }
                }
            }
        }
        // ====================================================================
        // Sprint 127 Block AO: Absorption laws.
        // a | (a & X) → a  ;  a & (a | X) → a  (X may be constant or register).
        // Huntington 1904 absorption axiom — one of the four fundamental Boolean
        // algebra identities (commutative, associative, distributive, absorption).
        // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-1.
        //
        // Sprint 128 Block AP: Idempotent subsumption.
        // (a | b) | a → (a | b)  ;  (a & b) & a → (a & b).
        // An operand already present in a subexpression is redundant.
        // SOTA: Boolean algebra idempotent law; Hacker's Delight §2-1.
        //
        // Sprint 129 Block AQ: Register-register inverse cancellation.
        // (a + b) - b → a  ;  (a + b) - a → b  (additive inverse)
        // (a * b) / b → a  ;  (a * b) / a → b  (multiplicative inverse)
        // SOTA: LLVM InstCombine algebraic; group-theoretic inverse.
        // ====================================================================
        if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
            let ao_instr = ir_arena_load(ir_region_slot_r(result.region, (i)))
            let ao_s1 = ao_instr.src1
            let ao_s2 = ao_instr.src2
            let ao_s1_ok = ao_s1 >= 0 && ao_s1 < 256
            let ao_s2_ok = ao_s2 >= 0 && ao_s2 < 256

            // ---- Block AO: OR-absorption: a | (a & _) → a ----
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // a | (a & C) → a  [constant-operand AND tracking]
                if ao_s2_ok && and_valid[ao_s2 as usize] && and_var_src[ao_s2 as usize] == ao_s1 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // (a & C) | a → a  [commutative]
                if ao_s1_ok && and_valid[ao_s1 as usize] && and_var_src[ao_s1 as usize] == ao_s2 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
                // a | (a & b) → a  [register-register AND tracking]
                if ao_s2_ok && ao_and_rr_valid[ao_s2 as usize]
                        && (ao_and_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_and_rr_rhs[ao_s2 as usize] == ao_s1) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // (a & b) | a → a  [commutative]
                if ao_s1_ok && ao_and_rr_valid[ao_s1 as usize]
                        && (ao_and_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_and_rr_rhs[ao_s1 as usize] == ao_s2) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
            }

            // ---- Block AO: AND-absorption: a & (a | _) → a ----
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // a & (a | C) → a  [constant-operand OR tracking]
                if ao_s2_ok && am_or_valid[ao_s2 as usize] && am_or_var_src[ao_s2 as usize] == ao_s1 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // (a | C) & a → a  [commutative]
                if ao_s1_ok && am_or_valid[ao_s1 as usize] && am_or_var_src[ao_s1 as usize] == ao_s2 {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
                // a & (a | b) → a  [register-register OR tracking]
                if ao_s2_ok && ao_or_rr_valid[ao_s2 as usize]
                        && (ao_or_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_or_rr_rhs[ao_s2 as usize] == ao_s1) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // (a | b) & a → a  [commutative]
                if ao_s1_ok && ao_or_rr_valid[ao_s1 as usize]
                        && (ao_or_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_or_rr_rhs[ao_s1 as usize] == ao_s2) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
            }

            // ---- Block AP: OR-subsumption: (a | b) | a → (a | b) ----
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // (a | b) | a → copy(a | b)  [s1 is OR, s2 is one of its operands]
                if ao_s1_ok && ao_or_rr_valid[ao_s1 as usize]
                        && (ao_or_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_or_rr_rhs[ao_s1 as usize] == ao_s2) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // a | (a | b) → copy(a | b)  [s2 is OR, s1 is one of its operands]
                if ao_s2_ok && ao_or_rr_valid[ao_s2 as usize]
                        && (ao_or_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_or_rr_rhs[ao_s2 as usize] == ao_s1) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
            }

            // ---- Block AP: AND-subsumption: (a & b) & a → (a & b) ----
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // (a & b) & a → copy(a & b)
                if ao_s1_ok && ao_and_rr_valid[ao_s1 as usize]
                        && (ao_and_rr_lhs[ao_s1 as usize] == ao_s2
                            || ao_and_rr_rhs[ao_s1 as usize] == ao_s2) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s1))
                }
                // a & (a & b) → copy(a & b)
                if ao_s2_ok && ao_and_rr_valid[ao_s2 as usize]
                        && (ao_and_rr_lhs[ao_s2 as usize] == ao_s1
                            || ao_and_rr_rhs[ao_s2 as usize] == ao_s1) {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, ao_s2))
                }
            }

            // ---- Block AQ: Additive inverse cancellation ----
            // (a + b) - b → a  ;  (a + b) - a → b
            if ao_instr.bin_op == BinaryOp::OpSub && ao_s1_ok && aq_add_rr_valid[ao_s1 as usize] {
                if ao_s2 == aq_add_rr_rhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, aq_add_rr_lhs[ao_s1 as usize]))
                }
                if ao_s2 == aq_add_rr_lhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, aq_add_rr_rhs[ao_s1 as usize]))
                }
            }

            // ---- Block AQ: Multiplicative inverse cancellation ----
            // (a * b) / b → a  ;  (a * b) / a → b
            if ao_instr.bin_op == BinaryOp::OpDiv && ao_s1_ok && aq_mul_rr_valid[ao_s1 as usize] {
                if ao_s2 == aq_mul_rr_rhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, aq_mul_rr_lhs[ao_s1 as usize]))
                }
                if ao_s2 == aq_mul_rr_lhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, aq_mul_rr_rhs[ao_s1 as usize]))
                }
            }

            // ---- Block AS: XOR self-inverse cancellation ----
            // (a ^ b) ^ b → a  ;  (a ^ b) ^ a → b
            // XOR is its own inverse in GF(2): a ⊕ b ⊕ b = a.
            // SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-3.
            if ao_instr.bin_op == BinaryOp::OpBitXor && ao_s1_ok && as_xor_rr_valid[ao_s1 as usize] {
                if ao_s2 == as_xor_rr_rhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, as_xor_rr_lhs[ao_s1 as usize]))
                }
                if ao_s2 == as_xor_rr_lhs[ao_s1 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, as_xor_rr_rhs[ao_s1 as usize]))
                }
            }
            // b ^ (a ^ b) → a  ;  a ^ (a ^ b) → b  [commutative]
            if ao_instr.bin_op == BinaryOp::OpBitXor && ao_s2_ok && as_xor_rr_valid[ao_s2 as usize] {
                if ao_s1 == as_xor_rr_rhs[ao_s2 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, as_xor_rr_lhs[ao_s2 as usize]))
                }
                if ao_s1 == as_xor_rr_lhs[ao_s2 as usize] {
                    ir_arena_store(ir_region_slot_w(result.region, (i)), ir_copy(ao_instr.dst, as_xor_rr_rhs[ao_s2 as usize]))
                }
            }

            // ---- Block AT: NOT-distributive simplification ----
            // ~a & (a | b) → ~a & b  (eliminates the OR via complement distribution)
            // Proof: ~a & (a | b) = (~a & a) | (~a & b) = 0 | (~a & b) = ~a & b.
            // SOTA: LLVM InstCombineAndOrXor.cpp SimplifyDemandedBits;
            //   Boolean algebra distributive + complement axioms.
            if ao_instr.bin_op == BinaryOp::OpBitAnd {
                // ~a & (a | b) → ~a & b  [s1=~a, s2=a|b, bnot_src[s1]==one of s2's OR operands]
                if ao_s1_ok && is_bnot[ao_s1 as usize]
                        && ao_s2_ok && ao_or_rr_valid[ao_s2 as usize] {
                    let at_a = bnot_src[ao_s1 as usize]
                    if ao_or_rr_lhs[ao_s2 as usize] == at_a {
                        // ~a & (a | b) → ~a & b
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitAnd, ao_or_rr_rhs[ao_s2 as usize]))
                    }
                    if ao_or_rr_rhs[ao_s2 as usize] == at_a {
                        // ~a & (b | a) → ~a & b
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitAnd, ao_or_rr_lhs[ao_s2 as usize]))
                    }
                }
                // (a | b) & ~a → ~a & b  [commutative: s1=a|b, s2=~a]
                if ao_s2_ok && is_bnot[ao_s2 as usize]
                        && ao_s1_ok && ao_or_rr_valid[ao_s1 as usize] {
                    let at_a = bnot_src[ao_s2 as usize]
                    if ao_or_rr_lhs[ao_s1 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitAnd, ao_or_rr_rhs[ao_s1 as usize]))
                    }
                    if ao_or_rr_rhs[ao_s1 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitAnd, ao_or_rr_lhs[ao_s1 as usize]))
                    }
                }
            }
            // ~a | (a & b) → ~a | b  (dual: eliminates the AND)
            // Proof: ~a | (a & b) = (~a | a) & (~a | b) = -1 & (~a | b) = ~a | b.
            if ao_instr.bin_op == BinaryOp::OpBitOr {
                // ~a | (a & b) → ~a | b
                if ao_s1_ok && is_bnot[ao_s1 as usize]
                        && ao_s2_ok && ao_and_rr_valid[ao_s2 as usize] {
                    let at_a = bnot_src[ao_s1 as usize]
                    if ao_and_rr_lhs[ao_s2 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitOr, ao_and_rr_rhs[ao_s2 as usize]))
                    }
                    if ao_and_rr_rhs[ao_s2 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s1, BinaryOp::OpBitOr, ao_and_rr_lhs[ao_s2 as usize]))
                    }
                }
                // (a & b) | ~a → ~a | b  [commutative]
                if ao_s2_ok && is_bnot[ao_s2 as usize]
                        && ao_s1_ok && ao_and_rr_valid[ao_s1 as usize] {
                    let at_a = bnot_src[ao_s2 as usize]
                    if ao_and_rr_lhs[ao_s1 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitOr, ao_and_rr_rhs[ao_s1 as usize]))
                    }
                    if ao_and_rr_rhs[ao_s1 as usize] == at_a {
                        ir_arena_store(ir_region_slot_w(result.region, (i)), ir_binop(ao_instr.dst, ao_s2, BinaryOp::OpBitOr, ao_and_rr_lhs[ao_s1 as usize]))
                    }
                }
            }

            // ---- Tracking population (Sprints 127 + 129 + 131) ----
            // Only populate if instruction was not folded (still a BinOp).
            if ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (i))) as usize] as IrOpcode)) {
                let trk = ir_arena_load(ir_region_slot_r(result.region, (i)))
                let trk_dst = trk.dst
                let trk_s1 = trk.src1
                let trk_s2 = trk.src2
                let trk_s1_ok = trk_s1 >= 0 && trk_s1 < 256
                let trk_s2_ok = trk_s2 >= 0 && trk_s2 < 256
                let trk_s1_const = trk_s1_ok && is_const[trk_s1 as usize]
                let trk_s2_const = trk_s2_ok && is_const[trk_s2 as usize]
                if trk_dst >= 0 && trk_dst < 256 && !trk_s1_const && !trk_s2_const {
                    if trk.bin_op == BinaryOp::OpBitAnd {
                        ao_and_rr_valid[trk_dst as usize] = true
                        ao_and_rr_lhs[trk_dst as usize]   = trk_s1
                        ao_and_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpBitOr {
                        ao_or_rr_valid[trk_dst as usize] = true
                        ao_or_rr_lhs[trk_dst as usize]   = trk_s1
                        ao_or_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpAdd {
                        aq_add_rr_valid[trk_dst as usize] = true
                        aq_add_rr_lhs[trk_dst as usize]   = trk_s1
                        aq_add_rr_rhs[trk_dst as usize]   = trk_s2
                    }
                    if trk.bin_op == BinaryOp::OpMul {
                        aq_mul_rr_valid[trk_dst as usize] = true
