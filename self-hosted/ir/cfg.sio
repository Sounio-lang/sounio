    let cfg = cfg_test_if_then()
    let analyzed = cfg_compute_dominators(cfg)
    let d1 = cfg_dominates(analyzed, 0, 1)
    let d2 = cfg_dominates(analyzed, 0, 2)
    cfg_assert_true(d1 && d2, 35)
}

// T36: Reachable from non-entry block in diamond
fn test_cfga_reachable_from_bb1() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let reach_result = cfg_reachable_from(cfg, 1)
    let count = reach_result.1
    // BB1 -> BB3 only (2 blocks: BB1 and BB3)
    cfg_assert_true(count == 2, 36)
}

// T37: Strict dominance — a does not strictly dominate itself
fn test_cfga_strict_dom_self() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    cfg_assert_true(!cfg_strictly_dominates(analyzed, 0, 0), 37)
}

// T38: cfg_array_contains — positive and negative
fn test_cfga_array_contains() -> bool with Mut, Panic, Div, IO {
    var arr: [i64; 32] = [CFG_INVALID; 32]
    arr[0] = 3
    arr[1] = 7
    arr[2] = 11
    let yes = cfg_array_contains(arr, 3, 7)
    let no = !cfg_array_contains(arr, 3, 5)
    cfg_assert_true(yes && no, 38)
}

// T39: Edge constants are distinct
fn test_cfga_edge_constants() -> bool with Mut, Panic, Div, IO {
    let ok = CFG_EDGE_FALL != CFG_EDGE_BRANCH && CFG_EDGE_BRANCH != CFG_EDGE_BACK && CFG_EDGE_BACK != CFG_EDGE_SWITCH && CFG_EDGE_FALL != CFG_EDGE_SWITCH
    cfg_assert_true(ok, 39)
}

// T40: Diamond DF(BB0) is empty (entry dominates everything strictly)
fn test_cfga_diamond_df_entry_empty() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let with_df = cfg_compute_dom_frontier(analyzed)
    let b0_idx = cfg_find_block(with_df, 0)
    let ok = if b0_idx != CFG_INVALID { with_df.df_sizes[b0_idx as usize] == 0 } else { false }
    cfg_assert_true(ok, 40)
}

