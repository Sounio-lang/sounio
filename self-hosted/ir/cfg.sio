// Section 14: Test runner
// ============================================================================

fn cfg_run_tests() -> i64 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 40

    print("=== CFG Analysis Tests ===\n")

    if test_cfga_straight_line_count() { passed = passed + 1; print("  T01 OK straight_line_count\n") } else { print("  FAIL: T01 straight_line_count\n") }
    if test_cfga_diamond_block_count() { passed = passed + 1; print("  T02 OK diamond_block_count\n") } else { print("  FAIL: T02 diamond_block_count\n") }
