// self-hosted::ir::cfg — Control Flow Graph analysis
//
// Standalone CFG analysis module for the self-hosted compiler IR.
// Provides:
//   1. CFG construction from block/edge descriptors
//   2. Post-order and reverse post-order traversals (iterative DFS)
//   3. Dominator computation (Cooper-Harvey-Kennedy iterative algorithm)
//   4. Dominance frontier computation
//   5. Natural loop identification via back-edge detection
//   6. Loop nesting depth computation
//   7. Reducibility check
//   8. Critical edge detection
//   9. Reachability and dead-block analysis
//
// All arrays are fixed-size — no heap allocation.
//
// References:
//   Cooper, Harvey, Kennedy: "A Simple, Fast Dominance Algorithm" (2001)
//   Cytron et al.: "Efficiently Computing Static Single Assignment Form" (1991)
//   Muchnick: "Advanced Compiler Design and Implementation" (1997)

// ============================================================================
// Constants
// ============================================================================

let CFG_MAX_BLOCKS: i64 = 512
let CFG_MAX_SUCCS: i64 = 8
let CFG_MAX_PREDS: i64 = 8
let CFG_MAX_DF: i64 = 32
let CFG_INVALID: i64 = 0 - 1

// Edge kind constants
let CFG_EDGE_FALL: i64 = 1
let CFG_EDGE_BRANCH: i64 = 2
let CFG_EDGE_BACK: i64 = 3
let CFG_EDGE_SWITCH: i64 = 4

// ============================================================================
// Section 1: Data structures
// ============================================================================

struct CfgBlock {
    id: i64,
    instr_start: i64,
    instr_end: i64,
    succs: [i64; 8],
    succ_count: i64,
    preds: [i64; 8],
    pred_count: i64,
    is_entry: bool,
    is_exit: bool,
    loop_depth: i64,
}

struct CfgEdge {
    from_bb: i64,
    to_bb: i64,
    kind: i64,
    is_critical: bool,
}

struct CfgAnalysis {
    blocks: [CfgBlock; 512],
    block_count: i64,
    idom: [i64; 512],
    dom_frontier: [[i64; 32]; 512],
    df_sizes: [i64; 512],
    post_order: [i64; 512],
    po_count: i64,
    rpo: [i64; 512],
    rpo_count: i64,
    loop_headers: [bool; 512],
}

// ============================================================================
// Section 2: Constructors
// ============================================================================

fn cfg_block_new(id: i64, istart: i64, iend: i64) -> CfgBlock {
    CfgBlock {
        id: id,
        instr_start: istart,
        instr_end: iend,
        succs: [CFG_INVALID; 8],
        succ_count: 0,
        preds: [CFG_INVALID; 8],
        pred_count: 0,
        is_entry: false,
        is_exit: false,
        loop_depth: 0,
    }
}

fn cfg_edge_new(from: i64, to: i64, kind: i64) -> CfgEdge {
    CfgEdge {
        from_bb: from,
        to_bb: to,
        kind: kind,
        is_critical: false,
    }
}

fn cfg_analysis_new() -> CfgAnalysis {
    CfgAnalysis {
        blocks: [cfg_block_new(0, 0, 0); 512],
        block_count: 0,
        idom: [CFG_INVALID; 512],
        dom_frontier: [[CFG_INVALID; 32]; 512],
        df_sizes: [0; 512],
        post_order: [CFG_INVALID; 512],
        po_count: 0,
        rpo: [CFG_INVALID; 512],
        rpo_count: 0,
        loop_headers: [false; 512],
    }
}

// ============================================================================
// Section 3: CFG construction
// ============================================================================

// Add a block to the analysis. Returns the updated analysis.
fn cfg_add_block(cfg: CfgAnalysis, block: CfgBlock) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg
    if result.block_count < CFG_MAX_BLOCKS {
        let idx = result.block_count
        result.blocks[idx as usize] = block
        result.block_count = idx + 1
    }
    result
}

// Add a directed edge from block `from` to block `to`.
// Appends `to` to succs of block `from` (found by scanning blocks[].id).
fn cfg_add_edge(cfg: CfgAnalysis, from: i64, to: i64) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg

    // Find the block with id == from and add successor
    var i: i64 = 0
    while i < result.block_count {
        if result.blocks[i as usize].id == from {
            let sc = result.blocks[i as usize].succ_count
            if sc < CFG_MAX_SUCCS {
                result.blocks[i as usize].succs[sc as usize] = to
                result.blocks[i as usize].succ_count = sc + 1
            }
        }
        i = i + 1
    }

    result
}

// Find block index by id. Returns CFG_INVALID if not found.
fn cfg_find_block(cfg: CfgAnalysis, id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < cfg.block_count {
        if cfg.blocks[i as usize].id == id {
            return i
        }
        i = i + 1
    }
    CFG_INVALID
}

// ============================================================================
// Section 4: Predecessor computation
// ============================================================================

// Fill in predecessor lists from successor lists.
// Clears all pred arrays first, then scans every successor edge to build preds.
fn cfg_compute_preds(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg

    // Clear all predecessor lists
    var c: i64 = 0
    while c < result.block_count {
        result.blocks[c as usize].pred_count = 0
        var k: i64 = 0
        while k < CFG_MAX_PREDS {
            result.blocks[c as usize].preds[k as usize] = CFG_INVALID
            k = k + 1
        }
        c = c + 1
    }

    // For each block, for each successor, add this block as a predecessor
    var i: i64 = 0
    while i < result.block_count {
        let src_id = result.blocks[i as usize].id
        var si: i64 = 0
        while si < result.blocks[i as usize].succ_count {
            let tgt_id = result.blocks[i as usize].succs[si as usize]
            // Find the target block index
            var j: i64 = 0
            while j < result.block_count {
                if result.blocks[j as usize].id == tgt_id {
                    let pc = result.blocks[j as usize].pred_count
                    if pc < CFG_MAX_PREDS {
                        result.blocks[j as usize].preds[pc as usize] = src_id
                        result.blocks[j as usize].pred_count = pc + 1
                    }
                }
                j = j + 1
            }
            si = si + 1
        }
        i = i + 1
    }

    result
}

// ============================================================================
// Section 5: Post-order and reverse post-order traversals
// ============================================================================

// Iterative DFS post-order traversal starting from the entry block (id 0).
// Uses an explicit stack to avoid recursion.
fn cfg_post_order(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg
    result.po_count = 0

    // visited[i] marks whether block with index i has been fully processed
    var visited: [bool; 512] = [false; 512]
    // expanded[i] marks whether block index i has had its successors pushed
    var expanded: [bool; 512] = [false; 512]

    // Explicit DFS stack (stores block indices, not ids)
    var stack: [i64; 512] = [0; 512]
    var sp: i64 = 0

    // Push entry block (index 0, id 0)
    let entry_idx = cfg_find_block(result, 0)
    if entry_idx == CFG_INVALID {
        return result
    }
    stack[0] = entry_idx
    sp = 1

    while sp > 0 {
        let top = stack[(sp - 1) as usize]

        if !expanded[top as usize] {
            expanded[top as usize] = true

            // Push unvisited successors in reverse order for correct DFS order
            let blk = result.blocks[top as usize]
            var si: i64 = blk.succ_count - 1
            while si >= 0 {
                let succ_id = blk.succs[si as usize]
                let succ_idx = cfg_find_block(result, succ_id)
                if succ_idx != CFG_INVALID && !visited[succ_idx as usize] && !expanded[succ_idx as usize] {
                    if sp < CFG_MAX_BLOCKS {
                        stack[sp as usize] = succ_idx
                        sp = sp + 1
                    }
                }
                si = si - 1
            }
        } else {
            // All successors processed; emit this block in post-order
            sp = sp - 1
            if !visited[top as usize] {
                visited[top as usize] = true
                let blk_id = result.blocks[top as usize].id
                if result.po_count < CFG_MAX_BLOCKS {
                    result.post_order[result.po_count as usize] = blk_id
                    result.po_count = result.po_count + 1
                }
            }
        }
    }

    result
}

// Reverse post-order: simply reverse the post_order array.
fn cfg_reverse_post_order(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg_post_order(cfg)

    result.rpo_count = result.po_count
    var i: i64 = 0
    while i < result.po_count {
        result.rpo[i as usize] = result.post_order[(result.po_count - 1 - i) as usize]
        i = i + 1
    }

    result
}

// ============================================================================
// Section 6: Dominator computation (Cooper-Harvey-Kennedy)
// ============================================================================

// Map block id to its RPO position. Returns CFG_INVALID if not found.
fn cfg_rpo_index(cfg: CfgAnalysis, block_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < cfg.rpo_count {
        if cfg.rpo[i as usize] == block_id {
            return i
        }
        i = i + 1
    }
    CFG_INVALID
}

// Intersect function for iterative dominator algorithm.
// Both fingers are RPO indices. Walks up the idom tree until they meet.
fn cfg_dom_intersect(idom: [i64; 512], rpo: [i64; 512], rpo_count: i64, b1_in: i64, b2_in: i64) -> i64 with Mut, Panic, Div {
    var f1 = b1_in
    var f2 = b2_in
    var guard: i64 = 0
    while f1 != f2 && guard < 1024 {
        while f1 > f2 && guard < 1024 {
            // idom is indexed by block id; get the RPO index of idom[rpo[f1]]
            let blk_id = rpo[f1 as usize]
            let dom_id = idom[blk_id as usize]
            if dom_id == CFG_INVALID {
                return f2
            }
            f1 = cfg_dom_intersect_rpo_idx(rpo, rpo_count, dom_id)
            if f1 == CFG_INVALID {
                return f2
            }
            guard = guard + 1
        }
        while f2 > f1 && guard < 1024 {
            let blk_id = rpo[f2 as usize]
            let dom_id = idom[blk_id as usize]
            if dom_id == CFG_INVALID {
                return f1
            }
            f2 = cfg_dom_intersect_rpo_idx(rpo, rpo_count, dom_id)
            if f2 == CFG_INVALID {
                return f1
            }
            guard = guard + 1
        }
        guard = guard + 1
    }
    f1
}

// Helper: find the RPO index of a block id.
fn cfg_dom_intersect_rpo_idx(rpo: [i64; 512], rpo_count: i64, block_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < rpo_count {
        if rpo[i as usize] == block_id {
            return i
        }
        i = i + 1
    }
    CFG_INVALID
}

// Compute immediate dominators using Cooper-Harvey-Kennedy.
// Requires post_order and rpo to be computed first (calls cfg_reverse_post_order).
fn cfg_compute_dominators(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg_reverse_post_order(cfg)

    // Initialize idom: entry block (id 0) dominates itself
    var i: i64 = 0
    while i < CFG_MAX_BLOCKS {
        result.idom[i as usize] = CFG_INVALID
        i = i + 1
    }
    result.idom[0] = 0

    // Iterative fixed-point
    var changed: bool = true
    var iterations: i64 = 0
    while changed && iterations < 512 {
        changed = false
        iterations = iterations + 1

        // Process all blocks in RPO order, skipping entry (rpo[0] == 0)
        var ri: i64 = 1
        while ri < result.rpo_count {
            let b = result.rpo[ri as usize]
            if b == 0 {
                ri = ri + 1
            } else {
                // Find block index for b to get its predecessors
                let bidx = cfg_find_block(result, b)
                if bidx == CFG_INVALID {
                    ri = ri + 1
                } else {
                    let blk = result.blocks[bidx as usize]
                    let pcnt = blk.pred_count

                    // Find the first processed predecessor (has idom set)
                    var new_idom_rpo: i64 = CFG_INVALID
                    var first_pred_id: i64 = CFG_INVALID
                    var pi: i64 = 0
                    while pi < pcnt {
                        let pred_id = blk.preds[pi as usize]
                        if pred_id != CFG_INVALID && result.idom[pred_id as usize] != CFG_INVALID {
                            first_pred_id = pred_id
                            new_idom_rpo = cfg_dom_intersect_rpo_idx(result.rpo, result.rpo_count, pred_id)
                            pi = pcnt  // break
                        }
                        pi = pi + 1
                    }

                    // Intersect with remaining processed predecessors
                    if new_idom_rpo != CFG_INVALID {
                        var qi: i64 = 0
                        while qi < pcnt {
                            let pred_id = blk.preds[qi as usize]
                            if pred_id != CFG_INVALID && pred_id != first_pred_id && result.idom[pred_id as usize] != CFG_INVALID {
                                let pred_rpo = cfg_dom_intersect_rpo_idx(result.rpo, result.rpo_count, pred_id)
                                if pred_rpo != CFG_INVALID {
                                    new_idom_rpo = cfg_dom_intersect(result.idom, result.rpo, result.rpo_count, new_idom_rpo, pred_rpo)
                                }
                            }
                            qi = qi + 1
                        }

                        // Convert RPO index back to block id
                        let new_idom_id = result.rpo[new_idom_rpo as usize]
                        if result.idom[b as usize] != new_idom_id {
                            result.idom[b as usize] = new_idom_id
                            changed = true
                        }
                    }

                    ri = ri + 1
                }
            }
        }
    }

    result
}

// Check if block `a` dominates block `b`.
fn cfg_dominates(cfg: CfgAnalysis, a: i64, b: i64) -> bool with Mut, Panic, Div {
    if a == b {
        return true
    }
    if b < 0 || b >= CFG_MAX_BLOCKS {
        return false
    }
    var runner = b
    var steps: i64 = 0
    while runner != a && steps < CFG_MAX_BLOCKS {
        let dom = cfg.idom[runner as usize]
        if dom == CFG_INVALID || dom == runner {
            return false
        }
        runner = dom
        steps = steps + 1
    }
    runner == a
}

// Strict dominance: a strictly dominates b iff a dominates b and a != b.
fn cfg_strictly_dominates(cfg: CfgAnalysis, a: i64, b: i64) -> bool with Mut, Panic, Div {
    if a == b {
        return false
    }
    cfg_dominates(cfg, a, b)
}

// ============================================================================
// Section 7: Dominance frontier computation
// ============================================================================

// Helper: check if a value is in a fixed-size i64 array.
fn cfg_array_contains(arr: [i64; 32], count: i64, val: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        if arr[i as usize] == val {
            return true
        }
        i = i + 1
    }
    false
}

// Compute dominance frontiers for all blocks.
// DF(b) = { y : exists pred p of y such that b dominates p but b does not
//            strictly dominate y }
fn cfg_compute_dom_frontier(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg

    // Clear frontier arrays
    var c: i64 = 0
    while c < result.block_count {
        result.df_sizes[c as usize] = 0
        var k: i64 = 0
        while k < CFG_MAX_DF {
            result.dom_frontier[c as usize][k as usize] = CFG_INVALID
            k = k + 1
        }
        c = c + 1
    }

    // For each block y, for each predecessor p, walk up the dominator tree
    // from p until we reach idom(y), adding y to each block's DF along the way.
    var yi: i64 = 0
    while yi < result.block_count {
        let y_id = result.blocks[yi as usize].id
        let y_pred_count = result.blocks[yi as usize].pred_count

        if y_pred_count >= 2 {
            // Only blocks with multiple predecessors can be in dominance frontiers
            var pi: i64 = 0
            while pi < y_pred_count {
                let pred_id = result.blocks[yi as usize].preds[pi as usize]
                if pred_id != CFG_INVALID {
                    var runner = pred_id
                    var guard: i64 = 0
                    // Walk up idom tree from pred until we reach idom(y)
                    let y_idom = result.idom[y_id as usize]
                    while runner != y_idom && runner != CFG_INVALID && guard < CFG_MAX_BLOCKS {
                        // Add y to DF(runner)
                        let ridx = cfg_find_block(result, runner)
                        if ridx != CFG_INVALID {
                            let dfs = result.df_sizes[ridx as usize]
                            if !cfg_array_contains(result.dom_frontier[ridx as usize], dfs, y_id) && dfs < CFG_MAX_DF {
                                result.dom_frontier[ridx as usize][dfs as usize] = y_id
                                result.df_sizes[ridx as usize] = dfs + 1
                            }
                        }
                        runner = result.idom[runner as usize]
                        guard = guard + 1
                    }
                }
                pi = pi + 1
            }
        }
        yi = yi + 1
    }

    result
}

// ============================================================================
// Section 8: Loop analysis
// ============================================================================

// Identify natural loops via back edges.
// A back edge (b -> h) exists when h dominates b. The target h is a loop header.
fn cfg_identify_loops(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg

    // Clear loop headers
    var c: i64 = 0
    while c < CFG_MAX_BLOCKS {
        result.loop_headers[c as usize] = false
        c = c + 1
    }

    // Scan all edges: for each block, for each successor, check for back edges
    var i: i64 = 0
    while i < result.block_count {
        let blk = result.blocks[i as usize]
        let src_id = blk.id
        var si: i64 = 0
        while si < blk.succ_count {
            let tgt_id = blk.succs[si as usize]
            // Back edge if target dominates source
            if tgt_id != CFG_INVALID && cfg_dominates(result, tgt_id, src_id) {
                if tgt_id >= 0 && tgt_id < CFG_MAX_BLOCKS {
                    result.loop_headers[tgt_id as usize] = true
                }
            }
            si = si + 1
        }
        i = i + 1
    }

    result
}

// Compute loop nesting depth for each block.
// For each loop header h, find the natural loop body (blocks from which h is
// reachable via predecessors without leaving the loop), then increment
// loop_depth for each body block.
fn cfg_loop_depth(cfg: CfgAnalysis) -> CfgAnalysis with Mut, Panic, Div {
    var result = cfg_identify_loops(cfg)

    // Reset loop depths
    var c: i64 = 0
    while c < result.block_count {
        result.blocks[c as usize].loop_depth = 0
        c = c + 1
    }

    // For each loop header, discover its natural loop body
    var hi: i64 = 0
    while hi < result.block_count {
        let h_id = result.blocks[hi as usize].id
        if h_id >= 0 && h_id < CFG_MAX_BLOCKS && result.loop_headers[h_id as usize] {
            // Find all back-edge sources for this header
            var in_loop: [bool; 512] = [false; 512]
            in_loop[h_id as usize] = true

            // Worklist: start from back-edge sources
            var wl: [i64; 512] = [0; 512]
            var wl_count: i64 = 0

            // Find all blocks that have a back edge to h_id
            var bi: i64 = 0
            while bi < result.block_count {
                let blk = result.blocks[bi as usize]
                var si: i64 = 0
                while si < blk.succ_count {
                    if blk.succs[si as usize] == h_id && cfg_dominates(result, h_id, blk.id) && blk.id != h_id {
                        if !in_loop[blk.id as usize] {
                            in_loop[blk.id as usize] = true
                            wl[wl_count as usize] = blk.id
                            wl_count = wl_count + 1
                        }
                    }
                    si = si + 1
                }
                bi = bi + 1
            }

            // Propagate backwards through predecessors
            var head: i64 = 0
            while head < wl_count {
                let n = wl[head as usize]
                head = head + 1

                // Find block index for n
                let nidx = cfg_find_block(result, n)
                if nidx != CFG_INVALID {
                    let nblk = result.blocks[nidx as usize]
                    var pi: i64 = 0
                    while pi < nblk.pred_count {
                        let pred_id = nblk.preds[pi as usize]
                        if pred_id != CFG_INVALID && pred_id >= 0 && pred_id < CFG_MAX_BLOCKS {
                            if !in_loop[pred_id as usize] {
                                in_loop[pred_id as usize] = true
                                if wl_count < CFG_MAX_BLOCKS {
                                    wl[wl_count as usize] = pred_id
                                    wl_count = wl_count + 1
                                }
                            }
                        }
                        pi = pi + 1
                    }
                }
            }

            // Increment loop_depth for all blocks in this loop body
            var li: i64 = 0
            while li < result.block_count {
                let lid = result.blocks[li as usize].id
                if lid >= 0 && lid < CFG_MAX_BLOCKS && in_loop[lid as usize] {
                    result.blocks[li as usize].loop_depth = result.blocks[li as usize].loop_depth + 1
                }
                li = li + 1
            }
        }
        hi = hi + 1
    }

    result
}

// ============================================================================
// Section 9: Reducibility check
// ============================================================================

// A CFG is reducible iff every back edge (b -> h where h dominates b) defines
// a natural loop, and there are no irreducible regions. We check by verifying
// that every retreating edge in a DFS is a back edge (dominator-based).
fn cfg_is_reducible(cfg: CfgAnalysis) -> bool with Mut, Panic, Div {
    // Perform DFS and check retreating edges
    var visited: [bool; 512] = [false; 512]
    var in_stack: [bool; 512] = [false; 512]

    // DFS stack: (block_idx, succ_cursor)
    var stk_block: [i64; 512] = [0; 512]
    var stk_cursor: [i64; 512] = [0; 512]
    var sp: i64 = 0

    let entry_idx = cfg_find_block(cfg, 0)
    if entry_idx == CFG_INVALID {
        return true
    }

    stk_block[0] = entry_idx
    stk_cursor[0] = 0
    sp = 1
    visited[entry_idx as usize] = true
    in_stack[entry_idx as usize] = true

    while sp > 0 {
        let top_idx = stk_block[(sp - 1) as usize]
        let cursor = stk_cursor[(sp - 1) as usize]
        let blk = cfg.blocks[top_idx as usize]

        if cursor >= blk.succ_count {
            // Done with this block
            in_stack[top_idx as usize] = false
            sp = sp - 1
        } else {
            // Advance cursor
            stk_cursor[(sp - 1) as usize] = cursor + 1
            let succ_id = blk.succs[cursor as usize]
            if succ_id == CFG_INVALID {
                // skip
            } else {
                let succ_idx = cfg_find_block(cfg, succ_id)
                if succ_idx == CFG_INVALID {
                    // skip
                } else if !visited[succ_idx as usize] {
                    // Tree edge
                    visited[succ_idx as usize] = true
                    in_stack[succ_idx as usize] = true
                    if sp < CFG_MAX_BLOCKS {
                        stk_block[sp as usize] = succ_idx
                        stk_cursor[sp as usize] = 0
                        sp = sp + 1
                    }
                } else if in_stack[succ_idx as usize] {
                    // Retreating edge — must be a back edge (target dominates source)
                    let src_id = blk.id
                    if !cfg_dominates(cfg, succ_id, src_id) {
                        return false
                    }
                }
                // Cross/forward edges are fine
            }
        }
    }

    true
}

// ============================================================================
// Section 10: Critical edge detection
// ============================================================================

// An edge (u -> v) is critical if u has multiple successors AND v has multiple
// predecessors. Returns a flat array of CfgEdge plus count.
fn cfg_split_critical_edges(cfg: CfgAnalysis) -> ([CfgEdge; 512], i64) with Mut, Panic, Div {
    var edges: [CfgEdge; 512] = [cfg_edge_new(0, 0, 0); 512]
    var count: i64 = 0

    var i: i64 = 0
    while i < cfg.block_count {
        let blk = cfg.blocks[i as usize]
        if blk.succ_count > 1 {
            // Check each successor
            var si: i64 = 0
            while si < blk.succ_count {
                let succ_id = blk.succs[si as usize]
                if succ_id != CFG_INVALID {
                    // Find successor block
                    let succ_idx = cfg_find_block(cfg, succ_id)
                    if succ_idx != CFG_INVALID {
                        if cfg.blocks[succ_idx as usize].pred_count > 1 {
                            // Critical edge found
                            if count < 512 {
                                var e = cfg_edge_new(blk.id, succ_id, CFG_EDGE_BRANCH)
                                e.is_critical = true
                                edges[count as usize] = e
                                count = count + 1
                            }
                        }
                    }
                }
                si = si + 1
            }
        }
        i = i + 1
    }

    (edges, count)
}

// ============================================================================
// Section 11: Reachability
// ============================================================================

// Compute the set of block ids reachable from a given block via BFS.
// Returns (reachable_set, count).
fn cfg_reachable_from(cfg: CfgAnalysis, start_id: i64) -> ([i64; 512], i64) with Mut, Panic, Div {
    var reached: [i64; 512] = [CFG_INVALID; 512]
    var count: i64 = 0
    var visited: [bool; 512] = [false; 512]

    // BFS queue
    var queue: [i64; 512] = [0; 512]
    var head: i64 = 0
    var tail: i64 = 0

    if start_id >= 0 && start_id < CFG_MAX_BLOCKS {
        queue[tail as usize] = start_id
        tail = tail + 1
        visited[start_id as usize] = true
    }

    while head < tail {
        let cur = queue[head as usize]
        head = head + 1

        if count < CFG_MAX_BLOCKS {
            reached[count as usize] = cur
            count = count + 1
        }

        let idx = cfg_find_block(cfg, cur)
        if idx != CFG_INVALID {
            let blk = cfg.blocks[idx as usize]
            var si: i64 = 0
            while si < blk.succ_count {
                let s = blk.succs[si as usize]
                if s != CFG_INVALID && s >= 0 && s < CFG_MAX_BLOCKS && !visited[s as usize] {
                    visited[s as usize] = true
                    if tail < CFG_MAX_BLOCKS {
                        queue[tail as usize] = s
                        tail = tail + 1
                    }
                }
                si = si + 1
            }
        }
    }

    (reached, count)
}

// Find unreachable (dead) blocks — blocks not reachable from the entry.
// Returns (dead_block_ids, count).
fn cfg_dead_blocks(cfg: CfgAnalysis) -> ([i64; 512], i64) with Mut, Panic, Div {
    let reach_result = cfg_reachable_from(cfg, 0)
    let reached = reach_result.0
    let reach_count = reach_result.1

    // Build a fast lookup for reached block ids
    var is_reached: [bool; 512] = [false; 512]
    var ri: i64 = 0
    while ri < reach_count {
        let rid = reached[ri as usize]
        if rid >= 0 && rid < CFG_MAX_BLOCKS {
            is_reached[rid as usize] = true
        }
        ri = ri + 1
    }

    var dead: [i64; 512] = [CFG_INVALID; 512]
    var dead_count: i64 = 0

    var i: i64 = 0
    while i < cfg.block_count {
        let bid = cfg.blocks[i as usize].id
        if bid >= 0 && bid < CFG_MAX_BLOCKS && !is_reached[bid as usize] {
            if dead_count < CFG_MAX_BLOCKS {
                dead[dead_count as usize] = bid
                dead_count = dead_count + 1
            }
        }
        i = i + 1
    }

    (dead, dead_count)
}

// ============================================================================
// Section 12: Test helpers
// ============================================================================

fn cfg_assert_true(cond: bool, msg: i64) -> bool with IO {
    if !cond {
        print("  FAIL: cfg test ")
        print_int(msg)
        print("\n")
    }
    cond
}

// Build a straight-line CFG: BB0 (entry+exit)
fn cfg_test_straight_line() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 5)
    b0.is_entry = true
    b0.is_exit = true
    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a diamond CFG:
//       BB0
//      /   \
//    BB1   BB2
//      \   /
//       BB3
fn cfg_test_diamond() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    var b3 = cfg_block_new(3, 9, 12)
    b3.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 0, 2)
    cfg = cfg_add_edge(cfg, 1, 3)
    cfg = cfg_add_edge(cfg, 2, 3)

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a simple loop CFG:
//   BB0 -> BB1 -> BB2
//           ^      |
//           +------+  (back edge BB2 -> BB1)
fn cfg_test_simple_loop() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    var b3 = cfg_block_new(3, 9, 12)
    b3.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 1, 2)
    cfg = cfg_add_edge(cfg, 2, 1)  // back edge
    cfg = cfg_add_edge(cfg, 2, 3)  // exit edge

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a nested loop CFG:
//   BB0 -> BB1 -> BB2 -> BB3 -> BB4
//           ^      ^      |      |
//           |      +------+      |
//           +--------------------+   (back edge BB4 -> BB1)
fn cfg_test_nested_loop() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    var b3 = cfg_block_new(3, 9, 12)
    var b4 = cfg_block_new(4, 12, 15)
    var b5 = cfg_block_new(5, 15, 18)
    b5.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)
    cfg = cfg_add_block(cfg, b4)
    cfg = cfg_add_block(cfg, b5)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 1, 2)
    cfg = cfg_add_edge(cfg, 2, 3)
    cfg = cfg_add_edge(cfg, 3, 2)   // inner back edge
    cfg = cfg_add_edge(cfg, 3, 4)
    cfg = cfg_add_edge(cfg, 4, 1)   // outer back edge
    cfg = cfg_add_edge(cfg, 4, 5)

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a CFG with unreachable block:
//   BB0 -> BB1 -> BB2 (exit)
//   BB3 (unreachable)
fn cfg_test_dead_block() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    b2.is_exit = true
    var b3 = cfg_block_new(3, 9, 12)  // unreachable

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 1, 2)
    // BB3 has no incoming edges

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a CFG with a critical edge:
//       BB0
//      /   \
//    BB1   BB2
//      |   /
//      BB3
// Edge BB0->BB2 and BB2->BB3: BB0 has 2 succs, BB3 has 2 preds => critical edge BB0->BB3 doesn't exist
// Actually: BB0 has succs {BB1, BB2}, BB3 has preds {BB1, BB2}
// So edge BB0->BB1 is not critical (BB1 has 1 pred). Edge BB0->BB2: BB2 has 1 pred.
// Let's make a proper critical edge case:
//       BB0
//      /   \
//    BB1   BB2
//    |  \ / |
//    |   BB3 |
//    |       |
//    BB4 <---+
fn cfg_test_critical_edge() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    var b3 = cfg_block_new(3, 9, 12)
    b3.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)

    // BB0 -> BB1, BB0 -> BB2 (BB0 has 2 succs)
    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 0, 2)
    // BB1 -> BB3, BB2 -> BB3 (BB3 has 2 preds)
    cfg = cfg_add_edge(cfg, 1, 3)
    cfg = cfg_add_edge(cfg, 2, 3)

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build a chain CFG: BB0 -> BB1 -> BB2 -> BB3 (no branches)
fn cfg_test_chain() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    var b3 = cfg_block_new(3, 9, 12)
    b3.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)
    cfg = cfg_add_block(cfg, b3)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 1, 2)
    cfg = cfg_add_edge(cfg, 2, 3)

    cfg = cfg_compute_preds(cfg)
    cfg
}

// Build an if-then CFG (no else):
//   BB0 -> BB1 -> BB2
//     \-----------^
fn cfg_test_if_then() -> CfgAnalysis with Mut, Panic, Div {
    var cfg = cfg_analysis_new()
    var b0 = cfg_block_new(0, 0, 3)
    b0.is_entry = true
    var b1 = cfg_block_new(1, 3, 6)
    var b2 = cfg_block_new(2, 6, 9)
    b2.is_exit = true

    cfg = cfg_add_block(cfg, b0)
    cfg = cfg_add_block(cfg, b1)
    cfg = cfg_add_block(cfg, b2)

    cfg = cfg_add_edge(cfg, 0, 1)
    cfg = cfg_add_edge(cfg, 0, 2)
    cfg = cfg_add_edge(cfg, 1, 2)

    cfg = cfg_compute_preds(cfg)
    cfg
}

