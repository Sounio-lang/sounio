    if test_cfga_diamond_idom_merge() { passed = passed + 1; print("  T09 OK diamond_idom_merge\n") } else { print("  FAIL: T09 diamond_idom_merge\n") }
    if test_cfga_diamond_self_dom() { passed = passed + 1; print("  T10 OK diamond_self_dom\n") } else { print("  FAIL: T10 diamond_self_dom\n") }
    if test_cfga_diamond_df_bb1() { passed = passed + 1; print("  T11 OK diamond_df_bb1\n") } else { print("  FAIL: T11 diamond_df_bb1\n") }
    if test_cfga_diamond_df_bb2() { passed = passed + 1; print("  T12 OK diamond_df_bb2\n") } else { print("  FAIL: T12 diamond_df_bb2\n") }
    if test_cfga_loop_header() { passed = passed + 1; print("  T13 OK loop_header\n") } else { print("  FAIL: T13 loop_header\n") }
