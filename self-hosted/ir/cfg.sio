// T01: Straight-line CFG has exactly 1 block
fn test_cfga_straight_line_count() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_straight_line()
    cfg_assert_true(cfg.block_count == 1, 1)
}

// T02: Diamond CFG has 4 blocks
fn test_cfga_diamond_block_count() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    cfg_assert_true(cfg.block_count == 4, 2)
}

// T03: Diamond entry block has 2 successors
fn test_cfga_diamond_entry_succs() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    cfg_assert_true(cfg.blocks[0].succ_count == 2, 3)
}

// T04: Diamond merge block (BB3) has 2 predecessors
fn test_cfga_diamond_merge_preds() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let b3_idx = cfg_find_block(cfg, 3)
    let ok = if b3_idx != CFG_INVALID { cfg.blocks[b3_idx as usize].pred_count == 2 } else { false }
    cfg_assert_true(ok, 4)
}

// T05: Post-order traversal visits all blocks in diamond
fn test_cfga_diamond_post_order() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_post_order(cfg)
    cfg_assert_true(analyzed.po_count == 4, 5)
}

// T06: RPO of diamond starts with entry block (0)
fn test_cfga_diamond_rpo_entry() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_reverse_post_order(cfg)
    cfg_assert_true(analyzed.rpo[0] == 0, 6)
}

// T07: Diamond dominators — entry dominates all
fn test_cfga_diamond_dom_entry() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let d1 = cfg_dominates(analyzed, 0, 1)
    let d2 = cfg_dominates(analyzed, 0, 2)
    let d3 = cfg_dominates(analyzed, 0, 3)
    cfg_assert_true(d1 && d2 && d3, 7)
}

// T08: Diamond — block 1 does not dominate block 2
fn test_cfga_diamond_no_cross_dom() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let no12 = !cfg_dominates(analyzed, 1, 2)
    let no21 = !cfg_dominates(analyzed, 2, 1)
    cfg_assert_true(no12 && no21, 8)
}

// T09: Diamond — idom of merge block is entry
fn test_cfga_diamond_idom_merge() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    cfg_assert_true(analyzed.idom[3] == 0, 9)
}

// T10: Diamond — every block dominates itself
fn test_cfga_diamond_self_dom() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let s0 = cfg_dominates(analyzed, 0, 0)
    let s1 = cfg_dominates(analyzed, 1, 1)
    let s2 = cfg_dominates(analyzed, 2, 2)
    let s3 = cfg_dominates(analyzed, 3, 3)
    cfg_assert_true(s0 && s1 && s2 && s3, 10)
}

// T11: Diamond dominance frontier — DF(BB1) contains BB3
fn test_cfga_diamond_df_bb1() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let with_df = cfg_compute_dom_frontier(analyzed)
    let b1_idx = cfg_find_block(with_df, 1)
    let ok = if b1_idx != CFG_INVALID {
        let dfs = with_df.df_sizes[b1_idx as usize]
        cfg_array_contains(with_df.dom_frontier[b1_idx as usize], dfs, 3)
    } else {
        false
    }
    cfg_assert_true(ok, 11)
}

// T12: Diamond dominance frontier — DF(BB2) contains BB3
fn test_cfga_diamond_df_bb2() -> bool with Mut, Panic, Div, IO {
    let cfg = cfg_test_diamond()
    let analyzed = cfg_compute_dominators(cfg)
    let with_df = cfg_compute_dom_frontier(analyzed)
    let b2_idx = cfg_find_block(with_df, 2)
    let ok = if b2_idx != CFG_INVALID {
        let dfs = with_df.df_sizes[b2_idx as usize]
        cfg_array_contains(with_df.dom_frontier[b2_idx as usize], dfs, 3)
    } else {
        false
    }
    cfg_assert_true(ok, 12)
}

