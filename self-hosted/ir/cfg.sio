    if test_cfga_strict_dom_self() { passed = passed + 1; print("  T37 OK strict_dom_self\n") } else { print("  FAIL: T37 strict_dom_self\n") }
    if test_cfga_array_contains() { passed = passed + 1; print("  T38 OK array_contains\n") } else { print("  FAIL: T38 array_contains\n") }
    if test_cfga_edge_constants() { passed = passed + 1; print("  T39 OK edge_constants\n") } else { print("  FAIL: T39 edge_constants\n") }
    if test_cfga_diamond_df_entry_empty() { passed = passed + 1; print("  T40 OK diamond_df_entry_empty\n") } else { print("  FAIL: T40 diamond_df_entry_empty\n") }

    print("\nCFG: ")
    print_int(passed)
    print(" / ")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
