    if test_cfga_loop_depth_entry() { passed = passed + 1; print("  T16 OK loop_depth_entry\n") } else { print("  FAIL: T16 loop_depth_entry\n") }
    if test_cfga_nested_inner_depth() { passed = passed + 1; print("  T17 OK nested_inner_depth\n") } else { print("  FAIL: T17 nested_inner_depth\n") }
    if test_cfga_nested_outer_depth() { passed = passed + 1; print("  T18 OK nested_outer_depth\n") } else { print("  FAIL: T18 nested_outer_depth\n") }
    if test_cfga_diamond_reducible() { passed = passed + 1; print("  T19 OK diamond_reducible\n") } else { print("  FAIL: T19 diamond_reducible\n") }
    if test_cfga_loop_reducible() { passed = passed + 1; print("  T20 OK loop_reducible\n") } else { print("  FAIL: T20 loop_reducible\n") }
    if test_cfga_diamond_critical() { passed = passed + 1; print("  T21 OK diamond_critical\n") } else { print("  FAIL: T21 diamond_critical\n") }
    if test_cfga_chain_no_critical() { passed = passed + 1; print("  T22 OK chain_no_critical\n") } else { print("  FAIL: T22 chain_no_critical\n") }
    if test_cfga_diamond_reachable() { passed = passed + 1; print("  T23 OK diamond_reachable\n") } else { print("  FAIL: T23 diamond_reachable\n") }
    if test_cfga_dead_block_found() { passed = passed + 1; print("  T24 OK dead_block_found\n") } else { print("  FAIL: T24 dead_block_found\n") }
    if test_cfga_diamond_no_dead() { passed = passed + 1; print("  T25 OK diamond_no_dead\n") } else { print("  FAIL: T25 diamond_no_dead\n") }
    if test_cfga_block_new_defaults() { passed = passed + 1; print("  T26 OK block_new_defaults\n") } else { print("  FAIL: T26 block_new_defaults\n") }
