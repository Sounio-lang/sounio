    if test_cfga_empty_analysis() { passed = passed + 1; print("  T33 OK empty_analysis\n") } else { print("  FAIL: T33 empty_analysis\n") }
    if test_cfga_if_then_merge_preds() { passed = passed + 1; print("  T34 OK if_then_merge_preds\n") } else { print("  FAIL: T34 if_then_merge_preds\n") }
