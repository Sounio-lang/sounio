// Compact executable witness for the compiler-internal rebracketing gate.

use ir::opt_cleanup::*

fn main() -> i64 with IO, Mut, Div, Panic {
    let receipt = ocp_exact_bitwise_rebracket_authority_probe()
    assert(receipt.case_count == 15)
    assert(receipt.application_mask == 7)
    assert(receipt.refusal_mask == 2047)
    assert(receipt.unchanged_refusal_mask == 2047)
    assert(receipt.boundary_claim_mask == 17)

    print("[rebracket-compiler] PASS: cases=")
    print_int(receipt.case_count)
    print(" applications=")
    print_int(4)
    print(" unchanged_refusals=")
    print_int(11)
    print(" replay=0 calls=0 packed=0 cross_region=0 control_elsewhere=1 float_ir=0 runtime_d7=0 float_gum=0 global=0\n")
    0
}
