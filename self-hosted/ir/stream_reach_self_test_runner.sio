// self-hosted::ir::stream_reach_self_test_runner
//
// Executes the self-tests for ir::stream_reach and reports results.
//
// Tests:
//   T1: scg_add_edge records caller/callee correctly
//   T2: scg_mark_reachable finds direct callees
//   T3: scg_mark_reachable finds transitive callees
//   T4: scg_count_reachable counts correctly
//   T5: scg_mark_reachable with no start returns empty set
//
// Run with:
//   souc run self-hosted/ir/stream_reach_self_test_runner.sio
//
// Sprint 132: runnable self-test harness for streaming reachability.

use ir::stream_reach::*
use ir::ir::*
use parser::ast::*

fn main() -> i64 with IO, Mut, Panic, Div {
    print("stream_reach_self_test: running\n")
    let failures = scg_run_self_tests()
    if failures == 0 {
        print("stream_reach_self_test: ALL PASS\n")
        0
    } else {
        print("stream_reach_self_test: FAIL failures=")
        print_int(failures)
        print("\n")
        1
    }
}
