// T42: Callee id lookup
fn test_tco_get_callee_id() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let name_b = tco_make_func_name(102 as i8, 1)
    funcs[0] = tco_make_tail_call_to(0, name_b, 1, 1)
    funcs[1] = tco_make_test_func(1, 3)
    let module = tco_make_test_module(funcs, 2)

    // Find the call instruction in func 0
    var call_idx: i64 = TCO_INVALID
    var si: i64 = 0
    while si < funcs[0].instr_count {
        let f0_region = funcs[0].region
        if tco_is_call(ir_arena_load(ir_region_slot_r(f0_region, (si)))) {
            call_idx = si
        }
        si = si + 1
    }

    let callee = tco_get_callee_id(module, 0, call_idx)
    if callee != 1 {
        print("FAIL: test_tco_get_callee_id\n")
        return 1
    }
    print("PASS: test_tco_get_callee_id\n")
    return 0
}

