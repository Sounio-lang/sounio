module ir::tailcall

use ir::ir::*
use parser::ast::*

// self-hosted::ir::tailcall — Tail call optimization pass
//
// Implements tail call optimization for the self-hosted compiler IR:
//   1. Tail position detection — identify calls immediately before return
//   2. Self-recursive TCO — transform self-tail-calls into loops
//   3. Argument shuffling — correctly update params with temp registers
//   4. Mutual recursion detection — find pairs/groups that tail-call each other
//   5. Trampoline generation — dispatch wrapper for mutual tail recursion
//   6. Eligibility analysis — reject functions with cleanup/alloca/varargs
//   7. Verification — ensure transformations preserve semantics
//
// Design decisions:
//   - Self-recursive tail calls become loops (goto + param reassignment)
//   - Mutually recursive tail calls use a trampoline dispatcher
//   - Functions with stack allocations or cleanup cannot be TCO'd
//   - Argument shuffling uses temp registers to handle overlapping assignments
//   - All arrays are fixed-size — no heap allocation
//
// References:
//   Steele: "Lambda: The Ultimate GOTO" (1977)
//   Appel: "Compiling with Continuations" (1992)
//   Kelsey, Clinger, Rees: "Revised^5 Report on Scheme" (1998)

// ============================================================================
// Section 1: Constants
// ============================================================================

let TCO_MAX_FUNCS: i64 = 512
let TCO_MAX_CALLS: i64 = 2048
let TCO_MAX_TRANSFORMS: i64 = 512
let TCO_MAX_PARAMS: i64 = 16

// Transform kinds
let TCO_KIND_SELF_TO_LOOP: i64 = 1
let TCO_KIND_MUTUAL_TO_TRAMPOLINE: i64 = 2

// Rejection reason codes
let TCO_REJECT_CLEANUP: i64 = 1
let TCO_REJECT_ALLOCA: i64 = 2
let TCO_REJECT_VARARGS: i64 = 3
let TCO_REJECT_TYPE_MISMATCH: i64 = 4

// Sentinel value
let TCO_INVALID: i64 = 0 - 1

// Maximum blocks we scan per function for tail position analysis
let TCO_MAX_BLOCKS: i64 = 256

// Maximum mutual recursion group size
let TCO_MAX_MUTUAL_GROUP: i64 = 8

// ============================================================================
// Section 2: Structs
// ============================================================================

// Info about a call that is in tail position
struct TcoCallInfo {
    func_id: i64,
    call_instr_idx: i64,
    is_self_recursive: bool,
    is_mutual_recursive: bool,
    arg_count: i64,
    arg_regs: [i64; 16],
    return_reg: i64,
    block_id: i64,
}

// Per-function analysis results
pub struct TcoFuncInfo {
    func_id: i64,
    param_count: i64,
    has_tail_calls: bool,
    tail_call_count: i64,
    is_eligible: bool,
    instr_count: i64,
    has_cleanup: bool,
    has_alloca: bool,
}

// Record of a transformation applied
struct TcoTransform {
    func_id: i64,
    kind: i64,
    loop_label: i64,
    trampoline_id: i64,
    param_copy_regs: [i64; 16],
}

// Statistics about the TCO pass
pub struct TcoStats {
    analyzed: i64,
    eligible: i64,
    self_recursive: i64,
    mutual_recursive: i64,
    transformed: i64,
    rejected: i64,
}

// Overall TCO context
pub struct TcoContext {
    func_infos: [TcoFuncInfo; 512],
    func_info_count: i64,
    call_infos: [TcoCallInfo; 2048],
    call_info_count: i64,
    transforms: [TcoTransform; 512],
    transform_count: i64,
    stats: TcoStats,
}

// Mutual recursion group — a set of function ids that tail-call each other
struct TcoMutualGroup {
    func_ids: [i64; 8],
    count: i64,
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn tco_default_call_info() -> TcoCallInfo {
    TcoCallInfo {
        func_id: TCO_INVALID,
        call_instr_idx: TCO_INVALID,
        is_self_recursive: false,
        is_mutual_recursive: false,
        arg_count: 0,
        arg_regs: [TCO_INVALID; 16],
        return_reg: TCO_INVALID,
        block_id: TCO_INVALID,
    }
}

fn tco_call_info_new(fid: i64, idx: i64, ret_reg: i64, blk: i64) -> TcoCallInfo {
    TcoCallInfo {
        func_id: fid,
        call_instr_idx: idx,
        is_self_recursive: false,
        is_mutual_recursive: false,
        arg_count: 0,
        arg_regs: [TCO_INVALID; 16],
        return_reg: ret_reg,
        block_id: blk,
    }
}

fn tco_default_func_info() -> TcoFuncInfo {
    TcoFuncInfo {
        func_id: TCO_INVALID,
        param_count: 0,
        has_tail_calls: false,
        tail_call_count: 0,
        is_eligible: true,
        instr_count: 0,
        has_cleanup: false,
        has_alloca: false,
    }
}

fn tco_func_info_new(fid: i64) -> TcoFuncInfo {
    TcoFuncInfo {
        func_id: fid,
        param_count: 0,
        has_tail_calls: false,
        tail_call_count: 0,
        is_eligible: true,
        instr_count: 0,
        has_cleanup: false,
        has_alloca: false,
    }
}

fn tco_default_transform() -> TcoTransform {
    TcoTransform {
        func_id: TCO_INVALID,
        kind: 0,
        loop_label: TCO_INVALID,
        trampoline_id: TCO_INVALID,
        param_copy_regs: [TCO_INVALID; 16],
    }
}

fn tco_transform_new(fid: i64, kind: i64, label: i64) -> TcoTransform {
    TcoTransform {
        func_id: fid,
        kind: kind,
        loop_label: label,
        trampoline_id: TCO_INVALID,
        param_copy_regs: [TCO_INVALID; 16],
    }
}

fn tco_stats_new() -> TcoStats {
    TcoStats {
        analyzed: 0,
        eligible: 0,
        self_recursive: 0,
        mutual_recursive: 0,
        transformed: 0,
        rejected: 0,
    }
}

pub(crate) fn tco_context_new() -> TcoContext {
    TcoContext {
        func_infos: [tco_default_func_info(); 512],
        func_info_count: 0,
        call_infos: [tco_default_call_info(); 2048],
        call_info_count: 0,
        transforms: [tco_default_transform(); 512],
        transform_count: 0,
        stats: tco_stats_new(),
    }
}

fn tco_mutual_group_new() -> TcoMutualGroup {
    TcoMutualGroup {
        func_ids: [TCO_INVALID; 8],
        count: 0,
    }
}

// ============================================================================
// Section 4: Instruction classification helpers
// ============================================================================

// Check if an instruction is a call
pub(crate) fn tco_is_call(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrCall {
        return true
    }
    return false
}

// Check if an instruction is a return
fn tco_is_return(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrReturn {
        return true
    }
    return false
}

// Check if an instruction is a nop
fn tco_is_nop(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrNop {
        return true
    }
    return false
}

// Check if an instruction is a label
fn tco_is_label(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrLabel {
        return true
    }
    return false
}

// Check if an instruction is a jump
fn tco_is_jump(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrJump {
        return true
    }
    return false
}

// Check if an instruction is a branch (conditional)
fn tco_is_branch(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrBranchTrue {
        return true
    }
    if instr.op == IrOpcode::IrBranchFalse {
        return true
    }
    return false
}

// Check if an instruction is an alloc (stack allocation)
fn tco_is_alloc(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrAlloc {
        return true
    }
    return false
}

// Check if an instruction is a load immediate
fn tco_is_load_imm(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrLoadImm {
        return true
    }
    return false
}

// Check if an instruction is a copy
fn tco_is_copy(instr: IrInstr) -> bool {
    if instr.op == IrOpcode::IrCopy {
        return true
    }
    return false
}

// ============================================================================
// Section 5: Tail position detection
// ============================================================================

// Check whether a call at instruction index `call_idx` is in tail position.
// A call is in tail position if:
//   1. The very next non-nop instruction is a return
//   2. The return uses the call's destination register (or returns void)
//
// Returns true if the call is in tail position.
pub(crate) fn tco_is_tail_position(func: IrFunction, call_idx: i64) -> bool with Mut, Div, Panic {
    if call_idx < 0 || call_idx >= func.instr_count {
        return false
    }
    let call_instr = ir_arena_load(ir_region_slot_r(func.region, (call_idx)))
    if !tco_is_call(call_instr) {
        return false
    }

    let call_dst = call_instr.dst

    // Scan forward from call_idx+1, skipping nops, looking for return
    var j: i64 = call_idx + 1
    while j < func.instr_count {
        let next = ir_arena_load(ir_region_slot_r(func.region, (j)))
        if tco_is_nop(next) {
            j = j + 1
        } else if tco_is_return(next) {
            // Return must use the call's result register
            if next.src1 == call_dst {
                return true
            }
            // If call_dst is IR_INVALID_REG and return src1 is also invalid => void tail call
            if call_dst == IR_INVALID_REG && next.src1 == IR_INVALID_REG {
                return true
            }
            return false
        } else {
            // Some other instruction between call and return => not tail position
            return false
        }
    }
    // Reached end of function without finding return => not tail position
    return false
}

// Check if a call at `call_idx` is a self-recursive call (calls same function)
pub(crate) fn tco_is_self_call(func: IrFunction, call_idx: i64) -> bool with Mut, Div, Panic {
    if call_idx < 0 || call_idx >= func.instr_count {
        return false
    }
    let call_instr = ir_arena_load(ir_region_slot_r(func.region, (call_idx)))
    if !tco_is_call(call_instr) {
        return false
    }
    // Compare the call's target name with the function's own name
    return ir_name_eq(ir_name_at(call_instr.name_id), func.name)
}

// Extract argument registers from a call instruction into a fixed array.
// Populates the first `count` entries of the output array from the call_args list.
// Returns the number of args extracted.
fn tco_extract_call_args(instr: IrInstr, out: [i64; 16]) -> (i64, [i64; 16]) with Mut, Div, Panic {
    var result = out
    // src1 and src2 hold the first two args inline
    var count: i64 = 0
    if instr.arg_count > 0 && instr.src1 != IR_INVALID_REG {
        if count < TCO_MAX_PARAMS {
            result[count as usize] = instr.src1
            count = count + 1
        }
    }
    if instr.arg_count > 1 && instr.src2 != IR_INVALID_REG {
        if count < TCO_MAX_PARAMS {
            result[count as usize] = instr.src2
            count = count + 1
        }
    }
    // For simplicity, we handle up to 2 inline args; the rest would be in call_args list
    // In practice the self-hosted IR stores first two in src1/src2
    return (count, result)
}

// ============================================================================
// Section 6: Function eligibility analysis
// ============================================================================

// Analyze a single function for TCO eligibility and tail call sites.
// Returns the updated TcoFuncInfo.
pub(crate) fn tco_analyze_function(func: IrFunction, fid: i64) -> TcoFuncInfo with Mut, Div, Panic {
    var info = tco_func_info_new(fid)
    info.instr_count = func.instr_count
    info.param_count = func.param_count

    // Scan for alloca and cleanup patterns
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if tco_is_alloc(instr) {
            info.has_alloca = true
            info.is_eligible = false
        }
        i = i + 1
    }

    // If the function has cleanup (indicated by alloca), mark ineligible
    if info.has_alloca {
        info.has_cleanup = true
    }

    // Count tail calls
    var tc_count: i64 = 0
    var j: i64 = 0
    while j < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (j)))
        if tco_is_call(instr) {
            if tco_is_tail_position(func, j) {
                tc_count = tc_count + 1
            }
        }
        j = j + 1
    }
    info.tail_call_count = tc_count
    if tc_count > 0 {
        info.has_tail_calls = true
    }

    return info
}

// Check if a function has varargs (param_count < 0 is our sentinel for varargs)
fn tco_has_varargs(func: IrFunction) -> bool {
    if func.param_count < 0 {
        return true
    }
    return false
}

// Full eligibility check: cleanup, alloca, varargs all disqualify
pub(crate) fn tco_check_eligibility(func: IrFunction, info: TcoFuncInfo) -> (bool, i64) {
    if info.has_cleanup {
        return (false, TCO_REJECT_CLEANUP)
    }
    if info.has_alloca {
        return (false, TCO_REJECT_ALLOCA)
    }
    if tco_has_varargs(func) {
        return (false, TCO_REJECT_VARARGS)
    }
    return (true, 0)
}

// ============================================================================
// Section 7: Tail call discovery
// ============================================================================

// Discover all tail calls in a module, populating call_infos in the context.
pub(crate) fn tco_discover_tail_calls(ctx: TcoContext, module: IrModule) -> TcoContext with Mut, Div, Panic {
    var result = ctx
    var fi: i64 = 0
    while fi < module.fn_count && fi < TCO_MAX_FUNCS {
        let func = ir_fn_get(&module, fi as usize)
        var ii: i64 = 0
        while ii < func.instr_count {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
            if tco_is_call(instr) {
                if tco_is_tail_position(func, ii) {
                    if result.call_info_count < TCO_MAX_CALLS {
                        var ci = tco_call_info_new(fi, ii, instr.dst, 0)
                        ci.is_self_recursive = tco_is_self_call(func, ii)

                        // Extract arg registers
                        let extract = tco_extract_call_args(instr, ci.arg_regs)
                        ci.arg_count = extract.0
                        ci.arg_regs = extract.1

                        result.call_infos[result.call_info_count as usize] = ci
                        result.call_info_count = result.call_info_count + 1
                    }
                }
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return result
}

// ============================================================================
// Section 8: Analyze all functions in a module
// ============================================================================

fn tco_analyze_module(ctx: TcoContext, module: IrModule) -> TcoContext with Mut, Div, Panic {
    var result = ctx
    var fi: i64 = 0
    while fi < module.fn_count && fi < TCO_MAX_FUNCS {
        let func = ir_fn_get(&module, fi as usize)
        let info = tco_analyze_function(func, fi)
        result.func_infos[result.func_info_count as usize] = info
        result.func_info_count = result.func_info_count + 1
        result.stats.analyzed = result.stats.analyzed + 1

        if info.is_eligible {
            result.stats.eligible = result.stats.eligible + 1
        } else {
            result.stats.rejected = result.stats.rejected + 1
        }
        fi = fi + 1
    }
    return result
}

// ============================================================================
// Section 9: Self-recursive detection
// ============================================================================

// Mark all self-recursive tail calls in the context
fn tco_detect_self_recursive(ctx: TcoContext, module: IrModule) -> TcoContext with Mut, Div, Panic {
    var result = ctx
    var i: i64 = 0
    while i < result.call_info_count {
        let ci = result.call_infos[i as usize]
        let fid = ci.func_id
        if fid >= 0 && fid < module.fn_count {
            let func = ir_fn_get(&module, fid as usize)
            if tco_is_self_call(func, ci.call_instr_idx) {
                result.call_infos[i as usize].is_self_recursive = true
                result.stats.self_recursive = result.stats.self_recursive + 1
            }
        }
        i = i + 1
    }
    return result
}

// Count self-recursive tail calls for a given function
fn tco_count_self_tail_calls(ctx: TcoContext, fid: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.call_info_count {
        let ci = ctx.call_infos[i as usize]
        if ci.func_id == fid && ci.is_self_recursive {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// ============================================================================
// Section 10: Mutual recursion detection
// ============================================================================

// Get the callee function id for a tail call.
// Looks up the call instruction's target name in the module's function table.
fn tco_get_callee_id(module: IrModule, func_id: i64, call_idx: i64) -> i64 with Mut, Div, Panic {
    if func_id < 0 || func_id >= module.fn_count {
        return TCO_INVALID
    }
    let func = ir_fn_get(&module, func_id as usize)
    if call_idx < 0 || call_idx >= func.instr_count {
        return TCO_INVALID
    }
    let call_instr = ir_arena_load(ir_region_slot_r(func.region, (call_idx)))
    let target_name = ir_name_at(call_instr.name_id)

    // Search module for function with matching name
    var fi: i64 = 0
    while fi < module.fn_count {
        if ir_name_eq(ir_fn_get(&module, fi as usize).name, target_name) {
            return fi
        }
        fi = fi + 1
    }
    return TCO_INVALID
}

// Check if function A tail-calls function B (directly)
fn tco_a_tail_calls_b(ctx: TcoContext, module: IrModule, a: i64, b: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.call_info_count {
        let ci = ctx.call_infos[i as usize]
        if ci.func_id == a && !ci.is_self_recursive {
            let callee = tco_get_callee_id(module, a, ci.call_instr_idx)
            if callee == b {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// Detect mutual recursion: if A tail-calls B and B tail-calls A, they form a group.
fn tco_detect_mutual_recursive(ctx: TcoContext, module: IrModule) -> TcoContext with Mut, Div, Panic {
    var result = ctx
    // For each pair (a, b), check if a tail-calls b and b tail-calls a
    var a: i64 = 0
    while a < result.func_info_count {
        var b: i64 = a + 1
        while b < result.func_info_count {
            let aid = result.func_infos[a as usize].func_id
            let bid = result.func_infos[b as usize].func_id
            if aid != TCO_INVALID && bid != TCO_INVALID {
                let a_calls_b = tco_a_tail_calls_b(result, module, aid, bid)
                let b_calls_a = tco_a_tail_calls_b(result, module, bid, aid)
                if a_calls_b && b_calls_a {
                    // Mark all call_infos between these two as mutual_recursive
                    var ci: i64 = 0
                    while ci < result.call_info_count {
                        let info = result.call_infos[ci as usize]
                        if info.func_id == aid && !info.is_self_recursive {
                            let callee = tco_get_callee_id(module, aid, info.call_instr_idx)
                            if callee == bid {
                                result.call_infos[ci as usize].is_mutual_recursive = true
                            }
                        }
                        if info.func_id == bid && !info.is_self_recursive {
                            let callee = tco_get_callee_id(module, bid, info.call_instr_idx)
                            if callee == aid {
                                result.call_infos[ci as usize].is_mutual_recursive = true
                            }
                        }
                        ci = ci + 1
                    }
                    result.stats.mutual_recursive = result.stats.mutual_recursive + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    return result
}

// Build a mutual recursion group from the detected mutual calls
fn tco_build_mutual_group(ctx: TcoContext, module: IrModule, seed_fid: i64) -> TcoMutualGroup with Mut, Div, Panic {
    var group = tco_mutual_group_new()
    // Add seed
    if group.count < TCO_MAX_MUTUAL_GROUP {
        group.func_ids[group.count as usize] = seed_fid
        group.count = group.count + 1
    }

    // Find all functions mutually recursive with seed
    var i: i64 = 0
    while i < ctx.call_info_count {
        let ci = ctx.call_infos[i as usize]
        if ci.is_mutual_recursive && ci.func_id == seed_fid {
            let callee = tco_get_callee_id(module, seed_fid, ci.call_instr_idx)
            if callee != TCO_INVALID {
                // Check if already in group
                var found: bool = false
                var g: i64 = 0
                while g < group.count {
                    if group.func_ids[g as usize] == callee {
                        found = true
                    }
                    g = g + 1
                }
                if !found && group.count < TCO_MAX_MUTUAL_GROUP {
                    group.func_ids[group.count as usize] = callee
                    group.count = group.count + 1
                }
            }
        }
        i = i + 1
    }
    return group
}

// ============================================================================
// Section 11: Argument shuffling
// ============================================================================

// When transforming `return f(a, b)` into `param0 = a; param1 = b; goto loop`,
// we must be careful if a or b refers to a parameter register. If param0 = a
// overwrites param0, and b was originally param0, we get the wrong value for b.
//
// Solution: use temp registers to hold all new argument values first, then
// copy temps into param registers.

// Compute temp registers for argument shuffling.
// base_reg is the next free register. Returns the updated transform with
// param_copy_regs filled in.
fn tco_compute_shuffle_temps(xform: TcoTransform, arg_count: i64, base_reg: i64) -> TcoTransform with Mut, Div, Panic {
    var result = xform
    var i: i64 = 0
    while i < arg_count && i < TCO_MAX_PARAMS {
        result.param_copy_regs[i as usize] = base_reg + i
        i = i + 1
    }
    return result
}

// Check if any argument register overlaps with any parameter register.
// If not, we can skip temp registers entirely.
fn tco_needs_shuffle(arg_regs: [i64; 16], arg_count: i64, param_regs: [i64; 64], param_count: i64) -> bool with Mut, Div, Panic {
    var ai: i64 = 0
    while ai < arg_count && ai < TCO_MAX_PARAMS {
        let arg_r = arg_regs[ai as usize]
        var pi: i64 = 0
        while pi < param_count && pi < TCO_MAX_PARAMS {
            if arg_r == param_regs[pi as usize] {
                return true
            }
            pi = pi + 1
        }
        ai = ai + 1
    }
    return false
}

// Generate the copy instructions for argument shuffling.
// Phase 1: copy args into temps.  Phase 2: copy temps into params.
// Returns the number of instructions emitted.
fn tco_emit_shuffle(func: IrFunction, insert_at: i64, arg_regs: [i64; 16],
                    arg_count: i64, param_regs: [i64; 64], param_count: i64,
                    temps: [i64; 16]) -> (IrFunction, i64) with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var pos = insert_at
    let count = if arg_count < param_count { arg_count } else { param_count }

    // Phase 1: args -> temps
    var i: i64 = 0
    while i < count && i < TCO_MAX_PARAMS {
        if pos < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w(result.region, (pos)), ir_copy(temps[i as usize], arg_regs[i as usize]))
            pos = pos + 1
        }
        i = i + 1
    }

    // Phase 2: temps -> params
    var j: i64 = 0
    while j < count && j < TCO_MAX_PARAMS {
        if pos < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w(result.region, (pos)), ir_copy(param_regs[j as usize], temps[j as usize]))
            pos = pos + 1
        }
        j = j + 1
    }

    let emitted = pos - insert_at
    return (result, emitted)
}

// Generate direct copy instructions (no temps needed) for non-overlapping args.
fn tco_emit_direct_copy(func: IrFunction, insert_at: i64, arg_regs: [i64; 16],
                        arg_count: i64, param_regs: [i64; 64],
                        param_count: i64) -> (IrFunction, i64) with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var pos = insert_at
    let count = if arg_count < param_count { arg_count } else { param_count }

    var i: i64 = 0
    while i < count && i < TCO_MAX_PARAMS {
        if pos < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w(result.region, (pos)), ir_copy(param_regs[i as usize], arg_regs[i as usize]))
            pos = pos + 1
        }
        i = i + 1
    }

    let emitted = pos - insert_at
    return (result, emitted)
}

// ============================================================================
// Section 12: Self-recursive TCO transformation (tail call -> loop)
// ============================================================================

// Transform a self-recursive tail call into a loop.
//
// Before:
//   fn f(x, y) {
//       ...
//       return f(a, b)
//   }
//
// After:
//   fn f(x, y) {
//       loop_label:
//       ...
//       x = a; y = b;    (with shuffle if needed)
//       goto loop_label
//   }
fn tco_transform_self_to_loop(func: IrFunction, call_idx: i64,
                               loop_label: i64) -> (IrFunction, TcoTransform) with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    var xform = tco_transform_new(0, TCO_KIND_SELF_TO_LOOP, loop_label)

    if call_idx < 0 || call_idx >= result.instr_count {
        return (result, xform)
    }

    let call_instr = ir_arena_load(ir_region_slot_r(result.region, (call_idx)))

    // Extract call arguments
    var arg_regs: [i64; 16] = [TCO_INVALID; 16]
    let extract = tco_extract_call_args(call_instr, arg_regs)
    let arg_count = extract.0
    arg_regs = extract.1

    // Check if we need temp registers for shuffling
    let needs_temps = tco_needs_shuffle(arg_regs, arg_count, result.param_regs, result.param_count)

    if needs_temps {
        // Allocate temp registers starting from current reg_count
        xform = tco_compute_shuffle_temps(xform, arg_count, result.reg_count)

        // Replace the call with: copy args to temps, copy temps to params, goto
        let shuffle_result = tco_emit_shuffle(result, call_idx, arg_regs, arg_count,
                                               result.param_regs, result.param_count,
                                               xform.param_copy_regs)
        result = shuffle_result.0
        let emitted = shuffle_result.1

        // Place jump after the shuffle copies
        let jump_pos = call_idx + emitted
        if jump_pos < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w(result.region, (jump_pos)), ir_jump(loop_label))
        }

        // Nop out the return instruction that followed the call
        var ri: i64 = jump_pos + 1
        while ri < result.instr_count {
            let ri_instr = ir_arena_load(ir_region_slot_r(result.region, (ri)))
            if tco_is_nop(ri_instr) {
                ri = ri + 1
            } else if tco_is_return(ri_instr) {
                ir_arena_store(ir_region_slot_w(result.region, (ri)), ir_nop())
                ri = result.instr_count
            } else {
                ri = result.instr_count
            }
        }

        result.reg_count = result.reg_count + arg_count
    } else {
        // No overlap: direct copy args to params, then jump
        let copy_result = tco_emit_direct_copy(result, call_idx, arg_regs, arg_count,
                                                result.param_regs, result.param_count)
        result = copy_result.0
        let emitted = copy_result.1

        let jump_pos = call_idx + emitted
        if jump_pos < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w(result.region, (jump_pos)), ir_jump(loop_label))
        }

        // Nop out the return
        var ri: i64 = jump_pos + 1
        while ri < result.instr_count {
            let ri_instr = ir_arena_load(ir_region_slot_r(result.region, (ri)))
            if tco_is_nop(ri_instr) {
                ri = ri + 1
            } else if tco_is_return(ri_instr) {
                ir_arena_store(ir_region_slot_w(result.region, (ri)), ir_nop())
                ri = result.instr_count
            } else {
                ri = result.instr_count
            }
        }
    }

    // Insert loop label at the beginning of the function body (after param loads)
    // We need to shift instructions to make room for the label
    // For simplicity, we insert the label as a nop-replacement at position 0
    // if the first instruction is a nop, or we note the label_id for later insertion.
    // In practice, we set the loop_label on the transform and the caller inserts it.

    return (result, xform)
}

// Insert a label instruction at the beginning of a function body.
// Shifts all instructions right by 1 to make room.
fn tco_insert_loop_label(func: IrFunction, label_id: i64) -> IrFunction with Mut, Div, Panic {
    var result = ir_function_clone(&func)
    if result.instr_count >= IR_MAX_INSTRS - 1 {
        return result
    }

    // Shift all instructions right by 1
    var i: i64 = result.instr_count
    while i > 0 {
        ir_arena_copy_slot(ir_region_slot_w(result.region, (i)),ir_region_slot_r(result.region, ((i - 1))))
        i = i - 1
    }

    // Insert label at position 0
    ir_arena_store(ir_region_slot_w(result.region, (0)), ir_label(label_id))
    result.instr_count = result.instr_count + 1
    result.label_count = result.label_count + 1

    return result
}

// ============================================================================
// Section 13: Trampoline generation (for mutual tail recursion)
// ============================================================================

// A trampoline is a loop that dispatches to the right function based on a
// "which function" tag. For mutually recursive functions A and B:
//
//   trampoline(tag, args...) {
//     loop:
//       if tag == 0: result = A(args); if A returned normally: return result
//       if tag == 1: result = B(args); if B returned normally: return result
//       // if A or B did a tail call, update tag and args, goto loop
//   }
//
// This is a simplified version that records the trampoline structure.

// Generate a trampoline function id (uses a simple counter scheme)
fn tco_allocate_trampoline_id(ctx: TcoContext) -> i64 {
    // Trampoline ids start at 10000 to avoid collision with real function ids
    return 10000 + ctx.transform_count
}

// Build a trampoline name from a group.
// Format: "trampoline_<seed_fid>"
fn tco_trampoline_name(seed_fid: i64) -> Name with Mut, Div, Panic {
    // "trampoline_" = [116, 114, 97, 109, 112, 111, 108, 105, 110, 101, 95]
    var name = ir_empty_name()
    name.buf[0] = 116 as i8   // t
    name.buf[1] = 114 as i8   // r
    name.buf[2] = 97 as i8    // a
    name.buf[3] = 109 as i8   // m
    name.buf[4] = 112 as i8   // p
    name.buf[5] = 111 as i8   // o
    name.buf[6] = 108 as i8   // l
    name.buf[7] = 105 as i8   // i
    name.buf[8] = 110 as i8   // n
    name.buf[9] = 101 as i8   // e
    name.buf[10] = 95 as i8   // _
    name.len = 11

    // Append seed_fid as digit(s)
    if seed_fid >= 0 && seed_fid <= 9 {
        name.buf[11] = (48 + seed_fid) as i8
        name.len = 12
    } else {
        let tens = seed_fid / 10
        let ones = seed_fid - tens * 10
        name.buf[11] = (48 + tens) as i8
        name.buf[12] = (48 + ones) as i8
        name.len = 13
    }
    return name
}

// Build a minimal trampoline function for a mutual recursion group.
// The trampoline has a dispatch tag (param 0) and the shared parameters.
// It contains a loop with conditional jumps to each function in the group.
fn tco_build_trampoline(group: TcoMutualGroup, dispatch_label: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    let seed = if group.count > 0 { group.func_ids[0] } else { 0 }
    func.name = tco_trampoline_name(seed)

    // Param 0: dispatch tag
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 1

    var pos: i64 = 0

    // Label for the dispatch loop
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_label(dispatch_label))
    pos = pos + 1

    // For each function in the group, emit:
    //   r_cmp = (tag == group_idx)
    //   branch_true r_cmp, call_label_<idx>
    var gi: i64 = 0
    while gi < group.count && gi < TCO_MAX_MUTUAL_GROUP {
        let cmp_reg = func.reg_count
        func.reg_count = func.reg_count + 1

        // Load the group index as immediate
        let idx_reg = func.reg_count
        func.reg_count = func.reg_count + 1
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(idx_reg, gi))
        pos = pos + 1

        // Compare tag (reg 0) with group index
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_binop(cmp_reg, 0, BinaryOp::OpEq, idx_reg))
        pos = pos + 1

        // Branch to a dispatch target label (dispatch_label + 1 + gi)
        let target_label = dispatch_label + 1 + gi
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_branch_true(cmp_reg, target_label))
        pos = pos + 1

        gi = gi + 1
    }

    // Default: return 0 (should not reach here)
    let zero_reg = func.reg_count
    func.reg_count = func.reg_count + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(zero_reg, 0))
    pos = pos + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(zero_reg))
    pos = pos + 1

    func.instr_count = pos
    func.label_count = dispatch_label + 1 + group.count

    return func
}

// Record a trampoline transform in the context
fn tco_record_trampoline(ctx: TcoContext, group: TcoMutualGroup,
                          trampoline_fid: i64) -> TcoContext with Mut, Div, Panic {
    var result = ctx
    var gi: i64 = 0
    while gi < group.count && gi < TCO_MAX_MUTUAL_GROUP {
        let fid = group.func_ids[gi as usize]
        if result.transform_count < TCO_MAX_TRANSFORMS {
            var xform = tco_transform_new(fid, TCO_KIND_MUTUAL_TO_TRAMPOLINE, TCO_INVALID)
            xform.trampoline_id = trampoline_fid
            result.transforms[result.transform_count as usize] = xform
            result.transform_count = result.transform_count + 1
            result.stats.transformed = result.stats.transformed + 1
        }
        gi = gi + 1
    }
    return result
}

// ============================================================================
// Section 14: Verification
// ============================================================================

// Verify that a self-recursive tail call transformation is valid.
// Checks:
//   1. Arg count matches param count
//   2. The call target matches the function name
fn tco_verify_self_transform(func: IrFunction, call_idx: i64) -> (bool, i64) with Mut, Div, Panic {
    if call_idx < 0 || call_idx >= func.instr_count {
        return (false, TCO_REJECT_TYPE_MISMATCH)
    }
    let call_instr = ir_arena_load(ir_region_slot_r(func.region, (call_idx)))
    if !tco_is_call(call_instr) {
        return (false, TCO_REJECT_TYPE_MISMATCH)
    }

    // Check name matches
    if !ir_name_eq(ir_name_at(call_instr.name_id), func.name) {
        return (false, TCO_REJECT_TYPE_MISMATCH)
    }

    // Check arg count vs param count
    if call_instr.arg_count != func.param_count {
        return (false, TCO_REJECT_TYPE_MISMATCH)
    }

    return (true, 0)
}

// Verify that a mutual recursion transform is valid.
// Checks that all functions in the group have compatible param counts.
fn tco_verify_mutual_transform(module: IrModule, group: TcoMutualGroup) -> bool with Mut, Div, Panic {
    if group.count < 2 {
        return false
    }
    // All functions in the group must have the same param count
    let first_fid = group.func_ids[0]
    if first_fid < 0 || first_fid >= module.fn_count {
        return false
    }
    let expected_params = ir_fn_get(&module, first_fid as usize).param_count

    var i: i64 = 1
    while i < group.count {
        let fid = group.func_ids[i as usize]
        if fid < 0 || fid >= module.fn_count {
            return false
        }
        if ir_fn_get(&module, fid as usize).param_count != expected_params {
            return false
        }
        i = i + 1
    }
    return true
}

// ============================================================================
// Section 15: Full TCO pipeline
// ============================================================================

// Run the full TCO pipeline on a module.
pub fn tco_run_pass(module: IrModule) -> (IrModule, TcoContext) with Alloc, Mut, Div, Panic {
    var result = module
    var ctx = tco_context_new()

    // Step 1: Analyze all functions
    ctx = tco_analyze_module(ctx, result)

    // Step 2: Discover tail calls
    ctx = tco_discover_tail_calls(ctx, result)

    // Step 3: Detect self-recursive tail calls
    ctx = tco_detect_self_recursive(ctx, result)

    // Step 4: Detect mutual recursion
    ctx = tco_detect_mutual_recursive(ctx, result)

    // Step 5: Transform eligible self-recursive tail calls
    var ci: i64 = 0
    while ci < ctx.call_info_count {
        let info = ctx.call_infos[ci as usize]
        if info.is_self_recursive && info.func_id >= 0 && info.func_id < result.fn_count {
            // Check eligibility
            let fi_idx = info.func_id
            if fi_idx < ctx.func_info_count && ctx.func_infos[fi_idx as usize].is_eligible {
                let func = ir_fn_get(&result, fi_idx as usize)
                let loop_label = func.label_count

                // Verify before transforming
                let verify = tco_verify_self_transform(func, info.call_instr_idx)
                let is_valid = verify.0
                if is_valid {
                    let xform_result = tco_transform_self_to_loop(func, info.call_instr_idx, loop_label)
                    var transformed_func = xform_result.0
                    let xform = xform_result.1

                    // Insert loop label at beginning
                    transformed_func = tco_insert_loop_label(transformed_func, loop_label)
                    ir_fn_set(&! result, fi_idx as usize, transformed_func)

                    // Record transform
                    if ctx.transform_count < TCO_MAX_TRANSFORMS {
                        ctx.transforms[ctx.transform_count as usize] = xform
                        ctx.transform_count = ctx.transform_count + 1
                        ctx.stats.transformed = ctx.stats.transformed + 1
                    }
                }
            }
        }
        ci = ci + 1
    }

    return (result, ctx)
}

// ============================================================================
// Section 16: Query helpers — used by tests and other passes
// ============================================================================

// Count total tail calls discovered for a function
pub(crate) fn tco_count_tail_calls_for_func(ctx: TcoContext, fid: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.call_info_count {
        if ctx.call_infos[i as usize].func_id == fid {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Count mutual recursive calls
fn tco_count_mutual_calls(ctx: TcoContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.call_info_count {
        if ctx.call_infos[i as usize].is_mutual_recursive {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Count transforms of a given kind
fn tco_count_transforms_of_kind(ctx: TcoContext, kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.transform_count {
        if ctx.transforms[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Get func info by func_id
fn tco_get_func_info(ctx: TcoContext, fid: i64) -> TcoFuncInfo with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.func_info_count {
        if ctx.func_infos[i as usize].func_id == fid {
            return ctx.func_infos[i as usize]
        }
        i = i + 1
    }
    return tco_default_func_info()
}

// Check if a function has any self-recursive tail calls
fn tco_has_self_recursive_calls(ctx: TcoContext, fid: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.call_info_count {
        let ci = ctx.call_infos[i as usize]
        if ci.func_id == fid && ci.is_self_recursive {
            return true
        }
        i = i + 1
    }
    return false
}

// Check if a function was transformed
fn tco_was_transformed(ctx: TcoContext, fid: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.transform_count {
        if ctx.transforms[i as usize].func_id == fid {
            return true
        }
        i = i + 1
    }
    return false
}

// ============================================================================
// Section 17: Test helpers — build synthetic IR for testing
// ============================================================================

// Build a function name from a prefix character and id
pub(crate) fn tco_make_func_name(prefix: i8, fid: i64) -> Name with Mut, Div, Panic {
    var name = ir_empty_name()
    name.buf[0] = prefix
    if fid >= 0 && fid <= 9 {
        name.buf[1] = (48 + fid) as i8
        name.len = 2
    } else {
        let tens = fid / 10
        let ones = fid - tens * 10
        name.buf[1] = (48 + tens) as i8
        name.buf[2] = (48 + ones) as i8
        name.len = 3
    }
    return name
}

// Build a simple test function with N load-imm instructions + a return.
pub(crate) fn tco_make_test_func(fid: i64, body_size: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)  // 'f'

    var i: i64 = 0
    while i < body_size - 1 && i < 32767 {
        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(i, i + 100))
        i = i + 1
    }

    if body_size > 0 {
        let ret_reg = if body_size > 1 { body_size - 2 } else { 0 }
        ir_arena_store(ir_region_slot_w(func.region, ((body_size - 1))), ir_return(ret_reg))
    }

    func.instr_count = body_size
    func.reg_count = body_size
    func.label_count = 0
    func.param_count = 0

    return func
}

// Build a function that self-tail-calls: body... call self, return call_result
pub(crate) fn tco_make_self_tail_call_func(fid: i64, body_before: i64, param_count: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)  // 'f'

    var pos: i64 = 0

    // Set up param regs
    var pi: i64 = 0
    while pi < param_count && pi < IR_MAX_PARAMS {
        func.param_regs[pi as usize] = pi
        pi = pi + 1
    }
    func.param_count = param_count
    func.reg_count = param_count

    // Body instructions before the tail call
    var b: i64 = 0
    while b < body_before {
        let dst = func.reg_count
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(dst, b + 200))
        func.reg_count = func.reg_count + 1
        pos = pos + 1
        b = b + 1
    }

    // Self-tail-call: call self with some args, then return
    let call_dst = func.reg_count
    func.reg_count = func.reg_count + 1

    // Build arg list using first param_count regs
    var args = ir_empty_reg_list()
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst, fid, func.name, args, param_count))
    // Put param regs in src1/src2 for up to 2 args
    if param_count > 0 {
        IR_A_SRC1[(ir_region_slot_w(func.region, (pos))) as usize] = func.param_regs[0]
    }
    if param_count > 1 {
        IR_A_SRC2[(ir_region_slot_w(func.region, (pos))) as usize] = func.param_regs[1]
    }
    IR_A_ARG_COUNT[(ir_region_slot_w(func.region, (pos))) as usize] = param_count
    pos = pos + 1

    // Return the call result
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst))
    pos = pos + 1

    func.instr_count = pos

    return func
}

// Build a function that calls another function in tail position
fn tco_make_tail_call_to(fid: i64, target_name: Name, target_fid: i64,
                          body_before: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)  // 'f'

    var pos: i64 = 0

    // Body instructions
    var b: i64 = 0
    while b < body_before {
        ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(pos, b + 100))
        pos = pos + 1
        b = b + 1
    }

    // Tail call to target
    let call_dst = pos
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst, target_fid, target_name, ir_empty_reg_list(), 0))
    pos = pos + 1

    // Return call result
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst))
    pos = pos + 1

    func.instr_count = pos
    func.reg_count = pos

    return func
}

// Build a function that has a non-tail call (operation after the call)
pub(crate) fn tco_make_non_tail_call_func(fid: i64, target_name: Name, target_fid: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)

    var pos: i64 = 0

    // Call to target
    let call_dst = pos
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst, target_fid, target_name, ir_empty_reg_list(), 0))
    pos = pos + 1

    // Operation AFTER the call (add 1 to result) — breaks tail position
    let add_dst = pos
    let one_reg = pos + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(one_reg, 1))
    pos = pos + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_binop(add_dst, call_dst, BinaryOp::OpAdd, one_reg))
    pos = pos + 1

    // Return the modified result
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(add_dst))
    pos = pos + 1

    func.instr_count = pos
    func.reg_count = pos + 1

    return func
}

// Build a function with an alloca instruction (ineligible for TCO)
pub(crate) fn tco_make_func_with_alloca(fid: i64) -> IrFunction with Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)

    var pos: i64 = 0

    // Alloca
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_alloc(pos, 0))
    pos = pos + 1

    // Self-tail-call
    let call_dst = pos
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst, fid, func.name, ir_empty_reg_list(), 0))
    pos = pos + 1

    // Return
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst))
    pos = pos + 1

    func.instr_count = pos
    func.reg_count = pos

    return func
}

// Build two mutually recursive functions: A tail-calls B, B tail-calls A
fn tco_make_mutual_pair(fid_a: i64, fid_b: i64) -> (IrFunction, IrFunction) with Mut, Div, Panic {
    let name_a = tco_make_func_name(102 as i8, fid_a)
    let name_b = tco_make_func_name(102 as i8, fid_b)

    // Function A: body + tail-call to B + return
    var func_a = ir_empty_function()
    func_a.name = name_a
    ir_arena_store(ir_region_slot_w(func_a.region, (0)), ir_load_imm(0, 42))
    let call_dst_a = 1
    ir_arena_store(ir_region_slot_w(func_a.region, (1)), ir_call(call_dst_a, fid_b, name_b, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(func_a.region, (2)), ir_return(call_dst_a))
    func_a.instr_count = 3
    func_a.reg_count = 2
    func_a.param_count = 0

    // Function B: body + tail-call to A + return
    var func_b = ir_empty_function()
    func_b.name = name_b
    ir_arena_store(ir_region_slot_w(func_b.region, (0)), ir_load_imm(0, 99))
    let call_dst_b = 1
    ir_arena_store(ir_region_slot_w(func_b.region, (1)), ir_call(call_dst_b, fid_a, name_a, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(func_b.region, (2)), ir_return(call_dst_b))
    func_b.instr_count = 3
    func_b.reg_count = 2
    func_b.param_count = 0

    return (func_a, func_b)
}

// Build a function with conditional tail calls (if/else both tail-calling self)
fn tco_make_conditional_tail_call(fid: i64) -> IrFunction with Alloc, Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, fid)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 1

    var pos: i64 = 0

    // r1 = 0 (comparison value)
    let zero_reg = func.reg_count
    func.reg_count = func.reg_count + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_load_imm(zero_reg, 0))
    pos = pos + 1

    // r2 = (param0 > 0)
    let cmp_reg = func.reg_count
    func.reg_count = func.reg_count + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_binop(cmp_reg, 0, BinaryOp::OpGt, zero_reg))
    pos = pos + 1

    // branch_false cmp_reg, else_label (label 1)
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_branch_false(cmp_reg, 1))
    pos = pos + 1

    // Then branch: self-tail-call
    let call_dst_1 = func.reg_count
    func.reg_count = func.reg_count + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst_1, fid, func.name, ir_empty_reg_list(), 1))
    IR_A_SRC1[(ir_region_slot_w(func.region, (pos))) as usize] = 0
    IR_A_ARG_COUNT[(ir_region_slot_w(func.region, (pos))) as usize] = 1
    pos = pos + 1

    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst_1))
    pos = pos + 1

    // Else label
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_label(1))
    pos = pos + 1

    // Else branch: also self-tail-call
    let call_dst_2 = func.reg_count
    func.reg_count = func.reg_count + 1
    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_call(call_dst_2, fid, func.name, ir_empty_reg_list(), 1))
    IR_A_SRC1[(ir_region_slot_w(func.region, (pos))) as usize] = 0
    IR_A_ARG_COUNT[(ir_region_slot_w(func.region, (pos))) as usize] = 1
    pos = pos + 1

    ir_arena_store(ir_region_slot_w(func.region, (pos)), ir_return(call_dst_2))
    pos = pos + 1

    func.instr_count = pos
    func.label_count = 2

    return func
}

// Build a test module from functions
pub(crate) fn tco_make_test_module(funcs: [IrFunction; 1024], count: i64) -> IrModule with Panic, Div, Alloc, Mut {
    var module = ir_empty_module()
    var fi: i64 = 0
    while fi < count && fi < 1024 {
        ir_fn_set(&! module, fi as usize, funcs[fi as usize])
        fi = fi + 1
    }
    module.fn_count = count
    module
}

// ============================================================================
// Section 18: Tests
// ============================================================================

// T01: Context initialization — all counts zero
fn test_tco_context_init() -> i32 with Alloc, IO, Mut, Div, Panic {
    let ctx = tco_context_new()
    if ctx.func_info_count != 0 {
        print("FAIL: test_tco_context_init (func_info_count)\n")
        return 1
    }
    if ctx.call_info_count != 0 {
        print("FAIL: test_tco_context_init (call_info_count)\n")
        return 1
    }
    if ctx.transform_count != 0 {
        print("FAIL: test_tco_context_init (transform_count)\n")
        return 1
    }
    if ctx.stats.analyzed != 0 {
        print("FAIL: test_tco_context_init (stats.analyzed)\n")
        return 1
    }
    print("PASS: test_tco_context_init\n")
    return 0
}

// T02: Stats initialization — all zero
fn test_tco_stats_init() -> i32 with Alloc, IO, Mut, Div, Panic {
    let s = tco_stats_new()
    if s.analyzed != 0 || s.eligible != 0 || s.self_recursive != 0 {
        print("FAIL: test_tco_stats_init\n")
        return 1
    }
    if s.mutual_recursive != 0 || s.transformed != 0 || s.rejected != 0 {
        print("FAIL: test_tco_stats_init\n")
        return 1
    }
    print("PASS: test_tco_stats_init\n")
    return 0
}

// T03: Simple tail position detection — call immediately before return
fn test_tco_tail_position_simple() -> i32 with Alloc, IO, Mut, Div, Panic {
    let target_name = tco_make_func_name(103 as i8, 1)  // 'g1'
    let func = tco_make_tail_call_to(0, target_name, 1, 2)
    // The call is at position 2 (after 2 load_imm instructions)
    let is_tail = tco_is_tail_position(func, 2)
    if !is_tail {
        print("FAIL: test_tco_tail_position_simple\n")
        return 1
    }
    print("PASS: test_tco_tail_position_simple\n")
    return 0
}

// T04: Non-tail position — operation after call
fn test_tco_non_tail_position() -> i32 with Alloc, IO, Mut, Div, Panic {
    let target_name = tco_make_func_name(103 as i8, 1)
    let func = tco_make_non_tail_call_func(0, target_name, 1)
    // The call is at position 0
    let is_tail = tco_is_tail_position(func, 0)
    if is_tail {
        print("FAIL: test_tco_non_tail_position\n")
        return 1
    }
    print("PASS: test_tco_non_tail_position\n")
    return 0
}

// T05: Self-recursive call detection
fn test_tco_self_recursive_detection() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 3, 0)
    // Find the call instruction
    var call_idx: i64 = 0
    var found: bool = false
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) {
            call_idx = si
            found = true
        }
        si = si + 1
    }
    if !found {
        print("FAIL: test_tco_self_recursive_detection (no call found)\n")
        return 1
    }
    let is_self = tco_is_self_call(func, call_idx)
    if !is_self {
        print("FAIL: test_tco_self_recursive_detection\n")
        return 1
    }
    print("PASS: test_tco_self_recursive_detection\n")
    return 0
}

// T06: Non-self call should not be detected as self-recursive
fn test_tco_non_self_call() -> i32 with Alloc, IO, Mut, Div, Panic {
    let target_name = tco_make_func_name(103 as i8, 1)
    let func = tco_make_tail_call_to(0, target_name, 1, 1)
    // Find the call
    var call_idx: i64 = 0
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) {
            call_idx = si
        }
        si = si + 1
    }
    let is_self = tco_is_self_call(func, call_idx)
    if is_self {
        print("FAIL: test_tco_non_self_call\n")
        return 1
    }
    print("PASS: test_tco_non_self_call\n")
    return 0
}

// T07: Function analysis — simple function without tail calls
