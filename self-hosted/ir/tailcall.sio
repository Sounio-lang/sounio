}

// T08: Function analysis — function with self-tail-call
fn test_tco_analyze_with_tail_call() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 2, 0)
    let info = tco_analyze_function(func, 0)
