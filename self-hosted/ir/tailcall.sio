// T40: Transform kind count helper
fn test_tco_count_transforms_of_kind() -> i32 with Alloc, IO, Mut, Div, Panic {
    var ctx = tco_context_new()
    // Add two self-to-loop transforms and one trampoline
    var x1 = tco_transform_new(0, TCO_KIND_SELF_TO_LOOP, 0)
    var x2 = tco_transform_new(1, TCO_KIND_SELF_TO_LOOP, 1)
    var x3 = tco_transform_new(2, TCO_KIND_MUTUAL_TO_TRAMPOLINE, TCO_INVALID)
    ctx.transforms[0] = x1
    ctx.transforms[1] = x2
    ctx.transforms[2] = x3
    ctx.transform_count = 3

    let self_count = tco_count_transforms_of_kind(ctx, TCO_KIND_SELF_TO_LOOP)
    let mutual_count = tco_count_transforms_of_kind(ctx, TCO_KIND_MUTUAL_TO_TRAMPOLINE)
    if self_count != 2 {
        print("FAIL: test_tco_count_transforms_of_kind (self)\n")
        return 1
    }
    if mutual_count != 1 {
        print("FAIL: test_tco_count_transforms_of_kind (mutual)\n")
        return 1
    }
    print("PASS: test_tco_count_transforms_of_kind\n")
    return 0
}

