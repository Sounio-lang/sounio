// T51: Instruction classification — branch
fn test_tco_is_branch_helper() -> i32 with Alloc, IO, Mut, Div, Panic {
    let bt = ir_branch_true(0, 1)
    let bf = ir_branch_false(0, 2)
    let nop = ir_nop()
    if !tco_is_branch(bt) {
        print("FAIL: test_tco_is_branch_helper (branch_true)\n")
        return 1
    }
    if !tco_is_branch(bf) {
        print("FAIL: test_tco_is_branch_helper (branch_false)\n")
        return 1
    }
    if tco_is_branch(nop) {
        print("FAIL: test_tco_is_branch_helper (nop)\n")
        return 1
    }
    print("PASS: test_tco_is_branch_helper\n")
    return 0
}

// T52: Instruction classification — alloc
fn test_tco_is_alloc_helper() -> i32 with Alloc, IO, Mut, Div, Panic {
    let alloc = ir_alloc(0, 0)
    let nop = ir_nop()
    if !tco_is_alloc(alloc) {
        print("FAIL: test_tco_is_alloc_helper (alloc)\n")
        return 1
    }
    if tco_is_alloc(nop) {
        print("FAIL: test_tco_is_alloc_helper (nop)\n")
        return 1
    }
    print("PASS: test_tco_is_alloc_helper\n")
    return 0
}

// T53: Out-of-bounds call index returns false for tail position
fn test_tco_tail_position_oob() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_test_func(0, 5)
    let is_tail_neg = tco_is_tail_position(func, 0 - 1)
    let is_tail_big = tco_is_tail_position(func, 9999)
    if is_tail_neg || is_tail_big {
        print("FAIL: test_tco_tail_position_oob\n")
        return 1
    }
    print("PASS: test_tco_tail_position_oob\n")
    return 0
}

// T54: Was-transformed helper
fn test_tco_was_transformed_helper() -> i32 with Alloc, IO, Mut, Div, Panic {
    var ctx = tco_context_new()
    var x = tco_transform_new(5, TCO_KIND_SELF_TO_LOOP, 0)
    ctx.transforms[0] = x
    ctx.transform_count = 1

    let was_5 = tco_was_transformed(ctx, 5)
    let was_3 = tco_was_transformed(ctx, 3)
    if !was_5 {
        print("FAIL: test_tco_was_transformed_helper (fid 5)\n")
        return 1
    }
    if was_3 {
        print("FAIL: test_tco_was_transformed_helper (fid 3)\n")
        return 1
    }
    print("PASS: test_tco_was_transformed_helper\n")
    return 0
}

// T55: Extract call args
fn test_tco_extract_call_args() -> i32 with Alloc, IO, Mut, Div, Panic {
    var instr = ir_call(10, 0, ir_empty_name(), ir_empty_reg_list(), 2)
    instr.src1 = 3
    instr.src2 = 7
    instr.arg_count = 2

    var out: [i64; 16] = [TCO_INVALID; 16]
    let result = tco_extract_call_args(instr, out)
    let count = result.0
    let regs = result.1

    if count != 2 {
        print("FAIL: test_tco_extract_call_args (count)\n")
        return 1
    }
    if regs[0] != 3 {
        print("FAIL: test_tco_extract_call_args (arg0)\n")
        return 1
    }
    if regs[1] != 7 {
        print("FAIL: test_tco_extract_call_args (arg1)\n")
        return 1
    }
    print("PASS: test_tco_extract_call_args\n")
    return 0
}

// T56: Default structs have correct sentinel values
fn test_tco_default_structs() -> i32 with Alloc, IO, Mut, Div, Panic {
    let ci = tco_default_call_info()
    if ci.func_id != TCO_INVALID {
        print("FAIL: test_tco_default_structs (call_info.func_id)\n")
        return 1
    }
    if ci.is_self_recursive {
        print("FAIL: test_tco_default_structs (call_info.is_self_recursive)\n")
        return 1
    }

    let fi = tco_default_func_info()
    if fi.func_id != TCO_INVALID {
        print("FAIL: test_tco_default_structs (func_info.func_id)\n")
        return 1
    }
    if !fi.is_eligible {
        print("FAIL: test_tco_default_structs (func_info.is_eligible)\n")
        return 1
    }

    let xf = tco_default_transform()
    if xf.func_id != TCO_INVALID {
        print("FAIL: test_tco_default_structs (transform.func_id)\n")
        return 1
    }
    if xf.kind != 0 {
        print("FAIL: test_tco_default_structs (transform.kind)\n")
        return 1
    }

    print("PASS: test_tco_default_structs\n")
    return 0
}

// T57: Full pipeline on empty module
fn test_tco_full_pipeline_empty() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let module = tco_make_test_module(funcs, 0)

    let result = tco_run_pass(module)
    let out_module = result.0
    let ctx = result.1

    if ctx.stats.analyzed != 0 {
        print("FAIL: test_tco_full_pipeline_empty (analyzed)\n")
        return 1
    }
    if ctx.stats.transformed != 0 {
        print("FAIL: test_tco_full_pipeline_empty (transformed)\n")
        return 1
    }
    if out_module.fn_count != 0 {
        print("FAIL: test_tco_full_pipeline_empty (fn_count)\n")
        return 1
    }
    print("PASS: test_tco_full_pipeline_empty\n")
    return 0
}

