    func.name = tco_make_func_name(102 as i8, 0)

    // call dst = r0, return r1 (different register)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_call(0, 1, tco_make_func_name(103 as i8, 1), ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))
    func.instr_count = 2
    func.reg_count = 2

    let is_tail = tco_is_tail_position(func, 0)
    if is_tail {
        print("FAIL: test_tco_non_tail_wrong_reg\n")
        return 1
    }
    print("PASS: test_tco_non_tail_wrong_reg\n")
    return 0
}

