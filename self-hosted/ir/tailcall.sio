    let ci = ctx.call_infos[0]
    if ci.func_id != 0 {
        print("FAIL: test_tco_discover_tail_calls (func_id)\n")
        return 1
    }
    print("PASS: test_tco_discover_tail_calls\n")
    return 0
}

// T13: Self-recursive marking
fn test_tco_self_recursive_marking() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = tco_make_self_tail_call_func(0, 2, 0)
    let module = tco_make_test_module(funcs, 1)

    var ctx = tco_context_new()
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)

    if ctx.call_info_count < 1 {
        print("FAIL: test_tco_self_recursive_marking (no calls)\n")
        return 1
    }
    if !ctx.call_infos[0].is_self_recursive {
        print("FAIL: test_tco_self_recursive_marking\n")
        return 1
    }
    if ctx.stats.self_recursive < 1 {
        print("FAIL: test_tco_self_recursive_marking (stats)\n")
        return 1
    }
    print("PASS: test_tco_self_recursive_marking\n")
    return 0
}

// T14: Mutual recursion detection — A calls B, B calls A
fn test_tco_mutual_recursion_detection() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let pair = tco_make_mutual_pair(0, 1)
    funcs[0] = pair.0
    funcs[1] = pair.1
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)
    ctx = tco_detect_mutual_recursive(ctx, module)

    let mutual_count = tco_count_mutual_calls(ctx)
    if mutual_count < 2 {
        print("FAIL: test_tco_mutual_recursion_detection\n")
        return 1
    }
    if ctx.stats.mutual_recursive < 1 {
        print("FAIL: test_tco_mutual_recursion_detection (stats)\n")
        return 1
    }
    print("PASS: test_tco_mutual_recursion_detection\n")
    return 0
}

// T15: Non-mutual — A calls B but B doesn't call A
fn test_tco_non_mutual_recursion() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let name_b = tco_make_func_name(102 as i8, 1)
    funcs[0] = tco_make_tail_call_to(0, name_b, 1, 1)
    funcs[1] = tco_make_test_func(1, 3)  // B doesn't call A
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)
    ctx = tco_detect_mutual_recursive(ctx, module)

    let mutual_count = tco_count_mutual_calls(ctx)
    if mutual_count != 0 {
        print("FAIL: test_tco_non_mutual_recursion\n")
        return 1
    }
    print("PASS: test_tco_non_mutual_recursion\n")
    return 0
}

// T16: Self-recursive -> loop transformation
fn test_tco_self_to_loop_transform() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 2, 0)
    // Find the call instruction index
    var call_idx: i64 = TCO_INVALID
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) {
            call_idx = si
        }
        si = si + 1
    }
    if call_idx == TCO_INVALID {
        print("FAIL: test_tco_self_to_loop_transform (no call)\n")
        return 1
    }

    let loop_label = func.label_count
    let result = tco_transform_self_to_loop(func, call_idx, loop_label)
    let transformed = result.0
    let xform = result.1

    if xform.kind != TCO_KIND_SELF_TO_LOOP {
        print("FAIL: test_tco_self_to_loop_transform (kind)\n")
        return 1
    }
    if xform.loop_label != loop_label {
        print("FAIL: test_tco_self_to_loop_transform (label)\n")
        return 1
    }

    // The call instruction should have been replaced (not a call anymore)
    // It should now be either a copy or a jump
    let replaced = ir_arena_load(ir_region_slot_r(transformed.region, (call_idx)))
    if tco_is_call(replaced) {
        print("FAIL: test_tco_self_to_loop_transform (still call)\n")
        return 1
    }

    print("PASS: test_tco_self_to_loop_transform\n")
    return 0
}

// T17: Loop label insertion
fn test_tco_loop_label_insertion() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_test_func(0, 5)
    let label_id = 42
    let result = tco_insert_loop_label(func, label_id)

    // Instr count should increase by 1
    if result.instr_count != func.instr_count + 1 {
        print("FAIL: test_tco_loop_label_insertion (count)\n")
        return 1
    }

    // First instruction should be a label with the given id
    let first = ir_arena_load(ir_region_slot_r(result.region, (0)))
    if !tco_is_label(first) {
        print("FAIL: test_tco_loop_label_insertion (not label)\n")
        return 1
    }
    if first.label_id != label_id {
        print("FAIL: test_tco_loop_label_insertion (label_id)\n")
        return 1
    }
    print("PASS: test_tco_loop_label_insertion\n")
    return 0
}

// T18: Argument shuffling — overlap detection
fn test_tco_shuffle_overlap_detection() -> i32 with Alloc, IO, Mut, Div, Panic {
    // Args use reg 0, params also use reg 0 => overlap
    var arg_regs: [i64; 16] = [TCO_INVALID; 16]
    arg_regs[0] = 0
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    param_regs[0] = 0

    let needs = tco_needs_shuffle(arg_regs, 1, param_regs, 1)
    if !needs {
        print("FAIL: test_tco_shuffle_overlap_detection\n")
        return 1
    }
    print("PASS: test_tco_shuffle_overlap_detection\n")
    return 0
}

// T19: Argument shuffling — no overlap
fn test_tco_shuffle_no_overlap() -> i32 with Alloc, IO, Mut, Div, Panic {
    // Args use reg 5, params use reg 0 => no overlap
    var arg_regs: [i64; 16] = [TCO_INVALID; 16]
    arg_regs[0] = 5
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    param_regs[0] = 0

    let needs = tco_needs_shuffle(arg_regs, 1, param_regs, 1)
    if needs {
        print("FAIL: test_tco_shuffle_no_overlap\n")
        return 1
    }
    print("PASS: test_tco_shuffle_no_overlap\n")
    return 0
}

// T20: Temp register computation
fn test_tco_compute_shuffle_temps() -> i32 with Alloc, IO, Mut, Div, Panic {
    let xform = tco_default_transform()
    let updated = tco_compute_shuffle_temps(xform, 3, 100)

    if updated.param_copy_regs[0] != 100 {
        print("FAIL: test_tco_compute_shuffle_temps (reg 0)\n")
        return 1
    }
    if updated.param_copy_regs[1] != 101 {
        print("FAIL: test_tco_compute_shuffle_temps (reg 1)\n")
        return 1
    }
    if updated.param_copy_regs[2] != 102 {
        print("FAIL: test_tco_compute_shuffle_temps (reg 2)\n")
        return 1
    }
    print("PASS: test_tco_compute_shuffle_temps\n")
    return 0
}

// T21: Direct copy emission (no temps)
fn test_tco_emit_direct_copy() -> i32 with Alloc, IO, Mut, Div, Panic {
    var func = ir_empty_function()
    func.instr_count = 10
    func.reg_count = 10

    var arg_regs: [i64; 16] = [TCO_INVALID; 16]
    arg_regs[0] = 5
    arg_regs[1] = 6
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    param_regs[0] = 0
    param_regs[1] = 1

    let result = tco_emit_direct_copy(func, 0, arg_regs, 2, param_regs, 2)
    let updated_func = result.0
    let emitted = result.1

    if emitted != 2 {
        print("FAIL: test_tco_emit_direct_copy (count)\n")
        return 1
    }

    // First copy: param0 <- arg0 (reg 0 <- reg 5)
    let copy1 = ir_arena_load(ir_region_slot_r(updated_func.region, (0)))
    if !tco_is_copy(copy1) {
        print("FAIL: test_tco_emit_direct_copy (instr 0 not copy)\n")
        return 1
    }
    if copy1.dst != 0 || copy1.src1 != 5 {
        print("FAIL: test_tco_emit_direct_copy (copy1 regs)\n")
        return 1
    }
    print("PASS: test_tco_emit_direct_copy\n")
    return 0
}

// T22: Shuffle emission (with temps)
fn test_tco_emit_shuffle() -> i32 with Alloc, IO, Mut, Div, Panic {
    var func = ir_empty_function()
    func.instr_count = 20
    func.reg_count = 10

    var arg_regs: [i64; 16] = [TCO_INVALID; 16]
    arg_regs[0] = 0  // arg is same as param => overlap
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    param_regs[0] = 0
    var temps: [i64; 16] = [TCO_INVALID; 16]
    temps[0] = 50

    let result = tco_emit_shuffle(func, 0, arg_regs, 1, param_regs, 1, temps)
    let updated_func = result.0
    let emitted = result.1

    // Phase 1: arg -> temp (1 copy), Phase 2: temp -> param (1 copy) = 2 total
    if emitted != 2 {
        print("FAIL: test_tco_emit_shuffle (count)\n")
        return 1
    }

    // First: copy temp <- arg (reg 50 <- reg 0)
    let c1 = ir_arena_load(ir_region_slot_r(updated_func.region, (0)))
    if c1.dst != 50 || c1.src1 != 0 {
        print("FAIL: test_tco_emit_shuffle (phase1)\n")
        return 1
    }

    // Second: copy param <- temp (reg 0 <- reg 50)
    let c2 = ir_arena_load(ir_region_slot_r(updated_func.region, (1)))
    if c2.dst != 0 || c2.src1 != 50 {
        print("FAIL: test_tco_emit_shuffle (phase2)\n")
        return 1
    }

    print("PASS: test_tco_emit_shuffle\n")
    return 0
}

// T23: Instruction classification — call
fn test_tco_is_call_helper() -> i32 with Alloc, IO, Mut, Div, Panic {
    let call = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)
    let nop = ir_nop()
    if !tco_is_call(call) {
        print("FAIL: test_tco_is_call_helper (call)\n")
        return 1
    }
    if tco_is_call(nop) {
        print("FAIL: test_tco_is_call_helper (nop)\n")
        return 1
    }
    print("PASS: test_tco_is_call_helper\n")
    return 0
}

