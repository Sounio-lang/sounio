// T32: Trampoline generation
fn test_tco_build_trampoline() -> i32 with Alloc, IO, Mut, Div, Panic {
    var group = tco_mutual_group_new()
    group.func_ids[0] = 0
    group.func_ids[1] = 1
    group.count = 2

    let tramp = tco_build_trampoline(group, 0)

    // Should have at least some instructions
    if tramp.instr_count < 3 {
        print("FAIL: test_tco_build_trampoline (instr_count)\n")
        return 1
    }

    // First instruction should be a label
    if !tco_is_label(ir_arena_load(ir_region_slot_r(tramp.region, (0)))) {
        print("FAIL: test_tco_build_trampoline (first not label)\n")
        return 1
    }

    // Should have param for dispatch tag
    if tramp.param_count != 1 {
        print("FAIL: test_tco_build_trampoline (param_count)\n")
        return 1
    }

    print("PASS: test_tco_build_trampoline\n")
    return 0
}

// T33: Mutual group building
fn test_tco_build_mutual_group() -> i32 with Alloc, IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let pair = tco_make_mutual_pair(0, 1)
    funcs[0] = pair.0
    funcs[1] = pair.1
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)
    ctx = tco_detect_mutual_recursive(ctx, module)

    let group = tco_build_mutual_group(ctx, module, 0)
    if group.count < 2 {
        print("FAIL: test_tco_build_mutual_group (count)\n")
        return 1
    }
    // Should contain both 0 and 1
    var has_0: bool = false
    var has_1: bool = false
    var gi: i64 = 0
    while gi < group.count {
        if group.func_ids[gi as usize] == 0 {
            has_0 = true
        }
        if group.func_ids[gi as usize] == 1 {
            has_1 = true
        }
        gi = gi + 1
    }
    if !has_0 || !has_1 {
        print("FAIL: test_tco_build_mutual_group (members)\n")
        return 1
    }
    print("PASS: test_tco_build_mutual_group\n")
    return 0
}

// T34: Verify self-transform — valid
fn test_tco_verify_self_valid() -> i32 with Alloc, IO, Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 2, 0)
    // Find call idx
    var call_idx: i64 = TCO_INVALID
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) {
            call_idx = si
        }
        si = si + 1
    }
    let verify = tco_verify_self_transform(func, call_idx)
    let is_valid = verify.0
    if !is_valid {
        print("FAIL: test_tco_verify_self_valid\n")
        return 1
    }
    print("PASS: test_tco_verify_self_valid\n")
    return 0
}

