// T26: Tail position with nops between call and return
fn test_tco_tail_position_with_nops() -> i32 with Alloc, IO, Mut, Div, Panic {
    var func = ir_empty_function()
    func.name = tco_make_func_name(102 as i8, 0)

    // call at pos 0, nop at pos 1, return at pos 2
    let call_dst = 0
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_call(call_dst, 1, tco_make_func_name(103 as i8, 1), ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_nop())
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(call_dst))
    func.instr_count = 3
    func.reg_count = 1

    let is_tail = tco_is_tail_position(func, 0)
    if !is_tail {
        print("FAIL: test_tco_tail_position_with_nops\n")
        return 1
    }
    print("PASS: test_tco_tail_position_with_nops\n")
    return 0
}

// T27: Non-tail — return uses different register than call result
fn test_tco_non_tail_wrong_reg() -> i32 with Alloc, IO, Mut, Div, Panic {
