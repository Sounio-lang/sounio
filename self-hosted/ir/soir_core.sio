// IR serialization/deserialization for verification and artifact boundary

module ir::soir_core

use parser::ast::*
use ir::ir::*
//
// SOIR v5 Binary Format:
// ─────────────────────────
// Header (8 bytes):
//   - Magic: "SOIR" (0x534F4952 little-endian)
//   - Version: 5 (1 byte)
//   - Reserved: 0x00 (3 bytes padding)
//
// Body:
//   - fn_count: i64 (8 bytes)
//   - functions[]: array of serialized IrFunction
//   - string_count: i64 (8 bytes)
//   - strings[]: array of serialized Name
//   - epistemic: IrEpistemicSection (v2+)
//   - algebras: IrAlgebraTable (v3+)
//
// IrFunction encoding:
//   - name: Name (128 bytes + 8 byte length)
//   - instr_count: i64
//   - reg_count: i64
//   - label_count: i64
//   - param_count: i64
//   - param_regs: [i64; 64]
//   - compile_strategy: i64
//   - prof_counter_id: i64
//   - hyper_algebra_kind: i64 (v3+)
//   - defining_module_id: i64 (v5+; older artifacts deserialize as UNKNOWN)
//   - instrs: array of IrInstr
//
// IrInstr encoding (fixed-size, 232 bytes):
//   - op: IrOpcode (1 byte + 7 padding)
//   - dst, src1, src2: i64 (8 bytes each)
//   - imm_i64: i64
//   - imm_f64: f64
//   - label_id, fn_id, field_idx: i64 (8 bytes each)
//   - bin_op: BinaryOp (1 byte + 7 padding)
//   - un_op: UnaryOp (1 byte + 7 padding)
//   - name: Name (128 bytes + 8 byte length)
//   - arg_count: i64

pub let SOIR_MAGIC: i64 = 1380206931  // "SOIR" as i32 cast to i64
pub let SOIR_VERSION: i8 = 5
pub let SOIR_MAX_SIZE: i64 = 131072  // 128KB max module size
pub let SOIR_NAME_SIZE: i64 = 136
pub let SOIR_INSTR_SIZE: i64 = 232
pub let SOIR_FUNCTION_HEADER_V1_SIZE: i64 = 696
pub let SOIR_FUNCTION_HEADER_V3_SIZE: i64 = 704
pub let SOIR_FUNCTION_HEADER_V5_SIZE: i64 = 712
pub let SOIR_INVALID_POS: i64 = 131073

// Low-level readers and writers share the fixed SOIR buffer type, so keep the
// active logical limit and failure bit here. This avoids widening every helper
// signature while still making every primitive access capacity-aware.
pub var SOIR_WRITE_FAILED: bool = false
pub var SOIR_READ_FAILED: bool = false
pub var SOIR_READ_LIMIT: i64 = 0

pub fn write_i8(buf: [i8; 131072], pos: i64, val: i8) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    if pos < 0 || pos >= SOIR_MAX_SIZE {
        SOIR_WRITE_FAILED = true
        return (b, SOIR_INVALID_POS)
    }
    b[pos] = val
    (b, pos + 1)
}

pub fn write_i64(buf: [i8; 131072], pos: i64, val: i64) -> ([i8; 131072], i64) with Mut, Panic, Div {
    // Little-endian encoding - use write_i8 helper to avoid type issues
    var b = buf
    var p = pos

    let p0 = write_i8(b, p, ((val) & 255) as i8)
    b = p0.0
    p = p0.1
    let p1 = write_i8(b, p, ((val >> 8) & 255) as i8)
    b = p1.0
    p = p1.1
    let p2 = write_i8(b, p, ((val >> 16) & 255) as i8)
    b = p2.0
    p = p2.1
    let p3 = write_i8(b, p, ((val >> 24) & 255) as i8)
    b = p3.0
    p = p3.1
    let p4 = write_i8(b, p, ((val >> 32) & 255) as i8)
    b = p4.0
    p = p4.1
    let p5 = write_i8(b, p, ((val >> 40) & 255) as i8)
    b = p5.0
    p = p5.1
    let p6 = write_i8(b, p, ((val >> 48) & 255) as i8)
    b = p6.0
    p = p6.1
    let p7 = write_i8(b, p, ((val >> 56) & 255) as i8)
    b = p7.0
    p = p7.1

    (b, p)
}

pub fn write_f64(buf: [i8; 131072], pos: i64, val: f64) -> ([i8; 131072], i64) with Mut, Panic, Div {
    // IEEE 754 double → i64 via compiler builtin (proper bit reinterpretation)
    let bits = f64_to_bits(val)
    write_i64(buf, pos, bits)
}

pub fn write_name(buf: [i8; 131072], pos: i64, n: Name) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    if pos < 0 || pos + SOIR_NAME_SIZE > SOIR_MAX_SIZE {
        SOIR_WRITE_FAILED = true
        return (b, SOIR_INVALID_POS)
    }
    var p = pos
    // Write length first
    let pair = write_i64(b, p, n.len)
    b = pair.0
    p = pair.1
    // Write buffer bytes
    var i: i64 = 0
    while i < 128 {
        b[p + i] = n.buf[i]
        i = i + 1
    }
    (b, p + 128)
}

pub fn read_i8(buf: [i8; 131072], pos: i64) -> (i8, i64) with Mut, Panic, Div {
    if pos < 0 || pos >= SOIR_READ_LIMIT {
        SOIR_READ_FAILED = true
        return (0 as i8, pos)
    }
    (buf[pos], pos + 1)
}

pub fn read_i64(buf: [i8; 131072], pos: i64) -> (i64, i64) with Mut, Panic, Div {
    if pos < 0 || pos + 8 > SOIR_READ_LIMIT {
        SOIR_READ_FAILED = true
        return (0, pos)
    }
    // Little-endian decoding - mask to ensure unsigned byte interpretation
    let raw0: i64 = buf[pos + 0] as i64
    let raw1: i64 = buf[pos + 1] as i64
    let raw2: i64 = buf[pos + 2] as i64
    let raw3: i64 = buf[pos + 3] as i64
    let raw4: i64 = buf[pos + 4] as i64
    let raw5: i64 = buf[pos + 5] as i64
    let raw6: i64 = buf[pos + 6] as i64
    let raw7: i64 = buf[pos + 7] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    let val = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
    (val, pos + 8)
}

// IEEE 754 double: i64 bits → f64 via arithmetic reconstruction.
// sign (bit 63) | exponent (bits 62..52, bias 1023) | mantissa (bits 51..0)
pub fn ieee754_bits_to_f64(bits: i64) -> f64 with Mut, Panic, Div {
    // Zero (positive or negative)
    if (bits & 0x7FFFFFFFFFFFFFFF) == 0 { return 0.0 }

    let sign_bit = (bits >> 63) & 1
    let raw_exp = (bits >> 52) & 0x7FF
    let frac_bits = bits & 0xFFFFFFFFFFFFF

    // Infinity / NaN — return 0.0 as safe fallback for serialization
    if raw_exp == 0x7FF { return 0.0 }

    // Reconstruct mantissa: 1.frac (normal) or 0.frac (subnormal)
    var mantissa: f64 = 0.0
    var bit_val: f64 = 0.5
    var i: i64 = 51
    while i >= 0 {
        if ((frac_bits >> i) & 1) == 1 {
            mantissa = mantissa + bit_val
        }
        bit_val = bit_val / 2.0
        i = i - 1
    }

    var result: f64 = 0.0
    if raw_exp == 0 {
        // Subnormal: 0.frac × 2^(-1022)
        result = mantissa
        var e: i64 = 0
        while e < 1022 {
            result = result / 2.0
            e = e + 1
        }
    } else {
        // Normal: (1 + mantissa) × 2^(exp - 1023)
        result = 1.0 + mantissa
        let exp = raw_exp - 1023
        if exp > 0 {
            var e: i64 = 0
            while e < exp {
                result = result * 2.0
                e = e + 1
            }
        } else if exp < 0 {
            let neg_exp = 0 - exp
            var e: i64 = 0
            while e < neg_exp {
                result = result / 2.0
                e = e + 1
            }
        }
    }

    if sign_bit == 1 { result = 0.0 - result }
    result
}

pub fn read_f64(buf: [i8; 131072], pos: i64) -> (f64, i64) with Mut, Panic, Div {
    let pair = read_i64(buf, pos)
    let bits = pair.0
    let next_pos = pair.1
    (ieee754_bits_to_f64(bits), next_pos)
}

pub fn read_name(buf: [i8; 131072], pos: i64) -> (Name, i64) with Mut, Panic, Div {
    if pos < 0 || pos + SOIR_NAME_SIZE > SOIR_READ_LIMIT {
        SOIR_READ_FAILED = true
        return (Name { buf: [0; 128], len: 0 }, pos)
    }
    let len_pair = read_i64(buf, pos)
    let len = len_pair.0
    var p = len_pair.1

    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < 128 {
        n.buf[i] = buf[p + i]
        i = i + 1
    }
    (n, p + 128)
}

pub fn write_compare_op(buf: [i8; 131072], pos: i64, op: CompareOp) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        CompareOp::CmpLt => 0,
        CompareOp::CmpLe => 1,
        CompareOp::CmpEq => 2,
        CompareOp::CmpGe => 3,
        CompareOp::CmpGt => 4,
    }
    write_i8(buf, pos, tag)
}

pub fn read_compare_op(buf: [i8; 131072], pos: i64) -> (CompareOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { CompareOp::CmpLt }
        else if tag == 1 { CompareOp::CmpLe }
        else if tag == 2 { CompareOp::CmpEq }
        else if tag == 3 { CompareOp::CmpGe }
        else { CompareOp::CmpGt }
    (op, next_pos)
}

pub fn write_opcode(buf: [i8; 131072], pos: i64, op: IrOpcode) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
        IrOpcode::IrCallSret => 35,
        IrOpcode::IrReturnSret => 36,
        // SOIR v5 has no stable wire tags for later opcodes. Mark the whole
        // serialization failed; tag 18 is only a placeholder in the private
        // scratch buffer and can never be published while this flag is set.
        _ => {
            SOIR_WRITE_FAILED = true
            18
        },
    }
    write_i8(buf, pos, tag)
}

pub fn read_opcode(buf: [i8; 131072], pos: i64) -> (IrOpcode, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { IrOpcode::IrLoadImm }
        else if tag == 1 { IrOpcode::IrLoadFloat }
        else if tag == 2 { IrOpcode::IrLoadBool }
        else if tag == 3 { IrOpcode::IrLoadString }
        else if tag == 4 { IrOpcode::IrCopy }
        else if tag == 5 { IrOpcode::IrBinOp }
        else if tag == 6 { IrOpcode::IrUnaryOp }
        else if tag == 7 { IrOpcode::IrCall }
        else if tag == 8 { IrOpcode::IrReturn }
        else if tag == 9 { IrOpcode::IrJump }
        else if tag == 10 { IrOpcode::IrBranchTrue }
        else if tag == 11 { IrOpcode::IrBranchFalse }
        else if tag == 12 { IrOpcode::IrFieldGet }
        else if tag == 13 { IrOpcode::IrFieldSet }
        else if tag == 14 { IrOpcode::IrIndexGet }
        else if tag == 15 { IrOpcode::IrIndexSet }
        else if tag == 16 { IrOpcode::IrAlloc }
        else if tag == 17 { IrOpcode::IrLabel }
        else if tag == 18 { IrOpcode::IrNop }
        else if tag == 19 { IrOpcode::IrPhi }
        else if tag == 20 { IrOpcode::IrContest }
        else if tag == 21 { IrOpcode::IrProveRobust }
        else if tag == 22 { IrOpcode::IrValidated }
        else if tag == 23 { IrOpcode::IrLiftKnowledge }
        else if tag == 24 { IrOpcode::IrMeasure }
        else if tag == 25 { IrOpcode::IrAdmitAction }
        else if tag == 26 { IrOpcode::IrDeferAction }
        else if tag == 27 { IrOpcode::IrPlanAcquisition }
        else if tag == 28 { IrOpcode::IrPlanRecourse }
        else if tag == 29 { IrOpcode::IrProposeAlternatives }
        else if tag == 30 { IrOpcode::IrCommitAlternative }
        else if tag == 31 { IrOpcode::IrObserveTransition }
        else if tag == 32 { IrOpcode::IrRollbackTransition }
        else if tag == 33 { IrOpcode::IrDebugGuard }
        else if tag == 34 { IrOpcode::IrProfCounter }
        else if tag == 35 { IrOpcode::IrCallSret }
        else if tag == 36 { IrOpcode::IrReturnSret }
        else { IrOpcode::IrNop }
    (op, next_pos)
}

pub fn write_binary_op(buf: [i8; 131072], pos: i64, op: BinaryOp) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
    write_i8(buf, pos, tag)
}

pub fn read_binary_op(buf: [i8; 131072], pos: i64) -> (BinaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { BinaryOp::OpAdd }
        else if tag == 1 { BinaryOp::OpSub }
        else if tag == 2 { BinaryOp::OpMul }
        else if tag == 3 { BinaryOp::OpDiv }
        else if tag == 4 { BinaryOp::OpRem }
        else if tag == 5 { BinaryOp::OpEq }
        else if tag == 6 { BinaryOp::OpNe }
        else if tag == 7 { BinaryOp::OpLt }
        else if tag == 8 { BinaryOp::OpLe }
        else if tag == 9 { BinaryOp::OpGt }
        else if tag == 10 { BinaryOp::OpGe }
        else if tag == 11 { BinaryOp::OpAnd }
        else if tag == 12 { BinaryOp::OpOr }
        else if tag == 13 { BinaryOp::OpBitAnd }
        else if tag == 14 { BinaryOp::OpBitOr }
        else if tag == 15 { BinaryOp::OpBitXor }
        else if tag == 16 { BinaryOp::OpShl }
        else if tag == 17 { BinaryOp::OpShr }
        else if tag == 18 { BinaryOp::OpConcat }
        else if tag == 19 { BinaryOp::OpRange }
        else { BinaryOp::OpRangeInclusive }
    (op, next_pos)
}

pub fn write_unary_op(buf: [i8; 131072], pos: i64, op: UnaryOp) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
    write_i8(buf, pos, tag)
}

pub fn read_unary_op(buf: [i8; 131072], pos: i64) -> (UnaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { UnaryOp::OpNeg }
        else if tag == 1 { UnaryOp::OpNot }
        else if tag == 2 { UnaryOp::OpRef }
        else if tag == 3 { UnaryOp::OpRefMut }
        else { UnaryOp::OpDeref }
    (op, next_pos)
}

pub fn serialize_ir_instr(buf: [i8; 131072], pos: i64, instr: IrInstr) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos

    let op_pair = write_opcode(b, p, instr.op)
    b = op_pair.0
    p = op_pair.1
    p = p + 7  // 7-byte padding for alignment

    let dst_pair = write_i64(b, p, instr.dst)
    b = dst_pair.0
    p = dst_pair.1
    let src1_pair = write_i64(b, p, instr.src1)
    b = src1_pair.0
    p = src1_pair.1
    let src2_pair = write_i64(b, p, instr.src2)
    b = src2_pair.0
    p = src2_pair.1

    let imm_i64_pair = write_i64(b, p, instr.imm_i64)
    b = imm_i64_pair.0
    p = imm_i64_pair.1

    let imm_f64_pair = write_f64(b, p, instr.imm_f64)
    b = imm_f64_pair.0
    p = imm_f64_pair.1

    let label_id_pair = write_i64(b, p, instr.label_id)
    b = label_id_pair.0
    p = label_id_pair.1
    let fn_id_pair = write_i64(b, p, instr.fn_id)
    b = fn_id_pair.0
    p = fn_id_pair.1
    let field_idx_pair = write_i64(b, p, instr.field_idx)
    b = field_idx_pair.0
    p = field_idx_pair.1

    let bin_op_pair = write_binary_op(b, p, instr.bin_op)
    b = bin_op_pair.0
    p = bin_op_pair.1
    p = p + 7  // 7-byte padding

    let un_op_pair = write_unary_op(b, p, instr.un_op)
    b = un_op_pair.0
    p = un_op_pair.1
    p = p + 7  // 7-byte padding

    let name_pair = write_name(b, p, instr.name)
    b = name_pair.0
    p = name_pair.1

    let arg_count_pair = write_i64(b, p, instr.arg_count)
    b = arg_count_pair.0
    p = arg_count_pair.1
    // Note: call_args linked list is NOT serialized (reconstructed from arg_count)

    (b, p)
}

pub fn deserialize_ir_instr(buf: [i8; 131072], pos: i64) -> (IrInstr, i64) with Mut, Panic, Div {
    var p = pos
    let op_pair = read_opcode(buf, p)
    let op = op_pair.0
    p = op_pair.1 + 7  // skip padding

    let dst_pair = read_i64(buf, p)
    let dst = dst_pair.0
    p = dst_pair.1

    let src1_pair = read_i64(buf, p)
    let src1 = src1_pair.0
    p = src1_pair.1

    let src2_pair = read_i64(buf, p)
    let src2 = src2_pair.0
    p = src2_pair.1

    let imm_i64_pair = read_i64(buf, p)
    let imm_i64 = imm_i64_pair.0
    p = imm_i64_pair.1

    let imm_f64_pair = read_f64(buf, p)
    let imm_f64 = imm_f64_pair.0
    p = imm_f64_pair.1

    let label_id_pair = read_i64(buf, p)
    let label_id = label_id_pair.0
    p = label_id_pair.1

    let fn_id_pair = read_i64(buf, p)
    let fn_id = fn_id_pair.0
    p = fn_id_pair.1

    let field_idx_pair = read_i64(buf, p)
    let field_idx = field_idx_pair.0
    p = field_idx_pair.1

    let bin_op_pair = read_binary_op(buf, p)
    let bin_op = bin_op_pair.0
    p = bin_op_pair.1 + 7  // skip padding

    let un_op_pair = read_unary_op(buf, p)
    let un_op = un_op_pair.0
    p = un_op_pair.1 + 7  // skip padding

    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1

    let arg_count_pair = read_i64(buf, p)
    let arg_count = arg_count_pair.0
    p = arg_count_pair.1

    let instr = IrInstr {
        op: op,
        dst: dst,
        src1: src1,
        src2: src2,
        imm_i64: imm_i64,
        imm_f64: imm_f64,
        label_id: label_id,
        fn_id: fn_id,
        field_idx: field_idx,
        imm_flags: 0,
        bin_op: bin_op,
        un_op: un_op,
        name: name,
        call_args: None,  // Not serialized
        arg_count: arg_count,
    }
    (instr, p)
}

pub fn serialize_ir_function(buf: [i8; 131072], pos: i64, func: &IrFunction) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos

    let name_pair = write_name(b, p, (*func).name)
    b = name_pair.0
    p = name_pair.1
    let instr_count_pair = write_i64(b, p, (*func).instr_count)
    b = instr_count_pair.0
    p = instr_count_pair.1
    let reg_count_pair = write_i64(b, p, (*func).reg_count)
    b = reg_count_pair.0
    p = reg_count_pair.1
    let label_count_pair = write_i64(b, p, (*func).label_count)
    b = label_count_pair.0
    p = label_count_pair.1
    let param_count_pair = write_i64(b, p, (*func).param_count)
    b = param_count_pair.0
    p = param_count_pair.1

    // Write param_regs array
    var i: i64 = 0
    while i < 64 {
        let reg_pair = write_i64(b, p, (*func).param_regs[i as usize])
        b = reg_pair.0
        p = reg_pair.1
        i = i + 1
    }

    // Sprint 38: Write compile strategy
    let strategy_pair = write_i64(b, p, (*func).compile_strategy)
    b = strategy_pair.0
    p = strategy_pair.1

    // Sprint 44: Write prof_counter_id
    let prof_ctr_pair = write_i64(b, p, (*func).prof_counter_id)
    b = prof_ctr_pair.0
    p = prof_ctr_pair.1

    if SOIR_VERSION >= 3 {
        let hyper_alg_pair = write_i64(b, p, (*func).hyper_algebra_kind)
        b = hyper_alg_pair.0
        p = hyper_alg_pair.1
    }

    if SOIR_VERSION >= 5 {
        let defining_module_pair = write_i64(b, p, (*func).defining_module_id)
        b = defining_module_pair.0
        p = defining_module_pair.1
    }

    // Write instructions
    var j: i64 = 0
    while j < (*func).instr_count {
        let instr_pair = serialize_ir_instr(b, p, (*func).instrs[j as usize])
        b = instr_pair.0
        p = instr_pair.1
        j = j + 1
    }

    (b, p)
}

pub fn deserialize_ir_function_into(buf: [i8; 131072], pos: i64, version: i8, out: &! IrFunction) -> (i64, bool) with Mut, Panic, Div {
    let header_size = if version >= 5 {
        SOIR_FUNCTION_HEADER_V5_SIZE
    } else if version >= 3 {
        SOIR_FUNCTION_HEADER_V3_SIZE
    } else {
        SOIR_FUNCTION_HEADER_V1_SIZE
    }
    if pos < 0 || pos + header_size > SOIR_READ_LIMIT {
        SOIR_READ_FAILED = true
        return (pos, false)
    }

    var p = pos
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1
    if name.len < 0 || name.len > 128 {
        return (p, false)
    }

    let instr_count_pair = read_i64(buf, p)
    let instr_count = instr_count_pair.0
    p = instr_count_pair.1

    if instr_count < 0 || instr_count > IR_MAX_INSTRS {
        return (p, false)
    }

    let reg_count_pair = read_i64(buf, p)
    let reg_count = reg_count_pair.0
    p = reg_count_pair.1

    let label_count_pair = read_i64(buf, p)
    let label_count = label_count_pair.0
    p = label_count_pair.1

    let param_count_pair = read_i64(buf, p)
    let param_count = param_count_pair.0
    p = param_count_pair.1

    // Read param_regs array
    var i: i64 = 0
    while i < 64 {
        let reg_pair = read_i64(buf, p)
        (*out).param_regs[i as usize] = reg_pair.0
        p = reg_pair.1
        i = i + 1
    }

    // Sprint 38: Read compile strategy
    let strategy_pair = read_i64(buf, p)
    let compile_strategy = strategy_pair.0
    p = strategy_pair.1

    // Sprint 44: Read prof_counter_id
    let prof_ctr_pair = read_i64(buf, p)
    let prof_counter_id = prof_ctr_pair.0
    p = prof_ctr_pair.1

    var hyper_algebra_kind: i64 = -1
    if version >= 3 {
        let hyper_alg_pair = read_i64(buf, p)
        hyper_algebra_kind = hyper_alg_pair.0
        p = hyper_alg_pair.1
    }

    var defining_module_id: i64 = IR_DEFINING_MODULE_UNKNOWN
    if version >= 5 {
        let defining_module_pair = read_i64(buf, p)
        defining_module_id = defining_module_pair.0
        p = defining_module_pair.1
    }

    if p < 0 || instr_count > (SOIR_READ_LIMIT - p) / SOIR_INSTR_SIZE {
        SOIR_READ_FAILED = true
        return (p, false)
    }

    // Commit scalar metadata, but publish instr_count only after the complete
    // body has decoded. Callers keep fn_count at zero until every function and
    // string succeeds, so a partial destination is never observable as valid.
    (*out).name = name
    (*out).defining_module_id = defining_module_id
    (*out).instr_count = 0
    (*out).reg_count = reg_count
    (*out).label_count = label_count
    (*out).param_count = param_count
    (*out).compile_strategy = compile_strategy
    (*out).returns_float = 0
    (*out).return_struct_name = ir_empty_name()
    (*out).prof_counter_id = prof_counter_id
    (*out).hyper_algebra_kind = hyper_algebra_kind
    (*out).is_sret = 0
    (*out).sret_dest_reg = -1
    (*out).bss_size = 0

    var j: i64 = 0
    while j < instr_count {
        let instr_pair = deserialize_ir_instr(buf, p)
        if SOIR_READ_FAILED {
            return (p, false)
        }
        (*out).instrs[j as usize] = instr_pair.0
        p = instr_pair.1
        j = j + 1
    }

    (*out).instr_count = instr_count
    (p, true)
}

// The bounded heap bridge uses the canonical v5/v4 prefix while requiring all
// extension sections to be empty. The general serializer remains authoritative
// for modules carrying epistemic, algebra, or claim payloads.
pub let SOIR_EMPTY_EXTENSION_COUNT_FIELDS: i64 = 36
pub let SOIR_CORE_SERIALIZE_OK: i64 = 0
pub let SOIR_CORE_SERIALIZE_COUNTS_BOUNDS: i64 = -1
pub let SOIR_CORE_SERIALIZE_MODULE_CONTRACT: i64 = -2
pub let SOIR_CORE_SERIALIZE_ENVELOPE_CAPACITY: i64 = -3
pub let SOIR_CORE_SERIALIZE_FUNCTION_INSTR: i64 = -4
pub let SOIR_CORE_SERIALIZE_STRING: i64 = -5
pub let SOIR_CORE_SERIALIZE_FINAL_PUBLISH: i64 = -6

fn soir_core_module_has_empty_extensions(module: &IrModule) -> bool {
    let epistemic = (*module).epistemic
    let algebras = (*module).algebras
    algebras.count == 0 &&
        epistemic.model_family_count == 0 &&
        epistemic.policy_count == 0 &&
        epistemic.decision_policy_count == 0 &&
        epistemic.deferral_policy_count == 0 &&
        epistemic.acquisition_policy_count == 0 &&
        epistemic.recourse_policy_count == 0 &&
        epistemic.validation_count == 0 &&
        epistemic.mechanistic_report_count == 0 &&
        epistemic.posterior_weights_count == 0 &&
        epistemic.counterexample_count == 0 &&
        epistemic.audit_count == 0 &&
        epistemic.contest_count == 0 &&
        epistemic.contest_witness_count == 0 &&
        epistemic.robust_proof_count == 0 &&
        epistemic.validated_manifest_count == 0 &&
        epistemic.decision_certificate_count == 0 &&
        epistemic.deferred_certificate_count == 0 &&
        epistemic.deferred_reason_witness_count == 0 &&
        epistemic.acquisition_plan_count == 0 &&
        epistemic.acquisition_reason_witness_count == 0 &&
        epistemic.recourse_plan_count == 0 &&
        epistemic.recourse_reason_witness_count == 0 &&
        epistemic.alternative_policy_count == 0 &&
        epistemic.alternative_frontier_count == 0 &&
        epistemic.alternative_candidate_count == 0 &&
        epistemic.alternative_set_count == 0 &&
        epistemic.alternative_reason_witness_count == 0 &&
        epistemic.transition_policy_count == 0 &&
        epistemic.transition_protocol_count == 0 &&
        epistemic.transition_step_count == 0 &&
        epistemic.transition_plan_count == 0 &&
        epistemic.transition_reason_witness_count == 0 &&
        epistemic.monitoring_policy_count == 0 &&
        epistemic.observed_transition_count == 0 &&
        epistemic.rollback_certificate_count == 0 &&
        epistemic.hyper_expr_count == 0
}

fn soir_core_empty_extensions_preflight_status(module: &IrModule) -> i64 with Mut, Panic, Div {
    if (*module).fn_count < 0 || (*module).fn_count > IR_MAX_FUNCS ||
       (*module).string_count < 0 || (*module).string_count > IR_MAX_STRINGS {
        return SOIR_CORE_SERIALIZE_COUNTS_BOUNDS
    }
    if !soir_core_module_has_empty_extensions(module) || (*module).bss_total_size != 0 {
        return SOIR_CORE_SERIALIZE_MODULE_CONTRACT
    }

    var required: i64 = 16
    var i: i64 = 0
    while i < (*module).fn_count {
        let function = (*module).functions[i as usize]
        if function.instr_count < 0 || function.instr_count > IR_MAX_INSTRS {
            return SOIR_CORE_SERIALIZE_COUNTS_BOUNDS
        }
        if function.bss_size != 0 { return SOIR_CORE_SERIALIZE_MODULE_CONTRACT }
        required = required + SOIR_FUNCTION_HEADER_V5_SIZE + function.instr_count * SOIR_INSTR_SIZE
        if required > SOIR_MAX_SIZE { return SOIR_CORE_SERIALIZE_ENVELOPE_CAPACITY }
        i = i + 1
    }

    required = required + 8 + (*module).string_count * SOIR_NAME_SIZE
    required = required + SOIR_EMPTY_EXTENSION_COUNT_FIELDS * 8 + 8
    if required > SOIR_MAX_SIZE { return SOIR_CORE_SERIALIZE_ENVELOPE_CAPACITY }
    SOIR_CORE_SERIALIZE_OK
}

fn soir_core_write_i8_into(out_buf: &![i8; 131072], pos: i64, value: i8) -> i64 with Mut, Panic, Div {
    if pos < 0 || pos >= SOIR_MAX_SIZE {
        SOIR_WRITE_FAILED = true
        return SOIR_INVALID_POS
    }
    out_buf[pos] = value
    pos + 1
}

fn soir_core_write_i64_into(out_buf: &![i8; 131072], pos: i64, value: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    var shift: i64 = 0
    while shift < 64 {
        p = soir_core_write_i8_into(out_buf, p, ((value >> shift) & 255) as i8)
        shift = shift + 8
    }
    p
}

fn soir_core_write_f64_into(out_buf: &![i8; 131072], pos: i64, value: f64) -> i64 with Mut, Panic, Div {
    soir_core_write_i64_into(out_buf, pos, f64_to_bits(value))
}

fn soir_core_write_name_into(out_buf: &![i8; 131072], pos: i64, name: &Name) -> i64 with Mut, Panic, Div {
    if pos < 0 || pos + SOIR_NAME_SIZE > SOIR_MAX_SIZE {
        SOIR_WRITE_FAILED = true
        return SOIR_INVALID_POS
    }
    var p = soir_core_write_i64_into(out_buf, pos, (*name).len)
    var i: i64 = 0
    while i < 128 {
        out_buf[p + i] = (*name).buf[i]
        i = i + 1
    }
    p + 128
}

fn soir_core_write_padding_into(out_buf: &![i8; 131072], pos: i64, count: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    var i: i64 = 0
    while i < count {
        p = soir_core_write_i8_into(out_buf, p, 0 as i8)
        i = i + 1
    }
    p
}

fn soir_core_write_opcode_into(out_buf: &![i8; 131072], pos: i64, op: IrOpcode) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
        IrOpcode::IrCallSret => 35,
        IrOpcode::IrReturnSret => 36,
        _ => {
            SOIR_WRITE_FAILED = true
            18
        },
    }
    soir_core_write_i8_into(out_buf, pos, tag)
}

fn soir_core_write_binary_op_into(out_buf: &![i8; 131072], pos: i64, op: BinaryOp) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
    soir_core_write_i8_into(out_buf, pos, tag)
}

fn soir_core_write_unary_op_into(out_buf: &![i8; 131072], pos: i64, op: UnaryOp) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
    soir_core_write_i8_into(out_buf, pos, tag)
}

fn soir_core_serialize_ir_instr_into(out_buf: &![i8; 131072], pos: i64, instr: &IrInstr) -> i64 with Mut, Panic, Div {
    var p = soir_core_write_opcode_into(out_buf, pos, (*instr).op)
    p = soir_core_write_padding_into(out_buf, p, 7)
    p = soir_core_write_i64_into(out_buf, p, (*instr).dst)
    p = soir_core_write_i64_into(out_buf, p, (*instr).src1)
    p = soir_core_write_i64_into(out_buf, p, (*instr).src2)
    p = soir_core_write_i64_into(out_buf, p, (*instr).imm_i64)
    p = soir_core_write_f64_into(out_buf, p, (*instr).imm_f64)
    p = soir_core_write_i64_into(out_buf, p, (*instr).label_id)
    p = soir_core_write_i64_into(out_buf, p, (*instr).fn_id)
    p = soir_core_write_i64_into(out_buf, p, (*instr).field_idx)
    p = soir_core_write_binary_op_into(out_buf, p, (*instr).bin_op)
    p = soir_core_write_padding_into(out_buf, p, 7)
    p = soir_core_write_unary_op_into(out_buf, p, (*instr).un_op)
    p = soir_core_write_padding_into(out_buf, p, 7)
    let name = (*instr).name
    p = soir_core_write_name_into(out_buf, p, &name)
    soir_core_write_i64_into(out_buf, p, (*instr).arg_count)
}

fn soir_core_serialize_ir_function_into(out_buf: &![i8; 131072], pos: i64, function: &IrFunction) -> i64 with Mut, Panic, Div {
    let name = (*function).name
    var p = soir_core_write_name_into(out_buf, pos, &name)
    p = soir_core_write_i64_into(out_buf, p, (*function).instr_count)
    p = soir_core_write_i64_into(out_buf, p, (*function).reg_count)
    p = soir_core_write_i64_into(out_buf, p, (*function).label_count)
    p = soir_core_write_i64_into(out_buf, p, (*function).param_count)

    var i: i64 = 0
    while i < 64 {
        p = soir_core_write_i64_into(out_buf, p, (*function).param_regs[i as usize])
        i = i + 1
    }
    p = soir_core_write_i64_into(out_buf, p, (*function).compile_strategy)
    p = soir_core_write_i64_into(out_buf, p, (*function).prof_counter_id)
    if SOIR_VERSION >= 3 {
        p = soir_core_write_i64_into(out_buf, p, (*function).hyper_algebra_kind)
    }
    if SOIR_VERSION >= 5 {
        p = soir_core_write_i64_into(out_buf, p, (*function).defining_module_id)
    }

    var j: i64 = 0
    while j < (*function).instr_count {
        let instr = (*function).instrs[j as usize]
        p = soir_core_serialize_ir_instr_into(out_buf, p, &instr)
        j = j + 1
    }
    p
}

// Returns the positive serialized length on success or one of the negative
// SOIR_CORE_SERIALIZE_* categories on failure. Keeping length in the scalar
// result avoids forwarding a mutable scalar beside the 128 KiB buffer copy.
pub fn soir_core_serialize_ir_module_empty_extensions_result_into(
    module: &IrModule,
    out_buf: &![i8; 131072],
) -> i64 with Mut, Panic, Div, Alloc {
    var pos: i64 = 0
    SOIR_WRITE_FAILED = false

    let preflight_status = soir_core_empty_extensions_preflight_status(module)
    if preflight_status != SOIR_CORE_SERIALIZE_OK { return preflight_status }

    out_buf[0] = 83 as i8
    out_buf[1] = 79 as i8
    out_buf[2] = 73 as i8
    out_buf[3] = 82 as i8
    out_buf[4] = SOIR_VERSION
    out_buf[5] = 0 as i8
    out_buf[6] = 0 as i8
    out_buf[7] = 0 as i8
    pos = 8

    pos = soir_core_write_i64_into(out_buf, pos, (*module).fn_count)
    if SOIR_WRITE_FAILED { return SOIR_CORE_SERIALIZE_ENVELOPE_CAPACITY }

    var i: i64 = 0
    while i < (*module).fn_count {
        let function = (*module).functions[i as usize]
        pos = soir_core_serialize_ir_function_into(out_buf, pos, &function)
        if SOIR_WRITE_FAILED { return SOIR_CORE_SERIALIZE_FUNCTION_INSTR }
        i = i + 1
    }

    pos = soir_core_write_i64_into(out_buf, pos, (*module).string_count)
    if SOIR_WRITE_FAILED { return SOIR_CORE_SERIALIZE_STRING }

    var j: i64 = 0
    while j < (*module).string_count {
        let name = (*module).string_table[j as usize]
        pos = soir_core_write_name_into(out_buf, pos, &name)
        if SOIR_WRITE_FAILED { return SOIR_CORE_SERIALIZE_STRING }
        j = j + 1
    }

    var extension_count_index: i64 = 0
    while extension_count_index < SOIR_EMPTY_EXTENSION_COUNT_FIELDS {
        pos = soir_core_write_i64_into(out_buf, pos, 0)
        if SOIR_WRITE_FAILED { return SOIR_CORE_SERIALIZE_FINAL_PUBLISH }
        extension_count_index = extension_count_index + 1
    }

    // IrAlgebraTable.count follows the epistemic section in SOIR v3+.
    pos = soir_core_write_i64_into(out_buf, pos, 0)

    if SOIR_WRITE_FAILED || pos < 0 || pos > SOIR_MAX_SIZE {
        return SOIR_CORE_SERIALIZE_FINAL_PUBLISH
    }
    pos
}

fn soir_core_read_empty_extensions(buf: [i8; 131072], pos: i64) -> (i64, bool) with Mut, Panic, Div {
    var p = pos
    var extension_count_index: i64 = 0
    while extension_count_index < SOIR_EMPTY_EXTENSION_COUNT_FIELDS {
        let count_pair = read_i64(buf, p)
        if SOIR_READ_FAILED || count_pair.0 != 0 { return (p, false) }
        p = count_pair.1
        extension_count_index = extension_count_index + 1
    }

    let algebra_count = read_i64(buf, p)
    if SOIR_READ_FAILED || algebra_count.0 != 0 { return (p, false) }
    (algebra_count.1, true)
}

fn soir_core_publish_empty_extensions(out: &! IrModule) with Mut {
    (*out).epistemic.model_family_count = 0
    (*out).epistemic.policy_count = 0
    (*out).epistemic.decision_policy_count = 0
    (*out).epistemic.deferral_policy_count = 0
    (*out).epistemic.acquisition_policy_count = 0
    (*out).epistemic.recourse_policy_count = 0
    (*out).epistemic.validation_count = 0
    (*out).epistemic.mechanistic_report_count = 0
    (*out).epistemic.posterior_weights_count = 0
    (*out).epistemic.counterexample_count = 0
    (*out).epistemic.audit_count = 0
    (*out).epistemic.contest_count = 0
    (*out).epistemic.contest_witness_count = 0
    (*out).epistemic.robust_proof_count = 0
    (*out).epistemic.validated_manifest_count = 0
    (*out).epistemic.decision_certificate_count = 0
    (*out).epistemic.deferred_certificate_count = 0
    (*out).epistemic.deferred_reason_witness_count = 0
    (*out).epistemic.acquisition_plan_count = 0
    (*out).epistemic.acquisition_reason_witness_count = 0
    (*out).epistemic.recourse_plan_count = 0
    (*out).epistemic.recourse_reason_witness_count = 0
    (*out).epistemic.alternative_policy_count = 0
    (*out).epistemic.alternative_frontier_count = 0
    (*out).epistemic.alternative_candidate_count = 0
    (*out).epistemic.alternative_set_count = 0
    (*out).epistemic.alternative_reason_witness_count = 0
    (*out).epistemic.transition_policy_count = 0
    (*out).epistemic.transition_protocol_count = 0
    (*out).epistemic.transition_step_count = 0
    (*out).epistemic.transition_plan_count = 0
    (*out).epistemic.transition_reason_witness_count = 0
    (*out).epistemic.monitoring_policy_count = 0
    (*out).epistemic.observed_transition_count = 0
    (*out).epistemic.rollback_certificate_count = 0
    (*out).epistemic.hyper_expr_count = 0
    (*out).algebras.count = 0
}

fn soir_core_deserialize_ir_module_empty_extensions_impl(
    buf: [i8; 131072],
    len: i64,
    out: &! IrModule,
    materialize_functions: bool,
) -> bool with Mut, Panic, Div, Alloc {
    var pos: i64 = 0
    (*out).fn_count = 0
    (*out).string_count = 0
    (*out).bss_total_size = 0

    if len < 8 || len > SOIR_MAX_SIZE { return false }
    SOIR_READ_LIMIT = len
    SOIR_READ_FAILED = false

    let magic_ok = buf[0] == 83 as i8 &&
        buf[1] == 79 as i8 &&
        buf[2] == 73 as i8 &&
        buf[3] == 82 as i8
    if !magic_ok { return false }

    let version = buf[4]
    if version != 4 as i8 && version != SOIR_VERSION { return false }
    pos = 8

    let fn_count_pair = read_i64(buf, pos)
    let fn_count = fn_count_pair.0
    pos = fn_count_pair.1
    if SOIR_READ_FAILED || fn_count < 0 || fn_count > IR_MAX_FUNCS { return false }

    var i: i64 = 0
    while i < fn_count {
        if materialize_functions {
            // Decode through a local canonical lvalue and publish exactly once
            // after the complete function validates. Raw->array->field writes
            // can otherwise mutate a lowered temporary instead of the handle
            // installed in the heap reservation.
            var materialized_function = ir_empty_function()
            let materialized_pair = deserialize_ir_function_into(buf, pos, version, &! materialized_function)
            if !materialized_pair.1 || SOIR_READ_FAILED { return false }
            (*out).functions[i as usize] = materialized_function
            pos = materialized_pair.0
        } else {
            // Ordinary initialized callers retain and mutate their existing
            // function handles; only raw heap reservations need publication.
            let initialized_pair = deserialize_ir_function_into(buf, pos, version, &! (*out).functions[i as usize])
            if !initialized_pair.1 || SOIR_READ_FAILED { return false }
            pos = initialized_pair.0
        }
        i = i + 1
    }

    let string_count_pair = read_i64(buf, pos)
    let string_count = string_count_pair.0
    pos = string_count_pair.1
    if SOIR_READ_FAILED || string_count < 0 || string_count > IR_MAX_STRINGS ||
       pos < 0 || string_count > (SOIR_READ_LIMIT - pos) / SOIR_NAME_SIZE {
        return false
    }

    var j: i64 = 0
    while j < string_count {
        let name_pair = read_name(buf, pos)
        if SOIR_READ_FAILED || name_pair.0.len < 0 || name_pair.0.len > 128 {
            return false
        }
        (*out).string_table[j as usize] = name_pair.0
        pos = name_pair.1
        j = j + 1
    }

    let extensions = soir_core_read_empty_extensions(buf, pos)
    if !extensions.1 || SOIR_READ_FAILED { return false }
    pos = extensions.0
    if pos > len { return false }

    soir_core_publish_empty_extensions(out)
    (*out).fn_count = fn_count
    (*out).string_count = string_count
    true
}

pub fn soir_core_deserialize_ir_module_empty_extensions_into(
    buf: [i8; 131072],
    len: i64,
    out: &! IrModule,
) -> bool with Mut, Panic, Div, Alloc {
    soir_core_deserialize_ir_module_empty_extensions_impl(buf, len, out, false)
}

// Heap-specific entrypoint: raw IrModule reservations contain null aggregate
// function slots until the compiler runtime installs their canonical handles.
pub fn soir_core_deserialize_ir_module_empty_extensions_materialized_into(
    buf: [i8; 131072],
    len: i64,
    out: &! IrModule,
) -> bool with Mut, Panic, Div, Alloc {
    soir_core_deserialize_ir_module_empty_extensions_impl(buf, len, out, true)
}
