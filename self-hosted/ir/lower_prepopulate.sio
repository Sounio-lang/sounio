// self-hosted::ir::lower_prepop
//
// Pre-population wrapper for the Lowerer. Uses the flat-owned summary approach
// to correctly set fn_count and function metadata before body lowering.
//
// This sidesteps the JIT &! Box mutation bug:
//   (*lo.module).fn_count = N         -- silently lost (store hits param stack slot)
//   ir_fn_set(&! (*lo.module), i, f     -- silently lost)
//
// The flat-owned approach builds a local IrModule (1-level writes only), then
// wraps it via Box::new — all reads/writes through Box are correct after that.
//
// Usage:
//   let lo = lowerer_prepopulate_from_program_ref(&prog, epistemic)
//   let lo2 = lo.lower_program_bodies_ref(&prog.items)
//   // lo2.module.fn_count is correct; all function bodies are flushed

