// Create a Lowerer pre-populated with correct fn_count, param_count, compile_strategy
// and function names. Ready to accept lower_program_bodies_ref without needing
// preseed_program_items_ref (which is broken under JIT for the fn_count writes).
fn lowerer_prepopulate_from_program_ref(
    prog: &Program,
    epistemic: IrEpistemicSection
) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(prog, epistemic)
    lowerer_new_from_program_summary_flat(&summary_result.summary, epistemic)
}

// Convenience: pre-populate with empty epistemic section.
fn lowerer_prepopulate_from_program_plain_ref(prog: &Program) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    lowerer_prepopulate_from_program_ref(prog, ir_empty_epistemic_section())
}
