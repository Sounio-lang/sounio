// self-hosted::ir::reach_self_test_runner
//
// Executes the self-tests for ir::reachability and reports results.
//
// Tests:
//   T1: reach_name_is_main recognises "main"
//   T2: reach_name_is_main rejects non-"main" names
//   T3: reach_build_remap produces correct old→new index table
//   T4: reach_compact_module reduces fn_count and preserves order
//
// Run with:
//   souc run self-hosted/ir/reach_self_test_runner.sio
//
// Sprint 130: runnable self-test harness for reachability pass.

use ir::reachability::*
use ir::ir::*
use parser::ast::*

fn main() -> i64 with IO, Mut, Panic, Div {
    print("reach_self_test: running\n")
    let failures = reach_run_self_tests()
    if failures == 0 {
        print("reach_self_test: ALL PASS\n")
        0
    } else {
        print("reach_self_test: FAIL failures=")
        print_int(failures)
        print("\n")
        1
    }
}
