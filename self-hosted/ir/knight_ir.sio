// Synthesized IR runtime for named Knightian uncertainty affine forms (EPI-006 step 3b).
//
// Emitted lazily into an IrModule only when a program uses `knight(...)`,
// Knowledge binary arithmetic, or `.iv`. Works identically on single-module
// and multi-module lowering paths (each helper is deduplicated by name in
// the IrModule).
//
// Runtime layout:
//   Knowledge handle (ir_alloc(dst, 0), 64 word slots, zero-initialized):
//     slot 0: value (f64)
//     slot 1: variance (f64)
//     slot 2: confidence (f64)
//     slot 3: provenance (ptr)
//     slot 63: knight_af (array handle, or 0 for pure-aleatory / deterministic Knowledge;
//              outside ASCII ident hash range 1..58 and positional literal indices, leaving
//              the pinned 5-name/4-slot Knowledge layout in T404/T468 untouched)
//
//   KnightAffine array handle (ir_alloc_array(reg, 2592, 324), 324 words):
//     word 0: c (f64)          constant term
//     word 1: n (i64)          active term count (0..64)
//     word 2: rad_extra (f64)  extra outward-rounded symmetric radius (>= 0.0)
//     word 3: vacuous (i64)    1 iff interval is [-inf, +inf] (fail-closed non-certificate)
//     term t (0 <= t < n) at word 4 + t*5:
//       +0: name_ptr (i64)     pointer to NUL-terminated source name, or 0 if anonymous
//       +1: anon_id (i64)      0 if named, unique >0 if anonymous remainder symbol
//       +2: coeff (f64)        affine coefficient
//       +3: lo (f64)           source lower bound (-1.0 for anonymous)
//       +4: hi (f64)           source upper bound (+1.0 for anonymous)
//
// Fail-closed certificate guarantees:
//   - Source bounds are validated finite and ordered (lo <= hi) at construction
//     and before any term match; a named match with differing bounds marks the
//     result vacuous [-inf, +inf] before any coefficient addition or cancellation.
//   - All directed rounding and error-bound helpers guard non-finite, overflowing,
//     and underflowing binary64 states (never inf - inf = NaN, never swallowing NaN,
//     never dropping underflow residuals to [0, 0], never returning NaN or reversed iv).
//   - Linear ops (Add/Sub and exact-constant scaling) preserve exact symbolic
//     cancellation over named sources; nonlinear Mul/Div allocate a fresh anonymous
//     symbol for each Comba-Stolfi / min-range remainder.

module ir::knight_ir

use parser::ast::{BinaryOp, Name, make_name}
use ir::ir::*

// ============================================================================
// Low-level IrFunction builder helpers (mutating &! IrFunction in place)
// ============================================================================

fn kb_emit(f: &! IrFunction, instr: IrInstr) with Mut, Panic, Div {
    let _ = ir_region_push(&! (*f).region, instr)
    (*f).instr_count = (*f).instr_count + 1
}

fn kb_reg(f: &! IrFunction) -> i64 with Mut {
    let r = (*f).reg_count
    (*f).reg_count = r + 1
    r
}

fn kb_freg(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_lbl(f: &! IrFunction) -> i64 with Mut {
    let l = (*f).label_count
    (*f).label_count = l + 1
    l
}

fn kb_imm(f: &! IrFunction, v: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_load_imm(r, v))
    r
}

fn kb_fimm(f: &! IrFunction, v: f64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_load_float(r, v))
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_feta(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    // 2^-1074: exact IEEE 754 binary64 bit pattern 0x0000000000000001.
    let r = kb_reg(f)
    kb_emit(f, ir_load_imm(r, 1))
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_fdbl_max(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    // DBL_MAX = 1.7976931348623157e308: exact IEEE 754 bit pattern 0x7fefffffffffffff.
    let r = kb_reg(f)
    kb_emit(f, ir_load_imm(r, 9218868437227405311))
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_finf(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    // +inf: exact IEEE 754 bit pattern 0x7ff0000000000000.
    let r = kb_reg(f)
    kb_emit(f, ir_load_imm(r, 9218868437227405312))
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_fphi(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    // u * (1 + 2u) with u = 2^-53 (sound_enclosure.sio se_phi).
    kb_fimm(f, 1.1102230246251565e-16 * (1.0 + 2.220446049250313e-16))
}

fn kb_iop(f: &! IrFunction, a: i64, op: BinaryOp, b: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_binop(r, a, op, b))
    r
}

fn kb_fop(f: &! IrFunction, a: i64, op: BinaryOp, b: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_binop_typed(r, a, op, b, true, true))
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_fcmp(f: &! IrFunction, a: i64, op: BinaryOp, b: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_binop_typed(r, a, op, b, true, true))
    r
}

fn kb_is_finite(f: &! IrFunction, x: i64) -> i64 with Mut, Panic, Div {
    // True (1) iff x is a finite binary64 value: (x - x) == 0.0.
    // For +inf, -inf, and NaN, (x - x) is NaN and (NaN == 0.0) is 0.
    let d = kb_fop(f, x, BinaryOp::OpSub, x)
    let z = kb_fimm(f, 0.0)
    kb_fcmp(f, d, BinaryOp::OpEq, z)
}

fn kb_fneg(f: &! IrFunction, a: i64) -> i64 with Mut, Panic, Div {
    let z = kb_fimm(f, 0.0)
    kb_fop(f, z, BinaryOp::OpSub, a)
}

fn kb_fabs(f: &! IrFunction, a: i64) -> i64 with Mut, Panic, Div {
    let res = kb_freg(f)
    kb_emit(f, ir_copy(res, a))
    kb_emit(f, ir_mark_float_reg(res))
    let z = kb_fimm(f, 0.0)
    let is_neg = kb_fcmp(f, a, BinaryOp::OpLt, z)
    let l_done = kb_lbl(f)
    kb_emit(f, ir_branch_false(is_neg, l_done))
    let neg_a = kb_fop(f, z, BinaryOp::OpSub, a)
    kb_emit(f, ir_copy(res, neg_a))
    kb_emit(f, ir_label(l_done))
    res
}

fn kb_fmax(f: &! IrFunction, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    // NaN-propagating max: never swallows NaN in either operand.
    let res = kb_freg(f)
    kb_emit(f, ir_copy(res, a))
    kb_emit(f, ir_mark_float_reg(res))
    let gt = kb_fcmp(f, b, BinaryOp::OpGt, a)
    let l_set = kb_lbl(f)
    let l_chk_nan = kb_lbl(f)
    let l_done = kb_lbl(f)
    kb_emit(f, ir_branch_false(gt, l_chk_nan))
    kb_emit(f, ir_jump(l_set))
    kb_emit(f, ir_label(l_chk_nan))
    let b_eq = kb_fcmp(f, b, BinaryOp::OpEq, b)
    let zi = kb_imm(f, 0)
    let b_is_nan = kb_iop(f, b_eq, BinaryOp::OpEq, zi)
    kb_emit(f, ir_branch_false(b_is_nan, l_done))
    kb_emit(f, ir_label(l_set))
    kb_emit(f, ir_copy(res, b))
    kb_emit(f, ir_label(l_done))
    res
}

fn kb_safe_mid(f: &! IrFunction, lo: i64, hi: i64) -> i64 with Mut, Panic, Div {
    // Overflow-free and underflow-safe midpoint of finite [lo, hi]:
    //   if |lo| >= 1e300 or |hi| >= 1e300: (lo * 0.5) + (hi * 0.5)
    //   else:                               0.5 * (lo + hi)
    let res = kb_freg(f)
    let half = kb_fimm(f, 0.5)
    let big = kb_fimm(f, 1.0e300)
    let alo = kb_fabs(f, lo)
    let ahi = kb_fabs(f, hi)
    let l_big = kb_lbl(f)
    let l_c2 = kb_lbl(f)
    let l_small = kb_lbl(f)
    let l_done = kb_lbl(f)
    let c1 = kb_fcmp(f, alo, BinaryOp::OpGe, big)
    kb_emit(f, ir_branch_false(c1, l_c2))
    kb_emit(f, ir_jump(l_big))
    kb_emit(f, ir_label(l_c2))
    let c2 = kb_fcmp(f, ahi, BinaryOp::OpGe, big)
    kb_emit(f, ir_branch_false(c2, l_small))
    kb_emit(f, ir_label(l_big))
    let hlo = kb_fop(f, lo, BinaryOp::OpMul, half)
    let hhi = kb_fop(f, hi, BinaryOp::OpMul, half)
    let m_big = kb_fop(f, hlo, BinaryOp::OpAdd, hhi)
    kb_emit(f, ir_copy(res, m_big))
    kb_emit(f, ir_jump(l_done))
    kb_emit(f, ir_label(l_small))
    let sum = kb_fop(f, lo, BinaryOp::OpAdd, hi)
    let m_sm = kb_fop(f, half, BinaryOp::OpMul, sum)
    kb_emit(f, ir_copy(res, m_sm))
    kb_emit(f, ir_label(l_done))
    kb_emit(f, ir_mark_float_reg(res))
    res
}

fn kb_same_sign_pos(f: &! IrFunction, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    // For non-zero finite a, b: returns 1 iff a and b have the same sign (product > 0).
    let z = kb_fimm(f, 0.0)
    let a_pos = kb_fcmp(f, a, BinaryOp::OpGt, z)
    let b_pos = kb_fcmp(f, b, BinaryOp::OpGt, z)
    kb_iop(f, a_pos, BinaryOp::OpEq, b_pos)
}

fn kb_fget_f(f: &! IrFunction, obj: i64, idx: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    var ins = ir_field_get(r, obj, idx, ir_empty_name())
    ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
    kb_emit(f, ins)
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_fget_i(f: &! IrFunction, obj: i64, idx: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_field_get(r, obj, idx, ir_empty_name()))
    r
}

fn kb_fset(f: &! IrFunction, obj: i64, idx: i64, val: i64) with Mut, Panic, Div {
    kb_emit(f, ir_field_set(obj, idx, val, ir_empty_name()))
}

fn kb_iget_i(f: &! IrFunction, arr: i64, idx: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_index_get(r, arr, idx))
    r
}

fn kb_iget_f(f: &! IrFunction, arr: i64, idx: i64) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    var ins = ir_index_get(r, arr, idx)
    ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
    kb_emit(f, ins)
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_iset(f: &! IrFunction, arr: i64, idx: i64, val: i64) with Mut, Panic, Div {
    kb_emit(f, ir_index_set(arr, idx, val))
}

fn kb_call0_i(f: &! IrFunction, fid: i64, name: Name) -> i64 with Mut, Panic, Div {
    let r = kb_reg(f)
    kb_emit(f, ir_call(r, fid, name, None, 0))
    r
}

fn kb_call1_i(f: &! IrFunction, fid: i64, name: Name, a0: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(a0)))
    kb_emit(f, ir_call(r, fid, name, args, 1))
    r
}

fn kb_call1_f(f: &! IrFunction, fid: i64, name: Name, a0: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(a0)))
    var ins = ir_call(r, fid, name, args, 1)
    ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
    kb_emit(f, ins)
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_call2_i(f: &! IrFunction, fid: i64, name: Name, a0: i64, a1: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a0, Some(Box::new(ir_reg_list_single(a1))))))
    kb_emit(f, ir_call(r, fid, name, args, 2))
    r
}

fn kb_call2_f(f: &! IrFunction, fid: i64, name: Name, a0: i64, a1: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a0, Some(Box::new(ir_reg_list_single(a1))))))
    var ins = ir_call(r, fid, name, args, 2)
    ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
    kb_emit(f, ins)
    kb_emit(f, ir_mark_float_reg(r))
    r
}

fn kb_call4_i(f: &! IrFunction, fid: i64, name: Name, a0: i64, a1: i64, a2: i64, a3: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let l3: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(a3)))
    let l2: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a2, l3)))
    let l1: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a1, l2)))
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a0, l1)))
    kb_emit(f, ir_call(r, fid, name, args, 4))
    r
}

fn kb_call6_i(f: &! IrFunction, fid: i64, name: Name, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 with Mut, Panic, Div, Alloc {
    let r = kb_reg(f)
    let l5: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(a5)))
    let l4: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a4, l5)))
    let l3: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a3, l4)))
    let l2: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a2, l3)))
    let l1: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a1, l2)))
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(a0, l1)))
    kb_emit(f, ir_call(r, fid, name, args, 6))
    r
}

// ============================================================================
// Module slot lookup / reservation helpers
// ============================================================================

fn knight_find_or_reserve_fn(m: &! IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*m).fn_count {
        if ir_name_eq(ir_fn_get(&(*m), i as usize).name, name) {
            return i
        }
        i = i + 1
    }
    let idx = (*m).fn_count
    var slot = ir_empty_function()
    slot.name = name
    ir_function_alloc_region(&! slot)
    ir_fn_set(m, idx as usize, slot)
    (*m).fn_count = idx + 1
    idx
}

fn knight_ensure_anon_bss(m: &! IrModule) -> (i64, Name) with Mut, Panic, Div {
    let nm = make_name("__sounio_knight_anon_ctr")
    var i: i64 = 0
    while i < (*m).fn_count {
        let f = ir_fn_get(&(*m), i as usize)
        if ir_name_eq(f.name, nm) && f.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
            return (f.param_count, nm)
        }
        i = i + 1
    }
    let idx = (*m).fn_count
    var bss = ir_empty_function()
    bss.name = nm
    bss.compile_strategy = IR_STRATEGY_BSS_GLOBAL
    let off = (*m).bss_total_size
    bss.param_count = off
    bss.bss_size = 8
    bss.hyper_algebra_kind = 8
    ir_function_alloc_region(&! bss)
    ir_fn_set(m, idx as usize, bss)
    (*m).fn_count = idx + 1
    (*m).bss_total_size = off + 8
    (off, nm)
}

fn knight_init_fn(name: Name, nparams: i64, returns_float: i64) -> IrFunction with Mut, Panic, Div {
    var f = ir_empty_function()
    f.name = name
    f.param_count = nparams
    f.reg_count = nparams
    f.returns_float = returns_float
    var p: i64 = 0
    while p < nparams {
        f.param_regs[p as usize] = p
        p = p + 1
    }
    ir_function_alloc_region(&! f)
    f
}

// ============================================================================
// Synthesized helper builders
// ============================================================================

fn knight_build_next_anon(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    let bss = knight_ensure_anon_bss(m)
    var f = knight_init_fn(make_name("__sounio_knight_next_anon"), 0, 0)
    let cur = kb_reg(&! f)
    kb_emit(&! f, ir_load_global(cur, bss.0, bss.1))
    let one = kb_imm(&! f, 1)
    let nxt = kb_iop(&! f, cur, BinaryOp::OpAdd, one)
    kb_emit(&! f, ir_store_global(nxt, bss.0, bss.1))
    kb_emit(&! f, ir_return(nxt))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_se_down(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    // Rump-Zimmermann-Boldo-Melquiond predecessor-or-less for finite x.
    // Non-finite inputs (+inf, -inf, NaN) return unchanged (never inf - inf = NaN).
    var f = knight_init_fn(make_name("__sounio_knight_se_down"), 1, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    let fin = kb_is_finite(&! f, 0)
    let l_fin = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(fin, l_fin))
    let ar = kb_fabs(&! f, 0)
    let phi = kb_fphi(&! f)
    let eta = kb_feta(&! f)
    let scaled = kb_fop(&! f, ar, BinaryOp::OpMul, phi)
    let push = kb_fop(&! f, scaled, BinaryOp::OpAdd, eta)
    let out = kb_fop(&! f, 0, BinaryOp::OpSub, push)
    kb_emit(&! f, ir_return(out))
    kb_emit(&! f, ir_label(l_fin))
    kb_emit(&! f, ir_return(0))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_se_up(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    // Rump-Zimmermann-Boldo-Melquiond successor-or-greater for finite x.
    // Non-finite inputs (+inf, -inf, NaN) return unchanged (never -inf + inf = NaN).
    var f = knight_init_fn(make_name("__sounio_knight_se_up"), 1, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    let fin = kb_is_finite(&! f, 0)
    let l_fin = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(fin, l_fin))
    let ar = kb_fabs(&! f, 0)
    let phi = kb_fphi(&! f)
    let eta = kb_feta(&! f)
    let scaled = kb_fop(&! f, ar, BinaryOp::OpMul, phi)
    let push = kb_fop(&! f, scaled, BinaryOp::OpAdd, eta)
    let out = kb_fop(&! f, 0, BinaryOp::OpAdd, push)
    kb_emit(&! f, ir_return(out))
    kb_emit(&! f, ir_label(l_fin))
    kb_emit(&! f, ir_return(0))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_two_sum_err(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    // Knuth TwoSum (1969): s = a + b; bb = s - a; err = (a - (s - bb)) + (b - bb).
    var f = knight_init_fn(make_name("__sounio_knight_two_sum_err"), 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let s = kb_fop(&! f, 0, BinaryOp::OpAdd, 1)
    let bb = kb_fop(&! f, s, BinaryOp::OpSub, 0)
    let s_minus_bb = kb_fop(&! f, s, BinaryOp::OpSub, bb)
    let da = kb_fop(&! f, 0, BinaryOp::OpSub, s_minus_bb)
    let db = kb_fop(&! f, 1, BinaryOp::OpSub, bb)
    let err = kb_fop(&! f, da, BinaryOp::OpAdd, db)
    kb_emit(&! f, ir_return(err))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_sum_err_abs(m: &! IrModule, fid: i64, fid_tse: i64) with Mut, Panic, Div, Alloc {
    // Certified upper bound on |fl(a + b) - (a +_R b)|, or +inf on any non-finite
    // input, overflow, or non-finite TwoSum intermediate.
    var f = knight_init_fn(make_name("__sounio_knight_sum_err_abs"), 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let inf = kb_finf(&! f)
    let l_fail = kb_lbl(&! f)
    let fa = kb_is_finite(&! f, 0)
    kb_emit(&! f, ir_branch_false(fa, l_fail))
    let fb = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(fb, l_fail))
    let s = kb_fop(&! f, 0, BinaryOp::OpAdd, 1)
    let fs = kb_is_finite(&! f, s)
    kb_emit(&! f, ir_branch_false(fs, l_fail))
    let err = kb_call2_f(&! f, fid_tse, make_name("__sounio_knight_two_sum_err"), 0, 1)
    let fe = kb_is_finite(&! f, err)
    kb_emit(&! f, ir_branch_false(fe, l_fail))
    let ae = kb_fabs(&! f, err)
    kb_emit(&! f, ir_return(ae))
    kb_emit(&! f, ir_label(l_fail))
    kb_emit(&! f, ir_return(inf))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_add_dir(m: &! IrModule, fid: i64, is_up: bool, fid_tse: i64, fid_se: i64) with Mut, Panic, Div, Alloc {
    let fname = if is_up { make_name("__sounio_knight_add_up") } else { make_name("__sounio_knight_add_down") }
    let se_name = if is_up { make_name("__sounio_knight_se_up") } else { make_name("__sounio_knight_se_down") }
    var f = knight_init_fn(fname, 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let z = kb_fimm(&! f, 0.0)
    let inf = kb_finf(&! f)
    let minf = kb_fneg(&! f, inf)
    let dmax = kb_fdbl_max(&! f)
    let mdmax = kb_fneg(&! f, dmax)

    // Non-finite input path: if a + b is NaN (e.g. inf + -inf or NaN), fail closed to -inf / +inf.
    let l_nonfin = kb_lbl(&! f)
    let fa = kb_is_finite(&! f, 0)
    kb_emit(&! f, ir_branch_false(fa, l_nonfin))
    let fb = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(fb, l_nonfin))

    // Both inputs finite.
    let s = kb_fop(&! f, 0, BinaryOp::OpAdd, 1)
    let l_ov = kb_lbl(&! f)
    let fs = kb_is_finite(&! f, s)
    kb_emit(&! f, ir_branch_false(fs, l_ov))

    let err = kb_call2_f(&! f, fid_tse, make_name("__sounio_knight_two_sum_err"), 0, 1)
    let l_push = kb_lbl(&! f)
    let fe = kb_is_finite(&! f, err)
    kb_emit(&! f, ir_branch_false(fe, l_push))
    let need_push = if is_up {
        kb_fcmp(&! f, err, BinaryOp::OpGt, z)
    } else {
        kb_fcmp(&! f, err, BinaryOp::OpLt, z)
    }
    let l_exact = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(need_push, l_exact))
    kb_emit(&! f, ir_label(l_push))
    let pushed = kb_call1_f(&! f, fid_se, se_name, s)
    kb_emit(&! f, ir_return(pushed))
    kb_emit(&! f, ir_label(l_exact))
    kb_emit(&! f, ir_return(s))

    // Finite sum overflowed to +inf or -inf:
    //   true sum > DBL_MAX:  add_down = DBL_MAX,  add_up = +inf
    //   true sum < -DBL_MAX: add_down = -inf,     add_up = -DBL_MAX
    kb_emit(&! f, ir_label(l_ov))
    let l_ov_neg = kb_lbl(&! f)
    let ov_pos = kb_fcmp(&! f, s, BinaryOp::OpGt, z)
    kb_emit(&! f, ir_branch_false(ov_pos, l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(dmax))
    }
    kb_emit(&! f, ir_label(l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(mdmax))
    } else {
        kb_emit(&! f, ir_return(minf))
    }

    // Non-finite input handling.
    kb_emit(&! f, ir_label(l_nonfin))
    let snf = kb_fop(&! f, 0, BinaryOp::OpAdd, 1)
    let snf_ok = kb_fcmp(&! f, snf, BinaryOp::OpEq, snf)
    let l_nan = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(snf_ok, l_nan))
    kb_emit(&! f, ir_return(snf))
    kb_emit(&! f, ir_label(l_nan))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(minf))
    }
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_two_prod_err(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    // Dekker-Veltkamp TwoProd split (C = 2^27 + 1 = 134217729.0).
    // Callers MUST ensure |a|, |b| in [1e-145, 1e145] and |a * b| >= 1e-290.
    var f = knight_init_fn(make_name("__sounio_knight_two_prod_err"), 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let z = kb_fimm(&! f, 0.0)
    let one = kb_fimm(&! f, 1.0)
    let mone = kb_fimm(&! f, 0.0 - 1.0)
    let l_check = kb_lbl(&! f)
    let l_zero = kb_lbl(&! f)
    let c0 = kb_fcmp(&! f, 0, BinaryOp::OpEq, z)
    let l_n1 = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(c0, l_n1))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_n1))
    let c1 = kb_fcmp(&! f, 1, BinaryOp::OpEq, z)
    let l_n2 = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(c1, l_n2))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_n2))
    let c2 = kb_fcmp(&! f, 0, BinaryOp::OpEq, one)
    let l_n3 = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(c2, l_n3))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_n3))
    let c3 = kb_fcmp(&! f, 1, BinaryOp::OpEq, one)
    let l_n4 = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(c3, l_n4))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_n4))
    let c4 = kb_fcmp(&! f, 0, BinaryOp::OpEq, mone)
    let l_n5 = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(c4, l_n5))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_n5))
    let c5 = kb_fcmp(&! f, 1, BinaryOp::OpEq, mone)
    kb_emit(&! f, ir_branch_false(c5, l_check))
    kb_emit(&! f, ir_label(l_zero))
    kb_emit(&! f, ir_return(z))

    kb_emit(&! f, ir_label(l_check))
    let p = kb_fop(&! f, 0, BinaryOp::OpMul, 1)
    let split_c = kb_fimm(&! f, 134217729.0)
    let ca = kb_fop(&! f, split_c, BinaryOp::OpMul, 0)
    let ca_m_a = kb_fop(&! f, ca, BinaryOp::OpSub, 0)
    let a_hi = kb_fop(&! f, ca, BinaryOp::OpSub, ca_m_a)
    let a_lo = kb_fop(&! f, 0, BinaryOp::OpSub, a_hi)
    let cb = kb_fop(&! f, split_c, BinaryOp::OpMul, 1)
    let cb_m_b = kb_fop(&! f, cb, BinaryOp::OpSub, 1)
    let b_hi = kb_fop(&! f, cb, BinaryOp::OpSub, cb_m_b)
    let b_lo = kb_fop(&! f, 1, BinaryOp::OpSub, b_hi)
    let t0 = kb_fop(&! f, a_hi, BinaryOp::OpMul, b_hi)
    let t1 = kb_fop(&! f, t0, BinaryOp::OpSub, p)
    let t2 = kb_fop(&! f, a_hi, BinaryOp::OpMul, b_lo)
    let t3 = kb_fop(&! f, t1, BinaryOp::OpAdd, t2)
    let t4 = kb_fop(&! f, a_lo, BinaryOp::OpMul, b_hi)
    let t5 = kb_fop(&! f, t3, BinaryOp::OpAdd, t4)
    let t6 = kb_fop(&! f, a_lo, BinaryOp::OpMul, b_lo)
    let err = kb_fop(&! f, t5, BinaryOp::OpAdd, t6)
    kb_emit(&! f, ir_return(err))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_prod_err_abs(m: &! IrModule, fid: i64, fid_tpe: i64) with Mut, Panic, Div, Alloc {
    // Certified upper bound on |fl(a * b) - (a *_R b)| for ALL binary64 a, b:
    //   - non-finite input or product overflow -> +inf (triggers vacuous)
    //   - exact 0 or +-1 operand -> 0.0
    //   - non-zero product underflowing to 0.0 -> eta (2^-1074)
    //   - normal TwoProd range |a|, |b| in [1e-145, 1e145], |p| >= 1e-290 -> |two_prod_err(a, b)|
    //   - extreme finite range -> |p| * phi + eta (proved >= 0.5*ulp(p) + 0.5*eta)
    var f = knight_init_fn(make_name("__sounio_knight_prod_err_abs"), 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let z = kb_fimm(&! f, 0.0)
    let one = kb_fimm(&! f, 1.0)
    let mone = kb_fimm(&! f, 0.0 - 1.0)
    let inf = kb_finf(&! f)
    let eta = kb_feta(&! f)
    let phi = kb_fphi(&! f)
    let l_inf = kb_lbl(&! f)
    let l_zero = kb_lbl(&! f)

    let fa = kb_is_finite(&! f, 0)
    kb_emit(&! f, ir_branch_false(fa, l_inf))
    let fb = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(fb, l_inf))

    // Exact 0, +1, -1 shortcuts (safe because both operands are finite).
    let l_c1 = kb_lbl(&! f)
    let e0 = kb_fcmp(&! f, 0, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(e0, l_c1))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_c1))
    let l_c2 = kb_lbl(&! f)
    let e1 = kb_fcmp(&! f, 1, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(e1, l_c2))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_c2))
    let l_c3 = kb_lbl(&! f)
    let e2 = kb_fcmp(&! f, 0, BinaryOp::OpEq, one)
    kb_emit(&! f, ir_branch_false(e2, l_c3))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_c3))
    let l_c4 = kb_lbl(&! f)
    let e3 = kb_fcmp(&! f, 1, BinaryOp::OpEq, one)
    kb_emit(&! f, ir_branch_false(e3, l_c4))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_c4))
    let l_c5 = kb_lbl(&! f)
    let e4 = kb_fcmp(&! f, 0, BinaryOp::OpEq, mone)
    kb_emit(&! f, ir_branch_false(e4, l_c5))
    kb_emit(&! f, ir_jump(l_zero))
    kb_emit(&! f, ir_label(l_c5))
    let l_mul = kb_lbl(&! f)
    let e5 = kb_fcmp(&! f, 1, BinaryOp::OpEq, mone)
    kb_emit(&! f, ir_branch_false(e5, l_mul))
    kb_emit(&! f, ir_label(l_zero))
    kb_emit(&! f, ir_return(z))

    kb_emit(&! f, ir_label(l_mul))
    let p = kb_fop(&! f, 0, BinaryOp::OpMul, 1)
    let fp = kb_is_finite(&! f, p)
    kb_emit(&! f, ir_branch_false(fp, l_inf))

    // Non-zero operands whose product underflowed to 0.0 -> |a*_R b| <= eta.
    let l_nzp = kb_lbl(&! f)
    let p_is_z = kb_fcmp(&! f, p, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(p_is_z, l_nzp))
    kb_emit(&! f, ir_return(eta))

    kb_emit(&! f, ir_label(l_nzp))
    let hi_lim = kb_fimm(&! f, 1.0e145)
    let lo_lim = kb_fimm(&! f, 1.0e-145)
    let p_lim = kb_fimm(&! f, 1.0e-290)
    let aa = kb_fabs(&! f, 0)
    let ab = kb_fabs(&! f, 1)
    let ap = kb_fabs(&! f, p)
    let l_fallback = kb_lbl(&! f)
    let g1 = kb_fcmp(&! f, aa, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g1, l_fallback))
    let g2 = kb_fcmp(&! f, ab, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g2, l_fallback))
    let g3 = kb_fcmp(&! f, aa, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g3, l_fallback))
    let g4 = kb_fcmp(&! f, ab, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g4, l_fallback))
    let g5 = kb_fcmp(&! f, ap, BinaryOp::OpGe, p_lim)
    kb_emit(&! f, ir_branch_false(g5, l_fallback))

    let err = kb_call2_f(&! f, fid_tpe, make_name("__sounio_knight_two_prod_err"), 0, 1)
    let fe = kb_is_finite(&! f, err)
    kb_emit(&! f, ir_branch_false(fe, l_fallback))
    let ae = kb_fabs(&! f, err)
    kb_emit(&! f, ir_return(ae))

    // Extreme-range finite fallback: |p| * phi + eta.
    kb_emit(&! f, ir_label(l_fallback))
    let sc = kb_fop(&! f, ap, BinaryOp::OpMul, phi)
    let bnd = kb_fop(&! f, sc, BinaryOp::OpAdd, eta)
    kb_emit(&! f, ir_return(bnd))

    kb_emit(&! f, ir_label(l_inf))
    kb_emit(&! f, ir_return(inf))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_mul_dir(m: &! IrModule, fid: i64, is_up: bool, fid_tpe: i64, fid_se: i64) with Mut, Panic, Div, Alloc {
    let fname = if is_up { make_name("__sounio_knight_mul_up") } else { make_name("__sounio_knight_mul_down") }
    let se_name = if is_up { make_name("__sounio_knight_se_up") } else { make_name("__sounio_knight_se_down") }
    var f = knight_init_fn(fname, 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let z = kb_fimm(&! f, 0.0)
    let inf = kb_finf(&! f)
    let minf = kb_fneg(&! f, inf)
    let dmax = kb_fdbl_max(&! f)
    let mdmax = kb_fneg(&! f, dmax)
    let eta = kb_feta(&! f)
    let meta = kb_fneg(&! f, eta)

    // Non-finite inputs fail closed to -inf / +inf.
    let l_nonfin = kb_lbl(&! f)
    let fa = kb_is_finite(&! f, 0)
    kb_emit(&! f, ir_branch_false(fa, l_nonfin))
    let fb = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(fb, l_nonfin))

    // Exact zero operands (safe after finiteness check).
    let l_nz_a = kb_lbl(&! f)
    let ca0 = kb_fcmp(&! f, 0, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(ca0, l_nz_a))
    kb_emit(&! f, ir_return(z))
    kb_emit(&! f, ir_label(l_nz_a))
    let l_nz_b = kb_lbl(&! f)
    let cb0 = kb_fcmp(&! f, 1, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(cb0, l_nz_b))
    kb_emit(&! f, ir_return(z))
    kb_emit(&! f, ir_label(l_nz_b))

    let p = kb_fop(&! f, 0, BinaryOp::OpMul, 1)
    let pos = kb_same_sign_pos(&! f, 0, 1)

    // Overflowed product: finite*finite -> +-inf.
    let l_ov = kb_lbl(&! f)
    let fp = kb_is_finite(&! f, p)
    kb_emit(&! f, ir_branch_false(fp, l_ov))

    // Underflowed product: non-zero * non-zero -> 0.0.
    let l_uf = kb_lbl(&! f)
    let p0 = kb_fcmp(&! f, p, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(p0, l_uf))
    let l_uf_neg = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(pos, l_uf_neg))
    if is_up {
        kb_emit(&! f, ir_return(eta))
    } else {
        kb_emit(&! f, ir_return(z))
    }
    kb_emit(&! f, ir_label(l_uf_neg))
    if is_up {
        kb_emit(&! f, ir_return(z))
    } else {
        kb_emit(&! f, ir_return(meta))
    }

    // Normal / subnormal non-zero product.
    kb_emit(&! f, ir_label(l_uf))
    let hi_lim = kb_fimm(&! f, 1.0e145)
    let lo_lim = kb_fimm(&! f, 1.0e-145)
    let p_lim = kb_fimm(&! f, 1.0e-290)
    let aa = kb_fabs(&! f, 0)
    let ab = kb_fabs(&! f, 1)
    let ap = kb_fabs(&! f, p)
    let l_push = kb_lbl(&! f)
    let g1 = kb_fcmp(&! f, aa, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g1, l_push))
    let g2 = kb_fcmp(&! f, ab, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g2, l_push))
    let g3 = kb_fcmp(&! f, aa, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g3, l_push))
    let g4 = kb_fcmp(&! f, ab, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g4, l_push))
    let g5 = kb_fcmp(&! f, ap, BinaryOp::OpGe, p_lim)
    kb_emit(&! f, ir_branch_false(g5, l_push))

    let err = kb_call2_f(&! f, fid_tpe, make_name("__sounio_knight_two_prod_err"), 0, 1)
    let fe = kb_is_finite(&! f, err)
    kb_emit(&! f, ir_branch_false(fe, l_push))
    let need = if is_up {
        kb_fcmp(&! f, err, BinaryOp::OpGt, z)
    } else {
        kb_fcmp(&! f, err, BinaryOp::OpLt, z)
    }
    let l_exact = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(need, l_exact))
    kb_emit(&! f, ir_label(l_push))
    let pushed = kb_call1_f(&! f, fid_se, se_name, p)
    kb_emit(&! f, ir_return(pushed))
    kb_emit(&! f, ir_label(l_exact))
    kb_emit(&! f, ir_return(p))

    // Overflow return.
    kb_emit(&! f, ir_label(l_ov))
    let l_ov_neg = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(pos, l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(dmax))
    }
    kb_emit(&! f, ir_label(l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(mdmax))
    } else {
        kb_emit(&! f, ir_return(minf))
    }

    // Non-finite input return.
    kb_emit(&! f, ir_label(l_nonfin))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(minf))
    }
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_div_dir(m: &! IrModule, fid: i64, is_up: bool, fid_tpe: i64, fid_se: i64) with Mut, Panic, Div, Alloc {
    let fname = if is_up { make_name("__sounio_knight_div_up") } else { make_name("__sounio_knight_div_down") }
    let se_name = if is_up { make_name("__sounio_knight_se_up") } else { make_name("__sounio_knight_se_down") }
    var f = knight_init_fn(fname, 2, 1)
    kb_emit(&! f, ir_mark_float_reg(0))
    kb_emit(&! f, ir_mark_float_reg(1))
    let z = kb_fimm(&! f, 0.0)
    let inf = kb_finf(&! f)
    let minf = kb_fneg(&! f, inf)
    let dmax = kb_fdbl_max(&! f)
    let mdmax = kb_fneg(&! f, dmax)
    let eta = kb_feta(&! f)
    let meta = kb_fneg(&! f, eta)

    let l_nonfin = kb_lbl(&! f)
    let fa = kb_is_finite(&! f, 0)
    kb_emit(&! f, ir_branch_false(fa, l_nonfin))
    let fb = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(fb, l_nonfin))
    let b_nz = kb_fcmp(&! f, 1, BinaryOp::OpNe, z)
    kb_emit(&! f, ir_branch_false(b_nz, l_nonfin))

    let l_nz = kb_lbl(&! f)
    let ca0 = kb_fcmp(&! f, 0, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(ca0, l_nz))
    kb_emit(&! f, ir_return(z))
    kb_emit(&! f, ir_label(l_nz))

    let q = kb_fop(&! f, 0, BinaryOp::OpDiv, 1)
    let pos = kb_same_sign_pos(&! f, 0, 1)

    let l_ov = kb_lbl(&! f)
    let fq = kb_is_finite(&! f, q)
    kb_emit(&! f, ir_branch_false(fq, l_ov))

    let l_uf = kb_lbl(&! f)
    let q0 = kb_fcmp(&! f, q, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(q0, l_uf))
    let l_uf_neg = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(pos, l_uf_neg))
    if is_up {
        kb_emit(&! f, ir_return(eta))
    } else {
        kb_emit(&! f, ir_return(z))
    }
    kb_emit(&! f, ir_label(l_uf_neg))
    if is_up {
        kb_emit(&! f, ir_return(z))
    } else {
        kb_emit(&! f, ir_return(meta))
    }

    kb_emit(&! f, ir_label(l_uf))
    let hi_lim = kb_fimm(&! f, 1.0e145)
    let lo_lim = kb_fimm(&! f, 1.0e-145)
    let p_lim = kb_fimm(&! f, 1.0e-290)
    let aq = kb_fabs(&! f, q)
    let ab = kb_fabs(&! f, 1)
    let aa = kb_fabs(&! f, 0)
    let l_push = kb_lbl(&! f)
    let g1 = kb_fcmp(&! f, aq, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g1, l_push))
    let g2 = kb_fcmp(&! f, ab, BinaryOp::OpLt, hi_lim)
    kb_emit(&! f, ir_branch_false(g2, l_push))
    let g3 = kb_fcmp(&! f, aq, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g3, l_push))
    let g4 = kb_fcmp(&! f, ab, BinaryOp::OpGe, lo_lim)
    kb_emit(&! f, ir_branch_false(g4, l_push))
    let g5 = kb_fcmp(&! f, aa, BinaryOp::OpGe, p_lim)
    kb_emit(&! f, ir_branch_false(g5, l_push))

    let qb = kb_fop(&! f, q, BinaryOp::OpMul, 1)
    let eq_a = kb_fcmp(&! f, qb, BinaryOp::OpEq, 0)
    kb_emit(&! f, ir_branch_false(eq_a, l_push))
    let err = kb_call2_f(&! f, fid_tpe, make_name("__sounio_knight_two_prod_err"), q, 1)
    let err0 = kb_fcmp(&! f, err, BinaryOp::OpEq, z)
    kb_emit(&! f, ir_branch_false(err0, l_push))
    kb_emit(&! f, ir_return(q))

    kb_emit(&! f, ir_label(l_push))
    let pushed = kb_call1_f(&! f, fid_se, se_name, q)
    kb_emit(&! f, ir_return(pushed))

    kb_emit(&! f, ir_label(l_ov))
    let l_ov_neg = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(pos, l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(dmax))
    }
    kb_emit(&! f, ir_label(l_ov_neg))
    if is_up {
        kb_emit(&! f, ir_return(mdmax))
    } else {
        kb_emit(&! f, ir_return(minf))
    }

    kb_emit(&! f, ir_label(l_nonfin))
    if is_up {
        kb_emit(&! f, ir_return(inf))
    } else {
        kb_emit(&! f, ir_return(minf))
    }
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_af_add_term(
    m: &! IrModule,
    fid: i64,
    fid_str_eq: i64,
    fid_sum_err_abs: i64,
    fid_add_up: i64,
    fid_mul_up: i64
) with Mut, Panic, Div, Alloc {
    // Params: 0=af, 1=name_ptr, 2=anon_id, 3=coeff(f64), 4=lo(f64), 5=hi(f64)
    var f = knight_init_fn(make_name("__sounio_knight_af_add_term"), 6, 0)
    kb_emit(&! f, ir_mark_float_reg(3))
    kb_emit(&! f, ir_mark_float_reg(4))
    kb_emit(&! f, ir_mark_float_reg(5))
    let zero_i = kb_imm(&! f, 0)
    let one_i = kb_imm(&! f, 1)
    let two_i = kb_imm(&! f, 2)
    let three_i = kb_imm(&! f, 3)
    let four_i = kb_imm(&! f, 4)
    let five_i = kb_imm(&! f, 5)
    let cap_i = kb_imm(&! f, 64)
    let zero_f = kb_fimm(&! f, 0.0)

    let l_set_vac = kb_lbl(&! f)

    // Already vacuous -> return immediately.
    let cur_vac = kb_iget_i(&! f, 0, three_i)
    let l_not_vac = kb_lbl(&! f)
    let is_v = kb_iop(&! f, cur_vac, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(is_v, l_not_vac))
    kb_emit(&! f, ir_return(zero_i))
    kb_emit(&! f, ir_label(l_not_vac))

    // Validate finite coeff, finite lo, finite hi, and lo <= hi.
    let fc = kb_is_finite(&! f, 3)
    kb_emit(&! f, ir_branch_false(fc, l_set_vac))
    let flo = kb_is_finite(&! f, 4)
    kb_emit(&! f, ir_branch_false(flo, l_set_vac))
    let fhi = kb_is_finite(&! f, 5)
    kb_emit(&! f, ir_branch_false(fhi, l_set_vac))
    let ord_ok = kb_fcmp(&! f, 4, BinaryOp::OpLe, 5)
    kb_emit(&! f, ir_branch_false(ord_ok, l_set_vac))

    let n = kb_iget_i(&! f, 0, one_i)
    let idx = kb_imm(&! f, 0)
    let l_loop = kb_lbl(&! f)
    let l_not_found = kb_lbl(&! f)
    let l_next = kb_lbl(&! f)
    let l_matched = kb_lbl(&! f)

    kb_emit(&! f, ir_label(l_loop))
    let cond = kb_iop(&! f, idx, BinaryOp::OpLt, n)
    kb_emit(&! f, ir_branch_false(cond, l_not_found))

    let t5 = kb_iop(&! f, idx, BinaryOp::OpMul, five_i)
    let base = kb_iop(&! f, four_i, BinaryOp::OpAdd, t5)
    let t_name = kb_iget_i(&! f, 0, base)
    let base1 = kb_iop(&! f, base, BinaryOp::OpAdd, one_i)
    let t_anon = kb_iget_i(&! f, 0, base1)

    // Match check:
    // if anon_id == 0: match iff t_anon == 0 && str_eq(t_name, name_ptr) != 0
    //                  AND BEFORE any coefficient addition/cancellation, verify
    //                  t_lo == lo && t_hi == hi (mismatch -> mark vacuous!).
    // else:            match iff t_anon == anon_id
    let l_chk_anon = kb_lbl(&! f)
    let anon_is_0 = kb_iop(&! f, 2, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(anon_is_0, l_chk_anon))
    let t_anon_is_0 = kb_iop(&! f, t_anon, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(t_anon_is_0, l_next))
    let eq_str = kb_call2_i(&! f, fid_str_eq, make_name("str_eq"), t_name, 1)
    let str_ok = kb_iop(&! f, eq_str, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(str_ok, l_next))
    // Name matched: check bounds identity BEFORE any coeff == 0 skip or cancellation!
    let base3 = kb_iop(&! f, base, BinaryOp::OpAdd, three_i)
    let base4 = kb_iop(&! f, base, BinaryOp::OpAdd, four_i)
    let t_lo = kb_iget_f(&! f, 0, base3)
    let t_hi = kb_iget_f(&! f, 0, base4)
    let lo_eq = kb_fcmp(&! f, t_lo, BinaryOp::OpEq, 4)
    kb_emit(&! f, ir_branch_false(lo_eq, l_set_vac))
    let hi_eq = kb_fcmp(&! f, t_hi, BinaryOp::OpEq, 5)
    kb_emit(&! f, ir_branch_false(hi_eq, l_set_vac))
    kb_emit(&! f, ir_jump(l_matched))

    kb_emit(&! f, ir_label(l_chk_anon))
    let eq_anon = kb_iop(&! f, t_anon, BinaryOp::OpEq, 2)
    kb_emit(&! f, ir_branch_false(eq_anon, l_next))

    // Matched term at `base` (with verified identical bounds if named)!
    kb_emit(&! f, ir_label(l_matched))
    let l_nz_m = kb_lbl(&! f)
    let cz_m = kb_fcmp(&! f, 3, BinaryOp::OpEq, zero_f)
    kb_emit(&! f, ir_branch_false(cz_m, l_nz_m))
    kb_emit(&! f, ir_return(zero_i))
    kb_emit(&! f, ir_label(l_nz_m))

    let base2 = kb_iop(&! f, base, BinaryOp::OpAdd, two_i)
    let old_c = kb_iget_f(&! f, 0, base2)
    let new_c = kb_fop(&! f, old_c, BinaryOp::OpAdd, 3)
    let fnc = kb_is_finite(&! f, new_c)
    kb_emit(&! f, ir_branch_false(fnc, l_set_vac))
    let err_abs = kb_call2_f(&! f, fid_sum_err_abs, make_name("__sounio_knight_sum_err_abs"), old_c, 3)
    let fea = kb_is_finite(&! f, err_abs)
    kb_emit(&! f, ir_branch_false(fea, l_set_vac))

    // Exact symbolic cancellation: new_c == 0.0 && err_abs == 0.0 -> remove term.
    let l_update = kb_lbl(&! f)
    let nc0 = kb_fcmp(&! f, new_c, BinaryOp::OpEq, zero_f)
    kb_emit(&! f, ir_branch_false(nc0, l_update))
    let ec0 = kb_fcmp(&! f, err_abs, BinaryOp::OpEq, zero_f)
    kb_emit(&! f, ir_branch_false(ec0, l_update))

    // Swap last term (n - 1) into slot `idx` and decrement `n`.
    let last_i = kb_iop(&! f, n, BinaryOp::OpSub, one_i)
    let l_dec = kb_lbl(&! f)
    let need_swap = kb_iop(&! f, idx, BinaryOp::OpLt, last_i)
    kb_emit(&! f, ir_branch_false(need_swap, l_dec))
    let lt5 = kb_iop(&! f, last_i, BinaryOp::OpMul, five_i)
    let lbase = kb_iop(&! f, four_i, BinaryOp::OpAdd, lt5)
    var k: i64 = 0
    while k < 5 {
        let ki = kb_imm(&! f, k)
        let sidx = kb_iop(&! f, lbase, BinaryOp::OpAdd, ki)
        let didx = kb_iop(&! f, base, BinaryOp::OpAdd, ki)
        let v = kb_iget_i(&! f, 0, sidx)
        kb_iset(&! f, 0, didx, v)
        k = k + 1
    }
    kb_emit(&! f, ir_label(l_dec))
    kb_iset(&! f, 0, one_i, last_i)
    kb_emit(&! f, ir_return(zero_i))

    // Update coefficient in place; absorb any TwoSum residual outward into rad_extra.
    kb_emit(&! f, ir_label(l_update))
    kb_iset(&! f, 0, base2, new_c)
    let l_ret_u = kb_lbl(&! f)
    let ec_nz = kb_fcmp(&! f, err_abs, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(ec_nz, l_ret_u))
    let abs_lo = kb_fabs(&! f, 4)
    let abs_hi = kb_fabs(&! f, 5)
    let max_b = kb_fmax(&! f, abs_lo, abs_hi)
    let bump = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), err_abs, max_b)
    let old_rad = kb_iget_f(&! f, 0, two_i)
    let new_rad = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), old_rad, bump)
    let fnr = kb_is_finite(&! f, new_rad)
    kb_emit(&! f, ir_branch_false(fnr, l_set_vac))
    kb_iset(&! f, 0, two_i, new_rad)
    kb_emit(&! f, ir_label(l_ret_u))
    kb_emit(&! f, ir_return(zero_i))

    kb_emit(&! f, ir_label(l_next))
    let next_idx = kb_iop(&! f, idx, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(idx, next_idx))
    kb_emit(&! f, ir_jump(l_loop))

    // Not found -> ignore coeff == 0.0; else append if n < 64, else collapse outward.
    kb_emit(&! f, ir_label(l_not_found))
    let l_nf_nz = kb_lbl(&! f)
    let cz_nf = kb_fcmp(&! f, 3, BinaryOp::OpEq, zero_f)
    kb_emit(&! f, ir_branch_false(cz_nf, l_nf_nz))
    kb_emit(&! f, ir_return(zero_i))
    kb_emit(&! f, ir_label(l_nf_nz))

    let l_overflow = kb_lbl(&! f)
    let has_room = kb_iop(&! f, n, BinaryOp::OpLt, cap_i)
    kb_emit(&! f, ir_branch_false(has_room, l_overflow))

    let nt5 = kb_iop(&! f, n, BinaryOp::OpMul, five_i)
    let nbase = kb_iop(&! f, four_i, BinaryOp::OpAdd, nt5)
    let nb1 = kb_iop(&! f, nbase, BinaryOp::OpAdd, one_i)
    let nb2 = kb_iop(&! f, nbase, BinaryOp::OpAdd, two_i)
    let nb3 = kb_iop(&! f, nbase, BinaryOp::OpAdd, three_i)
    let nb4 = kb_iop(&! f, nbase, BinaryOp::OpAdd, four_i)
    kb_iset(&! f, 0, nbase, 1)
    kb_iset(&! f, 0, nb1, 2)
    kb_iset(&! f, 0, nb2, 3)
    kb_iset(&! f, 0, nb3, 4)
    kb_iset(&! f, 0, nb4, 5)
    let n_inc = kb_iop(&! f, n, BinaryOp::OpAdd, one_i)
    kb_iset(&! f, 0, one_i, n_inc)
    kb_emit(&! f, ir_return(zero_i))

    // Overflow (>64 terms): sound outward collapse into af[2] (rad_extra).
    kb_emit(&! f, ir_label(l_overflow))
    let abs_c = kb_fabs(&! f, 3)
    let abs_lo2 = kb_fabs(&! f, 4)
    let abs_hi2 = kb_fabs(&! f, 5)
    let max_b2 = kb_fmax(&! f, abs_lo2, abs_hi2)
    let ov_rad = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), abs_c, max_b2)
    let old_rad2 = kb_iget_f(&! f, 0, two_i)
    let new_rad2 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), old_rad2, ov_rad)
    let fnr2 = kb_is_finite(&! f, new_rad2)
    kb_emit(&! f, ir_branch_false(fnr2, l_set_vac))
    kb_iset(&! f, 0, two_i, new_rad2)
    kb_emit(&! f, ir_return(zero_i))

    // Fail-closed vacuous mark.
    kb_emit(&! f, ir_label(l_set_vac))
    kb_iset(&! f, 0, three_i, one_i)
    kb_emit(&! f, ir_return(zero_i))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_new(m: &! IrModule, fid: i64) with Mut, Panic, Div {
    // Params: 0=name_ptr, 1=lo(f64), 2=hi(f64) -> Knowledge handle
    // Validates finite and ordered (lo <= hi) bounds; invalid bounds fail closed to vacuous.
    var f = knight_init_fn(make_name("__sounio_knight_new"), 3, 0)
    kb_emit(&! f, ir_mark_float_reg(1))
    kb_emit(&! f, ir_mark_float_reg(2))
    let zero_f = kb_fimm(&! f, 0.0)
    let one_f = kb_fimm(&! f, 1.0)
    let zero_i = kb_imm(&! f, 0)
    let one_i = kb_imm(&! f, 1)
    let two_i = kb_imm(&! f, 2)
    let three_i = kb_imm(&! f, 3)
    let four_i = kb_imm(&! f, 4)
    let five_i = kb_imm(&! f, 5)
    let six_i = kb_imm(&! f, 6)
    let seven_i = kb_imm(&! f, 7)
    let eight_i = kb_imm(&! f, 8)

    let kn = kb_reg(&! f)
    kb_emit(&! f, ir_alloc(kn, 0))
    kb_fset(&! f, kn, 1, zero_f)
    kb_fset(&! f, kn, 2, zero_f)

    let af = kb_reg(&! f)
    kb_emit(&! f, ir_alloc_array(af, 2592, 324))
    kb_iset(&! f, af, zero_i, zero_f)
    kb_iset(&! f, af, two_i, zero_f)

    let l_bad = kb_lbl(&! f)
    let flo = kb_is_finite(&! f, 1)
    kb_emit(&! f, ir_branch_false(flo, l_bad))
    let fhi = kb_is_finite(&! f, 2)
    kb_emit(&! f, ir_branch_false(fhi, l_bad))
    let ord = kb_fcmp(&! f, 1, BinaryOp::OpLe, 2)
    kb_emit(&! f, ir_branch_false(ord, l_bad))

    let mid = kb_safe_mid(&! f, 1, 2)
    kb_fset(&! f, kn, 0, mid)
    kb_iset(&! f, af, one_i, one_i)
    kb_iset(&! f, af, three_i, zero_i)
    kb_iset(&! f, af, four_i, 0)       // name_ptr
    kb_iset(&! f, af, five_i, zero_i)  // anon_id = 0 (named)
    kb_iset(&! f, af, six_i, one_f)    // coeff = 1.0
    kb_iset(&! f, af, seven_i, 1)      // lo
    kb_iset(&! f, af, eight_i, 2)      // hi
    kb_fset(&! f, kn, 63, af)
    kb_emit(&! f, ir_return(kn))

    // Invalid (non-finite or reversed) bounds -> vacuous non-certificate.
    kb_emit(&! f, ir_label(l_bad))
    kb_fset(&! f, kn, 0, zero_f)
    kb_iset(&! f, af, one_i, zero_i)
    kb_iset(&! f, af, three_i, one_i)
    kb_fset(&! f, kn, 63, af)
    kb_emit(&! f, ir_return(kn))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_iv(
    m: &! IrModule,
    fid: i64,
    fid_add_down: i64,
    fid_add_up: i64,
    fid_mul_down: i64,
    fid_mul_up: i64
) with Mut, Panic, Div, Alloc {
    // Param: 0=kn (Knowledge handle) -> Tuple (f64, f64) handle (slot 0 = lo, slot 1 = hi)
    // Fail-closed: never returns NaN, reversed endpoints, or [+inf,+inf]/[-inf,-inf].
    var f = knight_init_fn(make_name("__sounio_knight_iv"), 1, 1027)
    let zero_i = kb_imm(&! f, 0)
    let one_i = kb_imm(&! f, 1)
    let two_i = kb_imm(&! f, 2)
    let three_i = kb_imm(&! f, 3)
    let four_i = kb_imm(&! f, 4)
    let five_i = kb_imm(&! f, 5)
    let zero_f = kb_fimm(&! f, 0.0)
    let inf = kb_finf(&! f)
    let minf = kb_fneg(&! f, inf)

    let l_ret_vac = kb_lbl(&! f)

    let tup = kb_reg(&! f)
    kb_emit(&! f, ir_alloc(tup, 0))
    let af = kb_fget_i(&! f, 0, 63)
    let l_has_af = kb_lbl(&! f)
    let is_null = kb_iop(&! f, af, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(is_null, l_has_af))
    let v = kb_fget_f(&! f, 0, 0)
    let fv = kb_is_finite(&! f, v)
    kb_emit(&! f, ir_branch_false(fv, l_ret_vac))
    kb_fset(&! f, tup, 0, v)
    kb_fset(&! f, tup, 1, v)
    kb_emit(&! f, ir_return(tup))

    kb_emit(&! f, ir_label(l_has_af))
    let vac = kb_iget_i(&! f, af, three_i)
    let is_vac = kb_iop(&! f, vac, BinaryOp::OpNe, zero_i)
    let l_fin = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(is_vac, l_fin))
    kb_emit(&! f, ir_jump(l_ret_vac))

    kb_emit(&! f, ir_label(l_fin))
    let c0 = kb_iget_f(&! f, af, zero_i)
    let fc0 = kb_is_finite(&! f, c0)
    kb_emit(&! f, ir_branch_false(fc0, l_ret_vac))
    let lo_acc = kb_freg(&! f)
    let hi_acc = kb_freg(&! f)
    kb_emit(&! f, ir_copy(lo_acc, c0))
    kb_emit(&! f, ir_mark_float_reg(lo_acc))
    kb_emit(&! f, ir_copy(hi_acc, c0))
    kb_emit(&! f, ir_mark_float_reg(hi_acc))
    let n = kb_iget_i(&! f, af, one_i)
    let idx = kb_imm(&! f, 0)
    let l_loop = kb_lbl(&! f)
    let l_done = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_loop))
    let cond = kb_iop(&! f, idx, BinaryOp::OpLt, n)
    kb_emit(&! f, ir_branch_false(cond, l_done))

    let t5 = kb_iop(&! f, idx, BinaryOp::OpMul, five_i)
    let base = kb_iop(&! f, four_i, BinaryOp::OpAdd, t5)
    let b2 = kb_iop(&! f, base, BinaryOp::OpAdd, two_i)
    let b3 = kb_iop(&! f, base, BinaryOp::OpAdd, three_i)
    let b4 = kb_iop(&! f, base, BinaryOp::OpAdd, four_i)
    let coeff = kb_iget_f(&! f, af, b2)
    let t_lo = kb_iget_f(&! f, af, b3)
    let t_hi = kb_iget_f(&! f, af, b4)

    // Fail closed on any NaN/inf coefficient or invalid term bounds (never silently skip NaN!).
    let fcf = kb_is_finite(&! f, coeff)
    kb_emit(&! f, ir_branch_false(fcf, l_ret_vac))
    let ftlo = kb_is_finite(&! f, t_lo)
    kb_emit(&! f, ir_branch_false(ftlo, l_ret_vac))
    let fthi = kb_is_finite(&! f, t_hi)
    kb_emit(&! f, ir_branch_false(fthi, l_ret_vac))
    let tord = kb_fcmp(&! f, t_lo, BinaryOp::OpLe, t_hi)
    kb_emit(&! f, ir_branch_false(tord, l_ret_vac))

    let l_neg = kb_lbl(&! f)
    let l_step = kb_lbl(&! f)
    let is_pos = kb_fcmp(&! f, coeff, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(is_pos, l_neg))
    let p_lo = kb_call2_f(&! f, fid_mul_down, make_name("__sounio_knight_mul_down"), coeff, t_lo)
    let p_hi = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), coeff, t_hi)
    let n_lo = kb_call2_f(&! f, fid_add_down, make_name("__sounio_knight_add_down"), lo_acc, p_lo)
    let n_hi = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), hi_acc, p_hi)
    kb_emit(&! f, ir_copy(lo_acc, n_lo))
    kb_emit(&! f, ir_copy(hi_acc, n_hi))
    kb_emit(&! f, ir_jump(l_step))

    kb_emit(&! f, ir_label(l_neg))
    let is_neg = kb_fcmp(&! f, coeff, BinaryOp::OpLt, zero_f)
    kb_emit(&! f, ir_branch_false(is_neg, l_step))
    let np_lo = kb_call2_f(&! f, fid_mul_down, make_name("__sounio_knight_mul_down"), coeff, t_hi)
    let np_hi = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), coeff, t_lo)
    let nn_lo = kb_call2_f(&! f, fid_add_down, make_name("__sounio_knight_add_down"), lo_acc, np_lo)
    let nn_hi = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), hi_acc, np_hi)
    kb_emit(&! f, ir_copy(lo_acc, nn_lo))
    kb_emit(&! f, ir_copy(hi_acc, nn_hi))

    kb_emit(&! f, ir_label(l_step))
    let idx1 = kb_iop(&! f, idx, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(idx, idx1))
    kb_emit(&! f, ir_jump(l_loop))

    kb_emit(&! f, ir_label(l_done))
    let rad = kb_iget_f(&! f, af, two_i)
    let frad = kb_is_finite(&! f, rad)
    kb_emit(&! f, ir_branch_false(frad, l_ret_vac))
    let r_nonneg = kb_fcmp(&! f, rad, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(r_nonneg, l_ret_vac))
    let l_post = kb_lbl(&! f)
    let has_rad = kb_fcmp(&! f, rad, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(has_rad, l_post))
    let mrad = kb_fneg(&! f, rad)
    let r_lo = kb_call2_f(&! f, fid_add_down, make_name("__sounio_knight_add_down"), lo_acc, mrad)
    let r_hi = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), hi_acc, rad)
    kb_emit(&! f, ir_copy(lo_acc, r_lo))
    kb_emit(&! f, ir_copy(hi_acc, r_hi))

    // Final post-condition gate: endpoints must be ordered, non-NaN, and
    // cannot exclude all reals (lo != +inf and hi != -inf).
    kb_emit(&! f, ir_label(l_post))
    let ok_ord = kb_fcmp(&! f, lo_acc, BinaryOp::OpLe, hi_acc)
    kb_emit(&! f, ir_branch_false(ok_ord, l_ret_vac))
    let lo_not_pinf = kb_fcmp(&! f, lo_acc, BinaryOp::OpLt, inf)
    kb_emit(&! f, ir_branch_false(lo_not_pinf, l_ret_vac))
    let hi_not_minf = kb_fcmp(&! f, hi_acc, BinaryOp::OpGt, minf)
    kb_emit(&! f, ir_branch_false(hi_not_minf, l_ret_vac))

    kb_fset(&! f, tup, 0, lo_acc)
    kb_fset(&! f, tup, 1, hi_acc)
    kb_emit(&! f, ir_return(tup))

    kb_emit(&! f, ir_label(l_ret_vac))
    kb_fset(&! f, tup, 0, minf)
    kb_fset(&! f, tup, 1, inf)
    kb_emit(&! f, ir_return(tup))
    ir_fn_set(m, fid as usize, f)
}

fn knight_build_binop(
    m: &! IrModule,
    fid: i64,
    fid_next_anon: i64,
    fid_sum_err_abs: i64,
    fid_prod_err_abs: i64,
    fid_add_down: i64,
    fid_add_up: i64,
    fid_mul_down: i64,
    fid_mul_up: i64,
    fid_div_down: i64,
    fid_div_up: i64,
    fid_add_term: i64,
    fid_iv: i64
) with Mut, Panic, Div, Alloc {
    // Params: 0=op_code (0=Add,1=Sub,2=Mul,3=Div), 1=lhs_kn, 2=rhs_kn, 3=dst_kn -> i64
    var f = knight_init_fn(make_name("__sounio_knight_binop"), 4, 0)
    let zero_i = kb_imm(&! f, 0)
    let one_i = kb_imm(&! f, 1)
    let two_i = kb_imm(&! f, 2)
    let three_i = kb_imm(&! f, 3)
    let four_i = kb_imm(&! f, 4)
    let five_i = kb_imm(&! f, 5)
    let zero_f = kb_fimm(&! f, 0.0)
    let one_f = kb_fimm(&! f, 1.0)
    let mone_f = kb_fimm(&! f, 0.0 - 1.0)

    // Fast path: if neither operand carries a Knightian affine form, leave dst.slot63 = 0.
    let af_a = kb_fget_i(&! f, 1, 63)
    let af_b = kb_fget_i(&! f, 2, 63)
    let l_active = kb_lbl(&! f)
    let a0 = kb_iop(&! f, af_a, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(a0, l_active))
    let b0 = kb_iop(&! f, af_b, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(b0, l_active))
    kb_fset(&! f, 3, 63, zero_i)
    kb_emit(&! f, ir_return(zero_i))

    kb_emit(&! f, ir_label(l_active))
    let res = kb_reg(&! f)
    kb_emit(&! f, ir_alloc_array(res, 2592, 324))
    kb_iset(&! f, res, zero_i, zero_f)
    kb_iset(&! f, res, one_i, zero_i)
    kb_iset(&! f, res, two_i, zero_f)
    kb_iset(&! f, res, three_i, zero_i)

    // Check vacuous propagation.
    let l_set_vac = kb_lbl(&! f)
    let l_chk_vb = kb_lbl(&! f)
    let a_nz = kb_iop(&! f, af_a, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(a_nz, l_chk_vb))
    let va = kb_iget_i(&! f, af_a, three_i)
    let va_nz = kb_iop(&! f, va, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(va_nz, l_chk_vb))
    kb_emit(&! f, ir_jump(l_set_vac))

    kb_emit(&! f, ir_label(l_chk_vb))
    let l_not_vac = kb_lbl(&! f)
    let b_nz = kb_iop(&! f, af_b, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(b_nz, l_not_vac))
    let vb = kb_iget_i(&! f, af_b, three_i)
    let vb_nz = kb_iop(&! f, vb, BinaryOp::OpNe, zero_i)
    kb_emit(&! f, ir_branch_false(vb_nz, l_not_vac))

    kb_emit(&! f, ir_label(l_set_vac))
    kb_iset(&! f, res, three_i, one_i)
    kb_fset(&! f, 3, 63, res)
    kb_emit(&! f, ir_return(zero_i))

    kb_emit(&! f, ir_label(l_not_vac))
    // Extract c_a, rad_a, c_b, rad_b
    let c_a = kb_freg(&! f)
    let rad_a = kb_freg(&! f)
    kb_emit(&! f, ir_copy(rad_a, zero_f))
    kb_emit(&! f, ir_mark_float_reg(rad_a))
    let l_ca_null = kb_lbl(&! f)
    let l_ca_done = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(a_nz, l_ca_null))
    let ca_v = kb_iget_f(&! f, af_a, zero_i)
    let ra_v = kb_iget_f(&! f, af_a, two_i)
    kb_emit(&! f, ir_copy(c_a, ca_v))
    kb_emit(&! f, ir_copy(rad_a, ra_v))
    kb_emit(&! f, ir_jump(l_ca_done))
    kb_emit(&! f, ir_label(l_ca_null))
    let lv = kb_fget_f(&! f, 1, 0)
    kb_emit(&! f, ir_copy(c_a, lv))
    kb_emit(&! f, ir_label(l_ca_done))

    let c_b = kb_freg(&! f)
    let rad_b = kb_freg(&! f)
    kb_emit(&! f, ir_copy(rad_b, zero_f))
    kb_emit(&! f, ir_mark_float_reg(rad_b))
    let l_cb_null = kb_lbl(&! f)
    let l_cb_done = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(b_nz, l_cb_null))
    let cb_v = kb_iget_f(&! f, af_b, zero_i)
    let rb_v = kb_iget_f(&! f, af_b, two_i)
    kb_emit(&! f, ir_copy(c_b, cb_v))
    kb_emit(&! f, ir_copy(rad_b, rb_v))
    kb_emit(&! f, ir_jump(l_cb_done))
    kb_emit(&! f, ir_label(l_cb_null))
    let rv = kb_fget_f(&! f, 2, 0)
    kb_emit(&! f, ir_copy(c_b, rv))
    kb_emit(&! f, ir_label(l_cb_done))

    // Fail closed if any center or radius is non-finite or negative.
    let fca = kb_is_finite(&! f, c_a)
    kb_emit(&! f, ir_branch_false(fca, l_set_vac))
    let fcb = kb_is_finite(&! f, c_b)
    kb_emit(&! f, ir_branch_false(fcb, l_set_vac))
    let fra = kb_is_finite(&! f, rad_a)
    kb_emit(&! f, ir_branch_false(fra, l_set_vac))
    let frb = kb_is_finite(&! f, rad_b)
    kb_emit(&! f, ir_branch_false(frb, l_set_vac))
    let ra_ok = kb_fcmp(&! f, rad_a, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(ra_ok, l_set_vac))
    let rb_ok = kb_fcmp(&! f, rad_b, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(rb_ok, l_set_vac))

    // Dispatch on op_code: 0=Add, 1=Sub, 2=Mul, 3=Div
    let l_mul = kb_lbl(&! f)
    let l_div = kb_lbl(&! f)
    let is_lin = kb_iop(&! f, 0, BinaryOp::OpLt, two_i)
    kb_emit(&! f, ir_branch_false(is_lin, l_mul))

    // ------------------------------------------------------------------------
    // Linear ops: Add (0) / Sub (1) — exact affine dependency algebra
    // ------------------------------------------------------------------------
    let is_sub = kb_iop(&! f, 0, BinaryOp::OpEq, one_i)
    let sb = kb_freg(&! f)
    kb_emit(&! f, ir_copy(sb, c_b))
    kb_emit(&! f, ir_mark_float_reg(sb))
    let l_sb_done = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(is_sub, l_sb_done))
    let ncb = kb_fneg(&! f, c_b)
    kb_emit(&! f, ir_copy(sb, ncb))
    kb_emit(&! f, ir_label(l_sb_done))

    let c_sum = kb_fop(&! f, c_a, BinaryOp::OpAdd, sb)
    let fcs = kb_is_finite(&! f, c_sum)
    kb_emit(&! f, ir_branch_false(fcs, l_set_vac))
    let c_err = kb_call2_f(&! f, fid_sum_err_abs, make_name("__sounio_knight_sum_err_abs"), c_a, sb)
    let r_ab = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), rad_a, rad_b)
    let r_tot = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), r_ab, c_err)
    let frt = kb_is_finite(&! f, r_tot)
    kb_emit(&! f, ir_branch_false(frt, l_set_vac))
    kb_iset(&! f, res, zero_i, c_sum)
    kb_iset(&! f, res, two_i, r_tot)

    // Copy terms from af_a
    let l_lin_b = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(a_nz, l_lin_b))
    let na = kb_iget_i(&! f, af_a, one_i)
    let ia = kb_imm(&! f, 0)
    let l_la = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_la))
    let ca_cond = kb_iop(&! f, ia, BinaryOp::OpLt, na)
    kb_emit(&! f, ir_branch_false(ca_cond, l_lin_b))
    let ta5 = kb_iop(&! f, ia, BinaryOp::OpMul, five_i)
    let ba = kb_iop(&! f, four_i, BinaryOp::OpAdd, ta5)
    let ba1 = kb_iop(&! f, ba, BinaryOp::OpAdd, one_i)
    let ba2 = kb_iop(&! f, ba, BinaryOp::OpAdd, two_i)
    let ba3 = kb_iop(&! f, ba, BinaryOp::OpAdd, three_i)
    let ba4 = kb_iop(&! f, ba, BinaryOp::OpAdd, four_i)
    let anm = kb_iget_i(&! f, af_a, ba)
    let aan = kb_iget_i(&! f, af_a, ba1)
    let acf = kb_iget_f(&! f, af_a, ba2)
    let alo = kb_iget_f(&! f, af_a, ba3)
    let ahi = kb_iget_f(&! f, af_a, ba4)
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, anm, aan, acf, alo, ahi)
    let ia1 = kb_iop(&! f, ia, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(ia, ia1))
    kb_emit(&! f, ir_jump(l_la))

    // Add (or subtract) terms from af_b
    kb_emit(&! f, ir_label(l_lin_b))
    let l_lin_done = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(b_nz, l_lin_done))
    let nb = kb_iget_i(&! f, af_b, one_i)
    let ib = kb_imm(&! f, 0)
    let l_lb = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_lb))
    let cb_cond = kb_iop(&! f, ib, BinaryOp::OpLt, nb)
    kb_emit(&! f, ir_branch_false(cb_cond, l_lin_done))
    let tb5 = kb_iop(&! f, ib, BinaryOp::OpMul, five_i)
    let bb = kb_iop(&! f, four_i, BinaryOp::OpAdd, tb5)
    let bb1 = kb_iop(&! f, bb, BinaryOp::OpAdd, one_i)
    let bb2 = kb_iop(&! f, bb, BinaryOp::OpAdd, two_i)
    let bb3 = kb_iop(&! f, bb, BinaryOp::OpAdd, three_i)
    let bb4 = kb_iop(&! f, bb, BinaryOp::OpAdd, four_i)
    let bnm = kb_iget_i(&! f, af_b, bb)
    let ban = kb_iget_i(&! f, af_b, bb1)
    let bcf_raw = kb_iget_f(&! f, af_b, bb2)
    let blo = kb_iget_f(&! f, af_b, bb3)
    let bhi = kb_iget_f(&! f, af_b, bb4)
    let bcf = kb_freg(&! f)
    kb_emit(&! f, ir_copy(bcf, bcf_raw))
    kb_emit(&! f, ir_mark_float_reg(bcf))
    let l_bcf_ok = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(is_sub, l_bcf_ok))
    let nbcf = kb_fneg(&! f, bcf_raw)
    kb_emit(&! f, ir_copy(bcf, nbcf))
    kb_emit(&! f, ir_label(l_bcf_ok))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, bnm, ban, bcf, blo, bhi)
    let ib1 = kb_iop(&! f, ib, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(ib, ib1))
    kb_emit(&! f, ir_jump(l_lb))

    kb_emit(&! f, ir_label(l_lin_done))
    kb_fset(&! f, 3, 63, res)
    kb_emit(&! f, ir_return(zero_i))

    // ------------------------------------------------------------------------
    // Mul (2): linear fast path when one operand is exact scalar (af == 0);
    //          otherwise Comba-Stolfi nonlinear mul with fresh anonymous symbol.
    // ------------------------------------------------------------------------
    kb_emit(&! f, ir_label(l_mul))
    let is_mul = kb_iop(&! f, 0, BinaryOp::OpEq, two_i)
    kb_emit(&! f, ir_branch_false(is_mul, l_div))

    let l_mul_nl = kb_lbl(&! f)
    let l_mul_scale = kb_lbl(&! f)
    let l_mul_scale_b = kb_lbl(&! f)
    let sc_af = kb_reg(&! f)
    let sc_c = kb_freg(&! f)
    let sc_rad = kb_freg(&! f)
    let sc_k = kb_freg(&! f)

    // If af_b == 0 -> scale af_a by c_b
    let b_is_0 = kb_iop(&! f, af_b, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(b_is_0, l_mul_scale_b))
    kb_emit(&! f, ir_copy(sc_af, af_a))
    kb_emit(&! f, ir_copy(sc_c, c_a))
    kb_emit(&! f, ir_copy(sc_rad, rad_a))
    kb_emit(&! f, ir_copy(sc_k, c_b))
    kb_emit(&! f, ir_jump(l_mul_scale))

    // Else if af_a == 0 -> scale af_b by c_a
    kb_emit(&! f, ir_label(l_mul_scale_b))
    let a_is_0 = kb_iop(&! f, af_a, BinaryOp::OpEq, zero_i)
    kb_emit(&! f, ir_branch_false(a_is_0, l_mul_nl))
    kb_emit(&! f, ir_copy(sc_af, af_b))
    kb_emit(&! f, ir_copy(sc_c, c_b))
    kb_emit(&! f, ir_copy(sc_rad, rad_b))
    kb_emit(&! f, ir_copy(sc_k, c_a))

    // Exact-scalar linear scaling: sc_af * sc_k
    kb_emit(&! f, ir_label(l_mul_scale))
    let sc_c_new = kb_fop(&! f, sc_c, BinaryOp::OpMul, sc_k)
    let fscn = kb_is_finite(&! f, sc_c_new)
    kb_emit(&! f, ir_branch_false(fscn, l_set_vac))
    let sc_ce = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), sc_c, sc_k)
    let abs_sck = kb_fabs(&! f, sc_k)
    let sc_r0 = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), abs_sck, sc_rad)
    let sc_r1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), sc_r0, sc_ce)
    let fscr1 = kb_is_finite(&! f, sc_r1)
    kb_emit(&! f, ir_branch_false(fscr1, l_set_vac))
    kb_iset(&! f, res, zero_i, sc_c_new)
    kb_iset(&! f, res, two_i, sc_r1)

    let sc_n = kb_iget_i(&! f, sc_af, one_i)
    let sc_i = kb_imm(&! f, 0)
    let l_sc_loop = kb_lbl(&! f)
    let l_sc_done = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_sc_loop))
    let sc_cond = kb_iop(&! f, sc_i, BinaryOp::OpLt, sc_n)
    kb_emit(&! f, ir_branch_false(sc_cond, l_sc_done))
    let sc_t5 = kb_iop(&! f, sc_i, BinaryOp::OpMul, five_i)
    let sc_b = kb_iop(&! f, four_i, BinaryOp::OpAdd, sc_t5)
    let sc_b1 = kb_iop(&! f, sc_b, BinaryOp::OpAdd, one_i)
    let sc_b2 = kb_iop(&! f, sc_b, BinaryOp::OpAdd, two_i)
    let sc_b3 = kb_iop(&! f, sc_b, BinaryOp::OpAdd, three_i)
    let sc_b4 = kb_iop(&! f, sc_b, BinaryOp::OpAdd, four_i)
    let sc_nm = kb_iget_i(&! f, sc_af, sc_b)
    let sc_an = kb_iget_i(&! f, sc_af, sc_b1)
    let sc_cf = kb_iget_f(&! f, sc_af, sc_b2)
    let sc_lo = kb_iget_f(&! f, sc_af, sc_b3)
    let sc_hi = kb_iget_f(&! f, sc_af, sc_b4)
    let sc_ncf = kb_fop(&! f, sc_cf, BinaryOp::OpMul, sc_k)
    let fsc_ncf = kb_is_finite(&! f, sc_ncf)
    kb_emit(&! f, ir_branch_false(fsc_ncf, l_set_vac))
    let sc_pe = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), sc_cf, sc_k)
    let fsc_pe = kb_is_finite(&! f, sc_pe)
    kb_emit(&! f, ir_branch_false(fsc_pe, l_set_vac))
    let l_sc_nobump = kb_lbl(&! f)
    let sc_pe_pos = kb_fcmp(&! f, sc_pe, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(sc_pe_pos, l_sc_nobump))
    let sc_alo = kb_fabs(&! f, sc_lo)
    let sc_ahi = kb_fabs(&! f, sc_hi)
    let sc_bnd = kb_fmax(&! f, sc_alo, sc_ahi)
    let sc_bmp = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), sc_pe, sc_bnd)
    let sc_orad = kb_iget_f(&! f, res, two_i)
    let sc_nrad = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), sc_orad, sc_bmp)
    let fsc_nr = kb_is_finite(&! f, sc_nrad)
    kb_emit(&! f, ir_branch_false(fsc_nr, l_set_vac))
    kb_iset(&! f, res, two_i, sc_nrad)
    kb_emit(&! f, ir_label(l_sc_nobump))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, sc_nm, sc_an, sc_ncf, sc_lo, sc_hi)
    let sc_i1 = kb_iop(&! f, sc_i, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(sc_i, sc_i1))
    kb_emit(&! f, ir_jump(l_sc_loop))

    kb_emit(&! f, ir_label(l_sc_done))
    kb_fset(&! f, 3, 63, res)
    kb_emit(&! f, ir_return(zero_i))

    // General nonlinear Comba-Stolfi Mul (both af_a != 0 and af_b != 0).
    kb_emit(&! f, ir_label(l_mul_nl))
    let iva = kb_call1_i(&! f, fid_iv, make_name("__sounio_knight_iv"), 1)
    let loa = kb_fget_f(&! f, iva, 0)
    let hia = kb_fget_f(&! f, iva, 1)
    let fl_a = kb_is_finite(&! f, loa)
    kb_emit(&! f, ir_branch_false(fl_a, l_set_vac))
    let fh_a = kb_is_finite(&! f, hia)
    kb_emit(&! f, ir_branch_false(fh_a, l_set_vac))
    let oa = kb_fcmp(&! f, loa, BinaryOp::OpLe, hia)
    kb_emit(&! f, ir_branch_false(oa, l_set_vac))
    let mua = kb_safe_mid(&! f, loa, hia)
    let m_mua = kb_fneg(&! f, mua)
    let m_loa = kb_fneg(&! f, loa)
    let ra1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), hia, m_mua)
    let ra2 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), mua, m_loa)
    let R_a = kb_fmax(&! f, ra1, ra2)
    let fRa = kb_is_finite(&! f, R_a)
    kb_emit(&! f, ir_branch_false(fRa, l_set_vac))

    let ivb = kb_call1_i(&! f, fid_iv, make_name("__sounio_knight_iv"), 2)
    let lob = kb_fget_f(&! f, ivb, 0)
    let hib = kb_fget_f(&! f, ivb, 1)
    let fl_b = kb_is_finite(&! f, lob)
    kb_emit(&! f, ir_branch_false(fl_b, l_set_vac))
    let fh_b = kb_is_finite(&! f, hib)
    kb_emit(&! f, ir_branch_false(fh_b, l_set_vac))
    let ob = kb_fcmp(&! f, lob, BinaryOp::OpLe, hib)
    kb_emit(&! f, ir_branch_false(ob, l_set_vac))
    let mub = kb_safe_mid(&! f, lob, hib)
    let m_mub = kb_fneg(&! f, mub)
    let m_lob = kb_fneg(&! f, lob)
    let rb1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), hib, m_mub)
    let rb2 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), mub, m_lob)
    let R_b = kb_fmax(&! f, rb1, rb2)
    let fRb = kb_is_finite(&! f, R_b)
    kb_emit(&! f, ir_branch_false(fRb, l_set_vac))

    // c_res = mub * c_a + mua * c_b - mua * mub (with certified prod/sum error bounds)
    let p1 = kb_fop(&! f, mub, BinaryOp::OpMul, c_a)
    let e1 = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), mub, c_a)
    let p2 = kb_fop(&! f, mua, BinaryOp::OpMul, c_b)
    let e2 = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), mua, c_b)
    let p3 = kb_fop(&! f, mua, BinaryOp::OpMul, mub)
    let e3 = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), mua, mub)
    let s12 = kb_fop(&! f, p1, BinaryOp::OpAdd, p2)
    let e12 = kb_call2_f(&! f, fid_sum_err_abs, make_name("__sounio_knight_sum_err_abs"), p1, p2)
    let mp3 = kb_fneg(&! f, p3)
    let c_mul = kb_fop(&! f, s12, BinaryOp::OpAdd, mp3)
    let fcmul = kb_is_finite(&! f, c_mul)
    kb_emit(&! f, ir_branch_false(fcmul, l_set_vac))
    let e123 = kb_call2_f(&! f, fid_sum_err_abs, make_name("__sounio_knight_sum_err_abs"), s12, mp3)
    kb_iset(&! f, res, zero_i, c_mul)

    let nl_rad = kb_freg(&! f)
    let r_ab_nl = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), R_a, R_b)
    let e_a = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), e1, e2)
    let e_b = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), e3, e12)
    let e_c = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), e_a, e_b)
    let e_d = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), e_c, e123)
    let amub = kb_fabs(&! f, mub)
    let amua = kb_fabs(&! f, mua)
    let er_ra = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), amub, rad_a)
    let er_rb = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), amua, rad_b)
    let er_r = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), er_ra, er_rb)
    let nl0 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), r_ab_nl, e_d)
    let nl1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), nl0, er_r)
    let fnl1 = kb_is_finite(&! f, nl1)
    kb_emit(&! f, ir_branch_false(fnl1, l_set_vac))
    kb_emit(&! f, ir_copy(nl_rad, nl1))
    kb_emit(&! f, ir_mark_float_reg(nl_rad))

    // Scale terms of af_a by mub
    let l_mul_b = kb_lbl(&! f)
    let mna = kb_iget_i(&! f, af_a, one_i)
    let mia = kb_imm(&! f, 0)
    let l_mla = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_mla))
    let mca = kb_iop(&! f, mia, BinaryOp::OpLt, mna)
    kb_emit(&! f, ir_branch_false(mca, l_mul_b))
    let mta5 = kb_iop(&! f, mia, BinaryOp::OpMul, five_i)
    let mba = kb_iop(&! f, four_i, BinaryOp::OpAdd, mta5)
    let mba1 = kb_iop(&! f, mba, BinaryOp::OpAdd, one_i)
    let mba2 = kb_iop(&! f, mba, BinaryOp::OpAdd, two_i)
    let mba3 = kb_iop(&! f, mba, BinaryOp::OpAdd, three_i)
    let mba4 = kb_iop(&! f, mba, BinaryOp::OpAdd, four_i)
    let manm = kb_iget_i(&! f, af_a, mba)
    let maan = kb_iget_i(&! f, af_a, mba1)
    let macf = kb_iget_f(&! f, af_a, mba2)
    let malo = kb_iget_f(&! f, af_a, mba3)
    let mahi = kb_iget_f(&! f, af_a, mba4)
    let mscf = kb_fop(&! f, mub, BinaryOp::OpMul, macf)
    let fmscf = kb_is_finite(&! f, mscf)
    kb_emit(&! f, ir_branch_false(fmscf, l_set_vac))
    let mse = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), mub, macf)
    let amalo = kb_fabs(&! f, malo)
    let amahi = kb_fabs(&! f, mahi)
    let mabnd = kb_fmax(&! f, amalo, amahi)
    let mbump = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), mse, mabnd)
    let nl_a_new = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), nl_rad, mbump)
    let fnla = kb_is_finite(&! f, nl_a_new)
    kb_emit(&! f, ir_branch_false(fnla, l_set_vac))
    kb_emit(&! f, ir_copy(nl_rad, nl_a_new))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, manm, maan, mscf, malo, mahi)
    let mia1 = kb_iop(&! f, mia, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(mia, mia1))
    kb_emit(&! f, ir_jump(l_mla))

    // Scale terms of af_b by mua
    kb_emit(&! f, ir_label(l_mul_b))
    let l_mul_rem = kb_lbl(&! f)
    let mnb = kb_iget_i(&! f, af_b, one_i)
    let mib = kb_imm(&! f, 0)
    let l_mlb = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_mlb))
    let mcb = kb_iop(&! f, mib, BinaryOp::OpLt, mnb)
    kb_emit(&! f, ir_branch_false(mcb, l_mul_rem))
    let mtb5 = kb_iop(&! f, mib, BinaryOp::OpMul, five_i)
    let mbb = kb_iop(&! f, four_i, BinaryOp::OpAdd, mtb5)
    let mbb1 = kb_iop(&! f, mbb, BinaryOp::OpAdd, one_i)
    let mbb2 = kb_iop(&! f, mbb, BinaryOp::OpAdd, two_i)
    let mbb3 = kb_iop(&! f, mbb, BinaryOp::OpAdd, three_i)
    let mbb4 = kb_iop(&! f, mbb, BinaryOp::OpAdd, four_i)
    let mbnm = kb_iget_i(&! f, af_b, mbb)
    let mban = kb_iget_i(&! f, af_b, mbb1)
    let mbcf = kb_iget_f(&! f, af_b, mbb2)
    let mblo = kb_iget_f(&! f, af_b, mbb3)
    let mbhi = kb_iget_f(&! f, af_b, mbb4)
    let mbscf = kb_fop(&! f, mua, BinaryOp::OpMul, mbcf)
    let fmbscf = kb_is_finite(&! f, mbscf)
    kb_emit(&! f, ir_branch_false(fmbscf, l_set_vac))
    let mbse = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), mua, mbcf)
    let amblo = kb_fabs(&! f, mblo)
    let ambhi = kb_fabs(&! f, mbhi)
    let mbbnd = kb_fmax(&! f, amblo, ambhi)
    let mbbump = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), mbse, mbbnd)
    let nl_b_new = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), nl_rad, mbbump)
    let fnlb = kb_is_finite(&! f, nl_b_new)
    kb_emit(&! f, ir_branch_false(fnlb, l_set_vac))
    kb_emit(&! f, ir_copy(nl_rad, nl_b_new))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, mbnm, mban, mbscf, mblo, mbhi)
    let mib1 = kb_iop(&! f, mib, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(mib, mib1))
    kb_emit(&! f, ir_jump(l_mlb))

    // Fail-closed check on nl_rad before adding fresh anonymous symbol:
    // NaN, inf, or negative nl_rad marks res vacuous (never silently dropped!).
    kb_emit(&! f, ir_label(l_mul_rem))
    let fnlr = kb_is_finite(&! f, nl_rad)
    kb_emit(&! f, ir_branch_false(fnlr, l_set_vac))
    let nl_nonneg = kb_fcmp(&! f, nl_rad, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(nl_nonneg, l_set_vac))
    let l_mul_done = kb_lbl(&! f)
    let has_nl = kb_fcmp(&! f, nl_rad, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(has_nl, l_mul_done))
    let fresh_id = kb_call0_i(&! f, fid_next_anon, make_name("__sounio_knight_next_anon"))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, zero_i, fresh_id, nl_rad, mone_f, one_f)
    kb_emit(&! f, ir_label(l_mul_done))
    kb_fset(&! f, 3, 63, res)
    kb_emit(&! f, ir_return(zero_i))

    // ------------------------------------------------------------------------
    // Non-linear Div (3): certified monotone affine reciprocal + Mul
    // ------------------------------------------------------------------------
    kb_emit(&! f, ir_label(l_div))
    let div_ivb = kb_call1_i(&! f, fid_iv, make_name("__sounio_knight_iv"), 2)
    let d_lo = kb_fget_f(&! f, div_ivb, 0)
    let d_hi = kb_fget_f(&! f, div_ivb, 1)
    let fdlo = kb_is_finite(&! f, d_lo)
    kb_emit(&! f, ir_branch_false(fdlo, l_set_vac))
    let fdhi = kb_is_finite(&! f, d_hi)
    kb_emit(&! f, ir_branch_false(fdhi, l_set_vac))
    let dord = kb_fcmp(&! f, d_lo, BinaryOp::OpLe, d_hi)
    kb_emit(&! f, ir_branch_false(dord, l_set_vac))

    // If divisor interval encloses 0 -> vacuous [-inf, +inf].
    let l_div_ok = kb_lbl(&! f)
    let le0 = kb_fcmp(&! f, d_lo, BinaryOp::OpLe, zero_f)
    kb_emit(&! f, ir_branch_false(le0, l_div_ok))
    let ge0 = kb_fcmp(&! f, d_hi, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(ge0, l_div_ok))
    kb_emit(&! f, ir_jump(l_set_vac))

    kb_emit(&! f, ir_label(l_div_ok))
    // Determine positive range [u, v] with 0 < u <= v (neg_b = 1 if d_hi < 0).
    let neg_b = kb_fcmp(&! f, d_hi, BinaryOp::OpLt, zero_f)
    let u = kb_freg(&! f)
    let v = kb_freg(&! f)
    kb_emit(&! f, ir_copy(u, d_lo))
    kb_emit(&! f, ir_mark_float_reg(u))
    kb_emit(&! f, ir_copy(v, d_hi))
    kb_emit(&! f, ir_mark_float_reg(v))
    let l_uv_ok = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(neg_b, l_uv_ok))
    let ndh = kb_fneg(&! f, d_hi)
    let ndl = kb_fneg(&! f, d_lo)
    kb_emit(&! f, ir_copy(u, ndh))
    kb_emit(&! f, ir_copy(v, ndl))
    kb_emit(&! f, ir_label(l_uv_ok))

    // Min-range affine reciprocal of y in [u, v] (fail-closed on extreme overflow).
    let v2_up = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), v, v)
    let fv2 = kb_is_finite(&! f, v2_up)
    kb_emit(&! f, ir_branch_false(fv2, l_set_vac))
    let a_pos = kb_call2_f(&! f, fid_div_down, make_name("__sounio_knight_div_down"), one_f, v2_up)
    let fap = kb_is_finite(&! f, a_pos)
    kb_emit(&! f, ir_branch_false(fap, l_set_vac))
    let slope = kb_fneg(&! f, a_pos)
    let inv_v_lo = kb_call2_f(&! f, fid_div_down, make_name("__sounio_knight_div_down"), one_f, v)
    let ap_v_lo = kb_call2_f(&! f, fid_mul_down, make_name("__sounio_knight_mul_down"), a_pos, v)
    let g_lo = kb_call2_f(&! f, fid_add_down, make_name("__sounio_knight_add_down"), inv_v_lo, ap_v_lo)
    let fglo = kb_is_finite(&! f, g_lo)
    kb_emit(&! f, ir_branch_false(fglo, l_set_vac))
    let inv_u_hi = kb_call2_f(&! f, fid_div_up, make_name("__sounio_knight_div_up"), one_f, u)
    let ap_u_hi = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), a_pos, u)
    let g_hi = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), inv_u_hi, ap_u_hi)
    let fghi = kb_is_finite(&! f, g_hi)
    kb_emit(&! f, ir_branch_false(fghi, l_set_vac))
    let zeta = kb_safe_mid(&! f, g_lo, g_hi)
    let m_zeta = kb_fneg(&! f, zeta)
    let m_glo = kb_fneg(&! f, g_lo)
    let d1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), g_hi, m_zeta)
    let d2 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), zeta, m_glo)
    let delta = kb_freg(&! f)
    let d_init = kb_fmax(&! f, d1, d2)
    let fdi = kb_is_finite(&! f, d_init)
    kb_emit(&! f, ir_branch_false(fdi, l_set_vac))
    kb_emit(&! f, ir_copy(delta, d_init))
    kb_emit(&! f, ir_mark_float_reg(delta))

    let s_zeta = kb_freg(&! f)
    kb_emit(&! f, ir_copy(s_zeta, zeta))
    kb_emit(&! f, ir_mark_float_reg(s_zeta))
    let l_sz_ok = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(neg_b, l_sz_ok))
    kb_emit(&! f, ir_copy(s_zeta, m_zeta))
    kb_emit(&! f, ir_label(l_sz_ok))

    // Build inv_af = slope * b + s_zeta + delta * eps_fresh
    let sc_cb = kb_fop(&! f, slope, BinaryOp::OpMul, c_b)
    let e_scb = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), slope, c_b)
    let inv_c = kb_fop(&! f, sc_cb, BinaryOp::OpAdd, s_zeta)
    let finvc = kb_is_finite(&! f, inv_c)
    kb_emit(&! f, ir_branch_false(finvc, l_set_vac))
    let e_ic = kb_call2_f(&! f, fid_sum_err_abs, make_name("__sounio_knight_sum_err_abs"), sc_cb, s_zeta)
    let e_rb = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), a_pos, rad_b)
    let de1 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), delta, e_scb)
    let de2 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), de1, e_ic)
    let de3 = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), de2, e_rb)
    let fde3 = kb_is_finite(&! f, de3)
    kb_emit(&! f, ir_branch_false(fde3, l_set_vac))
    kb_emit(&! f, ir_copy(delta, de3))
    kb_iset(&! f, res, zero_i, inv_c)

    let l_div_rem = kb_lbl(&! f)
    kb_emit(&! f, ir_branch_false(b_nz, l_div_rem))
    let dnb = kb_iget_i(&! f, af_b, one_i)
    let dib = kb_imm(&! f, 0)
    let l_dlb = kb_lbl(&! f)
    kb_emit(&! f, ir_label(l_dlb))
    let dcb = kb_iop(&! f, dib, BinaryOp::OpLt, dnb)
    kb_emit(&! f, ir_branch_false(dcb, l_div_rem))
    let dtb5 = kb_iop(&! f, dib, BinaryOp::OpMul, five_i)
    let dbb = kb_iop(&! f, four_i, BinaryOp::OpAdd, dtb5)
    let dbb1 = kb_iop(&! f, dbb, BinaryOp::OpAdd, one_i)
    let dbb2 = kb_iop(&! f, dbb, BinaryOp::OpAdd, two_i)
    let dbb3 = kb_iop(&! f, dbb, BinaryOp::OpAdd, three_i)
    let dbb4 = kb_iop(&! f, dbb, BinaryOp::OpAdd, four_i)
    let dbnm = kb_iget_i(&! f, af_b, dbb)
    let dban = kb_iget_i(&! f, af_b, dbb1)
    let dbcf = kb_iget_f(&! f, af_b, dbb2)
    let dblo = kb_iget_f(&! f, af_b, dbb3)
    let dbhi = kb_iget_f(&! f, af_b, dbb4)
    let dscf = kb_fop(&! f, slope, BinaryOp::OpMul, dbcf)
    let fdscf = kb_is_finite(&! f, dscf)
    kb_emit(&! f, ir_branch_false(fdscf, l_set_vac))
    let dse = kb_call2_f(&! f, fid_prod_err_abs, make_name("__sounio_knight_prod_err_abs"), slope, dbcf)
    let adblo = kb_fabs(&! f, dblo)
    let adbhi = kb_fabs(&! f, dbhi)
    let dbnd = kb_fmax(&! f, adblo, adbhi)
    let dbump = kb_call2_f(&! f, fid_mul_up, make_name("__sounio_knight_mul_up"), dse, dbnd)
    let d_new = kb_call2_f(&! f, fid_add_up, make_name("__sounio_knight_add_up"), delta, dbump)
    let fdnew = kb_is_finite(&! f, d_new)
    kb_emit(&! f, ir_branch_false(fdnew, l_set_vac))
    kb_emit(&! f, ir_copy(delta, d_new))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, dbnm, dban, dscf, dblo, dbhi)
    let dib1 = kb_iop(&! f, dib, BinaryOp::OpAdd, one_i)
    kb_emit(&! f, ir_copy(dib, dib1))
    kb_emit(&! f, ir_jump(l_dlb))

    kb_emit(&! f, ir_label(l_div_rem))
    let fdel = kb_is_finite(&! f, delta)
    kb_emit(&! f, ir_branch_false(fdel, l_set_vac))
    let d_nonneg = kb_fcmp(&! f, delta, BinaryOp::OpGe, zero_f)
    kb_emit(&! f, ir_branch_false(d_nonneg, l_set_vac))
    let l_div_mul = kb_lbl(&! f)
    let has_d = kb_fcmp(&! f, delta, BinaryOp::OpGt, zero_f)
    kb_emit(&! f, ir_branch_false(has_d, l_div_mul))
    let div_fresh = kb_call0_i(&! f, fid_next_anon, make_name("__sounio_knight_next_anon"))
    let _ = kb_call6_i(&! f, fid_add_term, make_name("__sounio_knight_af_add_term"), res, zero_i, div_fresh, delta, mone_f, one_f)

    kb_emit(&! f, ir_label(l_div_mul))
    let inv_kn = kb_reg(&! f)
    kb_emit(&! f, ir_alloc(inv_kn, 0))
    let rhs_v = kb_fget_f(&! f, 2, 0)
    let inv_v = kb_fop(&! f, one_f, BinaryOp::OpDiv, rhs_v)
    kb_fset(&! f, inv_kn, 0, inv_v)
    kb_fset(&! f, inv_kn, 1, zero_f)
    kb_fset(&! f, inv_kn, 2, zero_f)
    kb_fset(&! f, inv_kn, 63, res)
    // Multiply a * inv_b into dst_kn (3)
    let _ = kb_call4_i(&! f, fid, make_name("__sounio_knight_binop"), two_i, 1, inv_kn, 3)
    kb_emit(&! f, ir_return(zero_i))
    ir_fn_set(m, fid as usize, f)
}

// ============================================================================
// Public entry point: ensure all Knightian runtime helpers exist in `m`
// ============================================================================

pub struct KnightRuntimeIds {
    pub fid_new: i64,
    pub fid_binop: i64,
    pub fid_iv: i64,
}

pub fn ir_ensure_knight_runtime(m: &! IrModule) -> KnightRuntimeIds with Mut, Panic, Div, Alloc {
    let fid_new = knight_find_or_reserve_fn(m, make_name("__sounio_knight_new"))
    let fid_binop = knight_find_or_reserve_fn(m, make_name("__sounio_knight_binop"))
    let fid_iv = knight_find_or_reserve_fn(m, make_name("__sounio_knight_iv"))
    if ir_fn_get(&(*m), fid_new as usize).instr_count > 0 {
        return KnightRuntimeIds { fid_new: fid_new, fid_binop: fid_binop, fid_iv: fid_iv }
    }
    let fid_str_eq = knight_find_or_reserve_fn(m, make_name("str_eq"))
    let fid_next_anon = knight_find_or_reserve_fn(m, make_name("__sounio_knight_next_anon"))
    let fid_se_down = knight_find_or_reserve_fn(m, make_name("__sounio_knight_se_down"))
    let fid_se_up = knight_find_or_reserve_fn(m, make_name("__sounio_knight_se_up"))
    let fid_tse = knight_find_or_reserve_fn(m, make_name("__sounio_knight_two_sum_err"))
    let fid_sum_err_abs = knight_find_or_reserve_fn(m, make_name("__sounio_knight_sum_err_abs"))
    let fid_add_down = knight_find_or_reserve_fn(m, make_name("__sounio_knight_add_down"))
    let fid_add_up = knight_find_or_reserve_fn(m, make_name("__sounio_knight_add_up"))
    let fid_tpe = knight_find_or_reserve_fn(m, make_name("__sounio_knight_two_prod_err"))
    let fid_prod_err_abs = knight_find_or_reserve_fn(m, make_name("__sounio_knight_prod_err_abs"))
    let fid_mul_down = knight_find_or_reserve_fn(m, make_name("__sounio_knight_mul_down"))
    let fid_mul_up = knight_find_or_reserve_fn(m, make_name("__sounio_knight_mul_up"))
    let fid_div_down = knight_find_or_reserve_fn(m, make_name("__sounio_knight_div_down"))
    let fid_div_up = knight_find_or_reserve_fn(m, make_name("__sounio_knight_div_up"))
    let fid_add_term = knight_find_or_reserve_fn(m, make_name("__sounio_knight_af_add_term"))

    knight_build_next_anon(m, fid_next_anon)
    knight_build_se_down(m, fid_se_down)
    knight_build_se_up(m, fid_se_up)
    knight_build_two_sum_err(m, fid_tse)
    knight_build_sum_err_abs(m, fid_sum_err_abs, fid_tse)
    knight_build_add_dir(m, fid_add_down, false, fid_tse, fid_se_down)
    knight_build_add_dir(m, fid_add_up, true, fid_tse, fid_se_up)
    knight_build_two_prod_err(m, fid_tpe)
    knight_build_prod_err_abs(m, fid_prod_err_abs, fid_tpe)
    knight_build_mul_dir(m, fid_mul_down, false, fid_tpe, fid_se_down)
    knight_build_mul_dir(m, fid_mul_up, true, fid_tpe, fid_se_up)
    knight_build_div_dir(m, fid_div_down, false, fid_tpe, fid_se_down)
    knight_build_div_dir(m, fid_div_up, true, fid_tpe, fid_se_up)
    knight_build_af_add_term(m, fid_add_term, fid_str_eq, fid_sum_err_abs, fid_add_up, fid_mul_up)
    knight_build_new(m, fid_new)
    knight_build_iv(m, fid_iv, fid_add_down, fid_add_up, fid_mul_down, fid_mul_up)
    knight_build_binop(
        m,
        fid_binop,
        fid_next_anon,
        fid_sum_err_abs,
        fid_prod_err_abs,
        fid_add_down,
        fid_add_up,
        fid_mul_down,
        fid_mul_up,
        fid_div_down,
        fid_div_up,
        fid_add_term,
        fid_iv
    )
    KnightRuntimeIds { fid_new: fid_new, fid_binop: fid_binop, fid_iv: fid_iv }
}
