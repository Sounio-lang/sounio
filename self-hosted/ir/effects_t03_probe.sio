use ir::ir::*
use ir::effects::*

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("t03: start\n")
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(7)))
    print("t03: list built\n")
    let ins = ir_call_extern(3, ir_empty_name(), args, 1)
    print("t03: instr built\n")
    var f = ir_empty_function()
    print("t03: fn built\n")
    ir_arena_store(ir_region_slot_w(f.region, (0)), ins)
    f.instr_count = 1
    print("t03: stored\n")
    let at = ir_region_slot_r(f.region, (0))
    let a0 = ir_arena_arg_at(at, 0)
    print("t03: arg0=")
    print_int(a0)
    print("\n")
    let ok = ir_effect_reads_reg_at(at, 7) && !ir_effect_reads_reg_at(at, 3)
    if ok { print("t03: PASS\n") 0 } else { print("t03: FAIL\n") 1 }
}
