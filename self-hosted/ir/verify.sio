// IR verification pipeline for correctness validation
//
// This module provides functions to verify IR semantic equivalence
// between two programs by comparing their normalized serialized forms.

// Verify two IR modules are semantically equivalent
// Returns 0 if equivalent, non-zero error code otherwise
fn verify_ir_equivalence(module_a: IrModule, module_b: IrModule) -> i64 with Mut, Panic, Div, Alloc {
    // Step 1: Serialize both modules
    let pair_a = serialize_ir_module(module_a)
    let buf_a = pair_a.0
    let len_a = pair_a.1

    let pair_b = serialize_ir_module(module_b)
    let buf_b = pair_b.0
    let len_b = pair_b.1

    // Step 2: Deserialize to ensure roundtrip consistency
    let restored_a = deserialize_ir_module(buf_a, len_a)
    let restored_b = deserialize_ir_module(buf_b, len_b)

    // Step 3: Normalize both modules
    let norm_a = normalize_ir_module(restored_a)
    let norm_b = normalize_ir_module(restored_b)

    // Step 4: Serialize normalized modules
    let norm_pair_a = serialize_ir_module(norm_a)
    let norm_buf_a = norm_pair_a.0
    let norm_len_a = norm_pair_a.1

    let norm_pair_b = serialize_ir_module(norm_b)
    let norm_buf_b = norm_pair_b.0
    let norm_len_b = norm_pair_b.1

    // Step 5: Compare byte-for-byte
    if norm_len_a != norm_len_b {
        return 1  // Different lengths
    }

    var i: i64 = 0
    while i < norm_len_a {
        if norm_buf_a[i] != norm_buf_b[i] {
            return 2  // Byte mismatch at position i
        }
        i = i + 1
    }

    0  // Equivalent
}

// Compare two IR modules using structural comparison
// Returns 0 if equivalent, non-zero error code otherwise
fn compare_ir_modules(module_a: IrModule, module_b: IrModule) -> i64 with Mut, Panic, Div {
    // Normalize both modules first
    let norm_a = normalize_ir_module(module_a)
    let norm_b = normalize_ir_module(module_b)

    // Use the built-in comparison function
    compare_normalized_ir(norm_a, norm_b)
}
