    fn alternative_source_kind_name(self, source_kind: i64) -> Name with Mut, Panic, Div {
        if source_kind == 0 {
            make_name("DeferredRoute")
        } else if source_kind == 1 {
            make_name("RecoursePlan")
        } else {
            make_name("UnknownSource")
        }
    }

    fn deferred_metric_i64(self, known: [i64; 8], values: [f64; 8], metric_id: i64) -> i64 with Mut, Panic, Div {
        if metric_id >= 0 && metric_id < 8 && known[metric_id as usize] != 0 {
            values[metric_id as usize] as i64
        } else {
            -1
        }
    }

    fn lower_metric_snapshot_literal(self, values: [f64; 8]) -> (Lowerer, i64) with Mut, Panic, Div {
        var expanded: [f64; 16] = [0.0; 16]
        var i: i64 = 0
        while i < 8 {
            expanded[i as usize] = values[i as usize]
            i = i + 1
        }
        self.lower_f64_array_literal(expanded, 8)
    }

    fn contest_metric_value(self, contest_info: IrContestInfo, metric_id: i64) -> f64 with Mut, Panic, Div {
        if metric_id >= 0 && metric_id < 8 && contest_info.metric_known[metric_id as usize] != 0 {
            contest_info.metric_values[metric_id as usize]
        } else {
            0.0
        }
    }

    fn contest_mechanistic_report(self, contest_info: IrContestInfo) -> IrMechanisticReportInfo with Mut, Panic, Div {
        if contest_info.mechanistic_report_id >= 0 && contest_info.mechanistic_report_id < self.module.epistemic.mechanistic_report_count {
            self.module.epistemic.mechanistic_reports[contest_info.mechanistic_report_id as usize]
        } else {
            ir_empty_mechanistic_report_info()
        }
    }

