// AST -> IR lowering

module ir::lower

use parser::ast::*
use ir::ir::*
use io::trace::*
use io::env::{read_env}

var LOWER_MARKER_BUF: [i8; 4] = [0; 4]

fn lower_marker(path: string) with IO {
    io_write_bytes_to_file(path, LOWER_MARKER_BUF, 1)
}

struct LowerLocalStack {
    names: [Name; 4096],
    regs: [i64; 4096],
    depths: [i64; 4096],
    struct_types: [Name; 4096],
    array_elem_float: [i64; 4096],
    wide_bits: [i64; 4096],
    wide_signed: [i64; 4096],
    count: i64,
}

fn empty_lower_local_stack() -> LowerLocalStack {
    LowerLocalStack {
        names: [ir_empty_name(); 4096],
        regs: [IR_INVALID_REG; 4096],
        depths: [0; 4096],
        struct_types: [ir_empty_name(); 4096],
        array_elem_float: [0; 4096],
        wide_bits: [0; 4096],
        wide_signed: [0; 4096],
        count: 0,
    }
}

struct LowerLoopLabels {
    break_labels: [i64; 256],
    continue_labels: [i64; 256],
}

fn empty_lower_loop_labels() -> LowerLoopLabels {
    LowerLoopLabels {
        break_labels: [IR_INVALID_LABEL; 256],
        continue_labels: [IR_INVALID_LABEL; 256],
    }
}

struct Lowerer {
    module: Box<IrModule>,
    current_fn: i64,
    current_func: Box<IrFunction>,
    current_func_loaded: bool,
    env: Option<Box<IrEnvList>>,
    locals: Box<LowerLocalStack>,
    scope_depth: i64,
    loop_labels: Box<LowerLoopLabels>,
    loop_depth: i64,
    error_count: i64,
    had_error: bool,
    // Phase 3.1: Enum variant discriminants
    enum_variants: Box<EnumVariantTable>,
    // Phase 3.2: Struct field layouts
    struct_layouts: Box<StructLayoutTable>,
    array_elem_float_regs: [i64; 512],
    array_elem_float_reg_count: i64,
    // Sprint 28: Debug-mode witness enforcement
    debug_mode: bool,
    // Sprint 44: probe-mode lowering skips heavyweight epistemic metadata lookup.
    probe_mode: bool,
}

struct IrPreparedCallArgs {
    lo: Lowerer,
    args: Option<Box<IrRegList>>,
    argc: i64,
}

pub struct IrProgramSummary {
    module: Box<IrModule>,
    enum_variants: Box<EnumVariantTable>,
    struct_layouts: Box<StructLayoutTable>,
    probe_mode: bool,
}

pub struct IrProgramSummaryResult {
    summary: IrProgramSummary,
    error_count: i64,
    had_error: bool,
}

pub struct IrProgramSummaryBoxResult {
    summary: Box<IrProgramSummary>,
    error_count: i64,
    had_error: bool,
}

pub struct IrProgramSummaryFlat {
    module: IrModule,
    enum_variants: EnumVariantTable,
    struct_layouts: StructLayoutTable,
    probe_mode: bool,
}

pub struct IrProgramSummaryFlatResult {
    summary: IrProgramSummaryFlat,
    error_count: i64,
    had_error: bool,
}

pub struct LowerExprArgsResult {
    lowerer: Lowerer,
    regs: IrRegList,
    count: i64,
}

struct IrFastSummaryOwnedSeed {
    module: IrModule,
    enum_variants: EnumVariantTable,
    struct_layouts: StructLayoutTable,
}

pub struct IrFunctionBodyResult {
    func: IrFunction,
    error_count: i64,
    had_error: bool,
    patch_stats: IrValidatedPatchStats,
}

pub struct IrLowerBoxResult {
    module: Box<IrModule>,
    error_count: i64,
    had_error: bool,
    patch_stats: IrValidatedPatchStats,
}

// Sprint 116: Register Knowledge<f64> struct layout (value, variance, confidence)
fn ir_register_knowledge_layout(table: StructLayoutTable) -> StructLayoutTable with Mut, Panic, Div {
    var t = table
    if t.count >= 256 {
        return t
    }
    let idx = t.count
    var fields: [StructFieldEntry; 64] = [empty_struct_field_entry(); 64]
    fields[0] = StructFieldEntry { name: make_name("value"), index: 0, is_float: 0 }
    fields[1] = StructFieldEntry { name: make_name("variance"), index: 1, is_float: 0 }
    fields[2] = StructFieldEntry { name: make_name("confidence"), index: 2, is_float: 0 }
    t.entries[idx as usize] = StructLayoutEntry {
        type_name: make_name("Knowledge"),
        fields: fields,
        field_count: 3,
    }
    t.count = idx + 1
    t
}

fn lowerer_new() -> Lowerer with Alloc {
    Lowerer {
        module: Box::new(ir_empty_module()),
        current_fn: IR_INVALID_FN,
        current_func: Box::new(ir_empty_function()),
        current_func_loaded: false,
        env: None,
        locals: Box::new(empty_lower_local_stack()),
        scope_depth: 0,
        loop_labels: Box::new(empty_lower_loop_labels()),
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: Box::new(empty_enum_variant_table()),
        struct_layouts: Box::new(empty_struct_layout_table()),
        array_elem_float_regs: [IR_INVALID_REG; 512],
        array_elem_float_reg_count: 0,
        debug_mode: false,
        probe_mode: false,
    }
}

fn lowerer_new_with_epistemic(epistemic: &IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lowerer_new()
    (*lo.module).epistemic = (*epistemic)
    // Sprint 116: pre-register Knowledge<f64> layout
    lo.struct_layouts = Box::new(ir_register_knowledge_layout(*lo.struct_layouts))
    lo
}

fn lowerer_new_probe() -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lowerer_new()
    lo.probe_mode = true
    // Sprint 116: pre-register Knowledge<f64> layout
    lo.struct_layouts = Box::new(ir_register_knowledge_layout(*lo.struct_layouts))
    lo
}

fn lower_summary_diag_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_LOWER_SUMMARY_TRACE"), "1")
}

fn lower_live_diag_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_LOWER_LIVE_TRACE"), "1")
}

fn lower_body_diag_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_LOWER_BODY_TRACE"), "1")
}

fn lower_body_trace_path() -> string {
    "/tmp/sounio_lower_body.trace"
}

fn lower_body_trace_append(msg: string) with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let pair0 = io_trace_append_string(buf, p, msg)
    buf = pair0.0
    p = pair0.1
    let pair1 = io_trace_append_byte(buf, p, 10)
    buf = pair1.0
    p = pair1.1
    let _ok = io_write_bytes_to_file(lower_body_trace_path(), buf, p)
}

fn lower_ordered_diag_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_LOWER_ORDERED_TRACE"), "1")
}

fn lower_aggregate_diag_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_LOWER_AGG_TRACE"), "1")
}

fn ir_normalize_string_literal_name(n: Name) -> Name {
    var out = ir_empty_name()
    var start: i64 = 0
    var end = n.len
    if n.len >= 2 && n.buf[0] == 34 as i8 && n.buf[(n.len - 1) as usize] == 34 as i8 {
        start = 1
        end = n.len - 1
    }
    var i = start
    while i < end && out.len < 128 {
        let ch = n.buf[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let nxt = n.buf[(i + 1) as usize]
            if nxt == 110 as i8 {
                out.buf[out.len as usize] = 10 as i8
            } else if nxt == 116 as i8 {
                out.buf[out.len as usize] = 9 as i8
            } else if nxt == 114 as i8 {
                out.buf[out.len as usize] = 13 as i8
            } else if nxt == 34 as i8 {
                out.buf[out.len as usize] = 34 as i8
            } else if nxt == 92 as i8 {
                out.buf[out.len as usize] = 92 as i8
            } else {
                out.buf[out.len as usize] = nxt
            }
            out.len = out.len + 1
            i = i + 2
        } else {
            out.buf[out.len as usize] = ch
            out.len = out.len + 1
            i = i + 1
        }
    }
    out
}

fn lower_span_matches_metadata(probe_mode: bool, span: Span, start: i64, end: i64) -> bool {
    if probe_mode {
        return false
    }
    start == span.start && end == span.end
}

fn lowerer_find_hyper_expr_id_for_span_ref(lo: &Lowerer, span: Span) -> i64 with Mut, Panic, Div {
    if (*(*lo).module).epistemic.hyper_expr_count <= 0 {
        return -1
    }
    var i: i64 = 0
    while i < (*(*lo).module).epistemic.hyper_expr_count {
        let info = (*(*lo).module).epistemic.hyper_exprs[i as usize]
        if lower_span_matches_metadata((*lo).probe_mode, span, info.span_start, info.span_end) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn ir_empty_program_summary() -> IrProgramSummary {
    IrProgramSummary {
        module: Box::new(ir_empty_module()),
        enum_variants: Box::new(empty_enum_variant_table()),
        struct_layouts: Box::new(empty_struct_layout_table()),
        probe_mode: false,
    }
}

fn ir_empty_program_summary_flat() -> IrProgramSummaryFlat {
    IrProgramSummaryFlat {
        module: ir_empty_module(),
        enum_variants: empty_enum_variant_table(),
        struct_layouts: empty_struct_layout_table(),
        probe_mode: false,
    }
}

fn ir_program_summary_from_lowerer(lo: Lowerer) -> IrProgramSummary {
    IrProgramSummary {
        module: lo.module,
        enum_variants: lo.enum_variants,
        struct_layouts: lo.struct_layouts,
        probe_mode: lo.probe_mode,
    }
}

fn lowerer_seed_module_from_summary(lo_in: Lowerer, summary: &IrProgramSummary) -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lo_in
    var module_box = lo.module
    let sm_fn_count = (*summary.module).fn_count
    (*module_box).fn_count = sm_fn_count
    (*module_box).string_count = 0
    (*module_box).prof_counter_count = (*summary.module).prof_counter_count
    (*module_box).bss_total_size = (*summary.module).bss_total_size

    var i: i64 = 0
    while i < (*summary.module).prof_counter_count && i < 64 {
        (*module_box).prof_counters[i as usize] = (*summary.module).prof_counters[i as usize]
        i = i + 1
    }

    i = 0
    while i < (*summary.module).fn_count && i < 1024 {
        let sm_strat = (*summary.module).functions[i as usize].compile_strategy
        var func = ir_empty_function()
        func.name = (*summary.module).functions[i as usize].name
        func.param_count = (*summary.module).functions[i as usize].param_count
        func.compile_strategy = sm_strat
        func.returns_float = (*summary.module).functions[i as usize].returns_float
        func.return_struct_name = (*summary.module).functions[i as usize].return_struct_name
        func.prof_counter_id = (*summary.module).functions[i as usize].prof_counter_id
        func.bss_size = (*summary.module).functions[i as usize].bss_size
        (*module_box).functions[i as usize] = func
        i = i + 1
    }
    lo.module = module_box
    lo
}

fn lowerer_seed_metadata_from_summary(lo_in: Lowerer, summary: &IrProgramSummary) -> Lowerer with Mut, Panic, Div {
    var lo = lo_in
    var enum_variants = *lo.enum_variants
    enum_variants.count = 0
    var vi: i64 = 0
    while vi < (*summary.enum_variants).count && vi < 1024 {
        enum_variants.entries[vi as usize] = (*summary.enum_variants).entries[vi as usize]
        vi = vi + 1
    }
    enum_variants.count = vi
    lo.enum_variants = Box::new(enum_variants)

    var struct_layouts = *lo.struct_layouts
    struct_layouts.count = 0
    var si: i64 = 0
    while si < (*summary.struct_layouts).count && si < 256 {
        var entry = empty_struct_layout_entry()
        entry.type_name = (*summary.struct_layouts).entries[si as usize].type_name
        entry.field_count = (*summary.struct_layouts).entries[si as usize].field_count
        var fi: i64 = 0
        while fi < entry.field_count && fi < 64 {
            entry.fields[fi as usize] = (*summary.struct_layouts).entries[si as usize].fields[fi as usize]
            fi = fi + 1
        }
        struct_layouts.entries[si as usize] = entry
        si = si + 1
    }
    struct_layouts.count = si
    lo.struct_layouts = Box::new(struct_layouts)
    lo
}

fn lowerer_new_from_program_summary(summary: &IrProgramSummary, epistemic: &IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lowerer_new()
    (*lo.module).epistemic = (*epistemic)
    lo = lowerer_seed_module_from_summary(lo, summary)
    lo = lowerer_seed_metadata_from_summary(lo, summary)
    lo.probe_mode = summary.probe_mode
    lo
}

fn lowerer_new_from_program_summary_flat(summary: &IrProgramSummaryFlat, epistemic: IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lowerer_new()
    (*lo.module).epistemic = epistemic
    (*lo.module).fn_count = summary.module.fn_count
    (*lo.module).string_count = 0
    (*lo.module).prof_counter_count = summary.module.prof_counter_count
    (*lo.module).bss_total_size = summary.module.bss_total_size

    var i: i64 = 0
    while i < summary.module.prof_counter_count && i < 64 {
        (*lo.module).prof_counters[i as usize] = summary.module.prof_counters[i as usize]
        i = i + 1
    }

    i = 0
    while i < summary.module.fn_count && i < 1024 {
        var func = ir_empty_function()
        func.name = summary.module.functions[i as usize].name
        func.param_count = summary.module.functions[i as usize].param_count
        func.compile_strategy = summary.module.functions[i as usize].compile_strategy
        func.returns_float = summary.module.functions[i as usize].returns_float
        func.return_struct_name = summary.module.functions[i as usize].return_struct_name
        func.prof_counter_id = summary.module.functions[i as usize].prof_counter_id
        func.bss_size = summary.module.functions[i as usize].bss_size
        (*lo.module).functions[i as usize] = func
        i = i + 1
    }
    lo.enum_variants = Box::new(summary.enum_variants)
    lo.struct_layouts = Box::new(summary.struct_layouts)
    lo.probe_mode = summary.probe_mode
    lo
}

fn ir_param_list_count_ref(params: &Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = params
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            None => break
        }
    }
    count
}

fn ir_param_list_count(params: Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    ir_param_list_count_ref(&params)
}

fn lowerer_mark_error(lo: &! Lowerer) with Mut {
    lo.error_count = lo.error_count + 1
    lo.had_error = true
}

fn lowerer_effect_list_has_name_ref(effects: &Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
    var current = effects
    while true {
        match *current {
            Some(effect_node) => {
                let eff = &(*effect_node).head
                var matches = true
                let tlen = str_len(target)
                if eff.name_len != tlen {
                    matches = false
                } else {
                    var k: i64 = 0
                    while k < tlen {
                        if eff.name_buf[k as usize] != (str_char_at(target, k) as i8) {
                            matches = false
                        }
                        k = k + 1
                    }
                }
                if matches {
                    return true
                }
                current = &(*effect_node).tail
            }
            None => return false
        }
    }
    false
}

fn lowerer_compute_strategy_from_ast_ref(
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) -> i64 with Mut, Panic, Div {
    if lowerer_effect_list_has_name_ref(effects, "GPU") {
        return IR_STRATEGY_GPU_KERNEL
    }
    if lowerer_effect_list_has_name_ref(effects, "Prob") {
        return IR_STRATEGY_PROBABILISTIC
    }

    match *return_type {
        Some(type_node) => {
            let rk = (*type_node).kind
            if rk == TypeExprKind::TypeValidated {
                IR_STRATEGY_AGGRESSIVE
            } else if rk == TypeExprKind::TypeKnowledge {
                IR_STRATEGY_PRECISION_PRESERVING
            } else if rk == TypeExprKind::TypeContest || rk == TypeExprKind::TypeRobust {
                IR_STRATEGY_INSTRUMENTED
            } else {
                IR_STRATEGY_STANDARD
            }
        }
        None => IR_STRATEGY_STANDARD,
    }
}

fn lowerer_find_or_add_fn_id_mut(lo: &! Lowerer, name: Name) -> i64 with Mut, Panic, Div {
    var module_box = (*lo).module
    var i: i64 = 0
    while i < (*module_box).fn_count {
        if ir_name_eq((*module_box).functions[i as usize].name, name) {
            (*lo).module = module_box
            return i
        }
        i = i + 1
    }

    if (*module_box).fn_count >= IR_MAX_FUNCS {
        (*lo).module = module_box
        lowerer_mark_error(lo)
        return -1
    }

    let idx = (*module_box).fn_count
    var fn_slot = (*module_box).functions[idx as usize]
    fn_slot.name = name
    (*module_box).functions[idx as usize] = fn_slot
    (*module_box).fn_count = idx + 1
    (*lo).module = module_box
    idx
}

fn lowerer_preseed_fn_signature_mut(
    lo: &! Lowerer,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) with Mut, Panic, Div, Alloc {
    let fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
    if fn_id < 0 {
        return
    }

    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    (*(*lo).module).functions[fn_id as usize].compile_strategy = strategy
    (*(*lo).module).functions[fn_id as usize].returns_float = if lower_opt_type_is_f64(return_type) { 1 } else { 0 }
    (*(*lo).module).functions[fn_id as usize].return_struct_name = lower_opt_type_named_name(return_type)
    (*(*lo).module).functions[fn_id as usize].param_count = ir_param_list_count_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        (*(*lo).module).functions[fn_id as usize].param_count = (*(*lo).module).functions[fn_id as usize].param_count + 1
        if (*(*lo).module).functions[fn_id as usize].prof_counter_id < 0 {
            let ctr_idx = (*(*lo).module).prof_counter_count
            if ctr_idx < 64 {
                (*(*lo).module).prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                (*(*lo).module).prof_counter_count = ctr_idx + 1
                (*(*lo).module).functions[fn_id as usize].prof_counter_id = ctr_idx
            } else {
                lo.error_count = lo.error_count + 1
                lo.had_error = true
            }
        }
    }
    (*(*lo).module).functions[fn_id as usize].param_regs = [IR_INVALID_REG; 64]
    (*(*lo).module).functions[fn_id as usize].instr_count = 0
    (*(*lo).module).functions[fn_id as usize].reg_count = 0
    (*(*lo).module).functions[fn_id as usize].label_count = 0
}

fn lowerer_register_enum_variants_mut(
    lo: &! Lowerer,
    enum_name: Name,
    variants: &Option<Box<VariantDefList>>,
    next_disc: i64
) with Mut, Panic, Div, Alloc {
    var current = variants
    var disc = next_disc
    while true {
        match *current {
            Some(list) => {
                if (*(*lo).enum_variants).count < 1024 {
                    let idx = (*(*lo).enum_variants).count
                    (*(*lo).enum_variants).entries[idx as usize] = EnumVariantEntry {
                        enum_name: enum_name,
                        variant_name: (*list).head.name,
                        discriminant: disc,
                    }
                    (*(*lo).enum_variants).count = idx + 1
                } else {
                    lo.error_count = lo.error_count + 1
                    lo.had_error = true
                }
                current = &(*list).tail
                disc = disc + 1
            }
            _ => break
        }
    }
}

// Cross-module struct preseed: registers struct layouts from an external
// module's items into this lowerer's struct_layouts table. Without this,
// imported struct types (e.g. `use lib::{PublicStruct}` then `s.x`) fall
// back to a first-byte-hash field_idx and codegen emits wrong offsets at
// runtime.
fn lowerer_preseed_external_struct_items_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head_owned = (*list).head
                if head_owned.kind == ItemKind::ItemStruct {
                    match head_owned.struct_def {
                        Some(sd) => {
                            // Inline registration: lowerer_register_struct_fields_mut
                            // silently no-ops from this call site (suspected
                            // lean_single handling of &(*box).field through
                            // FieldDefList head). Build the layout entry directly.
                            var sl_box = (*lo).struct_layouts
                            let pre_count = (*sl_box).count
                            if pre_count < 256 {
                                var entry = empty_struct_layout_entry()
                                entry.type_name = head_owned.name
                                var fc: i64 = 0
                                var fcur = (*sd).fields
                                var keep_going = true
                                while keep_going && fc < 64 {
                                    match fcur {
                                        Some(flist) => {
                                            entry.fields[fc as usize] = StructFieldEntry {
                                                name: (*flist).head.name,
                                                index: fc,
                                                is_float: 0,
                                            }
                                            fc = fc + 1
                                            fcur = (*flist).tail
                                        }
                                        _ => { keep_going = false }
                                    }
                                }
                                entry.field_count = fc
                                (*sl_box).entries[pre_count as usize] = entry
                                (*sl_box).count = pre_count + 1
                                (*lo).struct_layouts = sl_box
                            }
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_register_struct_fields_mut(
    lo: &! Lowerer,
    type_name: Name,
    fields: &Option<Box<FieldDefList>>,
    idx: i64
) with Mut, Panic, Div, Alloc {
    var current = fields
    var field_idx = idx
    while true {
        match *current {
            Some(list) => {
                var layout_idx: i64 = -1
                var si: i64 = 0
                while si < (*(*lo).struct_layouts).count {
                    if ir_name_eq((*(*lo).struct_layouts).entries[si as usize].type_name, type_name) {
                        layout_idx = si
                    }
                    si = si + 1
                }
                if layout_idx < 0 {
                    if (*(*lo).struct_layouts).count < 256 {
                        layout_idx = (*(*lo).struct_layouts).count
                        (*(*lo).struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
                            type_name: type_name,
                            fields: [empty_struct_field_entry(); 64],
                            field_count: 0,
                        }
                        (*(*lo).struct_layouts).count = layout_idx + 1
                    } else {
                        lo.error_count = lo.error_count + 1
                        lo.had_error = true
                        return
                    }
                }
                let fc = (*(*lo).struct_layouts).entries[layout_idx as usize].field_count
                if fc < 64 {
                    (*(*lo).struct_layouts).entries[layout_idx as usize].fields[fc as usize] = StructFieldEntry {
                        name: (*list).head.name,
                        index: field_idx,
                        is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else { 0 },
                    }
                    (*(*lo).struct_layouts).entries[layout_idx as usize].field_count = fc + 1
                } else {
                    lo.error_count = lo.error_count + 1
                    lo.had_error = true
                }
                current = &(*list).tail
                field_idx = field_idx + 1
            }
            _ => break
        }
    }
}

fn lowerer_preseed_impl_method_summaries_mut(
    lo: &! Lowerer,
    type_name: Name,
    methods: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = methods
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_preseed_fn_signature_mut(lo, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lower_typeexpr_byte_size(ty_opt: &Option<Box<TypeExpr>>) -> i64 with Div {
    match *ty_opt {
        Some(ty) => {
            if (*ty).kind == TypeExprKind::TypeArray {
                let inner_size = lower_typeexpr_byte_size(&(*ty).inner)
                match (*ty).array_size {
                    Some(sz) => {
                        if (*sz).kind == ExprKind::ExprIntLit {
                            return inner_size * (*sz).int_val
                        }
                        return inner_size * 1024
                    }
                    _ => { return 8 }
                }
            }
            return 8
        }
        _ => { return 8 }
    }
}

fn lowerer_preseed_program_items_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                if kind == ItemKind::ItemFn {
                    if !ir_name_eq(name, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                let fn_id_sig = lowerer_find_or_add_fn_id_mut(lo, name)
                                if fn_id_sig >= 0 {
                                    let strategy_sig = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                    var module_box_sig = (*lo).module
                                    var fn_slot_sig = (*module_box_sig).functions[fn_id_sig as usize]
                                    fn_slot_sig.compile_strategy = strategy_sig
                                    fn_slot_sig.returns_float = if lower_opt_type_is_f64(&(*fd).return_type) { 1 } else { 0 }
                                    fn_slot_sig.return_struct_name = lower_opt_type_named_name(&(*fd).return_type)
                                    fn_slot_sig.param_count = ir_param_list_count_ref(&(*fd).params)
                                    if strategy_sig == IR_STRATEGY_INSTRUMENTED {
                                        fn_slot_sig.param_count = fn_slot_sig.param_count + 1
                                        if fn_slot_sig.prof_counter_id < 0 {
                                            let ctr_idx_sig = (*module_box_sig).prof_counter_count
                                            if ctr_idx_sig < 64 {
                                                (*module_box_sig).prof_counters[ctr_idx_sig as usize] = IrProfCounterInfo {
                                                    fn_id: fn_id_sig,
                                                    fn_name: name,
                                                    counter_id: ctr_idx_sig,
                                                }
                                                (*module_box_sig).prof_counter_count = ctr_idx_sig + 1
                                                fn_slot_sig.prof_counter_id = ctr_idx_sig
                                            } else {
                                                lo.error_count = lo.error_count + 1
                                                lo.had_error = true
                                            }
                                        }
                                    }
                                    (*module_box_sig).functions[fn_id_sig as usize] = fn_slot_sig
                                    (*lo).module = module_box_sig
                                }
                                // Sprint 108/109: set strategy for extern/export fns
                                let fn_id_ps = lowerer_find_or_add_fn_id_mut(lo, name)
                                if fn_id_ps >= 0 {
                                    if (*fd).is_kernel {
                                        (*(*lo).module).functions[fn_id_ps as usize].compile_strategy = 6
                                    } else if visibility_to_bool(head.visibility) {
                                        (*(*lo).module).functions[fn_id_ps as usize].compile_strategy = 7
                                        let exp_count = (*(*lo).module).export_count
                                        if exp_count < 64 {
                                            (*(*lo).module).export_names[exp_count as usize] = name
                                            (*(*lo).module).export_count = exp_count + 1
                                        }
                                    }
                                }
                            }
                            _ => {
                                let bss_fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
                                if bss_fn_id >= 0 {
                                    var mbox2 = (*lo).module
                                    var bss_slot = (*mbox2).functions[bss_fn_id as usize]
                                    let bss_off = (*mbox2).bss_total_size
                                    let bss_size = lower_typeexpr_byte_size(&head.type_alias_ty)
                                    let aligned_size = ((bss_size + 7) / 8) * 8
                                    bss_slot.compile_strategy = 99
                                    bss_slot.param_count = bss_off
                                    bss_slot.bss_size = bss_size
                                    let init_val = ast_lookup_global_var_init(name)
                                    if init_val != 0 {
                                        bss_slot.returns_float = 1
                                        bss_slot.prof_counter_id = init_val
                                    }
                                    (*mbox2).functions[bss_fn_id as usize] = bss_slot
                                    (*mbox2).bss_total_size = bss_off + aligned_size
                                    (*lo).module = mbox2
                                }
                            }
                        }
                    }
                } else if kind == ItemKind::ItemStruct {
                    let struct_def_opt_ref: &Option<Box<StructDef>> = &head.struct_def
                    match *struct_def_opt_ref {
                        Some(sd) => {
                            lowerer_register_struct_fields_mut(lo, name, &(*sd).fields, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    let enum_def_opt_ref: &Option<Box<EnumDef>> = &head.enum_def
                    match *enum_def_opt_ref {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            lowerer_preseed_impl_method_summaries_mut(lo, name, &(*id).methods, skip_name)
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn ir_fast_summary_find_or_add_fn_id(module: &! IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var module_value = (*module)
    var i: i64 = 0
    while i < module_value.fn_count {
        if ir_name_eq(module_value.functions[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    if module_value.fn_count >= IR_MAX_FUNCS {
        return -1
    }
    let idx = module_value.fn_count
    module_value.functions[idx as usize] = ir_empty_function()
    module_value.functions[idx as usize].name = name
    module_value.functions[idx as usize].param_regs = [IR_INVALID_REG; 64]
    module_value.fn_count = idx + 1
    (*module) = module_value
    idx
}

fn ir_fast_summary_preseed_fn_signature(
    module: &! IrModule,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) with Mut, Panic, Div, Alloc {
    let fn_id = ir_fast_summary_find_or_add_fn_id(module, name)
    if fn_id < 0 {
        return
    }
    var module_value = (*module)
    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    module_value.functions[fn_id as usize].compile_strategy = strategy
    module_value.functions[fn_id as usize].returns_float = if lower_opt_type_is_f64(return_type) { 1 } else { 0 }
    module_value.functions[fn_id as usize].return_struct_name = lower_opt_type_named_name(return_type)
    module_value.functions[fn_id as usize].param_count = ir_param_list_count_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        module_value.functions[fn_id as usize].param_count = module_value.functions[fn_id as usize].param_count + 1
        if module_value.functions[fn_id as usize].prof_counter_id < 0 {
            let ctr_idx = module_value.prof_counter_count
            if ctr_idx < 64 {
                module_value.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                module_value.prof_counter_count = ctr_idx + 1
                module_value.functions[fn_id as usize].prof_counter_id = ctr_idx
            }
        }
    }
    (*module) = module_value
}

fn ir_fast_summary_preseed_impl_methods(
    module: &! IrModule,
    type_name: Name,
    methods: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = methods
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                ir_fast_summary_preseed_fn_signature(module, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn ir_fast_summary_preseed_items(
    module: &! IrModule,
    items: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                if kind == ItemKind::ItemFn {
                    if !ir_name_eq(name, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                ir_fast_summary_preseed_fn_signature(module, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            ir_fast_summary_preseed_impl_methods(module, name, &(*id).methods, skip_name)
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn ir_fast_summary_find_or_add_fn_id_owned(module: IrModule, name: Name) -> (IrModule, i64) with Mut, Panic, Div {
    var module_value = module
    var i: i64 = 0
    while i < module_value.fn_count {
        if ir_name_eq(module_value.functions[i as usize].name, name) {
            return (module_value, i)
        }
        i = i + 1
    }
    if module_value.fn_count >= IR_MAX_FUNCS {
        return (module_value, -1)
    }
    let idx = module_value.fn_count
    module_value.functions[idx as usize] = ir_empty_function()
    module_value.functions[idx as usize].name = name
    module_value.functions[idx as usize].param_regs = [IR_INVALID_REG; 64]
    module_value.fn_count = idx + 1
    (module_value, idx)
}

fn ir_fast_summary_preseed_fn_signature_owned(
    module: IrModule,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) -> IrModule with Mut, Panic, Div, Alloc {
    let pair = ir_fast_summary_find_or_add_fn_id_owned(module, name)
    var module_value = pair.0
    let fn_id = pair.1
    if fn_id < 0 {
        return module_value
    }
    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    module_value.functions[fn_id as usize].compile_strategy = strategy
    module_value.functions[fn_id as usize].returns_float = if lower_opt_type_is_f64(return_type) { 1 } else { 0 }
    module_value.functions[fn_id as usize].return_struct_name = lower_opt_type_named_name(return_type)
    module_value.functions[fn_id as usize].param_count = ir_param_list_count_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        module_value.functions[fn_id as usize].param_count = module_value.functions[fn_id as usize].param_count + 1
        if module_value.functions[fn_id as usize].prof_counter_id < 0 {
            let ctr_idx = module_value.prof_counter_count
            if ctr_idx < 64 {
                module_value.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                module_value.prof_counter_count = ctr_idx + 1
                module_value.functions[fn_id as usize].prof_counter_id = ctr_idx
            }
        }
    }
    module_value
}

fn ir_fast_summary_preseed_impl_methods_owned(
    module: IrModule,
    type_name: Name,
    methods: Option<Box<ItemList>>,
    skip_name: Name
) -> IrModule with Mut, Panic, Div, Alloc {
    match methods {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            var module_value = module
            if item.kind == ItemKind::ItemFn {
                let mangled = ir_mangle_method_name(type_name, item.name)
                if !ir_name_eq(mangled, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            module_value = ir_fast_summary_preseed_fn_signature_owned(module_value, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            }
            ir_fast_summary_preseed_impl_methods_owned(module_value, type_name, tail, skip_name)
        }
        None => module,
    }
}

fn ir_fast_summary_preseed_items_owned(
    module: IrModule,
    items: Option<Box<ItemList>>,
    skip_name: Name
) -> IrModule with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            let kind = item.kind
            let name = item.name
            var module_value = module
            if kind == ItemKind::ItemFn {
                if !ir_name_eq(name, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            module_value = ir_fast_summary_preseed_fn_signature_owned(module_value, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            } else if kind == ItemKind::ItemImpl {
                match item.impl_def {
                    Some(id) => {
                        module_value = ir_fast_summary_preseed_impl_methods_owned(module_value, name, (*id).methods, skip_name)
                    }
                    _ => {}
                }
            }
            ir_fast_summary_preseed_items_owned(module_value, tail, skip_name)
        }
        None => module,
    }
}

fn ir_fast_summary_seed_empty(epistemic: IrEpistemicSection) -> IrFastSummaryOwnedSeed {
    var module = ir_empty_module()
    module.epistemic = epistemic
    IrFastSummaryOwnedSeed {
        module: module,
        enum_variants: empty_enum_variant_table(),
        struct_layouts: empty_struct_layout_table(),
    }
}

fn ir_fast_summary_register_enum_variants_owned(
    table: EnumVariantTable,
    enum_name: Name,
    variants: Option<Box<VariantDefList>>,
    next_disc: i64
) -> EnumVariantTable with Mut, Panic, Div, Alloc {
    match variants {
        Some(list) => {
            var table_value = table
            if table_value.count < 1024 {
                let idx = table_value.count
                table_value.entries[idx as usize] = EnumVariantEntry {
                    enum_name: enum_name,
                    variant_name: (*list).head.name,
                    discriminant: next_disc,
                }
                table_value.count = idx + 1
            }
            ir_fast_summary_register_enum_variants_owned(table_value, enum_name, (*list).tail, next_disc + 1)
        }
        None => table,
    }
}

fn ir_fast_summary_register_struct_fields_owned(
    table: StructLayoutTable,
    type_name: Name,
    fields: Option<Box<FieldDefList>>,
    idx: i64
) -> StructLayoutTable with Mut, Panic, Div, Alloc {
    match fields {
        Some(list) => {
            var table_value = table
            var layout_idx: i64 = -1
            var si: i64 = 0
            while si < table_value.count {
                if ir_name_eq(table_value.entries[si as usize].type_name, type_name) {
                    layout_idx = si
                }
                si = si + 1
            }
            if layout_idx < 0 {
                if table_value.count < 256 {
                    layout_idx = table_value.count
                    table_value.entries[layout_idx as usize] = StructLayoutEntry {
                        type_name: type_name,
                        fields: [empty_struct_field_entry(); 64],
                        field_count: 0,
                    }
                    table_value.count = layout_idx + 1
                } else {
                    return table_value
                }
            }
            let fc = table_value.entries[layout_idx as usize].field_count
            if fc < 64 {
                table_value.entries[layout_idx as usize].fields[fc as usize] = StructFieldEntry {
                    name: (*list).head.name,
                    index: idx,
                    is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else { 0 },
                }
                table_value.entries[layout_idx as usize].field_count = fc + 1
            }
            ir_fast_summary_register_struct_fields_owned(table_value, type_name, (*list).tail, idx + 1)
        }
        None => table,
    }
}

fn ir_fast_summary_preseed_impl_methods_seed_owned(
    seed: IrFastSummaryOwnedSeed,
    type_name: Name,
    methods: Option<Box<ItemList>>,
    skip_name: Name
) -> IrFastSummaryOwnedSeed with Mut, Panic, Div, Alloc {
    match methods {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            var seed_value = seed
            if item.kind == ItemKind::ItemFn {
                let mangled = ir_mangle_method_name(type_name, item.name)
                if !ir_name_eq(mangled, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            seed_value.module = ir_fast_summary_preseed_fn_signature_owned(seed_value.module, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            }
            ir_fast_summary_preseed_impl_methods_seed_owned(seed_value, type_name, tail, skip_name)
        }
        None => seed,
    }
}

fn ir_fast_summary_preseed_items_seed_owned(
    seed: IrFastSummaryOwnedSeed,
    items: Option<Box<ItemList>>,
    skip_name: Name
) -> IrFastSummaryOwnedSeed with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            let kind = item.kind
            let name = item.name
            var seed_value = seed
            if kind == ItemKind::ItemFn {
                if !ir_name_eq(name, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            seed_value.module = ir_fast_summary_preseed_fn_signature_owned(seed_value.module, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                }
                                _ => {
                                    var bss_mod = seed_value.module
                                    let bss_fid = bss_mod.fn_count
                                    if bss_fid < IR_MAX_FUNCS {
                                        let bss_size = lower_typeexpr_byte_size(&item.type_alias_ty)
                                        let aligned_size = ((bss_size + 7) / 8) * 8
                                        bss_mod.functions[bss_fid as usize].name = name
                                        bss_mod.functions[bss_fid as usize].compile_strategy = IR_STRATEGY_BSS_GLOBAL
                                        bss_mod.functions[bss_fid as usize].param_count = bss_mod.bss_total_size
                                        bss_mod.functions[bss_fid as usize].bss_size = bss_size
                                        bss_mod.fn_count = bss_fid + 1
                                        bss_mod.bss_total_size = bss_mod.bss_total_size + aligned_size
                                    }
                                    seed_value.module = bss_mod
                                }
                            }
                        }
                    } else if kind == ItemKind::ItemStruct {
                match item.struct_def {
                    Some(sd) => {
                        seed_value.struct_layouts = ir_fast_summary_register_struct_fields_owned(seed_value.struct_layouts, name, (*sd).fields, 0)
                    }
                    _ => {}
                }
            } else if kind == ItemKind::ItemEnum {
                match item.enum_def {
                    Some(ed) => {
                        seed_value.enum_variants = ir_fast_summary_register_enum_variants_owned(seed_value.enum_variants, name, (*ed).variants, 0)
                    }
                    _ => {}
                }
            } else if kind == ItemKind::ItemImpl {
                match item.impl_def {
                    Some(id) => {
                        seed_value = ir_fast_summary_preseed_impl_methods_seed_owned(seed_value, name, (*id).methods, skip_name)
                    }
                    _ => {}
                }
            }
            ir_fast_summary_preseed_items_seed_owned(seed_value, tail, skip_name)
        }
        None => seed,
    }
}

pub fn lower_program_to_ir_summary_flat_owned_with_epistemic_ref(
    prog: &Program,
    epistemic: IrEpistemicSection
) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.epistemic = epistemic
    var enum_variants = empty_enum_variant_table()
    var struct_layouts = empty_struct_layout_table()
    var current = (*prog).items
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                let kind = item.kind
                let name = item.name
                if kind == ItemKind::ItemFn {
                    match item.fn_def {
                        Some(fd) => {
                            var fn_id: i64 = -1
                            var i: i64 = 0
                            while i < module.fn_count {
                                if ir_name_eq(module.functions[i as usize].name, name) {
                                    fn_id = i
                                    i = module.fn_count
                                } else {
                                    i = i + 1
                                }
                            }
                            if fn_id < 0 && module.fn_count < IR_MAX_FUNCS {
                                fn_id = module.fn_count
                                module.functions[fn_id as usize] = ir_empty_function()
                                module.functions[fn_id as usize].name = name
                                module.functions[fn_id as usize].param_regs = [IR_INVALID_REG; 64]
                                module.fn_count = fn_id + 1
                            }
                            if fn_id >= 0 {
                                let strategy = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                module.functions[fn_id as usize].compile_strategy = strategy
                                module.functions[fn_id as usize].returns_float = if lower_opt_type_is_f64(&(*fd).return_type) { 1 } else { 0 }
                                module.functions[fn_id as usize].return_struct_name = lower_opt_type_named_name(&(*fd).return_type)
                                module.functions[fn_id as usize].param_count = ir_param_list_count_ref(&(*fd).params)
                                if strategy == IR_STRATEGY_INSTRUMENTED {
                                    module.functions[fn_id as usize].param_count = module.functions[fn_id as usize].param_count + 1
                                    if module.functions[fn_id as usize].prof_counter_id < 0 && module.prof_counter_count < 64 {
                                        let ctr_idx = module.prof_counter_count
                                        module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                                            fn_id: fn_id,
                                            fn_name: name,
                                            counter_id: ctr_idx,
                                        }
                                        module.prof_counter_count = ctr_idx + 1
                                        module.functions[fn_id as usize].prof_counter_id = ctr_idx
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemStruct {
                    match item.struct_def {
                        Some(sd) => {
                            struct_layouts = ir_fast_summary_register_struct_fields_owned(struct_layouts, name, (*sd).fields, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    match item.enum_def {
                        Some(ed) => {
                            enum_variants = ir_fast_summary_register_enum_variants_owned(enum_variants, name, (*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    match item.impl_def {
                        Some(id) => {
                            var method_current = (*id).methods
                            while true {
                                match method_current {
                                    Some(method_list) => {
                                        let method_item = (*method_list).head
                                        if method_item.kind == ItemKind::ItemFn {
                                            let mangled = ir_mangle_method_name(name, method_item.name)
                                            match method_item.fn_def {
                                                Some(fd) => {
                                                    var fn_id: i64 = -1
                                                    var i: i64 = 0
                                                    while i < module.fn_count {
                                                        if ir_name_eq(module.functions[i as usize].name, mangled) {
                                                            fn_id = i
                                                            i = module.fn_count
                                                        } else {
                                                            i = i + 1
                                                        }
                                                    }
                                                    if fn_id < 0 && module.fn_count < IR_MAX_FUNCS {
                                                        fn_id = module.fn_count
                                                        module.functions[fn_id as usize] = ir_empty_function()
                                                        module.functions[fn_id as usize].name = mangled
                                                        module.functions[fn_id as usize].param_regs = [IR_INVALID_REG; 64]
                                                        module.fn_count = fn_id + 1
                                                    }
                                                    if fn_id >= 0 {
                                                        let strategy = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                                        module.functions[fn_id as usize].compile_strategy = strategy
                                                        module.functions[fn_id as usize].returns_float = if lower_opt_type_is_f64(&(*fd).return_type) { 1 } else { 0 }
                                                        module.functions[fn_id as usize].return_struct_name = lower_opt_type_named_name(&(*fd).return_type)
                                                        module.functions[fn_id as usize].param_count = ir_param_list_count_ref(&(*fd).params)
                                                        if strategy == IR_STRATEGY_INSTRUMENTED {
                                                            module.functions[fn_id as usize].param_count = module.functions[fn_id as usize].param_count + 1
                                                            if module.functions[fn_id as usize].prof_counter_id < 0 && module.prof_counter_count < 64 {
                                                                let ctr_idx = module.prof_counter_count
                                                                module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                                                                    fn_id: fn_id,
                                                                    fn_name: mangled,
                                                                    counter_id: ctr_idx,
                                                                }
                                                                module.prof_counter_count = ctr_idx + 1
                                                                module.functions[fn_id as usize].prof_counter_id = ctr_idx
                                                            }
                                                        }
                                                    }
                                                }
                            _ => {}
                                            }
                                        }
                                        method_current = (*method_list).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
    IrProgramSummaryFlatResult {
        summary: IrProgramSummaryFlat {
            module: module,
            enum_variants: enum_variants,
            struct_layouts: struct_layouts,
            probe_mode: false,
        },
        error_count: 0,
        had_error: false,
    }
}

fn lowerer_bind_local_mut(
    lo: &! Lowerer,
    name: Name,
    reg: i64,
    is_mut: bool
) with Mut, Alloc, Panic {
    let _is_mut = is_mut
    if (*(*lo).locals).count < 4096 {
        let idx = (*(*lo).locals).count
        (*(*lo).locals).names[idx as usize] = name
        (*(*lo).locals).regs[idx as usize] = reg
        (*(*lo).locals).depths[idx as usize] = (*lo).scope_depth
        (*(*lo).locals).struct_types[idx as usize] = ir_empty_name()
        (*(*lo).locals).array_elem_float[idx as usize] = 0
        (*(*lo).locals).wide_bits[idx as usize] = 0
        (*(*lo).locals).wide_signed[idx as usize] = 0
        (*(*lo).locals).count = idx + 1
    } else {
        lowerer_mark_error(lo)
    }
}

fn lowerer_fresh_reg_mut(lo: &! Lowerer) -> i64 with Mut, Panic, Div {
    if (*lo).current_fn < 0 || (*lo).current_fn >= (*(*lo).module).fn_count {
        lowerer_mark_error(lo)
        return 0
    }
    let reg = (*(*lo).current_func).reg_count
    (*(*lo).current_func).reg_count = reg + 1
    reg
}

fn lowerer_lower_fn_params_mut(
    lo: &! Lowerer,
    params: &Option<Box<ParamList>>
) with IO, Mut, Panic, Div, Alloc {
    var current = params
    while true {
        match *current {
            Some(list) => {
                if lower_live_diag_enabled() {
                    print("lower_live: param_loop name=")
                    print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                    print(" fn_id=")
                    print_int((*lo).current_fn)
                    print(" fn_count=")
                    print_int((*(*lo).module).fn_count)
                    print("\n")
                }
                let preg = lowerer_fresh_reg_mut(lo)

                let fn_id = (*lo).current_fn
                if fn_id < 0 || fn_id >= (*(*lo).module).fn_count {
                    lowerer_mark_error(lo)
                } else {
                    if (*(*lo).current_func).param_count < IR_MAX_PARAMS {
                        let param_count = (*(*lo).current_func).param_count
                        (*(*lo).current_func).param_regs[param_count as usize] = preg
                        (*(*lo).current_func).param_count = param_count + 1
                        if lower_live_diag_enabled() {
                            print("lower_live: param_count_now=")
                            print_int((*(*lo).current_func).param_count)
                            print("\n")
                        }
                    } else {
                        lowerer_mark_error(lo)
                    }
                }

                if lower_type_expr_is_f64(&(*list).head.ty) {
                    let instr_count = (*(*lo).current_func).instr_count
                    if instr_count < IR_MAX_INSTRS {
                        (*(*lo).current_func).instrs[instr_count as usize] = ir_mark_float_reg(preg)
                        (*(*lo).current_func).instr_count = instr_count + 1
                    } else {
                        lowerer_mark_error(lo)
                    }
                }

                lowerer_bind_local_mut(lo, (*list).head.name, preg, (*list).head.is_self_mut)
                if lower_type_expr_is_array_of_f64(&(*list).head.ty) {
                    (*lo) = (*lo).bind_local_array_elem_float((*list).head.name)
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_lower_fn_item_mut(
    lo: &! Lowerer,
    name: Name,
    fd: &FnDef
) with Mut, Panic, Div, Alloc, IO {
    if lower_live_diag_enabled() {
        print("lower_live: fn_before_find_or_add name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }
    let fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_find_or_add name=")
        print(str_from_bytes(name.buf, name.len))
        print(" fn_id=")
        print_int(fn_id)
        print(" fn_count=")
        print_int((*(*lo).module).fn_count)
        print("\n")
    }
    if fn_id < 0 {
        return
    }

    if lower_live_diag_enabled() {
        print("lower_live: fn_begin name=")
        print(str_from_bytes(name.buf, name.len))
        print(" fn_id=")
        print_int(fn_id)
        print("\n")
    }

    if (*lo).current_func_loaded && (*lo).current_fn >= 0 && (*lo).current_fn < (*(*lo).module).fn_count {
        var module = *(*lo).module
        module.functions[(*lo).current_fn as usize] = *(*lo).current_func
        (*lo).module = Box::new(module)
    }
    (*lo).current_func_loaded = false
    (*lo).current_fn = fn_id
    var current_func = ir_empty_function()
    current_func.name = name
    if fn_id >= 0 && fn_id < (*(*lo).module).fn_count {
        let preserved = (*(*lo).module).functions[fn_id as usize]
        current_func.name = preserved.name
        current_func.compile_strategy = preserved.compile_strategy
        current_func.returns_float = preserved.returns_float
        current_func.return_struct_name = preserved.return_struct_name
        current_func.prof_counter_id = preserved.prof_counter_id
    }
    (*lo).current_func = Box::new(current_func)
    (*lo).current_func_loaded = true
    (*lo).env = None
    (*(*lo).locals).count = 0
    (*lo).scope_depth = 0
    (*lo).loop_depth = 0
    if lower_live_diag_enabled() {
        print("lower_live: fn_state_after_begin current_fn=")
        print_int((*lo).current_fn)
        print(" fn_count=")
        print_int((*(*lo).module).fn_count)
        print("\n")
        print("lower_live: fn_after_begin name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }

    let strategy = lowerer_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_strategy name=")
        print(str_from_bytes(name.buf, name.len))
        print(" strategy=")
        print_int(strategy)
        print("\n")
    }
    // Sprint 108/109: preserve extern/exported strategy set during preseed
    let preseed_strategy_m = (*(*lo).current_func).compile_strategy
    if preseed_strategy_m == 6 || preseed_strategy_m == 7 {
        (*(*lo).current_func).compile_strategy = preseed_strategy_m
    } else {
        (*(*lo).current_func).compile_strategy = strategy
    }
    (*(*lo).current_func).returns_float = if lower_opt_type_is_f64(&fd.return_type) { 1 } else { 0 }
    (*(*lo).current_func).return_struct_name = lower_opt_type_named_name(&fd.return_type)

    if strategy == IR_STRATEGY_INSTRUMENTED {
        if (*(*lo).current_func).prof_counter_id < 0 {
            var module = *(*lo).module
            let ctr_idx = module.prof_counter_count
            if ctr_idx < 64 {
                module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: (*(*lo).current_func).name,
                    counter_id: ctr_idx,
                }
                module.prof_counter_count = ctr_idx + 1
                (*(*lo).current_func).prof_counter_id = ctr_idx
                (*lo).module = Box::new(module)
            }
        }
        (*lo) = (*lo).ir_lower_inject_validated_param(fn_id)
    }

    (*lo).scope_depth = (*lo).scope_depth + 1
    if ir_param_list_count_ref(&fd.params) > 0 {
        lowerer_lower_fn_params_mut(lo, &fd.params)
    }
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_params name=")
        print(str_from_bytes(name.buf, name.len))
        print(" param_count=")
        print_int((*(*lo).current_func).param_count)
        print("\n")
    }

    let bpair = (*lo).lower_block_ref(&fd.body)
    (*lo) = bpair.0
    let result_reg = bpair.1
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_block name=")
        print(str_from_bytes(name.buf, name.len))
        print(" result_reg=")
        print_int(result_reg)
        print("\n")
    }

    if !(*lo).fn_ends_with_return() {
        (*lo) = (*lo).emit(ir_return(result_reg))
    }

    if (*lo).scope_depth > 0 {
        (*lo).scope_depth = (*lo).scope_depth - 1
    }
    if (*lo).current_func_loaded && (*lo).current_fn >= 0 && (*lo).current_fn < (*(*lo).module).fn_count {
        var module = *(*lo).module
        module.functions[(*lo).current_fn as usize] = *(*lo).current_func
        (*lo).module = Box::new(module)
    }
    (*lo).current_func_loaded = false
    (*lo).current_fn = IR_INVALID_FN
    if lower_live_diag_enabled() {
        print("lower_live: fn_done name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }
}

fn lowerer_lower_impl_methods_mut(
    lo: &! Lowerer,
    type_name: Name,
    methods: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = methods
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, item.name)
                    match item.fn_def {
                        Some(fd) => {
                            (*lo) = (*lo).lower_fn_item_ref(mangled, &(*fd))
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_lower_program_items_mut(
    lo: &! Lowerer,
    items: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                let kind = item.kind
                let name = item.name
                if lower_live_diag_enabled() {
                    print("lower_live: item kind=")
                    if kind == ItemKind::ItemFn { print("fn") }
                    else if kind == ItemKind::ItemStruct { print("struct") }
                    else if kind == ItemKind::ItemEnum { print("enum") }
                    else if kind == ItemKind::ItemImpl { print("impl") }
                    else { print("other") }
                    print(" name=")
                    print(str_from_bytes(name.buf, name.len))
                    print("\n")
                }
                if lower_ordered_diag_enabled() {
                    print("lower_ordered: item kind=")
                    if kind == ItemKind::ItemFn { print("fn") }
                    else if kind == ItemKind::ItemStruct { print("struct") }
                    else if kind == ItemKind::ItemEnum { print("enum") }
                    else if kind == ItemKind::ItemImpl { print("impl") }
                    else { print("other") }
                    print(" name=")
                    print(str_from_bytes(name.buf, name.len))
                    print("\n")
                }
                if kind == ItemKind::ItemFn {
                    match item.fn_def {
                        Some(fd) => {
                            (*lo) = (*lo).lower_fn_item_ref(name, &(*fd))
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemStruct {
                    match item.struct_def {
                        Some(sd) => {
                            lowerer_register_struct_fields_mut(lo, name, &(*sd).fields, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    match item.enum_def {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    match item.impl_def {
                        Some(id) => {
                            lowerer_lower_impl_methods_mut(lo, name, (*id).methods)
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
}

// Sprint 87: helpers for ExprCast type-aware lowering
fn lower_cast_type_is_f64(ct: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *ct {
        Some(te) => {
            let seg = (*te).path.segments
            if seg.head_len != 3 { return false }
            if seg.head_buf[0] as i64 != 102 { return false }   // 'f'
            if seg.head_buf[1] as i64 != 54 { return false }    // '6'
            if seg.head_buf[2] as i64 != 52 { return false }    // '4'
            true
        }
        None => false,
    }
}

fn lower_type_expr_is_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 3 { return false }
    if seg.head_buf[0] as i64 != 102 { return false }   // 'f'
    if seg.head_buf[1] as i64 != 54 { return false }    // '6'
    if seg.head_buf[2] as i64 != 52 { return false }    // '4'
    true
}

fn lower_type_expr_is_array_of_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeArray { return false }
    match (*te).inner {
        Some(inner_ty) => lower_type_expr_is_f64(&(*inner_ty)),
        None => false,
    }
}

fn lower_opt_type_is_f64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_f64(&(*te)),
        None => false,
    }
}

fn lower_opt_type_is_array_of_f64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_array_of_f64(&(*te)),
        None => false,
    }
}

fn lower_opt_type_named_name(opt: &Option<Box<TypeExpr>>) -> Name with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind == TypeExprKind::TypeNamed {
                return ir_path_first_name((*te).path)
            }
            ir_empty_name()
        }
        None => ir_empty_name(),
    }
}

fn lower_name_wide_int_bits(n: Name) -> i64 with Panic, Div {
    if n.len < 2 { return 0 }
    let c0 = n.buf[0] as i64
    if c0 != 105 && c0 != 117 { return 0 }
    var bits: i64 = 0
    var i: i64 = 1
    while i < n.len {
        let d = n.buf[i as usize] as i64
        if d < 48 || d > 57 { return 0 }
        bits = bits * 10 + (d - 48)
        i = i + 1
    }
    if bits <= 64 { return 0 }
    bits
}

fn lower_type_expr_wide_bits(te: &TypeExpr) -> i64 with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return 0 }
    lower_name_wide_int_bits(ir_path_first_name((*te).path))
}

fn lower_opt_type_wide_bits(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_wide_bits(&(*te)),
        None => 0,
    }
}

fn lower_opt_type_wide_signed(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind != TypeExprKind::TypeNamed { return 0 }
            let n = ir_path_first_name((*te).path)
            if lower_name_wide_int_bits(n) <= 0 { return 0 }
            if n.buf[0] as i64 == 105 { 1 } else { 0 }
        }
        None => 0,
    }
}

fn lower_wide_limb_count(bits: i64) -> i64 {
    if bits <= 0 { return 0 }
    (bits + 63) / 64
}

fn lower_binary_op_to_wide_cmp(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpEq { return 0 }
    if op == BinaryOp::OpNe { return 1 }
    if op == BinaryOp::OpLt { return 2 }
    if op == BinaryOp::OpLe { return 3 }
    if op == BinaryOp::OpGt { return 4 }
    if op == BinaryOp::OpGe { return 5 }
    -1
}

fn lower_binary_op_is_compare(op: BinaryOp) -> bool {
    lower_binary_op_to_wide_cmp(op) >= 0
}

fn lower_opt_expr_has_float_source(opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprFloatLit { return true }
            if (*e).kind == ExprKind::ExprCast {
                return lower_cast_type_is_f64(&(*e).cast_type)
            }
            if (*e).kind == ExprKind::ExprBinary {
                let lref = &(*e).left
                match *lref {
                    Some(lc) => {
                        if (*lc).kind == ExprKind::ExprFloatLit { return true }
                    }
                    None => {}
                }
                let rref = &(*e).right
                match *rref {
                    Some(rc) => {
                        if (*rc).kind == ExprKind::ExprFloatLit { return true }
                        if (*rc).kind == ExprKind::ExprCast {
                            if lower_cast_type_is_f64(&(*rc).cast_type) { return true }
                        }
                    }
                    None => {}
                }
            }
            false
        }
        None => false,
    }
}

fn lower_expr_has_float_source_ref(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind == ExprKind::ExprFloatLit { return true }
    if (*e).kind == ExprKind::ExprCast {
        return lower_cast_type_is_f64(&(*e).cast_type)
    }
    if (*e).kind == ExprKind::ExprBinary {
        if lower_opt_expr_has_float_source(&(*e).left) { return true }
        if lower_opt_expr_has_float_source(&(*e).right) { return true }
    }
    false
}

fn lower_expr_is_f64_array_literal_ref(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind != ExprKind::ExprArrayLit { return false }
    match (*e).left {
        Some(repeat_expr) => lower_expr_has_float_source_ref(&(*repeat_expr)),
        None => {
            match (*e).args {
                Some(args) => lower_expr_has_float_source_ref(&(*args).head),
                None => false,
            }
        }
    }
}

fn lower_struct_field_float_kind_ref(e: &Expr) -> i64 with Mut, Panic, Div {
    if lower_expr_is_f64_array_literal_ref(e) { return 2 }
    if lower_expr_has_float_source_ref(e) { return 1 }
    0
}


impl Lowerer {
    fn current_fn_compile_strategy(self) -> i64 with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return IR_STRATEGY_STANDARD
        }
        if self.current_func_loaded {
            self.current_func.compile_strategy
        } else {
            self.module.functions[self.current_fn as usize].compile_strategy
        }
    }

    fn current_fn_validated_reg(self) -> i64 with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return IR_INVALID_REG
        }
        if self.current_func_loaded && self.current_func.param_count > 0 {
            self.current_func.param_regs[0]
        } else {
            self.module.functions[self.current_fn as usize].param_regs[0]
        }
    }

    fn flush_current_func(self) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if lo.current_func_loaded && lo.current_fn >= 0 && lo.current_fn < lo.module.fn_count {
            var module_box = lo.module
            (*module_box).functions[lo.current_fn as usize] = *lo.current_func
            lo.module = module_box
        }
        lo.current_func_loaded = false
        lo
    }

    fn begin_function_body_lowering(self, fn_id: i64, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self.flush_current_func()
        lo.current_fn = fn_id
        var current_func = ir_empty_function()
        current_func.name = name
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            let preserved = lo.module.functions[fn_id as usize]
            current_func.name = preserved.name
            current_func.compile_strategy = preserved.compile_strategy
            current_func.returns_float = preserved.returns_float
            current_func.return_struct_name = preserved.return_struct_name
            current_func.prof_counter_id = preserved.prof_counter_id
        }
        lo.current_func = Box::new(current_func)
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals = *lo.locals
        rst_locals.count = 0
        lo.locals = Box::new(rst_locals)
        lo.scope_depth = 0
        lo.loop_depth = 0
        lo
    }

    fn metadata_span_matches(self, span: Span, start: i64, end: i64) -> bool {
        if self.probe_mode {
            return false
        }
        start == span.start && end == span.end
    }

    fn find_contest_id_for_span(self, span: Span) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.epistemic.contest_count {
            let info = self.module.epistemic.contests[i]
            if self.metadata_span_matches(span, info.span_start, info.span_end) {
                return i
            }
            i = i + 1
        }
        -1
    }

