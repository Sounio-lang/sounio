    let lo = lowerer_new_with_epistemic(&epistemic)
    var lo2 = lo
    lowerer_preseed_program_items_mut(&! lo2, &prog.items, ir_empty_name())
    IrProgramSummaryFlatResult {
        summary: IrProgramSummaryFlat {
            module: *lo2.module,
            enum_variants: *lo2.enum_variants,
            struct_layouts: *lo2.struct_layouts,
            global_types: *lo2.global_types,
            probe_mode: lo2.probe_mode,
        },
        error_count: lo2.error_count,
        had_error: lo2.had_error,
