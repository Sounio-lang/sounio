    fn emit_i64_const(self, value: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, value))
        (lo2, reg)
    }

    fn emit_f64_const(self, value: f64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, f64_to_bits(value)))
        let lo3 = lo2.emit(ir_mark_float_reg(reg))
        (lo3, reg)
    }

    fn emit_name_string(self, n: Name) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair_idx = self.intern_string(n)
        let lo1 = pair_idx.0
        let idx = pair_idx.1
        let pair_reg = lo1.fresh_reg()
        let lo2 = pair_reg.0
        let reg = pair_reg.1
        let lo3 = lo2.emit(ir_load_string(reg, idx, n))
        (lo3, reg)
    }

    fn contest_witness_kind_from_callee(self, n: Name) -> i64 with Mut, Panic, Div {
        if n.len == 14
            && n.buf[0] == 115 as i8 && n.buf[1] == 105 as i8 && n.buf[2] == 103 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 95 as i8 && n.buf[5] == 99 as i8 && n.buf[6] == 111 as i8 && n.buf[7] == 110 as i8
            && n.buf[8] == 115 as i8 && n.buf[9] == 101 as i8 && n.buf[10] == 110 as i8 && n.buf[11] == 115 as i8
            && n.buf[12] == 117 as i8 && n.buf[13] == 115 as i8 {
            return 0
        }
        if n.len == 13
            && n.buf[0] == 114 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 108 as i8 && n.buf[3] == 97 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 105 as i8 && n.buf[6] == 118 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 95 as i8 && n.buf[9] == 98 as i8 && n.buf[10] == 97 as i8 && n.buf[11] == 110 as i8
            && n.buf[12] == 100 as i8 {
            return 1
        }
        if n.len == 13
            && n.buf[0] == 109 as i8 && n.buf[1] == 97 as i8 && n.buf[2] == 120 as i8 && n.buf[3] == 95 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 97 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 108 as i8
            && n.buf[8] == 95 as i8 && n.buf[9] == 114 as i8 && n.buf[10] == 105 as i8 && n.buf[11] == 115 as i8
            && n.buf[12] == 107 as i8 {
            return 2
        }
        if n.len == 22
            && n.buf[0] == 109 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 99 as i8 && n.buf[3] == 104 as i8
            && n.buf[4] == 97 as i8 && n.buf[5] == 110 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 115 as i8
            && n.buf[8] == 116 as i8 && n.buf[9] == 105 as i8 && n.buf[10] == 99 as i8 && n.buf[11] == 95 as i8
            && n.buf[12] == 100 as i8 && n.buf[13] == 105 as i8 && n.buf[14] == 118 as i8 && n.buf[15] == 101 as i8
            && n.buf[16] == 114 as i8 && n.buf[17] == 103 as i8 && n.buf[18] == 101 as i8 && n.buf[19] == 110 as i8
            && n.buf[20] == 99 as i8 && n.buf[21] == 101 as i8 {
            return 3
        }
        if n.len == 21
            && n.buf[0] == 105 as i8 && n.buf[1] == 100 as i8 && n.buf[2] == 101 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 105 as i8 && n.buf[6] == 102 as i8 && n.buf[7] == 105 as i8
            && n.buf[8] == 97 as i8 && n.buf[9] == 98 as i8 && n.buf[10] == 105 as i8 && n.buf[11] == 108 as i8
            && n.buf[12] == 105 as i8 && n.buf[13] == 116 as i8 && n.buf[14] == 121 as i8 && n.buf[15] == 95 as i8
            && n.buf[16] == 102 as i8 && n.buf[17] == 108 as i8 && n.buf[18] == 111 as i8 && n.buf[19] == 111 as i8
            && n.buf[20] == 114 as i8 {
            return 4
        }
        if n.len == 12
            && n.buf[0] == 100 as i8 && n.buf[1] == 105 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 97 as i8
            && n.buf[4] == 103 as i8 && n.buf[5] == 114 as i8 && n.buf[6] == 101 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 109 as i8 && n.buf[9] == 101 as i8 && n.buf[10] == 110 as i8 && n.buf[11] == 116 as i8 {
            return 5
        }
        if n.len == 14
            && n.buf[0] == 99 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 101 as i8 && n.buf[6] == 114 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 120 as i8 && n.buf[9] == 97 as i8 && n.buf[10] == 109 as i8 && n.buf[11] == 112 as i8
            && n.buf[12] == 108 as i8 && n.buf[13] == 101 as i8 {
            return 6
        }
        if n.len == 17
            && n.buf[0] == 112 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 116 as i8
            && n.buf[4] == 101 as i8 && n.buf[5] == 114 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 111 as i8
            && n.buf[8] == 114 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 119 as i8 && n.buf[11] == 101 as i8
            && n.buf[12] == 105 as i8 && n.buf[13] == 103 as i8 && n.buf[14] == 104 as i8 && n.buf[15] == 116 as i8
            && n.buf[16] == 115 as i8 {
            return 7
        }
        -1
    }

    fn emit_named_field(self, base_reg: i64, field_name: Name, value_reg: i64) -> Lowerer with Mut, Panic, Div, IO {
        let field_idx = self.field_idx_from_name_simple(field_name)
        self.emit(ir_field_set(base_reg, field_idx, value_reg, field_name))
    }

    fn emit_name_array_values(self, base_reg: i64, names: [Name; 16], count: i64, idx: i64) -> Lowerer with Mut, Panic, Div, IO {
        if idx >= count || idx >= 16 {
            return self
        }
        let pair_name = self.emit_name_string(names[idx as usize])
        let lo1 = pair_name.0
        let name_reg = pair_name.1
        let pair_idx = lo1.emit_i64_const(idx)
        let lo2 = pair_idx.0
        let idx_reg = pair_idx.1
        let lo3 = lo2.emit(ir_index_set(base_reg, idx_reg, name_reg))
        lo3.emit_name_array_values(base_reg, names, count, idx + 1)
    }

    fn emit_f64_array_values(self, base_reg: i64, values: [f64; 16], count: i64, idx: i64) -> Lowerer with Mut, Panic, Div, IO {
        if idx >= count || idx >= 16 {
            return self
        }
        let pair_value = self.emit_f64_const(values[idx as usize])
        let lo1 = pair_value.0
        let value_reg = pair_value.1
        let pair_idx = lo1.emit_i64_const(idx)
        let lo2 = pair_idx.0
        let idx_reg = pair_idx.1
        let lo3 = lo2.emit(ir_index_set(base_reg, idx_reg, value_reg))
        lo3.emit_f64_array_values(base_reg, values, count, idx + 1)
    }

    fn aggregate_storage_bytes(self, elem_count: i64) -> i64 {
        let _lo = self
        if elem_count <= 0 { 8 } else { elem_count * 8 }
    }

    fn emit_fixed_array_value_copy(self, src_reg: i64, elem_count: i64, elem_is_float: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst_reg = pair_dst.1
        lo = lo.emit(ir_alloc_array(dst_reg, lo.aggregate_storage_bytes(elem_count), elem_count))
        if elem_is_float {
            lo = lo.emit(ir_mark_float_reg(dst_reg))
            lo = lo.bind_reg_array_elem_float(dst_reg)
        }
        if elem_count <= 0 {
            return (lo, dst_reg)
        }

        let pair_idx = lo.emit_i64_const(0)
        lo = pair_idx.0
        let idx_reg = pair_idx.1
        let pair_limit = lo.emit_i64_const(elem_count)
        lo = pair_limit.0
        let limit_reg = pair_limit.1
        let pair_one = lo.emit_i64_const(1)
        lo = pair_one.0
        let one_reg = pair_one.1
        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let top_label = pair_top.1
        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let end_label = pair_end.1

        lo = lo.emit(ir_label(top_label))
        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond_reg = pair_cond.1
        lo = lo.emit(ir_binop(cond_reg, idx_reg, BinaryOp::OpLt, limit_reg))
        lo = lo.emit(ir_branch_false(cond_reg, end_label))

        let pair_elem = lo.fresh_reg()
        lo = pair_elem.0
        let elem_reg = pair_elem.1
        var load_instr = ir_index_get(elem_reg, src_reg, idx_reg)
        if elem_is_float {
            load_instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        lo = lo.emit(load_instr)
        lo = lo.emit(ir_index_set(dst_reg, idx_reg, elem_reg))

        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, idx_reg, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(idx_reg, next_reg))
        lo = lo.emit(ir_jump(top_label))
        lo = lo.emit(ir_label(end_label))
        (lo, dst_reg)
    }

    // Slot count of a registered struct layout, or -1 when the type is unknown.
    //
    // Deliberately NOT `field_count`: `lowerer_register_struct_fields_mut`
    // APPENDS (reads field_count, writes fields[fc], sets field_count = fc + 1),
    // so a type registered twice — declaration pass plus import seeding — carries
    // a DOUBLED field_count while the per-entry `index` values are re-emitted as
    // 0..n-1 both times. Name lookup is immune to the over-count; a slot count is
    // not, and an over-count would read past the source object's payload.
    // `1 + max(index)` is stable under repeated registration.
    fn struct_layout_slot_count(self, type_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        if type_name.len <= 0 { return 0 - 1 }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var max_idx: i64 = 0 - 1
                var fi: i64 = 0
                let fc = (*self.struct_layouts).entries[si as usize].field_count
                while fi < fc && fi < 128 {
                    let idx = (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    if idx > max_idx { max_idx = idx }
                    fi = fi + 1
                }
                if max_idx < 0 { return 0 - 1 }
                let slots = max_idx + 1
                if slots > 64 { return 0 - 1 }
                return slots
            }
            si = si + 1
        }
        0 - 1
    }

    // Field name registered at `slot_index` for `type_name` (empty when absent).
    // Passed through to ir_field_get/ir_field_set so any name-keyed metadata a
    // later pass consults still resolves; codegen itself addresses by field_idx.
    fn struct_layout_field_name_at(self, type_name: Name, slot_index: i64) -> Name with Mut, Panic, Div, Alloc {
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                let fc = (*self.struct_layouts).entries[si as usize].field_count
                while fi < fc && fi < 128 {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].index == slot_index {
                        return ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id)
                    }
                    fi = fi + 1
                }
                return ir_empty_name()
            }
            si = si + 1
        }
        ir_empty_name()
    }

    // Value-copy a struct handle: allocate fresh backing storage and copy every
    // slot. This is the struct analogue of emit_fixed_array_value_copy and gives
    // `var p2 = p1` the same semantics lean_single already has (a flat nslots
    // word copy, `copy_struct_into_local_slot_a64`).
    //
    // FLAT, like lean_single's: a field holding an aggregate HANDLE is copied as
    // a handle, so the nested object stays shared. That is a real boundary, not
    // an oversight — see the note at the call site.
    //
    // Emitted as IrFieldGet/IrFieldSet rather than IrIndexGet/IrIndexSet: the
    // field ops take the plain handle-resolve path in codegen (a GPR load/store,
    // bit-exact for f64 payloads) and additionally propagate float-field
    // metadata from source field to destination field via
    // nc_core_field_is_float / nc_core_mark_float_field. The index ops carry
    // four label_id-selected addressing variants (ref/BSS/param/local) that do
    // not apply to a struct handle.
    fn emit_struct_value_copy(self, src_reg: i64, type_name: Name, slot_count: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst_reg = pair_dst.1
        lo = lo.emit(ir_alloc(dst_reg, lo.aggregate_storage_bytes(slot_count)))
        var i: i64 = 0
        while i < slot_count && i < 64 {
            let fname = lo.struct_layout_field_name_at(type_name, i)
            let pair_slot = lo.fresh_reg()
            lo = pair_slot.0
            let slot_reg = pair_slot.1
            lo = lo.emit(ir_field_get(slot_reg, src_reg, i, fname))
            lo = lo.emit(ir_field_set(dst_reg, i, slot_reg, fname))
            i = i + 1
        }
        (lo, dst_reg)
    }

    // #1479: ONE lookup shared by every per-field query the deep copy makes.
    //
    // Returns `layout_entry_index * 64 + field_entry_index` for the entry that
    // registers slot `slot_index` of `type_name`, or -1 when absent.
    //
    // Why one position instead of three independent scans: a struct type can be
    // registered TWICE (declaration pass plus import / literal seeding) by
    // DIFFERENT code paths, and those paths do not populate identical fields —
    // one of them omits `elem_type_name` outright. Independent scans could
    // therefore read the field name from one registration and the array length
    // from another. Resolving the position once and reading every field from it
    // makes that impossible. The scan rule (FIRST matching type entry, then the
    // first field whose `index` equals the slot) is byte-identical to
    // struct_layout_slot_count and struct_layout_field_name_at.
    fn struct_layout_field_pos(self, type_name: Name, slot_index: i64) -> i64 with Mut, Panic, Div, Alloc {
        if type_name.len <= 0 { return 0 - 1 }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                let fc = (*self.struct_layouts).entries[si as usize].field_count
                while fi < fc && fi < 128 {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].index == slot_index {
                        return si * 64 + fi
                    }
                    fi = fi + 1
                }
                return 0 - 1
            }
            si = si + 1
        }
        0 - 1
    }

    // The declared named type of `<type_name>.<field_name>`, or an empty name.
    // struct_layout_field_pos resolves by SLOT INDEX; a field access carries a
    // NAME, so this is the by-name sibling. The data was already recorded --
    // `named_type_name_id` is written at every site that builds a
    // StructFieldEntry -- and nothing read it for this purpose.
    fn struct_layout_field_named_type(self, type_name: Name, field_name: Name) -> Name with Mut, Panic, Div, Alloc {
        if type_name.len <= 0 { return ir_empty_name() }
        if field_name.len <= 0 { return ir_empty_name() }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                let fc = (*self.struct_layouts).entries[si as usize].field_count
                while fi < fc && fi < 128 {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id)
                    }
                    fi = fi + 1
                }
                return ir_empty_name()
            }
            si = si + 1
        }
        ir_empty_name()
    }

    fn struct_layout_pos_field_name(self, pos: i64) -> Name with Mut, Panic, Div, Alloc {
        if pos < 0 { return ir_empty_name() }
        let si = pos / 64
        let fi = pos - si * 64
        if si >= (*self.struct_layouts).count { return ir_empty_name() }
        // Ported onto main's interned-name representation (was `.name: Name`).
        // NOTE: leaving this as `.name` type-checked and BUILT anyway -- that is #1494
        // (typecheck errors in imported modules are non-fatal and still emit code),
        // and the resulting compiler segfaulted at the first deep copy.
        ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id)
    }

    fn struct_layout_pos_array_len(self, pos: i64) -> i64 with Mut, Panic, Div, Alloc {
        if pos < 0 { return 0 }
        let si = pos / 64
        let fi = pos - si * 64
        if si >= (*self.struct_layouts).count { return 0 }
        (*self.struct_layouts).entries[si as usize].fields[fi as usize].word_scalar_array_len
    }

    fn struct_layout_pos_is_float(self, pos: i64) -> i64 with Mut, Panic, Div, Alloc {
        if pos < 0 { return 0 }
        let si = pos / 64
        let fi = pos - si * 64
        if si >= (*self.struct_layouts).count { return 0 }
        (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float
    }

    fn struct_layout_pos_named_type(self, pos: i64) -> Name with Mut, Panic, Div, Alloc {
        if pos < 0 { return ir_empty_name() }
        let si = pos / 64
        let fi = pos - si * 64
        if si >= (*self.struct_layouts).count { return ir_empty_name() }
        // Ported onto main's interned-name representation: the layout now stores an
        // id, and `ir_name_at` is main's existing id -> Name reverse.
        ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id)
    }

    // #1479: how deep the value-copy follows nested STRUCT fields. 2 covers
    // `Outer { inner: Inner }` and `L0 { l1: L1 { l2: L2 } }`.
    //
    // A DEPTH cap, deliberately, rather than a visited-type set: a
    // self-referential or mutually recursive struct type must not spin at
    // LOWERING time, and depth alone guarantees termination however the cycle is
    // spelled. A field past the cap simply keeps the shared handle, which is the
    // #1475 flat behaviour — never worse than what shipped.
    fn struct_deep_copy_max_depth(self) -> i64 {
        let _lo = self
        2
    }

    // #1479: instructions held in reserve below IR_MAX_INSTRS. A deep copy is
    // emitted only when its PROJECTED cost fits in what is left, so a struct big
    // enough that following its aggregate fields would not fit degrades to the
    // flat copy rather than pushing the function past the 4096-instruction cap.
    fn struct_deep_copy_instr_headroom(self) -> i64 {
        let _lo = self
        512
    }

    // #1479: instruction cost of emit_fixed_array_value_copy. That copy is a
    // LOOP, so this is O(1) in the element count: alloc(1) + optional float
    // marker(1) + three ir_load_imm(3) + label(1) + cmp(1) + branch_false(1) +
    // index_get(1) + index_set(1) + add(1) + copy(1) + jump(1) + label(1) = 15.
    // Rounded UP to 16: over-estimating only makes the budget conservative,
    // whereas under-estimating would let a copy run past the cap.
    fn struct_deep_copy_array_cost(self) -> i64 {
        let _lo = self
        16
    }

    // #1479: cost of the null-handle guard around one deep field —
    // ir_load_imm(0) + cmp + branch_false + the overwriting field_set + label.
    fn struct_deep_copy_guard_cost(self) -> i64 {
        let _lo = self
        5
    }

    // #1479: slot count of a nested STRUCT-typed field, or -1 when it is not a
    // field the deep copy may follow.
    //
    // Excluded for the same reasons they are excluded at the top level:
    //   Box       — reference semantics by construction; the self-hosted AST is
    //               Box-linked and deep-copying would change its meaning.
    //   Knowledge — variance rides ALONGSIDE the slots (pending_variance_reg),
    //               so copying slots alone would half-copy it.
    // Everything else falls out of struct_layout_slot_count returning -1: a
    // primitive name, a generic head such as Option, an unregistered type.
    fn nested_struct_field_slot_count(self, field_type_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        if field_type_name.len <= 0 { return 0 - 1 }
        if ir_name_is_box(field_type_name) { return 0 - 1 }
        if ir_name_eq(field_type_name, make_name("Knowledge")) { return 0 - 1 }
        self.struct_layout_slot_count(field_type_name)
    }

    // #1479: PROJECTED instruction count of emit_struct_value_copy_deep for this
    // type at this depth. It tracks the emitter arm for arm and must keep doing
    // so: an over-estimate only degrades the copy to flat, an under-estimate
    // would let it overrun IR_MAX_INSTRS.
    fn struct_deep_copy_cost(self, type_name: Name, slot_count: i64, depth: i64) -> i64 with Mut, Panic, Div, Alloc {
        var total: i64 = 1
        var i: i64 = 0
        while i < slot_count && i < 64 {
            total = total + 2
            let pos = self.struct_layout_field_pos(type_name, i)
            let arr_len = self.struct_layout_pos_array_len(pos)
            if arr_len > 0 {
                total = total + self.struct_deep_copy_guard_cost() + self.struct_deep_copy_array_cost()
            } else if depth < self.struct_deep_copy_max_depth() {
                let nested_name = self.struct_layout_pos_named_type(pos)
                let nested_slots = self.nested_struct_field_slot_count(nested_name)
                if nested_slots > 0 {
                    total = total + self.struct_deep_copy_guard_cost() + self.struct_deep_copy_cost(nested_name, nested_slots, depth + 1)
                }
            }
            i = i + 1
        }
        total
    }

    // #1479: value-copy a struct handle, following AGGREGATE fields instead of
    // sharing them.
    //
    // #1475 made `var s2 = s1` copy the outer slots, which fixed scalar fields.
    // The copy stayed FLAT, so a field holding an array or a nested struct copied
    // the 64-bit HANDLE and `s2.arr[0] = 99` was still observed through `s1` —
    // check passed, the ELF ran, exit 0, wrong answer. This walks into those
    // fields: fresh backing storage, contents copied.
    //
    // The REPRESENTATION is unchanged. Madaros lays a struct out as one word per
    // field (`lower_struct_literal_expr_ref`, count_struct_fields * 8) with an
    // aggregate field held as a handle, where lean_single INLINES it
    // (struct_like_nslots = st_total_size / 8). Making the two agree would touch
    // struct-literal lowering, every field offset, the native backend and the
    // SOIR wire layout; this is local to the copy site and touches none of them.
    //
    // Every field is FLAT-copied FIRST and only then, under a guard, overwritten
    // with the deep copy. The pre-#1479 behaviour is therefore the floor: an
    // unknown shape, a type past the depth cap, or a null slot all keep the
    // shared handle rather than losing the value.
    //
    // That guard is not tidiness. A slot can legitimately hold 0 — a field never
    // assigned an aggregate — and native_v2_resolve_handle_to_object_base_rax_into
    // treats 0 as a handle-table INDEX, so an unguarded copy would dereference
    // whatever entry 0 holds. Trading an aliasing bug for a segfault is not a fix.
    fn emit_struct_value_copy_deep(self, src_reg: i64, type_name: Name, slot_count: i64, depth: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst_reg = pair_dst.1
        lo = lo.emit(ir_alloc(dst_reg, lo.aggregate_storage_bytes(slot_count)))
        var i: i64 = 0
        while i < slot_count && i < 64 {
            let pos = lo.struct_layout_field_pos(type_name, i)
            let fname = lo.struct_layout_pos_field_name(pos)
            let pair_slot = lo.fresh_reg()
            lo = pair_slot.0
            let slot_reg = pair_slot.1
            lo = lo.emit(ir_field_get(slot_reg, src_reg, i, fname))
            lo = lo.emit(ir_field_set(dst_reg, i, slot_reg, fname))
            let arr_len = lo.struct_layout_pos_array_len(pos)
            var nested_name = ir_empty_name()
            var nested_slots: i64 = 0 - 1
            if arr_len <= 0 && depth < lo.struct_deep_copy_max_depth() {
                nested_name = lo.struct_layout_pos_named_type(pos)
                nested_slots = lo.nested_struct_field_slot_count(nested_name)
            }
            if arr_len > 0 || nested_slots > 0 {
                let pair_zero = lo.emit_i64_const(0)
                lo = pair_zero.0
                let zero_reg = pair_zero.1
                let pair_cond = lo.fresh_reg()
                lo = pair_cond.0
                let cond_reg = pair_cond.1
                lo = lo.emit(ir_binop(cond_reg, slot_reg, BinaryOp::OpNe, zero_reg))
                let pair_skip = lo.fresh_label()
                lo = pair_skip.0
                let skip_label = pair_skip.1
                lo = lo.emit(ir_branch_false(cond_reg, skip_label))
                if arr_len > 0 {
                    // is_float == 2 is the registered marker for an array-of-f64
                    // field. Marking the fresh handle float here reproduces exactly
                    // what the struct LITERAL does for the same field:
                    // lower_array_literal_expr_ref marks the handle, then
                    // lower_struct_fields_ref field_sets it, which propagates the
                    // float class to the destination field.
                    let elem_is_float = lo.struct_layout_pos_is_float(pos) == 2
                    let arr_pair = lo.emit_fixed_array_value_copy(slot_reg, arr_len, elem_is_float)
                    lo = arr_pair.0
                    lo = lo.emit(ir_field_set(dst_reg, i, arr_pair.1, fname))
                } else {
                    let sub_pair = lo.emit_struct_value_copy_deep(slot_reg, nested_name, nested_slots, depth + 1)
                    lo = sub_pair.0
                    lo = lo.emit(ir_field_set(dst_reg, i, sub_pair.1, fname))
                }
                lo = lo.emit(ir_label(skip_label))
            }
            i = i + 1
        }
        (lo, dst_reg)
    }

    // Whether `var y = x` on struct-typed local `x` may be value-copied.
    //
    // Excluded, each for a distinct reason:
    //   Box       — reference semantics by construction; the whole self-hosted
    //               AST is Box-linked, and deep-copying would change meaning.
    //   Knowledge — variance is tracked ALONGSIDE the 3 slots via
    //               pending_variance_reg / fo_bind_pending_to_local. Copying the
    //               slots while the variance binding still points at the source
    //               register would be a new half-copied inconsistency, aimed
    //               straight at the epistemic gates.
    //   is_ref    — `&T` / `&!T` locals: aliasing is what a reference MEANS.
    //   is_global — BSS-backed globals use their own addressing.
    fn struct_local_is_value_copyable(self, name: Name, type_name: Name) -> bool with Mut, Panic, Div, Alloc {
        if type_name.len <= 0 { return false }
        if ir_name_is_box(type_name) { return false }
        if ir_name_eq(type_name, make_name("Knowledge")) { return false }
        if self.lookup_local_is_ref(name) { return false }
        if self.lookup_local_is_global(name) { return false }
        true
    }

    fn expr_is_zero_fill_value(self, e: Expr) -> bool {
        let _lo = self
        if e.kind == ExprKind::ExprIntLit { return e.int_val == 0 }
        if e.kind == ExprKind::ExprBoolFalse { return true }
        if e.kind == ExprKind::ExprFloatLit { return e.float_val == 0.0 }
        false
    }

    // True for expressions whose lowered register is a POINTER to a freshly
    // allocated object rather than an immediate value. Array slots are 8-byte
    // boxed pointers (`aggregate_storage_bytes` = elem_count * 8), so filling
    // every slot from one such register aliases all N elements onto ONE object.
    //
    // The gate is deliberately SYNTACTIC: it recognises aggregate *literals*
    // only. `[p; 4]` (struct variable) and `[mk(); 4]` (struct-returning call)
    // are NOT covered — separating them from scalars needs element type
    // information that the lowerer does not carry at this site.
    fn expr_is_aggregate_value_ref(self, e: &Expr) -> bool {
        let _lo = self
        if e.kind == ExprKind::ExprStructLit { return true }
        if e.kind == ExprKind::ExprArrayLit { return true }
        if e.kind == ExprKind::ExprTupleLit { return true }
        false
    }

    // Fill `base_reg[0 .. repeat_count]` with DISTINCT objects.
    //
    // The value expression is lowered exactly ONCE, but INSIDE the loop body.
    // `IrAlloc` lowers to a runtime heap bump (`nc_core_emit_alloc_into`), so
    // re-executing the body allocates a fresh object per iteration while the
    // emitted IR stays O(1) in `repeat_count`. Unrolling the lowering instead
    // would overflow IR_MAX_INSTRS (4096 per function) on real sources such as
    // `[Token { .. }; 4096]` in self-hosted/compiler/lexer.sio.
    //
    // Hoisting safety: the live LICM path (`lopt_ir_is_hoistable_opcode` in
    // ir/loop_opt.sio) allowlists only LoadImm/LoadFloat/LoadBool/Copy/BinOp/
    // UnaryOp, so IrAlloc cannot be lifted into the preheader and re-alias the
    // elements. Keep IrAlloc out of that allowlist.
    fn lower_array_repeat_fill_distinct(self, base_reg: i64, value_expr: &Expr, repeat_count: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        if repeat_count <= 0 {
            return self
        }

        let pair_idx = self.emit_i64_const(0)
        var lo = pair_idx.0
        let idx_reg = pair_idx.1

        let pair_limit = lo.emit_i64_const(repeat_count)
        lo = pair_limit.0
        let limit_reg = pair_limit.1

        let pair_one = lo.emit_i64_const(1)
        lo = pair_one.0
        let one_reg = pair_one.1

        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let top_label = pair_top.1

        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let end_label = pair_end.1

        lo = lo.emit(ir_label(top_label))

        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond_reg = pair_cond.1
        lo = lo.emit(ir_binop(cond_reg, idx_reg, BinaryOp::OpLt, limit_reg))
        lo = lo.emit(ir_branch_false(cond_reg, end_label))

        let pair_value = lo.lower_expr_ref(value_expr)
        lo = pair_value.0
        let value_reg = pair_value.1
        lo = lo.emit(ir_index_set(base_reg, idx_reg, value_reg))

        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, idx_reg, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(idx_reg, next_reg))
        lo = lo.emit(ir_jump(top_label))
        lo = lo.emit(ir_label(end_label))
        lo
    }

    fn lower_array_repeat_fill(self, base_reg: i64, value_reg: i64, repeat_count: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        if repeat_count <= 0 {
            return self
        }

        let pair_idx = self.emit_i64_const(0)
        var lo = pair_idx.0
        let idx_reg = pair_idx.1

        let pair_limit = lo.emit_i64_const(repeat_count)
        lo = pair_limit.0
        let limit_reg = pair_limit.1

        let pair_one = lo.emit_i64_const(1)
        lo = pair_one.0
        let one_reg = pair_one.1

        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let top_label = pair_top.1

        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let end_label = pair_end.1

        lo = lo.emit(ir_label(top_label))

        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond_reg = pair_cond.1
        lo = lo.emit(ir_binop(cond_reg, idx_reg, BinaryOp::OpLt, limit_reg))
        lo = lo.emit(ir_branch_false(cond_reg, end_label))
        lo = lo.emit(ir_index_set(base_reg, idx_reg, value_reg))

        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, idx_reg, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(idx_reg, next_reg))
        lo = lo.emit(ir_jump(top_label))
        lo = lo.emit(ir_label(end_label))
        lo
    }

    fn lower_array_repeat_literal_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let right_opt: Option<Box<Expr>> = e.right
        let repeat_count = match right_opt {
            Some(count_expr) => (*count_expr).int_val,
            None => 0,
        }
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc_array(dst, lo.aggregate_storage_bytes(repeat_count), repeat_count))

        let left_opt: Option<Box<Expr>> = e.left
        match left_opt {
            Some(value_expr) => {
                let elem_is_float = lower_expr_has_float_source_ref(&(*value_expr))
                // Aggregate literals must be re-materialised per slot, otherwise
                // every element aliases one object. repeat_count <= 0 keeps the
                // legacy path so the value expression is still lowered exactly
                // as before for empty arrays.
                if repeat_count > 0 && lo.expr_is_aggregate_value_ref(&(*value_expr)) {
                    lo = lo.lower_array_repeat_fill_distinct(dst, &(*value_expr), repeat_count)
                } else {
                    let zero_fill = lo.expr_is_zero_fill_value(*value_expr)
                    let pair_value = lo.lower_expr_ref(&(*value_expr))
                    lo = pair_value.0
                    let value_reg = pair_value.1
                    if !zero_fill {
                        lo = lo.lower_array_repeat_fill(dst, value_reg, repeat_count)
                    }
                }
                if elem_is_float {
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo = lo.bind_reg_array_elem_float(dst)
                }
                (lo, dst)
            }
            None => (lo, dst),
        }
    }

    fn lower_array_repeat_literal(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_array_repeat_literal_ref(&e)
    }

    fn lower_name_array_literal(self, names: [Name; 16], count: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair_dst = self.fresh_reg()
        let lo1 = pair_dst.0
        let dst = pair_dst.1
        let lo2 = lo1.emit(ir_alloc_array(dst, lo1.aggregate_storage_bytes(count), count))
        let lo3 = lo2.emit_name_array_values(dst, names, count, 0)
        (lo3, dst)
    }

    fn lower_f64_array_literal(self, values: [f64; 16], count: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair_dst = self.fresh_reg()
        let lo1 = pair_dst.0
        let dst = pair_dst.1
        let lo2 = lo1.emit(ir_alloc_array(dst, lo1.aggregate_storage_bytes(count), count))
        var lo3 = lo2.emit_f64_array_values(dst, values, count, 0)
        lo3 = lo3.emit(ir_mark_float_reg(dst))
        lo3 = lo3.bind_reg_array_elem_float(dst)
        (lo3, dst)
    }

