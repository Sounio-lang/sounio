    // Mirrors bind_local_struct_type including the copy/rebox discipline. Separate from
    // struct_types on purpose: that slot keeps the literal "Box" because twelve sites read it and
    // two test it with ir_name_is_box (the explicit `*b` deref and the `*p = v` store path).
    fn bind_local_box_inner_layout(self, name: Name, layout_idx: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        if layout_idx < 0 { return self }
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if (*stk.depths).values[i as usize] <= lo.scope_depth && ir_name_eq((*stk.names).values[i as usize], name) {
                (*stk.box_inner_layout).values[i as usize] = layout_idx
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    // Struct type of a call's FIRST argument: for `Box::new(mk())` that is the boxed type T.
    fn expr_first_arg_struct_name_ref(self, call_expr: &Expr) -> Name with Mut, Panic, Div, Alloc {
        match (*call_expr).args {
            Some(arg_list) => {
                let first = &(*arg_list).head
                if (*first).kind == ExprKind::ExprCall {
                    return self.expr_call_return_struct_name_ref(first)
                }
                if (*first).kind == ExprKind::ExprStructLit {
                    return ir_path_first_name((*first).path)
                }
                ir_empty_name()
            }
            None => ir_empty_name(),
        }
    }

