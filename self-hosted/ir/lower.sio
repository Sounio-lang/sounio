// AST -> IR lowering

module ir::lower

use parser::ast::*
use ir::ir::*
use io::trace::*
use io::env::{read_env}

struct LowerLocalStack {
    names: [Name; 4096],
    regs: [i64; 4096],
    depths: [i64; 4096],
    struct_types: [Name; 4096],
    array_elem_float: [i64; 4096],
    // Logical element count for a directly-stored fixed array local. -1 means
    // the local is not a fixed array (or its extent is not statically known).
    array_lens: [i64; 4096],
    // 1 only when each array element is known to occupy one non-aggregate word.
    // Nested arrays and struct elements must not take the shallow slot-copy path.
    array_copy_word_scalar: [i64; 4096],
    wide_bits: [i64; 4096],
    wide_signed: [i64; 4096],
    global_bss_offsets: [i64; 4096],
    global_bss_sizes: [i64; 4096],
    is_global: [i64; 4096],
    // 1 = local/param holds a reference (&P / &[T;N] / &![T;N]) to a heap aggregate,
    // i.e. its slot stores a raw address of the caller slot, not the handle directly.
    is_ref: [i64; 4096],
    // 0=other 1=int 2=float; used by println dispatch to avoid routing i64/f64 vars through print_str
    scalar_kind: [i64; 4096],
    // f64 register carrying the GUM variance shadow for scalar locals, or -1 when absent.
    variance_regs: [i64; 4096],
    // -1 = not a capturing closure; otherwise the synthetic closure fn_id whose captures
    // must be injected when this local is called (closures step 2).
    closure_fn_id: [i64; 4096],
    count: i64,
}

fn empty_lower_local_stack() -> LowerLocalStack {
    LowerLocalStack {
        names: [ir_empty_name(); 4096],
        regs: [IR_INVALID_REG; 4096],
        depths: [0; 4096],
        struct_types: [ir_empty_name(); 4096],
        array_elem_float: [0; 4096],
        array_lens: [-1; 4096],
        array_copy_word_scalar: [0; 4096],
        wide_bits: [0; 4096],
        wide_signed: [0; 4096],
        global_bss_offsets: [0; 4096],
        global_bss_sizes: [0; 4096],
        is_global: [0; 4096],
        is_ref: [0; 4096],
        scalar_kind: [0; 4096],
        variance_regs: [-1; 4096],
        closure_fn_id: [-1; 4096],
        count: 0,
    }
}

// --- Capturing-closure support (closures step 2) ---
// A capturing closure is lowered as a synthetic fn whose LEADING params are the captured
// values, followed by the lambda's own params. The closure is never given a first-class
// runtime value (it stays out of the bare fn-ref representation, so #418 zero-capture
// closures + fn-pointer interop are untouched); instead the captured enclosing regs are
// injected at a direct call site. All stores use the extract-Box-first / copy-modify-
// writeback idiom to dodge the by-value-aggregate-store miscompile.
struct CaptureList {
    names: [Name; 8],
    regs: [i64; 8],
    count: i64,
}
fn empty_capture_list() -> CaptureList {
    CaptureList { names: [ir_empty_name(); 8], regs: [IR_INVALID_REG; 8], count: 0 }
}
fn capture_list_add(caps: CaptureList, name: Name, reg: i64) -> CaptureList with Mut, Panic, Div {
    var c = caps
    var i: i64 = 0
    while i < c.count {
        if ir_name_eq(c.names[i as usize], name) { return c }
        i = i + 1
    }
    if c.count < 8 {
        let idx = c.count
        c.names[idx as usize] = name
        c.regs[idx as usize] = reg
        c.count = idx + 1
    }
    c
}

struct ClosureCapEntry {
    fn_id: i64,
    cap_count: i64,
    caps: [i64; 8],
}
struct ClosureCapTable {
    entries: [ClosureCapEntry; 256],
    count: i64,
}
fn empty_closure_cap_table() -> ClosureCapTable {
    ClosureCapTable {
        entries: [ClosureCapEntry { fn_id: -1, cap_count: 0, caps: [IR_INVALID_REG; 8] }; 256],
        count: 0,
    }
}
fn lower_name_in_closure_params(params: &Option<Box<ClosureParamList>>, name: Name) -> bool with Mut, Panic, Div {
    var cur = params
    while true {
        match *cur {
            Some(pl) => {
                if ir_name_eq((*pl).head.name, name) { return true }
                cur = &(*pl).tail
            }
            _ => break
        }
    }
    false
}

struct LowerLoopLabels {
    break_labels: [i64; 256],
    continue_labels: [i64; 256],
}

fn empty_lower_loop_labels() -> LowerLoopLabels {
    LowerLoopLabels {
        break_labels: [IR_INVALID_LABEL; 256],
        continue_labels: [IR_INVALID_LABEL; 256],
    }
}

let LOWER_GLOBAL_ELEM_F64: i64 = 2
let LOWER_GLOBAL_SCALAR_F64: i64 = 3
// Word-size integer scalar global (`var G: i64 = …`). Distinct from 0/unknown so
// `print(G)` / `println(G)` can select print_int instead of the char* printer.
let LOWER_GLOBAL_SCALAR_I64: i64 = 1
// Non-f64 fixed array global (`var A: [i64; N] = …`, including N=1). Distinct from
// scalar kinds so Ident lowering loads the BSS *address* for IndexGet, not the
// stored element value. Without this, `[T; 1]` (bss_size <= 8) took the scalar
// load path and IndexGet treated the init word as a pointer → SEGV.
let LOWER_GLOBAL_ARRAY: i64 = 4

// Inter-procedural FO transfer table (module-global so it survives Lowerer
// by-value churn). Reset at each program-items lower start.
// kind: 0=none 1=id 2=scale 3=add 4=mul 5=fwd
// Keys are polynomial hashes of Name bytes (Name aggregates do not survive
// global array stores — same family as ClaimDecl name truncation).
var FO_XFER_COUNT: i64 = 0
var FO_XFER_KIND: [i64; 64] = [0; 64]
var FO_XFER_LIT: [f64; 64] = [0.0; 64]
var FO_XFER_HASH: [i64; 64] = [0; 64]
var FO_XFER_FWD_HASH: [i64; 64] = [0; 64]
var FO_XFER_BC_OFF: [i64; 64] = [0; 64]
var FO_XFER_BC_LEN: [i64; 64] = [0; 64]
// FO bytecode: OP_PARAM=1 CONST=2 ADD=3 SUB=4 MUL=5 DIV=6 BIND=7 LOCAL=8
var FO_BC_OP: [i64; 4096] = [0; 4096]
var FO_BC_ARG: [i64; 4096] = [0; 4096]
var FO_BC_LEN: i64 = 0
var FO_BC_CONST_BITS: [i64; 256] = [0; 256]
var FO_BC_CONST_N: i64 = 0
var FO_BC_LOC_HASH: [i64; 8] = [0; 8]
var FO_BC_LOC_N: i64 = 0
var FO_EV_SP: i64 = 0
var FO_EV_VAL: [i64; 16] = [-1; 16]
var FO_EV_VAR: [i64; 16] = [-1; 16]
var FO_EV_SENS: [i64; 512] = [-1; 512]
var FO_LOC_VAL: [i64; 8] = [-1; 8]
var FO_LOC_VAR: [i64; 8] = [-1; 8]
var FO_LOC_SENS: [i64; 256] = [-1; 256]
var FO_ARG_VAL: [i64; 4] = [-1; 4]
var FO_ARG_VAR: [i64; 4] = [-1; 4]
var FO_ARG_SENS: [i64; 128] = [-1; 128]
var FO_ARG_N: i64 = 0

fn fo_name_hash(n: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 5381
    var i: i64 = 0
    while i < n.len && i < 64 {
        let b = (n.buf[i as usize] as i64) & 255
        h = h * 33 + b
        i = i + 1
    }
    h + n.len
}

fn fo_xfer_global_reset() with Mut {
    FO_XFER_COUNT = 0
    FO_BC_LEN = 0
    FO_BC_CONST_N = 0
    FO_BC_LOC_N = 0
    var i: i64 = 0
    while i < 64 {
        FO_XFER_KIND[i as usize] = 0
        FO_XFER_LIT[i as usize] = 0.0
        FO_XFER_HASH[i as usize] = 0
        FO_XFER_FWD_HASH[i as usize] = 0
        FO_XFER_BC_OFF[i as usize] = 0
        FO_XFER_BC_LEN[i as usize] = 0
        i = i + 1
    }
}

fn fo_xfer_global_lookup(name: Name) -> i64 with Mut, Panic, Div {
    let h = fo_name_hash(name)
    var i: i64 = 0
    while i < FO_XFER_COUNT {
        if FO_XFER_HASH[i as usize] == h {
            return i
        }
        i = i + 1
    }
    -1
}

fn fo_xfer_global_lookup_hash(h: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FO_XFER_COUNT {
        if FO_XFER_HASH[i as usize] == h {
            return i
        }
        i = i + 1
    }
    -1
}

fn fo_xfer_global_set(name: Name, kind: i64, lit: f64, fwd: Name) with Mut, Panic, Div, IO {
    let existing = fo_xfer_global_lookup(name)
    let h = fo_name_hash(name)
    let fh = fo_name_hash(fwd)
    if existing >= 0 {
        FO_XFER_KIND[existing as usize] = kind
        FO_XFER_LIT[existing as usize] = lit
        FO_XFER_FWD_HASH[existing as usize] = fh
        return
    }
    if FO_XFER_COUNT >= 64 {
        return
    }
    let idx = FO_XFER_COUNT
    FO_XFER_HASH[idx as usize] = h
    FO_XFER_KIND[idx as usize] = kind
    FO_XFER_LIT[idx as usize] = lit
    FO_XFER_FWD_HASH[idx as usize] = fh
    FO_XFER_COUNT = idx + 1
    if lower_live_diag_enabled() {
        print("lower_live: fo_xfer_set name=")
        print(str_from_bytes(name.buf, name.len))
        print(" kind=")
        print_int(kind)
        print(" count=")
        print_int(FO_XFER_COUNT)
        print("\n")
    }
}

fn fo_xfer_global_set_bc(name: Name, off: i64, len: i64) with Mut, Panic, Div, IO {
    let existing = fo_xfer_global_lookup(name)
    let h = fo_name_hash(name)
    if existing >= 0 {
        FO_XFER_KIND[existing as usize] = 6
        FO_XFER_BC_OFF[existing as usize] = off
        FO_XFER_BC_LEN[existing as usize] = len
        return
    }
    if FO_XFER_COUNT >= 64 {
        return
    }
    let idx = FO_XFER_COUNT
    FO_XFER_HASH[idx as usize] = h
    FO_XFER_KIND[idx as usize] = 6
    FO_XFER_BC_OFF[idx as usize] = off
    FO_XFER_BC_LEN[idx as usize] = len
    FO_XFER_COUNT = idx + 1
    if lower_live_diag_enabled() {
        print("lower_live: fo_xfer_set_bc name=")
        print(str_from_bytes(name.buf, name.len))
        print(" len=")
        print_int(len)
        print("\n")
    }
}

fn fo_bc_emit(op: i64, arg: i64) -> bool with Mut {
    if FO_BC_LEN >= 4096 {
        return false
    }
    FO_BC_OP[FO_BC_LEN as usize] = op
    FO_BC_ARG[FO_BC_LEN as usize] = arg
    FO_BC_LEN = FO_BC_LEN + 1
    true
}

fn fo_bc_emit_const(v: f64) -> bool with Mut {
    if FO_BC_CONST_N >= 256 {
        return false
    }
    let ci = FO_BC_CONST_N
    FO_BC_CONST_BITS[ci as usize] = f64_to_bits(v)
    FO_BC_CONST_N = ci + 1
    fo_bc_emit(2, ci)
}

fn fo_bc_find_local(h: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < FO_BC_LOC_N {
        if FO_BC_LOC_HASH[i as usize] == h {
            return i
        }
        i = i + 1
    }
    -1
}

fn fo_bc_add_local(h: i64) -> i64 with Mut {
    let existing = fo_bc_find_local(h)
    if existing >= 0 {
        return existing
    }
    if FO_BC_LOC_N >= 8 {
        return -1
    }
    let idx = FO_BC_LOC_N
    FO_BC_LOC_HASH[idx as usize] = h
    FO_BC_LOC_N = idx + 1
    idx
}

pub struct LowerGlobalTypeTable {
    // Indexed by IrModule.functions slot. Keep this aligned with IR_MAX_FUNCS;
    // source array lengths are literal-only in the bootstrap grammar.
    elem_kinds: [i64; 2048],
}

fn empty_lower_global_type_table() -> LowerGlobalTypeTable {
    LowerGlobalTypeTable {
        elem_kinds: [0; 2048],
    }
}

// Compiler-owned, bounded read index for Contest metadata. This is the first
// replacement for reading the wide IrEpistemicSection through its legacy
// nested aggregate representation.
struct LowerEpistemicContestIndex {
    qualified: bool,
    contest_count: i64,
    span_starts: [i64; 64],
    span_ends: [i64; 64],
}

fn empty_lower_epistemic_contest_index() -> LowerEpistemicContestIndex {
    LowerEpistemicContestIndex {
        qualified: false,
        contest_count: 0,
        span_starts: [-1; 64],
        span_ends: [-1; 64],
    }
}

fn lower_epistemic_contest_index_from_ref(epistemic: &IrEpistemicSection) -> Box<LowerEpistemicContestIndex> with Alloc, Mut, Panic, Div {
    let count = (*epistemic).contest_count
    if count < 0 || count > IR_MAX_EPI_CONTESTS {
        panic("lowerer: invalid frontend epistemic contest_count")
    }
    let index = Box::new(empty_lower_epistemic_contest_index())
    (*index).qualified = true
    (*index).contest_count = count
    var i: i64 = 0
    while i < count {
        (*index).span_starts[i as usize] = (*epistemic).contests[i as usize].span_start
        (*index).span_ends[i as usize] = (*epistemic).contests[i as usize].span_end
        i = i + 1
    }
    index
}

struct Lowerer {
    module: Box<IrModule>,
    epistemic_contests: Box<LowerEpistemicContestIndex>,
    current_fn: i64,
    current_func: Box<IrFunction>,
    current_func_loaded: bool,
    env: Option<Box<IrEnvList>>,
    locals: Box<LowerLocalStack>,
    scope_depth: i64,
    loop_labels: Box<LowerLoopLabels>,
    loop_depth: i64,
    error_count: i64,
    had_error: bool,
    // Phase 3.1: Enum variant discriminants
    enum_variants: Box<EnumVariantTable>,
    // Phase 3.2: Struct field layouts
    struct_layouts: Box<StructLayoutTable>,
    // Frontend-owned global element types. BSS byte size cannot distinguish
    // `[f64; N]` from `[i64; N]`, so this survives summary -> body lowering.
    global_types: Box<LowerGlobalTypeTable>,
    array_elem_float_regs: [i64; 512],
    array_elem_float_reg_count: i64,
    variance_base_regs: [i64; 1024],
    variance_value_regs: [i64; 1024],
    variance_base_reg_count: i64,
    // Sprint 28: Debug-mode witness enforcement
    debug_mode: bool,
    // Sprint 44: probe-mode lowering skips heavyweight epistemic metadata lookup.
    probe_mode: bool,
    // Closures step 2: captured-reg table keyed by synthetic closure fn_id, and a
    // side-channel set by lower_closure_expr_ref and consumed by the let-binding so the
    // bound local knows it is a capturing closure.
    closure_caps: Box<ClosureCapTable>,
    pending_closure_fn_id: i64,
    allow_direct_capturing_closure_literal: bool,
    pending_variance_reg: i64,
    // β-Madaros multi-channel FO GUM (lean_single β¹⁰/β¹¹ parity target).
    // Var(y) = Σ_k (∂y/∂x_k)² · σ²_k with up to 8 Knowledge seeds per function.
    // Enables partial-correlation products ((a*b)*a) and p1−p2 cancel.
    // 32 channels: headroom for multi-seed polys after other live seeds in main.
    fo_nchan: i64,
    fo_sigma2: [i64; 32],
    fo_expr_sens: [i64; 32],
    fo_pending_sens: [i64; 32],
    fo_bind_count: i64,
    fo_bind_names: [Name; 128],
    fo_bind_sens: [i64; 4096],
    // Inter-procedural FO: pure-fn transfer table (survives across function lowers).
    // kind: 0=none 1=id(p0) 2=scale(lit*p0) 3=add(p0+p1) 4=mul(p0*p1) 5=fwd(g)
    fo_xfer_count: i64,
    fo_xfer_names: [Name; 64],
    fo_xfer_kind: [i64; 64],
    fo_xfer_lit: [f64; 64],
    fo_xfer_fwd: [Name; 64],
}

struct IrPreparedCallArgs {
    lo: Lowerer,
    args: Option<Box<IrRegList>>,
    argc: i64,
}

