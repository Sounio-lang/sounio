fn lower_program_to_ir_ordered_boxed_trace_ref(
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_live_diag_enabled() { print("lower_live: ordered_entry\n") }
    let lo = lowerer_new()
    if lower_live_diag_enabled() { print("lower_live: ordered_after_new\n") }
    var lo2 = lo.lower_program_items_ref(&prog.items)
    if lower_live_diag_enabled() { print("lower_live: ordered_after_items\n") }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        (*patch_stats) = ir_patch_validated_calls(&! lo2.module)
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: (*patch_stats),
    }
}

fn lower_program_to_ir_ordered_boxed_trace(
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_live_diag_enabled() { print("lower_live: ordered_entry\n") }
    var lo = lowerer_new()
    if lower_live_diag_enabled() { print("lower_live: ordered_after_new\n") }
    lowerer_lower_program_items_mut(&! lo, prog.items)
    if lower_live_diag_enabled() { print("lower_live: ordered_after_items\n") }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if !lo.had_error {
        (*patch_stats) = ir_patch_validated_calls(&! lo.module)
    }
    IrLowerBoxResult {
        module: lo.module,
        error_count: lo.error_count,
        had_error: lo.had_error,
        patch_stats: (*patch_stats),
    }
}

pub fn lower_program_to_ir_ordered_with_epistemic_boxed_trace_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_entry\n")
    }
    let lo = lowerer_new_with_epistemic(&epistemic)
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_after_new\n")
    }
    if lower_ordered_diag_enabled() {
        print("lower_ordered_core: enter\n")
    }
    var lo2 = lo.lower_program_items_ref(&prog.items)
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_after_items\n")
    }
    if lower_ordered_diag_enabled() {
        print("lower_ordered_core: after_items\n")
    }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        (*patch_stats) = ir_patch_validated_calls(&! lo2.module)
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: (*patch_stats),
    }
}

pub fn lower_program_to_ir_with_epistemic_trace(
    prog: Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_with_epistemic_trace_ref(&prog, epistemic, patch_stats)
}

fn lower_program_to_ir_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    var patch_stats = ir_empty_validated_patch_stats()
    lower_program_to_ir_with_epistemic_trace_ref(prog, epistemic, &! patch_stats)
}

fn lower_program_to_ir_with_epistemic(prog: Program, epistemic: IrEpistemicSection) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_with_epistemic_ref(&prog, epistemic)
}
