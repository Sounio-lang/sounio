        }
    }

    fn lower_contest_disagreement_witness(self, contest_id: i64, contest_info: IrContestInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let mechanistic = self.contest_mechanistic_report(contest_info)
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let contest_pair = lo.emit_i64_const(contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let family_pair = lo.emit_i64_const(contest_info.family_id)
        lo = family_pair.0
        lo = lo.emit_named_field(dst, make_name("family_id"), family_pair.1)

        let family_name_pair = lo.emit_name_string(lo.epistemic_family_name(contest_info.family_id))
        lo = family_name_pair.0
        lo = lo.emit_named_field(dst, make_name("family_name"), family_name_pair.1)

        let policy_pair = lo.emit_i64_const(contest_info.policy_id)
        lo = policy_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_id"), policy_pair.1)

        let policy_name_pair = lo.emit_name_string(lo.epistemic_policy_name(contest_info.policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let sign_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 0))
        lo = sign_pair.0
        lo = lo.emit_named_field(dst, make_name("sign_consensus"), sign_pair.1)

        let band_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 1))
        lo = band_pair.0
        lo = lo.emit_named_field(dst, make_name("relative_band"), band_pair.1)

        let tail_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 2))
        lo = tail_pair.0
        lo = lo.emit_named_field(dst, make_name("max_tail_risk"), tail_pair.1)

        let ident_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 4))
        lo = ident_pair.0
        lo = lo.emit_named_field(dst, make_name("identifiability_floor"), ident_pair.1)

        let agg_pair = lo.emit_f64_const(mechanistic.aggregate_divergence)
        lo = agg_pair.0
        lo = lo.emit_named_field(dst, make_name("mechanistic_divergence"), agg_pair.1)

        let latent_pair = lo.emit_f64_const(mechanistic.latent_state_divergence)
        lo = latent_pair.0
        lo = lo.emit_named_field(dst, make_name("latent_state_divergence"), latent_pair.1)

        let causal_pair = lo.emit_f64_const(mechanistic.causal_decomposition_divergence)
        lo = causal_pair.0
        lo = lo.emit_named_field(dst, make_name("causal_decomposition_divergence"), causal_pair.1)

        let inter_pair = lo.emit_f64_const(mechanistic.intervention_response_divergence)
        lo = inter_pair.0
        lo = lo.emit_named_field(dst, make_name("intervention_response_divergence"), inter_pair.1)

        let param_pair = lo.emit_f64_const(mechanistic.parameter_role_divergence)
        lo = param_pair.0
        lo = lo.emit_named_field(dst, make_name("parameter_role_divergence"), param_pair.1)

        let struct_pair = lo.emit_f64_const(mechanistic.structural_explanation_distance)
        lo = struct_pair.0
        lo = lo.emit_named_field(dst, make_name("structural_explanation_distance"), struct_pair.1)

        let counter_pair = lo.emit_i64_const(contest_info.counterexample_id)
        lo = counter_pair.0
        lo = lo.emit_named_field(dst, make_name("counterexample_id"), counter_pair.1)

        let weights_pair = lo.emit_i64_const(contest_info.posterior_weights_id)
        lo = weights_pair.0
        lo = lo.emit_named_field(dst, make_name("posterior_weights_id"), weights_pair.1)

        (lo, dst)
    }

    fn lower_contest_counterexample_witness(self, info: IrCounterexampleInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let model_pair = lo.emit_name_string(info.model_name)
        lo = model_pair.0
        lo = lo.emit_named_field(dst, make_name("model_name"), model_pair.1)

        let subgroup_pair = lo.emit_name_string(info.subgroup_name)
        lo = subgroup_pair.0
        lo = lo.emit_named_field(dst, make_name("subgroup_name"), subgroup_pair.1)

        let metric_pair = lo.emit_name_string(info.metric_name)
        lo = metric_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_name"), metric_pair.1)

        let observed_pair = lo.emit_f64_const(info.observed_value)
        lo = observed_pair.0
        lo = lo.emit_named_field(dst, make_name("observed_value"), observed_pair.1)

        let threshold_pair = lo.emit_f64_const(info.threshold_value)
        lo = threshold_pair.0
        lo = lo.emit_named_field(dst, make_name("threshold_value"), threshold_pair.1)

        let summary_pair = lo.emit_name_string(info.summary)
        lo = summary_pair.0
        lo = lo.emit_named_field(dst, make_name("summary"), summary_pair.1)

        (lo, dst)
    }

    fn lower_contest_weights_witness(self, info: IrPosteriorWeightsInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let count_pair = lo.emit_i64_const(info.count)
        lo = count_pair.0
        lo = lo.emit_named_field(dst, make_name("count"), count_pair.1)

        let names_pair = lo.lower_name_array_literal(info.model_names, info.count)
        lo = names_pair.0
        lo = lo.emit_named_field(dst, make_name("model_names"), names_pair.1)

        let weights_pair = lo.lower_f64_array_literal(info.weights, info.count)
        lo = weights_pair.0
        lo = lo.emit_named_field(dst, make_name("weights"), weights_pair.1)

        (lo, dst)
    }

    fn lower_contest_witness_call(self, span: Span, callee_name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_contest_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.contest_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.contest_witnesses[witness_id as usize]
        let contest_id = witness_info.contest_id
        if contest_id < 0 || contest_id >= self.module.epistemic.contest_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let contest_info = self.module.epistemic.contests[contest_id as usize]
        let witness_kind = if witness_info.witness_kind >= 0 { witness_info.witness_kind } else { self.contest_witness_kind_from_callee(callee_name) }
        if witness_kind == 0 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 0))
        }
        if witness_kind == 1 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 1))
        }
        if witness_kind == 2 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 2))
        }
        if witness_kind == 3 {
            return self.emit_f64_const(self.contest_mechanistic_report(contest_info).aggregate_divergence)
        }
        if witness_kind == 4 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 4))
        }
        if witness_kind == 5 {
            return self.lower_contest_disagreement_witness(contest_id, contest_info)
        }
        if witness_kind == 6 {
            return self.lower_contest_counterexample_witness(self.contest_counterexample(contest_info))
        }
        if witness_kind == 7 {
            return self.lower_contest_weights_witness(self.contest_posterior_weights(contest_info))
        }
        let loe = self.report_error()
        loe.emit_unit()
    }

    fn lower_deferral_reason_witness(self, info: IrDeferredCertificateInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_deferral_policy_name(info.deferral_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let route_name_pair = lo.emit_name_string(lo.epistemic_deferral_policy_route_name(info.deferral_policy_id))
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let evidence_kind_pair = lo.emit_i64_const(info.evidence_kind)
        lo = evidence_kind_pair.0
        lo = lo.emit_named_field(dst, make_name("evidence_kind"), evidence_kind_pair.1)

        let reason_code_pair = lo.emit_i64_const(info.reason_code)
        lo = reason_code_pair.0
        lo = lo.emit_named_field(dst, make_name("reason_code"), reason_code_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        (lo, dst)
    }

    fn report_error(self) -> Lowerer with Mut {
        var lo = self
        lo.error_count = lo.error_count + 1
        lo.had_error = true
        lo
    }

    fn report_fatal_lowering_error(self) -> Lowerer with Mut {
        var lo = self.report_error()
        lo.module = Box::new(ir_empty_module())
        lo.current_fn = IR_INVALID_FN
        lo.current_func_loaded = false
        lo
    }

    fn enter_scope(self) -> Lowerer with Mut {
        var lo = self
        lo.scope_depth = lo.scope_depth + 1
        lo
    }

    fn exit_scope(self) -> Lowerer with Mut {
        var lo = self
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo
    }

    fn bind_local(self, name: Name, reg: i64, is_mut: bool) -> Lowerer with Mut, Alloc, Panic {
        var lo = self
        let _is_mut = is_mut
        var stk = *lo.locals
            if stk.count < 4096 {
                let idx = stk.count
                stk.names[idx as usize] = name
                stk.regs[idx as usize] = reg
                stk.depths[idx as usize] = lo.scope_depth
                stk.struct_types[idx as usize] = ir_empty_name()
                stk.array_elem_float[idx as usize] = 0
                stk.array_lens[idx as usize] = -1
                stk.array_copy_word_scalar[idx as usize] = 0
                stk.wide_bits[idx as usize] = 0
                stk.wide_signed[idx as usize] = 0
                stk.is_ref[idx as usize] = 0
                // Explicit 0: slot may be reused after scope-pop restores count.
                // Callers that know a positive kind (for-IV int, float local) re-bind.
                stk.scalar_kind[idx as usize] = 0
                stk.variance_regs[idx as usize] = -1
                stk.count = idx + 1
            lo.locals = Box::new(stk)
        } else {
            lo = lo.report_error()
        }
        lo
    }

    fn bind_local_array_elem_float(self, name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.array_elem_float[i as usize] = 1
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn bind_local_fixed_array_len(self, name: Name, array_len: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.array_lens[i as usize] = array_len
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn bind_local_array_copy_word_scalar(self, name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.array_copy_word_scalar[i as usize] = 1
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
