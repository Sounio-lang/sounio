    let lo = lowerer_new_probe()
    let lo2 = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

fn lower_program_to_ir_probe_summary_box_ref(prog: &Program) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let summary = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(prog, ir_empty_epistemic_section())
    IrLowerBoxResult {
        module: Box::new(summary.summary.module),
        error_count: summary.error_count,
        had_error: summary.had_error,
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

pub fn lower_program_to_ir_probe_summary(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_probe_summary_ref(&prog)
}

fn lower_program_function_body_from_summary_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummary,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary(summary, &epistemic)
    var lo2 = lo.lower_program_bodies_filtered_ref(&prog.items, fn_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        patch_stats = ir_patch_validated_calls(&! lo2.module)
    }

    var func = ir_empty_function()
    var i: i64 = 0
    while i < lo2.module.fn_count {
        if ir_name_eq(lo2.module.functions[i as usize].name, fn_name) {
            func = lo2.module.functions[i as usize]
            i = lo2.module.fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: patch_stats,
    }
}

fn lower_program_function_body_from_summary_flat_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummaryFlat,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let lowered = lower_program_bodies_from_summary_flat_with_epistemic_ref(prog, summary, epistemic)

    var func = ir_empty_function()
    var i: i64 = 0
    while i < (*lowered.module).fn_count {
        if ir_name_eq((*lowered.module).functions[i as usize].name, fn_name) {
            func = (*lowered.module).functions[i as usize]
            i = (*lowered.module).fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lowered.error_count,
        had_error: lowered.had_error,
        patch_stats: lowered.patch_stats,
    }
}

fn lower_program_function_body_from_program_with_epistemic_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(prog, epistemic)
    let lo = lowerer_new_from_program_summary_flat(&summary_result.summary, epistemic)
    var lo2 = lo
    lo2 = lo2.lower_program_bodies_filtered_ref(&prog.items, fn_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        patch_stats = ir_patch_validated_calls(&! lo2.module)
    }

    var func = ir_empty_function()
    var i: i64 = 0
    while i < lo2.module.fn_count {
        if ir_name_eq(lo2.module.functions[i as usize].name, fn_name) {
            func = lo2.module.functions[i as usize]
            i = lo2.module.fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: patch_stats,
    }
}

fn lower_program_bodies_from_summary_with_epistemic_boxed_ref(
    prog: &Program,
    summary: &IrProgramSummary,
    epistemic: &IrEpistemicSection
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary(summary, epistemic)
    var lo2 = lo.lower_program_bodies_ref(&prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        var module_box = lo2.module
        patch_stats = ir_patch_validated_calls(&! (*module_box))
        lo2.module = module_box
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: patch_stats,
    }
}

fn lower_program_bodies_from_summary_flat_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummaryFlat,
    epistemic: IrEpistemicSection
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary_flat(summary, epistemic)
    var lo2 = lo.lower_program_bodies_ref(&prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: patch_stats,
    }
}

pub fn lower_program_function_body_from_summary_with_epistemic(
    prog: Program,
    summary: IrProgramSummary,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
