    fn lookup_local_variance_reg(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*(*self.locals).depths).values[i as usize] <= self.scope_depth && ir_name_eq((*(*self.locals).names).values[i as usize], name) {
                return (*(*self.locals).variance_regs).values[i as usize]
            }
            i = i - 1
        }
        -1
    }

    // ---- loop-carried uncertainty slots (#1535) ----
    //
    // A mutable local's VALUE lives in a fixed vreg and assignment copies into it
    // (`ir_copy(dst, rhs)` in lower_assign_stmt_ref), so it survives a loop
    // back-edge. Its variance and its per-channel sensitivities did not: assignment
    // REBOUND them to the RHS's fresh vregs. A rebind is a compile-time map update,
    // and a loop body's IR is emitted exactly once, so every iteration recomputed
    // uncertainty from the pre-loop value and only the last one survived.
    //
    // Measured before this: a 20-step Euler accumulator `x = x + 0.1 * cl` reported
    // var(x) = 0.015376 — one step's contribution — against a GUM truth of 6.1504.
    //
    // These helpers give a mutable local a FIXED variance vreg and fixed per-channel
    // sens vregs, zero-initialised at the declaration, so assignment can copy into
    // them exactly as the value does.

    // Give the local a PRIVATE variance vreg.
    //
    // Not a no-op when a variance reg is already bound: the declaration path binds
    // the RHS's own vreg (`var x = 6.0 / v`), which may be a shared constant or an
    // expression temporary. Copying into that reg on a later assignment would write
    // through an alias. So the existing value is copied into a fresh reg and the
    // local rebound to it; otherwise the slot starts at zero.
    //
    // Missing this is what left rapamycin_iso_budget at var(blood)=0.000000 while a
    // repro with `var a = 1.2` came out right: only the literal-initialised form had
    // no prior binding to alias.
    fn alloc_variance_slot_for_local(self, name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let existing = lo.lookup_local_variance_reg(name)
        let z = lo.emit_zero_variance()
        lo = z.0
        let slot = z.1
        if existing >= 0 {
            lo = lo.emit(ir_copy(slot, existing))
        }
        lo.bind_local_variance_reg(name, slot)
    }

    // Row index of `name` in the FO bind table, creating an all-unbound row if
    // absent. -1 when the table is full (128 locals), in which case callers fall
    // back to the pre-existing rebind behaviour rather than dropping the sens.
    fn fo_bind_row_for(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var lo = self
        var i: i64 = 0
        while i < lo.fo_bind_count {
            if ir_name_eq((*lo.fo_bind).names[i as usize], name) {
                return (lo, i)
            }
            i = i + 1
        }
        if lo.fo_bind_count >= 128 {
            return (lo, 0 - 1)
        }
        let idx = lo.fo_bind_count
        var fb0 = lo.fo_bind
        (*fb0).names[idx as usize] = name
        var c: i64 = 0
        while c < 32 {
            (*fb0).sens[(idx * 32 + c) as usize] = 0 - 1
            c = c + 1
        }
        lo.fo_bind = fb0
        lo.fo_bind_count = idx + 1
        (lo, idx)
    }

    // Zero-initialised sens slots for the channels that exist at this point.
    // Bounded by fo_nchan rather than 32: channels are seeded by measure(), which
    // in practice precedes the locals that accumulate through them, and allocating
    // all 32 would cost register pressure in every program that touches f64.
    fn fo_alloc_sens_slots_for_local(self, name: Name) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        if lo.fo_nchan <= 0 {
            return lo
        }
        let row_pair = lo.fo_bind_row_for(name)
        lo = row_pair.0
        let row = row_pair.1
        if row < 0 {
            return lo
        }
        var k: i64 = 0
        while k < lo.fo_nchan && k < 32 {
            // Same aliasing rule as alloc_variance_slot_for_local: a channel already
            // bound points at the RHS's vreg, so copy its value into a private reg
            // rather than reusing it as this local's slot.
            let existing = (*lo.fo_bind).sens[(row * 32 + k) as usize]
            let z = lo.emit_f64_const(0.0)
            lo = z.0
            if existing >= 0 {
                lo = lo.emit(ir_copy(z.1, existing))
            }
            var fb1 = lo.fo_bind
            (*fb1).sens[(row * 32 + k) as usize] = z.1
            lo.fo_bind = fb1
            k = k + 1
        }
        lo
    }

    // Assignment-side counterpart of fo_bind_local_sens: COPY the expression's sens
    // into the local's fixed slots instead of rebinding to the expression's vregs.
    // A channel the new value no longer depends on is zeroed rather than left
    // holding a stale sensitivity. Returns false when no slot exists, so the caller
    // can fall back to the old rebind path.
    fn fo_copy_expr_sens_into_local(self, name: Name) -> (Lowerer, bool) with Mut, Panic, Div, IO {
        var lo = self
        var row: i64 = 0 - 1
        var i: i64 = 0
        while i < lo.fo_bind_count {
            if ir_name_eq((*lo.fo_bind).names[i as usize], name) {
                row = i
                i = lo.fo_bind_count
            } else {
                i = i + 1
            }
        }
        if row < 0 {
            return (lo, false)
        }
        var any: bool = false
        var k: i64 = 0
        while k < 32 {
            let slot = (*lo.fo_bind).sens[(row * 32 + k) as usize]
            if slot >= 0 {
                any = true
                let src = lo.fo_expr_sens[k as usize]
                if src >= 0 {
                    if src != slot {
                        lo = lo.emit(ir_copy(slot, src))
                    }
                } else {
                    let z = lo.emit_f64_const(0.0)
                    lo = z.0
                    lo = lo.emit(ir_copy(slot, z.1))
                }
            }
            k = k + 1
        }
        (lo, any)
    }

    fn bind_variance_for_base_reg(self, base_reg: i64, variance_reg: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if base_reg < 0 || variance_reg < 0 {
            return lo
        }
        var i: i64 = 0
        while i < lo.variance_base_reg_count {
            if lo.variance_base_regs[i as usize] == base_reg {
                lo.variance_value_regs[i as usize] = variance_reg
                return lo
            }
            i = i + 1
        }
        if lo.variance_base_reg_count < 1024 {
            let idx = lo.variance_base_reg_count
            lo.variance_base_regs[idx as usize] = base_reg
            lo.variance_value_regs[idx as usize] = variance_reg
            lo.variance_base_reg_count = idx + 1
        }
        // #1706 NOTE: past this wall a variance binding is silently DROPPED and the
        // later lookup returns -1, which variance_of turns into a 0.0 -- the exact
        // shape of defect that let a whole test family read green. Field slots (two
        // keys per struct field) raise the pressure here.
        //
        // A diagnostic print belongs here, but this helper is declared
        // `with Mut, Panic, Div` while print/lower_live_diag_enabled need IO, and
        // widening the effect signature of a helper this widely called broke the
        // self-compile ratchet with 2x error[E035]. Documented rather than fixed by
        // effect-widening; no program is known to reach the wall.
        lo
    }

    // #1706 defect 1: variance was tracked per LOCAL NAME and per BASE REG only, so
    // `variance_of(a.x)` on `let a = A { x: k.value }` read 0.0 -- a zero that means
    // "not tracked" is indistinguishable from a true zero, which is how an entire
    // test family stayed green (see tests/vacuous_expect_baseline.txt).
    //
    // Rather than add another pair of [i64; 1024] arrays to Lowerer -- which is
    // passed BY VALUE, so every field costs a copy on each of the thousands of
    // threadings per function -- a field slot reuses the existing base-reg table by
    // encoding (base_reg, field_idx) into one key. NC_MAX_VREGS is 2048
    // (native/frame.sio), and the encoding leaves the whole non-negative reg range
    // untouched: real base regs stay < 2^20, so no encoded key can ever collide with
    // a plain reg key.
    fn variance_field_key(self, base_reg: i64, field_idx: i64) -> i64 with Div {
        if base_reg < 0 || field_idx < 0 || base_reg >= 1048576 || field_idx >= 1024 {
            return -1
        }
        1048576 + base_reg * 1024 + field_idx
    }

    fn bind_variance_for_field(self, base_reg: i64, field_idx: i64, variance_reg: i64) -> Lowerer with Mut, Panic, Div {
        let key = self.variance_field_key(base_reg, field_idx)
        if key < 0 {
            return self
        }
        self.bind_variance_for_base_reg(key, variance_reg)
    }

    fn lookup_variance_for_field(self, base_reg: i64, field_idx: i64) -> i64 with Mut, Panic, Div {
        let key = self.variance_field_key(base_reg, field_idx)
        if key < 0 {
            return -1
        }
        self.lookup_variance_for_base_reg(key)
    }

    // The reg holding a STRUCT-valued field, so a chain can hop: for `c.a.x`, the
    // `.a` step needs the inner aggregate's base reg to then look up `.x` on it.
    // Second key band, disjoint from both plain regs and the field-variance band.
    fn variance_field_base_key(self, base_reg: i64, field_idx: i64) -> i64 with Div {
        if base_reg < 0 || field_idx < 0 || base_reg >= 1048576 || field_idx >= 1024 {
            return -1
        }
        1073741824 + base_reg * 1024 + field_idx
    }

    fn bind_variance_for_field_base(self, base_reg: i64, field_idx: i64, inner_reg: i64) -> Lowerer with Mut, Panic, Div {
        let key = self.variance_field_base_key(base_reg, field_idx)
        if key < 0 {
            return self
        }
        self.bind_variance_for_base_reg(key, inner_reg)
    }

    fn lookup_variance_for_field_base(self, base_reg: i64, field_idx: i64) -> i64 with Mut, Panic, Div {
        let key = self.variance_field_base_key(base_reg, field_idx)
        if key < 0 {
            return -1
        }
        self.lookup_variance_for_base_reg(key)
    }

    fn lookup_variance_for_base_reg(self, base_reg: i64) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.variance_base_reg_count {
            if self.variance_base_regs[i as usize] == base_reg {
                return self.variance_value_regs[i as usize]
            }
            i = i + 1
        }
        -1
    }

    fn emit_zero_variance(self) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        self.emit_f64_const(0.0)
    }

    fn name_is_variance_of(self, n: Name) -> bool with Div {
        n.len == 11
        && n.buf[0] == 118 as i8 && n.buf[1] == 97 as i8
        && n.buf[2] == 114 as i8 && n.buf[3] == 105 as i8
        && n.buf[4] == 97 as i8 && n.buf[5] == 110 as i8
        && n.buf[6] == 99 as i8 && n.buf[7] == 101 as i8
        && n.buf[8] == 95 as i8 && n.buf[9] == 111 as i8
        && n.buf[10] == 102 as i8
    }

    fn name_is_sensitivity_of(self, n: Name) -> bool with Div {
        n.len == 14
        && n.buf[0] == 115 as i8 && n.buf[1] == 101 as i8
        && n.buf[2] == 110 as i8 && n.buf[3] == 115 as i8
        && n.buf[4] == 105 as i8 && n.buf[5] == 116 as i8
        && n.buf[6] == 105 as i8 && n.buf[7] == 118 as i8
        && n.buf[8] == 105 as i8 && n.buf[9] == 116 as i8
        && n.buf[10] == 121 as i8 && n.buf[11] == 95 as i8
        && n.buf[12] == 111 as i8 && n.buf[13] == 102 as i8
    }

    fn name_is_hessian_of(self, n: Name) -> bool with Div {
        n.len == 10
        && n.buf[0] == 104 as i8 && n.buf[1] == 101 as i8
        && n.buf[2] == 115 as i8 && n.buf[3] == 115 as i8
        && n.buf[4] == 105 as i8 && n.buf[5] == 97 as i8
        && n.buf[6] == 110 as i8 && n.buf[7] == 95 as i8
        && n.buf[8] == 111 as i8 && n.buf[9] == 102 as i8
    }

    // second_order_mean(expr) -> E2[f] = f(mu) + (1/2) * sum_k H_kk * sigma2_k
    // correlate(a, b, rho) -- record Cov between the channels a and b carry.
    fn name_is_correlate(self, n: Name) -> bool with Div {
        n.len == 9
        && n.buf[0] == 99 as i8 && n.buf[1] == 111 as i8
        && n.buf[2] == 114 as i8 && n.buf[3] == 114 as i8
        && n.buf[4] == 101 as i8 && n.buf[5] == 108 as i8
        && n.buf[6] == 97 as i8 && n.buf[7] == 116 as i8
        && n.buf[8] == 101 as i8
    }

    // The one live channel of the expression just walked, or -1.
    //
    // Ambiguity is refused, not guessed: `correlate(x + y, z, 0.5)` names two
    // channels on the left and there is no honest answer for which one the
    // correlation belongs to.
    fn fo_primary_channel(self) -> i64 with Div {
        var found: i64 = 0 - 1
        var k: i64 = 0
        while k < 8 {
            if self.fo_expr_sens[k as usize] >= 0 {
                if found >= 0 {
                    return 0 - 1
                }
                found = k
            }
            k = k + 1
        }
        found
    }

    // sigma_k = sqrt(sigma2_k). The table stores the variance; every covariance
    // term needs the standard deviation, so this is emitted per use.
    // sigma_k, recorded at measure() time -- not sqrt(fo_sigma2[k]).
    //
    // A five-cell matrix says why. The seed register holds the right value and
    // multiplies correctly in a direct ir_binop_typed -- that cell returns
    // sigma2 exactly. It reads as 1.0 through ir_copy, as 1.0 through a call
    // argument, and as 1.0 through a call argument even after
    // ir_mark_float_reg on the seed itself. Three independent paths lose it.
    // Same family as the println scalar-kind loss: the value survives, the
    // float marking does not, and what comes back is plausible and wrong.
    fn name_is_second_order_mean(self, n: Name) -> bool with Div {
        n.len == 17
        && n.buf[0] == 115 as i8 && n.buf[1] == 101 as i8
        && n.buf[2] == 99 as i8 && n.buf[3] == 111 as i8
        && n.buf[4] == 110 as i8 && n.buf[5] == 100 as i8
        && n.buf[6] == 95 as i8 && n.buf[7] == 111 as i8
        && n.buf[8] == 114 as i8 && n.buf[9] == 100 as i8
        && n.buf[10] == 101 as i8 && n.buf[11] == 114 as i8
        && n.buf[12] == 95 as i8 && n.buf[13] == 109 as i8
        && n.buf[14] == 101 as i8 && n.buf[15] == 97 as i8
        && n.buf[16] == 110 as i8
    }

    fn name_is_uncertainty_of(self, n: Name) -> bool with Div {
        n.len == 14
        && n.buf[0] == 117 as i8 && n.buf[1] == 110 as i8
        && n.buf[2] == 99 as i8 && n.buf[3] == 101 as i8
        && n.buf[4] == 114 as i8 && n.buf[5] == 116 as i8
        && n.buf[6] == 97 as i8 && n.buf[7] == 105 as i8
        && n.buf[8] == 110 as i8 && n.buf[9] == 116 as i8
        && n.buf[10] == 121 as i8 && n.buf[11] == 95 as i8
        && n.buf[12] == 111 as i8 && n.buf[13] == 102 as i8
    }

    fn lower_measure_value_arg_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => self.lower_expr_ref(&(*list).head),
            None => self.emit_unit(),
        }
    }

    fn lower_measure_uncertainty_arg_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                match (*list).tail {
                    Some(rest) => self.lower_expr_ref(&(*rest).head),
                    None => self.emit_unit(),
                }
            }
            None => self.emit_unit(),
        }
    }

    // ─── Multi-channel FO GUM helpers (β-Madaros) ───────────────────────────

    // Upper-triangle index for an 8-channel Hessian, j <= k. Same formula the
    // test corpus already uses as hess_tri_idx_8, so a slot here and an index
    // there name the same entry.
    fn so_hess_idx(self, j: i64, k: i64) -> i64 with Mut, Div {
        var r = j
        var c = k
        if r > c { r = k; c = j }
        8 * r - (r * (r - 1)) / 2 + (c - r)
    }

    fn so_clear_expr_hess(self) -> Lowerer with Mut {
        var lo = self
        var i: i64 = 0
        while i < 36 {
            lo.so_expr_hess[i as usize] = 0 - 1
            i = i + 1
        }
        lo
    }

    fn so_snapshot_expr_hess(self) -> [i64; 36] with Mut {
        var snap: [i64; 36] = [-1; 36]
        var i: i64 = 0
        while i < 36 {
            snap[i as usize] = self.so_expr_hess[i as usize]
            i = i + 1
        }
        snap
    }

    // H(x +- y)_jk = Hx_jk +- Hy_jk. A -1 operand is a structural zero, so the
    // other side passes through untouched and no register is spent.
    fn so_combine_hess_addsub(self, hL: [i64; 36], hR: [i64; 36], is_sub: bool) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self.so_clear_expr_hess()
        var i: i64 = 0
        while i < 36 {
            let a = hL[i as usize]
            let b = hR[i as usize]
            if a >= 0 && b >= 0 {
                let d = lo.fresh_reg()
                lo = d.0
                let op = if is_sub { BinaryOp::OpSub } else { BinaryOp::OpAdd }
                lo = lo.emit(ir_binop_typed(d.1, a, op, b, true, true))
                lo = lo.emit(ir_mark_float_reg(d.1))
                lo.so_expr_hess[i as usize] = d.1
            } else if a >= 0 {
                lo.so_expr_hess[i as usize] = a
            } else if b >= 0 {
                if is_sub {
                    let z = lo.emit_f64_const(0.0)
                    lo = z.0
                    lo = lo.emit(ir_mark_float_reg(z.1))
                    let d = lo.fresh_reg()
                    lo = d.0
                    lo = lo.emit(ir_binop_typed(d.1, z.1, BinaryOp::OpSub, b, true, true))
                    lo = lo.emit(ir_mark_float_reg(d.1))
                    lo.so_expr_hess[i as usize] = d.1
                } else {
                    lo.so_expr_hess[i as usize] = b
                }
            }
            i = i + 1
        }
        lo
    }

    fn so_mul_or_none(self, a: i64, b: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if a < 0 || b < 0 {
            return (lo, 0 - 1)
        }
        let d = lo.fresh_reg()
        lo = d.0
        lo = lo.emit(ir_binop_typed(d.1, a, BinaryOp::OpMul, b, true, true))
        lo = lo.emit(ir_mark_float_reg(d.1))
        (lo, d.1)
    }

    fn so_add_or_take(self, acc: i64, x: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if x < 0 {
            return (lo, acc)
        }
        if acc < 0 {
            return (lo, x)
        }
        let d = lo.fresh_reg()
        lo = d.0
        lo = lo.emit(ir_binop_typed(d.1, acc, BinaryOp::OpAdd, x, true, true))
        lo = lo.emit(ir_mark_float_reg(d.1))
        (lo, d.1)
    }

    fn so_sub_or_take(self, acc: i64, x: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if x < 0 {
            return (lo, acc)
        }
        if acc < 0 {
            // 0 - x: the IR has no unary negation, so an absent accumulator
            // still has to emit a subtraction from a materialised zero.
            let zp = lo.emit_f64_const(0.0)
            lo = zp.0
            let d = lo.fresh_reg()
            lo = d.0
            lo = lo.emit(ir_binop_typed(d.1, zp.1, BinaryOp::OpSub, x, true, true))
            lo = lo.emit(ir_mark_float_reg(d.1))
            return (lo, d.1)
        }
        let d = lo.fresh_reg()
        lo = d.0
        lo = lo.emit(ir_binop_typed(d.1, acc, BinaryOp::OpSub, x, true, true))
        lo = lo.emit(ir_mark_float_reg(d.1))
        (lo, d.1)
    }

    fn so_div_or_none(self, a: i64, b: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if a < 0 || b < 0 {
            return (lo, 0 - 1)
        }
        let d = lo.fresh_reg()
        lo = d.0
        lo = lo.emit(ir_binop_typed(d.1, a, BinaryOp::OpDiv, b, true, true))
        lo = lo.emit(ir_mark_float_reg(d.1))
        (lo, d.1)
    }

    // H(a/b)_jk = a_jk/b - (a_j*b_k + a_k*b_j)/b^2 - a*b_jk/b^2 + 2*a*b_j*b_k/b^3.
    //
    // The quotient is not the product rule wearing a reciprocal. The last term
    // is cubic in b and has no counterpart in H(x*y); dropping it leaves a
    // number that is right only where b_j*b_k vanishes -- that is, everywhere
    // except the channels that made the denominator uncertain to begin with.
    // hessian_of(a/b, kb, kb) is therefore the pin for this rule, not the
    // mixed partial: the mixed one survives a two-term approximation.
    fn so_combine_hess_div(self, hL: [i64; 36], hR: [i64; 36], sL: [i64; 32], sR: [i64; 32], lhs_v: i64, rhs_v: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self.so_clear_expr_hess()
        // Declared sabotage: revert to the pre-#2144 clear.
        if sab_quotient_hessian() {
            return lo
        }
        if lhs_v < 0 || rhs_v < 0 {
            return lo
        }
        // b^2, b^3 and the constant 2.0, hoisted out of the channel loop.
        let bb_p = lo.fresh_reg()
        lo = bb_p.0
        let bb = bb_p.1
        lo = lo.emit(ir_binop_typed(bb, rhs_v, BinaryOp::OpMul, rhs_v, true, true))
        lo = lo.emit(ir_mark_float_reg(bb))
        let bbb_p = lo.fresh_reg()
        lo = bbb_p.0
        let bbb = bbb_p.1
        lo = lo.emit(ir_binop_typed(bbb, bb, BinaryOp::OpMul, rhs_v, true, true))
        lo = lo.emit(ir_mark_float_reg(bbb))
        let two_p = lo.emit_f64_const(2.0)
        lo = two_p.0
        let two = two_p.1

        var nch = lo.fo_nchan
        if nch > 8 { nch = 8 }
        var j: i64 = 0
        while j < nch {
            var k: i64 = j
            while k < nch {
                let idx = lo.so_hess_idx(j, k)
                var acc: i64 = 0 - 1

                // + a_jk / b
                let t1 = lo.so_div_or_none(hL[idx as usize], rhs_v)
                lo = t1.0
                let a1 = lo.so_add_or_take(acc, t1.1)
                lo = a1.0
                acc = a1.1

                // - (a_j*b_k + a_k*b_j) / b^2
                let c1 = lo.so_mul_or_none(sL[j as usize], sR[k as usize])
                lo = c1.0
                let c2 = lo.so_mul_or_none(sL[k as usize], sR[j as usize])
                lo = c2.0
                let cs = lo.so_add_or_take(c1.1, c2.1)
                lo = cs.0
                let t2 = lo.so_div_or_none(cs.1, bb)
                lo = t2.0
                let a2 = lo.so_sub_or_take(acc, t2.1)
                lo = a2.0
                acc = a2.1

                // - a*b_jk / b^2
                let m3 = lo.so_mul_or_none(lhs_v, hR[idx as usize])
                lo = m3.0
                let t3 = lo.so_div_or_none(m3.1, bb)
                lo = t3.0
                let a3 = lo.so_sub_or_take(acc, t3.1)
                lo = a3.0
                acc = a3.1

                // + 2*a*b_j*b_k / b^3
                let p1 = lo.so_mul_or_none(sR[j as usize], sR[k as usize])
                lo = p1.0
                let p2 = lo.so_mul_or_none(p1.1, lhs_v)
                lo = p2.0
                let p3 = lo.so_mul_or_none(p2.1, two)
                lo = p3.0
                let t4 = lo.so_div_or_none(p3.1, bbb)
                lo = t4.0
                let a4 = lo.so_add_or_take(acc, t4.1)
                lo = a4.0
                acc = a4.1

                lo.so_expr_hess[idx as usize] = acc
                k = k + 1
            }
            j = j + 1
        }
        lo
    }

    // H(x*y)_jk = Hx_jk*y + x*Hy_jk + Sx_j*Sy_k + Sx_k*Sy_j.
    //
    // The last two terms are why this cannot be derived from the gradient
    // alone: for r = c*c*k they are what makes the mixed partial H_ck = 2c
    // non-zero. A diagonal-only check passes with Sx_j*Sy_k by itself, so
    // hessian_of(r, 0, 1) is the pin that actually tests this rule.
    fn so_combine_hess_mul(self, hL: [i64; 36], hR: [i64; 36], sL: [i64; 32], sR: [i64; 32], lhs_v: i64, rhs_v: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self.so_clear_expr_hess()
        var nch = lo.fo_nchan
        if nch > 8 { nch = 8 }
        var j: i64 = 0
        while j < nch {
            var k: i64 = j
            while k < nch {
                let idx = lo.so_hess_idx(j, k)
                var acc: i64 = 0 - 1

                let t1 = lo.so_mul_or_none(hL[idx as usize], rhs_v)
                lo = t1.0
                let a1 = lo.so_add_or_take(acc, t1.1)
                lo = a1.0
                acc = a1.1

                let t2 = lo.so_mul_or_none(lhs_v, hR[idx as usize])
                lo = t2.0
                let a2 = lo.so_add_or_take(acc, t2.1)
                lo = a2.0
                acc = a2.1

                let c1 = lo.so_mul_or_none(sL[j as usize], sR[k as usize])
                lo = c1.0
                let a3 = lo.so_add_or_take(acc, c1.1)
                lo = a3.0
                acc = a3.1

                let c2 = lo.so_mul_or_none(sL[k as usize], sR[j as usize])
                lo = c2.0
                let a4 = lo.so_add_or_take(acc, c2.1)
                lo = a4.0
                acc = a4.1

                lo.so_expr_hess[idx as usize] = acc
                k = k + 1
            }
            j = j + 1
        }
        lo
    }

    fn fo_clear_expr_sens(self) -> Lowerer with Mut {
        var lo = self
        var k: i64 = 0
        while k < 32 {
            lo.fo_expr_sens[k as usize] = -1
            k = k + 1
        }
        lo
    }

    fn fo_clear_pending_sens(self) -> Lowerer with Mut {
        var lo = self
        var k: i64 = 0
        while k < 32 {
            lo.fo_pending_sens[k as usize] = -1
            k = k + 1
        }
        lo
    }

    fn fo_expr_has_sens(self) -> bool with Mut {
        var k: i64 = 0
        while k < 32 {
            if self.fo_expr_sens[k as usize] >= 0 {
                return true
            }
            k = k + 1
        }
        false
    }

    // Ensure variance_reg is a FO channel; seed fo_expr_sens with 1.0 on that channel.
    fn fo_seed_from_variance(self, variance_reg: i64, sigma_reg: i64) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        if variance_reg < 0 {
            return lo.fo_clear_expr_sens()
        }
        // Reuse existing channel for this σ² reg.
        var k: i64 = 0
        while k < lo.fo_nchan {
            if lo.fo_sigma2[k as usize] == variance_reg {
                lo = lo.fo_clear_expr_sens()
                let one = lo.emit_f64_const(1.0)
                lo = one.0
                lo.fo_expr_sens[k as usize] = one.1
                return lo
            }
            k = k + 1
        }
        if lo.fo_nchan >= 32 {
            // Channel table full — leave sens empty (caller falls back to scalar Var).
            return lo.fo_clear_expr_sens()
        }
        let ch = lo.fo_nchan
        lo.fo_sigma2[ch as usize] = variance_reg
        FO_SIGMA_REG[ch as usize] = sigma_reg
        lo.fo_nchan = ch + 1
        lo = lo.fo_clear_expr_sens()
        let one = lo.emit_f64_const(1.0)
        lo = one.0
        lo.fo_expr_sens[ch as usize] = one.1
        lo
    }

    fn fo_snapshot_expr_sens(self) -> [i64; 32] with Mut {
        var snap: [i64; 32] = [-1; 32]
        var k: i64 = 0
        while k < 32 {
            snap[k as usize] = self.fo_expr_sens[k as usize]
            k = k + 1
        }
        snap
    }

    fn fo_restore_expr_sens(self, snap: [i64; 32]) -> Lowerer with Mut {
        var lo = self
        var k: i64 = 0
        while k < 32 {
            lo.fo_expr_sens[k as usize] = snap[k as usize]
            k = k + 1
        }
        lo
    }

    // A local carries its Hessian exactly as it carries its gradient, on the
    // same bind rows, so `let r = c*c*k` then `hessian_of(r, 0, 1)` reads the
    // slot the product rule wrote. -1 stays -1: a structurally-zero entry
    // costs no register and no copy.
    fn so_expr_has_hess(self) -> bool with Mut {
        var i: i64 = 0
        while i < 36 {
            if self.so_expr_hess[i as usize] >= 0 {
                return true
            }
            i = i + 1
        }
        false
    }

    fn so_bind_local_hess(self, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self
        // Only claim a bind row when there is actually a Hessian to store.
        // fo_bind_row_for ALLOCATES, and the table holds 128 rows; calling it
        // for every `let` filled it on the first few dozen statements of a
        // 28-state PBPK and starved the first-order bindings that share it.
        // That is what truncated dissertation_pbpk28_parity_ref_rapamycin from
        // 1714 lines of output to 9.
        if !lo.so_expr_has_hess() {
            return lo
        }
        let rp = lo.fo_bind_row_for(name)
        lo = rp.0
        let row = rp.1
        if row < 0 || row >= 16 {
            return lo
        }
        var i: i64 = 0
        while i < 36 {
            lo.so_bind_hess[(row * 36 + i) as usize] = lo.so_expr_hess[i as usize]
            i = i + 1
        }
        lo
    }

    fn so_load_local_hess(self, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self.so_clear_expr_hess()
        var row: i64 = 0 - 1
        var i: i64 = 0
        while i < lo.fo_bind_count {
            if ir_name_eq((*lo.fo_bind).names[i as usize], name) {
                row = i
                i = lo.fo_bind_count
            } else {
                i = i + 1
            }
        }
        if row < 0 || row >= 16 {
            return lo
        }
        var j: i64 = 0
        while j < 36 {
            lo.so_expr_hess[j as usize] = lo.so_bind_hess[(row * 36 + j) as usize]
            j = j + 1
        }
        lo
    }

    fn fo_bind_local_sens(self, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self
        // Update existing bind if present.
        var i: i64 = 0
        while i < lo.fo_bind_count {
            if ir_name_eq((*lo.fo_bind).names[i as usize], name) {
                var k: i64 = 0
                while k < 32 {
                    var fb2 = lo.fo_bind
                    (*fb2).sens[(i * 32 + k) as usize] = lo.fo_expr_sens[k as usize]
                    lo.fo_bind = fb2
                    k = k + 1
                }
                return lo
            }
            i = i + 1
        }
        if lo.fo_bind_count >= 128 {
            return lo
        }
        let idx = lo.fo_bind_count
        var fb3 = lo.fo_bind
        (*fb3).names[idx as usize] = name
        lo.fo_bind = fb3
        var k2: i64 = 0
        while k2 < 32 {
            var fb4 = lo.fo_bind
            (*fb4).sens[(idx * 32 + k2) as usize] = lo.fo_expr_sens[k2 as usize]
            lo.fo_bind = fb4
            k2 = k2 + 1
        }
        lo.fo_bind_count = idx + 1
        lo
    }

    fn fo_bind_pending_to_local(self, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self
        // Move pending_sens into expr_sens then bind.
        var k: i64 = 0
        var any = false
        while k < 32 {
            lo.fo_expr_sens[k as usize] = lo.fo_pending_sens[k as usize]
            if lo.fo_pending_sens[k as usize] >= 0 {
                any = true
            }
            lo.fo_pending_sens[k as usize] = -1
            k = k + 1
        }
        if any {
            lo = lo.fo_bind_local_sens(name)
        }
        lo
    }

    fn fo_load_local_sens(self, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self
        var i: i64 = 0
        while i < lo.fo_bind_count {
            if ir_name_eq((*lo.fo_bind).names[i as usize], name) {
                var k: i64 = 0
                while k < 32 {
                    lo.fo_expr_sens[k as usize] = (*lo.fo_bind).sens[(i * 32 + k) as usize]
                    k = k + 1
                }
                return lo
            }
            i = i + 1
        }
        lo.fo_clear_expr_sens()
    }

    // Var = Σ_k s_k² · σ²_k from current fo_expr_sens.
    fn fo_emit_var_from_sens(self) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let z = self.emit_f64_const(0.0)
        var lo = z.0
        var acc = z.1
        var k: i64 = 0
        while k < 32 {
            let sreg = lo.fo_expr_sens[k as usize]
            let sig = lo.fo_sigma2[k as usize]
            if sreg >= 0 && sig >= 0 {
                // s²
                let sq_p = lo.fresh_reg()
                lo = sq_p.0
                let sq = sq_p.1
                lo = lo.emit(ir_binop_typed(sq, sreg, BinaryOp::OpMul, sreg, true, true))
                lo = lo.emit(ir_mark_float_reg(sq))
                // s² · σ²
                let c_p = lo.fresh_reg()
                lo = c_p.0
                let contrib = c_p.1
                lo = lo.emit(ir_binop_typed(contrib, sq, BinaryOp::OpMul, sig, true, true))
                lo = lo.emit(ir_mark_float_reg(contrib))
                // acc += contrib
                let a_p = lo.fresh_reg()
                lo = a_p.0
                let nacc = a_p.1
                lo = lo.emit(ir_binop_typed(nacc, acc, BinaryOp::OpAdd, contrib, true, true))
                lo = lo.emit(ir_mark_float_reg(nacc))
                acc = nacc
            }
            k = k + 1
        }
        // Off-diagonal: 2 * sum_{i<j} s_i * s_j * rho_ij * sigma_i * sigma_j.
        //
        // Without this, Var is the diagonal-only GUM form, which silently assumes
        // every channel independent. correlate(a,b,rho) is what makes that
        // assumption deniable, and this is where it is spent: for Var(x+y) with
        // sigma_x = 0.1, sigma_y = 0.2 and rho = 1, the diagonal gives 0.05 and
        // the true answer is (0.1+0.2)^2 = 0.09.
        //
        // Everything here is INLINE and reads fo_sigma2 the same way the diagonal
        // loop above does. Two earlier shapes failed and both are worth recording:
        // a helper taking self by value read the SAME sigma for every channel (the
        // last one seeded), and a module-global carry of the sigma register did the
        // same. One sqrt of the product sigma2_i * sigma2_j, not two of the parts,
        // because a seed register passed to a call reads back as 1.0 (#2129) and
        // arithmetic is the one boundary that preserves it.
        var ci: i64 = 0
        while ci < 8 {
            var cj: i64 = ci + 1
            while cj < 8 {
                let rho = fo_cov_rho_get(ci, cj)
                let si = lo.fo_expr_sens[ci as usize]
                let sj = lo.fo_expr_sens[cj as usize]
                let v_i = lo.fo_sigma2[ci as usize]
                let v_j = lo.fo_sigma2[cj as usize]
                if rho != 0.0 && si >= 0 && sj >= 0 && v_i >= 0 && v_j >= 0 {
                    let pp = lo.fresh_reg()
                    lo = pp.0
                    lo = lo.emit(ir_binop_typed(pp.1, v_i, BinaryOp::OpMul, v_j, true, true))
                    lo = lo.emit(ir_mark_float_reg(pp.1))
                    let sq_id = lowerer_find_or_add_fn_id_mut(&! lo, make_name("sqrt"))
                    let sq_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(pp.1)))
                    let dp = lo.fresh_reg()
                    lo = dp.0
                    let sig_prod = dp.1
                    var sqi = ir_call(sig_prod, sq_id, make_name("sqrt"), sq_args, 1)
                    sqi.imm_flags = IR_FLOAT_REG_MARKER_FLAG
                    lo = lo.emit(sqi)
                    lo = lo.emit(ir_mark_float_reg(sig_prod))
                    let kp = lo.emit_f64_const(2.0 * rho)
                    lo = kp.0
                    let t1 = lo.fresh_reg()
                    lo = t1.0
                    lo = lo.emit(ir_binop_typed(t1.1, si, BinaryOp::OpMul, sj, true, true))
                    lo = lo.emit(ir_mark_float_reg(t1.1))
                    let t2 = lo.fresh_reg()
                    lo = t2.0
                    lo = lo.emit(ir_binop_typed(t2.1, t1.1, BinaryOp::OpMul, sig_prod, true, true))
                    lo = lo.emit(ir_mark_float_reg(t2.1))
                    let t3 = lo.fresh_reg()
                    lo = t3.0
                    lo = lo.emit(ir_binop_typed(t3.1, t2.1, BinaryOp::OpMul, kp.1, true, true))
                    lo = lo.emit(ir_mark_float_reg(t3.1))
                    let ap = lo.fresh_reg()
                    lo = ap.0
                    lo = lo.emit(ir_binop_typed(ap.1, acc, BinaryOp::OpAdd, t3.1, true, true))
                    lo = lo.emit(ir_mark_float_reg(ap.1))
                    acc = ap.1
                }
                cj = cj + 1
            }
            ci = ci + 1
        }
        (lo, acc)
    }

    // s_out[k] = sL[k] + sR[k]  (add) or sL[k] - sR[k] (sub)
    fn fo_combine_sens_addsub(self, sL: [i64; 32], sR: [i64; 32], is_sub: bool) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        var k: i64 = 0
        while k < 32 {
            let l = sL[k as usize]
            let r = sR[k as usize]
            if l < 0 && r < 0 {
                lo.fo_expr_sens[k as usize] = -1
            } else if r < 0 {
                lo.fo_expr_sens[k as usize] = l
            } else if l < 0 {
                if is_sub {
                    // 0 - r
                    let zp = lo.emit_f64_const(0.0)
                    lo = zp.0
                    let dp = lo.fresh_reg()
                    lo = dp.0
                    let dst = dp.1
                    lo = lo.emit(ir_binop_typed(dst, zp.1, BinaryOp::OpSub, r, true, true))
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo.fo_expr_sens[k as usize] = dst
                } else {
                    lo.fo_expr_sens[k as usize] = r
                }
            } else {
                let op = if is_sub { BinaryOp::OpSub } else { BinaryOp::OpAdd }
                let dp = lo.fresh_reg()
                lo = dp.0
                let dst = dp.1
                lo = lo.emit(ir_binop_typed(dst, l, op, r, true, true))
                lo = lo.emit(ir_mark_float_reg(dst))
                lo.fo_expr_sens[k as usize] = dst
            }
            k = k + 1
        }
        lo
    }

    // Product rule: s_out[k] = rhs_val · sL[k] + lhs_val · sR[k]
    fn fo_combine_sens_mul(
        self,
        sL: [i64; 32],
        sR: [i64; 32],
        lhs_val: i64,
        rhs_val: i64
    ) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        var k: i64 = 0
        while k < 32 {
            let l = sL[k as usize]
            let r = sR[k as usize]
            var term_l: i64 = -1
            var term_r: i64 = -1
            if l >= 0 {
                let tp = lo.fresh_reg()
                lo = tp.0
                term_l = tp.1
                lo = lo.emit(ir_binop_typed(term_l, rhs_val, BinaryOp::OpMul, l, true, true))
                lo = lo.emit(ir_mark_float_reg(term_l))
            }
            if r >= 0 {
                let tp2 = lo.fresh_reg()
                lo = tp2.0
                term_r = tp2.1
                lo = lo.emit(ir_binop_typed(term_r, lhs_val, BinaryOp::OpMul, r, true, true))
                lo = lo.emit(ir_mark_float_reg(term_r))
            }
            if term_l < 0 && term_r < 0 {
                lo.fo_expr_sens[k as usize] = -1
            } else if term_r < 0 {
                lo.fo_expr_sens[k as usize] = term_l
            } else if term_l < 0 {
                lo.fo_expr_sens[k as usize] = term_r
            } else {
                let ap = lo.fresh_reg()
                lo = ap.0
                let dst = ap.1
                lo = lo.emit(ir_binop_typed(dst, term_l, BinaryOp::OpAdd, term_r, true, true))
                lo = lo.emit(ir_mark_float_reg(dst))
                lo.fo_expr_sens[k as usize] = dst
            }
            k = k + 1
        }
        lo
    }

    // Quotient rule: s_out[k] = sL[k]/b − a·sR[k]/b²  (f = a/b).
    fn fo_combine_sens_div(
        self,
        sL: [i64; 32],
        sR: [i64; 32],
        lhs_val: i64,
        rhs_val: i64
    ) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        // b²
        let bb_p = lo.fresh_reg()
        lo = bb_p.0
        let bb = bb_p.1
        lo = lo.emit(ir_binop_typed(bb, rhs_val, BinaryOp::OpMul, rhs_val, true, true))
        lo = lo.emit(ir_mark_float_reg(bb))
        var k: i64 = 0
        while k < 32 {
            let l = sL[k as usize]
            let r = sR[k as usize]
            var term_l: i64 = -1
            var term_r: i64 = -1
            if l >= 0 {
                // sL / b
                let tp = lo.fresh_reg()
                lo = tp.0
                term_l = tp.1
                lo = lo.emit(ir_binop_typed(term_l, l, BinaryOp::OpDiv, rhs_val, true, true))
                lo = lo.emit(ir_mark_float_reg(term_l))
            }
            if r >= 0 {
                // a * sR / b²
                let ar_p = lo.fresh_reg()
                lo = ar_p.0
                let ar = ar_p.1
                lo = lo.emit(ir_binop_typed(ar, lhs_val, BinaryOp::OpMul, r, true, true))
                lo = lo.emit(ir_mark_float_reg(ar))
                let tp2 = lo.fresh_reg()
                lo = tp2.0
                term_r = tp2.1
                lo = lo.emit(ir_binop_typed(term_r, ar, BinaryOp::OpDiv, bb, true, true))
                lo = lo.emit(ir_mark_float_reg(term_r))
            }
            if term_l < 0 && term_r < 0 {
                lo.fo_expr_sens[k as usize] = -1
            } else if term_r < 0 {
                lo.fo_expr_sens[k as usize] = term_l
            } else if term_l < 0 {
                // 0 - term_r
                let zp = lo.emit_f64_const(0.0)
                lo = zp.0
                let dp = lo.fresh_reg()
                lo = dp.0
                let dst = dp.1
                lo = lo.emit(ir_binop_typed(dst, zp.1, BinaryOp::OpSub, term_r, true, true))
                lo = lo.emit(ir_mark_float_reg(dst))
                lo.fo_expr_sens[k as usize] = dst
            } else {
                let dp = lo.fresh_reg()
                lo = dp.0
                let dst = dp.1
                lo = lo.emit(ir_binop_typed(dst, term_l, BinaryOp::OpSub, term_r, true, true))
                lo = lo.emit(ir_mark_float_reg(dst))
                lo.fo_expr_sens[k as usize] = dst
            }
            k = k + 1
        }
        lo
    }

    // Independent FO quotient: Var(a/b) = (1/b)² Va + (a/b²)² Vb.
    fn emit_variance_independent_div(
        self,
        lhs_val: i64,
        rhs_val: i64,
        lv: i64,
        rv: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        // inv_b = 1/b
        let one_p = lo.emit_f64_const(1.0)
        lo = one_p.0
        let inv_p = lo.fresh_reg()
        lo = inv_p.0
        let inv_b = inv_p.1
        lo = lo.emit(ir_binop_typed(inv_b, one_p.1, BinaryOp::OpDiv, rhs_val, true, true))
        lo = lo.emit(ir_mark_float_reg(inv_b))
        // term_l = (1/b)² Va
        let tl_p = lo.emit_variance_scale(lv, inv_b)
        lo = tl_p.0
        let term_l = tl_p.1
        // b²
        let bb_p = lo.fresh_reg()
        lo = bb_p.0
        let bb = bb_p.1
        lo = lo.emit(ir_binop_typed(bb, rhs_val, BinaryOp::OpMul, rhs_val, true, true))
        lo = lo.emit(ir_mark_float_reg(bb))
        // a/b²
        let ab_p = lo.fresh_reg()
        lo = ab_p.0
        let a_over_b2 = ab_p.1
        lo = lo.emit(ir_binop_typed(a_over_b2, lhs_val, BinaryOp::OpDiv, bb, true, true))
        lo = lo.emit(ir_mark_float_reg(a_over_b2))
        // term_r = (a/b²)² Vb
        let tr_p = lo.emit_variance_scale(rv, a_over_b2)
        lo = tr_p.0
        lo.emit_variance_add(term_l, tr_p.1)
    }

    fn fo_expr_or_snap_has_sens(self, snap: [i64; 32]) -> bool with Mut {
        var k: i64 = 0
        while k < 32 {
            if snap[k as usize] >= 0 || self.fo_expr_sens[k as usize] >= 0 {
                return true
            }
            k = k + 1
        }
        false
    }

    // ─── Inter-procedural FO transfers for pure helpers ─────────────────────

    fn fo_xfer_lookup(self, name: Name) -> i64 with Mut, Panic, Div {
        fo_xfer_global_lookup(name)
    }

    fn fo_xfer_set(self, name: Name, kind: i64, lit: f64, fwd: Name) -> Lowerer with Mut, Panic, Div, IO {
        fo_xfer_global_set(name, kind, lit, fwd)
        self
    }

    // Match expr Ident to param index; -1 if not a param.
    fn fo_param_index(self, e: &Expr, p0: Name, p1: Name, nparams: i64) -> i64 with Mut, Panic, Div {
        if (*e).kind != ExprKind::ExprIdent {
            return -1
        }
        if nparams >= 1 && ir_name_eq((*e).name, p0) {
            return 0
        }
        if nparams >= 2 && ir_name_eq((*e).name, p1) {
            return 1
        }
        -1
    }

    fn fo_expr_as_lit(self, e: &Expr) -> (bool, f64) with Mut, Panic, Div {
        if (*e).kind == ExprKind::ExprFloatLit {
            return (true, (*e).float_val)
        }
        if (*e).kind == ExprKind::ExprIntLit {
            return (true, (*e).int_val as f64)
        }
        (false, 0.0)
    }

    // Classify pure helper body and record FO transfer (id / scale / add / mul / fwd).
    fn fo_register_pure_fn_transfer(self, name: Name, fd: &FnDef) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // Collect up to 2 param names.
        var p0 = ir_empty_name()
        var p1 = ir_empty_name()
        var nparams: i64 = 0
        var pcur = &fd.params
        while true {
            match *pcur {
                Some(pl) => {
                    if nparams == 0 {
                        p0 = (*pl).head.name
                        nparams = 1
                    } else if nparams == 1 {
                        p1 = (*pl).head.name
                        nparams = 2
                    } else {
                        // >2 params: skip (unsupported transfer)
                        return lo
                    }
                    pcur = &(*pl).tail
                }
                _ => break
            }
        }
        if nparams <= 0 {
            return lo
        }
        lo = lo.fo_ctor_register_body(name, &fd.body, p0, p1, nparams)
        lo.fo_classify_block_transfer(name, &fd.body, p0, p1, nparams)
    }

    // Classify ONE struct-literal field initialiser into the shared kind/lit
    // vocabulary. Deliberately narrow: anything not listed stays UNREGISTERED, so
    // the query keeps returning the pre-existing 0.0 rather than a confident wrong
    // number. A field init that reads a global, or calls something unregistered,
    // must not be guessed at.
    // Param index of an operand, seeing through the ctor's own let bindings.
    // `let t = x; let u = t * 2.0` puts a LOCAL where the kind vocabulary expects
    // a parameter, so without this the binary arm below matches nothing and the
    // field stays unregistered.
    fn fo_ctor_param_index_thru_lets(self, blk: &Block, e: &Expr, p0: Name, p1: Name, nparams: i64, depth: i64) -> i64 with Mut, Panic, Div, Alloc, IO {
        if depth > 8 || (*e).kind != ExprKind::ExprIdent {
            return 0 - 1
        }
        if nparams >= 1 && ir_name_eq((*e).name, p0) {
            return 0
        }
        if nparams >= 2 && ir_name_eq((*e).name, p1) {
            return 1
        }
        var current = &(*blk).stmts
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtLet || stmt_ref.kind == StmtKind::StmtVar {
                        if ir_name_eq(stmt_ref.name, (*e).name) {
                            match stmt_ref.expr {
                                Some(rhs) => {
                                    return self.fo_ctor_param_index_thru_lets(blk, &(*rhs), p0, p1, nparams, depth + 1)
                                }
                                _ => { return 0 - 1 }
                            }
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        0 - 1
    }

    fn fo_ctor_classify_leaf(self, fn_hash: i64, path: i64, field0: i64, blk: &Block, e: &Expr, p0: Name, p1: Name, nparams: i64, depth: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if depth > 8 {
            return lo
        }
        if (*e).kind == ExprKind::ExprIdent {
            if nparams >= 1 && ir_name_eq((*e).name, p0) {
                fo_ctor_global_set(fn_hash, path, 1, 0.0, field0)
                return lo
            }
            if nparams >= 2 && ir_name_eq((*e).name, p1) {
                fo_ctor_global_set(fn_hash, path, 1, 1.0, field0)
                return lo
            }
            // Not a parameter: it may be a local the ctor let-bound before the
            // literal. `let t = x; let u = t * 2.0; Pk { cl0: u }` has to reach
            // `x * 2.0` before the kind vocabulary can describe it, and the chain
            // can be more than one hop.
            var current = &(*blk).stmts
            while true {
                match *current {
                    Some(list) => {
                        let stmt_ref = &(*list).head
                        if stmt_ref.kind == StmtKind::StmtLet || stmt_ref.kind == StmtKind::StmtVar {
                            if ir_name_eq(stmt_ref.name, (*e).name) {
                                match stmt_ref.expr {
                                    Some(rhs) => {
                                        return lo.fo_ctor_classify_leaf(fn_hash, path, field0, blk, &(*rhs), p0, p1, nparams, depth + 1)
                                    }
                                    _ => { return lo }
                                }
                            }
                        }
                        current = &(*list).tail
                    }
                    _ => break
                }
            }
            return lo
        }
        if (*e).kind == ExprKind::ExprBinary {
            match (*e).left {
                Some(le) => {
                    match (*e).right {
                        Some(re) => {
                            let li = lo.fo_ctor_param_index_thru_lets(blk, &(*le), p0, p1, nparams, 0)
                            let ri = lo.fo_ctor_param_index_thru_lets(blk, &(*re), p0, p1, nparams, 0)
                            let ll = lo.fo_expr_as_lit(&(*le))
                            let rl = lo.fo_expr_as_lit(&(*re))
                            if (*e).bin_op == BinaryOp::OpMul {
                                if ll.0 && ri == 0 { fo_ctor_global_set(fn_hash, path, 2, ll.1, field0); return lo }
                                if rl.0 && li == 0 { fo_ctor_global_set(fn_hash, path, 2, rl.1, field0); return lo }
                                if nparams >= 2 && ((li == 0 && ri == 1) || (li == 1 && ri == 0)) {
                                    fo_ctor_global_set(fn_hash, path, 4, 0.0, field0)
                                    return lo
                                }
                            }
                            if (*e).bin_op == BinaryOp::OpAdd {
                                if nparams >= 2 && ((li == 0 && ri == 1) || (li == 1 && ri == 0)) {
                                    fo_ctor_global_set(fn_hash, path, 3, 0.0, field0)
                                    return lo
                                }
                            }
                            // Division is not commutative: only p0 / p1.
                            if (*e).bin_op == BinaryOp::OpDiv {
                                if nparams >= 2 && li == 0 && ri == 1 {
                                    fo_ctor_global_set(fn_hash, path, 7, 0.0, field0)
                                    return lo
                                }
                            }
                            return lo
                        }
                        _ => { return lo }
                    }
                }
                _ => { return lo }
            }
        }
        lo
    }

    // Walk a struct literal, registering one entry per LEAF field path.
    // `make_d(x, v0) -> D { c: C { b: B { a: A { x: x } } }, v0: v0 }` yields
    // path(c,b,a,x) -> kind 1 @ p0 and path(v0) -> kind 1 @ p1.
    fn fo_ctor_walk_literal(self, fn_hash: i64, path: i64, blk: &Block, e: &Expr, p0: Name, p1: Name, nparams: i64, depth: i64, sname: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if depth > 8 {
            return lo
        }
        var current = &(*e).fields
        var field_idx: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let fname = (*list).head.name
                    let sub = fo_ctor_path_fold(path, fo_name_hash(fname))
                    let init = &(*list).head.value
                    let f0 = if depth == 0 {
                        if sname.len > 0 { lo.field_idx_from_struct_literal_name(sname, fname, field_idx) } else { lo.field_idx_from_name_simple(fname) }
                    } else { 0 - 1 }
                    if (*init).kind == ExprKind::ExprStructLit {
                        lo = lo.fo_ctor_walk_literal(fn_hash, sub, blk, init, p0, p1, nparams, depth + 1, ir_path_first_name((*init).path))
                    } else {
                        lo = lo.fo_ctor_classify_leaf(fn_hash, sub, f0, blk, init, p0, p1, nparams, 0)
                    }
                    field_idx = field_idx + 1
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    // Find the struct literal a function's body returns, if any, and register its
    // leaf field paths. Mirrors fo_classify_block_transfer's trailing-expression
    // discovery, including the single-trailing-`let` substitution, so
    // `let p = Pk { ... }; p` registers exactly like a bare literal would.
    fn fo_ctor_register_body(self, name: Name, blk: &Block, p0: Name, p1: Name, nparams: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let fn_hash = fo_name_hash(name)
        var current = &(*blk).stmts
        var last_let_name = ir_empty_name()
        var last_let_expr: Option<Box<Expr>> = None
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtLet || stmt_ref.kind == StmtKind::StmtVar {
                        match stmt_ref.expr {
                            Some(te) => {
                                last_let_name = stmt_ref.name
                                last_let_expr = Some(te)
                            }
                            _ => {
                                last_let_name = ir_empty_name()
                                last_let_expr = None
                            }
                        }
                    } else if stmt_ref.kind == StmtKind::StmtExpr {
                        match stmt_ref.expr {
                            Some(te) => {
                                var e_ref: &Expr = &(*te)
                                if (*te).kind == ExprKind::ExprReturn {
                                    match (*te).left {
                                        Some(inner) => { e_ref = &(*inner) }
                                        _ => {}
                                    }
                                }
                                if (*e_ref).kind == ExprKind::ExprStructLit {
                                    lo = lo.fo_ctor_walk_literal(fn_hash, 5381, blk, e_ref, p0, p1, nparams, 0, ir_path_first_name((*e_ref).path))
                                } else if (*e_ref).kind == ExprKind::ExprIdent && last_let_name.len > 0 {
                                    if ir_name_eq((*e_ref).name, last_let_name) {
                                        match last_let_expr {
                                            Some(rhs) => {
                                                if (*rhs).kind == ExprKind::ExprStructLit {
                                                    lo = lo.fo_ctor_walk_literal(fn_hash, 5381, blk, &(*rhs), p0, p1, nparams, 0, ir_path_first_name((*rhs).path))
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn fo_classify_block_transfer(
        self,
        name: Name,
        blk: &Block,
        p0: Name,
        p1: Name,
        nparams: i64
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = &(*blk).stmts
        // Support `let r = x+y; return r` (gum_cross_function): remember last
        // pure let RHS; if the trailing return/expr is that local, classify RHS.
        var last_let_name = ir_empty_name()
        var last_let_expr: Option<Box<Expr>> = None
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtLet || stmt_ref.kind == StmtKind::StmtVar {
                        match stmt_ref.expr {
                            Some(te) => {
                                last_let_name = stmt_ref.name
                                last_let_expr = Some(te)
                            }
                            _ => {
                                last_let_name = ir_empty_name()
                                last_let_expr = None
                            }
                        }
                    } else if stmt_ref.kind == StmtKind::StmtExpr {
                        match stmt_ref.expr {
                            Some(te) => {
                                // Unwrap `return <e>` for classification.
                                var e_ref: &Expr = &(*te)
                                if (*te).kind == ExprKind::ExprReturn {
                                    match (*te).left {
                                        Some(inner) => { e_ref = &(*inner) }
                                        _ => {}
                                    }
                                }
                                // If returning a local that was just let-bound, classify the RHS.
                                if (*e_ref).kind == ExprKind::ExprIdent && last_let_name.len > 0 {
                                    if ir_name_eq((*e_ref).name, last_let_name) {
                                        match last_let_expr {
                                            Some(rhs) => {
                                                lo = lo.fo_classify_expr_transfer(name, &(*rhs), p0, p1, nparams)
                                            }
                                            _ => {
                                                lo = lo.fo_classify_expr_transfer(name, e_ref, p0, p1, nparams)
                                            }
                                        }
                                    } else {
                                        lo = lo.fo_classify_expr_transfer(name, e_ref, p0, p1, nparams)
                                    }
                                } else {
                                    lo = lo.fo_classify_expr_transfer(name, e_ref, p0, p1, nparams)
                                }
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn fo_classify_expr_transfer(
        self,
        name: Name,
        e: &Expr,
        p0: Name,
        p1: Name,
        nparams: i64
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // `return v` wraps the value — classify the inner expression.
        if (*e).kind == ExprKind::ExprReturn {
            match (*e).left {
                Some(inner) => {
                    return lo.fo_classify_expr_transfer(name, &(*inner), p0, p1, nparams)
                }
                _ => { return lo }
            }
        }
        // id: parameter identity. FO_XFER_LIT carries WHICH parameter the body
        // returns -- 0 or 1. That slot is unused for kind 1 and reads back 0.0 on
        // every pre-existing entry, so an old kind-1 entry keeps meaning "returns
        // p0" and nothing has to be migrated.
        //
        // Before this, only `p0` registered. `fn make(a, b) -> S { S { v: b } }`
        // has a field init that is the SECOND parameter, so the per-field ctor
        // transfers below could not describe it at all.
        if (*e).kind == ExprKind::ExprIdent {
            if nparams >= 1 && ir_name_eq((*e).name, p0) {
                return lo.fo_xfer_set(name, 1, 0.0, ir_empty_name())
            }
            if nparams >= 2 && ir_name_eq((*e).name, p1) {
                return lo.fo_xfer_set(name, 1, 1.0, ir_empty_name())
            }
            return lo
        }
        // binary: scale / add / mul
        if (*e).kind == ExprKind::ExprBinary {
            match (*e).left {
                Some(le) => {
                    match (*e).right {
                        Some(re) => {
                            let li = lo.fo_param_index(&(*le), p0, p1, nparams)
                            let ri = lo.fo_param_index(&(*re), p0, p1, nparams)
                            let ll = lo.fo_expr_as_lit(&(*le))
                            let rl = lo.fo_expr_as_lit(&(*re))
                            if (*e).bin_op == BinaryOp::OpMul {
                                // lit * p0 or p0 * lit
                                if ll.0 && ri == 0 {
                                    return lo.fo_xfer_set(name, 2, ll.1, ir_empty_name())
                                }
                                if rl.0 && li == 0 {
                                    return lo.fo_xfer_set(name, 2, rl.1, ir_empty_name())
                                }
                                // p0 * p1
                                if nparams >= 2 && ((li == 0 && ri == 1) || (li == 1 && ri == 0)) {
                                    return lo.fo_xfer_set(name, 4, 0.0, ir_empty_name())
                                }
                            }
                            if (*e).bin_op == BinaryOp::OpAdd {
                                if nparams >= 2 && ((li == 0 && ri == 1) || (li == 1 && ri == 0)) {
                                    return lo.fo_xfer_set(name, 3, 0.0, ir_empty_name())
                                }
                            }
                            // p0 / p1 -- kind 7. Deliberately NOT accepting the
                            // swapped (li == 1 && ri == 0) form the mul/add arms
                            // allow: division is not commutative, and the apply side
                            // takes arg0 as the numerator. Matching `p1 / p0` here
                            // would silently compute the derivative of the reciprocal
                            // expression, which is worse than leaving it unregistered.
                            if (*e).bin_op == BinaryOp::OpDiv {
                                if nparams >= 2 && li == 0 && ri == 1 {
                                    return lo.fo_xfer_set(name, 7, 0.0, ir_empty_name())
                                }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            return lo
        }
        // forward: g(p0) or g(p0, p1) with args exactly params in order
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee) => {
                    if (*callee).kind == ExprKind::ExprIdent {
                        var acur = &(*e).args
                        var ai: i64 = 0
                        var ok = true
                        while true {
                            match *acur {
                                Some(al) => {
                                    let aidx = lo.fo_param_index(&(*al).head, p0, p1, nparams)
                                    if aidx != ai {
                                        ok = false
                                    }
                                    ai = ai + 1
                                    if ai > nparams {
                                        ok = false
                                    }
                                    acur = &(*al).tail
                                }
                                _ => break
                            }
                        }
                        if ok && ai == nparams && ai > 0 {
                            return lo.fo_xfer_set(name, 5, 0.0, (*callee).name)
                        }
                    }
                }
                _ => {}
            }
        }
        lo
    }

    // Lower FO for the N-th call argument (0-based). Returns (-1) if missing.
    fn fo_lower_nth_arg_variance(
        self,
        args: &Option<Box<ExprList>>,
        n: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var acur = args
        var ai: i64 = 0
        while true {
            match *acur {
                Some(al) => {
                    if ai == n {
                        return self.lower_expr_variance_ref(&(*al).head)
                    }
                    ai = ai + 1
                    acur = &(*al).tail
                }
                _ => break
            }
        }
        (self.fo_clear_expr_sens(), -1)
    }

    fn fo_lower_nth_arg_value(
        self,
        args: &Option<Box<ExprList>>,
        n: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var acur = args
        var ai: i64 = 0
        while true {
            match *acur {
                Some(al) => {
                    if ai == n {
                        return self.lower_expr_ref(&(*al).head)
                    }
                    ai = ai + 1
                    acur = &(*al).tail
                }
                _ => break
            }
        }
        self.emit_f64_const(0.0)
    }

    // Apply registered pure-fn FO transfer at a call site. depth limits FWD recursion.
    // Dump the live sensitivity channels. This is the instrument the first
    // attempt at kind 8 lacked: a wrong final variance cannot tell "derivative
    // not applied" from "channel lost", and both look like sigma^2.
    fn fo_trace_sens(self, tag: Name) with Mut, Panic, Div, IO {
        if !lower_live_diag_enabled() {
            return
        }
        print("lower_live: sens ")
        print(str_from_bytes(tag.buf, tag.len))
        print(" nchan=")
        print_int(self.fo_nchan)
        var k: i64 = 0
        while k < 32 {
            if self.fo_expr_sens[k as usize] >= 0 {
                print(" s[")
                print_int(k)
                print("]=r")
                print_int(self.fo_expr_sens[k as usize])
            }
            k = k + 1
        }
        print("\n")
    }

    fn fo_emit_math_call(self, nm: Name, argv: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let fid = lowerer_find_or_add_fn_id_mut(&! lo, nm)
        let cargs: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(argv)))
        let dp = lo.fresh_reg()
        lo = dp.0
        let dreg = dp.1
        var ci = ir_call(dreg, fid, nm, cargs, 1)
        ci.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        lo = lo.emit(ci)
        lo = lo.emit(ir_mark_float_reg(dreg))
        (lo, dreg)
    }

    fn fo_emit_f64_binop(self, a: i64, op: BinaryOp, b: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let rp = lo.fresh_reg()
        lo = rp.0
        let r = rp.1
        lo = lo.emit(ir_binop_typed(r, a, op, b, true, true))
        lo = lo.emit(ir_mark_float_reg(r))
        (lo, r)
    }

    // f'(x) and f''(x) for the kind-8 set, from x plus sqrt/sin/cos/exp only --
    // all backend builtins, so this reintroduces no E221 hole. Signs are baked
    // into the formulas; the caller applies no FO_XFER_LIT correction.
    // f'(x) and f''(x) for the kind-8 set, from x plus sqrt/sin/cos/exp only --
    // all backend builtins, so this reintroduces no E221 hole.
    //
    // EVERY tuple result has its .1 extracted on the line after the call, and
    // nothing reads `<tuple>.1` later. That is not style, and it is required
    // here -- but the reason is NOT fully understood, so do not "tidy" it back.
    //
    // What is measured: written the other way, `d2 = nx / u2` with nx in r22 and
    // u2 in r21 emitted `binop dst=23 src1=22 src2=22` under
    // SOUNIO_NV2_IR_TRACE=1 -- nx in both operand slots, r21 computed and
    // referenced by nothing. Extracting .1 immediately makes it correct, and
    // hessian_of then returns the exact analytic values at two points.
    //
    // What is NOT established: why. "An earlier tuple's .1 reads back the later
    // one's value" was my inference from that excerpt, and it does not
    // reproduce standalone -- five probes, including a method taking self by
    // value on a 512-element struct with `var` reassigned between calls and the
    // earlier .1 read afterwards, all compile and run correctly under Madaros.
    // So the trigger needs something about this context that I did not isolate.
    fn fo_emit_analytic_deriv(self, which: i64, argv: i64, want_second: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let onep = lo.emit_f64_const(1.0)
        lo = onep.0
        let one = onep.1
        let twop = lo.emit_f64_const(2.0)
        lo = twop.0
        let two = twop.1
        let ntp = lo.emit_f64_const(0.0 - 2.0)
        lo = ntp.0
        let negtwo = ntp.1
        let zp = lo.emit_f64_const(0.0)
        lo = zp.0
        let zero = zp.1

        if which == 1 {
            // atan: u = 1 + x^2 ; f' = 1/u ; f'' = -2x/u^2
            let xxp = lo.fo_emit_f64_binop(argv, BinaryOp::OpMul, argv)
            lo = xxp.0
            let xx = xxp.1
            let up = lo.fo_emit_f64_binop(one, BinaryOp::OpAdd, xx)
            lo = up.0
            let u = up.1
            if !want_second {
                let d1p = lo.fo_emit_f64_binop(one, BinaryOp::OpDiv, u)
                lo = d1p.0
                return (lo, d1p.1)
            }
            let u2p = lo.fo_emit_f64_binop(u, BinaryOp::OpMul, u)
            lo = u2p.0
            let u2 = u2p.1
            let nxp = lo.fo_emit_f64_binop(negtwo, BinaryOp::OpMul, argv)
            lo = nxp.0
            let nx = nxp.1
            let d2p = lo.fo_emit_f64_binop(nx, BinaryOp::OpDiv, u2)
            lo = d2p.0
            return (lo, d2p.1)
        }
        if which == 2 || which == 3 {
            // asin: u = 1 - x^2 ; s = sqrt(u) ; f' = 1/s ; f'' = x/(u*s)
            // acos negates both.
            let xxp = lo.fo_emit_f64_binop(argv, BinaryOp::OpMul, argv)
            lo = xxp.0
            let xx = xxp.1
            let up = lo.fo_emit_f64_binop(one, BinaryOp::OpSub, xx)
            lo = up.0
            let u = up.1
            let sp = lo.fo_emit_math_call(make_name("sqrt"), u)
            lo = sp.0
            let sroot = sp.1
            if !want_second {
                let d1p = lo.fo_emit_f64_binop(one, BinaryOp::OpDiv, sroot)
                lo = d1p.0
                let d1 = d1p.1
                if which == 2 {
                    return (lo, d1)
                }
                let ngp = lo.fo_emit_f64_binop(zero, BinaryOp::OpSub, d1)
                lo = ngp.0
                return (lo, ngp.1)
            }
            let usp = lo.fo_emit_f64_binop(u, BinaryOp::OpMul, sroot)
            lo = usp.0
            let us = usp.1
            let d2p = lo.fo_emit_f64_binop(argv, BinaryOp::OpDiv, us)
            lo = d2p.0
            let d2 = d2p.1
            if which == 2 {
                return (lo, d2)
            }
            let ng2p = lo.fo_emit_f64_binop(zero, BinaryOp::OpSub, d2)
            lo = ng2p.0
            return (lo, ng2p.1)
        }
        if which == 4 {
            // tan: c = cos x ; f' = 1/c^2 ; f'' = 2 sin x / c^3
            let cp = lo.fo_emit_math_call(make_name("cos"), argv)
            lo = cp.0
            let c = cp.1
            let c2p = lo.fo_emit_f64_binop(c, BinaryOp::OpMul, c)
            lo = c2p.0
            let c2 = c2p.1
            if !want_second {
                let d1p = lo.fo_emit_f64_binop(one, BinaryOp::OpDiv, c2)
                lo = d1p.0
                return (lo, d1p.1)
            }
            let snp = lo.fo_emit_math_call(make_name("sin"), argv)
            lo = snp.0
            let sn = snp.1
            let c3p = lo.fo_emit_f64_binop(c2, BinaryOp::OpMul, c)
            lo = c3p.0
            let c3 = c3p.1
            let tsp = lo.fo_emit_f64_binop(two, BinaryOp::OpMul, sn)
            lo = tsp.0
            let twosin = tsp.1
            let d2p = lo.fo_emit_f64_binop(twosin, BinaryOp::OpDiv, c3)
            lo = d2p.0
            return (lo, d2p.1)
        }
        if which == 5 {
            // tanh: e = exp(2x) ; t = (e-1)/(e+1) ; f' = 1 - t^2 ; f'' = -2 t f'
            let x2p = lo.fo_emit_f64_binop(two, BinaryOp::OpMul, argv)
            lo = x2p.0
            let x2 = x2p.1
            let ep = lo.fo_emit_math_call(make_name("exp"), x2)
            lo = ep.0
            let e = ep.1
            let emp = lo.fo_emit_f64_binop(e, BinaryOp::OpSub, one)
            lo = emp.0
            let em = emp.1
            let epp = lo.fo_emit_f64_binop(e, BinaryOp::OpAdd, one)
            lo = epp.0
            let epl = epp.1
            let tp = lo.fo_emit_f64_binop(em, BinaryOp::OpDiv, epl)
            lo = tp.0
            let t = tp.1
            let ttp = lo.fo_emit_f64_binop(t, BinaryOp::OpMul, t)
            lo = ttp.0
            let tt = ttp.1
            let d1p = lo.fo_emit_f64_binop(one, BinaryOp::OpSub, tt)
            lo = d1p.0
            let d1 = d1p.1
            if !want_second {
                return (lo, d1)
            }
            let ntxp = lo.fo_emit_f64_binop(negtwo, BinaryOp::OpMul, t)
            lo = ntxp.0
            let ntx = ntxp.1
            let d2p = lo.fo_emit_f64_binop(ntx, BinaryOp::OpMul, d1)
            lo = d2p.0
            return (lo, d2p.1)
        }
        (lo, 0 - 1)
    }

    fn fo_apply_call_transfer(
        self,
        callee: Name,
        args: &Option<Box<ExprList>>,
        depth: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if depth > 8 {
            return (self.fo_clear_expr_sens(), -1)
        }
        let idx = self.fo_xfer_lookup(callee)
        if idx < 0 {
            if lower_live_diag_enabled() {
                print("lower_live: fo_xfer_miss name=")
                print(str_from_bytes(callee.buf, callee.len))
                print(" count=")
                print_int(FO_XFER_COUNT)
                print("\n")
            }
            return (self.fo_clear_expr_sens(), -1)
        }
        if lower_live_diag_enabled() {
            print("lower_live: fo_xfer_hit name=")
            print(str_from_bytes(callee.buf, callee.len))
            print(" kind=")
            print_int(FO_XFER_KIND[idx as usize])
            print("\n")
        }
        self.fo_apply_call_transfer_at(idx, args, depth)
    }

    fn fo_apply_call_transfer_at(
        self,
        idx: i64,
        args: &Option<Box<ExprList>>,
        depth: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if depth > 8 || idx < 0 || idx >= FO_XFER_COUNT {
            return (self.fo_clear_expr_sens(), -1)
        }
        self.fo_apply_transfer_kind(FO_XFER_KIND[idx as usize], FO_XFER_LIT[idx as usize], idx, args, depth)
    }

    // The kind dispatch, reached both from the scalar transfer table (above) and
    // from the per-field ctor table (#1706), which shares this vocabulary rather
    // than growing a second variance algebra beside it. `idx` is only consulted
    // for kinds that need a table-resident detail (5 forwards by hash, 6 chases
    // the derivative name); ctor entries never register those.
    fn fo_apply_transfer_kind(
        self,
        kind: i64,
        kind_lit: f64,
        idx: i64,
        args: &Option<Box<ExprList>>,
        depth: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if depth > 8 {
            return (self.fo_clear_expr_sens(), -1)
        }
        if kind <= 0 {
            return (self.fo_clear_expr_sens(), -1)
        }
        if (kind == 5 || kind == 6) && (idx < 0 || idx >= FO_XFER_COUNT) {
            return (self.fo_clear_expr_sens(), -1)
        }
        // FWD: re-apply under same args (lookup target by hash).
        if kind == 5 {
            let fh = FO_XFER_FWD_HASH[idx as usize]
            let fidx = fo_xfer_global_lookup_hash(fh)
            if fidx < 0 {
                return (self.fo_clear_expr_sens(), -1)
            }
            return self.fo_apply_call_transfer_at(fidx, args, depth + 1)
        }
        // Lower the subject argument's FO. For kind 1 that is the parameter the
        // body returns (FO_XFER_LIT, see the classifier); every other kind is
        // defined on arg0.
        var lo = self
        var subj: i64 = 0
        if kind == 1 {
            if kind_lit >= 0.5 && kind_lit < 1.5 { subj = 1 }
        }
        let p0 = lo.fo_lower_nth_arg_variance(args, subj)
        lo = p0.0
        let v0 = p0.1
        if v0 < 0 && kind != 3 && kind != 4 {
            if !lo.fo_expr_has_sens() {
                return (lo.fo_clear_expr_sens(), -1)
            }
        }
        let s0 = lo.fo_snapshot_expr_sens()
        // Snapshot the argument's Hessian alongside its sensitivity: the kind-6
        // chain rule below needs H(g) before the call overwrites so_expr_hess.
        let h0 = lo.so_snapshot_expr_hess()
        if kind == 1 {
            lo = lo.fo_restore_expr_sens(s0)
            if v0 >= 0 {
                return (lo, v0)
            }
            if lo.fo_expr_has_sens() {
                return lo.fo_emit_var_from_sens()
            }
            return (lo.fo_clear_expr_sens(), -1)
        }
        if kind == 2 {
            let lit = kind_lit
            let c_pair = lo.emit_f64_const(lit)
            lo = c_pair.0
            var sL: [i64; 32] = [-1; 32]
            let aval = lo.fo_lower_nth_arg_value(args, 0)
            lo = aval.0
            lo = lo.fo_combine_sens_mul(sL, s0, c_pair.1, aval.1)
            return lo.fo_emit_var_from_sens()
        }
        // kind 6: chain rule for a unary function whose derivative is callable —
        // d/dx f(g) = f'(g) · dg/dx, with f' emitted as a call.
        //
        // kind 2 multiplies the sensitivity by a COMPILE-TIME constant, which is
        // right for `2.0 * x` and wrong for `sin(x)`, whose factor cos(x) depends
        // on the argument. Precedent for emitting a call from lowering:
        // uncertainty_of already emits sqrt this way.
        if kind == 8 {
            let which = kind_lit_to_analytic_id(kind_lit)
            if which <= 0 {
                return (lo.fo_clear_expr_sens(), -1)
            }
            lo.fo_trace_sens(make_name("k8_entry"))
            let aval8 = lo.fo_lower_nth_arg_value(args, 0)
            lo = aval8.0
            let argv8 = aval8.1
            // The argument register has to be MARKED float before it is read by
            // f64 arithmetic. Kind 6 never needed this because it only ever hands
            // argv to a call, whose own IR_FLOAT_REG_MARKER_FLAG covers it; this
            // arm reads it directly, and unmarked it came back as 0 at run time --
            // which made 1/(1+x^2) evaluate to 1 and the variance to sigma^2.
            if argv8 >= 0 {
                lo = lo.emit(ir_mark_float_reg(argv8))
            }
            lo.fo_trace_sens(make_name("k8_after_argval"))
            if lower_live_diag_enabled() {
                print("lower_live: k8 which=")
                print_int(which)
                print(" argv=r")
                print_int(argv8)
                var q: i64 = 0
                var n0: i64 = 0
                while q < 32 {
                    if s0[q as usize] >= 0 { n0 = n0 + 1 }
                    q = q + 1
                }
                print(" s0_live=")
                print_int(n0)
                print("\n")
            }
            if argv8 < 0 {
                return (lo.fo_clear_expr_sens(), -1)
            }
            // Two calls, not one 3-tuple: `(Lowerer, i64, i64)` returned garbage
            // in its third slot -- traced as d2=r140737316931064, a pointer-shaped
            // value, which is what crashed the second-order block.
            let dd1 = lo.fo_emit_analytic_deriv(which, argv8, false)
            lo = dd1.0
            let d1r = dd1.1
            let dd2 = lo.fo_emit_analytic_deriv(which, argv8, true)
            lo = dd2.0
            let d2r = dd2.1
            if lower_live_diag_enabled() {
                print("lower_live: k8 d1=r")
                print_int(d1r)
                print(" d2=r")
                print_int(d2r)
                print("\n")
            }
            if d1r < 0 {
                return (lo.fo_clear_expr_sens(), -1)
            }
            // Second order, in kind 6's order: written BEFORE the sens combine,
            // which overwrites fo_expr_sens. Restricted the same way kind 6
            // documents -- only when the argument carries no Hessian of its own,
            // because with a compound inner the chain rule reads s_g^2 where H_g
            // belongs, and a confident wrong number is harder to catch than a zero.
            if lo.so_enabled && !sab_hessian_chain() && d2r >= 0 {
                let hNow8 = lo.so_snapshot_expr_hess()
                var arg_has_hess8 = false
                var hq8: i64 = 0
                while hq8 < 36 {
                    if hNow8[hq8 as usize] >= 0 { arg_has_hess8 = true }
                    hq8 = hq8 + 1
                }
                if arg_has_hess8 {
                    lo = lo.so_clear_expr_hess()
                } else {
                    var hj8: i64 = 0
                    while hj8 < 8 {
                        var hk8: i64 = hj8
                        while hk8 < 8 {
                            let sj8 = s0[hj8 as usize]
                            let sk8 = s0[hk8 as usize]
                            if sj8 >= 0 && sk8 >= 0 {
                                let pjp = lo.fo_emit_f64_binop(sj8, BinaryOp::OpMul, sk8)
                                lo = pjp.0
                                let pj = pjp.1
                                let pvp = lo.fo_emit_f64_binop(d2r, BinaryOp::OpMul, pj)
                                lo = pvp.0
                                let hid8 = lo.so_hess_idx(hj8, hk8)
                                lo.so_expr_hess[hid8 as usize] = pvp.1
                            }
                            hk8 = hk8 + 1
                        }
                        hj8 = hj8 + 1
                    }
                }
            }
            var sL8: [i64; 32] = [-1; 32]
            lo = lo.fo_combine_sens_mul(sL8, s0, d1r, argv8)
            lo.fo_trace_sens(make_name("k8_after_combine"))
            return lo.fo_emit_var_from_sens()
        }
        if kind == 6 {
            let dname = fo_xfer_derivative_name(idx)
            if dname.len == 0 {
                return (lo.fo_clear_expr_sens(), -1)
            }
            let aval = lo.fo_lower_nth_arg_value(args, 0)
            lo = aval.0
            let argv = aval.1
            let dfn_id = lowerer_find_or_add_fn_id_mut(&! lo, dname)
            let dargs: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(argv)))
            let dpair = lo.fresh_reg()
            lo = dpair.0
            let dreg = dpair.1
            var dcall = ir_call(dreg, dfn_id, dname, dargs, 1)
            dcall.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            lo = lo.emit(dcall)
            lo = lo.emit(ir_mark_float_reg(dreg))
            // Sign from FO_XFER_LIT, so d/dx cos = -sin is one entry, not a case.
            let sign = FO_XFER_LIT[idx as usize]
            var factor = dreg
            if sign < 0.0 {
                let sp = lo.emit_f64_const(sign)
                lo = sp.0
                let fp = lo.fresh_reg()
                lo = fp.0
                factor = fp.1
                lo = lo.emit(ir_binop_typed(factor, dreg, BinaryOp::OpMul, sp.1, true, true))
                lo = lo.emit(ir_mark_float_reg(factor))
            }
            // s_k <- factor * s_k for every live channel. fo_combine_sens_mul
            // computes R*dL + L*dR; with the left sens empty this is factor * s0.
            // Second order: H_jk(f(g)) = f''(g)*s_j*s_k + f'(g)*H_jk(g).
            //
            // f'' needs no new table. The transfer entry for f' composed with
            // itself gives it and the signs multiply: sin' = cos and cos' =
            // -sin so sin'' = -sin; cos'' = -cos; exp'' = exp. Deriving it
            // rather than tabulating means a fourth transcendental added to
            // fo_xfer_seed_transcendentals gets its Hessian for free, and
            // cannot acquire a first derivative without a second.
            //
            // Before this, hessian_of(sin(x)) returned a confident 0.0 while
            // hessian_of(x*x) returned the correct 2.0: the second-order
            // machinery had storage and a product rule but no chain rule, so
            // every transcendental silently contributed nothing.
            //
            // Declared sabotage: drop the chain rule and return that confident
            // zero again, so a witness asserting H(sin(x)) has something to die
            // of.
            if lo.so_enabled && !sab_hessian_chain() {
                let idx2 = fo_xfer_global_lookup(dname)
                let d2name = fo_xfer_derivative_name(idx2)
                if d2name.len > 0 {
                    let sign2 = FO_XFER_LIT[idx as usize] * FO_XFER_LIT[idx2 as usize]
                    let d2fn_id = lowerer_find_or_add_fn_id_mut(&! lo, d2name)
                    let d2args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(argv)))
                    let d2p = lo.fresh_reg()
                    lo = d2p.0
                    let d2reg = d2p.1
                    var d2call = ir_call(d2reg, d2fn_id, d2name, d2args, 1)
                    d2call.imm_flags = IR_FLOAT_REG_MARKER_FLAG
                    lo = lo.emit(d2call)
                    lo = lo.emit(ir_mark_float_reg(d2reg))
                    var f2 = d2reg
                    if sign2 < 0.0 {
                        let s2p = lo.emit_f64_const(sign2)
                        lo = s2p.0
                        let m2 = lo.fresh_reg()
                        lo = m2.0
                        f2 = m2.1
                        lo = lo.emit(ir_binop_typed(f2, d2reg, BinaryOp::OpMul, s2p.1, true, true))
                        lo = lo.emit(ir_mark_float_reg(f2))
                    }
                    // Read the argument's Hessian HERE, not from the snapshot taken
                    // before fo_lower_nth_arg_value re-walked the argument: measured,
                    // the earlier snapshot holds a partial cross term rather than the
                    // finished H, and the chain rule then multiplies f' by s_u^2.
                    let hNow = lo.so_snapshot_expr_hess()
                    // Only when the argument carries no Hessian of its own. Then
                    // H(f(g)) = f''(g)*s_g^2 exactly, and that is measured: with a
                    // leaf or linear inner the results are exact to six places.
                    //
                    // With a compound inner -- exp(sin x), exp(x*x) -- the f'(g)*H(g)
                    // term reads s_g^2 where H_g belongs, and the answer comes out
                    // wrong: 2.487814 against 0.469556 for exp(sin x). I do not yet
                    // know why; hNow and the earlier snapshot agree, so it is not
                    // the read point. Refusing that case leaves it returning the 0.0
                    // it returned before, which is honestly wrong rather than
                    // plausibly wrong -- a confident 2.487814 is much harder to catch
                    // than a zero. Same reasoning as log's absence from
                    // fo_xfer_seed_transcendentals, one comment above.
                    var arg_has_hess = false
                    var hq: i64 = 0
                    while hq < 36 {
                        if hNow[hq as usize] >= 0 { arg_has_hess = true }
                        hq = hq + 1
                    }
                    // Refusing means CLEARING, not skipping. Measured: with the
                    // write skipped, so_expr_hess still holds the ARGUMENT's Hessian
                    // and hessian_of reports it as the outer expression's --
                    // hessian_of(exp(x*x)) came back 2.0, which is H(x*x) wearing the
                    // wrong name and looks entirely respectable. Clearing puts it back
                    // to the honest 0.0 this case returned before any of this.
                    var hj: i64 = 0
                    if arg_has_hess {
                        hj = 8
                        lo = lo.so_clear_expr_hess()
                    }
                    while hj < 8 {
                        var hk: i64 = hj
                        while hk < 8 {
                            let hid = lo.so_hess_idx(hj, hk)
                            let t1 = lo.so_mul_or_none(factor, hNow[hid as usize])
                            lo = t1.0
                            let sp2 = lo.so_mul_or_none(s0[hj as usize], s0[hk as usize])
                            lo = sp2.0
                            let t2 = lo.so_mul_or_none(f2, sp2.1)
                            lo = t2.0
                            let hacc = lo.so_add_or_take(t1.1, t2.1)
                            lo = hacc.0
                            lo.so_expr_hess[hid as usize] = hacc.1
                            hk = hk + 1
                        }
                        hj = hj + 1
                    }
                }
            }
            var sZ: [i64; 32] = [-1; 32]
            lo = lo.fo_combine_sens_mul(sZ, s0, factor, factor)
            return lo.fo_emit_var_from_sens()
        }
        // kind 3 add / 4 mul need arg1
        let p1 = lo.fo_lower_nth_arg_variance(args, 1)
        lo = p1.0
        let s1 = lo.fo_snapshot_expr_sens()
        if kind == 3 {
            lo = lo.fo_combine_sens_addsub(s0, s1, false)
            return lo.fo_emit_var_from_sens()
        }
        if kind == 4 {
            let aval0 = lo.fo_lower_nth_arg_value(args, 0)
            lo = aval0.0
            let val0 = aval0.1
            let aval1 = lo.fo_lower_nth_arg_value(args, 1)
            lo = aval1.0
            lo = lo.fo_combine_sens_mul(s0, s1, val0, aval1.1)
            return lo.fo_emit_var_from_sens()
        }
        // kind 7: `f(a, b) = a / b`. Mirrors kind 4 exactly, except the combiner is
        // the quotient rule instead of the product rule. fo_combine_sens_div already
        // existed for the INLINE algebra (`variance_of(a / b)` written out in the
        // caller); this makes the same rule reachable when the division is behind an
        // imported helper -- which is why fo_div2 in stdlib/epistemic/fo.sio missed
        // while fo_mul2, one line away, hit (#1706).
        //
        // ORDER MATTERS: d/da (a/b) = 1/b and d/db (a/b) = -a/b^2, so unlike mul and
        // add the two arguments are NOT interchangeable. s0/arg0 is the numerator.
        if kind == 7 {
            let dval0 = lo.fo_lower_nth_arg_value(args, 0)
            lo = dval0.0
            let dnum = dval0.1
            let dval1 = lo.fo_lower_nth_arg_value(args, 1)
            lo = dval1.0
            lo = lo.fo_combine_sens_div(s0, s1, dnum, dval1.1)
            return lo.fo_emit_var_from_sens()
        }
        (lo.fo_clear_expr_sens(), -1)
    }

    fn emit_variance_add(self, lhs_v: i64, rhs_v: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        var lo = pair.0
        let dst = pair.1
        // Always f64: Var(a)±Var(b) are floats
        lo = lo.emit(ir_binop_typed(dst, lhs_v, BinaryOp::OpAdd, rhs_v, true, true))
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    fn emit_variance_scale(self, variance_reg: i64, scale_reg: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        // Snapshot scale into a private temp so later ops cannot clobber it mid-formula.
        let snap_pair = self.fresh_reg()
        var lo = snap_pair.0
        let scale_snap = snap_pair.1
        lo = lo.emit(ir_copy(scale_snap, scale_reg))
        lo = lo.emit(ir_mark_float_reg(scale_snap))
        let pair_sq = lo.fresh_reg()
        lo = pair_sq.0
        let scale_sq = pair_sq.1
        lo = lo.emit(ir_binop_typed(scale_sq, scale_snap, BinaryOp::OpMul, scale_snap, true, true))
        lo = lo.emit(ir_mark_float_reg(scale_sq))
        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_binop_typed(dst, scale_sq, BinaryOp::OpMul, variance_reg, true, true))
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    fn emit_variance_scale_const(self, variance_reg: i64, scale: f64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let c = self.emit_f64_const(scale)
        c.0.emit_variance_scale(variance_reg, c.1)
    }

    // Independent FO product: Var(a*b) = b² Va + a² Vb.
    // Fully inlined (no nested emit_variance_scale pair bindings) because the
    // two-call form collapsed at runtime to 2·a²·Vb — both addends became the
    // right-hand term (measured 2026-07-25: av=2,bv=3 → 0.020 instead of 0.0325).
    fn emit_variance_independent_product(
        self,
        lhs_val: i64,
        rhs_val: i64,
        lv: i64,
        rv: i64
    ) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        // Private copies of all four inputs first.
        let a_p = self.fresh_reg()
        var lo = a_p.0
        let a = a_p.1
        lo = lo.emit(ir_copy(a, lhs_val))
        lo = lo.emit(ir_mark_float_reg(a))
        let b_p = lo.fresh_reg()
        lo = b_p.0
        let b = b_p.1
        lo = lo.emit(ir_copy(b, rhs_val))
        lo = lo.emit(ir_mark_float_reg(b))
        let va_p = lo.fresh_reg()
        lo = va_p.0
        let va = va_p.1
        lo = lo.emit(ir_copy(va, lv))
        lo = lo.emit(ir_mark_float_reg(va))
        let vb_p = lo.fresh_reg()
        lo = vb_p.0
        let vb = vb_p.1
        lo = lo.emit(ir_copy(vb, rv))
        lo = lo.emit(ir_mark_float_reg(vb))
        // bb = b*b
        let bb_p = lo.fresh_reg()
        lo = bb_p.0
        let bb = bb_p.1
        lo = lo.emit(ir_binop_typed(bb, b, BinaryOp::OpMul, b, true, true))
        lo = lo.emit(ir_mark_float_reg(bb))
        // term_l = bb * va = b² Va
        let t1_p = lo.fresh_reg()
        lo = t1_p.0
        let t1 = t1_p.1
        lo = lo.emit(ir_binop_typed(t1, bb, BinaryOp::OpMul, va, true, true))
        lo = lo.emit(ir_mark_float_reg(t1))
        // aa = a*a
        let aa_p = lo.fresh_reg()
        lo = aa_p.0
        let aa = aa_p.1
        lo = lo.emit(ir_binop_typed(aa, a, BinaryOp::OpMul, a, true, true))
        lo = lo.emit(ir_mark_float_reg(aa))
        // term_r = aa * vb = a² Vb
        let t2_p = lo.fresh_reg()
        lo = t2_p.0
        let t2 = t2_p.1
        lo = lo.emit(ir_binop_typed(t2, aa, BinaryOp::OpMul, vb, true, true))
        lo = lo.emit(ir_mark_float_reg(t2))
        // result = term_l + term_r
        let r_p = lo.fresh_reg()
        lo = r_p.0
        let r = r_p.1
        lo = lo.emit(ir_binop_typed(r, t1, BinaryOp::OpAdd, t2, true, true))
        lo = lo.emit(ir_mark_float_reg(r))
        (lo, r)
    }

    fn expr_is_same_ident_ref(self, lhs: &Option<Box<Expr>>, rhs: &Option<Box<Expr>>) -> bool with Mut, Panic, Div {
        match *lhs {
            Some(l) => {
                if (*l).kind == ExprKind::ExprIdent {
                    match *rhs {
                        Some(r) => {
                            if (*r).kind == ExprKind::ExprIdent {
                                return ir_name_eq((*l).name, (*r).name)
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        false
    }

    // Fully correlated FO for c·x·x: f = c x² ⇒ Var = (2 c x)² Var(x) = 4 c² x² Var(x).
    fn emit_variance_const_square_ident(
        self,
        scale: f64,
        x_name: Name
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let v_pair = self.lower_knowledge_variance_for_ident(x_name)
        var lo = v_pair.0
        let lv0 = v_pair.1
        let lv_pair = if lv0 >= 0 { (lo, lv0) } else { lo.emit_zero_variance() }
        lo = lv_pair.0
        let lv = lv_pair.1
        // 4 Var(x) via scale(Var, 2)
        let two_pair = lo.emit_f64_const(2.0)
        lo = two_pair.0
        let four_v_pair = lo.emit_variance_scale(lv, two_pair.1)
        lo = four_v_pair.0
        // 4 x² Var(x)
        let x_reg = lo.lookup_local(x_name)
        let x_pair = if x_reg >= 0 {
            (lo, x_reg)
        } else {
            lo.emit_f64_const(0.0)
        }
        lo = x_pair.0
        let four_x2_pair = lo.emit_variance_scale(four_v_pair.1, x_pair.1)
        lo = four_x2_pair.0
        // c² · 4 x² Var(x)
        lo.emit_variance_scale_const(four_x2_pair.1, scale)
    }

    // Try correlated FO for (c*x)*x or x*(c*x). Returns (lo, reg) with reg>=0 on hit.
    fn try_variance_const_square_chain(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Pattern A: (c * x) * x  or  (x * c) * x
        match (*e).left {
            Some(le) => {
                if (*le).kind == ExprKind::ExprBinary && (*le).bin_op == BinaryOp::OpMul {
                    match (*le).left {
                        Some(lle) => {
                            match (*le).right {
                                Some(lre) => {
                                    match (*e).right {
                                        Some(re) => {
                                            if (*re).kind == ExprKind::ExprIdent {
                                                // c * x  where right of outer is x
                                                if (*lle).kind == ExprKind::ExprFloatLit && (*lre).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*lre).name, (*re).name) {
                                                        return self.emit_variance_const_square_ident((*lle).float_val, (*re).name)
                                                    }
                                                }
                                                if (*lle).kind == ExprKind::ExprIntLit && (*lre).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*lre).name, (*re).name) {
                                                        return self.emit_variance_const_square_ident((*lle).int_val as f64, (*re).name)
                                                    }
                                                }
                                                // x * c  where right of outer is x
                                                if (*lre).kind == ExprKind::ExprFloatLit && (*lle).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*lle).name, (*re).name) {
                                                        return self.emit_variance_const_square_ident((*lre).float_val, (*re).name)
                                                    }
                                                }
                                                if (*lre).kind == ExprKind::ExprIntLit && (*lle).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*lle).name, (*re).name) {
                                                        return self.emit_variance_const_square_ident((*lre).int_val as f64, (*re).name)
                                                    }
                                                }
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        // Pattern B: x * (c * x)  or  x * (x * c)
        match (*e).right {
            Some(re) => {
                if (*re).kind == ExprKind::ExprBinary && (*re).bin_op == BinaryOp::OpMul {
                    match (*re).left {
                        Some(rle) => {
                            match (*re).right {
                                Some(rre) => {
                                    match (*e).left {
                                        Some(le) => {
                                            if (*le).kind == ExprKind::ExprIdent {
                                                if (*rle).kind == ExprKind::ExprFloatLit && (*rre).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*rre).name, (*le).name) {
                                                        return self.emit_variance_const_square_ident((*rle).float_val, (*le).name)
                                                    }
                                                }
                                                if (*rle).kind == ExprKind::ExprIntLit && (*rre).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*rre).name, (*le).name) {
                                                        return self.emit_variance_const_square_ident((*rle).int_val as f64, (*le).name)
                                                    }
                                                }
                                                if (*rre).kind == ExprKind::ExprFloatLit && (*rle).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*rle).name, (*le).name) {
                                                        return self.emit_variance_const_square_ident((*rre).float_val, (*le).name)
                                                    }
                                                }
                                                if (*rre).kind == ExprKind::ExprIntLit && (*rle).kind == ExprKind::ExprIdent {
                                                    if ir_name_eq((*rle).name, (*le).name) {
                                                        return self.emit_variance_const_square_ident((*rre).int_val as f64, (*le).name)
                                                    }
                                                }
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        (self, -1)
    }

    fn lower_knowledge_variance_for_ident(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Prefer SSA variance shadow (correct for scalars extracted from Knowledge).
        let shadow = self.lookup_local_variance_reg(name)
        if shadow >= 0 {
            return (self, shadow)
        }
        let base = self.lookup_local(name)
        if base < 0 {
            return (self, -1)
        }
        let base_shadow = self.lookup_variance_for_base_reg(base)
        if base_shadow >= 0 {
            return (self, base_shadow)
        }
        // Only field-get variance (idx 1) when this local is a Knowledge object —
        // never on a scalar f64 that was extracted via .value.
        if !ir_name_eq(self.lookup_local_struct_type(name), make_name("Knowledge")) {
            return (self, -1)
        }
        let pair = self.fresh_reg()
        var lo = pair.0
        let dst = pair.1
        var instr = ir_field_get(dst, base, 1, make_name("variance"))
        instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        lo = lo.emit(instr)
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    // Resolve the aggregate reg that a field access is rooted at, hopping through
    // struct-valued fields recorded by bind_variance_for_field_base. `a.x` roots at
    // the local `a`; `c.a.x` roots at `c`, then hops `.a`. Depth-capped so a
    // pathological chain terminates rather than recursing without bound.
    // Resolve a base EXPRESSION to its variance base reg. Per-field variance
    // (#1711) is keyed (base_reg, field_idx) where base_reg comes from a LOCAL,
    // so any chain whose root is not an identifier used to fall straight to -1
    // and variance_of read a silent 0.0 -- while the identical chain on a plain
    // local read correctly.
    fn variance_field_chain_base_of(self, base: &Expr, depth: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if depth > 8 {
            return (self, -1)
        }
        if (*base).kind == ExprKind::ExprIdent {
            return (self, self.lookup_local((*base).name))
        }
        if (*base).kind == ExprKind::ExprFieldAccess {
            let inner = self.variance_field_chain_base_of_parent(base, depth + 1)
            var lo = inner.0
            if inner.1 < 0 {
                return (lo, -1)
            }
            let idx = lo.field_idx_from_name_simple((*base).name)
            return (lo, lo.lookup_variance_for_field_base(inner.1, idx))
        }
        // #1706: a chain rooted at a CALL carrying an identity FO transfer.
        // `id_d(d).c.b.a.x` IS `d.c.b.a.x`, so re-root on arg0 and let the
        // per-field lookup above do the work.
        //
        // Only kind 1 is sound: every other transfer changes the value, so the
        // result's fields are not the argument's fields. Re-rooting on arg0
        // specifically is sound because kind 1 is registered at exactly one site
        // (fo_classify_expr_transfer, the ExprIdent arm) and only when the body
        // returns p0 -- never some other parameter. Checked, not assumed.
        //
        // Recursing here is what makes `id_d(make_d(...)).c.b.a.x` reachable:
        // arg0 is itself a call, so the rewrite has to compose.
        if (*base).kind == ExprKind::ExprCall {
            match (*base).left {
                Some(callee_expr) => {
                    var lo_c = self
                    let cname = lo_c.expr_to_callee_name_ref(&(*callee_expr))
                    let xidx = lo_c.fo_xfer_lookup(cname)
                    if xidx >= 0 && FO_XFER_KIND[xidx as usize] == 1 {
                        // Re-root on the parameter the identity actually returns,
                        // not blindly on arg0 -- kind 1 now records which.
                        let li = FO_XFER_LIT[xidx as usize]
                        var want: i64 = 0
                        if li >= 0.5 && li < 1.5 { want = 1 }
                        var acur = &(*base).args
                        var ai: i64 = 0
                        while true {
                            match *acur {
                                Some(al) => {
                                    if ai == want {
                                        return lo_c.variance_field_chain_base_of(&(*al).head, depth + 1)
                                    }
                                    ai = ai + 1
                                    acur = &(*al).tail
                                }
                                _ => break
                            }
                        }
                        return (lo_c, -1)
                    }
                    return (lo_c, -1)
                }
                _ => { return (self, -1) }
            }
        }
        (self, -1)
    }

    // Same resolution, but given the PARENT of the base (reads (*e).left).
    fn variance_field_chain_base_of_parent(self, e: &Expr, depth: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match (*e).left {
            Some(base_expr) => self.variance_field_chain_base_of(&(*base_expr), depth),
            _ => (self, -1),
        }
    }

    // #1706: `make_d(x, v0).c.b.a.x` -- a field chain rooted at a CALL that is not
    // an identity. The result has no local to key per-field variance on, so this
    // resolves the FIELD PATH against the callee's registered ctor entries and
    // applies the same kind vocabulary the scalar table uses.
    //
    // Returns -1 (the pre-existing silent 0.0) whenever anything is unregistered.
    // A path with no entry means the compiler could not describe that field's
    // provenance, and inventing a number there would be worse than the zero.
    fn fo_ctor_chain_apply(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var hashes: [i64; 8] = [0; 8]
        var n: i64 = 0
        var cur: &Expr = e
        while n < 8 {
            if (*cur).kind != ExprKind::ExprFieldAccess {
                break
            }
            hashes[n as usize] = fo_name_hash((*cur).name)
            n = n + 1
            match (*cur).left {
                Some(b) => { cur = &(*b) }
                _ => { return (lo, 0 - 1) }
            }
        }
        if n <= 0 {
            return (lo, 0 - 1)
        }
        // Peel identity wrappers: `id_d(make_d(x, v0)).c.b.a.x` has the same field
        // provenance as `make_d(x, v0).c.b.a.x`, so walk through the identity to
        // the call that actually built the struct. Bounded, so a mutually
        // identity-wrapping pair cannot spin.
        var peel: i64 = 0
        while peel < 8 {
            if (*cur).kind == ExprKind::ExprMethodCall {
                break
            }
            if (*cur).kind != ExprKind::ExprCall {
                return (lo, 0 - 1)
            }
            var is_id = false
            var want: i64 = 0
            match (*cur).left {
                Some(ce) => {
                    let nm = lo.expr_to_callee_name_ref(&(*ce))
                    let xi = lo.fo_xfer_lookup(nm)
                    if xi >= 0 && FO_XFER_KIND[xi as usize] == 1 {
                        is_id = true
                        let li = FO_XFER_LIT[xi as usize]
                        if li >= 0.5 && li < 1.5 { want = 1 }
                    }
                }
                _ => {}
            }
            if !is_id {
                break
            }
            var acur = &(*cur).args
            var ai: i64 = 0
            var moved = false
            while true {
                match *acur {
                    Some(al) => {
                        if ai == want {
                            cur = &(*al).head
                            moved = true
                            break
                        }
                        ai = ai + 1
                        acur = &(*al).tail
                    }
                    _ => break
                }
            }
            if !moved {
                return (lo, 0 - 1)
            }
            peel = peel + 1
        }
        if (*cur).kind != ExprKind::ExprCall && (*cur).kind != ExprKind::ExprMethodCall {
            return (lo, 0 - 1)
        }
        // Registration walks root-to-leaf; this walk collected leaf-to-root, so
        // fold back the other way or the hashes will never meet.
        var h: i64 = 5381
        var i: i64 = n - 1
        while i >= 0 {
            h = fo_ctor_path_fold(h, hashes[i as usize])
            i = i - 1
        }
        // A method call reaches the same ctor entries through a different name and
        // a shifted argument list. Registration mangles `Type_method` and its
        // params include `self` as p0; the AST arg list excludes the receiver. So
        // a field initialised from the method's first real argument registers as
        // p1 and must be applied against AST arg 0.
        //
        // Only kind 1 with a param index of at least 1 is accepted. Every other
        // kind is defined over p0/p1, and for a method p0 is the RECEIVER, not a
        // scalar -- applying those would silently attribute the receiver's
        // uncertainty to an argument. Refusing keeps the pre-existing 0.0.
        if (*cur).kind == ExprKind::ExprMethodCall {
            match (*cur).left {
                Some(recv) => {
                    if (*recv).kind != ExprKind::ExprIdent {
                        return (lo, 0 - 1)
                    }
                    let tname = lo.lookup_local_struct_type((*recv).name)
                    if tname.len <= 0 {
                        return (lo, 0 - 1)
                    }
                    let mangled = ir_mangle_method_name(tname, (*cur).name)
                    let midx = fo_ctor_global_lookup(fo_name_hash(mangled), h)
                    if midx < 0 {
                        return (lo, 0 - 1)
                    }
                    if FO_CTOR_KIND[midx as usize] != 1 {
                        return (lo, 0 - 1)
                    }
                    let mlit = FO_CTOR_LIT[midx as usize]
                    if mlit < 0.5 {
                        return (lo, 0 - 1)
                    }
                    return lo.fo_apply_transfer_kind(1, mlit - 1.0, 0 - 1, &(*cur).args, 0)
                }
                _ => { return (lo, 0 - 1) }
            }
        }
        match (*cur).left {
            Some(callee_expr) => {
                let cname = lo.expr_to_callee_name_ref(&(*callee_expr))
                let cidx = fo_ctor_global_lookup(fo_name_hash(cname), h)
                if cidx < 0 {
                    return (lo, 0 - 1)
                }
                lo.fo_apply_transfer_kind(FO_CTOR_KIND[cidx as usize], FO_CTOR_LIT[cidx as usize], 0 - 1, &(*cur).args, 0)
            }
            _ => (lo, 0 - 1),
        }
    }

    fn variance_field_chain_base(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.variance_field_chain_base_of_parent(e, 0)
    }

    fn lower_call_expr_variance_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match (*e).left {
            Some(callee_expr) => {
                let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                if ir_name_is_measure(callee_name) {
                    let unc_pair = self.lower_measure_uncertainty_arg_ref(&(*e).args)
                    var lo = unc_pair.0
                    let unc_reg = unc_pair.1
                    lo = lo.emit(ir_mark_float_reg(unc_reg))
                    let pair_v = lo.fresh_reg()
                    lo = pair_v.0
                    let variance_reg = pair_v.1
                    lo = lo.emit(ir_binop_typed(variance_reg, unc_reg, BinaryOp::OpMul, unc_reg, true, true))
                    lo = lo.emit(ir_mark_float_reg(variance_reg))
                    lo = lo.so_clear_expr_hess().fo_seed_from_variance(variance_reg, unc_reg)
                    return (lo, variance_reg)
                }
                let xfer = self.fo_apply_call_transfer(callee_name, &(*e).args, 0)
                var lo_x = xfer.0
                let xv = xfer.1
                if xv >= 0 {
                    return (lo_x, xv)
                }
                if lo_x.fo_expr_has_sens() {
                    return lo_x.fo_emit_var_from_sens()
                }
                return (lo_x.fo_clear_expr_sens().so_clear_expr_hess(), -1)
            }
            _ => {}
        }
        (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
    }

    fn lower_expr_variance_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if (*e).kind == ExprKind::ExprCall {
            return self.lower_call_expr_variance_ref(e)
        }
        self.lower_expr_variance_non_call_ref(e)
    }

    fn lower_expr_variance_non_call_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    if ir_name_is_measure(callee_name) {
                        let unc_pair = self.lower_measure_uncertainty_arg_ref(&(*e).args)
                        var lo = unc_pair.0
                        let unc_reg = unc_pair.1
                        lo = lo.emit(ir_mark_float_reg(unc_reg))
                        let pair_v = lo.fresh_reg()
                        lo = pair_v.0
                        let variance_reg = pair_v.1
                        lo = lo.emit(ir_binop_typed(variance_reg, unc_reg, BinaryOp::OpMul, unc_reg, true, true))
                        lo = lo.emit(ir_mark_float_reg(variance_reg))
                        // Seed FO channel: ∂/∂this = 1 for a fresh measure.
                        lo = lo.so_clear_expr_hess().fo_seed_from_variance(variance_reg, unc_reg)
                        return (lo, variance_reg)
                    }
                    // Inter-procedural FO via pure-fn transfer table.
                    let xfer = self.fo_apply_call_transfer(callee_name, &(*e).args, 0)
                    var lo_x = xfer.0
                    let xv = xfer.1
                    if xv >= 0 {
                        return (lo_x, xv)
                    }
                    if lo_x.fo_expr_has_sens() {
                        return lo_x.fo_emit_var_from_sens()
                    }
                    return (lo_x.fo_clear_expr_sens().so_clear_expr_hess(), -1)
                }
                _ => {}
            }
            return (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
        }
        if (*e).kind == ExprKind::ExprIdent {
            let local_v = self.lookup_local_variance_reg((*e).name)
            if local_v >= 0 {
                // Prefer bound multi-channel sens; else seed a channel from σ².
                var lo = self.fo_load_local_sens((*e).name).so_load_local_hess((*e).name)
                if !lo.fo_expr_has_sens() {
                    lo = lo.so_clear_expr_hess().fo_seed_from_variance(local_v, 0 - 1)
                }
                return (lo, local_v)
            }
            // Knowledge / measure locals: try variance shadow + field-1 even if
            // struct_type was not tagged "Knowledge" (generic Knowledge[f64] path).
            let kn_pair = self.lower_knowledge_variance_for_ident((*e).name)
            if kn_pair.1 >= 0 {
                var lo2 = kn_pair.0.fo_load_local_sens((*e).name).so_load_local_hess((*e).name)
                if !lo2.fo_expr_has_sens() {
                    lo2 = lo2.so_clear_expr_hess().fo_seed_from_variance(kn_pair.1, 0 - 1)
                }
                return (lo2, kn_pair.1)
            }
            return (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
        }
        if (*e).kind == ExprKind::ExprFloatLit || (*e).kind == ExprKind::ExprIntLit {
            let z = self.fo_clear_expr_sens().so_clear_expr_hess().emit_zero_variance()
            return z
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            if ir_name_eq((*e).name, make_name("value")) {
                match (*e).left {
                    Some(base_expr) => {
                        if (*base_expr).kind == ExprKind::ExprIdent {
                            let kn_pair = self.lower_knowledge_variance_for_ident((*base_expr).name)
                            if kn_pair.1 >= 0 {
                                // Seed/reuse FO channel for this Knowledge seed.
                                let lo = kn_pair.0.so_clear_expr_hess().fo_seed_from_variance(kn_pair.1, 0 - 1)
                                return (lo, kn_pair.1)
                            }
                            return kn_pair
                        }
                    }
                    _ => {}
                }
            }
            // #1706: any other field access -- `a.x`, `c.a.x`, arbitrary depth --
            // resolves through the field slots recorded when the struct literal was
            // lowered. Before this, every one of these fell to the `-1` below and
            // variance_of read a silent 0.0.
            let fbase = self.variance_field_chain_base(e)
            if fbase.1 >= 0 {
                var lo_f = fbase.0
                let idx = lo_f.field_idx_from_name_simple((*e).name)
                let fv = lo_f.lookup_variance_for_field(fbase.1, idx)
                if fv >= 0 {
                    lo_f = lo_f.so_clear_expr_hess().fo_seed_from_variance(fv, 0 - 1)
                    return (lo_f, fv)
                }
            }
            // #1706: the chain may be rooted at a call rather than a local.
            let cpair = self.fo_ctor_chain_apply(e)
            if cpair.1 >= 0 {
                return cpair
            }
            return (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
        }
        // Unary negation. Var(-x) = Var(x), but ∂(-x)/∂k = -∂x/∂k, so the variance
        // passes through unchanged while every live channel flips sign. Without this
        // case `-(a.value * b.value)` fell off the FO path entirely and read 0 for
        // both variance and every sensitivity; `-a.value` read +1 instead of -1,
        // because the projection's pending channel leaked past the operator and the
        // sign was simply lost.
        if (*e).kind == ExprKind::ExprUnary && (*e).un_op == UnaryOp::OpNeg {
            let pair_in = match (*e).left {
                Some(inner) => self.lower_expr_variance_ref(&(*inner)),
                _ => (self.fo_clear_expr_sens().so_clear_expr_hess(), -1),
            }
            var lo = pair_in.0
            let vin = pair_in.1
            var hi: i64 = 0
            while hi < 36 && lo.so_enabled {
                let hk = lo.so_expr_hess[hi as usize]
                if hk >= 0 {
                    let zp2 = lo.emit_f64_const(0.0)
                    lo = zp2.0
                    lo = lo.emit(ir_mark_float_reg(zp2.1))
                    let np2 = lo.fresh_reg()
                    lo = np2.0
                    lo = lo.emit(ir_binop_typed(np2.1, zp2.1, BinaryOp::OpSub, hk, true, true))
                    lo = lo.emit(ir_mark_float_reg(np2.1))
                    lo.so_expr_hess[hi as usize] = np2.1
                }
                hi = hi + 1
            }
            var k: i64 = 0
            while k < 32 {
                let sk = lo.fo_expr_sens[k as usize]
                if sk >= 0 {
                    let zp = lo.emit_f64_const(0.0)
                    lo = zp.0
                    let zr = zp.1
                    lo = lo.emit(ir_mark_float_reg(zr))
                    let np = lo.fresh_reg()
                    lo = np.0
                    let nr = np.1
                    lo = lo.emit(ir_binop_typed(nr, zr, BinaryOp::OpSub, sk, true, true))
                    lo = lo.emit(ir_mark_float_reg(nr))
                    lo.fo_expr_sens[k as usize] = nr
                }
                k = k + 1
            }
            return (lo, vin)
        }
        if (*e).kind == ExprKind::ExprBinary {
            let same_ident = self.expr_is_same_ident_ref(&(*e).left, &(*e).right)
            if same_ident && (*e).bin_op == BinaryOp::OpSub {
                let z = self.fo_clear_expr_sens().so_clear_expr_hess().emit_zero_variance()
                return z
            }
            // Lower left FO (variance + sens), snapshot sens before right overwrites.
            let pair_lv = match (*e).left {
                Some(l_expr) => self.lower_expr_variance_ref(&(*l_expr)),
                _ => (self.fo_clear_expr_sens().so_clear_expr_hess(), -1),
            }
            var lo = pair_lv.0
            let lv0 = pair_lv.1
            let lv_pair = if lv0 >= 0 { (lo, lv0) } else { lo.emit_zero_variance() }
            lo = lv_pair.0
            let lv = lv_pair.1
            let sL = lo.fo_snapshot_expr_sens()
            let hL = lo.so_snapshot_expr_hess()

            let pair_rv = match (*e).right {
                Some(r_expr) => lo.lower_expr_variance_ref(&(*r_expr)),
                _ => {
                    let lo2 = lo.fo_clear_expr_sens().so_clear_expr_hess()
                    (lo2, -1)
                },
            }
            lo = pair_rv.0
            let rv0 = pair_rv.1
            let rv_pair = if rv0 >= 0 { (lo, rv0) } else { lo.emit_zero_variance() }
            lo = rv_pair.0
            let rv = rv_pair.1
            let sR = lo.fo_snapshot_expr_sens()
            let hR = lo.so_snapshot_expr_hess()

            // Multi-channel FO path when either side carries seed sensitivities.
            if lo.fo_expr_or_snap_has_sens(sL) {
                if (*e).bin_op == BinaryOp::OpAdd || (*e).bin_op == BinaryOp::OpSub {
                    let is_sub = (*e).bin_op == BinaryOp::OpSub
                    if lo.so_enabled {
                        lo = lo.so_combine_hess_addsub(hL, hR, is_sub)
                    }
                    lo = lo.fo_combine_sens_addsub(sL, sR, is_sub)
                    return lo.fo_emit_var_from_sens()
                }
                if (*e).bin_op == BinaryOp::OpMul {
                    // Need operand values for the product rule.
                    let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                    lo = lhs_val_pair.0
                    let lhs_v = lhs_val_pair.1
                    let rhs_val_pair = lo.lower_opt_expr_ref(&(*e).right)
                    lo = rhs_val_pair.0
                    let rhs_v = rhs_val_pair.1
                    if lo.so_enabled {
                        lo = lo.so_combine_hess_mul(hL, hR, sL, sR, lhs_v, rhs_v)
                    }
                    lo = lo.fo_combine_sens_mul(sL, sR, lhs_v, rhs_v)
                    return lo.fo_emit_var_from_sens()
                }
                if (*e).bin_op == BinaryOp::OpDiv {
                    let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                    lo = lhs_val_pair.0
                    let lhs_v = lhs_val_pair.1
                    let rhs_val_pair = lo.lower_opt_expr_ref(&(*e).right)
                    lo = rhs_val_pair.0
                    let rhs_v = rhs_val_pair.1
                    if lo.so_enabled {
                        lo = lo.so_combine_hess_div(hL, hR, sL, sR, lhs_v, rhs_v)
                    } else {
                        lo = lo.so_clear_expr_hess()
                    }
                    lo = lo.fo_combine_sens_div(sL, sR, lhs_v, rhs_v)
                    return lo.fo_emit_var_from_sens()
                }
            }

            // ── Legacy scalar-variance algebra (no FO seeds) ──
            lo = lo.fo_clear_expr_sens().so_clear_expr_hess()
            if (*e).bin_op == BinaryOp::OpAdd || (*e).bin_op == BinaryOp::OpSub {
                if same_ident && (*e).bin_op == BinaryOp::OpAdd {
                    let two_pair = lo.emit_f64_const(2.0)
                    lo = two_pair.0
                    return lo.emit_variance_scale(lv, two_pair.1)
                }
                if (*e).bin_op == BinaryOp::OpSub && lv >= 0 && lv == rv {
                    return lo.emit_zero_variance()
                }
                return lo.emit_variance_add(lv, rv)
            }
            if (*e).bin_op == BinaryOp::OpMul {
                if same_ident {
                    let two_pair = lo.emit_f64_const(2.0)
                    lo = two_pair.0
                    let four_v_pair = lo.emit_variance_scale(lv, two_pair.1)
                    lo = four_v_pair.0
                    let x_pair = lo.lower_opt_expr_ref(&(*e).left)
                    lo = x_pair.0
                    return lo.emit_variance_scale(four_v_pair.1, x_pair.1)
                }
                match (*e).left {
                    Some(le) => {
                        if (*le).kind == ExprKind::ExprFloatLit {
                            return lo.emit_variance_scale_const(rv, (*le).float_val)
                        }
                        if (*le).kind == ExprKind::ExprIntLit {
                            return lo.emit_variance_scale_const(rv, (*le).int_val as f64)
                        }
                    }
                    _ => {}
                }
                match (*e).right {
                    Some(re) => {
                        if (*re).kind == ExprKind::ExprFloatLit {
                            return lo.emit_variance_scale_const(lv, (*re).float_val)
                        }
                        if (*re).kind == ExprKind::ExprIntLit {
                            return lo.emit_variance_scale_const(lv, (*re).int_val as f64)
                        }
                    }
                    _ => {}
                }
                let corr_pair = lo.try_variance_const_square_chain(e)
                if corr_pair.1 >= 0 {
                    return corr_pair
                }
                lo = corr_pair.0
                // #1569: the value re-lowering below would execute any
                // effectful call in the operands a SECOND time (the first
                // evaluation already happened in lower_let_stmt_ref).
                // Variance of a call result is untracked anyway, so bail
                // instead of re-emitting.
                if lower_opt_expr_contains_call(&(*e).left) || lower_opt_expr_contains_call(&(*e).right) {
                    return (lo, -1)
                }
                let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                lo = lhs_val_pair.0
                let lhs_v = lhs_val_pair.1
                let rhs_val_pair = lo.lower_opt_expr_ref(&(*e).right)
                lo = rhs_val_pair.0
                let rhs_v = rhs_val_pair.1
                let lv_cap = lv
                let rv_cap = rv
                return lo.emit_variance_independent_product(lhs_v, rhs_v, lv_cap, rv_cap)
            }
            if (*e).bin_op == BinaryOp::OpDiv {
                // Constant / x or x / constant via scale.
                match (*e).left {
                    Some(le) => {
                        if (*le).kind == ExprKind::ExprFloatLit || (*le).kind == ExprKind::ExprIntLit {
                            // c/x: need values for (c/x²) scale on rv only — use full formula.
                        }
                    }
                    _ => {}
                }
                // #1569: same double-evaluation hazard as OpMul above —
                // never re-lower an operand that may contain a call.
                if lower_opt_expr_contains_call(&(*e).left) || lower_opt_expr_contains_call(&(*e).right) {
                    return (lo, -1)
                }
                let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                lo = lhs_val_pair.0
                let lhs_v = lhs_val_pair.1
                let rhs_val_pair = lo.lower_opt_expr_ref(&(*e).right)
                lo = rhs_val_pair.0
                let rhs_v = rhs_val_pair.1
                return lo.emit_variance_independent_div(lhs_v, rhs_v, lv, rv)
            }
            return (lo, -1)
        }
        // if-expression: FO through the taken arm when cond is a bool literal;
        // otherwise try then-arm, then else-arm (first arm with live variance wins).
        if (*e).kind == ExprKind::ExprIf {
            var prefer_else = false
            var const_cond = false
            match (*e).left {
                Some(cond) => {
                    if (*cond).kind == ExprKind::ExprBoolTrue {
                        const_cond = true
                        prefer_else = false
                    } else if (*cond).kind == ExprKind::ExprBoolFalse {
                        const_cond = true
                        prefer_else = true
                    }
                }
                _ => {}
            }
            if const_cond && !prefer_else {
                let then_pair = self.lower_block_tail_variance_ref(&(*e).block)
                if then_pair.1 >= 0 {
                    return then_pair
                }
            }
            if const_cond && prefer_else {
                match (*e).else_expr {
                    Some(else_e) => {
                        return self.lower_if_arm_variance_ref(&(*else_e))
                    }
                    _ => {
                        return (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
                    }
                }
            }
            // Non-const cond: prefer then-arm FO; fall back to else.
            let then_pair = self.lower_block_tail_variance_ref(&(*e).block)
            var lo_then = then_pair.0
            let then_v = then_pair.1
            if then_v >= 0 && lo_then.fo_expr_has_sens() {
                return (lo_then, then_v)
            }
            match (*e).else_expr {
                Some(else_e) => {
                    return lo_then.lower_if_arm_variance_ref(&(*else_e))
                }
                _ => {
                    return (lo_then, then_v)
                }
            }
        }
        // Bare block expression (e.g. else-arm `{ a * b }`).
        if (*e).kind == ExprKind::ExprBlock {
            return self.lower_block_tail_variance_ref(&(*e).block)
        }
        (self.fo_clear_expr_sens().so_clear_expr_hess(), -1)
    }

    // if-arm may be a bare expr or an ExprBlock wrapping a block.
    fn lower_if_arm_variance_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if (*e).kind == ExprKind::ExprBlock {
            return self.lower_block_tail_variance_ref(&(*e).block)
        }
        self.lower_expr_variance_ref(e)
    }

    // Variance of a block's trailing expression statement (if-arm value).
    fn lower_block_tail_variance_ref(self, blk_opt: &Option<Box<Block>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *blk_opt {
            Some(blk) => {
                var current = &(*blk).stmts
                var lo = self
                var last_v: i64 = -1
                var found = false
                while true {
                    match *current {
                        Some(list) => {
                            let stmt_ref = &(*list).head
                            if stmt_ref.kind == StmtKind::StmtExpr {
                                match stmt_ref.expr {
                                    Some(te) => {
                                        let p = lo.lower_expr_variance_ref(&(*te))
                                        lo = p.0
                                        last_v = p.1
                                        found = true
                                    }
                                    _ => {}
                                }
                            }
                            current = &(*list).tail
                        }
                        _ => break
                    }
                }
                if found {
                    (lo, last_v)
                } else {
                    (lo.fo_clear_expr_sens(), -1)
                }
            }
            _ => (self.fo_clear_expr_sens(), -1),
        }
    }

    // Returns a print builtin only from positive operand evidence. Kind 0 is
    // not a string classification: routing its word through print's strlen
    // path turns values such as integer 1 into address 0x1 and SIGSEGVs.
    fn println_dispatch_name(self, args: &Option<Box<ExprList>>) -> Name with Mut, Panic, Div, Alloc {
        match *args {
            Some(list) => {
                let sk = self.expr_result_scalar_kind_ref(&(*list).head)
                if sk == 1 {
                    make_name("print_int")
                } else if sk == 2 {
                    make_name("print_f64")
                } else if self.expr_result_is_string_ref(&(*list).head) {
                    make_name("print")
                } else {
                    // The name is deliberately numeric as a poison-safe fallback:
                    // the durable hard error below prevents publication of the ELF,
                    // while an accidentally bypassed barrier still cannot dereference
                    // the unresolved word as a char pointer.
                    if !self.probe_mode {
                        if IR_LOWER_HARD_ERROR == 0 {
                            IR_LOWER_HARD_ERROR_REASON = 2
                            IR_LOWER_HARD_ERROR_NEEDED = 0
                            IR_LOWER_HARD_ERROR_LIMIT = 0
                            ir_copy_name_to_flat(&(*self.current_func).name, &! IR_LOWER_HARD_ERROR_FN_BUF, &! IR_LOWER_HARD_ERROR_FN_LEN)
                        }
                        IR_LOWER_HARD_ERROR = 1
                        lower_note_error(9712, (*self.current_func).name)
                    }
                    make_name("print_int")
                }
            }
            _ => make_name("print"),
        }
    }

    fn bind_reg_array_elem_float(self, reg: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if reg < 0 {
            return lo
        }
        var i: i64 = 0
        while i < lo.array_elem_float_reg_count {
            if lo.array_elem_float_regs[i as usize] == reg {
                return lo
            }
            i = i + 1
        }
        if lo.array_elem_float_reg_count < 512 {
            lo.array_elem_float_regs[lo.array_elem_float_reg_count as usize] = reg
            lo.array_elem_float_reg_count = lo.array_elem_float_reg_count + 1
        }
        lo
    }

    fn lookup_reg_array_elem_float(self, reg: i64) -> bool with Mut, Panic, Div {
        if reg < 0 {
            return false
        }
        var i: i64 = 0
        while i < self.array_elem_float_reg_count {
            if self.array_elem_float_regs[i as usize] == reg {
                return true
            }
            i = i + 1
        }
        false
    }

    fn lookup_local_wide_bits(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*(*self.locals).depths).values[i as usize] <= self.scope_depth && ir_name_eq((*(*self.locals).names).values[i as usize], name) {
                return (*(*self.locals).wide_bits).values[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn lookup_local_wide_signed(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*(*self.locals).depths).values[i as usize] <= self.scope_depth && ir_name_eq((*(*self.locals).names).values[i as usize], name) {
                return (*(*self.locals).wide_signed).values[i as usize]
            }
            i = i - 1
        }
        0
    }

    // Sprint 228: Look up a function by name in the module. Returns (Lowerer, fn_id) where
    // fn_id >= 0 if found, -1 if not a known function.
    fn lookup_fn_by_name(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.fn_count {
            if ir_name_eq(ir_fn_get(&(*self.module), i).name, name) {
                return (self, i)
            }
            i = i + 1
        }
        (self, -1)
    }

    fn return_struct_name_for_fn_id(self, fn_id: i64) -> Name with Mut, Panic, Div, Alloc {
        if fn_id >= 0 && fn_id < self.module.fn_count {
            let fn_slot = ir_fn_get(&(*self.module), fn_id as usize)
            // <=, not ==: every sentinel at or below -2 means return_struct_name
            // describes a PART of a tuple return, not the return type itself.
            // Answering with it here is what would bind `let pair = f()` to the
            // slot's struct and let `pair.ok` resolve against the wrong layout.
            if fn_slot.return_fixed_array_len <= lower_tuple0_array_struct_return_sentinel() {
                return ir_empty_name()
            }
            return fn_slot.return_struct_name
        }
        ir_empty_name()
    }

    // Slot index carried by the tuple-slot sentinel, or -1 when the callee's
    // return metadata is not of that shape.
    fn return_tuple_struct_slot_for_fn_id(self, fn_id: i64) -> i64 with Mut, Panic, Div, Alloc {
        if fn_id >= 0 && fn_id < self.module.fn_count {
            let fn_slot = ir_fn_get(&(*self.module), fn_id as usize)
            let code = fn_slot.return_fixed_array_len
            if code <= lower_tuple_slot_struct_return_sentinel(0) {
                return lower_tuple_slot_struct_sentinel_slot(code)
            }
        }
        0 - 1
    }

    fn return_tuple_struct_name_for_fn_id(self, fn_id: i64) -> Name with Mut, Panic, Div, Alloc {
        if self.return_tuple_struct_slot_for_fn_id(fn_id) >= 0 {
            return ir_fn_get(&(*self.module), fn_id as usize).return_struct_name
        }
        ir_empty_name()
    }

    fn return_tuple0_array_elem_struct_name_for_fn_id(self, fn_id: i64) -> Name with Mut, Panic, Div, Alloc {
        if fn_id >= 0 && fn_id < self.module.fn_count {
            let fn_slot = ir_fn_get(&(*self.module), fn_id as usize)
            if fn_slot.return_fixed_array_len == lower_tuple0_array_struct_return_sentinel() {
                return fn_slot.return_struct_name
            }
        }
        ir_empty_name()
    }

    // #1475: word-scalar fixed-array element count of a call's declared return
    // type, or -1. Mirrors expr_call_return_struct_name_ref's callee resolution.
    fn expr_call_return_fixed_array_len_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind != ExprKind::ExprCall { return 0 - 1 }
        match (*expr).left {
            Some(callee_expr) => {
                var callee_name = ir_empty_name()
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee_name = (*callee_expr).name
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    let first = ir_path_first_name((*callee_expr).path)
                    let last = ir_path_last_name((*callee_expr).path)
                    if first.len > 0 && last.len > 0 && !ir_name_eq(first, last) {
                        callee_name = ir_mangle_method_name(first, last)
                    } else {
                        callee_name = first
                    }
                } else {
                    return 0 - 1
                }
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    return ir_fn_get(&(*self.module), fn_id as usize).return_fixed_array_len
                }
                0 - 1
            }
            None => 0 - 1,
        }
    }

    // The expr_call_return_* accessors around this each re-derive the callee's
    // fn_id with the same twelve lines. This is that resolution written once, for
    // the new readers; the existing three are left alone rather than churned into
    // this change.
    fn expr_call_callee_fn_id_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind != ExprKind::ExprCall { return 0 - 1 }
        match (*expr).left {
            Some(callee_expr) => {
                var callee_name = ir_empty_name()
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee_name = (*callee_expr).name
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    let first = ir_path_first_name((*callee_expr).path)
                    let last = ir_path_last_name((*callee_expr).path)
                    if first.len > 0 && last.len > 0 && !ir_name_eq(first, last) {
                        callee_name = ir_mangle_method_name(first, last)
                    } else {
                        callee_name = first
                    }
                } else {
                    return 0 - 1
                }
                lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
            }
            None => 0 - 1,
        }
    }

    fn expr_call_return_struct_name_ref(self, expr: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*expr).kind != ExprKind::ExprCall { return ir_empty_name() }
        match (*expr).left {
            Some(callee_expr) => {
                var callee_name = ir_empty_name()
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee_name = (*callee_expr).name
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    let first = ir_path_first_name((*callee_expr).path)
                    let last = ir_path_last_name((*callee_expr).path)
                    if first.len > 0 && last.len > 0 && !ir_name_eq(first, last) {
                        callee_name = ir_mangle_method_name(first, last)
                    } else {
                        callee_name = first
                    }
                } else {
                    return ir_empty_name()
                }
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                self.return_struct_name_for_fn_id(fn_id)
            }
            None => ir_empty_name(),
        }
    }

    fn expr_call_return_tuple0_array_elem_struct_name_ref(self, expr: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*expr).kind != ExprKind::ExprCall { return ir_empty_name() }
        match (*expr).left {
            Some(callee_expr) => {
                var callee_name = ir_empty_name()
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee_name = (*callee_expr).name
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    let first = ir_path_first_name((*callee_expr).path)
                    let last = ir_path_last_name((*callee_expr).path)
                    if first.len > 0 && last.len > 0 && !ir_name_eq(first, last) {
                        callee_name = ir_mangle_method_name(first, last)
                    } else {
                        callee_name = first
                    }
                } else {
                    return ir_empty_name()
                }
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                self.return_tuple0_array_elem_struct_name_for_fn_id(fn_id)
            }
            None => ir_empty_name(),
        }
    }

    fn fresh_reg(self) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            if lo.probe_mode {
                print("lower_probe: fresh_reg_invalid current_fn=")
                print_int(lo.current_fn)
                print(" fn_count=")
                print_int(lo.module.fn_count)
                print("\n")
            }
            let loe = lo.report_error_at(8959)
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let reg = (*current_func_box).reg_count
        (*current_func_box).reg_count = reg + 1
        lo.current_func = current_func_box
        (lo, reg)
    }

    fn fresh_wide_reg(self, limbs: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        if limbs <= 1 {
            return lo.fresh_reg()
        }
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error_at(8975)
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let reg = (*current_func_box).reg_count
        (*current_func_box).reg_count = reg + limbs
        lo.current_func = current_func_box
        (lo, reg)
    }

    fn expr_wide_bits_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind == ExprKind::ExprCast {
            let bits = lower_opt_type_wide_bits(&(*expr).cast_type)
            if bits > 64 { return bits }
            return self.expr_wide_bits_opt_ref(&(*expr).left)
        }
        if (*expr).kind == ExprKind::ExprIdent {
            return self.lookup_local_wide_bits((*expr).name)
        }
        if (*expr).kind == ExprKind::ExprBinary {
            let lb = self.expr_wide_bits_opt_ref(&(*expr).left)
            let rb = self.expr_wide_bits_opt_ref(&(*expr).right)
            if lb > 64 && lb == rb { return lb }
            if lb > 64 { return lb }
            if rb > 64 { return rb }
        }
        0
    }

    fn expr_wide_bits_opt_ref(self, opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(e) => self.expr_wide_bits_ref(&(*e)),
            None => 0,
        }
    }

    fn expr_wide_signed_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind == ExprKind::ExprCast {
            let signed = lower_opt_type_wide_signed(&(*expr).cast_type)
            if lower_opt_type_wide_bits(&(*expr).cast_type) > 64 { return signed }
            return self.expr_wide_signed_opt_ref(&(*expr).left)
        }
        if (*expr).kind == ExprKind::ExprIdent {
            return self.lookup_local_wide_signed((*expr).name)
        }
        if (*expr).kind == ExprKind::ExprBinary {
            return self.expr_wide_signed_opt_ref(&(*expr).left)
        }
        0
    }

    fn expr_wide_signed_opt_ref(self, opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(e) => self.expr_wide_signed_ref(&(*e)),
            None => 0,
        }
    }

    fn fresh_label(self) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error_at(9036)
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let label = (*current_func_box).label_count
        (*current_func_box).label_count = label + 1
        lo.current_func = current_func_box
        (lo, label)
    }

    fn emit(self, instr: IrInstr) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            if lo.probe_mode {
                print("lower_probe: emit_invalid current_fn=")
                print_int(lo.current_fn)
                print(" fn_count=")
                print_int(lo.module.fn_count)
                print("\n")
            }
            return lo.report_error_at(9056)
        }
        var current_func_box = lo.current_func
        // #1669: record float-ness on the FUNCTION, at the moment it is asserted,
        // instead of leaving it in the instruction stream where a later pass is
        // entitled to drop it. One site; all 70 ir_mark_float_reg emitters keep
        // their exact shape and get this for free.
        //
        // ANY instruction carrying the marker, not just IrNop. The first version
        // matched nops only and the proof run failed: a call returning f64 gets
        // the flag stamped on the CALL (`call_instr.imm_flags = ...`), and lowering
        // uses both channels. Narrowing to nops recorded the orphan facts and
        // silently missed every instruction-attached one.
        if instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG && instr.dst >= 0 {
            let _fb = ir_float_bits_set(&! (*current_func_box), instr.dst)
        }
        let instr_count = (*current_func_box).instr_count
        if instr_count < IR_MAX_INSTRS {
            ir_arena_store(ir_region_slot_w((*current_func_box).region, (instr_count)), instr)
            (*current_func_box).instr_count = instr_count + 1
            lo.current_func = current_func_box
            lo
        } else {
            // Unconditional, not probe_mode-gated. Dropping instructions here is
            // the #1586 failure: the tail of a function is simply not lowered, so
            // the program compiles, exits 0, and prints nothing after the cut.
            //
            // report_error_at(9070) below is NOT enough on its own: the Lowerer is
            // threaded by value and the flag gets discarded somewhere in the
            // chain while the truncation -- written through a Box -- survives.
            // IR_LOWER_HARD_ERROR is the durable channel that fixes that (#1645);
            // see its declaration. probe passes are excluded because they lower
            // speculatively and their result is meant to be thrown away.
            //
            // Counted here, REPORTED at the end of the function body (see
            // lowerer_lower_fn_item_mut). Reporting on the first drop could only
            // say "does not fit"; counting to the end says what the function
            // actually needed, which is the number anyone deciding the limit
            // needs to have.
            if !lo.probe_mode {
                IR_LOWER_HARD_ERROR = 1
                IR_LOWER_HARD_ERROR_REASON = 1
                // Record WHICH function and HOW MANY at the capacity site. The
                // end-of-body report in
                // lowerer_lower_fn_item_mut is richer but only runs on the path
                // that goes through it; this runs on every path.
                ir_copy_name_to_flat(&(*current_func_box).name, &! IR_LOWER_HARD_ERROR_FN_BUF, &! IR_LOWER_HARD_ERROR_FN_LEN)
                IR_LOWER_HARD_ERROR_LIMIT = IR_MAX_INSTRS
                IR_LOWER_HARD_ERROR_NEEDED = IR_MAX_INSTRS + IR_INSTR_OVERFLOW_COUNT + 1
            }
            IR_INSTR_OVERFLOW_COUNT = IR_INSTR_OVERFLOW_COUNT + 1
            lo.report_error_at(9093)
        }
    }

    fn emit_unit(self) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, 0))
        (lo2, reg)
    }

    fn intern_string(self, n: Name) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var i: i64 = 0
        while i < (*self.module).string_count {
            if ir_name_eq((*self.module).string_table[i as usize], n) {
                return (self, i)
            }
            i = i + 1
        }
        var lo = self
        if (*lo.module).string_count < IR_MAX_STRINGS {
            let idx = (*lo.module).string_count
            (*lo.module).string_table[idx as usize] = n
            (*lo.module).string_count = idx + 1
            (lo, idx)
        } else {
            let loe = lo.report_error_at(9120)
            (loe, -1)
        }
    }

    fn find_or_add_fn_id(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div, IO, Alloc {
        var i: i64 = 0
        while i < self.module.fn_count {
            if ir_name_eq(ir_fn_get(&(*self.module), i).name, name) {
                return (self, i)
            }
            i = i + 1
        }

        var lo = self
        if lo.module.fn_count < IR_MAX_FUNCS {
            let idx = (*lo.module).fn_count
            ir_fn_pool_ensure(&(*lo.module), idx)
            var new_fn = ir_empty_function()
            new_fn.name = name
            ir_function_alloc_region(&! new_fn)
            ir_fn_set(&! (*lo.module), idx as usize, new_fn)
            (*lo.module).fn_count = idx + 1
            (lo, idx)
        } else {
            let loe = lo.report_error_at(9143)
            (loe, -1)
        }
    }

    fn fn_ends_with_return(self) -> bool with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return false
        }
        let count = self.current_func.instr_count
        if count <= 0 {
            return false
        }
        let last = ir_arena_load(ir_region_slot_r(self.current_func.region, (count - 1)))
        last.op == IrOpcode::IrReturn
    }

    fn push_loop_labels(self, continue_label: i64, break_label: i64) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        if lo.loop_depth < 256 {
            // Store through an extracted single-level Box pointer: the two-level
            // nested stores `(*lo.loop_labels).break_labels[depth] = ...` are
            // discarded by the codegen (the same two-level-nested-store miscompile
            // that emptied enum_variants), so loop labels were never recorded and
            // every break/continue then failed current_break/continue_label and
            // reported an error (ir_bodies_failed) in both for and while loops.
            var ll_box = lo.loop_labels
            (*ll_box).continue_labels[lo.loop_depth as usize] = continue_label
            (*ll_box).break_labels[lo.loop_depth as usize] = break_label
            lo.loop_depth = lo.loop_depth + 1
            lo
        } else {
            lo.report_error_at(9175)
        }
    }

    fn pop_loop_labels(self) -> Lowerer with Mut {
        var lo = self
        if lo.loop_depth > 0 {
            lo.loop_depth = lo.loop_depth - 1
        }
        lo
    }

    fn current_break_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            (*self.loop_labels).break_labels[(self.loop_depth - 1) as usize]
        }
    }

    fn current_continue_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            (*self.loop_labels).continue_labels[(self.loop_depth - 1) as usize]
        }
    }

    // Phase 3.2: Proper struct field index lookup via layout table
    fn field_idx_from_name(self, struct_name: Name, field_name: Name) -> i64 with Mut, Panic, Div {
        // Search layout table for the struct
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, struct_name) {
                // Found struct — search its fields
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    }
                    fi = fi + 1
                }
                // Field not found in the named layout. Keep searching the rest
                // of the table before falling back to the legacy hash path;
                // partially seeded layouts must not collapse every miss to .0.
                var sj: i64 = 0
                // Same Knowledge-preseed shadow as field_idx_from_name_simple:
                // defer the synthetic layout so a user struct's own field wins.
                let kname = make_name("Knowledge")
                var kidx: i64 = -1
                while sj < (*self.struct_layouts).count {
                    let sj_is_knowledge = ir_name_eq((*self.struct_layouts).entries[sj as usize].type_name, kname)
                    var fj: i64 = 0
                    while fj < (*self.struct_layouts).entries[sj as usize].field_count {
                        if ir_name_eq(ir_name_at((*self.struct_layouts).entries[sj as usize].fields[fj as usize].name_id), field_name) {
                            if sj_is_knowledge {
                                if kidx < 0 {
                                    kidx = (*self.struct_layouts).entries[sj as usize].fields[fj as usize].index
                                }
                            } else {
                                return (*self.struct_layouts).entries[sj as usize].fields[fj as usize].index
                            }
                        }
                        fj = fj + 1
                    }
                    sj = sj + 1
                }
                if kidx >= 0 {
                    return kidx
                }
                if field_name.len <= 0 {
                    return 0
                }
                return (field_name.buf[0] as i64) % 64
            }
            si = si + 1
        }
        // Struct not in layout table — fallback: use first byte hash (legacy compat)
        if field_name.len <= 0 {
            0
        } else {
            (field_name.buf[0] as i64) % 64
        }
    }

    // Phase 3.2: Lookup struct field index without needing struct name
    // Used when we don't know the struct type at the call site
    fn field_idx_from_name_simple(self, n: Name) -> i64 with Mut, Panic, Div {
        // Try numeric field access first (.0, .1, .2, ...)
        let first_byte = n.buf[0] as i64
        if n.len == 1 && first_byte >= 48 && first_byte <= 57 {
            return first_byte - 48
        }
        // The synthetic "Knowledge" layout (ir_register_knowledge_layout) is
        // preseeded as entry 0, before any user struct is registered, and its
        // field names — value / variance / confidence — are ordinary user
        // identifiers. Scanned in table order it shadowed every user struct
        // carrying one of them, so `arr[i].value` resolved to Knowledge's slot 0
        // and silently clobbered whatever field really lives there. Defer it:
        // a user layout always wins, and Knowledge answers only if nothing else
        // does (genuine Knowledge<T> access through an untyped base).
        let knowledge_name = make_name("Knowledge")
        var knowledge_idx: i64 = -1
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            let is_knowledge = ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, knowledge_name)
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), n) {
                    if is_knowledge {
                        if knowledge_idx < 0 {
                            knowledge_idx = (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                        }
                    } else {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    }
                }
                fi = fi + 1
            }
            si = si + 1
        }
        if knowledge_idx >= 0 {
            return knowledge_idx
        }
        // Last-resort legacy compatibility for unregistered dynamic/foreign shapes.
        if n.len <= 0 {
            0
        } else {
            (n.buf[0] as i64) % 64
        }
    }

    fn field_idx_from_struct_literal_name(self, struct_name: Name, field_name: Name, default_idx: i64) -> i64 with Mut, Panic, Div {
        if struct_name.len <= 0 {
            return self.field_idx_from_name_simple(field_name)
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, struct_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    }
                    fi = fi + 1
                }
                return default_idx
            }
            si = si + 1
        }
        default_idx
    }

    // Name-only float heuristic. FIRST-MATCH was wrong: Knowledge.value (f64)
    // is preseeded early, so ANY later struct field named `value` (e.g.
    // Counter.value: i64) was mis-marked float → integer add became f64 add
    // and println printed IEEE bits (method_receiver_correct FAIL).
    // Require unanimous is_float==1 across ALL structs that share the name;
    // if any non-float match exists, refuse and let field_is_float_for_base_ref
    // decide from the typed base.
    fn field_is_float_by_name_simple(self, n: Name) -> bool with Mut, Panic, Div {
        var saw_float = false
        var saw_non_float = false
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), n) {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 1 {
                        saw_float = true
                    } else {
                        saw_non_float = true
                    }
                }
                fi = fi + 1
            }
            si = si + 1
        }
        if saw_float && !saw_non_float {
            return true
        }
        false
    }

    fn field_is_float_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 1
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    // Inner T of a `Box<T>` FIELD, or empty. Reads the slot the array-element
    // type would occupy; the Box test is on named_type_name_id, which still says
    // "Box", so this cannot answer for a plain array field.
    fn field_box_inner_type_for_struct(self, type_name: Name, field_name: Name) -> Name with Mut, Panic, Div {
        if type_name.len <= 0 { return ir_empty_name() }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        if ir_name_is_box(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id)) {
                            return ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].elem_type_name_id)
                        }
                        return ir_empty_name()
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        ir_empty_name()
    }

    fn field_named_type_for_struct(self, type_name: Name, field_name: Name) -> Name with Mut, Panic, Div {
        if type_name.len <= 0 { return ir_empty_name() }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id)
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        ir_empty_name()
    }

    // println i64-segfault fix: field analogue of field_is_float_by_name_simple,
    // testing the `is_float == 3` scalar-i64 marker set in register_struct_fields_ref.
    // Same unanimous rule: a name shared by int and non-int fields must not
    // force integer classification from name alone (base-typed lookup decides).
    fn field_is_int_by_name_simple(self, n: Name) -> bool with Mut, Panic, Div {
        var saw_int = false
        var saw_non_int = false
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), n) {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 3 {
                        saw_int = true
                    } else {
                        saw_non_int = true
                    }
                }
                fi = fi + 1
            }
            si = si + 1
        }
        if saw_int && !saw_non_int {
            return true
        }
        false
    }

    // println i64-segfault fix: field analogue of field_is_float_for_struct.
    fn field_is_int_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 3
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    // println i64-segfault fix: field analogue of field_is_float_for_base_ref.
    fn field_is_int_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    if self.field_is_int_for_struct(type_name, field_name) {
                        return true
                    }
                }
                false
            }
            _ => false,
        }
    }

    fn field_array_elem_is_float_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 2
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    fn field_array_elem_is_float_by_name_simple(self, field_name: Name) -> bool with Mut, Panic, Div {
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 2 {
                        return true
                    }
                }
                fi = fi + 1
            }
            si = si + 1
        }
        false
    }

    // Pointer-class lookup for a field OF A KNOWN STRUCT TYPE. Deliberately type-aware: a
    // by-NAME scan over every registered struct answers with the FIRST field of that name, so
    // two structs sharing a field name but differing in pointer-ness get the wrong answer.
    // A by-name version of this predicate existed briefly and was deleted rather than left
    // available, because its failure mode is a silent wrong value, not an error. Measured — a program with `HolderInline { inner: Inner }` declared
    // before `HolderBox { inner: Box<Inner> }` read hb.inner.a as 15922213421448 instead of
    // 7: the by-name scan found the INLINE `inner` first, reported "not a pointer", the deref
    // was not emitted, and a crash became a SILENT WRONG VALUE. Always resolve the receiver's
    // type first.
    fn field_is_pointer_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 4
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    fn field_is_pointer_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    return self.field_is_pointer_for_struct(type_name, field_name)
                }
                false
            }
            _ => false,
        }
    }

    // Box-specific variant: pointer class (is_float == 4) AND the declared type
    // name is the literal "Box". named_type_name_id holds "Box" for `f: Box<T>`
    // (a TypeNamed whose path starts with Box) and stays 0-empty for &T / &!T /
    // *mut T fields, which are not TypeNamed. This distinction is what lets an
    // explicit deref of a FIELD (`(*h.inner)`) route to the handle-resolved
    // field_get(0) only when the field really is a Box — routing a &T field
    // there would read through a raw address as a handle.
    fn field_is_box_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 4 && ir_name_is_box(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id))
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    fn field_is_box_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    return self.field_is_box_for_struct(type_name, field_name)
                }
                false
            }
            _ => false,
        }
    }

    fn field_is_float_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                let type_name = self.expr_receiver_struct_type_ref(&(*base_expr))
                if type_name.len > 0 && self.field_is_float_for_struct(type_name, field_name) {
                    return true
                }
                false
            }
            _ => false,
        }
    }

    fn field_idx_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                let type_name = self.expr_receiver_struct_type_ref(&(*base_expr))
                if type_name.len > 0 {
                    return self.field_idx_from_name(type_name, field_name)
                }
                self.field_idx_from_name_simple(field_name)
            }
            _ => self.field_idx_from_name_simple(field_name),
        }
    }

    fn field_array_elem_is_float_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(owner_expr) => {
                let type_name = self.expr_receiver_struct_type_ref(&(*owner_expr))
                if type_name.len > 0 {
                    // When the owner local has a known struct type, trust THAT
                    // layout only. Cross-struct by-name fallback poisons
                    // CDElementExact{,__i64}.c (i64 / generic F) via CDElement.c
                    // (f64 array, is_float=2) once both live in one specialized
                    // collapse module — Wave12 cd_exact residual: index lower
                    // marks i64 component loads as float (field_array_float=1).
                    return self.field_array_elem_is_float_for_struct(type_name, field_name)
                }
                self.field_array_elem_is_float_by_name_simple(field_name)
            }
            _ => self.field_array_elem_is_float_by_name_simple(field_name),
        }
    }

    // Scalar kind for a module-level BSS global identified by name.
    // Returns 2 for `var G: f64`, 1 for word-size integer scalars, else 0.
    // Locals already carry scalar_kind; this is the print/println dispatch
    // fallback that #1325 did for array-element indexing only.
    fn bss_global_scalar_kind(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, name)
        if fn_id < 0 {
            return 0
        }
        if fn_id >= self.module.fn_count {
            return 0
        }
        if ir_fn_get(&(*self.module), fn_id as usize).compile_strategy != IR_STRATEGY_BSS_GLOBAL {
            return 0
        }
        // Aggregate bases (arrays/structs) are not print scalars.
        // Packed [i8;N]/[u8;N] can have bss_size ≤ 8 — use hyper kind too (#1353).
        // Type-table array kinds (incl. [T;1]) are also non-scalar (#1350).
        let gkind = lower_global_type_table_lookup(&(*self.global_types), fn_id)
        if lower_bss_slot_is_aggregate(
            ir_fn_get(&(*self.module), fn_id as usize).bss_size,
            ir_fn_get(&(*self.module), fn_id as usize).hyper_algebra_kind
        ) || lower_global_kind_is_array_base(gkind) {
            return 0
        }
        if gkind == LOWER_GLOBAL_SCALAR_F64 {
            return 2
        }
        if gkind == LOWER_GLOBAL_SCALAR_I64 {
            return 1
        }
        0
    }

    fn index_base_elem_is_float_ref(self, base_opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    if self.lookup_local_array_elem_float((*base_expr).name) {
                        return true
                    }
                    // Module-level `var F: [f64; N]`: not always bound as a local with
                    // array_elem_float=1. Fall back to the preseed global type table so
                    // `print(F[i])` routes to print_f64 (IEEE bits → dtoa) instead of
                    // print_int (raw bit pattern as decimal).
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, (*base_expr).name)
                    if fn_id >= 0 {
                        let gkind = lower_global_type_table_lookup(&(*self.global_types), fn_id)
                        if gkind == LOWER_GLOBAL_ELEM_F64 {
                            return true
                        }
                    }
                    return false
                }
                if (*base_expr).kind == ExprKind::ExprFieldAccess {
                    return self.field_array_elem_is_float_for_base_ref(&(*base_expr).left, (*base_expr).name)
                }
                if (*base_expr).kind == ExprKind::ExprUnary && (*base_expr).un_op == UnaryOp::OpDeref {
                    return self.index_base_elem_is_float_ref(&(*base_expr).left)
                }
                false
            }
            _ => false,
        }
    }

    fn field_array_elem_type_name_for_struct(self, type_name: Name, field_name: Name) -> Name with Mut, Panic, Div {
        if type_name.len <= 0 { return ir_empty_name() }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
                        // elem_type_name_id now also carries the inner T of a
                        // `Box<T>` field. This asks for an ARRAY element type, so
                        // a Box answer would be a new claim where the answer used
                        // to be empty. Keep it empty: this reader's behaviour is
                        // unchanged by the widening, deliberately.
                        if ir_name_is_box(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].named_type_name_id)) {
                            return ir_empty_name()
                        }
                        return ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].elem_type_name_id)
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        ir_empty_name()
    }

    fn field_array_elem_type_name_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> Name with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(owner_expr) => {
                let type_name = self.expr_receiver_struct_type_ref(&(*owner_expr))
                if type_name.len > 0 {
                    return self.field_array_elem_type_name_for_struct(type_name, field_name)
                }
                ir_empty_name()
            }
            _ => ir_empty_name(),
        }
    }

    // Receiver layout for a field access. Array indexing preserves the element
    // layout, including an array reached through another field access such as
    // `candidates[0].buffers[0]`.
    fn expr_receiver_struct_type_ref(self, expr: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*expr).kind == ExprKind::ExprIdent {
            return self.lookup_local_struct_type((*expr).name)
        }
        if (*expr).kind == ExprKind::ExprIndex {
            match (*expr).left {
                Some(indexed) => {
                    if (*indexed).kind == ExprKind::ExprIdent {
                        let indexed_type = self.lookup_local_struct_type((*indexed).name)
                        if ir_name_eq(indexed_type, make_name("Seq")) {
                            return self.lookup_local_index_elem_struct_type((*indexed).name)
                        }
                        return indexed_type
                    }
                    if (*indexed).kind == ExprKind::ExprFieldAccess {
                        return self.field_array_elem_type_name_for_base_ref(&(*indexed).left, (*indexed).name)
                    }
                }
                _ => {}
            }
        }
        // `(*p).field` -- the field's owner is a DEREF, and this resolver had no
        // ExprUnary arm (its sibling lower_method_recv_type got one in #2313).
        // Measured: 140 of 142 unresolved field receivers report owner=<none>,
        // and fldty=<none> follows from it -- field_named_type_for_struct returns
        // empty on an empty type name, so the two were never independent.
        if (*expr).kind == ExprKind::ExprUnary && (*expr).un_op == UnaryOp::OpDeref {
            match (*expr).left {
                Some(operand) => {
                    if (*operand).kind == ExprKind::ExprIdent {
                        let ost = self.lookup_local_struct_type((*operand).name)
                        if ir_name_is_box(ost) {
                            let bl = lower_lookup_box_inner_layout(self.locals, self.scope_depth, (*operand).name)
                            if bl >= 0 && bl < (*self.struct_layouts).count {
                                return (*self.struct_layouts).entries[bl as usize].type_name
                            }
                            return ir_empty_name()
                        }
                        return ost
                    }
                    return self.expr_receiver_struct_type_ref(&(*operand))
                }
                _ => {}
            }
            return ir_empty_name()
        }
        // `pair.0.method()` -- the receiver is a TUPLE SLOT, not a named field.
        // The field-access arm below asks field_named_type_for_struct for a field
        // literally called "0", which no struct has, so it answered empty and the
        // method call fell to the BARE name. #2291 already records the slot's
        // struct on the tuple local; that record was read at the let binding and
        // nowhere else. This is the same lookup, one consumer over -- the third
        // time in this stack that machinery existed and simply was not asked.
        if (*expr).kind == ExprKind::ExprFieldAccess {
            let tix = lower_name_tuple_index((*expr).name)
            if tix >= 0 {
                match (*expr).left {
                    Some(tb) => {
                        if (*tb).kind == ExprKind::ExprIdent {
                            let tl = self.lookup_local_tuple_struct_layout((*tb).name, tix)
                            if tl >= 0 && tl < (*self.struct_layouts).count {
                                return (*self.struct_layouts).entries[tl as usize].type_name
                            }
                        }
                    }
                    _ => {}
                }
            }
        }
        if (*expr).kind == ExprKind::ExprFieldAccess {
            match (*expr).left {
                Some(owner) => {
                    let owner_type = self.expr_receiver_struct_type_ref(&(*owner))
                    let named = self.field_named_type_for_struct(owner_type, (*expr).name)
                    // `self.module.fn_count` is where this mattered. The recursion
                    // above already resolved the owner to Lowerer correctly; it
                    // then stopped at the literal "Box", the declared type of
                    // `module: Box<IrModule>`, which names no layout. The caller
                    // reads a non-empty name as TYPED, so field_idx_for_base_ref
                    // called field_idx_from_name("Box", "fn_count"), found no such
                    // layout, and fell through to the cross-struct first-match
                    // scan. `fn_count` is index 1 in IrModule and index 2 in four
                    // other structs (HlirModule, CompilerIrRoundtripResult,
                    // A64PreviewCompiler x2), so the loop bound in
                    // find_or_add_fn_id was read from `string_table` -- a value
                    // large enough that the scan could never end. It walked the
                    // 16384-entry function array and dereferenced the first word
                    // past it. That is the gen2 SIGSEGV at module 7.
                    //
                    // Unwrapping the Box here is the whole repair. Falling back to
                    // `named` keeps every other chain exactly as it was.
                    if ir_name_is_box(named) {
                        let inner = self.field_box_inner_type_for_struct(owner_type, (*expr).name)
                        if inner.len > 0 {
                            return inner
                        }
                    }
                    return named
                }
                None => {}
            }
        }
        ir_empty_name()
    }

    fn index_base_elem_struct_type_ref(self, base_opt: &Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    if ir_name_eq(self.lookup_local_struct_type((*base_expr).name), make_name("Seq")) {
                        return self.lookup_local_index_elem_struct_type((*base_expr).name)
                    }
                }
                if (*base_expr).kind == ExprKind::ExprFieldAccess {
                    return self.field_array_elem_type_name_for_base_ref(&(*base_expr).left, (*base_expr).name)
                }
                ir_empty_name()
            }
            _ => ir_empty_name(),
        }
    }

    fn opt_expr_result_is_float_ref(self, opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(expr) => self.expr_result_is_float_ref(&(*expr)),
            _ => false,
        }
    }

    // String-ness of an expression result, for routing `+`/`++` on strings to the
    // str_concat builtin (string locals are tracked with scalar_kind 3) AND for
    // routing `s[i]` to raw-byte IndexGet (label_id=3) instead of the GC-handle
    // array path that SIGSEGVs on packed *u8 from read_file/str_from_bytes.
    fn opt_expr_result_is_string_ref(self, opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(expr) => self.expr_result_is_string_ref(&(*expr)),
            _ => false,
        }
    }

    fn expr_result_is_string_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprStringLit {
            return true
        }
        if (*e).kind == ExprKind::ExprIdent {
            if self.lookup_local_scalar_kind((*e).name) == 3 {
                return true
            }
            // Parameter binding records its declared named type even on paths
            // where scalar_kind is reserved for numeric dispatch. `string` and
            // `&string` therefore remain positive evidence, not kind-0 guesses.
            return lower_name_is_string_type(self.lookup_local_struct_type((*e).name))
        }
        // `base.field` where the field is declared `string`. Ten of the fifteen
        // println-poison refusals in a self-compile are this shape --
        // `frontend_result.error_msg`, `trace.last_stage`, `opts.output_file`,
        // `closure.parse_failed_path`, `lowered.unsupported_detail` -- and the
        // classifier had no case for it at all, so a plainly-typed string field
        // reached the print dispatcher with scalar kind 0 and the lowering
        // refused rather than guess.
        if (*e).kind == ExprKind::ExprFieldAccess {
            match (*e).left {
                Some(base_expr) => {
                    if (*base_expr).kind == ExprKind::ExprIdent {
                        let base_type = self.lookup_local_struct_type((*base_expr).name)
                        if lower_name_is_string_type(self.struct_layout_field_named_type(base_type, (*e).name)) {
                            return true
                        }
                    }
                    // `pair.K.field`: the base is itself a TUPLE SLOT access, so
                    // the ident case above cannot fire -- the slot's struct type is
                    // not the local's type. It is recorded at the bind instead, from
                    // the callee's declared return type, and this reads it back.
                    // The recorded slot must EQUAL K, so `pair.0.x` on
                    // `(bool, Result)` still refuses instead of borrowing slot 1.
                    if (*base_expr).kind == ExprKind::ExprFieldAccess {
                        let slot = lower_name_tuple_index((*base_expr).name)
                        if slot >= 0 {
                            match (*base_expr).left {
                                Some(tuple_base) => {
                                    if (*tuple_base).kind == ExprKind::ExprIdent {
                                        let slot_layout = self.lookup_local_tuple_struct_layout((*tuple_base).name, slot)
                                        if slot_layout >= 0 && slot_layout < (*self.struct_layouts).count {
                                            let slot_type = (*self.struct_layouts).entries[slot_layout as usize].type_name
                                            if lower_name_is_string_type(self.struct_layout_field_named_type(slot_type, (*e).name)) {
                                                return true
                                            }
                                        }
                                    }
                                }
                                None => {}
                            }
                        }
                    }
                }
                None => {}
            }
        }
        if (*e).kind == ExprKind::ExprIf {
            return self.opt_block_tail_is_string_ref(&(*e).block) || self.opt_expr_result_is_string_ref(&(*e).else_expr)
        }
        // `base.field[i]` where the field is declared `[string; N]`. The last
        // println-poison refusal in a gen2 self-compile is this shape:
        // `let file_path = work_imports.paths[dep_i]` then `print(file_path)`,
        // with `paths: [string; 256]`. The let-binding below already asks this
        // function and binds kind 3 on a yes; it had no ExprIndex case to say so.
        //
        // POSITIVE only: the element type must be declared `string`. The integer
        // classifier defaults ANY non-float index to kind 1, so a symmetric
        // "index means string" here would send an i64 element to the char*
        // printer and strlen would dereference it -- the exact fault this whole
        // family of refusals exists to prevent. elem_type_name_id already carries
        // the declared element type; nothing read it for string-ness.
        if (*e).kind == ExprKind::ExprIndex {
            match (*e).left {
                Some(indexed) => {
                    if (*indexed).kind == ExprKind::ExprFieldAccess {
                        if lower_name_is_string_type(self.field_array_elem_type_name_for_base_ref(&(*indexed).left, (*indexed).name)) {
                            return true
                        }
                    }
                }
                None => {}
            }
        }
        if (*e).kind == ExprKind::ExprBinary {
            if (*e).bin_op == BinaryOp::OpAdd || (*e).bin_op == BinaryOp::OpConcat {
                return self.opt_expr_result_is_string_ref(&(*e).left) || self.opt_expr_result_is_string_ref(&(*e).right)
            }
        }
        // Packed-string producers: read_file / str_from_bytes / str_concat /
        // str_slice / get_arg, plus any user fn whose return_struct_name is
        // "string". Builtins are TyUnknown at check time, so `raw[i]` on their
        // result was allowed by the checker and then mis-lowered as an array.
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    if lower_name_is_packed_string_producer(callee_name) {
                        return true
                    }
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                    if fn_id >= 0 && fn_id < self.module.fn_count {
                        if lower_name_is_string_type(ir_fn_get(&(*self.module), fn_id as usize).return_struct_name) {
                            return true
                        }
                    }
                }
                None => {}
            }
        }
        false
    }

    // #1502: tuple-slot float-ness for `base.N`, from the mask recorded on the
    // tuple-typed local at its binding site.
    fn opt_base_tuple_float_mask_ref(self, base_opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    return self.lookup_local_tuple_float_mask((*base_expr).name)
                }
                // `mk().1` with no intervening binding: take the mask straight off
                // the callee's encoded return code.
                if (*base_expr).kind == ExprKind::ExprCall {
                    match (*base_expr).left {
                        Some(callee_expr) => {
                            let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                            let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                            if fn_id >= 0 && fn_id < self.module.fn_count {
                                let code = ir_fn_get(&(*self.module), fn_id as usize).returns_float
                                if code >= 1024 {
                                    return code - 1024
                                }
                            }
                            0
                        }
                        _ => 0,
                    }
                } else {
                    0
                }
            }
            _ => 0,
        }
    }

    // Findings 11 (#2084): `opt_expr_is_unsigned_int_ref` walks an expression to
    // determine whether it is a u8/u16/u32/u64/usize-typed result. Used as one
    // half of the "both operands unsigned?" gate in lower_binary_expr_ref that
    // decides whether to emit OpUDiv/OpURem/OpUShr instead of OpDiv/OpRem/OpShr.
    //
    // Coverage matrix mirrors the cases of expr_result_is_float_ref:
    //   - ExprCast with cast_type = u8/u16/u32/u64/usize → true
    //   - ExprIdent whose local was bound with such a type        → true
    //   - ExprBinary                                            → propagate from left
    //   - everything else (IntLit, FloatLit, BoolLit, StringLit) → false
    //
    // A boolean-literal, integer-literal, or float-literal CANNOT carry
    // width+sign info at this lowering level — the only way a literal
    // becomes unsigned is via an enclosing `as u64` cast, which lowers to
    // the ExprCast case above.
    fn opt_expr_is_unsigned_int_ref(self, opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(expr) => self.expr_is_unsigned_int_ref(&(*expr)),
            None => false,
        }
    }

    fn expr_is_unsigned_int_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprCast {
            return lower_cast_type_is_unsigned_int(&(*e).cast_type)
        }
        if (*e).kind == ExprKind::ExprIdent {
            return self.lookup_local_is_unsigned_int((*e).name) == 1
        }
        // An integer literal standing alone has no width/sign of its own; the
        // textual parser writes ExprIntLit with no typed annotation. We leave
        // this case as `false` here and let the binary-op call site ASK the
        // contextual question ("is the OTHER operand unsigned, and this is a
        // bare integer literal?") -- that is handled in
        // lower_binary_expr_ref via expr_is_int_literal_ref and the
        // `is_unsigned_or_intlit_paired_with_unsigned` semantics applied
        // there. Returning false here keeps the helper from overclaiming on
        // expressions that have no operand context at all.
        if (*e).kind == ExprKind::ExprBinary {
            // The result of an integer binary expression on unsigned operands is
            // unsigned (modulo a signed widening cast on a sibling — out of
            // scope for now since the unsigned flag we track propagates from
            // the literal binding via let-typed locals; a nested let n: u64 =
            // foo() + bar() will be re-tagged when the inner if-let lands).
            return self.opt_expr_is_unsigned_int_ref(&(*e).left)
        }
        false
    }

    fn expr_result_is_float_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprIntLit {
            return false
        }
        if (*e).kind == ExprKind::ExprBoolTrue || (*e).kind == ExprKind::ExprBoolFalse {
            return false
        }
        if (*e).kind == ExprKind::ExprStringLit {
            return false
        }
        if (*e).kind == ExprKind::ExprFloatLit {
            return true
        }
        if (*e).kind == ExprKind::ExprIdent {
            if self.lookup_local_scalar_kind((*e).name) == 2 {
                return true
            }
            // Module-level `var G: f64` is a BSS slot, not a local with scalar_kind=2.
            // Without this fallback, `print(G)` stays on the char* printer and SEGVs
            // (array path already falls back via index_base_elem_is_float_ref).
            return self.bss_global_scalar_kind((*e).name) == 2
        }
        if (*e).kind == ExprKind::ExprCast {
            return lower_cast_type_is_f64(&(*e).cast_type)
        }
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    if self.name_is_variance_of(callee_name)
                        || self.name_is_uncertainty_of(callee_name)
                        || self.name_is_sensitivity_of(callee_name)
                        || self.name_is_second_order_mean(callee_name)
                        || self.name_is_hessian_of(callee_name) {
                        return true
                    }
                    if (*callee_expr).kind == ExprKind::ExprIdent {
                        if self.lookup_local_fn_ptr_ret_float((*callee_expr).name) {
                            return true
                        }
                    }
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                    if fn_id >= 0 && fn_id < self.module.fn_count {
                        return ir_fn_get(&(*self.module), fn_id as usize).returns_float == 1
                    }
                }
                None => {}
            }
            return false
        }
        // print(e.val()) / method results: same returns_float lookup as ExprCall.
        if (*e).kind == ExprKind::ExprMethodCall {
            let recv_type = self.lower_method_recv_type(&(*e).left)
            let call_name = if recv_type.len > 0 {
                ir_mangle_method_name(recv_type, (*e).name)
            } else {
                (*e).name
            }
            let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, call_name)
            if fn_id >= 0 && fn_id < self.module.fn_count {
                return ir_fn_get(&(*self.module), fn_id as usize).returns_float == 1
            }
            return false
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            // #1502: a tuple slot (`s.1`) is NOT a named struct field -- both lookups
            // below resolve by name against struct_layouts, so "1" matched nothing and
            // an f64 slot was misclassified as integer. Consult the tuple mask first.
            let tuple_idx = lower_name_tuple_index((*e).name)
            if tuple_idx >= 0 {
                let tuple_mask = self.opt_base_tuple_float_mask_ref(&(*e).left)
                if tuple_mask != 0 {
                    return (tuple_mask >> (tuple_idx as i32)) % 2 == 1
                }
            }
            if self.field_is_float_for_base_ref(&(*e).left, (*e).name) || self.field_is_float_by_name_simple((*e).name) {
                return true
            }
            // Tuple unpack: base is float-element local (`let __tup = ret_pair()`
            // with returns_float=2) → `.0`/`.1` are f64.
            match (*e).left {
                Some(be) => {
                    if (*be).kind == ExprKind::ExprIdent {
                        if self.lookup_local_array_elem_float((*be).name) {
                            return true
                        }
                    }
                }
                _ => {}
            }
            return false
        }
        if (*e).kind == ExprKind::ExprIndex {
            return self.index_base_elem_is_float_ref(&(*e).left)
        }
        if (*e).kind == ExprKind::ExprBinary {
            if lower_binary_op_is_compare((*e).bin_op) {
                return false
            }
            return self.opt_expr_result_is_float_ref(&(*e).left) || self.opt_expr_result_is_float_ref(&(*e).right)
        }
        if (*e).kind == ExprKind::ExprUnary {
            if (*e).un_op == UnaryOp::OpNeg {
                return self.opt_expr_result_is_float_ref(&(*e).left)
            }
            return false
        }
        // An if-expression yields a float if either arm yields a float. Native
        // codegen types the merge register flow-insensitively (last linear write
        // wins), and an f64 literal arm (e.g. `else { 0.0 }`) lowers to IrLoadImm
        // (int-flagged), so without this case `let k = if c { a/b } else { 0.0 }`
        // leaves `k` untyped and a downstream `acc + k` cvtsi2sd-corrupts the bits.
        if (*e).kind == ExprKind::ExprIf {
            return self.opt_block_tail_is_float_ref(&(*e).block) || self.opt_expr_result_is_float_ref(&(*e).else_expr)
        }
        false
    }

    // True iff the block's value (its trailing expression statement) yields a
    // float. A block whose last statement is a let/var/assign yields unit → false.
    fn opt_block_tail_is_float_ref(self, blk_opt: &Option<Box<Block>>) -> bool with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(blk) => self.block_tail_is_float_ref(&(*blk)),
            _ => false,
        }
    }

    fn block_tail_is_float_ref(self, blk: &Block) -> bool with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = false
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_result_is_float_ref(&stmt_ref.expr)
                    } else {
                        result = false
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    // The string twin of block_tail_is_float_ref, written the same way on purpose:
    // an if-expression yields the value of its block's trailing expression, and
    // `let s = if c { "true" } else { "false" }` had no case anywhere, so `s`
    // reached the print dispatcher as kind 0.
    fn block_tail_is_string_ref(self, blk: &Block) -> bool with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = false
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_result_is_string_ref(&stmt_ref.expr)
                    } else {
                        result = false
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    fn opt_block_tail_is_string_ref(self, blk_opt: &Option<Box<Block>>) -> bool with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(blk) => self.block_tail_is_string_ref(&(*blk)),
            _ => false,
        }
    }
    // The fn_id a block's TAIL expression calls, when that tail is a method
    // call. -1 otherwise. Mirrors block_tail_is_string_ref: walk to the last
    // statement, and only an expression statement can carry the value.
    fn block_tail_method_fn_id(self, blk: &Block) -> i64 with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = 0 - 1
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_method_fn_id(&stmt_ref.expr)
                    } else {
                        result = 0 - 1
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    fn opt_block_tail_method_fn_id(self, blk_opt: &Option<Box<Block>>) -> i64 with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(blk) => self.block_tail_method_fn_id(&(*blk)),
            _ => 0 - 1,
        }
    }

    fn opt_expr_method_fn_id(self, e_opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *e_opt {
            Some(e) => self.expr_method_fn_id(&(*e)),
            _ => 0 - 1,
        }
    }

    // An `else { ... }` arrives as an ExprBlock, so the tail has to be reached
    // through it; anything that is not ultimately a method call answers -1.
    fn expr_method_fn_id(self, e: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprBlock {
            return self.opt_block_tail_method_fn_id(&(*e).block)
        }
        // A FREE call names a function too. Only method syntax was answered
        // here, so a branch whose arm is `f(...)` went silent and sank the
        // whole set even when every other arm agreed.
        if (*e).kind == ExprKind::ExprCall {
            return self.expr_call_callee_fn_id_ref(e)
        }
        if (*e).kind != ExprKind::ExprMethodCall {
            return 0 - 1
        }
        let recv_type = self.lower_method_recv_type(&(*e).left)
        let call_name = if recv_type.len > 0 {
            ir_mangle_method_name(recv_type, (*e).name)
        } else {
            (*e).name
        }
        lowerer_lookup_fn_id_by_name_ref(&self, call_name)
    }
    // The named struct a plain expression evaluates to, for the ONE use below:
    // naming the struct that sits in slot 0 of a tuple literal.
    fn expr_direct_struct_name(self, e: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprIdent {
            return self.lookup_local_struct_type((*e).name)
        }
        let fid = self.expr_method_fn_id(e)
        if fid >= 0 {
            return self.return_struct_name_for_fn_id(fid)
        }
        ir_empty_name()
    }

    // The named struct held by SLOT 0 of whatever this expression evaluates to,
    // or empty when that cannot be answered.
    //
    // A local is typed from a hand-written enum of initializer shapes, and the
    // shapes that PRODUCE a tuple are themselves a small grammar: a method call,
    // a tuple literal, a block, an if, a match. Answering only the first two
    // left `var lo = pair.0` untyped whenever `pair` came from a branch, and an
    // untyped receiver lowers its calls against the bare method name.
    fn expr_tuple0_struct_name(self, e: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprBlock {
            return self.opt_block_tail_tuple0_struct_name(&(*e).block)
        }
        // A branch arm is often just the pair a previous statement already
        // bound -- `if cond { seeded_pair } else { f(...) }`. That local
        // carries the slot layout; reading it back is what lets the arms
        // agree instead of one of them going silent.
        if (*e).kind == ExprKind::ExprIdent {
            let id_layout = self.lookup_local_tuple_struct_layout((*e).name, 0)
            if id_layout >= 0 && id_layout < (*self.struct_layouts).count {
                return (*self.struct_layouts).entries[id_layout as usize].type_name
            }
            return ir_empty_name()
        }
        if (*e).kind == ExprKind::ExprTupleLit {
            match (*e).args {
                Some(lst) => return self.expr_direct_struct_name(&(*lst).head),
                _ => return ir_empty_name(),
            }
        }
        if (*e).kind == ExprKind::ExprIf {
            let t = self.opt_block_tail_tuple0_struct_name(&(*e).block)
            let f = self.opt_expr_tuple0_struct_name(&(*e).else_expr)
            if t.len > 0 && ir_name_eq(t, f) {
                return t
            }
            return ir_empty_name()
        }
        if (*e).kind == ExprKind::ExprMatch {
            // Every arm must answer the same, and a single silent arm sinks it:
            // binding from the arms that agree would type the local by which
            // branch happened to be written, and a wrong type is a wrong call
            // target where an absent one is only a refusal.
            var cur = &(*e).arms
            var acc = ir_empty_name()
            var first = true
            var ok = true
            while true {
                match *cur {
                    Some(al) => {
                        let got = self.expr_tuple0_struct_name(&(*al).head.body)
                        if first {
                            acc = got
                            first = false
                        } else {
                            if !ir_name_eq(got, acc) { ok = false }
                        }
                        cur = &(*al).tail
                    }
                    _ => break
                }
            }
            if ok && acc.len > 0 {
                return acc
            }
            return ir_empty_name()
        }
        let fid = self.expr_method_fn_id(e)
        if fid >= 0 {
            if self.return_tuple_struct_slot_for_fn_id(fid) == 0 {
                return self.return_tuple_struct_name_for_fn_id(fid)
            }
        }
        ir_empty_name()
    }

    fn opt_expr_tuple0_struct_name(self, e_opt: &Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match *e_opt {
            Some(e) => self.expr_tuple0_struct_name(&(*e)),
            _ => ir_empty_name(),
        }
    }

    fn opt_block_tail_tuple0_struct_name(self, blk_opt: &Option<Box<Block>>) -> Name with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(blk) => self.block_tail_tuple0_struct_name(&(*blk)),
            _ => ir_empty_name(),
        }
    }

    // SECOND PASS, scoped to one block.
    //
    // A branch tail very often names a local that the SAME branch declares:
    //
    //     ExprKind::ExprIdent => {
    //         var c2 = c
    //         (c2, ident_ty)          <- the tail names c2
    //     }
    //
    // The resolver walks the AST without lowering the arm, so c2 is not in the
    // local stack and has no layout to read. The arm then answers empty, and
    // because every arm must agree, ONE silent arm in thirty-three answers
    // empty for the whole match. Rather than lower the block twice, look the
    // name up in the block's own declarations and resolve THAT initializer.
    fn block_decl_direct_struct_name(self, blk: &Block, name: Name) -> Name with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = ir_empty_name()
        while true {
            match *current {
                Some(list) => {
                    let st = &(*list).head
                    if st.kind == StmtKind::StmtLet || st.kind == StmtKind::StmtVar {
                        if ir_name_eq(st.name, name) && !self.opt_expr_is_ident_named(&st.expr, name) {
                            result = self.opt_expr_direct_struct_name(&st.expr)
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    fn block_decl_tuple0_struct_name(self, blk: &Block, name: Name) -> Name with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = ir_empty_name()
        while true {
            match *current {
                Some(list) => {
                    let st = &(*list).head
                    if st.kind == StmtKind::StmtLet || st.kind == StmtKind::StmtVar {
                        if ir_name_eq(st.name, name) && !self.opt_expr_is_ident_named(&st.expr, name) {
                            result = self.opt_expr_tuple0_struct_name(&st.expr)
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    // `var x = x` would send the two scanners above back into themselves.
    // Nothing else can: every other initializer shape descends into the AST.
    fn opt_expr_is_ident_named(self, e_opt: &Option<Box<Expr>>, name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *e_opt {
            Some(e) => (*e).kind == ExprKind::ExprIdent && ir_name_eq((*e).name, name),
            _ => false,
        }
    }

    fn opt_expr_direct_struct_name(self, e_opt: &Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match *e_opt {
            Some(e) => self.expr_direct_struct_name(&(*e)),
            _ => ir_empty_name(),
        }
    }

    // The declaring block need not be the naming one. In
    // check_audit_attach_expr_expected the pair is introduced by one block and
    // named by a branch INSIDE it:
    //
    //     let seeded_pair = if ... { ... } else { ... }
    //     if seeded_pair.1.kind == TyError { seeded_pair } else { ... }
    //                                        ^ named here, declared above
    //
    // So the scan descends through blocks, ifs and matches while resolving
    // every ident it meets against the block passed IN -- the enclosing scope
    // that may declare it -- rather than against whichever block it lands in.
    fn block_tail_via_block(self, blk: &Block, outer: &Block) -> Name with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = ir_empty_name()
        while true {
            match *current {
                Some(list) => {
                    let st = &(*list).head
                    if st.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_tuple0_struct_name_via_block(&st.expr, outer)
                    } else {
                        result = ir_empty_name()
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    fn opt_block_tail_via_block(self, blk_opt: &Option<Box<Block>>, outer: &Block) -> Name with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(b) => self.block_tail_via_block(&(*b), outer),
            _ => ir_empty_name(),
        }
    }

    // Receiver type with the BLOCK in scope.
    //
    // lower_method_recv_type answers from the local stack, and by the time the
    // slot-0 resolver runs, lower_block_ref has already truncated away every
    // local the initializer's own blocks declared. So `seeded_pair.0.method()`
    // finds nothing and lowers against the bare name.
    //
    // A sibling rather than a change to lower_method_recv_type: that one is
    // consulted everywhere, and this question only arises on the via-block path.
    fn recv_type_via_block(self, left: &Option<Box<Expr>>, blk: &Block) -> Name with Mut, Panic, Div, Alloc {
        match *left {
            Some(r) => {
                if (*r).kind == ExprKind::ExprIdent {
                    let d = self.block_decl_direct_struct_name(blk, (*r).name)
                    if d.len > 0 {
                        return d
                    }
                }
                if (*r).kind == ExprKind::ExprFieldAccess {
                    if lower_name_tuple_index((*r).name) == 0 {
                        match (*r).left {
                            Some(b) => {
                                if (*b).kind == ExprKind::ExprIdent {
                                    let d2 = self.block_decl_tuple0_struct_name(blk, (*b).name)
                                    if d2.len > 0 {
                                        return d2
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                self.lower_method_recv_type(left)
            }
            _ => ir_empty_name(),
        }
    }

    fn expr_tuple0_struct_name_via_block(self, e: &Expr, blk: &Block) -> Name with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprBlock {
            return self.opt_block_tail_via_block(&(*e).block, blk)
        }
        if (*e).kind == ExprKind::ExprIf {
            let t = self.opt_block_tail_via_block(&(*e).block, blk)
            let f = self.opt_expr_tuple0_struct_name_via_block(&(*e).else_expr, blk)
            if t.len > 0 && ir_name_eq(t, f) {
                return t
            }
            return ir_empty_name()
        }
        if (*e).kind == ExprKind::ExprMatch {
            var cur = &(*e).arms
            var acc = ir_empty_name()
            var first = true
            var ok = true
            while true {
                match *cur {
                    Some(al) => {
                        let got = self.expr_tuple0_struct_name_via_block(&(*al).head.body, blk)
                        if first {
                            acc = got
                            first = false
                        } else {
                            if !ir_name_eq(got, acc) { ok = false }
                        }
                        cur = &(*al).tail
                    }
                    _ => break
                }
            }
            if ok && acc.len > 0 {
                return acc
            }
            return ir_empty_name()
        }
        // `(c2, ty)`: slot 0 names a local this block declares.
        if (*e).kind == ExprKind::ExprTupleLit {
            match (*e).args {
                Some(lst) => {
                    if (*lst).head.kind == ExprKind::ExprIdent {
                        return self.block_decl_direct_struct_name(blk, (*lst).head.name)
                    }
                    return ir_empty_name()
                }
                _ => return ir_empty_name(),
            }
        }
        // the pair itself, declared by this block
        if (*e).kind == ExprKind::ExprIdent {
            return self.block_decl_tuple0_struct_name(blk, (*e).name)
        }
        // A method call whose receiver the block declares. Without this the arm
        // goes silent and cancels the one the block scan just rescued.
        if (*e).kind == ExprKind::ExprMethodCall {
            let rt = self.recv_type_via_block(&(*e).left, blk)
            if rt.len > 0 {
                let fid = lowerer_lookup_fn_id_by_name_ref(&self, ir_mangle_method_name(rt, (*e).name))
                if fid >= 0 {
                    if self.return_tuple_struct_slot_for_fn_id(fid) == 0 {
                        return self.return_tuple_struct_name_for_fn_id(fid)
                    }
                }
            }
            return self.expr_tuple0_struct_name(e)
        }
        // Everything else answers as it always did. This path ADDS a
        // block-scoped lookup for names the local stack cannot supply; it must
        // not REPLACE the ordinary answers. Returning empty here made a method
        // call go silent -- and since every branch must agree, the arm the block
        // lookup had just rescued was cancelled by the sibling it had broken.
        self.expr_tuple0_struct_name(e)
    }

    fn opt_expr_tuple0_struct_name_via_block(self, e_opt: &Option<Box<Expr>>, blk: &Block) -> Name with Mut, Panic, Div, Alloc {
        match *e_opt {
            Some(e) => self.expr_tuple0_struct_name_via_block(&(*e), blk),
            _ => ir_empty_name(),
        }
    }

    fn block_tail_tuple0_struct_name(self, blk: &Block) -> Name with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = ir_empty_name()
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_tuple0_struct_name(&stmt_ref.expr)
                        if result.len == 0 {
                            result = self.opt_expr_tuple0_struct_name_via_block(&stmt_ref.expr, blk)
                        }
                    } else {
                        result = ir_empty_name()
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }



    fn expr_result_scalar_kind_ref(self, e: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprIntLit {
            return 1
        }
        if (*e).kind == ExprKind::ExprFloatLit {
            return 2
        }
        if (*e).kind == ExprKind::ExprStringLit {
            return 3
        }
        if (*e).kind == ExprKind::ExprIdent {
            let local_sk = self.lookup_local_scalar_kind((*e).name)
            if local_sk != 0 {
                return local_sk
            }
            // BSS scalar global fallback: see bss_global_scalar_kind.
            return self.bss_global_scalar_kind((*e).name)
        }
        if (*e).kind == ExprKind::ExprCast {
            if lower_cast_type_is_f64(&(*e).cast_type) { return 2 }
            // Any word-size integer cast target (i32/i64/u64/…) → print_int kind.
            if lower_cast_type_is_integer(&(*e).cast_type) { return 1 }
            return 0
        }
        // println i64-segfault fix: resolve a call's/field's return type to the
        // scalar-int kind when it is POSITIVELY known to be an integer type (not
        // merely "not float") — mirrors the float resolution in
        // expr_result_is_float_ref (ir_fn_get(&module, fn_id).returns_float), using
        // return_struct_name instead, since that field carries the return type's
        // name for ANY TypeNamed return (see lower_opt_type_named_name), not only
        // structs. When the type can't be resolved this way, fall through
        // unchanged so string/bool/void/unresolved results keep routing to the
        // char* printer.
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                    if fn_id >= 0 && fn_id < self.module.fn_count {
                        let callee_fn = ir_fn_get(&(*self.module), fn_id)
                        if lower_name_is_integer_type(callee_fn.return_struct_name)
                            || lower_name_is_bool_type(callee_fn.return_struct_name) {
                            // println bool-segfault fix (2026-08-17): a bool-returning
                            // call is kind 1 (print_int, 1/0) — not the char* default.
                            return 1
                        }
                    }
                }
                None => {}
            }
        }
        if (*e).kind == ExprKind::ExprMethodCall {
            // Intrinsic `.len()` on arrays/slices/strings → i64. Without this,
            // lowering emits IrArrayLen (no fn symbol), so the mangled-method
            // lookup below misses and kind stays 0 → println's char* printer SEGVs.
            if ir_name_eq((*e).name, make_name("len")) || ir_name_eq((*e).name, make_name("count")) {
                return 1
            }
            let recv_type = self.lower_method_recv_type(&(*e).left)
            let call_name = if recv_type.len > 0 { ir_mangle_method_name(recv_type, (*e).name) } else { (*e).name }
            let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, call_name)
            if fn_id >= 0 && fn_id < self.module.fn_count {
                if lower_name_is_integer_type(ir_fn_get(&(*self.module), fn_id as usize).return_struct_name) {
                    return 1
                }
            }
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            if self.field_is_int_for_base_ref(&(*e).left, (*e).name) || self.field_is_int_by_name_simple((*e).name) {
                return 1
            }
        }
        // println i64-segfault fix (array-element axis): an array subscript `a[i]`
        // (including a struct-field array `s.c[i]`) yields a scalar element. The
        // float classifier (expr_result_is_float_ref) already routes float-element
        // indexing to print_f64; without this case a non-float element (i64) fell
        // through to kind 0 → the char* printer, which deref'd the integer value as
        // a pointer and SIGSEGV'd (e.g. `println(r.c[0])` in generic_struct_return).
        // Monomorphized generic structs register their fields from the generic
        // declaration (`[F;N]`), so a declared-type i64 marker cannot fire for them;
        // classify float positively (matching the existing float path) and default
        // the remaining numeric element to int. No test in the corpus prints a
        // string/pointer array element, so this cannot misroute an existing string.
        if (*e).kind == ExprKind::ExprIndex {
            if self.index_base_elem_is_float_ref(&(*e).left) {
                return 2
            }
            return 1
        }
        if (*e).kind == ExprKind::ExprBinary {
            if lower_binary_op_is_compare((*e).bin_op) {
                return 1
            }
            if self.expr_result_is_float_ref(e) {
                return 2
            }
            // String concat (`s + t` / `s ++ t`) is a string result — keep it on
            // the char* printer. Remaining non-float binary ops are integer
            // arithmetic/bitwise; without this positive kind-1 mark, `print(x+1)`
            // and `let y = x + 1; print(y)` fall to kind 0 → strlen(char*) SEGV.
            if self.expr_result_is_string_ref(e) {
                return 3
            }
            return 1
        }
        // Unary integer negation / bitwise-not of an int yields int. Float
        // unary is already covered by expr_result_is_float_ref below.
        if (*e).kind == ExprKind::ExprUnary {
            if self.expr_result_is_float_ref(e) {
                return 2
            }
            return 1
        }
        if self.expr_result_is_float_ref(e) {
            return 2
        }
        0
    }

    fn ensure_struct_literal_layout_ref(self, type_name: Name, fields: &Option<Box<StructFieldList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if type_name.len <= 0 {
            return lo
        }
        var si: i64 = 0
        while si < (*lo.struct_layouts).count {
            if ir_name_eq((*lo.struct_layouts).entries[si as usize].type_name, type_name) {
                var current_existing = fields
                while true {
                    match *current_existing {
                        Some(list_existing) => {
                            let literal_float_kind = lower_struct_field_float_kind_ref(&(*list_existing).head.value)
                            if literal_float_kind > 0 {
                                var fi_existing: i64 = 0
                                while fi_existing < (*lo.struct_layouts).entries[si as usize].field_count {
                                    if ir_name_eq(ir_name_at((*lo.struct_layouts).entries[si as usize].fields[fi_existing as usize].name_id), (*list_existing).head.name) {
                                        (*lo.struct_layouts).entries[si as usize].fields[fi_existing as usize].is_float = literal_float_kind
                                    }
                                    fi_existing = fi_existing + 1
                                }
                            }
                            current_existing = &(*list_existing).tail
                        }
                        _ => break
                    }
                }
                return lo
            }
            si = si + 1
        }
        if (*lo.struct_layouts).count >= 1024 {
            return lo.report_error_at(9934)
        }
        let layout_idx = (*lo.struct_layouts).count
        (*lo.struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
            type_name: type_name,
            fields: [empty_struct_field_entry(); 128],
            field_count: 0,
        }
        (*lo.struct_layouts).count = layout_idx + 1

        var current = fields
        var field_idx: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let fc = (*lo.struct_layouts).entries[layout_idx as usize].field_count
                    if fc < 128 {
                        // Single-level idiom: the two-level `(*box).entries[i].fields[fc] = …`
                        // store is dropped by the lean_single by-value-aggregate miscompile.
                        var lay_entry = (*lo.struct_layouts).entries[layout_idx as usize]
                        lay_entry.fields[fc as usize] = StructFieldEntry {
                            name_id: ir_intern_name((*list).head.name),
                            index: field_idx,
                            is_float: lower_struct_field_float_kind_ref(&(*list).head.value),
                            // No declared FieldDef type is available from a struct-literal's
                            // field VALUE list (this path only runs when the type wasn't
                            // already registered from its declaration) — leave the array
                            // element type name empty (method dispatch falls back to the
                            // float/i64 heuristic, matching prior behavior).
                            elem_type_name_id: ir_intern_name(ir_empty_name()),
                            word_scalar_array_len: 0,
                            named_type_name_id: 0,
                        }
                        lay_entry.field_count = fc + 1
                        (*lo.struct_layouts).entries[layout_idx as usize] = lay_entry
                    }
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    // Phase 3.1: Register enum variant discriminants
    fn register_enum_variants_ref(self, enum_name: Name, variants: &Option<Box<VariantDefList>>, next_disc: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        var lo = self
        var current = variants
        var disc = next_disc
        var table = *lo.enum_variants
        while true {
            match *current {
                Some(list) => {
                    if table.count < 1024 {
                        table.entries[table.count as usize] = EnumVariantEntry {
                            enum_name: enum_name,
                            variant_name: (*list).head.name,
                            discriminant: disc,
                        }
                        table.count = table.count + 1
                    }
                    current = &(*list).tail
                    disc = disc + 1
                }
                _ => break
            }
        }
        lo.enum_variants = Box::new(table)
        lo
    }

    fn register_enum_variants(self, enum_name: Name, variants: Option<Box<VariantDefList>>, next_disc: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        self.register_enum_variants_ref(enum_name, &variants, next_disc)
    }

    // Phase 3.1: Lookup enum variant discriminant by variant name
    fn lookup_variant_discriminant(self, variant_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < (*self.enum_variants).count {
            if ir_name_eq((*self.enum_variants).entries[i as usize].variant_name, variant_name) {
                return (*self.enum_variants).entries[i as usize].discriminant
            }
            i = i + 1
        }
        -1
    }

    // Lookup keyed by the FULL path (enum + variant).
    // Discriminants restart at 0 per enum, so keying on the variant name alone
    // returns the first match across ALL enums: with `enum Shape{Quad,Mark}` and
    // `enum Color{Red,Green,Mark}` both present, Color::Mark resolved to the
    // Shape discriminant instead of its own, and the match arm silently ran the
    // wrong body on a well-typed program.
    // Falls back to the unqualified lookup when the enum is unknown here (e.g. an
    // unregistered imported enum) so nothing that resolves today starts failing.
    fn lookup_variant_discriminant_by_path(self, enum_name: Name, variant_name: Name) -> i64 with Mut, Panic, Div {
        if enum_name.len > 0 {
            var i: i64 = 0
            while i < (*self.enum_variants).count {
                if ir_name_eq((*self.enum_variants).entries[i as usize].variant_name, variant_name) {
                    if ir_name_eq((*self.enum_variants).entries[i as usize].enum_name, enum_name) {
                        return (*self.enum_variants).entries[i as usize].discriminant
                    }
                }
                i = i + 1
            }
        }
        self.lookup_variant_discriminant(variant_name)
    }

    // Phase 3.2: Register struct field layout
    fn register_struct_fields_ref(self, type_name: Name, fields: &Option<Box<FieldDefList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_ordered_diag_enabled() {
            print("lower_ordered: struct_fields_begin type=")
            print(str_from_bytes(type_name.buf, type_name.len))
            print(" idx=")
            print_int(idx)
            print("\n")
        }
        var layout_idx: i64 = -1
        var si: i64 = 0
        while si < (*lo.struct_layouts).count {
            if ir_name_eq((*lo.struct_layouts).entries[si as usize].type_name, type_name) {
                layout_idx = si
            }
            si = si + 1
        }
        if layout_idx < 0 {
            if (*lo.struct_layouts).count < 1024 {
                layout_idx = (*lo.struct_layouts).count
                (*lo.struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
                    type_name: type_name,
                    fields: [empty_struct_field_entry(); 128],
                    field_count: 0,
                }
                (*lo.struct_layouts).count = (*lo.struct_layouts).count + 1
            } else {
                return lo.report_error_at(10048)
            }
        }
        var current = fields
        var field_idx = idx
        while true {
            match *current {
                Some(list) => {
                    let fc = (*lo.struct_layouts).entries[layout_idx as usize].field_count
                    if fc < 128 {
                        // Single-level idiom: the two-level `(*box).entries[i].fields[fc] = …`
                        // store is dropped by the lean_single by-value-aggregate miscompile.
                        var lay_entry = (*lo.struct_layouts).entries[layout_idx as usize]
                        lay_entry.fields[fc as usize] = StructFieldEntry {
                            name_id: ir_intern_name((*list).head.name),
                            index: field_idx,
                            // println i64-segfault fix: reuse the `is_float` numeric-kind slot
                            // with a new `3` marker for scalar-i64 fields (2 is already taken by
                            // f64-array). Existing consumers only test `== 1` / `== 2`, so this
                            // is inert for them; field_is_int_* below tests `== 3`.
                            // println bool-segfault fix (2026-08-17): a bool field
                            // takes the same scalar-int marker (3) as integers, so
                            // field_is_int_* classifies `s.ok` as kind 1 and println
                            // routes it to print_int (1/0) instead of the char* printer
                            // that would strlen the bool value 1 as a pointer (SIGSEGV).
                            // Marker 3 is consumed only by field_is_int_* (println
                            // dispatch), so this is inert for float/array/store paths.
                            is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else if lower_type_expr_is_integer(&(*list).head.ty) { 3 } else if lower_type_expr_is_bool(&(*list).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*list).head.ty) { 4 } else { 0 },
                            elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*list).head.ty)),
                            word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*list).head.ty),
                            named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*list).head.ty)),
                        }
                        lay_entry.field_count = fc + 1
                        (*lo.struct_layouts).entries[layout_idx as usize] = lay_entry
                    }
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: struct_fields_done type=")
            print(str_from_bytes(type_name.buf, type_name.len))
            print(" field_count=")
            print_int((*lo.struct_layouts).entries[layout_idx as usize].field_count)
            print("\n")
        }
        lo
    }

    fn register_struct_fields(self, type_name: Name, fields: Option<Box<FieldDefList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.register_struct_fields_ref(type_name, &fields, idx)
    }

    fn lower_program_items_ref(self, items: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        fo_xfer_global_reset()
        var lo = self
        lowerer_fo_preregister_pure_fns_multipass_mut(&! lo, items)
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if lower_live_diag_enabled() {
                        print("lower_live: item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if lower_ordered_diag_enabled() {
                        print("lower_ordered: item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if kind == ItemKind::ItemFn {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        if lower_body_diag_enabled() {
                            print("lower_live: item_fn_before_match name=")
                            print(str_from_bytes(name.buf, name.len))
                            print("\n")
                        }
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                if lower_body_diag_enabled() {
                                    print("lower_live: item_fn_before_lower name=")
                                    print(str_from_bytes(name.buf, name.len))
                                    print("\n")
                                }
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => {
                                lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => {
                                lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.lower_impl_methods_ref(name, &(*id).methods)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_items(self, items: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_items_ref(&items)
    }

    fn preseed_program_items_ref(self, items: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if lo.probe_mode && lower_summary_diag_enabled() {
                        print("lower_probe: preseed_item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if kind == ItemKind::ItemFn {
                        if !ir_name_eq(name, skip_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                            match *fn_def_opt_ref {
                                Some(fd) => {
                                    lo = lo.preseed_fn_signature_ref(name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                    // Sprint 108/109: set strategy for extern/export fns
                                    let pair_ps = lo.find_or_add_fn_id(name)
                                    lo = pair_ps.0
                                    let fn_id_ps = pair_ps.1
                                    if fn_id_ps >= 0 {
                                        var fn_slot_ps = ir_fn_get(&(*lo.module), fn_id_ps as usize)
                                        if (*fd).is_kernel {
                                            fn_slot_ps.compile_strategy = 6
                                        } else if visibility_to_bool(head.visibility) {
                                            fn_slot_ps.compile_strategy = 7
                                            let exp_count = (*lo.module).export_count
                                            if exp_count < 64 {
                                                (*lo.module).export_names[exp_count as usize] = name
                                                (*lo.module).export_count = exp_count + 1
                                            }
                                        }
                                        ir_fn_set(&! (*lo.module), fn_id_ps as usize, fn_slot_ps)
                                    }
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => {
                                lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => {
                                lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.preseed_impl_method_summaries_ref(name, &(*id).methods, skip_name)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn preseed_program_items(self, items: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_program_items_ref(&items, skip_name)
    }

    fn preseed_program_function_summaries_ref(self, items: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if kind == ItemKind::ItemFn {
                        if !ir_name_eq(name, skip_name) {
                            let fn_def_opt: Option<Box<FnDef>> = head.fn_def
                            match fn_def_opt {
                                Some(fd) => {
                                    lo = lo.preseed_fn_signature_ref(name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.preseed_impl_method_summaries_ref(name, &(*id).methods, skip_name)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn preseed_program_function_summaries(self, items: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_program_function_summaries_ref(&items, skip_name)
    }

    fn lower_program_bodies_ref(self, items: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // Do NOT fo_xfer_global_reset here: multi-mod prepass may have already
        // registered imported pure helpers into the global FO_XFER table.
        lowerer_fo_preregister_pure_fns_multipass_mut(&! lo, items)
        var current: Option<Box<ItemList>> = *items
        var item_count: i64 = 0
        while true {
            match current {
                Some(list) => {
                    let head = (*list).head
                    let kind = head.kind
                    let name = head.name
                    item_count = item_count + 1
                    if item_count > IR_MAX_FUNCS { return lo }
                    if kind == ItemKind::ItemFn {
                        if lower_body_diag_enabled() {
                            lower_body_trace_append("body_list_fn name=" + str_from_bytes(name.buf, name.len))
                        }
                        match head.fn_def {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            None => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        match head.impl_def {
                            Some(id) => { lo = lo.lower_impl_methods_ref(name, &(*id).methods) }
                            None => {}
                        }
                    }
                    current = (*list).tail
                }
                None => { break }
            }
        }
        lo
    }

    fn lower_program_bodies(self, items: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_bodies_ref(&items)
    }

    fn preseed_fn_signature_ref(
        self,
        name: Name,
        params: &Option<Box<ParamList>>,
        return_type: &Option<Box<TypeExpr>>,
        effects: &Option<Box<EffectList>>
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let pair = self.find_or_add_fn_id(name)
        var lo = pair.0
        let fn_id = pair.1
        if fn_id < 0 {
            return lo.report_error_at(10354)
        }
        if lo.probe_mode && lower_summary_diag_enabled() {
            print("lower_probe: preseed_fn begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        let strategy = lo.ir_compute_strategy_from_ast_ref(return_type, effects)
        var func = ir_fn_get(&(*lo.module), fn_id as usize)
        func.name = name
        func.compile_strategy = strategy
        func.returns_float = lower_opt_return_float_code(return_type)
        func.return_fixed_array_len = lower_opt_type_return_fixed_array_code(return_type)
        func.return_struct_name = lower_opt_type_return_layout_name(return_type)
        func.param_count = ir_param_list_count_ref(params)
        func.first_param_is_ref = lower_fn_first_param_is_ref(params)
        func.param_regs = [IR_INVALID_REG; 64]
        func.instr_count = 0
        func.reg_count = 0
        func.label_count = 0
        if strategy == IR_STRATEGY_INSTRUMENTED {
            func.param_count = func.param_count + 1
            if func.prof_counter_id < 0 {
                let ctr_idx = (*lo.module).prof_counter_count
                if ctr_idx < 64 {
                    (*lo.module).prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: name,
                        counter_id: ctr_idx,
                    }
                    (*lo.module).prof_counter_count = ctr_idx + 1
                    func.prof_counter_id = ctr_idx
                } else {
                    return lo.report_error_at(10390)
                }
            }
        }
        ir_fn_set(&! (*lo.module), fn_id as usize, func)
        if lo.probe_mode && lower_summary_diag_enabled() {
            print("lower_probe: preseed_fn done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(func.param_count)
            print(" strategy=")
            print_int(func.compile_strategy)
            print("\n")
        }
        lo
    }

    fn preseed_fn_signature(
        self,
        name: Name,
        params: Option<Box<ParamList>>,
        return_type: Option<Box<TypeExpr>>,
        effects: Option<Box<EffectList>>
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_fn_signature_ref(name, &params, &return_type, &effects)
    }

    fn preseed_fn_item_summary(self, name: Name, opt: Option<Box<FnDef>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => self.preseed_fn_signature(name, (*fd).params, (*fd).return_type, (*fd).effects),
            _ => self,
        }
    }

    fn preseed_impl_method_summaries_ref(self, type_name: Name, methods: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt: Option<Box<FnDef>> = head.fn_def
                        match fn_def_opt {
                            Some(fd) => {
                                lo = lo.preseed_fn_signature_ref(mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
            }
        }
        lo
    }

    fn preseed_impl_method_summaries(self, type_name: Name, methods: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_impl_method_summaries_ref(type_name, &methods, skip_name)
    }

    fn lower_program_items_filtered_ref(self, items: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if kind == ItemKind::ItemFn {
                        if ir_name_eq(name, target_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            _ => {}
                        }
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => { lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0) }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => { lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0) }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => { lo = lo.lower_impl_methods_filtered_ref(name, &(*id).methods, target_name) }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_items_filtered(self, items: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_items_filtered_ref(&items, target_name)
    }

    fn lower_program_bodies_filtered_ref(self, items: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current: Option<Box<ItemList> > = *items
        while true {
            match current {
                Some(list) => {
                    let kind = (*list).head.kind
                    let name = (*list).head.name
                    if kind == ItemKind::ItemFn {
                        if ir_name_eq(name, target_name) {
                            if lower_body_diag_enabled() {
                                lower_body_trace_append("body_filtered_fn name=" + str_from_bytes(name.buf, name.len))
                            }
                            match (*list).head.fn_def {
                                Some(fd) => {
                                    lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = (*list).head.impl_def
                        match impl_def_opt {
                            Some(id) => { lo = lo.lower_impl_methods_filtered_ref(name, &(*id).methods, target_name) }
                            _ => {}
                        }
                    }
                    current = (*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_bodies_filtered(self, items: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_bodies_filtered_ref(&items, target_name)
    }

    fn lower_item(self, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            self.lower_fn_item(name, item.fn_def)
        } else if k == ItemKind::ItemStruct {
            // Phase 3.2: Register struct field layout
            match item.struct_def {
                Some(sd) => self.register_struct_fields(name, (*sd).fields, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemEnum {
            // Phase 3.1: Register enum variant discriminants
            match item.enum_def {
                Some(ed) => self.register_enum_variants(name, (*ed).variants, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemImpl {
            // Phase 3.3: Lower impl methods as free functions
            match item.impl_def {
                Some(id) => self.lower_impl_methods(name, (*id).methods),
                _ => self,
            }
        } else if k == ItemKind::ItemTypeAlias {
            self
        } else {
            self
        }
    }

    fn lower_item_body(self, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            self.lower_fn_item(name, item.fn_def)
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods(name, (*id).methods),
                _ => self,
            }
        } else {
            self
        }
    }

    fn lower_item_filtered(self, item: Item, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            if ir_name_eq(name, target_name) {
                self.lower_fn_item(name, item.fn_def)
            } else {
                self
            }
        } else if k == ItemKind::ItemStruct {
            match item.struct_def {
                Some(sd) => self.register_struct_fields(name, (*sd).fields, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemEnum {
            match item.enum_def {
                Some(ed) => self.register_enum_variants(name, (*ed).variants, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods_filtered(name, (*id).methods, target_name),
                _ => self,
            }
        } else if k == ItemKind::ItemTypeAlias {
            self
        } else {
            self
        }
    }

    fn lower_item_body_filtered(self, item: Item, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            if ir_name_eq(name, target_name) {
                self.lower_fn_item(name, item.fn_def)
            } else {
                self
            }
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods_filtered(name, (*id).methods, target_name),
                _ => self,
            }
        } else {
            self
        }
    }

    // Phase 3.3: Lower impl block methods as mangled free functions
    // e.g., `impl Checker { fn check_expr(self, e: Expr) -> ... }`
    //     becomes `Checker_check_expr(self: Checker, e: Expr) -> ...`
    fn lower_impl_methods_ref(self, type_name: Name, methods: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    if head.kind == ItemKind::ItemFn {
                        // Mangle name: TypeName_method_name
                        let mangled = ir_mangle_method_name(type_name, head.name)
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, mangled, &(*fd))
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_impl_methods(self, type_name: Name, methods: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_impl_methods_ref(type_name, &methods)
    }

    fn lower_impl_methods_filtered_ref(self, type_name: Name, methods: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    if head.kind == ItemKind::ItemFn {
                        let mangled = ir_mangle_method_name(type_name, head.name)
                        if ir_name_eq(mangled, target_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                            match *fn_def_opt_ref {
                                Some(fd) => {
                                    lowerer_lower_fn_item_mut(&! lo, mangled, &(*fd))
                                }
                                _ => {}
                            }
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_impl_methods_filtered(self, type_name: Name, methods: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_impl_methods_filtered_ref(type_name, &methods, target_name)
    }

    // Sprint 42: Inject hidden __validated: i64 as param_regs[0] for instrumented
    // functions.  The validated flag is the first formal in the native ABI, consumed
    // by ir_opt_apply_strategy()'s dispatch block (IrBranchTrue on param_regs[0]).
    // Must be called after compile_strategy is set, before lower_fn_params().
    // Mirrors hlir_opt_apply_strategy()'s validated_param injection (hlir/opt_strategy.sio).
    fn ir_lower_inject_validated_param(self, fn_id: i64) -> Lowerer with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        var lo = pair.0
        let validated_vreg = pair.1
        // Shift existing params up by 1 to make room at position 0 for __validated
        var j: i64 = (*lo.current_func).param_count
        while j > 0 {
            (*lo.current_func).param_regs[j as usize] = (*lo.current_func).param_regs[(j - 1) as usize]
            j = j - 1
        }
        (*lo.current_func).param_regs[0] = validated_vreg
        (*lo.current_func).param_count = (*lo.current_func).param_count + 1
        lo
    }

    // Works THROUGH the Box. `var current_func = *lo.current_func` copied a
    // ~504 KB IrFunction out of the heap and `Box::new` put a fresh one back —
    // unconditionally, even for a function with no parameters at all. Measured
    // by sampling RSS between lower_live fn_begin/fn_done: 641 KB per function
    // appeared INSIDE body lowering, and this is it.
    fn lower_fn_params_ref(self, params: &Option<Box<ParamList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = params
        var current_func = lo.current_func
        var locals = lo.locals
        while true {
            match *current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: ref_param_loop name=")
                        print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                        print("\n")
                    }
                    if lo.current_fn < 0 {
                        lo = lo.report_error_at(10742)
                        current = &(*list).tail
                        continue
                    }
                    let preg = (*current_func).reg_count
                    (*current_func).reg_count = preg + 1

                    if (*current_func).param_count < IR_MAX_PARAMS {
                        let param_count = (*current_func).param_count
                        (*current_func).param_regs[param_count as usize] = preg
                        (*current_func).param_count = param_count + 1
                        if lower_live_diag_enabled() {
                            print("lower_live: ref_param_count_now=")
                            print_int((*current_func).param_count)
                            print("\n")
                        }
                    } else {
                        lo = lo.report_error_at(10759)
                    }

                    if lower_type_expr_is_f64(&(*list).head.ty) {
                        let instr_count = (*current_func).instr_count
                        if instr_count < IR_MAX_INSTRS {
                            // Pointer form: the surrounding code holds
                            // `current_func` as a pointer, not a value.
                            ir_arena_store(ir_region_slot_w((*current_func).region, (instr_count)), ir_mark_float_reg(preg))
                            // #1669: second off-funnel param-marker store.
                            let _fb = ir_float_bits_set(&! (*current_func), preg)
                            (*current_func).instr_count = instr_count + 1
                        } else {
                            lo = lo.report_error_at(10768)
                        }
                    }

                    let param_array_len = lower_type_expr_fixed_array_len_ref(&(*list).head.ty)
                    let param_word_scalar = lower_type_expr_fixed_array_word_scalar_ref(&(*list).head.ty)
                    var param_value_reg = preg
                    if param_array_len >= 0 && param_word_scalar {
                        lo.current_func = current_func
                        let copy_pair = lo.emit_fixed_array_value_copy(
                            preg,
                            param_array_len,
                            lower_type_expr_is_array_of_f64(&(*list).head.ty),
                        )
                        lo = copy_pair.0
                        param_value_reg = copy_pair.1
                        current_func = lo.current_func
                    }

                    let _is_mut = (*list).head.is_self_mut
                    if (*locals).count < 4096 {
                        let idx = (*locals).count
                        (*(*locals).names).values[idx as usize] = (*list).head.name
                        (*(*locals).regs).values[idx as usize] = param_value_reg
                        (*(*locals).depths).values[idx as usize] = lo.scope_depth
                        (*(*locals).struct_types).values[idx as usize] = lower_param_struct_type_name(&(*list).head.ty)
                        (*(*locals).array_elem_float).values[idx as usize] = if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 1 } else { 0 }
                        (*(*locals).array_lens).values[idx as usize] = param_array_len
                        (*(*locals).array_copy_word_scalar).values[idx as usize] = if param_word_scalar { 1 } else { 0 }
                        (*(*locals).wide_bits).values[idx as usize] = 0
                        (*(*locals).wide_signed).values[idx as usize] = 0
                        // Findings 11 (#2084): stamp is_unsigned_int=1 when the param is u8/u16/u32/u64/usize.
                        (*(*locals).is_unsigned_int).values[idx as usize] = if lower_type_expr_is_unsigned_int(&(*list).head.ty) { 1 } else { 0 }
                        (*(*locals).is_ref).values[idx as usize] = if lower_type_expr_is_ref_like(&(*list).head.ty) { 1 } else { 0 }
                        (*(*locals).box_inner_layout).values[idx as usize] = if lower_type_expr_is_box(&(*list).head.ty) { lower_struct_layout_index_of(&(*lo.struct_layouts), lower_box_inner_type_name(&(*list).head.ty)) } else { 0 - 1 }
                        if lower_type_expr_is_box(&(*list).head.ty) && str_eq(read_env("SOUNIO_BOX_TRACE"), "1") {
                            print("boxtrace: WRITE-B ")
                            print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                            print(" layout=")
                            print_int((*(*locals).box_inner_layout).values[idx as usize])
                            print("\n")
                        }
                        // D5+D1 (#986+#983): f64 params → kind 2 (cast + float-print);
                        // word-size integer params (i8..i64/u8..u64/isize/usize) → kind 1
                        // (println safety). Bare int `as i64` stays identity because only
                        // kind 2 triggers IrFloatToInt. i32 was previously left at 0.
                        (*(*locals).scalar_kind).values[idx as usize] = if lower_type_expr_is_f64(&(*list).head.ty) {
                            2
                        } else if lower_type_expr_is_integer(&(*list).head.ty) {
                            1
                        } else if lower_type_expr_is_bool(&(*list).head.ty) {
                            // println bool-segfault fix (2026-08-17): a bool param is
                            // kind 1 (print_int, 1/0) like an int param, so println(b)
                            // does not route the bool value through the char* printer.
                            1
                        } else {
                            0
                        }
                        (*locals).count = idx + 1
                    } else {
                        lo = lo.report_error_at(10813)
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo.current_func = current_func
        lo.locals = locals
        lo
    }

    fn lower_fn_params(self, params: Option<Box<ParamList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_fn_params_ref(&params)
    }

    // ================================================================
    // Compile strategy computation — Sprint 38
    //
    // Determines the compile strategy for a function based on its
    // AST return type and effect signature.  Mirrors the logic in
    // hlir_compute_strategy (hlir/lower.sio) but operates on the
    // AST directly so the native backend path can consume it.
    // ================================================================

    fn ir_effect_list_has_name_ref(self, effects: &Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
        var current = effects
        while true {
            match *current {
                Some(effect_node) => {
                    let eff = &(*effect_node).head
                    var matches = true
                    let tlen = str_len(target)
                    if eff.name_len != tlen {
                        matches = false
                    } else {
                        var k: i64 = 0
                        while k < tlen {
                            if eff.name_buf[k as usize] != (str_char_at(target, k) as i8) {
                                matches = false
                            }
                            k = k + 1
                        }
                    }
                    if matches {
                        return true
                    }
                    current = &(*effect_node).tail
                }
                None => return false
            }
        }
        false
    }

    fn ir_effect_list_has_name(self, effects: Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
        self.ir_effect_list_has_name_ref(&effects, target)
    }

    fn ir_compute_strategy_from_ast_ref(
        self,
        return_type: &Option<Box<TypeExpr>>,
        effects: &Option<Box<EffectList>>
    ) -> i64 with Mut, Panic, Div {
        if self.ir_effect_list_has_name_ref(effects, "GPU") {
            return IR_STRATEGY_GPU_KERNEL
        }
        if self.ir_effect_list_has_name_ref(effects, "Prob") {
            return IR_STRATEGY_PROBABILISTIC
        }

        match *return_type {
            Some(type_node) => {
                let rk = (*type_node).kind
                if rk == TypeExprKind::TypeValidated {
                    IR_STRATEGY_AGGRESSIVE
                } else if rk == TypeExprKind::TypeKnowledge {
                    IR_STRATEGY_PRECISION_PRESERVING
                } else if rk == TypeExprKind::TypeContest || rk == TypeExprKind::TypeRobust {
                    IR_STRATEGY_INSTRUMENTED
                } else {
                    IR_STRATEGY_STANDARD
                }
            }
            None => IR_STRATEGY_STANDARD,
        }
    }

    fn ir_compute_strategy_from_ast(
        self,
        return_type: Option<Box<TypeExpr>>,
        effects: Option<Box<EffectList>>
    ) -> i64 with Mut, Panic, Div {
        self.ir_compute_strategy_from_ast_ref(&return_type, &effects)
    }

    fn ir_lower_prepend_validated_arg(
        self,
        fn_id: i64,
        args: Option<Box<IrRegList>>,
        argc: i64
    ) -> IrPreparedCallArgs with Mut, Panic, Div, Alloc, IO {
    lower_rss_mark("prepargs_enter")
        let callee_strategy: i64 = if fn_id >= 0 && fn_id < self.module.fn_count {
            ir_fn_get(&(*self.module), fn_id as usize).compile_strategy
        } else {
            IR_STRATEGY_STANDARD
        }
        var final_args = args
        var final_argc = argc
        var lo = self
        if callee_strategy == IR_STRATEGY_INSTRUMENTED {
            let caller_strategy: i64 = lo.current_fn_compile_strategy()
            if caller_strategy == IR_STRATEGY_INSTRUMENTED {
                let caller_validated_vreg: i64 = lo.current_fn_validated_reg()
                final_args = lo.prepend_arg(caller_validated_vreg, final_args)
            } else {
                let pair_v = lo.fresh_reg()
                lo = pair_v.0
                let validated_vreg = pair_v.1
                lo = lo.emit(ir_load_imm(validated_vreg, 1))
                final_args = lo.prepend_arg(validated_vreg, final_args)
            }
            final_argc = final_argc + 1
        }
        lower_rss_mark("prepargs_done")
        IrPreparedCallArgs { lo: lo, args: final_args, argc: final_argc }
    }

    fn lower_fn_item_owned(self, name: Name, fd: FnDef) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        if lower_live_diag_enabled() {
            print("lower_live: fn_before_find_or_add name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        let pair = self.find_or_add_fn_id(name)
        var lo = pair.0
        let fn_id = pair.1
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_find_or_add name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }
        if fn_id < 0 {
            return lo.report_error_at(10959)
        }
        if lower_live_diag_enabled() {
            print("lower_live: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_begin name=" + str_from_bytes(name.buf, name.len) + " fn_id=" + io_trace_i64_string(fn_id))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        lo = lo.flush_current_func()
        lo.current_fn = fn_id
        // Reuse the Box the Lowerer already holds instead of bump-allocating a
        // fresh ~504 KB IrFunction per function; and read the preserved fields
        // in place instead of `let preserved = …`, which copied the whole
        // function to look at seven scalars.
        var reused = lo.current_func
        ir_reset_function_in_place(&! (*reused), name)
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            (*reused).name = ir_fn_get(&(*lo.module), fn_id as usize).name
            (*reused).compile_strategy = ir_fn_get(&(*lo.module), fn_id as usize).compile_strategy
            (*reused).returns_float = ir_fn_get(&(*lo.module), fn_id as usize).returns_float
            (*reused).return_fixed_array_len = ir_fn_get(&(*lo.module), fn_id as usize).return_fixed_array_len
            (*reused).return_struct_name = ir_fn_get(&(*lo.module), fn_id as usize).return_struct_name
            (*reused).first_param_is_ref = ir_fn_get(&(*lo.module), fn_id as usize).first_param_is_ref
            (*reused).prof_counter_id = ir_fn_get(&(*lo.module), fn_id as usize).prof_counter_id
        }
        lo.current_func = reused
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals2 = lo.locals
        (*rst_locals2).count = 0
        lo.locals = rst_locals2
        lo.scope_depth = 0
        lo.loop_depth = 0
        // D5 (#986): per-function reset of vreg-keyed float/variance tables.
        lo.array_elem_float_reg_count = 0
        lo.variance_base_reg_count = 0
        lo.pending_variance_reg = -1
        lo.pending_closure_fn_id = -1
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_begin name=" + str_from_bytes(name.buf, name.len))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }

        // Sprint 38: Compute compile strategy from AST return type + effects
        let strategy = lo.ir_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_strategy name=")
            print(str_from_bytes(name.buf, name.len))
            print(" strategy=")
            print_int(strategy)
            print("\n")
        }
        // Sprint 108/109: preserve extern/exported strategy set during preseed
        let preseed_strategy = (*lo.current_func).compile_strategy
        if preseed_strategy == 6 || preseed_strategy == 7 {
            (*lo.current_func).compile_strategy = preseed_strategy
        } else {
            (*lo.current_func).compile_strategy = strategy
        }
        (*lo.current_func).returns_float = lower_opt_return_float_code(&fd.return_type)
        (*lo.current_func).return_fixed_array_len = lower_opt_type_return_fixed_array_code(&fd.return_type)
        (*lo.current_func).return_struct_name = lower_opt_type_return_layout_name(&fd.return_type)
        (*lo.current_func).first_param_is_ref = lower_fn_first_param_is_ref(&fd.params)

        // Sprint 44: allocate profiling counter for instrumented functions
        if strategy == IR_STRATEGY_INSTRUMENTED {
            if (*lo.current_func).prof_counter_id < 0 {
                var module = *lo.module
                let ctr_idx = module.prof_counter_count
                if ctr_idx < 64 {
                    module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: (*lo.current_func).name,
                        counter_id: ctr_idx,
                    }
                    module.prof_counter_count = ctr_idx + 1
                    (*lo.current_func).prof_counter_id = ctr_idx
                    lo.module = Box::new(module)
                }
            }
        }

        // Sprint 42: inject __validated hidden param before user params for instrumented fns
        if strategy == IR_STRATEGY_INSTRUMENTED {
            lo = lo.ir_lower_inject_validated_param(fn_id)
        }

        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print("\n")
        }
        lo.scope_depth = lo.scope_depth + 1
        if ir_param_list_count_ref(&fd.params) > 0 {
            lo = lo.lower_fn_params_ref(&fd.params)
        }
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_params name=" + str_from_bytes(name.buf, name.len) + " param_count=" + io_trace_i64_string(lo.current_func.param_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_ok fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
            print("lower_probe: block_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        let bpair = lo.lower_block(fd.body)
        lo = bpair.0
        let result_reg = bpair.1
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print(" instrs_current=")
            print_int(lo.current_func.instr_count)
            print(" regs_current=")
            print_int(lo.current_func.reg_count)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_block name=" + str_from_bytes(name.buf, name.len) + " result_reg=" + io_trace_i64_string(result_reg))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print("\n")
        }

        if !lo.fn_ends_with_return() {
            lo = lo.emit(ir_return(result_reg))
        }

        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo = lo.flush_current_func()
        lo.current_fn = IR_INVALID_FN
        if lower_live_diag_enabled() {
            print("lower_live: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_done name=" + str_from_bytes(name.buf, name.len) + " instrs=" + io_trace_i64_string(ir_fn_get(&(*lo.module), fn_id as usize).instr_count) + " regs=" + io_trace_i64_string(ir_fn_get(&(*lo.module), fn_id as usize).reg_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" instrs=")
            print_int(ir_fn_get(&(*lo.module), fn_id as usize).instr_count)
            print(" regs=")
            print_int(ir_fn_get(&(*lo.module), fn_id as usize).reg_count)
            print("\n")
        }
        lo
    }

    fn lower_fn_item_ref(self, name: Name, fd: &FnDef) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo, name)
        if fn_id < 0 {
            return lo.report_error_at(11165)
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_begin name=" + str_from_bytes(name.buf, name.len) + " fn_id=" + io_trace_i64_string(fn_id))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        lo = lo.flush_current_func()
        lo.current_fn = fn_id
        // Reuse the Box the Lowerer already holds instead of bump-allocating a
        // fresh ~504 KB IrFunction per function; and read the preserved fields
        // in place instead of `let preserved = …`, which copied the whole
        // function to look at seven scalars.
        var reused = lo.current_func
        ir_reset_function_in_place(&! (*reused), name)
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            (*reused).name = ir_fn_get(&(*lo.module), fn_id as usize).name
            (*reused).compile_strategy = ir_fn_get(&(*lo.module), fn_id as usize).compile_strategy
            (*reused).returns_float = ir_fn_get(&(*lo.module), fn_id as usize).returns_float
            (*reused).return_fixed_array_len = ir_fn_get(&(*lo.module), fn_id as usize).return_fixed_array_len
            (*reused).return_struct_name = ir_fn_get(&(*lo.module), fn_id as usize).return_struct_name
            (*reused).first_param_is_ref = ir_fn_get(&(*lo.module), fn_id as usize).first_param_is_ref
            (*reused).prof_counter_id = ir_fn_get(&(*lo.module), fn_id as usize).prof_counter_id
        }
        lo.current_func = reused
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals3 = lo.locals
        (*rst_locals3).count = 0
        lo.locals = rst_locals3
        lo.scope_depth = 0
        lo.loop_depth = 0
        // D5 (#986): per-function reset of vreg-keyed float/variance tables.
        lo.array_elem_float_reg_count = 0
        lo.variance_base_reg_count = 0
        lo.pending_variance_reg = -1
        lo.pending_closure_fn_id = -1
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_begin name=" + str_from_bytes(name.buf, name.len))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }

        let strategy = lo.ir_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
        // Sprint 108/109: preserve extern/exported strategy set during preseed
        let preseed_strategy_o = (*lo.current_func).compile_strategy
        if preseed_strategy_o == 6 || preseed_strategy_o == 7 {
            (*lo.current_func).compile_strategy = preseed_strategy_o
        } else {
            (*lo.current_func).compile_strategy = strategy
        }
        (*lo.current_func).returns_float = lower_opt_return_float_code(&fd.return_type)
        (*lo.current_func).return_fixed_array_len = lower_opt_type_return_fixed_array_code(&fd.return_type)
        (*lo.current_func).return_struct_name = lower_opt_type_return_layout_name(&fd.return_type)
        (*lo.current_func).first_param_is_ref = lower_fn_first_param_is_ref(&fd.params)

        if strategy == IR_STRATEGY_INSTRUMENTED {
            if (*lo.current_func).prof_counter_id < 0 {
                var module = *lo.module
                let ctr_idx = module.prof_counter_count
                if ctr_idx < 64 {
                    module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: (*lo.current_func).name,
                        counter_id: ctr_idx,
                    }
                    module.prof_counter_count = ctr_idx + 1
                    (*lo.current_func).prof_counter_id = ctr_idx
                    lo.module = Box::new(module)
                }
            }
        }

        if strategy == IR_STRATEGY_INSTRUMENTED {
            lo = lo.ir_lower_inject_validated_param(fn_id)
        }

        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print("\n")
        }
        lo.scope_depth = lo.scope_depth + 1
        if ir_param_list_count_ref(&fd.params) > 0 {
            lo = lo.lower_fn_params_ref(&fd.params)
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_params name=" + str_from_bytes(name.buf, name.len) + " param_count=" + io_trace_i64_string(lo.current_func.param_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_ok fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
            print("lower_probe: block_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        let bpair = lo.lower_block_ref(&fd.body)
        lo = bpair.0
        let result_reg = bpair.1
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_block name=" + str_from_bytes(name.buf, name.len) + " result_reg=" + io_trace_i64_string(result_reg))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print("\n")
        }

        if !lo.fn_ends_with_return() {
            lo = lo.emit(ir_return(result_reg))
        }

        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo = lo.flush_current_func()
        lo.current_fn = IR_INVALID_FN
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_done name=" + str_from_bytes(name.buf, name.len) + " instrs=" + io_trace_i64_string(ir_fn_get(&(*lo.module), fn_id as usize).instr_count) + " regs=" + io_trace_i64_string(ir_fn_get(&(*lo.module), fn_id as usize).reg_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" instrs=")
            print_int(ir_fn_get(&(*lo.module), fn_id as usize).instr_count)
            print(" regs=")
            print_int(ir_fn_get(&(*lo.module), fn_id as usize).reg_count)
            print("\n")
        }
        lo
    }

    fn lower_fn_item(self, name: Name, opt: Option<Box<FnDef>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        match opt {
            Some(fd) => {
                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                lo
            },
            _ => lo,
        }
    }

    fn lower_block_ref(self, blk: &Block) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_live_diag_enabled() { print("lower_live: block_begin\n") }
        lo.scope_depth = lo.scope_depth + 1
        let saved_local_count = (*lo.locals).count
        var current = &blk.stmts
        var reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    let pair = if stmt_ref.kind == StmtKind::StmtLet {
                        lo.lower_let_stmt_ref(stmt_ref, false)
                    } else if stmt_ref.kind == StmtKind::StmtVar {
                        lo.lower_let_stmt_ref(stmt_ref, true)
                    } else if stmt_ref.kind == StmtKind::StmtExpr {
                        let expr_opt_ref = &stmt_ref.expr
                        match *expr_opt_ref {
                            Some(expr_box) => {
                                lo.lower_expr_ref(&(*expr_box))
                            }
                            _ => {
                                lo.emit_unit()
                            }
                        }
                    } else {
                        lo.lower_assign_stmt_ref(stmt_ref)
                    }
                    lo = pair.0
                    reg = pair.1
                    saw_stmt = true
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if !saw_stmt {
            let unit_pair = lo.emit_unit()
            lo = unit_pair.0
            reg = unit_pair.1
        }
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        (*lo.locals).count = saved_local_count
        if lower_live_diag_enabled() {
            print("lower_live: block_end reg=")
            print_int(reg)
            print("\n")
        }
        (lo, reg)
    }

    fn lower_block(self, blk: Block) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_live_diag_enabled() { print("lower_live: block_begin\n") }
        lo.scope_depth = lo.scope_depth + 1
        let pair = lo.lower_stmt_list(blk.stmts)
        lo = pair.0
        let reg = pair.1
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        if lower_live_diag_enabled() {
            print("lower_live: block_end reg=")
            print_int(reg)
            print("\n")
        }
        (lo, reg)
    }

    fn lower_stmt_list_ref(self, stmts: &Option<Box<StmtList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = stmts
        var last_reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match *current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    let pair = lo.lower_stmt_ref(&(*list).head)
                    lo = pair.0
                    last_reg = pair.1
                    saw_stmt = true
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if saw_stmt {
            (lo, last_reg)
        } else {
            lo.emit_unit()
        }
    }

    fn lower_stmt_list(self, stmts: Option<Box<StmtList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = stmts
        var last_reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    let pair = lo.lower_stmt_ref(&(*list).head)
                    lo = pair.0
                    last_reg = pair.1
                    saw_stmt = true
                    current = (*list).tail
                }
                _ => break
            }
        }
        if saw_stmt {
            (lo, last_reg)
        } else {
            lo.emit_unit()
        }
    }

    fn lower_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if s.kind == StmtKind::StmtLet {
            self.lower_let_stmt_ref(s, false)
        } else if s.kind == StmtKind::StmtVar {
            self.lower_let_stmt_ref(s, true)
        } else if s.kind == StmtKind::StmtExpr {
            self.lower_expr_stmt_ref(s)
        } else {
            self.lower_assign_stmt_ref(s)
        }
    }

    fn lower_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_stmt_ref(&s)
    }

    // True iff `e` is a call to a function whose declared return type is an f64 array
    // (returns_float == 2, set by lower_opt_return_float_code). Used so `let r = mk()`
    // flags `r` as a float-element local — otherwise `r[i]` reads classify as integer
    // and get cvtsi2sd-corrupted in arithmetic/comparisons.
    fn expr_result_is_f64_array_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind != ExprKind::ExprCall {
            return false
        }
        match (*e).left {
            Some(callee_expr) => {
                let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    return ir_fn_get(&(*self.module), fn_id as usize).returns_float == 2
                }
            }
            _ => {}
        }
        false
    }

    // #1502: per-slot float mask of a tuple-producing initialiser -- either a call
    // whose declared return type is a tuple (encoded 1024+mask by
    // lower_opt_return_float_code) or a literal tuple, whose element expressions are
    // classified directly.
    fn expr_list_tuple_float_mask_ref(self, opt: &Option<Box<ExprList>>, bit: i64) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(list) => {
                var m: i64 = 0
                if bit < 32 {
                    if self.expr_result_is_float_ref(&(*list).head) {
                        m = 1 << (bit as i32)
                    }
                }
                m + self.expr_list_tuple_float_mask_ref(&(*list).tail, bit + 1)
            }
            _ => 0,
        }
    }

    fn expr_result_tuple_float_mask_ref(self, e: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprTupleLit {
            return self.expr_list_tuple_float_mask_ref(&(*e).args, 0)
        }
        if (*e).kind != ExprKind::ExprCall {
            return 0
        }
        match (*e).left {
            Some(callee_expr) => {
                let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    let code = ir_fn_get(&(*self.module), fn_id as usize).returns_float
                    if code >= 1024 {
                        return code - 1024
                    }
                }
                0
            }
            _ => 0,
        }
    }

    fn lower_let_stmt_ref(self, s: &Stmt, is_mut: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lhs_lo = self
        match s.expr {
            Some(expr_box_closure) => {
                if (*expr_box_closure).kind == ExprKind::ExprClosure {
                    lhs_lo.allow_direct_capturing_closure_literal = true
                }
            }
            _ => {}
        }
        let pair = lhs_lo.lower_opt_expr_ref(&s.expr)
        var lo = pair.0
        lo.allow_direct_capturing_closure_literal = false
        let reg = pair.1
        lo.lower_let_stmt_after_expr_ref(s, is_mut, reg)
    }

    fn lower_let_stmt_after_expr_ref(self, s: &Stmt, is_mut: bool, reg: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var fixed_array_len = lower_opt_type_fixed_array_len(&s.ty)
        var fixed_array_word_scalar = lower_opt_type_fixed_array_word_scalar(&s.ty)
        var rhs_array_elem_is_float = false
        match s.expr {
            Some(rhs_shape) => {
                if fixed_array_len < 0 {
                    if (*rhs_shape).kind == ExprKind::ExprIdent {
                        fixed_array_len = lo.lookup_local_fixed_array_len((*rhs_shape).name)
                        fixed_array_word_scalar = lo.lookup_local_array_copy_word_scalar((*rhs_shape).name)
                    } else if (*rhs_shape).kind == ExprKind::ExprCall {
                        // #1475: `var a = make_arr()` — no annotation, so the shape has to
                        // come from the callee's declared return type. Without this the
                        // length stayed -1, `a` was never marked as a fixed array, and the
                        // later `var c = a` fell through to the aliasing ir_copy while the
                        // ANNOTATED form `var a: [i64;4] = make_arr()` copied correctly.
                        // -1 (unknown callee, non-array or non-word-scalar return) leaves
                        // the previous behaviour untouched.
                        let call_array_len = lo.expr_call_return_fixed_array_len_ref(&(*rhs_shape))
                        if call_array_len >= 0 {
                            fixed_array_len = call_array_len
                            fixed_array_word_scalar = true
                        }
                    } else {
                        fixed_array_len = lower_array_literal_fixed_len_ref(&(*rhs_shape))
                        var repeat_ident_scalar_kind = 0
                        match (*rhs_shape).left {
                            Some(repeat_value) => {
                                if (*repeat_value).kind == ExprKind::ExprIdent {
                                    repeat_ident_scalar_kind = lo.lookup_local_scalar_kind((*repeat_value).name)
                                    rhs_array_elem_is_float = repeat_ident_scalar_kind == 2
                                }
                            }
                            _ => {}
                        }
                        fixed_array_word_scalar = lower_array_literal_word_scalar_ref(&(*rhs_shape), repeat_ident_scalar_kind)
                    }
                }
                if (*rhs_shape).kind == ExprKind::ExprIdent {
                    rhs_array_elem_is_float = lo.lookup_local_array_elem_float((*rhs_shape).name)
                }
            }
            _ => {}
        }

        // A bare identifier lowers to the source local's register. Scalars need a
        // fresh register only for mutable bindings; fixed arrays need fresh backing
        // storage for both `let` and `var`, otherwise an indexed mutation through
        // either binding changes the other value.
        var bind_reg = reg
        // #1548: `var arr: [f64; N]` WITHOUT an initializer must still
        // allocate the backing object. The None-expr path above lowers to
        // emit_unit (ir_load_imm 0), so the slot held the bare value 0 and
        // the first indexed store or read resolved handle 0 → SIGSEGV on
        // Madaros native (lean_single zero-initializes instead). Allocate
        // exactly like the `[0.0; N]` repeat literal: ir_alloc_array with NO
        // fill loop — lower_array_repeat_literal_ref skips the fill for
        // zero-fill values because the fresh heap arena is zero pages, so
        // every element reads 0 / 0.0 / false, matching lean_single parity.
        match s.expr {
            None => {
                if fixed_array_len >= 0 {
                    let uninit_pair = lo.fresh_reg()
                    lo = uninit_pair.0
                    let uninit_dst = uninit_pair.1
                    lo = lo.emit(ir_alloc_array(uninit_dst, lo.aggregate_storage_bytes(fixed_array_len), fixed_array_len))
                    if lower_opt_type_is_array_of_f64(&s.ty) {
                        lo = lo.emit(ir_mark_float_reg(uninit_dst))
                        lo = lo.bind_reg_array_elem_float(uninit_dst)
                    }
                    bind_reg = uninit_dst
                }
            }
            _ => {}
        }
        match s.expr {
            Some(rhs_ident) => {
                if (*rhs_ident).kind == ExprKind::ExprIdent {
                    if fixed_array_len >= 0 && fixed_array_word_scalar {
                        let array_copy_pair = lo.emit_fixed_array_value_copy(reg, fixed_array_len, rhs_array_elem_is_float)
                        lo = array_copy_pair.0
                        bind_reg = array_copy_pair.1
                    } else if fixed_array_len < 0 && lo.struct_local_is_value_copyable((*rhs_ident).name, lo.lookup_local_struct_type((*rhs_ident).name)) && lo.struct_layout_slot_count(lo.lookup_local_struct_type((*rhs_ident).name)) > 0 {
                        // #1475: a struct handle is a POINTER to arena storage, so the
                        // ir_copy below copies the HANDLE and `var p2 = p1` aliases —
                        // `p2.x = 99` was observable through `p1.x`, silently, exit 0.
                        // Value-copy the slots instead, matching lean_single.
                        //
                        // `fixed_array_len < 0` keeps arrays-of-structs (which reach this
                        // else-arm with a length but no word-scalar element) on the old
                        // path: their element count, not a struct slot count, governs.
                        //
                        // #1479: the copy is no longer flat. Madaros still lays a
                        // struct out as count_struct_fields * 8 with an array-typed
                        // field held as a HANDLE (lower_struct_literal_expr_ref) where
                        // lean_single inlines it (struct_like_nslots = st_total_size/8),
                        // so `struct S { arr: [i64;4] }` + `s2.arr[0] = ...` USED to be
                        // observed through s1. Rather than change the representation,
                        // emit_struct_value_copy_deep allocates fresh backing storage for
                        // each aggregate FIELD and copies its contents.
                        //
                        // REMAINING BOUNDARY: an array-of-struct field (`[Inner; N]`).
                        // Copying the array would give fresh element SLOTS whose element
                        // handles still alias — a half-fix, and half-fixes in aliasing are
                        // how a new miscompile class gets born. Those fields keep the
                        // shared handle and are reported as still broken, consistent with
                        // the #1475 carve-out for `[Struct;N]` LOCALS.
                        let st_name = lo.lookup_local_struct_type((*rhs_ident).name)
                        let slot_count = lo.struct_layout_slot_count(st_name)
                        // Budget the deep copy BEFORE emitting any of it. `emit` turns an
                        // overrun past IR_MAX_INSTRS into a lowering error, so a struct
                        // whose aggregate fields will not fit degrades to the #1475 flat
                        // copy — strictly the previous behaviour — instead of breaking a
                        // build the user did not ask us to break.
                        let deep_cost = lo.struct_deep_copy_cost(st_name, slot_count, 0)
                        let deep_room = IR_MAX_INSTRS - lo.struct_deep_copy_instr_headroom() - lo.current_func.instr_count
                        let struct_copy_pair = if deep_cost <= deep_room {
                            lo.emit_struct_value_copy_deep(reg, st_name, slot_count, 0)
                        } else {
                            lo.emit_struct_value_copy(reg, st_name, slot_count)
                        }
                        lo = struct_copy_pair.0
                        bind_reg = struct_copy_pair.1
                    } else {
                        // Snapshot the source local's CURRENT value into a fresh
                        // register. Aliasing the source register is unsafe even for an
                        // immutable `let`: the SOURCE may be a mutable `var` that is
                        // reassigned in place afterwards (`let t = a; a = a + 1; use t`),
                        // and an alias would observe that mutation. `is_mut` alone was
                        // insufficient — the binding's own mutability says nothing about
                        // the source's.
                        let copy_pair = lo.fresh_reg()
                        lo = copy_pair.0
                        let copy_reg = copy_pair.1
                        lo = lo.emit(ir_copy(copy_reg, reg))
                        bind_reg = copy_reg
                    }
                }
            }
            _ => {}
        }
        lo = lo.bind_local(s.name, bind_reg, is_mut)
        lo.lower_let_stmt_finalize_ref(s, is_mut, reg, fixed_array_len, fixed_array_word_scalar, rhs_array_elem_is_float)
    }

    fn lower_let_stmt_finalize_ref(
        self,
        s: &Stmt,
        is_mut: bool,
        reg: i64,
        fixed_array_len: i64,
        fixed_array_word_scalar: bool,
        rhs_array_elem_is_float: bool
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // Ref-typed locals (annotated &T / &!T, or RHS is & / &! expr) must be marked
        // is_ref so IndexGet/Set use the ref_array path. Params already get this from
        // their type; let/var bindings previously did not — so `var p = &!GG; p[i]=v`
        // wrote through the GC-handle path and missed BSS (Defect B alias form).
        var bind_as_ref = lower_opt_type_is_ref_like(&s.ty)
        if !bind_as_ref {
            match s.expr {
                Some(rhs_ref) => {
                    if (*rhs_ref).kind == ExprKind::ExprUnary {
                        if (*rhs_ref).un_op == UnaryOp::OpRef || (*rhs_ref).un_op == UnaryOp::OpRefMut {
                            bind_as_ref = true
                        }
                    }
                }
                _ => {}
            }
        }
        if bind_as_ref {
            lo = lo.bind_local_ref(s.name)
        }
        if fixed_array_len >= 0 {
            lo = lo.bind_local_fixed_array_len(s.name, fixed_array_len)
        }
        if fixed_array_word_scalar {
            lo = lo.bind_local_array_copy_word_scalar(s.name)
        }
        // Closures step 2: if the RHS was a capturing closure, mark this local so a later
        // `name(args)` call injects the captured regs (direct call to the synthetic fn).
        if lo.pending_closure_fn_id >= 0 {
            lo = lo.bind_local_closure_fn_id(s.name, lo.pending_closure_fn_id)
            lo.pending_closure_fn_id = -1
        }
        // #1706: `let pk2 = pk` on an aggregate gives pk2 its own reg, so the field
        // slots recorded under pk's reg are invisible through pk2. Copy the mapping
        // across for the fields actually recorded. This is a VALUE copy of the
        // uncertainty mapping, matching the value semantics of the assignment (see
        // #1487): a later rebind of one does not retroactively change the other.
        // #1706: `let inn = o.inner` -- the RHS is a struct-VALUED field, so the
        // new local's reg has no field slots of its own. Resolve the source
        // aggregate's base reg and copy, exactly as the plain-ident alias below.
        match s.expr {
            Some(rhs_fa) => {
                if (*rhs_fa).kind == ExprKind::ExprFieldAccess {
                    let sb_pair = lo.variance_field_chain_base_of(&(*rhs_fa), 0)
                    lo = sb_pair.0
                    let src_reg = sb_pair.1
                    let dst_reg = lo.lookup_local(s.name)
                    if src_reg >= 0 && dst_reg >= 0 && src_reg != dst_reg {
                        var fi: i64 = 0
                        while fi < 64 {
                            let sv = lo.lookup_variance_for_field(src_reg, fi)
                            if sv >= 0 {
                                lo = lo.bind_variance_for_field(dst_reg, fi, sv)
                            }
                            let sb = lo.lookup_variance_for_field_base(src_reg, fi)
                            if sb >= 0 {
                                lo = lo.bind_variance_for_field_base(dst_reg, fi, sb)
                            }
                            fi = fi + 1
                        }
                    }
                }
            }
            _ => {}
        }
        // #1706: `let pk = make_let(x)` -- the RHS is a ctor CALL. Its per-field
        // transfers are registered, so evaluate each TOP-LEVEL field against the
        // call's arguments and bind the result under this local's reg. Only
        // depth-0 entries participate: a path hash cannot be walked back to a
        // field index, so deeper paths stay reachable only through the direct
        // `make(...).a.b` form, which fo_ctor_chain_apply already handles.
        match s.expr {
            Some(rhs_call) => {
                if (*rhs_call).kind == ExprKind::ExprCall {
                    match (*rhs_call).left {
                        Some(ce) => {
                            let cnm = lo.expr_to_callee_name_ref(&(*ce))
                            let chash = fo_name_hash(cnm)
                            let dst_reg = lo.lookup_local(s.name)
                            if dst_reg >= 0 {
                                var ci: i64 = 0
                                while ci < FO_CTOR_COUNT {
                                    if FO_CTOR_FN_HASH[ci as usize] == chash && FO_CTOR_FIELD0[ci as usize] >= 0 {
                                        let ap = lo.fo_apply_transfer_kind(FO_CTOR_KIND[ci as usize], FO_CTOR_LIT[ci as usize], 0 - 1, &(*rhs_call).args, 0)
                                        lo = ap.0
                                        if ap.1 >= 0 {
                                            lo = lo.bind_variance_for_field(dst_reg, FO_CTOR_FIELD0[ci as usize], ap.1)
                                        }
                                    }
                                    ci = ci + 1
                                }
                                lo = lo.fo_clear_expr_sens()
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        match s.expr {
            Some(rhs_alias) => {
                if (*rhs_alias).kind == ExprKind::ExprIdent {
                    let src_reg = lo.lookup_local((*rhs_alias).name)
                    let dst_reg = lo.lookup_local(s.name)
                    if src_reg >= 0 && dst_reg >= 0 && src_reg != dst_reg {
                        var fi: i64 = 0
                        while fi < 64 {
                            let sv = lo.lookup_variance_for_field(src_reg, fi)
                            if sv >= 0 {
                                lo = lo.bind_variance_for_field(dst_reg, fi, sv)
                            }
                            let sb = lo.lookup_variance_for_field_base(src_reg, fi)
                            if sb >= 0 {
                                lo = lo.bind_variance_for_field_base(dst_reg, fi, sb)
                            }
                            fi = fi + 1
                        }
                    }
                }
            }
            _ => {}
        }
        if lo.pending_variance_reg >= 0 {
            lo = lo.bind_local_variance_reg(s.name, lo.pending_variance_reg)
            lo.pending_variance_reg = -1
            // Pending FO sens from Knowledge.value extraction (or measure).
            lo = lo.fo_bind_pending_to_local(s.name)
        } else {
            // β-Madaros: bind FO variance for any pure RHS (k.value, a*b, 4.0*x, …)
            // so variance_of(local) works after `let x = <expr>`.
            match s.expr {
                Some(rhs_v) => {
                    let vpair2 = lo.lower_expr_variance_ref(&(*rhs_v))
                    lo = vpair2.0
                    if vpair2.1 >= 0 {
                        lo = lo.bind_local_variance_reg(s.name, vpair2.1)
                        // Capture multi-channel sens produced by RHS FO lower.
                        if lo.fo_expr_has_sens() {
                            lo = lo.fo_bind_local_sens(s.name)
                        }
                        lo = lo.so_bind_local_hess(s.name)
                    }
                }
                _ => {}
            }
        }
        // #1535: a MUTABLE local needs PRIVATE uncertainty slots so a later
        // assignment can copy into them and the value survives a loop back-edge.
        //
        // This must run AFTER the two binding branches above, not before. Both of
        // them bind the local's variance/sens to the RHS's own vregs, so allocating
        // first meant they immediately overwrote the fresh slots — which is why an
        // expression-initialised accumulator (`var c_blood = 6.0 / v_blood`) still
        // lost its uncertainty while a literal-initialised one (`var a = 1.2`) did
        // not: only the literal form leaves nothing for those branches to bind.
        //
        // Gated on fo_nchan > 0 so a program that never calls measure() pays
        // nothing; a `let` is never reassigned and needs no slot.
        if is_mut && lo.fo_nchan > 0 && !bind_as_ref && fixed_array_len < 0 {
            lo = lo.alloc_variance_slot_for_local(s.name)
            lo = lo.fo_alloc_sens_slots_for_local(s.name)
        }
        lo.lower_let_stmt_type_metadata_ref(s, reg, rhs_array_elem_is_float)
    }

    fn lower_let_stmt_type_metadata_ref(
        self,
        s: &Stmt,
        reg: i64,
        rhs_array_elem_is_float: bool
    ) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_opt_type_is_array_of_f64(&s.ty) {
            lo = lo.bind_local_array_elem_float(s.name)
        } else {
            match s.expr {
                Some(expr_box_arr) => {
                    if lower_expr_is_f64_array_literal_ref(&(*expr_box_arr)) {
                        lo = lo.bind_local_array_elem_float(s.name)
                    } else if lo.expr_result_is_f64_array_ref(&(*expr_box_arr)) {
                        lo = lo.bind_local_array_elem_float(s.name)
                    } else if rhs_array_elem_is_float {
                        lo = lo.bind_local_array_elem_float(s.name)
                    }
                }
                _ => {}
            }
        }
        // #1502: record which slots of a tuple-typed local are f64.
        let annotated_tuple_mask = lower_opt_type_tuple_float_mask(&s.ty)
        if annotated_tuple_mask != 0 {
            lo = lo.bind_local_tuple_float_mask(s.name, annotated_tuple_mask)
        } else {
            match s.expr {
                Some(expr_box_tup) => {
                    let init_tuple_mask = lo.expr_result_tuple_float_mask_ref(&(*expr_box_tup))
                    if init_tuple_mask != 0 {
                        lo = lo.bind_local_tuple_float_mask(s.name, init_tuple_mask)
                    }
                }
                _ => {}
            }
        }
        if lower_opt_type_is_f64(&s.ty) {
            lo = lo.bind_local_scalar_kind(s.name, 2)
        } else if lower_opt_type_is_integer(&s.ty) {
            // Annotated `let y: i64 = x+11` / `var i: i32 = ...` is positively int
            // (println + cast consumers). Broader than i64-only so i32 annotations
            // also route println through print_int. Mirrors f64 annotation above.
            lo = lo.bind_local_scalar_kind(s.name, 1)
        } else if lower_opt_type_is_string(&s.ty) {
            // Annotated `let s: string = ...` is a packed *u8; track as kind 3 so
            // `s[i]` routes to raw-byte IndexGet and `s + t` to str_concat.
            lo = lo.bind_local_scalar_kind(s.name, 3)
        } else {
            match s.expr {
                Some(expr_box_sk) => {
                    if (*expr_box_sk).kind == ExprKind::ExprIdent && lo.lookup_local_scalar_kind((*expr_box_sk).name) != 0 {
                        // println scalar-kind fix (2026-08-17): `let b = a` copies a
                        // scalar. The recorded scalar-kind of `a` is authoritative
                        // (int/bool->1, float->2, string->3); propagate it so a later
                        // `println(b)` dispatches correctly. Without this the copy left
                        // b at kind 0 and println routed the value through the char*
                        // printer -> strlen-as-pointer SIGSEGV (holds for int copies too,
                        // not only bool). Guarded on !=0 so an unclassified ident still
                        // falls through to the float/string positive checks below.
                        lo = lo.bind_local_scalar_kind(s.name, lo.lookup_local_scalar_kind((*expr_box_sk).name))
                    } else if (*expr_box_sk).kind == ExprKind::ExprIntLit {
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if (*expr_box_sk).kind == ExprKind::ExprBoolTrue || (*expr_box_sk).kind == ExprKind::ExprBoolFalse {
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if (*expr_box_sk).kind == ExprKind::ExprCast && lower_cast_type_is_integer(&(*expr_box_sk).cast_type) {
                        // D5 (#986) + residual: `var i = 0 as i64` / `as i32` is an int
                        // local. Without this the cast RHS left kind 0, and once f64
                        // params correctly carry kind 2 the cross-fn variance/float-reg
                        // tables (or cast path) could treat the counter as float.
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if lo.expr_result_is_float_ref(&(*expr_box_sk)) {
                        lo = lo.bind_local_scalar_kind(s.name, 2)
                    } else if lo.expr_result_is_string_ref(&(*expr_box_sk)) {
                        // Track string locals (kind 3) so `s + t` / `s ++ t` route to
                        // str_concat and `s[i]` uses raw-byte IndexGet (label_id=3).
                        lo = lo.bind_local_scalar_kind(s.name, 3)
                    } else if ((*expr_box_sk).kind == ExprKind::ExprCall || (*expr_box_sk).kind == ExprKind::ExprMethodCall) && lo.expr_result_scalar_kind_ref(&(*expr_box_sk)) == 1 {
                        // `let r = f(..)` / `let r = x.m(..)` whose callee POSITIVELY
                        // returns an integer type. Without this the local stayed kind 0
                        // and `println(r)` routed the int through the char* printer →
                        // SIGSEGV (e.g. `let r = use2::<i64>(2,3); println(r)`).
                        // Restricted to Call/MethodCall so an indexed struct element
                        // cannot be misclassified as int.
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if ((*expr_box_sk).kind == ExprKind::ExprBinary || (*expr_box_sk).kind == ExprKind::ExprUnary) {
                        // `let y = x + 1` / `let y = 0 - x` without an integer annotation:
                        // expr_result_scalar_kind_ref now positively returns 1 for int
                        // arith (and 2/3 for float/string). Bind that kind so a later
                        // `print(y)` / `println(y)` routes to print_int rather than
                        // strlen-as-char* (SEGV on the integer payload).
                        let sk_bin = lo.expr_result_scalar_kind_ref(&(*expr_box_sk))
                        if sk_bin == 1 || sk_bin == 2 || sk_bin == 3 {
                            lo = lo.bind_local_scalar_kind(s.name, sk_bin)
                        }
                    }
                }
                _ => {}
            }
        }
        match s.expr {
            Some(expr_box_var) => {
                if lo.lookup_local_variance_reg(s.name) >= 0 {
                    if lo.expr_result_is_float_ref(&(*expr_box_var)) {
                        lo = lo.bind_local_scalar_kind(s.name, 2)
                    }
                } else {
                    let var_pair = lo.lower_expr_variance_ref(&(*expr_box_var))
                    lo = var_pair.0
                    if var_pair.1 >= 0 {
                        lo = lo.bind_local_variance_reg(s.name, var_pair.1)
                        if lo.fo_expr_has_sens() {
                            lo = lo.fo_bind_local_sens(s.name)
                        }
                        lo = lo.so_bind_local_hess(s.name)
                        // Do NOT force scalar_kind=2 (float) here. A variance reg is
                        // produced for every tracked value, including INT locals
                        // (variance 0); the value's scalar_kind was already set
                        // authoritatively above (int/bool->1, float->2, string->3).
                        // Clobbering it to float made `int_local + literal` (and the
                        // for_sum loop accumulator `var s=3; s=s+5`) lower as a float
                        // add, yielding 0 instead of 8 (#478). Re-assert float only
                        // when the value is genuinely float, mirroring the if-branch.
                        if lo.expr_result_is_float_ref(&(*expr_box_var)) {
                            lo = lo.bind_local_scalar_kind(s.name, 2)
                        }
                    }
                }
            }
            _ => {}
        }
        let annotated_wide_bits = lower_opt_type_wide_bits(&s.ty)
        if annotated_wide_bits > 64 {
            lo = lo.bind_local_wide_type(s.name, annotated_wide_bits, lower_opt_type_wide_signed(&s.ty))
        } else {
            match s.expr {
                Some(expr_box_wide) => {
                    let expr_wide_bits = lo.expr_wide_bits_ref(&(*expr_box_wide))
                    if expr_wide_bits > 64 {
                        lo = lo.bind_local_wide_type(s.name, expr_wide_bits, lo.expr_wide_signed_ref(&(*expr_box_wide)))
                    }
                }
                _ => {}
            }
        }
        // Findings 11 (#2084): if the let type annotation is u8/u16/u32/u64/usize,
        // stamp the local so lower_binary_expr_ref can flip the IR bin_op to
        // OpUDiv/OpURem/OpUShr before signed Sar/Idiv emission. Re-uses the
        // LowerLocalStack.is_unsigned_int slot reserved near wide_signed.
        match s.ty {
            Some(ann_ty_unsigned) => {
                if lower_type_expr_is_unsigned_int(&(*ann_ty_unsigned)) {
                    lo = lo.bind_local_is_unsigned_int(s.name)
                }
            }
            _ => {}
        }
        // Annotation TypeKnowledge[T] → bind local as Knowledge for FO GUM field/variance paths
        match s.ty {
            Some(ann_ty) => {
                if (*ann_ty).kind == TypeExprKind::TypeKnowledge {
                    lo = lo.bind_local_struct_type(s.name, make_name("Knowledge"))
                }
            }
            _ => {}
        }
        if lower_opt_type_is_seq(&s.ty) {
            lo = lo.bind_local_struct_type(s.name, make_name("Seq"))
            match s.ty {
                Some(seq_ty) => {
                    let seq_elem = lower_type_expr_seq_named_elem_name(&(*seq_ty))
                    lo = lo.bind_local_tuple0_array_elem_layout(
                        s.name,
                        lower_struct_layout_index_of(&(*lo.struct_layouts), seq_elem),
                    )
                }
                None => {}
            }
        }
        // An ARRAY local records its ELEMENT type, so `arr[i].field` can be
        // resolved by (layout, field) instead of by scanning every layout for
        // the name and taking the first hit.
        //
        // Without this, member resolution depends on declaration order: with
        // `struct A { value }` before `struct B { pad, value }`, bs[i].value read
        // A.value@0 and returned B's pad; swapping the two declarations moved the
        // error onto A and made as_[1].value read slot 1 of a one-field struct.
        // #2126 fixed the Knowledge half of this by deferring the synthetic layout,
        // which reversed the victim -- ks[i].value on [Knowledge<f64>; N] then
        // returned the variance. Precedence in either direction is still first
        // name wins; the element type is the missing identity.
        match s.ty {
            Some(arr_ty) => {
                if (*arr_ty).kind == TypeExprKind::TypeArray {
                    match (*arr_ty).inner {
                        Some(el) => {
                            if (*el).kind == TypeExprKind::TypeKnowledge {
                                lo = lo.bind_local_struct_type(s.name, make_name("Knowledge"))
                            } else if (*el).kind == TypeExprKind::TypeNamed {
                                let el_name = ir_path_first_name((*el).path)
                                if el_name.len > 0 {
                                    lo = lo.bind_local_struct_type(s.name, el_name)
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        match s.expr {
            Some(expr_box) => {
                if (*expr_box).kind == ExprKind::ExprStructLit {
                    lo = lo.bind_local_struct_type(s.name, ir_path_first_name((*expr_box).path))
                } else if (*expr_box).kind == ExprKind::ExprCall {
                    let callee_opt_struct_ref = &(*expr_box).left
                    let callee_struct_name = match *callee_opt_struct_ref {
                        Some(c) => lo.expr_to_callee_name_ref(&(*c)),
                        None => ir_empty_name(),
                    }
                    let tuple0_elem_name = lo.expr_call_return_tuple0_array_elem_struct_name_ref(&(*expr_box))
                    if tuple0_elem_name.len > 0 {
                        let tuple0_layout = lower_struct_layout_index_of(&(*lo.struct_layouts), tuple0_elem_name)
                        lo = lo.bind_local_tuple0_array_elem_layout(s.name, tuple0_layout)
                    }
                    // Box detection must look at the callee PATH's first segment, not at the
                    // name expr_to_callee_name_ref returns. For `Box::new(...)` that function
                    // sees an ExprPath with first="Box" and last="new" and, since they differ,
                    // returns the MANGLED "Box_new" (its own comment explains why: bare-first
                    // mis-resolved E::of as "E"). ir_name_is_box matches the 3-byte "Box"
                    // exactly, so "Box_new" failed the test, the tagging branch below never ran,
                    // and its comment described dead code. Measured: `let b = Box::new(x)` then
                    // `*b` lowered with is_box_deref=0, took the raw pointer path, and the
                    // compiled program SIGSEGVd — the "already working" case was broken too.
                    let callee_is_box = match *callee_opt_struct_ref {
                        Some(c) => {
                            if (*c).kind == ExprKind::ExprPath {
                                ir_name_is_box(ir_path_first_name((*c).path))
                            } else {
                                ir_name_is_box(callee_struct_name)
                            }
                        }
                        None => false,
                    }
                    // measure(...) → Knowledge (return-name lookup often misses builtins)
                    if ir_name_is_measure(callee_struct_name) {
                        lo = lo.bind_local_struct_type(s.name, make_name("Knowledge"))
                    }
                    if name_eq(callee_struct_name, make_name("seq_len")) {
                        lo = lo.bind_local_struct_type(s.name, make_name("Knowledge"))
                    }
                    // `let pair = f()` where f returns a tuple carrying a named
                    // struct in slot k: record THAT slot's layout, so `pair.k.field`
                    // can be typed later. bind_local_struct_type is deliberately not
                    // used here -- the local is a tuple, not that struct, and saying
                    // otherwise is what would send `pair.ok` to the wrong layout.
                    let tuple_callee_id = lo.expr_call_callee_fn_id_ref(&(*expr_box))
                    let tuple_struct_slot = lo.return_tuple_struct_slot_for_fn_id(tuple_callee_id)
                    if tuple_struct_slot >= 0 {
                        let tuple_struct_layout = lower_struct_layout_index_of(
                            &(*lo.struct_layouts),
                            lo.return_tuple_struct_name_for_fn_id(tuple_callee_id))
                        lo = lo.bind_local_tuple_struct(s.name, tuple_struct_layout, tuple_struct_slot)
                    }
                    if !callee_is_box {
                        let ret_name = lo.expr_call_return_struct_name_ref(&(*expr_box))
                        if ret_name.len > 0 {
                            lo = lo.bind_local_struct_type(s.name, ret_name)
                        }
                    } else {
                        // `let b = Box::new(...)`: tag the local's struct-type slot with
                        // "Box" so `*b` lowers to a field-0 read (box deref through the
                        // handle) rather than a raw IrUnaryOp(OpDeref) pointer load.
                        lo = lo.bind_local_struct_type(s.name, make_name("Box"))
                        let bxl = lower_struct_layout_index_of(&(*lo.struct_layouts), lo.expr_first_arg_struct_name_ref(&(*expr_box)))
                        lo = lo.bind_local_box_inner_layout(s.name, bxl)
                    }
                } else if (*expr_box).kind == ExprKind::ExprFieldAccess {
                    // Tuple-let desugaring emits `let arr = __tup.0`. The call
                    // binding above recorded the named element layout for slot
                    // 0; project it onto `arr` so `arr[i].field` stays typed.
                    // `let c = pair.0` where the tuple slot holds a named struct.
                    // Measured on a gen2 self-compile: 1562 of 1856 unresolved
                    // method receivers are idents, and the top ones are `lo`, `c`,
                    // `lo1..lo4` -- locals rebound from exactly this shape, 824
                    // times across check.sio and lower.sio. An unresolved receiver
                    // sends the call to the BARE method name, which invents a
                    // body-less function the backend then refuses (empty_stub_ud2).
                    // The slot's struct is already recorded on the tuple local; it
                    // simply was not read here.
                    let tsi = lower_name_tuple_index((*expr_box).name)
                    if tsi >= 0 {
                        match (*expr_box).left {
                            Some(tb) => {
                                if (*tb).kind == ExprKind::ExprIdent {
                                    let tsl = lo.lookup_local_tuple_struct_layout((*tb).name, tsi)
                                    if tsl >= 0 && tsl < (*lo.struct_layouts).count {
                                        lo = lo.bind_local_struct_type(
                                            s.name,
                                            (*lo.struct_layouts).entries[tsl as usize].type_name)
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    if lower_name_tuple_index((*expr_box).name) == 0 {
                        match (*expr_box).left {
                            Some(tuple_base) => {
                                if (*tuple_base).kind == ExprKind::ExprIdent {
                                    let tuple0_layout = lo.lookup_local_tuple0_array_elem_layout((*tuple_base).name)
                                    if tuple0_layout >= 0 && tuple0_layout < (*lo.struct_layouts).count {
                                        let tuple0_type = (*lo.struct_layouts).entries[tuple0_layout as usize].type_name
                                        lo = lo.bind_local_struct_type(s.name, tuple0_type)
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    // `let c = __r.checker` where the field's DECLARED type is a
                    // struct. The two blocks above answer a TUPLE index (`.0`);
                    // a named field had no arm at all, so a local rebound from a
                    // struct-returning helper lost its type, and every method
                    // call on it went to the BARE name and invented a body-less
                    // function the backend refuses.
                    //
                    // struct_layout_field_named_type already answers exactly this
                    // question; until now only the string classifier ever asked
                    // it. Asking a tuple index here is harmless: the layout has no
                    // field named "0", so it returns empty and nothing binds.
                    match (*expr_box).left {
                        Some(fb) => {
                            // The base need not be a bare ident: `let cur_env =
                            // (*c).env` derefs a *mut param first, and requiring
                            // an ident here left cur_env untyped and sent
                            // `cur_env.bind(...)` to the bare name.
                            //
                            // expr_receiver_struct_type_ref is the resolver the
                            // RECEIVER path already trusts for exactly this
                            // question -- which struct does this expression
                            // denote -- and it answers ident, deref, field,
                            // index and method call. Asking it here rather than
                            // re-deciding the ident case is what keeps the two
                            // paths from drifting apart; re-deciding it is how
                            // this arm was born incomplete.
                            let base_st = lo.expr_receiver_struct_type_ref(&(*fb))
                            if base_st.len > 0 {
                                let fld_ty = lo.struct_layout_field_named_type(base_st, (*expr_box).name)
                                if fld_ty.len > 0 {
                                    lo = lo.bind_local_struct_type(s.name, fld_ty)
                                }
                            }
                        }
                        _ => {}
                    }
                    // `let p = h.inner` where the FIELD is a Box: propagate "Box" into the
                    // local's struct-type slot, exactly as the Box::new branch above does, so
                    // that `*p` lowers to the field-0 read (box deref through the handle)
                    // instead of a raw IrUnaryOp(OpDeref) pointer load.
                    //
                    // This branch did not exist, so type information was LOST at the bind: the
                    // Box::new case tagged the local, the field case left the slot empty,
                    // ir_name_is_box("") is false, and every subsequent deref took the raw
                    // pointer path. Measured with a stepwise witness — construction ok, bind
                    // ok, then `(*p).a` kills the process — so the defect is the lost tag at
                    // the bind, not the field access and not offset arithmetic. Three earlier
                    // attempts at the access site could not have worked for that reason.
                    // Type-aware: resolve the BASE's struct type, then ask whether THAT
                    // struct's field is a pointer. The by-name variant answers with the first
                    // same-named field in any struct, which silently produced a wrong value
                    // when two structs shared a field name (see field_is_pointer_for_struct).
                    if lo.field_is_box_for_base_ref(&(*expr_box).left, (*expr_box).name) {
                        if lower_aggregate_diag_enabled() { print("lower_agg: BIND-BOX-FROM-FIELD fired\n") }
                        lo = lo.bind_local_struct_type(s.name, make_name("Box"))
                        // expr_first_arg_struct_name_ref answers the inner T only
                        // for call/struct-literal RHS (`Box::new(mk())`); a
                        // FIELD-access RHS (`let p = h.inner`) carries no argument
                        // list, so the layout stays -1 there. The read site treats
                        // a Box-tagged local with layout -1 as "deref, then resolve
                        // the index by name" — the same route the explicit `(*p).f`
                        // form takes, and the only route the layout table can offer:
                        // it stores the declared name "Box", not the inner T.
                        let bxl = lower_struct_layout_index_of(&(*lo.struct_layouts), lo.expr_first_arg_struct_name_ref(&(*expr_box)))
                        lo = lo.bind_local_box_inner_layout(s.name, bxl)
                    } else {
                        if lower_aggregate_diag_enabled() { print("lower_agg: bind-from-field NOT pointer class\n") }
                    }
                } else if (*expr_box).kind == ExprKind::ExprMethodCall {
                    // `let s = a.add(&b)`: bind s to the method's return struct so
                    // `s.get()` mangles to Type_get (Root 2 chain residual).
                    let recv_type = lo.lower_method_recv_type(&(*expr_box).left)
                    let call_name = if recv_type.len > 0 {
                        ir_mangle_method_name(recv_type, (*expr_box).name)
                    } else {
                        (*expr_box).name
                    }
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&lo, call_name)
                    let ret_name = lo.return_struct_name_for_fn_id(fn_id)
                    if ret_name.len > 0 {
                        lo = lo.bind_local_struct_type(s.name, ret_name)
                    }
                    // `let pair = c.method(...)` where the method returns
                    // `(Self, T)`. The plain-call branch above records the tuple
                    // slot's struct; method syntax did not, and method syntax is
                    // how this compiler reaches almost all of them.
                    let m_slot = lo.return_tuple_struct_slot_for_fn_id(fn_id)
                    if m_slot >= 0 {
                        let m_layout = lower_struct_layout_index_of(
                            &(*lo.struct_layouts),
                            lo.return_tuple_struct_name_for_fn_id(fn_id))
                        lo = lo.bind_local_tuple_struct(s.name, m_layout, m_slot)
                    }
                } else if (*expr_box).kind == ExprKind::ExprIf {
                    // `let pair = if cond { a.wide() } else { a.narrow() }`.
                    // The shape enum types a local from a call, a method call, a
                    // struct literal, an ident or a field access; an if-EXPRESSION
                    // had no arm at all. So the local got neither a struct type
                    // nor a tuple-slot layout, and every method call on it lowered
                    // against the BARE name, inventing a body-less function the
                    // backend then refuses (empty_stub_ud2).
                    //
                    // Measured with three witnesses that differ only here: the
                    // pair bound from a plain method call refuses nothing, and the
                    // same pair bound from an if-expression refuses.
                    //
                    // The two branches need NOT call the same function -- the real
                    // shape is `fresh_wide_reg` against `fresh_reg` -- so what has
                    // to agree is the RETURN TYPE. When they disagree, bind
                    // nothing: an untyped local is a refusal, but a wrongly typed
                    // one is a silently wrong call target.
                    let then_fn = lo.opt_block_tail_method_fn_id(&(*expr_box).block)
                    let else_fn = lo.opt_expr_method_fn_id(&(*expr_box).else_expr)
                    if then_fn >= 0 && else_fn >= 0 {
                        let t_ret = lo.return_struct_name_for_fn_id(then_fn)
                        let e_ret = lo.return_struct_name_for_fn_id(else_fn)
                        let t_slot = lo.return_tuple_struct_slot_for_fn_id(then_fn)
                        let e_slot = lo.return_tuple_struct_slot_for_fn_id(else_fn)
                        if t_slot == e_slot && ir_name_eq(t_ret, e_ret) {
                            if t_ret.len > 0 {
                                lo = lo.bind_local_struct_type(s.name, t_ret)
                            }
                            if t_slot >= 0 {
                                let t_name = lo.return_tuple_struct_name_for_fn_id(then_fn)
                                if ir_name_eq(t_name, lo.return_tuple_struct_name_for_fn_id(else_fn)) {
                                    lo = lo.bind_local_tuple_struct(
                                        s.name,
                                        lower_struct_layout_index_of(&(*lo.struct_layouts), t_name),
                                        t_slot)
                                }
                            }
                        }
                    }
                } else if (*expr_box).kind == ExprKind::ExprIdent {
                    // `let b = nx`: propagate the source variable's struct type (e.g. a Box
                    // bound from `Some(nx)`) so `*b` / field access on b resolve correctly.
                    let src_st = lo.lookup_local_struct_type((*expr_box).name)
                    if src_st.len > 0 {
                        lo = lo.bind_local_struct_type(s.name, src_st)
                    }
                    let src_elem_layout = lo.lookup_local_tuple0_array_elem_layout((*expr_box).name)
                    if src_elem_layout >= 0 {
                        lo = lo.bind_local_tuple0_array_elem_layout(s.name, src_elem_layout)
                    }
                }
            }
            _ => {}
        }
        // A tuple-producing initializer the shape enum above could not name.
        // The enum answers a method call and a tuple literal directly; a branch
        // -- `let pair = match x { ... }` or an if -- it could not answer at all,
        // and `var lo = pair.0` was then untyped, which sends every call on `lo`
        // to the bare method name and invents a body-less function.
        //
        // Additive on purpose: it only ever binds a slot-0 struct that the arms
        // above left unset, and expr_tuple0_struct_name returns empty unless
        // EVERY branch agrees, so a disagreement still binds nothing.
        match s.expr {
            Some(t0_expr) => {
                let t0_name = lo.expr_tuple0_struct_name(&(*t0_expr))
                if t0_name.len > 0 {
                    let t0_layout = lower_struct_layout_index_of(&(*lo.struct_layouts), t0_name)
                    if t0_layout >= 0 {
                        lo = lo.bind_local_tuple_struct(s.name, t0_layout, 0)
                    }
                }
            }
            _ => {}
        }
        (lo, reg)
    }

    fn lower_let_stmt(self, s: Stmt, is_mut: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_let_stmt_ref(&s, is_mut)
    }

    fn lower_expr_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_opt_expr_ref(&s.expr)
    }

    fn lower_expr_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_stmt_ref(&s)
    }

    fn lower_assign_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_rhs = self.lower_opt_expr_ref(&s.expr)
        var lo = pair_rhs.0
        var rhs = pair_rhs.1
        var rhs_variance: i64 = -1
        var rhs_is_float: bool = false
        match s.expr {
            Some(rhs_expr_var) => {
                let rhs_var_pair = lo.lower_expr_variance_ref(&(*rhs_expr_var))
                lo = rhs_var_pair.0
                rhs_variance = rhs_var_pair.1
                rhs_is_float = lo.expr_result_is_float_ref(&(*rhs_expr_var))
            }
            _ => {}
        }
        let target_opt: Option<Box<Expr>> = s.target

        if s.assign_op != AssignOp::AssignEq {
            let old_pair = lo.lower_opt_expr_ref(&target_opt)
            lo = old_pair.0
            let old_val = old_pair.1
            let bin_op = if s.assign_op == AssignOp::AssignAdd {
                BinaryOp::OpAdd
            } else {
                BinaryOp::OpSub
            }
            let pair_dst = lo.fresh_reg()
            lo = pair_dst.0
            let compound_reg = pair_dst.1
            lo = lo.emit(ir_binop(compound_reg, old_val, bin_op, rhs))
            rhs = compound_reg
        }

        match target_opt {
            Some(target_expr) => {
                if (*target_expr).kind == ExprKind::ExprIdent {
                        let dst = lo.lookup_local((*target_expr).name)
                        if dst < 0 {
                            let bss_fn_id = lowerer_lookup_fn_id_by_name_ref(&lo, (*target_expr).name)
                            if bss_fn_id >= 0 && bss_fn_id < lo.module.fn_count && ir_fn_get(&(*lo.module), bss_fn_id as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                let bss_off = ir_fn_get(&(*lo.module), bss_fn_id as usize).param_count
                                lo = lo.emit(ir_store_global(rhs, bss_off, (*target_expr).name))
                                (lo, rhs)
                            } else {
                                lo = lo.report_error_at(11967)
                                (lo, rhs)
                            }
                        } else {
                            if lo.lookup_local_is_global((*target_expr).name) {
                                let bss_off_local = lo.lookup_local_global_bss_offset((*target_expr).name)
                                lo = lo.emit(ir_store_global(rhs, bss_off_local, (*target_expr).name))
                            }
                            lo = lo.emit(ir_copy(dst, rhs))
                            if rhs_variance >= 0 {
                                // Copy into the local's fixed uncertainty slots, the
                                // same discipline the value uses one line above. A
                                // rebind here is correct in straight-line code and
                                // silently wrong across a loop back-edge (#1535): the
                                // body's IR is emitted once, so rebinding is a
                                // compile-time map update with no runtime data flow,
                                // and each iteration recomputes from the pre-loop
                                // uncertainty. Locals with no slot keep the old rebind
                                // path, which is no worse than before.
                                let vslot = lo.lookup_local_variance_reg((*target_expr).name)
                                if vslot >= 0 {
                                    if vslot != rhs_variance {
                                        lo = lo.emit(ir_copy(vslot, rhs_variance))
                                    }
                                } else {
                                    lo = lo.bind_local_variance_reg((*target_expr).name, rhs_variance)
                                }
                                if lo.fo_expr_has_sens() {
                                    let sens_pair = lo.fo_copy_expr_sens_into_local((*target_expr).name)
                                    lo = sens_pair.0
                                    if !sens_pair.1 {
                                        lo = lo.fo_bind_local_sens((*target_expr).name)
                                    }
                                }
                                // Re-assert float scalar_kind only when the RHS is
                                // genuinely float; an int RHS that merely carries a
                                // variance reg must not flip the local to float (#478).
                                if rhs_is_float {
                                    lo = lo.bind_local_scalar_kind((*target_expr).name, 2)
                                }
                            }
                            (lo, dst)
                        }
                } else if (*target_expr).kind == ExprKind::ExprFieldAccess {
                        // Escape safety for `obj.field = &local` (and array/deref store
                        // escapes) is enforced by the checker's escape analysis (E091) at
                        // store sites, so lowering stores unconditionally here.
                        let base_opt: Option<Box<Expr>> = (*target_expr).left
                        match base_opt {
                            Some(base_expr) => {
                                let base_is_ref = if (*base_expr).kind == ExprKind::ExprIdent {
                                    lo.lookup_local_is_ref((*base_expr).name)
                                } else {
                                    false
                                }
                                let fidx = lo.field_idx_for_base_ref(&(*target_expr).left, (*target_expr).name)
                                let pair_base = lo.lower_expr_ref(&(*base_expr))
                                lo = pair_base.0
                                let base_reg = pair_base.1
                                var set_instr = ir_field_set(base_reg, fidx, rhs, (*target_expr).name)
                                if base_is_ref {
                                    set_instr.label_id = 1
                                }
                                lo = lo.emit(set_instr)
                                (lo, rhs)
                            }
                            _ => (lo.report_error_at(12033), rhs),
                        }
                } else if (*target_expr).kind == ExprKind::ExprIndex {
                        let target_base_is_seq = ir_name_eq(
                            lo.lower_method_recv_type(&(*target_expr).left),
                            make_name("Seq"),
                        )
                        let target_global_elem_size = match (*target_expr).left {
                            Some(target_base_expr) => {
                                if (*target_base_expr).kind == ExprKind::ExprIdent {
                                    let global_fn_id = lowerer_lookup_fn_id_by_name_ref(&lo, (*target_base_expr).name)
                                    if global_fn_id >= 0 && global_fn_id < lo.module.fn_count
                                        && ir_fn_get(&(*lo.module), global_fn_id as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                        ir_fn_get(&(*lo.module), global_fn_id as usize).hyper_algebra_kind
                                    } else {
                                        0
                                    }
                                } else {
                                    0
                                }
                            }
                            _ => 0,
                        }
                        let target_base_is_ref = match (*target_expr).left {
                            Some(target_base_expr) => {
                                if (*target_base_expr).kind == ExprKind::ExprIdent {
                                    lo.lookup_local_is_ref((*target_base_expr).name)
                                } else {
                                    false
                                }
                            }
                            _ => false,
                        }
                        // Packed-string store target (rare; matches IndexGet label_id=3).
                        let target_base_is_string = lo.opt_expr_result_is_string_ref(&(*target_expr).left)
                        let pair_base = lo.lower_opt_expr_ref(&(*target_expr).left)
                        lo = pair_base.0
                        let base_reg = pair_base.1
                        let pair_idx = lo.lower_opt_expr_ref(&(*target_expr).right)
                        lo = pair_idx.0
                        let idx_reg = pair_idx.1
                        if target_base_is_seq {
                            let call_name_seq_set = make_name("__sounio_seq_set")
                            let fn_id_seq_set = lowerer_find_or_add_fn_id_mut(&! lo, call_name_seq_set)
                            let call_args_seq_set: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(
                                base_reg,
                                Some(Box::new(ir_reg_list_cons(
                                    idx_reg,
                                    Some(Box::new(ir_reg_list_single(rhs))),
                                ))),
                            )))
                            let pair_d_seq_set = lo.fresh_reg()
                            lo = pair_d_seq_set.0
                            let dst_seq_set = pair_d_seq_set.1
                            lo = lo.emit(ir_call(dst_seq_set, fn_id_seq_set, call_name_seq_set, call_args_seq_set, 3))
                            return (lo, rhs)
                        }
                        var index_set_instr = ir_index_set(base_reg, idx_reg, rhs)
                        if target_base_is_string {
                            index_set_instr.label_id = 3
                        } else if target_global_elem_size > 0 {
                            // Byte store is size-only (i8 and u8 both write al).
                            index_set_instr.label_id = if lower_bss_elem_physical_size(target_global_elem_size) == 1 { 3 } else { 2 }
                        } else if target_base_is_ref {
                            index_set_instr.label_id = 1
                        }
                        lo = lo.emit(index_set_instr)
                        (lo, rhs)
                } else if (*target_expr).kind == ExprKind::ExprUnary {
                        if (*target_expr).un_op == UnaryOp::OpDeref {
                            // `*p = val`: a Box stores into field 0 (handle-resolved); a true
                            // reference stores through the raw pointer.
                            let is_box_t = match (*target_expr).left {
                                Some(op) => {
                                    if (*op).kind == ExprKind::ExprIdent {
                                        ir_name_is_box(lo.lookup_local_struct_type((*op).name))
                                    } else {
                                        false
                                    }
                                }
                                _ => false,
                            }
                            let ptr_pair = lo.lower_opt_expr_ref(&(*target_expr).left)
                            lo = ptr_pair.0
                            let ptr_reg = ptr_pair.1
                            if is_box_t {
                                lo = lo.emit(ir_field_set(ptr_reg, 0, rhs, ir_empty_name()))
                            } else {
                                lo = lo.emit(ir_store_ptr(ptr_reg, rhs))
                            }
                            (lo, rhs)
                        } else {
                            lo = lo.report_error_at(12105)
                            (lo, rhs)
                        }
                } else {
                    lo = lo.report_error_at(12109)
                    (lo, rhs)
                }
            }
            _ => (lo.report_error_at(12113), rhs),
        }
    }

    fn lower_assign_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_assign_stmt_ref(&s)
    }

    fn lower_opt_expr_ref(self, opt: &Option<Box<Expr>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(e) => self.lower_expr_ref(&(*e)),
            _ => self.emit_unit(),
        }
    }

    fn lower_opt_expr(self, opt: Option<Box<Expr>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_opt_expr_ref(&opt)
    }

    fn lower_expr_args_ref(self, opt: &Option<Box<ExprList>>) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = opt
        var regs: [i64; 64] = [0; 64]
        var reg_count: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let pair_head = lo.lower_expr_ref(&(*list).head)
                    lo = pair_head.0
                    if reg_count < 64 {
                        regs[reg_count as usize] = pair_head.1
                        reg_count = reg_count + 1
                    } else {
                        break
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if reg_count <= 0 {
            let empty = IrRegList { head: 0, tail: None }
            LowerExprArgsResult { lowerer: lo, regs: empty, count: 0 }
        } else {
            var idx = reg_count - 1
            var args = IrRegList { head: regs[idx as usize], tail: None }
            while idx > 0 {
                idx = idx - 1
                args = IrRegList { head: regs[idx as usize], tail: Some(Box::new(args)) }
            }
            LowerExprArgsResult { lowerer: lo, regs: args, count: reg_count }
        }
    }

    // Lower an expression as a RAW machine value for the syscall6 escape hatch.
    // Strips & / &! borrows: a Sounio reference is a handle (pointer to a slot
    // holding address-minus-header), which is meaningless to the kernel. The
    // operand's rvalue form yields the raw address instead — BSS aggregate
    // idents lower to BSS_BASE+off (see lower_unary_expr_ref / :11663), string
    // literals to data-label addresses, scalars to their values. This matches
    // the lean_single syscall6 semantics that self-hosted/lsp/server.sio and
    // self-hosted/io/file_write.sio were written against.
    fn lower_expr_raw_arg_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if e.kind == ExprKind::ExprUnary {
            if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
                match e.left {
                    Some(inner) => {
                        return self.lower_expr_raw_arg_ref(&(*inner))
                    }
                    None => {}
                }
            }
        }
        self.lower_expr_ref(e)
    }

    // Like lower_expr_args_ref, but every argument goes through the raw-value
    // path (borrow-stripping) for the syscall6 builtin.
    fn lower_expr_args_raw_ref(self, opt: &Option<Box<ExprList>>) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = opt
        var regs: [i64; 64] = [0; 64]
        var reg_count: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let pair_head = lo.lower_expr_raw_arg_ref(&(*list).head)
                    lo = pair_head.0
                    if reg_count < 64 {
                        regs[reg_count as usize] = pair_head.1
                        reg_count = reg_count + 1
                    } else {
                        break
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if reg_count <= 0 {
            let empty = IrRegList { head: 0, tail: None }
            LowerExprArgsResult { lowerer: lo, regs: empty, count: 0 }
        } else {
            var idx = reg_count - 1
            var args = IrRegList { head: regs[idx as usize], tail: None }
            while idx > 0 {
                idx = idx - 1
                args = IrRegList { head: regs[idx as usize], tail: Some(Box::new(args)) }
            }
            LowerExprArgsResult { lowerer: lo, regs: args, count: reg_count }
        }
    }

    // Lower an expression to a native-v2 GC array handle (for str_from_bytes /
    // write_file buffer args). Strips & / &! (OpRef is LEA of the handle slot)
    // and loads once from a ref-typed local/param slot so both `buf` and `&buf`
    // reach the builtin as a handle index.
    fn lower_expr_as_array_handle_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if e.kind == ExprKind::ExprUnary {
            if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
                match e.left {
                    Some(inner) => {
                        return self.lower_expr_as_array_handle_ref(&(*inner))
                    }
                    None => {}
                }
            }
        }
        if e.kind == ExprKind::ExprIdent {
            if self.lookup_local_is_ref(e.name) {
                let pair = self.lower_expr_ref(e)
                var lo1 = pair.0
                let src = pair.1
                let pair_d = lo1.fresh_reg()
                lo1 = pair_d.0
                let dst = pair_d.1
                // Slot holds the address of the caller's handle word; load it.
                lo1 = lo1.emit(ir_unaryop(dst, UnaryOp::OpDeref, src))
                return (lo1, dst)
            }
        }
        self.lower_expr_ref(e)
    }

    // Like lower_expr_args_ref, but argument `buf_arg_idx` is forced through the
    // handle-unwrap path (D2 residual #933 / #1247). Other args are unchanged.
    fn lower_expr_args_handle_buf_ref(self, opt: &Option<Box<ExprList>>, buf_arg_idx: i64) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = opt
        var regs: [i64; 64] = [0; 64]
        var reg_count: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let pair_head = if reg_count == buf_arg_idx {
                        lo.lower_expr_as_array_handle_ref(&(*list).head)
                    } else {
                        lo.lower_expr_ref(&(*list).head)
                    }
                    lo = pair_head.0
                    if reg_count < 64 {
                        regs[reg_count as usize] = pair_head.1
                        reg_count = reg_count + 1
                    } else {
                        break
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if reg_count <= 0 {
            let empty = IrRegList { head: 0, tail: None }
            LowerExprArgsResult { lowerer: lo, regs: empty, count: 0 }
        } else {
            var idx = reg_count - 1
            var args = IrRegList { head: regs[idx as usize], tail: None }
            while idx > 0 {
                idx = idx - 1
                args = IrRegList { head: regs[idx as usize], tail: Some(Box::new(args)) }
            }
            LowerExprArgsResult { lowerer: lo, regs: args, count: reg_count }
        }
    }

    fn lower_expr_args(self, opt: Option<Box<ExprList>>) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_args_ref(&opt)
    }

    fn first_arg_is_capturing_closure_literal_ref(self, opt: &Option<Box<ExprList>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(list) => {
                if (*list).head.kind != ExprKind::ExprClosure { return false }
                var caps = empty_capture_list()
                caps = self.scan_captures_opt(&(*list).head.closure_body, &(*list).head.closure_params, caps)
                caps.count > 0
            }
            _ => false,
        }
    }

    fn first_arg_capturing_closure_local_fn_id_ref(self, opt: &Option<Box<ExprList>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(list) => {
                if (*list).head.kind != ExprKind::ExprIdent { return -1 }
                self.lookup_local_closure_fn_id((*list).head.name)
            }
            _ => -1,
        }
    }

    fn lower_function_is_transparent_hof(self, fn_id: i64) -> bool with Mut, Panic, Div, Alloc {
        if fn_id < 0 || fn_id >= (*self.module).fn_count { return false }
        let func = ir_fn_get(&(*self.module), fn_id as usize)
        if func.param_count < 2 { return false }
        var call_count: i64 = 0
        var call_dst: i64 = IR_INVALID_REG
        var saw_return = false
        var i: i64 = 0
        while i < func.instr_count {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
            if instr.op == IrOpcode::IrCallIndirect {
                call_count = call_count + 1
                if instr.src1 != func.param_regs[0] { return false }
                if instr.arg_count != func.param_count - 1 { return false }
                var cur = instr.call_args
                var pidx: i64 = 1
                while pidx < func.param_count {
                    match cur {
                        Some(arg_node) => {
                            if (*arg_node).head != func.param_regs[pidx as usize] { return false }
                            cur = (*arg_node).tail
                        }
                        _ => return false,
                    }
                    pidx = pidx + 1
                }
                match cur {
                    Some(_) => return false,
                    _ => {}
                }
                call_dst = instr.dst
            } else if instr.op == IrOpcode::IrReturn {
                if instr.src1 == call_dst {
                    saw_return = true
                }
            }
            i = i + 1
        }
        call_count == 1 && saw_return
    }

    fn lower_hof_captured_closure_local_call(self, closure_fn_id: i64, callee_name: Name, opt: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(list) => {
                var lo = self
                let pair_tail: LowerExprArgsResult = lo.lower_expr_args_ref(&(*list).tail)
                lo = pair_tail.lowerer
                var arglist: Option<Box<IrRegList>> = if pair_tail.count <= 0 { None } else { Some(Box::new(pair_tail.regs)) }
                var total = pair_tail.count
                let cidx = lo.find_closure_cap_idx(closure_fn_id)
                if cidx >= 0 && (*lo.closure_caps).entries[cidx as usize].def_fn != lo.current_fn {
                    // Capture regs from another frame. Emitting the call would
                    // reference registers that do not exist here. Escaping
                    // capturing closures are the "captures are TBD (Phase 2)"
                    // case; refuse loudly rather than emit a crashing binary or
                    // silently read 0 (#1542).
                    print("error: capturing closure called outside the function that defined it")
                    print(" -- escaping closures with captures are unsupported; inline it or pass the captured values as parameters\\n")
                    let lo_cerr = lo.report_error_at(12382)
                    return lo_cerr.emit_unit()
                }
                if cidx >= 0 {
                    let ccount = (*lo.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist = ir_reg_list_prepend((*lo.closure_caps).entries[cidx as usize].caps[jc as usize], arglist)
                        jc = jc - 1
                    }
                    total = total + ccount
                }

                let pair_dst = lo.fresh_reg()
                let lo_dst = pair_dst.0
                let dst = pair_dst.1
                let lo_call = lo_dst.emit(ir_call(dst, closure_fn_id, callee_name, arglist, total))
                (lo_call, dst)
            }
            _ => {
                let loe = self.report_error_at(12402)
                loe.emit_unit()
            }
        }
    }

    fn lower_hof_captured_closure_literal_call(self, callee_name: Name, opt: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(list) => {
                var lo_closure = self
                lo_closure.allow_direct_capturing_closure_literal = true
                let pair_closure = lo_closure.lower_expr_ref(&(*list).head)
                var lo = pair_closure.0
                let closure_fn_id = lo.pending_closure_fn_id
                lo.pending_closure_fn_id = -1
                if closure_fn_id < 0 {
                    print("error: capturing closure HOF specialization expected a captured closure literal\n")
                    let loe = lo.report_error_at(12419)
                    return (loe, pair_closure.1)
                }

                let pair_tail: LowerExprArgsResult = lo.lower_expr_args_ref(&(*list).tail)
                lo = pair_tail.lowerer
                var arglist: Option<Box<IrRegList>> = if pair_tail.count <= 0 { None } else { Some(Box::new(pair_tail.regs)) }
                var total = pair_tail.count
                let cidx = lo.find_closure_cap_idx(closure_fn_id)
                if cidx >= 0 && (*lo.closure_caps).entries[cidx as usize].def_fn != lo.current_fn {
                    // Capture regs from another frame. Emitting the call would
                    // reference registers that do not exist here. Escaping
                    // capturing closures are the "captures are TBD (Phase 2)"
                    // case; refuse loudly rather than emit a crashing binary or
                    // silently read 0 (#1542).
                    print("error: capturing closure called outside the function that defined it")
                    print(" -- escaping closures with captures are unsupported; inline it or pass the captured values as parameters\\n")
                    let lo_cerr = lo.report_error_at(12436)
                    return lo_cerr.emit_unit()
                }
                if cidx >= 0 {
                    let ccount = (*lo.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist = ir_reg_list_prepend((*lo.closure_caps).entries[cidx as usize].caps[jc as usize], arglist)
                        jc = jc - 1
                    }
                    total = total + ccount
                }

                let pair_dst = lo.fresh_reg()
                let lo_dst = pair_dst.0
                let dst = pair_dst.1
                let lo_call = lo_dst.emit(ir_call(dst, closure_fn_id, callee_name, arglist, total))
                (lo_call, dst)
            }
            _ => {
                let loe = self.report_error_at(12456)
                loe.emit_unit()
            }
        }
    }

    fn prepend_arg(self, reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
        Some(Box::new(IrRegList { head: reg, tail: args }))
    }

    fn expr_list_len_ref(self, args: &Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
        var count: i64 = 0
        var current = args
        while true {
            match *current {
                Some(list) => {
                    count = count + 1
                    current = &(*list).tail
                }
                _ => break
            }
        }
        count
    }

    fn expr_list_len(self, args: Option<Box<ExprList>>) -> i64 with Alloc, Div, Mut {
        self.expr_list_len_ref(&args)
    }

    fn ir_name_is_knowledge_kaxi_publish(self, n: Name) -> bool {
        n.len == 24 &&
        n.buf[0] == 95 as i8 &&
        n.buf[1] == 95 as i8 &&
        n.buf[2] == 107 as i8 &&
        n.buf[3] == 110 as i8 &&
        n.buf[4] == 111 as i8 &&
        n.buf[5] == 119 as i8 &&
        n.buf[6] == 108 as i8 &&
        n.buf[7] == 101 as i8 &&
        n.buf[8] == 100 as i8 &&
        n.buf[9] == 103 as i8 &&
        n.buf[10] == 101 as i8 &&
        n.buf[11] == 95 as i8 &&
        n.buf[12] == 107 as i8 &&
        n.buf[13] == 97 as i8 &&
        n.buf[14] == 120 as i8 &&
        n.buf[15] == 105 as i8 &&
        n.buf[16] == 95 as i8 &&
        n.buf[17] == 112 as i8 &&
        n.buf[18] == 117 as i8 &&
        n.buf[19] == 98 as i8 &&
        n.buf[20] == 108 as i8 &&
        n.buf[21] == 105 as i8 &&
        n.buf[22] == 115 as i8 &&
        n.buf[23] == 104 as i8
    }

    fn kaxi_sanitize_op_kind(self, raw_op: i64) -> i64 {
        if raw_op < 0 || raw_op > 15 {
            0
        } else {
            raw_op
        }
    }

    fn kaxi_extract_publish_args(self, args: Option<Box<ExprList>>) -> (Option<Box<Expr>>, i64) with Alloc {
        match args {
            Some(list) => {
                let value_expr = (*list).head
                let op_kind = match (*list).tail {
                    Some(tail1) => {
                        let op_expr = (*tail1).head
                        if op_expr.kind == ExprKind::ExprIntLit {
                            self.kaxi_sanitize_op_kind(op_expr.int_val)
                        } else {
                            0
                        }
                    }
                    _ => 0,
                }
                (Some(Box::new(value_expr)), op_kind)
            }
            _ => (None, 0),
        }
    }

    fn kaxi_pack_default_flags(self, op_kind_raw: i64) -> i64 {
        let op_kind = self.kaxi_sanitize_op_kind(op_kind_raw)
        // Native keyword contract: alpha_q8=16, success_inc=1 (except pass), failure_inc=0.
        let success_inc = if op_kind == 0 { 0 } else { 1 }
        ((16 as i64) << 24) | (success_inc << 16) | op_kind
    }

    fn lower_kaxi_publish_call(self, fn_id: i64, callee_name: Name, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let extracted = self.kaxi_extract_publish_args(args)
        let op_kind = extracted.1
        let pair_value = match extracted.0 {
            Some(value_expr) => self.lower_expr(*value_expr),
            _ => self.emit_unit(),
        }
        var lo = pair_value.0
        let value_reg = pair_value.1

        // Synthesize default epistemic payload fields for hardware_publish(value, op_kind):
        // variance=0, provenance=0 sentinel, confidence=1.0, flags=packed(op_kind).
        let pair_var = lo.fresh_reg()
        lo = pair_var.0
        let var_reg = pair_var.1
        lo = lo.emit(ir_load_imm(var_reg, 0))

        let pair_prov = lo.fresh_reg()
        lo = pair_prov.0
        let prov_reg = pair_prov.1
        lo = lo.emit(ir_load_imm(prov_reg, 0))

        let pair_conf = lo.fresh_reg()
        lo = pair_conf.0
        let conf_reg = pair_conf.1
        lo = lo.emit(ir_load_float(conf_reg, 1.0))

        let pair_flags = lo.fresh_reg()
        lo = pair_flags.0
        let flags_reg = pair_flags.1
        lo = lo.emit(ir_load_imm(flags_reg, lo.kaxi_pack_default_flags(op_kind)))

        var call_args = lo.prepend_arg(flags_reg, None)
        call_args = lo.prepend_arg(conf_reg, call_args)
        call_args = lo.prepend_arg(prov_reg, call_args)
        call_args = lo.prepend_arg(var_reg, call_args)
        call_args = lo.prepend_arg(value_reg, call_args)

        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_call(dst, fn_id, callee_name, call_args, 5))
        (lo, dst)
    }

    fn expr_to_callee_name_ref(self, e: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent {
            e.name
        } else if e.kind == ExprKind::ExprPath {
            // Type::method → Type_method (matches ir_mangle_method_name for impl methods).
            // Using only the first path segment mis-resolves E::of as bare "E" (body-less).
            let first = ir_path_first_name(e.path)
            let last = ir_path_last_name(e.path)
            if first.len > 0 && last.len > 0 && !ir_name_eq(first, last) {
                return ir_mangle_method_name(first, last)
            }
            first
        } else if e.kind == ExprKind::ExprFieldAccess {
            e.name
        } else if e.kind == ExprKind::ExprMethodCall {
            e.name
        } else {
            ir_empty_name()
        }
    }

    fn expr_to_callee_name(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        self.expr_to_callee_name_ref(&e)
    }

    fn lower_struct_fields_ref(self, base_reg: i64, struct_name: Name, fields: &Option<Box<StructFieldList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = fields
        var field_idx = idx
        while true {
            match *current {
                Some(list) => {
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: struct_field name=")
                        print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                        print(" idx=")
                        print_int(field_idx)
                        print("\n")
                    }
                    let named_field_idx = if (*list).head.name.len > 0 {
                        if struct_name.len > 0 {
                            lo.field_idx_from_struct_literal_name(struct_name, (*list).head.name, field_idx)
                        } else {
                            lo.field_idx_from_name_simple((*list).head.name)
                        }
                    } else {
                        field_idx
                    }
                    let pair = lo.lower_expr_ref(&(*list).head.value)
                    lo = pair.0
                    let vreg = pair.1
                    lo = lo.emit(ir_field_set(base_reg, named_field_idx, vreg, (*list).head.name))
                    // #1706: record this field's uncertainty so `variance_of(a.x)` can
                    // find it later. The initialiser expression is the only place the
                    // provenance is still visible -- after the field_set the value is
                    // just bytes in an aggregate. Nested literals recurse naturally,
                    // because lowering the inner literal runs this same loop against
                    // the inner base reg.
                    let fv = lo.lower_expr_variance_ref(&(*list).head.value)
                    lo = fv.0
                    if fv.1 >= 0 {
                        lo = lo.bind_variance_for_field(base_reg, named_field_idx, fv.1)
                    }
                    // A struct-valued field carries its own field slots; remember the
                    // inner base so a chain (`c.a.x`) can hop through it.
                    lo = lo.bind_variance_for_field_base(base_reg, named_field_idx, vreg)
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    fn lower_struct_fields(self, base_reg: i64, fields: Option<Box<StructFieldList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_struct_fields_ref(base_reg, ir_empty_name(), &fields, idx)
    }

    fn lower_array_elems_ref(self, base_reg: i64, elems: &Option<Box<ExprList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = elems
        var elem_idx = idx
        while true {
            match *current {
                Some(list) => {
                    let pair_v = lo.lower_expr_ref(&(*list).head)
                    lo = pair_v.0
                    let vreg = pair_v.1
                    let pair_i = lo.fresh_reg()
                    lo = pair_i.0
                    let ireg = pair_i.1
                    lo = lo.emit(ir_load_imm(ireg, elem_idx))
                    lo = lo.emit(ir_index_set(base_reg, ireg, vreg))
                    current = &(*list).tail
                    elem_idx = elem_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    fn lower_array_elems(self, base_reg: i64, elems: Option<Box<ExprList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_array_elems_ref(base_reg, &elems, idx)
    }

    // Lower match arms as a linear if/else chain
    fn lower_match_arms_ref(self, scrut: i64, res: i64, l_end: i64, arms: &Option<Box<MatchArmList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = arms
        while true {
            match *current {
                Some(list) => {
                    lo = lo.lower_match_arm_ref(scrut, res, l_end, &(*list).head)
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_match_arms(self, scrut: i64, res: i64, l_end: i64, arms: Option<Box<MatchArmList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_match_arms_ref(scrut, res, l_end, &arms)
    }

    // Lower a single match arm: test pattern, conditionally execute body
    // If the arm has an `if <cond>` guard, evaluate it (pattern variables are already bound)
    // and fall through to l_skip (treat as a non-match) when the guard is false.
    fn lower_arm_guard(self, guard: &Option<Box<Expr> >, l_skip: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match *guard {
            Some(g) => {
                let pair = self.lower_expr_ref(&(*g))
                var lo = pair.0
                lo.emit(ir_branch_false(pair.1, l_skip))
            }
            _ => self,
        }
    }

    fn lower_match_arm_ref(self, scrut: i64, res: i64, l_end: i64, arm: &MatchArm) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let pat = &arm.pattern
        if pat.kind == PatternKind::PatWildcard {
            // Wildcard matches the pattern unconditionally; an `if` guard can still reject it,
            // so allocate l_skip (dead when there is no guard).
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair = lo.lower_expr_ref(&arm.body)
            lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBinding {
            // Binding matches the pattern; bind the scrutinee, then a guard may reject it.
            var lo = self.bind_local(pat.name, scrut, pat.is_mut)
            let pair_l = lo.fresh_label()
            lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair = lo.lower_expr_ref(&arm.body)
            lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatEnum {
            let variant_name = ir_path_last_name(pat.path)
            // Check for Some/None (Option<Box<T>> as nullable pointer)
            let is_some = ir_name_is_some(variant_name)
            let is_none = ir_name_is_none(variant_name)
            if is_some {
                // Some(x): test scrutinee != 0, bind inner x = scrutinee
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee == 0 (skip this arm)
                lo = lo.emit(ir_branch_false(scrut, l_skip))
                // Bind the inner pattern (first sub_pattern) to scrutinee value
                lo = lo.bind_match_sub_pattern(scrut, pat.sub_patterns)
                lo = lo.lower_arm_guard(&arm.guard, l_skip)
                let pair_b = lo.lower_expr_ref(&arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else if is_none {
                // None: test scrutinee == 0
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee != 0 (skip this arm)
                lo = lo.emit(ir_branch_true(scrut, l_skip))
                lo = lo.lower_arm_guard(&arm.guard, l_skip)
                let pair_b = lo.lower_expr_ref(&arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else {
                // Enum variant: compare scrutinee to discriminant
                let disc = self.lookup_variant_discriminant_by_path(ir_path_qualifier_name(pat.path), variant_name)
                if disc >= 0 {
                    let pair_l = self.fresh_label()
                    var lo = pair_l.0
                    let l_skip = pair_l.1
                    let pair_d = lo.fresh_reg()
                    lo = pair_d.0
                    let disc_reg = pair_d.1
                    lo = lo.emit(ir_load_imm(disc_reg, disc))
                    let pair_cmp = lo.fresh_reg()
                    lo = pair_cmp.0
                    let cmp_reg = pair_cmp.1
                    lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, disc_reg))
                    lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
                    lo = lo.lower_arm_guard(&arm.guard, l_skip)
                    let pair_b = lo.lower_expr_ref(&arm.body)
                    lo = pair_b.0
                    let body_reg = pair_b.1
                    lo = lo.emit(ir_copy(res, body_reg))
                    lo = lo.emit(ir_jump(l_end))
                    lo = lo.emit(ir_label(l_skip))
                    lo
                } else {
                    // Unknown variant — skip this arm
                    self
                }
            }
        } else if pat.kind == PatternKind::PatIntLit {
            // Integer literal: compare scrutinee to int_val
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            let pair_d = lo.fresh_reg()
            lo = pair_d.0
            let lit_reg = pair_d.1
            lo = lo.emit(ir_load_imm(lit_reg, pat.int_val))
            let pair_cmp = lo.fresh_reg()
            lo = pair_cmp.0
            let cmp_reg = pair_cmp.1
            lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, lit_reg))
            lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolTrue {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_false(scrut, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolFalse {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_true(scrut, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else {
            // Unsupported pattern — skip
            self
        }
    }

    fn lower_match_arm(self, scrut: i64, res: i64, l_end: i64, arm: MatchArm) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_match_arm_ref(scrut, res, l_end, &arm)
    }

    // Lower Some(x) — just evaluate the first argument (identity)
    fn lower_expr_args_first(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => self.lower_expr_ref(&(*list).head),
            _ => self.emit_unit(),
        }
    }

    // Lower Box::new(x) — alloc 8 bytes, store value, return pointer
    fn lower_box_new(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_dst = self.fresh_reg()
                var lo = pair_dst.0
                let ptr_reg = pair_dst.1
                let value_expr = (*list).head
                let pair_v = lo.lower_expr_ref(&value_expr)
                lo = pair_v.0
                let val_reg = pair_v.1
                // Allocate 8 bytes on heap
                lo = lo.emit(ir_alloc(ptr_reg, 8))
                // Store value at ptr[0]
                lo = lo.emit(ir_field_set(ptr_reg, 0, val_reg, ir_empty_name()))
                (lo, ptr_reg)
            }
            _ => self.emit_unit(),
        }
    }

    // prove_robust(contest, policy) → IrProveRobust (zero-cost copy; policy is proof-time only)
    fn lower_prove_robust_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Extract first arg (contest expression)
        let contest_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let contest_pair = self.lower_opt_expr(contest_expr)
        let lo1 = contest_pair.0
        let contest_reg = contest_pair.1
        let policy_reg = IR_INVALID_REG
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let proof_id = lo2.find_robust_proof_id_for_span(span)
        let lo3 = lo2.emit(ir_prove_robust(dst_reg, contest_reg, policy_reg, proof_id))
        (lo3, dst_reg)
    }

    // Policy / validation / protocol arguments in epistemic terminal calls are
    // proof-time metadata, not runtime values. Lowering them as ExprPath would
    // spuriously report errors on names like `DefaultPolicy`.
    fn lower_compile_time_only_arg_reg(self) -> i64 with Mut, Panic, Div {
        IR_INVALID_REG
    }

    // validate_manifest(robust, validation) → IrValidated (zero-cost copy; terminal epistemic gate)
    fn lower_validate_manifest_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let robust_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let robust_pair = self.lower_opt_expr(robust_expr)
        let lo1 = robust_pair.0
        let robust_reg = robust_pair.1
        let validation_reg = lo1.lower_compile_time_only_arg_reg()
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let manifest_id = lo2.find_validated_manifest_id_for_span(span)
        let lo3 = lo2.emit(ir_validated(dst_reg, robust_reg, validation_reg, manifest_id))
        (lo3, dst_reg)
    }

    // admit_action(value, robust, decision_policy) → IrAdmitAction (zero-cost copy; terminal decision gate)
    fn lower_admit_action_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let robust_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let robust_pair = lo1.lower_opt_expr(robust_expr)
        let lo2 = robust_pair.0
        let robust_reg = robust_pair.1
        let decision_policy_reg = lo2.lower_compile_time_only_arg_reg()

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let certificate_id = lo3.find_decision_certificate_id_for_span(span)
        let lo4 = lo3.emit(ir_admit_action(dst_reg, value_reg, robust_reg, decision_policy_reg, certificate_id))
        (lo4, dst_reg)
    }

