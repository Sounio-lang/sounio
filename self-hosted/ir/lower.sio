    // `var p = &!arr; p[i] = v` — without this the local takes the GC-handle array
    // path and writes into the wrong place (global BSS alias silently misses).
    fn bind_local_ref(self, name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = lo.locals
        var i = (*stk).count - 1
        while i >= 0 {
            if (*(*stk).depths).values[i as usize] <= lo.scope_depth && ir_name_eq((*(*stk).names).values[i as usize], name) {
                (*(*stk).is_ref).values[i as usize] = 1
                lo.locals = stk
                return lo
            }
            i = i - 1
        }
        lo
    }

