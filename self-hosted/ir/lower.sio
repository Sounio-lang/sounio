    // Sprint 28: Emit a debug guard instruction after an epistemic gate.
    // Only emits when debug_mode is true. In release mode, this is a no-op.
    fn emit_debug_guard(self, gate_name: Name, dst_reg: i64) -> Lowerer with Mut, Panic, Div {
        if !self.debug_mode {
            return self
        }
        // Emit a single guard: compare dst_reg against default threshold (0.0 = no-op guard)
        // The threshold and comparison will be refined when policy requirements are wired
        self.emit(ir_debug_guard(dst_reg, 0.0, 4, 0, gate_name))
    }

    fn lower_transition_reason_witness(self, info: IrTransitionPlanInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_transition_policy_name(info.transition_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let protocol_name_pair = lo.emit_name_string(lo.epistemic_transition_protocol_name(info.transition_protocol_id))
        lo = protocol_name_pair.0
        lo = lo.emit_named_field(dst, make_name("protocol_name"), protocol_name_pair.1)

        let route_name_pair = lo.emit_name_string(info.route_name)
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let rollback_route_pair = lo.emit_name_string(info.rollback_route_name)
        lo = rollback_route_pair.0
        lo = lo.emit_named_field(dst, make_name("rollback_route_name"), rollback_route_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let contest_pair = lo.emit_i64_const(info.contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let step_count_pair = lo.emit_i64_const(info.step_count)
        lo = step_count_pair.0
        lo = lo.emit_named_field(dst, make_name("step_count"), step_count_pair.1)

        let final_value_pair = lo.emit_name_string(info.final_value_repr)
        lo = final_value_pair.0
        lo = lo.emit_named_field(dst, make_name("final_value_repr"), final_value_pair.1)

        let snapshot_pair = lo.lower_metric_snapshot_literal(info.metric_values)
        lo = snapshot_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_snapshot"), snapshot_pair.1)

        (lo, dst)
    }

    fn lower_transition_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_transition_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.transition_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.transition_reason_witnesses[witness_id as usize]
        let plan_id = witness_info.transition_plan_id
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_transition_reason_witness(self.module.epistemic.transition_plans[plan_id as usize])
    }

    fn lower_transition_step_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let plan_id = self.find_transition_plan_id_for_span(span)
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            return self.emit_i64_const(0)
        }
        self.emit_i64_const(self.module.epistemic.transition_plans[plan_id as usize].step_count)
    }

    // Bind the first sub-pattern of a Some(x) match to the scrutinee value
    fn bind_match_sub_pattern(self, scrut: i64, pats: Option<Box<PatternList>>) -> Lowerer with Mut, Panic, Div, Alloc {
        match pats {
            Some(list) => {
                let inner = (*list).head
                if inner.kind == PatternKind::PatBinding {
                    self.bind_local(inner.name, scrut, inner.is_mut)
                } else if inner.kind == PatternKind::PatWildcard {
                    // _ inside Some(_) — no binding needed
                    self
                } else {
                    self
                }
            }
            _ => self,
        }
    }

    fn lower_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let callee_opt_ref = &e.left
        let callee_name = match *callee_opt_ref {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        if name_eq(callee_name, make_name("print")) || name_eq(callee_name, make_name("print_int")) || name_eq(callee_name, make_name("print_char")) {
            var lo_builtin = self
            let fn_id_builtin = lowerer_find_or_add_fn_id_mut(&! lo_builtin, callee_name)
            let pair_args_builtin: LowerExprArgsResult = lo_builtin.lower_expr_args_ref(&e.args)
            let lo_args_builtin = pair_args_builtin.lowerer
            let args_builtin: Option<Box<IrRegList>> = if pair_args_builtin.count <= 0 { None } else { Some(Box::new(pair_args_builtin.regs)) }
            let argc_builtin = pair_args_builtin.count
            let pair_dst_builtin = lo_args_builtin.fresh_reg()
            let lo_dst_builtin = pair_dst_builtin.0
            let dst_builtin = pair_dst_builtin.1
            let lo_call_builtin = lo_dst_builtin.emit(ir_call(dst_builtin, fn_id_builtin, callee_name, args_builtin, argc_builtin))
            return (lo_call_builtin, dst_builtin)
        }
        if name_eq(callee_name, make_name("println")) {
            // Lower println(x) -> print(x); print_char('\n') so the native-v2 backend
            // does not need a dedicated println builtin and so println works for any
            // argument type that print accepts (primarily strings).
            var lo_pl = self
            let fn_id_print = lowerer_find_or_add_fn_id_mut(&! lo_pl, make_name("print"))
            let pair_args_pl: LowerExprArgsResult = lo_pl.lower_expr_args_ref(&e.args)
            let lo_args_pl = pair_args_pl.lowerer
            let args_pl: Option<Box<IrRegList>> = if pair_args_pl.count <= 0 { None } else { Some(Box::new(pair_args_pl.regs)) }
            let argc_pl = pair_args_pl.count
            let pair_dst_pl = lo_args_pl.fresh_reg()
            let lo_dst_pl = pair_dst_pl.0
            let dst_pl = pair_dst_pl.1
            let lo_call_pl = lo_dst_pl.emit(ir_call(dst_pl, fn_id_print, make_name("print"), args_pl, argc_pl))

            let fn_id_print_char = lowerer_find_or_add_fn_id_mut(&! lo_call_pl, make_name("print_char"))
            let pair_nl_reg = lo_call_pl.fresh_reg()
            let lo_nl_reg = pair_nl_reg.0
            let nl_reg = pair_nl_reg.1
            let lo_load_nl = lo_nl_reg.emit(ir_load_imm(nl_reg, 10))
            let nl_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(nl_reg)))
            let pair_nl_dst = lo_load_nl.fresh_reg()
            let lo_nl_dst = pair_nl_dst.0
            let nl_dst = pair_nl_dst.1
            let lo_call_nl = lo_nl_dst.emit(ir_call(nl_dst, fn_id_print_char, make_name("print_char"), nl_args, 1))
            return (lo_call_nl, dst_pl)
        }
        if ir_name_is_some(callee_name) {
            return self.lower_expr_args_first(&e.args)
        }
        if ir_name_is_box(callee_name) {
            return self.lower_box_new(&e.args)
        }
        if ir_name_is_prove_robust(callee_name) {
            return self.lower_prove_robust_call(e.span, e.args)
        }
        if ir_name_is_validate_manifest(callee_name) {
            return self.lower_validate_manifest_call(e.span, e.args)
        }
        if ir_name_is_admit_action(callee_name) {
            return self.lower_admit_action_call(e.span, e.args)
        }
        if ir_name_is_defer_action(callee_name) {
            return self.lower_defer_action_call(e.span, e.args)
        }
        if ir_name_is_deferral_reason(callee_name) {
            return self.lower_deferral_reason_call(e.span)
        }
        if ir_name_is_plan_acquisition(callee_name) {
            return self.lower_plan_acquisition_call(e.span, e.args)
        }
        if ir_name_is_acquisition_reason(callee_name) {
            return self.lower_acquisition_reason_call(e.span)
        }
        if ir_name_is_plan_recourse(callee_name) {
            return self.lower_plan_recourse_call(e.span, e.args)
        }
        if ir_name_is_recourse_reason(callee_name) {
            return self.lower_recourse_reason_call(e.span)
        }
        if ir_name_is_propose_alternatives(callee_name) {
            return self.lower_propose_alternatives_call(e.span, e.args)
        }
        if ir_name_is_commit_alternative(callee_name) {
            return self.lower_commit_alternative_call(e.span, e.args)
        }
        if ir_name_is_alternative_count(callee_name) {
            return self.lower_alternative_count_call(e.span)
        }
        if ir_name_is_alternative_option(callee_name) {
            return self.lower_alternative_option_call(e.args)
        }
        if ir_name_is_alternative_reason(callee_name) {
            return self.lower_alternative_reason_call(e.span)
        }
        if ir_name_is_transition_reason(callee_name) {
            return self.lower_transition_reason_call(e.span)
        }
        if ir_name_is_transition_step_count(callee_name) {
            return self.lower_transition_step_count_call(e.span)
        }
        if ir_name_is_lift_knowledge(callee_name) {
            return self.lower_lift_knowledge_call(e.span, e.args)
        }
        if ir_name_is_measure(callee_name) {
            return self.lower_measure_call(e.span, e.args)
        }
        if self.contest_witness_kind_from_callee(callee_name) >= 0 {
            return self.lower_contest_witness_call(e.span, callee_name)
        }
        let callee_local_reg = self.lookup_local(callee_name)
        if callee_local_reg >= 0 {
            let pair_args_i: LowerExprArgsResult = self.lower_expr_args_ref(&e.args)
            let lo_i = pair_args_i.lowerer
            let args_i: Option<Box<IrRegList>> = if pair_args_i.count <= 0 { None } else { Some(Box::new(pair_args_i.regs)) }
            let argc_i = pair_args_i.count
            let pair_d_i = lo_i.fresh_reg()
            let lo2_i = pair_d_i.0
            let dst_i = pair_d_i.1
            let lo3_i = lo2_i.emit(ir_call_indirect(dst_i, callee_local_reg, args_i, argc_i))
            return (lo3_i, dst_i)
        }
        var lo1 = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo1, callee_name)
        if lo1.ir_name_is_knowledge_kaxi_publish(callee_name) {
            if lo1.expr_list_len_ref(&e.args) == 2 {
                return lo1.lower_kaxi_publish_call(fn_id, callee_name, e.args)
            }
        }
        let pair_args: LowerExprArgsResult = lo1.lower_expr_args_ref(&e.args)
        let lo2 = pair_args.lowerer
        let args: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let argc = pair_args.count
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        let callee_strat_ext: i64 = if fn_id >= 0 && fn_id < (*lo3.module).fn_count { (*lo3.module).functions[fn_id as usize].compile_strategy } else { 0 }
        if callee_strat_ext == 6 {
            let lo_ext = lo3.emit(ir_call_extern(dst, callee_name, args, argc))
            return (lo_ext, dst)
        }
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args, argc)
        let lo4 = pair_call.lo
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        var call_instr = ir_call(dst, fn_id, callee_name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo4.module).fn_count {
            if (*lo4.module).functions[fn_id as usize].returns_float == 1 {
                call_instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo5 = lo4.emit(call_instr)
        if call_instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo5 = lo5.emit(ir_mark_float_reg(dst))
        }
        (lo5, dst)
    }

    fn lower_binary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let wide_bits = self.expr_wide_bits_ref(e)
        let lhs_expr_is_float = self.opt_expr_result_is_float_ref(&e.left)
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let rhs_expr_is_float = lo1.opt_expr_result_is_float_ref(&e.right)
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_r.0
        let rhs = pair_r.1
        let cmp_op = lower_binary_op_to_wide_cmp(e.bin_op)
        let limbs = lower_wide_limb_count(wide_bits)
        let pair_d = if wide_bits > 64 && cmp_op < 0 { lo2.fresh_wide_reg(limbs) } else { lo2.fresh_reg() }
        var lo3 = pair_d.0
        let dst = pair_d.1
        if lhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(lhs))
        }
        if rhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(rhs))
        }
        if e.bin_op == BinaryOp::OpMul {
            let hyper_expr_id = lowerer_find_hyper_expr_id_for_span_ref(&lo3, e.span)
            if hyper_expr_id >= 0 && hyper_expr_id < (*lo3.module).epistemic.hyper_expr_count {
                let info = (*lo3.module).epistemic.hyper_exprs[hyper_expr_id as usize]
                if info.op_kind == 1 && info.algebra_tag == 3 {
                    let lo4_h = lo3.emit(ir_hyper_mul_o(dst, lhs, rhs))
                    return (lo4_h, dst)
                }
            }
        }
        if wide_bits > 64 {
            if e.bin_op == BinaryOp::OpAdd {
                return (lo3.emit(ir_wide_add(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpSub {
                return (lo3.emit(ir_wide_sub(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpMul {
                return (lo3.emit(ir_wide_mul(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpDiv {
                return (lo3.emit(ir_wide_div_full(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpRem {
                return (lo3.emit(ir_wide_mod_full(dst, lhs, rhs, limbs)), dst)
            } else if cmp_op >= 0 {
                return (lo3.emit(ir_wide_cmp(dst, lhs, rhs, limbs, cmp_op)), dst)
            }
        }
        let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
        (lo4, dst)
    }

    fn lower_field_access_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let fidx = self.field_idx_for_base_ref(&e.left, e.name)
        let field_is_float = self.field_is_float_for_base_ref(&e.left, e.name) || self.field_is_float_by_name_simple(e.name)
        let field_array_elem_is_float = self.field_array_elem_is_float_for_base_ref(&e.left, e.name)
        if lower_aggregate_diag_enabled() {
            print("lower_agg: field name=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" idx=")
            print_int(fidx)
            print(" field_float=")
            print_int(if field_is_float { 1 } else { 0 })
            print(" field_array_float=")
            print_int(if field_array_elem_is_float { 1 } else { 0 })
            print("\n")
        }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base = pair_b.1
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        var instr = ir_field_get(dst, base, fidx, e.name)
        if field_is_float || field_array_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo3 = lo2.emit(instr)
        if instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo3 = lo3.emit(ir_mark_float_reg(dst))
        }
        if field_array_elem_is_float {
            lo3 = lo3.bind_reg_array_elem_float(dst)
        }
        (lo3, dst)
    }

    fn lower_index_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let index_elem_is_float_pre = self.index_base_elem_is_float_ref(&e.left)
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base = pair_b.1
        let index_elem_is_float = index_elem_is_float_pre || lo1.lookup_reg_array_elem_float(base)
        if lower_aggregate_diag_enabled() {
            print("lower_agg: index pre=")
            print_int(if index_elem_is_float_pre { 1 } else { 0 })
            print(" reg=")
            print_int(if lo1.lookup_reg_array_elem_float(base) { 1 } else { 0 })
            print(" final=")
            print_int(if index_elem_is_float { 1 } else { 0 })
            print(" base=")
            print_int(base)
            print("\n")
        }
        let pair_i = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_i.0
        let idx = pair_i.1
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        var instr = ir_index_get(dst, base, idx)
        if index_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo4 = lo3.emit(instr)
        if index_elem_is_float {
            lo4 = lo4.emit(ir_mark_float_reg(dst))
        }
        (lo4, dst)
    }

    fn lower_array_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match e.left {
            Some(_) => self.lower_array_repeat_literal_ref(e),
            None => {
                let elem_is_float = lower_expr_is_f64_array_literal_ref(e)
                let pair_dst = self.fresh_reg()
                var lo = pair_dst.0
                let dst = pair_dst.1
                lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_expr_list_ref(&e.args))))
                lo = lo.lower_array_elems_ref(dst, &e.args, 0)
                if elem_is_float {
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo = lo.bind_reg_array_elem_float(dst)
                }
                (lo, dst)
            }
        }
    }

    fn lower_cast_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub.0
        let src_reg = sub.1
        let wide_bits = lower_opt_type_wide_bits(&e.cast_type)
        let source_is_float = lo1.opt_expr_result_is_float_ref(&e.left)
        if wide_bits > 64 {
            let limbs = lower_wide_limb_count(wide_bits)
            let p = lo1.fresh_wide_reg(limbs)
            var lo2 = p.0
            let dst = p.1
            lo2 = lo2.emit(ir_copy(dst, src_reg))
            var wi: i64 = 1
            while wi < limbs {
                lo2 = lo2.emit(ir_load_imm(dst + wi, 0))
                wi = wi + 1
            }
            (lo2, dst)
        } else if lower_cast_type_is_f64(&e.cast_type) {
            if source_is_float {
                return (lo1, src_reg)
            }
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_int_to_float(dst, src_reg)), dst)
        } else if source_is_float || lower_opt_expr_has_float_source(&e.left) {
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_float_to_int(dst, src_reg)), dst)
        } else {
            (lo1, src_reg)
        }
    }

    fn lower_unary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_s = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_s.0
        let src = pair_s.1
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        let lo3 = lo2.emit(ir_unaryop(dst, e.un_op, src))
        (lo3, dst)
    }

    fn lower_method_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base_reg = pair_b.1
        let pair_args: LowerExprArgsResult = lo1.lower_expr_args_ref(&e.args)
        let lo2 = pair_args.lowerer
        let arg_list: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let arg_count = pair_args.count
        let args2 = lo2.prepend_arg(base_reg, arg_list)
        let pair_fn = lo2.find_or_add_fn_id(e.name)
        let lo3 = pair_fn.0
        let fn_id = pair_fn.1
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args2, arg_count + 1)
        let lo4 = pair_call.lo
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        let pair_d = lo4.fresh_reg()
        let lo5 = pair_d.0
        let dst = pair_d.1
        var call_instr_m = ir_call(dst, fn_id, e.name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo5.module).fn_count {
            if (*lo5.module).functions[fn_id as usize].returns_float == 1 {
                call_instr_m.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo6 = lo5.emit(call_instr_m)
        if call_instr_m.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo6 = lo6.emit(ir_mark_float_reg(dst))
        }
        (lo6, dst)
    }

    fn lower_if_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_cond = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_cond.0
        let cond = pair_cond.1

        let pair_l_else = lo1.fresh_label()
        let lo2 = pair_l_else.0
        let l_else = pair_l_else.1
        let pair_l_end = lo2.fresh_label()
        let lo3 = pair_l_end.0
        let l_end = pair_l_end.1
        let pair_res = lo3.fresh_reg()
        let lo4 = pair_res.0
        let res = pair_res.1

        var lo = lo4.emit(ir_branch_false(cond, l_else))

        let then_block_opt: Option<Box<Block>> = e.block
        let pair_then = match then_block_opt {
            Some(blk) => lo.lower_block_ref(&(*blk)),
            None => lo.emit_unit(),
        }
        lo = pair_then.0
        let then_reg = pair_then.1
        lo = lo.emit(ir_copy(res, then_reg))
        lo = lo.emit(ir_jump(l_end))
        lo = lo.emit(ir_label(l_else))

        let else_expr_opt: Option<Box<Expr>> = e.else_expr
        let pair_else = match else_expr_opt {
            Some(ee) => lo.lower_expr_ref(&(*ee)),
            None => lo.emit_unit(),
        }
        lo = pair_else.0
        let else_reg = pair_else.1
        lo = lo.emit(ir_copy(res, else_reg))
        lo = lo.emit(ir_label(l_end))
        (lo, res)
    }

    fn lower_match_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_scrut = self.lower_opt_expr_ref(&e.left)
        var lo = pair_scrut.0
        let scrut = pair_scrut.1
        let pair_res = lo.fresh_reg()
        lo = pair_res.0
        let res = pair_res.1
        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let l_end = pair_end.1
        lo = lo.lower_match_arms_ref(scrut, res, l_end, &e.arms)
        lo = lo.emit(ir_load_imm(res, 0))
        lo = lo.emit(ir_label(l_end))
        (lo, res)
    }

    fn lower_while_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        let pair_cond = lo.lower_opt_expr_ref(&e.left)
        lo = pair_cond.0
        let cond = pair_cond.1
        lo = lo.emit(ir_branch_false(cond, l_end))
        lo = lo.push_loop_labels(l_top, l_end)
        let while_block_opt: Option<Box<Block>> = e.block
        match while_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_loop_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        lo = lo.push_loop_labels(l_top, l_end)
        let loop_block_opt: Option<Box<Block>> = e.block
        match loop_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_block_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let block_opt: Option<Box<Block>> = e.block
        match block_opt {
            Some(blk) => self.lower_block_ref(&(*blk)),
            None => self.emit_unit(),
        }
    }

    fn lower_return_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_return(reg))
        (lo2, reg)
    }

    fn lower_break_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_break_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error()
        }
        (lo, reg)
    }

    fn lower_continue_expr_ref(self) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.emit_unit()
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_continue_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error()
        }
        (lo, reg)
    }

    fn lower_struct_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: struct_lit_alloc dst=")
            print_int(dst)
            print("\n")
        }
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_struct_fields_ref(&e.fields))))
        lo = lo.ensure_struct_literal_layout_ref(ir_path_first_name(e.path), &e.fields)
        lo = lo.lower_struct_fields_ref(dst, ir_path_first_name(e.path), &e.fields, 0)
        (lo, dst)
    }

    fn lower_tuple_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_expr_list_ref(&e.args))))
        lo = lo.lower_array_elems_ref(dst, &e.args, 0)
        (lo, dst)
    }

    fn lower_range_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_r.0
        let rhs = pair_r.1
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
        (lo4, dst)
    }

    fn lower_contest_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub_pair = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub_pair.0
        let subject_reg = sub_pair.1
        let model_count = count_expr_list_ref(&e.args)
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let contest_id = lo2.find_contest_id_for_span(e.span)
        let lo3 = lo2.emit(ir_contest(dst_reg, subject_reg, model_count, contest_id))
        (lo3, dst_reg)
    }

    fn lower_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if self.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: expr_kind=")
            if e.kind == ExprKind::ExprIntLit { print("int") }
            else if e.kind == ExprKind::ExprFloatLit { print("float") }
            else if e.kind == ExprKind::ExprBoolTrue { print("bool_true") }
            else if e.kind == ExprKind::ExprBoolFalse { print("bool_false") }
            else if e.kind == ExprKind::ExprStringLit { print("string") }
            else if e.kind == ExprKind::ExprCharLit { print("char") }
            else if e.kind == ExprKind::ExprIdent { print("ident") }
            else if e.kind == ExprKind::ExprCall { print("call") }
            else if e.kind == ExprKind::ExprBinary { print("binary") }
            else if e.kind == ExprKind::ExprUnary { print("unary") }
            else if e.kind == ExprKind::ExprFieldAccess { print("field") }
            else if e.kind == ExprKind::ExprIndex { print("index") }
            else if e.kind == ExprKind::ExprIf { print("if") }
            else if e.kind == ExprKind::ExprWhile { print("while") }
            else if e.kind == ExprKind::ExprReturn { print("return") }
            else if e.kind == ExprKind::ExprBreak { print("break") }
            else if e.kind == ExprKind::ExprContinue { print("continue") }
            else if e.kind == ExprKind::ExprStructLit { print("struct_lit") }
            else if e.kind == ExprKind::ExprArrayLit { print("array_lit") }
            else if e.kind == ExprKind::ExprTupleLit { print("tuple_lit") }
            else if e.kind == ExprKind::ExprBlock { print("block") }
            else if e.kind == ExprKind::ExprLoop { print("loop") }
            else if e.kind == ExprKind::ExprForIn { print("for_in") }
            else { print("other") }
            print("\n")
        }
        if e.kind == ExprKind::ExprIntLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprFloatLit {
            self.emit_f64_const(e.float_val)
        } else if e.kind == ExprKind::ExprBoolTrue {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, true))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBoolFalse {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, false))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprStringLit {
            let lit_name = ir_normalize_string_literal_name(e.name)
            let pair_idx = self.intern_string(lit_name)
            let lo1 = pair_idx.0
            let idx = pair_idx.1
            let pair_reg = lo1.fresh_reg()
            let lo2 = pair_reg.0
            let reg = pair_reg.1
            let lo3 = lo2.emit(ir_load_string(reg, idx, lit_name))
            (lo3, reg)
        } else if e.kind == ExprKind::ExprCharLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprIdent {
            // Check for None (null pointer for Option)
            if ir_name_is_none(e.name) {
                let pair = self.fresh_reg()
                let lo = pair.0
                let reg = pair.1
                let lo2 = lo.emit(ir_load_imm(reg, 0))
                return (lo2, reg)
            }
            let src = self.lookup_local(e.name)
            if src >= 0 {
                (self, src)
            } else {
                let fn_lookup = self.lookup_fn_by_name(e.name)
                let lo_fn = fn_lookup.0
                let fn_id = fn_lookup.1
                if fn_id >= 0 && fn_id < lo_fn.module.fn_count {
                    let fn_strategy = lo_fn.module.functions[fn_id as usize].compile_strategy
                    if fn_strategy == IR_STRATEGY_BSS_GLOBAL {
                        let bss_off = lo_fn.module.functions[fn_id as usize].param_count
                        let gsize = lo_fn.module.functions[fn_id as usize].bss_size
                        let ref_pair = lo_fn.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        var lo3 = lo2
                        if gsize > 8 {
                            lo3 = lo2.emit(ir_load_imm(ref_reg, BSS_BASE_LINUX + bss_off))
                        } else {
                            lo3 = lo2.emit(ir_load_global(ref_reg, bss_off, e.name))
                        }
                        (lo3, ref_reg)
                    } else {
                        let ref_pair = lo_fn.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                        (lo3, ref_reg)
                    }
                } else {
                    if lo_fn.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: ident_miss name=")
                        print(str_from_bytes(e.name.buf, e.name.len))
                        print(" scope=")
                        print_int(lo_fn.scope_depth)
                        print(" local_count=")
                        print_int(lo_fn.locals.count)
                        print("\n")
                    }
                    let loe = lo_fn.report_error()
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprPath {
            // Check if this is an enum variant reference (e.g., IrOpcode::IrLoadImm)
            if e.path.seg_count >= 2 {
                let variant_name = ir_path_last_name(e.path)
                // Check for None (Option::None)
                if ir_name_is_none(variant_name) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
                let disc = self.lookup_variant_discriminant(variant_name)
                if disc >= 0 {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, disc))
                    return (lo2, reg)
                }
            }
            // Check for single-segment None
            if e.path.seg_count == 1 {
                let n = ir_path_first_name(e.path)
                if ir_name_is_none(n) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
            }
            // Not an enum variant — try local variable lookup
            let n = ir_path_first_name(e.path)
            let src = self.lookup_local(n)
            if src >= 0 {
                (self, src)
            } else {
                // Sprint 228: Check if this is a function name used as a first-class value
                let fn_lookup = self.lookup_fn_by_name(n)
                let lo_fn = fn_lookup.0
                let fn_id = fn_lookup.1
                if fn_id >= 0 {
                    let ref_pair = lo_fn.fresh_reg()
                    let lo2 = ref_pair.0
                    let ref_reg = ref_pair.1
                    let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                    (lo3, ref_reg)
                } else {
                    let loe = lo_fn.report_error()
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprCall {
            self.lower_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprBinary {
            self.lower_binary_expr_ref(e)
        } else if e.kind == ExprKind::ExprUnary {
            self.lower_unary_expr_ref(e)
        } else if e.kind == ExprKind::ExprFieldAccess {
            self.lower_field_access_expr_ref(e)
        } else if e.kind == ExprKind::ExprIndex {
            self.lower_index_expr_ref(e)
        } else if e.kind == ExprKind::ExprMethodCall {
            self.lower_method_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprIf {
            self.lower_if_expr_ref(e)
        } else if e.kind == ExprKind::ExprMatch {
            self.lower_match_expr_ref(e)
        } else if e.kind == ExprKind::ExprWhile {
            self.lower_while_expr_ref(e)
        } else if e.kind == ExprKind::ExprLoop {
            self.lower_loop_expr_ref(e)
        } else if e.kind == ExprKind::ExprBlock {
            self.lower_block_expr_ref(e)
        } else if e.kind == ExprKind::ExprReturn {
            self.lower_return_expr_ref(e)
        } else if e.kind == ExprKind::ExprBreak {
            self.lower_break_expr_ref(e)
        } else if e.kind == ExprKind::ExprContinue {
            self.lower_continue_expr_ref()
        } else if e.kind == ExprKind::ExprStructLit {
            self.lower_struct_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprArrayLit {
            self.lower_array_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprTupleLit {
            self.lower_tuple_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprRange {
            self.lower_range_expr_ref(e)
        } else if e.kind == ExprKind::ExprCast {
            self.lower_cast_expr_ref(e)
        } else if e.kind == ExprKind::ExprContest {
            self.lower_contest_expr_ref(e)
        } else if e.kind == ExprKind::ExprAuditAttach {
            // Named audit attachment is compile-time metadata only; runtime lowering is transparent.
            self.lower_opt_expr_ref(&e.left)
        } else if e.kind == ExprKind::ExprClosure {
            // Sprint 228: Lambda-lift closure to a top-level synthetic function.
            // Non-capturing closures become plain functions; captures are TBD (Phase 2).
            self.lower_closure_expr_ref(e)
        } else {
            let loe = self.report_error()
            loe.emit_unit()
        }
    }

    // Sprint 228: Generate a unique closure function name: __closure_<N>
    fn make_closure_name(self) -> Name with Mut, Panic, Div {
        var n = ir_empty_name()
        // "__closure_"
        n.buf[0] = 95    // '_'
        n.buf[1] = 95    // '_'
        n.buf[2] = 99    // 'c'
        n.buf[3] = 108   // 'l'
        n.buf[4] = 111   // 'o'
        n.buf[5] = 115   // 's'
        n.buf[6] = 117   // 'u'
        n.buf[7] = 114   // 'r'
        n.buf[8] = 101   // 'e'
        n.buf[9] = 95    // '_'
        n.len = 10
        // Append fn_count as suffix for uniqueness
        let suffix = self.module.fn_count
        if suffix < 10 {
            n.buf[10] = (48 + suffix) as i8
            n.len = 11
        } else if suffix < 100 {
            n.buf[10] = (48 + suffix / 10) as i8
            n.buf[11] = (48 + suffix % 10) as i8
            n.len = 12
        } else if suffix < 1000 {
            n.buf[10] = (48 + suffix / 100) as i8
            n.buf[11] = (48 + (suffix / 10) % 10) as i8
            n.buf[12] = (48 + suffix % 10) as i8
            n.len = 13
        } else {
            n.buf[10] = (48 + suffix / 1000) as i8
            n.buf[11] = (48 + (suffix / 100) % 10) as i8
            n.buf[12] = (48 + (suffix / 10) % 10) as i8
            n.buf[13] = (48 + suffix % 10) as i8
            n.len = 14
        }
        n
    }

    // Sprint 228: Lambda-lift a closure expression into a synthetic top-level function.
    // Returns (Lowerer, fn_ref_reg) where fn_ref_reg holds the fn_id.
    fn lower_closure_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // 1. Create a unique name and register the synthetic function
        let closure_name = self.make_closure_name()
        let pair_fn = self.find_or_add_fn_id(closure_name)
        var lo = pair_fn.0
        let closure_fn_id = pair_fn.1

        if closure_fn_id < 0 {
            return lo.emit_unit()
        }

        // 2. Save current function context
        let saved_fn = lo.current_fn
        let saved_func = lo.current_func
        let saved_locals = lo.locals
        let saved_scope = lo.scope_depth
        let saved_loop = lo.loop_depth

        // 3. Switch to the closure function context
        lo.current_fn = closure_fn_id
        lo.current_func = Box::new(ir_empty_function())
        (*lo.current_func).name = closure_name
        lo.locals = Box::new(empty_lower_local_stack())
        lo.scope_depth = 0
        lo.loop_depth = 0

        // 4. Set up closure parameters from ClosureParamList
        var params: &Option<Box<ClosureParamList>> = &e.closure_params
        while true {
            match *params {
                Some(plist) => {
                    let preg_pair = lo.fresh_reg()
                    lo = preg_pair.0
                    let preg = preg_pair.1
                    if (*lo.current_func).param_count < IR_MAX_PARAMS {
                        let pc = (*lo.current_func).param_count
                        (*lo.current_func).param_regs[pc as usize] = preg
                        (*lo.current_func).param_count = pc + 1
                    }
                    lo = lo.bind_local((*plist).head.name, preg, false)
                    params = &(*plist).tail
                }
                _ => break
            }
        }

        // 5. Lower the closure body using the standard optional-expression path.
        let body_pair = lo.lower_opt_expr_ref(&e.closure_body)
        lo = body_pair.0
        lo = lo.emit(ir_return(body_pair.1))

        // 7. Flush the completed closure function back to the module
        var module = *lo.module
        module.functions[closure_fn_id as usize] = *lo.current_func
        lo.module = Box::new(module)

        // 8. Restore the original function context
        lo.current_fn = saved_fn
        lo.current_func = saved_func
        lo.locals = saved_locals
        lo.scope_depth = saved_scope
        lo.loop_depth = saved_loop

        // 9. In the original function, emit IrLoadFnRef to return the fn_id
        let ref_pair = lo.fresh_reg()
        lo = ref_pair.0
        let ref_reg = ref_pair.1
        lo = lo.emit(ir_load_fn_ref(ref_reg, closure_fn_id))
        (lo, ref_reg)
    }

    fn lower_expr(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_ref(&e)
    }
}

// Count struct field initializers in a StructFieldList
fn count_struct_fields_ref(fields: &Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = fields
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_struct_fields(fields: Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    count_struct_fields_ref(&fields)
}

// Count expression list elements (used for array/tuple literals)
fn count_expr_list_ref(elems: &Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = elems
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_expr_list(elems: Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    count_expr_list_ref(&elems)
}

fn ir_reg_list_prepend(reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
    Some(Box::new(IrRegList { head: reg, tail: args }))
}

fn ir_call_needs_validated_patch(
    fn_count: i64,
    callee_strategies: [i64; 2048],
    callee_param_counts: [i64; 2048],
    instr: IrInstr
) -> bool with Mut, Panic, Div {
    if instr.op != IrOpcode::IrCall { return false }
    if instr.fn_id < 0 || instr.fn_id >= fn_count { return false }
    callee_strategies[instr.fn_id as usize] == IR_STRATEGY_INSTRUMENTED &&
    instr.arg_count + 1 == callee_param_counts[instr.fn_id as usize]
}

fn ir_function_has_opcode(func: IrFunction, op: IrOpcode) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if func.instrs[i as usize].op == op {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_insert_instr_front(func: &! IrFunction, instr: IrInstr) -> bool with Mut, Panic, Div {
    if func.instr_count >= 127 {
        return false
    }
    var i = func.instr_count
    while i > 0 {
        func.instrs[i as usize] = func.instrs[(i - 1) as usize]
        i = i - 1
    }
    func.instrs[0] = instr
    func.instr_count = func.instr_count + 1
    true
}

fn ir_patch_validated_call_instr(instr: &! IrInstr, validated_reg: i64) with Mut, Panic, Div, Alloc {
    let patched_args = ir_reg_list_prepend(validated_reg, instr.call_args)
    let pair_regs = ir_reg_list_first_two(patched_args)
    instr.call_args = patched_args
    instr.arg_count = instr.arg_count + 1
    instr.src1 = pair_regs.0
    instr.src2 = pair_regs.1
}

fn ir_patch_validated_calls_in_function(
    fn_count: i64,
    callee_strategies: [i64; 2048],
    callee_param_counts: [i64; 2048],
    func: &! IrFunction,
    stats: &! IrValidatedPatchStats
) with Mut, Panic, Div, Alloc {
    if !ir_function_has_opcode(*func, IrOpcode::IrCall) {
        return
    }

    var needs_patch = false
    var patch_count: i64 = 0
    var shared_validated_reg = IR_INVALID_REG

    var scan_i: i64 = 0
    while scan_i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, func.instrs[scan_i as usize]) {
            needs_patch = true
            break
        }
        scan_i = scan_i + 1
    }
    if !needs_patch {
        return
    }

    if func.compile_strategy != IR_STRATEGY_INSTRUMENTED {
        shared_validated_reg = func.reg_count
        func.reg_count = func.reg_count + 1
        if ir_function_insert_instr_front(func, ir_load_imm(shared_validated_reg, 1)) {
            stats.fallback_insertions = stats.fallback_insertions + 1
        } else {
            return
        }
    }

    var i: i64 = 0
    while i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, func.instrs[i as usize]) {
            let validated_reg = if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                func.param_regs[0]
            } else {
                shared_validated_reg
            }
            var instr = func.instrs[i as usize]
            ir_patch_validated_call_instr(&! instr, validated_reg)
            func.instrs[i as usize] = instr
            patch_count = patch_count + 1
        }
        i = i + 1
    }
    if patch_count > 0 {
        stats.patched_functions = stats.patched_functions + 1
        stats.patched_calls = stats.patched_calls + patch_count
    }
}

fn ir_patch_validated_calls(module: &! IrModule) -> IrValidatedPatchStats with Mut, Panic, Div, Alloc {
    var callee_strategies: [i64; 2048] = [IR_STRATEGY_STANDARD; 2048]
    var callee_param_counts: [i64; 2048] = [0; 2048]
    var stats = ir_empty_validated_patch_stats()
    var i: i64 = 0
    while i < module.fn_count {
        callee_strategies[i as usize] = module.functions[i as usize].compile_strategy
        callee_param_counts[i as usize] = module.functions[i as usize].param_count
        i = i + 1
    }

    i = 0
    while i < module.fn_count {
        var func = module.functions[i as usize]
        ir_patch_validated_calls_in_function(module.fn_count, callee_strategies, callee_param_counts, &! func, &! stats)
        module.functions[i as usize] = func
        i = i + 1
    }
    stats
}

fn lower_program_to_ir_staged_with_lowerer_box_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo2 = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    if !lo2.had_error {
        lo2 = lo2.lower_program_bodies_ref(&prog.items)
    }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        (*patch_stats) = ir_patch_validated_calls(&! (*lo2.module))
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: (*patch_stats),
    }
}

fn lower_program_to_ir_staged_with_lowerer_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let boxed = lower_program_to_ir_staged_with_lowerer_box_trace_ref(lo, prog, patch_stats)
    IrLowerResult {
        module: *boxed.module,
        error_count: boxed.error_count,
        had_error: boxed.had_error,
        patch_stats: boxed.patch_stats,
    }
}

