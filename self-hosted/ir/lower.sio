    // Findings 11 (#2084): look up the per-slot unsigned-int bit set when the
    // local/param was bound with a u8/u16/u32/u64/usize type annotation.
    // Default 0 (signed-or-unknown), so i64-style locals stay in the signed
    // path. Drives the OpDiv→OpUDiv / OpRem→OpURem / OpShr→OpUShr rewrite in
    // lower_binary_expr_ref.
    fn lookup_local_is_unsigned_int(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*(*self.locals).depths).values[i as usize] <= self.scope_depth && ir_name_eq((*(*self.locals).names).values[i as usize], name) {
                return (*(*self.locals).is_unsigned_int).values[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn bind_local_scalar_kind(self, name: Name, kind: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = lo.locals
        var i = (*stk).count - 1
        while i >= 0 {
            if (*(*stk).depths).values[i as usize] <= lo.scope_depth && ir_name_eq((*(*stk).names).values[i as usize], name) {
                (*(*stk).scalar_kind).values[i as usize] = kind
                lo.locals = stk
                return lo
            }
            i = i - 1
        }
        lo
    }

    // Findings 11 (#2084): stamp is_unsigned_int=1 on the local whose
    // type annotation is u8/u16/u32/u64/usize. Drives the per-binary rewrite
    // in lower_binary_expr_ref. Walks the local stack from the top so an
    // inner-shadowing binding (let n: u64 = ... ; { let n = ... ; ... })
    // is correctly marked or unmarked. No-op for names not yet bound
    // (forward reference cases).
    fn bind_local_is_unsigned_int(self, name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = lo.locals
        var i = (*stk).count - 1
        while i >= 0 {
            if (*(*stk).depths).values[i as usize] <= lo.scope_depth && ir_name_eq((*(*stk).names).values[i as usize], name) {
                (*(*stk).is_unsigned_int).values[i as usize] = 1
                lo.locals = stk
                return lo
            }
            i = i - 1
        }
        lo
    }

    // Mark a local as holding a reference (&T / &!T / &[T;N]). IndexGet/Set then
