// AST -> IR lowering

module ir::lower

use parser::ast::*
use ir::ir::*

struct Lowerer {
    module: Box<IrModule>,
    current_fn: i64,
    env: Option<Box<IrEnvList>>,
    scope_depth: i64,
    break_labels: [i64; 256],
    continue_labels: [i64; 256],
    loop_depth: i64,
    error_count: i64,
    had_error: bool,
    // Phase 3.1: Enum variant discriminants
    enum_variants: Box<EnumVariantTable>,
    // Phase 3.2: Struct field layouts
    struct_layouts: Box<StructLayoutTable>,
}

fn lowerer_new() -> Lowerer with Alloc {
    Lowerer {
        module: Box::new(ir_empty_module()),
        current_fn: IR_INVALID_FN,
        env: None,
        scope_depth: 0,
        break_labels: [IR_INVALID_LABEL; 256],
        continue_labels: [IR_INVALID_LABEL; 256],
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: Box::new(empty_enum_variant_table()),
        struct_layouts: Box::new(empty_struct_layout_table()),
    }
}

impl Lowerer {
    fn report_error(self) -> Lowerer with Mut {
        var lo = self
        lo.error_count = lo.error_count + 1
        lo.had_error = true
        lo
    }

    fn enter_scope(self) -> Lowerer with Mut {
        var lo = self
        lo.scope_depth = lo.scope_depth + 1
        lo
    }

    fn exit_scope(self) -> Lowerer with Mut {
        var lo = self
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo
    }

    fn bind_local(self, name: Name, reg: i64, is_mut: bool) -> Lowerer with Mut, Alloc {
        var lo = self
        let b = IrEnvBinding {
            name: name,
            reg: reg,
            is_mut: is_mut,
            depth: lo.scope_depth,
        }
        lo.env = ir_env_push(lo.env, b)
        lo
    }

    fn lookup_local(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        ir_env_lookup(self.env, name, self.scope_depth)
    }

    fn fresh_reg(self) -> (Lowerer, i64) with Mut, Panic, Div {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error()
            return (loe, 0)
        }
        let fn_id = lo.current_fn
        var m = lo.module
        var f = m.functions[fn_id as usize]
        let reg = f.reg_count
        f.reg_count = reg + 1
        m.functions[fn_id as usize] = f
        lo.module = m
        (lo, reg)
    }

    fn fresh_label(self) -> (Lowerer, i64) with Mut, Panic, Div {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error()
            return (loe, 0)
        }
        let fn_id = lo.current_fn
        var m = lo.module
        var f = m.functions[fn_id as usize]
        let label = f.label_count
        f.label_count = label + 1
        m.functions[fn_id as usize] = f
        lo.module = m
        (lo, label)
    }

    fn emit(self, instr: IrInstr) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            return lo.report_error()
        }
        let fn_id = lo.current_fn
        var m = lo.module
        var f = m.functions[fn_id as usize]
        let instr_count = f.instr_count
        if instr_count < IR_MAX_INSTRS {
            f.instrs[instr_count as usize] = instr
            f.instr_count = instr_count + 1
            m.functions[fn_id as usize] = f
            lo.module = m
            lo
        } else {
            lo.report_error()
        }
    }

    fn emit_unit(self) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, 0))
        (lo2, reg)
    }

    fn intern_string(self, n: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.string_count {
            if ir_name_eq(self.module.string_table[i], n) {
                return (self, i)
            }
            i = i + 1
        }
        var lo = self
        if lo.module.string_count < IR_MAX_STRINGS {
            let idx = lo.module.string_count
            var m = lo.module
            m.string_table[idx] = n
            m.string_count = m.string_count + 1
            lo.module = m
            (lo, idx)
        } else {
            let loe = lo.report_error()
            (loe, -1)
        }
    }

    fn find_or_add_fn_id(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.fn_count {
            if ir_name_eq(self.module.functions[i].name, name) {
                return (self, i)
            }
            i = i + 1
        }

        var lo = self
        if lo.module.fn_count < IR_MAX_FUNCS {
            let idx = lo.module.fn_count
            var m = lo.module
            var f = m.functions[idx]
            f.name = name
            f.instr_count = 0
            f.reg_count = 0
            f.label_count = 0
            f.param_count = 0
            f.param_regs = [IR_INVALID_REG; 64]
            m.functions[idx] = f
            m.fn_count = m.fn_count + 1
            lo.module = m
            (lo, idx)
        } else {
            let loe = lo.report_error()
            (loe, -1)
        }
    }

    fn fn_ends_with_return(self) -> bool with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return false
        }
        let count = self.module.functions[self.current_fn].instr_count
        if count <= 0 {
            return false
        }
        let last = self.module.functions[self.current_fn].instrs[count - 1]
        last.op == IrOpcode::IrReturn
    }

    fn push_loop_labels(self, continue_label: i64, break_label: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if lo.loop_depth < 256 {
            lo.continue_labels[lo.loop_depth] = continue_label
            lo.break_labels[lo.loop_depth] = break_label
            lo.loop_depth = lo.loop_depth + 1
            lo
        } else {
            lo.report_error()
        }
    }

    fn pop_loop_labels(self) -> Lowerer with Mut {
        var lo = self
        if lo.loop_depth > 0 {
            lo.loop_depth = lo.loop_depth - 1
        }
        lo
    }

    fn current_break_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            self.break_labels[self.loop_depth - 1]
        }
    }

    fn current_continue_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            self.continue_labels[self.loop_depth - 1]
        }
    }

    // Phase 3.2: Proper struct field index lookup via layout table
    fn field_idx_from_name(self, struct_name: Name, field_name: Name) -> i64 with Mut, Panic, Div {
        // Search layout table for the struct
        var si: i64 = 0
        while si < self.struct_layouts.count {
            if ir_name_eq(self.struct_layouts.entries[si].type_name, struct_name) {
                // Found struct — search its fields
                var fi: i64 = 0
                while fi < self.struct_layouts.entries[si].field_count {
                    if ir_name_eq(self.struct_layouts.entries[si].fields[fi].name, field_name) {
                        return self.struct_layouts.entries[si].fields[fi].index
                    }
                    fi = fi + 1
                }
                // Field not found in layout — fallback to sequential index
                return 0
            }
            si = si + 1
        }
        // Struct not in layout table — fallback: use first byte hash (legacy compat)
        if field_name.len <= 0 {
            0
        } else {
            (field_name.buf[0] as i64) % 64
        }
    }

    // Phase 3.2: Lookup struct field index without needing struct name
    // Used when we don't know the struct type at the call site
    fn field_idx_from_name_simple(self, n: Name) -> i64 with Mut, Panic, Div {
        // Try numeric field access first (.0, .1, .2, ...)
        let first_byte = n.buf[0] as i64
        if n.len == 1 && first_byte >= 48 && first_byte <= 57 {
            return first_byte - 48
        }
        // Fallback: hash-based (will be replaced when we track types)
        if n.len <= 0 {
            0
        } else {
            (n.buf[0] as i64) % 64
        }
    }

    // Phase 3.1: Register enum variant discriminants
    fn register_enum_variants(self, enum_name: Name, variants: Option<Box<VariantDefList>>, next_disc: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        match variants {
            Some(list) => {
                var lo = self
                if lo.enum_variants.count < 1024 {
                    var table = lo.enum_variants
                    table.entries[table.count] = EnumVariantEntry {
                        enum_name: enum_name,
                        variant_name: (*list).head.name,
                        discriminant: next_disc,
                    }
                    table.count = table.count + 1
                    lo.enum_variants = table
                }
                lo.register_enum_variants(enum_name, (*list).tail, next_disc + 1)
            }
            _ => self,
        }
    }

    // Phase 3.1: Lookup enum variant discriminant by variant name
    fn lookup_variant_discriminant(self, variant_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.enum_variants.count {
            if ir_name_eq(self.enum_variants.entries[i].variant_name, variant_name) {
                return self.enum_variants.entries[i].discriminant
            }
            i = i + 1
        }
        -1
    }

    // Phase 3.2: Register struct field layout
    fn register_struct_fields(self, type_name: Name, fields: Option<Box<FieldDefList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        match fields {
            Some(list) => {
                var lo = self
                // Find or create layout entry for this struct
                var layout_idx: i64 = -1
                var si: i64 = 0
                while si < lo.struct_layouts.count {
                    if ir_name_eq(lo.struct_layouts.entries[si].type_name, type_name) {
                        layout_idx = si
                    }
                    si = si + 1
                }
                if layout_idx < 0 {
                    // New struct — add layout entry
                    if lo.struct_layouts.count < 256 {
                        layout_idx = lo.struct_layouts.count
                        var table = lo.struct_layouts
                        table.entries[layout_idx] = StructLayoutEntry {
                            type_name: type_name,
                            fields: [empty_struct_field_entry(); 64],
                            field_count: 0,
                        }
                        table.count = table.count + 1
                        lo.struct_layouts = table
                    } else {
                        return lo.report_error()
                    }
                }
                // Add field to layout
                var table = lo.struct_layouts
                let fc = table.entries[layout_idx].field_count
                if fc < 64 {
                    table.entries[layout_idx].fields[fc] = StructFieldEntry {
                        name: (*list).head.name,
                        index: idx,
                    }
                    table.entries[layout_idx].field_count = fc + 1
                    lo.struct_layouts = table
                }
                lo.register_struct_fields(type_name, (*list).tail, idx + 1)
            }
            _ => self,
        }
    }

    fn lower_program_items(self, items: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                let tail_items: Option<Box<ItemList>> = (*list).tail
                let lo1 = self.lower_item((*list).head)
                lo1.lower_program_items(tail_items)
            }
            _ => self,
        }
    }

    fn lower_item(self, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            self.lower_fn_item(name, item.fn_def)
        } else if k == ItemKind::ItemStruct {
            // Phase 3.2: Register struct field layout
            match item.struct_def {
                Some(sd) => self.register_struct_fields(name, (*sd).fields, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemEnum {
            // Phase 3.1: Register enum variant discriminants
            match item.enum_def {
                Some(ed) => self.register_enum_variants(name, (*ed).variants, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemImpl {
            // Phase 3.3: Lower impl methods as free functions
            match item.impl_def {
                Some(id) => self.lower_impl_methods(name, (*id).methods),
                _ => self,
            }
        } else if k == ItemKind::ItemTypeAlias {
            self
        } else {
            self
        }
    }

    // Phase 3.3: Lower impl block methods as mangled free functions
    // e.g., `impl Checker { fn check_expr(self, e: Expr) -> ... }`
    //     becomes `Checker_check_expr(self: Checker, e: Expr) -> ...`
    fn lower_impl_methods(self, type_name: Name, methods: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match methods {
            Some(list) => {
                var lo = self
                let head = (*list).head
                if head.kind == ItemKind::ItemFn {
                    // Mangle name: TypeName_method_name
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    lo = lo.lower_fn_item(mangled, head.fn_def)
                }
                lo.lower_impl_methods(type_name, (*list).tail)
            }
            _ => self,
        }
    }

    fn lower_fn_params(self, params: Option<Box<ParamList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match params {
            Some(pl) => {
                let pair = self.fresh_reg()
                var lo = pair.0
                let preg = pair.1

                let fn_id = lo.current_fn
                if fn_id < 0 || fn_id >= lo.module.fn_count {
                    lo = lo.report_error()
                } else if lo.module.functions[fn_id as usize].param_count < IR_MAX_PARAMS {
                    var m = lo.module
                    var f = m.functions[fn_id as usize]
                    let param_count = f.param_count
                    f.param_regs[param_count as usize] = preg
                    f.param_count = param_count + 1
                    m.functions[fn_id as usize] = f
                    lo.module = m
                } else {
                    lo = lo.report_error()
                }

                lo = lo.bind_local((*pl).head.name, preg, (*pl).head.is_self_mut)
                lo.lower_fn_params((*pl).tail)
            }
            _ => self,
        }
    }

    fn lower_fn_item(self, name: Name, opt: Option<Box<FnDef>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                print("IR lower fn start\n")
                let pair = self.find_or_add_fn_id(name)
                var lo = pair.0
                let fn_id = pair.1
                print("IR lower fn after find/add\n")
                if fn_id < 0 {
                    return lo.report_error()
                }

                lo.current_fn = fn_id
                lo.env = None
                lo.scope_depth = 0
                lo.loop_depth = 0
                print("IR lower fn context set\n")

                let fd_params: Option<Box<ParamList>> = (*fd).params
                let fd_body: Block = (*fd).body

                lo.scope_depth = lo.scope_depth + 1
                lo = lo.lower_fn_params(fd_params)
                print("IR lower fn params done\n")
                let bpair = lo.lower_block(fd_body)
                lo = bpair.0
                let result_reg = bpair.1
                print("IR lower fn block done\n")

                if !lo.fn_ends_with_return() {
                    print("IR lower fn emit return start\n")
                    lo = lo.emit(ir_return(result_reg))
                    print("IR lower fn emit return done\n")
                }

                print("IR lower fn exit_scope start\n")
                if lo.scope_depth > 0 {
                    lo.scope_depth = lo.scope_depth - 1
                }
                print("IR lower fn exit_scope done\n")
                print("IR lower fn invalidate current_fn start\n")
                lo.current_fn = IR_INVALID_FN
                print("IR lower fn invalidate current_fn done\n")
                print("IR lower fn done\n")
                lo
            }
            _ => self,
        }
    }

    fn lower_block(self, blk: Block) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        print("IR lower block enter\n")
        var lo = self
        lo.scope_depth = lo.scope_depth + 1
        let pair = lo.lower_stmt_list(blk.stmts)
        lo = pair.0
        print("IR lower block after stmt_list\n")
        let reg = pair.1
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        print("IR lower block done\n")
        (lo, reg)
    }

    fn lower_stmt_list(self, stmts: Option<Box<StmtList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match stmts {
            Some(list) => {
                print("IR lower stmt step\n")
                let head_stmt: Stmt = (*list).head
                let tail_stmts: Option<Box<StmtList>> = (*list).tail
                let pair1 = self.lower_stmt(head_stmt)
                let lo1 = pair1.0
                let reg1 = pair1.1
                match tail_stmts {
                    Some(_) => lo1.lower_stmt_list(tail_stmts),
                    _ => (lo1, reg1),
                }
            }
            _ => self.emit_unit(),
        }
    }

    fn lower_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if s.kind == StmtKind::StmtLet {
            self.lower_let_stmt(s, false)
        } else if s.kind == StmtKind::StmtVar {
            self.lower_let_stmt(s, true)
        } else if s.kind == StmtKind::StmtExpr {
            self.lower_expr_stmt(s)
        } else {
            self.lower_assign_stmt(s)
        }
    }

    fn lower_let_stmt(self, s: Stmt, is_mut: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr(s.expr)
        var lo = pair.0
        let reg = pair.1
        lo = lo.bind_local(s.name, reg, is_mut)
        (lo, reg)
    }

    fn lower_expr_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_opt_expr(s.expr)
    }

    fn lower_assign_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_rhs = self.lower_opt_expr(s.expr)
        var lo = pair_rhs.0
        let rhs = pair_rhs.1

        match s.target {
            Some(target_expr) => {
                if (*target_expr).kind == ExprKind::ExprIdent {
                        let dst = lo.lookup_local((*target_expr).name)
                        if dst < 0 {
                            lo = lo.report_error()
                            (lo, rhs)
                        } else {
                            lo = lo.emit(ir_copy(dst, rhs))
                            (lo, dst)
                        }
                } else if (*target_expr).kind == ExprKind::ExprFieldAccess {
                        match (*target_expr).left {
                            Some(base_expr) => {
                                let pair_base = lo.lower_expr(*base_expr)
                                lo = pair_base.0
                                let base_reg = pair_base.1
                                let fidx = lo.field_idx_from_name_simple((*target_expr).name)
                                lo = lo.emit(ir_field_set(base_reg, fidx, rhs, (*target_expr).name))
                                (lo, rhs)
                            }
                            _ => (lo.report_error(), rhs),
                        }
                } else if (*target_expr).kind == ExprKind::ExprIndex {
                        let pair_base = lo.lower_opt_expr((*target_expr).left)
                        lo = pair_base.0
                        let base_reg = pair_base.1
                        let pair_idx = lo.lower_opt_expr((*target_expr).right)
                        lo = pair_idx.0
                        let idx_reg = pair_idx.1
                        lo = lo.emit(ir_index_set(base_reg, idx_reg, rhs))
                        (lo, rhs)
                } else {
                    lo = lo.report_error()
                    (lo, rhs)
                }
            }
            _ => (lo.report_error(), rhs),
        }
    }

    fn lower_opt_expr(self, opt: Option<Box<Expr>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.lower_expr(*e),
            _ => self.emit_unit(),
        }
    }

    fn lower_expr_args(self, opt: Option<Box<ExprList>>) -> (Lowerer, IrRegList, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let head_expr: Expr = (*list).head
                let rest: Option<Box<ExprList>> = (*list).tail
                let pair_head = self.lower_expr(head_expr)
                let lo1: Lowerer = pair_head.0
                let reg: i64 = pair_head.1
                let pair_tail: (Lowerer, IrRegList, i64) = lo1.lower_expr_args(rest)
                let lo2: Lowerer = pair_tail.0
                let tail_args: IrRegList = pair_tail.1
                let tail_count: i64 = pair_tail.2
                if tail_count <= 0 {
                    let node: IrRegList = IrRegList { head: reg, tail: None }
                    (lo2, node, 1)
                } else {
                    let node: IrRegList = IrRegList { head: reg, tail: Some(Box::new(tail_args)) }
                    (lo2, node, tail_count + 1)
                }
            }
            _ => {
                let empty = IrRegList { head: 0, tail: None }
                (self, empty, 0)
            }
        }
    }

    fn prepend_arg(self, reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
        Some(Box::new(IrRegList { head: reg, tail: args }))
    }

    fn expr_list_len(self, args: Option<Box<ExprList>>) -> i64 with Alloc {
        match args {
            Some(list) => 1 + self.expr_list_len((*list).tail),
            _ => 0,
        }
    }

    fn ir_name_is_knowledge_kaxi_publish(self, n: Name) -> bool {
        n.len == 24 &&
        n.buf[0] == 95 as i8 &&
        n.buf[1] == 95 as i8 &&
        n.buf[2] == 107 as i8 &&
        n.buf[3] == 110 as i8 &&
        n.buf[4] == 111 as i8 &&
        n.buf[5] == 119 as i8 &&
        n.buf[6] == 108 as i8 &&
        n.buf[7] == 101 as i8 &&
        n.buf[8] == 100 as i8 &&
        n.buf[9] == 103 as i8 &&
        n.buf[10] == 101 as i8 &&
        n.buf[11] == 95 as i8 &&
        n.buf[12] == 107 as i8 &&
        n.buf[13] == 97 as i8 &&
        n.buf[14] == 120 as i8 &&
        n.buf[15] == 105 as i8 &&
        n.buf[16] == 95 as i8 &&
        n.buf[17] == 112 as i8 &&
        n.buf[18] == 117 as i8 &&
        n.buf[19] == 98 as i8 &&
        n.buf[20] == 108 as i8 &&
        n.buf[21] == 105 as i8 &&
        n.buf[22] == 115 as i8 &&
        n.buf[23] == 104 as i8
    }

    fn kaxi_sanitize_op_kind(self, raw_op: i64) -> i64 {
        if raw_op < 0 || raw_op > 15 {
            0
        } else {
            raw_op
        }
    }

    fn kaxi_extract_publish_args(self, args: Option<Box<ExprList>>) -> (Option<Box<Expr>>, i64) with Alloc {
        match args {
            Some(list) => {
                let value_expr = (*list).head
                let op_kind = match (*list).tail {
                    Some(tail1) => {
                        let op_expr = (*tail1).head
                        if op_expr.kind == ExprKind::ExprIntLit {
                            self.kaxi_sanitize_op_kind(op_expr.int_val)
                        } else {
                            0
                        }
                    }
                    _ => 0,
                }
                (Some(Box::new(value_expr)), op_kind)
            }
            _ => (None, 0),
        }
    }

    fn kaxi_pack_default_flags(self, op_kind_raw: i64) -> i64 {
        let op_kind = self.kaxi_sanitize_op_kind(op_kind_raw)
        // Native keyword contract: alpha_q8=16, success_inc=1 (except pass), failure_inc=0.
        let success_inc = if op_kind == 0 { 0 } else { 1 }
        ((16 as i64) << 24) | (success_inc << 16) | op_kind
    }

    fn lower_kaxi_publish_call(self, fn_id: i64, callee_name: Name, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let extracted = self.kaxi_extract_publish_args(args)
        let op_kind = extracted.1
        let pair_value = match extracted.0 {
            Some(value_expr) => self.lower_expr(*value_expr),
            _ => self.emit_unit(),
        }
        var lo = pair_value.0
        let value_reg = pair_value.1

        // Synthesize default epistemic payload fields for hardware_publish(value, op_kind):
        // variance=0, provenance=0 sentinel, confidence=1.0, flags=packed(op_kind).
        let pair_var = lo.fresh_reg()
        lo = pair_var.0
        let var_reg = pair_var.1
        lo = lo.emit(ir_load_imm(var_reg, 0))

        let pair_prov = lo.fresh_reg()
        lo = pair_prov.0
        let prov_reg = pair_prov.1
        lo = lo.emit(ir_load_imm(prov_reg, 0))

        let pair_conf = lo.fresh_reg()
        lo = pair_conf.0
        let conf_reg = pair_conf.1
        lo = lo.emit(ir_load_float(conf_reg, 1.0))

        let pair_flags = lo.fresh_reg()
        lo = pair_flags.0
        let flags_reg = pair_flags.1
        lo = lo.emit(ir_load_imm(flags_reg, lo.kaxi_pack_default_flags(op_kind)))

        var call_args = lo.prepend_arg(flags_reg, None)
        call_args = lo.prepend_arg(conf_reg, call_args)
        call_args = lo.prepend_arg(prov_reg, call_args)
        call_args = lo.prepend_arg(var_reg, call_args)
        call_args = lo.prepend_arg(value_reg, call_args)

        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_call(dst, fn_id, callee_name, call_args, 5))
        (lo, dst)
    }

    fn expr_to_callee_name(self, e: Expr) -> Name with Mut, Panic, Div {
        if e.kind == ExprKind::ExprIdent {
            e.name
        } else if e.kind == ExprKind::ExprPath {
            ir_path_first_name(e.path)
        } else if e.kind == ExprKind::ExprFieldAccess {
            e.name
        } else if e.kind == ExprKind::ExprMethodCall {
            e.name
        } else {
            ir_empty_name()
        }
    }

    fn lower_struct_fields(self, base_reg: i64, fields: Option<Box<StructFieldList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match fields {
            Some(list) => {
                let pair = self.lower_expr((*list).head.value)
                var lo = pair.0
                let vreg = pair.1
                lo = lo.emit(ir_field_set(base_reg, idx, vreg, (*list).head.name))
                lo.lower_struct_fields(base_reg, (*list).tail, idx + 1)
            }
            _ => self,
        }
    }

    fn lower_array_elems(self, base_reg: i64, elems: Option<Box<ExprList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match elems {
            Some(list) => {
                let pair_v = self.lower_expr((*list).head)
                var lo = pair_v.0
                let vreg = pair_v.1
                let pair_i = lo.fresh_reg()
                lo = pair_i.0
                let ireg = pair_i.1
                lo = lo.emit(ir_load_imm(ireg, idx))
                lo = lo.emit(ir_index_set(base_reg, ireg, vreg))
                lo.lower_array_elems(base_reg, (*list).tail, idx + 1)
            }
            _ => self,
        }
    }

    // Lower match arms as a linear if/else chain
    fn lower_match_arms(self, scrut: i64, res: i64, l_end: i64, arms: Option<Box<MatchArmList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match arms {
            Some(list) => {
                let arm = (*list).head
                let lo = self.lower_match_arm(scrut, res, l_end, arm)
                lo.lower_match_arms(scrut, res, l_end, (*list).tail)
            }
            _ => self,
        }
    }

    // Lower a single match arm: test pattern, conditionally execute body
    fn lower_match_arm(self, scrut: i64, res: i64, l_end: i64, arm: MatchArm) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let pat = arm.pattern
        if pat.kind == PatternKind::PatWildcard {
            // Wildcard always matches — evaluate body unconditionally
            let pair = self.lower_expr(arm.body)
            var lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo
        } else if pat.kind == PatternKind::PatBinding {
            // Binding always matches — bind scrutinee to name, evaluate body
            var lo = self.bind_local(pat.name, scrut, pat.is_mut)
            let pair = lo.lower_expr(arm.body)
            lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo
        } else if pat.kind == PatternKind::PatEnum {
            let variant_name = ir_path_last_name(pat.path)
            // Check for Some/None (Option<Box<T>> as nullable pointer)
            let is_some = ir_name_is_some(variant_name)
            let is_none = ir_name_is_none(variant_name)
            if is_some {
                // Some(x): test scrutinee != 0, bind inner x = scrutinee
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee == 0 (skip this arm)
                lo = lo.emit(ir_branch_false(scrut, l_skip))
                // Bind the inner pattern (first sub_pattern) to scrutinee value
                lo = lo.bind_match_sub_pattern(scrut, pat.sub_patterns)
                let pair_b = lo.lower_expr(arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else if is_none {
                // None: test scrutinee == 0
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee != 0 (skip this arm)
                lo = lo.emit(ir_branch_true(scrut, l_skip))
                let pair_b = lo.lower_expr(arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else {
                // Enum variant: compare scrutinee to discriminant
                let disc = self.lookup_variant_discriminant(variant_name)
                if disc >= 0 {
                    let pair_l = self.fresh_label()
                    var lo = pair_l.0
                    let l_skip = pair_l.1
                    let pair_d = lo.fresh_reg()
                    lo = pair_d.0
                    let disc_reg = pair_d.1
                    lo = lo.emit(ir_load_imm(disc_reg, disc))
                    let pair_cmp = lo.fresh_reg()
                    lo = pair_cmp.0
                    let cmp_reg = pair_cmp.1
                    lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, disc_reg))
                    lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
                    let pair_b = lo.lower_expr(arm.body)
                    lo = pair_b.0
                    let body_reg = pair_b.1
                    lo = lo.emit(ir_copy(res, body_reg))
                    lo = lo.emit(ir_jump(l_end))
                    lo = lo.emit(ir_label(l_skip))
                    lo
                } else {
                    // Unknown variant — skip this arm
                    self
                }
            }
        } else if pat.kind == PatternKind::PatIntLit {
            // Integer literal: compare scrutinee to int_val
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            let pair_d = lo.fresh_reg()
            lo = pair_d.0
            let lit_reg = pair_d.1
            lo = lo.emit(ir_load_imm(lit_reg, pat.int_val))
            let pair_cmp = lo.fresh_reg()
            lo = pair_cmp.0
            let cmp_reg = pair_cmp.1
            lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, lit_reg))
            lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
            let pair_b = lo.lower_expr(arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolTrue {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_false(scrut, l_skip))
            let pair_b = lo.lower_expr(arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolFalse {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_true(scrut, l_skip))
            let pair_b = lo.lower_expr(arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else {
            // Unsupported pattern — skip
            self
        }
    }

    // Lower Some(x) — just evaluate the first argument (identity)
    fn lower_expr_args_first(self, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(list) => self.lower_expr((*list).head),
            _ => self.emit_unit(),
        }
    }

    // Lower Box::new(x) — alloc 8 bytes, store value, return pointer
    fn lower_box_new(self, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(list) => {
                let pair_v = self.lower_expr((*list).head)
                var lo = pair_v.0
                let val_reg = pair_v.1
                // Allocate 8 bytes on heap
                let pair_dst = lo.fresh_reg()
                lo = pair_dst.0
                let ptr_reg = pair_dst.1
                lo = lo.emit(ir_alloc(ptr_reg, 8))
                // Store value at ptr[0]
                lo = lo.emit(ir_field_set(ptr_reg, 0, val_reg, ir_empty_name()))
                (lo, ptr_reg)
            }
            _ => self.emit_unit(),
        }
    }

    // prove_robust(contest, policy) → IrProveRobust (zero-cost copy; policy is proof-time only)
    fn lower_prove_robust_call(self, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Extract first arg (contest expression)
        let contest_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        // Extract second arg (policy expression)
        let policy_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let contest_pair = self.lower_opt_expr(contest_expr)
        let lo1 = contest_pair.0
        let contest_reg = contest_pair.1
        let policy_pair = lo1.lower_opt_expr(policy_expr)
        let lo2 = policy_pair.0
        let policy_reg = policy_pair.1
        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let lo4 = lo3.emit(ir_prove_robust(dst_reg, contest_reg, policy_reg))
        (lo4, dst_reg)
    }

    // Bind the first sub-pattern of a Some(x) match to the scrutinee value
    fn bind_match_sub_pattern(self, scrut: i64, pats: Option<Box<PatternList>>) -> Lowerer with Mut, Panic, Div, Alloc {
        match pats {
            Some(list) => {
                let inner = (*list).head
                if inner.kind == PatternKind::PatBinding {
                    self.bind_local(inner.name, scrut, inner.is_mut)
                } else if inner.kind == PatternKind::PatWildcard {
                    // _ inside Some(_) — no binding needed
                    self
                } else {
                    self
                }
            }
            _ => self,
        }
    }

    fn lower_expr(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        print("IR lower expr enter\n")
        if e.kind == ExprKind::ExprIntLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprFloatLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_float(reg, e.float_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBoolTrue {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, true))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBoolFalse {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, false))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprStringLit {
            let pair_idx = self.intern_string(e.name)
            let lo1 = pair_idx.0
            let idx = pair_idx.1
            let pair_reg = lo1.fresh_reg()
            let lo2 = pair_reg.0
            let reg = pair_reg.1
            let lo3 = lo2.emit(ir_load_string(reg, idx, e.name))
            (lo3, reg)
        } else if e.kind == ExprKind::ExprCharLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprIdent {
            // Check for None (null pointer for Option)
            if ir_name_is_none(e.name) {
                let pair = self.fresh_reg()
                let lo = pair.0
                let reg = pair.1
                let lo2 = lo.emit(ir_load_imm(reg, 0))
                return (lo2, reg)
            }
            let src = self.lookup_local(e.name)
            if src >= 0 {
                (self, src)
            } else {
                let loe = self.report_error()
                loe.emit_unit()
            }
        } else if e.kind == ExprKind::ExprPath {
            // Check if this is an enum variant reference (e.g., IrOpcode::IrLoadImm)
            if e.path.seg_count >= 2 {
                let variant_name = ir_path_last_name(e.path)
                // Check for None (Option::None)
                if ir_name_is_none(variant_name) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
                let disc = self.lookup_variant_discriminant(variant_name)
                if disc >= 0 {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, disc))
                    return (lo2, reg)
                }
            }
            // Check for single-segment None
            if e.path.seg_count == 1 {
                let n = ir_path_first_name(e.path)
                if ir_name_is_none(n) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
            }
            // Not an enum variant — try local variable lookup
            let n = ir_path_first_name(e.path)
            let src = self.lookup_local(n)
            if src >= 0 {
                (self, src)
            } else {
                // Could be a function name used as a value — emit unit for now
                let loe = self.report_error()
                loe.emit_unit()
            }
        } else if e.kind == ExprKind::ExprCall {
            let callee_name = match e.left {
                Some(c) => self.expr_to_callee_name(*c),
                None => ir_empty_name(),
            }
            // Special case: Some(x) — identity (Option = nullable pointer)
            if ir_name_is_some(callee_name) {
                return self.lower_expr_args_first(e.args)
            }
            // Special case: Box::new(x) — alloc 8 bytes, store value, return pointer
            if ir_name_is_box(callee_name) {
                return self.lower_box_new(e.args)
            }
            // Special case: prove_robust(contest, policy) — IrProveRobust (zero-cost copy)
            if ir_name_is_prove_robust(callee_name) {
                return self.lower_prove_robust_call(e.args)
            }
            let pair_fn = self.find_or_add_fn_id(callee_name)
            let lo1 = pair_fn.0
            let fn_id = pair_fn.1
            if lo1.ir_name_is_knowledge_kaxi_publish(callee_name) {
                // Parser canonicalizes hardware_publish(value, KAXI::op) into this intrinsic with
                // 2 arguments. Lowering expands only this canonical form to the runtime
                // contract of 5 arguments; explicit 5-arg intrinsic calls pass through unchanged.
                if lo1.expr_list_len(e.args) == 2 {
                    return lo1.lower_kaxi_publish_call(fn_id, callee_name, e.args)
                }
            }
            let pair_args: (Lowerer, IrRegList, i64) = lo1.lower_expr_args(e.args)
            let lo2 = pair_args.0
            let args: Option<Box<IrRegList>> = if pair_args.2 <= 0 { None } else { Some(Box::new(pair_args.1)) }
            let argc = pair_args.2
            let pair_d = lo2.fresh_reg()
            let lo3 = pair_d.0
            let dst = pair_d.1
            let lo4 = lo3.emit(ir_call(dst, fn_id, callee_name, args, argc))
            (lo4, dst)
        } else if e.kind == ExprKind::ExprBinary {
            let pair_l = self.lower_opt_expr(e.left)
            let lo1 = pair_l.0
            let lhs = pair_l.1
            let pair_r = lo1.lower_opt_expr(e.right)
            let lo2 = pair_r.0
            let rhs = pair_r.1
            let pair_d = lo2.fresh_reg()
            let lo3 = pair_d.0
            let dst = pair_d.1
            let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
            (lo4, dst)
        } else if e.kind == ExprKind::ExprUnary {
            let pair_s = self.lower_opt_expr(e.left)
            let lo1 = pair_s.0
            let src = pair_s.1
            let pair_d = lo1.fresh_reg()
            let lo2 = pair_d.0
            let dst = pair_d.1
            let lo3 = lo2.emit(ir_unaryop(dst, e.un_op, src))
            (lo3, dst)
        } else if e.kind == ExprKind::ExprFieldAccess {
            let pair_b = self.lower_opt_expr(e.left)
            let lo1 = pair_b.0
            let base = pair_b.1
            let fidx = lo1.field_idx_from_name_simple(e.name)
            let pair_d = lo1.fresh_reg()
            let lo2 = pair_d.0
            let dst = pair_d.1
            let lo3 = lo2.emit(ir_field_get(dst, base, fidx, e.name))
            (lo3, dst)
        } else if e.kind == ExprKind::ExprIndex {
            let pair_b = self.lower_opt_expr(e.left)
            let lo1 = pair_b.0
            let base = pair_b.1
            let pair_i = lo1.lower_opt_expr(e.right)
            let lo2 = pair_i.0
            let idx = pair_i.1
            let pair_d = lo2.fresh_reg()
            let lo3 = pair_d.0
            let dst = pair_d.1
            let lo4 = lo3.emit(ir_index_get(dst, base, idx))
            (lo4, dst)
        } else if e.kind == ExprKind::ExprMethodCall {
            let pair_b = self.lower_opt_expr(e.left)
            let lo1 = pair_b.0
            let base_reg = pair_b.1
            let pair_args: (Lowerer, IrRegList, i64) = lo1.lower_expr_args(e.args)
            let lo2 = pair_args.0
            let arg_list: Option<Box<IrRegList>> = if pair_args.2 <= 0 { None } else { Some(Box::new(pair_args.1)) }
            let arg_count = pair_args.2
            let args2 = lo2.prepend_arg(base_reg, arg_list)
            let pair_fn = lo2.find_or_add_fn_id(e.name)
            let lo3 = pair_fn.0
            let fn_id = pair_fn.1
            let pair_d = lo3.fresh_reg()
            let lo4 = pair_d.0
            let dst = pair_d.1
            let lo5 = lo4.emit(ir_call(dst, fn_id, e.name, args2, arg_count + 1))
            (lo5, dst)
        } else if e.kind == ExprKind::ExprIf {
            let pair_cond = self.lower_opt_expr(e.left)
            let lo1 = pair_cond.0
            let cond = pair_cond.1

            let pair_l_else = lo1.fresh_label()
            let lo2 = pair_l_else.0
            let l_else = pair_l_else.1
            let pair_l_end = lo2.fresh_label()
            let lo3 = pair_l_end.0
            let l_end = pair_l_end.1
            let pair_res = lo3.fresh_reg()
            let lo4 = pair_res.0
            let res = pair_res.1

            var lo = lo4.emit(ir_branch_false(cond, l_else))

            let pair_then = match e.block {
                Some(blk) => lo.lower_block(*blk),
                None => lo.emit_unit(),
            }
            lo = pair_then.0
            let then_reg = pair_then.1
            lo = lo.emit(ir_copy(res, then_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_else))

            let pair_else = match e.else_expr {
                Some(ee) => lo.lower_expr(*ee),
                None => lo.emit_unit(),
            }
            lo = pair_else.0
            let else_reg = pair_else.1
            lo = lo.emit(ir_copy(res, else_reg))
            lo = lo.emit(ir_label(l_end))
            (lo, res)
        } else if e.kind == ExprKind::ExprMatch {
            let pair_scrut = self.lower_opt_expr(e.left)
            var lo = pair_scrut.0
            let scrut = pair_scrut.1
            // Allocate result register and end label
            let pair_res = lo.fresh_reg()
            lo = pair_res.0
            let res = pair_res.1
            let pair_end = lo.fresh_label()
            lo = pair_end.0
            let l_end = pair_end.1
            lo = lo.lower_match_arms(scrut, res, l_end, e.arms)
            // Default fallback: result = 0
            lo = lo.emit(ir_load_imm(res, 0))
            lo = lo.emit(ir_label(l_end))
            (lo, res)
        } else if e.kind == ExprKind::ExprWhile {
            let pair_l_top = self.fresh_label()
            let lo1 = pair_l_top.0
            let l_top = pair_l_top.1
            let pair_l_end = lo1.fresh_label()
            let lo2 = pair_l_end.0
            let l_end = pair_l_end.1

            var lo = lo2.emit(ir_label(l_top))
            let pair_cond = lo.lower_opt_expr(e.left)
            lo = pair_cond.0
            let cond = pair_cond.1
            lo = lo.emit(ir_branch_false(cond, l_end))
            lo = lo.push_loop_labels(l_top, l_end)
            match e.block {
                Some(blk) => {
                    let pair_body = lo.lower_block(*blk)
                    lo = pair_body.0
                }
                None => {}
            }
            lo = lo.pop_loop_labels()
            lo = lo.emit(ir_jump(l_top))
            lo = lo.emit(ir_label(l_end))
            lo.emit_unit()
        } else if e.kind == ExprKind::ExprLoop {
            let pair_l_top = self.fresh_label()
            let lo1 = pair_l_top.0
            let l_top = pair_l_top.1
            let pair_l_end = lo1.fresh_label()
            let lo2 = pair_l_end.0
            let l_end = pair_l_end.1

            var lo = lo2.emit(ir_label(l_top))
            lo = lo.push_loop_labels(l_top, l_end)
            match e.block {
                Some(blk) => {
                    let pair_body = lo.lower_block(*blk)
                    lo = pair_body.0
                }
                None => {}
            }
            lo = lo.pop_loop_labels()
            lo = lo.emit(ir_jump(l_top))
            lo = lo.emit(ir_label(l_end))
            lo.emit_unit()
        } else if e.kind == ExprKind::ExprBlock {
            match e.block {
                Some(blk) => self.lower_block(*blk),
                None => self.emit_unit(),
            }
        } else if e.kind == ExprKind::ExprReturn {
            let pair = self.lower_opt_expr(e.left)
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_return(reg))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBreak {
            let pair = self.lower_opt_expr(e.left)
            var lo = pair.0
            let reg = pair.1
            let target = lo.current_break_label()
            if target >= 0 {
                lo = lo.emit(ir_jump(target))
            } else {
                lo = lo.report_error()
            }
            (lo, reg)
        } else if e.kind == ExprKind::ExprContinue {
            let pair = self.emit_unit()
            var lo = pair.0
            let reg = pair.1
            let target = lo.current_continue_label()
            if target >= 0 {
                lo = lo.emit(ir_jump(target))
            } else {
                lo = lo.report_error()
            }
            (lo, reg)
        } else if e.kind == ExprKind::ExprStructLit {
            let pair_dst = self.fresh_reg()
            var lo = pair_dst.0
            let dst = pair_dst.1
            lo = lo.emit(ir_alloc(dst, 0))
            lo = lo.lower_struct_fields(dst, e.fields, 0)
            (lo, dst)
        } else if e.kind == ExprKind::ExprArrayLit {
            let pair_dst = self.fresh_reg()
            var lo = pair_dst.0
            let dst = pair_dst.1
            lo = lo.emit(ir_alloc(dst, 1))
            lo = lo.lower_array_elems(dst, e.args, 0)
            (lo, dst)
        } else if e.kind == ExprKind::ExprTupleLit {
            let pair_dst = self.fresh_reg()
            var lo = pair_dst.0
            let dst = pair_dst.1
            lo = lo.emit(ir_alloc(dst, 2))
            lo = lo.lower_array_elems(dst, e.args, 0)
            (lo, dst)
        } else if e.kind == ExprKind::ExprRange {
            let pair_l = self.lower_opt_expr(e.left)
            let lo1 = pair_l.0
            let lhs = pair_l.1
            let pair_r = lo1.lower_opt_expr(e.right)
            let lo2 = pair_r.0
            let rhs = pair_r.1
            let pair_d = lo2.fresh_reg()
            let lo3 = pair_d.0
            let dst = pair_d.1
            let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
            (lo4, dst)
        } else if e.kind == ExprKind::ExprCast {
            // Lower the inner expression; the cast is a no-op at IR level for now
            self.lower_opt_expr(e.left)
        } else if e.kind == ExprKind::ExprContest {
            // Contest<T> introduction: `contest [M1, M2, ...] on subject`
            // Semantics: lower the subject expression; wrap in IrContest for provenance.
            // At machine level IrContest compiles to MOV dst, src (zero-cost wrapper).
            // Model args are proof-time annotations, not evaluated at runtime in the MVP.
            let sub_pair = self.lower_opt_expr(e.left)
            let lo1 = sub_pair.0
            let subject_reg = sub_pair.1
            // Count model args from e.args list
            let model_count = count_expr_list(e.args)
            let dst_pair = lo1.fresh_reg()
            let lo2 = dst_pair.0
            let dst_reg = dst_pair.1
            let lo3 = lo2.emit(ir_contest(dst_reg, subject_reg, model_count))
            (lo3, dst_reg)
        } else {
            let loe = self.report_error()
            loe.emit_unit()
        }
    }
}

// Count struct field initializers in a StructFieldList
fn count_struct_fields(fields: Option<Box<StructFieldList>>) -> i64 with Alloc {
    match fields {
        Some(list) => 1 + count_struct_fields((*list).tail),
        _ => 0,
    }
}

// Count expression list elements (used for array/tuple literals)
fn count_expr_list(elems: Option<Box<ExprList>>) -> i64 with Alloc {
    match elems {
        Some(list) => 1 + count_expr_list((*list).tail),
        _ => 0,
    }
}

fn lower_program_to_ir(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    print("IR lower init start\n")
    let lo = lowerer_new()
    print("IR lower init done\n")
    let lo2 = lo.lower_program_items(prog.items)
    print("IR lower items done\n")
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
    }
}
