    fn emit_i64_const(self, value: i64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, value))
        (lo2, reg)
    }

    fn emit_f64_const(self, value: f64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, f64_to_bits(value)))
        let lo3 = lo2.emit(ir_mark_float_reg(reg))
        (lo3, reg)
    }

    fn emit_name_string(self, n: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_idx = self.intern_string(n)
        let lo1 = pair_idx.0
        let idx = pair_idx.1
        let pair_reg = lo1.fresh_reg()
        let lo2 = pair_reg.0
        let reg = pair_reg.1
        let lo3 = lo2.emit(ir_load_string(reg, idx, n))
        (lo3, reg)
    }

    fn contest_witness_kind_from_callee(self, n: Name) -> i64 with Mut, Panic, Div {
        if n.len == 14
            && n.buf[0] == 115 as i8 && n.buf[1] == 105 as i8 && n.buf[2] == 103 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 95 as i8 && n.buf[5] == 99 as i8 && n.buf[6] == 111 as i8 && n.buf[7] == 110 as i8
            && n.buf[8] == 115 as i8 && n.buf[9] == 101 as i8 && n.buf[10] == 110 as i8 && n.buf[11] == 115 as i8
            && n.buf[12] == 117 as i8 && n.buf[13] == 115 as i8 {
            return 0
        }
        if n.len == 13
            && n.buf[0] == 114 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 108 as i8 && n.buf[3] == 97 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 105 as i8 && n.buf[6] == 118 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 95 as i8 && n.buf[9] == 98 as i8 && n.buf[10] == 97 as i8 && n.buf[11] == 110 as i8
            && n.buf[12] == 100 as i8 {
            return 1
        }
        if n.len == 13
            && n.buf[0] == 109 as i8 && n.buf[1] == 97 as i8 && n.buf[2] == 120 as i8 && n.buf[3] == 95 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 97 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 108 as i8
            && n.buf[8] == 95 as i8 && n.buf[9] == 114 as i8 && n.buf[10] == 105 as i8 && n.buf[11] == 115 as i8
            && n.buf[12] == 107 as i8 {
            return 2
        }
        if n.len == 22
            && n.buf[0] == 109 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 99 as i8 && n.buf[3] == 104 as i8
            && n.buf[4] == 97 as i8 && n.buf[5] == 110 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 115 as i8
            && n.buf[8] == 116 as i8 && n.buf[9] == 105 as i8 && n.buf[10] == 99 as i8 && n.buf[11] == 95 as i8
            && n.buf[12] == 100 as i8 && n.buf[13] == 105 as i8 && n.buf[14] == 118 as i8 && n.buf[15] == 101 as i8
            && n.buf[16] == 114 as i8 && n.buf[17] == 103 as i8 && n.buf[18] == 101 as i8 && n.buf[19] == 110 as i8
            && n.buf[20] == 99 as i8 && n.buf[21] == 101 as i8 {
            return 3
        }
        if n.len == 21
            && n.buf[0] == 105 as i8 && n.buf[1] == 100 as i8 && n.buf[2] == 101 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 105 as i8 && n.buf[6] == 102 as i8 && n.buf[7] == 105 as i8
            && n.buf[8] == 97 as i8 && n.buf[9] == 98 as i8 && n.buf[10] == 105 as i8 && n.buf[11] == 108 as i8
            && n.buf[12] == 105 as i8 && n.buf[13] == 116 as i8 && n.buf[14] == 121 as i8 && n.buf[15] == 95 as i8
            && n.buf[16] == 102 as i8 && n.buf[17] == 108 as i8 && n.buf[18] == 111 as i8 && n.buf[19] == 111 as i8
            && n.buf[20] == 114 as i8 {
            return 4
        }
        if n.len == 12
            && n.buf[0] == 100 as i8 && n.buf[1] == 105 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 97 as i8
            && n.buf[4] == 103 as i8 && n.buf[5] == 114 as i8 && n.buf[6] == 101 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 109 as i8 && n.buf[9] == 101 as i8 && n.buf[10] == 110 as i8 && n.buf[11] == 116 as i8 {
            return 5
        }
        if n.len == 14
            && n.buf[0] == 99 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 110 as i8
            && n.buf[4] == 116 as i8 && n.buf[5] == 101 as i8 && n.buf[6] == 114 as i8 && n.buf[7] == 101 as i8
            && n.buf[8] == 120 as i8 && n.buf[9] == 97 as i8 && n.buf[10] == 109 as i8 && n.buf[11] == 112 as i8
            && n.buf[12] == 108 as i8 && n.buf[13] == 101 as i8 {
            return 6
        }
        if n.len == 17
            && n.buf[0] == 112 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 116 as i8
            && n.buf[4] == 101 as i8 && n.buf[5] == 114 as i8 && n.buf[6] == 105 as i8 && n.buf[7] == 111 as i8
            && n.buf[8] == 114 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 119 as i8 && n.buf[11] == 101 as i8
            && n.buf[12] == 105 as i8 && n.buf[13] == 103 as i8 && n.buf[14] == 104 as i8 && n.buf[15] == 116 as i8
            && n.buf[16] == 115 as i8 {
            return 7
        }
        -1
    }

    fn emit_named_field(self, base_reg: i64, field_name: Name, value_reg: i64) -> Lowerer with Mut, Panic, Div {
        let field_idx = self.field_idx_from_name_simple(field_name)
        self.emit(ir_field_set(base_reg, field_idx, value_reg, field_name))
    }

    fn emit_name_array_values(self, base_reg: i64, names: [Name; 16], count: i64, idx: i64) -> Lowerer with Mut, Panic, Div {
        if idx >= count || idx >= 16 {
            return self
        }
        let pair_name = self.emit_name_string(names[idx as usize])
        let lo1 = pair_name.0
        let name_reg = pair_name.1
        let pair_idx = lo1.emit_i64_const(idx)
        let lo2 = pair_idx.0
        let idx_reg = pair_idx.1
        let lo3 = lo2.emit(ir_index_set(base_reg, idx_reg, name_reg))
        lo3.emit_name_array_values(base_reg, names, count, idx + 1)
    }

    fn emit_f64_array_values(self, base_reg: i64, values: [f64; 16], count: i64, idx: i64) -> Lowerer with Mut, Panic, Div {
        if idx >= count || idx >= 16 {
            return self
        }
        let pair_value = self.emit_f64_const(values[idx as usize])
        let lo1 = pair_value.0
        let value_reg = pair_value.1
        let pair_idx = lo1.emit_i64_const(idx)
        let lo2 = pair_idx.0
        let idx_reg = pair_idx.1
        let lo3 = lo2.emit(ir_index_set(base_reg, idx_reg, value_reg))
        lo3.emit_f64_array_values(base_reg, values, count, idx + 1)
    }

    fn aggregate_storage_bytes(self, elem_count: i64) -> i64 {
        let _lo = self
        if elem_count <= 0 { 8 } else { elem_count * 8 }
    }

    fn emit_fixed_array_value_copy(self, src_reg: i64, elem_count: i64, elem_is_float: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst_reg = pair_dst.1
        lo = lo.emit(ir_alloc_array(dst_reg, lo.aggregate_storage_bytes(elem_count), elem_count))
        if elem_is_float {
            lo = lo.emit(ir_mark_float_reg(dst_reg))
            lo = lo.bind_reg_array_elem_float(dst_reg)
        }
        if elem_count <= 0 {
            return (lo, dst_reg)
        }

        let pair_idx = lo.emit_i64_const(0)
        lo = pair_idx.0
        let idx_reg = pair_idx.1
        let pair_limit = lo.emit_i64_const(elem_count)
        lo = pair_limit.0
        let limit_reg = pair_limit.1
        let pair_one = lo.emit_i64_const(1)
        lo = pair_one.0
        let one_reg = pair_one.1
        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let top_label = pair_top.1
        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let end_label = pair_end.1

        lo = lo.emit(ir_label(top_label))
        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond_reg = pair_cond.1
        lo = lo.emit(ir_binop(cond_reg, idx_reg, BinaryOp::OpLt, limit_reg))
        lo = lo.emit(ir_branch_false(cond_reg, end_label))

        let pair_elem = lo.fresh_reg()
        lo = pair_elem.0
        let elem_reg = pair_elem.1
        var load_instr = ir_index_get(elem_reg, src_reg, idx_reg)
        if elem_is_float {
            load_instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        lo = lo.emit(load_instr)
        lo = lo.emit(ir_index_set(dst_reg, idx_reg, elem_reg))

        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, idx_reg, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(idx_reg, next_reg))
        lo = lo.emit(ir_jump(top_label))
        lo = lo.emit(ir_label(end_label))
        (lo, dst_reg)
    }

    fn expr_is_zero_fill_value(self, e: Expr) -> bool {
        let _lo = self
        if e.kind == ExprKind::ExprIntLit { return e.int_val == 0 }
        if e.kind == ExprKind::ExprBoolFalse { return true }
        if e.kind == ExprKind::ExprFloatLit { return e.float_val == 0.0 }
        false
    }

    fn lower_array_repeat_fill(self, base_reg: i64, value_reg: i64, repeat_count: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        if repeat_count <= 0 {
            return self
        }

        let pair_idx = self.emit_i64_const(0)
        var lo = pair_idx.0
        let idx_reg = pair_idx.1

        let pair_limit = lo.emit_i64_const(repeat_count)
        lo = pair_limit.0
        let limit_reg = pair_limit.1

        let pair_one = lo.emit_i64_const(1)
        lo = pair_one.0
        let one_reg = pair_one.1

        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let top_label = pair_top.1

        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let end_label = pair_end.1

        lo = lo.emit(ir_label(top_label))

        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond_reg = pair_cond.1
        lo = lo.emit(ir_binop(cond_reg, idx_reg, BinaryOp::OpLt, limit_reg))
        lo = lo.emit(ir_branch_false(cond_reg, end_label))
        lo = lo.emit(ir_index_set(base_reg, idx_reg, value_reg))

        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, idx_reg, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(idx_reg, next_reg))
        lo = lo.emit(ir_jump(top_label))
        lo = lo.emit(ir_label(end_label))
        lo
    }

    fn lower_array_repeat_literal_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let right_opt: Option<Box<Expr>> = e.right
        let repeat_count = match right_opt {
            Some(count_expr) => (*count_expr).int_val,
            None => 0,
        }
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc_array(dst, lo.aggregate_storage_bytes(repeat_count), repeat_count))

        let left_opt: Option<Box<Expr>> = e.left
        match left_opt {
            Some(value_expr) => {
                let elem_is_float = lower_expr_has_float_source_ref(&(*value_expr))
                let zero_fill = lo.expr_is_zero_fill_value(*value_expr)
                let pair_value = lo.lower_expr_ref(&(*value_expr))
                lo = pair_value.0
                let value_reg = pair_value.1
                if !zero_fill {
                    lo = lo.lower_array_repeat_fill(dst, value_reg, repeat_count)
                }
                if elem_is_float {
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo = lo.bind_reg_array_elem_float(dst)
                }
                (lo, dst)
            }
            None => (lo, dst),
        }
    }

    fn lower_array_repeat_literal(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_array_repeat_literal_ref(&e)
    }

    fn lower_name_array_literal(self, names: [Name; 16], count: i64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        let lo1 = pair_dst.0
        let dst = pair_dst.1
        let lo2 = lo1.emit(ir_alloc_array(dst, lo1.aggregate_storage_bytes(count), count))
        let lo3 = lo2.emit_name_array_values(dst, names, count, 0)
        (lo3, dst)
    }

    fn lower_f64_array_literal(self, values: [f64; 16], count: i64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        let lo1 = pair_dst.0
        let dst = pair_dst.1
        let lo2 = lo1.emit(ir_alloc_array(dst, lo1.aggregate_storage_bytes(count), count))
        var lo3 = lo2.emit_f64_array_values(dst, values, count, 0)
        lo3 = lo3.emit(ir_mark_float_reg(dst))
        lo3 = lo3.bind_reg_array_elem_float(dst)
        (lo3, dst)
    }

