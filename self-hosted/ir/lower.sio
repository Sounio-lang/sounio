    fn lower_propose_alternatives_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let evidence_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let evidence_pair = lo1.lower_opt_expr(evidence_expr)
        let lo2 = evidence_pair.0
        let evidence_reg = evidence_pair.1

        let frontier_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => match (*rest).tail {
                    Some(rest2) => Some(Box::new((*rest2).head))
                    None => None
                }
                None => None
            }
            None => None
        }
        let frontier_pair = lo2.lower_opt_expr(frontier_expr)
        let lo3 = frontier_pair.0
        let frontier_reg = frontier_pair.1

        let pair_dst = lo3.fresh_reg()
        let lo4 = pair_dst.0
        let dst_reg = pair_dst.1
        let set_id = lo4.find_alternative_set_id_for_span(span)
        let lo5 = lo4.emit(ir_propose_alternatives(dst_reg, value_reg, evidence_reg, frontier_reg, set_id))
        (lo5, dst_reg)
    }

    // Sprint 116: measure(v, uncertainty) → Knowledge<f64> struct construction
    fn lower_measure_call_ref(self, _span: Span, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Extract first argument: value
        let value_pair = self.lower_measure_value_arg_ref(args)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        // Extract second argument: uncertainty
        let unc_pair = lo1.lower_measure_uncertainty_arg_ref(args)
        var lo2 = unc_pair.0
        let unc_reg = unc_pair.1
        lo2 = lo2.emit(ir_mark_float_reg(unc_reg))

        // IrAlloc for Knowledge struct
        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let lo4 = lo3.emit(ir_alloc(dst_reg, 0))

        // field 0: value
        let lo5 = lo4.emit(ir_field_set(dst_reg, 0, value_reg, make_name("value")))

        // field 1: variance = uncertainty * uncertainty (must be f64 mulsd, not imul)
        let var_pair = lo5.fresh_reg()
        let lo6 = var_pair.0
        let variance_reg = var_pair.1
        var lo7 = lo6.emit(ir_binop_typed(variance_reg, unc_reg, BinaryOp::OpMul, unc_reg, true, true))
        lo7 = lo7.emit(ir_mark_float_reg(variance_reg))
        let lo8 = lo7.emit(ir_field_set(dst_reg, 1, variance_reg, make_name("variance")))

        // field 2: confidence = 1.0
        let conf_pair = lo8.fresh_reg()
        let lo9 = conf_pair.0
        let conf_reg = conf_pair.1
        let lo10 = lo9.emit(ir_load_float(conf_reg, 1.0))
        var lo11 = lo10.emit(ir_field_set(dst_reg, 2, conf_reg, make_name("confidence")))
        lo11 = lo11.bind_variance_for_base_reg(dst_reg, variance_reg)
        lo11.pending_variance_reg = variance_reg
        // Seed FO channel so `let k = measure(...)` then k.value shares the same σ² channel.
        lo11 = lo11.fo_seed_from_variance(variance_reg, 0 - 1)
        var mk: i64 = 0
        while mk < 32 {
            lo11.fo_pending_sens[mk as usize] = lo11.fo_expr_sens[mk as usize]
            mk = mk + 1
        }

        (lo11, dst_reg)
    }

    // Knowledge(v, e=<confidence>, prov=<provenance>) -> Knowledge<f64> struct construction.
    // Runtime semantics taken from lean_single by EXECUTION, not by assumption:
    //   Knowledge(12.5, e=0.65, prov="src")  ->  .value 12.5  .variance 0.0  .confidence 0.65
    // (`prov` has no slot in the 3-field IR layout registered by ir_register_knowledge_layout.
    // `.epsilon` names the same quantity at the type level but reads 0.0 under Madaros -- a
    // separate pre-existing lowering gap, unchanged here.) Named call arguments lower to
    // their value expression, so arg0 is the value and arg1 is the epsilon expression.
    fn lower_knowledge_ctor_call_ref(self, _span: Span, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_pair = self.lower_measure_value_arg_ref(args)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        // Second argument is epsilon -> the confidence slot (NOT a sigma: variance is 0).
        let conf_pair = lo1.lower_measure_uncertainty_arg_ref(args)
        var lo2 = conf_pair.0
        let conf_reg = conf_pair.1
        lo2 = lo2.emit(ir_mark_float_reg(conf_reg))

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let lo4 = lo3.emit(ir_alloc(dst_reg, 0))

        // field 0: value
        let lo5 = lo4.emit(ir_field_set(dst_reg, 0, value_reg, make_name("value")))

        // field 1: variance = 0.0 (the call form declares confidence, not a sigma)
        let var_pair = lo5.fresh_reg()
        let lo6 = var_pair.0
        let variance_reg = var_pair.1
        var lo7 = lo6.emit(ir_load_float(variance_reg, 0.0))
        lo7 = lo7.emit(ir_mark_float_reg(variance_reg))
        let lo8 = lo7.emit(ir_field_set(dst_reg, 1, variance_reg, make_name("variance")))

        // field 2: confidence = epsilon
        var lo9 = lo8.emit(ir_field_set(dst_reg, 2, conf_reg, make_name("confidence")))
        lo9 = lo9.bind_variance_for_base_reg(dst_reg, variance_reg)
        lo9.pending_variance_reg = variance_reg
        lo9 = lo9.fo_seed_from_variance(variance_reg, 0 - 1)
        var mk: i64 = 0
        while mk < 32 {
            lo9.fo_pending_sens[mk as usize] = lo9.fo_expr_sens[mk as usize]
            mk = mk + 1
        }
        (lo9, dst_reg)
    }

    fn lower_variance_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_v = self.lower_expr_variance_ref(&(*list).head)
                var lo = pair_v.0
                if pair_v.1 >= 0 {
                    // Return a COPY, not the reg itself. For a mutable local that
                    // reg is now its persistent variance slot (#1535), so handing it
                    // back would alias: `let snap = variance_of(a)` followed by a
                    // reassignment of `a` would retroactively change `snap`. Reading
                    // an uncertainty must yield a value, not a view.
                    let cp = lo.fresh_reg()
                    lo = cp.0
                    let dst = cp.1
                    lo = lo.emit(ir_copy(dst, pair_v.1))
                    lo = lo.emit(ir_mark_float_reg(dst))
                    return (lo, dst)
                }
                lo.emit_zero_variance()
            }
            _ => self.emit_zero_variance(),
        }
    }

    // sensitivity_of(x, k): read channel k out of the per-channel partials that
    // lower_expr_variance_ref leaves in fo_expr_sens — the same array variance_of
    // squares and sums. The index must be a literal, matching lean_single: channels
    // are compile-time slots assigned by measure(). A channel with no recorded
    // partial is a genuine zero: x does not depend on input k.
    fn lower_sensitivity_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_v = self.lower_expr_variance_ref(&(*list).head)
                var lo = pair_v.0
                var chan: i64 = 0 - 1
                match (*list).tail {
                    Some(rest) => {
                        if (*rest).head.kind == ExprKind::ExprIntLit && (*rest).head.int_val >= 0 {
                            chan = (*rest).head.int_val
                        }
                    }
                    _ => {}
                }
                if chan >= 0 && chan < 32 {
                    let sens = lo.fo_expr_sens[chan as usize]
                    if sens >= 0 {
                        let cp = lo.fresh_reg()
                        lo = cp.0
                        let dst = cp.1
                        lo = lo.emit(ir_copy(dst, sens))
                        lo = lo.emit(ir_mark_float_reg(dst))
                        return (lo, dst)
                    }
                }
                let z = lo.emit_f64_const(0.0)
                var lo_z = z.0
                lo_z = lo_z.emit(ir_mark_float_reg(z.1))
                (lo_z, z.1)
            }
            _ => {
                let z = self.emit_f64_const(0.0)
                var lo_z = z.0
                lo_z = lo_z.emit(ir_mark_float_reg(z.1))
                (lo_z, z.1)
            }
        }
    }

    // hessian_of(x, j, k): read the upper-triangle slot the second-order rules
    // left behind. Indices must be LITERALS -- lean_single reads them the same
    // way, and the corpus itself documents that runtime indices return wrong
    // values. A non-literal index yields 0.0 rather than a slot chosen from a
    // register's runtime contents, which would be a wrong number dressed as a
    // right one. An empty slot is a genuine zero: x is linear in that pair.
    fn lower_hessian_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_v = self.lower_expr_variance_ref(&(*list).head)
                var lo = pair_v.0
                var j: i64 = 0 - 1
                var k: i64 = 0 - 1
                match (*list).tail {
                    Some(rest) => {
                        if (*rest).head.kind == ExprKind::ExprIntLit && (*rest).head.int_val >= 0 {
                            j = (*rest).head.int_val
                        }
                        match (*rest).tail {
                            Some(rest2) => {
                                if (*rest2).head.kind == ExprKind::ExprIntLit && (*rest2).head.int_val >= 0 {
                                    k = (*rest2).head.int_val
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                if j >= 0 && j < 8 && k >= 0 && k < 8 {
                    let idx = lo.so_hess_idx(j, k)
                    let slot = lo.so_expr_hess[idx as usize]
                    if slot >= 0 {
                        let cp = lo.fresh_reg()
                        lo = cp.0
                        lo = lo.emit(ir_copy(cp.1, slot))
                        lo = lo.emit(ir_mark_float_reg(cp.1))
                        return (lo, cp.1)
                    }
                }
                let z = lo.emit_f64_const(0.0)
                var lo_z = z.0
                lo_z = lo_z.emit(ir_mark_float_reg(z.1))
                (lo_z, z.1)
            }
            _ => {
                let z = self.emit_f64_const(0.0)
                var lo_z = z.0
                lo_z = lo_z.emit(ir_mark_float_reg(z.1))
                (lo_z, z.1)
            }
        }
    }

    // second_order_mean(expr): E2[f] = f(mu) + (1/2) * sum_k H_kk * sigma2_k
    //
    // Built on this tree's own second-order machinery rather than imported: the
    // FO/SO walk in lower_expr_variance_ref populates so_expr_hess, so_hess_idx
    // addresses it, and fo_sigma2 holds each channel's variance. Channels are
    // capped at 8 here because so_hess_idx is defined over 8x8.
    // correlate(a, b, rho): record Cov between the channels a and b carry, and
    // evaluate to rho so the call is usable as an expression.
    //
    // rho must be a float literal. A runtime rho would have to be threaded into
    // both consumers as a register, and a correlation that is only known at
    // runtime cannot be folded into the compile-time channel table at all --
    // refusing is honest, silently reading 0.0 would not be.
    fn lower_correlate_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(l0) => {
                let p0 = self.lower_expr_variance_ref(&(*l0).head)
                var lo = p0.0
                let ci = lo.fo_primary_channel()
                match (*l0).tail {
                    Some(l1) => {
                        let p1 = lo.lower_expr_variance_ref(&(*l1).head)
                        lo = p1.0
                        let cj = lo.fo_primary_channel()
                        // Both literal forms, matching the checker's
                        // correlate_rho_literal: an ExprFloatLit, and the
                        // `0.0 - x` ExprBinary this dialect uses to write a
                        // negative literal. Reading only the first turned every
                        // negative correlation into independence in silence --
                        // and a negative rho is the case the builtin exists for.
                        var rho: f64 = 0.0
                        match (*l1).tail {
                            Some(l2) => {
                                if (*l2).head.kind == ExprKind::ExprFloatLit {
                                    rho = (*l2).head.float_val
                                }
                                if (*l2).head.kind == ExprKind::ExprBinary && (*l2).head.bin_op == BinaryOp::OpSub {
                                    match (*l2).head.left {
                                        Some(lz) => {
                                            match (*l2).head.right {
                                                Some(rz) => {
                                                    if (*lz).kind == ExprKind::ExprFloatLit && (*rz).kind == ExprKind::ExprFloatLit {
                                                        if (*lz).float_val == 0.0 {
                                                            rho = 0.0 - (*rz).float_val
                                                        }
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                        fo_cov_rho_set(ci, cj, rho)
                        return lo.emit_f64_const(rho)
                    }
                    _ => {}
                }
                lo.emit_f64_const(0.0)
            }
            _ => self.emit_f64_const(0.0),
        }
    }

    fn lower_second_order_mean_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                // Walk first, so the Hessian and the sigmas exist to read.
                let pair_v = self.lower_expr_variance_ref(&(*list).head)
                var lo = pair_v.0
                let zp = lo.emit_f64_const(0.0)
                lo = zp.0
                var acc = zp.1
                let hp = lo.emit_f64_const(0.5)
                lo = hp.0
                let half = hp.1
                var k: i64 = 0
                while k < 8 {
                    let idx = lo.so_hess_idx(k, k)
                    let hreg = lo.so_expr_hess[idx as usize]
                    let sig = lo.fo_sigma2[k as usize]
                    if hreg >= 0 && sig >= 0 {
                        let t1p = lo.fresh_reg()
                        lo = t1p.0
                        let t1 = t1p.1
                        lo = lo.emit(ir_binop_typed(t1, hreg, BinaryOp::OpMul, sig, true, true))
                        lo = lo.emit(ir_mark_float_reg(t1))
                        let t2p = lo.fresh_reg()
                        lo = t2p.0
                        let t2 = t2p.1
                        lo = lo.emit(ir_binop_typed(t2, half, BinaryOp::OpMul, t1, true, true))
                        lo = lo.emit(ir_mark_float_reg(t2))
                        let ap = lo.fresh_reg()
                        lo = ap.0
                        let nacc = ap.1
                        lo = lo.emit(ir_binop_typed(nacc, acc, BinaryOp::OpAdd, t2, true, true))
                        lo = lo.emit(ir_mark_float_reg(nacc))
                        acc = nacc
                    }
                    k = k + 1
                }
                // Off-diagonal: sum_{i<j} H_ij * Cov_ij, with Cov = rho*sigma_i*sigma_j.
                //
                // No 1/2 here: the Taylor term is (1/2)*2*H_ij*Cov over the
                // unordered pair, and the 2 cancels the half. Checked against
                // the closed form for E2[(x+y)^2] with sigma_x = 0.1,
                // sigma_y = 0.2: independent 9.05, rho = 1 gives 9.09.
                var oi: i64 = 0
                while oi < 8 {
                    var oj: i64 = oi + 1
                    while oj < 8 {
                        let rho = fo_cov_rho_get(oi, oj)
                        let hij = lo.so_expr_hess[lo.so_hess_idx(oi, oj) as usize]
                        if rho != 0.0 && hij >= 0 {
                            // Inline, for the same reason as the variance cross term: a helper
                            // taking self by value read the SAME sigma for every channel.
                            let ev_i = lo.fo_sigma2[oi as usize]
                            let ev_j = lo.fo_sigma2[oj as usize]
                            if ev_i >= 0 && ev_j >= 0 {
                                let epp = lo.fresh_reg()
                                lo = epp.0
                                lo = lo.emit(ir_binop_typed(epp.1, ev_i, BinaryOp::OpMul, ev_j, true, true))
                                lo = lo.emit(ir_mark_float_reg(epp.1))
                                let esq = lowerer_find_or_add_fn_id_mut(&! lo, make_name("sqrt"))
                                let eargs: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(epp.1)))
                                let edp = lo.fresh_reg()
                                lo = edp.0
                                let esig = edp.1
                                var eci = ir_call(esig, esq, make_name("sqrt"), eargs, 1)
                                eci.imm_flags = IR_FLOAT_REG_MARKER_FLAG
                                lo = lo.emit(eci)
                                lo = lo.emit(ir_mark_float_reg(esig))
                                let rp = lo.emit_f64_const(rho)
                                lo = rp.0
                                let u1 = lo.fresh_reg()
                                lo = u1.0
                                lo = lo.emit(ir_binop_typed(u1.1, hij, BinaryOp::OpMul, esig, true, true))
                                lo = lo.emit(ir_mark_float_reg(u1.1))
                                let u2 = lo.fresh_reg()
                                lo = u2.0
                                lo = lo.emit(ir_binop_typed(u2.1, u1.1, BinaryOp::OpMul, rp.1, true, true))
                                lo = lo.emit(ir_mark_float_reg(u2.1))
                                let u4 = lo.fresh_reg()
                                lo = u4.0
                                lo = lo.emit(ir_binop_typed(u4.1, acc, BinaryOp::OpAdd, u2.1, true, true))
                                lo = lo.emit(ir_mark_float_reg(u4.1))
                                acc = u4.1
                            }
                        }
                        oj = oj + 1
                    }
                    oi = oi + 1
                }
                // First-order mean: the expression evaluated at the seed means.
                let vp = lo.lower_expr_ref(&(*list).head)
                lo = vp.0
                let mean1 = vp.1
                let dp = lo.fresh_reg()
                lo = dp.0
                let dst = dp.1
                lo = lo.emit(ir_binop_typed(dst, mean1, BinaryOp::OpAdd, acc, true, true))
                lo = lo.emit(ir_mark_float_reg(dst))
                (lo, dst)
            }
            _ => {
                let z = self.emit_f64_const(0.0)
                var lo_z = z.0
                lo_z = lo_z.emit(ir_mark_float_reg(z.1))
                (lo_z, z.1)
            }
        }
    }

    fn lower_uncertainty_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_v = self.lower_variance_of_call_ref(args)
        var lo = pair_v.0
        let variance_reg = pair_v.1
        let sqrt_id = lowerer_find_or_add_fn_id_mut(&! lo, make_name("sqrt"))
        let sqrt_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(variance_reg)))
        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        var instr = ir_call(dst, sqrt_id, make_name("sqrt"), sqrt_args, 1)
        instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        lo = lo.emit(instr)
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    // lift_knowledge(k: Knowledge<T>) → IrLiftKnowledge (zero-cost copy; epistemic bridge H5.4)
    fn lower_lift_knowledge_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let knowledge_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let knowledge_pair = self.lower_opt_expr(knowledge_expr)
        let lo1 = knowledge_pair.0
        let knowledge_reg = knowledge_pair.1
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let contest_id = lo2.find_contest_id_for_span(span)
        let lo3 = lo2.emit(ir_lift_knowledge(dst_reg, knowledge_reg, contest_id))
        (lo3, dst_reg)
    }

    fn lower_alternative_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let set_id = self.find_alternative_set_id_for_span(span)
        if set_id < 0 || set_id >= self.module.epistemic.alternative_set_count {
            return self.emit_i64_const(0)
        }
        self.emit_i64_const(self.module.epistemic.alternative_sets[set_id as usize].candidate_count)
    }

    fn lower_alternative_option_call(self, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let set_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let set_pair = self.lower_opt_expr(set_expr)
        let lo1 = set_pair.0
        let set_reg = set_pair.1

        // Lower the index expression to preserve potential side-effects,
        // even though the option choice is checker-materialized metadata.
        let idx_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let idx_pair = lo1.lower_opt_expr(idx_expr)
        let lo2 = idx_pair.0

        let pair_dst = lo2.fresh_reg()
        let lo3 = pair_dst.0
        let dst_reg = pair_dst.1
        let lo4 = lo3.emit(ir_copy(dst_reg, set_reg))
        (lo4, dst_reg)
    }

    fn lower_alternative_reason_witness(self, info: IrAlternativeReasonWitnessInfo) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        if info.candidate_id < 0 || info.candidate_id >= self.module.epistemic.alternative_candidate_count {
            let loe = self.report_error_at(13468)
            return loe.emit_unit()
        }
        let cand = self.module.epistemic.alternative_candidates[info.candidate_id as usize]

        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let candidate_name_pair = lo.emit_name_string(cand.name)
        lo = candidate_name_pair.0
        lo = lo.emit_named_field(dst, make_name("candidate_name"), candidate_name_pair.1)

        let strategy_name_pair = lo.emit_name_string(cand.strategy_name)
        lo = strategy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("strategy_name"), strategy_name_pair.1)

        let route_name_pair = lo.emit_name_string(cand.route_name)
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let source_kind_pair = lo.emit_name_string(lo.alternative_source_kind_name(cand.source_kind))
        lo = source_kind_pair.0
        lo = lo.emit_named_field(dst, make_name("source_kind"), source_kind_pair.1)

        let contest_id_pair = lo.emit_i64_const(cand.contest_id)
        lo = contest_id_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_id_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(cand.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let intervention_cost_pair = lo.emit_f64_const(cand.intervention_cost)
        lo = intervention_cost_pair.0
        lo = lo.emit_named_field(dst, make_name("intervention_cost"), intervention_cost_pair.1)

        let residual_tail_risk_pair = lo.emit_f64_const(cand.residual_tail_risk)
        lo = residual_tail_risk_pair.0
        lo = lo.emit_named_field(dst, make_name("residual_tail_risk"), residual_tail_risk_pair.1)

        let mechanistic_divergence_pair = lo.emit_f64_const(cand.mechanistic_divergence)
        lo = mechanistic_divergence_pair.0
        lo = lo.emit_named_field(dst, make_name("mechanistic_divergence"), mechanistic_divergence_pair.1)

        let admissibility_margin_pair = lo.emit_f64_const(cand.admissibility_margin)
        lo = admissibility_margin_pair.0
        lo = lo.emit_named_field(dst, make_name("admissibility_margin"), admissibility_margin_pair.1)

        (lo, dst)
    }

    fn lower_alternative_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let witness_id = self.find_alternative_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.alternative_reason_witness_count {
            let loe = self.report_error_at(13524)
            return loe.emit_unit()
        }
        self.lower_alternative_reason_witness(self.module.epistemic.alternative_reason_witnesses[witness_id as usize])
    }

    fn lower_commit_alternative_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let option_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let option_pair = lo1.lower_opt_expr(option_expr)
        let lo2 = option_pair.0
        let option_reg = option_pair.1

        let protocol_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => match (*rest).tail {
                    Some(rest2) => Some(Box::new((*rest2).head))
                    None => None
                }
                None => None
            }
            None => None
        }
        let protocol_pair = lo2.lower_opt_expr(protocol_expr)
        let lo3 = protocol_pair.0
        let protocol_reg = protocol_pair.1

        let pair_dst = lo3.fresh_reg()
        let lo4 = pair_dst.0
        let dst_reg = pair_dst.1
        let plan_id = lo4.find_transition_plan_id_for_span(span)
        let lo5 = lo4.emit(ir_commit_alternative(dst_reg, value_reg, option_reg, protocol_reg, plan_id))
        (lo5, dst_reg)
    }

    // Sprint 28: Emit a debug guard instruction after an epistemic gate.
    // Only emits when debug_mode is true. In release mode, this is a no-op.
    fn emit_debug_guard(self, gate_name: Name, dst_reg: i64) -> Lowerer with Mut, Panic, Div, IO {
        if !self.debug_mode {
            return self
        }
        // Emit a single guard: compare dst_reg against default threshold (0.0 = no-op guard)
        // The threshold and comparison will be refined when policy requirements are wired
        self.emit(ir_debug_guard(dst_reg, 0.0, 4, 0, gate_name))
    }

    fn lower_transition_reason_witness(self, info: IrTransitionPlanInfo) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_transition_policy_name(info.transition_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let protocol_name_pair = lo.emit_name_string(lo.epistemic_transition_protocol_name(info.transition_protocol_id))
        lo = protocol_name_pair.0
        lo = lo.emit_named_field(dst, make_name("protocol_name"), protocol_name_pair.1)

        let route_name_pair = lo.emit_name_string(info.route_name)
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let rollback_route_pair = lo.emit_name_string(info.rollback_route_name)
        lo = rollback_route_pair.0
        lo = lo.emit_named_field(dst, make_name("rollback_route_name"), rollback_route_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let contest_pair = lo.emit_i64_const(info.contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let step_count_pair = lo.emit_i64_const(info.step_count)
        lo = step_count_pair.0
        lo = lo.emit_named_field(dst, make_name("step_count"), step_count_pair.1)

        let final_value_pair = lo.emit_name_string(info.final_value_repr)
        lo = final_value_pair.0
        lo = lo.emit_named_field(dst, make_name("final_value_repr"), final_value_pair.1)

        let snapshot_pair = lo.lower_metric_snapshot_literal(info.metric_values)
        lo = snapshot_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_snapshot"), snapshot_pair.1)

        (lo, dst)
    }

    fn lower_transition_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let witness_id = self.find_transition_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.transition_reason_witness_count {
            let loe = self.report_error_at(13631)
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.transition_reason_witnesses[witness_id as usize]
        let plan_id = witness_info.transition_plan_id
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            let loe = self.report_error_at(13637)
            return loe.emit_unit()
        }
        self.lower_transition_reason_witness(self.module.epistemic.transition_plans[plan_id as usize])
    }

    fn lower_transition_step_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        let plan_id = self.find_transition_plan_id_for_span(span)
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            return self.emit_i64_const(0)
        }
        self.emit_i64_const(self.module.epistemic.transition_plans[plan_id as usize].step_count)
    }

    // Bind the first sub-pattern of a Some(x) match to the scrutinee value
    fn bind_match_sub_pattern(self, scrut: i64, pats: Option<Box<PatternList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match pats {
            Some(list) => {
                let inner = (*list).head
                if inner.kind == PatternKind::PatBinding {
                    var lo = self.bind_local(inner.name, scrut, inner.is_mut)
                    // The payload of `Some(nx)` on an Option<Box<T>> is a Box handle, so mark
                    // the bound variable as a Box: `*nx` then lowers to the box-handle deref
                    // (IrFieldGet 0) instead of raw-dereferencing the handle (which crashed —
                    // the recursive-data root). Safe for non-Box payloads: marking only
                    // changes how `*nx` lowers, and deref/field-access of a non-Box payload
                    // (e.g. Option<i64>) is not valid code anyway.
                    lo = lo.bind_local_struct_type(inner.name, make_name("Box"))
                    lo
                } else if inner.kind == PatternKind::PatWildcard {
                    // _ inside Some(_) — no binding needed
                    self
                } else {
                    self
                }
            }
            _ => self,
        }
    }

    // `perform GPU.launch(k, grid, block)(args)` -> `k(args)`.
    //
    // Returns the kernel's name, or the empty name when this is not a launch
    // invocation. The shape mirrors checker_expr_is_gpu_launch_invocation_call:
    // an outer Call whose callee is the descriptor `GPU.launch(k, grid, block)`.
    //
    // Nothing lowered this before, so the launch emitted no call at all and the
    // kernel silently never ran. Measured on a 4-element in-place add: direct
    // call gives a[1] = 3.0, the same kernel through launch left a[1] = 1.0,
    // untouched (#1596).
    //
    // grid and block are IGNORED, deliberately. On a CPU host there is no launch
    // geometry to honour: the kernel body already carries the lane loop (#1512),
    // whose bound is the kernel's first i64 parameter, so one call runs every
    // lane. A device backend would have to read them; this one has nothing to
    // read them for, and silently accepting them beats pretending to a geometry
    // that does not exist. Same reasoning as GPU.sync() lowering to a no-op.
    fn gpu_launch_kernel_name_ref(self, e: &Expr) -> Name with Mut, Panic, Div, Alloc, IO {
        if (*e).kind != ExprKind::ExprCall {
            return ir_empty_name()
        }
        match (*e).left {
            Some(desc) => {
                var ok = false
                if (*desc).kind == ExprKind::ExprMethodCall && ir_name_eq((*desc).name, make_name("launch")) {
                    match (*desc).left {
                        Some(base) => {
                            if (*base).kind == ExprKind::ExprIdent && ir_name_eq((*base).name, make_name("GPU")) {
                                ok = true
                            }
                        }
                        None => {}
                    }
                }
                if !ok {
                    return ir_empty_name()
                }
                match (*desc).args {
                    Some(list) => {
                        if (*list).head.kind == ExprKind::ExprIdent {
                            return (*list).head.name
                        }
                        ir_empty_name()
                    }
                    None => ir_empty_name(),
                }
            }
            None => ir_empty_name(),
        }
    }

    // Keep call lowering in bounded dispatch groups. lean_single reserves stack
    // for aggregate temporaries across a whole function, so the former monolithic
    // dispatcher accumulated a 16 MiB frame even though only one branch runs.
    // Register -2 is private to these helpers and means "not handled"; -1 remains
    // IR_INVALID_REG and is therefore still a handled hard-error result.
    fn call_expr_uses_special_a_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc, IO {
        if self.gpu_launch_kernel_name_ref(e).len > 0 {
            return true
        }
        let callee_name = match e.left {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        name_eq(callee_name, make_name("print"))
            || name_eq(callee_name, make_name("print_int"))
            || name_eq(callee_name, make_name("print_char"))
            || name_eq(callee_name, make_name("println"))
            || name_eq(callee_name, make_name("syscall6"))
            || name_eq(callee_name, make_name("seq_push"))
            || name_eq(callee_name, make_name("seq_get"))
            || name_eq(callee_name, make_name("seq_set"))
            || name_eq(callee_name, make_name("seq_count"))
            || name_eq(callee_name, make_name("seq_len"))
            || name_eq(callee_name, make_name("seq_new"))
    }

    fn lower_call_expr_special_a_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let callee_opt_ref = &e.left
        let callee_name = match *callee_opt_ref {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        let launch_name = self.gpu_launch_kernel_name_ref(e)
        if launch_name.len > 0 {
            var lo_k = self
            let fn_id_k = lowerer_find_or_add_fn_id_mut(&! lo_k, launch_name)
            let pair_args_k: LowerExprArgsResult = lo_k.lower_expr_args_ref(&e.args)
            let lo_args_k = pair_args_k.lowerer
            let args_k: Option<Box<IrRegList>> = if pair_args_k.count <= 0 { None } else { Some(Box::new(pair_args_k.regs)) }
            let pair_dst_k = lo_args_k.fresh_reg()
            let lo_dst_k = pair_dst_k.0
            let dst_k = pair_dst_k.1
            // grid/block carry no meaning on this backend, and that is a data
            // difference, not a scheduling one: the lane count comes from the
            // kernel's first i64 parameter, so a descriptor of (1,1,1)x(2,1,1)
            // against an extent of 4 runs FOUR lanes. Measured. Silence there
            // would be a wrong answer nobody is told about, which is the exact
            // failure mode this file keeps being bitten by, so it is announced
            // at compile time. (Compiler stdout, not the program's -- stdout
            // assertions in the corpus are unaffected.)
            print("warning: GPU.launch grid/block ignored on the CPU lane path")
            print(" -- lane count comes from the kernel's first i64 parameter, not the descriptor\n")
            let lo_call_k = lo_dst_k.emit(ir_call(dst_k, fn_id_k, launch_name, args_k, pair_args_k.count))
            return (lo_call_k, dst_k)
        }
        if name_eq(callee_name, make_name("print")) || name_eq(callee_name, make_name("print_int")) || name_eq(callee_name, make_name("print_char")) {
            // Redirect bare print(<int literal>) to the print_int builtin: print
            // (=print_str) treats its argument as a char* and would deref the integer
            // value as a pointer. Explicit print_int / print_char are left untouched.
            var print_builtin_name = callee_name
            if name_eq(callee_name, make_name("print")) {
                print_builtin_name = self.println_dispatch_name(&e.args)
            }
            var lo_builtin = self
            let fn_id_builtin = lowerer_find_or_add_fn_id_mut(&! lo_builtin, print_builtin_name)
            let pair_args_builtin: LowerExprArgsResult = lo_builtin.lower_expr_args_ref(&e.args)
            let lo_args_builtin = pair_args_builtin.lowerer
            let args_builtin: Option<Box<IrRegList>> = if pair_args_builtin.count <= 0 { None } else { Some(Box::new(pair_args_builtin.regs)) }
            let argc_builtin = pair_args_builtin.count
            let pair_dst_builtin = lo_args_builtin.fresh_reg()
            let lo_dst_builtin = pair_dst_builtin.0
            let dst_builtin = pair_dst_builtin.1
            let lo_call_builtin = lo_dst_builtin.emit(ir_call(dst_builtin, fn_id_builtin, print_builtin_name, args_builtin, argc_builtin))
            return (lo_call_builtin, dst_builtin)
        }
        if name_eq(callee_name, make_name("println")) {
            // Lower println(x) -> print_kind(x); print_char('\n'). Dispatch rules:
            //   int literal / i64 var  → print_int   (itoa+write)
            //   float literal / f64 var → print_f64   (dtoa+write)
            //   anything else          → print        (strlen+write, safe fallback for strings)
            // print_str treats its argument as a char*; routing a numeric value to it
            // causes a SIGSEGV. The scalar_kind table tracks annotated i64/f64 locals.
            let pl_print_name = self.println_dispatch_name(&e.args)
            var lo_pl = self
            let fn_id_print = lowerer_find_or_add_fn_id_mut(&! lo_pl, pl_print_name)
            let pair_args_pl: LowerExprArgsResult = lo_pl.lower_expr_args_ref(&e.args)
            let lo_args_pl = pair_args_pl.lowerer
            let args_pl: Option<Box<IrRegList>> = if pair_args_pl.count <= 0 { None } else { Some(Box::new(pair_args_pl.regs)) }
            let argc_pl = pair_args_pl.count
            let pair_dst_pl = lo_args_pl.fresh_reg()
            let lo_dst_pl = pair_dst_pl.0
            let dst_pl = pair_dst_pl.1
            // Zero-arg `println()` is a newline and NOTHING else. Emitting the payload
            // call with argc 0 leaves the callee's char* parameter register undefined,
            // and print then walks whatever address was last in rdi looking for a NUL.
            // Measured on a Madaros built from this tree before the guard:
            // `print("A") println() print("B") println()` prints `A` and SIGSEGVs
            // (rc=139) at the first println. Measured 2026-08-28: 321 zero-arg
            // `println()` call sites across 19 files, 23 of them in
            // examples/uncertainty.sio alone.
            //
            // dst_pl is still DEFINED in the zero-arg branch rather than left
            // unwritten: lower_call_expr_ref's register is the expression's result
            // and reaches the generic expression path at 18992, so a consumer may
            // read it. `fresh_reg()` + `ir_load_imm(reg, 0)` is precisely this
            // file's own emit_unit (11615-11621), which is the right idiom here --
            // `println()` is unit-valued.
            var lo_call_pl =
                if argc_pl > 0 {
                    lo_dst_pl.emit(ir_call(dst_pl, fn_id_print, pl_print_name, args_pl, argc_pl))
                } else {
                    lo_dst_pl.emit(ir_load_imm(dst_pl, 0))
                }

            let fn_id_print_char = lowerer_find_or_add_fn_id_mut(&! lo_call_pl, make_name("print_char"))
            let pair_nl_reg = lo_call_pl.fresh_reg()
            let lo_nl_reg = pair_nl_reg.0
            let nl_reg = pair_nl_reg.1
            let lo_load_nl = lo_nl_reg.emit(ir_load_imm(nl_reg, 10))
            let nl_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(nl_reg)))
            let pair_nl_dst = lo_load_nl.fresh_reg()
            let lo_nl_dst = pair_nl_dst.0
            let nl_dst = pair_nl_dst.1
            let lo_call_nl = lo_nl_dst.emit(ir_call(nl_dst, fn_id_print_char, make_name("print_char"), nl_args, 1))
            return (lo_call_nl, dst_pl)
        }
        if name_eq(callee_name, make_name("syscall6")) {
            // Raw Linux syscall builtin (checker: call_expr_is_syscall6 in
            // check.sio; codegen: emit_builtin_syscall6_into in
            // codegen_x86_linux.sio). Lower as an ordinary named IrCall; the
            // builtin-target machinery (ir_module_ensure_builtin_call_targets)
            // binds it to the emitted syscall stub.
            var lo_sys = self
            let fn_id_sys = lowerer_find_or_add_fn_id_mut(&! lo_sys, callee_name)
            let pair_args_sys: LowerExprArgsResult = lo_sys.lower_expr_args_raw_ref(&e.args)
            let lo_args_sys = pair_args_sys.lowerer
            let args_sys: Option<Box<IrRegList>> = if pair_args_sys.count <= 0 { None } else { Some(Box::new(pair_args_sys.regs)) }
            let argc_sys = pair_args_sys.count
            let pair_dst_sys = lo_args_sys.fresh_reg()
            let lo_dst_sys = pair_dst_sys.0
            let dst_sys = pair_dst_sys.1
            let lo_call_sys = lo_dst_sys.emit(ir_call(dst_sys, fn_id_sys, callee_name, args_sys, argc_sys))
            return (lo_call_sys, dst_sys)
        }
        if name_eq(callee_name, make_name("seq_push"))
            || name_eq(callee_name, make_name("seq_get"))
            || name_eq(callee_name, make_name("seq_set")) {
            let expected_seq_argc: i64 = if name_eq(callee_name, make_name("seq_set")) { 3 } else { 2 }
            if count_expr_list_ref(&e.args) != expected_seq_argc {
                var lo_bad_seq_call = self
                lowerer_mark_hard_error(&! lo_bad_seq_call)
                return (lo_bad_seq_call, IR_INVALID_REG)
            }
            let builtin_seq_name = if name_eq(callee_name, make_name("seq_push")) {
                make_name("__sounio_seq_push")
            } else if name_eq(callee_name, make_name("seq_get")) {
                make_name("__sounio_seq_get")
            } else {
                make_name("__sounio_seq_set")
            }
            var lo_seq_call = self
            let fn_id_seq_call = lowerer_find_or_add_fn_id_mut(&! lo_seq_call, builtin_seq_name)
            let pair_args_seq_call: LowerExprArgsResult = lo_seq_call.lower_expr_args_raw_ref(&e.args)
            let lo_args_seq_call = pair_args_seq_call.lowerer
            let args_seq_call: Option<Box<IrRegList>> = Some(Box::new(pair_args_seq_call.regs))
            let pair_dst_seq_call = lo_args_seq_call.fresh_reg()
            let lo_dst_seq_call = pair_dst_seq_call.0
            let dst_seq_call = pair_dst_seq_call.1
            return (lo_dst_seq_call.emit(ir_call(
                dst_seq_call,
                fn_id_seq_call,
                builtin_seq_name,
                args_seq_call,
                expected_seq_argc,
            )), dst_seq_call)
        }
        if name_eq(callee_name, make_name("seq_count")) {
            if count_expr_list_ref(&e.args) != 1 {
                var lo_bad_seq_count = self
                lowerer_mark_hard_error(&! lo_bad_seq_count)
                return (lo_bad_seq_count, IR_INVALID_REG)
            }
            let pair_seq_count_base = self.lower_expr_args_first(&e.args)
            let pair_seq_count_dst = pair_seq_count_base.0.fresh_reg()
            let lo_seq_count = pair_seq_count_dst.0
            let dst_seq_count = pair_seq_count_dst.1
            return (lo_seq_count.emit(ir_array_len(dst_seq_count, pair_seq_count_base.1)), dst_seq_count)
        }
        if name_eq(callee_name, make_name("seq_len")) {
            if count_expr_list_ref(&e.args) != 1 {
                var lo_bad_seq_len = self
                lowerer_mark_hard_error(&! lo_bad_seq_len)
                return (lo_bad_seq_len, IR_INVALID_REG)
            }
            let pair_seq_len_base = self.lower_expr_args_first(&e.args)
            return pair_seq_len_base.0.lower_seq_len_knowledge_from_base(pair_seq_len_base.1)
        }
        if name_eq(callee_name, make_name("seq_new")) {
            match e.args {
                None => {
                    let pair_dst_seq = self.fresh_reg()
                    var lo_seq = pair_dst_seq.0
                    let dst_seq = pair_dst_seq.1
                    // Match lean_single's initial capacity of four elements.
                    // A zero-sized tag is classified as an unboxed small value
                    // by native-v2, which cannot preserve Seq identity on grow.
                    lo_seq = lo_seq.emit(ir_alloc_array(dst_seq, lo_seq.aggregate_storage_bytes(4), 0))
                    return (lo_seq, dst_seq)
                }
                Some(_) => {
                    var lo_bad_seq = self
                    lowerer_mark_hard_error(&! lo_bad_seq)
                    return (lo_bad_seq, IR_INVALID_REG)
                }
            }
        }
        return (self, -2)
    }

    fn call_expr_uses_special_b_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc, IO {
        let callee_name = match e.left {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        let callee_is_box_path = match e.left {
            Some(c) => {
                if (*c).kind == ExprKind::ExprPath {
                    ir_name_is_box(ir_path_first_name((*c).path))
                } else {
                    ir_name_is_box(callee_name)
                }
            }
            None => ir_name_is_box(callee_name),
        }
        ir_name_is_some(callee_name)
            || callee_is_box_path
            || ir_name_is_prove_robust(callee_name)
            || ir_name_is_validate_manifest(callee_name)
            || ir_name_is_admit_action(callee_name)
            || ir_name_is_defer_action(callee_name)
            || ir_name_is_deferral_reason(callee_name)
            || ir_name_is_plan_acquisition(callee_name)
            || ir_name_is_acquisition_reason(callee_name)
            || ir_name_is_plan_recourse(callee_name)
            || ir_name_is_recourse_reason(callee_name)
            || ir_name_is_propose_alternatives(callee_name)
            || ir_name_is_commit_alternative(callee_name)
            || ir_name_is_alternative_count(callee_name)
            || ir_name_is_alternative_option(callee_name)
            || ir_name_is_alternative_reason(callee_name)
            || ir_name_is_transition_reason(callee_name)
            || ir_name_is_transition_step_count(callee_name)
            || ir_name_is_lift_knowledge(callee_name)
            || ir_name_is_measure(callee_name)
            || ir_name_is_knowledge_ctor(callee_name)
            || self.name_is_variance_of(callee_name)
            || self.name_is_uncertainty_of(callee_name)
            || self.name_is_sensitivity_of(callee_name)
            || self.name_is_hessian_of(callee_name)
            || self.name_is_correlate(callee_name)
            || self.name_is_second_order_mean(callee_name)
            || self.contest_witness_kind_from_callee(callee_name) >= 0
    }

    fn lower_call_expr_special_b_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let callee_opt_ref = &e.left
        let callee_name = match *callee_opt_ref {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        if ir_name_is_some(callee_name) {
            return self.lower_expr_args_first(&e.args)
        }
        // Box::new must be detected from the callee PATH's first segment, not from
        // callee_name. expr_to_callee_name_ref (:10839-10847) mangles a two-segment path into
        // Type_method, so `Box::new` arrives here as "Box_new" (len 7) while ir_name_is_box
        // (ir/ir.sio:2347) requires the 3-byte "Box". The test therefore never matched,
        // lower_box_new (:11126) was DEAD CODE, and the call fell through to the generic
        // named-call path, which found no body for "Box_new" and let the backend synthesise a
        // return-0 stub (codegen_x86_linux.sio:8253).
        //
        // Consequence, read off the emitted bytes rather than inferred: `let b = Box::new(x)`
        // stored 0, and 0 is below the handle/raw-pointer threshold (2^20, gc.sio:43) so the
        // hybrid resolver took the handle path into table slot 0 — never allocated, ids start
        // at 1 — read object_base 0, and the field load faulted at 0x20. Field 0 and field 1
        // differed only in the load constant, hence the identical crash at 0x20 and 0x28 that
        // ruled out every offset-arithmetic explanation.
        //
        // Nothing here is a regression: ir_name_is_box(callee_name) and the mangling landed in
        // the SAME commit (c29eb0cba), so the Madaros Box call path has been dead since birth.
        // It went unnoticed because lower.sio is compiled by lean_single, which recognises Box
        // at the token level (lean_single.sio:12214) and allocates for real — so the compiler
        // builds itself without ever exercising this path, while 1367 Box::new call sites in
        // self-hosted/ would each compile to a return-0 stub under Madaros.
        //
        // The same defect was fixed at the BIND site earlier (:10117-10133, commit 8409e3b21);
        // this is the CALL site, which that fix missed. Box is the only affected builtin: every
        // other ir_name_is_*(callee_name) predicate matches a bare-ident builtin, and the other
        // Type::new spellings in the tree (ScanResult::new, Token::new, Span::new,
        // LexError::new) are user impl methods that MUST keep going through the mangled path.
        let callee_is_box_path = match *callee_opt_ref {
            Some(c) => {
                if (*c).kind == ExprKind::ExprPath {
                    ir_name_is_box(ir_path_first_name((*c).path))
                } else {
                    ir_name_is_box(callee_name)
                }
            }
            None => ir_name_is_box(callee_name),
        }
        if callee_is_box_path {
            return self.lower_box_new(&e.args)
        }
        if ir_name_is_prove_robust(callee_name) {
            return self.lower_prove_robust_call(e.span, e.args)
        }
        if ir_name_is_validate_manifest(callee_name) {
            return self.lower_validate_manifest_call(e.span, e.args)
        }
        if ir_name_is_admit_action(callee_name) {
            return self.lower_admit_action_call(e.span, e.args)
        }
        if ir_name_is_defer_action(callee_name) {
            return self.lower_defer_action_call(e.span, e.args)
        }
        if ir_name_is_deferral_reason(callee_name) {
            return self.lower_deferral_reason_call(e.span)
        }
        if ir_name_is_plan_acquisition(callee_name) {
            return self.lower_plan_acquisition_call(e.span, e.args)
        }
        if ir_name_is_acquisition_reason(callee_name) {
            return self.lower_acquisition_reason_call(e.span)
        }
        if ir_name_is_plan_recourse(callee_name) {
            return self.lower_plan_recourse_call(e.span, e.args)
        }
        if ir_name_is_recourse_reason(callee_name) {
            return self.lower_recourse_reason_call(e.span)
        }
        if ir_name_is_propose_alternatives(callee_name) {
            return self.lower_propose_alternatives_call(e.span, e.args)
        }
        if ir_name_is_commit_alternative(callee_name) {
            return self.lower_commit_alternative_call(e.span, e.args)
        }
        if ir_name_is_alternative_count(callee_name) {
            return self.lower_alternative_count_call(e.span)
        }
        if ir_name_is_alternative_option(callee_name) {
            return self.lower_alternative_option_call(e.args)
        }
        if ir_name_is_alternative_reason(callee_name) {
            return self.lower_alternative_reason_call(e.span)
        }
        if ir_name_is_transition_reason(callee_name) {
            return self.lower_transition_reason_call(e.span)
        }
        if ir_name_is_transition_step_count(callee_name) {
            return self.lower_transition_step_count_call(e.span)
        }
        if ir_name_is_lift_knowledge(callee_name) {
            return self.lower_lift_knowledge_call(e.span, e.args)
        }
        if ir_name_is_measure(callee_name) {
            return self.lower_measure_call_ref(e.span, &e.args)
        }
        if ir_name_is_knowledge_ctor(callee_name) {
            return self.lower_knowledge_ctor_call_ref(e.span, &e.args)
        }
        if self.name_is_variance_of(callee_name) {
            return self.lower_variance_of_call_ref(&e.args)
        }
        if self.name_is_uncertainty_of(callee_name) {
            return self.lower_uncertainty_of_call_ref(&e.args)
        }
        if self.name_is_sensitivity_of(callee_name) {
            return self.lower_sensitivity_of_call_ref(&e.args)
        }
        if self.name_is_hessian_of(callee_name) {
            return self.lower_hessian_of_call_ref(&e.args)
        }
        if self.name_is_correlate(callee_name) {
            return self.lower_correlate_call_ref(&e.args)
        }
        if self.name_is_second_order_mean(callee_name) {
            return self.lower_second_order_mean_call_ref(&e.args)
        }
        if self.contest_witness_kind_from_callee(callee_name) >= 0 {
            return self.lower_contest_witness_call(e.span, callee_name)
        }
        return (self, -2)
    }

    fn lower_call_expr_generic_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let callee_opt_ref = &e.left
        let callee_name = match *callee_opt_ref {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        // Inline expression callee (e.g. `(|x| x)(n)`): no resolvable name — lower the
        // callee expression to a fn-ref reg and dispatch indirectly, rather than falling
        // through to find_or_add_fn_id(empty) (which calls a body-less fn -> crash).
        if callee_name.len <= 0 {
            match *callee_opt_ref {
                Some(_) => {
                    let pair_cal = self.lower_opt_expr_ref(&e.left)
                    let lo_cal = pair_cal.0
                    let callee_reg = pair_cal.1
                    let pair_args_x: LowerExprArgsResult = lo_cal.lower_expr_args_ref(&e.args)
                    let lo_x = pair_args_x.lowerer
                    let args_x: Option<Box<IrRegList>> = if pair_args_x.count <= 0 { None } else { Some(Box::new(pair_args_x.regs)) }
                    let argc_x = pair_args_x.count
                    let pair_dx = lo_x.fresh_reg()
                    let lo_dx = pair_dx.0
                    let dst_x = pair_dx.1
                    var lo_cx = lo_dx
                    var call_x = ir_call_indirect(dst_x, callee_reg, args_x, argc_x)
                    if lo_dx.expr_result_is_float_ref(e) {
                        call_x.imm_flags = IR_FLOAT_REG_MARKER_FLAG
                    }
                    lo_cx = lo_cx.emit(call_x)
                    if call_x.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
                        lo_cx = lo_cx.emit(ir_mark_float_reg(dst_x))
                    }
                    return (lo_cx, dst_x)
                }
                _ => {}
            }
        }
        let callee_local_reg = self.lookup_local(callee_name)
        if callee_local_reg >= 0 {
            // Capturing closure (closures step 2): direct-call the synthetic fn with
            // [captured_regs..., args...]. IrCall relocs by fn_id, so the name is unused.
            let ccap_fn = self.lookup_local_closure_fn_id(callee_name)
            if ccap_fn >= 0 {
                let pair_args_c: LowerExprArgsResult = self.lower_expr_args_ref(&e.args)
                let lo_c = pair_args_c.lowerer
                var arglist_c: Option<Box<IrRegList>> = if pair_args_c.count <= 0 { None } else { Some(Box::new(pair_args_c.regs)) }
                var total_c = pair_args_c.count
                let cidx = lo_c.find_closure_cap_idx(ccap_fn)
                if cidx >= 0 && (*lo_c.closure_caps).entries[cidx as usize].def_fn != lo_c.current_fn {
                    // Capture regs from another frame. Emitting the call would
                    // reference registers that do not exist here. Escaping
                    // capturing closures are the "captures are TBD (Phase 2)"
                    // case; refuse loudly rather than emit a crashing binary or
                    // silently read 0 (#1542).
                    print("error: capturing closure called outside the function that defined it")
                    print(" -- escaping closures with captures are unsupported; inline it or pass the captured values as parameters\\n")
                    let lo_cerr = lo_c.report_error_at(13942)
                    return lo_cerr.emit_unit()
                }
                if cidx >= 0 {
                    let ccount = (*lo_c.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist_c = ir_reg_list_prepend((*lo_c.closure_caps).entries[cidx as usize].caps[jc as usize], arglist_c)
                        jc = jc - 1
                    }
                    total_c = total_c + ccount
                }
                let pair_dc = lo_c.fresh_reg()
                let lo_dc = pair_dc.0
                let dst_c = pair_dc.1
                let lo_cc = lo_dc.emit(ir_call(dst_c, ccap_fn, ir_empty_name(), arglist_c, total_c))
                return (lo_cc, dst_c)
            }
            let pair_args_i: LowerExprArgsResult = self.lower_expr_args_ref(&e.args)
            let lo_i = pair_args_i.lowerer
            let args_i: Option<Box<IrRegList>> = if pair_args_i.count <= 0 { None } else { Some(Box::new(pair_args_i.regs)) }
            let argc_i = pair_args_i.count
            let pair_d_i = lo_i.fresh_reg()
            let lo2_i = pair_d_i.0
            let dst_i = pair_d_i.1
            var lo3_i = lo2_i
            var call_i = ir_call_indirect(dst_i, callee_local_reg, args_i, argc_i)
            if lo2_i.expr_result_is_float_ref(e) {
                call_i.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
            lo3_i = lo3_i.emit(call_i)
            if call_i.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
                lo3_i = lo3_i.emit(ir_mark_float_reg(dst_i))
            }
            return (lo3_i, dst_i)
        }
        self.lower_call_expr_named_ref(e, callee_name)
    }

    fn lower_call_expr_named_ref(self, e: &Expr, callee_name: Name) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo1 = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo1, callee_name)
        if lo1.ir_name_is_knowledge_kaxi_publish(callee_name) {
            if lo1.expr_list_len_ref(&e.args) == 2 {
                return lo1.lower_kaxi_publish_call(fn_id, callee_name, e.args)
            }
        }
        if lo1.first_arg_is_capturing_closure_literal_ref(&e.args) && lo1.lower_function_is_transparent_hof(fn_id) {
            return lo1.lower_hof_captured_closure_literal_call(callee_name, &e.args)
        }
        let hof_closure_local_fn = lo1.first_arg_capturing_closure_local_fn_id_ref(&e.args)
        if hof_closure_local_fn >= 0 && lo1.lower_function_is_transparent_hof(fn_id) {
            return lo1.lower_hof_captured_closure_local_call(hof_closure_local_fn, callee_name, &e.args)
        }
        // D2 residual (#933 after #1247): str_from_bytes / write_file expect a GC
        // handle by value. Auto-unwrap &buf / &!buf / ref-typed slots so both
        // shapes share the handle unpack path (no builtin-body always-deref).
        let handle_buf_idx = lower_handle_buf_arg_index(callee_name)
        let pair_args: LowerExprArgsResult = if handle_buf_idx >= 0 {
            lo1.lower_expr_args_handle_buf_ref(&e.args, handle_buf_idx)
        } else {
            lo1.lower_expr_args_ref(&e.args)
        }
        let lo2 = pair_args.lowerer
        let args: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let argc = pair_args.count
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        // gpu_thread_id_x() inside a kernel lane loop is the loop counter, not a
        // call. resolve.sio:1059 allowlists the 12 GPU intrinsics as implicit
        // builtins that are never bound, so the emitted call names nothing and
        // leaves `dst` unwritten — which reads as 0 and is why every lane looked
        // like lane 0. Outside a kernel LOWER_KERNEL_TID_REG is -1 and this is
        // skipped, preserving the previous behaviour for the other 11 intrinsics.
        if name_eq(callee_name, make_name("gpu_thread_id_x")) {
            if LOWER_KERNEL_TID_REG >= 0 {
                let lo_tid = lo3.emit(ir_copy(dst, LOWER_KERNEL_TID_REG))
                return (lo_tid, dst)
            }
            // Reached outside a kernel lane loop — typically a helper function
            // that reads gpu_thread_id_x() and is called from a kernel. The lane
            // counter is a vreg local to the kernel frame, so it cannot be seen
            // from here and the read still degrades to 0.
            //
            // This is the residue of #1504 and it is announced rather than left
            // silent: a wrong answer nobody is told about is the failure mode
            // that let the original defect survive for weeks. lean_single does
            // not get this right either — it skips the lane loop entirely for
            // such a kernel (measured: 1 lane instead of 4).
            print("warning: gpu_thread_id_x() outside a kernel lane loop reads 0")
            print(" — inline it into the `kernel fn` body; a helper cannot see the lane counter (#1504)\n")
        }
        let callee_strat_ext: i64 = if fn_id >= 0 && fn_id < (*lo3.module).fn_count { ir_fn_get(&(*lo3.module), fn_id as usize).compile_strategy } else { 0 }
        if callee_strat_ext == 6 {
            let lo_ext = lo3.emit(ir_call_extern(dst, callee_name, args, argc))
            return (lo_ext, dst)
        }
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args, argc)
        var lo4 = pair_call.lo
        // Same rule as the binary-operand site: a call consumes its arguments'
        // pending variance and must not let it escape into an enclosing let.
        lo4.pending_variance_reg = -1
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        var call_instr = ir_call(dst, fn_id, callee_name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo4.module).fn_count {
            if ir_fn_get(&(*lo4.module), fn_id as usize).returns_float == 1 {
                call_instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo5 = lo4.emit(call_instr)
        if call_instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo5 = lo5.emit(ir_mark_float_reg(dst))
        }
        (lo5, dst)
    }

    fn lower_binary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let wide_bits = self.expr_wide_bits_ref(e)
        let lhs_expr_is_float = self.opt_expr_result_is_float_ref(&e.left)
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let rhs_expr_is_float = lo1.opt_expr_result_is_float_ref(&e.right)
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        var lo2 = pair_r.0
        let rhs = pair_r.1
        // A binary expression CONSUMES its operands' pending variance, exactly as a
        // call consumes its arguments'. Lowering `k.value` sets pending_variance_reg
        // to that Knowledge's raw channel so `let x = k.value` inherits it; leaving
        // it set here lets the LAST operand's channel escape into an enclosing let.
        //
        // For `let y = k0.value * k1.value + k2.value * k3.value` the binding then
        // took the pending-reg branch, which never calls lower_expr_variance_ref and
        // so never runs the product/sum sensitivity rules: sensitivity_of(y, k) read
        // 0, 0, 0, 1 against truths 3, 2, 7, 5 — the unit seed of whichever channel
        // happened to be lowered last (#1549).
        //
        // The result's variance must be DERIVED from both operands, never inherited
        // from one of them.
        lo2.pending_variance_reg = -1
        let cmp_op = lower_binary_op_to_wide_cmp(e.bin_op)
        let limbs = lower_wide_limb_count(wide_bits)
        var alloc_limbs = limbs
        if wide_bits > 64 && cmp_op < 0 {
            if e.bin_op == BinaryOp::OpMul {
                alloc_limbs = limbs + 2
            } else if e.bin_op == BinaryOp::OpDiv || e.bin_op == BinaryOp::OpRem {
                alloc_limbs = limbs * 3
            }
        }
        let pair_d = if wide_bits > 64 && cmp_op < 0 { lo2.fresh_wide_reg(alloc_limbs) } else { lo2.fresh_reg() }
        var lo3 = pair_d.0
        let dst = pair_d.1
        // String concatenation: `s + t` / `s ++ t` route to the str_concat builtin (heap
        // alloc + copy), instead of an integer add of the string pointers.
        if e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpConcat {
            if lo3.opt_expr_result_is_string_ref(&e.left) || lo3.opt_expr_result_is_string_ref(&e.right) {
                var lo_sc = lo3
                let sc_fn = lowerer_find_or_add_fn_id_mut(&! lo_sc, make_name("str_concat"))
                let sc_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(lhs, Some(Box::new(ir_reg_list_single(rhs))))))
                let lo_call = lo_sc.emit(ir_call(dst, sc_fn, make_name("str_concat"), sc_args, 2))
                return (lo_call, dst)
            }
        }
        // String equality: `s == t` / `s != t` route to the str_eq builtin (content
        // compare), instead of an integer compare of the string pointers (which is
        // always false for distinct literals). `!=` negates via `(str_eq == 0)`.
        if e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe {
            if lo3.opt_expr_result_is_string_ref(&e.left) || lo3.opt_expr_result_is_string_ref(&e.right) {
                var lo_se = lo3
                let se_fn = lowerer_find_or_add_fn_id_mut(&! lo_se, make_name("str_eq"))
                let se_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(lhs, Some(Box::new(ir_reg_list_single(rhs))))))
                if e.bin_op == BinaryOp::OpEq {
                    let lo_call = lo_se.emit(ir_call(dst, se_fn, make_name("str_eq"), se_args, 2))
                    return (lo_call, dst)
                }
                let eqp = lo_se.fresh_reg()
                var lo_e = eqp.0
                let eq_reg = eqp.1
                lo_e = lo_e.emit(ir_call(eq_reg, se_fn, make_name("str_eq"), se_args, 2))
                let zp = lo_e.fresh_reg()
                var lo_z = zp.0
                let zero_reg = zp.1
                lo_z = lo_z.emit(ir_load_imm(zero_reg, 0))
                let lo_ne = lo_z.emit(ir_binop(dst, eq_reg, BinaryOp::OpEq, zero_reg))
                return (lo_ne, dst)
            }
        }
        if lhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(lhs))
        }
        if rhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(rhs))
        }
        if e.bin_op == BinaryOp::OpMul {
            let hyper_expr_id = lowerer_find_hyper_expr_id_for_span_ref(&lo3, e.span)
            if hyper_expr_id >= 0 && hyper_expr_id < (*lo3.module).epistemic.hyper_expr_count {
                let info = (*lo3.module).epistemic.hyper_exprs[hyper_expr_id as usize]
                if info.op_kind == 1 && info.algebra_tag == 3 {
                    let lo4_h = lo3.emit(ir_hyper_mul_o(dst, lhs, rhs))
                    return (lo4_h, dst)
                }
            }
        }
        if wide_bits > 64 {
            if e.bin_op == BinaryOp::OpShr {
                match e.right {
                    Some(re) => {
                        var shift_bits: i64 = 0 - 1
                        if (*re).kind == ExprKind::ExprIntLit {
                            shift_bits = (*re).int_val
                        } else if (*re).kind == ExprKind::ExprCast {
                            match (*re).left {
                                Some(inner) => {
                                    if (*inner).kind == ExprKind::ExprIntLit {
                                        shift_bits = (*inner).int_val
                                    }
                                }
                                None => {}
                            }
                        }
                        if shift_bits >= 0 {
                            return (lo3.emit(ir_wide_shr(dst, lhs, limbs, shift_bits)), dst)
                        }
                    }
                    None => {}
                }
            }
            if e.bin_op == BinaryOp::OpAdd {
                return (lo3.emit(ir_wide_add(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpSub {
                return (lo3.emit(ir_wide_sub(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpMul {
                return (lo3.emit(ir_wide_mul(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpDiv {
                return (lo3.emit(ir_wide_div_full(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpRem {
                return (lo3.emit(ir_wide_mod_full(dst, lhs, rhs, limbs)), dst)
            } else if cmp_op >= 0 {
                return (lo3.emit(ir_wide_cmp(dst, lhs, rhs, limbs, cmp_op)), dst)
            }
        }
        // Findings 11 (#2084): if BOTH operands of a /, %, or >> binary op
        // resolve to a u8/u16/u32/u64/usize-typed expression, flip the IR
        // bin_op to the unsigned counterpart BEFORE emitting
        // ir_binop_typed. The signed Sar/Idiv path would otherwise give
        // silently wrong magnitudes on operands with bit 63 set
        // (0xFFFF...FFFF >> 1 = 0xFFFF...FFFF under sar; / 2 = 0 under
        // idiv). Wide ops (bits>64) are handled separately by the
        // ir_wide_* path above.
        //
        // Extension (covers `let n: u64 = 0x8000...; n / 2`): an integer
        // literal on the RHS (or LHS) that fits in 64 bits adopts the
        // unsigned interpretation of its sibling -- the textual parser
        // cannot tag a bare `2` as u64, so without this promotion the most
        // common u64 shift/divmod patterns would silently stay signed.
        //
        // Guard is `(both-typed-unsigned) || (literal paired with typed
        // unsigned)`. Two literals with neither typed stay signed (no
        // disjunct fires). One typed unsigned + one signed-expression
        // (e.g. `let sh: u8 = 1; (0-8) >> sh`) also stays signed -- the
        // typed operand alone does NOT flip the op; the contextual
        // promotion only applies to bare literals. Mixing two typed
        // operands of disagreeing signedness is left to the const-prop /
        // checker layer, not silently coerced here. (Review by
        // agourakis82 on PR #2286: the prior form
        // `either_unsigned_p && (rhs_unsigned_p || lhs_unsigned_p || ...)`
        // collapsed to `either_unsigned_p` and broke signed shifts whose
        // shift-amount was a u8/usize local.)
        var final_op = e.bin_op
        let lhs_unsigned_p = lo3.opt_expr_is_unsigned_int_ref(&e.left)
        let rhs_unsigned_p = match e.right {
            Some(rbox) => lo3.expr_is_unsigned_int_ref(&(*rbox)),
            None => false,
        }
        let lhs_is_intlit_p = match e.left {
            Some(lbox) => (*lbox).kind == ExprKind::ExprIntLit,
            None => false,
        }
        let rhs_is_intlit_p = match e.right {
            Some(rbox) => (*rbox).kind == ExprKind::ExprIntLit,
            None => false,
        }
        let both_typed_unsigned_p = lhs_unsigned_p && rhs_unsigned_p
        let literal_pair_with_unsigned_p =
            (lhs_is_intlit_p && rhs_unsigned_p) || (rhs_is_intlit_p && lhs_unsigned_p)
        if both_typed_unsigned_p || literal_pair_with_unsigned_p {
            if e.bin_op == BinaryOp::OpDiv {
                final_op = BinaryOp::OpUDiv
            } else if e.bin_op == BinaryOp::OpRem {
                final_op = BinaryOp::OpURem
            } else if e.bin_op == BinaryOp::OpShr {
                final_op = BinaryOp::OpUShr
            }
        }
        let lo4 = lo3.emit(ir_binop_typed(dst, lhs, final_op, rhs, lhs_expr_is_float, rhs_expr_is_float))
        (lo4, dst)
    }

    fn lower_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lo.call_expr_uses_special_a_ref(e) {
            return lo.lower_call_expr_special_a_ref(e)
        }
        if lo.call_expr_uses_special_b_ref(e) {
            return lo.lower_call_expr_special_b_ref(e)
        }
        lo.lower_call_expr_generic_ref(e)
    }

    // `gpu.thread_id.x` is the field spelling of `gpu_thread_id_x()`.
    //
    // The checker understands the chain (checker_expr_gpu_axis_base_kind walks
    // gpu -> .thread_id -> .x); the lowerer only ever handled the CALL form, so
    // the field form fell through to ordinary struct field access on an ident
    // that is not a local. Measured on identical kernels differing ONLY in this
    // spelling: gpu_thread_id_x() gives a[1] = 3.0, gpu.thread_id.x segfaults
    // the program at rc=139 (#1596).
    //
    // Only the x axis is mapped, matching the call form: the lane loop (#1512)
    // is one-dimensional, so y and z have no counter to read and keep their
    // previous behaviour rather than silently aliasing x.
    fn expr_is_gpu_thread_id_x_ref(self, e: &Expr) -> bool with Mut, Panic, Div {
        if (*e).kind != ExprKind::ExprFieldAccess {
            return false
        }
        if !ir_name_eq((*e).name, make_name("x")) {
            return false
        }
        match (*e).left {
            Some(mid) => {
                if (*mid).kind != ExprKind::ExprFieldAccess {
                    return false
                }
                if !ir_name_eq((*mid).name, make_name("thread_id")) {
                    return false
                }
                match (*mid).left {
                    Some(root) => (*root).kind == ExprKind::ExprIdent && ir_name_eq((*root).name, make_name("gpu")),
                    None => false,
                }
            }
            None => false,
        }
    }

    fn lower_field_access_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if self.expr_is_gpu_thread_id_x_ref(e) {
            let pair_t = self.fresh_reg()
            var lo_t = pair_t.0
            let dst_t = pair_t.1
            if LOWER_KERNEL_TID_REG >= 0 {
                lo_t = lo_t.emit(ir_copy(dst_t, LOWER_KERNEL_TID_REG))
                return (lo_t, dst_t)
            }
            // Outside a kernel lane loop there is no counter to read. Falling
            // through to ordinary field access is what SEGFAULTED (rc=139) on
            // `fn helper() -> i64 with GPU { gpu.thread_id.x }` -- the checker
            // accepts that program, so the path is reachable and a guard that
            // only covers the in-kernel case leaves the original defect alive.
            // Degrade to 0 and SAY SO, mirroring gpu_thread_id_x()'s existing
            // behaviour rather than inventing a second one.
            print("warning: gpu.thread_id.x outside a `kernel fn` reads 0")
            print(" -- inline it into the kernel body; a helper cannot see the lane counter (#1504)\n")
            lo_t = lo_t.emit(ir_load_imm(dst_t, 0))
            return (lo_t, dst_t)
        }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1_pre = pair_b.0
        let base_pre = pair_b.1
        // AUTO-DEREF THROUGH A POINTER-TYPED FIELD.
        //
        // A Box deref is represented in this IR as IrFieldGet with field index 0 — see
        // native/codegen_x86_linux.sio:7404 and :7436 ("Box deref is lowered to IrFieldGet(0)
        // earlier"). The lowerer only ever produced that step for an EXPLICIT `*x` whose operand
        // is an ident bound to a Box local (lower_unary_expr_ref, is_box_deref). It was never
        // produced for an auto-deref through a pointer-typed FIELD, so `h.inner.a` with
        // `inner: Box<Inner>` lowered to two field_gets:
        //     t1 = field_get(h,  idx(inner))     // t1 holds the Box, i.e. a pointer
        //     t2 = field_get(t1, idx(a))         // applies a's offset TO THE POINTER ITSELF
        // which is correct for an inline field and reads at the pointer's own address for a Box.
        // Measured: the compiled program SIGSEGVs, while the identical shape with an inline
        // field returns 7 on both engines. Inserting the missing middle step makes the chain
        //     t1 = field_get(h, idx(inner))  ->  t2 = field_get(t1, 0)  ->  t3 = field_get(t2, idx(a))
        //
        // Recorded because it cost a build cycle: an earlier attempt set instr.label_id on the
        // outer access instead, on the assumption that the backend consumed it as a deref marker
        // for field access. It does not — no codegen site reads label_id for IrFieldGet — so that
        // version changed nothing measurable.
        var lo1 = lo1_pre
        var base = base_pre
        let base_field_is_ptr = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprFieldAccess {
                    // Type-aware for the same reason as the bind site above.
                    lo1_pre.field_is_pointer_for_base_ref(&(*base_expr_ref).left, (*base_expr_ref).name)
                } else {
                    false
                }
            }
            _ => false,
        }
        // The base ITSELF is a Box: dereference before applying the field offset, and resolve the
        // index against T. Read through the locals Box directly — a by-value `self` lookup here is
        // what broke the four previous attempts (bisected: the write at bind time is harmless).
        let base_box_layout = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    lower_lookup_box_inner_layout(lo1_pre.locals, lo1_pre.scope_depth, (*base_expr_ref).name)
                } else {
                    0 - 1
                }
            }
            _ => 0 - 1,
        }
        // Box-tagged with a known inner layout (Box::new / param binds) OR
        // Box-tagged with layout -1 (field-chain binds: `let p = h.inner`,
        // where the layout table cannot name the inner T). Both need the
        // payload read; only the first can resolve the index against T.
        let base_ident_box_tagged = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    ir_name_is_box(lo1_pre.lookup_local_struct_type((*base_expr_ref).name))
                } else {
                    false
                }
            }
            _ => false,
        }
        let base_ident_is_box = base_box_layout >= 0 || base_ident_box_tagged
        if str_eq(read_env("SOUNIO_BOX_TRACE"), "1") {
            print("boxtrace: READ field=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" layout=")
            print_int(base_box_layout)
            print("\n")
        }
        if base_field_is_ptr || base_ident_is_box {
            let pair_deref = lo1_pre.fresh_reg()
            let lo_d = pair_deref.0
            let deref_dst = pair_deref.1
            lo1 = lo_d.emit(ir_field_get(deref_dst, base_pre, 0, ir_empty_name()))
            base = deref_dst
        }
        let fidx = if base_box_layout >= 0 {
            lo1.field_idx_from_name((*lo1.struct_layouts).entries[base_box_layout as usize].type_name, e.name)
        } else if base_ident_box_tagged {
            // Box-tagged with layout -1: field_idx_for_base_ref would resolve
            // against the literal "Box" (no such struct) and fall through to
            // the first-byte hash. Take the explicit `(*p).f` route instead —
            // after the payload read the base is no longer an ident, so the
            // by-name scan across registered structs resolves the field.
            lo1.field_idx_from_name_simple(e.name)
        } else {
            lo1.field_idx_for_base_ref(&e.left, e.name)
        }
        // Tuple desugar: let __tup = f(); let a = __tup.0 — float-element base
        // means .0/.1 are f64 even without a struct layout entry.
        var field_is_float = lo1.field_is_float_for_base_ref(&e.left, e.name) || lo1.field_is_float_by_name_simple(e.name)
        match e.left {
            Some(be) => {
                if (*be).kind == ExprKind::ExprIdent {
                    if lo1.lookup_local_array_elem_float((*be).name) {
                        field_is_float = true
                    }
                }
            }
            _ => {}
        }
        let field_array_elem_is_float = lo1.field_array_elem_is_float_for_base_ref(&e.left, e.name)
        let base_is_ref = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    lo1.lookup_local_is_ref((*base_expr_ref).name)
                } else {
                    false
                }
            }
            _ => false,
        }
        if lower_aggregate_diag_enabled() {
            print("lower_agg: field name=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" idx=")
            print_int(fidx)
            print(" field_float=")
            print_int(if field_is_float { 1 } else { 0 })
            print(" field_array_float=")
            print_int(if field_array_elem_is_float { 1 } else { 0 })
            print("\n")
        }
        if str_eq(read_env("SOUNIO_DUMP_LAYOUTS"), "1") {
            print("DUMP field=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" idx=")
            print_int(fidx)
            print(" layouts.count=")
            print_int((*lo1.struct_layouts).count)
            print("\n")
            var di: i64 = 0
            while di < (*lo1.struct_layouts).count {
                print("  [")
                print_int(di)
                print("] ")
                print(str_from_bytes((*lo1.struct_layouts).entries[di as usize].type_name.buf, (*lo1.struct_layouts).entries[di as usize].type_name.len))
                print(" fc=")
                print_int((*lo1.struct_layouts).entries[di as usize].field_count)
                var dj: i64 = 0
                while dj < (*lo1.struct_layouts).entries[di as usize].field_count {
                    print(" ")
                    print(str_from_bytes(ir_name_at((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].name_id).buf, ir_name_at((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].name_id).len))
                    print(":")
                    print_int((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].index)
                    // The type CLASS was missing from this dump, which is the one thing needed
                    // to tell a mis-populated layout from a mis-consumed one. 1=f64,
                    // 2=array-of-f64, 3=integer, 4=pointer (Box/&/&!/*mut), 0=other.
                    print("/cls")
                    print_int((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].is_float)
                    dj = dj + 1
                }
                print("\n")
                di = di + 1
            }
        }
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        var instr = ir_field_get(dst, base, fidx, e.name)
        if base_is_ref {
            instr.label_id = 1
        }
        if field_is_float || field_array_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo3 = lo2.emit(instr)
        if instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo3 = lo3.emit(ir_mark_float_reg(dst))
        }
        if field_array_elem_is_float {
            lo3 = lo3.bind_reg_array_elem_float(dst)
        }
        // β-Madaros: Knowledge.value extraction seeds let-bound variance shadow
        // so variance_of(a1) and FO product/sub work after `let a1 = k.value`.
        // Also seed multi-channel FO sensitivity (∂/∂seed = 1) into pending_sens.
        if ir_name_eq(e.name, make_name("value")) {
            match e.left {
                Some(base_expr) => {
                    if (*base_expr).kind == ExprKind::ExprIdent {
                        let vpair = lo3.lower_knowledge_variance_for_ident((*base_expr).name)
                        lo3 = vpair.0
                        if vpair.1 >= 0 {
                            lo3.pending_variance_reg = vpair.1
                            lo3 = lo3.fo_seed_from_variance(vpair.1, 0 - 1)
                            var pk: i64 = 0
                            while pk < 32 {
                                lo3.fo_pending_sens[pk as usize] = lo3.fo_expr_sens[pk as usize]
                                pk = pk + 1
                            }
                        }
                    }
                }
                _ => {}
            }
        }
        (lo3, dst)
    }

    fn lower_index_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let index_elem_is_float_pre = self.index_base_elem_is_float_ref(&e.left)
        let base_is_seq = ir_name_eq(self.lower_method_recv_type(&e.left), make_name("Seq"))
        // Detect packed-string bases BEFORE consuming self (string lit, scalar_kind
        // 3 local, or packed-string producer call). Must win over the default
        // local-array IndexGet path — see lower_name_is_packed_string_producer.
        let base_is_string = self.opt_expr_result_is_string_ref(&e.left)
        let global_elem_size = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    let global_fn_id = lowerer_lookup_fn_id_by_name_ref(&self, (*base_expr_ref).name)
                    if global_fn_id >= 0 && global_fn_id < self.module.fn_count
                        && ir_fn_get(&(*self.module), global_fn_id as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                        ir_fn_get(&(*self.module), global_fn_id as usize).hyper_algebra_kind
                    } else {
                        0
                    }
                } else {
                    0
                }
            }
            _ => 0,
        }
        let base_is_ref = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    self.lookup_local_is_ref((*base_expr_ref).name)
                } else {
                    false
                }
            }
            _ => false,
        }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base = pair_b.1
        let index_elem_is_float = index_elem_is_float_pre || lo1.lookup_reg_array_elem_float(base)
        if lower_aggregate_diag_enabled() {
            print("lower_agg: index pre=")
            print_int(if index_elem_is_float_pre { 1 } else { 0 })
            print(" reg=")
            print_int(if lo1.lookup_reg_array_elem_float(base) { 1 } else { 0 })
            print(" final=")
            print_int(if index_elem_is_float { 1 } else { 0 })
            print(" base=")
            print_int(base)
            print("\n")
        }
        let pair_i = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_i.0
        let idx = pair_i.1
        if base_is_seq {
            var lo_seq_get = lo2
            let call_name_seq_get = make_name("__sounio_seq_get")
            let fn_id_seq_get = lowerer_find_or_add_fn_id_mut(&! lo_seq_get, call_name_seq_get)
            let call_args_seq_get: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(
                base,
                Some(Box::new(ir_reg_list_single(idx))),
            )))
            let pair_d_seq_get = lo_seq_get.fresh_reg()
            lo_seq_get = pair_d_seq_get.0
            let dst_seq_get = pair_d_seq_get.1
            return (lo_seq_get.emit(ir_call(dst_seq_get, fn_id_seq_get, call_name_seq_get, call_args_seq_get, 2)), dst_seq_get)
        }
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        var instr = ir_index_get(dst, base, idx)
        // label_id routing for native-v2 codegen_x86_linux IrIndexGet:
        //   4 = raw signed byte load  movsx rax, byte [base+idx]  (BSS i8)
        //   3 = raw byte load         movzx rax, byte [base+idx]  (packed *u8 / BSS u8)
        //   2 = raw word load         mov  rax, [base+idx*8]      (BSS non-byte)
        //   1 = ref array             deref handle slot then *8
        //   0 = local/param GC handle resolve then *8
        // hyper_algebra_kind 17 = i8 (signed), 1 = u8 (unsigned); both physical size 1.
        if base_is_string {
            instr.label_id = 3
        } else if global_elem_size > 0 {
            if lower_bss_elem_is_signed_byte(global_elem_size) {
                instr.label_id = 4
            } else if lower_bss_elem_physical_size(global_elem_size) == 1 {
                instr.label_id = 3
            } else {
                instr.label_id = 2
            }
        } else if base_is_ref {
            instr.label_id = 1
        }
        if index_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo4 = lo3.emit(instr)
        if index_elem_is_float {
            lo4 = lo4.emit(ir_mark_float_reg(dst))
        }
        (lo4, dst)
    }

    fn lower_array_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match e.left {
            Some(_) => self.lower_array_repeat_literal_ref(e),
            None => {
                let elem_is_float = lower_expr_is_f64_array_literal_ref(e)
                let pair_dst = self.fresh_reg()
                var lo = pair_dst.0
                let dst = pair_dst.1
                let arr_lit_count = count_expr_list_ref(&e.args)
                lo = lo.emit(ir_alloc_array(dst, lo.aggregate_storage_bytes(arr_lit_count), arr_lit_count))
                lo = lo.lower_array_elems_ref(dst, &e.args, 0)
                if elem_is_float {
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo = lo.bind_reg_array_elem_float(dst)
                }
                (lo, dst)
            }
        }
    }

    fn lower_cast_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub.0
        let src_reg = sub.1
        let wide_bits = lower_opt_type_wide_bits(&e.cast_type)
        let source_is_float = lo1.opt_expr_result_is_float_ref(&e.left)
        if wide_bits > 64 {
            let limbs = lower_wide_limb_count(wide_bits)
            let p = lo1.fresh_wide_reg(limbs)
            var lo2 = p.0
            let dst = p.1
            lo2 = lo2.emit(ir_copy(dst, src_reg))
            var wi: i64 = 1
            while wi < limbs {
                lo2 = lo2.emit(ir_load_imm(dst + wi, 0))
                wi = wi + 1
            }
            match e.left {
                Some(left_e) => {
                    if (*left_e).kind == ExprKind::ExprIntLit {
                        let _payload_id = ir_wide_compile_pool_intern_low(wide_bits, (*left_e).int_val)
                    }
                }
                None => {}
            }
            (lo2, dst)
        } else if lower_cast_type_is_f64(&e.cast_type) {
            if source_is_float {
                return (lo1, src_reg)
            }
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_int_to_float(dst, src_reg)), dst)
        } else if source_is_float || lower_opt_expr_has_float_source(&e.left) {
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_float_to_int(dst, src_reg)), dst)
        } else {
            (lo1, src_reg)
        }
    }

    fn lower_unary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // BSS aggregate &GG / &!GG: native-v2 OpRef is LEA of a stack slot, and
        // ref_array_* then does load[slot] → resolve_handle → +object_header.
        // Stash (bss_addr - header) in the slot so the +header step lands on the
        // true BSS base (direct GG[i] stays on raw IndexGet without header).
        // Without this, &!GG LEAs a slot holding the plain BSS address; the
        // callee writes at BSS+header and GG[i] still reads the untouched base.
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            match e.left {
                Some(operand) => {
                    if (*operand).kind == ExprKind::ExprIdent {
                        var bss_off: i64 = -1
                        var is_agg = false
                        if self.lookup_local_is_global((*operand).name) {
                            let gsize = self.lookup_local_global_bss_size((*operand).name)
                            var hyper_kind: i64 = 8
                            var local_g_kind: i64 = 0
                            let gfn = lowerer_lookup_fn_id_by_name_ref(&self, (*operand).name)
                            if gfn >= 0 && gfn < self.module.fn_count {
                                hyper_kind = ir_fn_get(&(*self.module), gfn as usize).hyper_algebra_kind
                                local_g_kind = lower_global_type_table_lookup(&(*self.global_types), gfn)
                            }
                            if lower_bss_slot_is_aggregate(gsize, hyper_kind) || lower_global_kind_is_array_base(local_g_kind) {
                                bss_off = self.lookup_local_global_bss_offset((*operand).name)
                                is_agg = true
                            }
                        } else {
                            let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, (*operand).name)
                            if fn_id >= 0 && fn_id < self.module.fn_count {
                                if ir_fn_get(&(*self.module), fn_id as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                    let gsize = ir_fn_get(&(*self.module), fn_id as usize).bss_size
                                    let hyper_kind = ir_fn_get(&(*self.module), fn_id as usize).hyper_algebra_kind
                                    let global_elem_kind = lower_global_type_table_lookup(&(*self.global_types), fn_id)
                                    if lower_bss_slot_is_aggregate(gsize, hyper_kind) || lower_global_kind_is_array_base(global_elem_kind) {
                                        bss_off = ir_fn_get(&(*self.module), fn_id as usize).param_count
                                        is_agg = true
                                    }
                                }
                            }
                        }
                        if is_agg && bss_off >= 0 {
                            let adjusted = BSS_BASE_LINUX + bss_off - IR_NATIVE_V2_OBJECT_HEADER_SIZE
                            let pair_s = self.fresh_reg()
                            var lo = pair_s.0
                            let src = pair_s.1
                            lo = lo.emit(ir_load_imm(src, adjusted))
                            let pair_d = lo.fresh_reg()
                            lo = pair_d.0
                            let dst = pair_d.1
                            lo = lo.emit(ir_unaryop(dst, e.un_op, src))
                            return (lo, dst)
                        }
                    }
                }
                None => {}
            }
        }
        // `*b` where b is a Box reads field 0 of the heap object (where lower_box_new
        // stored the value via ir_field_set(ptr, 0, val)), so route Box deref to
        // IrFieldGet(0) — codegen resolves the handle. IrUnaryOp(OpDeref) stays a raw
        // pointer load for true references (&T), which are raw addresses, not handles.
        let is_box_deref = if e.un_op == UnaryOp::OpDeref {
            let opt_ref = &e.left
            match *opt_ref {
                Some(operand) => {
                    if (*operand).kind == ExprKind::ExprIdent {
                        ir_name_is_box(self.lookup_local_struct_type((*operand).name))
                    } else if (*operand).kind == ExprKind::ExprFieldAccess {
                        // `(*h.inner)` where inner: Box<T> — the ident arm cannot
                        // see a field chain, and the generic pointer arm would
                        // emit a raw load through the handle. Box-only predicate:
                        // a &T field must keep the raw-pointer deref.
                        self.field_is_box_for_base_ref(&(*operand).left, (*operand).name)
                    } else {
                        false
                    }
                }
                None => false,
            }
        } else {
            false
        }
        let pair_s = self.lower_opt_expr_ref(&e.left)
        var lo1 = pair_s.0
        let src = pair_s.1
        // Arithmetic negation CONSUMES its operand's pending variance, exactly as a
        // binary operator and a call do. Leaving it set let `let d = -a.value` bind
        // a's RAW channel: sensitivity_of(d, 0) read +1.0 where truth is -1.0, the
        // sign silently dropped. The negated channels come from the OpNeg case in
        // lower_expr_variance_ref, which the else-branch of the let now reaches.
        if e.un_op == UnaryOp::OpNeg {
            lo1.pending_variance_reg = -1
        }
        let src_is_float = if e.un_op == UnaryOp::OpNeg {
            lo1.opt_expr_result_is_float_ref(&e.left)
        } else {
            false
        }
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        if lower_aggregate_diag_enabled() {
            print("lower_agg: unary deref, is_box_deref=")
            print_int(if is_box_deref { 1 } else { 0 })
            print("\n")
        }
        var lo3 = if is_box_deref {
            lo2.emit(ir_field_get(dst, src, 0, ir_empty_name()))
        } else {
            lo2.emit(ir_unaryop(dst, e.un_op, src))
        }
        if src_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(dst))
        }
        (lo3, dst)
    }

    // Receiver struct type for a method call. Used to mangle the call to the same
    // name the impl method was registered under. Empty when the type can't be
    // determined here. Covers:
    //   - local idents (`c.method()`)
    //   - chained method receivers (`a.add(&b).get()`) via return_struct_name
    //   - associated/free call receivers (`E::of(3.0).get()`)
    //   - primitive index receivers (`a.c[i].er_add(...)`)
    fn lower_method_recv_type(self, left: &Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match *left {
            Some(recv) => {
                if (*recv).kind == ExprKind::ExprIdent {
                    let struct_type = self.lookup_local_struct_type((*recv).name)
                    if struct_type.len > 0 {
                        return struct_type
                    }
                    // Primitive impl methods are registered under their builtin
                    // type names (`i64_er_add`), not under the bare method name.
                    // Locals retain scalar-kind metadata even though they have no
                    // struct type; preserve it for dispatch or lowering invents a
                    // body-less `er_add` function and native codegen dereferences it.
                    let scalar_kind = self.lookup_local_scalar_kind((*recv).name)
                    if scalar_kind == 2 {
                        return make_name("f64")
                    }
                    if scalar_kind == 1 {
                        return make_name("i64")
                    }
                    return ir_empty_name()
                }
                if (*recv).kind == ExprKind::ExprFieldAccess {
                    return self.expr_receiver_struct_type_ref(&(*recv))
                }
                // `(*p).method()`. There was no ExprUnary case at all, so a deref
                // receiver came back empty and the call went to the BARE method
                // name -- which invents a body-less function, exactly as the
                // comment above this one warns. Measured on a gen2 self-compile:
                // 40 such sites, and the bucket did not move at all when the
                // ident and field shapes were fixed, so it is a cause of its own.
                //
                // 47 occurrences in check.sio and lower.sio, all `(*lo).emit(...)`
                // / `(*c).check_items(...)`: a `&! T` parameter dereferenced to
                // call a method. lower_param_struct_type_name already unwraps
                // TypeReference/TypeRefMut, so the operand's own struct type IS
                // the answer -- except for a Box, where the literal "Box" names no
                // layout and the inner T has to come from box_inner_layout.
                //
                // Read through the locals Box, not a by-value `self` lookup: the
                // same discipline lower_lookup_box_inner_layout exists for.
                if (*recv).kind == ExprKind::ExprUnary && (*recv).un_op == UnaryOp::OpDeref {
                    match (*recv).left {
                        Some(operand) => {
                            if (*operand).kind == ExprKind::ExprIdent {
                                let ost = self.lookup_local_struct_type((*operand).name)
                                if ir_name_is_box(ost) {
                                    let bl = lower_lookup_box_inner_layout(self.locals, self.scope_depth, (*operand).name)
                                    if bl >= 0 && bl < (*self.struct_layouts).count {
                                        return (*self.struct_layouts).entries[bl as usize].type_name
                                    }
                                    return ir_empty_name()
                                }
                                if ost.len > 0 {
                                    return ost
                                }
                            }
                            if (*operand).kind == ExprKind::ExprFieldAccess {
                                return self.expr_receiver_struct_type_ref(&(*operand))
                            }
                        }
                        _ => {}
                    }
                    return ir_empty_name()
                }
                // Root 2 chain residual: method call on a method result.
                // `a.add(&b).get()` — outer mangling needs the inner method's
                // return_struct_name (E), not an empty name that invents bare "get".
                if (*recv).kind == ExprKind::ExprMethodCall {
                    let inner_recv = self.lower_method_recv_type(&(*recv).left)
                    if ir_name_eq(inner_recv, make_name("Seq")) && ir_name_eq((*recv).name, make_name("len")) {
                        return make_name("Knowledge")
                    }
                    let inner_call = if inner_recv.len > 0 {
                        ir_mangle_method_name(inner_recv, (*recv).name)
                    } else {
                        (*recv).name
                    }
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, inner_call)
                    let ret = self.return_struct_name_for_fn_id(fn_id)
                    if ret.len > 0 {
                        return ret
                    }
                    // Self-returning methods often omit a distinct return name in
                    // edge stubs; reuse the receiver type when known.
                    if inner_recv.len > 0 {
                        return inner_recv
                    }
                    return ir_empty_name()
                }
                // Associated / free call as receiver: `E::of(3.0).get()`.
                if (*recv).kind == ExprKind::ExprCall {
                    match (*recv).left {
                        Some(callee) => {
                            if (*callee).kind == ExprKind::ExprIdent && name_eq((*callee).name, make_name("seq_len")) {
                                return make_name("Knowledge")
                            }
                        }
                        None => {}
                    }
                    let ret = self.expr_call_return_struct_name_ref(&(*recv))
                    if ret.len > 0 {
                        return ret
                    }
                    return ir_empty_name()
                }
                // Primitive-receiver fallback for a non-ident scalar receiver such
                // as an array element `a.c[i]` (the imported cd_exact lane calls
                // `a.c[i].er_add(b.c[i])`). Such a receiver has no local struct
                // type, so the bare method name would bind to a body-less fn and
                // crash codegen. A monomorphized `[i64;N]` field registers with no
                // positive i64 marker, so classify float positively (f64$m) and map
                // every other primitive-scalar index to i64$m — matching the symbol
                // emitted for `impl ExactRing for i64`. No corpus test dispatches a
                // method on a STRUCT array element, so this cannot misroute a green
                // struct-method call (those already fail today at the empty-name path).
                if (*recv).kind == ExprKind::ExprIndex {
                    // Resolve the receiver's ACTUAL struct field element type FIRST —
                    // authoritative from its own struct layout (`a.c[i]` with
                    // `c: [Rational; N]` -> "Rational"; `[f64; N]` -> "f64";
                    // `[i64; N]` -> "i64"). This MUST precede the float check below:
                    // index_base_elem_is_float_ref falls back to a by-NAME search
                    // that misfires when a DIFFERENT struct has a same-named [f64;N]
                    // field (the f64 `CDElement.c` vs `CDElementExact.c` over an exact
                    // ring), wrongly classifying the struct element as f64 and
                    // dispatching to a body-less `f64_<method>` that crashes codegen.
                    let struct_elem = self.index_base_elem_struct_type_ref(&(*recv).left)
                    if struct_elem.len > 0 {
                        return struct_elem
                    }
                    // Local array element (no owning struct): fall back to the float /
                    // i64 heuristics for `arr[i].method()` where `arr` is a local.
                    if self.index_base_elem_is_float_ref(&(*recv).left) {
                        return make_name("f64")
                    }
                    return make_name("i64")
                }
                ir_empty_name()
            }
            _ => ir_empty_name()
        }
    }

    fn lower_seq_len_knowledge_from_base(self, base_reg: i64) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_len = self.fresh_reg()
        var lo = pair_len.0
        let len_reg = pair_len.1
        lo = lo.emit(ir_array_len(len_reg, base_reg))

        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))
        lo = lo.emit(ir_field_set(dst, 0, len_reg, make_name("value")))

        let pair_variance = lo.fresh_reg()
        lo = pair_variance.0
        let variance_reg = pair_variance.1
        lo = lo.emit(ir_load_float(variance_reg, 0.0))
        lo = lo.emit(ir_field_set(dst, 1, variance_reg, make_name("variance")))

        let pair_confidence = lo.fresh_reg()
        lo = pair_confidence.0
        let confidence_reg = pair_confidence.1
        lo = lo.emit(ir_load_float(confidence_reg, 1.0))
        lo = lo.emit(ir_field_set(dst, 2, confidence_reg, make_name("confidence")))
        lo = lo.bind_variance_for_base_reg(dst, variance_reg)
        (lo, dst)
    }

    // GPU.sync() is a no-op on this backend, and it has to be recognised HERE.
    //
    // The checker already accepts it and types it as unit
    // (checker_expr_is_gpu_sync_call), but nothing lowered it, so it fell
    // through to the ordinary method-call path: receiver `GPU` is not a local,
    // and find_or_add_fn_id("sync") then minted a BODY-LESS function. That is
    // the exact failure the comment below this one warns about, and it took the
    // compiler down with SIGSEGV -- rc=139, no ELF, on four lines of input:
    //
    //     fn main() -> i32 with GPU, IO { perform GPU.sync(); 0 }
    //
    // lean_single compiles the same file fine (#1594).
    //
    // No-op is the honest semantics, not a stub: the kernel lane loop (#1512)
    // runs every lane inside the launch before it returns, so by the time sync
    // is reached there is nothing outstanding to wait for. A device backend
    // that launches asynchronously would need a real barrier here.
    fn expr_is_gpu_sync_call_ref(self, e: &Expr) -> bool with Mut, Panic, Div {
        if (*e).kind != ExprKind::ExprMethodCall {
            return false
        }
        if !ir_name_eq((*e).name, make_name("sync")) {
            return false
        }
        match (*e).left {
            Some(base) => (*base).kind == ExprKind::ExprIdent && ir_name_eq((*base).name, make_name("GPU")),
            None => false,
        }
    }

    fn lower_method_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if self.expr_is_gpu_sync_call_ref(e) {
            // Unit. A plain integer zero -- emit_f64_const would mark the
            // register as float for a value that is never read.
            let pair_u = self.fresh_reg()
            var lo_u = pair_u.0
            let reg_u = pair_u.1
            lo_u = lo_u.emit(ir_load_imm(reg_u, 0))
            return (lo_u, reg_u)
        }
        let recv_type = self.lower_method_recv_type(&e.left)
        if ir_name_eq(recv_type, make_name("Knowledge")) && ir_name_eq(e.name, make_name("unwrap")) {
            match e.args {
                Some(reason_args) => {
                    let has_extra_reason = match (*reason_args).tail {
                        Some(_) => true,
                        None => false,
                    }
                    if has_extra_reason || (*reason_args).head.kind != ExprKind::ExprStringLit {
                        var lo_bad_unwrap = self
                        lowerer_mark_hard_error(&! lo_bad_unwrap)
                        return (lo_bad_unwrap, IR_INVALID_REG)
                    }
                }
                None => {
                    var lo_bad_unwrap_none = self
                    lowerer_mark_hard_error(&! lo_bad_unwrap_none)
                    return (lo_bad_unwrap_none, IR_INVALID_REG)
                }
            }
            let pair_base_knowledge = self.lower_opt_expr_ref(&e.left)
            var lo_knowledge = pair_base_knowledge.0
            let pair_value = lo_knowledge.fresh_reg()
            lo_knowledge = pair_value.0
            let value_reg = pair_value.1
            lo_knowledge = lo_knowledge.emit(ir_field_get(value_reg, pair_base_knowledge.1, 0, make_name("value")))
            if lo_knowledge.expr_result_is_float_ref(e) {
                lo_knowledge = lo_knowledge.emit(ir_mark_float_reg(value_reg))
            }
            return (lo_knowledge, value_reg)
        }
        // `.len()` is intrinsic for strings, arrays, and open slices. It is
        // accepted by the checker, but lowering it as an ordinary method invents
        // a body-less `len` function and crashes the native path.
        if ir_name_eq(e.name, make_name("len")) && !ir_name_eq(recv_type, make_name("Seq")) {
            match e.args {
                None => {
                    match e.left {
                        Some(recv) => {
                            if self.expr_result_is_string_ref(&(*recv)) {
                                let pair_b = self.lower_expr_ref(&(*recv))
                                var lo = pair_b.0
                                let base_reg = pair_b.1
                                let fn_id = lowerer_find_or_add_fn_id_mut(&! lo, make_name("str_len"))
                                let pair_d = lo.fresh_reg()
                                lo = pair_d.0
                                let dst = pair_d.1
                                let len_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(base_reg)))
                                return (lo.emit(ir_call(dst, fn_id, make_name("str_len"), len_args, 1)), dst)
                            }
                            if (*recv).kind == ExprKind::ExprIdent {
                                let pair_b = self.lower_expr_ref(&(*recv))
                                var lo = pair_b.0
                                let base_reg = pair_b.1
                                let pair_d = lo.fresh_reg()
                                lo = pair_d.0
                                let dst = pair_d.1
                                var len_instr = ir_array_len(dst, base_reg)
                                // A slice/reference parameter may be a bare handle, a
                                // raw BSS address, or an explicit caller cell. Preserve
                                // that distinction for the native resolver.
                                if lo.lookup_local_is_ref((*recv).name) {
                                    len_instr.label_id = 1
                                }
                                return (lo.emit(len_instr), dst)
                            }
                        }
                        None => {}
                    }
                }
                Some(_) => {
                    // The checker rejects non-zero arity with E010. Refuse here
                    // too so a malformed or unchecked AST cannot fall through,
                    // invent a body-less `len`, and crash native codegen.
                    var lo_bad = self
                    lowerer_mark_error(&! lo_bad)
                    return (lo_bad, IR_INVALID_REG)
                }
            }
        }
        // Impl methods are lowered as mangled free functions (ir_mangle_method_name).
        // A `recv.method()` call must resolve to that SAME mangled name; using the bare
        // method name finds/creates a body-less fn -> codegen crash.
        if ir_name_eq(recv_type, make_name("Seq")) {
            if ir_name_eq(e.name, make_name("count")) || ir_name_eq(e.name, make_name("len")) {
                match e.args {
                    None => {
                        let pair_b_seq = self.lower_opt_expr_ref(&e.left)
                        var lo_seq = pair_b_seq.0
                        let base_reg_seq = pair_b_seq.1
                        if ir_name_eq(e.name, make_name("len")) {
                            return lo_seq.lower_seq_len_knowledge_from_base(base_reg_seq)
                        }
                        let pair_d_seq = lo_seq.fresh_reg()
                        lo_seq = pair_d_seq.0
                        let dst_seq = pair_d_seq.1
                        return (lo_seq.emit(ir_array_len(dst_seq, base_reg_seq)), dst_seq)
                    }
                    Some(_) => {
                        var lo_bad_seq_m = self
                        lowerer_mark_hard_error(&! lo_bad_seq_m)
                        return (lo_bad_seq_m, IR_INVALID_REG)
                    }
                }
            }
            if ir_name_eq(e.name, make_name("push")) {
                let pair_b_seq_push = self.lower_opt_expr_ref(&e.left)
                var lo_seq_push = pair_b_seq_push.0
                let base_reg_seq_push = pair_b_seq_push.1
                let pair_args_seq_push: LowerExprArgsResult = lo_seq_push.lower_expr_args_raw_ref(&e.args)
                lo_seq_push = pair_args_seq_push.lowerer
                if pair_args_seq_push.count != 1 {
                    lowerer_mark_hard_error(&! lo_seq_push)
                    return (lo_seq_push, IR_INVALID_REG)
                }
                let call_name_seq_push = make_name("__sounio_seq_push")
                let fn_id_seq_push = lowerer_find_or_add_fn_id_mut(&! lo_seq_push, call_name_seq_push)
                let call_args_seq_push: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(
                    base_reg_seq_push,
                    Some(Box::new(pair_args_seq_push.regs)),
                )))
                let pair_d_seq_push = lo_seq_push.fresh_reg()
                lo_seq_push = pair_d_seq_push.0
                let dst_seq_push = pair_d_seq_push.1
                return (lo_seq_push.emit(ir_call(dst_seq_push, fn_id_seq_push, call_name_seq_push, call_args_seq_push, 2)), dst_seq_push)
            }
            if ir_name_eq(e.name, make_name("get")) || ir_name_eq(e.name, make_name("set")) {
                let pair_b_seq_access = self.lower_opt_expr_ref(&e.left)
                var lo_seq_access = pair_b_seq_access.0
                let base_reg_seq_access = pair_b_seq_access.1
                let pair_args_seq_access: LowerExprArgsResult = lo_seq_access.lower_expr_args_raw_ref(&e.args)
                lo_seq_access = pair_args_seq_access.lowerer
                let is_seq_get = ir_name_eq(e.name, make_name("get"))
                let expected_seq_args: i64 = if is_seq_get { 1 } else { 2 }
                if pair_args_seq_access.count != expected_seq_args {
                    lowerer_mark_hard_error(&! lo_seq_access)
                    return (lo_seq_access, IR_INVALID_REG)
                }
                let call_name_seq_access = if is_seq_get {
                    make_name("__sounio_seq_get")
                } else {
                    make_name("__sounio_seq_set")
                }
                let fn_id_seq_access = lowerer_find_or_add_fn_id_mut(&! lo_seq_access, call_name_seq_access)
                let call_args_seq_access: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(
                    base_reg_seq_access,
                    Some(Box::new(pair_args_seq_access.regs)),
                )))
                let pair_d_seq_access = lo_seq_access.fresh_reg()
                lo_seq_access = pair_d_seq_access.0
                let dst_seq_access = pair_d_seq_access.1
                return (lo_seq_access.emit(ir_call(
                    dst_seq_access,
                    fn_id_seq_access,
                    call_name_seq_access,
                    call_args_seq_access,
                    expected_seq_args + 1,
                )), dst_seq_access)
            }
            if ir_name_eq(e.name, make_name("push_uncertain")) {
                print("error: native-v2 Seq method lowering is not implemented for this method; refusing generic method call\\n")
                var lo_bad_seq_method = self
                lowerer_mark_hard_error(&! lo_bad_seq_method)
                return (lo_bad_seq_method, IR_INVALID_REG)
            }
        }
        let call_name = if recv_type.len > 0 { ir_mangle_method_name(recv_type, e.name) } else { e.name }
        if recv_type.len == 0 && lower_recv_trace_enabled() {
            print("recv_unresolved kind=")
            match e.left {
                Some(rv) => {
                    lower_print_expr_kind((*rv).kind)
                    // The receiver's NAME when it is an ident, and the enclosing
                    // function's name, because the two together say whether the
                    // gap is the local or the frame it sits in: a body lowered
                    // under a BARE name never gets its `self` typed (the owner is
                    // recovered from `T_method`), so every local copied from self
                    // inside it is untyped too, and every method call on one of
                    // them lands on the bare name in turn.
                    if (*rv).kind == ExprKind::ExprIdent {
                        print(" recv=")
                        print(str_from_bytes((*rv).name.buf, (*rv).name.len))
                    }
                    // For a FIELD receiver the field's own name and the base's
                    // shape are what say where the chain broke: an empty owner
                    // type, or an owner that resolved but whose field carries no
                    // declared named type.
                    if (*rv).kind == ExprKind::ExprFieldAccess {
                        print(" fld=")
                        print(str_from_bytes((*rv).name.buf, (*rv).name.len))
                        print(" base=")
                        match (*rv).left {
                            Some(bb) => {
                                lower_print_expr_kind((*bb).kind)
                                if (*bb).kind == ExprKind::ExprUnary {
                                    if (*bb).un_op == UnaryOp::OpDeref { print(":deref") }
                                    else if (*bb).un_op == UnaryOp::OpRef { print(":ref") }
                                    else if (*bb).un_op == UnaryOp::OpRefMut { print(":refmut") }
                                    else { print(":otherop") }
                                }
                                if (*bb).kind == ExprKind::ExprIdent {
                                    print(":")
                                    print(str_from_bytes((*bb).name.buf, (*bb).name.len))
                                }
                                // What the resolver ACTUALLY returns for this base,
                                // and then what the field's declared type comes back
                                // as. Three fixes were tried by reasoning about which
                                // of these two steps fails and all three measured
                                // zero; this asks the code instead.
                                let owner_ty = self.expr_receiver_struct_type_ref(&(*bb))
                                print(" owner=")
                                if owner_ty.len > 0 {
                                    print(str_from_bytes(owner_ty.buf, owner_ty.len))
                                } else {
                                    print("<none>")
                                }
                                let fld_ty = self.field_named_type_for_struct(owner_ty, (*rv).name)
                                print(" fldty=")
                                if fld_ty.len > 0 {
                                    print(str_from_bytes(fld_ty.buf, fld_ty.len))
                                } else {
                                    print("<none>")
                                }
                            }
                            _ => {
                                print("none")
                            }
                        }
                    }
                }
                _ => {
                    print("none")
                }
            }
            print(" method=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" in=")
            print(str_from_bytes((*self.current_func).name.buf, (*self.current_func).name.len))
            print("\n")
        }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        var lo1 = pair_b.0
        var base_reg = pair_b.1
        // Root 2: &self methods need a pointer. Free-form e_get(&x) works because
        // the caller passes OpRef; method syntax x.get() previously passed the
        // loaded struct value and SEGV'd. Auto-ref when first_param_is_ref and
        // the receiver is not already a reference binding / &expr.
        let pair_fn0 = lo1.find_or_add_fn_id(call_name)
        lo1 = pair_fn0.0
        let fn_id0 = pair_fn0.1
        var needs_ref = false
        if fn_id0 >= 0 && fn_id0 < (*lo1.module).fn_count {
            needs_ref = ir_fn_get(&(*lo1.module), fn_id0 as usize).first_param_is_ref == 1
        }
        if needs_ref {
            var already_ref = false
            match e.left {
                Some(recv) => {
                    if (*recv).kind == ExprKind::ExprIdent {
                        already_ref = lo1.lookup_local_is_ref((*recv).name)
                    } else if (*recv).kind == ExprKind::ExprUnary {
                        if (*recv).un_op == UnaryOp::OpRef || (*recv).un_op == UnaryOp::OpRefMut {
                            already_ref = true
                        }
                    }
                }
                None => {}
            }
            if !already_ref {
                let pair_aref = lo1.fresh_reg()
                lo1 = pair_aref.0
                let areg = pair_aref.1
                lo1 = lo1.emit(ir_unaryop(areg, UnaryOp::OpRef, base_reg))
                base_reg = areg
            }
        }
        let pair_args: LowerExprArgsResult = lo1.lower_expr_args_ref(&e.args)
        let lo2 = pair_args.lowerer
        let arg_list: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let arg_count = pair_args.count
        let args2 = lo2.prepend_arg(base_reg, arg_list)
        let pair_fn = lo2.find_or_add_fn_id(call_name)
        let lo3 = pair_fn.0
        let fn_id = pair_fn.1
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args2, arg_count + 1)
        var lo4 = pair_call.lo
        // Same rule as the binary-operand site: a call consumes its arguments'
        // pending variance and must not let it escape into an enclosing let.
        lo4.pending_variance_reg = -1
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        let pair_d = lo4.fresh_reg()
        let lo5 = pair_d.0
        let dst = pair_d.1
        var call_instr_m = ir_call(dst, fn_id, call_name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo5.module).fn_count {
            if ir_fn_get(&(*lo5.module), fn_id as usize).returns_float == 1 {
                call_instr_m.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo6 = lo5.emit(call_instr_m)
        if call_instr_m.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo6 = lo6.emit(ir_mark_float_reg(dst))
        }
        (lo6, dst)
    }

    fn lower_if_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Type the merge register as a true JOIN of the two arms. Native codegen
        // is flow-insensitive (the if-merge res inherits whichever ir_copy is last
        // in linear order — the else arm), so an f64 if-expr whose else arm is an
        // int-flagged value (e.g. an f64 literal via IrLoadImm) would otherwise
        // leave res untyped and a downstream float consumer cvtsi2sd-corrupts it.
        let res_is_float = self.expr_result_is_float_ref(e)
        let pair_cond = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_cond.0
        let cond = pair_cond.1

        let pair_l_else = lo1.fresh_label()
        let lo2 = pair_l_else.0
        let l_else = pair_l_else.1
        let pair_l_end = lo2.fresh_label()
        let lo3 = pair_l_end.0
        let l_end = pair_l_end.1
        let pair_res = lo3.fresh_reg()
        let lo4 = pair_res.0
        let res = pair_res.1

        var lo = lo4.emit(ir_branch_false(cond, l_else))

        let then_block_opt: Option<Box<Block>> = e.block
        let pair_then = match then_block_opt {
            Some(blk) => lo.lower_block_ref(&(*blk)),
            None => lo.emit_unit(),
        }
        lo = pair_then.0
        let then_reg = pair_then.1
        lo = lo.emit(ir_copy(res, then_reg))
        lo = lo.emit(ir_jump(l_end))
        lo = lo.emit(ir_label(l_else))

        let else_expr_opt: Option<Box<Expr>> = e.else_expr
        let pair_else = match else_expr_opt {
            Some(ee) => lo.lower_expr_ref(&(*ee)),
            None => lo.emit_unit(),
        }
        lo = pair_else.0
        let else_reg = pair_else.1
        lo = lo.emit(ir_copy(res, else_reg))
        lo = lo.emit(ir_label(l_end))
        if res_is_float {
            lo = lo.emit(ir_mark_float_reg(res))
        }
        (lo, res)
    }

    fn lower_match_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_scrut = self.lower_opt_expr_ref(&e.left)
        var lo = pair_scrut.0
        let scrut = pair_scrut.1
        let pair_res = lo.fresh_reg()
        lo = pair_res.0
        let res = pair_res.1
        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let l_end = pair_end.1
        lo = lo.lower_match_arms_ref(scrut, res, l_end, &e.arms)
        lo = lo.emit(ir_load_imm(res, 0))
        lo = lo.emit(ir_label(l_end))
        (lo, res)
    }

    fn lower_while_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        let pair_cond = lo.lower_opt_expr_ref(&e.left)
        lo = pair_cond.0
        let cond = pair_cond.1
        lo = lo.emit(ir_branch_false(cond, l_end))
        lo = lo.push_loop_labels(l_top, l_end)
        let while_block_opt: Option<Box<Block>> = e.block
        match while_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_loop_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        lo = lo.push_loop_labels(l_top, l_end)
        let loop_block_opt: Option<Box<Block>> = e.block
        match loop_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_for_in_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Desugar `for i in start..end { body }` into the working while-loop IR:
        //   i = start
        //   l_top:  if !(i < end) goto l_end      // i <= end for inclusive ranges
        //           body
        //   l_cont: i = i + 1                      // continue target + fallthrough
        //           goto l_top
        //   l_end:
        // Only integer range iterables (ExprRange) are supported; any other
        // iterable reports an error rather than silently miscompiling.
        let iter_opt: Option<Box<Expr>> = e.left
        match iter_opt {
            Some(iter_box) => {
                if (*iter_box).kind != ExprKind::ExprRange {
                    // Non-range iterable: only a bare LOCAL array identifier is
                    // supported (e.g. `for v in arr`). Anything else (ref/deref,
                    // non-ident, field access) falls back to a clean report_error
                    // rather than miscompiling or crashing.
                    return self.lower_for_in_array_ref(e, &(*iter_box))
                }
                // Half-open ranges (`for i in 0..`) have no end bound; the loop
                // condition would compare against an invalid register. Reject rather
                // than silently miscompile.
                match (*iter_box).right {
                    None => return (self.report_error_at(14901), IR_INVALID_REG),
                    _ => {}
                }
                let pair_start = self.lower_opt_expr_ref(&(*iter_box).left)
                var lo = pair_start.0
                let start_reg = pair_start.1
                let pair_iv = lo.fresh_reg()
                lo = pair_iv.0
                let iv = pair_iv.1
                lo = lo.emit(ir_copy(iv, start_reg))
                lo = lo.bind_local(e.name, iv, true)
                // Range for-IV is always an integer index. Without kind 1,
                // `for i in 0..n { println(i) }` routes i through print_str → SEGV.
                lo = lo.bind_local_scalar_kind(e.name, 1)

                let pair_end = lo.lower_opt_expr_ref(&(*iter_box).right)
                lo = pair_end.0
                let end_reg = pair_end.1

                let pair_top = lo.fresh_label()
                lo = pair_top.0
                let l_top = pair_top.1
                let pair_cont = lo.fresh_label()
                lo = pair_cont.0
                let l_cont = pair_cont.1
                let pair_end_lbl = lo.fresh_label()
                lo = pair_end_lbl.0
                let l_end = pair_end_lbl.1

                lo = lo.emit(ir_label(l_top))
                let cmp_op = if (*iter_box).bin_op == BinaryOp::OpRangeInclusive { BinaryOp::OpLe } else { BinaryOp::OpLt }
                let pair_cond = lo.fresh_reg()
                lo = pair_cond.0
                let cond = pair_cond.1
                lo = lo.emit(ir_binop(cond, iv, cmp_op, end_reg))
                lo = lo.emit(ir_branch_false(cond, l_end))

                lo = lo.push_loop_labels(l_cont, l_end)
                let for_block_opt: Option<Box<Block>> = e.block
                match for_block_opt {
                    Some(blk) => {
                        let pair_body = lo.lower_block_ref(&(*blk))
                        lo = pair_body.0
                    }
                    None => {}
                }
                lo = lo.pop_loop_labels()

                lo = lo.emit(ir_label(l_cont))
                let pair_one = lo.fresh_reg()
                lo = pair_one.0
                let one_reg = pair_one.1
                lo = lo.emit(ir_load_imm(one_reg, 1))
                let pair_next = lo.fresh_reg()
                lo = pair_next.0
                let next_reg = pair_next.1
                lo = lo.emit(ir_binop(next_reg, iv, BinaryOp::OpAdd, one_reg))
                lo = lo.emit(ir_copy(iv, next_reg))
                lo = lo.emit(ir_jump(l_top))
                lo = lo.emit(ir_label(l_end))
                lo.emit_unit()
            }
            None => (self.report_error_at(14963), IR_INVALID_REG),
        }
    }

    fn lower_for_in_array_ref(self, e: &Expr, iter: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Desugar `for v in arr { body }` over a bare LOCAL array into the working
        // while-loop IR, using a runtime element count read from the object header
        // (IrArrayLen) — NO LowerLocalStack growth, NO per-local length column:
        //   iv = 0
        //   len = array_len(arr)
        //   l_top:  if !(iv < len) goto l_end
        //           v = arr[iv]                       // IndexGet
        //           body
        //   l_cont: iv = iv + 1                       // continue target
        //           goto l_top
        //   l_end:
        // Only a bare local-array identifier is accepted; refs/derefs/non-idents
        // report_error (clean fallback) so we never crash or silently miscompile.
        if (*iter).kind != ExprKind::ExprIdent {
            return (self.report_error_at(14982), IR_INVALID_REG)
        }
        if self.lookup_local_is_ref((*iter).name) {
            return (self.report_error_at(14985), IR_INVALID_REG)
        }
        var lo = self
        let base_reg = lo.lookup_local((*iter).name)
        if base_reg == IR_INVALID_REG {
            return (lo.report_error_at(14990), IR_INVALID_REG)
        }

        // iv = 0
        let pair_iv = lo.fresh_reg()
        lo = pair_iv.0
        let iv = pair_iv.1
        lo = lo.emit(ir_load_imm(iv, 0))

        // len = element count of the array (payload_size_bytes >> 3)
        let pair_len = lo.fresh_reg()
        lo = pair_len.0
        let len_reg = pair_len.1
        lo = lo.emit(ir_array_len(len_reg, base_reg))

        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let l_top = pair_top.1
        let pair_cont = lo.fresh_label()
        lo = pair_cont.0
        let l_cont = pair_cont.1
        let pair_end_lbl = lo.fresh_label()
        lo = pair_end_lbl.0
        let l_end = pair_end_lbl.1

        lo = lo.emit(ir_label(l_top))
        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond = pair_cond.1
        lo = lo.emit(ir_binop(cond, iv, BinaryOp::OpLt, len_reg))
        lo = lo.emit(ir_branch_false(cond, l_end))

        // v = arr[iv]
        let pair_v = lo.fresh_reg()
        lo = pair_v.0
        let v_reg = pair_v.1
        lo = lo.emit(ir_index_get(v_reg, base_reg, iv))
        lo = lo.bind_local(e.name, v_reg, true)
        // Element binding: float-element arrays → kind 2; otherwise treat the
        // element as int so `for v in arr { println(v) }` does not SEGV.
        if lo.lookup_local_array_elem_float((*iter).name) {
            lo = lo.bind_local_scalar_kind(e.name, 2)
        } else {
            lo = lo.bind_local_scalar_kind(e.name, 1)
        }

        lo = lo.push_loop_labels(l_cont, l_end)
        let for_block_opt: Option<Box<Block>> = e.block
        match for_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()

        // iv = iv + 1
        lo = lo.emit(ir_label(l_cont))
        let pair_one = lo.fresh_reg()
        lo = pair_one.0
        let one_reg = pair_one.1
        lo = lo.emit(ir_load_imm(one_reg, 1))
        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, iv, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(iv, next_reg))
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_block_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let block_opt: Option<Box<Block>> = e.block
        match block_opt {
            Some(blk) => self.lower_block_ref(&(*blk)),
            None => self.emit_unit(),
        }
    }

    fn lower_return_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        let lo = pair.0
        let reg = pair.1
        // Inside a kernel lane loop, `return` ends the lane, not the launch.
        // Emitting IrReturn here would abandon every remaining lane — the shape
        // `if (early_out) return` is common enough in kernels that getting this
        // wrong reintroduces the same class of silent wrong answer #1504 is about.
        if LOWER_KERNEL_CONT_LABEL >= 0 {
            let lo_lane = lo.emit(ir_jump(LOWER_KERNEL_CONT_LABEL))
            return (lo_lane, reg)
        }
        let lo2 = lo.emit(ir_return(reg))
        (lo2, reg)
    }

    fn lower_break_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_break_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error_at(15095)
        }
        (lo, reg)
    }

    fn lower_continue_expr_ref(self) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.emit_unit()
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_continue_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error_at(15108)
        }
        (lo, reg)
    }

    fn lower_struct_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: struct_lit_alloc dst=")
            print_int(dst)
            print("\n")
        }
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_struct_fields_ref(&e.fields))))
        lo = lo.ensure_struct_literal_layout_ref(ir_path_first_name(e.path), &e.fields)
        lo = lo.lower_struct_fields_ref(dst, ir_path_first_name(e.path), &e.fields, 0)
        (lo, dst)
    }

    fn lower_tuple_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_expr_list_ref(&e.args))))
        lo = lo.lower_array_elems_ref(dst, &e.args, 0)
        (lo, dst)
    }

    fn lower_range_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_r.0
        let rhs = pair_r.1
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
        (lo4, dst)
    }

    fn lower_contest_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub_pair = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub_pair.0
        let subject_reg = sub_pair.1
        let model_count = count_expr_list_ref(&e.args)
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        if lower_live_diag_enabled() {
            print("CONTEST_IR_LOOKUP_CALL qualified=")
            if (*lo2.epistemic_contests).qualified { print("1") } else { print("0") }
            print(" contest_count=")
            print_int((*lo2.epistemic_contests).contest_count)
            print(" span_start=")
            print_int(e.span.start)
            print(" span_end=")
            print_int(e.span.end)
            print("\n")
        }
        let contest_id = lowerer_find_contest_id_for_span_index_ref(&lo2, e.span)
        if lower_live_diag_enabled() {
            print("CONTEST_IR_LOOKUP_CALL_RESULT contest_id=")
            print_int(contest_id)
            print("\n")
        }
        let lo3 = lo2.emit(ir_contest(dst_reg, subject_reg, model_count, contest_id))
        if lower_live_diag_enabled() {
            print("CONTEST_IR_EMIT opcode=IrContest contest_id=")
            print_int(contest_id)
            print(" dst_reg=")
            print_int(dst_reg)
            print("\n")
        }
        (lo3, dst_reg)
    }

    // Keep binary recursion out of the monolithic expression dispatcher frame.
    // lower_expr_non_binary_ref carries enough branch-local storage to reserve
    // multiple MiB; retaining it for every node in a left-associated binary
    // spine exhausted the launcher's 256 MiB stack before lowering began.
    // The generic call dispatcher carries every call form's branch-local
    // storage, which is larger than an 8 MiB stack. Keep the canonical hello
    // shape on a narrow path while emitting the same string and call IR.
    fn lower_print_string_literal_ref(self, literal: Name) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let print_name = make_name("print")
        var lo = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo, print_name)
        let value_pair = lo.emit_name_string(ir_normalize_string_literal_name(literal))
        let lo_value = value_pair.0
        let value_reg = value_pair.1
        let dst_pair = lo_value.fresh_reg()
        let lo_dst = dst_pair.0
        let dst_reg = dst_pair.1
        let args = Some(Box::new(ir_reg_list_single(value_reg)))
        (lo_dst.emit(ir_call(dst_reg, fn_id, print_name, args, 1)), dst_reg)
    }

    fn lower_println_string_literal_ref(self, literal: Name) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let print_pair = self.lower_print_string_literal_ref(literal)
        var lo = print_pair.0
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo, make_name("print_char"))
        let newline_pair = lo.emit_i64_const(10)
        let newline_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(newline_pair.1)))
        let dst_pair = newline_pair.0.fresh_reg()
        let lo_dst = dst_pair.0
        let dst_reg = dst_pair.1
        (lo_dst.emit(ir_call(dst_reg, fn_id, make_name("print_char"), newline_args, 1)), print_pair.1)
    }

    fn lower_scalar_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if e.kind == ExprKind::ExprIntLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            return (lo.emit(ir_load_imm(reg, e.int_val)), reg)
        }
        if e.kind == ExprKind::ExprFloatLit {
            return self.emit_f64_const(e.float_val)
        }
        if e.kind == ExprKind::ExprBoolTrue || e.kind == ExprKind::ExprBoolFalse {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            return (lo.emit(ir_load_bool(reg, e.kind == ExprKind::ExprBoolTrue)), reg)
        }
        if e.kind == ExprKind::ExprStringLit {
            let lit_name = ir_normalize_string_literal_name(e.name)
            let pair_idx = self.intern_string(lit_name)
            let lo1 = pair_idx.0
            let idx = pair_idx.1
            let pair_reg = lo1.fresh_reg()
            let lo2 = pair_reg.0
            let reg = pair_reg.1
            return (lo2.emit(ir_load_string(reg, idx, lit_name)), reg)
        }
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        (lo.emit(ir_load_imm(reg, e.int_val)), reg)
    }

    fn lower_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if e.kind == ExprKind::ExprIntLit
            || e.kind == ExprKind::ExprFloatLit
            || e.kind == ExprKind::ExprBoolTrue
            || e.kind == ExprKind::ExprBoolFalse
            || e.kind == ExprKind::ExprStringLit
            || e.kind == ExprKind::ExprCharLit
        {
            return self.lower_scalar_literal_expr_ref(e)
        }
        if e.kind == ExprKind::ExprBinary {
            return self.lower_binary_expr_ref(e)
        }
        if e.kind == ExprKind::ExprIf {
            return self.lower_if_expr_ref(e)
        }
        if e.kind == ExprKind::ExprCall {
            match e.left {
                Some(callee) => {
                    if (*callee).kind == ExprKind::ExprIdent && ir_name_eq((*callee).name, make_name("print")) {
                        match e.args {
                            Some(args) => {
                                if (*args).head.kind == ExprKind::ExprStringLit {
                                    match (*args).tail {
                                        None => { return self.lower_print_string_literal_ref((*args).head.name) }
                                        _ => {}
                                    }
                                }
                            }
                            None => {}
                        }
                    }
                }
                None => {}
            }
            return self.lower_call_expr_ref(e)
        }
        self.lower_expr_non_binary_ref(e)
    }

    fn lower_expr_non_binary_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if self.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: expr_kind=")
            if e.kind == ExprKind::ExprIntLit { print("int") }
            else if e.kind == ExprKind::ExprFloatLit { print("float") }
            else if e.kind == ExprKind::ExprBoolTrue { print("bool_true") }
            else if e.kind == ExprKind::ExprBoolFalse { print("bool_false") }
            else if e.kind == ExprKind::ExprStringLit { print("string") }
            else if e.kind == ExprKind::ExprCharLit { print("char") }
            else if e.kind == ExprKind::ExprIdent { print("ident") }
            else if e.kind == ExprKind::ExprCall { print("call") }
            else if e.kind == ExprKind::ExprBinary { print("binary") }
            else if e.kind == ExprKind::ExprUnary { print("unary") }
            else if e.kind == ExprKind::ExprFieldAccess { print("field") }
            else if e.kind == ExprKind::ExprIndex { print("index") }
            else if e.kind == ExprKind::ExprIf { print("if") }
            else if e.kind == ExprKind::ExprWhile { print("while") }
            else if e.kind == ExprKind::ExprReturn { print("return") }
            else if e.kind == ExprKind::ExprBreak { print("break") }
            else if e.kind == ExprKind::ExprContinue { print("continue") }
            else if e.kind == ExprKind::ExprStructLit { print("struct_lit") }
            else if e.kind == ExprKind::ExprArrayLit { print("array_lit") }
            else if e.kind == ExprKind::ExprTupleLit { print("tuple_lit") }
            else if e.kind == ExprKind::ExprBlock { print("block") }
            else if e.kind == ExprKind::ExprLoop { print("loop") }
            else if e.kind == ExprKind::ExprForIn { print("for_in") }
            else { print("other") }
            print("\n")
        }
        if e.kind == ExprKind::ExprIntLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprFloatLit {
            self.emit_f64_const(e.float_val)
        } else if e.kind == ExprKind::ExprBoolTrue {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, true))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBoolFalse {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, false))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprStringLit {
            let lit_name = ir_normalize_string_literal_name(e.name)
            let pair_idx = self.intern_string(lit_name)
            let lo1 = pair_idx.0
            let idx = pair_idx.1
            let pair_reg = lo1.fresh_reg()
            let lo2 = pair_reg.0
            let reg = pair_reg.1
            let lo3 = lo2.emit(ir_load_string(reg, idx, lit_name))
            (lo3, reg)
        } else if e.kind == ExprKind::ExprCharLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprIdent {
            // Check for None (null pointer for Option)
            if ir_name_is_none(e.name) {
                let pair = self.fresh_reg()
                let lo = pair.0
                let reg = pair.1
                let lo2 = lo.emit(ir_load_imm(reg, 0))
                return (lo2, reg)
            }
            let src = self.lookup_local(e.name)
            if src >= 0 {
                // Closures step 2: a capturing closure used as a VALUE (passed to a fn,
                // returned, aliased) would lose its captures — the synthetic fn has leading
                // capture params the receiver can't fill — yielding a silent wrong result.
                // Reject loudly instead. (Direct calls are handled in lower_call_expr_ref
                // before reaching here, so this only fires for non-callee uses.)
                if self.lookup_local_closure_fn_id(e.name) >= 0 {
                    print("error: capturing closure cannot be used as a value (escaping closures are not yet supported); only a direct call of the closure is allowed\n")
                    let loe = self.report_fatal_lowering_error()
                    return (loe, 0)
                }
                // Scalar BSS bindings are loaded in each function only to retain
                // global metadata for stores. A callee can update the backing
                // slot, so reads must reload it instead of using that stale
                // per-function snapshot. Aggregate bindings remain base pointers.
                // Scalar reload only for true scalars. Aggregates keep base pointers:
                // - multi-word BSS (gsize > 8)
                // - packed [i8;N]/[u8;N]/bool/char (hyper 1/17) even when size ≤ 8 (#1353)
                // - any fixed array incl. [T; 1] via type-table LOWER_GLOBAL_ARRAY (#1350)
                if self.lookup_local_is_global(e.name) {
                    let gsize = self.lookup_local_global_bss_size(e.name)
                    var hyper_kind: i64 = 8
                    var local_g_kind: i64 = 0
                    let gfn = lowerer_lookup_fn_id_by_name_ref(&self, e.name)
                    if gfn >= 0 && gfn < self.module.fn_count {
                        hyper_kind = ir_fn_get(&(*self.module), gfn as usize).hyper_algebra_kind
                        local_g_kind = lower_global_type_table_lookup(&(*self.global_types), gfn)
                    }
                    if !lower_bss_slot_is_aggregate(gsize, hyper_kind) && !lower_global_kind_is_array_base(local_g_kind) {
                        let bss_off = self.lookup_local_global_bss_offset(e.name)
                        let pair = self.fresh_reg()
                        let lo = pair.0
                        let reg = pair.1
                        let lo2 = lo.emit(ir_load_global(reg, bss_off, e.name))
                        if self.lookup_local_scalar_kind(e.name) == 2 || self.bss_global_scalar_kind(e.name) == 2 {
                            return (lo2.emit(ir_mark_float_reg(reg)), reg)
                        }
                        return (lo2, reg)
                    }
                }
                (self, src)
            } else {
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, e.name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    let fn_strategy = ir_fn_get(&(*self.module), fn_id as usize).compile_strategy
                    if fn_strategy == IR_STRATEGY_BSS_GLOBAL {
                        let bss_off = ir_fn_get(&(*self.module), fn_id as usize).param_count
                        let gsize = ir_fn_get(&(*self.module), fn_id as usize).bss_size
                        let hyper_kind = ir_fn_get(&(*self.module), fn_id as usize).hyper_algebra_kind
                        let global_elem_kind = lower_global_type_table_lookup(&(*self.global_types), fn_id)
                        let ref_pair = self.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        var lo3 = lo2
                        // Aggregate → absolute BSS base pointer. Scalar → load value.
                        // Multi-word, packed byte arrays (#1353), and any array kind
                        // including `[T; 1]` (#1350) must not take the scalar load path.
                        if lower_bss_slot_is_aggregate(gsize, hyper_kind) || lower_global_kind_is_array_base(global_elem_kind) {
                            lo3 = lo2.emit(ir_load_imm(ref_reg, BSS_BASE_LINUX + bss_off))
                        } else {
                            lo3 = lo2.emit(ir_load_global(ref_reg, bss_off, e.name))
                        }
                        // BSS metadata is applied only when the global is used;
                        // eagerly loading every global can exhaust main's IR budget.
                        if global_elem_kind == LOWER_GLOBAL_SCALAR_F64 {
                            lo3 = lo3.emit(ir_mark_float_reg(ref_reg))
                        } else if global_elem_kind == LOWER_GLOBAL_ELEM_F64 {
                            lo3 = lo3.bind_reg_array_elem_float(ref_reg)
                        }
                        (lo3, ref_reg)
                    } else {
                        let ref_pair = self.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                        (lo3, ref_reg)
                    }
                } else {
                    if self.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: ident_miss name=")
                        print(str_from_bytes(e.name.buf, e.name.len))
                        print(" scope=")
                        print_int(self.scope_depth)
                        print(" local_count=")
                        print_int(self.locals.count)
                        print("\n")
                    }
                    let loe = self.report_error_at(15349)
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprPath {
            // Check if this is an enum variant reference (e.g., IrOpcode::IrLoadImm)
            if e.path.seg_count >= 2 {
                let variant_name = ir_path_last_name(e.path)
                // Check for None (Option::None)
                if ir_name_is_none(variant_name) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
                let disc = self.lookup_variant_discriminant_by_path(ir_path_qualifier_name(e.path), variant_name)
                if disc >= 0 {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, disc))
                    return (lo2, reg)
                }
            }
            // Check for single-segment None
            if e.path.seg_count == 1 {
                let n = ir_path_first_name(e.path)
                if ir_name_is_none(n) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
            }
            // Not an enum variant — try local variable lookup
            let n = ir_path_first_name(e.path)
            let src = self.lookup_local(n)
            if src >= 0 {
                (self, src)
            } else {
                // Sprint 228: Check if this is a function name used as a first-class value
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, n)
                if fn_id >= 0 {
                    let ref_pair = self.fresh_reg()
                    let lo2 = ref_pair.0
                    let ref_reg = ref_pair.1
                    let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                    (lo3, ref_reg)
                } else {
                    // Record the LAST segment, not the first. For `IrOpcode::Add`
                    // the fall-through above computes ir_path_first_name, which is
                    // the ENUM TYPE -- so the first version of this ledger reported
                    // `IrOpcode` `BinaryOp` `TypeExprKind` and looked like four
                    // missing types when what actually failed was
                    // lookup_variant_discriminant on the VARIANT.
                    if e.path.seg_count >= 2 {
                        lower_note_unresolved(ir_path_last_name(e.path))
                    } else {
                        lower_note_unresolved(n)
                    }
                    let loe = self.report_error_at(15400)
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprCall {
            self.lower_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprBinary {
            self.lower_binary_expr_ref(e)
        } else if e.kind == ExprKind::ExprUnary {
            self.lower_unary_expr_ref(e)
        } else if e.kind == ExprKind::ExprFieldAccess {
            self.lower_field_access_expr_ref(e)
        } else if e.kind == ExprKind::ExprIndex {
            self.lower_index_expr_ref(e)
        } else if e.kind == ExprKind::ExprMethodCall {
            self.lower_method_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprIf {
            self.lower_if_expr_ref(e)
        } else if e.kind == ExprKind::ExprMatch {
            self.lower_match_expr_ref(e)
        } else if e.kind == ExprKind::ExprWhile {
            self.lower_while_expr_ref(e)
        } else if e.kind == ExprKind::ExprLoop {
            self.lower_loop_expr_ref(e)
        } else if e.kind == ExprKind::ExprForIn {
            self.lower_for_in_expr_ref(e)
        } else if e.kind == ExprKind::ExprBlock {
            self.lower_block_expr_ref(e)
        } else if e.kind == ExprKind::ExprReturn {
            self.lower_return_expr_ref(e)
        } else if e.kind == ExprKind::ExprBreak {
            self.lower_break_expr_ref(e)
        } else if e.kind == ExprKind::ExprContinue {
            self.lower_continue_expr_ref()
        } else if e.kind == ExprKind::ExprStructLit {
            self.lower_struct_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprArrayLit {
            self.lower_array_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprTupleLit {
            self.lower_tuple_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprRange {
            self.lower_range_expr_ref(e)
        } else if e.kind == ExprKind::ExprCast {
            self.lower_cast_expr_ref(e)
        } else if e.kind == ExprKind::ExprContest {
            self.lower_contest_expr_ref(e)
        } else if e.kind == ExprKind::ExprAuditAttach {
            // Named audit attachment is compile-time metadata only; runtime lowering is transparent.
            self.lower_opt_expr_ref(&e.left)
        } else if e.kind == ExprKind::ExprClosure {
            // Sprint 228: Lambda-lift closure to a top-level synthetic function.
            // Non-capturing closures become plain functions; captures are TBD (Phase 2).
            self.lower_closure_expr_ref(e)
        } else {
            let loe = self.report_error_at(15454)
            loe.emit_unit()
        }
    }

    // Sprint 228: Generate a unique closure function name: __closure_<N>
    fn make_closure_name(self) -> Name with Mut, Panic, Div {
        var n = ir_empty_name()
        // "__closure_"
        n.buf[0] = 95    // '_'
        n.buf[1] = 95    // '_'
        n.buf[2] = 99    // 'c'
        n.buf[3] = 108   // 'l'
        n.buf[4] = 111   // 'o'
        n.buf[5] = 115   // 's'
        n.buf[6] = 117   // 'u'
        n.buf[7] = 114   // 'r'
        n.buf[8] = 101   // 'e'
        n.buf[9] = 95    // '_'
        n.len = 10
        // Append fn_count as suffix for uniqueness.
        //
        // `self.module.fn_count` -- field access on the Box WITHOUT a deref -- read
        // garbage, and the same garbage every time, so every closure in a module
        // was named `__closure_L960`. find_or_add_fn_id then handed the second
        // closure the FIRST one's fn_id and its body overwrote it, which is why
        // every closure fn-ref in a program resolved to the last closure lowered:
        //
        //     ap_a(|x| x * 2, 5)  and  ap_b(|x| 99, 7)   ->  99 and 99
        //
        // Named functions were unaffected, which is what made this look like a
        // closure-passing defect rather than a naming one. The rest of the file
        // spells it `(*self.module).fn_count` (e.g. lower_function_is_transparent_hof).
        let suffix = (*self.module).fn_count
        if suffix < 10 {
            n.buf[10] = (48 + suffix) as i8
            n.len = 11
        } else if suffix < 100 {
            n.buf[10] = (48 + suffix / 10) as i8
            n.buf[11] = (48 + suffix % 10) as i8
            n.len = 12
        } else if suffix < 1000 {
            n.buf[10] = (48 + suffix / 100) as i8
            n.buf[11] = (48 + (suffix / 10) % 10) as i8
            n.buf[12] = (48 + suffix % 10) as i8
            n.len = 13
        } else {
            n.buf[10] = (48 + suffix / 1000) as i8
            n.buf[11] = (48 + (suffix / 100) % 10) as i8
            n.buf[12] = (48 + (suffix / 10) % 10) as i8
            n.buf[13] = (48 + suffix % 10) as i8
            n.len = 14
        }
        n
    }

    // Sprint 228: Lambda-lift a closure expression into a synthetic top-level function.
    // Returns (Lowerer, fn_ref_reg) where fn_ref_reg holds the fn_id.
    // Recursive free-variable scan (closures step 2): collect idents in `body` that resolve
    // as enclosing locals and are not closure params (= captures). Self-recursive; uses
    // self.lookup_local for the enclosing scope (no &LowerLocalStack arg).
    fn scan_captures_expr(self, body: &Expr, params: &Option<Box<ClosureParamList>>, caps: CaptureList) -> CaptureList with Mut, Panic, Div, Alloc {
        var c = caps
        if (*body).kind == ExprKind::ExprIdent {
            let nm = (*body).name
            if !lower_name_in_closure_params(params, nm) {
                let r = self.lookup_local(nm)
                if r >= 0 { c = capture_list_add(c, nm, r) }
            }
            return c
        }
        match (*body).left {
            Some(l) => { c = self.scan_captures_expr(&(*l), params, c) }
            _ => {}
        }
        match (*body).right {
            Some(r) => { c = self.scan_captures_expr(&(*r), params, c) }
            _ => {}
        }
        match (*body).else_expr {
            Some(eo) => { c = self.scan_captures_expr(&(*eo), params, c) }
            _ => {}
        }
        var cur = &(*body).args
        while true {
            match *cur {
                Some(el) => {
                    c = self.scan_captures_expr(&(*el).head, params, c)
                    cur = &(*el).tail
                }
                _ => break
            }
        }
        // A closure body IS a block, so skipping `.block` meant the scanner never
        // saw the body at all: `let a = 3; let f = |x: i64| -> i64 { a }; f(99)`
        // recorded ZERO captures, the synthetic fn got no capture param, and the
        // free `a` read 0. Measured 0 against a truth of 3, silently -- the tests
        // that caught it (closure_arity_2 #1542, closure_returned,
        // type_hash_3level_nesting) fail an assert and exit 1 printing nothing.
        //
        // if/while/loop bodies and match arms are the same omission, reached by
        // any closure whose body branches.
        match (*body).block {
            Some(b) => { c = self.scan_captures_block(&(*b), params, c) }
            _ => {}
        }
        match (*body).handler_block {
            Some(hb) => { c = self.scan_captures_block(&(*hb), params, c) }
            _ => {}
        }
        var arm_cur = &(*body).arms
        while true {
            match *arm_cur {
                Some(al) => {
                    c = self.scan_captures_expr(&(*al).head.body, params, c)
                    match (*al).head.guard {
                        Some(g) => { c = self.scan_captures_expr(&(*g), params, c) }
                        _ => {}
                    }
                    arm_cur = &(*al).tail
                }
                _ => break
            }
        }
        c
    }

    // Statement walker for the above. A nested closure's body is deliberately NOT
    // scanned: its own parameters would be misread as captures of the outer one,
    // and getting that right needs the inner param list threaded through. Nested
    // capturing closures therefore remain unsupported rather than silently wrong.
    fn scan_captures_block(self, block: &Block, params: &Option<Box<ClosureParamList>>, caps: CaptureList) -> CaptureList with Mut, Panic, Div, Alloc {
        var c = caps
        var cur = &(*block).stmts
        while true {
            match *cur {
                Some(node) => {
                    let stmt = &(*node).head
                    match (*stmt).expr {
                        Some(ex) => { c = self.scan_captures_expr(&(*ex), params, c) }
                        _ => {}
                    }
                    match (*stmt).target {
                        Some(tg) => { c = self.scan_captures_expr(&(*tg), params, c) }
                        _ => {}
                    }
                    cur = &(*node).tail
                }
                _ => break
            }
        }
        c
    }

    fn scan_captures_opt(self, body: &Option<Box<Expr>>, params: &Option<Box<ClosureParamList>>, caps: CaptureList) -> CaptureList with Mut, Panic, Div, Alloc {
        match *body {
            Some(b) => { self.scan_captures_expr(&(*b), params, caps) }
            _ => { caps }
        }
    }

    // Index of the closure-capture entry for `fn_id` (-1 if none). Method form avoids
    // passing &(*self.closure_caps) (ref of a deref of a field-accessed Box), which the
    // parser rejects.
    fn find_closure_cap_idx(self, fn_id: i64) -> i64 with Mut, Panic, Div, Alloc {
        var i: i64 = 0
        while i < (*self.closure_caps).count {
            if (*self.closure_caps).entries[i as usize].fn_id == fn_id { return i }
            i = i + 1
        }
        -1
    }

    // Record a capturing closure's captured enclosing regs, keyed by its synthetic fn_id.
    // Copy-modify-writeback on the whole table (like bind_local_struct_type) — no
    // &!ClosureCapTable free-function param.
    fn record_closure_caps(self, fn_id: i64, caps: CaptureList) -> Lowerer with Mut, Panic, Div, Alloc {
        var lo = self
        var tbl = *lo.closure_caps
        if tbl.count < 256 {
            let idx = tbl.count
            var e = ClosureCapEntry { fn_id: fn_id, def_fn: lo.current_fn, cap_count: caps.count, caps: [IR_INVALID_REG; 8] }
            var i: i64 = 0
            while i < caps.count {
                e.caps[i as usize] = caps.regs[i as usize]
                i = i + 1
            }
            tbl.entries[idx as usize] = e
            tbl.count = idx + 1
            lo.closure_caps = Box::new(tbl)
        }
        lo
    }

    fn lower_closure_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // 1. Create a unique name and register the synthetic function. Use the *mut
        // find_or_add (like regular calls): the functional find_or_add_fn_id ADD path
        // builds + returns a 128 KB IrFunction by value, which the by-value-aggregate
        // miscompile turned into a lowering SIGSEGV.
        let closure_name = lo.make_closure_name()
        let closure_fn_id = lowerer_find_or_add_fn_id_mut(&! lo, closure_name)

        if closure_fn_id < 0 {
            return lo.emit_unit()
        }

        // 2. Save current function context
        let saved_fn = lo.current_fn
        let saved_func = lo.current_func
        let saved_locals = lo.locals
        let saved_scope = lo.scope_depth
        let saved_loop = lo.loop_depth
        let saved_loaded = lo.current_func_loaded
        let saved_allow_direct_capture = lo.allow_direct_capturing_closure_literal

        // 2b. Scan the closure body for captured free variables (idents bound in the
        // enclosing scope, not lambda params) BEFORE wiping locals. Captures become LEADING
        // params on the synthetic fn and are injected at the (direct) call site.
        // Only look for captures when the CONSUMER will inject them. A capturing
        // closure has no environment: its captures become leading params of the
        // synthetic fn and are prepended by the caller, which only happens where
        // allow_direct_capturing_closure_literal is set (`let f = <literal>` and
        // the HOF path).
        //
        // Elsewhere the closure escapes as a bare fn-ref. Detecting captures there
        // would make the synthetic fn expect parameters nobody passes -- measured
        // rc=139 on `fn mk(a) -> fn(i64)->i64 { |x| x * a }`, where main today
        // returns a wrong 0 instead. A crash is worse than the wrong answer that
        // is already recorded, so the unsupported case keeps its existing shape
        // rather than acquiring a new failure mode. Escaping captures need a real
        // environment -- the "captures are TBD (Phase 2)" case (#1542).
        var captures = empty_capture_list()
        if saved_allow_direct_capture {
            captures = lo.scan_captures_opt(&e.closure_body, &e.closure_params, captures)
        }
        if captures.count > 0 {
            if !lo.allow_direct_capturing_closure_literal {
                print("error: native-v2 capturing closure literals are not yet supported as values; bind and call directly, use a named function, or use a noncapturing closure\n")
                let loe = lo.report_fatal_lowering_error()
                return loe.emit_unit()
            }
        }

        // 3. Switch to the closure function context. current_func_loaded MUST be true so
        // the functional lowering (current_fn_validated_reg / param resolution) reads from
        // lo.current_func — not the empty module placeholder, which is what zeroed
        // param_count and produced a malformed closure body.
        lo.current_fn = closure_fn_id
        lo.current_func = lowerer_box_empty_function()
        // lowerer_box_empty_function() -> ir_empty_function() leaves region invalid
        // by design (see ir_function_alloc_region's own comment: array-repeat
        // initialisers would alias every slot to the same region if it allocated
        // eagerly). Every OTHER real-function lowering entry point allocates here
        // before writing instructions (e.g. the (*reused).region.slot < 0 guard
        // above); the closure path skipped it, so any ir_arena_store into this
        // function's body hit region slot -1 generation -1 -- closures miscompiled
        // to a refused build on any Madaros built after the arena landing.
        if (*lo.current_func).region.slot < 0 { ir_function_alloc_region(&! (*lo.current_func)) }
        (*lo.current_func).name = closure_name
        lo.current_func_loaded = true
        lo.locals = lowerer_box_empty_locals()
        lo.scope_depth = 0
        lo.loop_depth = 0
        // D5 (#986): per-function reset of vreg-keyed float/variance tables.
        lo.array_elem_float_reg_count = 0
        lo.variance_base_reg_count = 0
        lo.pending_variance_reg = -1
        lo.pending_closure_fn_id = -1
        lo.allow_direct_capturing_closure_literal = false

        // 3b. Bind captured variables as LEADING params of the synthetic fn, so the body's
        // free `k` resolves to a param (not 0). The captured enclosing regs themselves are
        // injected at the call site; here we only allocate param regs + bind the names.
        var ci: i64 = 0
        while ci < captures.count {
            let cap_pair = lo.fresh_reg()
            lo = cap_pair.0
            let cap_preg = cap_pair.1
            var cf_box_cap = lo.current_func
            if (*cf_box_cap).param_count < IR_MAX_PARAMS {
                let pcc = (*cf_box_cap).param_count
                (*cf_box_cap).param_regs[pcc as usize] = cap_preg
                (*cf_box_cap).param_count = pcc + 1
            }
            lo.current_func = cf_box_cap
            lo = lo.bind_local(captures.names[ci as usize], cap_preg, false)
            ci = ci + 1
        }

        // 4. Set up closure parameters from ClosureParamList
        var params: &Option<Box<ClosureParamList>> = &e.closure_params
        while true {
            match *params {
                Some(plist) => {
                    let preg_pair = lo.fresh_reg()
                    lo = preg_pair.0
                    let preg = preg_pair.1
                    // Extract the current_func Box to a local before mutating: the direct
                    // `(*lo.current_func).param_count = …` store (deref a field-accessed Box)
                    // is dropped by the by-value-aggregate miscompile — the same reason
                    // fresh_reg copies `lo.current_func` to a local first. Without this,
                    // param_count stayed 0, the codegen emitted no parameter prologue, and
                    // the closure SIGSEGV'd when called.
                    var cf_box = lo.current_func
                    if (*cf_box).param_count < IR_MAX_PARAMS {
                        let pc = (*cf_box).param_count
                        (*cf_box).param_regs[pc as usize] = preg
                        (*cf_box).param_count = pc + 1
                    }
                    lo.current_func = cf_box
                    lo = lo.bind_local((*plist).head.name, preg, false)
                    // f64 closure params were never marked float — named-fn params get
                    // ir_mark_float_reg (see lowerer_lower_fn_params_mut), closures did not,
                    // so `|a:f64|{..}` read its arg from an integer reg and computed garbage
                    // (-0.000000). Mark the param reg float + scalar-kind 2, mirroring the
                    // named-fn path. Required for f64 args through the (now uncapped) indirect
                    // call path — by-value closures and handler-clause closures (CEI).
                    if lower_type_expr_is_f64(&(*plist).head.ty) {
                        lo = lo.emit(ir_mark_float_reg(preg))
                        lo = lo.bind_local_scalar_kind((*plist).head.name, 2)
                    }
                    params = &(*plist).tail
                }
                _ => break
            }
        }

        // 5. Lower the closure body using the standard optional-expression path.
        let body_pair = lo.lower_opt_expr_ref(&e.closure_body)
        lo = body_pair.0
        lo = lo.emit(ir_return(body_pair.1))

        // 7. Flush the completed closure function back to the module. Extract the module
        // Box to a local first (as lowerer_flush_current_func_mut does) — the direct
        // `ir_fn_set(&! (*lo.module), id, …` store derefs a field-accessed Box and is)
        // dropped/partial under the by-value-aggregate miscompile, which lost the body
        // instrs (the closure returned its param instead of the body's result).
        var flush_mod_box = lo.module
        ir_fn_set(&! (*flush_mod_box), closure_fn_id as usize, *lo.current_func)
        lo.module = flush_mod_box

        // 8. Restore the original function context
        lo.current_fn = saved_fn
        lo.current_func = saved_func
        lo.current_func_loaded = saved_loaded
        lo.locals = saved_locals
        lo.scope_depth = saved_scope
        lo.loop_depth = saved_loop
        lo.allow_direct_capturing_closure_literal = saved_allow_direct_capture

        // 8b. For a capturing closure, record the captured ENCLOSING regs keyed by fn_id and
        // flag the pending closure so the let-binding marks its local. (Zero-capture closures
        // stay bare fn-refs — unchanged from #418.) Extract the Box to a local first.
        if captures.count > 0 {
            lo = lo.record_closure_caps(closure_fn_id, captures)
            lo.pending_closure_fn_id = closure_fn_id
        }

        // 9. In the original function, emit IrLoadFnRef to return the fn_id
        let ref_pair = lo.fresh_reg()
        lo = ref_pair.0
        let ref_reg = ref_pair.1
        lo = lo.emit(ir_load_fn_ref(ref_reg, closure_fn_id))
        (lo, ref_reg)
    }

    fn lower_expr(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_ref(&e)
    }
}

// Count struct field initializers in a StructFieldList
fn count_struct_fields_ref(fields: &Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = fields
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_struct_fields(fields: Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    count_struct_fields_ref(&fields)
}

// Count expression list elements (used for array/tuple literals)
fn count_expr_list_ref(elems: &Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = elems
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_expr_list(elems: Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    count_expr_list_ref(&elems)
}

// #1649: materialise an arena-resident argument list. The flat pool is the
// source of truth; this rebuilds the Box chain ONLY where something needs to
// mutate it, so ir_arena_load can stay effect-free for its ~431 callers.
fn ir_reg_list_from_arena(at: i64, n: i64) -> Option<Box<IrRegList>> with Mut, Panic, Div, Alloc {
    var out = ir_empty_reg_list()
    var k = n - 1
    while k >= 0 {
        out = ir_reg_list_prepend(ir_arena_arg_at(at, k), out)
        k = k - 1
    }
    out
}

fn ir_reg_list_prepend(reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
    Some(Box::new(IrRegList { head: reg, tail: args }))
}

fn ir_call_needs_validated_patch(
    fn_count: i64,
    callee_strategies: &[i64; 2048],
    callee_param_counts: &[i64; 2048],
    instr: IrInstr
) -> bool with Mut, Panic, Div {
    if instr.op != IrOpcode::IrCall { return false }
    if instr.fn_id < 0 || instr.fn_id >= fn_count { return false }
    callee_strategies[instr.fn_id as usize] == IR_STRATEGY_INSTRUMENTED &&
    instr.arg_count + 1 == callee_param_counts[instr.fn_id as usize]
}

fn ir_module_has_instrumented_strategy(module: &IrModule) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < module.fn_count {
        if ir_fn_get(module, i as usize).compile_strategy == IR_STRATEGY_INSTRUMENTED {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_has_opcode(func: IrFunction, op: IrOpcode) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode) == op {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_has_opcode_ref(func: &! IrFunction, op: IrOpcode) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode) == op {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_insert_instr_front(func: &! IrFunction, instr: IrInstr) -> bool with Mut, Panic, Div {
    if func.instr_count >= 127 {
        return false
    }
    var i = func.instr_count
    while i > 0 {
        ir_arena_copy_slot(ir_region_slot_w(func.region, (i)),ir_region_slot_r(func.region, ((i - 1))))
        i = i - 1
    }
    ir_arena_store(ir_region_slot_w(func.region, (0)), instr)
    func.instr_count = func.instr_count + 1
    true
}

fn ir_patch_validated_call_instr(instr: &! IrInstr, validated_reg: i64) with Mut, Panic, Div, Alloc {
    let patched_args = ir_reg_list_prepend(validated_reg, instr.call_args)
    let pair_regs = ir_reg_list_first_two(patched_args)
    instr.call_args = patched_args
    instr.arg_count = instr.arg_count + 1
    instr.src1 = pair_regs.0
    instr.src2 = pair_regs.1
}

fn ir_patch_validated_calls_in_function(
    fn_count: i64,
    callee_strategies: &[i64; 2048],
    callee_param_counts: &[i64; 2048],
    func: &! IrFunction,
    stats: &! IrValidatedPatchStats
) with Mut, Panic, Div, Alloc {
    if !ir_function_has_opcode_ref(func, IrOpcode::IrCall) {
        return
    }

    var needs_patch = false
    var patch_count: i64 = 0
    var shared_validated_reg = IR_INVALID_REG

    var scan_i: i64 = 0
    while scan_i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, ir_arena_load(ir_region_slot_r(func.region, (scan_i)))) {
            needs_patch = true
            break
        }
        scan_i = scan_i + 1
    }
    if !needs_patch {
        return
    }

    if func.compile_strategy != IR_STRATEGY_INSTRUMENTED {
        shared_validated_reg = func.reg_count
        func.reg_count = func.reg_count + 1
        if ir_function_insert_instr_front(func, ir_load_imm(shared_validated_reg, 1)) {
            stats.fallback_insertions = stats.fallback_insertions + 1
        } else {
            return
        }
    }

    var i: i64 = 0
    while i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, ir_arena_load(ir_region_slot_r(func.region, (i)))) {
            let validated_reg = if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                func.param_regs[0]
            } else {
                shared_validated_reg
            }
            // #1649: ir_arena_load deliberately does NOT rebuild call_args --
            // that needs Alloc and it is called at ~431 sites, where forcing the
            // effect cascades. Arena-resident arguments live in the flat pool.
            // This site MUTATES the list, so it has to materialise it first, and
            // it already carries Alloc. Without this the prepend below built onto
            // an empty list and the call's original arguments were dropped --
            // which is what failed self-test T10 and T11.
            let rd_slot = ir_region_slot_r(func.region, (i))
            var instr = ir_arena_load(rd_slot)
            instr.call_args = ir_reg_list_from_arena(rd_slot, instr.arg_count)
            ir_patch_validated_call_instr(&! instr, validated_reg)
            ir_arena_store(ir_region_slot_w(func.region, (i)), instr)
            patch_count = patch_count + 1
        }
        i = i + 1
    }
    if patch_count > 0 {
        stats.patched_functions = stats.patched_functions + 1
        stats.patched_calls = stats.patched_calls + patch_count
    }
}

pub(crate) fn ir_patch_validated_calls(module: &! IrModule) -> IrValidatedPatchStats with Mut, Panic, Div, Alloc {
    var stats = ir_empty_validated_patch_stats()
    if !ir_module_has_instrumented_strategy(module) {
        return stats
    }

    var callee_strategies: [i64; 2048] = [IR_STRATEGY_STANDARD; 2048]
    var callee_param_counts: [i64; 2048] = [0; 2048]
    var i: i64 = 0
    while i < module.fn_count {
        callee_strategies[i as usize] = ir_fn_get(module, i as usize).compile_strategy
        callee_param_counts[i as usize] = ir_fn_get(module, i as usize).param_count
        i = i + 1
    }

    i = 0
    while i < module.fn_count {
        var has_call = false
        var instr_i: i64 = 0
        let instr_count = ir_fn_get(module, i as usize).instr_count
        while instr_i < instr_count {
            if (IR_A_OP[(ir_region_slot_r(ir_fn_get(module, i as usize).region, (instr_i))) as usize] as IrOpcode) == IrOpcode::IrCall {
                has_call = true
                instr_i = instr_count
            } else {
                instr_i = instr_i + 1
            }
        }
        if has_call {
            var func = ir_fn_get(module, i as usize)
            ir_patch_validated_calls_in_function(module.fn_count, &callee_strategies, &callee_param_counts, &! func, &! stats)
            if func.region.slot < 0 { ir_function_alloc_region(&! func) }
            ir_fn_set(module, i as usize, func)
        }
        i = i + 1
    }
    stats
}

fn lower_program_to_ir_staged_with_lowerer_box_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("preseed_begin")
    var lo2 = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    lower_monolithic_public_probe_boundary("preseed_done")
    if lower_ok_without_hard(lo2.had_error) {
        lower_monolithic_public_probe_boundary("bodies_begin")
        lo2 = lo2.lower_program_bodies_ref(&prog.items)
        lower_monolithic_public_probe_boundary("bodies_done")
    } else {
        lower_monolithic_public_probe_boundary("bodies_skipped")
    }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        lower_monolithic_public_probe_boundary("patch_begin")
        (*patch_stats) = ir_patch_validated_calls(&! (*lo2.module))
        lower_monolithic_public_probe_boundary("patch_done")
    } else {
        lower_monolithic_public_probe_boundary("patch_skipped")
    }
    lower_monolithic_public_probe_boundary("boxed_result_begin")
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: (*patch_stats),
    }
}

fn lower_program_to_ir_staged_with_lowerer_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let boxed = lower_program_to_ir_staged_with_lowerer_box_trace_ref(lo, prog, patch_stats)
    lower_monolithic_public_probe_boundary("boxed_result_done")
    lower_monolithic_public_probe_boundary("boxed_unwrap_result_begin")
    IrLowerResult {
        module: *boxed.module,
        error_count: boxed.error_count,
        had_error: boxed.had_error,
        patch_stats: boxed.patch_stats,
    }
}

fn lower_program_to_ir_staged_with_lowerer_trace(
    lo: Lowerer,
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_staged_with_lowerer_trace_ref(lo, &prog, patch_stats)
}

fn lower_program_to_ir_trace_ref(
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("lowerer_new_begin")
    let lo = lowerer_new()
    lower_monolithic_public_probe_boundary("lowerer_new_done")
    lower_program_to_ir_staged_with_lowerer_trace_ref(lo, prog, patch_stats)
}

pub fn lower_program_to_ir_trace(
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_trace_ref(&prog, patch_stats)
}

fn lower_program_to_ir_ref(prog: &Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    var patch_stats = ir_empty_validated_patch_stats()
    lower_program_to_ir_trace_ref(prog, &! patch_stats)
}

pub fn lower_program_to_ir(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("public_call_entry")
    lower_program_to_ir_ref(&prog)
}

pub fn lower_program_to_ir_summary_box_with_epistemic_ref(prog: &Program, epistemic: &IrEpistemicSection) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(epistemic)
    lowerer_preseed_program_items_mut(&! lo, &prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    // Memory wall residual: do NOT Box::new(ir_empty_program_summary()) then
    // overwrite fields. ir_empty_program_summary materializes a full empty
    // IrModule (~[IrFunction;2048]) that is immediately discarded — a second
    // empty module per dep on top of lowerer_new. Box the live summary Boxes
    // directly (probe path already does this).
    let inner = ir_program_summary_from_lowerer(lo)
    IrProgramSummaryBoxResult {
        summary: Box::new(inner),
        error_count: error_count,
        had_error: had_error,
    }
}

// Multi-module variant: preseeds external struct layouts before lowering own
// items, so cross-module `use lib::{PublicStruct}` then `s.x` resolves to the
// right field_idx. Wave13 also preseeds external BSS globals into the *seed*
// (self_index == 0) after own items, so bare `use m::{CONST}` Idents load
// real BSS slots instead of reading 0.
pub fn lower_program_to_ir_summary_box_with_externs_ref(
    prog: &Program,
    programs: &! [Program; 256],
    program_count: i64,
    self_index: i64,
    epistemic: &IrEpistemicSection
) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(epistemic)
    // DCE reconstructs Item values to remove unreachable functions. Preserve
    // non-function metadata from the original AST before that aggregate copy.
    // Global cross-module DCE and local specialized-collapse DCE use separate
    // mark tables, but both rebuild the item list before this summary path.
    // Skip the extra walk only when neither mode is active.
    if spec_dce_global_marks_ready() || spec_mono_marker_count() > 0 {
        lowerer_preseed_program_metadata_owned_mut(&! lo, (*prog).items)
    }
    var i: i64 = 0
    while i < program_count {
        if i != self_index {
            let ext_prog = (*programs)[i as usize]
            // Structs + free-fn signatures only — no BSS allocation here.
            // FILTERED: module_frontend filters at its own two read sites, but
            // this builder reads `programs` directly and bypassed them, so the
            // preseed still saw every declared function and filled the fn-id
            // table at lower.sio:1927. Returns the input unchanged unless a
            // complete mark set is ready.
            let ext_items = spec_dce_filter_with_global_marks(ext_prog.items)
            lowerer_preseed_external_struct_items_mut(&! lo, &ext_items)
            lower_note_stage(1, i, lo.had_error)
        }
        i = i + 1
    }
    // Own items first so seed BSS layout is: [own globals | dep1 | dep2 | ...],
    // matching multi-mod merge order (seed, then deps 1..n).
    let own_items = spec_dce_filter_with_global_marks((*prog).items)
    lowerer_preseed_program_items_mut(&! lo, &own_items, ir_empty_name())
    lower_note_stage(2, self_index, lo.had_error)
    // Wave13 bare cross-mod f64 Ident: only the seed module needs external BSS
    // slots at body-lower time (deps resolve their own globals locally). Walk
    // deps in merge order so offsets match ir_merge place+remap.
    if self_index == 0 {
        var di: i64 = 1
        while di < program_count {
            let dep_prog = (*programs)[di as usize]
            let dep_items = spec_dce_filter_with_global_marks(dep_prog.items)
            lowerer_preseed_external_bss_globals_mut(&! lo, &dep_items)
            lower_note_stage(3, di, lo.had_error)
            di = di + 1
        }
    }
    let error_count = lo.error_count
    let had_error = lo.had_error
    // Same residual as with_epistemic_ref: skip empty IrProgramSummary densify.
    let inner = ir_program_summary_from_lowerer(lo)
    IrProgramSummaryBoxResult {
        summary: Box::new(inner),
        error_count: error_count,
        had_error: had_error,
    }
}

fn lower_program_to_ir_summary_box_probe_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_probe()
    var module = *lo.module
    module.epistemic = epistemic
    lo.module = Box::new(module)
    lo = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let summary = ir_program_summary_from_lowerer(lo)
    IrProgramSummaryBoxResult {
        summary: Box::new(summary),
        error_count: error_count,
        had_error: had_error,
    }
}

fn lower_program_to_ir_summary_box_into_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    out_summary: &! Box<IrProgramSummary>,
    out_fn_count: &! i64,
    out_error_count: &! i64,
    out_had_error: &! bool
) with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(&epistemic)
    lowerer_preseed_program_items_mut(&! lo, &prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let summary = ir_program_summary_from_lowerer(lo)
    (*out_fn_count) = (*summary.module).fn_count
    (*out_error_count) = error_count
    (*out_had_error) = had_error
    (*out_summary).module = summary.module
    (*out_summary).enum_variants = summary.enum_variants
    (*out_summary).struct_layouts = summary.struct_layouts
    (*out_summary).global_types = summary.global_types
    (*out_summary).probe_mode = summary.probe_mode
}

fn lower_program_to_ir_summary_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    let boxed = lower_program_to_ir_summary_box_with_epistemic_ref(prog, &epistemic)
    IrProgramSummaryResult {
        summary: *boxed.summary,
        error_count: boxed.error_count,
        had_error: boxed.had_error,
    }
}

pub fn lower_program_to_ir_summary_with_epistemic(prog: Program, epistemic: IrEpistemicSection) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_with_epistemic_ref(&prog, epistemic)
}

fn lower_program_to_ir_summary_ref(prog: &Program) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_with_epistemic_ref(prog, ir_empty_epistemic_section())
}

fn lower_program_to_ir_summary(prog: Program) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_ref(&prog)
}

fn lower_program_to_ir_summary_flat_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_with_epistemic(&epistemic)
    var lo2 = lo
    lowerer_preseed_program_items_mut(&! lo2, &prog.items, ir_empty_name())
    IrProgramSummaryFlatResult {
        summary: IrProgramSummaryFlat {
            module: *lo2.module,
            enum_variants: *lo2.enum_variants,
            struct_layouts: *lo2.struct_layouts,
            global_types: *lo2.global_types,
            probe_mode: lo2.probe_mode,
        },
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
    }
}

fn lower_program_to_ir_summary_flat_with_epistemic(prog: Program, epistemic: IrEpistemicSection) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_flat_with_epistemic_ref(&prog, epistemic)
}

fn lower_program_to_ir_summary_flat_ref(prog: &Program) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_flat_with_epistemic_ref(prog, ir_empty_epistemic_section())
}

fn lower_program_to_ir_summary_flat(prog: Program) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_flat_ref(&prog)
}

fn lower_program_to_ir_probe_ref(prog: &Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_probe()
    var lo2 = lo.lower_program_items_ref(&prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        patch_stats = ir_patch_validated_calls(&! (*lo2.module))
    }
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

fn lower_program_to_ir_probe(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_probe_ref(&prog)
}

fn lower_program_to_ir_probe_summary_ref(prog: &Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_probe()
    let lo2 = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

fn lower_program_to_ir_probe_summary_box_ref(prog: &Program) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let summary = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(prog, ir_empty_epistemic_section())
    IrLowerBoxResult {
        module: Box::new(summary.summary.module),
        error_count: summary.error_count,
        had_error: summary.had_error,
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

pub fn lower_program_to_ir_probe_summary(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_probe_summary_ref(&prog)
}

fn lower_program_function_body_from_summary_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummary,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary(summary, &epistemic)
    var lo2 = lo.lower_program_bodies_filtered_ref(&prog.items, fn_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        patch_stats = ir_patch_validated_calls(&! (*lo2.module))
    }

    var func = ir_empty_function()
    var i: i64 = 0
    while i < lo2.module.fn_count {
        if ir_name_eq(ir_fn_get(&(*lo2.module), i as usize).name, fn_name) {
            func = ir_fn_get(&(*lo2.module), i as usize)
            i = lo2.module.fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

pub(crate) fn lower_program_function_body_from_summary_flat_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummaryFlat,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let lowered = lower_program_bodies_from_summary_flat_with_epistemic_ref(prog, summary, epistemic)

    var func = ir_empty_function()
    var i: i64 = 0
    while i < (*lowered.module).fn_count {
        if ir_name_eq(ir_fn_get(&(*lowered.module), i as usize).name, fn_name) {
            func = ir_fn_get(&(*lowered.module), i as usize)
            i = (*lowered.module).fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lowered.error_count,
        had_error: lowered.had_error,
        patch_stats: lowered.patch_stats,
    }
}

fn lower_program_function_body_from_program_with_epistemic_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(prog, epistemic)
    let lo = lowerer_new_from_program_summary_flat(&summary_result.summary, epistemic)
    var lo2 = lo
    lo2 = lo2.lower_program_bodies_filtered_ref(&prog.items, fn_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        patch_stats = ir_patch_validated_calls(&! (*lo2.module))
    }

    var func = ir_empty_function()
    var i: i64 = 0
    while i < lo2.module.fn_count {
        if ir_name_eq(ir_fn_get(&(*lo2.module), i as usize).name, fn_name) {
            func = ir_fn_get(&(*lo2.module), i as usize)
            i = lo2.module.fn_count
        } else {
            i = i + 1
        }
    }

    IrFunctionBodyResult {
        func: func,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

fn lower_program_bodies_from_summary_with_epistemic_boxed_ref(
    prog: &Program,
    summary: &IrProgramSummary,
    epistemic: &IrEpistemicSection
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary(summary, epistemic)
    var lo2 = lo.lower_program_bodies_ref(&prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        var module_box = lo2.module
        patch_stats = ir_patch_validated_calls(&! (*module_box))
        lo2.module = module_box
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

// Prefer this on multi-mod hot paths: consumes the summary and reuses its
// IrModule Box so body lower does not allocate a second empty IrModule.
pub fn lower_program_bodies_from_summary_with_epistemic_boxed_owned(
    prog: &Program,
    summary: IrProgramSummary,
    epistemic: &IrEpistemicSection
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_from_program_summary_owned(summary, epistemic)
    lowerer_lower_program_bodies_mut(&! lo, &prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo.had_error) {
        var module_box = lo.module
        patch_stats = ir_patch_validated_calls(&! (*module_box))
        lo.module = module_box
    }
    IrLowerBoxResult {
        module: lo.module,
        error_count: lo.error_count,
        had_error: lower_had_error_with_hard(lo.had_error),
        patch_stats: patch_stats,
    }
}

// Wave13: lower one dependency's items *into* the multi-mod accumulator.
// Avoids allocating a second full Box<IrModule> per dep (acc+dep dual peak).
// Call targets bind to absolute acc fn_ids by name (no place+remap).
// Skips dep test `main` (seed owns entry). Force-fills ItemImpl method stubs
// left ic=0 by seed extern preseed. Caller owns arena mark/reset + call_args
// re-box for functions written in this pass (including filled stubs).
pub fn lower_dep_program_items_into_acc_with_externs(
    items: &Option<Box<ItemList>>,
    programs: &! [Program; 256],
    program_count: i64,
    self_index: i64,
    acc: Box<IrModule>
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_from_acc_module(acc)
    var i: i64 = 0
    while i < program_count {
        if i != self_index {
            let ext_prog = (*programs)[i as usize]
            // FILTER THE EXTERNALS TOO. The caller already ran the dep's OWN
            // items through spec_dce_filter_with_global_marks (module_frontend.sio,
            // `let dep_items = ...`), but the 119 external programs were preseeded
            // RAW -- every declaration in every loaded module took a slot in the
            // accumulator whether `main` could reach it or not.
            //
            // That is what filled it. Measured 2026-08-06 with a per-site error
            // histogram: `2044x3022`, i.e. 3022 calls to
            // lowerer_find_or_add_fn_id_mut refused because fn_count was already
            // at IR_MAX_FUNCS. With this filter the same compile reports 157
            // errors instead of 3179, and site 2044 disappears entirely.
            //
            // Raising the cap does not fix this, it postpones it. The preflight
            // census counts what the MERGE needs; into_acc accumulates every
            // module, so the number that matters is the union over 120 closures.
            // Filtering is the only move that scales.
            //
            // spec_dce_filter_with_global_marks returns its input UNCHANGED unless
            // a complete mark set is ready, so a refusal upstream cannot silently
            // become a deletion here -- the same contract the other three call
            // sites in this file rely on.
            let ext_items = spec_dce_filter_with_global_marks(ext_prog.items)
            // DEDUP: do not re-zero seed main / previously-filled dep methods.
            lowerer_preseed_external_items_into_acc_mut(&! lo, &ext_items)
        }
        i = i + 1
    }
    lowerer_preseed_dep_items_into_acc_mut(&! lo, items, ir_empty_name())
    // DEDUP body lower: skip main + existing bodies; fill stubs and new names.
    lowerer_lower_program_bodies_dedup_mut(&! lo, items)
    // Residual closeout: re-attempt any ItemImpl methods still at ic=0.
    lowerer_force_fill_impl_methods_mut(&! lo, items)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo.had_error) {
        var module_box = lo.module
        patch_stats = ir_patch_validated_calls(&! (*module_box))
        lo.module = module_box
    }
    if str_eq(read_env("SOUNIO_INTO_ACC_TRACE"), "1") {
        print("into_acc: dep_done self_index=")
        print_int(self_index)
        print(" fn_count=")
        print_int((*lo.module).fn_count)
        print(" had_error=")
        if lower_had_error_with_hard(lo.had_error) { print_int(1) } else { print_int(0) }
        print("\n")
        // List zero-body slots + watchlist ics for residual diagnosis.
        var module_box_tr = lo.module
        var zi: i64 = 0
        while zi < (*module_box_tr).fn_count {
            let zic = ir_fn_get(&(*module_box_tr), zi as usize).instr_count
            let znm = ir_fn_get(&(*module_box_tr), zi as usize).name
            if zic <= 0 && znm.len > 0 {
                print("into_acc: stub fi=")
                print_int(zi)
                print(" name=")
                print(str_from_bytes(znm.buf, znm.len))
                print("\n")
            }
            // Watch helpers that must be non-empty for order_spread / dual.
            if ir_name_eq(znm, make_name("os_oct_mul"))
                || ir_name_eq(znm, make_name("os_oct_from_arr"))
                || ir_name_eq(znm, make_name("os_pentagon_variance"))
                || ir_name_eq(znm, make_name("order_spread4"))
                || ir_name_eq(znm, make_name("Epistemic_val"))
            {
                print("into_acc: watch fi=")
                print_int(zi)
                print(" name=")
                print(str_from_bytes(znm.buf, znm.len))
                print(" ic=")
                print_int(zic)
                print("\n")
            }
            zi = zi + 1
        }
        lo.module = module_box_tr
    }
    IrLowerBoxResult {
        module: lo.module,
        error_count: lo.error_count,
        had_error: lower_had_error_with_hard(lo.had_error),
        patch_stats: patch_stats,
    }
}

pub fn lower_program_bodies_from_summary_flat_with_epistemic_ref(
    prog: &Program,
    summary: &IrProgramSummaryFlat,
    epistemic: IrEpistemicSection
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_from_program_summary_flat(summary, epistemic)
    var lo2 = lo.lower_program_bodies_ref(&prog.items)
    var patch_stats = ir_empty_validated_patch_stats()
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

pub fn lower_program_function_body_from_summary_with_epistemic(
    prog: Program,
    summary: IrProgramSummary,
    epistemic: IrEpistemicSection,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    lower_program_function_body_from_summary_with_epistemic_ref(&prog, &summary, epistemic, fn_name)
}

fn lower_program_function_body_from_summary_ref(
    prog: &Program,
    summary: &IrProgramSummary,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    lower_program_function_body_from_summary_with_epistemic_ref(prog, summary, ir_empty_epistemic_section(), fn_name)
}

fn lower_program_function_body_from_summary(
    prog: Program,
    summary: IrProgramSummary,
    fn_name: Name
) -> IrFunctionBodyResult with Mut, Panic, Div, Alloc, IO {
    lower_program_function_body_from_summary_ref(&prog, &summary, fn_name)
}

fn lower_program_to_ir_probe_callsite_ref(prog: &Program, caller_name: Name) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_probe()
    var lo2 = lo.preseed_program_items_ref(&prog.items, caller_name)
    lo2 = lo2.lower_program_bodies_filtered_ref(&prog.items, caller_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        patch_stats = ir_patch_validated_calls(&! (*lo2.module))
    }
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: patch_stats,
    }
}

pub fn lower_program_to_ir_probe_callsite(prog: Program, caller_name: Name) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_probe_callsite_ref(&prog, caller_name)
}

fn lower_program_to_ir_with_epistemic_trace_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_with_epistemic(&epistemic)
    lower_program_to_ir_staged_with_lowerer_trace_ref(lo, prog, patch_stats)
}

fn lower_program_to_ir_with_epistemic_boxed_trace_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_with_epistemic(&epistemic)
    lower_program_to_ir_staged_with_lowerer_box_trace_ref(lo, prog, patch_stats)
}

fn lower_program_to_ir_ordered_boxed_trace_ref(
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_live_diag_enabled() { print("lower_live: ordered_entry\n") }
    let lo = lowerer_new()
    if lower_live_diag_enabled() { print("lower_live: ordered_after_new\n") }
    var lo2 = lo.lower_program_items_ref(&prog.items)
    if lower_live_diag_enabled() { print("lower_live: ordered_after_items\n") }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        (*patch_stats) = ir_patch_validated_calls(&! (*lo2.module))
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: (*patch_stats),
    }
}

fn lower_program_to_ir_ordered_boxed_trace(
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_live_diag_enabled() { print("lower_live: ordered_entry\n") }
    var lo = lowerer_new()
    if lower_live_diag_enabled() { print("lower_live: ordered_after_new\n") }
    lowerer_lower_program_items_mut(&! lo, prog.items)
    if lower_live_diag_enabled() { print("lower_live: ordered_after_items\n") }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo.had_error) {
        (*patch_stats) = ir_patch_validated_calls(&! (*lo.module))
    }
    IrLowerBoxResult {
        module: lo.module,
        error_count: lo.error_count,
        had_error: lower_had_error_with_hard(lo.had_error),
        patch_stats: (*patch_stats),
    }
}

pub fn lower_program_to_ir_ordered_with_epistemic_boxed_trace_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_entry\n")
    }
    let lo = lowerer_new_with_epistemic(&epistemic)
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_after_new\n")
    }
    if lower_ordered_diag_enabled() {
        print("lower_ordered_core: enter\n")
    }
    var lo2 = lo.lower_program_items_ref(&prog.items)
    if lower_ordered_diag_enabled() {
        print("lower_live: ordered_after_items\n")
    }
    if lower_ordered_diag_enabled() {
        print("lower_ordered_core: after_items\n")
    }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if lower_ok_without_hard(lo2.had_error) {
        (*patch_stats) = ir_patch_validated_calls(&! (*lo2.module))
    }
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lower_had_error_with_hard(lo2.had_error),
        patch_stats: (*patch_stats),
    }
}

pub fn lower_program_to_ir_with_epistemic_trace(
    prog: Program,
    epistemic: IrEpistemicSection,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_with_epistemic_trace_ref(&prog, epistemic, patch_stats)
}

fn lower_program_to_ir_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    var patch_stats = ir_empty_validated_patch_stats()
    lower_program_to_ir_with_epistemic_trace_ref(prog, epistemic, &! patch_stats)
}

fn lower_program_to_ir_with_epistemic(prog: Program, epistemic: IrEpistemicSection) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_with_epistemic_ref(&prog, epistemic)
}
