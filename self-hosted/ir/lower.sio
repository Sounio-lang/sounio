// AST -> IR lowering

module ir::lower

use parser::ast::*
use ir::ir::*
use ir::numeric_payload::{ir_wide_compile_pool_reset, ir_wide_compile_pool_intern_low}
use check::specializer::{spec_dce_filter_with_global_marks, spec_dce_global_marks_ready}
use io::trace::*
use io::env::{read_env}

struct LowerLocalNameSlots {
    values: [Name; 4096],
}

fn lowerer_box_empty_local_name_slots() -> Box<LowerLocalNameSlots> with Alloc, Mut {
    Box::new(LowerLocalNameSlots { values: [ir_empty_name(); 4096] })
}

struct LowerLocalI64Slots {
    values: [i64; 4096],
}

fn lowerer_box_local_i64_slots(fill: i64) -> Box<LowerLocalI64Slots> with Alloc, Mut {
    Box::new(LowerLocalI64Slots { values: [fill; 4096] })
}

struct LowerLocalStack {
    names: Box<LowerLocalNameSlots>,
    regs: Box<LowerLocalI64Slots>,
    depths: Box<LowerLocalI64Slots>,
    struct_types: Box<LowerLocalNameSlots>,
    array_elem_float: Box<LowerLocalI64Slots>,
    // Logical element count for a directly-stored fixed array local. -1 means
    // the local is not a fixed array (or its extent is not statically known).
    array_lens: Box<LowerLocalI64Slots>,
    // 1 only when each array element is known to occupy one non-aggregate word.
    // Nested arrays and struct elements must not take the shallow slot-copy path.
    array_copy_word_scalar: Box<LowerLocalI64Slots>,
    wide_bits: Box<LowerLocalI64Slots>,
    wide_signed: Box<LowerLocalI64Slots>,
    // Findings 11 (#2084): 1 when a local/param is a non-wide unsigned integer
    // (u8/u16/u32/u64/usize). Used by lower_binary_expr_ref to flip the IR
    // bin_op to OpUDiv/OpURem/OpUShr before emitting the Sar/Idiv path.
    // wide_signed only fires for bits>64, so this field is the separate
    // per-slot tracker for the standard 8/16/32/64-bit unsigned widths.
    is_unsigned_int: Box<LowerLocalI64Slots>,
    global_bss_offsets: Box<LowerLocalI64Slots>,
    global_bss_sizes: Box<LowerLocalI64Slots>,
    is_global: Box<LowerLocalI64Slots>,
    // 1 = local/param holds a reference (&P / &[T;N] / &![T;N]) to a heap aggregate,
    // i.e. its slot stores a raw address of the caller slot, not the handle directly.
    is_ref: Box<LowerLocalI64Slots>,
    // 0=other 1=int 2=float; used by println dispatch to avoid routing i64/f64 vars through print_str
    scalar_kind: Box<LowerLocalI64Slots>,
    // Tuple-typed local: bit k set iff element k of the tuple is f64. 0 = not a
    // tuple / no float elements. See lower_opt_type_tuple_float_mask (issue #1502).
    tuple_float_mask: Box<LowerLocalI64Slots>,
    // Layout index for an aggregate element carried by a local: tuple slot-0
    // fixed arrays and Seq<T> share this slot because those shapes are disjoint.
    tuple0_array_elem_layout: Box<LowerLocalI64Slots>,
    // Tuple-typed local one of whose slots holds a named struct: that struct's
    // index in the layout table, and WHICH slot it is. -1 on both when absent.
    // Two slots and not one packed value because the slot number is what a `.K`
    // access has to match -- applying the layout to any K is how `pair.0.x`
    // would read a bool as a struct.
    tuple_struct_layout: Box<LowerLocalI64Slots>,
    tuple_struct_slot: Box<LowerLocalI64Slots>,
    // f64 register carrying the GUM variance shadow for scalar locals, or -1 when absent.
    variance_regs: Box<LowerLocalI64Slots>,
    // -1 = not a capturing closure; otherwise the synthetic closure fn_id whose captures
    // must be injected when this local is called (closures step 2).
    closure_fn_id: Box<LowerLocalI64Slots>,
    // Layout-table index of the T in a Box<T> param/local; -1 otherwise. struct_types keeps
    // holding the literal "Box" because twelve sites read it and two test it with ir_name_is_box.
    box_inner_layout: Box<LowerLocalI64Slots>,
    // 1 when local/param is fn(...) -> f64 (or f32); drives IrCallIndirect float markers.
    fn_ptr_ret_float: Box<LowerLocalI64Slots>,
    count: i64,
}

// FO bind table, moved OFF the Lowerer and behind a Box.
//
// WHY. These two arrays are 49 KB of the Lowerer's 75.5 KB of inline storage, and
// the Lowerer is passed BY VALUE into every classifier and lowering method here.
// lower_expr_non_binary_ref alone makes 71 by-value calls whose methods also
// RETURN a Lowerer, so one frame of it holds ~150 copies: 11,941,664 bytes,
// measured from its own prologue. At 103 nested if-expressions that is 1173 MB of
// a 1536 MB stack -- 76.6% of it, and the reason a gen2 self-compile SIGSEGVs in
// the stack probe at `dep_begin 80`.
//
// Boxing them cuts the inline Lowerer from 75.5 KB to 26.5 KB, which divides EVERY
// frame in every recursion, not just this one. That is why the table moves rather
// than the recursion being flattened: the depth (103) is legitimate source
// nesting, and the classifier trio that looked like the culprit is 4.7% of the
// budget. Measured before choosing, because the obvious target was the wrong one.
struct LowerFoBindTable {
    names: [Name; 128],
    sens: [i64; 4096],
}

fn empty_lower_fo_bind_table() -> LowerFoBindTable {
    LowerFoBindTable {
        names: [ir_empty_name(); 128],
        sens: [-1; 4096],
    }
}

fn empty_lower_local_stack() -> LowerLocalStack with Alloc, Mut {
    let names = lowerer_box_empty_local_name_slots()
    let struct_types = lowerer_box_empty_local_name_slots()
    LowerLocalStack {
        names: names,
        regs: lowerer_box_local_i64_slots(IR_INVALID_REG),
        depths: lowerer_box_local_i64_slots(0),
        struct_types: struct_types,
        array_elem_float: lowerer_box_local_i64_slots(0),
        array_lens: lowerer_box_local_i64_slots(-1),
        array_copy_word_scalar: lowerer_box_local_i64_slots(0),
        wide_bits: lowerer_box_local_i64_slots(0),
        wide_signed: lowerer_box_local_i64_slots(0),
        // Findings 11 (#2084): see the is_unsigned_int field comment above.
        is_unsigned_int: lowerer_box_local_i64_slots(0),
        global_bss_offsets: lowerer_box_local_i64_slots(0),
        global_bss_sizes: lowerer_box_local_i64_slots(0),
        is_global: lowerer_box_local_i64_slots(0),
        is_ref: lowerer_box_local_i64_slots(0),
        scalar_kind: lowerer_box_local_i64_slots(0),
        tuple_float_mask: lowerer_box_local_i64_slots(0),
        tuple0_array_elem_layout: lowerer_box_local_i64_slots(-1),
        tuple_struct_layout: lowerer_box_local_i64_slots(-1),
        tuple_struct_slot: lowerer_box_local_i64_slots(-1),
        variance_regs: lowerer_box_local_i64_slots(-1),
        closure_fn_id: lowerer_box_local_i64_slots(-1),
        box_inner_layout: lowerer_box_local_i64_slots(-1),
        fn_ptr_ret_float: lowerer_box_local_i64_slots(0),
        count: 0,
    }
}

// --- Capturing-closure support (closures step 2) ---
// A capturing closure is lowered as a synthetic fn whose LEADING params are the captured
// values, followed by the lambda's own params. The closure is never given a first-class
// runtime value (it stays out of the bare fn-ref representation, so #418 zero-capture
// closures + fn-pointer interop are untouched); instead the captured enclosing regs are
// injected at a direct call site. All stores use the extract-Box-first / copy-modify-
// writeback idiom to dodge the by-value-aggregate-store miscompile.
struct CaptureList {
    names: [Name; 8],
    regs: [i64; 8],
    count: i64,
}
fn empty_capture_list() -> CaptureList {
    CaptureList { names: [ir_empty_name(); 8], regs: [IR_INVALID_REG; 8], count: 0 }
}
fn capture_list_add(caps: CaptureList, name: Name, reg: i64) -> CaptureList with Mut, Panic, Div {
    var c = caps
    var i: i64 = 0
    while i < c.count {
        if ir_name_eq(c.names[i as usize], name) { return c }
        i = i + 1
    }
    if c.count < 8 {
        let idx = c.count
        c.names[idx as usize] = name
        c.regs[idx as usize] = reg
        c.count = idx + 1
    }
    c
}

struct ClosureCapEntry {
    fn_id: i64,
    // Function the captured regs BELONG TO. A capturing closure's caps are the
    // enclosing frame's vregs, injected at the call site -- valid only while the
    // call happens in that same frame. Called from anywhere else they reference
    // registers that do not exist there, which segfaults (measured rc=139).
    // Recorded so the call site can refuse instead (#1542).
    def_fn: i64,
    cap_count: i64,
    caps: [i64; 8],
}
struct ClosureCapTable {
    entries: [ClosureCapEntry; 256],
    count: i64,
}
fn empty_closure_cap_table() -> ClosureCapTable {
    ClosureCapTable {
        entries: [ClosureCapEntry { fn_id: -1, def_fn: -1, cap_count: 0, caps: [IR_INVALID_REG; 8] }; 256],
        count: 0,
    }
}
fn lower_name_in_closure_params(params: &Option<Box<ClosureParamList>>, name: Name) -> bool with Mut, Panic, Div {
    var cur = params
    while true {
        match *cur {
            Some(pl) => {
                if ir_name_eq((*pl).head.name, name) { return true }
                cur = &(*pl).tail
            }
            _ => break
        }
    }
    false
}

struct LowerLoopLabels {
    break_labels: [i64; 256],
    continue_labels: [i64; 256],
}

fn empty_lower_loop_labels() -> LowerLoopLabels {
    LowerLoopLabels {
        break_labels: [IR_INVALID_LABEL; 256],
        continue_labels: [IR_INVALID_LABEL; 256],
    }
}

let LOWER_GLOBAL_ELEM_F64: i64 = 2
let LOWER_GLOBAL_SCALAR_F64: i64 = 3
// Word-size integer scalar global (`var G: i64 = …`). Distinct from 0/unknown so
// `print(G)` / `println(G)` can select print_int instead of the char* printer.
let LOWER_GLOBAL_SCALAR_I64: i64 = 1
// Non-f64 fixed array global (`var A: [i64; N] = …`, including N=1). Distinct from
// scalar kinds so Ident lowering loads the BSS *address* for IndexGet, not the
// stored element value. Without this, `[T; 1]` (bss_size <= 8) took the scalar
// load path and IndexGet treated the init word as a pointer → SEGV.
let LOWER_GLOBAL_ARRAY: i64 = 4

// Inter-procedural FO transfer table (module-global so it survives Lowerer
// by-value churn). Reset at each program-items lower start.
// kind: 0=none 1=id 2=scale 3=add 4=mul 5=fwd
// Keys are polynomial hashes of Name bytes (Name aggregates do not survive
// global array stores — same family as ClaimDecl name truncation).
// #1645: a DURABLE record that lowering hit a hard capacity wall.
//
// Lowerer is threaded by VALUE. `emit` writes the instruction through
// `lo.current_func`, which is a Box -- so a dropped instruction is permanent and
// visible in the finished module -- but `had_error` and `error_count` are plain
// scalar fields of the Lowerer value. Any link in the lowering chain that
// discards the Lowerer it was returned loses the flag while KEEPING the
// truncation. Measured: a `main` past IR_MAX_INSTRS reaches
// module_frontend with instr_count pinned at 4096 and had_error FALSE, so every
// one of the six `if body_result.had_error` checks passes and the driver writes
// a truncated binary and exits 0.
//
// Rather than hunt every discard site in an expression-lowering chain that is
// thousands of lines wide -- and re-hunt them after the next edit -- the signal
// is recorded somewhere value semantics cannot reach. It is OR-ed into every
// IrLowerResult/IrLowerBoxResult at construction, so all existing consumers of
// had_error start working without changing any of them.
//
// Reset per COMPILE (lower_hard_error_reset, called from
// module_frontend_global_init_compile_begin), never per pass: a single compile
// runs several lowering passes and an intermediate one may be discarded, but a
// program that exceeded a hard limit in ANY non-probe pass has exceeded it.
var IR_LOWER_HARD_ERROR: i64 = 0

// How many instructions were DROPPED for the function currently being lowered.
// Reset at the top of each function body (ir_instr_overflow_begin_fn), so the
// diagnostic can report what the function actually needed rather than only that
// it did not fit -- "exceeds the limit" is not actionable, "needs 4096 + 912" is.
var IR_INSTR_OVERFLOW_COUNT: i64 = 0

pub fn ir_instr_overflow_begin_fn() with Mut { IR_INSTR_OVERFLOW_COUNT = 0 }

// ---------------------------------------------------------------------------
// Resident-memory probes, behind SOUNIO_LOWER_RSS_TRACE=1.
//
// Five structural hypotheses about the ~895 KB per function have now been
// refuted BY MEASUREMENT — the machine IR, the instruction array (IrFunction
// shrunk 48x: 10%), the by-value copies on the _ref paths (0%), the arena, and
// the Lowerer's 92.5 KB of inline arrays (shrunk 19x: 0%). Every one of them
// was a structure that looked the right size. So stop sizing structures and
// read the number at labelled points instead.
//
// /proc/self/statm field 2 is resident pages. NOTE the trap this was checked
// against first: procfs reports file_size 0, so any read path that stats and
// trusts the size gets nothing — read_file returns the real bytes and that was
// verified with a standalone program before this was written.
//
// What is being localised: a call costs 705 KB on the FIRST call in a body and
// ~8 KB on each one after, while pure arithmetic costs 7 KB and arguments cost
// ~12 KB each. So one big thing is allocated once per body, triggered by the
// presence of any call at all.
var LOWER_RSS_TRACE_ON: i64 = 0
var LOWER_RSS_TRACE_CHECKED: i64 = 0
var LOWER_RSS_LAST: i64 = 0

fn lower_rss_enabled() -> bool with IO, Mut, Panic, Div, Alloc {
    if LOWER_RSS_TRACE_CHECKED == 0 {
        LOWER_RSS_TRACE_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_RSS_TRACE"), "1") {
            LOWER_RSS_TRACE_ON = 1
        }
    }
    LOWER_RSS_TRACE_ON == 1
}

// Resident pages: the second whitespace-separated field of /proc/self/statm.
fn lower_rss_pages() -> i64 with IO, Mut, Panic, Div, Alloc {
    let d = read_file("/proc/self/statm")
    let n = str_len(d)
    var i: i64 = 0
    var field: i64 = 0
    var acc: i64 = 0
    var seen = false
    while i < n {
        let c = str_char_at(d, i)
        if c >= 48 && c <= 57 {
            acc = acc * 10 + (c - 48)
            seen = true
        } else {
            if seen {
                if field == 1 { return acc }
                field = field + 1
                acc = 0
                seen = false
            }
        }
        i = i + 1
    }
    if seen && field == 1 { return acc }
    0
}

// Print resident KB and the DELTA since the previous mark. The delta is what
// localises an allocation; the absolute is only there to catch a probe that
// stopped reading.
pub fn lower_rss_mark(label: string) with IO, Mut, Panic, Div, Alloc {
    if !lower_rss_enabled() { return }
    let kb = lower_rss_pages() * 4
    print("rss ")
    print(label)
    print(" ")
    print_int(kb)
    print(" d=")
    print_int(kb - LOWER_RSS_LAST)
    print("\n")
    LOWER_RSS_LAST = kb
}


// ---------------------------------------------------------------------------
// Instruction-count census, behind SOUNIO_IR_INSTR_CENSUS=1.
//
// IrFunction.instrs is [IrInstr; IR_MAX_INSTRS] — a FIXED array per function,
// so every function reserves the full budget whether it emits five
// instructions or four thousand. Measured 2026-08-05 on generated modules of
// one-line functions, peak RSS grows at a flat 1417.5 KB PER FUNCTION and does
// not care how many instructions those functions contain: 200 fns -> 1.1 GB,
// 1000 -> 2.2 GB, 3000 -> 5.0 GB, 6000 -> 9.1 GB. That is the wall in front of
// self-compilation, since main.sio's closure has ~6000 reachable functions.
//
// Two ways out, and they differ by three orders of magnitude in cost: lower
// IR_MAX_INSTRS (one line) or give instructions a shared arena (4518 `.instrs[`
// sites). Which one is right depends entirely on the DISTRIBUTION of
// instr_count over real functions — if the 99th percentile is 300, the constant
// is simply mis-set; if it is 3000, only an arena helps.
//
// So this prints the distribution rather than arguing about it. Buckets are
// powers of two; `over` counts functions that did not fit at all.
var IR_INSTR_CENSUS_BUCKET: [i64; 16] = [0; 16]
var IR_INSTR_CENSUS_FNS: i64 = 0
var IR_INSTR_CENSUS_TOTAL: i64 = 0
var IR_INSTR_CENSUS_MAX: i64 = 0
var IR_INSTR_CENSUS_OVER: i64 = 0

// Memoised: read_env allocates and the runtime allocator never reclaims,
// so a gate evaluated at every call site leaks on every call. CHECKED is
// separate from the value because "off" and "not yet read" are different.
var IR_INSTR_CENSUS_ENABLED_ON: i64 = 0
var IR_INSTR_CENSUS_ENABLED_CHECKED: i64 = 0

fn ir_instr_census_enabled() -> bool with IO, Mut, Panic, Div {
    if IR_INSTR_CENSUS_ENABLED_CHECKED == 0 {
        IR_INSTR_CENSUS_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_IR_INSTR_CENSUS"), "1") {
            IR_INSTR_CENSUS_ENABLED_ON = 1
        }
    }
    IR_INSTR_CENSUS_ENABLED_ON == 1
}

pub fn ir_instr_census_record(n: i64, overflowed: bool) with Mut, Panic, Div {
    IR_INSTR_CENSUS_FNS = IR_INSTR_CENSUS_FNS + 1
    IR_INSTR_CENSUS_TOTAL = IR_INSTR_CENSUS_TOTAL + n
    if n > IR_INSTR_CENSUS_MAX { IR_INSTR_CENSUS_MAX = n }
    if overflowed { IR_INSTR_CENSUS_OVER = IR_INSTR_CENSUS_OVER + 1 }
    var b: i64 = 0
    var lim: i64 = 1
    while b < 15 && n > lim {
        lim = lim * 2
        b = b + 1
    }
    IR_INSTR_CENSUS_BUCKET[b as usize] = IR_INSTR_CENSUS_BUCKET[b as usize] + 1
}

pub fn ir_instr_census_report() with IO, Mut, Panic, Div {
    if !ir_instr_census_enabled() { return }
    if IR_INSTR_CENSUS_FNS <= 0 { return }
    print("SOUNIO_IR_INSTR_CENSUS_V1\n")
    print("functions\t") print_int(IR_INSTR_CENSUS_FNS) print("\n")
    print("instructions\t") print_int(IR_INSTR_CENSUS_TOTAL) print("\n")
    print("mean\t") print_int(IR_INSTR_CENSUS_TOTAL / IR_INSTR_CENSUS_FNS) print("\n")
    print("max\t") print_int(IR_INSTR_CENSUS_MAX) print("\n")
    print("over_limit\t") print_int(IR_INSTR_CENSUS_OVER) print("\n")
    print("reserved\t") print_int(IR_INSTR_CENSUS_FNS * IR_MAX_INSTRS) print("\n")
    var b: i64 = 0
    var lim: i64 = 1
    while b < 16 {
        if IR_INSTR_CENSUS_BUCKET[b as usize] > 0 {
            print("le_") print_int(lim) print("\t")
            print_int(IR_INSTR_CENSUS_BUCKET[b as usize]) print("\n")
        }
        lim = lim * 2
        b = b + 1
    }
}


// THE FLAG CARRIES ITS REASON. #1645 made IR_LOWER_HARD_ERROR durable against
// the Lowerer's by-value threading, which is what makes the failure visible at
// all — but a bare flag told the caller only THAT lowering failed. Measured
// 2026-08-05 compiling self-hosted/compiler/main.sio: the merge reported
// "ir_summary_failed: lowering reported an error" and NOTHING anywhere named
// the cause, because the message that would name it lives at the end of
// lowerer_lower_fn_item_mut and this path does not go through that function.
// Capacity was originally the only site raising the flag. Unresolved print ABI
// dispatch is now the second; both record an explicit reason before refusing.
// PARALLEL FLAT ARRAYS, NOT `Name`. Storing a Name into a global OVERRUNS INTO
// THE NEXT GLOBALS. Reproduced 2026-08-05 with a probe replicating this exact
// declaration order, compiled by the seed that builds this compiler:
//
//   40-char names:  total=4702111234474983747  stage=4702111234474983745
//                   = 0x4141414141414143 and 0x4141414141414141 — eight 'A'
//                     bytes, i.e. the NAME's own contents, sitting in the two
//                     i64 globals declared after it
//   4-char names:   total=0  stage=2
//                   — the short name's zero padding lands on total and erases it
//
// The second row IS the signature that was read for three commits as "no
// lowering error was ever recorded". It was never a fact about lowering; it was
// a neighbouring global being overwritten by padding. Every other place in this
// tree that keeps a name in a global already uses flat bytes —
// IR_NAME_POOL_BUF (ir.sio), GLOBAL_NAME_BUF, EXTERN_STUB_NAME_BUF — and these
// two were the only `Name`-typed globals in it.
var IR_LOWER_HARD_ERROR_FN_BUF: [i8; 128]
var IR_LOWER_HARD_ERROR_FN_LEN: i64 = 0
var IR_LOWER_HARD_ERROR_NEEDED: i64 = 0
// 0=unspecified, 1=instruction capacity, 2=unresolved print ABI.
var IR_LOWER_HARD_ERROR_REASON: i64 = 0
// Same flat-array treatment, same reason.
var IR_LOWER_ERROR_FIRST_FN_BUF: [i8; 128]
var IR_LOWER_ERROR_FIRST_FN_LEN: i64 = 0
var IR_LOWER_ERROR_TOTAL: i64 = 0
// WHICH PRESEED STAGE first turned had_error true, and for the two that loop,
// on which module index. The counters above proved the flag goes true without
// any `had_error = true` in this file firing, so the write happens inside one
// of the three preseed calls by some other route; this narrows it to one call
// without having to instrument all of them.
//   1 = external struct items   2 = own program items   3 = external BSS globals
var IR_LOWER_ERROR_STAGE: i64 = 0
var IR_LOWER_ERROR_STAGE_IDX: i64 = 0

fn lower_note_stage(stage: i64, idx: i64, flagged: bool) with Mut {
    if flagged && IR_LOWER_ERROR_STAGE == 0 {
        IR_LOWER_ERROR_STAGE = stage
        IR_LOWER_ERROR_STAGE_IDX = idx
    }
}

// report_error_at(394) is not the only way lowering fails: TEN sites in this file set
// `lo.had_error = true` directly and never pass through it. That is why the
// first attempt at naming the error came back empty — the counters were in
// report_error and the failure was not. Both channels record here now.
// Byte copy into parallel flats. `dst = src` on a Name-typed global is the
// construct this replaces; see the declarations above for what it did.
fn ir_copy_name_to_flat(src: &Name, buf: &! [i8; 128], len: &! i64) with Mut {
    var i: i64 = 0
    while i < (*src).len && i < 128 {
        buf[i as usize] = (*src).buf[i as usize]
        i = i + 1
    }
    *len = (*src).len
}

fn ir_print_flat_name(buf: &[i8; 128], len: i64) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < len && i < 128 {
        print_char(buf[i as usize] as i64)
        i = i + 1
    }
}

// Which SITE fired, not just how many. The name is captured too, but it comes
// from `(*lo.current_func).name` -- a field read through a Box, which is the
// shape recorded as miscompiled in this tree -- and it came back EMPTY on the
// first real reading, naming nothing. A call-site id is an i64 in a flat array:
// the one shape this session has proved survives.
var IR_LOWER_ERR_SITES: [i64; 64]

// The first 8 UNRESOLVED IDENTIFIERS, verbatim. Site 15400 fires when an
// ExprPath is neither an enum variant, nor None, nor a local, nor a function --
// i.e. a name that lowering cannot resolve at all. It fired 3136 times in one
// module while reporting only the ENCLOSING function's name, which says where
// the compiler was and never what it was looking for. Flat arrays, because a
// Name in a global overruns into its neighbours in this tree.
var IR_LOWER_UNRES_BUF: [i8; 1024]
var IR_LOWER_UNRES_LEN: [i64; 8]
var IR_LOWER_UNRES_COUNT: i64 = 0

pub fn lower_note_unresolved(n: Name) with Mut {
    if IR_LOWER_UNRES_COUNT < 8 {
        let base = IR_LOWER_UNRES_COUNT * 128
        var i: i64 = 0
        while i < n.len && i < 128 {
            IR_LOWER_UNRES_BUF[(base + i) as usize] = n.buf[i as usize]
            i = i + 1
        }
        IR_LOWER_UNRES_LEN[IR_LOWER_UNRES_COUNT as usize] = n.len
    }
    IR_LOWER_UNRES_COUNT = IR_LOWER_UNRES_COUNT + 1
}

pub fn lower_note_error(site: i64, n: Name) with Mut {
    IR_LOWER_ERROR_TOTAL = IR_LOWER_ERROR_TOTAL + 1
    if IR_LOWER_ERROR_TOTAL <= 64 {
        IR_LOWER_ERR_SITES[(IR_LOWER_ERROR_TOTAL - 1) as usize] = site
    }
    if IR_LOWER_ERROR_TOTAL == 1 {
        ir_copy_name_to_flat(&n, &! IR_LOWER_ERROR_FIRST_FN_BUF, &! IR_LOWER_ERROR_FIRST_FN_LEN)
    }
}
var IR_LOWER_HARD_ERROR_LIMIT: i64 = 0

pub fn lower_hard_error_pending() -> bool { IR_LOWER_HARD_ERROR != 0 }

// Print what the flag knows, or say plainly that it knows nothing — never
// silence. Called by the consumers that used to print a bare "ir_summary_failed".
pub fn lower_hard_error_report() with IO, Mut, Panic, Div {
    // ALWAYS SAYS SOMETHING. The first version of this printed nothing when both
    // counters were zero, which made two very different situations look
    // identical: "the reporter never ran" and "the reporter ran and nothing had
    // been recorded". Distinguishing them is the whole job of a probe, and it
    // cost a build to notice the probe could not.
    if IR_LOWER_ERROR_STAGE > 0 {
        print("  first flagged in preseed stage ")
        print_int(IR_LOWER_ERROR_STAGE)
        print(" (1=external structs, 2=own items, 3=external bss) at module index ")
        print_int(IR_LOWER_ERROR_STAGE_IDX)
        print("\n")
    }
    if IR_LOWER_UNRES_COUNT > 0 {
        print("  unresolved identifiers (")
        print_int(IR_LOWER_UNRES_COUNT)
        print(" total, first 8):")
        var u: i64 = 0
        while u < IR_LOWER_UNRES_COUNT && u < 8 {
            print(" `")
            var c: i64 = 0
            while c < IR_LOWER_UNRES_LEN[u as usize] && c < 128 {
                print_char(IR_LOWER_UNRES_BUF[(u * 128 + c) as usize] as i64)
                c = c + 1
            }
            print("`")
            u = u + 1
        }
        print("\n")
    }
    print("  lowering-error record: total=")
    print_int(IR_LOWER_ERROR_TOTAL)
    print(" hard=")
    print_int(IR_LOWER_HARD_ERROR)
    print("\n")
    // Reported even when the durable flag is clear: had_error can be true from
    // any of report_error's 54 call sites while only the IR_MAX_INSTRS overflow
    // raises IR_LOWER_HARD_ERROR. Returning early on a clear flag is exactly how
    // this stayed anonymous.
    if IR_LOWER_ERROR_TOTAL > 0 {
        print("  lowering errors: ")
        print_int(IR_LOWER_ERROR_TOTAL)
        print(", first while lowering function `")
        ir_print_flat_name(&IR_LOWER_ERROR_FIRST_FN_BUF, IR_LOWER_ERROR_FIRST_FN_LEN)
        print("`\n")
        // The site ledger. An empty name above means the Box-read of
        // current_func gave nothing, NOT that there is nothing to say -- these
        // ids name the lower.sio line each error was raised from, in order.
        // 6514 is Lowerer::report_error, the funnel that ~54 call sites reach.
        print("  raised at lower.sio lines:")
        var e: i64 = 0
        while e < IR_LOWER_ERROR_TOTAL && e < 64 {
            print(" ")
            print_int(IR_LOWER_ERR_SITES[e as usize])
            e = e + 1
        }
        if IR_LOWER_ERROR_TOTAL > 64 {
            print(" (first 64 of ")
            print_int(IR_LOWER_ERROR_TOTAL)
            print(")")
        }
        print("\n")
    }
    if IR_LOWER_HARD_ERROR == 0 {
        return
    }
    if IR_LOWER_HARD_ERROR_REASON == 2 {
        print("  cause: cannot safely lower print/println argument with unresolved scalar kind in function `")
        ir_print_flat_name(&IR_LOWER_HARD_ERROR_FN_BUF, IR_LOWER_HARD_ERROR_FN_LEN)
        print("`\n")
    } else if IR_LOWER_HARD_ERROR_NEEDED > 0 {
        print("  cause: function `")
        ir_print_flat_name(&IR_LOWER_HARD_ERROR_FN_BUF, IR_LOWER_HARD_ERROR_FN_LEN)
        print("` needs at least ")
        print_int(IR_LOWER_HARD_ERROR_NEEDED)
        print(" IR instructions but IR_MAX_INSTRS is ")
        print_int(IR_LOWER_HARD_ERROR_LIMIT)
        print("\n")
    } else {
        print("  cause: lowering raised a hard error and recorded no detail — if this\n")
        print("         prints, a NEW raise site was added without recording its reason.\n")
    }
}

pub fn lower_hard_error_reset() with Mut {
    IR_LOWER_HARD_ERROR = 0
    IR_LOWER_HARD_ERROR_NEEDED = 0
    IR_LOWER_HARD_ERROR_LIMIT = 0
    IR_LOWER_HARD_ERROR_REASON = 0
    IR_LOWER_HARD_ERROR_FN_LEN = 0
    IR_LOWER_ERROR_TOTAL = 0
    IR_LOWER_ERROR_FIRST_FN_LEN = 0
    IR_LOWER_ERROR_STAGE = 0
    IR_LOWER_ERROR_STAGE_IDX = 0
}

// OR the durable flag into a value-threaded had_error. Used at every
// IrLowerResult/IrLowerBoxResult construction site.
pub fn lower_had_error_with_hard(v: bool) -> bool { v || IR_LOWER_HARD_ERROR != 0 }
fn lower_ok_without_hard(v: bool) -> bool { !lower_had_error_with_hard(v) }
var FO_XFER_COUNT: i64 = 0
var FO_XFER_KIND: [i64; 64] = [0; 64]
var FO_XFER_LIT: [f64; 64] = [0.0; 64]
var FO_XFER_HASH: [i64; 64] = [0; 64]

// #1706: per-FIELD FO transfers for struct-returning functions.
//
// The scalar transfer table above answers "what does f do to its argument's
// uncertainty". It cannot answer `make_d(x, v0).c.b.a.x`, because the value is
// a struct and the question is about ONE FIELD of it. Per-field variance (#1711)
// is keyed on a local's base register, and a call result has no local, so every
// such chain read a silent 0.0.
//
// Keyed by (callee name hash, field PATH hash) so no name mangling is needed --
// paths like `c.b.a.x` would not fit a fixed-size Name. Values are the same
// kind/lit vocabulary as FO_XFER_*, so the apply side is shared, not duplicated.
var FO_CTOR_COUNT: i64 = 0
var FO_CTOR_FN_HASH: [i64; 256] = [0; 256]
var FO_CTOR_PATH_HASH: [i64; 256] = [0; 256]
var FO_CTOR_KIND: [i64; 256] = [0; 256]
var FO_CTOR_LIT: [f64; 256] = [0.0; 256]
// Top-level field index for depth-0 leaves, -1 for deeper paths. A path hash
// cannot be walked backwards to a field index, and binding `let pk = make(x)`
// needs to enumerate the ctor's OWN fields.
var FO_CTOR_FIELD0: [i64; 256] = [0; 256]

// Pairwise correlation between measurement channels, set by correlate(a,b,rho).
//
// 8x8 to match so_hess_idx's domain: the off-diagonal Hessian is the second
// consumer of this, and a covariance the Hessian cannot index is a covariance
// nothing can use. Variance walks 32 channels, so a pair above 7 is silently
// uncorrelated -- fo_cov_rho_set refuses it rather than wrapping into another
// pair's slot.
// sigma per channel, as a register index -- not sigma squared, and not a
// struct field.
//
// A field on Lowerer was written in the same place and the same shape as
// fo_sigma2 and still read back as -1, so the covariance term silently
// vanished. FO_COV_RHO beside it is a module global and reads correctly, so
// this follows it -- consistent with this compiler's known limits on large
// aggregates.
var FO_SIGMA_REG: [i64; 32] = [-1; 32]

var FO_COV_RHO: [f64; 64] = [0.0; 64]

fn fo_cov_rho_idx(i: i64, j: i64) -> i64 with Div {
    var a = i
    var b = j
    if a > b {
        a = j
        b = i
    }
    a * 8 + b
}

fn fo_cov_rho_set(i: i64, j: i64, rho: f64) with Mut, Panic, Div, IO {
    if i < 0 || j < 0 || i >= 8 || j >= 8 {
        return
    }
    if i == j {
        return
    }
    // Declared sabotage: drop every correlation, silently reverting the
    // propagation to the independence assumption.
    if sab_correlate_rho() {
        return
    }
    FO_COV_RHO[fo_cov_rho_idx(i, j) as usize] = rho
}

fn fo_cov_rho_get(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i < 0 || j < 0 || i >= 8 || j >= 8 {
        return 0.0
    }
    if i == j {
        return 0.0
    }
    FO_COV_RHO[fo_cov_rho_idx(i, j) as usize]
}
var FO_XFER_FWD_HASH: [i64; 64] = [0; 64]

fn fo_name_hash(n: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 5381
    var i: i64 = 0
    while i < n.len && i < 64 {
        let b = (n.buf[i as usize] as i64) & 255
        h = h * 33 + b
        i = i + 1
    }
    h + n.len
}

fn fo_ctor_path_fold(acc: i64, name_hash: i64) -> i64 with Mut, Panic, Div {
    acc * 33 + name_hash
}

fn fo_ctor_global_set(fn_hash: i64, path_hash: i64, kind: i64, lit: f64, field0: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < FO_CTOR_COUNT {
        if FO_CTOR_FN_HASH[i as usize] == fn_hash && FO_CTOR_PATH_HASH[i as usize] == path_hash {
            FO_CTOR_KIND[i as usize] = kind
            FO_CTOR_LIT[i as usize] = lit
            FO_CTOR_FIELD0[i as usize] = field0
            return
        }
        i = i + 1
    }
    // Full table degrades to "unregistered", i.e. the pre-existing silent 0.0.
    // Never wrap: a wrong nonzero is worse than the zero this replaces.
    if FO_CTOR_COUNT >= 256 {
        return
    }
    let idx = FO_CTOR_COUNT
    FO_CTOR_FN_HASH[idx as usize] = fn_hash
    FO_CTOR_PATH_HASH[idx as usize] = path_hash
    FO_CTOR_KIND[idx as usize] = kind
    FO_CTOR_LIT[idx as usize] = lit
    FO_CTOR_FIELD0[idx as usize] = field0
    FO_CTOR_COUNT = idx + 1
}

fn fo_ctor_global_lookup(fn_hash: i64, path_hash: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FO_CTOR_COUNT {
        if FO_CTOR_FN_HASH[i as usize] == fn_hash && FO_CTOR_PATH_HASH[i as usize] == path_hash {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn fo_ctor_global_reset() with Mut {
    FO_CTOR_COUNT = 0
}

pub fn fo_xfer_global_reset() with Mut {
    FO_XFER_COUNT = 0
    var i: i64 = 0
    while i < 64 {
        FO_XFER_KIND[i as usize] = 0
        FO_XFER_LIT[i as usize] = 0.0
        FO_XFER_HASH[i as usize] = 0
        FO_XFER_FWD_HASH[i as usize] = 0
        i = i + 1
    }
}

// Chain-rule entries for the transcendentals, as kind-6 transfers:
// d/dx f(g) = f'(g) · dg/dx, with f' emitted as a call and the sign in the lit.
//
// The rest of the table is discovered by analysing user functions, so builtins
// never appeared in it. Without these, fo_apply_call_transfer treats sin/cos/exp
// as opaque, clears the sensitivity, and the channel is re-seeded from the
// result's variance — leaving the partial at the seed value 1.0 and computing
// var(sin(x)) as 0 (#1549).
//
// log is deliberately absent: its derivative is 1/x, not a call, so it needs a
// reciprocal kind rather than this one. Leaving it out keeps it honestly
// unsupported instead of silently wrong.
fn kind_lit_to_analytic_id(lit: f64) -> i64 with Mut, Panic, Div {
    if lit >= 0.5 && lit < 1.5 { return 1 }
    if lit >= 1.5 && lit < 2.5 { return 2 }
    if lit >= 2.5 && lit < 3.5 { return 3 }
    if lit >= 3.5 && lit < 4.5 { return 4 }
    if lit >= 4.5 && lit < 5.5 { return 5 }
    0
}

fn fo_xfer_seed_transcendentals() with Mut, Panic, Div, IO {
    fo_xfer_global_set(make_name("sin"), 6, 1.0, make_name("cos"))
    fo_xfer_global_set(make_name("cos"), 6, 0.0 - 1.0, make_name("sin"))
    fo_xfer_global_set(make_name("exp"), 6, 1.0, make_name("exp"))
    // Kind 8: derivative EMITTED, not named. atan' = 1/(1+x^2) has no name.
    fo_xfer_global_set(make_name("atan"), 8, 1.0, ir_empty_name())
    fo_xfer_global_set(make_name("asin"), 8, 2.0, ir_empty_name())
    fo_xfer_global_set(make_name("acos"), 8, 3.0, ir_empty_name())
    fo_xfer_global_set(make_name("tan"), 8, 4.0, ir_empty_name())
    fo_xfer_global_set(make_name("tanh"), 8, 5.0, ir_empty_name())
}

// Derivative function for a kind-6 entry, resolved from FO_XFER_FWD_HASH. The
// table stores hashes rather than Names, so the mapping back is by comparison
// against the transcendentals that have entries. An empty Name means "no rule",
// and the caller clears the sensitivity rather than reporting a wrong derivative.
fn fo_xfer_derivative_name(idx: i64) -> Name with Mut, Panic, Div {
    if idx < 0 || idx >= FO_XFER_COUNT {
        return ir_empty_name()
    }
    let want = FO_XFER_FWD_HASH[idx as usize]
    if want == fo_name_hash(make_name("sin")) { return make_name("sin") }
    if want == fo_name_hash(make_name("cos")) { return make_name("cos") }
    if want == fo_name_hash(make_name("exp")) { return make_name("exp") }
    ir_empty_name()
}

fn fo_xfer_global_lookup(name: Name) -> i64 with Mut, Panic, Div {
    let h = fo_name_hash(name)
    var i: i64 = 0
    while i < FO_XFER_COUNT {
        if FO_XFER_HASH[i as usize] == h {
            return i
        }
        i = i + 1
    }
    -1
}

fn fo_xfer_global_lookup_hash(h: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FO_XFER_COUNT {
        if FO_XFER_HASH[i as usize] == h {
            return i
        }
        i = i + 1
    }
    -1
}

fn fo_xfer_global_set(name: Name, kind: i64, lit: f64, fwd: Name) with Mut, Panic, Div, IO {
    let existing = fo_xfer_global_lookup(name)
    let h = fo_name_hash(name)
    let fh = fo_name_hash(fwd)
    if existing >= 0 {
        FO_XFER_KIND[existing as usize] = kind
        FO_XFER_LIT[existing as usize] = lit
        FO_XFER_FWD_HASH[existing as usize] = fh
        return
    }
    if FO_XFER_COUNT >= 64 {
        return
    }
    let idx = FO_XFER_COUNT
    FO_XFER_HASH[idx as usize] = h
    FO_XFER_KIND[idx as usize] = kind
    FO_XFER_LIT[idx as usize] = lit
    FO_XFER_FWD_HASH[idx as usize] = fh
    FO_XFER_COUNT = idx + 1
    if lower_live_diag_enabled() {
        print("lower_live: fo_xfer_set name=")
        print(str_from_bytes(name.buf, name.len))
        print(" kind=")
        print_int(kind)
        print(" count=")
        print_int(FO_XFER_COUNT)
        print("\n")
    }
}

pub struct LowerGlobalTypeTable {
    // Indexed by IrModule.functions slot. Keep this aligned with IR_MAX_FUNCS;
    // source array lengths are literal-only in the bootstrap grammar.
    elem_kinds: [i64; 16384],
}

fn empty_lower_global_type_table() -> LowerGlobalTypeTable {
    LowerGlobalTypeTable {
        elem_kinds: [0; 16384],
    }
}

// Compiler-owned, bounded read index for Contest metadata. This is the first
// replacement for reading the wide IrEpistemicSection through its legacy
// nested aggregate representation.
struct LowerEpistemicContestIndex {
    qualified: bool,
    contest_count: i64,
    span_starts: [i64; 64],
    span_ends: [i64; 64],
}

fn empty_lower_epistemic_contest_index() -> LowerEpistemicContestIndex {
    LowerEpistemicContestIndex {
        qualified: false,
        contest_count: 0,
        span_starts: [-1; 64],
        span_ends: [-1; 64],
    }
}

fn lower_epistemic_contest_index_from_ref(epistemic: &IrEpistemicSection) -> Box<LowerEpistemicContestIndex> with Alloc, Mut, Panic, Div {
    let count = (*epistemic).contest_count
    if count < 0 || count > IR_MAX_EPI_CONTESTS {
        panic("lowerer: invalid frontend epistemic contest_count")
    }
    let index = Box::new(empty_lower_epistemic_contest_index())
    (*index).qualified = true
    (*index).contest_count = count
    var i: i64 = 0
    while i < count {
        (*index).span_starts[i as usize] = (*epistemic).contests[i as usize].span_start
        (*index).span_ends[i as usize] = (*epistemic).contests[i as usize].span_end
        i = i + 1
    }
    index
}

struct Lowerer {
    module: Box<IrModule>,
    epistemic_contests: Box<LowerEpistemicContestIndex>,
    current_fn: i64,
    current_func: Box<IrFunction>,
    current_func_loaded: bool,
    env: Option<Box<IrEnvList>>,
    locals: Box<LowerLocalStack>,
    scope_depth: i64,
    loop_labels: Box<LowerLoopLabels>,
    loop_depth: i64,
    error_count: i64,
    had_error: bool,
    // Phase 3.1: Enum variant discriminants
    enum_variants: Box<EnumVariantTable>,
    // Phase 3.2: Struct field layouts
    struct_layouts: Box<StructLayoutTable>,
    // Frontend-owned global element types. BSS byte size cannot distinguish
    // `[f64; N]` from `[i64; N]`, so this survives summary -> body lowering.
    global_types: Box<LowerGlobalTypeTable>,
    array_elem_float_regs: [i64; 512],
    array_elem_float_reg_count: i64,
    variance_base_regs: [i64; 1024],
    variance_value_regs: [i64; 1024],
    variance_base_reg_count: i64,
    // Sprint 28: Debug-mode witness enforcement
    debug_mode: bool,
    // Sprint 44: probe-mode lowering skips heavyweight epistemic metadata lookup.
    probe_mode: bool,
    // Closures step 2: captured-reg table keyed by synthetic closure fn_id, and a
    // side-channel set by lower_closure_expr_ref and consumed by the let-binding so the
    // bound local knows it is a capturing closure.
    closure_caps: Box<ClosureCapTable>,
    pending_closure_fn_id: i64,
    allow_direct_capturing_closure_literal: bool,
    pending_variance_reg: i64,
    // β-Madaros multi-channel FO GUM (lean_single β¹⁰/β¹¹ parity target).
    // Var(y) = Σ_k (∂y/∂x_k)² · σ²_k with up to 8 Knowledge seeds per function.
    // Enables partial-correlation products ((a*b)*a) and p1−p2 cancel.
    // 32 channels: headroom for multi-seed polys after other live seeds in main.
    fo_nchan: i64,
    fo_sigma2: [i64; 32],
    fo_expr_sens: [i64; 32],
    fo_pending_sens: [i64; 32],
    fo_bind_count: i64,
    fo_bind: Box<LowerFoBindTable>,
    // Second order. H_jk = d2y/dx_j dx_k over the same 8 seed channels, stored
    // as the upper triangle (36 slots, so_hess_idx below). A slot of -1 means
    // STRUCTURALLY zero, not "unknown" -- measure() and every projection have
    // H = 0, so the common case costs no registers at all. Reuses the FO bind
    // rows so a local carries its Hessian exactly as it carries its gradient.
    so_enabled: bool,
    so_expr_hess: [i64; 36],
    so_bind_hess: [i64; 576],
    // Inter-procedural FO: pure-fn transfer table (survives across function lowers).
    // kind: 0=none 1=id(p0) 2=scale(lit*p0) 3=add(p0+p1) 4=mul(p0*p1) 5=fwd(g)
    fo_xfer_count: i64,
    fo_xfer_kind: [i64; 64],
    fo_xfer_lit: [f64; 64],
}

struct IrPreparedCallArgs {
    lo: Lowerer,
    args: Option<Box<IrRegList>>,
    argc: i64,
}

pub struct IrProgramSummary {
    module: Box<IrModule>,
    enum_variants: Box<EnumVariantTable>,
    struct_layouts: Box<StructLayoutTable>,
    global_types: Box<LowerGlobalTypeTable>,
    probe_mode: bool,
}

pub struct IrProgramSummaryResult {
    summary: IrProgramSummary,
    error_count: i64,
    had_error: bool,
}

pub struct IrProgramSummaryBoxResult {
    summary: Box<IrProgramSummary>,
    error_count: i64,
    had_error: bool,
}

pub struct IrProgramSummaryFlat {
    module: IrModule,
    enum_variants: EnumVariantTable,
    struct_layouts: StructLayoutTable,
    global_types: LowerGlobalTypeTable,
    probe_mode: bool,
}

pub struct IrProgramSummaryFlatResult {
    summary: IrProgramSummaryFlat,
    error_count: i64,
    had_error: bool,
}

pub struct LowerExprArgsResult {
    lowerer: Lowerer,
    regs: IrRegList,
    count: i64,
}

struct IrFastSummaryOwnedSeed {
    module: IrModule,
    enum_variants: EnumVariantTable,
    struct_layouts: StructLayoutTable,
    global_types: LowerGlobalTypeTable,
}

pub struct IrFunctionBodyResult {
    func: IrFunction,
    error_count: i64,
    had_error: bool,
    patch_stats: IrValidatedPatchStats,
}

pub struct IrLowerBoxResult {
    module: Box<IrModule>,
    error_count: i64,
    had_error: bool,
    patch_stats: IrValidatedPatchStats,
}

var LOWER_MONOLITHIC_PUBLIC_PROBE_TRACE: bool = false

// vreg holding the live lane counter while a `kernel fn` body is lowered inside
// the CPU lane loop; -1 outside a kernel. `gpu_thread_id_x()` lowers to a copy of
// this instead of a call to a name that binds to nothing (which left its dst vreg
// unwritten, i.e. reading 0). See lowerer_lower_fn_mut and the ExprCall lowering.
var LOWER_KERNEL_TID_REG: i64 = 0 - 1

// Label of the lane-increment block while a `kernel fn` body is lowered; -1
// outside a kernel. `return` inside a kernel ends THAT LANE, not the launch —
// CUDA semantics — so it lowers to a jump here instead of IrReturn, which would
// abandon every remaining lane. lean_single gets this wrong in the same
// direction (measured: a kernel returning at tid==2 of 8 runs 2 lanes under
// lean_single); matching that bug was rejected in favour of matching CUDA.
var LOWER_KERNEL_CONT_LABEL: i64 = 0 - 1

pub fn lower_monolithic_public_probe_trace_set(enabled: bool) with Mut {
    LOWER_MONOLITHIC_PUBLIC_PROBE_TRACE = enabled
}

fn lower_monolithic_public_probe_boundary(label: string) with Alloc, Panic, Div, IO {
    if LOWER_MONOLITHIC_PUBLIC_PROBE_TRACE {
        print("probe_monolithic_public_lower_boundary: ")
        print(label)
        print("\n")
    }
}

// Sprint 116: Register Knowledge/Epistemic struct layout (value, variance, confidence)
// β-Madaros 2026-07-25: value/variance are f64 — is_float MUST be 1 so FieldGet
// marks float and a.value * a.value uses real f64 mul (with is_float=0, integer
// imul on IEEE bits: aa=0, Var(4a²)=0 under default Madaros).
//
// Knowledge.confidence is f64 probability ε ∈ (0,1] (is_float=1).
// Historical trap (#1496 / MADAROS_FIELD_IF_I64): marking this float while
// field_is_float_by_name_simple("confidence") was name-global forced EVERY
// struct field named confidence onto the float path — MiniEp/Epistemic i64
// 0–1000 scales broke (OpGe/OpSub took float → if conf>=800 → 0).
// Mitigation now in place: name_simple is UNANIMOUS (mixed float+int name
// → false) and FieldGet prefers field_is_float_for_base_ref (typed base).
// So Knowledge can be honest f64 again without reopening #1496 on MiniI.
// Dual defect closed by this flip: KCONF-BITCAST-SITOFP (F2) — f64 bits in
// an i64-kind slot → sitofp on arithmetic → ~4.6e18 (ep28 TEST 6).
// See docs/audit/MADAROS_F64_BITCAST_SITOFP_BOUNDARY_2026-08-17.md.
// Apply package: docs/audit/KCONF_BITCAST_APPLY_PACKAGE_2026-08-18.md
pub(crate) fn ir_register_knowledge_layout(table: StructLayoutTable) -> StructLayoutTable with Mut, Panic, Div {
    var t = table
    if t.count >= 1024 {
        return t
    }
    let idx = t.count
    var fields: [StructFieldEntry; 128] = [empty_struct_field_entry(); 128]
    fields[0] = StructFieldEntry { name_id: ir_intern_name(make_name("value")), index: 0, is_float: 1, elem_type_name_id: ir_intern_name(ir_empty_name()), word_scalar_array_len: 0, named_type_name_id: 0 }
    fields[1] = StructFieldEntry { name_id: ir_intern_name(make_name("variance")), index: 1, is_float: 1, elem_type_name_id: ir_intern_name(ir_empty_name()), word_scalar_array_len: 0, named_type_name_id: 0 }
    fields[2] = StructFieldEntry { name_id: ir_intern_name(make_name("confidence")), index: 2, is_float: 1, elem_type_name_id: ir_intern_name(ir_empty_name()), word_scalar_array_len: 0, named_type_name_id: 0 }
    // `epsilon` is a NAME, not a fourth slot: it aliases `confidence` (index 2).
    // Both spellings denote the same quantity at the type level -- check.sio types
    // each as f64 -- and lean_single has always agreed at RUNTIME. Measured
    // 2026-08-28 under bin/souc-lean-single-x86_64:
    //     Knowledge { value: 12.5, epsilon: 0.5, provenance: "p" }
    //     -> epsilon=0.500000  confidence=0.500000  value=12.500000
    // Without this entry the name misses the layout table entirely and every
    // caller -- field_idx_from_name, field_idx_from_name_simple and
    // field_idx_from_struct_literal_name alike -- falls through to the legacy
    // `(field_name.buf[0] as i64) % 64` hash, which sends `epsilon` to slot
    // 101 % 64 = 37. The struct literal then WRITES slot 37 and the read LOADS
    // slot 37, so the value round-trips through a slot nothing else touches and
    // `.epsilon` reads 0.0 (#1499) while `.confidence` reads the real number.
    // Silent wrong data on an epistemic type, which is the worst class here.
    //
    // Aliasing is safe because field_count bounds only NAME->index scans in this
    // table; nothing sizes an allocation from it. The reverse index->name scans
    // take the FIRST entry whose .index matches, and fields[2] precedes
    // fields[3], so slot 2 still reports itself as "confidence".
    fields[3] = StructFieldEntry { name_id: ir_intern_name(make_name("epsilon")), index: 2, is_float: 1, elem_type_name_id: ir_intern_name(ir_empty_name()), word_scalar_array_len: 0, named_type_name_id: 0 }
    // `provenance` needs an entry for the OPPOSITE reason: not to make a read
    // work -- check.sio rejects `.provenance` on Knowledge<T>, so the slot is
    // write-only -- but to stop the WRITE landing on somebody else.
    //
    // field_idx_from_struct_literal_name falls back to `default_idx`, which
    // lower_struct_fields_ref advances POSITIONALLY. So in
    // `Knowledge { value: .., epsilon: .., provenance: .. }` the unregistered
    // `provenance` took position 2 and overwrote the confidence slot with a
    // string pointer; read back as f64 that pointer is a subnormal and prints
    // 0.000000, which is why the corruption looked like a missing value rather
    // than a wrong one. Registering it here is what keeps the `epsilon` alias
    // above from being clobbered by the very next field in the literal.
    //
    // Index 3 is free: ir_alloc(dst, 0) buckets to 512 B = 64 slots
    // (native_v2_alloc_size_from_tag, tag 0), and the value channel is slots
    // 0..2. is_float is 0 -- the payload is a pointer, not a double.
    fields[4] = StructFieldEntry { name_id: ir_intern_name(make_name("provenance")), index: 3, is_float: 0, elem_type_name_id: ir_intern_name(ir_empty_name()), word_scalar_array_len: 0, named_type_name_id: 0 }
    t.entries[idx as usize] = StructLayoutEntry {
        type_name: make_name("Knowledge"),
        fields: fields,
        field_count: 5,
    }
    t.count = idx + 1
    t
}

// ---------------------------------------------------------------------------
// Stack peels for large Box materialisations (Lane B residual, 2026-08-13)
// ---------------------------------------------------------------------------
// `Box::new(ir_empty_module())` (and friends) evaluated as field initialisers
// of a single Lowerer { ... } literal keep several multi-MiB temps live at once:
//   IrModule            ~23 MiB  ([IrFunction; 16384] after instr arena)
//   StructLayoutTable   ~3.3 MiB
//   LowerLocalStack     ~1.6 MiB
// Concurrent peak ≈ 16 MiB inside lowerer_new alone — enough, with parent frames
// (epistemic section, frontend), to SEGV hello under a 32 MiB stack at
// `lower_array: seed_begin` (measured: fail 32 MiB, ok 48 MiB on madaros-peel3).
// Isolate each materialisation in its own function so only one large frame is
// live at a time; the returned Box is a pointer-sized value.
fn lowerer_box_empty_module() -> Box<IrModule> with Panic, Div, Alloc, Mut {
    Box::new(ir_empty_module())
}

fn lowerer_box_empty_function() -> Box<IrFunction> with Alloc, Mut {
    Box::new(ir_empty_function())
}

fn lowerer_box_empty_locals() -> Box<LowerLocalStack> with Alloc, Mut {
    Box::new(empty_lower_local_stack())
}

fn lowerer_box_empty_loop_labels() -> Box<LowerLoopLabels> with Alloc, Mut {
    Box::new(empty_lower_loop_labels())
}

fn lowerer_box_empty_enum_variants() -> Box<EnumVariantTable> with Alloc, Mut {
    Box::new(empty_enum_variant_table())
}

fn lowerer_box_empty_struct_layouts() -> Box<StructLayoutTable> with Alloc, Mut {
    Box::new(empty_struct_layout_table())
}

fn lowerer_box_empty_global_types() -> Box<LowerGlobalTypeTable> with Alloc, Mut {
    Box::new(empty_lower_global_type_table())
}

fn lowerer_box_empty_closure_caps() -> Box<ClosureCapTable> with Alloc, Mut {
    Box::new(empty_closure_cap_table())
}

fn lowerer_box_empty_epistemic_contests() -> Box<LowerEpistemicContestIndex> with Alloc, Mut {
    Box::new(empty_lower_epistemic_contest_index())
}

fn lowerer_box_clone_module(src: &IrModule) -> Box<IrModule> with Alloc, Mut {
    Box::new(*src)
}

fn lowerer_box_clone_enum_variants(src: &EnumVariantTable) -> Box<EnumVariantTable> with Alloc, Mut {
    Box::new(*src)
}

fn lowerer_box_clone_struct_layouts(src: &StructLayoutTable) -> Box<StructLayoutTable> with Alloc, Mut {
    Box::new(*src)
}

fn lowerer_box_clone_global_types(src: &LowerGlobalTypeTable) -> Box<LowerGlobalTypeTable> with Alloc, Mut {
    Box::new(*src)
}

fn lowerer_box_register_knowledge_layout(layouts: Box<StructLayoutTable>) -> Box<StructLayoutTable> with Alloc, Mut, Panic, Div {
    Box::new(ir_register_knowledge_layout(*layouts))
}


fn lowerer_new() -> Lowerer with Alloc, Mut, Panic, Div {
    lower_hard_error_reset()
    ir_wide_compile_pool_reset()
    // Sequential peels — one large Box::new frame at a time (see helpers above).
    let module = lowerer_box_empty_module()
    let epistemic_contests = lowerer_box_empty_epistemic_contests()
    let current_func = lowerer_box_empty_function()
    let locals = lowerer_box_empty_locals()
    let loop_labels = lowerer_box_empty_loop_labels()
    let enum_variants = lowerer_box_empty_enum_variants()
    let struct_layouts = lowerer_box_empty_struct_layouts()
    let global_types = lowerer_box_empty_global_types()
    let closure_caps = lowerer_box_empty_closure_caps()
    Lowerer {
        module: module,
        epistemic_contests: epistemic_contests,
        current_fn: IR_INVALID_FN,
        current_func: current_func,
        current_func_loaded: false,
        env: None,
        locals: locals,
        scope_depth: 0,
        loop_labels: loop_labels,
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: enum_variants,
        struct_layouts: struct_layouts,
        global_types: global_types,
        array_elem_float_regs: [IR_INVALID_REG; 512],
        array_elem_float_reg_count: 0,
        variance_base_regs: [IR_INVALID_REG; 1024],
        variance_value_regs: [IR_INVALID_REG; 1024],
        variance_base_reg_count: 0,
        debug_mode: false,
        probe_mode: false,
        closure_caps: closure_caps,
        pending_closure_fn_id: -1,
        allow_direct_capturing_closure_literal: false,
        pending_variance_reg: -1,
        fo_nchan: 0,
        fo_sigma2: [-1; 32],
        fo_expr_sens: [-1; 32],
        fo_pending_sens: [-1; 32],
        fo_bind_count: 0,
        fo_bind: Box::new(empty_lower_fo_bind_table()),
        so_enabled: false,
        so_expr_hess: [-1; 36],
        so_bind_hess: [-1; 576],
        fo_xfer_count: 0,
        fo_xfer_kind: [0; 64],
        fo_xfer_lit: [0.0; 64],
    }
}

fn lowerer_new_with_epistemic(epistemic: &IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    var lo = lowerer_new()
    // #1669: the module the codegen eventually sees is born one line up, in
    // lowerer_new's `module: Box::new(ir_empty_module())`. Nothing has touched it
    // yet here. If its untouched function slots already carry bits, the Box'd
    // value arrives dirty and no per-function field can be trusted; if they are
    // clean, something later dirties them and the search moves downstream.
    //
    // Placed HERE rather than inside lowerer_new because this function already
    // carries IO -- adding an effect to lowerer_new would cascade to its eight
    // callers, and effect cascades are what desynchronised the checker in #1649.
    if str_eq(read_env("SOUNIO_FLOAT_BITS_PROBE"), "1") {
        print("[float-bits] at_lowerer_new untouched8=")
        print_int(ir_module_count_float_bits_untouched(&(*lo.module), 8))
        print(" fn_count=")
        print_int((*lo.module).fn_count)
        // Apples-to-apples with the origin/main run: an EXISTING field with a
        // known default of 0. If this is clean while the new field is dirty, the
        // corruption is confined to the added field rather than general.
        var k: i64 = 0
        var dirty_ic: i64 = 0
        while k < 8 {
            if ir_fn_get(&(*lo.module), k as usize).instr_count != 0 { dirty_ic = dirty_ic + 1 }
            k = k + 1
        }
        print(" of8_nonzero_instr_count=")
        print_int(dirty_ic)
        print("\n")
    }
    (*lo.module).epistemic = (*epistemic)
    lo.epistemic_contests = lower_epistemic_contest_index_from_ref(epistemic)
    if lower_live_diag_enabled() {
        print("CONTEST_IR_INDEX_BIND constructor=initial contest_count=")
        print_int((*lo.epistemic_contests).contest_count)
        print("\n")
    }
    // Sprint 116: pre-register Knowledge<f64> layout
    // Peel: ir_register_knowledge_layout takes/returns StructLayoutTable by value (~3.3 MiB).
    // Isolate materialisation so lowerer_new_with_epistemic's frame stays small.
    lo.struct_layouts = lowerer_box_register_knowledge_layout(lo.struct_layouts)
    lo
}

fn lowerer_new_probe() -> Lowerer with Alloc, Mut, Panic, Div, IO {
    var lo = lowerer_new()
    lo.probe_mode = true
    // Sprint 116: pre-register Knowledge<f64> layout
    // Peel: ir_register_knowledge_layout takes/returns StructLayoutTable by value (~3.3 MiB).
    // Isolate materialisation so lowerer_new_with_epistemic's frame stays small.
    lo.struct_layouts = lowerer_box_register_knowledge_layout(lo.struct_layouts)
    lo
}

// Diagnostic gates, MEMOISED — and this is a memory fix, not a speed one.
//
// Each of these was `str_eq(read_env("..."), "1")`, evaluated at every call
// site. read_env allocates, the runtime allocator is a bump cursor with NO
// reclamation, and lowerer_lower_fn_item_mut alone calls
// lower_live_diag_enabled() NINE times per function. Measured with
// /proc/self/statm probes placed at the internal boundaries of that function,
// on a 50-function chain: ~56 KB of resident memory appears at nearly every
// mark, and the one thing between nearly every pair of marks is one of these
// gates. 9 x 56 KB = 504 KB of the ~688 KB each function was costing.
//
// There are 99 call sites of these five gates in this file. They are read once
// now; nothing reads the environment mid-compile, so caching cannot change a
// verdict. The CHECKED flag is separate from the value because "off" and
// "not yet read" must not be the same state.
var LOWER_DIAG_SUMMARY_ON: i64 = 0
var LOWER_DIAG_SUMMARY_CHECKED: i64 = 0

fn lower_summary_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_DIAG_SUMMARY_CHECKED == 0 {
        LOWER_DIAG_SUMMARY_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_SUMMARY_TRACE"), "1") {
            LOWER_DIAG_SUMMARY_ON = 1
        }
    }
    LOWER_DIAG_SUMMARY_ON == 1
}

var LOWER_DIAG_LIVE_ON: i64 = 0
var LOWER_DIAG_LIVE_CHECKED: i64 = 0

fn lower_live_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_DIAG_LIVE_CHECKED == 0 {
        LOWER_DIAG_LIVE_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_LIVE_TRACE"), "1") {
            LOWER_DIAG_LIVE_ON = 1
        }
    }
    LOWER_DIAG_LIVE_ON == 1
}

var LOWER_DIAG_BODY_ON: i64 = 0
var LOWER_DIAG_BODY_CHECKED: i64 = 0

var LOWER_RECV_TRACE_ON: i64 = 0
var LOWER_RECV_TRACE_CHECKED: i64 = 0

fn lower_recv_trace_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_RECV_TRACE_CHECKED == 0 {
        LOWER_RECV_TRACE_CHECKED = 1
        if str_eq(read_env("SOUNIO_RECV_TRACE"), "1") {
            LOWER_RECV_TRACE_ON = 1
        }
    }
    LOWER_RECV_TRACE_ON == 1
}

// Receiver SHAPE, for the one decision that turns a method call into a body-less
// function: `if recv_type.len > 0 { mangle(t, m) } else { m }`. An unresolved
// receiver emits the call against the BARE method name and invents a slot that
// nothing ever fills -- lower_method_recv_type says exactly this a few hundred
// lines below ("lowering invents a body-less `er_add` function"). Knowing WHICH
// shapes still fail is the difference between closing them and guessing.
fn lower_print_expr_kind(k: ExprKind) with IO, Mut, Panic, Div {
    if k == ExprKind::ExprIdent { print("ident") }
    else if k == ExprKind::ExprFieldAccess { print("field") }
    else if k == ExprKind::ExprCall { print("call") }
    else if k == ExprKind::ExprMethodCall { print("method_call") }
    else if k == ExprKind::ExprIndex { print("index") }
    else if k == ExprKind::ExprUnary { print("unary") }
    else if k == ExprKind::ExprPath { print("path") }
    else if k == ExprKind::ExprStructLit { print("struct_lit") }
    else if k == ExprKind::ExprBlock { print("block") }
    else if k == ExprKind::ExprIf { print("if") }
    else { print("other") }
}

fn lower_body_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_DIAG_BODY_CHECKED == 0 {
        LOWER_DIAG_BODY_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_BODY_TRACE"), "1") {
            LOWER_DIAG_BODY_ON = 1
        }
    }
    LOWER_DIAG_BODY_ON == 1
}

fn lower_body_trace_path() -> string {
    "/tmp/sounio_lower_body.trace"
}

fn lower_body_trace_append(msg: string) with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let pair0 = io_trace_append_string(buf, p, msg)
    buf = pair0.0
    p = pair0.1
    let pair1 = io_trace_append_byte(buf, p, 10)
    buf = pair1.0
    p = pair1.1
    let _ok = io_write_bytes_to_file(lower_body_trace_path(), buf, p)
}

var LOWER_DIAG_ORDERED_ON: i64 = 0
var LOWER_DIAG_ORDERED_CHECKED: i64 = 0

fn lower_ordered_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_DIAG_ORDERED_CHECKED == 0 {
        LOWER_DIAG_ORDERED_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_ORDERED_TRACE"), "1") {
            LOWER_DIAG_ORDERED_ON = 1
        }
    }
    LOWER_DIAG_ORDERED_ON == 1
}

var LOWER_DIAG_AGG_ON: i64 = 0
var LOWER_DIAG_AGG_CHECKED: i64 = 0

fn lower_aggregate_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if LOWER_DIAG_AGG_CHECKED == 0 {
        LOWER_DIAG_AGG_CHECKED = 1
        if str_eq(read_env("SOUNIO_LOWER_AGG_TRACE"), "1") {
            LOWER_DIAG_AGG_ON = 1
        }
    }
    LOWER_DIAG_AGG_ON == 1
}

// ─── Sabotage hooks: a witness that never fails is not a witness ────────────
//
// codegen_x86_linux.sio has carried exactly one of these since the i256 work
// (SOUNIO_WIDE_MUL_SABOTAGE), with the right comment above it. One hook means
// the witness gate can only certify one family: run an epistemic fixture under
// it and the sabotage is inert, the fixture passes anyway, and the gate --
// correctly -- refuses to certify. It was the only instrument in a long night
// that told the truth about its own limits, and it was ignored four times
// because there was no way to give it what it asked for.
//
// These hooks exist so a witness can declare, in its own header, the specific
// mutilation it claims to detect. The gate then reads that declaration instead
// of knowing about domains. A witness that declares nothing is not failed --
// it is counted as UNVERIFIED, which is the honest state for most of them.
//
// Memoised for the reason in the block above: read_env allocates and the bump
// allocator never reclaims. CHECKED is separate from the value because "off"
// and "not read yet" are different states.

var SAB_QUOTIENT_HESSIAN_ON: i64 = 0
var SAB_QUOTIENT_HESSIAN_CHECKED: i64 = 0

// Restores the pre-#2144 behaviour: division clears the Hessian instead of
// applying the quotient rule. Kills any witness that asserts a non-zero
// second-order term for a ratio.
fn sab_quotient_hessian() -> bool with IO, Mut, Panic, Div {
    if SAB_QUOTIENT_HESSIAN_CHECKED == 0 {
        SAB_QUOTIENT_HESSIAN_CHECKED = 1
        if str_eq(read_env("SOUNIO_SABOTAGE_QUOTIENT_HESSIAN"), "1") {
            SAB_QUOTIENT_HESSIAN_ON = 1
        }
    }
    SAB_QUOTIENT_HESSIAN_ON == 1
}

var SAB_HESSIAN_CHAIN_ON: i64 = 0
var SAB_HESSIAN_CHAIN_CHECKED: i64 = 0

// Drops the transcendental chain rule, so hessian_of(sin(x)) returns the
// confident 0.0 it returned before #2119. Kills any witness that asserts a
// second-order term through sin, cos or exp.
fn sab_hessian_chain() -> bool with IO, Mut, Panic, Div {
    if SAB_HESSIAN_CHAIN_CHECKED == 0 {
        SAB_HESSIAN_CHAIN_CHECKED = 1
        if str_eq(read_env("SOUNIO_SABOTAGE_HESSIAN_CHAIN"), "1") {
            SAB_HESSIAN_CHAIN_ON = 1
        }
    }
    SAB_HESSIAN_CHAIN_ON == 1
}

var SAB_CORRELATE_RHO_ON: i64 = 0
var SAB_CORRELATE_RHO_CHECKED: i64 = 0

// Discards every recorded correlation, so the covariance matrix stays zero and
// the propagation silently reverts to assuming independence. Kills any witness
// that asserts a cross term.
fn sab_correlate_rho() -> bool with IO, Mut, Panic, Div {
    if SAB_CORRELATE_RHO_CHECKED == 0 {
        SAB_CORRELATE_RHO_CHECKED = 1
        if str_eq(read_env("SOUNIO_SABOTAGE_CORRELATE_RHO"), "1") {
            SAB_CORRELATE_RHO_ON = 1
        }
    }
    SAB_CORRELATE_RHO_ON == 1
}

fn ir_normalize_string_literal_name(n: Name) -> Name {
    var out = ir_empty_name()
    var start: i64 = 0
    var end = n.len
    if n.len >= 2 && n.buf[0] == 34 as i8 && n.buf[(n.len - 1) as usize] == 34 as i8 {
        start = 1
        end = n.len - 1
    }
    var i = start
    while i < end && out.len < 128 {
        let ch = n.buf[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let nxt = n.buf[(i + 1) as usize]
            if nxt == 110 as i8 {
                out.buf[out.len as usize] = 10 as i8
            } else if nxt == 116 as i8 {
                out.buf[out.len as usize] = 9 as i8
            } else if nxt == 114 as i8 {
                out.buf[out.len as usize] = 13 as i8
            } else if nxt == 34 as i8 {
                out.buf[out.len as usize] = 34 as i8
            } else if nxt == 92 as i8 {
                out.buf[out.len as usize] = 92 as i8
            } else {
                out.buf[out.len as usize] = nxt
            }
            out.len = out.len + 1
            i = i + 2
        } else {
            out.buf[out.len as usize] = ch
            out.len = out.len + 1
            i = i + 1
        }
    }
    out
}

fn lower_span_matches_metadata(probe_mode: bool, span: Span, start: i64, end: i64) -> bool {
    if probe_mode {
        return false
    }
    start == span.start && end == span.end
}

fn lowerer_find_hyper_expr_id_for_span_ref(lo: &Lowerer, span: Span) -> i64 with Mut, Panic, Div {
    if (*(*lo).module).epistemic.hyper_expr_count <= 0 {
        return -1
    }
    var i: i64 = 0
    while i < (*(*lo).module).epistemic.hyper_expr_count {
        let info = (*(*lo).module).epistemic.hyper_exprs[i as usize]
        if lower_span_matches_metadata((*lo).probe_mode, span, info.span_start, info.span_end) {
            return i
        }
        i = i + 1
    }
    -1
}

// Metadata-sensitive lowering reads the compiler-owned bounded index. An
// unqualified index is the explicit legacy/flat path, never implicit proof of
// metadata absence.
fn lowerer_find_contest_id_for_span_index_ref(lo: &Lowerer, span: Span) -> i64 with Mut, Panic, Div, IO {
    if !(*(*lo).epistemic_contests).qualified {
        if lower_live_diag_enabled() {
            print("CONTEST_IR_LOOKUP_RESULT contest_id=-1 source=unqualified\n")
        }
        return -1
    }

    let contest_count = (*(*lo).epistemic_contests).contest_count
    if lower_live_diag_enabled() {
        print("CONTEST_IR_LOOKUP_ENTER contest_count=")
        print_int(contest_count)
        print("\n")
    }
    if contest_count < 0 || contest_count > IR_MAX_EPI_CONTESTS {
        if lower_live_diag_enabled() {
            print("CONTEST_IR_INDEX_INVALID contest_count=")
            print_int(contest_count)
            print(" max=")
            print_int(IR_MAX_EPI_CONTESTS)
            print("\n")
        }
        panic("lowerer: invalid frontend epistemic contest_count")
    }

    var i: i64 = 0
    while i < contest_count {
        let span_start = (*(*lo).epistemic_contests).span_starts[i as usize]
        let span_end = (*(*lo).epistemic_contests).span_ends[i as usize]
        if lower_live_diag_enabled() {
            print("CONTEST_IR_LOOKUP_CANDIDATE contest_id=")
            print_int(i)
            print(" span_start=")
            print_int(span_start)
            print(" span_end=")
            print_int(span_end)
            print("\n")
        }
        if lower_span_matches_metadata((*lo).probe_mode, span, span_start, span_end) {
            if lower_live_diag_enabled() {
                print("CONTEST_IR_LOOKUP_RESULT contest_id=")
                print_int(i)
                print(" contest_count=")
                print_int(contest_count)
                print("\n")
            }
            return i
        }
        i = i + 1
    }
    if lower_live_diag_enabled() {
        print("CONTEST_IR_LOOKUP_RESULT contest_id=-1 contest_count=")
        print_int(contest_count)
        print("\n")
    }
    -1
}

fn lowerer_lookup_fn_id_by_name_ref(lo: &Lowerer, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*(*lo).module).fn_count {
        if ir_name_eq(ir_fn_get(&(*(*lo).module), i as usize).name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn ir_empty_program_summary() -> IrProgramSummary with Panic, Div, Alloc, Mut, IO {
    // Sequential peels — same concurrent-temp hazard as lowerer_new.
    // Effects: Box::new peels require Alloc+Mut (E035 if omitted — measured
    // on fixed-point gate: 4× E035 from this function alone).
    let module = lowerer_box_empty_module()
    let enum_variants = lowerer_box_empty_enum_variants()
    let struct_layouts = lowerer_box_empty_struct_layouts()
    let global_types = lowerer_box_empty_global_types()
    IrProgramSummary {
        module: module,
        enum_variants: enum_variants,
        struct_layouts: struct_layouts,
        global_types: global_types,
        probe_mode: false,
    }
}

fn ir_empty_program_summary_flat() -> IrProgramSummaryFlat with Alloc, Panic, Div, Mut {
    IrProgramSummaryFlat {
        module: ir_empty_module(),
        enum_variants: empty_enum_variant_table(),
        struct_layouts: empty_struct_layout_table(),
        global_types: empty_lower_global_type_table(),
        probe_mode: false,
    }
}

fn ir_program_summary_from_lowerer(lo: Lowerer) -> IrProgramSummary {
    IrProgramSummary {
        module: lo.module,
        enum_variants: lo.enum_variants,
        struct_layouts: lo.struct_layouts,
        global_types: lo.global_types,
        probe_mode: lo.probe_mode,
    }
}

fn lowerer_seed_module_from_summary(lo_in: Lowerer, summary: &IrProgramSummary) -> Lowerer with Alloc, Mut, Panic, Div {
    var lo = lo_in
    var module_box = lo.module
    let sm_fn_count = (*summary.module).fn_count
    (*module_box).fn_count = sm_fn_count
    (*module_box).string_count = 0
    (*module_box).prof_counter_count = (*summary.module).prof_counter_count
    (*module_box).bss_total_size = (*summary.module).bss_total_size

    var i: i64 = 0
    while i < (*summary.module).prof_counter_count && i < 64 {
        (*module_box).prof_counters[i as usize] = (*summary.module).prof_counters[i as usize]
        i = i + 1
    }

    i = 0
    while i < (*summary.module).fn_count && i < IR_MAX_FUNCS {
        let sm_strat = ir_fn_get(&(*summary.module), i as usize).compile_strategy
        var func = ir_empty_function()
        func.name = ir_fn_get(&(*summary.module), i as usize).name
        func.param_count = ir_fn_get(&(*summary.module), i as usize).param_count
        func.compile_strategy = sm_strat
        func.returns_float = ir_fn_get(&(*summary.module), i as usize).returns_float
        func.return_fixed_array_len = ir_fn_get(&(*summary.module), i as usize).return_fixed_array_len
        func.return_struct_name = ir_fn_get(&(*summary.module), i as usize).return_struct_name
        func.prof_counter_id = ir_fn_get(&(*summary.module), i as usize).prof_counter_id
        func.hyper_algebra_kind = ir_fn_get(&(*summary.module), i as usize).hyper_algebra_kind
        func.bss_size = ir_fn_get(&(*summary.module), i as usize).bss_size
        func.first_param_is_ref = ir_fn_get(&(*summary.module), i as usize).first_param_is_ref
        // Preserve element-list init words packed into BSS slot instrs[]
        // (count>1 → per-element stores in emit_global_var_inits_into).
        let ic = ir_fn_get(&(*summary.module), i as usize).instr_count
        if ic > 0 {
            var ji: i64 = 0
            while ji < ic && ji < IR_MAX_INSTRS {
                ir_arena_copy_slot(ir_region_slot_w(func.region, (ji)),ir_region_slot_r(ir_fn_get(&(*summary.module), i as usize).region, (ji)))
                ji = ji + 1
            }
            func.instr_count = ic
        }
        if func.region.slot < 0 { ir_function_alloc_region(&! func) }
        ir_fn_set(&! (*module_box), i as usize, func)
        i = i + 1
    }
    lo.module = module_box
    lo
}

fn lowerer_seed_metadata_from_summary(lo_in: Lowerer, summary: &IrProgramSummary) -> Lowerer with Mut, Panic, Div {
    var lo = lo_in
    // Mutate boxed tables in place — do NOT unbox to stack (`var t = *lo.table`
    // materialises EnumVariantTable / StructLayoutTable / LowerGlobalTypeTable,
    // multi-MiB each) then Box::new again.
    (*lo.enum_variants).count = 0
    var vi: i64 = 0
    // Bound raised with the table. NOT made loud, and the reason is worth keeping:
    // `lowerer_seed_metadata_from_summary` has no callers anywhere in self-hosted/
    // -- grep finds its definition and nothing else. A refusal printed here would
    // never execute, and adding the IO effect its signature lacks would be effect
    // churn on dead code. (I added one, and the compiler refused the build with
    // E035 missing IO, which is how the deadness surfaced.) The live enum-capacity
    // guard is the one at the preseed site below.
    while vi < (*summary.enum_variants).count && vi < 4096 {
        (*lo.enum_variants).entries[vi as usize] = (*summary.enum_variants).entries[vi as usize]
        vi = vi + 1
    }
    (*lo.enum_variants).count = vi

    (*lo.struct_layouts).count = 0
    var si: i64 = 0
    while si < (*summary.struct_layouts).count && si < 1024 {
        var entry = empty_struct_layout_entry()
        entry.type_name = (*summary.struct_layouts).entries[si as usize].type_name
        entry.field_count = (*summary.struct_layouts).entries[si as usize].field_count
        var fi: i64 = 0
        while fi < entry.field_count && fi < 128 {
            entry.fields[fi as usize] = (*summary.struct_layouts).entries[si as usize].fields[fi as usize]
            fi = fi + 1
        }
        (*lo.struct_layouts).entries[si as usize] = entry
        si = si + 1
    }
    (*lo.struct_layouts).count = si

    var gi: i64 = 0
    while gi < IR_MAX_FUNCS {
        (*lo.global_types).elem_kinds[gi as usize] = (*summary.global_types).elem_kinds[gi as usize]
        gi = gi + 1
    }
    lo
}

// Residual ref path (prefer lowerer_new_from_program_summary_owned on multi-mod).
// Wave10: densify the *live* summary module once — do not lowerer_new() an empty
// IrModule then seed while summary still holds the first (empty+live concurrent).
// Still one densify copy (ref cannot move); owned path reuses the Box with zero densify.
fn lowerer_new_from_program_summary(summary: &IrProgramSummary, epistemic: &IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    lower_hard_error_reset()
    // Sequential peels for large clones (same rationale as lowerer_new).
    var module_box = lowerer_box_clone_module(&(*(*summary).module))
    // Match seed/owned body path: rebuild string table during body lower.
    (*module_box).string_count = 0
    (*module_box).epistemic = (*epistemic)
    let epistemic_contests = lowerer_box_empty_epistemic_contests()
    let current_func = lowerer_box_empty_function()
    let locals = lowerer_box_empty_locals()
    let loop_labels = lowerer_box_empty_loop_labels()
    let enum_variants = lowerer_box_clone_enum_variants(&(*(*summary).enum_variants))
    let struct_layouts = lowerer_box_clone_struct_layouts(&(*(*summary).struct_layouts))
    let global_types = lowerer_box_clone_global_types(&(*(*summary).global_types))
    let closure_caps = lowerer_box_empty_closure_caps()
    var lo = Lowerer {
        module: module_box,
        epistemic_contests: epistemic_contests,
        current_fn: IR_INVALID_FN,
        current_func: current_func,
        current_func_loaded: false,
        env: None,
        locals: locals,
        scope_depth: 0,
        loop_labels: loop_labels,
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: enum_variants,
        struct_layouts: struct_layouts,
        global_types: global_types,
        array_elem_float_regs: [IR_INVALID_REG; 512],
        array_elem_float_reg_count: 0,
        variance_base_regs: [IR_INVALID_REG; 1024],
        variance_value_regs: [IR_INVALID_REG; 1024],
        variance_base_reg_count: 0,
        debug_mode: false,
        probe_mode: summary.probe_mode,
        closure_caps: closure_caps,
        pending_closure_fn_id: -1,
        allow_direct_capturing_closure_literal: false,
        pending_variance_reg: -1,
        fo_nchan: 0,
        fo_sigma2: [-1; 32],
        fo_expr_sens: [-1; 32],
        fo_pending_sens: [-1; 32],
        fo_bind_count: 0,
        fo_bind: Box::new(empty_lower_fo_bind_table()),
        so_enabled: false,
        so_expr_hess: [-1; 36],
        so_bind_hess: [-1; 576],
        fo_xfer_count: 0,
        fo_xfer_kind: [0; 64],
        fo_xfer_lit: [0.0; 64],
    }
    lo.epistemic_contests = lower_epistemic_contest_index_from_ref(epistemic)
    if lower_live_diag_enabled() {
        print("CONTEST_IR_INDEX_BIND constructor=summary_densify contest_count=")
        print_int((*lo.epistemic_contests).contest_count)
        print("\n")
    }
    lo
}

// Memory wall residual (post-#1319/#1336): body lower used to call lowerer_new()
// (full empty IrModule) then seed stubs from the summary module — a second full
// empty materialization per dep while the summary Box still held the first.
// Consume the owned summary and reuse its live Boxes. string_count is zeroed to
// match seed behaviour (body lower rebuilds the string table).
fn lowerer_new_from_program_summary_owned(summary: IrProgramSummary, epistemic: &IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    lower_hard_error_reset()
    // Reuse summary's live Boxes (no IrModule densify). Remaining empties
    // still go through sequential peels.
    let epistemic_contests = lowerer_box_empty_epistemic_contests()
    let current_func = lowerer_box_empty_function()
    let locals = lowerer_box_empty_locals()
    let loop_labels = lowerer_box_empty_loop_labels()
    let closure_caps = lowerer_box_empty_closure_caps()
    var lo = Lowerer {
        module: summary.module,
        epistemic_contests: epistemic_contests,
        current_fn: IR_INVALID_FN,
        current_func: current_func,
        current_func_loaded: false,
        env: None,
        locals: locals,
        scope_depth: 0,
        loop_labels: loop_labels,
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: summary.enum_variants,
        struct_layouts: summary.struct_layouts,
        global_types: summary.global_types,
        array_elem_float_regs: [IR_INVALID_REG; 512],
        array_elem_float_reg_count: 0,
        variance_base_regs: [IR_INVALID_REG; 1024],
        variance_value_regs: [IR_INVALID_REG; 1024],
        variance_base_reg_count: 0,
        debug_mode: false,
        probe_mode: summary.probe_mode,
        closure_caps: closure_caps,
        pending_closure_fn_id: -1,
        allow_direct_capturing_closure_literal: false,
        pending_variance_reg: -1,
        fo_nchan: 0,
        fo_sigma2: [-1; 32],
        fo_expr_sens: [-1; 32],
        fo_pending_sens: [-1; 32],
        fo_bind_count: 0,
        fo_bind: Box::new(empty_lower_fo_bind_table()),
        so_enabled: false,
        so_expr_hess: [-1; 36],
        so_bind_hess: [-1; 576],
        fo_xfer_count: 0,
        fo_xfer_kind: [0; 64],
        fo_xfer_lit: [0.0; 64],
    }
    (*lo.module).epistemic = (*epistemic)
    lo.epistemic_contests = lower_epistemic_contest_index_from_ref(epistemic)
    if lower_live_diag_enabled() {
        print("CONTEST_IR_INDEX_BIND constructor=summary_owned contest_count=")
        print_int((*lo.epistemic_contests).contest_count)
        print("\n")
    }
    // Match lowerer_seed_module_from_summary: body path rebuilds strings.
    (*lo.module).string_count = 0
    lo
}

// Wave11/13 memory wall: attach a Lowerer to the multi-mod *accumulator* so a
// dependency can preseed + body-lower directly into acc (no second full
// Box<IrModule> concurrent with acc). Preserves fn_count / string_table /
// epistemic / algebras / bss / exports — body lower appends/fills. Fresh
// metadata tables (structs/enums/globals) are rebuilt from extern + dep preseed.
fn lowerer_from_acc_module(module: Box<IrModule>) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    lower_hard_error_reset()
    let epistemic_contests = lowerer_box_empty_epistemic_contests()
    let current_func = lowerer_box_empty_function()
    let locals = lowerer_box_empty_locals()
    let loop_labels = lowerer_box_empty_loop_labels()
    let enum_variants = lowerer_box_empty_enum_variants()
    let struct_layouts = lowerer_box_empty_struct_layouts()
    let global_types = lowerer_box_empty_global_types()
    let closure_caps = lowerer_box_empty_closure_caps()
    var lo = Lowerer {
        module: module,
        epistemic_contests: epistemic_contests,
        current_fn: IR_INVALID_FN,
        current_func: current_func,
        current_func_loaded: false,
        env: None,
        locals: locals,
        scope_depth: 0,
        loop_labels: loop_labels,
        loop_depth: 0,
        error_count: 0,
        had_error: false,
        enum_variants: enum_variants,
        struct_layouts: struct_layouts,
        global_types: global_types,
        array_elem_float_regs: [IR_INVALID_REG; 512],
        array_elem_float_reg_count: 0,
        variance_base_regs: [IR_INVALID_REG; 1024],
        variance_value_regs: [IR_INVALID_REG; 1024],
        variance_base_reg_count: 0,
        debug_mode: false,
        probe_mode: false,
        closure_caps: closure_caps,
        pending_closure_fn_id: -1,
        allow_direct_capturing_closure_literal: false,
        pending_variance_reg: -1,
        fo_nchan: 0,
        fo_sigma2: [-1; 32],
        fo_expr_sens: [-1; 32],
        fo_pending_sens: [-1; 32],
        fo_bind_count: 0,
        fo_bind: Box::new(empty_lower_fo_bind_table()),
        so_enabled: false,
        so_expr_hess: [-1; 36],
        so_bind_hess: [-1; 576],
        fo_xfer_count: 0,
        fo_xfer_kind: [0; 64],
        fo_xfer_lit: [0.0; 64],
    }
    // Knowledge layout is required for epistemic field lowering; match
    // lowerer_new_with_epistemic. Do NOT wipe module.epistemic / strings.
    // Peel: ir_register_knowledge_layout takes/returns StructLayoutTable by value (~3.3 MiB).
    // Isolate materialisation so lowerer_new_with_epistemic's frame stays small.
    lo.struct_layouts = lowerer_box_register_knowledge_layout(lo.struct_layouts)
    if lower_live_diag_enabled() {
        print("CONTEST_IR_INDEX_BIND constructor=acc_attach contest_count=")
        print_int((*lo.epistemic_contests).contest_count)
        print("\n")
    }
    lo
}

// True if `name` already has a lowered body in the lowerer's module (DEDUP).
// MUST extract Box<IrModule> to a local first: nested `(*(*lo).module).field`
// reads hit the documented lean_single Box-nested ref hazard.
fn lowerer_name_has_body_mut(lo: &! Lowerer, name: Name) -> bool with Mut, Panic, Div {
    var module_box = (*lo).module
    var has: bool = false
    var i: i64 = 0
    while i < (*module_box).fn_count {
        if ir_name_eq(ir_fn_get(&(*module_box), i as usize).name, name) {
            if ir_fn_get(&(*module_box), i as usize).instr_count > 0 {
                has = true
            }
            (*lo).module = module_box
            return has
        }
        i = i + 1
    }
    (*lo).module = module_box
    false
}

// Wave11 into-acc: stdlib modules ship test `main`s (gum/knowledge). Never
// re-lower `main` into the accumulator — the seed program owns the entry.
fn lowerer_name_is_main(name: Name) -> bool {
    name.len == 4
        && (name.buf[0] as i64) == 109
        && (name.buf[1] as i64) == 97
        && (name.buf[2] as i64) == 105
        && (name.buf[3] as i64) == 110
}

fn lowerer_dep_should_skip_fn_mut(lo: &! Lowerer, name: Name) -> bool with Mut, Panic, Div {
    if lowerer_name_is_main(name) {
        return true
    }
    lowerer_name_has_body_mut(lo, name)
}

// Preseed a dep fn signature into acc, but never clobber an already-lowered body.
fn lowerer_preseed_fn_signature_dedup_mut(
    lo: &! Lowerer,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) with Mut, Panic, Div, Alloc, IO {
    if lowerer_name_has_body_mut(lo, name) {
        return
    }
    lowerer_preseed_fn_signature_mut(lo, name, params, return_type, effects)
}

fn lowerer_preseed_impl_method_summaries_dedup_mut(
    lo: &! Lowerer,
    type_name: Name,
    methods: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc, IO {
    var current = methods
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_preseed_fn_signature_dedup_mut(
                                    lo,
                                    mangled,
                                    &(*fd).params,
                                    &(*fd).return_type,
                                    &(*fd).effects
                                )
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Preseed a dependency's items into the accumulator. Skips names that already
// have bodies (DEDUP). Skips re-allocating BSS slots that already exist.
fn lowerer_preseed_dep_items_into_acc_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                if kind == ItemKind::ItemFn {
                    if !ir_name_eq(name, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                if !lowerer_dep_should_skip_fn_mut(lo, name) {
                                    let fn_id_sig = lowerer_find_or_add_fn_id_mut(lo, name)
                                    if fn_id_sig >= 0 {
                                        let strategy_sig = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                        var module_box_sig = (*lo).module
                                        var fn_slot_sig = ir_fn_get(&(*module_box_sig), fn_id_sig as usize)
                                        fn_slot_sig.compile_strategy = strategy_sig
                                        fn_slot_sig.returns_float = lower_opt_return_float_code(&(*fd).return_type)
                                        fn_slot_sig.return_fixed_array_len = lower_opt_type_return_fixed_array_code(&(*fd).return_type)
                                        fn_slot_sig.return_struct_name = lower_opt_type_return_layout_name(&(*fd).return_type)
                                        fn_slot_sig.param_count = ir_param_list_count_ref(&(*fd).params)
                                        fn_slot_sig.first_param_is_ref = lower_fn_first_param_is_ref(&(*fd).params)
                                        if strategy_sig == IR_STRATEGY_INSTRUMENTED {
                                            fn_slot_sig.param_count = fn_slot_sig.param_count + 1
                                            if fn_slot_sig.prof_counter_id < 0 {
                                                let ctr_idx_sig = (*module_box_sig).prof_counter_count
                                                if ctr_idx_sig < 64 {
                                                    (*module_box_sig).prof_counters[ctr_idx_sig as usize] = IrProfCounterInfo {
                                                        fn_id: fn_id_sig,
                                                        fn_name: name,
                                                        counter_id: ctr_idx_sig,
                                                    }
                                                    (*module_box_sig).prof_counter_count = ctr_idx_sig + 1
                                                    fn_slot_sig.prof_counter_id = ctr_idx_sig
                                                } else {
                                                    lo.error_count = lo.error_count + 1
                                                    lo.had_error = true
                                                    lower_note_error(1569, (*lo.current_func).name)
                                                }
                                            }
                                        }
                                        if fn_slot_sig.region.slot < 0 { ir_function_alloc_region(&! fn_slot_sig) }
                                        ir_fn_set(&! (*module_box_sig), fn_id_sig as usize, fn_slot_sig)
                                        (*lo).module = module_box_sig
                                    }
                                    let fn_id_ps = lowerer_find_or_add_fn_id_mut(lo, name)
                                    if fn_id_ps >= 0 {
                                        if (*fd).is_kernel {
                                            var mbox_k = (*lo).module
                                            var slot_k = ir_fn_get(&(*mbox_k), fn_id_ps as usize)
                                            slot_k.compile_strategy = 6
                                            if slot_k.region.slot < 0 { ir_function_alloc_region(&! slot_k) }
                                            ir_fn_set(&! (*mbox_k), fn_id_ps as usize, slot_k)
                                            (*lo).module = mbox_k
                                        } else if visibility_to_bool(head.visibility) {
                                            var mbox_e = (*lo).module
                                            var slot_e = ir_fn_get(&(*mbox_e), fn_id_ps as usize)
                                            slot_e.compile_strategy = 7
                                            if slot_e.region.slot < 0 { ir_function_alloc_region(&! slot_e) }
                                            ir_fn_set(&! (*mbox_e), fn_id_ps as usize, slot_e)
                                            let exp_count = (*mbox_e).export_count
                                            if exp_count < 64 {
                                                (*mbox_e).export_names[exp_count as usize] = name
                                                (*mbox_e).export_count = exp_count + 1
                                            }
                                            (*lo).module = mbox_e
                                        }
                                    }
                                }
                            }
                            _ => {
                                // BSS / global var slot. Do not re-allocate if name exists.
                                // Wave15 D: even when the slot already lives in acc (seed
                                // Wave13 external BSS preseed), re-bind the type table entry
                                // for THIS into-acc lowerer. lowerer_from_acc_module starts
                                // with empty global_types; skipping the record left f64 BSS
                                // Ident loads without ir_mark_float_reg → cvtsi2sd of IEEE
                                // bits on DE+1.0 / lognormal_pdf (DE_LN_SQRT_2PI) → ~1e-300.
                                let existing = lowerer_lookup_fn_id_by_name_ref(lo, name)
                                if existing < 0 {
                                    let bss_fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
                                    if bss_fn_id >= 0 {
                                        lowerer_record_global_type_mut(lo, bss_fn_id, &head.type_alias_ty)
                                        var mbox2 = (*lo).module
                                        var bss_slot = ir_fn_get(&(*mbox2), bss_fn_id as usize)
                                        let bss_off = (*mbox2).bss_total_size
                                        let bss_size = lower_typeexpr_byte_size(&head.type_alias_ty)
                                        let aligned_size = ((bss_size + 7) / 8) * 8
                                        bss_slot.compile_strategy = 99
                                        bss_slot.param_count = bss_off
                                        bss_slot.bss_size = bss_size
                                        bss_slot.hyper_algebra_kind = lower_typeexpr_bss_elem_size(&head.type_alias_ty)
                                        lower_apply_global_var_init(&! bss_slot, name)
                                        if bss_slot.region.slot < 0 { ir_function_alloc_region(&! bss_slot) }
                                        ir_fn_set(&! (*mbox2), bss_fn_id as usize, bss_slot)
                                        (*mbox2).bss_total_size = bss_off + aligned_size
                                        (*lo).module = mbox2
                                    }
                                } else {
                                    if existing < (*(*lo).module).fn_count
                                        && ir_fn_get(&(*(*lo).module), existing as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL
                                    {
                                        lowerer_record_global_type_mut(lo, existing, &head.type_alias_ty)
                                    }
                                }
                            }
                        }
                    }
                } else if kind == ItemKind::ItemStruct {
                    let struct_def_opt_ref: &Option<Box<StructDef>> = &head.struct_def
                    match *struct_def_opt_ref {
                        Some(sd) => {
                            lowerer_register_struct_fields_direct_mut(lo, name, &(*sd).fields)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    let enum_def_opt_ref: &Option<Box<EnumDef>> = &head.enum_def
                    match *enum_def_opt_ref {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            lowerer_preseed_impl_method_summaries_dedup_mut(lo, name, &(*id).methods, skip_name)
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Body-lower dep items into acc, skipping names that already have bodies (DEDUP)
// and dep test `main`. ItemImpl methods are lowered one-by-one via the same
// lowerer_lower_fn_item_mut path free functions use (A14-friendly, no Option
// by-value of ImplDef).
fn lowerer_lower_program_bodies_dedup_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    // Seed the transcendental chain-rule entries here, on the LIVE path.
    //
    // fo_xfer_global_reset() (:3578, :9019) looked like the initialisation point
    // and is not: a single-module compile reaches lowering through this function,
    // and seeding from the reset produced zero effect — verified with an
    // unconditional print that never fired, and with SOUNIO_LOWER_LIVE_TRACE
    // showing `fo_xfer_miss name=sin count=0`, an empty table at lookup time.
    // Multi-pass FO pre-register for this dep's pure fns (reverse-order expand).
    // Do not reset FO_XFER here: the frontend multi-mod prepass may already
    // hold imported helpers.
    lowerer_fo_preregister_pure_fns_multipass_mut(lo, items)
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                if kind == ItemKind::ItemFn {
                    if !lowerer_dep_should_skip_fn_mut(lo, name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(lo, name, &(*fd))
                            }
                            _ => {}
                        }
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            var mcur = &(*id).methods
                            while true {
                                match *mcur {
                                    Some(mlist) => {
                                        let mhead = &(*mlist).head
                                        if mhead.kind == ItemKind::ItemFn {
                                            let mangled = ir_mangle_method_name(name, mhead.name)
                                            if !lowerer_dep_should_skip_fn_mut(lo, mangled) {
                                                let mfd_opt: &Option<Box<FnDef>> = &mhead.fn_def
                                                match *mfd_opt {
                                                    Some(fd) => {
                                                        lowerer_lower_fn_item_mut(lo, mangled, &(*fd))
                                                    }
                                                    _ => {}
                                                }
                                            }
                                        }
                                        mcur = &(*mlist).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Owned-summary body lowering keeps one Lowerer live and walks Item nodes by
// reference. The old method-return path kept both `lo` and `lo2` stack slots
// live across the call and copied each Item even though the AST is immutable.
fn lowerer_lower_program_bodies_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    // Keep the multi-module FO table: the frontend may have pre-registered
    // imported helpers before entering this module.
    lowerer_fo_preregister_pure_fns_multipass_mut(lo, items)
    var current = items
    var item_count: i64 = 0
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                item_count = item_count + 1
                if item_count > IR_MAX_FUNCS { return }
                if kind == ItemKind::ItemFn {
                    if lower_body_diag_enabled() {
                        lower_body_trace_append("body_list_fn name=" + str_from_bytes(name.buf, name.len))
                    }
                    let fn_def_ref = &head.fn_def
                    match *fn_def_ref {
                        Some(fd) => { lowerer_lower_fn_item_mut(lo, name, &(*fd)) }
                        None => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_ref = &head.impl_def
                    match *impl_def_ref {
                        Some(id) => { lowerer_lower_impl_methods_mut(lo, name, (*id).methods) }
                        None => {}
                    }
                }
                current = &(*list).tail
            }
            None => { break }
        }
    }
}

// Force-fill any remaining zero-body impl methods after the primary body pass.
// Residual after #1393 scaffolding: ItemImpl methods whose stubs were
// pre-created by seed extern preseed can stay ic=0 if flush silently no-ops.
// Re-attempt with explicit post-check (and flush fix above).
fn lowerer_force_fill_impl_methods_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemImpl {
                    let type_name = head.name
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            var mcur = &(*id).methods
                            while true {
                                match *mcur {
                                    Some(mlist) => {
                                        let mhead = &(*mlist).head
                                        if mhead.kind == ItemKind::ItemFn {
                                            let mangled = ir_mangle_method_name(type_name, mhead.name)
                                            if !lowerer_name_has_body_mut(lo, mangled) {
                                                let mfd_opt: &Option<Box<FnDef>> = &mhead.fn_def
                                                match *mfd_opt {
                                                    Some(fd) => {
                                                        lowerer_lower_fn_item_mut(lo, mangled, &(*fd))
                                                        if !lowerer_name_has_body_mut(lo, mangled) {
                                                            // Second attempt: by-value lower_impl single method path
                                                            // already used lowerer_lower_fn_item_mut; mark error so
                                                            // module_frontend can fall back to place+remap for this dep.
                                                            lo.error_count = lo.error_count + 1
                                                            lo.had_error = true
                                                            lower_note_error(1773, (*lo.current_func).name)
                                                            if str_eq(read_env("SOUNIO_INTO_ACC_TRACE"), "1") {
                                                                print("into_acc: force_fill_failed name=")
                                                                print(str_from_bytes(mangled.buf, mangled.len))
                                                                print("\n")
                                                            }
                                                        } else if str_eq(read_env("SOUNIO_INTO_ACC_TRACE"), "1") {
                                                            print("into_acc: force_fill_ok name=")
                                                            print(str_from_bytes(mangled.buf, mangled.len))
                                                            print("\n")
                                                        }
                                                    }
                                                    _ => {}
                                                }
                                            }
                                        }
                                        mcur = &(*mlist).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_new_from_program_summary_flat(summary: &IrProgramSummaryFlat, epistemic: IrEpistemicSection) -> Lowerer with Alloc, Mut, Panic, Div, IO {
    var lo = lowerer_new()
    var module_box = lo.module
    (*module_box).epistemic = epistemic
    (*module_box).fn_count = summary.module.fn_count
    (*module_box).string_count = 0
    (*module_box).prof_counter_count = summary.module.prof_counter_count
    (*module_box).bss_total_size = summary.module.bss_total_size

    var i: i64 = 0
    while i < summary.module.prof_counter_count && i < 64 {
        (*module_box).prof_counters[i as usize] = summary.module.prof_counters[i as usize]
        i = i + 1
    }

    i = 0
    while i < summary.module.fn_count && i < IR_MAX_FUNCS {
        var func = ir_empty_function()
        func.name = ir_fn_get(&summary.module, i as usize).name
        func.param_count = ir_fn_get(&summary.module, i as usize).param_count
        func.compile_strategy = ir_fn_get(&summary.module, i as usize).compile_strategy
        func.returns_float = ir_fn_get(&summary.module, i as usize).returns_float
        func.return_fixed_array_len = ir_fn_get(&summary.module, i as usize).return_fixed_array_len
        func.return_struct_name = ir_fn_get(&summary.module, i as usize).return_struct_name
        func.prof_counter_id = ir_fn_get(&summary.module, i as usize).prof_counter_id
        func.hyper_algebra_kind = ir_fn_get(&summary.module, i as usize).hyper_algebra_kind
        func.bss_size = ir_fn_get(&summary.module, i as usize).bss_size
        func.first_param_is_ref = ir_fn_get(&summary.module, i as usize).first_param_is_ref
        // Preserve element-list init words packed into BSS slot instrs[].
        let ic = ir_fn_get(&summary.module, i as usize).instr_count
        if ic > 0 {
            var ji: i64 = 0
            while ji < ic && ji < IR_MAX_INSTRS {
                ir_arena_copy_slot(ir_region_slot_w(func.region, (ji)),ir_region_slot_r(ir_fn_get(&summary.module, i as usize).region, (ji)))
                ji = ji + 1
            }
            func.instr_count = ic
        }
        if func.region.slot < 0 { ir_function_alloc_region(&! func) }
        ir_fn_set(&! (*module_box), i as usize, func)
        i = i + 1
    }
    lo.module = module_box
    lo.enum_variants = Box::new(summary.enum_variants)
    lo.struct_layouts = Box::new(summary.struct_layouts)
    lo.global_types = Box::new(summary.global_types)
    lo.probe_mode = summary.probe_mode
    lo
}

fn ir_param_list_count_ref(params: &Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = params
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            None => break
        }
    }
    count
}

fn ir_param_list_count(params: Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    ir_param_list_count_ref(&params)
}

fn lowerer_mark_error(lo: &! Lowerer) with Mut {
    lo.error_count = lo.error_count + 1
    lo.had_error = true
    lower_note_error(1876, (*lo.current_func).name)
}

fn lowerer_mark_hard_error(lo: &! Lowerer) with Mut {
    lowerer_mark_error(lo)
    IR_LOWER_HARD_ERROR = 1
    if IR_LOWER_HARD_ERROR_REASON == 0 {
        IR_LOWER_HARD_ERROR_REASON = 1
        IR_LOWER_HARD_ERROR_LIMIT = 0
        IR_LOWER_HARD_ERROR_NEEDED = 0
        ir_copy_name_to_flat(&(*lo.current_func).name, &! IR_LOWER_HARD_ERROR_FN_BUF, &! IR_LOWER_HARD_ERROR_FN_LEN)
    }
}

fn lowerer_effect_list_has_name_ref(effects: &Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
    var current = effects
    while true {
        match *current {
            Some(effect_node) => {
                let eff = &(*effect_node).head
                var matches = true
                let tlen = str_len(target)
                if eff.name_len != tlen {
                    matches = false
                } else {
                    var k: i64 = 0
                    while k < tlen {
                        if eff.name_buf[k as usize] != (str_char_at(target, k) as i8) {
                            matches = false
                        }
                        k = k + 1
                    }
                }
                if matches {
                    return true
                }
                current = &(*effect_node).tail
            }
            None => return false
        }
    }
    false
}

fn lowerer_compute_strategy_from_ast_ref(
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) -> i64 with Mut, Panic, Div {
    if lowerer_effect_list_has_name_ref(effects, "GPU") {
        return IR_STRATEGY_GPU_KERNEL
    }
    if lowerer_effect_list_has_name_ref(effects, "Prob") {
        return IR_STRATEGY_PROBABILISTIC
    }
    // A-layer-2: a `with Chaotic` function integrates a chaotic vector field, so the
    // e-graph must refuse float reassociation on it (dominates the return-type strategy).
    if lowerer_effect_list_has_name_ref(effects, "Chaotic") {
        return IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC
    }

    match *return_type {
        Some(type_node) => {
            let rk = (*type_node).kind
            if rk == TypeExprKind::TypeValidated {
                IR_STRATEGY_AGGRESSIVE
            } else if rk == TypeExprKind::TypeKnowledge {
                IR_STRATEGY_PRECISION_PRESERVING
            } else if rk == TypeExprKind::TypeContest || rk == TypeExprKind::TypeRobust {
                IR_STRATEGY_INSTRUMENTED
            } else {
                IR_STRATEGY_STANDARD
            }
        }
        None => IR_STRATEGY_STANDARD,
    }
}

fn lowerer_find_or_add_fn_id_mut(lo: &! Lowerer, name: Name) -> i64 with Mut, Panic, Div, Alloc {
    var module_box = (*lo).module
    var i: i64 = 0
    let n = (*module_box).fn_count
    var scan_lim = n
    if scan_lim > IR_MAX_FUNCS { scan_lim = IR_MAX_FUNCS }
    if scan_lim < 0 { scan_lim = 0 }
    while i < scan_lim {
        if ir_name_eq(ir_fn_get(&(*module_box), i as usize).name, name) {
            (*lo).module = module_box
            return i
        }
        i = i + 1
    }

    if n >= IR_MAX_FUNCS || n < 0 {
        (*lo).module = module_box
        lowerer_mark_error(lo)
        return -1
    }

    let idx = n
    // Grow heap box pool if this index is past the prefill watermark.
    ir_fn_pool_ensure(&(*module_box), idx)
    var fn_slot = ir_fn_get(&(*module_box), idx as usize)
    fn_slot.name = name
    // Slots are NOT recycled dirty: IR_FLOAT_BITS_INHERITED, which accumulates
    // the popcount of every slot at the moment it is allocated and before
    // anything writes it, reads 0 across runs that lower 5 functions. The clear
    // I put here on that theory was dead code and is gone; the counter stays,
    // because it is what proved the theory wrong and would catch it becoming
    // true. The real defect was in the instrument -- see the hoists in
    // ir_module_count_float_bits.
    IR_FLOAT_BITS_INHERITED = IR_FLOAT_BITS_INHERITED + ir_function_count_float_bits(&fn_slot)
    // #1649: give this function its OWN region. It cannot be done in
    // ir_empty_function(): `[ir_empty_function(); 2048]` evaluates once and
    // copies, so every slot in a fresh module would share one region and the
    // functions would overwrite each other's instructions.
    ir_function_alloc_region(&! fn_slot)
    if fn_slot.region.slot < 0 { ir_function_alloc_region(&! fn_slot) }
    ir_fn_set(&! (*module_box), idx as usize, fn_slot)
    (*module_box).fn_count = idx + 1
    (*lo).module = module_box
    idx
}

fn lowerer_flush_current_func_mut(lo: &! Lowerer) with Mut, Panic, Div {
    // Extract Box first: nested `(*(*lo).module).fn_count` is the documented
    // lean_single Box-nested-ref hazard (garbage fn_count → silent no-op flush
    // → stubs stay ic=0). Same extract-to-local idiom as preseed / into-acc.
    if (*lo).current_func_loaded && (*lo).current_fn >= 0 {
        var module_box = (*lo).module
        if (*lo).current_fn < (*module_box).fn_count {
            ir_fn_set(&! (*module_box), (*lo).current_fn as usize, *(*lo).current_func)
        }
        (*lo).module = module_box
    }
    (*lo).current_func_loaded = false
}

fn lowerer_preseed_fn_signature_mut(
    lo: &! Lowerer,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) with Mut, Panic, Div, Alloc, IO {
    let fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
    if fn_id < 0 {
        return
    }

    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    // Extract module Box + function slot to locals, mutate, write back once. The
    // direct nested-lvalue form `ir_fn_get(&(*(*lo).module), fn_id).field = X` — notably
    // the 512-byte aggregate store `.param_regs = [IR_INVALID_REG; 64]` — is miscompiled
    // by lean_single (two-level-nested-store defect): the aggregate lvalue base is
    // wrong and the write SIGSEGVs. This impl-method-signature preseed is the only
    // caller, so it stayed latent until an imported module carried an `impl`. Safe
    // idiom matches lowerer_preseed_program_items_mut's ItemFn branch.
    var module_box = (*lo).module
    var fn_slot = ir_fn_get(&(*module_box), fn_id as usize)
    fn_slot.compile_strategy = strategy
    fn_slot.returns_float = lower_opt_return_float_code(return_type)
    fn_slot.return_fixed_array_len = lower_opt_type_return_fixed_array_code(return_type)
    fn_slot.return_struct_name = lower_opt_type_return_layout_name(return_type)
    fn_slot.param_count = ir_param_list_count_ref(params)
    fn_slot.first_param_is_ref = lower_fn_first_param_is_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        fn_slot.param_count = fn_slot.param_count + 1
        if fn_slot.prof_counter_id < 0 {
            let ctr_idx = (*module_box).prof_counter_count
            if ctr_idx < 64 {
                (*module_box).prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                (*module_box).prof_counter_count = ctr_idx + 1
                fn_slot.prof_counter_id = ctr_idx
            } else {
                lo.error_count = lo.error_count + 1
                lo.had_error = true
                lower_note_error(2025, (*lo.current_func).name)
            }
        }
    }
    fn_slot.param_regs = [IR_INVALID_REG; 64]
    fn_slot.instr_count = 0
    fn_slot.reg_count = 0
    fn_slot.label_count = 0
    if fn_slot.region.slot < 0 { ir_function_alloc_region(&! fn_slot) }
    if fn_slot.region.slot < 0 { ir_function_alloc_region(&! fn_slot) }
    ir_fn_set(&! (*module_box), fn_id as usize, fn_slot)
    (*lo).module = module_box
}

var LOWER_ENUM_VARIANT_PTRS: [i64; 4096] = [0; 4096]

fn lower_collect_enum_variant_ptrs(variants: Option<Box<VariantDefList>>, count: i64) -> i64 with Mut, Alloc {
    if count >= 4096 { return count }
    match variants {
        Some(list) => {
            let ptr = list as *mut VariantDefList
            LOWER_ENUM_VARIANT_PTRS[count as usize] = ptr as i64
            lower_collect_enum_variant_ptrs((*list).tail, count + 1)
        }
        None => count,
    }
}

fn lowerer_register_enum_variants_mut(
    lo: &! Lowerer,
    enum_name: Name,
    variants: &Option<Box<VariantDefList>>,
    next_disc: i64
) with Mut, Panic, Div, Alloc, IO {
    let variant_count = lower_collect_enum_variant_ptrs(*variants, 0)
    var vi: i64 = 0
    while vi < variant_count {
        if (*(*lo).enum_variants).count >= 4096 {
            lo.error_count = lo.error_count + 1
            lo.had_error = true
            lower_note_error(2066, (*lo.current_func).name)
            return
        }
        let list = LOWER_ENUM_VARIANT_PTRS[vi as usize] as *mut VariantDefList
        var ev_box = (*lo).enum_variants
        let idx = (*ev_box).count
        (*ev_box).entries[idx as usize] = EnumVariantEntry {
            enum_name: enum_name,
            variant_name: (*list).head.name,
            discriminant: next_disc + vi,
        }
        (*ev_box).count = idx + 1
        (*lo).enum_variants = ev_box
        vi = vi + 1
    }
}

// Cross-module struct preseed: registers struct layouts from an external
// module's items into this lowerer's struct_layouts table. Without this,
// imported struct types (e.g. `use lib::{PublicStruct}` then `s.x`) fall
// back to a first-byte-hash field_idx and codegen emits wrong offsets at
// runtime.
fn lowerer_preseed_external_struct_items_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head_owned = (*list).head
                // Enums, seeded here for the same reason structs are, and missing
                // from this function alone. Its sibling
                // lowerer_preseed_external_struct_items_into_acc has carried this
                // branch — and a comment naming the exact symptom — since the day
                // 3140 unresolved identifiers were traced to it. The seed path
                // never got the fix, so a seed-module body could not resolve a
                // dep-module enum variant: `IrBinOp`, `OpAdd`, `TypeKnowledge`,
                // `ItemFn`. Measured on main before this line: 3740 lowering
                // errors, 3725 of them unresolved identifiers. After: 15, none of
                // them unresolved.
                if head_owned.kind == ItemKind::ItemEnum {
                    match head_owned.enum_def {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, head_owned.name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                }
                if head_owned.kind == ItemKind::ItemStruct {
                    match head_owned.struct_def {
                        Some(sd) => {
                            // Inline registration: lowerer_register_struct_fields_mut
                            // silently no-ops from this call site (suspected
                            // lean_single handling of &(*box).field through
                            // FieldDefList head). Build the layout entry directly.
                            var sl_box = (*lo).struct_layouts
                            let pre_count = (*sl_box).count
                            if pre_count < 1024 {
                                var entry = empty_struct_layout_entry()
                                entry.type_name = head_owned.name
                                var fc: i64 = 0
                                var fcur = (*sd).fields
                                var keep_going = true
                                while keep_going && fc < 128 {
                                    match fcur {
                                        Some(flist) => {
                                            entry.fields[fc as usize] = StructFieldEntry {
                                                name_id: ir_intern_name((*flist).head.name),
                                                index: fc,
                                                // Was hardcoded is_float:0, which mis-classified imported
                                                // struct f64 fields as int — cross-module reads of an
                                                // imported struct's f64 field emitted cvtsi2sd (int->double)
                                                // instead of a direct load, corrupting the value. Compute
                                                // the real class from the field type, matching
                                                // ir_fast_summary_register_struct_fields_owned.
                                                is_float: if lower_type_expr_is_f64(&(*flist).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*flist).head.ty) { 2 } else if lower_type_expr_is_integer(&(*flist).head.ty) { 3 } else if lower_type_expr_is_bool(&(*flist).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*flist).head.ty) { 4 } else { 0 },
                                                elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*flist).head.ty)),
                                                word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*flist).head.ty),
                                                named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*flist).head.ty)),
                                            }
                                            fc = fc + 1
                                            fcur = (*flist).tail
                                        }
                                        _ => { keep_going = false }
                                    }
                                }
                                entry.field_count = fc
                                (*sl_box).entries[pre_count as usize] = entry
                                (*sl_box).count = pre_count + 1
                                (*lo).struct_layouts = sl_box
                            }
                        }
                        _ => {}
                    }
                }
                // Also preseed imported FREE functions' signatures (returns_float /
                // return_struct_name), so the caller recognizes an imported fn's f64
                // return instead of treating the call result as int (cvtsi2sd). The
                // struct-only preseed above left free-function returns unclassified.
                if head_owned.kind == ItemKind::ItemFn {
                    let fn_def_opt_ref: &Option<Box<FnDef>> = &head_owned.fn_def
                    match *fn_def_opt_ref {
                        Some(fd) => {
                            lowerer_preseed_fn_signature_mut(lo, head_owned.name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
                // Root 2 multi-module: preseed mangled impl methods (Type_method)
                // so seed-module call sites resolve E_get with first_param_is_ref /
                // return_struct_name instead of inventing a body-less bare "get".
                if head_owned.kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head_owned.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            lowerer_preseed_impl_method_summaries_mut(lo, head_owned.name, &(*id).methods, ir_empty_name())
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Wave13: preseed module-level BSS globals from an external program into this
// lowerer. Required so seed (main) bare Idents of `use m::{CONST}` emit
// IrLoadGlobal against a real IR_STRATEGY_BSS_GLOBAL slot. Without this, the
// seed body is lowered before deps are merged, Ident misses the global, and
// report_error/emit_unit yields 0 at runtime (Wave12 explicit non-claim).
//
// Call only after own items are preseeded, and only for modules that will be
// merged *after* this one (seed: deps 1..n in order). That keeps BSS offsets
// aligned with the multi-mod merge layout (own BSS first, then each dep).
// Free-function / struct preseed stays in lowerer_preseed_external_struct_items_mut
// (no BSS allocation there).
fn lowerer_preseed_external_bss_globals_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                // Module-level `let G: T = ...` is ItemFn with fn_def = None
                // (same encoding as lowerer_preseed_program_items_mut).
                if head.kind == ItemKind::ItemFn {
                    let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                    match *fn_def_opt_ref {
                        Some(_fd) => {}
                        _ => {
                            let name = head.name
                            // Skip if this name already has a BSS slot (DEDUP
                            // across multi-import of the same leaf).
                            var already: i64 = 0 - 1
                            var fi: i64 = 0
                            let mref = (*lo).module
                            while fi < (*mref).fn_count {
                                if ir_name_eq(ir_fn_get(&(*mref), fi as usize).name, name)
                                    && ir_fn_get(&(*mref), fi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL
                                {
                                    already = fi
                                    fi = (*mref).fn_count
                                } else {
                                    fi = fi + 1
                                }
                            }
                            if already < 0 {
                                let bss_fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
                                if bss_fn_id >= 0 {
                                    lowerer_record_global_type_mut(lo, bss_fn_id, &head.type_alias_ty)
                                    var mbox = (*lo).module
                                    var bss_slot = ir_fn_get(&(*mbox), bss_fn_id as usize)
                                    let bss_off = (*mbox).bss_total_size
                                    let bss_size = lower_typeexpr_byte_size(&head.type_alias_ty)
                                    let aligned_size = ((bss_size + 7) / 8) * 8
                                    bss_slot.compile_strategy = IR_STRATEGY_BSS_GLOBAL
                                    bss_slot.param_count = bss_off
                                    bss_slot.bss_size = bss_size
                                    bss_slot.hyper_algebra_kind = lower_typeexpr_bss_elem_size(&head.type_alias_ty)
                                    lower_apply_global_var_init(&! bss_slot, name)
                                    if bss_slot.region.slot < 0 { ir_function_alloc_region(&! bss_slot) }
                                    ir_fn_set(&! (*mbox), bss_fn_id as usize, bss_slot)
                                    (*mbox).bss_total_size = bss_off + aligned_size
                                    (*lo).module = mbox
                                }
                            }
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Into-acc external preseed: same as lowerer_preseed_external_struct_items_mut
// but NEVER clobber a name that already has a body in acc. Without this, dep N+1
// re-preseeding dep N / seed `main` and ItemImpl methods zeros their instr_count
// (measured: user main ic=62 → 0; Epistemic_measured/val stay empty after gum).
fn lowerer_preseed_external_items_into_acc_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head_owned = (*list).head
                // ENUMS, ALONGSIDE STRUCTS. This preseed registered struct
                // layouts and nothing else, so lowering a dependency INTO THE
                // ACCUMULATOR left the enum variant table empty. Every
                // `SomeEnum::Variant` path then failed to resolve, fell through
                // to the identifier lookup, and reported the ENUM'S TYPE NAME as
                // an unresolved identifier:
                //
                //   into_acc failed at module index 1 of 120
                //   unresolved identifiers: `IrOpcode` `BinaryOp`
                //                           `TypeExprKind` `ItemKind` ...
                //
                // 3140 of them, all from one site, none of which said what was
                // missing until the name was recorded. Struct layouts were
                // seeded here from the start; enums were simply never added.
                if head_owned.kind == ItemKind::ItemEnum {
                    match head_owned.enum_def {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, head_owned.name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                }
                if head_owned.kind == ItemKind::ItemStruct {
                    match head_owned.struct_def {
                        Some(sd) => {
                            var sl_box = (*lo).struct_layouts
                            // Skip duplicate type_name entries in this lowerer's table.
                            var already: bool = false
                            var si: i64 = 0
                            while si < (*sl_box).count {
                                if ir_name_eq((*sl_box).entries[si as usize].type_name, head_owned.name) {
                                    already = true
                                }
                                si = si + 1
                            }
                            let pre_count = (*sl_box).count
                            if !already && pre_count < 1024 {
                                var entry = empty_struct_layout_entry()
                                entry.type_name = head_owned.name
                                var fc: i64 = 0
                                var fcur = (*sd).fields
                                var keep_going = true
                                while keep_going && fc < 128 {
                                    match fcur {
                                        Some(flist) => {
                                            entry.fields[fc as usize] = StructFieldEntry {
                                                name_id: ir_intern_name((*flist).head.name),
                                                index: fc,
                                                is_float: if lower_type_expr_is_f64(&(*flist).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*flist).head.ty) { 2 } else if lower_type_expr_is_integer(&(*flist).head.ty) { 3 } else if lower_type_expr_is_bool(&(*flist).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*flist).head.ty) { 4 } else { 0 },
                                                elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*flist).head.ty)),
                                                word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*flist).head.ty),
                                                named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*flist).head.ty)),
                                            }
                                            fc = fc + 1
                                            fcur = (*flist).tail
                                        }
                                        _ => { keep_going = false }
                                    }
                                }
                                entry.field_count = fc
                                (*sl_box).entries[pre_count as usize] = entry
                                (*sl_box).count = pre_count + 1
                                (*lo).struct_layouts = sl_box
                            } else {
                                (*lo).struct_layouts = sl_box
                            }
                        }
                        _ => {}
                    }
                }
                if head_owned.kind == ItemKind::ItemFn {
                    let fn_def_opt_ref: &Option<Box<FnDef>> = &head_owned.fn_def
                    match *fn_def_opt_ref {
                        Some(fd) => {
                            // Skip main entirely on into-acc (seed owns entry); skip any body.
                            if !lowerer_dep_should_skip_fn_mut(lo, head_owned.name) {
                                lowerer_preseed_fn_signature_mut(lo, head_owned.name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                        }
                        _ => {}
                    }
                }
                if head_owned.kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head_owned.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            lowerer_preseed_impl_method_summaries_dedup_mut(lo, head_owned.name, &(*id).methods, ir_empty_name())
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_register_struct_fields_direct_mut(
    lo: &! Lowerer,
    type_name: Name,
    fields: &Option<Box<FieldDefList>>
) with Mut, Panic, Div, Alloc, IO {
    var sl_box = (*lo).struct_layouts
    var layout_idx: i64 = -1
    var si: i64 = 0
    while si < (*sl_box).count {
        if ir_name_eq((*sl_box).entries[si as usize].type_name, type_name) {
            layout_idx = si
        }
        si = si + 1
    }
    if layout_idx < 0 {
        let pre_count = (*sl_box).count
        if pre_count >= 1024 {
            lo.error_count = lo.error_count + 1
            lo.had_error = true
            lower_note_error(2345, (*lo.current_func).name)
            return
        }
        layout_idx = pre_count
        (*sl_box).count = pre_count + 1
    }

    var entry = empty_struct_layout_entry()
    entry.type_name = type_name
    var fc: i64 = 0
    var fcur = fields
    var keep_going = true
    while keep_going && fc < 128 {
        match *fcur {
            Some(flist) => {
                entry.fields[fc as usize] = StructFieldEntry {
                    name_id: ir_intern_name((*flist).head.name),
                    index: fc,
                    // println i64-segfault fix: keep in sync with register_struct_fields_ref's
                    // `3` = scalar-i64 marker (this is a separate early-pass registration path
                    // over the same struct_layouts table; a mismatch here would leave the
                    // FIRST-registered field entry — the one actually found by name lookup —
                    // without the i64 marker).
                    is_float: if lower_type_expr_is_f64(&(*flist).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*flist).head.ty) { 2 } else if lower_type_expr_is_integer(&(*flist).head.ty) { 3 } else if lower_type_expr_is_bool(&(*flist).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*flist).head.ty) { 4 } else { 0 },
                    elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*flist).head.ty)),
                    word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*flist).head.ty),
                    named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*flist).head.ty)),
                }
                fc = fc + 1
                fcur = &(*flist).tail
            }
            _ => { keep_going = false }
        }
    }
    entry.field_count = fc
    (*sl_box).entries[layout_idx as usize] = entry
    (*lo).struct_layouts = sl_box
}

fn lowerer_register_struct_fields_mut(
    lo: &! Lowerer,
    type_name: Name,
    fields: &Option<Box<FieldDefList>>,
    idx: i64
) with Mut, Panic, Div, Alloc {
    var current = fields
    var field_idx = idx
    while true {
        match *current {
            Some(list) => {
                var layout_idx: i64 = -1
                var si: i64 = 0
                while si < (*(*lo).struct_layouts).count {
                    if ir_name_eq((*(*lo).struct_layouts).entries[si as usize].type_name, type_name) {
                        layout_idx = si
                    }
                    si = si + 1
                }
                if layout_idx < 0 {
                    if (*(*lo).struct_layouts).count < 1024 {
                        layout_idx = (*(*lo).struct_layouts).count
                        (*(*lo).struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
                            type_name: type_name,
                            fields: [empty_struct_field_entry(); 128],
                            field_count: 0,
                        }
                        (*(*lo).struct_layouts).count = layout_idx + 1
                    } else {
                        lo.error_count = lo.error_count + 1
                        lo.had_error = true
                        lower_note_error(2413, (*lo.current_func).name)
                        return
                    }
                }
                let fc = (*(*lo).struct_layouts).entries[layout_idx as usize].field_count
                if fc < 128 {
                    (*(*lo).struct_layouts).entries[layout_idx as usize].fields[fc as usize] = StructFieldEntry {
                        name_id: ir_intern_name((*list).head.name),
                        index: field_idx,
                        // println i64-segfault fix: see note in lowerer_register_struct_fields_direct_mut.
                        is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else if lower_type_expr_is_integer(&(*list).head.ty) { 3 } else if lower_type_expr_is_bool(&(*list).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*list).head.ty) { 4 } else { 0 },
                        elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*list).head.ty)),
                        word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*list).head.ty),
                        named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*list).head.ty)),
                    }
                    (*(*lo).struct_layouts).entries[layout_idx as usize].field_count = fc + 1
                } else {
                    lo.error_count = lo.error_count + 1
                    lo.had_error = true
                    lower_note_error(2430, (*lo.current_func).name)
                }
                current = &(*list).tail
                field_idx = field_idx + 1
            }
            _ => break
        }
    }
}

fn lowerer_preseed_impl_method_summaries_mut(
    lo: &! Lowerer,
    type_name: Name,
    methods: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc, IO {
    var current = methods
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_preseed_fn_signature_mut(lo, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// BSS allocation size for a type expression. Packed globals (i8/u8/bool/char)
// must report physical width 1 so `[i8; N]` reserves N bytes, not N*8.
// (Wave8 fixed IndexGet/init *stride* via hyper_algebra_kind; wave9 closes the
// residual over-alloc from always returning 8 for TypeNamed.)
fn lower_typeexpr_byte_size(ty_opt: &Option<Box<TypeExpr>>) -> i64 with Div, Mut, Panic {
    match *ty_opt {
        Some(ty) => {
            if (*ty).kind == TypeExprKind::TypeArray {
                let inner_size = lower_typeexpr_byte_size(&(*ty).inner)
                match (*ty).array_size {
                    Some(sz) => {
                        if (*sz).kind == ExprKind::ExprIntLit {
                            return inner_size * (*sz).int_val
                        }
                        return inner_size * 1024
                    }
                    _ => { return 8 }
                }
            }
            if (*ty).kind == TypeExprKind::TypeNamed {
                let name = ir_path_first_name((*ty).path)
                // i8 / u8
                if name.len == 2 {
                    let first = name.buf[0] as i64
                    let second = name.buf[1] as i64
                    if (first == 105 || first == 117) && second == 56 {
                        return 1
                    }
                }
                // bool / char
                if name.len == 4 {
                    let is_bool = name.buf[0] == 98 as i8 && name.buf[1] == 111 as i8
                        && name.buf[2] == 111 as i8 && name.buf[3] == 108 as i8
                    let is_char = name.buf[0] == 99 as i8 && name.buf[1] == 104 as i8
                        && name.buf[2] == 97 as i8 && name.buf[3] == 114 as i8
                    if is_bool || is_char {
                        return 1
                    }
                }
            }
            return 8
        }
        _ => { return 8 }
    }
}

fn lower_type_expr_fixed_array_len_ref(ty: &TypeExpr) -> i64 {
    if (*ty).kind != TypeExprKind::TypeArray { return -1 }
    match (*ty).array_size {
        Some(sz) => {
            if (*sz).kind == ExprKind::ExprIntLit && (*sz).int_val >= 0 {
                return (*sz).int_val
            }
            -1
        }
        None => -1,
    }
}

fn lower_opt_type_fixed_array_len(ty_opt: &Option<Box<TypeExpr>>) -> i64 {
    match *ty_opt {
        Some(ty) => lower_type_expr_fixed_array_len_ref(&(*ty)),
        None => -1,
    }
}

fn lower_name_is_direct_word_scalar_type(n: Name) -> bool with Panic, Div {
    // Native-v2 local arrays use one boxed 8-byte slot per primitive element,
    // including narrow integers. Keep this list explicit so structs, nested
    // arrays, strings, and future multiword primitives cannot enter a shallow copy.
    if n.len == 2 {
        return (n.buf[0] == 105 as i8 || n.buf[0] == 117 as i8)
            && n.buf[1] == 56 as i8 // i8/u8
    }
    if n.len == 3 {
        let numeric_width = (n.buf[1] == 49 as i8 && n.buf[2] == 54 as i8)
            || (n.buf[1] == 51 as i8 && n.buf[2] == 50 as i8)
            || (n.buf[1] == 54 as i8 && n.buf[2] == 52 as i8)
        if (n.buf[0] == 105 as i8 || n.buf[0] == 117 as i8) && numeric_width {
            return true // i16/u16/i32/u32/i64/u64
        }
        return n.buf[0] == 102 as i8
            && ((n.buf[1] == 51 as i8 && n.buf[2] == 50 as i8)
                || (n.buf[1] == 54 as i8 && n.buf[2] == 52 as i8)) // f32/f64
    }
    if n.len == 4 {
        let is_bool = n.buf[0] == 98 as i8 && n.buf[1] == 111 as i8
            && n.buf[2] == 111 as i8 && n.buf[3] == 108 as i8
        let is_char = n.buf[0] == 99 as i8 && n.buf[1] == 104 as i8
            && n.buf[2] == 97 as i8 && n.buf[3] == 114 as i8
        return is_bool || is_char
    }
    if n.len == 5 {
        let suffix = n.buf[1] == 115 as i8 && n.buf[2] == 105 as i8
            && n.buf[3] == 122 as i8 && n.buf[4] == 101 as i8
        return suffix && (n.buf[0] == 105 as i8 || n.buf[0] == 117 as i8) // isize/usize
    }
    false
}

fn lower_type_expr_fixed_array_word_scalar_ref(ty: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*ty).kind != TypeExprKind::TypeArray { return false }
    match (*ty).inner {
        Some(elem_ty) => {
            if (*elem_ty).kind != TypeExprKind::TypeNamed { return false }
            lower_name_is_direct_word_scalar_type(ir_path_first_name((*elem_ty).path))
        }
        None => false,
    }
}

fn lower_opt_type_fixed_array_word_scalar(ty_opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *ty_opt {
        Some(ty) => lower_type_expr_fixed_array_word_scalar_ref(&(*ty)),
        None => false,
    }
}

// #1475: length of a fixed-array type ONLY when its element is a word scalar,
// else -1. Single-value encoding of the pair the copy path requires, so a caller
// can never see a length without the word-scalar guarantee that makes an
// element-wise copy sound.
fn lower_opt_type_word_scalar_array_len(ty_opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    if !lower_opt_type_fixed_array_word_scalar(ty_opt) { return 0 - 1 }
    lower_opt_type_fixed_array_len(ty_opt)
}

// #1479: element count of a `[T; N]` type ONLY when T is a WORD SCALAR, else 0.
// ZERO — not -1 — is the unknown value, so that a StructFieldEntry literal which
// OMITS the field (this language permits partial struct literals, and one
// registration site in this file already relies on that) degrades to the FLAT
// copy instead of presenting a plain scalar field as a zero-length array.
fn lower_type_expr_word_scalar_array_len(te: &TypeExpr) -> i64 with Mut, Panic, Div {
    if !lower_type_expr_fixed_array_word_scalar_ref(te) { return 0 }
    let n = lower_type_expr_fixed_array_len_ref(te)
    if n <= 0 { return 0 }
    n
}

// #1479: first path segment of a PLAINLY NAMED field type (`inner: Inner` ->
// "Inner"), else empty. Compound and generic spellings (`[T; N]`, `&T`,
// `Option<Box<T>>` when it is not TypeNamed) return empty and therefore stay on
// the flat copy. A primitive name such as "i64" is returned but is harmless:
// the deep copy only acts on a name that resolves to a REGISTERED struct layout.
fn lower_type_expr_named_type_name(te: &TypeExpr) -> Name with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return ir_empty_name() }
    ir_path_first_name((*te).path)
}

// A field's ELEMENT type: the array element for `[T; N]`, and the INNER T for
// `Box<T>`. The two shapes are disjoint -- a field is one or the other, never
// both -- so they share `elem_type_name_id`, the way tuple0_array_elem_layout
// already shares a local slot between disjoint shapes.
//
// WHY NOT named_type_name_id: it holds the literal "Box" for `f: Box<T>`, and
// field_is_box_for_struct TESTS for exactly that (is_float == 4 &&
// ir_name_is_box(named_type_name_id)). Writing T there would resolve the type
// and silently disable every Box deref -- the auto-deref class that has already
// been reverted four times. The name stays "Box"; the inner type rides in the
// slot that is empty for a Box field anyway.
fn lower_type_expr_elem_or_box_inner_name(te: &TypeExpr) -> Name with Mut, Panic, Div {
    if lower_type_expr_is_box(te) {
        return lower_box_inner_type_name(te)
    }
    lower_type_expr_array_elem_name(te)
}

fn lower_array_literal_fixed_len_ref(e: &Expr) -> i64 with Alloc, Mut, Div {
    if (*e).kind != ExprKind::ExprArrayLit { return -1 }
    match (*e).left {
        Some(_) => {
            match (*e).right {
                Some(count_expr) => {
                    if (*count_expr).kind == ExprKind::ExprIntLit && (*count_expr).int_val >= 0 {
                        return (*count_expr).int_val
                    }
                    -1
                }
                None => -1,
            }
        }
        None => count_expr_list_ref(&(*e).args),
    }
}

fn lower_array_literal_word_scalar_ref(e: &Expr, repeat_ident_scalar_kind: i64) -> bool {
    if (*e).kind != ExprKind::ExprArrayLit { return false }
    match (*e).left {
        Some(repeat_value) => {
            (*repeat_value).kind == ExprKind::ExprIntLit
                || (*repeat_value).kind == ExprKind::ExprFloatLit
                || (*repeat_value).kind == ExprKind::ExprBoolTrue
                || (*repeat_value).kind == ExprKind::ExprBoolFalse
                || ((*repeat_value).kind == ExprKind::ExprIdent
                    && (repeat_ident_scalar_kind == 1 || repeat_ident_scalar_kind == 2))
        }
        None => {
            match (*e).args {
                Some(args) => {
                    (*args).head.kind == ExprKind::ExprIntLit
                        || (*args).head.kind == ExprKind::ExprFloatLit
                        || (*args).head.kind == ExprKind::ExprBoolTrue
                        || (*args).head.kind == ExprKind::ExprBoolFalse
                }
                None => false,
            }
        }
    }
}

// BSS hyper_algebra_kind encoding for packed globals (physical size + signedness):
//   1  = u8  — physical 1 byte, IndexGet label_id=3 (movzx)
//   17 = i8  — physical 1 byte, IndexGet label_id=4 (movsx)
//   8  = i64/f64/other — physical 8 bytes, IndexGet label_id=2
// Init emit must use lower_bss_elem_physical_size so i8 is not treated as 17-byte stride.
fn lower_bss_elem_physical_size(kind: i64) -> i64 {
    if kind == 1 || kind == 17 {
        1
    } else if kind <= 0 {
        8
    } else {
        kind
    }
}

fn lower_bss_elem_is_signed_byte(kind: i64) -> bool {
    kind == 17
}

// True when a BSS slot is an aggregate base (array), not a scalar value load.
// Historically `bss_size > 8` was the only discriminator — fine when every
// element reserved 8 bytes, but wave9 packs i8/u8 at physical width so
// `[i8; 4]` has size 4 and would be mis-read as a scalar (base = first byte
// value → IndexGet SEGV). Packed byte arrays set hyper_algebra_kind 1/17.
fn lower_bss_slot_is_aggregate(bss_size: i64, hyper_kind: i64) -> bool {
    if bss_size > 8 {
        return true
    }
    if hyper_kind == 1 || hyper_kind == 17 {
        return true
    }
    false
}

fn lower_typeexpr_bss_elem_size(ty_opt: &Option<Box<TypeExpr>>) -> i64 with Panic, Div, Mut {
    match *ty_opt {
        Some(ty) => {
            if (*ty).kind != TypeExprKind::TypeArray { return 8 }
            match (*ty).inner {
                Some(elem) => {
                    if (*elem).kind == TypeExprKind::TypeNamed {
                        let name = ir_path_first_name((*elem).path)
                        if name.len == 2 {
                            let first = name.buf[0] as i64
                            let second = name.buf[1] as i64
                            // 'i' '8' → signed packed byte (movsx on load)
                            if first == 105 && second == 56 {
                                return 17
                            }
                            // 'u' '8' → unsigned packed byte (movzx on load)
                            if first == 117 && second == 56 {
                                return 1
                            }
                        }
                        // bool / char → packed unsigned byte (movzx); also marks
                        // the slot as aggregate under lower_bss_slot_is_aggregate
                        // even when N*1 ≤ 8 (wave9).
                        if name.len == 4 {
                            let is_bool = name.buf[0] == 98 as i8 && name.buf[1] == 111 as i8
                                && name.buf[2] == 111 as i8 && name.buf[3] == 108 as i8
                            let is_char = name.buf[0] == 99 as i8 && name.buf[1] == 104 as i8
                                && name.buf[2] == 97 as i8 && name.buf[3] == 114 as i8
                            if is_bool || is_char {
                                return 1
                            }
                        }
                    }
                }
                _ => {}
            }
            8
        }
        _ => 8,
    }
}

// Apply parse-time GLOBAL_VAR_INIT_* / GLOBAL_STR_INIT_* side-table data onto a
// BSS global slot.
// - string init present: returns_float=1, prof_counter_id=BSS_INIT_STRING_MAGIC,
//   return_struct_name = normalized literal payload (see ir.sio)
// - count == 0: no recorded int/float init (BSS stays zero unless string)
// - count == 1: scalar or array-repeat fill → returns_float=1, prof_counter_id=word
// - count  > 1: element-list → also pack words into instrs[] for per-element stores
// Presence uses count (not value!=0) so a list starting with 0 still inits.
// Panic is reachable: the arena accessors this walks (ir_region_slot_r/_w,
// ir_arena_load/_store) are all `with Mut, Panic, Div`. Declared, per E035.
fn lower_apply_global_var_init(slot: &! IrFunction, name: Name) with Mut, Panic, Div {
    // Wave15e: string literal globals (magic+len+bytes in GLOBAL_VAR_INIT_*).
    // Must run before the multi-word element-list path or magic words would be
    // mis-emitted as per-element BSS fills.
    if ast_global_str_init_present(name) == 1 {
        let payload = ast_global_str_init_name(name)
        // Payload already has surrounding quotes stripped; expand escapes only.
        (*slot).returns_float = 1
        (*slot).prof_counter_id = BSS_INIT_STRING_MAGIC
        (*slot).return_struct_name = ir_normalize_string_literal_name(payload)
        (*slot).instr_count = 0
        return
    }
    let count = ast_global_var_init_count(name)
    if count <= 0 {
        return
    }
    (*slot).returns_float = 1
    (*slot).prof_counter_id = ast_global_var_init_nth(name, 0)
    if count > 1 {
        var j: i64 = 0
        while j < count && j < IR_MAX_INSTRS {
            var instr = ir_arena_load(ir_region_slot_r((*slot).region, (j)))
            instr.imm_i64 = ast_global_var_init_nth(name, j)
            ir_arena_store(ir_region_slot_w((*slot).region, (j)), instr)
            j = j + 1
        }
        (*slot).instr_count = j
    }
}
fn lower_type_expr_array_elem_name(te: &TypeExpr) -> Name with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeArray { return ir_empty_name() }
    match (*te).inner {
        Some(elem) => {
            if (*elem).kind == TypeExprKind::TypeNamed {
                return ir_path_first_name((*elem).path)
            }
            ir_empty_name()
        }
        _ => ir_empty_name()
    }
}

var LOWER_PRESEED_ITEM_PTRS: [i64; 16384] = [0; 16384]
var LOWER_PRESEED_ENUM_DEF_PTRS: [i64; 16384] = [0; 16384]

fn lower_collect_preseed_item_ptrs(items: Option<Box<ItemList>>, count: i64) -> i64 with Mut, Alloc {
    if count >= IR_MAX_FUNCS { return count }
    match items {
        Some(list) => {
            let ptr = list as *mut ItemList
            LOWER_PRESEED_ITEM_PTRS[count as usize] = ptr as i64
            let ed_ptr = item_enum_def_ptr(&(*list).head)
            LOWER_PRESEED_ENUM_DEF_PTRS[count as usize] = ed_ptr as i64
            lower_collect_preseed_item_ptrs((*list).tail, count + 1)
        }
        None => count,
    }
}

fn lowerer_preseed_program_metadata_owned_mut(
    lo: &! Lowerer,
    items: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    match items {
        Some(list) => {
            let item = &(*list).head
            if item.kind == ItemKind::ItemStruct {
                let sd = item_struct_def_ptr(item)
                if sd != (0 as *mut StructDef) {
                    lowerer_register_struct_fields_direct_mut(lo, item.name, &(*sd).fields)
                }
            } else if item.kind == ItemKind::ItemEnum {
                let ed = item_enum_def_ptr(item)
                if ed != (0 as *mut EnumDef) {
                    lowerer_register_enum_variants_mut(lo, item.name, &(*ed).variants, 0)
                }
            }
            lowerer_preseed_program_metadata_owned_mut(lo, (*list).tail)
        }
        None => {}
    }
}

fn lowerer_preseed_program_items_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc, IO {
    // Traverse the linked list in the same small recursive shape used by
    // module_frontend_count_fn_items, then keep this large dispatch scalar.
    let item_count = lower_collect_preseed_item_ptrs(*items, 0)
    var item_n: i64 = 0
    while item_n < item_count {
                let current = LOWER_PRESEED_ITEM_PTRS[item_n as usize] as *mut ItemList
                let head = &(*current).head
                let kind = head.kind
                let name = head.name
                item_n = item_n + 1
                // Safety only — real multi-fn modules need the full walk.
                if item_n > IR_MAX_FUNCS {
                    return
                }
                if kind == ItemKind::ItemFn {
                    if !ir_name_eq(name, skip_name) {
                        match head.fn_def {
                            Some(fd) => {
                                let fn_id_sig = lowerer_find_or_add_fn_id_mut(lo, name)
                                if fn_id_sig >= 0 {
                                    let strategy_sig = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                    var module_box_sig = (*lo).module
                                    var fn_slot_sig = ir_fn_get(&(*module_box_sig), fn_id_sig as usize)
                                    fn_slot_sig.compile_strategy = strategy_sig
                                    fn_slot_sig.returns_float = lower_opt_return_float_code(&(*fd).return_type)
                                    fn_slot_sig.return_fixed_array_len = lower_opt_type_return_fixed_array_code(&(*fd).return_type)
                                    fn_slot_sig.return_struct_name = lower_opt_type_return_layout_name(&(*fd).return_type)
                                    fn_slot_sig.param_count = ir_param_list_count_ref(&(*fd).params)
                                    fn_slot_sig.first_param_is_ref = lower_fn_first_param_is_ref(&(*fd).params)
                                    if strategy_sig == IR_STRATEGY_INSTRUMENTED {
                                        fn_slot_sig.param_count = fn_slot_sig.param_count + 1
                                        if fn_slot_sig.prof_counter_id < 0 {
                                            let ctr_idx_sig = (*module_box_sig).prof_counter_count
                                            if ctr_idx_sig < 64 {
                                                (*module_box_sig).prof_counters[ctr_idx_sig as usize] = IrProfCounterInfo {
                                                    fn_id: fn_id_sig,
                                                    fn_name: name,
                                                    counter_id: ctr_idx_sig,
                                                }
                                                (*module_box_sig).prof_counter_count = ctr_idx_sig + 1
                                                fn_slot_sig.prof_counter_id = ctr_idx_sig
                                            } else {
                                                lo.error_count = lo.error_count + 1
                                                lo.had_error = true
                                                lower_note_error(2810, (*lo.current_func).name)
                                            }
                                        }
                                    }
                                    if fn_slot_sig.region.slot < 0 { ir_function_alloc_region(&! fn_slot_sig) }
                                    ir_fn_set(&! (*module_box_sig), fn_id_sig as usize, fn_slot_sig)
                                    (*lo).module = module_box_sig
                                }
                                let fn_id_ps = lowerer_find_or_add_fn_id_mut(lo, name)
                                if fn_id_ps >= 0 {
                                    if (*fd).is_kernel {
                                        { var mbox_k = (*lo).module
                                        var slot_k = ir_fn_get(&(*mbox_k), fn_id_ps as usize)
                                        slot_k.compile_strategy = 6
                                        ir_fn_set(&! (*mbox_k), fn_id_ps as usize, slot_k)
                                        (*lo).module = mbox_k }
                                    } else if visibility_to_bool(head.visibility) {
                                        { var mbox_e = (*lo).module
                                        var slot_e = ir_fn_get(&(*mbox_e), fn_id_ps as usize)
                                        slot_e.compile_strategy = 7
                                        ir_fn_set(&! (*mbox_e), fn_id_ps as usize, slot_e)
                                        (*lo).module = mbox_e }
                                        let exp_count = (*(*lo).module).export_count
                                        if exp_count < 64 {
                                            (*(*lo).module).export_names[exp_count as usize] = name
                                            (*(*lo).module).export_count = exp_count + 1
                                        }
                                    }
                                }
                            }
                            None => {
                                let bss_fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
                                if bss_fn_id >= 0 {
                                    lowerer_record_global_type_mut(lo, bss_fn_id, &head.type_alias_ty)
                                    var mbox2 = (*lo).module
                                    var bss_slot = ir_fn_get(&(*mbox2), bss_fn_id as usize)
                                    let bss_off = (*mbox2).bss_total_size
                                    let bss_size = lower_typeexpr_byte_size(&head.type_alias_ty)
                                    let aligned_size = ((bss_size + 7) / 8) * 8
                                    bss_slot.compile_strategy = 99
                                    bss_slot.param_count = bss_off
                                    bss_slot.bss_size = bss_size
                                    bss_slot.hyper_algebra_kind = lower_typeexpr_bss_elem_size(&head.type_alias_ty)
                                    lower_apply_global_var_init(&! bss_slot, name)
                                    if bss_slot.region.slot < 0 { ir_function_alloc_region(&! bss_slot) }
                                    ir_fn_set(&! (*mbox2), bss_fn_id as usize, bss_slot)
                                    (*mbox2).bss_total_size = bss_off + aligned_size
                                    (*lo).module = mbox2
                                }
                            }
                        }
                    }
                } else if kind == ItemKind::ItemStruct {
                    match head.struct_def {
                        Some(sd) => {
                            lowerer_register_struct_fields_direct_mut(lo, name, &(*sd).fields)
                        }
                        None => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    let ed = LOWER_PRESEED_ENUM_DEF_PTRS[(item_n - 1) as usize] as *mut EnumDef
                    if ed != (0 as *mut EnumDef) {
                        lowerer_register_enum_variants_mut(lo, name, &(*ed).variants, 0)
                    }
                } else if kind == ItemKind::ItemImpl {
                    match head.impl_def {
                        Some(id) => {
                            lowerer_preseed_impl_method_summaries_mut(lo, name, &(*id).methods, skip_name)
                        }
                        None => {}
                    }
                }
    }
}

fn ir_fast_summary_find_or_add_fn_id(module: &! IrModule, name: Name) -> i64 with Mut, Panic, Div, Alloc {
    var module_value = (*module)
    var i: i64 = 0
    while i < module_value.fn_count {
        if ir_name_eq(ir_fn_get(&module_value, i as usize).name, name) {
            return i
        }
        i = i + 1
    }
    if module_value.fn_count >= IR_MAX_FUNCS {
        return -1
    }
    let idx = module_value.fn_count
    ir_fn_pool_ensure(&module_value, idx)
    var fresh_ir_fn = ir_empty_function()
    ir_function_alloc_region(&! fresh_ir_fn)
    fresh_ir_fn.name = name
    fresh_ir_fn.param_regs = [IR_INVALID_REG; 64]
    ir_fn_set(&! module_value, idx as usize, fresh_ir_fn)
    module_value.fn_count = idx + 1
    (*module) = module_value
    idx
}

fn ir_fast_summary_preseed_fn_signature(
    module: &! IrModule,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) with Mut, Panic, Div, Alloc {
    let fn_id = ir_fast_summary_find_or_add_fn_id(module, name)
    if fn_id < 0 {
        return
    }
    var module_value = (*module)
    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    var fn_slot = ir_fn_get(&module_value, fn_id as usize)
    fn_slot.compile_strategy = strategy
    fn_slot.returns_float = lower_opt_return_float_code(return_type)
    fn_slot.return_fixed_array_len = lower_opt_type_return_fixed_array_code(return_type)
    fn_slot.return_struct_name = lower_opt_type_return_layout_name(return_type)
    fn_slot.param_count = ir_param_list_count_ref(params)
    fn_slot.first_param_is_ref = lower_fn_first_param_is_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        fn_slot.param_count = fn_slot.param_count + 1
        if fn_slot.prof_counter_id < 0 {
            let ctr_idx = module_value.prof_counter_count
            if ctr_idx < 64 {
                module_value.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                module_value.prof_counter_count = ctr_idx + 1
                fn_slot.prof_counter_id = ctr_idx
            }
        }
    }
    ir_fn_set(&! module_value, fn_id as usize, fn_slot)
    (*module) = module_value
}

fn ir_fast_summary_preseed_impl_methods(
    module: &! IrModule,
    type_name: Name,
    methods: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = methods
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                ir_fast_summary_preseed_fn_signature(module, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn ir_fast_summary_preseed_items(
    module: &! IrModule,
    items: &Option<Box<ItemList>>,
    skip_name: Name
) with Mut, Panic, Div, Alloc {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                let kind = head.kind
                let name = head.name
                if kind == ItemKind::ItemFn {
                    if !ir_name_eq(name, skip_name) {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                ir_fast_summary_preseed_fn_signature(module, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                } else if kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            ir_fast_summary_preseed_impl_methods(module, name, &(*id).methods, skip_name)
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn ir_fast_summary_find_or_add_fn_id_owned(module: IrModule, name: Name) -> (IrModule, i64) with Mut, Panic, Div, Alloc {
    var module_value = module
    var i: i64 = 0
    while i < module_value.fn_count {
        if ir_name_eq(ir_fn_get(&module_value, i as usize).name, name) {
            return (module_value, i)
        }
        i = i + 1
    }
    if module_value.fn_count >= IR_MAX_FUNCS {
        return (module_value, -1)
    }
    let idx = module_value.fn_count
    ir_fn_pool_ensure(&module_value, idx)
    var fresh_ir_fn = ir_empty_function()
    ir_function_alloc_region(&! fresh_ir_fn)
    fresh_ir_fn.name = name
    fresh_ir_fn.param_regs = [IR_INVALID_REG; 64]
    ir_fn_set(&! module_value, idx as usize, fresh_ir_fn)
    module_value.fn_count = idx + 1
    (module_value, idx)
}

fn ir_fast_summary_preseed_fn_signature_owned(
    module: IrModule,
    name: Name,
    params: &Option<Box<ParamList>>,
    return_type: &Option<Box<TypeExpr>>,
    effects: &Option<Box<EffectList>>
) -> IrModule with Mut, Panic, Div, Alloc {
    let pair = ir_fast_summary_find_or_add_fn_id_owned(module, name)
    var module_value = pair.0
    let fn_id = pair.1
    if fn_id < 0 {
        return module_value
    }
    let strategy = lowerer_compute_strategy_from_ast_ref(return_type, effects)
    var fn_slot = ir_fn_get(&module_value, fn_id as usize)
    fn_slot.compile_strategy = strategy
    fn_slot.returns_float = lower_opt_return_float_code(return_type)
    fn_slot.return_fixed_array_len = lower_opt_type_return_fixed_array_code(return_type)
    fn_slot.return_struct_name = lower_opt_type_return_layout_name(return_type)
    fn_slot.param_count = ir_param_list_count_ref(params)
    fn_slot.first_param_is_ref = lower_fn_first_param_is_ref(params)
    if strategy == IR_STRATEGY_INSTRUMENTED {
        fn_slot.param_count = fn_slot.param_count + 1
        if fn_slot.prof_counter_id < 0 {
            let ctr_idx = module_value.prof_counter_count
            if ctr_idx < 64 {
                module_value.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: name,
                    counter_id: ctr_idx,
                }
                module_value.prof_counter_count = ctr_idx + 1
                fn_slot.prof_counter_id = ctr_idx
            }
        }
    }
    ir_fn_set(&! module_value, fn_id as usize, fn_slot)
    module_value
}

fn ir_fast_summary_preseed_impl_methods_owned(
    module: IrModule,
    type_name: Name,
    methods: Option<Box<ItemList>>,
    skip_name: Name
) -> IrModule with Mut, Panic, Div, Alloc {
    match methods {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            var module_value = module
            if item.kind == ItemKind::ItemFn {
                let mangled = ir_mangle_method_name(type_name, item.name)
                if !ir_name_eq(mangled, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            module_value = ir_fast_summary_preseed_fn_signature_owned(module_value, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            }
            ir_fast_summary_preseed_impl_methods_owned(module_value, type_name, tail, skip_name)
        }
        None => module,
    }
}

fn ir_fast_summary_preseed_items_owned(
    module: IrModule,
    items: Option<Box<ItemList>>,
    skip_name: Name
) -> IrModule with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            let kind = item.kind
            let name = item.name
            var module_value = module
            if kind == ItemKind::ItemFn {
                if !ir_name_eq(name, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            module_value = ir_fast_summary_preseed_fn_signature_owned(module_value, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            } else if kind == ItemKind::ItemImpl {
                match item.impl_def {
                    Some(id) => {
                        module_value = ir_fast_summary_preseed_impl_methods_owned(module_value, name, (*id).methods, skip_name)
                    }
                    _ => {}
                }
            }
            ir_fast_summary_preseed_items_owned(module_value, tail, skip_name)
        }
        None => module,
    }
}

fn ir_fast_summary_seed_empty(epistemic: IrEpistemicSection) -> IrFastSummaryOwnedSeed with Alloc, Panic, Div, Mut {
    var module = ir_empty_module()
    module.epistemic = epistemic
    IrFastSummaryOwnedSeed {
        module: module,
        enum_variants: empty_enum_variant_table(),
        struct_layouts: empty_struct_layout_table(),
        global_types: empty_lower_global_type_table(),
    }
}

fn ir_fast_summary_register_enum_variants_owned(
    table: EnumVariantTable,
    enum_name: Name,
    variants: Option<Box<VariantDefList>>,
    next_disc: i64
) -> EnumVariantTable with Mut, Panic, Div, Alloc {
    match variants {
        Some(list) => {
            var table_value = table
            if table_value.count < 1024 {
                let idx = table_value.count
                table_value.entries[idx as usize] = EnumVariantEntry {
                    enum_name: enum_name,
                    variant_name: (*list).head.name,
                    discriminant: next_disc,
                }
                table_value.count = idx + 1
            }
            ir_fast_summary_register_enum_variants_owned(table_value, enum_name, (*list).tail, next_disc + 1)
        }
        None => table,
    }
}

fn ir_fast_summary_register_struct_fields_owned(
    table: StructLayoutTable,
    type_name: Name,
    fields: Option<Box<FieldDefList>>,
    idx: i64
) -> StructLayoutTable with Mut, Panic, Div, Alloc {
    match fields {
        Some(list) => {
            var table_value = table
            var layout_idx: i64 = -1
            var si: i64 = 0
            while si < table_value.count {
                if ir_name_eq(table_value.entries[si as usize].type_name, type_name) {
                    layout_idx = si
                }
                si = si + 1
            }
            if layout_idx < 0 {
                if table_value.count < 1024 {
                    layout_idx = table_value.count
                    table_value.entries[layout_idx as usize] = StructLayoutEntry {
                        type_name: type_name,
                        fields: [empty_struct_field_entry(); 128],
                        field_count: 0,
                    }
                    table_value.count = layout_idx + 1
                } else {
                    return table_value
                }
            }
            let fc = table_value.entries[layout_idx as usize].field_count
            if fc < 128 {
                // Two-level nested store `table.entries[i].fields[fc] = …` is dropped by
                // the lean_single by-value-aggregate miscompile, so the field never lands
                // and field-index resolution later falls back to a name hash (OOB access).
                // Build in a local entry, then assign it back once (single level).
                var lay_entry = table_value.entries[layout_idx as usize]
                lay_entry.fields[fc as usize] = StructFieldEntry {
                    name_id: ir_intern_name((*list).head.name),
                    index: idx,
                    // println i64-segfault fix: see note in lowerer_register_struct_fields_direct_mut.
                    is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else if lower_type_expr_is_integer(&(*list).head.ty) { 3 } else if lower_type_expr_is_bool(&(*list).head.ty) { 3 } else if lower_type_expr_is_pointer_like(&(*list).head.ty) { 4 } else { 0 },
                    elem_type_name_id: ir_intern_name(lower_type_expr_elem_or_box_inner_name(&(*list).head.ty)),
                    word_scalar_array_len: lower_type_expr_word_scalar_array_len(&(*list).head.ty),
                    named_type_name_id: ir_intern_name(lower_type_expr_named_type_name(&(*list).head.ty)),
                }
                lay_entry.field_count = fc + 1
                table_value.entries[layout_idx as usize] = lay_entry
            }
            ir_fast_summary_register_struct_fields_owned(table_value, type_name, (*list).tail, idx + 1)
        }
        None => table,
    }
}

fn ir_fast_summary_preseed_impl_methods_seed_owned(
    seed: IrFastSummaryOwnedSeed,
    type_name: Name,
    methods: Option<Box<ItemList>>,
    skip_name: Name
) -> IrFastSummaryOwnedSeed with Mut, Panic, Div, Alloc {
    match methods {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            var seed_value = seed
            if item.kind == ItemKind::ItemFn {
                let mangled = ir_mangle_method_name(type_name, item.name)
                if !ir_name_eq(mangled, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            seed_value.module = ir_fast_summary_preseed_fn_signature_owned(seed_value.module, mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                        }
                        _ => {}
                    }
                }
            }
            ir_fast_summary_preseed_impl_methods_seed_owned(seed_value, type_name, tail, skip_name)
        }
        None => seed,
    }
}

fn ir_fast_summary_preseed_items_seed_owned(
    seed: IrFastSummaryOwnedSeed,
    items: Option<Box<ItemList>>,
    skip_name: Name
) -> IrFastSummaryOwnedSeed with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let tail = (*list).tail
            let kind = item.kind
            let name = item.name
            var seed_value = seed
            if kind == ItemKind::ItemFn {
                if !ir_name_eq(name, skip_name) {
                    match item.fn_def {
                        Some(fd) => {
                            seed_value.module = ir_fast_summary_preseed_fn_signature_owned(seed_value.module, name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                }
                                _ => {
                                    var bss_mod = seed_value.module
                                    let bss_fid = bss_mod.fn_count
                                    if bss_fid < IR_MAX_FUNCS {
                                        seed_value.global_types = lower_global_type_table_record(
                                            seed_value.global_types,
                                            bss_fid,
                                            lower_global_elem_kind(&item.type_alias_ty)
                                        )
                                        let bss_size = lower_typeexpr_byte_size(&item.type_alias_ty)
                                        let aligned_size = ((bss_size + 7) / 8) * 8
                                        var bss_slot = ir_empty_function()
                                        bss_slot.name = name
                                        bss_slot.compile_strategy = IR_STRATEGY_BSS_GLOBAL
                                        bss_slot.param_count = bss_mod.bss_total_size
                                        bss_slot.bss_size = bss_size
                                        bss_slot.hyper_algebra_kind = lower_typeexpr_bss_elem_size(&item.type_alias_ty)
                                        lower_apply_global_var_init(&! bss_slot, name)
                                        if bss_slot.region.slot < 0 { ir_function_alloc_region(&! bss_slot) }
                                        ir_fn_set(&! bss_mod, bss_fid as usize, bss_slot)
                                        bss_mod.fn_count = bss_fid + 1
                                        bss_mod.bss_total_size = bss_mod.bss_total_size + aligned_size
                                    }
                                    seed_value.module = bss_mod
                                }
                            }
                        }
                    } else if kind == ItemKind::ItemStruct {
                match item.struct_def {
                    Some(sd) => {
                        seed_value.struct_layouts = ir_fast_summary_register_struct_fields_owned(seed_value.struct_layouts, name, (*sd).fields, 0)
                    }
                    _ => {}
                }
            } else if kind == ItemKind::ItemEnum {
                match item.enum_def {
                    Some(ed) => {
                        seed_value.enum_variants = ir_fast_summary_register_enum_variants_owned(seed_value.enum_variants, name, (*ed).variants, 0)
                    }
                    _ => {}
                }
            } else if kind == ItemKind::ItemImpl {
                match item.impl_def {
                    Some(id) => {
                        seed_value = ir_fast_summary_preseed_impl_methods_seed_owned(seed_value, name, (*id).methods, skip_name)
                    }
                    _ => {}
                }
            }
            ir_fast_summary_preseed_items_seed_owned(seed_value, tail, skip_name)
        }
        None => seed,
    }
}

pub fn lower_program_to_ir_summary_flat_owned_with_epistemic_ref(
    prog: &Program,
    epistemic: IrEpistemicSection
) -> IrProgramSummaryFlatResult with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.epistemic = epistemic
    var enum_variants = empty_enum_variant_table()
    var struct_layouts = empty_struct_layout_table()
    var global_types = empty_lower_global_type_table()
    var current = (*prog).items
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                let kind = item.kind
                let name = item.name
                if kind == ItemKind::ItemFn {
                    match item.fn_def {
                        Some(fd) => {
                            var fn_id: i64 = -1
                            var i: i64 = 0
                            while i < module.fn_count {
                                if ir_name_eq(ir_fn_get(&module, i as usize).name, name) {
                                    fn_id = i
                                    i = module.fn_count
                                } else {
                                    i = i + 1
                                }
                            }
                            if fn_id < 0 && module.fn_count < IR_MAX_FUNCS {
                                fn_id = module.fn_count
                                var fresh_ir_fn = ir_empty_function()
                                ir_function_alloc_region(&! fresh_ir_fn)
                                fresh_ir_fn.name = name
                                fresh_ir_fn.param_regs = [IR_INVALID_REG; 64]
                                ir_fn_set(&! module, fn_id as usize, fresh_ir_fn)
                                module.fn_count = fn_id + 1
                            }
                            if fn_id >= 0 {
                                let strategy = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                var fn_slot = ir_fn_get(&module, fn_id as usize)
                                fn_slot.compile_strategy = strategy
                                fn_slot.returns_float = lower_opt_return_float_code(&(*fd).return_type)
                                fn_slot.return_fixed_array_len = lower_opt_type_return_fixed_array_code(&(*fd).return_type)
                                fn_slot.return_struct_name = lower_opt_type_return_layout_name(&(*fd).return_type)
                                fn_slot.param_count = ir_param_list_count_ref(&(*fd).params)
                                fn_slot.first_param_is_ref = lower_fn_first_param_is_ref(&(*fd).params)
                                if strategy == IR_STRATEGY_INSTRUMENTED {
                                    fn_slot.param_count = fn_slot.param_count + 1
                                    if fn_slot.prof_counter_id < 0 && module.prof_counter_count < 64 {
                                        let ctr_idx = module.prof_counter_count
                                        module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                                            fn_id: fn_id,
                                            fn_name: name,
                                            counter_id: ctr_idx,
                                        }
                                        module.prof_counter_count = ctr_idx + 1
                                        fn_slot.prof_counter_id = ctr_idx
                                    }
                                }
                                ir_fn_set(&! module, fn_id as usize, fn_slot)
                            }
                        }
                        _ => {
                            var bss_mod = module
                            let bss_fid = bss_mod.fn_count
                            if bss_fid < IR_MAX_FUNCS {
                                global_types = lower_global_type_table_record(
                                    global_types,
                                    bss_fid,
                                    lower_global_elem_kind(&item.type_alias_ty)
                                )
                                let bss_size = lower_typeexpr_byte_size(&item.type_alias_ty)
                                let aligned_size = ((bss_size + 7) / 8) * 8
                                var bss_slot = ir_empty_function()
                                bss_slot.name = name
                                bss_slot.compile_strategy = IR_STRATEGY_BSS_GLOBAL
                                bss_slot.param_count = bss_mod.bss_total_size
                                bss_slot.bss_size = bss_size
                                bss_slot.hyper_algebra_kind = lower_typeexpr_bss_elem_size(&item.type_alias_ty)
                                lower_apply_global_var_init(&! bss_slot, name)
                                if bss_slot.region.slot < 0 { ir_function_alloc_region(&! bss_slot) }
                                ir_fn_set(&! bss_mod, bss_fid as usize, bss_slot)
                                bss_mod.fn_count = bss_fid + 1
                                bss_mod.bss_total_size = bss_mod.bss_total_size + aligned_size
                            }
                            module = bss_mod
                        }
                    }
                } else if kind == ItemKind::ItemStruct {
                    match item.struct_def {
                        Some(sd) => {
                            struct_layouts = ir_fast_summary_register_struct_fields_owned(struct_layouts, name, (*sd).fields, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    match item.enum_def {
                        Some(ed) => {
                            enum_variants = ir_fast_summary_register_enum_variants_owned(enum_variants, name, (*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    match item.impl_def {
                        Some(id) => {
                            var method_current = (*id).methods
                            while true {
                                match method_current {
                                    Some(method_list) => {
                                        let method_item = (*method_list).head
                                        if method_item.kind == ItemKind::ItemFn {
                                            let mangled = ir_mangle_method_name(name, method_item.name)
                                            match method_item.fn_def {
                                                Some(fd) => {
                                                    var fn_id: i64 = -1
                                                    var i: i64 = 0
                                                    while i < module.fn_count {
                                                        if ir_name_eq(ir_fn_get(&module, i as usize).name, mangled) {
                                                            fn_id = i
                                                            i = module.fn_count
                                                        } else {
                                                            i = i + 1
                                                        }
                                                    }
                                                    if fn_id < 0 && module.fn_count < IR_MAX_FUNCS {
                                                        fn_id = module.fn_count
                                                        var fresh_ir_fn = ir_empty_function()
                                                        ir_function_alloc_region(&! fresh_ir_fn)
                                                        fresh_ir_fn.name = mangled
                                                        fresh_ir_fn.param_regs = [IR_INVALID_REG; 64]
                                                        ir_fn_set(&! module, fn_id as usize, fresh_ir_fn)
                                                        module.fn_count = fn_id + 1
                                                    }
                                                    if fn_id >= 0 {
                                                        let strategy = lowerer_compute_strategy_from_ast_ref(&(*fd).return_type, &(*fd).effects)
                                                        var fn_slot = ir_fn_get(&module, fn_id as usize)
                                                        fn_slot.compile_strategy = strategy
                                                        fn_slot.returns_float = lower_opt_return_float_code(&(*fd).return_type)
                                                        fn_slot.return_fixed_array_len = lower_opt_type_return_fixed_array_code(&(*fd).return_type)
                                                        fn_slot.return_struct_name = lower_opt_type_return_layout_name(&(*fd).return_type)
                                                        fn_slot.param_count = ir_param_list_count_ref(&(*fd).params)
                                                        fn_slot.first_param_is_ref = lower_fn_first_param_is_ref(&(*fd).params)
                                                        if strategy == IR_STRATEGY_INSTRUMENTED {
                                                            fn_slot.param_count = fn_slot.param_count + 1
                                                            if fn_slot.prof_counter_id < 0 && module.prof_counter_count < 64 {
                                                                let ctr_idx = module.prof_counter_count
                                                                module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                                                                    fn_id: fn_id,
                                                                    fn_name: mangled,
                                                                    counter_id: ctr_idx,
                                                                }
                                                                module.prof_counter_count = ctr_idx + 1
                                                                fn_slot.prof_counter_id = ctr_idx
                                                            }
                                                        }
                                                        ir_fn_set(&! module, fn_id as usize, fn_slot)
                                                    }
                                                }
                            _ => {}
                                            }
                                        }
                                        method_current = (*method_list).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
    IrProgramSummaryFlatResult {
        summary: IrProgramSummaryFlat {
            module: module,
            enum_variants: enum_variants,
            struct_layouts: struct_layouts,
            global_types: global_types,
            probe_mode: false,
        },
        error_count: 0,
        had_error: false,
    }
}

fn lowerer_bind_local_mut(
    lo: &! Lowerer,
    name: Name,
    reg: i64,
    is_mut: bool
) with Mut, Alloc, Panic {
    let _is_mut = is_mut
    var locals_box = (*lo).locals
    if (*locals_box).count < 4096 {
        let idx = (*locals_box).count
        (*(*locals_box).names).values[idx as usize] = name
        (*(*locals_box).regs).values[idx as usize] = reg
        (*(*locals_box).depths).values[idx as usize] = (*lo).scope_depth
        (*(*locals_box).struct_types).values[idx as usize] = ir_empty_name()
        (*(*locals_box).array_elem_float).values[idx as usize] = 0
        (*(*locals_box).array_lens).values[idx as usize] = -1
        (*(*locals_box).array_copy_word_scalar).values[idx as usize] = 0
        (*(*locals_box).wide_bits).values[idx as usize] = 0
        (*(*locals_box).wide_signed).values[idx as usize] = 0
        // Findings 11 (#2084): zero-init the per-slot unsigned-int flag.
        (*(*locals_box).is_unsigned_int).values[idx as usize] = 0
        (*(*locals_box).global_bss_offsets).values[idx as usize] = 0
        (*(*locals_box).global_bss_sizes).values[idx as usize] = 0
        (*(*locals_box).is_global).values[idx as usize] = 0
        (*(*locals_box).is_ref).values[idx as usize] = 0
        (*(*locals_box).scalar_kind).values[idx as usize] = 0
        // Post-#2084: tuple0_array_elem_layout was added on main to track when a
        // tuple slot-0 is a fixed array, which gates the aggregate-shallow-copy path.
        (*(*locals_box).tuple0_array_elem_layout).values[idx as usize] = 0 - 1
        (*(*locals_box).variance_regs).values[idx as usize] = -1
        // Explicit -1: the locals stack is REUSED across functions (count is
        // reset, arrays are not), so a stale box_inner_layout from an earlier
        // function's Box param leaks into an unrelated local rebound at the
        // same slot and turns its plain field access into a phantom Box deref.
        (*(*locals_box).box_inner_layout).values[idx as usize] = 0 - 1
        (*locals_box).count = idx + 1
        (*lo).locals = locals_box
    } else {
        lowerer_mark_error(lo)
    }
}

fn lowerer_bind_local_box_inner_mut(lo: &! Lowerer, name: Name, layout_idx: i64) with Mut, Alloc, Panic, Div {
    if layout_idx < 0 { return }
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).box_inner_layout).values[i as usize] = layout_idx
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

// *mut analogue: mark a just-bound param/local as a reference-typed binding so
// field/index lowering can emit the extra dereference for &P / &[T;N] params.
fn lowerer_mark_local_ref_mut(
    lo: &! Lowerer,
    name: Name
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).is_ref).values[i as usize] = 1
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

// *mut analogue of bind_local_array_elem_float: record that a local/param array has
// f64 elements, so `arr[i]` reads classify as float in arithmetic/comparisons. Single-
// level store through the Box (safe under the by-value-aggregate miscompile). The
// value-returning `(*lo) = (*lo).bind_local_array_elem_float(name)` form silently
// dropped this update for f64 ARRAY PARAMS (local arrays thread `lo` by value and were
// unaffected) — so `acf[i] + acf[j]` over an f64 array param fell to the integer path.
fn lowerer_mark_local_array_elem_float_mut(
    lo: &! Lowerer,
    name: Name
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).array_elem_float).values[i as usize] = 1
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

fn lowerer_mark_local_scalar_kind_mut(
    lo: &! Lowerer,
    name: Name,
    kind: i64
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).scalar_kind).values[i as usize] = kind
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

fn lowerer_mark_local_fn_ptr_ret_float_mut(
    lo: &! Lowerer,
    name: Name
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).fn_ptr_ret_float).values[i as usize] = 1
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

// *mut analogue of bind_local_fixed_array_len: the active summary-owned
// parameter path must update the LocalStack through its Box. Reassigning a
// by-value Lowerer silently loses this metadata in current-source Madaros.
fn lowerer_bind_local_fixed_array_len_mut(
    lo: &! Lowerer,
    name: Name,
    array_len: i64
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).array_lens).values[i as usize] = array_len
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

// *mut analogue of bind_local_array_copy_word_scalar. This bit is the second
// half of the inferred fixed-array copy predicate in lower_let_stmt_ref.
fn lowerer_mark_local_array_copy_word_scalar_mut(
    lo: &! Lowerer,
    name: Name
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).array_copy_word_scalar).values[i as usize] = 1
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

// *mut analogue of bind_local_struct_type: record a local/param's struct type so
// `recv.method()` and `recv.field` resolve the receiver type. Single-level store through
// the Box (safe under the by-value-aggregate miscompile). No-op for non-struct types.
fn lowerer_bind_local_struct_type_mut(
    lo: &! Lowerer,
    name: Name,
    type_name: Name
) with Mut, Alloc, Panic, Div {
    if type_name.len <= 0 { return }
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).struct_types).values[i as usize] = type_name
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

fn lowerer_bind_local_index_elem_layout_mut(
    lo: &! Lowerer,
    name: Name,
    layout_idx: i64
) with Mut, Alloc, Panic, Div {
    if layout_idx < 0 { return }
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).tuple0_array_elem_layout).values[i as usize] = layout_idx
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

fn lowerer_mark_local_global_mut(
    lo: &! Lowerer,
    name: Name,
    bss_offset: i64,
    bss_size: i64
) with Mut, Alloc, Panic, Div {
    var locals_box = (*lo).locals
    var i = (*locals_box).count - 1
    while i >= 0 {
        if (*(*locals_box).depths).values[i as usize] <= (*lo).scope_depth && ir_name_eq((*(*locals_box).names).values[i as usize], name) {
            (*(*locals_box).global_bss_offsets).values[i as usize] = bss_offset
            (*(*locals_box).global_bss_sizes).values[i as usize] = bss_size
            (*(*locals_box).is_global).values[i as usize] = 1
            (*lo).locals = locals_box
            return
        }
        i = i - 1
    }
}

fn lowerer_fresh_reg_mut(lo: &! Lowerer) -> i64 with Mut, Panic, Div {
    if (*lo).current_fn < 0 || (*lo).current_fn >= (*(*lo).module).fn_count {
        lowerer_mark_error(lo)
        return 0
    }
    var current_func_box = (*lo).current_func
    let reg = (*current_func_box).reg_count
    (*current_func_box).reg_count = reg + 1
    (*lo).current_func = current_func_box
    reg
}

// `self` reaches lowering UNTYPED. parser/items.sio:1741 gives the receiver a
// dummy_type_expr() unless the source wrote `self: T`, so lower_param_struct_type_name
// answers empty, struct_types[self] stays empty, and every `self.a.b` loses its base
// type -- the chained field index then falls to the cross-struct first-match scan.
// Measured: `self.n` came out right (7) while `self.boxed.a/.b/.c` came out 1/0/0
// against 10/20/30. Not a crash; a wrong number.
//
// The owner type is recoverable WITHOUT string surgery. A method's own name is
// ir_mangle_method_name(T, M) = T + "_" + M, so a registered layout T matches when
// its bytes prefix the name and the next byte is '_'. LONGEST match wins and an
// ambiguous tie binds NOTHING: `Foo` and `Foo_bar` can both prefix `Foo_bar_baz`,
// and choosing between them is exactly how a wrong layout gets picked silently.
// Refusing leaves today's behaviour in place -- the discipline the 8-byte
// struct-name collision fix settled on.
//
// A FREE function over the table, not a `self` method: every earlier attempt to
// read a side table through a by-value `self` on a param/field path copied the
// whole Lowerer and broke the build (see lower_lookup_box_inner_layout, which
// exists for exactly this reason).
fn lower_self_owner_type_from_mangled(table: &StructLayoutTable, fn_name: Name) -> Name with Mut, Panic, Div {
    var best = ir_empty_name()
    var best_len: i64 = 0
    var ties: i64 = 0
    var si: i64 = 0
    while si < (*table).count {
        let t = (*table).entries[si as usize].type_name
        if t.len > 0 && (t.len + 1) < fn_name.len {
            var k: i64 = 0
            var same = true
            while k < t.len {
                if fn_name.buf[k as usize] != t.buf[k as usize] {
                    same = false
                }
                k = k + 1
            }
            if same && (fn_name.buf[t.len as usize] as i64) == 95 {
                if t.len > best_len {
                    best = t
                    best_len = t.len
                    ties = 0
                } else if t.len == best_len && !ir_name_eq(t, best) {
                    ties = ties + 1
                }
            }
        }
        si = si + 1
    }
    if ties > 0 {
        return ir_empty_name()
    }
    best
}

// Rebind the receiver's struct type once the params are in place. Only the
// param flagged is_self, and only when it declared no type of its own, so an
// explicit `self: T` still wins and every non-receiver param is untouched.
fn lowerer_bind_self_owner_type_mut(
    lo: &! Lowerer,
    params: &Option<Box<ParamList>>,
    fn_name: Name
) with IO, Mut, Panic, Div, Alloc {
    var current = params
    while true {
        match *current {
            Some(list) => {
                if (*list).head.is_self && lower_param_struct_type_name(&(*list).head.ty).len == 0 {
                    let owner = lower_self_owner_type_from_mangled(&(*(*lo).struct_layouts), fn_name)
                    if owner.len > 0 {
                        lowerer_bind_local_struct_type_mut(lo, (*list).head.name, owner)
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_lower_fn_params_mut(
    lo: &! Lowerer,
    params: &Option<Box<ParamList>>
) with IO, Mut, Panic, Div, Alloc {
    var current = params
    while true {
        match *current {
            Some(list) => {
                if lower_live_diag_enabled() {
                    print("lower_live: param_loop name=")
                    print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                    print(" fn_id=")
                    print_int((*lo).current_fn)
                    print(" fn_count=")
                    print_int((*(*lo).module).fn_count)
                    print("\n")
                }
                let preg = lowerer_fresh_reg_mut(lo)

                let fn_id = (*lo).current_fn
                if fn_id < 0 || fn_id >= (*(*lo).module).fn_count {
                    lowerer_mark_error(lo)
                } else {
                    var current_func_box = (*lo).current_func
                    if (*current_func_box).param_count < IR_MAX_PARAMS {
                        let param_count = (*current_func_box).param_count
                        (*current_func_box).param_regs[param_count as usize] = preg
                        (*current_func_box).param_count = param_count + 1
                        (*lo).current_func = current_func_box
                        if lower_live_diag_enabled() {
                            print("lower_live: param_count_now=")
                            print_int((*current_func_box).param_count)
                            print("\n")
                        }
                    } else {
                        lowerer_mark_error(lo)
                    }
                }

                if lower_type_expr_is_f64(&(*list).head.ty) {
                    var current_func_box2 = (*lo).current_func
                    let instr_count = (*current_func_box2).instr_count
                    if instr_count < IR_MAX_INSTRS {
                        ir_arena_store(ir_region_slot_w((*current_func_box2).region, (instr_count)), ir_mark_float_reg(preg))
                        // #1669: this store bypasses Lowerer.emit, so the bit has
                        // to be set beside it. f64 PARAMS are the purest orphan
                        // fact -- there is no defining instruction to ride on.
                        let _fb = ir_float_bits_set(&! (*current_func_box2), preg)
                        (*current_func_box2).instr_count = instr_count + 1
                        (*lo).current_func = current_func_box2
                    } else {
                        lowerer_mark_error(lo)
                    }
                }

                let param_array_len = lower_type_expr_fixed_array_len_ref(&(*list).head.ty)
                let param_word_scalar = lower_type_expr_fixed_array_word_scalar_ref(&(*list).head.ty)
                var param_value_reg = preg
                if param_array_len >= 0 && param_word_scalar {
                    let copy_pair = (*lo).emit_fixed_array_value_copy(
                        preg,
                        param_array_len,
                        lower_type_expr_is_array_of_f64(&(*list).head.ty),
                    )
                    (*lo) = copy_pair.0
                    param_value_reg = copy_pair.1
                }

                lowerer_bind_local_mut(lo, (*list).head.name, param_value_reg, (*list).head.is_self_mut)
                if param_array_len >= 0 {
                    lowerer_bind_local_fixed_array_len_mut(lo, (*list).head.name, param_array_len)
                }
                if param_word_scalar {
                    lowerer_mark_local_array_copy_word_scalar_mut(lo, (*list).head.name)
                }
                lowerer_bind_local_struct_type_mut(lo, (*list).head.name, lower_param_struct_type_name(&(*list).head.ty))
                let param_seq_elem = lower_type_expr_seq_named_elem_name(&(*list).head.ty)
                lowerer_bind_local_index_elem_layout_mut(
                    lo,
                    (*list).head.name,
                    lower_struct_layout_index_of(&(*(*lo).struct_layouts), param_seq_elem),
                )
                // D5+D1 (#986+#983): path-A param scalar_kind must use the single-level
                // Box store. The by-value `(*lo) = (*lo).bind_local_scalar_kind(...)`
                // RMW is dropped by the by-value-aggregate-store miscompile, leaving
                // f64 params at kind 0 so `x as i64` bitcasts (IEEE payload) instead of
                // truncating. Bind any word-size integer (i32/i64/u64/…) → 1 so
                // println of int params stays on print_int (i64-only left i32 at 0).
                if lower_type_expr_is_f64(&(*list).head.ty) {
                    lowerer_mark_local_scalar_kind_mut(lo, (*list).head.name, 2)
                } else if lower_type_expr_fn_returns_f64(&(*list).head.ty) {
                    lowerer_mark_local_fn_ptr_ret_float_mut(lo, (*list).head.name)
                } else if lower_type_expr_is_integer(&(*list).head.ty) {
                    lowerer_mark_local_scalar_kind_mut(lo, (*list).head.name, 1)
                } else if lower_type_expr_is_bool(&(*list).head.ty) {
                    // println bool-segfault fix (2026-08-17): bool param → kind 1
                    // (print_int, 1/0), mirroring the int-param case above so
                    // println(b) does not route the bool value through the char*
                    // printer. This is the load-bearing param path (path-A).
                    lowerer_mark_local_scalar_kind_mut(lo, (*list).head.name, 1)
                }
                if lower_type_expr_is_ref_like(&(*list).head.ty) {
                    lowerer_mark_local_ref_mut(lo, (*list).head.name)
                }
                if lower_type_expr_is_box(&(*list).head.ty) {
                    let bl = lower_struct_layout_index_of(&(*(*lo).struct_layouts), lower_box_inner_type_name(&(*list).head.ty))
                    lowerer_bind_local_box_inner_mut(lo, (*list).head.name, bl)
                    if str_eq(read_env("SOUNIO_BOX_TRACE"), "1") {
                        print("boxtrace: WRITE-A ")
                        print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                        print(" layout=")
                        print_int(bl)
                        print("\n")
                    }
                }
                if lower_type_expr_is_array_of_f64(&(*list).head.ty) {
                    lowerer_mark_local_array_elem_float_mut(lo, (*list).head.name)
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

// Avoid entering the multi-branch block frame for the canonical hello body.
// Returns IR_INVALID_REG when the shape does not match.
fn lowerer_try_canonical_hello_block_mut(lo: &! Lowerer, blk: &Block) -> i64 with Mut, Panic, Div, Alloc, IO {
    match (*blk).stmts {
        Some(stmts) => {
            match (*stmts).tail {
                Some(rest) => {
                    match (*rest).tail {
                        None => {}
                        _ => { return IR_INVALID_REG }
                    }
                    let stmt = (*stmts).head
                    let ret_stmt = (*rest).head
                    if stmt.kind != StmtKind::StmtExpr || ret_stmt.kind != StmtKind::StmtExpr { return IR_INVALID_REG }
                    match stmt.expr {
                        Some(expr) => {
                            match ret_stmt.expr {
                                Some(ret_expr) => {
                                    if (*expr).kind != ExprKind::ExprCall || (*ret_expr).kind != ExprKind::ExprReturn { return IR_INVALID_REG }
                                    match (*expr).left {
                                        Some(callee) => {
                                            if (*callee).kind != ExprKind::ExprIdent || !ir_name_eq((*callee).name, make_name("println")) { return IR_INVALID_REG }
                                            match (*expr).args {
                                                Some(args) => {
                                                    if (*args).head.kind != ExprKind::ExprStringLit { return IR_INVALID_REG }
                                                    match (*args).tail { None => {}, _ => { return IR_INVALID_REG } }
                                                    match (*ret_expr).left {
                                                        Some(ret_value) => {
                                                            if (*ret_value).kind != ExprKind::ExprIntLit || (*ret_value).int_val != 0 { return IR_INVALID_REG }
                                                            let saved_local_count = (*(*lo).locals).count
                                                            (*lo).scope_depth = (*lo).scope_depth + 1
                                                            let print_pair = (*lo).lower_println_string_literal_ref((*args).head.name)
                                                            (*lo) = print_pair.0
                                                            let ret_pair = (*lo).emit_i64_const(0)
                                                            (*lo) = ret_pair.0.emit(ir_return(ret_pair.1))
                                                            if (*lo).scope_depth > 0 { (*lo).scope_depth = (*lo).scope_depth - 1 }
                                                            (*(*lo).locals).count = saved_local_count
                                                            return ret_pair.1
                                                        }
                                                        None => { return IR_INVALID_REG }
                                                    }
                                                }
                                                None => { return IR_INVALID_REG }
                                            }
                                        }
                                        None => { return IR_INVALID_REG }
                                    }
                                }
                                None => { return IR_INVALID_REG }
                            }
                        }
                        None => { return IR_INVALID_REG }
                    }
                }
                _ => {}
            }
        }
        None => {}
    }
    IR_INVALID_REG
}

fn lowerer_lower_fn_item_mut(
    lo: &! Lowerer,
    name: Name,
    fd: &FnDef
) with Mut, Panic, Div, Alloc, IO {
    ir_instr_overflow_begin_fn()
    // Correlations are per-function. FO_COV_RHO is a module global while the
    // channel ids that index it are Lowerer fields reset per function, so a
    // `correlate(a, b, 1.0)` in one function silently supplied rho to the next
    // one to reach the same channel pair -- fabricating a dependence no source
    // line asked for. Measured: a function that never mentions correlation read
    // Var(c+d) = 0.16 instead of 0.10, the previous function's number entire.
    //
    // Both this reset and the FO channel-table reset below originally lived in a
    // by-value `begin_function_body_lowering` that the *mut port left with zero
    // callers, so none of it ran. #2145 moved the correlation reset onto this live
    // path (the miscompile it measured is above); #2143 moved the channel table
    // (fo_nchan / fo_sigma2 / fo_bind_count) here too and removed the dead function.
    var fo_cri: i64 = 0
    while fo_cri < 64 {
        FO_COV_RHO[fo_cri as usize] = 0.0
        fo_cri = fo_cri + 1
    }
    // #2143 (sibling of #2145): the FO channel table is keyed by vreg, which restarts
    // per function. The *mut port left its reset only in the (now-removed) dead
    // by-value original, so fo_nchan / fo_sigma2 (the live channel map read by
    // fo_seed_from_variance's reuse check at `fo_sigma2[k] == variance_reg`) / fo_bind_count
    // accumulate across a module's functions. Currently masked -- fo_expr_sens and
    // FO_HOFF are cleared per seed and FO_COV_RHO is reset just above, so stale
    // channels stay inert -- but the reuse check `fo_sigma2[k] == variance_reg` reads
    // stale entries, and the reset belongs on the confirmed live path beside the
    // correlation reset, not in dead code. (FO_SIGMA_REG is a write-only mirror; reset
    // for parity.)
    (*lo).fo_nchan = 0
    (*lo).fo_bind_count = 0
    var fo_sri: i64 = 0
    while fo_sri < 32 {
        (*lo).fo_sigma2[fo_sri as usize] = -1
        FO_SIGMA_REG[fo_sri as usize] = -1
        fo_sri = fo_sri + 1
    }
    // Seed the transcendental chain-rule entries here, on the confirmed live path.
    //
    // fo_xfer_global_reset (:3578, :9019) and lowerer_lower_program_bodies_dedup_mut
    // both looked like the initialisation point and neither runs for a
    // single-module compile — verified with unconditional prints that never fired.
    // The dedup path is reached only through
    // lower_dep_program_items_into_acc_with_externs, i.e. imports. THIS function is
    // the one that emits the lower_live fn_* traces a plain compile produces, so it
    // is the one that actually executes.
    //
    // fo_xfer_global_set is idempotent per name — it overwrites an existing entry
    // rather than appending — so seeding once per function costs three table writes
    // and cannot grow the table beyond its three entries.
    fo_xfer_seed_transcendentals()
    ir_instr_overflow_begin_fn()
    lower_rss_mark("fn_enter")
    (*lo).so_enabled = so_block_uses_hessian(&(*fd).body)
    lower_rss_mark("after_hessian_scan")
    if lower_live_diag_enabled() {
        print("lower_live: fn_before_find_or_add name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }
    let fn_id = lowerer_find_or_add_fn_id_mut(lo, name)
    lower_rss_mark("after_findfn")
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_find_or_add name=")
        print(str_from_bytes(name.buf, name.len))
        print(" fn_id=")
        print_int(fn_id)
        print(" fn_count=")
        print_int((*(*lo).module).fn_count)
        print("\n")
    }
    if fn_id < 0 {
        return
    }

    if lower_live_diag_enabled() {
        print("lower_live: fn_begin name=")
        print(str_from_bytes(name.buf, name.len))
        print(" fn_id=")
        print_int(fn_id)
        print("\n")
    }

    lowerer_flush_current_func_mut(lo)
    (*lo).current_fn = fn_id
    // REUSE the Box the Lowerer already holds. `var f = ir_empty_function()`
    // followed by `Box::new(f)` allocated ~673 KB per function against a bump
    // cursor that never reclaims, which is the whole of the 1417 KB/function
    // this compile costs. Resetting in place costs a memset of the USED prefix.
    var reused = (*lo).current_func
    ir_reset_function_in_place(&! (*reused), name)
    if fn_id >= 0 && fn_id < (*(*lo).module).fn_count {
        // One get, not eight — each ir_fn_get may materialise a large temp under seed.
        let preserved = ir_fn_get(&(*(*lo).module), fn_id as usize)
        (*reused).name = preserved.name
        (*reused).compile_strategy = preserved.compile_strategy
        (*reused).returns_float = preserved.returns_float
        (*reused).return_fixed_array_len = preserved.return_fixed_array_len
        (*reused).return_struct_name = preserved.return_struct_name
        (*reused).first_param_is_ref = preserved.first_param_is_ref
        (*reused).prof_counter_id = preserved.prof_counter_id
        // #1649: carry the REGION over too, and do NOT drop this. This is exactly
        // where the arena conversion lost it: every field restored from the slot
        // EXCEPT the one saying where the instructions live, so every instruction
        // this function lowered went to quarantine. ir_reset_function_in_place
        // leaves the region invalid by design, so the restore must be explicit.
        (*reused).region = preserved.region
    }
    if (*reused).region.slot < 0 { ir_function_alloc_region(&! (*reused)) }
    (*lo).current_func = reused
    (*lo).current_func_loaded = true
    (*lo).env = None
    var rst_locals = (*lo).locals
    (*rst_locals).count = 0
    (*lo).locals = rst_locals
    (*lo).scope_depth = 0
    (*lo).loop_depth = 0
    // D5 (#986): these tables are keyed by vreg number, which restarts at 0 in
    // every function. Without a per-function reset, float/variance registrations
    // from an earlier f64-param function (param reg 0, etc.) leak into later
    // functions and make `var i = 0 as i64; i = i + 1` lower as float-add
    // (IEEE 1.0 bits) once f64 params correctly carry scalar_kind=2.
    (*lo).array_elem_float_reg_count = 0
    (*lo).variance_base_reg_count = 0
    (*lo).pending_variance_reg = -1
    (*lo).pending_closure_fn_id = -1
    // Inter-procedural FO: register pure-fn transfer before body lower so later
    // callers (e.g. main) see helpers defined earlier in the module.
    // Note: fo_xfer_* is NOT cleared per-function — it accumulates across the module.
    let lo_xfer = (*lo).fo_register_pure_fn_transfer(name, fd)
    lower_rss_mark("after_fo_register")
    (*lo) = lo_xfer
    if lower_live_diag_enabled() {
        print("lower_live: fn_state_after_begin current_fn=")
        print_int((*lo).current_fn)
        print(" fn_count=")
        print_int((*(*lo).module).fn_count)
        print("\n")
        print("lower_live: fn_after_begin name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }

    let strategy = lowerer_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
    lower_rss_mark("after_strategy")
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_strategy name=")
        print(str_from_bytes(name.buf, name.len))
        print(" strategy=")
        print_int(strategy)
        print("\n")
    }
    // Sprint 108/109: preserve extern/exported strategy set during preseed
    var strategy_func_box = (*lo).current_func
    let preseed_strategy_m = (*strategy_func_box).compile_strategy
    if preseed_strategy_m == 6 || preseed_strategy_m == 7 {
        (*strategy_func_box).compile_strategy = preseed_strategy_m
    } else {
        (*strategy_func_box).compile_strategy = strategy
    }
    (*strategy_func_box).returns_float = lower_opt_return_float_code(&fd.return_type)
    (*strategy_func_box).return_fixed_array_len = lower_opt_type_return_fixed_array_code(&fd.return_type)
    (*strategy_func_box).return_struct_name = lower_opt_type_return_layout_name(&fd.return_type)
    (*strategy_func_box).first_param_is_ref = lower_fn_first_param_is_ref(&fd.params)
    (*lo).current_func = strategy_func_box

    // #1547: an extern "C" declaration has no body. Flush it now as an
    // instr_count == 0 stub (keeping the returns_float metadata computed
    // above) so codegen builtin dispatch — every gate requires
    // instr_count == 0 — applies. Params are deliberately NOT lowered:
    // lowerer_lower_fn_params_mut emits ir_mark_float_reg for f64 params,
    // which would push instr_count > 0 and re-break dispatch.
    // Do NOT mark these slots compile_strategy == 6 (IR_STRATEGY_EXTERN):
    // call lowering (lower.sio callee_strat_ext == 6) emits IrCallExtern for
    // such callees, and native v2 codegen has no IrCallExtern arm — every
    // caller fails with rc=12. The ic==0 stub is what dispatch needs.
    if fd.is_extern {
        lowerer_flush_current_func_mut(lo)
        (*lo).current_fn = IR_INVALID_FN
        return
    }

    if strategy == IR_STRATEGY_INSTRUMENTED {
        var instr_func_box = (*lo).current_func
        if (*instr_func_box).prof_counter_id < 0 {
            var module = *(*lo).module
            let ctr_idx = module.prof_counter_count
            if ctr_idx < 64 {
                module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                    fn_id: fn_id,
                    fn_name: (*instr_func_box).name,
                    counter_id: ctr_idx,
                }
                module.prof_counter_count = ctr_idx + 1
                (*instr_func_box).prof_counter_id = ctr_idx
                (*lo).current_func = instr_func_box
                (*lo).module = Box::new(module)
            }
        }
        (*lo) = (*lo).ir_lower_inject_validated_param(fn_id)
    }

    (*lo).scope_depth = (*lo).scope_depth + 1
    // Parameters are assigned consecutive vregs by lowerer_lower_fn_params_mut,
    // which calls lowerer_fresh_reg_mut once per parameter in declaration order.
    // Capturing the counter here lets parameter i be addressed as base + i.
    let kernel_param_reg_base = (*(*lo).current_func).reg_count
    if ir_param_list_count_ref(&fd.params) > 0 {
        lowerer_lower_fn_params_mut(lo, &fd.params)
        // The receiver's type, which the parser did not supply. Bound HERE and
        // not inside lowerer_lower_fn_params_mut because the mangled name lives
        // in this frame; the params walker never sees it.
        //
        // The first attempt patched lower_fn_params_ref, the by-value twin, and
        // measured no change at all -- that function is reached only from
        // lower_fn_item_owned / lower_fn_item_ref, and NEITHER has a caller
        // anywhere in self-hosted/. Dead twins of a live path is a known shape
        // here (codegen carries seven compile_ir_function variants, one live).
        lowerer_bind_self_owner_type_mut(lo, &fd.params, name)
    }
    lower_rss_mark("after_params")
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_params name=")
        print(str_from_bytes(name.buf, name.len))
        print(" param_count=")
        print_int((*(*lo).current_func).param_count)
        print("\n")
    }

    // ---- kernel CPU lane loop (#1504) ----
    // A `kernel fn` on a CPU host must run its body once per lane, not once with
    // every GPU intrinsic reading 0 — the latter is a silent wrong answer, correct
    // at index 0 and zero everywhere else. lean_single has emitted this fallback
    // in x86 since lean_single.sio:29335; expressing it here in the IR gives the
    // Madaros path the same semantics without touching a backend.
    //
    //   tid = 0
    // top:
    //   if !(tid < extent) goto end
    //   <body>            // gpu_thread_id_x() lowers to a copy of tid
    //   tid = tid + 1
    //   goto top
    // end:
    var kernel_tid_reg: i64 = 0 - 1
    var kernel_top_label: i64 = 0 - 1
    var kernel_end_label: i64 = 0 - 1
    var kernel_cont_label: i64 = 0 - 1
    if fd.is_kernel {
        let kernel_extent_idx = lower_kernel_extent_param_index(&fd.params)
        if kernel_extent_idx >= 0 {
            let kernel_extent_reg = kernel_param_reg_base + kernel_extent_idx
            kernel_tid_reg = lowerer_fresh_reg_mut(lo)
            (*lo) = (*lo).emit(ir_load_imm(kernel_tid_reg, 0))
            let ktop_pair = (*lo).fresh_label()
            (*lo) = ktop_pair.0
            kernel_top_label = ktop_pair.1
            let kend_pair = (*lo).fresh_label()
            (*lo) = kend_pair.0
            kernel_end_label = kend_pair.1
            let kcont_pair = (*lo).fresh_label()
            (*lo) = kcont_pair.0
            kernel_cont_label = kcont_pair.1
            (*lo) = (*lo).emit(ir_label(kernel_top_label))
            let kcond_reg = lowerer_fresh_reg_mut(lo)
            (*lo) = (*lo).emit(ir_binop(kcond_reg, kernel_tid_reg, BinaryOp::OpLt, kernel_extent_reg))
            (*lo) = (*lo).emit(ir_branch_false(kcond_reg, kernel_end_label))
            LOWER_KERNEL_TID_REG = kernel_tid_reg
            LOWER_KERNEL_CONT_LABEL = kernel_cont_label
        }
    }

lower_rss_mark("before_block")
    var result_reg = lowerer_try_canonical_hello_block_mut(lo, &fd.body)
    if result_reg == IR_INVALID_REG {
        let bpair = (*lo).lower_block_ref(&fd.body)
        (*lo) = bpair.0
        result_reg = bpair.1
    }

    if kernel_tid_reg >= 0 {
        LOWER_KERNEL_TID_REG = 0 - 1
        LOWER_KERNEL_CONT_LABEL = 0 - 1
        // Lane-continue target: `return` inside the body jumps here, so it ends
        // the lane and the next one still runs.
        (*lo) = (*lo).emit(ir_label(kernel_cont_label))
        let kone_pair = (*lo).emit_i64_const(1)
        (*lo) = kone_pair.0
        let kone_reg = kone_pair.1
        let knext_reg = lowerer_fresh_reg_mut(lo)
        (*lo) = (*lo).emit(ir_binop(knext_reg, kernel_tid_reg, BinaryOp::OpAdd, kone_reg))
        (*lo) = (*lo).emit(ir_copy(kernel_tid_reg, knext_reg))
        (*lo) = (*lo).emit(ir_jump(kernel_top_label))
        (*lo) = (*lo).emit(ir_label(kernel_end_label))
    }
    lower_rss_mark("after_block")
    // ---- end kernel CPU lane loop ----
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_block name=")
        print(str_from_bytes(name.buf, name.len))
        print(" result_reg=")
        print_int(result_reg)
        print(" instrs_current=")
        print_int((*(*lo).current_func).instr_count)
        print(" regs_current=")
        print_int((*(*lo).current_func).reg_count)
        print("\n")
    }

    if !(*lo).fn_ends_with_return() {
        if lower_opt_type_is_unit_or_implicit(&fd.return_type) {
            let unit_pair = (*lo).emit_unit()
            (*lo) = unit_pair.0
            (*lo) = (*lo).emit(ir_return(unit_pair.1))
        } else {
            (*lo) = (*lo).emit(ir_return(result_reg))
        }
    }
    if lower_live_diag_enabled() {
        print("lower_live: fn_after_return_check name=")
        print(str_from_bytes(name.buf, name.len))
        print(" instrs_current=")
        print_int((*(*lo).current_func).instr_count)
        print(" regs_current=")
        print_int((*(*lo).current_func).reg_count)
        print("\n")
    }

    if (*lo).scope_depth > 0 {
        (*lo).scope_depth = (*lo).scope_depth - 1
    }
    lowerer_flush_current_func_mut(lo)
    lower_rss_mark("after_flush")
    (*lo).current_fn = IR_INVALID_FN
    // #1586/#1645: the body did not fit. Report at the END of the function, so
    // the message carries what it actually needed rather than only that it
    // overflowed -- that number is what decides whether the limit is off by a
    // factor of two or a factor of ten (#1649).
    // Census AFTER the flush, so instr_count is the settled value. On overflow
    // instr_count is pinned at the cap and the true need is cap + dropped.
    if !(*lo).probe_mode && fn_id >= 0 && fn_id < IR_MAX_FUNCS {
        let settled = ir_fn_get(&(*(*lo).module), fn_id as usize).instr_count
        ir_instr_census_record(settled + IR_INSTR_OVERFLOW_COUNT, IR_INSTR_OVERFLOW_COUNT > 0)
    }
    if IR_INSTR_OVERFLOW_COUNT > 0 && !(*lo).probe_mode {
        print("error: function `")
        print(str_from_bytes(name.buf, name.len))
        print("` needs ")
        print_int(IR_MAX_INSTRS + IR_INSTR_OVERFLOW_COUNT)
        print(" IR instructions but IR_MAX_INSTRS is ")
        print_int(IR_MAX_INSTRS)
        print("; split it into smaller functions\n")
    }
    if lower_live_diag_enabled() {
        print("lower_live: fn_done name=")
        print(str_from_bytes(name.buf, name.len))
        print("\n")
    }
    lower_rss_mark("fn_exit")
}

fn lowerer_lower_impl_methods_mut(
    lo: &! Lowerer,
    type_name: Name,
    methods: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = methods
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, item.name)
                    match item.fn_def {
                        Some(fd) => {
                            lowerer_lower_fn_item_mut(lo, mangled, &(*fd))
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
}

// Multi-pass FO pure-fn transfer registration.
// Nested helper expand needs callees already in FO_XFER. Source order may put
// callers first — one pass leaves them without FO; re-register until nested
// expands see leaf helpers. Does not lift the >2-param skip.
fn lowerer_fo_preregister_pure_fns_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var current = items
    while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                    match *fn_def_opt_ref {
                        Some(fd) => {
                            let lo_x = (*lo).fo_register_pure_fn_transfer(head.name, &(*fd))
                            (*lo) = lo_x
                        }
                        _ => {}
                    }
                } else if head.kind == ItemKind::ItemImpl {
                    let impl_def_opt_ref: &Option<Box<ImplDef>> = &head.impl_def
                    match *impl_def_opt_ref {
                        Some(id) => {
                            var mcur = &(*id).methods
                            while true {
                                match *mcur {
                                    Some(mlist) => {
                                        let mhead = &(*mlist).head
                                        if mhead.kind == ItemKind::ItemFn {
                                            let mfd_opt: &Option<Box<FnDef>> = &mhead.fn_def
                                            match *mfd_opt {
                                                Some(fd) => {
                                                    let mangled = ir_mangle_method_name(head.name, mhead.name)
                                                    let lo_x = (*lo).fo_register_pure_fn_transfer(mangled, &(*fd))
                                                    (*lo) = lo_x
                                                }
                                                _ => {}
                                            }
                                        }
                                        mcur = &(*mlist).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                current = &(*list).tail
            }
            _ => break
        }
    }
}

fn lowerer_fo_preregister_pure_fns_multipass_mut(
    lo: &! Lowerer,
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    // 4 passes: reverse-order chains of depth 3 close by pass 4.
    var pass: i64 = 0
    while pass < 4 {
        lowerer_fo_preregister_pure_fns_mut(lo, items)
        pass = pass + 1
    }
}

// Multi-mod FO: register pure transfers for one program's items without body lower.
// FO_XFER is global — call once per loaded module *before* seed body lower so
// imported helpers (e.g. epistemic::fo::fo_add2) FO-transfer into user main.
pub fn fo_preregister_program_items_multipass(
    items: &Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new()
    lowerer_fo_preregister_pure_fns_multipass_mut(&! lo, items)
}

fn lowerer_lower_program_items_mut(
    lo: &! Lowerer,
    items: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc, IO {
    fo_xfer_global_reset()
    // Pre-register FO transfers so reverse-order pure helpers expand nested calls.
    lowerer_fo_preregister_pure_fns_multipass_mut(lo, &items)
    var current = items
    var item_count: i64 = 0
    while true {
        match current {
            Some(list) => {
                let item = (*list).head
                let kind = item.kind
                let name = item.name
                item_count = item_count + 1
                if item_count > IR_MAX_FUNCS { return }
                if lower_live_diag_enabled() {
                    print("lower_live: item kind=")
                    if kind == ItemKind::ItemFn { print("fn") }
                    else if kind == ItemKind::ItemStruct { print("struct") }
                    else if kind == ItemKind::ItemEnum { print("enum") }
                    else if kind == ItemKind::ItemImpl { print("impl") }
                    else { print("other") }
                    print(" name=")
                    print(str_from_bytes(name.buf, name.len))
                    print("\n")
                }
                if lower_ordered_diag_enabled() {
                    print("lower_ordered: item kind=")
                    if kind == ItemKind::ItemFn { print("fn") }
                    else if kind == ItemKind::ItemStruct { print("struct") }
                    else if kind == ItemKind::ItemEnum { print("enum") }
                    else if kind == ItemKind::ItemImpl { print("impl") }
                    else { print("other") }
                    print(" name=")
                    print(str_from_bytes(name.buf, name.len))
                    print("\n")
                }
                if kind == ItemKind::ItemFn {
                    match item.fn_def {
                        Some(fd) => {
                            lowerer_lower_fn_item_mut(lo, name, &(*fd))
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemStruct {
                    match item.struct_def {
                        Some(sd) => {
                            lowerer_register_struct_fields_mut(lo, name, &(*sd).fields, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemEnum {
                    match item.enum_def {
                        Some(ed) => {
                            lowerer_register_enum_variants_mut(lo, name, &(*ed).variants, 0)
                        }
                        _ => {}
                    }
                } else if kind == ItemKind::ItemImpl {
                    match item.impl_def {
                        Some(id) => {
                            lowerer_lower_impl_methods_mut(lo, name, (*id).methods)
                        }
                        _ => {}
                    }
                }
                current = (*list).tail
            }
            _ => break
        }
    }
}

// Sprint 87: helpers for ExprCast type-aware lowering
fn lower_cast_type_is_f64(ct: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    // Accepts f32 as well -- see lower_type_expr_is_f64. `as f32` matched neither
    // this nor the integer classifier, so a float source fell through to the
    // float_to_int arm of lower_cast_expr_ref and (1.5 as f32) became 1.0.
    match *ct {
        Some(te) => {
            let seg = (*te).path.segments
            if seg.head_len != 3 { return false }
            if seg.head_buf[0] as i64 != 102 { return false }   // f
            let is_64 = seg.head_buf[1] as i64 == 54 && seg.head_buf[2] as i64 == 52
            let is_32 = seg.head_buf[1] as i64 == 51 && seg.head_buf[2] as i64 == 50
            is_64 || is_32
        }
        None => false,
    }
}

fn lower_cast_type_is_i64(ct: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *ct {
        Some(te) => {
            let seg = (*te).path.segments
            if seg.head_len != 3 { return false }
            if seg.head_buf[0] as i64 != 105 { return false }   // 'i'
            if seg.head_buf[1] as i64 != 54 { return false }    // '6'
            if seg.head_buf[2] as i64 != 52 { return false }    // '4'
            true
        }
        None => false,
    }
}

fn lower_type_expr_is_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 3 { return false }
    if seg.head_buf[0] as i64 != 102 { return false }   // f
    // Accept BOTH f64 and f32: the backend has no separate f32 representation
    // (f32 is carried as f64), so all 17 call sites of this predicate mean
    // -- is this a float scalar? -- not -- is this spelled f64?. While f32 was
    // rejected here, a local declared f32 got scalar_kind 0 instead of 2, so
    // `x as f64` on it took the int_to_float arm and reinterpreted the bit
    // pattern of a double as an integer.
    let is_64 = seg.head_buf[1] as i64 == 54 && seg.head_buf[2] as i64 == 52
    let is_32 = seg.head_buf[1] as i64 == 51 && seg.head_buf[2] as i64 == 50
    is_64 || is_32
}

fn lower_type_expr_fn_returns_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeFn { return false }
    match (*te).inner {
        Some(ret) => lower_type_expr_is_f64(&(*ret)),
        None => false,
    }
}

// println i64-segfault fix: mirror lower_type_expr_is_f64 for i64 so a struct
// field's declared type can be positively classified as scalar-i64 (as opposed
// to merely "not float", which is also true of string/bool/struct fields).
fn lower_type_expr_is_i64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 3 { return false }
    if seg.head_buf[0] as i64 != 105 { return false }   // 'i'
    if seg.head_buf[1] as i64 != 54 { return false }    // '6'
    if seg.head_buf[2] as i64 != 52 { return false }    // '4'
    true
}

// println bool-segfault fix (2026-08-17): a `bool` type mention. bool prints
// via print_int (kind 1) — the literal path already lowers `true`/`false` as
// IntLit=1 and prints 1/0 — so any positively-known bool return/field/local must
// route to print_int too, not the char* printer that strlen's the bool value 1
// as a pointer (SIGSEGV). See docs/audit/MADAROS_PRINTLN_BOOL_SCALARKIND_SEGV.
fn lower_type_expr_is_bool(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 4 { return false }
    if seg.head_buf[0] as i64 != 98 { return false }    // 'b'
    if seg.head_buf[1] as i64 != 111 { return false }   // 'o'
    if seg.head_buf[2] as i64 != 111 { return false }   // 'o'
    if seg.head_buf[3] as i64 != 108 { return false }   // 'l'
    true
}

// println i64-segfault fix: a callee's return type name (ir_fn_get(&module, ..).
// return_struct_name, populated for ANY TypeNamed return type via
// lower_opt_type_named_name — not only actual structs) positively identifies a
// scalar i64 return, as opposed to returns_float==0 which is also true for
// string/bool/void/unresolved returns.
fn lower_name_is_i64_type(n: Name) -> bool with Div {
    n.len == 3
    && n.buf[0] == 105 as i8   // 'i'
    && n.buf[1] == 54 as i8    // '6'
    && n.buf[2] == 52 as i8    // '4'
}

// println bool-segfault fix (2026-08-17): a callee's return type name that is
// `bool`. Like lower_name_is_i64_type but for bool — used so a bool-returning
// call routes println to print_int (kind 1) instead of the char* printer.
fn lower_name_is_bool_type(n: Name) -> bool with Div {
    n.len == 4
    && n.buf[0] == 98 as i8    // 'b'
    && n.buf[1] == 111 as i8   // 'o'
    && n.buf[2] == 111 as i8   // 'o'
    && n.buf[3] == 108 as i8   // 'l'
}

// "string" named type (packed *u8, null-terminated) — NOT a GC array handle.
fn lower_name_is_string_type(n: Name) -> bool with Div {
    n.len == 6
    && n.buf[0] == 115 as i8   // 's'
    && n.buf[1] == 116 as i8   // 't'
    && n.buf[2] == 114 as i8   // 'r'
    && n.buf[3] == 105 as i8   // 'i'
    && n.buf[4] == 110 as i8   // 'n'
    && n.buf[5] == 103 as i8   // 'g'
}

// Builtins that return a packed *u8 string pointer (not a native-v2 GC array
// handle with 8-byte boxed slots). Indexing these via `s[i]` must use
// IrIndexGet label_id=3 (raw byte load) — the default local-array path does
// handle-table resolve + [base+idx*8] and SIGSEGVs on the packed pointer.
// Landmine documented in DATA_IO_TRILHA_B_BUILTIN_BUFPTR_DISPATCH_2026-07-14.
fn lower_name_is_packed_string_producer(n: Name) -> bool with Div {
    if n.len == 9 {
        // read_file
        let is_read_file = n.buf[0] == 114 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 97 as i8
            && n.buf[3] == 100 as i8 && n.buf[4] == 95 as i8 && n.buf[5] == 102 as i8
            && n.buf[6] == 105 as i8 && n.buf[7] == 108 as i8 && n.buf[8] == 101 as i8
        // str_slice
        let is_str_slice = n.buf[0] == 115 as i8 && n.buf[1] == 116 as i8 && n.buf[2] == 114 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 115 as i8 && n.buf[5] == 108 as i8
            && n.buf[6] == 105 as i8 && n.buf[7] == 99 as i8 && n.buf[8] == 101 as i8
        return is_read_file || is_str_slice
    }
    if n.len == 14 {
        // str_from_bytes
        return n.buf[0] == 115 as i8 && n.buf[1] == 116 as i8 && n.buf[2] == 114 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 102 as i8 && n.buf[5] == 114 as i8
            && n.buf[6] == 111 as i8 && n.buf[7] == 109 as i8 && n.buf[8] == 95 as i8
            && n.buf[9] == 98 as i8 && n.buf[10] == 121 as i8 && n.buf[11] == 116 as i8
            && n.buf[12] == 101 as i8 && n.buf[13] == 115 as i8
    }
    if n.len == 10 {
        // str_concat
        return n.buf[0] == 115 as i8 && n.buf[1] == 116 as i8 && n.buf[2] == 114 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 99 as i8 && n.buf[5] == 111 as i8
            && n.buf[6] == 110 as i8 && n.buf[7] == 99 as i8 && n.buf[8] == 97 as i8
            && n.buf[9] == 116 as i8
    }
    if n.len == 7 {
        // get_arg
        return n.buf[0] == 103 as i8 && n.buf[1] == 101 as i8 && n.buf[2] == 116 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 97 as i8 && n.buf[5] == 114 as i8
            && n.buf[6] == 103 as i8
    }
    false
}

// Builtins whose buffer argument is a native-v2 GC handle (index into the
// handle table), NOT a raw *u8 and NOT a slot address. Canonical call shape is
// handle-by-value: str_from_bytes(buf, n) / write_file(path, buf, n).
// native-v2 OpRef is LEA of the stack slot holding that handle, so &buf passes
// a pointer and resolve_handle SEGVs / writes garbage (#933 residual after #1247).
// Call-site auto-unwrap (strip OpRef / load handle from a ref-typed slot) makes
// &buf share the proven handle unpack path without changing the builtin body.
// Do NOT add an unconditional deref inside the builtin — that broke the
// canonical handle shape and Madaros self-host (see DATA_IO_TRILHA_B note).
fn lower_name_is_handle_buf_builtin(n: Name) -> bool with Div {
    if n.len == 14 {
        // str_from_bytes
        return n.buf[0] == 115 as i8 && n.buf[1] == 116 as i8 && n.buf[2] == 114 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 102 as i8 && n.buf[5] == 114 as i8
            && n.buf[6] == 111 as i8 && n.buf[7] == 109 as i8 && n.buf[8] == 95 as i8
            && n.buf[9] == 98 as i8 && n.buf[10] == 121 as i8 && n.buf[11] == 116 as i8
            && n.buf[12] == 101 as i8 && n.buf[13] == 115 as i8
    }
    if n.len == 10 {
        // write_file
        return n.buf[0] == 119 as i8 && n.buf[1] == 114 as i8 && n.buf[2] == 105 as i8
            && n.buf[3] == 116 as i8 && n.buf[4] == 101 as i8 && n.buf[5] == 95 as i8
            && n.buf[6] == 102 as i8 && n.buf[7] == 105 as i8 && n.buf[8] == 108 as i8
            && n.buf[9] == 101 as i8
    }
    false
}

// Buffer argument index for handle-buf builtins: str_from_bytes(buf,n) → 0,
// write_file(path,buf,n) → 1. -1 when not a handle-buf builtin.
fn lower_handle_buf_arg_index(n: Name) -> i64 with Div {
    if n.len == 14 {
        // str_from_bytes
        let ok = n.buf[0] == 115 as i8 && n.buf[1] == 116 as i8 && n.buf[2] == 114 as i8
            && n.buf[3] == 95 as i8 && n.buf[4] == 102 as i8 && n.buf[5] == 114 as i8
            && n.buf[6] == 111 as i8 && n.buf[7] == 109 as i8 && n.buf[8] == 95 as i8
            && n.buf[9] == 98 as i8 && n.buf[10] == 121 as i8 && n.buf[11] == 116 as i8
            && n.buf[12] == 101 as i8 && n.buf[13] == 115 as i8
        if ok { return 0 }
    }
    if n.len == 10 {
        // write_file
        let ok = n.buf[0] == 119 as i8 && n.buf[1] == 114 as i8 && n.buf[2] == 105 as i8
            && n.buf[3] == 116 as i8 && n.buf[4] == 101 as i8 && n.buf[5] == 95 as i8
            && n.buf[6] == 102 as i8 && n.buf[7] == 105 as i8 && n.buf[8] == 108 as i8
            && n.buf[9] == 101 as i8
        if ok { return 1 }
    }
    0 - 1
}

// Word-size integer type names for println/print scalar_kind=1 dispatch.
// Broader than i64-only: i8/i16/i32/i64, u8/u16/u32/u64, isize/usize.
// Does NOT include f32/f64 (kind 2), string, bool, or char — those keep their
// existing paths. Used when an annotated param/local or callee return is
// known-integer so print_int is selected instead of char* strlen → SEGV.
fn lower_name_is_integer_type(n: Name) -> bool with Div {
    if n.len == 2 {
        // i8 / u8
        return (n.buf[0] == 105 as i8 || n.buf[0] == 117 as i8)
            && n.buf[1] == 56 as i8
    }
    if n.len == 3 {
        // i16/u16/i32/u32/i64/u64
        if n.buf[0] != 105 as i8 && n.buf[0] != 117 as i8 {
            return false
        }
        let is_16 = n.buf[1] == 49 as i8 && n.buf[2] == 54 as i8
        let is_32 = n.buf[1] == 51 as i8 && n.buf[2] == 50 as i8
        let is_64 = n.buf[1] == 54 as i8 && n.buf[2] == 52 as i8
        return is_16 || is_32 || is_64
    }
    if n.len == 5 {
        // isize / usize
        let suffix = n.buf[1] == 115 as i8 && n.buf[2] == 105 as i8
            && n.buf[3] == 122 as i8 && n.buf[4] == 101 as i8
        return suffix && (n.buf[0] == 105 as i8 || n.buf[0] == 117 as i8)
    }
    false
}

// Findings 11 (#2084): the unsigned-restricted variant of
// lower_name_is_integer_type. Selects u8/u16/u32/u64/usize; rejects every
// signed integer, float, string, bool, char, named struct. Used by
// lower_binary_expr_ref to detect u8/u16/u32/u64 operands so the IR bin_op
// can be flipped to OpUDiv/OpURem/OpUShr before emitting the signed
// Sar/Idiv path. Without this, u64 `>>`/`/`/`%` above bit 63 silently use
// signed semantics.
fn lower_name_is_unsigned_int_type(n: Name) -> bool with Div {
    if n.len == 2 {
        // u8 only (i8 is excluded).
        return n.buf[0] == 117 as i8 && n.buf[1] == 56 as i8
    }
    if n.len == 3 {
        // u16 / u32 / u64 (i-prefixed names are excluded).
        if n.buf[0] != 117 as i8 { return false }
        let is_16 = n.buf[1] == 49 as i8 && n.buf[2] == 54 as i8
        let is_32 = n.buf[1] == 51 as i8 && n.buf[2] == 50 as i8
        let is_64 = n.buf[1] == 54 as i8 && n.buf[2] == 52 as i8
        return is_16 || is_32 || is_64
    }
    if n.len == 5 {
        // usize only (isize is excluded).
        let suffix = n.buf[1] == 115 as i8 && n.buf[2] == 105 as i8
            && n.buf[3] == 122 as i8 && n.buf[4] == 101 as i8
        return suffix && n.buf[0] == 117 as i8
    }
    false
}

fn lower_type_expr_is_unsigned_int(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    lower_name_is_unsigned_int_type(ir_path_first_name((*te).path))
}

fn lower_opt_type_is_unsigned_int(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_unsigned_int(&(*te)),
        None => false,
    }
}

fn lower_cast_type_is_unsigned_int(ct: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *ct {
        Some(te) => lower_type_expr_is_unsigned_int(&(*te)),
        None => false,
    }
}

fn lower_type_expr_is_string(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    let seg = (*te).path.segments
    if seg.head_len != 6 { return false }
    if seg.head_buf[0] as i64 != 115 { return false }   // 's'
    if seg.head_buf[1] as i64 != 116 { return false }   // 't'
    if seg.head_buf[2] as i64 != 114 { return false }   // 'r'
    if seg.head_buf[3] as i64 != 105 { return false }   // 'i'
    if seg.head_buf[4] as i64 != 110 { return false }   // 'n'
    if seg.head_buf[5] as i64 != 103 { return false }   // 'g'
    true
}

fn lower_opt_type_is_string(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_string(&(*te)),
        None => false,
    }
}

fn lower_type_expr_is_integer(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return false }
    lower_name_is_integer_type(ir_path_first_name((*te).path))
}

fn lower_cast_type_is_integer(ct: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *ct {
        Some(te) => lower_type_expr_is_integer(&(*te)),
        None => false,
    }
}

fn lower_type_expr_is_array_of_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    // Unwrap a single reference layer: `&[f64; N]` / `&![f64; N]` params (arrays passed
    // by reference — slice/linalg/matvec helpers) are arrays-of-f64 for element float
    // typing. Without this, `a[i] * b[i]` over such params fell to the integer path.
    if (*te).kind == TypeExprKind::TypeReference || (*te).kind == TypeExprKind::TypeRefMut {
        match (*te).inner {
            Some(inner_ty) => return lower_type_expr_is_array_of_f64(&(*inner_ty)),
            None => return false,
        }
    }
    if (*te).kind != TypeExprKind::TypeArray { return false }
    match (*te).inner {
        Some(inner_ty) => lower_type_expr_is_f64(&(*inner_ty)),
        None => false,
    }
}

fn lower_type_expr_is_array(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind == TypeExprKind::TypeReference || (*te).kind == TypeExprKind::TypeRefMut {
        match (*te).inner {
            Some(inner_ty) => return lower_type_expr_is_array(&(*inner_ty)),
            None => return false,
        }
    }
    (*te).kind == TypeExprKind::TypeArray
}

fn lower_global_kind_is_array_base(kind: i64) -> bool {
    // Bases that IndexGet must address via BSS_BASE+off (not load the init word).
    kind == LOWER_GLOBAL_ELEM_F64 || kind == LOWER_GLOBAL_ARRAY
}

fn lower_global_elem_kind(ty_opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *ty_opt {
        Some(ty) => {
            if lower_type_expr_is_f64(&(*ty)) { return LOWER_GLOBAL_SCALAR_F64 }
            if lower_type_expr_is_array_of_f64(&(*ty)) { return LOWER_GLOBAL_ELEM_F64 }
            // Any fixed array (incl. [i64; 1], [i8; N], …) needs address form.
            // Must precede the integer-scalar check: TypeArray is not TypeNamed.
            if lower_type_expr_is_array(&(*ty)) { return LOWER_GLOBAL_ARRAY }
            // Scalar integers: needed so print/println of `var G: i64` routes to
            // print_int (same SEGV class as untyped f64 → char*).
            if lower_type_expr_is_integer(&(*ty)) { return LOWER_GLOBAL_SCALAR_I64 }
            0
        }
        _ => 0,
    }
}

fn lower_global_type_table_record(
    table: LowerGlobalTypeTable,
    fn_id: i64,
    elem_kind: i64
) -> LowerGlobalTypeTable with Mut, Panic {
    var out = table
    if fn_id >= 0 && fn_id < IR_MAX_FUNCS {
        out.elem_kinds[fn_id as usize] = elem_kind
    }
    out
}

fn lower_global_type_table_lookup(table: &LowerGlobalTypeTable, fn_id: i64) -> i64 with Panic {
    if fn_id >= 0 && fn_id < IR_MAX_FUNCS {
        return (*table).elem_kinds[fn_id as usize]
    }
    0
}

fn lowerer_record_global_type_mut(
    lo: &! Lowerer,
    fn_id: i64,
    ty_opt: &Option<Box<TypeExpr>>
) with Mut, Panic, Div, Alloc {
    let elem_kind = lower_global_elem_kind(ty_opt)
    var table = *(*lo).global_types
    table = lower_global_type_table_record(table, fn_id, elem_kind)
    (*lo).global_types = Box::new(table)
}

fn lower_opt_type_is_f64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_f64(&(*te)),
        None => false,
    }
}

fn lower_opt_type_is_i64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_i64(&(*te)),
        None => false,
    }
}

fn lower_opt_type_is_integer(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_integer(&(*te)),
        None => false,
    }
}

fn lower_opt_type_is_unit_or_implicit(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => (*te).kind == TypeExprKind::TypeUnit,
        None => true,
    }
}

fn lower_opt_type_is_array_of_f64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_array_of_f64(&(*te)),
        None => false,
    }
}

// #1502: a tuple element is accessed as a FieldAccess whose name is the decimal
// slot index ("0", "1", ...). Returns the index, or -1 for an ordinary field name.
fn lower_name_tuple_index(n: Name) -> i64 with Mut, Panic, Div {
    if n.len <= 0 { return 0 - 1 }
    if n.len > 2 { return 0 - 1 }
    var v: i64 = 0
    var i: i64 = 0
    while i < n.len {
        let c = n.buf[i as usize] as i64
        if c < 48 { return 0 - 1 }
        if c > 57 { return 0 - 1 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    v
}

// #1502: bit k set iff element k of a declared tuple type is f64. Tuple element
// types are otherwise lost by lowering time -- lower_tuple_literal_expr_ref stores
// a tuple as an untyped word aggregate, so `s.1` had no way to know it holds f64
// bits and fell through to the integer path, where arithmetic cvtsi2sd-corrupted
// it. This is the tuple analogue of the `2` f64-array code below.
fn lower_type_list_float_mask(opt: &Option<Box<TypeExprList>>, bit: i64) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(list) => {
            var m: i64 = 0
            if bit < 32 {
                if lower_type_expr_is_f64(&(*list).head) {
                    m = 1 << (bit as i32)
                }
            }
            m + lower_type_list_float_mask(&(*list).tail, bit + 1)
        }
        None => 0,
    }
}

fn lower_opt_type_tuple_float_mask(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind != TypeExprKind::TypeTuple { return 0 }
            lower_type_list_float_mask(&(*te).type_args, 0)
        }
        None => 0,
    }
}

// returns_float classification for a declared return type: 1 = scalar f64, 2 = an
// f64 array (`[f64; N]`), 1024+mask = a tuple with f64 element(s), 0 = other. The `2` lets a caller's `let r = mk()` (mk
// returning an f64 array) flag `r` as a float-element local, so `r[i]` reads
// classify as float instead of taking the integer path (cvtsi2sd corruption).
// All consumers test `== 1`, so the new `2` value is inert for the scalar path.
// Restored from main: the conflict resolution took this PR's side of the
// classifier hunk wholesale and dropped these two helpers with it, while the
// CALL to the Option wrapper survived -- the compiler then failed to typecheck
// its own source (E137, use of undeclared variable). All-f64 tuples keep main's
// returns_float=2 path; mixed tuples fall through to this PR's 1024+mask.
fn lower_type_expr_is_tuple_of_all_f64(te: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeTuple { return false }
    match (*te).type_args {
        Some(list0) => {
            var cur: Option<Box<TypeExprList>> = Some(list0)
            var any = false
            while true {
                match cur {
                    Some(list) => {
                        if !lower_type_expr_is_f64(&(*list).head) { return false }
                        any = true
                        cur = (*list).tail
                    }
                    None => { break }
                }
            }
            any
        }
        None => false,
    }
}

fn lower_opt_type_is_tuple_of_all_f64(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_is_tuple_of_all_f64(&(*te)),
        None => false,
    }
}

fn lower_opt_return_float_code(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    if lower_opt_type_is_f64(opt) {
        1
    } else if lower_opt_type_is_array_of_f64(opt) || lower_opt_type_is_tuple_of_all_f64(opt) {
        2
    // 1024+mask keeps every existing consumer (all of which test == 1 or == 2)
    // inert while carrying per-slot float-ness for tuple returns.
    //
    // Written without a `let`: bound in the tail position of an else block the name
    // reads back as undeclared (E137) when the compiler typechecks its own source.
    // The classifier is a pure function of the type expression, so calling it twice
    // costs compile time and nothing else.
    } else if lower_opt_type_tuple_float_mask(opt) != 0 {
        1024 + lower_opt_type_tuple_float_mask(opt)
    } else {
        0
    }
}

// True iff the first call argument is an integer LITERAL (ExprIntLit). This is the
// only argument form whose primitive type is unambiguously integer at lowering time
// (the AST carries no inferred type on a general Expr — see struct Expr in parser/ast.sio).
// Used to route println/print of an int literal to the print_int builtin (decimal
// itoa+write) instead of the print/print_str builtin (strlen+write), which would
// otherwise dereference the integer value as a char* and SIGSEGV. Non-literal int
// arguments (variables, arithmetic) are NOT detected here and still use print_str;
// fixing those requires threading checker type info into lowering.
fn lower_call_first_arg_is_int_literal(args: &Option<Box<ExprList>>) -> bool with Mut, Panic, Div, Alloc {
    match *args {
        Some(list) => (*list).head.kind == ExprKind::ExprIntLit,
        _ => false,
    }
}

fn lower_opt_type_named_name(opt: &Option<Box<TypeExpr>>) -> Name with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind == TypeExprKind::TypeNamed {
                return ir_path_first_name((*te).path)
            }
            ir_empty_name()
        }
        None => ir_empty_name(),
    }
}

fn lower_opt_type_is_seq(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    ir_name_eq(lower_opt_type_named_name(opt), make_name("Seq"))
}

fn lower_type_expr_seq_named_elem_name(ty: &TypeExpr) -> Name with Mut, Panic, Div {
    if (*ty).kind != TypeExprKind::TypeNamed { return ir_empty_name() }
    if !ir_name_eq(ir_path_first_name((*ty).path), make_name("Seq")) { return ir_empty_name() }
    match (*ty).type_args {
        Some(types) => {
            if (*types).head.kind == TypeExprKind::TypeNamed {
                return ir_path_first_name((*types).head.path)
            }
            if (*types).head.kind == TypeExprKind::TypeKnowledge {
                return make_name("Knowledge")
            }
            ir_empty_name()
        }
        None => ir_empty_name(),
    }
}

fn lower_type_expr_array_named_elem_name(ty: &TypeExpr) -> Name with Mut, Panic, Div {
    if (*ty).kind != TypeExprKind::TypeArray {
        return ir_empty_name()
    }
    match (*ty).inner {
        Some(elem) => {
            if (*elem).kind == TypeExprKind::TypeNamed {
                return ir_path_first_name((*elem).path)
            }
            ir_empty_name()
        }
        None => ir_empty_name(),
    }
}

// Parser tuple-let desugaring turns `let (arr, n) = f()` into a temporary
// tuple plus `let arr = __tup.0`. Preserve the receiver layout needed by
// `arr[i].field` when slot 0 is a fixed array of a named struct.
fn lower_opt_type_tuple0_array_elem_struct_name(opt: &Option<Box<TypeExpr>>) -> Name with Mut, Panic, Div {
    match *opt {
        Some(tuple_ty) => {
            if (*tuple_ty).kind != TypeExprKind::TypeTuple {
                return ir_empty_name()
            }
            match (*tuple_ty).type_args {
                Some(types) => lower_type_expr_array_named_elem_name(&(*types).head),
                None => ir_empty_name(),
            }
        }
        None => ir_empty_name(),
    }
}

// Reuse IrFunction's existing return metadata without changing its aggregate
// layout. -2 is distinct from -1 (not a fixed array) and every fixed-array
// consumer already requires >= 0.
fn lower_tuple0_array_struct_return_sentinel() -> i64 {
    0 - 2
}

// A tuple return can carry a named struct in a slot other than 0, and until this
// there was no way to say so. lower_opt_type_return_layout_name answered for a
// DIRECT named return and for a fixed array of structs in slot 0; a return type
// like `(bool, NativeCompileResult)` fell through to an empty name and the
// element type was gone for good. Downstream, `pair.1.field` then resolves its
// index by a name scan across every registered struct, and the print classifier,
// which has no such fallback, refused outright -- the last println-poison refusal
// standing in a gen2 self-compile (#2288).
//
// A builtin scalar spelled as TypeNamed (bool, i64, string, f64) is NOT a
// candidate: the point is to name a struct whose LAYOUT can be looked up. This
// only PROPOSES a name; lower_struct_layout_index_of at the bind site disposes of
// one that no registered struct answers to, so a wrong guess costs nothing.
fn lower_type_expr_is_candidate_struct(ty: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*ty).kind != TypeExprKind::TypeNamed {
        return false
    }
    if lower_type_expr_is_f64(ty) {
        return false
    }
    let n = ir_path_first_name((*ty).path)
    if n.len <= 0 {
        return false
    }
    if lower_name_is_integer_type(n) {
        return false
    }
    if lower_name_is_string_type(n) {
        return false
    }
    if lower_name_is_bool_type(n) {
        return false
    }
    true
}

// Slot index of the FIRST tuple element naming a candidate struct, or -1. First,
// not all: one slot is what the return metadata can carry (see the sentinel
// below), and a tuple with a SECOND struct slot degrades to the refusal that
// stands today rather than to a guess about which one a `.K` meant.
fn lower_type_list_first_struct_slot(opt: &Option<Box<TypeExprList>>, idx: i64) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(list) => {
            if lower_type_expr_is_candidate_struct(&(*list).head) {
                return idx
            }
            lower_type_list_first_struct_slot(&(*list).tail, idx + 1)
        }
        None => 0 - 1,
    }
}

fn lower_type_list_named_at(opt: &Option<Box<TypeExprList>>, k: i64) -> Name with Mut, Panic, Div {
    match *opt {
        Some(list) => {
            if k <= 0 {
                return ir_path_first_name((*list).head.path)
            }
            lower_type_list_named_at(&(*list).tail, k - 1)
        }
        None => ir_empty_name(),
    }
}

fn lower_opt_type_tuple_struct_slot(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind != TypeExprKind::TypeTuple {
                return 0 - 1
            }
            lower_type_list_first_struct_slot(&(*te).type_args, 0)
        }
        None => 0 - 1,
    }
}

fn lower_opt_type_tuple_struct_slot_name(opt: &Option<Box<TypeExpr>>) -> Name with Mut, Panic, Div {
    let k = lower_opt_type_tuple_struct_slot(opt)
    if k < 0 {
        return ir_empty_name()
    }
    match *opt {
        Some(te) => lower_type_list_named_at(&(*te).type_args, k),
        None => ir_empty_name(),
    }
}

// -3 and below encode "return_struct_name names the struct in tuple slot k",
// with k = -3 - code. The same reuse the -2 sentinel above makes, for the same
// reason: IrFunction's aggregate layout stays put. Every fixed-array consumer
// requires >= 0 -- checked at all five read sites -- so the whole negative range
// is inert to them, and return_struct_name_for_fn_id refuses at <= -2 so a tuple
// local is never handed the slot's struct name as its OWN type.
fn lower_tuple_slot_struct_return_sentinel(k: i64) -> i64 {
    0 - 3 - k
}

fn lower_tuple_slot_struct_sentinel_slot(code: i64) -> i64 {
    0 - 3 - code
}

fn lower_opt_type_return_fixed_array_code(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    if lower_opt_type_tuple0_array_elem_struct_name(opt).len > 0 {
        return lower_tuple0_array_struct_return_sentinel()
    }
    let struct_slot = lower_opt_type_tuple_struct_slot(opt)
    if struct_slot >= 0 && lower_opt_type_tuple_struct_slot_name(opt).len > 0 {
        return lower_tuple_slot_struct_return_sentinel(struct_slot)
    }
    lower_opt_type_word_scalar_array_len(opt)
}

fn lower_opt_type_return_layout_name(opt: &Option<Box<TypeExpr>>) -> Name with Mut, Panic, Div {
    let direct = lower_opt_type_named_name(opt)
    if direct.len > 0 {
        return direct
    }
    let tuple0 = lower_opt_type_tuple0_array_elem_struct_name(opt)
    if tuple0.len > 0 {
        return tuple0
    }
    lower_opt_type_tuple_struct_slot_name(opt)
}

// Struct-type name of a parameter, unwrapping `&T` / `&!T`. Used so a method body's
// `self.method()` (and `param.method()`) can resolve the receiver's type — params were
// previously bound with an empty struct_type, so `self.other()` hit the body-less-fn crash.
fn lower_type_expr_is_box(ty: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*ty).kind != TypeExprKind::TypeNamed {
        return false
    }
    ir_name_eq(ir_path_first_name((*ty).path), make_name("Box"))
}

fn lower_box_inner_type_name(ty: &TypeExpr) -> Name with Mut, Panic, Div {
    match (*ty).type_args {
        Some(list) => ir_path_first_name((*list).head.path),
        None => ir_empty_name(),
    }
}

fn lower_struct_layout_index_of(table: &StructLayoutTable, type_name: Name) -> i64 with Mut, Panic, Div {
    if type_name.len <= 0 { return 0 - 1 }
    var si: i64 = 0
    while si < (*table).count {
        if ir_name_eq((*table).entries[si as usize].type_name, type_name) { return si }
        si = si + 1
    }
    0 - 1
}

// Read the side table WITHOUT copying the Lowerer. Bisected: writing this slot at param-bind time
// is harmless (a written-but-never-read array changes nothing), while every earlier attempt read it
// back through a by-value `self` method — which copies the whole ~struct Lowerer — at the
// field-access site, the hottest path in the lowerer. That read is what broke four builds.
fn lower_lookup_box_inner_layout(locals: Box<LowerLocalStack>, scope_depth: i64, name: Name) -> i64 with Mut, Panic, Div {
    var i = (*locals).count - 1
    while i >= 0 {
        if (*(*locals).depths).values[i as usize] <= scope_depth && ir_name_eq((*(*locals).names).values[i as usize], name) {
            return (*(*locals).box_inner_layout).values[i as usize]
        }
        i = i - 1
    }
    0 - 1
}

fn lower_param_struct_type_name(ty: &TypeExpr) -> Name with Mut, Panic, Div {
    if (*ty).kind == TypeExprKind::TypeNamed {
        return ir_path_first_name((*ty).path)
    }
    if (*ty).kind == TypeExprKind::TypeReference || (*ty).kind == TypeExprKind::TypeRefMut {
        return lower_opt_type_named_name(&(*ty).inner)
    }
    // `*mut T` stores its pointee in `inner` exactly as `&T` and `&!T` do
    // (parser/types.sio:87), and lower_type_expr_is_ref_like already counts it as
    // ref-like -- it was simply missing from this unwrap. check.sio declares 249
    // parameters this way, and a `c: *mut Checker` with no struct type is why
    // `(*c).env.lookup(...)` could not resolve its owner: 140 of the 142
    // unresolved field receivers in a gen2 self-compile sit in those functions.
    //
    // Found by looking at the failing function instead of modelling it. Two
    // witnesses written against `&! T` -- one single-module, one cross-module --
    // both PASSED, because `&!` was never the shape that breaks.
    if (*ty).kind == TypeExprKind::TypeRawPtr {
        return lower_opt_type_named_name(&(*ty).inner)
    }
    ir_empty_name()
}

// Index of a kernel's launch-extent parameter: the first `i64` parameter.
// Mirrors lean_single's kernel_extent_slot discovery (lean_single.sio:29210) so
// both engines agree on which argument bounds the lane loop. -1 when the kernel
// has no i64 parameter, in which case there is no extent and the body is lowered
// unwrapped exactly as before.
fn lower_kernel_extent_param_index(params: &Option<Box<ParamList>>) -> i64 with Mut, Panic, Div {
    var current = params
    var idx: i64 = 0
    while true {
        match *current {
            Some(list) => {
                if name_eq(lower_param_struct_type_name(&(*list).head.ty), make_name("i64")) {
                    return idx
                }
                idx = idx + 1
                current = &(*list).tail
            }
            _ => return 0 - 1,
        }
    }
    0 - 1
}

fn lower_type_expr_is_ref_like(ty: &TypeExpr) -> bool {
    (*ty).kind == TypeExprKind::TypeReference || (*ty).kind == TypeExprKind::TypeRefMut
}

// True when the type is anything the runtime represents AS A POINTER, which is what decides
// whether a field access through it must LOAD before applying the next offset. TypeExprKind has
// no Box variant — Box<T> parses as TypeNamed "Box" with a generic argument — so the name has to
// be matched explicitly alongside the three syntactic pointer forms.
fn lower_type_expr_is_pointer_like(ty: &TypeExpr) -> bool with Mut, Panic, Div {
    if (*ty).kind == TypeExprKind::TypeReference { return true }
    if (*ty).kind == TypeExprKind::TypeRefMut { return true }
    if (*ty).kind == TypeExprKind::TypeRawPtr { return true }
    if (*ty).kind == TypeExprKind::TypeNamed {
        // A named type carries its identifier in `path`, not in a `name` field; the rest of
        // this file reads it as ir_path_first_name((*ty).path).
        return ir_name_eq(ir_path_first_name((*ty).path), make_name("Box"))
    }
    false
}

fn lower_opt_type_is_ref_like(opt: &Option<Box<TypeExpr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(ty) => lower_type_expr_is_ref_like(&(*ty)),
        None => false,
    }
}

// True when the first parameter is &T / &!T (typical method self-by-ref).
fn lower_fn_first_param_is_ref(params: &Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    match *params {
        Some(list) => {
            if lower_type_expr_is_ref_like(&(*list).head.ty) { 1 } else { 0 }
        }
        None => 0,
    }
}

fn lower_name_wide_int_bits(n: Name) -> i64 with Panic, Div {
    if n.len < 2 { return 0 }
    let c0 = n.buf[0] as i64
    if c0 != 105 && c0 != 117 { return 0 }
    var bits: i64 = 0
    var i: i64 = 1
    while i < n.len {
        let d = n.buf[i as usize] as i64
        if d < 48 || d > 57 { return 0 }
        bits = bits * 10 + (d - 48)
        i = i + 1
    }
    if bits <= 64 { return 0 }
    bits
}

fn lower_type_expr_wide_bits(te: &TypeExpr) -> i64 with Mut, Panic, Div {
    if (*te).kind != TypeExprKind::TypeNamed { return 0 }
    lower_name_wide_int_bits(ir_path_first_name((*te).path))
}

fn lower_opt_type_wide_bits(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => lower_type_expr_wide_bits(&(*te)),
        None => 0,
    }
}

fn lower_opt_type_wide_signed(opt: &Option<Box<TypeExpr>>) -> i64 with Mut, Panic, Div {
    match *opt {
        Some(te) => {
            if (*te).kind != TypeExprKind::TypeNamed { return 0 }
            let n = ir_path_first_name((*te).path)
            if lower_name_wide_int_bits(n) <= 0 { return 0 }
            if n.buf[0] as i64 == 105 { 1 } else { 0 }
        }
        None => 0,
    }
}

fn lower_wide_limb_count(bits: i64) -> i64 {
    if bits <= 0 { return 0 }
    (bits + 63) / 64
}

fn lower_binary_op_to_wide_cmp(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpEq { return 0 }
    if op == BinaryOp::OpNe { return 1 }
    if op == BinaryOp::OpLt { return 2 }
    if op == BinaryOp::OpLe { return 3 }
    if op == BinaryOp::OpGt { return 4 }
    if op == BinaryOp::OpGe { return 5 }
    -1
}

fn lower_binary_op_is_compare(op: BinaryOp) -> bool {
    lower_binary_op_to_wide_cmp(op) >= 0
}

fn lower_opt_expr_has_float_source(opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprFloatLit { return true }
            if (*e).kind == ExprKind::ExprCast {
                return lower_cast_type_is_f64(&(*e).cast_type)
            }
            if (*e).kind == ExprKind::ExprBinary {
                let lref = &(*e).left
                match *lref {
                    Some(lc) => {
                        if (*lc).kind == ExprKind::ExprFloatLit { return true }
                    }
                    None => {}
                }
                let rref = &(*e).right
                match *rref {
                    Some(rc) => {
                        if (*rc).kind == ExprKind::ExprFloatLit { return true }
                        if (*rc).kind == ExprKind::ExprCast {
                            if lower_cast_type_is_f64(&(*rc).cast_type) { return true }
                        }
                    }
                    None => {}
                }
            }
            false
        }
        None => false,
    }
}

fn lower_expr_has_float_source_ref(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind == ExprKind::ExprFloatLit { return true }
    if (*e).kind == ExprKind::ExprCast {
        return lower_cast_type_is_f64(&(*e).cast_type)
    }
    if (*e).kind == ExprKind::ExprBinary {
        if lower_opt_expr_has_float_source(&(*e).left) { return true }
        if lower_opt_expr_has_float_source(&(*e).right) { return true }
    }
    false
}

// #1569: conservative "subtree may evaluate a call" predicate. The legacy
// scalar-variance algebra in lower_expr_variance_ref re-lowers operand
// VALUES (lower_opt_expr_ref) to feed emit_variance_independent_product/div;
// when the operand contains an effectful call (e.g. a Mut RNG) that
// re-lowering executes the call a SECOND time, so
// `let d = W[k] * (2.0 * rand_u() - 1.0)` advanced the PRNG twice per
// iteration and Madaros diverged from lean_single. Whitelist the pure,
// recursable kinds; everything else (Call/MethodCall, If, Block, Closure,
// Match, literals-of-aggregate, ...) conservatively counts as "may call".
fn lower_opt_expr_contains_call(opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div {
    match *opt {
        Some(e) => lower_expr_contains_call_ref(&(*e)),
        None => false,
    }
}

fn lower_expr_contains_call_ref(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind == ExprKind::ExprIntLit { return false }
    if (*e).kind == ExprKind::ExprFloatLit { return false }
    if (*e).kind == ExprKind::ExprBoolTrue { return false }
    if (*e).kind == ExprKind::ExprBoolFalse { return false }
    if (*e).kind == ExprKind::ExprStringLit { return false }
    if (*e).kind == ExprKind::ExprCharLit { return false }
    if (*e).kind == ExprKind::ExprIdent { return false }
    if (*e).kind == ExprKind::ExprPath { return false }
    if (*e).kind == ExprKind::ExprBinary {
        if lower_opt_expr_contains_call(&(*e).left) { return true }
        return lower_opt_expr_contains_call(&(*e).right)
    }
    if (*e).kind == ExprKind::ExprUnary {
        return lower_opt_expr_contains_call(&(*e).left)
    }
    if (*e).kind == ExprKind::ExprCast {
        return lower_opt_expr_contains_call(&(*e).left)
    }
    if (*e).kind == ExprKind::ExprIndex {
        if lower_opt_expr_contains_call(&(*e).left) { return true }
        return lower_opt_expr_contains_call(&(*e).right)
    }
    if (*e).kind == ExprKind::ExprFieldAccess {
        return lower_opt_expr_contains_call(&(*e).left)
    }
    true
}

fn lower_expr_is_f64_array_literal_ref(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind != ExprKind::ExprArrayLit { return false }
    match (*e).left {
        Some(repeat_expr) => lower_expr_has_float_source_ref(&(*repeat_expr)),
        None => {
            match (*e).args {
                Some(args) => lower_expr_has_float_source_ref(&(*args).head),
                None => false,
            }
        }
    }
}

fn lower_struct_field_float_kind_ref(e: &Expr) -> i64 with Mut, Panic, Div {
    if lower_expr_is_f64_array_literal_ref(e) { return 2 }
    if lower_expr_has_float_source_ref(e) { return 1 }
    0
}

struct CapturedClosureValueScan {
    locals: [Name; 256],
    local_count: i64,
    captured_closures: [Name; 256],
    captured_closure_count: i64,
    transparent_hofs: [Name; 256],
    transparent_hof_count: i64,
}

fn captured_closure_value_scan_empty() -> CapturedClosureValueScan {
    CapturedClosureValueScan {
        locals: [ir_empty_name(); 256],
        local_count: 0,
        captured_closures: [ir_empty_name(); 256],
        captured_closure_count: 0,
        transparent_hofs: [ir_empty_name(); 256],
        transparent_hof_count: 0,
    }
}

fn captured_scan_has_local(scan: CapturedClosureValueScan, name: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < scan.local_count {
        if ir_name_eq(scan.locals[i as usize], name) { return true }
        i = i + 1
    }
    false
}

fn captured_scan_has_closure(scan: CapturedClosureValueScan, name: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < scan.captured_closure_count {
        if ir_name_eq(scan.captured_closures[i as usize], name) { return true }
        i = i + 1
    }
    false
}

fn captured_scan_has_transparent_hof(scan: CapturedClosureValueScan, name: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < scan.transparent_hof_count {
        if ir_name_eq(scan.transparent_hofs[i as usize], name) { return true }
        i = i + 1
    }
    false
}

fn captured_scan_add_local(scan: CapturedClosureValueScan, name: Name) -> CapturedClosureValueScan with Mut, Panic, Div {
    var out = scan
    if captured_scan_has_local(out, name) { return out }
    if out.local_count < 256 {
        out.locals[out.local_count as usize] = name
        out.local_count = out.local_count + 1
    }
    out
}

fn captured_scan_add_closure(scan: CapturedClosureValueScan, name: Name) -> CapturedClosureValueScan with Mut, Panic, Div {
    var out = scan
    if captured_scan_has_closure(out, name) { return out }
    if out.captured_closure_count < 256 {
        out.captured_closures[out.captured_closure_count as usize] = name
        out.captured_closure_count = out.captured_closure_count + 1
    }
    out
}

fn captured_scan_add_transparent_hof(scan: CapturedClosureValueScan, name: Name) -> CapturedClosureValueScan with Mut, Panic, Div {
    var out = scan
    if captured_scan_has_transparent_hof(out, name) { return out }
    if out.transparent_hof_count < 256 {
        out.transparent_hofs[out.transparent_hof_count as usize] = name
        out.transparent_hof_count = out.transparent_hof_count + 1
    }
    out
}

fn captured_closure_param_has_name(params: &Option<Box<ClosureParamList>>, name: Name) -> bool with Mut, Panic, Div {
    var cur = params
    while true {
        match *cur {
            Some(node) => {
                if ir_name_eq((*node).head.name, name) { return true }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn captured_expr_references_enclosing_local(e: &Expr, params: &Option<Box<ClosureParamList>>, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    if (*e).kind == ExprKind::ExprIdent {
        if captured_scan_has_local(scan, (*e).name) && !captured_closure_param_has_name(params, (*e).name) {
            return true
        }
    }
    match (*e).left {
        Some(l) => { if captured_expr_references_enclosing_local(&(*l), params, scan) { return true } }
        _ => {}
    }
    match (*e).right {
        Some(r) => { if captured_expr_references_enclosing_local(&(*r), params, scan) { return true } }
        _ => {}
    }
    match (*e).else_expr {
        Some(el) => { if captured_expr_references_enclosing_local(&(*el), params, scan) { return true } }
        _ => {}
    }
    match (*e).block {
        Some(b) => { if captured_block_references_enclosing_local(&(*b), params, scan) { return true } }
        _ => {}
    }
    var args = &(*e).args
    while true {
        match *args {
            Some(node) => {
                if captured_expr_references_enclosing_local(&(*node).head, params, scan) { return true }
                args = &(*node).tail
            }
            _ => break,
        }
    }
    false
}

fn captured_block_references_enclosing_local(block: &Block, params: &Option<Box<ClosureParamList>>, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    var cur = &(*block).stmts
    while true {
        match *cur {
            Some(node) => {
                match (*node).head.expr {
                    Some(e) => {
                        if captured_expr_references_enclosing_local(&(*e), params, scan) { return true }
                    }
                    _ => {}
                }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn captured_expr_is_capturing_closure_literal(e: &Expr, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    if (*e).kind != ExprKind::ExprClosure { return false }
    match (*e).closure_body {
        Some(body) => captured_expr_references_enclosing_local(&(*body), &(*e).closure_params, scan),
        _ => false,
    }
}

fn captured_expr_is_captured_closure_value(e: &Expr, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    if (*e).kind == ExprKind::ExprIdent {
        return captured_scan_has_closure(scan, (*e).name)
    }
    captured_expr_is_capturing_closure_literal(e, scan)
}

fn captured_call_first_arg_is_captured_value(args: &Option<Box<ExprList>>, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    match *args {
        Some(node) => captured_expr_is_captured_closure_value(&(*node).head, scan),
        _ => false,
    }
}

fn captured_expr_callee_name(e: &Expr) -> Name with Mut, Panic, Div {
    if (*e).kind == ExprKind::ExprIdent {
        return (*e).name
    }
    if (*e).kind == ExprKind::ExprPath {
        return ir_path_first_name((*e).path)
    }
    ir_empty_name()
}

fn captured_expr_misuses_value(e: &Expr, scan: CapturedClosureValueScan, in_callee: bool) -> bool with Mut, Panic, Div, Alloc {
    if (*e).kind == ExprKind::ExprIdent {
        return !in_callee && captured_scan_has_closure(scan, (*e).name)
    }
    if (*e).kind == ExprKind::ExprClosure {
        return !in_callee && captured_expr_is_capturing_closure_literal(e, scan)
    }
    if (*e).kind == ExprKind::ExprReturn {
        match (*e).left {
            Some(ret) => { return captured_expr_misuses_value(&(*ret), scan, false) }
            _ => return false,
        }
    }
    if (*e).kind == ExprKind::ExprCall {
        var callee_name = ir_empty_name()
        var direct_captured_call = false
        match (*e).left {
            Some(callee) => {
                callee_name = captured_expr_callee_name(&(*callee))
                if callee_name.len > 0 {
                    direct_captured_call = captured_scan_has_closure(scan, callee_name)
                } else if captured_expr_misuses_value(&(*callee), scan, true) {
                    return true
                }
            }
            _ => {}
        }
        let captured_first_arg = captured_call_first_arg_is_captured_value(&(*e).args, scan)
        let transparent_hof_call = captured_first_arg && captured_scan_has_transparent_hof(scan, callee_name)
        if captured_first_arg && !transparent_hof_call { return true }
        var args = &(*e).args
        var idx: i64 = 0
        while true {
            match *args {
                Some(node) => {
                    if !((direct_captured_call || transparent_hof_call) && idx == 0) {
                        if captured_expr_misuses_value(&(*node).head, scan, false) { return true }
                    }
                    args = &(*node).tail
                    idx = idx + 1
                }
                _ => break,
            }
        }
        return false
    }
    match (*e).left {
        Some(l) => { if captured_expr_misuses_value(&(*l), scan, false) { return true } }
        _ => {}
    }
    match (*e).right {
        Some(r) => { if captured_expr_misuses_value(&(*r), scan, false) { return true } }
        _ => {}
    }
    match (*e).else_expr {
        Some(el) => { if captured_expr_misuses_value(&(*el), scan, false) { return true } }
        _ => {}
    }
    match (*e).block {
        Some(b) => { if captured_block_misuses_value(&(*b), scan) { return true } }
        _ => {}
    }
    var args2 = &(*e).args
    while true {
        match *args2 {
            Some(node2) => {
                if captured_expr_misuses_value(&(*node2).head, scan, false) { return true }
                args2 = &(*node2).tail
            }
            _ => break,
        }
    }
    false
}

// Does this function ever ask for a Hessian?
//
// Second-order propagation is not free: the product rule emits cross terms
// Sx_j*Sy_k for every float multiply whose operands carry seed channels. And
// Madaros seeds an FO channel for ANY pure-float `let` (the beta-Madaros
// behaviour), so fo_nchan is positive throughout an ordinary numeric program
// -- gating on it filters nothing. dissertation_pbpk28_parity_ref_rapamycin.sio
// uses no epistemic feature at all and still went from 1714 lines of output to
// 9 under an ungated build.
//
// So the gate has to be the question the emission actually answers: does
// hessian_of appear in this function. Shape mirrors captured_block_misuses_value
// below, which walks the same AST.
fn so_name_is_hessian_of_ident(e: &Expr) -> bool with Mut, Panic, Div {
    if (*e).kind != ExprKind::ExprIdent { return false }
    let n = (*e).name
    if n.len == 10
        && n.buf[0] == 104 as i8 && n.buf[1] == 101 as i8
        && n.buf[2] == 115 as i8 && n.buf[3] == 115 as i8
        && n.buf[4] == 105 as i8 && n.buf[5] == 97 as i8
        && n.buf[6] == 110 as i8 && n.buf[7] == 95 as i8
        && n.buf[8] == 111 as i8 && n.buf[9] == 102 as i8 { return true }
    // `second_order_mean` reads the same Hessian, so it must switch the
    // second-order walk on too. Without this line the builtin still compiles
    // and still runs -- so_enabled stays false, every so_expr_hess slot stays
    // -1, and the E2 correction evaluates to exactly zero with no diagnostic.
    // "second_order_mean" = 17 chars
    n.len == 17
        && n.buf[0] == 115 as i8 && n.buf[1] == 101 as i8
        && n.buf[2] == 99 as i8 && n.buf[3] == 111 as i8
        && n.buf[4] == 110 as i8 && n.buf[5] == 100 as i8
        && n.buf[6] == 95 as i8 && n.buf[7] == 111 as i8
        && n.buf[8] == 114 as i8 && n.buf[9] == 100 as i8
        && n.buf[10] == 101 as i8 && n.buf[11] == 114 as i8
        && n.buf[12] == 95 as i8 && n.buf[13] == 109 as i8
        && n.buf[14] == 101 as i8 && n.buf[15] == 97 as i8
        && n.buf[16] == 110 as i8
}

fn so_opt_expr_uses_hessian(opt: &Option<Box<Expr> >) -> bool with Mut, Panic, Div, Alloc {
    match *opt {
        Some(e) => so_expr_uses_hessian(&(*e)),
        None => false,
    }
}

fn so_opt_block_uses_hessian(opt: &Option<Box<Block> >) -> bool with Mut, Panic, Div, Alloc {
    match *opt {
        Some(b) => so_block_uses_hessian(&(*b)),
        None => false,
    }
}

fn so_expr_list_uses_hessian(opt: &Option<Box<ExprList> >) -> bool with Mut, Panic, Div, Alloc {
    var cur = opt
    while true {
        match *cur {
            Some(node) => {
                if so_expr_uses_hessian(&(*node).head) { return true }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn so_arms_use_hessian(opt: &Option<Box<MatchArmList> >) -> bool with Mut, Panic, Div, Alloc {
    var cur = opt
    while true {
        match *cur {
            Some(node) => {
                if so_expr_uses_hessian(&(*node).head.body) { return true }
                if so_opt_expr_uses_hessian(&(*node).head.guard) { return true }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn so_expr_uses_hessian(e: &Expr) -> bool with Mut, Panic, Div, Alloc {
    if (*e).kind == ExprKind::ExprCall {
        match (*e).left {
            Some(callee) => {
                if so_name_is_hessian_of_ident(&(*callee)) { return true }
            }
            _ => {}
        }
    }
    if so_opt_expr_uses_hessian(&(*e).left) { return true }
    if so_opt_expr_uses_hessian(&(*e).right) { return true }
    if so_opt_expr_uses_hessian(&(*e).else_expr) { return true }
    if so_opt_expr_uses_hessian(&(*e).closure_body) { return true }
    if so_expr_list_uses_hessian(&(*e).args) { return true }
    if so_opt_block_uses_hessian(&(*e).block) { return true }
    if so_opt_block_uses_hessian(&(*e).handler_block) { return true }
    if so_arms_use_hessian(&(*e).arms) { return true }
    false
}

fn so_block_uses_hessian(block: &Block) -> bool with Mut, Panic, Div, Alloc {
    var cur = &(*block).stmts
    while true {
        match *cur {
            Some(node) => {
                let stmt = &(*node).head
                if so_opt_expr_uses_hessian(&(*stmt).expr) { return true }
                if so_opt_expr_uses_hessian(&(*stmt).target) { return true }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn captured_block_misuses_value(block: &Block, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    var state = scan
    var cur = &(*block).stmts
    while true {
        match *cur {
            Some(node) => {
                let stmt = &(*node).head
                if stmt.kind == StmtKind::StmtLet || stmt.kind == StmtKind::StmtVar {
                    match (*stmt).expr {
                        Some(e) => {
                            if captured_expr_is_capturing_closure_literal(&(*e), state) {
                                state = captured_scan_add_closure(state, (*stmt).name)
                            } else {
                                if captured_expr_misuses_value(&(*e), state, false) { return true }
                            }
                        }
                        _ => {}
                    }
                    state = captured_scan_add_local(state, (*stmt).name)
                } else {
                    match (*stmt).expr {
                        Some(e2) => {
                            if captured_expr_misuses_value(&(*e2), state, false) { return true }
                        }
                        _ => {}
                    }
                }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn captured_param_count(params: &Option<Box<ParamList>>) -> i64 with Alloc, Mut, Div {
    var n: i64 = 0
    var cur = params
    while true {
        match *cur {
            Some(node) => {
                n = n + 1
                cur = &(*node).tail
            }
            _ => return n,
        }
    }
    0
}

fn captured_first_param_name(params: &Option<Box<ParamList>>) -> Name with Alloc, Mut, Div {
    match *params {
        Some(node) => (*node).head.name,
        _ => ir_empty_name(),
    }
}

fn captured_expr_is_transparent_hof_body(e: &Expr, first_param: Name) -> bool with Mut, Panic, Div {
    if (*e).kind == ExprKind::ExprReturn {
        match (*e).left {
            Some(ret) => return captured_expr_is_transparent_hof_body(&(*ret), first_param),
            _ => return false,
        }
    }
    if (*e).kind == ExprKind::ExprBinary {
        return false
    }
    if (*e).kind != ExprKind::ExprCall { return false }
    match (*e).left {
        Some(callee) => {
            ir_name_eq(captured_expr_callee_name(&(*callee)), first_param)
        }
        _ => false,
    }
}

fn captured_stmt_list_has_transparent_hof_body(stmts: &Option<Box<StmtList>>, first_param: Name) -> bool with Mut, Panic, Div {
    var cur = stmts
    while true {
        match *cur {
            Some(node) => {
                match (*node).head.expr {
                    Some(e) => {
                        if captured_expr_is_transparent_hof_body(&(*e), first_param) {
                            return true
                        }
                    }
                    _ => {}
                }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}

fn captured_fn_is_transparent_hof(fd: &FnDef) -> bool with Mut, Panic, Div, Alloc {
    if captured_param_count(&(*fd).params) < 2 { return false }
    let first_param = captured_first_param_name(&(*fd).params)
    captured_stmt_list_has_transparent_hof_body(&(*fd).body.stmts, first_param)
}

fn captured_collect_transparent_hofs(items: &Option<Box<ItemList>>, scan: CapturedClosureValueScan) -> CapturedClosureValueScan with Mut, Panic, Div, Alloc {
    var state = scan
    var cur = items
    while true {
        match *cur {
            Some(node) => {
                let item = &(*node).head
                if (*item).kind == ItemKind::ItemFn {
                    match (*item).fn_def {
                        Some(fd) => {
                            if captured_fn_is_transparent_hof(&(*fd)) {
                                state = captured_scan_add_transparent_hof(state, (*item).name)
                            }
                        }
                        _ => {}
                    }
                }
                cur = &(*node).tail
            }
            _ => return state,
        }
    }
    state
}

fn captured_fn_has_value_misuse(fd: &FnDef, scan: CapturedClosureValueScan) -> bool with Mut, Panic, Div, Alloc {
    var state = scan
    var params = &(*fd).params
    while true {
        match *params {
            Some(node) => {
                state = captured_scan_add_local(state, (*node).head.name)
                params = &(*node).tail
            }
            _ => break,
        }
    }
    captured_block_misuses_value(&(*fd).body, state)
}

pub fn lower_program_has_captured_closure_value_misuse_ref(prog: &Program) -> bool with Mut, Panic, Div, Alloc {
    var scan = captured_closure_value_scan_empty()
    scan = captured_collect_transparent_hofs(&(*prog).items, scan)
    var cur = &(*prog).items
    while true {
        match *cur {
            Some(node) => {
                let item = &(*node).head
                if (*item).kind == ItemKind::ItemFn {
                    match (*item).fn_def {
                        Some(fd) => {
                            if captured_fn_has_value_misuse(&(*fd), scan) { return true }
                        }
                        _ => {}
                    }
                }
                cur = &(*node).tail
            }
            _ => return false,
        }
    }
    false
}


impl Lowerer {
    fn current_fn_compile_strategy(self) -> i64 with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return IR_STRATEGY_STANDARD
        }
        if self.current_func_loaded {
            self.current_func.compile_strategy
        } else {
            ir_fn_get(&(*self.module), self.current_fn as usize).compile_strategy
        }
    }

    fn current_fn_validated_reg(self) -> i64 with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return IR_INVALID_REG
        }
        if self.current_func_loaded && self.current_func.param_count > 0 {
            self.current_func.param_regs[0]
        } else {
            ir_fn_get(&(*self.module), self.current_fn as usize).param_regs[0]
        }
    }

    fn flush_current_func(self) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if lo.current_func_loaded && lo.current_fn >= 0 && lo.current_fn < lo.module.fn_count {
            var module_box = lo.module
            ir_fn_set(&! (*module_box), lo.current_fn as usize, *lo.current_func)
            lo.module = module_box
        }
        lo.current_func_loaded = false
        lo
    }

    fn begin_function_body_lowering(self, fn_id: i64, name: Name) -> Lowerer with Mut, Panic, Div {
        var lo = self.flush_current_func()
        lo.current_fn = fn_id
        // Reuse the Box the Lowerer already holds instead of bump-allocating a
        // fresh ~504 KB IrFunction per function; and read the preserved fields
        // in place instead of `let preserved = …`, which copied the whole
        // function to look at seven scalars.
        var reused = lo.current_func
        ir_reset_function_in_place(&! (*reused), name)
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            (*reused).name = ir_fn_get(&(*lo.module), fn_id as usize).name
            (*reused).compile_strategy = ir_fn_get(&(*lo.module), fn_id as usize).compile_strategy
            (*reused).returns_float = ir_fn_get(&(*lo.module), fn_id as usize).returns_float
            (*reused).return_fixed_array_len = ir_fn_get(&(*lo.module), fn_id as usize).return_fixed_array_len
            (*reused).return_struct_name = ir_fn_get(&(*lo.module), fn_id as usize).return_struct_name
            (*reused).first_param_is_ref = ir_fn_get(&(*lo.module), fn_id as usize).first_param_is_ref
            (*reused).prof_counter_id = ir_fn_get(&(*lo.module), fn_id as usize).prof_counter_id
        }
        lo.current_func = reused
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals = lo.locals
        (*rst_locals).count = 0
        lo.locals = rst_locals
        lo.scope_depth = 0
        lo.loop_depth = 0
        // D5 (#986): per-function reset of vreg-keyed float/variance tables.
        lo.array_elem_float_reg_count = 0
        lo.variance_base_reg_count = 0
        lo.pending_variance_reg = -1
        lo.pending_closure_fn_id = -1
        // Multi-channel FO seeds are per-function.
        lo.fo_nchan = 0
        lo.fo_bind_count = 0
        var fci: i64 = 0
        while fci < 32 {
            lo.fo_sigma2[fci as usize] = -1
            lo.fo_expr_sens[fci as usize] = -1
            lo.fo_pending_sens[fci as usize] = -1
            fci = fci + 1
        }
        lo
    }

    fn metadata_span_matches(self, span: Span, start: i64, end: i64) -> bool {
        if self.probe_mode {
            return false
        }
        start == span.start && end == span.end
    }

    // Legacy differential oracle. Metadata-sensitive paths must use the
    // compiler-owned bounded index instead of copying this wide aggregate.
    fn find_contest_id_for_span(self, span: Span) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.epistemic.contest_count {
            let info = self.module.epistemic.contests[i]
            if self.metadata_span_matches(span, info.span_start, info.span_end) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn find_robust_proof_id_for_span(self, span: Span) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.epistemic.robust_proof_count {
            let info = self.module.epistemic.robust_proofs[i]
            if self.metadata_span_matches(span, info.span_start, info.span_end) {
