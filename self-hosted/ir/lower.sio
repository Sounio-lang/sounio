    fn contest_posterior_weights(self, contest_info: IrContestInfo) -> IrPosteriorWeightsInfo with Mut, Panic, Div {
        if contest_info.posterior_weights_id >= 0 && contest_info.posterior_weights_id < self.module.epistemic.posterior_weights_count {
            self.module.epistemic.posterior_weights[contest_info.posterior_weights_id as usize]
        } else {
            ir_empty_posterior_weights_info()
        }
    }

    fn lower_contest_disagreement_witness(self, contest_id: i64, contest_info: IrContestInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let mechanistic = self.contest_mechanistic_report(contest_info)
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let contest_pair = lo.emit_i64_const(contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let family_pair = lo.emit_i64_const(contest_info.family_id)
        lo = family_pair.0
        lo = lo.emit_named_field(dst, make_name("family_id"), family_pair.1)

        let family_name_pair = lo.emit_name_string(lo.epistemic_family_name(contest_info.family_id))
        lo = family_name_pair.0
        lo = lo.emit_named_field(dst, make_name("family_name"), family_name_pair.1)

        let policy_pair = lo.emit_i64_const(contest_info.policy_id)
        lo = policy_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_id"), policy_pair.1)

        let policy_name_pair = lo.emit_name_string(lo.epistemic_policy_name(contest_info.policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let sign_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 0))
        lo = sign_pair.0
        lo = lo.emit_named_field(dst, make_name("sign_consensus"), sign_pair.1)

        let band_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 1))
        lo = band_pair.0
        lo = lo.emit_named_field(dst, make_name("relative_band"), band_pair.1)

        let tail_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 2))
        lo = tail_pair.0
        lo = lo.emit_named_field(dst, make_name("max_tail_risk"), tail_pair.1)

        let ident_pair = lo.emit_f64_const(lo.contest_metric_value(contest_info, 4))
        lo = ident_pair.0
        lo = lo.emit_named_field(dst, make_name("identifiability_floor"), ident_pair.1)

        let agg_pair = lo.emit_f64_const(mechanistic.aggregate_divergence)
        lo = agg_pair.0
        lo = lo.emit_named_field(dst, make_name("mechanistic_divergence"), agg_pair.1)

        let latent_pair = lo.emit_f64_const(mechanistic.latent_state_divergence)
        lo = latent_pair.0
        lo = lo.emit_named_field(dst, make_name("latent_state_divergence"), latent_pair.1)

        let causal_pair = lo.emit_f64_const(mechanistic.causal_decomposition_divergence)
        lo = causal_pair.0
        lo = lo.emit_named_field(dst, make_name("causal_decomposition_divergence"), causal_pair.1)

        let inter_pair = lo.emit_f64_const(mechanistic.intervention_response_divergence)
        lo = inter_pair.0
        lo = lo.emit_named_field(dst, make_name("intervention_response_divergence"), inter_pair.1)

        let param_pair = lo.emit_f64_const(mechanistic.parameter_role_divergence)
        lo = param_pair.0
        lo = lo.emit_named_field(dst, make_name("parameter_role_divergence"), param_pair.1)

        let struct_pair = lo.emit_f64_const(mechanistic.structural_explanation_distance)
        lo = struct_pair.0
        lo = lo.emit_named_field(dst, make_name("structural_explanation_distance"), struct_pair.1)

        let counter_pair = lo.emit_i64_const(contest_info.counterexample_id)
        lo = counter_pair.0
        lo = lo.emit_named_field(dst, make_name("counterexample_id"), counter_pair.1)

        let weights_pair = lo.emit_i64_const(contest_info.posterior_weights_id)
        lo = weights_pair.0
        lo = lo.emit_named_field(dst, make_name("posterior_weights_id"), weights_pair.1)

        (lo, dst)
    }

    fn lower_contest_counterexample_witness(self, info: IrCounterexampleInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let model_pair = lo.emit_name_string(info.model_name)
        lo = model_pair.0
        lo = lo.emit_named_field(dst, make_name("model_name"), model_pair.1)

        let subgroup_pair = lo.emit_name_string(info.subgroup_name)
        lo = subgroup_pair.0
        lo = lo.emit_named_field(dst, make_name("subgroup_name"), subgroup_pair.1)

        let metric_pair = lo.emit_name_string(info.metric_name)
        lo = metric_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_name"), metric_pair.1)

        let observed_pair = lo.emit_f64_const(info.observed_value)
        lo = observed_pair.0
        lo = lo.emit_named_field(dst, make_name("observed_value"), observed_pair.1)

        let threshold_pair = lo.emit_f64_const(info.threshold_value)
        lo = threshold_pair.0
        lo = lo.emit_named_field(dst, make_name("threshold_value"), threshold_pair.1)

        let summary_pair = lo.emit_name_string(info.summary)
        lo = summary_pair.0
        lo = lo.emit_named_field(dst, make_name("summary"), summary_pair.1)

        (lo, dst)
    }

    fn lower_contest_weights_witness(self, info: IrPosteriorWeightsInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let count_pair = lo.emit_i64_const(info.count)
        lo = count_pair.0
        lo = lo.emit_named_field(dst, make_name("count"), count_pair.1)

        let names_pair = lo.lower_name_array_literal(info.model_names, info.count)
        lo = names_pair.0
        lo = lo.emit_named_field(dst, make_name("model_names"), names_pair.1)

        let weights_pair = lo.lower_f64_array_literal(info.weights, info.count)
        lo = weights_pair.0
        lo = lo.emit_named_field(dst, make_name("weights"), weights_pair.1)

        (lo, dst)
    }

    fn lower_contest_witness_call(self, span: Span, callee_name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_contest_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.contest_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.contest_witnesses[witness_id as usize]
        let contest_id = witness_info.contest_id
        if contest_id < 0 || contest_id >= self.module.epistemic.contest_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let contest_info = self.module.epistemic.contests[contest_id as usize]
        let witness_kind = if witness_info.witness_kind >= 0 { witness_info.witness_kind } else { self.contest_witness_kind_from_callee(callee_name) }
        if witness_kind == 0 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 0))
        }
        if witness_kind == 1 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 1))
        }
        if witness_kind == 2 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 2))
        }
        if witness_kind == 3 {
            return self.emit_f64_const(self.contest_mechanistic_report(contest_info).aggregate_divergence)
        }
        if witness_kind == 4 {
            return self.emit_f64_const(self.contest_metric_value(contest_info, 4))
        }
        if witness_kind == 5 {
            return self.lower_contest_disagreement_witness(contest_id, contest_info)
        }
        if witness_kind == 6 {
            return self.lower_contest_counterexample_witness(self.contest_counterexample(contest_info))
        }
        if witness_kind == 7 {
            return self.lower_contest_weights_witness(self.contest_posterior_weights(contest_info))
        }
        let loe = self.report_error()
        loe.emit_unit()
    }

    fn lower_deferral_reason_witness(self, info: IrDeferredCertificateInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_deferral_policy_name(info.deferral_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let route_name_pair = lo.emit_name_string(lo.epistemic_deferral_policy_route_name(info.deferral_policy_id))
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let evidence_kind_pair = lo.emit_i64_const(info.evidence_kind)
        lo = evidence_kind_pair.0
        lo = lo.emit_named_field(dst, make_name("evidence_kind"), evidence_kind_pair.1)

        let reason_code_pair = lo.emit_i64_const(info.reason_code)
        lo = reason_code_pair.0
        lo = lo.emit_named_field(dst, make_name("reason_code"), reason_code_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        (lo, dst)
    }

    fn report_error(self) -> Lowerer with Mut {
        var lo = self
        lo.error_count = lo.error_count + 1
        lo.had_error = true
        lo
    }

    fn report_fatal_lowering_error(self) -> Lowerer with Mut {
        var lo = self.report_error()
        lo.module = Box::new(ir_empty_module())
        lo.current_fn = IR_INVALID_FN
        lo.current_func_loaded = false
        lo
    }

    fn enter_scope(self) -> Lowerer with Mut {
        var lo = self
        lo.scope_depth = lo.scope_depth + 1
        lo
    }

    fn exit_scope(self) -> Lowerer with Mut {
        var lo = self
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo
    }

    fn bind_local(self, name: Name, reg: i64, is_mut: bool) -> Lowerer with Mut, Alloc, Panic {
        var lo = self
        let _is_mut = is_mut
        var stk = *lo.locals
            if stk.count < 4096 {
                let idx = stk.count
                stk.names[idx as usize] = name
                stk.regs[idx as usize] = reg
                stk.depths[idx as usize] = lo.scope_depth
                stk.struct_types[idx as usize] = ir_empty_name()
                stk.array_elem_float[idx as usize] = 0
                stk.wide_bits[idx as usize] = 0
                stk.wide_signed[idx as usize] = 0
                stk.is_ref[idx as usize] = 0
                stk.variance_regs[idx as usize] = -1
                stk.count = idx + 1
            lo.locals = Box::new(stk)
        } else {
            lo = lo.report_error()
        }
        lo
    }

    fn bind_local_array_elem_float(self, name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.array_elem_float[i as usize] = 1
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn bind_local_struct_type(self, name: Name, type_name: Name) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.struct_types[i as usize] = type_name
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    // Mark a local as a capturing closure bound to synthetic fn `fn_id` (closures step 2).
    fn bind_local_closure_fn_id(self, name: Name, fn_id: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.closure_fn_id[i as usize] = fn_id
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn lookup_local_closure_fn_id(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).closure_fn_id[i as usize]
            }
            i = i - 1
        }
        -1
    }

    fn bind_local_wide_type(self, name: Name, bits: i64, signed: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        if bits <= 64 { return lo }
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.wide_bits[i as usize] = bits
                stk.wide_signed[i as usize] = signed
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn lookup_local(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).regs[i as usize]
            }
            i = i - 1
        }
        IR_INVALID_REG
    }

    fn lookup_local_is_global(self, name: Name) -> bool with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).is_global[i as usize] == 1
            }
            i = i - 1
        }
        false
    }

    fn lookup_local_is_ref(self, name: Name) -> bool with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).is_ref[i as usize] == 1
            }
            i = i - 1
        }
        false
    }

    fn lookup_local_global_bss_offset(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).global_bss_offsets[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn lookup_local_global_bss_size(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).global_bss_sizes[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn lookup_local_struct_type(self, name: Name) -> Name with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).struct_types[i as usize]
            }
            i = i - 1
        }
        ir_empty_name()
    }

    fn lookup_local_array_elem_float(self, name: Name) -> bool with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).array_elem_float[i as usize] == 1
            }
            i = i - 1
        }
        false
    }

    fn bind_local_scalar_kind(self, name: Name, kind: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.scalar_kind[i as usize] = kind
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn lookup_local_scalar_kind(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).scalar_kind[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn bind_local_variance_reg(self, name: Name, variance_reg: i64) -> Lowerer with Mut, Alloc, Panic, Div {
        var lo = self
        var stk = *lo.locals
        var i = stk.count - 1
        while i >= 0 {
            if stk.depths[i as usize] <= lo.scope_depth && ir_name_eq(stk.names[i as usize], name) {
                stk.variance_regs[i as usize] = variance_reg
                lo.locals = Box::new(stk)
                return lo
            }
            i = i - 1
        }
        lo
    }

    fn lookup_local_variance_reg(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).variance_regs[i as usize]
            }
            i = i - 1
        }
        -1
    }

    fn bind_variance_for_base_reg(self, base_reg: i64, variance_reg: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if base_reg < 0 || variance_reg < 0 {
            return lo
        }
        var i: i64 = 0
        while i < lo.variance_base_reg_count {
            if lo.variance_base_regs[i as usize] == base_reg {
                lo.variance_value_regs[i as usize] = variance_reg
                return lo
            }
            i = i + 1
        }
        if lo.variance_base_reg_count < 1024 {
            let idx = lo.variance_base_reg_count
            lo.variance_base_regs[idx as usize] = base_reg
            lo.variance_value_regs[idx as usize] = variance_reg
            lo.variance_base_reg_count = idx + 1
        }
        lo
    }

    fn lookup_variance_for_base_reg(self, base_reg: i64) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.variance_base_reg_count {
            if self.variance_base_regs[i as usize] == base_reg {
                return self.variance_value_regs[i as usize]
            }
            i = i + 1
        }
        -1
    }

    fn emit_zero_variance(self) -> (Lowerer, i64) with Mut, Panic, Div {
        self.emit_f64_const(0.0)
    }

    fn name_is_variance_of(self, n: Name) -> bool with Div {
        n.len == 11
        && n.buf[0] == 118 as i8 && n.buf[1] == 97 as i8
        && n.buf[2] == 114 as i8 && n.buf[3] == 105 as i8
        && n.buf[4] == 97 as i8 && n.buf[5] == 110 as i8
        && n.buf[6] == 99 as i8 && n.buf[7] == 101 as i8
        && n.buf[8] == 95 as i8 && n.buf[9] == 111 as i8
        && n.buf[10] == 102 as i8
    }

    fn name_is_uncertainty_of(self, n: Name) -> bool with Div {
        n.len == 14
        && n.buf[0] == 117 as i8 && n.buf[1] == 110 as i8
        && n.buf[2] == 99 as i8 && n.buf[3] == 101 as i8
        && n.buf[4] == 114 as i8 && n.buf[5] == 116 as i8
        && n.buf[6] == 97 as i8 && n.buf[7] == 105 as i8
        && n.buf[8] == 110 as i8 && n.buf[9] == 116 as i8
        && n.buf[10] == 121 as i8 && n.buf[11] == 95 as i8
        && n.buf[12] == 111 as i8 && n.buf[13] == 102 as i8
    }

    fn lower_measure_value_arg_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => self.lower_expr_ref(&(*list).head),
            None => self.emit_unit(),
        }
    }

    fn lower_measure_uncertainty_arg_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                match (*list).tail {
                    Some(rest) => self.lower_expr_ref(&(*rest).head),
                    None => self.emit_unit(),
                }
            }
            None => self.emit_unit(),
        }
    }

    fn emit_variance_add(self, lhs_v: i64, rhs_v: i64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair = self.fresh_reg()
        var lo = pair.0
        let dst = pair.1
        lo = lo.emit(ir_binop(dst, lhs_v, BinaryOp::OpAdd, rhs_v))
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    fn emit_variance_scale(self, variance_reg: i64, scale_reg: i64) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_sq = self.fresh_reg()
        var lo = pair_sq.0
        let scale_sq = pair_sq.1
        lo = lo.emit(ir_binop(scale_sq, scale_reg, BinaryOp::OpMul, scale_reg))
        lo = lo.emit(ir_mark_float_reg(scale_sq))
        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_binop(dst, scale_sq, BinaryOp::OpMul, variance_reg))
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    fn expr_is_same_ident_ref(self, lhs: &Option<Box<Expr>>, rhs: &Option<Box<Expr>>) -> bool with Mut, Panic, Div {
        match *lhs {
            Some(l) => {
                if (*l).kind == ExprKind::ExprIdent {
                    match *rhs {
                        Some(r) => {
                            if (*r).kind == ExprKind::ExprIdent {
                                return ir_name_eq((*l).name, (*r).name)
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        false
    }

    fn lower_knowledge_variance_for_ident(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div, Alloc {
        let shadow = self.lookup_local_variance_reg(name)
        if shadow >= 0 {
            return (self, shadow)
        }
        let base = self.lookup_local(name)
        if base < 0 {
            return (self, -1)
        }
        let base_shadow = self.lookup_variance_for_base_reg(base)
        if base_shadow >= 0 {
            return (self, base_shadow)
        }
        let pair = self.fresh_reg()
        var lo = pair.0
        let dst = pair.1
        var instr = ir_field_get(dst, base, 1, make_name("variance"))
        instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        lo = lo.emit(instr)
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    fn lower_expr_variance_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    if ir_name_is_measure(callee_name) {
                        let unc_pair = self.lower_measure_uncertainty_arg_ref(&(*e).args)
                        var lo = unc_pair.0
                        let unc_reg = unc_pair.1
                        lo = lo.emit(ir_mark_float_reg(unc_reg))
                        let pair_v = lo.fresh_reg()
                        lo = pair_v.0
                        let variance_reg = pair_v.1
                        lo = lo.emit(ir_binop(variance_reg, unc_reg, BinaryOp::OpMul, unc_reg))
                        lo = lo.emit(ir_mark_float_reg(variance_reg))
                        return (lo, variance_reg)
                    }
                }
                _ => {}
            }
            return (self, -1)
        }
        if (*e).kind == ExprKind::ExprIdent {
            let local_v = self.lookup_local_variance_reg((*e).name)
            if local_v >= 0 {
                return (self, local_v)
            }
            if ir_name_eq(self.lookup_local_struct_type((*e).name), make_name("Knowledge")) {
                return self.lower_knowledge_variance_for_ident((*e).name)
            }
            return (self, -1)
        }
        if (*e).kind == ExprKind::ExprFloatLit || (*e).kind == ExprKind::ExprIntLit {
            return self.emit_zero_variance()
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            if ir_name_eq((*e).name, make_name("value")) {
                match (*e).left {
                    Some(base_expr) => {
                        if (*base_expr).kind == ExprKind::ExprIdent {
                            return self.lower_knowledge_variance_for_ident((*base_expr).name)
                        }
                    }
                    _ => {}
                }
            }
            return (self, -1)
        }
        if (*e).kind == ExprKind::ExprBinary {
            let same_ident = self.expr_is_same_ident_ref(&(*e).left, &(*e).right)
            if same_ident && (*e).bin_op == BinaryOp::OpSub {
                return self.emit_zero_variance()
            }
            let pair_lv = match (*e).left {
                Some(l_expr) => self.lower_expr_variance_ref(&(*l_expr)),
                _ => (self, -1),
            }
            var lo = pair_lv.0
            let lv0 = pair_lv.1
            let lv_pair = if lv0 >= 0 { (lo, lv0) } else { lo.emit_zero_variance() }
            lo = lv_pair.0
            let lv = lv_pair.1

            let pair_rv = match (*e).right {
                Some(r_expr) => lo.lower_expr_variance_ref(&(*r_expr)),
                _ => (lo, -1),
            }
            lo = pair_rv.0
            let rv0 = pair_rv.1
            let rv_pair = if rv0 >= 0 { (lo, rv0) } else { lo.emit_zero_variance() }
            lo = rv_pair.0
            let rv = rv_pair.1

            if (*e).bin_op == BinaryOp::OpAdd || (*e).bin_op == BinaryOp::OpSub {
                if same_ident && (*e).bin_op == BinaryOp::OpAdd {
                    let two_pair = lo.emit_f64_const(2.0)
                    lo = two_pair.0
                    return lo.emit_variance_scale(lv, two_pair.1)
                }
                return lo.emit_variance_add(lv, rv)
            }
            if (*e).bin_op == BinaryOp::OpMul {
                if same_ident {
                    let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                    lo = lhs_val_pair.0
                    let two_pair = lo.emit_f64_const(2.0)
                    lo = two_pair.0
                    let scale_pair = lo.fresh_reg()
                    lo = scale_pair.0
                    let scale = scale_pair.1
                    lo = lo.emit(ir_binop(scale, two_pair.1, BinaryOp::OpMul, lhs_val_pair.1))
                    lo = lo.emit(ir_mark_float_reg(scale))
                    return lo.emit_variance_scale(lv, scale)
                }
                let lhs_val_pair = lo.lower_opt_expr_ref(&(*e).left)
                lo = lhs_val_pair.0
                let lhs_val = lhs_val_pair.1
                let rhs_val_pair = lo.lower_opt_expr_ref(&(*e).right)
                lo = rhs_val_pair.0
                let rhs_val = rhs_val_pair.1
                let term_l_pair = lo.emit_variance_scale(lv, rhs_val)
                lo = term_l_pair.0
                let term_r_pair = lo.emit_variance_scale(rv, lhs_val)
                lo = term_r_pair.0
                return lo.emit_variance_add(term_l_pair.1, term_r_pair.1)
            }
            return (lo, -1)
        }
        (self, -1)
    }

    // Returns the print builtin name for println's first argument.
    //   int literal / i64 var (scalar_kind=1) → print_int
    //   f64-valued expression                 → print_f64
    //   everything else                       → print
    // Routing f64 through print treats the IEEE bits as a char* and segfaults.
    // The native backend's print_f64 builtin consumes the lowered f64 payload
    // through the same integer slot convention used by emitted call arguments.
    fn println_dispatch_name(self, args: &Option<Box<ExprList>>) -> Name with Mut, Panic, Div, Alloc {
        match *args {
            Some(list) => {
                let sk = self.expr_result_scalar_kind_ref(&(*list).head)
                if sk == 1 {
                    make_name("print_int")
                } else if sk == 2 {
                    make_name("print_f64")
                } else {
                    make_name("print")
                }
            }
            _ => make_name("print"),
        }
    }

    fn bind_reg_array_elem_float(self, reg: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if reg < 0 {
            return lo
        }
        var i: i64 = 0
        while i < lo.array_elem_float_reg_count {
            if lo.array_elem_float_regs[i as usize] == reg {
                return lo
            }
            i = i + 1
        }
        if lo.array_elem_float_reg_count < 512 {
            lo.array_elem_float_regs[lo.array_elem_float_reg_count as usize] = reg
            lo.array_elem_float_reg_count = lo.array_elem_float_reg_count + 1
        }
        lo
    }

    fn lookup_reg_array_elem_float(self, reg: i64) -> bool with Mut, Panic, Div {
        if reg < 0 {
            return false
        }
        var i: i64 = 0
        while i < self.array_elem_float_reg_count {
            if self.array_elem_float_regs[i as usize] == reg {
                return true
            }
            i = i + 1
        }
        false
    }

    fn lookup_local_wide_bits(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).wide_bits[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn lookup_local_wide_signed(self, name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
                return (*self.locals).wide_signed[i as usize]
            }
            i = i - 1
        }
        0
    }

    fn preload_bss_globals_as_locals(self) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var i: i64 = 0
        while i < lo.module.fn_count && i < 2048 {
            let g = lo.module.functions[i as usize]
            if g.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                let pair = lo.fresh_reg()
                lo = pair.0
                let reg = pair.1
                if g.bss_size > 8 {
                    lo = lo.emit(ir_load_imm(reg, BSS_BASE_LINUX + g.param_count))
                } else {
                    lo = lo.emit(ir_load_global(reg, g.param_count, g.name))
                }
                lowerer_bind_local_mut(&! lo, g.name, reg, false)
                lowerer_mark_local_global_mut(&! lo, g.name, g.param_count, g.bss_size)
                let global_elem_kind = lower_global_type_table_lookup(&(*lo.global_types), i)
                if lower_aggregate_diag_enabled() {
                    print("lower_agg: global name=")
                    print(str_from_bytes(g.name.buf, g.name.len))
                    print(" elem_kind=")
                    print_int(global_elem_kind)
                    print("\n")
                }
                if global_elem_kind == LOWER_GLOBAL_ELEM_F64 {
                    lowerer_mark_local_array_elem_float_mut(&! lo, g.name)
                }
            }
            i = i + 1
        }
        lo
    }

    // Sprint 228: Look up a function by name in the module. Returns (Lowerer, fn_id) where
    // fn_id >= 0 if found, -1 if not a known function.
    fn lookup_fn_by_name(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.fn_count {
            if ir_name_eq(self.module.functions[i].name, name) {
                return (self, i)
            }
            i = i + 1
        }
        (self, -1)
    }

    fn return_struct_name_for_fn_id(self, fn_id: i64) -> Name with Mut, Panic, Div, Alloc {
        if fn_id >= 0 && fn_id < self.module.fn_count {
            return self.module.functions[fn_id as usize].return_struct_name
        }
        ir_empty_name()
    }

    fn expr_call_return_struct_name_ref(self, expr: &Expr) -> Name with Mut, Panic, Div, Alloc {
        if (*expr).kind != ExprKind::ExprCall { return ir_empty_name() }
        match (*expr).left {
            Some(callee_expr) => {
                var callee_name = ir_empty_name()
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee_name = (*callee_expr).name
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    callee_name = ir_path_first_name((*callee_expr).path)
                } else {
                    return ir_empty_name()
                }
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                self.return_struct_name_for_fn_id(fn_id)
            }
            None => ir_empty_name(),
        }
    }

    fn fresh_reg(self) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            if lo.probe_mode {
                print("lower_probe: fresh_reg_invalid current_fn=")
                print_int(lo.current_fn)
                print(" fn_count=")
                print_int(lo.module.fn_count)
                print("\n")
            }
            let loe = lo.report_error()
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let reg = (*current_func_box).reg_count
        (*current_func_box).reg_count = reg + 1
        lo.current_func = current_func_box
        (lo, reg)
    }

    fn fresh_wide_reg(self, limbs: i64) -> (Lowerer, i64) with Mut, Panic, Div, IO {
        var lo = self
        if limbs <= 1 {
            return lo.fresh_reg()
        }
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error()
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let reg = (*current_func_box).reg_count
        (*current_func_box).reg_count = reg + limbs
        lo.current_func = current_func_box
        (lo, reg)
    }

    fn expr_wide_bits_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind == ExprKind::ExprCast {
            let bits = lower_opt_type_wide_bits(&(*expr).cast_type)
            if bits > 64 { return bits }
            return self.expr_wide_bits_opt_ref(&(*expr).left)
        }
        if (*expr).kind == ExprKind::ExprIdent {
            return self.lookup_local_wide_bits((*expr).name)
        }
        if (*expr).kind == ExprKind::ExprBinary {
            let lb = self.expr_wide_bits_opt_ref(&(*expr).left)
            let rb = self.expr_wide_bits_opt_ref(&(*expr).right)
            if lb > 64 && lb == rb { return lb }
            if lb > 64 { return lb }
            if rb > 64 { return rb }
        }
        0
    }

    fn expr_wide_bits_opt_ref(self, opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(e) => self.expr_wide_bits_ref(&(*e)),
            None => 0,
        }
    }

    fn expr_wide_signed_ref(self, expr: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*expr).kind == ExprKind::ExprCast {
            let signed = lower_opt_type_wide_signed(&(*expr).cast_type)
            if lower_opt_type_wide_bits(&(*expr).cast_type) > 64 { return signed }
            return self.expr_wide_signed_opt_ref(&(*expr).left)
        }
        if (*expr).kind == ExprKind::ExprIdent {
            return self.lookup_local_wide_signed((*expr).name)
        }
        if (*expr).kind == ExprKind::ExprBinary {
            return self.expr_wide_signed_opt_ref(&(*expr).left)
        }
        0
    }

    fn expr_wide_signed_opt_ref(self, opt: &Option<Box<Expr>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(e) => self.expr_wide_signed_ref(&(*e)),
            None => 0,
        }
    }

    fn fresh_label(self) -> (Lowerer, i64) with Mut, Panic, Div {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            let loe = lo.report_error()
            return (loe, 0)
        }
        var current_func_box = lo.current_func
        let label = (*current_func_box).label_count
        (*current_func_box).label_count = label + 1
        lo.current_func = current_func_box
        (lo, label)
    }

    fn emit(self, instr: IrInstr) -> Lowerer with Mut, Panic, Div, IO {
        var lo = self
        if lo.current_fn < 0 || lo.current_fn >= lo.module.fn_count {
            if lo.probe_mode {
                print("lower_probe: emit_invalid current_fn=")
                print_int(lo.current_fn)
                print(" fn_count=")
                print_int(lo.module.fn_count)
                print("\n")
            }
            return lo.report_error()
        }
        var current_func_box = lo.current_func
        let instr_count = (*current_func_box).instr_count
        if instr_count < IR_MAX_INSTRS {
            (*current_func_box).instrs[instr_count as usize] = instr
            (*current_func_box).instr_count = instr_count + 1
            lo.current_func = current_func_box
            lo
        } else {
            if lo.probe_mode {
                print("lower_probe: emit_overflow instr_count=")
                print_int(instr_count)
                print(" fn=")
                print(str_from_bytes(lo.current_func.name.buf, lo.current_func.name.len))
                print("\n")
            }
            lo.report_error()
        }
    }

    fn emit_unit(self) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair = self.fresh_reg()
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_load_imm(reg, 0))
        (lo2, reg)
    }

    fn intern_string(self, n: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < (*self.module).string_count {
            if ir_name_eq((*self.module).string_table[i as usize], n) {
                return (self, i)
            }
            i = i + 1
        }
        var lo = self
        if (*lo.module).string_count < IR_MAX_STRINGS {
            let idx = (*lo.module).string_count
            (*lo.module).string_table[idx as usize] = n
            (*lo.module).string_count = idx + 1
            (lo, idx)
        } else {
            let loe = lo.report_error()
            (loe, -1)
        }
    }

    fn find_or_add_fn_id(self, name: Name) -> (Lowerer, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.module.fn_count {
            if ir_name_eq(self.module.functions[i].name, name) {
                return (self, i)
            }
            i = i + 1
        }

        var lo = self
        if lo.module.fn_count < IR_MAX_FUNCS {
            let idx = (*lo.module).fn_count
            var new_fn = ir_empty_function()
            new_fn.name = name
            (*lo.module).functions[idx as usize] = new_fn
            (*lo.module).fn_count = idx + 1
            (lo, idx)
        } else {
            let loe = lo.report_error()
            (loe, -1)
        }
    }

    fn fn_ends_with_return(self) -> bool with Mut, Panic, Div {
        if self.current_fn < 0 || self.current_fn >= self.module.fn_count {
            return false
        }
        let count = self.current_func.instr_count
        if count <= 0 {
            return false
        }
        let last = self.current_func.instrs[count - 1]
        last.op == IrOpcode::IrReturn
    }

    fn push_loop_labels(self, continue_label: i64, break_label: i64) -> Lowerer with Mut, Panic, Div {
        var lo = self
        if lo.loop_depth < 256 {
            // Store through an extracted single-level Box pointer: the two-level
            // nested stores `(*lo.loop_labels).break_labels[depth] = ...` are
            // discarded by the codegen (the same two-level-nested-store miscompile
            // that emptied enum_variants), so loop labels were never recorded and
            // every break/continue then failed current_break/continue_label and
            // reported an error (ir_bodies_failed) in both for and while loops.
            var ll_box = lo.loop_labels
            (*ll_box).continue_labels[lo.loop_depth as usize] = continue_label
            (*ll_box).break_labels[lo.loop_depth as usize] = break_label
            lo.loop_depth = lo.loop_depth + 1
            lo
        } else {
            lo.report_error()
        }
    }

    fn pop_loop_labels(self) -> Lowerer with Mut {
        var lo = self
        if lo.loop_depth > 0 {
            lo.loop_depth = lo.loop_depth - 1
        }
        lo
    }

    fn current_break_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            (*self.loop_labels).break_labels[(self.loop_depth - 1) as usize]
        }
    }

    fn current_continue_label(self) -> i64 with Panic {
        if self.loop_depth <= 0 {
            IR_INVALID_LABEL
        } else {
            (*self.loop_labels).continue_labels[(self.loop_depth - 1) as usize]
        }
    }

    // Phase 3.2: Proper struct field index lookup via layout table
    fn field_idx_from_name(self, struct_name: Name, field_name: Name) -> i64 with Mut, Panic, Div {
        // Search layout table for the struct
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, struct_name) {
                // Found struct — search its fields
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    }
                    fi = fi + 1
                }
                // Field not found in the named layout. Keep searching the rest
                // of the table before falling back to the legacy hash path;
                // partially seeded layouts must not collapse every miss to .0.
                var sj: i64 = 0
                while sj < (*self.struct_layouts).count {
                    var fj: i64 = 0
                    while fj < (*self.struct_layouts).entries[sj as usize].field_count {
                        if ir_name_eq((*self.struct_layouts).entries[sj as usize].fields[fj as usize].name, field_name) {
                            return (*self.struct_layouts).entries[sj as usize].fields[fj as usize].index
                        }
                        fj = fj + 1
                    }
                    sj = sj + 1
                }
                if field_name.len <= 0 {
                    return 0
                }
                return (field_name.buf[0] as i64) % 64
            }
            si = si + 1
        }
        // Struct not in layout table — fallback: use first byte hash (legacy compat)
        if field_name.len <= 0 {
            0
        } else {
            (field_name.buf[0] as i64) % 64
        }
    }

    // Phase 3.2: Lookup struct field index without needing struct name
    // Used when we don't know the struct type at the call site
    fn field_idx_from_name_simple(self, n: Name) -> i64 with Mut, Panic, Div {
        // Try numeric field access first (.0, .1, .2, ...)
        let first_byte = n.buf[0] as i64
        if n.len == 1 && first_byte >= 48 && first_byte <= 57 {
            return first_byte - 48
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, n) {
                    return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                }
                fi = fi + 1
            }
            si = si + 1
        }
        // Last-resort legacy compatibility for unregistered dynamic/foreign shapes.
        if n.len <= 0 {
            0
        } else {
            (n.buf[0] as i64) % 64
        }
    }

    fn field_idx_from_struct_literal_name(self, struct_name: Name, field_name: Name, default_idx: i64) -> i64 with Mut, Panic, Div {
        if struct_name.len <= 0 {
            return self.field_idx_from_name_simple(field_name)
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, struct_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].index
                    }
                    fi = fi + 1
                }
                return default_idx
            }
            si = si + 1
        }
        default_idx
    }

    fn field_is_float_by_name_simple(self, n: Name) -> bool with Mut, Panic, Div {
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, n) {
                    return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 1
                }
                fi = fi + 1
            }
            si = si + 1
        }
        false
    }

    fn field_is_float_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 1
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    // println i64-segfault fix: field analogue of field_is_float_by_name_simple,
    // testing the `is_float == 3` scalar-i64 marker set in register_struct_fields_ref.
    fn field_is_int_by_name_simple(self, n: Name) -> bool with Mut, Panic, Div {
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, n) {
                    return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 3
                }
                fi = fi + 1
            }
            si = si + 1
        }
        false
    }

    // println i64-segfault fix: field analogue of field_is_float_for_struct.
    fn field_is_int_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 3
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    // println i64-segfault fix: field analogue of field_is_float_for_base_ref.
    fn field_is_int_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    if self.field_is_int_for_struct(type_name, field_name) {
                        return true
                    }
                }
                false
            }
            _ => false,
        }
    }

    fn field_array_elem_is_float_for_struct(self, type_name: Name, field_name: Name) -> bool with Mut, Panic, Div {
        if type_name.len <= 0 {
            return false
        }
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
                var fi: i64 = 0
                while fi < (*self.struct_layouts).entries[si as usize].field_count {
                    if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                        return (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 2
                    }
                    fi = fi + 1
                }
            }
            si = si + 1
        }
        false
    }

    fn field_array_elem_is_float_by_name_simple(self, field_name: Name) -> bool with Mut, Panic, Div {
        var si: i64 = 0
        while si < (*self.struct_layouts).count {
            var fi: i64 = 0
            while fi < (*self.struct_layouts).entries[si as usize].field_count {
                if ir_name_eq((*self.struct_layouts).entries[si as usize].fields[fi as usize].name, field_name) {
                    if (*self.struct_layouts).entries[si as usize].fields[fi as usize].is_float == 2 {
                        return true
                    }
                }
                fi = fi + 1
            }
            si = si + 1
        }
        false
    }

    fn field_is_float_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    if self.field_is_float_for_struct(type_name, field_name) {
                        return true
                    }
                }
                false
            }
            _ => false,
        }
    }

    fn field_idx_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*base_expr).name)
                    if type_name.len > 0 {
                        return self.field_idx_from_name(type_name, field_name)
                    }
                }
                self.field_idx_from_name_simple(field_name)
            }
            _ => self.field_idx_from_name_simple(field_name),
        }
    }

    fn field_array_elem_is_float_for_base_ref(self, base_opt: &Option<Box<Expr>>, field_name: Name) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(owner_expr) => {
                if (*owner_expr).kind == ExprKind::ExprIdent {
                    let type_name = self.lookup_local_struct_type((*owner_expr).name)
                    if self.field_array_elem_is_float_for_struct(type_name, field_name) {
                        return true
                    }
                    return self.field_array_elem_is_float_by_name_simple(field_name)
                }
                self.field_array_elem_is_float_by_name_simple(field_name)
            }
            _ => self.field_array_elem_is_float_by_name_simple(field_name),
        }
    }

    fn index_base_elem_is_float_ref(self, base_opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *base_opt {
            Some(base_expr) => {
                if (*base_expr).kind == ExprKind::ExprIdent {
                    return self.lookup_local_array_elem_float((*base_expr).name)
                }
                if (*base_expr).kind == ExprKind::ExprFieldAccess {
                    return self.field_array_elem_is_float_for_base_ref(&(*base_expr).left, (*base_expr).name)
                }
                if (*base_expr).kind == ExprKind::ExprUnary && (*base_expr).un_op == UnaryOp::OpDeref {
                    return self.index_base_elem_is_float_ref(&(*base_expr).left)
                }
                false
            }
            _ => false,
        }
    }

    fn opt_expr_result_is_float_ref(self, opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(expr) => self.expr_result_is_float_ref(&(*expr)),
            _ => false,
        }
    }

    // String-ness of an expression result, for routing `+`/`++` on strings to the
    // str_concat builtin (string locals are tracked with scalar_kind 3).
    fn opt_expr_result_is_string_ref(self, opt: &Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(expr) => self.expr_result_is_string_ref(&(*expr)),
            _ => false,
        }
    }

    fn expr_result_is_string_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprStringLit {
            return true
        }
        if (*e).kind == ExprKind::ExprIdent {
            return self.lookup_local_scalar_kind((*e).name) == 3
        }
        if (*e).kind == ExprKind::ExprBinary {
            if (*e).bin_op == BinaryOp::OpAdd || (*e).bin_op == BinaryOp::OpConcat {
                return self.opt_expr_result_is_string_ref(&(*e).left) || self.opt_expr_result_is_string_ref(&(*e).right)
            }
        }
        false
    }

    fn expr_result_is_float_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprIntLit {
            return false
        }
        if (*e).kind == ExprKind::ExprBoolLit {
            return false
        }
        if (*e).kind == ExprKind::ExprStringLit {
            return false
        }
        if (*e).kind == ExprKind::ExprFloatLit {
            return true
        }
        if (*e).kind == ExprKind::ExprIdent {
            return self.lookup_local_scalar_kind((*e).name) == 2
        }
        if (*e).kind == ExprKind::ExprCast {
            return lower_cast_type_is_f64(&(*e).cast_type)
        }
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    if self.name_is_variance_of(callee_name) || self.name_is_uncertainty_of(callee_name) {
                        return true
                    }
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                    if fn_id >= 0 && fn_id < self.module.fn_count {
                        return self.module.functions[fn_id as usize].returns_float == 1
                    }
                }
                None => {}
            }
            return false
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            return self.field_is_float_for_base_ref(&(*e).left, (*e).name) || self.field_is_float_by_name_simple((*e).name)
        }
        if (*e).kind == ExprKind::ExprIndex {
            return self.index_base_elem_is_float_ref(&(*e).left)
        }
        if (*e).kind == ExprKind::ExprBinary {
            if lower_binary_op_is_compare((*e).bin_op) {
                return false
            }
            return self.opt_expr_result_is_float_ref(&(*e).left) || self.opt_expr_result_is_float_ref(&(*e).right)
        }
        if (*e).kind == ExprKind::ExprUnary {
            if (*e).un_op == UnaryOp::OpNeg {
                return self.opt_expr_result_is_float_ref(&(*e).left)
            }
            return false
        }
        // An if-expression yields a float if either arm yields a float. Native
        // codegen types the merge register flow-insensitively (last linear write
        // wins), and an f64 literal arm (e.g. `else { 0.0 }`) lowers to IrLoadImm
        // (int-flagged), so without this case `let k = if c { a/b } else { 0.0 }`
        // leaves `k` untyped and a downstream `acc + k` cvtsi2sd-corrupts the bits.
        if (*e).kind == ExprKind::ExprIf {
            return self.opt_block_tail_is_float_ref(&(*e).block) || self.opt_expr_result_is_float_ref(&(*e).else_expr)
        }
        false
    }

    // True iff the block's value (its trailing expression statement) yields a
    // float. A block whose last statement is a let/var/assign yields unit → false.
    fn opt_block_tail_is_float_ref(self, blk_opt: &Option<Box<Block>>) -> bool with Mut, Panic, Div, Alloc {
        match *blk_opt {
            Some(blk) => self.block_tail_is_float_ref(&(*blk)),
            _ => false,
        }
    }

    fn block_tail_is_float_ref(self, blk: &Block) -> bool with Mut, Panic, Div, Alloc {
        var current = &(*blk).stmts
        var result = false
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    if stmt_ref.kind == StmtKind::StmtExpr {
                        result = self.opt_expr_result_is_float_ref(&stmt_ref.expr)
                    } else {
                        result = false
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        result
    }

    fn expr_result_scalar_kind_ref(self, e: &Expr) -> i64 with Mut, Panic, Div, Alloc {
        if (*e).kind == ExprKind::ExprIntLit {
            return 1
        }
        if (*e).kind == ExprKind::ExprFloatLit {
            return 2
        }
        if (*e).kind == ExprKind::ExprStringLit {
            return 3
        }
        if (*e).kind == ExprKind::ExprIdent {
            return self.lookup_local_scalar_kind((*e).name)
        }
        if (*e).kind == ExprKind::ExprCast {
            if lower_cast_type_is_f64(&(*e).cast_type) { return 2 }
            if lower_cast_type_is_i64(&(*e).cast_type) { return 1 }
            return 0
        }
        // println i64-segfault fix: resolve a call's/field's return type to the
        // scalar-int kind when it is POSITIVELY known to be i64 (not merely "not
        // float") — mirrors the float resolution in expr_result_is_float_ref
        // (module.functions[fn_id].returns_float), using return_struct_name
        // instead, since that field carries the return type's name for ANY
        // TypeNamed return (see lower_opt_type_named_name), not only structs.
        // When the type can't be resolved this way, fall through unchanged so
        // string/bool/void/unresolved results keep routing to the char* printer.
        if (*e).kind == ExprKind::ExprCall {
            match (*e).left {
                Some(callee_expr) => {
                    let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                    let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                    if fn_id >= 0 && fn_id < self.module.fn_count {
                        if lower_name_is_i64_type(self.module.functions[fn_id as usize].return_struct_name) {
                            return 1
                        }
                    }
                }
                None => {}
            }
        }
        if (*e).kind == ExprKind::ExprMethodCall {
            let recv_type = self.lower_method_recv_type(&(*e).left)
            let call_name = if recv_type.len > 0 { ir_mangle_method_name(recv_type, (*e).name) } else { (*e).name }
            let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, call_name)
            if fn_id >= 0 && fn_id < self.module.fn_count {
                if lower_name_is_i64_type(self.module.functions[fn_id as usize].return_struct_name) {
                    return 1
                }
            }
        }
        if (*e).kind == ExprKind::ExprFieldAccess {
            if self.field_is_int_for_base_ref(&(*e).left, (*e).name) || self.field_is_int_by_name_simple((*e).name) {
                return 1
            }
        }
        // println i64-segfault fix (array-element axis): an array subscript `a[i]`
        // (including a struct-field array `s.c[i]`) yields a scalar element. The
        // float classifier (expr_result_is_float_ref) already routes float-element
        // indexing to print_f64; without this case a non-float element (i64) fell
        // through to kind 0 → the char* printer, which deref'd the integer value as
        // a pointer and SIGSEGV'd (e.g. `println(r.c[0])` in generic_struct_return).
        // Monomorphized generic structs register their fields from the generic
        // declaration (`[F;N]`), so a declared-type i64 marker cannot fire for them;
        // classify float positively (matching the existing float path) and default
        // the remaining numeric element to int. No test in the corpus prints a
        // string/pointer array element, so this cannot misroute an existing string.
        if (*e).kind == ExprKind::ExprIndex {
            if self.index_base_elem_is_float_ref(&(*e).left) {
                return 2
            }
            return 1
        }
        if (*e).kind == ExprKind::ExprBinary {
            if lower_binary_op_is_compare((*e).bin_op) {
                return 1
            }
            if self.expr_result_is_float_ref(e) {
                return 2
            }
        }
        if self.expr_result_is_float_ref(e) {
            return 2
        }
        0
    }

    fn ensure_struct_literal_layout_ref(self, type_name: Name, fields: &Option<Box<StructFieldList>>) -> Lowerer with Mut, Panic, Div, Alloc {
        var lo = self
        if type_name.len <= 0 {
            return lo
        }
        var si: i64 = 0
        while si < (*lo.struct_layouts).count {
            if ir_name_eq((*lo.struct_layouts).entries[si as usize].type_name, type_name) {
                var current_existing = fields
                while true {
                    match *current_existing {
                        Some(list_existing) => {
                            let literal_float_kind = lower_struct_field_float_kind_ref(&(*list_existing).head.value)
                            if literal_float_kind > 0 {
                                var fi_existing: i64 = 0
                                while fi_existing < (*lo.struct_layouts).entries[si as usize].field_count {
                                    if ir_name_eq((*lo.struct_layouts).entries[si as usize].fields[fi_existing as usize].name, (*list_existing).head.name) {
                                        (*lo.struct_layouts).entries[si as usize].fields[fi_existing as usize].is_float = literal_float_kind
                                    }
                                    fi_existing = fi_existing + 1
                                }
                            }
                            current_existing = &(*list_existing).tail
                        }
                        _ => break
                    }
                }
                return lo
            }
            si = si + 1
        }
        if (*lo.struct_layouts).count >= 256 {
            return lo.report_error()
        }
        let layout_idx = (*lo.struct_layouts).count
        (*lo.struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
            type_name: type_name,
            fields: [empty_struct_field_entry(); 64],
            field_count: 0,
        }
        (*lo.struct_layouts).count = layout_idx + 1

        var current = fields
        var field_idx: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let fc = (*lo.struct_layouts).entries[layout_idx as usize].field_count
                    if fc < 64 {
                        // Single-level idiom: the two-level `(*box).entries[i].fields[fc] = …`
                        // store is dropped by the lean_single by-value-aggregate miscompile.
                        var lay_entry = (*lo.struct_layouts).entries[layout_idx as usize]
                        lay_entry.fields[fc as usize] = StructFieldEntry {
                            name: (*list).head.name,
                            index: field_idx,
                            is_float: lower_struct_field_float_kind_ref(&(*list).head.value),
                        }
                        lay_entry.field_count = fc + 1
                        (*lo.struct_layouts).entries[layout_idx as usize] = lay_entry
                    }
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    // Phase 3.1: Register enum variant discriminants
    fn register_enum_variants_ref(self, enum_name: Name, variants: &Option<Box<VariantDefList>>, next_disc: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        var lo = self
        var current = variants
        var disc = next_disc
        var table = *lo.enum_variants
        while true {
            match *current {
                Some(list) => {
                    if table.count < 1024 {
                        table.entries[table.count as usize] = EnumVariantEntry {
                            enum_name: enum_name,
                            variant_name: (*list).head.name,
                            discriminant: disc,
                        }
                        table.count = table.count + 1
                    }
                    current = &(*list).tail
                    disc = disc + 1
                }
                _ => break
            }
        }
        lo.enum_variants = Box::new(table)
        lo
    }

    fn register_enum_variants(self, enum_name: Name, variants: Option<Box<VariantDefList>>, next_disc: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        self.register_enum_variants_ref(enum_name, &variants, next_disc)
    }

    // Phase 3.1: Lookup enum variant discriminant by variant name
    fn lookup_variant_discriminant(self, variant_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < (*self.enum_variants).count {
            if ir_name_eq((*self.enum_variants).entries[i as usize].variant_name, variant_name) {
                return (*self.enum_variants).entries[i as usize].discriminant
            }
            i = i + 1
        }
        -1
    }

    // Phase 3.2: Register struct field layout
    fn register_struct_fields_ref(self, type_name: Name, fields: &Option<Box<FieldDefList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_ordered_diag_enabled() {
            print("lower_ordered: struct_fields_begin type=")
            print(str_from_bytes(type_name.buf, type_name.len))
            print(" idx=")
            print_int(idx)
            print("\n")
        }
        var layout_idx: i64 = -1
        var si: i64 = 0
        while si < (*lo.struct_layouts).count {
            if ir_name_eq((*lo.struct_layouts).entries[si as usize].type_name, type_name) {
                layout_idx = si
            }
            si = si + 1
        }
        if layout_idx < 0 {
            if (*lo.struct_layouts).count < 256 {
                layout_idx = (*lo.struct_layouts).count
                (*lo.struct_layouts).entries[layout_idx as usize] = StructLayoutEntry {
                    type_name: type_name,
                    fields: [empty_struct_field_entry(); 64],
                    field_count: 0,
                }
                (*lo.struct_layouts).count = (*lo.struct_layouts).count + 1
            } else {
                return lo.report_error()
            }
        }
        var current = fields
        var field_idx = idx
        while true {
            match *current {
                Some(list) => {
                    let fc = (*lo.struct_layouts).entries[layout_idx as usize].field_count
                    if fc < 64 {
                        // Single-level idiom: the two-level `(*box).entries[i].fields[fc] = …`
                        // store is dropped by the lean_single by-value-aggregate miscompile.
                        var lay_entry = (*lo.struct_layouts).entries[layout_idx as usize]
                        lay_entry.fields[fc as usize] = StructFieldEntry {
                            name: (*list).head.name,
                            index: field_idx,
                            // println i64-segfault fix: reuse the `is_float` numeric-kind slot
                            // with a new `3` marker for scalar-i64 fields (2 is already taken by
                            // f64-array). Existing consumers only test `== 1` / `== 2`, so this
                            // is inert for them; field_is_int_* below tests `== 3`.
                            is_float: if lower_type_expr_is_f64(&(*list).head.ty) { 1 } else if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 2 } else if lower_type_expr_is_i64(&(*list).head.ty) { 3 } else { 0 },
                        }
                        lay_entry.field_count = fc + 1
                        (*lo.struct_layouts).entries[layout_idx as usize] = lay_entry
                    }
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: struct_fields_done type=")
            print(str_from_bytes(type_name.buf, type_name.len))
            print(" field_count=")
            print_int((*lo.struct_layouts).entries[layout_idx as usize].field_count)
            print("\n")
        }
        lo
    }

    fn register_struct_fields(self, type_name: Name, fields: Option<Box<FieldDefList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc {
        self.register_struct_fields_ref(type_name, &fields, idx)
    }

    fn lower_program_items_ref(self, items: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if lower_live_diag_enabled() {
                        print("lower_live: item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if lower_ordered_diag_enabled() {
                        print("lower_ordered: item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if kind == ItemKind::ItemFn {
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        if lower_body_diag_enabled() {
                            print("lower_live: item_fn_before_match name=")
                            print(str_from_bytes(name.buf, name.len))
                            print("\n")
                        }
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                if lower_body_diag_enabled() {
                                    print("lower_live: item_fn_before_lower name=")
                                    print(str_from_bytes(name.buf, name.len))
                                    print("\n")
                                }
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => {
                                lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => {
                                lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.lower_impl_methods_ref(name, &(*id).methods)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_items(self, items: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_items_ref(&items)
    }

    fn preseed_program_items_ref(self, items: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if lo.probe_mode && lower_summary_diag_enabled() {
                        print("lower_probe: preseed_item kind=")
                        if kind == ItemKind::ItemFn { print("fn") }
                        else if kind == ItemKind::ItemStruct { print("struct") }
                        else if kind == ItemKind::ItemEnum { print("enum") }
                        else if kind == ItemKind::ItemImpl { print("impl") }
                        else { print("other") }
                        print(" name=")
                        print(str_from_bytes(name.buf, name.len))
                        print("\n")
                    }
                    if kind == ItemKind::ItemFn {
                        if !ir_name_eq(name, skip_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                            match *fn_def_opt_ref {
                                Some(fd) => {
                                    lo = lo.preseed_fn_signature_ref(name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                    // Sprint 108/109: set strategy for extern/export fns
                                    let pair_ps = lo.find_or_add_fn_id(name)
                                    lo = pair_ps.0
                                    let fn_id_ps = pair_ps.1
                                    if fn_id_ps >= 0 {
                                        if (*fd).is_kernel {
                                            (*lo.module).functions[fn_id_ps as usize].compile_strategy = 6
                                        } else if visibility_to_bool(head.visibility) {
                                            (*lo.module).functions[fn_id_ps as usize].compile_strategy = 7
                                            let exp_count = (*lo.module).export_count
                                            if exp_count < 64 {
                                                (*lo.module).export_names[exp_count as usize] = name
                                                (*lo.module).export_count = exp_count + 1
                                            }
                                        }
                                    }
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => {
                                lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => {
                                lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0)
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.preseed_impl_method_summaries_ref(name, &(*id).methods, skip_name)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn preseed_program_items(self, items: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_program_items_ref(&items, skip_name)
    }

    fn preseed_program_function_summaries_ref(self, items: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if kind == ItemKind::ItemFn {
                        if !ir_name_eq(name, skip_name) {
                            let fn_def_opt: Option<Box<FnDef>> = head.fn_def
                            match fn_def_opt {
                                Some(fd) => {
                                    lo = lo.preseed_fn_signature_ref(name, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => {
                                lo = lo.preseed_impl_method_summaries_ref(name, &(*id).methods, skip_name)
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn preseed_program_function_summaries(self, items: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_program_function_summaries_ref(&items, skip_name)
    }

    fn lower_program_bodies_ref(self, items: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if kind == ItemKind::ItemFn {
                        if lower_body_diag_enabled() {
                            lower_body_trace_append("body_list_fn name=" + str_from_bytes(name.buf, name.len))
                        }
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => { lo = lo.lower_impl_methods_ref(name, &(*id).methods) }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_bodies(self, items: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_bodies_ref(&items)
    }

    fn preseed_fn_signature_ref(
        self,
        name: Name,
        params: &Option<Box<ParamList>>,
        return_type: &Option<Box<TypeExpr>>,
        effects: &Option<Box<EffectList>>
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let pair = self.find_or_add_fn_id(name)
        var lo = pair.0
        let fn_id = pair.1
        if fn_id < 0 {
            return lo.report_error()
        }
        if lo.probe_mode && lower_summary_diag_enabled() {
            print("lower_probe: preseed_fn begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        let strategy = lo.ir_compute_strategy_from_ast_ref(return_type, effects)
        var func = (*lo.module).functions[fn_id as usize]
        func.name = name
        func.compile_strategy = strategy
        func.returns_float = lower_opt_return_float_code(return_type)
        func.return_struct_name = lower_opt_type_named_name(return_type)
        func.param_count = ir_param_list_count_ref(params)
        func.param_regs = [IR_INVALID_REG; 64]
        func.instr_count = 0
        func.reg_count = 0
        func.label_count = 0
        if strategy == IR_STRATEGY_INSTRUMENTED {
            func.param_count = func.param_count + 1
            if func.prof_counter_id < 0 {
                let ctr_idx = (*lo.module).prof_counter_count
                if ctr_idx < 64 {
                    (*lo.module).prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: name,
                        counter_id: ctr_idx,
                    }
                    (*lo.module).prof_counter_count = ctr_idx + 1
                    func.prof_counter_id = ctr_idx
                } else {
                    return lo.report_error()
                }
            }
        }
        (*lo.module).functions[fn_id as usize] = func
        if lo.probe_mode && lower_summary_diag_enabled() {
            print("lower_probe: preseed_fn done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(func.param_count)
            print(" strategy=")
            print_int(func.compile_strategy)
            print("\n")
        }
        lo
    }

    fn preseed_fn_signature(
        self,
        name: Name,
        params: Option<Box<ParamList>>,
        return_type: Option<Box<TypeExpr>>,
        effects: Option<Box<EffectList>>
    ) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_fn_signature_ref(name, &params, &return_type, &effects)
    }

    fn preseed_fn_item_summary(self, name: Name, opt: Option<Box<FnDef>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => self.preseed_fn_signature(name, (*fd).params, (*fd).return_type, (*fd).effects),
            _ => self,
        }
    }

    fn preseed_impl_method_summaries_ref(self, type_name: Name, methods: &Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
        match *current {
            Some(list) => {
                let head = &(*list).head
                if head.kind == ItemKind::ItemFn {
                    let mangled = ir_mangle_method_name(type_name, head.name)
                    if !ir_name_eq(mangled, skip_name) {
                        let fn_def_opt: Option<Box<FnDef>> = head.fn_def
                        match fn_def_opt {
                            Some(fd) => {
                                lo = lo.preseed_fn_signature_ref(mangled, &(*fd).params, &(*fd).return_type, &(*fd).effects)
                            }
                            _ => {}
                        }
                    }
                }
                current = &(*list).tail
            }
            _ => break
            }
        }
        lo
    }

    fn preseed_impl_method_summaries(self, type_name: Name, methods: Option<Box<ItemList>>, skip_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.preseed_impl_method_summaries_ref(type_name, &methods, skip_name)
    }

    fn lower_program_items_filtered_ref(self, items: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = items
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    let kind = head.kind
                    let name = head.name
                    if kind == ItemKind::ItemFn {
                        if ir_name_eq(name, target_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                            }
                            _ => {}
                        }
                        }
                    } else if kind == ItemKind::ItemStruct {
                        let struct_def_opt: Option<Box<StructDef>> = head.struct_def
                        match struct_def_opt {
                            Some(sd) => { lo = lo.register_struct_fields_ref(name, &(*sd).fields, 0) }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemEnum {
                        let enum_def_opt: Option<Box<EnumDef>> = head.enum_def
                        match enum_def_opt {
                            Some(ed) => { lowerer_register_enum_variants_mut(&! lo, name, &(*ed).variants, 0) }
                            _ => {}
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = head.impl_def
                        match impl_def_opt {
                            Some(id) => { lo = lo.lower_impl_methods_filtered_ref(name, &(*id).methods, target_name) }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_items_filtered(self, items: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_items_filtered_ref(&items, target_name)
    }

    fn lower_program_bodies_filtered_ref(self, items: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current: Option<Box<ItemList> > = *items
        while true {
            match current {
                Some(list) => {
                    let kind = (*list).head.kind
                    let name = (*list).head.name
                    if kind == ItemKind::ItemFn {
                        if ir_name_eq(name, target_name) {
                            if lower_body_diag_enabled() {
                                lower_body_trace_append("body_filtered_fn name=" + str_from_bytes(name.buf, name.len))
                            }
                            match (*list).head.fn_def {
                                Some(fd) => {
                                    lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                                }
                                _ => {}
                            }
                        }
                    } else if kind == ItemKind::ItemImpl {
                        let impl_def_opt: Option<Box<ImplDef>> = (*list).head.impl_def
                        match impl_def_opt {
                            Some(id) => { lo = lo.lower_impl_methods_filtered_ref(name, &(*id).methods, target_name) }
                            _ => {}
                        }
                    }
                    current = (*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_program_bodies_filtered(self, items: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_program_bodies_filtered_ref(&items, target_name)
    }

    fn lower_item(self, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            self.lower_fn_item(name, item.fn_def)
        } else if k == ItemKind::ItemStruct {
            // Phase 3.2: Register struct field layout
            match item.struct_def {
                Some(sd) => self.register_struct_fields(name, (*sd).fields, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemEnum {
            // Phase 3.1: Register enum variant discriminants
            match item.enum_def {
                Some(ed) => self.register_enum_variants(name, (*ed).variants, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemImpl {
            // Phase 3.3: Lower impl methods as free functions
            match item.impl_def {
                Some(id) => self.lower_impl_methods(name, (*id).methods),
                _ => self,
            }
        } else if k == ItemKind::ItemTypeAlias {
            self
        } else {
            self
        }
    }

    fn lower_item_body(self, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            self.lower_fn_item(name, item.fn_def)
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods(name, (*id).methods),
                _ => self,
            }
        } else {
            self
        }
    }

    fn lower_item_filtered(self, item: Item, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            if ir_name_eq(name, target_name) {
                self.lower_fn_item(name, item.fn_def)
            } else {
                self
            }
        } else if k == ItemKind::ItemStruct {
            match item.struct_def {
                Some(sd) => self.register_struct_fields(name, (*sd).fields, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemEnum {
            match item.enum_def {
                Some(ed) => self.register_enum_variants(name, (*ed).variants, 0),
                _ => self,
            }
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods_filtered(name, (*id).methods, target_name),
                _ => self,
            }
        } else if k == ItemKind::ItemTypeAlias {
            self
        } else {
            self
        }
    }

    fn lower_item_body_filtered(self, item: Item, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let k = item.kind
        let name = item.name
        if k == ItemKind::ItemFn {
            if ir_name_eq(name, target_name) {
                self.lower_fn_item(name, item.fn_def)
            } else {
                self
            }
        } else if k == ItemKind::ItemImpl {
            match item.impl_def {
                Some(id) => self.lower_impl_methods_filtered(name, (*id).methods, target_name),
                _ => self,
            }
        } else {
            self
        }
    }

    // Phase 3.3: Lower impl block methods as mangled free functions
    // e.g., `impl Checker { fn check_expr(self, e: Expr) -> ... }`
    //     becomes `Checker_check_expr(self: Checker, e: Expr) -> ...`
    fn lower_impl_methods_ref(self, type_name: Name, methods: &Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    if head.kind == ItemKind::ItemFn {
                        // Mangle name: TypeName_method_name
                        let mangled = ir_mangle_method_name(type_name, head.name)
                        let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                        match *fn_def_opt_ref {
                            Some(fd) => {
                                lowerer_lower_fn_item_mut(&! lo, mangled, &(*fd))
                            }
                            _ => {}
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_impl_methods(self, type_name: Name, methods: Option<Box<ItemList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_impl_methods_ref(type_name, &methods)
    }

    fn lower_impl_methods_filtered_ref(self, type_name: Name, methods: &Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = methods
        while true {
            match *current {
                Some(list) => {
                    let head = &(*list).head
                    if head.kind == ItemKind::ItemFn {
                        let mangled = ir_mangle_method_name(type_name, head.name)
                        if ir_name_eq(mangled, target_name) {
                            let fn_def_opt_ref: &Option<Box<FnDef>> = &head.fn_def
                            match *fn_def_opt_ref {
                                Some(fd) => {
                                    lowerer_lower_fn_item_mut(&! lo, mangled, &(*fd))
                                }
                                _ => {}
                            }
                        }
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_impl_methods_filtered(self, type_name: Name, methods: Option<Box<ItemList>>, target_name: Name) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_impl_methods_filtered_ref(type_name, &methods, target_name)
    }

    // Sprint 42: Inject hidden __validated: i64 as param_regs[0] for instrumented
    // functions.  The validated flag is the first formal in the native ABI, consumed
    // by ir_opt_apply_strategy()'s dispatch block (IrBranchTrue on param_regs[0]).
    // Must be called after compile_strategy is set, before lower_fn_params().
    // Mirrors hlir_opt_apply_strategy()'s validated_param injection (hlir/opt_strategy.sio).
    fn ir_lower_inject_validated_param(self, fn_id: i64) -> Lowerer with Mut, Panic, Div, IO {
        let pair = self.fresh_reg()
        var lo = pair.0
        let validated_vreg = pair.1
        // Shift existing params up by 1 to make room at position 0 for __validated
        var j: i64 = (*lo.current_func).param_count
        while j > 0 {
            (*lo.current_func).param_regs[j as usize] = (*lo.current_func).param_regs[(j - 1) as usize]
            j = j - 1
        }
        (*lo.current_func).param_regs[0] = validated_vreg
        (*lo.current_func).param_count = (*lo.current_func).param_count + 1
        lo
    }

    fn lower_fn_params_ref(self, params: &Option<Box<ParamList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = params
        var current_func = *lo.current_func
        var locals = *lo.locals
        while true {
            match *current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: ref_param_loop name=")
                        print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                        print("\n")
                    }
                    if lo.current_fn < 0 {
                        lo = lo.report_error()
                        current = &(*list).tail
                        continue
                    }
                    let preg = current_func.reg_count
                    current_func.reg_count = preg + 1

                    if current_func.param_count < IR_MAX_PARAMS {
                        let param_count = current_func.param_count
                        current_func.param_regs[param_count as usize] = preg
                        current_func.param_count = param_count + 1
                        if lower_live_diag_enabled() {
                            print("lower_live: ref_param_count_now=")
                            print_int(current_func.param_count)
                            print("\n")
                        }
                    } else {
                        lo = lo.report_error()
                    }

                    if lower_type_expr_is_f64(&(*list).head.ty) {
                        let instr_count = current_func.instr_count
                        if instr_count < IR_MAX_INSTRS {
                            current_func.instrs[instr_count as usize] = ir_mark_float_reg(preg)
                            current_func.instr_count = instr_count + 1
                        } else {
                            lo = lo.report_error()
                        }
                    }

                    let _is_mut = (*list).head.is_self_mut
                    if locals.count < 4096 {
                        let idx = locals.count
                        locals.names[idx as usize] = (*list).head.name
                        locals.regs[idx as usize] = preg
                        locals.depths[idx as usize] = lo.scope_depth
                        locals.struct_types[idx as usize] = lower_param_struct_type_name(&(*list).head.ty)
                        locals.array_elem_float[idx as usize] = if lower_type_expr_is_array_of_f64(&(*list).head.ty) { 1 } else { 0 }
                        locals.wide_bits[idx as usize] = 0
                        locals.wide_signed[idx as usize] = 0
                        locals.is_ref[idx as usize] = if lower_type_expr_is_ref_like(&(*list).head.ty) { 1 } else { 0 }
                        locals.scalar_kind[idx as usize] = if lower_type_expr_is_f64(&(*list).head.ty) { 2 } else { 0 }
                        locals.count = idx + 1
                    } else {
                        lo = lo.report_error()
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo.current_func = Box::new(current_func)
        lo.locals = Box::new(locals)
        lo
    }

    fn lower_fn_params(self, params: Option<Box<ParamList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_fn_params_ref(&params)
    }

    // ================================================================
    // Compile strategy computation — Sprint 38
    //
    // Determines the compile strategy for a function based on its
    // AST return type and effect signature.  Mirrors the logic in
    // hlir_compute_strategy (hlir/lower.sio) but operates on the
    // AST directly so the native backend path can consume it.
    // ================================================================

    fn ir_effect_list_has_name_ref(self, effects: &Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
        var current = effects
        while true {
            match *current {
                Some(effect_node) => {
                    let eff = &(*effect_node).head
                    var matches = true
                    let tlen = str_len(target)
                    if eff.name_len != tlen {
                        matches = false
                    } else {
                        var k: i64 = 0
                        while k < tlen {
                            if eff.name_buf[k as usize] != (str_char_at(target, k) as i8) {
                                matches = false
                            }
                            k = k + 1
                        }
                    }
                    if matches {
                        return true
                    }
                    current = &(*effect_node).tail
                }
                None => return false
            }
        }
        false
    }

    fn ir_effect_list_has_name(self, effects: Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
        self.ir_effect_list_has_name_ref(&effects, target)
    }

    fn ir_compute_strategy_from_ast_ref(
        self,
        return_type: &Option<Box<TypeExpr>>,
        effects: &Option<Box<EffectList>>
    ) -> i64 with Mut, Panic, Div {
        if self.ir_effect_list_has_name_ref(effects, "GPU") {
            return IR_STRATEGY_GPU_KERNEL
        }
        if self.ir_effect_list_has_name_ref(effects, "Prob") {
            return IR_STRATEGY_PROBABILISTIC
        }

        match *return_type {
            Some(type_node) => {
                let rk = (*type_node).kind
                if rk == TypeExprKind::TypeValidated {
                    IR_STRATEGY_AGGRESSIVE
                } else if rk == TypeExprKind::TypeKnowledge {
                    IR_STRATEGY_PRECISION_PRESERVING
                } else if rk == TypeExprKind::TypeContest || rk == TypeExprKind::TypeRobust {
                    IR_STRATEGY_INSTRUMENTED
                } else {
                    IR_STRATEGY_STANDARD
                }
            }
            None => IR_STRATEGY_STANDARD,
        }
    }

    fn ir_compute_strategy_from_ast(
        self,
        return_type: Option<Box<TypeExpr>>,
        effects: Option<Box<EffectList>>
    ) -> i64 with Mut, Panic, Div {
        self.ir_compute_strategy_from_ast_ref(&return_type, &effects)
    }

    fn ir_lower_prepend_validated_arg(
        self,
        fn_id: i64,
        args: Option<Box<IrRegList>>,
        argc: i64
    ) -> IrPreparedCallArgs with Mut, Panic, Div, Alloc, IO {
        let callee_strategy: i64 = if fn_id >= 0 && fn_id < self.module.fn_count {
            self.module.functions[fn_id as usize].compile_strategy
        } else {
            IR_STRATEGY_STANDARD
        }
        var final_args = args
        var final_argc = argc
        var lo = self
        if callee_strategy == IR_STRATEGY_INSTRUMENTED {
            let caller_strategy: i64 = lo.current_fn_compile_strategy()
            if caller_strategy == IR_STRATEGY_INSTRUMENTED {
                let caller_validated_vreg: i64 = lo.current_fn_validated_reg()
                final_args = lo.prepend_arg(caller_validated_vreg, final_args)
            } else {
                let pair_v = lo.fresh_reg()
                lo = pair_v.0
                let validated_vreg = pair_v.1
                lo = lo.emit(ir_load_imm(validated_vreg, 1))
                final_args = lo.prepend_arg(validated_vreg, final_args)
            }
            final_argc = final_argc + 1
        }
        IrPreparedCallArgs { lo: lo, args: final_args, argc: final_argc }
    }

    fn lower_fn_item_owned(self, name: Name, fd: FnDef) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        if lower_live_diag_enabled() {
            print("lower_live: fn_before_find_or_add name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        let pair = self.find_or_add_fn_id(name)
        var lo = pair.0
        let fn_id = pair.1
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_find_or_add name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }
        if fn_id < 0 {
            return lo.report_error()
        }
        if lower_live_diag_enabled() {
            print("lower_live: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_begin name=" + str_from_bytes(name.buf, name.len) + " fn_id=" + io_trace_i64_string(fn_id))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        lo = lo.flush_current_func()
        lo.current_fn = fn_id
        var current_func = ir_empty_function()
        current_func.name = name
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            let preserved = lo.module.functions[fn_id as usize]
            current_func.name = preserved.name
            current_func.compile_strategy = preserved.compile_strategy
            current_func.returns_float = preserved.returns_float
            current_func.return_struct_name = preserved.return_struct_name
            current_func.prof_counter_id = preserved.prof_counter_id
        }
        lo.current_func = Box::new(current_func)
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals2 = *lo.locals
        rst_locals2.count = 0
        lo.locals = Box::new(rst_locals2)
        lo.scope_depth = 0
        lo.loop_depth = 0
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_begin name=" + str_from_bytes(name.buf, name.len))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }

        // Sprint 38: Compute compile strategy from AST return type + effects
        let strategy = lo.ir_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_strategy name=")
            print(str_from_bytes(name.buf, name.len))
            print(" strategy=")
            print_int(strategy)
            print("\n")
        }
        // Sprint 108/109: preserve extern/exported strategy set during preseed
        let preseed_strategy = (*lo.current_func).compile_strategy
        if preseed_strategy == 6 || preseed_strategy == 7 {
            (*lo.current_func).compile_strategy = preseed_strategy
        } else {
            (*lo.current_func).compile_strategy = strategy
        }
        (*lo.current_func).returns_float = lower_opt_return_float_code(&fd.return_type)
        (*lo.current_func).return_struct_name = lower_opt_type_named_name(&fd.return_type)

        // Sprint 44: allocate profiling counter for instrumented functions
        if strategy == IR_STRATEGY_INSTRUMENTED {
            if (*lo.current_func).prof_counter_id < 0 {
                var module = *lo.module
                let ctr_idx = module.prof_counter_count
                if ctr_idx < 64 {
                    module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: (*lo.current_func).name,
                        counter_id: ctr_idx,
                    }
                    module.prof_counter_count = ctr_idx + 1
                    (*lo.current_func).prof_counter_id = ctr_idx
                    lo.module = Box::new(module)
                }
            }
        }

        // Sprint 42: inject __validated hidden param before user params for instrumented fns
        if strategy == IR_STRATEGY_INSTRUMENTED {
            lo = lo.ir_lower_inject_validated_param(fn_id)
        }

        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print("\n")
        }
        lo.scope_depth = lo.scope_depth + 1
        if ir_param_list_count_ref(&fd.params) > 0 {
            lo = lo.lower_fn_params_ref(&fd.params)
        }
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_params name=" + str_from_bytes(name.buf, name.len) + " param_count=" + io_trace_i64_string(lo.current_func.param_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_ok fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
            print("lower_probe: block_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        let bpair = lo.lower_block(fd.body)
        lo = bpair.0
        let result_reg = bpair.1
        if lower_live_diag_enabled() {
            print("lower_live: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print(" instrs_current=")
            print_int(lo.current_func.instr_count)
            print(" regs_current=")
            print_int(lo.current_func.reg_count)
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_block name=" + str_from_bytes(name.buf, name.len) + " result_reg=" + io_trace_i64_string(result_reg))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print("\n")
        }

        if !lo.fn_ends_with_return() {
            lo = lo.emit(ir_return(result_reg))
        }

        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo = lo.flush_current_func()
        lo.current_fn = IR_INVALID_FN
        if lower_live_diag_enabled() {
            print("lower_live: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_done name=" + str_from_bytes(name.buf, name.len) + " instrs=" + io_trace_i64_string(lo.module.functions[fn_id as usize].instr_count) + " regs=" + io_trace_i64_string(lo.module.functions[fn_id as usize].reg_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" instrs=")
            print_int(lo.module.functions[fn_id as usize].instr_count)
            print(" regs=")
            print_int(lo.module.functions[fn_id as usize].reg_count)
            print("\n")
        }
        lo
    }

    fn lower_fn_item_ref(self, name: Name, fd: &FnDef) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo, name)
        if fn_id < 0 {
            return lo.report_error()
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_begin name=" + str_from_bytes(name.buf, name.len) + " fn_id=" + io_trace_i64_string(fn_id))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print(" fn_id=")
            print_int(fn_id)
            print("\n")
        }

        lo = lo.flush_current_func()
        lo.current_fn = fn_id
        var current_func = ir_empty_function()
        current_func.name = name
        if fn_id >= 0 && fn_id < lo.module.fn_count {
            let preserved = lo.module.functions[fn_id as usize]
            current_func.name = preserved.name
            current_func.compile_strategy = preserved.compile_strategy
            current_func.returns_float = preserved.returns_float
            current_func.return_struct_name = preserved.return_struct_name
            current_func.prof_counter_id = preserved.prof_counter_id
        }
        lo.current_func = Box::new(current_func)
        lo.current_func_loaded = true
        lo.env = None
        var rst_locals3 = *lo.locals
        rst_locals3.count = 0
        lo.locals = Box::new(rst_locals3)
        lo.scope_depth = 0
        lo.loop_depth = 0
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_begin name=" + str_from_bytes(name.buf, name.len))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_begin name=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }

        let strategy = lo.ir_compute_strategy_from_ast_ref(&fd.return_type, &fd.effects)
        // Sprint 108/109: preserve extern/exported strategy set during preseed
        let preseed_strategy_o = (*lo.current_func).compile_strategy
        if preseed_strategy_o == 6 || preseed_strategy_o == 7 {
            (*lo.current_func).compile_strategy = preseed_strategy_o
        } else {
            (*lo.current_func).compile_strategy = strategy
        }
        (*lo.current_func).returns_float = lower_opt_return_float_code(&fd.return_type)
        (*lo.current_func).return_struct_name = lower_opt_type_named_name(&fd.return_type)

        if strategy == IR_STRATEGY_INSTRUMENTED {
            if (*lo.current_func).prof_counter_id < 0 {
                var module = *lo.module
                let ctr_idx = module.prof_counter_count
                if ctr_idx < 64 {
                    module.prof_counters[ctr_idx as usize] = IrProfCounterInfo {
                        fn_id: fn_id,
                        fn_name: (*lo.current_func).name,
                        counter_id: ctr_idx,
                    }
                    module.prof_counter_count = ctr_idx + 1
                    (*lo.current_func).prof_counter_id = ctr_idx
                    lo.module = Box::new(module)
                }
            }
        }

        if strategy == IR_STRATEGY_INSTRUMENTED {
            lo = lo.ir_lower_inject_validated_param(fn_id)
        }

        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print("\n")
        }
        lo.scope_depth = lo.scope_depth + 1
        if ir_param_list_count_ref(&fd.params) > 0 {
            lo = lo.lower_fn_params_ref(&fd.params)
        }
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_params name=" + str_from_bytes(name.buf, name.len) + " param_count=" + io_trace_i64_string(lo.current_func.param_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_params name=")
            print(str_from_bytes(name.buf, name.len))
            print(" ast_param_count=")
            print_int(ir_param_list_count_ref(&fd.params))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
        }
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: params_ok fn=")
            print(str_from_bytes(name.buf, name.len))
            print(" param_count=")
            print_int(lo.current_func.param_count)
            print("\n")
            print("lower_probe: block_begin fn=")
            print(str_from_bytes(name.buf, name.len))
            print("\n")
        }
        lo = lo.preload_bss_globals_as_locals()
        let bpair = lo.lower_block_ref(&fd.body)
        lo = bpair.0
        let result_reg = bpair.1
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_after_block name=" + str_from_bytes(name.buf, name.len) + " result_reg=" + io_trace_i64_string(result_reg))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_after_block name=")
            print(str_from_bytes(name.buf, name.len))
            print(" result_reg=")
            print_int(result_reg)
            print("\n")
        }

        if !lo.fn_ends_with_return() {
            lo = lo.emit(ir_return(result_reg))
        }

        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo = lo.flush_current_func()
        lo.current_fn = IR_INVALID_FN
        if lower_body_diag_enabled() {
            lower_body_trace_append("fn_done name=" + str_from_bytes(name.buf, name.len) + " instrs=" + io_trace_i64_string(lo.module.functions[fn_id as usize].instr_count) + " regs=" + io_trace_i64_string(lo.module.functions[fn_id as usize].reg_count))
        }
        if lower_ordered_diag_enabled() {
            print("lower_ordered: fn_done name=")
            print(str_from_bytes(name.buf, name.len))
            print(" instrs=")
            print_int(lo.module.functions[fn_id as usize].instr_count)
            print(" regs=")
            print_int(lo.module.functions[fn_id as usize].reg_count)
            print("\n")
        }
        lo
    }

    fn lower_fn_item(self, name: Name, opt: Option<Box<FnDef>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        match opt {
            Some(fd) => {
                lowerer_lower_fn_item_mut(&! lo, name, &(*fd))
                lo
            },
            _ => lo,
        }
    }

    fn lower_block_ref(self, blk: &Block) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_live_diag_enabled() { print("lower_live: block_begin\n") }
        lo.scope_depth = lo.scope_depth + 1
        let saved_local_count = lo.locals.count
        var current = &blk.stmts
        var reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match *current {
                Some(list) => {
                    let stmt_ref = &(*list).head
                    let pair = if stmt_ref.kind == StmtKind::StmtLet {
                        lo.lower_let_stmt_ref(stmt_ref, false)
                    } else if stmt_ref.kind == StmtKind::StmtVar {
                        lo.lower_let_stmt_ref(stmt_ref, true)
                    } else if stmt_ref.kind == StmtKind::StmtExpr {
                        let expr_opt_ref = &stmt_ref.expr
                        match *expr_opt_ref {
                            Some(expr_box) => {
                                lo.lower_expr_ref(&(*expr_box))
                            }
                            _ => {
                                lo.emit_unit()
                            }
                        }
                    } else {
                        lo.lower_assign_stmt_ref(stmt_ref)
                    }
                    lo = pair.0
                    reg = pair.1
                    saw_stmt = true
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if !saw_stmt {
            let unit_pair = lo.emit_unit()
            lo = unit_pair.0
            reg = unit_pair.1
        }
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        lo.locals.count = saved_local_count
        if lower_live_diag_enabled() {
            print("lower_live: block_end reg=")
            print_int(reg)
            print("\n")
        }
        (lo, reg)
    }

    fn lower_block(self, blk: Block) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        if lower_live_diag_enabled() { print("lower_live: block_begin\n") }
        lo.scope_depth = lo.scope_depth + 1
        let pair = lo.lower_stmt_list(blk.stmts)
        lo = pair.0
        let reg = pair.1
        if lo.scope_depth > 0 {
            lo.scope_depth = lo.scope_depth - 1
        }
        if lower_live_diag_enabled() {
            print("lower_live: block_end reg=")
            print_int(reg)
            print("\n")
        }
        (lo, reg)
    }

    fn lower_stmt_list_ref(self, stmts: &Option<Box<StmtList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = stmts
        var last_reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match *current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    let pair = lo.lower_stmt_ref(&(*list).head)
                    lo = pair.0
                    last_reg = pair.1
                    saw_stmt = true
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if saw_stmt {
            (lo, last_reg)
        } else {
            lo.emit_unit()
        }
    }

    fn lower_stmt_list(self, stmts: Option<Box<StmtList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = stmts
        var last_reg = IR_INVALID_REG
        var saw_stmt = false
        while true {
            match current {
                Some(list) => {
                    if lower_live_diag_enabled() {
                        print("lower_live: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: stmt_kind=")
                        if (*list).head.kind == StmtKind::StmtLet { print("let") }
                        else if (*list).head.kind == StmtKind::StmtVar { print("var") }
                        else if (*list).head.kind == StmtKind::StmtExpr { print("expr") }
                        else if (*list).head.kind == StmtKind::StmtAssign { print("assign") }
                        else { print("other") }
                        print("\n")
                    }
                    let pair = lo.lower_stmt_ref(&(*list).head)
                    lo = pair.0
                    last_reg = pair.1
                    saw_stmt = true
                    current = (*list).tail
                }
                _ => break
            }
        }
        if saw_stmt {
            (lo, last_reg)
        } else {
            lo.emit_unit()
        }
    }

    fn lower_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if s.kind == StmtKind::StmtLet {
            self.lower_let_stmt_ref(s, false)
        } else if s.kind == StmtKind::StmtVar {
            self.lower_let_stmt_ref(s, true)
        } else if s.kind == StmtKind::StmtExpr {
            self.lower_expr_stmt_ref(s)
        } else {
            self.lower_assign_stmt_ref(s)
        }
    }

    fn lower_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_stmt_ref(&s)
    }

    // True iff `e` is a call to a function whose declared return type is an f64 array
    // (returns_float == 2, set by lower_opt_return_float_code). Used so `let r = mk()`
    // flags `r` as a float-element local — otherwise `r[i]` reads classify as integer
    // and get cvtsi2sd-corrupted in arithmetic/comparisons.
    fn expr_result_is_f64_array_ref(self, e: &Expr) -> bool with Mut, Panic, Div, Alloc {
        if (*e).kind != ExprKind::ExprCall {
            return false
        }
        match (*e).left {
            Some(callee_expr) => {
                let callee_name = self.expr_to_callee_name_ref(&(*callee_expr))
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, callee_name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    return self.module.functions[fn_id as usize].returns_float == 2
                }
            }
            _ => {}
        }
        false
    }

    fn lower_let_stmt_ref(self, s: &Stmt, is_mut: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lhs_lo = self
        match s.expr {
            Some(expr_box_closure) => {
                if (*expr_box_closure).kind == ExprKind::ExprClosure {
                    lhs_lo.allow_direct_capturing_closure_literal = true
                }
            }
            _ => {}
        }
        let pair = lhs_lo.lower_opt_expr_ref(&s.expr)
        var lo = pair.0
        lo.allow_direct_capturing_closure_literal = false
        let reg = pair.1
        // A `var` initialized from a bare identifier must own its storage. An ident
        // lowers to the SOURCE local's register (lookup_local returns it directly), so
        // binding the var to `reg` aliases them onto the same vreg/stack slot — a later
        // `y = ...` then clobbers the source `x`, and reads of `x` return y's value.
        // This corrupted `var y = x; ... y = f(y, x)` patterns (e.g. Newton's method
        // `y = 0.5*(y + x/y)`, which drifted to sqrt(garbage) once x was overwritten).
        // Computed initializers already yield a fresh dst reg, so only the bare-ident
        // case needs an explicit copy into a fresh register.
        var bind_reg = reg
        if is_mut {
            match s.expr {
                Some(rhs_ident) => {
                    if (*rhs_ident).kind == ExprKind::ExprIdent {
                        let copy_pair = lo.fresh_reg()
                        lo = copy_pair.0
                        let copy_reg = copy_pair.1
                        lo = lo.emit(ir_copy(copy_reg, reg))
                        bind_reg = copy_reg
                    }
                }
                _ => {}
            }
        }
        lo = lo.bind_local(s.name, bind_reg, is_mut)
        // Closures step 2: if the RHS was a capturing closure, mark this local so a later
        // `name(args)` call injects the captured regs (direct call to the synthetic fn).
        if lo.pending_closure_fn_id >= 0 {
            lo = lo.bind_local_closure_fn_id(s.name, lo.pending_closure_fn_id)
            lo.pending_closure_fn_id = -1
        }
        if lo.pending_variance_reg >= 0 {
            lo = lo.bind_local_variance_reg(s.name, lo.pending_variance_reg)
            lo.pending_variance_reg = -1
        }
        if lower_opt_type_is_array_of_f64(&s.ty) {
            lo = lo.bind_local_array_elem_float(s.name)
        } else {
            match s.expr {
                Some(expr_box_arr) => {
                    if lower_expr_is_f64_array_literal_ref(&(*expr_box_arr)) {
                        lo = lo.bind_local_array_elem_float(s.name)
                    } else if lo.expr_result_is_f64_array_ref(&(*expr_box_arr)) {
                        lo = lo.bind_local_array_elem_float(s.name)
                    }
                }
                _ => {}
            }
        }
        if lower_opt_type_is_f64(&s.ty) {
            lo = lo.bind_local_scalar_kind(s.name, 2)
        } else {
            match s.expr {
                Some(expr_box_sk) => {
                    if (*expr_box_sk).kind == ExprKind::ExprIntLit {
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if (*expr_box_sk).kind == ExprKind::ExprBoolLit {
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    } else if lo.expr_result_is_float_ref(&(*expr_box_sk)) {
                        lo = lo.bind_local_scalar_kind(s.name, 2)
                    } else if lo.expr_result_is_string_ref(&(*expr_box_sk)) {
                        // Track string locals (kind 3) so `s + t` / `s ++ t` route to str_concat.
                        lo = lo.bind_local_scalar_kind(s.name, 3)
                    } else if ((*expr_box_sk).kind == ExprKind::ExprCall || (*expr_box_sk).kind == ExprKind::ExprMethodCall) && lo.expr_result_scalar_kind_ref(&(*expr_box_sk)) == 1 {
                        // `let r = f(..)` / `let r = x.m(..)` whose callee POSITIVELY
                        // returns i64 (return_struct_name == "i64"). Without this the
                        // local stayed kind 0 and `println(r)` routed the i64 through the
                        // char* printer, dereferencing the integer as a pointer -> SIGSEGV
                        // (e.g. `let r = use2::<i64>(2,3); println(r)` — primitive-receiver
                        // trait dispatch result). Restricted to Call/MethodCall so an
                        // indexed struct element cannot be misclassified as int.
                        lo = lo.bind_local_scalar_kind(s.name, 1)
                    }
                }
                _ => {}
            }
        }
        match s.expr {
            Some(expr_box_var) => {
                if lo.lookup_local_variance_reg(s.name) >= 0 {
                    if lo.expr_result_is_float_ref(&(*expr_box_var)) {
                        lo = lo.bind_local_scalar_kind(s.name, 2)
                    }
                } else {
                    let var_pair = lo.lower_expr_variance_ref(&(*expr_box_var))
                    lo = var_pair.0
                    if var_pair.1 >= 0 {
                        lo = lo.bind_local_variance_reg(s.name, var_pair.1)
                        // Do NOT force scalar_kind=2 (float) here. A variance reg is
                        // produced for every tracked value, including INT locals
                        // (variance 0); the value's scalar_kind was already set
                        // authoritatively above (int/bool->1, float->2, string->3).
                        // Clobbering it to float made `int_local + literal` (and the
                        // for_sum loop accumulator `var s=3; s=s+5`) lower as a float
                        // add, yielding 0 instead of 8 (#478). Re-assert float only
                        // when the value is genuinely float, mirroring the if-branch.
                        if lo.expr_result_is_float_ref(&(*expr_box_var)) {
                            lo = lo.bind_local_scalar_kind(s.name, 2)
                        }
                    }
                }
            }
            _ => {}
        }
        let annotated_wide_bits = lower_opt_type_wide_bits(&s.ty)
        if annotated_wide_bits > 64 {
            lo = lo.bind_local_wide_type(s.name, annotated_wide_bits, lower_opt_type_wide_signed(&s.ty))
        } else {
            match s.expr {
                Some(expr_box_wide) => {
                    let expr_wide_bits = lo.expr_wide_bits_ref(&(*expr_box_wide))
                    if expr_wide_bits > 64 {
                        lo = lo.bind_local_wide_type(s.name, expr_wide_bits, lo.expr_wide_signed_ref(&(*expr_box_wide)))
                    }
                }
                _ => {}
            }
        }
        match s.expr {
            Some(expr_box) => {
                if (*expr_box).kind == ExprKind::ExprStructLit {
                    lo = lo.bind_local_struct_type(s.name, ir_path_first_name((*expr_box).path))
                } else if (*expr_box).kind == ExprKind::ExprCall {
                    let callee_opt_struct_ref = &(*expr_box).left
                    let callee_struct_name = match *callee_opt_struct_ref {
                        Some(c) => lo.expr_to_callee_name_ref(&(*c)),
                        None => ir_empty_name(),
                    }
                    if !ir_name_is_box(callee_struct_name) {
                        let ret_name = lo.expr_call_return_struct_name_ref(&(*expr_box))
                        if ret_name.len > 0 {
                            lo = lo.bind_local_struct_type(s.name, ret_name)
                        }
                    } else {
                        // `let b = Box::new(...)`: tag the local's struct-type slot with
                        // "Box" so `*b` lowers to a field-0 read (box deref through the
                        // handle) rather than a raw IrUnaryOp(OpDeref) pointer load.
                        lo = lo.bind_local_struct_type(s.name, callee_struct_name)
                    }
                } else if (*expr_box).kind == ExprKind::ExprIdent {
                    // `let b = nx`: propagate the source variable's struct type (e.g. a Box
                    // bound from `Some(nx)`) so `*b` / field access on b resolve correctly.
                    let src_st = lo.lookup_local_struct_type((*expr_box).name)
                    if src_st.len > 0 {
                        lo = lo.bind_local_struct_type(s.name, src_st)
                    }
                }
            }
            _ => {}
        }
        (lo, reg)
    }

    fn lower_let_stmt(self, s: Stmt, is_mut: bool) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_let_stmt_ref(&s, is_mut)
    }

    fn lower_expr_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_opt_expr_ref(&s.expr)
    }

    fn lower_expr_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_stmt_ref(&s)
    }

    fn lower_assign_stmt_ref(self, s: &Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_rhs = self.lower_opt_expr_ref(&s.expr)
        var lo = pair_rhs.0
        var rhs = pair_rhs.1
        var rhs_variance: i64 = -1
        var rhs_is_float: bool = false
        match s.expr {
            Some(rhs_expr_var) => {
                let rhs_var_pair = lo.lower_expr_variance_ref(&(*rhs_expr_var))
                lo = rhs_var_pair.0
                rhs_variance = rhs_var_pair.1
                rhs_is_float = lo.expr_result_is_float_ref(&(*rhs_expr_var))
            }
            _ => {}
        }
        let target_opt: Option<Box<Expr>> = s.target

        if s.assign_op != AssignOp::AssignEq {
            let old_pair = lo.lower_opt_expr_ref(&target_opt)
            lo = old_pair.0
            let old_val = old_pair.1
            let bin_op = if s.assign_op == AssignOp::AssignAdd {
                BinaryOp::OpAdd
            } else {
                BinaryOp::OpSub
            }
            let pair_dst = lo.fresh_reg()
            lo = pair_dst.0
            let compound_reg = pair_dst.1
            lo = lo.emit(ir_binop(compound_reg, old_val, bin_op, rhs))
            rhs = compound_reg
        }

        match target_opt {
            Some(target_expr) => {
                if (*target_expr).kind == ExprKind::ExprIdent {
                        let dst = lo.lookup_local((*target_expr).name)
                        if dst < 0 {
                            let bss_fn_id = lowerer_lookup_fn_id_by_name_ref(&lo, (*target_expr).name)
                            if bss_fn_id >= 0 && bss_fn_id < lo.module.fn_count && lo.module.functions[bss_fn_id as usize].compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                let bss_off = lo.module.functions[bss_fn_id as usize].param_count
                                lo = lo.emit(ir_store_global(rhs, bss_off, (*target_expr).name))
                                (lo, rhs)
                            } else {
                                lo = lo.report_error()
                                (lo, rhs)
                            }
                        } else {
                            if lo.lookup_local_is_global((*target_expr).name) {
                                let bss_off_local = lo.lookup_local_global_bss_offset((*target_expr).name)
                                lo = lo.emit(ir_store_global(rhs, bss_off_local, (*target_expr).name))
                            }
                            lo = lo.emit(ir_copy(dst, rhs))
                            if rhs_variance >= 0 {
                                lo = lo.bind_local_variance_reg((*target_expr).name, rhs_variance)
                                // Re-assert float scalar_kind only when the RHS is
                                // genuinely float; an int RHS that merely carries a
                                // variance reg must not flip the local to float (#478).
                                if rhs_is_float {
                                    lo = lo.bind_local_scalar_kind((*target_expr).name, 2)
                                }
                            }
                            (lo, dst)
                        }
                } else if (*target_expr).kind == ExprKind::ExprFieldAccess {
                        // Escape safety for `obj.field = &local` (and array/deref store
                        // escapes) is enforced by the checker's escape analysis (E091) at
                        // store sites, so lowering stores unconditionally here.
                        let base_opt: Option<Box<Expr>> = (*target_expr).left
                        match base_opt {
                            Some(base_expr) => {
                                let base_is_ref = if (*base_expr).kind == ExprKind::ExprIdent {
                                    lo.lookup_local_is_ref((*base_expr).name)
                                } else {
                                    false
                                }
                                let fidx = lo.field_idx_for_base_ref(&(*target_expr).left, (*target_expr).name)
                                let pair_base = lo.lower_expr_ref(&(*base_expr))
                                lo = pair_base.0
                                let base_reg = pair_base.1
                                var set_instr = ir_field_set(base_reg, fidx, rhs, (*target_expr).name)
                                if base_is_ref {
                                    set_instr.label_id = 1
                                }
                                lo = lo.emit(set_instr)
                                (lo, rhs)
                            }
                            _ => (lo.report_error(), rhs),
                        }
                } else if (*target_expr).kind == ExprKind::ExprIndex {
                        let target_global_elem_size = match (*target_expr).left {
                            Some(target_base_expr) => {
                                if (*target_base_expr).kind == ExprKind::ExprIdent {
                                    let global_fn_id = lowerer_lookup_fn_id_by_name_ref(&lo, (*target_base_expr).name)
                                    if global_fn_id >= 0 && global_fn_id < lo.module.fn_count
                                        && lo.module.functions[global_fn_id as usize].compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                        lo.module.functions[global_fn_id as usize].hyper_algebra_kind
                                    } else {
                                        0
                                    }
                                } else {
                                    0
                                }
                            }
                            _ => 0,
                        }
                        let target_base_is_ref = match (*target_expr).left {
                            Some(target_base_expr) => {
                                if (*target_base_expr).kind == ExprKind::ExprIdent {
                                    lo.lookup_local_is_ref((*target_base_expr).name)
                                } else {
                                    false
                                }
                            }
                            _ => false,
                        }
                        let pair_base = lo.lower_opt_expr_ref(&(*target_expr).left)
                        lo = pair_base.0
                        let base_reg = pair_base.1
                        let pair_idx = lo.lower_opt_expr_ref(&(*target_expr).right)
                        lo = pair_idx.0
                        let idx_reg = pair_idx.1
                        var index_set_instr = ir_index_set(base_reg, idx_reg, rhs)
                        if target_global_elem_size > 0 {
                            index_set_instr.label_id = if target_global_elem_size == 1 { 3 } else { 2 }
                        } else if target_base_is_ref {
                            index_set_instr.label_id = 1
                        }
                        lo = lo.emit(index_set_instr)
                        (lo, rhs)
                } else if (*target_expr).kind == ExprKind::ExprUnary {
                        if (*target_expr).un_op == UnaryOp::OpDeref {
                            // `*p = val`: a Box stores into field 0 (handle-resolved); a true
                            // reference stores through the raw pointer.
                            let is_box_t = match (*target_expr).left {
                                Some(op) => {
                                    if (*op).kind == ExprKind::ExprIdent {
                                        ir_name_is_box(lo.lookup_local_struct_type((*op).name))
                                    } else {
                                        false
                                    }
                                }
                                _ => false,
                            }
                            let ptr_pair = lo.lower_opt_expr_ref(&(*target_expr).left)
                            lo = ptr_pair.0
                            let ptr_reg = ptr_pair.1
                            if is_box_t {
                                lo = lo.emit(ir_field_set(ptr_reg, 0, rhs, ir_empty_name()))
                            } else {
                                lo = lo.emit(ir_store_ptr(ptr_reg, rhs))
                            }
                            (lo, rhs)
                        } else {
                            lo = lo.report_error()
                            (lo, rhs)
                        }
                } else {
                    lo = lo.report_error()
                    (lo, rhs)
                }
            }
            _ => (lo.report_error(), rhs),
        }
    }

    fn lower_assign_stmt(self, s: Stmt) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_assign_stmt_ref(&s)
    }

    fn lower_opt_expr_ref(self, opt: &Option<Box<Expr>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(e) => self.lower_expr_ref(&(*e)),
            _ => self.emit_unit(),
        }
    }

    fn lower_opt_expr(self, opt: Option<Box<Expr>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_opt_expr_ref(&opt)
    }

    fn lower_expr_args_ref(self, opt: &Option<Box<ExprList>>) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = opt
        var regs: [i64; 64] = [0; 64]
        var reg_count: i64 = 0
        while true {
            match *current {
                Some(list) => {
                    let pair_head = lo.lower_expr_ref(&(*list).head)
                    lo = pair_head.0
                    if reg_count < 64 {
                        regs[reg_count as usize] = pair_head.1
                        reg_count = reg_count + 1
                    } else {
                        break
                    }
                    current = &(*list).tail
                }
                _ => break
            }
        }
        if reg_count <= 0 {
            let empty = IrRegList { head: 0, tail: None }
            LowerExprArgsResult { lowerer: lo, regs: empty, count: 0 }
        } else {
            var idx = reg_count - 1
            var args = IrRegList { head: regs[idx as usize], tail: None }
            while idx > 0 {
                idx = idx - 1
                args = IrRegList { head: regs[idx as usize], tail: Some(Box::new(args)) }
            }
            LowerExprArgsResult { lowerer: lo, regs: args, count: reg_count }
        }
    }

    fn lower_expr_args(self, opt: Option<Box<ExprList>>) -> LowerExprArgsResult with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_args_ref(&opt)
    }

    fn first_arg_is_capturing_closure_literal_ref(self, opt: &Option<Box<ExprList>>) -> bool with Mut, Panic, Div, Alloc {
        match *opt {
            Some(list) => {
                if (*list).head.kind != ExprKind::ExprClosure { return false }
                var caps = empty_capture_list()
                caps = self.scan_captures_opt(&(*list).head.closure_body, &(*list).head.closure_params, caps)
                caps.count > 0
            }
            _ => false,
        }
    }

    fn first_arg_capturing_closure_local_fn_id_ref(self, opt: &Option<Box<ExprList>>) -> i64 with Mut, Panic, Div, Alloc {
        match *opt {
            Some(list) => {
                if (*list).head.kind != ExprKind::ExprIdent { return -1 }
                self.lookup_local_closure_fn_id((*list).head.name)
            }
            _ => -1,
        }
    }

    fn lower_function_is_transparent_hof(self, fn_id: i64) -> bool with Mut, Panic, Div, Alloc {
        if fn_id < 0 || fn_id >= (*self.module).fn_count { return false }
        let func = (*self.module).functions[fn_id as usize]
        if func.param_count < 2 { return false }
        var call_count: i64 = 0
        var call_dst: i64 = IR_INVALID_REG
        var saw_return = false
        var i: i64 = 0
        while i < func.instr_count {
            let instr = func.instrs[i as usize]
            if instr.op == IrOpcode::IrCallIndirect {
                call_count = call_count + 1
                if instr.src1 != func.param_regs[0] { return false }
                if instr.arg_count != func.param_count - 1 { return false }
                var cur = instr.call_args
                var pidx: i64 = 1
                while pidx < func.param_count {
                    match cur {
                        Some(arg_node) => {
                            if (*arg_node).head != func.param_regs[pidx as usize] { return false }
                            cur = (*arg_node).tail
                        }
                        _ => return false,
                    }
                    pidx = pidx + 1
                }
                match cur {
                    Some(_) => return false,
                    _ => {}
                }
                call_dst = instr.dst
            } else if instr.op == IrOpcode::IrReturn {
                if instr.src1 == call_dst {
                    saw_return = true
                }
            }
            i = i + 1
        }
        call_count == 1 && saw_return
    }

    fn lower_hof_captured_closure_local_call(self, closure_fn_id: i64, callee_name: Name, opt: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(list) => {
                var lo = self
                let pair_tail: LowerExprArgsResult = lo.lower_expr_args_ref(&(*list).tail)
                lo = pair_tail.lowerer
                var arglist: Option<Box<IrRegList>> = if pair_tail.count <= 0 { None } else { Some(Box::new(pair_tail.regs)) }
                var total = pair_tail.count
                let cidx = lo.find_closure_cap_idx(closure_fn_id)
                if cidx >= 0 {
                    let ccount = (*lo.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist = ir_reg_list_prepend((*lo.closure_caps).entries[cidx as usize].caps[jc as usize], arglist)
                        jc = jc - 1
                    }
                    total = total + ccount
                }

                let pair_dst = lo.fresh_reg()
                let lo_dst = pair_dst.0
                let dst = pair_dst.1
                let lo_call = lo_dst.emit(ir_call(dst, closure_fn_id, callee_name, arglist, total))
                (lo_call, dst)
            }
            _ => {
                let loe = self.report_error()
                loe.emit_unit()
            }
        }
    }

    fn lower_hof_captured_closure_literal_call(self, callee_name: Name, opt: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *opt {
            Some(list) => {
                var lo_closure = self
                lo_closure.allow_direct_capturing_closure_literal = true
                let pair_closure = lo_closure.lower_expr_ref(&(*list).head)
                var lo = pair_closure.0
                let closure_fn_id = lo.pending_closure_fn_id
                lo.pending_closure_fn_id = -1
                if closure_fn_id < 0 {
                    print("error: capturing closure HOF specialization expected a captured closure literal\n")
                    let loe = lo.report_error()
                    return (loe, pair_closure.1)
                }

                let pair_tail: LowerExprArgsResult = lo.lower_expr_args_ref(&(*list).tail)
                lo = pair_tail.lowerer
                var arglist: Option<Box<IrRegList>> = if pair_tail.count <= 0 { None } else { Some(Box::new(pair_tail.regs)) }
                var total = pair_tail.count
                let cidx = lo.find_closure_cap_idx(closure_fn_id)
                if cidx >= 0 {
                    let ccount = (*lo.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist = ir_reg_list_prepend((*lo.closure_caps).entries[cidx as usize].caps[jc as usize], arglist)
                        jc = jc - 1
                    }
                    total = total + ccount
                }

                let pair_dst = lo.fresh_reg()
                let lo_dst = pair_dst.0
                let dst = pair_dst.1
                let lo_call = lo_dst.emit(ir_call(dst, closure_fn_id, callee_name, arglist, total))
                (lo_call, dst)
            }
            _ => {
                let loe = self.report_error()
                loe.emit_unit()
            }
        }
    }

    fn prepend_arg(self, reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
        Some(Box::new(IrRegList { head: reg, tail: args }))
    }

    fn expr_list_len_ref(self, args: &Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
        var count: i64 = 0
        var current = args
        while true {
            match *current {
                Some(list) => {
                    count = count + 1
                    current = &(*list).tail
                }
                _ => break
            }
        }
        count
    }

    fn expr_list_len(self, args: Option<Box<ExprList>>) -> i64 with Alloc {
        self.expr_list_len_ref(&args)
    }

    fn ir_name_is_knowledge_kaxi_publish(self, n: Name) -> bool {
        n.len == 24 &&
        n.buf[0] == 95 as i8 &&
        n.buf[1] == 95 as i8 &&
        n.buf[2] == 107 as i8 &&
        n.buf[3] == 110 as i8 &&
        n.buf[4] == 111 as i8 &&
        n.buf[5] == 119 as i8 &&
        n.buf[6] == 108 as i8 &&
        n.buf[7] == 101 as i8 &&
        n.buf[8] == 100 as i8 &&
        n.buf[9] == 103 as i8 &&
        n.buf[10] == 101 as i8 &&
        n.buf[11] == 95 as i8 &&
        n.buf[12] == 107 as i8 &&
        n.buf[13] == 97 as i8 &&
        n.buf[14] == 120 as i8 &&
        n.buf[15] == 105 as i8 &&
        n.buf[16] == 95 as i8 &&
        n.buf[17] == 112 as i8 &&
        n.buf[18] == 117 as i8 &&
        n.buf[19] == 98 as i8 &&
        n.buf[20] == 108 as i8 &&
        n.buf[21] == 105 as i8 &&
        n.buf[22] == 115 as i8 &&
        n.buf[23] == 104 as i8
    }

    fn kaxi_sanitize_op_kind(self, raw_op: i64) -> i64 {
        if raw_op < 0 || raw_op > 15 {
            0
        } else {
            raw_op
        }
    }

    fn kaxi_extract_publish_args(self, args: Option<Box<ExprList>>) -> (Option<Box<Expr>>, i64) with Alloc {
        match args {
            Some(list) => {
                let value_expr = (*list).head
                let op_kind = match (*list).tail {
                    Some(tail1) => {
                        let op_expr = (*tail1).head
                        if op_expr.kind == ExprKind::ExprIntLit {
                            self.kaxi_sanitize_op_kind(op_expr.int_val)
                        } else {
                            0
                        }
                    }
                    _ => 0,
                }
                (Some(Box::new(value_expr)), op_kind)
            }
            _ => (None, 0),
        }
    }

    fn kaxi_pack_default_flags(self, op_kind_raw: i64) -> i64 {
        let op_kind = self.kaxi_sanitize_op_kind(op_kind_raw)
        // Native keyword contract: alpha_q8=16, success_inc=1 (except pass), failure_inc=0.
        let success_inc = if op_kind == 0 { 0 } else { 1 }
        ((16 as i64) << 24) | (success_inc << 16) | op_kind
    }

    fn lower_kaxi_publish_call(self, fn_id: i64, callee_name: Name, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let extracted = self.kaxi_extract_publish_args(args)
        let op_kind = extracted.1
        let pair_value = match extracted.0 {
            Some(value_expr) => self.lower_expr(*value_expr),
            _ => self.emit_unit(),
        }
        var lo = pair_value.0
        let value_reg = pair_value.1

        // Synthesize default epistemic payload fields for hardware_publish(value, op_kind):
        // variance=0, provenance=0 sentinel, confidence=1.0, flags=packed(op_kind).
        let pair_var = lo.fresh_reg()
        lo = pair_var.0
        let var_reg = pair_var.1
        lo = lo.emit(ir_load_imm(var_reg, 0))

        let pair_prov = lo.fresh_reg()
        lo = pair_prov.0
        let prov_reg = pair_prov.1
        lo = lo.emit(ir_load_imm(prov_reg, 0))

        let pair_conf = lo.fresh_reg()
        lo = pair_conf.0
        let conf_reg = pair_conf.1
        lo = lo.emit(ir_load_float(conf_reg, 1.0))

        let pair_flags = lo.fresh_reg()
        lo = pair_flags.0
        let flags_reg = pair_flags.1
        lo = lo.emit(ir_load_imm(flags_reg, lo.kaxi_pack_default_flags(op_kind)))

        var call_args = lo.prepend_arg(flags_reg, None)
        call_args = lo.prepend_arg(conf_reg, call_args)
        call_args = lo.prepend_arg(prov_reg, call_args)
        call_args = lo.prepend_arg(var_reg, call_args)
        call_args = lo.prepend_arg(value_reg, call_args)

        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_call(dst, fn_id, callee_name, call_args, 5))
        (lo, dst)
    }

    fn expr_to_callee_name_ref(self, e: &Expr) -> Name with Mut, Panic, Div {
        if e.kind == ExprKind::ExprIdent {
            e.name
        } else if e.kind == ExprKind::ExprPath {
            ir_path_first_name(e.path)
        } else if e.kind == ExprKind::ExprFieldAccess {
            e.name
        } else if e.kind == ExprKind::ExprMethodCall {
            e.name
        } else {
            ir_empty_name()
        }
    }

    fn expr_to_callee_name(self, e: Expr) -> Name with Mut, Panic, Div {
        self.expr_to_callee_name_ref(&e)
    }

    fn lower_struct_fields_ref(self, base_reg: i64, struct_name: Name, fields: &Option<Box<StructFieldList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = fields
        var field_idx = idx
        while true {
            match *current {
                Some(list) => {
                    if lo.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: struct_field name=")
                        print(str_from_bytes((*list).head.name.buf, (*list).head.name.len))
                        print(" idx=")
                        print_int(field_idx)
                        print("\n")
                    }
                    let named_field_idx = if (*list).head.name.len > 0 {
                        if struct_name.len > 0 {
                            lo.field_idx_from_struct_literal_name(struct_name, (*list).head.name, field_idx)
                        } else {
                            lo.field_idx_from_name_simple((*list).head.name)
                        }
                    } else {
                        field_idx
                    }
                    let pair = lo.lower_expr_ref(&(*list).head.value)
                    lo = pair.0
                    let vreg = pair.1
                    lo = lo.emit(ir_field_set(base_reg, named_field_idx, vreg, (*list).head.name))
                    current = &(*list).tail
                    field_idx = field_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    fn lower_struct_fields(self, base_reg: i64, fields: Option<Box<StructFieldList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_struct_fields_ref(base_reg, ir_empty_name(), &fields, idx)
    }

    fn lower_array_elems_ref(self, base_reg: i64, elems: &Option<Box<ExprList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = elems
        var elem_idx = idx
        while true {
            match *current {
                Some(list) => {
                    let pair_v = lo.lower_expr_ref(&(*list).head)
                    lo = pair_v.0
                    let vreg = pair_v.1
                    let pair_i = lo.fresh_reg()
                    lo = pair_i.0
                    let ireg = pair_i.1
                    lo = lo.emit(ir_load_imm(ireg, elem_idx))
                    lo = lo.emit(ir_index_set(base_reg, ireg, vreg))
                    current = &(*list).tail
                    elem_idx = elem_idx + 1
                }
                _ => break
            }
        }
        lo
    }

    fn lower_array_elems(self, base_reg: i64, elems: Option<Box<ExprList>>, idx: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_array_elems_ref(base_reg, &elems, idx)
    }

    // Lower match arms as a linear if/else chain
    fn lower_match_arms_ref(self, scrut: i64, res: i64, l_end: i64, arms: &Option<Box<MatchArmList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        var lo = self
        var current = arms
        while true {
            match *current {
                Some(list) => {
                    lo = lo.lower_match_arm_ref(scrut, res, l_end, &(*list).head)
                    current = &(*list).tail
                }
                _ => break
            }
        }
        lo
    }

    fn lower_match_arms(self, scrut: i64, res: i64, l_end: i64, arms: Option<Box<MatchArmList>>) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_match_arms_ref(scrut, res, l_end, &arms)
    }

    // Lower a single match arm: test pattern, conditionally execute body
    // If the arm has an `if <cond>` guard, evaluate it (pattern variables are already bound)
    // and fall through to l_skip (treat as a non-match) when the guard is false.
    fn lower_arm_guard(self, guard: &Option<Box<Expr> >, l_skip: i64) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        match *guard {
            Some(g) => {
                let pair = self.lower_expr_ref(&(*g))
                var lo = pair.0
                lo.emit(ir_branch_false(pair.1, l_skip))
            }
            _ => self,
        }
    }

    fn lower_match_arm_ref(self, scrut: i64, res: i64, l_end: i64, arm: &MatchArm) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        let pat = &arm.pattern
        if pat.kind == PatternKind::PatWildcard {
            // Wildcard matches the pattern unconditionally; an `if` guard can still reject it,
            // so allocate l_skip (dead when there is no guard).
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair = lo.lower_expr_ref(&arm.body)
            lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBinding {
            // Binding matches the pattern; bind the scrutinee, then a guard may reject it.
            var lo = self.bind_local(pat.name, scrut, pat.is_mut)
            let pair_l = lo.fresh_label()
            lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair = lo.lower_expr_ref(&arm.body)
            lo = pair.0
            let body_reg = pair.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatEnum {
            let variant_name = ir_path_last_name(pat.path)
            // Check for Some/None (Option<Box<T>> as nullable pointer)
            let is_some = ir_name_is_some(variant_name)
            let is_none = ir_name_is_none(variant_name)
            if is_some {
                // Some(x): test scrutinee != 0, bind inner x = scrutinee
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee == 0 (skip this arm)
                lo = lo.emit(ir_branch_false(scrut, l_skip))
                // Bind the inner pattern (first sub_pattern) to scrutinee value
                lo = lo.bind_match_sub_pattern(scrut, pat.sub_patterns)
                lo = lo.lower_arm_guard(&arm.guard, l_skip)
                let pair_b = lo.lower_expr_ref(&arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else if is_none {
                // None: test scrutinee == 0
                let pair_l = self.fresh_label()
                var lo = pair_l.0
                let l_skip = pair_l.1
                // Branch if scrutinee != 0 (skip this arm)
                lo = lo.emit(ir_branch_true(scrut, l_skip))
                lo = lo.lower_arm_guard(&arm.guard, l_skip)
                let pair_b = lo.lower_expr_ref(&arm.body)
                lo = pair_b.0
                let body_reg = pair_b.1
                lo = lo.emit(ir_copy(res, body_reg))
                lo = lo.emit(ir_jump(l_end))
                lo = lo.emit(ir_label(l_skip))
                lo
            } else {
                // Enum variant: compare scrutinee to discriminant
                let disc = self.lookup_variant_discriminant(variant_name)
                if disc >= 0 {
                    let pair_l = self.fresh_label()
                    var lo = pair_l.0
                    let l_skip = pair_l.1
                    let pair_d = lo.fresh_reg()
                    lo = pair_d.0
                    let disc_reg = pair_d.1
                    lo = lo.emit(ir_load_imm(disc_reg, disc))
                    let pair_cmp = lo.fresh_reg()
                    lo = pair_cmp.0
                    let cmp_reg = pair_cmp.1
                    lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, disc_reg))
                    lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
                    lo = lo.lower_arm_guard(&arm.guard, l_skip)
                    let pair_b = lo.lower_expr_ref(&arm.body)
                    lo = pair_b.0
                    let body_reg = pair_b.1
                    lo = lo.emit(ir_copy(res, body_reg))
                    lo = lo.emit(ir_jump(l_end))
                    lo = lo.emit(ir_label(l_skip))
                    lo
                } else {
                    // Unknown variant — skip this arm
                    self
                }
            }
        } else if pat.kind == PatternKind::PatIntLit {
            // Integer literal: compare scrutinee to int_val
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            let pair_d = lo.fresh_reg()
            lo = pair_d.0
            let lit_reg = pair_d.1
            lo = lo.emit(ir_load_imm(lit_reg, pat.int_val))
            let pair_cmp = lo.fresh_reg()
            lo = pair_cmp.0
            let cmp_reg = pair_cmp.1
            lo = lo.emit(ir_binop(cmp_reg, scrut, BinaryOp::OpEq, lit_reg))
            lo = lo.emit(ir_branch_false(cmp_reg, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolTrue {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_false(scrut, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else if pat.kind == PatternKind::PatBoolFalse {
            let pair_l = self.fresh_label()
            var lo = pair_l.0
            let l_skip = pair_l.1
            lo = lo.emit(ir_branch_true(scrut, l_skip))
            lo = lo.lower_arm_guard(&arm.guard, l_skip)
            let pair_b = lo.lower_expr_ref(&arm.body)
            lo = pair_b.0
            let body_reg = pair_b.1
            lo = lo.emit(ir_copy(res, body_reg))
            lo = lo.emit(ir_jump(l_end))
            lo = lo.emit(ir_label(l_skip))
            lo
        } else {
            // Unsupported pattern — skip
            self
        }
    }

    fn lower_match_arm(self, scrut: i64, res: i64, l_end: i64, arm: MatchArm) -> Lowerer with Mut, Panic, Div, Alloc, IO {
        self.lower_match_arm_ref(scrut, res, l_end, &arm)
    }

    // Lower Some(x) — just evaluate the first argument (identity)
    fn lower_expr_args_first(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => self.lower_expr_ref(&(*list).head),
            _ => self.emit_unit(),
        }
    }

    // Lower Box::new(x) — alloc 8 bytes, store value, return pointer
    fn lower_box_new(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_dst = self.fresh_reg()
                var lo = pair_dst.0
                let ptr_reg = pair_dst.1
                let value_expr = (*list).head
                let pair_v = lo.lower_expr_ref(&value_expr)
                lo = pair_v.0
                let val_reg = pair_v.1
                // Allocate 8 bytes on heap
                lo = lo.emit(ir_alloc(ptr_reg, 8))
                // Store value at ptr[0]
                lo = lo.emit(ir_field_set(ptr_reg, 0, val_reg, ir_empty_name()))
                (lo, ptr_reg)
            }
            _ => self.emit_unit(),
        }
    }

    // prove_robust(contest, policy) → IrProveRobust (zero-cost copy; policy is proof-time only)
    fn lower_prove_robust_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Extract first arg (contest expression)
        let contest_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let contest_pair = self.lower_opt_expr(contest_expr)
        let lo1 = contest_pair.0
        let contest_reg = contest_pair.1
        let policy_reg = IR_INVALID_REG
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let proof_id = lo2.find_robust_proof_id_for_span(span)
        let lo3 = lo2.emit(ir_prove_robust(dst_reg, contest_reg, policy_reg, proof_id))
        (lo3, dst_reg)
    }

    // Policy / validation / protocol arguments in epistemic terminal calls are
    // proof-time metadata, not runtime values. Lowering them as ExprPath would
    // spuriously report errors on names like `DefaultPolicy`.
    fn lower_compile_time_only_arg_reg(self) -> i64 with Mut, Panic, Div {
        IR_INVALID_REG
    }

    // validate_manifest(robust, validation) → IrValidated (zero-cost copy; terminal epistemic gate)
    fn lower_validate_manifest_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let robust_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let robust_pair = self.lower_opt_expr(robust_expr)
        let lo1 = robust_pair.0
        let robust_reg = robust_pair.1
        let validation_reg = lo1.lower_compile_time_only_arg_reg()
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let manifest_id = lo2.find_validated_manifest_id_for_span(span)
        let lo3 = lo2.emit(ir_validated(dst_reg, robust_reg, validation_reg, manifest_id))
        (lo3, dst_reg)
    }

    // admit_action(value, robust, decision_policy) → IrAdmitAction (zero-cost copy; terminal decision gate)
    fn lower_admit_action_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let robust_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let robust_pair = lo1.lower_opt_expr(robust_expr)
        let lo2 = robust_pair.0
        let robust_reg = robust_pair.1
        let decision_policy_reg = lo2.lower_compile_time_only_arg_reg()

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let certificate_id = lo3.find_decision_certificate_id_for_span(span)
        let lo4 = lo3.emit(ir_admit_action(dst_reg, value_reg, robust_reg, decision_policy_reg, certificate_id))
        (lo4, dst_reg)
    }

    fn lower_defer_action_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let evidence_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let evidence_pair = lo1.lower_opt_expr(evidence_expr)
        let lo2 = evidence_pair.0
        let evidence_reg = evidence_pair.1
        let policy_reg = lo2.lower_compile_time_only_arg_reg()

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let certificate_id = lo3.find_deferred_certificate_id_for_span(span)
        let lo4 = lo3.emit(ir_defer_action(dst_reg, value_reg, evidence_reg, policy_reg, certificate_id))
        (lo4, dst_reg)
    }

    fn lower_deferral_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_deferred_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.deferred_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.deferred_reason_witnesses[witness_id as usize]
        let cert_id = witness_info.deferred_certificate_id
        if cert_id < 0 || cert_id >= self.module.epistemic.deferred_certificate_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_deferral_reason_witness(self.module.epistemic.deferred_certificates[cert_id as usize])
    }

    fn lower_plan_acquisition_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let deferred_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let deferred_pair = lo1.lower_opt_expr(deferred_expr)
        let lo2 = deferred_pair.0
        let deferred_reg = deferred_pair.1
        let policy_reg = lo2.lower_compile_time_only_arg_reg()

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let plan_id = lo3.find_acquisition_plan_id_for_span(span)
        let lo4 = lo3.emit(ir_plan_acquisition(dst_reg, value_reg, deferred_reg, policy_reg, plan_id))
        (lo4, dst_reg)
    }

    fn lower_acquisition_reason_witness(self, info: IrAcquisitionPlanInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_acquisition_policy_name(info.acquisition_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let route_name_pair = lo.emit_name_string(lo.epistemic_acquisition_policy_route_name(info.acquisition_policy_id))
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let objective_name_pair = lo.emit_name_string(lo.epistemic_acquisition_policy_objective_name(info.acquisition_policy_id))
        lo = objective_name_pair.0
        lo = lo.emit_named_field(dst, make_name("objective_name"), objective_name_pair.1)

        let deferred_reason_pair = lo.emit_i64_const(lo.deferred_metric_i64(info.metric_known, info.metric_values, 6))
        lo = deferred_reason_pair.0
        lo = lo.emit_named_field(dst, make_name("deferred_reason"), deferred_reason_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let contest_pair = lo.emit_i64_const(info.contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let snapshot_pair = lo.lower_metric_snapshot_literal(info.metric_values)
        lo = snapshot_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_snapshot"), snapshot_pair.1)

        (lo, dst)
    }

    fn lower_acquisition_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_acquisition_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.acquisition_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.acquisition_reason_witnesses[witness_id as usize]
        let plan_id = witness_info.acquisition_plan_id
        if plan_id < 0 || plan_id >= self.module.epistemic.acquisition_plan_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_acquisition_reason_witness(self.module.epistemic.acquisition_plans[plan_id as usize])
    }

    fn lower_plan_recourse_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let deferred_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let deferred_pair = lo1.lower_opt_expr(deferred_expr)
        let lo2 = deferred_pair.0
        let deferred_reg = deferred_pair.1
        let policy_reg = lo2.lower_compile_time_only_arg_reg()

        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let plan_id = lo3.find_recourse_plan_id_for_span(span)
        let lo4 = lo3.emit(ir_plan_recourse(dst_reg, value_reg, deferred_reg, policy_reg, plan_id))
        (lo4, dst_reg)
    }

    fn lower_recourse_reason_witness(self, info: IrRecoursePlanInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_recourse_policy_name(info.recourse_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let route_name_pair = lo.emit_name_string(lo.epistemic_recourse_policy_route_name(info.recourse_policy_id))
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let strategy_name_pair = lo.emit_name_string(lo.epistemic_recourse_policy_strategy_name(info.recourse_policy_id))
        lo = strategy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("strategy_name"), strategy_name_pair.1)

        let deferred_reason_pair = lo.emit_i64_const(lo.deferred_metric_i64(info.metric_known, info.metric_values, 6))
        lo = deferred_reason_pair.0
        lo = lo.emit_named_field(dst, make_name("deferred_reason"), deferred_reason_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let contest_pair = lo.emit_i64_const(info.contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let snapshot_pair = lo.lower_metric_snapshot_literal(info.metric_values)
        lo = snapshot_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_snapshot"), snapshot_pair.1)

        (lo, dst)
    }

    fn lower_recourse_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_recourse_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.recourse_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.recourse_reason_witnesses[witness_id as usize]
        let plan_id = witness_info.recourse_plan_id
        if plan_id < 0 || plan_id >= self.module.epistemic.recourse_plan_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_recourse_reason_witness(self.module.epistemic.recourse_plans[plan_id as usize])
    }

    fn lower_propose_alternatives_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let evidence_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let evidence_pair = lo1.lower_opt_expr(evidence_expr)
        let lo2 = evidence_pair.0
        let evidence_reg = evidence_pair.1

        let frontier_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => match (*rest).tail {
                    Some(rest2) => Some(Box::new((*rest2).head))
                    None => None
                }
                None => None
            }
            None => None
        }
        let frontier_pair = lo2.lower_opt_expr(frontier_expr)
        let lo3 = frontier_pair.0
        let frontier_reg = frontier_pair.1

        let pair_dst = lo3.fresh_reg()
        let lo4 = pair_dst.0
        let dst_reg = pair_dst.1
        let set_id = lo4.find_alternative_set_id_for_span(span)
        let lo5 = lo4.emit(ir_propose_alternatives(dst_reg, value_reg, evidence_reg, frontier_reg, set_id))
        (lo5, dst_reg)
    }

    // Sprint 116: measure(v, uncertainty) → Knowledge<f64> struct construction
    fn lower_measure_call_ref(self, _span: Span, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Extract first argument: value
        let value_pair = self.lower_measure_value_arg_ref(args)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        // Extract second argument: uncertainty
        let unc_pair = lo1.lower_measure_uncertainty_arg_ref(args)
        var lo2 = unc_pair.0
        let unc_reg = unc_pair.1
        lo2 = lo2.emit(ir_mark_float_reg(unc_reg))

        // IrAlloc for Knowledge struct
        let dst_pair = lo2.fresh_reg()
        let lo3 = dst_pair.0
        let dst_reg = dst_pair.1
        let lo4 = lo3.emit(ir_alloc(dst_reg, 0))

        // field 0: value
        let lo5 = lo4.emit(ir_field_set(dst_reg, 0, value_reg, make_name("value")))

        // field 1: variance = uncertainty * uncertainty
        let var_pair = lo5.fresh_reg()
        let lo6 = var_pair.0
        let variance_reg = var_pair.1
        var lo7 = lo6.emit(ir_binop(variance_reg, unc_reg, BinaryOp::OpMul, unc_reg))
        lo7 = lo7.emit(ir_mark_float_reg(variance_reg))
        let lo8 = lo7.emit(ir_field_set(dst_reg, 1, variance_reg, make_name("variance")))

        // field 2: confidence = 1.0
        let conf_pair = lo8.fresh_reg()
        let lo9 = conf_pair.0
        let conf_reg = conf_pair.1
        let lo10 = lo9.emit(ir_load_float(conf_reg, 1.0))
        var lo11 = lo10.emit(ir_field_set(dst_reg, 2, conf_reg, make_name("confidence")))
        lo11 = lo11.bind_variance_for_base_reg(dst_reg, variance_reg)
        lo11.pending_variance_reg = variance_reg

        (lo11, dst_reg)
    }

    fn lower_variance_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match *args {
            Some(list) => {
                let pair_v = self.lower_expr_variance_ref(&(*list).head)
                var lo = pair_v.0
                if pair_v.1 >= 0 {
                    lo = lo.emit(ir_mark_float_reg(pair_v.1))
                    return (lo, pair_v.1)
                }
                lo.emit_zero_variance()
            }
            _ => self.emit_zero_variance(),
        }
    }

    fn lower_uncertainty_of_call_ref(self, args: &Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_v = self.lower_variance_of_call_ref(args)
        var lo = pair_v.0
        let variance_reg = pair_v.1
        let sqrt_id = lowerer_find_or_add_fn_id_mut(&! lo, make_name("sqrt"))
        let sqrt_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(variance_reg)))
        let pair_dst = lo.fresh_reg()
        lo = pair_dst.0
        let dst = pair_dst.1
        var instr = ir_call(dst, sqrt_id, make_name("sqrt"), sqrt_args, 1)
        instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        lo = lo.emit(instr)
        lo = lo.emit(ir_mark_float_reg(dst))
        (lo, dst)
    }

    // lift_knowledge(k: Knowledge<T>) → IrLiftKnowledge (zero-cost copy; epistemic bridge H5.4)
    fn lower_lift_knowledge_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let knowledge_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let knowledge_pair = self.lower_opt_expr(knowledge_expr)
        let lo1 = knowledge_pair.0
        let knowledge_reg = knowledge_pair.1
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let contest_id = lo2.find_contest_id_for_span(span)
        let lo3 = lo2.emit(ir_lift_knowledge(dst_reg, knowledge_reg, contest_id))
        (lo3, dst_reg)
    }

    fn lower_alternative_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let set_id = self.find_alternative_set_id_for_span(span)
        if set_id < 0 || set_id >= self.module.epistemic.alternative_set_count {
            return self.emit_i64_const(0)
        }
        self.emit_i64_const(self.module.epistemic.alternative_sets[set_id as usize].candidate_count)
    }

    fn lower_alternative_option_call(self, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let set_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let set_pair = self.lower_opt_expr(set_expr)
        let lo1 = set_pair.0
        let set_reg = set_pair.1

        // Lower the index expression to preserve potential side-effects,
        // even though the option choice is checker-materialized metadata.
        let idx_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let idx_pair = lo1.lower_opt_expr(idx_expr)
        let lo2 = idx_pair.0

        let pair_dst = lo2.fresh_reg()
        let lo3 = pair_dst.0
        let dst_reg = pair_dst.1
        let lo4 = lo3.emit(ir_copy(dst_reg, set_reg))
        (lo4, dst_reg)
    }

    fn lower_alternative_reason_witness(self, info: IrAlternativeReasonWitnessInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        if info.candidate_id < 0 || info.candidate_id >= self.module.epistemic.alternative_candidate_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let cand = self.module.epistemic.alternative_candidates[info.candidate_id as usize]

        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let candidate_name_pair = lo.emit_name_string(cand.name)
        lo = candidate_name_pair.0
        lo = lo.emit_named_field(dst, make_name("candidate_name"), candidate_name_pair.1)

        let strategy_name_pair = lo.emit_name_string(cand.strategy_name)
        lo = strategy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("strategy_name"), strategy_name_pair.1)

        let route_name_pair = lo.emit_name_string(cand.route_name)
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let source_kind_pair = lo.emit_name_string(lo.alternative_source_kind_name(cand.source_kind))
        lo = source_kind_pair.0
        lo = lo.emit_named_field(dst, make_name("source_kind"), source_kind_pair.1)

        let contest_id_pair = lo.emit_i64_const(cand.contest_id)
        lo = contest_id_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_id_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(cand.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let intervention_cost_pair = lo.emit_f64_const(cand.intervention_cost)
        lo = intervention_cost_pair.0
        lo = lo.emit_named_field(dst, make_name("intervention_cost"), intervention_cost_pair.1)

        let residual_tail_risk_pair = lo.emit_f64_const(cand.residual_tail_risk)
        lo = residual_tail_risk_pair.0
        lo = lo.emit_named_field(dst, make_name("residual_tail_risk"), residual_tail_risk_pair.1)

        let mechanistic_divergence_pair = lo.emit_f64_const(cand.mechanistic_divergence)
        lo = mechanistic_divergence_pair.0
        lo = lo.emit_named_field(dst, make_name("mechanistic_divergence"), mechanistic_divergence_pair.1)

        let admissibility_margin_pair = lo.emit_f64_const(cand.admissibility_margin)
        lo = admissibility_margin_pair.0
        lo = lo.emit_named_field(dst, make_name("admissibility_margin"), admissibility_margin_pair.1)

        (lo, dst)
    }

    fn lower_alternative_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_alternative_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.alternative_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_alternative_reason_witness(self.module.epistemic.alternative_reason_witnesses[witness_id as usize])
    }

    fn lower_commit_alternative_call(self, span: Span, args: Option<Box<ExprList>>) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let value_expr = match args {
            Some(list) => Some(Box::new((*list).head))
            None => None
        }
        let value_pair = self.lower_opt_expr(value_expr)
        let lo1 = value_pair.0
        let value_reg = value_pair.1

        let option_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => Some(Box::new((*rest).head))
                None => None
            }
            None => None
        }
        let option_pair = lo1.lower_opt_expr(option_expr)
        let lo2 = option_pair.0
        let option_reg = option_pair.1

        let protocol_expr = match args {
            Some(list) => match (*list).tail {
                Some(rest) => match (*rest).tail {
                    Some(rest2) => Some(Box::new((*rest2).head))
                    None => None
                }
                None => None
            }
            None => None
        }
        let protocol_pair = lo2.lower_opt_expr(protocol_expr)
        let lo3 = protocol_pair.0
        let protocol_reg = protocol_pair.1

        let pair_dst = lo3.fresh_reg()
        let lo4 = pair_dst.0
        let dst_reg = pair_dst.1
        let plan_id = lo4.find_transition_plan_id_for_span(span)
        let lo5 = lo4.emit(ir_commit_alternative(dst_reg, value_reg, option_reg, protocol_reg, plan_id))
        (lo5, dst_reg)
    }

    // Sprint 28: Emit a debug guard instruction after an epistemic gate.
    // Only emits when debug_mode is true. In release mode, this is a no-op.
    fn emit_debug_guard(self, gate_name: Name, dst_reg: i64) -> Lowerer with Mut, Panic, Div {
        if !self.debug_mode {
            return self
        }
        // Emit a single guard: compare dst_reg against default threshold (0.0 = no-op guard)
        // The threshold and comparison will be refined when policy requirements are wired
        self.emit(ir_debug_guard(dst_reg, 0.0, 4, 0, gate_name))
    }

    fn lower_transition_reason_witness(self, info: IrTransitionPlanInfo) -> (Lowerer, i64) with Mut, Panic, Div {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, 0))

        let policy_name_pair = lo.emit_name_string(lo.epistemic_transition_policy_name(info.transition_policy_id))
        lo = policy_name_pair.0
        lo = lo.emit_named_field(dst, make_name("policy_name"), policy_name_pair.1)

        let protocol_name_pair = lo.emit_name_string(lo.epistemic_transition_protocol_name(info.transition_protocol_id))
        lo = protocol_name_pair.0
        lo = lo.emit_named_field(dst, make_name("protocol_name"), protocol_name_pair.1)

        let route_name_pair = lo.emit_name_string(info.route_name)
        lo = route_name_pair.0
        lo = lo.emit_named_field(dst, make_name("route_name"), route_name_pair.1)

        let rollback_route_pair = lo.emit_name_string(info.rollback_route_name)
        lo = rollback_route_pair.0
        lo = lo.emit_named_field(dst, make_name("rollback_route_name"), rollback_route_pair.1)

        let audit_name_pair = lo.emit_name_string(lo.epistemic_audit_name(info.audit_id))
        lo = audit_name_pair.0
        lo = lo.emit_named_field(dst, make_name("audit_name"), audit_name_pair.1)

        let contest_pair = lo.emit_i64_const(info.contest_id)
        lo = contest_pair.0
        lo = lo.emit_named_field(dst, make_name("contest_id"), contest_pair.1)

        let step_count_pair = lo.emit_i64_const(info.step_count)
        lo = step_count_pair.0
        lo = lo.emit_named_field(dst, make_name("step_count"), step_count_pair.1)

        let final_value_pair = lo.emit_name_string(info.final_value_repr)
        lo = final_value_pair.0
        lo = lo.emit_named_field(dst, make_name("final_value_repr"), final_value_pair.1)

        let snapshot_pair = lo.lower_metric_snapshot_literal(info.metric_values)
        lo = snapshot_pair.0
        lo = lo.emit_named_field(dst, make_name("metric_snapshot"), snapshot_pair.1)

        (lo, dst)
    }

    fn lower_transition_reason_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let witness_id = self.find_transition_reason_witness_id_for_span(span)
        if witness_id < 0 || witness_id >= self.module.epistemic.transition_reason_witness_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        let witness_info = self.module.epistemic.transition_reason_witnesses[witness_id as usize]
        let plan_id = witness_info.transition_plan_id
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            let loe = self.report_error()
            return loe.emit_unit()
        }
        self.lower_transition_reason_witness(self.module.epistemic.transition_plans[plan_id as usize])
    }

    fn lower_transition_step_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let plan_id = self.find_transition_plan_id_for_span(span)
        if plan_id < 0 || plan_id >= self.module.epistemic.transition_plan_count {
            return self.emit_i64_const(0)
        }
        self.emit_i64_const(self.module.epistemic.transition_plans[plan_id as usize].step_count)
    }

    // Bind the first sub-pattern of a Some(x) match to the scrutinee value
    fn bind_match_sub_pattern(self, scrut: i64, pats: Option<Box<PatternList>>) -> Lowerer with Mut, Panic, Div, Alloc {
        match pats {
            Some(list) => {
                let inner = (*list).head
                if inner.kind == PatternKind::PatBinding {
                    var lo = self.bind_local(inner.name, scrut, inner.is_mut)
                    // The payload of `Some(nx)` on an Option<Box<T>> is a Box handle, so mark
                    // the bound variable as a Box: `*nx` then lowers to the box-handle deref
                    // (IrFieldGet 0) instead of raw-dereferencing the handle (which crashed —
                    // the recursive-data root). Safe for non-Box payloads: marking only
                    // changes how `*nx` lowers, and deref/field-access of a non-Box payload
                    // (e.g. Option<i64>) is not valid code anyway.
                    lo = lo.bind_local_struct_type(inner.name, make_name("Box"))
                    lo
                } else if inner.kind == PatternKind::PatWildcard {
                    // _ inside Some(_) — no binding needed
                    self
                } else {
                    self
                }
            }
            _ => self,
        }
    }

    fn lower_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let callee_opt_ref = &e.left
        let callee_name = match *callee_opt_ref {
            Some(c) => self.expr_to_callee_name_ref(&(*c)),
            None => ir_empty_name(),
        }
        if name_eq(callee_name, make_name("print")) || name_eq(callee_name, make_name("print_int")) || name_eq(callee_name, make_name("print_char")) {
            // Redirect bare print(<int literal>) to the print_int builtin: print
            // (=print_str) treats its argument as a char* and would deref the integer
            // value as a pointer. Explicit print_int / print_char are left untouched.
            var print_builtin_name = callee_name
            if name_eq(callee_name, make_name("print")) {
                print_builtin_name = self.println_dispatch_name(&e.args)
            }
            var lo_builtin = self
            let fn_id_builtin = lowerer_find_or_add_fn_id_mut(&! lo_builtin, print_builtin_name)
            let pair_args_builtin: LowerExprArgsResult = lo_builtin.lower_expr_args_ref(&e.args)
            let lo_args_builtin = pair_args_builtin.lowerer
            let args_builtin: Option<Box<IrRegList>> = if pair_args_builtin.count <= 0 { None } else { Some(Box::new(pair_args_builtin.regs)) }
            let argc_builtin = pair_args_builtin.count
            let pair_dst_builtin = lo_args_builtin.fresh_reg()
            let lo_dst_builtin = pair_dst_builtin.0
            let dst_builtin = pair_dst_builtin.1
            let lo_call_builtin = lo_dst_builtin.emit(ir_call(dst_builtin, fn_id_builtin, print_builtin_name, args_builtin, argc_builtin))
            return (lo_call_builtin, dst_builtin)
        }
        if name_eq(callee_name, make_name("println")) {
            // Lower println(x) -> print_kind(x); print_char('\n'). Dispatch rules:
            //   int literal / i64 var  → print_int   (itoa+write)
            //   float literal / f64 var → print_f64   (dtoa+write)
            //   anything else          → print        (strlen+write, safe fallback for strings)
            // print_str treats its argument as a char*; routing a numeric value to it
            // causes a SIGSEGV. The scalar_kind table tracks annotated i64/f64 locals.
            let pl_print_name = self.println_dispatch_name(&e.args)
            var lo_pl = self
            let fn_id_print = lowerer_find_or_add_fn_id_mut(&! lo_pl, pl_print_name)
            let pair_args_pl: LowerExprArgsResult = lo_pl.lower_expr_args_ref(&e.args)
            let lo_args_pl = pair_args_pl.lowerer
            let args_pl: Option<Box<IrRegList>> = if pair_args_pl.count <= 0 { None } else { Some(Box::new(pair_args_pl.regs)) }
            let argc_pl = pair_args_pl.count
            let pair_dst_pl = lo_args_pl.fresh_reg()
            let lo_dst_pl = pair_dst_pl.0
            let dst_pl = pair_dst_pl.1
            var lo_call_pl = lo_dst_pl.emit(ir_call(dst_pl, fn_id_print, pl_print_name, args_pl, argc_pl))

            let fn_id_print_char = lowerer_find_or_add_fn_id_mut(&! lo_call_pl, make_name("print_char"))
            let pair_nl_reg = lo_call_pl.fresh_reg()
            let lo_nl_reg = pair_nl_reg.0
            let nl_reg = pair_nl_reg.1
            let lo_load_nl = lo_nl_reg.emit(ir_load_imm(nl_reg, 10))
            let nl_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(nl_reg)))
            let pair_nl_dst = lo_load_nl.fresh_reg()
            let lo_nl_dst = pair_nl_dst.0
            let nl_dst = pair_nl_dst.1
            let lo_call_nl = lo_nl_dst.emit(ir_call(nl_dst, fn_id_print_char, make_name("print_char"), nl_args, 1))
            return (lo_call_nl, dst_pl)
        }
        if ir_name_is_some(callee_name) {
            return self.lower_expr_args_first(&e.args)
        }
        if ir_name_is_box(callee_name) {
            return self.lower_box_new(&e.args)
        }
        if ir_name_is_prove_robust(callee_name) {
            return self.lower_prove_robust_call(e.span, e.args)
        }
        if ir_name_is_validate_manifest(callee_name) {
            return self.lower_validate_manifest_call(e.span, e.args)
        }
        if ir_name_is_admit_action(callee_name) {
            return self.lower_admit_action_call(e.span, e.args)
        }
        if ir_name_is_defer_action(callee_name) {
            return self.lower_defer_action_call(e.span, e.args)
        }
        if ir_name_is_deferral_reason(callee_name) {
            return self.lower_deferral_reason_call(e.span)
        }
        if ir_name_is_plan_acquisition(callee_name) {
            return self.lower_plan_acquisition_call(e.span, e.args)
        }
        if ir_name_is_acquisition_reason(callee_name) {
            return self.lower_acquisition_reason_call(e.span)
        }
        if ir_name_is_plan_recourse(callee_name) {
            return self.lower_plan_recourse_call(e.span, e.args)
        }
        if ir_name_is_recourse_reason(callee_name) {
            return self.lower_recourse_reason_call(e.span)
        }
        if ir_name_is_propose_alternatives(callee_name) {
            return self.lower_propose_alternatives_call(e.span, e.args)
        }
        if ir_name_is_commit_alternative(callee_name) {
            return self.lower_commit_alternative_call(e.span, e.args)
        }
        if ir_name_is_alternative_count(callee_name) {
            return self.lower_alternative_count_call(e.span)
        }
        if ir_name_is_alternative_option(callee_name) {
            return self.lower_alternative_option_call(e.args)
        }
        if ir_name_is_alternative_reason(callee_name) {
            return self.lower_alternative_reason_call(e.span)
        }
        if ir_name_is_transition_reason(callee_name) {
            return self.lower_transition_reason_call(e.span)
        }
        if ir_name_is_transition_step_count(callee_name) {
            return self.lower_transition_step_count_call(e.span)
        }
        if ir_name_is_lift_knowledge(callee_name) {
            return self.lower_lift_knowledge_call(e.span, e.args)
        }
        if ir_name_is_measure(callee_name) {
            return self.lower_measure_call_ref(e.span, &e.args)
        }
        if self.name_is_variance_of(callee_name) {
            return self.lower_variance_of_call_ref(&e.args)
        }
        if self.name_is_uncertainty_of(callee_name) {
            return self.lower_uncertainty_of_call_ref(&e.args)
        }
        if self.contest_witness_kind_from_callee(callee_name) >= 0 {
            return self.lower_contest_witness_call(e.span, callee_name)
        }
        // Inline expression callee (e.g. `(|x| x)(n)`): no resolvable name — lower the
        // callee expression to a fn-ref reg and dispatch indirectly, rather than falling
        // through to find_or_add_fn_id(empty) (which calls a body-less fn -> crash).
        if callee_name.len <= 0 {
            match *callee_opt_ref {
                Some(_) => {
                    let pair_cal = self.lower_opt_expr_ref(&e.left)
                    let lo_cal = pair_cal.0
                    let callee_reg = pair_cal.1
                    let pair_args_x: LowerExprArgsResult = lo_cal.lower_expr_args_ref(&e.args)
                    let lo_x = pair_args_x.lowerer
                    let args_x: Option<Box<IrRegList>> = if pair_args_x.count <= 0 { None } else { Some(Box::new(pair_args_x.regs)) }
                    let argc_x = pair_args_x.count
                    let pair_dx = lo_x.fresh_reg()
                    let lo_dx = pair_dx.0
                    let dst_x = pair_dx.1
                    let lo_cx = lo_dx.emit(ir_call_indirect(dst_x, callee_reg, args_x, argc_x))
                    return (lo_cx, dst_x)
                }
                _ => {}
            }
        }
        let callee_local_reg = self.lookup_local(callee_name)
        if callee_local_reg >= 0 {
            // Capturing closure (closures step 2): direct-call the synthetic fn with
            // [captured_regs..., args...]. IrCall relocs by fn_id, so the name is unused.
            let ccap_fn = self.lookup_local_closure_fn_id(callee_name)
            if ccap_fn >= 0 {
                let pair_args_c: LowerExprArgsResult = self.lower_expr_args_ref(&e.args)
                let lo_c = pair_args_c.lowerer
                var arglist_c: Option<Box<IrRegList>> = if pair_args_c.count <= 0 { None } else { Some(Box::new(pair_args_c.regs)) }
                var total_c = pair_args_c.count
                let cidx = lo_c.find_closure_cap_idx(ccap_fn)
                if cidx >= 0 {
                    let ccount = (*lo_c.closure_caps).entries[cidx as usize].cap_count
                    var jc = ccount - 1
                    while jc >= 0 {
                        arglist_c = ir_reg_list_prepend((*lo_c.closure_caps).entries[cidx as usize].caps[jc as usize], arglist_c)
                        jc = jc - 1
                    }
                    total_c = total_c + ccount
                }
                let pair_dc = lo_c.fresh_reg()
                let lo_dc = pair_dc.0
                let dst_c = pair_dc.1
                let lo_cc = lo_dc.emit(ir_call(dst_c, ccap_fn, ir_empty_name(), arglist_c, total_c))
                return (lo_cc, dst_c)
            }
            let pair_args_i: LowerExprArgsResult = self.lower_expr_args_ref(&e.args)
            let lo_i = pair_args_i.lowerer
            let args_i: Option<Box<IrRegList>> = if pair_args_i.count <= 0 { None } else { Some(Box::new(pair_args_i.regs)) }
            let argc_i = pair_args_i.count
            let pair_d_i = lo_i.fresh_reg()
            let lo2_i = pair_d_i.0
            let dst_i = pair_d_i.1
            let lo3_i = lo2_i.emit(ir_call_indirect(dst_i, callee_local_reg, args_i, argc_i))
            return (lo3_i, dst_i)
        }
        var lo1 = self
        let fn_id = lowerer_find_or_add_fn_id_mut(&! lo1, callee_name)
        if lo1.ir_name_is_knowledge_kaxi_publish(callee_name) {
            if lo1.expr_list_len_ref(&e.args) == 2 {
                return lo1.lower_kaxi_publish_call(fn_id, callee_name, e.args)
            }
        }
        if lo1.first_arg_is_capturing_closure_literal_ref(&e.args) && lo1.lower_function_is_transparent_hof(fn_id) {
            return lo1.lower_hof_captured_closure_literal_call(callee_name, &e.args)
        }
        let hof_closure_local_fn = lo1.first_arg_capturing_closure_local_fn_id_ref(&e.args)
        if hof_closure_local_fn >= 0 && lo1.lower_function_is_transparent_hof(fn_id) {
            return lo1.lower_hof_captured_closure_local_call(hof_closure_local_fn, callee_name, &e.args)
        }
        let pair_args: LowerExprArgsResult = lo1.lower_expr_args_ref(&e.args)
        let lo2 = pair_args.lowerer
        let args: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let argc = pair_args.count
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        let callee_strat_ext: i64 = if fn_id >= 0 && fn_id < (*lo3.module).fn_count { (*lo3.module).functions[fn_id as usize].compile_strategy } else { 0 }
        if callee_strat_ext == 6 {
            let lo_ext = lo3.emit(ir_call_extern(dst, callee_name, args, argc))
            return (lo_ext, dst)
        }
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args, argc)
        let lo4 = pair_call.lo
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        var call_instr = ir_call(dst, fn_id, callee_name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo4.module).fn_count {
            if (*lo4.module).functions[fn_id as usize].returns_float == 1 {
                call_instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo5 = lo4.emit(call_instr)
        if call_instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo5 = lo5.emit(ir_mark_float_reg(dst))
        }
        (lo5, dst)
    }

    fn lower_binary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let wide_bits = self.expr_wide_bits_ref(e)
        let lhs_expr_is_float = self.opt_expr_result_is_float_ref(&e.left)
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let rhs_expr_is_float = lo1.opt_expr_result_is_float_ref(&e.right)
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_r.0
        let rhs = pair_r.1
        let cmp_op = lower_binary_op_to_wide_cmp(e.bin_op)
        let limbs = lower_wide_limb_count(wide_bits)
        var alloc_limbs = limbs
        if wide_bits > 64 && cmp_op < 0 {
            if e.bin_op == BinaryOp::OpMul {
                alloc_limbs = limbs + 2
            } else if e.bin_op == BinaryOp::OpDiv || e.bin_op == BinaryOp::OpRem {
                alloc_limbs = limbs * 3
            }
        }
        let pair_d = if wide_bits > 64 && cmp_op < 0 { lo2.fresh_wide_reg(alloc_limbs) } else { lo2.fresh_reg() }
        var lo3 = pair_d.0
        let dst = pair_d.1
        // String concatenation: `s + t` / `s ++ t` route to the str_concat builtin (heap
        // alloc + copy), instead of an integer add of the string pointers.
        if e.bin_op == BinaryOp::OpAdd || e.bin_op == BinaryOp::OpConcat {
            if lo3.opt_expr_result_is_string_ref(&e.left) || lo3.opt_expr_result_is_string_ref(&e.right) {
                var lo_sc = lo3
                let sc_fn = lowerer_find_or_add_fn_id_mut(&! lo_sc, make_name("str_concat"))
                let sc_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(lhs, Some(Box::new(ir_reg_list_single(rhs))))))
                let lo_call = lo_sc.emit(ir_call(dst, sc_fn, make_name("str_concat"), sc_args, 2))
                return (lo_call, dst)
            }
        }
        // String equality: `s == t` / `s != t` route to the str_eq builtin (content
        // compare), instead of an integer compare of the string pointers (which is
        // always false for distinct literals). `!=` negates via `(str_eq == 0)`.
        if e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe {
            if lo3.opt_expr_result_is_string_ref(&e.left) || lo3.opt_expr_result_is_string_ref(&e.right) {
                var lo_se = lo3
                let se_fn = lowerer_find_or_add_fn_id_mut(&! lo_se, make_name("str_eq"))
                let se_args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_cons(lhs, Some(Box::new(ir_reg_list_single(rhs))))))
                if e.bin_op == BinaryOp::OpEq {
                    let lo_call = lo_se.emit(ir_call(dst, se_fn, make_name("str_eq"), se_args, 2))
                    return (lo_call, dst)
                }
                let eqp = lo_se.fresh_reg()
                var lo_e = eqp.0
                let eq_reg = eqp.1
                lo_e = lo_e.emit(ir_call(eq_reg, se_fn, make_name("str_eq"), se_args, 2))
                let zp = lo_e.fresh_reg()
                var lo_z = zp.0
                let zero_reg = zp.1
                lo_z = lo_z.emit(ir_load_imm(zero_reg, 0))
                let lo_ne = lo_z.emit(ir_binop(dst, eq_reg, BinaryOp::OpEq, zero_reg))
                return (lo_ne, dst)
            }
        }
        if lhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(lhs))
        }
        if rhs_expr_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(rhs))
        }
        if e.bin_op == BinaryOp::OpMul {
            let hyper_expr_id = lowerer_find_hyper_expr_id_for_span_ref(&lo3, e.span)
            if hyper_expr_id >= 0 && hyper_expr_id < (*lo3.module).epistemic.hyper_expr_count {
                let info = (*lo3.module).epistemic.hyper_exprs[hyper_expr_id as usize]
                if info.op_kind == 1 && info.algebra_tag == 3 {
                    let lo4_h = lo3.emit(ir_hyper_mul_o(dst, lhs, rhs))
                    return (lo4_h, dst)
                }
            }
        }
        if wide_bits > 64 {
            if e.bin_op == BinaryOp::OpAdd {
                return (lo3.emit(ir_wide_add(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpSub {
                return (lo3.emit(ir_wide_sub(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpMul {
                return (lo3.emit(ir_wide_mul(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpDiv {
                return (lo3.emit(ir_wide_div_full(dst, lhs, rhs, limbs)), dst)
            } else if e.bin_op == BinaryOp::OpRem {
                return (lo3.emit(ir_wide_mod_full(dst, lhs, rhs, limbs)), dst)
            } else if cmp_op >= 0 {
                return (lo3.emit(ir_wide_cmp(dst, lhs, rhs, limbs, cmp_op)), dst)
            }
        }
        let lo4 = lo3.emit(ir_binop_typed(dst, lhs, e.bin_op, rhs, lhs_expr_is_float, rhs_expr_is_float))
        (lo4, dst)
    }

    fn lower_field_access_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base = pair_b.1
        let fidx = lo1.field_idx_for_base_ref(&e.left, e.name)
        let field_is_float = lo1.field_is_float_for_base_ref(&e.left, e.name) || lo1.field_is_float_by_name_simple(e.name)
        let field_array_elem_is_float = lo1.field_array_elem_is_float_for_base_ref(&e.left, e.name)
        let base_is_ref = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    lo1.lookup_local_is_ref((*base_expr_ref).name)
                } else {
                    false
                }
            }
            _ => false,
        }
        if lower_aggregate_diag_enabled() {
            print("lower_agg: field name=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" idx=")
            print_int(fidx)
            print(" field_float=")
            print_int(if field_is_float { 1 } else { 0 })
            print(" field_array_float=")
            print_int(if field_array_elem_is_float { 1 } else { 0 })
            print("\n")
        }
        if str_eq(read_env("SOUNIO_DUMP_LAYOUTS"), "1") {
            print("DUMP field=")
            print(str_from_bytes(e.name.buf, e.name.len))
            print(" idx=")
            print_int(fidx)
            print(" layouts.count=")
            print_int((*lo1.struct_layouts).count)
            print("\n")
            var di: i64 = 0
            while di < (*lo1.struct_layouts).count {
                print("  [")
                print_int(di)
                print("] ")
                print(str_from_bytes((*lo1.struct_layouts).entries[di as usize].type_name.buf, (*lo1.struct_layouts).entries[di as usize].type_name.len))
                print(" fc=")
                print_int((*lo1.struct_layouts).entries[di as usize].field_count)
                var dj: i64 = 0
                while dj < (*lo1.struct_layouts).entries[di as usize].field_count {
                    print(" ")
                    print(str_from_bytes((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].name.buf, (*lo1.struct_layouts).entries[di as usize].fields[dj as usize].name.len))
                    print(":")
                    print_int((*lo1.struct_layouts).entries[di as usize].fields[dj as usize].index)
                    dj = dj + 1
                }
                print("\n")
                di = di + 1
            }
        }
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        var instr = ir_field_get(dst, base, fidx, e.name)
        if base_is_ref {
            instr.label_id = 1
        }
        if field_is_float || field_array_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo3 = lo2.emit(instr)
        if instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo3 = lo3.emit(ir_mark_float_reg(dst))
        }
        if field_array_elem_is_float {
            lo3 = lo3.bind_reg_array_elem_float(dst)
        }
        (lo3, dst)
    }

    fn lower_index_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let index_elem_is_float_pre = self.index_base_elem_is_float_ref(&e.left)
        let global_elem_size = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    let global_fn_id = lowerer_lookup_fn_id_by_name_ref(&self, (*base_expr_ref).name)
                    if global_fn_id >= 0 && global_fn_id < self.module.fn_count
                        && self.module.functions[global_fn_id as usize].compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                        self.module.functions[global_fn_id as usize].hyper_algebra_kind
                    } else {
                        0
                    }
                } else {
                    0
                }
            }
            _ => 0,
        }
        let base_is_ref = match e.left {
            Some(base_expr_ref) => {
                if (*base_expr_ref).kind == ExprKind::ExprIdent {
                    self.lookup_local_is_ref((*base_expr_ref).name)
                } else {
                    false
                }
            }
            _ => false,
        }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base = pair_b.1
        let index_elem_is_float = index_elem_is_float_pre || lo1.lookup_reg_array_elem_float(base)
        if lower_aggregate_diag_enabled() {
            print("lower_agg: index pre=")
            print_int(if index_elem_is_float_pre { 1 } else { 0 })
            print(" reg=")
            print_int(if lo1.lookup_reg_array_elem_float(base) { 1 } else { 0 })
            print(" final=")
            print_int(if index_elem_is_float { 1 } else { 0 })
            print(" base=")
            print_int(base)
            print("\n")
        }
        let pair_i = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_i.0
        let idx = pair_i.1
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        var instr = ir_index_get(dst, base, idx)
        if global_elem_size > 0 {
            instr.label_id = if global_elem_size == 1 { 3 } else { 2 }
        } else if base_is_ref {
            instr.label_id = 1
        }
        if index_elem_is_float {
            instr.imm_flags = IR_FLOAT_REG_MARKER_FLAG
        }
        var lo4 = lo3.emit(instr)
        if index_elem_is_float {
            lo4 = lo4.emit(ir_mark_float_reg(dst))
        }
        (lo4, dst)
    }

    fn lower_array_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        match e.left {
            Some(_) => self.lower_array_repeat_literal_ref(e),
            None => {
                let elem_is_float = lower_expr_is_f64_array_literal_ref(e)
                let pair_dst = self.fresh_reg()
                var lo = pair_dst.0
                let dst = pair_dst.1
                let arr_lit_count = count_expr_list_ref(&e.args)
                lo = lo.emit(ir_alloc_array(dst, lo.aggregate_storage_bytes(arr_lit_count), arr_lit_count))
                lo = lo.lower_array_elems_ref(dst, &e.args, 0)
                if elem_is_float {
                    lo = lo.emit(ir_mark_float_reg(dst))
                    lo = lo.bind_reg_array_elem_float(dst)
                }
                (lo, dst)
            }
        }
    }

    fn lower_cast_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub.0
        let src_reg = sub.1
        let wide_bits = lower_opt_type_wide_bits(&e.cast_type)
        let source_is_float = lo1.opt_expr_result_is_float_ref(&e.left)
        if wide_bits > 64 {
            let limbs = lower_wide_limb_count(wide_bits)
            let p = lo1.fresh_wide_reg(limbs)
            var lo2 = p.0
            let dst = p.1
            lo2 = lo2.emit(ir_copy(dst, src_reg))
            var wi: i64 = 1
            while wi < limbs {
                lo2 = lo2.emit(ir_load_imm(dst + wi, 0))
                wi = wi + 1
            }
            (lo2, dst)
        } else if lower_cast_type_is_f64(&e.cast_type) {
            if source_is_float {
                return (lo1, src_reg)
            }
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_int_to_float(dst, src_reg)), dst)
        } else if source_is_float || lower_opt_expr_has_float_source(&e.left) {
            let p = lo1.fresh_reg()
            let lo2 = p.0
            let dst = p.1
            (lo2.emit(ir_float_to_int(dst, src_reg)), dst)
        } else {
            (lo1, src_reg)
        }
    }

    fn lower_unary_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // `*b` where b is a Box reads field 0 of the heap object (where lower_box_new
        // stored the value via ir_field_set(ptr, 0, val)), so route Box deref to
        // IrFieldGet(0) — codegen resolves the handle. IrUnaryOp(OpDeref) stays a raw
        // pointer load for true references (&T), which are raw addresses, not handles.
        let is_box_deref = if e.un_op == UnaryOp::OpDeref {
            let opt_ref = &e.left
            match *opt_ref {
                Some(operand) => {
                    if (*operand).kind == ExprKind::ExprIdent {
                        ir_name_is_box(self.lookup_local_struct_type((*operand).name))
                    } else {
                        false
                    }
                }
                None => false,
            }
        } else {
            false
        }
        let pair_s = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_s.0
        let src = pair_s.1
        let src_is_float = if e.un_op == UnaryOp::OpNeg {
            lo1.opt_expr_result_is_float_ref(&e.left)
        } else {
            false
        }
        let pair_d = lo1.fresh_reg()
        let lo2 = pair_d.0
        let dst = pair_d.1
        var lo3 = if is_box_deref {
            lo2.emit(ir_field_get(dst, src, 0, ir_empty_name()))
        } else {
            lo2.emit(ir_unaryop(dst, e.un_op, src))
        }
        if src_is_float {
            lo3 = lo3.emit(ir_mark_float_reg(dst))
        }
        (lo3, dst)
    }

    // Receiver struct type for a method call, when the receiver is a simple local
    // (e.g. `c.method()` -> type of `c`). Used to mangle the call to the same name the
    // impl method was registered under. Empty when the type can't be determined here.
    fn lower_method_recv_type(self, left: &Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match *left {
            Some(recv) => {
                if (*recv).kind == ExprKind::ExprIdent {
                    return self.lookup_local_struct_type((*recv).name)
                }
                // Primitive-receiver fallback for a non-ident scalar receiver such
                // as an array element `a.c[i]` (the imported cd_exact lane calls
                // `a.c[i].er_add(b.c[i])`). Such a receiver has no local struct
                // type, so the bare method name would bind to a body-less fn and
                // crash codegen. A monomorphized `[i64;N]` field registers with no
                // positive i64 marker, so classify float positively (f64$m) and map
                // every other primitive-scalar index to i64$m — matching the symbol
                // emitted for `impl ExactRing for i64`. No corpus test dispatches a
                // method on a STRUCT array element, so this cannot misroute a green
                // struct-method call (those already fail today at the empty-name path).
                if (*recv).kind == ExprKind::ExprIndex {
                    if self.index_base_elem_is_float_ref(&(*recv).left) {
                        return make_name("f64")
                    }
                    return make_name("i64")
                }
                ir_empty_name()
            }
            _ => ir_empty_name()
        }
    }

    fn lower_method_call_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Impl methods are lowered as mangled free functions (ir_mangle_method_name).
        // A `recv.method()` call must resolve to that SAME mangled name; using the bare
        // method name finds/creates a body-less fn -> codegen crash.
        let recv_type = self.lower_method_recv_type(&e.left)
        let call_name = if recv_type.len > 0 { ir_mangle_method_name(recv_type, e.name) } else { e.name }
        let pair_b = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_b.0
        let base_reg = pair_b.1
        let pair_args: LowerExprArgsResult = lo1.lower_expr_args_ref(&e.args)
        let lo2 = pair_args.lowerer
        let arg_list: Option<Box<IrRegList>> = if pair_args.count <= 0 { None } else { Some(Box::new(pair_args.regs)) }
        let arg_count = pair_args.count
        let args2 = lo2.prepend_arg(base_reg, arg_list)
        let pair_fn = lo2.find_or_add_fn_id(call_name)
        let lo3 = pair_fn.0
        let fn_id = pair_fn.1
        let pair_call = lo3.ir_lower_prepend_validated_arg(fn_id, args2, arg_count + 1)
        let lo4 = pair_call.lo
        let final_args = pair_call.args
        let final_argc = pair_call.argc
        let pair_d = lo4.fresh_reg()
        let lo5 = pair_d.0
        let dst = pair_d.1
        var call_instr_m = ir_call(dst, fn_id, call_name, final_args, final_argc)
        if fn_id >= 0 && fn_id < (*lo5.module).fn_count {
            if (*lo5.module).functions[fn_id as usize].returns_float == 1 {
                call_instr_m.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        var lo6 = lo5.emit(call_instr_m)
        if call_instr_m.imm_flags == IR_FLOAT_REG_MARKER_FLAG {
            lo6 = lo6.emit(ir_mark_float_reg(dst))
        }
        (lo6, dst)
    }

    fn lower_if_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Type the merge register as a true JOIN of the two arms. Native codegen
        // is flow-insensitive (the if-merge res inherits whichever ir_copy is last
        // in linear order — the else arm), so an f64 if-expr whose else arm is an
        // int-flagged value (e.g. an f64 literal via IrLoadImm) would otherwise
        // leave res untyped and a downstream float consumer cvtsi2sd-corrupts it.
        let res_is_float = self.expr_result_is_float_ref(e)
        let pair_cond = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_cond.0
        let cond = pair_cond.1

        let pair_l_else = lo1.fresh_label()
        let lo2 = pair_l_else.0
        let l_else = pair_l_else.1
        let pair_l_end = lo2.fresh_label()
        let lo3 = pair_l_end.0
        let l_end = pair_l_end.1
        let pair_res = lo3.fresh_reg()
        let lo4 = pair_res.0
        let res = pair_res.1

        var lo = lo4.emit(ir_branch_false(cond, l_else))

        let then_block_opt: Option<Box<Block>> = e.block
        let pair_then = match then_block_opt {
            Some(blk) => lo.lower_block_ref(&(*blk)),
            None => lo.emit_unit(),
        }
        lo = pair_then.0
        let then_reg = pair_then.1
        lo = lo.emit(ir_copy(res, then_reg))
        lo = lo.emit(ir_jump(l_end))
        lo = lo.emit(ir_label(l_else))

        let else_expr_opt: Option<Box<Expr>> = e.else_expr
        let pair_else = match else_expr_opt {
            Some(ee) => lo.lower_expr_ref(&(*ee)),
            None => lo.emit_unit(),
        }
        lo = pair_else.0
        let else_reg = pair_else.1
        lo = lo.emit(ir_copy(res, else_reg))
        lo = lo.emit(ir_label(l_end))
        if res_is_float {
            lo = lo.emit(ir_mark_float_reg(res))
        }
        (lo, res)
    }

    fn lower_match_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_scrut = self.lower_opt_expr_ref(&e.left)
        var lo = pair_scrut.0
        let scrut = pair_scrut.1
        let pair_res = lo.fresh_reg()
        lo = pair_res.0
        let res = pair_res.1
        let pair_end = lo.fresh_label()
        lo = pair_end.0
        let l_end = pair_end.1
        lo = lo.lower_match_arms_ref(scrut, res, l_end, &e.arms)
        lo = lo.emit(ir_load_imm(res, 0))
        lo = lo.emit(ir_label(l_end))
        (lo, res)
    }

    fn lower_while_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        let pair_cond = lo.lower_opt_expr_ref(&e.left)
        lo = pair_cond.0
        let cond = pair_cond.1
        lo = lo.emit(ir_branch_false(cond, l_end))
        lo = lo.push_loop_labels(l_top, l_end)
        let while_block_opt: Option<Box<Block>> = e.block
        match while_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_loop_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l_top = self.fresh_label()
        let lo1 = pair_l_top.0
        let l_top = pair_l_top.1
        let pair_l_end = lo1.fresh_label()
        let lo2 = pair_l_end.0
        let l_end = pair_l_end.1

        var lo = lo2.emit(ir_label(l_top))
        lo = lo.push_loop_labels(l_top, l_end)
        let loop_block_opt: Option<Box<Block>> = e.block
        match loop_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_for_in_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Desugar `for i in start..end { body }` into the working while-loop IR:
        //   i = start
        //   l_top:  if !(i < end) goto l_end      // i <= end for inclusive ranges
        //           body
        //   l_cont: i = i + 1                      // continue target + fallthrough
        //           goto l_top
        //   l_end:
        // Only integer range iterables (ExprRange) are supported; any other
        // iterable reports an error rather than silently miscompiling.
        let iter_opt: Option<Box<Expr>> = e.left
        match iter_opt {
            Some(iter_box) => {
                if (*iter_box).kind != ExprKind::ExprRange {
                    // Non-range iterable: only a bare LOCAL array identifier is
                    // supported (e.g. `for v in arr`). Anything else (ref/deref,
                    // non-ident, field access) falls back to a clean report_error
                    // rather than miscompiling or crashing.
                    return self.lower_for_in_array_ref(e, &(*iter_box))
                }
                // Half-open ranges (`for i in 0..`) have no end bound; the loop
                // condition would compare against an invalid register. Reject rather
                // than silently miscompile.
                match (*iter_box).right {
                    None => return (self.report_error(), IR_INVALID_REG),
                    _ => {}
                }
                let pair_start = self.lower_opt_expr_ref(&(*iter_box).left)
                var lo = pair_start.0
                let start_reg = pair_start.1
                let pair_iv = lo.fresh_reg()
                lo = pair_iv.0
                let iv = pair_iv.1
                lo = lo.emit(ir_copy(iv, start_reg))
                lo = lo.bind_local(e.name, iv, true)

                let pair_end = lo.lower_opt_expr_ref(&(*iter_box).right)
                lo = pair_end.0
                let end_reg = pair_end.1

                let pair_top = lo.fresh_label()
                lo = pair_top.0
                let l_top = pair_top.1
                let pair_cont = lo.fresh_label()
                lo = pair_cont.0
                let l_cont = pair_cont.1
                let pair_end_lbl = lo.fresh_label()
                lo = pair_end_lbl.0
                let l_end = pair_end_lbl.1

                lo = lo.emit(ir_label(l_top))
                let cmp_op = if (*iter_box).bin_op == BinaryOp::OpRangeInclusive { BinaryOp::OpLe } else { BinaryOp::OpLt }
                let pair_cond = lo.fresh_reg()
                lo = pair_cond.0
                let cond = pair_cond.1
                lo = lo.emit(ir_binop(cond, iv, cmp_op, end_reg))
                lo = lo.emit(ir_branch_false(cond, l_end))

                lo = lo.push_loop_labels(l_cont, l_end)
                let for_block_opt: Option<Box<Block>> = e.block
                match for_block_opt {
                    Some(blk) => {
                        let pair_body = lo.lower_block_ref(&(*blk))
                        lo = pair_body.0
                    }
                    None => {}
                }
                lo = lo.pop_loop_labels()

                lo = lo.emit(ir_label(l_cont))
                let pair_one = lo.fresh_reg()
                lo = pair_one.0
                let one_reg = pair_one.1
                lo = lo.emit(ir_load_imm(one_reg, 1))
                let pair_next = lo.fresh_reg()
                lo = pair_next.0
                let next_reg = pair_next.1
                lo = lo.emit(ir_binop(next_reg, iv, BinaryOp::OpAdd, one_reg))
                lo = lo.emit(ir_copy(iv, next_reg))
                lo = lo.emit(ir_jump(l_top))
                lo = lo.emit(ir_label(l_end))
                lo.emit_unit()
            }
            None => (self.report_error(), IR_INVALID_REG),
        }
    }

    fn lower_for_in_array_ref(self, e: &Expr, iter: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        // Desugar `for v in arr { body }` over a bare LOCAL array into the working
        // while-loop IR, using a runtime element count read from the object header
        // (IrArrayLen) — NO LowerLocalStack growth, NO per-local length column:
        //   iv = 0
        //   len = array_len(arr)
        //   l_top:  if !(iv < len) goto l_end
        //           v = arr[iv]                       // IndexGet
        //           body
        //   l_cont: iv = iv + 1                       // continue target
        //           goto l_top
        //   l_end:
        // Only a bare local-array identifier is accepted; refs/derefs/non-idents
        // report_error (clean fallback) so we never crash or silently miscompile.
        if (*iter).kind != ExprKind::ExprIdent {
            return (self.report_error(), IR_INVALID_REG)
        }
        if self.lookup_local_is_ref((*iter).name) {
            return (self.report_error(), IR_INVALID_REG)
        }
        var lo = self
        let base_reg = lo.lookup_local((*iter).name)
        if base_reg == IR_INVALID_REG {
            return (lo.report_error(), IR_INVALID_REG)
        }

        // iv = 0
        let pair_iv = lo.fresh_reg()
        lo = pair_iv.0
        let iv = pair_iv.1
        lo = lo.emit(ir_load_imm(iv, 0))

        // len = element count of the array (payload_size_bytes >> 3)
        let pair_len = lo.fresh_reg()
        lo = pair_len.0
        let len_reg = pair_len.1
        lo = lo.emit(ir_array_len(len_reg, base_reg))

        let pair_top = lo.fresh_label()
        lo = pair_top.0
        let l_top = pair_top.1
        let pair_cont = lo.fresh_label()
        lo = pair_cont.0
        let l_cont = pair_cont.1
        let pair_end_lbl = lo.fresh_label()
        lo = pair_end_lbl.0
        let l_end = pair_end_lbl.1

        lo = lo.emit(ir_label(l_top))
        let pair_cond = lo.fresh_reg()
        lo = pair_cond.0
        let cond = pair_cond.1
        lo = lo.emit(ir_binop(cond, iv, BinaryOp::OpLt, len_reg))
        lo = lo.emit(ir_branch_false(cond, l_end))

        // v = arr[iv]
        let pair_v = lo.fresh_reg()
        lo = pair_v.0
        let v_reg = pair_v.1
        lo = lo.emit(ir_index_get(v_reg, base_reg, iv))
        lo = lo.bind_local(e.name, v_reg, true)

        lo = lo.push_loop_labels(l_cont, l_end)
        let for_block_opt: Option<Box<Block>> = e.block
        match for_block_opt {
            Some(blk) => {
                let pair_body = lo.lower_block_ref(&(*blk))
                lo = pair_body.0
            }
            None => {}
        }
        lo = lo.pop_loop_labels()

        // iv = iv + 1
        lo = lo.emit(ir_label(l_cont))
        let pair_one = lo.fresh_reg()
        lo = pair_one.0
        let one_reg = pair_one.1
        lo = lo.emit(ir_load_imm(one_reg, 1))
        let pair_next = lo.fresh_reg()
        lo = pair_next.0
        let next_reg = pair_next.1
        lo = lo.emit(ir_binop(next_reg, iv, BinaryOp::OpAdd, one_reg))
        lo = lo.emit(ir_copy(iv, next_reg))
        lo = lo.emit(ir_jump(l_top))
        lo = lo.emit(ir_label(l_end))
        lo.emit_unit()
    }

    fn lower_block_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let block_opt: Option<Box<Block>> = e.block
        match block_opt {
            Some(blk) => self.lower_block_ref(&(*blk)),
            None => self.emit_unit(),
        }
    }

    fn lower_return_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        let lo = pair.0
        let reg = pair.1
        let lo2 = lo.emit(ir_return(reg))
        (lo2, reg)
    }

    fn lower_break_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_opt_expr_ref(&e.left)
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_break_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error()
        }
        (lo, reg)
    }

    fn lower_continue_expr_ref(self) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.emit_unit()
        var lo = pair.0
        let reg = pair.1
        let target = lo.current_continue_label()
        if target >= 0 {
            lo = lo.emit(ir_jump(target))
        } else {
            lo = lo.report_error()
        }
        (lo, reg)
    }

    fn lower_struct_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        if lo.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: struct_lit_alloc dst=")
            print_int(dst)
            print("\n")
        }
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_struct_fields_ref(&e.fields))))
        lo = lo.ensure_struct_literal_layout_ref(ir_path_first_name(e.path), &e.fields)
        lo = lo.lower_struct_fields_ref(dst, ir_path_first_name(e.path), &e.fields, 0)
        (lo, dst)
    }

    fn lower_tuple_literal_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_dst = self.fresh_reg()
        var lo = pair_dst.0
        let dst = pair_dst.1
        lo = lo.emit(ir_alloc(dst, lo.aggregate_storage_bytes(count_expr_list_ref(&e.args))))
        lo = lo.lower_array_elems_ref(dst, &e.args, 0)
        (lo, dst)
    }

    fn lower_range_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let pair_l = self.lower_opt_expr_ref(&e.left)
        let lo1 = pair_l.0
        let lhs = pair_l.1
        let pair_r = lo1.lower_opt_expr_ref(&e.right)
        let lo2 = pair_r.0
        let rhs = pair_r.1
        let pair_d = lo2.fresh_reg()
        let lo3 = pair_d.0
        let dst = pair_d.1
        let lo4 = lo3.emit(ir_binop(dst, lhs, e.bin_op, rhs))
        (lo4, dst)
    }

    fn lower_contest_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        let sub_pair = self.lower_opt_expr_ref(&e.left)
        let lo1 = sub_pair.0
        let subject_reg = sub_pair.1
        let model_count = count_expr_list_ref(&e.args)
        let dst_pair = lo1.fresh_reg()
        let lo2 = dst_pair.0
        let dst_reg = dst_pair.1
        let contest_id = lo2.find_contest_id_for_span(e.span)
        let lo3 = lo2.emit(ir_contest(dst_reg, subject_reg, model_count, contest_id))
        (lo3, dst_reg)
    }

    fn lower_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        if self.probe_mode && lower_body_diag_enabled() {
            print("lower_probe: expr_kind=")
            if e.kind == ExprKind::ExprIntLit { print("int") }
            else if e.kind == ExprKind::ExprFloatLit { print("float") }
            else if e.kind == ExprKind::ExprBoolTrue { print("bool_true") }
            else if e.kind == ExprKind::ExprBoolFalse { print("bool_false") }
            else if e.kind == ExprKind::ExprStringLit { print("string") }
            else if e.kind == ExprKind::ExprCharLit { print("char") }
            else if e.kind == ExprKind::ExprIdent { print("ident") }
            else if e.kind == ExprKind::ExprCall { print("call") }
            else if e.kind == ExprKind::ExprBinary { print("binary") }
            else if e.kind == ExprKind::ExprUnary { print("unary") }
            else if e.kind == ExprKind::ExprFieldAccess { print("field") }
            else if e.kind == ExprKind::ExprIndex { print("index") }
            else if e.kind == ExprKind::ExprIf { print("if") }
            else if e.kind == ExprKind::ExprWhile { print("while") }
            else if e.kind == ExprKind::ExprReturn { print("return") }
            else if e.kind == ExprKind::ExprBreak { print("break") }
            else if e.kind == ExprKind::ExprContinue { print("continue") }
            else if e.kind == ExprKind::ExprStructLit { print("struct_lit") }
            else if e.kind == ExprKind::ExprArrayLit { print("array_lit") }
            else if e.kind == ExprKind::ExprTupleLit { print("tuple_lit") }
            else if e.kind == ExprKind::ExprBlock { print("block") }
            else if e.kind == ExprKind::ExprLoop { print("loop") }
            else if e.kind == ExprKind::ExprForIn { print("for_in") }
            else { print("other") }
            print("\n")
        }
        if e.kind == ExprKind::ExprIntLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprFloatLit {
            self.emit_f64_const(e.float_val)
        } else if e.kind == ExprKind::ExprBoolTrue {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, true))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprBoolFalse {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_bool(reg, false))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprStringLit {
            let lit_name = ir_normalize_string_literal_name(e.name)
            let pair_idx = self.intern_string(lit_name)
            let lo1 = pair_idx.0
            let idx = pair_idx.1
            let pair_reg = lo1.fresh_reg()
            let lo2 = pair_reg.0
            let reg = pair_reg.1
            let lo3 = lo2.emit(ir_load_string(reg, idx, lit_name))
            (lo3, reg)
        } else if e.kind == ExprKind::ExprCharLit {
            let pair = self.fresh_reg()
            let lo = pair.0
            let reg = pair.1
            let lo2 = lo.emit(ir_load_imm(reg, e.int_val))
            (lo2, reg)
        } else if e.kind == ExprKind::ExprIdent {
            // Check for None (null pointer for Option)
            if ir_name_is_none(e.name) {
                let pair = self.fresh_reg()
                let lo = pair.0
                let reg = pair.1
                let lo2 = lo.emit(ir_load_imm(reg, 0))
                return (lo2, reg)
            }
            let src = self.lookup_local(e.name)
            if src >= 0 {
                // Closures step 2: a capturing closure used as a VALUE (passed to a fn,
                // returned, aliased) would lose its captures — the synthetic fn has leading
                // capture params the receiver can't fill — yielding a silent wrong result.
                // Reject loudly instead. (Direct calls are handled in lower_call_expr_ref
                // before reaching here, so this only fires for non-callee uses.)
                if self.lookup_local_closure_fn_id(e.name) >= 0 {
                    print("error: capturing closure cannot be used as a value (escaping closures are not yet supported); only a direct call of the closure is allowed\n")
                    let loe = self.report_fatal_lowering_error()
                    return (loe, 0)
                }
                (self, src)
            } else {
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, e.name)
                if fn_id >= 0 && fn_id < self.module.fn_count {
                    let fn_strategy = self.module.functions[fn_id as usize].compile_strategy
                    if fn_strategy == IR_STRATEGY_BSS_GLOBAL {
                        let bss_off = self.module.functions[fn_id as usize].param_count
                        let gsize = self.module.functions[fn_id as usize].bss_size
                        let ref_pair = self.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        var lo3 = lo2
                        if gsize > 8 {
                            lo3 = lo2.emit(ir_load_imm(ref_reg, BSS_BASE_LINUX + bss_off))
                        } else {
                            lo3 = lo2.emit(ir_load_global(ref_reg, bss_off, e.name))
                        }
                        (lo3, ref_reg)
                    } else {
                        let ref_pair = self.fresh_reg()
                        let lo2 = ref_pair.0
                        let ref_reg = ref_pair.1
                        let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                        (lo3, ref_reg)
                    }
                } else {
                    if self.probe_mode && lower_body_diag_enabled() {
                        print("lower_probe: ident_miss name=")
                        print(str_from_bytes(e.name.buf, e.name.len))
                        print(" scope=")
                        print_int(self.scope_depth)
                        print(" local_count=")
                        print_int(self.locals.count)
                        print("\n")
                    }
                    let loe = self.report_error()
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprPath {
            // Check if this is an enum variant reference (e.g., IrOpcode::IrLoadImm)
            if e.path.seg_count >= 2 {
                let variant_name = ir_path_last_name(e.path)
                // Check for None (Option::None)
                if ir_name_is_none(variant_name) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
                let disc = self.lookup_variant_discriminant(variant_name)
                if disc >= 0 {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, disc))
                    return (lo2, reg)
                }
            }
            // Check for single-segment None
            if e.path.seg_count == 1 {
                let n = ir_path_first_name(e.path)
                if ir_name_is_none(n) {
                    let pair = self.fresh_reg()
                    let lo = pair.0
                    let reg = pair.1
                    let lo2 = lo.emit(ir_load_imm(reg, 0))
                    return (lo2, reg)
                }
            }
            // Not an enum variant — try local variable lookup
            let n = ir_path_first_name(e.path)
            let src = self.lookup_local(n)
            if src >= 0 {
                (self, src)
            } else {
                // Sprint 228: Check if this is a function name used as a first-class value
                let fn_id = lowerer_lookup_fn_id_by_name_ref(&self, n)
                if fn_id >= 0 {
                    let ref_pair = self.fresh_reg()
                    let lo2 = ref_pair.0
                    let ref_reg = ref_pair.1
                    let lo3 = lo2.emit(ir_load_fn_ref(ref_reg, fn_id))
                    (lo3, ref_reg)
                } else {
                    let loe = self.report_error()
                    loe.emit_unit()
                }
            }
        } else if e.kind == ExprKind::ExprCall {
            self.lower_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprBinary {
            self.lower_binary_expr_ref(e)
        } else if e.kind == ExprKind::ExprUnary {
            self.lower_unary_expr_ref(e)
        } else if e.kind == ExprKind::ExprFieldAccess {
            self.lower_field_access_expr_ref(e)
        } else if e.kind == ExprKind::ExprIndex {
            self.lower_index_expr_ref(e)
        } else if e.kind == ExprKind::ExprMethodCall {
            self.lower_method_call_expr_ref(e)
        } else if e.kind == ExprKind::ExprIf {
            self.lower_if_expr_ref(e)
        } else if e.kind == ExprKind::ExprMatch {
            self.lower_match_expr_ref(e)
        } else if e.kind == ExprKind::ExprWhile {
            self.lower_while_expr_ref(e)
        } else if e.kind == ExprKind::ExprLoop {
            self.lower_loop_expr_ref(e)
        } else if e.kind == ExprKind::ExprForIn {
            self.lower_for_in_expr_ref(e)
        } else if e.kind == ExprKind::ExprBlock {
            self.lower_block_expr_ref(e)
        } else if e.kind == ExprKind::ExprReturn {
            self.lower_return_expr_ref(e)
        } else if e.kind == ExprKind::ExprBreak {
            self.lower_break_expr_ref(e)
        } else if e.kind == ExprKind::ExprContinue {
            self.lower_continue_expr_ref()
        } else if e.kind == ExprKind::ExprStructLit {
            self.lower_struct_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprArrayLit {
            self.lower_array_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprTupleLit {
            self.lower_tuple_literal_expr_ref(e)
        } else if e.kind == ExprKind::ExprRange {
            self.lower_range_expr_ref(e)
        } else if e.kind == ExprKind::ExprCast {
            self.lower_cast_expr_ref(e)
        } else if e.kind == ExprKind::ExprContest {
            self.lower_contest_expr_ref(e)
        } else if e.kind == ExprKind::ExprAuditAttach {
            // Named audit attachment is compile-time metadata only; runtime lowering is transparent.
            self.lower_opt_expr_ref(&e.left)
        } else if e.kind == ExprKind::ExprClosure {
            // Sprint 228: Lambda-lift closure to a top-level synthetic function.
            // Non-capturing closures become plain functions; captures are TBD (Phase 2).
            self.lower_closure_expr_ref(e)
        } else {
            let loe = self.report_error()
            loe.emit_unit()
        }
    }

    // Sprint 228: Generate a unique closure function name: __closure_<N>
    fn make_closure_name(self) -> Name with Mut, Panic, Div {
        var n = ir_empty_name()
        // "__closure_"
        n.buf[0] = 95    // '_'
        n.buf[1] = 95    // '_'
        n.buf[2] = 99    // 'c'
        n.buf[3] = 108   // 'l'
        n.buf[4] = 111   // 'o'
        n.buf[5] = 115   // 's'
        n.buf[6] = 117   // 'u'
        n.buf[7] = 114   // 'r'
        n.buf[8] = 101   // 'e'
        n.buf[9] = 95    // '_'
        n.len = 10
        // Append fn_count as suffix for uniqueness
        let suffix = self.module.fn_count
        if suffix < 10 {
            n.buf[10] = (48 + suffix) as i8
            n.len = 11
        } else if suffix < 100 {
            n.buf[10] = (48 + suffix / 10) as i8
            n.buf[11] = (48 + suffix % 10) as i8
            n.len = 12
        } else if suffix < 1000 {
            n.buf[10] = (48 + suffix / 100) as i8
            n.buf[11] = (48 + (suffix / 10) % 10) as i8
            n.buf[12] = (48 + suffix % 10) as i8
            n.len = 13
        } else {
            n.buf[10] = (48 + suffix / 1000) as i8
            n.buf[11] = (48 + (suffix / 100) % 10) as i8
            n.buf[12] = (48 + (suffix / 10) % 10) as i8
            n.buf[13] = (48 + suffix % 10) as i8
            n.len = 14
        }
        n
    }

    // Sprint 228: Lambda-lift a closure expression into a synthetic top-level function.
    // Returns (Lowerer, fn_ref_reg) where fn_ref_reg holds the fn_id.
    // Recursive free-variable scan (closures step 2): collect idents in `body` that resolve
    // as enclosing locals and are not closure params (= captures). Self-recursive; uses
    // self.lookup_local for the enclosing scope (no &LowerLocalStack arg).
    fn scan_captures_expr(self, body: &Expr, params: &Option<Box<ClosureParamList>>, caps: CaptureList) -> CaptureList with Mut, Panic, Div, Alloc {
        var c = caps
        if (*body).kind == ExprKind::ExprIdent {
            let nm = (*body).name
            if !lower_name_in_closure_params(params, nm) {
                let r = self.lookup_local(nm)
                if r >= 0 { c = capture_list_add(c, nm, r) }
            }
            return c
        }
        match (*body).left {
            Some(l) => { c = self.scan_captures_expr(&(*l), params, c) }
            _ => {}
        }
        match (*body).right {
            Some(r) => { c = self.scan_captures_expr(&(*r), params, c) }
            _ => {}
        }
        match (*body).else_expr {
            Some(eo) => { c = self.scan_captures_expr(&(*eo), params, c) }
            _ => {}
        }
        var cur = &(*body).args
        while true {
            match *cur {
                Some(el) => {
                    c = self.scan_captures_expr(&(*el).head, params, c)
                    cur = &(*el).tail
                }
                _ => break
            }
        }
        c
    }
    fn scan_captures_opt(self, body: &Option<Box<Expr>>, params: &Option<Box<ClosureParamList>>, caps: CaptureList) -> CaptureList with Mut, Panic, Div, Alloc {
        match *body {
            Some(b) => { self.scan_captures_expr(&(*b), params, caps) }
            _ => { caps }
        }
    }

    // Index of the closure-capture entry for `fn_id` (-1 if none). Method form avoids
    // passing &(*self.closure_caps) (ref of a deref of a field-accessed Box), which the
    // parser rejects.
    fn find_closure_cap_idx(self, fn_id: i64) -> i64 with Mut, Panic, Div, Alloc {
        var i: i64 = 0
        while i < (*self.closure_caps).count {
            if (*self.closure_caps).entries[i as usize].fn_id == fn_id { return i }
            i = i + 1
        }
        -1
    }

    // Record a capturing closure's captured enclosing regs, keyed by its synthetic fn_id.
    // Copy-modify-writeback on the whole table (like bind_local_struct_type) — no
    // &!ClosureCapTable free-function param.
    fn record_closure_caps(self, fn_id: i64, caps: CaptureList) -> Lowerer with Mut, Panic, Div, Alloc {
        var lo = self
        var tbl = *lo.closure_caps
        if tbl.count < 256 {
            let idx = tbl.count
            var e = ClosureCapEntry { fn_id: fn_id, cap_count: caps.count, caps: [IR_INVALID_REG; 8] }
            var i: i64 = 0
            while i < caps.count {
                e.caps[i as usize] = caps.regs[i as usize]
                i = i + 1
            }
            tbl.entries[idx as usize] = e
            tbl.count = idx + 1
            lo.closure_caps = Box::new(tbl)
        }
        lo
    }

    fn lower_closure_expr_ref(self, e: &Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        var lo = self
        // 1. Create a unique name and register the synthetic function. Use the *mut
        // find_or_add (like regular calls): the functional find_or_add_fn_id ADD path
        // builds + returns a 128 KB IrFunction by value, which the by-value-aggregate
        // miscompile turned into a lowering SIGSEGV.
        let closure_name = lo.make_closure_name()
        let closure_fn_id = lowerer_find_or_add_fn_id_mut(&! lo, closure_name)

        if closure_fn_id < 0 {
            return lo.emit_unit()
        }

        // 2. Save current function context
        let saved_fn = lo.current_fn
        let saved_func = lo.current_func
        let saved_locals = lo.locals
        let saved_scope = lo.scope_depth
        let saved_loop = lo.loop_depth
        let saved_loaded = lo.current_func_loaded
        let saved_allow_direct_capture = lo.allow_direct_capturing_closure_literal

        // 2b. Scan the closure body for captured free variables (idents bound in the
        // enclosing scope, not lambda params) BEFORE wiping locals. Captures become LEADING
        // params on the synthetic fn and are injected at the (direct) call site.
        var captures = empty_capture_list()
        captures = lo.scan_captures_opt(&e.closure_body, &e.closure_params, captures)
        if captures.count > 0 {
            if !lo.allow_direct_capturing_closure_literal {
                print("error: native-v2 capturing closure literals are not yet supported as values; bind and call directly, use a named function, or use a noncapturing closure\n")
                let loe = lo.report_fatal_lowering_error()
                return loe.emit_unit()
            }
        }

        // 3. Switch to the closure function context. current_func_loaded MUST be true so
        // the functional lowering (current_fn_validated_reg / param resolution) reads from
        // lo.current_func — not the empty module placeholder, which is what zeroed
        // param_count and produced a malformed closure body.
        lo.current_fn = closure_fn_id
        lo.current_func = Box::new(ir_empty_function())
        (*lo.current_func).name = closure_name
        lo.current_func_loaded = true
        lo.locals = Box::new(empty_lower_local_stack())
        lo.scope_depth = 0
        lo.loop_depth = 0
        lo.allow_direct_capturing_closure_literal = false

        // 3b. Bind captured variables as LEADING params of the synthetic fn, so the body's
        // free `k` resolves to a param (not 0). The captured enclosing regs themselves are
        // injected at the call site; here we only allocate param regs + bind the names.
        var ci: i64 = 0
        while ci < captures.count {
            let cap_pair = lo.fresh_reg()
            lo = cap_pair.0
            let cap_preg = cap_pair.1
            var cf_box_cap = lo.current_func
            if (*cf_box_cap).param_count < IR_MAX_PARAMS {
                let pcc = (*cf_box_cap).param_count
                (*cf_box_cap).param_regs[pcc as usize] = cap_preg
                (*cf_box_cap).param_count = pcc + 1
            }
            lo.current_func = cf_box_cap
            lo = lo.bind_local(captures.names[ci as usize], cap_preg, false)
            ci = ci + 1
        }

        // 4. Set up closure parameters from ClosureParamList
        var params: &Option<Box<ClosureParamList>> = &e.closure_params
        while true {
            match *params {
                Some(plist) => {
                    let preg_pair = lo.fresh_reg()
                    lo = preg_pair.0
                    let preg = preg_pair.1
                    // Extract the current_func Box to a local before mutating: the direct
                    // `(*lo.current_func).param_count = …` store (deref a field-accessed Box)
                    // is dropped by the by-value-aggregate miscompile — the same reason
                    // fresh_reg copies `lo.current_func` to a local first. Without this,
                    // param_count stayed 0, the codegen emitted no parameter prologue, and
                    // the closure SIGSEGV'd when called.
                    var cf_box = lo.current_func
                    if (*cf_box).param_count < IR_MAX_PARAMS {
                        let pc = (*cf_box).param_count
                        (*cf_box).param_regs[pc as usize] = preg
                        (*cf_box).param_count = pc + 1
                    }
                    lo.current_func = cf_box
                    lo = lo.bind_local((*plist).head.name, preg, false)
                    params = &(*plist).tail
                }
                _ => break
            }
        }

        // 5. Lower the closure body using the standard optional-expression path.
        let body_pair = lo.lower_opt_expr_ref(&e.closure_body)
        lo = body_pair.0
        lo = lo.emit(ir_return(body_pair.1))

        // 7. Flush the completed closure function back to the module. Extract the module
        // Box to a local first (as lowerer_flush_current_func_mut does) — the direct
        // `(*lo.module).functions[id] = …` store derefs a field-accessed Box and is
        // dropped/partial under the by-value-aggregate miscompile, which lost the body
        // instrs (the closure returned its param instead of the body's result).
        var flush_mod_box = lo.module
        (*flush_mod_box).functions[closure_fn_id as usize] = *lo.current_func
        lo.module = flush_mod_box

        // 8. Restore the original function context
        lo.current_fn = saved_fn
        lo.current_func = saved_func
        lo.current_func_loaded = saved_loaded
        lo.locals = saved_locals
        lo.scope_depth = saved_scope
        lo.loop_depth = saved_loop
        lo.allow_direct_capturing_closure_literal = saved_allow_direct_capture

        // 8b. For a capturing closure, record the captured ENCLOSING regs keyed by fn_id and
        // flag the pending closure so the let-binding marks its local. (Zero-capture closures
        // stay bare fn-refs — unchanged from #418.) Extract the Box to a local first.
        if captures.count > 0 {
            lo = lo.record_closure_caps(closure_fn_id, captures)
            lo.pending_closure_fn_id = closure_fn_id
        }

        // 9. In the original function, emit IrLoadFnRef to return the fn_id
        let ref_pair = lo.fresh_reg()
        lo = ref_pair.0
        let ref_reg = ref_pair.1
        lo = lo.emit(ir_load_fn_ref(ref_reg, closure_fn_id))
        (lo, ref_reg)
    }

    fn lower_expr(self, e: Expr) -> (Lowerer, i64) with Mut, Panic, Div, Alloc, IO {
        self.lower_expr_ref(&e)
    }
}

// Count struct field initializers in a StructFieldList
fn count_struct_fields_ref(fields: &Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = fields
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_struct_fields(fields: Option<Box<StructFieldList>>) -> i64 with Alloc, Mut, Div {
    count_struct_fields_ref(&fields)
}

// Count expression list elements (used for array/tuple literals)
fn count_expr_list_ref(elems: &Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    var count: i64 = 0
    var current = elems
    while true {
        match *current {
            Some(list) => {
                count = count + 1
                current = &(*list).tail
            }
            _ => break
        }
    }
    count
}

fn count_expr_list(elems: Option<Box<ExprList>>) -> i64 with Alloc, Mut, Div {
    count_expr_list_ref(&elems)
}

fn ir_reg_list_prepend(reg: i64, args: Option<Box<IrRegList>>) -> Option<Box<IrRegList>> with Alloc {
    Some(Box::new(IrRegList { head: reg, tail: args }))
}

fn ir_call_needs_validated_patch(
    fn_count: i64,
    callee_strategies: &[i64; 2048],
    callee_param_counts: &[i64; 2048],
    instr: IrInstr
) -> bool with Mut, Panic, Div {
    if instr.op != IrOpcode::IrCall { return false }
    if instr.fn_id < 0 || instr.fn_id >= fn_count { return false }
    callee_strategies[instr.fn_id as usize] == IR_STRATEGY_INSTRUMENTED &&
    instr.arg_count + 1 == callee_param_counts[instr.fn_id as usize]
}

fn ir_module_has_instrumented_strategy(module: &IrModule) -> bool with Panic, Div {
    var i: i64 = 0
    while i < module.fn_count {
        if module.functions[i as usize].compile_strategy == IR_STRATEGY_INSTRUMENTED {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_has_opcode(func: IrFunction, op: IrOpcode) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if func.instrs[i as usize].op == op {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_has_opcode_ref(func: &! IrFunction, op: IrOpcode) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if func.instrs[i as usize].op == op {
            return true
        }
        i = i + 1
    }
    false
}

fn ir_function_insert_instr_front(func: &! IrFunction, instr: IrInstr) -> bool with Mut, Panic, Div {
    if func.instr_count >= 127 {
        return false
    }
    var i = func.instr_count
    while i > 0 {
        func.instrs[i as usize] = func.instrs[(i - 1) as usize]
        i = i - 1
    }
    func.instrs[0] = instr
    func.instr_count = func.instr_count + 1
    true
}

fn ir_patch_validated_call_instr(instr: &! IrInstr, validated_reg: i64) with Mut, Panic, Div, Alloc {
    let patched_args = ir_reg_list_prepend(validated_reg, instr.call_args)
    let pair_regs = ir_reg_list_first_two(patched_args)
    instr.call_args = patched_args
    instr.arg_count = instr.arg_count + 1
    instr.src1 = pair_regs.0
    instr.src2 = pair_regs.1
}

fn ir_patch_validated_calls_in_function(
    fn_count: i64,
    callee_strategies: &[i64; 2048],
    callee_param_counts: &[i64; 2048],
    func: &! IrFunction,
    stats: &! IrValidatedPatchStats
) with Mut, Panic, Div, Alloc {
    if !ir_function_has_opcode_ref(func, IrOpcode::IrCall) {
        return
    }

    var needs_patch = false
    var patch_count: i64 = 0
    var shared_validated_reg = IR_INVALID_REG

    var scan_i: i64 = 0
    while scan_i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, func.instrs[scan_i as usize]) {
            needs_patch = true
            break
        }
        scan_i = scan_i + 1
    }
    if !needs_patch {
        return
    }

    if func.compile_strategy != IR_STRATEGY_INSTRUMENTED {
        shared_validated_reg = func.reg_count
        func.reg_count = func.reg_count + 1
        if ir_function_insert_instr_front(func, ir_load_imm(shared_validated_reg, 1)) {
            stats.fallback_insertions = stats.fallback_insertions + 1
        } else {
            return
        }
    }

    var i: i64 = 0
    while i < func.instr_count {
        if ir_call_needs_validated_patch(fn_count, callee_strategies, callee_param_counts, func.instrs[i as usize]) {
            let validated_reg = if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                func.param_regs[0]
            } else {
                shared_validated_reg
            }
            var instr = func.instrs[i as usize]
            ir_patch_validated_call_instr(&! instr, validated_reg)
            func.instrs[i as usize] = instr
            patch_count = patch_count + 1
        }
        i = i + 1
    }
    if patch_count > 0 {
        stats.patched_functions = stats.patched_functions + 1
        stats.patched_calls = stats.patched_calls + patch_count
    }
}

fn ir_patch_validated_calls(module: &! IrModule) -> IrValidatedPatchStats with Mut, Panic, Div, Alloc {
    var stats = ir_empty_validated_patch_stats()
    if !ir_module_has_instrumented_strategy(module) {
        return stats
    }

    var callee_strategies: [i64; 2048] = [IR_STRATEGY_STANDARD; 2048]
    var callee_param_counts: [i64; 2048] = [0; 2048]
    var i: i64 = 0
    while i < module.fn_count {
        callee_strategies[i as usize] = module.functions[i as usize].compile_strategy
        callee_param_counts[i as usize] = module.functions[i as usize].param_count
        i = i + 1
    }

    i = 0
    while i < module.fn_count {
        ir_patch_validated_calls_in_function(module.fn_count, &callee_strategies, &callee_param_counts, &! module.functions[i as usize], &! stats)
        i = i + 1
    }
    stats
}

fn lower_program_to_ir_staged_with_lowerer_box_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerBoxResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("preseed_begin")
    var lo2 = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    lower_monolithic_public_probe_boundary("preseed_done")
    if !lo2.had_error {
        lower_monolithic_public_probe_boundary("bodies_begin")
        lo2 = lo2.lower_program_bodies_ref(&prog.items)
        lower_monolithic_public_probe_boundary("bodies_done")
    } else {
        lower_monolithic_public_probe_boundary("bodies_skipped")
    }
    (*patch_stats) = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        lower_monolithic_public_probe_boundary("patch_begin")
        (*patch_stats) = ir_patch_validated_calls(&! lo2.module)
        lower_monolithic_public_probe_boundary("patch_done")
    } else {
        lower_monolithic_public_probe_boundary("patch_skipped")
    }
    lower_monolithic_public_probe_boundary("boxed_result_begin")
    IrLowerBoxResult {
        module: lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: (*patch_stats),
    }
}

fn lower_program_to_ir_staged_with_lowerer_trace_ref(
    lo: Lowerer,
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let boxed = lower_program_to_ir_staged_with_lowerer_box_trace_ref(lo, prog, patch_stats)
    lower_monolithic_public_probe_boundary("boxed_result_done")
    lower_monolithic_public_probe_boundary("boxed_unwrap_result_begin")
    IrLowerResult {
        module: *boxed.module,
        error_count: boxed.error_count,
        had_error: boxed.had_error,
        patch_stats: boxed.patch_stats,
    }
}

fn lower_program_to_ir_staged_with_lowerer_trace(
    lo: Lowerer,
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_staged_with_lowerer_trace_ref(lo, &prog, patch_stats)
}

fn lower_program_to_ir_trace_ref(
    prog: &Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("lowerer_new_begin")
    let lo = lowerer_new()
    lower_monolithic_public_probe_boundary("lowerer_new_done")
    lower_program_to_ir_staged_with_lowerer_trace_ref(lo, prog, patch_stats)
}

pub fn lower_program_to_ir_trace(
    prog: Program,
    patch_stats: &! IrValidatedPatchStats
) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_trace_ref(&prog, patch_stats)
}

fn lower_program_to_ir_ref(prog: &Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    var patch_stats = ir_empty_validated_patch_stats()
    lower_program_to_ir_trace_ref(prog, &! patch_stats)
}

pub fn lower_program_to_ir(prog: Program) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    lower_monolithic_public_probe_boundary("public_call_entry")
    lower_program_to_ir_ref(&prog)
}

fn lower_program_to_ir_summary_box_with_epistemic_ref(prog: &Program, epistemic: &IrEpistemicSection) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(epistemic)
    lowerer_preseed_program_items_mut(&! lo, &prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let inner = ir_program_summary_from_lowerer(lo)
    var summary_box = Box::new(ir_empty_program_summary())
    (*summary_box).module = inner.module
    (*summary_box).enum_variants = inner.enum_variants
    (*summary_box).struct_layouts = inner.struct_layouts
    (*summary_box).global_types = inner.global_types
    (*summary_box).probe_mode = inner.probe_mode
    IrProgramSummaryBoxResult {
        summary: summary_box,
        error_count: error_count,
        had_error: had_error,
    }
}

// Multi-module variant: preseeds external struct layouts before lowering own
// items, so cross-module `use lib::{PublicStruct}` then `s.x` resolves to the
// right field_idx.
fn lower_program_to_ir_summary_box_with_externs_ref(
    prog: &Program,
    programs: &! [Program; 256],
    program_count: i64,
    self_index: i64,
    epistemic: &IrEpistemicSection
) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(epistemic)
    var i: i64 = 0
    while i < program_count {
        if i != self_index {
            let ext_prog = (*programs)[i as usize]
            lowerer_preseed_external_struct_items_mut(&! lo, &ext_prog.items)
        }
        i = i + 1
    }
    lowerer_preseed_program_items_mut(&! lo, &prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let inner = ir_program_summary_from_lowerer(lo)
    var summary_box = Box::new(ir_empty_program_summary())
    (*summary_box).module = inner.module
    (*summary_box).enum_variants = inner.enum_variants
    (*summary_box).struct_layouts = inner.struct_layouts
    (*summary_box).global_types = inner.global_types
    (*summary_box).probe_mode = inner.probe_mode
    IrProgramSummaryBoxResult {
        summary: summary_box,
        error_count: error_count,
        had_error: had_error,
    }
}

fn lower_program_to_ir_summary_box_probe_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrProgramSummaryBoxResult with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_probe()
    var module = *lo.module
    module.epistemic = epistemic
    lo.module = Box::new(module)
    lo = lo.preseed_program_items_ref(&prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let summary = ir_program_summary_from_lowerer(lo)
    IrProgramSummaryBoxResult {
        summary: Box::new(summary),
        error_count: error_count,
        had_error: had_error,
    }
}

fn lower_program_to_ir_summary_box_into_ref(
    prog: &Program,
    epistemic: IrEpistemicSection,
    out_summary: &! Box<IrProgramSummary>,
    out_fn_count: &! i64,
    out_error_count: &! i64,
    out_had_error: &! bool
) with Mut, Panic, Div, Alloc, IO {
    var lo = lowerer_new_with_epistemic(&epistemic)
    lowerer_preseed_program_items_mut(&! lo, &prog.items, ir_empty_name())
    let error_count = lo.error_count
    let had_error = lo.had_error
    let summary = ir_program_summary_from_lowerer(lo)
    (*out_fn_count) = (*summary.module).fn_count
    (*out_error_count) = error_count
    (*out_had_error) = had_error
    (*out_summary).module = summary.module
    (*out_summary).enum_variants = summary.enum_variants
    (*out_summary).struct_layouts = summary.struct_layouts
    (*out_summary).global_types = summary.global_types
    (*out_summary).probe_mode = summary.probe_mode
}

fn lower_program_to_ir_summary_with_epistemic_ref(prog: &Program, epistemic: IrEpistemicSection) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    let boxed = lower_program_to_ir_summary_box_with_epistemic_ref(prog, &epistemic)
    IrProgramSummaryResult {
        summary: *boxed.summary,
        error_count: boxed.error_count,
        had_error: boxed.had_error,
    }
}

pub fn lower_program_to_ir_summary_with_epistemic(prog: Program, epistemic: IrEpistemicSection) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_with_epistemic_ref(&prog, epistemic)
}

fn lower_program_to_ir_summary_ref(prog: &Program) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_with_epistemic_ref(prog, ir_empty_epistemic_section())
}

fn lower_program_to_ir_summary(prog: Program) -> IrProgramSummaryResult with Mut, Panic, Div, Alloc, IO {
    lower_program_to_ir_summary_ref(&prog)
