    fn lookup_local_index_elem_struct_type(self, name: Name) -> Name with Mut, Panic, Div, Alloc {
        let layout_idx = self.lookup_local_tuple0_array_elem_layout(name)
        if layout_idx >= 0 && layout_idx < (*self.struct_layouts).count {
            return (*self.struct_layouts).entries[layout_idx as usize].type_name
        }
        ir_empty_name()
    }

