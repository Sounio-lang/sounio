    fn lookup_local_struct_type(self, name: Name) -> Name with Mut, Panic, Div, Alloc {
        var i = (*self.locals).count - 1
        while i >= 0 {
            if (*self.locals).depths[i as usize] <= self.scope_depth && ir_name_eq((*self.locals).names[i as usize], name) {
