        let dst_reg = dst_pair.1
        let contest_id = lo2.find_contest_id_for_span(span)
        let lo3 = lo2.emit(ir_lift_knowledge(dst_reg, knowledge_reg, contest_id))
        (lo3, dst_reg)
    }

    fn lower_alternative_count_call(self, span: Span) -> (Lowerer, i64) with Mut, Panic, Div {
        let set_id = self.find_alternative_set_id_for_span(span)
        if set_id < 0 || set_id >= self.module.epistemic.alternative_set_count {
            return self.emit_i64_const(0)
