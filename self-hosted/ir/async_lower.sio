// self-hosted::ir::async_lower — Async/await state machine lowering
//
// Transforms async functions into state machines suitable for cooperative
// multitasking. Each async function is split at its await points (suspend
// points) into a set of states, and a poll/resume function is generated
// that dispatches on the current state.
//
// Pipeline:
//   1. Scan function body for await expressions, record suspend points
//   2. Compute live variables at each suspend point (simple dataflow)
//   3. Split the function into states at each suspend point
//   4. Build a future struct that holds state tag + captured variables
//   5. Generate a poll function with if/else dispatch on state_id
//   6. Rewrite variable accesses to load/store from the future struct
//   7. Handle nested async (awaiting other futures)
//
// All arrays are fixed-size. No heap allocation in the core lowering.
//
// References:
//   Rust RFC 2033: "Experimental coroutines"
//   Kotlin coroutines: state machine transform
//   C# async/await: Roslyn lowering to IAsyncStateMachine

// ============================================================================
// Section 1: Constants
// ============================================================================

let ASYNC_MAX_STATES: i64 = 256
let ASYNC_MAX_SUSPENDS: i64 = 128
let ASYNC_MAX_CAPTURES: i64 = 64
let ASYNC_MAX_MACHINES: i64 = 128
let ASYNC_MAX_LIVE_VARS: i64 = 64
let ASYNC_MAX_INSTRS_PER_STATE: i64 = 4096
let ASYNC_MAX_NESTED: i64 = 32

let ASYNC_STATE_INITIAL: i64 = 0
let ASYNC_STATE_FINAL: i64 = 1

let ASYNC_POLL_READY: i64 = 1
let ASYNC_POLL_PENDING: i64 = 0

// Instruction marker: identifies an await expression in the IR stream.
// We use a sentinel fn_id to tag IrCall instructions that represent awaits.
let ASYNC_AWAIT_SENTINEL: i64 = 0 - 9999

// Invalid sentinel
let ASYNC_INVALID: i64 = 0 - 1

// ============================================================================
// Section 2: Core data structures
// ============================================================================

// A variable that is live across a suspend point and must be saved/restored
// in the future struct.
struct AsyncLiveVar {
    var_id: i64,
    var_type_id: i64,
    slot_offset: i64,
    needs_drop: bool,
}

fn async_live_var_new() -> AsyncLiveVar {
    AsyncLiveVar {
        var_id: ASYNC_INVALID,
        var_type_id: 0,
        slot_offset: 0,
        needs_drop: false,
    }
}

fn async_live_var_make(vid: i64, tid: i64, offset: i64, drop: bool) -> AsyncLiveVar {
    AsyncLiveVar {
        var_id: vid,
        var_type_id: tid,
        slot_offset: offset,
        needs_drop: drop,
    }
}

// One state in the generated state machine.
struct AsyncState {
    state_id: i64,
    entry_block: i64,
    exit_block: i64,
    live_vars: [AsyncLiveVar; 64],
    var_count: i64,
    is_initial: bool,
    is_final: bool,
    suspend_point_id: i64,
    instr_start: i64,
    instr_end: i64,
}

fn async_state_new() -> AsyncState {
    AsyncState {
        state_id: ASYNC_INVALID,
        entry_block: ASYNC_INVALID,
        exit_block: ASYNC_INVALID,
        live_vars: [async_live_var_new(); 64],
        var_count: 0,
        is_initial: false,
        is_final: false,
        suspend_point_id: ASYNC_INVALID,
        instr_start: 0,
        instr_end: 0,
    }
}

fn async_state_make(id: i64, entry: i64, exit: i64, initial: bool, final_s: bool, sp: i64) -> AsyncState {
    AsyncState {
        state_id: id,
        entry_block: entry,
        exit_block: exit,
        live_vars: [async_live_var_new(); 64],
        var_count: 0,
        is_initial: initial,
        is_final: final_s,
        suspend_point_id: sp,
        instr_start: 0,
        instr_end: 0,
    }
}

// A suspend point — where the function yields control.
struct AsyncSuspendPoint {
    point_id: i64,
    state_before: i64,
    state_after: i64,
    awaited_future_reg: i64,
    result_reg: i64,
    instr_index: i64,
}

fn async_suspend_point_new() -> AsyncSuspendPoint {
    AsyncSuspendPoint {
        point_id: ASYNC_INVALID,
        state_before: ASYNC_INVALID,
        state_after: ASYNC_INVALID,
        awaited_future_reg: ASYNC_INVALID,
        result_reg: ASYNC_INVALID,
        instr_index: ASYNC_INVALID,
    }
}

fn async_suspend_point_make(pid: i64, before: i64, after: i64, future_reg: i64, res_reg: i64, idx: i64) -> AsyncSuspendPoint {
    AsyncSuspendPoint {
        point_id: pid,
        state_before: before,
        state_after: after,
        awaited_future_reg: future_reg,
        result_reg: res_reg,
        instr_index: idx,
    }
}

// The complete state machine for one async function.
struct AsyncStateMachine {
    func_id: i64,
    states: [AsyncState; 256],
    state_count: i64,
    suspend_points: [AsyncSuspendPoint; 128],
    suspend_count: i64,
    captured_vars: [AsyncLiveVar; 64],
    capture_count: i64,
    poll_func_id: i64,
    original_param_count: i64,
    original_reg_count: i64,
}

fn async_state_machine_new() -> AsyncStateMachine {
    AsyncStateMachine {
        func_id: ASYNC_INVALID,
        states: [async_state_new(); 256],
        state_count: 0,
        suspend_points: [async_suspend_point_new(); 128],
        suspend_count: 0,
        captured_vars: [async_live_var_new(); 64],
        capture_count: 0,
        poll_func_id: ASYNC_INVALID,
        original_param_count: 0,
        original_reg_count: 0,
    }
}

// Top-level lowering context: tracks all state machines being built.
struct AsyncLowerCtx {
    machines: [AsyncStateMachine; 128],
    machine_count: i64,
    next_temp_reg: i64,
    next_label: i64,
    next_func_id: i64,
    error_count: i64,
}

fn async_lower_ctx_new() -> AsyncLowerCtx {
    AsyncLowerCtx {
        machines: [async_state_machine_new(); 128],
        machine_count: 0,
        next_temp_reg: 0,
        next_label: 0,
        next_func_id: 0,
        error_count: 0,
    }
}

fn async_lower_ctx_init(base_reg: i64, base_label: i64, base_func: i64) -> AsyncLowerCtx {
    AsyncLowerCtx {
        machines: [async_state_machine_new(); 128],
        machine_count: 0,
        next_temp_reg: base_reg,
        next_label: base_label,
        next_func_id: base_func,
        error_count: 0,
    }
}

// ============================================================================
// Section 3: Temporary register / label allocation
// ============================================================================

fn async_alloc_reg(ctx: AsyncLowerCtx) -> AsyncLowerCtx with Mut {
    var result = ctx
    result.next_temp_reg = result.next_temp_reg + 1
    result
}

fn async_last_reg(ctx: AsyncLowerCtx) -> i64 {
    ctx.next_temp_reg - 1
}

fn async_alloc_label(ctx: AsyncLowerCtx) -> AsyncLowerCtx with Mut {
    var result = ctx
    result.next_label = result.next_label + 1
    result
}

fn async_last_label(ctx: AsyncLowerCtx) -> i64 {
    ctx.next_label - 1
}

fn async_alloc_func(ctx: AsyncLowerCtx) -> AsyncLowerCtx with Mut {
    var result = ctx
    result.next_func_id = result.next_func_id + 1
    result
}

fn async_last_func(ctx: AsyncLowerCtx) -> i64 {
    ctx.next_func_id - 1
}

// ============================================================================
// Section 4: Suspend point detection
// ============================================================================

// Check if an instruction is an await expression.
// We identify awaits by an IrCall with fn_id == ASYNC_AWAIT_SENTINEL.
fn async_is_await_instr(instr: IrInstr) -> bool {
    if instr.fn_id == ASYNC_AWAIT_SENTINEL {
        return true
    }
    false
}

// Scan a function for await instructions and record suspend points.
// Returns the updated state machine with suspend_points populated.
fn async_detect_suspend_points(func: IrFunction, sm: AsyncStateMachine) -> AsyncStateMachine with Mut, Panic, Div {
    var result = sm
    result.suspend_count = 0

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if async_is_await_instr(instr) {
            if result.suspend_count < ASYNC_MAX_SUSPENDS {
                let sp_id = result.suspend_count
                var sp = async_suspend_point_new()
                sp.point_id = sp_id
                sp.awaited_future_reg = instr.src1
                sp.result_reg = instr.dst
                sp.instr_index = i
                // state_before and state_after filled during state splitting
                sp.state_before = sp_id
                sp.state_after = sp_id + 1
                result.suspend_points[sp_id as usize] = sp
                result.suspend_count = sp_id + 1
            }
        }
        i = i + 1
    }

    result
}

// Count the number of await instructions in a function.
fn async_count_awaits(func: IrFunction) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if async_is_await_instr(instr) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 5: Live variable analysis
// ============================================================================

// Bit-set representation for variable liveness (up to 64 variables tracked).
struct AsyncVarSet {
    bits: [bool; 64],
    count: i64,
}

fn async_var_set_new() -> AsyncVarSet {
    AsyncVarSet {
        bits: [false; 64],
        count: 0,
    }
}

fn async_var_set_add(set: AsyncVarSet, var_id: i64) -> AsyncVarSet with Mut, Panic, Div {
    var result = set
    if var_id >= 0 && var_id < ASYNC_MAX_LIVE_VARS {
        if !result.bits[var_id as usize] {
            result.bits[var_id as usize] = true
            result.count = result.count + 1
        }
    }
    result
}

fn async_var_set_remove(set: AsyncVarSet, var_id: i64) -> AsyncVarSet with Mut, Panic, Div {
    var result = set
    if var_id >= 0 && var_id < ASYNC_MAX_LIVE_VARS {
        if result.bits[var_id as usize] {
            result.bits[var_id as usize] = false
            result.count = result.count - 1
        }
    }
    result
}

fn async_var_set_contains(set: AsyncVarSet, var_id: i64) -> bool with Panic, Div {
    if var_id >= 0 && var_id < ASYNC_MAX_LIVE_VARS {
        return set.bits[var_id as usize]
    }
    false
}

fn async_var_set_union(a: AsyncVarSet, b: AsyncVarSet) -> AsyncVarSet with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < ASYNC_MAX_LIVE_VARS {
        if b.bits[i as usize] && !result.bits[i as usize] {
            result.bits[i as usize] = true
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

fn async_var_set_intersect(a: AsyncVarSet, b: AsyncVarSet) -> AsyncVarSet with Mut, Panic, Div {
    var result = async_var_set_new()
    var i: i64 = 0
    while i < ASYNC_MAX_LIVE_VARS {
        if a.bits[i as usize] && b.bits[i as usize] {
            result.bits[i as usize] = true
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

// Compute the set of registers defined (written) by an instruction.
fn async_instr_defs(instr: IrInstr) -> AsyncVarSet with Mut, Panic, Div {
    var defs = async_var_set_new()
    if instr.dst >= 0 && instr.dst < ASYNC_MAX_LIVE_VARS {
        defs = async_var_set_add(defs, instr.dst)
    }
    defs
}

// Compute the set of registers used (read) by an instruction.
fn async_instr_uses(instr: IrInstr) -> AsyncVarSet with Mut, Panic, Div {
    var uses = async_var_set_new()
    if instr.src1 >= 0 && instr.src1 < ASYNC_MAX_LIVE_VARS {
        uses = async_var_set_add(uses, instr.src1)
    }
    if instr.src2 >= 0 && instr.src2 < ASYNC_MAX_LIVE_VARS {
        uses = async_var_set_add(uses, instr.src2)
    }
    uses
}

// Compute live-in set at a given instruction index by backward scan.
// live_out = union of all successors' live_in
// live_in(i) = uses(i) union (live_out(i) - defs(i))
//
// For simplicity we do a single backward pass from the end of the function
// to the target instruction, collecting the live set.
fn async_compute_live_at(func: IrFunction, target_idx: i64) -> AsyncVarSet with Mut, Panic, Div {
    var live = async_var_set_new()

    // Walk backward from end to target
    var i: i64 = func.instr_count - 1
    while i >= target_idx {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        // Remove defs
        if instr.dst >= 0 && instr.dst < ASYNC_MAX_LIVE_VARS {
            live = async_var_set_remove(live, instr.dst)
        }
        // Add uses
        if instr.src1 >= 0 && instr.src1 < ASYNC_MAX_LIVE_VARS {
            live = async_var_set_add(live, instr.src1)
        }
        if instr.src2 >= 0 && instr.src2 < ASYNC_MAX_LIVE_VARS {
            live = async_var_set_add(live, instr.src2)
        }
        i = i - 1
    }

    live
}

// Compute live variables across a suspend point.
// A variable is live across a suspend point if it is defined before the
// suspend and used after it.
fn async_live_across_suspend(func: IrFunction, suspend_idx: i64) -> AsyncVarSet with Mut, Panic, Div {
    // Step 1: compute defs before the suspend point
    var defs_before = async_var_set_new()
    var i: i64 = 0
    while i < suspend_idx {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        if instr.dst >= 0 && instr.dst < ASYNC_MAX_LIVE_VARS {
            defs_before = async_var_set_add(defs_before, instr.dst)
        }
        i = i + 1
    }

    // Step 2: compute uses after the suspend point
    var uses_after = async_var_set_new()
    var j: i64 = suspend_idx + 1
    while j < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (j)))
        if instr.src1 >= 0 && instr.src1 < ASYNC_MAX_LIVE_VARS {
            uses_after = async_var_set_add(uses_after, instr.src1)
        }
        if instr.src2 >= 0 && instr.src2 < ASYNC_MAX_LIVE_VARS {
            uses_after = async_var_set_add(uses_after, instr.src2)
        }
        j = j + 1
    }

    // Step 3: intersection = defined before AND used after
    async_var_set_intersect(defs_before, uses_after)
}

// Populate the live_vars array in each state from a var set.
fn async_state_set_live_vars(state: AsyncState, live: AsyncVarSet) -> AsyncState with Mut, Panic, Div {
    var result = state
    result.var_count = 0
    var i: i64 = 0
    while i < ASYNC_MAX_LIVE_VARS {
        if live.bits[i as usize] {
            if result.var_count < ASYNC_MAX_LIVE_VARS {
                var lv = async_live_var_new()
                lv.var_id = i
                lv.slot_offset = result.var_count
                result.live_vars[result.var_count as usize] = lv
                result.var_count = result.var_count + 1
            }
        }
        i = i + 1
    }
    result
}

// Run live variable analysis for all suspend points in a state machine.
fn async_analyze_liveness(func: IrFunction, sm: AsyncStateMachine) -> AsyncStateMachine with Mut, Panic, Div {
    var result = sm

    var sp: i64 = 0
    while sp < result.suspend_count {
        let suspend_idx = result.suspend_points[sp as usize].instr_index
        let live = async_live_across_suspend(func, suspend_idx)

        // Store live vars on the state_before (the state that suspends)
        let state_id = result.suspend_points[sp as usize].state_before
        if state_id >= 0 && state_id < result.state_count {
            result.states[state_id as usize] = async_state_set_live_vars(
                result.states[state_id as usize], live)
        }

        sp = sp + 1
    }

    result
}

// ============================================================================
// Section 6: State splitting
// ============================================================================

// Split a function into states at each suspend point.
// N suspend points -> N+1 states (state 0 = initial, state N = final).
// Additionally state ASYNC_STATE_FINAL (1) is reserved for the done state.
fn async_split_states(func: IrFunction, sm: AsyncStateMachine) -> AsyncStateMachine with Mut, Panic, Div {
    var result = sm
    let n_suspends = result.suspend_count

    // If no suspends, the function is trivially a single initial+final state
    if n_suspends == 0 {
        // State 0: initial and final
        var s0 = async_state_make(0, 0, 0, true, true, ASYNC_INVALID)
        s0.instr_start = 0
        s0.instr_end = func.instr_count
        result.states[0] = s0
        result.state_count = 1
        return result
    }

    // State 0: from start to first suspend
    var s_init = async_state_make(0, 0, 0, true, false, ASYNC_INVALID)
    s_init.instr_start = 0
    s_init.instr_end = result.suspend_points[0].instr_index
    result.states[0] = s_init
    result.state_count = 1

    // Intermediate states: between consecutive suspend points
    var i: i64 = 0
    while i < n_suspends {
        let sp = result.suspend_points[i as usize]
        let next_state_id = i + 1
        let is_last = (i == n_suspends - 1)

        var st = async_state_make(next_state_id, 0, 0, false, false, sp.point_id)
        st.instr_start = sp.instr_index + 1

        if is_last {
            // Last state runs to end of function
            st.instr_end = func.instr_count
            st.is_final = true
        } else {
            // Runs to next suspend point
            st.instr_end = result.suspend_points[(i + 1) as usize].instr_index
        }

        if next_state_id < ASYNC_MAX_STATES {
            result.states[next_state_id as usize] = st
            result.state_count = next_state_id + 1
        }

        // Update suspend point state_before / state_after
        result.suspend_points[i as usize].state_before = i
        result.suspend_points[i as usize].state_after = next_state_id

        i = i + 1
    }

    result
}

// ============================================================================
// Section 7: Variable capture
// ============================================================================

// Collect all unique variables that are live across any suspend point.
// These must be captured into the future struct.
fn async_collect_captures(sm: AsyncStateMachine) -> AsyncStateMachine with Mut, Panic, Div {
    var result = sm
    result.capture_count = 0

    // Track which var_ids we have already added
    var seen: [bool; 64] = [false; 64]

    var s: i64 = 0
    while s < result.state_count {
        let state = result.states[s as usize]
        var v: i64 = 0
        while v < state.var_count {
            let lv = state.live_vars[v as usize]
            let vid = lv.var_id
            if vid >= 0 && vid < ASYNC_MAX_CAPTURES {
                if !seen[vid as usize] {
                    seen[vid as usize] = true
                    if result.capture_count < ASYNC_MAX_CAPTURES {
                        var cap = lv
                        cap.slot_offset = result.capture_count
                        result.captured_vars[result.capture_count as usize] = cap
                        result.capture_count = result.capture_count + 1
                    }
                }
            }
            v = v + 1
        }
        s = s + 1
    }

    result
}

// Find the slot offset of a captured variable by var_id.
// Returns ASYNC_INVALID if not found.
fn async_find_capture_slot(sm: AsyncStateMachine, var_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < sm.capture_count {
        if sm.captured_vars[i as usize].var_id == var_id {
            return sm.captured_vars[i as usize].slot_offset
        }
        i = i + 1
    }
    ASYNC_INVALID
}

// Check if a variable is captured.
fn async_is_captured(sm: AsyncStateMachine, var_id: i64) -> bool with Mut, Panic, Div {
    async_find_capture_slot(sm, var_id) != ASYNC_INVALID
}

// ============================================================================
// Section 8: State machine struct generation
// ============================================================================

// The future struct layout:
//   field 0: state_tag (i64) — current state index
//   field 1..N: captured variables
//   field N+1: result slot
//
// Returns the total number of fields in the struct.
fn async_future_struct_field_count(sm: AsyncStateMachine) -> i64 {
    // 1 (state_tag) + capture_count + 1 (result)
    sm.capture_count + 2
}

// Generate field index for the state tag.
fn async_state_tag_field() -> i64 {
    0
}

// Generate field index for captured variable at slot offset.
fn async_capture_field(slot_offset: i64) -> i64 {
    slot_offset + 1
}

// Generate field index for the result slot.
fn async_result_field(sm: AsyncStateMachine) -> i64 {
    sm.capture_count + 1
}

// Build a struct layout descriptor for the generated future.
// Returns a StructLayoutEntry compatible with the IR's struct tracking.
fn async_build_future_layout(sm: AsyncStateMachine, name: Name) -> StructLayoutEntry with Mut, Panic, Div {
    var layout = empty_struct_layout_entry()
    layout.type_name = name

    // Field 0: state_tag
    var f0 = empty_struct_field_entry()
    f0.name = async_make_name_state_tag()
    f0.index = 0
    layout.fields[0] = f0
    layout.field_count = 1

    // Fields 1..N: captured vars
    var i: i64 = 0
    while i < sm.capture_count {
        let cap = sm.captured_vars[i as usize]
        var field = empty_struct_field_entry()
        field.name = async_make_capture_name(i)
        field.index = i + 1
        if layout.field_count < 64 {
            layout.fields[layout.field_count as usize] = field
            layout.field_count = layout.field_count + 1
        }
        i = i + 1
    }

    // Last field: result
    var fr = empty_struct_field_entry()
    fr.name = async_make_name_result()
    fr.index = layout.field_count
    if layout.field_count < 64 {
        layout.fields[layout.field_count as usize] = fr
        layout.field_count = layout.field_count + 1
    }

    layout
}

// ============================================================================
// Section 9: Name construction helpers
// ============================================================================

// Build the name "state_tag" for the state field.
fn async_make_name_state_tag() -> Name with Mut, Panic, Div {
    // s=115 t=116 a=97 t=116 e=101 _=95 t=116 a=97 g=103
    var n = Name { buf: [0; 128], len: 9 }
    n.buf[0] = 115 as i8   // s
    n.buf[1] = 116 as i8   // t
    n.buf[2] = 97 as i8    // a
    n.buf[3] = 116 as i8   // t
    n.buf[4] = 101 as i8   // e
    n.buf[5] = 95 as i8    // _
    n.buf[6] = 116 as i8   // t
    n.buf[7] = 97 as i8    // a
    n.buf[8] = 103 as i8   // g
    n
}

// Build the name "result" for the result field.
fn async_make_name_result() -> Name with Mut, Panic, Div {
    // r=114 e=101 s=115 u=117 l=108 t=116
    var n = Name { buf: [0; 128], len: 6 }
    n.buf[0] = 114 as i8   // r
    n.buf[1] = 101 as i8   // e
    n.buf[2] = 115 as i8   // s
    n.buf[3] = 117 as i8   // u
    n.buf[4] = 108 as i8   // l
    n.buf[5] = 116 as i8   // t
    n
}

// Build a capture name "cap_N" where N is a digit 0-9.
fn async_make_capture_name(idx: i64) -> Name with Mut, Panic, Div {
    // c=99 a=97 p=112 _=95 digit
    var n = Name { buf: [0; 128], len: 5 }
    n.buf[0] = 99 as i8    // c
    n.buf[1] = 97 as i8    // a
    n.buf[2] = 112 as i8   // p
    n.buf[3] = 95 as i8    // _
    n.buf[4] = (48 + idx) as i8  // '0' + idx
    if idx >= 10 {
        // Two digit: "cap_XY"
        let tens = idx / 10
        let ones = idx - (tens * 10)
        n.buf[4] = (48 + tens) as i8
        n.buf[5] = (48 + ones) as i8
        n.len = 6
    }
    n
}

// Build name "poll_" prefix + original function name suffix.
fn async_make_poll_name(orig_name: Name) -> Name with Mut, Panic, Div {
    // p=112 o=111 l=108 l=108 _=95
    var n = Name { buf: [0; 128], len: 0 }
    n.buf[0] = 112 as i8   // p
    n.buf[1] = 111 as i8   // o
    n.buf[2] = 108 as i8   // l
    n.buf[3] = 108 as i8   // l
    n.buf[4] = 95 as i8    // _
    n.len = 5

    // Append original name
    var i: i64 = 0
    while i < orig_name.len && n.len < 128 {
        n.buf[n.len as usize] = orig_name.buf[i as usize]
        n.len = n.len + 1
        i = i + 1
    }
    n
}

// Build name "Future_" prefix + original function name suffix.
fn async_make_future_name(orig_name: Name) -> Name with Mut, Panic, Div {
    // F=70 u=117 t=116 u=117 r=114 e=101 _=95
    var n = Name { buf: [0; 128], len: 0 }
    n.buf[0] = 70 as i8    // F
    n.buf[1] = 117 as i8   // u
    n.buf[2] = 116 as i8   // t
    n.buf[3] = 117 as i8   // u
    n.buf[4] = 114 as i8   // r
    n.buf[5] = 101 as i8   // e
    n.buf[6] = 95 as i8    // _
    n.len = 7

    var i: i64 = 0
    while i < orig_name.len && n.len < 128 {
        n.buf[n.len as usize] = orig_name.buf[i as usize]
        n.len = n.len + 1
        i = i + 1
    }
    n
}

// ============================================================================
// Section 10: Poll function generation
// ============================================================================

// Emit instructions for saving captured variables into the future struct
// before a suspend. future_reg is the register holding the future struct.
fn async_emit_save_captures(sm: AsyncStateMachine, future_reg: i64, buf: [IrInstr; 4096], offset: i64) -> i64 with Mut, Panic, Div {
    var pos = offset
    var i: i64 = 0
    while i < sm.capture_count {
        let cap = sm.captured_vars[i as usize]
        let field_idx = async_capture_field(cap.slot_offset)
        let field_name = async_make_capture_name(i)
        if pos < ASYNC_MAX_INSTRS_PER_STATE {
            buf[pos as usize] = ir_field_set(future_reg, field_idx, cap.var_id, field_name)
            pos = pos + 1
        }
        i = i + 1
    }
    pos
}

// Emit instructions for restoring captured variables from the future struct
// after resume. future_reg is the register holding the future struct.
fn async_emit_restore_captures(sm: AsyncStateMachine, future_reg: i64, buf: [IrInstr; 4096], offset: i64) -> i64 with Mut, Panic, Div {
    var pos = offset
    var i: i64 = 0
    while i < sm.capture_count {
        let cap = sm.captured_vars[i as usize]
        let field_idx = async_capture_field(cap.slot_offset)
        let field_name = async_make_capture_name(i)
        if pos < ASYNC_MAX_INSTRS_PER_STATE {
            buf[pos as usize] = ir_field_get(cap.var_id, future_reg, field_idx, field_name)
            pos = pos + 1
        }
        i = i + 1
    }
    pos
}

// Emit the state tag update: set the state_tag field to the new state.
fn async_emit_state_update(future_reg: i64, new_state: i64, buf: [IrInstr; 4096], offset: i64, temp_reg: i64) -> i64 with Mut, Panic, Div {
    var pos = offset
    // Load new state into temp
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_load_imm(temp_reg, new_state)
        pos = pos + 1
    }
    // Set state_tag field
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        let tag_name = async_make_name_state_tag()
        buf[pos as usize] = ir_field_set(future_reg, async_state_tag_field(), temp_reg, tag_name)
        pos = pos + 1
    }
    pos
}

// Emit a pending return: set state, save captures, return PENDING.
fn async_emit_suspend(sm: AsyncStateMachine, future_reg: i64, next_state: i64, buf: [IrInstr; 4096], offset: i64, temp_reg: i64, ret_reg: i64) -> i64 with Mut, Panic, Div {
    var pos = offset
    // Update state tag
    pos = async_emit_state_update(future_reg, next_state, buf, pos, temp_reg)
    // Save captures
    pos = async_emit_save_captures(sm, future_reg, buf, pos)
    // Load PENDING into ret_reg
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_load_imm(ret_reg, ASYNC_POLL_PENDING)
        pos = pos + 1
    }
    // Return
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_return(ret_reg)
        pos = pos + 1
    }
    pos
}

// Emit a ready return: set state to FINAL, store result, return READY.
fn async_emit_ready(sm: AsyncStateMachine, future_reg: i64, result_val_reg: i64, buf: [IrInstr; 4096], offset: i64, temp_reg: i64, ret_reg: i64) -> i64 with Mut, Panic, Div {
    var pos = offset
    // Update state tag to FINAL
    pos = async_emit_state_update(future_reg, ASYNC_STATE_FINAL, buf, pos, temp_reg)
    // Store result value
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        let res_name = async_make_name_result()
        buf[pos as usize] = ir_field_set(future_reg, async_result_field(sm), result_val_reg, res_name)
        pos = pos + 1
    }
    // Load READY into ret_reg
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_load_imm(ret_reg, ASYNC_POLL_READY)
        pos = pos + 1
    }
    // Return
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_return(ret_reg)
        pos = pos + 1
    }
    pos
}

// Generate the poll function dispatch header.
// Loads state_tag from future struct, then branches to the correct state.
//
// Layout:
//   load state_tag
//   if state_tag == 0: goto label_state_0
//   if state_tag == 1: goto label_state_1 (final / done)
//   ...
//   goto label_invalid
fn async_emit_poll_dispatch(sm: AsyncStateMachine, future_reg: i64, tag_reg: i64, state_labels: [i64; 256], buf: [IrInstr; 4096], offset: i64, temp_reg: i64) -> i64 with Mut, Panic, Div {
    var pos = offset

    // Load state_tag from future
    let tag_name = async_make_name_state_tag()
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_field_get(tag_reg, future_reg, async_state_tag_field(), tag_name)
        pos = pos + 1
    }

    // For each state, emit: if tag_reg == state_id, goto label
    var s: i64 = 0
    while s < sm.state_count {
        let state = sm.states[s as usize]
        let sid = state.state_id
        // Load state_id into temp
        if pos < ASYNC_MAX_INSTRS_PER_STATE {
            buf[pos as usize] = ir_load_imm(temp_reg, sid)
            pos = pos + 1
        }
        // Compare: temp2 = (tag_reg == temp_reg)
        let cmp_reg = temp_reg + 1
        if pos < ASYNC_MAX_INSTRS_PER_STATE {
            buf[pos as usize] = ir_binop(cmp_reg, tag_reg, BinaryOp::OpEq, temp_reg)
            pos = pos + 1
        }
        // Branch true to state label
        if pos < ASYNC_MAX_INSTRS_PER_STATE {
            buf[pos as usize] = ir_branch_true(cmp_reg, state_labels[s as usize])
            pos = pos + 1
        }
        s = s + 1
    }

    pos
}

// ============================================================================
// Section 11: Full state machine construction
// ============================================================================

// Build a complete state machine from a function.
// This is the main entry point for async lowering of a single function.
fn async_build_machine(func: IrFunction, func_id: i64, ctx: AsyncLowerCtx) -> AsyncLowerCtx with Mut, Panic, Div {
    var result = ctx

    if result.machine_count >= ASYNC_MAX_MACHINES {
        result.error_count = result.error_count + 1
        return result
    }

    var sm = async_state_machine_new()
    sm.func_id = func_id
    sm.original_param_count = func.param_count
    sm.original_reg_count = func.reg_count

    // Step 1: Detect suspend points
    sm = async_detect_suspend_points(func, sm)

    // Step 2: Split into states
    sm = async_split_states(func, sm)

    // Step 3: Analyze liveness
    sm = async_analyze_liveness(func, sm)

    // Step 4: Collect captures
    sm = async_collect_captures(sm)

    // Step 5: Allocate poll function id
    result = async_alloc_func(result)
    sm.poll_func_id = async_last_func(result)

    // Store machine
    let idx = result.machine_count
    result.machines[idx as usize] = sm
    result.machine_count = idx + 1

    result
}

// ============================================================================
// Section 12: Nested async handling
// ============================================================================

// When an async function awaits another async function, we need to:
// 1. Store the inner future in the outer future struct
// 2. Poll the inner future in each resume
// 3. Propagate pending status upward

// Check if a suspend point is awaiting a function that is itself async
// (i.e., has a state machine in our context).
fn async_is_nested_await(ctx: AsyncLowerCtx, awaited_func_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < ctx.machine_count {
        if ctx.machines[i as usize].func_id == awaited_func_id {
            return true
        }
        i = i + 1
    }
    false
}

// Find the state machine for a given function id.
// Returns the machine index, or ASYNC_INVALID if not found.
fn async_find_machine(ctx: AsyncLowerCtx, func_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ctx.machine_count {
        if ctx.machines[i as usize].func_id == func_id {
            return i
        }
        i = i + 1
    }
    ASYNC_INVALID
}

// Count the number of nested awaits in a state machine.
fn async_count_nested(sm: AsyncStateMachine) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < sm.suspend_count {
        let sp = sm.suspend_points[i as usize]
        // A nested await is any await; the caller determines if the
        // awaited function is itself async.
        count = count + 1
        i = i + 1
    }
    count
}

// ============================================================================
// Section 13: Rewriting — replacing await exprs with poll+branch
// ============================================================================

// Rewrite a single await instruction into a poll-and-branch sequence.
// The await `result = await future_expr` becomes:
//   poll_result = poll(future_reg)
//   if poll_result == PENDING: save state, return PENDING
//   result = load_result(future_reg)
fn async_rewrite_await(sp: AsyncSuspendPoint, future_reg: i64, poll_result_reg: i64, pending_label: i64, continue_label: i64, buf: [IrInstr; 4096], offset: i64) -> i64 with Mut, Panic, Div {
    var pos = offset

    // Emit label for this state's entry
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_label(continue_label)
        pos = pos + 1
    }

    // Check if poll_result is PENDING
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_load_imm(poll_result_reg + 1, ASYNC_POLL_PENDING)
        pos = pos + 1
    }
    // Compare
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_binop(poll_result_reg + 2, poll_result_reg, BinaryOp::OpEq, poll_result_reg + 1)
        pos = pos + 1
    }
    // Branch to pending handler
    if pos < ASYNC_MAX_INSTRS_PER_STATE {
        buf[pos as usize] = ir_branch_true(poll_result_reg + 2, pending_label)
        pos = pos + 1
    }

    pos
}

// ============================================================================
// Section 14: Module-level async lowering
// ============================================================================

// Check if a function has any await expressions.
fn async_func_has_awaits(func: IrFunction) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        if async_is_await_instr(ir_arena_load(ir_region_slot_r(func.region, (i)))) {
            return true
        }
        i = i + 1
    }
    false
}

// Lower all async functions in a module.
// Scans for functions with await expressions, builds state machines,
// and generates poll functions.
fn async_lower_module(module: IrModule) -> AsyncLowerCtx with Mut, Panic, Div {
    var ctx = async_lower_ctx_init(1000, 1000, module.fn_count)

    var i: i64 = 0
    while i < module.fn_count {
        let func = module.functions[i as usize]
        if async_func_has_awaits(func) {
            ctx = async_build_machine(func, i, ctx)
        }
        i = i + 1
    }

    ctx
}

// Get the state machine for a specific function index.
fn async_get_machine_for_func(ctx: AsyncLowerCtx, func_id: i64) -> AsyncStateMachine with Mut, Panic, Div {
    let idx = async_find_machine(ctx, func_id)
    if idx != ASYNC_INVALID {
        return ctx.machines[idx as usize]
    }
    async_state_machine_new()
}

// ============================================================================
// Section 15: Query / inspection utilities
// ============================================================================

// Get the number of states in a machine.
fn async_machine_state_count(sm: AsyncStateMachine) -> i64 {
    sm.state_count
}

// Get the number of suspend points in a machine.
fn async_machine_suspend_count(sm: AsyncStateMachine) -> i64 {
    sm.suspend_count
}

// Get the number of captures in a machine.
fn async_machine_capture_count(sm: AsyncStateMachine) -> i64 {
    sm.capture_count
}

// Check if state N is the initial state.
fn async_state_is_initial(sm: AsyncStateMachine, state_idx: i64) -> bool with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].is_initial
    }
    false
}

// Check if state N is a final state.
fn async_state_is_final(sm: AsyncStateMachine, state_idx: i64) -> bool with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].is_final
    }
    false
}

// Get the state_id of a state by index.
fn async_state_id_at(sm: AsyncStateMachine, state_idx: i64) -> i64 with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].state_id
    }
    ASYNC_INVALID
}

// Get the suspend point for a given state.
fn async_state_suspend_point(sm: AsyncStateMachine, state_idx: i64) -> i64 with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].suspend_point_id
    }
    ASYNC_INVALID
}

// Get the number of live vars in a state.
fn async_state_live_count(sm: AsyncStateMachine, state_idx: i64) -> i64 with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].var_count
    }
    0
}

// Get instruction range for a state.
fn async_state_instr_start(sm: AsyncStateMachine, state_idx: i64) -> i64 with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].instr_start
    }
    0
}

fn async_state_instr_end(sm: AsyncStateMachine, state_idx: i64) -> i64 with Panic, Div {
    if state_idx >= 0 && state_idx < sm.state_count {
        return sm.states[state_idx as usize].instr_end
    }
    0
}

// ============================================================================
// Section 16: Validation
// ============================================================================

// Validate a state machine for internal consistency.
// Returns 0 if valid, non-zero error code otherwise.
fn async_validate_machine(sm: AsyncStateMachine) -> i64 with Mut, Panic, Div {
    // Check: at least one state
    if sm.state_count <= 0 {
        return 1
    }

    // Check: state 0 is initial
    if !sm.states[0].is_initial {
        return 2
    }

    // Check: at least one final state
    var has_final: bool = false
    var i: i64 = 0
    while i < sm.state_count {
        if sm.states[i as usize].is_final {
            has_final = true
        }
        i = i + 1
    }
    if !has_final {
        return 3
    }

    // Check: state_ids are sequential
    var j: i64 = 0
    while j < sm.state_count {
        if sm.states[j as usize].state_id != j {
            return 4
        }
        j = j + 1
    }

    // Check: suspend point state_before < state_after
    var k: i64 = 0
    while k < sm.suspend_count {
        let sp = sm.suspend_points[k as usize]
        if sp.state_before >= sp.state_after {
            return 5
        }
        k = k + 1
    }

    // Check: capture count <= max
    if sm.capture_count > ASYNC_MAX_CAPTURES {
        return 6
    }

    0
}

// Validate instruction indices of states don't overlap and cover the function.
fn async_validate_state_ranges(sm: AsyncStateMachine, func_instr_count: i64) -> i64 with Mut, Panic, Div {
    if sm.state_count <= 0 {
        return 1
    }

    // First state starts at 0
    if sm.states[0].instr_start != 0 {
        return 2
    }

    // Last state ends at func_instr_count
    let last = sm.state_count - 1
    if sm.states[last as usize].instr_end != func_instr_count {
        return 3
    }

    // Each state's end == next state's start
    var i: i64 = 0
    while i < sm.state_count - 1 {
        let cur_end = sm.states[i as usize].instr_end
        let next_start = sm.states[(i + 1) as usize].instr_start
        // The end of a state + 1 (the await instr) should be the next state's start.
        // Actually: cur_end is the await instr index, next_start is await_idx + 1.
        if next_start < cur_end {
            return 4
        }
        i = i + 1
    }

    0
}

// ============================================================================
// Section 17: Helper — build test functions
// ============================================================================

// Build a simple IrFunction with N instructions for testing.
// All instructions are NOPs except for any awaits inserted by the caller.
fn async_make_test_func(n_instrs: i64) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.instr_count = n_instrs
    var i: i64 = 0
    while i < n_instrs {
        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_nop())
        i = i + 1
    }
    func
}

// Insert an await instruction at a given index in a test function.
// The await reads from src_reg (the future) and writes to dst_reg (the result).
fn async_insert_await(func: IrFunction, idx: i64, dst_reg: i64, src_reg: i64) -> IrFunction with Mut, Panic, Div {
    var result = ir_function_clone(&func)
    if idx >= 0 && idx < result.instr_count {
        var instr = ir_instr_new(IrOpcode::IrCall)
        instr.fn_id = ASYNC_AWAIT_SENTINEL
        instr.dst = dst_reg
        instr.src1 = src_reg
        ir_arena_store(ir_region_slot_w(result.region, (idx)), instr)
    }
    result
}

// Build a function with explicit defs and uses for liveness testing.
// Creates: def r0 at idx 0, def r1 at idx 1, ..., use rN at various points.
fn async_make_liveness_test_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.instr_count = 8
    func.reg_count = 6

    // Instruction 0: r0 = 10
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 10))
    // Instruction 1: r1 = 20
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 20))
    // Instruction 2: r2 = r0 + r1
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    // Instruction 3: await (suspend point) — reads r2, writes r3
    var await_instr = ir_instr_new(IrOpcode::IrCall)
    await_instr.fn_id = ASYNC_AWAIT_SENTINEL
    await_instr.dst = 3
    await_instr.src1 = 2
    ir_arena_store(ir_region_slot_w(func.region, (3)), await_instr)
    // Instruction 4: r4 = r0 + r3  (r0 is live across suspend)
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 0, BinaryOp::OpAdd, 3))
    // Instruction 5: r5 = r1 + r4  (r1 is live across suspend)
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_binop(5, 1, BinaryOp::OpAdd, 4))
    // Instruction 6: return r5
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_return(5))
    // Instruction 7: nop (padding)
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_nop())

    func
}

// Build a function with two await points for multi-suspend testing.
fn async_make_two_await_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.instr_count = 10
    func.reg_count = 8

    // 0: r0 = 100
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 100))
    // 1: r1 = 200
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 200))
    // 2: r2 = r0 + r1
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    // 3: r3 = await r2  (first suspend)
    var aw1 = ir_instr_new(IrOpcode::IrCall)
    aw1.fn_id = ASYNC_AWAIT_SENTINEL
    aw1.dst = 3
    aw1.src1 = 2
    ir_arena_store(ir_region_slot_w(func.region, (3)), aw1)
    // 4: r4 = r0 + r3
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 0, BinaryOp::OpAdd, 3))
    // 5: r5 = r4 + r1
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_binop(5, 4, BinaryOp::OpAdd, 1))
    // 6: r6 = await r5  (second suspend)
    var aw2 = ir_instr_new(IrOpcode::IrCall)
    aw2.fn_id = ASYNC_AWAIT_SENTINEL
    aw2.dst = 6
    aw2.src1 = 5
    ir_arena_store(ir_region_slot_w(func.region, (6)), aw2)
    // 7: r7 = r0 + r6
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_binop(7, 0, BinaryOp::OpAdd, 6))
    // 8: return r7
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_return(7))
    // 9: nop
    ir_arena_store(ir_region_slot_w(func.region, (9)), ir_nop())

    func
}

// Build a function with no await points.
fn async_make_no_await_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.instr_count = 4
    func.reg_count = 3

    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 42))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 58))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))

    func
}

// Build a function with three await points for extensive state splitting.
fn async_make_three_await_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.instr_count = 14
    func.reg_count = 10

    // 0: r0 = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    // 1: r1 = 2
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 2))
    // 2: r2 = await r0  (suspend 0)
    var aw0 = ir_instr_new(IrOpcode::IrCall)
    aw0.fn_id = ASYNC_AWAIT_SENTINEL
    aw0.dst = 2
    aw0.src1 = 0
    ir_arena_store(ir_region_slot_w(func.region, (2)), aw0)
    // 3: r3 = r2 + r1
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_binop(3, 2, BinaryOp::OpAdd, 1))
    // 4: r4 = r3 + r0
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 3, BinaryOp::OpAdd, 0))
    // 5: r5 = await r4  (suspend 1)
    var aw1 = ir_instr_new(IrOpcode::IrCall)
    aw1.fn_id = ASYNC_AWAIT_SENTINEL
    aw1.dst = 5
    aw1.src1 = 4
    ir_arena_store(ir_region_slot_w(func.region, (5)), aw1)
    // 6: r6 = r5 + r1
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_binop(6, 5, BinaryOp::OpAdd, 1))
    // 7: r7 = r0 + r6
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_binop(7, 0, BinaryOp::OpAdd, 6))
    // 8: r8 = await r7  (suspend 2)
    var aw2 = ir_instr_new(IrOpcode::IrCall)
    aw2.fn_id = ASYNC_AWAIT_SENTINEL
    aw2.dst = 8
    aw2.src1 = 7
    ir_arena_store(ir_region_slot_w(func.region, (8)), aw2)
    // 9: r9 = r8 + r0
    ir_arena_store(ir_region_slot_w(func.region, (9)), ir_binop(9, 8, BinaryOp::OpAdd, 0))
    // 10: return r9
    ir_arena_store(ir_region_slot_w(func.region, (10)), ir_return(9))
    // 11-13: nop
    ir_arena_store(ir_region_slot_w(func.region, (11)), ir_nop())
    ir_arena_store(ir_region_slot_w(func.region, (12)), ir_nop())
    ir_arena_store(ir_region_slot_w(func.region, (13)), ir_nop())

    func
}

