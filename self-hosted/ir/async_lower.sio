// ============================================================================
// Section 34: Tests — async_is_await_instr
// ============================================================================

fn test_async_is_await_for_sentinel() -> i64 with Mut, Panic, Div {
    var instr = ir_instr_new(IrOpcode::IrCall)
    instr.fn_id = ASYNC_AWAIT_SENTINEL
    if !async_is_await_instr(instr) { return 1 }

    var nop = ir_nop()
    if async_is_await_instr(nop) { return 2 }

    var regular_call = ir_instr_new(IrOpcode::IrCall)
    regular_call.fn_id = 42
    if async_is_await_instr(regular_call) { return 3 }
    0
}

// ============================================================================
// Section 35: Tests — live var across three suspends
// ============================================================================

fn test_async_liveness_three_suspends() -> i64 with Mut, Panic, Div {
    let func = async_make_three_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    sm = async_analyze_liveness(func, sm)
    sm = async_collect_captures(sm)

    // r0 is used at indices 4, 7, 9 (after all three suspends at 2, 5, 8)
    // r1 is used at indices 3, 6 (after suspends at 2, 5, but not after 8)
    // Both r0 and r1 should be captured.
    if !async_is_captured(sm, 0) { return 1 }
    if !async_is_captured(sm, 1) { return 2 }
    // Captures should be deduplicated
    if sm.capture_count < 2 { return 3 }
    0
}

