    sm.captured_vars[1] = async_live_var_make(1, 1, 1, false)
    let name = ir_empty_name()
    let layout = async_build_future_layout(sm, name)
    // state_tag + 2 captures + result = 4 fields
    if layout.field_count != 4 { return 1 }
    // Field 0 should be state_tag
