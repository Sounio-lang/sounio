fn test_async_capture_empty() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.state_count = 1
    sm.states[0] = async_state_make(0, 0, 0, true, true, ASYNC_INVALID)
    sm = async_collect_captures(sm)
    if sm.capture_count != 0 { return 1 }
    0
}

fn test_async_capture_from_liveness() -> i64 with Mut, Panic, Div {
    let func = async_make_liveness_test_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    sm = async_analyze_liveness(func, sm)
    sm = async_collect_captures(sm)
    // r0 and r1 are live across the suspend
    if sm.capture_count != 2 { return 1 }
    // Check both vars are captured
    if !async_is_captured(sm, 0) { return 2 }
    if !async_is_captured(sm, 1) { return 3 }
    if async_is_captured(sm, 2) { return 4 }
    0
}

fn test_async_capture_slot_lookup() -> i64 with Mut, Panic, Div {
    let func = async_make_liveness_test_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    sm = async_analyze_liveness(func, sm)
    sm = async_collect_captures(sm)

    let slot0 = async_find_capture_slot(sm, 0)
    let slot1 = async_find_capture_slot(sm, 1)
    let slot_bad = async_find_capture_slot(sm, 99)

    if slot0 < 0 { return 1 }
    if slot1 < 0 { return 2 }
    if slot0 == slot1 { return 3 }
    if slot_bad != ASYNC_INVALID { return 4 }
    0
}

fn test_async_capture_dedup_across_states() -> i64 with Mut, Panic, Div {
    // With two suspend points, r0 is live across both. Should only be captured once.
    let func = async_make_two_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    sm = async_analyze_liveness(func, sm)
    sm = async_collect_captures(sm)
    // r0 is live across both suspends, r1 across the first.
    // Should be deduplicated.
    var r0_count: i64 = 0
    var i: i64 = 0
    while i < sm.capture_count {
        if sm.captured_vars[i as usize].var_id == 0 {
            r0_count = r0_count + 1
        }
        i = i + 1
    }
    if r0_count != 1 { return 1 }
    0
}

