// Section 32: Tests — rewrite await
// ============================================================================

fn test_async_rewrite_await_instrs() -> i64 with Mut, Panic, Div {
    var sp = async_suspend_point_make(0, 0, 1, 10, 11, 3)
    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    let pos = async_rewrite_await(sp, 10, 20, 200, 201, buf, 0)
    // label + load_imm + binop + branch_true = 4
    if pos != 4 { return 1 }
    0
}

