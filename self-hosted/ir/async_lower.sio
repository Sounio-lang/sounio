fn test_async_lower_module_no_async() -> i64 with Mut, Panic, Div {
    var module = ir_empty_module()
    module.fn_count = 1
    module.functions[0] = async_make_no_await_func()
    let ctx = async_lower_module(module)
    if ctx.machine_count != 0 { return 1 }
    0
}

fn test_async_lower_module_one_async() -> i64 with Mut, Panic, Div {
    var module = ir_empty_module()
    module.fn_count = 2
    module.functions[0] = async_make_no_await_func()
    module.functions[1] = async_make_liveness_test_func()
    let ctx = async_lower_module(module)
    if ctx.machine_count != 1 { return 1 }
    if ctx.machines[0].func_id != 1 { return 2 }
    0
}

fn test_async_lower_module_two_async() -> i64 with Mut, Panic, Div {
    var module = ir_empty_module()
    module.fn_count = 3
    module.functions[0] = async_make_no_await_func()
    module.functions[1] = async_make_liveness_test_func()
    module.functions[2] = async_make_two_await_func()
    let ctx = async_lower_module(module)
    if ctx.machine_count != 2 { return 1 }
    0
}

// ============================================================================
// Section 30: Tests — query / inspection utilities
// ============================================================================

fn test_async_query_state_properties() -> i64 with Mut, Panic, Div {
    let func = async_make_two_await_func()
    var ctx = async_lower_ctx_init(100, 100, 10)
    ctx = async_build_machine(func, 0, ctx)
    let sm = ctx.machines[0]

    if async_machine_state_count(sm) != 3 { return 1 }
    if async_machine_suspend_count(sm) != 2 { return 2 }
    if async_state_is_initial(sm, 0) != true { return 3 }
    if async_state_is_initial(sm, 1) != false { return 4 }
    if async_state_is_final(sm, 2) != true { return 5 }
    if async_state_is_final(sm, 0) != false { return 6 }
    if async_state_id_at(sm, 0) != 0 { return 7 }
    if async_state_id_at(sm, 1) != 1 { return 8 }
    if async_state_id_at(sm, 2) != 2 { return 9 }
    0
}

// ============================================================================
// Section 31: Tests — emit save/restore captures
// ============================================================================

fn test_async_emit_save_restore_captures() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 3
    sm.captured_vars[0] = async_live_var_make(0, 1, 0, false)
    sm.captured_vars[1] = async_live_var_make(1, 1, 1, false)
    sm.captured_vars[2] = async_live_var_make(2, 1, 2, false)

    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    let save_pos = async_emit_save_captures(sm, 50, buf, 0)
    if save_pos != 3 { return 1 }

    var buf2: [IrInstr; 4096] = [ir_nop(); 4096]
    let restore_pos = async_emit_restore_captures(sm, 50, buf2, 0)
    if restore_pos != 3 { return 2 }
    0
}

