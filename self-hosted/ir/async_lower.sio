// ============================================================================
// Section 19: Tests — live variable analysis
// ============================================================================

fn test_async_var_set_basic() -> i64 with Mut, Panic, Div {
    var s = async_var_set_new()
    if s.count != 0 { return 1 }
    s = async_var_set_add(s, 3)
    if s.count != 1 { return 2 }
    if !async_var_set_contains(s, 3) { return 3 }
    if async_var_set_contains(s, 4) { return 4 }
    // Add duplicate
    s = async_var_set_add(s, 3)
    if s.count != 1 { return 5 }
    0
}

fn test_async_var_set_remove() -> i64 with Mut, Panic, Div {
    var s = async_var_set_new()
    s = async_var_set_add(s, 5)
    s = async_var_set_add(s, 10)
    if s.count != 2 { return 1 }
    s = async_var_set_remove(s, 5)
    if s.count != 1 { return 2 }
    if async_var_set_contains(s, 5) { return 3 }
    if !async_var_set_contains(s, 10) { return 4 }
    0
}

fn test_async_var_set_union() -> i64 with Mut, Panic, Div {
    var a = async_var_set_new()
    a = async_var_set_add(a, 1)
    a = async_var_set_add(a, 3)
    var b = async_var_set_new()
    b = async_var_set_add(b, 2)
    b = async_var_set_add(b, 3)
    let u = async_var_set_union(a, b)
    if u.count != 3 { return 1 }
    if !async_var_set_contains(u, 1) { return 2 }
    if !async_var_set_contains(u, 2) { return 3 }
    if !async_var_set_contains(u, 3) { return 4 }
    0
}

fn test_async_var_set_intersect() -> i64 with Mut, Panic, Div {
    var a = async_var_set_new()
    a = async_var_set_add(a, 1)
    a = async_var_set_add(a, 3)
    a = async_var_set_add(a, 5)
    var b = async_var_set_new()
    b = async_var_set_add(b, 3)
    b = async_var_set_add(b, 5)
    b = async_var_set_add(b, 7)
    let inter = async_var_set_intersect(a, b)
    if inter.count != 2 { return 1 }
    if !async_var_set_contains(inter, 3) { return 2 }
    if !async_var_set_contains(inter, 5) { return 3 }
    if async_var_set_contains(inter, 1) { return 4 }
    if async_var_set_contains(inter, 7) { return 5 }
    0
}

fn test_async_live_across_single() -> i64 with Mut, Panic, Div {
    let func = async_make_liveness_test_func()
    // Suspend at index 3.
    // Defined before: r0(idx 0), r1(idx 1), r2(idx 2)
    // Used after: r0(idx 4), r1(idx 5), r3(idx 4,5), r4(idx 5)
    // r3 is defined AT the suspend, not before; r4 defined after.
    // Live across = defs_before intersect uses_after = {r0, r1}
    let live = async_live_across_suspend(func, 3)
    if !async_var_set_contains(live, 0) { return 1 }
    if !async_var_set_contains(live, 1) { return 2 }
    // r2 is defined before but not used after (r2 is src of the await, used AT index 3)
    // Actually r2 is src1 of the await at index 3 — uses_after starts at index 4.
    if async_var_set_contains(live, 2) { return 3 }
    if async_var_set_contains(live, 3) { return 4 }
    0
}

fn test_async_live_across_two_suspends() -> i64 with Mut, Panic, Div {
    let func = async_make_two_await_func()
    // First suspend at index 3:
    // Defined before: r0(0), r1(1), r2(2)
    // Used after indices 4+: r0(4,7), r1(5), r3(4), r4(5), r5(6=await src), r6(7)
    // Live across first: {r0, r1}
    let live0 = async_live_across_suspend(func, 3)
    if !async_var_set_contains(live0, 0) { return 1 }
    if !async_var_set_contains(live0, 1) { return 2 }

    // Second suspend at index 6:
    // Defined before: r0(0), r1(1), r2(2), r3(3), r4(4), r5(5)
    // Used after indices 7+: r0(7), r6(7)
    // Live across second: {r0}
    let live1 = async_live_across_suspend(func, 6)
    if !async_var_set_contains(live1, 0) { return 3 }
    if async_var_set_contains(live1, 1) { return 4 }
    0
}

// ============================================================================
// Section 20: Tests — state splitting
// ============================================================================

fn test_async_split_no_suspend() -> i64 with Mut, Panic, Div {
    let func = async_make_no_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    // No awaits -> single state that is both initial and final
    if sm.state_count != 1 { return 1 }
    if !sm.states[0].is_initial { return 2 }
    if !sm.states[0].is_final { return 3 }
    if sm.states[0].instr_start != 0 { return 4 }
    if sm.states[0].instr_end != 4 { return 5 }
    0
}

fn test_async_split_single_suspend() -> i64 with Mut, Panic, Div {
    let func = async_make_liveness_test_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    // 1 await -> 2 states
    if sm.state_count != 2 { return 1 }

    // State 0: initial, not final, instrs [0, 3)
    if !sm.states[0].is_initial { return 2 }
    if sm.states[0].is_final { return 3 }
    if sm.states[0].instr_start != 0 { return 4 }
    if sm.states[0].instr_end != 3 { return 5 }

    // State 1: not initial, final, instrs [4, 8)
    if sm.states[1].is_initial { return 6 }
    if !sm.states[1].is_final { return 7 }
    if sm.states[1].instr_start != 4 { return 8 }
    if sm.states[1].instr_end != 8 { return 9 }
    0
}

fn test_async_split_two_suspends() -> i64 with Mut, Panic, Div {
    let func = async_make_two_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    // 2 awaits -> 3 states
    if sm.state_count != 3 { return 1 }
    if !sm.states[0].is_initial { return 2 }
    if sm.states[0].is_final { return 3 }
    if sm.states[1].is_initial { return 4 }
    if sm.states[1].is_final { return 5 }
    if sm.states[2].is_initial { return 6 }
    if !sm.states[2].is_final { return 7 }
    0
}

fn test_async_split_three_suspends() -> i64 with Mut, Panic, Div {
    let func = async_make_three_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    // 3 awaits -> 4 states
    if sm.state_count != 4 { return 1 }
    if !sm.states[0].is_initial { return 2 }
    if sm.states[3].is_initial { return 3 }
    if !sm.states[3].is_final { return 4 }
    // Intermediate states neither initial nor final
    if sm.states[1].is_initial { return 5 }
    if sm.states[1].is_final { return 6 }
    if sm.states[2].is_initial { return 7 }
    if sm.states[2].is_final { return 8 }
    0
}

fn test_async_split_state_ids_sequential() -> i64 with Mut, Panic, Div {
    let func = async_make_three_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    var i: i64 = 0
    while i < sm.state_count {
        if sm.states[i as usize].state_id != i {
            return i + 1
        }
        i = i + 1
    }
    0
}

fn test_async_split_suspend_before_after() -> i64 with Mut, Panic, Div {
    let func = async_make_two_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    // Suspend 0: state_before=0, state_after=1
    if sm.suspend_points[0].state_before != 0 { return 1 }
    if sm.suspend_points[0].state_after != 1 { return 2 }
    // Suspend 1: state_before=1, state_after=2
    if sm.suspend_points[1].state_before != 1 { return 3 }
    if sm.suspend_points[1].state_after != 2 { return 4 }
    0
}

