fn test_async_validate_empty_machine() -> i64 with Mut, Panic, Div {
    let sm = async_state_machine_new()
    let err = async_validate_machine(sm)
    // Should fail: no states
    if err == 0 { return 1 }
    0
}

fn test_async_validate_state_ranges_good() -> i64 with Mut, Panic, Div {
    let func = async_make_two_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    let err = async_validate_state_ranges(sm, func.instr_count)
    if err != 0 { return err }
    0
}

// ============================================================================
// Section 28: Tests — name generation
// ============================================================================

fn test_async_name_state_tag() -> i64 with Mut, Panic, Div {
    let n = async_make_name_state_tag()
    if n.len != 9 { return 1 }
    // s=115
    if n.buf[0] != 115 as i8 { return 2 }
    // g=103
    if n.buf[8] != 103 as i8 { return 3 }
    0
}

fn test_async_name_result() -> i64 with Mut, Panic, Div {
    let n = async_make_name_result()
    if n.len != 6 { return 1 }
    // r=114
    if n.buf[0] != 114 as i8 { return 2 }
    // t=116
    if n.buf[5] != 116 as i8 { return 3 }
    0
}

fn test_async_name_capture() -> i64 with Mut, Panic, Div {
    let n0 = async_make_capture_name(0)
    if n0.len != 5 { return 1 }
    // c=99, a=97, p=112, _=95, 0=48
    if n0.buf[0] != 99 as i8 { return 2 }
    if n0.buf[4] != 48 as i8 { return 3 }

    let n5 = async_make_capture_name(5)
    if n5.buf[4] != 53 as i8 { return 4 }  // '5' = 53

    let n12 = async_make_capture_name(12)
    if n12.len != 6 { return 5 }
    // '1'=49, '2'=50
    if n12.buf[4] != 49 as i8 { return 6 }
    if n12.buf[5] != 50 as i8 { return 7 }
    0
}

fn test_async_name_poll() -> i64 with Mut, Panic, Div {
    // Build a name "foo" then make "poll_foo"
    var orig = ir_empty_name()
    orig.buf[0] = 102 as i8  // f
    orig.buf[1] = 111 as i8  // o
    orig.buf[2] = 111 as i8  // o
    orig.len = 3

    let pn = async_make_poll_name(orig)
    // "poll_foo" = 8 chars
    if pn.len != 8 { return 1 }
    if pn.buf[0] != 112 as i8 { return 2 }  // p
    if pn.buf[4] != 95 as i8 { return 3 }   // _
    if pn.buf[5] != 102 as i8 { return 4 }  // f
    if pn.buf[7] != 111 as i8 { return 5 }  // o
    0
}

fn test_async_name_future() -> i64 with Mut, Panic, Div {
    var orig = ir_empty_name()
    orig.buf[0] = 102 as i8  // f
    orig.len = 1
    let fn_name = async_make_future_name(orig)
    // "Future_f" = 8 chars
    if fn_name.len != 8 { return 1 }
    if fn_name.buf[0] != 70 as i8 { return 2 }   // F
    if fn_name.buf[6] != 95 as i8 { return 3 }   // _
    if fn_name.buf[7] != 102 as i8 { return 4 }  // f
    0
}

