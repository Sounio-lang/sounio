// SOIR Disassembler - Human-readable IR output
//
// Converts binary SOIR format to readable text format for inspection and debugging.

fn opcode_name(op: IrOpcode) -> Name with Mut, Panic, Div {
    match op {
        IrOpcode::IrLoadImm => ir_name_from_bytes(76 as i8, 111 as i8, 97 as i8, 100 as i8, 7),  // "LoadImm"
        IrOpcode::IrLoadFloat => ir_name_from_bytes(76 as i8, 111 as i8, 97 as i8, 100 as i8, 9),  // "LoadFloat"
        IrOpcode::IrLoadBool => ir_name_from_bytes(76 as i8, 111 as i8, 97 as i8, 100 as i8, 8),  // "LoadBool"
        IrOpcode::IrLoadString => ir_name_from_bytes(76 as i8, 111 as i8, 97 as i8, 100 as i8, 10),  // "LoadString"
        IrOpcode::IrCopy => ir_name_from_bytes(67 as i8, 111 as i8, 112 as i8, 121 as i8, 4),  // "Copy"
        IrOpcode::IrBinOp => ir_name_from_bytes(66 as i8, 105 as i8, 110 as i8, 79 as i8, 5),  // "BinOp"
        IrOpcode::IrUnaryOp => ir_name_from_bytes(85 as i8, 110 as i8, 97 as i8, 114 as i8, 7),  // "UnaryOp"
        IrOpcode::IrCall => ir_name_from_bytes(67 as i8, 97 as i8, 108 as i8, 108 as i8, 4),  // "Call"
        IrOpcode::IrReturn => ir_name_from_bytes(82 as i8, 101 as i8, 116 as i8, 117 as i8, 6),  // "Return"
        IrOpcode::IrJump => ir_name_from_bytes(74 as i8, 117 as i8, 109 as i8, 112 as i8, 4),  // "Jump"
        IrOpcode::IrBranchTrue => ir_name_from_bytes(66 as i8, 114 as i8, 97 as i8, 110 as i8, 10),  // "BranchTrue"
        IrOpcode::IrBranchFalse => ir_name_from_bytes(66 as i8, 114 as i8, 97 as i8, 110 as i8, 11),  // "BranchFalse"
        IrOpcode::IrFieldGet => ir_name_from_bytes(70 as i8, 105 as i8, 101 as i8, 108 as i8, 8),  // "FieldGet"
        IrOpcode::IrFieldSet => ir_name_from_bytes(70 as i8, 105 as i8, 101 as i8, 108 as i8, 8),  // "FieldSet"
        IrOpcode::IrIndexGet => ir_name_from_bytes(73 as i8, 110 as i8, 100 as i8, 101 as i8, 8),  // "IndexGet"
        IrOpcode::IrIndexSet => ir_name_from_bytes(73 as i8, 110 as i8, 100 as i8, 101 as i8, 8),  // "IndexSet"
        IrOpcode::IrAlloc => ir_name_from_bytes(65 as i8, 108 as i8, 108 as i8, 111 as i8, 5),  // "Alloc"
        IrOpcode::IrLabel => ir_name_from_bytes(76 as i8, 97 as i8, 98 as i8, 101 as i8, 5),  // "Label"
        IrOpcode::IrNop => ir_name_from_bytes(78 as i8, 111 as i8, 112 as i8, 0 as i8, 3),  // "Nop"
        IrOpcode::IrPhi => ir_name_from_bytes(80 as i8, 104 as i8, 105 as i8, 0 as i8, 3),  // "Phi"
    }
}

fn binop_name(op: BinaryOp) -> Name with Mut, Panic, Div {
    match op {
        BinaryOp::OpAdd => ir_name_from_bytes(65 as i8, 100 as i8, 100 as i8, 0 as i8, 3),  // "Add"
        BinaryOp::OpSub => ir_name_from_bytes(83 as i8, 117 as i8, 98 as i8, 0 as i8, 3),  // "Sub"
        BinaryOp::OpMul => ir_name_from_bytes(77 as i8, 117 as i8, 108 as i8, 0 as i8, 3),  // "Mul"
        BinaryOp::OpDiv => ir_name_from_bytes(68 as i8, 105 as i8, 118 as i8, 0 as i8, 3),  // "Div"
        BinaryOp::OpRem => ir_name_from_bytes(82 as i8, 101 as i8, 109 as i8, 0 as i8, 3),  // "Rem"
        BinaryOp::OpEq => ir_name_from_bytes(69 as i8, 113 as i8, 0 as i8, 0 as i8, 2),  // "Eq"
        BinaryOp::OpNe => ir_name_from_bytes(78 as i8, 101 as i8, 0 as i8, 0 as i8, 2),  // "Ne"
        BinaryOp::OpLt => ir_name_from_bytes(76 as i8, 116 as i8, 0 as i8, 0 as i8, 2),  // "Lt"
        BinaryOp::OpLe => ir_name_from_bytes(76 as i8, 101 as i8, 0 as i8, 0 as i8, 2),  // "Le"
        BinaryOp::OpGt => ir_name_from_bytes(71 as i8, 116 as i8, 0 as i8, 0 as i8, 2),  // "Gt"
        BinaryOp::OpGe => ir_name_from_bytes(71 as i8, 101 as i8, 0 as i8, 0 as i8, 2),  // "Ge"
        BinaryOp::OpAnd => ir_name_from_bytes(65 as i8, 110 as i8, 100 as i8, 0 as i8, 3),  // "And"
        BinaryOp::OpOr => ir_name_from_bytes(79 as i8, 114 as i8, 0 as i8, 0 as i8, 2),  // "Or"
        BinaryOp::OpBitAnd => ir_name_from_bytes(66 as i8, 105 as i8, 116 as i8, 65 as i8, 6),  // "BitAnd"
        BinaryOp::OpBitOr => ir_name_from_bytes(66 as i8, 105 as i8, 116 as i8, 79 as i8, 5),  // "BitOr"
        BinaryOp::OpBitXor => ir_name_from_bytes(66 as i8, 105 as i8, 116 as i8, 88 as i8, 6),  // "BitXor"
        BinaryOp::OpShl => ir_name_from_bytes(83 as i8, 104 as i8, 108 as i8, 0 as i8, 3),  // "Shl"
        BinaryOp::OpShr => ir_name_from_bytes(83 as i8, 104 as i8, 114 as i8, 0 as i8, 3),  // "Shr"
        BinaryOp::OpConcat => ir_name_from_bytes(67 as i8, 111 as i8, 110 as i8, 99 as i8, 6),  // "Concat"
        BinaryOp::OpRange => ir_name_from_bytes(82 as i8, 97 as i8, 110 as i8, 103 as i8, 5),  // "Range"
        BinaryOp::OpRangeInclusive => ir_name_from_bytes(82 as i8, 97 as i8, 110 as i8, 103 as i8, 14),  // "RangeInclusive"
        // Findings 11 (#2084): unsigned counterparts. Distinct labels so
        // disassembly reveals which operand type the lowering actually
        // emitted — without these, the user-facing IR dump would show
        // "Div" / "Rem" / "Shr" on u64 operands and obscure the bug.
        BinaryOp::OpUDiv => ir_name_from_bytes(85 as i8, 68 as i8, 105 as i8, 118 as i8, 4),  // "UDiv"
        BinaryOp::OpURem => ir_name_from_bytes(85 as i8, 82 as i8, 101 as i8, 109 as i8, 4),  // "URem"
        BinaryOp::OpUShr => ir_name_from_bytes(85 as i8, 83 as i8, 104 as i8, 114 as i8, 4),  // "UShr"
    }
}

fn unaryop_name(op: UnaryOp) -> Name with Mut, Panic, Div {
    match op {
        UnaryOp::OpNeg => ir_name_from_bytes(78 as i8, 101 as i8, 103 as i8, 0 as i8, 3),  // "Neg"
        UnaryOp::OpNot => ir_name_from_bytes(78 as i8, 111 as i8, 116 as i8, 0 as i8, 3),  // "Not"
        UnaryOp::OpRef => ir_name_from_bytes(82 as i8, 101 as i8, 102 as i8, 0 as i8, 3),  // "Ref"
        UnaryOp::OpRefMut => ir_name_from_bytes(82 as i8, 101 as i8, 102 as i8, 77 as i8, 6),  // "RefMut"
        UnaryOp::OpDeref => ir_name_from_bytes(68 as i8, 101 as i8, 114 as i8, 101 as i8, 5),  // "Deref"
    }
}

fn ir_print_name(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i] as i64)
        i = i + 1
    }
}

fn ir_print_float_positive(val: f64) with IO, Mut, Panic, Div {
    let int_part = val as i64
    print_int(int_part)
    print(".")
    var frac: f64 = val - (int_part as f64)
    var digits: i64 = 0
    while digits < 6 {
        frac = frac * 10.0
        let d = frac as i64
        // Print single digit 0-9
        print_int(d)
        frac = frac - (d as f64)
        digits = digits + 1
    }
}

fn ir_print_float(val: f64) with IO, Mut, Panic, Div {
    if val < 0.0 {
        print("-")
        ir_print_float_positive(0.0 - val)
    } else {
        ir_print_float_positive(val)
    }
}

fn print_instr(idx: i64, instr: IrInstr) with IO, Mut, Panic, Div {
    print("  ")
    print_int(idx)
    print(": ")

    match instr.op {
        IrOpcode::IrLoadImm => {
            print("IrLoadImm dst=v")
            print_int(instr.dst)
            print(" imm=")
            print_int(instr.imm_i64)
        }
        IrOpcode::IrLoadFloat => {
            print("IrLoadFloat dst=v")
            print_int(instr.dst)
            print(" imm=")
            ir_print_float(instr.imm_f64)
        }
        IrOpcode::IrLoadBool => {
            print("IrLoadBool dst=v")
            print_int(instr.dst)
            print(" imm=")
            if instr.imm_i64 != 0 {
                print("true")
            } else {
                print("false")
            }
        }
        IrOpcode::IrLoadString => {
            print("IrLoadString dst=v")
            print_int(instr.dst)
            print(" idx=")
            print_int(instr.imm_i64)
            print(" \"")
            ir_print_name(instr.name)
            print("\"")
        }
        IrOpcode::IrCopy => {
            print("IrCopy dst=v")
            print_int(instr.dst)
            print(" src=v")
            print_int(instr.src1)
        }
        IrOpcode::IrBinOp => {
            print("IrBinOp dst=v")
            print_int(instr.dst)
            print(" src1=v")
            print_int(instr.src1)
            print(" op=")
            ir_print_name(binop_name(instr.bin_op))
            print(" src2=v")
            print_int(instr.src2)
        }
        IrOpcode::IrUnaryOp => {
            print("IrUnaryOp dst=v")
            print_int(instr.dst)
            print(" op=")
            ir_print_name(unaryop_name(instr.un_op))
            print(" src=v")
            print_int(instr.src1)
        }
        IrOpcode::IrCall => {
            print("IrCall dst=v")
            print_int(instr.dst)
            print(" fn=")
            ir_print_name(instr.name)
            print("(")
            print_int(instr.arg_count)
            print(" args)")
        }
        IrOpcode::IrReturn => {
            print("IrReturn src=v")
            print_int(instr.src1)
        }
        IrOpcode::IrJump => {
            print("IrJump label=L")
            print_int(instr.label_id)
        }
        IrOpcode::IrBranchTrue => {
            print("IrBranchTrue cond=v")
            print_int(instr.src1)
            print(" label=L")
            print_int(instr.label_id)
        }
        IrOpcode::IrBranchFalse => {
            print("IrBranchFalse cond=v")
            print_int(instr.src1)
            print(" label=L")
            print_int(instr.label_id)
        }
        IrOpcode::IrFieldGet => {
            print("IrFieldGet dst=v")
            print_int(instr.dst)
            print(" base=v")
            print_int(instr.src1)
            print(" field=")
            ir_print_name(instr.name)
        }
        IrOpcode::IrFieldSet => {
            print("IrFieldSet base=v")
            print_int(instr.src1)
            print(" field=")
            ir_print_name(instr.name)
            print(" src=v")
            print_int(instr.src2)
        }
        IrOpcode::IrIndexGet => {
            print("IrIndexGet dst=v")
            print_int(instr.dst)
            print(" base=v")
            print_int(instr.src1)
            print(" idx=v")
            print_int(instr.src2)
        }
        IrOpcode::IrIndexSet => {
            print("IrIndexSet base=v")
            print_int(instr.src1)
            print(" idx=v")
            print_int(instr.src2)
            print(" src=v")
            print_int(instr.imm_i64)
        }
        IrOpcode::IrAlloc => {
            print("IrAlloc dst=v")
            print_int(instr.dst)
            print(" size=")
            print_int(instr.imm_i64)
        }
        IrOpcode::IrLabel => {
            print("Label L")
            print_int(instr.label_id)
            print(":")
        }
        IrOpcode::IrNop => {
            print("Nop")
        }
        IrOpcode::IrPhi => {
            print("IrPhi dst=v")
            print_int(instr.dst)
        }
    }

    print("\n")
}

fn print_function(func: IrFunction) with IO, Mut, Panic, Div {
    print("fn ")
    ir_print_name(func.name)
    print("(")

    var i: i64 = 0
    while i < func.param_count {
        if i > 0 {
            print(", ")
        }
        print("v")
        print_int(func.param_regs[i])
        i = i + 1
    }

    print(") {\n")
    print("  // reg_count=")
    print_int(func.reg_count)
    print(" label_count=")
    print_int(func.label_count)
    print("\n")

    var j: i64 = 0
    while j < func.instr_count {
        print_instr(j, ir_arena_load(ir_region_slot_r(func.region, (j))))
        j = j + 1
    }

    print("}\n")
}

fn disassemble_module(module: IrModule) with IO, Mut, Panic, Div {
    print("// SOIR v1 Module\n")
    print("// Functions: ")
    print_int(module.fn_count)
    print("\n")
    print("// Strings: ")
    print_int(module.string_count)
    print("\n\n")

    print("// String Table:\n")
    var i: i64 = 0
    while i < module.string_count {
        print("  [")
        print_int(i)
        print("] \"")
        ir_print_name(module.string_table[i])
        print("\"\n")
        i = i + 1
    }
    print("\n")

    var j: i64 = 0
    while j < module.fn_count {
        print_function(ir_fn_get(&module, j))
        print("\n")
        j = j + 1
    }
}

fn disassemble_from_file(path: [i8; 256]) with IO, Mut, Panic, Div, Alloc {
    // Read SOIR file
    var buf: [i8; 131072] = [0; 131072]
    // TODO: file I/O to read into buf

    // Deserialize
    let module = deserialize_ir_module(buf, 131072)

    // Disassemble
    disassemble_module(module)
}
