// Build a heap IrEpistemicSection in THIS leaf's own short frame and return only
// the Box pointer. Callers that would otherwise hold the MB-scale struct in a deep
// stack frame (e.g. the native streaming driver) must use this to avoid lean_single's
// layout-sensitive stale-stack crash. Inlining Box::new(ir_empty_epistemic_section())
// at the caller does NOT help — the struct literal is still built on the caller frame.
pub fn ir_empty_epistemic_section_boxed() -> Box<IrEpistemicSection> with Alloc, Mut, Panic, Div {
    var ep = ir_empty_epistemic_section()
    Box::new(ep)
}

// #1729: keep the function table out of IrModule's value representation. Each
// module owns a small header and grows through heap chunks, so copying a module
// handle cannot materialize tens of MiB on the stack.
pub struct IrFunctionChunk {
    pub entries: [IrFunction; 512],
    pub next: *mut IrFunctionChunk,
}

pub struct IrFunctionTable {
    pub head: *mut IrFunctionChunk,
    pub chunks: [i64; 32],
    pub chunk_count: i64,
    pub status: i64,
}

pub struct IrModule {
    pub functions: *mut IrFunctionTable,
    pub fn_count: i64,
    pub string_table: [Name; 16384],
    pub string_count: i64,
    pub epistemic: IrEpistemicSection,
    pub algebras: IrAlgebraTable,
    pub ontologies: IrOntologyTable,
    pub prof_counters: [IrProfCounterInfo; 64],
    pub prof_counter_count: i64,
    pub export_names: [Name; 64],
    pub export_count: i64,
    pub bss_total_size: i64,
}

pub struct IrEnvBinding {
    name: Name,
    reg: i64,
    is_mut: bool,
    depth: i64,
}

pub struct IrEnvList {
    head: IrEnvBinding,
    tail: Option<Box<IrEnvList>>,
}

pub struct IrValidatedPatchStats {
    pub patched_functions: i64,
    pub patched_calls: i64,
    pub fallback_insertions: i64,
}

pub fn ir_empty_validated_patch_stats() -> IrValidatedPatchStats {
    IrValidatedPatchStats {
        patched_functions: 0,
        patched_calls: 0,
        fallback_insertions: 0,
    }
}

pub struct IrLowerResult {
    module: IrModule,
    error_count: i64,
    had_error: bool,
    patch_stats: IrValidatedPatchStats,
}

// ============================================================================
// Struct layout tracking (Phase 3.2)
// ============================================================================

// A single struct field: name + sequential index
// NAMES ARE INTERNED IDS, NOT Names. A Name is 136 bytes; this entry held two
// of them, and StructLayoutEntry holds 64 entries, so a single layout cost
// ~18.6 KB and the table ~4.8 MB at 256 entries. That is what made the capacity
// unraisable: ir_register_knowledge_layout takes StructLayoutTable BY VALUE and
// returns it by value, so growing the table to fit the compiler's own closure
// (693 struct types) put ~57 MB on the stack per call and segfaulted lowering.
//
// Two i64 pool ids instead of two Names take the entry from ~18.6 KB to ~2.1 KB.
// The pool is IR_NAME_POOL_BUF in this file, already used for function names.
//
// id 0 IS the empty name -- ir_intern_name returns 0 for an empty input and
// ir_name_at(0) gives it back -- so a zeroed entry still means "no name", which
// is what BSS-zeroed globals in this tree rely on.
pub struct StructFieldEntry {
    name_id: i64,
    index: i64,
    is_float: i64,
    // Element type name of a fixed-size array field (`[T; N]` -> "T"); id 0 for
    // non-array fields. Used to dispatch trait-method calls on a struct array
    // element (`a.c[i].m()`) to the real `<T>_<method>` instead of a hardcoded
    // fallback.
    elem_type_name_id: i64,
    // #1479: element count of a `[T; N]` field, ONLY when T is a WORD SCALAR
    // (i8/u8 .. i64/u64, f32/f64) and N > 0. ZERO in every other case, which
    // includes "not an array", "element is a struct or a nested array", and
    // "unknown".
    //
    // The zero-means-unknown encoding is deliberate, not an accident of the
    // default. A struct literal in this language may OMIT fields, and an
    // omitted field reads back as zero. Had a known length been representable
    // as 0, any site that forgot this field would present a plain scalar field
    // as a zero-length array, and the deep copy would replace its live value
    // with a fresh empty object. Only a strictly POSITIVE value copies.
    word_scalar_array_len: i64,
    // #1479: the field own declared type name when the type is written as a
    // plain named type (`inner: Inner` -> "Inner"); interned id 0 otherwise.
    // Zero is again the safe default: the deep copy recurses only when this id
    // resolves to a REGISTERED struct layout, which no primitive name does.
    // Ported onto main's interned-id representation (was `Name` on the PR).
    named_type_name_id: i64,
}

pub struct StructLayoutEntry {
    type_name: Name,
    fields: [StructFieldEntry; 64],
    field_count: i64,
}

// Table of all known struct layouts (populated during lowering)
// CAPACITY 1024, raised from 256. The compiler's own closure (120 modules)
// declares 693 distinct struct types.
//
// THERE ARE NINE CAPACITY GUARDS on this table across ir/lower.sio, not the
// seven a first sweep finds. An attempt at 512 raised seven of them and failed
// with the identical message and the identical error count, which reads like
// "the raise did nothing" when it actually meant "lower.sio:9933 and :10039 are
// still at the old cap".
//
// Only ONE of the nine raises a diagnostic; the others skip in silence. The
// error count is therefore a count of attempts through the guard that speaks,
// never the shortfall. DO NOT SIZE THIS TABLE FROM IT -- reading "8 over 256"
// as "needs ~264" is what sent the first attempt to 512.
//
// The entry is interned (see StructFieldEntry below): two i64 pool ids instead
// of two 136-byte Names take it from ~18.6 KB to ~2.1 KB, and this table from
// ~19 MB to ~2.1 MB at 1024. That matters because ir_register_knowledge_layout
// takes StructLayoutTable BY VALUE and returns it by value, so every call
// copies the whole thing -- twice.
//
// (An earlier revision of this note blamed a SIGSEGV at 1024 on those by-value
// copies. That was wrong: the crash was a `ulimit -s 524288` in the measuring
// shell, which LOWERS the stack on a host whose default is unlimited. The
// interning is still right, for the reason above, but it was never what fixed
// the crash.)
pub struct StructLayoutTable {
    entries: [StructLayoutEntry; 1024],
    count: i64,
}

pub fn empty_struct_field_entry() -> StructFieldEntry {
    StructFieldEntry { name_id: 0, index: 0, is_float: 0, elem_type_name_id: 0, word_scalar_array_len: 0, named_type_name_id: 0 }
}

pub fn empty_struct_layout_entry() -> StructLayoutEntry {
    StructLayoutEntry {
        type_name: ir_empty_name(),
        fields: [empty_struct_field_entry(); 64],
        field_count: 0,
    }
}

pub fn empty_struct_layout_table() -> StructLayoutTable {
    StructLayoutTable {
        entries: [empty_struct_layout_entry(); 1024],
        count: 0,
    }
}

// ============================================================================
// Enum discriminant tracking (Phase 3.1)
// ============================================================================

// Maps enum variant path "EnumName::Variant" to its discriminant value
pub struct EnumVariantEntry {
    enum_name: Name,
    variant_name: Name,
    discriminant: i64,
}

pub struct EnumVariantTable {
    entries: [EnumVariantEntry; 4096],
    count: i64,
}

fn empty_enum_variant_entry() -> EnumVariantEntry {
    EnumVariantEntry {
        enum_name: ir_empty_name(),
        variant_name: ir_empty_name(),
        discriminant: 0,
    }
}

pub fn empty_enum_variant_table() -> EnumVariantTable {
    EnumVariantTable {
        entries: [empty_enum_variant_entry(); 4096],
        count: 0,
    }
}

// Mangle a method name: "TypeName" + "_" + "method_name"
pub fn ir_mangle_method_name(type_name: Name, method_name: Name) -> Name with Mut, Panic, Div {
    var result = Name { buf: [0; 128], len: 0 }
    // Copy type_name
    var i: i64 = 0
    while i < type_name.len && result.len < 127 {
        result.buf[result.len] = type_name.buf[i]
        result.len = result.len + 1
        i = i + 1
    }
    // Add underscore separator
    if result.len < 127 {
        result.buf[result.len] = 95  // '_'
        result.len = result.len + 1
    }
    // Copy method_name
    var j: i64 = 0
    while j < method_name.len && result.len < 128 {
        result.buf[result.len] = method_name.buf[j]
        result.len = result.len + 1
        j = j + 1
    }
    result
}

pub fn ir_empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

pub(crate) fn ir_empty_prof_counter_info() -> IrProfCounterInfo {
    IrProfCounterInfo { fn_id: -1, fn_name: ir_empty_name(), counter_id: -1 }
}

// ============================================================================
// Interned instruction names
// ============================================================================
//
// WHY IrInstr DOES NOT CARRY A Name.
//
// `Name` is `{ buf: [i8; 128], len: i64 }` = 136 bytes, and IrInstr used to
// hold one inline. That made the instruction ~248 bytes, of which 55% was a
// buffer that MOST INSTRUCTIONS NEVER USE — an add, a jump, a label, a return
// all carried 128 zero bytes each. Multiplied out through
// `IrFunction.instrs: [IrInstr; 4096]` and `IrModule.functions:
// [IrFunction; 2048]`, that was 2.1 GB of the shipped compiler's 3.40 GB BSS,
// and it is why IR_MAX_FUNCS could not be raised.
//
// Measured 2026-08-04: main.sio's own 120-module import closure declares 10697
// functions against IR_MAX_FUNCS = 2048, and a name-based reachability census
// from `main` leaves 5997 of them live — 3988 even with the entire test suite
// cut out of the call graph. Cross-module DCE, working perfectly, does not fit
// the compiler into its own IrModule. Halving the instruction does.
//
// The pool is GLOBAL rather than per-module on purpose: ir_merge_modules_into
// copies functions between modules, and per-module ids would have to be
// remapped at every merge — a silent-miscompile shape if one site were missed.
// Global ids are stable across merges by construction.
//
// Id 0 is always the empty name, so a zero-initialised IrInstr (BSS, ir_nop,
// any `[ir_nop(); N]` fill) already reads as unnamed without touching the pool.
pub let IR_NAME_POOL_MAX: i64 = 65536

// PARALLEL FLAT ARRAYS, NOT `[Name; N]`. A global whose element is a struct
// containing an inline array is miscompiled — measured 2026-08-04 with a
// minimal probe (a 4096-entry global of `struct { buf: [i8;128], len: i64 }`,
// two writes then two reads) which SIGSEGVs, while the identical program over
// parallel `[i8; N*128]` + `[i64; N]` round-trips exactly. The first shape is
// what this pool was written as, and it turned every string literal in every
// compiled program into nothing at all — the compiler still exited 0.
//
// No initialisers, for two more reasons. The seed (lean_single) rejects a
// `Name { buf: [0; 128], len: 0 }` fill literal in a global, and this compiler
// BSS-zeroes `var` initialisers anyway, so a non-zero one would be a lie that
// holds on one engine and not the other. Every invariant here is therefore
// stated so that ALL-ZERO IS THE CORRECT INITIAL STATE: ids are 1-based,
// IR_NAME_POOL_COUNT counts what is stored, and an all-zero index means empty.
var IR_NAME_POOL_BUF: [i8; 8388608]
var IR_NAME_POOL_LEN: [i64; 65536]
var IR_NAME_POOL_COUNT: i64 = 0
// Set when the pool fills. Interning then returns 0 (the empty name), which is
// wrong but VISIBLE — ir_name_pool_overflowed() lets a driver refuse rather
// than emit code with silently blanked symbol names.
var IR_NAME_POOL_OVERFLOW: bool = false

pub fn ir_name_pool_count() -> i64 {
    IR_NAME_POOL_COUNT
}

pub fn ir_name_pool_overflowed() -> bool {
    IR_NAME_POOL_OVERFLOW
}

// Open-addressed index over the pool: slot -> id, 0 meaning empty. Interning
// runs once per INSTRUCTION CONSTRUCTED, which is millions of times on a
// self-compile, while the pool holds one entry per DISTINCT name — a few
// thousand. A linear scan would be the product of those two numbers, so the
// index is not an optimisation, it is what makes interning affordable at all.
// Twice the pool size keeps the load factor at 50%.
let IR_NAME_SLOTS: i64 = 131072

var IR_NAME_INDEX: [i64; 131072]

fn ir_name_hash(n: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 5381
    var i: i64 = 0
    while i < n.len && i < 128 {
        h = h * 33 + (n.buf[i as usize] as i64)
        i = i + 1
    }
    if h < 0 { 0 - h } else { h }
}

// Ids are 1-BASED: id k holds IR_NAME_POOL[k - 1]. 0 means "no name", which is
// what a zero-filled IrInstr already reads as, so nothing has to be seeded.
pub fn ir_intern_name(n: Name) -> i64 with Mut, Panic, Div {
    if n.len <= 0 {
        return 0
    }
    var slot = ir_name_hash(n) % IR_NAME_SLOTS
    var probes: i64 = 0
    while probes < IR_NAME_SLOTS {
        let id = IR_NAME_INDEX[slot as usize]
        if id == 0 {
            if IR_NAME_POOL_COUNT >= IR_NAME_POOL_MAX {
                IR_NAME_POOL_OVERFLOW = true
                return 0
            }
            let fresh = IR_NAME_POOL_COUNT + 1
            ir_name_pool_store(fresh, n)
            IR_NAME_POOL_COUNT = fresh
            IR_NAME_INDEX[slot as usize] = fresh
            return fresh
        }
        // Compare the NAME, not the hash: a collision must probe on, not alias
        // two different symbols onto one id.
        if ir_name_pool_eq(id, n) {
            return id
        }
        slot = (slot + 1) % IR_NAME_SLOTS
        probes = probes + 1
    }
    IR_NAME_POOL_OVERFLOW = true
    0
}

// id -> Name. Out of range reads as the empty name rather than trapping: an id
// that escaped its pool is a bug, but blanking one symbol is survivable where a
// panic in the middle of codegen is not.
fn ir_name_pool_store(id: i64, n: Name) with Mut, Panic, Div {
    let base = (id - 1) * 128
    var i: i64 = 0
    while i < n.len && i < 128 {
        IR_NAME_POOL_BUF[(base + i) as usize] = n.buf[i as usize]
        i = i + 1
    }
    IR_NAME_POOL_LEN[(id - 1) as usize] = n.len
}

// Compare without materialising the pooled Name: this runs on every probe of
// every intern, which is the hot path of the whole pass.
fn ir_name_pool_eq(id: i64, n: Name) -> bool with Mut, Panic, Div {
    if IR_NAME_POOL_LEN[(id - 1) as usize] != n.len {
        return false
    }
    let base = (id - 1) * 128
    var i: i64 = 0
    while i < n.len && i < 128 {
        if IR_NAME_POOL_BUF[(base + i) as usize] != n.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

pub fn ir_name_at(id: i64) -> Name with Mut, Panic, Div {
    if id <= 0 || id > IR_NAME_POOL_COUNT || id > IR_NAME_POOL_MAX {
        return ir_empty_name()
    }
    var out = ir_empty_name()
    let base = (id - 1) * 128
    let n = IR_NAME_POOL_LEN[(id - 1) as usize]
    var i: i64 = 0
    while i < n && i < 128 {
        out.buf[i as usize] = IR_NAME_POOL_BUF[(base + i) as usize]
        i = i + 1
    }
    out.len = n
    out
}

// Compare an interned id against a Name without materialising the pool entry
// when the ids happen to match.
pub fn ir_name_id_eq(id: i64, n: Name) -> bool with Mut, Panic, Div {
    ir_name_eq(ir_name_at(id), n)
}

pub fn ir_name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i] != b.buf[i] {
            return false
        }
        i = i + 1
    }
    true
}

pub fn ir_name_from_bytes(a: i8, b: i8, c: i8, d: i8, len: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: len }
    if len > 0 { n.buf[0] = a }
    if len > 1 { n.buf[1] = b }
    if len > 2 { n.buf[2] = c }
    if len > 3 { n.buf[3] = d }
    n
}

fn ir_name_from_string_list(sl: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: sl.head_len }
    var i: i64 = 0
    while i < sl.head_len && i < 128 {
        n.buf[i] = sl.head_buf[i]
        i = i + 1
    }
    n
}

pub fn ir_path_first_name(p: AstPath) -> Name with Mut, Panic, Div {
    if p.seg_count <= 0 {
        ir_empty_name()
    } else {
        ir_name_from_string_list(p.segments)
    }
}

// Get the last segment of a path (e.g., "Variant" from "Enum::Variant")
pub fn ir_path_last_name(p: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if p.seg_count <= 0 {
        ir_empty_name()
    } else if p.seg_count == 1 {
        ir_name_from_string_list(p.segments)
    } else {
        ir_string_list_last(p.segments)
    }
}

fn ir_string_list_last(sl: StringList) -> Name with Mut, Panic, Div, Alloc {
    match sl.tail {
        Some(rest) => ir_string_list_last(*rest),
        _ => ir_name_from_string_list(sl),
    }
}

// Second-to-last segment of a path (e.g. "Enum" from "Enum::Variant", and from
// "module::Enum::Variant" too). Empty name when the path has fewer than two
// segments, so callers can fall back to an unqualified lookup.
fn ir_string_list_second_last(sl: StringList) -> Name with Mut, Panic, Div, Alloc {
    match sl.tail {
        Some(rest) => {
            match (*rest).tail {
                Some(_) => ir_string_list_second_last(*rest),
                _ => ir_name_from_string_list(sl),
            }
        }
        _ => ir_empty_name(),
    }
}

// Get the qualifier of a path: "Color" from "Color::Mark".
// Enum variant discriminants restart at 0 per enum, so a lookup keyed only on
// the variant name collides across enums that share a variant name. Callers
// pair this with the variant name to key the lookup by the full path.
pub fn ir_path_qualifier_name(p: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if p.seg_count <= 1 {
        ir_empty_name()
    } else {
        ir_string_list_second_last(p.segments)
    }
}

// Check if a name is "Some" (for Option matching)
pub fn ir_name_is_some(n: Name) -> bool {
    n.len == 4 && n.buf[0] == 83 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 109 as i8 && n.buf[3] == 101 as i8
}

// Check if a name is "Box" (for Box::new lowering)
pub fn ir_name_is_box(n: Name) -> bool {
    n.len == 3 && n.buf[0] == 66 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 120 as i8
}

// Check if a name is "None" (for Option matching)
pub fn ir_name_is_none(n: Name) -> bool {
    n.len == 4 && n.buf[0] == 78 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 110 as i8 && n.buf[3] == 101 as i8
}

pub fn ir_empty_reg_list() -> Option<Box<IrRegList>> {
    None
}

pub fn ir_reg_list_single(reg: i64) -> IrRegList {
    IrRegList { head: reg, tail: None }
}

pub fn ir_reg_list_cons(reg: i64, tail: Option<Box<IrRegList>>) -> IrRegList {
    IrRegList { head: reg, tail: tail }
}

pub fn ir_reg_list_append(list: IrRegList, reg: i64) -> IrRegList with Alloc {
    match list.tail {
        Some(rest) => IrRegList {
            head: list.head,
            tail: Some(Box::new(ir_reg_list_append(*rest, reg))),
        }
        _ => IrRegList {
            head: list.head,
            tail: Some(Box::new(IrRegList { head: reg, tail: None })),
        }
    }
}

pub fn ir_reg_list_count(opt: Option<Box<IrRegList>>) -> i64 with Alloc {
    match opt {
        Some(list) => 1 + ir_reg_list_count((*list).tail),
        _ => 0,
    }
}

fn ir_empty_env() -> Option<Box<IrEnvList>> {
    None
}

fn ir_env_push(env: Option<Box<IrEnvList>>, b: IrEnvBinding) -> Option<Box<IrEnvList>> with Alloc {
    Some(Box::new(IrEnvList {
        head: b,
        tail: env,
    }))
}

fn ir_env_lookup(env: Option<Box<IrEnvList>>, name: Name, depth: i64) -> i64 with Mut, Panic, Div, Alloc {
    var current = env
    while true {
        match current {
            Some(list) => {
                let b = (*list).head
                if b.depth <= depth && ir_name_eq(b.name, name) {
                    return b.reg
                }
                current = (*list).tail
            }
            _ => break
        }
    }
    IR_INVALID_REG
}

pub fn ir_instr_new(op: IrOpcode) -> IrInstr {
    IrInstr {
        op: op,
        dst: IR_INVALID_REG,
        src1: IR_INVALID_REG,
        src2: IR_INVALID_REG,
        imm_i64: 0,
        imm_f64: 0.0,
        label_id: IR_INVALID_LABEL,
        fn_id: IR_INVALID_FN,
        field_idx: -1,
        imm_flags: 0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name_id: 0,
        call_args: ir_empty_reg_list(),
        arg_count: 0,
    }
}

