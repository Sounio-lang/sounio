// IR definitions for self-hosted post-checker phases

module ir::ir

use parser::ast::{Name, StringList, AstPath, BinaryOp, UnaryOp, CompareOp, make_name, name_eq, empty_name}
use check::types::{TypeEntry, empty_type_entry}

// These caps gate what the self-hosted pipeline can lower and execute.
// Keep them aligned with the fixed backing storage in IrModule/IrFunction so
// the lowering path can use the capacity that is already physically allocated.
pub let IR_MAX_FUNCS: i64 = 2048
pub let IR_MAX_STRINGS: i64 = 4096
pub let IR_MAX_INSTRS: i64 = 1024
pub let IR_MAX_PARAMS: i64 = 64
pub let IR_INVALID_REG: i64 = -1
pub let IR_INVALID_LABEL: i64 = -1
pub let IR_INVALID_FN: i64 = -1
pub let IR_MAX_EPI_MODEL_FAMILIES: i64 = 32
pub let IR_MAX_EPI_POLICIES: i64 = 32
pub let IR_MAX_EPI_DECISION_POLICIES: i64 = 32
pub let IR_MAX_EPI_DEFERRAL_POLICIES: i64 = 32
pub let IR_MAX_EPI_ACQUISITION_POLICIES: i64 = 32
pub let IR_MAX_EPI_RECOURSE_POLICIES: i64 = 32
pub let IR_MAX_EPI_VALIDATIONS: i64 = 32
pub let IR_MAX_EPI_CONTESTS: i64 = 64
pub let IR_MAX_EPI_MECHANISTIC_REPORTS: i64 = 32
pub let IR_MAX_EPI_POSTERIOR_WEIGHTS: i64 = 32
pub let IR_MAX_EPI_COUNTEREXAMPLES: i64 = 32
pub let IR_MAX_EPI_AUDITS: i64 = 32
pub let IR_MAX_EPI_CONTEST_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ROBUST_PROOFS: i64 = 64
pub let IR_MAX_EPI_DECISION_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_DEFERRED_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_DEFERRED_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ACQUISITION_PLANS: i64 = 64
pub let IR_MAX_EPI_ACQUISITION_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_RECOURSE_PLANS: i64 = 64
pub let IR_MAX_EPI_RECOURSE_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_POLICIES: i64 = 32
pub let IR_MAX_EPI_ALTERNATIVE_FRONTIERS: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_CANDIDATES: i64 = 128
pub let IR_MAX_EPI_ALTERNATIVE_SETS: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_TRANSITION_POLICIES: i64 = 32
pub let IR_MAX_EPI_TRANSITION_PROTOCOLS: i64 = 32
pub let IR_MAX_EPI_TRANSITION_STEPS: i64 = 64
pub let IR_MAX_EPI_TRANSITION_PLANS: i64 = 64
pub let IR_MAX_EPI_TRANSITION_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_MONITORING_POLICIES: i64 = 32
pub let IR_MAX_EPI_OBSERVED_TRANSITIONS: i64 = 64
pub let IR_MAX_EPI_ROLLBACK_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_VALIDATED_MANIFESTS: i64 = 64
pub let IR_MAX_EPI_HYPER_EXPRS: i64 = 128

let SOUNIO_ABI_VERSION: i64 = 1
let SOUNIO_RUNTIME_VERSION_MAJOR: i64 = 1
let SOUNIO_RUNTIME_VERSION_MINOR: i64 = 0
let SOUNIO_RUNTIME_VERSION_PATCH: i64 = 0
pub let IR_FLOAT_REG_MARKER_FLAG: i64 = 64064

pub enum IrOpcode {
    IrLoadImm,
    IrLoadFloat,
    IrIntToFloat,  // CVTSI2SD: i64 src → f64 dst (Sprint 87)
    IrFloatToInt,  // CVTTSD2SI: f64 src → i64 dst, truncate (Sprint 87)
    IrLoadBool,
    IrLoadString,
    IrCopy,
    IrBinOp,
    IrUnaryOp,
    IrCall,
    IrReturn,
    IrJump,
    IrBranchTrue,
    IrBranchFalse,
    IrFieldGet,
    IrFieldSet,
    IrIndexGet,
    IrIndexSet,
    IrAlloc,
    IrLabel,
    IrNop,
    IrPhi,
    // Vector IR — AVX10.2 unified-width packed-f64
    //   imm_i64  = L'L code: 0→ZMM (default), 1=YMM, 2=ZMM
    //   label_id = opmask register k0–k7 (0 = no masking)
    //   field_idx = imm8 predicate byte (IrVecMinMaxPD only)
    IrVecAddF64,   // EVEX VADDPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecMulF64,   // EVEX VMULPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecFmaF64,   // EVEX VFMADD231PD: dst = src1*src2 + dst
    IrVecSubF64,   // EVEX VSUBPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecMinMaxPD, // EVEX VMINMAXPD {xmm|ymm|zmm}_dst, src1, src2, imm8  (MAP5 0x52)
    // K-register logical ops — VEX.L0/L1.66.0F.W0
    //   dst  = destination k-register (0–7)
    //   src1 = first source k-register (binary ops)
    //   src2 = second source k-register
    IrMaskAnd,     // VEX KANDW  k_dst, k_src1, k_src2  (opcode 0x41, L=1)
    IrMaskOr,      // VEX KORW   k_dst, k_src1, k_src2  (opcode 0x45, L=1)
    IrMaskNot,     // VEX KNOTW  k_dst, k_src           (opcode 0x44, L=0)
    IrMaskMov,     // VEX KMOVW  k_dst, k_src           (opcode 0x90, L=0)
    // Vector utility ops — prerequisites for hypercomplex
    //   IrVecPermilPD:    imm_i64=vl_code, src1=ctrl_reg, src2=data_reg  (reg-reg form)
    //   IrVecPermilPDImm: imm_i64=vl_code, field_idx=imm8_ctrl, src2=data_reg  (imm8 form)
    //   IrVecAddSubPD:    standard imm_i64=vl, label_id=mask_k
    IrVecPermilPD,    // EVEX VPERMILPD reg-reg: dst=permute(src2,src1_ctrl)  map=2 0x0D
    IrVecPermilPDImm, // EVEX VPERMILPD imm8:   dst=permute(src2,imm8_ctrl)  map=3 0x05
    IrVecAddSubPD,    // EVEX VADDSUBPD:        dst[i]=src1[i] +-+- src2[i]  map=1 0xD0
    // Hypercomplex multiply
    //   dst  = result register (YMM for quaternion, vl=1)
    //   src1 = left operand register
    //   src2 = right operand register
    IrHyperMulQ,      // Quaternion Hamilton product via 8-instr EVEX sequence
    // Octonion vector primitives (prerequisites for hypercomplex-O ops)
    //   IrVecXorPD:   map=1 op=0x57   EVEX.66.0F.W1 57 /r  — f64 bitwise XOR (sign flip)
    //   IrVecPermpd:  map=2 op=0x16   EVEX.66.0F38.W1 16 /r — arbitrary YMM permute (reg-indexed)
    //   Both: dst/src1/src2 = YMM reg indices, imm_i64 = vl_code (1=YMM)
    //         label_id & 7 = mask k-register, imm_flags & 1 = z-bit
    IrVecXorPD,       // VXORPD: bitwise XOR packed f64                        map=1 op=0x57
    IrVecPermpd,      // VPERMPD reg-indexed: arbitrary YMM/ZMM f64 permute     map=2 op=0x16
    // Octonion hypercomplex ops (post-3.6.1)
    //   IrHyperConjugateO: paired-YMM unchanged from 3.6
    //   IrHyperMulO (3.6.1+): single-ZMM Fano-plane convention
    //     lane 0 = real e0, lanes 1-7 = e1..e7, vl_code = 2 (ZMM)
    //     INVARIANT: dst/src1/src2 are valid ZMM indices; no paired-register requirement.
    //   label_id = (mask_k & 7) | (ctrl_base << 4)
    //              low 3 bits = output k-register (0 = k0 = no mask)
    //              bits 7:4   = base ZMM index for 21 pre-loaded Fano constants
    //                           [+0..+6]  broadcast ctrl for b[1..7] (ZMM = [j,j,j,j,j,j,j,j])
    //                           [+7..+13] permutation ctrl for a columns 1..7
    //                           [+14..+20] sign masks for columns 1..7 (0x8000… = negative)
    //   imm_flags bit 0 = z-bit (0 = merge-masking, 1 = zero-masking)
    //   IrHyperConjugateO label_id still encodes (mask_k & 7) | (sign_ymm << 4)
    IrHyperConjugateO, // Octonion conjugate: 2×VXORPD, flip e₁–e₇ in both YMM halves (12 bytes)
    IrHyperMulO,       // Octonion Hamilton product, Fano single-ZMM, 31 instr / 186 bytes
    IrHyperNormSqO,    // Octonion norm-squared Σeᵢ², 7 instr / 44 bytes, broadcast to all lanes
    // Sedenion hypercomplex ops (Horizon 5.1 — FSNN pipeline)
    //   IrHyperMulS: Cayley-Dickson sedenion multiply via 4 Fano-plane octonionic products.
    //   (a,b)*(c,d) = (ac - conj(d)*b, da + b*conj(c))
    //   Each sedenion = 2 ZMM registers (alpha in even, beta in odd):
    //     src1   = ZMM alpha_a (lanes 0-7 = e0-e7)
    //     src1+1 = ZMM beta_b  (lanes 0-7 = e8-e15)
    //     src2   = ZMM alpha_c
    //     src2+1 = ZMM beta_d
    //     dst    = ZMM result alpha
    //     dst+1  = ZMM result beta
    //   Scratch: dst+2..dst+9 (8 scratch ZMMs)
    //   label_id encoding: same as IrHyperMulO
    //     bits 2:0 = mask_k (0 = k0 = no mask)
    //     bits 7:4 = ctrl_base for 21 Fano constants
    //     bits 11:8 = conj_sign_zmm (ZMM with lanes 1-7 = 0x8000..., lane 0 = 0x0)
    //   imm_flags bit 0 = z-bit
    //   Total: 4×31 (Fano) + 2 (conjugate) + 2 (add/sub) = 128 EVEX instructions
    IrHyperMulS,       // Sedenion Hamilton product, 2×ZMM Cayley-Dickson, 128 instr / 768 bytes
    // Associator op — first compiler to represent [a,b,c] = (ab)c − a(bc) as an IR node.
    //   dst    = result ZMM (8 f64 lanes = associator vector; or scalar norm if imm_flags bit 1)
    //   src1   = a ZMM register index
    //   src2   = b ZMM register index
    //   imm_i64 = c ZMM register index (third operand packed as immediate)
    //   label_id = (mask_k & 7) | (ctrl_base << 4)  — same encoding as IrHyperMulO
    //   imm_flags bit 0 = z-bit (zeroing-mask on output)
    //   imm_flags bit 1 = scalar_norm mode (1 = emit norm reduction after subtraction)
    //   Algorithm: 4 Fano-plane multiplies (reusing emit_fano_inline) + 1 VSUBPD
    //     t_ab = fano(a,b); t_abc = fano(t_ab,c); t_bc = fano(b,c); t_abc2 = fano(a,t_bc)
    //     dst = t_abc - t_abc2
    //   Scratch: dst+2..dst+13 (12 ZMMs; same layout as IrHyperMulS halves)
    //   Total: 4×31 + 1 = 125 EVEX instructions / ~750 bytes
    //   Optimization: if ir_can_reassociate_triple() → dst zeroed via VXORPD (2 instrs, 12 bytes)
    IrAssociator,      // Octonion associator [a,b,c] = (ab)c − a(bc), 125 instr / 750 bytes
    // Door β — Variance-of-Associator: GUM-correct uncertainty propagation for Knowledge<O>.
    //
    // The first compiler to correctly propagate ISO GUM uncertainty through non-associative
    // arithmetic. The component-wise product rule Var(a·b) = a²Var(b) + b²Var(a) is WRONG
    // for octonion products when the triple (a,b,c) does not lie on a Fano line, because
    // the intermediate products (ab)c and a(bc) are correlated through [a,b,c] ≠ 0.
    //
    // The 168 theorem (Agourakis 2026) is the optimization gate:
    //   of 343 ordered octonion basis triples, exactly 168 lie on Fano lines → [a,b,c] = 0
    //   → variance correction = 0 → 1 VXORPD instruction (254× cheaper than non-Fano path).
    //   The remaining 175 triples emit the full correction: ||[a,b,c]||² × σ².
    //
    //   dst     = result ZMM (8 f64 lanes, per-component variance correction)
    //   src1    = a ZMM register index
    //   src2    = b ZMM register index
    //   imm_i64 = c ZMM register index (third operand packed as immediate)
    //   label_id = (mask_k & 7) | (ctrl_base << 4)   — same encoding as IrAssociator
    //   imm_f64  = σ² (combined variance, bit-cast i64 >> 8, set by type-checker)
    //   imm_flags bit 0 = z-bit (zeroing mask)
    //   imm_flags bit 1 = fano_exact (1 → Fano triple, emit VXORPD → 1 instr / 6 bytes)
    //
    // Fano path (imm_flags bit 1 = 1):
    //   VXORPD dst, dst, dst   → 1 EVEX / 6 bytes  (correction = 0)
    //
    // Non-Fano path (imm_flags bit 1 = 0):
    //   Steps 1-5: lower_associator (reused) → [a,b,c] in dst   ~125 EVEX
    //   Step 6: VMULPD dst, dst, dst   (||[a,b,c]||² component-wise)   1 EVEX
    //   Step 7: VBROADCASTSD t_sigma, [σ²]                             1 EVEX
    //   Step 8: VMULPD dst, dst, t_sigma  (scale by σ²)                1 EVEX
    //   Total: ~128 EVEX instructions / ~768 bytes
    //
    // Scratch: dst+2..dst+13 (same 12-ZMM layout as IrAssociator)
    IrAssociatorVariance, // Door β: Var([a,b,c]) correction, 1 instr (Fano) / ~128 (non-Fano)
    // Sedenion zero-divisor check — first type system to detect ZD pairs at compile time.
    //   For literal sedenion basis elements: eliminated at type-check (zero runtime cost).
    //   For non-literal operands: runtime bitmask test → epistemic ZD warning flag.
    //   dst    = result flag register (i64: 0 = safe, 1 = ZD risk detected)
    //   src1   = first sedenion ZMM pair (src1=alpha, src1+1=beta)
    //   src2   = second sedenion ZMM pair (src2=alpha, src2+1=beta)
    //   Lowering: type-level annotation → lowers to NOP/MOV (type-checker handles the gate)
    IrSedZDCheck,      // Sedenion ZD check: compile-time bitmask gate, runtime NOP
    // G₂-equivariant ops (Horizon 3.7)
    //   G₂ = Aut(𝕆), the 14-dimensional exceptional Lie group preserving the Fano-plane
    //   multiplication table. Its Lie algebra 𝔤₂ consists of derivations acting on Im(𝕆) ≅ ℝ⁷
    //   (lanes 1-7 of a single ZMM; lane 0 = real part = 0 for imaginary projections).
    //
    //   IrG2ProjectImO: zero lane 0 → project from 𝕆 to Im(𝕆)
    //     VANDPD dst, src, imag_mask (lane 0 = 0x0, lanes 1-7 = 0xFFFF…)
    //     label_id = (mask_k & 7) | (imag_mask_zmm << 4)
    //     imm_flags bit 0 = z-bit
    //
    //   IrG2ApplyGenO: apply 7×7 matrix to Im(𝕆) via column-major multiply
    //     Same broadcast-and-FMA pattern as Fano columns: for each j=1..7,
    //     broadcast input[j], VFMADD with column_j of the generator matrix.
    //     label_id = (mask_k & 7) | (col_base << 4)
    //       col_base+0..6 = 7 column ZMMs (preloaded generator matrix rows)
    //     field_idx = generator ID (0..13) for documentation; lowering uses col_base
    //     Broadcast ctrls reused from Fano constants ([j,j,j,j,j,j,j,j])
    //     16 instr / 96 bytes: 1 VXORPD + 7×(VPERMPD + VFMADD231PD) + 1 VMOVAPD
    //
    //   IrG2DenseO: G₂-equivariant dense layer = project + apply + store
    //     Composes IrG2ProjectImO + IrG2ApplyGenO internally
    //     17 instr / 102 bytes
    IrG2ProjectImO,    // Project to Im(𝕆): zero lane 0 via VANDPD, 1 instr / 6 bytes
    IrG2ApplyGenO,     // Apply 𝔤₂ generator: 7×7 matrix-vector on Im(𝕆), 16 instr / 96 bytes
    IrG2DenseO,        // G₂-equivariant dense: project + apply, 17 instr / 102 bytes
    // G₂-equivariant dense kernel with IEEE-754-2019 robustness (Horizon 3.8)
    //   Full pipeline: project → G₂ matrix-vector → VMINMAXPD NaN/±0 clamp → masked store
    //   18 instructions / 109 bytes:
    //     1 VANDPD (project, 6) + 1 VXORPD (zero, 6) + 7×(VPERMPD+VFMADD231PD) (84)
    //     + VMINMAXPD{k}{z}+imm8 (IEEE clamp, 7) + VMOVAPD{k}{z} (store, 6)
    //   label_id = (mask_k & 7) | (col_base << 4)   — same encoding as IrG2DenseO
    //   imm_flags bit 0 = z-bit (zeroing-mask)
    //   src1 = input ZMM, src2 = imag_mask ZMM (lane 0 = 0x0, lanes 1-7 = 0xFF…)
    IrG2EquivDenseKernelO, // G₂-equivariant dense kernel + IEEE robustness, 18 instr / 109 bytes
    // E₈ root reflection — Weyl group action on the rank-8 Cartan subalgebra (Horizon 3.9)
    //   E₈ = largest exceptional Lie algebra (dim 248, rank 8, 240 roots).
    //   All E₈ roots have ⟨α,α⟩ = 2, so: s_α(v) = v − ⟨v,α⟩·α  (no /2 needed).
    //
    //   ZMM carries 8 f64 lanes ≅ one vector in the Cartan subalgebra ℝ⁸.
    //   Algorithm (8 instr / 48 bytes):
    //     1. VMULPD t, v, α                     — elementwise product (6B)
    //     2. VPERMPD t2, ctrl0, t [swap halves]  — reduce 8→4 (6B)
    //     3. VADDPD t, t, t2                     — partial sums      (6B)
    //     4. VPERMPD t2, ctrl1, t [swap pairs]   — reduce 4→2 (6B)
    //     5. VADDPD t, t, t2                     — partial sums      (6B)
    //     6. VPERMPD t2, ctrl2, t [swap adj]     — reduce 2→1 (broadcast) (6B)
    //     7. VADDPD t, t, t2                     — dot broadcast to all 8 lanes (6B)
    //     8. VFNMADD231PD v, t, α                — v = v − t·α        (6B)
    //
    //   Encoding:
    //     dst  = v ZMM index (input → output, updated in-place)
    //     src1 = α ZMM index (root vector, read-only)
    //     src2 = t ZMM index (scratch dot-product accumulator)
    //     t2   = src2 + 2   (second scratch; caller must leave free)
    //     label_id = (mask_k & 7) | (ctrl_base << 4)
    //       ctrl_base+0: control ZMM for swap-halves    [4,5,6,7,0,1,2,3]
    //       ctrl_base+1: control ZMM for swap-pairs     [2,3,0,1,6,7,4,5]
    //       ctrl_base+2: control ZMM for swap-adjacent  [1,0,3,2,5,4,7,6]
    //     imm_flags bit 0 = z-bit (zeroing-mask on final VFNMADD)
    IrE8RootReflectO,      // E₈ Weyl reflection s_α(v) = v − ⟨v,α⟩·α, 8 instr / 48 bytes
    // F₄ root reflection — rank 4, dim 52, 48 roots (Horizon 4.0)
    //   NOT simply-laced: short/long root ratio √2.  Pre-normalize roots to ⟨α,α⟩=2
    //   so the E₈ tree-reduction pattern applies unchanged.
    //   Algorithm: same 8-lane VMULPD + 3×(VPERMPD+VADDPD) + VFNMADD231PD
    //   Unused lanes 4-7 zeroed → contribute 0 to dot product.
    //   8 instr / 48 bytes.  Encoding identical to IrE8RootReflectO.
    IrF4RootReflectO,
    // E₆ root reflection — rank 6, dim 78, 72 roots, simply-laced (Horizon 4.0)
    //   Same algorithm as E₈; lanes 6-7 zeroed.  8 instr / 48 bytes.
    IrE6RootReflectO,
    // E₇ root reflection — rank 7, dim 133, 126 roots, simply-laced (Horizon 4.0)
    //   Same algorithm as E₈; lane 7 zeroed.  8 instr / 48 bytes.
    IrE7RootReflectO,
    // Cartan matrix multiply — column-major broadcast-and-FMA (Horizon 4.0)
    //   Applies the Cartan matrix A_{ij} = 2⟨αᵢ,αⱼ⟩/⟨αⱼ,αⱼ⟩ to a weight vector.
    //   Column vectors preloaded into ZMM registers at col_base+0..N-1.
    //   Broadcast ctrls at bcast_base = col_base − rank.
    //   Pattern: VXORPD + N×(VPERMPD+VFMADD231PD) + VMOVAPD
    //   label_id = (mask_k & 7) | (col_base << 4), imm_flags bit 0 = z-bit
    //   Registers: dst=output, src1=input, t_bcast=dst+2, accum=dst+4
    IrF4CartanMulO,        // F₄ 4×4 Cartan, 10 instr / 60 bytes
    IrE6CartanMulO,        // E₆ 6×6 Cartan, 14 instr / 84 bytes
    IrE7CartanMulO,        // E₇ 7×7 Cartan, 16 instr / 96 bytes
    IrE8CartanMulO,        // E₈ 8×8 Cartan, 18 instr / 108 bytes
    // Epistemic runtime — Contest<T> transparent wrapper (H5.0)
    //   dst  = destination register (holds contested datum)
    //   src1 = subject register (the "on" expression result)
    //   imm_i64 = number of model arguments
    //   Codegen: MOV dst, src1 (zero-cost at machine level; model selection = proof-time)
    IrContest,             // Contest<T> intro: dst = subject datum, annotated as contested
    // Epistemic runtime — prove_robust transparent wrapper (H5.1)
    //   dst  = destination register (holds the proven datum)
    //   src1 = contest register (the contested subject)
    //   src2 = policy register (ignored at runtime; satisfaction is type-level)
    //   Codegen: MOV dst, src1 (zero-cost; proof obligation is fully discharged at type-check)
    IrProveRobust,         // prove_robust(contest, policy): Robust<T> intro, zero-cost copy
    // Epistemic runtime — validate_manifest terminal gate (H5.2)
    //   dst  = destination register (holds the validated datum)
    //   src1 = robust register (the proven Robust<T> subject)
    //   Codegen: MOV dst, src1 (zero-cost; validation is type-level only)
    IrValidated,           // validate_manifest(robust): Validated<T> terminal, zero-cost copy
    // Decision-admissibility runtime — admit_action(value, robust, policy) terminal gate
    //   dst  = destination register (holds the admitted datum)
    //   src1 = value register (the datum/action being admitted)
    //   src2 = robust register (the proof-carrying Robust<T> evidence)
    //   imm_i64 = decision policy register (carried for metadata only)
    //   label_id = decision certificate id
    //   Codegen: MOV dst, src1 (zero-cost; admissibility is discharged at type-check)
    IrAdmitAction,         // admit_action(value, robust, decision_policy): Admissible<T> terminal
    // Decision-deferral runtime — defer_action(value, evidence, policy) terminal gate
    //   dst  = destination register (holds the deferred datum)
    //   src1 = value register
    //   src2 = evidence register (Contest<T> datum or Robust<T> datum)
    //   imm_i64 = deferral policy register (metadata only)
    //   label_id = deferred certificate id
    //   Codegen: MOV dst, src1 (zero-cost; deferral is discharged at type-check)
    IrDeferAction,         // defer_action(value, evidence, deferral_policy): Deferred<T> terminal
    // Resolution runtime — plan_acquisition(value, deferred, policy) terminal gate
    //   dst = destination register (holds the planned datum)
    //   src1 = value register
    //   src2 = deferred register
    //   imm_i64 = acquisition policy register (metadata only)
    //   label_id = acquisition plan id
    IrPlanAcquisition,
    // Resolution runtime — plan_recourse(value, deferred, policy) terminal gate
    //   dst = destination register (holds the planned datum)
    //   src1 = value register
    //   src2 = deferred register
    //   imm_i64 = recourse policy register (metadata only)
    //   label_id = recourse plan id
    IrPlanRecourse,
    // Alternative frontier runtime — propose_alternatives(value, evidence, frontier) terminal gate
    //   dst = destination register (holds the certified AlternativeSet<T> datum)
    //   src1 = value register
    //   src2 = evidence register (Deferred<T> or RecoursePlan<T>)
    //   imm_i64 = frontier/policy register (metadata only)
    //   label_id = alternative set id
    IrProposeAlternatives,
    // Transition protocol runtime — commit_alternative(value, option, protocol) terminal gate
    //   dst = destination register (holds the certified TransitionPlan<T> datum)
    //   src1 = value register
    //   src2 = selected AlternativeOption<T> register
    //   imm_i64 = transition protocol register (metadata only)
    //   label_id = transition plan id
    IrCommitAlternative,
    // Transition monitoring runtime — observe_transition(value, plan, monitoring_policy) terminal gate
    //   dst = destination register (holds the certified ObservedTransition<T> datum)
    //   src1 = value register
    //   src2 = TransitionPlan<T> register
    //   imm_i64 = monitoring policy register (metadata only)
    //   label_id = observed transition id
    IrObserveTransition,
    // Transition rollback runtime — rollback_transition(value, plan, monitoring_policy) terminal gate
    //   dst = destination register (holds the certified RollbackCertificate<T> datum)
    //   src1 = value register
    //   src2 = TransitionPlan<T> register
    //   imm_i64 = monitoring policy register (metadata only)
    //   label_id = rollback certificate id
    IrRollbackTransition,

    // Epistemic bridge — lift_knowledge(k: Knowledge<T>) → Contest<T> (H5.4)
    //   dst  = destination register (holds the lifted datum)
    //   src1 = knowledge register (the Knowledge<T> observation)
    //   Codegen: MOV dst, src1 (zero-cost; bridge is type-level only)
    IrLiftKnowledge,       // lift_knowledge(knowledge): Contest<T> intro from Knowledge<T>

    // Epistemic source — measure(v: T, uncertainty: f64) → Knowledge<T> (H5.5)
    //   dst  = destination register (holds the observed datum)
    //   src1 = value register (the T being measured)
    //   Codegen: MOV dst, src1 (zero-cost; uncertainty is type-level metadata)
    IrMeasure,             // measure(value, uncertainty): Knowledge<T> intro from raw observation

    // Effect handler block boundaries — row-polymorphic effect handling (H6.2)
    //   IrHandleBegin: marks the start of a handle block
    //     src1 = handler_id register (identifies this handler scope)
    //     imm_i64 = effect_def_id (which effect definition is being handled)
    //   IrHandleEnd: marks the end of a handle block, produces result
    //     src1 = result register (the handled expression's result)
    IrHandleBegin,         // Begin handle block: src1=handler_id, imm_i64=effect_def_id
    IrHandleEnd,           // End handle block: src1=result_reg

    // Debug-mode policy guard — conditional trap for witness enforcement (Sprint 28)
    //   src1 = metric value register (i64 or f64)
    //   imm_f64 = threshold value for policy requirement
    //   field_idx = comparison operator (0=Eq, 1=Ne, 2=Lt, 3=Le, 4=Gt, 5=Ge)
    //   label_id = policy requirement index (for diagnostics)
    //   name = policy name (for debug error message)
    //   Codegen (debug): CMP/UCOMISD + conditional jump over UD2 trap
    //   Codegen (release): not emitted (zero cost)
    IrDebugGuard,
    // Profiling counter increment — slow-path entry (Sprint 44)
    //   imm_i64 = counter_id (index into IrModule.prof_counters)
    //   Native lowering: 7-byte NOP placeholder (Sprint 44), ADD [RIP+disp32],1 (Sprint 45)
    IrProfCounter,
    // Call to external C ABI function (Sprint 108: extern "C" fn FFI)
    //   name = C symbol name, call_args/arg_count = SysV args, dst = result reg
    IrCallExtern,
    // Load a function reference as a first-class value (Sprint 228: closures)
    //   dst = destination register, fn_id = index into IrModule.functions
    //   At runtime the register holds the fn_id as an integer.
    IrLoadFnRef,
    // Indirect function call through a register holding a fn_id (Sprint 228: closures)
    //   dst = result register, src1 = register holding fn_id
    //   call_args/arg_count = arguments (same as IrCall)
    IrCallIndirect,
    // Albert algebra J₃(O) — exceptional Jordan algebra (27-dimensional).
    // J₃(O) is the unique exceptional simple Jordan algebra (Jordan-von Neumann-Wigner 1934).
    // Automorphism group: F₄ (52-dimensional exceptional Lie group, 48 roots).
    // Connection: 3 fermion generations ↔ 3×3 block structure (arxiv:2006.16265).
    // This is the first compiler with a native Jordan product primitive for J₃(O).
    //
    // Register layout (4 ZMM regs per J₃(O) element):
    //   base+0: diagonal (e₁₁, e₂₂, e₃₃, 0, 0, 0, 0, 0) — 3 real diagonals in first 3 lanes
    //   base+1: e₁₂ octonion (off-diagonal row 0, 8 f64 lanes)
    //   base+2: e₁₃ octonion (off-diagonal row 1, 8 f64 lanes)
    //   base+3: e₂₃ octonion (off-diagonal row 2, 8 f64 lanes)
    //   e₂₁ = conj(e₁₂), e₃₁ = conj(e₁₃), e₃₂ = conj(e₂₃) — computed on demand via IrHyperConjugateO
    //
    // IrJ3OJordanMul: a ∘ b = (a·b + b·a) / 2  (Jordan product)
    //   src1 = base ZMM of a (4 ZMMs: src1, src1+1, src1+2, src1+3)
    //   src2 = base ZMM of b (4 ZMMs: src2, src2+1, src2+2, src2+3)
    //   dst  = base ZMM of result (4 ZMMs: dst, dst+1, dst+2, dst+3)
    //   label_id bits 3:0 = mask_k
    //   label_id bits 7:4 = ctrl_base for Fano constants (reuses IrHyperMulO ctrl)
    //   imm_flags bit 0 = z-bit
    //   imm_flags bit 1 = symmetry_hint (1 = input is already symmetric → skip b·a computation)
    //   Total: 2×IrJ3OMatMul + 16 VADDPD + 8 VMULPD ≈ 668 EVEX instructions
    //   Scratch: dst+4..dst+15 (12 ZMMs for two mat-mul intermediate results)
    IrJ3OJordanMul,     // Albert Jordan product a∘b = (ab+ba)/2, first native J₃(O) primitive
    // IrJ3OTrace: trace of a 3×3 octonion matrix = sum of 3 diagonal f64 values
    //   src1 = base ZMM of input (only diagonal lane 0 is used)
    //   dst  = scalar result ZMM (trace broadcast to all lanes)
    //   Lowering: VADDPD on diagonal lanes (2 VADDPD + 1 VHADDPD = 4 instrs / 24 bytes)
    IrJ3OTrace,         // Trace: sum of 3 diagonal elements → scalar broadcast, 4 instr
    // IrJ3ODet: Freudenthal cubic form N(A) = tr(A³)/3 − tr(A)tr(A²)/6 + tr(A)³/18
    //   Valid over non-associative algebras by alternativity of octonions (Artin's theorem).
    //   Deferred: ~1200 instructions; placeholder in this sprint, wired in Phase 5b.
    IrJ3ODet,           // Freudenthal cubic form (placeholder, wired in Phase 5b)
    // Fractal escape-time iteration — first compiler primitive for hypercomplex fractals.
    // When algebra_tag is a compile-time constant, the compiler generates algebra-specialized
    // machine code: no virtual dispatch, no branch on algebra type inside the hot loop.
    // For quaternion (4 components, YMM), loop body ≈ 12 instrs. For octonion (8, ZMM) ≈ 38.
    //
    // The epistemic return: EscapeData carries basin_confidence: Knowledge<f64> —
    // the GUM uncertainty in the escape estimate from accumulated floating-point error.
    // This is the first fractal primitive with compile-time ISO GUM propagation.
    //
    // IrFractalEscape encoding:
    //   dst      = first slot of EscapeData (iters: i64; dst+1 = z_final ZMM; dst+2 = confidence f64)
    //   src1     = z0 ZMM register (initial value in the algebra)
    //   src2     = c  ZMM register (parameter)
    //   imm_i64  = max_iters (iteration limit)
    //   label_id bits 3:0 = algebra_tag (IR_ALG_QUATERNION=2, IR_ALG_OCTONION=3, IR_ALG_SEDENION=4)
    //   label_id bits 7:4 = ctrl_base for Fano constants (same as IrHyperMulO)
    //   imm_flags bit 0   = z-bit
    //   imm_f64  = radius² (precomputed by type-checker, stored as bit-cast i64 in label_id >> 8)
    // Loop body (algebra-dispatched at lowering time, no runtime branch):
    //   z ← z*z + c  (algebra multiply + VADDPD)
    //   escaped ← |z|² > radius²  (norm + UCOMISD)
    //   counter ← counter − 1  (DEC + JNZ)
    // basin_confidence = u_radius / sqrt(2 * iters_taken)  (ISO 5725 conservative bound)
    IrFractalEscape,        // Hypercomplex escape-time iteration, algebra-specialized codegen
    // Clifford algebra grade operations — first IR with grade as first-class attribute.
    // Grade is tracked via IrHyperExprInfo.grade_mask (bit k = grade-k blades present).
    // Dead-grade pruning: if grade_known && grade_mask == 0, node → VXORPD zero (e-graph).
    //
    // IrCliffordGradeSel — extract the grade-k part of a multivector (grade projection)
    //   dst   = result ZMM (grade-k components only; others zeroed)
    //   src1  = input multivector ZMM
    //   imm_i64 = k (grade to extract, 0 ≤ k ≤ p+q)
    //   label_id = (mask_k & 7) | (grade_lane_mask_zmm << 4)
    //     grade_lane_mask_zmm = preloaded ZMM with 0xFFFF… for grade-k lanes, 0x0 for others
    //   Lowering: VANDPD dst, src1, grade_lane_mask_zmm  (1 EVEX instr / 6 bytes)
    //   IrHyperExprInfo.grade_mask = (1 << k); grade_known = true
    IrCliffordGradeSel,     // Grade-k projection: VANDPD with grade mask ZMM, 1 instr / 6 bytes
    // IrCliffordGradeMul — geometric product with grade-mask propagation
    //   dst    = result ZMM
    //   src1   = left multivector ZMM  (IrHyperExprInfo carries grade_mask_a)
    //   src2   = right multivector ZMM (IrHyperExprInfo carries grade_mask_b)
    //   label_id bits 3:0 = mask_k; bits 11:4 = Clifford multiplication table base ZMM
    //   IrHyperExprInfo.grade_mask = ir_clifford_grade_product(grade_mask_a, grade_mask_b)
    //   Dead-grade: if result grade_mask == 0 → node replaced by VXORPD zero
    //   imm_i64 bits 7:0 = grade_mask_a; bits 15:8 = grade_mask_b; bits 23:16 = max_grade
    //   Lowering (Door Γ):
    //     grade_out = ir_clifford_grade_product(grade_mask_a, grade_mask_b, max_grade)
    //     grade_out == 0          → VXORPD (dead-grade elimination, 1 EVEX)
    //     grade_mask_a == 1 (scalar) → VBROADCASTSD + VMULPD (scalar scale, 2 EVEX)
    //     general                → grade-sparse scaffold (VMOVAPD + e-graph annotation)
    IrCliffordGradeMul,     // Door Γ: grade-exact GP, dead-grade elimination at IR level

    // ─── Door Ω — Tropical Epistemic Arithmetic ─────────────────────────────
    // IrTropicalAdd — tropical addition min(a,b) with GUM-epistemic uncertainty.
    //   First IR with GUM-correct uncertainty for the min-plus tropical semiring.
    //   val_out = min(a_val, b_val)                         (1 VMINPD)
    //   eps_out (certain gap >> σ):  VMINPD eps_a, eps_b   (1 VMINPD — eps of argmin)
    //   eps_out (critical gap ≈ 0):  (eps_a+eps_b)/4       (VADDPD + 0.25-broadcast + VMULPD)
    //   Encoding:
    //     dst  = val ZMM;   dst+1 = eps ZMM
    //     src1 = a_val ZMM; src1+1 = a_eps ZMM
    //     src2 = b_val ZMM; src2+1 = b_eps ZMM
    //     imm_f64  = σ_combined (gap threshold for "certain argmin" branch)
    //     imm_flags bit 0: certain=1 → static gap >> σ proved (fast VMINPD eps path)
    IrTropicalAdd,  // Door Ω: tropical min(a,b) with GUM epistemic on the argmin

    // IrTropicalMul — tropical multiplication (ordinary +) with GUM uncertainty.
    //   val_out = a_val + b_val   (tropical "×" = ordinary + in (ℝ,min,+))
    //   eps_out = eps_a + eps_b   (GUM addition rule — identical arithmetic to IrFAdd)
    //   Type-annotation novelty: node carries tropical semiring membership → e-graph applies
    //   min-plus laws: distributivity (a⊗(b⊕c))=(a⊗b)⊕(a⊗c), associativity, etc.
    //   Lowering: 2 VADDPD (val + eps)
    IrTropicalMul,  // Door Ω: tropical a+b (type-annotated, min-plus semiring)

    // ─── Door Σ — Free Probability / R-Transform ────────────────────────────
    // IrFreeConvolve — free convolution K<a> ⊞ K<b> via R-transform linearization.
    //   First compiler where Knowledge<T> carries a distribution_class annotation
    //   and emits free-probability-correct variance propagation.
    //   Voiculescu R-transform: R_{a⊞b}(z) = R_a(z) + R_b(z).
    //   Wigner semicircle(σ²): R_W(z) = σ²·z  →  free conv of σ²_a and σ²_b gives σ²_a+σ²_b.
    //   Gaussian(σ²):          R_G(z) = σ²·z  →  same first-order formula; differs at κ₄.
    //   val_out      = a_val + b_val           (means add — same as classical)
    //   sigma_sq_out = σ²_a + σ²_b            (R-transform additivity)
    //   imm_flags bit 1: dist_class (0=Gaussian, 1=Wigner semicircle)
    //   Lowering: 2 VADDPD (val + sigma_sq).  The mathematical distinction is the TYPE and
    //   the 4th-moment: m₄(a⊞b) = 2(σ²_a+σ²_b)² [Wigner] vs 3(σ²_a+σ²_b)² [Gaussian].
    IrFreeConvolve, // Door Σ: free convolution K<a>⊞K<b>, dist_class annotated

    // ─── Door Δ — Muraki's Independence Pentagon ──────────────────────────────
    // Muraki (2003) proved there are exactly FIVE universal notions of non-commutative
    // independence. Sounio now has Classical (GUM/ISO) and Free (Door Σ). Door Δ adds
    // Boolean and Monotone, completing the classification. No other compiler has done this.
    //
    // All five theories give identical variance propagation (first order):
    //   Var_out = Var_a + Var_b
    // The 4th moment (kurtosis κ = m₄/σ⁴) distinguishes them:
    //   Classical:  κ = 3  (Gaussian, Isserlis theorem)
    //   Free:       κ = 2  (Wigner semicircle, Catalan C₂)
    //   Monotone:   κ = 3/2 (arcsine on [-2σ,2σ])
    //   Boolean:    κ = 1  (Bernoulli {-σ,+σ}, X²=σ² a.s.)
    //   Anti-mono:  κ = 3/2 (mirror arcsine, same κ as monotone)
    //
    // IrBooleanConvolve — Boolean ⊎ convolution of Knowledge values.
    //   Boolean independence: X, Y project onto orthogonal subspaces of the Hilbert space.
    //   CLT limit: Bernoulli {-σ, +σ}.  m₄ = (σ²_out)²  (minimum kurtosis).
    //   Encoding: dst+0=val_out, dst+1=sigma_sq_out; src1/src2 same layout.
    //   imm_flags bit 0: z-bit.  imm_flags bits 1-2: dist_class = 0b10 (Boolean).
    //   Formal guarantee: BooleanCLT.lean  `boolean_m4_minimal`
    //   Lowering: 2 VADDPD (identical arithmetic to IrFreeConvolve; dist_class differs)
    IrBooleanConvolve,  // Door Δ: K<a> ⊎ K<b>, dist_class=2, Bernoulli CLT, κ=1

    // IrMonotoneConvolve — Monotone ⊳ convolution (Muraki's most exotic type).
    //   Monotone independence is ORDER-DEPENDENT: X⊳Y ≠ Y⊳X at the moment level.
    //   CLT limit: arcsine distribution on [-2σ, 2σ].  κ = 3/2.
    //   Asymmetry: m₃(X⊳Y) depends on ordering (for non-centered distributions).
    //   For centered distributions: asymmetry first visible at m₅.
    //   Encoding: same as IrBooleanConvolve.
    //   imm_flags bit 3: swap flag (= 1 means b⊳a, operands already in correct order).
    //   imm_flags bits 1-2: dist_class = 0b11 (Monotone/arcsine).
    //   Formal guarantee: MonotoneCLT.lean  `monotone_clt_arcsine`
    //   Lowering: 2 VADDPD (centered case; asymmetry carried in dist_class annotation)
    IrMonotoneConvolve, // Door Δ: K<a> ⊳ K<b>, dist_class=3, arcsine CLT, κ=3/2

    // ─── Door Φ — Wasserstein Transport + Ollivier-Ricci Curvature ───────────
    // Sounio can model distributions (Knowledge<T>) but could not COMPARE them.
    // W₁ (Earth Mover's Distance) is the canonical metric on probability distributions.
    // ORC uses W₁ to measure graph curvature. No compiler has these as IR primitives.
    //
    // Connection to research: Paper 4 (Brain ORC + Associator Field, ABIDE-I) computes ORC
    // on connectomes. Making ORC an IR primitive means the compiler certifies ORC-based
    // claims about brain graph topology at compile time.
    //
    // IrWassersteinDist — W₁ distance between two Knowledge<f64> distributions.
    //   1D Gaussian approximation: W₁(N(μ_a,σ²_a), N(μ_b,σ²_b)) ≈ |μ_a-μ_b| + |σ_a-σ_b|
    //   GUM: Δ(W₁) ≤ ½(Δσ_a + Δσ_b) + Δ|μ_a-μ_b|
    //   Encoding: dst = val ZMM (W₁ value), dst+1 = eps ZMM (GUM bound)
    //             src1 = a_val ZMM, src1+1 = a_sgsq ZMM
    //             src2 = b_val ZMM, src2+1 = b_sgsq ZMM
    //   imm_flags bit 0: z-bit; bit 1: emit_eps (include GUM in output register)
    //   Lowering: VSUBPD + VANDPD (abs mean diff) + VSQRTPD×2 + VSUBPD + VANDPD (abs sig diff)
    //             + VADDPD (sum) + GUM VADDPD×scale; ~7 EVEX instructions
    //   Formal guarantee: WassersteinORC.lean  `wasserstein_triangle_inequality`
    IrWassersteinDist,  // Door Φ: W₁(K<a>, K<b>) → f64 + GUM eps

    // IrORC — Ollivier-Ricci curvature κ(x,y) = 1 - W₁(mₓ,mᵧ)/d(x,y).
    //   ORC > 0: positive curvature (well-connected region, fast mixing).
    //   ORC < 0: negative curvature (bottleneck, slow mixing, graph "neck").
    //   ORC = 0: flat (Euclidean-like).
    //   Encoding: same input layout as IrWassersteinDist.
    //             imm_i64 = d(x,y) as fixed-point integer (actual distance × 1000).
    //   Lowering: IrWassersteinDist sub-emission + VMULPD(1/d) + 1.0-broadcast + VSUBPD
    //   Formal guarantee: WassersteinORC.lean  `orc_positive_implies_mixing_bound`
    IrORC,              // Door Φ: κ(x,y) = 1 - W₁/d, wraps IrWassersteinDist

    // ─── Door Ξ — q-deformed Arithmetic / Quantum Groups ─────────────────────
    // Every prior algebra in Sounio is a SPECIFIC algebra at a fixed point.
    // U_q(G) is a FAMILY parameterized by q ∈ ℂ. At q=1: classical. At q=root of unity:
    // finite periodic representations (topological quantum field theory).
    //
    // Connection to E₈: E₈ at q = e^{2πi/30} corresponds to E₈ WZW CFT at level 1.
    // IrE8RootReflectO (Horizon 3.9) IS the q=1 Weyl reflection; at q≠1 it generates
    // the quantum Weyl group — connecting every prior Door to a unified framework.
    //
    // IrQDeform — q-deformed product: a ·_q b in an algebra with quantum group parameter q.
    //   a ·_q b = a·b + (q-1)·φ_q(a,b)   where φ_q(a,b) = (a·b - b·a)/2 for Lie deform.
    //   GUM: Δ(a·_q b) = Δ(a·b) + |q-1|·Δφ_q  (classical GUM + deformation correction)
    //   q encoding in imm_flags:
    //     bits  0-15: q_num   (int16 signed numerator)
    //     bits 16-31: q_den   (uint16 denominator, ≠ 0)
    //     → q_rational = q_num / q_den  (e.g., q=1: 1/1; q=1/2: 1/2; q=2: 2/1)
    //   Special values:
    //     q=1 (1/1): zero overhead — lowered to VMULPD only (no deformation)
    //     q=-1 (-1/1): anti-commutative product (Clifford regime)
    //   imm_i64 = algebra_tag (0=scalar, 1=octonion, 2=J3O, 8=E₈)
    //   Formal guarantee: QDeformClassical.lean  `q_deform_recovers_classical`
    //   Lowering at q=1: 1 VMULPD.  At q≠1: VMULPD + VSUBPD + scale + VFMADD231PD; ~4 EVEX
    IrQDeform,          // Door Ξ: a·_q b, q in imm_flags, unifies all prior Doors

    // SysV aggregate return (>16B) ABI.
    // IrCallSret injects the hidden destination pointer/handle in rdi and shifts
    // explicit integer args to rsi/rdx/rcx/r8/r9. IrReturnSret returns that handle.
    IrCallSret,
    IrReturnSret,
    IrWideAdd,
    IrWideSub,
    IrWideMul,
    IrWideShrLimb,
    IrWideDiv,
    IrWideMod,
    IrWideCmp,
    IrWideReject,
    IrWideShr,
    IrWideDivFull,
    IrWideModFull,
    // Global variable (BSS) load/store — absolute addressing at BSS_BASE + offset
    //   imm_i64 = BSS byte offset (from BSS_BASE)
    //   name    = global variable name (for debugging)
    IrLoadGlobal,
    IrStoreGlobal,
    // Store through a raw pointer: [src1] = src2  (used for `*p = val` on a true reference).
    IrStorePtr,
    // Linux syscall with up to six arguments.
    //   call_args[0] = syscall number; call_args[1..6] = rdi,rsi,rdx,r10,r8,r9.
    //   dst receives rax.
    IrSyscall6,
}

pub struct IrRegList {
    pub head: i64,
    pub tail: Option<Box<IrRegList>>,
}

pub struct IrInstr {
    pub op: IrOpcode,
    pub dst: i64,
    pub src1: i64,
    pub src2: i64,
    pub imm_i64: i64,
    pub imm_f64: f64,
    pub label_id: i64,
    pub fn_id: i64,
    pub field_idx: i64,
    pub imm_flags: i64,    // Bit 0: z (zeroing-mask, sets EVEX P3[7]). Future: SAE, broadcast.
    pub bin_op: BinaryOp,
    pub un_op: UnaryOp,
    pub name: Name,
    pub call_args: Option<Box<IrRegList>>,
    pub arg_count: i64,
}

// ============================================================================
// Compile strategy constants — type+effect-directed compilation mode
// ============================================================================
//
// Selected during AST→IR lowering based on the function's return type
// and effect signature.  Guides native codegen behaviour: aggressive
// paths for validated data, precision-preserving paths for uncertain
// data, dual-path instrumented codegen for contested/robust data.

let IR_STRATEGY_STANDARD: i64 = 0           // default — standard native compilation
let IR_STRATEGY_AGGRESSIVE: i64 = 1         // Validated<T> — full optimisation, SIMD, float reassoc
let IR_STRATEGY_PRECISION_PRESERVING: i64 = 2 // Knowledge<T> — no float reassociation, strict FP
let IR_STRATEGY_INSTRUMENTED: i64 = 3       // Contest<T>/Robust<T> — dual-path: fast + instrumented
let IR_STRATEGY_GPU_KERNEL: i64 = 4         // with GPU — GPU kernel extraction
let IR_STRATEGY_PROBABILISTIC: i64 = 5      // with Prob — trace-compatible for MCMC/VI
let IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC: i64 = 6 // with Chaotic — A-layer-2: e-graph refuses ALL float reassociation (e^{λt} amplification)
let IR_STRATEGY_EXTERN: i64 = 6             // extern "C" fn — no body, C ABI stub (Sprint 108)
let IR_STRATEGY_EXPORTED: i64 = 7           // export "C" fn — C ABI visibility (Sprint 109)

pub fn ir_strategy_name(s: i64) -> string {
    if s == IR_STRATEGY_STANDARD { "standard" }
    else if s == IR_STRATEGY_AGGRESSIVE { "aggressive" }
    else if s == IR_STRATEGY_PRECISION_PRESERVING { "precision_preserving" }
    else if s == IR_STRATEGY_INSTRUMENTED { "instrumented" }
    else if s == IR_STRATEGY_GPU_KERNEL { "gpu_kernel" }
    else if s == IR_STRATEGY_PROBABILISTIC { "probabilistic" }
    else if s == IR_STRATEGY_EXTERN { "extern" }
    else if s == IR_STRATEGY_EXPORTED { "exported" }
    else { "unknown" }
}

pub struct IrFunction {
    pub name: Name,
    pub instrs: [IrInstr; 1024],
    pub instr_count: i64,
    pub reg_count: i64,
    pub label_count: i64,
    pub param_count: i64,
    pub param_regs: [i64; 64],
    pub compile_strategy: i64,
    pub returns_float: i64,        // 1 = declared return type is f64; used by native core value tracking
    pub return_struct_name: Name,  // Named return type, used by native field layout recovery
    pub prof_counter_id: i64,
    pub hyper_algebra_kind: i64,  // -1 = absent/unknown, otherwise ALG_REAL..ALG_CLIFFORD
    pub is_sret: i64,             // 1 = SysV sret: rdi is hidden dest; explicit params shift to rsi+
    pub sret_dest_reg: i64,       // when is_sret==1: vreg receiving the hidden rdi destination
    pub bss_size: i64,            // for BSS-global vars: byte size of the global (8 for scalars)
    // IR_MAX_INSTRS overflow flag: set true in emit's overflow branch when this
    // function's body exceeds the per-function instruction cap. Rides the proven
    // current_func -> module.functions flush channel, so the lowering funnel can
    // detect truncation and force a loud reject instead of emitting silently.
    pub had_overflow: bool,
}

pub struct IrAlgebraInfo {
    name: Name,
    add_commutative: bool,
    add_associative: bool,
    mul_commutative: bool,
    mul_associative: bool,
    mul_alternative: bool,
    reassoc_strategy: i64,  // 0=free, 1=blocked, 2=fano_selective
    algebra_tag: i64,
    is_valid: bool,
}

pub struct IrAlgebraTable {
    entries: [IrAlgebraInfo; 32],
    count: i64,
}

fn ir_empty_algebra_info() -> IrAlgebraInfo {
    IrAlgebraInfo {
        name: Name { buf: [0; 128], len: 0 },
        add_commutative: true,
        add_associative: true,
        mul_commutative: true,
        mul_associative: true,
        mul_alternative: false,
        reassoc_strategy: 0,
        algebra_tag: 0,
        is_valid: false,
    }
}

fn ir_empty_algebra_table() -> IrAlgebraTable {
    IrAlgebraTable {
        entries: [ir_empty_algebra_info(); 32],
        count: 0,
    }
}

// Returns correctly-initialized IrAlgebraInfo for each Cayley-Dickson / Clifford algebra.
// Algebraic law enforcement:
//   tag=0 (Real):       add+mul both commutative and associative
//   tag=1 (Complex):    add+mul both commutative and associative
//                       mul_alternative = true (associativity implies alternativity)
//   tag=2 (Quaternion): mul non-commutative (Hamilton 1843), mul associative
//                       mul_alternative = true (associativity implies alternativity)
//   tag=3 (Octonion):   mul non-commutative, mul non-associative (Cayley 1845)
//                       mul_alternative = true (weaker than associative: x(xy)=(xx)y)
//   tag=4 (Sedenion):   mul non-commutative, mul non-associative, mul non-alternative
//                       (admits zero divisors; not a normed division algebra)
fn ir_algebra_info_for_tag(tag: i64) -> IrAlgebraInfo with Mut {
    var info = ir_empty_algebra_info()
    info.algebra_tag = tag
    info.is_valid = true
    if tag == 0 || tag == 1 {
        // Real/Complex: commutative, associative, alternative
        info.mul_alternative = true
        info.reassoc_strategy = 0
    } else if tag == 2 {
        // Quaternion: non-commutative, associative, alternative
        info.mul_commutative = false
        info.mul_associative = true
        info.mul_alternative = true
        info.reassoc_strategy = 0
    } else if tag == 3 {
        // Octonion: non-commutative, non-associative, alternative
        info.mul_commutative = false
        info.mul_associative = false
        info.mul_alternative = true
        info.reassoc_strategy = 2
    } else if tag == 4 {
        // Sedenion: non-commutative, non-associative, non-alternative
        info.mul_commutative = false
        info.mul_associative = false
        info.mul_alternative = false
        info.reassoc_strategy = 1
    }
    info
}

pub struct IrOntologyClassInfo {
    name: Name,
    ontology_name: Name,
    class_index: i64,
    superclass_count: i64,
    is_valid: bool,
}

pub struct IrOntologyPropertyInfo {
    name: Name,
    property_index: i64,
    domain_class_idx: i64,
    range_class_idx: i64,
}

pub struct IrOntologyTable {
    entries: [IrOntologyClassInfo; 64],
    count: i64,
    properties: [IrOntologyPropertyInfo; 32],
    property_count: i64,
}

fn ir_empty_ontology_class_info() -> IrOntologyClassInfo {
    IrOntologyClassInfo {
        name: Name { buf: [0; 128], len: 0 },
        ontology_name: Name { buf: [0; 128], len: 0 },
        class_index: -1,
        superclass_count: 0,
        is_valid: false,
    }
}

fn ir_empty_ontology_property_info() -> IrOntologyPropertyInfo {
    IrOntologyPropertyInfo {
        name: Name { buf: [0; 128], len: 0 },
        property_index: -1,
        domain_class_idx: -1,
        range_class_idx: -1,
    }
}

fn ir_empty_ontology_table() -> IrOntologyTable {
    IrOntologyTable {
        entries: [ir_empty_ontology_class_info(); 64],
        count: 0,
        properties: [ir_empty_ontology_property_info(); 32],
        property_count: 0,
    }
}

// Extended with grade tracking — first IR to carry grade as first-class attribute.
// grade_mask: bitfield where bit k = 1 means grade-k blades are present.
// grade_known: true = grade_mask is exact; false = conservative (all bits set, no info).
// cl_p, cl_q: Clifford signature (positive and negative basis vectors).
// When grade_known && grade_mask == 0, the e-graph prunes this node (dead-grade elimination).
pub struct IrHyperExprInfo {
    span_start: i64,
    span_end: i64,
    algebra_tag: i64,
    op_kind: i64,
    knowledge_wrapped: bool,
    grade_mask: i64,
    grade_known: bool,
    cl_p: i64,
    cl_q: i64,
    reassoc_strategy: i64,
    forbidden_law_mask: i64,
    law_profile_source: i64,
    law_profile_fingerprint: i64,
}

fn ir_empty_hyper_expr_info() -> IrHyperExprInfo {
    IrHyperExprInfo {
        span_start: 0,
        span_end: 0,
        algebra_tag: -1,
        op_kind: 0,
        knowledge_wrapped: false,
        grade_mask: -1,
        grade_known: false,
        cl_p: 0,
        cl_q: 0,
        reassoc_strategy: 0,
        forbidden_law_mask: 0,
        law_profile_source: 0,
        law_profile_fingerprint: 0,
    }
}

