pub fn ir_wide_cmp(dst: i64, src1: i64, src2: i64, limb_count: i64, cmp_op: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrWideCmp)
    IrInstr {
        op: base.op, dst: dst, src1: src1, src2: src2,
        imm_i64: limb_count, imm_f64: base.imm_f64, label_id: base.label_id,
        fn_id: base.fn_id, field_idx: cmp_op, imm_flags: base.imm_flags,
        bin_op: base.bin_op, un_op: base.un_op, name_id: base.name_id,
        call_args: base.call_args, arg_count: base.arg_count,
    }
}
pub fn ir_wide_shr(dst: i64, src: i64, limb_count: i64, shift_bits: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrWideShr)
    IrInstr {
        op: base.op, dst: dst, src1: src, src2: shift_bits,
        imm_i64: limb_count, imm_f64: base.imm_f64, label_id: base.label_id,
        fn_id: base.fn_id, field_idx: base.field_idx, imm_flags: base.imm_flags,
        bin_op: base.bin_op, un_op: base.un_op, name_id: base.name_id,
        call_args: base.call_args, arg_count: base.arg_count,
    }
}
