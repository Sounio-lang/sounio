// Check if a name is "validate_manifest" (for IR lowering intercept)
// "validate_manifest" = v(118) a(97) l(108) i(105) d(100) a(97) t(116) e(101)
//                       _(95) m(109) a(97) n(110) i(105) f(102) e(101) s(115) t(116), len=17
pub fn ir_name_is_validate_manifest(n: Name) -> bool {
    n.len == 17
    && n.buf[0]  == 118 as i8 && n.buf[1]  == 97  as i8
    && n.buf[2]  == 108 as i8 && n.buf[3]  == 105 as i8
    && n.buf[4]  == 100 as i8 && n.buf[5]  == 97  as i8
    && n.buf[6]  == 116 as i8 && n.buf[7]  == 101 as i8
    && n.buf[8]  == 95  as i8 && n.buf[9]  == 109 as i8
    && n.buf[10] == 97  as i8 && n.buf[11] == 110 as i8
    && n.buf[12] == 105 as i8 && n.buf[13] == 102 as i8
    && n.buf[14] == 101 as i8 && n.buf[15] == 115 as i8
    && n.buf[16] == 116 as i8
