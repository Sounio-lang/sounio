    && n.buf[2]  == 109 as i8 && n.buf[3]  == 109 as i8
    && n.buf[4]  == 105 as i8 && n.buf[5]  == 116 as i8
    && n.buf[6]  == 95  as i8 && n.buf[7]  == 97  as i8
    && n.buf[8]  == 108 as i8 && n.buf[9]  == 116 as i8
    && n.buf[10] == 101 as i8 && n.buf[11] == 114 as i8
    && n.buf[12] == 110 as i8 && n.buf[13] == 97  as i8
    && n.buf[14] == 116 as i8 && n.buf[15] == 105 as i8
    && n.buf[16] == 118 as i8 && n.buf[17] == 101 as i8
}

fn ir_name_is_transition_reason(n: Name) -> bool {
    n.len == 17
    && n.buf[0]  == 116 as i8 && n.buf[1]  == 114 as i8
    && n.buf[2]  == 97  as i8 && n.buf[3]  == 110 as i8
    && n.buf[4]  == 115 as i8 && n.buf[5]  == 105 as i8
    && n.buf[6]  == 116 as i8 && n.buf[7]  == 105 as i8
    && n.buf[8]  == 111 as i8 && n.buf[9]  == 110 as i8
    && n.buf[10] == 95  as i8 && n.buf[11] == 114 as i8
    && n.buf[12] == 101 as i8 && n.buf[13] == 97  as i8
    && n.buf[14] == 115 as i8 && n.buf[15] == 111 as i8
    && n.buf[16] == 110 as i8
}

fn ir_name_is_transition_step_count(n: Name) -> bool {
    n.len == 21
    && n.buf[0]  == 116 as i8 && n.buf[1]  == 114 as i8
    && n.buf[2]  == 97  as i8 && n.buf[3]  == 110 as i8
    && n.buf[4]  == 115 as i8 && n.buf[5]  == 105 as i8
    && n.buf[6]  == 116 as i8 && n.buf[7]  == 105 as i8
    && n.buf[8]  == 111 as i8 && n.buf[9]  == 110 as i8
    && n.buf[10] == 95  as i8 && n.buf[11] == 115 as i8
    && n.buf[12] == 116 as i8 && n.buf[13] == 101 as i8
    && n.buf[14] == 112 as i8 && n.buf[15] == 95  as i8
    && n.buf[16] == 99  as i8 && n.buf[17] == 111 as i8
    && n.buf[18] == 117 as i8 && n.buf[19] == 110 as i8
    && n.buf[20] == 116 as i8
}

// IrLiftKnowledge: lift_knowledge(k: Knowledge<T>) → Contest<T> bridge (H5.4)
// At machine level this is equivalent to IrCopy (MOV); the bridge is fully type-level.
fn ir_lift_knowledge(dst: i64, knowledge_reg: i64, contest_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrLiftKnowledge)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: knowledge_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: contest_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "lift_knowledge" (for IR lowering intercept)
// "lift_knowledge" = l(108) i(105) f(102) t(116) _(95) k(107) n(110) o(111)
//                   w(119) l(108) e(101) d(100) g(103) e(101), len=14
fn ir_name_is_lift_knowledge(n: Name) -> bool {
    n.len == 14
    && n.buf[0]  == 108 as i8 && n.buf[1]  == 105 as i8
    && n.buf[2]  == 102 as i8 && n.buf[3]  == 116 as i8
    && n.buf[4]  == 95  as i8 && n.buf[5]  == 107 as i8
    && n.buf[6]  == 110 as i8 && n.buf[7]  == 111 as i8
    && n.buf[8]  == 119 as i8 && n.buf[9]  == 108 as i8
    && n.buf[10] == 101 as i8 && n.buf[11] == 100 as i8
    && n.buf[12] == 103 as i8 && n.buf[13] == 101 as i8
}

// IrMeasure: measure(v: T, uncertainty: f64) → Knowledge<T> source (H5.5)
// At machine level this is equivalent to IrCopy (MOV); uncertainty is type-level only.
fn ir_measure(dst: i64, value_reg: i64, knowledge_meta_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrMeasure)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: value_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: knowledge_meta_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// IrDebugGuard: debug-mode policy guard — conditional trap (Sprint 28)
fn ir_debug_guard(metric_reg: i64, threshold: f64, cmp_op: i64, req_idx: i64, policy_name: Name) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrDebugGuard)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: metric_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: threshold,
        label_id: req_idx,
        fn_id: base.fn_id,
        field_idx: cmp_op,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: policy_name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Sprint 44: profiling counter increment — instrumented slow-path entry
fn ir_prof_counter(counter_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrProfCounter)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: base.src1,
        src2: base.src2,
        imm_i64: counter_id,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "measure" (for IR lowering intercept)
// "measure" = m(109) e(101) a(97) s(115) u(117) r(114) e(101), len=7
fn ir_name_is_measure(n: Name) -> bool {
    n.len == 7
    && n.buf[0] == 109 as i8 && n.buf[1] == 101 as i8
    && n.buf[2] == 97  as i8 && n.buf[3] == 115 as i8
    && n.buf[4] == 117 as i8 && n.buf[5] == 114 as i8
    && n.buf[6] == 101 as i8
}

