fn ir_empty_function() -> IrFunction {
    IrFunction {
        name: ir_empty_name(),
        instrs: [ir_nop(); 8192],
        instr_count: 0,
        reg_count: 0,
        label_count: 0,
        param_count: 0,
        param_regs: [IR_INVALID_REG; 64],
    }
}

fn ir_empty_module() -> IrModule {
    IrModule {
        functions: [ir_empty_function(); 1024],
        fn_count: 0,
        string_table: [ir_empty_name(); 4096],
        string_count: 0,
    }
}
