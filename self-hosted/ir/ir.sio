// Zig-style fixed-width wide-int ops. dst/src1/src2 = BASE vreg of each operand;
// limb k lives at vreg base+k (consecutive slots, limb 0 = least significant).
// limb_count = ceil(N/64) for an iN/uN value.
pub fn ir_wide_add(dst: i64, src1: i64, src2: i64, limb_count: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrWideAdd)
    IrInstr {
        op: base.op, dst: dst, src1: src1, src2: src2,
        imm_i64: limb_count, imm_f64: base.imm_f64, label_id: base.label_id,
        fn_id: base.fn_id, field_idx: base.field_idx, imm_flags: base.imm_flags,
        bin_op: base.bin_op, un_op: base.un_op, name: base.name,
        call_args: base.call_args, arg_count: base.arg_count,
    }
}
