// IR definitions for self-hosted post-checker phases

module ir::ir

use parser::ast::{Name, StringList, AstPath, BinaryOp, UnaryOp, CompareOp, make_name, name_eq, empty_name}
use check::types::{TypeEntry, empty_type_entry}

// These caps gate what the self-hosted pipeline can lower and execute.
// Keep them aligned with the fixed backing storage in IrModule/IrFunction so
// the lowering path can use the capacity that is already physically allocated.
//
// IR_MAX_INSTRS history:
//   1024 → 2048 (earlier) → 4096 (2026-07-20, unsplit oct_mul) → 3072 (2026-08-05)
//   → 4096 (2026-08-06, lex_source_to_globals) → 16384 (#1649, arena).
// Full exclusive-ref 8-component oct_mul lowers to ~2180 IR ops; under 2048 the
// body filled the array, IrReturn was dropped, and core_ir codegen fell through
// into main (ENTER/BEFORE_MUL re-entry storm). #1274 lo/hi split stayed green
// because each half is ~1100 ops.
//
// 16384 is affordable only because storage is now a variable-size arena region:
// the old inline [IrInstr; 4096] made this a per-IrModule reservation, so a 4x
// bump was a 4x bss bump. A region costs what the function actually uses.
// tests/run-pass/knowledge_octonion_structure.sio is 136 lines and needs 14389.
//
// RAISING THIS IS NOT A ONE-LINE CHANGE. Several analysis passes populate a
// FIXED per-instruction context and silently TRUNCATE at their own cap, which
// turns a partial analysis into a wrong one -- a use past the cap is unseen, so
// its definition looks dead. Every such pass must refuse the function instead of
// analysing a prefix of it. Pinned by
// scripts/ci/irfunction_instr_capacity_coherence_gate.sh.
// IR_MAX_FUNCS stays at main's 8192, NOT the 2048 this lane forked from. #1672
// measured the requirement: main.sio declares 10705 functions of which 5997 are
// reachable, and self-compilation needs the reachable set to fit. BSS is
// byte-identical at 2048/4096/8192 because the IrModule is allocated at runtime.
pub let IR_MAX_FUNCS: i64 = 16384
pub let IR_MAX_STRINGS: i64 = 16384
pub let IR_MAX_INSTRS: i64 = 16384
pub let IR_MAX_PARAMS: i64 = 64
pub let IR_INVALID_REG: i64 = -1
pub let IR_INVALID_LABEL: i64 = -1
pub let IR_INVALID_FN: i64 = -1
pub let IR_MAX_EPI_MODEL_FAMILIES: i64 = 32
pub let IR_MAX_EPI_POLICIES: i64 = 32
pub let IR_MAX_EPI_DECISION_POLICIES: i64 = 32
pub let IR_MAX_EPI_DEFERRAL_POLICIES: i64 = 32
pub let IR_MAX_EPI_ACQUISITION_POLICIES: i64 = 32
pub let IR_MAX_EPI_RECOURSE_POLICIES: i64 = 32
pub let IR_MAX_EPI_VALIDATIONS: i64 = 32
pub let IR_MAX_EPI_CONTESTS: i64 = 64
pub let IR_MAX_EPI_MECHANISTIC_REPORTS: i64 = 32
pub let IR_MAX_EPI_POSTERIOR_WEIGHTS: i64 = 32
pub let IR_MAX_EPI_COUNTEREXAMPLES: i64 = 32
pub let IR_MAX_EPI_AUDITS: i64 = 32
pub let IR_MAX_EPI_CONTEST_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ROBUST_PROOFS: i64 = 64
pub let IR_MAX_EPI_DECISION_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_DEFERRED_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_DEFERRED_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ACQUISITION_PLANS: i64 = 64
pub let IR_MAX_EPI_ACQUISITION_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_RECOURSE_PLANS: i64 = 64
pub let IR_MAX_EPI_RECOURSE_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_POLICIES: i64 = 32
pub let IR_MAX_EPI_ALTERNATIVE_FRONTIERS: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_CANDIDATES: i64 = 128
pub let IR_MAX_EPI_ALTERNATIVE_SETS: i64 = 64
pub let IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_TRANSITION_POLICIES: i64 = 32
pub let IR_MAX_EPI_TRANSITION_PROTOCOLS: i64 = 32
pub let IR_MAX_EPI_TRANSITION_STEPS: i64 = 64
pub let IR_MAX_EPI_TRANSITION_PLANS: i64 = 64
pub let IR_MAX_EPI_TRANSITION_REASON_WITNESSES: i64 = 64
pub let IR_MAX_EPI_MONITORING_POLICIES: i64 = 32
pub let IR_MAX_EPI_OBSERVED_TRANSITIONS: i64 = 64
pub let IR_MAX_EPI_ROLLBACK_CERTIFICATES: i64 = 64
pub let IR_MAX_EPI_VALIDATED_MANIFESTS: i64 = 64
pub let IR_MAX_EPI_HYPER_EXPRS: i64 = 128

let SOUNIO_ABI_VERSION: i64 = 1
let SOUNIO_RUNTIME_VERSION_MAJOR: i64 = 1
let SOUNIO_RUNTIME_VERSION_MINOR: i64 = 0
let SOUNIO_RUNTIME_VERSION_PATCH: i64 = 0
pub let IR_FLOAT_REG_MARKER_FLAG: i64 = 64064

pub enum IrOpcode {
    IrLoadImm,
    IrLoadFloat,
    IrIntToFloat,  // CVTSI2SD: i64 src → f64 dst (Sprint 87)
    IrFloatToInt,  // CVTTSD2SI: f64 src → i64 dst, truncate (Sprint 87)
    IrLoadBool,
    IrLoadString,
    IrCopy,
    IrBinOp,
    IrUnaryOp,
    IrCall,
    IrReturn,
    IrJump,
    IrBranchTrue,
    IrBranchFalse,
    IrFieldGet,
    IrFieldSet,
    IrIndexGet,
    IrIndexSet,
    IrArrayLen,   // dst = LOGICAL element COUNT of aggregate handle in src1 (object-header flags slot)
    IrAlloc,
    IrLabel,
    IrNop,
    IrPhi,
    // Vector IR — AVX10.2 unified-width packed-f64
    //   imm_i64  = L'L code: 0→ZMM (default), 1=YMM, 2=ZMM
    //   label_id = opmask register k0–k7 (0 = no masking)
    //   field_idx = imm8 predicate byte (IrVecMinMaxPD only)
    IrVecAddF64,   // EVEX VADDPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecMulF64,   // EVEX VMULPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecFmaF64,   // EVEX VFMADD231PD: dst = src1*src2 + dst
    IrVecSubF64,   // EVEX VSUBPD    {xmm|ymm|zmm}_dst, src1, src2
    IrVecMinMaxPD, // EVEX VMINMAXPD {xmm|ymm|zmm}_dst, src1, src2, imm8  (MAP5 0x52)
    // K-register logical ops — VEX.L0/L1.66.0F.W0
    //   dst  = destination k-register (0–7)
    //   src1 = first source k-register (binary ops)
    //   src2 = second source k-register
    IrMaskAnd,     // VEX KANDW  k_dst, k_src1, k_src2  (opcode 0x41, L=1)
    IrMaskOr,      // VEX KORW   k_dst, k_src1, k_src2  (opcode 0x45, L=1)
    IrMaskNot,     // VEX KNOTW  k_dst, k_src           (opcode 0x44, L=0)
    IrMaskMov,     // VEX KMOVW  k_dst, k_src           (opcode 0x90, L=0)
    // Vector utility ops — prerequisites for hypercomplex
    //   IrVecPermilPD:    imm_i64=vl_code, src1=ctrl_reg, src2=data_reg  (reg-reg form)
    //   IrVecPermilPDImm: imm_i64=vl_code, field_idx=imm8_ctrl, src2=data_reg  (imm8 form)
    //   IrVecAddSubPD:    standard imm_i64=vl, label_id=mask_k
    IrVecPermilPD,    // EVEX VPERMILPD reg-reg: dst=permute(src2,src1_ctrl)  map=2 0x0D
    IrVecPermilPDImm, // EVEX VPERMILPD imm8:   dst=permute(src2,imm8_ctrl)  map=3 0x05
    IrVecAddSubPD,    // EVEX VADDSUBPD:        dst[i]=src1[i] +-+- src2[i]  map=1 0xD0
    // Hypercomplex multiply
    //   dst  = result register (YMM for quaternion, vl=1)
    //   src1 = left operand register
    //   src2 = right operand register
    IrHyperMulQ,      // Quaternion Hamilton product via 8-instr EVEX sequence
    // Octonion vector primitives (prerequisites for hypercomplex-O ops)
    //   IrVecXorPD:   map=1 op=0x57   EVEX.66.0F.W1 57 /r  — f64 bitwise XOR (sign flip)
    //   IrVecPermpd:  map=2 op=0x16   EVEX.66.0F38.W1 16 /r — arbitrary YMM permute (reg-indexed)
    //   Both: dst/src1/src2 = YMM reg indices, imm_i64 = vl_code (1=YMM)
    //         label_id & 7 = mask k-register, imm_flags & 1 = z-bit
    IrVecXorPD,       // VXORPD: bitwise XOR packed f64                        map=1 op=0x57
    IrVecPermpd,      // VPERMPD reg-indexed: arbitrary YMM/ZMM f64 permute     map=2 op=0x16
    // Octonion hypercomplex ops (post-3.6.1)
    //   IrHyperConjugateO: paired-YMM unchanged from 3.6
    //   IrHyperMulO (3.6.1+): single-ZMM Fano-plane convention
    //     lane 0 = real e0, lanes 1-7 = e1..e7, vl_code = 2 (ZMM)
    //     INVARIANT: dst/src1/src2 are valid ZMM indices; no paired-register requirement.
    //   label_id = (mask_k & 7) | (ctrl_base << 4)
    //              low 3 bits = output k-register (0 = k0 = no mask)
    //              bits 7:4   = base ZMM index for 21 pre-loaded Fano constants
    //                           [+0..+6]  broadcast ctrl for b[1..7] (ZMM = [j,j,j,j,j,j,j,j])
    //                           [+7..+13] permutation ctrl for a columns 1..7
    //                           [+14..+20] sign masks for columns 1..7 (0x8000… = negative)
    //   imm_flags bit 0 = z-bit (0 = merge-masking, 1 = zero-masking)
    //   IrHyperConjugateO label_id still encodes (mask_k & 7) | (sign_ymm << 4)
    IrHyperConjugateO, // Octonion conjugate: 2×VXORPD, flip e₁–e₇ in both YMM halves (12 bytes)
    IrHyperMulO,       // Octonion Hamilton product, Fano single-ZMM, 31 instr / 186 bytes
    IrHyperNormSqO,    // Octonion norm-squared Σeᵢ², 7 instr / 44 bytes, broadcast to all lanes
    // Sedenion hypercomplex ops (Horizon 5.1 — FSNN pipeline)
    //   IrHyperMulS: Cayley-Dickson sedenion multiply via 4 Fano-plane octonionic products.
    //   (a,b)*(c,d) = (ac - conj(d)*b, da + b*conj(c))
    //   Each sedenion = 2 ZMM registers (alpha in even, beta in odd):
    //     src1   = ZMM alpha_a (lanes 0-7 = e0-e7)
    //     src1+1 = ZMM beta_b  (lanes 0-7 = e8-e15)
    //     src2   = ZMM alpha_c
    //     src2+1 = ZMM beta_d
    //     dst    = ZMM result alpha
    //     dst+1  = ZMM result beta
    //   Scratch: dst+2..dst+9 (8 scratch ZMMs)
    //   label_id encoding: same as IrHyperMulO
    //     bits 2:0 = mask_k (0 = k0 = no mask)
    //     bits 7:4 = ctrl_base for 21 Fano constants
    //     bits 11:8 = conj_sign_zmm (ZMM with lanes 1-7 = 0x8000..., lane 0 = 0x0)
    //   imm_flags bit 0 = z-bit
    //   Total: 4×31 (Fano) + 2 (conjugate) + 2 (add/sub) = 128 EVEX instructions
    IrHyperMulS,       // Sedenion Hamilton product, 2×ZMM Cayley-Dickson, 128 instr / 768 bytes
    // Associator op — first compiler to represent [a,b,c] = (ab)c − a(bc) as an IR node.
    //   dst    = result ZMM (8 f64 lanes = associator vector; or scalar norm if imm_flags bit 1)
    //   src1   = a ZMM register index
    //   src2   = b ZMM register index
    //   imm_i64 = c ZMM register index (third operand packed as immediate)
    //   label_id = (mask_k & 7) | (ctrl_base << 4)  — same encoding as IrHyperMulO
    //   imm_flags bit 0 = z-bit (zeroing-mask on output)
    //   imm_flags bit 1 = scalar_norm mode (1 = emit norm reduction after subtraction)
    //   Algorithm: 4 Fano-plane multiplies (reusing emit_fano_inline) + 1 VSUBPD
    //     t_ab = fano(a,b); t_abc = fano(t_ab,c); t_bc = fano(b,c); t_abc2 = fano(a,t_bc)
    //     dst = t_abc - t_abc2
    //   Scratch: dst+2..dst+13 (12 ZMMs; same layout as IrHyperMulS halves)
    //   Total: 4×31 + 1 = 125 EVEX instructions / ~750 bytes
    //   Optimization: if ir_can_reassociate_triple() → dst zeroed via VXORPD (2 instrs, 12 bytes)
    IrAssociator,      // Octonion associator [a,b,c] = (ab)c − a(bc), 125 instr / 750 bytes
    // Door β — Variance-of-Associator: GUM-correct uncertainty propagation for Knowledge<O>.
    //
    // The first compiler to correctly propagate ISO GUM uncertainty through non-associative
    // arithmetic. The component-wise product rule Var(a·b) = a²Var(b) + b²Var(a) is WRONG
    // for octonion products when the triple (a,b,c) does not lie on a Fano line, because
    // the intermediate products (ab)c and a(bc) are correlated through [a,b,c] ≠ 0.
    //
    // The 168 theorem (Agourakis 2026) is the optimization gate:
    //   of 343 ordered octonion basis triples, exactly 168 lie on Fano lines → [a,b,c] = 0
    //   → variance correction = 0 → 1 VXORPD instruction (254× cheaper than non-Fano path).
    //   The remaining 175 triples emit the full correction: ||[a,b,c]||² × σ².
    //
    //   dst     = result ZMM (8 f64 lanes, per-component variance correction)
    //   src1    = a ZMM register index
    //   src2    = b ZMM register index
    //   imm_i64 = c ZMM register index (third operand packed as immediate)
    //   label_id = (mask_k & 7) | (ctrl_base << 4)   — same encoding as IrAssociator
    //   imm_f64  = σ² (combined variance, bit-cast i64 >> 8, set by type-checker)
    //   imm_flags bit 0 = z-bit (zeroing mask)
    //   imm_flags bit 1 = fano_exact (1 → Fano triple, emit VXORPD → 1 instr / 6 bytes)
    //
    // Fano path (imm_flags bit 1 = 1):
    //   VXORPD dst, dst, dst   → 1 EVEX / 6 bytes  (correction = 0)
    //
    // Non-Fano path (imm_flags bit 1 = 0):
    //   Steps 1-5: lower_associator (reused) → [a,b,c] in dst   ~125 EVEX
    //   Step 6: VMULPD dst, dst, dst   (||[a,b,c]||² component-wise)   1 EVEX
    //   Step 7: VBROADCASTSD t_sigma, [σ²]                             1 EVEX
    //   Step 8: VMULPD dst, dst, t_sigma  (scale by σ²)                1 EVEX
    //   Total: ~128 EVEX instructions / ~768 bytes
    //
    // Scratch: dst+2..dst+13 (same 12-ZMM layout as IrAssociator)
    IrAssociatorVariance, // Door β: Var([a,b,c]) correction, 1 instr (Fano) / ~128 (non-Fano)
    // Sedenion zero-divisor check — first type system to detect ZD pairs at compile time.
    //   For literal sedenion basis elements: eliminated at type-check (zero runtime cost).
    //   For non-literal operands: runtime bitmask test → epistemic ZD warning flag.
    //   dst    = result flag register (i64: 0 = safe, 1 = ZD risk detected)
    //   src1   = first sedenion ZMM pair (src1=alpha, src1+1=beta)
    //   src2   = second sedenion ZMM pair (src2=alpha, src2+1=beta)
    //   Lowering: type-level annotation → lowers to NOP/MOV (type-checker handles the gate)
    IrSedZDCheck,      // Sedenion ZD check: compile-time bitmask gate, runtime NOP
    // G₂-equivariant ops (Horizon 3.7)
    //   G₂ = Aut(𝕆), the 14-dimensional exceptional Lie group preserving the Fano-plane
    //   multiplication table. Its Lie algebra 𝔤₂ consists of derivations acting on Im(𝕆) ≅ ℝ⁷
    //   (lanes 1-7 of a single ZMM; lane 0 = real part = 0 for imaginary projections).
    //
    //   IrG2ProjectImO: zero lane 0 → project from 𝕆 to Im(𝕆)
    //     VANDPD dst, src, imag_mask (lane 0 = 0x0, lanes 1-7 = 0xFFFF…)
    //     label_id = (mask_k & 7) | (imag_mask_zmm << 4)
    //     imm_flags bit 0 = z-bit
    //
    //   IrG2ApplyGenO: apply 7×7 matrix to Im(𝕆) via column-major multiply
    //     Same broadcast-and-FMA pattern as Fano columns: for each j=1..7,
    //     broadcast input[j], VFMADD with column_j of the generator matrix.
    //     label_id = (mask_k & 7) | (col_base << 4)
    //       col_base+0..6 = 7 column ZMMs (preloaded generator matrix rows)
    //     field_idx = generator ID (0..13) for documentation; lowering uses col_base
    //     Broadcast ctrls reused from Fano constants ([j,j,j,j,j,j,j,j])
    //     16 instr / 96 bytes: 1 VXORPD + 7×(VPERMPD + VFMADD231PD) + 1 VMOVAPD
    //
    //   IrG2DenseO: G₂-equivariant dense layer = project + apply + store
    //     Composes IrG2ProjectImO + IrG2ApplyGenO internally
    //     17 instr / 102 bytes
    IrG2ProjectImO,    // Project to Im(𝕆): zero lane 0 via VANDPD, 1 instr / 6 bytes
    IrG2ApplyGenO,     // Apply 𝔤₂ generator: 7×7 matrix-vector on Im(𝕆), 16 instr / 96 bytes
    IrG2DenseO,        // G₂-equivariant dense: project + apply, 17 instr / 102 bytes
    // G₂-equivariant dense kernel with IEEE-754-2019 robustness (Horizon 3.8)
    //   Full pipeline: project → G₂ matrix-vector → VMINMAXPD NaN/±0 clamp → masked store
    //   18 instructions / 109 bytes:
    //     1 VANDPD (project, 6) + 1 VXORPD (zero, 6) + 7×(VPERMPD+VFMADD231PD) (84)
    //     + VMINMAXPD{k}{z}+imm8 (IEEE clamp, 7) + VMOVAPD{k}{z} (store, 6)
    //   label_id = (mask_k & 7) | (col_base << 4)   — same encoding as IrG2DenseO
    //   imm_flags bit 0 = z-bit (zeroing-mask)
    //   src1 = input ZMM, src2 = imag_mask ZMM (lane 0 = 0x0, lanes 1-7 = 0xFF…)
    IrG2EquivDenseKernelO, // G₂-equivariant dense kernel + IEEE robustness, 18 instr / 109 bytes
    // E₈ root reflection — Weyl group action on the rank-8 Cartan subalgebra (Horizon 3.9)
    //   E₈ = largest exceptional Lie algebra (dim 248, rank 8, 240 roots).
    //   All E₈ roots have ⟨α,α⟩ = 2, so: s_α(v) = v − ⟨v,α⟩·α  (no /2 needed).
    //
    //   ZMM carries 8 f64 lanes ≅ one vector in the Cartan subalgebra ℝ⁸.
    //   Algorithm (8 instr / 48 bytes):
    //     1. VMULPD t, v, α                     — elementwise product (6B)
    //     2. VPERMPD t2, ctrl0, t [swap halves]  — reduce 8→4 (6B)
    //     3. VADDPD t, t, t2                     — partial sums      (6B)
    //     4. VPERMPD t2, ctrl1, t [swap pairs]   — reduce 4→2 (6B)
    //     5. VADDPD t, t, t2                     — partial sums      (6B)
    //     6. VPERMPD t2, ctrl2, t [swap adj]     — reduce 2→1 (broadcast) (6B)
    //     7. VADDPD t, t, t2                     — dot broadcast to all 8 lanes (6B)
    //     8. VFNMADD231PD v, t, α                — v = v − t·α        (6B)
    //
    //   Encoding:
    //     dst  = v ZMM index (input → output, updated in-place)
    //     src1 = α ZMM index (root vector, read-only)
    //     src2 = t ZMM index (scratch dot-product accumulator)
    //     t2   = src2 + 2   (second scratch; caller must leave free)
    //     label_id = (mask_k & 7) | (ctrl_base << 4)
    //       ctrl_base+0: control ZMM for swap-halves    [4,5,6,7,0,1,2,3]
    //       ctrl_base+1: control ZMM for swap-pairs     [2,3,0,1,6,7,4,5]
    //       ctrl_base+2: control ZMM for swap-adjacent  [1,0,3,2,5,4,7,6]
    //     imm_flags bit 0 = z-bit (zeroing-mask on final VFNMADD)
    IrE8RootReflectO,      // E₈ Weyl reflection s_α(v) = v − ⟨v,α⟩·α, 8 instr / 48 bytes
    // F₄ root reflection — rank 4, dim 52, 48 roots (Horizon 4.0)
    //   NOT simply-laced: short/long root ratio √2.  Pre-normalize roots to ⟨α,α⟩=2
    //   so the E₈ tree-reduction pattern applies unchanged.
    //   Algorithm: same 8-lane VMULPD + 3×(VPERMPD+VADDPD) + VFNMADD231PD
    //   Unused lanes 4-7 zeroed → contribute 0 to dot product.
    //   8 instr / 48 bytes.  Encoding identical to IrE8RootReflectO.
    IrF4RootReflectO,
    // E₆ root reflection — rank 6, dim 78, 72 roots, simply-laced (Horizon 4.0)
    //   Same algorithm as E₈; lanes 6-7 zeroed.  8 instr / 48 bytes.
    IrE6RootReflectO,
    // E₇ root reflection — rank 7, dim 133, 126 roots, simply-laced (Horizon 4.0)
    //   Same algorithm as E₈; lane 7 zeroed.  8 instr / 48 bytes.
    IrE7RootReflectO,
    // Cartan matrix multiply — column-major broadcast-and-FMA (Horizon 4.0)
    //   Applies the Cartan matrix A_{ij} = 2⟨αᵢ,αⱼ⟩/⟨αⱼ,αⱼ⟩ to a weight vector.
    //   Column vectors preloaded into ZMM registers at col_base+0..N-1.
    //   Broadcast ctrls at bcast_base = col_base − rank.
    //   Pattern: VXORPD + N×(VPERMPD+VFMADD231PD) + VMOVAPD
    //   label_id = (mask_k & 7) | (col_base << 4), imm_flags bit 0 = z-bit
    //   Registers: dst=output, src1=input, t_bcast=dst+2, accum=dst+4
    IrF4CartanMulO,        // F₄ 4×4 Cartan, 10 instr / 60 bytes
    IrE6CartanMulO,        // E₆ 6×6 Cartan, 14 instr / 84 bytes
    IrE7CartanMulO,        // E₇ 7×7 Cartan, 16 instr / 96 bytes
    IrE8CartanMulO,        // E₈ 8×8 Cartan, 18 instr / 108 bytes
    // Epistemic runtime — Contest<T> transparent wrapper (H5.0)
    //   dst  = destination register (holds contested datum)
    //   src1 = subject register (the "on" expression result)
    //   imm_i64 = number of model arguments
    //   Codegen: MOV dst, src1 (zero-cost at machine level; model selection = proof-time)
    IrContest,             // Contest<T> intro: dst = subject datum, annotated as contested
    // Epistemic runtime — prove_robust transparent wrapper (H5.1)
    //   dst  = destination register (holds the proven datum)
    //   src1 = contest register (the contested subject)
    //   src2 = policy register (ignored at runtime; satisfaction is type-level)
    //   Codegen: MOV dst, src1 (zero-cost; proof obligation is fully discharged at type-check)
    IrProveRobust,         // prove_robust(contest, policy): Robust<T> intro, zero-cost copy
    // Epistemic runtime — validate_manifest terminal gate (H5.2)
    //   dst  = destination register (holds the validated datum)
    //   src1 = robust register (the proven Robust<T> subject)
    //   Codegen: MOV dst, src1 (zero-cost; validation is type-level only)
    IrValidated,           // validate_manifest(robust): Validated<T> terminal, zero-cost copy
    // Decision-admissibility runtime — admit_action(value, robust, policy) terminal gate
    //   dst  = destination register (holds the admitted datum)
    //   src1 = value register (the datum/action being admitted)
    //   src2 = robust register (the proof-carrying Robust<T> evidence)
    //   imm_i64 = decision policy register (carried for metadata only)
    //   label_id = decision certificate id
    //   Codegen: MOV dst, src1 (zero-cost; admissibility is discharged at type-check)
    IrAdmitAction,         // admit_action(value, robust, decision_policy): Admissible<T> terminal
    // Decision-deferral runtime — defer_action(value, evidence, policy) terminal gate
    //   dst  = destination register (holds the deferred datum)
    //   src1 = value register
    //   src2 = evidence register (Contest<T> datum or Robust<T> datum)
    //   imm_i64 = deferral policy register (metadata only)
    //   label_id = deferred certificate id
    //   Codegen: MOV dst, src1 (zero-cost; deferral is discharged at type-check)
    IrDeferAction,         // defer_action(value, evidence, deferral_policy): Deferred<T> terminal
    // Resolution runtime — plan_acquisition(value, deferred, policy) terminal gate
    //   dst = destination register (holds the planned datum)
    //   src1 = value register
    //   src2 = deferred register
    //   imm_i64 = acquisition policy register (metadata only)
    //   label_id = acquisition plan id
    IrPlanAcquisition,
    // Resolution runtime — plan_recourse(value, deferred, policy) terminal gate
    //   dst = destination register (holds the planned datum)
    //   src1 = value register
    //   src2 = deferred register
    //   imm_i64 = recourse policy register (metadata only)
    //   label_id = recourse plan id
    IrPlanRecourse,
    // Alternative frontier runtime — propose_alternatives(value, evidence, frontier) terminal gate
    //   dst = destination register (holds the certified AlternativeSet<T> datum)
    //   src1 = value register
    //   src2 = evidence register (Deferred<T> or RecoursePlan<T>)
    //   imm_i64 = frontier/policy register (metadata only)
    //   label_id = alternative set id
    IrProposeAlternatives,
    // Transition protocol runtime — commit_alternative(value, option, protocol) terminal gate
    //   dst = destination register (holds the certified TransitionPlan<T> datum)
    //   src1 = value register
    //   src2 = selected AlternativeOption<T> register
    //   imm_i64 = transition protocol register (metadata only)
    //   label_id = transition plan id
    IrCommitAlternative,
    // Transition monitoring runtime — observe_transition(value, plan, monitoring_policy) terminal gate
    //   dst = destination register (holds the certified ObservedTransition<T> datum)
    //   src1 = value register
    //   src2 = TransitionPlan<T> register
    //   imm_i64 = monitoring policy register (metadata only)
    //   label_id = observed transition id
    IrObserveTransition,
    // Transition rollback runtime — rollback_transition(value, plan, monitoring_policy) terminal gate
    //   dst = destination register (holds the certified RollbackCertificate<T> datum)
    //   src1 = value register
    //   src2 = TransitionPlan<T> register
    //   imm_i64 = monitoring policy register (metadata only)
    //   label_id = rollback certificate id
    IrRollbackTransition,

    // Epistemic bridge — lift_knowledge(k: Knowledge<T>) → Contest<T> (H5.4)
    //   dst  = destination register (holds the lifted datum)
    //   src1 = knowledge register (the Knowledge<T> observation)
    //   Codegen: MOV dst, src1 (zero-cost; bridge is type-level only)
    IrLiftKnowledge,       // lift_knowledge(knowledge): Contest<T> intro from Knowledge<T>

    // Epistemic source — measure(v: T, uncertainty: f64) → Knowledge<T> (H5.5)
    //   dst  = destination register (holds the observed datum)
    //   src1 = value register (the T being measured)
    //   Codegen: MOV dst, src1 (zero-cost; uncertainty is type-level metadata)
    IrMeasure,             // measure(value, uncertainty): Knowledge<T> intro from raw observation

    // Effect handler block boundaries — row-polymorphic effect handling (H6.2)
    //   IrHandleBegin: marks the start of a handle block
    //     src1 = handler_id register (identifies this handler scope)
    //     imm_i64 = effect_def_id (which effect definition is being handled)
    //   IrHandleEnd: marks the end of a handle block, produces result
    //     src1 = result register (the handled expression's result)
    IrHandleBegin,         // Begin handle block: src1=handler_id, imm_i64=effect_def_id
    IrHandleEnd,           // End handle block: src1=result_reg

    // Debug-mode policy guard — conditional trap for witness enforcement (Sprint 28)
    //   src1 = metric value register (i64 or f64)
    //   imm_f64 = threshold value for policy requirement
    //   field_idx = comparison operator (0=Eq, 1=Ne, 2=Lt, 3=Le, 4=Gt, 5=Ge)
    //   label_id = policy requirement index (for diagnostics)
    //   name = policy name (for debug error message)
    //   Codegen (debug): CMP/UCOMISD + conditional jump over UD2 trap
    //   Codegen (release): not emitted (zero cost)
    IrDebugGuard,
    // Profiling counter increment — slow-path entry (Sprint 44)
    //   imm_i64 = counter_id (index into IrModule.prof_counters)
    //   Native lowering: 7-byte NOP placeholder (Sprint 44), ADD [RIP+disp32],1 (Sprint 45)
    IrProfCounter,
    // Call to external C ABI function (Sprint 108: extern "C" fn FFI)
    //   name = C symbol name, call_args/arg_count = SysV args, dst = result reg
    IrCallExtern,
    // Load a function reference as a first-class value (Sprint 228: closures)
    //   dst = destination register, fn_id = index into IrModule.functions
    //   At runtime the register holds the fn_id as an integer.
    IrLoadFnRef,
    // Indirect function call through a register holding a fn_id (Sprint 228: closures)
    //   dst = result register, src1 = register holding fn_id
    //   call_args/arg_count = arguments (same as IrCall)
    IrCallIndirect,
    // Albert algebra J₃(O) — exceptional Jordan algebra (27-dimensional).
    // J₃(O) is the unique exceptional simple Jordan algebra (Jordan-von Neumann-Wigner 1934).
    // Automorphism group: F₄ (52-dimensional exceptional Lie group, 48 roots).
    // Connection: 3 fermion generations ↔ 3×3 block structure (arxiv:2006.16265).
    // This is the first compiler with a native Jordan product primitive for J₃(O).
    //
    // Register layout (4 ZMM regs per J₃(O) element):
    //   base+0: diagonal (e₁₁, e₂₂, e₃₃, 0, 0, 0, 0, 0) — 3 real diagonals in first 3 lanes
    //   base+1: e₁₂ octonion (off-diagonal row 0, 8 f64 lanes)
    //   base+2: e₁₃ octonion (off-diagonal row 1, 8 f64 lanes)
    //   base+3: e₂₃ octonion (off-diagonal row 2, 8 f64 lanes)
    //   e₂₁ = conj(e₁₂), e₃₁ = conj(e₁₃), e₃₂ = conj(e₂₃) — computed on demand via IrHyperConjugateO
    //
    // IrJ3OJordanMul: a ∘ b = (a·b + b·a) / 2  (Jordan product)
    //   src1 = base ZMM of a (4 ZMMs: src1, src1+1, src1+2, src1+3)
    //   src2 = base ZMM of b (4 ZMMs: src2, src2+1, src2+2, src2+3)
    //   dst  = base ZMM of result (4 ZMMs: dst, dst+1, dst+2, dst+3)
    //   label_id bits 3:0 = mask_k
    //   label_id bits 7:4 = ctrl_base for Fano constants (reuses IrHyperMulO ctrl)
    //   imm_flags bit 0 = z-bit
    //   imm_flags bit 1 = symmetry_hint (1 = input is already symmetric → skip b·a computation)
    //   Total: 2×IrJ3OMatMul + 16 VADDPD + 8 VMULPD ≈ 668 EVEX instructions
    //   Scratch: dst+4..dst+15 (12 ZMMs for two mat-mul intermediate results)
    IrJ3OJordanMul,     // Albert Jordan product a∘b = (ab+ba)/2, first native J₃(O) primitive
    // IrJ3OTrace: trace of a 3×3 octonion matrix = sum of 3 diagonal f64 values
    //   src1 = base ZMM of input (only diagonal lane 0 is used)
    //   dst  = scalar result ZMM (trace broadcast to all lanes)
    //   Lowering: VADDPD on diagonal lanes (2 VADDPD + 1 VHADDPD = 4 instrs / 24 bytes)
    IrJ3OTrace,         // Trace: sum of 3 diagonal elements → scalar broadcast, 4 instr
    // IrJ3ODet: Freudenthal cubic form N(A) = tr(A³)/3 − tr(A)tr(A²)/6 + tr(A)³/18
    //   Valid over non-associative algebras by alternativity of octonions (Artin's theorem).
    //   Deferred: ~1200 instructions; placeholder in this sprint, wired in Phase 5b.
    IrJ3ODet,           // Freudenthal cubic form (placeholder, wired in Phase 5b)
    // Fractal escape-time iteration — first compiler primitive for hypercomplex fractals.
    // When algebra_tag is a compile-time constant, the compiler generates algebra-specialized
    // machine code: no virtual dispatch, no branch on algebra type inside the hot loop.
    // For quaternion (4 components, YMM), loop body ≈ 12 instrs. For octonion (8, ZMM) ≈ 38.
    //
    // The epistemic return: EscapeData carries basin_confidence: Knowledge<f64> —
    // the GUM uncertainty in the escape estimate from accumulated floating-point error.
    // This is the first fractal primitive with compile-time ISO GUM propagation.
    //
    // IrFractalEscape encoding:
    //   dst      = first slot of EscapeData (iters: i64; dst+1 = z_final ZMM; dst+2 = confidence f64)
    //   src1     = z0 ZMM register (initial value in the algebra)
    //   src2     = c  ZMM register (parameter)
    //   imm_i64  = max_iters (iteration limit)
    //   label_id bits 3:0 = algebra_tag (IR_ALG_QUATERNION=2, IR_ALG_OCTONION=3, IR_ALG_SEDENION=4)
    //   label_id bits 7:4 = ctrl_base for Fano constants (same as IrHyperMulO)
    //   imm_flags bit 0   = z-bit
    //   imm_f64  = radius² (precomputed by type-checker, stored as bit-cast i64 in label_id >> 8)
    // Loop body (algebra-dispatched at lowering time, no runtime branch):
    //   z ← z*z + c  (algebra multiply + VADDPD)
    //   escaped ← |z|² > radius²  (norm + UCOMISD)
    //   counter ← counter − 1  (DEC + JNZ)
    // basin_confidence = u_radius / sqrt(2 * iters_taken)  (ISO 5725 conservative bound)
    IrFractalEscape,        // Hypercomplex escape-time iteration, algebra-specialized codegen
    // Clifford algebra grade operations — first IR with grade as first-class attribute.
    // Grade is tracked via IrHyperExprInfo.grade_mask (bit k = grade-k blades present).
    // Dead-grade pruning: if grade_known && grade_mask == 0, node → VXORPD zero (e-graph).
    //
    // IrCliffordGradeSel — extract the grade-k part of a multivector (grade projection)
    //   dst   = result ZMM (grade-k components only; others zeroed)
    //   src1  = input multivector ZMM
    //   imm_i64 = k (grade to extract, 0 ≤ k ≤ p+q)
    //   label_id = (mask_k & 7) | (grade_lane_mask_zmm << 4)
    //     grade_lane_mask_zmm = preloaded ZMM with 0xFFFF… for grade-k lanes, 0x0 for others
    //   Lowering: VANDPD dst, src1, grade_lane_mask_zmm  (1 EVEX instr / 6 bytes)
    //   IrHyperExprInfo.grade_mask = (1 << k); grade_known = true
    IrCliffordGradeSel,     // Grade-k projection: VANDPD with grade mask ZMM, 1 instr / 6 bytes
    // IrCliffordGradeMul — geometric product with grade-mask propagation
    //   dst    = result ZMM
    //   src1   = left multivector ZMM  (IrHyperExprInfo carries grade_mask_a)
    //   src2   = right multivector ZMM (IrHyperExprInfo carries grade_mask_b)
    //   label_id bits 3:0 = mask_k; bits 11:4 = Clifford multiplication table base ZMM
    //   IrHyperExprInfo.grade_mask = ir_clifford_grade_product(grade_mask_a, grade_mask_b)
    //   Dead-grade: if result grade_mask == 0 → node replaced by VXORPD zero
    //   imm_i64 bits 7:0 = grade_mask_a; bits 15:8 = grade_mask_b; bits 23:16 = max_grade
    //   Lowering (Door Γ):
    //     grade_out = ir_clifford_grade_product(grade_mask_a, grade_mask_b, max_grade)
    //     grade_out == 0          → VXORPD (dead-grade elimination, 1 EVEX)
    //     grade_mask_a == 1 (scalar) → VBROADCASTSD + VMULPD (scalar scale, 2 EVEX)
    //     general                → grade-sparse scaffold (VMOVAPD + e-graph annotation)
    IrCliffordGradeMul,     // Door Γ: grade-exact GP, dead-grade elimination at IR level

    // ─── Door Ω — Tropical Epistemic Arithmetic ─────────────────────────────
    // IrTropicalAdd — tropical addition min(a,b) with GUM-epistemic uncertainty.
    //   First IR with GUM-correct uncertainty for the min-plus tropical semiring.
    //   val_out = min(a_val, b_val)                         (1 VMINPD)
    //   eps_out (certain gap >> σ):  VMINPD eps_a, eps_b   (1 VMINPD — eps of argmin)
    //   eps_out (critical gap ≈ 0):  (eps_a+eps_b)/4       (VADDPD + 0.25-broadcast + VMULPD)
    //   Encoding:
    //     dst  = val ZMM;   dst+1 = eps ZMM
    //     src1 = a_val ZMM; src1+1 = a_eps ZMM
    //     src2 = b_val ZMM; src2+1 = b_eps ZMM
    //     imm_f64  = σ_combined (gap threshold for "certain argmin" branch)
    //     imm_flags bit 0: certain=1 → static gap >> σ proved (fast VMINPD eps path)
    IrTropicalAdd,  // Door Ω: tropical min(a,b) with GUM epistemic on the argmin

    // IrTropicalMul — tropical multiplication (ordinary +) with GUM uncertainty.
    //   val_out = a_val + b_val   (tropical "×" = ordinary + in (ℝ,min,+))
    //   eps_out = eps_a + eps_b   (GUM addition rule — identical arithmetic to IrFAdd)
    //   Type-annotation novelty: node carries tropical semiring membership → e-graph applies
    //   min-plus laws: distributivity (a⊗(b⊕c))=(a⊗b)⊕(a⊗c), associativity, etc.
    //   Lowering: 2 VADDPD (val + eps)
    IrTropicalMul,  // Door Ω: tropical a+b (type-annotated, min-plus semiring)

    // ─── Door Σ — Free Probability / R-Transform ────────────────────────────
    // IrFreeConvolve — free convolution K<a> ⊞ K<b> via R-transform linearization.
    //   First compiler where Knowledge<T> carries a distribution_class annotation
    //   and emits free-probability-correct variance propagation.
    //   Voiculescu R-transform: R_{a⊞b}(z) = R_a(z) + R_b(z).
    //   Wigner semicircle(σ²): R_W(z) = σ²·z  →  free conv of σ²_a and σ²_b gives σ²_a+σ²_b.
    //   Gaussian(σ²):          R_G(z) = σ²·z  →  same first-order formula; differs at κ₄.
    //   val_out      = a_val + b_val           (means add — same as classical)
    //   sigma_sq_out = σ²_a + σ²_b            (R-transform additivity)
    //   imm_flags bit 1: dist_class (0=Gaussian, 1=Wigner semicircle)
    //   Lowering: 2 VADDPD (val + sigma_sq).  The mathematical distinction is the TYPE and
    //   the 4th-moment: m₄(a⊞b) = 2(σ²_a+σ²_b)² [Wigner] vs 3(σ²_a+σ²_b)² [Gaussian].
    IrFreeConvolve, // Door Σ: free convolution K<a>⊞K<b>, dist_class annotated

    // ─── Door Δ — Muraki's Independence Pentagon ──────────────────────────────
    // Muraki (2003) proved there are exactly FIVE universal notions of non-commutative
    // independence. Sounio now has Classical (GUM/ISO) and Free (Door Σ). Door Δ adds
    // Boolean and Monotone, completing the classification. No other compiler has done this.
    //
    // All five theories give identical variance propagation (first order):
    //   Var_out = Var_a + Var_b
    // The 4th moment (kurtosis κ = m₄/σ⁴) distinguishes them:
    //   Classical:  κ = 3  (Gaussian, Isserlis theorem)
    //   Free:       κ = 2  (Wigner semicircle, Catalan C₂)
    //   Monotone:   κ = 3/2 (arcsine on [-2σ,2σ])
    //   Boolean:    κ = 1  (Bernoulli {-σ,+σ}, X²=σ² a.s.)
    //   Anti-mono:  κ = 3/2 (mirror arcsine, same κ as monotone)
    //
    // IrBooleanConvolve — Boolean ⊎ convolution of Knowledge values.
    //   Boolean independence: X, Y project onto orthogonal subspaces of the Hilbert space.
    //   CLT limit: Bernoulli {-σ, +σ}.  m₄ = (σ²_out)²  (minimum kurtosis).
    //   Encoding: dst+0=val_out, dst+1=sigma_sq_out; src1/src2 same layout.
    //   imm_flags bit 0: z-bit.  imm_flags bits 1-2: dist_class = 0b10 (Boolean).
    //   Formal guarantee: BooleanCLT.lean  `boolean_m4_minimal`
    //   Lowering: 2 VADDPD (identical arithmetic to IrFreeConvolve; dist_class differs)
    IrBooleanConvolve,  // Door Δ: K<a> ⊎ K<b>, dist_class=2, Bernoulli CLT, κ=1

    // IrMonotoneConvolve — Monotone ⊳ convolution (Muraki's most exotic type).
    //   Monotone independence is ORDER-DEPENDENT: X⊳Y ≠ Y⊳X at the moment level.
    //   CLT limit: arcsine distribution on [-2σ, 2σ].  κ = 3/2.
    //   Asymmetry: m₃(X⊳Y) depends on ordering (for non-centered distributions).
    //   For centered distributions: asymmetry first visible at m₅.
    //   Encoding: same as IrBooleanConvolve.
    //   imm_flags bit 3: swap flag (= 1 means b⊳a, operands already in correct order).
    //   imm_flags bits 1-2: dist_class = 0b11 (Monotone/arcsine).
    //   Formal guarantee: MonotoneCLT.lean  `monotone_clt_arcsine`
    //   Lowering: 2 VADDPD (centered case; asymmetry carried in dist_class annotation)
    IrMonotoneConvolve, // Door Δ: K<a> ⊳ K<b>, dist_class=3, arcsine CLT, κ=3/2

    // ─── Door Φ — Wasserstein Transport + Ollivier-Ricci Curvature ───────────
    // Sounio can model distributions (Knowledge<T>) but could not COMPARE them.
    // W₁ (Earth Mover's Distance) is the canonical metric on probability distributions.
    // ORC uses W₁ to measure graph curvature. No compiler has these as IR primitives.
    //
    // Connection to research: Paper 4 (Brain ORC + Associator Field, ABIDE-I) computes ORC
    // on connectomes. Making ORC an IR primitive means the compiler certifies ORC-based
    // claims about brain graph topology at compile time.
    //
    // IrWassersteinDist — W₁ distance between two Knowledge<f64> distributions.
    //   1D Gaussian approximation: W₁(N(μ_a,σ²_a), N(μ_b,σ²_b)) ≈ |μ_a-μ_b| + |σ_a-σ_b|
    //   GUM: Δ(W₁) ≤ ½(Δσ_a + Δσ_b) + Δ|μ_a-μ_b|
    //   Encoding: dst = val ZMM (W₁ value), dst+1 = eps ZMM (GUM bound)
    //             src1 = a_val ZMM, src1+1 = a_sgsq ZMM
    //             src2 = b_val ZMM, src2+1 = b_sgsq ZMM
    //   imm_flags bit 0: z-bit; bit 1: emit_eps (include GUM in output register)
    //   Lowering: VSUBPD + VANDPD (abs mean diff) + VSQRTPD×2 + VSUBPD + VANDPD (abs sig diff)
    //             + VADDPD (sum) + GUM VADDPD×scale; ~7 EVEX instructions
    //   Formal guarantee: WassersteinORC.lean  `wasserstein_triangle_inequality`
    IrWassersteinDist,  // Door Φ: W₁(K<a>, K<b>) → f64 + GUM eps

    // IrORC — Ollivier-Ricci curvature κ(x,y) = 1 - W₁(mₓ,mᵧ)/d(x,y).
    //   ORC > 0: positive curvature (well-connected region, fast mixing).
    //   ORC < 0: negative curvature (bottleneck, slow mixing, graph "neck").
    //   ORC = 0: flat (Euclidean-like).
    //   Encoding: same input layout as IrWassersteinDist.
    //             imm_i64 = d(x,y) as fixed-point integer (actual distance × 1000).
    //   Lowering: IrWassersteinDist sub-emission + VMULPD(1/d) + 1.0-broadcast + VSUBPD
    //   Formal guarantee: WassersteinORC.lean  `orc_positive_implies_mixing_bound`
    IrORC,              // Door Φ: κ(x,y) = 1 - W₁/d, wraps IrWassersteinDist

    // ─── Door Ξ — q-deformed Arithmetic / Quantum Groups ─────────────────────
    // Every prior algebra in Sounio is a SPECIFIC algebra at a fixed point.
    // U_q(G) is a FAMILY parameterized by q ∈ ℂ. At q=1: classical. At q=root of unity:
    // finite periodic representations (topological quantum field theory).
    //
    // Connection to E₈: E₈ at q = e^{2πi/30} corresponds to E₈ WZW CFT at level 1.
    // IrE8RootReflectO (Horizon 3.9) IS the q=1 Weyl reflection; at q≠1 it generates
    // the quantum Weyl group — connecting every prior Door to a unified framework.
    //
    // IrQDeform — q-deformed product: a ·_q b in an algebra with quantum group parameter q.
    //   a ·_q b = a·b + (q-1)·φ_q(a,b)   where φ_q(a,b) = (a·b - b·a)/2 for Lie deform.
    //   GUM: Δ(a·_q b) = Δ(a·b) + |q-1|·Δφ_q  (classical GUM + deformation correction)
    //   q encoding in imm_flags:
    //     bits  0-15: q_num   (int16 signed numerator)
    //     bits 16-31: q_den   (uint16 denominator, ≠ 0)
    //     → q_rational = q_num / q_den  (e.g., q=1: 1/1; q=1/2: 1/2; q=2: 2/1)
    //   Special values:
    //     q=1 (1/1): zero overhead — lowered to VMULPD only (no deformation)
    //     q=-1 (-1/1): anti-commutative product (Clifford regime)
    //   imm_i64 = algebra_tag (0=scalar, 1=octonion, 2=J3O, 8=E₈)
    //   Formal guarantee: QDeformClassical.lean  `q_deform_recovers_classical`
    //   Lowering at q=1: 1 VMULPD.  At q≠1: VMULPD + VSUBPD + scale + VFMADD231PD; ~4 EVEX
    IrQDeform,          // Door Ξ: a·_q b, q in imm_flags, unifies all prior Doors

    // SysV aggregate return (>16B) ABI.
    // IrCallSret injects the hidden destination pointer/handle in rdi and shifts
    // explicit integer args to rsi/rdx/rcx/r8/r9. IrReturnSret returns that handle.
    IrCallSret,
    IrReturnSret,
    IrWideAdd,
    IrWideSub,
    IrWideMul,
    IrWideShrLimb,
    IrWideDiv,
    IrWideMod,
    IrWideCmp,
    IrWideReject,
    IrWideShr,
    IrWideDivFull,
    IrWideModFull,
    // Global variable (BSS) load/store — absolute addressing at BSS_BASE + offset
    //   imm_i64 = BSS byte offset (from BSS_BASE)
    //   name    = global variable name (for debugging)
    IrLoadGlobal,
    IrStoreGlobal,
    // Store through a raw pointer: [src1] = src2  (used for `*p = val` on a true reference).
    IrStorePtr,
}

pub struct IrRegList {
    pub head: i64,
    pub tail: Option<Box<IrRegList>>,
}

pub struct IrInstr {
    pub op: IrOpcode,
    pub dst: i64,
    pub src1: i64,
    pub src2: i64,
    pub imm_i64: i64,
    pub imm_f64: f64,
    pub label_id: i64,
    pub fn_id: i64,
    pub field_idx: i64,
    pub imm_flags: i64,    // Bit 0: z (zeroing-mask, sets EVEX P3[7]). Future: SAE, broadcast.
    pub bin_op: BinaryOp,
    pub un_op: UnaryOp,
    // Interned: index into IR_NAME_POOL, 0 = unnamed. See ir_intern_name.
    pub name_id: i64,
    pub call_args: Option<Box<IrRegList>>,
    pub arg_count: i64,
}

// ============================================================================
// Compile strategy constants — type+effect-directed compilation mode
// ============================================================================
//
// Selected during AST→IR lowering based on the function's return type
// and effect signature.  Guides native codegen behaviour: aggressive
// paths for validated data, precision-preserving paths for uncertain
// data, dual-path instrumented codegen for contested/robust data.

let IR_STRATEGY_STANDARD: i64 = 0           // default — standard native compilation
let IR_STRATEGY_AGGRESSIVE: i64 = 1         // Validated<T> — full optimisation, SIMD, float reassoc
let IR_STRATEGY_PRECISION_PRESERVING: i64 = 2 // Knowledge<T> — no float reassociation, strict FP
let IR_STRATEGY_INSTRUMENTED: i64 = 3       // Contest<T>/Robust<T> — dual-path: fast + instrumented
let IR_STRATEGY_GPU_KERNEL: i64 = 4         // with GPU — GPU kernel extraction
let IR_STRATEGY_PROBABILISTIC: i64 = 5      // with Prob — trace-compatible for MCMC/VI
let IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC: i64 = 6 // with Chaotic — A-layer-2: e-graph refuses ALL float reassociation (e^{λt} amplification)
let IR_STRATEGY_EXTERN: i64 = 6             // extern "C" fn — no body, C ABI stub (Sprint 108)
let IR_STRATEGY_EXPORTED: i64 = 7           // export "C" fn — C ABI visibility (Sprint 109)

pub fn ir_strategy_name(s: i64) -> string {
    if s == IR_STRATEGY_STANDARD { "standard" }
    else if s == IR_STRATEGY_AGGRESSIVE { "aggressive" }
    else if s == IR_STRATEGY_PRECISION_PRESERVING { "precision_preserving" }
    else if s == IR_STRATEGY_INSTRUMENTED { "instrumented" }
    else if s == IR_STRATEGY_GPU_KERNEL { "gpu_kernel" }
    else if s == IR_STRATEGY_PROBABILISTIC { "probabilistic" }
    else if s == IR_STRATEGY_EXTERN { "extern" }
    else if s == IR_STRATEGY_EXPORTED { "exported" }
    else { "unknown" }
}

// ==========================================================================
// IR instruction arena (#1649)
// ==========================================================================
// Lives here rather than in its own module because IrFunction must hold a
// region handle and the arena must hold IrInstr, and Sounio has no import
// cycles anywhere in this tree -- an arena module importing ir::ir while
// ir::ir imports it back would be the first, and untested.
//
// Variable-size region allocator for IR instructions, with generation-checked
// handles and region sealing.
//
// WHY THIS EXISTS (#1649)
// ----------------------
// IrFunction currently embeds `instrs: [IrInstr; 4096]` inline, and IrModule
// embeds `functions: [IrFunction; 2048]`, so a module reserves ~2 GB whether it
// uses it or not, and no function may exceed 4096 IR instructions. Measured, a
// 136-line test needs 14389. The limit cannot be raised: a 4x bump takes RSS for
// a small compile from 753 MB to ~2-3 GB.
//
// Fixed-size regions would reproduce exactly that arithmetic, so regions here are
// VARIABLE size, sized to a function's actual instruction count.
//
// WHAT MAKES VARIABLE REGIONS DANGEROUS, AND WHAT THIS MODULE DOES ABOUT IT
// ------------------------------------------------------------------------
// Two hazards, both of which would otherwise produce SILENT cross-function
// miscompiles -- the exact defect class #1586/#1645/#1647 closed:
//
//   1. GROWTH. A function that outgrows its region must be reallocated and
//      copied, which moves its base. Any copy of that handle still holding the
//      old base would then read or write another function's instructions.
//      Handled by: every handle carries a GENERATION, bumped on reallocation.
//      A stale handle is detected on use rather than silently followed.
//
//   2. ALIASING. IrFunction is passed by value 163 times, returned 110 times and
//      explicitly copied 53 times across 34 files, and the optimizer depends on
//      those copies being deep:
//
//          var result = func                  // today: full deep copy
//          IR_INSTR_ARENA[(ir_region_base_write(&result.region) + (i)) as usize] = ir_copy(...)    // does not touch func
//          return (false, func)               // rollback returns the original
//
//      With a shared region a value copy aliases, so the write corrupts `func`
//      and the rollback returns corrupted data. Sounio has no copy constructor,
//      so the clone must be written by hand at each boundary -- and a missed one
//      compiles cleanly. Handled by: SEALING. A region is sealed when its
//      function is published (stored into a module, returned across a pass).
//      Writing through a sealed handle is refused, loudly.
//
// Neither check is advisory. A violation prints, sets the durable hard-error flag
// so the compile cannot exit 0 (the #1645 channel), and routes the write to a
// quarantine region so nothing else is corrupted in the meantime.
//
// This module is standalone: it owns no IrFunction and nothing imports it yet.
// Converting IrFunction.instrs to a region handle is a separate change (~4282
// access sites, all of them caught by the type checker once the field is gone).



// ---------------------------------------------------------------------------
// Capacity tiers
// ---------------------------------------------------------------------------
// Declarations must stay literals (Sounio array sizes are not expressions);
// every bound CHECK calls the accessor, the same contract as
// nc_flat_reloc_capacity() in self-hosted/native/frame.sio. Sized for this
// module's own witnesses; the conversion change sizes it from measurement.

// STRUCT-OF-ARRAYS storage (#1649, #1655).
//
// This cannot be `[IrInstr; N]`. Under the bootstrap seed -- which builds this
// compiler -- storing a STRUCT into a GLOBAL array is a silent no-op: lean_single
// represents a global aggregate array as pointer-per-slot, so the store writes the
// address of a temporary and the load returns that pointer as the first field.
// Measured, isolated, and kept as a reproduction in
// tests/known_failures/lean_single_global_aggregate_store.sio.
//
// Global arrays of SCALARS are fine, so every field gets its own. Measured under
// the seed: i64 OK, f64 OK, i8 OK, enum BROKEN, Option<Box<_>> segfaults --
// so enums are held as i64 (the `as i64` / `as IrOpcode` round-trip is exact),
// the Name goes to a byte pool, and call args go to a flat i64 pool.
//
// It is also much cheaper than the array it replaces: ~112 MB of scalars for a
// million instructions, against 2 GB of reserved [IrInstr; 4096] per module.
pub var IR_A_OP: [i64; 4194304] = [0; 4194304]
pub var IR_A_DST: [i64; 4194304] = [0; 4194304]
pub var IR_A_SRC1: [i64; 4194304] = [0; 4194304]
pub var IR_A_SRC2: [i64; 4194304] = [0; 4194304]
pub var IR_A_IMM_I64: [i64; 4194304] = [0; 4194304]
pub var IR_A_IMM_F64: [f64; 4194304] = [0.0; 4194304]
pub var IR_A_LABEL_ID: [i64; 4194304] = [0; 4194304]
pub var IR_A_FN_ID: [i64; 4194304] = [0; 4194304]
pub var IR_A_FIELD_IDX: [i64; 4194304] = [0; 4194304]
pub var IR_A_IMM_FLAGS: [i64; 4194304] = [0; 4194304]
pub var IR_A_BIN_OP: [i64; 4194304] = [0; 4194304]
pub var IR_A_UN_OP: [i64; 4194304] = [0; 4194304]
// #1695: the INTERNED id, carried rather than recomputed. ir_arena_load did
// `out.name_id = ir_intern_name(ir_arena_name(at))` -- interning on a READ path
// reached at ~431 sites. ir_intern_name caps at IR_NAME_POOL_MAX and RETURNS 0 on
// overflow, and 0 means "unnamed", so once the pool filled every load produced a
// nameless instruction.
pub var IR_A_NAME_ID: [i64; 4194304] = [0; 4194304]
pub var IR_A_ARG_COUNT: [i64; 4194304] = [0; 4194304]
pub var IR_A_NAME_OFF: [i64; 4194304] = [0; 4194304]
pub var IR_A_NAME_LEN: [i64; 4194304] = [0; 4194304]
pub var IR_A_ARG_BASE: [i64; 4194304] = [0; 4194304]

// Byte pool for instruction names, and a flat pool for call-argument registers.
pub var IR_NAME_POOL: [i8; 4194304] = [0; 4194304]
// RENAMED from IR_NAME_POOL_LEN. main declares `var IR_NAME_POOL_LEN:
// [i64; 65536]` for interned per-id lengths; this lane declared a SCALAR of
// the same name as the arena byte cursor. Two globals, one name, different
// types: ir_intern_name's `IR_NAME_POOL_LEN[(id-1)] = n.len` wrote through
// THIS cursor, so ir_arena_put_name then stored name bytes at a corrupted
// offset -- and IR_ARG_POOL sits just past IR_NAME_POOL, so call arguments
// were what got overwritten. Bisected to this on Slurm (20 jobs): every
// cross-module call of arity >= 5 miscompiled; replacing the intern calls
// with literal 0 fixed it, hoisting them out of the struct literal did not.
pub var IR_A_NAME_BYTES_USED: i64 = 0
pub fn ir_name_pool_capacity() -> i64 { 4194304 }

pub var IR_ARG_POOL: [i64; 262144] = [0; 262144]
pub var IR_ARG_POOL_LEN: i64 = 0
pub fn ir_arg_pool_capacity() -> i64 { 262144 }

// Copy one arena slot to another, field by field. Replaces what used to be a
// single aggregate array-element copy -- which the seed silently drops.
pub fn ir_arena_copy_slot(dst: i64, src: i64) with Mut, Panic, Div {
    if dst < 0 || dst >= ir_instr_arena_capacity() { return }
    if src < 0 || src >= ir_instr_arena_capacity() { return }
    IR_A_OP[dst as usize] = IR_A_OP[src as usize]
    IR_A_DST[dst as usize] = IR_A_DST[src as usize]
    IR_A_SRC1[dst as usize] = IR_A_SRC1[src as usize]
    IR_A_SRC2[dst as usize] = IR_A_SRC2[src as usize]
    IR_A_IMM_I64[dst as usize] = IR_A_IMM_I64[src as usize]
    IR_A_IMM_F64[dst as usize] = IR_A_IMM_F64[src as usize]
    IR_A_LABEL_ID[dst as usize] = IR_A_LABEL_ID[src as usize]
    IR_A_FN_ID[dst as usize] = IR_A_FN_ID[src as usize]
    IR_A_FIELD_IDX[dst as usize] = IR_A_FIELD_IDX[src as usize]
    IR_A_IMM_FLAGS[dst as usize] = IR_A_IMM_FLAGS[src as usize]
    IR_A_BIN_OP[dst as usize] = IR_A_BIN_OP[src as usize]
    IR_A_UN_OP[dst as usize] = IR_A_UN_OP[src as usize]
    IR_A_ARG_COUNT[dst as usize] = IR_A_ARG_COUNT[src as usize]
    IR_A_NAME_OFF[dst as usize] = IR_A_NAME_OFF[src as usize]
    IR_A_NAME_LEN[dst as usize] = IR_A_NAME_LEN[src as usize]
    IR_A_NAME_ID[dst as usize] = IR_A_NAME_ID[src as usize]
    IR_A_ARG_BASE[dst as usize] = IR_A_ARG_BASE[src as usize]
}

// Args move/clear, used by the peephole that shuffles instructions between slots.
pub fn ir_arena_move_args(dst: i64, src: i64) with Mut, Panic, Div {
    if dst < 0 || dst >= ir_instr_arena_capacity() { return }
    if src < 0 || src >= ir_instr_arena_capacity() { return }
    IR_A_ARG_BASE[dst as usize] = IR_A_ARG_BASE[src as usize]
    IR_A_ARG_COUNT[dst as usize] = IR_A_ARG_COUNT[src as usize]
    IR_A_ARG_COUNT[src as usize] = 0
}

pub fn ir_arena_clear_args(at: i64) with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    IR_A_ARG_COUNT[at as usize] = 0
    IR_A_ARG_BASE[at as usize] = 0
}

pub fn ir_reg_list_len(l: Option<Box<IrRegList>>) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var cur = l
    while true {
        match cur {
            Some(node) => { n = n + 1  cur = (*node).tail }
            _ => { break }
        }
    }
    n
}

// Copy just the argument binding. The pool is append-only within a compile, so
// two slots may share a range: nothing rewrites it under them.
pub fn ir_arena_copy_args(dst: i64, src: i64) with Mut, Panic, Div {
    if dst < 0 || dst >= ir_instr_arena_capacity() { return }
    if src < 0 || src >= ir_instr_arena_capacity() { return }
    IR_A_ARG_BASE[dst as usize] = IR_A_ARG_BASE[src as usize]
    IR_A_ARG_COUNT[dst as usize] = IR_A_ARG_COUNT[src as usize]
}

// Exchange two slots whole. A swap written as two stores cannot carry arguments
// correctly -- the first store overwrites the very slot the second must take its
// arguments from -- so the exchange has to be a single primitive.
pub fn ir_arena_swap_slots(a: i64, b: i64) with Mut, Panic, Div {
    if a == b { return }
    if a < 0 || a >= ir_instr_arena_capacity() { return }
    if b < 0 || b >= ir_instr_arena_capacity() { return }
    let t_op = IR_A_OP[a as usize]                IR_A_OP[a as usize] = IR_A_OP[b as usize]                IR_A_OP[b as usize] = t_op
    let t_dst = IR_A_DST[a as usize]              IR_A_DST[a as usize] = IR_A_DST[b as usize]              IR_A_DST[b as usize] = t_dst
    let t_s1 = IR_A_SRC1[a as usize]              IR_A_SRC1[a as usize] = IR_A_SRC1[b as usize]            IR_A_SRC1[b as usize] = t_s1
    let t_s2 = IR_A_SRC2[a as usize]              IR_A_SRC2[a as usize] = IR_A_SRC2[b as usize]            IR_A_SRC2[b as usize] = t_s2
    let t_ii = IR_A_IMM_I64[a as usize]           IR_A_IMM_I64[a as usize] = IR_A_IMM_I64[b as usize]      IR_A_IMM_I64[b as usize] = t_ii
    let t_if = IR_A_IMM_F64[a as usize]           IR_A_IMM_F64[a as usize] = IR_A_IMM_F64[b as usize]      IR_A_IMM_F64[b as usize] = t_if
    let t_lb = IR_A_LABEL_ID[a as usize]          IR_A_LABEL_ID[a as usize] = IR_A_LABEL_ID[b as usize]    IR_A_LABEL_ID[b as usize] = t_lb
    let t_fn = IR_A_FN_ID[a as usize]             IR_A_FN_ID[a as usize] = IR_A_FN_ID[b as usize]          IR_A_FN_ID[b as usize] = t_fn
    let t_fi = IR_A_FIELD_IDX[a as usize]         IR_A_FIELD_IDX[a as usize] = IR_A_FIELD_IDX[b as usize]  IR_A_FIELD_IDX[b as usize] = t_fi
    let t_fl = IR_A_IMM_FLAGS[a as usize]         IR_A_IMM_FLAGS[a as usize] = IR_A_IMM_FLAGS[b as usize]  IR_A_IMM_FLAGS[b as usize] = t_fl
    let t_bo = IR_A_BIN_OP[a as usize]            IR_A_BIN_OP[a as usize] = IR_A_BIN_OP[b as usize]        IR_A_BIN_OP[b as usize] = t_bo
    let t_uo = IR_A_UN_OP[a as usize]             IR_A_UN_OP[a as usize] = IR_A_UN_OP[b as usize]          IR_A_UN_OP[b as usize] = t_uo
    let t_no = IR_A_NAME_OFF[a as usize]          IR_A_NAME_OFF[a as usize] = IR_A_NAME_OFF[b as usize]    IR_A_NAME_OFF[b as usize] = t_no
    let t_nl = IR_A_NAME_LEN[a as usize]          IR_A_NAME_LEN[a as usize] = IR_A_NAME_LEN[b as usize]    IR_A_NAME_LEN[b as usize] = t_nl
    let t_ni = IR_A_NAME_ID[a as usize]           IR_A_NAME_ID[a as usize] = IR_A_NAME_ID[b as usize]     IR_A_NAME_ID[b as usize] = t_ni
    let t_ab = IR_A_ARG_BASE[a as usize]          IR_A_ARG_BASE[a as usize] = IR_A_ARG_BASE[b as usize]    IR_A_ARG_BASE[b as usize] = t_ab
    let t_ac = IR_A_ARG_COUNT[a as usize]         IR_A_ARG_COUNT[a as usize] = IR_A_ARG_COUNT[b as usize]  IR_A_ARG_COUNT[b as usize] = t_ac
}

// Everything except the name and the call arguments.
fn ir_arena_store_scalars(at: i64, instr: IrInstr) with Mut, Panic, Div {
    IR_A_NAME_ID[at as usize] = instr.name_id
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    IR_A_OP[at as usize] = instr.op as i64
    IR_A_DST[at as usize] = instr.dst
    IR_A_SRC1[at as usize] = instr.src1
    IR_A_SRC2[at as usize] = instr.src2
    IR_A_IMM_I64[at as usize] = instr.imm_i64
    IR_A_IMM_F64[at as usize] = instr.imm_f64
    IR_A_LABEL_ID[at as usize] = instr.label_id
    IR_A_FN_ID[at as usize] = instr.fn_id
    IR_A_FIELD_IDX[at as usize] = instr.field_idx
    IR_A_IMM_FLAGS[at as usize] = instr.imm_flags
    IR_A_BIN_OP[at as usize] = instr.bin_op as i64
    IR_A_UN_OP[at as usize] = instr.un_op as i64
}

// Whole-instruction store. Flattens the Name into the byte pool and the call-arg
// list into the register pool; both are append-only within a compile.
pub fn ir_arena_store(at: i64, instr: IrInstr) with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    ir_arena_store_scalars(at, instr)
    // main interned IrInstr.name -> name_id; the arena stores bytes.
    ir_arena_put_name(at, ir_name_at(instr.name_id))
    ir_arena_store_args(at, instr.call_args, instr.arg_count)
}

// Store an instruction whose argument list did not survive ir_arena_load, taking
// the arguments from the slot it was loaded FROM. This is the honest form for
// the shuffles that move an instruction between slots.
pub fn ir_arena_store_from(at: i64, instr: IrInstr, args_from: i64) with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    ir_arena_store_scalars(at, instr)
    // main interned IrInstr.name -> name_id; the arena stores bytes.
    ir_arena_put_name(at, ir_name_at(instr.name_id))
    ir_arena_copy_args(at, args_from)
}

// ir_arena_load deliberately does NOT rebuild the argument list -- doing so needs
// Alloc, and forcing Alloc onto ~431 call sites is what desynchronised the
// checker into six figures of nonsense diagnostics. So a stored instruction may
// legitimately arrive with arg_count > 0 and no list, and the old code walked
// that empty list and wrote IR_INVALID_REG once per argument. That is the whole
// rc=12: every call WITH arguments lost them, so codegen reported the function
// unsupported. A call with no arguments was unaffected, which is why
// single-function programs compiled and anything calling a helper did not.
fn ir_arena_store_args(at: i64, args: Option<Box<IrRegList>>, count: i64) with Mut, Panic, Div {
    if count <= 0 {
        IR_A_ARG_COUNT[at as usize] = 0
        IR_A_ARG_BASE[at as usize] = 0
        return
    }
    if ir_reg_list_len(args) > 0 {
        IR_A_ARG_COUNT[at as usize] = count
        ir_arena_put_args(at, args, count)
        return
    }
    // No list and a positive count. Sound ONLY when the destination already
    // holds exactly these arguments -- a read-modify-write on the same slot.
    // Anything else would hand the call another instruction's registers, so
    // fail loud rather than preserve: a silently wrong call is the failure this
    // arena exists to make impossible. Use ir_arena_store_from for real moves.
    if IR_A_ARG_COUNT[at as usize] == count && IR_A_ARG_BASE[at as usize] > 0 { return }
    ir_arena_latch(IR_ARENA_VIOLATION_INVALID, ir_region_invalid())
    IR_A_ARG_COUNT[at as usize] = 0
}

pub fn ir_arena_put_name(at: i64, nm: Name) with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    var len = nm.len
    if len < 0 { len = 0 }
    if len > 128 { len = 128 }
    // Re-storing an instruction used to re-append its name, so pool consumption
    // tracked STORES rather than instructions and a dozen cleanup peels
    // multiplied it. If this slot already holds exactly this name, keep the
    // binding: that turns the common read-modify-write into free.
    if IR_A_NAME_LEN[at as usize] == len {
        let prev = IR_A_NAME_OFF[at as usize]
        var same = true
        var k: i64 = 0
        while k < len {
            if IR_NAME_POOL[(prev + k) as usize] != nm.buf[k as usize] {
                same = false
                k = len
            }
            k = k + 1
        }
        if same { return }
    }
    if IR_A_NAME_BYTES_USED + len > ir_name_pool_capacity() {
        // Was: drop the name and carry on. Names are load-bearing -- cleanup
        // matches on ir_name_eq and codegen resolves callees by name -- so a
        // dropped name is a silently different program. Same defect as the rc=12
        // argument loss, with the alarm removed. Poison the compile instead; the
        // driver refuses to emit on a latched violation.
        IR_A_NAME_LEN[at as usize] = 0
        ir_arena_latch(IR_ARENA_VIOLATION_NAME_POOL, ir_region_invalid())
        return
    }
    let off = IR_A_NAME_BYTES_USED
    var i: i64 = 0
    while i < len {
        IR_NAME_POOL[(off + i) as usize] = nm.buf[i as usize]
        i = i + 1
    }
    IR_A_NAME_BYTES_USED = off + len
    IR_A_NAME_OFF[at as usize] = off
    IR_A_NAME_LEN[at as usize] = len
}

pub fn ir_arena_name(at: i64) -> Name with Mut, Panic, Div {
    var nm = ir_empty_name()
    if at < 0 || at >= ir_instr_arena_capacity() { return nm }
    let off = IR_A_NAME_OFF[at as usize]
    let len = IR_A_NAME_LEN[at as usize]
    if len <= 0 { return nm }
    var i: i64 = 0
    while i < len {
        nm.buf[i as usize] = IR_NAME_POOL[(off + i) as usize]
        i = i + 1
    }
    nm.len = len
    nm
}

pub fn ir_arena_put_args(at: i64, args: Option<Box<IrRegList>>, count: i64) with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return }
    if count <= 0 { IR_A_ARG_BASE[at as usize] = 0  return }
    if IR_ARG_POOL_LEN + count > ir_arg_pool_capacity() {
        // Was: drop the arguments and carry on -- which is exactly the rc=12
        // failure this arena already paid for once, except silent. A call that
        // loses its arguments is a different program, not a slower one.
        IR_A_ARG_COUNT[at as usize] = 0
        ir_arena_latch(IR_ARENA_VIOLATION_ARG_POOL, ir_region_invalid())
        return
    }
    let base = IR_ARG_POOL_LEN
    var cur = args
    var k: i64 = 0
    while k < count {
        match cur {
            Some(node) => {
                IR_ARG_POOL[(base + k) as usize] = (*node).head
                cur = (*node).tail
            }
            _ => { IR_ARG_POOL[(base + k) as usize] = IR_INVALID_REG }
        }
        k = k + 1
    }
    IR_ARG_POOL_LEN = base + count
    IR_A_ARG_BASE[at as usize] = base
}

// The k-th call argument register, straight out of the flat pool. This is what
// the arena-resident call sites use instead of walking a Box'd list.
pub fn ir_arena_arg_at(at: i64, k: i64) -> i64 with Mut, Panic, Div {
    if at < 0 || at >= ir_instr_arena_capacity() { return IR_INVALID_REG }
    if k < 0 || k >= IR_A_ARG_COUNT[at as usize] { return IR_INVALID_REG }
    IR_ARG_POOL[(IR_A_ARG_BASE[at as usize] + k) as usize]
}

// Whole-instruction load. The arg list is rebuilt only when there are arguments,
// so the common no-arg instruction costs no allocation.
// NO Alloc effect, deliberately. This is called at ~431 sites; requiring Alloc
// forced the effect onto every caller and cascaded (the first such error
// desynchronised the checker into 334k nonsense diagnostics). The call-argument
// list is therefore NOT rebuilt here -- every arena-resident argument access goes
// through ir_arena_arg_at and the flat pool instead.
pub fn ir_arena_load(at: i64) -> IrInstr with Mut, Panic, Div {
    var out = ir_nop()
    if at < 0 || at >= ir_instr_arena_capacity() { return out }
    out.op = IR_A_OP[at as usize] as IrOpcode
    out.dst = IR_A_DST[at as usize]
    out.src1 = IR_A_SRC1[at as usize]
    out.src2 = IR_A_SRC2[at as usize]
    out.imm_i64 = IR_A_IMM_I64[at as usize]
    out.imm_f64 = IR_A_IMM_F64[at as usize]
    out.label_id = IR_A_LABEL_ID[at as usize]
    out.fn_id = IR_A_FN_ID[at as usize]
    out.field_idx = IR_A_FIELD_IDX[at as usize]
    out.imm_flags = IR_A_IMM_FLAGS[at as usize]
    out.bin_op = IR_A_BIN_OP[at as usize] as BinaryOp
    out.un_op = IR_A_UN_OP[at as usize] as UnaryOp
    out.arg_count = IR_A_ARG_COUNT[at as usize]
    // Carried, NOT re-derived: interning on this read path broke arity >= 5.
    out.name_id = IR_A_NAME_ID[at as usize]
    out
}
pub fn ir_instr_arena_capacity() -> i64 { 4194304 }

pub var IR_REGION_BASE: [i64; 16640] = [0; 16640]
pub var IR_REGION_CAP: [i64; 16640] = [0; 16640]
pub var IR_REGION_LEN: [i64; 16640] = [0; 16640]
pub var IR_REGION_GEN: [i64; 16640] = [0; 16640]
pub var IR_REGION_STATE: [i64; 16640] = [0; 16640]
// MUST EXCEED IR_MAX_FUNCS; both were 8192. Slot 0 is the quarantine and
// module_frontend_loaded_ir_slot_limit reserves one transient slot, leaving 8190
// regions for 8191 permitted functions -- so the top of the range got no region,
// lowering returned ir_region_invalid() and the contract check refused.
// Bisected: 8189 live slots compile, 8190 and 8191 do not.
pub fn ir_region_table_capacity() -> i64 { 16640 }

// ============================================================================
// IrCapacities: ONE object for all coupled capacity constants.
// ============================================================================
//
// SEMANTIC DECLARATION (before code, per FOUNDER_INTENT):
//
// A capacity ceiling that silently drops is a lie. The Sounio compiler exists
// to make such lies impossible. Every capacity in this object is coupled to at
// least one other by a hard invariant; violating the coupling produces either
// a silent miscompile (truncated liveness deleting live code) or a silent drop
// (function symbols and offsets vanishing past the literal, exit 0, no error).
// Both are exactly what this language was built to prevent.
//
// INVARIANTS enforced by ir_capacities_validate:
//   1. region_slots > max_functions
//      The region table MUST have more slots than the maximum function count.
//      Slot 0 is quarantine; module_frontend_loaded_ir_slot_limit reserves one
//      transient slot. If region_slots <= max_functions, the top functions get
//      no region, lowering returns ir_region_invalid(), and the contract check
//      refuses. Bisected 2026-08: 8189 live slots compile, 8190 and 8191 do not.
//
//   2. dce_liveness_slots > 0
//      NOT `dce_liveness_slots >= max_instructions`. Production keeps
//      dce_liveness_slots=8192 and max_instructions=IR_MAX_INSTRS=16384.
//      Main chose that on purpose in 042c29be53: dce_run_impl REFUSES any
//      function above DCE_MAX_INSTRS rather than raising the ceiling. A
//      truncated liveness analysis is a WRONG analysis, not a weaker one.
//      Converting that refuse into a panic on every compile would contradict
//      the measured choice. The IR_MAX_INSTRS / DCE_MAX_INSTRS coupling is a
//      POLICY invariant pinned by
//      scripts/ci/irfunction_instr_capacity_coherence_gate.sh (the pass must
//      refuse, not truncate). The runtime object only requires DCE to have
//      nonzero capacity. Refusal is detectable via DCE_REFUSAL_COUNT.
//
//   3. backend_offset_slots >= max_functions
//      The backend fn_offsets arrays are indexed by the IrModule.functions slot.
//      If they are smaller than max_functions, functions past the offset array
//      get no symbol and no offset — dropped silently.
//
// The object does NOT yet move arrays to dynamic allocation. That is the next
// turn and changes IrModule entirely. This turn: the object, the invariants,
// and the constructor that refuses to construct a violating configuration.

pub struct IrCapacities {
    max_functions: i64,
    region_slots: i64,
    max_instructions: i64,
    dce_liveness_slots: i64,
    backend_offset_slots: i64,
}

// The current production configuration. All values match the existing
// constants; the object makes the coupling explicit and checkable.
pub fn ir_capacities_default() -> IrCapacities {
    IrCapacities {
        max_functions: IR_MAX_FUNCS,
        region_slots: 16640,
        max_instructions: IR_MAX_INSTRS,
        dce_liveness_slots: 8192,
        backend_offset_slots: IR_MAX_FUNCS,
    }
}

// Validate the invariant coupling. Panics on violation — a capacity object
// that can be constructed in a violating state is no object at all.
pub fn ir_capacities_validate(cap: &IrCapacities) with Panic {
    // Invariant 1: region_slots > max_functions
    if (*cap).region_slots <= (*cap).max_functions {
        panic("IrCapacities: region_slots must exceed max_functions")
    }
    // Invariant 2: dce_liveness_slots > 0.
    // The production config has dce_liveness_slots=8192 < max_instructions=16384.
    // That is SAFE and DELIBERATE: dce_run_impl (dce.sio:818-821, since 042c29be53)
    // REFUSES functions above DCE_MAX_INSTRS and returns empty stats — main chose
    // "refuse the function" over "raise the ceiling". A truncated liveness analysis
    // is a wrong analysis, not a weaker one. The refusal is now DETECTABLE via
    // DCE_REFUSAL_COUNT (dce.sio), so the driver can observe that DCE declined.
    // The coupling "IR_MAX_INSTRS cannot rise without DCE_MAX_INSTRS" is a POLICY
    // invariant enforced by irfunction_instr_capacity_coherence_gate.sh, not a
    // runtime panic here. The runtime invariant is simply: DCE must have nonzero
    // capacity.
    if (*cap).dce_liveness_slots <= 0 {
        panic("IrCapacities: dce_liveness_slots must be > 0 (DCE must have capacity to function)")
    }
    // Invariant 3: backend_offset_slots >= max_functions
    if (*cap).backend_offset_slots < (*cap).max_functions {
        panic("IrCapacities: backend_offset_slots must be >= max_functions")
    }
}

// Self-test: the default configuration must pass validation and match the
// live constants. Wired into test_ir.sio's runner.
pub fn ir_capacities_self_test() -> bool with Panic {
    let cap = ir_capacities_default()
    // If this panics, the default configuration is broken and the test fails loudly.
    ir_capacities_validate(&cap)
    if cap.max_functions != IR_MAX_FUNCS { return false }
    if cap.region_slots != 16640 { return false }
    if cap.max_instructions != IR_MAX_INSTRS { return false }
    if cap.dce_liveness_slots != 8192 { return false }
    if cap.backend_offset_slots != IR_MAX_FUNCS { return false }
    true
}

pub var IR_ARENA_TOP: i64 = 0
pub var IR_REGION_COUNT: i64 = 0

// Every out-of-contract write lands here instead of in someone else's region.
// Allocated by init as region slot 0 so a zeroed handle cannot address real data.
pub var IR_QUARANTINE_BASE: i64 = 0
pub fn ir_quarantine_slots() -> i64 { 256 }

// Set when any handle contract is violated. Read by the compile driver, which
// must refuse to emit -- same role as IR_LOWER_HARD_ERROR for the lowering walls.
pub var IR_ARENA_VIOLATION: i64 = 0

pub let IR_REGION_FREE: i64 = 0
pub let IR_REGION_LIVE: i64 = 1
pub let IR_REGION_SEALED: i64 = 2

pub let IR_ARENA_OK: i64 = 0
pub let IR_ARENA_ERR_CAPACITY: i64 = -1        // arena is full
pub let IR_ARENA_ERR_REGIONS: i64 = -2         // region table is full
pub let IR_ARENA_ERR_STALE: i64 = -3           // generation mismatch (post-realloc)
pub let IR_ARENA_ERR_INVALID: i64 = -4         // slot out of range / freed
pub let IR_ARENA_ERR_SEALED: i64 = -5          // write through a published handle
pub let IR_ARENA_ERR_RANGE: i64 = -6           // index outside the region
pub let IR_ARENA_ERR_NEGATIVE: i64 = -7        // negative size asked for

// A handle. Carrying the generation is what makes a post-reallocation stale copy
// detectable instead of silently pointing at whatever now occupies the old base.
pub struct IrInstrRegion {
    pub slot: i64,
    pub generation: i64,
}

pub fn ir_region_invalid() -> IrInstrRegion {
    IrInstrRegion { slot: -1, generation: -1 }
}

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

pub fn ir_instr_arena_init() -> i64 with Mut, Panic, Div {
    // WS-D: the capacity object's invariants are checked here, where every
    // compile path arms the arena. A violating configuration panics loudly
    // instead of arming a ceiling that will silently drop past it.
    let ir_cap_check = ir_capacities_default()
    ir_capacities_validate(&ir_cap_check)
    var i: i64 = 0
    while i < ir_region_table_capacity() {
        IR_REGION_BASE[i as usize] = 0
        IR_REGION_CAP[i as usize] = 0
        IR_REGION_LEN[i as usize] = 0
        IR_REGION_STATE[i as usize] = IR_REGION_FREE
        // Generations deliberately NOT reset: a handle held across an init must
        // not start matching again. They only ever increase.
        i = i + 1
    }
    IR_ARENA_TOP = 0
    IR_REGION_COUNT = 0
    IR_ARENA_VIOLATION = 0
    // Slot 0 is the quarantine, so a zero-initialised handle addresses scratch.
    IR_QUARANTINE_BASE = 0
    IR_REGION_BASE[0] = 0
    IR_REGION_CAP[0] = ir_quarantine_slots()
    IR_REGION_LEN[0] = 0
    IR_REGION_GEN[0] = IR_REGION_GEN[0] + 1
    IR_REGION_STATE[0] = IR_REGION_LIVE
    IR_ARENA_TOP = ir_quarantine_slots()
    IR_REGION_COUNT = 1
    IR_ARENA_OK
}

pub fn ir_instr_arena_violation() -> bool { IR_ARENA_VIOLATION != 0 }

pub fn ir_instr_arena_used() -> i64 { IR_ARENA_TOP }

pub fn ir_instr_arena_region_count() -> i64 { IR_REGION_COUNT }

// ---------------------------------------------------------------------------
// Allocation
// ---------------------------------------------------------------------------

pub fn ir_instr_arena_alloc(cap: i64, out: &! IrInstrRegion) -> i64 with Mut, Panic, Div {
    if cap < 0 { return IR_ARENA_ERR_NEGATIVE }
    // Self-arming. The driver calls ir_instr_arena_init() per compile, but the
    // compiler has several entry paths and one of them reaches lowering without
    // passing through that barrier -- relying on the driver alone left the
    // quarantine region unreserved. Init is idempotent-by-count here.
    if IR_REGION_COUNT == 0 { ir_instr_arena_init() }
    if IR_REGION_COUNT >= ir_region_table_capacity() { return IR_ARENA_ERR_REGIONS }
    if IR_ARENA_TOP + cap > ir_instr_arena_capacity() { return IR_ARENA_ERR_CAPACITY }
    let slot = IR_REGION_COUNT
    IR_REGION_BASE[slot as usize] = IR_ARENA_TOP
    IR_REGION_CAP[slot as usize] = cap
    IR_REGION_LEN[slot as usize] = 0
    IR_REGION_GEN[slot as usize] = IR_REGION_GEN[slot as usize] + 1
    IR_REGION_STATE[slot as usize] = IR_REGION_LIVE
    IR_ARENA_TOP = IR_ARENA_TOP + cap
    IR_REGION_COUNT = slot + 1
    (*out).slot = slot
    (*out).generation = IR_REGION_GEN[slot as usize]
    IR_ARENA_OK
}

// ---------------------------------------------------------------------------
// Handle validation
// ---------------------------------------------------------------------------

pub fn ir_region_status(r: &IrInstrRegion) -> i64 with Panic, Div { ir_region_status_v(*r) }

pub fn ir_region_status_v(r: IrInstrRegion) -> i64 with Panic, Div {
    let s = r.slot
    if s < 0 || s >= IR_REGION_COUNT { return IR_ARENA_ERR_INVALID }
    if IR_REGION_STATE[s as usize] == IR_REGION_FREE { return IR_ARENA_ERR_INVALID }
    if IR_REGION_GEN[s as usize] != r.generation { return IR_ARENA_ERR_STALE }
    IR_ARENA_OK
}

pub fn ir_region_is_valid(r: &IrInstrRegion) -> bool with Panic, Div {
    ir_region_status(r) == IR_ARENA_OK
}

pub fn ir_region_is_sealed(r: &IrInstrRegion) -> bool with Panic, Div {
    let s = (*r).slot
    if s < 0 || s >= IR_REGION_COUNT { return false }
    IR_REGION_STATE[s as usize] == IR_REGION_SEALED
}

pub fn ir_region_len(r: &IrInstrRegion) -> i64 with Panic, Div {
    if ir_region_status(r) != IR_ARENA_OK { return 0 }
    IR_REGION_LEN[(*r).slot as usize]
}

pub fn ir_region_cap(r: &IrInstrRegion) -> i64 with Panic, Div {
    if ir_region_status(r) != IR_ARENA_OK { return 0 }
    IR_REGION_CAP[(*r).slot as usize]
}

// ---------------------------------------------------------------------------
// Raw base accessors -- the hot path for the eventual textual rewrite of
// `IR_INSTR_ARENA[(ir_region_base_read(&f.region) + (i)) as usize]` into `IR_INSTR_ARENA[(ir_region_base_read(&f.region) + i) as usize]`.
//
// Two of them on purpose. A single accessor could not tell a read from a write,
// and sealing only means anything if writes are the ones refused. The rewrite
// picks by the shape of the site: assignments, nested field assignments and `&!`
// take the _write form, everything else takes _read.
//
// Both are total: on violation they report once, raise IR_ARENA_VIOLATION so the
// compile cannot succeed, and return the quarantine base so the access is
// memory-safe rather than landing in another function's instructions.
// ---------------------------------------------------------------------------

// Latch only -- deliberately NO IO effect. These accessors are inserted at ~4282
// call sites by the IrFunction.instrs conversion; giving them IO would force the
// effect onto every containing function and cascade across the whole backend.
// The violation is reported by ir_arena_report_violation(), called from the
// compile driver's barrier where IO already exists.
pub var IR_ARENA_VIOLATION_KIND: i64 = 0
pub var IR_ARENA_VIOLATION_SLOT: i64 = -1
pub var IR_ARENA_VIOLATION_GEN: i64 = -1

pub let IR_ARENA_VIOLATION_STALE: i64 = 1
pub let IR_ARENA_VIOLATION_INVALID: i64 = 2
pub let IR_ARENA_VIOLATION_SEALED: i64 = 3
// Exhaustion, not a handle-contract breach: the side pools ran out. Distinct
// kinds because the remedy is different -- these say "raise the pool" or "stop
// re-appending", never "you aliased a region".
pub let IR_ARENA_VIOLATION_NAME_POOL: i64 = 4
pub let IR_ARENA_VIOLATION_ARG_POOL: i64 = 5
// #1669: a float fact the backend cannot represent. Today every consumer caps at
// 2048 vregs and SILENTLY drops the typing above it, which is the same silent
// miscompile-in-waiting; this makes it a refusal.
pub let IR_ARENA_VIOLATION_FLOAT_SET: i64 = 6
pub let IR_ARENA_VIOLATION_FN_TABLE_INDEX: i64 = 7
pub let IR_ARENA_VIOLATION_FN_TABLE_ALLOC: i64 = 8
// Exhaustion of the INSTRUCTION arena itself. It had no kind of its own, so
// ir_region_grow_slot returning IR_ARENA_ERR_CAPACITY was latched as
// IR_ARENA_VIOLATION_INVALID and printed as "invalid handle" -- a message that
// sends the reader after an aliasing bug that is not there. The remedy differs
// too: "raise the arena or stop growing", never "you published a stale handle".
// Same reasoning the NAME_POOL and ARG_POOL kinds were split out for.
pub let IR_ARENA_VIOLATION_INSTR_POOL: i64 = 9
// Set alongside the latch so the report can name the SHORTFALL, not just the
// fill: at the moment of refusal the arena is by definition ~full, and the
// number a reader needs is how much more was being asked for.
pub var IR_ARENA_VIOLATION_WANT: i64 = -1

fn ir_arena_latch(kind: i64, r: IrInstrRegion) with Mut, Panic, Div {
    if IR_ARENA_VIOLATION == 0 {
        IR_ARENA_VIOLATION_KIND = kind
        IR_ARENA_VIOLATION_SLOT = r.slot
        IR_ARENA_VIOLATION_GEN = r.generation
    }
    IR_ARENA_VIOLATION = 1
}

// Prints the FIRST violation. Returns true when there was one, so the driver can
// refuse to emit -- an arena contract breach means some function's instructions
// were written through a stale or published handle, which is a miscompile.
// Live capacity: what the regions actually hold. IR_ARENA_TOP minus this is the
// space stranded by growth -- ir_region_grow_slot copies a region to a fresh base
// and never reclaims the old range.
pub fn ir_arena_live_capacity() -> i64 with Mut, Panic, Div {
    var live: i64 = 0
    var ri: i64 = 0
    while ri < IR_REGION_COUNT {
        if IR_REGION_STATE[ri as usize] != IR_REGION_FREE {
            live = live + IR_REGION_CAP[ri as usize]
        }
        ri = ri + 1
    }
    live
}

// Arena usage WITHOUT a violation. The exhaustion report only fires when the
// arena runs out, so an arena large enough to finish the compile answers nothing
// about how much it actually needed -- which is the one number required to size
// it. Measured 2026-08-30: at 1048576 and at 2097152 the compile exhausts; the
// demand is above both and this is how to read it.
pub fn ir_arena_report_usage() with IO, Mut, Panic, Div {
    let live = ir_arena_live_capacity()
    print("arena_usage: fill ")
    print_int(IR_ARENA_TOP)
    print(" of ")
    print_int(ir_instr_arena_capacity())
    print(", regions ")
    print_int(IR_REGION_COUNT)
    print(", live ")
    print_int(live)
    print(", abandoned ")
    print_int(IR_ARENA_TOP - live)
    print("\n")
}

pub fn ir_arena_report_violation() -> bool with IO, Mut, Panic, Div {
    if IR_ARENA_VIOLATION == 0 { return false }
    print("error: IR instruction arena contract violated (")
    if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_STALE {
        print("stale handle -- a region was reallocated and this copy was not updated")
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_SEALED {
        print("write through a sealed handle -- a value copy was made without cloning the region")
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_NAME_POOL {
        print("name pool exhausted -- an instruction name was dropped, which changes call resolution")
        print(") fill ")
        print_int(IR_A_NAME_BYTES_USED)
        print(" of ")
        print_int(ir_name_pool_capacity())
        print("\n")
        return true
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_FLOAT_SET {
        print("a vreg above the float-typing capacity was marked as f64 -- the backend cannot represent it")
        print(") capacity ")
        print_int(ir_float_bits_capacity())
        print("\n")
        return true
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_INSTR_POOL {
        print("instruction arena exhausted -- a function could not be given room for its body")
        print(") fill ")
        print_int(IR_ARENA_TOP)
        print(" of ")
        print_int(ir_instr_arena_capacity())
        print(", wanted ")
        print_int(IR_ARENA_VIOLATION_WANT)
        print(" more\n")
        // LIVE vs ABANDONED, because "full" does not say which fix is the right
        // one. ir_region_grow_slot copies a region to a fresh base at the top and
        // never reclaims the old range, so a region that walked 16->32->64 leaves
        // every earlier copy stranded in the middle of the bump arena. If most of
        // the fill is abandoned, raising the capacity buys one more compile and
        // the ceiling comes back; if most of it is live, the arena is simply too
        // small. Printed rather than inferred.
        let live = ir_arena_live_capacity()
        print("       regions ")
        print_int(IR_REGION_COUNT)
        print(", live capacity ")
        print_int(live)
        print(", abandoned by growth ")
        print_int(IR_ARENA_TOP - live)
        print("\n")
        // WHICH region ran away. Doubling the arena from 1048576 to 2097152 moved
        // the fill to 2097142 and the shortfall stayed at 4: consumption tracked
        // capacity exactly, which is the signature of something growing until the
        // space is gone rather than of a table that is merely too small. A single
        // region doubling without bound would do that, and the top offenders name
        // it -- the slot is the function's region slot, allocated in function
        // order.
        var top1: i64 = -1
        var top2: i64 = -1
        var top3: i64 = -1
        var c1: i64 = 0
        var c2: i64 = 0
        var c3: i64 = 0
        var rj: i64 = 0
        while rj < IR_REGION_COUNT {
            if IR_REGION_STATE[rj as usize] != IR_REGION_FREE {
                let cj = IR_REGION_CAP[rj as usize]
                if cj > c1 {
                    c3 = c2
                    top3 = top2
                    c2 = c1
                    top2 = top1
                    c1 = cj
                    top1 = rj
                } else if cj > c2 {
                    c3 = c2
                    top3 = top2
                    c2 = cj
                    top2 = rj
                } else if cj > c3 {
                    c3 = cj
                    top3 = rj
                }
            }
            rj = rj + 1
        }
        print("       largest regions: slot ")
        print_int(top1)
        print(" cap ")
        print_int(c1)
        print(", slot ")
        print_int(top2)
        print(" cap ")
        print_int(c2)
        print(", slot ")
        print_int(top3)
        print(" cap ")
        print_int(c3)
        print("\n")
        return true
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_ARG_POOL {
        print("call-argument pool exhausted -- a call lost its arguments")
        print(") fill ")
        print_int(IR_ARG_POOL_LEN)
        print(" of ")
        print_int(ir_arg_pool_capacity())
        print("\n")
        return true
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_FN_TABLE_INDEX {
        print("IR module function table index is out of range -- refusing to read or write an empty function")
        print(") index ")
        print_int(IR_ARENA_VIOLATION_SLOT)
        print(" limit ")
        print_int(IR_MAX_FUNCS)
        print("\n")
        return true
    } else if IR_ARENA_VIOLATION_KIND == IR_ARENA_VIOLATION_FN_TABLE_ALLOC {
        print("IR module function table allocation failed -- refusing to drop a function write")
        print(") chunk ")
        print_int(IR_ARENA_VIOLATION_SLOT)
        print("\n")
        return true
    } else {
        print("invalid handle")
    }
    print(") on region slot ")
    print_int(IR_ARENA_VIOLATION_SLOT)
    print(" generation ")
    print_int(IR_ARENA_VIOLATION_GEN)
    print("\n")
    true
}

// Slot accessors -- what every converted instruction access actually calls.
//
// The WRITE form takes a mutable handle and the index so it can ENSURE the
// region exists and is large enough: that is what finally lets a function grow
// past the old 4096 wall. The READ form cannot allocate and must not -- reading
// past a function's instructions is a bug, not a request for space.
//
// Both are total. On a contract violation they latch (ir_arena_latch) and return
// a quarantine slot, so the access stays memory-safe and the compile is
// guaranteed to fail rather than emit code built on corrupted IR.
pub fn ir_region_slot_r(r: IrInstrRegion, idx: i64) -> i64 with Mut, Panic, Div {
    if idx < 0 { return IR_QUARANTINE_BASE }
    let st = ir_region_status_v(r)
    if st != IR_ARENA_OK {
        var kind = IR_ARENA_VIOLATION_INVALID
        if st == IR_ARENA_ERR_STALE { kind = IR_ARENA_VIOLATION_STALE }
        ir_arena_latch(kind, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    let slot = r.slot
    // Reading past the region is a caller bug, not a request for space. It must
    // never be allowed to compute an address outside the arena -- an accessor
    // that can segfault would defeat the entire point of this design.
    if idx >= IR_REGION_CAP[slot as usize] {
        ir_arena_latch(IR_ARENA_VIOLATION_INVALID, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    let at = IR_REGION_BASE[slot as usize] + idx
    if at < 0 || at >= ir_instr_arena_capacity() {
        ir_arena_latch(IR_ARENA_VIOLATION_INVALID, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    at
}

// Takes an IMMUTABLE handle on purpose. Growth only moves IR_REGION_BASE[slot],
// and the handle stores the SLOT, not the base -- so every copy of a handle sees
// the new base through the same indirection and growth cannot make a copy stale.
// That is also what keeps this callable from the ~1425 write sites: `&!` through
// a chain like `ir_fn_get(&module, 0).region` does not typecheck.
//
// A region is NOT allocated here. Writing into a function that was never given
// one is a bug in the caller, and it is latched as a violation rather than
// papered over -- the whole point of this design is that nothing about it is
// silent.
pub fn ir_region_slot_w(r: IrInstrRegion, idx: i64) -> i64 with Mut, Panic, Div {
    if idx < 0 { return IR_QUARANTINE_BASE }
    let st = ir_region_status_v(r)
    if st != IR_ARENA_OK {
        var kind = IR_ARENA_VIOLATION_INVALID
        if st == IR_ARENA_ERR_STALE { kind = IR_ARENA_VIOLATION_STALE }
        ir_arena_latch(kind, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    let slot = r.slot
    if IR_REGION_STATE[slot as usize] == IR_REGION_SEALED {
        ir_arena_latch(IR_ARENA_VIOLATION_SEALED, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    if idx >= IR_REGION_CAP[slot as usize] {
        let grc = ir_region_grow_slot(slot, idx + 1)
        if grc != IR_ARENA_OK {
            // Exhaustion is not a handle-contract breach. Naming it as one cost
            // the reader a hunt through the aliasing rules for a bug that is not
            // there; the arena is simply full.
            if grc == IR_ARENA_ERR_CAPACITY {
                IR_ARENA_VIOLATION_WANT = (idx + 1) - IR_REGION_CAP[slot as usize]
                ir_arena_latch(IR_ARENA_VIOLATION_INSTR_POOL, r)
            } else {
                ir_arena_latch(IR_ARENA_VIOLATION_INVALID, r)
            }
            return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
        }
    }
    if idx >= IR_REGION_LEN[slot as usize] {
        IR_REGION_LEN[slot as usize] = idx + 1
    }
    let at = IR_REGION_BASE[slot as usize] + idx
    if at < 0 || at >= ir_instr_arena_capacity() {
        ir_arena_latch(IR_ARENA_VIOLATION_INVALID, r)
        return IR_QUARANTINE_BASE + (idx % ir_quarantine_slots())
    }
    at
}

// Grow by SLOT, so no handle has to be updated and none can go stale.
fn ir_region_grow_slot(slot: i64, want: i64) -> i64 with Mut, Panic, Div {
    if slot < 0 || slot >= IR_REGION_COUNT { return IR_ARENA_ERR_INVALID }
    if want <= IR_REGION_CAP[slot as usize] { return IR_ARENA_OK }
    var grown = IR_REGION_CAP[slot as usize] * 2
    if grown < want { grown = want }
    if IR_ARENA_TOP + grown > ir_instr_arena_capacity() { return IR_ARENA_ERR_CAPACITY }
    let old_base = IR_REGION_BASE[slot as usize]
    let len = IR_REGION_LEN[slot as usize]
    let new_base = IR_ARENA_TOP
    var i: i64 = 0
    while i < len {
        ir_arena_copy_slot(new_base + i, old_base + i)
        i = i + 1
    }
    IR_ARENA_TOP = new_base + grown
    IR_REGION_BASE[slot as usize] = new_base
    IR_REGION_CAP[slot as usize] = grown
    IR_ARENA_OK
}

// Give a function its own region. Called where a function slot is created for
// real; ir_empty_function() cannot do it because array-repeat initialisers
// evaluate once and copy, which would hand every slot the SAME region.
pub fn ir_function_alloc_region(f: &! IrFunction) -> i64 with Mut, Panic, Div {
    var r = ir_region_invalid()
    let rc = ir_instr_arena_alloc(16, &! r)
    if rc != IR_ARENA_OK { return rc }
    (*f).region = r
    IR_ARENA_OK
}

pub fn ir_region_base_read(r: &IrInstrRegion) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st == IR_ARENA_ERR_STALE {
        ir_arena_latch(IR_ARENA_VIOLATION_STALE, *r)
        return IR_QUARANTINE_BASE
    }
    if st != IR_ARENA_OK {
        ir_arena_latch(IR_ARENA_VIOLATION_INVALID, *r)
        return IR_QUARANTINE_BASE
    }
    IR_REGION_BASE[(*r).slot as usize]
}

pub fn ir_region_base_write(r: &IrInstrRegion) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st == IR_ARENA_ERR_STALE {
        ir_arena_latch(IR_ARENA_VIOLATION_STALE, *r)
        return IR_QUARANTINE_BASE
    }
    if st != IR_ARENA_OK {
        ir_arena_latch(IR_ARENA_VIOLATION_INVALID, *r)
        return IR_QUARANTINE_BASE
    }
    if IR_REGION_STATE[(*r).slot as usize] == IR_REGION_SEALED {
        ir_arena_latch(IR_ARENA_VIOLATION_SEALED, *r)
        return IR_QUARANTINE_BASE
    }
    IR_REGION_BASE[(*r).slot as usize]
}

// ---------------------------------------------------------------------------
// Checked element access (used by the witnesses and by anything not on the
// rewritten hot path)
// ---------------------------------------------------------------------------

pub fn ir_region_get(r: &IrInstrRegion, idx: i64, out: &! IrInstr) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st != IR_ARENA_OK { return st }
    if idx < 0 || idx >= IR_REGION_LEN[(*r).slot as usize] { return IR_ARENA_ERR_RANGE }
    (*out) = ir_arena_load(IR_REGION_BASE[(*r).slot as usize] + idx)
    IR_ARENA_OK
}

pub fn ir_region_set(r: &IrInstrRegion, idx: i64, instr: IrInstr) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st != IR_ARENA_OK { return st }
    if IR_REGION_STATE[(*r).slot as usize] == IR_REGION_SEALED { return IR_ARENA_ERR_SEALED }
    if idx < 0 || idx >= IR_REGION_LEN[(*r).slot as usize] { return IR_ARENA_ERR_RANGE }
    ir_arena_store(IR_REGION_BASE[(*r).slot as usize] + idx, instr)
    IR_ARENA_OK
}

pub fn ir_region_push(r: &! IrInstrRegion, instr: IrInstr) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(&(*r))
    if st != IR_ARENA_OK { return st }
    let slot = (*r).slot
    if IR_REGION_STATE[slot as usize] == IR_REGION_SEALED { return IR_ARENA_ERR_SEALED }
    let len = IR_REGION_LEN[slot as usize]
    if len >= IR_REGION_CAP[slot as usize] {
        let rc = ir_region_reserve(r, len + 1)
        if rc != IR_ARENA_OK { return rc }
    }
    let s2 = (*r).slot
    let l2 = IR_REGION_LEN[s2 as usize]
    ir_arena_store(IR_REGION_BASE[s2 as usize] + l2, instr)
    IR_REGION_LEN[s2 as usize] = l2 + 1
    IR_ARENA_OK
}

// ---------------------------------------------------------------------------
// Growth
// ---------------------------------------------------------------------------
// Reallocation MOVES the region, so it bumps the generation: the handle passed
// in is updated, and every OTHER copy of that handle becomes detectably stale
// rather than silently pointing at the old bytes. That is the whole reason the
// generation exists.

pub fn ir_region_reserve(r: &! IrInstrRegion, want: i64) -> i64 with Mut, Panic, Div {
    if want < 0 { return IR_ARENA_ERR_NEGATIVE }
    let st = ir_region_status(&(*r))
    if st != IR_ARENA_OK { return st }
    let slot = (*r).slot
    if IR_REGION_STATE[slot as usize] == IR_REGION_SEALED { return IR_ARENA_ERR_SEALED }
    if want <= IR_REGION_CAP[slot as usize] { return IR_ARENA_OK }
    var grown = IR_REGION_CAP[slot as usize] * 2
    if grown < want { grown = want }
    if IR_ARENA_TOP + grown > ir_instr_arena_capacity() { return IR_ARENA_ERR_CAPACITY }
    let old_base = IR_REGION_BASE[slot as usize]
    let len = IR_REGION_LEN[slot as usize]
    let new_base = IR_ARENA_TOP
    var i: i64 = 0
    while i < len {
        ir_arena_copy_slot(new_base + i, old_base + i)
        i = i + 1
    }
    IR_ARENA_TOP = new_base + grown
    IR_REGION_BASE[slot as usize] = new_base
    IR_REGION_CAP[slot as usize] = grown
    IR_REGION_GEN[slot as usize] = IR_REGION_GEN[slot as usize] + 1
    (*r).generation = IR_REGION_GEN[slot as usize]
    IR_ARENA_OK
}

pub fn ir_region_set_len(r: &IrInstrRegion, len: i64) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st != IR_ARENA_OK { return st }
    if IR_REGION_STATE[(*r).slot as usize] == IR_REGION_SEALED { return IR_ARENA_ERR_SEALED }
    if len < 0 || len > IR_REGION_CAP[(*r).slot as usize] { return IR_ARENA_ERR_RANGE }
    IR_REGION_LEN[(*r).slot as usize] = len
    IR_ARENA_OK
}

// ---------------------------------------------------------------------------
// Sealing and cloning
// ---------------------------------------------------------------------------
// Seal on publication: once a function's instructions have been stored into a
// module or handed across a pass boundary, any further write through a handle to
// them is a missed clone. Cloning is the supported way to get a writable copy,
// and it is what the by-value boundaries must call.

pub fn ir_region_seal(r: &IrInstrRegion) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(r)
    if st != IR_ARENA_OK { return st }
    IR_REGION_STATE[(*r).slot as usize] = IR_REGION_SEALED
    IR_ARENA_OK
}

// Publish the module: every function's region refuses further writes from here.
//
// This is the only mechanism that can answer "is the aliasing class closed?".
// A static scan can only find the sites its own matching rule knows how to see,
// and this branch has already been bitten twice by that: Sweep 1 matched writes
// that were syntactically local and missed two `&!`-one-frame-down sites, and a
// third shape -- a copy parked in a struct field and mutated later -- would evade
// both scans. Sealing does not care what the write LOOKS like. It catches the
// write.
//
// Returns the number of regions sealed. Regions that are not live (an empty
// function never given one) are skipped rather than treated as an error.
pub fn ir_module_seal_functions(module: &IrModule) -> i64 with Mut, Panic, Div, Alloc {
    var sealed: i64 = 0
    var i: i64 = 0
    while i < (*module).fn_count && i < IR_MAX_FUNCS {
        // Hoist the handle before taking its address. Do not "simplify" this
        // back to `ir_region_seal(&ir_fn_get(&(*module), i as usize).region)`:
        // that is what the first version did, and it sealed ZERO of seven
        // regions in a real compile while reporting nothing.
        //
        // WHY it failed is NOT established. The obvious explanation -- that
        // `&<indexed expression>` is the bad shape, as in #1651's
        // `&IR_INSTR_ARENA[...]` -- does not survive testing:
        // tests/native-v2/ir_module_seal_witness.sio seals 3 of 3 with EITHER
        // form. The difference the witness cannot reach is that the compiler's
        // module is a Box, and `Box::new(ir_empty_module())` SIGSEGVs in a
        // witness (a 4.2 MB value through Box), so the failing shape has no
        // isolated reproduction yet. The hoist is a measured fix, 0 -> 7, with
        // an unproven mechanism. Treat it as load-bearing until someone can
        // reproduce and explain it.
        //
        // Sealing writes IR_REGION_STATE, a global, so a copy of the handle is
        // all this needs -- nothing has to be written back to the module.
        var r = ir_fn_region(module, i as usize)
        if ir_region_seal(&r) == IR_ARENA_OK {
            sealed = sealed + 1
        }
        i = i + 1
    }
    sealed
}

pub fn ir_region_clone(src: &IrInstrRegion, out: &! IrInstrRegion) -> i64 with Mut, Panic, Div {
    let st = ir_region_status(src)
    if st != IR_ARENA_OK { return st }
    let slot = (*src).slot
    let len = IR_REGION_LEN[slot as usize]
    // Sized to the actual length, not the source capacity: sizing clones by
    // worst case is what makes fixed-size regions cost as much as the inline
    // array this replaces.
    let rc = ir_instr_arena_alloc(len, out)
    if rc != IR_ARENA_OK { return rc }
    let src_base = IR_REGION_BASE[slot as usize]
    let dst_base = IR_REGION_BASE[(*out).slot as usize]
    var i: i64 = 0
    while i < len {
        ir_arena_copy_slot(dst_base + i, src_base + i)
        i = i + 1
    }
    IR_REGION_LEN[(*out).slot as usize] = len
    IR_ARENA_OK
}

// #1649 Sweep 1. An IrFunction value copy USED to be a deep copy, because the
// instructions were inline. With a region handle it is an ALIAS, and the
// optimizer depends on the old semantics:
//
//     var result = func                    // was: full deep copy
//     ...write through result...           // must NOT touch func
//     if !changed { return func }          // early-outs return the pristine original
//
// Under a shared region those writes land in func's storage while result's
// scalar fields (instr_count above all) stay separate, so the caller gets
// shifted instructions with an unchanged count. Nothing about that is visible
// to the type checker -- the copy site reads identically in both worlds.
//
// Fails CLOSED. If the region cannot be cloned the result carries an invalid
// handle, so the first write is routed to quarantine and latches a violation,
// rather than silently degrading into the alias this exists to prevent.
pub fn ir_function_clone(src: &IrFunction) -> IrFunction with Mut, Panic, Div {
    var out = *src
    var r = ir_region_invalid()
    if ir_region_clone(&(*src).region, &! r) != IR_ARENA_OK {
        out.region = ir_region_invalid()
        return out
    }
    out.region = r
    out
}

// ---------------------------------------------------------------------------
// Mark / release
// ---------------------------------------------------------------------------
// Pass-scoped reclamation: a pass records the mark on entry and releases back to
// it once the surviving result has been copied out. Regions allocated after the
// mark are invalidated -- their generation is bumped, so any handle to them that
// escaped the pass is caught by ir_region_status rather than silently reading
// whatever is allocated there next.

pub struct IrArenaMark {
    pub top: i64,
    pub region_count: i64,
}

pub fn ir_arena_mark() -> IrArenaMark {
    IrArenaMark { top: IR_ARENA_TOP, region_count: IR_REGION_COUNT }
}

pub fn ir_arena_release(m: &IrArenaMark) -> i64 with Mut, Panic, Div {
    if (*m).region_count < 0 || (*m).region_count > IR_REGION_COUNT { return IR_ARENA_ERR_RANGE }
    if (*m).top < 0 || (*m).top > IR_ARENA_TOP { return IR_ARENA_ERR_RANGE }
    var i = (*m).region_count
    while i < IR_REGION_COUNT {
        IR_REGION_STATE[i as usize] = IR_REGION_FREE
        IR_REGION_LEN[i as usize] = 0
        IR_REGION_CAP[i as usize] = 0
        IR_REGION_GEN[i as usize] = IR_REGION_GEN[i as usize] + 1
        i = i + 1
    }
    IR_ARENA_TOP = (*m).top
    IR_REGION_COUNT = (*m).region_count
    IR_ARENA_OK
}


pub struct IrFunction {
    pub name: Name,
    // #1649: the instruction storage moved to a variable-size arena region.
    // This used to be [IrInstr; 4096] inline, which made every IrFunction ~1 MB
    // and every IrModule ~2 GB regardless of use, and capped a function at 4096
    // IR instructions -- a 136-line test needs 14389.
    pub region: IrInstrRegion,
    pub instr_count: i64,
    pub reg_count: i64,
    pub label_count: i64,
    pub param_count: i64,
    pub param_regs: [i64; 64],
    pub compile_strategy: i64,
    pub returns_float: i64,        // 1 = declared return type is f64; used by native core value tracking
    pub return_struct_name: Name,  // Named return type, used by native field layout recovery
    // #1475: element count of a WORD-SCALAR fixed-array return type ([i64;4], [f64;8], ...),
    // else -1. Lets `var a = make_arr()` (no annotation) learn the length that
    // `var a: [i64;4] = make_arr()` gets from the annotation, so a later `var c = a`
    // takes the value-copy path instead of aliasing. Encoded as ONE field so the
    // unsafe combination "length known, element not word-scalar" is unrepresentable.
    pub return_fixed_array_len: i64,
    pub prof_counter_id: i64,
    pub hyper_algebra_kind: i64,  // -1 = absent/unknown, otherwise ALG_REAL..ALG_CLIFFORD
    pub is_sret: i64,             // 1 = SysV sret: rdi is hidden dest; explicit params shift to rsi+
    pub sret_dest_reg: i64,       // when is_sret==1: vreg receiving the hidden rdi destination
    pub bss_size: i64,            // for BSS-global vars: byte size of the global (8 for scalars)
    // 1 = first param is &T / &!T (method self-by-ref). Call sites must pass an
    // address; bare-value receivers need auto-OpRef (Root 2 method fix).
    pub first_param_is_ref: i64,
    // #1669: which vregs live in an xmm. This used to be smuggled through the
    // instruction stream as IrNop + IR_FLOAT_REG_MARKER_FLAG -- a fact with
    // FUNCTION lifetime stored in a slot with PASS lifetime. compact_nops deleted
    // it and every f64 returned from a call came back as i64 MAX.
    //
    // 64 words x 32 bits = 2048 vregs, which is not arbitrary: every consumer
    // already caps float typing there (NC_MAX_VREGS, MIR_MAX_FLOAT_SLOTS, and
    // codegen's `ty: [i64; 2048]`), so this is exactly information-preserving.
    // 32 bits per word, not 64, so every mask stays a positive i64.
    //
    // A BIT, not a tag, and that is not a limitation on f128/f256: wide floats
    // are software-emulated over consecutive INTEGER limbs (the 11 IrWide*
    // opcodes carry limb_count) and never set the marker. The question here is
    // strictly "xmm or general-purpose register" -- movsd or mov. A future
    // HARDWARE float of another width would need more than a bit; widening this
    // lane is then two helpers and four consumers, not a re-plumb.
    pub float_reg_bits: [i64; 64],
}

pub struct IrAlgebraInfo {
    name: Name,
    add_commutative: bool,
    add_associative: bool,
    mul_commutative: bool,
    mul_associative: bool,
    mul_alternative: bool,
    reassoc_strategy: i64,  // 0=free, 1=blocked, 2=fano_selective
    algebra_tag: i64,
    is_valid: bool,
}

pub struct IrAlgebraTable {
    entries: [IrAlgebraInfo; 32],
    count: i64,
}

pub fn ir_empty_algebra_info() -> IrAlgebraInfo {
    IrAlgebraInfo {
        name: Name { buf: [0; 128], len: 0 },
        add_commutative: true,
        add_associative: true,
        mul_commutative: true,
        mul_associative: true,
        mul_alternative: false,
        reassoc_strategy: 0,
        algebra_tag: 0,
        is_valid: false,
    }
}

pub fn ir_empty_algebra_table() -> IrAlgebraTable {
    IrAlgebraTable {
        entries: [ir_empty_algebra_info(); 32],
        count: 0,
    }
}

// Returns correctly-initialized IrAlgebraInfo for each Cayley-Dickson / Clifford algebra.
// Algebraic law enforcement:
//   tag=0 (Real):       add+mul both commutative and associative
//   tag=1 (Complex):    add+mul both commutative and associative
//                       mul_alternative = true (associativity implies alternativity)
//   tag=2 (Quaternion): mul non-commutative (Hamilton 1843), mul associative
//                       mul_alternative = true (associativity implies alternativity)
//   tag=3 (Octonion):   mul non-commutative, mul non-associative (Cayley 1845)
//                       mul_alternative = true (weaker than associative: x(xy)=(xx)y)
//   tag=4 (Sedenion):   mul non-commutative, mul non-associative, mul non-alternative
//                       (admits zero divisors; not a normed division algebra)
pub fn ir_algebra_info_for_tag(tag: i64) -> IrAlgebraInfo with Mut {
    var info = ir_empty_algebra_info()
    info.algebra_tag = tag
    info.is_valid = true
    if tag == 0 || tag == 1 {
        // Real/Complex: commutative, associative, alternative
        info.mul_alternative = true
        info.reassoc_strategy = 0
    } else if tag == 2 {
        // Quaternion: non-commutative, associative, alternative
        info.mul_commutative = false
        info.mul_associative = true
        info.mul_alternative = true
        info.reassoc_strategy = 0
    } else if tag == 3 {
        // Octonion: non-commutative, non-associative, alternative
        info.mul_commutative = false
        info.mul_associative = false
        info.mul_alternative = true
        info.reassoc_strategy = 2
    } else if tag == 4 {
        // Sedenion: non-commutative, non-associative, non-alternative
        info.mul_commutative = false
        info.mul_associative = false
        info.mul_alternative = false
        info.reassoc_strategy = 1
    }
    info
}

pub struct IrOntologyClassInfo {
    name: Name,
    ontology_name: Name,
    class_index: i64,
    superclass_count: i64,
    is_valid: bool,
}

pub struct IrOntologyPropertyInfo {
    name: Name,
    property_index: i64,
    domain_class_idx: i64,
    range_class_idx: i64,
}

// Audit-only link from a checked source signature to its lowered function.
// The optimizer may report this identity, but it must never treat it as
// authority for a transformation.
pub struct IrOntologyParameterLink {
    function_name: Name,
    parameter_index: i64,
    class_name: Name,
    is_valid: bool,
}

pub struct IrOntologyTable {
    entries: [IrOntologyClassInfo; 64],
    count: i64,
    properties: [IrOntologyPropertyInfo; 32],
    property_count: i64,
    parameter_links: [IrOntologyParameterLink; 128],
    parameter_link_count: i64,
}

fn ir_empty_ontology_class_info() -> IrOntologyClassInfo {
    IrOntologyClassInfo {
        name: Name { buf: [0; 128], len: 0 },
        ontology_name: Name { buf: [0; 128], len: 0 },
        class_index: -1,
        superclass_count: 0,
        is_valid: false,
    }
}

fn ir_empty_ontology_property_info() -> IrOntologyPropertyInfo {
    IrOntologyPropertyInfo {
        name: Name { buf: [0; 128], len: 0 },
        property_index: -1,
        domain_class_idx: -1,
        range_class_idx: -1,
    }
}

fn ir_empty_ontology_parameter_link() -> IrOntologyParameterLink {
    IrOntologyParameterLink {
        function_name: ir_empty_name(),
        parameter_index: -1,
        class_name: ir_empty_name(),
        is_valid: false,
    }
}

pub fn ir_empty_ontology_table() -> IrOntologyTable {
    IrOntologyTable {
        entries: [ir_empty_ontology_class_info(); 64],
        count: 0,
        properties: [ir_empty_ontology_property_info(); 32],
        property_count: 0,
        parameter_links: [ir_empty_ontology_parameter_link(); 128],
        parameter_link_count: 0,
    }
}

pub fn ir_ontology_table_record_parameter_link(
    table: &! IrOntologyTable,
    function_name: Name,
    parameter_index: i64,
    class_name: Name,
) -> bool with Mut, Panic, Div {
    if (*table).parameter_link_count >= 128 {
        return false
    }
    let index = (*table).parameter_link_count
    (*table).parameter_links[index as usize] = IrOntologyParameterLink {
        function_name: function_name,
        parameter_index: parameter_index,
        class_name: class_name,
        is_valid: true,
    }
    (*table).parameter_link_count = index + 1
    true
}

pub fn ir_ontology_parameter_link_count_for_function(
    table: &IrOntologyTable,
    function_name: Name,
) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < (*table).parameter_link_count && i < 128 {
        let link = (*table).parameter_links[i as usize]
        if link.is_valid && ir_name_eq(link.function_name, function_name) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

pub fn ir_ontology_parameter_last_class_hash_for_function(
    table: &IrOntologyTable,
    function_name: Name,
) -> i64 with Mut, Panic, Div {
    var class_hash: i64 = 0
    var i: i64 = 0
    while i < (*table).parameter_link_count && i < 128 {
        let link = (*table).parameter_links[i as usize]
        if link.is_valid && ir_name_eq(link.function_name, function_name) {
            class_hash = bss_name_hash(link.class_name)
        }
        i = i + 1
    }
    class_hash
}

// Bounded, audit-only accessors used by source-to-IR provenance traces. These
// expose checked signature identity after type erasure; they grant no optimizer
// or code-generation authority.
pub fn ir_ontology_parameter_link_total(table: &IrOntologyTable) -> i64 {
    let total = (*table).parameter_link_count
    if total < 0 {
        0
    } else if total > 128 {
        128
    } else {
        total
    }
}

pub fn ir_ontology_parameter_link_count_is_bounded(table: &IrOntologyTable) -> bool {
    (*table).parameter_link_count >= 0 && (*table).parameter_link_count <= 128
}

pub fn ir_ontology_parameter_link_is_valid_at(
    table: &IrOntologyTable,
    index: i64,
) -> bool with Panic, Div {
    let total = ir_ontology_parameter_link_total(table)
    if index < 0 || index >= total {
        false
    } else {
        (*table).parameter_links[index as usize].is_valid
    }
}

pub fn ir_ontology_parameter_link_function_name_at(
    table: &IrOntologyTable,
    index: i64,
) -> Name with Panic, Div {
    if !ir_ontology_parameter_link_is_valid_at(table, index) {
        ir_empty_name()
    } else {
        (*table).parameter_links[index as usize].function_name
    }
}

pub fn ir_ontology_parameter_link_parameter_index_at(
    table: &IrOntologyTable,
    index: i64,
) -> i64 with Panic, Div {
    if !ir_ontology_parameter_link_is_valid_at(table, index) {
        -1
    } else {
        (*table).parameter_links[index as usize].parameter_index
    }
}

pub fn ir_ontology_parameter_link_class_name_at(
    table: &IrOntologyTable,
    index: i64,
) -> Name with Panic, Div {
    if !ir_ontology_parameter_link_is_valid_at(table, index) {
        ir_empty_name()
    } else {
        (*table).parameter_links[index as usize].class_name
    }
}

pub fn ir_merge_ontology_parameter_links(
    dst: IrOntologyTable,
    src: IrOntologyTable,
) -> IrOntologyTable with Mut, Panic, Div {
    // This helper composes only audit links. The destination's semantic class
    // and property tables remain authoritative and are intentionally retained.
    var merged = dst
    var si: i64 = 0
    while si < src.parameter_link_count && si < 128 && merged.parameter_link_count < 128 {
        let candidate = src.parameter_links[si as usize]
        if candidate.is_valid {
            var exists = false
            var di: i64 = 0
            while di < merged.parameter_link_count {
                let current = merged.parameter_links[di as usize]
                if current.is_valid &&
                   current.parameter_index == candidate.parameter_index &&
                   ir_name_eq(current.function_name, candidate.function_name) &&
                   ir_name_eq(current.class_name, candidate.class_name) {
                    exists = true
                    di = merged.parameter_link_count
                } else {
                    di = di + 1
                }
            }
            if !exists {
                merged.parameter_links[merged.parameter_link_count as usize] = candidate
                merged.parameter_link_count = merged.parameter_link_count + 1
            }
        }
        si = si + 1
    }
    merged
}

// Extended with grade tracking — first IR to carry grade as first-class attribute.
// grade_mask: bitfield where bit k = 1 means grade-k blades are present.
// grade_known: true = grade_mask is exact; false = conservative (all bits set, no info).
// cl_p, cl_q: Clifford signature (positive and negative basis vectors).
// When grade_known && grade_mask == 0, the e-graph prunes this node (dead-grade elimination).
pub struct IrHyperExprInfo {
    span_start: i64,
    span_end: i64,
    algebra_tag: i64,
    op_kind: i64,
    knowledge_wrapped: bool,
    grade_mask: i64,
    grade_known: bool,
    cl_p: i64,
    cl_q: i64,
    reassoc_strategy: i64,
    forbidden_law_mask: i64,
    law_profile_source: i64,
    law_profile_fingerprint: i64,
}

fn ir_empty_hyper_expr_info() -> IrHyperExprInfo {
    IrHyperExprInfo {
        span_start: 0,
        span_end: 0,
        algebra_tag: -1,
        op_kind: 0,
        knowledge_wrapped: false,
        grade_mask: -1,
        grade_known: false,
        cl_p: 0,
        cl_q: 0,
        reassoc_strategy: 0,
        forbidden_law_mask: 0,
        law_profile_source: 0,
        law_profile_fingerprint: 0,
    }
}

// Sprint 44: profiling counter metadata — one per instrumented function
pub struct IrProfCounterInfo {
    fn_id: i64,
    fn_name: Name,
    counter_id: i64,
}

pub struct IrPolicyRequirementInfo {
    metric_id: i64,
    metric_name: Name,
    op: CompareOp,
    threshold: f64,
    threshold_kind: i64,
    bool_threshold: bool,
    name_threshold: Name,
}

pub fn ir_empty_policy_requirement_info() -> IrPolicyRequirementInfo {
    IrPolicyRequirementInfo {
        metric_id: -1,
        metric_name: ir_empty_name(),
        op: CompareOp::CmpEq,
        threshold: 0.0,
        threshold_kind: 0,
        bool_threshold: false,
        name_threshold: ir_empty_name(),
    }
}

