fn ir_call(dst: i64, fn_id: i64, fn_name: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    let pair_regs = ir_reg_list_first_two(args)
    let arg0 = pair_regs.0
    let arg1 = pair_regs.1
    let base = ir_instr_new(IrOpcode::IrCall)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: arg0,
        src2: arg1,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: fn_name,
        // Keep the full argument list. src1/src2 cache the first two for compatibility.
        call_args: args,
        arg_count: arg_count,
    }
}

fn ir_reg_list_first_two(args: Option<Box<IrRegList>>) -> (i64, i64) {
    match args {
        Some(list) => {
            let a0 = (*list).head
            match (*list).tail {
                Some(rest) => (a0, (*rest).head),
                _ => (a0, IR_INVALID_REG),
            }
        }
        _ => (IR_INVALID_REG, IR_INVALID_REG),
    }
}

