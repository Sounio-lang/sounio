// IrMeasure: measure(v: T, uncertainty: f64) → Knowledge<T> source (H5.5)
// At machine level this is equivalent to IrCopy (MOV); uncertainty is type-level only.
fn ir_measure(dst: i64, value_reg: i64, knowledge_meta_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrMeasure)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: value_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: knowledge_meta_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// IrDebugGuard: debug-mode policy guard — conditional trap (Sprint 28)
fn ir_debug_guard(metric_reg: i64, threshold: f64, cmp_op: i64, req_idx: i64, policy_name: Name) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrDebugGuard)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: metric_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: threshold,
        label_id: req_idx,
        fn_id: base.fn_id,
        field_idx: cmp_op,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: policy_name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Sprint 44: profiling counter increment — instrumented slow-path entry
fn ir_prof_counter(counter_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrProfCounter)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: base.src1,
        src2: base.src2,
        imm_i64: counter_id,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "measure" (for IR lowering intercept)
// "measure" = m(109) e(101) a(97) s(115) u(117) r(114) e(101), len=7
fn ir_name_is_measure(n: Name) -> bool {
    n.len == 7
    && n.buf[0] == 109 as i8 && n.buf[1] == 101 as i8
    && n.buf[2] == 97  as i8 && n.buf[3] == 115 as i8
    && n.buf[4] == 117 as i8 && n.buf[5] == 114 as i8
    && n.buf[6] == 101 as i8
}

fn ir_binop(dst: i64, lhs: i64, op: BinaryOp, rhs: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrBinOp)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: lhs,
        src2: rhs,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        bin_op: op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn ir_unaryop(dst: i64, op: UnaryOp, src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrUnaryOp)
    IrInstr {
