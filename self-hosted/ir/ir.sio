fn ir_empty_function() -> IrFunction {
    IrFunction {
        name: ir_empty_name(),
        instrs: [ir_nop(); 128],
        instr_count: 0,
        reg_count: 0,
        label_count: 0,
        param_count: 0,
        param_regs: [IR_INVALID_REG; 64],
        compile_strategy: IR_STRATEGY_STANDARD,
        prof_counter_id: -1,
    }
}

fn ir_empty_module() -> IrModule {
    IrModule {
        functions: [ir_empty_function(); 1024],
        fn_count: 0,
        string_table: [ir_empty_name(); 4096],
        string_count: 0,
        epistemic: ir_empty_epistemic_section(),
        prof_counters: [ir_empty_prof_counter_info(); 64],
        prof_counter_count: 0,
        export_names: [ir_empty_name(); 64],
        export_count: 0,
    }
}

fn ir_call_extern(dst: i64, symbol: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrCallExtern)
    instr.dst = dst
    instr.name = symbol
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

// Sprint 228: Load a function reference as a first-class i64 value.
fn ir_load_fn_ref(dst: i64, fn_id: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrLoadFnRef)
    instr.dst = dst
    instr.fn_id = fn_id
    instr
}

// Sprint 228: Indirect call — fn_id comes from register src1.
fn ir_call_indirect(dst: i64, fn_ref_reg: i64, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrCallIndirect)
    instr.dst = dst
    instr.src1 = fn_ref_reg
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

fn ir_module_add_export(module: IrModule, name: Name) -> IrModule with Mut, Panic {
    var m = module
    if m.export_count < 64 {
        m.export_names[m.export_count as usize] = name
        m.export_count = m.export_count + 1
    }
    m
}
