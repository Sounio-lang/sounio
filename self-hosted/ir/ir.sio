pub fn ir_wide_shr_limb(dst: i64, src: i64, limb_count: i64, shift_limbs: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrWideShrLimb)
    IrInstr {
        op: base.op, dst: dst, src1: src, src2: shift_limbs,
