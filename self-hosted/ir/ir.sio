pub fn ir_call(dst: i64, fn_id: i64, fn_name: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr with Div, Mut, Panic {
    let pair_regs = ir_reg_list_first_two(args)
    let arg0 = pair_regs.0
    let arg1 = pair_regs.1
    let base = ir_instr_new(IrOpcode::IrCall)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: arg0,
        src2: arg1,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(fn_name),
        // Keep the full argument list. src1/src2 cache the first two for compatibility.
        call_args: args,
        arg_count: arg_count,
    }
}

// Caller-side sret call. dest_reg = pre-allocated destination handle vreg (goes in rdi,
// NOT counted in arg_count). first_arg = vreg of the first EXPLICIT arg (goes in rsi);
// explicit args are dest contiguous vregs first_arg..first_arg+arg_count.
pub fn ir_call_sret(dst: i64, fn_id: i64, fn_name: Name, dest_reg: i64, first_arg: i64, arg_count: i64) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrCallSret)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: dest_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: first_arg,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(fn_name),
        call_args: base.call_args,
        arg_count: arg_count,
    }
}

// Callee-side sret return. src = vreg holding the hidden destination handle (spilled
// from rdi in the prologue); returned in rax with the standard epilogue.
pub fn ir_return_sret(src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrReturnSret)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: src,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

pub fn ir_reg_list_first_two(args: Option<Box<IrRegList>>) -> (i64, i64) {
    match args {
        Some(list) => {
            let a0 = (*list).head
            match (*list).tail {
                Some(rest) => (a0, (*rest).head),
                _ => (a0, IR_INVALID_REG),
            }
        }
        _ => (IR_INVALID_REG, IR_INVALID_REG),
    }
}

pub fn ir_return(src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrReturn)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: src,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// N-limb carry-chain add. dst/src1/src2 = base vregs of L consecutive limb slots;
// imm_i64 = L. Lowered to add (limb0) + adc (limbs 1..L-1).
pub fn ir_wide_add(dst: i64, src1: i64, src2: i64, limb_count: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrWideAdd)
    IrInstr {
        op: base.op,
