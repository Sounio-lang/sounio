// IrLiftKnowledge: lift_knowledge(k: Knowledge<T>) → Contest<T> bridge (H5.4)
// At machine level this is equivalent to IrCopy (MOV); the bridge is fully type-level.
pub fn ir_lift_knowledge(dst: i64, knowledge_reg: i64, contest_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrLiftKnowledge)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: knowledge_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: contest_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "lift_knowledge" (for IR lowering intercept)
// "lift_knowledge" = l(108) i(105) f(102) t(116) _(95) k(107) n(110) o(111)
//                   w(119) l(108) e(101) d(100) g(103) e(101), len=14
pub fn ir_name_is_lift_knowledge(n: Name) -> bool {
    n.len == 14
    && n.buf[0]  == 108 as i8 && n.buf[1]  == 105 as i8
    && n.buf[2]  == 102 as i8 && n.buf[3]  == 116 as i8
    && n.buf[4]  == 95  as i8 && n.buf[5]  == 107 as i8
    && n.buf[6]  == 110 as i8 && n.buf[7]  == 111 as i8
    && n.buf[8]  == 119 as i8 && n.buf[9]  == 108 as i8
    && n.buf[10] == 101 as i8 && n.buf[11] == 100 as i8
    && n.buf[12] == 103 as i8 && n.buf[13] == 101 as i8
}

// IrMeasure: measure(v: T, uncertainty: f64) → Knowledge<T> source (H5.5)
// At machine level this is equivalent to IrCopy (MOV); uncertainty is type-level only.
fn ir_measure(dst: i64, value_reg: i64, knowledge_meta_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrMeasure)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: value_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: knowledge_meta_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// IrDebugGuard: debug-mode policy guard — conditional trap (Sprint 28)
pub fn ir_debug_guard(metric_reg: i64, threshold: f64, cmp_op: i64, req_idx: i64, policy_name: Name) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrDebugGuard)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: metric_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: threshold,
        label_id: req_idx,
        fn_id: base.fn_id,
        field_idx: cmp_op,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(policy_name),
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Sprint 44: profiling counter increment — instrumented slow-path entry
pub fn ir_prof_counter(counter_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrProfCounter)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: base.src1,
        src2: base.src2,
        imm_i64: counter_id,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "measure" (for IR lowering intercept)
// "measure" = m(109) e(101) a(97) s(115) u(117) r(114) e(101), len=7
pub fn ir_name_is_measure(n: Name) -> bool {
    n.len == 7
    && n.buf[0] == 109 as i8 && n.buf[1] == 101 as i8
    && n.buf[2] == 97  as i8 && n.buf[3] == 115 as i8
    && n.buf[4] == 117 as i8 && n.buf[5] == 114 as i8
    && n.buf[6] == 101 as i8
}

// "Knowledge" -- the constructor-CALL form Knowledge(v, e=.., prov=..).
pub fn ir_name_is_knowledge_ctor(n: Name) -> bool {
    n.len == 9
    && n.buf[0] == 75  as i8 && n.buf[1] == 110 as i8
    && n.buf[2] == 111 as i8 && n.buf[3] == 119 as i8
    && n.buf[4] == 108 as i8 && n.buf[5] == 101 as i8
    && n.buf[6] == 100 as i8 && n.buf[7] == 103 as i8
    && n.buf[8] == 101 as i8
}

pub fn ir_binop(dst: i64, lhs: i64, op: BinaryOp, rhs: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrBinOp)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: lhs,
        src2: rhs,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

pub fn ir_binop_typed(dst: i64, lhs: i64, op: BinaryOp, rhs: i64, lhs_is_float: bool, rhs_is_float: bool) -> IrInstr {
    var ins = ir_binop(dst, lhs, op, rhs)
    if lhs_is_float {
        ins.imm_flags = ins.imm_flags + 2
    }
    if rhs_is_float {
        ins.imm_flags = ins.imm_flags + 4
    }
    ins
}

