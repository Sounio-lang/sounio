// IrContest: Contest<T> introduction — dst = subject datum, semantically tagged as contested
// At machine level this is equivalent to IrCopy (MOV); model selection happens at proof-time.
fn ir_contest(dst: i64, subject: i64, model_count: i64, contest_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrContest)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: subject,
        src2: base.src2,
        imm_i64: model_count,
        imm_f64: base.imm_f64,
        label_id: contest_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// IrProveRobust: prove_robust(contest, policy) introduction — dst = contest datum, Robust<T> tagged
// At machine level this is equivalent to IrCopy (MOV); policy satisfaction is proof-time only.
fn ir_prove_robust(dst: i64, contest_reg: i64, policy_reg: i64, proof_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrProveRobust)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: contest_reg,
        src2: policy_reg,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: proof_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// Check if a name is "prove_robust" (for IR lowering intercept)
// "prove_robust" = p(112) r(114) o(111) v(118) e(101) _(95) r(114) o(111) b(98) u(117) s(115) t(116), len=12
fn ir_name_is_prove_robust(n: Name) -> bool {
    n.len == 12
    && n.buf[0]  == 112 as i8 && n.buf[1]  == 114 as i8
    && n.buf[2]  == 111 as i8 && n.buf[3]  == 118 as i8
    && n.buf[4]  == 101 as i8 && n.buf[5]  == 95  as i8
    && n.buf[6]  == 114 as i8 && n.buf[7]  == 111 as i8
    && n.buf[8]  == 98  as i8 && n.buf[9]  == 117 as i8
    && n.buf[10] == 115 as i8 && n.buf[11] == 116 as i8
}

// IrValidated: validate_manifest(robust, validation) introduction — dst = robust datum, Validated<T> tagged
// validation_reg is carried for audit/runtime metadata surfaces, but codegen remains a zero-cost copy of src1.
fn ir_validated(dst: i64, robust_reg: i64, validation_reg: i64, manifest_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrValidated)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: robust_reg,
        src2: validation_reg,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: manifest_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

