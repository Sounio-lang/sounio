// Build a heap IrEpistemicSection in THIS leaf's own short frame and return only
// the Box pointer. Callers that would otherwise hold the MB-scale struct in a deep
// stack frame (e.g. the native streaming driver) must use this to avoid lean_single's
// layout-sensitive stale-stack crash. Inlining Box::new(ir_empty_epistemic_section())
// at the caller does NOT help — the struct literal is still built on the caller frame.
pub fn ir_empty_epistemic_section_boxed() -> Box<IrEpistemicSection> with Alloc, Mut, Panic, Div {
    var ep = ir_empty_epistemic_section()
    Box::new(ep)
}

