// Word/bit split for float_reg_bits. 32 bits per word keeps every mask positive.
pub fn ir_float_bits_capacity() -> i64 { 2048 }

// Counts float marks for vregs above the cap, where the bitset cannot represent
// them and codegen's fixpoint is the only channel. Visible rather than fatal --
// see ir_float_bits_set.
pub var IR_FLOAT_BITS_OVER_CAP: i64 = 0

// #1669 probe. The hot sites carry no IO -- giving them any would cascade to
// every caller, which is the failure that desynchronised the checker -- so the
// evidence is accumulated here and printed from the driver, where IO already is.
//
//   WRITES  bits actually flipped on by ir_float_bits_set
//   GETS    times ir_float_bits_get answered true
//   LIVE    bits still set across the module when codegen is about to run
//
// WRITES > 0 with LIVE == 0 means the writes are landing somewhere that does not
// survive to codegen -- a copy, or the 512-byte aggregate store defect that
// lower.sio:1652 documents for the identically-shaped param_regs.
// MEASURED 2026-08-06 and the reason the consumers below are inert:
//
//   writes=8  live_at_codegen=3683  fresh=0  live_fn0=744
//
// Eight bits written; 744 set in the module's function 0 alone. But `fresh=0` --
// a function straight out of ir_empty_function() is CLEAN. So the initialiser
// works and my first guess was wrong: the corruption happens between creation
// and the module's function array, not at initialisation.
//
// That points at the copy, not the constructor: `[ir_empty_function(); 2048]` is
// a repeat initialiser, and IrFunction just grew by a 512-byte array -- the same
// shape lower.sio:1652 documents as miscompiled for param_regs. The next probe
// is to count bits immediately after the module is built, before any lowering,
// which separates "the repeat-copy loses it" from "a lowering copy dirties it".
//
// Until then, consumers must not trust the bits. Flip this to 1 only with a
// probe showing live == writes.
// NOW 1, and load-bearing -- measured, not asserted.
//
// It sat at 0 because flipping it was safe but useless: the bitset agreed with
// the in-stream markers exactly (5 programs, 67 functions, 3391 bits,
// bits_only=0 and markers_only=0, ELFs byte-identical either way), yet it could
// not do the one job it exists for -- surviving a pass that deletes the marker
// nop. With IR_FLOAT_NO_MARKERS=1 suppressing the in-stream arms:
//
//     before the ordering fix   markers OFF -> v=9223372036854775808.000000
//     after                     markers OFF -> v=2.500000
//
// THE BLOCKER WAS ORDERING, not the lattice. codegen's pre-mark loop ran BEFORE
// the instruction stream was walked, so anything marking a register int later
// clobbered it; the marker nop worked precisely because it is honoured AT ITS
// POSITION. Re-asserting the bit for the register each instruction defines --
// O(1) per instruction, in compile_ir_function_v2_core_ir_into -- makes the bits
// positional too.
//
// (An earlier note here blamed nc_compute_float_types' CONFLICT rule. That was
// wrong: the marker-suppression experiment never gated that function's marker
// arm, so the lattice still had marker information and the failure was
// elsewhere. Corrected rather than quietly dropped.)
//
// Emitted code is unchanged: the same 10 ELFs are byte-identical to the
// pre-flip, pre-fix compiler. Self-test unchanged at 25 OK / 3 FAIL.
//
// PROVEN ON A CORPUS, not on one witness. 390 float-bearing run-pass tests,
// compiled and RUN under -O in three configurations each
// (scripts/dev/ir-arena/durable_channel_corpus.sh, results .tsv):
//
//     A  fixed compiler, markers ON    -- baseline
//     B  fixed compiler, markers OFF   -- the bits standing alone
//     C  pre-fix compiler, markers OFF -- the control
//
//     A == B  390 / 390        mismatches 0
//     A != C  169              the corpus can tell the difference
//
// The 169 matter as much as the 390: without them "everything matches" would
// only show the corpus never exercises the path. On 169 tests removing the
// markers DOES change the program's output on the old compiler, and on none of
// them does it change it on the new one.
pub let IR_FLOAT_BITS_TRUSTED: i64 = 1

// #1669 EXPERIMENT SWITCH, set from the environment by module_frontend. When 1,
// the IN-STREAM float-marker arms in codegen and machine_ir are skipped, leaving
// only the function-scoped bits. That is how we test whether the bits are a real
// channel or decoration: if an f64 still comes out right with the markers off,
// the bits carried it. A global rather than a read_env at each site because
// read_env carries IO, and the sites that need this have Mut/Panic/Div only --
// widening them cascades the effect across every caller.
pub var IR_FLOAT_NO_MARKERS: i64 = 0
pub var IR_FLOAT_BITS_INHERITED: i64 = 0
pub var IR_FLOAT_BITS_WRITES: i64 = 0
pub var IR_FLOAT_BITS_GETS: i64 = 0

fn ir_float_bit_mask(bit: i64) -> i64 {
    var m: i64 = 1
    var k: i64 = 0
    while k < bit {
        m = m * 2
        k = k + 1
    }
    m
}

// Returns false when reg is out of range rather than pretending. The caller that
// matters -- the emit funnel -- latches instead, because a marker for a reg this
// side of the cap is information the backend cannot represent at all.
pub fn ir_float_bits_get(f: &IrFunction, reg: i64) -> bool with Mut, Panic, Div {
    if reg < 0 || reg >= ir_float_bits_capacity() { return false }
    let word = reg / 32
    let bit = reg % 32
    let hit = ((*f).float_reg_bits[word as usize] / ir_float_bit_mask(bit)) % 2 == 1
    if hit { IR_FLOAT_BITS_GETS = IR_FLOAT_BITS_GETS + 1 }
    hit
}

// Set bits in ONE function. Used by the initialisation probe to ask the question
// the module-wide count cannot: is a freshly built IrFunction already dirty, or
// does it only become dirty on its way into the module array?
pub fn ir_function_count_float_bits(f: &IrFunction) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var r: i64 = 0
    while r < ir_float_bits_capacity() {
        if ir_float_bits_get(f, r) { n = n + 1 }
        r = r + 1
    }
    n
}

// Set bits in the slots ABOVE fn_count -- slots the lowering never touched. This
// is the discriminator: the module array is built by `[ir_empty_function(); 2048]`,
// so if untouched slots carry bits the array was born dirty and the repeat-copy
// is the culprit; if they are clean while used slots are dirty, a lowering copy
// is. Cheaper and more direct than instrumenting the constructor, which would
// want a 4.2 MB IrModule frame in the probe path.
pub fn ir_module_count_float_bits_untouched(module: &IrModule, n: i64) -> i64 with Mut, Panic, Div {
    var total: i64 = 0
    var k: i64 = 0
    while k < n {
        let slot = (*module).fn_count + k
        if slot >= IR_MAX_FUNCS { return total }
        // Same hoist as the live counter: a reference into a boxed array element
        // reads a wrong address under the seed. See the commit that measured it.
        var uslot = ir_fn_get(&(*module), slot as usize)
        var r: i64 = 0
        while r < ir_float_bits_capacity() {
            if ir_float_bits_get(&uslot, r) { total = total + 1 }
            r = r + 1
        }
        k = k + 1
    }
    total
}

// Set bits still visible across a whole module. Called from the driver just
// before codegen: this is the number that separates "never written" from
// "written and lost in transit".
pub fn ir_module_count_float_bits(module: &IrModule) -> i64 with Mut, Panic, Div {
    var total: i64 = 0
    var fi: i64 = 0
    while fi < (*module).fn_count && fi < IR_MAX_FUNCS {
        // Hoist the element to a local BEFORE taking a reference to it. Taking
        // &ir_fn_get(&(*module), i) directly is the same shape that made
        // ir_region_seal silently seal 0 of 7 regions until it was hoisted; that
        // fix worked but its mechanism was never explained. This is the probe
        // that explains it -- if the hoisted count differs from the in-place one,
        // the reference-into-a-boxed-array-element is computing a wrong address,
        // and every reading in this investigation came from a broken instrument
        // rather than from broken storage.
        var fslot = ir_fn_get(&(*module), fi as usize)
        var r: i64 = 0
        while r < ir_float_bits_capacity() {
            if ir_float_bits_get(&fslot, r) { total = total + 1 }
            r = r + 1
        }
        fi = fi + 1
    }
    total
}

pub fn ir_float_bits_set(f: &! IrFunction, reg: i64) -> i64 with Mut, Panic, Div {
    if reg < 0 || reg >= ir_float_bits_capacity() {
        // MEASURED, and it is why this does not latch. Latching here was the
        // first version, and it refused knowledge_octonion_structure.sio, which
        // uses 7088 vregs and marks some of them float above the cap -- a program
        // that COMPILES AND PASSES today. Codegen's join-over-defs fixpoint
        // (nc_compute_float_types) recovers the typing for those registers from
        // their definitions, so the marker is not the only channel and dropping
        // it above the cap is not, on this evidence, a miscompile.
        //
        // So: above the cap the bits carry nothing and the fixpoint is the
        // authority, exactly as before this change. That is a real gap in the
        // guarantee -- it is bounded at 2048 because every consumer is -- and it
        // is recorded rather than escalated, because escalating it measured worse
        // than the thing it was meant to prevent.
        IR_FLOAT_BITS_OVER_CAP = IR_FLOAT_BITS_OVER_CAP + 1
        return IR_ARENA_ERR_RANGE
    }
    let word = reg / 32
    let bit = reg % 32
    let mask = ir_float_bit_mask(bit)
    if ((*f).float_reg_bits[word as usize] / mask) % 2 == 0 {
        (*f).float_reg_bits[word as usize] = (*f).float_reg_bits[word as usize] + mask
        IR_FLOAT_BITS_WRITES = IR_FLOAT_BITS_WRITES + 1
    }
    IR_ARENA_OK
}

pub fn ir_empty_function() -> IrFunction {
    IrFunction {
        name: ir_empty_name(),
        region: ir_region_invalid(),
        instr_count: 0,
        reg_count: 0,
        label_count: 0,
        param_count: 0,
        param_regs: [IR_INVALID_REG; 64],
        compile_strategy: IR_STRATEGY_STANDARD,
        returns_float: 0,
        return_struct_name: ir_empty_name(),
        return_fixed_array_len: 0 - 1,
        prof_counter_id: -1,
        hyper_algebra_kind: -1,
        is_sret: 0,
        sret_dest_reg: -1,
        bss_size: 0,
        first_param_is_ref: 0,
        float_reg_bits: [0; 64],
    }
}

// Reset an IrFunction IN PLACE, without allocating a new one.
//
// WHY THIS EXISTS. IrFunction is ~673 KB — almost all of it
// `instrs: [IrInstr; IR_MAX_INSTRS]` — and the lowerer used to build a fresh
// one per function and Box it: `var f = ir_empty_function()` then
// `Box::new(f)`. The runtime allocator is a BUMP CURSOR with no reclamation
// (native_v2 "fast path: bump cursor"), so every one of those Boxes stays
// resident for the whole compile.
//
// Measured 2026-08-05, sampling /proc/<pid>/status through a 3000-function
// compile: RSS is 298 MB when lowering starts and 4805 MB when it ends —
// 1417 KB PER FUNCTION, all of it inside `lower_specialized`, while codegen
// afterwards costs about 50 KB per function. Reusing the Box removes the
// allocation entirely.
//
// ONLY THE USED PREFIX IS CLEARED. Slots past instr_count have not been
// written since the last reset, so they still hold the ir_nop() the initial
// fill put there — clearing all IR_MAX_INSTRS would reintroduce, as a memset,
// exactly the cost this avoids as an allocation.
pub fn ir_reset_function_in_place(f: &! IrFunction, name: Name) with Mut, Panic, Div {
    // #1649: the instruction storage is NOT cleared here, and must not be. This
    // nop-filled the used prefix of an inline `instrs` array, which was correct
    // while the array belonged to the function. Under the arena it is not: at this
    // point in lower_specialized `region` still points at the PREVIOUS function's
    // region -- the caller restores or allocates the right one only AFTER this
    // returns -- so a fill here erases instructions that are already published.
    // Invalidating is correct and cheaper: a fresh region is already nop, and a
    // restored one must keep exactly the instructions it has.
    (*f).region = ir_region_invalid()
    (*f).instr_count = 0
    (*f).name = name
    (*f).reg_count = 0
    (*f).label_count = 0
    (*f).param_count = 0
    var pi: i64 = 0
    while pi < 64 {
        (*f).param_regs[pi as usize] = IR_INVALID_REG
        pi = pi + 1
    }
    (*f).compile_strategy = IR_STRATEGY_STANDARD
    (*f).returns_float = 0
    (*f).return_struct_name = ir_empty_name()
    (*f).return_fixed_array_len = 0 - 1
    (*f).prof_counter_id = -1
    (*f).hyper_algebra_kind = -1
    (*f).is_sret = 0
    (*f).sret_dest_reg = -1
    (*f).bss_size = 0
    (*f).first_param_is_ref = 0
    // The reusable function Box retains this side table independently of the
    // instruction region. Leaving bits set makes registers in the next
    // function inherit float classification from the previous function.
    var fw: i64 = 0
    while fw < 64 {
        (*f).float_reg_bits[fw as usize] = 0
        fw = fw + 1
    }
}

pub let IR_FN_TABLE_OK: i64 = 0
pub let IR_FN_TABLE_ERR_INDEX: i64 = 1
pub let IR_FN_TABLE_ERR_ALLOC: i64 = 2

fn ir_fn_table_alloc() -> *mut IrFunctionTable with Alloc {
    heap_alloc(512) as *mut IrFunctionTable
}

fn ir_fn_chunk_alloc() -> *mut IrFunctionChunk with Alloc, Mut, Panic, Div {
    // heap_alloc is zeroed, but region slot 0 is quarantine rather than empty.
    let p = heap_alloc(4194304) as *mut IrFunctionChunk
    if p == (0 as *mut IrFunctionChunk) { return p }
    (*p).next = 0 as *mut IrFunctionChunk
    let empty = ir_empty_function()
    var i: i64 = 0
    while i < 512 {
        (*p).entries[i as usize] = empty
        i = i + 1
    }
    p
}

fn ir_fn_table_latch(t: *mut IrFunctionTable, status: i64, detail: i64) with Mut, Panic, Div {
    if t != (0 as *mut IrFunctionTable) && (*t).status == IR_FN_TABLE_OK {
        (*t).status = status
    }
    if IR_ARENA_VIOLATION == 0 {
        IR_ARENA_VIOLATION_KIND = if status == IR_FN_TABLE_ERR_INDEX { IR_ARENA_VIOLATION_FN_TABLE_INDEX } else { IR_ARENA_VIOLATION_FN_TABLE_ALLOC }
        IR_ARENA_VIOLATION_SLOT = detail
        IR_ARENA_VIOLATION_GEN = -1
    }
    IR_ARENA_VIOLATION = 1
}

fn ir_fn_table_chunk_for(t: *mut IrFunctionTable, gi: i64) -> *mut IrFunctionChunk with Mut, Panic, Div, Alloc {
    if t == (0 as *mut IrFunctionTable) { return 0 as *mut IrFunctionChunk }
    if gi < 0 || gi >= IR_MAX_FUNCS {
        ir_fn_table_latch(t, IR_FN_TABLE_ERR_INDEX, gi)
        return 0 as *mut IrFunctionChunk
    }
    let chunk_no = gi / 512
    if chunk_no >= 32 {
        ir_fn_table_latch(t, IR_FN_TABLE_ERR_INDEX, gi)
        return 0 as *mut IrFunctionChunk
    }
    if (*t).head == (0 as *mut IrFunctionChunk) {
        (*t).head = ir_fn_chunk_alloc()
        if (*t).head == (0 as *mut IrFunctionChunk) {
            ir_fn_table_latch(t, IR_FN_TABLE_ERR_ALLOC, 0)
            return 0 as *mut IrFunctionChunk
        }
        (*t).chunks[0] = (*t).head as i64
        (*t).chunk_count = 1
    }
    let indexed = (*t).chunks[chunk_no as usize] as *mut IrFunctionChunk
    if indexed != (0 as *mut IrFunctionChunk) { return indexed }
    var next_no = (*t).chunk_count
    var prev = (*t).chunks[(next_no - 1) as usize] as *mut IrFunctionChunk
    while next_no <= chunk_no {
        let fresh = ir_fn_chunk_alloc()
        if fresh == (0 as *mut IrFunctionChunk) {
            ir_fn_table_latch(t, IR_FN_TABLE_ERR_ALLOC, next_no)
            return 0 as *mut IrFunctionChunk
        }
        (*prev).next = fresh
        (*t).chunks[next_no as usize] = fresh as i64
        (*t).chunk_count = next_no + 1
        prev = fresh
        next_no = next_no + 1
    }
    (*t).chunks[chunk_no as usize] as *mut IrFunctionChunk
}

fn ir_fn_table_chunk_at(t: *mut IrFunctionTable, gi: i64) -> *mut IrFunctionChunk with Mut, Panic, Div {
    if t == (0 as *mut IrFunctionTable) { return 0 as *mut IrFunctionChunk }
    if gi < 0 || gi >= IR_MAX_FUNCS {
        ir_fn_table_latch(t, IR_FN_TABLE_ERR_INDEX, gi)
        return 0 as *mut IrFunctionChunk
    }
    let chunk_no = gi / 512
    (*t).chunks[chunk_no as usize] as *mut IrFunctionChunk
}

pub fn ir_fn_pool_ensure(m: &IrModule, i: i64) with Mut, Panic, Div, Alloc {
    let _chunk = ir_fn_table_chunk_for((*m).functions, i)
}

// Reads are intentionally shallow, matching the old inline-array value read.
// Deep ownership transfer is explicit through ir_module_clone.
pub fn ir_fn_get(m: &IrModule, i: i64) -> IrFunction with Mut, Panic, Div {
    let chunk = ir_fn_table_chunk_at((*m).functions, i)
    if chunk == (0 as *mut IrFunctionChunk) { return ir_empty_function() }
    (*chunk).entries[(i % 512) as usize]
}

pub fn ir_function_name_at(m: &IrModule, i: i64) -> Name with Mut, Panic, Div {
    let chunk = ir_fn_table_chunk_at((*m).functions, i)
    if chunk == (0 as *mut IrFunctionChunk) { return ir_empty_name() }
    (*chunk).entries[(i % 512) as usize].name
}

pub fn ir_fn_instr_count(m: &IrModule, i: i64) -> i64 with Mut, Panic, Div {
    let chunk = ir_fn_table_chunk_at((*m).functions, i)
    if chunk == (0 as *mut IrFunctionChunk) { return 0 }
    (*chunk).entries[(i % 512) as usize].instr_count
}

pub fn ir_fn_region(m: &IrModule, i: i64) -> IrInstrRegion with Mut, Panic, Div {
    let chunk = ir_fn_table_chunk_at((*m).functions, i)
    if chunk == (0 as *mut IrFunctionChunk) { return ir_region_invalid() }
    (*chunk).entries[(i % 512) as usize].region
}

// Growth is explicit so ordinary updates retain their pre-existing effect set.
pub fn ir_fn_set(m: &! IrModule, i: i64, f: IrFunction) with Mut, Panic, Div {
    let chunk = ir_fn_table_chunk_at((*m).functions, i)
    if chunk == (0 as *mut IrFunctionChunk) { return }
    (*chunk).entries[(i % 512) as usize] = f
}

pub fn ir_module_fn_get(m: &IrModule, i: i64) -> IrFunction with Mut, Panic, Div {
    ir_fn_get(m, i)
}

pub fn ir_module_fn_set(m: &! IrModule, i: i64, f: IrFunction) with Mut, Panic, Div, Alloc {
    ir_fn_pool_ensure(m, i)
    ir_fn_set(m, i, f)
}

pub fn ir_module_fn_storage_status(m: &IrModule) -> i64 {
    if (*m).functions == (0 as *mut IrFunctionTable) { return IR_FN_TABLE_ERR_ALLOC }
    (*(*m).functions).status
}

pub fn ir_module_clone(src: &IrModule) -> IrModule with Mut, Panic, Div, Alloc {
    var out = ir_empty_module()
    out.fn_count = (*src).fn_count
    out.string_table = (*src).string_table
    out.string_count = (*src).string_count
    out.epistemic = (*src).epistemic
    out.algebras = (*src).algebras
    out.ontologies = (*src).ontologies
    out.prof_counters = (*src).prof_counters
    out.prof_counter_count = (*src).prof_counter_count
    out.export_names = (*src).export_names
    out.export_count = (*src).export_count
    out.bss_total_size = (*src).bss_total_size
    var i: i64 = 0
    while i < (*src).fn_count && i < IR_MAX_FUNCS {
        let got = ir_fn_get(src, i)
        ir_fn_pool_ensure(&out, i)
        ir_fn_set(&! out, i, ir_function_clone(&got))
        i = i + 1
    }
    out
}

pub fn ir_module_fn(m: &IrModule, i: i64) -> IrFunction with Mut, Panic, Div {
    ir_fn_get(m, i)
}

pub fn ir_empty_module() -> IrModule with Mut, Panic, Div, Alloc {
    let table = ir_fn_table_alloc()
    if table != (0 as *mut IrFunctionTable) {
        (*table).head = ir_fn_chunk_alloc()
        if (*table).head != (0 as *mut IrFunctionChunk) {
            (*table).chunks[0] = (*table).head as i64
            (*table).chunk_count = 1
        } else {
            (*table).status = IR_FN_TABLE_ERR_ALLOC
        }
    }
    IrModule {
        functions: table,
        fn_count: 0,
        string_table: [ir_empty_name(); 16384],
        string_count: 0,
        epistemic: ir_empty_epistemic_section(),
        algebras: ir_empty_algebra_table(),
        ontologies: ir_empty_ontology_table(),
        prof_counters: [ir_empty_prof_counter_info(); 64],
        prof_counter_count: 0,
        export_names: [ir_empty_name(); 64],
        export_count: 0,
        bss_total_size: 0,
    }
}

// ============================================================================
// BSS global-variable tracking (mirrors lean_single GL table)
// ============================================================================

// BSS globals occupy the same fixed IrModule function-table storage as
// functions. A native entry module needs one shared slot for main, so this is
// the executable global boundary enforced by the module frontend.
// Keep this aligned with IR_MAX_FUNCS = 8192; global initializers in the
// bootstrap compiler do not evaluate a reference-plus-arithmetic expression.
pub let BSS_MAX_GLOBALS: i64 = 8191
pub let BSS_BASE_LINUX: i64 = 0x10000000
pub let IR_STRATEGY_BSS_GLOBAL: i64 = 99
// Wave15e: module-level string literal BSS init. prof_counter_id holds this
// magic; return_struct_name carries the normalized payload; codegen LEAs
// rodata into the BSS slot (imm fill cannot encode a RIP-relative pointer).
pub let BSS_INIT_STRING_MAGIC: i64 = 0 - 800001
// Must match native::gc::native_v2_object_header_size(). BSS aggregate & / &!
// refs stash (bss_addr - header) so native-v2 ref_array_* (load slot; resolve
// raw ptr; add header to index) lands on the true BSS base. Direct GG[i] still
// uses raw IndexGet (label_id=2) at BSS_BASE+off with no header.
pub let IR_NATIVE_V2_OBJECT_HEADER_SIZE: i64 = 32

pub fn bss_name_hash(n: Name) -> i64 with Div {
    var hash: i64 = 5381
    var i = 0
    while i < n.len {
        hash = hash * 33 + (n.buf[i as usize] as i64)
        i = i + 1
    }
    if hash < 0 { 0 - hash } else { hash }
}

pub fn ir_load_global(dst: i64, bss_offset: i64, name: Name) -> IrInstr with Mut, Panic, Div {
    var instr = ir_instr_new(IrOpcode::IrLoadGlobal)
    instr.dst = dst
    instr.imm_i64 = bss_offset
    instr.name_id = ir_intern_name(name)
    instr
}

pub fn ir_store_global(src: i64, bss_offset: i64, name: Name) -> IrInstr with Mut, Panic, Div {
    var instr = ir_instr_new(IrOpcode::IrStoreGlobal)
    instr.src1 = src
    instr.imm_i64 = bss_offset
    instr.name_id = ir_intern_name(name)
    instr
}

// Store val (src2) through the raw pointer in ptr (src1): [ptr] = val.
pub fn ir_store_ptr(ptr: i64, val: i64) -> IrInstr with Mut, Panic {
    var instr = ir_instr_new(IrOpcode::IrStorePtr)
    instr.src1 = ptr
    instr.src2 = val
    instr
}

pub fn ir_call_extern(dst: i64, symbol: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr with Mut, Panic, Div {
    var instr = ir_instr_new(IrOpcode::IrCallExtern)
    instr.dst = dst
    instr.name_id = ir_intern_name(symbol)
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

// Sprint 228: Load a function reference as a first-class i64 value.
pub fn ir_load_fn_ref(dst: i64, fn_id: i64) -> IrInstr with Mut, Panic {
    var instr = ir_instr_new(IrOpcode::IrLoadFnRef)
    instr.dst = dst
    instr.fn_id = fn_id
    instr
}

// Sprint 228: Indirect call — fn_id comes from register src1.
pub fn ir_call_indirect(dst: i64, fn_ref_reg: i64, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr with Mut, Panic {
    var instr = ir_instr_new(IrOpcode::IrCallIndirect)
    instr.dst = dst
    instr.src1 = fn_ref_reg
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

pub fn ir_module_add_export(module: IrModule, name: Name) -> IrModule with Mut, Panic {
    var m = module
    if m.export_count < 64 {
        m.export_names[m.export_count as usize] = name
        m.export_count = m.export_count + 1
    }
    m
}

pub fn ir_forbidden_law_mask(algebra_tag: i64, strategy: i64) -> i64 {
    0
}
