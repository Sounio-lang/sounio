        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn ir_phi(dst: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrPhi)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: base.src1,
        src2: base.src2,
