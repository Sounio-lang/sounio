// ============================================================================
// Section 28: Tests — Category 1: Array/Loop Setup (8 tests)
// ============================================================================

fn test_loc_add_array_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let id = loc_add_array(ctx, 8192, 8, 1)
    if id != 0 { return false }
    if ctx.array_count != 1 { return false }
    if ctx.arrays[0 as usize].total_size != 8192 { return false }
    if ctx.arrays[0 as usize].element_size != 8 { return false }
    if ctx.arrays[0 as usize].dimension_count != 1 { return false }
    true
}
fn test_loc_add_array() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_add_array_inner(&! ctx)
}

fn test_loc_add_multiple_arrays_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let a = loc_add_array(ctx, 4096, 4, 2)
    let b = loc_add_array(ctx, 8192, 8, 1)
    let c = loc_add_array(ctx, 16384, 16, 3)
    if a != 0 { return false }
    if b != 1 { return false }
    if c != 2 { return false }
    if ctx.array_count != 3 { return false }
    true
}
fn test_loc_add_multiple_arrays() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_add_multiple_arrays_inner(&! ctx)
}

fn test_loc_add_loop_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let id = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    if id != 0 { return false }
    if ctx.loop_count != 1 { return false }
    if ctx.loops[0 as usize].trip_count != 1000 { return false }
    if ctx.loops[0 as usize].depth != 0 { return false }
    true
}
fn test_loc_add_loop() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_add_loop_inner(&! ctx)
}

fn test_loc_nested_loops_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let outer = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let inner = loc_add_loop(ctx, 1, 100, outer)
    if outer != 0 { return false }
    if inner != 1 { return false }
    if ctx.loops[1 as usize].parent_loop != 0 { return false }
    if ctx.loops[1 as usize].depth != 1 { return false }
    true
}
fn test_loc_nested_loops() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_nested_loops_inner(&! ctx)
}

fn test_loc_add_access_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 42)
    if acc != 0 { return false }
    if ctx.access_count != 1 { return false }
    if ctx.accesses[0 as usize].stride != 8 { return false }
    if ctx.accesses[0 as usize].line != 42 { return false }
    true
}
fn test_loc_add_access() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_add_access_inner(&! ctx)
}

fn test_loc_access_loop_count_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    let a1 = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 10)
    let a2 = loc_add_access(ctx, arr, 0, 16, LocStrideKind::StrideConstant, lp, 8, 11)
    if ctx.loops[0 as usize].access_count != 2 { return false }
    true
}
fn test_loc_access_loop_count() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_access_loop_count_inner(&! ctx)
}

fn test_loc_array_query_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 4096, 4, 2)
    if loc_array_elem_size(ctx, 0) != 4 { return false }
    if loc_array_total_size(ctx, 0) != 4096 { return false }
    if loc_array_dims(ctx, 0) != 2 { return false }
