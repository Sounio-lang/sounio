}

// ============================================================================
// Section 29: Tests — Category 2: Stride Classification (6 tests)
// ============================================================================

fn test_loc_classify_unit_stride() -> bool with Div, Panic {
    let k = loc_classify_stride(8, 8)
    loc_stride_kind_to_int(k) == 0
}

fn test_loc_classify_unit_stride_negative() -> bool with Div, Panic {
    // Negative unit stride (reverse traversal)
    let k = loc_classify_stride(0 - 8, 8)
    loc_stride_kind_to_int(k) == 0
}

fn test_loc_classify_constant_stride() -> bool with Div, Panic {
    // Stride is 2x element size — constant but not unit
    let k = loc_classify_stride(16, 8)
    loc_stride_kind_to_int(k) == 1
}

fn test_loc_classify_zero_stride() -> bool with Div, Panic {
    // Zero stride — same element every iteration
    let k = loc_classify_stride(0, 8)
    loc_stride_kind_to_int(k) == 1
}

fn test_loc_classify_affine_stride() -> bool with Div, Panic {
    // Stride not a clean multiple of element size
    let k = loc_classify_stride(13, 8)
    loc_stride_kind_to_int(k) == 2
}

fn test_loc_classify_unknown_elem() -> bool with Div, Panic {
    // Zero element size — cannot classify
    let k = loc_classify_stride(8, 0)
    loc_stride_kind_to_int(k) == 4
}

// ============================================================================
// Section 30: Tests — Category 3: Reuse Analysis (10 tests)
// ============================================================================

fn test_loc_reuse_temporal_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    // Zero stride: same address every iteration — temporal reuse
    let acc = loc_add_access(ctx, arr, 0, 0, LocStrideKind::StrideConstant, lp, 8, 1)
    let info = loc_compute_reuse_distance(ctx, acc)
    if loc_reuse_kind_to_int(info.kind) != 0 { return false }
    if info.distance != 1 { return false }
    true
}
fn test_loc_reuse_temporal() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_reuse_temporal_inner(&! ctx)
}

fn test_loc_reuse_spatial_unit_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    // Unit stride (8 bytes, elem=8) — spatial reuse
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let info = loc_compute_reuse_distance(ctx, acc)
    if loc_reuse_kind_to_int(info.kind) != 1 { return false }
    // 64/8 = 8 elements per cache line
    if info.distance != 8 { return false }
    true
}
fn test_loc_reuse_spatial_unit() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_reuse_spatial_unit_inner(&! ctx)
}

fn test_loc_reuse_spatial_small_stride_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 4, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    // Stride 16, element 4 — constant stride but within cache line
    let acc = loc_add_access(ctx, arr, 0, 16, LocStrideKind::StrideConstant, lp, 4, 1)
    let info = loc_compute_reuse_distance(ctx, acc)
    // 16 < 64, so spatial reuse; distance = 64/16 = 4
    if loc_reuse_kind_to_int(info.kind) != 1 { return false }
    if info.distance != 4 { return false }
    true
}
fn test_loc_reuse_spatial_small_stride() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_reuse_spatial_small_stride_inner(&! ctx)
}

fn test_loc_reuse_none_large_stride_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 80000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    // Stride 1024 — much larger than cache line, no spatial reuse
    let acc = loc_add_access(ctx, arr, 0, 1024, LocStrideKind::StrideConstant, lp, 8, 1)
    let info = loc_compute_reuse_distance(ctx, acc)
    // 1024 >= 64, so no spatial reuse (and no group partner)
    if loc_reuse_kind_to_int(info.kind) != 3 { return false }
    true
}
fn test_loc_reuse_none_large_stride() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_reuse_none_large_stride_inner(&! ctx)
}

fn test_loc_reuse_group_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    // Two accesses to same array, nearby bases within one cache line
    let a1 = loc_add_access(ctx, arr, 0, 128, LocStrideKind::StrideConstant, lp, 8, 1)
    let a2 = loc_add_access(ctx, arr, 8, 128, LocStrideKind::StrideConstant, lp, 8, 2)
    // a2 base=8, same line as a1 base=0 (both in line 0)
    // But both have stride 128 >= 64, so self-reuse is none
    // group reuse should be detected
    let info = loc_compute_reuse_distance(ctx, a2)
    // a2 stride 128 >= cache line, so self-reuse is none
    // but a1 has base 0 and a2 has base 8, both in line 0 -> group
    if loc_reuse_kind_to_int(info.kind) != 2 { return false }
    true
}
fn test_loc_reuse_group() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_reuse_group_inner(&! ctx)
}

