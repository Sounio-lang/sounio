    var ctx = loc_context_new()
    test_loc_interchange_profitable_inner(&! ctx)
}

fn test_loc_interchange_not_profitable_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 80000, 8, 1)
    let outer = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let inner = loc_add_loop(ctx, 1, 100, outer)
    // Inner has more unit-stride → already good layout
    let a1 = loc_add_access(ctx, arr, 0, 128, LocStrideKind::StrideConstant, outer, 8, 1)
    let a2 = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, inner, 8, 2)
    let a3 = loc_add_access(ctx, arr, 8, 8, LocStrideKind::StrideUnit, inner, 8, 3)
    let result = loc_interchange_loops(ctx, outer, inner)
    if loc_interchange_result_to_int(result) != 2 { return false }
    true
}
fn test_loc_interchange_not_profitable() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_interchange_not_profitable_inner(&! ctx)
}

fn test_loc_interchange_random_illegal_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 80000, 8, 1)
    let outer = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let inner = loc_add_loop(ctx, 1, 100, outer)
    // Random stride in inner → illegal
    let a1 = loc_add_access(ctx, arr, 0, 999, LocStrideKind::StrideRandom, inner, 8, 1)
    let legal = loc_check_interchange_legal(ctx, outer, inner)
    if legal { return false }
    true
}
fn test_loc_interchange_random_illegal() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_interchange_random_illegal_inner(&! ctx)
}

// ============================================================================
// Section 35: Tests — Category 8: Integration (6 tests)
// ============================================================================

fn test_loc_working_set_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let ws = loc_compute_working_set(ctx, 0)
    // 100 iterations * 8 byte stride = 800 bytes
    if ws != 800 { return false }
    true
}
fn test_loc_working_set() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_working_set_inner(&! ctx)
}

fn test_loc_fits_cache_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    if loc_fits_in_l1(ctx, 1000) == false { return false }
    if loc_fits_in_l1(ctx, 100000) { return false }
    if loc_fits_in_l2(ctx, 100000) == false { return false }
    if loc_fits_in_l2(ctx, 1000000) { return false }
    if loc_fits_in_l3(ctx, 1000000) == false { return false }
    if loc_fits_in_l3(ctx, 100000000) { return false }
    true
}
fn test_loc_fits_cache() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_fits_cache_inner(&! ctx)
}

fn test_loc_full_pipeline_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1000000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100000, LOC_INVALID)
    let a1 = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let a2 = loc_add_access(ctx, arr, 8, 128, LocStrideKind::StrideConstant, lp, 8, 2)
    let opts = loc_run_full_analysis(ctx)
    // Should have at least some optimizations
    if ctx.reuse_count < 2 { return false }
    true
}
fn test_loc_full_pipeline() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_full_pipeline_inner(&! ctx)
}

fn test_loc_empty_context() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    let opts = loc_run_full_analysis(&! ctx)
    if opts != 0 { return false }
    if ctx.access_count != 0 { return false }
    if ctx.loop_count != 0 { return false }
    true
}

fn test_loc_total_improvement_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1000000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100000, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let opts = loc_run_full_analysis(ctx)
    let improvement = loc_total_improvement(ctx)
    // If tiling was applied, improvement should be positive
    if ctx.tile_count > 0 {
        if improvement <= 0 { return false }
    }
    true
}
fn test_loc_total_improvement() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_total_improvement_inner(&! ctx)
}

fn test_loc_misses_after_tiling_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1000000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100000, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let before = loc_estimate_cache_misses(ctx, 0)
    let after = loc_estimate_misses_after_tiling(ctx, 0, 32)
    if after >= before { return false }
    if after <= 0 { return false }
    true
}
fn test_loc_misses_after_tiling() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_misses_after_tiling_inner(&! ctx)
}

// ============================================================================
// Section 36: Test Runner
// ============================================================================

fn loc_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // Category 1: Array/Loop Setup (8 tests)
    if test_loc_add_array() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_add_multiple_arrays() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_add_loop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_nested_loops() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_add_access() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_access_loop_count() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_array_query() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_loop_query() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 2: Stride Classification (6 tests)
    if test_loc_classify_unit_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_classify_unit_stride_negative() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_classify_constant_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_classify_zero_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_classify_affine_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_classify_unknown_elem() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 3: Reuse Analysis (10 tests)
    if test_loc_reuse_temporal() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_spatial_unit() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_spatial_small_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_none_large_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_group() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_carried_by_loop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_compute_all_reuse() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_spatial_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_invalid_access() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_reuse_negative_access() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 4: Cache Miss Estimation (8 tests)
    if test_loc_misses_unit_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_zero_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_large_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_random() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_empty_loop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_multiple_accesses() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_affine() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_invalid_loop() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 5: Tiling (10 tests)
    if test_loc_suggest_tiling_applicable() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_suggest_tiling_small_loop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_suggest_tiling_fits_l1() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_apply_tiling() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_apply_tiling_already_tiled() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_apply_tiling_factor_too_large() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_apply_tiling_invalid_factor() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_suggest_all_tilings() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_optimal_tile_factor_basic() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_optimal_tile_factor_fits() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 6: Prefetch (6 tests)
    if test_loc_insert_prefetch() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_prefetch_hint_t1() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_prefetch_nta() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_suggest_prefetches() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_no_prefetch_small_stride() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_choose_hint_temporal() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 7: Loop Interchange (6 tests)
    if test_loc_interchange_legal() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_interchange_illegal_not_nested() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_interchange_illegal_same() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_interchange_profitable() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_interchange_not_profitable() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_interchange_random_illegal() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 8: Integration (6 tests)
    if test_loc_working_set() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_fits_cache() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_full_pipeline() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_empty_context() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_total_improvement() { passed = passed + 1 } else { failed = failed + 1 }
    if test_loc_misses_after_tiling() { passed = passed + 1 } else { failed = failed + 1 }

    if failed > 0 { return 0 - failed }
    passed
}
