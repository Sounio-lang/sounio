fn test_loc_optimal_tile_factor_basic() -> bool with Mut, Div, Panic {
    // Working set 100KB, L1 32KB, elem 8 bytes
    let factor = loc_optimal_tile_factor(102400, LOC_L1_SIZE, 8)
    // Need factor >= 100KB / (32KB * 3/4) = ~4.2, round up to power of 2 = 8
    if factor < 2 { return false }
    if factor > 256 { return false }
    true
}

