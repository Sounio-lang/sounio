fn test_loc_loop_query_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let lp = loc_add_loop(ctx, 2, 500, LOC_INVALID)
    if loc_loop_trip_count(ctx, 0) != 500 { return false }
    if loc_loop_depth(ctx, 0) != 2 { return false }
    if loc_loop_parent(ctx, 0) != LOC_INVALID { return false }
