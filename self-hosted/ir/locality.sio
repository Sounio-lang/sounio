        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }

    total_bytes
}

// Compute the memory footprint (in bytes) of a single access pattern
// over trip_count iterations.
fn loc_access_footprint(ctx: &LocContext, access_idx: i64, trip_count: i64) -> i64 with Div, Panic {
    if access_idx < 0 { return 0 }
    if access_idx >= ctx.access_count { return 0 }
    if trip_count <= 0 { return 0 }

    let stride = ctx.accesses[access_idx as usize].stride
    let elem_size = ctx.accesses[access_idx as usize].element_size
    let abs_stride = loc_abs(stride)

    // Zero stride: only one element accessed
    if abs_stride == 0 {
        return elem_size
    }

    // Footprint = stride * trip_count (capped at array size if known)
    let footprint = abs_stride * trip_count
    let array_id = ctx.accesses[access_idx as usize].array_id
    if array_id >= 0 {
        if array_id < ctx.array_count {
            let arr_size = ctx.arrays[array_id as usize].total_size
            if arr_size > 0 {
                return loc_min(footprint, arr_size)
            }
        }
    }
    footprint
}

// ============================================================================
// Section 16: Cache Fit Checks
// ============================================================================

// Check if a given data size fits in L1 cache.
fn loc_fits_in_l1(ctx: &LocContext, size: i64) -> bool {
    size <= ctx.l1_size
}

// Check if a given data size fits in L2 cache.
fn loc_fits_in_l2(ctx: &LocContext, size: i64) -> bool {
    size <= ctx.l2_size
}

// Check if a given data size fits in L3 cache.
fn loc_fits_in_l3(ctx: &LocContext, size: i64) -> bool {
    size <= ctx.l3_size
}

// Check if a working set fits within a fraction of cache (threshold).
fn loc_fits_with_margin(size: i64, cache_size: i64) -> bool with Div, Panic {
    // size <= cache_size * 3/4
    let threshold = cache_size * LOC_FIT_THRESHOLD_NUMER / LOC_FIT_THRESHOLD_DENOM
    size <= threshold
}

// ============================================================================
// Section 17: Optimal Tile Factor Computation
// ============================================================================

// Compute the optimal tile factor so that the tiled working set fits
// in the target cache level.
//
// working_set: estimated bytes touched per full loop iteration
// cache_size: size of target cache level (e.g. L1_SIZE)
// elem_size: element size for rounding
//
// Returns a tile factor >= 1.  The factor is the number of iterations
// in the tiled inner loop, chosen so that:
//   working_set / factor <= cache_size * 3/4
fn loc_optimal_tile_factor(working_set: i64, cache_size: i64, elem_size: i64) -> i64 with Mut, Div, Panic {
    if working_set <= 0 { return 1 }
    if cache_size <= 0 { return 1 }
    if elem_size <= 0 { return 1 }

    // Target: use 3/4 of cache
    let target = cache_size * LOC_FIT_THRESHOLD_NUMER / LOC_FIT_THRESHOLD_DENOM
    if target <= 0 { return 1 }

    // If already fits, no tiling needed
    if working_set <= target { return 1 }

    // factor = ceil(working_set / target)
    let raw_factor = loc_div_ceil(working_set, target)

    // Round to a nice power-of-two-ish number for code generation
    let clamped = loc_min(raw_factor, LOC_MAX_TILE_FACTOR)
    if clamped <= 1 { return 1 }

    // Find the smallest power of two >= clamped
    var p: i64 = 1
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }
    if p < clamped { p = p * 2 }

    loc_min(p, LOC_MAX_TILE_FACTOR)
}

// ============================================================================
// Section 18: Tiling Suggestions
// ============================================================================

// Suggest a tiling configuration for a single loop.
// Returns a LocTileConfig with the recommended factor and expected
// miss reduction.
fn loc_suggest_tiling(ctx: &! LocContext, loop_id: i64) -> LocTileConfig with Mut, Div, Panic {
    if loop_id < 0 {
        return loc_tile_default()
    }
    if loop_id >= ctx.loop_count {
        return loc_tile_default()
    }

    // Already tiled: skip
    if ctx.loops[loop_id as usize].is_tiled {
        return LocTileConfig {
            loop_id: loop_id,
            factor: ctx.loops[loop_id as usize].tile_factor,
            status: LocTileStatus::TileAlreadyTiled,
            estimated_misses_before: 0,
            estimated_misses_after: 0,
        }
    }

    let trip = ctx.loops[loop_id as usize].trip_count

    // Too short to tile
    if trip < LOC_MIN_TILE_TRIP {
        return LocTileConfig {
            loop_id: loop_id,
            factor: 0,
            status: LocTileStatus::TileNotProfitable,
            estimated_misses_before: 0,
            estimated_misses_after: 0,
        }
    }

    let working_set = loc_compute_working_set(ctx, loop_id)

    // Already fits in L1: not profitable
    if loc_fits_with_margin(working_set, ctx.l1_size) {
        return LocTileConfig {
            loop_id: loop_id,
            factor: 0,
            status: LocTileStatus::TileNotProfitable,
            estimated_misses_before: 0,
            estimated_misses_after: 0,
        }
    }

    // Compute tile factor to fit in L1
    let factor = loc_optimal_tile_factor(working_set, ctx.l1_size, LOC_CACHE_LINE_SIZE)
    if factor <= 1 {
        return LocTileConfig {
            loop_id: loop_id,
            factor: 0,
            status: LocTileStatus::TileNotProfitable,
            estimated_misses_before: 0,
            estimated_misses_after: 0,
        }
    }

    // Factor must divide trip count reasonably (or handle remainder)
    let misses_before = loc_estimate_cache_misses(ctx, loop_id)
    let misses_after = loc_estimate_misses_after_tiling(ctx, loop_id, factor)

    // Check if the improvement is significant (at least 10%)
    let improvement = misses_before - misses_after
    let threshold = loc_div_ceil(misses_before, 10)
    if improvement < threshold {
        return LocTileConfig {
            loop_id: loop_id,
            factor: factor,
            status: LocTileStatus::TileNotProfitable,
            estimated_misses_before: misses_before,
            estimated_misses_after: misses_after,
        }
    }

    LocTileConfig {
        loop_id: loop_id,
        factor: factor,
        status: LocTileStatus::TileApplicable,
        estimated_misses_before: misses_before,
        estimated_misses_after: misses_after,
    }
}

// ============================================================================
// Section 19: Apply Tiling
// ============================================================================

// Apply a tiling transformation to a loop.
// Marks the loop as tiled with the given factor.  Subsequent analyses
// will see the reduced working set.
fn loc_apply_tiling(ctx: &! LocContext, loop_id: i64, factor: i64) -> LocTileStatus with Mut, Div, Panic {
    if loop_id < 0 { return LocTileStatus::TileNotLegal }
    if loop_id >= ctx.loop_count { return LocTileStatus::TileNotLegal }
    if factor <= 1 { return LocTileStatus::TileNotLegal }

    // Already tiled
    if ctx.loops[loop_id as usize].is_tiled {
        return LocTileStatus::TileAlreadyTiled
    }

    // Trip count too small for this factor
    let trip = ctx.loops[loop_id as usize].trip_count
    if trip < factor {
        return LocTileStatus::TileNotLegal
    }

    // Apply the tiling
    ctx.loops[loop_id as usize].is_tiled = true
    ctx.loops[loop_id as usize].tile_factor = factor

    // Record in tiles array
    if ctx.tile_count < LOC_MAX_TILES {
        let misses_before = loc_estimate_cache_misses(ctx, loop_id)
        ctx.tiles[ctx.tile_count as usize] = LocTileConfig {
            loop_id: loop_id,
            factor: factor,
            status: LocTileStatus::TileApplicable,
            estimated_misses_before: misses_before,
            estimated_misses_after: loc_estimate_misses_after_tiling(ctx, loop_id, factor),
        }
        ctx.tile_count = ctx.tile_count + 1
    }

    LocTileStatus::TileApplicable
}

// ============================================================================
// Section 20: Suggest All Tilings
// ============================================================================

// Scan all loops and generate tiling suggestions for each.
// Applicable tilings are automatically applied.
fn loc_suggest_all_tilings(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    var applied: i64 = 0
    var i: i64 = 0

    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    if i < ctx.loop_count {
        let config = loc_suggest_tiling(ctx, i)
        if loc_tile_status_to_int(config.status) == 0 {
            let status = loc_apply_tiling(ctx, i, config.factor)
            if loc_tile_status_to_int(status) == 0 { applied = applied + 1 }
        }
        i = i + 1
    }
    applied
}

// ============================================================================
// Section 21: Prefetch Insertion
// ============================================================================

// Insert a software prefetch point manually.
// Returns the prefetch ID or LOC_INVALID if capacity exceeded.
fn loc_insert_prefetch(ctx: &! LocContext, array_id: i64, loop_id: i64, stride: i64, hint: LocPrefetchHint) -> i64 with Mut, Div, Panic {
    if ctx.prefetch_count >= LOC_MAX_PREFETCH { return LOC_INVALID }
    let idx = ctx.prefetch_count

    let hint_int = loc_prefetch_hint_to_int(hint)
    var offset: i64 = LOC_PREFETCH_DISTANCE_T0
    if hint_int == 1 { offset = LOC_PREFETCH_DISTANCE_T1 }
    if hint_int == 2 { offset = LOC_PREFETCH_DISTANCE_T2 }
    if hint_int == 3 { offset = LOC_PREFETCH_DISTANCE_NTA }

    let line: i64 = 0
    if loop_id >= 0 {
        if loop_id < ctx.loop_count {
            // Use the first access line in this loop as source location
        }
    }

    ctx.prefetches[idx as usize] = LocPrefetchPoint {
        array_id: array_id,
        loop_id: loop_id,
        offset_ahead: offset * stride,
        hint: hint,
        stride: stride,
        line: line,
    }
    ctx.prefetch_count = ctx.prefetch_count + 1
    idx
}

// Choose prefetch hint based on reuse distance.
// T0: L1 — for data that will be reused soon
// T1: L2 — for data with moderate reuse distance
// T2: L3 — for data with long reuse distance
// NTA: non-temporal — for streaming data with no reuse
fn loc_choose_prefetch_hint(reuse_kind: LocReuseKind, distance: i64) -> LocPrefetchHint {
    let kind_int = loc_reuse_kind_to_int(reuse_kind)
    // Temporal reuse: bring into L1
    if kind_int == 0 { return LocPrefetchHint::PrefetchT0 }
    // Spatial reuse: bring into L1 (will be used soon)
    if kind_int == 1 { return LocPrefetchHint::PrefetchT0 }
    // Group reuse: bring into L2 (shared among multiple accesses)
    if kind_int == 2 { return LocPrefetchHint::PrefetchT1 }
    // No reuse: non-temporal access (streaming)
    LocPrefetchHint::PrefetchNTA
}

// ============================================================================
// Section 22: Suggest Prefetches
// ============================================================================

// Automatically suggest prefetch points for all accesses with large strides.
// Prefetching is beneficial when stride >= cache line size (every access is
// a miss) and the loop has enough iterations to amortize the prefetch cost.
fn loc_suggest_prefetches(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0

    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let inserted = loc_maybe_insert_prefetch(ctx, i)
        if inserted { count = count + 1 }
        i = i + 1
    }
    count
}

// Decide whether to insert a prefetch for a single access and do it.
fn loc_maybe_insert_prefetch(ctx: &! LocContext, access_idx: i64) -> bool with Mut, Div, Panic {
    if access_idx < 0 { return false }
    if access_idx >= ctx.access_count { return false }

    let stride = ctx.accesses[access_idx as usize].stride
    let abs_stride = loc_abs(stride)
    let loop_id = ctx.accesses[access_idx as usize].loop_id
    let array_id = ctx.accesses[access_idx as usize].array_id

    // Only prefetch if stride is large enough to warrant it
    if abs_stride < LOC_PREFETCH_STRIDE_THRESHOLD { return false }

    // Need a valid loop
    if loop_id < 0 { return false }
    if loop_id >= ctx.loop_count { return false }

    // Need enough iterations to amortize prefetch cost
    let trip = ctx.loops[loop_id as usize].trip_count
    if trip < 16 { return false }

    // Choose hint based on reuse analysis (if available)
    var hint = LocPrefetchHint::PrefetchT0
    if abs_stride >= ctx.cache_line_size {
        // Large stride: no spatial reuse, use NTA for streaming
        hint = LocPrefetchHint::PrefetchNTA
    }

    // Check reuse info if available
    if access_idx < ctx.reuse_count {
        let reuse = ctx.reuse[access_idx as usize]
        hint = loc_choose_prefetch_hint(reuse.kind, reuse.distance)
    }

    let id = loc_insert_prefetch(ctx, array_id, loop_id, abs_stride, hint)
    if id == LOC_INVALID { return false }
    true
}

// ============================================================================
// Section 23: Loop Interchange Legality
// ============================================================================

// Check whether interchanging two loops is legal.
// Interchange is legal when there are no loop-carried dependencies
// that would be violated by the reordering.
//
// In this simplified model, we check:
//   1. Both loops must exist and be in a parent-child relationship
//   2. The inner loop must not carry dependencies that the outer loop resolves
//   3. No random-stride accesses in either loop (conservative)
fn loc_check_interchange_legal(ctx: &! LocContext, outer: i64, inner: i64) -> bool with Mut, Div, Panic {
    if outer < 0 { return false }
    if outer >= ctx.loop_count { return false }
    if inner < 0 { return false }
    if inner >= ctx.loop_count { return false }
    if outer == inner { return false }

    // Check parent-child relationship
    let inner_parent = ctx.loops[inner as usize].parent_loop
    if inner_parent != outer { return false }

    // Check for random-stride accesses (conservative: disallow)
    var i: i64 = 0
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == inner {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        if ctx.accesses[i as usize].loop_id == outer {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 3 {
                return false
            }
        }
        i = i + 1
    }

    true
}

// ============================================================================
// Section 24: Loop Interchange
// ============================================================================

// Count how many accesses in a loop have unit stride (best locality).
fn loc_count_unit_stride_accesses(ctx: &! LocContext, loop_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Perform loop interchange if legal and profitable.
// Interchange is profitable when moving the loop with more unit-stride
// accesses to the innermost position.
fn loc_interchange_loops(ctx: &! LocContext, outer: i64, inner: i64) -> LocInterchangeResult with Mut, Div, Panic {
    if loc_check_interchange_legal(ctx, outer, inner) == false {
        return LocInterchangeResult::InterchangeIllegal
    }

    // Count unit-stride accesses in each loop
    let outer_unit = loc_count_unit_stride_accesses(ctx, outer)
    let inner_unit = loc_count_unit_stride_accesses(ctx, inner)

    // Profitable if outer loop has more unit-stride accesses
    // (meaning it should become the inner loop)
    if outer_unit <= inner_unit {
        return LocInterchangeResult::InterchangeNotProfitable
    }

    // Perform the interchange by swapping depths
    let outer_depth = ctx.loops[outer as usize].depth
    let inner_depth = ctx.loops[inner as usize].depth
    ctx.loops[outer as usize].depth = inner_depth
    ctx.loops[inner as usize].depth = outer_depth

    // Update parent relationship
    ctx.loops[inner as usize].parent_loop = ctx.loops[outer as usize].parent_loop
    ctx.loops[outer as usize].parent_loop = inner

    // Update access depths
    var i: i64 = 0
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == outer {
            ctx.accesses[i as usize].loop_depth = inner_depth
        }
        if ctx.accesses[i as usize].loop_id == inner {
            ctx.accesses[i as usize].loop_depth = outer_depth
        }
        i = i + 1
    }

    LocInterchangeResult::InterchangeOk
}

// ============================================================================
// Section 25: Total Improvement
// ============================================================================

// Compute the estimated total miss reduction from all tiling and
// prefetch optimizations applied to the context.
fn loc_total_improvement(ctx: &LocContext) -> i64 with Mut, Div, Panic {
    var total_reduction: i64 = 0
    var i: i64 = 0

    // Sum up miss reductions from tiling decisions
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }
    if i < ctx.tile_count {
        let before = ctx.tiles[i as usize].estimated_misses_before
        let after = ctx.tiles[i as usize].estimated_misses_after
        if before > after {
            total_reduction = total_reduction + (before - after)
        }
        i = i + 1
    }

    total_reduction
}

// Compute total misses before optimization across all loops.
fn loc_total_misses_before(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    if i < ctx.loop_count {
        total = total + loc_estimate_cache_misses(ctx, i)
        i = i + 1
    }
    total
}

// ============================================================================
// Section 26: Full Analysis Pipeline
// ============================================================================

// Run the full data locality analysis and optimization pipeline:
//   1. Classify all access strides
//   2. Compute reuse distances
//   3. Suggest and apply tilings
//   4. Suggest prefetches
// Returns the number of optimizations applied.
fn loc_run_full_analysis(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    // Step 1: classify strides
    let unit_count = loc_analyze_access_patterns(ctx)

    // Step 2: compute reuse
    let reuse_count = loc_compute_all_reuse(ctx)

    // Step 3: tiling
    let tile_count = loc_suggest_all_tilings(ctx)

    // Step 4: prefetches
    let prefetch_count = loc_suggest_prefetches(ctx)

    tile_count + prefetch_count
}

