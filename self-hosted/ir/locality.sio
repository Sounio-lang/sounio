// self-hosted::ir::locality — Data locality optimization pass
//
// Cache-aware analysis and transformation pass for the Sounio self-hosted
// compiler IR.  Implements classical and modern data locality optimizations:
//
//   1. Access pattern analysis — classify memory access strides per loop nest
//   2. Reuse distance computation — temporal, spatial, group, and no-reuse
//   3. Cache miss estimation — model L1/L2/L3 cache behaviour under LRU
//   4. Loop tiling (blocking) — partition iteration space for cache residency
//   5. Prefetch insertion — software prefetch hints (T0/T1/T2/NTA)
//   6. Loop interchange — reorder nested loops for unit-stride access
//   7. Working set estimation — predict data footprint per loop level
//
// The analysis is purely static: it models cache behaviour from access patterns
// and loop trip counts without requiring profiling data.  All arrays are
// fixed-size — no heap allocation.
//
// Cache model:
//   L1: 32 KiB, 8-way, 64 B line  (LOC_L1_SIZE)
//   L2: 256 KiB, 8-way, 64 B line (LOC_L2_SIZE)
//   L3: 8 MiB, 16-way, 64 B line  (LOC_L3_SIZE)
//
// References:
//   Wolf & Lam: "A Data Locality Optimizing Algorithm" (PLDI 1991)
//   McKinley, Carr & Tseng: "Improving Data Locality with Loop
//       Transformations" (TOPLAS 1996)
//   Ding & Zhong: "Predicting Whole-Program Locality Through Reuse
//       Distance Analysis" (PLDI 2003)
//   Lam, Rothberg & Wolf: "The Cache Performance and Optimizations of
//       Blocked Algorithms" (ASPLOS 1991)
//   Mowry, Lam & Gupta: "Design and Evaluation of a Compiler Algorithm
//       for Prefetching" (ASPLOS 1992)
//   Allen & Kennedy: "Optimizing Compilers for Modern Architectures" (2002)

// ============================================================================
// Section 1: Constants
// ============================================================================

let LOC_MAX_ACCESSES: i64 = 1024
let LOC_MAX_LOOPS: i64 = 128
let LOC_MAX_TILES: i64 = 64
let LOC_MAX_PREFETCH: i64 = 256
let LOC_MAX_ARRAYS: i64 = 128
let LOC_MAX_REUSE: i64 = 1024

let LOC_CACHE_LINE_SIZE: i64 = 64
let LOC_L1_SIZE: i64 = 32768
let LOC_L2_SIZE: i64 = 262144
let LOC_L3_SIZE: i64 = 8388608

let LOC_INVALID: i64 = 0 - 1

// Prefetch distance constants (in cache lines ahead)
let LOC_PREFETCH_DISTANCE_T0: i64 = 8
let LOC_PREFETCH_DISTANCE_T1: i64 = 32
let LOC_PREFETCH_DISTANCE_T2: i64 = 64
let LOC_PREFETCH_DISTANCE_NTA: i64 = 128

// Minimum trip count for tiling to be worthwhile
let LOC_MIN_TILE_TRIP: i64 = 32

// Maximum tile factor (code bloat limit)
let LOC_MAX_TILE_FACTOR: i64 = 256

// Threshold: if working set fits this fraction of cache, tiling not needed
let LOC_FIT_THRESHOLD_NUMER: i64 = 3
let LOC_FIT_THRESHOLD_DENOM: i64 = 4

// Threshold for prefetch profitability: stride must exceed this
let LOC_PREFETCH_STRIDE_THRESHOLD: i64 = 8

// ============================================================================
// Section 2: Enums
// ============================================================================

// Classification of memory access stride pattern within a loop.
enum LocStrideKind {
    StrideUnit,
    StrideConstant,
    StrideAffine,
    StrideRandom,
    StrideUnknown,
}

// Classification of data reuse between memory accesses.
enum LocReuseKind {
    ReuseTemporal,
    ReuseSpatial,
    ReuseGroup,
    ReuseNone,
}

// Software prefetch hint level (maps to x86 prefetcht0/t1/t2/nta).
enum LocPrefetchHint {
    PrefetchT0,
    PrefetchT1,
    PrefetchT2,
    PrefetchNTA,
}

// Whether a loop is a legal and profitable tiling candidate.
enum LocTileStatus {
    TileApplicable,
    TileNotProfitable,
    TileNotLegal,
    TileAlreadyTiled,
}

// Outcome of a loop interchange attempt.
enum LocInterchangeResult {
    InterchangeOk,
    InterchangeIllegal,
    InterchangeNotProfitable,
}

// ============================================================================
// Section 3: Data Structures
// ============================================================================

// A single memory access pattern observed within a loop body.
// Records the array being accessed, the stride pattern, and the
// containing loop level so that reuse analysis can reason about
// which loop carries each access.
struct LocAccessPattern {
    array_id: i64,
    base_offset: i64,
    stride: i64,
    stride_kind: LocStrideKind,
    loop_id: i64,
    loop_depth: i64,
    element_size: i64,
    line: i64,
}

// Result of reuse analysis for a single access pattern.
// distance is the iteration distance before the same cache line is
// touched again.  carried_by_loop identifies the loop level that
// carries the reuse.  spatial_stride is the byte distance between
// consecutive accesses in the spatial dimension.
struct LocReuseInfo {
    kind: LocReuseKind,
    distance: i64,
    carried_by_loop: i64,
    spatial_stride: i64,
}

// Information about a loop in the nest.  access_start/access_count
// index into the global access table so we can find all accesses
// belonging to a given loop.
struct LocLoopInfo {
    id: i64,
    depth: i64,
    trip_count: i64,
    parent_loop: i64,
    access_start: i64,
    access_count: i64,
    is_tiled: bool,
    tile_factor: i64,
}

// Configuration and outcome of a tiling decision for a single loop.
struct LocTileConfig {
    loop_id: i64,
    factor: i64,
    status: LocTileStatus,
    estimated_misses_before: i64,
    estimated_misses_after: i64,
}

// A software prefetch insertion point.
struct LocPrefetchPoint {
    array_id: i64,
    loop_id: i64,
    offset_ahead: i64,
    hint: LocPrefetchHint,
    stride: i64,
    line: i64,
}

// Metadata about an array referenced by access patterns.
struct LocArrayInfo {
    id: i64,
    total_size: i64,
    element_size: i64,
    dimension_count: i64,
}

// The main analysis context.  Flat arena -- all storage is pre-allocated
// at fixed sizes.  No heap allocation during analysis.
struct LocContext {
    accesses: [LocAccessPattern; 1024],
    access_count: i64,
    loops: [LocLoopInfo; 128],
    loop_count: i64,
    tiles: [LocTileConfig; 64],
    tile_count: i64,
    prefetches: [LocPrefetchPoint; 256],
    prefetch_count: i64,
    arrays: [LocArrayInfo; 128],
    array_count: i64,
    reuse: [LocReuseInfo; 1024],
    reuse_count: i64,
    cache_line_size: i64,
    l1_size: i64,
    l2_size: i64,
    l3_size: i64,
    total_misses_before: i64,
    total_misses_after: i64,
}

// ============================================================================
// Section 4: Default Constructors
// ============================================================================

fn loc_access_default() -> LocAccessPattern {
    LocAccessPattern {
        array_id: LOC_INVALID,
        base_offset: 0,
        stride: 0,
        stride_kind: LocStrideKind::StrideUnknown,
        loop_id: LOC_INVALID,
        loop_depth: 0,
        element_size: 0,
        line: 0,
    }
}

fn loc_reuse_default() -> LocReuseInfo {
    LocReuseInfo {
        kind: LocReuseKind::ReuseNone,
        distance: 0,
        carried_by_loop: LOC_INVALID,
        spatial_stride: 0,
    }
}

fn loc_loop_default() -> LocLoopInfo {
    LocLoopInfo {
        id: LOC_INVALID,
        depth: 0,
        trip_count: 0,
        parent_loop: LOC_INVALID,
        access_start: 0,
        access_count: 0,
        is_tiled: false,
        tile_factor: 0,
    }
}

fn loc_tile_default() -> LocTileConfig {
    LocTileConfig {
        loop_id: LOC_INVALID,
        factor: 0,
        status: LocTileStatus::TileNotLegal,
        estimated_misses_before: 0,
        estimated_misses_after: 0,
    }
}

fn loc_prefetch_default() -> LocPrefetchPoint {
    LocPrefetchPoint {
        array_id: LOC_INVALID,
        loop_id: LOC_INVALID,
        offset_ahead: 0,
        hint: LocPrefetchHint::PrefetchT0,
        stride: 0,
        line: 0,
    }
}

fn loc_array_default() -> LocArrayInfo {
    LocArrayInfo {
        id: LOC_INVALID,
        total_size: 0,
        element_size: 0,
        dimension_count: 0,
    }
}

// ============================================================================
// Section 5: Context Constructor
// ============================================================================

fn loc_context_new() -> LocContext {
    LocContext {
        accesses: [loc_access_default(); 1024],
        access_count: 0,
        loops: [loc_loop_default(); 128],
        loop_count: 0,
        tiles: [loc_tile_default(); 64],
        tile_count: 0,
        prefetches: [loc_prefetch_default(); 256],
        prefetch_count: 0,
        arrays: [loc_array_default(); 128],
        array_count: 0,
        reuse: [loc_reuse_default(); 1024],
        reuse_count: 0,
        cache_line_size: LOC_CACHE_LINE_SIZE,
        l1_size: LOC_L1_SIZE,
        l2_size: LOC_L2_SIZE,
        l3_size: LOC_L3_SIZE,
        total_misses_before: 0,
        total_misses_after: 0,
    }
}

// ============================================================================
// Section 6: Arithmetic Helpers
// ============================================================================

// Integer absolute value.
fn loc_abs(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    x
}

// Integer minimum.
fn loc_min(a: i64, b: i64) -> i64 {
    if a < b { return a }
    b
}

// Integer maximum.
fn loc_max(a: i64, b: i64) -> i64 {
    if a > b { return a }
    b
}

// Integer division rounding up.
fn loc_div_ceil(num: i64, den: i64) -> i64 with Div, Panic {
    if den == 0 { return 0 }
    let q = num / den
    if num % den != 0 { return q + 1 }
    q
}

// Integer square root (floor) via Newton's method.
fn loc_isqrt(n: i64) -> i64 with Mut, Div, Panic {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    var x = n / 2
    var y = (x + n / x) / 2
    var iters: i64 = 0
    // Newton iteration: converges in O(log log n) steps
    // Guard with iteration limit to prevent infinite loops
    if x > y {
        x = y
        y = (x + n / x) / 2
        iters = iters + 1
    }
    if iters < 64 {
        if x > y {
            x = y
            y = (x + n / x) / 2
            iters = iters + 1
        }
    }
    // Iterative refinement loop
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    if x > y {
        x = y
        y = (x + n / x) / 2
    }
    // x is now floor(sqrt(n))
    x
}

// Compute greatest common divisor.
fn loc_gcd(a_in: i64, b_in: i64) -> i64 with Mut, Div, Panic {
    var a = loc_abs(a_in)
    var b = loc_abs(b_in)
    if b == 0 { return a }
    // Euclid's algorithm (iteratively unrolled)
    var tmp: i64 = 0
    // Iteration 1
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    if b != 0 { tmp = b; b = a % b; a = tmp }
    a
}

// Log base 2 (floor) for positive integers.
fn loc_log2(n: i64) -> i64 with Mut, Panic {
    if n <= 0 { return 0 }
    var result: i64 = 0
    var val = n
    if val >= 256 { val = val / 256; result = result + 8 }
    if val >= 16 { val = val / 16; result = result + 4 }
    if val >= 4 { val = val / 4; result = result + 2 }
    if val >= 2 { result = result + 1 }
    result
}

// Check if n is a power of two.
fn loc_is_power_of_two(n: i64) -> bool {
    if n <= 0 { return false }
    // n & (n-1) == 0 means power of 2; emulate with division
    // A power of two has exactly one bit set
    if n == 1 { return true }
    if n == 2 { return true }
    if n == 4 { return true }
    if n == 8 { return true }
    if n == 16 { return true }
    if n == 32 { return true }
    if n == 64 { return true }
    if n == 128 { return true }
    if n == 256 { return true }
    if n == 512 { return true }
    if n == 1024 { return true }
    if n == 2048 { return true }
    if n == 4096 { return true }
    if n == 8192 { return true }
    if n == 16384 { return true }
    if n == 32768 { return true }
    if n == 65536 { return true }
    if n == 131072 { return true }
    if n == 262144 { return true }
    if n == 524288 { return true }
    if n == 1048576 { return true }
    false
}

// ============================================================================
// Section 7: Array Registration
// ============================================================================

// Register an array with the analysis context.
// Returns the array ID (index into the arrays table).
fn loc_add_array(ctx: &! LocContext, total_size: i64, elem_size: i64, dims: i64) -> i64 with Mut, Div, Panic {
    if ctx.array_count >= LOC_MAX_ARRAYS { return LOC_INVALID }
    let idx = ctx.array_count
    ctx.arrays[idx as usize] = LocArrayInfo {
        id: idx,
        total_size: total_size,
        element_size: elem_size,
        dimension_count: dims,
    }
    ctx.array_count = ctx.array_count + 1
    idx
}

// Look up an array's element size.  Returns 0 for invalid IDs.
fn loc_array_elem_size(ctx: &LocContext, array_id: i64) -> i64 with Div, Panic {
    if array_id < 0 { return 0 }
    if array_id >= ctx.array_count { return 0 }
    ctx.arrays[array_id as usize].element_size
}

// Look up an array's total size.  Returns 0 for invalid IDs.
fn loc_array_total_size(ctx: &LocContext, array_id: i64) -> i64 with Div, Panic {
    if array_id < 0 { return 0 }
    if array_id >= ctx.array_count { return 0 }
    ctx.arrays[array_id as usize].total_size
}

// Look up an array's dimension count.  Returns 0 for invalid IDs.
fn loc_array_dims(ctx: &LocContext, array_id: i64) -> i64 with Div, Panic {
    if array_id < 0 { return 0 }
    if array_id >= ctx.array_count { return 0 }
    ctx.arrays[array_id as usize].dimension_count
}

// ============================================================================
// Section 8: Loop Registration
// ============================================================================

// Register a loop with the analysis context.
// depth is the nesting level (0 = outermost), parent is the parent
// loop ID or LOC_INVALID for outermost loops.
// Returns the loop ID.
fn loc_add_loop(ctx: &! LocContext, depth: i64, trip_count: i64, parent: i64) -> i64 with Mut, Div, Panic {
    if ctx.loop_count >= LOC_MAX_LOOPS { return LOC_INVALID }
    let idx = ctx.loop_count
    ctx.loops[idx as usize] = LocLoopInfo {
        id: idx,
        depth: depth,
        trip_count: trip_count,
        parent_loop: parent,
        access_start: ctx.access_count,
        access_count: 0,
        is_tiled: false,
        tile_factor: 0,
    }
    ctx.loop_count = ctx.loop_count + 1
    idx
}

// Look up a loop's trip count.  Returns 0 for invalid IDs.
fn loc_loop_trip_count(ctx: &LocContext, loop_id: i64) -> i64 with Div, Panic {
    if loop_id < 0 { return 0 }
    if loop_id >= ctx.loop_count { return 0 }
    ctx.loops[loop_id as usize].trip_count
}

// Look up a loop's depth.
fn loc_loop_depth(ctx: &LocContext, loop_id: i64) -> i64 with Div, Panic {
    if loop_id < 0 { return 0 }
    if loop_id >= ctx.loop_count { return 0 }
    ctx.loops[loop_id as usize].depth
}

// Look up a loop's parent.
fn loc_loop_parent(ctx: &LocContext, loop_id: i64) -> i64 with Div, Panic {
    if loop_id < 0 { return LOC_INVALID }
    if loop_id >= ctx.loop_count { return LOC_INVALID }
    ctx.loops[loop_id as usize].parent_loop
}

// Check if a loop is already tiled.
fn loc_loop_is_tiled(ctx: &LocContext, loop_id: i64) -> bool with Div, Panic {
    if loop_id < 0 { return false }
    if loop_id >= ctx.loop_count { return false }
    ctx.loops[loop_id as usize].is_tiled
}

// Get the number of accesses in a loop.
fn loc_loop_access_count(ctx: &LocContext, loop_id: i64) -> i64 with Div, Panic {
    if loop_id < 0 { return 0 }
    if loop_id >= ctx.loop_count { return 0 }
    ctx.loops[loop_id as usize].access_count
}

// ============================================================================
// Section 9: Access Pattern Registration
// ============================================================================

// Register a memory access pattern within a loop.
// stride_kind must be pre-classified or StrideUnknown for auto-classification.
// Returns the access ID (index into the accesses table).
fn loc_add_access(ctx: &! LocContext, array_id: i64, base: i64, stride: i64, stride_kind: LocStrideKind, loop_id: i64, elem_size: i64, line: i64) -> i64 with Mut, Div, Panic {
    if ctx.access_count >= LOC_MAX_ACCESSES { return LOC_INVALID }
    let idx = ctx.access_count
    let depth = loc_loop_depth(ctx, loop_id)
    ctx.accesses[idx as usize] = LocAccessPattern {
        array_id: array_id,
        base_offset: base,
        stride: stride,
        stride_kind: stride_kind,
        loop_id: loop_id,
        loop_depth: depth,
        element_size: elem_size,
        line: line,
    }
    ctx.access_count = ctx.access_count + 1
    // Update loop's access_count
    if loop_id >= 0 {
        if loop_id < ctx.loop_count {
            ctx.loops[loop_id as usize].access_count = ctx.loops[loop_id as usize].access_count + 1
        }
    }
    idx
}

// Look up an access pattern's stride.
fn loc_access_stride(ctx: &LocContext, access_idx: i64) -> i64 with Div, Panic {
    if access_idx < 0 { return 0 }
    if access_idx >= ctx.access_count { return 0 }
    ctx.accesses[access_idx as usize].stride
}

// Look up an access pattern's array ID.
fn loc_access_array(ctx: &LocContext, access_idx: i64) -> i64 with Div, Panic {
    if access_idx < 0 { return LOC_INVALID }
    if access_idx >= ctx.access_count { return LOC_INVALID }
    ctx.accesses[access_idx as usize].array_id
}

// Look up an access pattern's loop ID.
fn loc_access_loop(ctx: &LocContext, access_idx: i64) -> i64 with Div, Panic {
    if access_idx < 0 { return LOC_INVALID }
    if access_idx >= ctx.access_count { return LOC_INVALID }
    ctx.accesses[access_idx as usize].loop_id
}

// ============================================================================
// Section 10: Stride Classification
// ============================================================================

// Classify a stride pattern based on the stride value and element size.
//
// Unit stride: the stride equals the element size, meaning consecutive
//   elements are accessed in memory order (best locality).
// Constant stride: the stride is a fixed multiple of the element size
//   (regular but non-unit pattern).
// Affine stride: the stride is non-zero and not a perfect multiple of
//   element size (irregular but predictable).
// Random: stride is zero but access pattern is not unit (unknown pattern).
// Unknown: cannot classify.
fn loc_classify_stride(stride: i64, elem_size: i64) -> LocStrideKind with Div, Panic {
    if elem_size <= 0 { return LocStrideKind::StrideUnknown }
    let abs_stride = loc_abs(stride)
    // Unit stride: access consecutive elements
    if abs_stride == elem_size {
        return LocStrideKind::StrideUnit
    }
    // Zero stride: same location each iteration (temporal reuse)
    if stride == 0 {
        return LocStrideKind::StrideConstant
    }
    // Constant stride: stride is exact multiple of element size
    if abs_stride % elem_size == 0 {
        return LocStrideKind::StrideConstant
    }
    // Non-zero stride that is not a clean multiple: affine
    if abs_stride > 0 {
        return LocStrideKind::StrideAffine
    }
    LocStrideKind::StrideUnknown
}

// Reclassify a single access pattern's stride in-place.
fn loc_reclassify_access(ctx: &! LocContext, access_idx: i64) -> LocStrideKind with Mut, Div, Panic {
    if access_idx < 0 { return LocStrideKind::StrideUnknown }
    if access_idx >= ctx.access_count { return LocStrideKind::StrideUnknown }
    let stride = ctx.accesses[access_idx as usize].stride
    let elem = ctx.accesses[access_idx as usize].element_size
    let kind = loc_classify_stride(stride, elem)
    ctx.accesses[access_idx as usize].stride_kind = kind
    kind
}

// ============================================================================
// Section 11: Analyze All Access Patterns
// ============================================================================

// Reclassify stride for all registered access patterns.
// This is typically called after all accesses have been registered to
// ensure consistent classification.
fn loc_analyze_access_patterns(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var unit_count: i64 = 0
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    // Continue with remaining accesses in groups of 8
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    // Process remaining accesses beyond the initial 8
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        let k = loc_reclassify_access(ctx, i)
        if loc_stride_is_unit(k) { unit_count = unit_count + 1 }
        i = i + 1
    }
    unit_count
}

// Helper: check if stride kind is unit.
fn loc_stride_is_unit(k: LocStrideKind) -> bool {
    if loc_stride_kind_to_int(k) == 0 { return true }
    false
}

// Convert stride kind to integer tag for comparisons.
fn loc_stride_kind_to_int(k: LocStrideKind) -> i64 {
    match k {
        LocStrideKind::StrideUnit => 0,
        LocStrideKind::StrideConstant => 1,
        LocStrideKind::StrideAffine => 2,
        LocStrideKind::StrideRandom => 3,
        LocStrideKind::StrideUnknown => 4,
    }
}

// Convert reuse kind to integer tag for comparisons.
fn loc_reuse_kind_to_int(k: LocReuseKind) -> i64 {
    match k {
        LocReuseKind::ReuseTemporal => 0,
        LocReuseKind::ReuseSpatial => 1,
        LocReuseKind::ReuseGroup => 2,
        LocReuseKind::ReuseNone => 3,
    }
}

// Convert tile status to integer tag.
fn loc_tile_status_to_int(s: LocTileStatus) -> i64 {
    match s {
        LocTileStatus::TileApplicable => 0,
        LocTileStatus::TileNotProfitable => 1,
        LocTileStatus::TileNotLegal => 2,
        LocTileStatus::TileAlreadyTiled => 3,
    }
}

// Convert interchange result to integer tag.
fn loc_interchange_result_to_int(r: LocInterchangeResult) -> i64 {
    match r {
        LocInterchangeResult::InterchangeOk => 0,
        LocInterchangeResult::InterchangeIllegal => 1,
        LocInterchangeResult::InterchangeNotProfitable => 2,
    }
}

// Convert prefetch hint to integer tag.
fn loc_prefetch_hint_to_int(h: LocPrefetchHint) -> i64 {
    match h {
        LocPrefetchHint::PrefetchT0 => 0,
        LocPrefetchHint::PrefetchT1 => 1,
        LocPrefetchHint::PrefetchT2 => 2,
        LocPrefetchHint::PrefetchNTA => 3,
    }
}

// ============================================================================
// Section 12: Reuse Distance Computation
// ============================================================================

// Compute reuse information for a single access pattern.
//
// Reuse classification:
//   Temporal: the same memory address is accessed again by the same access
//     in a later iteration of the carrying loop.  Occurs when stride == 0
//     (same address every iteration) or when the total sweep wraps within
//     a cache line.
//   Spatial: different addresses within the same cache line are accessed
//     in consecutive iterations.  Occurs with unit or small constant stride.
//   Group: different accesses in the same loop body touch the same cache
//     line.  Detected by finding other accesses to the same array with
//     nearby base offsets.
//   None: no detectable reuse pattern.
fn loc_compute_reuse_distance(ctx: &! LocContext, access_idx: i64) -> LocReuseInfo with Mut, Div, Panic {
    if access_idx < 0 { return loc_reuse_default() }
    if access_idx >= ctx.access_count { return loc_reuse_default() }

    let stride = ctx.accesses[access_idx as usize].stride
    let elem_size = ctx.accesses[access_idx as usize].element_size
    let loop_id = ctx.accesses[access_idx as usize].loop_id
    let array_id = ctx.accesses[access_idx as usize].array_id
    let base = ctx.accesses[access_idx as usize].base_offset
    let abs_stride = loc_abs(stride)

    // Zero stride means same address every iteration — pure temporal reuse
    if stride == 0 {
        return LocReuseInfo {
            kind: LocReuseKind::ReuseTemporal,
            distance: 1,
            carried_by_loop: loop_id,
            spatial_stride: 0,
        }
    }

    // Unit stride: spatial reuse — consecutive iterations touch the same
    // cache line until we cross a boundary
    if abs_stride == elem_size {
        let line_size = ctx.cache_line_size
        let elems_per_line = loc_max(1, line_size / loc_max(1, elem_size))
        return LocReuseInfo {
            kind: LocReuseKind::ReuseSpatial,
            distance: elems_per_line,
            carried_by_loop: loop_id,
            spatial_stride: abs_stride,
        }
    }

    // Small constant stride (within a cache line): spatial reuse
    if abs_stride > 0 {
        if abs_stride < ctx.cache_line_size {
            let line_size = ctx.cache_line_size
            let accesses_per_line = loc_max(1, line_size / loc_max(1, abs_stride))
            return LocReuseInfo {
                kind: LocReuseKind::ReuseSpatial,
                distance: accesses_per_line,
                carried_by_loop: loop_id,
                spatial_stride: abs_stride,
            }
        }
    }

    // Check for group reuse: other accesses to the same array with nearby base
    let group_reuse = loc_check_group_reuse(ctx, access_idx, array_id, base)
    if loc_reuse_kind_to_int(group_reuse.kind) == 2 {
        return group_reuse
    }

    // Large stride or unknown: no reuse
    LocReuseInfo {
        kind: LocReuseKind::ReuseNone,
        distance: 0,
        carried_by_loop: loop_id,
        spatial_stride: abs_stride,
    }
}

// Check if any other access in the same loop touches the same array
// with a base offset within the same cache line.
fn loc_check_group_reuse(ctx: &! LocContext, self_idx: i64, array_id: i64, base: i64) -> LocReuseInfo with Mut, Div, Panic {
    let line_size = ctx.cache_line_size
    let self_line = base / loc_max(1, line_size)
    let self_loop = ctx.accesses[self_idx as usize].loop_id

    var i: i64 = 0
    // Scan all accesses for group reuse matches
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if i != self_idx {
            if ctx.accesses[i as usize].array_id == array_id {
                if ctx.accesses[i as usize].loop_id == self_loop {
                    let other_line = ctx.accesses[i as usize].base_offset / loc_max(1, line_size)
                    if other_line == self_line {
                        return LocReuseInfo {
                            kind: LocReuseKind::ReuseGroup,
                            distance: 0,
                            carried_by_loop: self_loop,
                            spatial_stride: loc_abs(base - ctx.accesses[i as usize].base_offset),
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    // No group reuse found
    loc_reuse_default()
}

// ============================================================================
// Section 13: Compute All Reuse
// ============================================================================

// Compute reuse information for all registered access patterns.
// Stores results in the reuse array of the context.
fn loc_compute_all_reuse(ctx: &! LocContext) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    // Process up to 16 accesses (unrolled)
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    // Process remaining accesses beyond 8
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    if i < ctx.access_count {
        let info = loc_compute_reuse_distance(ctx, i)
        if ctx.reuse_count < LOC_MAX_REUSE {
            ctx.reuse[ctx.reuse_count as usize] = info
            ctx.reuse_count = ctx.reuse_count + 1
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 14: Cache Miss Estimation
// ============================================================================

// Estimate the number of cache misses for a single access in a loop.
// Model: for unit stride, miss every cache_line_size/element_size iterations.
// For larger strides, miss every iteration if stride >= cache_line_size.
// For random access, assume miss every iteration.
fn loc_estimate_access_misses(ctx: &LocContext, access_idx: i64, trip_count: i64) -> i64 with Div, Panic {
    if access_idx < 0 { return 0 }
    if access_idx >= ctx.access_count { return 0 }
    if trip_count <= 0 { return 0 }

    let stride = ctx.accesses[access_idx as usize].stride
    let elem_size = ctx.accesses[access_idx as usize].element_size
    let kind = ctx.accesses[access_idx as usize].stride_kind
    let kind_int = loc_stride_kind_to_int(kind)
    let line_size = ctx.cache_line_size

    // Unit stride: one miss per cache line traversal
    if kind_int == 0 {
        let elems_per_line = loc_max(1, line_size / loc_max(1, elem_size))
        return loc_div_ceil(trip_count, elems_per_line)
    }

    // Constant stride (including zero stride)
    if kind_int == 1 {
        let abs_stride = loc_abs(stride)
        // Zero stride: compulsory miss + hits
        if abs_stride == 0 {
            return 1
        }
        // Stride within one cache line: similar to unit stride but scaled
        if abs_stride < line_size {
            let lines_touched = loc_div_ceil(abs_stride * trip_count, line_size)
            return lines_touched
        }
        // Stride >= cache line: miss every iteration
        return trip_count
    }

    // Affine stride: assume miss every other iteration (heuristic)
    if kind_int == 2 {
        return loc_div_ceil(trip_count, 2)
    }

    // Random or unknown: miss every iteration
    trip_count
}

// Estimate total cache misses for all accesses within a loop.
fn loc_estimate_cache_misses(ctx: &! LocContext, loop_id: i64) -> i64 with Mut, Div, Panic {
    if loop_id < 0 { return 0 }
    if loop_id >= ctx.loop_count { return 0 }

    let trip = ctx.loops[loop_id as usize].trip_count
    var total: i64 = 0
    var i: i64 = 0

    // Scan all accesses belonging to this loop
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total = total + loc_estimate_access_misses(ctx, i, trip)
        }
        i = i + 1
    }
    total
}

// Estimate cache misses after tiling with a given factor.
// The basic model: tiling by factor F means the working set shrinks by F,
// so misses scale roughly by (working_set_after / cache_size) if the
// tiled working set fits in cache, or remain unchanged if not.
fn loc_estimate_misses_after_tiling(ctx: &! LocContext, loop_id: i64, tile_factor: i64) -> i64 with Mut, Div, Panic {
    let misses_before = loc_estimate_cache_misses(ctx, loop_id)
    if tile_factor <= 1 { return misses_before }

    let working_set = loc_compute_working_set(ctx, loop_id)
    let tiled_ws = working_set / tile_factor

    // If tiled working set fits in L1, massive reduction
    if tiled_ws <= ctx.l1_size {
        // Only compulsory misses remain; estimate as misses_before / tile_factor
        return loc_div_ceil(misses_before, tile_factor)
    }

    // If tiled working set fits in L2, moderate reduction
    if tiled_ws <= ctx.l2_size {
        return loc_div_ceil(misses_before * 2, tile_factor)
    }

    // If tiled working set fits in L3, small reduction
    if tiled_ws <= ctx.l3_size {
        return loc_div_ceil(misses_before * 3, tile_factor)
    }

    // Still too large: marginal benefit
    misses_before - loc_div_ceil(misses_before, 4)
}

// ============================================================================
// Section 15: Working Set Estimation
// ============================================================================

// Estimate the working set size (in bytes) for a loop.
// The working set is the total number of distinct cache lines touched
// during one full traversal of the loop.
fn loc_compute_working_set(ctx: &! LocContext, loop_id: i64) -> i64 with Mut, Div, Panic {
    if loop_id < 0 { return 0 }
    if loop_id >= ctx.loop_count { return 0 }

    let trip = ctx.loops[loop_id as usize].trip_count
    let line_size = ctx.cache_line_size
    var total_bytes: i64 = 0
    var i: i64 = 0

    // Sum up the footprint of each access in this loop
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
