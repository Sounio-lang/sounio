// Get a tile config by index.
fn loc_get_tile(ctx: &LocContext, idx: i64) -> LocTileConfig with Div, Panic {
    if idx < 0 { return loc_tile_default() }
    if idx >= ctx.tile_count { return loc_tile_default() }
    ctx.tiles[idx as usize]
}

// Get a prefetch point by index.
fn loc_get_prefetch(ctx: &LocContext, idx: i64) -> LocPrefetchPoint with Div, Panic {
    if idx < 0 { return loc_prefetch_default() }
    if idx >= ctx.prefetch_count { return loc_prefetch_default() }
    ctx.prefetches[idx as usize]
}

// Get a reuse info by index.
fn loc_get_reuse(ctx: &LocContext, idx: i64) -> LocReuseInfo with Div, Panic {
    if idx < 0 { return loc_reuse_default() }
    if idx >= ctx.reuse_count { return loc_reuse_default() }
    ctx.reuse[idx as usize]
}

