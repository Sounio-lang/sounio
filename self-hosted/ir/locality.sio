fn test_loc_interchange_profitable_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 80000, 8, 1)
    let outer = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let inner = loc_add_loop(ctx, 1, 100, outer)
    // Outer has more unit-stride accesses than inner -> profitable to swap
    let a1 = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, outer, 8, 1)
    let a2 = loc_add_access(ctx, arr, 8, 8, LocStrideKind::StrideUnit, outer, 8, 2)
    let a3 = loc_add_access(ctx, arr, 16, 128, LocStrideKind::StrideConstant, inner, 8, 3)
    let result = loc_interchange_loops(ctx, outer, inner)
    if loc_interchange_result_to_int(result) != 0 { return false }
    true
}
