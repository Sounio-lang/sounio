    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
        if ctx.accesses[i as usize].loop_id == loop_id {
            total_bytes = total_bytes + loc_access_footprint(ctx, i, trip)
        }
        i = i + 1
    }
    if i < ctx.access_count {
