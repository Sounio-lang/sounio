// T59: Block-to-loop map after loop tree construction
fn test_lopt_block_loop_map_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)
    let depth = lopt_build_loop_tree(ctx)

    // Blocks 1 and 2 should be mapped to loop 0
    if ctx.block_loop_map[1] != 0 {
        print("FAIL: test_lopt_block_loop_map b1\n")
        return 1
    }
    if ctx.block_loop_map[2] != 0 {
        print("FAIL: test_lopt_block_loop_map b2\n")
        return 1
    }
    // Block 0 and 3 should not be in any loop
    if ctx.block_loop_map[0] != LOPT_INVALID {
        print("FAIL: test_lopt_block_loop_map b0\n")
        return 1
    }
    if ctx.block_loop_map[3] != LOPT_INVALID {
        print("FAIL: test_lopt_block_loop_map b3\n")
        return 1
    }
    print("PASS: test_lopt_block_loop_map\n")
    return 0
}

