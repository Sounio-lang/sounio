// T23: Dependence analysis — with memory ops
fn test_lopt_deps_with_memory_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)

    // Add store instructions to the loop body (block 1 and 2 are in loop)
    let i0 = lopt_add_instr(ctx, 2, 16, LOPT_INVALID, 5, 6)  // INDEX_SET
    let i1 = lopt_add_instr(ctx, 2, 15, 7, 5, 8)              // INDEX_GET same base

    let deps = lopt_analyze_dependencies(ctx, 0)
    // Should detect at least one dependence (store-load on same base)
    if deps < 1 {
        print("FAIL: test_lopt_deps_with_memory\n")
        return 1
    }
    print("PASS: test_lopt_deps_with_memory\n")
    return 0
}

