// T01: Context initialization
fn test_lopt_context_new() -> i32 with IO, Mut, Div, Panic {
    let ctx = lopt_context_new()
    if ctx.nest.loop_count != 0 {
        print("FAIL: test_lopt_context_new loop_count\n")
        return 1
    }
    if ctx.iv_count != 0 {
        print("FAIL: test_lopt_context_new iv_count\n")
        return 1
    }
    if ctx.invariant_count != 0 {
        print("FAIL: test_lopt_context_new invariant_count\n")
        return 1
    }
    if ctx.dep_count != 0 {
        print("FAIL: test_lopt_context_new dep_count\n")
        return 1
    }
    if ctx.stats.loops_found != 0 {
        print("FAIL: test_lopt_context_new stats\n")
        return 1
    }
    print("PASS: test_lopt_context_new\n")
    return 0
}

// T02: Block addition
fn test_lopt_add_block_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let b0 = lopt_add_block(ctx, 0)
    let b1 = lopt_add_block(ctx, 1)
    if ctx.block_count != 2 {
        print("FAIL: test_lopt_add_block count\n")
        return 1
    }
    if b0 != 0 || b1 != 1 {
        print("FAIL: test_lopt_add_block indices\n")
        return 1
    }
    print("PASS: test_lopt_add_block\n")
    return 0
}

