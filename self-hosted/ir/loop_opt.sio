// T17: IV properties
fn test_lopt_iv_properties_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)
    let iv_count = lopt_find_induction_vars(ctx, 0)
    if iv_count < 1 {
        print("FAIL: test_lopt_iv_properties no ivs\n")
        return 1
    }
    let iv = ctx.ivs[0]
    if iv.kind != LOPT_IV_BASIC {
        print("FAIL: test_lopt_iv_properties kind\n")
        return 1
    }
    if iv.is_primary == false {
        print("FAIL: test_lopt_iv_properties primary\n")
        return 1
    }
    if iv.step_val != 1 {
        print("FAIL: test_lopt_iv_properties step\n")
        return 1
    }
    print("PASS: test_lopt_iv_properties\n")
    return 0
}

