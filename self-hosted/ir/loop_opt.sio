}

// T60: Dependence direction classification
fn test_lopt_dep_direction_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)

    // Add a store and a load with same base in the loop
    let i0 = lopt_add_instr(ctx, 2, 16, LOPT_INVALID, 5, 6)  // INDEX_SET (store)
    let i1 = lopt_add_instr(ctx, 2, 15, 7, 5, 8)              // INDEX_GET (load)

    let deps = lopt_analyze_dependencies(ctx, 0)
    if deps < 1 {
        print("FAIL: test_lopt_dep_direction no deps\n")
        return 1
    }
    // First dep should be FLOW (store before load)
    if ctx.deps[0].direction != LOPT_DEP_FLOW {
        print("FAIL: test_lopt_dep_direction type\n")
        return 1
    }
    print("PASS: test_lopt_dep_direction\n")
    return 0
}

fn test_lopt_dep_direction() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    return test_lopt_dep_direction_inner(&! ctx)
}

