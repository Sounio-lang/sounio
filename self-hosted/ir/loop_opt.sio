    var ctx = lopt_make_nested_loop_ctx()
    let count = lopt_find_natural_loops(&! ctx)
    // Should find 2 loops: inner (3->2) and outer (4->1)
    if count != 2 {
        print("FAIL: test_lopt_nested_loops count\n")
        return 1
    }
    print("PASS: test_lopt_nested_loops\n")
    return 0
}

// T13: Loop tree construction
fn test_lopt_build_loop_tree_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let count = lopt_find_natural_loops(ctx)
    let max_depth = lopt_build_loop_tree(ctx)
    if max_depth < 2 {
        print("FAIL: test_lopt_build_loop_tree depth\n")
        return 1
    }
    print("PASS: test_lopt_build_loop_tree\n")
    return 0
}

fn test_lopt_build_loop_tree() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_nested_loop_ctx()
    return test_lopt_build_loop_tree_inner(&! ctx)
}

// T14: Loop nesting depths
fn test_lopt_nesting_depth_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let count = lopt_find_natural_loops(ctx)
    let max_depth = lopt_build_loop_tree(ctx)
    // One loop should be at depth 1, the other at depth 2
    var has_depth1 = false
    var has_depth2 = false
    var i: i64 = 0
    while i < count {
        if ctx.nest.loops[i as usize].depth == 1 {
            has_depth1 = true
        }
        if ctx.nest.loops[i as usize].depth == 2 {
            has_depth2 = true
        }
        i = i + 1
    }
    if has_depth1 == false || has_depth2 == false {
        print("FAIL: test_lopt_nesting_depth\n")
        return 1
    }
    print("PASS: test_lopt_nesting_depth\n")
    return 0
}

fn test_lopt_nesting_depth() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_nested_loop_ctx()
    return test_lopt_nesting_depth_inner(&! ctx)
}

