    let b0 = lopt_add_block(ctx, 0)
    let b1 = lopt_add_block(ctx, 1)
    let ok = lopt_add_edge(ctx, 0, 1)
    if ok == false {
        print("FAIL: test_lopt_add_edge ok\n")
