// T27: Side-effectful instructions are not invariant
fn test_lopt_side_effect_not_invariant_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let b0 = lopt_add_block(ctx, 0)
    let b1 = lopt_add_block(ctx, 1)
    let b2 = lopt_add_block(ctx, 2)
    let b3 = lopt_add_block(ctx, 3)
    let e1 = lopt_add_edge(ctx, 0, 1)
    let e2 = lopt_add_edge(ctx, 1, 2)
    let e3 = lopt_add_edge(ctx, 2, 1)
    let e4 = lopt_add_edge(ctx, 1, 3)
    let d1 = lopt_set_idom(ctx, 0, LOPT_INVALID)
    let d2 = lopt_set_idom(ctx, 1, 0)
    let d3 = lopt_set_idom(ctx, 2, 1)
    let d4 = lopt_set_idom(ctx, 3, 1)

    // Add a CALL instruction in the loop body — not hoistable
    let i0 = lopt_add_instr(ctx, 2, 8, 20, 10, LOPT_INVALID)

    let lcount = lopt_find_natural_loops(ctx)
    let found = lopt_find_invariants(ctx, 0)
    // Calls should not be marked invariant
    if found != 0 {
        print("FAIL: test_lopt_side_effect_not_invariant\n")
        return 1
    }
    print("PASS: test_lopt_side_effect_not_invariant\n")
    return 0
}

