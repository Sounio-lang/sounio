    return test_lopt_iv_properties_inner(&! ctx)
}

// T18: Trip count from bounds
fn test_lopt_trip_count_bounds() -> i32 with IO, Mut, Div, Panic {
    let tc1 = lopt_compute_trip_count_from_bounds(0, 10, 1)
    if tc1 != 10 {
        print("FAIL: test_lopt_trip_count_bounds 0..10 step 1\n")
        return 1
    }
    let tc2 = lopt_compute_trip_count_from_bounds(0, 20, 2)
    if tc2 != 10 {
        print("FAIL: test_lopt_trip_count_bounds 0..20 step 2\n")
        return 1
    }
    let tc3 = lopt_compute_trip_count_from_bounds(10, 0, 0 - 1)
    if tc3 != 10 {
        print("FAIL: test_lopt_trip_count_bounds 10..0 step -1\n")
        return 1
    }
    let tc4 = lopt_compute_trip_count_from_bounds(0, 0, 1)
    if tc4 != 0 {
        print("FAIL: test_lopt_trip_count_bounds 0..0\n")
        return 1
    }
    let tc5 = lopt_compute_trip_count_from_bounds(5, 3, 1)
    if tc5 != 0 {
        print("FAIL: test_lopt_trip_count_bounds 5..3 step 1\n")
        return 1
    }
    print("PASS: test_lopt_trip_count_bounds\n")
    return 0
}

// T19: Zero step returns invalid
fn test_lopt_trip_count_zero_step() -> i32 with IO, Mut, Div, Panic {
    let tc = lopt_compute_trip_count_from_bounds(0, 10, 0)
    if tc != LOPT_INVALID {
        print("FAIL: test_lopt_trip_count_zero_step\n")
        return 1
    }
    print("PASS: test_lopt_trip_count_zero_step\n")
    return 0
}

// T20: Loop classification — counted
fn test_lopt_classify_counted_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)
    let iv_count = lopt_find_induction_vars(ctx, 0)
    let tc = lopt_compute_trip_count(ctx, 0)

    let cls = lopt_classify_loop(ctx, 0)
    // If trip count was computed, should be COUNTED
    if tc != LOPT_INVALID {
        if cls != LOPT_CLASS_COUNTED {
            print("FAIL: test_lopt_classify_counted\n")
            return 1
        }
    }
    print("PASS: test_lopt_classify_counted\n")
    return 0
}

fn test_lopt_classify_counted() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_counted_loop_ctx()
    return test_lopt_classify_counted_inner(&! ctx)
}

// T21: Loop classification — while loop
fn test_lopt_classify_while_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)
    // No IVs, so trip count unknown. Header is an exit.
    let cls = lopt_classify_loop(ctx, 0)
    // With header as exit and no trip count, should be WHILE
    if cls != LOPT_CLASS_WHILE {
        print("FAIL: test_lopt_classify_while\n")
        return 1
    }
    print("PASS: test_lopt_classify_while\n")
    return 0
}

