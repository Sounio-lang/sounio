    let d3 = lopt_set_idom(ctx, 2, 1)

    let count = lopt_find_natural_loops(ctx)
    if count != 0 {
        print("FAIL: test_lopt_no_loops\n")
        return 1
    }
    print("PASS: test_lopt_no_loops\n")
    return 0
}

