// T36: Loop fusion — cannot fuse with different trip counts
fn test_lopt_cannot_fuse_diff_trips() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_context_new()
    // Create two loops manually
    var lp_a = lopt_loop_new()
    lp_a.id = 0
    lp_a.header = 1
    lp_a.is_counted = true
    lp_a.trip_count = 10
    lp_a.depth = 1
    lp_a.parent_id = LOPT_INVALID

    var lp_b = lopt_loop_new()
    lp_b.id = 1
    lp_b.header = 3
    lp_b.is_counted = true
    lp_b.trip_count = 20
    lp_b.depth = 1
    lp_b.parent_id = LOPT_INVALID

    ctx.nest.loops[0] = lp_a
    ctx.nest.loops[1] = lp_b
    ctx.nest.loop_count = 2

    let can = lopt_can_fuse(&! ctx, 0, 1)
    if can {
        print("FAIL: test_lopt_cannot_fuse_diff_trips\n")
        return 1
    }
    print("PASS: test_lopt_cannot_fuse_diff_trips\n")
    return 0
}

