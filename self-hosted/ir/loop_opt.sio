// T05: Dominance check — self-dominance
fn test_lopt_dominates_self() -> i32 with IO, Mut, Div, Panic {
    var idom: [i64; 512] = [LOPT_INVALID; 512]
    idom[0] = LOPT_INVALID
    let r = lopt_dominates(idom, 0, 0)
    if r == false {
        print("FAIL: test_lopt_dominates_self\n")
        return 1
    }
    print("PASS: test_lopt_dominates_self\n")
    return 0
}

// T06: Dominance check — chain
fn test_lopt_dominates_chain() -> i32 with IO, Mut, Div, Panic {
    var idom: [i64; 512] = [LOPT_INVALID; 512]
    idom[1] = 0
    idom[2] = 1
    idom[3] = 2
    let r = lopt_dominates(idom, 0, 3)
    if r == false {
        print("FAIL: test_lopt_dominates_chain\n")
        return 1
    }
    // 3 does not dominate 0
    let r2 = lopt_dominates(idom, 3, 0)
    if r2 {
        print("FAIL: test_lopt_dominates_chain reverse\n")
        return 1
    }
    print("PASS: test_lopt_dominates_chain\n")
    return 0
}

// T07: Back edge detection on simple loop
fn test_lopt_find_back_edges_simple() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    let count = lopt_find_back_edges(&! ctx)
    if count != 1 {
        print("FAIL: test_lopt_find_back_edges_simple count\n")
        return 1
    }
    // Back edge should be 2->1 (latch->header)
    if ctx.nest.back_edges[0].tail_block != 2 {
        print("FAIL: test_lopt_find_back_edges_simple tail\n")
        return 1
    }
    if ctx.nest.back_edges[0].header_block != 1 {
        print("FAIL: test_lopt_find_back_edges_simple header\n")
        return 1
    }
    print("PASS: test_lopt_find_back_edges_simple\n")
    return 0
}

// T08: Loop body computation
fn test_lopt_compute_loop_body() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    var body: [i64; 128] = [LOPT_INVALID; 128]
    let count = lopt_compute_loop_body(&! ctx, 1, 2, &! body)
    // Loop body should contain blocks 1 and 2
    if count != 2 {
