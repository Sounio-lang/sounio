    var passed: i64 = 0
    let total: i64 = 70

    print("=== Constant Folding & Propagation Tests ===\n")

    if test_cf_value_unknown_not_const() { passed = passed + 1; print("  T01 OK value_unknown_not_const\n") } else { print("  FAIL T01 value_unknown_not_const\n") }
    if test_cf_value_int_const() { passed = passed + 1; print("  T02 OK value_int_const\n") } else { print("  FAIL T02 value_int_const\n") }
