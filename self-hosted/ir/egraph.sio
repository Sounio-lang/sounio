fn test_eg_quantize_unc_basic() -> bool {
    let result = eg_quantize_unc(2.5)
    result == 2500000000
}

fn test_eg_isqrt_basic() -> bool {
    let result = eg_isqrt(25000000000)
    // sqrt(2.5e10) = 158113.883...
    result >= 158113 && result <= 158114
}

fn test_eg_isqrt_zero() -> bool {
    eg_isqrt(0) == 0
}

fn test_eg_isqrt_one() -> bool {
    eg_isqrt(1) == 1
}

fn test_eg_small_add_var_with_unc_basic() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    let node_idx = eg_small_add_var_with_unc(&! ctx, 0, 1000000000)
    node_idx == 0 && ctx.unc_lo[0] == 1000000000
}

fn test_eg_small_extract_epistemic_basic_inner(ctx: &! EgSmallContext) -> bool with Mut, Div, Panic {
    let const1 = eg_small_add_const(ctx, 1)
    let _var1 = eg_small_add_var_with_unc(ctx, 0, 2000000000)
    ctx.unc_lo[const1 as usize] = 0
    let extracted = eg_small_extract_epistemic(ctx, const1)
    extracted.op == EG_OP_CONST
}
fn test_eg_small_extract_epistemic_basic() -> bool with Mut, Div, Panic {
    // lower uncertainty wins: CONST (0 unc) wins over VAR (2e9 unc)
    var ctx = eg_small_init()
    return test_eg_small_extract_epistemic_basic_inner(&! ctx)
}

