fn test_eg_commutativity_add_inner(ctx: &! EgContext) -> bool with Mut, Div, Panic {
    let a = eg_ctx_add_var(ctx, 0)
    let b = eg_ctx_add_var(ctx, 1)
    let ab = eg_ctx_add_binop(ctx, EG_OP_ADD, a, b)
    let ba = eg_ctx_add_binop(ctx, EG_OP_ADD, b, a)
    let before = eg_ctx_are_equivalent(ctx, ab, ba) == false
    let rule = eg_rule_add_commute()
    let idx = eg_ctx_add_rule(ctx, rule)
    let batch = eg_ctx_match_all_rules(ctx)
    let applied = eg_ctx_apply_all_matches(ctx, &batch)
    let rebuilt = eg_ctx_rebuild(ctx)
    let after = eg_ctx_are_equivalent(ctx, ab, ba)
    before && after
}
