    let d = eg_uf_make_set(uf)
    let r1 = eg_union(uf, a, b)
    let r2 = eg_union(uf, c, d)
    let ab_same = eg_same_set(uf, a, b)
    let cd_same = eg_same_set(uf, c, d)
    let ac_diff = eg_same_set(uf, a, c) == false
    ab_same && cd_same && ac_diff
}
