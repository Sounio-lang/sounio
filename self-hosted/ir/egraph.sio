    return test_eg_small_union_basic_inner(&! ctx)
}

fn test_eg_small_sat_add_identity_inner(ctx: &! EgSmallContext) -> bool with Mut, Div, Panic {
    let zero = eg_small_add_const(ctx, 0)
    let x    = eg_small_add_var(ctx, 1)
    let root = eg_small_add_binop(ctx, EG_OP_ADD, x, zero)
    eg_small_saturate(ctx)
    let extracted = eg_small_extract(ctx, root)
    extracted.op == EG_OP_VAR
}
fn test_eg_small_sat_add_identity() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    return test_eg_small_sat_add_identity_inner(&! ctx)
}

fn test_eg_small_sat_mul_identity_inner(ctx: &! EgSmallContext) -> bool with Mut, Div, Panic {
    let one  = eg_small_add_const(ctx, 1)
    let x    = eg_small_add_var(ctx, 2)
    let root = eg_small_add_binop(ctx, EG_OP_MUL, x, one)
    eg_small_saturate(ctx)
    let extracted = eg_small_extract(ctx, root)
    extracted.op == EG_OP_VAR
}
fn test_eg_small_sat_mul_identity() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    return test_eg_small_sat_mul_identity_inner(&! ctx)
}

fn test_eg_small_sat_sub_self_inner(ctx: &! EgSmallContext) -> bool with Mut, Div, Panic {
    let x    = eg_small_add_var(ctx, 3)
    let root = eg_small_add_binop(ctx, EG_OP_SUB, x, x)
    eg_small_saturate(ctx)
    let extracted = eg_small_extract(ctx, root)
    extracted.op == EG_OP_CONST && extracted.value == 0
}
fn test_eg_small_sat_sub_self() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    return test_eg_small_sat_sub_self_inner(&! ctx)
}

