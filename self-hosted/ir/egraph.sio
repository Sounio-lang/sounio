// self-hosted::ir::egraph — E-Graph Equality Saturation Optimizer
//
// An e-graph (equivalence graph) implementation for the Sounio self-hosted
// compiler.  E-graphs compactly represent many equivalent expressions
// simultaneously, enabling powerful rewrite-based optimization via
// equality saturation:
//
//   1. Build an initial e-graph from the input expression.
//   2. Repeatedly apply rewrite rules, merging e-classes when two
//      expressions are proven equivalent.
//   3. Use hashconsing to deduplicate e-nodes, and a union-find to
//      track which e-classes have been merged.
//   4. Rebuild the hash table after merges to restore the congruence
//      invariant.
//   5. Extract the cheapest equivalent expression via bottom-up
//      cost analysis.
//
// All arrays are fixed-size -- no heap allocation.
//
// References:
//   Willsey et al.: "egg: Fast and Extensible Equality Saturation" (2021)
//   Nelson & Oppen: "Fast Decision Procedures Based on Congruence
//                    Closure" (1980)
//   Tate et al.: "Equality Saturation: A New Approach to Optimization" (2009)

module ir::egraph

// ============================================================================
// Section 1: Constants
// ============================================================================

let EG_MAX_NODES: i64 = 16384
let EG_MAX_CLASSES: i64 = 8192
let EG_MAX_RULES: i64 = 256
let EG_MAX_CHILDREN: i64 = 4
let EG_MAX_CLASS_NODES: i64 = 32
let EG_MAX_ITERATIONS: i64 = 30
let EG_INVALID: i64 = 0 - 1

// Opcode constants
let EG_OP_CONST: i64 = 1
let EG_OP_VAR: i64 = 2
let EG_OP_ADD: i64 = 3
let EG_OP_SUB: i64 = 4
let EG_OP_MUL: i64 = 5
let EG_OP_DIV: i64 = 6
let EG_OP_NEG: i64 = 7
let EG_OP_FADD: i64 = 8
let EG_OP_FSUB: i64 = 9
let EG_OP_FMUL: i64 = 10
let EG_OP_FDIV: i64 = 11
let EG_OP_FNEG: i64 = 12
let EG_OP_MEASURE: i64 = 13
let EG_OP_COMBINE: i64 = 14

// Cost model constants
let EG_COST_CONST: i64 = 1
let EG_COST_VAR: i64 = 1
let EG_COST_OP: i64 = 2

// Hash table constants
let EG_HASH_EMPTY: i64 = 0 - 1
let EG_HASH_PRIME: i64 = 16381

// ============================================================================
// Section 2: Data Structures
// ============================================================================

pub struct EgNode {
    pub op: i64,
    pub children: [i64; 4],
    pub child_count: i64,
    pub value: i64,
    pub eclass_id: i64,
}

struct EgClass {
    class_id: i64,
    nodes: [i64; 32],
    node_count: i64,
    canonical: i64,
    cost: i64,
}

struct EgUnionFind {
    parent: [i64; 8192],
    rank: [i64; 8192],
    size: i64,
}

pub struct EgRule {
    lhs_op: i64,
    lhs_children: [i64; 4],
    rhs_op: i64,
    rhs_children: [i64; 4],
    lhs_child_count: i64,
    rhs_child_count: i64,
    name_hash: i64,
    is_commutative: bool,
}

struct EgRuleSet {
    rules: [EgRule; 256],
    rule_count: i64,
}

struct EgGraph {
    nodes: [EgNode; 16384],
    node_count: i64,
    classes: [EgClass; 8192],
    class_count: i64,
    union_find: EgUnionFind,
    hash_table: [i64; 16384],
}

struct EgExtractor {
    costs: [i64; 8192],
    best_node: [i64; 8192],
}

struct EgStats {
    iterations: i64,
    nodes_added: i64,
    merges: i64,
    rules_applied: i64,
    saturated: bool,
}

struct EgContext {
    graph: EgGraph,
    rules: EgRuleSet,
    extractor: EgExtractor,
    iteration_count: i64,
    stats: EgStats,
}

pub struct EgMatch {
    matched_class: i64,
    matched_node: i64,
    bindings: [i64; 4],
    binding_count: i64,
    valid: bool,
}

struct EgMatchBatch {
    matches: [EgMatch; 512],
    match_count: i64,
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn eg_node_new() -> EgNode {
    EgNode {
        op: 0,
        children: [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        child_count: 0,
        value: 0,
        eclass_id: EG_INVALID,
    }
}

fn eg_class_new() -> EgClass {
    EgClass {
        class_id: EG_INVALID,
        nodes: [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID,
                EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        node_count: 0,
        canonical: EG_INVALID,
        cost: 999999,
    }
}

fn eg_union_find_new() -> EgUnionFind {
    var out: EgUnionFind
    out.size = 0
    out
}

fn eg_rule_new() -> EgRule {
    EgRule {
        lhs_op: 0,
        lhs_children: [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        rhs_op: 0,
        rhs_children: [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        lhs_child_count: 0,
        rhs_child_count: 0,
        name_hash: 0,
        is_commutative: false,
    }
}

fn eg_rule_set_new() -> EgRuleSet {
    var out: EgRuleSet
    out.rule_count = 0
    out
}

fn eg_graph_new() -> EgGraph {
    var out: EgGraph
    out.node_count = 0
    out.class_count = 0
    out.union_find = eg_union_find_new()
    var i: i64 = 0
    while i < EG_MAX_NODES {
        out.hash_table[i as usize] = EG_HASH_EMPTY
        i = i + 1
    }
    out
}

fn eg_extractor_new() -> EgExtractor {
    var out: EgExtractor
    out
}

fn eg_stats_new() -> EgStats {
    EgStats {
        iterations: 0,
        nodes_added: 0,
        merges: 0,
        rules_applied: 0,
        saturated: false,
    }
}

fn eg_match_new() -> EgMatch {
    EgMatch {
        matched_class: EG_INVALID,
        matched_node: EG_INVALID,
        bindings: [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        binding_count: 0,
        valid: false,
    }
}

fn eg_match_batch_new() -> EgMatchBatch {
    var out: EgMatchBatch
    out.match_count = 0
    out
}

fn eg_context_new() -> EgContext {
    EgContext {
        graph: eg_graph_new(),
        rules: eg_rule_set_new(),
        extractor: eg_extractor_new(),
        iteration_count: 0,
        stats: eg_stats_new(),
    }
}

// ============================================================================
// Section 4: Union-Find Operations
// ============================================================================

fn eg_find(uf: &! EgUnionFind, x: i64) -> i64 with Mut, Div, Panic {
    if x < 0 || x >= EG_MAX_CLASSES {
        return x
    }
    var root = x
    while uf.parent[root as usize] != root {
        root = uf.parent[root as usize]
    }
    var cur = x
    while cur != root {
        let next = uf.parent[cur as usize]
        uf.parent[cur as usize] = root
        cur = next
    }
    root
}

fn eg_uf_make_set(uf: &! EgUnionFind) -> i64 with Mut, Div, Panic {
    let id = uf.size
    if id >= EG_MAX_CLASSES {
        return EG_INVALID
    }
    uf.parent[id as usize] = id
    uf.rank[id as usize] = 0
    uf.size = uf.size + 1
    id
}

fn eg_union(uf: &! EgUnionFind, a: i64, b: i64) -> i64 with Mut, Div, Panic {
    let ra = eg_find(uf, a)
    let rb = eg_find(uf, b)
    if ra == rb {
        return ra
    }
    let rank_a = uf.rank[ra as usize]
    let rank_b = uf.rank[rb as usize]
    if rank_a < rank_b {
        uf.parent[ra as usize] = rb
        return rb
    } else if rank_a > rank_b {
        uf.parent[rb as usize] = ra
        return ra
    } else {
        uf.parent[rb as usize] = ra
        uf.rank[ra as usize] = rank_a + 1
        return ra
    }
}

fn eg_same_set(uf: &! EgUnionFind, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let ra = eg_find(uf, a)
    let rb = eg_find(uf, b)
    ra == rb
}

// Graph-level union-find wrappers (avoid sub-borrowing graph.union_find)
fn eg_graph_find(graph: &! EgGraph, x: i64) -> i64 with Mut, Div, Panic {
    eg_find(&! graph.union_find, x)
}

fn eg_graph_union(graph: &! EgGraph, a: i64, b: i64) -> i64 with Mut, Div, Panic {
    eg_union(&! graph.union_find, a, b)
}

fn eg_graph_same_set(graph: &! EgGraph, a: i64, b: i64) -> bool with Mut, Div, Panic {
    eg_same_set(&! graph.union_find, a, b)
}

fn eg_graph_make_set(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    eg_uf_make_set(&! graph.union_find)
}

// ============================================================================
// Section 5: Hashing
// ============================================================================

pub(crate) fn eg_hash_node(op: i64, children: [i64; 4], child_count: i64) -> i64 with Mut, Div, Panic {
    var h: i64 = op * 2654435761
    var i: i64 = 0
    while i < child_count {
        let c = children[i as usize]
        h = h * 31 + c * 2654435761
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    h % EG_MAX_NODES
}

fn eg_hashcons_lookup(graph: &EgGraph, op: i64, children: [i64; 4], child_count: i64) -> i64 with Mut, Div, Panic {
    let h = eg_hash_node(op, children, child_count)
    var idx = h
    var probes: i64 = 0
    while probes < EG_MAX_NODES {
        let slot = graph.hash_table[idx as usize]
        if slot == EG_HASH_EMPTY {
            return EG_HASH_EMPTY
        }
        if slot >= 0 && slot < graph.node_count {
            let node = graph.nodes[slot as usize]
            if node.op == op && node.child_count == child_count {
                var match_ok = true
                var j: i64 = 0
                while j < child_count {
                    if node.children[j as usize] != children[j as usize] {
                        match_ok = false
                    }
                    j = j + 1
                }
                if match_ok {
                    return slot
                }
            }
        }
        idx = (idx + 1) % EG_MAX_NODES
        probes = probes + 1
    }
    EG_HASH_EMPTY
}

fn eg_hashcons_insert(graph: &! EgGraph, node_idx: i64) -> bool with Mut, Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count {
        return false
    }
    let node = graph.nodes[node_idx as usize]
    let h = eg_hash_node(node.op, node.children, node.child_count)
    var idx = h
    var probes: i64 = 0
    while probes < EG_MAX_NODES {
        let slot = graph.hash_table[idx as usize]
        if slot == EG_HASH_EMPTY {
            graph.hash_table[idx as usize] = node_idx
            return true
        }
        idx = (idx + 1) % EG_MAX_NODES
        probes = probes + 1
    }
    false
}

fn eg_rebuild_hash_table(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < EG_MAX_NODES {
        graph.hash_table[i as usize] = EG_HASH_EMPTY
        i = i + 1
    }
    var inserted: i64 = 0
    i = 0
    while i < graph.node_count {
        if graph.nodes[i as usize].eclass_id != EG_INVALID {
            var j: i64 = 0
            while j < graph.nodes[i as usize].child_count {
                let child = graph.nodes[i as usize].children[j as usize]
                if child != EG_INVALID {
                    let canonical_child = eg_graph_find(graph, child)
                    graph.nodes[i as usize].children[j as usize] = canonical_child
                }
                j = j + 1
            }
            let ok = eg_hashcons_insert(graph, i)
            if ok {
                inserted = inserted + 1
            }
        }
        i = i + 1
    }
    inserted
}

// ============================================================================
// Section 6: E-Graph Core Operations
// ============================================================================

fn eg_new_class(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    let id = graph.class_count
    if id >= EG_MAX_CLASSES {
        return EG_INVALID
    }
    let uf_id = eg_graph_make_set(graph)
    graph.classes[id as usize].class_id = id
    graph.classes[id as usize].node_count = 0
    graph.classes[id as usize].canonical = EG_INVALID
    graph.classes[id as usize].cost = 999999
    graph.class_count = graph.class_count + 1
    id
}

fn eg_add_node(graph: &! EgGraph, op: i64, children: [i64; 4], child_count: i64, value: i64) -> i64 with Mut, Div, Panic {
    var canon_children: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    var i: i64 = 0
    while i < child_count {
        canon_children[i as usize] = eg_graph_find(graph, children[i as usize])
        i = i + 1
    }

    let existing = eg_hashcons_lookup(graph, op, canon_children, child_count)
    if existing != EG_HASH_EMPTY {
        return graph.nodes[existing as usize].eclass_id
    }

    let node_idx = graph.node_count
    if node_idx >= EG_MAX_NODES {
        return EG_INVALID
    }
    graph.nodes[node_idx as usize].op = op
    graph.nodes[node_idx as usize].children = canon_children
    graph.nodes[node_idx as usize].child_count = child_count
    graph.nodes[node_idx as usize].value = value

    let class_id = eg_new_class(graph)
    if class_id == EG_INVALID {
        return EG_INVALID
    }
    graph.nodes[node_idx as usize].eclass_id = class_id
    graph.node_count = graph.node_count + 1

    let nc = graph.classes[class_id as usize].node_count
    if nc < EG_MAX_CLASS_NODES {
        graph.classes[class_id as usize].nodes[nc as usize] = node_idx
        graph.classes[class_id as usize].node_count = nc + 1
    }
    graph.classes[class_id as usize].canonical = node_idx

    let ok = eg_hashcons_insert(graph, node_idx)

    class_id
}

fn eg_add_const(graph: &! EgGraph, value: i64) -> i64 with Mut, Div, Panic {
    let no_children: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    eg_add_node(graph, EG_OP_CONST, no_children, 0, value)
}

fn eg_add_var(graph: &! EgGraph, var_id: i64) -> i64 with Mut, Div, Panic {
    let no_children: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    eg_add_node(graph, EG_OP_VAR, no_children, 0, var_id)
}

fn eg_add_binop(graph: &! EgGraph, op: i64, lhs: i64, rhs: i64) -> i64 with Mut, Div, Panic {
    let children: [i64; 4] = [lhs, rhs, EG_INVALID, EG_INVALID]
    eg_add_node(graph, op, children, 2, 0)
}

fn eg_add_unop(graph: &! EgGraph, op: i64, child: i64) -> i64 with Mut, Div, Panic {
    let children: [i64; 4] = [child, EG_INVALID, EG_INVALID, EG_INVALID]
    eg_add_node(graph, op, children, 1, 0)
}

// ============================================================================
// Section 7: E-Class Merging
// ============================================================================

fn eg_merge(graph: &! EgGraph, a: i64, b: i64) -> i64 with Mut, Div, Panic {
    let ca = eg_graph_find(graph, a)
    let cb = eg_graph_find(graph, b)
    if ca == cb {
        return ca
    }

    let new_root = eg_graph_union(graph, ca, cb)

    let absorbed = if new_root == ca { cb } else { ca }

    var i: i64 = 0
    while i < graph.classes[absorbed as usize].node_count {
        let nidx = graph.classes[absorbed as usize].nodes[i as usize]
        if nidx != EG_INVALID {
            graph.nodes[nidx as usize].eclass_id = new_root
            let nc = graph.classes[new_root as usize].node_count
            if nc < EG_MAX_CLASS_NODES {
                graph.classes[new_root as usize].nodes[nc as usize] = nidx
                graph.classes[new_root as usize].node_count = nc + 1
            }
        }
        i = i + 1
    }

    graph.classes[absorbed as usize].node_count = 0

    let cost_a = graph.classes[ca as usize].cost
    let cost_b = graph.classes[cb as usize].cost
    if cost_a < cost_b {
        graph.classes[new_root as usize].cost = cost_a
    } else {
        graph.classes[new_root as usize].cost = cost_b
    }

    new_root
}

fn eg_rebuild(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < graph.node_count {
        let old_class = graph.nodes[i as usize].eclass_id
        if old_class != EG_INVALID {
            let new_class = eg_graph_find(graph, old_class)
            graph.nodes[i as usize].eclass_id = new_class
        }
        var j: i64 = 0
        while j < graph.nodes[i as usize].child_count {
            let child = graph.nodes[i as usize].children[j as usize]
            if child != EG_INVALID {
                let canon = eg_graph_find(graph, child)
                graph.nodes[i as usize].children[j as usize] = canon
            }
            j = j + 1
        }
        i = i + 1
    }

    let inserted = eg_rebuild_hash_table(graph)
    inserted
}

fn eg_canonical_class(graph: &! EgGraph, class_id: i64) -> i64 with Mut, Div, Panic {
    eg_graph_find(graph, class_id)
}

fn eg_class_size(graph: &EgGraph, class_id: i64) -> i64 with Div, Panic {
    if class_id < 0 || class_id >= graph.class_count {
        return 0
    }
    graph.classes[class_id as usize].node_count
}

// ============================================================================
// Section 8: Rule Construction
// ============================================================================

fn eg_make_rule(lhs_op: i64, lhs_children: [i64; 4], lhs_child_count: i64,
                rhs_op: i64, rhs_children: [i64; 4], rhs_child_count: i64,
                name_hash: i64, is_commutative: bool) -> EgRule {
    EgRule {
        lhs_op: lhs_op,
        lhs_children: lhs_children,
        rhs_op: rhs_op,
        rhs_children: rhs_children,
        lhs_child_count: lhs_child_count,
        rhs_child_count: rhs_child_count,
        name_hash: name_hash,
        is_commutative: is_commutative,
    }
}

fn eg_add_rule(rules: &! EgRuleSet, rule: EgRule) -> i64 with Mut, Div, Panic {
    let idx = rules.rule_count
    if idx >= EG_MAX_RULES {
        return EG_INVALID
    }
    rules.rules[idx as usize] = rule
    rules.rule_count = idx + 1
    idx
}

let EG_PAT_VAR_A: i64 = 0 - 1
let EG_PAT_VAR_B: i64 = 0 - 2
let EG_PAT_VAR_C: i64 = 0 - 3
let EG_PAT_VAR_D: i64 = 0 - 4

fn eg_resolve_pat(pat_child: i64, bindings: [i64; 4]) -> i64 with Div, Panic {
    if pat_child == EG_PAT_VAR_A { return bindings[0 as usize] }
    if pat_child == EG_PAT_VAR_B { return bindings[1 as usize] }
    if pat_child == EG_PAT_VAR_C { return bindings[2 as usize] }
    if pat_child == EG_PAT_VAR_D { return bindings[3 as usize] }
    pat_child
}

// ============================================================================
// Section 9: Rule Matching
// ============================================================================

fn eg_match_rule_node(graph: &! EgGraph, rule: &EgRule, node_idx: i64) -> EgMatch with Mut, Div, Panic {
    var result = eg_match_new()
    if node_idx < 0 || node_idx >= graph.node_count {
        return result
    }
    let node = graph.nodes[node_idx as usize]

    if node.op != rule.lhs_op { return result }
    if node.child_count != rule.lhs_child_count { return result }

    var bindings: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    var binding_idx: i64 = 0
    var j: i64 = 0
    var ok = true
    while j < rule.lhs_child_count {
        let pat = rule.lhs_children[j as usize]
        let actual = eg_graph_find(graph, node.children[j as usize])
        if pat < 0 {
            let slot = 0 - pat - 1
            if slot >= 0 && slot < 4 {
                bindings[slot as usize] = actual
                if slot >= binding_idx {
                    binding_idx = slot + 1
                }
            }
        } else {
            let canon_pat = eg_graph_find(graph, pat)
            if canon_pat != actual {
                ok = false
            }
        }
        j = j + 1
    }
    if ok == false { return result }

    result.matched_class = node.eclass_id
    result.matched_node = node_idx
    result.bindings = bindings
    result.binding_count = binding_idx
    result.valid = true
    result
}

fn eg_match_all_rules(graph: &! EgGraph, rules: &EgRuleSet) -> EgMatchBatch with Mut, Div, Panic {
    var batch = eg_match_batch_new()
    var r: i64 = 0
    while r < rules.rule_count {
        var n: i64 = 0
        while n < graph.node_count {
            if graph.nodes[n as usize].eclass_id != EG_INVALID {
                let m = eg_match_rule_node(graph, &rules.rules[r as usize], n)
                if m.valid {
                    if batch.match_count < 512 {
                        var stored = m
                        stored.matched_node = r
                        batch.matches[batch.match_count as usize] = stored
                        batch.match_count = batch.match_count + 1
                    }
                }
                if rules.rules[r as usize].is_commutative {
                    if graph.nodes[n as usize].child_count == 2 {
                        let orig_c0 = graph.nodes[n as usize].children[0 as usize]
                        let orig_c1 = graph.nodes[n as usize].children[1 as usize]
                        graph.nodes[n as usize].children[0 as usize] = orig_c1
                        graph.nodes[n as usize].children[1 as usize] = orig_c0
                        let m2 = eg_match_rule_node(graph, &rules.rules[r as usize], n)
                        graph.nodes[n as usize].children[0 as usize] = orig_c0
                        graph.nodes[n as usize].children[1 as usize] = orig_c1
                        if m2.valid {
                            if batch.match_count < 512 {
                                var stored2 = m2
                                stored2.matched_node = r
                                stored2.matched_class = graph.nodes[n as usize].eclass_id
                                batch.matches[batch.match_count as usize] = stored2
                                batch.match_count = batch.match_count + 1
                            }
                        }
                    }
                }
            }
            n = n + 1
        }
        r = r + 1
    }
    batch
}

// ============================================================================
// Section 10: Rule Application
// ============================================================================

fn eg_apply_match(graph: &! EgGraph, rules: &EgRuleSet, m: &EgMatch) -> i64 with Mut, Div, Panic {
    if m.valid == false { return EG_INVALID }
    let rule_idx = m.matched_node
    if rule_idx < 0 || rule_idx >= rules.rule_count { return EG_INVALID }
    let rule = rules.rules[rule_idx as usize]

    var rhs_children: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    var i: i64 = 0
    while i < rule.rhs_child_count {
        rhs_children[i as usize] = eg_resolve_pat(rule.rhs_children[i as usize], m.bindings)
        i = i + 1
    }

    let rhs_class = eg_add_node(graph, rule.rhs_op, rhs_children, rule.rhs_child_count, 0)
    if rhs_class == EG_INVALID { return EG_INVALID }

    let merged_class = eg_graph_find(graph, m.matched_class)
    let result = eg_merge(graph, merged_class, rhs_class)
    result
}

fn eg_apply_all_matches(graph: &! EgGraph, rules: &EgRuleSet, batch: &EgMatchBatch) -> i64 with Mut, Div, Panic {
    var applied: i64 = 0
    var i: i64 = 0
    while i < batch.match_count {
        let result = eg_apply_match(graph, rules, &batch.matches[i as usize])
        if result != EG_INVALID {
            applied = applied + 1
        }
        i = i + 1
    }
    applied
}

// ============================================================================
// Section 11: Equality Saturation
// ============================================================================

fn eg_saturate_step_inner(graph: &! EgGraph, rules: &EgRuleSet) -> i64 with Mut, Div, Panic {
    let batch = eg_match_all_rules(graph, rules)
    let applied = eg_apply_all_matches(graph, rules, &batch)
    let rebuilt = eg_rebuild(graph)
    applied
}

fn eg_saturate_step(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    let applied = eg_saturate_step_inner(&! ctx.graph, &ctx.rules)
    ctx.stats.rules_applied = ctx.stats.rules_applied + applied
    ctx.stats.nodes_added = ctx.graph.node_count
    applied
}

fn eg_saturate(ctx: &! EgContext) -> EgStats with Mut, Div, Panic {
    var iter: i64 = 0
    while iter < EG_MAX_ITERATIONS {
        let old_node_count = ctx.graph.node_count
        let old_class_count = ctx.graph.class_count

        let applied = eg_saturate_step(ctx)

        ctx.stats.iterations = iter + 1
        ctx.iteration_count = iter + 1

        if applied == 0 {
            ctx.stats.saturated = true
            return ctx.stats
        }
        if ctx.graph.node_count == old_node_count && ctx.graph.class_count == old_class_count {
            ctx.stats.saturated = true
            return ctx.stats
        }

        iter = iter + 1
    }
    ctx.stats
}

// ============================================================================
// Section 12: Cost-Based Extraction
// ============================================================================

fn eg_node_cost(graph: &EgGraph, extractor: &EgExtractor, node_idx: i64) -> i64 with Mut, Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count { return 999999 }
    let node = graph.nodes[node_idx as usize]
    var base_cost: i64 = EG_COST_OP
    if node.op == EG_OP_CONST { base_cost = EG_COST_CONST }
    else if node.op == EG_OP_VAR { base_cost = EG_COST_VAR }
    var total = base_cost
    var i: i64 = 0
    while i < node.child_count {
        let child_class = node.children[i as usize]
        if child_class >= 0 && child_class < EG_MAX_CLASSES {
            let child_cost = extractor.costs[child_class as usize]
            total = total + child_cost
        } else {
            total = total + 999999
        }
        i = i + 1
    }
    total
}

fn eg_extract(graph: &! EgGraph, extractor: &! EgExtractor) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < EG_MAX_CLASSES {
        extractor.costs[i as usize] = 999999
        extractor.best_node[i as usize] = EG_INVALID
        i = i + 1
    }

    var changed = true
    var pass: i64 = 0
    while changed && pass < 100 {
        changed = false
        i = 0
        while i < graph.node_count {
            let node = graph.nodes[i as usize]
            if node.eclass_id != EG_INVALID {
                let class_id = eg_graph_find(graph, node.eclass_id)
                let cost = eg_node_cost(graph, extractor, i)
                if cost < extractor.costs[class_id as usize] {
                    extractor.costs[class_id as usize] = cost
                    extractor.best_node[class_id as usize] = i
                    changed = true
                }
            }
            i = i + 1
        }
        pass = pass + 1
    }
    pass
}

fn eg_best_node_for_class(graph: &! EgGraph, extractor: &EgExtractor, class_id: i64) -> i64 with Mut, Div, Panic {
    let canon = eg_graph_find(graph, class_id)
    if canon >= 0 && canon < EG_MAX_CLASSES {
        return extractor.best_node[canon as usize]
    }
    EG_INVALID
}

fn eg_best_cost_for_class(graph: &! EgGraph, extractor: &EgExtractor, class_id: i64) -> i64 with Mut, Div, Panic {
    let canon = eg_graph_find(graph, class_id)
    if canon >= 0 && canon < EG_MAX_CLASSES {
        return extractor.costs[canon as usize]
    }
    999999
}

// ============================================================================
// Section 13: Built-In Algebraic Rules
// ============================================================================

pub(crate) fn eg_rule_add_commute() -> EgRule {
    let lhs_ch: [i64; 4] = [EG_PAT_VAR_A, EG_PAT_VAR_B, EG_INVALID, EG_INVALID]
    let rhs_ch: [i64; 4] = [EG_PAT_VAR_B, EG_PAT_VAR_A, EG_INVALID, EG_INVALID]
    eg_make_rule(EG_OP_ADD, lhs_ch, 2, EG_OP_ADD, rhs_ch, 2, 101, false)
}

pub(crate) fn eg_rule_mul_commute() -> EgRule {
    let lhs_ch: [i64; 4] = [EG_PAT_VAR_A, EG_PAT_VAR_B, EG_INVALID, EG_INVALID]
    let rhs_ch: [i64; 4] = [EG_PAT_VAR_B, EG_PAT_VAR_A, EG_INVALID, EG_INVALID]
    eg_make_rule(EG_OP_MUL, lhs_ch, 2, EG_OP_MUL, rhs_ch, 2, 102, false)
}

fn eg_class_has_const(graph: &! EgGraph, class_id: i64, value: i64) -> bool with Mut, Div, Panic {
    let canon = eg_graph_find(graph, class_id)
    if canon < 0 || canon >= graph.class_count { return false }
    var i: i64 = 0
    while i < graph.classes[canon as usize].node_count {
        let nidx = graph.classes[canon as usize].nodes[i as usize]
        if nidx >= 0 && nidx < graph.node_count {
            let node = graph.nodes[nidx as usize]
            if node.op == EG_OP_CONST && node.value == value { return true }
        }
        i = i + 1
    }
    false
}

fn eg_apply_add_identity(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_ADD && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let c0 = eg_graph_find(graph, node.children[0 as usize])
            let c1 = eg_graph_find(graph, node.children[1 as usize])
            if eg_class_has_const(graph, c1, 0) {
                let result_class = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class, c0) == false {
                    let m = eg_merge(graph, result_class, c0)
                    merges = merges + 1
                }
            }
            if eg_class_has_const(graph, c0, 0) {
                let result_class2 = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class2, c1) == false {
                    let m2 = eg_merge(graph, result_class2, c1)
                    merges = merges + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_mul_identity(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_MUL && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let c0 = eg_graph_find(graph, node.children[0 as usize])
            let c1 = eg_graph_find(graph, node.children[1 as usize])
            if eg_class_has_const(graph, c1, 1) {
                let result_class = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class, c0) == false {
                    let m = eg_merge(graph, result_class, c0)
                    merges = merges + 1
                }
            }
            if eg_class_has_const(graph, c0, 1) {
                let result_class2 = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class2, c1) == false {
                    let m2 = eg_merge(graph, result_class2, c1)
                    merges = merges + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_mul_annihilation(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_MUL && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let c0 = eg_graph_find(graph, node.children[0 as usize])
            let c1 = eg_graph_find(graph, node.children[1 as usize])
            if eg_class_has_const(graph, c1, 0) {
                let result_class = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class, c1) == false {
                    let m = eg_merge(graph, result_class, c1)
                    merges = merges + 1
                }
            }
            if eg_class_has_const(graph, c0, 0) {
                let result_class2 = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class2, c0) == false {
                    let m2 = eg_merge(graph, result_class2, c0)
                    merges = merges + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_double_neg(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_NEG && node.child_count == 1 && node.eclass_id != EG_INVALID {
            let inner_class = eg_graph_find(graph, node.children[0 as usize])
            if inner_class >= 0 && inner_class < graph.class_count {
                var j: i64 = 0
                while j < graph.classes[inner_class as usize].node_count {
                    let inner_nidx = graph.classes[inner_class as usize].nodes[j as usize]
                    if inner_nidx >= 0 && inner_nidx < graph.node_count {
                        let inner_node = graph.nodes[inner_nidx as usize]
                        if inner_node.op == EG_OP_NEG && inner_node.child_count == 1 {
                            let x_class = eg_graph_find(graph, inner_node.children[0 as usize])
                            let outer_class = eg_graph_find(graph, node.eclass_id)
                            if eg_graph_same_set(graph, outer_class, x_class) == false {
                                let m = eg_merge(graph, outer_class, x_class)
                                merges = merges + 1
                            }
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_sub_identity(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_SUB && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let c1 = eg_graph_find(graph, node.children[1 as usize])
            if eg_class_has_const(graph, c1, 0) {
                let c0 = eg_graph_find(graph, node.children[0 as usize])
                let result_class = eg_graph_find(graph, node.eclass_id)
                if eg_graph_same_set(graph, result_class, c0) == false {
                    let m = eg_merge(graph, result_class, c0)
                    merges = merges + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_sub_self(graph: &! EgGraph, zero_class: i64) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_SUB && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let c0 = eg_graph_find(graph, node.children[0 as usize])
            let c1 = eg_graph_find(graph, node.children[1 as usize])
            if c0 == c1 {
                let result_class = eg_graph_find(graph, node.eclass_id)
                let canon_zero = eg_graph_find(graph, zero_class)
                if eg_graph_same_set(graph, result_class, canon_zero) == false {
                    let m = eg_merge(graph, result_class, canon_zero)
                    merges = merges + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_distributivity(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var merges: i64 = 0
    var i: i64 = 0
    while i < graph.node_count {
        let node = graph.nodes[i as usize]
        if node.op == EG_OP_MUL && node.child_count == 2 && node.eclass_id != EG_INVALID {
            let a_class = eg_graph_find(graph, node.children[0 as usize])
            let bc_class = eg_graph_find(graph, node.children[1 as usize])
            if bc_class >= 0 && bc_class < graph.class_count {
                var j: i64 = 0
                while j < graph.classes[bc_class as usize].node_count {
                    let add_nidx = graph.classes[bc_class as usize].nodes[j as usize]
                    if add_nidx >= 0 && add_nidx < graph.node_count {
                        let add_node = graph.nodes[add_nidx as usize]
                        if add_node.op == EG_OP_ADD && add_node.child_count == 2 {
                            let b_class = eg_graph_find(graph, add_node.children[0 as usize])
                            let c_class = eg_graph_find(graph, add_node.children[1 as usize])
                            let ab = eg_add_binop(graph, EG_OP_MUL, a_class, b_class)
                            let ac = eg_add_binop(graph, EG_OP_MUL, a_class, c_class)
                            let ab_plus_ac = eg_add_binop(graph, EG_OP_ADD, ab, ac)
                            let orig_class = eg_graph_find(graph, node.eclass_id)
                            if eg_graph_same_set(graph, orig_class, ab_plus_ac) == false {
                                let m = eg_merge(graph, orig_class, ab_plus_ac)
                                merges = merges + 1
                            }
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    merges
}

fn eg_apply_algebraic_rules(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var total_merges: i64 = 0
    total_merges = total_merges + eg_apply_add_identity(graph)
    total_merges = total_merges + eg_apply_mul_identity(graph)
    total_merges = total_merges + eg_apply_mul_annihilation(graph)
    total_merges = total_merges + eg_apply_double_neg(graph)
    total_merges = total_merges + eg_apply_sub_identity(graph)
    total_merges
}

fn eg_algebraic_saturate_step_inner(graph: &! EgGraph, rules: &EgRuleSet) -> i64 with Mut, Div, Panic {
    let alg_merges = eg_apply_algebraic_rules(graph)
    let batch = eg_match_all_rules(graph, rules)
    let pat_applied = eg_apply_all_matches(graph, rules, &batch)
    let rebuilt = eg_rebuild(graph)
    // Encode both values: alg_merges * 1000000 + pat_applied
    alg_merges * 1000000 + pat_applied
}

fn eg_algebraic_saturate(ctx: &! EgContext) -> EgStats with Mut, Div, Panic {
    var iter: i64 = 0
    while iter < EG_MAX_ITERATIONS {
        let old_node_count = ctx.graph.node_count

        let combined = eg_algebraic_saturate_step_inner(&! ctx.graph, &ctx.rules)
        let alg_merges = combined / 1000000
        let pat_applied = combined % 1000000

        ctx.stats.iterations = iter + 1
        ctx.stats.merges = ctx.stats.merges + alg_merges
        ctx.stats.rules_applied = ctx.stats.rules_applied + pat_applied
        ctx.stats.nodes_added = ctx.graph.node_count
        ctx.iteration_count = iter + 1

        if alg_merges == 0 && pat_applied == 0 {
            ctx.stats.saturated = true
            return ctx.stats
        }
        if ctx.graph.node_count == old_node_count && alg_merges == 0 {
            ctx.stats.saturated = true
            return ctx.stats
        }

        iter = iter + 1
    }
    ctx.stats
}

// ============================================================================
// Section 14: Utility / Query Functions
// ============================================================================

fn eg_node_op(graph: &EgGraph, node_idx: i64) -> i64 with Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count { return 0 }
    graph.nodes[node_idx as usize].op
}

fn eg_node_value(graph: &EgGraph, node_idx: i64) -> i64 with Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count { return 0 }
    graph.nodes[node_idx as usize].value
}

fn eg_node_class(graph: &EgGraph, node_idx: i64) -> i64 with Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count { return EG_INVALID }
    graph.nodes[node_idx as usize].eclass_id
}

fn eg_node_child(graph: &EgGraph, node_idx: i64, child_idx: i64) -> i64 with Div, Panic {
    if node_idx < 0 || node_idx >= graph.node_count { return EG_INVALID }
    if child_idx < 0 || child_idx >= graph.nodes[node_idx as usize].child_count { return EG_INVALID }
    graph.nodes[node_idx as usize].children[child_idx as usize]
}

fn eg_are_equivalent(graph: &! EgGraph, a: i64, b: i64) -> bool with Mut, Div, Panic {
    eg_graph_same_set(graph, a, b)
}

fn eg_count_live_classes(graph: &! EgGraph) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < graph.class_count {
        let canon = eg_graph_find(graph, i)
        if canon == i { count = count + 1 }
        i = i + 1
    }
    count
}

pub(crate) fn eg_op_name_hash(op: i64) -> i64 {
    if op == EG_OP_CONST { return 100 }
    if op == EG_OP_VAR { return 200 }
    if op == EG_OP_ADD { return 300 }
    if op == EG_OP_SUB { return 400 }
    if op == EG_OP_MUL { return 500 }
    if op == EG_OP_DIV { return 600 }
    if op == EG_OP_NEG { return 700 }
    if op == EG_OP_FADD { return 800 }
    if op == EG_OP_FSUB { return 900 }
    if op == EG_OP_FMUL { return 1000 }
    if op == EG_OP_FDIV { return 1100 }
    if op == EG_OP_FNEG { return 1200 }
    if op == EG_OP_MEASURE { return 1300 }
    if op == EG_OP_COMBINE { return 1400 }
    0
}

// ============================================================================
// Section 14b: Context-Level Wrappers
// ============================================================================

fn eg_ctx_add_const(ctx: &! EgContext, value: i64) -> i64 with Mut, Div, Panic {
    eg_add_const(&! ctx.graph, value)
}
fn eg_ctx_add_var(ctx: &! EgContext, var_id: i64) -> i64 with Mut, Div, Panic {
    eg_add_var(&! ctx.graph, var_id)
}
fn eg_ctx_add_binop(ctx: &! EgContext, op: i64, lhs: i64, rhs: i64) -> i64 with Mut, Div, Panic {
    eg_add_binop(&! ctx.graph, op, lhs, rhs)
}
fn eg_ctx_add_unop(ctx: &! EgContext, op: i64, child: i64) -> i64 with Mut, Div, Panic {
    eg_add_unop(&! ctx.graph, op, child)
}
fn eg_ctx_merge(ctx: &! EgContext, a: i64, b: i64) -> i64 with Mut, Div, Panic {
    eg_merge(&! ctx.graph, a, b)
}
fn eg_ctx_rebuild(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_rebuild(&! ctx.graph)
}
fn eg_ctx_are_equivalent(ctx: &! EgContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    eg_are_equivalent(&! ctx.graph, a, b)
}
fn eg_ctx_count_live_classes(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_count_live_classes(&! ctx.graph)
}
fn eg_ctx_class_has_const(ctx: &! EgContext, class_id: i64, value: i64) -> bool with Mut, Div, Panic {
    eg_class_has_const(&! ctx.graph, class_id, value)
}
fn eg_ctx_apply_add_identity(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_apply_add_identity(&! ctx.graph)
}
fn eg_ctx_apply_mul_identity(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_apply_mul_identity(&! ctx.graph)
}
fn eg_ctx_apply_mul_annihilation(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_apply_mul_annihilation(&! ctx.graph)
}
fn eg_ctx_apply_double_neg(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_apply_double_neg(&! ctx.graph)
}
fn eg_ctx_apply_sub_identity(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_apply_sub_identity(&! ctx.graph)
}
fn eg_ctx_apply_sub_self(ctx: &! EgContext, zero_class: i64) -> i64 with Mut, Div, Panic {
    eg_apply_sub_self(&! ctx.graph, zero_class)
}
fn eg_ctx_add_rule(ctx: &! EgContext, rule: EgRule) -> i64 with Mut, Div, Panic {
    eg_add_rule(&! ctx.rules, rule)
}
fn eg_ctx_match_rule_node(ctx: &! EgContext, rule: &EgRule, node_idx: i64) -> EgMatch with Mut, Div, Panic {
    eg_match_rule_node(&! ctx.graph, rule, node_idx)
}
fn eg_ctx_match_all_rules(ctx: &! EgContext) -> EgMatchBatch with Mut, Div, Panic {
    eg_match_all_rules(&! ctx.graph, &ctx.rules)
}
fn eg_ctx_apply_all_matches(ctx: &! EgContext, batch: &EgMatchBatch) -> i64 with Mut, Div, Panic {
    eg_apply_all_matches(&! ctx.graph, &ctx.rules, batch)
}
fn eg_ctx_extract(ctx: &! EgContext) -> i64 with Mut, Div, Panic {
    eg_extract(&! ctx.graph, &! ctx.extractor)
}
fn eg_ctx_best_node_for_class(ctx: &! EgContext, class_id: i64) -> i64 with Mut, Div, Panic {
    eg_best_node_for_class(&! ctx.graph, &ctx.extractor, class_id)
}
fn eg_ctx_best_cost_for_class(ctx: &! EgContext, class_id: i64) -> i64 with Mut, Div, Panic {
    eg_best_cost_for_class(&! ctx.graph, &ctx.extractor, class_id)
}
fn eg_ctx_graph_find(ctx: &! EgContext, x: i64) -> i64 with Mut, Div, Panic {
    eg_graph_find(&! ctx.graph, x)
}
fn eg_ctx_class_size(ctx: &EgContext, class_id: i64) -> i64 with Div, Panic {
    eg_class_size(&ctx.graph, class_id)
}
fn eg_ctx_node_op(ctx: &EgContext, node_idx: i64) -> i64 with Div, Panic {
    eg_node_op(&ctx.graph, node_idx)
}
fn eg_ctx_node_value(ctx: &EgContext, node_idx: i64) -> i64 with Div, Panic {
    eg_node_value(&ctx.graph, node_idx)
}
fn eg_ctx_node_child(ctx: &EgContext, node_idx: i64, child_idx: i64) -> i64 with Div, Panic {
    eg_node_child(&ctx.graph, node_idx, child_idx)
}

// ============================================================================
// Section 14c: Small E-graph (safe under double-JIT interpretation, ~7KB)
// ============================================================================
//
// EgSmallContext compresses EgContext from ~4MB to ~7KB by limiting node/UF
// capacity from 16384/8192 to 64/128.  Used by ocp_egraph_mini_pass on
// IrFunctions with ≤4 instructions — safe to allocate on the interpreter stack
// under double-JIT.  Same algebraic rules as EgContext; saturation ≤ 8 iters.
//
// References:
//   Willsey et al. "egg: Fast and Extensible Equality Saturation" (2021)

pub struct EgSmallContext {
    nodes:      [EgNode; 64],
    node_count: i64,
    parent:     [i64; 128],
    rank:       [i64; 128],
    uf_size:    i64,
    costs:      [i64; 64],
    best:       [i64; 64],
    unc_lo:     [i64; 64],
    unc_hi:     [i64; 64],
    // Algebra kind for the expression context.
    // 0=Real, 1=Complex, 2=Quaternion, 3=Octonion, 4=Sedenion, 5=Clifford
    algebra_kind: i64,
    // Reassociation strategy: 0=free, 1=blocked, 2=fano_selective
    // Derived from algebra declaration or defaults to 0 for k<=2, 1 for k>=3
    reassoc_strategy: i64,
    // Cayley-Dickson tower level for Fano predicate (3=octonion, 4=sedenion)
    cd_bits: i64,
    // Representation-exactness axis (orthogonal to the value-algebra axis above).
    // false (default): the carrier is inexact (IEEE-754 f64/f32), so reassociation
    //   of FADD/FSUB/FMUL is FORBIDDEN — it changes the bits and breaks bit-identity /
    //   cross-stage determinism. IEEE-754 addition and multiplication are commutative
    //   but NOT associative, independent of the value algebra.
    // true: the producing context has explicitly opted in to inexact reassociation
    //   (the GUM-guided precision-preserving pass, which deliberately trades bits for a
    //   lower-uncertainty evaluation order). Only that path may set this.
    allow_inexact_reassoc: bool,
    // A-layer-2 (Lyapunov/chaos axis). true: this context optimizes a function that
    // integrates a vector field tagged `chaotic` (largest Lyapunov exponent λ > 0,
    // per the chaos-sensitivity manifest). A reassociation-induced rounding difference
    // then grows ~ e^{λt} over the integration horizon, so ALL float reassociation is
    // refused REGARDLESS of allow_inexact_reassoc — the chaos gate dominates the
    // precision-preserving opt-in. Set from the IR_STRATEGY_PRECISION_PRESERVING_CHAOTIC
    // strategy, which a `with Chaotic` effect produces.
    chaotic: bool,
    // Phase 5: observation barriers.
    // E-classes in this array are "observed" — the optimizer must not merge
    // them with other classes. They are fixed points in the equivalence space.
    // Semantics: pure functions allow free rewriting; Observe creates barriers.
    observe_barriers: [i64; 16],
    observe_barrier_count: i64,
}

pub fn eg_small_init() -> EgSmallContext {
    EgSmallContext {
        nodes:      [eg_node_new(); 64],
        node_count: 0,
        algebra_kind: 0,  // default: Real (associative)
        reassoc_strategy: 0,  // default: free reassociation
        cd_bits: 0,
        allow_inexact_reassoc: false,  // default: inexact (f64) reassociation FORBIDDEN
        chaotic: false,                // default: not a chaotic integration path
        observe_barriers: [0 - 1; 16],
        observe_barrier_count: 0,
        parent:     [EG_INVALID; 128],
        rank:       [0; 128],
        uf_size:    0,
        costs:      [999999; 64],
        best:       [EG_INVALID; 64],
        unc_lo:     [0; 64],
        unc_hi:     [0; 64],
    }
}

fn eg_small_init_algebra(strategy: i64, cd_bits_in: i64) -> EgSmallContext {
    EgSmallContext {
        nodes:      [eg_node_new(); 64],
        node_count: 0,
        algebra_kind: 3,
        reassoc_strategy: strategy,
        cd_bits: cd_bits_in,
        chaotic: false,                // default: not a chaotic integration path
        // Deliberate opt-in: this constructor exists ONLY for explicit algebra-gated
        // reassociation contexts (Cayley-Dickson octonion/sedenion), whose callers have
        // declared intent to reassociate within the value-algebra limits encoded by
        // `strategy` (free / blocked / fano_selective). It is the value-algebra axis that
        // then decides WHICH triples may merge. The exactness axis is therefore opted in
        // here, so the Fano predicate (168-theorem) remains the deciding gate — preserving
        // the algebra tests' semantics. The default-safe path is eg_small_init() (false).
        allow_inexact_reassoc: true,
        observe_barriers: [0 - 1; 16],
        observe_barrier_count: 0,
        parent:     [EG_INVALID; 128],
        rank:       [0; 128],
        uf_size:    0,
        costs:      [999999; 64],
        best:       [EG_INVALID; 64],
        unc_lo:     [0; 64],
        unc_hi:     [0; 64],
    }
}

// Check if an e-class is an observation barrier (fixed point).
fn eg_small_is_observed(ctx: &! EgSmallContext, eclass: i64) -> bool with Mut, Div, Panic {
    let canonical = eg_small_find(ctx, eclass)
    var i: i64 = 0
    while i < ctx.observe_barrier_count {
        let barrier = eg_small_find(ctx, ctx.observe_barriers[i])
        if barrier == canonical { return true }
        i = i + 1
    }
    false
}

// Mark an e-class as observed (creates a barrier the optimizer cannot merge past).
pub fn eg_small_mark_observed(ctx: &! EgSmallContext, eclass: i64) with Mut {
    if ctx.observe_barrier_count < 16 {
        ctx.observe_barriers[ctx.observe_barrier_count] = eclass
        ctx.observe_barrier_count = ctx.observe_barrier_count + 1
    }
}

// Allocate a fresh equivalence class; returns its id, or EG_INVALID if full.
fn eg_small_make_set(ctx: &! EgSmallContext) -> i64 with Mut, Div, Panic {
    let id = ctx.uf_size
    if id >= 128 { return EG_INVALID }
    ctx.parent[id as usize] = id
    ctx.rank[id as usize]   = 0
    ctx.uf_size = ctx.uf_size + 1
    id
}

// Path-compressing find on the small union-find.
pub(crate) fn eg_small_find(ctx: &! EgSmallContext, x: i64) -> i64 with Mut, Div, Panic {
    if x < 0 || x >= 128 { return x }
    var root = x
    while ctx.parent[root as usize] != root {
        root = ctx.parent[root as usize]
    }
    var cur = x
    while cur != root {
        let next = ctx.parent[cur as usize]
        ctx.parent[cur as usize] = root
        cur = next
    }
    root
}

// Rank-based union.  Returns true if a real merge happened (classes were distinct).
// Phase 5: observation barriers block merges. Observed e-classes are fixed points.
pub(crate) fn eg_small_union(ctx: &! EgSmallContext, a: i64, b: i64) -> bool with Mut, Div, Panic {
    let ra = eg_small_find(ctx, a)
    let rb = eg_small_find(ctx, b)
    if ra == rb { return false }
    // Observation barrier: if either class is observed, do not merge.
    // The observed value is a fixed point — the optimizer has no freedom here.
    if eg_small_is_observed(ctx, ra) || eg_small_is_observed(ctx, rb) {
        return false
    }
    let rank_a = ctx.rank[ra as usize]
    let rank_b = ctx.rank[rb as usize]
    if rank_a < rank_b {
        ctx.parent[ra as usize] = rb
    } else if rank_a > rank_b {
        ctx.parent[rb as usize] = ra
    } else {
        ctx.parent[rb as usize] = ra
        ctx.rank[ra as usize] = rank_a + 1
    }
    true
}

// Hash-consing node add: linear-scan dedup over node_count (≤64) entries.
// Returns the equivalence class of the (possibly existing) node.
fn eg_small_add_node(ctx: &! EgSmallContext, node: EgNode) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.node_count {
        let ex = ctx.nodes[i as usize]
        if ex.op          == node.op
            && ex.value       == node.value
            && ex.child_count == node.child_count
            && ex.children[0] == node.children[0]
            && ex.children[1] == node.children[1] {
            return ex.eclass_id
        }
        i = i + 1
    }
    if ctx.node_count >= 64 { return EG_INVALID }
    let id = eg_small_make_set(ctx)
    if id == EG_INVALID { return EG_INVALID }
    var new_node = node
    new_node.eclass_id = id
    ctx.nodes[ctx.node_count as usize] = new_node
    ctx.node_count = ctx.node_count + 1
    id
}

pub(crate) fn eg_small_add_const(ctx: &! EgSmallContext, value: i64) -> i64 with Mut, Div, Panic {
    let node = EgNode {
        op:          EG_OP_CONST,
        children:    [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID],
        child_count: 0,
        value:       value,
        eclass_id:   EG_INVALID,
    }
    eg_small_add_node(ctx, node)
}

// ============================================================================
// Section 14c-extra: Uncertainty-Aware Helpers (Sprint 225)
// ============================================================================

// Integer square root via Newton's method (7 iterations)
// Used for GUM uncertainty propagation: u(z) = sqrt(u(x)^2 + u(y)^2)
// Initial guess: y = 2^k where 4^(k-1) < x <= 4^k, so y/sqrt(x) in [1,2)
// guaranteeing convergence in 7 iterations to floor(sqrt(x)).
pub(crate) fn eg_isqrt(x: i64) -> i64 {
    if x <= 0 { return 0 }
    if x == 1 { return 1 }
    var y: i64 = 2
    if x > 4           { y = 4 }
    if x > 16          { y = 8 }
    if x > 64          { y = 16 }
    if x > 256         { y = 32 }
    if x > 1024        { y = 64 }
    if x > 4096        { y = 128 }
    if x > 16384       { y = 256 }
    if x > 65536       { y = 512 }
    if x > 262144      { y = 1024 }
    if x > 1048576     { y = 2048 }
    if x > 4194304     { y = 4096 }
    if x > 16777216    { y = 8192 }
    if x > 67108864    { y = 16384 }
    if x > 268435456   { y = 32768 }
    if x > 1073741824  { y = 65536 }
    if x > 4294967296  { y = 131072 }
    if x > 17179869184 { y = 262144 }
    if x > 68719476736 { y = 524288 }
    if x > 274877906944    { y = 1048576 }
    if x > 1099511627776   { y = 2097152 }
    if x > 4398046511104   { y = 4194304 }
    if x > 17592186044416  { y = 8388608 }
    if x > 70368744177664  { y = 16777216 }
    if x > 281474976710656 { y = 33554432 }
    if x > 1125899906842624   { y = 67108864 }
    if x > 4503599627370496   { y = 134217728 }
    if x > 18014398509481984  { y = 268435456 }
    if x > 72057594037927936  { y = 536870912 }
    if x > 288230376151711744 { y = 1073741824 }
    if x > 1152921504606846976 { y = 2147483648 }
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    y = (y + x / y) / 2
    if y * y > x { y - 1 } else { y }
}

// Quantize f64 uncertainty to i64 scale (multiply by 1e9 for nanoscale resolution)
pub fn eg_quantize_unc(u_f64: f64) -> i64 {
    let scaled = u_f64 * 1000000000.0
    if scaled < 0.0 { return 0 }
    scaled as i64
}

pub fn eg_small_add_var(ctx: &! EgSmallContext, var_id: i64) -> i64 with Mut, Div, Panic {
    let node = EgNode {
        op:          EG_OP_VAR,
        children:    [var_id, EG_INVALID, EG_INVALID, EG_INVALID],
        child_count: 1,
        value:       var_id,
        eclass_id:   EG_INVALID,
    }
    eg_small_add_node(ctx, node)
}

pub fn eg_small_add_binop(ctx: &! EgSmallContext, op: i64, lhs: i64, rhs: i64) -> i64 with Mut, Div, Panic {
    let node = EgNode {
        op:          op,
        children:    [lhs, rhs, EG_INVALID, EG_INVALID],
        child_count: 2,
        value:       0,
        eclass_id:   EG_INVALID,
    }
    eg_small_add_node(ctx, node)
}

// Add VAR node with uncertainty annotation (for epistemic pass)
pub fn eg_small_add_var_with_unc(ctx: &! EgSmallContext, var_id: i64, unc: i64) -> i64 with Mut, Div, Panic {
    let node_idx = eg_small_add_var(ctx, var_id)
    if node_idx >= 0 && node_idx < 64 {
        ctx.unc_lo[node_idx as usize] = unc
    }
    node_idx
}

// Add binary op node with propagated uncertainty for epistemic pass
// GUM §5.1.2: u(z)^2 = u(x)^2 + u(y)^2 for additive ops; conservative for mul/div.
// lhs_class/rhs_class are node indices (same as e-class IDs for leaf nodes) into unc_lo.
pub fn eg_small_add_binop_with_unc(ctx: &! EgSmallContext, op: i64, lhs_class: i64, rhs_class: i64) -> i64 with Mut, Div, Panic {
    let lhs_unc = if lhs_class >= 0 && lhs_class < 64 { ctx.unc_lo[lhs_class as usize] } else { 0 }
    let rhs_unc = if rhs_class >= 0 && rhs_class < 64 { ctx.unc_lo[rhs_class as usize] } else { 0 }
    // Clamp to avoid i64 overflow in the square (safe up to ~3.03e9 per operand)
    let max_safe: i64 = 3000000000
    let l = if lhs_unc > max_safe { max_safe } else { lhs_unc }
    let r = if rhs_unc > max_safe { max_safe } else { rhs_unc }
    let combined_unc = eg_isqrt(l * l + r * r)
    let node_idx = eg_small_add_binop(ctx, op, lhs_class, rhs_class)
    if node_idx >= 0 && node_idx < 64 {
        ctx.unc_lo[node_idx as usize] = combined_unc
    }
    node_idx
}

// Simple cost function: CONST/VAR cost 1, everything else costs 2.
fn eg_small_cost_by_op(op: i64) -> i64 {
    if op == EG_OP_CONST { return EG_COST_CONST }
    if op == EG_OP_VAR   { return EG_COST_VAR   }
    EG_COST_OP
}

// Apply algebraic saturation rules on the small graph.
// Rules: add(x,0)→x, add(0,x)→x, mul(x,1)→x, mul(1,x)→x, sub(x,x)→0.
// Returns total merge count; 0 indicates already saturated.
pub fn eg_small_saturate(ctx: &! EgSmallContext) -> i64 with Mut, Div, Panic {
    var total_merges: i64 = 0
    var iter: i64 = 0
    while iter < 8 {
        var merges: i64 = 0
        var i: i64 = 0
        while i < ctx.node_count {
            let node     = ctx.nodes[i as usize]
            let cls      = eg_small_find(ctx, node.eclass_id)
            if node.op == EG_OP_ADD && node.child_count == 2 {
                let lhs_cls = eg_small_find(ctx, node.children[0])
                let rhs_cls = eg_small_find(ctx, node.children[1])
                var j: i64 = 0
                while j < ctx.node_count {
                    let other = ctx.nodes[j as usize]
                    if other.op == EG_OP_CONST && other.value == 0 {
                        let zero_cls = eg_small_find(ctx, other.eclass_id)
                        // add(x, 0) → x
                        if rhs_cls == zero_cls {
                            if eg_small_union(ctx, cls, lhs_cls) { merges = merges + 1 }
                        }
                        // add(0, x) → x
                        if lhs_cls == zero_cls {
                            if eg_small_union(ctx, cls, rhs_cls) { merges = merges + 1 }
                        }
                    }
                    j = j + 1
                }
            }
            if node.op == EG_OP_MUL && node.child_count == 2 {
                let lhs_cls = eg_small_find(ctx, node.children[0])
                let rhs_cls = eg_small_find(ctx, node.children[1])
                var j: i64 = 0
                while j < ctx.node_count {
                    let other = ctx.nodes[j as usize]
                    if other.op == EG_OP_CONST && other.value == 1 {
                        let one_cls = eg_small_find(ctx, other.eclass_id)
                        // mul(x, 1) → x
                        if rhs_cls == one_cls {
                            if eg_small_union(ctx, cls, lhs_cls) { merges = merges + 1 }
                        }
                        // mul(1, x) → x
                        if lhs_cls == one_cls {
                            if eg_small_union(ctx, cls, rhs_cls) { merges = merges + 1 }
                        }
                    }
                    j = j + 1
                }
                // Sprint 74 Block F: mul-annihilation: mul(x, 0) → 0, mul(0, x) → 0
                // Lattice theory: 0 is the absorbing element of the multiplication semiring.
                // References: Wegman & Zadeck (TOPLAS 1991) §2 — constant lattice; 0 absorbs all.
                var k: i64 = 0
                while k < ctx.node_count {
                    let zother = ctx.nodes[k as usize]
                    if zother.op == EG_OP_CONST && zother.value == 0 {
                        let zero_cls = eg_small_find(ctx, zother.eclass_id)
                        // mul(x, 0) → 0
                        if rhs_cls == zero_cls {
                            if eg_small_union(ctx, cls, zero_cls) { merges = merges + 1 }
                        }
                        // mul(0, x) → 0
                        if lhs_cls == zero_cls {
                            if eg_small_union(ctx, cls, zero_cls) { merges = merges + 1 }
                        }
                    }
                    k = k + 1
                }
            }
            if node.op == EG_OP_SUB && node.child_count == 2 {
                // sub(x, x) → 0
                let lhs_cls = eg_small_find(ctx, node.children[0])
                let rhs_cls = eg_small_find(ctx, node.children[1])
                if lhs_cls == rhs_cls {
                    let zero_id = eg_small_add_const(ctx, 0)
                    if zero_id != EG_INVALID {
                        let zero_cls = eg_small_find(ctx, zero_id)
                        if eg_small_union(ctx, cls, zero_cls) { merges = merges + 1 }
                    }
                }
            }
            i = i + 1
        }
        total_merges = total_merges + merges
        if merges == 0 { return total_merges }
        iter = iter + 1
    }
    total_merges
}

// Cost-based extraction: return the cheapest EgNode in the equivalence class
// of class_id (using path-compression-aware find).
pub fn eg_small_extract(ctx: &! EgSmallContext, class_id: i64) -> EgNode with Mut, Div, Panic {
    let canonical  = eg_small_find(ctx, class_id)
    var best       = eg_node_new()
    var best_cost: i64 = 999999
    var i: i64 = 0
    while i < ctx.node_count {
        let node = ctx.nodes[i as usize]
        if node.eclass_id >= 0 {
            let node_cls = eg_small_find(ctx, node.eclass_id)
            if node_cls == canonical {
                let cost = eg_small_cost_by_op(node.op)
                if cost < best_cost {
                    best_cost = cost
                    best      = node
                }
            }
        }
        i = i + 1
    }
    best
}

// Uncertainty-guided extraction (Sprint 225 epistemic pass)
// Extracts the equivalent node with minimum uncertainty (GUM cost model)
pub fn eg_small_extract_epistemic(ctx: &! EgSmallContext, class_id: i64) -> EgNode with Mut, Div, Panic {
    let canonical  = eg_small_find(ctx, class_id)
    var best       = eg_node_new()
    var best_unc: i64 = 999999999
    var best_cost: i64 = 999999
    var i: i64 = 0
    while i < ctx.node_count {
        let node = ctx.nodes[i as usize]
        if node.eclass_id >= 0 {
            let node_cls = eg_small_find(ctx, node.eclass_id)
            if node_cls == canonical {
                let node_unc = if i < 64 { ctx.unc_lo[i as usize] } else { 999999999 }
                let cost = eg_small_cost_by_op(node.op)
                // Prefer lower uncertainty; tie-break by lower cost
                if node_unc < best_unc || (node_unc == best_unc && cost < best_cost) {
                    best_unc = node_unc
                    best_cost = cost
                    best = node
                }
            }
        }
        i = i + 1
    }
    best
}

// ── Fano predicate (inlined from ir/algebra.sio for standalone operation) ────
//
// Cayley-Dickson sign function σ(a,b) at tower level `bits`.
// Needed to evaluate the Fano incidence condition for octonion basis triples.
fn eg_ir_cd_sigma(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return eg_ir_cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return eg_ir_cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return eg_ir_cd_sigma(a_lo, b_lo, bits - 1) }
        else { return 0 - eg_ir_cd_sigma(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - eg_ir_cd_sigma(b_lo, a_lo, bits - 1) }
    return eg_ir_cd_sigma(b_lo, a_lo, bits - 1)
}

// Can the optimizer reassociate basis triple (i,j,k) at tower level bits?
// Returns true iff the triple lies on a Fano line (168 theorem predicate).
fn ir_can_reassociate_triple(bits: i64, i: i64, j: i64, k: i64) -> bool with Mut, Panic, Div {
    if bits < 3 { return true }
    if i == 0 || j == 0 || k == 0 { return true }
    if i == j || j == k || i == k { return true }
    let alpha = eg_ir_cd_sigma(i, j, bits) * eg_ir_cd_sigma(i ^ j, k, bits)
    let beta  = eg_ir_cd_sigma(j, k, bits) * eg_ir_cd_sigma(i, j ^ k, bits)
    alpha == beta
}

// Extract basis index from an e-class for Fano predicate.
// Returns the VAR node's value field as basis index, or -1 if the e-class
// doesn't contain a simple VAR node (complex expression → conservatively block).
fn eg_small_basis_index(ctx: &! EgSmallContext, eclass: i64) -> i64 with Mut, Div, Panic {
    let canonical = eg_small_find(ctx, eclass)
    var i: i64 = 0
    while i < ctx.node_count {
        let node = ctx.nodes[i as usize]
        let node_ec = eg_small_find(ctx, node.eclass_id)
        if node_ec == canonical && node.op == EG_OP_VAR {
            return node.value  // basis index encoded in VAR node value
        }
        i = i + 1
    }
    0 - 1  // no VAR node found — unknown basis
}

// Float associativity saturation (imperative scan, mirrors eg_apply_distributivity)
// Applies: fadd(fadd(a,b),c) ↔ fadd(a,fadd(b,c))
//          fmul(fmul(a,b),c) ↔ fmul(a,fmul(b,c))
// 8 iterations max; terminates when no new merges
//
// TWO ORTHOGONAL GATES — reassociation fires iff BOTH hold:
//
// 1. EXACTNESS (ctx.allow_inexact_reassoc): IEEE-754 f64/f32 add and mul are
//    commutative but NOT associative — reassociation changes the bits and breaks
//    bit-identity / cross-stage determinism. This is true regardless of the value
//    algebra (it is a property of the floating-point REPRESENTATION, not of ℝ or
//    the Cayley-Dickson tower). So ALL float reassociation here — FADD/FSUB AND
//    FMUL — is FORBIDDEN unless the producing context has explicitly opted in.
//    Only the GUM-guided precision-preserving pass opts in (it deliberately trades
//    bits for a lower-uncertainty evaluation order). Default contexts never do.
//
// 2. VALUE-ALGEBRA (reassoc_strategy): even when inexact reassociation is permitted,
//    FMUL must additionally respect the carrier's non-associativity:
//      0 = free: multiplication reassociation allowed (R, C, H)
//      1 = blocked: multiplication NEVER reassociated (sedenion+)
//      2 = fano_selective: multiplication checked per-triple via
//          ir_can_reassociate_triple() — the 168 theorem as a compiler predicate
//    FADD/FSUB is associative in every Cayley-Dickson algebra, so it is bound by
//    gate 1 alone.
pub fn eg_small_saturate_float(ctx: &! EgSmallContext) -> i64 with Mut, Div, Panic {
    // A-layer-2: on a chaotic integration path, refuse ALL float reassociation. A
    // reassociation-induced rounding difference grows ~ e^{λt} (λ > 0) over the
    // horizon, so no tolerance can contain it — the chaos gate dominates even the
    // GUM-guided precision-preserving opt-in (allow_inexact_reassoc).
    if ctx.chaotic { return 0 }
    var total_merges: i64 = 0
    var iter: i64 = 0
    while iter < 8 {
        var merges: i64 = 0
        var i: i64 = 0
        while i < ctx.node_count {
            let node = ctx.nodes[i as usize]

            // FADD/FSUB reassociation: associative in every Cayley-Dickson algebra,
            // but NOT in IEEE-754 — gated by the exactness opt-in (gate 1).
            if ctx.allow_inexact_reassoc && (node.op == EG_OP_FADD || node.op == EG_OP_FSUB) && node.child_count >= 2 {
                let lhs_class = node.children[0]
                let rhs_class = node.children[1]

                var j: i64 = 0
                while j < ctx.node_count {
                    let inner = ctx.nodes[j as usize]
                    if (inner.op == node.op) && inner.child_count >= 2 {
                        let inner_eclass = eg_small_find(ctx, inner.eclass_id)
                        let lhs_canonical = eg_small_find(ctx, lhs_class)
                        if inner_eclass == lhs_canonical {
                            let bc_class = eg_small_add_binop(ctx, node.op, inner.children[1], rhs_class)
                            let result_class = eg_small_add_binop(ctx, node.op, inner.children[0], bc_class)
                            let node_eclass = eg_small_find(ctx, node.eclass_id)
                            let result_eclass = eg_small_find(ctx, result_class)
                            if eg_small_union(ctx, node_eclass, result_eclass) {
                                merges = merges + 1
                            }
                        }
                    }
                    j = j + 1
                }
            }

            // FMUL reassociation: gated by reassoc_strategy
            // (a*b)*c ↔ a*(b*c) — only when algebra permits
            if node.op == EG_OP_FMUL && node.child_count >= 2 {
                let mul_lhs = node.children[0]
                let mul_rhs = node.children[1]

                // Gate 1 (exactness): inexact reassociation must be opted in.
                // Gate 2 (value-algebra): strategy 0 (free) or 2 (fano_selective) attempt
                //   reassociation; strategy 1 (blocked) skips entirely.
                if ctx.allow_inexact_reassoc && ctx.reassoc_strategy != 1 {
                    var j: i64 = 0
                    while j < ctx.node_count {
                        let inner = ctx.nodes[j as usize]
                        if inner.op == EG_OP_FMUL && inner.child_count >= 2 {
                            let inner_eclass = eg_small_find(ctx, inner.eclass_id)
                            let lhs_canonical = eg_small_find(ctx, mul_lhs)
                            if inner_eclass == lhs_canonical {
                                // Found: (inner.a * inner.b) * c
                                // For fano_selective: check the triple before merging
                                var allow = true
                                if ctx.reassoc_strategy == 2 {
                                    // Extract basis indices from VAR nodes
                                    // inner.a, inner.b, c are e-classes
                                    // Use the value field as basis index for VAR nodes
                                    let a_idx = eg_small_basis_index(ctx, inner.children[0])
                                    let b_idx = eg_small_basis_index(ctx, inner.children[1])
                                    let c_idx = eg_small_basis_index(ctx, mul_rhs)
                                    // Only check if all three are concrete basis elements
                                    if a_idx >= 0 && b_idx >= 0 && c_idx >= 0 {
                                        allow = ir_can_reassociate_triple(ctx.cd_bits, a_idx, b_idx, c_idx)
                                    }
                                    // If any index is unknown (-1), conservatively block
                                    if a_idx < 0 || b_idx < 0 || c_idx < 0 {
                                        allow = false
                                    }
                                }
                                if allow {
                                    let bc = eg_small_add_binop(ctx, EG_OP_FMUL, inner.children[1], mul_rhs)
                                    let result = eg_small_add_binop(ctx, EG_OP_FMUL, inner.children[0], bc)
                                    let ne = eg_small_find(ctx, node.eclass_id)
                                    let re = eg_small_find(ctx, result)
                                    if eg_small_union(ctx, ne, re) {
                                        merges = merges + 1
                                    }
                                }
                            }
                        }
                        j = j + 1
                    }
                }
            }

            // Float mul identity: fmul(a, 1.0) → a, fmul(1.0, a) → a
            // (deferred: constant recognition requires checking const nodes)

            // Float add identity: fadd(a, 0.0) → a
            // (deferred: const recognition)

            i = i + 1
        }
        if merges == 0 { return total_merges }
        total_merges = total_merges + merges
        iter = iter + 1
    }
    total_merges
}

