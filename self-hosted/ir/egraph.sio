    return test_eg_small_find_self_inner(&! ctx)
}

fn test_eg_small_union_basic_inner(ctx: &! EgSmallContext) -> bool with Mut, Div, Panic {
    let id0 = eg_small_add_const(ctx, 10)
    let id1 = eg_small_add_const(ctx, 20)
    eg_small_union(ctx, id0, id1)
