fn test_eg_cost_prefer_const_inner(ctx: &! EgContext) -> bool with Mut, Div, Panic {
    let c5 = eg_ctx_add_const(ctx, 5)
    let c3 = eg_ctx_add_const(ctx, 3)
    let c2 = eg_ctx_add_const(ctx, 2)
    let add_expr = eg_ctx_add_binop(ctx, EG_OP_ADD, c3, c2)
    let m = eg_ctx_merge(ctx, add_expr, c5)
    let rebuilt = eg_ctx_rebuild(ctx)
    let passes = eg_ctx_extract(ctx)
    let best = eg_ctx_best_node_for_class(ctx, c5)
    if best >= 0 && best < ctx.graph.node_count {
        let best_op = ctx.graph.nodes[best as usize].op
        return best_op == EG_OP_CONST
    }
    false
}
fn test_eg_cost_prefer_const() -> bool with Mut, Div, Panic {
