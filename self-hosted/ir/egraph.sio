// Sprint 74: EgSmall mul-annihilation tests
fn test_eg_small_sat_mul_annihilation_rhs() -> bool with Mut, Div {
    // mul(var_x, 0) → should extract EG_OP_CONST with value 0
    var ctx = eg_small_init()
    let x   = eg_small_add_var(&! ctx, 10)
    let z   = eg_small_add_const(&! ctx, 0)
    let mul = eg_small_add_binop(&! ctx, EG_OP_MUL, x, z)
    eg_small_saturate(&! ctx)
    let ex  = eg_small_extract(&! ctx, mul)
    ex.op == EG_OP_CONST && ex.value == 0
}

fn test_eg_small_sat_mul_annihilation_lhs() -> bool with Mut, Div {
    // mul(0, var_x) → should extract EG_OP_CONST with value 0
    var ctx = eg_small_init()
    let z   = eg_small_add_const(&! ctx, 0)
    let x   = eg_small_add_var(&! ctx, 10)
    let mul = eg_small_add_binop(&! ctx, EG_OP_MUL, z, x)
    eg_small_saturate(&! ctx)
    let ex  = eg_small_extract(&! ctx, mul)
    ex.op == EG_OP_CONST && ex.value == 0
}

