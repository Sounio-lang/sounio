fn test_eg_small_init() -> bool {
    let ctx = eg_small_init()
    ctx.node_count == 0 && ctx.uf_size == 0
}

fn test_eg_small_add_node() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let id = eg_small_add_const(&! ctx, 42)
    ctx.node_count == 1 && id == 0
}

fn test_eg_small_dedup() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let id1 = eg_small_add_const(&! ctx, 42)
    let id2 = eg_small_add_const(&! ctx, 42)
    id1 == id2 && ctx.node_count == 1
}

fn test_eg_small_find_self() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let id = eg_small_add_const(&! ctx, 0)
    let found = eg_small_find(&! ctx, id)
    found == id
}

fn test_eg_small_union_basic() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let id0 = eg_small_add_const(&! ctx, 10)
    let id1 = eg_small_add_const(&! ctx, 20)
    eg_small_union(&! ctx, id0, id1)
    let r0 = eg_small_find(&! ctx, id0)
    let r1 = eg_small_find(&! ctx, id1)
    r0 == r1
}

fn test_eg_small_sat_add_identity() -> bool with Mut, Div {
    var ctx  = eg_small_init()
    let zero = eg_small_add_const(&! ctx, 0)
    let x    = eg_small_add_var(&! ctx, 1)
    let root = eg_small_add_binop(&! ctx, EG_OP_ADD, x, zero)
    eg_small_saturate(&! ctx)
    let extracted = eg_small_extract(&! ctx, root)
    extracted.op == EG_OP_VAR
}

fn test_eg_small_sat_mul_identity() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let one  = eg_small_add_const(&! ctx, 1)
    let x    = eg_small_add_var(&! ctx, 2)
    let root = eg_small_add_binop(&! ctx, EG_OP_MUL, x, one)
    eg_small_saturate(&! ctx)
    let extracted = eg_small_extract(&! ctx, root)
    extracted.op == EG_OP_VAR
}

fn test_eg_small_sat_sub_self() -> bool with Mut, Div {
    var ctx = eg_small_init()
    let x    = eg_small_add_var(&! ctx, 3)
    let root = eg_small_add_binop(&! ctx, EG_OP_SUB, x, x)
    eg_small_saturate(&! ctx)
    let extracted = eg_small_extract(&! ctx, root)
    extracted.op == EG_OP_CONST && extracted.value == 0
}

