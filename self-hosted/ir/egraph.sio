fn test_eg_uf_multi_union_inner(uf: &! EgUnionFind) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < 10 { let s = eg_uf_make_set(uf); i = i + 1 }
    i = 1
    while i < 10 { let r = eg_union(uf, 0, i); i = i + 1 }
    var all_same = true
    i = 1
    while i < 10 {
        if eg_same_set(uf, 0, i) == false { all_same = false }
        i = i + 1
    }
    all_same
}
