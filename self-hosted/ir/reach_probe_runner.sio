use ir::loop_opt::*
use ir::tailcall::*
use ir::reachability::*
use native::regalloc::*
use native::peephole::*

// Codegen dependency chain helpers (flat-namespace resolution).
fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn load_source_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    parse_program_preloaded(state.token_count)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("reach_probe: usage: reach_probe_runner.sio <source.sio>\n")
        return 1
    }
    let source_path = get_arg(0)

    print("reach_probe: source=")
    print(source_path)
    print("\n")

    // Phase 0: Parse
    let prog = load_source_file(source_path)
    if parser_last_error_count() > 0 {
        print("reach_probe: parse_error\n")
        return 1
    }
    print("reach_probe: parse_ok\n")

    // Phase 1: Flat IR summary (function signatures, no bodies)
    // Typecheck intentionally skipped — same as native_compile_driver.sio.
    let epistemic = ir_empty_epistemic_section()
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&prog, epistemic)
    if summary_result.had_error {
        print("reach_probe: summary_error\n")
        return 2
    }

    let fn_count = summary_result.summary.module.fn_count
    print("reach_probe: fn_count=")
    print_int(fn_count)
    print("\n")

    if fn_count <= 0 {
        print("reach_probe: empty_module\n")
        return 2
    }

    // Phase 2: Lower each function body (no optimizer, no codegen)
    var module = summary_result.summary.module
    var fi: i64 = 0
    while fi < fn_count {
        let fn_name = ir_fn_get(&module, fi as usize).name
        let body_result = lower_program_function_body_from_summary_flat_with_epistemic_ref(
            &prog, &summary_result.summary, epistemic, fn_name
        )
        if body_result.func.instr_count > 0 {
            ir_fn_set(&! module, fi as usize, body_result.func)
        }
        fi = fi + 1
    }
    print("reach_probe: bodies_lowered\n")

    // Phase 3: Reachability analysis from main()
    let reach = reach_thin_module(module)

    print("reach_probe: reachable=")
    print_int(reach.reachable_fn_count)
    print(" eliminated=")
    print_int(reach.eliminated_fn_count)
    print(" total=")
    print_int(reach.original_fn_count)
    print("\n")

    if reach.eliminated_fn_count > 0 {
        print("reach_probe: thin_ratio=")
        print_int(reach.reachable_fn_count)
        print("/")
        print_int(reach.original_fn_count)
        print("\n")
    } else {
        print("reach_probe: no_dead_functions\n")
    }

    0
}
