// self-hosted::ir::const_prop — Constant Propagation and Folding Pass
//
// A comprehensive sparse conditional constant propagation (SCCP) pass for the
// Sounio self-hosted compiler IR.  Implements:
//
//   1. Lattice-based constant tracking: TOP (unknown) -> CONST -> BOTTOM (varying)
//   2. Constant folding: evaluate binary/unary ops on known constants at compile time
//   3. Strength reduction: replace expensive ops with cheaper equivalents
//   4. Branch folding: replace conditional branches with unconditional when condition is known
//   5. Copy propagation: propagate constants through copy chains
//   6. Phi resolution: fold phi nodes where all inputs agree on a constant
//   7. Sparse conditional constant propagation (SCCP): worklist algorithm combining
//      constant propagation with reachability analysis
//   8. Dead branch elimination: remove unreachable blocks after branch folding
//
// All arrays are fixed-size -- no heap allocation.
//
// References:
//   Wegman & Zadeck: "Constant Propagation with Conditional Branches" (1991)
//   Click & Cooper: "Combining Analyses, Combining Optimizations" (1995)
//   Cooper & Torczon: "Engineering a Compiler" (2011), Ch. 9-10

// ============================================================================
// Section 1: Constants
// ============================================================================

use ir::ir::*
use ir::normalize::*
let CP_MAX_REGS: i64 = 4096
let CP_MAX_WORKLIST: i64 = 4096
let CP_MAX_INSTRS: i64 = 8192
let CP_MAX_BLOCKS: i64 = 512
let CP_MAX_PHI_INPUTS: i64 = 8
let CP_MAX_SUCCS: i64 = 8
let CP_MAX_PREDS: i64 = 8
let CP_INVALID: i64 = 0 - 1

// Lattice kinds:
//   TOP    = not yet evaluated / unreachable (optimistic assumption)
//   CONST  = known constant value
//   BOTTOM = varying / multiple possible values
let CP_TOP: i64 = 0
let CP_CONST: i64 = 1
let CP_BOTTOM: i64 = 2

// Opcode tags for instruction classification (integer comparison, no enums).
let CP_OP_NOP: i64 = 0
let CP_OP_LOAD_IMM: i64 = 1
let CP_OP_LOAD_FLOAT: i64 = 2
let CP_OP_LOAD_BOOL: i64 = 3
let CP_OP_LOAD_STRING: i64 = 4
let CP_OP_COPY: i64 = 5
let CP_OP_BINOP: i64 = 6
let CP_OP_UNARYOP: i64 = 7
let CP_OP_CALL: i64 = 8
let CP_OP_RETURN: i64 = 9
let CP_OP_JUMP: i64 = 10
let CP_OP_BRANCH_TRUE: i64 = 11
let CP_OP_BRANCH_FALSE: i64 = 12
let CP_OP_FIELD_GET: i64 = 13
let CP_OP_FIELD_SET: i64 = 14
let CP_OP_INDEX_GET: i64 = 15
let CP_OP_INDEX_SET: i64 = 16
let CP_OP_ALLOC: i64 = 17
let CP_OP_LABEL: i64 = 18
let CP_OP_PHI: i64 = 19

// Binary operation tags for constant folding.
let CP_BINOP_ADD: i64 = 1
let CP_BINOP_SUB: i64 = 2
let CP_BINOP_MUL: i64 = 3
let CP_BINOP_DIV: i64 = 4
let CP_BINOP_MOD: i64 = 5
let CP_BINOP_AND: i64 = 6
let CP_BINOP_OR: i64 = 7
let CP_BINOP_XOR: i64 = 8
let CP_BINOP_SHL: i64 = 9
let CP_BINOP_SHR: i64 = 10
let CP_BINOP_EQ: i64 = 11
let CP_BINOP_NE: i64 = 12
let CP_BINOP_LT: i64 = 13
let CP_BINOP_GT: i64 = 14
let CP_BINOP_LE: i64 = 15
let CP_BINOP_GE: i64 = 16
let CP_BINOP_BIT_AND: i64 = 17
let CP_BINOP_BIT_OR: i64 = 18
// Unsigned counterparts for /, %, >> — Findings 11 (#2084). Distinct tags so
// cp_fold_binop_int can use unsigned arithmetic semantics instead of i64
// signed truncating semantics. Folding an unsigned op with the signed tag
// would re-introduce the same bug at compile time and the witness would not
// fire because the runner does not see the unsigned instruction it should
// have been.
let CP_BINOP_UDIV: i64 = 19
let CP_BINOP_UMOD: i64 = 20
let CP_BINOP_USHR: i64 = 21

// ============================================================================
// Section 2: Data Structures
// ============================================================================

// Lattice value for a single register.
// kind: CP_TOP, CP_CONST, or CP_BOTTOM
// int_val / float_val / bool_val: the constant value when kind == CP_CONST
// is_int / is_float / is_bool: which type of constant is held
struct CpLattice {
    kind: i64,
    int_val: i64,
    float_val: f64,
    bool_val: bool,
    is_int: bool,
    is_float: bool,
    is_bool: bool,
}

// Lattice values for all registers.
struct CpState {
    values: [CpLattice; 4096],
    reg_count: i64,
}

// Worklist of instruction indices to re-evaluate.
struct CpWorklist {
    indices: [i64; 4096],
    count: i64,
}

// Statistics about the constant propagation pass.
struct CpStats {
    folded_ops: i64,
    folded_branches: i64,
    eliminated_unreachable: i64,
    propagated_copies: i64,
    strength_reduced: i64,
    phi_folded: i64,
    total_instrs: i64,
    iterations: i64,
}

// Cached instruction info for analysis.
pub struct CpInstr {
    idx: i64,
    opcode: i64,
    dst: i64,
    src1: i64,
    src2: i64,
    imm_int: i64,
    imm_float: f64,
    imm_bool: bool,
    binop_tag: i64,
    label_id: i64,
    block_id: i64,
    phi_inputs: [i64; 8],
    phi_count: i64,
}

// Block reachability information.
struct CpBlock {
    block_id: i64,
    instr_start: i64,
    instr_count: i64,
    is_reachable: bool,
    succ_count: i64,
    succs: [i64; 8],
    pred_count: i64,
    preds: [i64; 8],
}

// Overall context for the constant propagation pass.
struct CpContext {
    state: CpState,
    worklist: CpWorklist,
    stats: CpStats,
    instrs: [CpInstr; 8192],
    instr_count: i64,
    blocks: [CpBlock; 512],
    block_count: i64,
    block_reachable: [bool; 512],
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn cp_lattice_top() -> CpLattice {
    CpLattice {
        kind: CP_TOP,
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        is_int: false,
        is_float: false,
        is_bool: false,
    }
}

fn cp_lattice_bottom() -> CpLattice {
    CpLattice {
        kind: CP_BOTTOM,
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        is_int: false,
        is_float: false,
        is_bool: false,
    }
}

fn cp_lattice_int(val: i64) -> CpLattice {
    CpLattice {
        kind: CP_CONST,
        int_val: val,
        float_val: 0.0,
        bool_val: false,
        is_int: true,
        is_float: false,
        is_bool: false,
    }
}

fn cp_lattice_float(val: f64) -> CpLattice {
    CpLattice {
        kind: CP_CONST,
        int_val: 0,
        float_val: val,
        bool_val: false,
        is_int: false,
        is_float: true,
        is_bool: false,
    }
}

fn cp_lattice_bool(val: bool) -> CpLattice {
    CpLattice {
        kind: CP_CONST,
        int_val: 0,
        float_val: 0.0,
        bool_val: val,
        is_int: false,
        is_float: false,
        is_bool: true,
    }
}

// ============================================================================
// Unsigned 64-bit arithmetic (used by cp_fold_binop_int for CP_BINOP_UDIV /
// CP_BINOP_UMOD / CP_BINOP_USHR — Finding 11, #2084).
//
// The CP lattice stores integer values in an i64 `int_val`. For unsigned
// operations we must treat that bit pattern as a u64 magnitude: signed /
// truncates toward zero, signed % follows the dividend's sign, and signed >>
// is arithmetic (sign-fill). All three give the wrong answer on operands whose
// bit 63 is set, which is precisely the regime the unsigned witness exercises.
//
// We implement u64 division and modulo via 64-step binary long division (no
// 128-bit primitive). Each helper accepts two i64 operands whose bit patterns
// are interpreted as u64 and returns an i64 whose bit pattern is the u64
// result.
// ============================================================================

// Unsigned 64-bit division. Inputs interpreted as u64; result bit pattern is
// `a_u64 / b_u64`. Caller must ensure b != 0.
fn cp_u64_div(a: i64, b: i64) -> i64 with Div, Panic {
    var q: i64 = 0
    var r: i64 = 0
    var i: i64 = 0
    while i < 64 {
        let bit_pos: i64 = 63 - i
        let bit: i64 = (a >> bit_pos) & 1
        r = (r << 1) | bit
        if r >= b {
            r = r - b
            q = q | (1 << bit_pos)
        }
        i = i + 1
    }
    q
}

// Unsigned 64-bit modulo. Caller must ensure b != 0.
fn cp_u64_mod(a: i64, b: i64) -> i64 with Div, Panic {
    var r: i64 = 0
    var i: i64 = 0
    while i < 64 {
        let bit_pos: i64 = 63 - i
        let bit: i64 = (a >> bit_pos) & 1
        r = (r << 1) | bit
        if r >= b {
            r = r - b
        }
        i = i + 1
    }
    r
}

// Unsigned (logical) shift-right of an i64 bit pattern treated as u64 by `n`.
// Caller must ensure 0 <= n <= 63 (other ranges are guarded in
// cp_fold_binop_int and return BOTTOM).
fn cp_u64_shr(a: i64, n: i64) -> i64 with Div, Panic {
    if n >= 64 {
        return 0
    }
    if n <= 0 {
        return a
    }
    // Sounio's >> is arithmetic (sar on x86): it sign-fills the high bits.
    // To recover the logical shift, perform the arithmetic shift and then
    // mask off the top n bits, which arithmetic shift may have copied from
    // bit 63. The mask (1 << (64 - n)) - 1 is positive for n in 1..63.
    let shifted: i64 = a >> n
    let mask: i64 = (1 << (64 - n)) - 1
    shifted & mask
}

fn cp_state_new() -> CpState {
    CpState {
        values: [cp_lattice_top(); 4096],
        reg_count: 0,
    }
}

fn cp_worklist_new() -> CpWorklist {
    CpWorklist {
        indices: [0; 4096],
        count: 0,
    }
}

fn cp_stats_new() -> CpStats {
    CpStats {
        folded_ops: 0,
        folded_branches: 0,
        eliminated_unreachable: 0,
        propagated_copies: 0,
        strength_reduced: 0,
        phi_folded: 0,
        total_instrs: 0,
        iterations: 0,
    }
}

fn cp_instr_new() -> CpInstr {
    CpInstr {
        idx: CP_INVALID,
        opcode: CP_OP_NOP,
        dst: CP_INVALID,
        src1: CP_INVALID,
        src2: CP_INVALID,
        imm_int: 0,
        imm_float: 0.0,
        imm_bool: false,
        binop_tag: 0,
        label_id: CP_INVALID,
        block_id: CP_INVALID,
        phi_inputs: [CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID,
                     CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID],
        phi_count: 0,
    }
}

fn cp_block_new() -> CpBlock {
    CpBlock {
        block_id: CP_INVALID,
        instr_start: 0,
        instr_count: 0,
        is_reachable: false,
        succ_count: 0,
        succs: [CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID,
                CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID],
        pred_count: 0,
        preds: [CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID,
                CP_INVALID, CP_INVALID, CP_INVALID, CP_INVALID],
    }
}

fn cp_context_new() -> CpContext {
    CpContext {
        state: cp_state_new(),
        worklist: cp_worklist_new(),
        stats: cp_stats_new(),
        instrs: [cp_instr_new(); 8192],
        instr_count: 0,
        blocks: [cp_block_new(); 512],
        block_count: 0,
        block_reachable: [false; 512],
    }
}

// ============================================================================
// Section 4: Lattice Operations
// ============================================================================

// Check if two lattice values are equal.
fn cp_lattice_eq(a: CpLattice, b: CpLattice) -> bool {
    if a.kind != b.kind {
        return false
    }
    if a.kind != CP_CONST {
        return true
    }
    // Both are CONST -- compare values by type
    if a.is_int && b.is_int {
        return a.int_val == b.int_val
    }
    if a.is_float && b.is_float {
        return a.float_val == b.float_val
    }
    if a.is_bool && b.is_bool {
        return a.bool_val == b.bool_val
    }
    // Different types of constants
    false
}

// Meet operation on the lattice:
//   TOP   meet x     = x
//   x     meet TOP   = x
//   x     meet BOTTOM = BOTTOM
//   BOTTOM meet x     = BOTTOM
//   c1    meet c2    = c1 if c1 == c2, else BOTTOM
fn cp_lattice_meet(a: CpLattice, b: CpLattice) -> CpLattice {
    // TOP meet x = x
    if a.kind == CP_TOP {
        return b
    }
    // x meet TOP = x
    if b.kind == CP_TOP {
        return a
    }
    // BOTTOM meet x = BOTTOM
    if a.kind == CP_BOTTOM {
        return cp_lattice_bottom()
    }
    // x meet BOTTOM = BOTTOM
    if b.kind == CP_BOTTOM {
        return cp_lattice_bottom()
    }
    // Both CONST: equal -> keep, otherwise BOTTOM
    if cp_lattice_eq(a, b) {
        return a
    }
    cp_lattice_bottom()
}

// Check if a lattice value is TOP.
fn cp_is_top(lat: CpLattice) -> bool {
    lat.kind == CP_TOP
}

// Check if a lattice value is CONST.
fn cp_is_const(lat: CpLattice) -> bool {
    lat.kind == CP_CONST
}

// Check if a lattice value is BOTTOM.
fn cp_is_bottom(lat: CpLattice) -> bool {
    lat.kind == CP_BOTTOM
}

// Check if a lattice value is a constant integer.
fn cp_is_const_int(lat: CpLattice) -> bool {
    if lat.kind != CP_CONST {
        return false
    }
    lat.is_int
}

// Check if a lattice value is a constant boolean.
fn cp_is_const_bool(lat: CpLattice) -> bool {
    if lat.kind != CP_CONST {
        return false
    }
    lat.is_bool
}

// Check if a lattice value is a constant float.
fn cp_is_const_float(lat: CpLattice) -> bool {
    if lat.kind != CP_CONST {
        return false
    }
    lat.is_float
}

// ============================================================================
// Section 5: Opcode Classification
// ============================================================================

// Map an IrOpcode to our integer opcode tag.
fn cp_classify_opcode(op: IrOpcode) -> i64 {
    if opcodes_equal(op, IrOpcode::IrLoadImm) { return CP_OP_LOAD_IMM }
    if opcodes_equal(op, IrOpcode::IrLoadFloat) { return CP_OP_LOAD_FLOAT }
    if opcodes_equal(op, IrOpcode::IrLoadBool) { return CP_OP_LOAD_BOOL }
    if opcodes_equal(op, IrOpcode::IrLoadString) { return CP_OP_LOAD_STRING }
    if opcodes_equal(op, IrOpcode::IrCopy) { return CP_OP_COPY }
    if opcodes_equal(op, IrOpcode::IrBinOp) { return CP_OP_BINOP }
    if opcodes_equal(op, IrOpcode::IrUnaryOp) { return CP_OP_UNARYOP }
    if opcodes_equal(op, IrOpcode::IrCall) { return CP_OP_CALL }
    if opcodes_equal(op, IrOpcode::IrCallSret) { return CP_OP_CALL }
    if opcodes_equal(op, IrOpcode::IrReturn) { return CP_OP_RETURN }
    if opcodes_equal(op, IrOpcode::IrReturnSret) { return CP_OP_RETURN }
    if opcodes_equal(op, IrOpcode::IrJump) { return CP_OP_JUMP }
    if opcodes_equal(op, IrOpcode::IrBranchTrue) { return CP_OP_BRANCH_TRUE }
    if opcodes_equal(op, IrOpcode::IrBranchFalse) { return CP_OP_BRANCH_FALSE }
    if opcodes_equal(op, IrOpcode::IrFieldGet) { return CP_OP_FIELD_GET }
    if opcodes_equal(op, IrOpcode::IrFieldSet) { return CP_OP_FIELD_SET }
    if opcodes_equal(op, IrOpcode::IrIndexGet) { return CP_OP_INDEX_GET }
    if opcodes_equal(op, IrOpcode::IrIndexSet) { return CP_OP_INDEX_SET }
    if opcodes_equal(op, IrOpcode::IrAlloc) { return CP_OP_ALLOC }
    if opcodes_equal(op, IrOpcode::IrLabel) { return CP_OP_LABEL }
    if opcodes_equal(op, IrOpcode::IrPhi) { return CP_OP_PHI }
    CP_OP_NOP
}

// Map a BinaryOp to our integer binop tag.
fn cp_classify_binop(op: BinaryOp) -> i64 {
    if op == BinaryOp::OpAdd { return CP_BINOP_ADD }
    if op == BinaryOp::OpSub { return CP_BINOP_SUB }
    if op == BinaryOp::OpMul { return CP_BINOP_MUL }
    if op == BinaryOp::OpDiv { return CP_BINOP_DIV }
    if op == BinaryOp::OpUDiv { return CP_BINOP_UDIV }
    if op == BinaryOp::OpRem { return CP_BINOP_MOD }
    if op == BinaryOp::OpURem { return CP_BINOP_UMOD }
    if op == BinaryOp::OpEq { return CP_BINOP_EQ }
    if op == BinaryOp::OpNe { return CP_BINOP_NE }
    if op == BinaryOp::OpLt { return CP_BINOP_LT }
    if op == BinaryOp::OpGt { return CP_BINOP_GT }
    if op == BinaryOp::OpLe { return CP_BINOP_LE }
    if op == BinaryOp::OpGe { return CP_BINOP_GE }
    if op == BinaryOp::OpAnd { return CP_BINOP_AND }
    if op == BinaryOp::OpOr { return CP_BINOP_OR }
    if op == BinaryOp::OpBitAnd { return CP_BINOP_BIT_AND }
    if op == BinaryOp::OpBitOr { return CP_BINOP_BIT_OR }
    if op == BinaryOp::OpBitXor { return CP_BINOP_XOR }
    if op == BinaryOp::OpShl { return CP_BINOP_SHL }
    if op == BinaryOp::OpShr { return CP_BINOP_SHR }
    if op == BinaryOp::OpUShr { return CP_BINOP_USHR }
    0
}

// Check if an opcode has side effects.
fn cp_has_side_effect(opcode: i64) -> bool {
    if opcode == CP_OP_CALL { return true }
    if opcode == CP_OP_RETURN { return true }
    if opcode == CP_OP_JUMP { return true }
    if opcode == CP_OP_BRANCH_TRUE { return true }
    if opcode == CP_OP_BRANCH_FALSE { return true }
    if opcode == CP_OP_FIELD_SET { return true }
    if opcode == CP_OP_INDEX_SET { return true }
    if opcode == CP_OP_LABEL { return true }
    if opcode == CP_OP_ALLOC { return true }
    false
}

// Check if an opcode is a branch or jump (block terminator).
fn cp_is_terminator(opcode: i64) -> bool {
    if opcode == CP_OP_JUMP { return true }
    if opcode == CP_OP_BRANCH_TRUE { return true }
    if opcode == CP_OP_BRANCH_FALSE { return true }
    if opcode == CP_OP_RETURN { return true }
    false
}

// Check if an opcode is a conditional branch.
fn cp_is_conditional_branch(opcode: i64) -> bool {
    if opcode == CP_OP_BRANCH_TRUE { return true }
    if opcode == CP_OP_BRANCH_FALSE { return true }
    false
}

// ============================================================================
// Section 6: State Operations
// ============================================================================

// Get the lattice value for a register.
fn cp_get_reg(state: &CpState, reg: i64) -> CpLattice with Div, Panic {
    if reg < 0 || reg >= CP_MAX_REGS {
        return cp_lattice_bottom()
    }
    state.values[reg as usize]
}

// Set the lattice value for a register.  Returns true if the value changed.
fn cp_set_reg(state: &! CpState, reg: i64, val: CpLattice) -> bool with Mut, Div, Panic {
    if reg < 0 || reg >= CP_MAX_REGS {
        return false
    }
    let old = state.values[reg as usize]
    if cp_lattice_eq(old, val) {
        return false
    }
    state.values[reg as usize] = val
    if reg >= state.reg_count {
        state.reg_count = reg + 1
    }
    true
}

// ============================================================================
// Section 7: Worklist Operations
// ============================================================================

// Push an instruction index onto the worklist.
fn cp_worklist_push(wl: &! CpWorklist, idx: i64) -> bool with Mut, Div, Panic {
    if wl.count >= CP_MAX_WORKLIST {
        return false
    }
    if idx < 0 {
        return false
    }
    // Check for duplicates (linear scan; fine for bounded worklist)
    var i: i64 = 0
    while i < wl.count {
        if wl.indices[i as usize] == idx {
            return false
        }
        i = i + 1
    }
    wl.indices[wl.count as usize] = idx
    wl.count = wl.count + 1
    true
}

// Pop an instruction index from the worklist.  Returns CP_INVALID if empty.
fn cp_worklist_pop(wl: &! CpWorklist) -> i64 with Mut, Div, Panic {
    if wl.count <= 0 {
        return CP_INVALID
    }
    wl.count = wl.count - 1
    wl.indices[wl.count as usize]
}

// Check if the worklist is empty.
fn cp_worklist_empty(wl: &CpWorklist) -> bool {
    wl.count <= 0
}

// Clear the worklist.
fn cp_worklist_clear(wl: &! CpWorklist) -> i64 with Mut {
    wl.count = 0
    0
}

// Nested field mutation on ctx.state / ctx.worklist does not persist reliably
// through direct borrows in this runtime, so copy out and write back explicitly.
fn cp_ctx_set_reg(ctx: &! CpContext, reg: i64, val: CpLattice) -> bool with Mut, Div, Panic {
    var state = ctx.state
    let changed = cp_set_reg(&! state, reg, val)
    ctx.state = state
    changed
}

fn cp_ctx_update_reg(ctx: &! CpContext, dst: i64, new_val: CpLattice) -> bool with Mut, Div, Panic {
    var state = ctx.state
    let changed = cp_update_reg(&! state, dst, new_val)
    ctx.state = state
    changed
}

fn cp_ctx_worklist_push(ctx: &! CpContext, idx: i64) -> bool with Mut, Div, Panic {
    var wl = ctx.worklist
    let pushed = cp_worklist_push(&! wl, idx)
    ctx.worklist = wl
    pushed
}

fn cp_ctx_worklist_pop(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    var wl = ctx.worklist
    let idx = cp_worklist_pop(&! wl)
    ctx.worklist = wl
    idx
}

// ============================================================================
// Section 8: Constant Folding -- Binary Operations
// ============================================================================

// Fold a binary operation on two known integer constants.
// Returns a CpLattice: CONST with the result, or BOTTOM if cannot fold.
fn cp_fold_binop_int(op: i64, a: i64, b: i64) -> CpLattice with Div, Panic {
    if op == CP_BINOP_ADD {
        return cp_lattice_int(a + b)
    }
    if op == CP_BINOP_SUB {
        return cp_lattice_int(a - b)
    }
    if op == CP_BINOP_MUL {
        return cp_lattice_int(a * b)
    }
    if op == CP_BINOP_DIV {
        if b == 0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_int(a / b)
    }
    if op == CP_BINOP_MOD {
        if b == 0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_int(a % b)
    }
    if op == CP_BINOP_BIT_AND {
        return cp_lattice_int(a & b)
    }
    if op == CP_BINOP_BIT_OR {
        return cp_lattice_int(a | b)
    }
    if op == CP_BINOP_XOR {
        return cp_lattice_int(a ^ b)
    }
    if op == CP_BINOP_SHL {
        if b >= 0 && b < 64 {
            return cp_lattice_int(a << b)
        }
        return cp_lattice_bottom()
    }
    if op == CP_BINOP_SHR {
        if b >= 0 && b < 64 {
            return cp_lattice_int(a >> b)
        }
        return cp_lattice_bottom()
    }
    // Findings 11 (#2084): unsigned variants must fold with UNSIGNED semantics.
    // The lattice int_val is still i64-bit-pattern, but the arithmetic is the
    // unsigned magnitude. The witnesses u64_unsigned_shr_divmod_witness.sio
    // (run-pass) and the Finding 11 unit test in test_const_prop.sio both
    // rely on these three arms being correct: folding with the signed tag
    // would move the bug from runtime to compile time.
    if op == CP_BINOP_UDIV {
        if b == 0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_int(cp_u64_div(a, b))
    }
    if op == CP_BINOP_UMOD {
        if b == 0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_int(cp_u64_mod(a, b))
    }
    if op == CP_BINOP_USHR {
        // Unsigned shift semantics: 0 <= b < 64 takes the cp_u64_shr branch;
        // b >= 64 is the well-defined ZERO result (logical shift past the
        // width loses all bits). b < 0 stays BOTTOM (negative shift count
        // is meaningless). Folding b >= 64 to 0 here matters for testing
        // AND for downstream consumers that rely on the const to know the
        // result: the runtime `shr rax,cl` instruction masks cl by 64 (cl
        // is only 6 bits wide), so count=64 would silently be count=0
        // and yield the unchanged original bit pattern at run time -- a
        // wrong answer that the fold step has to pre-empt.
        if b < 0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_int(cp_u64_shr(a, b))
    }
    if op == CP_BINOP_EQ {
        if a == b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_NE {
        if a != b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_LT {
        if a < b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_GT {
        if a > b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_LE {
        if a <= b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_GE {
        if a >= b { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_AND {
        let la = if a != 0 { 1 } else { 0 }
        let lb = if b != 0 { 1 } else { 0 }
        if la == 1 && lb == 1 { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    if op == CP_BINOP_OR {
        let la = if a != 0 { 1 } else { 0 }
        let lb = if b != 0 { 1 } else { 0 }
        if la == 1 || lb == 1 { return cp_lattice_int(1) } else { return cp_lattice_int(0) }
    }
    cp_lattice_bottom()
}

// Fold a binary operation on two known float constants.
fn cp_fold_binop_float(op: i64, a: f64, b: f64) -> CpLattice with Div, Panic {
    if op == CP_BINOP_ADD {
        return cp_lattice_float(a + b)
    }
    if op == CP_BINOP_SUB {
        return cp_lattice_float(a - b)
    }
    if op == CP_BINOP_MUL {
        return cp_lattice_float(a * b)
    }
    if op == CP_BINOP_DIV {
        if b == 0.0 {
            return cp_lattice_bottom()
        }
        return cp_lattice_float(a / b)
    }
    cp_lattice_bottom()
}

// ============================================================================
// Section 9: Strength Reduction
// ============================================================================

// Try strength reduction on a binary op where we know at least one operand.
// Returns: (reduced: bool, result_kind: i64, result_int: i64, copy_src: i64)
//   reduced = true if we found a strength reduction
//   result_kind = 0 for "load constant", 1 for "copy reg", 2 for "add self"
//   result_int = the constant for kind 0
//   copy_src = the register for kind 1 or 2
struct CpStrengthResult {
    reduced: bool,
    result_kind: i64,
    result_int: i64,
    copy_src: i64,
}

fn cp_strength_result_none() -> CpStrengthResult {
    CpStrengthResult {
        reduced: false,
        result_kind: 0,
        result_int: 0,
        copy_src: CP_INVALID,
    }
}

fn cp_try_strength_reduce(op: i64, src1: i64, src2: i64,
                          s1_const: bool, s2_const: bool,
                          s1_val: i64, s2_val: i64) -> CpStrengthResult {
    // Multiplication strength reductions
    if op == CP_BINOP_MUL {
        // x * 0 -> 0
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 0, result_int: 0, copy_src: CP_INVALID }
        }
        // 0 * x -> 0
        if s1_const && s1_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 0, result_int: 0, copy_src: CP_INVALID }
        }
        // x * 1 -> x
        if s2_const && s2_val == 1 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        // 1 * x -> x
        if s1_const && s1_val == 1 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src2 }
        }
        // x * 2 -> x + x
        if s2_const && s2_val == 2 {
            return CpStrengthResult { reduced: true, result_kind: 2, result_int: 0, copy_src: src1 }
        }
        // 2 * x -> x + x
        if s1_const && s1_val == 2 {
            return CpStrengthResult { reduced: true, result_kind: 2, result_int: 0, copy_src: src2 }
        }
        return cp_strength_result_none()
    }

    // Addition strength reductions
    if op == CP_BINOP_ADD {
        // x + 0 -> x
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        // 0 + x -> x
        if s1_const && s1_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src2 }
        }
        return cp_strength_result_none()
    }

    // Subtraction strength reductions
    if op == CP_BINOP_SUB {
        // x - 0 -> x
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        return cp_strength_result_none()
    }

    // Division strength reductions
    if op == CP_BINOP_DIV {
        // x / 1 -> x
        if s2_const && s2_val == 1 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        return cp_strength_result_none()
    }

    // Shift strength reductions
    if op == CP_BINOP_SHL {
        // x << 0 -> x
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        return cp_strength_result_none()
    }
    if op == CP_BINOP_SHR {
        // x >> 0 -> x
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        return cp_strength_result_none()
    }

    // Bitwise AND strength reductions
    if op == CP_BINOP_BIT_AND {
        // x & 0 -> 0
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 0, result_int: 0, copy_src: CP_INVALID }
        }
        // 0 & x -> 0
        if s1_const && s1_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 0, result_int: 0, copy_src: CP_INVALID }
        }
        return cp_strength_result_none()
    }

    // Bitwise OR strength reductions
    if op == CP_BINOP_BIT_OR {
        // x | 0 -> x
        if s2_const && s2_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src1 }
        }
        // 0 | x -> x
        if s1_const && s1_val == 0 {
            return CpStrengthResult { reduced: true, result_kind: 1, result_int: 0, copy_src: src2 }
        }
        return cp_strength_result_none()
    }

    cp_strength_result_none()
}

// ============================================================================
// Section 10: Instruction Evaluation
// ============================================================================

// Evaluate a single instruction and return the lattice value for its destination.
fn cp_eval_instr(ctx: &CpContext, ci: CpInstr) -> CpLattice with Mut, Div, Panic {
    let opc = ci.opcode

    // Load immediate integer
    if opc == CP_OP_LOAD_IMM {
        return cp_lattice_int(ci.imm_int)
    }

    // Load float
    if opc == CP_OP_LOAD_FLOAT {
        return cp_lattice_float(ci.imm_float)
    }

    // Load bool
    if opc == CP_OP_LOAD_BOOL {
        return cp_lattice_bool(ci.imm_bool)
    }

    // Copy: propagate source lattice
    if opc == CP_OP_COPY {
        if ci.src1 >= 0 && ci.src1 < CP_MAX_REGS {
            return cp_get_reg(&ctx.state, ci.src1)
        }
        return cp_lattice_bottom()
    }

    // Binary operation
    if opc == CP_OP_BINOP {
        let lat1 = if ci.src1 >= 0 && ci.src1 < CP_MAX_REGS {
            cp_get_reg(&ctx.state, ci.src1)
        } else {
            cp_lattice_bottom()
        }
        let lat2 = if ci.src2 >= 0 && ci.src2 < CP_MAX_REGS {
            cp_get_reg(&ctx.state, ci.src2)
        } else {
            cp_lattice_bottom()
        }

        // If either is BOTTOM, result is BOTTOM
        if cp_is_bottom(lat1) || cp_is_bottom(lat2) {
            // But try strength reduction first
            let s1_const = cp_is_const_int(lat1)
            let s2_const = cp_is_const_int(lat2)
            let s1_val = if s1_const { lat1.int_val } else { 0 }
            let s2_val = if s2_const { lat2.int_val } else { 0 }
            let sr = cp_try_strength_reduce(ci.binop_tag, ci.src1, ci.src2,
                                            s1_const, s2_const, s1_val, s2_val)
            if sr.reduced {
                if sr.result_kind == 0 {
                    // Load constant
                    return cp_lattice_int(sr.result_int)
                }
                // Otherwise cannot determine constant from strength reduction alone
            }
            return cp_lattice_bottom()
        }

        // If either is TOP, result is TOP (optimistic)
        if cp_is_top(lat1) || cp_is_top(lat2) {
            return cp_lattice_top()
        }

        // Both CONST: fold
        if cp_is_const_int(lat1) && cp_is_const_int(lat2) {
            return cp_fold_binop_int(ci.binop_tag, lat1.int_val, lat2.int_val)
        }
        if cp_is_const_float(lat1) && cp_is_const_float(lat2) {
            return cp_fold_binop_float(ci.binop_tag, lat1.float_val, lat2.float_val)
        }

        return cp_lattice_bottom()
    }

    // Phi: meet all inputs
    if opc == CP_OP_PHI {
        var result = cp_lattice_top()
        var p: i64 = 0
        while p < ci.phi_count {
            let input_reg = ci.phi_inputs[p as usize]
            if input_reg >= 0 && input_reg < CP_MAX_REGS {
                let input_lat = cp_get_reg(&ctx.state, input_reg)
                result = cp_lattice_meet(result, input_lat)
            }
            p = p + 1
        }
        return result
    }

    // Call, alloc, field_get, index_get, load_string: result is BOTTOM (unknown)
    if opc == CP_OP_CALL || opc == CP_OP_ALLOC || opc == CP_OP_FIELD_GET ||
       opc == CP_OP_INDEX_GET || opc == CP_OP_LOAD_STRING {
        return cp_lattice_bottom()
    }

    // Unary operation
    if opc == CP_OP_UNARYOP {
        let lat1 = if ci.src1 >= 0 && ci.src1 < CP_MAX_REGS {
            cp_get_reg(&ctx.state, ci.src1)
        } else {
            cp_lattice_bottom()
        }
        if cp_is_bottom(lat1) { return cp_lattice_bottom() }
        if cp_is_top(lat1) { return cp_lattice_top() }
        if cp_is_const_int(lat1) {
            // Negate
            return cp_lattice_int(0 - lat1.int_val)
        }
        return cp_lattice_bottom()
    }

    // Default: anything else that defines a register is BOTTOM
    cp_lattice_bottom()
}

// ============================================================================
// Section 11: Populate Context from IrFunction
// ============================================================================

// Extract CpInstr from IrInstr.
fn cp_extract_instr(instr: IrInstr, idx: i64) -> CpInstr with Mut, Div, Panic {
    var ci = cp_instr_new()
    ci.idx = idx
    ci.opcode = cp_classify_opcode(instr.op)
    ci.dst = instr.dst
    ci.src1 = instr.src1
    ci.src2 = instr.src2
    ci.imm_int = instr.imm_i64
    ci.imm_float = instr.imm_f64
    ci.label_id = instr.label_id

    // Bool: stored as imm_i64 == 1 for true
    if ci.opcode == CP_OP_LOAD_BOOL {
        ci.imm_bool = instr.imm_i64 != 0
    }

    // Classify binary op
    if ci.opcode == CP_OP_BINOP {
        ci.binop_tag = cp_classify_binop(instr.bin_op)
    }

    // For phi nodes, inputs are stored in src1 and src2
    if ci.opcode == CP_OP_PHI {
        var pc: i64 = 0
        if instr.src1 >= 0 && instr.src1 < CP_MAX_REGS {
            ci.phi_inputs[pc as usize] = instr.src1
            pc = pc + 1
        }
        if instr.src2 >= 0 && instr.src2 < CP_MAX_REGS {
            ci.phi_inputs[pc as usize] = instr.src2
            pc = pc + 1
        }
        ci.phi_count = pc
    }

    // For branches/jumps, store label_id as block_id
    if ci.opcode == CP_OP_JUMP || ci.opcode == CP_OP_BRANCH_TRUE || ci.opcode == CP_OP_BRANCH_FALSE {
        ci.block_id = instr.label_id
    }

    ci
}

// Populate the CpContext from an IrFunction.
fn cp_populate(ctx: &! CpContext, func: &IrFunction) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < func.instr_count && i < CP_MAX_INSTRS {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        ctx.instrs[i as usize] = cp_extract_instr(instr, i)
        i = i + 1
    }
    ctx.instr_count = i
    ctx.stats.total_instrs = i
    i
}

// ============================================================================
// Section 12: Block Structure
// ============================================================================

// Build block structure from instruction list.
fn cp_build_blocks(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    var bc: i64 = 0

    // Block 0 always exists as entry block
    if ctx.instr_count > 0 {
        ctx.blocks[0].block_id = 0
        ctx.blocks[0].instr_start = 0
        ctx.blocks[0].is_reachable = true
        ctx.block_reachable[0] = true
        bc = 1
    }

    // Scan for labels to start new blocks
    var i: i64 = 0
    while i < ctx.instr_count {
        if ctx.instrs[i as usize].opcode == CP_OP_LABEL {
            // Close previous block
            if bc > 0 {
                let prev = bc - 1
                ctx.blocks[prev as usize].instr_count = i - ctx.blocks[prev as usize].instr_start
            }
            // Start new block
            if bc < CP_MAX_BLOCKS {
                ctx.blocks[bc as usize].block_id = bc
                ctx.blocks[bc as usize].instr_start = i
                ctx.blocks[bc as usize].is_reachable = false
                ctx.block_reachable[bc as usize] = false
                bc = bc + 1
            }
        }
        i = i + 1
    }

    // Close last block
    if bc > 0 {
        let last = bc - 1
        ctx.blocks[last as usize].instr_count = ctx.instr_count - ctx.blocks[last as usize].instr_start
    }

    ctx.block_count = bc
    bc
}

// Build block edges by scanning terminators.
fn cp_build_block_edges(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    var edge_count: i64 = 0
    var b: i64 = 0
    while b < ctx.block_count {
        let start = ctx.blocks[b as usize].instr_start
        let count = ctx.blocks[b as usize].instr_count
        let end = start + count

        // Find the last non-NOP instruction
        var last_idx = end - 1
        while last_idx >= start && ctx.instrs[last_idx as usize].opcode == CP_OP_NOP {
            last_idx = last_idx - 1
        }

        if last_idx >= start {
            let opc = ctx.instrs[last_idx as usize].opcode

            // Fall-through to next block if not a terminator
            if cp_is_terminator(opc) == false {
                if b + 1 < ctx.block_count {
                    let sc = ctx.blocks[b as usize].succ_count
                    if sc < CP_MAX_SUCCS {
                        ctx.blocks[b as usize].succs[sc as usize] = b + 1
                        ctx.blocks[b as usize].succ_count = sc + 1
                        let pc = ctx.blocks[(b + 1) as usize].pred_count
                        if pc < CP_MAX_PREDS {
                            ctx.blocks[(b + 1) as usize].preds[pc as usize] = b
                            ctx.blocks[(b + 1) as usize].pred_count = pc + 1
                        }
                        edge_count = edge_count + 1
                    }
                }
            }

            // Conditional branches: target + fallthrough
            if cp_is_conditional_branch(opc) {
                // Fallthrough
                if b + 1 < ctx.block_count {
                    let sc = ctx.blocks[b as usize].succ_count
                    if sc < CP_MAX_SUCCS {
                        ctx.blocks[b as usize].succs[sc as usize] = b + 1
                        ctx.blocks[b as usize].succ_count = sc + 1
                        let pc = ctx.blocks[(b + 1) as usize].pred_count
                        if pc < CP_MAX_PREDS {
                            ctx.blocks[(b + 1) as usize].preds[pc as usize] = b
                            ctx.blocks[(b + 1) as usize].pred_count = pc + 1
                        }
                        edge_count = edge_count + 1
                    }
                }
                // Branch target
                let target_label = ctx.instrs[last_idx as usize].block_id
                if target_label >= 0 {
                    var tb: i64 = 0
                    while tb < ctx.block_count {
                        if ctx.blocks[tb as usize].block_id == target_label {
                            let sc = ctx.blocks[b as usize].succ_count
                            if sc < CP_MAX_SUCCS {
                                ctx.blocks[b as usize].succs[sc as usize] = tb
                                ctx.blocks[b as usize].succ_count = sc + 1
                                let pc = ctx.blocks[tb as usize].pred_count
                                if pc < CP_MAX_PREDS {
                                    ctx.blocks[tb as usize].preds[pc as usize] = b
                                    ctx.blocks[tb as usize].pred_count = pc + 1
                                }
                                edge_count = edge_count + 1
                            }
                        }
                        tb = tb + 1
                    }
                }
            }

            // Unconditional jump
            if opc == CP_OP_JUMP {
                let target_label = ctx.instrs[last_idx as usize].block_id
                if target_label >= 0 {
                    var tb: i64 = 0
                    while tb < ctx.block_count {
                        if ctx.blocks[tb as usize].block_id == target_label {
                            let sc = ctx.blocks[b as usize].succ_count
                            if sc < CP_MAX_SUCCS {
                                ctx.blocks[b as usize].succs[sc as usize] = tb
                                ctx.blocks[b as usize].succ_count = sc + 1
                                let pc = ctx.blocks[tb as usize].pred_count
                                if pc < CP_MAX_PREDS {
                                    ctx.blocks[tb as usize].preds[pc as usize] = b
                                    ctx.blocks[tb as usize].pred_count = pc + 1
                                }
                                edge_count = edge_count + 1
                            }
                        }
                        tb = tb + 1
                    }
                }
            }
        }

        b = b + 1
    }
    edge_count
}

// Propagate reachability from entry block.
fn cp_propagate_reachability(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    if ctx.block_count <= 0 {
        return 0
    }
    ctx.blocks[0].is_reachable = true
    ctx.block_reachable[0] = true

    var changed = true
    var reachable_count: i64 = 1
    while changed {
        changed = false
        var b: i64 = 0
        while b < ctx.block_count {
            if ctx.block_reachable[b as usize] {
                var s: i64 = 0
                while s < ctx.blocks[b as usize].succ_count {
                    let succ = ctx.blocks[b as usize].succs[s as usize]
                    if succ >= 0 && succ < ctx.block_count {
                        if ctx.block_reachable[succ as usize] == false {
                            ctx.block_reachable[succ as usize] = true
                            ctx.blocks[succ as usize].is_reachable = true
                            changed = true
                            reachable_count = reachable_count + 1
                        }
                    }
                    s = s + 1
                }
            }
            b = b + 1
        }
    }
    reachable_count
}

// ============================================================================
// Section 13: Branch Folding
// ============================================================================

// If a conditional branch's condition is a known constant, replace it with
// either a jump (condition true for BranchTrue / false for BranchFalse)
// or a NOP (fall through).
// Returns the number of branches folded.
fn cp_fold_branches(ctx: &! CpContext, func: &! IrFunction) -> i64 with Mut, Div, Panic {
    var folded: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]
        if cp_is_conditional_branch(ci.opcode) {
            let cond_reg = ci.src1
            if cond_reg >= 0 && cond_reg < CP_MAX_REGS {
                let cond_lat = cp_get_reg(&ctx.state, cond_reg)
                if cp_is_const_int(cond_lat) {
                    let cond_val = cond_lat.int_val
                    let takes_branch = if ci.opcode == CP_OP_BRANCH_TRUE {
                        cond_val != 0
                    } else {
                        cond_val == 0
                    }
                    if takes_branch {
                        // Replace with unconditional jump
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_jump(ci.label_id))
                        ctx.instrs[i as usize].opcode = CP_OP_JUMP
                    } else {
                        // Branch not taken: replace with NOP (fall through)
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_nop())
                        ctx.instrs[i as usize].opcode = CP_OP_NOP
                    }
                    folded = folded + 1
                } else if cp_is_const_bool(cond_lat) {
                    let cond_val = cond_lat.bool_val
                    let takes_branch = if ci.opcode == CP_OP_BRANCH_TRUE {
                        cond_val
                    } else {
                        cond_val == false
                    }
                    if takes_branch {
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_jump(ci.label_id))
                        ctx.instrs[i as usize].opcode = CP_OP_JUMP
                    } else {
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_nop())
                        ctx.instrs[i as usize].opcode = CP_OP_NOP
                    }
                    folded = folded + 1
                }
            }
        }
        i = i + 1
    }
    ctx.stats.folded_branches = folded
    folded
}

// ============================================================================
// Section 14: Copy Propagation
// ============================================================================

// Propagate constants through copy chains.
// If a copy's source is a known constant, replace the copy with a load of that constant.
fn cp_propagate_copies(ctx: &! CpContext, func: &! IrFunction) -> i64 with Mut, Div, Panic {
    var propagated: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]
        if ci.opcode == CP_OP_COPY {
            let src = ci.src1
            if src >= 0 && src < CP_MAX_REGS {
                let src_lat = cp_get_reg(&ctx.state, src)
                if cp_is_const_int(src_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(ci.dst, src_lat.int_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_IMM
                    ctx.instrs[i as usize].imm_int = src_lat.int_val
                    propagated = propagated + 1
                } else if cp_is_const_float(src_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_float(ci.dst, src_lat.float_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_FLOAT
                    ctx.instrs[i as usize].imm_float = src_lat.float_val
                    propagated = propagated + 1
                } else if cp_is_const_bool(src_lat) {
                    let bval = if src_lat.bool_val { 1 } else { 0 }
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_bool(ci.dst, src_lat.bool_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_BOOL
                    ctx.instrs[i as usize].imm_bool = src_lat.bool_val
                    propagated = propagated + 1
                }
            }
        }
        i = i + 1
    }
    ctx.stats.propagated_copies = propagated
    propagated
}

// ============================================================================
// Section 15: Constant Folding Application
// ============================================================================

// Apply constant folding: replace binary ops with known-constant results
// with load immediate instructions.
fn cp_apply_folding(ctx: &! CpContext, func: &! IrFunction) -> i64 with Mut, Div, Panic {
    var folded: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]

        if ci.opcode == CP_OP_BINOP {
            let dst = ci.dst
            if dst >= 0 && dst < CP_MAX_REGS {
                let dst_lat = cp_get_reg(&ctx.state, dst)
                if cp_is_const_int(dst_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(dst, dst_lat.int_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_IMM
                    ctx.instrs[i as usize].imm_int = dst_lat.int_val
                    folded = folded + 1
                } else if cp_is_const_bool(dst_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_bool(dst, dst_lat.bool_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_BOOL
                    ctx.instrs[i as usize].imm_bool = dst_lat.bool_val
                    folded = folded + 1
                } else if cp_is_const_float(dst_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_float(dst, dst_lat.float_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_FLOAT
                    ctx.instrs[i as usize].imm_float = dst_lat.float_val
                    folded = folded + 1
                }
            }
        }

        if ci.opcode == CP_OP_UNARYOP {
            let dst = ci.dst
            if dst >= 0 && dst < CP_MAX_REGS {
                let dst_lat = cp_get_reg(&ctx.state, dst)
                if cp_is_const_int(dst_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(dst, dst_lat.int_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_IMM
                    ctx.instrs[i as usize].imm_int = dst_lat.int_val
                    folded = folded + 1
                }
            }
        }

        // Phi nodes that resolved to a constant
        if ci.opcode == CP_OP_PHI {
            let dst = ci.dst
            if dst >= 0 && dst < CP_MAX_REGS {
                let dst_lat = cp_get_reg(&ctx.state, dst)
                if cp_is_const_int(dst_lat) {
                    ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(dst, dst_lat.int_val))
                    ctx.instrs[i as usize].opcode = CP_OP_LOAD_IMM
                    ctx.instrs[i as usize].imm_int = dst_lat.int_val
                    folded = folded + 1
                }
            }
        }

        i = i + 1
    }
    ctx.stats.folded_ops = folded
    folded
}

// ============================================================================
// Section 16: Strength Reduction Application
// ============================================================================

// Apply strength reduction to instructions where at least one operand is constant.
fn cp_apply_strength_reduction(ctx: &! CpContext, func: &! IrFunction) -> i64 with Mut, Div, Panic {
    var reduced: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]
        if ci.opcode == CP_OP_BINOP {
            let src1 = ci.src1
            let src2 = ci.src2
            let s1_lat = if src1 >= 0 && src1 < CP_MAX_REGS {
                cp_get_reg(&ctx.state, src1)
            } else {
                cp_lattice_bottom()
            }
            let s2_lat = if src2 >= 0 && src2 < CP_MAX_REGS {
                cp_get_reg(&ctx.state, src2)
            } else {
                cp_lattice_bottom()
            }

            let s1_const = cp_is_const_int(s1_lat)
            let s2_const = cp_is_const_int(s2_lat)
            let s1_val = if s1_const { s1_lat.int_val } else { 0 }
            let s2_val = if s2_const { s2_lat.int_val } else { 0 }

            // Only apply strength reduction when result is NOT already const-folded
            let dst = ci.dst
            let dst_lat = if dst >= 0 && dst < CP_MAX_REGS {
                cp_get_reg(&ctx.state, dst)
            } else {
                cp_lattice_bottom()
            }

            if cp_is_const(dst_lat) == false {
                let sr = cp_try_strength_reduce(ci.binop_tag, src1, src2,
                                                s1_const, s2_const, s1_val, s2_val)
                if sr.reduced {
                    if sr.result_kind == 0 {
                        // Load constant
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_load_imm(dst, sr.result_int))
                        ctx.instrs[i as usize].opcode = CP_OP_LOAD_IMM
                        ctx.instrs[i as usize].imm_int = sr.result_int
                        reduced = reduced + 1
                    } else if sr.result_kind == 1 {
                        // Copy
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_copy(dst, sr.copy_src))
                        ctx.instrs[i as usize].opcode = CP_OP_COPY
                        ctx.instrs[i as usize].src1 = sr.copy_src
                        reduced = reduced + 1
                    } else if sr.result_kind == 2 {
                        // Add self (x + x)
                        ir_arena_store(ir_region_slot_w(func.region, (i)), ir_binop(dst, sr.copy_src, BinaryOp::OpAdd, sr.copy_src))
                        ctx.instrs[i as usize].binop_tag = CP_BINOP_ADD
                        ctx.instrs[i as usize].src1 = sr.copy_src
                        ctx.instrs[i as usize].src2 = sr.copy_src
                        reduced = reduced + 1
                    }
                }
            }
        }
        i = i + 1
    }
    ctx.stats.strength_reduced = reduced
    reduced
}

// ============================================================================
// Section 17: Dead Branch Elimination
// ============================================================================

// Eliminate instructions in unreachable blocks.
fn cp_eliminate_unreachable(ctx: &! CpContext, func: &! IrFunction) -> i64 with Mut, Div, Panic {
    var eliminated: i64 = 0
    var b: i64 = 0
    while b < ctx.block_count {
        if ctx.block_reachable[b as usize] == false {
            let start = ctx.blocks[b as usize].instr_start
            let count = ctx.blocks[b as usize].instr_count
            var j: i64 = 0
            while j < count {
                let idx = start + j
                if idx >= 0 && idx < ctx.instr_count {
                    if ctx.instrs[idx as usize].opcode != CP_OP_NOP {
                        ir_arena_store(ir_region_slot_w(func.region, (idx)), ir_nop())
                        ctx.instrs[idx as usize].opcode = CP_OP_NOP
                        eliminated = eliminated + 1
                    }
                }
                j = j + 1
            }
        }
        b = b + 1
    }
    ctx.stats.eliminated_unreachable = eliminated
    eliminated
}

// ============================================================================
// Section 18: SCCP -- Sparse Conditional Constant Propagation
// ============================================================================

// Find all instructions that use a given register as a source.
// Push them onto the worklist.
fn cp_push_users(ctx: &! CpContext, reg: i64) -> i64 with Mut, Div, Panic {
    var pushed: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]
        var uses_reg = false
        if ci.src1 == reg { uses_reg = true }
        if ci.src2 == reg { uses_reg = true }
        // Check phi inputs
        if ci.opcode == CP_OP_PHI {
            var p: i64 = 0
            while p < ci.phi_count {
                if ci.phi_inputs[p as usize] == reg {
                    uses_reg = true
                }
                p = p + 1
            }
        }
        if uses_reg {
            let ok = cp_ctx_worklist_push(ctx, i)
            if ok { pushed = pushed + 1 }
        }
        i = i + 1
    }
    pushed
}

// Initialize the SCCP analysis: set lattice values for all load_imm, load_float,
// load_bool instructions, then seed the worklist with their users.
fn cp_sccp_init(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    var seeded: i64 = 0
    var i: i64 = 0
    while i < ctx.instr_count {
        let ci = ctx.instrs[i as usize]
        let opc = ci.opcode
        let dst = ci.dst

        if opc == CP_OP_LOAD_IMM {
            if dst >= 0 && dst < CP_MAX_REGS {
                let changed = cp_ctx_set_reg(ctx, dst, cp_lattice_int(ci.imm_int))
                if changed {
                    let p = cp_push_users(ctx, dst)
                    seeded = seeded + p
                }
            }
        } else if opc == CP_OP_LOAD_FLOAT {
            if dst >= 0 && dst < CP_MAX_REGS {
                let changed = cp_ctx_set_reg(ctx, dst, cp_lattice_float(ci.imm_float))
                if changed {
                    let p = cp_push_users(ctx, dst)
                    seeded = seeded + p
                }
            }
        } else if opc == CP_OP_LOAD_BOOL {
            if dst >= 0 && dst < CP_MAX_REGS {
                let changed = cp_ctx_set_reg(ctx, dst, cp_lattice_bool(ci.imm_bool))
                if changed {
                    let p = cp_push_users(ctx, dst)
                    seeded = seeded + p
                }
            }
        } else if opc == CP_OP_CALL || opc == CP_OP_ALLOC || opc == CP_OP_FIELD_GET ||
                  opc == CP_OP_INDEX_GET || opc == CP_OP_LOAD_STRING {
            // These produce unknown values
            if dst >= 0 && dst < CP_MAX_REGS {
                let changed = cp_ctx_set_reg(ctx, dst, cp_lattice_bottom())
                if changed {
                    let p = cp_push_users(ctx, dst)
                    seeded = seeded + p
                }
            }
        }

        i = i + 1
    }
    seeded
}

// Read-merge-write a register via mutable state reference (avoids sub-borrow conflict).
fn cp_update_reg(state: &! CpState, dst: i64, new_val: CpLattice) -> bool with Mut, Div, Panic {
    if dst < 0 || dst >= CP_MAX_REGS {
        return false
    }
    let old_val = state.values[dst as usize]
    let merged = cp_lattice_meet(old_val, new_val)
    if cp_lattice_eq(old_val, merged) {
        return false
    }
    state.values[dst as usize] = merged
    if dst >= state.reg_count {
        state.reg_count = dst + 1
    }
    true
}

// Apply a lattice update: read old, meet, write, push users if changed.
fn cp_apply_update(ctx: &! CpContext, dst: i64, new_val: CpLattice) -> i64 with Mut, Div, Panic {
    let changed = cp_ctx_update_reg(ctx, dst, new_val)
    if changed {
        let _pushed = cp_push_users(ctx, dst)
    }
    1
}

// Run one SCCP iteration: pop from worklist, evaluate, update, push users.
// Returns 1 if progress was made, 0 otherwise.
fn cp_sccp_step(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    let idx = cp_ctx_worklist_pop(ctx)
    if idx == CP_INVALID {
        return 0
    }
    let ci = ctx.instrs[idx as usize]
    let dst = ci.dst

    if dst < 0 || dst >= CP_MAX_REGS {
        return 1
    }

    let new_val = cp_eval_instr(ctx, ci)
    cp_apply_update(ctx, dst, new_val)
}

// Run the full SCCP fixed-point iteration.
fn cp_sccp_solve(ctx: &! CpContext) -> i64 with Mut, Div, Panic {
    let seeded = cp_sccp_init(ctx)
    var iterations: i64 = 0
    var max_iters: i64 = CP_MAX_REGS * 4

    var done = false
    while done == false {
        if cp_worklist_empty(&ctx.worklist) {
            done = true
        } else if iterations >= max_iters {
            done = true
        } else {
            let progress = cp_sccp_step(ctx)
            iterations = iterations + 1
        }
    }
    ctx.stats.iterations = iterations
    iterations
}

// ============================================================================
// Section 19: Full Constant Propagation Pipeline
// ============================================================================

// Inner implementation: takes already-borrowed ctx and func.
fn cp_run_impl(ctx: &! CpContext, func: &! IrFunction) -> CpStats with Mut, Div, Panic {
    // #1649: IR_MAX_INSTRS is 16384, CpContext holds 8192. cp_populate stops at
    // CP_MAX_INSTRS, and propagating constants from a PREFIX of a function is
    // wrong rather than merely incomplete -- a reassignment past the cap is
    // unseen, so a stale value gets folded in. Refuse the function instead.
    if (*func).instr_count > CP_MAX_INSTRS {
        return cp_stats_new()
    }
    // Phase 1: Populate instruction cache
    let populated = cp_populate(ctx, func)

    // Phase 2: Build blocks and edges
    let blocks = cp_build_blocks(ctx)
    let edges = cp_build_block_edges(ctx)

    // Phase 3: Propagate reachability
    let reachable = cp_propagate_reachability(ctx)

    // Phase 4: SCCP fixed-point iteration
    let iterations = cp_sccp_solve(ctx)

    // Phase 5: Apply constant folding
    let folded = cp_apply_folding(ctx, func)

    // Phase 6: Apply strength reduction
    let reduced = cp_apply_strength_reduction(ctx, func)

    // Phase 7: Copy propagation
    let propagated = cp_propagate_copies(ctx, func)

    // Phase 8: Branch folding
    let branches = cp_fold_branches(ctx, func)

    // Phase 9: Rebuild reachability after branch folding
    // Reset reachability
    var rb: i64 = 0
    while rb < ctx.block_count {
        ctx.block_reachable[rb as usize] = false
        ctx.blocks[rb as usize].is_reachable = false
        rb = rb + 1
    }
    let reachable2 = cp_propagate_reachability(ctx)

    // Phase 10: Dead branch elimination
    let eliminated = cp_eliminate_unreachable(ctx, func)

    ctx.stats
}

// Run the complete constant propagation pass on an IrFunction.
fn cp_run(func: &! IrFunction) -> CpStats with Mut, Div, Panic {
    var ctx = cp_context_new()
    cp_run_impl(&! ctx, func)
}

// Convenience: run constant propagation and return the modified function.
pub fn cp_optimize_function(func: IrFunction) -> IrFunction with Mut, Div, Panic {
    // #1649 Sweep 1 residual: the copy is handed to a &! mutator, so the write is
    // not syntactically local and the first sweep's scan could not see it. Under a
    // region handle `var result = func` aliases the caller's storage.
    var result = ir_function_clone(&func)
    let _stats = cp_run(&! result)
    result
}

// ============================================================================
// Section 20: Test Helpers
// ============================================================================

// Build a test IrFunction from an instruction array and count.
pub(crate) fn cp_make_test_func(instrs: [IrInstr; 1024], count: i64) -> IrFunction with Mut, Panic, Div {
    // instrs is [IrInstr; 1024] but IrFunction.instrs is [IrInstr; 4096]; a typed
    // fixed-size array cannot be assigned across sizes, so build an empty function
    // (its [2048] instrs come from a size-flexible fill literal) and copy in.
    var f = ir_empty_function()
    var i: i64 = 0
    while i < count {
        ir_arena_store(ir_region_slot_w(f.region, (i)), instrs[i as usize])
        i = i + 1
    }
    f.instr_count = count
    f.reg_count = count + 10
    f
}

// Build an empty instruction array filled with NOPs.
pub(crate) fn cp_empty_instrs() -> [IrInstr; 1024] {
    [ir_nop(); 1024]
}

// Check if instruction at position is a specific opcode.
fn cp_check_opcode(func: &IrFunction, pos: i64, expected: IrOpcode) -> bool with Mut, Panic, Div {
    if pos < 0 || pos >= func.instr_count {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(func.region, (pos)))
    opcodes_equal(instr.op, expected)
}

// Check if instruction at position is IrLoadImm with a specific value.
pub(crate) fn cp_check_load_imm(func: &IrFunction, pos: i64, expected_val: i64) -> bool with Mut, Panic, Div {
    if pos < 0 || pos >= func.instr_count {
        return false
    }
    let instr = ir_arena_load(ir_region_slot_r(func.region, (pos)))
    if opcodes_equal(instr.op, IrOpcode::IrLoadImm) == false {
        return false
    }
    instr.imm_i64 == expected_val
}

// Check if instruction at position is a NOP.
fn cp_check_nop(func: &IrFunction, pos: i64) -> bool with Mut, Panic, Div {
    cp_check_opcode(func, pos, IrOpcode::IrNop)
}

// Make a phi instruction with two inputs.
fn cp_make_phi(dst: i64, src1: i64, src2: i64) -> IrInstr {
    let base = ir_phi(dst)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: src1,
        src2: src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: 0,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

// ============================================================================
// Section 21: Tests -- Lattice Operations
// ============================================================================

// T01: TOP meet TOP = TOP
fn test_cp_meet_top_top() -> bool {
    let a = cp_lattice_top()
    let b = cp_lattice_top()
    let result = cp_lattice_meet(a, b)
    result.kind == CP_TOP
}

// T02: TOP meet CONST = CONST
fn test_cp_meet_top_const() -> bool {
    let a = cp_lattice_top()
    let b = cp_lattice_int(42)
    let result = cp_lattice_meet(a, b)
    if result.kind != CP_CONST { return false }
    result.int_val == 42
}

// T03: CONST meet TOP = CONST
fn test_cp_meet_const_top() -> bool {
    let a = cp_lattice_int(7)
    let b = cp_lattice_top()
    let result = cp_lattice_meet(a, b)
    if result.kind != CP_CONST { return false }
    result.int_val == 7
}

// T04: CONST meet same CONST = CONST
fn test_cp_meet_const_same() -> bool {
    let a = cp_lattice_int(99)
    let b = cp_lattice_int(99)
    let result = cp_lattice_meet(a, b)
    if result.kind != CP_CONST { return false }
    result.int_val == 99
}

// T05: CONST meet different CONST = BOTTOM
fn test_cp_meet_const_diff() -> bool {
    let a = cp_lattice_int(10)
    let b = cp_lattice_int(20)
    let result = cp_lattice_meet(a, b)
    result.kind == CP_BOTTOM
}

// T06: BOTTOM meet anything = BOTTOM
fn test_cp_meet_bottom_any() -> bool {
    let a = cp_lattice_bottom()
    let b = cp_lattice_int(5)
    let r1 = cp_lattice_meet(a, b)
    let r2 = cp_lattice_meet(a, cp_lattice_top())
    let r3 = cp_lattice_meet(a, cp_lattice_bottom())
    if r1.kind != CP_BOTTOM { return false }
    if r2.kind != CP_BOTTOM { return false }
    r3.kind == CP_BOTTOM
}

// T07: anything meet BOTTOM = BOTTOM
fn test_cp_meet_any_bottom() -> bool {
    let a = cp_lattice_int(5)
    let b = cp_lattice_bottom()
    let result = cp_lattice_meet(a, b)
    result.kind == CP_BOTTOM
}

// T08: Float CONST meet same = CONST
fn test_cp_meet_float_same() -> bool {
    let a = cp_lattice_float(3.14)
    let b = cp_lattice_float(3.14)
    let result = cp_lattice_meet(a, b)
    if result.kind != CP_CONST { return false }
    result.is_float
}

// T09: Bool CONST meet same = CONST
fn test_cp_meet_bool_same() -> bool {
    let a = cp_lattice_bool(true)
    let b = cp_lattice_bool(true)
    let result = cp_lattice_meet(a, b)
    if result.kind != CP_CONST { return false }
    result.is_bool
}

// T10: Bool CONST meet different = BOTTOM
fn test_cp_meet_bool_diff() -> bool {
    let a = cp_lattice_bool(true)
    let b = cp_lattice_bool(false)
    let result = cp_lattice_meet(a, b)
    result.kind == CP_BOTTOM
}

// ============================================================================
// Section 22: Tests -- Constant Folding
// ============================================================================

// T11: Fold addition 3 + 5 = 8
fn test_cp_fold_add() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_ADD, 3, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 8
}

// T12: Fold subtraction 10 - 3 = 7
fn test_cp_fold_sub() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_SUB, 10, 3)
    if result.kind != CP_CONST { return false }
    result.int_val == 7
}

// T13: Fold multiplication 7 * 6 = 42
fn test_cp_fold_mul() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_MUL, 7, 6)
    if result.kind != CP_CONST { return false }
    result.int_val == 42
}

// T14: Fold division 20 / 4 = 5
fn test_cp_fold_div() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_DIV, 20, 4)
    if result.kind != CP_CONST { return false }
    result.int_val == 5
}

// T15: Division by zero returns BOTTOM
fn test_cp_fold_div_zero() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_DIV, 10, 0)
    result.kind == CP_BOTTOM
}

// T16: Fold modulo 10 % 3 = 1
fn test_cp_fold_mod() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_MOD, 10, 3)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T17: Fold equality 5 == 5 -> 1
fn test_cp_fold_eq_true() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_EQ, 5, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T18: Fold equality 5 == 6 -> 0
fn test_cp_fold_eq_false() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_EQ, 5, 6)
    if result.kind != CP_CONST { return false }
    result.int_val == 0
}

// T19: Fold less-than 3 < 5 -> 1
fn test_cp_fold_lt_true() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_LT, 3, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T20: Fold less-than 5 < 3 -> 0
fn test_cp_fold_lt_false() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_LT, 5, 3)
    if result.kind != CP_CONST { return false }
    result.int_val == 0
}

// T21: Fold greater-than 7 > 2 -> 1
fn test_cp_fold_gt() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_GT, 7, 2)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T22: Fold less-equal 5 <= 5 -> 1
fn test_cp_fold_le() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_LE, 5, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T23: Fold greater-equal 3 >= 5 -> 0
fn test_cp_fold_ge() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_GE, 3, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 0
}

// T24: Fold not-equal 3 != 5 -> 1
fn test_cp_fold_ne() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_NE, 3, 5)
    if result.kind != CP_CONST { return false }
    result.int_val == 1
}

// T25: Fold bitwise AND 0xFF & 0x0F = 0x0F
fn test_cp_fold_bit_and() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_BIT_AND, 255, 15)
    if result.kind != CP_CONST { return false }
    result.int_val == 15
}

// T26: Fold bitwise OR 0xF0 | 0x0F = 0xFF
fn test_cp_fold_bit_or() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_BIT_OR, 240, 15)
    if result.kind != CP_CONST { return false }
    result.int_val == 255
}

// T27: Fold XOR 0xFF ^ 0x0F = 0xF0
fn test_cp_fold_xor() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_XOR, 255, 15)
    if result.kind != CP_CONST { return false }
    result.int_val == 240
}

// T28: Fold shift left 1 << 3 = 8
fn test_cp_fold_shl() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_SHL, 1, 3)
    if result.kind != CP_CONST { return false }
    result.int_val == 8
}

// T29: Fold shift right 16 >> 2 = 4
fn test_cp_fold_shr() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_SHR, 16, 2)
    if result.kind != CP_CONST { return false }
    result.int_val == 4
}

// ============================================================================
// Section 23: Tests -- Strength Reduction
