// ============================================================================
// Section 24: Tests -- Branch Folding
// ============================================================================

// T40: Branch folding with constant true condition (BranchTrue -> Jump)
fn test_cp_branch_fold_true_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)
    let folded = cp_fold_branches(ctx, func)

    // Branch at position 1 should be replaced with jump
    if folded < 1 { return false }
    cp_check_opcode(func, 1, IrOpcode::IrJump)
}
fn test_cp_branch_fold_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)       // r0 = 1 (true)
    instrs[1] = ir_branch_true(0, 2)    // if r0 goto L2
    instrs[2] = ir_load_imm(1, 0)       // fallthrough
    instrs[3] = ir_return(1)
    instrs[4] = ir_label(2)
    instrs[5] = ir_load_imm(2, 42)
    instrs[6] = ir_return(2)

    var func = cp_make_test_func(instrs, 7)
    var ctx = cp_context_new()
    return test_cp_branch_fold_true_inner(&! ctx, &! func)
}

// T41: Branch folding with constant false condition (BranchTrue -> NOP)
fn test_cp_branch_fold_false_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)
    let folded = cp_fold_branches(ctx, func)

    // Branch at position 1 should be replaced with NOP
    if folded < 1 { return false }
    cp_check_nop(func, 1)
}
fn test_cp_branch_fold_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)       // r0 = 0 (false)
    instrs[1] = ir_branch_true(0, 2)    // if r0 goto L2 -- not taken
    instrs[2] = ir_load_imm(1, 99)
    instrs[3] = ir_return(1)
    instrs[4] = ir_label(2)
    instrs[5] = ir_load_imm(2, 42)
    instrs[6] = ir_return(2)

    var func = cp_make_test_func(instrs, 7)
    var ctx = cp_context_new()
    return test_cp_branch_fold_false_inner(&! ctx, &! func)
}

// ============================================================================
// Section 25: Tests -- Copy Propagation
// ============================================================================

// T42: Copy propagation through a chain: r0 = 42, r1 = copy r0, r2 = copy r1
fn test_cp_copy_propagation_chain_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)
    let propagated = cp_propagate_copies(ctx, func)

    // Both copies should become load_imm 42
    let c1_ok = cp_check_load_imm(func, 1, 42)
    let c2_ok = cp_check_load_imm(func, 2, 42)
    c1_ok && c2_ok
}
fn test_cp_copy_propagation_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)    // r0 = 42
    instrs[1] = ir_copy(1, 0)         // r1 = r0
    instrs[2] = ir_copy(2, 1)         // r2 = r1
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    var ctx = cp_context_new()
    return test_cp_copy_propagation_chain_inner(&! ctx, &! func)
}

// T43: Copy propagation does not propagate non-constant
fn test_cp_copy_no_propagate_varying_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)
    let propagated = cp_propagate_copies(ctx, func)

    // Copy should NOT be replaced since source is unknown
    if propagated != 0 { return false }
    cp_check_opcode(func, 1, IrOpcode::IrCopy)
}
fn test_cp_copy_no_propagate_varying() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)  // r0 = call (unknown)
    instrs[1] = ir_copy(1, 0)         // r1 = r0
    instrs[2] = ir_return(1)

    var func = cp_make_test_func(instrs, 3)
    var ctx = cp_context_new()
    return test_cp_copy_no_propagate_varying_inner(&! ctx, &! func)
}

// ============================================================================
// Section 26: Tests -- Phi Resolution
// ============================================================================

// T44: Phi with uniform inputs resolves to constant
fn test_cp_phi_uniform_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)

    // r2 should have converged to CONST 10
    let lat = cp_get_reg(&ctx.state, 2)
    if lat.kind != CP_CONST { return false }
    lat.int_val == 10
}
fn test_cp_phi_uniform() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)       // r0 = 10
    instrs[1] = ir_load_imm(1, 10)       // r1 = 10
    instrs[2] = cp_make_phi(2, 0, 1)     // r2 = phi(r0, r1)
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    var ctx = cp_context_new()
    return test_cp_phi_uniform_inner(&! ctx, &! func)
}

// T45: Phi with differing inputs is BOTTOM
fn test_cp_phi_differing_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let seeded = cp_sccp_init(ctx)
    let iters = cp_sccp_solve(ctx)

    // r2 should be BOTTOM (differing constants)
    let lat = cp_get_reg(&ctx.state, 2)
    lat.kind == CP_BOTTOM
}
fn test_cp_phi_differing() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)       // r0 = 10
    instrs[1] = ir_load_imm(1, 20)       // r1 = 20
    instrs[2] = cp_make_phi(2, 0, 1)     // r2 = phi(r0, r1)
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    var ctx = cp_context_new()
    return test_cp_phi_differing_inner(&! ctx, &! func)
}

// ============================================================================
// Section 27: Tests -- SCCP Convergence
// ============================================================================

// T46: SCCP converges on simple constant program
fn test_cp_sccp_simple_convergence_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let iters = cp_sccp_solve(ctx)

    // r2 should be 8
    let lat2 = cp_get_reg(&ctx.state, 2)
    if lat2.kind != CP_CONST { return false }
    if lat2.int_val != 8 { return false }

    // r3 should be 24
    let lat3 = cp_get_reg(&ctx.state, 3)
    if lat3.kind != CP_CONST { return false }
    lat3.int_val == 24
}
fn test_cp_sccp_simple_convergence() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                     // r0 = 3
    instrs[1] = ir_load_imm(1, 5)                     // r1 = 5
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = r0 + r1 = 8
    instrs[3] = ir_binop(3, 2, BinaryOp::OpMul, 0)    // r3 = r2 * r0 = 24
    instrs[4] = ir_return(3)

    var func = cp_make_test_func(instrs, 5)
    var ctx = cp_context_new()
    return test_cp_sccp_simple_convergence_inner(&! ctx, &! func)
}

// T47: SCCP with non-constant value stays BOTTOM
fn test_cp_sccp_with_call_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let iters = cp_sccp_solve(ctx)

    // r0 should be BOTTOM (call result)
    let lat0 = cp_get_reg(&ctx.state, 0)
    if lat0.kind != CP_BOTTOM { return false }

    // r2 should also be BOTTOM
    let lat2 = cp_get_reg(&ctx.state, 2)
    lat2.kind == CP_BOTTOM
}
fn test_cp_sccp_with_call() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)  // r0 = unknown
    instrs[1] = ir_load_imm(1, 5)                     // r1 = 5
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = r0 + r1 (BOTTOM)
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    var ctx = cp_context_new()
    return test_cp_sccp_with_call_inner(&! ctx, &! func)
}

// T48: SCCP folds nested operations
fn test_cp_sccp_nested_fold_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let iters = cp_sccp_solve(ctx)

    let lat4 = cp_get_reg(&ctx.state, 4)
    if lat4.kind != CP_CONST { return false }
    lat4.int_val == 23
}
fn test_cp_sccp_nested_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 2)                     // r0 = 2
    instrs[1] = ir_load_imm(1, 3)                     // r1 = 3
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = 5
    instrs[3] = ir_binop(3, 2, BinaryOp::OpMul, 2)    // r3 = 25
    instrs[4] = ir_binop(4, 3, BinaryOp::OpSub, 0)    // r4 = 23
    instrs[5] = ir_return(4)

    var func = cp_make_test_func(instrs, 6)
    var ctx = cp_context_new()
    return test_cp_sccp_nested_fold_inner(&! ctx, &! func)
}

