// Section 28: Tests -- Full Pipeline
// ============================================================================

// T49: Full pipeline folds constants and produces correct IR
fn test_cp_full_pipeline_fold_inner(func: &! IrFunction) -> bool with Mut, Div, Panic {
    let stats = cp_run(func)
    cp_check_load_imm(func, 2, 30)
}
fn test_cp_full_pipeline_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)                    // r0 = 10
    instrs[1] = ir_load_imm(1, 20)                    // r1 = 20
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = 30
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    test_cp_full_pipeline_fold_inner(&! func)
}

// T50: Full pipeline with copy chain
fn test_cp_full_pipeline_copy_chain_inner(func: &! IrFunction) -> bool with Mut, Div, Panic {
    let stats = cp_run(func)
    let c1_ok = cp_check_load_imm(func, 1, 77)
    let c2_ok = cp_check_load_imm(func, 2, 77)
    c1_ok && c2_ok
}
fn test_cp_full_pipeline_copy_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 77)   // r0 = 77
    instrs[1] = ir_copy(1, 0)        // r1 = r0
    instrs[2] = ir_copy(2, 1)        // r2 = r1
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    test_cp_full_pipeline_copy_chain_inner(&! func)
}

// ============================================================================
// Section 29: Tests -- Statistics Tracking
// ============================================================================

// T51: Statistics tracking on constant folding
fn test_cp_stats_folding() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // should be folded
    instrs[3] = ir_binop(3, 0, BinaryOp::OpMul, 1)    // should be folded
    instrs[4] = ir_return(3)

    var func = cp_make_test_func(instrs, 5)
    let stats = cp_run(&! func)

    // At least 2 operations should have been folded
    stats.folded_ops >= 2
}

// T52: Statistics tracking total instructions
fn test_cp_stats_total() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_load_imm(1, 2)
    instrs[2] = ir_return(0)

    var func = cp_make_test_func(instrs, 3)
    let stats = cp_run(&! func)

    stats.total_instrs == 3
}

// T53: Statistics with copy propagation
fn test_cp_stats_copies() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_copy(1, 0)
    instrs[2] = ir_return(1)

    var func = cp_make_test_func(instrs, 3)
    let stats = cp_run(&! func)

    stats.propagated_copies >= 1
}

// ============================================================================
// Section 30: Tests -- Edge Cases and Comparisons
// ============================================================================

// T54: Logical AND folding
fn test_cp_fold_logical_and() -> bool with Div, Panic {
    let r1 = cp_fold_binop_int(CP_BINOP_AND, 1, 1)
    if r1.kind != CP_CONST { return false }
    if r1.int_val != 1 { return false }

    let r2 = cp_fold_binop_int(CP_BINOP_AND, 1, 0)
    if r2.kind != CP_CONST { return false }
    r2.int_val == 0
}

// T55: Logical OR folding
fn test_cp_fold_logical_or() -> bool with Div, Panic {
    let r1 = cp_fold_binop_int(CP_BINOP_OR, 0, 0)
    if r1.kind != CP_CONST { return false }
    if r1.int_val != 0 { return false }

    let r2 = cp_fold_binop_int(CP_BINOP_OR, 0, 1)
    if r2.kind != CP_CONST { return false }
    r2.int_val == 1
}

// T56: SHL with invalid shift amount returns BOTTOM
fn test_cp_fold_shl_invalid() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_SHL, 1, 64)
    result.kind == CP_BOTTOM
}

// T57: SHR with invalid shift amount returns BOTTOM
fn test_cp_fold_shr_invalid() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_SHR, 1, 0 - 1)
    result.kind == CP_BOTTOM
}

// T58: Modulo by zero returns BOTTOM
fn test_cp_fold_mod_zero() -> bool with Div, Panic {
    let result = cp_fold_binop_int(CP_BINOP_MOD, 10, 0)
    result.kind == CP_BOTTOM
}

// T59: Float constant folding (add)
fn test_cp_fold_float_add() -> bool with Div, Panic {
    let result = cp_fold_binop_float(CP_BINOP_ADD, 1.5, 2.5)
    if result.kind != CP_CONST { return false }
    // Check within tolerance: 4.0
    let diff = result.float_val - 4.0
    let abs_diff = if diff < 0.0 { 0.0 - diff } else { diff }
    abs_diff < 0.001
}

// T60: Float division by zero returns BOTTOM
fn test_cp_fold_float_div_zero() -> bool with Div, Panic {
    let result = cp_fold_binop_float(CP_BINOP_DIV, 1.0, 0.0)
    result.kind == CP_BOTTOM
}

// T61: Lattice equality for integers
fn test_cp_lattice_eq_int() -> bool {
    let a = cp_lattice_int(42)
    let b = cp_lattice_int(42)
    let c = cp_lattice_int(43)
    let eq_same = cp_lattice_eq(a, b)
    let eq_diff = cp_lattice_eq(a, c)
    if eq_same == false { return false }
    eq_diff == false
}

// T62: Lattice equality for booleans
fn test_cp_lattice_eq_bool() -> bool {
    let a = cp_lattice_bool(true)
    let b = cp_lattice_bool(true)
    let c = cp_lattice_bool(false)
    let eq_same = cp_lattice_eq(a, b)
    let eq_diff = cp_lattice_eq(a, c)
    if eq_same == false { return false }
    eq_diff == false
}

// T63: State set and get round-trip
fn test_cp_state_set_get_inner(state: &! CpState) -> bool with Mut, Div, Panic {
    let val = cp_lattice_int(123)
    let changed = cp_set_reg(state, 5, val)
    if changed == false { return false }
    let got = cp_get_reg(state, 5)
    if got.kind != CP_CONST { return false }
    got.int_val == 123
}
fn test_cp_state_set_get() -> bool with Mut, Div, Panic {
    var state = cp_state_new()
    return test_cp_state_set_get_inner(&! state)
}

// T64: Setting same value returns false (no change)
fn test_cp_state_no_change_inner(state: &! CpState) -> bool with Mut, Div, Panic {
    let val = cp_lattice_int(99)
    let c1 = cp_set_reg(state, 3, val)
    let c2 = cp_set_reg(state, 3, val)
    if c1 == false { return false }
    c2 == false
}
fn test_cp_state_no_change() -> bool with Mut, Div, Panic {
    var state = cp_state_new()
    return test_cp_state_no_change_inner(&! state)
}

// T65: Worklist push and pop
fn test_cp_worklist_push_pop_inner(wl: &! CpWorklist) -> bool with Mut, Div, Panic {
    let p1 = cp_worklist_push(wl, 10)
    let p2 = cp_worklist_push(wl, 20)
    let p3 = cp_worklist_push(wl, 30)
    if p1 == false { return false }
    if p2 == false { return false }
    if p3 == false { return false }
    // Pop returns in LIFO order
    let v1 = cp_worklist_pop(wl)
    let v2 = cp_worklist_pop(wl)
    let v3 = cp_worklist_pop(wl)
    if v1 != 30 { return false }
    if v2 != 20 { return false }
    v3 == 10
}
fn test_cp_worklist_push_pop() -> bool with Mut, Div, Panic {
    var wl = cp_worklist_new()
    return test_cp_worklist_push_pop_inner(&! wl)
}

// T66: Worklist rejects duplicates
fn test_cp_worklist_no_dup_inner(wl: &! CpWorklist) -> bool with Mut, Div, Panic {
    let p1 = cp_worklist_push(wl, 5)
    let p2 = cp_worklist_push(wl, 5)
    if p1 == false { return false }
    // Second push should be rejected (duplicate)
    if p2 { return false }
    wl.count == 1
}
fn test_cp_worklist_no_dup() -> bool with Mut, Div, Panic {
    var wl = cp_worklist_new()
    return test_cp_worklist_no_dup_inner(&! wl)
}

// T67: Empty worklist pop returns INVALID
fn test_cp_worklist_empty_pop() -> bool with Mut, Div, Panic {
    var wl = cp_worklist_new()
    let v = cp_worklist_pop(&! wl)
    v == CP_INVALID
}

// T68: 0 * x strength reduction (commutative)
fn test_cp_strength_zero_mul() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 0, 1, true, false, 0, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 0 { return false }
    sr.result_int == 0
}

// T69: x >> 0 -> x
fn test_cp_strength_shr_zero() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_SHR, 20, 21, false, true, 0, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 1 { return false }
    sr.copy_src == 20
}

// T70: 0 & x -> 0
fn test_cp_strength_zero_and() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_BIT_AND, 22, 23, true, false, 0, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 0 { return false }
    sr.result_int == 0
}

// T71: Full pipeline strength reduction of x * 0
fn test_cp_full_strength_mul_zero_inner(func: &! IrFunction) -> bool with Mut, Div, Panic {
    let stats = cp_run(func)
    cp_check_load_imm(func, 2, 0)
}
fn test_cp_full_strength_mul_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_call(0, 0, ir_empty_name(), ir_empty_reg_list(), 0)  // r0 = unknown
    instrs[1] = ir_load_imm(1, 0)                     // r1 = 0
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)    // r2 = r0 * 0
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    test_cp_full_strength_mul_zero_inner(&! func)
}

// T72: Comparison chaining: (3 < 5) -> 1, then branch on that
fn test_cp_comparison_chain_inner(ctx: &! CpContext, func: &! IrFunction) -> bool with Mut, Div, Panic {
    let pop = cp_populate(ctx, func)
    let iters = cp_sccp_solve(ctx)

    let lat2 = cp_get_reg(&ctx.state, 2)
    if lat2.kind != CP_CONST { return false }
    lat2.int_val == 1
}
fn test_cp_comparison_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                     // r0 = 3
    instrs[1] = ir_load_imm(1, 5)                     // r1 = 5
    instrs[2] = ir_binop(2, 0, BinaryOp::OpLt, 1)     // r2 = (3 < 5) = 1
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    var ctx = cp_context_new()
    return test_cp_comparison_chain_inner(&! ctx, &! func)
}

// T73: 2 * x -> x + x (commutative strength reduction)
fn test_cp_strength_two_mul() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 3, 4, true, false, 2, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 2 { return false }
    sr.copy_src == 4
}

// T74: 1 * x -> copy x (commutative)
fn test_cp_strength_one_mul() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 3, 4, true, false, 1, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 1 { return false }
    sr.copy_src == 4
}

// T75: 0 | x -> copy x
fn test_cp_strength_zero_or() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_BIT_OR, 25, 26, true, false, 0, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 1 { return false }
    sr.copy_src == 26
}

// T76: No reduction for non-reducible operations (e.g., x * 3)
fn test_cp_strength_no_reduce() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 0, 1, false, true, 0, 3)
    sr.reduced == false
}

// T77: Lattice meet associativity: (a meet b) meet c == a meet (b meet c)
fn test_cp_lattice_meet_assoc() -> bool {
    let a = cp_lattice_int(5)
    let b = cp_lattice_top()
    let c = cp_lattice_int(5)
    let ab_c = cp_lattice_meet(cp_lattice_meet(a, b), c)
    let a_bc = cp_lattice_meet(a, cp_lattice_meet(b, c))
    cp_lattice_eq(ab_c, a_bc)
}

// T78: Lattice meet commutativity
fn test_cp_lattice_meet_commut() -> bool {
    let a = cp_lattice_int(7)
    let b = cp_lattice_int(8)
    let ab = cp_lattice_meet(a, b)
    let ba = cp_lattice_meet(b, a)
    cp_lattice_eq(ab, ba)
}

// T79: SCCP iteration count is positive for non-trivial programs
fn test_cp_sccp_iterations_positive() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_load_imm(1, 2)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[3] = ir_return(2)

    var func = cp_make_test_func(instrs, 4)
    let stats = cp_run(&! func)

    stats.iterations > 0
}

// T80: Classify opcodes correctly
fn test_cp_classify_opcodes() -> bool {
    let o1 = cp_classify_opcode(IrOpcode::IrLoadImm)
    let o2 = cp_classify_opcode(IrOpcode::IrBinOp)
    let o3 = cp_classify_opcode(IrOpcode::IrJump)
    let o4 = cp_classify_opcode(IrOpcode::IrReturn)
    let o5 = cp_classify_opcode(IrOpcode::IrPhi)
    if o1 != CP_OP_LOAD_IMM { return false }
    if o2 != CP_OP_BINOP { return false }
    if o3 != CP_OP_JUMP { return false }
    if o4 != CP_OP_RETURN { return false }
    o5 == CP_OP_PHI
}

// T81: Side-effect detection
fn test_cp_side_effects() -> bool {
    let se1 = cp_has_side_effect(CP_OP_CALL)
    let se2 = cp_has_side_effect(CP_OP_RETURN)
    let se3 = cp_has_side_effect(CP_OP_LOAD_IMM)
    let se4 = cp_has_side_effect(CP_OP_BINOP)
    if se1 == false { return false }
    if se2 == false { return false }
    if se3 { return false }
    se4 == false
}

// T82: Terminator detection
fn test_cp_terminators() -> bool {
    let t1 = cp_is_terminator(CP_OP_JUMP)
    let t2 = cp_is_terminator(CP_OP_RETURN)
    let t3 = cp_is_terminator(CP_OP_BRANCH_TRUE)
    let t4 = cp_is_terminator(CP_OP_LOAD_IMM)
    if t1 == false { return false }
    if t2 == false { return false }
    if t3 == false { return false }
    t4 == false
}

// T83: Out-of-range register get returns BOTTOM
fn test_cp_get_oob_reg() -> bool with Div, Panic {
    let state = cp_state_new()
    let lat = cp_get_reg(&state, 0 - 1)
    if lat.kind != CP_BOTTOM { return false }
    let lat2 = cp_get_reg(&state, 5000)
    lat2.kind == CP_BOTTOM
}

// T84: Out-of-range register set returns false
fn test_cp_set_oob_reg_inner(state: &! CpState) -> bool with Mut, Div, Panic {
    let r1 = cp_set_reg(state, 0 - 1, cp_lattice_int(1))
    let r2 = cp_set_reg(state, 5000, cp_lattice_int(1))
    if r1 { return false }
    r2 == false
}
fn test_cp_set_oob_reg() -> bool with Mut, Div, Panic {
    var state = cp_state_new()
    return test_cp_set_oob_reg_inner(&! state)
}

// ============================================================================
// Section 31: Test Runner
// ============================================================================

fn test_cp_run_all() -> i32 with Mut, Div, Panic, IO {
    var passed: i64 = 0
    var failed: i64 = 0

    // Lattice tests (T01-T10)
    if test_cp_meet_top_top() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_top_const() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_const_top() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_const_same() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_const_diff() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_bottom_any() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_any_bottom() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_float_same() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_bool_same() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_meet_bool_diff() { passed = passed + 1 } else { failed = failed + 1 }

    // Constant folding tests (T11-T29)
    if test_cp_fold_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_sub() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_div() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_div_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_mod() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_eq_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_eq_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_lt_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_lt_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_gt() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_le() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_ge() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_ne() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_bit_and() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_bit_or() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_xor() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_shl() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_shr() { passed = passed + 1 } else { failed = failed + 1 }

    // Strength reduction tests (T30-T39)
    if test_cp_strength_mul_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_mul_one() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_mul_two() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_add_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_zero_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_sub_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_div_one() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_shl_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_and_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_or_zero() { passed = passed + 1 } else { failed = failed + 1 }

    // Branch folding tests (T40-T41)
    if test_cp_branch_fold_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_branch_fold_false() { passed = passed + 1 } else { failed = failed + 1 }

    // Copy propagation tests (T42-T43)
    if test_cp_copy_propagation_chain() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_copy_no_propagate_varying() { passed = passed + 1 } else { failed = failed + 1 }

    // Phi tests (T44-T45)
    if test_cp_phi_uniform() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_phi_differing() { passed = passed + 1 } else { failed = failed + 1 }

    // SCCP tests (T46-T48)
    if test_cp_sccp_simple_convergence() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_sccp_with_call() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_sccp_nested_fold() { passed = passed + 1 } else { failed = failed + 1 }

    // Full pipeline tests (T49-T50)
    if test_cp_full_pipeline_fold() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_full_pipeline_copy_chain() { passed = passed + 1 } else { failed = failed + 1 }

    // Statistics tests (T51-T53)
    if test_cp_stats_folding() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_stats_total() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_stats_copies() { passed = passed + 1 } else { failed = failed + 1 }

    // Edge cases and comparisons (T54-T84)
    if test_cp_fold_logical_and() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_logical_or() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_shl_invalid() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_shr_invalid() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_mod_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_float_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_fold_float_div_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_lattice_eq_int() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_lattice_eq_bool() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_state_set_get() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_state_no_change() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_worklist_push_pop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_worklist_no_dup() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_worklist_empty_pop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_zero_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_shr_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_zero_and() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_full_strength_mul_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_comparison_chain() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_two_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_one_mul() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_zero_or() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_strength_no_reduce() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_lattice_meet_assoc() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_lattice_meet_commut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_sccp_iterations_positive() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_classify_opcodes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_side_effects() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_terminators() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_get_oob_reg() { passed = passed + 1 } else { failed = failed + 1 }
    if test_cp_set_oob_reg() { passed = passed + 1 } else { failed = failed + 1 }

    print_int(passed)
    print_int(failed)

    if failed > 0 {
        return 1
    }
    0
}
