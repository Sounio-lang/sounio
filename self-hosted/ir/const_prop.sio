// T30: x * 0 -> load 0
fn test_cp_strength_mul_zero() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 0, 1, false, true, 0, 0)
    if sr.reduced == false { return false }
    if sr.result_kind != 0 { return false }
    sr.result_int == 0
}

// T31: x * 1 -> copy x
fn test_cp_strength_mul_one() -> bool {
    let sr = cp_try_strength_reduce(CP_BINOP_MUL, 5, 6, false, true, 0, 1)
    if sr.reduced == false { return false }
    if sr.result_kind != 1 { return false }
    sr.copy_src == 5
}

