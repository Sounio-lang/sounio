// IR serialization/deserialization for verification and artifact boundary

module ir::serialize

use parser::ast::*
use ir::ir::*
use check::types::*
//
// SOIR v5 Binary Format:
// ─────────────────────────
// Header (8 bytes):
//   - Magic: "SOIR" (0x534F4952 little-endian)
//   - Version: 5 (1 byte)
//   - Feature flags: 1 byte (bit 0 = variable call-argument payloads,
//     bit 1 = function-level sret ABI metadata)
//   - Reserved: 0x00 (2 bytes padding)
//
// Body:
//   - fn_count: i64 (8 bytes)
//   - functions[]: array of serialized IrFunction
//   - string_count: i64 (8 bytes)
//   - strings[]: array of serialized Name
//   - epistemic: IrEpistemicSection (v2+)
//   - algebras: IrAlgebraTable (v3+)
//
// IrFunction encoding:
//   - name: Name (128 bytes + 8 byte length)
//   - instr_count: i64
//   - reg_count: i64
//   - label_count: i64
//   - param_count: i64
//   - param_regs: [i64; 64]
//   - compile_strategy: i64
//   - prof_counter_id: i64
//   - hyper_algebra_kind: i64 (v3+)
//   - is_sret: i64 (v5+, feature bit 1)
//   - sret_dest_reg: i64 (v5+, feature bit 1)
//   - float_reg_word_count: i64 (v5+)
//   - float_reg_bits: [i64; float_reg_word_count] (v5+)
//   - instrs: array of IrInstr
//
// IrInstr encoding (232 bytes through v4; 240 bytes in v5+):
//   - op: IrOpcode (1 byte + 7 padding)
//   - dst, src1, src2: i64 (8 bytes each)
//   - imm_i64: i64
//   - imm_f64: f64
//   - label_id, fn_id, field_idx: i64 (8 bytes each)
//   - imm_flags: i64 (v5+)
//   - bin_op: BinaryOp (1 byte + 7 padding)
//   - un_op: UnaryOp (1 byte + 7 padding)
//   - name: Name (128 bytes + 8 byte length)
//   - arg_count: i64
//   - call_args: [i64; arg_count] (v5+)

let SOIR_MAGIC: i64 = 1380206931  // "SOIR" as i32 cast to i64
let SOIR_VERSION: i8 = 6
let SOIR_FEATURE_CALL_ARGS: i8 = 1
let SOIR_FEATURE_SRET_ABI: i8 = 2
let SOIR_FEATURE_RETURN_KNOWLEDGE_KIND: i8 = 4
let SOIR_FEATURES_CURRENT: i8 = SOIR_FEATURE_CALL_ARGS | SOIR_FEATURE_SRET_ABI | SOIR_FEATURE_RETURN_KNOWLEDGE_KIND
let SOIR_FEATURES_V5: i8 = SOIR_FEATURE_CALL_ARGS | SOIR_FEATURE_SRET_ABI
let SOIR_MAX_SIZE: i64 = 131072  // 128KB max module size

// Detectable capacity refusal. Returning ir_empty_module() on an oversized
// fn_count / string_count (or ir_empty_function() on an oversized instr_count)
// used to be a silent clamp: the caller could not tell "empty input" from
// "refused because it would write past the buffer". Incremented on every
// capacity refuse so a gate / test can observe that deserialize declined.
pub var SOIR_DESER_REFUSAL_COUNT: i64 = 0
pub var SOIR_DESER_V5_UNKNOWN_RETURN_METADATA_COUNT: i64 = 0
pub var SOIR_SER_REFUSAL_COUNT: i64 = 0
// Bound used by every primitive decoder during one module decode.  Composite
// section readers are intentionally built from these primitives, so a
// truncated declared payload is refused before any backing-array access.
var SOIR_DESER_ACTIVE_LIMIT: i64 = SOIR_MAX_SIZE

fn soir_note_deser_refusal() with Mut {
    SOIR_DESER_REFUSAL_COUNT = SOIR_DESER_REFUSAL_COUNT + 1
}

fn write_i8(buf: &![i8; 131072], pos: i64, val: i8) -> i64 with Mut, Panic, Div {
    if pos < 0 || pos >= SOIR_MAX_SIZE {
        SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
        return SOIR_MAX_SIZE
    }
    (*buf)[pos] = val
    pos + 1
}

fn write_i64(buf: &![i8; 131072], pos: i64, val: i64) -> i64 with Mut, Panic, Div {
    // Little-endian encoding - use write_i8 helper to avoid type issues
    var p = pos

    p = write_i8(buf, p, ((val) & 255) as i8)
    p = write_i8(buf, p, ((val >> 8) & 255) as i8)
    p = write_i8(buf, p, ((val >> 16) & 255) as i8)
    p = write_i8(buf, p, ((val >> 24) & 255) as i8)
    p = write_i8(buf, p, ((val >> 32) & 255) as i8)
    p = write_i8(buf, p, ((val >> 40) & 255) as i8)
    p = write_i8(buf, p, ((val >> 48) & 255) as i8)
    p = write_i8(buf, p, ((val >> 56) & 255) as i8)

    p
}

fn write_f64(buf: &![i8; 131072], pos: i64, val: f64) -> i64 with Mut, Panic, Div {
    // IEEE 754 double → i64 via compiler builtin (proper bit reinterpretation)
    let bits = f64_to_bits(val)
    write_i64(buf, pos, bits)
}

fn write_name(buf: &![i8; 131072], pos: i64, n: Name) -> i64 with Mut, Panic, Div {
    var p = pos
    var encoded_len = n.len
    if encoded_len < 0 || encoded_len > 128 {
        SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
        encoded_len = 0
    }
    // Write length first
    p = write_i64(buf, p, encoded_len)
    // Write buffer bytes
    var i: i64 = 0
    while i < 128 {
        p = write_i8(buf, p, n.buf[i])
        i = i + 1
    }
    p
}

fn read_i8(buf: &[i8; 131072], pos: i64) -> (i8, i64) with Mut, Panic, Div {
    if pos < 0 || pos >= SOIR_DESER_ACTIVE_LIMIT || pos >= SOIR_MAX_SIZE {
        soir_note_deser_refusal()
        return (0 as i8, SOIR_DESER_ACTIVE_LIMIT)
    }
    ((*buf)[pos], pos + 1)
}

fn read_i64(buf: &[i8; 131072], pos: i64) -> (i64, i64) with Mut, Panic, Div {
    if pos < 0 ||
       SOIR_DESER_ACTIVE_LIMIT < 8 ||
       pos > SOIR_DESER_ACTIVE_LIMIT - 8 ||
       pos > SOIR_MAX_SIZE - 8 {
        soir_note_deser_refusal()
        return (0, SOIR_DESER_ACTIVE_LIMIT)
    }
    // Little-endian decoding - mask to ensure unsigned byte interpretation
    let raw0: i64 = (*buf)[pos + 0] as i64
    let raw1: i64 = (*buf)[pos + 1] as i64
    let raw2: i64 = (*buf)[pos + 2] as i64
    let raw3: i64 = (*buf)[pos + 3] as i64
    let raw4: i64 = (*buf)[pos + 4] as i64
    let raw5: i64 = (*buf)[pos + 5] as i64
    let raw6: i64 = (*buf)[pos + 6] as i64
    let raw7: i64 = (*buf)[pos + 7] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    let val = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
    (val, pos + 8)
}

// IEEE 754 double: i64 bits → f64 via arithmetic reconstruction.
// sign (bit 63) | exponent (bits 62..52, bias 1023) | mantissa (bits 51..0)
fn ieee754_bits_to_f64(bits: i64) -> f64 with Mut, Panic, Div {
    // Zero (positive or negative)
    if (bits & 0x7FFFFFFFFFFFFFFF) == 0 { return 0.0 }

    let sign_bit = (bits >> 63) & 1
    let raw_exp = (bits >> 52) & 0x7FF
    let frac_bits = bits & 0xFFFFFFFFFFFFF

    // Infinity / NaN — return 0.0 as safe fallback for serialization
    if raw_exp == 0x7FF { return 0.0 }

    // Reconstruct mantissa: 1.frac (normal) or 0.frac (subnormal)
    var mantissa: f64 = 0.0
    var bit_val: f64 = 0.5
    var i: i64 = 51
    while i >= 0 {
        if ((frac_bits >> i) & 1) == 1 {
            mantissa = mantissa + bit_val
        }
        bit_val = bit_val / 2.0
        i = i - 1
    }

    var result: f64 = 0.0
    if raw_exp == 0 {
        // Subnormal: 0.frac × 2^(-1022)
        result = mantissa
        var e: i64 = 0
        while e < 1022 {
            result = result / 2.0
            e = e + 1
        }
    } else {
        // Normal: (1 + mantissa) × 2^(exp - 1023)
        result = 1.0 + mantissa
        let exp = raw_exp - 1023
        if exp > 0 {
            var e: i64 = 0
            while e < exp {
                result = result * 2.0
                e = e + 1
            }
        } else if exp < 0 {
            let neg_exp = 0 - exp
            var e: i64 = 0
            while e < neg_exp {
                result = result / 2.0
                e = e + 1
            }
        }
    }

    if sign_bit == 1 { result = 0.0 - result }
    result
}

fn read_f64(buf: &[i8; 131072], pos: i64) -> (f64, i64) with Mut, Panic, Div {
    let pair = read_i64(buf, pos)
    let bits = pair.0
    let next_pos = pair.1
    (ieee754_bits_to_f64(bits), next_pos)
}

fn read_name(buf: &[i8; 131072], pos: i64) -> (Name, i64) with Mut, Panic, Div {
    let len_pair = read_i64(buf, pos)
    let len = len_pair.0
    var p = len_pair.1

    var decoded_len = len
    if decoded_len < 0 || decoded_len > 128 {
        soir_note_deser_refusal()
        decoded_len = 0
    }
    var n = Name { buf: [0; 384], len: decoded_len }
    var i: i64 = 0
    while i < 128 {
        let byte_pair = read_i8(buf, p)
        n.buf[i] = byte_pair.0
        p = byte_pair.1
        i = i + 1
    }
    (n, p)
}

fn write_compare_op(buf: &![i8; 131072], pos: i64, op: CompareOp) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        CompareOp::CmpLt => 0,
        CompareOp::CmpLe => 1,
        CompareOp::CmpEq => 2,
        CompareOp::CmpGe => 3,
        CompareOp::CmpGt => 4,
    }
    write_i8(buf, pos, tag)
}

fn read_compare_op(buf: &[i8; 131072], pos: i64) -> (CompareOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    if tag < 0 || tag > 4 {
        soir_note_deser_refusal()
        return (CompareOp::CmpEq, next_pos)
    }
    let op = if tag == 0 { CompareOp::CmpLt }
        else if tag == 1 { CompareOp::CmpLe }
        else if tag == 2 { CompareOp::CmpEq }
        else if tag == 3 { CompareOp::CmpGe }
        else { CompareOp::CmpGt }
    (op, next_pos)
}

fn write_opcode(buf: &![i8; 131072], pos: i64, op: IrOpcode) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
        IrOpcode::IrCallSret => 35,
        IrOpcode::IrReturnSret => 36,
        IrOpcode::IrCallExtern => 37,
        IrOpcode::IrCallIndirect => 38,
        IrOpcode::IrLoadFnRef => 39,
        _ => {
            SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
            return pos
        },
    }
    write_i8(buf, pos, tag)
}

fn read_opcode(buf: &[i8; 131072], pos: i64) -> (IrOpcode, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    if tag < 0 || tag > 39 {
        soir_note_deser_refusal()
        return (IrOpcode::IrNop, next_pos)
    }
    let op = if tag == 0 { IrOpcode::IrLoadImm }
        else if tag == 1 { IrOpcode::IrLoadFloat }
        else if tag == 2 { IrOpcode::IrLoadBool }
        else if tag == 3 { IrOpcode::IrLoadString }
        else if tag == 4 { IrOpcode::IrCopy }
        else if tag == 5 { IrOpcode::IrBinOp }
        else if tag == 6 { IrOpcode::IrUnaryOp }
        else if tag == 7 { IrOpcode::IrCall }
        else if tag == 8 { IrOpcode::IrReturn }
        else if tag == 9 { IrOpcode::IrJump }
        else if tag == 10 { IrOpcode::IrBranchTrue }
        else if tag == 11 { IrOpcode::IrBranchFalse }
        else if tag == 12 { IrOpcode::IrFieldGet }
        else if tag == 13 { IrOpcode::IrFieldSet }
        else if tag == 14 { IrOpcode::IrIndexGet }
        else if tag == 15 { IrOpcode::IrIndexSet }
        else if tag == 16 { IrOpcode::IrAlloc }
        else if tag == 17 { IrOpcode::IrLabel }
        else if tag == 18 { IrOpcode::IrNop }
        else if tag == 19 { IrOpcode::IrPhi }
        else if tag == 20 { IrOpcode::IrContest }
        else if tag == 21 { IrOpcode::IrProveRobust }
        else if tag == 22 { IrOpcode::IrValidated }
        else if tag == 23 { IrOpcode::IrLiftKnowledge }
        else if tag == 24 { IrOpcode::IrMeasure }
        else if tag == 25 { IrOpcode::IrAdmitAction }
        else if tag == 26 { IrOpcode::IrDeferAction }
        else if tag == 27 { IrOpcode::IrPlanAcquisition }
        else if tag == 28 { IrOpcode::IrPlanRecourse }
        else if tag == 29 { IrOpcode::IrProposeAlternatives }
        else if tag == 30 { IrOpcode::IrCommitAlternative }
        else if tag == 31 { IrOpcode::IrObserveTransition }
        else if tag == 32 { IrOpcode::IrRollbackTransition }
        else if tag == 33 { IrOpcode::IrDebugGuard }
        else if tag == 34 { IrOpcode::IrProfCounter }
        else if tag == 35 { IrOpcode::IrCallSret }
        else if tag == 36 { IrOpcode::IrReturnSret }
        else if tag == 37 { IrOpcode::IrCallExtern }
        else if tag == 38 { IrOpcode::IrCallIndirect }
        else if tag == 39 { IrOpcode::IrLoadFnRef }
        else { IrOpcode::IrNop }
    (op, next_pos)
}

fn write_binary_op(buf: &![i8; 131072], pos: i64, op: BinaryOp) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
        // Findings 11 (#2084): unsigned counterparts. Distinct tags so a
        // binary blob produced before the fix deserializes back to the
        // signed variants; a binary blob after the fix can carry either,
        // and downstream passes dispatch on the variant.
        BinaryOp::OpUDiv => 21,
        BinaryOp::OpURem => 22,
        BinaryOp::OpUShr => 23,
    }
    write_i8(buf, pos, tag)
}

fn read_binary_op(buf: &[i8; 131072], pos: i64) -> (BinaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    if tag < 0 || tag > 23 {
        soir_note_deser_refusal()
        return (BinaryOp::OpAdd, next_pos)
    }
    let op = if tag == 0 { BinaryOp::OpAdd }
        else if tag == 1 { BinaryOp::OpSub }
        else if tag == 2 { BinaryOp::OpMul }
        else if tag == 3 { BinaryOp::OpDiv }
        else if tag == 4 { BinaryOp::OpRem }
        else if tag == 5 { BinaryOp::OpEq }
        else if tag == 6 { BinaryOp::OpNe }
        else if tag == 7 { BinaryOp::OpLt }
        else if tag == 8 { BinaryOp::OpLe }
        else if tag == 9 { BinaryOp::OpGt }
        else if tag == 10 { BinaryOp::OpGe }
        else if tag == 11 { BinaryOp::OpAnd }
        else if tag == 12 { BinaryOp::OpOr }
        else if tag == 13 { BinaryOp::OpBitAnd }
        else if tag == 14 { BinaryOp::OpBitOr }
        else if tag == 15 { BinaryOp::OpBitXor }
        else if tag == 16 { BinaryOp::OpShl }
        else if tag == 17 { BinaryOp::OpShr }
        else if tag == 18 { BinaryOp::OpConcat }
        else if tag == 19 { BinaryOp::OpRange }
        else if tag == 20 { BinaryOp::OpRangeInclusive }
        else if tag == 21 { BinaryOp::OpUDiv }
        else if tag == 22 { BinaryOp::OpURem }
        else { BinaryOp::OpUShr }
    (op, next_pos)
}

fn write_unary_op(buf: &![i8; 131072], pos: i64, op: UnaryOp) -> i64 with Mut, Panic, Div {
    let tag: i8 = match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
        UnaryOp::OpBitNot => 5,
    }
    write_i8(buf, pos, tag)
}

fn read_unary_op(buf: &[i8; 131072], pos: i64) -> (UnaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    if tag < 0 || tag > 5 {
        soir_note_deser_refusal()
        return (UnaryOp::OpNeg, next_pos)
    }
    let op = if tag == 0 { UnaryOp::OpNeg }
        else if tag == 1 { UnaryOp::OpNot }
        else if tag == 2 { UnaryOp::OpRef }
        else if tag == 3 { UnaryOp::OpRefMut }
        else if tag == 4 { UnaryOp::OpDeref }
        else { UnaryOp::OpBitNot }
    (op, next_pos)
}

fn serialize_ir_instr(buf: &![i8; 131072], pos: i64, instr: IrInstr) -> i64 with Mut, Panic, Div {
    var p = pos

    if instr.arg_count < 0 || instr.arg_count > 64 {
        SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
        return p
    }

    p = write_opcode(buf, p, instr.op)
    p = p + 7  // 7-byte padding for alignment

    p = write_i64(buf, p, instr.dst)
    p = write_i64(buf, p, instr.src1)
    p = write_i64(buf, p, instr.src2)

    p = write_i64(buf, p, instr.imm_i64)

    p = write_f64(buf, p, instr.imm_f64)

    p = write_i64(buf, p, instr.label_id)
    p = write_i64(buf, p, instr.fn_id)
    p = write_i64(buf, p, instr.field_idx)

    p = write_i64(buf, p, instr.imm_flags)

    p = write_binary_op(buf, p, instr.bin_op)
    p = p + 7  // 7-byte padding

    p = write_unary_op(buf, p, instr.un_op)
    p = p + 7  // 7-byte padding

    p = write_name(buf, p, ir_name_at(instr.name_id))

    p = write_i64(buf, p, instr.arg_count)
    var args = instr.call_args
    var ai: i64 = 0
    let has_serialized_args = instr.op == IrOpcode::IrCall || instr.op == IrOpcode::IrCallExtern || instr.op == IrOpcode::IrCallIndirect || instr.op == IrOpcode::IrCallSret
    while has_serialized_args && ai < instr.arg_count {
        match args {
            Some(node) => {
                p = write_i64(buf, p, (*node).head)
                args = (*node).tail
            }
            _ => {
                SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
                return p
            }
        }
        ai = ai + 1
    }
    if has_serialized_args && ir_reg_list_len(args) != 0 {
        SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
    }

    p
}

fn deserialize_ir_instr(buf: &[i8; 131072], len: i64, pos: i64, version: i8, features: i8) -> (IrInstr, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let fixed_instr_size: i64 = if version >= 5 { 240 } else { 232 }
    if p < 0 || len < 0 || len > SOIR_MAX_SIZE || p > len - fixed_instr_size || p > SOIR_MAX_SIZE - fixed_instr_size {
        soir_note_deser_refusal()
        return (ir_instr_new(IrOpcode::IrNop), p)
    }
    let op_pair = read_opcode(buf, p)
    let op = op_pair.0
    p = op_pair.1 + 7  // skip padding

    let dst_pair = read_i64(buf, p)
    let dst = dst_pair.0
    p = dst_pair.1

    let src1_pair = read_i64(buf, p)
    let src1 = src1_pair.0
    p = src1_pair.1

    let src2_pair = read_i64(buf, p)
    let src2 = src2_pair.0
    p = src2_pair.1

    let imm_i64_pair = read_i64(buf, p)
    let imm_i64 = imm_i64_pair.0
    p = imm_i64_pair.1

    let imm_f64_pair = read_f64(buf, p)
    let imm_f64 = imm_f64_pair.0
    p = imm_f64_pair.1

    let label_id_pair = read_i64(buf, p)
    let label_id = label_id_pair.0
    p = label_id_pair.1

    let fn_id_pair = read_i64(buf, p)
    let fn_id = fn_id_pair.0
    p = fn_id_pair.1

    let field_idx_pair = read_i64(buf, p)
    let field_idx = field_idx_pair.0
    p = field_idx_pair.1

    var imm_flags: i64 = 0
    if version >= 5 {
        let imm_flags_pair = read_i64(buf, p)
        imm_flags = imm_flags_pair.0
        p = imm_flags_pair.1
    }

    let bin_op_pair = read_binary_op(buf, p)
    let bin_op = bin_op_pair.0
    p = bin_op_pair.1 + 7  // skip padding

    let un_op_pair = read_unary_op(buf, p)
    let un_op = un_op_pair.0
    p = un_op_pair.1 + 7  // skip padding

    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1

    let arg_count_pair = read_i64(buf, p)
    let arg_count = arg_count_pair.0
    p = arg_count_pair.1

    let has_serialized_args = op == IrOpcode::IrCall || op == IrOpcode::IrCallExtern || op == IrOpcode::IrCallIndirect || op == IrOpcode::IrCallSret
    let call_args_present = version >= 5 && (features & SOIR_FEATURE_CALL_ARGS) != 0
    if !call_args_present && has_serialized_args && arg_count > 0 {
        soir_note_deser_refusal()
        return (ir_instr_new(IrOpcode::IrNop), p)
    }
    if arg_count < 0 || arg_count > 64 || (call_args_present && has_serialized_args && (p > len - arg_count * 8 || p > SOIR_MAX_SIZE - arg_count * 8)) {
        soir_note_deser_refusal()
        return (ir_instr_new(IrOpcode::IrNop), p)
    }
    var call_args = ir_empty_reg_list()
    var ai: i64 = 0
    while call_args_present && has_serialized_args && ai < arg_count {
        let arg_pair = read_i64(buf, p)
        let arg_reg = arg_pair.0
        p = arg_pair.1
        if ai == 0 {
            call_args = Some(Box::new(ir_reg_list_single(arg_reg)))
        } else {
            match call_args {
                Some(list) => { call_args = Some(Box::new(ir_reg_list_append(*list, arg_reg))) }
                _ => {
                    soir_note_deser_refusal()
                    return (ir_instr_new(IrOpcode::IrNop), p)
                }
            }
        }
        ai = ai + 1
    }

    let instr = IrInstr {
        op: op,
        dst: dst,
        src1: src1,
        src2: src2,
        imm_i64: imm_i64,
        imm_f64: imm_f64,
        label_id: label_id,
        fn_id: fn_id,
        field_idx: field_idx,
        imm_flags: imm_flags,
        bin_op: bin_op,
        un_op: un_op,
        name_id: ir_intern_name(name),
        call_args: call_args,
        arg_count: arg_count,
    }
    (instr, p)
}

fn serialize_ir_function(buf: &![i8; 131072], pos: i64, func: IrFunction) -> i64 with Mut, Panic, Div, Alloc {
    var p = pos

    p = write_name(buf, p, func.name)
    p = write_i64(buf, p, func.instr_count)
    p = write_i64(buf, p, func.reg_count)
    p = write_i64(buf, p, func.label_count)
    p = write_i64(buf, p, func.param_count)

    // Write param_regs array
    var i: i64 = 0
    while i < 64 {
        p = write_i64(buf, p, func.param_regs[i])
        i = i + 1
    }

    // Sprint 38: Write compile strategy
    p = write_i64(buf, p, func.compile_strategy)

    // Sprint 44: Write prof_counter_id
    p = write_i64(buf, p, func.prof_counter_id)

    if SOIR_VERSION >= 3 {
        p = write_i64(buf, p, func.hyper_algebra_kind)
    }

    if SOIR_VERSION >= 5 {
        p = write_i64(buf, p, func.is_sret)
        p = write_i64(buf, p, func.sret_dest_reg)
        var float_word_count = (func.reg_count + 31) / 32
        if float_word_count < 0 { float_word_count = 0 }
        if float_word_count > 64 { float_word_count = 64 }
        p = write_i64(buf, p, float_word_count)
        var fw: i64 = 0
        while fw < float_word_count {
            p = write_i64(buf, p, func.float_reg_bits[fw as usize])
            fw = fw + 1
        }
    }
    if SOIR_VERSION >= 6 {
        p = write_i64(buf, p, func.return_kn_value_float)
    }

    // Write instructions
    var j: i64 = 0
    while j < func.instr_count {
        let instr_slot = ir_region_slot_r(func.region, j)
        var instr = ir_arena_load(instr_slot)
        let has_serialized_args = instr.op == IrOpcode::IrCall || instr.op == IrOpcode::IrCallExtern || instr.op == IrOpcode::IrCallIndirect || instr.op == IrOpcode::IrCallSret
        if has_serialized_args && instr.arg_count > 0 {
            var args = ir_empty_reg_list()
            var ai: i64 = 0
            while ai < instr.arg_count {
                let arg_reg = if instr.op == IrOpcode::IrCallSret { instr.field_idx + ai } else { ir_arena_arg_at(instr_slot, ai) }
                if ai == 0 {
                    args = Some(Box::new(ir_reg_list_single(arg_reg)))
                } else {
                    match args {
                        Some(list) => { args = Some(Box::new(ir_reg_list_append(*list, arg_reg))) }
                        _ => {
                            SOIR_SER_REFUSAL_COUNT = SOIR_SER_REFUSAL_COUNT + 1
                            return p
                        }
                    }
                }
                ai = ai + 1
            }
            instr.call_args = args
        }
        p = serialize_ir_instr(buf, p, instr)
        j = j + 1
    }

    p
}

fn deserialize_ir_function(buf: &[i8; 131072], len: i64, pos: i64, version: i8, features: i8) -> (IrFunction, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    // The fixed header is 696 bytes through prof_counter_id, plus the
    // hyper-algebra field introduced in v3. Refuse before the first read so a
    // truncated cache entry cannot be observed beyond its declared length.
    let fixed_header_size: i64 = if version >= 6 { 728 } else if version >= 5 { 720 } else if version >= 3 { 704 } else { 696 }
    if p < 0 || len < 0 || len > SOIR_MAX_SIZE || p > len - fixed_header_size || p > SOIR_MAX_SIZE - fixed_header_size {
        soir_note_deser_refusal()
        let empty = ir_empty_function()
        return (empty, p)
    }
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1

    let instr_count_pair = read_i64(buf, p)
    let instr_count = instr_count_pair.0
    p = instr_count_pair.1

    let reg_count_pair = read_i64(buf, p)
    let reg_count = reg_count_pair.0
    p = reg_count_pair.1

    let label_count_pair = read_i64(buf, p)
    let label_count = label_count_pair.0
    p = label_count_pair.1

    let param_count_pair = read_i64(buf, p)
    let param_count = param_count_pair.0
    p = param_count_pair.1

    // Read param_regs array
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    var i: i64 = 0
    while i < 64 {
        let reg_pair = read_i64(buf, p)
        param_regs[i] = reg_pair.0
        p = reg_pair.1
        i = i + 1
    }

    // Sprint 38: Read compile strategy
    let strategy_pair = read_i64(buf, p)
    let compile_strategy = strategy_pair.0
    p = strategy_pair.1

    // Sprint 44: Read prof_counter_id
    let prof_ctr_pair = read_i64(buf, p)
    let prof_counter_id = prof_ctr_pair.0
    p = prof_ctr_pair.1

    var hyper_algebra_kind: i64 = -1
    if version >= 3 {
        let hyper_alg_pair = read_i64(buf, p)
        hyper_algebra_kind = hyper_alg_pair.0
        p = hyper_alg_pair.1
    }

    var is_sret: i64 = 0
    var sret_dest_reg: i64 = -1
    if version >= 5 {
        let is_sret_pair = read_i64(buf, p)
        is_sret = is_sret_pair.0
        p = is_sret_pair.1
        let sret_dest_pair = read_i64(buf, p)
        sret_dest_reg = sret_dest_pair.0
        p = sret_dest_pair.1
        if (is_sret != 0 && is_sret != 1) ||
            (is_sret == 1 && (sret_dest_reg < 0 || sret_dest_reg >= reg_count)) ||
            (is_sret == 0 && sret_dest_reg != -1) {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
    }

    var float_reg_bits: [i64; 64] = [0; 64]
    if version >= 5 {
        if p < 0 || p + 8 > len || p + 8 > SOIR_MAX_SIZE {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
        let float_count_pair = read_i64(buf, p)
        let float_word_count = float_count_pair.0
        p = float_count_pair.1
        var expected_float_word_count = (reg_count + 31) / 32
        if expected_float_word_count < 0 { expected_float_word_count = 0 }
        if expected_float_word_count > 64 { expected_float_word_count = 64 }
        if float_word_count != expected_float_word_count {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
        if p + float_word_count * 8 > len || p + float_word_count * 8 > SOIR_MAX_SIZE {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
        var fw: i64 = 0
        while fw < float_word_count {
            let float_bits_pair = read_i64(buf, p)
            float_reg_bits[fw as usize] = float_bits_pair.0
            p = float_bits_pair.1
            fw = fw + 1
        }
    }

    var return_kn_value_float: i64 = -2
    if version >= 6 {
        let kn_pair = read_i64(buf, p)
        return_kn_value_float = kn_pair.0
        p = kn_pair.1
        if return_kn_value_float < -2 || return_kn_value_float > 2 {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
    }

    // Read instructions into the arena (post-#1649: IrFunction has `region`,
    // not an inline `instrs` array). Allocate a region sized to instr_count,
    // then store each deserialized instruction at its slot. instr_count is
    // bounded by IR_MAX_INSTRS; a larger count is refused below.
    if instr_count < 0 || instr_count > IR_MAX_INSTRS {
        // Refuse an oversized function rather than allocating past the arena.
        soir_note_deser_refusal()
        let empty = ir_empty_function()
        return (empty, p)
    }
    let instr_bytes: i64 = if version >= 5 { instr_count * 240 } else { instr_count * 232 }
    if p < 0 || p + instr_bytes > len || p + instr_bytes > SOIR_MAX_SIZE {
        soir_note_deser_refusal()
        let empty = ir_empty_function()
        return (empty, p)
    }
    var region = ir_region_invalid()
    if instr_count > 0 {
        let alloc_rc = ir_instr_arena_alloc(instr_count, &! region)
        if alloc_rc != IR_ARENA_OK {
            soir_note_deser_refusal()
            let empty = ir_empty_function()
            return (empty, p)
        }
    }
    var j: i64 = 0
    while j < instr_count {
        let instr_pair = deserialize_ir_instr(buf, len, p, version, features)
        ir_arena_store(ir_region_slot_w(region, (j)), instr_pair.0)
        p = instr_pair.1
        j = j + 1
    }

    let func = IrFunction {
        name: name,
        region: region,
        instr_count: instr_count,
        reg_count: reg_count,
        label_count: label_count,
        param_count: param_count,
        param_regs: param_regs,
        compile_strategy: compile_strategy,
        returns_float: 0,
        return_kn_value_float: return_kn_value_float,
        return_struct_name: ir_empty_name(),
        return_fixed_array_len: 0 - 1,
        prof_counter_id: prof_counter_id,
        hyper_algebra_kind: hyper_algebra_kind,
        is_sret: is_sret,
        sret_dest_reg: sret_dest_reg,
        bss_size: 0,
        first_param_is_ref: 0,
        f128_param_mask: 0,
        ref_struct_param_mask: 0,
        byval_array_param_mask: 0,
        float_reg_bits: float_reg_bits,
    }
    (func, p)
}

fn write_ir_algebra_info(buf: &![i8; 131072], pos: i64, info: IrAlgebraInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_name(buf, p, info.name)
    p = write_i64(buf, p, if info.add_commutative { 1 } else { 0 })
    p = write_i64(buf, p, if info.add_associative { 1 } else { 0 })
    p = write_i64(buf, p, if info.mul_commutative { 1 } else { 0 })
    p = write_i64(buf, p, if info.mul_associative { 1 } else { 0 })
    p = write_i64(buf, p, if info.mul_alternative { 1 } else { 0 })
    p = write_i64(buf, p, info.reassoc_strategy)
    p = write_i64(buf, p, info.algebra_tag)
    write_i64(buf, p, if info.is_valid { 1 } else { 0 })
}

fn read_ir_algebra_info(buf: &[i8; 131072], pos: i64) -> (IrAlgebraInfo, i64) with Mut, Panic, Div {
    var p = pos
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1
    let add_comm_pair = read_i64(buf, p)
    let add_comm = add_comm_pair.0 != 0
    p = add_comm_pair.1
    let add_assoc_pair = read_i64(buf, p)
    let add_assoc = add_assoc_pair.0 != 0
    p = add_assoc_pair.1
    let mul_comm_pair = read_i64(buf, p)
    let mul_comm = mul_comm_pair.0 != 0
    p = mul_comm_pair.1
    let mul_assoc_pair = read_i64(buf, p)
    let mul_assoc = mul_assoc_pair.0 != 0
    p = mul_assoc_pair.1
    let mul_alt_pair = read_i64(buf, p)
    let mul_alt = mul_alt_pair.0 != 0
    p = mul_alt_pair.1
    let reassoc_pair = read_i64(buf, p)
    let reassoc_strategy = reassoc_pair.0
    p = reassoc_pair.1
    let tag_pair = read_i64(buf, p)
    let algebra_tag = tag_pair.0
    p = tag_pair.1
    let valid_pair = read_i64(buf, p)
    let is_valid = valid_pair.0 != 0
    p = valid_pair.1
    (IrAlgebraInfo {
        name: name,
        add_commutative: add_comm,
        add_associative: add_assoc,
        mul_commutative: mul_comm,
        mul_associative: mul_assoc,
        mul_alternative: mul_alt,
        reassoc_strategy: reassoc_strategy,
        algebra_tag: algebra_tag,
        is_valid: is_valid,
    }, p)
}

fn serialize_ir_algebra_table(buf: &![i8; 131072], pos: i64, table: &IrAlgebraTable) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, table.count)
    var i: i64 = 0
    while i < table.count {
        p = write_ir_algebra_info(buf, p, table.entries[i])
        i = i + 1
    }
    p
}

fn deserialize_ir_algebra_table(buf: &[i8; 131072], pos: i64) -> (IrAlgebraTable, i64) with Mut, Panic, Div {
    var p = pos
    let count_pair = read_i64(buf, p)
    let count = count_pair.0
    p = count_pair.1
    var table = ir_empty_algebra_table()
    var i: i64 = 0
    while i < count && i < 32 {
        let info_pair = read_ir_algebra_info(buf, p)
        table.entries[i] = info_pair.0
        p = info_pair.1
        i = i + 1
    }
    table.count = if count > 32 { 32 } else { count }
    (table, p)
}

fn write_policy_requirement_info(buf: &![i8; 131072], pos: i64, req: IrPolicyRequirementInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, req.metric_id)
    p = write_name(buf, p, req.metric_name)
    p = write_compare_op(buf, p, req.op)
    p = p + 7
    p = write_f64(buf, p, req.threshold)
    p = write_i64(buf, p, req.threshold_kind)
    p = write_i64(buf, p, if req.bool_threshold { 1 } else { 0 })
    write_name(buf, p, req.name_threshold)
}

fn read_policy_requirement_info(buf: &[i8; 131072], pos: i64) -> (IrPolicyRequirementInfo, i64) with Mut, Panic, Div {
    var p = pos
    let metric_pair = read_i64(buf, p)
    let metric_id = metric_pair.0
    p = metric_pair.1
    let name_pair = read_name(buf, p)
    let metric_name = name_pair.0
    p = name_pair.1
    let op_pair = read_compare_op(buf, p)
    let op = op_pair.0
    p = op_pair.1 + 7
    let threshold_pair = read_f64(buf, p)
    let threshold = threshold_pair.0
    p = threshold_pair.1
    let kind_pair = read_i64(buf, p)
    let threshold_kind = kind_pair.0
    p = kind_pair.1
    let bool_pair = read_i64(buf, p)
    let bool_threshold = bool_pair.0 != 0
    p = bool_pair.1
    let name_threshold_pair = read_name(buf, p)
    let name_threshold = name_threshold_pair.0
    p = name_threshold_pair.1
    (IrPolicyRequirementInfo {
        metric_id: metric_id,
        metric_name: metric_name,
        op: op,
        threshold: threshold,
        threshold_kind: threshold_kind,
        bool_threshold: bool_threshold,
        name_threshold: name_threshold,
    }, p)
}

fn write_model_family_info(buf: &![i8; 131072], pos: i64, info: IrModelFamilyInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_name(buf, p, info.name)
    p = write_i64(buf, p, info.model_count)
    var i: i64 = 0
    while i < 16 {
        p = write_name(buf, p, info.model_names[i])
        i = i + 1
    }
    p = write_type_tag(buf, p, info.input_ty)
    write_type_tag(buf, p, info.output_ty)
}

fn read_model_family_info(buf: &[i8; 131072], pos: i64) -> (IrModelFamilyInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1
    let count_pair = read_i64(buf, p)
    let model_count = count_pair.0
    p = count_pair.1
    var model_names: [Name; 16] = [ir_empty_name(); 16]
    var i: i64 = 0
    while i < 16 {
        let model_pair = read_name(buf, p)
        model_names[i] = model_pair.0
        p = model_pair.1
        i = i + 1
    }
    let input_pair = read_type_tag(buf, p)
    let input_ty = input_pair.0
    p = input_pair.1
    let output_pair = read_type_tag(buf, p)
    let output_ty = output_pair.0
    p = output_pair.1
    (IrModelFamilyInfo {
        id: -1,
        name: name,
        model_names: model_names,
        model_count: model_count,
        input_ty: input_ty,
        output_ty: output_ty,
    }, p)
}

fn write_ir_policy_info(buf: &![i8; 131072], pos: i64, info: IrPolicyInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, info.id)
    p = write_name(buf, p, info.name)
    p = write_type_tag(buf, p, info.target_ty)
    p = write_name(buf, p, info.level_name)
    p = write_name(buf, p, info.scope_name)
    p = write_i64(buf, p, info.level_id)
    p = write_i64(buf, p, info.scope_id)
    p = write_i64(buf, p, info.requirement_count)
    var i: i64 = 0
    while i < 8 {
        p = write_policy_requirement_info(buf, p, info.requirements[i])
        i = i + 1
    }
    p
}

fn read_ir_policy_info(buf: &[i8; 131072], pos: i64) -> (IrPolicyInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let id_pair = read_i64(buf, p)
    let id = id_pair.0
    p = id_pair.1
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1
    let target_pair = read_type_tag(buf, p)
    let target_ty = target_pair.0
    p = target_pair.1
    let level_name_pair = read_name(buf, p)
    let level_name = level_name_pair.0
    p = level_name_pair.1
    let scope_name_pair = read_name(buf, p)
    let scope_name = scope_name_pair.0
    p = scope_name_pair.1
    let level_id_pair = read_i64(buf, p)
    let level_id = level_id_pair.0
    p = level_id_pair.1
    let scope_id_pair = read_i64(buf, p)
    let scope_id = scope_id_pair.0
    p = scope_id_pair.1
    let req_count_pair = read_i64(buf, p)
    let requirement_count = req_count_pair.0
    p = req_count_pair.1
    var requirements: [IrPolicyRequirementInfo; 8] = [ir_empty_policy_requirement_info(); 8]
    var i: i64 = 0
    while i < 8 {
        let req_pair = read_policy_requirement_info(buf, p)
        requirements[i] = req_pair.0
        p = req_pair.1
        i = i + 1
    }
    (IrPolicyInfo {
        id: id,
        name: name,
        target_ty: target_ty,
        level_name: level_name,
        scope_name: scope_name,
        level_id: level_id,
        scope_id: scope_id,
        requirements: requirements,
        requirement_count: requirement_count,
    }, p)
}

fn write_decision_policy_info(buf: &![i8; 131072], pos: i64, info: IrDecisionPolicyInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, info.id)
    p = write_name(buf, p, info.name)
    p = write_type_tag(buf, p, info.target_ty)
    p = write_i64(buf, p, info.requirement_count)
    var i: i64 = 0
    while i < info.requirement_count && i < 8 {
        p = write_policy_requirement_info(buf, p, info.requirements[i])
        i = i + 1
    }
    p
}

fn read_decision_policy_info(buf: &[i8; 131072], pos: i64) -> (IrDecisionPolicyInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let id_pair = read_i64(buf, p)
    let id = id_pair.0
    p = id_pair.1
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1
    let target_pair = read_type_tag(buf, p)
    let target_ty = target_pair.0
    p = target_pair.1
    let req_count_pair = read_i64(buf, p)
    let requirement_count = req_count_pair.0
    p = req_count_pair.1
    var requirements: [IrPolicyRequirementInfo; 8] = [ir_empty_policy_requirement_info(); 8]
    var i: i64 = 0
    while i < requirement_count && i < 8 {
        let req_pair = read_policy_requirement_info(buf, p)
        requirements[i] = req_pair.0
        p = req_pair.1
        i = i + 1
    }
    (IrDecisionPolicyInfo {
        id: id,
        name: name,
        target_ty: target_ty,
        requirements: requirements,
        requirement_count: requirement_count,
    }, p)
}

fn write_deferral_policy_info(buf: &![i8; 131072], pos: i64, info: IrDeferralPolicyInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, info.id)
    p = write_name(buf, p, info.name)
    p = write_type_tag(buf, p, info.target_ty)
    p = write_name(buf, p, info.route_name)
    p = write_i64(buf, p, info.requirement_count)
    var i: i64 = 0
    while i < info.requirement_count && i < 8 {
        p = write_policy_requirement_info(buf, p, info.requirements[i])
        i = i + 1
    }
    p
}

fn read_deferral_policy_info(buf: &[i8; 131072], pos: i64) -> (IrDeferralPolicyInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let id_pair = read_i64(buf, p)
    let id = id_pair.0
