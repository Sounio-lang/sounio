        p = c28.1
        i = 0
        while i < ep.transition_step_count && i < IR_MAX_EPI_TRANSITION_STEPS {
            let pair = read_transition_step_info(buf, p)
            ep.transition_steps[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c29 = read_i64(buf, p)
        ep.transition_plan_count = c29.0
        p = c29.1
        i = 0
        while i < ep.transition_plan_count && i < IR_MAX_EPI_TRANSITION_PLANS {
            let pair = read_transition_plan_info(buf, p)
            ep.transition_plans[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c30 = read_i64(buf, p)
        ep.transition_reason_witness_count = c30.0
        p = c30.1
        i = 0
        while i < ep.transition_reason_witness_count && i < IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
            let pair = read_transition_reason_witness_info(buf, p)
            ep.transition_reason_witnesses[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c31 = read_i64(buf, p)
        ep.monitoring_policy_count = c31.0
        p = c31.1
        i = 0
        while i < ep.monitoring_policy_count && i < IR_MAX_EPI_MONITORING_POLICIES {
            let pair = read_monitoring_policy_info(buf, p)
            ep.monitoring_policies[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c32 = read_i64(buf, p)
        ep.observed_transition_count = c32.0
        p = c32.1
        i = 0
        while i < ep.observed_transition_count && i < IR_MAX_EPI_OBSERVED_TRANSITIONS {
            let pair = read_observed_transition_info(buf, p)
            ep.observed_transitions[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c33 = read_i64(buf, p)
        ep.rollback_certificate_count = c33.0
        p = c33.1
        i = 0
        while i < ep.rollback_certificate_count && i < IR_MAX_EPI_ROLLBACK_CERTIFICATES {
            let pair = read_rollback_certificate_info(buf, p)
            ep.rollback_certificates[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
        let c34 = read_i64(buf, p)
        ep.hyper_expr_count = c34.0
        p = c34.1
        i = 0
        while i < ep.hyper_expr_count && i < IR_MAX_EPI_HYPER_EXPRS {
            let pair = read_hyper_expr_info(buf, p)
            ep.hyper_exprs[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    (ep, p)
}

// #1161: every writer above takes the 128 KiB image BY REFERENCE and returns
// only the new position. Two lean_single limits shape this code, because
// lean_single compiles Madaros: a local alias of a `&![i8; N]` parameter
// (`let b = buf`) loses the byte element size, so `(*b)[i] = v` stores with an
// 8-byte stride past the image; and `(*out_len) = v` on a scalar reference is
// dropped, while `*out_len = v` stores. Both are avoided here. They used to take and return `[i8; 131072]` by value,
// which copied the whole image at every call: importing this module into
// Madaros doubled the compiler binary (125 MB -> 229 MB), so the IR modes in
// compiler/main.sio kept a second, lossy writer. The module is borrowed too
// (an IrModule carries a 16384-entry string table).
pub fn serialize_ir_module_ref(module: &IrModule, buf: &![i8; 131072], out_len: &! i64) with Mut, Panic, Div, Alloc {
    var pos: i64 = 0
    let refusals_before = SOIR_SER_REFUSAL_COUNT

    // The image is written in place: clear it first, so padding bytes the
    // writers skip are zero as they were in a fresh buffer.
    var zi: i64 = 0
    while zi < SOIR_MAX_SIZE {
        (*buf)[zi] = 0 as i8
        zi = zi + 1
    }

    // Write header
    (*buf)[0] = 83 as i8   // 'S'
    (*buf)[1] = 79 as i8   // 'O'
    (*buf)[2] = 73 as i8   // 'I'
    (*buf)[3] = 82 as i8   // 'R'
    (*buf)[4] = SOIR_VERSION
    (*buf)[5] = SOIR_FEATURES_CURRENT
    (*buf)[6] = 0 as i8
    (*buf)[7] = 0 as i8
    pos = 8

    // Write function count
    pos = write_i64(buf, pos, (*module).fn_count)

    // Write functions
    var i: i64 = 0
    while i < (*module).fn_count {
        pos = serialize_ir_function(buf, pos, ir_fn_get(&(*module), i))
        i = i + 1
    }

    // Write string count
    pos = write_i64(buf, pos, (*module).string_count)

    // Write string table
    var j: i64 = 0
    while j < (*module).string_count {
        pos = write_name(buf, pos, (*module).string_table[j])
        j = j + 1
    }

    if SOIR_VERSION >= 2 {
        pos = serialize_ir_epistemic_section(buf, pos, &(*module).epistemic)
    }

    if SOIR_VERSION >= 3 {
        pos = serialize_ir_algebra_table(buf, pos, &(*module).algebras)
    }

    if SOIR_SER_REFUSAL_COUNT != refusals_before {
        *out_len = 0
    } else {
        *out_len = pos
    }
}

pub fn serialize_ir_module_into(module: IrModule, out_buf: &![i8; 131072], out_len: &! i64) with Mut, Panic, Div, Alloc {
    serialize_ir_module_ref(&module, out_buf, out_len)
}

pub fn serialize_ir_module(module: IrModule) -> ([i8; 131072], i64) with Mut, Panic, Div, Alloc {
    var buf: [i8; 131072] = [0; 131072]
    var len: i64 = 0
    serialize_ir_module_ref(&module, &! buf, &! len)
    (buf, len)
}

pub fn deserialize_ir_module_ref(buf: &[i8; 131072], len: i64) -> IrModule with Mut, Panic, Div, Alloc {
    var pos: i64 = 0
    let refusals_before = SOIR_DESER_REFUSAL_COUNT

    if len < 16 || len > SOIR_MAX_SIZE {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    SOIR_DESER_ACTIVE_LIMIT = len

    // Verify header magic - cast literals to i8 for comparison
    let b0: i8 = 83 as i8
    let b1: i8 = 79 as i8
    let b2: i8 = 73 as i8
    let b3: i8 = 82 as i8
    let magic_ok = (*buf)[0] == b0 && (*buf)[1] == b1 && (*buf)[2] == b2 && (*buf)[3] == b3
    if !magic_ok {
        // Return empty module on invalid magic
        return ir_empty_module()
    }
    let version = (*buf)[4]
    // v1-v4 lack sound call/floating metadata. v5 is readable with an
    // explicit unknown return-kind marker; consumers fail closed on .value.
    if version != SOIR_VERSION && version != 5 {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    let features = if version >= 5 { (*buf)[5] } else { 0 as i8 }
    let expected_features = if version == 5 { SOIR_FEATURES_V5 } else { SOIR_FEATURES_CURRENT }
    if features != expected_features {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    if (*buf)[6] != 0 as i8 || (*buf)[7] != 0 as i8 {
        soir_note_deser_refusal()
        return ir_empty_module()
    }

    pos = 8  // Skip header

    // Read function count
    let fn_count_pair = read_i64(buf, pos)
    let fn_count = fn_count_pair.0
    pos = fn_count_pair.1

    // Read functions. Oversized modules are refused before any table growth.
    if fn_count < 0 || fn_count > IR_MAX_FUNCS {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    var module = ir_empty_module()
    var i: i64 = 0
    while i < fn_count {
        let func_pair = deserialize_ir_function(buf, len, pos, version, features)
        // A refused/truncated function must invalidate the whole cache entry.
        // Keeping fn_count while storing ir_empty_function() would expose a
        // partially accepted module to thin-cache consumers.
        if SOIR_DESER_REFUSAL_COUNT != refusals_before {
            return ir_empty_module()
        }
        ir_fn_pool_ensure(&module, i)
        ir_fn_set(&! module, i, func_pair.0)
        pos = func_pair.1
        i = i + 1
    }

    // Read string count
    if pos < 0 || pos > len - 8 {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    let string_count_pair = read_i64(buf, pos)
    let string_count = string_count_pair.0
    pos = string_count_pair.1

    // Read string table. Literal matches IR_MAX_STRINGS (ir.sio:36).
    // Refuse oversized modules rather than writing past the buffer.
    if string_count < 0 || string_count > IR_MAX_STRINGS {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    // Literal MUST equal IR_MAX_STRINGS; same gate as the function table.
    var string_table: [Name; 16384] = [ir_empty_name(); 16384]
    var j: i64 = 0
    while j < string_count {
        if pos < 0 || pos > len - 136 {
            soir_note_deser_refusal()
            return ir_empty_module()
        }
        let name_pair = read_name(buf, pos)
        string_table[j] = name_pair.0
        pos = name_pair.1
        j = j + 1
    }

    module.fn_count = fn_count
    module.string_table = string_table
    module.string_count = string_count

    if version >= 2 && pos >= len {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    if version >= 2 && pos < len {
        let ep_pair = deserialize_ir_epistemic_section(buf, pos, len)
        if SOIR_DESER_REFUSAL_COUNT != refusals_before {
            return ir_empty_module()
        }
        module.epistemic = ep_pair.0
        pos = ep_pair.1
    }

    if version >= 3 && pos >= len {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    if version >= 3 && pos < len {
        let alg_pair = deserialize_ir_algebra_table(buf, pos)
        if SOIR_DESER_REFUSAL_COUNT != refusals_before {
            return ir_empty_module()
        }
        module.algebras = alg_pair.0
        pos = alg_pair.1
    }

    // Every serializer version emitted by this module is canonical: accepting
    // either a truncated section or trailing bytes would let the declared
    // length describe a different cache object than the bytes consumed.
    if pos != len {
        soir_note_deser_refusal()
        return ir_empty_module()
    }
    // Legacy v5 has no Knowledge<T> return marker. Count only fully validated
    // decodes so the cache caller can surface a migration diagnostic.
    if version == 5 { SOIR_DESER_V5_UNKNOWN_RETURN_METADATA_COUNT = SOIR_DESER_V5_UNKNOWN_RETURN_METADATA_COUNT + 1 }

    module
}

pub fn deserialize_ir_module(buf: [i8; 131072], len: i64) -> IrModule with Mut, Panic, Div, Alloc {
    deserialize_ir_module_ref(&buf, len)
}

// ============================================================
// Hyper type serialization (SOIR v1.1 extension)
// ============================================================
//
// TypeKind tags for serialization:
//   0-21: existing types (TyI64..TyKnowledge)
//   22: TyHyper — followed by algebra_kind (i64), clifford_p (i64), clifford_q (i64)
//   23: TyIntervention — followed by epsilon (f64), inner type
//   24: TyCounterfactual — followed by epsilon (f64), inner type
//
// Format: [kind: i8] [algebra_kind: i64] [clifford_p: i64] [clifford_q: i64] [inner: TypeTag]

let SOIR_TYPE_HYPER: i8 = 22
let SOIR_TYPE_INTERVENTION: i8 = 23
let SOIR_TYPE_COUNTERFACTUAL: i8 = 24
let SOIR_TYPE_VALIDATED: i8 = 25

fn write_type_tag(buf: &![i8; 131072], pos: i64, ty: TypeEntry) -> i64 with Mut, Panic, Div {
    var p = pos

    if ty.kind == TypeKind::TyI64 {
        let pair = write_i8(buf, p, 0)
        return pair
    }
    if ty.kind == TypeKind::TyF64 {
        let pair = write_i8(buf, p, 1)
        return pair
    }
    if ty.kind == TypeKind::TyBool {
        let pair = write_i8(buf, p, 2)
        return pair
    }
    if ty.kind == TypeKind::TyHyper {
        p = write_i8(buf, p, SOIR_TYPE_HYPER)
        p = write_i64(buf, p, ty.algebra_kind)
        p = write_i64(buf, p, ty.clifford_p)
        let cq_pair = write_i64(buf, p, ty.clifford_q)
        return cq_pair
    }
    if ty.kind == TypeKind::TyIntervention {
        let tag_pair = write_i8(buf, p, SOIR_TYPE_INTERVENTION)
        return tag_pair
    }
    if ty.kind == TypeKind::TyCounterfactual {
        let tag_pair = write_i8(buf, p, SOIR_TYPE_COUNTERFACTUAL)
        return tag_pair
    }
    if ty.kind == TypeKind::TyValidated {
        let tag_pair = write_i8(buf, p, SOIR_TYPE_VALIDATED)
        return tag_pair
    }
    // Default: write kind ordinal
    let kind_tag: i8 = 0  // fallback
    write_i8(buf, p, kind_tag)
}

fn read_type_tag(buf: &[i8; 131072], pos: i64) -> (TypeEntry, i64) with Mut, Panic, Div, Alloc {
    let tag_pair = read_i8(buf, pos)
    let tag = tag_pair.0
    var p = tag_pair.1

    if tag == 0 { return (ty_i64(), p) }
    if tag == 1 { return (ty_f64(), p) }
    if tag == 2 { return (ty_bool(), p) }

    if tag == SOIR_TYPE_HYPER {
        let alg_pair = read_i64(buf, p)
        let alg = alg_pair.0
        p = alg_pair.1
        let cp_pair = read_i64(buf, p)
        let cl_p = cp_pair.0
        p = cp_pair.1
        let cq_pair = read_i64(buf, p)
        let cl_q = cq_pair.0
        p = cq_pair.1
        // Construct Hyper type with inner = f64 (default for hypercomplex)
        if alg == 5 {
            return (ty_clifford(cl_p, cl_q, ty_f64()), p)
        }
        return (ty_hyper(alg, ty_f64()), p)
    }

    if tag == SOIR_TYPE_INTERVENTION {
        return (ty_intervention(ty_f64(), -1.0), p)
    }
    if tag == SOIR_TYPE_COUNTERFACTUAL {
        return (ty_counterfactual(ty_f64(), -1.0), p)
    }
    if tag == SOIR_TYPE_VALIDATED {
        return (ty_validated(ty_f64(), -1.0), p)
    }

    // Unknown tag: return error type
    (ty_error(), p)
}
