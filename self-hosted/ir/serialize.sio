        metric_values[i] = pair.0
        p = pair.1
        i = i + 1
    }
    (IrRollbackCertificateInfo {
        id: id,
        span_start: span_start,
        span_end: span_end,
        transition_plan_id: transition_plan_id,
        monitoring_policy_id: monitoring_policy_id,
        audit_id: audit_id,
        contest_id: contest_id,
        route_name: route_name,
        rollback_route_name: rollback_route_name,
        reason_code: reason_code,
        inner_ty: inner_ty,
        metric_known: metric_known,
        metric_values: metric_values,
    }, p)
}

fn write_hyper_expr_info(buf: &![i8; 131072], pos: i64, info: IrHyperExprInfo) -> i64 with Mut, Panic, Div {
    var p = pos
    p = write_i64(buf, p, info.span_start)
    p = write_i64(buf, p, info.span_end)
    p = write_i64(buf, p, info.algebra_tag)
    p = write_i64(buf, p, info.op_kind)
    p = write_i64(buf, p, if info.knowledge_wrapped { 1 } else { 0 })
    p
}

fn read_hyper_expr_info(buf: &[i8; 131072], pos: i64) -> (IrHyperExprInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let p0 = read_i64(buf, p)
    let span_start = p0.0
    p = p0.1
    let p1 = read_i64(buf, p)
    let span_end = p1.0
    p = p1.1
    let p2 = read_i64(buf, p)
    let algebra_tag = p2.0
    p = p2.1
    let p3 = read_i64(buf, p)
    let op_kind = p3.0
    p = p3.1
    let p4 = read_i64(buf, p)
    let knowledge_wrapped = p4.0 != 0
    p = p4.1
    (IrHyperExprInfo {
        span_start: span_start,
        span_end: span_end,
        algebra_tag: algebra_tag,
        op_kind: op_kind,
        knowledge_wrapped: knowledge_wrapped,
        grade_mask: -1,
        grade_known: false,
        cl_p: 0,
        cl_q: 0,
        reassoc_strategy: 0,
        forbidden_law_mask: 0,
        law_profile_source: 0,
        law_profile_fingerprint: 0,
    }, p)
}

fn serialize_ir_epistemic_section(buf: &![i8; 131072], pos: i64, ep: &IrEpistemicSection) -> i64 with Mut, Panic, Div, Alloc {
    var p = pos

    p = write_i64(buf, p, ep.model_family_count)
    var i: i64 = 0
    while i < ep.model_family_count {
        p = write_model_family_info(buf, p, ep.model_families[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.policy_count)
    i = 0
    while i < ep.policy_count {
        p = write_ir_policy_info(buf, p, ep.policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.validation_count)
    i = 0
    while i < ep.validation_count {
        p = write_validation_policy_info(buf, p, ep.validations[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.mechanistic_report_count)
    i = 0
    while i < ep.mechanistic_report_count {
        p = write_mechanistic_report_info(buf, p, ep.mechanistic_reports[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.posterior_weights_count)
    i = 0
    while i < ep.posterior_weights_count {
        p = write_posterior_weights_info(buf, p, ep.posterior_weights[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.counterexample_count)
    i = 0
    while i < ep.counterexample_count {
        p = write_counterexample_info(buf, p, ep.counterexamples[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.audit_count)
    i = 0
    while i < ep.audit_count {
        p = write_audit_info(buf, p, ep.audits[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.contest_count)
    i = 0
    while i < ep.contest_count {
        p = write_contest_info(buf, p, ep.contests[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.contest_witness_count)
    i = 0
    while i < ep.contest_witness_count {
        p = write_contest_witness_info(buf, p, ep.contest_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.robust_proof_count)
    i = 0
    while i < ep.robust_proof_count {
        p = write_robust_proof_info(buf, p, ep.robust_proofs[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.validated_manifest_count)
    i = 0
    while i < ep.validated_manifest_count {
        p = write_validated_manifest_info(buf, p, ep.validated_manifests[i])
        i = i + 1
    }

    // Appended in-place to preserve compatibility with older SOIR v2 artifacts that
    // ended the epistemic section at validated_manifests.
    p = write_i64(buf, p, ep.decision_policy_count)
    i = 0
    while i < ep.decision_policy_count {
        p = write_decision_policy_info(buf, p, ep.decision_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.decision_certificate_count)
    i = 0
    while i < ep.decision_certificate_count {
        p = write_decision_certificate_info(buf, p, ep.decision_certificates[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.deferral_policy_count)
    i = 0
    while i < ep.deferral_policy_count {
        p = write_deferral_policy_info(buf, p, ep.deferral_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.deferred_certificate_count)
    i = 0
    while i < ep.deferred_certificate_count {
        p = write_deferred_certificate_info(buf, p, ep.deferred_certificates[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.deferred_reason_witness_count)
    i = 0
    while i < ep.deferred_reason_witness_count {
        p = write_deferred_reason_witness_info(buf, p, ep.deferred_reason_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.acquisition_policy_count)
    i = 0
    while i < ep.acquisition_policy_count {
        p = write_acquisition_policy_info(buf, p, ep.acquisition_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.acquisition_plan_count)
    i = 0
    while i < ep.acquisition_plan_count {
        p = write_acquisition_plan_info(buf, p, ep.acquisition_plans[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.acquisition_reason_witness_count)
    i = 0
    while i < ep.acquisition_reason_witness_count {
        p = write_acquisition_reason_witness_info(buf, p, ep.acquisition_reason_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.recourse_policy_count)
    i = 0
    while i < ep.recourse_policy_count {
        p = write_recourse_policy_info(buf, p, ep.recourse_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.recourse_plan_count)
    i = 0
    while i < ep.recourse_plan_count {
        p = write_recourse_plan_info(buf, p, ep.recourse_plans[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.recourse_reason_witness_count)
    i = 0
    while i < ep.recourse_reason_witness_count {
        p = write_recourse_reason_witness_info(buf, p, ep.recourse_reason_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.alternative_policy_count)
    i = 0
    while i < ep.alternative_policy_count {
        p = write_alternative_policy_info(buf, p, ep.alternative_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.alternative_frontier_count)
    i = 0
    while i < ep.alternative_frontier_count {
        p = write_alternative_frontier_info(buf, p, ep.alternative_frontiers[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.alternative_candidate_count)
    i = 0
    while i < ep.alternative_candidate_count {
        p = write_alternative_candidate_info(buf, p, ep.alternative_candidates[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.alternative_set_count)
    i = 0
    while i < ep.alternative_set_count {
        p = write_alternative_set_info(buf, p, ep.alternative_sets[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.alternative_reason_witness_count)
    i = 0
    while i < ep.alternative_reason_witness_count {
        p = write_alternative_reason_witness_info(buf, p, ep.alternative_reason_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.transition_policy_count)
    i = 0
    while i < ep.transition_policy_count {
        p = write_transition_policy_info(buf, p, ep.transition_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.transition_protocol_count)
    i = 0
    while i < ep.transition_protocol_count {
        p = write_transition_protocol_info(buf, p, ep.transition_protocols[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.transition_step_count)
    i = 0
    while i < ep.transition_step_count {
        p = write_transition_step_info(buf, p, ep.transition_steps[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.transition_plan_count)
    i = 0
    while i < ep.transition_plan_count {
        p = write_transition_plan_info(buf, p, ep.transition_plans[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.transition_reason_witness_count)
    i = 0
    while i < ep.transition_reason_witness_count {
        p = write_transition_reason_witness_info(buf, p, ep.transition_reason_witnesses[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.monitoring_policy_count)
    i = 0
    while i < ep.monitoring_policy_count {
        p = write_monitoring_policy_info(buf, p, ep.monitoring_policies[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.observed_transition_count)
    i = 0
    while i < ep.observed_transition_count {
        p = write_observed_transition_info(buf, p, ep.observed_transitions[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.rollback_certificate_count)
    i = 0
    while i < ep.rollback_certificate_count {
        p = write_rollback_certificate_info(buf, p, ep.rollback_certificates[i])
        i = i + 1
    }

    p = write_i64(buf, p, ep.hyper_expr_count)
    i = 0
    while i < ep.hyper_expr_count {
        p = write_hyper_expr_info(buf, p, ep.hyper_exprs[i])
        i = i + 1
    }

    p
}

fn deserialize_ir_epistemic_section(buf: &[i8; 131072], pos: i64, len: i64) -> (IrEpistemicSection, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    var ep = ir_empty_epistemic_section()

    let c0 = read_i64(buf, p)
    ep.model_family_count = c0.0
    p = c0.1
    var i: i64 = 0
    while i < ep.model_family_count && i < IR_MAX_EPI_MODEL_FAMILIES {
        let pair = read_model_family_info(buf, p)
        ep.model_families[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c1 = read_i64(buf, p)
    ep.policy_count = c1.0
    p = c1.1
    i = 0
    while i < ep.policy_count && i < IR_MAX_EPI_POLICIES {
        let pair = read_ir_policy_info(buf, p)
        ep.policies[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c2 = read_i64(buf, p)
    ep.validation_count = c2.0
    p = c2.1
    i = 0
    while i < ep.validation_count && i < IR_MAX_EPI_VALIDATIONS {
        let pair = read_validation_policy_info(buf, p)
        ep.validations[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c3 = read_i64(buf, p)
    ep.mechanistic_report_count = c3.0
    p = c3.1
    i = 0
    while i < ep.mechanistic_report_count && i < IR_MAX_EPI_MECHANISTIC_REPORTS {
        let pair = read_mechanistic_report_info(buf, p)
        ep.mechanistic_reports[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c4 = read_i64(buf, p)
    ep.posterior_weights_count = c4.0
    p = c4.1
    i = 0
    while i < ep.posterior_weights_count && i < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        let pair = read_posterior_weights_info(buf, p)
        ep.posterior_weights[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c5 = read_i64(buf, p)
    ep.counterexample_count = c5.0
    p = c5.1
    i = 0
    while i < ep.counterexample_count && i < IR_MAX_EPI_COUNTEREXAMPLES {
        let pair = read_counterexample_info(buf, p)
        ep.counterexamples[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c5b = read_i64(buf, p)
    ep.audit_count = c5b.0
    p = c5b.1
    i = 0
    while i < ep.audit_count && i < IR_MAX_EPI_AUDITS {
        let pair = read_audit_info(buf, p)
        ep.audits[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c6 = read_i64(buf, p)
    ep.contest_count = c6.0
    p = c6.1
    i = 0
    while i < ep.contest_count && i < IR_MAX_EPI_CONTESTS {
        let pair = read_contest_info(buf, p)
        ep.contests[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c7 = read_i64(buf, p)
    ep.contest_witness_count = c7.0
    p = c7.1
    i = 0
    while i < ep.contest_witness_count && i < IR_MAX_EPI_CONTEST_WITNESSES {
        let pair = read_contest_witness_info(buf, p)
        ep.contest_witnesses[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c8 = read_i64(buf, p)
    ep.robust_proof_count = c8.0
    p = c8.1
    i = 0
    while i < ep.robust_proof_count && i < IR_MAX_EPI_ROBUST_PROOFS {
        let pair = read_robust_proof_info(buf, p)
        ep.robust_proofs[i] = pair.0
        p = pair.1
        i = i + 1
    }

    let c9 = read_i64(buf, p)
    ep.validated_manifest_count = c9.0
    p = c9.1
    i = 0
    while i < ep.validated_manifest_count && i < IR_MAX_EPI_VALIDATED_MANIFESTS {
        let pair = read_validated_manifest_info(buf, p)
        ep.validated_manifests[i] = pair.0
        p = pair.1
        i = i + 1
    }

    if p < len {
        let c10 = read_i64(buf, p)
        ep.decision_policy_count = c10.0
        p = c10.1
        i = 0
        while i < ep.decision_policy_count && i < IR_MAX_EPI_DECISION_POLICIES {
            let pair = read_decision_policy_info(buf, p)
            ep.decision_policies[i] = pair.0
            p = pair.1
            i = i + 1
        }
    }

    if p < len {
