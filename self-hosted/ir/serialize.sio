// IR serialization/deserialization for verification and artifact boundary

use parser::ast::*
use ir::ir::*
use check::types::*
//
// SOIR v1 Binary Format:
// ─────────────────────────
// Header (8 bytes):
//   - Magic: "SOIR" (0x534F4952 little-endian)
//   - Version: 1 (1 byte)
//   - Reserved: 0x00 (3 bytes padding)
//
// Body:
//   - fn_count: i64 (8 bytes)
//   - functions[]: array of serialized IrFunction
//   - string_count: i64 (8 bytes)
//   - strings[]: array of serialized Name
//
// IrFunction encoding:
//   - name: Name (128 bytes + 8 byte length)
//   - instr_count: i64
//   - reg_count: i64
//   - label_count: i64
//   - param_count: i64
//   - param_regs: [i64; 64]
//   - instrs: array of IrInstr
//
// IrInstr encoding (fixed-size, 128 bytes):
//   - op: IrOpcode (1 byte + 7 padding)
//   - dst, src1, src2: i64 (8 bytes each)
//   - imm_i64: i64
//   - imm_f64: f64
//   - label_id, fn_id, field_idx: i64 (8 bytes each)
//   - bin_op: BinaryOp (1 byte + 7 padding)
//   - un_op: UnaryOp (1 byte + 7 padding)
//   - name: Name (128 bytes + 8 byte length)
//   - arg_count: i64

let SOIR_MAGIC: i64 = 1380206931  // "SOIR" as i32 cast to i64
let SOIR_VERSION: i8 = 1
let SOIR_MAX_SIZE: i64 = 131072  // 128KB max module size

fn write_i8(buf: [i8; 131072], pos: i64, val: i8) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    b[pos] = val
    (b, pos + 1)
}

fn write_i64(buf: [i8; 131072], pos: i64, val: i64) -> ([i8; 131072], i64) with Mut, Panic, Div {
    // Little-endian encoding - use write_i8 helper to avoid type issues
    var b = buf
    var p = pos

    let p0 = write_i8(b, p, ((val) & 255) as i8)
    b = p0.0
    p = p0.1
    let p1 = write_i8(b, p, ((val >> 8) & 255) as i8)
    b = p1.0
    p = p1.1
    let p2 = write_i8(b, p, ((val >> 16) & 255) as i8)
    b = p2.0
    p = p2.1
    let p3 = write_i8(b, p, ((val >> 24) & 255) as i8)
    b = p3.0
    p = p3.1
    let p4 = write_i8(b, p, ((val >> 32) & 255) as i8)
    b = p4.0
    p = p4.1
    let p5 = write_i8(b, p, ((val >> 40) & 255) as i8)
    b = p5.0
    p = p5.1
    let p6 = write_i8(b, p, ((val >> 48) & 255) as i8)
    b = p6.0
    p = p6.1
    let p7 = write_i8(b, p, ((val >> 56) & 255) as i8)
    b = p7.0
    p = p7.1

    (b, p)
}

fn write_f64(buf: [i8; 131072], pos: i64, val: f64) -> ([i8; 131072], i64) with Mut, Panic, Div {
    // IEEE 754 double as i64 bits (reinterpret cast via arithmetic)
    // In self-hosted context, we serialize as raw bits
    let bits = val as i64  // FIXME: needs proper bit reinterpretation
    write_i64(buf, pos, bits)
}

fn write_name(buf: [i8; 131072], pos: i64, n: Name) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    // Write length first
    let pair = write_i64(b, p, n.len)
    b = pair.0
    p = pair.1
    // Write buffer bytes
    var i: i64 = 0
    while i < 128 {
        b[p + i] = n.buf[i]
        i = i + 1
    }
    (b, p + 128)
}

fn read_i8(buf: [i8; 131072], pos: i64) -> (i8, i64) with Mut, Panic, Div {
    (buf[pos], pos + 1)
}

fn read_i64(buf: [i8; 131072], pos: i64) -> (i64, i64) with Mut, Panic, Div {
    // Little-endian decoding - mask to ensure unsigned byte interpretation
    let raw0: i64 = buf[pos + 0] as i64
    let raw1: i64 = buf[pos + 1] as i64
    let raw2: i64 = buf[pos + 2] as i64
    let raw3: i64 = buf[pos + 3] as i64
    let raw4: i64 = buf[pos + 4] as i64
    let raw5: i64 = buf[pos + 5] as i64
    let raw6: i64 = buf[pos + 6] as i64
    let raw7: i64 = buf[pos + 7] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    let val = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
    (val, pos + 8)
}

fn read_f64(buf: [i8; 131072], pos: i64) -> (f64, i64) with Mut, Panic, Div {
    let pair = read_i64(buf, pos)
    let bits = pair.0
    let next_pos = pair.1
    // FIXME: needs proper bit reinterpretation
    (bits as f64, next_pos)
}

fn read_name(buf: [i8; 131072], pos: i64) -> (Name, i64) with Mut, Panic, Div {
    let len_pair = read_i64(buf, pos)
    let len = len_pair.0
    var p = len_pair.1

    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < 128 {
        n.buf[i] = buf[p + i]
        i = i + 1
    }
    (n, p + 128)
}

fn write_opcode(buf: [i8; 131072], pos: i64, op: IrOpcode) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
    }
    write_i8(buf, pos, tag)
}

fn read_opcode(buf: [i8; 131072], pos: i64) -> (IrOpcode, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { IrOpcode::IrLoadImm }
        else if tag == 1 { IrOpcode::IrLoadFloat }
        else if tag == 2 { IrOpcode::IrLoadBool }
        else if tag == 3 { IrOpcode::IrLoadString }
        else if tag == 4 { IrOpcode::IrCopy }
        else if tag == 5 { IrOpcode::IrBinOp }
        else if tag == 6 { IrOpcode::IrUnaryOp }
        else if tag == 7 { IrOpcode::IrCall }
        else if tag == 8 { IrOpcode::IrReturn }
        else if tag == 9 { IrOpcode::IrJump }
        else if tag == 10 { IrOpcode::IrBranchTrue }
        else if tag == 11 { IrOpcode::IrBranchFalse }
        else if tag == 12 { IrOpcode::IrFieldGet }
        else if tag == 13 { IrOpcode::IrFieldSet }
        else if tag == 14 { IrOpcode::IrIndexGet }
        else if tag == 15 { IrOpcode::IrIndexSet }
        else if tag == 16 { IrOpcode::IrAlloc }
        else if tag == 17 { IrOpcode::IrLabel }
        else if tag == 18 { IrOpcode::IrNop }
        else { IrOpcode::IrPhi }
    (op, next_pos)
}

fn write_binary_op(buf: [i8; 131072], pos: i64, op: BinaryOp) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
    write_i8(buf, pos, tag)
}

fn read_binary_op(buf: [i8; 131072], pos: i64) -> (BinaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { BinaryOp::OpAdd }
        else if tag == 1 { BinaryOp::OpSub }
        else if tag == 2 { BinaryOp::OpMul }
        else if tag == 3 { BinaryOp::OpDiv }
        else if tag == 4 { BinaryOp::OpRem }
        else if tag == 5 { BinaryOp::OpEq }
        else if tag == 6 { BinaryOp::OpNe }
        else if tag == 7 { BinaryOp::OpLt }
        else if tag == 8 { BinaryOp::OpLe }
        else if tag == 9 { BinaryOp::OpGt }
        else if tag == 10 { BinaryOp::OpGe }
        else if tag == 11 { BinaryOp::OpAnd }
        else if tag == 12 { BinaryOp::OpOr }
        else if tag == 13 { BinaryOp::OpBitAnd }
        else if tag == 14 { BinaryOp::OpBitOr }
        else if tag == 15 { BinaryOp::OpBitXor }
        else if tag == 16 { BinaryOp::OpShl }
        else if tag == 17 { BinaryOp::OpShr }
        else if tag == 18 { BinaryOp::OpConcat }
        else if tag == 19 { BinaryOp::OpRange }
        else { BinaryOp::OpRangeInclusive }
    (op, next_pos)
}

fn write_unary_op(buf: [i8; 131072], pos: i64, op: UnaryOp) -> ([i8; 131072], i64) with Mut, Panic, Div {
    let tag: i8 = match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
    write_i8(buf, pos, tag)
}

fn read_unary_op(buf: [i8; 131072], pos: i64) -> (UnaryOp, i64) with Mut, Panic, Div {
    let pair = read_i8(buf, pos)
    let tag = pair.0
    let next_pos = pair.1
    let op = if tag == 0 { UnaryOp::OpNeg }
        else if tag == 1 { UnaryOp::OpNot }
        else if tag == 2 { UnaryOp::OpRef }
        else if tag == 3 { UnaryOp::OpRefMut }
        else { UnaryOp::OpDeref }
    (op, next_pos)
}

fn serialize_ir_instr(buf: [i8; 131072], pos: i64, instr: IrInstr) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos

    let op_pair = write_opcode(b, p, instr.op)
    b = op_pair.0
    p = op_pair.1
    p = p + 7  // 7-byte padding for alignment

    let dst_pair = write_i64(b, p, instr.dst)
    b = dst_pair.0
    p = dst_pair.1
    let src1_pair = write_i64(b, p, instr.src1)
    b = src1_pair.0
    p = src1_pair.1
    let src2_pair = write_i64(b, p, instr.src2)
    b = src2_pair.0
    p = src2_pair.1

    let imm_i64_pair = write_i64(b, p, instr.imm_i64)
    b = imm_i64_pair.0
    p = imm_i64_pair.1

    let imm_f64_pair = write_f64(b, p, instr.imm_f64)
    b = imm_f64_pair.0
    p = imm_f64_pair.1

    let label_id_pair = write_i64(b, p, instr.label_id)
    b = label_id_pair.0
    p = label_id_pair.1
    let fn_id_pair = write_i64(b, p, instr.fn_id)
    b = fn_id_pair.0
    p = fn_id_pair.1
    let field_idx_pair = write_i64(b, p, instr.field_idx)
    b = field_idx_pair.0
    p = field_idx_pair.1

    let bin_op_pair = write_binary_op(b, p, instr.bin_op)
    b = bin_op_pair.0
    p = bin_op_pair.1
    p = p + 7  // 7-byte padding

    let un_op_pair = write_unary_op(b, p, instr.un_op)
    b = un_op_pair.0
    p = un_op_pair.1
    p = p + 7  // 7-byte padding

    let name_pair = write_name(b, p, instr.name)
    b = name_pair.0
    p = name_pair.1

    let arg_count_pair = write_i64(b, p, instr.arg_count)
    b = arg_count_pair.0
    p = arg_count_pair.1
    // Note: call_args linked list is NOT serialized (reconstructed from arg_count)

    (b, p)
}

fn deserialize_ir_instr(buf: [i8; 131072], pos: i64) -> (IrInstr, i64) with Mut, Panic, Div {
    var p = pos
    let op_pair = read_opcode(buf, p)
    let op = op_pair.0
    p = op_pair.1 + 7  // skip padding

    let dst_pair = read_i64(buf, p)
    let dst = dst_pair.0
    p = dst_pair.1

    let src1_pair = read_i64(buf, p)
    let src1 = src1_pair.0
    p = src1_pair.1

    let src2_pair = read_i64(buf, p)
    let src2 = src2_pair.0
    p = src2_pair.1

    let imm_i64_pair = read_i64(buf, p)
    let imm_i64 = imm_i64_pair.0
    p = imm_i64_pair.1

    let imm_f64_pair = read_f64(buf, p)
    let imm_f64 = imm_f64_pair.0
    p = imm_f64_pair.1

    let label_id_pair = read_i64(buf, p)
    let label_id = label_id_pair.0
    p = label_id_pair.1

    let fn_id_pair = read_i64(buf, p)
    let fn_id = fn_id_pair.0
    p = fn_id_pair.1

    let field_idx_pair = read_i64(buf, p)
    let field_idx = field_idx_pair.0
    p = field_idx_pair.1

    let bin_op_pair = read_binary_op(buf, p)
    let bin_op = bin_op_pair.0
    p = bin_op_pair.1 + 7  // skip padding

    let un_op_pair = read_unary_op(buf, p)
    let un_op = un_op_pair.0
    p = un_op_pair.1 + 7  // skip padding

    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1

    let arg_count_pair = read_i64(buf, p)
    let arg_count = arg_count_pair.0
    p = arg_count_pair.1

    let instr = IrInstr {
        op: op,
        dst: dst,
        src1: src1,
        src2: src2,
        imm_i64: imm_i64,
        imm_f64: imm_f64,
        label_id: label_id,
        fn_id: fn_id,
        field_idx: field_idx,
        bin_op: bin_op,
        un_op: un_op,
        name: name,
        call_args: ir_empty_reg_list(),  // Not serialized
        arg_count: arg_count,
    }
    (instr, p)
}

fn serialize_ir_function(buf: [i8; 131072], pos: i64, func: IrFunction) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos

    let name_pair = write_name(b, p, func.name)
    b = name_pair.0
    p = name_pair.1
    let instr_count_pair = write_i64(b, p, func.instr_count)
    b = instr_count_pair.0
    p = instr_count_pair.1
    let reg_count_pair = write_i64(b, p, func.reg_count)
    b = reg_count_pair.0
    p = reg_count_pair.1
    let label_count_pair = write_i64(b, p, func.label_count)
    b = label_count_pair.0
    p = label_count_pair.1
    let param_count_pair = write_i64(b, p, func.param_count)
    b = param_count_pair.0
    p = param_count_pair.1

    // Write param_regs array
    var i: i64 = 0
    while i < 64 {
        let reg_pair = write_i64(b, p, func.param_regs[i])
        b = reg_pair.0
        p = reg_pair.1
        i = i + 1
    }

    // Write instructions
    var j: i64 = 0
    while j < func.instr_count {
        let instr_pair = serialize_ir_instr(b, p, func.instrs[j])
        b = instr_pair.0
        p = instr_pair.1
        j = j + 1
    }

    (b, p)
}

fn deserialize_ir_function(buf: [i8; 131072], pos: i64) -> (IrFunction, i64) with Mut, Panic, Div {
    var p = pos
    let name_pair = read_name(buf, p)
    let name = name_pair.0
    p = name_pair.1

    let instr_count_pair = read_i64(buf, p)
    let instr_count = instr_count_pair.0
    p = instr_count_pair.1

    let reg_count_pair = read_i64(buf, p)
    let reg_count = reg_count_pair.0
    p = reg_count_pair.1

    let label_count_pair = read_i64(buf, p)
    let label_count = label_count_pair.0
    p = label_count_pair.1

    let param_count_pair = read_i64(buf, p)
    let param_count = param_count_pair.0
    p = param_count_pair.1

    // Read param_regs array
    var param_regs: [i64; 64] = [IR_INVALID_REG; 64]
    var i: i64 = 0
    while i < 64 {
        let reg_pair = read_i64(buf, p)
        param_regs[i] = reg_pair.0
        p = reg_pair.1
        i = i + 1
    }

    // Read instructions
    var instrs: [IrInstr; 2048] = [ir_nop(); 2048]
    var j: i64 = 0
    while j < instr_count {
        let instr_pair = deserialize_ir_instr(buf, p)
        instrs[j] = instr_pair.0
        p = instr_pair.1
        j = j + 1
    }

    let func = IrFunction {
        name: name,
        instrs: instrs,
        instr_count: instr_count,
        reg_count: reg_count,
        label_count: label_count,
        param_count: param_count,
        param_regs: param_regs,
    }
    (func, p)
}

fn serialize_ir_module(module: IrModule) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var buf: [i8; 131072] = [0; 131072]
    var pos: i64 = 0

    // Write header
    buf[0] = 83 as i8   // 'S'
    buf[1] = 79 as i8   // 'O'
    buf[2] = 73 as i8   // 'I'
    buf[3] = 82 as i8   // 'R'
    buf[4] = SOIR_VERSION
    buf[5] = 0 as i8
    buf[6] = 0 as i8
    buf[7] = 0 as i8
    pos = 8

    // Write function count
    let fn_count_pair = write_i64(buf, pos, module.fn_count)
    buf = fn_count_pair.0
    pos = fn_count_pair.1

    // Write functions
    var i: i64 = 0
    while i < module.fn_count {
        let func_pair = serialize_ir_function(buf, pos, module.functions[i])
        buf = func_pair.0
        pos = func_pair.1
        i = i + 1
    }

    // Write string count
    let string_count_pair = write_i64(buf, pos, module.string_count)
    buf = string_count_pair.0
    pos = string_count_pair.1

    // Write string table
    var j: i64 = 0
    while j < module.string_count {
        let name_pair = write_name(buf, pos, module.string_table[j])
        buf = name_pair.0
        pos = name_pair.1
        j = j + 1
    }

    (buf, pos)
}

fn deserialize_ir_module(buf: [i8; 131072], len: i64) -> IrModule with Mut, Panic, Div {
    var pos: i64 = 0

    // Verify header magic - cast literals to i8 for comparison
    let b0: i8 = 83 as i8
    let b1: i8 = 79 as i8
    let b2: i8 = 73 as i8
    let b3: i8 = 82 as i8
    let magic_ok = buf[0] == b0 && buf[1] == b1 && buf[2] == b2 && buf[3] == b3
    if !magic_ok {
        // Return empty module on invalid magic
        return ir_empty_module()
    }

    // Verify version
    if buf[4] != SOIR_VERSION {
        return ir_empty_module()
    }

    pos = 8  // Skip header

    // Read function count
    let fn_count_pair = read_i64(buf, pos)
    let fn_count = fn_count_pair.0
    pos = fn_count_pair.1

    // Read functions
    var functions: [IrFunction; 1024] = [ir_empty_function(); 1024]
    var i: i64 = 0
    while i < fn_count {
        let func_pair = deserialize_ir_function(buf, pos)
        functions[i] = func_pair.0
        pos = func_pair.1
        i = i + 1
    }

    // Read string count
    let string_count_pair = read_i64(buf, pos)
    let string_count = string_count_pair.0
    pos = string_count_pair.1

    // Read string table
    var string_table: [Name; 4096] = [ir_empty_name(); 4096]
    var j: i64 = 0
    while j < string_count {
        let name_pair = read_name(buf, pos)
        string_table[j] = name_pair.0
        pos = name_pair.1
        j = j + 1
    }

    IrModule {
        functions: functions,
        fn_count: fn_count,
        string_table: string_table,
        string_count: string_count,
    }
}

// ============================================================
// Hyper type serialization (SOIR v1.1 extension)
// ============================================================
//
// TypeKind tags for serialization:
//   0-21: existing types (TyI64..TyKnowledge)
//   22: TyHyper — followed by algebra_kind (i64), clifford_p (i64), clifford_q (i64)
//
// Format: [kind: i8] [algebra_kind: i64] [clifford_p: i64] [clifford_q: i64] [inner: TypeTag]

let SOIR_TYPE_HYPER: i8 = 22

fn write_type_tag(buf: [i8; 131072], pos: i64, ty: TypeEntry) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos

    if ty.kind == TypeKind::TyI64 {
        let pair = write_i8(b, p, 0)
        return pair
    }
    if ty.kind == TypeKind::TyF64 {
        let pair = write_i8(b, p, 1)
        return pair
    }
    if ty.kind == TypeKind::TyBool {
        let pair = write_i8(b, p, 2)
        return pair
    }
    if ty.kind == TypeKind::TyHyper {
        let tag_pair = write_i8(b, p, SOIR_TYPE_HYPER)
        b = tag_pair.0
        p = tag_pair.1
        let alg_pair = write_i64(b, p, ty.algebra_kind)
        b = alg_pair.0
        p = alg_pair.1
        let cp_pair = write_i64(b, p, ty.clifford_p)
        b = cp_pair.0
        p = cp_pair.1
        let cq_pair = write_i64(b, p, ty.clifford_q)
        return cq_pair
    }
    // Default: write kind ordinal
    let kind_tag: i8 = 0  // fallback
    write_i8(b, p, kind_tag)
}

fn read_type_tag(buf: [i8; 131072], pos: i64) -> (TypeEntry, i64) with Mut, Panic, Div, Alloc {
    let tag_pair = read_i8(buf, pos)
    let tag = tag_pair.0
    var p = tag_pair.1

    if tag == 0 { return (ty_i64(), p) }
    if tag == 1 { return (ty_f64(), p) }
    if tag == 2 { return (ty_bool(), p) }

    if tag == SOIR_TYPE_HYPER {
        let alg_pair = read_i64(buf, p)
        let alg = alg_pair.0
        p = alg_pair.1
        let cp_pair = read_i64(buf, p)
        let cl_p = cp_pair.0
        p = cp_pair.1
        let cq_pair = read_i64(buf, p)
        let cl_q = cq_pair.0
        p = cq_pair.1
        // Construct Hyper type with inner = f64 (default for hypercomplex)
        if alg == 5 {
            return (ty_clifford(cl_p, cl_q, ty_f64()), p)
        }
        return (ty_hyper(alg, ty_f64()), p)
    }

    // Unknown tag: return error type
    (ty_error(), p)
}
