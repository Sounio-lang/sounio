    var b = dce2_block_new(0)
    b.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b.count = 1
    cfg.blocks[0] = b
    cfg.count = 1
    cfg.entry = 0
    dce_mark_reachable(&! cfg, 0)
    cfg.blocks[0].reachable
}

// T44: Instructions in unreachable block have reachable=false before DCE.
fn test_dce2_unreachable_instr_flag() -> bool with Mut, Panic, Div {
