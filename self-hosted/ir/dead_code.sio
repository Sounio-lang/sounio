// self-hosted::ir::dead_code — Dead Code Elimination IR pass
//
// Removes unreachable instructions and unused definitions from a simplified IR.
//
// This module operates on a self-contained CFG representation using integer
// opcodes (no external enum dependencies).  The algorithm:
//
//   1. Mark reachable blocks (BFS from entry).
//   2. Mark live instructions (mark side-effectful as roots, then trace use-def).
//   3. Eliminate dead instructions (replace with NOP) and unreachable blocks.
//
// All arrays are fixed-size — no heap allocation.
//
// Opcodes (DCE_NOP=0, DCE_MOV=1, DCE_ADD=2, DCE_RET=3,
//          DCE_JUMP=4, DCE_BRANCH=5, DCE_CALL=6,
//          DCE_SUB=7, DCE_MUL=8, DCE_LOAD=9, DCE_STORE=10, DCE_PHI=11)
//
// References:
//   Cytron et al. (1991): Efficiently Computing SSA Form
//   Cooper & Torczon (2011): Engineering a Compiler, Ch. 10

// ============================================================================
// Section 1: Constants
// ============================================================================

let DCE2_MAX_INSTRS: i64  = 128
let DCE2_MAX_BLOCKS: i64  = 64
let DCE2_MAX_REGS: i64    = 256
let DCE2_MAX_SUCCS: i64   = 4
let DCE2_MAX_PREDS: i64   = 4
let DCE2_INVALID: i64     = 0 - 1

// Opcodes
let DCE2_NOP: i64    = 0
let DCE2_MOV: i64    = 1
let DCE2_ADD: i64    = 2
let DCE2_RET: i64    = 3
let DCE2_JUMP: i64   = 4
let DCE2_BRANCH: i64 = 5
let DCE2_CALL: i64   = 6
let DCE2_SUB: i64    = 7
let DCE2_MUL: i64    = 8
let DCE2_LOAD: i64   = 9
let DCE2_STORE: i64  = 10
let DCE2_PHI: i64    = 11

// ============================================================================
// Section 2: Data Structures
// ============================================================================

// A single IR instruction in the DCE analysis.
struct DceInstr {
    opcode: i64,
    dst: i64,      // destination virtual register (-1 = none)
    src1: i64,     // source 1 virtual register (-1 = none)
    src2: i64,     // source 2 virtual register (-1 = none)
    used: bool,    // is result used somewhere?
    reachable: bool, // instruction is in a reachable block?
}

// A basic block containing up to DCE2_MAX_INSTRS instructions.
struct DceBlock {
    id: i64,
    instrs: [DceInstr; 128],
    count: i64,
    reachable: bool,
    succs: [i64; 4],
    succ_count: i64,
    preds: [i64; 4],
    pred_count: i64,
}

// The control-flow graph.
struct DceCfg {
    blocks: [DceBlock; 64],
    count: i64,
    entry: i64,   // index of entry block
}

// Result summary of one DCE pass.
struct DceResult {
    removed_instrs: i64,
    removed_blocks: i64,
    total_instrs: i64,
    total_blocks: i64,
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn dce2_instr_new(opcode: i64, dst: i64, src1: i64, src2: i64) -> DceInstr {
    DceInstr {
        opcode: opcode,
        dst: dst,
        src1: src1,
        src2: src2,
        used: false,
        reachable: false,
    }
}

fn dce2_instr_nop() -> DceInstr {
    dce2_instr_new(DCE2_NOP, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
}

fn dce2_block_new(id: i64) -> DceBlock {
    DceBlock {
        id: id,
        instrs: [dce2_instr_nop(); 128],
        count: 0,
        reachable: false,
        succs: [DCE2_INVALID, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID],
        succ_count: 0,
        preds: [DCE2_INVALID, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID],
        pred_count: 0,
    }
}

fn dce2_cfg_new() -> DceCfg {
    DceCfg {
        blocks: [dce2_block_new(DCE2_INVALID); 64],
        count: 0,
        entry: 0,
    }
}

fn dce2_result_new() -> DceResult {
    DceResult {
        removed_instrs: 0,
        removed_blocks: 0,
        total_instrs: 0,
        total_blocks: 0,
    }
}

// ============================================================================
// Section 4: CFG Building
// ============================================================================

// Add a new block to the CFG.  Returns the block's index.
fn dce_add_block(cfg: &! DceCfg, b: DceBlock) -> i64 with Mut, Panic {
    if cfg.count >= DCE2_MAX_BLOCKS { return DCE2_INVALID }
    let idx = cfg.count
    cfg.blocks[idx as usize] = b
    cfg.count = cfg.count + 1
    idx
}

// Add an instruction to block block_id.
fn dce_add_instr(cfg: &! DceCfg, block_id: i64, op: i64, dst: i64, src1: i64, src2: i64) with Mut, Panic {
    if block_id < 0 { return }
    if block_id >= cfg.count { return }
    let bref = &! cfg.blocks[block_id as usize]
    if bref.count >= DCE2_MAX_INSTRS { return }
    let idx = bref.count
    bref.instrs[idx as usize] = dce2_instr_new(op, dst, src1, src2)
    bref.count = bref.count + 1
}

// Add a successor edge block_id -> succ_id.
fn dce_add_succ(cfg: &! DceCfg, block_id: i64, succ_id: i64) with Mut, Panic {
    if block_id < 0 { return }
    if block_id >= cfg.count { return }
    let bref = &! cfg.blocks[block_id as usize]
    if bref.succ_count >= DCE2_MAX_SUCCS { return }
    let i = bref.succ_count
    bref.succs[i as usize] = succ_id
    bref.succ_count = bref.succ_count + 1
    // Also add reverse pred edge.
    if succ_id >= 0 {
        if succ_id < cfg.count {
            let sref = &! cfg.blocks[succ_id as usize]
            if sref.pred_count < DCE2_MAX_PREDS {
                let j = sref.pred_count
                sref.preds[j as usize] = block_id
                sref.pred_count = sref.pred_count + 1
            }
        }
    }
}

// ============================================================================
// Section 5: Opcode Classification
// ============================================================================

// Returns true if the opcode has observable side effects.
fn dce2_has_side_effect(op: i64) -> bool {
    if op == DCE2_RET    { return true }
    if op == DCE2_JUMP   { return true }
    if op == DCE2_BRANCH { return true }
    if op == DCE2_CALL   { return true }
    if op == DCE2_STORE  { return true }
    false
}

// Returns true if the opcode is a terminator (ends a basic block).
fn dce2_is_terminator(op: i64) -> bool {
    if op == DCE2_RET    { return true }
    if op == DCE2_JUMP   { return true }
    if op == DCE2_BRANCH { return true }
    false
}

// Returns true if the opcode produces a value.
fn dce2_has_dst(op: i64) -> bool {
    if op == DCE2_NOP    { return false }
    if op == DCE2_RET    { return false }
    if op == DCE2_JUMP   { return false }
    if op == DCE2_BRANCH { return false }
    if op == DCE2_STORE  { return false }
    if op == DCE2_CALL   { return false }
    true
}

// ============================================================================
// Section 6: Reachability Analysis
// ============================================================================

// BFS from the entry block to mark all reachable blocks.
// Uses a flat worklist array (no dynamic allocation).
fn dce_mark_reachable(cfg: &! DceCfg, start: i64) with Mut, Panic, Div {
    if start < 0 { return }
    if start >= cfg.count { return }
    // Worklist: flat array + head/tail for BFS.
    var worklist: [i64; 64] = [DCE2_INVALID; 64]
    var whead: i64 = 0
    var wtail: i64 = 0
    // Seed with start block.
    worklist[wtail as usize] = start
    wtail = wtail + 1
    cfg.blocks[start as usize].reachable = true
    while whead < wtail {
        let bid = worklist[whead as usize]
        whead = whead + 1
        let b = &cfg.blocks[bid as usize]
        var s: i64 = 0
        while s < b.succ_count {
            let sid = b.succs[s as usize]
            if sid >= 0 {
                if sid < cfg.count {
                    if cfg.blocks[sid as usize].reachable == false {
                        cfg.blocks[sid as usize].reachable = true
                        if wtail < 64 {
                            worklist[wtail as usize] = sid
                            wtail = wtail + 1
                        }
                    }
                }
            }
            s = s + 1
        }
    }
    // Propagate reachability to instructions in reachable blocks.
    var bi: i64 = 0
    while bi < cfg.count {
        if cfg.blocks[bi as usize].reachable {
            var ii: i64 = 0
            while ii < cfg.blocks[bi as usize].count {
                cfg.blocks[bi as usize].instrs[ii as usize].reachable = true
                ii = ii + 1
            }
        }
        bi = bi + 1
    }
}

// ============================================================================
// Section 7: Live Definition Analysis
// ============================================================================

// Use-def map: for each virtual register (dst), the (block_id, instr_idx) pair.
// Stored as flat arrays indexed by reg number.
struct DceUseDef {
    def_block: [i64; 256],
    def_instr: [i64; 256],
    valid: [bool; 256],
}

fn dce2_use_def_new() -> DceUseDef {
    DceUseDef {
        def_block: [DCE2_INVALID; 256],
        def_instr: [DCE2_INVALID; 256],
        valid: [false; 256],
    }
}

// Build use-def chains by scanning all instructions in all reachable blocks.
fn dce2_build_use_def(cfg: &DceCfg, ud: &! DceUseDef) with Mut, Panic, Div {
    var bi: i64 = 0
    while bi < cfg.count {
        let b = &cfg.blocks[bi as usize]
        if b.reachable {
            var ii: i64 = 0
            while ii < b.count {
                let instr = &b.instrs[ii as usize]
                let dst = instr.dst
                if dst >= 0 {
                    if dst < DCE2_MAX_REGS {
                        ud.def_block[dst as usize] = bi
                        ud.def_instr[dst as usize] = ii
                        ud.valid[dst as usize] = true
                    }
                }
                ii = ii + 1
            }
        }
        bi = bi + 1
    }
}

// Mark a register's defining instruction as used (and recursively mark its sources).
// Depth-limited to avoid infinite recursion.
fn dce2_mark_reg_used(cfg: &! DceCfg, ud: &DceUseDef, reg: i64, depth: i64) with Mut, Panic {
    if depth <= 0 { return }
    if reg < 0 { return }
    if reg >= DCE2_MAX_REGS { return }
    if ud.valid[reg as usize] == false { return }
    let bi = ud.def_block[reg as usize]
    let ii = ud.def_instr[reg as usize]
    if bi < 0 { return }
    if ii < 0 { return }
    let instr = &! cfg.blocks[bi as usize].instrs[ii as usize]
    if instr.used { return } // already marked
    instr.used = true
    // Trace sources.
    let s1 = instr.src1
    let s2 = instr.src2
    dce2_mark_reg_used(cfg, ud, s1, depth - 1)
    dce2_mark_reg_used(cfg, ud, s2, depth - 1)
}

// Mark all live definitions by seeding from side-effectful instructions.
fn dce_mark_live_defs(cfg: &! DceCfg) with Mut, Panic, Div {
    var ud = dce2_use_def_new()
    dce2_build_use_def(cfg, &! ud)
    // Seed: mark all instructions with side effects as used.
    var bi: i64 = 0
    while bi < cfg.count {
        let b = &! cfg.blocks[bi as usize]
        if b.reachable {
            var ii: i64 = 0
            while ii < b.count {
                let instr = &! b.instrs[ii as usize]
                if dce2_has_side_effect(instr.opcode) {
                    instr.used = true
                    // Trace sources.
                    dce2_mark_reg_used(cfg, &ud, instr.src1, 64)
                    dce2_mark_reg_used(cfg, &ud, instr.src2, 64)
                }
                ii = ii + 1
            }
        }
        bi = bi + 1
    }
}

// ============================================================================
// Section 8: Elimination
// ============================================================================

// Replace dead instructions with NOP, count eliminated and removed blocks.
fn dce_eliminate(cfg: &! DceCfg) -> DceResult with Mut, Panic, Div {
    var result = dce2_result_new()
    result.total_blocks = cfg.count
    var bi: i64 = 0
    while bi < cfg.count {
        let b = &! cfg.blocks[bi as usize]
        if b.reachable == false {
            result.removed_blocks = result.removed_blocks + 1
        }
        var ii: i64 = 0
        while ii < b.count {
            result.total_instrs = result.total_instrs + 1
            let instr = &! b.instrs[ii as usize]
            if b.reachable {
                // In reachable block: eliminate unused non-side-effect instrs.
                if instr.used == false {
                    if dce2_has_side_effect(instr.opcode) == false {
                        instr.opcode = DCE2_NOP
                        instr.dst = DCE2_INVALID
                        instr.src1 = DCE2_INVALID
                        instr.src2 = DCE2_INVALID
                        result.removed_instrs = result.removed_instrs + 1
                    }
                }
            } else {
                // Unreachable block: NOP everything.
                instr.opcode = DCE2_NOP
                instr.dst = DCE2_INVALID
                instr.src1 = DCE2_INVALID
                instr.src2 = DCE2_INVALID
                result.removed_instrs = result.removed_instrs + 1
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    result
}

// ============================================================================
// Section 9: Full Pass
// ============================================================================

// Run the complete DCE pass: mark reachable, mark live, eliminate.
fn dce_run(cfg: &! DceCfg) -> DceResult with Mut, Panic, Div {
    dce_mark_reachable(cfg, cfg.entry)
    dce_mark_live_defs(cfg)
    dce_eliminate(cfg)
}

// ============================================================================
// Section 10: Query Helpers
// ============================================================================

// Count NOP instructions in block b_id.
fn dce2_count_nops_in_block(cfg: &DceCfg, b_id: i64) -> i64 {
    if b_id < 0 { return 0 }
    if b_id >= cfg.count { return 0 }
    var count: i64 = 0
    let b = &cfg.blocks[b_id as usize]
    var i: i64 = 0
    while i < b.count {
        if b.instrs[i as usize].opcode == DCE2_NOP {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count non-NOP instructions in block b_id.
fn dce2_count_live_in_block(cfg: &DceCfg, b_id: i64) -> i64 {
    if b_id < 0 { return 0 }
    if b_id >= cfg.count { return 0 }
    var count: i64 = 0
    let b = &cfg.blocks[b_id as usize]
    var i: i64 = 0
    while i < b.count {
        if b.instrs[i as usize].opcode != DCE2_NOP {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check if instruction at (b_id, i_id) is a NOP.
fn dce2_is_nop(cfg: &DceCfg, b_id: i64, i_id: i64) -> bool {
    if b_id < 0 { return false }
    if b_id >= cfg.count { return false }
    let b = &cfg.blocks[b_id as usize]
    if i_id < 0 { return false }
    if i_id >= b.count { return false }
    b.instrs[i_id as usize].opcode == DCE2_NOP
}

// Check if instruction at (b_id, i_id) is NOT a NOP.
fn dce2_not_nop(cfg: &DceCfg, b_id: i64, i_id: i64) -> bool {
    dce2_is_nop(cfg, b_id, i_id) == false
}

// Get opcode at (b_id, i_id).
fn dce2_get_opcode(cfg: &DceCfg, b_id: i64, i_id: i64) -> i64 {
    if b_id < 0 { return DCE2_NOP }
    if b_id >= cfg.count { return DCE2_NOP }
    let b = &cfg.blocks[b_id as usize]
    if i_id < 0 { return DCE2_NOP }
    if i_id >= b.count { return DCE2_NOP }
    b.instrs[i_id as usize].opcode
}

// Count total instructions across all blocks.
fn dce2_total_instrs(cfg: &DceCfg) -> i64 {
    var total: i64 = 0
    var bi: i64 = 0
    while bi < cfg.count {
        total = total + cfg.blocks[bi as usize].count
        bi = bi + 1
    }
    total
}

// Count total NOPs across all blocks.
fn dce2_total_nops(cfg: &DceCfg) -> i64 {
    var total: i64 = 0
    var bi: i64 = 0
    while bi < cfg.count {
        var ii: i64 = 0
        while ii < cfg.blocks[bi as usize].count {
            if cfg.blocks[bi as usize].instrs[ii as usize].opcode == DCE2_NOP {
                total = total + 1
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    total
}

// ============================================================================
// Section 11: Test Helpers
// ============================================================================

// Build a simple linear CFG: entry -> one block with given instructions -> done.
fn dce2_make_linear(ops: [i64; 8], dsts: [i64; 8], srcs1: [i64; 8], srcs2: [i64; 8], n: i64) -> DceCfg with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b = dce2_block_new(0)
    b.id = 0
    var i: i64 = 0
    while i < n {
        if b.count < DCE2_MAX_INSTRS {
            let idx = b.count
            b.instrs[idx as usize] = dce2_instr_new(ops[i as usize], dsts[i as usize], srcs1[i as usize], srcs2[i as usize])
            b.count = b.count + 1
        }
        i = i + 1
    }
    cfg.blocks[0] = b
    cfg.count = 1
    cfg.entry = 0
    cfg
}

// Build a two-block CFG: entry block + unreachable block (no edge).
fn dce2_make_with_dead_block() -> DceCfg with Mut, Panic {
    var cfg = dce2_cfg_new()
    // Block 0: entry, has a RET.
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, 1, DCE2_INVALID)
    b0.count = 1
    cfg.blocks[0] = b0
    // Block 1: unreachable, has an ADD.
    var b1 = dce2_block_new(1)
    b1.instrs[0] = dce2_instr_new(DCE2_ADD, 5, 1, 2)
    b1.count = 1
    cfg.blocks[1] = b1
    cfg.count = 2
    cfg.entry = 0
    cfg
}

// Build a two-block CFG where block 0 jumps to block 1.
fn dce2_make_two_blocks_linked() -> DceCfg with Mut, Panic {
    var cfg = dce2_cfg_new()
    // Block 0: loads reg 0 = 5 (dead), then jumps to 1.
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_MOV, 0, DCE2_INVALID, DCE2_INVALID)
    b0.instrs[1] = dce2_instr_new(DCE2_JUMP, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 2
    b0.succs[0] = 1
    b0.succ_count = 1
    cfg.blocks[0] = b0
    // Block 1: returns reg 0.
    var b1 = dce2_block_new(1)
    b1.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, 0, DCE2_INVALID)
    b1.count = 1
    b1.preds[0] = 0
    b1.pred_count = 1
    cfg.blocks[1] = b1
    cfg.count = 2
    cfg.entry = 0
    cfg
}

// ============================================================================
// Section 12: Tests
// ============================================================================

// T01: New CFG has zero blocks.
fn test_dce2_cfg_new() -> bool {
    let cfg = dce2_cfg_new()
    cfg.count == 0
}

// T02: dce_add_block increments count.
fn test_dce2_add_block() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    let b = dce2_block_new(0)
    dce_add_block(&! cfg, b)
    cfg.count == 1
}

// T03: dce_add_instr adds instruction to block.
fn test_dce2_add_instr() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    let b = dce2_block_new(0)
    dce_add_block(&! cfg, b)
    dce_add_instr(&! cfg, 0, DCE2_ADD, 2, 0, 1)
    cfg.blocks[0].count == 1
}

// T04: Added instr has correct opcode.
fn test_dce2_instr_opcode() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    let b = dce2_block_new(0)
    dce_add_block(&! cfg, b)
    dce_add_instr(&! cfg, 0, DCE2_ADD, 2, 0, 1)
    cfg.blocks[0].instrs[0].opcode == DCE2_ADD
}

// T05: Single block with RET is reachable.
fn test_dce2_mark_reachable_entry() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b = dce2_block_new(0)
    b.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b.count = 1
    cfg.blocks[0] = b
    cfg.count = 1
    cfg.entry = 0
    dce_mark_reachable(&! cfg, 0)
    cfg.blocks[0].reachable
}

// T06: Unreachable block stays unreachable.
fn test_dce2_unreachable_block() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_with_dead_block()
    dce_mark_reachable(&! cfg, 0)
    cfg.blocks[1].reachable == false
}

// T07: Block linked to entry is reachable.
fn test_dce2_linked_block_reachable() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_two_blocks_linked()
    dce_mark_reachable(&! cfg, 0)
    cfg.blocks[1].reachable
}

// T08: Dead instruction in reachable block becomes NOP after eliminate.
fn test_dce2_dead_instr_becomes_nop() -> bool with Mut, Panic, Div {
    var ops: [i64; 8] = [DCE2_MOV, DCE2_RET, 0, 0, 0, 0, 0, 0]
    var dsts: [i64; 8] = [0, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s1: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s2: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var cfg = dce2_make_linear(ops, dsts, s1, s2, 2)
    dce_run(&! cfg)
    // reg 0 is loaded by MOV but never used (RET doesn't use it in this test).
    // MOV should become NOP.
    dce2_is_nop(&cfg, 0, 0)
}

// T09: RET instruction is preserved.
fn test_dce2_ret_preserved() -> bool with Mut, Panic, Div {
    var ops: [i64; 8] = [DCE2_RET, 0, 0, 0, 0, 0, 0, 0]
    var dsts: [i64; 8] = [DCE2_INVALID, 0, 0, 0, 0, 0, 0, 0]
    var s1: [i64; 8] = [DCE2_INVALID, 0, 0, 0, 0, 0, 0, 0]
    var s2: [i64; 8] = [DCE2_INVALID, 0, 0, 0, 0, 0, 0, 0]
    var cfg = dce2_make_linear(ops, dsts, s1, s2, 1)
    dce_run(&! cfg)
    dce2_not_nop(&cfg, 0, 0)
}

// T10: CALL instruction is preserved.
fn test_dce2_call_preserved() -> bool with Mut, Panic, Div {
    var ops: [i64; 8] = [DCE2_CALL, DCE2_RET, 0, 0, 0, 0, 0, 0]
    var dsts: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s1: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s2: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var cfg = dce2_make_linear(ops, dsts, s1, s2, 2)
    dce_run(&! cfg)
    dce2_not_nop(&cfg, 0, 0)
}

// T11: STORE instruction is preserved.
fn test_dce2_store_preserved() -> bool with Mut, Panic, Div {
    var ops: [i64; 8] = [DCE2_STORE, DCE2_RET, 0, 0, 0, 0, 0, 0]
    var dsts: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s1: [i64; 8] = [0, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var s2: [i64; 8] = [DCE2_INVALID, DCE2_INVALID, 0, 0, 0, 0, 0, 0]
    var cfg = dce2_make_linear(ops, dsts, s1, s2, 2)
    dce_run(&! cfg)
    dce2_not_nop(&cfg, 0, 0)
}

// T12: Unreachable block instruction becomes NOP.
fn test_dce2_unreachable_instr_nop() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_with_dead_block()
    dce_run(&! cfg)
    dce2_is_nop(&cfg, 1, 0)
}

// T13: Reachable block instruction is not affected if live.
fn test_dce2_reachable_live_not_nop() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_with_dead_block()
    dce_run(&! cfg)
    dce2_not_nop(&cfg, 0, 0)
}

// T14: dce_run returns correct removed_blocks count.
fn test_dce2_run_removed_blocks() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_with_dead_block()
    let result = dce_run(&! cfg)
    result.removed_blocks == 1
}

// T15: dce_run returns correct removed_instrs for unreachable block.
fn test_dce2_run_removed_instrs() -> bool with Mut, Panic, Div {
    var cfg = dce2_make_with_dead_block()
    let result = dce_run(&! cfg)
    result.removed_instrs >= 1
}

// T16: dce_run removed_instrs does not count live instructions.
fn test_dce2_run_removed_excludes_live() -> bool with Mut, Panic, Div {
    // Single block: just a RET (live, side effect).
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 1
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    let result = dce_run(&! cfg)
    result.removed_instrs == 0
}

// T17: Transitive liveness: ADD result used by RET => ADD not removed.
fn test_dce2_transitive_liveness() -> bool with Mut, Panic, Div {
    // reg2 = ADD reg0, reg1; RET reg2
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_MOV, 0, DCE2_INVALID, DCE2_INVALID) // reg0 = MOV
    b0.instrs[1] = dce2_instr_new(DCE2_MOV, 1, DCE2_INVALID, DCE2_INVALID) // reg1 = MOV
    b0.instrs[2] = dce2_instr_new(DCE2_ADD, 2, 0, 1)                         // reg2 = ADD r0, r1
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, 2, DCE2_INVALID)   // RET r2
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    // ADD should be preserved.
    dce2_not_nop(&cfg, 0, 2)
}

// T18: Dead ADD (result unused) becomes NOP.
fn test_dce2_dead_add_nop() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 2, 0, 1) // dead
    b0.instrs[1] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 2
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    dce2_is_nop(&cfg, 0, 0)
}

