// T56: Two dead chains: both eliminated.
fn test_dce2_two_dead_chains() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    // chain 1: r10 = ADD r0, r1 (dead)
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 10, 0, 1)
    // chain 2: r11 = SUB r0, r1; r12 = MUL r11, r10 (both dead)
    b0.instrs[1] = dce2_instr_new(DCE2_SUB, 11, 0, 1)
    b0.instrs[2] = dce2_instr_new(DCE2_MUL, 12, 11, 10)
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    dce2_is_nop(&cfg, 0, 0) && dce2_is_nop(&cfg, 0, 1) && dce2_is_nop(&cfg, 0, 2)
}

