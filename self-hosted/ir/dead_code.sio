    let b1 = dce2_block_new(1)
    dce_add_block(&! cfg, b0)
    dce_add_block(&! cfg, b1)
    dce_add_succ(&! cfg, 0, 1)
    cfg.blocks[0].succ_count == 1 && cfg.blocks[0].succs[0] == 1
}

