}

// T61: dce_result_new has all zeros.
fn test_dce2_result_new_zeros() -> bool {
    let r = dce2_result_new()
    r.removed_instrs == 0 && r.removed_blocks == 0
}

// T62: dce2_use_def_new has all invalid entries.
fn test_dce2_use_def_new() -> bool {
    let ud = dce2_use_def_new()
    ud.def_block[0] == DCE2_INVALID && ud.valid[0] == false
}

// T63: Block with zero instructions: run produces no change.
fn test_dce2_empty_block_no_change() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.count = 0
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    let result = dce_run(&! cfg)
    result.removed_instrs == 0 && result.removed_blocks == 0
}

// T64: dce2_total_nops after DCE on single dead MOV = 1.
fn test_dce2_total_nops_after_dce() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_MOV, 5, DCE2_INVALID, DCE2_INVALID)
    b0.instrs[1] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 2
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    dce2_total_nops(&cfg) == 1
}

// T65: Long dead chain: all eliminated.
fn test_dce2_long_dead_chain() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    // r1 = ADD r0, r0  (dead)
    // r2 = ADD r1, r1  (dead, uses r1)
    // r3 = ADD r2, r2  (dead, uses r2)
    // RET
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 1, 0, 0)
    b0.instrs[1] = dce2_instr_new(DCE2_ADD, 2, 1, 1)
    b0.instrs[2] = dce2_instr_new(DCE2_ADD, 3, 2, 2)
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    let n0 = dce2_is_nop(&cfg, 0, 0)
    let n1 = dce2_is_nop(&cfg, 0, 1)
    let n2 = dce2_is_nop(&cfg, 0, 2)
    let r = dce2_not_nop(&cfg, 0, 3)
    n0 && n1 && n2 && r
}

// T66: Two blocks: entry reachable, isolated dead block not reachable.
fn test_dce2_isolated_block_unreachable() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 1
    cfg.blocks[0] = b0
    var b1 = dce2_block_new(1)
    b1.instrs[0] = dce2_instr_new(DCE2_MOV, 0, DCE2_INVALID, DCE2_INVALID)
    b1.count = 1
    cfg.blocks[1] = b1
    cfg.count = 2
    cfg.entry = 0
    dce_run(&! cfg)
    cfg.blocks[1].reachable == false && dce2_is_nop(&cfg, 1, 0)
}

// T67: Live computation chain: all preserved.
fn test_dce2_live_chain_preserved() -> bool with Mut, Panic, Div {
    // r2 = ADD r0, r1; r3 = ADD r2, r2; STORE r3; RET
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 2, 0, 1)                         // live
    b0.instrs[1] = dce2_instr_new(DCE2_ADD, 3, 2, 2)                          // live (used by STORE)
    b0.instrs[2] = dce2_instr_new(DCE2_STORE, DCE2_INVALID, 3, DCE2_INVALID)  // side effect
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    dce2_not_nop(&cfg, 0, 0) && dce2_not_nop(&cfg, 0, 1) &&
    dce2_not_nop(&cfg, 0, 2) && dce2_not_nop(&cfg, 0, 3)
}

// T68: dce2_block_new sets reachable=false by default.
fn test_dce2_block_default_unreachable() -> bool {
    let b = dce2_block_new(0)
    b.reachable == false
}

// T69: dce2_instr_new initializes used=false.
fn test_dce2_instr_used_false() -> bool {
    let i = dce2_instr_new(DCE2_ADD, 0, 1, 2)
    i.used == false
}

// T70: dce2_cfg_new sets entry=0.
fn test_dce2_cfg_entry() -> bool {
    let cfg = dce2_cfg_new()
    cfg.entry == 0
}

