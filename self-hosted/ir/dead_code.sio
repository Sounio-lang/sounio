// T28: Multiple dead instructions all become NOP.
fn test_dce2_multiple_dead_nop() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 5, 0, 1)  // dead
    b0.instrs[1] = dce2_instr_new(DCE2_SUB, 6, 0, 1)  // dead
    b0.instrs[2] = dce2_instr_new(DCE2_MUL, 7, 0, 1)  // dead
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    let n0 = dce2_is_nop(&cfg, 0, 0)
    let n1 = dce2_is_nop(&cfg, 0, 1)
    let n2 = dce2_is_nop(&cfg, 0, 2)
    n0 && n1 && n2
}

// T29: Mixed live and dead instructions handled correctly.
fn test_dce2_mixed_live_dead() -> bool with Mut, Panic, Div {
    // reg2 = ADD r0, r1 (live, used by STORE)
    // reg3 = MUL r0, r1 (dead)
    // STORE reg2
    // RET
    var cfg = dce2_cfg_new()
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_ADD, 2, 0, 1)               // live (used by STORE)
    b0.instrs[1] = dce2_instr_new(DCE2_MUL, 3, 0, 1)               // dead
    b0.instrs[2] = dce2_instr_new(DCE2_STORE, DCE2_INVALID, 2, DCE2_INVALID) // live
    b0.instrs[3] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 4
    cfg.blocks[0] = b0
    cfg.count = 1
    cfg.entry = 0
    dce_run(&! cfg)
    let add_live = dce2_not_nop(&cfg, 0, 0)
    let mul_dead = dce2_is_nop(&cfg, 0, 1)
    let store_live = dce2_not_nop(&cfg, 0, 2)
    let ret_live = dce2_not_nop(&cfg, 0, 3)
    add_live && mul_dead && store_live && ret_live
}

