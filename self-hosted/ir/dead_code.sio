}

// T46: Three-block linear chain all reachable.
fn test_dce2_three_block_chain() -> bool with Mut, Panic, Div {
    var cfg = dce2_cfg_new()
    // b0 -> b1 -> b2
    var b0 = dce2_block_new(0)
    b0.instrs[0] = dce2_instr_new(DCE2_JUMP, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b0.count = 1
    b0.succs[0] = 1
    b0.succ_count = 1
    cfg.blocks[0] = b0
    var b1 = dce2_block_new(1)
    b1.instrs[0] = dce2_instr_new(DCE2_JUMP, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b1.count = 1
    b1.succs[0] = 2
    b1.succ_count = 1
    cfg.blocks[1] = b1
    var b2 = dce2_block_new(2)
    b2.instrs[0] = dce2_instr_new(DCE2_RET, DCE2_INVALID, DCE2_INVALID, DCE2_INVALID)
    b2.count = 1
    cfg.blocks[2] = b2
    cfg.count = 3
    cfg.entry = 0
    dce_mark_reachable(&! cfg, 0)
    cfg.blocks[0].reachable && cfg.blocks[1].reachable && cfg.blocks[2].reachable
}

// T47: dce_add_succ sets successor correctly.
