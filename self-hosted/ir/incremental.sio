// T13: Node state transitions.
fn test_inc_state_transitions_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let nid = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let s0 = inc_get_node_state(ctx, 0) == INC_STATE_FRESH

    inc_set_node_state(ctx, 0, INC_STATE_VALID)
    let s1 = inc_get_node_state(ctx, 0) == INC_STATE_VALID

    inc_set_node_state(ctx, 0, INC_STATE_STALE)
    let s2 = inc_get_node_state(ctx, 0) == INC_STATE_STALE

    inc_set_node_state(ctx, 0, INC_STATE_RECOMPILING)
    let s3 = inc_get_node_state(ctx, 0) == INC_STATE_RECOMPILING

    inc_set_node_state(ctx, 0, INC_STATE_ERROR)
    let s4 = inc_get_node_state(ctx, 0) == INC_STATE_ERROR

    s0 && s1 && s2 && s3 && s4
}

fn test_inc_state_transitions() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_state_transitions_inner(&! ctx)
}

