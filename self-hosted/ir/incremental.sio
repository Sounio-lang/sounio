    if test_inc_fp_from_bytes() { passed = passed + 1; print("  T09 OK fp_from_bytes\n") } else { print("  FAIL: T09 fp_from_bytes\n") }
    if test_inc_fp_from_bytes_diff() { passed = passed + 1; print("  T10 OK fp_from_bytes_diff\n") } else { print("  FAIL: T10 fp_from_bytes_diff\n") }

    // Node management tests (T11-T18)
    if test_inc_add_node() { passed = passed + 1; print("  T11 OK add_node\n") } else { print("  FAIL: T11 add_node\n") }
    if test_inc_add_multiple_nodes() { passed = passed + 1; print("  T12 OK add_multiple_nodes\n") } else { print("  FAIL: T12 add_multiple_nodes\n") }
