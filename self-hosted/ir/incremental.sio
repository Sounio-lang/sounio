    if test_inc_dep_depth_chain() { supp_passed = supp_passed + 1; print("  S04 OK dep_depth_chain\n") } else { print("  FAIL: S04 dep_depth_chain\n") }
    if test_inc_no_cycle_chain() { supp_passed = supp_passed + 1; print("  S05 OK no_cycle_chain\n") } else { print("  FAIL: S05 no_cycle_chain\n") }
    if test_inc_has_cycle() { supp_passed = supp_passed + 1; print("  S06 OK has_cycle\n") } else { print("  FAIL: S06 has_cycle\n") }
    if test_inc_reset() { supp_passed = supp_passed + 1; print("  S07 OK reset\n") } else { print("  FAIL: S07 reset\n") }
    if test_inc_context_new() { supp_passed = supp_passed + 1; print("  S08 OK context_new\n") } else { print("  FAIL: S08 context_new\n") }

    print("\nSupplementary: ")
    print_int(supp_passed)
    print(" / ")
    print_int(supp_total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
