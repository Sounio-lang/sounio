// T21: Count forward dependencies.
fn test_inc_dependencies_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_diamond(ctx)
    // Diamond: 0->1, 0->2, 1->3, 2->3
    let d0 = inc_dependencies(ctx, 0)   // 0 depends on 1 and 2
    let d1 = inc_dependencies(ctx, 1)   // 1 depends on 3
    let d3 = inc_dependencies(ctx, 3)   // 3 depends on nothing
    d0 == 2 && d1 == 1 && d3 == 0
}

fn test_inc_dependencies() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_dependencies_inner(&! ctx)
}

// T22: Count reverse dependencies (dependents).
fn test_inc_dependents_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_diamond(ctx)
    // Diamond: 0->1, 0->2, 1->3, 2->3
    let d0 = inc_dependents(ctx, 0)  // nothing depends on 0
    let d1 = inc_dependents(ctx, 1)  // 0 depends on 1
    let d3 = inc_dependents(ctx, 3)  // 1 and 2 depend on 3
    d0 == 0 && d1 == 1 && d3 == 2
}

fn test_inc_dependents() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_dependents_inner(&! ctx)
}

// T23: Get dependency list via buffer.
fn test_inc_get_dependencies_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 4)
    // Chain: 0->1, 1->2, 2->3
    var buf: [i64; 512] = [0; 512]
    let count = inc_get_dependencies(ctx, 1, &! buf)
    // Node 1 depends on node 2
    count == 1 && buf[0] == 2
}

fn test_inc_get_dependencies() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_get_dependencies_inner(&! ctx)
}

// T24: Get dependents list via buffer.
fn test_inc_get_dependents_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 4)
    // Chain: 0->1, 1->2, 2->3
    var buf: [i64; 512] = [0; 512]
    let count = inc_get_dependents(ctx, 2, &! buf)
    // Node 1 depends on node 2, so node 1 is a dependent of node 2
    count == 1 && buf[0] == 1
}

fn test_inc_get_dependents() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_get_dependents_inner(&! ctx)
}

// T25: Multiple edges and has_edge checks.
