// T36: Detect changes is idempotent — running twice gives same result.
fn test_inc_detect_idempotent_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 4)
    inc_set_all_unchanged(ctx)
    inc_modify_node(ctx, 2)

    inc_detect_changes(ctx)
    let stale1 = ctx.stale_count

    // Reset states but keep fingerprints
    inc_reset_states(ctx)
    inc_detect_changes(ctx)
    let stale2 = ctx.stale_count

    stale1 == stale2
}

fn test_inc_detect_idempotent() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_detect_idempotent_inner(&! ctx)
}

// ============================================================================
// Section 22: Tests — Transitive invalidation (T37-T46)
// ============================================================================

// T37: Chain — modifying leaf propagates to root.
fn test_inc_invalidate_chain_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Chain: 0->1->2->3.  0 depends on 1, 1 on 2, 2 on 3.
    inc_make_chain(ctx, 4)
    inc_set_all_unchanged(ctx)
    // Modify node 3 (the leaf that everything depends on)
    inc_modify_node(ctx, 3)
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)

    // All nodes should be stale because they all transitively depend on node 3
    let s0 = inc_node_is_stale(ctx, 0)
    let s1 = inc_node_is_stale(ctx, 1)
    let s2 = inc_node_is_stale(ctx, 2)
    let s3 = inc_node_is_stale(ctx, 3)
    s0 && s1 && s2 && s3
}

fn test_inc_invalidate_chain() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_invalidate_chain_inner(&! ctx)
}

// T38: Chain — modifying root does not propagate to leaves.
fn test_inc_invalidate_chain_root_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Chain: 0->1->2->3
    inc_make_chain(ctx, 4)
    inc_set_all_unchanged(ctx)
    // Modify node 0 (the root — depends on others, nothing depends on it)
    inc_modify_node(ctx, 0)
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)

    // Only node 0 should be stale — nothing depends on 0
    let s0 = inc_node_is_stale(ctx, 0)
    let s1 = inc_node_is_stale(ctx, 1) == false
    let s2 = inc_node_is_stale(ctx, 2) == false
    let s3 = inc_node_is_stale(ctx, 3) == false
    s0 && s1 && s2 && s3
}

