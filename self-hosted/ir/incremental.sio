// T59: Cache clear invalidates all entries.
fn test_inc_cache_clear_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let n1 = inc_add_node(ctx, INC_NODE_FUNCTION, 2)

    inc_set_fingerprint(ctx, 0, inc_fingerprint_from_i64(10))
    inc_set_fingerprint(ctx, 1, inc_fingerprint_from_i64(20))
    inc_cache_insert(ctx, 0, 111)
    inc_cache_insert(ctx, 1, 222)

    let before = inc_cache_valid_count(ctx) == 2
    inc_cache_clear(ctx)
    let after = inc_cache_valid_count(ctx) == 0

    before && after
}

fn test_inc_cache_clear() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_cache_clear_inner(&! ctx)
}

