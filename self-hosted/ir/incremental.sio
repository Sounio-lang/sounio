    var supp_passed: i64 = 0
    let supp_total: i64 = 8

    if test_inc_worklist_basic() { supp_passed = supp_passed + 1; print("  S01 OK worklist_basic\n") } else { print("  FAIL: S01 worklist_basic\n") }
    if test_inc_worklist_fifo() { supp_passed = supp_passed + 1; print("  S02 OK worklist_fifo\n") } else { print("  FAIL: S02 worklist_fifo\n") }
