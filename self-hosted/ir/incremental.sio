// self-hosted::ir::incremental — Incremental compilation infrastructure
//
// Implements dependency fingerprinting, change detection, and selective
// recompilation for the Sounio self-hosted compiler.  The core idea:
//
//   1. Every compilation artifact (function, type, module, constant, import,
//      global) is represented as a dependency node with a 128-bit fingerprint
//      derived from its source content.
//   2. Dependency edges record which nodes depend on which others.
//   3. On re-compilation, current fingerprints are compared against cached
//      (previous-build) fingerprints to detect changes.
//   4. Changed nodes are marked stale, and staleness propagates transitively
//      via BFS along reverse dependency edges.
//   5. Only stale nodes are recompiled, and their results cached for the
//      next incremental round.
//
// Fingerprinting uses a 128-bit FNV-1a variant split across two i64 halves
// (hash_lo and hash_hi).  This gives excellent collision resistance without
// requiring big-integer arithmetic.
//
// Algorithms implemented:
//   1. FNV-1a fingerprinting (128-bit, two-lane)
//   2. Change detection via fingerprint comparison
//   3. BFS transitive invalidation
//   4. Topological sort (Kahn's algorithm) for recompilation ordering
//   5. Result caching with fingerprint-keyed lookup
//   6. Worklist-based selective recompilation scheduling
//   7. Dependency graph construction from adjacency matrix
//
// All arrays are fixed-size — no heap allocation.
//
// References:
//   Salsa (Rust incremental framework): "Demand-driven incremental computation"
//   rustc query system: "Incremental compilation via red-green trees"
//   Shake build system: "Build systems a la carte" (Mokhov et al., 2018)

// ============================================================================
// Section 1: Constants
// ============================================================================

let INC_MAX_NODES: i64 = 2048
let INC_MAX_EDGES: i64 = 8192
let INC_MAX_CACHE: i64 = 1024
let INC_MAX_STALE: i64 = 512

// FNV-1a parameters
// FNV offset basis: 14695981039346656037 as u64 = -3750763034362895579 as i64
fn INC_FNV_OFFSET() -> i64 { 0 - 3750763034362895579 }
fn INC_FNV_PRIME() -> i64 { 1099511628211 }

// Sentinel for "no node"
let INC_INVALID: i64 = 0 - 1

// Node kind constants (integer tags, not enums — avoids forward-ref issues)
let INC_NODE_FUNCTION: i64 = 1
let INC_NODE_TYPE: i64 = 2
let INC_NODE_MODULE: i64 = 3
let INC_NODE_CONSTANT: i64 = 4
let INC_NODE_IMPORT: i64 = 5
let INC_NODE_GLOBAL: i64 = 6

// Node state constants
let INC_STATE_FRESH: i64 = 0
let INC_STATE_VALID: i64 = 1
let INC_STATE_STALE: i64 = 2
let INC_STATE_RECOMPILING: i64 = 3
let INC_STATE_ERROR: i64 = 4

// Change kind constants
let INC_CHANGE_NONE: i64 = 0
let INC_CHANGE_MODIFIED: i64 = 1
let INC_CHANGE_ADDED: i64 = 2
let INC_CHANGE_REMOVED: i64 = 3

// ============================================================================
// Section 2: Structs
// ============================================================================

// 128-bit fingerprint stored as two i64 halves.
struct IncFingerprint {
    hash_lo: i64,
    hash_hi: i64,
}

// A single dependency node in the incremental compilation graph.
struct IncDepNode {
    id: i64,
    kind: i64,
    state: i64,
    name_hash: i64,
    fingerprint: IncFingerprint,
    cached_fingerprint: IncFingerprint,
    change: i64,
    edge_start: i64,
    edge_count: i64,
}

// A directed dependency edge: from_node depends on to_node.
struct IncEdge {
    from_node: i64,
    to_node: i64,
}

// A cache entry mapping a node's fingerprint to its compilation result hash.
struct IncCacheEntry {
    node_id: i64,
    fingerprint: IncFingerprint,
    result_hash: i64,
    valid: bool,
}

// The flat-arena incremental compilation context.
struct IncContext {
    nodes: [IncDepNode; 2048],
    node_count: i64,
    edges: [IncEdge; 8192],
    edge_count: i64,
    cache: [IncCacheEntry; 1024],
    cache_count: i64,
    stale_list: [i64; 512],
    stale_count: i64,
    worklist: [i64; 512],
    wl_head: i64,
    wl_tail: i64,
    recompile_count: i64,
    total_nodes_checked: i64,
}

// ============================================================================
// Section 3: Default constructors (helpers must precede callers)
// ============================================================================

fn inc_fingerprint_zero() -> IncFingerprint {
    IncFingerprint {
        hash_lo: 0,
        hash_hi: 0,
    }
}

fn inc_default_node() -> IncDepNode {
    IncDepNode {
        id: 0 - 1,
        kind: 0,
        state: INC_STATE_FRESH,
        name_hash: 0,
        fingerprint: inc_fingerprint_zero(),
        cached_fingerprint: inc_fingerprint_zero(),
        change: INC_CHANGE_NONE,
        edge_start: 0,
        edge_count: 0,
    }
}

fn inc_default_edge() -> IncEdge {
    IncEdge {
        from_node: 0 - 1,
        to_node: 0 - 1,
    }
}

fn inc_default_cache_entry() -> IncCacheEntry {
    IncCacheEntry {
        node_id: 0 - 1,
        fingerprint: inc_fingerprint_zero(),
        result_hash: 0,
        valid: false,
    }
}

fn inc_context_new() -> IncContext {
    IncContext {
        nodes: [inc_default_node(); 2048],
        node_count: 0,
        edges: [inc_default_edge(); 8192],
        edge_count: 0,
        cache: [inc_default_cache_entry(); 1024],
        cache_count: 0,
        stale_list: [0; 512],
        stale_count: 0,
        worklist: [0; 512],
        wl_head: 0,
        wl_tail: 0,
        recompile_count: 0,
        total_nodes_checked: 0,
    }
}

// ============================================================================
// Section 4: Fingerprint operations
// ============================================================================

// Compare two fingerprints for equality.
fn inc_fingerprint_eq(a: &IncFingerprint, b: &IncFingerprint) -> bool {
    a.hash_lo == b.hash_lo && a.hash_hi == b.hash_hi
}

// Check if a fingerprint is the zero fingerprint.
fn inc_fingerprint_is_zero(fp: &IncFingerprint) -> bool {
    fp.hash_lo == 0 && fp.hash_hi == 0
}

// Hash a single i64 value into a 128-bit fingerprint using FNV-1a.
// The low half uses the standard FNV offset; the high half uses a
// rotated variant for independence.
fn inc_fingerprint_from_i64(val: i64) -> IncFingerprint with Mut, Panic {
    // Low half: FNV-1a of val
    var lo: i64 = INC_FNV_OFFSET()
    // XOR byte 0
    var v: i64 = val
    var b0: i64 = v % 256
    if b0 < 0 {
        b0 = b0 + 256
    }
    lo = lo ^ b0
    lo = lo * INC_FNV_PRIME()

    // XOR byte 1
    v = v / 256
    var b1: i64 = v % 256
    if b1 < 0 {
        b1 = b1 + 256
    }
    lo = lo ^ b1
    lo = lo * INC_FNV_PRIME()

    // XOR byte 2
    v = v / 256
    var b2: i64 = v % 256
    if b2 < 0 {
        b2 = b2 + 256
    }
    lo = lo ^ b2
    lo = lo * INC_FNV_PRIME()

    // XOR byte 3
    v = v / 256
    var b3: i64 = v % 256
    if b3 < 0 {
        b3 = b3 + 256
    }
    lo = lo ^ b3
    lo = lo * INC_FNV_PRIME()

    // High half: use a different offset basis for independence
    var hi: i64 = INC_FNV_OFFSET() ^ 7046029254386353131
    hi = hi ^ b0
    hi = hi * INC_FNV_PRIME()
    hi = hi ^ b1
    hi = hi * INC_FNV_PRIME()
    hi = hi ^ b2
    hi = hi * INC_FNV_PRIME()
    hi = hi ^ b3
    hi = hi * INC_FNV_PRIME()

    IncFingerprint {
        hash_lo: lo,
        hash_hi: hi,
    }
}

// Combine two fingerprints into one (order-dependent).
// Uses XOR-rotate-multiply to merge the lanes.
fn inc_fingerprint_combine(a: &IncFingerprint, b: &IncFingerprint) -> IncFingerprint with Mut, Panic {
    var lo: i64 = a.hash_lo
    lo = lo ^ b.hash_lo
    lo = lo * INC_FNV_PRIME()

    var hi: i64 = a.hash_hi
    hi = hi ^ b.hash_hi
    hi = hi * INC_FNV_PRIME()

    // Mix high bits into low for avalanche
    lo = lo ^ (hi / 65536)
    hi = hi ^ (lo / 65536)

    IncFingerprint {
        hash_lo: lo,
        hash_hi: hi,
    }
}

// Hash an array of i64 values into a single fingerprint.
// Processes `len` elements from `data`.
fn inc_fingerprint_from_bytes(data: &[i64; 256], len: i64) -> IncFingerprint with Mut, Div, Panic {
    var lo: i64 = INC_FNV_OFFSET()
    var hi: i64 = INC_FNV_OFFSET() ^ 7046029254386353131

    var i: i64 = 0
    while i < len {
        if i >= 256 {
            // Safety: don't overrun the array
            i = len
        } else {
            let val = data[i as usize]

            // Extract 4 bytes from val
            var v: i64 = val
            var b0: i64 = v % 256
            if b0 < 0 {
                b0 = b0 + 256
            }
            lo = lo ^ b0
            lo = lo * INC_FNV_PRIME()
            hi = hi ^ b0
            hi = hi * INC_FNV_PRIME()

            v = v / 256
            var b1: i64 = v % 256
            if b1 < 0 {
                b1 = b1 + 256
            }
            lo = lo ^ b1
            lo = lo * INC_FNV_PRIME()
            hi = hi ^ b1
            hi = hi * INC_FNV_PRIME()

            v = v / 256
            var b2: i64 = v % 256
            if b2 < 0 {
                b2 = b2 + 256
            }
            lo = lo ^ b2
            lo = lo * INC_FNV_PRIME()
            hi = hi ^ b2
            hi = hi * INC_FNV_PRIME()

            v = v / 256
            var b3: i64 = v % 256
            if b3 < 0 {
                b3 = b3 + 256
            }
            lo = lo ^ b3
            lo = lo * INC_FNV_PRIME()
            hi = hi ^ b3
            hi = hi * INC_FNV_PRIME()

            i = i + 1
        }
    }

    // Final avalanche mix
    lo = lo ^ (hi / 65536)
    hi = hi ^ (lo / 65536)

    IncFingerprint {
        hash_lo: lo,
        hash_hi: hi,
    }
}

// Create a fingerprint from two explicit i64 values (for testing).
fn inc_fingerprint_make(lo: i64, hi: i64) -> IncFingerprint {
    IncFingerprint {
        hash_lo: lo,
        hash_hi: hi,
    }
}

// ============================================================================
// Section 5: Node management
// ============================================================================

// Add a dependency node to the context.  Returns the node ID (index).
fn inc_add_node(ctx: &! IncContext, kind: i64, name_hash: i64) -> i64 with Mut, Div, Panic {
    let idx = ctx.node_count
    if idx >= INC_MAX_NODES {
        return 0 - 1
    }
    ctx.nodes[idx as usize] = IncDepNode {
        id: idx,
        kind: kind,
        state: INC_STATE_FRESH,
        name_hash: name_hash,
        fingerprint: inc_fingerprint_zero(),
        cached_fingerprint: inc_fingerprint_zero(),
        change: INC_CHANGE_NONE,
        edge_start: 0,
        edge_count: 0,
    }
    ctx.node_count = idx + 1
    idx
}

// Get the kind of a node.
fn inc_get_node_kind(ctx: &IncContext, node_id: i64) -> i64 with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return 0
    }
    ctx.nodes[node_id as usize].kind
}

// Get the state of a node.
fn inc_get_node_state(ctx: &IncContext, node_id: i64) -> i64 with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return INC_STATE_ERROR
    }
    ctx.nodes[node_id as usize].state
}

// Set the state of a node.
fn inc_set_node_state(ctx: &! IncContext, node_id: i64, state: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].state = state
    }
}

// Get the name hash of a node.
fn inc_get_name_hash(ctx: &IncContext, node_id: i64) -> i64 with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return 0
    }
    ctx.nodes[node_id as usize].name_hash
}

// Get the change kind of a node.
fn inc_get_change(ctx: &IncContext, node_id: i64) -> i64 with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return INC_CHANGE_NONE
    }
    ctx.nodes[node_id as usize].change
}

// Set the change kind of a node.
fn inc_set_change(ctx: &! IncContext, node_id: i64, change: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].change = change
    }
}

// ============================================================================
// Section 6: Edge management
// ============================================================================

// Add a dependency edge: `from` depends on `to`.
// Returns true on success, false if capacity exceeded or invalid nodes.
fn inc_add_edge(ctx: &! IncContext, from: i64, to: i64) -> bool with Mut, Div, Panic {
    if from < 0 || from >= ctx.node_count {
        return false
    }
    if to < 0 || to >= ctx.node_count {
        return false
    }
    let idx = ctx.edge_count
    if idx >= INC_MAX_EDGES {
        return false
    }
    ctx.edges[idx as usize] = IncEdge {
        from_node: from,
        to_node: to,
    }
    ctx.edge_count = idx + 1
    true
}

// Check if an edge exists from `from` to `to`.
fn inc_has_edge(ctx: &IncContext, from: i64, to: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.edge_count {
        if ctx.edges[i as usize].from_node == from && ctx.edges[i as usize].to_node == to {
            return true
        }
        i = i + 1
    }
    false
}

// Count forward dependencies of a node (how many nodes it depends on).
// These are edges where from_node == node_id.
fn inc_dependencies(ctx: &IncContext, node_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.edge_count {
        if ctx.edges[i as usize].from_node == node_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count reverse dependencies of a node (how many nodes depend on it).
// These are edges where to_node == node_id.
fn inc_dependents(ctx: &IncContext, node_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.edge_count {
        if ctx.edges[i as usize].to_node == node_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Collect the IDs of nodes that `node_id` depends on (forward deps).
// Returns the count, writing into `out_buf`.
fn inc_get_dependencies(ctx: &IncContext, node_id: i64, out_buf: &! [i64; 512]) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.edge_count {
        if ctx.edges[i as usize].from_node == node_id {
            if count < INC_MAX_STALE {
                out_buf[count as usize] = ctx.edges[i as usize].to_node
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Collect the IDs of nodes that depend on `node_id` (reverse deps).
// Returns the count, writing into `out_buf`.
fn inc_get_dependents(ctx: &IncContext, node_id: i64, out_buf: &! [i64; 512]) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.edge_count {
        if ctx.edges[i as usize].to_node == node_id {
            if count < INC_MAX_STALE {
                out_buf[count as usize] = ctx.edges[i as usize].from_node
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 7: Fingerprint getters and setters
// ============================================================================

// Set the current fingerprint for a node.
fn inc_set_fingerprint(ctx: &! IncContext, node_id: i64, fp: IncFingerprint) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].fingerprint = fp
    }
}

// Get the current fingerprint for a node.
fn inc_get_fingerprint(ctx: &IncContext, node_id: i64) -> IncFingerprint with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return inc_fingerprint_zero()
    }
    ctx.nodes[node_id as usize].fingerprint
}

// Set the cached (previous-build) fingerprint for a node.
fn inc_set_cached_fingerprint(ctx: &! IncContext, node_id: i64, fp: IncFingerprint) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].cached_fingerprint = fp
    }
}

// Get the cached fingerprint for a node.
fn inc_get_cached_fingerprint(ctx: &IncContext, node_id: i64) -> IncFingerprint with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return inc_fingerprint_zero()
    }
    ctx.nodes[node_id as usize].cached_fingerprint
}

// ============================================================================
// Section 8: Change detection
// ============================================================================

// Compare current fingerprints against cached fingerprints for all nodes.
// Nodes whose fingerprints differ are marked StateStale with ChangeModified.
// Nodes with zero cached fingerprint are marked ChangeAdded (new).
// Nodes with zero current fingerprint but non-zero cached are ChangeRemoved.
fn inc_detect_changes(ctx: &! IncContext) with Mut, Div, Panic {
    var i: i64 = 0
    ctx.stale_count = 0
    ctx.total_nodes_checked = ctx.node_count

    while i < ctx.node_count {
        let cur_zero = inc_fingerprint_is_zero(&ctx.nodes[i as usize].fingerprint)
        let cached_zero = inc_fingerprint_is_zero(&ctx.nodes[i as usize].cached_fingerprint)

        if cur_zero && cached_zero {
            // Both zero — fresh node, no prior data, treat as unchanged
            ctx.nodes[i as usize].change = INC_CHANGE_NONE
            ctx.nodes[i as usize].state = INC_STATE_VALID
        } else if cur_zero && cached_zero == false {
            // Current is zero but cached is not — node was removed
            ctx.nodes[i as usize].change = INC_CHANGE_REMOVED
            ctx.nodes[i as usize].state = INC_STATE_STALE
            if ctx.stale_count < INC_MAX_STALE {
                ctx.stale_list[ctx.stale_count as usize] = i
                ctx.stale_count = ctx.stale_count + 1
            }
        } else if cur_zero == false && cached_zero {
            // Current is non-zero but cached is zero — node was added
            ctx.nodes[i as usize].change = INC_CHANGE_ADDED
            ctx.nodes[i as usize].state = INC_STATE_STALE
            if ctx.stale_count < INC_MAX_STALE {
                ctx.stale_list[ctx.stale_count as usize] = i
                ctx.stale_count = ctx.stale_count + 1
            }
        } else {
            // Both non-zero — compare
            let eq = inc_fingerprint_eq(
                &ctx.nodes[i as usize].fingerprint,
                &ctx.nodes[i as usize].cached_fingerprint
            )
            if eq {
                ctx.nodes[i as usize].change = INC_CHANGE_NONE
                ctx.nodes[i as usize].state = INC_STATE_VALID
            } else {
                ctx.nodes[i as usize].change = INC_CHANGE_MODIFIED
                ctx.nodes[i as usize].state = INC_STATE_STALE
                if ctx.stale_count < INC_MAX_STALE {
                    ctx.stale_list[ctx.stale_count as usize] = i
                    ctx.stale_count = ctx.stale_count + 1
                }
            }
        }
        i = i + 1
    }
}

// Check if a specific node is stale.
fn inc_node_is_stale(ctx: &IncContext, node_id: i64) -> bool with Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return false
    }
    ctx.nodes[node_id as usize].state == INC_STATE_STALE
}

// Return the number of stale nodes.
fn inc_stale_count(ctx: &IncContext) -> i64 {
    ctx.stale_count
}

// ============================================================================
// Section 9: Worklist operations
// ============================================================================

// Push an item onto the worklist (circular buffer).
fn inc_worklist_push(ctx: &! IncContext, item: i64) with Mut, Div, Panic {
    // Check capacity — worklist wraps at INC_MAX_STALE
    let next_tail = (ctx.wl_tail + 1) % INC_MAX_STALE
    if next_tail == ctx.wl_head {
        // Worklist full, drop item
        return
    }
    ctx.worklist[ctx.wl_tail as usize] = item
    ctx.wl_tail = next_tail
}

// Pop an item from the worklist.  Returns INC_INVALID if empty.
fn inc_worklist_pop(ctx: &! IncContext) -> i64 with Mut, Div, Panic {
    if ctx.wl_head == ctx.wl_tail {
        return INC_INVALID
    }
    let item = ctx.worklist[ctx.wl_head as usize]
    ctx.wl_head = (ctx.wl_head + 1) % INC_MAX_STALE
    item
}

// Check if the worklist is empty.
fn inc_worklist_empty(ctx: &IncContext) -> bool {
    ctx.wl_head == ctx.wl_tail
}

// Reset the worklist.
fn inc_worklist_reset(ctx: &! IncContext) with Mut {
    ctx.wl_head = 0
    ctx.wl_tail = 0
}

// ============================================================================
// Section 10: Transitive invalidation (BFS)
// ============================================================================

// Propagate staleness transitively through reverse dependency edges.
// After calling inc_detect_changes, this BFS starts from all stale nodes
// and marks every node that depends on a stale node as also stale.
fn inc_invalidate_transitive(ctx: &! IncContext) with Mut, Div, Panic {
    // Reset worklist
    inc_worklist_reset(ctx)

    // Seed the worklist with all currently stale nodes
    var i: i64 = 0
    while i < ctx.stale_count {
        let nid = ctx.stale_list[i as usize]
        inc_worklist_push(ctx, nid)
        i = i + 1
    }

    // BFS: for each stale node, find all nodes that depend on it
    // (reverse edges: edges where to_node == stale_node)
    // and mark them stale too.
    //
    // Use a visited array to avoid cycles.
    var visited: [bool; 2048] = [false; 2048]

    // Mark initially stale nodes as visited
    var j: i64 = 0
    while j < ctx.stale_count {
        let nid = ctx.stale_list[j as usize]
        if nid >= 0 && nid < INC_MAX_NODES {
            visited[nid as usize] = true
        }
        j = j + 1
    }

    // BFS loop
    while inc_worklist_empty(ctx) == false {
        let current = inc_worklist_pop(ctx)
        if current == INC_INVALID {
            // Should not happen, but guard anyway
            return
        }

        // Find all nodes that depend on `current`
        // i.e., edges where to_node == current => from_node is a dependent
        var k: i64 = 0
        while k < ctx.edge_count {
            if ctx.edges[k as usize].to_node == current {
                let dep = ctx.edges[k as usize].from_node
                if dep >= 0 && dep < ctx.node_count {
                    if visited[dep as usize] == false {
                        visited[dep as usize] = true
                        ctx.nodes[dep as usize].state = INC_STATE_STALE
                        ctx.nodes[dep as usize].change = INC_CHANGE_MODIFIED
                        // Add to stale list
                        if ctx.stale_count < INC_MAX_STALE {
                            ctx.stale_list[ctx.stale_count as usize] = dep
                            ctx.stale_count = ctx.stale_count + 1
                        }
                        // Enqueue for further propagation
                        inc_worklist_push(ctx, dep)
                    }
                }
            }
            k = k + 1
        }
    }
}

// ============================================================================
// Section 11: Selective recompilation
// ============================================================================

// Mark all stale nodes for recompilation.
// Returns the number of nodes marked for recompilation.
fn inc_selective_recompile(ctx: &! IncContext) -> i64 with Mut, Div, Panic {
    var recompile_count: i64 = 0
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].state == INC_STATE_STALE {
            ctx.nodes[i as usize].state = INC_STATE_RECOMPILING
            recompile_count = recompile_count + 1
        }
        i = i + 1
    }
    ctx.recompile_count = recompile_count
    recompile_count
}

// Mark a specific node as successfully recompiled.
// Updates state to Valid and syncs the cached fingerprint.
fn inc_mark_recompiled(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].state = INC_STATE_VALID
        ctx.nodes[node_id as usize].change = INC_CHANGE_NONE
        // Sync cached fingerprint to current
        ctx.nodes[node_id as usize].cached_fingerprint = ctx.nodes[node_id as usize].fingerprint
        if ctx.recompile_count > 0 {
            ctx.recompile_count = ctx.recompile_count - 1
        }
    }
}

// Mark a node as having errored during recompilation.
fn inc_mark_error(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        ctx.nodes[node_id as usize].state = INC_STATE_ERROR
    }
}

// Count nodes currently in recompiling state.
fn inc_recompiling_count(ctx: &IncContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].state == INC_STATE_RECOMPILING {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count nodes in valid state.
fn inc_valid_count(ctx: &IncContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].state == INC_STATE_VALID {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count nodes in error state.
fn inc_error_count(ctx: &IncContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].state == INC_STATE_ERROR {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 12: Cache operations
// ============================================================================

// Look up a node in the cache by node_id.
// Returns the result_hash if found and valid, or INC_INVALID if not found.
fn inc_cache_lookup(ctx: &IncContext, node_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].node_id == node_id && ctx.cache[i as usize].valid {
            // Also verify fingerprint matches
            let fp_match = inc_fingerprint_eq(
                &ctx.cache[i as usize].fingerprint,
                &ctx.nodes[node_id as usize].fingerprint
            )
            if fp_match {
                return ctx.cache[i as usize].result_hash
            }
        }
        i = i + 1
    }
    INC_INVALID
}

// Insert or update a cache entry for a node.
fn inc_cache_insert(ctx: &! IncContext, node_id: i64, result_hash: i64) with Mut, Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return
    }

    // Check if entry already exists for this node
    var i: i64 = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].node_id == node_id {
            // Update existing entry
            ctx.cache[i as usize].fingerprint = ctx.nodes[node_id as usize].fingerprint
            ctx.cache[i as usize].result_hash = result_hash
            ctx.cache[i as usize].valid = true
            return
        }
        i = i + 1
    }

    // Insert new entry
    if ctx.cache_count >= INC_MAX_CACHE {
        return
    }
    ctx.cache[ctx.cache_count as usize] = IncCacheEntry {
        node_id: node_id,
        fingerprint: ctx.nodes[node_id as usize].fingerprint,
        result_hash: result_hash,
        valid: true,
    }
    ctx.cache_count = ctx.cache_count + 1
}

// Invalidate all cache entries for a specific node.
fn inc_cache_invalidate(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].node_id == node_id {
            ctx.cache[i as usize].valid = false
        }
        i = i + 1
    }
}

// Invalidate all cache entries.
fn inc_cache_clear(ctx: &! IncContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.cache_count {
        ctx.cache[i as usize].valid = false
        i = i + 1
    }
}

// Count valid cache entries.
fn inc_cache_valid_count(ctx: &IncContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.cache_count {
        if ctx.cache[i as usize].valid {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 13: Dependency graph construction from adjacency matrix
// ============================================================================

// Build a dependency graph from a flat adjacency matrix.
// `fn_count` is the number of functions/nodes.
// `dep_matrix` is a flattened fn_count x fn_count matrix stored row-major
// in a [i64; 4096] array.  dep_matrix[i * fn_count + j] != 0 means node i
// depends on node j.
//
// All nodes are added as INC_NODE_FUNCTION with name_hash = node index.
//
// Returns true on success.
fn inc_build_dep_graph(ctx: &! IncContext, fn_count: i64, dep_matrix: &[i64; 4096]) -> bool with Mut, Div, Panic {
    if fn_count <= 0 || fn_count > 64 {
        // 64^2 = 4096, which is the max matrix size
        return false
    }

    // Add nodes
    var i: i64 = 0
    while i < fn_count {
        let nid = inc_add_node(ctx, INC_NODE_FUNCTION, i)
        if nid < 0 {
            return false
        }
        i = i + 1
    }

    // Add edges from matrix
    var row: i64 = 0
    while row < fn_count {
        var col: i64 = 0
        while col < fn_count {
            let idx = row * fn_count + col
            if idx < 4096 {
                if dep_matrix[idx as usize] != 0 {
                    let ok = inc_add_edge(ctx, row, col)
                    if ok == false {
                        return false
                    }
                }
            }
            col = col + 1
        }
        row = row + 1
    }

    true
}

// ============================================================================
// Section 14: Topological sort (Kahn's algorithm)
// ============================================================================

// Topologically sort all nodes in the context.
// Uses Kahn's algorithm (BFS with in-degree tracking).
// Result is stored in ctx.worklist (reused as output buffer).
// Returns true if sort succeeded (no cycles), false if cycle detected.
fn inc_topological_sort(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Compute in-degrees
    var in_deg: [i64; 2048] = [0; 2048]
    var i: i64 = 0
    while i < ctx.edge_count {
        let t = ctx.edges[i as usize].to_node
        if t >= 0 && t < ctx.node_count {
            in_deg[t as usize] = in_deg[t as usize] + 1
        }
        i = i + 1
    }

    // Note: we use a separate queue to avoid corrupting ctx.worklist
    // during the sort, then copy the result into ctx.worklist.
    var queue: [i64; 2048] = [0; 2048]
    var q_head: i64 = 0
    var q_tail: i64 = 0

    // Seed queue with zero-in-degree nodes
    var j: i64 = 0
    while j < ctx.node_count {
        if in_deg[j as usize] == 0 {
            queue[q_tail as usize] = j
            q_tail = q_tail + 1
        }
        j = j + 1
    }

    // Output buffer
    var topo: [i64; 2048] = [0; 2048]
    var topo_count: i64 = 0

    // BFS
    while q_head < q_tail {
        let curr = queue[q_head as usize]
        q_head = q_head + 1

        topo[topo_count as usize] = curr
        topo_count = topo_count + 1

        // Decrement in-degree of successors
        // An edge from->to means `from` depends on `to`.
        // For topological ordering we want to process `to` before `from`.
        // So we look for edges where from_node == curr and decrement in_deg[to_node].
        // Wait — Kahn's processes sources first (in-degree 0 in the dependency graph).
        // In our graph, edges go from depender -> dependee.
        // In-degree of a node = number of edges pointing TO it = number of dependees.
        // Actually, let me re-think: for topological sort of a DAG,
        // we process nodes with no incoming edges first.
        // Our edges: from_node depends on to_node.
        // So "from -> to" means there's an edge from `from` to `to`.
        // In-degree of `to` = number of nodes that depend on it.
        // Processing order: process a node when all nodes IT depends on are done.
        // So we need reverse: process nodes that have no dependencies first.
        // Dependencies of curr: edges where from_node == curr.
        // But we computed in_deg as edges pointing TO each node.
        // Hmm, let's use the standard: in_deg[n] = count of edges where to_node == n.
        // A node with in_deg 0 has nothing pointing to it — nothing depends on it.
        // That's a leaf. We want to process leaves first? No — we want to process
        // roots (things depended upon) first.
        //
        // Actually, for incremental recompilation the order should be:
        // process dependencies before dependents. If A depends on B,
        // process B first. Edge: A -> B. In-degree of B = 1 (one edge TO B).
        // We want to process B first, but B has in_degree=1, not 0.
        //
        // The standard approach: reverse the edges, then Kahn's.
        // Or equivalently: compute out-degree and process nodes with out-degree 0.
        //
        // Let's do it correctly: use out-degree for "nothing depends on me" = leaf.
        // Actually simpler: just reverse the edge semantics for Kahn's.
        // We want: process node X when all of X's dependees are processed.
        // X's dependees are to_node for edges where from_node == X.
        // So: in-degree of X in the REVERSED graph = number of edges where to_node == X
        //   = number of nodes that X is depended upon by.
        // Wait, that's what we already have. And in_deg[X] == 0 means nothing
        // depends on X, so X is a leaf. Processing leaves first gives reverse
        // topological order. We want forward order (roots first).
        //
        // Let's just do it with "pending count" = number of unprocessed dependencies.
        // pending[X] = number of edges where from_node == X (X's dependency count).
        // When pending[X] == 0, X can be processed.
        // When we process X, for each edge where to_node == X (dependents of X),
        // we decrement pending[from_node] for those dependents.

        // We need to redo in-degree as "dependency count" (out-degree in our edge model).
        // But we already started the algorithm. Let me just swap the edge direction
        // in the decrement step.

        var k: i64 = 0
        while k < ctx.edge_count {
            if ctx.edges[k as usize].from_node == curr {
                let succ = ctx.edges[k as usize].to_node
                if succ >= 0 && succ < ctx.node_count {
                    in_deg[succ as usize] = in_deg[succ as usize] - 1
                    if in_deg[succ as usize] == 0 {
                        if q_tail < INC_MAX_NODES {
                            queue[q_tail as usize] = succ
                            q_tail = q_tail + 1
                        }
                    }
                }
            }
            k = k + 1
        }
    }

    // Copy result into worklist
    inc_worklist_reset(ctx)
    var m: i64 = 0
    while m < topo_count {
        if m < INC_MAX_STALE {
            ctx.worklist[m as usize] = topo[m as usize]
        }
        m = m + 1
    }
    ctx.wl_tail = topo_count
    if ctx.wl_tail > INC_MAX_STALE {
        ctx.wl_tail = INC_MAX_STALE
    }

    // Success if all nodes were visited
    topo_count == ctx.node_count
}

// ============================================================================
// Section 15: High-level incremental pipeline
// ============================================================================

// Run the full incremental pipeline:
//   1. Detect changes (fingerprint comparison)
//   2. Propagate staleness transitively
//   3. Schedule recompilation
// Returns the number of nodes to recompile.
fn inc_run_pipeline(ctx: &! IncContext) -> i64 with Mut, Div, Panic {
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)
    let count = inc_selective_recompile(ctx)
    count
}

// Reset all node states to Fresh.
fn inc_reset_states(ctx: &! IncContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.node_count {
        ctx.nodes[i as usize].state = INC_STATE_FRESH
        ctx.nodes[i as usize].change = INC_CHANGE_NONE
        i = i + 1
    }
    ctx.stale_count = 0
    ctx.recompile_count = 0
}

// Reset the entire context (nodes, edges, cache, worklist).
fn inc_reset(ctx: &! IncContext) with Mut, Div, Panic {
    ctx.node_count = 0
    ctx.edge_count = 0
    ctx.cache_count = 0
    ctx.stale_count = 0
    ctx.wl_head = 0
    ctx.wl_tail = 0
    ctx.recompile_count = 0
    ctx.total_nodes_checked = 0
}

// ============================================================================
// Section 16: Utility functions
// ============================================================================

// Count total edges in the graph.
fn inc_edge_count(ctx: &IncContext) -> i64 {
    ctx.edge_count
}

// Count total nodes in the graph.
fn inc_node_count(ctx: &IncContext) -> i64 {
    ctx.node_count
}

// Check if node kind is valid.
fn inc_valid_kind(kind: i64) -> bool {
    kind >= INC_NODE_FUNCTION && kind <= INC_NODE_GLOBAL
}

// Check if node state is valid.
fn inc_valid_state(state: i64) -> bool {
    state >= INC_STATE_FRESH && state <= INC_STATE_ERROR
}

// Find a node by name_hash.  Returns the node ID or INC_INVALID.
fn inc_find_by_name(ctx: &IncContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].name_hash == name_hash {
            return i
        }
        i = i + 1
    }
    INC_INVALID
}

// Count nodes of a given kind.
fn inc_count_by_kind(ctx: &IncContext, kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.node_count {
        if ctx.nodes[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Compute the "impact score" of a node: how many nodes transitively depend on it.
// Uses a BFS similar to invalidation.
fn inc_impact_score(ctx: &IncContext, node_id: i64) -> i64 with Mut, Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return 0
    }

    var visited: [bool; 2048] = [false; 2048]
    var queue: [i64; 2048] = [0; 2048]
    var q_head: i64 = 0
    var q_tail: i64 = 0

    visited[node_id as usize] = true
    queue[0] = node_id
    q_tail = 1

    var impact: i64 = 0

    while q_head < q_tail {
        let curr = queue[q_head as usize]
        q_head = q_head + 1

        // Find all dependents of curr (nodes that depend on curr)
        var k: i64 = 0
        while k < ctx.edge_count {
            if ctx.edges[k as usize].to_node == curr {
                let dep = ctx.edges[k as usize].from_node
                if dep >= 0 && dep < ctx.node_count {
                    if visited[dep as usize] == false {
                        visited[dep as usize] = true
                        impact = impact + 1
                        if q_tail < INC_MAX_NODES {
                            queue[q_tail as usize] = dep
                            q_tail = q_tail + 1
                        }
                    }
                }
            }
            k = k + 1
        }
    }

    impact
}

// Check if the graph has any cycles.
// Uses the topological sort approach: if Kahn's can't visit all nodes,
// there is a cycle.
fn inc_has_cycle(ctx: &IncContext) -> bool with Mut, Div, Panic {
    // Compute in-degrees
    var in_deg: [i64; 2048] = [0; 2048]
    var i: i64 = 0
    while i < ctx.edge_count {
        let t = ctx.edges[i as usize].to_node
        if t >= 0 && t < ctx.node_count {
            in_deg[t as usize] = in_deg[t as usize] + 1
        }
        i = i + 1
    }

    var queue: [i64; 2048] = [0; 2048]
    var q_head: i64 = 0
    var q_tail: i64 = 0

    var j: i64 = 0
    while j < ctx.node_count {
        if in_deg[j as usize] == 0 {
            queue[q_tail as usize] = j
            q_tail = q_tail + 1
        }
        j = j + 1
    }

    var visited_count: i64 = 0
    while q_head < q_tail {
        let curr = queue[q_head as usize]
        q_head = q_head + 1
        visited_count = visited_count + 1

        var k: i64 = 0
        while k < ctx.edge_count {
            if ctx.edges[k as usize].from_node == curr {
                let succ = ctx.edges[k as usize].to_node
                if succ >= 0 && succ < ctx.node_count {
                    in_deg[succ as usize] = in_deg[succ as usize] - 1
                    if in_deg[succ as usize] == 0 {
                        if q_tail < INC_MAX_NODES {
                            queue[q_tail as usize] = succ
                            q_tail = q_tail + 1
                        }
                    }
                }
            }
            k = k + 1
        }
    }

    visited_count < ctx.node_count
}

// Compute the depth of the dependency tree for a given node.
// Depth = longest chain of dependencies from this node to a leaf.
fn inc_dep_depth(ctx: &IncContext, node_id: i64) -> i64 with Mut, Div, Panic {
    if node_id < 0 || node_id >= ctx.node_count {
        return 0
    }

    // Simple iterative DFS with depth tracking
    var max_depth: i64 = 0
    var stack: [i64; 512] = [0; 512]
    var depths: [i64; 512] = [0; 512]
    var s_top: i64 = 0

    stack[0] = node_id
    depths[0] = 0
    s_top = 1

    var visited: [bool; 2048] = [false; 2048]

    while s_top > 0 {
        s_top = s_top - 1
        let curr = stack[s_top as usize]
        let d = depths[s_top as usize]

        if d > max_depth {
            max_depth = d
        }

        if visited[curr as usize] == false {
            visited[curr as usize] = true

            // Push dependencies (edges where from_node == curr)
            var k: i64 = 0
            while k < ctx.edge_count {
                if ctx.edges[k as usize].from_node == curr {
                    let dep = ctx.edges[k as usize].to_node
                    if dep >= 0 && dep < ctx.node_count {
                        if visited[dep as usize] == false {
                            if s_top < 512 {
                                stack[s_top as usize] = dep
                                depths[s_top as usize] = d + 1
                                s_top = s_top + 1
                            }
                        }
                    }
                }
                k = k + 1
            }
        }
    }

    max_depth
}

// ============================================================================
// Section 17: Test helpers
// ============================================================================

// Build a simple chain: n0 -> n1 -> n2 -> ... -> n(count-1)
// where n(i) depends on n(i+1).
fn inc_make_chain(ctx: &! IncContext, count: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < count {
        let nid = inc_add_node(ctx, INC_NODE_FUNCTION, i * 100 + 1)
        i = i + 1
    }
    // Edges: 0->1, 1->2, ...
    var j: i64 = 0
    while j < count - 1 {
        let ok = inc_add_edge(ctx, j, j + 1)
        j = j + 1
    }
}

// Build a diamond: n0 -> n1, n0 -> n2, n1 -> n3, n2 -> n3
fn inc_make_diamond(ctx: &! IncContext) with Mut, Div, Panic {
    let n0 = inc_add_node(ctx, INC_NODE_MODULE, 100)
    let n1 = inc_add_node(ctx, INC_NODE_FUNCTION, 200)
    let n2 = inc_add_node(ctx, INC_NODE_FUNCTION, 300)
    let n3 = inc_add_node(ctx, INC_NODE_TYPE, 400)

    let e0 = inc_add_edge(ctx, 0, 1)
    let e1 = inc_add_edge(ctx, 0, 2)
    let e2 = inc_add_edge(ctx, 1, 3)
    let e3 = inc_add_edge(ctx, 2, 3)
}

// Build a star: center node with `arm_count` dependents.
// center = node 0, arms = nodes 1..arm_count
// Each arm depends on center: arm_i -> center
fn inc_make_star(ctx: &! IncContext, arm_count: i64) with Mut, Div, Panic {
    let center = inc_add_node(ctx, INC_NODE_MODULE, 999)
    var i: i64 = 0
    while i < arm_count {
        let arm = inc_add_node(ctx, INC_NODE_FUNCTION, i * 10 + 1)
        let ok = inc_add_edge(ctx, arm, center)
        i = i + 1
    }
}

// Set all nodes to have a specific fingerprint and matching cached fingerprint
// (i.e., unchanged).
fn inc_set_all_unchanged(ctx: &! IncContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.node_count {
        let fp = inc_fingerprint_from_i64(i * 1000 + 42)
        ctx.nodes[i as usize].fingerprint = fp
        ctx.nodes[i as usize].cached_fingerprint = fp
        i = i + 1
    }
}

// Set a single node to have a modified fingerprint (current != cached).
fn inc_modify_node(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        let fp = inc_fingerprint_from_i64(node_id * 7777 + 13)
        ctx.nodes[node_id as usize].fingerprint = fp
        // Keep cached_fingerprint as is — causes a diff
    }
}

// Set a node as "added" — has current fingerprint but zero cached.
fn inc_mark_as_added(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        let fp = inc_fingerprint_from_i64(node_id * 5555 + 7)
        ctx.nodes[node_id as usize].fingerprint = fp
        ctx.nodes[node_id as usize].cached_fingerprint = inc_fingerprint_zero()
    }
}

// Set a node as "removed" — has cached fingerprint but zero current.
fn inc_mark_as_removed(ctx: &! IncContext, node_id: i64) with Mut, Div, Panic {
    if node_id >= 0 && node_id < ctx.node_count {
        let fp = inc_fingerprint_from_i64(node_id * 3333 + 9)
        ctx.nodes[node_id as usize].fingerprint = inc_fingerprint_zero()
        ctx.nodes[node_id as usize].cached_fingerprint = fp
    }
}

// ============================================================================
// Section 18: Tests — Fingerprint (T01-T10)
// ============================================================================

// T01: Zero fingerprint has both halves zero.
fn test_inc_fp_zero_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let fp = inc_fingerprint_zero()
    let lo_ok = fp.hash_lo == 0
    let hi_ok = fp.hash_hi == 0
    let is_zero = inc_fingerprint_is_zero(&fp)
    lo_ok && hi_ok && is_zero
}

fn test_inc_fp_zero() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_fp_zero_inner(&! ctx)
}

// T02: Fingerprint equality — same fingerprints are equal.
fn test_inc_fp_eq_same_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let a = inc_fingerprint_make(123, 456)
    let b = inc_fingerprint_make(123, 456)
    inc_fingerprint_eq(&a, &b)
}

fn test_inc_fp_eq_same() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_fp_eq_same_inner(&! ctx)
}

// T03: Fingerprint equality — different fingerprints are not equal.
fn test_inc_fp_eq_diff_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let a = inc_fingerprint_make(123, 456)
    let b = inc_fingerprint_make(789, 456)
    let c = inc_fingerprint_make(123, 999)
    let ab = inc_fingerprint_eq(&a, &b)
    let ac = inc_fingerprint_eq(&a, &c)
    ab == false && ac == false
}

fn test_inc_fp_eq_diff() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_fp_eq_diff_inner(&! ctx)
}

// T04: from_i64 produces non-zero fingerprints for non-zero input.
fn test_inc_fp_from_i64_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let fp = inc_fingerprint_from_i64(42)
    let non_zero = inc_fingerprint_is_zero(&fp) == false
    non_zero
}

fn test_inc_fp_from_i64() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_fp_from_i64_inner(&! ctx)
}

// T05: Different i64 values produce different fingerprints.
fn test_inc_fp_from_i64_diff_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let a = inc_fingerprint_from_i64(1)
    let b = inc_fingerprint_from_i64(2)
    let c = inc_fingerprint_from_i64(1000000)
    let ab = inc_fingerprint_eq(&a, &b) == false
    let ac = inc_fingerprint_eq(&a, &c) == false
    let bc = inc_fingerprint_eq(&b, &c) == false
    ab && ac && bc
}

fn test_inc_fp_from_i64_diff() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_fp_from_i64_diff_inner(&! ctx)
}

// T06: Same i64 value produces same fingerprint (deterministic).
fn test_inc_fp_deterministic_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
