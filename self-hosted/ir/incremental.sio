// T34: Mix of added, modified, and unchanged.
fn test_inc_detect_mixed_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 10)
    let n1 = inc_add_node(ctx, INC_NODE_TYPE, 20)
    let n2 = inc_add_node(ctx, INC_NODE_MODULE, 30)
    let n3 = inc_add_node(ctx, INC_NODE_CONSTANT, 40)

    // n0: unchanged
    let fp0 = inc_fingerprint_from_i64(100)
    inc_set_fingerprint(ctx, 0, fp0)
    inc_set_cached_fingerprint(ctx, 0, fp0)

    // n1: modified
    inc_set_fingerprint(ctx, 1, inc_fingerprint_from_i64(200))
    inc_set_cached_fingerprint(ctx, 1, inc_fingerprint_from_i64(201))

    // n2: added
    inc_set_fingerprint(ctx, 2, inc_fingerprint_from_i64(300))
    inc_set_cached_fingerprint(ctx, 2, inc_fingerprint_zero())

    // n3: removed
    inc_set_fingerprint(ctx, 3, inc_fingerprint_zero())
    inc_set_cached_fingerprint(ctx, 3, inc_fingerprint_from_i64(400))

    inc_detect_changes(ctx)

    let c0 = inc_get_change(ctx, 0) == INC_CHANGE_NONE
    let c1 = inc_get_change(ctx, 1) == INC_CHANGE_MODIFIED
    let c2 = inc_get_change(ctx, 2) == INC_CHANGE_ADDED
    let c3 = inc_get_change(ctx, 3) == INC_CHANGE_REMOVED
    let stale_ok = ctx.stale_count == 3

    c0 && c1 && c2 && c3 && stale_ok
}

fn test_inc_detect_mixed() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_detect_mixed_inner(&! ctx)
}

