fn test_inc_impact_score_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_star(ctx, 5)
    // Center = node 0.  5 arms depend on it.
    let score = inc_impact_score(ctx, 0)
    score == 5
