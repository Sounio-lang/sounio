// Pop from empty worklist returns INC_INVALID.
fn test_inc_worklist_pop_empty_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_worklist_reset(ctx)
    let val = inc_worklist_pop(ctx)
    val == INC_INVALID
}

fn test_inc_worklist_pop_empty() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_worklist_pop_empty_inner(&! ctx)
}

// ============================================================================
// Section 27: Additional utility tests (supplementary)
// ============================================================================

// Dep depth of a chain.
fn test_inc_dep_depth_chain_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 5)
    // Node 0 depends on 1, 1 on 2, 2 on 3, 3 on 4
    let d0 = inc_dep_depth(ctx, 0)  // depth 4: 0->1->2->3->4
    let d3 = inc_dep_depth(ctx, 3)  // depth 1: 3->4
    let d4 = inc_dep_depth(ctx, 4)  // depth 0: leaf
    d0 == 4 && d3 == 1 && d4 == 0
}

fn test_inc_dep_depth_chain() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_dep_depth_chain_inner(&! ctx)
}

// Has cycle detection — no cycle in chain.
fn test_inc_no_cycle_chain_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 4)
    inc_has_cycle(ctx) == false
}

fn test_inc_no_cycle_chain() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_no_cycle_chain_inner(&! ctx)
}

// Has cycle detection — cycle exists.
fn test_inc_has_cycle_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let n1 = inc_add_node(ctx, INC_NODE_FUNCTION, 2)
    let n2 = inc_add_node(ctx, INC_NODE_FUNCTION, 3)
    let e0 = inc_add_edge(ctx, 0, 1)
    let e1 = inc_add_edge(ctx, 1, 2)
    let e2 = inc_add_edge(ctx, 2, 0)  // cycle: 0->1->2->0
    inc_has_cycle(ctx)
}

fn test_inc_has_cycle() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_has_cycle_inner(&! ctx)
}

// Reset clears everything.
fn test_inc_reset_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 5)
    inc_set_all_unchanged(ctx)
    inc_modify_node(ctx, 0)
    inc_detect_changes(ctx)

    let before_nodes = ctx.node_count > 0
    let before_edges = ctx.edge_count > 0

    inc_reset(ctx)

    let after_nodes = ctx.node_count == 0
    let after_edges = ctx.edge_count == 0
    let after_stale = ctx.stale_count == 0

    before_nodes && before_edges && after_nodes && after_edges && after_stale
}

fn test_inc_reset() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_reset_inner(&! ctx)
}

// Context new gives clean state.
fn test_inc_context_new_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let nc = ctx.node_count == 0
    let ec = ctx.edge_count == 0
    let cc = ctx.cache_count == 0
    let sc = ctx.stale_count == 0
    let wh = ctx.wl_head == 0
    let wt = ctx.wl_tail == 0
    let rc = ctx.recompile_count == 0
    let tc = ctx.total_nodes_checked == 0
    nc && ec && cc && sc && wh && wt && rc && tc
}

fn test_inc_context_new() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_context_new_inner(&! ctx)
}

