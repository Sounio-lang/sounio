    let s0 = inc_node_is_stale(ctx, 0)
    let s1 = inc_node_is_stale(ctx, 1)
    let s2 = inc_node_is_stale(ctx, 2) == false
    let s3 = inc_node_is_stale(ctx, 3) == false
