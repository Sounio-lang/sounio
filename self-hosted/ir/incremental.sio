// T65: Full round-trip — detect, invalidate, recompile, mark done.
fn test_inc_full_roundtrip_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Build a small graph
    let n0 = inc_add_node(ctx, INC_NODE_MODULE, 100)
    let n1 = inc_add_node(ctx, INC_NODE_FUNCTION, 200)
    let n2 = inc_add_node(ctx, INC_NODE_FUNCTION, 300)
    let e0 = inc_add_edge(ctx, 1, 0)  // fn1 depends on module
    let e1 = inc_add_edge(ctx, 2, 0)  // fn2 depends on module

    // Set initial fingerprints (unchanged)
    inc_set_all_unchanged(ctx)

    // "Modify" the module
    inc_modify_node(ctx, 0)

    // Run pipeline
    let count = inc_run_pipeline(ctx)
    // Module + both functions should be marked for recompilation
    let count_ok = count == 3

    // Now simulate recompilation
    inc_mark_recompiled(ctx, 0)
    inc_mark_recompiled(ctx, 1)
    inc_mark_recompiled(ctx, 2)

    // All should be valid now
    let v0 = inc_get_node_state(ctx, 0) == INC_STATE_VALID
    let v1 = inc_get_node_state(ctx, 1) == INC_STATE_VALID
    let v2 = inc_get_node_state(ctx, 2) == INC_STATE_VALID
    let rc = ctx.recompile_count == 0

    // Cache the results
    inc_cache_insert(ctx, 0, 1000)
    inc_cache_insert(ctx, 1, 2000)
    inc_cache_insert(ctx, 2, 3000)

    let c0 = inc_cache_lookup(ctx, 0) == 1000
    let c1 = inc_cache_lookup(ctx, 1) == 2000
    let c2 = inc_cache_lookup(ctx, 2) == 3000

    count_ok && v0 && v1 && v2 && rc && c0 && c1 && c2
}

fn test_inc_full_roundtrip() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_full_roundtrip_inner(&! ctx)
}

