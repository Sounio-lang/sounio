// T60: Full pipeline on a chain with one modification.
fn test_inc_full_pipeline_chain_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 5)
    inc_set_all_unchanged(ctx)
    inc_modify_node(ctx, 4)  // Modify the deepest leaf

    let recompile_count = inc_run_pipeline(ctx)

    // All 5 nodes should need recompilation
    let count_ok = recompile_count == 5

    // All should be in recompiling state
    var all_recompiling: bool = true
    var i: i64 = 0
    while i < 5 {
        if inc_get_node_state(ctx, i) != INC_STATE_RECOMPILING {
            all_recompiling = false
        }
        i = i + 1
    }

    count_ok && all_recompiling
}

fn test_inc_full_pipeline_chain() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_full_pipeline_chain_inner(&! ctx)
}

