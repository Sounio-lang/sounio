// T58: Cache update overwrites existing entry.
fn test_inc_cache_update_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let fp = inc_fingerprint_from_i64(42)
    inc_set_fingerprint(ctx, 0, fp)

    inc_cache_insert(ctx, 0, 100)
    let r1 = inc_cache_lookup(ctx, 0) == 100

    inc_cache_insert(ctx, 0, 200)
    let r2 = inc_cache_lookup(ctx, 0) == 200

    // Should still be just 1 entry, not 2
    let count_ok = inc_cache_valid_count(ctx) == 1

    r1 && r2 && count_ok
}

