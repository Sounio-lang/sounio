// T07: Combine is order-dependent.
fn test_inc_fp_combine_order_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    let a = inc_fingerprint_from_i64(10)
    let b = inc_fingerprint_from_i64(20)
    let ab = inc_fingerprint_combine(&a, &b)
    let ba = inc_fingerprint_combine(&b, &a)
    // ab and ba should differ (order matters)
    inc_fingerprint_eq(&ab, &ba) == false
}

