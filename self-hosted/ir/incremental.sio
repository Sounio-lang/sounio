    test_inc_full_pipeline_no_changes_inner(&! ctx)
}

// T62: Build dep graph from adjacency matrix.
fn test_inc_build_dep_graph_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // 3x3 matrix: 0->1, 1->2
    var matrix: [i64; 4096] = [0; 4096]
    // Row 0: depends on column 1
    matrix[0 * 3 + 1] = 1
    // Row 1: depends on column 2
    matrix[1 * 3 + 2] = 1

    let ok = inc_build_dep_graph(ctx, 3, &matrix)
    let nc = ctx.node_count == 3
    let ec = ctx.edge_count == 2
    let h01 = inc_has_edge(ctx, 0, 1)
    let h12 = inc_has_edge(ctx, 1, 2)
    ok && nc && ec && h01 && h12
}

fn test_inc_build_dep_graph() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_build_dep_graph_inner(&! ctx)
}

// T63: Topological sort on a chain.
fn test_inc_topological_sort_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    inc_make_chain(ctx, 4)
    let ok = inc_topological_sort(ctx)

    // Topological sort should succeed (no cycle in a chain)
    // The exact order depends on the algorithm but all 4 nodes should be present
    // In our edge model (from depends on to), Kahn's with in-degree
    // processes nodes that nothing points to first.
    ok
}

fn test_inc_topological_sort() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_topological_sort_inner(&! ctx)
}

