    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let n1 = inc_add_node(ctx, INC_NODE_FUNCTION, 2)
    let n2 = inc_add_node(ctx, INC_NODE_FUNCTION, 3)
    let n3 = inc_add_node(ctx, INC_NODE_FUNCTION, 4)

    let e0 = inc_add_edge(ctx, 0, 1)
    let e1 = inc_add_edge(ctx, 0, 2)
    let e2 = inc_add_edge(ctx, 1, 3)
    let e3 = inc_add_edge(ctx, 2, 3)

    let h01 = inc_has_edge(ctx, 0, 1)
    let h02 = inc_has_edge(ctx, 0, 2)
    let h13 = inc_has_edge(ctx, 1, 3)
    let h23 = inc_has_edge(ctx, 2, 3)
    let no03 = inc_has_edge(ctx, 0, 3) == false
    let no30 = inc_has_edge(ctx, 3, 0) == false

    h01 && h02 && h13 && h23 && no03 && no30
}

fn test_inc_multiple_edges() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_multiple_edges_inner(&! ctx)
}

