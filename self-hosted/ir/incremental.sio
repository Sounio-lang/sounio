    if test_inc_multiple_edges() { passed = passed + 1; print("  T25 OK multiple_edges\n") } else { print("  FAIL: T25 multiple_edges\n") }
    if test_inc_star_graph() { passed = passed + 1; print("  T26 OK star_graph\n") } else { print("  FAIL: T26 star_graph\n") }

    // Change detection tests (T27-T36)
