    let n0 = inc_add_node(ctx, INC_NODE_FUNCTION, 1)
    let r1 = inc_add_edge(ctx, 0, 1) == false   // node 1 doesn't exist
    let r2 = inc_add_edge(ctx, 99, 0) == false   // node 99 doesn't exist
    let r3 = inc_add_edge(ctx, 0 - 1, 0) == false   // negative
    r1 && r2 && r3
}

