    inc_modify_node(ctx, 3)
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)
    let count = inc_selective_recompile(ctx)

    let s0 = inc_get_node_state(ctx, 0) == INC_STATE_RECOMPILING
    let s1 = inc_get_node_state(ctx, 1) == INC_STATE_RECOMPILING
    let s2 = inc_get_node_state(ctx, 2) == INC_STATE_RECOMPILING
    let s3 = inc_get_node_state(ctx, 3) == INC_STATE_RECOMPILING
    let count_ok = count == 4
    s0 && s1 && s2 && s3 && count_ok
}

fn test_inc_selective_recompile() -> bool with Mut, Div, Panic {
    var ctx = inc_context_new()
    test_inc_selective_recompile_inner(&! ctx)
}

