    inc_worklist_push(ctx, 10)
    inc_worklist_push(ctx, 20)
    inc_worklist_push(ctx, 30)
    let v1 = inc_worklist_pop(ctx)
    let v2 = inc_worklist_pop(ctx)
    let v3 = inc_worklist_pop(ctx)
    v1 == 10 && v2 == 20 && v3 == 30
}

fn test_inc_worklist_fifo() -> bool with Mut, Div, Panic {
