    let fp_old = inc_fingerprint_from_i64(111)
    inc_set_fingerprint(ctx, 0, fp_new)
    inc_set_cached_fingerprint(ctx, 0, fp_old)
    inc_set_node_state(ctx, 0, INC_STATE_RECOMPILING)
    ctx.recompile_count = 1

    inc_mark_recompiled(ctx, 0)
    let cached = inc_get_cached_fingerprint(ctx, 0)
    inc_fingerprint_eq(&cached, &fp_new)
}

