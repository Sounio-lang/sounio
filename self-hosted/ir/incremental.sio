    inc_worklist_push(ctx, 42)
    let not_empty = inc_worklist_empty(ctx) == false
    let val = inc_worklist_pop(ctx)
    let empty2 = inc_worklist_empty(ctx)
    empty1 && not_empty && val == 42 && empty2
}

