// Test Category 8: Variable Classification (5 tests)
// ============================================================================

fn test_avec_classify_induction_inner(nest: &! AvecLoopNest, plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 1)
    // Instruction that writes to the induction var (reg = 0 * 100 = 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 0, 0, 40, false, 0)
    plan.vec_width = AVEC_VEC_256
    let count = avec_classify_vars(plan, nest, 0)
    if count < 1 { return false }
    // The induction variable should be classified
    let vi = plan.vars[0]
    match vi.kind {
        AvecVarKind::AvecVarInduction => true,
        AvecVarKind::AvecVarReduction => true,
        _ => false,
    }
}

fn test_avec_classify_induction() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    var plan = avec_plan_new()
    test_avec_classify_induction_inner(&! nest, &! plan)
}

