fn test_avec_no_deps_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // Two independent instructions should have no dependences
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 21, 31, false, 0)
    let count = avec_build_dep_graph(graph, nest, 0)
    // No dependences between independent instructions
    if graph.edge_count != 0 { return false }
    true
}

