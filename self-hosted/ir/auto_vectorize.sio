}

fn test_avec_plan_with_reduction_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph, plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    // Loop with a sum reduction: sum += a[i]
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 50, 50, 10, false, 0) // reduction
    let dep_count = avec_build_dep_graph(graph, nest, 0)
    let result = avec_plan_loop(plan, nest, graph, 0)
    // Should find exactly 1 reduction
    let summary = avec_plan_summary(plan)
    if summary.reductions < 0 { return false }
    true
}

