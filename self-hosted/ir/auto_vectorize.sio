}

fn test_avec_vector_cost_loop_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 30, true, 1)
    let vc = avec_vector_cost(nest, 0, AVEC_VEC_256)
    // All unit-stride, so no gather/scatter penalty: 3 * AVEC_COST_VEC_ADD = 3
    if vc != 3 { return false }
    true
}

