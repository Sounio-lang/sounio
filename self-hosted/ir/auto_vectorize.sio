    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 11, 21, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 10, 11, false, 0)
    let dep_count = avec_build_dep_graph(graph, nest, 0)
    let result = avec_plan_loop(plan, nest, graph, 0)
    if plan.loop_id != 0 { return false }
    if plan.vec_width < AVEC_VEC_128 { return false }
    true
}

