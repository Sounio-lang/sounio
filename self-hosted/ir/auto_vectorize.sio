fn test_avec_plan_new_inner(plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    if plan.loop_id != AVEC_INVALID { return false }
    if plan.vec_width != AVEC_VEC_128 { return false }
    if plan.is_profitable { return false }
    if plan.var_count != 0 { return false }
    true
}

