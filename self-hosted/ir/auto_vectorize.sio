fn test_avec_reduction_identity_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Add identity = 0
    if avec_reduction_identity(1) != 0 { return false }
    // Mul identity = 1
    if avec_reduction_identity(2) != 1 { return false }
    // BitOr identity = 0
    if avec_reduction_identity(4) != 0 { return false }
    true
}

fn test_avec_reduction_identity() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_reduction_identity_inner(&! nest)
}

fn test_avec_is_associative_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Add and Mul are associative
    if avec_is_associative(1) == false { return false }
    if avec_is_associative(2) == false { return false }
    // Unknown op 99 is not
    if avec_is_associative(99) { return false }
    true
}

fn test_avec_is_associative() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_is_associative_inner(&! nest)
}

