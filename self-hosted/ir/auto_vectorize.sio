    var nest = avec_loop_nest_new()
    var graph = avec_dep_graph_new()
    test_avec_no_deps_inner(&! nest, &! graph)
}

fn test_avec_flow_dep_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // a[i] = ...; ... = a[i] — flow dep (RAW)
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 31, false, 0)
    let count = avec_build_dep_graph(graph, nest, 0)
    if graph.edge_count < 1 { return false }
    let edge = graph.edges[0]
    if edge.dep_type != AVEC_DEP_FLOW { return false }
    true
}

fn test_avec_flow_dep() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    var graph = avec_dep_graph_new()
    test_avec_flow_dep_inner(&! nest, &! graph)
}

fn test_avec_anti_dep_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // ... = a[i]; a[i] = ... — anti dep (WAR)
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 31, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    let count = avec_build_dep_graph(graph, nest, 0)
    // Should find an anti-dependence: first reads r10, second writes r10
    var found_anti = false
    var i: i64 = 0
    while i < graph.edge_count {
        if graph.edges[i as usize].dep_type == AVEC_DEP_ANTI {
            found_anti = true
        }
        i = i + 1
    }
    found_anti
}

fn test_avec_anti_dep() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    var graph = avec_dep_graph_new()
    test_avec_anti_dep_inner(&! nest, &! graph)
}

fn test_avec_output_dep_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // a[i] = ...; a[i] = ... — output dep (WAW)
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 21, 31, false, 0)
    let count = avec_build_dep_graph(graph, nest, 0)
    var found_output = false
    var i: i64 = 0
    while i < graph.edge_count {
        if graph.edges[i as usize].dep_type == AVEC_DEP_OUTPUT {
            found_output = true
        }
        i = i + 1
    }
    found_output
}

fn test_avec_output_dep() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    var graph = avec_dep_graph_new()
    test_avec_output_dep_inner(&! nest, &! graph)
}

fn test_avec_dep_prevents_vec_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // Loop-carried flow dep with distance 1 prevents vectorization
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 10, 20, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 10, 20, true, 1)
    let count = avec_build_dep_graph(graph, nest, 0)
    // Manually set loop-carried flag on a flow edge for testing
    if graph.edge_count > 0 {
        var i: i64 = 0
        while i < graph.edge_count {
            if graph.edges[i as usize].dep_type == AVEC_DEP_FLOW {
                graph.edges[i as usize].is_loop_carried = true
                graph.edges[i as usize].distance = 1
            }
            i = i + 1
        }
    }
    avec_dep_prevents_vectorization(graph)
}

fn test_avec_dep_prevents_vec() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    var graph = avec_dep_graph_new()
    test_avec_dep_prevents_vec_inner(&! nest, &! graph)
}

