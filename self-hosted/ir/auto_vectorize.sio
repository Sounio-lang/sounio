    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 30, true, 1)
    let sc = avec_scalar_cost(nest, 0)
    // 3 instructions * AVEC_COST_SCALAR_ADD each = 3
    if sc != 3 { return false }
    true
}

