}

fn test_avec_unprofitable_width1_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Width 1 is just scalar — not profitable
    let prof = avec_is_profitable(3, 3, 100, 1)
    prof == false
}

fn test_avec_unprofitable_width1() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_unprofitable_width1_inner(&! nest)
}

fn test_avec_speedup_estimate_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let speedup = avec_estimated_speedup(10, 10, 4)
    // speedup = (10 * 4) / (10 + 4) = 40/14 ~ 2.86
    // Should be > 1.0
    if speedup < 1.0 { return false }
    // And less than vec_width (theoretical maximum)
    if speedup > 5.0 { return false }
    true
}

fn test_avec_speedup_estimate() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_speedup_estimate_inner(&! nest)
}

// ============================================================================
// Test Category 10: Edge Cases (5 tests)
// ============================================================================

fn test_avec_invalid_loop_idx_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Operations on invalid loop indices should return safe defaults
    let is_count = avec_is_countable_loop(nest, AVEC_INVALID)
    if is_count { return false }
    let is_count2 = avec_is_countable_loop(nest, 999)
    if is_count2 { return false }
    let is_inner = avec_is_innermost(nest, AVEC_INVALID)
    if is_inner { return false }
    true
}

fn test_avec_invalid_loop_idx() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_invalid_loop_idx_inner(&! nest)
}

fn test_avec_invalid_instr_idx_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Operations on invalid instruction indices should return safe defaults
    let stride = avec_compute_stride(nest, AVEC_INVALID)
    if stride != 0 { return false }
    let is_unit = avec_is_unit_stride(nest, AVEC_INVALID)
    if is_unit { return false }
    let is_red = avec_is_reduction(nest, AVEC_INVALID)
    if is_red { return false }
    true
}

fn test_avec_invalid_instr_idx() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_invalid_instr_idx_inner(&! nest)
}

fn test_avec_empty_dep_graph_inner(graph: &! AvecDepGraph) -> bool with Mut, Div, Panic {
    // Empty graph should have no cycle and allow vectorization
    if avec_has_cycle(graph) { return false }
    if avec_dep_prevents_vectorization(graph) { return false }
    if avec_can_reorder(graph, 0, 1) == false { return false }
    true
}

fn test_avec_empty_dep_graph() -> bool with Mut, Div, Panic {
    var graph = avec_dep_graph_new()
    test_avec_empty_dep_graph_inner(&! graph)
}

fn test_avec_best_width_small_loop_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Small loop (10 iterations) — should get smallest profitable width
    let start = avec_make_test_loop(nest, 0, 0, 10, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 21, 31, false, 0)
    let width = avec_best_vec_width(nest, 0)
    // Should be a valid vector width
    if width < 2 { return false }
    if width > 8 { return false }
    true
}

fn test_avec_best_width_small_loop() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_best_width_small_loop_inner(&! nest)
}

fn test_avec_multiple_loops_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Add two loops and verify both are tracked
    let s0 = avec_make_test_loop(nest, 0, 0, 100, 1, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    let s1 = avec_make_test_loop(nest, 1, 0, 200, 1, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 21, 31, false, 0)
    if nest.loop_count != 2 { return false }
    let lp0 = nest.loops[0]
    let lp1 = nest.loops[1]
    if lp0.trip_count != 100 { return false }
    if lp1.trip_count != 200 { return false }
    true
}

fn test_avec_multiple_loops() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_multiple_loops_inner(&! nest)
}

// ============================================================================
// Test Runner
// ============================================================================

fn avec_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0

    // Category 1: Loop Detection
    if test_avec_empty_nest() { passed = passed + 1 }
    if test_avec_single_loop() { passed = passed + 1 }
    if test_avec_loop_trip_count() { passed = passed + 1 }
    if test_avec_loop_step_two() { passed = passed + 1 }
    if test_avec_loop_non_divisible_trip() { passed = passed + 1 }

    // Category 2: Trip Count Computation
    if test_avec_trip_count_zero_range() { passed = passed + 1 }
    if test_avec_trip_count_one() { passed = passed + 1 }
    if test_avec_trip_count_large_step() { passed = passed + 1 }
    if test_avec_trip_count_zero_step() { passed = passed + 1 }
    if test_avec_trip_count_negative_range() { passed = passed + 1 }

    // Category 3: Dependence Analysis
    if test_avec_no_deps() { passed = passed + 1 }
    if test_avec_flow_dep() { passed = passed + 1 }
    if test_avec_anti_dep() { passed = passed + 1 }
    if test_avec_output_dep() { passed = passed + 1 }
    if test_avec_dep_prevents_vec() { passed = passed + 1 }

    // Category 4: Stride Analysis
    if test_avec_unit_stride() { passed = passed + 1 }
    if test_avec_strided_access() { passed = passed + 1 }
    if test_avec_needs_gather() { passed = passed + 1 }
    if test_avec_contiguous_loop() { passed = passed + 1 }
    if test_avec_access_pattern() { passed = passed + 1 }

    // Category 5: Reduction Detection
    if test_avec_is_reduction() { passed = passed + 1 }
    if test_avec_not_reduction() { passed = passed + 1 }
    if test_avec_find_reductions() { passed = passed + 1 }
    if test_avec_reduction_identity() { passed = passed + 1 }
    if test_avec_is_associative() { passed = passed + 1 }

    // Category 6: Cost Model
    if test_avec_instr_scalar_cost() { passed = passed + 1 }
    if test_avec_instr_vector_cost() { passed = passed + 1 }
    if test_avec_scalar_cost_loop() { passed = passed + 1 }
    if test_avec_vector_cost_loop() { passed = passed + 1 }
    if test_avec_profitability() { passed = passed + 1 }

    // Category 7: Vectorization Planning
    if test_avec_plan_new() { passed = passed + 1 }
    if test_avec_plan_simple_loop() { passed = passed + 1 }
    if test_avec_plan_with_reduction() { passed = passed + 1 }
    if test_avec_plan_unprofitable() { passed = passed + 1 }
    if test_avec_plan_summary() { passed = passed + 1 }

    // Category 8: Variable Classification
    if test_avec_classify_induction() { passed = passed + 1 }
    if test_avec_classify_vector() { passed = passed + 1 }
    if test_avec_classify_broadcast() { passed = passed + 1 }
    if test_avec_classify_gather() { passed = passed + 1 }
    if test_avec_classify_reduction() { passed = passed + 1 }

    // Category 9: Profitability
    if test_avec_profitable_large_trip() { passed = passed + 1 }
    if test_avec_unprofitable_small_trip() { passed = passed + 1 }
    if test_avec_profitable_vec128() { passed = passed + 1 }
    if test_avec_unprofitable_width1() { passed = passed + 1 }
    if test_avec_speedup_estimate() { passed = passed + 1 }

    // Category 10: Edge Cases
    if test_avec_invalid_loop_idx() { passed = passed + 1 }
    if test_avec_invalid_instr_idx() { passed = passed + 1 }
    if test_avec_empty_dep_graph() { passed = passed + 1 }
    if test_avec_best_width_small_loop() { passed = passed + 1 }
    if test_avec_multiple_loops() { passed = passed + 1 }

    // Category 11: Alignment and Masking
    if test_avec_aligned_access() { passed = passed + 1 }
    if test_avec_alignment_peel() { passed = passed + 1 }
    if test_avec_no_masking_needed() { passed = passed + 1 }
    if test_avec_masking_needed() { passed = passed + 1 }
    if test_avec_branch_count() { passed = passed + 1 }

    // Category 12: SLP and Arithmetic Intensity
    if test_avec_packable_pair() { passed = passed + 1 }
    if test_avec_not_packable_dep() { passed = passed + 1 }
    if test_avec_packable_count() { passed = passed + 1 }
    if test_avec_arith_intensity() { passed = passed + 1 }
    if test_avec_stats_new_zeroed() { passed = passed + 1 }

    passed
}

// ============================================================================
// Test Category 11: Alignment and Masking (5 tests)
// ============================================================================

fn test_avec_aligned_access_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    // Unit stride should be considered aligned
    avec_is_aligned(nest, start, AVEC_VEC_256)
}

fn test_avec_aligned_access() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_aligned_access_inner(&! nest)
}

fn test_avec_alignment_peel_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 11, 21, 31, true, 3) // non-unit stride
    let peel = avec_alignment_peel_count(nest, 0, AVEC_VEC_256)
    // Should need peeling for the non-unit stride access
    if peel < 0 { return false }
    // Peel count should be at most vec_width - 1
    if peel > AVEC_VEC_256 { return false }
    true
}

fn test_avec_alignment_peel() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_alignment_peel_inner(&! nest)
}

fn test_avec_no_masking_needed_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Loop with only one branch (the loop exit) — no masking needed
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BRANCH_FALSE, AVEC_INVALID, 10, AVEC_INVALID, false, 0)
    if avec_needs_masking(nest, 0) { return false }
    true
}

fn test_avec_no_masking_needed() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_no_masking_needed_inner(&! nest)
}

fn test_avec_masking_needed_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Loop with two branches (exit + internal if/else) — needs masking
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_BRANCH_FALSE, AVEC_INVALID, 10, AVEC_INVALID, false, 0) // exit
    avec_add_test_instr(nest, AVEC_OP_BRANCH_TRUE, AVEC_INVALID, 11, AVEC_INVALID, false, 0)  // internal
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 20, 30, false, 0)
    avec_needs_masking(nest, 0)
}

fn test_avec_masking_needed() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_masking_needed_inner(&! nest)
}

fn test_avec_branch_count_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 4)
    avec_add_test_instr(nest, AVEC_OP_BRANCH_FALSE, AVEC_INVALID, 10, AVEC_INVALID, false, 0) // exit
    avec_add_test_instr(nest, AVEC_OP_BRANCH_TRUE, AVEC_INVALID, 11, AVEC_INVALID, false, 0)  // internal 1
    avec_add_test_instr(nest, AVEC_OP_BRANCH_FALSE, AVEC_INVALID, 12, AVEC_INVALID, false, 0) // internal 2
    avec_add_test_instr(nest, AVEC_OP_BINOP, 13, 20, 30, false, 0)
    let count = avec_count_branches(nest, 0)
    // 3 branches - 1 for exit = 2 internal branches
    if count != 2 { return false }
    true
}

fn test_avec_branch_count() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_branch_count_inner(&! nest)
}

// ============================================================================
// Test Category 12: SLP and Arithmetic Intensity (5 tests)
// ============================================================================

fn test_avec_packable_pair_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    // Two independent adds to different destinations
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 21, 31, false, 0)
    avec_can_pack(nest, start, start + 1)
}

fn test_avec_packable_pair() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_packable_pair_inner(&! nest)
}

fn test_avec_not_packable_dep_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    // Second instruction depends on first (src1 = dst of first)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 31, false, 0) // dep on r10
    let packable = avec_can_pack(nest, start, start + 1)
    packable == false
}

fn test_avec_not_packable_dep() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_not_packable_dep_inner(&! nest)
}

fn test_avec_packable_count_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 21, 31, false, 0)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 22, 32, false, 0)
    let count = avec_count_packable_pairs(nest, 0)
    // 3 instructions, all independent: 3 pairs (0,1), (0,2), (1,2)
    if count != 3 { return false }
    true
}

fn test_avec_packable_count() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_packable_count_inner(&! nest)
}

fn test_avec_arith_intensity_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 4)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)   // memory
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)      // arith
    avec_add_test_instr(nest, AVEC_OP_BINOP, 13, 11, 14, false, 0)      // arith
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 30, true, 1) // memory
    let intensity = avec_arithmetic_intensity(nest, 0)
    // 2 arith, 2 memory: intensity = (2 * 100) / 2 = 100
    if intensity != 100 { return false }
    true
}

fn test_avec_arith_intensity() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_arith_intensity_inner(&! nest)
}

fn test_avec_stats_new_zeroed_inner(stats: &! AvecStats) -> bool with Mut, Div, Panic {
    if stats.loops_analyzed != 0 { return false }
    if stats.loops_vectorized != 0 { return false }
    if stats.loops_rejected_deps != 0 { return false }
    if stats.loops_rejected_cost != 0 { return false }
    if stats.loops_rejected_trip != 0 { return false }
    if stats.loops_rejected_nesting != 0 { return false }
    if stats.total_reductions != 0 { return false }
    if stats.total_gathers != 0 { return false }
    if stats.total_broadcasts != 0 { return false }
    true
}

fn test_avec_stats_new_zeroed() -> bool with Mut, Div, Panic {
    var stats = avec_stats_new()
    test_avec_stats_new_zeroed_inner(&! stats)
}
