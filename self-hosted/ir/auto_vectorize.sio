}

fn test_avec_profitability_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // 100 iterations, scalar cost 3, vector cost 3, width 4
    // Total scalar = 300, total vector = 3*25 + 0 = 75 -> profitable
    let prof = avec_is_profitable(3, 3, 100, 4)
    if prof == false { return false }
    // 2 iterations too small for vectorization
    let not_prof = avec_is_profitable(3, 3, 2, 4)
    if not_prof { return false }
    true
}

