    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 10, 20, false, 0) // reduction
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 20, 30, false, 0) // not reduction
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 12, 21, false, 0) // reduction
    let count = avec_find_reductions(nest, 0)
    if count != 2 { return false }
    true
}

