// self-hosted/ir/algebra.sio
// SOIR Algebra Kind — Hypercomplex Type Universe
//
// Defines the algebraic type kind for the SOIR intermediate representation.
// Parametric Clifford(p,q) is first-class: dimension = 2^(p+q).
//
// STATUS: Translated to compilable Sounio.
//   Uses i64 tag constants (kind/match syntax not yet parser-supported).
//   Origin: Grok 4.2 spec, manually translated.
//
// References:
//   Hurwitz, "Uber die Composition der quadratischen Formen" (1898)
//   Cayley-Dickson construction: R -> C -> H -> O -> S
//   Clifford algebras: Cl(p,q), dim = 2^(p+q), always associative

// --- Algebra kind tag constants ---
let IR_ALG_REAL: i64 = 0
let IR_ALG_COMPLEX: i64 = 1
let IR_ALG_QUATERNION: i64 = 2
let IR_ALG_OCTONION: i64 = 3
let IR_ALG_SEDENION: i64 = 4
let IR_ALG_CLIFFORD: i64 = 5
// Albert algebra: exceptional Jordan algebra J₃(O), 27-dimensional.
// The unique exceptional simple Jordan algebra (Jordan-von Neumann-Wigner 1934).
// Automorphism group: F₄ (52-dim, 48 roots). Connected to E₆, E₇, E₈ via Freudenthal.
let IR_ALG_ALBERT: i64 = 6
let IR_ALG_J3O_DIM: i64 = 27        // 3 real diagonals + 3×8 octonionic off-diagonals
let IR_ALG_J3O_ZMM_COUNT: i64 = 4   // 4 ZMM registers per J₃(O) element (32 lanes, 5 unused)
let IR_ALG_J3O_F4_ROOT_COUNT: i64 = 48  // F₄ Weyl orbit (48 roots)

// Clifford parameters stored separately (p, q)
// Dimension = 2^(p+q) for Clifford; powers of 2 for Cayley-Dickson tower

fn ir_algebra_dimension(alg: i64, cl_p: i64, cl_q: i64) -> i64 with Mut {
    if alg == 0 { return 1 }        // Real
    if alg == 1 { return 2 }        // Complex
    if alg == 2 { return 4 }        // Quaternion
    if alg == 3 { return 8 }        // Octonion
    if alg == 4 { return 16 }       // Sedenion
    if alg == 5 {                    // Clifford(p,q)
        var result = 1
        var i = 0
        while i < cl_p + cl_q {
            result = result * 2
            i = i + 1
        }
        return result
    }
    return 0
}

// Hurwitz theorem: only R, C, H, O are normed division algebras over reals.
// Sedenion has zero divisors. Clifford(p,q) has zero divisors for p+q >= 2.
fn ir_is_division_algebra(alg: i64) -> bool {
    alg <= 3  // Real, Complex, Quaternion, Octonion
}

// Clifford algebras are ALWAYS associative (geometric product is associative
// by construction). Octonion is the last alternative division algebra.
// Sedenion is neither associative nor a division algebra.
fn ir_is_associative(alg: i64) -> bool {
    if alg == 0 { return true }  // Real
    if alg == 1 { return true }  // Complex
    if alg == 2 { return true }  // Quaternion (associative, not commutative)
    if alg == 3 { return false } // Octonion (alternative, NOT associative)
    if alg == 4 { return false } // Sedenion (NOT associative)
    if alg == 5 { return true }  // Clifford (ALWAYS associative)
    return false
}

fn ir_is_commutative(alg: i64, cl_p: i64, cl_q: i64) -> bool {
    if alg == 0 { return true }  // Real
    if alg == 1 { return true }  // Complex
    // Clifford(0,1) = Complex, Clifford(1,0) = split-complex (commutative)
    if alg == 5 && cl_p + cl_q <= 1 { return true }
    return false
}

fn ir_has_zero_divisors(alg: i64, cl_p: i64, cl_q: i64) -> bool {
    if alg == 4 { return true }  // Sedenion
    if alg == 5 && cl_p + cl_q >= 2 { return true }  // Clifford(p,q) for p+q >= 2
    return false
}

// ============================================================
// PHASE D: Fano-level optimization (the 168 theorem in the IR)
// ============================================================
//
// Even when the algebra is non-associative (k >= 3), SPECIFIC triples
// of basis elements may be associative if they lie on a Fano line.
// The optimizer can reassociate these triples safely.
//
// For octonions (k=3): 175 of 343 triples are associative (Fano lines).
// For sedenions (k=4): the ratio grows toward 1/2 (Corollary C).
//
// The sign function determines which triples are Fano:
//   alpha = sigma(i,j) * sigma(i^j, k)
//   beta  = sigma(j,k) * sigma(i, j^k)
//   Fano iff alpha == beta
//
// Based on: The 168 Theorem (Agourakis 2026), Theorem A + B.

fn ir_cd_sigma(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return ir_cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return ir_cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return ir_cd_sigma(a_lo, b_lo, bits - 1) }
        else { return 0 - ir_cd_sigma(a_lo, b_lo, bits - 1) }
    }
    if b_lo == 0 { return 0 - ir_cd_sigma(b_lo, a_lo, bits - 1) }
    return ir_cd_sigma(b_lo, a_lo, bits - 1)
}

// Can the optimizer reassociate basis triple (i, j, k) at tower level bits?
// Returns true if the triple is on a Fano line (associative even in non-assoc algebra).
// This is the 168 theorem used as a compiler optimization predicate.
fn alg_ir_can_reassociate_triple(bits: i64, i: i64, j: i64, k: i64) -> bool with Mut, Panic, Div {
    if bits < 3 { return true }  // R, C, H: always
    if i == 0 || j == 0 || k == 0 { return true }  // identity: Theorem D
    if i == j || j == k || i == k { return true }    // repeated: alternativity
    let alpha = ir_cd_sigma(i, j, bits) * ir_cd_sigma(i ^ j, k, bits)
    let beta = ir_cd_sigma(j, k, bits) * ir_cd_sigma(i, j ^ k, bits)
    alpha == beta  // Fano line iff signs agree
}

// Artin's theorem: in an alternative algebra (k <= 3), any subexpression
// involving at most 2 distinct variables is guaranteed associative.
// The optimizer can freely reassociate such subexpressions.
fn ir_artin_safe(alg: i64, n_distinct_vars: i64) -> bool {
    if alg <= 2 { return true }                    // always (associative)
    if alg == 3 && n_distinct_vars <= 2 { return true }  // Artin's theorem
    return false
}

// ============================================================
// Sedenion zero-divisor (ZD) infrastructure — first compiler with static ZD detection.
// Cawagas (2004): 84 primitive ZD pairs, each (a, b) with a·b = 0, a≠0, b≠0.
// arxiv:2411.18881: ZD manifold is isometric to G₂; pairs form Stiefel V₂(ℝ⁷).
//
// Representation: each element encoded as a 16-bit bitmask (bit i = component eᵢ nonzero).
// The canonical pair from de Marrais (2000): (e₃+e₁₀, e₆-e₁₅).
//   Bitmask A = (1<<3)|(1<<10) = 0x0408
//   Bitmask B = (1<<6)|(1<<15) = 0x8040
// ============================================================

let IR_SED_ZD_PAIR_COUNT: i64 = 84
// Canonical ZD pair bitmasks (de Marrais 2000 / Cawagas 2004)
let IR_SED_ZD_CANONICAL_A: i64 = 1032   // (1<<3)|(1<<10) = 8 + 1024 = 1032
let IR_SED_ZD_CANONICAL_B: i64 = 32832  // (1<<6)|(1<<15) = 64 + 32768 = 32832

// Check whether two sedenion component-presence bitmasks match the canonical ZD pair.
// Returns true if the pair is a known zero-divisor configuration.
// The type-checker calls this for literal sedenion operands; non-literal → IrSedZDCheck.
fn ir_sed_is_canonical_zd(bitmask_a: i64, bitmask_b: i64) -> bool {
    if bitmask_a == IR_SED_ZD_CANONICAL_A && bitmask_b == IR_SED_ZD_CANONICAL_B { return true }
    if bitmask_a == IR_SED_ZD_CANONICAL_B && bitmask_b == IR_SED_ZD_CANONICAL_A { return true }
    false
}

// Check whether a sedenion bitmask overlaps any ZD structure.
// Conservative: returns true if the bitmask has components in both octonion halves (0-7 and 8-15).
// Exact ZD detection requires consulting the full 84-pair table (compile-time only).
fn ir_sed_has_zd_risk(bitmask: i64) -> bool {
    let lower_half: i64 = 255        // bits 0-7
    let upper_half: i64 = 65280     // bits 8-15 (0xFF00)
    let has_lower = (bitmask & lower_half) != 0
    let has_upper = (bitmask & upper_half) != 0
    has_lower && has_upper
}

// ============================================================
// Clifford algebra grade product — first IR-level grade propagation.
// Garamon, Versor, GAL all track grade at library level; this is the first
// implementation where grade is a first-class IR attribute (IrHyperExprInfo.grade_mask).
//
// Grade selection rule for Clifford geometric product:
//   (grade-k blade) * (grade-l blade) → grades |k-l|, |k-l|+2, ..., k+l
//   Shorthand: result_grade_mask = union over (k in grade_a, l in grade_b) of
//              {|k-l|, |k-l|+2, ..., k+l}
// ============================================================

// Compute the grade_mask of the geometric product of two graded multivectors.
// grade_a, grade_b: bitfields where bit k = 1 means grade-k blades are present.
// Returns: bitmask of possible output grades (conservative union).
// max_grade: the maximum grade in the algebra (= p+q for Cl(p,q)).
pub fn ir_clifford_grade_product(grade_a: i64, grade_b: i64, max_grade: i64) -> i64 with Mut, Panic, Div {
    var result: i64 = 0
    var ka: i64 = 0
    while ka <= max_grade {
        if (grade_a >> ka) & 1 == 1 {
            var kb: i64 = 0
            while kb <= max_grade {
                if (grade_b >> kb) & 1 == 1 {
                    // Product of grade-ka and grade-kb blades → grades |ka-kb| to ka+kb, step 2
                    let lo = if ka > kb { ka - kb } else { kb - ka }
                    let hi = if ka + kb <= max_grade { ka + kb } else { max_grade }
                    var g = lo
                    while g <= hi {
                        result = result | (1 << g)
                        g = g + 2
                    }
                }
                kb = kb + 1
            }
        }
        ka = ka + 1
    }
    result
}

// Dead-grade predicate: can this hyper expression be pruned?
// Returns true iff grade_known=true and grade_mask=0 (no grades present → zero multivector).
fn ir_clifford_is_dead_grade(grade_mask: i64, grade_known: bool) -> bool {
    grade_known && grade_mask == 0
}

// Bridge: should the optimizer reassociate a multiplication triple?
// Queries the reassociation strategy and Fano predicate.
//   strategy 0 (free):           always → true
//   strategy 1 (blocked):        never → false
//   strategy 2 (fano_selective): check ir_can_reassociate_triple
fn ir_should_reassociate(strategy: i64, cd_bits: i64, i: i64, j: i64, k: i64) -> bool with Mut, Panic, Div {
    if strategy == 0 { return true }
    if strategy == 1 { return false }
    if strategy == 2 {
        return alg_ir_can_reassociate_triple(cd_bits, i, j, k)
    }
    false
}
