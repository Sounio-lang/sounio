// IR normalization for deterministic semantic equivalence checking
//
// Normalization transforms IR into canonical form for reproducible comparison:
//
// 1. Sort functions by name (alphabetically)
// 2. Renumber labels by first definition order (L0, L1, L2...)
// 3. Renumber registers by first use order (R0, R1, R2...)
// 4. Sort string table alphabetically
//
// This ensures that semantically equivalent IR from Stage 1 (Rust-compiled)
// and Stage 2 (self-hosted) produces byte-identical SOIR artifacts despite
// different compilation strategies.

// String comparison for sorting
fn name_less_than(a: Name, b: Name) -> bool with Mut, Panic, Div {
    let min_len = if a.len < b.len { a.len } else { b.len }
    var i: i64 = 0
    while i < min_len {
        if a.buf[i] < b.buf[i] {
            return true
        }
        if a.buf[i] > b.buf[i] {
            return false
        }
        i = i + 1
    }
    // Equal prefix → shorter name is less
    a.len < b.len
}

// Bubble sort for functions, in place on the module's function table.
// Takes &! IrModule rather than a by-value [IrFunction; 16384]: the table is a
// handle into arena storage, so the old signature never copied the ~23 MiB of
// IrFunction slots — but the by-value spelling invited that reading and runs
// against the hardening that moves large structural values off by-value passes.
// Sorting in place through the module reference makes the intent explicit.
// (&![T; N] on a bare array is broken in the JIT, so the reference is to the
// struct, not the array.)
fn sort_functions_by_name(module: &! IrModule) with Mut, Panic, Div {
    let count = (*module).fn_count
    var i: i64 = 0
    while i < count {
        var j: i64 = 0
        while j < count - 1 {
            let right = ir_fn_get(module, j + 1)
            let left = ir_fn_get(module, j)
            if name_less_than(right.name, left.name) {
                // Swap
                ir_fn_set(module, j, right)
                ir_fn_set(module, j + 1, left)
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Bubble sort for string table
fn sort_string_table(strings: [Name; 4096], count: i64) -> [Name; 4096] with Mut, Panic, Div {
    var sorted = strings
    var i: i64 = 0
    while i < count {
        var j: i64 = 0
        while j < count - 1 {
            if name_less_than(sorted[j + 1], sorted[j]) {
                // Swap
                let temp = sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    sorted
}

// Build label renumbering map by scanning instruction order
fn build_label_map(func: IrFunction) -> [i64; 256] with Mut, Panic, Div {
    var label_map: [i64; 256] = [IR_INVALID_LABEL; 256]
    var next_label: i64 = 0

    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))
        match instr.op {
            IrOpcode::IrLabel => {
                let old_label = instr.label_id
                if old_label >= 0 && old_label < 256 {
                    if label_map[old_label] == IR_INVALID_LABEL {
                        // First definition of this label
                        label_map[old_label] = next_label
                        next_label = next_label + 1
                    }
                }
            }
            _ => {}
        }
        i = i + 1
    }

    label_map
}

// Apply label renumbering to all instructions
fn renumber_labels(func: IrFunction, label_map: [i64; 256]) -> IrFunction with Mut, Panic, Div {
    var new_func = ir_function_clone(&func)
    var i: i64 = 0
    while i < new_func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(new_func.region, (i)))
        let old_label = instr.label_id
        let new_label = if old_label >= 0 && old_label < 256 {
            let mapped = label_map[old_label]
            if mapped != IR_INVALID_LABEL { mapped } else { old_label }
        } else {
            old_label
        }

        // Create updated instruction with new label_id
        let base = instr
        ir_arena_store(ir_region_slot_w(new_func.region, (i)), IrInstr {
            op: base.op,
            dst: base.dst,
            src1: base.src1,
            src2: base.src2,
            imm_i64: base.imm_i64,
            imm_f64: base.imm_f64,
            label_id: new_label,
            fn_id: base.fn_id,
            field_idx: base.field_idx,
            imm_flags: 0,
            bin_op: base.bin_op,
            un_op: base.un_op,
            name_id: base.name_id,
            call_args: base.call_args,
            arg_count: base.arg_count,
        })
        i = i + 1
    }
    new_func
}

// Build register renumbering map by scanning first use order
fn build_register_map(func: IrFunction) -> [i64; 1024] with Mut, Panic, Div {
    var reg_map: [i64; 1024] = [IR_INVALID_REG; 1024]
    var next_reg: i64 = 0

    // Scan all instructions
    var i: i64 = 0
    while i < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (i)))

        // Record dst register (definition)
        if instr.dst >= 0 && instr.dst < 1024 {
            if reg_map[instr.dst] == IR_INVALID_REG {
                reg_map[instr.dst] = next_reg
                next_reg = next_reg + 1
            }
        }

        // Record src1 register (use)
        if instr.src1 >= 0 && instr.src1 < 1024 {
            if reg_map[instr.src1] == IR_INVALID_REG {
                reg_map[instr.src1] = next_reg
                next_reg = next_reg + 1
            }
        }

        // Record src2 register (use)
        if instr.src2 >= 0 && instr.src2 < 1024 {
            if reg_map[instr.src2] == IR_INVALID_REG {
                reg_map[instr.src2] = next_reg
                next_reg = next_reg + 1
            }
        }

        i = i + 1
    }

    reg_map
}

// Helper to map a single register using the renumbering map
fn map_register(old_reg: i64, reg_map: [i64; 1024]) -> i64 with Mut, Panic, Div {
    if old_reg >= 0 && old_reg < 1024 {
        let mapped = reg_map[old_reg]
        if mapped != IR_INVALID_REG { mapped } else { old_reg }
    } else {
        old_reg
    }
}

// Apply register renumbering to all instructions and params
fn renumber_registers(func: IrFunction, reg_map: [i64; 1024]) -> IrFunction with Mut, Panic, Div {
    var new_func = ir_function_clone(&func)

    // Renumber param_regs
    var j: i64 = 0
    while j < 64 {
        new_func.param_regs[j] = map_register(func.param_regs[j], reg_map)
        j = j + 1
    }

    // Renumber instruction registers
    var i: i64 = 0
    while i < new_func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(new_func.region, (i)))
        let new_dst = map_register(instr.dst, reg_map)
        let new_src1 = map_register(instr.src1, reg_map)
        let new_src2 = map_register(instr.src2, reg_map)

        ir_arena_store(ir_region_slot_w(new_func.region, (i)), IrInstr {
            op: instr.op,
            dst: new_dst,
            src1: new_src1,
            src2: new_src2,
            imm_i64: instr.imm_i64,
            imm_f64: instr.imm_f64,
            label_id: instr.label_id,
            fn_id: instr.fn_id,
            field_idx: instr.field_idx,
            imm_flags: 0,
            bin_op: instr.bin_op,
            un_op: instr.un_op,
            name_id: instr.name_id,
            call_args: instr.call_args,
            arg_count: instr.arg_count,
        })
        i = i + 1
    }

    new_func
}

// Normalize a single function
fn normalize_function(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    // Step 1: Renumber labels
    let label_map = build_label_map(func)
    let func1 = renumber_labels(func, label_map)

    // Step 2: Renumber registers
    let reg_map = build_register_map(func1)
    let func2 = renumber_registers(func1, reg_map)

    func2
}

// Normalize an entire module
fn normalize_ir_module(module: IrModule) -> IrModule with Mut, Panic, Div, Alloc {
    // Step 1: Sort functions by name, in place on a mutable handle. `var m =
    // module` is a shallow copy of the struct-of-handles (the function table is
    // a handle, so this does not copy the table); sorting through &! m reorders
    // the same backing storage the old by-value path already mutated.
    var m = module
    sort_functions_by_name(&! m)

    // Step 2: Normalize directly into a fresh chunked table. Keeping a local
    // [IrFunction; IR_MAX_FUNCS] would recreate the stack pressure this storage
    // boundary is meant to remove.
    var result = ir_empty_module()
    var i: i64 = 0
    while i < m.fn_count {
        let normalized = normalize_function(ir_fn_get(&m, i))
        ir_fn_pool_ensure(&result, i)
        ir_fn_set(&! result, i, normalized)
        i = i + 1
    }

    // Step 3: Sort string table
    let sorted_strings = sort_string_table(module.string_table, module.string_count)

    result.fn_count = module.fn_count
    result.string_table = sorted_strings
    result.string_count = module.string_count
    result.epistemic = module.epistemic
    result.algebras = module.algebras
    result.prof_counters = module.prof_counters
    result.prof_counter_count = module.prof_counter_count
    result.export_names = module.export_names
    result.export_count = module.export_count
    result
}

// Compare two normalized IR modules for semantic equivalence
// Returns 0 if equivalent, non-zero if different
fn compare_normalized_ir(a: IrModule, b: IrModule) -> i64 with Mut, Panic, Div {
    // Check function counts
    if a.fn_count != b.fn_count {
        return 1
    }

    // Check string counts
    if a.string_count != b.string_count {
        return 2
    }

    // Check each function
    var i: i64 = 0
    while i < a.fn_count {
        let fa = ir_fn_get(&a, i)
        let fb = ir_fn_get(&b, i)

        // Compare function names
        if !ir_name_eq(fa.name, fb.name) {
            return 100 + i
        }

        // Compare instruction counts
        if fa.instr_count != fb.instr_count {
            return 200 + i
        }

        // Compare register/label counts
        if fa.reg_count != fb.reg_count {
            return 300 + i
        }

        if fa.label_count != fb.label_count {
            return 400 + i
        }

        // Compare param counts
        if fa.param_count != fb.param_count {
            return 500 + i
        }

        // Compare instructions (simplified — real impl would compare all fields)
        var j: i64 = 0
        while j < fa.instr_count {
            let ia = ir_arena_load(ir_region_slot_r(fa.region, (j)))
            let ib = ir_arena_load(ir_region_slot_r(fb.region, (j)))

            // Compare opcodes
            if !opcodes_equal(ia.op, ib.op) {
                return 1000 + i * 100 + j
            }

            j = j + 1
        }

        i = i + 1
    }

    // All checks passed
    0
}

// Helper to compare opcodes (enum equality)
pub fn opcodes_equal(a: IrOpcode, b: IrOpcode) -> bool {
    match a {
        IrOpcode::IrLoadImm => matches_opcode(b, IrOpcode::IrLoadImm),
        IrOpcode::IrLoadFloat => matches_opcode(b, IrOpcode::IrLoadFloat),
        IrOpcode::IrLoadBool => matches_opcode(b, IrOpcode::IrLoadBool),
        IrOpcode::IrLoadString => matches_opcode(b, IrOpcode::IrLoadString),
        IrOpcode::IrCopy => matches_opcode(b, IrOpcode::IrCopy),
        IrOpcode::IrBinOp => matches_opcode(b, IrOpcode::IrBinOp),
        IrOpcode::IrUnaryOp => matches_opcode(b, IrOpcode::IrUnaryOp),
        IrOpcode::IrCall => matches_opcode(b, IrOpcode::IrCall),
        IrOpcode::IrCallSret => matches_opcode(b, IrOpcode::IrCallSret),
        IrOpcode::IrReturn => matches_opcode(b, IrOpcode::IrReturn),
        IrOpcode::IrReturnSret => matches_opcode(b, IrOpcode::IrReturnSret),
        IrOpcode::IrJump => matches_opcode(b, IrOpcode::IrJump),
        IrOpcode::IrBranchTrue => matches_opcode(b, IrOpcode::IrBranchTrue),
        IrOpcode::IrBranchFalse => matches_opcode(b, IrOpcode::IrBranchFalse),
        IrOpcode::IrFieldGet => matches_opcode(b, IrOpcode::IrFieldGet),
        IrOpcode::IrFieldSet => matches_opcode(b, IrOpcode::IrFieldSet),
        IrOpcode::IrIndexGet => matches_opcode(b, IrOpcode::IrIndexGet),
        IrOpcode::IrIndexSet => matches_opcode(b, IrOpcode::IrIndexSet),
        IrOpcode::IrAlloc => matches_opcode(b, IrOpcode::IrAlloc),
        IrOpcode::IrLabel => matches_opcode(b, IrOpcode::IrLabel),
        IrOpcode::IrNop => matches_opcode(b, IrOpcode::IrNop),
        IrOpcode::IrPhi => matches_opcode(b, IrOpcode::IrPhi),
        IrOpcode::IrContest => matches_opcode(b, IrOpcode::IrContest),
        IrOpcode::IrProveRobust => matches_opcode(b, IrOpcode::IrProveRobust),
        IrOpcode::IrValidated => matches_opcode(b, IrOpcode::IrValidated),
        IrOpcode::IrLiftKnowledge => matches_opcode(b, IrOpcode::IrLiftKnowledge),
        IrOpcode::IrMeasure => matches_opcode(b, IrOpcode::IrMeasure),
        IrOpcode::IrObserveTransition => matches_opcode(b, IrOpcode::IrObserveTransition),
        IrOpcode::IrRollbackTransition => matches_opcode(b, IrOpcode::IrRollbackTransition),
        IrOpcode::IrDebugGuard => matches_opcode(b, IrOpcode::IrDebugGuard),
        _ => false,
    }
}

fn matches_opcode(op: IrOpcode, target: IrOpcode) -> bool {
    match op {
        IrOpcode::IrLoadImm => match target { IrOpcode::IrLoadImm => true, _ => false },
        IrOpcode::IrLoadFloat => match target { IrOpcode::IrLoadFloat => true, _ => false },
        IrOpcode::IrLoadBool => match target { IrOpcode::IrLoadBool => true, _ => false },
        IrOpcode::IrLoadString => match target { IrOpcode::IrLoadString => true, _ => false },
        IrOpcode::IrCopy => match target { IrOpcode::IrCopy => true, _ => false },
        IrOpcode::IrBinOp => match target { IrOpcode::IrBinOp => true, _ => false },
        IrOpcode::IrUnaryOp => match target { IrOpcode::IrUnaryOp => true, _ => false },
        IrOpcode::IrCall => match target { IrOpcode::IrCall => true, _ => false },
        IrOpcode::IrCallSret => match target { IrOpcode::IrCallSret => true, _ => false },
        IrOpcode::IrReturn => match target { IrOpcode::IrReturn => true, _ => false },
        IrOpcode::IrReturnSret => match target { IrOpcode::IrReturnSret => true, _ => false },
        IrOpcode::IrJump => match target { IrOpcode::IrJump => true, _ => false },
        IrOpcode::IrBranchTrue => match target { IrOpcode::IrBranchTrue => true, _ => false },
        IrOpcode::IrBranchFalse => match target { IrOpcode::IrBranchFalse => true, _ => false },
        IrOpcode::IrFieldGet => match target { IrOpcode::IrFieldGet => true, _ => false },
        IrOpcode::IrFieldSet => match target { IrOpcode::IrFieldSet => true, _ => false },
        IrOpcode::IrIndexGet => match target { IrOpcode::IrIndexGet => true, _ => false },
        IrOpcode::IrIndexSet => match target { IrOpcode::IrIndexSet => true, _ => false },
        IrOpcode::IrAlloc => match target { IrOpcode::IrAlloc => true, _ => false },
        IrOpcode::IrLabel => match target { IrOpcode::IrLabel => true, _ => false },
        IrOpcode::IrNop => match target { IrOpcode::IrNop => true, _ => false },
        IrOpcode::IrPhi => match target { IrOpcode::IrPhi => true, _ => false },
        IrOpcode::IrContest => match target { IrOpcode::IrContest => true, _ => false },
        IrOpcode::IrProveRobust => match target { IrOpcode::IrProveRobust => true, _ => false },
        IrOpcode::IrValidated => match target { IrOpcode::IrValidated => true, _ => false },
        IrOpcode::IrLiftKnowledge => match target { IrOpcode::IrLiftKnowledge => true, _ => false },
        IrOpcode::IrMeasure => match target { IrOpcode::IrMeasure => true, _ => false },
        IrOpcode::IrObserveTransition => match target { IrOpcode::IrObserveTransition => true, _ => false },
        IrOpcode::IrRollbackTransition => match target { IrOpcode::IrRollbackTransition => true, _ => false },
        IrOpcode::IrDebugGuard => match target { IrOpcode::IrDebugGuard => true, _ => false },
        _ => false,
    }
}
