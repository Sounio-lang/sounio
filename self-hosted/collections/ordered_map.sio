// self-hosted::collections::ordered_map — Insert-order-preserving associative map
//
// A flat-array map that preserves insertion order. Keys and values are i64.
// Capacity is fixed at 1024 entries. Duplicate keys update in place without
// changing insertion order. Removal shifts trailing entries to maintain order.
//
// All mutating operations consume and return the struct (state threading).

// ============================================================================
// STRUCT
// ============================================================================

struct OrderedMap {
    keys: [i64; 1024],
    values: [i64; 1024],
    count: i64,
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

fn ordered_map_new() -> OrderedMap {
    OrderedMap {
        keys: [0; 1024],
        values: [0; 1024],
        count: 0,
    }
}

// ============================================================================
// INTERNAL HELPERS
// ============================================================================
// Helpers must precede callers (no forward refs in Sounio).

// Linear scan for key. Returns index in [0, count) or -1 if absent.
fn ordered_map_find(m: OrderedMap, key: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.count {
        if m.keys[i] == key {
            return i
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// INDEX_OF — public key lookup returning position or -1
// ============================================================================

fn ordered_map_index_of(m: OrderedMap, key: i64) -> i64 with Mut, Panic, Div {
    ordered_map_find(m, key)
}

// ============================================================================
// CONTAINS
// ============================================================================

fn ordered_map_contains(m: OrderedMap, key: i64) -> bool with Mut, Panic, Div {
    let idx = ordered_map_find(m, key)
    idx >= 0
}

// ============================================================================
// GET — returns value for key, or -1 if not found
// ============================================================================

fn ordered_map_get(m: OrderedMap, key: i64) -> i64 with Mut, Panic, Div {
    let idx = ordered_map_find(m, key)
    if idx < 0 {
        return -1
    }
    m.values[idx]
}

// ============================================================================
// INSERT — append if new key, update value in place if existing
// ============================================================================

fn ordered_map_insert(m: OrderedMap, key: i64, value: i64) -> OrderedMap with Mut, Panic, Div {
    var map = m

    // Check if key already exists
    let idx = ordered_map_find(map, key)
    if idx >= 0 {
        // Update existing entry — insertion order unchanged
        map.values[idx] = value
        return map
    }

    // Append new entry if capacity allows
    if map.count < 1024 {
        map.keys[map.count] = key
        map.values[map.count] = value
        map.count = map.count + 1
    }
    map
}

// ============================================================================
// REMOVE — shift trailing entries left to preserve order
// ============================================================================

fn ordered_map_remove(m: OrderedMap, key: i64) -> OrderedMap with Mut, Panic, Div {
    var map = m
    let idx = ordered_map_find(map, key)
    if idx < 0 {
        // Key not found, return unchanged
        return map
    }

    // Shift entries [idx+1 .. count) one position left
    var i: i64 = idx
    while i < map.count - 1 {
        map.keys[i] = map.keys[i + 1]
        map.values[i] = map.values[i + 1]
        i = i + 1
    }

    // Clear the now-unused last slot and decrement count
    map.keys[map.count - 1] = 0
    map.values[map.count - 1] = 0
    map.count = map.count - 1
    map
}

// ============================================================================
// LEN
// ============================================================================

fn ordered_map_len(m: OrderedMap) -> i64 {
    m.count
}

// ============================================================================
// KEY_AT / VALUE_AT — positional access by insertion order
// ============================================================================

// Returns the key at the given index, or -1 if out of bounds.
fn ordered_map_key_at(m: OrderedMap, index: i64) -> i64 with Panic, Div {
    if index < 0 || index >= m.count {
        return -1
    }
    m.keys[index]
}

// Returns the value at the given index, or -1 if out of bounds.
fn ordered_map_value_at(m: OrderedMap, index: i64) -> i64 with Panic, Div {
    if index < 0 || index >= m.count {
        return -1
    }
    m.values[index]
}

// ============================================================================
// CLEAR — reset to empty, preserving the struct
// ============================================================================

fn ordered_map_clear(m: OrderedMap) -> OrderedMap with Mut, Panic, Div {
    var map = m
    var i: i64 = 0
    while i < map.count {
        map.keys[i] = 0
        map.values[i] = 0
        i = i + 1
    }
    map.count = 0
    map
}

// ============================================================================
// TESTS
// ============================================================================

fn test_ordered_map_new() -> bool {
    let m = ordered_map_new()
    ordered_map_len(m) == 0
}

fn test_ordered_map_insert_and_get() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 10, 100)
    m = ordered_map_insert(m, 20, 200)
    m = ordered_map_insert(m, 30, 300)

    let ok1 = ordered_map_get(m, 10) == 100
    let ok2 = ordered_map_get(m, 20) == 200
    let ok3 = ordered_map_get(m, 30) == 300
    let ok4 = ordered_map_len(m) == 3
    ok1 && ok2 && ok3 && ok4
}

fn test_ordered_map_insert_updates_existing() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 10, 100)
    m = ordered_map_insert(m, 20, 200)
    m = ordered_map_insert(m, 10, 999)

    // Value updated, count unchanged, order preserved
    let ok1 = ordered_map_get(m, 10) == 999
    let ok2 = ordered_map_len(m) == 2
    let ok3 = ordered_map_key_at(m, 0) == 10
    let ok4 = ordered_map_key_at(m, 1) == 20
    ok1 && ok2 && ok3 && ok4
}

fn test_ordered_map_get_missing() -> bool with Mut, Panic, Div {
    let m = ordered_map_new()
    ordered_map_get(m, 42) == -1
}

fn test_ordered_map_contains() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 7, 77)

    let ok1 = ordered_map_contains(m, 7)
    let ok2 = !ordered_map_contains(m, 8)
    ok1 && ok2
}

fn test_ordered_map_remove() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_insert(m, 3, 30)

    m = ordered_map_remove(m, 2)

    let ok1 = ordered_map_len(m) == 2
    let ok2 = ordered_map_get(m, 2) == -1
    // Order preserved: [1, 3]
    let ok3 = ordered_map_key_at(m, 0) == 1
    let ok4 = ordered_map_key_at(m, 1) == 3
    let ok5 = ordered_map_value_at(m, 0) == 10
    let ok6 = ordered_map_value_at(m, 1) == 30
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}

fn test_ordered_map_remove_missing() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 5, 50)
    m = ordered_map_remove(m, 99)
    ordered_map_len(m) == 1
}

fn test_ordered_map_remove_first() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_insert(m, 3, 30)

    m = ordered_map_remove(m, 1)

    let ok1 = ordered_map_len(m) == 2
    let ok2 = ordered_map_key_at(m, 0) == 2
    let ok3 = ordered_map_key_at(m, 1) == 3
    ok1 && ok2 && ok3
}

fn test_ordered_map_remove_last() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_insert(m, 3, 30)

    m = ordered_map_remove(m, 3)

    let ok1 = ordered_map_len(m) == 2
    let ok2 = ordered_map_key_at(m, 0) == 1
    let ok3 = ordered_map_key_at(m, 1) == 2
    ok1 && ok2 && ok3
}

fn test_ordered_map_key_at_and_value_at() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 42, 420)
    m = ordered_map_insert(m, 99, 990)

    let ok1 = ordered_map_key_at(m, 0) == 42
    let ok2 = ordered_map_value_at(m, 0) == 420
    let ok3 = ordered_map_key_at(m, 1) == 99
    let ok4 = ordered_map_value_at(m, 1) == 990
    // Out of bounds
    let ok5 = ordered_map_key_at(m, 2) == -1
    let ok6 = ordered_map_value_at(m, -1) == -1
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}

fn test_ordered_map_clear() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_insert(m, 3, 30)

    m = ordered_map_clear(m)

    let ok1 = ordered_map_len(m) == 0
    let ok2 = ordered_map_get(m, 1) == -1
    let ok3 = !ordered_map_contains(m, 2)
    ok1 && ok2 && ok3
}

fn test_ordered_map_index_of() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 100, 1)
    m = ordered_map_insert(m, 200, 2)
    m = ordered_map_insert(m, 300, 3)

    let ok1 = ordered_map_index_of(m, 100) == 0
    let ok2 = ordered_map_index_of(m, 200) == 1
    let ok3 = ordered_map_index_of(m, 300) == 2
    let ok4 = ordered_map_index_of(m, 999) == -1
    ok1 && ok2 && ok3 && ok4
}

fn test_ordered_map_insert_after_remove() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_remove(m, 1)
    m = ordered_map_insert(m, 3, 30)

    // Order should be: [2, 3]
    let ok1 = ordered_map_len(m) == 2
    let ok2 = ordered_map_key_at(m, 0) == 2
    let ok3 = ordered_map_key_at(m, 1) == 3
    ok1 && ok2 && ok3
}

fn test_ordered_map_reinsert_removed_key() -> bool with Mut, Panic, Div {
    var m = ordered_map_new()
    m = ordered_map_insert(m, 1, 10)
    m = ordered_map_insert(m, 2, 20)
    m = ordered_map_remove(m, 1)
    m = ordered_map_insert(m, 1, 99)

    // Re-inserted key goes to end: [2, 1]
    let ok1 = ordered_map_len(m) == 2
    let ok2 = ordered_map_key_at(m, 0) == 2
    let ok3 = ordered_map_key_at(m, 1) == 1
    let ok4 = ordered_map_get(m, 1) == 99
    ok1 && ok2 && ok3 && ok4
}
