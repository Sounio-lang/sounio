// Self-hosted LLVM FFI constant validation tests
//
// Validates that all integer constants in ffi.sio match the LLVM-C headers.
// No FFI calls — pure constant checks only.

// ── LLVMIntPredicate ────────────────────────────────────────────────

fn llvm_ffi_test_01_int_eq() -> bool {
    LLVM_INT_EQ == 32
}

fn llvm_ffi_test_02_int_ne() -> bool {
    LLVM_INT_NE == 33
}

fn llvm_ffi_test_03_int_ugt() -> bool {
    LLVM_INT_UGT == 34
}

fn llvm_ffi_test_04_int_uge() -> bool {
    LLVM_INT_UGE == 35
}

fn llvm_ffi_test_05_int_ult() -> bool {
    LLVM_INT_ULT == 36
}

fn llvm_ffi_test_06_int_ule() -> bool {
    LLVM_INT_ULE == 37
}

fn llvm_ffi_test_07_int_sgt() -> bool {
    LLVM_INT_SGT == 38
}

fn llvm_ffi_test_08_int_sge() -> bool {
    LLVM_INT_SGE == 39
}

fn llvm_ffi_test_09_int_slt() -> bool {
    LLVM_INT_SLT == 40
}

fn llvm_ffi_test_10_int_sle() -> bool {
    LLVM_INT_SLE == 41
}

// ── LLVMRealPredicate ───────────────────────────────────────────────

fn llvm_ffi_test_11_real_oeq() -> bool {
    LLVM_REAL_OEQ == 1
}

fn llvm_ffi_test_12_real_ogt() -> bool {
    LLVM_REAL_OGT == 2
}

fn llvm_ffi_test_13_real_oge() -> bool {
    LLVM_REAL_OGE == 3
}

fn llvm_ffi_test_14_real_olt() -> bool {
    LLVM_REAL_OLT == 4
}

fn llvm_ffi_test_15_real_ole() -> bool {
    LLVM_REAL_OLE == 5
}

fn llvm_ffi_test_16_real_one() -> bool {
    LLVM_REAL_ONE == 6
}

fn llvm_ffi_test_17_real_uno() -> bool {
    LLVM_REAL_UNO == 8
}

fn llvm_ffi_test_18_real_ueq() -> bool {
    LLVM_REAL_UEQ == 9
}

fn llvm_ffi_test_19_real_une() -> bool {
    LLVM_REAL_UNE == 14
}

// ── LLVMCodeGenOptLevel ─────────────────────────────────────────────

fn llvm_ffi_test_20_opt_none() -> bool {
    LLVM_CODEGEN_OPT_NONE == 0
}

fn llvm_ffi_test_21_opt_less() -> bool {
    LLVM_CODEGEN_OPT_LESS == 1
}

fn llvm_ffi_test_22_opt_default() -> bool {
    LLVM_CODEGEN_OPT_DEFAULT == 2
}

fn llvm_ffi_test_23_opt_aggressive() -> bool {
    LLVM_CODEGEN_OPT_AGGRESSIVE == 3
}

// ── LLVMRelocMode ───────────────────────────────────────────────────

fn llvm_ffi_test_24_reloc_default() -> bool {
    LLVM_RELOC_DEFAULT == 0
}

fn llvm_ffi_test_25_reloc_pic() -> bool {
    LLVM_RELOC_PIC == 2
}

fn llvm_ffi_test_26_reloc_ropi_rwpi() -> bool {
    LLVM_RELOC_ROPI_RWPI == 6
}

// ── LLVMCodeModel ───────────────────────────────────────────────────

fn llvm_ffi_test_27_code_model_default() -> bool {
    LLVM_CODE_MODEL_DEFAULT == 0
}

fn llvm_ffi_test_28_code_model_jit() -> bool {
    LLVM_CODE_MODEL_JIT == 1
}

fn llvm_ffi_test_29_code_model_tiny() -> bool {
    LLVM_CODE_MODEL_TINY == 2
}

fn llvm_ffi_test_30_code_model_large() -> bool {
    LLVM_CODE_MODEL_LARGE == 6
}

// ── LLVMCodeGenFileType ─────────────────────────────────────────────

fn llvm_ffi_test_31_assembly_file() -> bool {
    LLVM_ASSEMBLY_FILE == 0
}

fn llvm_ffi_test_32_object_file() -> bool {
    LLVM_OBJECT_FILE == 1
}

// ── LLVMLinkage ─────────────────────────────────────────────────────

fn llvm_ffi_test_33_external_linkage() -> bool {
    LLVM_EXTERNAL_LINKAGE == 0
}

fn llvm_ffi_test_34_internal_linkage() -> bool {
    LLVM_INTERNAL_LINKAGE == 8
}

fn llvm_ffi_test_35_private_linkage() -> bool {
    LLVM_PRIVATE_LINKAGE == 9
}

// ── LLVMCallConv ────────────────────────────────────────────────────

fn llvm_ffi_test_36_c_call_conv() -> bool {
    LLVM_C_CALL_CONV == 0
}

fn llvm_ffi_test_37_fast_call_conv() -> bool {
    LLVM_FAST_CALL_CONV == 8
}

fn llvm_ffi_test_38_cold_call_conv() -> bool {
    LLVM_COLD_CALL_CONV == 9
}

// ── LLVMUnnamedAddr ─────────────────────────────────────────────────

fn llvm_ffi_test_39_no_unnamed_addr() -> bool {
    LLVM_NO_UNNAMED_ADDR == 0
}

fn llvm_ffi_test_40_global_unnamed_addr() -> bool {
    LLVM_GLOBAL_UNNAMED_ADDR == 2
}

// ── LLVMVerifierFailureAction ───────────────────────────────────────

fn llvm_ffi_test_41_abort_process() -> bool {
    LLVM_ABORT_PROCESS_ACTION == 0
}

fn llvm_ffi_test_42_return_status() -> bool {
    LLVM_RETURN_STATUS_ACTION == 2
}

// ── DWARF ───────────────────────────────────────────────────────────

fn llvm_ffi_test_43_dwarf_lang_c() -> bool {
    LLVM_DWARF_SOURCE_LANGUAGE_C == 0
}

fn llvm_ffi_test_44_dwarf_lang_c99() -> bool {
    LLVM_DWARF_SOURCE_LANGUAGE_C99 == 12
}

fn llvm_ffi_test_45_dwarf_emission_full() -> bool {
    LLVM_DWARF_EMISSION_FULL == 1
}

// ── Self-consistency checks ─────────────────────────────────────────

fn llvm_ffi_test_46_int_pred_range() -> bool {
    // 10 predicates: EQ(32) through SLE(41)
    LLVM_INT_SLE - LLVM_INT_EQ == 9
}

fn llvm_ffi_test_47_int_sgt_gt_eq() -> bool {
    LLVM_INT_SGT > LLVM_INT_EQ
}

fn llvm_ffi_test_48_opt_levels_consecutive() -> bool {
    LLVM_CODEGEN_OPT_LESS == LLVM_CODEGEN_OPT_NONE + 1 &&
    LLVM_CODEGEN_OPT_DEFAULT == LLVM_CODEGEN_OPT_NONE + 2 &&
    LLVM_CODEGEN_OPT_AGGRESSIVE == LLVM_CODEGEN_OPT_NONE + 3
}

fn llvm_ffi_test_49_linkage_ordering() -> bool {
    LLVM_EXTERNAL_LINKAGE < LLVM_INTERNAL_LINKAGE &&
    LLVM_INTERNAL_LINKAGE < LLVM_PRIVATE_LINKAGE
}

fn llvm_ffi_test_50_real_oeq_lt_une() -> bool {
    LLVM_REAL_OEQ < LLVM_REAL_UNE
}

fn llvm_ffi_test_51_assembly_before_object() -> bool {
    LLVM_ASSEMBLY_FILE < LLVM_OBJECT_FILE
}

fn llvm_ffi_test_52_code_model_range() -> bool {
    LLVM_CODE_MODEL_DEFAULT == 0 &&
    LLVM_CODE_MODEL_LARGE == 6 &&
    LLVM_CODE_MODEL_LARGE > LLVM_CODE_MODEL_TINY
}

fn llvm_ffi_test_53_callconv_ordering() -> bool {
    LLVM_C_CALL_CONV < LLVM_FAST_CALL_CONV &&
    LLVM_FAST_CALL_CONV < LLVM_COLD_CALL_CONV
}

fn llvm_ffi_test_54_real_gap_at_7() -> bool {
    // LLVMRealPredicate skips value 7 (no LLVM_REAL_ORD = 7)
    LLVM_REAL_ONE == 6 && LLVM_REAL_UNO == 8
}

fn llvm_ffi_test_55_dwarf_c99_gt_c() -> bool {
    LLVM_DWARF_SOURCE_LANGUAGE_C99 > LLVM_DWARF_SOURCE_LANGUAGE_C
}

// ── Runner ──────────────────────────────────────────────────────────

fn run_llvm_ffi_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== LLVM FFI Constant Tests ===\n")

    total = total + 1
    if llvm_ffi_test_01_int_eq() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 INT_EQ\n") }
    total = total + 1
    if llvm_ffi_test_02_int_ne() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02 INT_NE\n") }
    total = total + 1
    if llvm_ffi_test_03_int_ugt() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03 INT_UGT\n") }
    total = total + 1
    if llvm_ffi_test_04_int_uge() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04 INT_UGE\n") }
    total = total + 1
    if llvm_ffi_test_05_int_ult() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 INT_ULT\n") }
    total = total + 1
    if llvm_ffi_test_06_int_ule() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 INT_ULE\n") }
    total = total + 1
    if llvm_ffi_test_07_int_sgt() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 INT_SGT\n") }
    total = total + 1
    if llvm_ffi_test_08_int_sge() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 INT_SGE\n") }
    total = total + 1
    if llvm_ffi_test_09_int_slt() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 INT_SLT\n") }
    total = total + 1
    if llvm_ffi_test_10_int_sle() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 INT_SLE\n") }

    total = total + 1
    if llvm_ffi_test_11_real_oeq() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 REAL_OEQ\n") }
    total = total + 1
    if llvm_ffi_test_12_real_ogt() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 REAL_OGT\n") }
    total = total + 1
    if llvm_ffi_test_13_real_oge() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 REAL_OGE\n") }
    total = total + 1
    if llvm_ffi_test_14_real_olt() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14 REAL_OLT\n") }
    total = total + 1
    if llvm_ffi_test_15_real_ole() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15 REAL_OLE\n") }
    total = total + 1
    if llvm_ffi_test_16_real_one() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16 REAL_ONE\n") }
    total = total + 1
    if llvm_ffi_test_17_real_uno() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 REAL_UNO\n") }
    total = total + 1
    if llvm_ffi_test_18_real_ueq() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 REAL_UEQ\n") }
    total = total + 1
    if llvm_ffi_test_19_real_une() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 REAL_UNE\n") }

    total = total + 1
    if llvm_ffi_test_20_opt_none() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20 OPT_NONE\n") }
    total = total + 1
    if llvm_ffi_test_21_opt_less() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21 OPT_LESS\n") }
    total = total + 1
    if llvm_ffi_test_22_opt_default() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22 OPT_DEFAULT\n") }
    total = total + 1
    if llvm_ffi_test_23_opt_aggressive() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23 OPT_AGGRESSIVE\n") }

    total = total + 1
    if llvm_ffi_test_24_reloc_default() { passed = passed + 1; print("  T24 OK\n") } else { print("  FAIL T24 RELOC_DEFAULT\n") }
    total = total + 1
    if llvm_ffi_test_25_reloc_pic() { passed = passed + 1; print("  T25 OK\n") } else { print("  FAIL T25 RELOC_PIC\n") }
    total = total + 1
    if llvm_ffi_test_26_reloc_ropi_rwpi() { passed = passed + 1; print("  T26 OK\n") } else { print("  FAIL T26 RELOC_ROPI_RWPI\n") }

    total = total + 1
    if llvm_ffi_test_27_code_model_default() { passed = passed + 1; print("  T27 OK\n") } else { print("  FAIL T27 CODE_MODEL_DEFAULT\n") }
    total = total + 1
    if llvm_ffi_test_28_code_model_jit() { passed = passed + 1; print("  T28 OK\n") } else { print("  FAIL T28 CODE_MODEL_JIT\n") }
    total = total + 1
    if llvm_ffi_test_29_code_model_tiny() { passed = passed + 1; print("  T29 OK\n") } else { print("  FAIL T29 CODE_MODEL_TINY\n") }
    total = total + 1
    if llvm_ffi_test_30_code_model_large() { passed = passed + 1; print("  T30 OK\n") } else { print("  FAIL T30 CODE_MODEL_LARGE\n") }

    total = total + 1
    if llvm_ffi_test_31_assembly_file() { passed = passed + 1; print("  T31 OK\n") } else { print("  FAIL T31 ASSEMBLY_FILE\n") }
    total = total + 1
    if llvm_ffi_test_32_object_file() { passed = passed + 1; print("  T32 OK\n") } else { print("  FAIL T32 OBJECT_FILE\n") }

    total = total + 1
    if llvm_ffi_test_33_external_linkage() { passed = passed + 1; print("  T33 OK\n") } else { print("  FAIL T33 EXTERNAL_LINKAGE\n") }
    total = total + 1
    if llvm_ffi_test_34_internal_linkage() { passed = passed + 1; print("  T34 OK\n") } else { print("  FAIL T34 INTERNAL_LINKAGE\n") }
    total = total + 1
    if llvm_ffi_test_35_private_linkage() { passed = passed + 1; print("  T35 OK\n") } else { print("  FAIL T35 PRIVATE_LINKAGE\n") }

    total = total + 1
    if llvm_ffi_test_36_c_call_conv() { passed = passed + 1; print("  T36 OK\n") } else { print("  FAIL T36 C_CALL_CONV\n") }
    total = total + 1
    if llvm_ffi_test_37_fast_call_conv() { passed = passed + 1; print("  T37 OK\n") } else { print("  FAIL T37 FAST_CALL_CONV\n") }
    total = total + 1
    if llvm_ffi_test_38_cold_call_conv() { passed = passed + 1; print("  T38 OK\n") } else { print("  FAIL T38 COLD_CALL_CONV\n") }

    total = total + 1
    if llvm_ffi_test_39_no_unnamed_addr() { passed = passed + 1; print("  T39 OK\n") } else { print("  FAIL T39 NO_UNNAMED_ADDR\n") }
    total = total + 1
    if llvm_ffi_test_40_global_unnamed_addr() { passed = passed + 1; print("  T40 OK\n") } else { print("  FAIL T40 GLOBAL_UNNAMED_ADDR\n") }

    total = total + 1
    if llvm_ffi_test_41_abort_process() { passed = passed + 1; print("  T41 OK\n") } else { print("  FAIL T41 ABORT_PROCESS\n") }
    total = total + 1
    if llvm_ffi_test_42_return_status() { passed = passed + 1; print("  T42 OK\n") } else { print("  FAIL T42 RETURN_STATUS\n") }

    total = total + 1
    if llvm_ffi_test_43_dwarf_lang_c() { passed = passed + 1; print("  T43 OK\n") } else { print("  FAIL T43 DWARF_C\n") }
    total = total + 1
    if llvm_ffi_test_44_dwarf_lang_c99() { passed = passed + 1; print("  T44 OK\n") } else { print("  FAIL T44 DWARF_C99\n") }
    total = total + 1
    if llvm_ffi_test_45_dwarf_emission_full() { passed = passed + 1; print("  T45 OK\n") } else { print("  FAIL T45 DWARF_FULL\n") }

    total = total + 1
    if llvm_ffi_test_46_int_pred_range() { passed = passed + 1; print("  T46 OK\n") } else { print("  FAIL T46 pred range\n") }
    total = total + 1
    if llvm_ffi_test_47_int_sgt_gt_eq() { passed = passed + 1; print("  T47 OK\n") } else { print("  FAIL T47 SGT>EQ\n") }
    total = total + 1
    if llvm_ffi_test_48_opt_levels_consecutive() { passed = passed + 1; print("  T48 OK\n") } else { print("  FAIL T48 opt consecutive\n") }
    total = total + 1
    if llvm_ffi_test_49_linkage_ordering() { passed = passed + 1; print("  T49 OK\n") } else { print("  FAIL T49 linkage order\n") }
    total = total + 1
    if llvm_ffi_test_50_real_oeq_lt_une() { passed = passed + 1; print("  T50 OK\n") } else { print("  FAIL T50 OEQ<UNE\n") }
    total = total + 1
    if llvm_ffi_test_51_assembly_before_object() { passed = passed + 1; print("  T51 OK\n") } else { print("  FAIL T51 asm<obj\n") }
    total = total + 1
    if llvm_ffi_test_52_code_model_range() { passed = passed + 1; print("  T52 OK\n") } else { print("  FAIL T52 model range\n") }
    total = total + 1
    if llvm_ffi_test_53_callconv_ordering() { passed = passed + 1; print("  T53 OK\n") } else { print("  FAIL T53 cc order\n") }
    total = total + 1
    if llvm_ffi_test_54_real_gap_at_7() { passed = passed + 1; print("  T54 OK\n") } else { print("  FAIL T54 gap@7\n") }
    total = total + 1
    if llvm_ffi_test_55_dwarf_c99_gt_c() { passed = passed + 1; print("  T55 OK\n") } else { print("  FAIL T55 C99>C\n") }

    if passed == total {
        print("LLVM FFI: all 55 passed\n")
    } else {
        print("LLVM FFI: FAILED\n")
    }
    if passed == total { 0 } else { 1 }
}
