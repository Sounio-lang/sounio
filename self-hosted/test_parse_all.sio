    if index == 0 { "self-hosted/check/mod.sio" }
    else if index == 1 { "self-hosted/emit/mod.sio" }
    else if index == 2 { "self-hosted/resolve/mod.sio" }
    else if index == 3 { "self-hosted/lexer/errors.sio" }
    else if index == 4 { "self-hosted/native/mod.sio" }
    else if index == 5 { "self-hosted/lexer/span.sio" }
    else if index == 6 { "self-hosted/check/env.sio" }
    else if index == 7 { "self-hosted/resolve/symbol.sio" }
    else if index == 8 { "self-hosted/resolve/scope.sio" }
    else { "" }
}

