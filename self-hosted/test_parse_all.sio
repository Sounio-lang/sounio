// self-hosted::test_parse_all — Parse self-hosted .sio files from disk
//
// The default suite remains a curated corpus so full self-hosted test runs stay
// bounded. Additional full-corpus + sharding helpers are exposed for multi-pass
// parse coverage.
//
// File ordering is deterministic and based on:
//   find self-hosted/ -name "*.sio" -type f | sort

struct ParseChecked {
    item_count: i64,
    parse_error_count: i64,
}

fn structural_scan_file(path: string) -> bool with IO, Mut, Panic, Div {
    let scan_cap: i64 = 1024
    let size = file_size(path)
    if size < 0 {
        return false
    }
    if size == 0 {
        return true
    }

    let target_scan_size = if size > scan_cap { scan_cap } else { size }
    let data = read_file(path)
    let scan_size = target_scan_size
    let truncated = scan_size < size
    var i: i64 = 0
    var paren_depth: i64 = 0
    var brace_depth: i64 = 0
    var bracket_depth: i64 = 0
    var block_comment_depth: i64 = 0
    var in_line_comment: bool = false
    var in_string: bool = false
    var in_char: bool = false
    var escaped: bool = false

    while i < scan_size {
        let b = data[i as usize]
        let has_next = i + 1 < scan_size
        let next = if has_next { data[(i + 1) as usize] } else { 0 }

        if in_line_comment {
            if b == 10 {
                in_line_comment = false
            }
            i = i + 1
            continue
        }

        if block_comment_depth > 0 {
            if b == 47 && next == 42 {  // /*
                block_comment_depth = block_comment_depth + 1
                i = i + 2
                continue
            }
            if b == 42 && next == 47 {  // */
                block_comment_depth = block_comment_depth - 1
                i = i + 2
                continue
            }
            i = i + 1
            continue
        }

        if in_string {
            if escaped {
                escaped = false
            } else if b == 92 {  // '\'
                escaped = true
            } else if b == 34 {  // '"'
                in_string = false
            }
            i = i + 1
            continue
        }

        if in_char {
            if escaped {
                escaped = false
            } else if b == 92 {  // '\'
                escaped = true
            } else if b == 39 {  // '\''
                in_char = false
            }
            i = i + 1
            continue
        }

        if b == 47 && next == 47 {  // //
            in_line_comment = true
            i = i + 2
            continue
        }
        if b == 47 && next == 42 {  // /*
            block_comment_depth = 1
            i = i + 2
            continue
        }
        if b == 34 {  // "
            in_string = true
            i = i + 1
            continue
        }
        if b == 39 {  // '
            in_char = true
            i = i + 1
            continue
        }

        if b == 40 {  // (
            paren_depth = paren_depth + 1
        } else if b == 41 {  // )
            paren_depth = paren_depth - 1
            if paren_depth < 0 { return false }
        } else if b == 123 {  // {
            brace_depth = brace_depth + 1
        } else if b == 125 {  // }
            brace_depth = brace_depth - 1
            if brace_depth < 0 { return false }
        } else if b == 91 {  // [
            bracket_depth = bracket_depth + 1
        } else if b == 93 {  // ]
            bracket_depth = bracket_depth - 1
            if bracket_depth < 0 { return false }
        }

        i = i + 1
    }

    if truncated {
        // Prefix scan mode for very large files: reject only structural
        // underflow discovered in the scanned prefix.
        true
    } else {
        !in_string && !in_char &&
        !in_line_comment && block_comment_depth == 0 &&
        paren_depth == 0 && brace_depth == 0 && bracket_depth == 0
    }
}

fn parse_program_checked(token_count: i64, item_limit: i64) -> ParseChecked with Mut, IO, Panic, Div, Alloc {
    var p = parser_new()
    var forced_skips: i64 = 0

    // Tokens are already preloaded into parser globals by lex().
    p.token_count = token_count

    // Full-corpus shard sweeps can run in metadata-only mode for throughput.
    if item_limit == -1 {
        return ParseChecked {
            item_count: if token_count > 0 { 1 } else { 0 },
            parse_error_count: 0,
        }
    }

    // Full-corpus fast parser mode: skip block bodies but still parse item
    // headers/signatures and top-level structure.
    let fast_skip_blocks = item_limit == -2
    parser_set_fast_skip_blocks(fast_skip_blocks)

    // Skip leading newlines
    while p.peek() == TokenKind::Newline {
        p = p.advance_raw()
    }

    // Parse items until EOF.
    // We only need parse success + item count for this suite, so avoid
    // constructing and repeatedly appending full item lists.
    var item_count: i64 = 0

    while !p.at_eof() {
        if item_limit > 0 && item_count >= item_limit {
            break
        }

        // Skip doc comments for now (attach to next item in future)
        while tk_is_doc_comment(p.peek()) {
            p = p.advance()
        }

        if p.at_eof() { break }

        let pos_before = p.pos
        let errors_before = p.error_count
        let result = p.parse_item()
        let p2 = result.0
        let _item = result.1
        p = p2

        if p.error_count > errors_before && p.error_count <= 20 {
            print("parse item error at line ")
            if pos_before >= 0 && pos_before < 1048576 {
                print_int(PT_LINE[pos_before as usize])
                print(":")
                print_int(PT_COL[pos_before as usize])
                print(" kind=")
                print_int(PT_KIND_CODE[pos_before as usize])
                print("\n")
            } else {
                print("unknown\n")
            }
            print("parse item ended at line ")
            if p.pos >= 0 && p.pos < 1048576 {
                print_int(PT_LINE[p.pos as usize])
                print(":")
                print_int(PT_COL[p.pos as usize])
                print(" kind=")
                print_int(PT_KIND_CODE[p.pos as usize])
                print("\n")
            } else {
                print("unknown\n")
            }
        }

        // Safety guard: if parser made no progress, force one-token advance
        // so this suite cannot loop forever on malformed constructs.
        if p.pos <= pos_before {
            forced_skips = forced_skips + 1
            if forced_skips <= 20 {
                print("parse forced skip at line ")
                if p.pos >= 0 && p.pos < 1048576 {
                    print_int(PT_LINE[p.pos as usize])
                    print(":")
                    print_int(PT_COL[p.pos as usize])
                    print(" kind=")
                    print_int(PT_KIND_CODE[p.pos as usize])
                    print("\n")
                } else {
                    print("unknown\n")
                }
            }
            if !p.at_eof() {
                p = p.advance_raw()
            } else {
                break
            }
        }

        item_count = item_count + 1
    }

    parser_set_fast_skip_blocks(false)

    ParseChecked {
        item_count: item_count,
        parse_error_count: p.error_count + forced_skips,
    }
}

fn test_parse_file_str(path: string, parse_item_limit: i64) -> bool with IO, Mut, Div, Panic, Alloc {
    print("  PARSE FILE: ")
    print(path)
    print("\n")

    let size = file_size(path)

    if size < 0 {
        print("  FAIL (missing): ")
        print(path)
        print("\n")
        return false
    }

    if size == 0 {
        // Empty file is OK.
        return true
    }

    if parse_item_limit == -1 {
        // Full-corpus metadata-only mode.
        return true
    }

    if parse_item_limit == -3 {
        // Full-corpus structural scan mode (balanced delimiters + string/comment
        // closure) for high-throughput validation.
        return structural_scan_file(path)
    }

    let token_count = lex_file_to_globals(path)
    let lex_ok = token_count > 0

    let parsed = parse_program_checked(token_count, parse_item_limit)
    let ic = parsed.item_count

    let ok = lex_ok && parsed.parse_error_count == 0 && ic > 0

    if !ok {
        print("  FAIL: ")
        print(path)
        print(" (")
        print_int(ic)
        print(" items, ")
        print_int(parsed.parse_error_count)
        print(" parse errors)\n")
    }

    ok
}

