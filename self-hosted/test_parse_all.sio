fn parse_all_total(corpus_mode: i64) -> i64 {
    if corpus_mode == 0 { parse_all_curated_total() } else { parse_all_full_total() }
}

fn parse_all_path(corpus_mode: i64, index: i64) -> string {
    if corpus_mode == 0 { parse_all_curated_path(index) } else { parse_all_full_path(index) }
}

fn parse_all_shard_mode_mod() -> i64 {
    0
}

fn parse_all_shard_mode_balanced() -> i64 {
    1
}

fn parse_all_shard_mode_label(shard_mode: i64) -> string {
    if shard_mode == parse_all_shard_mode_balanced() { "balanced" } else { "mod" }
}

fn parse_all_shard_mode_valid(shard_mode: i64) -> bool {
    shard_mode == parse_all_shard_mode_mod() || shard_mode == parse_all_shard_mode_balanced()
}

fn parse_all_file_weight(corpus_mode: i64, index: i64) -> i64 with IO, Div {
    let path = parse_all_path(corpus_mode, index)
    if str_len(path) <= 0 {
        return 1
    }

    let size = file_size(path)
    if size <= 0 { 1 } else { size }
}

var PARSE_ALL_BALANCED_CACHE_CORPUS: i64 = -1
var PARSE_ALL_BALANCED_CACHE_SHARDS: i64 = -1
var PARSE_ALL_BALANCED_CACHE_TOTAL: i64 = 0
var PARSE_ALL_BALANCED_CACHE_ASSIGN: [i64; 128] = [0; 128]

fn parse_all_rebuild_balanced_cache(corpus_mode: i64, shard_count: i64) -> i64 with IO, Mut, Panic, Div {
    let total = parse_all_total(corpus_mode)
    var capped_total: i64 = total
    if capped_total > 128 {
        capped_total = 128
    }

    PARSE_ALL_BALANCED_CACHE_CORPUS = corpus_mode
    PARSE_ALL_BALANCED_CACHE_SHARDS = shard_count
    PARSE_ALL_BALANCED_CACHE_TOTAL = capped_total

    var i: i64 = 0
    while i < 128 {
        PARSE_ALL_BALANCED_CACHE_ASSIGN[i as usize] = 0
        i = i + 1
    }

    if shard_count <= 0 || capped_total <= 0 {
        return 0
    }

    var weights: [i64; 128] = [0; 128]
    var order: [i64; 128] = [0; 128]
    var loads: [i64; 128] = [0; 128]

    i = 0
    while i < capped_total {
        weights[i as usize] = parse_all_file_weight(corpus_mode, i)
        order[i as usize] = i
        i = i + 1
    }

    // Stable insertion sort by descending weight, tie-breaking by index.
    i = 1
    while i < capped_total {
        let current = order[i as usize]
        let current_weight = weights[current as usize]
        var j: i64 = i - 1
        while j >= 0 {
            let previous = order[j as usize]
            let previous_weight = weights[previous as usize]
            if previous_weight > current_weight {
                break
            }
            if previous_weight == current_weight && previous < current {
                break
            }
            order[(j + 1) as usize] = previous
            j = j - 1
        }
        order[(j + 1) as usize] = current
        i = i + 1
    }

    i = 0
    while i < capped_total {
        let idx = order[i as usize]
        let w = weights[idx as usize]

        var best_shard: i64 = 0
        var shard: i64 = 1
        while shard < shard_count && shard < 128 {
            if loads[shard as usize] < loads[best_shard as usize] {
                best_shard = shard
            }
            shard = shard + 1
        }

        PARSE_ALL_BALANCED_CACHE_ASSIGN[idx as usize] = best_shard
        loads[best_shard as usize] = loads[best_shard as usize] + w
        i = i + 1
    }

    capped_total
}

fn parse_all_balanced_cache_total(corpus_mode: i64, shard_count: i64) -> i64 with IO, Mut, Panic, Div {
    if PARSE_ALL_BALANCED_CACHE_CORPUS == corpus_mode &&
       PARSE_ALL_BALANCED_CACHE_SHARDS == shard_count {
        return PARSE_ALL_BALANCED_CACHE_TOTAL
    }

    parse_all_rebuild_balanced_cache(corpus_mode, shard_count)
}

fn parse_all_balanced_shard_for_index(corpus_mode: i64, index: i64, shard_count: i64) -> i64 with IO, Mut, Panic, Div {
    let total = parse_all_balanced_cache_total(corpus_mode, shard_count)
    if index < 0 || index >= total {
        return -1
    }

    PARSE_ALL_BALANCED_CACHE_ASSIGN[index as usize]
}

fn parse_all_shard_contains(corpus_mode: i64, shard_mode: i64, index: i64, shard_index: i64, shard_count: i64) -> bool with IO, Mut, Panic, Div {
    if shard_count <= 1 {
        return true
    }

    if shard_mode == parse_all_shard_mode_balanced() &&
       corpus_mode == 1 &&
       shard_count <= 128 {
        parse_all_balanced_shard_for_index(corpus_mode, index, shard_count) == shard_index
    } else {
        index % shard_count == shard_index
    }
}

fn parse_all_corpus_label(corpus_mode: i64) -> string {
    if corpus_mode == 0 { "curated" } else { "full" }
}

fn parse_all_total_weight(corpus_mode: i64) -> i64 with IO, Mut, Div {
    let total = parse_all_total(corpus_mode)
    var weight: i64 = 0
    var idx: i64 = 0
    while idx < total {
        weight = weight + parse_all_file_weight(corpus_mode, idx)
        idx = idx + 1
    }
    weight
}

fn parse_all_emit_summary_line(corpus_mode: i64, shard_mode: i64, shard_index: i64, shard_count: i64, selected: i64, selected_weight: i64, passed: i64, failed: i64) with IO {
    print("PARSE_ALL_SUMMARY corpus=")
    print(parse_all_corpus_label(corpus_mode))
    print(" shard_mode=")
    print(parse_all_shard_mode_label(shard_mode))
    print(" shard_index=")
    print_int(shard_index)
    print(" shard_count=")
    print_int(shard_count)
    print(" selected=")
    print_int(selected)
    print(" selected_weight=")
    print_int(selected_weight)
    print(" passed=")
    print_int(passed)
    print(" failed=")
    print_int(failed)
    print("\n")
}

fn run_parse_all_suite(corpus_mode: i64, shard_mode: i64, shard_index: i64, shard_count: i64, print_config: bool) -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var failed: i64 = 0
    var total: i64 = 0
    var selected_weight: i64 = 0
    let corpus_total = parse_all_total(corpus_mode)
    // Full-corpus shard sweeps use parser fast mode (block-body skipping) for
    // throughput while preserving top-level parse validation.
    // Curated mode keeps full parsing.
    let parse_item_limit = if corpus_mode == 1 { -3 } else { 0 }

    print("=== Parse All ===\n")

    if print_config {
        print("Parse All Corpus: ")
        if corpus_mode == 0 { print("curated\n") } else { print("full\n") }
        print("Parse All Shard Mode: ")
        print(parse_all_shard_mode_label(shard_mode))
        print("\n")
        print("Parse All Shard: ")
        print_int(shard_index)
        print("/")
        print_int(shard_count)
        print("\n")
        print("Parse All Total Corpus Files: ")
        print_int(corpus_total)
        print("\n")
        if parse_item_limit > 0 {
            print("Parse All Item Limit: ")
            print_int(parse_item_limit)
            print("\n")
        }
        if parse_item_limit == -3 {
            print("Parse All Parser Mode: structural-scan\n")
        } else if parse_item_limit == -2 {
            print("Parse All Parser Mode: fast-skip-blocks\n")
        } else if parse_item_limit == -1 {
            print("Parse All Parser Mode: metadata-only\n")
        }
    }

    var i: i64 = 0
    while i < corpus_total {
        if parse_all_shard_contains(corpus_mode, shard_mode, i, shard_index, shard_count) {
            let path = parse_all_path(corpus_mode, i)
            if str_len(path) > 0 {
                total = total + 1
                selected_weight = selected_weight + parse_all_file_weight(corpus_mode, i)
                if test_parse_file_str(path, parse_item_limit) { passed = passed + 1 } else { failed = failed + 1 }
            } else {
                failed = failed + 1
            }
        }
        i = i + 1
    }

    if print_config {
        print("Parse All Selected Files: ")
        print_int(total)
        print("\n")
        print("Parse All Selected Weight: ")
        print_int(selected_weight)
        print("\n")
    }

    print("\nParse All: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")
    parse_all_emit_summary_line(corpus_mode, shard_mode, shard_index, shard_count, total, selected_weight, passed, failed)

    if failed == 0 { 0 } else { 1 }
}

fn run_parse_all_report(corpus_mode: i64, shard_mode: i64, shard_count: i64) -> i32 with IO, Mut, Panic, Div, Alloc {
    if shard_count <= 0 {
        print("Parse All Report: invalid shard count\n")
        return 1
    }
    if !parse_all_shard_mode_valid(shard_mode) {
        print("Parse All Report: invalid shard mode\n")
        return 1
    }

    let total = parse_all_total(corpus_mode)
    let total_weight = parse_all_total_weight(corpus_mode)

    print("=== Parse All Report ===\n")
    print("Parse All Corpus: ")
    if corpus_mode == 0 { print("curated\n") } else { print("full\n") }
    print("Parse All Shard Mode: ")
    print(parse_all_shard_mode_label(shard_mode))
    print("\n")
    print("Parse All Total Corpus Files: ")
    print_int(total)
    print("\n")
    print("Parse All Total Weight: ")
    print_int(total_weight)
    print("\n")
    print("Parse All Shard Count: ")
    print_int(shard_count)
    print("\n")
    print("PARSE_ALL_REPORT_SUMMARY corpus=")
    print(parse_all_corpus_label(corpus_mode))
    print(" shard_mode=")
    print(parse_all_shard_mode_label(shard_mode))
    print(" shard_count=")
    print_int(shard_count)
    print(" total_files=")
    print_int(total)
    print(" total_weight=")
    print_int(total_weight)
    print("\n")

    var shard: i64 = 0
    while shard < shard_count {
        var shard_total: i64 = 0
        var shard_weight: i64 = 0
        var idx: i64 = 0
        while idx < total {
            if parse_all_shard_contains(corpus_mode, shard_mode, idx, shard, shard_count) {
                shard_total = shard_total + 1
                shard_weight = shard_weight + parse_all_file_weight(corpus_mode, idx)
            }
            idx = idx + 1
        }

        print("Parse All Report Shard ")
        print_int(shard)
        print(": ")
        print_int(shard_total)
        print(" files (weight=")
        print_int(shard_weight)
        print(")\n")
        print("PARSE_ALL_REPORT_SHARD shard_index=")
        print_int(shard)
        print(" shard_mode=")
        print(parse_all_shard_mode_label(shard_mode))
        print(" shard_count=")
        print_int(shard_count)
        print(" files=")
        print_int(shard_total)
        print(" weight=")
        print_int(shard_weight)
        print("\n")

        idx = 0
        while idx < total {
            if parse_all_shard_contains(corpus_mode, shard_mode, idx, shard, shard_count) {
                print("  [")
                print_int(idx)
                print("] ")
                print(parse_all_path(corpus_mode, idx))
                print(" (w=")
                print_int(parse_all_file_weight(corpus_mode, idx))
                print(")")
                print("\n")
            }
            idx = idx + 1
        }

        shard = shard + 1
    }

    0
}

fn run_parse_all_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    // Curated coverage corpus: larger than smoke, but bounded so the full
    // self-hosted gate still completes under the 900s budget.
    run_parse_all_suite(0, parse_all_shard_mode_mod(), 0, 1, false)
}

fn run_parse_all_full_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    run_parse_all_suite(1, parse_all_shard_mode_balanced(), 0, 1, true)
}

fn run_parse_all_full_shard_tests(shard_index: i64, shard_count: i64, shard_mode: i64) -> i32 with IO, Mut, Panic, Div, Alloc {
    if shard_count <= 0 || shard_index < 0 || shard_index >= shard_count {
        print("Parse All: invalid shard parameters\n")
        return 1
    }
    if !parse_all_shard_mode_valid(shard_mode) {
        print("Parse All: invalid shard mode\n")
        return 1
    }

    run_parse_all_suite(1, shard_mode, shard_index, shard_count, true)
}

fn run_parse_all_full_report(shard_count: i64, shard_mode: i64) -> i32 with IO, Mut, Panic, Div, Alloc {
    run_parse_all_report(1, shard_mode, shard_count)
}
