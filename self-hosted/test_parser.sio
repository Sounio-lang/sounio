// self-hosted::test_parser — Integration tests for the self-hosted parser
//
// 10 test vectors covering: empty program, fn/struct/enum items,
// multi-item programs, return types, effects, parameters,
// let statements, and binary expressions.
//
// Pattern: construct token arrays, feed to parse_program, verify AST.
// Helpers precede callers (Sounio requirement).
// Each helper does at most ONE level of match to avoid nested-match scoping bug.

// ============================================================================
// TOKEN CONSTRUCTION HELPERS
// ============================================================================

fn ptok(kind: TokenKind) -> Token {
    Token::with_kind(kind, 0, 0, 1, 1)
}

fn ptok_eof() -> Token {
    Token::eof(0, 1, 1)
}

fn ptok_int(value: i64) -> Token {
    Token::with_int(TokenKind::IntLit, 0, 0, 1, 1, value)
}

fn ptok_id1(c0: i8) -> Token with Mut, Panic {
    var tok = Token::with_kind(TokenKind::Ident, 0, 0, 1, 1)
    var buf: [i8; 256] = [0; 256]
    buf[0] = c0
    tok.text = buf
    tok.text_len = 1
    tok
}

fn ptok_id2(c0: i8, c1: i8) -> Token with Mut, Panic {
    var tok = Token::with_kind(TokenKind::Ident, 0, 0, 1, 1)
    var buf: [i8; 256] = [0; 256]
    buf[0] = c0
    buf[1] = c1
    tok.text = buf
    tok.text_len = 2
    tok
}

fn ptok_id3(c0: i8, c1: i8, c2: i8) -> Token with Mut, Panic {
    var tok = Token::with_kind(TokenKind::Ident, 0, 0, 1, 1)
    var buf: [i8; 256] = [0; 256]
    buf[0] = c0
    buf[1] = c1
    buf[2] = c2
    tok.text = buf
    tok.text_len = 3
    tok
}

fn typeexpr_is_shared_slice(te: TypeExpr) -> bool with Alloc {
    if te.kind != TypeExprKind::TypeReference {
        return false
    }
    match te.inner {
        Some(inner) => {
            if (*inner).kind != TypeExprKind::TypeArray {
                return false
            }
            match (*inner).array_size {
                None => true,
                Some(_) => false,
            }
        }
        None => false,
    }
}

fn typeexpr_is_mut_slice(te: TypeExpr) -> bool with Alloc {
    if te.kind != TypeExprKind::TypeRefMut {
        return false
    }
    match te.inner {
        Some(inner) => {
            if (*inner).kind != TypeExprKind::TypeArray {
                return false
            }
            match (*inner).array_size {
                None => true,
                Some(_) => false,
            }
        }
        None => false,
    }
}

fn first_fn_first_param_is_shared_slice(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(items) => {
            match (*items).head.fn_def {
                Some(fd) => {
                    match (*fd).params {
                        Some(params) => typeexpr_is_shared_slice((*params).head.ty),
                        None => false,
                    }
                }
                None => false,
            }
        }
        None => false,
    }
}

fn first_fn_first_param_is_mut_slice(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(items) => {
            match (*items).head.fn_def {
                Some(fd) => {
                    match (*fd).params {
                        Some(params) => typeexpr_is_mut_slice((*params).head.ty),
                        None => false,
                    }
                }
                None => false,
            }
        }
        None => false,
    }
}

fn parse_program_from_ascii(input: [i8; 256], len: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    var i: i64 = 0
    while i < len {
        CURSOR_SOURCE[i as usize] = input[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = len
    let token_count = lex_source_to_globals(len)
    parse_program_preloaded(token_count)
}

fn parse_program_small(tokens: [Token; 65536], token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    var i: i64 = 0
    while i < token_count && i < 65536 {
        parser_set_token_at(i, tokens[i as usize])
        i = i + 1
    }
    parse_program_preloaded(token_count)
}

fn parser_name_is_knowledge_kaxi_publish(n: Name) -> bool {
    n.len == 24 &&
    n.buf[0] == 95 as i8 && n.buf[1] == 95 as i8 &&
    n.buf[2] == 107 as i8 && n.buf[3] == 110 as i8 &&
    n.buf[4] == 111 as i8 && n.buf[5] == 119 as i8 &&
    n.buf[6] == 108 as i8 && n.buf[7] == 101 as i8 &&
    n.buf[8] == 100 as i8 && n.buf[9] == 103 as i8 &&
    n.buf[10] == 101 as i8 && n.buf[11] == 95 as i8 &&
    n.buf[12] == 107 as i8 && n.buf[13] == 97 as i8 &&
    n.buf[14] == 120 as i8 && n.buf[15] == 105 as i8 &&
    n.buf[16] == 95 as i8 && n.buf[17] == 112 as i8 &&
    n.buf[18] == 117 as i8 && n.buf[19] == 98 as i8 &&
    n.buf[20] == 108 as i8 && n.buf[21] == 105 as i8 &&
    n.buf[22] == 115 as i8 && n.buf[23] == 104 as i8
}

fn first_stmt_expr_is_call(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => first_stmt_expr_is_call_item((*list).head),
        None => false,
    }
}

fn first_stmt_expr_is_call_item(item: Item) -> bool with Alloc {
    match item.fn_def {
        Some(fd) => first_stmt_expr_is_call_block((*fd).body),
        None => false,
    }
}

fn first_stmt_expr_is_call_block(block: Block) -> bool with Alloc {
    match block.stmts {
        Some(stmts) => first_stmt_expr_is_call_stmt((*stmts).head),
        None => false,
    }
}

fn first_stmt_expr_is_call_stmt(stmt: Stmt) -> bool with Alloc {
    match stmt.expr {
        Some(expr) => (*expr).kind == ExprKind::ExprCall,
        None => false,
    }
}

fn first_stmt_call_uses_intrinsic(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => first_stmt_call_uses_intrinsic_item((*list).head),
        None => false,
    }
}

fn first_stmt_call_uses_intrinsic_item(item: Item) -> bool with Alloc {
    match item.fn_def {
        Some(fd) => first_stmt_call_uses_intrinsic_block((*fd).body),
        None => false,
    }
}

fn first_stmt_call_uses_intrinsic_block(block: Block) -> bool with Alloc {
    match block.stmts {
        Some(stmts) => first_stmt_call_uses_intrinsic_stmt((*stmts).head),
        None => false,
    }
}

fn first_stmt_call_uses_intrinsic_stmt(stmt: Stmt) -> bool with Alloc {
    match stmt.expr {
        Some(expr) => call_uses_intrinsic(*expr),
        None => false,
    }
}

fn call_uses_intrinsic(expr: Expr) -> bool with Alloc {
    if expr.kind != ExprKind::ExprCall {
        return false
    }
    match expr.left {
        Some(callee) => (*callee).kind == ExprKind::ExprIdent && parser_name_is_knowledge_kaxi_publish((*callee).name),
        None => false,
    }
}

fn first_stmt_call_second_arg_is_fma_code(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => first_stmt_call_second_arg_is_fma_code_item((*list).head),
        None => false,
    }
}

fn first_stmt_call_second_arg_is_fma_code_item(item: Item) -> bool with Alloc {
    match item.fn_def {
        Some(fd) => first_stmt_call_second_arg_is_fma_code_block((*fd).body),
        None => false,
    }
}

fn first_stmt_call_second_arg_is_fma_code_block(block: Block) -> bool with Alloc {
    match block.stmts {
        Some(stmts) => first_stmt_call_second_arg_is_fma_code_stmt((*stmts).head),
        None => false,
    }
}

fn first_stmt_call_second_arg_is_fma_code_stmt(stmt: Stmt) -> bool with Alloc {
    match stmt.expr {
        Some(expr) => call_second_arg_is_fma_code(*expr),
        None => false,
    }
}

fn call_second_arg_is_fma_code(expr: Expr) -> bool with Alloc {
    if expr.kind != ExprKind::ExprCall {
        return false
    }
    match expr.args {
        Some(args) => call_second_arg_is_fma_code_args(*args),
        None => false,
    }
}

fn call_second_arg_is_fma_code_args(args: ExprList) -> bool with Alloc {
    match args.tail {
        Some(second) => ((*second).head.kind == ExprKind::ExprIntLit) && ((*second).head.int_val == 4),
        None => false,
    }
}

fn first_stmt_float_less_than(prog: Program, limit: f64) -> bool with Alloc {
    match prog.items {
        Some(list) => first_stmt_float_less_than_item((*list).head, limit),
        None => false,
    }
}

fn first_stmt_float_less_than_item(item: Item, limit: f64) -> bool with Alloc {
    match item.fn_def {
        Some(fd) => first_stmt_float_less_than_block((*fd).body, limit),
        None => false,
    }
}

fn first_stmt_float_less_than_block(block: Block, limit: f64) -> bool with Alloc {
    match block.stmts {
        Some(stmts) => first_stmt_float_less_than_stmt((*stmts).head, limit),
        None => false,
    }
}

fn first_stmt_float_less_than_stmt(stmt: Stmt, limit: f64) -> bool with Alloc {
    match stmt.expr {
        Some(expr) => (*expr).kind == ExprKind::ExprFloatLit && (*expr).float_val > 0.0 && (*expr).float_val < limit,
        None => false,
    }
}

// ============================================================================
// SINGLE-LEVEL AST INSPECTION HELPERS
// ============================================================================
// Each function performs at most one match on Option<Box<T>> to work
// around the nested-match variable scoping limitation.

// --- FnDef property checks (leaf level) ---

fn fndef_has_ret(fd: FnDef) -> bool {
    match fd.return_type {
        Some(_) => true,
        None => false,
    }
}

fn fndef_has_params(fd: FnDef) -> bool {
    match fd.params {
        Some(_) => true,
        None => false,
    }
}

fn fndef_has_effects(fd: FnDef) -> bool {
    match fd.effects {
        Some(_) => true,
        None => false,
    }
}

fn fndef_body_has_stmts(fd: FnDef) -> bool {
    match fd.body.stmts {
        Some(_) => true,
        None => false,
    }
}

// --- FnDef option unwrap + check (one match on Option<Box<FnDef>>) ---

fn fndef_opt_has_ret(opt: Option<Box<FnDef>>) -> bool with Alloc {
    match opt {
        Some(fd) => fndef_has_ret(*fd),
        None => false,
    }
}

fn fndef_opt_has_params(opt: Option<Box<FnDef>>) -> bool with Alloc {
    match opt {
        Some(fd) => fndef_has_params(*fd),
        None => false,
    }
}

fn fndef_opt_has_effects(opt: Option<Box<FnDef>>) -> bool with Alloc {
    match opt {
        Some(fd) => fndef_has_effects(*fd),
        None => false,
    }
}

fn fndef_opt_body_has_stmts(opt: Option<Box<FnDef>>) -> bool with Alloc {
    match opt {
        Some(fd) => fndef_body_has_stmts(*fd),
        None => false,
    }
}

// --- ItemList tail access (one match on Option<Box<ItemList>>) ---

fn tail_item_kind(tail: Option<Box<ItemList>>) -> ItemKind with Alloc {
    match tail {
        Some(rest) => (*rest).head.kind,
        None => ItemKind::ItemFn,
    }
}

// --- Top-level program inspectors (one match each) ---

fn first_item_kind(prog: Program) -> ItemKind with Alloc {
    match prog.items {
        Some(list) => (*list).head.kind,
        None => ItemKind::ItemFn,
    }
}

fn second_item_kind(prog: Program) -> ItemKind with Alloc {
    match prog.items {
        Some(list) => tail_item_kind((*list).tail),
        None => ItemKind::ItemFn,
    }
}

fn method_tail_is_empty(tail: Option<Box<ItemList>>) -> bool with Alloc {
    match tail {
        Some(_) => false,
        None => true,
    }
}

fn method_tail_is_single_private(tail: Option<Box<ItemList>>) -> bool with Alloc {
    match tail {
        Some(rest) => !visibility_to_bool((*rest).head.visibility) && method_tail_is_empty((*rest).tail),
        None => false,
    }
}

fn method_list_is_public_then_private(methods: ItemList) -> bool with Alloc {
    visibility_is_pub(methods.head.visibility) && method_tail_is_single_private(methods.tail)
}

fn impl_def_methods_are_public_then_private(impl_def: ImplDef) -> bool with Alloc {
    match impl_def.methods {
        Some(methods) => method_list_is_public_then_private(*methods),
        None => false,
    }
}

fn item_methods_are_public_then_private(item: Item) -> bool with Alloc {
    match item.impl_def {
        Some(impl_def) => impl_def_methods_are_public_then_private(*impl_def),
        None => false,
    }
}

fn first_impl_methods_are_public_then_private(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(items) => item_methods_are_public_then_private((*items).head),
        None => false,
    }
}

fn first_fn_has_ret(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => fndef_opt_has_ret((*list).head.fn_def),
        None => false,
    }
}

fn first_fn_has_params(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => fndef_opt_has_params((*list).head.fn_def),
        None => false,
    }
}

fn first_fn_has_effects(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => fndef_opt_has_effects((*list).head.fn_def),
        None => false,
    }
}

fn first_fn_body_has_stmts(prog: Program) -> bool with Alloc {
    match prog.items {
        Some(list) => fndef_opt_body_has_stmts((*list).head.fn_def),
        None => false,
    }
}

// ============================================================================
// TESTS
// ============================================================================

// T01: Empty program — just EOF → 0 items
fn test_empty_program() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok_eof()
    let prog = parse_program_small(tokens, 1)
    count_items(prog) == 0
}

// T02: fn f() {} → 1 item, ItemFn
fn test_single_fn() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok(TokenKind::RParen)
    tokens[4] = ptok(TokenKind::LBrace)
    tokens[5] = ptok(TokenKind::RBrace)
    tokens[6] = ptok_eof()
    let prog = parse_program_small(tokens, 7)
    count_items(prog) == 1 && first_item_kind(prog) == ItemKind::ItemFn
}

// T03: struct S { x: i64 } → 1 item, ItemStruct
fn test_struct_item() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Struct)
    tokens[1] = ptok_id1(83)   // 'S'
    tokens[2] = ptok(TokenKind::LBrace)
    tokens[3] = ptok_id1(120)  // 'x'
    tokens[4] = ptok(TokenKind::Colon)
    tokens[5] = ptok_id3(105, 54, 52)  // "i64"
    tokens[6] = ptok(TokenKind::RBrace)
    tokens[7] = ptok_eof()
    let prog = parse_program_small(tokens, 8)
    count_items(prog) == 1 && first_item_kind(prog) == ItemKind::ItemStruct
}

// T04: enum E { A, B } → 1 item, ItemEnum
fn test_enum_item() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Enum)
    tokens[1] = ptok_id1(69)   // 'E'
    tokens[2] = ptok(TokenKind::LBrace)
    tokens[3] = ptok_id1(65)   // 'A'
    tokens[4] = ptok(TokenKind::Comma)
    tokens[5] = ptok_id1(66)   // 'B'
    tokens[6] = ptok(TokenKind::RBrace)
    tokens[7] = ptok_eof()
    let prog = parse_program_small(tokens, 8)
    count_items(prog) == 1 && first_item_kind(prog) == ItemKind::ItemEnum
}

// T05: struct S {} + fn f() {} → 2 items with correct kinds
fn test_two_items() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    // struct S {}
    tokens[0] = ptok(TokenKind::Struct)
    tokens[1] = ptok_id1(83)   // 'S'
    tokens[2] = ptok(TokenKind::LBrace)
    tokens[3] = ptok(TokenKind::RBrace)
    // fn f() {}
    tokens[4] = ptok(TokenKind::Fn)
    tokens[5] = ptok_id1(102)  // 'f'
    tokens[6] = ptok(TokenKind::LParen)
    tokens[7] = ptok(TokenKind::RParen)
    tokens[8] = ptok(TokenKind::LBrace)
    tokens[9] = ptok(TokenKind::RBrace)
    tokens[10] = ptok_eof()
    let prog = parse_program_small(tokens, 11)
    count_items(prog) == 2
        && first_item_kind(prog) == ItemKind::ItemStruct
        && second_item_kind(prog) == ItemKind::ItemFn
}

// T06: fn f() -> i64 { 42 } → has return type
fn test_fn_with_return_type() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok(TokenKind::RParen)
    tokens[4] = ptok(TokenKind::Arrow)
    tokens[5] = ptok_id3(105, 54, 52)  // "i64"
    tokens[6] = ptok(TokenKind::LBrace)
    tokens[7] = ptok_int(42)
    tokens[8] = ptok(TokenKind::RBrace)
    tokens[9] = ptok_eof()
    let prog = parse_program_small(tokens, 10)
    count_items(prog) == 1 && first_fn_has_ret(prog)
}

// T07: fn f() with IO {} → has effects
fn test_fn_with_effects() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok(TokenKind::RParen)
    tokens[4] = ptok(TokenKind::With)
    tokens[5] = ptok_id2(73, 79)  // "IO"
    tokens[6] = ptok(TokenKind::LBrace)
    tokens[7] = ptok(TokenKind::RBrace)
    tokens[8] = ptok_eof()
    let prog = parse_program_small(tokens, 9)
    count_items(prog) == 1 && first_fn_has_effects(prog)
}

// T08: fn f(x: i64) {} → has params
fn test_fn_with_param() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok_id1(120)  // 'x'
    tokens[4] = ptok(TokenKind::Colon)
    tokens[5] = ptok_id3(105, 54, 52)  // "i64"
    tokens[6] = ptok(TokenKind::RParen)
    tokens[7] = ptok(TokenKind::LBrace)
    tokens[8] = ptok(TokenKind::RBrace)
    tokens[9] = ptok_eof()
    let prog = parse_program_small(tokens, 10)
    count_items(prog) == 1 && first_fn_has_params(prog)
}

// T09: fn f() { let x = 5 } → body has stmts
fn test_fn_with_let() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok(TokenKind::RParen)
    tokens[4] = ptok(TokenKind::LBrace)
    tokens[5] = ptok(TokenKind::Let)
    tokens[6] = ptok_id1(120)  // 'x'
    tokens[7] = ptok(TokenKind::Eq)
    tokens[8] = ptok_int(5)
    tokens[9] = ptok(TokenKind::RBrace)
    tokens[10] = ptok_eof()
    let prog = parse_program_small(tokens, 11)
    count_items(prog) == 1 && first_fn_body_has_stmts(prog)
}

// T10: fn f() { 1 + 2 } → body has stmts (expression stmt with binary op)
fn test_fn_with_binop() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // 'f'
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok(TokenKind::RParen)
    tokens[4] = ptok(TokenKind::LBrace)
    tokens[5] = ptok_int(1)
    tokens[6] = ptok(TokenKind::Plus)
    tokens[7] = ptok_int(2)
    tokens[8] = ptok(TokenKind::RBrace)
    tokens[9] = ptok_eof()
    let prog = parse_program_small(tokens, 10)
    count_items(prog) == 1 && first_fn_body_has_stmts(prog)
}

// T11: hardware_publish(k, KAXI::fma) is canonicalized to __knowledge_kaxi_publish with op code 4
fn test_hardware_publish_canonicalization() -> bool with Mut, IO, Panic, Div, Alloc {
    var input: [i8; 256] = [0; 256]
    // "fn f() { hardware_publish(k, KAXI::fma) }"
    input[0] = 102 as i8   // f
    input[1] = 110 as i8   // n
    input[2] = 32 as i8
    input[3] = 102 as i8   // f
    input[4] = 40 as i8    // (
    input[5] = 41 as i8    // )
    input[6] = 32 as i8
    input[7] = 123 as i8   // {
    input[8] = 32 as i8
    input[9] = 104 as i8   // h
    input[10] = 97 as i8
    input[11] = 114 as i8
    input[12] = 100 as i8
    input[13] = 119 as i8
    input[14] = 97 as i8
    input[15] = 114 as i8
    input[16] = 101 as i8
    input[17] = 95 as i8
    input[18] = 112 as i8
    input[19] = 117 as i8
    input[20] = 98 as i8
    input[21] = 108 as i8
    input[22] = 105 as i8
    input[23] = 115 as i8
    input[24] = 104 as i8
    input[25] = 40 as i8   // (
    input[26] = 107 as i8  // k
    input[27] = 44 as i8   // ,
    input[28] = 32 as i8
    input[29] = 75 as i8   // K
    input[30] = 65 as i8   // A
    input[31] = 88 as i8   // X
    input[32] = 73 as i8   // I
    input[33] = 58 as i8   // :
    input[34] = 58 as i8   // :
    input[35] = 102 as i8  // f
    input[36] = 109 as i8  // m
    input[37] = 97 as i8   // a
    input[38] = 41 as i8   // )
    input[39] = 32 as i8
    input[40] = 125 as i8  // }

    let prog = parse_program_from_ascii(input, 41)
    count_items(prog) == 1 &&
    first_fn_body_has_stmts(prog) &&
    first_stmt_expr_is_call(prog) &&
    first_stmt_call_uses_intrinsic(prog) &&
    first_stmt_call_second_arg_is_fma_code(prog)
}

// T12: fn f(s: &[f64]) {} parses a shared slice parameter
fn test_fn_with_shared_slice_param() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // f
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok_id1(115)  // s
    tokens[4] = ptok(TokenKind::Colon)
    tokens[5] = ptok(TokenKind::Amp)
    tokens[6] = ptok(TokenKind::LBracket)
    tokens[7] = ptok_id3(102, 54, 52)  // f64
    tokens[8] = ptok(TokenKind::RBracket)
    tokens[9] = ptok(TokenKind::RParen)
    tokens[10] = ptok(TokenKind::LBrace)
    tokens[11] = ptok(TokenKind::RBrace)
    tokens[12] = ptok_eof()
    let prog = parse_program_small(tokens, 13)
    count_items(prog) == 1 && first_fn_first_param_is_shared_slice(prog)
}

// T13: fn f(s: &![f64]) {} parses a mutable slice parameter
fn test_fn_with_mut_slice_param() -> bool with Mut, IO, Panic, Div, Alloc {
    var tokens: [Token; 65536] = [Token::new(); 65536]
    tokens[0] = ptok(TokenKind::Fn)
    tokens[1] = ptok_id1(102)  // f
    tokens[2] = ptok(TokenKind::LParen)
    tokens[3] = ptok_id1(115)  // s
    tokens[4] = ptok(TokenKind::Colon)
    tokens[5] = ptok(TokenKind::AmpBang)
    tokens[6] = ptok(TokenKind::LBracket)
    tokens[7] = ptok_id3(102, 54, 52)  // f64
    tokens[8] = ptok(TokenKind::RBracket)
    tokens[9] = ptok(TokenKind::RParen)
    tokens[10] = ptok(TokenKind::LBrace)
    tokens[11] = ptok(TokenKind::RBrace)
    tokens[12] = ptok_eof()
    let prog = parse_program_small(tokens, 13)
    count_items(prog) == 1 && first_fn_first_param_is_mut_slice(prog)
}

