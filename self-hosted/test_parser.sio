// T17: impl S { pub fn a() {} fn b() {} } preserves method visibility in the AST.
fn test_impl_method_visibility() -> bool with Mut, IO, Panic, Div, Alloc {
    var input: [i8; 256] = [0; 256]
    input[0] = 105 as i8  // i
    input[1] = 109 as i8  // m
    input[2] = 112 as i8  // p
    input[3] = 108 as i8  // l
    input[4] = 32 as i8
    input[5] = 83 as i8   // S
    input[6] = 123 as i8  // {
    input[7] = 112 as i8  // p
    input[8] = 117 as i8  // u
    input[9] = 98 as i8   // b
    input[10] = 32 as i8
    input[11] = 102 as i8 // f
    input[12] = 110 as i8 // n
    input[13] = 32 as i8
    input[14] = 97 as i8  // a
    input[15] = 40 as i8  // (
    input[16] = 41 as i8  // )
    input[17] = 123 as i8 // {
    input[18] = 125 as i8 // }
    input[19] = 102 as i8 // f
    input[20] = 110 as i8 // n
    input[21] = 32 as i8
    input[22] = 98 as i8  // b
    input[23] = 40 as i8  // (
    input[24] = 41 as i8  // )
    input[25] = 123 as i8 // {
    input[26] = 125 as i8 // }
    input[27] = 125 as i8 // }

    let prog = parse_program_from_ascii(input, 28)
    count_items(prog) == 1 &&
    first_item_kind(prog) == ItemKind::ItemImpl &&
    parser_last_error_count() == 0 &&
    first_impl_methods_are_public_then_private(prog)
}

// T18: an incomplete pub method must not consume the impl's closing brace.
fn test_incomplete_pub_impl_recovers_next_fn() -> bool with Mut, IO, Panic, Div, Alloc {
    var input: [i8; 256] = [0; 256]
    input[0] = 105 as i8  // i
    input[1] = 109 as i8  // m
    input[2] = 112 as i8  // p
    input[3] = 108 as i8  // l
    input[4] = 32 as i8
    input[5] = 83 as i8   // S
    input[6] = 123 as i8  // {
    input[7] = 112 as i8  // p
    input[8] = 117 as i8  // u
    input[9] = 98 as i8   // b
    input[10] = 125 as i8 // }
    input[11] = 102 as i8 // f
    input[12] = 110 as i8 // n
    input[13] = 32 as i8
    input[14] = 102 as i8 // f
    input[15] = 40 as i8  // (
    input[16] = 41 as i8  // )
    input[17] = 123 as i8 // {
    input[18] = 125 as i8 // }

    let prog = parse_program_from_ascii(input, 19)
    count_items(prog) == 2 &&
    first_item_kind(prog) == ItemKind::ItemImpl &&
    second_item_kind(prog) == ItemKind::ItemFn &&
    parser_last_error_count() == 1
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_parser_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if test_empty_program() { passed = passed + 1 } else { print("FAIL: T01 empty_program\n") }

    total = total + 1
    if test_single_fn() { passed = passed + 1 } else { print("FAIL: T02 single_fn\n") }

    total = total + 1
    if test_struct_item() { passed = passed + 1 } else { print("FAIL: T03 struct_item\n") }

    total = total + 1
    if test_enum_item() { passed = passed + 1 } else { print("FAIL: T04 enum_item\n") }

    total = total + 1
    if test_two_items() { passed = passed + 1 } else { print("FAIL: T05 two_items\n") }

    total = total + 1
    if test_fn_with_return_type() { passed = passed + 1 } else { print("FAIL: T06 fn_with_return_type\n") }

    total = total + 1
    if test_fn_with_effects() { passed = passed + 1 } else { print("FAIL: T07 fn_with_effects\n") }

    total = total + 1
    if test_fn_with_param() { passed = passed + 1 } else { print("FAIL: T08 fn_with_param\n") }

    total = total + 1
    if test_fn_with_let() { passed = passed + 1 } else { print("FAIL: T09 fn_with_let\n") }

    total = total + 1
    if test_fn_with_binop() { passed = passed + 1 } else { print("FAIL: T10 fn_with_binop\n") }

    total = total + 1
    if test_hardware_publish_canonicalization() { passed = passed + 1 } else { print("FAIL: T11 hardware_publish_canonicalization\n") }

    total = total + 1
    if test_fn_with_shared_slice_param() { passed = passed + 1 } else { print("FAIL: T12 fn_with_shared_slice_param\n") }

    total = total + 1
    if test_fn_with_mut_slice_param() { passed = passed + 1 } else { print("FAIL: T13 fn_with_mut_slice_param\n") }

    total = total + 1
    if test_card_a_ascii_forms() { passed = passed + 1 } else { print("FAIL: T14 card_a_ascii_forms\n") }

    total = total + 1
    if test_card_a_float_exponent_if_block() { passed = passed + 1 } else { print("FAIL: T15 card_a_float_exponent_if_block\n") }

    total = total + 1
    if test_card_a_raw_pointer_types() { passed = passed + 1 } else { print("FAIL: T16 card_a_raw_pointer_types\n") }

    total = total + 1
    if test_impl_method_visibility() { passed = passed + 1 } else { print("FAIL: T17 impl_method_visibility\n") }

    total = total + 1
    if test_incomplete_pub_impl_recovers_next_fn() { passed = passed + 1 } else { print("FAIL: T18 incomplete_pub_impl_recovers_next_fn\n") }

    if passed == total {
        print("ALL PARSER TESTS PASSED\n")
    }
    print("Parser tests: ")

    if passed == total { 0 } else { 1 }
}

fn run_parser_card_a_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed = 0
    var total = 0

    total = total + 1
    if test_card_a_ascii_forms() { passed = passed + 1 } else { print("FAIL: card_a_ascii_forms\n") }

    total = total + 1
    if test_card_a_float_exponent_if_block() { passed = passed + 1 } else { print("FAIL: card_a_float_exponent_if_block\n") }

    total = total + 1
    if test_card_a_raw_pointer_types() { passed = passed + 1 } else { print("FAIL: card_a_raw_pointer_types\n") }

    if passed == total {
        print("ALL CARD A PARSER TESTS PASSED\n")
    }

    if passed == total { 0 } else { 1 }
}
