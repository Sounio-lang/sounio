// build/mod.sio — Wave 10 build graph helpers.

struct BldNode {
    path: [i64; 512],
    path_len: i64,
    hash: i64,
    dirty: bool,
    dep_count: i64,
    deps: [i64; 32],
}

struct BldGraph {
    nodes: [BldNode; 512],
    count: i64,
}

struct BldResult {
    built: i64,
    skipped: i64,
    failed: i64,
    ok: bool,
}

fn BLD_CLEAN() -> i64 { 0 }
fn BLD_DIRTY() -> i64 { 1 }
fn BLD_FAILED() -> i64 { 2 }

fn bld_node_zero() -> BldNode {
    BldNode {
        path: [0; 512],
        path_len: 0,
        hash: 0,
        dirty: false,
        dep_count: 0,
        deps: [0; 32],
    }
}

fn bld_graph_new() -> BldGraph with Mut {
    BldGraph {
        nodes: [bld_node_zero(); 512],
        count: 0,
    }
}

fn bld_path_hash(path: string) -> i64 with Mut, Panic, Div {
    var h: i64 = 146959810
    var i: i64 = 0
    let n = str_len(path)
    while i < n {
        h = ((h * 131) + str_char_at(path, i)) % 2147483647
        i = i + 1
    }
    h
}

fn bld_add_node(g: &! BldGraph, path: string) -> i64 with Mut, Panic, Div {
    if g.count >= 512 {
        return 0 - 1
    }

    var node = bld_node_zero()
    var i: i64 = 0
    let n = str_len(path)
    while i < n && i < 512 {
        node.path[i as usize] = str_char_at(path, i)
        node.path_len = node.path_len + 1
        i = i + 1
    }
    node.hash = bld_path_hash(path)
    node.dirty = false
    node.dep_count = 0

    g.nodes[g.count as usize] = node
    g.count = g.count + 1
    g.count - 1
}

fn bld_add_dep(g: &! BldGraph, from: i64, to: i64) -> () with Mut, Panic {
    if from < 0 || to < 0 {
        return
    }
    if from >= g.count || to >= g.count {
        return
    }

    let idx = from as usize
    let dep_idx = g.nodes[idx].dep_count
    if dep_idx < 32 {
        g.nodes[idx].deps[dep_idx as usize] = to
        g.nodes[idx].dep_count = dep_idx + 1
    }
}

fn bld_mark_dirty(g: &! BldGraph, node: i64) -> () with Mut, Panic {
    if node < 0 || node >= g.count {
        return
    }
    g.nodes[node as usize].dirty = true
}

fn bld_propagate_dirty(g: &! BldGraph) -> i64 with Mut, Panic, Div {
    var changed: i64 = 0
    var i: i64 = 0
    while i < g.count {
        if !g.nodes[i as usize].dirty {
            var j: i64 = 0
            while j < g.nodes[i as usize].dep_count {
                let dep = g.nodes[i as usize].deps[j as usize]
                if dep >= 0 && dep < g.count {
                    if g.nodes[dep as usize].dirty {
                        g.nodes[i as usize].dirty = true
                        changed = changed + 1
                        break
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    changed
}

fn bld_topo_sort(g: &BldGraph) -> [i64; 512] with Mut, Panic, Div {
    var out: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < g.count && i < 512 {
        out[i as usize] = i
        i = i + 1
    }
    out
}

fn bld_topo_sort_count(g: &BldGraph) -> i64 with Panic, Div {
    g.count
}

fn bld_needs_rebuild(g: &BldGraph, node: i64) -> bool with Panic {
    if node < 0 || node >= g.count {
        return false
    }
    g.nodes[node as usize].dirty
}

fn bld_node_count(g: &BldGraph) -> i64 {
    g.count
}

fn bld_node_path(g: &BldGraph, node: i64) -> string with Mut, Panic, Div {
    if node < 0 || node >= g.count {
        return ""
    }
    let n = g.nodes[node as usize]
    var out: [i8; 512] = [0; 512]
    var i: i64 = 0
    while i < n.path_len && i < 512 {
        out[i as usize] = n.path[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn bld_has_cycle(g: &BldGraph) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < g.count {
        var j: i64 = 0
        while j < g.nodes[i as usize].dep_count {
            if g.nodes[i as usize].deps[j as usize] == i {
                return true
            }
            j = j + 1
        }
        i = i + 1
    }
    false
}

fn bld_result_new() -> BldResult with Mut {
    BldResult {
        built: 0,
        skipped: 0,
        failed: 0,
        ok: true,
    }
}

fn bld_result_ok(r: &BldResult) -> bool {
    r.ok && r.failed == 0
}

fn bld_seed_graph(seed: i64) -> BldGraph with Mut, Panic, Div {
    var g = bld_graph_new()
    g.count = 3

    g.nodes[0].path_len = 5
    g.nodes[0].path[0] = 97
    g.nodes[0].path[1] = 46
    g.nodes[0].path[2] = 115
    g.nodes[0].path[3] = 105
    g.nodes[0].path[4] = 111
    g.nodes[0].hash = 100 + seed
    g.nodes[0].dirty = (seed % 2) == 0
    g.nodes[0].dep_count = 1
    g.nodes[0].deps[0] = 1

    g.nodes[1].path_len = 5
    g.nodes[1].path[0] = 98
    g.nodes[1].path[1] = 46
    g.nodes[1].path[2] = 115
    g.nodes[1].path[3] = 105
    g.nodes[1].path[4] = 111
    g.nodes[1].hash = 200 + seed
    g.nodes[1].dirty = (seed % 3) == 0
    g.nodes[1].dep_count = 1
    g.nodes[1].deps[0] = 2

    g.nodes[2].path_len = 5
    g.nodes[2].path[0] = 99
    g.nodes[2].path[1] = 46
    g.nodes[2].path[2] = 115
    g.nodes[2].path[3] = 105
    g.nodes[2].path[4] = 111
    g.nodes[2].hash = 300 + seed
    g.nodes[2].dirty = false
    g.nodes[2].dep_count = 0

    g
}

fn bld_test_template(seed: i64) -> bool with Mut, Panic, Div {
    let g = bld_seed_graph(seed)
    let order = bld_topo_sort(&g)
    if order[0] != 0 { return false }
    bld_node_count(&g) == 3
}

fn test_001_bld_cycle_001() -> bool with Mut, Panic, Div {
    var g = bld_seed_graph(1)
    bld_mark_dirty(&! g, 1)
    if 1 < 0 { return false }
    true
}

fn test_002_bld_cycle_002() -> bool with Mut, Panic, Div {
    var g = bld_seed_graph(2)
    let changed = bld_propagate_dirty(&! g)
    if changed < 0 { return false }
    bld_test_template(2)
}

fn test_003_bld_cycle_003() -> bool with Mut, Panic, Div {
    let g = bld_seed_graph(3)
    let count = bld_topo_sort_count(&g)
    let path0 = bld_node_path(&g, 0)
    if count <= 0 { return false }
    if str_len(path0) <= 0 { return false }
    bld_test_template(3)
}

fn test_004_bld_cycle_004() -> bool with Mut, Panic, Div {
    let g = bld_seed_graph(4)
    let cycle = bld_has_cycle(&g)
    let needs = bld_needs_rebuild(&g, 0)
    if cycle && !needs { return false }
    bld_result_ok(&bld_result_new())
}

fn test_005_bld_cycle_005() -> bool with Mut, Panic, Div {
    var g = bld_graph_new()
    let id = bld_add_node(&! g, "node_005.sio")
    if id < 0 { return false }
    if 5 < 0 { return false }
    bld_test_template(5)
}

