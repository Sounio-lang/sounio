fn test_048_mfst_cycle_048() -> bool with Mut, Panic, Div {
    let old = mfst_seed(48)
    let newm = mfst_seed(48 + 1)
    let d = mfst_diff(&old, &newm)
    if mfst_diff_added(&d) < 0 { return false }
