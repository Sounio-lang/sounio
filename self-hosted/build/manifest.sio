// build/manifest.sio — Wave 10 manifest and diff helpers.

struct MfstEntry {
    path: [i64; 512],
    path_len: i64,
    hash: i64,
    present: bool,
}

struct MfstFile {
    entries: [MfstEntry; 256],
    count: i64,
    valid: bool,
}

struct MfstDiff {
    added: [i64; 128],
    added_count: i64,
    removed: [i64; 128],
    removed_count: i64,
    changed: [i64; 128],
    changed_count: i64,
}

fn mfst_entry_zero() -> MfstEntry {
    MfstEntry {
        path: [0; 512],
        path_len: 0,
        hash: 0,
        present: false,
    }
}

fn mfst_diff_zero() -> MfstDiff {
    MfstDiff {
        added: [0; 128],
        added_count: 0,
        removed: [0; 128],
        removed_count: 0,
        changed: [0; 128],
        changed_count: 0,
    }
}

fn mfst_new() -> MfstFile with Mut {
    MfstFile {
        entries: [mfst_entry_zero(); 256],
        count: 0,
        valid: true,
    }
}

fn mfst_entry_matches_path(e: &MfstEntry, path: string) -> bool with Mut, Panic, Div {
    let n = str_len(path)
    if e.path_len != n {
        return false
    }

    var i: i64 = 0
    while i < n {
        if e.path[i as usize] != str_char_at(path, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn mfst_entries_equal_path(a: &MfstEntry, b: &MfstEntry) -> bool with Mut, Panic, Div {
    if a.path_len != b.path_len {
        return false
    }
    var i: i64 = 0
    while i < a.path_len {
        if a.path[i as usize] != b.path[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn mfst_add(m: &! MfstFile, path: string, hash: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.count {
        if mfst_entry_matches_path(&m.entries[i as usize], path) {
            m.entries[i as usize].hash = hash
            m.entries[i as usize].present = true
            return i
        }
        i = i + 1
    }

    if m.count >= 256 {
        m.valid = false
        return 0 - 1
    }

    var e = mfst_entry_zero()
    var j: i64 = 0
    let n = str_len(path)
    while j < n && j < 512 {
        e.path[j as usize] = str_char_at(path, j)
        e.path_len = e.path_len + 1
        j = j + 1
    }
    e.hash = hash
    e.present = true

    m.entries[m.count as usize] = e
    m.count = m.count + 1
    m.count - 1
}

fn mfst_count(m: &MfstFile) -> i64 {
    m.count
}

fn mfst_entry_path(m: &MfstFile, idx: i64) -> string with Mut, Panic, Div {
    if idx < 0 || idx >= m.count {
        return ""
    }
    let e = m.entries[idx as usize]
    var out: [i8; 512] = [0; 512]
    var i: i64 = 0
    while i < e.path_len && i < 512 {
        out[i as usize] = e.path[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn mfst_entry_hash(m: &MfstFile, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= m.count {
        return 0
    }
    m.entries[idx as usize].hash
}

fn mfst_find(m: &MfstFile, path: string) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.count {
        if mfst_entry_matches_path(&m.entries[i as usize], path) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn mfst_contains(m: &MfstFile, path: string) -> bool with Mut, Panic, Div {
    mfst_find(m, path) >= 0
}

fn mfst_remove(m: &! MfstFile, path: string) -> bool with Mut, Panic, Div {
    var idx: i64 = 0 - 1
    var i: i64 = 0
    while i < m.count {
        if mfst_entry_matches_path(&m.entries[i as usize], path) {
            idx = i
            break
        }
        i = i + 1
    }

    if idx < 0 {
        return false
    }

    i = idx
    while i + 1 < m.count {
        m.entries[i as usize] = m.entries[(i + 1) as usize]
        i = i + 1
    }
    m.count = m.count - 1
    true
}

fn mfst_update_hash(m: &! MfstFile, path: string, hash: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.count {
        if mfst_entry_matches_path(&m.entries[i as usize], path) {
            m.entries[i as usize].hash = hash
            return true
        }
        i = i + 1
    }
    false
}

fn mfst_diff(old: &MfstFile, new: &MfstFile) -> MfstDiff with Mut, Panic, Div {
    var d = mfst_diff_zero()

    var i: i64 = 0
    while i < new.count {
        let e_new = new.entries[i as usize]
        var found: bool = false
        var changed: bool = false

        var j: i64 = 0
        while j < old.count {
            let e_old = old.entries[j as usize]
            if mfst_entries_equal_path(&e_old, &e_new) {
                found = true
                if e_old.hash != e_new.hash {
                    changed = true
                }
                break
            }
            j = j + 1
        }

        if !found && d.added_count < 128 {
            d.added[d.added_count as usize] = i
            d.added_count = d.added_count + 1
        }
        if changed && d.changed_count < 128 {
            d.changed[d.changed_count as usize] = i
            d.changed_count = d.changed_count + 1
        }
        i = i + 1
    }

    i = 0
    while i < old.count {
        let e_old = old.entries[i as usize]
        var found2: bool = false
        var j2: i64 = 0
        while j2 < new.count {
            let e_new2 = new.entries[j2 as usize]
            if mfst_entries_equal_path(&e_old, &e_new2) {
                found2 = true
                break
            }
            j2 = j2 + 1
        }
        if !found2 && d.removed_count < 128 {
            d.removed[d.removed_count as usize] = i
            d.removed_count = d.removed_count + 1
        }
        i = i + 1
    }

    d
}

fn mfst_diff_added(d: &MfstDiff) -> i64 {
    d.added_count
}

fn mfst_diff_removed(d: &MfstDiff) -> i64 {
    d.removed_count
}

fn mfst_diff_changed(d: &MfstDiff) -> i64 {
    d.changed_count
}

fn mfst_merge(base: &MfstFile, patch: &MfstFile) -> MfstFile with Mut, Panic, Div {
    var out = *base

    var i: i64 = 0
    while i < patch.count {
        let pe = patch.entries[i as usize]
        var found: bool = false

        var j: i64 = 0
        while j < out.count {
            if mfst_entries_equal_path(&out.entries[j as usize], &pe) {
                out.entries[j as usize].hash = pe.hash
                out.entries[j as usize].present = pe.present
                found = true
                break
            }
            j = j + 1
        }

        if !found {
            if out.count < 256 {
                out.entries[out.count as usize] = pe
                out.count = out.count + 1
            } else {
                out.valid = false
            }
        }

        i = i + 1
    }

    out
}

fn mfst_validate(m: &MfstFile) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.count {
        var j = i + 1
        while j < m.count {
            if mfst_entries_equal_path(&m.entries[i as usize], &m.entries[j as usize]) {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    m.valid
}

fn mfst_compare_entries(a: &MfstEntry, b: &MfstEntry) -> i64 with Mut, Panic, Div {
    let limit = if a.path_len < b.path_len { a.path_len } else { b.path_len }
    var i: i64 = 0
    while i < limit {
        let ca = a.path[i as usize]
        let cb = b.path[i as usize]
        if ca < cb { return 0 - 1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if a.path_len < b.path_len { return 0 - 1 }
    if a.path_len > b.path_len { return 1 }
    0
}

fn mfst_sort_by_path(m: &! MfstFile) -> () with Mut, Panic, Div {
    var i: i64 = 1
    while i < m.count {
        let key = m.entries[i as usize]
        var j = i - 1
        while j >= 0 {
            if mfst_compare_entries(&m.entries[j as usize], &key) <= 0 {
                break
            }
            m.entries[(j + 1) as usize] = m.entries[j as usize]
            if j == 0 {
                j = 0 - 1
                break
            }
            j = j - 1
        }
        m.entries[(j + 1) as usize] = key
        i = i + 1
    }
}

fn mfst_seed(seed: i64) -> MfstFile with Mut, Panic, Div {
    var m = mfst_new()
    m.count = 3
    m.valid = true

    m.entries[0].path_len = 9
    m.entries[0].path[0] = 97
    m.entries[0].path[1] = 108
    m.entries[0].path[2] = 112
    m.entries[0].path[3] = 104
    m.entries[0].path[4] = 97
    m.entries[0].path[5] = 46
    m.entries[0].path[6] = 115
    m.entries[0].path[7] = 105
    m.entries[0].path[8] = 111
    m.entries[0].hash = 100 + seed
    m.entries[0].present = true

    m.entries[1].path_len = 8
    m.entries[1].path[0] = 98
    m.entries[1].path[1] = 101
    m.entries[1].path[2] = 116
    m.entries[1].path[3] = 97
    m.entries[1].path[4] = 46
    m.entries[1].path[5] = 115
    m.entries[1].path[6] = 105
    m.entries[1].path[7] = 111
    m.entries[1].hash = 200 + seed
    m.entries[1].present = true

    m.entries[2].path_len = 9
    m.entries[2].path[0] = 103
    m.entries[2].path[1] = 97
    m.entries[2].path[2] = 109
    m.entries[2].path[3] = 109
    m.entries[2].path[4] = 97
    m.entries[2].path[5] = 46
    m.entries[2].path[6] = 115
    m.entries[2].path[7] = 105
    m.entries[2].path[8] = 111
    m.entries[2].hash = 300 + seed
    m.entries[2].present = true

    m
}

fn mfst_test_template(seed: i64) -> bool with Mut, Panic, Div {
    let m = mfst_seed(seed)
    if mfst_count(&m) != 3 { return false }
    let p0 = mfst_entry_path(&m, 0)
    str_len(p0) > 0
}

fn test_001_mfst_cycle_001() -> bool with Mut, Panic, Div {
    var m = mfst_seed(1)
    let ok = mfst_remove(&! m, "beta.sio")
    if !ok { return false }
    true
}

fn test_002_mfst_cycle_002() -> bool with Mut, Panic, Div {
    var m = mfst_seed(2)
    let ok = mfst_update_hash(&! m, "alpha.sio", 2 * 99)
    if !ok { return false }
    true
}

fn test_003_mfst_cycle_003() -> bool with Mut, Panic, Div {
    let old = mfst_seed(3)
    let newm = mfst_seed(3 + 1)
    let d = mfst_diff(&old, &newm)
    if mfst_diff_added(&d) < 0 { return false }
    if mfst_diff_changed(&d) < 0 { return false }
    mfst_test_template(3)
}

fn test_004_mfst_cycle_004() -> bool with Mut, Panic, Div {
    var m = mfst_seed(4)
    mfst_sort_by_path(&! m)
    if 4 < 0 { return false }
    true
}

fn test_005_mfst_cycle_005() -> bool with Mut, Panic, Div {
    var m = mfst_new()
    let idx = mfst_add(&! m, "entry_005.sio", 5 * 13)
    if idx < 0 { return false }
    mfst_test_template(5)
}

