fn art_padding_block_01(seed: i64) -> i64 with Mut, Panic, Div {
    var sum: i64 = 0
    var i: i64 = 0
    while i < 20 {
        sum = sum + ((seed + i + 1) % 29)
        i = i + 1
    }
    sum
}

