// build/artifact.sio — Wave 10 artifact bundle helpers.

struct ArtEntry {
    name: [i64; 256],
    name_len: i64,
    size: i64,
    hash: i64,
    sig: [i64; 64],
}

struct ArtBundle {
    entries: [ArtEntry; 128],
    count: i64,
    version: i64,
    valid: bool,
}

struct ArtVerifyResult {
    ok: bool,
    entry_count: i64,
    failed: i64,
}

fn ART_HASH_SEED() -> i64 { 1000003 }

fn art_entry_zero() -> ArtEntry {
    ArtEntry {
        name: [0; 256],
        name_len: 0,
        size: 0,
        hash: 0,
        sig: [0; 64],
    }
}

fn art_bundle_new() -> ArtBundle with Mut {
    ArtBundle {
        entries: [art_entry_zero(); 128],
        count: 0,
        version: 1,
        valid: true,
    }
}

fn art_add_entry(b: &! ArtBundle, name: string, size: i64, hash: i64) -> i64 with Mut, Panic, Div {
    if b.count >= 128 {
        b.valid = false
        return 0 - 1
    }

    var e = art_entry_zero()
    var i: i64 = 0
    let n = str_len(name)
    while i < n && i < 256 {
        e.name[i as usize] = str_char_at(name, i)
        e.name_len = e.name_len + 1
        i = i + 1
    }
    e.size = size
    e.hash = hash

    b.entries[b.count as usize] = e
    b.count = b.count + 1
    b.valid = true
    b.count - 1
}

fn art_entry_count(b: &ArtBundle) -> i64 {
    b.count
}

fn art_compute_hash(data: string) -> i64 with Mut, Panic, Div {
    var h = ART_HASH_SEED()
    var i: i64 = 0
    let n = str_len(data)
    while i < n {
        h = ((h * 131) + str_char_at(data, i) + 17) % 2147483647
        i = i + 1
    }
    h
}

fn art_compute_hash_bytes(buf: [i64; 4096], len: i64) -> i64 with Mut, Panic, Div {
    var h = ART_HASH_SEED()
    var i: i64 = 0
    while i < len && i < 4096 {
        h = ((h * 131) + buf[i as usize] + 23) % 2147483647
        i = i + 1
    }
    h
}

fn art_verify_entry(b: &ArtBundle, idx: i64, data: string) -> bool with Mut, Panic, Div {
    if idx < 0 || idx >= b.count {
        return false
    }
    let e = b.entries[idx as usize]
    let h = art_compute_hash(data)
    let n = str_len(data)
    h == e.hash && n == e.size
}

fn art_verify_bundle(b: &ArtBundle) -> ArtVerifyResult with Mut, Panic, Div {
    var failed: i64 = 0
    var i: i64 = 0
    while i < b.count {
        let e = b.entries[i as usize]
        if e.name_len <= 0 || e.size < 0 {
            failed = failed + 1
        }
        i = i + 1
    }

    ArtVerifyResult {
        ok: failed == 0 && b.valid,
        entry_count: b.count,
        failed: failed,
    }
}

fn art_name_equals(e: &ArtEntry, name: string) -> bool with Mut, Panic, Div {
    let n = str_len(name)
    if e.name_len != n {
        return false
    }
    var i: i64 = 0
    while i < n {
        if e.name[i as usize] != str_char_at(name, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn art_find_entry(b: &ArtBundle, name: string) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < b.count {
        if art_name_equals(&b.entries[i as usize], name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn art_entry_hash(b: &ArtBundle, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= b.count {
        return 0
    }
    b.entries[idx as usize].hash
}

fn art_entry_name(b: &ArtBundle, idx: i64) -> string with Mut, Panic, Div {
    if idx < 0 || idx >= b.count {
        return ""
    }
    let e = b.entries[idx as usize]
    var out: [i8; 256] = [0; 256]
    var i: i64 = 0
    while i < e.name_len && i < 256 {
        out[i as usize] = e.name[i as usize] as i8
        i = i + 1
    }
    str_from_bytes(out, i)
}

fn art_entry_size(b: &ArtBundle, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= b.count {
        return 0
    }
    b.entries[idx as usize].size
}

fn art_bundle_version(b: &ArtBundle) -> i64 {
    b.version
}

fn art_bundle_valid(b: &ArtBundle) -> bool {
    b.valid
}

fn art_sign_entry(b: &! ArtBundle, idx: i64, key: i64) -> () with Mut, Panic, Div {
    if idx < 0 || idx >= b.count {
        b.valid = false
        return
    }
    var i: i64 = 0
    while i < 64 {
        b.entries[idx as usize].sig[i as usize] = (b.entries[idx as usize].hash + key + i) % 9973
        i = i + 1
    }
}

fn art_seed_bundle(seed: i64) -> ArtBundle with Mut, Panic, Div {
    var b = art_bundle_new()
    b.count = 2
    b.version = 1 + (seed % 9)
    b.valid = true

    b.entries[0].name_len = 5
    b.entries[0].name[0] = 97
    b.entries[0].name[1] = 108
    b.entries[0].name[2] = 112
    b.entries[0].name[3] = 104
    b.entries[0].name[4] = 97
    b.entries[0].size = 7
    b.entries[0].hash = art_compute_hash("payload")

    b.entries[1].name_len = 4
    b.entries[1].name[0] = 98
    b.entries[1].name[1] = 101
    b.entries[1].name[2] = 116
    b.entries[1].name[3] = 97
    b.entries[1].size = 4
    b.entries[1].hash = art_compute_hash("data")

    b
}

fn art_test_template(seed: i64) -> bool with Mut, Panic, Div {
    let b = art_seed_bundle(seed)
    let v = art_verify_bundle(&b)
    if v.entry_count <= 0 { return false }
    art_bundle_valid(&b)
}

fn test_001_art_cycle_001() -> bool with Mut, Panic, Div {
    var b = art_seed_bundle(1)
    art_sign_entry(&! b, 0, 17)
    if 1 < 0 { return false }
    true
}

fn test_002_art_cycle_002() -> bool with Mut, Panic, Div {
    let b = art_seed_bundle(2)
    let vr = art_verify_bundle(&b)
    if vr.failed < 0 { return false }
    if vr.entry_count <= 0 { return false }
    art_test_template(2)
}

fn test_003_art_cycle_003() -> bool with Mut, Panic, Div {
    let b = art_seed_bundle(3)
    let idx = art_find_entry(&b, "alpha")
    let nm = art_entry_name(&b, 0)
    if idx < 0 { return false }
    if str_len(nm) <= 0 { return false }
    art_test_template(3)
}

fn test_004_art_cycle_004() -> bool with Mut, Panic, Div {
    let b = art_seed_bundle(4)
    let ok0 = art_verify_entry(&b, 0, "payload")
    let size0 = art_entry_size(&b, 0)
    if size0 <= 0 { return false }
    if !ok0 { return false }
    art_test_template(4)
}

fn test_005_art_cycle_005() -> bool with Mut, Panic, Div {
    var b = art_bundle_new()
    let idx = art_add_entry(&! b, "entry_005", 5, 5 * 11)
    if idx < 0 { return false }
    art_test_template(5)
}

