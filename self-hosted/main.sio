        TokenKind::DocOuter => print("DocOuter")
        TokenKind::DocInner => print("DocInner")
        TokenKind::DocBlockOuter => print("DocBlockOuter")
        TokenKind::DocBlockInner => print("DocBlockInner")
    }
}

// ============================================================================
// TOKEN INFO PRINTER
// ============================================================================

fn print_token_info(tok: Token, source: [i8; 1048576]) with IO, Mut, Panic, Div {
    print_token_kind(tok.kind)
    print(" ")
    print_int(tok.start)
    print(":")
    print_int(tok.end)
    // Print text excerpt from source bytes
    print(" \"")
    var i = tok.start
    var count: i64 = 0
    while i < tok.end && count < 40 {
        let ch = source[i as usize]
        if ch == 10 {
            print("\\n")
        } else if ch >= 32 {
            print_char(ch)
        }
        i = i + 1
        count = count + 1
    }
    print("\"\n")
}

// ============================================================================
// ITEM SUMMARY PRINTER (for parse/resolve modes)
// ============================================================================

fn print_item_kind_label(kind: ItemKind) with IO {
    match kind {
        ItemFn => print("  fn ")
        ItemStruct => print("  struct ")
        ItemEnum => print("  enum ")
        ItemImpl => print("  impl ")
        ItemTypeAlias => print("  type ")
        ItemUse => print("  use ")
    }
}

fn print_item_kind_tag(kind: ItemKind) with IO {
    match kind {
        ItemFn => print(" (Function)")
        ItemStruct => print(" (Struct)")
        ItemEnum => print(" (Enum)")
        ItemImpl => print(" (Impl)")
        ItemTypeAlias => print(" (TypeAlias)")
        ItemUse => print(" (Use)")
    }
}

fn print_name_bytes(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i])
        i = i + 1
    }
}

fn print_items_list(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            print_item_kind_label((*list).head.kind)
            print_name_bytes((*list).head.name)
            print_item_kind_tag((*list).head.kind)
            print("\n")
            print_items_list((*list).tail)
        }
    }
}

// ============================================================================
// FILE READER — read a .sio file into the 1MB lex buffer
// ============================================================================

fn read_source_file(path: string) -> LexerState with IO, Mut, Div, Panic {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    lex(buf, size, 0)
}

// ============================================================================
// LEX PIPELINE (--lex mode)
// ============================================================================

fn run_lex_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)

    print("=== Lex Pipeline: ")
    print(path)
    print(" ===\n")
    var i: i64 = 0
    while i < state.token_count {
        print_token_info(state.tokens[i as usize], state.cursor.source)
        i = i + 1
    }

    print("Total tokens: ")
    print_int(state.token_count)
    print("\n")
    0
}

// ============================================================================
// PARSE PIPELINE (--parse mode)
// ============================================================================

fn run_parse_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program(state.tokens, state.token_count)
    let ic = count_items(prog)

    print("Items: ")
    print_int(ic)
    print("\n")
    print_items_list(prog.items)
    print("Parse OK: ")
    print_int(ic)
    print(" items from ")
    print_int(state.token_count)
    print(" tokens\n")
    0
}

// ============================================================================
// RESOLVE PIPELINE (--resolve mode)
// ============================================================================

fn run_resolve_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program(state.tokens, state.token_count)
    let ic = count_items(prog)
    let result = resolve_program(prog)

    print("Items: ")
    print_int(ic)
    print("\n")
    print("Symbols defined: ")
    print_int(result.symbols.count)
    print("\n")
    print("Resolve OK: ")
    print_int(result.error_count)
    print(" errors\n")
    0
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    let argc = arg_count()
    if argc == 0 {
        // No args: run test suite
        run_all_tests()
    } else if argc >= 2 {
        let mode = get_arg(0)
        let path = get_arg(1)
        if str_eq(mode, "--lex") {
            run_lex_pipeline(path)
        } else if str_eq(mode, "--parse") {
            run_parse_pipeline(path)
        } else if str_eq(mode, "--resolve") {
            run_resolve_pipeline(path)
        } else {
            print("Unknown mode: ")
            print(mode)
            print("\nUsage: souc run self-hosted/ -- --lex|--parse|--resolve <path.sio>\n")
            1
        }
    } else {
        print("Usage: souc run self-hosted/ -- --lex|--parse|--resolve <path.sio>\n")
        1
    }
}
