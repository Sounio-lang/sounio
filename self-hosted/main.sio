// self-hosted::main — Entry point for the self-hosted compiler
//
// Mode detection via CLI args (after `--`):
//   - No args: run test suite
//   - --lex <path>: lex mode (tokenize, print tokens)
//   - --parse <path>: parse mode (lex + parse, print item summary)
//   - --resolve <path>: resolve mode (lex + parse + resolve)

// ============================================================================
// TOKEN KIND NAME PRINTER
// ============================================================================

fn print_token_kind(kind: TokenKind) with IO {
    match kind {
        TokenKind::Eof => print("Eof")
        TokenKind::Error => print("Error")
        TokenKind::Newline => print("Newline")
        TokenKind::Module => print("Module")
        TokenKind::Import => print("Import")
        TokenKind::Use => print("Use")
        TokenKind::Export => print("Export")
        TokenKind::Fn => print("Fn")
        TokenKind::Let => print("Let")
        TokenKind::Var => print("Var")
        TokenKind::Mut => print("Mut")
        TokenKind::Const => print("Const")
        TokenKind::Type => print("Type")
        TokenKind::Struct => print("Struct")
        TokenKind::Enum => print("Enum")
        TokenKind::Trait => print("Trait")
        TokenKind::Impl => print("Impl")
        TokenKind::If => print("If")
        TokenKind::Else => print("Else")
        TokenKind::Match => print("Match")
        TokenKind::For => print("For")
        TokenKind::While => print("While")
        TokenKind::Loop => print("Loop")
        TokenKind::Break => print("Break")
        TokenKind::Continue => print("Continue")
        TokenKind::Return => print("Return")
        TokenKind::In => print("In")
        TokenKind::As => print("As")
        TokenKind::Where => print("Where")
        TokenKind::Pub => print("Pub")
        TokenKind::SelfLower => print("self")
        TokenKind::SelfUpper => print("Self")
        TokenKind::True => print("True")
        TokenKind::False => print("False")
        TokenKind::Is => print("Is")
        TokenKind::Unsafe => print("Unsafe")
        TokenKind::Extern => print("Extern")
        TokenKind::Static => print("Static")
        TokenKind::Effect => print("Effect")
        TokenKind::Handler => print("Handler")
        TokenKind::Handle => print("Handle")
        TokenKind::With => print("With")
        TokenKind::Perform => print("Perform")
        TokenKind::Resume => print("Resume")
        TokenKind::Linear => print("Linear")
        TokenKind::Affine => print("Affine")
        TokenKind::Move => print("Move")
        TokenKind::Copy => print("Copy")
        TokenKind::Drop => print("Drop")
        TokenKind::Ref => print("Ref")
        TokenKind::Dyn => print("Dyn")
        TokenKind::Box => print("Box")
        TokenKind::Async => print("Async")
        TokenKind::Await => print("Await")
        TokenKind::Spawn => print("Spawn")
        TokenKind::Kernel => print("Kernel")
        TokenKind::Uncertain => print("Uncertain")
        TokenKind::Belief => print("Belief")
        TokenKind::Evidence => print("Evidence")
        TokenKind::Confidence => print("Confidence")
        TokenKind::Prior => print("Prior")
        TokenKind::Posterior => print("Posterior")
        TokenKind::Likelihood => print("Likelihood")
        TokenKind::Entropy => print("Entropy")
        TokenKind::Observe => print("Observe")
        TokenKind::Sample => print("Sample")
        TokenKind::Infer => print("Infer")
        TokenKind::Super => print("Super")
        TokenKind::Crate => print("Crate")
        TokenKind::Ident => print("Ident")
        TokenKind::IntLit => print("IntLit")
        TokenKind::FloatLit => print("FloatLit")
        TokenKind::StringLit => print("StringLit")
        TokenKind::CharLit => print("CharLit")
        TokenKind::BoolLit => print("BoolLit")
        TokenKind::HexLit => print("HexLit")
        TokenKind::BinLit => print("BinLit")
        TokenKind::OctLit => print("OctLit")
        TokenKind::Plus => print("+")
        TokenKind::Minus => print("-")
        TokenKind::Star => print("*")
        TokenKind::Slash => print("/")
        TokenKind::Percent => print("%")
        TokenKind::Eq => print("=")
        TokenKind::Lt => print("<")
        TokenKind::Gt => print(">")
        TokenKind::Bang => print("!")
        TokenKind::Amp => print("&")
        TokenKind::Pipe => print("|")
        TokenKind::Caret => print("^")
        TokenKind::Tilde => print("~")
        TokenKind::Question => print("?")
        TokenKind::EqEq => print("==")
        TokenKind::BangEq => print("!=")
        TokenKind::LtEq => print("<=")
        TokenKind::GtEq => print(">=")
        TokenKind::AmpAmp => print("&&")
        TokenKind::PipePipe => print("||")
        TokenKind::Shl => print("<<")
        TokenKind::Shr => print(">>")
        TokenKind::PlusEq => print("+=")
