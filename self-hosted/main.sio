// ============================================================================
// TOKEN INFO PRINTER
// ============================================================================

fn print_token_info(tok: Token) with IO, Mut, Panic, Div {
    print_token_kind(tok.kind)
    print(" ")
    print_int(tok.start)
    print(":")
    print_int(tok.end)
    // Print text excerpt from source bytes
    print(" \"")
    var i = tok.start
    var count: i64 = 0
    while i < tok.end && count < 40 {
        let ch = cursor_source_byte(i)
        if ch == 10 as i8 {
            print("\\n")
        } else if ch >= 32 as i8 {
            print_char(ch as i64)
        }
        i = i + 1
        count = count + 1
    }
    print("\"\n")
}

// ============================================================================
// ITEM SUMMARY PRINTER (for parse/resolve modes)
// ============================================================================

fn print_item_kind_label(kind: ItemKind) with IO {
    match kind {
        ItemFn => print("  fn ")
        ItemStruct => print("  struct ")
        ItemEnum => print("  enum ")
        ItemImpl => print("  impl ")
        ItemTypeAlias => print("  type ")
        ItemModels => print("  models ")
        ItemPolicy => print("  policy ")
        ItemAcquisitionPolicy => print("  acquisition_policy ")
        ItemRecoursePolicy => print("  recourse_policy ")
        ItemDecisionPolicy => print("  decision_policy ")
        ItemDeferralPolicy => print("  deferral_policy ")
        ItemValidation => print("  validation ")
        ItemAudit => print("  audit ")
        ItemUse => print("  use ")
        ItemUnit => print("  unit ")
    }
}

fn print_item_kind_tag(kind: ItemKind) with IO {
    match kind {
        ItemFn => print(" (Function)")
        ItemStruct => print(" (Struct)")
        ItemEnum => print(" (Enum)")
        ItemImpl => print(" (Impl)")
        ItemTypeAlias => print(" (TypeAlias)")
        ItemModels => print(" (Models)")
        ItemPolicy => print(" (Policy)")
        ItemAcquisitionPolicy => print(" (AcquisitionPolicy)")
        ItemRecoursePolicy => print(" (RecoursePolicy)")
        ItemDecisionPolicy => print(" (DecisionPolicy)")
        ItemDeferralPolicy => print(" (DeferralPolicy)")
        ItemValidation => print(" (Validation)")
        ItemAudit => print(" (Audit)")
        ItemUse => print(" (Use)")
        ItemUnit => print(" (Unit)")
    }
}

fn print_name_bytes(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn print_items_list(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match items {
        None => {}
        Some(list) => {
            print_item_kind_label((*list).head.kind)
            print_name_bytes((*list).head.name)
            print_item_kind_tag((*list).head.kind)
            print("\n")
            print_items_list((*list).tail)
        }
    }
}

// ============================================================================
// FILE READER — read a .sio file into the 1MB lex buffer
// ============================================================================

fn read_source_file(path: string) -> LexerState with IO, Mut, Div, Panic {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    // Convert `buf` to an exclusive reference-backed value so repeated indexed
    // writes mutate in place instead of cloning the sparse backing map.
    let buf_ref = &!buf
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf_ref[i as usize] = data[i as usize]
        i = i + 1
    }
    lex(buf, size, 0)
}

// ============================================================================
// LEX PIPELINE (--lex mode)
// ============================================================================

fn run_lex_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)

    print("=== Lex Pipeline: ")
    print(path)
    print(" ===\n")
    var i: i64 = 0
    while i < state.token_count {
        print_token_info(state.tokens[i as usize])
        i = i + 1
    }

    print("Total tokens: ")
    print_int(state.token_count)
    print("\n")
    0
}

// ============================================================================
// PARSE PIPELINE (--parse mode)
// ============================================================================

fn run_parse_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    let ic = count_items(prog)

    print("Items: ")
    print_int(ic)
    print("\n")
    print_items_list(prog.items)
    print("Parse OK: ")
    print_int(ic)
    print(" items from ")
    print_int(state.token_count)
    print(" tokens\n")
    0
}

// ============================================================================
// RESOLVE PIPELINE (--resolve mode)
// ============================================================================

fn run_resolve_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    let ic = count_items(prog)
    let result = resolve_program(prog)

    print("Items: ")
    print_int(ic)
    print("\n")
    print("Symbols defined: ")
    print_int(result.symbols.count)
    print("\n")
    print("Resolve OK: ")
    print_int(result.error_count)
    print(" errors\n")
    0
}

// ============================================================================
// CHECK PIPELINE (check mode)
// ============================================================================

fn maybe_print_item_count(prog: Program, enabled: bool) with IO, Mut, Div, Panic, Alloc {
    if enabled {
        let ic = count_items(prog)
        print("Items: ")
        print_int(ic)
        print("\n")
    }
}

fn maybe_print_fast_skip_blocks_warning(enabled: bool) with IO {
    if enabled {
        print("Warning: --fast-skip-blocks is enabled; block-body checking is skipped and results are non-exhaustive\n")
    }
}

fn fail_if_parse_errors() -> bool with IO {
    if parser_last_had_error() || parser_last_error_count() > 0 {
        print("Parse errors: ")
        print_int(parser_last_error_count())
        print("\n")
        true
    } else {
        false
    }
}

fn run_check_pipeline(path: string, fast_skip_blocks: bool, show_item_count: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(true)
    }
    let prog = parse_program_preloaded(state.token_count)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(false)
    }
    maybe_print_fast_skip_blocks_warning(fast_skip_blocks)
    maybe_print_item_count(prog, show_item_count)
    if fail_if_parse_errors() {
        return 1
    }
    let result = check_program(prog)
    if result.had_error {
        print("Check errors: ")
        print_int(result.error_count)
        print("\n")
        return 1
    }

    print("Check OK: ")
    print_int(result.error_count)
    print(" errors\n")
    0
}

// Write raw bytes to a file (VM builtin)
fn write_bytes_to_file(path: string, data: [i8; 65536], len: i64) -> bool with IO {
    let result = write_file(path, data, len)
    result >= 0
}

fn write_small_bytes_to_file(path: string, data: [i8; 131072], len: i64) -> bool with IO, Mut, Div, Panic {
    write_file(path, data, len) >= 0
}

// Write ELF binary to disk
fn write_elf_to_file(path: string, elf: Elf64Binary) -> bool with IO, Mut {
    write_file(path, elf.bytes, elf.len) >= 0
}

// Read a single environment variable from /proc/self/environ.
// Returns empty string when not found or unavailable.
fn main_read_env(key: string) -> string with IO, Mut, Div, Panic {
    let env_path = "/proc/self/environ"
    let size = file_size(env_path)
    if size <= 0 {
        return ""
    }
    let data = read_file(env_path)
    let key_len = str_len(key)
    if key_len <= 0 {
        return ""
    }

    var i: i64 = 0
    while i < size {
        var j: i64 = 0
        var matches: bool = true
        while j < key_len {
            if i + j >= size {
                matches = false
                break
            }
            if data[(i + j) as usize] != (str_char_at(key, j) as i8) {
                matches = false
                break
            }
            j = j + 1
        }

        if matches && i + key_len < size && data[(i + key_len) as usize] == (61 as i8) {
            let value_start = i + key_len + 1
            var value_end = value_start
            while value_end < size && data[value_end as usize] != 0 {
                value_end = value_end + 1
            }

            var out: [i8; 512] = [0; 512]
            var out_len: i64 = 0
            var k = value_start
            while k < value_end && out_len < 512 {
                out[out_len as usize] = data[k as usize]
                out_len = out_len + 1
                k = k + 1
            }
            return str_from_bytes(out, out_len)
        }

        while i < size && data[i as usize] != 0 {
            i = i + 1
        }
        i = i + 1
    }
    ""
}

// ============================================================================
// GPU-EMIT PIPELINE (--gpu-emit mode) — Sprint 28
// ============================================================================

fn run_gpu_emit_pipeline(path: string, target: string, use_autotune: bool, use_fusion: bool, use_epistemic: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    if fail_if_parse_errors() {
        return 1
    }

    // Resolve
    let resolve_result = resolve_program(prog)
    if resolve_result.had_error {
        print("Resolve errors: ")
        print_int(resolve_result.error_count)
        print("\n")
        return 1
    }

    // Check
    let check_result = check_program(prog)
    if check_result.had_error {
        print("Check errors: ")
        print_int(check_result.error_count)
        print("\n")
        return 1
    }

    // Lower AST to HLIR SSA
    let hlir_module = hlir_lower_module(prog)

    // Count kernels
    let kcount = hlir_extract_kernel_count(hlir_module)
    if kcount == 0 {
        print("No kernel functions found in ")
        print(path)
        print("\n")
        return 1
    }

    // Emit PTX (default) or Metal
    if str_eq(target, "metal") {
        let metal = hlir_kernels_to_metal(hlir_module)
        metal_buf_print(metal)
    } else if use_epistemic {
        let ptx = hlir_kernels_to_epistemic_ptx(hlir_module)
        ptx_buf_print(ptx)
    } else if use_fusion {
        let ptx = hlir_kernels_to_fused_ptx(hlir_module)
        ptx_buf_print(ptx)
    } else if use_autotune {
        let ptx = hlir_kernels_to_tuned_ptx(hlir_module)
        ptx_buf_print(ptx)
    } else {
        // Default: PTX without optimization
        let ptx = hlir_kernels_to_ptx(hlir_module)
        ptx_buf_print(ptx)
    }

    print_int(kcount)
    print(" kernel(s) emitted\n")
    0
}

// IR VERIFICATION PIPELINES (--ir-verify, --ir-roundtrip)
// ============================================================================

fn run_ir_verify_pipeline(path_a: string, path_b: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    // Compile file A
    let state_a = read_source_file(path_a)
    let prog_a = parse_program_preloaded(state_a.token_count)
    if fail_if_parse_errors() {
        print("ir-verify: parse error in ")
        print(path_a)
        print("\n")
        return 1
    }
    let res_a = resolve_program(prog_a)
    if res_a.had_error {
        print("ir-verify: resolve error in ")
        print(path_a)
        print("\n")
        return 1
    }
    let chk_a = check_program(prog_a)
    if chk_a.had_error {
        print("ir-verify: check error in ")
        print(path_a)
        print("\n")
        return 1
    }
    let low_a = lower_program_to_ir(prog_a)
    if low_a.had_error {
        print("ir-verify: lower error in ")
        print(path_a)
        print("\n")
        return 1
    }

    // Compile file B
    let state_b = read_source_file(path_b)
    let prog_b = parse_program_preloaded(state_b.token_count)
    if fail_if_parse_errors() {
        print("ir-verify: parse error in ")
        print(path_b)
        print("\n")
        return 1
    }
    let res_b = resolve_program(prog_b)
    if res_b.had_error {
        print("ir-verify: resolve error in ")
        print(path_b)
        print("\n")
        return 1
    }
    let chk_b = check_program(prog_b)
    if chk_b.had_error {
        print("ir-verify: check error in ")
        print(path_b)
        print("\n")
        return 1
    }
    let low_b = lower_program_to_ir(prog_b)
    if low_b.had_error {
        print("ir-verify: lower error in ")
        print(path_b)
        print("\n")
        return 1
    }

    let code = verify_ir_equivalence(low_a.module, low_b.module)
    if code == 0 {
        print("ir-verify: EQUIVALENT\n")
        0
    } else {
        print("ir-verify: DIFFERENT code=")
        print_int(code)
        print("\n")
        1
    }
}

fn run_ir_roundtrip_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    if fail_if_parse_errors() {
        print("ir-roundtrip: parse error in ")
        print(path)
        print("\n")
        return 1
    }
    let res = resolve_program(prog)
    if res.had_error {
        print("ir-roundtrip: resolve error in ")
        print(path)
        print("\n")
        return 1
    }
    let chk = check_program(prog)
    if chk.had_error {
        print("ir-roundtrip: check error in ")
        print(path)
        print("\n")
        return 1
    }
    let low = lower_program_to_ir(prog)
    if low.had_error {
        print("ir-roundtrip: lower error in ")
        print(path)
        print("\n")
        return 1
    }
    // Serialize
    let pair_a = serialize_ir_module(low.module)
    let buf_a = pair_a.0
    let len_a = pair_a.1
    // Deserialize
    let restored = deserialize_ir_module(buf_a, len_a)
    // Re-serialize
    let pair_b = serialize_ir_module(restored)
    let buf_b = pair_b.0
    let len_b = pair_b.1
    // Compare
    if len_a != len_b {
        print("ir-roundtrip: FAIL length mismatch ")
        print_int(len_a)
        print(" vs ")
        print_int(len_b)
        print("\n")
        return 1
    }
    var i: i64 = 0
    while i < len_a {
        if buf_a[i] != buf_b[i] {
            print("ir-roundtrip: FAIL at byte ")
            print_int(i)
            print("\n")
            return 1
        }
        i = i + 1
    }
    print("ir-roundtrip: OK (")
    print_int(len_a)
    print(" bytes)\n")
    0
}

// DISASM + IR-DUMP PIPELINES
// ============================================================================

fn run_disasm_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    if fail_if_parse_errors() {
        print("disasm: parse error\n")
        return 1
    }
    let res = resolve_program(prog)
    if res.had_error {
        print("disasm: resolve error\n")
        return 1
    }
    let chk = check_program(prog)
    if chk.had_error {
        print("disasm: check error\n")
        return 1
    }
    let low = lower_program_to_ir(prog)
    if low.had_error {
        print("disasm: lower error\n")
        return 1
    }
    disassemble_module(low.module)
    0
}

fn run_ir_dump_pipeline(path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    let prog = parse_program_preloaded(state.token_count)
    if fail_if_parse_errors() {
        print("ir-dump: parse error\n")
        return 1
    }
    let res = resolve_program(prog)
    if res.had_error {
        print("ir-dump: resolve error\n")
        return 1
    }
    let chk = check_program(prog)
    if chk.had_error {
        print("ir-dump: check error\n")
        return 1
    }
    let low = lower_program_to_ir(prog)
    if low.had_error {
        print("ir-dump: lower error\n")
        return 1
    }
    let pair = serialize_ir_module(low.module)
    let len = pair.1
    print("ir-dump: SOIR v2 binary, ")
    print_int(len)
    print(" bytes, ")
    print_int(low.module.fn_count)
    print(" functions, ")
    print_int(low.module.string_count)
    print(" strings\n")
    0
}

// COMPILE PIPELINE (--compile mode)
// ============================================================================

fn run_compile_pipeline(path: string, fast_skip_blocks: bool, show_item_count: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(true)
    }
    let prog = parse_program_preloaded(state.token_count)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(false)
    }
    maybe_print_fast_skip_blocks_warning(fast_skip_blocks)
    maybe_print_item_count(prog, show_item_count)
    if fail_if_parse_errors() {
        return 1
    }

    // Resolve
    let resolve_result = resolve_program(prog)
    if resolve_result.had_error {
        print("Resolve errors: ")
        print_int(resolve_result.error_count)
        print("\n")
        return 1
    }

    // Check
    let check_result = check_program(prog)
    if check_result.had_error {
        print("Check errors: ")
        print_int(check_result.error_count)
        print("\n")
        return 1
    }

    // Lower to IR
    let lower_result = lower_program_to_ir(prog)
    if lower_result.had_error {
        print("Lower errors: ")
        print_int(lower_result.error_count)
        print("\n")
        return 1
    }

    // Serialize to SOIR
    let serialized = serialize_ir_module(lower_result.module)
    let bytecode_len = serialized.1

    print("Compile OK: ")
    print_int(bytecode_len)
    print(" bytes of bytecode\n")
    0
}

fn run_compile_pipeline_with_output(path: string, output_path: string, fast_skip_blocks: bool, show_item_count: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(true)
    }
    let prog = parse_program_preloaded(state.token_count)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(false)
    }
    maybe_print_fast_skip_blocks_warning(fast_skip_blocks)
    maybe_print_item_count(prog, show_item_count)
    if fail_if_parse_errors() {
        return 1
    }

    // Resolve
    let resolve_result = resolve_program(prog)
    if resolve_result.had_error {
        print("Resolve errors: ")
        print_int(resolve_result.error_count)
        print("\n")
        return 1
    }

    // Check
    let check_result = check_program(prog)
    if check_result.had_error {
        print("Check errors: ")
        print_int(check_result.error_count)
        print("\n")
        return 1
    }

    // Lower to IR
    let lower_result = lower_program_to_ir(prog)
    if lower_result.had_error {
        print("Lower errors: ")
        print_int(lower_result.error_count)
        print("\n")
        return 1
    }

    // Serialize to SOIR
    let serialized = serialize_ir_module(lower_result.module)
    let bytecode_len = serialized.1

    let write_ok = write_small_bytes_to_file(output_path, serialized.0, bytecode_len)
    if !write_ok {
        print("Error: Failed to write bytecode artifact to ")
        print(output_path)
        print("\n")
        return 1
    }

    print("Compile OK: ")
    print_int(bytecode_len)
    print(" bytes of bytecode\n")
    print("Wrote bytecode artifact: ")
    print(output_path)
    print("\n")
    0
}

// ============================================================================
// COMPILE PIPELINE (NATIVE) — Phase 6: Native ELF Backend
// ============================================================================

fn native_trace_output_path() -> string {
    let override_path = main_read_env("SOUNIO_NATIVE_DECISION_TRACE_PATH")
    if str_len(override_path) > 0 {
        override_path
    } else {
        "artifacts/omega/native_decision_trace.v1.json"
    }
}

fn native_v2_contract_output_path() -> string {
    let override_path = main_read_env("SOUNIO_NATIVE_V2_CONTRACT_PATH")
    if str_len(override_path) > 0 {
        override_path
    } else {
        "artifacts/omega/native_backend_v2_contract.v1.json"
    }
}

fn native_v2_shadow_contract_output_path() -> string {
    let override_path = main_read_env("SOUNIO_NATIVE_V2_SHADOW_CONTRACT_PATH")
    if str_len(override_path) > 0 {
        override_path
    } else {
        "artifacts/omega/native_backend_v2_shadow_contract.v1.json"
    }
}

fn native_write_decision_trace(spec: NativeTargetSpec, backend: string, ok: bool, error_code: i64) -> bool with IO, Mut, Panic, Div {
    io_write_native_decision_trace(
        native_trace_output_path(),
        spec.requested_target,
        spec.resolved_target,
        native_matrix_mode_string(spec.matrix_mode),
        native_target_source_string(spec.source_id),
        spec.fallback_reason,
        backend,
        ok,
        error_code
    )
}

fn native_print_dispatch(spec: NativeTargetSpec) with IO {
    print("Native dispatch: requested=")
    print(spec.requested_target)
    print(" resolved=")
    print(spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(spec.source_id))
    if str_len(spec.fallback_reason) > 0 {
        print(" fallback=")
        print(spec.fallback_reason)
    }
    print("\n")
}

fn run_compile_pipeline_native(path: string, output_path: string, fast_skip_blocks: bool, show_item_count: bool, target_spec: NativeTargetSpec, backend_label: string, use_native_v2_preview: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(path)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(true)
    }
    let prog = parse_program_preloaded(state.token_count)
    if fast_skip_blocks {
        parser_set_fast_skip_blocks(false)
    }
    maybe_print_fast_skip_blocks_warning(fast_skip_blocks)
    maybe_print_item_count(prog, show_item_count)
    if fail_if_parse_errors() {
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, ERR_OK())
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        return 1
    }

    // Resolve
    let resolve_result = resolve_program(prog)
    if resolve_result.had_error {
        print("Resolve errors: ")
        print_int(resolve_result.error_count)
        print("\n")
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, ERR_OK())
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        return 1
    }

    // Check
    let check_result = check_program(prog)
    if check_result.had_error {
        print("Check errors: ")
        print_int(check_result.error_count)
        print("\n")
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, ERR_OK())
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        return 1
    }

    // Lower to IR
    let lower_result = lower_program_to_ir(prog)
    if lower_result.had_error {
        print("Lower errors: ")
        print_int(lower_result.error_count)
        print("\n")
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, ERR_OK())
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        return 1
    }

    // Native compile dispatch
    let native_result = if use_native_v2_preview {
        compile_native_v2_preview(&lower_result.module, target_spec)
    } else {
        compile_native(&lower_result.module, target_spec)
    }
    if use_native_v2_preview {
        let contract_ok = native_v2_write_contract(
            native_v2_contract_output_path(),
            &lower_result.module,
            target_spec,
            native_result.ok,
            native_result.error_code,
            output_path
        )
        if !contract_ok {
            print("Error: Failed to write native v2 contract to ")
            print(native_v2_contract_output_path())
            print("\n")
            return 1
        }
        let compat_ok = native_v2_write_contract(
            native_v2_shadow_contract_output_path(),
            &lower_result.module,
            target_spec,
            native_result.ok,
            native_result.error_code,
            output_path
        )
        if !compat_ok {
            print("Error: Failed to write native v2 shadow compatibility contract to ")
            print(native_v2_shadow_contract_output_path())
            print("\n")
            return 1
        }
    }
    if !native_result.ok {
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, native_result.error_code)
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        print("Native compilation failed: ")
        print(native_result.error_msg)
        print("\n")
        return 1
    }

    print("Native binary size: ")
    print_int(native_result.len)
    print(" bytes\n")

    let write_ok = write_small_bytes_to_file(output_path, native_result.bytes, native_result.len)
    if !write_ok {
        let trace_ok = native_write_decision_trace(target_spec, backend_label, false, ERR_OK())
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(native_trace_output_path())
            print("\n")
            return 1
        }
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let trace_ok = native_write_decision_trace(target_spec, backend_label, true, ERR_OK())
    if !trace_ok {
        print("Error: Failed to write native decision trace to ")
        print(native_trace_output_path())
        print("\n")
        return 1
    }

    print("Native compilation successful: ")
    print(output_path)
    print("\n")
    print("Binary is executable (mode 0755)\n")
    0
}

fn parse_decimal_digit(ch: string) -> i64 {
    if str_eq(ch, "0") { 0 }
    else if str_eq(ch, "1") { 1 }
    else if str_eq(ch, "2") { 2 }
    else if str_eq(ch, "3") { 3 }
    else if str_eq(ch, "4") { 4 }
    else if str_eq(ch, "5") { 5 }
    else if str_eq(ch, "6") { 6 }
    else if str_eq(ch, "7") { 7 }
    else if str_eq(ch, "8") { 8 }
    else if str_eq(ch, "9") { 9 }
    else { -1 }
}

fn parse_nonnegative_i64(raw: string) -> i64 with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return -1
    }

    var i: i64 = 0
    var value: i64 = 0
    while i < len {
        let ch = str_slice(raw, i, i + 1)
        let d = parse_decimal_digit(ch)
        if d < 0 {
            return -1
        }
        value = value * 10 + d
        i = i + 1
    }
    value
}

fn parse_all_cli_default_shard_mode() -> i64 {
    1
}

fn parse_all_cli_shard_mode_label(shard_mode: i64) -> string {
    if shard_mode == 1 { "balanced" } else { "mod" }
}

fn parse_all_cli_shard_mode_parse(raw: string) -> i64 {
    if str_eq(raw, "mod") {
        0
    } else if str_eq(raw, "balanced") {
        1
    } else {
        -1
    }
}

fn parse_all_cli_shard_mode_from_optional(argc: i64, arg_index: i64) -> i64 {
    if argc <= arg_index {
        parse_all_cli_default_shard_mode()
    } else {
        parse_all_cli_shard_mode_parse(get_arg(arg_index))
    }
}

struct ParseAllShardRunStats {
    executed: i64,
    passed: i64,
    failed: i64,
    invalid: i64,
}

fn parse_all_shard_run_stats_empty() -> ParseAllShardRunStats {
    ParseAllShardRunStats {
        executed: 0,
        passed: 0,
        failed: 0,
        invalid: 0,
    }
}

fn parse_all_shard_run_stats_add(a: ParseAllShardRunStats, b: ParseAllShardRunStats) -> ParseAllShardRunStats {
    ParseAllShardRunStats {
        executed: a.executed + b.executed,
        passed: a.passed + b.passed,
        failed: a.failed + b.failed,
        invalid: a.invalid + b.invalid,
    }
}

fn str_find_char(raw: string, needle: string) -> i64 with Mut, Div {
    let len = str_len(raw)
    var i: i64 = 0
    while i < len {
        if str_eq(str_slice(raw, i, i + 1), needle) {
            return i
        }
        i = i + 1
    }
    -1
}

fn parse_all_invalid_shard_token(token: string, reason: string) -> ParseAllShardRunStats with IO {
    print("Parse All Multi-Shard: invalid token '")
    print(token)
    print("' (")
    print(reason)
    print(")\n")
    ParseAllShardRunStats {
        executed: 0,
        passed: 0,
        failed: 0,
        invalid: 1,
    }
}

fn run_parse_all_full_shard_once(shard_index: i64, shard_count: i64, shard_mode: i64) -> ParseAllShardRunStats with IO, Mut, Div, Panic, Alloc {
    let code = run_parse_all_full_shard_tests(shard_index, shard_count, shard_mode)
    if code == 0 {
        ParseAllShardRunStats {
            executed: 1,
            passed: 1,
            failed: 0,
            invalid: 0,
        }
    } else {
        ParseAllShardRunStats {
            executed: 1,
            passed: 0,
            failed: 1,
            invalid: 0,
        }
    }
}

fn run_parse_all_full_shard_token(shard_count: i64, token: string, shard_mode: i64) -> ParseAllShardRunStats with IO, Mut, Div, Panic, Alloc {
    if str_len(token) <= 0 {
        return parse_all_invalid_shard_token(token, "empty")
    }

    if str_eq(token, "all") {
        var stats = parse_all_shard_run_stats_empty()
        var shard: i64 = 0
        while shard < shard_count {
            stats = parse_all_shard_run_stats_add(stats, run_parse_all_full_shard_once(shard, shard_count, shard_mode))
            shard = shard + 1
        }
        return stats
    }

    let dash_index = str_find_char(token, "-")
    if dash_index >= 0 {
        let start_raw = str_slice(token, 0, dash_index)
        let end_raw = str_slice(token, dash_index + 1, str_len(token))
        let start = parse_nonnegative_i64(start_raw)
        let end = parse_nonnegative_i64(end_raw)

        if start < 0 || end < 0 || end < start {
            return parse_all_invalid_shard_token(token, "bad range")
        }
        if end >= shard_count {
            return parse_all_invalid_shard_token(token, "out of range")
        }

        var stats = parse_all_shard_run_stats_empty()
        var shard: i64 = start
        while shard <= end {
            stats = parse_all_shard_run_stats_add(stats, run_parse_all_full_shard_once(shard, shard_count, shard_mode))
            shard = shard + 1
        }
        return stats
    }

    let shard_index = parse_nonnegative_i64(token)
    if shard_index < 0 || shard_index >= shard_count {
        return parse_all_invalid_shard_token(token, "out of range")
    }
    run_parse_all_full_shard_once(shard_index, shard_count, shard_mode)
}

fn run_parse_all_full_shards_selector(shard_count: i64, selector: string, shard_mode: i64) -> i32 with IO, Mut, Div, Panic, Alloc {
    if shard_count <= 0 {
        print("Parse All Multi-Shard: invalid shard count\n")
        return 1
    }
    if shard_mode < 0 {
        print("Parse All Multi-Shard: invalid shard mode\n")
        return 1
    }

    let len = str_len(selector)
    if len <= 0 {
        print("Parse All Multi-Shard: empty selector\n")
        return 1
    }

    print("=== Parse All Multi-Shard ===\n")
    print("Parse All Shard Count: ")
    print_int(shard_count)
    print("\n")
    print("Parse All Shard Mode: ")
    print(parse_all_cli_shard_mode_label(shard_mode))
    print("\n")
    print("Parse All Selector: ")
    print(selector)
    print("\n")

    var stats = parse_all_shard_run_stats_empty()
    var i: i64 = 0
    var token_start: i64 = 0
    while i < len {
        let ch = str_slice(selector, i, i + 1)
        if str_eq(ch, ",") {
            let token = str_slice(selector, token_start, i)
            stats = parse_all_shard_run_stats_add(stats, run_parse_all_full_shard_token(shard_count, token, shard_mode))
            token_start = i + 1
        }
        i = i + 1
    }

    let tail = str_slice(selector, token_start, len)
    stats = parse_all_shard_run_stats_add(stats, run_parse_all_full_shard_token(shard_count, tail, shard_mode))

    print("PARSE_ALL_MULTI_SUMMARY shard_count=")
    print_int(shard_count)
    print(" shard_mode=")
    print(parse_all_cli_shard_mode_label(shard_mode))
    print(" selector=")
    print(selector)
    print(" executed=")
    print_int(stats.executed)
    print(" passed=")
    print_int(stats.passed)
    print(" failed=")
    print_int(stats.failed)
    print(" invalid=")
    print_int(stats.invalid)
    print("\n")

    if stats.executed <= 0 || stats.failed > 0 || stats.invalid > 0 { 1 } else { 0 }
}

fn kaxi_str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }

    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn kaxi_emit_selector_has(emit_selector: string, key: string) -> bool with Mut, Panic, Div {
    kaxi_str_contains(emit_selector, key)
}

fn kaxi_load_spec_text(path: string) -> string with IO, Mut, Panic, Div, Alloc {
    let bytes = read_file(path)
    let size = file_size(path)
    str_from_bytes(bytes, size)
}

fn kaxi_write_text_file(path: string, text: string) -> bool with IO, Mut, Panic, Div {
    var data: [i8; 65536] = [0; 65536]
    let n = str_len(text)
    var i: i64 = 0
    while i < n && i < 65536 {
        data[i as usize] = str_char_at(text, i) as i8
        i = i + 1
    }
    write_bytes_to_file(path, data, i)
}

fn kaxi_template_slave_verilog() -> string {
    var out = "// GENERATED_FROM_STDLIB: stdlib/hardware/kaxi.sio\n"
    out = out ++ "// GENERATED_BY: self-hosted build --target hardware-kaxi\n"
    out = out ++ "// Sounio Omega - K-AXI epistemic slave/propagation engine\n\n"
    out = out ++ "`timescale 1ns/1ps\n\n"
    out = out ++ "module k_axi_slave_epistemic #(\n"
    out = out ++ "    parameter DATA_WIDTH = 64,\n"
    out = out ++ "    parameter VAR_WIDTH = 64,\n"
    out = out ++ "    parameter PROV_WIDTH = 256,\n"
    out = out ++ "    parameter CONF_WIDTH = 128,\n"
    out = out ++ "    parameter FLAGS_WIDTH = 32,\n"
    out = out ++ "    parameter SCALE_SHIFT = 30\n"
    out = out ++ ") (\n"
    out = out ++ "    input  wire                         aclk,\n"
    out = out ++ "    input  wire                         aresetn,\n"
    out = out ++ "    input  wire [DATA_WIDTH-1:0]        s_tdata,\n"
    out = out ++ "    input  wire [VAR_WIDTH+PROV_WIDTH+CONF_WIDTH+FLAGS_WIDTH-1:0] s_tuser,\n"
    out = out ++ "    input  wire                         s_tvalid,\n"
    out = out ++ "    output wire                         s_tready,\n"
    out = out ++ "    output reg  [DATA_WIDTH-1:0]        out_value,\n"
    out = out ++ "    output reg  [VAR_WIDTH-1:0]         out_variance,\n"
    out = out ++ "    output reg  [PROV_WIDTH-1:0]        out_prov,\n"
    out = out ++ "    output reg  [CONF_WIDTH-1:0]        out_conf,\n"
    out = out ++ "    output reg  [FLAGS_WIDTH-1:0]       out_flags,\n"
    out = out ++ "    output reg                          out_valid,\n"
    out = out ++ "    input  wire                         downstream_ready,\n"
    out = out ++ "    output reg  [31:0]                  gum_fidelity_inc,\n"
    out = out ++ "    output reg  [31:0]                  provenance_depth_inc,\n"
    out = out ++ "    output reg  [31:0]                  formal_coverage_inc\n"
    out = out ++ ");\n\n"
    out = out ++ "    localparam [255:0] PROV_SALT = 256'h4B5F4158495F4D45524B4C455F4550495354454D49435F4255535F7631A5A5A5;\n"
    out = out ++ "    localparam OP_ADD = 4'h1;\n"
    out = out ++ "    localparam OP_MUL = 4'h2;\n"
    out = out ++ "    localparam OP_DIV = 4'h3;\n"
    out = out ++ "    localparam OP_FMA = 4'h4;\n\n"
    out = out ++ "    wire accept = s_tvalid && s_tready;\n"
    out = out ++ "    assign s_tready = !out_valid || downstream_ready;\n\n"
    out = out ++ "    wire [63:0] in_variance = s_tuser[63:0];\n"
    out = out ++ "    wire [255:0] in_prov = s_tuser[319:64];\n"
    out = out ++ "    wire [127:0] in_conf = s_tuser[447:320];\n"
    out = out ++ "    wire [31:0] in_flags = s_tuser[479:448];\n\n"
    out = out ++ "    wire [3:0] op_kind = in_flags[3:0];\n"
    out = out ++ "    wire [7:0] failure_inc = in_flags[15:8];\n"
    out = out ++ "    wire [7:0] success_inc = in_flags[23:16];\n"
    out = out ++ "    wire [7:0] alpha_q8 = in_flags[31:24];\n"
    out = out ++ "    wire [63:0] in_alpha = in_conf[127:64];\n"
    out = out ++ "    wire [63:0] in_beta = in_conf[63:0];\n"
    out = out ++ "    wire [63:0] shifted_abs = s_tdata[63] ? ((~s_tdata + 64'd1) >> SCALE_SHIFT) : (s_tdata >> SCALE_SHIFT);\n\n"
    out = out ++ "    reg [63:0] op_var;\n"
    out = out ++ "    reg [127:0] degradation_full;\n"
    out = out ++ "    reg [63:0] degradation_var;\n\n"
    out = out ++ "    always @(*) begin\n"
    out = out ++ "        case (op_kind)\n"
    out = out ++ "            OP_ADD: op_var = in_variance + (in_variance >> 1);\n"
    out = out ++ "            OP_MUL: op_var = (in_variance >> 1) + (in_variance >> 2);\n"
    out = out ++ "            OP_DIV: op_var = (in_variance >> 1) + (in_variance >> 3);\n"
    out = out ++ "            OP_FMA: op_var = in_variance + shifted_abs;\n"
    out = out ++ "            default: op_var = in_variance;\n"
    out = out ++ "        endcase\n"
    out = out ++ "        degradation_full = in_variance * alpha_q8;\n"
    out = out ++ "        degradation_var = degradation_full[71:8];\n"
    out = out ++ "    end\n\n"
    out = out ++ "    always @(posedge aclk or negedge aresetn) begin\n"
    out = out ++ "        if (!aresetn) begin\n"
    out = out ++ "            out_value <= {DATA_WIDTH{1'b0}};\n"
    out = out ++ "            out_variance <= {VAR_WIDTH{1'b0}};\n"
    out = out ++ "            out_prov <= {PROV_WIDTH{1'b0}};\n"
    out = out ++ "            out_conf <= {CONF_WIDTH{1'b0}};\n"
    out = out ++ "            out_flags <= {FLAGS_WIDTH{1'b0}};\n"
    out = out ++ "            out_valid <= 1'b0;\n"
    out = out ++ "            gum_fidelity_inc <= 32'd0;\n"
    out = out ++ "            provenance_depth_inc <= 32'd0;\n"
    out = out ++ "            formal_coverage_inc <= 32'd0;\n"
    out = out ++ "        end else begin\n"
    out = out ++ "            if (out_valid && downstream_ready) begin\n"
    out = out ++ "                out_valid <= 1'b0;\n"
    out = out ++ "            end\n"
    out = out ++ "            if (accept) begin\n"
    out = out ++ "                out_value <= s_tdata;\n"
    out = out ++ "                out_variance <= op_var + degradation_var;\n"
    out = out ++ "                out_prov <= ({in_prov[247:0], in_prov[255:248]} ^ {192'd0, s_tdata} ^ {224'd0, in_flags} ^ PROV_SALT);\n"
    out = out ++ "                out_conf <= {in_alpha + {56'd0, success_inc}, in_beta + {56'd0, failure_inc}};\n"
    out = out ++ "                out_flags <= in_flags;\n"
    out = out ++ "                gum_fidelity_inc <= gum_fidelity_inc + 32'd1;\n"
    out = out ++ "                provenance_depth_inc <= provenance_depth_inc + 32'd1;\n"
    out = out ++ "                formal_coverage_inc <= formal_coverage_inc + 32'd1;\n"
    out = out ++ "                out_valid <= 1'b1;\n"
    out = out ++ "            end\n"
    out = out ++ "        end\n"
    out = out ++ "    end\n"
    out = out ++ "endmodule\n"
    out
}

fn kaxi_template_epistemic_power_accumulator_verilog() -> string {
    var out = "// GENERATED_FROM_STDLIB: stdlib/hardware/kaxi.sio\n"
    out = out ++ "// GENERATED_BY: self-hosted build --target hardware-kaxi\n"
    out = out ++ "// Sounio Omega - Hardware Epistemic Power accumulator\n\n"
    out = out ++ "`timescale 1ns/1ps\n\n"
    out = out ++ "module epistemic_power_accumulator #(\n"
    out = out ++ "    parameter SCALE_SHIFT = 30\n"
    out = out ++ ") (\n"
    out = out ++ "    input  wire         aclk,\n"
    out = out ++ "    input  wire         aresetn,\n"
    out = out ++ "    input  wire [31:0]  fidelity_inc,\n"
    out = out ++ "    input  wire [31:0]  prov_depth_inc,\n"
    out = out ++ "    input  wire [31:0]  quantum_fidelity_inc,\n"
    out = out ++ "    input  wire         clear_counters,\n"
    out = out ++ "    output reg  [63:0]  epistemic_power_log,\n"
    out = out ++ "    output reg  [31:0]  total_transactions\n"
    out = out ++ ");\n\n"
    out = out ++ "    reg [63:0] fidelity_accum;\n"
    out = out ++ "    reg [63:0] prov_accum;\n"
    out = out ++ "    reg [63:0] quantum_accum;\n\n"
    out = out ++ "    wire [63:0] fidelity_next = fidelity_accum + {32'd0, fidelity_inc};\n"
    out = out ++ "    wire [63:0] prov_next = prov_accum + {32'd0, prov_depth_inc};\n"
    out = out ++ "    wire [63:0] quantum_next = quantum_accum + {32'd0, quantum_fidelity_inc};\n"
    out = out ++ "    wire [63:0] weighted_log_next = (fidelity_next >> 3) + (prov_next >> 4) + (quantum_next >> 5);\n"
    out = out ++ "    wire tx_seen = |fidelity_inc;\n\n"
    out = out ++ "    always @(posedge aclk or negedge aresetn) begin\n"
    out = out ++ "        if (!aresetn) begin\n"
    out = out ++ "            fidelity_accum <= 64'd0;\n"
    out = out ++ "            prov_accum <= 64'd0;\n"
    out = out ++ "            quantum_accum <= 64'd0;\n"
    out = out ++ "            total_transactions <= 32'd0;\n"
    out = out ++ "            epistemic_power_log <= 64'd0;\n"
    out = out ++ "        end else if (clear_counters) begin\n"
    out = out ++ "            fidelity_accum <= 64'd0;\n"
    out = out ++ "            prov_accum <= 64'd0;\n"
    out = out ++ "            quantum_accum <= 64'd0;\n"
    out = out ++ "            total_transactions <= 32'd0;\n"
    out = out ++ "            epistemic_power_log <= 64'd0;\n"
    out = out ++ "        end else begin\n"
    out = out ++ "            fidelity_accum <= fidelity_next;\n"
    out = out ++ "            prov_accum <= prov_next;\n"
    out = out ++ "            quantum_accum <= quantum_next;\n"
    out = out ++ "            total_transactions <= total_transactions + {31'd0, tx_seen};\n"
    out = out ++ "            epistemic_power_log <= weighted_log_next;\n"
    out = out ++ "        end\n"
    out = out ++ "    end\n"
    out = out ++ "endmodule\n"
    out
}

fn kaxi_template_cuda_stub() -> string {
    var out = "// GENERATED_FROM_STDLIB: stdlib/hardware/kaxi.sio\n"
    out = out ++ "// GENERATED_BY: self-hosted build --target hardware-kaxi\n"
    out = out ++ "// CUDA sidecar for K-AXI publish path.\n\n"
    out = out ++ "#include <cuda_runtime.h>\n"
    out = out ++ "#include <stdint.h>\n"
    out = out ++ "#include <math.h>\n\n"
    out = out ++ "struct alignas(32) uint256_t {\n"
    out = out ++ "    uint64_t lane0;\n"
    out = out ++ "    uint64_t lane1;\n"
    out = out ++ "    uint64_t lane2;\n"
    out = out ++ "    uint64_t lane3;\n"
    out = out ++ "};\n\n"
    out = out ++ "struct KaxiPayload {\n"
    out = out ++ "    double value;\n"
    out = out ++ "    double variance;\n"
    out = out ++ "    uint256_t provenance;\n"
    out = out ++ "    uint64_t confidence_bits;\n"
    out = out ++ "    uint32_t flags;\n"
    out = out ++ "    uint32_t reserved;\n"
    out = out ++ "};\n\n"
    out = out ++ "static constexpr unsigned KAXI_RING_SIZE = 64;\n"
    out = out ++ "__device__ KaxiPayload g_kaxi_ring[KAXI_RING_SIZE];\n"
    out = out ++ "__device__ unsigned int g_kaxi_write_idx = 0;\n"
    out = out ++ "__device__ unsigned long long g_epistemic_power_log_hw_q32_32 = 0ull;\n\n"
    out = out ++ "__device__ __forceinline__ void __knowledge_kaxi_publish(\n"
    out = out ++ "    double value,\n"
    out = out ++ "    double variance,\n"
    out = out ++ "    const uint256_t& prov,\n"
    out = out ++ "    double confidence,\n"
    out = out ++ "    uint32_t flags\n"
    out = out ++ ") {\n"
    out = out ++ "    const unsigned idx = atomicAdd(&g_kaxi_write_idx, 1u) & (KAXI_RING_SIZE - 1);\n"
    out = out ++ "    g_kaxi_ring[idx].value = value;\n"
    out = out ++ "    g_kaxi_ring[idx].variance = fmax(0.0, variance);\n"
    out = out ++ "    g_kaxi_ring[idx].provenance = prov;\n"
    out = out ++ "    g_kaxi_ring[idx].confidence_bits = static_cast<uint64_t>(__double_as_longlong(confidence));\n"
    out = out ++ "    g_kaxi_ring[idx].flags = flags;\n"
    out = out ++ "    g_kaxi_ring[idx].reserved = 0u;\n"
    out = out ++ "    atomicAdd(&g_epistemic_power_log_hw_q32_32, 1ull << 16);\n"
    out = out ++ "}\n"
    out
}

fn run_build_hardware_kaxi(emit_selector: string) -> i32 with IO, Mut, Panic, Div, Alloc {
    let _ignored_emit_selector = emit_selector
    print("Error: template-direct hardware build path has been removed.\n")
    print("Use the wrapper path:\n")
    print("  ./souc build --target hardware-kaxi --emit verilog,cuda-stub\n")
    print("This enforces canonical extraction from stdlib/hardware/kaxi.sio via selfhost-emitter.\n")
    2
}

fn run_build_command(argc: i64) -> i32 with IO, Mut, Panic, Div, Alloc {
    var target: string = ""
    var emit_selector: string = "verilog,cuda-stub"
    var i: i64 = 1

    while i < argc {
        let arg = get_arg(i)
        if str_eq(arg, "--target") {
            if i + 1 >= argc {
                print("Error: --target requires a value\n")
                return 1
            }
            target = get_arg(i + 1)
            i = i + 2
        } else if str_eq(arg, "--emit") {
            if i + 1 >= argc {
                print("Error: --emit requires a value\n")
                return 1
            }
            emit_selector = get_arg(i + 1)
            i = i + 2
        } else {
            i = i + 1
        }
    }

    if str_eq(target, "hardware-kaxi") {
        return run_build_hardware_kaxi(emit_selector)
    }

    print("Error: self-hosted build currently supports only --target hardware-kaxi\n")
    1
}

// ============================================================================
// CLI MODE — User-facing commands (bootstrap sovereignty)
// ============================================================================

fn print_cli_version() with IO {
    print("Sounio 0.4.0-selfhost (self-hosted-bootstrap)\n")
    print("Self-hosted compiler - Rust-free build\n")
    print("Copyright (c) 2025 Demetrios Chiuratto Agourakis\n")
}

// ============================================================================
// --emit-manifest: reproducibility artifact bundle
// Emits a JSON manifest with source hash (DJB2), Merkle root, compiler
// version, and epistemic audit records derived from checker + IR metadata.
// ============================================================================

fn manifest_empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn manifest_print_json_string(s: string) with IO {
    print("\"")
    print(s)
    print("\"")
}

fn manifest_print_name_json(n: Name) with IO, Mut, Panic, Div {
    print("\"")
    print_name_bytes(n)
    print("\"")
}

fn manifest_print_f64_json(value: f64) with IO, Div, Panic {
    let abs_value = if value < 0.0 { 0.0 - value } else { value }
    let scaled = (abs_value * 1000.0) as i64
    let whole = scaled / 1000
    let frac = scaled - whole * 1000
    if value < 0.0 {
        print("-")
    }
    print_int(whole)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
}

fn manifest_print_metric_name(metric_id: i64) with IO {
    if metric_id == 0 { print("sign_consensus") }
    else if metric_id == 1 { print("relative_band") }
    else if metric_id == 2 { print("max_tail_risk") }
    else if metric_id == 3 { print("mechanistic_divergence") }
    else if metric_id == 4 { print("identifiability_floor") }
    else { print("unknown_metric") }
}

fn manifest_print_compare_op_json(op: CompareOp) with IO {
    if op == CompareOp::CmpLt { print("\"<\"") }
    else if op == CompareOp::CmpLe { print("\"<=\"") }
    else if op == CompareOp::CmpEq { print("\"==\"") }
    else if op == CompareOp::CmpGe { print("\">=\"") }
    else { print("\">\"") }
}

fn manifest_type_entry_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Panic, Div, Alloc {
    match opt {
        None => empty_type_entry(),
        Some(list) => {
            if idx <= 0 {
                (*list).head
            } else {
                manifest_type_entry_list_get((*list).tail, idx - 1)
            }
        }
    }
}

fn manifest_print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyI8 { print("i8"); return }
    if ty.kind == TypeKind::TyI32 { print("i32"); return }
    if ty.kind == TypeKind::TyI64 { print("i64"); return }
    if ty.kind == TypeKind::TyU8 { print("u8"); return }
    if ty.kind == TypeKind::TyU32 { print("u32"); return }
    if ty.kind == TypeKind::TyU64 { print("u64"); return }
    if ty.kind == TypeKind::TyF32 { print("f32"); return }
    if ty.kind == TypeKind::TyF64 { print("f64"); return }
    if ty.kind == TypeKind::TyBool { print("bool"); return }
    if ty.kind == TypeKind::TyUnit { print("()"); return }
    if ty.kind == TypeKind::TyString { print("string"); return }
    if ty.kind == TypeKind::TyChar { print("char"); return }
    if ty.kind == TypeKind::TyNamed { print_name_bytes(ty.name); return }
    if ty.kind == TypeKind::TyModel {
        print("Model<")
        manifest_print_type_name(manifest_type_entry_list_get(ty.tuple_elems, 0))
        print(", ")
        manifest_print_type_name(manifest_type_entry_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyModelFamily {
        print("ModelFamily<")
        manifest_print_type_name(manifest_type_entry_list_get(ty.tuple_elems, 0))
        print(", ")
        manifest_print_type_name(manifest_type_entry_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyKnowledge
        || ty.kind == TypeKind::TyPolicy
        || ty.kind == TypeKind::TyDecisionPolicy
        || ty.kind == TypeKind::TyDeferralPolicy
        || ty.kind == TypeKind::TyContest
        || ty.kind == TypeKind::TyRobust
        || ty.kind == TypeKind::TyIntervention
        || ty.kind == TypeKind::TyCounterfactual
        || ty.kind == TypeKind::TyValidated
        || ty.kind == TypeKind::TyAdmissible
        || ty.kind == TypeKind::TyDeferred
        || ty.kind == TypeKind::TyValidation {
        if ty.kind == TypeKind::TyKnowledge { print("Knowledge<") }
        else if ty.kind == TypeKind::TyPolicy { print("Policy<") }
        else if ty.kind == TypeKind::TyDecisionPolicy { print("DecisionPolicy<") }
        else if ty.kind == TypeKind::TyDeferralPolicy { print("DeferralPolicy<") }
        else if ty.kind == TypeKind::TyContest { print("Contest<") }
        else if ty.kind == TypeKind::TyRobust { print("Robust<") }
        else if ty.kind == TypeKind::TyIntervention { print("Intervention<") }
        else if ty.kind == TypeKind::TyCounterfactual { print("Counterfactual<") }
        else if ty.kind == TypeKind::TyValidated { print("Validated<") }
        else if ty.kind == TypeKind::TyAdmissible { print("Admissible<") }
        else if ty.kind == TypeKind::TyDeferred { print("Deferred<") }
        else { print("Validation<") }
        match ty.inner {
            Some(inner) => manifest_print_type_name(*inner)
            None => print("?")
        }
        print(">")
        return
    }
    if ty.kind == TypeKind::TyArray {
        print("[")
        match ty.inner {
            Some(inner) => manifest_print_type_name(*inner)
            None => print("?")
        }
        print("; ")
        print_int(ty.array_size)
        print("]")
        return
    }
    print("<unknown>")
}

fn manifest_model_family_name(ep: IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < ep.model_family_count { ep.model_families[id].name } else { manifest_empty_name() }
}

fn manifest_policy_name(ep: IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < ep.policy_count { ep.policies[id].name } else { manifest_empty_name() }
}

fn manifest_policy_level_name(ep: IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < ep.policy_count { ep.policies[id].level_name } else { manifest_empty_name() }
}

fn manifest_policy_scope_name(ep: IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < ep.policy_count { ep.policies[id].scope_name } else { manifest_empty_name() }
}

fn manifest_validation_name(ep: IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < ep.validation_count { ep.validations[id].name } else { manifest_empty_name() }
}

fn manifest_print_name_array(names: [Name; 16], count: i64) with IO, Mut, Panic, Div {
    print("[")
    var i: i64 = 0
    while i < count && i < 16 {
        if i > 0 { print(", ") }
        manifest_print_name_json(names[i])
        i = i + 1
    }
    print("]")
}

fn manifest_print_metric_snapshot(metric_known: [i64; 8], metric_values: [f64; 8]) with IO, Mut, Panic, Div {
    print("{")
    var emitted: i64 = 0
    var i: i64 = 0
    while i < 5 {
        if metric_known[i] == 1 {
            if emitted > 0 { print(", ") }
            print("\"")
            manifest_print_metric_name(i)
            print("\": ")
            manifest_print_f64_json(metric_values[i])
            emitted = emitted + 1
        }
        i = i + 1
    }
    print("}")
}

fn manifest_print_epistemic_json(ep: IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    print("    \"model_families\": [\n")
    var i: i64 = 0
    while i < ep.model_family_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"name\": ")
        manifest_print_name_json(ep.model_families[i].name)
        print(", \"input_type\": \"")
        manifest_print_type_name(ep.model_families[i].input_ty)
        print("\", \"output_type\": \"")
        manifest_print_type_name(ep.model_families[i].output_ty)
        print("\", \"models\": ")
        manifest_print_name_array(ep.model_families[i].model_names, ep.model_families[i].model_count)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"policies\": [\n")
    i = 0
    while i < ep.policy_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(ep.policies[i].id)
        print(", \"name\": ")
        manifest_print_name_json(ep.policies[i].name)
        print(", \"target_type\": \"")
        manifest_print_type_name(ep.policies[i].target_ty)
        print("\", \"level\": ")
        manifest_print_name_json(ep.policies[i].level_name)
        print(", \"scope\": ")
        manifest_print_name_json(ep.policies[i].scope_name)
        print(", \"requirements\": [")
        var j: i64 = 0
        while j < ep.policies[i].requirement_count && j < 8 {
            if j > 0 { print(", ") }
            print("{\"metric\": ")
            manifest_print_name_json(ep.policies[i].requirements[j].metric_name)
            print(", \"op\": ")
            manifest_print_compare_op_json(ep.policies[i].requirements[j].op)
            print(", \"threshold\": ")
            manifest_print_f64_json(ep.policies[i].requirements[j].threshold)
            print("}")
            j = j + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"validations\": [\n")
    i = 0
    while i < ep.validation_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"name\": ")
        manifest_print_name_json(ep.validations[i].name)
        print(", \"target_type\": \"")
        manifest_print_type_name(ep.validations[i].target_ty)
        print("\"}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"mechanistic_reports\": [\n")
    i = 0
    while i < ep.mechanistic_report_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"latent_state_divergence\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].latent_state_divergence)
        print(", \"causal_decomposition_divergence\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].causal_decomposition_divergence)
        print(", \"intervention_response_divergence\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].intervention_response_divergence)
        print(", \"parameter_role_divergence\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].parameter_role_divergence)
        print(", \"structural_explanation_distance\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].structural_explanation_distance)
        print(", \"aggregate_divergence\": ")
        manifest_print_f64_json(ep.mechanistic_reports[i].aggregate_divergence)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"counterexamples\": [\n")
    i = 0
    while i < ep.counterexample_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"summary\": ")
        manifest_print_name_json(ep.counterexamples[i].summary)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"contests\": [\n")
    i = 0
    while i < ep.contest_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"family_id\": ")
        print_int(ep.contests[i].family_id)
        print(", \"family_name\": ")
        manifest_print_name_json(manifest_model_family_name(ep, ep.contests[i].family_id))
        print(", \"policy_id\": ")
        print_int(ep.contests[i].policy_id)
        print(", \"policy_name\": ")
        manifest_print_name_json(manifest_policy_name(ep, ep.contests[i].policy_id))
        print(", \"models\": ")
        manifest_print_name_array(ep.contests[i].model_names, ep.contests[i].model_count)
        print(", \"metrics\": ")
        manifest_print_metric_snapshot(ep.contests[i].metric_known, ep.contests[i].metric_values)
        print(", \"mechanistic_report_id\": ")
        print_int(ep.contests[i].mechanistic_report_id)
        print(", \"counterexample_id\": ")
        print_int(ep.contests[i].counterexample_id)
        print(", \"posterior_weights_id\": ")
        print_int(ep.contests[i].posterior_weights_id)
        print(", \"provenance_bundle_id\": ")
        print_int(ep.contests[i].provenance_bundle_id)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"robust_proofs\": [\n")
    i = 0
    while i < ep.robust_proof_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"contest_id\": ")
        print_int(ep.robust_proofs[i].contest_id)
        print(", \"policy_id\": ")
        print_int(ep.robust_proofs[i].policy_id)
        print(", \"policy_name\": ")
        manifest_print_name_json(manifest_policy_name(ep, ep.robust_proofs[i].policy_id))
        print(", \"level\": ")
        manifest_print_name_json(manifest_policy_level_name(ep, ep.robust_proofs[i].policy_id))
        print(", \"scope\": ")
        manifest_print_name_json(manifest_policy_scope_name(ep, ep.robust_proofs[i].policy_id))
        print(", \"metrics\": ")
        manifest_print_metric_snapshot(ep.robust_proofs[i].metric_known, ep.robust_proofs[i].metric_values)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"validated_manifests\": [\n")
    i = 0
    while i < ep.validated_manifest_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int(i)
        print(", \"robust_proof_id\": ")
        print_int(ep.validated_manifests[i].robust_proof_id)
        print(", \"validation_id\": ")
        print_int(ep.validated_manifests[i].validation_id)
        print(", \"validation_name\": ")
        manifest_print_name_json(manifest_validation_name(ep, ep.validated_manifests[i].validation_id))
        print(", \"inner_type\": \"")
        manifest_print_type_name(ep.validated_manifests[i].inner_ty)
        print("\"}")
        i = i + 1
    }
    print("\n    ]\n")
}

fn emit_source_manifest(source_path: string) -> i32 with IO, Mut, Div, Panic, Alloc {
    let state = read_source_file(source_path)
    let prog = parse_program_preloaded(state.token_count)
    if fail_if_parse_errors() {
        return 1
    }

    let resolve_result = resolve_program(prog)
    if resolve_result.had_error {
        print("Resolve errors: ")
        print_int(resolve_result.error_count)
        print("\n")
        return 1
    }

    let check_result = check_program(prog)
    if check_result.had_error {
        print("Check errors: ")
        print_int(check_result.error_count)
        print("\n")
        return 1
    }

    let lower_result = lower_program_to_ir(prog)
    if lower_result.had_error {
        print("Lower errors: ")
        print_int(lower_result.error_count)
        print("\n")
        return 1
    }

    let source_hash = intern_hash_string(source_path)
    let version_hash = intern_hash_string("0.4.0-selfhost")
    let merkle_root = intern_merkle_mix(source_hash, version_hash, 0, INTERN_MERKLE_SALT_A)
    print("{\n")
    print("  \"schema\": \"sounio.manifest.v2\",\n")
    print("  \"version\": \"0.4.0-selfhost\",\n")
    print("  \"path\": ")
    manifest_print_json_string(source_path)
    print(",\n")
    print("  \"source_hash\": ")
    print_int(source_hash)
    print(",\n")
    print("  \"merkle_root\": ")
    print_int(merkle_root)
    print(",\n")
    print("  \"provenance\": \"ProvSource\",\n")
    print("  \"epistemic\": {\n")
    manifest_print_epistemic_json(lower_result.module.epistemic)
    print("  }\n")
    print("}\n")
    0
}

fn print_cli_help() with IO {
    print("Sounio - L0 systems + scientific programming language\n\n")
    print("USAGE:\n")
    print("    sounio <command> [options] <file>\n\n")
    print("COMMANDS:\n")
    print("    check <file>           Type-check a Sounio source file\n")
    print("    run <file>             Run a Sounio program (via Poseidon VM)\n")
    print("    version                Show version information\n")
    print("    help                   Show this help message\n\n")
    print("DEVELOPER COMMANDS:\n")
    print("    test                   Run test suite\n")
    print("    build --target hardware-kaxi --emit verilog,cuda-stub\n")
    print("                           Emit K-AXI + Epistemic Power hardware artifacts\n")
    print("    lex <file>             Tokenize source file\n")
    print("    parse <file>           Parse source file to AST\n")
    print("    resolve <file>         Resolve names and scopes\n")
    print("    compile [--backend=native|native-v2] [--target=<...>] [--matrix=<...>] <file>\n")
    print("                           Compile to SOIR bytecode or native backend via dispatcher\n")
    print("                           native-v2 is the preview architecture lane\n")
    print("    compile-multi <file>   Compile with imports resolved\n\n")
    print("EXAMPLES:\n")
    print("    sounio check examples/hello.sio\n")
    print("    sounio run examples/fibonacci.sio\n\n")
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    let argc = arg_count()
    if argc == 0 {
        // No args: show help
        print_cli_help()
        return 1
    }

    let raw_cmd = get_arg(0)
    let cmd = if starts_with(raw_cmd, "--") {
        // Backward-compatible: accept --lex/--parse/--resolve too.
        str_slice(raw_cmd, 2, str_len(raw_cmd))
    } else {
        raw_cmd
    }

    // Handle user-facing commands first
    if str_eq(cmd, "version") || str_eq(cmd, "--version") || str_eq(cmd, "-v") {
        print_cli_version()
        return 0
    }

    if str_eq(cmd, "help") || str_eq(cmd, "--help") || str_eq(cmd, "-h") {
        print_cli_help()
        return 0
    }

    if str_eq(cmd, "test") {
        return run_all_tests()
    }

    if str_eq(cmd, "build") {
        return run_build_command(argc)
    }

    if str_eq(cmd, "lex") {
        if argc < 2 {
            print("Usage: sounio lex <path.sio>\n")
            return 1
        }
        return run_lex_pipeline(get_arg(1))
    }

    if str_eq(cmd, "parse") {
        if argc < 2 {
            print("Usage: sounio parse <path.sio>\n")
            return 1
        }
        return run_parse_pipeline(get_arg(1))
    }

    if str_eq(cmd, "resolve") {
        if argc < 2 {
            print("Usage: sounio resolve <path.sio>\n")
            return 1
        }
        return run_resolve_pipeline(get_arg(1))
    }

    if str_eq(cmd, "check") {
        if argc < 2 {
            print("Usage: sounio check [--fast-skip-blocks] [--no-item-count] <path.sio>\n")
            return 1
        }
        var fast_skip_blocks: bool = false
        var show_item_count: bool = true
        var source_path: string = ""
        var arg_idx: i64 = 1
        while arg_idx < argc {
            let arg = get_arg(arg_idx)
            if str_eq(arg, "--fast-skip-blocks") {
                fast_skip_blocks = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--no-item-count") {
                show_item_count = false
                arg_idx = arg_idx + 1
            } else {
                source_path = arg
                arg_idx = arg_idx + 1
                break
            }
        }
        if str_len(source_path) == 0 {
            print("Error: No source file specified\n")
            return 1
        }
        return run_check_pipeline(source_path, fast_skip_blocks, show_item_count)
    }

    if str_eq(cmd, "run") {
        if argc < 2 {
            print("Usage: sounio run <path.sio>\n")
            return 1
        }
        print("[Compiling]\n")
        let code = run_compile_pipeline(get_arg(1), false, true)
        if code == 0 {
            print("\n[Running via Poseidon VM - output above]\n")
        }
        return code
    }

    if str_eq(cmd, "compile-multi") {
        if argc < 2 {
            print("Usage: sounio compile-multi <main.sio>\n")
            return 1
        }
        let result = compile_multimodule_program(get_arg(1))
        if result.ok {
            print("Multi-module compile OK: ")
            print_int(result.bytecode_len)
            print(" bytes of bytecode\n")
            return 0
        } else {
            print("Multi-module compile FAILED: ")
            print(result.error_msg)
            print("\n")
            return 1
        }
    }

    if str_eq(cmd, "gpu-emit") {
        if argc < 2 {
            print("Usage: sounio gpu-emit [--target=ptx|metal] [--autotune] [--fuse] [--epistemic] <path.sio>\n")
            return 1
        }
        var gpu_target: string = "ptx"
        var gpu_source_path: string = ""
        var gpu_autotune: bool = false
        var gpu_fuse: bool = false
        var gpu_epistemic: bool = false
        var gpu_arg_idx: i64 = 1
        while gpu_arg_idx < argc {
            let arg = get_arg(gpu_arg_idx)
            if starts_with(arg, "--target=") {
                gpu_target = str_slice(arg, 9, str_len(arg))
                gpu_arg_idx = gpu_arg_idx + 1
            } else if str_eq(arg, "--autotune") {
                gpu_autotune = true
                gpu_arg_idx = gpu_arg_idx + 1
            } else if str_eq(arg, "--fuse") {
                gpu_fuse = true
                gpu_arg_idx = gpu_arg_idx + 1
            } else if str_eq(arg, "--epistemic") {
                gpu_epistemic = true
                gpu_arg_idx = gpu_arg_idx + 1
            } else {
                gpu_source_path = arg
                gpu_arg_idx = gpu_arg_idx + 1
                break
            }
        }
        if str_len(gpu_source_path) == 0 {
            print("Error: No source file specified\n")
            return 1
        }
        return run_gpu_emit_pipeline(gpu_source_path, gpu_target, gpu_autotune, gpu_fuse, gpu_epistemic)
    }

    if str_eq(cmd, "ir-verify") {
        if argc < 3 {
            print("Usage: sounio ir-verify <file_a.sio> <file_b.sio>\n")
            return 1
        }
        let path_a = get_arg(1)
        let path_b = get_arg(2)
        return run_ir_verify_pipeline(path_a, path_b)
    }

    if str_eq(cmd, "ir-roundtrip") {
        if argc < 2 {
            print("Usage: sounio ir-roundtrip <file.sio>\n")
            return 1
        }
        let rt_path = get_arg(1)
        return run_ir_roundtrip_pipeline(rt_path)
    }

    if str_eq(cmd, "disasm") {
        if argc < 2 {
            print("Usage: sounio disasm <file.sio>\n")
            return 1
        }
        let disasm_path = get_arg(1)
        return run_disasm_pipeline(disasm_path)
    }

    if str_eq(cmd, "ir-dump") {
        if argc < 2 {
            print("Usage: sounio ir-dump <file.sio>\n")
            return 1
        }
        let dump_path = get_arg(1)
        return run_ir_dump_pipeline(dump_path)
    }

    if str_eq(cmd, "compile") {
        if argc < 2 {
            print("Usage: sounio compile [--backend=native|native-v2|llvm] [--target=<native-auto|x86_64-linux|aarch64-linux|aarch64-macos|riscv64-linux|x86_64-windows|aarch64-windows>] [--matrix=<auto|off|apple-amx|intel-amx|ime|vme|ame>] [--fast-skip-blocks] [--no-item-count] [--emit-manifest] [-o output] <path.sio>\n")
            return 1
        }

        // Parse flags
        var use_native: bool = false
        var use_native_v2_preview: bool = false
        var use_llvm: bool = false
        var use_multimodule: bool = false
        var fast_skip_blocks: bool = false
        var show_item_count: bool = true
        var requested_target: string = "native-auto"
        var requested_matrix: string = "auto"
        var explicit_target: bool = false
        var explicit_matrix: bool = false
        var output_path: string = "a.out"
        var output_explicit: bool = false
        var emit_manifest: bool = false
        var source_path: string = ""
        var backend_label: string = "bytecode"
        var arg_idx: i64 = 1

        while arg_idx < argc {
            let arg = get_arg(arg_idx)

            if str_eq(arg, "--backend=native") {
                use_native = true
                backend_label = "native"
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--backend=llvm") {
                use_llvm = true
                backend_label = "llvm"
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--backend=native-v2") {
                use_native = true
                use_native_v2_preview = true
                backend_label = native_v2_backend_name()
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--backend=native-v2-shadow") {
                print("Error: --backend=native-v2-shadow has been retired; use --backend=native-v2\n")
                return 1
            } else if str_eq(arg, "--target") {
                if arg_idx + 1 >= argc {
                    print("Error: --target requires an argument\n")
                    return 1
                }
                requested_target = get_arg(arg_idx + 1)
                explicit_target = true
                arg_idx = arg_idx + 2
            } else if starts_with(arg, "--target=") {
                requested_target = str_slice(arg, 9, str_len(arg))
                explicit_target = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--matrix") {
                if arg_idx + 1 >= argc {
                    print("Error: --matrix requires an argument\n")
                    return 1
                }
                requested_matrix = get_arg(arg_idx + 1)
                explicit_matrix = true
                arg_idx = arg_idx + 2
            } else if starts_with(arg, "--matrix=") {
                requested_matrix = str_slice(arg, 9, str_len(arg))
                explicit_matrix = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--fast-skip-blocks") {
                fast_skip_blocks = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--no-item-count") {
                show_item_count = false
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--multimodule") {
                use_multimodule = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "--emit-manifest") {
                emit_manifest = true
                arg_idx = arg_idx + 1
            } else if str_eq(arg, "-o") || str_eq(arg, "--output") {
                if arg_idx + 1 >= argc {
                    print("Error: -o requires an argument\n")
                    return 1
                }
                output_path = get_arg(arg_idx + 1)
                output_explicit = true
                arg_idx = arg_idx + 2
            } else {
                // First non-flag argument is the source file
                source_path = arg
                arg_idx = arg_idx + 1
                break  // Only take first source file for now
            }
        }

        if str_len(source_path) == 0 {
            print("Error: No source file specified\n")
            return 1
        }

        if emit_manifest {
            return emit_source_manifest(source_path)
        }

        if (explicit_target || explicit_matrix) && !use_native {
            print("Error: target_flags_require_native_backend\n")
            return 1
        }

        if use_llvm {
            return compile_multimodule_llvm(source_path, output_path, false)
        }

        // Route to appropriate pipeline
        if use_multimodule && use_native {
            return compile_multimodule_native(
                source_path,
                output_path,
                requested_target,
                requested_matrix,
                explicit_target,
                "",
                "",
                false
            )
        }
        if use_multimodule {
            let result = compile_multimodule_program(source_path)
            if result.ok {
                print("Multi-module compile OK: ")
                print_int(result.bytecode_len)
                print(" bytes of bytecode\n")
                return 0
            } else {
                print("Multi-module compile FAILED: ")
                print(result.error_msg)
                print("\n")
                return 1
            }
        }
        if use_native {
            let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
            native_print_dispatch(target_spec)
            return run_compile_pipeline_native(
                source_path,
                output_path,
                fast_skip_blocks,
                show_item_count,
                target_spec,
                backend_label,
                use_native_v2_preview
            )
        } else {
            if output_explicit {
                return run_compile_pipeline_with_output(source_path, output_path, fast_skip_blocks, show_item_count)
            }
            return run_compile_pipeline(source_path, fast_skip_blocks, show_item_count)
        }
    }

    if str_eq(cmd, "parse-all") {
        if argc == 1 {
            return run_parse_all_full_tests()
        }

        let mode = get_arg(1)
        if str_eq(mode, "shard") {
            if argc < 4 {
                print("Usage: souc run self-hosted/ -- parse-all shard <index> <count> [mod|balanced]\n")
                return 1
            }
            let shard_index = parse_nonnegative_i64(get_arg(2))
            let shard_count = parse_nonnegative_i64(get_arg(3))
            let shard_mode = parse_all_cli_shard_mode_from_optional(argc, 4)
            if shard_mode < 0 {
                print("Parse All: invalid shard mode (expected mod|balanced)\n")
                return 1
            }
            return run_parse_all_full_shard_tests(shard_index, shard_count, shard_mode)
        }

        if str_eq(mode, "shards") {
            if argc < 4 {
                print("Usage: souc run self-hosted/ -- parse-all shards <count> <selector> [mod|balanced]\n")
                print("  selector supports comma lists, inclusive ranges, and 'all': 0,2,4-6,all\n")
                return 1
            }
            let shard_count = parse_nonnegative_i64(get_arg(2))
            let selector = get_arg(3)
            let shard_mode = parse_all_cli_shard_mode_from_optional(argc, 4)
            if shard_mode < 0 {
                print("Parse All: invalid shard mode (expected mod|balanced)\n")
                return 1
            }
            return run_parse_all_full_shards_selector(shard_count, selector, shard_mode)
        }

        if str_eq(mode, "report") {
            if argc < 3 {
                print("Usage: souc run self-hosted/ -- parse-all report <count> [mod|balanced]\n")
                return 1
            }
            let shard_count = parse_nonnegative_i64(get_arg(2))
            let shard_mode = parse_all_cli_shard_mode_from_optional(argc, 3)
            if shard_mode < 0 {
                print("Parse All: invalid shard mode (expected mod|balanced)\n")
                return 1
            }
            return run_parse_all_full_report(shard_count, shard_mode)
        }

        print("Usage: souc run self-hosted/ -- parse-all [shard <index> <count> [mod|balanced] | shards <count> <selector> [mod|balanced] | report <count> [mod|balanced]]\n")
        return 1
    }

    print("Unknown command: ")
    print(cmd)
    print("\n\nRun 'sounio help' for usage information\n")
    1
}
