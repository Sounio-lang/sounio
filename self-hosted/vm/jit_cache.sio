// --------------------------------------------------------------------------
// Category 13: Multi-step Integration Tests  (T76 - T80)
// --------------------------------------------------------------------------

// T76: Full workflow — insert, profile, promote, verify
fn test_jc_full_workflow_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    // Insert a BASELINE entry
    let code = jc_test_code(11 as i8, 64)
    let idx = jc_insert_entry(cache, 5000, JC_TIER_BASELINE, code, 64)
    if idx == JC_INVALID { return false }

    // Profile it up to warm threshold
    var i: i64 = 0
    while i < JC_WARM_THRESHOLD {
        let c = jc_record_call(cache, 5000)
        i = i + 1
    }

    // Verify it is warm
    if jc_is_warm(cache, 5000) == false { return false }

    // Promote to OPT
    let promoted = jc_promote_tier(cache, 5000, JC_TIER_OPT)
    if promoted == false { return false }

    // Current tier should be OPT
    if jc_current_tier(cache, 5000) != JC_TIER_OPT { return false }

    // Verify clean
    let issues = jc_verify_all(cache)
    issues == 0
}
fn test_jc_full_workflow() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_full_workflow_inner(&! cache)
}

// T77: Insert, invalidate, compact, verify
fn test_jc_insert_invalidate_compact_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 5100, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 5101, JC_TIER_BASELINE, code, 4)
    let idx2 = jc_insert_entry(cache, 5102, JC_TIER_BASELINE, code, 4)
    let idx3 = jc_insert_entry(cache, 5103, JC_TIER_BASELINE, code, 4)

    // Invalidate entries 1 and 2
    let ok1 = jc_invalidate_entry(cache, idx1)
    let ok2 = jc_invalidate_entry(cache, idx2)

    // Before compact: 4 total, 2 valid
    if cache.entry_count != 4 { return false }
    if jc_valid_entry_count(cache) != 2 { return false }

    // Compact
    let freed = jc_compact(cache)
    if freed != 2 { return false }
    if cache.entry_count != 2 { return false }

    // Verify the remaining entries are correct
    let e0 = jc_get_entry(cache, 0)
    let e1 = jc_get_entry(cache, 1)
    if e0.func_id != 5100 { return false }
    e1.func_id == 5103
}
fn test_jc_insert_invalidate_compact() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_insert_invalidate_compact_inner(&! cache)
}

// T78: Multiple funcs at different tiers, evict cold
fn test_jc_multi_tier_evict_cold_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 16)
    let idx0 = jc_insert_entry(cache, 5200, JC_TIER_BASELINE, code, 16)
    let idx1 = jc_insert_entry(cache, 5201, JC_TIER_OPT, code, 16)
    let idx2 = jc_insert_entry(cache, 5202, JC_TIER_NATIVE, code, 16)
    // Set hit counts: 0 is cold, 1 is hot, 2 is medium
    cache.entries[idx0 as usize].hit_count = 0
    cache.entries[idx1 as usize].hit_count = 50
    cache.entries[idx2 as usize].hit_count = 20

    let evicted = jc_evict_cold(cache, 10)
    if evicted != 1 { return false }
    // Entry 0 (hit_count=0) should be evicted
    if jc_is_valid(cache, idx0) { return false }
    // Others should survive
    if jc_is_valid(cache, idx1) == false { return false }
    jc_is_valid(cache, idx2)
}
fn test_jc_multi_tier_evict_cold() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_multi_tier_evict_cold_inner(&! cache)
}

// T79: Patch code and then copy it
fn test_jc_patch_and_copy_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 16)
    let idx = jc_insert_entry(cache, 5300, JC_TIER_OPT, code, 16)

    // Patch some bytes
    let ok1 = jc_patch_byte(cache, idx, 0, 0x90 as i8)
    let ok2 = jc_patch_byte(cache, idx, 1, 0xCC as i8)
    if ok1 == false { return false }
    if ok2 == false { return false }

    // Copy and verify
    var dst: [i8; 65536] = [0; 65536]
    let len = jc_copy_code(cache, idx, &! dst)
    if len != 16 { return false }
    if dst[0 as usize] != 0x90 as i8 { return false }
    dst[1 as usize] == 0xCC as i8
}
fn test_jc_patch_and_copy() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_and_copy_inner(&! cache)
}

// T80: Statistics after many operations
fn test_jc_stats_after_ops_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 32)

    // Insert 5 entries
    let idx0 = jc_insert_entry(cache, 5400, JC_TIER_BASELINE, code, 32)
    let idx1 = jc_insert_entry(cache, 5401, JC_TIER_BASELINE, code, 64)
    let idx2 = jc_insert_entry(cache, 5402, JC_TIER_OPT, code, 128)
    let idx3 = jc_insert_entry(cache, 5403, JC_TIER_OPT, code, 256)
    let idx4 = jc_insert_entry(cache, 5404, JC_TIER_NATIVE, code, 16)

    // Record some hits and misses
    let h1 = jc_record_hit(cache)
    let h2 = jc_record_hit(cache)
    let h3 = jc_record_hit(cache)
    let m1 = jc_record_miss(cache)

    // Invalidate 2 entries
    let ok1 = jc_invalidate_entry(cache, idx1)
    let ok2 = jc_invalidate_entry(cache, idx3)

    let summary = jc_stats_summary(cache)
    if summary.total_entries != 5 { return false }
    if summary.valid_entries != 3 { return false }
    // Valid code bytes: 32 + 128 + 16 = 176
    if summary.total_code_bytes != 176 { return false }
    if summary.compilations != 5 { return false }
    if summary.invalidations != 2 { return false }
    // Hit rate: 3 / (3 + 1) = 75%
    if summary.hit_rate_pct < 74.9 { return false }
    if summary.hit_rate_pct > 75.1 { return false }
    true
}
fn test_jc_stats_after_ops() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_stats_after_ops_inner(&! cache)
}

// --------------------------------------------------------------------------
// Category 14: Additional Edge Cases  (T81 - T85)
// --------------------------------------------------------------------------

// T81: should_compile returns INTERP when already at NATIVE
fn test_jc_should_compile_at_native_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    // Get profile for func and set last_tier to NATIVE
    let pidx = jc_get_or_create_profile(cache, 5500)
    cache.profiles[pidx as usize].last_tier = JC_TIER_NATIVE
    // Even with lots of calls, should not recommend compilation
    var i: i64 = 0
    while i < 200 {
        let c = jc_record_call(cache, 5500)
        i = i + 1
    }
    let tier = jc_should_compile(cache, 5500)
    tier == JC_TIER_INTERP
}
fn test_jc_should_compile_at_native() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_should_compile_at_native_inner(&! cache)
}

// T82: Copy code from invalid entry returns 0
fn test_jc_copy_code_invalid_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    var dst: [i8; 65536] = [0; 65536]
    let len = jc_copy_code(cache, 999, &! dst)
    len == 0
}
fn test_jc_copy_code_invalid() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_copy_code_invalid_inner(&! cache)
}

// T83: Patch i32 out of bounds fails
fn test_jc_patch_i32_oob_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 8)
    let idx = jc_insert_entry(cache, 5600, JC_TIER_BASELINE, code, 8)
    // Offset 6 + 4 bytes = 10, exceeds code_len=8
    let ok = jc_patch_i32_le(cache, idx, 6, 42)
    ok == false
}
fn test_jc_patch_i32_oob() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_i32_oob_inner(&! cache)
}

// T84: Patch i64 out of bounds fails
fn test_jc_patch_i64_oob_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 8)
    let idx = jc_insert_entry(cache, 5700, JC_TIER_BASELINE, code, 8)
    // Offset 2 + 8 bytes = 10, exceeds code_len=8
    let ok = jc_patch_i64_le(cache, idx, 2, 42)
    ok == false
}
fn test_jc_patch_i64_oob() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_i64_oob_inner(&! cache)
}

// T85: Promote on non-existent func returns false
fn test_jc_promote_nonexistent_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let ok = jc_promote_tier(cache, 9999, JC_TIER_OPT)
    ok == false
}
fn test_jc_promote_nonexistent() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_promote_nonexistent_inner(&! cache)
}

// --------------------------------------------------------------------------
// Test Runner
// --------------------------------------------------------------------------

fn jc_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0

    // Category 1: Lookup / Insert Basics (T01-T05)
    if test_jc_insert_lookup() { passed = passed + 1 }
    if test_jc_has_compiled() { passed = passed + 1 }
    if test_jc_find_miss() { passed = passed + 1 }
    if test_jc_get_entry_oob() { passed = passed + 1 }
    if test_jc_get_code_len() { passed = passed + 1 }

    // Category 2: Cache Miss / Hit Tracking (T06-T10)
    if test_jc_hit_miss_tracking() { passed = passed + 1 }
    if test_jc_hit_rate_50() { passed = passed + 1 }
    if test_jc_hit_rate_zero() { passed = passed + 1 }
    if test_jc_hit_rate_100() { passed = passed + 1 }
    if test_jc_compilation_count() { passed = passed + 1 }

    // Category 3: Tier Promotion (T11-T15)
    if test_jc_promote_baseline_to_opt() { passed = passed + 1 }
    if test_jc_promote_reject_downgrade() { passed = passed + 1 }
    if test_jc_promote_reject_same() { passed = passed + 1 }
    if test_jc_promote_updates_profile() { passed = passed + 1 }
    if test_jc_promote_to_native() { passed = passed + 1 }

    // Category 4: Invalidation (T16-T20)
    if test_jc_invalidate_single() { passed = passed + 1 }
    if test_jc_invalidate_func() { passed = passed + 1 }
    if test_jc_invalidate_all() { passed = passed + 1 }
    if test_jc_invalidate_tier() { passed = passed + 1 }
    if test_jc_invalidate_already_invalid() { passed = passed + 1 }

    // Category 5: Profiling Counters (T21-T25)
    if test_jc_record_call() { passed = passed + 1 }
    if test_jc_record_loop() { passed = passed + 1 }
    if test_jc_record_branch() { passed = passed + 1 }
    if test_jc_add_cycles() { passed = passed + 1 }
    if test_jc_profile_reuse() { passed = passed + 1 }

    // Category 6: Hot / Warm Detection (T26-T30)
    if test_jc_not_warm_initially() { passed = passed + 1 }
    if test_jc_becomes_warm() { passed = passed + 1 }
    if test_jc_not_hot_at_warm() { passed = passed + 1 }
    if test_jc_becomes_hot() { passed = passed + 1 }
    if test_jc_should_compile_warm() { passed = passed + 1 }

    // Category 7: Code Patching (T31-T35)
    if test_jc_patch_byte() { passed = passed + 1 }
    if test_jc_patch_byte_oob() { passed = passed + 1 }
    if test_jc_patch_i32_le() { passed = passed + 1 }
    if test_jc_patch_i64_le() { passed = passed + 1 }
    if test_jc_patch_invalid_entry() { passed = passed + 1 }

    // Category 8: LRU Eviction (T36-T40)
    if test_jc_find_lru() { passed = passed + 1 }
    if test_jc_evict_lru() { passed = passed + 1 }
    if test_jc_evict_lru_empty() { passed = passed + 1 }
    if test_jc_evict_cold() { passed = passed + 1 }
    if test_jc_compact() { passed = passed + 1 }

    // Category 9: Statistics (T41-T45)
    if test_jc_total_code_bytes() { passed = passed + 1 }
    if test_jc_valid_entry_count() { passed = passed + 1 }
    if test_jc_stats_summary() { passed = passed + 1 }
    if test_jc_invalidation_count() { passed = passed + 1 }
    if test_jc_empty_stats() { passed = passed + 1 }

    // Category 10: Edge Cases (T46-T55)
    if test_jc_update_entry() { passed = passed + 1 }
    if test_jc_set_entry_point() { passed = passed + 1 }
    if test_jc_bump_version() { passed = passed + 1 }
    if test_jc_find_entry_tier() { passed = passed + 1 }
    if test_jc_copy_code() { passed = passed + 1 }
    if test_jc_should_compile_hot() { passed = passed + 1 }
    if test_jc_should_compile_cold() { passed = passed + 1 }
    if test_jc_invalidation_new() { passed = passed + 1 }
    if test_jc_update_invalid_idx() { passed = passed + 1 }
    if test_jc_bump_version_invalid() { passed = passed + 1 }

    // Category 11: Extended Utility Tests (T56-T65)
    if test_jc_bump_hit_count() { passed = passed + 1 }
    if test_jc_reset_hit_counts() { passed = passed + 1 }
    if test_jc_count_tier() { passed = passed + 1 }
    if test_jc_best_tier() { passed = passed + 1 }
    if test_jc_distinct_funcs() { passed = passed + 1 }
    if test_jc_invalidate_below_tier() { passed = passed + 1 }
    if test_jc_reset_profiles() { passed = passed + 1 }
    if test_jc_branch_taken_ratio() { passed = passed + 1 }
    if test_jc_avg_cycles_per_call() { passed = passed + 1 }
    if test_jc_is_full_empty() { passed = passed + 1 }

    // Category 12: Verification / Diagnostic Tests (T66-T75)
    if test_jc_verify_clean() { passed = passed + 1 }
    if test_jc_verify_profiles_clean() { passed = passed + 1 }
    if test_jc_verify_all_clean() { passed = passed + 1 }
    if test_jc_no_fragmentation() { passed = passed + 1 }
    if test_jc_fragmentation_after_invalidate() { passed = passed + 1 }
    if test_jc_find_hottest() { passed = passed + 1 }
    if test_jc_total_hits_all() { passed = passed + 1 }
    if test_jc_avg_code_len() { passed = passed + 1 }
    if test_jc_find_largest() { passed = passed + 1 }
    if test_jc_profiled_func_count() { passed = passed + 1 }

    // Category 13: Multi-step Integration Tests (T76-T80)
    if test_jc_full_workflow() { passed = passed + 1 }
    if test_jc_insert_invalidate_compact() { passed = passed + 1 }
    if test_jc_multi_tier_evict_cold() { passed = passed + 1 }
    if test_jc_patch_and_copy() { passed = passed + 1 }
    if test_jc_stats_after_ops() { passed = passed + 1 }

    // Category 14: Additional Edge Cases (T81-T85)
    if test_jc_should_compile_at_native() { passed = passed + 1 }
    if test_jc_copy_code_invalid() { passed = passed + 1 }
    if test_jc_patch_i32_oob() { passed = passed + 1 }
    if test_jc_patch_i64_oob() { passed = passed + 1 }
    if test_jc_promote_nonexistent() { passed = passed + 1 }

    passed
}
