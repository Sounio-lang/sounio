// T43: stats_summary fields
fn test_jc_stats_summary_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 16)
    let idx0 = jc_insert_entry(cache, 1900, JC_TIER_BASELINE, code, 16)
    let idx1 = jc_insert_entry(cache, 1901, JC_TIER_OPT, code, 32)
    let h = jc_record_hit(cache)
    let m = jc_record_miss(cache)
    let summary = jc_stats_summary(cache)
    if summary.total_entries != 2 { return false }
    if summary.valid_entries != 2 { return false }
    if summary.total_code_bytes != 48 { return false }
    if summary.compilations != 2 { return false }
    if summary.invalidations != 0 { return false }
    // Hit rate should be 50%
    if summary.hit_rate_pct < 49.9 { return false }
    if summary.hit_rate_pct > 50.1 { return false }
    true
}
fn test_jc_stats_summary() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_stats_summary_inner(&! cache)
}

