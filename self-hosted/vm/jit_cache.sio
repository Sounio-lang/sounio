// self-hosted::vm::jit_cache — JIT Compilation Cache
//
// Provides code caching, invalidation, tiered compilation tracking, and
// profiling data for hot-code detection in the Sounio VM.  All data lives
// in flat fixed-size arrays (no heap allocation) so the module is
// self-contained and bootstrap-friendly.
//
// Naming: structs prefixed `Jc`, functions prefixed `jc_`, constants `JC_`.
//
// Tiered compilation model:
//   INTERP   (0) — interpreted, no compiled code
//   BASELINE (1) — quick non-optimizing compile
//   OPT      (2) — optimized with inlining and register allocation
//   NATIVE   (3) — fully native, ahead-of-time quality
//
// Profiling drives promotion:  call_count >= WARM_THRESHOLD  -> BASELINE
//                               call_count >= HOT_THRESHOLD   -> OPT

// ============================================================================
// Section 1: Constants
// ============================================================================

let JC_MAX_ENTRIES: i64 = 4096
let JC_MAX_CODE: i64 = 65536
let JC_TIER_INTERP: i64 = 0
let JC_TIER_BASELINE: i64 = 1
let JC_TIER_OPT: i64 = 2
let JC_TIER_NATIVE: i64 = 3
let JC_INVALID: i64 = 0 - 1
let JC_MAX_PROFILE: i64 = 1024
let JC_HOT_THRESHOLD: i64 = 100
let JC_WARM_THRESHOLD: i64 = 10

// Invalidation reason codes
let JC_REASON_MANUAL: i64 = 0
let JC_REASON_DEOPT: i64 = 1
let JC_REASON_TIER_UP: i64 = 2
let JC_REASON_EVICTION: i64 = 3

// ============================================================================
// Section 2: Core Data Structures
// ============================================================================

struct JcCodeEntry {
    func_id: i64,
    tier: i64,
    code_bytes: [i8; 65536],
    code_len: i64,
    entry_point: i64,
    valid: bool,
    version: i64,
    hit_count: i64,
}

struct JcProfileData {
    func_id: i64,
    call_count: i64,
    loop_count: i64,
    branch_taken: i64,
    branch_not_taken: i64,
    total_cycles: i64,
    last_tier: i64,
}

struct JcInvalidation {
    func_id: i64,
    reason: i64,
    timestamp: i64,
}

struct JcStatsSummary {
    total_entries: i64,
    valid_entries: i64,
    total_code_bytes: i64,
    hit_rate_pct: f64,
    compilations: i64,
    invalidations: i64,
}

struct JcCache {
    entries: [JcCodeEntry; 4096],
    entry_count: i64,
    profiles: [JcProfileData; 1024],
    profile_count: i64,
    total_compilations: i64,
    total_invalidations: i64,
    total_hits: i64,
    total_misses: i64,
}

// ============================================================================
// Section 3: Constructor Functions
// ============================================================================

fn jc_empty_entry() -> JcCodeEntry {
    JcCodeEntry {
        func_id: JC_INVALID,
        tier: JC_TIER_INTERP,
        code_bytes: [0; 65536],
        code_len: 0,
        entry_point: 0,
        valid: false,
        version: 0,
        hit_count: 0,
    }
}

fn jc_empty_profile() -> JcProfileData {
    JcProfileData {
        func_id: JC_INVALID,
        call_count: 0,
        loop_count: 0,
        branch_taken: 0,
        branch_not_taken: 0,
        total_cycles: 0,
        last_tier: JC_TIER_INTERP,
    }
}

fn jc_cache_new() -> JcCache {
    JcCache {
        entries: [jc_empty_entry(); 4096],
        entry_count: 0,
        profiles: [jc_empty_profile(); 1024],
        profile_count: 0,
        total_compilations: 0,
        total_invalidations: 0,
        total_hits: 0,
        total_misses: 0,
    }
}

fn jc_invalidation_new(func_id: i64, reason: i64) -> JcInvalidation {
    JcInvalidation {
        func_id: func_id,
        reason: reason,
        timestamp: 0,
    }
}

fn jc_stats_summary_new() -> JcStatsSummary {
    JcStatsSummary {
        total_entries: 0,
        valid_entries: 0,
        total_code_bytes: 0,
        hit_rate_pct: 0.0,
        compilations: 0,
        invalidations: 0,
    }
}

// ============================================================================
// Section 4: Cache Lookup
// ============================================================================

// Linear scan for the first valid entry matching func_id. Returns index or JC_INVALID.
fn jc_find_entry(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].func_id == func_id {
            if cache.entries[i as usize].valid {
                return i
            }
        }
        i = i + 1
    }
    JC_INVALID
}

// Find entry matching both func_id and tier. Returns index or JC_INVALID.
fn jc_find_entry_tier(cache: &JcCache, func_id: i64, tier: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].func_id == func_id {
            if cache.entries[i as usize].tier == tier {
                if cache.entries[i as usize].valid {
                    return i
                }
            }
        }
        i = i + 1
    }
    JC_INVALID
}

// Check whether a valid compiled entry exists for func_id.
fn jc_has_compiled(cache: &JcCache, func_id: i64) -> bool with Mut, Div, Panic {
    let idx = jc_find_entry(cache, func_id)
    if idx == JC_INVALID { return false }
    true
}

// Retrieve a copy of the entry at index idx. Returns empty entry if out of range.
fn jc_get_entry(cache: &JcCache, idx: i64) -> JcCodeEntry with Div, Panic {
    if idx < 0 { return jc_empty_entry() }
    if idx >= cache.entry_count { return jc_empty_entry() }
    cache.entries[idx as usize]
}

// Get the code length for the first valid entry of func_id. Returns 0 if not found.
fn jc_get_code_len(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let idx = jc_find_entry(cache, func_id)
    if idx == JC_INVALID { return 0 }
    cache.entries[idx as usize].code_len
}

// ============================================================================
// Section 5: Cache Insert / Update
// ============================================================================

// Insert a new cache entry. Returns the index it was placed at, or JC_INVALID if full.
fn jc_insert_entry(cache: &! JcCache, func_id: i64, tier: i64, code: [i8; 65536], code_len: i64) -> i64 with Mut, Div, Panic {
    if cache.entry_count >= JC_MAX_ENTRIES {
        return JC_INVALID
    }
    let idx = cache.entry_count
    cache.entries[idx as usize].func_id = func_id
    cache.entries[idx as usize].tier = tier
    cache.entries[idx as usize].code_len = code_len
    cache.entries[idx as usize].entry_point = 0
    cache.entries[idx as usize].valid = true
    cache.entries[idx as usize].version = 1
    cache.entries[idx as usize].hit_count = 0

    // Copy code bytes
    var j: i64 = 0
    while j < code_len {
        if j < JC_MAX_CODE {
            cache.entries[idx as usize].code_bytes[j as usize] = code[j as usize]
        }
        j = j + 1
    }

    cache.entry_count = cache.entry_count + 1
    cache.total_compilations = cache.total_compilations + 1
    idx
}

// Update an existing entry with new code and tier. Returns false if idx is invalid.
fn jc_update_entry(cache: &! JcCache, idx: i64, code: [i8; 65536], code_len: i64, new_tier: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }

    cache.entries[idx as usize].tier = new_tier
    cache.entries[idx as usize].code_len = code_len
    cache.entries[idx as usize].version = cache.entries[idx as usize].version + 1

    // Copy code bytes
    var j: i64 = 0
    while j < code_len {
        if j < JC_MAX_CODE {
            cache.entries[idx as usize].code_bytes[j as usize] = code[j as usize]
        }
        j = j + 1
    }

    cache.total_compilations = cache.total_compilations + 1
    true
}

// Set the entry point offset for a cached entry.
fn jc_set_entry_point(cache: &! JcCache, idx: i64, entry_point: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }
    cache.entries[idx as usize].entry_point = entry_point
    true
}

// Bump the version counter of an entry. Returns the new version, or JC_INVALID on error.
fn jc_bump_version(cache: &! JcCache, idx: i64) -> i64 with Mut, Div, Panic {
    if idx < 0 { return JC_INVALID }
    if idx >= cache.entry_count { return JC_INVALID }
    cache.entries[idx as usize].version = cache.entries[idx as usize].version + 1
    cache.entries[idx as usize].version
}

// ============================================================================
// Section 6: Cache Invalidation
// ============================================================================

// Invalidate a single entry by index. Returns false if idx is invalid.
fn jc_invalidate_entry(cache: &! JcCache, idx: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }
    cache.entries[idx as usize].valid = false
    cache.total_invalidations = cache.total_invalidations + 1
    true
}

// Invalidate all entries for a given func_id. Returns count invalidated.
fn jc_invalidate_func(cache: &! JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].func_id == func_id {
            if cache.entries[i as usize].valid {
                cache.entries[i as usize].valid = false
                cache.total_invalidations = cache.total_invalidations + 1
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Invalidate every entry in the cache. Returns count invalidated.
fn jc_invalidate_all(cache: &! JcCache) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            cache.entries[i as usize].valid = false
            cache.total_invalidations = cache.total_invalidations + 1
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Invalidate all entries at a specific compilation tier. Returns count invalidated.
fn jc_invalidate_tier(cache: &! JcCache, tier: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].tier == tier {
            if cache.entries[i as usize].valid {
                cache.entries[i as usize].valid = false
                cache.total_invalidations = cache.total_invalidations + 1
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Check whether an entry at index idx is valid.
fn jc_is_valid(cache: &JcCache, idx: i64) -> bool with Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    cache.entries[idx as usize].valid
}

// ============================================================================
// Section 7: Profiling
// ============================================================================

// Find the profile index for a given func_id. Returns JC_INVALID if not found.
fn jc_find_profile(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < cache.profile_count {
        if cache.profiles[i as usize].func_id == func_id {
            return i
        }
        i = i + 1
    }
    JC_INVALID
}

// Find or create a profile slot for func_id. Returns profile index.
fn jc_get_or_create_profile(cache: &! JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    // Try to find existing
    var i: i64 = 0
    while i < cache.profile_count {
        if cache.profiles[i as usize].func_id == func_id {
            return i
        }
        i = i + 1
    }
    // Create new
    if cache.profile_count >= JC_MAX_PROFILE {
        return JC_INVALID
    }
    let idx = cache.profile_count
    cache.profiles[idx as usize].func_id = func_id
    cache.profiles[idx as usize].call_count = 0
    cache.profiles[idx as usize].loop_count = 0
    cache.profiles[idx as usize].branch_taken = 0
    cache.profiles[idx as usize].branch_not_taken = 0
    cache.profiles[idx as usize].total_cycles = 0
    cache.profiles[idx as usize].last_tier = JC_TIER_INTERP
    cache.profile_count = cache.profile_count + 1
    idx
}

// Record a call to func_id. Returns the new call count.
fn jc_record_call(cache: &! JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_get_or_create_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].call_count = cache.profiles[pidx as usize].call_count + 1
    cache.profiles[pidx as usize].call_count
}

// Record a loop iteration for func_id. Returns the new loop count.
fn jc_record_loop(cache: &! JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_get_or_create_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].loop_count = cache.profiles[pidx as usize].loop_count + 1
    cache.profiles[pidx as usize].loop_count
}

// Record a branch outcome for func_id. Returns the relevant counter.
fn jc_record_branch(cache: &! JcCache, func_id: i64, taken: bool) -> i64 with Mut, Div, Panic {
    let pidx = jc_get_or_create_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    if taken {
        cache.profiles[pidx as usize].branch_taken = cache.profiles[pidx as usize].branch_taken + 1
        return cache.profiles[pidx as usize].branch_taken
    }
    cache.profiles[pidx as usize].branch_not_taken = cache.profiles[pidx as usize].branch_not_taken + 1
    cache.profiles[pidx as usize].branch_not_taken
}

// Add cycles to the total for func_id. Returns updated total.
fn jc_add_cycles(cache: &! JcCache, func_id: i64, cycles: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_get_or_create_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].total_cycles = cache.profiles[pidx as usize].total_cycles + cycles
    cache.profiles[pidx as usize].total_cycles
}

// ============================================================================
// Section 8: Tiered Compilation Decisions
// ============================================================================

// Helper: get call count for a func_id from its profile. Returns 0 if no profile.
fn jc_get_call_count(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].call_count
}

// Helper: get last_tier for a func_id from its profile. Returns JC_TIER_INTERP if no profile.
fn jc_get_last_tier(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return JC_TIER_INTERP }
    cache.profiles[pidx as usize].last_tier
}

// Determine the recommended compilation tier for func_id based on profiling data.
// Returns JC_TIER_INTERP if no compilation is needed, otherwise the recommended tier.
fn jc_should_compile(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return JC_TIER_INTERP }

    let calls = cache.profiles[pidx as usize].call_count
    let current = cache.profiles[pidx as usize].last_tier

    // Already at max tier
    if current >= JC_TIER_NATIVE { return JC_TIER_INTERP }

    // Hot path: promote to OPT if currently at BASELINE or lower
    if calls >= JC_HOT_THRESHOLD {
        if current < JC_TIER_OPT {
            return JC_TIER_OPT
        }
        return JC_TIER_INTERP
    }

    // Warm path: promote to BASELINE if currently interpreted
    if calls >= JC_WARM_THRESHOLD {
        if current < JC_TIER_BASELINE {
            return JC_TIER_BASELINE
        }
        return JC_TIER_INTERP
    }

    JC_TIER_INTERP
}

// Check if a function is "hot" (call count >= HOT_THRESHOLD).
fn jc_is_hot(cache: &JcCache, func_id: i64) -> bool with Mut, Div, Panic {
    let calls = jc_get_call_count(cache, func_id)
    calls >= JC_HOT_THRESHOLD
}

// Check if a function is "warm" (call count >= WARM_THRESHOLD).
fn jc_is_warm(cache: &JcCache, func_id: i64) -> bool with Mut, Div, Panic {
    let calls = jc_get_call_count(cache, func_id)
    calls >= JC_WARM_THRESHOLD
}

// Get the current compilation tier for func_id from the cache entry.
// Returns JC_TIER_INTERP if no compiled entry exists.
fn jc_current_tier(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let idx = jc_find_entry(cache, func_id)
    if idx == JC_INVALID { return JC_TIER_INTERP }
    cache.entries[idx as usize].tier
}

// Promote a function to a new tier. Updates both the cache entry and the profile.
// Returns false if func_id has no cached entry or if new_tier <= current tier.
fn jc_promote_tier(cache: &! JcCache, func_id: i64, new_tier: i64) -> bool with Mut, Div, Panic {
    let idx = jc_find_entry(cache, func_id)
    if idx == JC_INVALID { return false }
    let current = cache.entries[idx as usize].tier
    if new_tier <= current { return false }
    cache.entries[idx as usize].tier = new_tier
    cache.entries[idx as usize].version = cache.entries[idx as usize].version + 1

    // Update profile's last_tier
    let pidx = jc_get_or_create_profile(cache, func_id)
    if pidx != JC_INVALID {
        cache.profiles[pidx as usize].last_tier = new_tier
    }
    true
}

// ============================================================================
// Section 9: Cache Statistics
// ============================================================================

// Record a cache hit. Returns new total hits.
fn jc_record_hit(cache: &! JcCache) -> i64 with Mut {
    cache.total_hits = cache.total_hits + 1
    cache.total_hits
}

// Record a cache miss. Returns new total misses.
fn jc_record_miss(cache: &! JcCache) -> i64 with Mut {
    cache.total_misses = cache.total_misses + 1
    cache.total_misses
}

// Compute the cache hit rate as a percentage (0.0 - 100.0).
// Returns 0.0 if no lookups have been made.
fn jc_hit_rate(cache: &JcCache) -> f64 with Div, Panic {
    let total = cache.total_hits + cache.total_misses
    if total == 0 { return 0.0 }
    let hits_f = cache.total_hits as f64
    let total_f = total as f64
    (hits_f / total_f) * 100.0
}

// Sum of code_len for all valid entries.
fn jc_total_code_bytes(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            total = total + cache.entries[i as usize].code_len
        }
        i = i + 1
    }
    total
}

// Count of valid entries.
fn jc_valid_entry_count(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Build a statistics summary struct.
fn jc_stats_summary(cache: &JcCache) -> JcStatsSummary with Mut, Div, Panic {
    let valid = jc_valid_entry_count(cache)
    let code_bytes = jc_total_code_bytes(cache)
    let rate = jc_hit_rate(cache)
    JcStatsSummary {
        total_entries: cache.entry_count,
        valid_entries: valid,
        total_code_bytes: code_bytes,
        hit_rate_pct: rate,
        compilations: cache.total_compilations,
        invalidations: cache.total_invalidations,
    }
}

// ============================================================================
// Section 10: Code Patching
// ============================================================================

// Patch a single byte in an entry's code buffer. Returns false on invalid index/offset.
fn jc_patch_byte(cache: &! JcCache, idx: i64, offset: i64, val: i8) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }
    if offset < 0 { return false }
    if offset >= cache.entries[idx as usize].code_len { return false }
    cache.entries[idx as usize].code_bytes[offset as usize] = val
    true
}

// Patch a 32-bit little-endian value at offset in an entry's code buffer.
// Writes 4 bytes: val[7:0], val[15:8], val[23:16], val[31:24].
fn jc_patch_i32_le(cache: &! JcCache, idx: i64, offset: i64, val: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }
    if offset < 0 { return false }
    let end = offset + 4
    if end > cache.entries[idx as usize].code_len { return false }

    // Byte 0: bits 0-7
    let b0 = val % 256
    cache.entries[idx as usize].code_bytes[offset as usize] = b0 as i8

    // Byte 1: bits 8-15
    let shifted1 = val / 256
    let b1 = shifted1 % 256
    cache.entries[idx as usize].code_bytes[(offset + 1) as usize] = b1 as i8

    // Byte 2: bits 16-23
    let shifted2 = shifted1 / 256
    let b2 = shifted2 % 256
    cache.entries[idx as usize].code_bytes[(offset + 2) as usize] = b2 as i8

    // Byte 3: bits 24-31
    let shifted3 = shifted2 / 256
    let b3 = shifted3 % 256
    cache.entries[idx as usize].code_bytes[(offset + 3) as usize] = b3 as i8

    true
}

// Patch a 64-bit little-endian value at offset in an entry's code buffer.
// Writes 8 bytes in little-endian order.
fn jc_patch_i64_le(cache: &! JcCache, idx: i64, offset: i64, val: i64) -> bool with Mut, Div, Panic {
    if idx < 0 { return false }
    if idx >= cache.entry_count { return false }
    if cache.entries[idx as usize].valid == false { return false }
    if offset < 0 { return false }
    let end = offset + 8
    if end > cache.entries[idx as usize].code_len { return false }

    var remaining = val
    var k: i64 = 0
    while k < 8 {
        let byte_val = remaining % 256
        cache.entries[idx as usize].code_bytes[(offset + k) as usize] = byte_val as i8
        remaining = remaining / 256
        k = k + 1
    }

    true
}

// Copy the code bytes of entry idx into dst. Returns the code_len copied, or 0 on error.
fn jc_copy_code(cache: &JcCache, idx: i64, dst: &! [i8; 65536]) -> i64 with Mut, Div, Panic {
    if idx < 0 { return 0 }
    if idx >= cache.entry_count { return 0 }
    if cache.entries[idx as usize].valid == false { return 0 }

    let len = cache.entries[idx as usize].code_len
    var j: i64 = 0
    while j < len {
        dst[j as usize] = cache.entries[idx as usize].code_bytes[j as usize]
        j = j + 1
    }
    len
}

// ============================================================================
// Section 11: LRU / Eviction
// ============================================================================

// Find the valid entry with the lowest hit_count (approximation of LRU).
// Returns the index of that entry, or JC_INVALID if no valid entries.
fn jc_find_lru_entry(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var best_idx: i64 = JC_INVALID
    var best_hits: i64 = 0
    var first: bool = true
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            if first {
                best_idx = i
                best_hits = cache.entries[i as usize].hit_count
                first = false
            } else {
                if cache.entries[i as usize].hit_count < best_hits {
                    best_idx = i
                    best_hits = cache.entries[i as usize].hit_count
                }
            }
        }
        i = i + 1
    }
    best_idx
}

// Evict the least recently used valid entry. Returns the func_id of the evicted entry,
// or JC_INVALID if cache is empty.
fn jc_evict_lru(cache: &! JcCache) -> i64 with Mut, Div, Panic {
    let idx = jc_find_lru_entry(cache)
    if idx == JC_INVALID { return JC_INVALID }
    let fid = cache.entries[idx as usize].func_id
    cache.entries[idx as usize].valid = false
    cache.total_invalidations = cache.total_invalidations + 1
    fid
}

// Evict all entries with hit_count below threshold. Returns count evicted.
fn jc_evict_cold(cache: &! JcCache, threshold: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            if cache.entries[i as usize].hit_count < threshold {
                cache.entries[i as usize].valid = false
                cache.total_invalidations = cache.total_invalidations + 1
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Compact the cache by moving valid entries to the front, removing gaps left by
// invalidated entries. Returns the number of slots freed.
fn jc_compact(cache: &! JcCache) -> i64 with Mut, Div, Panic {
    let old_count = cache.entry_count
    var write_idx: i64 = 0
    var read_idx: i64 = 0

    while read_idx < old_count {
        if cache.entries[read_idx as usize].valid {
            if write_idx != read_idx {
                // Copy entry from read_idx to write_idx
                cache.entries[write_idx as usize].func_id = cache.entries[read_idx as usize].func_id
                cache.entries[write_idx as usize].tier = cache.entries[read_idx as usize].tier
                cache.entries[write_idx as usize].code_len = cache.entries[read_idx as usize].code_len
                cache.entries[write_idx as usize].entry_point = cache.entries[read_idx as usize].entry_point
                cache.entries[write_idx as usize].valid = true
                cache.entries[write_idx as usize].version = cache.entries[read_idx as usize].version
                cache.entries[write_idx as usize].hit_count = cache.entries[read_idx as usize].hit_count

                // Copy code bytes
                var k: i64 = 0
                while k < cache.entries[read_idx as usize].code_len {
                    cache.entries[write_idx as usize].code_bytes[k as usize] = cache.entries[read_idx as usize].code_bytes[k as usize]
                    k = k + 1
                }

                // Invalidate the old slot
                cache.entries[read_idx as usize].valid = false
            }
            write_idx = write_idx + 1
        }
        read_idx = read_idx + 1
    }

    // Clear slots after the last valid entry
    var c: i64 = write_idx
    while c < old_count {
        cache.entries[c as usize].func_id = JC_INVALID
        cache.entries[c as usize].valid = false
        cache.entries[c as usize].code_len = 0
        c = c + 1
    }

    let freed = old_count - write_idx
    cache.entry_count = write_idx
    freed
}

// ============================================================================
// Section 12: Extended Utilities
// ============================================================================

// --------------------------------------------------------------------------
// Batch operations
// --------------------------------------------------------------------------

// Bump hit_count for an entry by index. Returns the new hit_count, or 0 on error.
fn jc_bump_hit_count(cache: &! JcCache, idx: i64) -> i64 with Mut, Div, Panic {
    if idx < 0 { return 0 }
    if idx >= cache.entry_count { return 0 }
    if cache.entries[idx as usize].valid == false { return 0 }
    cache.entries[idx as usize].hit_count = cache.entries[idx as usize].hit_count + 1
    cache.entries[idx as usize].hit_count
}

// Reset all hit counts to zero. Returns the number of entries reset.
fn jc_reset_hit_counts(cache: &! JcCache) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            cache.entries[i as usize].hit_count = 0
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count how many entries belong to a particular tier.
fn jc_count_tier(cache: &JcCache, tier: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            if cache.entries[i as usize].tier == tier {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Get the highest tier entry for a given func_id. Returns the tier, or JC_TIER_INTERP
// if no compiled entry exists.
fn jc_best_tier(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    var best: i64 = JC_TIER_INTERP
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].func_id == func_id {
            if cache.entries[i as usize].valid {
                if cache.entries[i as usize].tier > best {
                    best = cache.entries[i as usize].tier
                }
            }
        }
        i = i + 1
    }
    best
}

// Count how many distinct func_ids have compiled entries.
fn jc_distinct_funcs(cache: &JcCache) -> i64 with Mut, Div, Panic {
    // Simple O(n^2) approach with no auxiliary storage
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            // Check if this func_id appeared in any earlier valid entry
            var seen: bool = false
            var j: i64 = 0
            while j < i {
                if cache.entries[j as usize].valid {
                    if cache.entries[j as usize].func_id == cache.entries[i as usize].func_id {
                        seen = true
                    }
                }
                j = j + 1
            }
            if seen == false {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Invalidate entries for func_id that are below a given tier.
// Useful when promoting: invalidate old BASELINE after compiling OPT.
// Returns count invalidated.
fn jc_invalidate_below_tier(cache: &! JcCache, func_id: i64, tier: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].func_id == func_id {
            if cache.entries[i as usize].valid {
                if cache.entries[i as usize].tier < tier {
                    cache.entries[i as usize].valid = false
                    cache.total_invalidations = cache.total_invalidations + 1
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    count
}

// Get the total number of profiled functions.
fn jc_profiled_func_count(cache: &JcCache) -> i64 {
    cache.profile_count
}

// Reset all profiling counters to zero. Does not remove the profile entries.
// Returns count of profiles reset.
fn jc_reset_profiles(cache: &! JcCache) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < cache.profile_count {
        cache.profiles[i as usize].call_count = 0
        cache.profiles[i as usize].loop_count = 0
        cache.profiles[i as usize].branch_taken = 0
        cache.profiles[i as usize].branch_not_taken = 0
        cache.profiles[i as usize].total_cycles = 0
        count = count + 1
        i = i + 1
    }
    count
}

// Get the profile data for a func_id. Returns an empty profile if not found.
fn jc_get_profile(cache: &JcCache, func_id: i64) -> JcProfileData with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return jc_empty_profile() }
    cache.profiles[pidx as usize]
}

// Get the loop count for a func_id. Returns 0 if no profile.
fn jc_get_loop_count(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].loop_count
}

// Get the branch ratio (taken / total branches) for a func_id.
// Returns 0.0 if no branches recorded.
fn jc_branch_taken_ratio(cache: &JcCache, func_id: i64) -> f64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return 0.0 }
    let taken = cache.profiles[pidx as usize].branch_taken
    let not_taken = cache.profiles[pidx as usize].branch_not_taken
    let total = taken + not_taken
    if total == 0 { return 0.0 }
    let taken_f = taken as f64
    let total_f = total as f64
    taken_f / total_f
}

// Get the total cycles for a func_id. Returns 0 if no profile.
fn jc_get_total_cycles(cache: &JcCache, func_id: i64) -> i64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return 0 }
    cache.profiles[pidx as usize].total_cycles
}

// Get average cycles per call. Returns 0.0 if no calls recorded.
fn jc_avg_cycles_per_call(cache: &JcCache, func_id: i64) -> f64 with Mut, Div, Panic {
    let pidx = jc_find_profile(cache, func_id)
    if pidx == JC_INVALID { return 0.0 }
    let calls = cache.profiles[pidx as usize].call_count
    if calls == 0 { return 0.0 }
    let cycles_f = cache.profiles[pidx as usize].total_cycles as f64
    let calls_f = calls as f64
    cycles_f / calls_f
}

// --------------------------------------------------------------------------
// Diagnostic helpers
// --------------------------------------------------------------------------

// Check if cache is at capacity (entry_count == JC_MAX_ENTRIES).
fn jc_is_full(cache: &JcCache) -> bool {
    cache.entry_count >= JC_MAX_ENTRIES
}

// Check if profile storage is at capacity.
fn jc_profiles_full(cache: &JcCache) -> bool {
    cache.profile_count >= JC_MAX_PROFILE
}

// Compute cache utilization as a percentage (0.0 - 100.0).
fn jc_utilization(cache: &JcCache) -> f64 with Div, Panic {
    if JC_MAX_ENTRIES == 0 { return 0.0 }
    let used = cache.entry_count as f64
    let max = JC_MAX_ENTRIES as f64
    (used / max) * 100.0
}

// Compute valid-entry utilization (valid entries / max entries as percentage).
fn jc_valid_utilization(cache: &JcCache) -> f64 with Mut, Div, Panic {
    if JC_MAX_ENTRIES == 0 { return 0.0 }
    let valid = jc_valid_entry_count(cache) as f64
    let max = JC_MAX_ENTRIES as f64
    (valid / max) * 100.0
}

// Return the fragmentation ratio: (total_entries - valid_entries) / total_entries.
// Higher values mean more wasted slots from invalidation.
fn jc_fragmentation(cache: &JcCache) -> f64 with Mut, Div, Panic {
    if cache.entry_count == 0 { return 0.0 }
    let total_f = cache.entry_count as f64
    let valid = jc_valid_entry_count(cache)
    let invalid = cache.entry_count - valid
    let invalid_f = invalid as f64
    invalid_f / total_f
}

// Find the entry with the highest hit count. Returns its index or JC_INVALID.
fn jc_find_hottest_entry(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var best_idx: i64 = JC_INVALID
    var best_hits: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            if cache.entries[i as usize].hit_count > best_hits {
                best_idx = i
                best_hits = cache.entries[i as usize].hit_count
            }
        }
        i = i + 1
    }
    best_idx
}

// Sum of all hit_counts across all valid entries.
fn jc_total_hits_all_entries(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            total = total + cache.entries[i as usize].hit_count
        }
        i = i + 1
    }
    total
}

// Get the average code length across valid entries. Returns 0.0 if no valid entries.
fn jc_avg_code_len(cache: &JcCache) -> f64 with Mut, Div, Panic {
    let valid = jc_valid_entry_count(cache)
    if valid == 0 { return 0.0 }
    let total = jc_total_code_bytes(cache) as f64
    let valid_f = valid as f64
    total / valid_f
}

// Find the entry with the largest code_len among valid entries. Returns index or JC_INVALID.
fn jc_find_largest_entry(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var best_idx: i64 = JC_INVALID
    var best_len: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        if cache.entries[i as usize].valid {
            if cache.entries[i as usize].code_len > best_len {
                best_idx = i
                best_len = cache.entries[i as usize].code_len
            }
        }
        i = i + 1
    }
    best_idx
}

// --------------------------------------------------------------------------
// Verification / consistency checks
// --------------------------------------------------------------------------

// Verify that all entries before entry_count have a non-JC_INVALID func_id
// (i.e., they were properly initialized). Returns count of anomalies found.
fn jc_verify_entries(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var anomalies: i64 = 0
    var i: i64 = 0
    while i < cache.entry_count {
        // A valid entry should have a real func_id
        if cache.entries[i as usize].valid {
            if cache.entries[i as usize].func_id == JC_INVALID {
                anomalies = anomalies + 1
            }
            // code_len should be non-negative
            if cache.entries[i as usize].code_len < 0 {
                anomalies = anomalies + 1
            }
            // code_len should not exceed buffer size
            if cache.entries[i as usize].code_len > JC_MAX_CODE {
                anomalies = anomalies + 1
            }
            // version should be positive
            if cache.entries[i as usize].version <= 0 {
                anomalies = anomalies + 1
            }
        }
        i = i + 1
    }
    anomalies
}

// Verify profile array consistency. Returns count of anomalies.
fn jc_verify_profiles(cache: &JcCache) -> i64 with Mut, Div, Panic {
    var anomalies: i64 = 0
    var i: i64 = 0
    while i < cache.profile_count {
        // func_id should not be JC_INVALID in a used profile slot
        if cache.profiles[i as usize].func_id == JC_INVALID {
            anomalies = anomalies + 1
        }
        // Counts should be non-negative
        if cache.profiles[i as usize].call_count < 0 {
            anomalies = anomalies + 1
        }
        if cache.profiles[i as usize].loop_count < 0 {
            anomalies = anomalies + 1
        }
        if cache.profiles[i as usize].branch_taken < 0 {
            anomalies = anomalies + 1
        }
        if cache.profiles[i as usize].branch_not_taken < 0 {
            anomalies = anomalies + 1
        }
        if cache.profiles[i as usize].total_cycles < 0 {
            anomalies = anomalies + 1
        }
        i = i + 1
    }
    anomalies
}

// Full cache integrity check. Returns 0 if clean, positive for number of issues.
fn jc_verify_all(cache: &JcCache) -> i64 with Mut, Div, Panic {
    let e_issues = jc_verify_entries(cache)
    let p_issues = jc_verify_profiles(cache)
    e_issues + p_issues
}

// ============================================================================
// Section 13: Tests
// ============================================================================

// --------------------------------------------------------------------------
// Test helper: build a small code buffer filled with a pattern byte
// --------------------------------------------------------------------------

fn jc_test_code(pattern: i8, len: i64) -> [i8; 65536] with Mut, Div, Panic {
    var buf: [i8; 65536] = [0; 65536]
    var i: i64 = 0
    while i < len {
        if i < JC_MAX_CODE {
            buf[i as usize] = pattern
        }
        i = i + 1
    }
    buf
}

// --------------------------------------------------------------------------
// Category 1: Lookup / Insert Basics  (T01 - T05)
// --------------------------------------------------------------------------

// T01: Insert one entry and look it up by func_id
fn test_jc_insert_lookup_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(42 as i8, 16)
    let idx = jc_insert_entry(cache, 100, JC_TIER_BASELINE, code, 16)
    if idx != 0 { return false }
    let found = jc_find_entry(cache, 100)
    if found != 0 { return false }
    let entry = jc_get_entry(cache, found)
    if entry.func_id != 100 { return false }
    if entry.tier != JC_TIER_BASELINE { return false }
    if entry.code_len != 16 { return false }
    if entry.valid == false { return false }
    true
}
fn test_jc_insert_lookup() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_insert_lookup_inner(&! cache)
}

// T02: has_compiled returns true for inserted, false for missing
fn test_jc_has_compiled_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    if jc_has_compiled(cache, 200) { return false }
    let code = jc_test_code(1 as i8, 8)
    let idx = jc_insert_entry(cache, 200, JC_TIER_BASELINE, code, 8)
    if jc_has_compiled(cache, 200) == false { return false }
    if jc_has_compiled(cache, 201) { return false }
    true
}
fn test_jc_has_compiled() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_has_compiled_inner(&! cache)
}

// T03: find_entry returns JC_INVALID for non-existent func_id
fn test_jc_find_miss_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let idx = jc_find_entry(cache, 999)
    idx == JC_INVALID
}
fn test_jc_find_miss() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_find_miss_inner(&! cache)
}

// T04: get_entry returns empty for out-of-range index
fn test_jc_get_entry_oob_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let entry = jc_get_entry(cache, 9999)
    if entry.func_id != JC_INVALID { return false }
    let entry_neg = jc_get_entry(cache, 0 - 5)
    entry_neg.func_id == JC_INVALID
}
fn test_jc_get_entry_oob() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_get_entry_oob_inner(&! cache)
}

// T05: get_code_len returns correct length after insert
fn test_jc_get_code_len_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(7 as i8, 128)
    let idx = jc_insert_entry(cache, 300, JC_TIER_OPT, code, 128)
    let len = jc_get_code_len(cache, 300)
    if len != 128 { return false }
    let missing_len = jc_get_code_len(cache, 301)
    missing_len == 0
}
fn test_jc_get_code_len() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_get_code_len_inner(&! cache)
}

// --------------------------------------------------------------------------
// Category 2: Cache Miss / Hit Tracking  (T06 - T10)
// --------------------------------------------------------------------------

// T06: Record hits and misses
fn test_jc_hit_miss_tracking_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let h1 = jc_record_hit(cache)
    let h2 = jc_record_hit(cache)
    let m1 = jc_record_miss(cache)
    if h1 != 1 { return false }
    if h2 != 2 { return false }
    if m1 != 1 { return false }
    if cache.total_hits != 2 { return false }
    cache.total_misses == 1
}
fn test_jc_hit_miss_tracking() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_hit_miss_tracking_inner(&! cache)
}

// T07: Hit rate calculation — 50%
fn test_jc_hit_rate_50_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let h = jc_record_hit(cache)
    let m = jc_record_miss(cache)
    let rate = jc_hit_rate(cache)
    // rate should be 50.0
    if rate < 49.9 { return false }
    if rate > 50.1 { return false }
    true
}
fn test_jc_hit_rate_50() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_hit_rate_50_inner(&! cache)
}

// T08: Hit rate of empty cache is 0.0
fn test_jc_hit_rate_zero_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let rate = jc_hit_rate(cache)
    rate == 0.0
}
fn test_jc_hit_rate_zero() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_hit_rate_zero_inner(&! cache)
}

// T09: Hit rate 100%
fn test_jc_hit_rate_100_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let h1 = jc_record_hit(cache)
    let h2 = jc_record_hit(cache)
    let h3 = jc_record_hit(cache)
    let rate = jc_hit_rate(cache)
    if rate < 99.9 { return false }
    if rate > 100.1 { return false }
    true
}
fn test_jc_hit_rate_100() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_hit_rate_100_inner(&! cache)
}

// T10: total_compilations increments on insert
fn test_jc_compilation_count_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    if cache.total_compilations != 0 { return false }
    let code = jc_test_code(1 as i8, 4)
    let idx1 = jc_insert_entry(cache, 1, JC_TIER_BASELINE, code, 4)
    if cache.total_compilations != 1 { return false }
    let idx2 = jc_insert_entry(cache, 2, JC_TIER_OPT, code, 4)
    cache.total_compilations == 2
}
fn test_jc_compilation_count() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_compilation_count_inner(&! cache)
}

// --------------------------------------------------------------------------
// Category 3: Tier Promotion  (T11 - T15)
// --------------------------------------------------------------------------

// T11: Promote from BASELINE to OPT
fn test_jc_promote_baseline_to_opt_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(10 as i8, 32)
    let idx = jc_insert_entry(cache, 500, JC_TIER_BASELINE, code, 32)
    let ok = jc_promote_tier(cache, 500, JC_TIER_OPT)
    if ok == false { return false }
    let tier = jc_current_tier(cache, 500)
    tier == JC_TIER_OPT
}
fn test_jc_promote_baseline_to_opt() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_promote_baseline_to_opt_inner(&! cache)
}

// T12: Promote rejects downgrade (OPT -> BASELINE)
fn test_jc_promote_reject_downgrade_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(10 as i8, 32)
    let idx = jc_insert_entry(cache, 501, JC_TIER_OPT, code, 32)
    let ok = jc_promote_tier(cache, 501, JC_TIER_BASELINE)
    ok == false
}
fn test_jc_promote_reject_downgrade() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_promote_reject_downgrade_inner(&! cache)
}

// T13: Promote rejects same tier
fn test_jc_promote_reject_same_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(10 as i8, 32)
    let idx = jc_insert_entry(cache, 502, JC_TIER_BASELINE, code, 32)
    let ok = jc_promote_tier(cache, 502, JC_TIER_BASELINE)
    ok == false
}
fn test_jc_promote_reject_same() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_promote_reject_same_inner(&! cache)
}

// T14: Promote updates profile last_tier
fn test_jc_promote_updates_profile_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(10 as i8, 16)
