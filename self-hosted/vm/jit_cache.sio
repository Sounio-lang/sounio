// --------------------------------------------------------------------------
// Category 10: Edge Cases  (T46 - T55)
// --------------------------------------------------------------------------

// T46: Update entry changes code and tier
fn test_jc_update_entry_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code1 = jc_test_code(10 as i8, 16)
    let idx = jc_insert_entry(cache, 2100, JC_TIER_BASELINE, code1, 16)
    let code2 = jc_test_code(20 as i8, 32)
    let ok = jc_update_entry(cache, idx, code2, 32, JC_TIER_OPT)
    if ok == false { return false }
    let entry = jc_get_entry(cache, idx)
    if entry.tier != JC_TIER_OPT { return false }
    if entry.code_len != 32 { return false }
    // Version should have been bumped
    if entry.version < 2 { return false }
    // Verify code byte changed
    entry.code_bytes[0 as usize] == 20 as i8
}
fn test_jc_update_entry() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_update_entry_inner(&! cache)
}

// T47: Set entry point
fn test_jc_set_entry_point_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 64)
    let idx = jc_insert_entry(cache, 2200, JC_TIER_OPT, code, 64)
    let ok = jc_set_entry_point(cache, idx, 16)
    if ok == false { return false }
    let entry = jc_get_entry(cache, idx)
    entry.entry_point == 16
