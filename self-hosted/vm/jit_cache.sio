// --------------------------------------------------------------------------

// T31: Patch a single byte and verify
fn test_jc_patch_byte_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 32)
    let idx = jc_insert_entry(cache, 1200, JC_TIER_OPT, code, 32)
    let ok = jc_patch_byte(cache, idx, 5, 99 as i8)
    if ok == false { return false }
    let entry = jc_get_entry(cache, idx)
    entry.code_bytes[5 as usize] == 99 as i8
}
fn test_jc_patch_byte() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_byte_inner(&! cache)
}

// T32: Patch byte out of range returns false
fn test_jc_patch_byte_oob_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 8)
    let idx = jc_insert_entry(cache, 1201, JC_TIER_BASELINE, code, 8)
    let ok = jc_patch_byte(cache, idx, 8, 1 as i8)
    ok == false
}
fn test_jc_patch_byte_oob() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_byte_oob_inner(&! cache)
}

// T33: Patch i32 little-endian
fn test_jc_patch_i32_le_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 32)
    let idx = jc_insert_entry(cache, 1202, JC_TIER_OPT, code, 32)
    // Patch value 0x04030201 = 67305985 at offset 4
    let ok = jc_patch_i32_le(cache, idx, 4, 67305985)
    if ok == false { return false }
    let entry = jc_get_entry(cache, idx)
    // Little-endian: byte 4 = 0x01, byte 5 = 0x02, byte 6 = 0x03, byte 7 = 0x04
    if entry.code_bytes[4 as usize] != 1 as i8 { return false }
    if entry.code_bytes[5 as usize] != 2 as i8 { return false }
    if entry.code_bytes[6 as usize] != 3 as i8 { return false }
    if entry.code_bytes[7 as usize] != 4 as i8 { return false }
    true
}
fn test_jc_patch_i32_le() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_i32_le_inner(&! cache)
}

// T34: Patch i64 little-endian
fn test_jc_patch_i64_le_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(0 as i8, 32)
    let idx = jc_insert_entry(cache, 1203, JC_TIER_OPT, code, 32)
    // Patch value 256 = 0x0000000000000100 at offset 0
    let ok = jc_patch_i64_le(cache, idx, 0, 256)
    if ok == false { return false }
    let entry = jc_get_entry(cache, idx)
    // Little-endian: byte 0 = 0x00, byte 1 = 0x01, bytes 2-7 = 0x00
    if entry.code_bytes[0 as usize] != 0 as i8 { return false }
    if entry.code_bytes[1 as usize] != 1 as i8 { return false }
    if entry.code_bytes[2 as usize] != 0 as i8 { return false }
    true
}
fn test_jc_patch_i64_le() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_i64_le_inner(&! cache)
}

// T35: Patch on invalid entry returns false
fn test_jc_patch_invalid_entry_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let ok = jc_patch_byte(cache, 0, 0, 1 as i8)
    ok == false
}
fn test_jc_patch_invalid_entry() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_patch_invalid_entry_inner(&! cache)
}

