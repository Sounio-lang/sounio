// T36: find_lru_entry returns entry with lowest hit_count
fn test_jc_find_lru_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 1300, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 1301, JC_TIER_BASELINE, code, 4)
    let idx2 = jc_insert_entry(cache, 1302, JC_TIER_BASELINE, code, 4)
    // Bump hit count of entries 0 and 2
    cache.entries[idx0 as usize].hit_count = 10
    cache.entries[idx2 as usize].hit_count = 5
    // Entry 1 has hit_count = 0, should be LRU
    let lru = jc_find_lru_entry(cache)
    lru == idx1
}
fn test_jc_find_lru() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_find_lru_inner(&! cache)
}

// T37: evict_lru removes the LRU entry
fn test_jc_evict_lru_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 1400, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 1401, JC_TIER_BASELINE, code, 4)
    cache.entries[idx0 as usize].hit_count = 50
    // idx1 has hit_count = 0
    let evicted_fid = jc_evict_lru(cache)
    if evicted_fid != 1401 { return false }
    if jc_is_valid(cache, idx1) { return false }
    jc_is_valid(cache, idx0)
}
fn test_jc_evict_lru() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_evict_lru_inner(&! cache)
}

// T38: evict_lru on empty cache returns JC_INVALID
fn test_jc_evict_lru_empty_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let fid = jc_evict_lru(cache)
    fid == JC_INVALID
}
fn test_jc_evict_lru_empty() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_evict_lru_empty_inner(&! cache)
}

// T39: evict_cold removes entries below threshold
fn test_jc_evict_cold_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 1500, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 1501, JC_TIER_BASELINE, code, 4)
    let idx2 = jc_insert_entry(cache, 1502, JC_TIER_BASELINE, code, 4)
    cache.entries[idx0 as usize].hit_count = 100
    cache.entries[idx1 as usize].hit_count = 3
    cache.entries[idx2 as usize].hit_count = 1
    let evicted = jc_evict_cold(cache, 5)
    if evicted != 2 { return false }
    if jc_is_valid(cache, idx0) == false { return false }
    if jc_is_valid(cache, idx1) { return false }
    if jc_is_valid(cache, idx2) { return false }
    true
}
fn test_jc_evict_cold() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_evict_cold_inner(&! cache)
}

// T40: compact removes gaps
fn test_jc_compact_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 1600, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 1601, JC_TIER_BASELINE, code, 4)
    let idx2 = jc_insert_entry(cache, 1602, JC_TIER_BASELINE, code, 4)
    // Invalidate the middle entry
    let ok = jc_invalidate_entry(cache, idx1)
    let freed = jc_compact(cache)
    if freed != 1 { return false }
    if cache.entry_count != 2 { return false }
    // Entry 0 should still be func 1600
    let e0 = jc_get_entry(cache, 0)
    if e0.func_id != 1600 { return false }
    // Entry 1 should now be func 1602 (moved forward)
    let e1 = jc_get_entry(cache, 1)
    e1.func_id == 1602
}
fn test_jc_compact() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_compact_inner(&! cache)
}

