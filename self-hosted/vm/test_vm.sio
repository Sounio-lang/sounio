// self-hosted::vm::test_vm — Self-Hosted VM Test Suite
//
// Validates that the self-hosted VM can execute IR programs correctly.
// This removes dependency on the Rust interpreter!

// ============================================================================
// Test Helpers
// ============================================================================

fn run_vm(module: IrModule) -> i64 with Mut, Panic, Div, Alloc, IO {
    let main_fn = vm_find_main_fn_id(module)
    if main_fn < 0 { return -1 }

    var state = vm_new_state(main_fn)

    // Execute up to 10000 steps (prevent infinite loops in tests)
    var steps: i64 = 0
    while !state.halted && steps < 10000 {
        state = vm_step(state, module)
        steps = steps + 1
    }

    if !state.halted { return -2 }  // Timeout
    state.exit_code
}

fn run_vm_with_result(module: IrModule) -> (bool, i64) with Mut, Panic, Div, Alloc, IO {
    let main_fn = vm_find_main_fn_id(module)
    if main_fn < 0 { return (false, -1) }

    var state = vm_new_state(main_fn)

    var steps: i64 = 0
    while !state.halted && steps < 10000 {
        state = vm_step(state, module)
        steps = steps + 1
    }

    if !state.halted { return (false, -2) }

    // Get result from register 0 (common convention for main's return value)
    let result = val_to_i64(state.regs[0])
    (true, result)
}

// ============================================================================
// Tests
// ============================================================================

// T01: Basic arithmetic - fn main() -> i64 { 10 + 32 }
fn test_basic_arithmetic() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = vm_main_name()
    func.reg_count = 3
    func.instr_count = 3

    // v0 = 10
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 10))

    // v1 = 32
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 32))

    // v2 = v0 + v1
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))

    // return v2 (implicit - main returns last computed value)
    // For explicit return:
    func.instr_count = 4
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))

    ir_fn_set(&! module, 0, func)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    if result.1 != 42 { return 2 }

    0
}

// T02: Function call - fn add(a,b) { a+b }; fn main() { add(10, 32) }
fn test_function_call() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 2

    // Function 0: add(a, b) -> a + b
    var add_fn = ir_empty_function()
    add_fn.name = ir_name_from_bytes(97, 100, 100, 0, 3)  // "add"
    add_fn.param_count = 2
    add_fn.param_regs[0] = 0
    add_fn.param_regs[1] = 1
    add_fn.reg_count = 3
    add_fn.instr_count = 2

    ir_arena_store(ir_region_slot_w(add_fn.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(add_fn.region, (1)), ir_return(2))

    ir_fn_set(&! module, 0, add_fn)

    // Function 1: main() -> add(10, 32)
    var main_fn = ir_empty_function()
    main_fn.name = vm_main_name()
    main_fn.reg_count = 3
    main_fn.instr_count = 4

    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 10))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 32))

    // Build call args
    let arg0 = ir_reg_list_single(0)
    let args = ir_reg_list_append(arg0, 1)

    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_call(
        2,
        0,  // fn_id = 0 (add function)
        ir_name_from_bytes(97, 100, 100, 0, 3),
        Some(Box::new(args)),
        2
    ))

    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_return(2))

    ir_fn_set(&! module, 1, main_fn)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    if result.1 != 42 { return 2 }

    0
}

// T03: Conditional branch - if (x < 50) { 1 } else { 0 }
fn test_conditional_branch() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = vm_main_name()
    func.reg_count = 5
    func.label_count = 2
    func.instr_count = 11

    // v0 = 42
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 42))

    // v1 = 50
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 50))

    // v2 = v0 < v1
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpLt, 1))

    // if v2 goto label 0 (then branch)
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_branch_true(2, 0))

    // else branch:
    // v3 = 0
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_load_imm(3, 0))

    // goto label 1 (end)
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_jump(1))

    // label 0 (then branch):
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_label(0))

    // v3 = 1
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_load_imm(3, 1))

    // label 1 (end):
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_label(1))

    // v4 = v3  (copy result)
    ir_arena_store(ir_region_slot_w(func.region, (9)), ir_copy(4, 3))

    // return v4
    ir_arena_store(ir_region_slot_w(func.region, (10)), ir_return(4))

    ir_fn_set(&! module, 0, func)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    if result.1 != 1 { return 2 }  // 42 < 50 is true, so returns 1

    0
}

// T04: Loop - sum = 0; i = 0; while (i < 5) { sum += i; i += 1 }
fn test_loop() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = vm_main_name()
    func.reg_count = 10
    func.label_count = 2
    func.instr_count = 20

    var pc: i64 = 0

    // sum = 0 (v0)
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_load_imm(0, 0))
    pc = pc + 1

    // i = 0 (v1)
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_load_imm(1, 0))
    pc = pc + 1

    // label 0 (loop start):
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_label(0))
    pc = pc + 1

    // v2 = 5
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_load_imm(2, 5))
    pc = pc + 1

    // v3 = i < 5
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_binop(3, 1, BinaryOp::OpLt, 2))
    pc = pc + 1

    // if !v3 goto label 1 (exit)
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_branch_false(3, 1))
    pc = pc + 1

    // sum = sum + i
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_binop(4, 0, BinaryOp::OpAdd, 1))
    pc = pc + 1

    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_copy(0, 4))
    pc = pc + 1

    // i = i + 1
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_load_imm(5, 1))
    pc = pc + 1

    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_binop(6, 1, BinaryOp::OpAdd, 5))
    pc = pc + 1

    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_copy(1, 6))
    pc = pc + 1

    // goto label 0 (loop)
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_jump(0))
    pc = pc + 1

    // label 1 (exit):
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_label(1))
    pc = pc + 1

    // return sum
    ir_arena_store(ir_region_slot_w(func.region, (pc)), ir_return(0))
    pc = pc + 1

    func.instr_count = pc

    ir_fn_set(&! module, 0, func)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    // 0 + 1 + 2 + 3 + 4 = 10
    if result.1 != 10 { return 2 }

    0
}

// T05: Multiple operations - (10 + 20) * 2
fn test_multiple_operations() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = vm_main_name()
    func.reg_count = 5
    func.instr_count = 5

    // v0 = 10
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 10))

    // v1 = 20
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 20))

    // v2 = v0 + v1  // 30
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))

    // v3 = 2
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(3, 2))

    // v4 = v2 * v3  // 60
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 2, BinaryOp::OpMul, 3))

    func.instr_count = 6
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_return(4))

    ir_fn_set(&! module, 0, func)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    if result.1 != 60 { return 2 }

    0
}

// T06: Struct copy must deep-clone aggregate fields (no array aliasing)
fn test_struct_array_copy_no_alias() -> i64 with Mut, Panic, Div, Alloc, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = vm_main_name()
    func.reg_count = 16
    func.instr_count = 16

    let arr_name = ir_name_from_bytes(97, 114, 114, 0, 3) // "arr"

    // v0 = alloc Struct
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 0))
    // v1 = alloc Array
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_alloc(1, 1))
    // v2 = 0, v3 = 1, v4 = 10, v5 = 20
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(2, 0))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(3, 1))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_load_imm(4, 10))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(5, 20))

    // v1[0] = 10; v1[1] = 20
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_index_set(1, 2, 4))
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_index_set(1, 3, 5))

    // v0.arr = v1
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_field_set(0, 0, 1, arr_name))

    // v6 = copy(v0) -> requires deep clone for struct aggregates
    ir_arena_store(ir_region_slot_w(func.region, (9)), ir_copy(6, 0))

    // mutate clone: v6.arr[0] = 99
    ir_arena_store(ir_region_slot_w(func.region, (10)), ir_field_get(7, 6, 0, arr_name))
    ir_arena_store(ir_region_slot_w(func.region, (11)), ir_load_imm(8, 99))
    ir_arena_store(ir_region_slot_w(func.region, (12)), ir_index_set(7, 2, 8))

    // read original: return v0.arr[0], should remain 10
    ir_arena_store(ir_region_slot_w(func.region, (13)), ir_field_get(9, 0, 0, arr_name))
    ir_arena_store(ir_region_slot_w(func.region, (14)), ir_index_get(10, 9, 2))
    ir_arena_store(ir_region_slot_w(func.region, (15)), ir_return(10))

    ir_fn_set(&! module, 0, func)

    let result = run_vm_with_result(module)
    if result.0 == 0 { return 1 }
    if result.1 != 10 { return 2 }

    0
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn test_vm_suite_main() -> i64 with Mut, Panic, Div, Alloc, IO {
    var failed: i64 = 0

    if test_basic_arithmetic() != 0 { failed = failed + 1 }
    if test_function_call() != 0 { failed = failed + 1 }
    if test_conditional_branch() != 0 { failed = failed + 1 }
    if test_loop() != 0 { failed = failed + 1 }
    if test_multiple_operations() != 0 { failed = failed + 1 }
    if test_struct_array_copy_no_alias() != 0 { failed = failed + 1 }

    if failed == 0 { 0 } else { 1 }
}
