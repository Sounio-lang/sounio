    let ok3 = gth_channel_send(sched, ch, m3)
    let r1 = gth_channel_recv(sched, ch)
    let r2 = gth_channel_recv(sched, ch)
    let r3 = gth_channel_recv(sched, ch)
    r1.value == 10 && r2.value == 20 && r3.value == 30
}
