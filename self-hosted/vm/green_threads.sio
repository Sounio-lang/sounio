// ---------------------------------------------------------------------------
// Combined scenarios — T78: spawn, schedule, yield, done cycle
// ---------------------------------------------------------------------------
fn test_gth_full_lifecycle_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    sched.time_quantum = 10
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    sched.threads[t0 as usize].time_slice = 10
    sched.threads[t1 as usize].time_slice = 10
    // Schedule t0
    let first = gth_schedule_next(sched)
    let ok1 = sched.current_thread == t0
    // Yield to t1
    let next = gth_yield_current(sched)
    let ok2 = sched.current_thread == t1
    // Mark t1 done
    let ok3 = gth_mark_done(sched, t1, 100)
    // Mark t0 done
    let ok4 = gth_mark_done(sched, t0, 200)
    let ok5 = gth_get_result(sched, t0) == 200
    let ok6 = gth_get_result(sched, t1) == 100
    let ok7 = gth_done_count(sched) == 2
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7
}
fn test_gth_full_lifecycle() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_full_lifecycle_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Combined scenarios — T79: channel producer/consumer
// ---------------------------------------------------------------------------
fn test_gth_producer_consumer_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let ch = gth_channel_create(sched, 5)
    // Simulate producer: send 5 messages
    var i: i64 = 0
    while i < 5 {
        let msg = GthMessage { value: i * 10, sender_id: 0, tag: 0 }
        let ok = gth_channel_send(sched, ch, msg)
        i = i + 1
    }
    let ok1 = gth_channel_is_full(sched, ch)
    // Simulate consumer: recv 5 messages
    var sum: i64 = 0
    var j: i64 = 0
    while j < 5 {
        let msg = gth_channel_recv(sched, ch)
        sum = sum + msg.value
        j = j + 1
    }
    // sum = 0 + 10 + 20 + 30 + 40 = 100
    let ok2 = sum == 100
    let ok3 = gth_channel_is_empty(sched, ch)
    ok1 && ok2 && ok3
}
fn test_gth_producer_consumer() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_producer_consumer_inner(&! sched)
}

