// ---------------------------------------------------------------------------
// Join/wait — T26: join on already-done thread succeeds immediately
// ---------------------------------------------------------------------------
fn test_gth_join_done_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let ok1 = gth_mark_done(sched, t1, 99)
    // t0 joins on t1 which is already done
    let ok2 = gth_join(sched, t0, t1)
    // t0 should NOT be blocked since t1 is done
    let ok3 = sched.threads[t0 as usize].state == GTH_STATE_READY
    ok1 && ok2 && ok3
}
fn test_gth_join_done() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_join_done_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Join/wait — T27: join blocks waiter on running thread
// ---------------------------------------------------------------------------
fn test_gth_join_blocks_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // t0 joins on t1 which is still READY (not done)
    let ok1 = gth_join(sched, t0, t1)
    // t0 should now be BLOCKED
    let ok2 = sched.threads[t0 as usize].state == GTH_STATE_BLOCKED
    ok1 && ok2
}
fn test_gth_join_blocks() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_join_blocks_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Join/wait — T28: mark_done unblocks joiners
// ---------------------------------------------------------------------------
fn test_gth_join_unblock_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // t0 joins on t1
    let ok1 = gth_join(sched, t0, t1)
    let ok2 = sched.threads[t0 as usize].state == GTH_STATE_BLOCKED
    // Now mark t1 as done -> should unblock t0
    let ok3 = gth_mark_done(sched, t1, 55)
    let ok4 = sched.threads[t0 as usize].state == GTH_STATE_READY
    ok1 && ok2 && ok3 && ok4
}
fn test_gth_join_unblock() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_join_unblock_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Join/wait — T29: try_join
// ---------------------------------------------------------------------------
fn test_gth_try_join_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = !gth_try_join(sched, t0)
    let ok2 = gth_mark_done(sched, t0, 10)
    let ok3 = gth_try_join(sched, t0)
    ok1 && ok2 && ok3
}
fn test_gth_try_join() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_try_join_inner(&! sched)
}

