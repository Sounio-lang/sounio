fn test_gth_tick_increment_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    let ticks_before = sched.threads[t0 as usize].ticks_used
    let cur = gth_tick(sched)
    let ticks_after = sched.threads[t0 as usize].ticks_used
    ticks_before == 0 && ticks_after == 1
}
fn test_gth_tick_increment() -> bool with Mut, Div, Panic {
