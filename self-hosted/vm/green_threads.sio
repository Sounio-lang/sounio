    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    sched.threads[t0 as usize].ticks_used = 2
    sched.threads[t0 as usize].time_slice = 100
    let preempted = gth_preempt_check(sched)
    !preempted
}
fn test_gth_preempt_check_false() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
