    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // Schedule and yield a few times
    let first = gth_schedule_next(sched)
    let next1 = gth_yield_current(sched)
    let next2 = gth_yield_current(sched)
    let total = gth_total_yields_all(sched)
    total == 2
}
