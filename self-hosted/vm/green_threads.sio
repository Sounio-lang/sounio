    test_gth_total_yields_all_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Combined scenarios — T81: wait_all with all done
// ---------------------------------------------------------------------------
fn test_gth_wait_all_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let t2 = gth_spawn(sched, 3, GTH_PRIO_NORMAL)
    var ids: [i64; 1024] = [GTH_INVALID; 1024]
    ids[0 as usize] = t0
    ids[1 as usize] = t1
    ids[2 as usize] = t2
    let ok1 = !gth_wait_all(sched, ids, 3)
    let ok2 = gth_mark_done(sched, t0, 0)
    let ok3 = gth_mark_done(sched, t1, 0)
    let ok4 = !gth_wait_all(sched, ids, 3)
    let ok5 = gth_mark_done(sched, t2, 0)
    let ok6 = gth_wait_all(sched, ids, 3)
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6
}
fn test_gth_wait_all() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_wait_all_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Combined scenarios — T82: multiple priority levels scheduling
// ---------------------------------------------------------------------------
fn test_gth_multi_priority_sched_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    // Spawn low, then high priority
    let t_low = gth_spawn(sched, 1, GTH_PRIO_LOW)
    let t_high = gth_spawn(sched, 2, GTH_PRIO_HIGH)
    // HIGH should be at front of queue
    let first = gth_schedule_next(sched)
    let ok1 = first == t_high
    ok1
}
fn test_gth_multi_priority_sched() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_multi_priority_sched_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Combined scenarios — T83: REALTIME priority goes before HIGH
// ---------------------------------------------------------------------------
fn test_gth_realtime_priority_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t_low = gth_spawn(sched, 1, GTH_PRIO_LOW)
    let t_high = gth_spawn(sched, 2, GTH_PRIO_HIGH)
    let t_rt = gth_spawn(sched, 3, GTH_PRIO_REALTIME)
    // REALTIME should be at absolute front
    let first = gth_schedule_next(sched)
    let ok1 = first == t_rt
    ok1
}
fn test_gth_realtime_priority() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_realtime_priority_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T84: suspend on dead thread fails
// ---------------------------------------------------------------------------
fn test_gth_suspend_dead_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_kill(sched, t0)
    let ok2 = gth_suspend(sched, t0)
    !ok2
}
fn test_gth_suspend_dead() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_suspend_dead_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T85: channel message tag preservation
// ---------------------------------------------------------------------------
fn test_gth_channel_tag_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let ch = gth_channel_create(sched, 10)
    let msg = GthMessage { value: 42, sender_id: 7, tag: 255 }
    let ok1 = gth_channel_send(sched, ch, msg)
    let received = gth_channel_recv(sched, ch)
    let ok2 = received.value == 42
    let ok3 = received.sender_id == 7
    let ok4 = received.tag == 255
    ok1 && ok2 && ok3 && ok4
}
fn test_gth_channel_tag() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_channel_tag_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T86: multiple spawns track spawns counter
// ---------------------------------------------------------------------------
fn test_gth_spawns_counter_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let ok1 = sched.total_spawns == 0
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok2 = sched.total_spawns == 1
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let t2 = gth_spawn(sched, 3, GTH_PRIO_NORMAL)
    let ok3 = sched.total_spawns == 3
    ok1 && ok2 && ok3
}
fn test_gth_spawns_counter() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_spawns_counter_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T87: stack multiple push/pop interleave
// ---------------------------------------------------------------------------
fn test_gth_stack_interleave_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_stack_push(&! sched.threads[tid as usize].stack, 10)
    let ok2 = gth_stack_push(&! sched.threads[tid as usize].stack, 20)
    let v1 = gth_stack_pop(&! sched.threads[tid as usize].stack)
    let ok3 = gth_stack_push(&! sched.threads[tid as usize].stack, 30)
    let ok4 = gth_stack_push(&! sched.threads[tid as usize].stack, 40)
    let v2 = gth_stack_pop(&! sched.threads[tid as usize].stack)
    let v3 = gth_stack_pop(&! sched.threads[tid as usize].stack)
    let v4 = gth_stack_pop(&! sched.threads[tid as usize].stack)
    v1 == 20 && v2 == 40 && v3 == 30 && v4 == 10
}
fn test_gth_stack_interleave() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_interleave_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T88: channel drain on empty channel
// ---------------------------------------------------------------------------
fn test_gth_channel_drain_empty_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let ch = gth_channel_create(sched, 10)
    let drained = gth_channel_drain(sched, ch)
    drained == 0
}
fn test_gth_channel_drain_empty() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_channel_drain_empty_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T89: join on self (thread joins itself, should block)
// ---------------------------------------------------------------------------
fn test_gth_join_self_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    // Thread joins itself - it's still READY so it should block
    let ok1 = gth_join(sched, t0, t0)
    let ok2 = sched.threads[t0 as usize].state == GTH_STATE_BLOCKED
    ok1 && ok2
}
fn test_gth_join_self() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_join_self_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T90: get_parent_id on invalid thread
// ---------------------------------------------------------------------------
fn test_gth_get_parent_invalid_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let p = gth_get_parent_id(sched, 999)
    p == GTH_INVALID
}
fn test_gth_get_parent_invalid() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_get_parent_invalid_inner(&! sched)
}

