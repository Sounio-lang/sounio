// ---------------------------------------------------------------------------
// Preemption — T22: no preempt before time slice expires
// ---------------------------------------------------------------------------
fn test_gth_no_preempt_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    // Tick a few times, should not preempt
    var i: i64 = 0
    while i < 5 {
        let cur = gth_tick(sched)
        i = i + 1
    }
    // Still on t0
    sched.current_thread == t0
}
fn test_gth_no_preempt() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_no_preempt_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Preemption — T23: preempt after time slice
// ---------------------------------------------------------------------------
fn test_gth_preempt_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    // Set a short time slice
    sched.time_quantum = 3
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // Override time_slice on spawned threads
    sched.threads[t0 as usize].time_slice = 3
    sched.threads[t1 as usize].time_slice = 3
    let first = gth_schedule_next(sched)
    let ok1 = sched.current_thread == t0
    // Tick 3 times to exceed time slice
    var i: i64 = 0
    while i < 3 {
        let cur = gth_tick(sched)
        i = i + 1
    }
    // After 3 ticks, should have preempted to t1
    sched.current_thread == t1
}
fn test_gth_preempt() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_preempt_inner(&! sched)
}

