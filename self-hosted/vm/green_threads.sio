    var sched = gth_scheduler_new()
    test_gth_run_until_idle_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T54: parent_id is set on spawn
// ---------------------------------------------------------------------------
fn test_gth_parent_id_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    // t0 is spawned when current_thread is GTH_INVALID
    let ok1 = sched.threads[t0 as usize].parent_id == GTH_INVALID
    // Schedule t0 as running, then spawn t1
    let first = gth_schedule_next(sched)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let ok2 = sched.threads[t1 as usize].parent_id == t0
    ok1 && ok2
}
fn test_gth_parent_id() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_parent_id_inner(&! sched)
}

