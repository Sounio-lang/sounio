// self-hosted::vm::green_threads — Cooperative Green Thread Scheduler
//
// Cooperative coroutine scheduler for the Sounio VM.  Provides thread
// creation, round-robin + priority scheduling, preemption via time-slice,
// join/wait synchronisation, and buffered message channels.
//
// All state lives in flat fixed-size arrays — no heap allocation, no Box,
// no Option indirection — keeping the module bootstrap-friendly and
// deterministic.
//
// Naming: structs prefixed `Gth`, functions prefixed `gth_`, constants `GTH_`.

// ============================================================================
// Section 1: Constants
// ============================================================================

// Capacity limits
let GTH_MAX_THREADS: i64 = 1024
let GTH_STACK_SIZE: i64 = 8192
let GTH_MAX_READY: i64 = 1024
let GTH_MAX_CHANNELS: i64 = 256
let GTH_MAX_CHANNEL_BUF: i64 = 64

// Sentinel for "no thread" / invalid id
let GTH_INVALID: i64 = 0 - 1

// Thread states
let GTH_STATE_CREATED: i64 = 0
let GTH_STATE_READY: i64 = 1
let GTH_STATE_RUNNING: i64 = 2
let GTH_STATE_BLOCKED: i64 = 3
let GTH_STATE_SLEEPING: i64 = 4
let GTH_STATE_DONE: i64 = 5
let GTH_STATE_DEAD: i64 = 6

// Priority levels
let GTH_PRIO_LOW: i64 = 0
let GTH_PRIO_NORMAL: i64 = 1
let GTH_PRIO_HIGH: i64 = 2
let GTH_PRIO_REALTIME: i64 = 3

// Default time quantum (ticks before preemption)
let GTH_DEFAULT_QUANTUM: i64 = 100

// ============================================================================
// Section 2: Thread Data Structures
// ============================================================================

struct GthStack {
    slots: [i64; 8192],
    sp: i64,
}

struct GthThread {
    id: i64,
    state: i64,
    priority: i64,
    stack: GthStack,
    pc: i64,
    func_id: i64,
    result: i64,
    parent_id: i64,
    join_count: i64,
    time_slice: i64,
    ticks_used: i64,
    yield_count: i64,
}

struct GthReadyQueue {
    thread_ids: [i64; 1024],
    count: i64,
    head: i64,
    tail: i64,
}

// ============================================================================
// Section 3: Channel Data Structures
// ============================================================================

struct GthMessage {
    value: i64,
    sender_id: i64,
    tag: i64,
}

struct GthChannel {
    id: i64,
    buffer: [GthMessage; 64],
    buf_count: i64,
    buf_head: i64,
    buf_tail: i64,
    capacity: i64,
    sender_count: i64,
    receiver_count: i64,
    closed: bool,
}

struct GthWaitEntry {
    thread_id: i64,
    channel_id: i64,
    is_send: bool,
}

// ============================================================================
// Section 4: Scheduler
// ============================================================================

struct GthScheduler {
    threads: [GthThread; 1024],
    thread_count: i64,
    ready_queue: GthReadyQueue,
    channels: [GthChannel; 256],
    channel_count: i64,
    current_thread: i64,
    total_switches: i64,
    total_yields: i64,
    total_spawns: i64,
    time_quantum: i64,
    idle_count: i64,
}

// ============================================================================
// Section 5: Constructor Functions
// ============================================================================

fn gth_empty_stack() -> GthStack {
    GthStack {
        slots: [0; 8192],
        sp: 0,
    }
}

fn gth_empty_message() -> GthMessage {
    GthMessage {
        value: 0,
        sender_id: GTH_INVALID,
        tag: 0,
    }
}

fn gth_empty_thread() -> GthThread {
    GthThread {
        id: GTH_INVALID,
        state: GTH_STATE_DEAD,
        priority: GTH_PRIO_NORMAL,
        stack: gth_empty_stack(),
        pc: 0,
        func_id: GTH_INVALID,
        result: 0,
        parent_id: GTH_INVALID,
        join_count: 0,
        time_slice: GTH_DEFAULT_QUANTUM,
        ticks_used: 0,
        yield_count: 0,
    }
}

fn gth_empty_channel() -> GthChannel {
    GthChannel {
        id: GTH_INVALID,
        buffer: [gth_empty_message(); 64],
        buf_count: 0,
        buf_head: 0,
        buf_tail: 0,
        capacity: GTH_MAX_CHANNEL_BUF,
        sender_count: 0,
        receiver_count: 0,
        closed: false,
    }
}

fn gth_empty_ready_queue() -> GthReadyQueue {
    GthReadyQueue {
        thread_ids: [GTH_INVALID; 1024],
        count: 0,
        head: 0,
        tail: 0,
    }
}

fn gth_scheduler_new() -> GthScheduler {
    GthScheduler {
        threads: [gth_empty_thread(); 1024],
        thread_count: 0,
        ready_queue: gth_empty_ready_queue(),
        channels: [gth_empty_channel(); 256],
        channel_count: 0,
        current_thread: GTH_INVALID,
        total_switches: 0,
        total_yields: 0,
        total_spawns: 0,
        time_quantum: GTH_DEFAULT_QUANTUM,
        idle_count: 0,
    }
}

// ============================================================================
// Section 6: Stack Operations
// ============================================================================

fn gth_stack_push(stack: &! GthStack, val: i64) -> bool with Mut, Div, Panic {
    if stack.sp >= GTH_STACK_SIZE {
        return false
    }
    stack.slots[stack.sp as usize] = val
    stack.sp = stack.sp + 1
    true
}

fn gth_stack_pop(stack: &! GthStack) -> i64 with Mut, Div, Panic {
    if stack.sp <= 0 {
        return GTH_INVALID
    }
    stack.sp = stack.sp - 1
    stack.slots[stack.sp as usize]
}

fn gth_stack_peek(stack: &GthStack) -> i64 with Div, Panic {
    if stack.sp <= 0 {
        return GTH_INVALID
    }
    stack.slots[(stack.sp - 1) as usize]
}

fn gth_stack_depth(stack: &GthStack) -> i64 {
    stack.sp
}

fn gth_stack_reset(stack: &! GthStack) -> i64 with Mut {
    let old_sp = stack.sp
    stack.sp = 0
    old_sp
}

// ============================================================================
// Section 7: Ready Queue Operations
// ============================================================================

fn gth_enqueue(q: &! GthReadyQueue, thread_id: i64) -> bool with Mut, Div, Panic {
    if q.count >= GTH_MAX_READY {
        return false
    }
    q.thread_ids[q.tail as usize] = thread_id
    q.tail = (q.tail + 1) % GTH_MAX_READY
    q.count = q.count + 1
    true
}

fn gth_dequeue(q: &! GthReadyQueue) -> i64 with Mut, Div, Panic {
    if q.count <= 0 {
        return GTH_INVALID
    }
    let tid = q.thread_ids[q.head as usize]
    q.thread_ids[q.head as usize] = GTH_INVALID
    q.head = (q.head + 1) % GTH_MAX_READY
    q.count = q.count - 1
    tid
}

fn gth_queue_len(q: &GthReadyQueue) -> i64 {
    q.count
}

fn gth_queue_is_empty(q: &GthReadyQueue) -> bool {
    q.count <= 0
}

// Priority-aware enqueue: REALTIME and HIGH go to front, others to back.
// For front insertion we walk backwards from tail to head shifting entries,
// then place the new id at the head.  For back insertion we use normal enqueue.
fn gth_enqueue_priority(q: &! GthReadyQueue, thread_id: i64, priority: i64) -> bool with Mut, Div, Panic {
    if q.count >= GTH_MAX_READY {
        return false
    }
    // REALTIME and HIGH threads jump to front of queue
    if priority >= GTH_PRIO_HIGH {
        // Shift everything one slot toward the tail
        var i: i64 = q.count
        while i > 0 {
            let src_idx = (q.head + i - 1) % GTH_MAX_READY
            let dst_idx = (q.head + i) % GTH_MAX_READY
            q.thread_ids[dst_idx as usize] = q.thread_ids[src_idx as usize]
            i = i - 1
        }
        q.thread_ids[q.head as usize] = thread_id
        q.tail = (q.tail + 1) % GTH_MAX_READY
        q.count = q.count + 1
        return true
    }
    // Normal / low priority goes to back
    gth_enqueue(q, thread_id)
}

// ============================================================================
// Section 8: Thread Lifecycle
// ============================================================================

fn gth_spawn(sched: &! GthScheduler, func_id: i64, priority: i64) -> i64 with Mut, Div, Panic {
    if sched.thread_count >= GTH_MAX_THREADS {
        return GTH_INVALID
    }
    let tid = sched.thread_count
    sched.threads[tid as usize].id = tid
    sched.threads[tid as usize].state = GTH_STATE_CREATED
    sched.threads[tid as usize].priority = priority
    sched.threads[tid as usize].pc = 0
    sched.threads[tid as usize].func_id = func_id
    sched.threads[tid as usize].result = 0
    sched.threads[tid as usize].parent_id = sched.current_thread
    sched.threads[tid as usize].join_count = 0
    sched.threads[tid as usize].time_slice = sched.time_quantum
    sched.threads[tid as usize].ticks_used = 0
    sched.threads[tid as usize].yield_count = 0
    sched.threads[tid as usize].stack.sp = 0
    sched.thread_count = sched.thread_count + 1
    sched.total_spawns = sched.total_spawns + 1
    // Enqueue onto ready queue with priority
    let ok = gth_enqueue_priority(&! sched.ready_queue, tid, priority)
    sched.threads[tid as usize].state = GTH_STATE_READY
    tid
}

fn gth_set_state(sched: &! GthScheduler, thread_id: i64, state: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].state = state
    true
}

fn gth_get_state(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_STATE_DEAD
    }
    sched.threads[thread_id as usize].state
}

fn gth_make_ready(sched: &! GthScheduler, thread_id: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    let st = sched.threads[thread_id as usize].state
    if st == GTH_STATE_DONE || st == GTH_STATE_DEAD {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_READY
    sched.threads[thread_id as usize].ticks_used = 0
    let prio = sched.threads[thread_id as usize].priority
    let ok = gth_enqueue_priority(&! sched.ready_queue, thread_id, prio)
    true
}

fn gth_mark_done(sched: &! GthScheduler, thread_id: i64, result: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_DONE
    sched.threads[thread_id as usize].result = result
    // Unblock any thread that was join-waiting on this one
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == GTH_STATE_BLOCKED {
            if sched.threads[i as usize].join_count == thread_id {
                // The join_count field doubles as "target thread id" for simple join
                sched.threads[i as usize].state = GTH_STATE_READY
                sched.threads[i as usize].join_count = 0
                let prio = sched.threads[i as usize].priority
                let ok = gth_enqueue_priority(&! sched.ready_queue, i, prio)
            }
        }
        i = i + 1
    }
    true
}

fn gth_kill(sched: &! GthScheduler, thread_id: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_DEAD
    sched.threads[thread_id as usize].stack.sp = 0
    true
}

fn gth_is_alive(sched: &GthScheduler, thread_id: i64) -> bool with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    let st = sched.threads[thread_id as usize].state
    st != GTH_STATE_DEAD && st != GTH_STATE_DONE
}

// ============================================================================
// Section 9: Scheduling
// ============================================================================

// Helper: dequeue from the scheduler's ready queue.  Encapsulates the
// sub-borrow of sched.ready_queue so the caller can continue to use sched.
fn gth_do_dequeue(sched: &! GthScheduler) -> i64 with Mut, Div, Panic {
    gth_dequeue(&! sched.ready_queue)
}

// Helper: re-enqueue a thread onto the scheduler's ready queue with priority.
fn gth_do_enqueue(sched: &! GthScheduler, thread_id: i64, priority: i64) -> bool with Mut, Div, Panic {
    gth_enqueue_priority(&! sched.ready_queue, thread_id, priority)
}

fn gth_schedule_next(sched: &! GthScheduler) -> i64 with Mut, Div, Panic {
    let next_id = gth_do_dequeue(sched)
    if next_id == GTH_INVALID {
        sched.idle_count = sched.idle_count + 1
        return GTH_INVALID
    }
    // Suspend current thread if it is running
    let cur = sched.current_thread
    if cur != GTH_INVALID && cur >= 0 && cur < sched.thread_count {
        if sched.threads[cur as usize].state == GTH_STATE_RUNNING {
            sched.threads[cur as usize].state = GTH_STATE_READY
            sched.threads[cur as usize].ticks_used = 0
            let prio = sched.threads[cur as usize].priority
            let ok = gth_do_enqueue(sched, cur, prio)
        }
    }
    // Activate next thread
    sched.threads[next_id as usize].state = GTH_STATE_RUNNING
    sched.threads[next_id as usize].ticks_used = 0
    sched.current_thread = next_id
    sched.total_switches = sched.total_switches + 1
    next_id
}

fn gth_yield_current(sched: &! GthScheduler) -> i64 with Mut, Div, Panic {
    let cur = sched.current_thread
    if cur != GTH_INVALID && cur >= 0 && cur < sched.thread_count {
        sched.threads[cur as usize].yield_count = sched.threads[cur as usize].yield_count + 1
        sched.total_yields = sched.total_yields + 1
    }
    gth_schedule_next(sched)
}

fn gth_preempt_check(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let cur = sched.current_thread
    if cur == GTH_INVALID || cur < 0 || cur >= sched.thread_count {
        return false
    }
    if sched.threads[cur as usize].state != GTH_STATE_RUNNING {
        return false
    }
    // Check if ticks_used exceeded time_slice
    if sched.threads[cur as usize].ticks_used >= sched.threads[cur as usize].time_slice {
        // Preempt: yield current thread
        let next = gth_yield_current(sched)
        return true
    }
    false
}

fn gth_tick(sched: &! GthScheduler) -> i64 with Mut, Div, Panic {
    let cur = sched.current_thread
    if cur == GTH_INVALID || cur < 0 || cur >= sched.thread_count {
        // No thread running; try to schedule one
        let next = gth_schedule_next(sched)
        return next
    }
    if sched.threads[cur as usize].state != GTH_STATE_RUNNING {
        // Current thread no longer running; schedule next
        let next = gth_schedule_next(sched)
        return next
    }
    // Increment ticks
    sched.threads[cur as usize].ticks_used = sched.threads[cur as usize].ticks_used + 1
    // Check preemption
    let preempted = gth_preempt_check(sched)
    sched.current_thread
}

fn gth_run_until_idle(sched: &! GthScheduler) -> i64 with Mut, Div, Panic {
    var total_ticks: i64 = 0
    // Ensure we have a running thread
    if sched.current_thread == GTH_INVALID {
        let first = gth_schedule_next(sched)
        if first == GTH_INVALID {
            return 0
        }
    }
    // Simulate ticks.  Each iteration we advance one tick.
    // We stop when the ready queue is empty AND no thread is running.
    var cont = true
    while cont {
        let cur = sched.current_thread
        if cur == GTH_INVALID {
            // Try to schedule
            let next = gth_schedule_next(sched)
            if next == GTH_INVALID {
                cont = false
            }
        } else {
            // Simulate the running thread consuming its time slice,
            // then completing.
            sched.threads[cur as usize].ticks_used = sched.threads[cur as usize].ticks_used + 1
            total_ticks = total_ticks + 1

            // After time_slice ticks the thread is considered "done" for
            // simulation purposes.
            if sched.threads[cur as usize].ticks_used >= sched.threads[cur as usize].time_slice {
                let ok = gth_mark_done(sched, cur, cur)
                sched.current_thread = GTH_INVALID
                // Try next thread
                let next = gth_schedule_next(sched)
                if next == GTH_INVALID {
                    // Check if any threads are still alive
                    var any_alive = false
                    var k: i64 = 0
                    while k < sched.thread_count {
                        let st = sched.threads[k as usize].state
                        if st != GTH_STATE_DONE && st != GTH_STATE_DEAD {
                            any_alive = true
                        }
                        k = k + 1
                    }
                    if !any_alive {
                        cont = false
                    }
                }
            }
        }
    }
    total_ticks
}

// ============================================================================
// Section 9b: Thread Information Queries
// ============================================================================

// Get the priority of a thread.
fn gth_get_priority(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_INVALID
    }
    sched.threads[thread_id as usize].priority
}

// Set the priority of a thread.
fn gth_set_priority(sched: &! GthScheduler, thread_id: i64, priority: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].priority = priority
    true
}

// Get the func_id of a thread.
fn gth_get_func_id(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_INVALID
    }
    sched.threads[thread_id as usize].func_id
}

// Get the parent_id of a thread.
fn gth_get_parent_id(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_INVALID
    }
    sched.threads[thread_id as usize].parent_id
}

// Get the ticks_used of a thread.
fn gth_get_ticks_used(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return 0
    }
    sched.threads[thread_id as usize].ticks_used
}

// Get the yield_count of a thread.
fn gth_get_yield_count(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return 0
    }
    sched.threads[thread_id as usize].yield_count
}

// Get the program counter of a thread.
fn gth_get_pc(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_INVALID
    }
    sched.threads[thread_id as usize].pc
}

// Set the program counter of a thread.
fn gth_set_pc(sched: &! GthScheduler, thread_id: i64, pc: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].pc = pc
    true
}

// Get the time_slice of a thread.
fn gth_get_time_slice(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return 0
    }
    sched.threads[thread_id as usize].time_slice
}

// Set the time_slice of a thread.
fn gth_set_time_slice(sched: &! GthScheduler, thread_id: i64, ts: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    sched.threads[thread_id as usize].time_slice = ts
    true
}

// Return the id of the currently running thread (or GTH_INVALID if none).
fn gth_current(sched: &GthScheduler) -> i64 {
    sched.current_thread
}

// Set the global time quantum for newly spawned threads.
fn gth_set_quantum(sched: &! GthScheduler, quantum: i64) -> i64 with Mut {
    let old = sched.time_quantum
    sched.time_quantum = quantum
    old
}

// Count how many threads have a specific state.
fn gth_count_by_state(sched: &GthScheduler, state: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == state {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count how many threads have a specific priority (among alive threads).
fn gth_count_by_priority(sched: &GthScheduler, priority: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        let st = sched.threads[i as usize].state
        if st != GTH_STATE_DEAD && st != GTH_STATE_DONE {
            if sched.threads[i as usize].priority == priority {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Find the first thread with a given state, or GTH_INVALID if none.
fn gth_find_by_state(sched: &GthScheduler, state: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == state {
            return i
        }
        i = i + 1
    }
    GTH_INVALID
}

// Check if a thread is the current running thread.
fn gth_is_current(sched: &GthScheduler, thread_id: i64) -> bool {
    sched.current_thread == thread_id
}

// Reset a thread for re-use (set to CREATED state, clear stack and counters).
fn gth_reset_thread(sched: &! GthScheduler, thread_id: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    let st = sched.threads[thread_id as usize].state
    // Only reset dead or done threads
    if st != GTH_STATE_DEAD && st != GTH_STATE_DONE {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_CREATED
    sched.threads[thread_id as usize].pc = 0
    sched.threads[thread_id as usize].result = 0
    sched.threads[thread_id as usize].join_count = 0
    sched.threads[thread_id as usize].ticks_used = 0
    sched.threads[thread_id as usize].yield_count = 0
    sched.threads[thread_id as usize].stack.sp = 0
    true
}

// Suspend a running thread (move to SLEEPING state).
fn gth_suspend(sched: &! GthScheduler, thread_id: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    let st = sched.threads[thread_id as usize].state
    if st != GTH_STATE_RUNNING && st != GTH_STATE_READY {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_SLEEPING
    true
}

// Resume a sleeping thread back to ready.
fn gth_resume(sched: &! GthScheduler, thread_id: i64) -> bool with Mut, Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return false
    }
    if sched.threads[thread_id as usize].state != GTH_STATE_SLEEPING {
        return false
    }
    sched.threads[thread_id as usize].state = GTH_STATE_READY
    sched.threads[thread_id as usize].ticks_used = 0
    let prio = sched.threads[thread_id as usize].priority
    let ok = gth_enqueue_priority(&! sched.ready_queue, thread_id, prio)
    true
}

// Compute total yield count across all threads.
fn gth_total_yields_all(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        total = total + sched.threads[i as usize].yield_count
        i = i + 1
    }
    total
}

// Compute total ticks consumed across all threads.
fn gth_total_ticks_all(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        total = total + sched.threads[i as usize].ticks_used
        i = i + 1
    }
    total
}

// ============================================================================
// Section 9c: Queue Inspection Utilities
// ============================================================================

// Check whether a thread_id is currently in the ready queue.
fn gth_queue_contains(q: &GthReadyQueue, thread_id: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < q.count {
        let idx = (q.head + i) % GTH_MAX_READY
        if q.thread_ids[idx as usize] == thread_id {
            return true
        }
        i = i + 1
    }
    false
}

// Peek at the front of the ready queue without removing.
fn gth_queue_peek(q: &GthReadyQueue) -> i64 with Div, Panic {
    if q.count <= 0 {
        return GTH_INVALID
    }
    q.thread_ids[q.head as usize]
}

// Clear all entries in the ready queue.
fn gth_queue_clear(q: &! GthReadyQueue) -> i64 with Mut {
    let old_count = q.count
    q.count = 0
    q.head = 0
    q.tail = 0
    old_count
}

// ============================================================================
// Section 9d: Channel Inspection Utilities
// ============================================================================

// Get total messages sent on a channel.
fn gth_channel_send_count(sched: &GthScheduler, ch_id: i64) -> i64 with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return 0
    }
    sched.channels[ch_id as usize].sender_count
}

// Get total messages received from a channel.
fn gth_channel_recv_count(sched: &GthScheduler, ch_id: i64) -> i64 with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return 0
    }
    sched.channels[ch_id as usize].receiver_count
}

// Get the capacity of a channel.
fn gth_channel_capacity(sched: &GthScheduler, ch_id: i64) -> i64 with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return 0
    }
    sched.channels[ch_id as usize].capacity
}

// Check if channel is empty.
fn gth_channel_is_empty(sched: &GthScheduler, ch_id: i64) -> bool with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return true
    }
    sched.channels[ch_id as usize].buf_count <= 0
}

// Drain all messages from a channel (discard them).  Returns count drained.
fn gth_channel_drain(sched: &! GthScheduler, ch_id: i64) -> i64 with Mut, Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return 0
    }
    var drained: i64 = 0
    var cont = true
    while cont {
        if sched.channels[ch_id as usize].buf_count <= 0 {
            cont = false
        } else {
            let msg = gth_channel_recv(sched, ch_id)
            drained = drained + 1
        }
    }
    drained
}

// ============================================================================
// Section 10: Join / Wait
// ============================================================================

fn gth_join(sched: &! GthScheduler, waiter: i64, target: i64) -> bool with Mut, Div, Panic {
    if waiter < 0 || waiter >= sched.thread_count {
        return false
    }
    if target < 0 || target >= sched.thread_count {
        return false
    }
    // If target is already done, no need to block
    let target_state = sched.threads[target as usize].state
    if target_state == GTH_STATE_DONE || target_state == GTH_STATE_DEAD {
        return true
    }
    // Block the waiter
    sched.threads[waiter as usize].state = GTH_STATE_BLOCKED
    // Store target thread id in join_count so mark_done can find us
    sched.threads[waiter as usize].join_count = target
    true
}

fn gth_try_join(sched: &GthScheduler, target: i64) -> bool with Div, Panic {
    if target < 0 || target >= sched.thread_count {
        return false
    }
    let st = sched.threads[target as usize].state
    st == GTH_STATE_DONE || st == GTH_STATE_DEAD
}

fn gth_get_result(sched: &GthScheduler, thread_id: i64) -> i64 with Div, Panic {
    if thread_id < 0 || thread_id >= sched.thread_count {
        return GTH_INVALID
    }
    sched.threads[thread_id as usize].result
}

fn gth_wait_all(sched: &! GthScheduler, thread_ids: [i64; 1024], count: i64) -> bool with Mut, Div, Panic {
    var all_done = true
    var i: i64 = 0
    while i < count {
        let tid = thread_ids[i as usize]
        if tid >= 0 && tid < sched.thread_count {
            let st = sched.threads[tid as usize].state
            if st != GTH_STATE_DONE && st != GTH_STATE_DEAD {
                all_done = false
            }
        }
        i = i + 1
    }
    all_done
}

// ============================================================================
// Section 11: Channels
// ============================================================================

fn gth_channel_create(sched: &! GthScheduler, capacity: i64) -> i64 with Mut, Div, Panic {
    if sched.channel_count >= GTH_MAX_CHANNELS {
        return GTH_INVALID
    }
    let ch_id = sched.channel_count
    sched.channels[ch_id as usize].id = ch_id
    sched.channels[ch_id as usize].buf_count = 0
    sched.channels[ch_id as usize].buf_head = 0
    sched.channels[ch_id as usize].buf_tail = 0
    sched.channels[ch_id as usize].closed = false
    sched.channels[ch_id as usize].sender_count = 0
    sched.channels[ch_id as usize].receiver_count = 0
    // Clamp capacity to max buffer size
    if capacity > GTH_MAX_CHANNEL_BUF {
        sched.channels[ch_id as usize].capacity = GTH_MAX_CHANNEL_BUF
    } else {
        if capacity <= 0 {
            sched.channels[ch_id as usize].capacity = 1
        } else {
            sched.channels[ch_id as usize].capacity = capacity
        }
    }
    sched.channel_count = sched.channel_count + 1
    ch_id
}

fn gth_channel_send(sched: &! GthScheduler, ch_id: i64, msg: GthMessage) -> bool with Mut, Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return false
    }
    if sched.channels[ch_id as usize].closed {
        return false
    }
    if sched.channels[ch_id as usize].buf_count >= sched.channels[ch_id as usize].capacity {
        return false
    }
    let tail = sched.channels[ch_id as usize].buf_tail
    sched.channels[ch_id as usize].buffer[tail as usize] = msg
    sched.channels[ch_id as usize].buf_tail = (tail + 1) % GTH_MAX_CHANNEL_BUF
    sched.channels[ch_id as usize].buf_count = sched.channels[ch_id as usize].buf_count + 1
    sched.channels[ch_id as usize].sender_count = sched.channels[ch_id as usize].sender_count + 1
    true
}

fn gth_channel_recv(sched: &! GthScheduler, ch_id: i64) -> GthMessage with Mut, Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return gth_empty_message()
    }
    if sched.channels[ch_id as usize].buf_count <= 0 {
        return gth_empty_message()
    }
    let head = sched.channels[ch_id as usize].buf_head
    let msg = sched.channels[ch_id as usize].buffer[head as usize]
    sched.channels[ch_id as usize].buffer[head as usize] = gth_empty_message()
    sched.channels[ch_id as usize].buf_head = (head + 1) % GTH_MAX_CHANNEL_BUF
    sched.channels[ch_id as usize].buf_count = sched.channels[ch_id as usize].buf_count - 1
    sched.channels[ch_id as usize].receiver_count = sched.channels[ch_id as usize].receiver_count + 1
    msg
}

fn gth_channel_try_recv(sched: &GthScheduler, ch_id: i64) -> GthMessage with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return gth_empty_message()
    }
    if sched.channels[ch_id as usize].buf_count <= 0 {
        return gth_empty_message()
    }
    let head = sched.channels[ch_id as usize].buf_head
    sched.channels[ch_id as usize].buffer[head as usize]
}

fn gth_channel_close(sched: &! GthScheduler, ch_id: i64) -> bool with Mut, Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return false
    }
    sched.channels[ch_id as usize].closed = true
    true
}

fn gth_channel_is_closed(sched: &GthScheduler, ch_id: i64) -> bool with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return true
    }
    sched.channels[ch_id as usize].closed
}

fn gth_channel_len(sched: &GthScheduler, ch_id: i64) -> i64 with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return 0
    }
    sched.channels[ch_id as usize].buf_count
}

fn gth_channel_is_full(sched: &GthScheduler, ch_id: i64) -> bool with Div, Panic {
    if ch_id < 0 || ch_id >= sched.channel_count {
        return true
    }
    sched.channels[ch_id as usize].buf_count >= sched.channels[ch_id as usize].capacity
}

// ============================================================================
// Section 12: Statistics
// ============================================================================

fn gth_active_count(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        let st = sched.threads[i as usize].state
        if st != GTH_STATE_DEAD && st != GTH_STATE_DONE {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn gth_ready_count(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == GTH_STATE_READY {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn gth_blocked_count(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == GTH_STATE_BLOCKED {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn gth_done_count(sched: &GthScheduler) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < sched.thread_count {
        if sched.threads[i as usize].state == GTH_STATE_DONE {
            count = count + 1
        }
        i = i + 1
    }
    count
}

struct GthSchedStats {
    total_threads: i64,
    active: i64,
    ready: i64,
    blocked: i64,
    done: i64,
    switches: i64,
    yields: i64,
    spawns: i64,
}

fn gth_stats(sched: &GthScheduler) -> GthSchedStats with Mut, Div, Panic {
    GthSchedStats {
        total_threads: sched.thread_count,
        active: gth_active_count(sched),
        ready: gth_ready_count(sched),
        blocked: gth_blocked_count(sched),
        done: gth_done_count(sched),
        switches: sched.total_switches,
        yields: sched.total_yields,
        spawns: sched.total_spawns,
    }
}

// ============================================================================
// Section 13: Tests
// ============================================================================

// ---------------------------------------------------------------------------
// Stack operations — T01: push and pop
// ---------------------------------------------------------------------------
fn test_gth_stack_push_pop_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    // Spawn a thread so we have a stack to work with
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_stack_push(&! sched.threads[0 as usize].stack, 42)
    let ok2 = gth_stack_push(&! sched.threads[0 as usize].stack, 99)
    let v1 = gth_stack_pop(&! sched.threads[0 as usize].stack)
    let v2 = gth_stack_pop(&! sched.threads[0 as usize].stack)
    ok1 && ok2 && v1 == 99 && v2 == 42
}
fn test_gth_stack_push_pop() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_push_pop_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Stack operations — T02: peek without pop
// ---------------------------------------------------------------------------
fn test_gth_stack_peek_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_stack_push(&! sched.threads[0 as usize].stack, 77)
    let peeked = gth_stack_peek(&sched.threads[0 as usize].stack)
    let depth = gth_stack_depth(&sched.threads[0 as usize].stack)
    peeked == 77 && depth == 1
}
fn test_gth_stack_peek() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_peek_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Stack operations — T03: pop empty stack returns GTH_INVALID
// ---------------------------------------------------------------------------
fn test_gth_stack_empty_pop_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let v = gth_stack_pop(&! sched.threads[0 as usize].stack)
    v == GTH_INVALID
}
fn test_gth_stack_empty_pop() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_empty_pop_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Stack operations — T04: peek empty stack returns GTH_INVALID
// ---------------------------------------------------------------------------
fn test_gth_stack_empty_peek_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let v = gth_stack_peek(&sched.threads[0 as usize].stack)
    v == GTH_INVALID
}
fn test_gth_stack_empty_peek() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_empty_peek_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Stack operations — T05: stack reset
// ---------------------------------------------------------------------------
fn test_gth_stack_reset_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_stack_push(&! sched.threads[0 as usize].stack, 1)
    let ok2 = gth_stack_push(&! sched.threads[0 as usize].stack, 2)
    let ok3 = gth_stack_push(&! sched.threads[0 as usize].stack, 3)
    let old_sp = gth_stack_reset(&! sched.threads[0 as usize].stack)
    let new_depth = gth_stack_depth(&sched.threads[0 as usize].stack)
    old_sp == 3 && new_depth == 0
}
fn test_gth_stack_reset() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_stack_reset_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Ready queue — T06: enqueue and dequeue order (FIFO)
// ---------------------------------------------------------------------------
fn test_gth_queue_fifo_sub(q: &! GthReadyQueue) -> bool with Mut, Div, Panic {
    let ok1 = gth_enqueue(q, 10)
    let ok2 = gth_enqueue(q, 20)
    let ok3 = gth_enqueue(q, 30)
    let v1 = gth_dequeue(q)
    let v2 = gth_dequeue(q)
    let v3 = gth_dequeue(q)
    v1 == 10 && v2 == 20 && v3 == 30
}
fn test_gth_queue_fifo_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    var q = gth_empty_ready_queue()
    test_gth_queue_fifo_sub(&! q)
}
fn test_gth_queue_fifo() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_queue_fifo_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Ready queue — T07: dequeue empty returns GTH_INVALID
// ---------------------------------------------------------------------------
fn test_gth_queue_empty_dequeue_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    var q = gth_empty_ready_queue()
    let v = gth_dequeue(&! q)
    v == GTH_INVALID
}
fn test_gth_queue_empty_dequeue() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_queue_empty_dequeue_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Ready queue — T08: queue length tracking
// ---------------------------------------------------------------------------
fn test_gth_queue_len_sub(q: &! GthReadyQueue) -> bool with Mut, Div, Panic {
    let ok1 = gth_queue_is_empty(q)
    let ok2 = gth_enqueue(q, 5)
    let ok3 = gth_enqueue(q, 6)
    let len = gth_queue_len(q)
    let not_empty = !gth_queue_is_empty(q)
    ok1 && len == 2 && not_empty
}
fn test_gth_queue_len_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    var q = gth_empty_ready_queue()
    test_gth_queue_len_sub(&! q)
}
fn test_gth_queue_len() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_queue_len_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Ready queue — T09: priority enqueue (high goes to front)
// ---------------------------------------------------------------------------
fn test_gth_queue_priority_sub(q: &! GthReadyQueue) -> bool with Mut, Div, Panic {
    let ok1 = gth_enqueue_priority(q, 100, GTH_PRIO_LOW)
    let ok2 = gth_enqueue_priority(q, 200, GTH_PRIO_NORMAL)
    let ok3 = gth_enqueue_priority(q, 300, GTH_PRIO_HIGH)
    // 300 (HIGH) should be at front
    let v1 = gth_dequeue(q)
    let v2 = gth_dequeue(q)
    let v3 = gth_dequeue(q)
    v1 == 300 && v2 == 100 && v3 == 200
}
fn test_gth_queue_priority_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    var q = gth_empty_ready_queue()
    test_gth_queue_priority_sub(&! q)
}
fn test_gth_queue_priority() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_queue_priority_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Ready queue — T10: enqueue wrap-around (circular buffer)
// ---------------------------------------------------------------------------
fn test_gth_queue_wrap_sub(q: &! GthReadyQueue) -> bool with Mut, Div, Panic {
    // Fill and drain a few times to advance head/tail
    var r: i64 = 0
    while r < 5 {
        let ok = gth_enqueue(q, r)
        r = r + 1
    }
    var d: i64 = 0
    while d < 5 {
        let v = gth_dequeue(q)
        d = d + 1
    }
    // Now head and tail are at offset 5; enqueue more
    let ok1 = gth_enqueue(q, 50)
    let ok2 = gth_enqueue(q, 60)
    let v1 = gth_dequeue(q)
    let v2 = gth_dequeue(q)
    v1 == 50 && v2 == 60 && gth_queue_is_empty(q)
}
fn test_gth_queue_wrap_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    var q = gth_empty_ready_queue()
    test_gth_queue_wrap_sub(&! q)
}
fn test_gth_queue_wrap() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_queue_wrap_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Thread spawn/lifecycle — T11: spawn creates thread with READY state
// ---------------------------------------------------------------------------
fn test_gth_spawn_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 42, GTH_PRIO_NORMAL)
    let ok1 = tid == 0
    let ok2 = sched.thread_count == 1
    let ok3 = sched.threads[0 as usize].state == GTH_STATE_READY
    let ok4 = sched.threads[0 as usize].func_id == 42
    let ok5 = sched.threads[0 as usize].priority == GTH_PRIO_NORMAL
    ok1 && ok2 && ok3 && ok4 && ok5
}
fn test_gth_spawn() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_spawn_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Thread spawn/lifecycle — T12: spawn multiple threads
// ---------------------------------------------------------------------------
fn test_gth_spawn_multiple_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 10, GTH_PRIO_LOW)
    let t1 = gth_spawn(sched, 20, GTH_PRIO_NORMAL)
    let t2 = gth_spawn(sched, 30, GTH_PRIO_HIGH)
    let ok1 = t0 == 0 && t1 == 1 && t2 == 2
    let ok2 = sched.thread_count == 3
    let ok3 = sched.threads[0 as usize].priority == GTH_PRIO_LOW
    let ok4 = sched.threads[1 as usize].priority == GTH_PRIO_NORMAL
    let ok5 = sched.threads[2 as usize].priority == GTH_PRIO_HIGH
    ok1 && ok2 && ok3 && ok4 && ok5
}
fn test_gth_spawn_multiple() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_spawn_multiple_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Thread spawn/lifecycle — T13: set and get state
// ---------------------------------------------------------------------------
fn test_gth_state_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_get_state(sched, tid) == GTH_STATE_READY
    let ok2 = gth_set_state(sched, tid, GTH_STATE_BLOCKED)
    let ok3 = gth_get_state(sched, tid) == GTH_STATE_BLOCKED
    ok1 && ok2 && ok3
}
fn test_gth_state() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_state_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Thread spawn/lifecycle — T14: kill a thread
// ---------------------------------------------------------------------------
fn test_gth_kill_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_is_alive(sched, tid)
    let ok2 = gth_kill(sched, tid)
    let ok3 = !gth_is_alive(sched, tid)
    let ok4 = gth_get_state(sched, tid) == GTH_STATE_DEAD
    ok1 && ok2 && ok3 && ok4
}
fn test_gth_kill() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_kill_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Thread spawn/lifecycle — T15: mark done with result
// ---------------------------------------------------------------------------
fn test_gth_mark_done_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let tid = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let ok1 = gth_mark_done(sched, tid, 42)
    let ok2 = gth_get_state(sched, tid) == GTH_STATE_DONE
    let ok3 = gth_get_result(sched, tid) == 42
    let ok4 = !gth_is_alive(sched, tid)
    ok1 && ok2 && ok3 && ok4
}
fn test_gth_mark_done() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_mark_done_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T16: schedule_next picks from ready queue
// ---------------------------------------------------------------------------
fn test_gth_schedule_next_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let next = gth_schedule_next(sched)
    let ok1 = next == t0
    let ok2 = sched.current_thread == t0
    let ok3 = sched.threads[t0 as usize].state == GTH_STATE_RUNNING
    ok1 && ok2 && ok3
}
fn test_gth_schedule_next() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_schedule_next_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T17: yield rotates to next thread
// ---------------------------------------------------------------------------
fn test_gth_yield_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // Schedule t0 as running
    let first = gth_schedule_next(sched)
    let ok1 = sched.current_thread == t0
    // Yield -> should switch to t1
    let next = gth_yield_current(sched)
    let ok2 = sched.current_thread == t1
    let ok3 = sched.total_yields == 1
    ok1 && ok2 && ok3
}
fn test_gth_yield() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_yield_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T18: schedule with empty queue returns GTH_INVALID
// ---------------------------------------------------------------------------
fn test_gth_schedule_empty_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let next = gth_schedule_next(sched)
    next == GTH_INVALID
}
fn test_gth_schedule_empty() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_schedule_empty_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T19: total switches increment
// ---------------------------------------------------------------------------
fn test_gth_switches_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let s0 = sched.total_switches
    let first = gth_schedule_next(sched)
    let s1 = sched.total_switches
    let next = gth_yield_current(sched)
    let s2 = sched.total_switches
    s0 == 0 && s1 == 1 && s2 == 2
}
fn test_gth_switches() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_switches_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T20: yield count per thread
// ---------------------------------------------------------------------------
fn test_gth_yield_count_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    let yc_before = sched.threads[t0 as usize].yield_count
    let next = gth_yield_current(sched)
    let yc_after = sched.threads[t0 as usize].yield_count
    yc_before == 0 && yc_after == 1
}
fn test_gth_yield_count() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
