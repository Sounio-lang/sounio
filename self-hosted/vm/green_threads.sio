    let ch1 = gth_channel_create(sched, 5)
    let ok1 = ch0 == 0 && ch1 == 1
    let m0 = GthMessage { value: 100, sender_id: 0, tag: 0 }
    let m1 = GthMessage { value: 200, sender_id: 0, tag: 0 }
    let ok2 = gth_channel_send(sched, ch0, m0)
    let ok3 = gth_channel_send(sched, ch1, m1)
    let r0 = gth_channel_recv(sched, ch0)
    let r1 = gth_channel_recv(sched, ch1)
    r0.value == 100 && r1.value == 200
}
fn test_gth_multi_channel() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_multi_channel_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Edge cases — T52: try_recv does not consume
// ---------------------------------------------------------------------------
fn test_gth_try_recv_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let ch = gth_channel_create(sched, 10)
    let msg = GthMessage { value: 77, sender_id: 3, tag: 1 }
    let ok1 = gth_channel_send(sched, ch, msg)
    let peeked = gth_channel_try_recv(sched, ch)
    let ok2 = peeked.value == 77
    // try_recv is non-destructive — channel len should still be 1
    let ok3 = gth_channel_len(sched, ch) == 1
    // Now do a real recv
    let received = gth_channel_recv(sched, ch)
    let ok4 = received.value == 77
    let ok5 = gth_channel_len(sched, ch) == 0
    ok1 && ok2 && ok3 && ok4 && ok5
}
fn test_gth_try_recv() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_try_recv_inner(&! sched)
}

