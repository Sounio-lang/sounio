// Edge cases — T53: run_until_idle with single short thread
// ---------------------------------------------------------------------------
fn test_gth_run_until_idle_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    sched.time_quantum = 5
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    sched.threads[t0 as usize].time_slice = 5
    let ticks = gth_run_until_idle(sched)
    let ok1 = ticks >= 5
    let ok2 = sched.threads[t0 as usize].state == GTH_STATE_DONE
    ok1 && ok2
}
