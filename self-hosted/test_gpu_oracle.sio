// self-hosted::test_gpu_oracle — Oracle Diff Gate Test Harness
//
// Compares self-hosted GPU backend output against known reference values
// derived from the Rust backend oracle.
//
// Structure:
//   Section 1 — PTX pipeline oracle (self-hosted vs Rust reference PTX)
//   Section 2 — HLIR→GPU lowering oracle (op counts, type lowering, shadows)
//   Section 3 — Epsilon arithmetic oracle (uncertainty propagation formulas)
//   Section 4 — Metal MSL oracle (structural patterns)
//   Section 5 — SPIR-V binary oracle (magic/version/capability words)
//   Section 6 — Module assembly oracle
//
// Gate rule: if any diff exceeds tolerance → test fails and reports for
// immediate diagnosis.
//
// "Oracle" here means: the self-hosted output must match what the Rust backend
// produces for the same input.  PTX reference strings are taken from test_08
// (gpu_ptx_test_08_full_kernel_deterministic), which was verified against the
// compiled Rust PtxCodegen output.

// ============================================================================
// Section 0 — Local arithmetic helpers (must precede all test functions)
// ============================================================================

// Newton-method sqrt (30 iterations — sufficient for f64 precision, no libc).
fn oracle_sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    var i: i64 = 0
    while i < 30 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    g
}

fn oracle_abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn oracle_near_f64(a: f64, b: f64, tol: f64) -> bool {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    abs_diff <= tol
}

fn oracle_near_f32(a: f32, b: f32, tol: f32) -> bool {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    abs_diff <= tol
}

// ============================================================================
// Section 1 — PTX pipeline oracle
// ============================================================================

// Oracle O01: Self-hosted hardcoded emitter matches the Rust backend reference.
//
// The reference is the exact PTX string produced by Rust PtxCodegen for vec_add
// (sm_50, .version 7.0).  Any byte difference here is a regression.
fn oracle_test_01_ptx_vec_add_matches_rust_reference() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(ptx_emit_demo_vec_add())
    // Split across two literals joined with str_concat, not one 672-byte
    // literal: past the parser's 384-byte (incl. quotes) Name capacity per
    // literal (E258).
    let reference = str_concat(".version 7.0\n.target sm_50\n.address_size 64\n\n.visible .entry vec_add(\n    .param .u64 param_a,\n    .param .u64 param_b,\n    .param .u64 param_c\n)\n{\n    .reg .pred %p<2>;\n    .reg .b32 %r<3>;\n    .reg .b64 %rd<9>;\n    .reg .f32 %f<4>;\n\n    mov.u32 %r1, %tid.x;\n    cvt.u64.u32 %rd1, %r1;\n    mul.lo.u64 %rd2, %rd1, 4;\n", "    ld.param.u64 %rd3, [param_a];\n    ld.param.u64 %rd4, [param_b];\n    ld.param.u64 %rd5, [param_c];\n    add.u64 %rd6, %rd3, %rd2;\n    add.u64 %rd7, %rd4, %rd2;\n    add.u64 %rd8, %rd5, %rd2;\n    ld.global.f32 %f1, [%rd6];\n    ld.global.f32 %f2, [%rd7];\n    add.f32 %f3, %f1, %f2;\n    st.global.f32 [%rd8], %f3;\n    ret;\n}\n")
    s == reference
}

// Oracle O02: IR-driven lowering (kernel_ir + lower_to_ptx) matches the reference.
//
// Critical round-trip diff gate: kernel_ir.sio + lower_to_ptx.sio must produce
// byte-identical output to the hardcoded emitter, which was verified against Rust.
fn oracle_test_02_ptx_ir_path_matches_reference() -> bool with Mut, Panic, Div, Alloc {
    let from_ir = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_add_ir()))
    let from_hardcoded = ptx_to_string(ptx_emit_demo_vec_add())
    from_ir == from_hardcoded
}

// Oracle O03: Mul kernel emits mul.rn.f32 (or bare mul.f32), not add.f32.
fn oracle_test_03_ptx_mul_uses_mul_instruction() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_mul_f32_ir()))
    (ptx_str_contains(s, "mul.rn.f32") || ptx_str_contains(s, "mul.f32")) &&
    ptx_str_contains(s, "ld.global.f32") &&
    ptx_str_contains(s, "st.global.f32") &&
    !ptx_str_contains(s, "add.f32")
}

// Oracle O04: Div kernel emits a division instruction for f32.
fn oracle_test_04_ptx_div_uses_div_instruction() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_div_f32_ir()))
    (ptx_str_contains(s, "div.rn.f32") || ptx_str_contains(s, "div.f32")) &&
    ptx_str_contains(s, "ld.global.f32") &&
    ptx_str_contains(s, "st.global.f32")
}

// Oracle O05: Sub kernel emits sub.f32, not add.f32.
fn oracle_test_05_ptx_sub_uses_sub_instruction() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_sub_f32_ir()))
    ptx_str_contains(s, "sub.f32") &&
    !ptx_str_contains(s, "add.f32")
}

// Oracle O06: f64 add uses add.f64 and associated f64 memory instructions.
fn oracle_test_06_ptx_f64_uses_f64_instructions() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_add_f64_ir()))
    ptx_str_contains(s, "add.f64") &&
    ptx_str_contains(s, "ld.global.f64") &&
    ptx_str_contains(s, "st.global.f64") &&
    !ptx_str_contains(s, "add.f32")
}

// ============================================================================
// Section 2 — HLIR→GPU lowering oracle
// ============================================================================

// Oracle O07: Single FAdd with epistemic=false yields exactly 1 op.
//
// Ref: hlir_lower_instr(HlirOpFAdd, epistemic=false) → 1 GpuOpcodeAdd op.
fn oracle_test_07_hlir_single_fadd_non_epistemic() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(false, false, 80, false)
    var b = gpu_block_entry_default()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0

    let r = hlir_lower_instr(st, b, HlirOpFAdd, HLIR_TY_F32, 2, 0, 1, -1, 0, 0.0, 0)
    st = r.0
    b = r.1

    b.op_count == 1
}

// Oracle O08: Single FAdd with epistemic=true yields exactly 7 ops.
//
// Breakdown: 1 main GpuOpcodeAdd + 6 shadow ops (mul,mul,add,sqrt,and,xor).
// This matches the Rust epistemic_ptx.rs shadow emission for knowledge add.
fn oracle_test_08_hlir_single_fadd_epistemic_7_ops() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(true, false, 80, false)
    var b = gpu_block_entry_default()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0

    let r = hlir_lower_instr(st, b, HlirOpFAdd, HLIR_TY_F32, 2, 0, 1, -1, 0, 0.0, 0)
    st = r.0
    b = r.1

    b.op_count == 7
}

// Oracle O09: Two chained FAdds with epistemic=true → 14 ops, shadow_count=2.
//
// Each FAdd emits 7 ops and registers 1 shadow.  Two chained FAdds
// must yield 14 ops total and 2 epistemic shadows.
fn oracle_test_09_hlir_two_fadds_epistemic_14_ops() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(true, false, 80, false)
    var b = gpu_block_entry_default()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0
    let s2 = hlir_gpu_map_value(st, 2, GpuTypeF32)
    st = s2.0

    // FAdd #1: hlir_dst=3, src0=0, src1=1
    let r1 = hlir_lower_instr(st, b, HlirOpFAdd, HLIR_TY_F32, 3, 0, 1, -1, 0, 0.0, 0)
    st = r1.0
    b = r1.1

    // FAdd #2: hlir_dst=4, src0=2, src1=3 (chains from FAdd #1 result)
    let r2 = hlir_lower_instr(st, b, HlirOpFAdd, HLIR_TY_F32, 4, 2, 3, -1, 0, 0.0, 0)
    st = r2.0
    b = r2.1

    b.op_count == 14 && hlir_to_gpu_count_epistemic_shadows(st) == 2
}

// Oracle O10: FMul with epistemic=true emits at least 7 ops.
//
// shadow_mul emits: abs(a), abs(b), mul(abs_a, eps_b), mul(abs_b, eps_a),
// add(eps_c), and(valid), xor(prov) = 7 extra ops, plus 1 main → 8+ total.
// We use >= 7 as the gate (allows for compiler variation in abs implementation).
fn oracle_test_10_hlir_fmul_epistemic_at_least_7_ops() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(true, false, 80, false)
    var b = gpu_block_entry_default()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0

    let r = hlir_lower_instr(st, b, HlirOpFMul, HLIR_TY_F32, 2, 0, 1, -1, 0, 0.0, 0)
    b = r.1

    b.op_count >= 7
}

// Oracle O11: Type lowering — all HLIR scalar types map to the correct GPU type.
//
// This is a direct diff against the Rust hlir_to_gpu.rs type lowering table.
fn oracle_test_11_type_lowering_scalar_types() -> bool {
    hlir_lower_type(HLIR_TY_I32)  == GpuTypeI32  &&
    hlir_lower_type(HLIR_TY_I64)  == GpuTypeI64  &&
    hlir_lower_type(HLIR_TY_F32)  == GpuTypeF32  &&
    hlir_lower_type(HLIR_TY_F64)  == GpuTypeF64  &&
    hlir_lower_type(HLIR_TY_PTR)  == GpuTypePtr  &&
    hlir_lower_type(HLIR_TY_BOOL) == GpuTypeBool &&
    hlir_lower_type(HLIR_TY_U32)  == GpuTypeU32  &&
    hlir_lower_type(HLIR_TY_U64)  == GpuTypeU64  &&
    hlir_lower_type(HLIR_TY_F16)  == GpuTypeF16  &&
    hlir_lower_type(HLIR_TY_I8)   == GpuTypeI8
}

// Oracle O12: Knowledge<T> strips to GpuTypeF32.
//
// GPU carries raw value only; ε is tracked in shadow registers, not the
// primary value register.  Matches Rust epistemic_ptx.rs::lower_type.
fn oracle_test_12_type_lowering_knowledge_to_f32() -> bool {
    hlir_lower_type(HLIR_TY_KNOWLEDGE) == GpuTypeF32
}

// Oracle O13: 128-bit integers downgrade — GPUs lack native 128-bit registers.
//
// The Rust backend also downgrades: i128 → i64, u128 → u64.
fn oracle_test_13_type_lowering_i128_downgrade() -> bool {
    hlir_lower_type(HLIR_TY_I128) == GpuTypeI64 &&
    hlir_lower_type(HLIR_TY_U128) == GpuTypeU64
}

// Oracle O14: Aggregate types (vectors, matrices, hypercomplex) → GpuTypePtr.
//
// Aggregates are passed as pointers to their storage on the GPU.
// Matches Rust hlir_to_gpu.rs::lower_aggregate_type.
fn oracle_test_14_type_lowering_aggregate_to_ptr() -> bool {
    hlir_lower_type(HLIR_TY_VEC2)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_VEC3)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_VEC4)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_MAT2)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_MAT4)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_QUAT)     == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_OCTONION) == GpuTypePtr &&
    hlir_lower_type(HLIR_TY_SEDENION) == GpuTypePtr
}

// Oracle O15: SM version fast-math gate — sm_50+ enables fast-math optimizations.
//
// Matches Rust hlir_to_gpu.rs sm_supports_fast_math threshold.
fn oracle_test_15_sm_fast_math_gate() -> bool {
    hlir_to_gpu_sm_supports_fast_math(50)  &&
    hlir_to_gpu_sm_supports_fast_math(80)  &&
    hlir_to_gpu_sm_supports_fast_math(90)  &&
    !hlir_to_gpu_sm_supports_fast_math(49) &&
    !hlir_to_gpu_sm_supports_fast_math(0)
}

// ============================================================================
// Section 3 — Epsilon arithmetic oracle
// ============================================================================
//
// These tests verify the uncertainty propagation formulas used by the
// self-hosted epistemic GPU backend match the mathematical ground truth.
// The Rust backend (epistemic_ptx.rs) uses these same formulas.
//
// All oracle values are computed from first principles (not from Rust output).

// Oracle O16: Add quadrature — 3-4-5 Pythagorean triple gives exact result.
//   eps_a=3.0, eps_b=4.0 → eps_c = sqrt(9 + 16) = sqrt(25) = 5.0  (exact)
fn oracle_test_16_epsilon_add_quadrature_345() -> bool with Mut, Panic, Div {
    let eps_a: f64 = 3.0
    let eps_b: f64 = 4.0
    let eps_c = oracle_sqrt_f64(eps_a * eps_a + eps_b * eps_b)
    oracle_near_f64(eps_c, 5.0, 1e-10)
}

// Oracle O17: Add quadrature — equal uncertainties: eps_c = eps_a * sqrt(2).
//   eps_a = eps_b = 1.0 → eps_c = sqrt(2) ≈ 1.41421356237
fn oracle_test_17_epsilon_add_quadrature_equal() -> bool with Mut, Panic, Div {
    let eps: f64 = 1.0
    let eps_c = oracle_sqrt_f64(eps * eps + eps * eps)
    let sqrt2 = oracle_sqrt_f64(2.0)
    oracle_near_f64(eps_c, sqrt2, 1e-9)
}

// Oracle O18: Add quadrature — zero base: if eps_b=0 then eps_c = eps_a.
//   eps_a=0.05, eps_b=0.0 → eps_c = sqrt(0.0025) = 0.05  (identity)
fn oracle_test_18_epsilon_add_quadrature_zero_base() -> bool with Mut, Panic, Div {
    let eps_a: f64 = 0.05
    let eps_b: f64 = 0.0
    let eps_c = oracle_sqrt_f64(eps_a * eps_a + eps_b * eps_b)
    oracle_near_f64(eps_c, 0.05, 1e-12)
}

// Oracle O19: Mul first-order — eps_c = |a|*eps_b + |b|*eps_a.
//   a=2.0, eps_a=0.1, b=3.0, eps_b=0.2 → eps_c = 2.0*0.2 + 3.0*0.1 = 0.7
fn oracle_test_19_epsilon_mul_first_order() -> bool {
    let a:     f64 = 2.0
    let eps_a: f64 = 0.1
    let b:     f64 = 3.0
    let eps_b: f64 = 0.2
    let eps_c = oracle_abs_f64(a) * eps_b + oracle_abs_f64(b) * eps_a
    oracle_near_f64(eps_c, 0.7, 1e-14)
}

// Oracle O20: Mul first-order — negative operand: |a| strips the sign.
//   a=-2.0, eps_a=0.1, b=3.0, eps_b=0.2 → same eps_c=0.7 (sign-independent)
fn oracle_test_20_epsilon_mul_negative_values() -> bool {
    let a:     f64 = -2.0
    let eps_a: f64 = 0.1
    let b:     f64 = 3.0
    let eps_b: f64 = 0.2
    let eps_c = oracle_abs_f64(a) * eps_b + oracle_abs_f64(b) * eps_a
    oracle_near_f64(eps_c, 0.7, 1e-14)
}

// Oracle O21: Div uncertainty: eps_c = (|a|*eps_b + |b|*eps_a) / b².
//   a=6.0, eps_a=0.2, b=3.0, eps_b=0.1 → eps_c = (0.6 + 0.6) / 9.0 = 1.2/9.0
fn oracle_test_21_epsilon_div_formula() -> bool with Mut, Panic {
    let a:     f64 = 6.0
    let eps_a: f64 = 0.2
    let b:     f64 = 3.0
    let eps_b: f64 = 0.1
    let numer = oracle_abs_f64(a) * eps_b + oracle_abs_f64(b) * eps_a
    let eps_c = numer / (b * b)
    oracle_near_f64(eps_c, 1.2 / 9.0, 1e-12)
}

// Oracle O22: Epsilon non-negative — sqrt of any sum of squares is >= 0.
//   Ensures: no negative epsilon produced by the quadrature formula.
fn oracle_test_22_epsilon_always_nonneg() -> bool with Mut, Panic, Div {
    let eps_a: f64 = 0.05
    let eps_b: f64 = 0.03
    let eps_c = oracle_sqrt_f64(eps_a * eps_a + eps_b * eps_b)
    eps_c >= 0.0
}

// Oracle O23: Epsilon monotone — larger inputs → larger epsilon output.
//   (0.03,0.04) < (0.06,0.08): doubling each input doubles the output.
fn oracle_test_23_epsilon_add_monotone() -> bool with Mut, Panic, Div {
    let eps_c1 = oracle_sqrt_f64(0.03 * 0.03 + 0.04 * 0.04)
    let eps_c2 = oracle_sqrt_f64(0.06 * 0.06 + 0.08 * 0.08)
    eps_c2 > eps_c1
}

// ============================================================================
// Section 4 — Metal MSL oracle
// ============================================================================
//
// The Rust metal.rs backend always emits specific MSL patterns.
// The self-hosted metal.sio must produce structurally identical output.

// Oracle O24: Metal output includes the Metal stdlib header.
fn oracle_test_24_metal_stdlib_include() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, "#include <metal_stdlib>")
}

// Oracle O25: Metal output declares `using namespace metal`.
fn oracle_test_25_metal_namespace_metal() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, "using namespace metal;")
}

// Oracle O26: Metal compute kernel is declared with `kernel void` attribute.
//
// MSL uses `[[kernel]]` or `kernel void` — not CUDA's `__global__`.
fn oracle_test_26_metal_kernel_void_attribute() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, "kernel void")
}

// Oracle O27: Metal uses `thread_position_in_grid` for the thread ID builtin.
//
// This is the Metal equivalent of `threadIdx.x + blockIdx.x*blockDim.x`.
// Matches the Rust metal.rs thread_id emission.
fn oracle_test_27_metal_thread_position_in_grid() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, "thread_position_in_grid")
}

// Oracle O28: Metal buffer parameters use `[[buffer(N)]]` attribute syntax.
//
// This is the MSL binding syntax — not CUDA's __restrict__ pointer params.
fn oracle_test_28_metal_buffer_attribute_syntax() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, "[[buffer(")
}

// Oracle O29: Metal f32 addition uses C++ `+` operator syntax.
//
// MSL is C++-based — arithmetic uses infix operators, not PTX mnemonics.
fn oracle_test_29_metal_f32_add_uses_plus_operator() -> bool with Mut, Panic, Div, Alloc {
    let buf = gpu_lower_to_metal(gpu_build_vec_add_ir())
    let s = metal_to_string(buf)
    ptx_str_contains(s, " + ")
}

// ============================================================================
// Section 5 — SPIR-V binary oracle
// ============================================================================
//
// SPIR-V is a binary format.  The oracle checks integer words in the buffer.
//
// SPIR-V header layout (5 words per §2.3 of the spec):
//   words[0] = magic number: 0x07230203 = 119734787
//   words[1] = version:      0x00010005 = 65541  (SPIR-V 1.5)
//   words[2] = generator:    42  (SPIRV_GENERATOR_SOUNIO)
//   words[3] = bound:        highest ID + 1 (passed to spv_emit_header)
//   words[4] = schema:       0  (reserved)

// Oracle O30: Magic word matches the SPIR-V specification (0x07230203).
fn oracle_test_30_spirv_magic_word() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 100)
    buf.words[0] == SPIRV_MAGIC
}

// Oracle O31: Version field is SPIR-V 1.5 (0x00010005 = 65541).
fn oracle_test_31_spirv_version_1_5() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 100)
    buf.words[1] == SPIRV_VERSION_1_5
}

// Oracle O32: Generator ID is the Sounio magic (42).
fn oracle_test_32_spirv_generator_sounio() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 100)
    buf.words[2] == SPIRV_GENERATOR_SOUNIO
}

// Oracle O33: Schema word is always 0 (SPIR-V spec §2.3, reserved).
fn oracle_test_33_spirv_schema_zero() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 100)
    buf.words[4] == 0
}

// Oracle O34: Bound word stores the value passed to spv_emit_header.
fn oracle_test_34_spirv_bound_correct() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 256)
    buf.words[3] == 256
}

// Oracle O35: OpCapability instruction encodes as 2-word instruction.
//
// Instruction word = (word_count << 16) | opcode = (2 << 16) | 17 = 131089.
// Followed by the capability ID.
fn oracle_test_35_spirv_capability_word_encoding() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 10)
    buf = spv_emit_capability(buf, CAPABILITY_SHADER)
    // After the 5-word header, capability instruction starts at words[5].
    let expected_instr = (2 * 65536) + OP_CAPABILITY
    buf.words[5] == expected_instr &&
    buf.words[6] == CAPABILITY_SHADER
}

// Oracle O36: OpMemoryModel instruction encodes as 3-word instruction.
//
// Instruction word = (3 << 16) | 14 = 196622.
// Followed by addressing model (0=Logical) and memory model (1=GLSL450).
fn oracle_test_36_spirv_memory_model_encoding() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 10)
    buf = spv_emit_memory_model(buf, ADDRESSING_LOGICAL, MEMORY_GLSL450)
    // After the 5-word header, memory model instruction starts at words[5].
    let expected_instr = (3 * 65536) + OP_MEMORY_MODEL
    buf.words[5] == expected_instr &&
    buf.words[6] == ADDRESSING_LOGICAL &&
    buf.words[7] == MEMORY_GLSL450
}

// Oracle O37: SPIR-V header alone is exactly 5 words.
fn oracle_test_37_spirv_header_is_5_words() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 1)
    buf.word_count == 5
}

// Oracle O38: SPIR-V header + capability instruction is exactly 7 words.
fn oracle_test_38_spirv_header_plus_cap_is_7_words() -> bool with Mut, Panic {
    var buf = spv_buf_new()
    buf = spv_emit_header(buf, 1)
    buf = spv_emit_capability(buf, CAPABILITY_SHADER)
    buf.word_count == 7
}

// ============================================================================
// Section 6 — HLIR→GPU module assembly oracle
// ============================================================================

// Oracle O39: Empty module starts with 0 kernels and 0 device functions.
fn oracle_test_39_empty_module_zero_kernels() -> bool {
    let m = hlir_to_gpu_module_new()
    m.kernel_count == 0 && m.device_fn_count == 0
}

// Oracle O40: Adding one kernel increments kernel_count to 1.
fn oracle_test_40_add_kernel_increments_count() -> bool with Mut, Panic {
    var m = hlir_to_gpu_module_new()
    let k = gpu_kernel_entry_default()
    m = hlir_to_gpu_add_kernel(m, k)
    m.kernel_count == 1
}

// Oracle O41: Adding a device function increments device_fn_count; kernel_count stays 0.
fn oracle_test_41_add_device_fn_increments_count() -> bool with Mut, Panic {
    var m = hlir_to_gpu_module_new()
    let k = gpu_kernel_entry_default()
    m = hlir_to_gpu_add_device_fn(m, k)
    m.device_fn_count == 1 && m.kernel_count == 0
}

// Oracle O42: hlir_to_gpu_count_ops counts all ops across all blocks and kernels.
//
// One kernel, one block, one FAdd (non-epistemic) → count must be 1.
fn oracle_test_42_count_ops_across_kernels() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(false, false, 80, false)
    var m = hlir_to_gpu_module_new()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0

    var b1 = gpu_block_entry_default()
    let r1 = hlir_lower_instr(st, b1, HlirOpFAdd, HLIR_TY_F32, 2, 0, 1, -1, 0, 0.0, 0)
    st = r1.0
    b1 = r1.1

    var k1 = gpu_kernel_entry_default()
    k1 = hlir_gpu_add_block_to_kernel(k1, b1)
    m = hlir_to_gpu_add_kernel(m, k1)

    hlir_to_gpu_count_ops(m) == 1
}

// Oracle O43: Non-epistemic state has 0 shadows after FAdd lowering.
//
// shadow_count must be 0 when epistemic_enabled=false — no shadow ops generated.
fn oracle_test_43_non_epistemic_no_shadows() -> bool with Mut, Panic {
    var st = hlir_to_gpu_state_new(false, false, 80, false)
    var b = gpu_block_entry_default()

    let s0 = hlir_gpu_map_value(st, 0, GpuTypeF32)
    st = s0.0
    let s1 = hlir_gpu_map_value(st, 1, GpuTypeF32)
    st = s1.0

    let r = hlir_lower_instr(st, b, HlirOpFAdd, HLIR_TY_F32, 2, 0, 1, -1, 0, 0.0, 0)
    st = r.0

    hlir_to_gpu_count_epistemic_shadows(st) == 0
}

// ============================================================================
// Oracle test runner
// ============================================================================

fn run_gpu_oracle_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU Oracle Diff Gate ===\n")

    // Section 1: PTX pipeline oracle
    total = total + 1
    if oracle_test_01_ptx_vec_add_matches_rust_reference() { passed = passed + 1; print("  O01 OK  ptx vec_add == rust reference\n") } else { print("  FAIL O01 ptx vec_add != rust reference\n") }
    total = total + 1
    if oracle_test_02_ptx_ir_path_matches_reference() { passed = passed + 1; print("  O02 OK  ir path == hardcoded\n") } else { print("  FAIL O02 ir path != hardcoded\n") }
    total = total + 1
    if oracle_test_03_ptx_mul_uses_mul_instruction() { passed = passed + 1; print("  O03 OK  mul.f32\n") } else { print("  FAIL O03 mul.f32\n") }
    total = total + 1
    if oracle_test_04_ptx_div_uses_div_instruction() { passed = passed + 1; print("  O04 OK  div.f32\n") } else { print("  FAIL O04 div.f32\n") }
    total = total + 1
    if oracle_test_05_ptx_sub_uses_sub_instruction() { passed = passed + 1; print("  O05 OK  sub.f32\n") } else { print("  FAIL O05 sub.f32\n") }
    total = total + 1
    if oracle_test_06_ptx_f64_uses_f64_instructions() { passed = passed + 1; print("  O06 OK  add.f64\n") } else { print("  FAIL O06 add.f64\n") }

    // Section 2: HLIR→GPU lowering oracle
    total = total + 1
    if oracle_test_07_hlir_single_fadd_non_epistemic() { passed = passed + 1; print("  O07 OK  fadd non-epistemic 1 op\n") } else { print("  FAIL O07 fadd non-epistemic op count\n") }
    total = total + 1
    if oracle_test_08_hlir_single_fadd_epistemic_7_ops() { passed = passed + 1; print("  O08 OK  fadd epistemic 7 ops\n") } else { print("  FAIL O08 fadd epistemic op count\n") }
    total = total + 1
    if oracle_test_09_hlir_two_fadds_epistemic_14_ops() { passed = passed + 1; print("  O09 OK  2 fadds epistemic 14 ops 2 shadows\n") } else { print("  FAIL O09 2 fadds epistemic\n") }
    total = total + 1
    if oracle_test_10_hlir_fmul_epistemic_at_least_7_ops() { passed = passed + 1; print("  O10 OK  fmul epistemic >=7 ops\n") } else { print("  FAIL O10 fmul epistemic\n") }
    total = total + 1
    if oracle_test_11_type_lowering_scalar_types() { passed = passed + 1; print("  O11 OK  scalar type lowering\n") } else { print("  FAIL O11 scalar type lowering\n") }
    total = total + 1
    if oracle_test_12_type_lowering_knowledge_to_f32() { passed = passed + 1; print("  O12 OK  Knowledge<T>->f32\n") } else { print("  FAIL O12 Knowledge type\n") }
    total = total + 1
    if oracle_test_13_type_lowering_i128_downgrade() { passed = passed + 1; print("  O13 OK  i128->i64 downgrade\n") } else { print("  FAIL O13 i128 downgrade\n") }
    total = total + 1
    if oracle_test_14_type_lowering_aggregate_to_ptr() { passed = passed + 1; print("  O14 OK  aggregate->ptr\n") } else { print("  FAIL O14 aggregate type\n") }
    total = total + 1
    if oracle_test_15_sm_fast_math_gate() { passed = passed + 1; print("  O15 OK  sm fast-math gate\n") } else { print("  FAIL O15 sm fast-math\n") }

    // Section 3: Epsilon arithmetic oracle
    total = total + 1
    if oracle_test_16_epsilon_add_quadrature_345() { passed = passed + 1; print("  O16 OK  eps add 3-4-5\n") } else { print("  FAIL O16 epsilon add quadrature\n") }
    total = total + 1
    if oracle_test_17_epsilon_add_quadrature_equal() { passed = passed + 1; print("  O17 OK  eps add equal=sqrt2\n") } else { print("  FAIL O17 epsilon add equal\n") }
    total = total + 1
    if oracle_test_18_epsilon_add_quadrature_zero_base() { passed = passed + 1; print("  O18 OK  eps add zero base\n") } else { print("  FAIL O18 epsilon zero base\n") }
    total = total + 1
    if oracle_test_19_epsilon_mul_first_order() { passed = passed + 1; print("  O19 OK  eps mul first-order\n") } else { print("  FAIL O19 epsilon mul\n") }
    total = total + 1
    if oracle_test_20_epsilon_mul_negative_values() { passed = passed + 1; print("  O20 OK  eps mul negative\n") } else { print("  FAIL O20 epsilon mul negative\n") }
    total = total + 1
    if oracle_test_21_epsilon_div_formula() { passed = passed + 1; print("  O21 OK  eps div formula\n") } else { print("  FAIL O21 epsilon div\n") }
    total = total + 1
    if oracle_test_22_epsilon_always_nonneg() { passed = passed + 1; print("  O22 OK  eps nonneg\n") } else { print("  FAIL O22 epsilon nonneg\n") }
    total = total + 1
    if oracle_test_23_epsilon_add_monotone() { passed = passed + 1; print("  O23 OK  eps monotone\n") } else { print("  FAIL O23 epsilon monotone\n") }

    // Section 4: Metal MSL oracle
    total = total + 1
    if oracle_test_24_metal_stdlib_include() { passed = passed + 1; print("  O24 OK  metal stdlib include\n") } else { print("  FAIL O24 metal stdlib\n") }
    total = total + 1
    if oracle_test_25_metal_namespace_metal() { passed = passed + 1; print("  O25 OK  metal namespace\n") } else { print("  FAIL O25 metal namespace\n") }
    total = total + 1
    if oracle_test_26_metal_kernel_void_attribute() { passed = passed + 1; print("  O26 OK  metal kernel void\n") } else { print("  FAIL O26 metal kernel void\n") }
    total = total + 1
    if oracle_test_27_metal_thread_position_in_grid() { passed = passed + 1; print("  O27 OK  metal thread_position_in_grid\n") } else { print("  FAIL O27 metal thread pos\n") }
    total = total + 1
    if oracle_test_28_metal_buffer_attribute_syntax() { passed = passed + 1; print("  O28 OK  metal buffer(N)\n") } else { print("  FAIL O28 metal buffer attr\n") }
    total = total + 1
    if oracle_test_29_metal_f32_add_uses_plus_operator() { passed = passed + 1; print("  O29 OK  metal + operator\n") } else { print("  FAIL O29 metal + op\n") }

    // Section 5: SPIR-V binary oracle
    total = total + 1
    if oracle_test_30_spirv_magic_word() { passed = passed + 1; print("  O30 OK  spirv magic\n") } else { print("  FAIL O30 spirv magic\n") }
    total = total + 1
    if oracle_test_31_spirv_version_1_5() { passed = passed + 1; print("  O31 OK  spirv v1.5\n") } else { print("  FAIL O31 spirv version\n") }
    total = total + 1
    if oracle_test_32_spirv_generator_sounio() { passed = passed + 1; print("  O32 OK  spirv generator=42\n") } else { print("  FAIL O32 spirv generator\n") }
    total = total + 1
    if oracle_test_33_spirv_schema_zero() { passed = passed + 1; print("  O33 OK  spirv schema=0\n") } else { print("  FAIL O33 spirv schema\n") }
    total = total + 1
    if oracle_test_34_spirv_bound_correct() { passed = passed + 1; print("  O34 OK  spirv bound\n") } else { print("  FAIL O34 spirv bound\n") }
    total = total + 1
    if oracle_test_35_spirv_capability_word_encoding() { passed = passed + 1; print("  O35 OK  spirv capability encoding\n") } else { print("  FAIL O35 spirv capability\n") }
    total = total + 1
    if oracle_test_36_spirv_memory_model_encoding() { passed = passed + 1; print("  O36 OK  spirv memory model\n") } else { print("  FAIL O36 spirv memory model\n") }
    total = total + 1
    if oracle_test_37_spirv_header_is_5_words() { passed = passed + 1; print("  O37 OK  spirv 5-word header\n") } else { print("  FAIL O37 spirv header size\n") }
    total = total + 1
    if oracle_test_38_spirv_header_plus_cap_is_7_words() { passed = passed + 1; print("  O38 OK  spirv header+cap=7\n") } else { print("  FAIL O38 spirv word count\n") }

    // Section 6: Module assembly oracle
    total = total + 1
    if oracle_test_39_empty_module_zero_kernels() { passed = passed + 1; print("  O39 OK  empty module\n") } else { print("  FAIL O39 empty module\n") }
    total = total + 1
    if oracle_test_40_add_kernel_increments_count() { passed = passed + 1; print("  O40 OK  add kernel\n") } else { print("  FAIL O40 add kernel\n") }
    total = total + 1
    if oracle_test_41_add_device_fn_increments_count() { passed = passed + 1; print("  O41 OK  add device fn\n") } else { print("  FAIL O41 add device fn\n") }
    total = total + 1
    if oracle_test_42_count_ops_across_kernels() { passed = passed + 1; print("  O42 OK  count ops\n") } else { print("  FAIL O42 count ops\n") }
    total = total + 1
    if oracle_test_43_non_epistemic_no_shadows() { passed = passed + 1; print("  O43 OK  no shadows non-epistemic\n") } else { print("  FAIL O43 shadow count\n") }

    if passed == total {
        print("GPU oracle: all passed\n")
    } else {
        print("GPU oracle: FAILED\n")
    }

    if passed == total { 0 } else { 1 }
}
