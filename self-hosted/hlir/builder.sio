pub fn hlir_builder_emit_select(builder: HlirFunctionBuilder, cond: i64, true_val: i64, false_val: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_select(result, cond, true_val, false_val, ty))
