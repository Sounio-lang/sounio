}

// ============================================================================
// Terminators
// ============================================================================

pub fn hlir_builder_emit_return(builder: HlirFunctionBuilder, value: i64) -> HlirFunctionBuilder with Mut, Panic {
    hlir_builder_set_terminator(builder, hlir_term_return(value))
}

pub fn hlir_builder_emit_return_void(builder: HlirFunctionBuilder) -> HlirFunctionBuilder with Mut, Panic {
    hlir_builder_set_terminator(builder, hlir_term_return(HLIR_INVALID_VALUE))
}

pub fn hlir_builder_emit_branch(builder: HlirFunctionBuilder, target: i64) -> HlirFunctionBuilder with Mut, Panic {
    hlir_builder_set_terminator(builder, hlir_term_branch(target))
}

pub fn hlir_builder_emit_cond_branch(builder: HlirFunctionBuilder, cond: i64, then_blk: i64, else_blk: i64) -> HlirFunctionBuilder with Mut, Panic {
    hlir_builder_set_terminator(builder, hlir_term_cond_branch(cond, then_blk, else_blk))
}

// ============================================================================
// Scope management
// ============================================================================

pub fn hlir_builder_enter_scope(builder: HlirFunctionBuilder) -> HlirFunctionBuilder with Mut {
    var b = builder
    b.scope_depth = b.scope_depth + 1
    b
}

pub fn hlir_builder_exit_scope(builder: HlirFunctionBuilder) -> HlirFunctionBuilder with Mut {
    var b = builder
    b.scope_depth = b.scope_depth - 1
    b
}

pub fn hlir_builder_bind_var(builder: HlirFunctionBuilder, name: HlirName, value_id: i64) -> HlirFunctionBuilder with Mut, Alloc {
    var b = builder
    let binding = HlirVarBinding {
        name: name,
        value_id: value_id,
        slot_id: HLIR_INVALID_VALUE,
        depth: b.scope_depth,
    }
    b.env = hlir_env_push(b.env, binding)
    b
}

pub fn hlir_builder_bind_var_with_slot(builder: HlirFunctionBuilder, name: HlirName, value_id: i64, slot_id: i64) -> HlirFunctionBuilder with Mut, Alloc {
    var b = builder
    let binding = HlirVarBinding {
        name: name,
        value_id: value_id,
        slot_id: slot_id,
        depth: b.scope_depth,
    }
    b.env = hlir_env_push(b.env, binding)
    b
}

pub fn hlir_builder_lookup_var(builder: HlirFunctionBuilder, name: HlirName) -> i64 {
    hlir_env_lookup(builder.env, name)
}

pub fn hlir_builder_lookup_slot(builder: HlirFunctionBuilder, name: HlirName) -> i64 {
    hlir_env_lookup_slot(builder.env, name)
}

// ============================================================================
// Parameter setup
// ============================================================================

pub fn hlir_builder_add_param(builder: HlirFunctionBuilder, name: HlirName, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic, Alloc {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let param_val = pair.1
    let param = HlirParam { value_id: param_val, name: name, ty: ty }
    b.func = hlir_function_add_param(b.func, param)
    b.func = hlir_function_register_local(b.func, param_val, ty)
    b = hlir_builder_bind_var(b, name, param_val)
    (b, param_val)
}

// ============================================================================
// Finalization
// ============================================================================

pub fn hlir_builder_finish(builder: HlirFunctionBuilder) -> HlirFunction {
    builder.func
}

// ============================================================================
// Module Builder
// ============================================================================

pub struct HlirModuleBuilder {
    module: HlirModule,
    next_func_id: i64,
}

pub fn hlir_module_builder_new(name: HlirName) -> HlirModuleBuilder {
    HlirModuleBuilder {
        module: hlir_module_new(name),
        next_func_id: 0,
    }
}

pub fn hlir_module_builder_add_function(mb: HlirModuleBuilder, func: HlirFunction) -> HlirModuleBuilder with Mut, Panic {
    var b = mb
    b.module = hlir_module_add_function(b.module, func)
    b.next_func_id = b.next_func_id + 1
    b
}

pub fn hlir_module_builder_add_global(mb: HlirModuleBuilder, global: HlirGlobal) -> HlirModuleBuilder with Mut, Panic {
    var b = mb
    b.module = hlir_module_add_global(b.module, global)
    b
}

pub fn hlir_module_builder_add_typedef(mb: HlirModuleBuilder, td: HlirTypeDef) -> HlirModuleBuilder with Mut, Panic {
    var b = mb
    b.module = hlir_module_add_typedef(b.module, td)
    b
}

pub fn hlir_module_builder_fresh_func_id(mb: HlirModuleBuilder) -> (HlirModuleBuilder, i64) with Mut {
    var b = mb
    let id = b.next_func_id
    b.next_func_id = b.next_func_id + 1
    (b, id)
}

pub fn hlir_module_builder_finish(mb: HlirModuleBuilder) -> HlirModule {
    mb.module
}
