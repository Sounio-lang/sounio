// self-hosted::hlir::builder — HLIR Function Builder
//
// Provides SSA construction utilities for building HLIR functions.
// Handles:
//   - Fresh value ID generation
//   - Fresh block ID generation
//   - Current block tracking
//   - Variable-to-value mapping (for SSA construction)
//   - Scope stack for lexical scoping

// ============================================================================
// Variable binding (name -> ValueId mapping)
// ============================================================================

pub struct HlirVarBinding {
    name: HlirName,
    value_id: i64,         // Current SSA value for this variable
    slot_id: i64,          // Alloca slot (-1 = no slot, value is direct SSA)
    depth: i64,            // Scope depth at which this binding was created
}

pub fn hlir_var_binding_empty() -> HlirVarBinding {
    HlirVarBinding {
        name: hlir_empty_name(),
        value_id: HLIR_INVALID_VALUE,
        slot_id: HLIR_INVALID_VALUE,
        depth: 0,
    }
}

// Environment as a linked list (same pattern as ir/lower.sio)
pub struct HlirEnvList {
    head: HlirVarBinding,
    tail: Option<Box<HlirEnvList>>,
}

pub fn hlir_env_push(env: Option<Box<HlirEnvList>>, binding: HlirVarBinding) -> Option<Box<HlirEnvList>> with Alloc {
    Some(Box::new(HlirEnvList {
        head: binding,
        tail: env,
    }))
}

pub fn hlir_env_lookup(env: Option<Box<HlirEnvList>>, name: HlirName) -> i64 {
    match env {
        Some(list) => {
            let b = (*list).head
            if hlir_name_eq(b.name, name) {
                b.value_id
            } else {
                hlir_env_lookup((*list).tail, name)
            }
        }
        _ => HLIR_INVALID_VALUE,
    }
}

pub fn hlir_env_lookup_slot(env: Option<Box<HlirEnvList>>, name: HlirName) -> i64 {
    match env {
        Some(list) => {
            let b = (*list).head
            if hlir_name_eq(b.name, name) {
                b.slot_id
            } else {
                hlir_env_lookup_slot((*list).tail, name)
            }
        }
        _ => HLIR_INVALID_VALUE,
    }
}

// ============================================================================
// Function Builder
// ============================================================================

pub struct HlirFunctionBuilder {
    func: HlirFunction,
    next_block_id: i64,
    next_value_id: i64,
    current_block: i64,       // BlockId (-1 = no current block)
    env: Option<Box<HlirEnvList>>,
    scope_depth: i64,
}

pub fn hlir_builder_new(func_id: i64, name: HlirName) -> HlirFunctionBuilder {
    HlirFunctionBuilder {
        func: hlir_function_new(func_id, name),
        next_block_id: 0,
        next_value_id: 0,
        current_block: HLIR_INVALID_BLOCK,
        env: None,
        scope_depth: 0,
    }
}

// ============================================================================
// Value and Block ID generation
// ============================================================================

pub fn hlir_builder_fresh_value(builder: HlirFunctionBuilder) -> (HlirFunctionBuilder, i64) with Mut {
    var b = builder
    let id = b.next_value_id
    b.next_value_id = b.next_value_id + 1
    (b, id)
}

pub fn hlir_builder_fresh_block(builder: HlirFunctionBuilder, label: HlirName) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    var b = builder
    let id = b.next_block_id
    b.next_block_id = b.next_block_id + 1
    // Create the block and add it to the function
    let block = hlir_block_new(id, label)
    b.func = hlir_function_add_block(b.func, block)
    (b, id)
}

// ============================================================================
// Current block management
// ============================================================================

pub fn hlir_builder_set_current_block(builder: HlirFunctionBuilder, block_id: i64) -> HlirFunctionBuilder with Mut {
    var b = builder
    b.current_block = block_id
    b
}

pub fn hlir_builder_current_block(builder: HlirFunctionBuilder) -> i64 {
    builder.current_block
}

// Find the index of a block in the function's block array
pub fn hlir_builder_find_block_index(builder: HlirFunctionBuilder, block_id: i64) -> i64 {
    var i: i64 = 0
    while i < builder.func.block_count {
        if builder.func.blocks[i as usize].id == block_id {
            return i
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// Instruction emission (appends to current block)
// ============================================================================

pub fn hlir_builder_emit(builder: HlirFunctionBuilder, instr: HlirInstr) -> HlirFunctionBuilder with Mut, Panic {
    var b = builder
    let idx = hlir_builder_find_block_index(b, b.current_block)
    if idx >= 0 {
        b.func.blocks[idx as usize] = hlir_block_append_instr(b.func.blocks[idx as usize], instr)
    }
    b
}

pub fn hlir_builder_set_terminator(builder: HlirFunctionBuilder, term: HlirTerminator) -> HlirFunctionBuilder with Mut, Panic {
    var b = builder
    let idx = hlir_builder_find_block_index(b, b.current_block)
    if idx >= 0 {
        b.func.blocks[idx as usize] = hlir_block_set_terminator(b.func.blocks[idx as usize], term)
    }
    b
}

// ============================================================================
// Convenience: emit + allocate result value
// ============================================================================

pub fn hlir_builder_emit_const_int(builder: HlirFunctionBuilder, value: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_const(result, hlir_const_int(value, ty), ty))
    (b, result)
}

pub fn hlir_builder_emit_const_float(builder: HlirFunctionBuilder, value: f64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_const(result, hlir_const_float(value, ty), ty))
    (b, result)
}

pub fn hlir_builder_emit_const_bool(builder: HlirFunctionBuilder, value: bool) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    let ty = hlir_type_bool()
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_const(result, hlir_const_bool(value), ty))
    (b, result)
}

pub fn hlir_builder_emit_binary(builder: HlirFunctionBuilder, op: i64, lhs: i64, rhs: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_binary(result, op, lhs, rhs, ty))
    (b, result)
}

pub fn hlir_builder_emit_unary(builder: HlirFunctionBuilder, op: i64, src: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_unary(result, op, src, ty))
    (b, result)
}

pub fn hlir_builder_emit_load(builder: HlirFunctionBuilder, ptr: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_load(result, ptr, ty))
    (b, result)
}

pub fn hlir_builder_emit_store(builder: HlirFunctionBuilder, ptr: i64, value: i64) -> HlirFunctionBuilder with Mut, Panic {
    hlir_builder_emit(builder, hlir_instr_store(ptr, value))
}

pub fn hlir_builder_emit_alloca(builder: HlirFunctionBuilder, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, hlir_type_ptr(-1))
    b = hlir_builder_emit(b, hlir_instr_alloca(result, ty))
    (b, result)
}

pub fn hlir_builder_emit_call_direct(builder: HlirFunctionBuilder, name: HlirName, args: [i64; 64], arg_count: i64, ret_ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ret_ty)
    b = hlir_builder_emit(b, hlir_instr_call_direct(result, name, args, arg_count, ret_ty))
    (b, result)
}

pub fn hlir_builder_emit_xor_convolution(builder: HlirFunctionBuilder, name: HlirName, args: [i64; 64], arg_count: i64, ret_ty: HlirType, contract: HlirXorConvolution, candidate: i64) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ret_ty)
    b = hlir_builder_emit(b, hlir_instr_xor_convolution_call_direct(result, name, args, arg_count, ret_ty, contract, candidate))
    (b, result)
}

pub fn hlir_builder_emit_cast(builder: HlirFunctionBuilder, value: i64, source: HlirType, target: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, target)
    b = hlir_builder_emit(b, hlir_instr_cast(result, value, source, target))
    (b, result)
}

pub fn hlir_builder_emit_get_field_ptr(builder: HlirFunctionBuilder, base_val: i64, field_idx: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_get_field_ptr(result, base_val, field_idx, ty))
    (b, result)
}

pub fn hlir_builder_emit_get_element_ptr(builder: HlirFunctionBuilder, base_val: i64, index_val: i64, ty: HlirType) -> (HlirFunctionBuilder, i64) with Mut, Panic {
    let pair = hlir_builder_fresh_value(builder)
    var b = pair.0
    let result = pair.1
    b.func = hlir_function_register_local(b.func, result, ty)
    b = hlir_builder_emit(b, hlir_instr_get_element_ptr(result, base_val, index_val, ty))
    (b, result)
