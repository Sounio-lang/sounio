// self-hosted::hlir::lower — AST/HIR -> HLIR SSA lowering
//
// Converts the type-checked AST (or HIR) into HLIR SSA form with explicit
// basic blocks, terminators, phi nodes, and typed instructions.
//
// Design:
//   - State-threading pattern: every function consumes and returns HlirLowerState
//   - No closures/callbacks: control flow helpers return block IDs for the caller
//     to fill in, rather than taking function pointers
//   - No destructuring: tuple results accessed via .0, .1, etc.
//   - Helpers precede callers (no forward references)
//
// Pipeline position:
//   Source -> Lexer -> Parser -> AST -> Check -> [HIR] -> **HLIR** -> Backend

use hlir::opt_strategy::*

// ============================================================================
// Constants
// ============================================================================

let HLIR_LOWER_MAX_SCOPES: i64 = 256
let HLIR_LOWER_MAX_LOOP_DEPTH: i64 = 128
let HLIR_LOWER_NO_LOOP: i64 = -1

let HLIR_TYPE_CODE_NONE: i64 = 0
let HLIR_TYPE_CODE_BOOL: i64 = 1
let HLIR_TYPE_CODE_I8: i64 = 2
let HLIR_TYPE_CODE_I16: i64 = 3
let HLIR_TYPE_CODE_I32: i64 = 4
let HLIR_TYPE_CODE_I64: i64 = 5
let HLIR_TYPE_CODE_U8: i64 = 6
let HLIR_TYPE_CODE_U16: i64 = 7
let HLIR_TYPE_CODE_U32: i64 = 8
let HLIR_TYPE_CODE_U64: i64 = 9
let HLIR_TYPE_CODE_F32: i64 = 10
let HLIR_TYPE_CODE_F64: i64 = 11
let HLIR_TYPE_CODE_OCTONION: i64 = 12
let HLIR_TYPE_CODE_SEDENION: i64 = 13

pub fn hlir_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n < 0 {
        return "0"
    }
    if n == 0 {
        return "0"
    }

    var digits: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var bytes: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        bytes[i as usize] = digits[(rev_len - i - 1) as usize]
        i = i + 1
    }

    str_from_bytes(bytes, rev_len)
}

// ============================================================================
// Scope entry — tracks scope boundaries for pop_scope
// ============================================================================

pub struct HlirScopeEntry {
    depth: i64,
    env_snapshot_size: i64,  // number of bindings when scope was entered
}

pub fn hlir_scope_entry_empty() -> HlirScopeEntry {
    HlirScopeEntry { depth: 0, env_snapshot_size: 0 }
}

// ============================================================================
// HlirLowerState — main lowering state, threaded through every operation
// ============================================================================

pub struct HlirLowerState {
    builder: HlirFunctionBuilder,
    module_builder: HlirModuleBuilder,
    // Loop context for break/continue
    loop_continue_block: i64,   // BlockId, -1 = not in loop
    loop_break_block: i64,      // BlockId, -1 = not in loop
    loop_depth: i64,
    // Loop stack for nested loops
    loop_continue_stack: [i64; 128],
    loop_break_stack: [i64; 128],
    // Scope management
    scope_stack: [HlirScopeEntry; 256],
    scope_stack_top: i64,
    // Error tracking
    error_count: i64,
    // Whether we are currently inside a function
    in_function: bool,
    // Current function name (for diagnostics)
    current_func_name: HlirName,
    // Octonion value model (GPU first-class `a * h`): an octonion value is a repr
    // value-id whose 8 f64 components live in 8 separate value-ids. oct_keys[k] holds
    // the repr id, oct_comps[k*8 + c] holds component c's value-id.
    oct_keys: [i64; 128],
    oct_comps: [i64; 2048],
    oct_dims: [i64; 128],
    // Pointer provenance and deferred algebraic operator operands. A loaded
    // Hyper value keeps its source pointer; a Sedenion product keeps the two
    // source pointers until the destination store makes the three-pointer ABI
    // explicit. This prevents the frontend from erasing the operator into 256
    // scalar products before target selection.
    oct_ptrs: [i64; 128],
    oct_xor_lhs_ptrs: [i64; 128],
    oct_xor_rhs_ptrs: [i64; 128],
    oct_count: i64,
    // Checker-owned semantic identity, reduced to the fields HLIR needs. The
    // source span is stable across the post-check AST reload in the GPU path.
    hyper_span_starts: [i64; 128],
    hyper_span_ends: [i64; 128],
    hyper_algebra_tags: [i64; 128],
    hyper_op_kinds: [i64; 128],
    hyper_expr_count: i64,
}

struct HlirExprListResult {
    state: HlirLowerState,
    values: [i64; 64],
    count: i64,
}

// ============================================================================
// Constructor
// ============================================================================

pub fn hlir_lower_state_new() -> HlirLowerState with Div, Mut, Panic {
    let mod_name = hlir_name_from_str("module")
    HlirLowerState {
        builder: hlir_builder_new(0, hlir_empty_name()),
        module_builder: hlir_module_builder_new(mod_name),
        loop_continue_block: HLIR_LOWER_NO_LOOP,
        loop_break_block: HLIR_LOWER_NO_LOOP,
        loop_depth: 0,
        loop_continue_stack: [HLIR_LOWER_NO_LOOP; 128],
        loop_break_stack: [HLIR_LOWER_NO_LOOP; 128],
        scope_stack: [hlir_scope_entry_empty(); 256],
        scope_stack_top: 0,
        error_count: 0,
        in_function: false,
        current_func_name: hlir_empty_name(),
        oct_keys: [0 - 1; 128],
        oct_comps: [0; 2048],
        oct_dims: [0; 128],
        oct_ptrs: [HLIR_INVALID_VALUE; 128],
        oct_xor_lhs_ptrs: [HLIR_INVALID_VALUE; 128],
        oct_xor_rhs_ptrs: [HLIR_INVALID_VALUE; 128],
        oct_count: 0,
        hyper_span_starts: [0; 128],
        hyper_span_ends: [0; 128],
        hyper_algebra_tags: [0 - 1; 128],
        hyper_op_kinds: [0; 128],
        hyper_expr_count: 0,
    }
}

fn hlir_install_hyper_metadata(state: HlirLowerState, epistemic: &IrEpistemicSection) -> HlirLowerState with Mut, Panic {
    var s = state
    var count = epistemic.hyper_expr_count
    if count > 128 { count = 128 }
    var i: i64 = 0
    while i < count {
        let info = epistemic.hyper_exprs[i as usize]
        s.hyper_span_starts[i as usize] = info.span_start
        s.hyper_span_ends[i as usize] = info.span_end
        s.hyper_algebra_tags[i as usize] = info.algebra_tag
        s.hyper_op_kinds[i as usize] = info.op_kind
        i = i + 1
    }
    s.hyper_expr_count = count
    s
}

fn hlir_checked_hyper_mul_algebra(state: HlirLowerState, span: Span) -> i64 {
    var i: i64 = 0
    while i < state.hyper_expr_count {
        if state.hyper_span_starts[i as usize] == span.start
            && state.hyper_span_ends[i as usize] == span.end
            && state.hyper_op_kinds[i as usize] == 1 {
            return state.hyper_algebra_tags[i as usize]
        }
        i = i + 1
    }
    0 - 1
}

// --- Octonion value model helpers (GPU first-class `a * h`) ---

// cd_sigma sign for octonion basis product e_i·e_j = σ(i,j)·e_{i⊕j} (bits=3, Convention X).
fn hlir_oct_cd_sigma(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return hlir_oct_cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return hlir_oct_cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return hlir_oct_cd_sigma(a_lo, 0, bits - 1) }
        return 0 - hlir_oct_cd_sigma(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - hlir_oct_cd_sigma(0, a_lo, bits - 1) }
    hlir_oct_cd_sigma(b_lo, a_lo, bits - 1)
}

// Record `dim` component value-ids (dim ∈ {8,16}) under a fresh repr id; return (state, repr).
// Storage stride is 16 (max = sedenion); octonions use the first 8 slots.
fn hlir_oct_record(state: HlirLowerState, comps: [i64; 16], dim: i64) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let fresh = hlir_builder_fresh_value(s.builder)
    s.builder = fresh.0
    let repr = fresh.1
    if s.oct_count < 128 {
        let k = s.oct_count
        s.oct_keys[k as usize] = repr
        s.oct_dims[k as usize] = dim
        var c: i64 = 0
        while c < dim {
            s.oct_comps[(k * 16 + c) as usize] = comps[c as usize]
            c = c + 1
        }
        s.oct_count = s.oct_count + 1
    }
    (s, repr)
}

fn hlir_oct_find(state: HlirLowerState, repr: i64) -> i64 {
    var k: i64 = 0
    while k < state.oct_count {
        if state.oct_keys[k as usize] == repr { return k }
        k = k + 1
    }
    0 - 1
}

fn hlir_oct_record_pointer(state: HlirLowerState, repr: i64, ptr: i64) -> HlirLowerState {
    var s = state
    let k = hlir_oct_find(s, repr)
    if k >= 0 { s.oct_ptrs[k as usize] = ptr }
    s
}

fn hlir_oct_pointer(state: HlirLowerState, repr: i64) -> i64 {
    let k = hlir_oct_find(state, repr)
    if k < 0 { return HLIR_INVALID_VALUE }
    state.oct_ptrs[k as usize]
}

fn hlir_oct_record_deferred_xor(state: HlirLowerState, lhs_ptr: i64, rhs_ptr: i64) -> (HlirLowerState, i64) with Mut, Panic {
    let recorded = hlir_oct_record(state, [HLIR_INVALID_VALUE; 16], 16)
    var s = recorded.0
    let k = hlir_oct_find(s, recorded.1)
    if k >= 0 {
        s.oct_xor_lhs_ptrs[k as usize] = lhs_ptr
        s.oct_xor_rhs_ptrs[k as usize] = rhs_ptr
    }
    (s, recorded.1)
}

// Is value_id a recorded hypercomplex repr?
fn hlir_oct_is(state: HlirLowerState, value_id: i64) -> bool {
    var k: i64 = 0
    while k < state.oct_count {
        if state.oct_keys[k as usize] == value_id { return true }
        k = k + 1
    }
    false
}

// Component dimension of a recorded repr (8 = octonion, 16 = sedenion; -1 if unknown).
fn hlir_oct_dim(state: HlirLowerState, repr: i64) -> i64 {
    var k: i64 = 0
    while k < state.oct_count {
        if state.oct_keys[k as usize] == repr { return state.oct_dims[k as usize] }
        k = k + 1
    }
    0 - 1
}

// Fetch up to 16 component value-ids for a repr (unused tail is -1).
fn hlir_oct_lookup(state: HlirLowerState, repr: i64) -> [i64; 16] {
    var out: [i64; 16] = [0 - 1; 16]
    var k: i64 = 0
    while k < state.oct_count {
        if state.oct_keys[k as usize] == repr {
            var c: i64 = 0
            while c < 16 {
                out[c as usize] = state.oct_comps[(k * 16 + c) as usize]
                c = c + 1
            }
            return out
        }
        k = k + 1
    }
    out
}

// Load `dim` f64 components from a hypercomplex pointer value into a fresh repr.
fn hlir_oct_load(state: HlirLowerState, ptr_val: i64, dim: i64) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    var s = state
    var comps: [i64; 16] = [0 - 1; 16]
    var c: i64 = 0
    while c < dim {
        let idx_pair = hlir_lower_literal_int(s, c, hlir_type_i64())
        s = idx_pair.0
        let gep_pair = hlir_lower_gep(s, ptr_val, idx_pair.1, hlir_type_f64())
        s = gep_pair.0
        let load_pair = hlir_lower_load(s, gep_pair.1, hlir_type_f64())
        s = load_pair.0
        comps[c as usize] = load_pair.1
        c = c + 1
    }
    let recorded = hlir_oct_record(s, comps, dim)
    (hlir_oct_record_pointer(recorded.0, recorded.1, ptr_val), recorded.1)
}

// Twisted XOR convolution for the Cayley-Dickson sign function:
// r[d] = sum_i sigma(i, i^d, bits) * a[i] * b[i^d].
// Fixing d makes every selected pair land in one result lane. The explicit
// reduction order remains authoritative; target selectors may accelerate only
// b[i^d] until a reduction proof is available.
fn hlir_xor_convolution(state: HlirLowerState, a_repr: i64, b_repr: i64, contract: HlirXorConvolution) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    var s = state
    let dim = contract.dimension
    let bits = contract.bits
    if bits == 4 && dim == 16 {
        let lhs_ptr = hlir_oct_pointer(s, a_repr)
        let rhs_ptr = hlir_oct_pointer(s, b_repr)
        if lhs_ptr == HLIR_INVALID_VALUE || rhs_ptr == HLIR_INVALID_VALUE {
            return (hlir_lower_report_error(s), HLIR_INVALID_VALUE)
        }
        return hlir_oct_record_deferred_xor(s, lhs_ptr, rhs_ptr)
    }
    let a = hlir_oct_lookup(s, a_repr)
    let b = hlir_oct_lookup(s, b_repr)
    var r: [i64; 16] = [0 - 1; 16]
    var d: i64 = 0
    while d < dim {
        let zp = hlir_lower_literal_float(s, 0.0, hlir_type_f64())
        s = zp.0
        var sum = zp.1
        var i: i64 = 0
        while i < dim {
            let j = i ^ d
            let mulp = hlir_lower_binary(s, HLIR_BIN_FMUL, a[i as usize], b[j as usize], hlir_type_f64())
            s = mulp.0
            var t = mulp.1
            if hlir_oct_cd_sigma(i, j, bits) < 0 {
                let zp2 = hlir_lower_literal_float(s, 0.0, hlir_type_f64())
                s = zp2.0
                let negp = hlir_lower_binary(s, HLIR_BIN_FSUB, zp2.1, t, hlir_type_f64())
                s = negp.0
                t = negp.1
            }
            let addp = hlir_lower_binary(s, HLIR_BIN_FADD, sum, t, hlir_type_f64())
            s = addp.0
            sum = addp.1
            i = i + 1
        }
        r[d as usize] = sum
        d = d + 1
    }
    hlir_oct_record(s, r, dim)
}

// Store a repr's `dim` components through a hypercomplex pointer value.
fn hlir_oct_store(state: HlirLowerState, ptr_val: i64, repr: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    let repr_idx = hlir_oct_find(s, repr)
    if repr_idx >= 0 && s.oct_xor_lhs_ptrs[repr_idx as usize] != HLIR_INVALID_VALUE {
        var args: [i64; 64] = [HLIR_INVALID_VALUE; 64]
        args[0] = s.oct_xor_lhs_ptrs[repr_idx as usize]
        args[1] = s.oct_xor_rhs_ptrs[repr_idx as usize]
        args[2] = ptr_val
        let lowered = hlir_lower_xor_convolution_call(
            s, hlir_empty_name(), args, 3, hlir_type_void(),
            hlir_cayley_dickson_xor_convolution(4), HLIR_XOR_CANDIDATE_AUTO)
        return lowered.0
    }
    let comps = hlir_oct_lookup(s, repr)
    let dim = hlir_oct_dim(s, repr)
    var c: i64 = 0
    while c < dim {
        let idx_pair = hlir_lower_literal_int(s, c, hlir_type_i64())
        s = idx_pair.0
        let gep_pair = hlir_lower_gep(s, ptr_val, idx_pair.1, hlir_type_f64())
        s = gep_pair.0
        s = hlir_lower_store(s, gep_pair.1, comps[c as usize])
        c = c + 1
    }
    s
}

// ============================================================================
// Error reporting
// ============================================================================

pub fn hlir_lower_report_error(state: HlirLowerState) -> HlirLowerState with Mut {
    var s = state
    s.error_count = s.error_count + 1
    s
}

pub fn hlir_lower_has_errors(state: HlirLowerState) -> bool {
    state.error_count > 0
}

// ============================================================================
// Module finalization
// ============================================================================

pub fn hlir_lower_finish_module(state: HlirLowerState) -> HlirModule with Mut {
    var module = hlir_module_builder_finish(state.module_builder)
    module.lowering_error_count = state.error_count
    module
}

// ============================================================================
// Scope management
// ============================================================================

pub fn hlir_lower_push_scope(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_enter_scope(s.builder)
    if s.scope_stack_top < HLIR_LOWER_MAX_SCOPES {
        s.scope_stack[s.scope_stack_top as usize] = HlirScopeEntry {
            depth: s.builder.scope_depth,
            env_snapshot_size: 0,
        }
        s.scope_stack_top = s.scope_stack_top + 1
    }
    s
}

pub fn hlir_lower_pop_scope(state: HlirLowerState) -> HlirLowerState with Mut {
    var s = state
    s.builder = hlir_builder_exit_scope(s.builder)
    if s.scope_stack_top > 0 {
        s.scope_stack_top = s.scope_stack_top - 1
    }
    s
}

// ============================================================================
// Block management
// ============================================================================

// Create a new basic block with the given label, returns the block ID.
pub fn hlir_lower_new_block(state: HlirLowerState, label: string) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let label_name = hlir_name_from_str(label)
    let pair = hlir_builder_fresh_block(s.builder, label_name)
    s.builder = pair.0
    let block_id = pair.1
    (s, block_id)
}

// Switch emission to a different block (sets current_block).
pub fn hlir_lower_switch_to_block(state: HlirLowerState, block_id: i64) -> HlirLowerState with Mut {
    var s = state
    s.builder = hlir_builder_set_current_block(s.builder, block_id)
    s
}

// Emit an unconditional branch terminator to the target block.
pub fn hlir_lower_branch(state: HlirLowerState, target: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit_branch(s.builder, target)
    s
}

// Emit a conditional branch terminator.
pub fn hlir_lower_cond_branch(state: HlirLowerState, cond: i64, then_block: i64, else_block: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit_cond_branch(s.builder, cond, then_block, else_block)
    s
}

// ============================================================================
// Function setup and teardown
// ============================================================================

// Begin a new function. Creates entry block and sets builder state.
pub fn hlir_lower_begin_function(state: HlirLowerState, name: string, ret_ty: HlirType) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let func_name = hlir_name_from_str(name)
    // Get a fresh function ID from the module builder
    let mb_pair = hlir_module_builder_fresh_func_id(s.module_builder)
    s.module_builder = mb_pair.0
    let func_id = mb_pair.1
    // Create a new function builder
    s.builder = hlir_builder_new(func_id, func_name)
    s.builder.func.return_type = ret_ty
    s.in_function = true
    s.current_func_name = func_name
    // Reset loop state
    s.loop_continue_block = HLIR_LOWER_NO_LOOP
    s.loop_break_block = HLIR_LOWER_NO_LOOP
    s.loop_depth = 0
    s.scope_stack_top = 0
    // Create the entry block
    let entry_label = hlir_name_from_str("entry")
    let blk_pair = hlir_builder_fresh_block(s.builder, entry_label)
    s.builder = blk_pair.0
    let entry_id = blk_pair.1
    s.builder = hlir_builder_set_current_block(s.builder, entry_id)
    s
}

// End the current function, finalize and add to module.
pub fn hlir_lower_end_function(state: HlirLowerState) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let finished_func = hlir_builder_finish(s.builder)
    let hints = hlir_strategy_hints_for_compile_strategy(finished_func.compile_strategy)
    let rewritten_func = hlir_opt_apply_strategy(finished_func, hints)
    s.module_builder = hlir_module_builder_add_function(s.module_builder, rewritten_func)
    s.in_function = false
    s.current_func_name = hlir_empty_name()
    s
}

// Add a parameter to the current function being built.
// Returns the value ID assigned to the parameter.
pub fn hlir_lower_add_param(state: HlirLowerState, name: string, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    var s = state
    let param_name = hlir_name_from_str(name)
    let pair = hlir_builder_add_param(s.builder, param_name, ty)
    s.builder = pair.0
    let param_val = pair.1
    (s, param_val)
}

// ============================================================================
// Expression lowering — Literals
// ============================================================================

// Lower an integer literal. Emits a const instruction.
pub fn hlir_lower_literal_int(state: HlirLowerState, value: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_const_int(s.builder, value, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// Lower a floating-point literal. Emits a const instruction.
pub fn hlir_lower_literal_float(state: HlirLowerState, value: f64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_const_float(s.builder, value, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// Lower a boolean literal. Emits a const instruction.
pub fn hlir_lower_literal_bool(state: HlirLowerState, value: bool) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_const_bool(s.builder, value)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — String constant
// ============================================================================

// Lower a string literal. Emits a const instruction with HlirConstString.
pub fn hlir_lower_literal_string(state: HlirLowerState, value: string) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let str_name = hlir_name_from_str(value)
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    let ty = hlir_type_ptr(-1)
    s.builder.func = hlir_function_register_local(s.builder.func, result, ty)
    let instr = hlir_instr_const(result, hlir_const_string(str_name), ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// ============================================================================
// Expression lowering — Null/Unit
// ============================================================================

// Lower a null pointer constant.
pub fn hlir_lower_null(state: HlirLowerState, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, ty)
    let instr = hlir_instr_const(result, hlir_const_null(ty), ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// Lower a unit value.
pub fn hlir_lower_unit(state: HlirLowerState) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let ty = hlir_type_void()
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, ty)
    let instr = hlir_instr_const(result, hlir_const_unit(), ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// ============================================================================
// Expression lowering — Binary operations
// ============================================================================

// Lower a binary operation. Takes pre-lowered LHS and RHS value IDs.
pub fn hlir_lower_binary(state: HlirLowerState, op: i64, lhs_val: i64, rhs_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_binary(s.builder, op, lhs_val, rhs_val, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Unary operations
// ============================================================================

// Lower a unary operation. Takes a pre-lowered operand value ID.
pub fn hlir_lower_unary(state: HlirLowerState, op: i64, operand_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_unary(s.builder, op, operand_val, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Function calls
// ============================================================================

// Lower a direct function call. arg_vals is a fixed-size array of value IDs.
pub fn hlir_lower_call(state: HlirLowerState, callee_name: string, arg_vals: [i64; 64], arg_count: i64, ret_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let name = hlir_name_from_str(callee_name)
    let pair = hlir_builder_emit_call_direct(s.builder, name, arg_vals, arg_count, ret_ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// Lower a direct function call where callee name is already an HlirName.
pub fn hlir_lower_call_named(state: HlirLowerState, callee: HlirName, arg_vals: [i64; 64], arg_count: i64, ret_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_call_direct(s.builder, callee, arg_vals, arg_count, ret_ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

pub fn hlir_lower_xor_convolution_call(state: HlirLowerState, callee: HlirName, arg_vals: [i64; 64], arg_count: i64, ret_ty: HlirType, contract: HlirXorConvolution, candidate: i64) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_xor_convolution(s.builder, callee, arg_vals, arg_count, ret_ty, contract, candidate)
    s.builder = pair.0
    (s, pair.1)
}

// ============================================================================
// Expression lowering — Cast
// ============================================================================

// Lower a type cast. Takes a pre-lowered value ID.
pub fn hlir_lower_cast(state: HlirLowerState, val: i64, from_ty: HlirType, to_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_cast(s.builder, val, from_ty, to_ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Memory operations
// ============================================================================

// Lower a load from a pointer. Returns the loaded value.
pub fn hlir_lower_load(state: HlirLowerState, addr_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_load(s.builder, addr_val, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// Lower a store to a pointer. No value result (void operation).
pub fn hlir_lower_store(state: HlirLowerState, addr_val: i64, val: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit_store(s.builder, addr_val, val)
    s
}

// Lower a GEP (get element pointer) operation.
pub fn hlir_lower_gep(state: HlirLowerState, base_val: i64, index_val: i64, elem_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_get_element_ptr(s.builder, base_val, index_val, elem_ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// Lower a get-field-pointer operation (struct field access).
pub fn hlir_lower_get_field_ptr(state: HlirLowerState, base_val: i64, field_idx: i64, result_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_get_field_ptr(s.builder, base_val, field_idx, result_ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Alloca
// ============================================================================

// Allocate stack space for a given type. Returns a pointer value ID.
pub fn hlir_lower_alloca(state: HlirLowerState, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_alloca(s.builder, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Select (ternary)
// ============================================================================

// Lower a select (conditional move) — useful for simple conditional expressions
// that don't need full basic-block branching.
pub fn hlir_lower_select(state: HlirLowerState, cond_val: i64, true_val: i64, false_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let pair = hlir_builder_emit_select(s.builder, cond_val, true_val, false_val, ty)
    s.builder = pair.0
    let result = pair.1
    (s, result)
}

// ============================================================================
// Expression lowering — Copy
// ============================================================================

// Lower a value copy (SSA copy instruction).
pub fn hlir_lower_copy(state: HlirLowerState, src_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, ty)
    let instr = hlir_instr_copy(result, src_val, ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// ============================================================================
// Expression lowering — ExtractValue / InsertValue
// ============================================================================

// Extract a value from a composite (struct/tuple) at the given index.
pub fn hlir_lower_extract_value(state: HlirLowerState, base_val: i64, index: i64, result_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, result_ty)
    let instr = hlir_instr_extract_value(result, base_val, index, result_ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// Insert a value into a composite at the given index.
pub fn hlir_lower_insert_value(state: HlirLowerState, base_val: i64, insert_val: i64, index: i64, composite_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, composite_ty)
    let instr = hlir_instr_insert_value(result, base_val, insert_val, index, composite_ty)
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// ============================================================================
// Statement lowering — let binding (immutable)
// ============================================================================

// Lower a `let` binding. The init_val is the already-lowered initializer.
// Binds the name to the init value in the environment (pure SSA binding).
pub fn hlir_lower_let(state: HlirLowerState, name: string, ty: HlirType, init_val: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    let var_name = hlir_name_from_str(name)
    s.builder = hlir_builder_bind_var(s.builder, var_name, init_val)
    s
}

// Lower a `let` binding using an HlirName directly.
pub fn hlir_lower_let_named(state: HlirLowerState, name: HlirName, ty: HlirType, init_val: i64) -> HlirLowerState with Mut, Alloc {
    var s = state
    s.builder = hlir_builder_bind_var(s.builder, name, init_val)
    s
}

// ============================================================================
// Statement lowering — var binding (mutable)
// ============================================================================

// Lower a `var` binding. Creates an alloca slot, stores the initial value,
// and binds the name to the alloca pointer in the environment.
// For mutable variables, reads go through load and writes through store.
pub fn hlir_lower_var(state: HlirLowerState, name: string, ty: HlirType, init_val: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    // Allocate stack slot
    let alloca_pair = hlir_builder_emit_alloca(s.builder, ty)
    s.builder = alloca_pair.0
    let slot = alloca_pair.1
    // Store the initial value
    s.builder = hlir_builder_emit_store(s.builder, slot, init_val)
    // Bind name to the slot (not the value) for later load/store
    let var_name = hlir_name_from_str(name)
    s.builder = hlir_builder_bind_var_with_slot(s.builder, var_name, init_val, slot)
    s
}

// Lower a `var` binding using an HlirName directly.
pub fn hlir_lower_var_named(state: HlirLowerState, name: HlirName, ty: HlirType, init_val: i64) -> HlirLowerState with Mut, Panic, Alloc {
    var s = state
    // Allocate stack slot
    let alloca_pair = hlir_builder_emit_alloca(s.builder, ty)
    s.builder = alloca_pair.0
    let slot = alloca_pair.1
    // Store the initial value
    s.builder = hlir_builder_emit_store(s.builder, slot, init_val)
    // Bind name to the slot for later load/store
    s.builder = hlir_builder_bind_var_with_slot(s.builder, name, init_val, slot)
    s
}

// ============================================================================
// Statement lowering — assignment
// ============================================================================

// Lower an assignment to a mutable variable. Looks up the alloca slot and stores.
pub fn hlir_lower_assign(state: HlirLowerState, name: string, val: i64) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let var_name = hlir_name_from_str(name)
    let slot = hlir_builder_lookup_slot(s.builder, var_name)
    if slot != HLIR_INVALID_VALUE {
        s.builder = hlir_builder_emit_store(s.builder, slot, val)
        s
    } else {
        // No slot — could be an error or a direct SSA rebinding
        // In strict SSA, this would be an error. For now, report it.
        hlir_lower_report_error(s)
    }
}

// Lower an assignment using an HlirName directly.
pub fn hlir_lower_assign_named(state: HlirLowerState, name: HlirName, val: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    let slot = hlir_builder_lookup_slot(s.builder, name)
    if slot != HLIR_INVALID_VALUE {
        s.builder = hlir_builder_emit_store(s.builder, slot, val)
        s
    } else {
        hlir_lower_report_error(s)
    }
}

// ============================================================================
// Statement lowering — variable read
// ============================================================================

// Read the current value of a variable. For mutable vars, loads from the alloca slot.
// For immutable bindings, returns the bound SSA value directly.
pub fn hlir_lower_read_var(state: HlirLowerState, name: string, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let var_name = hlir_name_from_str(name)
    let slot = hlir_builder_lookup_slot(s.builder, var_name)
    if slot != HLIR_INVALID_VALUE {
        // Mutable variable — load from the alloca
        let pair = hlir_builder_emit_load(s.builder, slot, ty)
        s.builder = pair.0
        let result = pair.1
        (s, result)
    } else {
        // Immutable binding — return the SSA value directly
        let val = hlir_builder_lookup_var(s.builder, var_name)
        if val != HLIR_INVALID_VALUE {
            (s, val)
        } else {
            // Variable not found — error
            s = hlir_lower_report_error(s)
            (s, HLIR_INVALID_VALUE)
        }
    }
}

// Read variable using HlirName directly.
pub fn hlir_lower_read_var_named(state: HlirLowerState, name: HlirName, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let slot = hlir_builder_lookup_slot(s.builder, name)
    if slot != HLIR_INVALID_VALUE {
        let pair = hlir_builder_emit_load(s.builder, slot, ty)
        s.builder = pair.0
        let result = pair.1
        (s, result)
    } else {
        let val = hlir_builder_lookup_var(s.builder, name)
        if val != HLIR_INVALID_VALUE {
            (s, val)
        } else {
            s = hlir_lower_report_error(s)
            (s, HLIR_INVALID_VALUE)
        }
    }
}

// ============================================================================
// Statement lowering — return
// ============================================================================

// Lower a return statement with a value.
pub fn hlir_lower_return(state: HlirLowerState, val: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit_return(s.builder, val)
    s
}

// Lower a void return statement.
pub fn hlir_lower_return_void(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit_return_void(s.builder)
    s
}

// ============================================================================
// Control flow — if/else branching
//
// Since Sounio has no closures, the if lowering is split into phases:
//   1. hlir_lower_if_branch: creates blocks, emits cond branch, returns block IDs
//   2. Caller fills in then_block and else_block with code
//   3. hlir_lower_if_merge: seals the merge point
// ============================================================================

// Phase 1: Create then/else/merge blocks and emit the conditional branch.
// Returns (state, then_block, else_block, merge_block) as a 4-tuple.
// Since Sounio cannot return 4 values directly, we use a struct.
pub struct HlirIfBranchResult {
    state: HlirLowerState,
    then_block: i64,
    else_block: i64,
    merge_block: i64,
}

pub fn hlir_lower_if_branch(state: HlirLowerState, cond_val: i64) -> HlirIfBranchResult with Mut, Panic, Div {
    var s = state

    // Create the three blocks
    let then_pair = hlir_lower_new_block(s, "if.then")
    s = then_pair.0
    let then_block = then_pair.1

    let else_pair = hlir_lower_new_block(s, "if.else")
    s = else_pair.0
    let else_block = else_pair.1

    let merge_pair = hlir_lower_new_block(s, "if.merge")
    s = merge_pair.0
    let merge_block = merge_pair.1

    // Emit conditional branch in the current block
    s = hlir_lower_cond_branch(s, cond_val, then_block, else_block)

    HlirIfBranchResult {
        state: s,
        then_block: then_block,
        else_block: else_block,
        merge_block: merge_block,
    }
}

// Phase 3: After both branches have been filled in, merge with an optional
// phi node if the if-expression produces a value.
// then_val and else_val are the values produced by each branch (-1 = no value).
// then_exit_block and else_exit_block are the blocks that the branches exit from
// (may differ from then_block/else_block if the branch body creates sub-blocks).
pub fn hlir_lower_if_merge(state: HlirLowerState, merge_block: i64, then_exit_block: i64, then_val: i64, else_exit_block: i64, else_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state

    // Switch to merge block
    s = hlir_lower_switch_to_block(s, merge_block)

    // If both branches produce a value, emit a phi node
    if then_val != HLIR_INVALID_VALUE {
        if else_val != HLIR_INVALID_VALUE {
            let val_pair = hlir_builder_fresh_value(s.builder)
            s.builder = val_pair.0
            let phi_result = val_pair.1
            s.builder.func = hlir_function_register_local(s.builder.func, phi_result, ty)

            // Build the phi instruction
            var phi_instr = hlir_instr_new(HLIR_OP_PHI)
            phi_instr.result = phi_result
            phi_instr.ty = ty
            phi_instr.phi_incoming[0] = HlirPhiEntry {
                block_id: then_exit_block,
                value_id: then_val,
            }
            phi_instr.phi_incoming[1] = HlirPhiEntry {
                block_id: else_exit_block,
                value_id: else_val,
            }
            phi_instr.phi_count = 2
            s.builder = hlir_builder_emit(s.builder, phi_instr)
            return (s, phi_result)
        }
    }
    // No phi needed — return invalid value (void if)
    (s, HLIR_INVALID_VALUE)
}

// Convenience: full if-else lowering without closures.
// The caller passes pre-computed then_val/else_val.
// This is a simplified version for when both branches are single expressions.
pub fn hlir_lower_if_simple(state: HlirLowerState, cond_val: i64, then_val: i64, else_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state

    // Create blocks
    let then_pair = hlir_lower_new_block(s, "if.then")
    s = then_pair.0
    let then_block = then_pair.1

    let else_pair = hlir_lower_new_block(s, "if.else")
    s = else_pair.0
    let else_block = else_pair.1

    let merge_pair = hlir_lower_new_block(s, "if.merge")
    s = merge_pair.0
    let merge_block = merge_pair.1

    // Emit conditional branch
    s = hlir_lower_cond_branch(s, cond_val, then_block, else_block)

    // Then block: branch to merge
    s = hlir_lower_switch_to_block(s, then_block)
    s = hlir_lower_branch(s, merge_block)

    // Else block: branch to merge
    s = hlir_lower_switch_to_block(s, else_block)
    s = hlir_lower_branch(s, merge_block)

    // Merge block with phi
    s = hlir_lower_switch_to_block(s, merge_block)

    if then_val != HLIR_INVALID_VALUE {
        if else_val != HLIR_INVALID_VALUE {
            let val_pair = hlir_builder_fresh_value(s.builder)
            s.builder = val_pair.0
            let phi_result = val_pair.1
            s.builder.func = hlir_function_register_local(s.builder.func, phi_result, ty)

            var phi_instr = hlir_instr_new(HLIR_OP_PHI)
            phi_instr.result = phi_result
            phi_instr.ty = ty
            phi_instr.phi_incoming[0] = HlirPhiEntry {
                block_id: then_block,
                value_id: then_val,
            }
            phi_instr.phi_incoming[1] = HlirPhiEntry {
                block_id: else_block,
                value_id: else_val,
            }
            phi_instr.phi_count = 2
            s.builder = hlir_builder_emit(s.builder, phi_instr)
            return (s, phi_result)
        }
    }
    (s, HLIR_INVALID_VALUE)
}

// Spec-facing compatibility entrypoint.
// For single-value branches, this forwards to the simple SSA if-lowering path.
pub fn hlir_lower_if(state: HlirLowerState, cond_val: i64, then_val: i64, else_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    hlir_lower_if_simple(state, cond_val, then_val, else_val, ty)
}

// ============================================================================
// Control flow — while loop
//
// Structure:
//   header_block: evaluate condition, cond_branch -> body_block / exit_block
//   body_block:   loop body, branch -> header_block
//   exit_block:   continuation after loop
//
// break  -> branch to exit_block
// continue -> branch to header_block
// ============================================================================

// Create while-loop structure. Returns block IDs for the caller to fill.
pub struct HlirWhileResult {
    state: HlirLowerState,
    header_block: i64,
    body_block: i64,
    exit_block: i64,
}

pub fn hlir_lower_while_begin(state: HlirLowerState) -> HlirWhileResult with Mut, Panic, Div {
    var s = state

    // Create the three blocks
    let header_pair = hlir_lower_new_block(s, "while.header")
    s = header_pair.0
    let header_block = header_pair.1

    let body_pair = hlir_lower_new_block(s, "while.body")
    s = body_pair.0
    let body_block = body_pair.1

    let exit_pair = hlir_lower_new_block(s, "while.exit")
    s = exit_pair.0
    let exit_block = exit_pair.1

    // Branch from current block to header
    s = hlir_lower_branch(s, header_block)

    // Push loop context
    if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
        s.loop_continue_stack[s.loop_depth as usize] = s.loop_continue_block
        s.loop_break_stack[s.loop_depth as usize] = s.loop_break_block
    }
    s.loop_continue_block = header_block
    s.loop_break_block = exit_block
    s.loop_depth = s.loop_depth + 1

    HlirWhileResult {
        state: s,
        header_block: header_block,
        body_block: body_block,
        exit_block: exit_block,
    }
}

// Complete the while loop: emits the conditional branch in the header and
// the back-edge branch from the body to the header.
// cond_val: the condition value (must have been emitted in the header block).
pub fn hlir_lower_while_end(state: HlirLowerState, header_block: i64, body_block: i64, exit_block: i64, cond_val: i64) -> HlirLowerState with Mut, Panic {
    var s = state

    // The header block should already be current after lowering the condition.
    // Emit the conditional branch: if cond -> body, else -> exit
    s = hlir_lower_cond_branch(s, cond_val, body_block, exit_block)

    // The body block code has been emitted by the caller.
    // We just need the back-edge to the header (caller should have switched
    // to body_block and emitted code there already).

    // Pop loop context
    s.loop_depth = s.loop_depth - 1
    if s.loop_depth >= 0 {
        if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
            s.loop_continue_block = s.loop_continue_stack[s.loop_depth as usize]
            s.loop_break_block = s.loop_break_stack[s.loop_depth as usize]
        }
    } else {
        s.loop_continue_block = HLIR_LOWER_NO_LOOP
        s.loop_break_block = HLIR_LOWER_NO_LOOP
    }

    // Switch to exit block for subsequent code
    s = hlir_lower_switch_to_block(s, exit_block)
    s
}

// Simplified while loop: handles the entire pattern for callers that
// pre-compute the condition and body.
pub fn hlir_lower_while(state: HlirLowerState, cond_val: i64, body_exit_block: i64, header_block: i64, body_block: i64, exit_block: i64) -> HlirLowerState with Mut, Panic {
    // Emit back-edge from body to header
    var s = state
    s = hlir_lower_switch_to_block(s, body_exit_block)
    s = hlir_lower_branch(s, header_block)
    // Finalize: pop loop context and switch to exit
    s = hlir_lower_while_end(s, header_block, body_block, exit_block, cond_val)
    s
}

// ============================================================================
// Control flow — infinite loop
//
// Structure:
//   header_block: loop body, branch -> header_block
//   exit_block:   continuation after loop (reached via break)
// ============================================================================

pub struct HlirLoopResult {
    state: HlirLowerState,
    header_block: i64,
    exit_block: i64,
}

pub fn hlir_lower_loop_begin(state: HlirLowerState) -> HlirLoopResult with Mut, Panic, Div {
    var s = state

    let header_pair = hlir_lower_new_block(s, "loop.header")
    s = header_pair.0
    let header_block = header_pair.1

    let exit_pair = hlir_lower_new_block(s, "loop.exit")
    s = exit_pair.0
    let exit_block = exit_pair.1

    // Branch from current block to header
    s = hlir_lower_branch(s, header_block)

    // Push loop context
    if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
        s.loop_continue_stack[s.loop_depth as usize] = s.loop_continue_block
        s.loop_break_stack[s.loop_depth as usize] = s.loop_break_block
    }
    s.loop_continue_block = header_block
    s.loop_break_block = exit_block
    s.loop_depth = s.loop_depth + 1

    s = hlir_lower_switch_to_block(s, header_block)

    HlirLoopResult {
        state: s,
        header_block: header_block,
        exit_block: exit_block,
    }
}

pub fn hlir_lower_loop_end(state: HlirLowerState, header_block: i64, exit_block: i64) -> HlirLowerState with Mut, Panic {
    var s = state

    // Emit back-edge from current (body) block to header
    s = hlir_lower_branch(s, header_block)

    // Pop loop context
    s.loop_depth = s.loop_depth - 1
    if s.loop_depth >= 0 {
        if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
            s.loop_continue_block = s.loop_continue_stack[s.loop_depth as usize]
            s.loop_break_block = s.loop_break_stack[s.loop_depth as usize]
        }
    } else {
        s.loop_continue_block = HLIR_LOWER_NO_LOOP
        s.loop_break_block = HLIR_LOWER_NO_LOOP
    }

    // Switch to exit block
    s = hlir_lower_switch_to_block(s, exit_block)
    s
}

// ============================================================================
// Control flow — break and continue
// ============================================================================

// Lower a break statement. Emits a branch to the current loop's exit block.
pub fn hlir_lower_break(state: HlirLowerState) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    if s.loop_break_block != HLIR_LOWER_NO_LOOP {
        s = hlir_lower_branch(s, s.loop_break_block)
        // After break, we need a new block to collect dead code
        // (the current block is terminated)
        let dead_pair = hlir_lower_new_block(s, "break.dead")
        s = dead_pair.0
        let dead_block = dead_pair.1
        s = hlir_lower_switch_to_block(s, dead_block)
        s
    } else {
        hlir_lower_report_error(s)
    }
}

// Lower a continue statement. Emits a branch to the current loop's header.
pub fn hlir_lower_continue(state: HlirLowerState) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    if s.loop_continue_block != HLIR_LOWER_NO_LOOP {
        s = hlir_lower_branch(s, s.loop_continue_block)
        // After continue, create a dead block for subsequent code
        let dead_pair = hlir_lower_new_block(s, "continue.dead")
        s = dead_pair.0
        let dead_block = dead_pair.1
        s = hlir_lower_switch_to_block(s, dead_block)
        s
    } else {
        hlir_lower_report_error(s)
    }
}

// ============================================================================
// Phi node construction
// ============================================================================

// Emit a phi node with the given incoming entries. Used for SSA merge points.
pub fn hlir_lower_phi(state: HlirLowerState, entries: [HlirPhiEntry; 64], entry_count: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, ty)

    var phi_instr = hlir_instr_new(HLIR_OP_PHI)
    phi_instr.result = result
    phi_instr.ty = ty
    phi_instr.phi_incoming = entries
    phi_instr.phi_count = entry_count
    s.builder = hlir_builder_emit(s.builder, phi_instr)
    (s, result)
}

// Create a phi node with two incoming values (most common case).
pub fn hlir_lower_phi2(state: HlirLowerState, block_a: i64, val_a: i64, block_b: i64, val_b: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var entries: [HlirPhiEntry; 64] = [hlir_phi_entry_empty(); 64]
    entries[0] = HlirPhiEntry { block_id: block_a, value_id: val_a }
    entries[1] = HlirPhiEntry { block_id: block_b, value_id: val_b }
    hlir_lower_phi(state, entries, 2, ty)
}

// ============================================================================
// Switch / multi-way branch
// ============================================================================

// Emit a switch terminator (multi-way conditional).
pub fn hlir_lower_switch(state: HlirLowerState, scrutinee: i64, default_block: i64, cases: [HlirSwitchCase; 256], case_count: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    var term = hlir_term_unreachable()
    term.kind = HLIR_TERM_SWITCH
    term.switch_value = scrutinee
    term.switch_default = default_block
    term.switch_cases = cases
    term.switch_case_count = case_count
    s.builder = hlir_builder_set_terminator(s.builder, term)
    s
}

// ============================================================================
// Unreachable terminator
// ============================================================================

// Emit an unreachable terminator (for paths that should never be reached).
pub fn hlir_lower_unreachable(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_set_terminator(s.builder, hlir_term_unreachable())
    s
}

// ============================================================================
// Effect operations
// ============================================================================

// Emit a perform-effect instruction. Returns the effect result value.
pub fn hlir_lower_perform_effect(state: HlirLowerState, effect_name: string, op_name: string, args: [i64; 16], arg_count: i64, result_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, result_ty)

    var instr = hlir_instr_new(HLIR_OP_PERFORM_EFFECT)
    instr.result = result
    instr.ty = result_ty
    instr.effect_name = hlir_name_from_str(effect_name)
    instr.effect_op = hlir_name_from_str(op_name)
    instr.effect_args = args
    instr.effect_arg_count = arg_count
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// Emit a push-handler instruction (enter an effect handler scope).
pub fn hlir_lower_push_handler(state: HlirLowerState, handler_name: string, handler_id: i64) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1

    var instr = hlir_instr_new(HLIR_OP_PUSH_HANDLER)
    instr.result = result
    instr.handler_name = hlir_name_from_str(handler_name)
    instr.handler_id = handler_id
    s.builder = hlir_builder_emit(s.builder, instr)
    s
}

// Emit a pop-handler instruction (leave an effect handler scope).
pub fn hlir_lower_pop_handler(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    var s = state
    var instr = hlir_instr_new(HLIR_OP_POP_HANDLER)
    instr.result = HLIR_INVALID_VALUE
    s.builder = hlir_builder_emit(s.builder, instr)
    s
}

// ============================================================================
// Global variable support
// ============================================================================

// Add a global variable to the module.
pub fn hlir_lower_add_global(state: HlirLowerState, name: string, ty: HlirType, is_const: bool) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let global_name = hlir_name_from_str(name)
    // Use module-level ID for the global
    let global_id = s.module_builder.module.global_count
    var g = hlir_global_new(global_id, global_name, ty)
    g.is_const = is_const
    s.module_builder = hlir_module_builder_add_global(s.module_builder, g)
    (s, global_id)
}

// Add a global variable with an initializer.
pub fn hlir_lower_add_global_init(state: HlirLowerState, name: string, ty: HlirType, init: HlirConstant, is_const: bool) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let global_name = hlir_name_from_str(name)
    let global_id = s.module_builder.module.global_count
    var g = hlir_global_new(global_id, global_name, ty)
    g.is_const = is_const
    g.init = init
    g.has_init = true
    s.module_builder = hlir_module_builder_add_global(s.module_builder, g)
    (s, global_id)
}

// ============================================================================
// Type definition support
// ============================================================================

// Add a struct type definition to the module.
pub fn hlir_lower_add_struct_typedef(state: HlirLowerState, name: string, fields: [HlirTypeDefField; 128], field_count: i64) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let struct_name = hlir_name_from_str(name)
    var td = hlir_typedef_struct(struct_name)
    td.fields = fields
    td.field_count = field_count
    s.module_builder = hlir_module_builder_add_typedef(s.module_builder, td)
    s
}

// ============================================================================
// Function attribute helpers
// ============================================================================

// Mark the current function as exported.
pub fn hlir_lower_set_exported(state: HlirLowerState) -> HlirLowerState with Mut {
    var s = state
    s.builder.func.is_exported = true
    s
}

// Mark the current function as a GPU kernel.
pub fn hlir_lower_set_kernel(state: HlirLowerState) -> HlirLowerState with Mut {
    var s = state
    s.builder.func.is_kernel = true
    s
}

// Mark the current function as variadic.
pub fn hlir_lower_set_variadic(state: HlirLowerState) -> HlirLowerState with Mut {
    var s = state
    s.builder.func.is_variadic = true
    s
}

// Set the ABI for the current function.
pub fn hlir_lower_set_abi(state: HlirLowerState, abi: HlirAbi) -> HlirLowerState with Mut {
    var s = state
    s.builder.func.abi = abi
    s
}

// Set the link name for the current function.
pub fn hlir_lower_set_link_name(state: HlirLowerState, link_name: string) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    s.builder.func.link_name = hlir_name_from_str(link_name)
    s
}

// Add an effect declaration to the current function.
pub fn hlir_lower_add_effect(state: HlirLowerState, effect_name: string) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    let name = hlir_name_from_str(effect_name)
    s.builder.func = hlir_function_add_effect(s.builder.func, name)
    s
}

// Set the compile strategy for the current function.
pub fn hlir_lower_set_strategy(state: HlirLowerState, strategy: CompileStrategy) -> HlirLowerState with Mut {
    var s = state
    s.builder.func.compile_strategy = strategy
    s
}

// Transfer effects from AST EffectList to the HLIR function being built.
pub fn hlir_lower_effects_from_ast(state: HlirLowerState, effects: Option<Box<EffectList>>) -> HlirLowerState with Mut, Panic, Div {
    match effects {
        Some(list) => {
            var s = state
            let eff = (*list).head
            let ename = str_from_bytes(eff.name_buf, eff.name_len)
            s = hlir_lower_add_effect(s, ename)
            hlir_lower_effects_from_ast(s, (*list).tail)
        }
        None => state,
    }
}

// Check if a function has a specific named effect.
pub fn hlir_func_has_effect_named(func: HlirFunction, name: string) -> bool with Mut, Panic, Div {
    let target = hlir_name_from_str(name)
    var i: i64 = 0
    while i < func.effect_count {
        if hlir_name_eq(func.effects[i as usize], target) {
            return true
        }
        i = i + 1
    }
    false
}

// Compute the CompileStrategy for a function based on its return type and effects.
//
// Priority order (highest wins):
//   1. GPU effect     → StrategyGpuKernel
//   2. Prob effect    → StrategyProbabilistic
//   3. Validated<T>   → StrategyAggressive   (proven correct, optimize hard)
//   4. Knowledge<T>   → StrategyPrecisionPreserving  (uncertain, preserve precision)
//   5. Contest/Robust → StrategyInstrumented  (reducible uncertainty, dual-path)
//   6. otherwise      → StrategyStandard
pub fn hlir_compute_strategy(func: HlirFunction) -> CompileStrategy with Mut, Panic, Div {
    // Effect-based strategies take priority
    if hlir_func_has_effect_named(func, "GPU") {
        return CompileStrategy::StrategyGpuKernel
    }
    if hlir_func_has_effect_named(func, "Prob") {
        return CompileStrategy::StrategyProbabilistic
    }

    // Return-type-based strategies
    let rk = func.return_type.kind
    if rk == HlirTypeKind::HlirTypeValidated {
        return CompileStrategy::StrategyAggressive
    }
    if rk == HlirTypeKind::HlirTypeKnowledge {
        return CompileStrategy::StrategyPrecisionPreserving
    }
    if rk == HlirTypeKind::HlirTypeContest || rk == HlirTypeKind::HlirTypeRobust {
        return CompileStrategy::StrategyInstrumented
    }

    CompileStrategy::StrategyStandard
}

// ============================================================================
// Composite construction helpers
// ============================================================================

// Build a tuple value from an array of element values.
pub fn hlir_lower_tuple(state: HlirLowerState, elem_vals: [i64; 64], elem_count: i64, tuple_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, tuple_ty)

    var instr = hlir_instr_new(HLIR_OP_TUPLE)
    instr.result = result
    instr.ty = tuple_ty
    instr.elems = elem_vals
    instr.elem_count = elem_count
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// Build an array value from an array of element values.
pub fn hlir_lower_array(state: HlirLowerState, elem_vals: [i64; 64], elem_count: i64, array_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, array_ty)

    var instr = hlir_instr_new(HLIR_OP_ARRAY)
    instr.result = result
    instr.ty = array_ty
    instr.elems = elem_vals
    instr.elem_count = elem_count
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// Build a struct value from named fields.
pub fn hlir_lower_struct_lit(state: HlirLowerState, struct_name: string, fields: [HlirStructFieldEntry; 128], field_count: i64, struct_ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    let val_pair = hlir_builder_fresh_value(s.builder)
    s.builder = val_pair.0
    let result = val_pair.1
    s.builder.func = hlir_function_register_local(s.builder.func, result, struct_ty)

    var instr = hlir_instr_new(HLIR_OP_STRUCT)
    instr.result = result
    instr.ty = struct_ty
    instr.struct_name = hlir_name_from_str(struct_name)
    instr.struct_fields = fields
    instr.struct_field_count = field_count
    s.builder = hlir_builder_emit(s.builder, instr)
    (s, result)
}

// ============================================================================
// Fresh value and block IDs — exposed for callers that need raw IDs
// ============================================================================

// Allocate a fresh SSA value ID.
pub fn hlir_lower_fresh_value(state: HlirLowerState) -> (HlirLowerState, i64) with Mut {
    var s = state
    let pair = hlir_builder_fresh_value(s.builder)
    s.builder = pair.0
    let val = pair.1
    (s, val)
}

// Get the current block ID.
pub fn hlir_lower_current_block(state: HlirLowerState) -> i64 {
    hlir_builder_current_block(state.builder)
}

// ============================================================================
// Query helpers
// ============================================================================

// Check if we are currently inside a loop.
pub fn hlir_lower_in_loop(state: HlirLowerState) -> bool {
    state.loop_depth > 0
}

// Check if we are currently inside a function.
pub fn hlir_lower_in_function(state: HlirLowerState) -> bool {
    state.in_function
}

// Get the error count.
pub fn hlir_lower_error_count(state: HlirLowerState) -> i64 {
    state.error_count
}

// ============================================================================
// Match lowering support
//
// Match expressions in SSA form require one block per arm plus a merge block.
// ============================================================================

pub struct HlirMatchArmInfo {
    block_id: i64,         // Block for this arm's body
    value_id: i64,         // Value produced by this arm (-1 = not yet filled)
    exit_block: i64,       // Block that this arm exits from
}

pub fn hlir_match_arm_info_empty() -> HlirMatchArmInfo {
    HlirMatchArmInfo {
        block_id: HLIR_INVALID_BLOCK,
        value_id: HLIR_INVALID_VALUE,
        exit_block: HLIR_INVALID_BLOCK,
    }
}

// Begin a match expression: creates a default block and a merge block.
pub struct HlirMatchBeginResult {
    state: HlirLowerState,
    default_block: i64,
    merge_block: i64,
}

pub fn hlir_lower_match_begin(state: HlirLowerState) -> HlirMatchBeginResult with Mut, Panic, Div {
    var s = state

    let default_pair = hlir_lower_new_block(s, "match.default")
    s = default_pair.0
    let default_block = default_pair.1

    let merge_pair = hlir_lower_new_block(s, "match.merge")
    s = merge_pair.0
    let merge_block = merge_pair.1

    HlirMatchBeginResult {
        state: s,
        default_block: default_block,
        merge_block: merge_block,
    }
}

// Create a block for a match arm.
pub fn hlir_lower_match_arm_block(state: HlirLowerState, arm_index: i64) -> (HlirLowerState, i64) with Mut, Panic, Div {
    // Use a generic label; arm_index is for documentation only
    hlir_lower_new_block(state, "match.arm")
}

// Merge match arms: emit a phi node collecting values from all arms.
pub fn hlir_lower_match_merge(state: HlirLowerState, merge_block: i64, arm_infos: [HlirMatchArmInfo; 64], arm_count: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic, Div {
    var s = state
    s = hlir_lower_switch_to_block(s, merge_block)

    // Build phi entries from arm info
    var entries: [HlirPhiEntry; 64] = [hlir_phi_entry_empty(); 64]
    var valid_count: i64 = 0
    var i: i64 = 0
    while i < arm_count {
        if arm_infos[i as usize].value_id != HLIR_INVALID_VALUE {
            entries[valid_count as usize] = HlirPhiEntry {
                block_id: arm_infos[i as usize].exit_block,
                value_id: arm_infos[i as usize].value_id,
            }
            valid_count = valid_count + 1
        }
        i = i + 1
    }

    if valid_count > 0 {
        hlir_lower_phi(s, entries, valid_count, ty)
    } else {
        (s, HLIR_INVALID_VALUE)
    }
}

// ============================================================================
// For-loop lowering (syntactic sugar over while)
//
// Structure:
//   init_block:   evaluate iterator/range init
//   header_block: check loop condition
//   body_block:   loop body
//   step_block:   increment/advance, branch to header
//   exit_block:   after loop
// ============================================================================

pub struct HlirForResult {
    state: HlirLowerState,
    header_block: i64,
    body_block: i64,
    step_block: i64,
    exit_block: i64,
}

pub fn hlir_lower_for_begin(state: HlirLowerState) -> HlirForResult with Mut, Panic, Div {
    var s = state

    let header_pair = hlir_lower_new_block(s, "for.header")
    s = header_pair.0
    let header_block = header_pair.1

    let body_pair = hlir_lower_new_block(s, "for.body")
    s = body_pair.0
    let body_block = body_pair.1

    let step_pair = hlir_lower_new_block(s, "for.step")
    s = step_pair.0
    let step_block = step_pair.1

    let exit_pair = hlir_lower_new_block(s, "for.exit")
    s = exit_pair.0
    let exit_block = exit_pair.1

    // Branch from current block to header
    s = hlir_lower_branch(s, header_block)

    // Push loop context: continue goes to step, break goes to exit
    if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
        s.loop_continue_stack[s.loop_depth as usize] = s.loop_continue_block
        s.loop_break_stack[s.loop_depth as usize] = s.loop_break_block
    }
    s.loop_continue_block = step_block
    s.loop_break_block = exit_block
    s.loop_depth = s.loop_depth + 1

    HlirForResult {
        state: s,
        header_block: header_block,
        body_block: body_block,
        step_block: step_block,
        exit_block: exit_block,
    }
}

pub fn hlir_lower_for_end(state: HlirLowerState, header_block: i64, body_block: i64, step_block: i64, exit_block: i64) -> HlirLowerState with Mut, Panic {
    var s = state

    // Pop loop context
    s.loop_depth = s.loop_depth - 1
    if s.loop_depth >= 0 {
        if s.loop_depth < HLIR_LOWER_MAX_LOOP_DEPTH {
            s.loop_continue_block = s.loop_continue_stack[s.loop_depth as usize]
            s.loop_break_block = s.loop_break_stack[s.loop_depth as usize]
        }
    } else {
        s.loop_continue_block = HLIR_LOWER_NO_LOOP
        s.loop_break_block = HLIR_LOWER_NO_LOOP
    }

    // Switch to exit block for subsequent code
    s = hlir_lower_switch_to_block(s, exit_block)
    s
}

// ============================================================================
// Block expression lowering
//
// A block in Sounio evaluates a sequence of statements and returns the
// value of the last expression. In SSA, this maps to sequential emission
// with the final value being the block's result.
// ============================================================================

// Begin a block expression (push scope, no new basic block needed
// unless the block requires one).
pub fn hlir_lower_begin_block_expr(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    hlir_lower_push_scope(state)
}

// End a block expression (pop scope). The result value is passed through.
pub fn hlir_lower_end_block_expr(state: HlirLowerState, result_val: i64) -> (HlirLowerState, i64) with Mut {
    let s = hlir_lower_pop_scope(state)
    (s, result_val)
}

// ============================================================================
// Diagnostic: dump state summary (for debugging the lowering)
// ============================================================================

pub fn hlir_lower_state_summary(state: HlirLowerState) -> HlirLowerStateSummary {
    HlirLowerStateSummary {
        function_count: state.module_builder.module.fn_count,
        global_count: state.module_builder.module.global_count,
        typedef_count: state.module_builder.module.typedef_count,
        error_count: state.error_count,
        in_function: state.in_function,
        loop_depth: state.loop_depth,
        scope_depth: state.builder.scope_depth,
        current_block: state.builder.current_block,
        next_value_id: state.builder.next_value_id,
        next_block_id: state.builder.next_block_id,
    }
}

pub struct HlirLowerStateSummary {
    function_count: i64,
    global_count: i64,
    typedef_count: i64,
    error_count: i64,
    in_function: bool,
    loop_depth: i64,
    scope_depth: i64,
    current_block: i64,
    next_value_id: i64,
    next_block_id: i64,
}

// ============================================================================
// Convenience: full if-then-else lowering with block bodies
//
// This orchestrates the complete pattern for if/else where the caller
// will emit code into the then_block and else_block.
//
// Usage:
//   1. Lower the condition expression to get cond_val
//   2. Call hlir_lower_if_begin to get block IDs
//   3. Switch to then_block, emit then code, call hlir_lower_if_then_done
//   4. Switch to else_block, emit else code, call hlir_lower_if_else_done
//   5. Call hlir_lower_if_finish to merge
// ============================================================================

pub struct HlirIfBeginResult {
    state: HlirLowerState,
    then_block: i64,
    else_block: i64,
    merge_block: i64,
}

pub fn hlir_lower_if_begin(state: HlirLowerState, cond_val: i64) -> HlirIfBeginResult with Mut, Panic, Div {
    let result = hlir_lower_if_branch(state, cond_val)
    HlirIfBeginResult {
        state: result.state,
        then_block: result.then_block,
        else_block: result.else_block,
        merge_block: result.merge_block,
    }
}

// Called after emitting then-block code. Emits branch to merge and returns
// the exit block ID and result value.
pub fn hlir_lower_if_then_done(state: HlirLowerState, merge_block: i64, then_val: i64) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let exit_block = hlir_lower_current_block(s)
    s = hlir_lower_branch(s, merge_block)
    (s, exit_block)
}

// Called after emitting else-block code. Emits branch to merge and returns
// the exit block ID and result value.
pub fn hlir_lower_if_else_done(state: HlirLowerState, merge_block: i64, else_val: i64) -> (HlirLowerState, i64) with Mut, Panic {
    var s = state
    let exit_block = hlir_lower_current_block(s)
    s = hlir_lower_branch(s, merge_block)
    (s, exit_block)
}

// Finish the if-else: switch to merge block and optionally emit phi.
pub fn hlir_lower_if_finish(state: HlirLowerState, merge_block: i64, then_exit: i64, then_val: i64, else_exit: i64, else_val: i64, ty: HlirType) -> (HlirLowerState, i64) with Mut, Panic {
    hlir_lower_if_merge(state, merge_block, then_exit, then_val, else_exit, else_val, ty)
}

// ============================================================================
// Convenience: void if (no else, no result value)
// ============================================================================

pub struct HlirIfVoidResult {
    state: HlirLowerState,
    then_block: i64,
    merge_block: i64,
}

pub fn hlir_lower_if_void_begin(state: HlirLowerState, cond_val: i64) -> HlirIfVoidResult with Mut, Panic, Div {
    var s = state

    let then_pair = hlir_lower_new_block(s, "if.then")
    s = then_pair.0
    let then_block = then_pair.1

    let merge_pair = hlir_lower_new_block(s, "if.merge")
    s = merge_pair.0
    let merge_block = merge_pair.1

    // Emit conditional branch: if cond -> then, else -> merge
    s = hlir_lower_cond_branch(s, cond_val, then_block, merge_block)

    HlirIfVoidResult {
        state: s,
        then_block: then_block,
        merge_block: merge_block,
    }
}

pub fn hlir_lower_if_void_end(state: HlirLowerState, merge_block: i64) -> HlirLowerState with Mut, Panic {
    var s = state
    // Branch from then (current) to merge
    s = hlir_lower_branch(s, merge_block)
    // Switch to merge
    s = hlir_lower_switch_to_block(s, merge_block)
    s
}

// ============================================================================
// Module-level state: set the module name
// ============================================================================

pub fn hlir_lower_set_module_name(state: HlirLowerState, name: string) -> HlirLowerState with Mut, Panic, Div {
    var s = state
    s.module_builder.module.name = hlir_name_from_str(name)
    s
}

// ============================================================================
// Convenience: emit multiple instructions sequentially
// ============================================================================

// Emit a raw instruction into the current block. For advanced users who
// construct HlirInstr manually.
pub fn hlir_lower_emit_raw(state: HlirLowerState, instr: HlirInstr) -> HlirLowerState with Mut, Panic {
    var s = state
    s.builder = hlir_builder_emit(s.builder, instr)
    s
}

// ============================================================================
// Variable lookup by HlirName (for callers that already have the name)
// ============================================================================

pub fn hlir_lower_lookup_var(state: HlirLowerState, name: HlirName) -> i64 {
    hlir_builder_lookup_var(state.builder, name)
}

pub fn hlir_lower_lookup_slot(state: HlirLowerState, name: HlirName) -> i64 {
    hlir_builder_lookup_slot(state.builder, name)
}

// ============================================================================
// Offload-spec compatibility shims
// ============================================================================
// These wrappers preserve the existing lowering architecture while exposing
// the naming surface used by offload scaffold specs.

pub fn hlir_scope_push(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
    hlir_lower_push_scope(state)
}

pub fn hlir_scope_pop(state: HlirLowerState) -> HlirLowerState with Mut {
    hlir_lower_pop_scope(state)
}

pub fn hlir_scope_insert(state: HlirLowerState, name_hash: i64, value_id: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    let pseudo_name = hlir_name_from_str("v_" ++ hlir_i64_to_string(name_hash))
    s.builder = hlir_builder_bind_var(s.builder, pseudo_name, value_id)
    s
}

pub fn hlir_scope_lookup(state: HlirLowerState, name_hash: i64) -> i64 with Mut, Panic, Div, Alloc {
    let pseudo_name = hlir_name_from_str("v_" ++ hlir_i64_to_string(name_hash))
    hlir_builder_lookup_var(state.builder, pseudo_name)
}

pub fn hlir_lower_seal_block(state: HlirLowerState) -> HlirLowerState {
    // Current builder model does not require explicit block sealing.
    state
}

// ============================================================================
// AST/HIR compatibility layer (spec-facing entry points)
// ============================================================================

pub fn hlir_ast_name_to_string(name: Name) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(name.buf, name.len)
}

pub fn hlir_ast_path_head_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(path.segments.head_buf, path.segments.head_len)
}

fn hlir_type_code_from_type(ty: HlirType) -> i64 {
    if ty.kind == HlirTypeKind::HlirTypeBool { return HLIR_TYPE_CODE_BOOL }
    if ty.kind == HlirTypeKind::HlirTypeI8 { return HLIR_TYPE_CODE_I8 }
    if ty.kind == HlirTypeKind::HlirTypeI16 { return HLIR_TYPE_CODE_I16 }
    if ty.kind == HlirTypeKind::HlirTypeI32 { return HLIR_TYPE_CODE_I32 }
    if ty.kind == HlirTypeKind::HlirTypeI64 { return HLIR_TYPE_CODE_I64 }
    if ty.kind == HlirTypeKind::HlirTypeU8 { return HLIR_TYPE_CODE_U8 }
    if ty.kind == HlirTypeKind::HlirTypeU16 { return HLIR_TYPE_CODE_U16 }
    if ty.kind == HlirTypeKind::HlirTypeU32 { return HLIR_TYPE_CODE_U32 }
    if ty.kind == HlirTypeKind::HlirTypeU64 { return HLIR_TYPE_CODE_U64 }
    if ty.kind == HlirTypeKind::HlirTypeF32 { return HLIR_TYPE_CODE_F32 }
    if ty.kind == HlirTypeKind::HlirTypeF64 { return HLIR_TYPE_CODE_F64 }
    if ty.kind == HlirTypeKind::HlirTypeOctonion { return HLIR_TYPE_CODE_OCTONION }
    if ty.kind == HlirTypeKind::HlirTypeSedenion { return HLIR_TYPE_CODE_SEDENION }
    HLIR_TYPE_CODE_NONE
}

fn hlir_type_from_code(code: i64) -> HlirType {
    if code == HLIR_TYPE_CODE_BOOL { return hlir_type_bool() }
    if code == HLIR_TYPE_CODE_I8 { return hlir_type_i8() }
    if code == HLIR_TYPE_CODE_I16 { return hlir_type_i16() }
    if code == HLIR_TYPE_CODE_I32 { return hlir_type_i32() }
    if code == HLIR_TYPE_CODE_I64 { return hlir_type_i64() }
    if code == HLIR_TYPE_CODE_U8 { return hlir_type_u8() }
    if code == HLIR_TYPE_CODE_U16 { return hlir_type_u16() }
    if code == HLIR_TYPE_CODE_U32 { return hlir_type_u32() }
    if code == HLIR_TYPE_CODE_U64 { return hlir_type_u64() }
    if code == HLIR_TYPE_CODE_F32 { return hlir_type_f32() }
    if code == HLIR_TYPE_CODE_F64 { return hlir_type_f64() }
    if code == HLIR_TYPE_CODE_OCTONION { return hlir_type_octonion() }
    if code == HLIR_TYPE_CODE_SEDENION { return hlir_type_sedenion() }
    hlir_type_void()
}

fn hlir_type_with_element(base: HlirType, elem: HlirType) -> HlirType with Mut {
    var out = base
    let code = hlir_type_code_from_type(elem)
    if code != HLIR_TYPE_CODE_NONE {
        out.type_elem_count = 1
        out.type_elems[0] = code
    }
    out
}

fn hlir_type_element_or_void(ty: HlirType) -> HlirType {
    if ty.type_elem_count > 0 {
        return hlir_type_from_code(ty.type_elems[0])
    }
    hlir_type_void()
}

fn hlir_type_element_or_i64(ty: HlirType) -> HlirType {
    let elem = hlir_type_element_or_void(ty)
    if elem.kind != HlirTypeKind::HlirTypeVoid {
        return elem
    }
    hlir_type_i64()
}

pub fn hlir_type_from_ast(ty: TypeExpr) -> HlirType with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeUnit {
        return hlir_type_void()
    }
    if ty.kind == TypeExprKind::TypeKnowledge {
        return hlir_type_knowledge()
    }
    if ty.kind == TypeExprKind::TypeContest {
        return hlir_type_contest()
    }
    if ty.kind == TypeExprKind::TypeRobust {
        return hlir_type_robust()
    }
    if ty.kind == TypeExprKind::TypeValidated {
        return hlir_type_validated()
    }
    if ty.kind == TypeExprKind::TypeNamed {
        let tname = hlir_ast_path_head_to_string(ty.path)
        if tname == "i8" { return hlir_type_i8() }
        if tname == "i16" { return hlir_type_i16() }
        if tname == "i32" { return hlir_type_i32() }
        if tname == "i64" { return hlir_type_i64() }
        if tname == "u8" { return hlir_type_u8() }
        if tname == "u16" { return hlir_type_u16() }
        if tname == "u32" { return hlir_type_u32() }
        if tname == "u64" { return hlir_type_u64() }
        if tname == "f32" { return hlir_type_f32() }
        if tname == "f64" { return hlir_type_f64() }
        if tname == "bool" { return hlir_type_bool() }
        if tname == "unit" { return hlir_type_void() }
        // First-class hypercomplex: Hyper<Octonion, f64> → HlirTypeOctonion (8× f64).
        // (a `&Hyper<Octonion,f64>` param then becomes ptr-with-octonion-element via the
        // TypeReference branch below, so the GPU lowering can recognize `*pa` / `a*h`.)
        if tname == "Hyper" {
            match ty.type_args {
                Some(args) => {
                    let alg_name = hlir_ast_path_head_to_string((*args).head.path)
                    // The only material contract currently defined is f64.
                    // Keep every other scalar type out of these f64-only HLIR
                    // kinds until it has its own opcode and backend ABI.
                    match (*args).tail {
                        Some(scalar_args) => {
                            let scalar_name = hlir_ast_path_head_to_string((*scalar_args).head.path)
                            if scalar_name == "f64" {
                                if alg_name == "Octonion" { return hlir_type_octonion() }
                                if alg_name == "Sedenion" { return hlir_type_sedenion() }
                            }
                        }
                        None => {}
                    }
                }
                None => {}
            }
        }
    }
    if ty.kind == TypeExprKind::TypeArray {
        match ty.inner {
            Some(elem) => {
                let elem_ty = hlir_type_from_ast(*elem)
                return hlir_type_with_element(hlir_type_array(-1, 0), elem_ty)
            }
            None => return hlir_type_array(-1, 0),
        }
    }
    if ty.kind == TypeExprKind::TypeReference || ty.kind == TypeExprKind::TypeRefMut {
        match ty.inner {
            Some(inner) => {
                let inner_ty = *inner
                let elem_ty = if inner_ty.kind == TypeExprKind::TypeArray {
                    match inner_ty.inner {
                        Some(elem) => hlir_type_from_ast(*elem),
                        None => hlir_type_i64(),
                    }
                } else {
                    hlir_type_from_ast(inner_ty)
                }
                return hlir_type_with_element(hlir_type_ptr(-1), elem_ty)
            }
            None => return hlir_type_ptr(-1),
        }
    }
    // Conservative fallback for unsupported/unknown AST types.
    hlir_type_i64()
}

pub fn hlir_type_from_ast_opt(ty: Option<Box<TypeExpr>>) -> HlirType with Mut, Panic, Div, Alloc {
    match ty {
        Some(t) => hlir_type_from_ast(*t),
        None => hlir_type_void(),
    }
}

pub fn hlir_ast_binary_to_hlir(op: BinaryOp) -> i64 {
    match op {
        BinaryOp::OpAdd => HLIR_BIN_ADD,
        BinaryOp::OpSub => HLIR_BIN_SUB,
        BinaryOp::OpMul => HLIR_BIN_MUL,
        BinaryOp::OpDiv => HLIR_BIN_SDIV,
        BinaryOp::OpRem => HLIR_BIN_SREM,
        BinaryOp::OpEq => HLIR_BIN_EQ,
        BinaryOp::OpNe => HLIR_BIN_NE,
        BinaryOp::OpLt => HLIR_BIN_SLT,
        BinaryOp::OpLe => HLIR_BIN_SLE,
        BinaryOp::OpGt => HLIR_BIN_SGT,
        BinaryOp::OpGe => HLIR_BIN_SGE,
        BinaryOp::OpAnd => HLIR_BIN_AND,
        BinaryOp::OpOr => HLIR_BIN_OR,
        BinaryOp::OpBitAnd => HLIR_BIN_AND,
        BinaryOp::OpBitOr => HLIR_BIN_OR,
        BinaryOp::OpBitXor => HLIR_BIN_XOR,
        BinaryOp::OpShl => HLIR_BIN_SHL,
        BinaryOp::OpShr => HLIR_BIN_ASHR,
        BinaryOp::OpConcat => HLIR_BIN_CONCAT,
        _ => HLIR_BIN_ADD,
    }
}

pub fn hlir_ast_binary_to_hlir_typed(op: BinaryOp, lhs_ty: HlirType, rhs_ty: HlirType) -> i64 {
    let is_float = lhs_ty.kind == HlirTypeKind::HlirTypeF32 || lhs_ty.kind == HlirTypeKind::HlirTypeF64 ||
                   rhs_ty.kind == HlirTypeKind::HlirTypeF32 || rhs_ty.kind == HlirTypeKind::HlirTypeF64
    if is_float {
        if op == BinaryOp::OpAdd { return HLIR_BIN_FADD }
        if op == BinaryOp::OpSub { return HLIR_BIN_FSUB }
        if op == BinaryOp::OpMul { return HLIR_BIN_FMUL }
        if op == BinaryOp::OpDiv { return HLIR_BIN_FDIV }
        if op == BinaryOp::OpRem { return HLIR_BIN_FREM }
        if op == BinaryOp::OpEq { return HLIR_BIN_FOEQ }
        if op == BinaryOp::OpNe { return HLIR_BIN_FONE }
        if op == BinaryOp::OpLt { return HLIR_BIN_FOLT }
        if op == BinaryOp::OpLe { return HLIR_BIN_FOLE }
        if op == BinaryOp::OpGt { return HLIR_BIN_FOGT }
        if op == BinaryOp::OpGe { return HLIR_BIN_FOGE }
    }
    hlir_ast_binary_to_hlir(op)
}

pub fn hlir_ast_binary_result_ty(op: BinaryOp) -> HlirType {
    if op == BinaryOp::OpEq
    || op == BinaryOp::OpNe
    || op == BinaryOp::OpLt
    || op == BinaryOp::OpLe
    || op == BinaryOp::OpGt
    || op == BinaryOp::OpGe
    || op == BinaryOp::OpAnd
    || op == BinaryOp::OpOr {
        return hlir_type_bool()
    }
    hlir_type_i64()
}

pub fn hlir_ast_binary_result_ty_typed(op: BinaryOp, lhs_ty: HlirType, rhs_ty: HlirType) -> HlirType {
    if op == BinaryOp::OpEq
    || op == BinaryOp::OpNe
    || op == BinaryOp::OpLt
    || op == BinaryOp::OpLe
    || op == BinaryOp::OpGt
    || op == BinaryOp::OpGe
    || op == BinaryOp::OpAnd
    || op == BinaryOp::OpOr {
        return hlir_type_bool()
    }
    if lhs_ty.kind == HlirTypeKind::HlirTypeF64 || rhs_ty.kind == HlirTypeKind::HlirTypeF64 {
        return hlir_type_f64()
    }
    if lhs_ty.kind == HlirTypeKind::HlirTypeF32 || rhs_ty.kind == HlirTypeKind::HlirTypeF32 {
        return hlir_type_f32()
    }
    hlir_ast_binary_result_ty(op)
}

pub fn hlir_ast_unary_to_hlir(op: UnaryOp) -> i64 {
    match op {
        UnaryOp::OpNot => HLIR_UNARY_NOT,
        _ => HLIR_UNARY_NEG,
    }
}

pub fn hlir_ast_name_hash(name: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 0
    var i: i64 = 0
    while i < name.len {
        h = h * 33 + (name.buf[i as usize] as i64)
        i = i + 1
    }
    if h < 0 { 0 - h } else { h }
}

pub fn hlir_lower_expr_opt(state: HlirLowerState, expr: Option<Box<Expr>>) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    match expr {
        Some(e) => hlir_lower_expr(state, *e),
        None => hlir_lower_unit(state),
    }
}

pub fn hlir_lower_expr_list(
    state: HlirLowerState,
    list: Option<Box<ExprList>>,
    values: [i64; 64],
    count: i64,
) -> HlirExprListResult with Mut, Panic, Div, Alloc {
    match list {
        Some(node) => {
            var s = state
            var out = values
            let next_count = if count < 64 { count + 1 } else { count }
            let expr_pair = hlir_lower_expr(s, (*node).head)
            s = expr_pair.0
            if count < 64 {
                out[count as usize] = expr_pair.1
            }
            hlir_lower_expr_list(s, (*node).tail, out, next_count)
        }
        None => HlirExprListResult { state: state, values: values, count: count },
    }
}

pub fn hlir_lower_field_access(state: HlirLowerState, base: i64, field: i64) -> (HlirLowerState, i64) with Mut, Panic {
    let ptr_pair = hlir_lower_get_field_ptr(state, base, field, hlir_type_ptr(-1))
    hlir_lower_load(ptr_pair.0, ptr_pair.1, hlir_type_i64())
}

fn hlir_lower_value_type(state: HlirLowerState, value_id: i64) -> HlirType {
    hlir_function_lookup_local_type(state.builder.func, value_id)
}

fn hlir_lower_index_elem_type(state: HlirLowerState, base: i64) -> HlirType {
    let base_ty = hlir_lower_value_type(state, base)
    hlir_type_element_or_i64(base_ty)
}

fn hlir_lower_store_index_elem_type(state: HlirLowerState, base: i64, value_id: i64) -> HlirType {
    let base_ty = hlir_lower_value_type(state, base)
    let elem_ty = hlir_type_element_or_void(base_ty)
    if elem_ty.kind != HlirTypeKind::HlirTypeVoid {
        return elem_ty
    }
    let value_ty = hlir_lower_value_type(state, value_id)
    if value_ty.kind != HlirTypeKind::HlirTypeVoid {
        return value_ty
    }
    hlir_type_i64()
}

pub fn hlir_lower_index(state: HlirLowerState, base: i64, index: i64) -> (HlirLowerState, i64) with Mut, Panic {
    let elem_ty = hlir_lower_index_elem_type(state, base)
    let ptr_pair = hlir_lower_gep(state, base, index, elem_ty)
    hlir_lower_load(ptr_pair.0, ptr_pair.1, elem_ty)
}

pub fn hlir_lower_literal(state: HlirLowerState, lit: Expr) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    if lit.kind == ExprKind::ExprIntLit {
        return hlir_lower_literal_int(state, lit.int_val, hlir_type_i64())
    }
    if lit.kind == ExprKind::ExprFloatLit {
        return hlir_lower_literal_float(state, lit.float_val, hlir_type_f64())
    }
    if lit.kind == ExprKind::ExprBoolTrue {
        return hlir_lower_literal_bool(state, true)
    }
    if lit.kind == ExprKind::ExprBoolFalse {
        return hlir_lower_literal_bool(state, false)
    }
    if lit.kind == ExprKind::ExprCharLit {
        return hlir_lower_literal_int(state, lit.int_val, hlir_type_i64())
    }
    if lit.kind == ExprKind::ExprStringLit {
        return hlir_lower_literal_string(state, hlir_ast_name_to_string(lit.name))
    }
    hlir_lower_unit(state)
}

fn hlir_gpu_axis_root(e: Expr) -> bool with Alloc, Div, Mut, Panic {
    e.kind == ExprKind::ExprIdent && hlir_ast_name_to_string(e.name) == "gpu"
}

fn hlir_gpu_axis_flat_name(e: Expr) -> string with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprFieldAccess {
        return ""
    }
    if hlir_ast_name_to_string(e.name) != "x" {
        return ""
    }
    match e.left {
        Some(base) => {
            if (*base).kind == ExprKind::ExprFieldAccess {
                match (*base).left {
                    Some(root) => {
                        if hlir_gpu_axis_root(*root) {
                            let axis_name = hlir_ast_name_to_string((*base).name)
                            if axis_name == "thread_id" { return "gpu_thread_id_x" }
                            if axis_name == "block_id" { return "gpu_block_id_x" }
                            if axis_name == "block_dim" { return "gpu_block_dim_x" }
                        }
                    }
                    None => {}
                }
            } else if (*base).kind == ExprKind::ExprMethodCall {
                match (*base).left {
                    Some(root2) => {
                        if hlir_gpu_axis_root(*root2) {
                            let axis_method = hlir_ast_name_to_string((*base).name)
                            if axis_method == "thread_id" { return "gpu_thread_id_x" }
                            if axis_method == "block_id" { return "gpu_block_id_x" }
                            if axis_method == "block_dim" { return "gpu_block_dim_x" }
                        }
                    }
                    None => {}
                }
            }
        }
        None => {}
    }
    ""
}

pub fn hlir_lower_match(state: HlirLowerState, scrutinee: i64, arms: Option<Box<MatchArmList>>) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    // Minimal bridge implementation: lower first arm body if present.
    // Full pattern dispatch is handled by match_begin/match_merge APIs.
    match arms {
        Some(list) => hlir_lower_expr(state, (*list).head.body),
        None => hlir_lower_unit(state),
    }
}

pub fn hlir_lower_assign_target(state: HlirLowerState, target: Expr, value_id: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    if target.kind == ExprKind::ExprIdent {
        let target_name = hlir_ast_name_to_string(target.name)
        return hlir_lower_assign(s, target_name, value_id)
    }
    if target.kind == ExprKind::ExprFieldAccess {
        let base_pair = hlir_lower_expr_opt(s, target.left)
        s = base_pair.0
        let base_val = base_pair.1
        let field_idx = hlir_ast_name_hash(target.name) % 16
        let field_ptr_pair = hlir_lower_get_field_ptr(s, base_val, field_idx, hlir_type_i64())
        s = field_ptr_pair.0
        return hlir_lower_store(s, field_ptr_pair.1, value_id)
    }
    if target.kind == ExprKind::ExprIndex {
        let base_pair = hlir_lower_expr_opt(s, target.left)
        s = base_pair.0
        let base_val = base_pair.1
        let idx_pair = hlir_lower_expr_opt(s, target.right)
        s = idx_pair.0
        let idx_val = idx_pair.1
        let elem_ty = hlir_lower_store_index_elem_type(s, base_val, value_id)
        let elem_ptr_pair = hlir_lower_gep(s, base_val, idx_val, elem_ty)
        s = elem_ptr_pair.0
        return hlir_lower_store(s, elem_ptr_pair.1, value_id)
    }
    hlir_lower_report_error(s)
}

pub fn hlir_lower_stmt(state: HlirLowerState, stmt: Stmt) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    if stmt.kind == StmtKind::StmtLet {
        let init_pair = hlir_lower_expr_opt(s, stmt.expr)
        s = init_pair.0
        let name = hlir_ast_name_to_string(stmt.name)
        let ty = hlir_type_from_ast_opt(stmt.ty)
        return hlir_lower_let(s, name, ty, init_pair.1)
    }
    if stmt.kind == StmtKind::StmtVar {
        let init_pair = hlir_lower_expr_opt(s, stmt.expr)
        s = init_pair.0
        let name = hlir_ast_name_to_string(stmt.name)
        let ty = hlir_type_from_ast_opt(stmt.ty)
        return hlir_lower_var(s, name, ty, init_pair.1)
    }
    if stmt.kind == StmtKind::StmtAssign {
        match stmt.target {
            Some(t) => {
                let target_expr = *t
                if target_expr.kind == ExprKind::ExprFieldAccess {
                    let base_pair = hlir_lower_expr_opt(s, target_expr.left)
                    s = base_pair.0
                    let base_val = base_pair.1
                    let field_idx = hlir_ast_name_hash(target_expr.name) % 16
                    let field_ptr_pair = hlir_lower_get_field_ptr(s, base_val, field_idx, hlir_type_i64())
                    s = field_ptr_pair.0
                    let ptr_val = field_ptr_pair.1
                    let rhs_pair = hlir_lower_expr_opt(s, stmt.expr)
                    s = rhs_pair.0
                    let rhs_val = rhs_pair.1
                    return hlir_lower_store(s, ptr_val, rhs_val)
                }
                if target_expr.kind == ExprKind::ExprIndex {
                    let base_pair = hlir_lower_expr_opt(s, target_expr.left)
                    s = base_pair.0
                    let base_val = base_pair.1
                    let idx_pair = hlir_lower_expr_opt(s, target_expr.right)
                    s = idx_pair.0
                    let idx_val = idx_pair.1
                    let elem_ty = hlir_lower_index_elem_type(s, base_val)
                    let elem_ptr_pair = hlir_lower_gep(s, base_val, idx_val, elem_ty)
                    s = elem_ptr_pair.0
                    let ptr_val = elem_ptr_pair.1
                    let rhs_pair = hlir_lower_expr_opt(s, stmt.expr)
                    s = rhs_pair.0
                    let rhs_val = rhs_pair.1
                    return hlir_lower_store(s, ptr_val, rhs_val)
                }
                let rhs_pair = hlir_lower_expr_opt(s, stmt.expr)
                s = rhs_pair.0
                let rhs_val = rhs_pair.1
                // Store an octonion through a pointer: `*pout = ah` where pout:&!Hyper<Octonion,f64>
                // and ah is an octonion repr → write its 8 f64 components.
                if target_expr.kind == ExprKind::ExprUnary && target_expr.un_op == UnaryOp::OpDeref && hlir_oct_is(s, rhs_val) {
                    let dptr_pair = hlir_lower_expr_opt(s, target_expr.left)
                    s = dptr_pair.0
                    return hlir_oct_store(s, dptr_pair.1, rhs_val)
                }
                hlir_lower_assign_target(s, target_expr, rhs_val)
            },
            None => hlir_lower_report_error(s),
        }
    }
    if stmt.kind == StmtKind::StmtExpr {
        let expr_pair = hlir_lower_expr_opt(s, stmt.expr)
        return expr_pair.0
    }
    s
}

pub fn hlir_lower_stmt_list(state: HlirLowerState, stmts: Option<Box<StmtList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
    match stmts {
        Some(list) => {
            let s1 = hlir_lower_stmt(state, (*list).head)
            hlir_lower_stmt_list(s1, (*list).tail)
        }
        None => state,
    }
}

pub fn hlir_lower_block_from_ast(state: HlirLowerState, block: Block) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = hlir_scope_push(state)
    s = hlir_lower_stmt_list(s, block.stmts)
    s = hlir_scope_pop(s)
    s
}

pub fn hlir_lower_struct_field_values(state: HlirLowerState, fields: Option<Box<StructFieldList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
    match fields {
        Some(list) => {
            let value_pair = hlir_lower_expr(state, (*list).head.value)
            hlir_lower_struct_field_values(value_pair.0, (*list).tail)
        }
        None => state,
    }
}

pub fn hlir_lower_expr(state: HlirLowerState, expr: Expr) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
    var s = state

    if expr.kind == ExprKind::ExprIntLit
    || expr.kind == ExprKind::ExprFloatLit
    || expr.kind == ExprKind::ExprBoolTrue
    || expr.kind == ExprKind::ExprBoolFalse
    || expr.kind == ExprKind::ExprCharLit
    || expr.kind == ExprKind::ExprStringLit {
        return hlir_lower_literal(s, expr)
    }

    if expr.kind == ExprKind::ExprIdent {
        let name = hlir_name_from_str(hlir_ast_name_to_string(expr.name))
        return hlir_lower_read_var_named(s, name, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprPath {
        let path_name = hlir_name_from_str(hlir_ast_path_head_to_string(expr.path))
        return hlir_lower_read_var_named(s, path_name, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprBinary {
        let lhs_pair = hlir_lower_expr_opt(s, expr.left)
        s = lhs_pair.0
        let lhs_val = lhs_pair.1
        let rhs_pair = hlir_lower_expr_opt(s, expr.right)
        s = rhs_pair.0
        let rhs_val = rhs_pair.1
        // First-class hypercomplex multiply: both operands are recorded reprs → expand
        // r[i⊕j] += σ(i,j,bits)·a[i]·b[j] over the components (Convention X / cd_sigma).
        // dim/bits come from the operands: octonion (8,3) or sedenion (16,4).
        let checked_algebra = hlir_checked_hyper_mul_algebra(s, expr.span)
        if expr.bin_op == BinaryOp::OpMul && checked_algebra >= 0
            && (!hlir_oct_is(s, lhs_val) || !hlir_oct_is(s, rhs_val)) {
            return (hlir_lower_report_error(s), HLIR_INVALID_VALUE)
        }
        // An unbound aggregate multiply must never become a scalar multiply.
        if expr.bin_op == BinaryOp::OpMul && checked_algebra < 0
            && (hlir_oct_is(s, lhs_val) || hlir_oct_is(s, rhs_val)) {
            return (hlir_lower_report_error(s), HLIR_INVALID_VALUE)
        }
        if expr.bin_op == BinaryOp::OpMul
            && checked_algebra >= 0
            && hlir_oct_is(s, lhs_val)
            && hlir_oct_is(s, rhs_val) {
            let lhs_dim = hlir_oct_dim(s, lhs_val)
            let rhs_dim = hlir_oct_dim(s, rhs_val)
            let bits = if checked_algebra == 4 && lhs_dim == 16 && rhs_dim == 16 { 4 }
                else if checked_algebra == 3 && lhs_dim == 8 && rhs_dim == 8 { 3 }
                else { 0 }
            if bits == 0 {
                return (hlir_lower_report_error(s), HLIR_INVALID_VALUE)
            }
            let contract = hlir_cayley_dickson_xor_convolution(bits)
            return hlir_xor_convolution(s, lhs_val, rhs_val, contract)
        }
        let lhs_ty = hlir_lower_value_type(s, lhs_val)
        let rhs_ty = hlir_lower_value_type(s, rhs_val)
        let op = hlir_ast_binary_to_hlir_typed(expr.bin_op, lhs_ty, rhs_ty)
        let ty = hlir_ast_binary_result_ty_typed(expr.bin_op, lhs_ty, rhs_ty)
        return hlir_lower_binary(s, op, lhs_val, rhs_val, ty)
    }

    if expr.kind == ExprKind::ExprUnary {
        let src_pair = hlir_lower_expr_opt(s, expr.left)
        s = src_pair.0
        // Deref of a hypercomplex pointer (`*pa` where pa: &Hyper<Octonion|Sedenion,f64>) →
        // load the 8/16 f64 components into a fresh repr instead of a scalar deref.
        if expr.un_op == UnaryOp::OpDeref {
            let ptr_ty = hlir_lower_value_type(s, src_pair.1)
            if ptr_ty.kind == HlirTypeKind::HlirTypePtr {
                let elem = hlir_type_element_or_void(ptr_ty)
                if elem.kind == HlirTypeKind::HlirTypeOctonion {
                    return hlir_oct_load(s, src_pair.1, 8)
                }
                if elem.kind == HlirTypeKind::HlirTypeSedenion {
                    return hlir_oct_load(s, src_pair.1, 16)
                }
            }
        }
        let op = hlir_ast_unary_to_hlir(expr.un_op)
        return hlir_lower_unary(s, op, src_pair.1, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprFieldAccess {
        let gpu_axis_name = hlir_gpu_axis_flat_name(expr)
        if gpu_axis_name != "" {
            var no_args: [i64; 64] = [0; 64]
            return hlir_lower_call(s, gpu_axis_name, no_args, 0, hlir_type_i64())
        }
        let base_pair = hlir_lower_expr_opt(s, expr.left)
        s = base_pair.0
        let base_val = base_pair.1
        let field_idx = hlir_ast_name_hash(expr.name) % 16
        return hlir_lower_field_access(s, base_val, field_idx)
    }

    if expr.kind == ExprKind::ExprIndex {
        let base_pair = hlir_lower_expr_opt(s, expr.left)
        s = base_pair.0
        let base_val = base_pair.1
        let idx_pair = hlir_lower_expr_opt(s, expr.right)
        s = idx_pair.0
        let idx_val = idx_pair.1
        return hlir_lower_index(s, base_val, idx_val)
    }

    if expr.kind == ExprKind::ExprCast {
        let src_pair = hlir_lower_expr_opt(s, expr.left)
        s = src_pair.0
        let target_ty = hlir_type_from_ast_opt(expr.cast_type)
        return hlir_lower_cast(s, src_pair.1, hlir_type_i64(), target_ty)
    }

    // ExprContest: Contest<T> intro — zero-cost wrapper, lower the subject (expr.left)
    if expr.kind == ExprKind::ExprContest {
        let sub_pair = hlir_lower_expr_opt(s, expr.left)
        s = sub_pair.0
        return (s, sub_pair.1)
    }

    if expr.kind == ExprKind::ExprAuditAttach {
        let sub_pair = hlir_lower_expr_opt(s, expr.left)
        s = sub_pair.0
        return (s, sub_pair.1)
    }

    if expr.kind == ExprKind::ExprCall {
        var callee = "call"
        match expr.left {
            Some(callee_expr) => {
                if (*callee_expr).kind == ExprKind::ExprIdent {
                    callee = hlir_ast_name_to_string((*callee_expr).name)
                } else if (*callee_expr).kind == ExprKind::ExprPath {
                    callee = hlir_ast_path_head_to_string((*callee_expr).path)
                } else {
                    s = hlir_lower_report_error(s)
                    return hlir_lower_unit(s)
                }
            }
            None => {
                s = hlir_lower_report_error(s)
                return hlir_lower_unit(s)
            }
        }
        // Epistemic builtins: prove_robust / validate_manifest — zero-cost, return first arg
        if callee == "prove_robust" {
            // prove_robust(contest, policy) → Robust<T>: first arg (contest value) is the datum
            let pr_args = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
            s = pr_args.state
            var pr_vals: [i64; 64] = pr_args.values
            return (s, pr_vals[0])
        }
        if callee == "validate_manifest" {
            // validate_manifest(robust) → Validated<T>: first arg (robust value) is the datum
            let vm_args = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
            s = vm_args.state
            var vm_vals: [i64; 64] = vm_args.values
            return (s, vm_vals[0])
        }
        if callee == "lift_knowledge" {
            // lift_knowledge(k: Knowledge<T>) → Contest<T>: H5.4 epistemic bridge, first arg is the datum
            let lk_args = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
            s = lk_args.state
            var lk_vals: [i64; 64] = lk_args.values
            return (s, lk_vals[0])
        }
        if callee == "measure" {
            // measure(v, uncertainty) → Knowledge<T>: H5.5 epistemic source, first arg (value) is the datum
            let ms_args = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
            s = ms_args.state
            var ms_vals: [i64; 64] = ms_args.values
            return (s, ms_vals[0])
        }

        let args_pair = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
        s = args_pair.state
        var call_vals: [i64; 64] = args_pair.values
        return hlir_lower_call(s, callee, call_vals, args_pair.count, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprMethodCall {
        let base_pair = hlir_lower_expr_opt(s, expr.left)
        s = base_pair.0
        let base_val = base_pair.1
        var arg_vals: [i64; 64] = [HLIR_INVALID_VALUE; 64]
        arg_vals[0] = base_val
        let args_pair = hlir_lower_expr_list(s, expr.args, arg_vals, 1)
        s = args_pair.state
        var method_vals: [i64; 64] = args_pair.values
        return hlir_lower_call(s, hlir_ast_name_to_string(expr.name), method_vals, args_pair.count, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprIf {
        let cond_pair = hlir_lower_expr_opt(s, expr.left)
        s = cond_pair.0
        let ifb = hlir_lower_if_begin(s, cond_pair.1)
        s = hlir_lower_switch_to_block(ifb.state, ifb.then_block)
        match expr.block {
            Some(then_block) => { s = hlir_lower_block_from_ast(s, *then_block) }
            None => {}
        }
        let then_done = hlir_lower_if_then_done(s, ifb.merge_block, HLIR_INVALID_VALUE)
        s = hlir_lower_switch_to_block(then_done.0, ifb.else_block)
        var else_val: i64 = HLIR_INVALID_VALUE
        match expr.else_expr {
            Some(else_expr) => {
                let else_pair = hlir_lower_expr(s, *else_expr)
                s = else_pair.0
                else_val = else_pair.1
            }
            None => {}
        }
        let else_done = hlir_lower_if_else_done(s, ifb.merge_block, else_val)
        return hlir_lower_if_finish(
            else_done.0,
            ifb.merge_block,
            then_done.1,
            HLIR_INVALID_VALUE,
            else_done.1,
            else_val,
            hlir_type_void(),
        )
    }

    if expr.kind == ExprKind::ExprWhile {
        let wb = hlir_lower_while_begin(s)
        s = hlir_lower_switch_to_block(wb.state, wb.header_block)
        let cond_pair = hlir_lower_expr_opt(s, expr.left)
        s = cond_pair.0
        s = hlir_lower_cond_branch(s, cond_pair.1, wb.body_block, wb.exit_block)
        s = hlir_lower_switch_to_block(s, wb.body_block)
        match expr.block {
            Some(body_block) => { s = hlir_lower_block_from_ast(s, *body_block) }
            None => {}
        }
        let body_exit = hlir_lower_current_block(s)
        s = hlir_lower_while(s, cond_pair.1, body_exit, wb.header_block, wb.body_block, wb.exit_block)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprLoop {
        let lb = hlir_lower_loop_begin(s)
        s = lb.state
        match expr.block {
            Some(body_block) => { s = hlir_lower_block_from_ast(s, *body_block) }
            None => {}
        }
        s = hlir_lower_loop_end(s, lb.header_block, lb.exit_block)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprMatch {
        let scrutinee_pair = hlir_lower_expr_opt(s, expr.left)
        s = scrutinee_pair.0
        return hlir_lower_match(s, scrutinee_pair.1, expr.arms)
    }

    if expr.kind == ExprKind::ExprBlock {
        match expr.block {
            Some(block) => { s = hlir_lower_block_from_ast(s, *block) }
            None => {}
        }
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprStructLit {
        s = hlir_lower_struct_field_values(s, expr.fields)
        s = hlir_lower_report_error(s)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprArrayLit || expr.kind == ExprKind::ExprTupleLit {
        let elems_pair = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
        s = elems_pair.state
        s = hlir_lower_report_error(s)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprRange {
        let lhs_pair = hlir_lower_expr_opt(s, expr.left)
        s = lhs_pair.0
        let lhs_val = lhs_pair.1
        let rhs_pair = hlir_lower_expr_opt(s, expr.right)
        s = rhs_pair.0
        let rhs_val = rhs_pair.1
        let op = hlir_ast_binary_to_hlir(expr.bin_op)
        return hlir_lower_binary(s, op, lhs_val, rhs_val, hlir_type_i64())
    }

    if expr.kind == ExprKind::ExprReturn {
        let val_pair = hlir_lower_expr_opt(s, expr.left)
        s = val_pair.0
        s = hlir_lower_return(s, val_pair.1)
        return (s, val_pair.1)
    }

    if expr.kind == ExprKind::ExprBreak {
        s = hlir_lower_break(s)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprContinue {
        s = hlir_lower_continue(s)
        return hlir_lower_unit(s)
    }

    if expr.kind == ExprKind::ExprError {
        s = hlir_lower_report_error(s)
        return hlir_lower_unit(s)
    }

    // Conservative fallback for unsupported expression forms in this shim.
    s = hlir_lower_report_error(s)
    hlir_lower_unit(s)
}

pub fn hlir_lower_params(state: HlirLowerState, params: Option<Box<ParamList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
    match params {
        Some(list) => {
            var s = state
            let pname = hlir_ast_name_to_string((*list).head.name)
            let pty = hlir_type_from_ast((*list).head.ty)
            let p = hlir_lower_add_param(s, pname, pty)
            s = p.0
            s = hlir_lower_let(s, pname, pty, p.1)
            hlir_lower_params(s, (*list).tail)
        }
        None => state,
    }
}

pub fn hlir_lower_function(state: HlirLowerState, ast_func: FnDef, is_kernel: bool) -> HlirLowerState with Mut, Panic, Div, Alloc {
    var s = state
    let fn_name = hlir_ast_name_to_string(ast_func.name)
    let ret_ty = hlir_type_from_ast_opt(ast_func.return_type)
    s = hlir_lower_begin_function(s, fn_name, ret_ty)
    if is_kernel {
        s = hlir_lower_set_kernel(s)
    }
    // Transfer effects from AST to HLIR function
    s = hlir_lower_effects_from_ast(s, ast_func.effects)
    // Compute compile strategy from effects + return type
    let strategy = hlir_compute_strategy(s.builder.func)
    s = hlir_lower_set_strategy(s, strategy)
    s = hlir_scope_push(s)
    s = hlir_lower_params(s, ast_func.params)
    s = hlir_lower_block_from_ast(s, ast_func.body)
    s = hlir_scope_pop(s)

    // Ensure a terminating return in shim mode.
    if ret_ty.kind == HlirTypeKind::HlirTypeVoid {
        s = hlir_lower_return_void(s)
    } else {
        let zero_pair = hlir_lower_literal_int(s, 0, ret_ty)
        s = zero_pair.0
        s = hlir_lower_return(s, zero_pair.1)
    }

    s = hlir_lower_end_function(s)
    s
}

pub fn hlir_lower_items(state: HlirLowerState, items: Option<Box<ItemList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            var s = state
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                match item.fn_def {
                    Some(fn_def) => {
                        let is_kernel = (*fn_def).is_kernel
                        s = hlir_lower_function(s, *fn_def, is_kernel)
                    }
                    None => { s = hlir_lower_report_error(s) }
                }
            }
            hlir_lower_items(s, (*list).tail)
        }
        None => state,
    }
}

pub fn hlir_lower_module(ast_module: Program) -> HlirModule with Mut, Panic, Div, Alloc {
    var s = hlir_lower_state_new()
    let mod_name = hlir_ast_path_head_to_string(ast_module.module_path)
    if str_len(mod_name) > 0 {
        s = hlir_lower_set_module_name(s, mod_name)
    } else {
        s = hlir_lower_set_module_name(s, "module")
    }
    s = hlir_lower_items(s, ast_module.items)
    hlir_lower_finish_module(s)
}

pub fn hlir_lower_module_with_epistemic(ast_module: Program, epistemic: &IrEpistemicSection) -> HlirModule with Mut, Panic, Div, Alloc {
    var s = hlir_install_hyper_metadata(hlir_lower_state_new(), epistemic)
    let mod_name = hlir_ast_path_head_to_string(ast_module.module_path)
    if str_len(mod_name) > 0 {
        s = hlir_lower_set_module_name(s, mod_name)
    } else {
        s = hlir_lower_set_module_name(s, "module")
    }
    s = hlir_lower_items(s, ast_module.items)
    hlir_lower_finish_module(s)
}

