// self-hosted::hlir::opt_strategy — Dual-path codegen for StrategyInstrumented
//
// Contest<T>/Robust<T> functions use StrategyInstrumented. We lower them into
// a dispatch block plus two copies of the whole CFG:
//
//   dispatch -> fast CFG -> merge
//            -> instr CFG -> merge
//
// The fast CFG preserves the original IDs. The instrumented CFG remaps every
// non-parameter SSA value and every block ID so both copies can coexist.
// Every cloned return is rewritten to branch into a common merge/exit block.

let STRATEGY_DEFAULT: i64 = 0
let STRATEGY_INSTRUMENTED: i64 = 1

struct HlirCloneResult {
    block: HlirBlock,
    next_interval_id: i64,
    out_func: HlirFunction,
}

pub struct StrategyHints {
    emit_dual_path: bool,
    strategy: i64,
}

pub fn strategy_hints_default() -> StrategyHints {
    StrategyHints {
        emit_dual_path: false,
        strategy: STRATEGY_DEFAULT,
    }
}

pub fn strategy_hints_instrumented() -> StrategyHints {
    StrategyHints {
        emit_dual_path: true,
        strategy: STRATEGY_INSTRUMENTED,
    }
}

pub fn hlir_strategy_hints_for_compile_strategy(strategy: CompileStrategy) -> StrategyHints {
    match strategy {
        CompileStrategy::StrategyInstrumented => strategy_hints_instrumented(),
        _ => strategy_hints_default(),
    }
}

pub fn hlir_opt_strategy_needs_instrumentation(hints: StrategyHints) -> bool {
    hints.strategy == STRATEGY_INSTRUMENTED
}

pub fn hlir_opt_is_param_value(func: HlirFunction, value_id: i64) -> bool {
    var i: i64 = 0
    while i < func.param_count {
        if func.params[i as usize].value_id == value_id {
            return true
        }
        i = i + 1
    }
    false
}

pub fn hlir_opt_has_local(func: HlirFunction, value_id: i64) -> bool {
    var i: i64 = 0
    while i < func.local_count {
        if func.locals[i as usize].value_id == value_id {
            return true
        }
        i = i + 1
    }
    false
}

pub fn hlir_opt_remap_value(func: HlirFunction, value_id: i64, value_offset: i64) -> i64 {
    if value_id == HLIR_INVALID_VALUE || value_id == HLIR_UNIT_VALUE {
        return value_id
    }
    if value_offset == 0 {
        return value_id
    }
    if hlir_opt_is_param_value(func, value_id) {
        return value_id
    }
    if hlir_opt_has_local(func, value_id) {
        return value_id + value_offset
    }
    value_id
}

pub fn hlir_opt_remap_block(block_id: i64, block_offset: i64) -> i64 {
    if block_id == HLIR_INVALID_BLOCK || block_offset == 0 {
        return block_id
    }
    block_id + block_offset
}

pub fn hlir_opt_instr_needs_interval(instr: HlirInstr) -> bool {
    if instr.op_kind != HLIR_OP_BINARY {
        return false
    }
    let is_f64 = instr.ty.kind == HlirTypeKind::HlirTypeF64
    let is_f32 = instr.ty.kind == HlirTypeKind::HlirTypeF32
    is_f64 || is_f32
}

pub fn hlir_opt_clone_instr(func: HlirFunction, src_instr: HlirInstr, value_offset: i64, block_offset: i64) -> HlirInstr with Mut, Panic, Div {
    var instr = src_instr
    instr.result = hlir_opt_remap_value(func, instr.result, value_offset)
    instr.src = hlir_opt_remap_value(func, instr.src, value_offset)
    instr.lhs = hlir_opt_remap_value(func, instr.lhs, value_offset)
    instr.rhs = hlir_opt_remap_value(func, instr.rhs, value_offset)
    instr.call_func = hlir_opt_remap_value(func, instr.call_func, value_offset)
    instr.base = hlir_opt_remap_value(func, instr.base, value_offset)
    instr.index = hlir_opt_remap_value(func, instr.index, value_offset)
    instr.store_ptr = hlir_opt_remap_value(func, instr.store_ptr, value_offset)
    instr.store_value = hlir_opt_remap_value(func, instr.store_value, value_offset)
    instr.cast_value = hlir_opt_remap_value(func, instr.cast_value, value_offset)
    instr.insert_value = hlir_opt_remap_value(func, instr.insert_value, value_offset)
    instr.select_cond = hlir_opt_remap_value(func, instr.select_cond, value_offset)
    instr.select_true = hlir_opt_remap_value(func, instr.select_true, value_offset)
    instr.select_false = hlir_opt_remap_value(func, instr.select_false, value_offset)

    var i: i64 = 0
    while i < instr.call_arg_count {
        instr.call_args[i as usize] = hlir_opt_remap_value(func, instr.call_args[i as usize], value_offset)
        i = i + 1
    }

    var j: i64 = 0
    while j < instr.phi_count {
        let entry = instr.phi_incoming[j as usize]
        instr.phi_incoming[j as usize] = HlirPhiEntry {
            block_id: hlir_opt_remap_block(entry.block_id, block_offset),
            value_id: hlir_opt_remap_value(func, entry.value_id, value_offset),
        }
        j = j + 1
    }

    var k: i64 = 0
    while k < instr.elem_count {
        instr.elems[k as usize] = hlir_opt_remap_value(func, instr.elems[k as usize], value_offset)
        k = k + 1
    }

    var field_idx: i64 = 0
    while field_idx < instr.struct_field_count {
        var field = instr.struct_fields[field_idx as usize]
        field.value_id = hlir_opt_remap_value(func, field.value_id, value_offset)
        instr.struct_fields[field_idx as usize] = field
        field_idx = field_idx + 1
    }

    var effect_idx: i64 = 0
    while effect_idx < instr.effect_arg_count {
        instr.effect_args[effect_idx as usize] = hlir_opt_remap_value(func, instr.effect_args[effect_idx as usize], value_offset)
        effect_idx = effect_idx + 1
    }

    instr
}

pub fn hlir_opt_clone_terminator(func: HlirFunction, term: HlirTerminator, value_offset: i64, block_offset: i64) -> HlirTerminator with Mut, Panic, Div {
    var out = term
    out.return_value = hlir_opt_remap_value(func, out.return_value, value_offset)
    out.branch_target = hlir_opt_remap_block(out.branch_target, block_offset)
    out.cond_value = hlir_opt_remap_value(func, out.cond_value, value_offset)
    out.then_block = hlir_opt_remap_block(out.then_block, block_offset)
    out.else_block = hlir_opt_remap_block(out.else_block, block_offset)
    out.switch_value = hlir_opt_remap_value(func, out.switch_value, value_offset)
    out.switch_default = hlir_opt_remap_block(out.switch_default, block_offset)

    var i: i64 = 0
    while i < out.switch_case_count {
        var case = out.switch_cases[i as usize]
        case.target = hlir_opt_remap_block(case.target, block_offset)
        out.switch_cases[i as usize] = case
        i = i + 1
    }
    out
}

pub fn hlir_opt_wrap_float_interval(block: HlirBlock, instr: HlirInstr, id_base: i64) -> HlirBlock with Mut, Panic {
    var blk = block
    blk = hlir_block_append_instr(blk, instr)
    if hlir_opt_instr_needs_interval(instr) {
        var lo_instr = instr
        lo_instr.result = id_base
        blk = hlir_block_append_instr(blk, lo_instr)
        var hi_instr = instr
        hi_instr.result = id_base + 1
        blk = hlir_block_append_instr(blk, hi_instr)
    }
    blk
}

pub fn hlir_opt_clone_instrs(
    func: HlirFunction,
    dst_func: HlirFunction,
    src: HlirBlock,
    value_offset: i64,
    block_offset: i64,
    instrumented: bool,
    interval_id_base: i64
) -> HlirCloneResult with Mut, Panic, Div {
    var dst = hlir_block_new(src.id + block_offset, src.label)
    var out_func = dst_func
    var next_interval_id = interval_id_base

    dst.param_count = src.param_count
    var param_idx: i64 = 0
    while param_idx < src.param_count {
        var param = src.params[param_idx as usize]
        param.value_id = hlir_opt_remap_value(func, param.value_id, value_offset)
        dst.params[param_idx as usize] = param
        param_idx = param_idx + 1
    }

    var i: i64 = 0
    while i < src.instr_count {
        let instr = hlir_opt_clone_instr(func, src.instrs[i as usize], value_offset, block_offset)
        if instrumented && hlir_opt_instr_needs_interval(instr) {
            out_func = hlir_function_register_local(out_func, next_interval_id, instr.ty)
            out_func = hlir_function_register_local(out_func, next_interval_id + 1, instr.ty)
            dst = hlir_opt_wrap_float_interval(dst, instr, next_interval_id)
            next_interval_id = next_interval_id + 2
        } else {
            dst = hlir_block_append_instr(dst, instr)
        }
        i = i + 1
    }

    HlirCloneResult { block: dst, next_interval_id: next_interval_id, out_func: out_func }
}

pub fn hlir_opt_max_value_id(func: HlirFunction) -> i64 {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < func.local_count {
        let value_id = func.locals[i as usize].value_id
        if value_id > max_id {
            max_id = value_id
        }
        i = i + 1
    }
    var j: i64 = 0
    while j < func.param_count {
        let value_id = func.params[j as usize].value_id
        if value_id > max_id {
            max_id = value_id
        }
        j = j + 1
    }
    max_id
}

pub fn hlir_opt_max_block_id(func: HlirFunction) -> i64 {
    var max_id: i64 = -1
    var i: i64 = 0
    while i < func.block_count {
        let block_id = func.blocks[i as usize].id
        if block_id > max_id {
            max_id = block_id
        }
        i = i + 1
    }
    max_id
}

pub fn hlir_opt_add_original_params(dst: HlirFunction, src: HlirFunction) -> HlirFunction with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.param_count {
        let param = src.params[i as usize]
        out = hlir_function_add_param(out, param)
        out = hlir_function_register_local(out, param.value_id, param.ty)
        i = i + 1
    }
    out
}

pub fn hlir_opt_add_original_locals(dst: HlirFunction, src: HlirFunction) -> HlirFunction with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.local_count {
        let local = src.locals[i as usize]
        if !hlir_opt_is_param_value(src, local.value_id) {
            out = hlir_function_register_local(out, local.value_id, local.ty)
        }
        i = i + 1
    }
    out
}

pub fn hlir_opt_add_instrumented_locals(dst: HlirFunction, src: HlirFunction, value_offset: i64) -> HlirFunction with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.local_count {
        let local = src.locals[i as usize]
        if !hlir_opt_is_param_value(src, local.value_id) {
            out = hlir_function_register_local(out, local.value_id + value_offset, local.ty)
        }
        i = i + 1
    }
    out
}

pub fn hlir_opt_apply_strategy(func: HlirFunction, hints: StrategyHints) -> HlirFunction with Mut, Panic, Div {
    if !hints.emit_dual_path || !hlir_opt_strategy_needs_instrumentation(hints) {
        return func
    }
    if func.block_count <= 0 {
        return func
    }

    let max_value_id = hlir_opt_max_value_id(func)
    let value_offset = if max_value_id < 0 { 1 } else { max_value_id + 1 }
    let validated_param_id = (value_offset * 2)
    let merge_phi_id = validated_param_id + 1
    let validated_zero_id = merge_phi_id + 1
    let validated_cond_id = merge_phi_id + 2

    let max_block_id = hlir_opt_max_block_id(func)
    let block_offset = max_block_id + 1
    let dispatch_id = (block_offset * 2)
    let merge_id = dispatch_id + 1

    var out = func
    out.param_count = 0
    out.block_count = 0
    out.local_count = 0

    out = hlir_opt_add_original_params(out, func)
    out = hlir_opt_add_original_locals(out, func)
    out = hlir_opt_add_instrumented_locals(out, func, value_offset)

    let validated_param = HlirParam {
        value_id: validated_param_id,
        name: hlir_name_from_str("__validated"),
        ty: hlir_type_i64(),
    }
    out = hlir_function_add_param(out, validated_param)
    out = hlir_function_register_local(out, validated_param_id, hlir_type_i64())
    out = hlir_function_register_local(out, validated_zero_id, hlir_type_i64())
    out = hlir_function_register_local(out, validated_cond_id, hlir_type_bool())

    var dispatch_block = hlir_block_new(dispatch_id, hlir_name_from_str("dispatch"))
    dispatch_block = hlir_block_append_instr(
        dispatch_block,
        hlir_instr_const(validated_zero_id, hlir_const_int(0, hlir_type_i64()), hlir_type_i64())
    )
    dispatch_block = hlir_block_append_instr(
        dispatch_block,
        hlir_instr_binary(validated_cond_id, HLIR_BIN_NE, validated_param_id, validated_zero_id, hlir_type_bool())
    )
    dispatch_block = hlir_block_set_terminator(
        dispatch_block,
        hlir_term_cond_branch(validated_cond_id, func.blocks[0].id, func.blocks[0].id + block_offset)
    )
    out = hlir_function_add_block(out, dispatch_block)

    var return_entries: [HlirPhiEntry; 64] = [hlir_phi_entry_empty(); 64]
    var return_count: i64 = 0
    var saw_return = false
    var interval_id_base = merge_phi_id + 3

    var bi: i64 = 0
    while bi < func.block_count {
        let src_block = func.blocks[bi as usize]

        let fast_pair = hlir_opt_clone_instrs(func, out, src_block, 0, 0, false, interval_id_base)
        var fast_block = fast_pair.block
        interval_id_base = fast_pair.next_interval_id
        out = fast_pair.out_func
        let fast_term = hlir_opt_clone_terminator(func, src_block.terminator, 0, 0)
        if fast_term.kind == HLIR_TERM_RETURN {
            saw_return = true
            if return_count < 64 && func.return_type.kind != HlirTypeKind::HlirTypeVoid {
                return_entries[return_count as usize] = HlirPhiEntry {
                    block_id: fast_block.id,
                    value_id: fast_term.return_value,
                }
                return_count = return_count + 1
            }
            fast_block = hlir_block_set_terminator(fast_block, hlir_term_branch(merge_id))
        } else {
            fast_block = hlir_block_set_terminator(fast_block, fast_term)
        }
        out = hlir_function_add_block(out, fast_block)

        let instr_pair = hlir_opt_clone_instrs(func, out, src_block, value_offset, block_offset, true, interval_id_base)
        var instr_block = instr_pair.block
        interval_id_base = instr_pair.next_interval_id
        out = instr_pair.out_func
        let instr_term = hlir_opt_clone_terminator(func, src_block.terminator, value_offset, block_offset)
        if instr_term.kind == HLIR_TERM_RETURN {
            saw_return = true
            if return_count < 64 && func.return_type.kind != HlirTypeKind::HlirTypeVoid {
                return_entries[return_count as usize] = HlirPhiEntry {
                    block_id: instr_block.id,
                    value_id: instr_term.return_value,
                }
                return_count = return_count + 1
            }
            instr_block = hlir_block_set_terminator(instr_block, hlir_term_branch(merge_id))
        } else {
            instr_block = hlir_block_set_terminator(instr_block, instr_term)
        }
        out = hlir_function_add_block(out, instr_block)

        bi = bi + 1
    }

    if !saw_return {
        return func
    }

    var merge_block = hlir_block_new(merge_id, hlir_name_from_str("merge"))
    if func.return_type.kind == HlirTypeKind::HlirTypeVoid {
        merge_block = hlir_block_set_terminator(merge_block, hlir_term_return(HLIR_INVALID_VALUE))
    } else {
        if return_count <= 0 {
            return func
        }
        var phi_instr = hlir_instr_new(HLIR_OP_PHI)
        phi_instr.result = merge_phi_id
        phi_instr.ty = out.return_type
        phi_instr.phi_incoming = return_entries
        phi_instr.phi_count = return_count
        merge_block = hlir_block_append_instr(merge_block, phi_instr)
        merge_block = hlir_block_set_terminator(merge_block, hlir_term_return(merge_phi_id))
        out = hlir_function_register_local(out, merge_phi_id, out.return_type)
    }
    out = hlir_function_add_block(out, merge_block)

    out
}
