// self-hosted::hlir::ir — HLIR (High-Level Intermediate Representation) data structures
//
// SSA-form IR consumed by LLVM and GPU codegen backends.
// Follows the same patterns as self-hosted/ir/ir.sio:
//   - Fixed-size arrays with counts
//   - i64 IDs with sentinel values
//   - Struct-based instruction encoding (no enum field destructuring)
//   - Name type for identifiers

// ============================================================================
// Constants
// ============================================================================

let HLIR_MAX_FUNCTIONS: i64 = 1024
let HLIR_MAX_GLOBALS: i64 = 512
let HLIR_MAX_TYPEDEFS: i64 = 512
let HLIR_MAX_BLOCKS: i64 = 4096
let HLIR_MAX_INSTRS: i64 = 16384
let HLIR_MAX_PARAMS: i64 = 64
let HLIR_MAX_LOCALS: i64 = 8192
let HLIR_MAX_EFFECTS: i64 = 16
let HLIR_MAX_BLOCK_PARAMS: i64 = 32
let HLIR_MAX_PHI_INCOMING: i64 = 64
let HLIR_MAX_SWITCH_CASES: i64 = 256
let HLIR_MAX_CALL_ARGS: i64 = 64
let HLIR_MAX_STRUCT_FIELDS: i64 = 128
let HLIR_MAX_CONST_ELEMS: i64 = 256

let HLIR_INVALID_VALUE: i64 = -1
let HLIR_INVALID_BLOCK: i64 = -1
let HLIR_INVALID_FUNC: i64 = -1
let HLIR_UNIT_VALUE: i64 = 2147483647   // u32::MAX equivalent

// ============================================================================
// Identifiers (opaque i64 wrappers, same pattern as IR module)
// ============================================================================

// ValueId, BlockId, FunctionId are plain i64.
// We use naming conventions rather than wrapper structs for clarity.
//   value_id: i64   — SSA value identifier
//   block_id: i64   — basic block identifier
//   func_id:  i64   — function identifier

// ============================================================================
// Name type (128-byte fixed buffer, same as ir/ir.sio)
// ============================================================================

struct HlirName {
    buf: [i8; 128],
    len: i64,
}

fn hlir_empty_name() -> HlirName {
    HlirName { buf: [0; 128], len: 0 }
}

fn hlir_name_from_str(s: string) -> HlirName with Mut, Panic, Div {
    var name = hlir_empty_name()
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if i >= 128 { break }
        name.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    name.len = if n < 128 { n } else { 128 }
    name
}

fn hlir_name_eq(a: HlirName, b: HlirName) -> bool {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

fn hlir_name_to_string(n: HlirName) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(n.buf, n.len)
}

// ============================================================================
// Compile Strategy — type+effect-directed compilation mode
// ============================================================================
//
// Selected during HIR→HLIR lowering based on the function's effect signature
// and return type epistemic classification.  Guides optimization passes and
// codegen: aggressive paths for validated data, precision-preserving paths
// for uncertain data, GPU kernel extraction for GPU-effected functions.

enum CompileStrategy {
    StrategyStandard,           // default — standard native compilation
    StrategyAggressive,         // pure + Validated<T> — full inlining, SIMD, no guards
    StrategyPrecisionPreserving,// pure + Knowledge<T> — no float reassociation, interval tracking
    StrategyInstrumented,       // Epistemic<T> — dual-path: fast + instrumented
    StrategyGpuKernel,          // with GPU — GPU kernel extraction
    StrategyProbabilistic,      // with Prob — trace-compatible for MCMC/VI
}

// ============================================================================
// HLIR Type System
// ============================================================================

enum HlirTypeKind {
    HlirTypeVoid,
    HlirTypeBool,
    HlirTypeI8,
    HlirTypeI16,
    HlirTypeI32,
    HlirTypeI64,
    HlirTypeI128,
    HlirTypeU8,
    HlirTypeU16,
    HlirTypeU32,
    HlirTypeU64,
    HlirTypeU128,
    HlirTypeF32,
    HlirTypeF64,
    HlirTypePtr,        // pointer to inner type (index into type table)
    HlirTypeArray,       // array of inner type with length
    HlirTypeStruct,      // named struct (name field)
    HlirTypeTuple,       // tuple (element types in type_elems)
    HlirTypeFunction,    // function type (params + return in type_elems)
    // Linear algebra (SIMD)
    HlirTypeVec2,        // 2x f32
    HlirTypeVec3,        // 3x f32 (padded to 4)
    HlirTypeVec4,        // 4x f32
    HlirTypeMat2,        // 2x2 f32
    HlirTypeMat3,        // 3x3 f32
    HlirTypeMat4,        // 4x4 f32
    HlirTypeQuat,        // 4x f32 quaternion
    // Hypercomplex (Cayley-Dickson)
    HlirTypeOctonion,    // 8x f32
    HlirTypeSedenion,    // 16x f32
    // Quaternionic NN
    HlirTypeQuatLinear,
    HlirTypeQuatConv2d,
    HlirTypeQuatRnnState,
    HlirTypeQuatGate,
    // f64 vectors
    HlirTypeVec2d,       // 2x f64
    HlirTypeVec3d,       // 3x f64
    HlirTypeVec4d,       // 4x f64
    // Automatic differentiation
    HlirTypeDual,        // (value: f64, derivative: f64)
    // Epistemic
    HlirTypeKnowledge,       // Knowledge<inner> with epsilon/provenance
    HlirTypeContest,         // Contest<inner> with disagreement metadata
    HlirTypeRobust,          // Robust<inner> with proof metadata
    HlirTypeIntervention,    // Intervention<inner> — causal do(X=x)
    HlirTypeCounterfactual,  // Counterfactual<inner> — causal Y(x)
    HlirTypeValidated,       // Validated<inner> — compile-time validated
}

// Epistemic mode for Knowledge types
enum EpistemicMode {
    EpistemicDefault,
    EpistemicStrict,
    EpistemicRelaxed,
}

// Full type descriptor (flat struct, no recursive Box<HlirType>)
// For compound types, inner_type_idx points into a type table.
struct HlirType {
    kind: HlirTypeKind,
    // For Ptr: index of pointed-to type in module type table
    inner_type_idx: i64,
    // For Array: element count
    array_len: i64,
    // For Struct: struct name
    name: HlirName,
    // For Tuple/Function: element type indices stored in type_elems
    type_elems: [i64; 32],
    type_elem_count: i64,
    // For Function: index of return type (last elem is return)
    // For Knowledge: epistemic metadata
    epistemic_mode: EpistemicMode,
    epsilon_bound: f64,         // -1.0 = not set
    provenance_id: i64,         // -1 = not set
}

fn hlir_type_void() -> HlirType {
    HlirType {
        kind: HlirTypeKind::HlirTypeVoid,
        inner_type_idx: -1,
        array_len: 0,
        name: hlir_empty_name(),
        type_elems: [0; 32],
        type_elem_count: 0,
        epistemic_mode: EpistemicMode::EpistemicDefault,
        epsilon_bound: -1.0,
        provenance_id: -1,
    }
}

fn hlir_type_bool() -> HlirType {
    let base = hlir_type_void()
    HlirType {
        kind: HlirTypeKind::HlirTypeBool,
        inner_type_idx: base.inner_type_idx,
        array_len: base.array_len,
        name: base.name,
        type_elems: base.type_elems,
        type_elem_count: base.type_elem_count,
        epistemic_mode: base.epistemic_mode,
        epsilon_bound: base.epsilon_bound,
        provenance_id: base.provenance_id,
    }
}

