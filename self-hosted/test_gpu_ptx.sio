    ptx_str_contains(s, "bar.sync 0")
}

fn gpu_ptx_test_62_setp_ge_u32() -> bool with IO, Mut, Panic, Div, Alloc {
    var k = gpu_kernel_new()
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 0
    op.lhs_reg = 1
    op.rhs_reg = 2
    op.ty = GpuType::GpuU32
    k.ops[0] = op
    k.op_count = 1
    k.max_reg_pred = 1
    k.max_reg_u32 = 3
    let s = ptx_to_string(gpu_lower_to_ptx(k))
    ptx_str_contains(s, "setp.ge.u32") && ptx_str_contains(s, "%p0")
}

fn gpu_ptx_test_63_setp_ge_f64() -> bool with IO, Mut, Panic, Div, Alloc {
    var k = gpu_kernel_new()
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 1
    op.lhs_reg = 2
    op.rhs_reg = 3
    op.ty = GpuType::GpuF64
    k.ops[0] = op
    k.op_count = 1
    k.max_reg_pred = 2
    k.max_reg_f64 = 4
    let s = ptx_to_string(gpu_lower_to_ptx(k))
    ptx_str_contains(s, "setp.ge.f64") && ptx_str_contains(s, "%p1")
}

fn gpu_ptx_test_64_tiled_gemm_f32_barrier_and_shared() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    ptx_str_contains(s, "bar.sync 0") &&
    ptx_str_contains(s, ".shared .align 4 .b8 shared_array[") &&
    ptx_str_contains(s, "ld.shared.f32")
}

