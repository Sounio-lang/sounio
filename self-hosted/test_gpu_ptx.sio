// Self-hosted GPU PTX tests
//
// These tests validate that the PTX text emitter produces a stable,
// recognizable PTX module skeleton. This is "phase 0": text only.

fn gpu_ptx_test_01_header() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, ".version") &&
    ptx_buf_contains(p, ".target") &&
    ptx_buf_contains(p, ".address_size 64")
}

fn gpu_ptx_test_02_has_entry() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, ".entry vec_add")
}

fn gpu_ptx_test_03_tid_x() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, "%tid.x")
}

fn gpu_ptx_test_04_load_store() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, "ld.global") &&
    ptx_buf_contains(p, "st.global")
}

fn gpu_ptx_test_05_to_string_smoke() -> bool with Mut, Panic, Div, Alloc {
    let p = ptx_emit_demo_vec_add()
    let s = ptx_to_string(p)
    starts_with(s, ".version") &&
    ptx_str_contains(s, ".entry vec_add") &&
    ends_with(s, "}\n")
}

fn gpu_ptx_test_06_emit_default_header() -> bool with Mut, Panic, Div, Alloc {
    let p = ptx_to_string(ptx_emit_header(ptx_buf_new()))
    p == ".version 7.0\n.target sm_50\n.address_size 64\n\n"
}

fn gpu_ptx_test_07_vec3_add_op_helper() -> bool with Mut, Panic, Div, Alloc {
    var b = ptx_buf_new()
    b = ptx_emit_vec3_f32_add(
        b,
        "%f3", "%f1", "%f2",
        "%f4", "%f2", "%f3",
        "%f5", "%f3", "%f4"
    )
    let s = ptx_to_string(b)
    s == "    add.f32 %f3, %f1, %f2;\n    add.f32 %f4, %f2, %f3;\n    add.f32 %f5, %f3, %f4;\n"
}

fn gpu_ptx_test_08_full_kernel_deterministic() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(ptx_emit_demo_vec_add())
    s == ".version 7.0\n.target sm_50\n.address_size 64\n\n.visible .entry vec_add(\n    .param .u64 param_a,\n    .param .u64 param_b,\n    .param .u64 param_c\n)\n{\n    .reg .pred %p<2>;\n    .reg .b32 %r<3>;\n    .reg .b64 %rd<9>;\n    .reg .f32 %f<4>;\n\n    mov.u32 %r1, %tid.x;\n    cvt.u64.u32 %rd1, %r1;\n    mul.lo.u64 %rd2, %rd1, 4;\n    ld.param.u64 %rd3, [param_a];\n    ld.param.u64 %rd4, [param_b];\n    ld.param.u64 %rd5, [param_c];\n    add.u64 %rd6, %rd3, %rd2;\n    add.u64 %rd7, %rd4, %rd2;\n    add.u64 %rd8, %rd5, %rd2;\n    ld.global.f32 %f1, [%rd6];\n    ld.global.f32 %f2, [%rd7];\n    add.f32 %f3, %f1, %f2;\n    st.global.f32 [%rd8], %f3;\n    ret;\n}\n"
}

// ===== PHASE 1: IR-Driven Lowering Tests =====
//
// These tests validate the new structured kernel-lowering system
// (kernel_ir.sio + lower_to_ptx.sio)

fn gpu_ptx_test_09_ir_lowering_smoke() -> bool with Mut, Panic, Div, Alloc {
    // Build vec_add kernel IR
    let ir = gpu_build_vec_add_ir()

    // Lower to PTX
    let ptx = gpu_lower_to_ptx(ir)
    let s = ptx_to_string(ptx)

    // Verify it has expected PTX structure
    starts_with(s, ".version") &&
    ptx_str_contains(s, ".entry vec_add") &&
    ptx_str_contains(s, "%tid.x") &&
    ptx_str_contains(s, "ld.global") &&
    ptx_str_contains(s, "st.global") &&
    ends_with(s, "}\n")
}

fn gpu_ptx_test_10_ir_lowering_matches_hardcoded() -> bool with Mut, Panic, Div, Alloc {
    // IR-driven lowering
    let ir = gpu_build_vec_add_ir()
    let ptx_from_ir = ptx_to_string(gpu_lower_to_ptx(ir))

    // Hardcoded reference
    let ptx_hardcoded = ptx_to_string(ptx_emit_demo_vec_add())

    // Should be byte-for-byte identical
    ptx_from_ir == ptx_hardcoded
}

