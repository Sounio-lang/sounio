// Self-hosted GPU PTX tests
//
// These tests validate that the PTX text emitter produces a stable,
// recognizable PTX module skeleton. This is "phase 0": text only.

fn gpu_ptx_test_01_header() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, ".version") &&
    ptx_buf_contains(p, ".target") &&
    ptx_buf_contains(p, ".address_size 64")
}

fn gpu_ptx_test_02_has_entry() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, ".entry vec_add")
}

fn gpu_ptx_test_03_tid_x() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, "%tid.x")
}

fn gpu_ptx_test_04_load_store() -> bool with Mut, Panic, Div {
    let p = ptx_emit_demo_vec_add()
    ptx_buf_contains(p, "ld.global") &&
    ptx_buf_contains(p, "st.global")
}

fn run_gpu_ptx_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU PTX Tests ===\n")

    total = total + 1
    if gpu_ptx_test_01_header() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01\n") }
    total = total + 1
    if gpu_ptx_test_02_has_entry() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02\n") }
    total = total + 1
    if gpu_ptx_test_03_tid_x() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03\n") }
    total = total + 1
    if gpu_ptx_test_04_load_store() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04\n") }

    if passed == total { print("GPU PTX tests: all passed\n") } else { print("GPU PTX tests: suite fail\n") }

    if passed == total { 0 } else { 1 }
}

