fn gpu_ptx_test_77_kernel_max_ops_is_1024() -> bool with IO, Mut, Panic, Div, Alloc {
    gpu_kernel_max_ops() == 1024
}

fn gpu_ptx_test_78_complex_kernels_within_op_capacity() -> bool with IO, Mut, Panic, Div, Alloc {
    let gemm = gpu_build_gemm_shared_f64_ir()
    let conv2d = gpu_build_conv2d_f64_ir()
    let vec = gpu_build_vec_sum_f64_ir()
    let max_ops = gpu_kernel_max_ops()
    gemm.op_count <= max_ops && conv2d.op_count <= max_ops && vec.op_count <= max_ops
}

fn gpu_ptx_test_85_checked_append_preserves_last_op() -> bool with IO, Mut, Panic, Div, Alloc {
    let mut_kernel = gpu_kernel_new()
    var filler = gpu_op_new()
    filler.dst_reg = -1
    var k = mut_kernel
    var i: i64 = 0
    while i < gpu_kernel_max_ops() - 1 {
        filler.dst_reg = i
        let appended = gpu_append_op_checked(k, filler)
        if appended.error != GpuError::GpuOk { return false }
        k = appended.result_kernel
        i = i + 1
    }

    // Fill final in-bound slot with a marker op.
    filler.dst_reg = 4242
    let terminal = gpu_append_op_checked(k, filler)
    if terminal.error != GpuError::GpuOk { return false }
    let tk = terminal.result_kernel
    if tk.op_count != gpu_kernel_max_ops() { return false }
    let last_op = tk.ops[(gpu_kernel_max_ops() - 1) as usize]
    if last_op.dst_reg != 4242 { return false }

    // One more op must fail without mutating the terminal slot.
    let overflow = gpu_append_op_checked(tk, filler)
    if overflow.error != GpuError::GpuOpBufferOverflow { return false }
    let ok_k = overflow.result_kernel
    let last_op2 = ok_k.ops[(gpu_kernel_max_ops() - 1) as usize]
    last_op2.dst_reg == 4242
}

fn gpu_ptx_test_86_unchecked_append_never_shortens_terminal_state() -> bool with IO, Mut, Panic, Div, Alloc {
    let mut_kernel = gpu_kernel_new()
    var filler = gpu_op_new()
    var k = mut_kernel
    var i: i64 = 0
    while i < gpu_kernel_max_ops() {
        filler.dst_reg = i
        let appended = gpu_append_op_checked(k, filler)
        if appended.error != GpuError::GpuOk { return false }
        k = appended.result_kernel
        i = i + 1
    }

    // Unchecked append should preserve last-op contents and capacity.
    filler.dst_reg = 9001
    let after_overflow = gpu_append_op(k, filler)
    let last_idx = gpu_kernel_max_ops() - 1
    let last_op = after_overflow.ops[last_idx as usize]
    after_overflow.op_count == gpu_kernel_max_ops() &&
    last_op.dst_reg == last_idx
}

fn gpu_ptx_test_50_op_buffer_append_ok() -> bool with IO, Mut, Panic, Div, Alloc {
    let k0 = gpu_kernel_new()
    let op = gpu_op_new()
    let first = gpu_append_op_checked(k0, op)
    if first.error != GpuError::GpuOk { return false }
    let fk = first.result_kernel
    if fk.op_count != 1 { return false }

    var k = fk
    var i: i64 = 1
    while i < gpu_kernel_max_ops() {
        let next = gpu_append_op_checked(k, op)
        if next.error != GpuError::GpuOk {
            return false
        }
        k = next.result_kernel
        i = i + 1
    }
    k.op_count == gpu_kernel_max_ops()
}

fn gpu_ptx_test_51_op_buffer_overflow_detected() -> bool with IO, Mut, Panic, Div, Alloc {
    let mut_kernel = gpu_kernel_new()
    let op = gpu_op_new()

    var k = mut_kernel
    var i: i64 = 0
    while i < gpu_kernel_max_ops() {
        let next = gpu_append_op_checked(k, op)
        k = next.result_kernel
        if next.error != GpuError::GpuOk { return false }
        i = i + 1
    }

    let overflow = gpu_append_op_checked(k, op)
    if overflow.error != GpuError::GpuOpBufferOverflow { return false }
    let ok = overflow.result_kernel
    ok.op_count == gpu_kernel_max_ops()
}

