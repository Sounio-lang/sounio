// ===== Phase 6: Cross-kernel validation tests =====

// Verify that all element-wise kernels produce consistent param structure
fn gpu_ptx_test_58_elemwise_param_consistency() -> bool with IO, Mut, Panic, Div, Alloc {
    let add_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_add_f64_ir()))
    let sub_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_sub_f64_ir()))
    let mul_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_mul_f64_ir()))
    let div_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_div_f64_ir()))
    // All element-wise kernels should have param_a, param_b, param_c
    ptx_str_contains(add_s, "param_a") &&
    ptx_str_contains(sub_s, "param_a") &&
    ptx_str_contains(mul_s, "param_a") &&
    ptx_str_contains(div_s, "param_a") &&
    ptx_str_contains(add_s, "param_c") &&
    ptx_str_contains(sub_s, "param_c")
}

// Verify reduction kernels all use warp shuffles
fn gpu_ptx_test_59_reduction_shuffle_consistency() -> bool with IO, Mut, Panic, Div, Alloc {
    let sum_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_sum_f32_ir()))
    let max_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_max_f32_ir()))
    let min_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_min_f32_ir()))
    // All reductions must use warp shuffle
    ptx_str_contains(sum_s, "shfl.sync.down") &&
    ptx_str_contains(max_s, "shfl.sync.down") &&
    ptx_str_contains(min_s, "shfl.sync.down")
}

// Verify instruction budget: element-wise kernels are compact
fn gpu_ptx_test_60_elemwise_instruction_budget() -> bool with IO, Mut, Panic, Div, Alloc {
    let k = gpu_build_vec_add_ir()
    // Element-wise vec_add should have ~15 ops (tid, cvt, mulimm, 3x loadparam, 3x add, 2x load, 1x add_elem, 1x store, 1x ret)
    k.op_count > 8 && k.op_count < 30
}

// Verify instruction budget: stencil kernels are more complex than element-wise
fn gpu_ptx_test_61_stencil_larger_than_elemwise() -> bool with IO, Mut, Panic, Div, Alloc {
    let elemwise = gpu_build_vec_add_ir()
    let stencil = gpu_build_conv1d_f32_ir()
    stencil.op_count > elemwise.op_count
}

