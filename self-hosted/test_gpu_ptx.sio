    ptx_str_contains(s, "setp.lt.u32") &&
    ptx_str_contains(s, "@%p0") &&
    ptx_str_contains(s, "st.global.f32")
}

fn gpu_ptx_test_67_predicated_store_guard() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    let has_predicated_store = ptx_str_contains(s, "@%p0 st.global.f32")
    if !has_predicated_store { return false }
    // Ensure global stores remain predicate-guarded in this kernel (no unconditional write path).
    !ptx_str_contains(s, "\n    st.global.f32 [")
}

fn gpu_ptx_test_50_op_buffer_append_ok() -> bool with Mut, Panic, Div, Alloc {
    let k0 = gpu_kernel_new()
    let op = gpu_op_new()
    let first = gpu_append_op_checked(k0, op)
    if first.error != GpuError::GpuOk { return false }
    if first.kernel.op_count != 1 { return false }

    var k = first.kernel
    var i: i64 = 1
    while i < gpu_kernel_max_ops() {
        let next = gpu_append_op_checked(k, op)
        if next.error != GpuError::GpuOk {
            return false
        }
        k = next.kernel
        i = i + 1
    }
    k.op_count == gpu_kernel_max_ops()
}

fn gpu_ptx_test_51_op_buffer_overflow_detected() -> bool with Mut, Panic, Div, Alloc {
    let mut_kernel = gpu_kernel_new()
    let op = gpu_op_new()

    var k = mut_kernel
    var i: i64 = 0
    while i < gpu_kernel_max_ops() {
        let next = gpu_append_op_checked(k, op)
        k = next.kernel
        if next.error != GpuError::GpuOk { return false }
        i = i + 1
    }

    let overflow = gpu_append_op_checked(k, op)
    if overflow.error != GpuError::GpuOpBufferOverflow { return false }
    overflow.kernel.op_count == gpu_kernel_max_ops()
}

// ===== Phase 5: Stencil (conv1d) tests =====

fn gpu_ptx_test_52_conv1d_f32_entry() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_f32_ir()))
    ptx_str_contains(s, ".entry conv1d_f32") &&
    ptx_str_contains(s, "bar.sync 0")
}

fn gpu_ptx_test_53_conv1d_f32_shared() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_f32_ir()))
    ptx_str_contains(s, "ld.shared") &&
    ptx_str_contains(s, "st.shared")
}

fn gpu_ptx_test_54_conv1d_f32_fma() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_f32_ir()))
    ptx_str_contains(s, "fma.rn.f32") &&
    ptx_str_contains(s, "mul.rn.f32")
}

fn gpu_ptx_test_55_conv1d_f64() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_f64_ir()))
    ptx_str_contains(s, ".entry conv1d_f64") &&
    ptx_str_contains(s, "fma.rn.f64") &&
    ptx_str_contains(s, "ld.shared")
}

fn gpu_ptx_test_56_conv1d_i32() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_i32_ir()))
    ptx_str_contains(s, ".entry conv1d_i32") &&
    ptx_str_contains(s, "mad.lo.s32")
}

fn gpu_ptx_test_57_conv1d_bid_x() -> bool with Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_conv1d_f32_ir()))
    ptx_str_contains(s, "%ctaid.x")
}

// ===== Phase 6: Cross-kernel validation tests =====

// Verify that all element-wise kernels produce consistent param structure
fn gpu_ptx_test_58_elemwise_param_consistency() -> bool with Mut, Panic, Div, Alloc {
    let add_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_add_f64_ir()))
    let sub_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_sub_f64_ir()))
    let mul_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_mul_f64_ir()))
    let div_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_div_f64_ir()))
    // All element-wise kernels should have param_a, param_b, param_c
    ptx_str_contains(add_s, "param_a") &&
    ptx_str_contains(sub_s, "param_a") &&
    ptx_str_contains(mul_s, "param_a") &&
    ptx_str_contains(div_s, "param_a") &&
    ptx_str_contains(add_s, "param_c") &&
    ptx_str_contains(sub_s, "param_c")
}

// Verify reduction kernels all use warp shuffles
fn gpu_ptx_test_59_reduction_shuffle_consistency() -> bool with Mut, Panic, Div, Alloc {
    let sum_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_sum_f32_ir()))
    let max_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_max_f32_ir()))
    let min_s = ptx_to_string(gpu_lower_to_ptx(gpu_build_vec_min_f32_ir()))
    // All reductions must use warp shuffle
    ptx_str_contains(sum_s, "shfl.sync.down") &&
    ptx_str_contains(max_s, "shfl.sync.down") &&
    ptx_str_contains(min_s, "shfl.sync.down")
}

// Verify instruction budget: element-wise kernels are compact
fn gpu_ptx_test_60_elemwise_instruction_budget() -> bool with Mut, Panic, Div, Alloc {
    let k = gpu_build_vec_add_ir()
    // Element-wise vec_add should have ~15 ops (tid, cvt, mulimm, 3x loadparam, 3x add, 2x load, 1x add_elem, 1x store, 1x ret)
    k.op_count > 8 && k.op_count < 30
}

// Verify instruction budget: stencil kernels are more complex than element-wise
fn gpu_ptx_test_61_stencil_larger_than_elemwise() -> bool with Mut, Panic, Div, Alloc {
    let elemwise = gpu_build_vec_add_ir()
    let stencil = gpu_build_conv1d_f32_ir()
    stencil.op_count > elemwise.op_count
}

