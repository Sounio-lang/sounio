    if gpu_ptx_test_67_predicated_store_guard() { passed = passed + 1; print("  T67 OK (predicated store guard)\n") } else { print("  FAIL T67\n") }

    if passed == total { print("GPU PTX tests: all passed\n") } else { print("GPU PTX tests: suite fail\n") }

    if passed == total { 0 } else { 1 }
}
