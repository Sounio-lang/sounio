fn gpu_ptx_test_66_tiled_gemm_predication_contract() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    ptx_str_contains(s, "setp.lt.u32") &&
    ptx_str_contains(s, "@%p0") &&
    ptx_str_contains(s, "st.global.f32")
}

fn gpu_ptx_test_67_predicated_store_guard() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    let has_predicated_store = ptx_has_predicated_opcode(s, "st.global.f32")
    let has_unguarded_store = ptx_has_unpredicated_opcode(s, "st.global.f32")
    has_predicated_store && !has_unguarded_store
}

// Additional stronger contracts: explicit predicate register checks by line semantics.
// These catch regressions where a later pass accidentally emits unguarded global/shared
// memory instructions that a prior substring-only check might miss.
fn gpu_ptx_test_68_predicated_global_load_guard_contract() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    let has_predicated_load = ptx_has_predicated_opcode(s, "ld.global.f32")
    let has_unguarded_load = ptx_has_unpredicated_opcode(s, "ld.global.f32")
    has_predicated_load && !has_unguarded_load
}

fn gpu_ptx_test_69_predicated_shared_load_guard_contract() -> bool with IO, Mut, Panic, Div, Alloc {
    let s = ptx_to_string(gpu_lower_to_ptx(gpu_build_gemm_shared_f32_ir()))
    ptx_has_predicated_opcode(s, "ld.shared.f32") &&
    !ptx_has_unpredicated_opcode(s, "ld.shared.f32")
}

