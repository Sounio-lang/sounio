// T100: value-map name retrieval honors flat-buffer offsets
fn gpu_ptx_test_100_value_map_name_offsets() -> bool with IO, Mut, Panic, Div, Alloc {
    var vm = ptx_value_map_new()
    vm = ptx_value_map_insert(vm, 7, "r32_0", GpuType::GpuU32)
    vm = ptx_value_map_insert(vm, 9, "f32_12", GpuType::GpuF32)
    vm = ptx_value_map_insert(vm, 11, "r64_3", GpuType::GpuU64)

    ptx_value_map_get_name(vm, 7) == "r32_0" &&
    ptx_value_map_get_name(vm, 9) == "f32_12" &&
    ptx_value_map_get_name(vm, 11) == "r64_3"
}

fn run_gpu_ptx_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU PTX Tests ===\n")

    total = total + 1
    if gpu_ptx_test_01_header() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01\n") }
    total = total + 1
    if gpu_ptx_test_02_has_entry() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02\n") }
    total = total + 1
    if gpu_ptx_test_03_tid_x() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03\n") }
    total = total + 1
    if gpu_ptx_test_04_load_store() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04\n") }
    total = total + 1
    if gpu_ptx_test_05_to_string_smoke() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05\n") }
    total = total + 1
    if gpu_ptx_test_06_emit_default_header() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06\n") }
    total = total + 1
    if gpu_ptx_test_07_vec3_add_op_helper() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07\n") }
    total = total + 1
    if gpu_ptx_test_08_full_kernel_deterministic() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08\n") }
    total = total + 1
    if gpu_ptx_test_09_ir_lowering_smoke() { passed = passed + 1; print("  T09 OK (IR lowering smoke)\n") } else { print("  FAIL T09\n") }
    total = total + 1
    if gpu_ptx_test_10_ir_lowering_matches_hardcoded() { passed = passed + 1; print("  T10 OK (IR = hardcoded)\n") } else { print("  FAIL T10\n") }

    // Phase 2 tests (T11-T26)
    total = total + 1
    if gpu_ptx_test_11_vec_add_f64() { passed = passed + 1; print("  T11 OK (add f64)\n") } else { print("  FAIL T11\n") }
    total = total + 1
    if gpu_ptx_test_12_vec_add_i32() { passed = passed + 1; print("  T12 OK (add i32)\n") } else { print("  FAIL T12\n") }
    total = total + 1
    if gpu_ptx_test_13_vec_add_i64() { passed = passed + 1; print("  T13 OK (add i64)\n") } else { print("  FAIL T13\n") }
    total = total + 1
    if gpu_ptx_test_14_vec_add_f32_compat() { passed = passed + 1; print("  T14 OK (add f32 compat)\n") } else { print("  FAIL T14\n") }
    total = total + 1
    if gpu_ptx_test_15_vec_sub_f32() { passed = passed + 1; print("  T15 OK (sub f32)\n") } else { print("  FAIL T15\n") }
    total = total + 1
    if gpu_ptx_test_16_vec_sub_f64() { passed = passed + 1; print("  T16 OK (sub f64)\n") } else { print("  FAIL T16\n") }
    total = total + 1
    if gpu_ptx_test_17_vec_sub_i32() { passed = passed + 1; print("  T17 OK (sub i32)\n") } else { print("  FAIL T17\n") }
    total = total + 1
    if gpu_ptx_test_18_vec_sub_i64() { passed = passed + 1; print("  T18 OK (sub i64)\n") } else { print("  FAIL T18\n") }
    total = total + 1
    if gpu_ptx_test_19_vec_mul_f32() { passed = passed + 1; print("  T19 OK (mul f32)\n") } else { print("  FAIL T19\n") }
    total = total + 1
    if gpu_ptx_test_20_vec_mul_f64() { passed = passed + 1; print("  T20 OK (mul f64)\n") } else { print("  FAIL T20\n") }
    total = total + 1
