fn gpu_ptx_test_62_setp_ge_u32() -> bool with Mut, Panic, Div, Alloc {
    var k = gpu_kernel_new()
    k.ops[0] = GpuOp {
        opcode: GpuOpcode::GpuSetpGe,
        dst_reg: 0,
        lhs_reg: 1,
        rhs_reg: 2,
        src_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU32,
        dst_ty: GpuType::GpuU32,
        src_ty: GpuType::GpuU32,
    }
    k.op_count = 1
    k.max_reg_pred = 1
    k.max_reg_u32 = 3
    let s = ptx_to_string(gpu_lower_to_ptx(k))
    ptx_str_contains(s, "setp.ge.u32") && ptx_str_contains(s, "%p0")
}

fn gpu_ptx_test_63_setp_ge_f64() -> bool with Mut, Panic, Div, Alloc {
