fn run_module_loader_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 1

    print("=== Module Loader Tests ===\n")

    if test_multimodule_compilation_available() {
        passed = passed + 1
        print("  T01 OK (multimodule function available)\n")
    } else {
        print("  FAIL: T01 multimodule function not available\n")
    }

    print("\nModule loader tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
