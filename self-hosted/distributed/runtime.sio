}

// ============================================================================
// TESTS — worker queue / assign
// ============================================================================

fn do_test_024(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    let worker = drt_assign_to_worker(rt, id)
    worker >= 0 && worker < rt.worker_count
}

fn test_024_assign_to_worker_valid_index() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_024(&! rt)
}

fn do_test_025(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    drt_assign_to_worker(rt, id)
    // check that some worker has queue_count == 1
    var found: bool = false
    var i: i64 = 0
    while i < rt.worker_count {
        if rt.workers[i].queue_count == 1 {
            found = true
        }
        i = i + 1
    }
    found
}

fn test_025_assign_enqueues_actor() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_025(&! rt)
}

fn do_test_026(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let qlen = drt_worker_queue_len(rt, 0)
    qlen == 0
}

fn test_026_worker_queue_empty_initially() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_026(&! rt)
}

fn do_test_027(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id0 = drt_spawn(rt, "a", 1)
    let id1 = drt_spawn(rt, "b", 1)
    let id2 = drt_spawn(rt, "c", 1)
    let id3 = drt_spawn(rt, "d", 1)
    drt_assign_to_worker(rt, id0)
    drt_assign_to_worker(rt, id1)
    drt_assign_to_worker(rt, id2)
    drt_assign_to_worker(rt, id3)
    // with 4 workers and 4 actors, each worker should have 1
    let q0 = drt_worker_queue_len(rt, 0)
    let q1 = drt_worker_queue_len(rt, 1)
    let q2 = drt_worker_queue_len(rt, 2)
    let q3 = drt_worker_queue_len(rt, 3)
    q0 + q1 + q2 + q3 == 4
}

fn test_027_round_robin_4_workers_4_actors() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_027(&! rt)
}

// ============================================================================
// TESTS — work stealing
// ============================================================================

fn do_test_028(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id0 = drt_spawn(rt, "a", 1)
    let id1 = drt_spawn(rt, "b", 1)
    let id2 = drt_spawn(rt, "c", 1)
    // Put all 3 into worker 0
    drt_worker_enqueue(rt, 0, id0)
    drt_worker_enqueue(rt, 0, id1)
    drt_worker_enqueue(rt, 0, id2)
    // Worker 1 steals
    let stolen = drt_steal_work(rt, 1)
    stolen >= 0
}

fn test_028_steal_from_busy_worker() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_028(&! rt)
}

fn do_test_029(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "a", 1)
    drt_worker_enqueue(rt, 0, id)
    // worker 0 steals from itself — should find no victim or victim == self
    let stolen = drt_steal_work(rt, 0)
    // Nothing to steal (no other worker has work)
    stolen == 0 - 1
}

fn test_029_steal_when_no_victims() -> bool with Mut, Panic, Div {
    var rt = drt_new(2)
    do_test_029(&! rt)
}

fn do_test_030(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id0 = drt_spawn(rt, "a", 1)
    let id1 = drt_spawn(rt, "b", 1)
    let id2 = drt_spawn(rt, "c", 1)
    drt_worker_enqueue(rt, 0, id0)
    drt_worker_enqueue(rt, 0, id1)
    drt_worker_enqueue(rt, 0, id2)
    let q_before = drt_worker_queue_len(rt, 0)
    drt_steal_work(rt, 1)
    let q_after = drt_worker_queue_len(rt, 0)
    q_before == 3 && q_after == 2
}

fn test_030_steal_reduces_victim_queue() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_030(&! rt)
}

fn do_test_031(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    // all workers empty — stealing returns -1
    let stolen = drt_steal_work(rt, 0)
    stolen == 0 - 1
}

fn test_031_steal_from_empty_runtime() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_031(&! rt)
}

// ============================================================================
// TESTS — schedule (priority ordering)
// ============================================================================

fn do_test_032(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id_lo = drt_spawn(rt, "lo", 1)
    let id_hi = drt_spawn(rt, "hi", 10)
