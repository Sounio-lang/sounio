// ============================================================================
// TESTS — mailbox wraparound
// ============================================================================

fn do_test_043(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    // Send 64 messages and recv 64 to force wraparound
    var i: i64 = 0
    while i < 64 {
        drt_send(rt, id, i)
        i = i + 1
    }
    var j: i64 = 0
    while j < 64 {
        drt_recv(rt, id)
        j = j + 1
    }
    // Now send 4 more — they should wrap around in the ring
    drt_send(rt, id, 100)
    drt_send(rt, id, 200)
    let m1 = drt_recv(rt, id)
    let m2 = drt_recv(rt, id)
    m1 == 100 && m2 == 200
}

fn test_043_mailbox_wraparound() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_043(&! rt)
}

// ============================================================================
// TESTS — multiple workers interleave
// ============================================================================

fn do_test_044(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id0 = drt_spawn(rt, "a", 1)
    let id1 = drt_spawn(rt, "b", 1)
    drt_worker_enqueue(rt, 0, id0)
    drt_worker_enqueue(rt, 1, id1)
    let q0 = drt_worker_queue_len(rt, 0)
    let q1 = drt_worker_queue_len(rt, 1)
    q0 == 1 && q1 == 1
}

fn test_044_two_workers_each_one_actor() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_044(&! rt)
}

