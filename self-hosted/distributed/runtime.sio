// ============================================================================
// TESTS — steal from multi-worker setup
// ============================================================================

fn do_test_069(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    // load worker 0 with 5, worker 1 with 2, worker 2 with 1
    var i: i64 = 0
    while i < 5 {
        drt_worker_enqueue(rt, 0, i)
        i = i + 1
    }
    drt_worker_enqueue(rt, 1, 10)
    drt_worker_enqueue(rt, 1, 11)
    drt_worker_enqueue(rt, 2, 20)
    // worker 3 steals — should pick from worker 0 (busiest)
    drt_steal_work(rt, 3)
    let q0 = drt_worker_queue_len(rt, 0)
    q0 == 4
}

fn test_069_steal_picks_busiest_worker() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_069(&! rt)
}

