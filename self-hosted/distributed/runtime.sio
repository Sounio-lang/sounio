    let id1 = drt_spawn(rt, "y", 2)
    let id2 = drt_spawn(rt, "z", 3)
    let fx = drt_find_actor(rt, "x")
    let fy = drt_find_actor(rt, "y")
    let fz = drt_find_actor(rt, "z")
