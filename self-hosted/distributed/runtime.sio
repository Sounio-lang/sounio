// ============================================================================
// TESTS — mailbox overflow
// ============================================================================

fn do_test_040(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    var i: i64 = 0
    while i < 128 {
        drt_send(rt, id, i)
        i = i + 1
    }
    // 129th send should fail (mailbox cap = 128)
    let ok = drt_send(rt, id, 999)
    !ok && drt_mailbox_len(rt, id) == 128
}

