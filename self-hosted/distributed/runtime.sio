// ============================================================================
// TESTS — send / recv messages
// ============================================================================

fn do_test_016(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    let ok = drt_send(rt, id, 42)
    let msg = drt_recv(rt, id)
    ok && msg == 42
}

fn test_016_send_recv_basic() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_016(&! rt)
}

fn do_test_017(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    drt_send(rt, id, 10)
    drt_send(rt, id, 20)
    drt_send(rt, id, 30)
    let m1 = drt_recv(rt, id)
    let m2 = drt_recv(rt, id)
    let m3 = drt_recv(rt, id)
    m1 == 10 && m2 == 20 && m3 == 30
}

fn test_017_mailbox_fifo_order() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_017(&! rt)
}

fn do_test_018(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    let msg = drt_recv(rt, id)
    msg == 0 - 1
}

fn test_018_recv_empty_returns_neg1() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_018(&! rt)
}

fn do_test_019(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    drt_send(rt, id, 100)
    drt_mailbox_len(rt, id) == 1
}

fn test_019_mailbox_len_after_send() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_019(&! rt)
}

fn do_test_020(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 1)
    drt_send(rt, id, 1)
    drt_send(rt, id, 2)
    drt_recv(rt, id)
    drt_mailbox_len(rt, id) == 1
}

fn test_020_mailbox_len_decrements_after_recv() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_020(&! rt)
}

