// self-hosted::distributed::runtime — Actor registry + work-stealing scheduler
//
// Fixed-capacity actor runtime. Actors have a name, mailbox ring-buffer,
// priority, and status. Workers hold a queue of actor IDs and steal work
// from each other when idle.
// Prefix: drt_

// ============================================================================
// CONSTANTS
// ============================================================================

fn DRT_IDLE() -> i64 { 0 }
fn DRT_RUNNING() -> i64 { 1 }
fn DRT_BLOCKED() -> i64 { 2 }
fn DRT_DEAD() -> i64 { 3 }

// ============================================================================
// STRUCTS
// ============================================================================

struct DrtActor {
    id: i64,
    name: [i64; 64],
    name_len: i64,
    status: i64,
    mailbox: [i64; 128],
    mailbox_head: i64,
    mailbox_tail: i64,
    mailbox_count: i64,
    priority: i64,
}

struct DrtWorker {
    id: i64,
    queue: [i64; 64],
    queue_head: i64,
    queue_tail: i64,
    queue_count: i64,
    busy: bool,
}

struct DrtRuntime {
    actors: [DrtActor; 256],
    actor_count: i64,
    workers: [DrtWorker; 16],
    worker_count: i64,
    next_id: i64,
}

// ============================================================================
// HELPERS — blank structs
// ============================================================================

fn drt_blank_actor(id: i64) -> DrtActor {
    DrtActor {
        id: id,
        name: [0; 64],
        name_len: 0,
        status: DRT_IDLE(),
        mailbox: [0; 128],
        mailbox_head: 0,
        mailbox_tail: 0,
        mailbox_count: 0,
        priority: 0,
    }
}

fn drt_blank_worker(id: i64) -> DrtWorker {
    DrtWorker {
        id: id,
        queue: [0; 64],
        queue_head: 0,
        queue_tail: 0,
        queue_count: 0,
        busy: false,
    }
}

// ============================================================================
// HELPERS — name encoding
// ============================================================================

fn drt_encode_name(name: string, actor: &! DrtActor) -> () with Mut, Panic, Div {
    let len = str_len(name)
    var cap: i64 = len
    if cap > 64 {
        cap = 64
    }
    var i: i64 = 0
    while i < cap {
        actor.name[i] = str_char_at(name, i) as i64
        i = i + 1
    }
    actor.name_len = cap
}

fn drt_name_eq(actor: &DrtActor, name: string) -> bool with Mut, Panic, Div {
    let len = str_len(name)
    if actor.name_len != len {
        return false
    }
    var i: i64 = 0
    while i < len {
        if actor.name[i] != str_char_at(name, i) as i64 {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

fn drt_new(worker_count: i64) -> DrtRuntime with Mut, Panic, Div {
    var actual: i64 = worker_count
    if actual > 16 {
        actual = 16
    }
    if actual < 1 {
        actual = 1
    }
    var rt = DrtRuntime {
        actors: [DrtActor {
            id: 0,
            name: [0; 64],
            name_len: 0,
            status: 0,
            mailbox: [0; 128],
            mailbox_head: 0,
            mailbox_tail: 0,
            mailbox_count: 0,
            priority: 0,
        }; 256],
        actor_count: 0,
        workers: [DrtWorker {
            id: 0,
            queue: [0; 64],
            queue_head: 0,
            queue_tail: 0,
            queue_count: 0,
            busy: false,
        }; 16],
        worker_count: actual,
        next_id: 0,
    }
    // Initialise worker IDs
    var i: i64 = 0
    while i < actual {
        rt.workers[i] = drt_blank_worker(i)
        i = i + 1
    }
    rt
}

// ============================================================================
// SPAWN
// ============================================================================

fn drt_spawn(rt: &! DrtRuntime, name: string, priority: i64) -> i64 with Mut, Panic, Div {
    if rt.actor_count >= 256 {
        return 0 - 1
    }
    let id = rt.next_id
    var actor = drt_blank_actor(id)
    actor.priority = priority
    actor.status = DRT_IDLE()
    drt_encode_name(name, &! actor)
    rt.actors[id] = actor
    rt.actor_count = rt.actor_count + 1
    rt.next_id = rt.next_id + 1
    id
}

// ============================================================================
// QUERIES
// ============================================================================

fn drt_actor_count(rt: &DrtRuntime) -> i64 {
    rt.actor_count
}

fn drt_find_actor(rt: &DrtRuntime, name: string) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < rt.actor_count {
        if drt_name_eq(&rt.actors[i], name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn drt_actor_status(rt: &DrtRuntime, actor_id: i64) -> i64 with Panic {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return 0 - 1
    }
    rt.actors[actor_id].status
}

fn drt_mailbox_len(rt: &DrtRuntime, actor_id: i64) -> i64 with Panic {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return 0
    }
    rt.actors[actor_id].mailbox_count
}

// ============================================================================
// SEND / RECV
// ============================================================================

fn drt_send(rt: &! DrtRuntime, actor_id: i64, msg: i64) -> bool with Mut, Panic, Div {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return false
    }
    if rt.actors[actor_id].status == DRT_DEAD() {
        return false
    }
    if rt.actors[actor_id].mailbox_count >= 128 {
        return false
    }
    let tail = rt.actors[actor_id].mailbox_tail
    rt.actors[actor_id].mailbox[tail] = msg
    rt.actors[actor_id].mailbox_tail = (tail + 1) % 128
    rt.actors[actor_id].mailbox_count = rt.actors[actor_id].mailbox_count + 1
    true
}

fn drt_recv(rt: &! DrtRuntime, actor_id: i64) -> i64 with Mut, Panic, Div {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return 0 - 1
    }
    if rt.actors[actor_id].mailbox_count == 0 {
        return 0 - 1
    }
    let head = rt.actors[actor_id].mailbox_head
    let msg = rt.actors[actor_id].mailbox[head]
    rt.actors[actor_id].mailbox_head = (head + 1) % 128
    rt.actors[actor_id].mailbox_count = rt.actors[actor_id].mailbox_count - 1
    msg
}

// ============================================================================
// KILL
// ============================================================================

fn drt_kill(rt: &! DrtRuntime, actor_id: i64) -> () with Mut, Panic {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return ()
    }
    rt.actors[actor_id].status = DRT_DEAD()
}

// ============================================================================
// WORKER QUEUE HELPERS
// ============================================================================

fn drt_worker_enqueue(rt: &! DrtRuntime, worker_id: i64, actor_id: i64) -> bool with Mut, Panic, Div {
    if worker_id < 0 || worker_id >= rt.worker_count {
        return false
    }
    if rt.workers[worker_id].queue_count >= 64 {
        return false
    }
    let tail = rt.workers[worker_id].queue_tail
    rt.workers[worker_id].queue[tail] = actor_id
    rt.workers[worker_id].queue_tail = (tail + 1) % 64
    rt.workers[worker_id].queue_count = rt.workers[worker_id].queue_count + 1
    true
}

fn drt_worker_dequeue(rt: &! DrtRuntime, worker_id: i64) -> i64 with Mut, Panic, Div {
    if worker_id < 0 || worker_id >= rt.worker_count {
        return 0 - 1
    }
    if rt.workers[worker_id].queue_count == 0 {
        return 0 - 1
    }
    let head = rt.workers[worker_id].queue_head
    let actor_id = rt.workers[worker_id].queue[head]
    rt.workers[worker_id].queue_head = (head + 1) % 64
    rt.workers[worker_id].queue_count = rt.workers[worker_id].queue_count - 1
    actor_id
}

fn drt_worker_queue_len(rt: &DrtRuntime, worker_id: i64) -> i64 with Panic {
    if worker_id < 0 || worker_id >= rt.worker_count {
        return 0
    }
    rt.workers[worker_id].queue_count
}

// ============================================================================
// ASSIGN TO WORKER
// ============================================================================

fn drt_assign_to_worker(rt: &! DrtRuntime, actor_id: i64) -> i64 with Mut, Panic, Div {
    if actor_id < 0 || actor_id >= rt.actor_count {
        return 0 - 1
    }
    // Round-robin: pick worker with smallest queue
    var best_worker: i64 = 0
    var best_count: i64 = rt.workers[0].queue_count
    var i: i64 = 1
    while i < rt.worker_count {
        if rt.workers[i].queue_count < best_count {
            best_count = rt.workers[i].queue_count
            best_worker = i
        }
        i = i + 1
    }
    drt_worker_enqueue(rt, best_worker, actor_id)
    best_worker
}

// ============================================================================
// SCHEDULE
// ============================================================================

// Returns the highest-priority runnable actor_id, or -1 if none.
fn drt_schedule(rt: &! DrtRuntime) -> i64 with Mut, Panic, Div {
    var best_id: i64 = 0 - 1
    var best_priority: i64 = 0 - 1
    var i: i64 = 0
    while i < rt.actor_count {
        let s = rt.actors[i].status
        if s == DRT_IDLE() || s == DRT_RUNNING() {
            if rt.actors[i].mailbox_count > 0 {
                if rt.actors[i].priority > best_priority {
                    best_priority = rt.actors[i].priority
                    best_id = i
                }
            }
        }
        i = i + 1
    }
    best_id
}

// ============================================================================
// WORK STEALING
// ============================================================================

// drt_steal_work — worker steals one actor_id from the busiest other worker.
// Returns the stolen actor_id or -1 if nothing to steal.
fn drt_steal_work(rt: &! DrtRuntime, worker_id: i64) -> i64 with Mut, Panic, Div {
    if worker_id < 0 || worker_id >= rt.worker_count {
        return 0 - 1
    }
    // Find the worker with the most work (excluding self)
    var victim: i64 = 0 - 1
    var max_count: i64 = 0
    var i: i64 = 0
    while i < rt.worker_count {
        if i != worker_id {
            if rt.workers[i].queue_count > max_count {
                max_count = rt.workers[i].queue_count
                victim = i
            }
        }
        i = i + 1
    }
    if victim == 0 - 1 {
        return 0 - 1
    }
    if max_count == 0 {
        return 0 - 1
    }
    // Steal one actor from victim
    drt_worker_dequeue(rt, victim)
}

// ============================================================================
// COUNTS
// ============================================================================

fn drt_running_count(rt: &DrtRuntime) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var i: i64 = 0
    while i < rt.actor_count {
        if rt.actors[i].status == DRT_RUNNING() {
            n = n + 1
        }
        i = i + 1
    }
    n
}

fn drt_idle_count(rt: &DrtRuntime) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var i: i64 = 0
    while i < rt.actor_count {
        if rt.actors[i].status == DRT_IDLE() {
            n = n + 1
        }
        i = i + 1
    }
    n
}

// ============================================================================
// TESTS — constants
// ============================================================================

fn test_001_drt_idle_is_0() -> bool {
    DRT_IDLE() == 0
}

fn test_002_drt_running_is_1() -> bool {
    DRT_RUNNING() == 1
}

fn test_003_drt_blocked_is_2() -> bool {
    DRT_BLOCKED() == 2
}

fn test_004_drt_dead_is_3() -> bool {
    DRT_DEAD() == 3
}

// ============================================================================
// TESTS — constructor
// ============================================================================

fn test_005_new_runtime_actor_count_zero() -> bool with Mut, Panic, Div {
    let rt = drt_new(4)
    drt_actor_count(&rt) == 0
}

fn test_006_new_runtime_worker_count() -> bool with Mut, Panic, Div {
    let rt = drt_new(4)
    rt.worker_count == 4
}

fn test_007_new_runtime_worker_count_capped() -> bool with Mut, Panic, Div {
    let rt = drt_new(100)
    rt.worker_count == 16
}

fn test_008_new_runtime_worker_count_min_1() -> bool with Mut, Panic, Div {
    let rt = drt_new(0)
    rt.worker_count == 1
}

// ============================================================================
// TESTS — spawn actors
// ============================================================================

fn do_test_009(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "worker1", 1)
    id == 0 && drt_actor_count(rt) == 1
}

fn test_009_spawn_first_actor() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_009(&! rt)
}

fn do_test_010(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id0 = drt_spawn(rt, "a", 1)
    let id1 = drt_spawn(rt, "b", 2)
    let id2 = drt_spawn(rt, "c", 3)
    id0 == 0 && id1 == 1 && id2 == 2 && drt_actor_count(rt) == 3
}

fn test_010_spawn_three_actors() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_010(&! rt)
}

fn do_test_011(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 5)
    drt_actor_status(rt, id) == DRT_IDLE()
}

fn test_011_spawned_actor_is_idle() -> bool with Mut, Panic, Div {
    var rt = drt_new(4)
    do_test_011(&! rt)
}

fn do_test_012(rt: &! DrtRuntime) -> bool with Mut, Panic, Div {
    let id = drt_spawn(rt, "w", 7)
    drt_mailbox_len(rt, id) == 0
}

fn test_012_spawned_actor_empty_mailbox() -> bool with Mut, Panic, Div {
