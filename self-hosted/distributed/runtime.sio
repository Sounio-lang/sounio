    let id2 = drt_spawn(rt, "c", 1)
    drt_worker_enqueue(rt, 0, id0)
    drt_worker_enqueue(rt, 0, id1)
    drt_worker_enqueue(rt, 0, id2)
    let stolen = drt_steal_work(rt, 1)
    let q0_after = drt_worker_queue_len(rt, 0)
    stolen == id0 && q0_after == 2
}

