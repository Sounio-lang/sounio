// TESTS — multiple trees independent
// ============================================================================

fn do_test_058(t1: &! SupTree, t2: &! SupTree) -> bool with Mut, Panic, Div {
    let id1 = sup_add_child(t1, "a", 3)
    let id2 = sup_add_child(t2, "b", 5)
    sup_start_child(t1, id1)
    sup_start_child(t2, id2)
    let s1 = sup_running_count(t1)
    let s2 = sup_running_count(t2)
    s1 == 1 && s2 == 1
}

