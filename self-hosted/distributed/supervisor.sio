fn do_test_054(t: &! SupTree) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 64 {
        sup_add_child(t, "w", 3)
        i = i + 1
    }
    // 65th should return -1 (cap)
    let id_extra = sup_add_child(t, "overflow", 3)
    sup_child_count(t) == 64 && id_extra == 0 - 1
}

