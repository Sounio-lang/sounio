// ============================================================================
// TESTS — one-for-all with many children
// ============================================================================

fn do_test_046(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id0 = sup_add_child(t, "a", 5)
    let id1 = sup_add_child(t, "b", 5)
    let id2 = sup_add_child(t, "c", 5)
    let id3 = sup_add_child(t, "d", 5)
    sup_start_child(t, id0)
    sup_start_child(t, id1)
    sup_start_child(t, id2)
    sup_start_child(t, id3)
    sup_handle_failure(t, id2)
    let s0 = sup_child_status(t, id0)
    let s1 = sup_child_status(t, id1)
    let s2 = sup_child_status(t, id2)
    let s3 = sup_child_status(t, id3)
    s0 == SUP_RUNNING() && s1 == SUP_RUNNING() && s2 == SUP_RUNNING() && s3 == SUP_RUNNING()
}

fn test_046_one_for_all_restarts_all_four() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_ONE_FOR_ALL(), 10)
    do_test_046(&! t)
}

// ============================================================================
// TESTS — max restarts with one-for-one
// ============================================================================

fn do_test_047(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id = sup_add_child(t, "w", 1)
    sup_start_child(t, id)
    // 1 restart allowed: first fail => RESTART
    let a1 = sup_handle_failure(t, id)
    // 2nd fail => ESCALATE (restart_count = 1, max = 1, 1 < 1 is false)
    let a2 = sup_handle_failure(t, id)
    a1 == SUP_ACTION_RESTART() && a2 == SUP_ACTION_ESCALATE()
}

fn test_047_max_restarts_1_escalates_on_second() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_ONE_FOR_ONE(), 10)
    do_test_047(&! t)
}

fn do_test_048(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id = sup_add_child(t, "w", 0)
    sup_start_child(t, id)
    // max_restarts=0 means restart_count (0) < 0 is false => immediate escalate
    let action = sup_handle_failure(t, id)
    action == SUP_ACTION_ESCALATE()
}

fn test_048_max_restarts_0_always_escalates() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_ONE_FOR_ONE(), 10)
    do_test_048(&! t)
}

// ============================================================================
// TESTS — stop and then fail
// ============================================================================

fn do_test_049(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id = sup_add_child(t, "w", 5)
    // child is stopped, not running — fail_child marks it FAILED and increments
    sup_fail_child(t, id)
    sup_child_status(t, id) == SUP_FAILED()
}

fn test_049_fail_stopped_child_marks_failed() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_ONE_FOR_ONE(), 5)
    do_test_049(&! t)
}

// ============================================================================
// TESTS — rest-for-one middle child
// ============================================================================

fn do_test_050(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id0 = sup_add_child(t, "a", 5)
    let id1 = sup_add_child(t, "b", 5)
    let id2 = sup_add_child(t, "c", 5)
    let id3 = sup_add_child(t, "d", 5)
    sup_start_child(t, id0)
    sup_start_child(t, id1)
    sup_start_child(t, id2)
    sup_start_child(t, id3)
    // fail id1: rest-for-one should stop id2,id3 then restart id1,id2,id3
    sup_handle_failure(t, id1)
    let s0 = sup_child_status(t, id0)
    let s1 = sup_child_status(t, id1)
    let s2 = sup_child_status(t, id2)
    let s3 = sup_child_status(t, id3)
    // id0 should stay running (before id1), id1/id2/id3 should be running
    s0 == SUP_RUNNING() && s1 == SUP_RUNNING() && s2 == SUP_RUNNING() && s3 == SUP_RUNNING()
}

fn test_050_rest_for_one_middle_child() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_REST_FOR_ONE(), 10)
    do_test_050(&! t)
}

