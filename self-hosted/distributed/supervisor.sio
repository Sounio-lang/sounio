// ============================================================================
// TESTS — failed count after one-for-all
// ============================================================================

fn do_test_059(t: &! SupTree) -> bool with Mut, Panic, Div {
    let id0 = sup_add_child(t, "a", 5)
    let id1 = sup_add_child(t, "b", 5)
    sup_start_child(t, id0)
    sup_start_child(t, id1)
    // one-for-all: when child fails and restarts, status goes back to RUNNING
    sup_handle_failure(t, id0)
    // After handle_failure with one-for-all, the failed child is restarted
    sup_failed_count(t) == 0
}

fn test_059_no_failed_children_after_afa_restart() -> bool with Mut, Panic, Div {
    var t = sup_new(SUP_ONE_FOR_ALL(), 10)
    do_test_059(&! t)
}

