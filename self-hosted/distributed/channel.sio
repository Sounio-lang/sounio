// ============================================================================
// TESTS — capacity boundary
// ============================================================================

fn test_026_cap_capped_at_256() -> bool with Mut, Panic, Div {
    var ch = ch_new(999)
    ch_cap(&ch) == 256
}

fn test_027_cap_min_1() -> bool with Mut, Panic, Div {
    var ch = ch_new(0)
    ch_cap(&ch) == 1
}

fn do_test_028(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    var ok: bool = true
    var i: i64 = 0
    while i < 256 {
        let s = ch_send(ch, i)
        if s != CH_OK() {
            ok = false
        }
        i = i + 1
    }
    let s_extra = ch_send(ch, 999)
    ok && s_extra == CH_FULL()
}

fn test_028_full_256_cap() -> bool with Mut, Panic, Div {
    var ch = ch_new(256)
    do_test_028(&! ch)
}

fn do_test_029(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_recv(ch)
    ch_len(ch) == 0
}

fn test_029_len_zero_after_single_cycle() -> bool with Mut, Panic, Div {
    var ch = ch_new(1)
    do_test_029(&! ch)
}

fn do_test_030(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    let full1 = ch_is_full(ch)
    ch_recv(ch)
    let empty1 = ch_is_empty(ch)
    full1 && empty1
}

fn test_030_single_slot_full_empty() -> bool with Mut, Panic, Div {
    var ch = ch_new(1)
    do_test_030(&! ch)
}

// ============================================================================
// TESTS — drain
// ============================================================================

fn do_test_031(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    ch_send(ch, 10)
    ch_send(ch, 20)
    ch_send(ch, 30)
    let n = ch_drain(ch, out)
    let ok1 = n == 3
    let ok2 = out[0] == 10
    let ok3 = out[1] == 20
    let ok4 = out[2] == 30
    let ok5 = ch_is_empty(ch)
    ok1 && ok2 && ok3 && ok4 && ok5
}

fn test_031_drain_basic() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_031(&! ch, &! out)
}

fn do_test_032(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    let n = ch_drain(ch, out)
    n == 0 && ch_is_empty(ch)
}

fn test_032_drain_empty_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_032(&! ch, &! out)
}

fn do_test_033(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_send(ch, 2)
    ch_send(ch, 3)
    ch_send(ch, 4)
    ch_send(ch, 5)
    let n = ch_drain(ch, out)
    n == 5
}

fn test_033_drain_multiple() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_033(&! ch, &! out)
}

fn do_test_034(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    ch_send(ch, 99)
    ch_close(ch)
    let n = ch_drain(ch, out)
    n == 1 && out[0] == 99
}

fn test_034_drain_from_closed_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_034(&! ch, &! out)
}

// ============================================================================
// TESTS — select
// ============================================================================

fn do_test_035(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 10)
    ch_select_add(sel, 20)
    ch_select_count(sel) == 2
}

fn test_035_select_add_entries() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_035(&! sel)
}

fn test_036_select_ready_minus1_initially() -> bool with Mut {
    let sel = ch_select_new()
    ch_select_ready(&sel) == 0 - 1
}

fn do_test_037(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 5)
    ch_select_add(sel, 6)
    ch_select_mark_ready(sel, 0, 42)
    ch_select_ready(sel) == 0
}

fn test_037_select_mark_ready() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_037(&! sel)
}

fn do_test_038(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 100)
    ch_select_mark_ready(sel, 0, 77)
    let idx = ch_select_ready(sel)
    let entry = sel.entries[0]
    idx == 0 && entry.ready && entry.value == 77
}

fn test_038_select_entry_value() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_038(&! sel)
}

fn do_test_039(sel: &! ChSelect) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 16 {
        ch_select_add(sel, i)
        i = i + 1
    }
    // 17th add should be ignored
    ch_select_add(sel, 999)
    ch_select_count(sel) == 16
}

fn test_039_select_max_16_entries() -> bool with Mut, Panic, Div {
    var sel = ch_select_new()
    do_test_039(&! sel)
}

fn do_test_040(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 1)
    ch_select_add(sel, 2)
    ch_select_add(sel, 3)
    ch_select_mark_ready(sel, 2, 55)
    ch_select_ready(sel) == 2
}

fn test_040_select_mark_last_ready() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_040(&! sel)
}

