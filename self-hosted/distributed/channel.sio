// ============================================================================
// TESTS — multiple values, various caps
// ============================================================================

fn do_test_048(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 100)
    ch_send(ch, 200)
    ch_send(ch, 300)
    let v1 = ch_recv(ch)
    ch_send(ch, 400)
    let v2 = ch_recv(ch)
    let v3 = ch_recv(ch)
    let v4 = ch_recv(ch)
    v1 == 100 && v2 == 200 && v3 == 300 && v4 == 400
}

fn test_048_interleaved_send_recv() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_048(&! ch)
}

fn do_test_049(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 10 {
        ch_send(ch, i * 10)
        i = i + 1
    }
    var j: i64 = 0
    var ok: bool = true
    while j < 10 {
        let v = ch_recv(ch)
        if v != j * 10 {
            ok = false
        }
        j = j + 1
    }
    ok
}

fn test_049_batch_send_recv() -> bool with Mut, Panic, Div {
    var ch = ch_new(16)
    do_test_049(&! ch)
}

fn do_test_050(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 8 {
        ch_send(ch, i)
        i = i + 1
    }
    ch_len(ch) == 8
}

fn test_050_len_after_batch_send() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_050(&! ch)
}

fn do_test_051(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 0 - 1)
    let v = ch_recv(ch)
    v == 0 - 1
}

fn test_051_send_negative_value() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_051(&! ch)
}

fn do_test_052(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 0)
    let v = ch_recv(ch)
    v == 0
}

fn test_052_send_zero_value() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_052(&! ch)
}

fn do_test_053(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 9999999)
    let v = ch_recv(ch)
    v == 9999999
}

fn test_053_send_large_value() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_053(&! ch)
}

