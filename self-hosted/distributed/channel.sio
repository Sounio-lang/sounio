// self-hosted::distributed::channel — Typed async ring-buffer channel
//
// A bounded FIFO channel backed by a fixed-size ring buffer.
// All operations are O(1). Capacity is capped at 256 slots.
// Prefix: ch_

// ============================================================================
// CONSTANTS (as functions to avoid forward-ref issues)
// ============================================================================

fn CH_OK() -> i64 { 0 }
fn CH_EMPTY() -> i64 { 1 }
fn CH_FULL() -> i64 { 2 }
fn CH_CLOSED() -> i64 { 3 }

// ============================================================================
// STRUCTS
// ============================================================================

struct ChBuf {
    data: [i64; 256],
    head: i64,
    tail: i64,
    cap: i64,
    count: i64,
    closed: bool,
}

struct ChSelectEntry {
    buf_id: i64,
    ready: bool,
    value: i64,
}

struct ChSelect {
    entries: [ChSelectEntry; 16],
    count: i64,
    ready_idx: i64,
}

// ============================================================================
// CHANNEL CONSTRUCTOR
// ============================================================================

fn ch_new(cap: i64) -> ChBuf with Mut {
    var actual_cap: i64 = cap
    if actual_cap > 256 {
        actual_cap = 256
    }
    if actual_cap < 1 {
        actual_cap = 1
    }
    ChBuf {
        data: [0; 256],
        head: 0,
        tail: 0,
        cap: actual_cap,
        count: 0,
        closed: false,
    }
}

// ============================================================================
// CORE SEND / RECV
// ============================================================================

fn ch_send(ch: &! ChBuf, val: i64) -> i64 with Mut, Panic, Div {
    if ch.closed {
        return CH_CLOSED()
    }
    if ch.count >= ch.cap {
        return CH_FULL()
    }
    ch.data[ch.tail] = val
    ch.tail = (ch.tail + 1) % ch.cap
    ch.count = ch.count + 1
    CH_OK()
}

fn ch_recv(ch: &! ChBuf) -> i64 with Mut, Panic, Div {
    if ch.count == 0 {
        return 0 - 1
    }
    let val = ch.data[ch.head]
    ch.head = (ch.head + 1) % ch.cap
    ch.count = ch.count - 1
    val
}

fn ch_recv_status(ch: &! ChBuf) -> i64 with Mut, Panic, Div {
    if ch.closed && ch.count == 0 {
        return CH_CLOSED()
    }
    if ch.count == 0 {
        return CH_EMPTY()
    }
    CH_OK()
}

// ============================================================================
// NON-BLOCKING OPS
// ============================================================================

fn ch_try_send(ch: &! ChBuf, val: i64) -> bool with Mut, Panic, Div {
    let status = ch_send(ch, val)
    status == CH_OK()
}

fn ch_try_recv(ch: &! ChBuf) -> i64 with Mut, Panic, Div {
    if ch.count == 0 {
        return 0 - 1
    }
    ch_recv(ch)
}

// ============================================================================
// CLOSE
// ============================================================================

fn ch_close(ch: &! ChBuf) -> () with Mut {
    ch.closed = true
}

fn ch_is_closed(ch: &ChBuf) -> bool {
    ch.closed
}

// ============================================================================
// QUERIES
// ============================================================================

fn ch_len(ch: &ChBuf) -> i64 {
    ch.count
}

fn ch_cap(ch: &ChBuf) -> i64 {
    ch.cap
}

fn ch_is_empty(ch: &ChBuf) -> bool {
    ch.count == 0
}

fn ch_is_full(ch: &ChBuf) -> bool {
    ch.count >= ch.cap
}

// ============================================================================
// DRAIN
// ============================================================================

fn ch_drain(ch: &! ChBuf, out: &! [i64; 256]) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    while ch.count > 0 {
        let val = ch_recv(ch)
        out[n] = val
        n = n + 1
    }
    n
}

// ============================================================================
// SELECT
// ============================================================================

fn ch_select_entry_new(buf_id: i64) -> ChSelectEntry {
    ChSelectEntry {
        buf_id: buf_id,
        ready: false,
        value: 0,
    }
}

fn ch_select_new() -> ChSelect with Mut {
    ChSelect {
        entries: [ChSelectEntry { buf_id: 0, ready: false, value: 0 }; 16],
        count: 0,
        ready_idx: 0 - 1,
    }
}

fn ch_select_add(sel: &! ChSelect, buf_id: i64) -> () with Mut, Panic {
    if sel.count >= 16 {
        return ()
    }
    sel.entries[sel.count] = ChSelectEntry { buf_id: buf_id, ready: false, value: 0 }
    sel.count = sel.count + 1
}

fn ch_select_mark_ready(sel: &! ChSelect, idx: i64, value: i64) -> () with Mut, Panic {
    sel.entries[idx] = ChSelectEntry {
        buf_id: sel.entries[idx].buf_id,
        ready: true,
        value: value,
    }
    sel.ready_idx = idx
}

fn ch_select_ready(sel: &ChSelect) -> i64 {
    sel.ready_idx
}

fn ch_select_count(sel: &ChSelect) -> i64 {
    sel.count
}

// ============================================================================
// TESTS — channel send / recv basics
// ============================================================================

fn do_test_001(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    let s = ch_send(ch, 42)
    let v = ch_recv(ch)
    s == CH_OK() && v == 42
}

fn test_001_send_recv_basic() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_001(&! ch)
}

fn do_test_002(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 10)
    ch_send(ch, 20)
    ch_send(ch, 30)
    let v1 = ch_recv(ch)
    let v2 = ch_recv(ch)
    let v3 = ch_recv(ch)
    v1 == 10 && v2 == 20 && v3 == 30
}

fn test_002_fifo_ordering() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_002(&! ch)
}

fn do_test_003(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    let s1 = ch_send(ch, 1)
    let s2 = ch_send(ch, 2)
    let s3 = ch_send(ch, 3)
    let s4 = ch_send(ch, 4)
    // 5th send into capacity-4 channel must fail
    let s5 = ch_send(ch, 5)
    s1 == CH_OK() && s2 == CH_OK() && s3 == CH_OK() && s4 == CH_OK() && s5 == CH_FULL()
}

fn test_003_send_full() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_003(&! ch)
}

fn test_004_recv_empty_returns_neg1() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    let v = ch_recv(&! ch)
    v == 0 - 1
}

fn do_test_005(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 100)
    ch_recv(ch)
    ch_send(ch, 200)
    ch_recv(ch)
    ch_len(ch) == 0
}

fn test_005_len_tracks_count() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_005(&! ch)
}

fn test_006_cap_reported_correctly() -> bool with Mut, Panic, Div {
    var ch = ch_new(16)
    ch_cap(&ch) == 16
}

fn test_007_is_empty_on_new_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    ch_is_empty(&ch)
}

fn do_test_008(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_send(ch, 2)
    ch_send(ch, 3)
    ch_send(ch, 4)
    ch_is_full(ch)
}

fn test_008_is_full_when_at_capacity() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_008(&! ch)
}

fn do_test_009(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_send(ch, 2)
    ch_send(ch, 3)
    ch_send(ch, 4)
    ch_recv(ch)
    !ch_is_full(ch)
}

fn test_009_not_full_after_recv() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_009(&! ch)
}

// ============================================================================
// TESTS — ring buffer wraparound
// ============================================================================

fn do_test_010(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    // fill
    ch_send(ch, 10)
    ch_send(ch, 20)
    ch_send(ch, 30)
    ch_send(ch, 40)
    // drain two
    ch_recv(ch)
    ch_recv(ch)
    // add two more (wraps tail)
    ch_send(ch, 50)
    ch_send(ch, 60)
    let v1 = ch_recv(ch)
    let v2 = ch_recv(ch)
    let v3 = ch_recv(ch)
    let v4 = ch_recv(ch)
    v1 == 30 && v2 == 40 && v3 == 50 && v4 == 60
}

fn test_010_wraparound_basic() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_010(&! ch)
}

fn do_test_011(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 8 {
        ch_send(ch, i)
        ch_recv(ch)
        i = i + 1
    }
    ch_len(ch) == 0
}

fn test_011_wraparound_many_cycles() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_011(&! ch)
}

fn do_test_012(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_recv(ch)
    ch_send(ch, 2)
    ch_recv(ch)
    ch_send(ch, 3)
    ch_recv(ch)
    ch_send(ch, 4)
    let v = ch_recv(ch)
    v == 4
}

fn test_012_single_slot_fifo() -> bool with Mut, Panic, Div {
    var ch = ch_new(1)
    do_test_012(&! ch)
}

fn do_test_013(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 77)
    ch_send(ch, 88)
    ch_recv(ch)
    ch_recv(ch)
    let v = ch_recv(ch)
    v == 0 - 1
}

fn test_013_recv_after_drain_returns_neg1() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_013(&! ch)
}

