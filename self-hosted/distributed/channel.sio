fn test_054_not_closed_on_creation() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    !ch_is_closed(&ch)
}

fn do_test_055(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_close(ch)
    ch_close(ch)
    ch_is_closed(ch)
