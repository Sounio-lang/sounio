// ============================================================================

fn test_056_cap_2_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(2)
    ch_cap(&ch) == 2
}

fn test_057_cap_32_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(32)
    ch_cap(&ch) == 32
}

fn test_058_cap_128_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(128)
    ch_cap(&ch) == 128
}

// ============================================================================
// TESTS — wraparound edge cases
// ============================================================================

fn do_test_059(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    // fill cap-1 times, drain cap-1 times, then fill again
    ch_send(ch, 1)
    ch_send(ch, 2)
    ch_recv(ch)
    ch_recv(ch)
    ch_send(ch, 3)
    ch_send(ch, 4)
    let v1 = ch_recv(ch)
    let v2 = ch_recv(ch)
    v1 == 3 && v2 == 4
}

fn test_059_wraparound_at_cap_2() -> bool with Mut, Panic, Div {
    var ch = ch_new(2)
    do_test_059(&! ch)
}

fn do_test_060(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    // alternating single send/recv 256 times to cycle entire ring
    var i: i64 = 0
    var ok: bool = true
    while i < 16 {
        ch_send(ch, i * 3)
        let v = ch_recv(ch)
        if v != i * 3 {
            ok = false
        }
        i = i + 1
    }
    ok
}

fn test_060_alternating_single_wrap() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_060(&! ch)
}

// ============================================================================
// TESTS — len tracking
// ============================================================================

fn do_test_061(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    let l0 = ch_len(ch)
    ch_send(ch, 1)
    let l1 = ch_len(ch)
    ch_send(ch, 2)
    let l2 = ch_len(ch)
    ch_recv(ch)
    let l3 = ch_len(ch)
    l0 == 0 && l1 == 1 && l2 == 2 && l3 == 1
}

fn test_061_len_increments_decrements() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_061(&! ch)
}

fn do_test_062(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_send(ch, 2)
    ch_send(ch, 3)
    let n = ch_len(ch)
    n == 3
}

fn test_062_len_equals_3_after_3_sends() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    do_test_062(&! ch)
}

