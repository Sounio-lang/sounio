fn do_test_069(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_close(ch)
    let v = ch_recv(ch)
    v == 0 - 1
}

fn test_069_recv_closed_empty_returns_neg1() -> bool with Mut, Panic, Div {
    var ch = ch_new(4)
    do_test_069(&! ch)
}

// ============================================================================
// TESTS — mixed states
// ============================================================================

fn do_test_070(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 5)
    ch_send(ch, 10)
    ch_send(ch, 15)
    let l = ch_len(ch)
    let c = ch_cap(ch)
    let full = ch_is_full(ch)
    l == 3 && c == 3 && full
}

fn test_070_len_cap_full_at_boundary() -> bool with Mut, Panic, Div {
    var ch = ch_new(3)
    do_test_070(&! ch)
}
