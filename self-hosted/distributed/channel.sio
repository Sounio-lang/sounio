fn do_test_063(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 42)
    sel.entries[0].buf_id == 42
}

fn test_063_select_entry_buf_id() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_063(&! sel)
}

fn do_test_064(sel: &! ChSelect) -> bool with Mut, Panic {
    ch_select_add(sel, 1)
    ch_select_add(sel, 2)
    ch_select_add(sel, 3)
    sel.entries[0].buf_id == 1 && sel.entries[1].buf_id == 2 && sel.entries[2].buf_id == 3
}

fn test_064_select_multiple_buf_ids() -> bool with Mut, Panic {
    var sel = ch_select_new()
    do_test_064(&! sel)
}

fn test_065_select_count_zero_on_new() -> bool with Mut {
    let sel = ch_select_new()
    ch_select_count(&sel) == 0
}

// ============================================================================
// TESTS — send to full then drain
// ============================================================================

fn do_test_066(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    // fill channel completely
    var i: i64 = 0
    while i < 8 {
        ch_send(ch, i + 1)
        i = i + 1
    }
    let n = ch_drain(ch, out)
    let ok1 = n == 8
    let ok2 = out[0] == 1
    let ok3 = out[7] == 8
    ok1 && ok2 && ok3
}

fn test_066_drain_full_channel() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_066(&! ch, &! out)
}

fn do_test_067(ch: &! ChBuf) -> bool with Mut, Panic, Div {
    ch_send(ch, 1)
    ch_send(ch, 2)
    let s = ch_send(ch, 3)
    s == CH_FULL()
}

fn test_067_send_returns_full_at_cap2() -> bool with Mut, Panic, Div {
    var ch = ch_new(2)
    do_test_067(&! ch)
}

// ============================================================================
// TESTS — is_empty after drain
// ============================================================================

fn do_test_068(ch: &! ChBuf, out: &! [i64; 256]) -> bool with Mut, Panic, Div {
    ch_send(ch, 10)
    ch_send(ch, 20)
    ch_drain(ch, out)
    ch_is_empty(ch)
}

fn test_068_is_empty_after_drain() -> bool with Mut, Panic, Div {
    var ch = ch_new(8)
    var out: [i64; 256] = [0; 256]
    do_test_068(&! ch, &! out)
}

