// ============================================================================
// PROCESS SCHEDULING
// ============================================================================

fn schedule_new_process(pool: &! SchedulerPool, pid: i64) -> () with Mut, Div, Panic {
    let scheduler_id = pool.next_scheduler
    pt_insert(pool, pid, scheduler_id, PS_RUNNABLE)
    rq_push(&! pool.schedulers[scheduler_id as usize], pid)
    pool.next_scheduler = (pool.next_scheduler + 1) % pool.schedulers_len
}

fn schedule_process(pool: &! SchedulerPool, pid: i64) -> () with Mut, Div, Panic {
    let state = pt_get_state(pool, pid)
    if state == PS_WAITING || state == PS_SUSPENDED {
        pt_set_state(pool, pid, PS_RUNNABLE)
        let sched_id = pt_get_scheduler(pool, pid)
        if sched_id >= 0 {
            rq_push(&! pool.schedulers[sched_id as usize], pid)
        }
    }
}

// ============================================================================
// SCHEDULER LOOP
// ============================================================================

fn scheduler_get_next(sched: &! Scheduler) -> i64 with Mut, Div, Panic {
    return rq_pop_front(sched)
}

fn scheduler_run_process(
    sched: &! Scheduler,
    pool:  &! SchedulerPool,
    pid:   i64
) -> bool with Mut, Div, Panic, IO {
    sched.current = pid
    sched.reductions = 0

    let state = pt_get_state(pool, pid)
    if state < 0 {
        sched.current = 0 - 1
        return false
    }

    pt_set_state(pool, pid, PS_RUNNING)

    let result = run_process_until_preempt(pool, pid, sched.max_reductions)
    let completed  = result_completed(result)
    let reductions = result_reductions(result)

    sched.reductions = reductions
    pt_add_reductions(pool, pid, reductions)

    let final_state = pt_get_state(pool, pid)
    if completed {
        pt_set_state(pool, pid, PS_DEAD)
        cleanup_process(pool, pid)
    } else if final_state == PS_RUNNING {
        pt_set_state(pool, pid, PS_RUNNABLE)
        rq_push(sched, pid)
    }

    sched.current = 0 - 1
    return completed
}

fn scheduler_loop(sched: &! Scheduler, pool: &! SchedulerPool) -> () with Mut, Div, Panic, IO {
    loop {
        let pid = scheduler_get_next(sched)
        if pid >= 0 {
            scheduler_run_process(sched, pool, pid)
            if rq_len(sched) == 0 && !sched.stealing {
                scheduler_steal_work(sched, pool)
            }
        } else {
            if !sched.stealing {
                scheduler_steal_work(sched, pool)
            }
            if rq_len(sched) == 0 {
                os_yield()
            }
        }
    }
}

// ============================================================================
// WORK STEALING
// ============================================================================

fn scheduler_steal_work(sched: &! Scheduler, pool: &! SchedulerPool) -> () with Mut, Div, Panic {
    sched.stealing = true

    var victim_id: i64 = (sched.id + 1) % pool.schedulers_len

    while victim_id != sched.id {
        let victim_len = rq_len(&pool.schedulers[victim_id as usize])
        if victim_len > 1 {
            let steal_count = victim_len / 2
            let keep_len    = victim_len - steal_count

            // Copy stolen pids into our queue
            var i: i64 = 0
            while i < steal_count {
                let stolen_pid = rq_get(&pool.schedulers[victim_id as usize], keep_len + i)
                if stolen_pid >= 0 {
                    rq_push(sched, stolen_pid)
                }
                i = i + 1
            }

            // Truncate victim's queue
            rq_truncate(&! pool.schedulers[victim_id as usize], keep_len)

            sched.stealing = false
            return ()
        }

        victim_id = (victim_id + 1) % pool.schedulers_len
    }

    sched.stealing = false
}

// ============================================================================
// PROCESS MIGRATION (for load balancing)
// ============================================================================

fn migrate_process(pool: &! SchedulerPool, pid: i64, to_scheduler: i64) -> () with Mut, Div, Panic {
    let state = pt_get_state(pool, pid)
    if state >= 0 && state != PS_RUNNING {
        let old_sched_id = pt_get_scheduler(pool, pid)
        if old_sched_id >= 0 {
            rq_remove_pid(&! pool.schedulers[old_sched_id as usize], pid)
        }
        rq_push(&! pool.schedulers[to_scheduler as usize], pid)
        // Update process entry scheduler field
        let idx = pt_find(pool, pid)
        if idx >= 0 {
            pool.process_table[idx as usize].scheduler = to_scheduler
        }
    }
}

// ============================================================================
// PRIORITY SCHEDULING
// ============================================================================

fn scheduler_insert_priority(sched: &! Scheduler, pid: i64, priority: i64) -> () with Mut, Div, Panic {
    if priority > 0 && rq_len(sched) > 0 {
        let insert_pos = rq_len(sched) / (priority + 1)
        rq_insert_at(sched, insert_pos, pid)
    } else {
        rq_push(sched, pid)
    }
}

// ============================================================================
// RESULT ACCESSORS (run_process_until_preempt returns two-element i64 pair)
// ============================================================================

// Encode (completed: bool, reductions: i64) as a single i64:
//   bit 63 = completed flag, bits 0-62 = reduction count
fn make_result(completed: bool, reductions: i64) -> i64 {
    if completed {
        return (1 as i64) * 4611686018427387904 + reductions
    }
    return reductions
}

fn result_completed(r: i64) -> bool {
    return r >= 4611686018427387904
}

fn result_reductions(r: i64) -> i64 {
    if r >= 4611686018427387904 {
        return r - 4611686018427387904
    }
    return r
}

// ============================================================================
// STUBS
// ============================================================================

fn run_process_until_preempt(
    pool: &! SchedulerPool,
    pid: i64,
    max_reductions: i64
) -> i64 with Mut, Div, Panic, IO {
    var reductions: i64 = 0
    var running: bool = true
    var completed: bool = false

    while reductions < max_reductions && running {
        let msg = get_next_message(pid)
        if msg >= 0 {
            let handled = execute_message_handler(pool, pid, msg)
            reductions = reductions + 1
            if !msg_more(handled) {
                completed = true
                running = false
            }
        } else {
            mark_process_waiting(pool, pid)
            running = false
        }
    }

    return make_result(completed, reductions)
}

fn cleanup_process(pool: &! SchedulerPool, pid: i64) -> () with Mut, Div, Panic {
    pt_remove(pool, pid)
}

fn mark_process_waiting(pool: &! SchedulerPool, pid: i64) -> () with Mut, Div, Panic {
    pt_set_state(pool, pid, PS_WAITING)
}

fn get_next_message(pid: i64) -> i64 with IO { return 0 - 1 }
fn execute_message_handler(pool: &! SchedulerPool, pid: i64, msg: i64) -> i64 with Mut, Div, Panic, IO { return 1 }
fn msg_more(r: i64) -> bool { return r > 0 }
fn os_yield() -> () with IO {}
fn pid_eq(a: i64, b: i64) -> bool { return a == b }
