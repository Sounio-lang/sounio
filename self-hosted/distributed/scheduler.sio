                            scheduler_new(20),scheduler_new(21),scheduler_new(22), scheduler_new(23),
                            scheduler_new(24),scheduler_new(25),scheduler_new(26), scheduler_new(27),
                            scheduler_new(28),scheduler_new(29),scheduler_new(30), scheduler_new(31)],
        schedulers_len:    num_schedulers,
        process_table:     [ProcessEntry { pid: 0, state: 0, scheduler: 0, reductions: 0, valid: false },
                            ProcessEntry { pid: 0, state: 0, scheduler: 0, reductions: 0, valid: false },
                            ProcessEntry { pid: 0, state: 0, scheduler: 0, reductions: 0, valid: false },
