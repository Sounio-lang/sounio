// self-hosted::distributed::scheduler
//
// ACTOR SCHEDULER FOR DISTRIBUTED SOUNIO
// Preemptive multitasking with work stealing.

// ============================================================================
// CONSTANTS
// ============================================================================

// Pid is i64; -1 is the sentinel "no pid"
// ProcessState encoded as i64 constants
let PS_RUNNABLE:  i64 = 0
let PS_RUNNING:   i64 = 1
let PS_WAITING:   i64 = 2
let PS_SUSPENDED: i64 = 3
let PS_EXITING:   i64 = 4
let PS_DEAD:      i64 = 5

// ============================================================================
// SCHEDULER TYPES
// ============================================================================

// Scheduler per OS thread
struct Scheduler {
    id:             i64,
    run_queue:      [i64; 1024],
    run_queue_len:  i64,
    current:        i64,       // -1 means no current process
    reductions:     i64,
    max_reductions: i64,
    stealing:       bool,
}

// Process entry stored in a flat table
struct ProcessEntry {
    pid:        i64,
    state:      i64,
    scheduler:  i64,
    reductions: i64,
    valid:      bool,
}

// Global scheduler state
struct SchedulerPool {
    schedulers:       [Scheduler; 32],
    schedulers_len:   i64,
    process_table:    [ProcessEntry; 4096],
    process_table_len: i64,
    next_pid:         i64,
    next_scheduler:   i64,
}

// ============================================================================
// RUN-QUEUE HELPERS (must precede callers)
// ============================================================================

fn rq_len(sched: &Scheduler) -> i64 {
    sched.run_queue_len
}

fn rq_push(sched: &! Scheduler, pid: i64) -> () with Mut, Panic {
    if sched.run_queue_len < 1024 {
        sched.run_queue[sched.run_queue_len as usize] = pid
        sched.run_queue_len = sched.run_queue_len + 1
    }
}

fn rq_pop_front(sched: &! Scheduler) -> i64 with Mut, Div, Panic {
    if sched.run_queue_len == 0 {
        return 0 - 1
    }
    let pid = sched.run_queue[0]
    var i: i64 = 0
    while i < sched.run_queue_len - 1 {
        sched.run_queue[i as usize] = sched.run_queue[(i + 1) as usize]
        i = i + 1
    }
    sched.run_queue_len = sched.run_queue_len - 1
    return pid
}

fn rq_get(sched: &Scheduler, idx: i64) -> i64 with Panic {
    if idx >= 0 && idx < sched.run_queue_len {
        return sched.run_queue[idx as usize]
    }
    return 0 - 1
}

// Remove a specific pid from the run queue
fn rq_remove_pid(sched: &! Scheduler, pid: i64) -> () with Mut, Div, Panic {
    var write_pos: i64 = 0
    var read_pos: i64 = 0
    while read_pos < sched.run_queue_len {
        if sched.run_queue[read_pos as usize] != pid {
            sched.run_queue[write_pos as usize] = sched.run_queue[read_pos as usize]
            write_pos = write_pos + 1
        }
        read_pos = read_pos + 1
    }
    sched.run_queue_len = write_pos
}

// Insert at a given position (shift right)
fn rq_insert_at(sched: &! Scheduler, idx: i64, pid: i64) -> () with Mut, Div, Panic {
    if sched.run_queue_len < 1024 {
        // Clamp idx
        var pos: i64 = idx
        if pos < 0 {
            pos = 0
        }
        if pos > sched.run_queue_len {
            pos = sched.run_queue_len
        }
        // Shift right from end down to pos
        var i: i64 = sched.run_queue_len
        while i > pos {
            sched.run_queue[i as usize] = sched.run_queue[(i - 1) as usize]
            i = i - 1
        }
        sched.run_queue[pos as usize] = pid
        sched.run_queue_len = sched.run_queue_len + 1
    }
}

// Truncate run queue to new_len (drop tail)
fn rq_truncate(sched: &! Scheduler, new_len: i64) -> () with Mut, Panic {
    if new_len < sched.run_queue_len {
        sched.run_queue_len = new_len
    }
}

// ============================================================================
// PROCESS TABLE HELPERS (must precede callers)
// ============================================================================

fn pt_find(pool: &SchedulerPool, pid: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < pool.process_table_len {
        if pool.process_table[i as usize].valid && pool.process_table[i as usize].pid == pid {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn pt_get_state(pool: &SchedulerPool, pid: i64) -> i64 with Mut, Div, Panic {
    let idx = pt_find(pool, pid)
    if idx < 0 {
        return 0 - 1
    }
    return pool.process_table[idx as usize].state
}

fn pt_get_scheduler(pool: &SchedulerPool, pid: i64) -> i64 with Mut, Div, Panic {
    let idx = pt_find(pool, pid)
    if idx < 0 {
        return 0 - 1
    }
    return pool.process_table[idx as usize].scheduler
}

fn pt_set_state(pool: &! SchedulerPool, pid: i64, state: i64) -> () with Mut, Div, Panic {
    let idx = pt_find(pool, pid)
    if idx >= 0 {
        pool.process_table[idx as usize].state = state
    }
}

fn pt_add_reductions(pool: &! SchedulerPool, pid: i64, r: i64) -> () with Mut, Div, Panic {
    let idx = pt_find(pool, pid)
    if idx >= 0 {
        pool.process_table[idx as usize].reductions = pool.process_table[idx as usize].reductions + r
    }
}

fn pt_insert(pool: &! SchedulerPool, pid: i64, scheduler_id: i64, state: i64) -> () with Mut, Div, Panic {
    // Reuse existing slot or append
    var i: i64 = 0
    while i < pool.process_table_len {
        if !pool.process_table[i as usize].valid {
            pool.process_table[i as usize].pid = pid
            pool.process_table[i as usize].state = state
            pool.process_table[i as usize].scheduler = scheduler_id
            pool.process_table[i as usize].reductions = 0
            pool.process_table[i as usize].valid = true
            return ()
        }
        i = i + 1
    }
    if pool.process_table_len < 4096 {
        pool.process_table[pool.process_table_len as usize].pid = pid
        pool.process_table[pool.process_table_len as usize].state = state
        pool.process_table[pool.process_table_len as usize].scheduler = scheduler_id
        pool.process_table[pool.process_table_len as usize].reductions = 0
        pool.process_table[pool.process_table_len as usize].valid = true
        pool.process_table_len = pool.process_table_len + 1
    }
}

fn pt_remove(pool: &! SchedulerPool, pid: i64) -> () with Mut, Div, Panic {
    let idx = pt_find(pool, pid)
    if idx >= 0 {
        pool.process_table[idx as usize].valid = false
    }
}

