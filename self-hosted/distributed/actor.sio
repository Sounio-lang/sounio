fn node_self() -> string with IO { return "" }
fn self_pid() -> Pid with IO { return pid_new("", 0, 0) }
fn now() -> i64 with IO { return 0 }
fn get_next_pid() -> i64 with Mut { return 0 }
fn register_process(proc: Process) -> i64 with Mut { return 0 }
fn schedule_process(pid: Pid) -> i64 with Mut { return 0 }

fn get_process(pid: Pid) -> Process with Mut {
    let b = behavior_simple(0, default_handler)
    let f = process_flags_default()
    return process_new(pid, b, f)
}

fn wake_process(pid: Pid) -> i64 with Mut { return 0 }
fn yield_process() -> i64 with IO { return 0 }
fn ref_new(node: string) -> Ref with IO { return Ref { node: node, time: 0, id: 0 } }
fn send_link_request(from: Pid, to: Pid) -> i64 with IO { return 0 }
fn send_monitor_request(watcher: Pid, watched: Pid, ref_val: Ref) -> i64 with IO { return 0 }

fn serialize_message_to_bytes(msg: Message) -> ByteBuffer {
    return byte_buffer_new()
}

fn net_send_bytes(node: string, packet: ByteBuffer) -> i64 with IO { return 0 }

