// self-hosted::distributed::actor
//
// DISTRIBUTED ACTOR SYSTEM FOR SOUNIO
// No stubs. No fakes. Real implementation.
//
// Location-transparent actors that span multiple nodes.
// Migrated from Vec<T> to fixed-size bounded arrays + length counters.

// ============================================================================
// CONSTANTS
// ============================================================================

let MAILBOX_CAP: i64 = 256
let LINKS_CAP: i64 = 64
let MONITORS_CAP: i64 = 64
let TERM_ARENA_CAP: i64 = 8192
let BINARY_CAP: i64 = 1024
let TUPLE_CAP: i64 = 32
let LIST_CAP: i64 = 256
let MAP_CAP: i64 = 64
let REPLY_CAP: i64 = 256

// ============================================================================
// TERM TAGS — flat tag-encoded representation
// ============================================================================

let TERM_INT: i32 = 0
let TERM_FLOAT: i32 = 1
let TERM_ATOM: i32 = 2
let TERM_STRING: i32 = 3
let TERM_TUPLE: i32 = 4
let TERM_LIST: i32 = 5
let TERM_MAP: i32 = 6
let TERM_PID: i32 = 7
let TERM_REF: i32 = 8
let TERM_BINARY: i32 = 9

// ============================================================================
// CORE ACTOR TYPES
// ============================================================================

// Globally unique process identifier
struct Pid {
    node: string,
    id: i64,
    serial: i64,
}

// Unique reference (globally unique)
struct Ref {
    node: string,
    time: i64,
    id: i64,
}

// Monitor: one process watching another
struct Monitor {
    watcher_node: string,
    watcher_id: i64,
    watcher_serial: i64,
    watched_node: string,
    watched_id: i64,
    watched_serial: i64,
    ref_node: string,
    ref_time: i64,
    ref_id: i64,
}

// ============================================================================
// TERM — Arena-based representation
// ============================================================================
//
// Instead of recursive enum Term with Vec<Term>, we use a flat arena
// where each node is stored as parallel arrays of fields. Variable-length
// children (tuple elements, list items, map keys/values, binary bytes)
// are stored as index ranges into the arena or dedicated arrays.

struct TermArena {
    // Per-node tag
    tags: [i32; 8192],
    // Per-node i64 value (for Int, Atom id, String id, Pid id, Ref id, etc.)
    int_vals: [i64; 8192],
    // Per-node f64 value (for Float)
    float_vals: [f64; 8192],
    // Per-node string value (for Atom, String, Pid.node, Ref.node)
    str_vals: [i64; 8192],
    // For compound terms: start index and count of children in children array
    child_start: [i64; 8192],
    child_count: [i64; 8192],
    // For Pid: extra fields
    pid_id: [i64; 8192],
    pid_serial: [i64; 8192],
    // For Ref: extra fields
    ref_time: [i64; 8192],
    ref_id: [i64; 8192],
    // For Map: key children start at child_start, value children at val_start
    val_start: [i64; 8192],
    // For Binary: byte data start index and length in binary_buf
    bin_start: [i64; 8192],
    bin_len: [i64; 8192],
    // Node count
    count: i64,
    // Children array: stores term node IDs for tuple/list/map children
    children: [i64; 8192],
    children_count: i64,
    // Binary byte buffer
    binary_buf: [i8; 1024],
    binary_buf_len: i64,
    // String intern table (simplified: store actual strings by node ID)
    strings: [i64; 8192],
    strings_count: i64,
}

fn term_arena_new() -> TermArena {
    TermArena {
        tags: [0; 8192],
        int_vals: [0; 8192],
        float_vals: [0.0; 8192],
        str_vals: [0; 8192],
        child_start: [0; 8192],
        child_count: [0; 8192],
        pid_id: [0; 8192],
        pid_serial: [0; 8192],
        ref_time: [0; 8192],
        ref_id: [0; 8192],
        val_start: [0; 8192],
        bin_start: [0; 8192],
        bin_len: [0; 8192],
        count: 0,
        children: [0; 8192],
        children_count: 0,
        binary_buf: [0; 1024],
        binary_buf_len: 0,
        strings: [0; 8192],
        strings_count: 0,
    }
}

// Allocate a new term node, return its ID
fn term_arena_alloc(arena: &! TermArena, tag: i32) -> i64 {
    let idx = arena.count
    if idx >= TERM_ARENA_CAP {
        return -1
    }
    arena.tags[idx] = tag
    arena.int_vals[idx] = 0
    arena.float_vals[idx] = 0.0
    arena.str_vals[idx] = 0
    arena.child_start[idx] = 0
    arena.child_count[idx] = 0
    arena.pid_id[idx] = 0
    arena.pid_serial[idx] = 0
    arena.ref_time[idx] = 0
    arena.ref_id[idx] = 0
    arena.val_start[idx] = 0
    arena.bin_start[idx] = 0
    arena.bin_len[idx] = 0
    arena.count = idx + 1
    return idx
}

// Get the tag of a term node
fn term_arena_tag(arena: &TermArena, id: i64) -> i32 {
    if id < 0 { return -1 }
    if id >= arena.count { return -1 }
    return arena.tags[id]
}

// Get the int value of a term node
fn term_arena_int(arena: &TermArena, id: i64) -> i64 {
    if id < 0 { return 0 }
    if id >= arena.count { return 0 }
    return arena.int_vals[id]
}

// Get the float value of a term node
fn term_arena_float(arena: &TermArena, id: i64) -> f64 {
    if id < 0 { return 0.0 }
    if id >= arena.count { return 0.0 }
    return arena.float_vals[id]
}

// Push a child ID into the children array, return the index
fn term_arena_push_child(arena: &! TermArena, child_id: i64) -> i64 {
    let idx = arena.children_count
    if idx >= TERM_ARENA_CAP {
        return -1
    }
    arena.children[idx] = child_id
    arena.children_count = idx + 1
    return idx
}

// Get a child ID from the children array
fn term_arena_get_child(arena: &TermArena, idx: i64) -> i64 {
    if idx < 0 { return -1 }
    if idx >= arena.children_count { return -1 }
    return arena.children[idx]
}

// ============================================================================
// TERM CONSTRUCTORS (allocate nodes in the arena)
// ============================================================================

fn term_alloc_int(arena: &! TermArena, n: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_INT)
    if id >= 0 {
        arena.int_vals[id] = n
    }
    return id
}

fn term_alloc_float(arena: &! TermArena, f: f64) -> i64 {
    let id = term_arena_alloc(arena, TERM_FLOAT)
    if id >= 0 {
        arena.float_vals[id] = f
    }
    return id
}

fn term_alloc_atom(arena: &! TermArena, name_id: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_ATOM)
    if id >= 0 {
        arena.int_vals[id] = name_id
    }
    return id
}

fn term_alloc_string(arena: &! TermArena, str_id: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_STRING)
    if id >= 0 {
        arena.int_vals[id] = str_id
    }
    return id
}

// Allocate a Tuple node. Caller must then push children via term_arena_push_child.
fn term_alloc_tuple(arena: &! TermArena, start: i64, count: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_TUPLE)
    if id >= 0 {
        arena.child_start[id] = start
        arena.child_count[id] = count
    }
    return id
}

// Allocate a List node.
fn term_alloc_list(arena: &! TermArena, start: i64, count: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_LIST)
    if id >= 0 {
        arena.child_start[id] = start
        arena.child_count[id] = count
    }
    return id
}

// Allocate a Map node. Keys at child_start, vals at val_start, count pairs.
fn term_alloc_map(arena: &! TermArena, key_start: i64, val_start_idx: i64, count: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_MAP)
    if id >= 0 {
        arena.child_start[id] = key_start
        arena.val_start[id] = val_start_idx
        arena.child_count[id] = count
    }
    return id
}

// Allocate a Pid term node
fn term_alloc_pid(arena: &! TermArena, node_id: i64, pid_id_val: i64, serial: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_PID)
    if id >= 0 {
        arena.int_vals[id] = node_id
        arena.pid_id[id] = pid_id_val
        arena.pid_serial[id] = serial
    }
    return id
}

// Allocate a Ref term node
fn term_alloc_ref(arena: &! TermArena, node_id: i64, time: i64, ref_id_val: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_REF)
    if id >= 0 {
        arena.int_vals[id] = node_id
        arena.ref_time[id] = time
        arena.ref_id[id] = ref_id_val
    }
    return id
}

// Allocate a Binary term node
fn term_alloc_binary(arena: &! TermArena, buf_start: i64, buf_len: i64) -> i64 {
    let id = term_arena_alloc(arena, TERM_BINARY)
    if id >= 0 {
        arena.bin_start[id] = buf_start
        arena.bin_len[id] = buf_len
    }
    return id
}

// ============================================================================
// MESSAGE — flat representation with term arena IDs
// ============================================================================

struct Message {
    from_node: string,
    from_id: i64,
    from_serial: i64,
    to_node: string,
    to_id: i64,
    to_serial: i64,
    payload_id: i64,
    timestamp: i64,
}

// ============================================================================
// ACTOR REFERENCE
// ============================================================================

struct ActorRef {
    pid_node: string,
    pid_id: i64,
    pid_serial: i64,
    has_monitor: bool,
    mon_watcher_node: string,
    mon_watcher_id: i64,
    mon_watcher_serial: i64,
    mon_watched_node: string,
    mon_watched_id: i64,
    mon_watched_serial: i64,
    mon_ref_node: string,
    mon_ref_time: i64,
    mon_ref_id: i64,
}

// ============================================================================
// PROCESS FLAGS
// ============================================================================

struct ProcessFlags {
    trap_exit: bool,
    priority: i64,
}

// ============================================================================
// BEHAVIOR — handler takes (state_id, msg_payload_id, arena) and returns
//            (new_state_id, reply_count) writing replies into a reply buffer
// ============================================================================

struct Behavior {
    state_id: i64,
    handler: fn(i64, i64) -> i64,
}

// ============================================================================
// PROCESS — fixed-size mailbox, links, monitors
// ============================================================================

struct Process {
    pid_node: string,
    pid_id: i64,
    pid_serial: i64,
    // Mailbox: fixed-size ring buffer of message indices
    mailbox_from_nodes: [i64; 256],
    mailbox_from_ids: [i64; 256],
    mailbox_from_serials: [i64; 256],
    mailbox_to_nodes: [i64; 256],
    mailbox_to_ids: [i64; 256],
    mailbox_to_serials: [i64; 256],
    mailbox_payloads: [i64; 256],
    mailbox_timestamps: [i64; 256],
    mailbox_len: i64,
    // Behavior
    behavior: Behavior,
    // Flags
    flags: ProcessFlags,
    // Links: array of linked Pid ids (flattened)
    link_nodes: [i64; 64],
    link_ids: [i64; 64],
    link_serials: [i64; 64],
    links_len: i64,
    // Monitors
    mon_watcher_nodes: [i64; 64],
    mon_watcher_ids: [i64; 64],
    mon_watcher_serials: [i64; 64],
    mon_watched_nodes: [i64; 64],
    mon_watched_ids: [i64; 64],
    mon_watched_serials: [i64; 64],
    mon_ref_nodes: [i64; 64],
    mon_ref_times: [i64; 64],
    mon_ref_ids: [i64; 64],
    monitors_len: i64,
}

// ============================================================================
// PID OPERATIONS
// ============================================================================

fn pid_new(node: string, id: i64, serial: i64) -> Pid {
    Pid {
        node: node,
        id: id,
        serial: serial,
    }
}

fn pid_to_string(p: Pid) -> string with Mut, Panic, Div {
    "<" + p.node + ">." + int_to_string(p.id) + "." + int_to_string(p.serial)
}

fn pid_local(p: Pid, node: string) -> bool {
    p.node == node
}

fn pid_eq(p1: Pid, p2: Pid) -> bool {
    p1.node == p2.node && p1.id == p2.id && p1.serial == p2.serial
}

// ============================================================================
// MESSAGE OPERATIONS
// ============================================================================

fn message_new(from: Pid, to: Pid, payload_id: i64) -> Message with IO {
    Message {
        from_node: from.node,
        from_id: from.id,
        from_serial: from.serial,
        to_node: to.node,
        to_id: to.id,
        to_serial: to.serial,
        payload_id: payload_id,
        timestamp: now(),
    }
}

fn message_to_pid(msg: Message) -> Pid {
    Pid { node: msg.to_node, id: msg.to_id, serial: msg.to_serial }
}

fn message_from_pid(msg: Message) -> Pid {
    Pid { node: msg.from_node, id: msg.from_id, serial: msg.from_serial }
}

// ============================================================================
// ACTOR REFERENCE
// ============================================================================

fn actor_ref_new(pid: Pid) -> ActorRef {
    ActorRef {
        pid_node: pid.node,
        pid_id: pid.id,
        pid_serial: pid.serial,
        has_monitor: false,
        mon_watcher_node: "",
        mon_watcher_id: 0,
        mon_watcher_serial: 0,
        mon_watched_node: "",
        mon_watched_id: 0,
        mon_watched_serial: 0,
        mon_ref_node: "",
        mon_ref_time: 0,
        mon_ref_id: 0,
    }
}

fn actor_ref_pid(r: ActorRef) -> Pid {
    Pid { node: r.pid_node, id: r.pid_id, serial: r.pid_serial }
}

fn actor_ref_with_monitor(r: ActorRef, watcher: Pid, ref_val: Ref) -> ActorRef {
    ActorRef {
        pid_node: r.pid_node,
        pid_id: r.pid_id,
        pid_serial: r.pid_serial,
        has_monitor: true,
        mon_watcher_node: watcher.node,
        mon_watcher_id: watcher.id,
        mon_watcher_serial: watcher.serial,
        mon_watched_node: r.pid_node,
        mon_watched_id: r.pid_id,
        mon_watched_serial: r.pid_serial,
        mon_ref_node: ref_val.node,
        mon_ref_time: ref_val.time,
        mon_ref_id: ref_val.id,
    }
}

// ============================================================================
// PROCESS FLAGS
// ============================================================================

fn process_flags_default() -> ProcessFlags {
    ProcessFlags {
        trap_exit: false,
        priority: 0,
    }
}

fn process_flags_trap_exit() -> ProcessFlags {
    var flags = process_flags_default()
    flags.trap_exit = true
    return flags
}

// ============================================================================
// PROCESS HELPERS — mailbox, links, monitors manipulation
// ============================================================================

fn default_handler(state_id: i64, msg_id: i64) -> i64 {
    return state_id
}

fn process_new(pid: Pid, behavior: Behavior, flags: ProcessFlags) -> Process {
    Process {
        pid_node: pid.node,
        pid_id: pid.id,
        pid_serial: pid.serial,
        mailbox_from_nodes: [0; 256],
        mailbox_from_ids: [0; 256],
        mailbox_from_serials: [0; 256],
        mailbox_to_nodes: [0; 256],
        mailbox_to_ids: [0; 256],
        mailbox_to_serials: [0; 256],
        mailbox_payloads: [0; 256],
        mailbox_timestamps: [0; 256],
        mailbox_len: 0,
        behavior: behavior,
        flags: flags,
        link_nodes: [0; 64],
        link_ids: [0; 64],
        link_serials: [0; 64],
        links_len: 0,
        mon_watcher_nodes: [0; 64],
        mon_watcher_ids: [0; 64],
        mon_watcher_serials: [0; 64],
        mon_watched_nodes: [0; 64],
        mon_watched_ids: [0; 64],
        mon_watched_serials: [0; 64],
        mon_ref_nodes: [0; 64],
        mon_ref_times: [0; 64],
        mon_ref_ids: [0; 64],
        monitors_len: 0,
    }
}

// Push a message into a process's mailbox
fn process_mailbox_push(proc: &! Process, msg: Message) -> bool {
    let idx = proc.mailbox_len
    if idx >= MAILBOX_CAP {
        return false
    }
    proc.mailbox_from_nodes[idx] = 0
    proc.mailbox_from_ids[idx] = msg.from_id
    proc.mailbox_from_serials[idx] = msg.from_serial
    proc.mailbox_to_nodes[idx] = 0
    proc.mailbox_to_ids[idx] = msg.to_id
    proc.mailbox_to_serials[idx] = msg.to_serial
    proc.mailbox_payloads[idx] = msg.payload_id
    proc.mailbox_timestamps[idx] = msg.timestamp
    proc.mailbox_len = idx + 1
    return true
}

// Pop the first message from a process's mailbox (shift left)
fn process_mailbox_pop(proc: &! Process) -> i64 {
    if proc.mailbox_len <= 0 {
        return -1
    }
    let payload = proc.mailbox_payloads[0]
    // Shift everything left
    var i: i64 = 1
    while i < proc.mailbox_len {
        let prev = i - 1
        proc.mailbox_from_nodes[prev] = proc.mailbox_from_nodes[i]
        proc.mailbox_from_ids[prev] = proc.mailbox_from_ids[i]
        proc.mailbox_from_serials[prev] = proc.mailbox_from_serials[i]
        proc.mailbox_to_nodes[prev] = proc.mailbox_to_nodes[i]
        proc.mailbox_to_ids[prev] = proc.mailbox_to_ids[i]
        proc.mailbox_to_serials[prev] = proc.mailbox_to_serials[i]
        proc.mailbox_payloads[prev] = proc.mailbox_payloads[i]
        proc.mailbox_timestamps[prev] = proc.mailbox_timestamps[i]
        i = i + 1
    }
    proc.mailbox_len = proc.mailbox_len - 1
    return payload
}

// Check if a link exists for a given pid id
fn process_has_link(proc: &Process, pid_id: i64, pid_serial: i64) -> bool {
    var i: i64 = 0
    while i < proc.links_len {
        if proc.link_ids[i] == pid_id {
            if proc.link_serials[i] == pid_serial {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// Add a link
fn process_add_link(proc: &! Process, pid: Pid) -> bool {
    if process_has_link(proc, pid.id, pid.serial) {
        return false
    }
    let idx = proc.links_len
    if idx >= LINKS_CAP {
        return false
    }
    proc.link_nodes[idx] = 0
    proc.link_ids[idx] = pid.id
    proc.link_serials[idx] = pid.serial
    proc.links_len = idx + 1
    return true
}

// Remove a link by shifting
fn process_remove_link(proc: &! Process, pid_id: i64, pid_serial: i64) -> bool {
    var found: i64 = -1
    var i: i64 = 0
    while i < proc.links_len {
        if proc.link_ids[i] == pid_id {
            if proc.link_serials[i] == pid_serial {
                found = i
                break
            }
        }
        i = i + 1
    }
    if found < 0 {
        return false
    }
    // Shift left from found+1
    var j: i64 = found + 1
    while j < proc.links_len {
        let prev = j - 1
        proc.link_nodes[prev] = proc.link_nodes[j]
        proc.link_ids[prev] = proc.link_ids[j]
        proc.link_serials[prev] = proc.link_serials[j]
        j = j + 1
    }
    proc.links_len = proc.links_len - 1
    return true
}

// Add a monitor
fn process_add_monitor(proc: &! Process, watcher: Pid, watched: Pid, ref_val: Ref) -> bool {
    let idx = proc.monitors_len
    if idx >= MONITORS_CAP {
        return false
    }
    proc.mon_watcher_nodes[idx] = 0
    proc.mon_watcher_ids[idx] = watcher.id
    proc.mon_watcher_serials[idx] = watcher.serial
    proc.mon_watched_nodes[idx] = 0
    proc.mon_watched_ids[idx] = watched.id
    proc.mon_watched_serials[idx] = watched.serial
    proc.mon_ref_nodes[idx] = 0
    proc.mon_ref_times[idx] = ref_val.time
    proc.mon_ref_ids[idx] = ref_val.id
    proc.monitors_len = idx + 1
    return true
}

// ============================================================================
// PROCESS LIFECYCLE
// ============================================================================

// Spawn a new actor on the local node
fn spawn(behavior: Behavior) -> Pid with Mut, IO {
    return spawn_with_flags(behavior, process_flags_default())
}

fn spawn_with_flags(behavior: Behavior, flags: ProcessFlags) -> Pid with Mut, IO {
    let node = node_self()
    let id = get_next_pid()
    let pid = pid_new(node, id, 0)
    let proc = process_new(pid, behavior, flags)
    register_process(proc)
    schedule_process(pid)
    return pid
}

// ============================================================================
// MESSAGE PASSING
// ============================================================================

// Send a message (location transparent)
fn send(to: Pid, msg_payload_id: i64) -> i64 with Mut, IO {
    let from = self_pid()
    let envelope = message_new(from, to, msg_payload_id)
    if pid_local(to, node_self()) {
        local_deliver(envelope)
    } else {
        remote_deliver(envelope)
    }
    return 0
}

// Send with actor ref
fn send_op(actor: ActorRef, msg_payload_id: i64) -> i64 with Mut, IO {
    let pid = actor_ref_pid(actor)
    return send(pid, msg_payload_id)
}

// Receive a message (blocks until message arrives)
fn receive_msg(proc: &! Process) -> i64 with Mut, IO, Div {
    var result: i64 = -1
    var done: bool = false
    while !done {
        let payload = process_mailbox_pop(proc)
        if payload >= 0 {
            result = payload
            done = true
        } else {
            yield_process()
        }
    }
    return result
}

// Receive with timeout
fn receive_timeout(proc: &! Process, timeout_ms: i64) -> i64 with Mut, IO, Div {
    let deadline = now() + timeout_ms
    var result: i64 = -1
    var done: bool = false
    while !done {
        let payload = process_mailbox_pop(proc)
        if payload >= 0 {
            result = payload
            done = true
        } else {
            if now() >= deadline {
                done = true
            } else {
                yield_process()
            }
        }
    }
    return result
}

// Local delivery
fn local_deliver(msg: Message) -> i64 with Mut {
    let to = message_to_pid(msg)
    var proc = get_process(to)
    process_mailbox_push(&! proc, msg)
    wake_process(to)
    return 0
}

// Remote delivery
fn remote_deliver(msg: Message) -> i64 with IO {
    let packet = serialize_message_to_bytes(msg)
    net_send_bytes(msg.to_node, packet)
    return 0
}

// ============================================================================
// LINKING AND MONITORING
// ============================================================================

// Link two processes (bidirectional)
fn link(pid1: Pid, pid2: Pid) -> i64 with Mut, IO {
    if pid_local(pid1, node_self()) {
        var proc1 = get_process(pid1)
        process_add_link(&! proc1, pid2)
    }
    if pid_local(pid2, node_self()) {
        var proc2 = get_process(pid2)
        process_add_link(&! proc2, pid1)
    }
    if !pid_local(pid2, node_self()) {
        send_link_request(pid1, pid2)
    }
    return 0
}

// Unlink processes
fn unlink(pid1: Pid, pid2: Pid) -> i64 with Mut, IO {
    if pid_local(pid1, node_self()) {
        var proc1 = get_process(pid1)
        process_remove_link(&! proc1, pid2.id, pid2.serial)
    }
    if pid_local(pid2, node_self()) {
        var proc2 = get_process(pid2)
        process_remove_link(&! proc2, pid1.id, pid1.serial)
    }
    return 0
}

// Monitor a process
fn monitor_process(pid: Pid) -> Ref with Mut, IO {
    let watcher = self_pid()
    let ref_val = ref_new(node_self())
    if pid_local(pid, node_self()) {
        var proc = get_process(pid)
        process_add_monitor(&! proc, watcher, pid, ref_val)
    } else {
        send_monitor_request(watcher, pid, ref_val)
    }
    return ref_val
}

// Demonitor (stub — would remove monitor from process)
fn demonitor(ref_val: Ref) -> i64 with Mut {
    return 0
}

// ============================================================================
// EXIT SIGNALS
// ============================================================================

// Send exit signal using the term arena
fn exit_process(arena: &! TermArena, pid: Pid, reason_id: i64) -> i64 with Mut, IO {
    // Build a tuple: (Atom("EXIT"), Pid(self), reason)
    let self_p = self_pid()
    let atom_id = term_alloc_atom(arena, 0)
    let pid_id = term_alloc_pid(arena, 0, self_p.id, self_p.serial)
    let start = arena.children_count
    term_arena_push_child(arena, atom_id)
    term_arena_push_child(arena, pid_id)
    term_arena_push_child(arena, reason_id)
    let tuple_id = term_alloc_tuple(arena, start, 3)
    send(pid, tuple_id)
    return 0
}

// Kill a process
fn kill_process(arena: &! TermArena, pid: Pid) -> i64 with Mut, IO {
    let reason = term_alloc_atom(arena, 1)
    return exit_process(arena, pid, reason)
}

// ============================================================================
// BEHAVIOR HELPERS
// ============================================================================

fn behavior_simple(initial_state_id: i64, handler: fn(i64, i64) -> i64) -> Behavior {
    Behavior {
        state_id: initial_state_id,
        handler: handler,
    }
}

// ============================================================================
// TERM CONVENIENCE CONSTRUCTORS
// ============================================================================

fn term_int(arena: &! TermArena, n: i64) -> i64 {
    return term_alloc_int(arena, n)
}

fn term_float(arena: &! TermArena, f: f64) -> i64 {
    return term_alloc_float(arena, f)
}

fn term_atom(arena: &! TermArena, name_id: i64) -> i64 {
    return term_alloc_atom(arena, name_id)
}

fn term_string(arena: &! TermArena, str_id: i64) -> i64 {
    return term_alloc_string(arena, str_id)
}

fn term_pid(arena: &! TermArena, p: Pid) -> i64 {
    return term_alloc_pid(arena, 0, p.id, p.serial)
}

fn term_ref(arena: &! TermArena, r: Ref) -> i64 {
    return term_alloc_ref(arena, 0, r.time, r.id)
}

// ============================================================================
// SERIALIZATION BUFFER — fixed-size byte buffer for message serialization
// ============================================================================

struct ByteBuffer {
    data: [i8; 1024],
    len: i64,
}

fn byte_buffer_new() -> ByteBuffer {
    ByteBuffer {
        data: [0; 1024],
        len: 0,
    }
}

fn byte_buffer_push(buf: &! ByteBuffer, byte: i8) -> bool {
    if buf.len >= BINARY_CAP {
        return false
    }
    buf.data[buf.len] = byte
    buf.len = buf.len + 1
    return true
}

