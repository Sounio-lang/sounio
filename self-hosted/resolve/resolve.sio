// Main name resolution pass
//
// Two-pass algorithm:
//   Pass 1 — collect all top-level items (fn, struct, enum, type alias, impl)
//            into the global scope, enabling forward references.
//   Pass 2 — walk each item body, resolving identifiers and paths
//            against the symbol table with lexical scoping.
//
// Methods return (Resolver, ...) to thread state through value semantics.

module resolve::resolve

use parser::ast::*
use lexer::span::*
use resolve::symbol::*
use resolve::scope::*
use resolve::imports::*

// ============================================================
// Resolver state
// ============================================================

pub struct Resolver {
    symbols: SymbolTable,
    scopes: ScopeStack,
    modules: ModuleRegistry,
    error_count: i64,
    had_error: bool,
    next_id: i64,
}

pub fn resolver_new() -> Resolver {
    Resolver {
        symbols: symbol_table_new(),
        scopes: scope_stack_new(),
        modules: module_registry_new(),
        error_count: 0,
        had_error: false,
        next_id: 0,
    }
}

pub fn resolver_with_modules(mods: ModuleRegistry) -> Resolver {
    Resolver {
        symbols: symbol_table_new(),
        scopes: scope_stack_new(),
        modules: mods,
        error_count: 0,
        had_error: false,
        next_id: 0,
    }
}

// ============================================================
// GPU intrinsic allowlist
// ============================================================
//
// Read-only GPU thread/block coordinate intrinsics are implicit kernel-scope
// builtins: they are never bound in the symbol table, so name resolution must
// recognise them by name before reporting an undefined-variable error. The
// build-path GPU lowering keys purely on these names — hlir_to_gpu.sio maps
// gpu_thread_id_* → GpuGetTid, gpu_block_id_* → GpuGetBid, gpu_block_dim_* →
// GpuGetNtid, which lower_to_ptx.sio emits as %tid.{x,y,z} / %ctaid.{x,y,z} /
// %ntid.{x,y,z}. This list MUST stay in sync with token_is_gpu_builtin_name()
// in self-hosted/compiler/lean_single.sio (the PTX-eligibility allowlist).
fn name_is_gpu_builtin(n: Name) -> bool with Mut, Panic, Div {
    if name_eq(n, make_name("gpu_thread_id_x")) { return true }
    if name_eq(n, make_name("gpu_thread_id_y")) { return true }
    if name_eq(n, make_name("gpu_thread_id_z")) { return true }
    if name_eq(n, make_name("gpu_block_id_x")) { return true }
    if name_eq(n, make_name("gpu_block_id_y")) { return true }
    if name_eq(n, make_name("gpu_block_id_z")) { return true }
    if name_eq(n, make_name("gpu_block_dim_x")) { return true }
    if name_eq(n, make_name("gpu_block_dim_y")) { return true }
    if name_eq(n, make_name("gpu_block_dim_z")) { return true }
    if name_eq(n, make_name("gpu_barrier")) { return true }
    if name_eq(n, make_name("gpu_barrier_sync")) { return true }
    if name_eq(n, make_name("gpu_sync_threads")) { return true }
    false
}

fn expr_is_gpu_axis_root(e: Expr) -> bool with Mut, Panic, Div {
    e.kind == ExprKind::ExprIdent && name_eq(e.name, make_name("gpu"))
}

fn expr_gpu_axis_base_kind(e: Expr) -> i64 with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprFieldAccess {
        match e.left {
            Some(base) => {
                if expr_is_gpu_axis_root(*base) {
                    if name_eq(e.name, make_name("thread_id")) { return 1 }
                    if name_eq(e.name, make_name("block_id")) { return 2 }
                    if name_eq(e.name, make_name("block_dim")) { return 3 }
                }
            }
            None => {}
        }
    } else if e.kind == ExprKind::ExprMethodCall {
        match e.left {
            Some(base) => {
                if expr_is_gpu_axis_root(*base) {
                    if name_eq(e.name, make_name("thread_id")) { return 1 }
                    if name_eq(e.name, make_name("block_id")) { return 2 }
                    if name_eq(e.name, make_name("block_dim")) { return 3 }
                }
            }
            None => {}
        }
    }
    0
}

fn expr_is_gpu_axis_field(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind != ExprKind::ExprFieldAccess {
        return false
    }
    if !name_eq(e.name, make_name("x")) {
        return false
    }
    match e.left {
        Some(base) => expr_gpu_axis_base_kind(*base) > 0,
        None => false,
    }
}

fn expr_is_gpu_effect_root(e: Expr) -> bool with Mut, Panic, Div {
    e.kind == ExprKind::ExprIdent && name_eq(e.name, make_name("GPU"))
}

fn expr_is_gpu_effect_field(e: Expr, field: Name) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprPath && e.path.seg_count == 2 {
        let head = copy_string_list_to_name(e.path.segments)
        let tail = copy_string_list_tail_to_name(e.path.segments)
        return name_eq(head, make_name("GPU")) && name_eq(tail, field)
    }
    if e.kind != ExprKind::ExprFieldAccess {
        return false
    }
    if !name_eq(e.name, field) { return false }
    match e.left {
        Some(base) => expr_is_gpu_effect_root(*base),
        None => false,
    }
}

fn expr_is_gpu_launch_descriptor_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprMethodCall {
        if !name_eq(e.name, make_name("launch")) { return false }
        match e.left {
            Some(base) => return expr_is_gpu_effect_root(*base),
            None => return false,
        }
    }
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => expr_is_gpu_effect_field(*callee, make_name("launch")),
        None => false,
    }
}

fn expr_is_gpu_launch_invocation_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => expr_is_gpu_launch_descriptor_call(*callee),
        None => false,
    }
}

fn expr_is_gpu_sync_call(e: Expr) -> bool with Mut, Panic, Div, Alloc, IO {
    if e.kind == ExprKind::ExprMethodCall {
        if !name_eq(e.name, make_name("sync")) { return false }
        match e.left {
            Some(base) => return expr_is_gpu_effect_root(*base),
            None => return false,
        }
    }
    if e.kind != ExprKind::ExprCall {
        return false
    }
    match e.left {
        Some(callee) => expr_is_gpu_effect_field(*callee, make_name("sync")),
        None => false,
    }
}

// ============================================================
// Core operations — define, lookup, scoping, errors
// ============================================================

impl Resolver {
    fn fresh_id(self) -> (Resolver, i64) with Mut {
        var r = self
        let id = r.next_id
        r.next_id = r.next_id + 1
        (r, id)
    }

    fn define(self, name: Name, kind: SymbolKind, span: Span) -> Resolver with Mut, Panic, Div {
        var r = self
        let pair = r.fresh_id()
        r = pair.0
        let id = pair.1
        let sym = Symbol {
            name: name,
            kind: kind,
            def_span: span,
            scope_depth: r.scopes.depth,
            sym_id: id,
        }
        r.symbols = r.symbols.add(sym)
        r
    }

    fn push_scope(self) -> Resolver with Mut, Panic, Div {
        var r = self
        r.scopes = r.scopes.push(r.symbols.count)
        r
    }

    fn pop_scope(self) -> Resolver with Mut {
        var r = self
        r.scopes = r.scopes.pop()
        r
    }

    // Lookup: scan symbols in reverse for innermost binding
    fn lookup(self, name: Name) -> i64 with Mut, Panic, Div {
        var i = self.symbols.count - 1
        while i >= 0 {
            let sym = self.symbols.get(i)
            if name_eq(sym.name, name) {
                return sym.sym_id
            }
            i = i - 1
        }
        -1
    }

    // Lookup restricted to current scope only (for duplicate detection)
    fn lookup_in_current_scope(self, name: Name) -> bool with Mut, Panic, Div {
        let start = self.scopes.current_start()
        var i = self.symbols.count - 1
        while i >= start {
            let sym = self.symbols.get(i)
            if name_eq(sym.name, name) {
                return true
            }
            i = i - 1
        }
        false
    }

    fn report_error(self, span: Span) -> Resolver with Mut, IO {
        var r = self
        r.error_count = r.error_count + 1
        r.had_error = true
        r
    }
}

// ============================================================
// Pass 1: Collect top-level declarations
// ============================================================

impl Resolver {
    fn collect_items(self, items: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var r = self.collect_item((*list).head)
                r.collect_items((*list).tail)
            }
            None => self
        }
    }

    fn collect_item(self, item: Item) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemKind::ItemFn => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymFunction, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemStruct => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymStruct, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemEnum => {
                var r = self
                if !name_is_empty(item.name) {
                    r = r.define(item.name, SymbolKind::SymEnum, item.span)
                }
                // Also collect enum variants as top-level names
                r.collect_enum_variants(item.enum_def)
            }
            ItemKind::ItemTypeAlias => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemModels => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemAcquisitionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAcquisitionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemRecoursePolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymRecoursePolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemTransitionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTransitionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemTransitionProtocol => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTransitionProtocol, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemMonitoringPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymMonitoringPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemAlternativePolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAlternativePolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemAlternativeFrontier => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAlternativeFrontier, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemDecisionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymDecisionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemDeferralPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymDeferralPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemValidation => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymPolicy, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemAudit => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAudit, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemImpl => self
            ItemKind::ItemUse => {
                if self.modules.count > 0 {
                    // Cross-module import mode: validate and import from registry
                    self.import_use(item.use_path, item.use_glob, item.use_items, item.span)
                } else {
                    // Flat mode: treat selective imports as defining names (no validation yet)
                    self.collect_use_items(item.use_items, item.span)
                }
            }
            ItemKind::ItemUnit => {
                // Register unit declarations as SymUnit (checker handles dimensional analysis)
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymUnit, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemEffect => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymEffect, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemTrait => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemSession => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemAlgebra => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemStudy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemKind::ItemOntology => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            // Claims are metadata, not symbols; normally filtered from the
            // item stream by parser::mod, so this arm is defensive only.
            ItemKind::ItemClaim => self
            // A causal graph is unit-global metadata in the CG_* registry; it
            // declares no symbol, so there is nothing to resolve.
            ItemKind::ItemCausalGraph => self
        }
    }

    fn collect_use_items(self, items: Option<Box<ImportItemList>>, span: Span) -> Resolver with Mut, Panic, Div, Alloc {
        match items {
            None => self  // glob or whole-module — handled by flat mode
            Some(list) => {
                var r = self
                if !name_is_empty((*list).head) {
                    r = r.define((*list).head, SymbolKind::SymImported, span)
                }
                r.collect_use_items((*list).tail, span)
            }
        }
    }

    fn import_use(
        self,
        path: AstPath,
        is_glob: bool,
        items: Option<Box<ImportItemList>>,
        span: Span
    ) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self
        let idx = module_registry_find(r.modules, path)
        if idx < 0 {
            return r.report_error(span)
        }

        let entry = r.modules.modules[idx as usize]

        // Whole-module import (`use foo::bar`): define the last segment name so `bar::x` paths resolve.
        if !is_glob && items == None {
            let mod_name = copy_string_list_tail_to_name(path.segments)
            if !name_is_empty(mod_name) {
                r = r.define(mod_name, SymbolKind::SymImported, span)
            }
            return r
        }

        // Glob import (`use foo::*`): import all exports.
        if is_glob {
            var i: i64 = 0
            while i < entry.export_count {
                // #1689: exports live in the shared pool now, not inline in the
                // entry. The old `&& i < 1024` bound was also a silent cap.
                r = r.define(modreg_export_name_at(entry.export_base + i), SymbolKind::SymImported, span)
                i = i + 1
            }
            return r
        }

        // Selective import (`use foo::{A, B}`): import only requested names, validating exports.
        r.import_use_items(entry, items, span)
    }

    fn import_use_items(self, entry: ModuleEntry, items: Option<Box<ImportItemList>>, span: Span) -> Resolver
        with Mut, Panic, Div, Alloc, IO {
        match items {
            None => self
            Some(list) => {
                var r = self
                let name = (*list).head
                if module_entry_contains(entry, name) {
                    r = r.define(name, SymbolKind::SymImported, span)
                } else {
                    r = r.report_error(span)
                }
                r.import_use_items(entry, (*list).tail, span)
            }
        }
    }

    fn collect_enum_variants(self, opt: Option<Box<EnumDef>>) -> Resolver with Mut, Panic, Div, Alloc {
        match opt {
            Some(ed) => self.collect_variant_list((*ed).variants)
            None => self
        }
    }

    fn collect_variant_list(self, opt: Option<Box<VariantDefList>>) -> Resolver with Mut, Panic, Div, Alloc {
        match opt {
            Some(list) => {
                var r = self.define((*list).head.name, SymbolKind::SymEnumVariant, (*list).head.span)
                r.collect_variant_list((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Pass 2: Resolve all items
// ============================================================

impl Resolver {
    fn resolve_items(self, items: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var r = self.resolve_item((*list).head)
                r.resolve_items((*list).tail)
            }
            None => self
        }
    }

    fn resolve_item(self, item: Item) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemKind::ItemFn => self.resolve_fn_def(item.fn_def)
            ItemKind::ItemStruct => self.resolve_struct_def(item.struct_def)
            ItemKind::ItemEnum => self  // variants already collected, no bodies to resolve
            ItemKind::ItemImpl => self.resolve_impl_def(item.impl_def)
            ItemKind::ItemTypeAlias => self.resolve_type_alias(item.type_alias_ty)
            ItemKind::ItemModels => self.resolve_models_def(item.models_def)
            ItemKind::ItemPolicy => self.resolve_policy_def(item.policy_def)
            ItemKind::ItemAcquisitionPolicy => self.resolve_acquisition_policy_def(item.acquisition_policy_def)
            ItemKind::ItemRecoursePolicy => self.resolve_recourse_policy_def(item.recourse_policy_def)
            ItemKind::ItemTransitionPolicy => self.resolve_transition_policy_def(item.transition_policy_def)
            ItemKind::ItemTransitionProtocol => self.resolve_transition_protocol_def(item.transition_protocol_def)
            ItemKind::ItemMonitoringPolicy => self.resolve_monitoring_policy_def(item.monitoring_policy_def)
            ItemKind::ItemAlternativePolicy => self.resolve_alternative_policy_def(item.alternative_policy_def)
            ItemKind::ItemAlternativeFrontier => self.resolve_alternative_frontier_def(item.alternative_frontier_def)
            ItemKind::ItemDecisionPolicy => self.resolve_decision_policy_def(item.decision_policy_def)
            ItemKind::ItemDeferralPolicy => self.resolve_deferral_policy_def(item.deferral_policy_def)
            ItemKind::ItemValidation => self.resolve_validation_def(item.validation_def)
            ItemKind::ItemAudit => self.resolve_audit_def(item.audit_def)
            ItemKind::ItemUse => {
                // Imports are validated during pass 1 for multi-module mode.
                // Flat mode keeps legacy behavior.
                if self.modules.count > 0 { self } else { self.validate_use_items(item.use_items, item.span) }
            }
            ItemKind::ItemUnit => self  // Unit declarations have no body to resolve
            ItemKind::ItemEffect => self
            ItemKind::ItemSession => self
            ItemKind::ItemTrait => self  // Trait methods resolved via checker's collect pass
            ItemKind::ItemAlgebra => self  // Algebra metadata is collected by the checker.
            ItemKind::ItemStudy => self  // Study metadata is collected by the checker.
            ItemKind::ItemOntology => self  // Ontology metadata is collected by the checker.
            ItemKind::ItemClaim => self  // Claim metadata; no body to resolve.
            ItemKind::ItemCausalGraph => self  // Graph metadata; no body to resolve.
        }
    }

    // --------------------------------------------------------
    // Import validation
    // --------------------------------------------------------

    fn validate_use_items(self, items: Option<Box<ImportItemList>>, span: Span) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            None => self  // glob or whole-module — nothing to validate
            Some(list) => {
                var r = self
                // In flat mode, all symbols are in scope, so lookup succeeds trivially.
                // When a real module loader exists, this validates against the module's exports.
                let found = r.lookup((*list).head)
                if found < 0 {
                    // Symbol not found — emit error (in flat mode this won't happen)
                    r = r.report_error(span)
                }
                r.validate_use_items((*list).tail, span)
            }
        }
    }

    // --------------------------------------------------------
    // Function
    // --------------------------------------------------------

    fn resolve_fn_def(self, opt: Option<Box<FnDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var r = self.push_scope()
                r = r.resolve_params((*fd).params)
                r = r.resolve_opt_type((*fd).return_type)
                r = r.resolve_block((*fd).body)
                r.pop_scope()
            }
            None => self
        }
    }

    fn resolve_params(self, opt: Option<Box<ParamList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_param((*list).head)
                r.resolve_params((*list).tail)
            }
            None => self
        }
    }

    fn resolve_param(self, p: Param) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.resolve_type_expr(p.ty)
        if p.is_self {
            r = r.define(Name { buf: [0; 128], len: 4 }, SymbolKind::SymParameter, p.span)
            // Note: "self" name bytes would be 115,101,108,102 but we don't need exact bytes
            // for the self-hosted phase — self is implicitly available
        } else {
            r = r.define(p.name, SymbolKind::SymParameter, p.span)
        }
        r
    }

    // --------------------------------------------------------
    // Struct
    // --------------------------------------------------------

    fn resolve_struct_def(self, opt: Option<Box<StructDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => self.resolve_field_defs((*sd).fields)
            None => self
        }
    }

    fn resolve_field_defs(self, opt: Option<Box<FieldDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_type_expr((*list).head.ty)
                r.resolve_field_defs((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Impl
    // --------------------------------------------------------

    fn resolve_impl_def(self, opt: Option<Box<ImplDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                var r = self.resolve_type_expr((*id).target_type)
                r = r.push_scope()
                r = r.resolve_impl_methods((*id).methods)
                r.pop_scope()
            }
            None => self
        }
    }

    fn resolve_impl_methods(self, opt: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_item((*list).head)
                r.resolve_impl_methods((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Type alias
    // --------------------------------------------------------

    fn resolve_type_alias(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }

    fn resolve_policy_def(self, opt: Option<Box<PolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pd) => self.resolve_type_expr((*pd).target_type)
            None => self
        }
    }

    fn resolve_audit_def(self, opt: Option<Box<AuditDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => self.resolve_type_expr((*ad).target_type)
            None => self
        }
    }

    fn resolve_decision_policy_def(self, opt: Option<Box<DecisionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => self.resolve_type_expr((*dd).target_type)
            None => self
        }
    }

    fn resolve_acquisition_policy_def(self, opt: Option<Box<AcquisitionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => self.resolve_type_expr((*ad).target_type)
            None => self
        }
    }

    fn resolve_recourse_policy_def(self, opt: Option<Box<RecoursePolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(rd) => self.resolve_type_expr((*rd).target_type)
            None => self
        }
    }

    fn resolve_transition_policy_def(self, opt: Option<Box<TransitionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(td) => self.resolve_type_expr((*td).target_type)
            None => self
        }
    }

    fn resolve_transition_protocol_def(self, opt: Option<Box<TransitionProtocolDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tp) => {
                var r = self.resolve_type_expr((*tp).target_type)
                if !name_is_empty((*tp).policy_name) {
                    let found = r.lookup((*tp).policy_name)
                    if found < 0 {
                        r = r.report_error((*tp).span)
                    }
                }
                r.resolve_transition_step_defs((*tp).steps)
            }
            None => self
        }
    }

    fn resolve_monitoring_policy_def(self, opt: Option<Box<MonitoringPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => self.resolve_type_expr((*md).target_type)
            None => self
        }
    }

    fn resolve_deferral_policy_def(self, opt: Option<Box<DeferralPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => self.resolve_type_expr((*dd).target_type)
            None => self
        }
    }

    fn resolve_alternative_policy_def(self, opt: Option<Box<AlternativePolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => self.resolve_type_expr((*ap).target_type)
            None => self
        }
    }

    fn resolve_alternative_frontier_def(self, opt: Option<Box<AlternativeFrontierDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(af) => {
                var r = self.resolve_type_expr((*af).target_type)
                if !name_is_empty((*af).policy_name) {
                    let found = r.lookup((*af).policy_name)
                    if found < 0 {
                        r = r.report_error((*af).span)
                    }
                }
                r.resolve_alternative_candidate_defs((*af).candidates)
            }
            None => self
        }
    }

    fn resolve_alternative_candidate_defs(self, opt: Option<Box<AlternativeCandidateDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value_expr)
                if (*list).head.uses_via && !name_is_empty((*list).head.via_name) {
                    let found = r.lookup((*list).head.via_name)
                    if found < 0 {
                        r = r.report_error((*list).head.span)
                    }
                }
                r.resolve_alternative_candidate_defs((*list).tail)
            }
            None => self
        }
    }

    fn resolve_transition_step_defs(self, opt: Option<Box<TransitionStepDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value_expr)
                r.resolve_transition_step_defs((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Type expression resolution
// ============================================================

impl Resolver {
    fn resolve_type_expr(self, te: TypeExpr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match te.kind {
            TypeExprKind::TypeNamed => {
                // Named types are looked up, but we don't error on unresolved types
                // since many are builtins (i64, bool, Option, etc.)
                var r = self
                r = r.resolve_type_args(te.type_args)
                r
            }
            TypeExprKind::TypeReference => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeRefMut => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeRawPtr => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeArray => {
                var r = self.resolve_opt_type(te.inner)
                r.resolve_opt_expr(te.array_size)
            }
            TypeExprKind::TypeTuple => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeFn => {
                var r = self.resolve_type_args(te.type_args)
                r.resolve_opt_type(te.inner)
            }
            TypeExprKind::TypeUnit => self
            TypeExprKind::TypeNever => self
            TypeExprKind::TypeSelfUpper => self
            TypeExprKind::TypeInfer => self
            TypeExprKind::TypeKnowledge => {
                // Resolve inner type of Knowledge[T, ...]
                self.resolve_knowledge_inner(te.knowledge_info)
            }
            TypeExprKind::TypeForgettable => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeExactlyPrivate => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeEditable => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeCapabilityGated => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeComposable => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeAudited => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeRevivable => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeInterpretable => self.resolve_opt_type(te.inner)
            TypeExprKind::TypeModel => self.resolve_type_args(te.type_args)
            TypeExprKind::TypePolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAcquisitionPolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAcquisitionPlan => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeRecoursePolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeRecoursePlan => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeTransitionPolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeTransitionPlan => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeMonitoringPolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeObservedTransition => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeRollbackCertificate => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeDecisionPolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeDeferralPolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAlternativePolicy => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAlternativeSet => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAlternativeOption => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeContest => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeRobust => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeIntervention => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeCounterfactual => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeValidated => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAdmissible => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeDeferred => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeRefinement => {
                // Resolve base type inside refinement
                self.resolve_refinement_inner(te.refinement_info)
            }
            TypeExprKind::TypeChan => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeSession => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeDiffPrivate => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeDPBudget => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeCausalEffect => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAleatoric => self.resolve_type_args(te.type_args)
            TypeExprKind::TypePotentialOutcome => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeProof => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeLemma => self.resolve_type_args(te.type_args)
            TypeExprKind::TypeAxiom => self.resolve_type_args(te.type_args)
        }
    }

    fn resolve_refinement_inner(self, opt: Option<Box<RefinementInfo>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(info) => {
                match (*info).base_type {
                    None => self
                    Some(bte) => self.resolve_type_expr(*bte)
                }
            }
        }
    }

    fn resolve_knowledge_inner(self, opt: Option<Box<KnowledgeTypeInfo>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(info) => self.resolve_type_expr(*(*info).inner_type)
        }
    }

    fn resolve_opt_type(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }

    fn resolve_type_args(self, opt: Option<Box<TypeExprList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_type_expr((*list).head)
                r.resolve_type_args((*list).tail)
            }
            None => self
        }
    }

    fn resolve_models_def(self, opt: Option<Box<ModelsDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => self.resolve_ast_path_list((*md).models)
            None => self
        }
    }

    fn resolve_validation_def(self, opt: Option<Box<ValidationDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vd) => self.resolve_type_expr((*vd).target_type)
            None => self
        }
    }

    fn resolve_ast_path_list(self, opt: Option<Box<AstPathList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_path_head((*list).head)
                r.resolve_ast_path_list((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement resolution
// ============================================================

impl Resolver {
    fn resolve_block(self, blk: Block) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.push_scope()
        r = r.resolve_stmts(blk.stmts)
        r.pop_scope()
    }

    fn resolve_stmts(self, opt: Option<Box<StmtList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_stmt((*list).head)
                r.resolve_stmts((*list).tail)
            }
            None => self
        }
    }

    fn resolve_stmt(self, s: Stmt) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtKind::StmtLet => {
                // Resolve initializer BEFORE defining the variable
                var r = self.resolve_opt_type_boxed(s.ty)
                r = r.resolve_opt_expr(s.expr)
                r.define(s.name, SymbolKind::SymVariable, s.span)
            }
            StmtKind::StmtVar => {
                var r = self.resolve_opt_type_boxed(s.ty)
                r = r.resolve_opt_expr(s.expr)
                r.define(s.name, SymbolKind::SymVariable, s.span)
            }
            StmtKind::StmtExpr => self.resolve_opt_expr(s.expr)
            StmtKind::StmtAssign => {
                var r = self.resolve_opt_expr(s.target)
                r.resolve_opt_expr(s.expr)
            }
        }
    }

    fn resolve_opt_type_boxed(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }
}

// ============================================================
// Expression resolution
// ============================================================

impl Resolver {
    fn resolve_expr(self, e: Expr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match e.kind {
            ExprKind::ExprIntLit => self
            ExprKind::ExprFloatLit => self
            ExprKind::ExprBoolTrue => self
            ExprKind::ExprBoolFalse => self
            ExprKind::ExprStringLit => self
            ExprKind::ExprCharLit => self
            ExprKind::ExprIdent => {
                let found = self.lookup(e.name)
                if found < 0 {
                    // Allowlist read-only GPU thread-index intrinsics
                    // (gpu_thread_id_x/y/z, gpu_block_id_x/y/z,
                    //  gpu_block_dim_x/y/z, gpu_barrier, gpu_sync_threads).
                    // These are implicit builtins, never bound in the symbol
                    // table; the GPU backend lowers them to PTX sregs by name.
                    if name_is_gpu_builtin(e.name) {
                        self
                    } else {
                        self.report_error(e.span)
                    }
                } else {
                    self
                }
            }
            ExprKind::ExprPath => {
                // Path resolution: first segment must be in scope
                // (struct/enum name, module, etc.)
                // For now, just check the first segment exists
                self.resolve_path_head(e.path)
            }
            ExprKind::ExprBinary => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprKind::ExprUnary => self.resolve_opt_expr(e.left)
            ExprKind::ExprFieldAccess => {
                if expr_is_gpu_axis_field(e) {
                    return self
                }
                // Resolve the base expression; field checked by type checker
                self.resolve_opt_expr(e.left)
            }
            ExprKind::ExprIndex => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprKind::ExprMethodCall => {
                if expr_is_gpu_launch_descriptor_call(e) || expr_is_gpu_sync_call(e) {
                    return self.resolve_expr_list(e.args)
                }
                var r = self.resolve_opt_expr(e.left)
                r.resolve_expr_list(e.args)
            }
            ExprKind::ExprCall => {
                if expr_is_gpu_launch_invocation_call(e) {
                    var r_launch = self
                    match e.left {
                        Some(desc) => {
                            r_launch = r_launch.resolve_expr_list((*desc).args)
                        }
                        None => {}
                    }
                    return r_launch.resolve_expr_list(e.args)
                }
                if expr_is_gpu_launch_descriptor_call(e) || expr_is_gpu_sync_call(e) {
                    return self.resolve_expr_list(e.args)
                }
                var r = self.resolve_opt_expr(e.left)
                r.resolve_expr_list(e.args)
            }
            ExprKind::ExprContest => {
                var r = self.resolve_opt_expr(e.left)
                r
            }
            ExprKind::ExprAuditAttach => {
                var r = self.resolve_opt_expr(e.left)
                let found = r.lookup(e.name)
                if found < 0 {
                    r.report_error(e.span)
                } else {
                    r
                }
            }
            ExprKind::ExprIf => {
                var r = self.resolve_opt_expr(e.left)
                r = r.resolve_opt_block(e.block)
                r.resolve_opt_expr(e.else_expr)
            }
            ExprKind::ExprMatch => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_match_arms(e.arms)
            }
            ExprKind::ExprWhile => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_block(e.block)
            }
            ExprKind::ExprLoop => self.resolve_opt_block(e.block)
            ExprKind::ExprBlock => self.resolve_opt_block(e.block)
            ExprKind::ExprReturn => self.resolve_opt_expr(e.left)
            ExprKind::ExprBreak => self.resolve_opt_expr(e.left)
            ExprKind::ExprContinue => self
            ExprKind::ExprStructLit => {
                // Resolve path (struct name) and field init expressions
                var r = self.resolve_path_head(e.path)
                r.resolve_struct_field_inits(e.fields)
            }
            ExprKind::ExprArrayLit => self.resolve_expr_list(e.args)
            ExprKind::ExprTupleLit => self.resolve_expr_list(e.args)
            ExprKind::ExprRange => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprKind::ExprCast => self.resolve_opt_expr(e.left)
            ExprKind::ExprHandle => {
                var r = self.resolve_opt_block(e.block)
                r.resolve_opt_block_handler(e.handler_block)
            }
            ExprKind::ExprClosure => self.resolve_closure_expr(e)
            ExprKind::ExprForIn => self.resolve_for_in_expr(e)
            // Leaf node, no children -- same as ExprError below.
            ExprKind::ExprDsepProof => self
            ExprKind::ExprError => self
        }
    }

    fn resolve_opt_expr(self, opt: Option<Box<Expr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.resolve_expr(*e)
            None => self
        }
    }

    fn resolve_opt_block(self, opt: Option<Box<Block>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.resolve_block(*blk)
            None => self
        }
    }

    fn resolve_opt_block_handler(self, opt: Option<Box<Block>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.resolve_block(*blk)
            None => self
        }
    }

    fn resolve_expr_list(self, opt: Option<Box<ExprList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head)
                r.resolve_expr_list((*list).tail)
            }
            None => self
        }
    }

    fn resolve_path_head(self, path: AstPath) -> Resolver with Mut, Panic, Div, Alloc, IO {
        if path.seg_count > 0 {
            let resolved_name = copy_string_list_to_name(path.segments)
            let found = self.lookup(resolved_name)
            if found < 0 {
                // Not found — could be a builtin type, don't error
                self
            } else {
                self
            }
        } else {
            self
        }
    }

    fn resolve_closure_expr(self, e: Expr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.resolve_closure_param_types(e.closure_params)
        r = r.resolve_opt_type(e.closure_return)
        r = r.push_scope()
        r = r.define_closure_params(e.closure_params)
        r = r.resolve_opt_expr(e.closure_body)
        r.pop_scope()
    }

    fn resolve_closure_param_types(self, opt: Option<Box<ClosureParamList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_type_expr((*list).head.ty)
                r.resolve_closure_param_types((*list).tail)
            }
            None => self
        }
    }

    fn define_closure_params(self, opt: Option<Box<ClosureParamList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.define((*list).head.name, SymbolKind::SymParameter, (*list).head.span)
                r.define_closure_params((*list).tail)
            }
            None => self
        }
    }

    fn resolve_for_in_expr(self, e: Expr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.resolve_opt_expr(e.left)
        r = r.push_scope()
        r = r.define(e.name, SymbolKind::SymVariable, e.span)
        r = r.resolve_opt_block(e.block)
        r.pop_scope()
    }
}

// ============================================================
// Match arm resolution (binds pattern variables)
// ============================================================

impl Resolver {
    fn resolve_match_arms(self, opt: Option<Box<MatchArmList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_match_arm((*list).head)
                r.resolve_match_arms((*list).tail)
            }
            None => self
        }
    }

    fn resolve_match_arm(self, arm: MatchArm) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.push_scope()
        r = r.resolve_pattern(arm.pattern)
        r = r.resolve_expr(arm.body)
        r.pop_scope()
    }

    fn resolve_pattern(self, pat: Pattern) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatternKind::PatWildcard => self
            PatternKind::PatBinding => {
                // Introduce the binding into current scope
                self.define(pat.name, SymbolKind::SymVariable, pat.span)
            }
            PatternKind::PatIntLit => self
            PatternKind::PatBoolTrue => self
            PatternKind::PatBoolFalse => self
            PatternKind::PatStringLit => self
            PatternKind::PatEnum => {
                // Enum variant pattern — e.g. Some(x)
                // Resolve sub-patterns (which introduce bindings)
                self.resolve_pattern_list(pat.sub_patterns)
            }
            PatternKind::PatStruct => {
                self.resolve_pat_fields(pat.pat_fields)
            }
            PatternKind::PatTuple => {
                self.resolve_pattern_list(pat.sub_patterns)
            }
            PatternKind::PatOr => {
                self.resolve_pattern_list(pat.sub_patterns)
            }
        }
    }

    fn resolve_pattern_list(self, opt: Option<Box<PatternList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_pattern((*list).head)
                r.resolve_pattern_list((*list).tail)
            }
            None => self
        }
    }

    fn resolve_pat_fields(self, opt: Option<Box<PatFieldList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_pattern((*list).head.pattern)
                r.resolve_pat_fields((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Struct field init resolution
// ============================================================

impl Resolver {
    fn resolve_struct_field_inits(self, opt: Option<Box<StructFieldList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value)
                r.resolve_struct_field_inits((*list).tail)
            }
            None => self
        }
    }
}

// Note: copy_string_list_to_name is defined in parser/items.sio
// and shared via flat namespace — no duplicate needed here.
