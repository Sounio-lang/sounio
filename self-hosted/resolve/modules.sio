// T25: Dependency counts (forward and reverse)
fn test_mod_dep_counts() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let n_c = mod_make_name(99, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0

    // c depends on a and b
    g = mod_graph_add_dep(g, 2, 0)
    g = mod_graph_add_dep(g, 2, 1)
    // b depends on a
    g = mod_graph_add_dep(g, 1, 0)

    let c_fwd = mod_graph_module_dep_count(g, 2)
    let a_rev = mod_graph_module_reverse_dep_count(g, 0)
    let a_fwd = mod_graph_module_dep_count(g, 0)

    let ok = c_fwd == 2 && a_rev == 2 && a_fwd == 0
    mod_assert_true(ok, 25)
}

// T26: Split qualified name "foo::bar"
fn test_mod_split_qualified_basic() -> i64 with IO, Mut, Panic, Div {
    // "foo::bar" -> ("foo", 3, "bar", 3)
    var qname: [i8; 64] = [0; 64]
    qname[0] = 102  // f
    qname[1] = 111  // o
    qname[2] = 111  // o
    qname[3] = 58   // :
    qname[4] = 58   // :
    qname[5] = 98   // b
    qname[6] = 97   // a
    qname[7] = 114  // r

    let parts = mod_split_qualified(qname, 8)
    let first_len = parts.first_len
    let rest_len = parts.rest_len

    let first = parts.first
    let rest = parts.rest

    let ok = first_len == 3 && rest_len == 3
        && first[0] == 102 && first[1] == 111 && first[2] == 111
        && rest[0] == 98 && rest[1] == 97 && rest[2] == 114
    mod_assert_true(ok, 26)
}

// T27: Split unqualified name "foo" -> no split
fn test_mod_split_unqualified() -> i64 with IO, Mut, Panic, Div {
    var qname: [i8; 64] = [0; 64]
    qname[0] = 102  // f
    qname[1] = 111  // o
    qname[2] = 111  // o

    let parts = mod_split_qualified(qname, 3)
    let first_len = parts.first_len
    let rest_len = parts.rest_len

    let ok = first_len == 3 && rest_len == 0
    mod_assert_true(ok, 27)
}

// T28: Find module by parent
fn test_mod_find_by_parent() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_root = mod_make_name(114, 0, 0, 1)    // "r"
    let n_child = mod_make_name(99, 0, 0, 1)    // "c"
    let n_other = mod_make_name(111, 0, 0, 1)   // "o"

    let r0 = mod_graph_add_module(g, n_root, 1, p, 0, 0 - 1, true)
    g = r0.0
    let root_id = r0.1
    let r1 = mod_graph_add_module(g, n_child, 1, p, 0, root_id, true)
    g = r1.0
    let child_id = r1.1
    let r2 = mod_graph_add_module(g, n_other, 1, p, 0, 0 - 1, true)
    g = r2.0

    let found = mod_graph_find_module_by_parent(g, root_id, n_child, 1)
    let not_found = mod_graph_find_module_by_parent(g, root_id, n_other, 1)

    let ok = found == child_id && not_found < 0
    mod_assert_true(ok, 28)
}

// T29: No cycles in empty graph
fn test_mod_no_cycle_empty() -> i64 with IO, Mut, Panic, Div {
    let g = mod_graph_new()
    let has_cycle = mod_graph_check_cycles(g)
    mod_assert_true(!has_cycle, 29)
}

// T30: Topo sort of single module
fn test_mod_topo_sort_single() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0

    let result = mod_graph_topo_sort(g)
    let count = result.0
    let order = result.1

    let ok = count == 1 && order[0] == 0
    mod_assert_true(ok, 30)
}

// T31: Diamond dependency graph — topo sort produces valid order
fn test_mod_topo_sort_diamond() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)   // a (id=0)
    let n_b = mod_make_name(98, 0, 0, 1)   // b (id=1)
    let n_c = mod_make_name(99, 0, 0, 1)   // c (id=2)
    let n_d = mod_make_name(100, 0, 0, 1)  // d (id=3)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0
    let r3 = mod_graph_add_module(g, n_d, 1, p, 0, 0 - 1, true)
    g = r3.0

    // Diamond: a -> b, a -> c, b -> d, c -> d
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 0, 2)
    g = mod_graph_add_dep(g, 1, 3)
    g = mod_graph_add_dep(g, 2, 3)

    let result = mod_graph_topo_sort(g)
    let count = result.0
    let order = result.1

    // d must come before b and c, which must come before a
    // Kahn's with sequential init gives: d (in-deg 0 = 3), b (1), c (2), a (0)
    // Actually: node 3 (d) has 0 in-degree? No. a->b, a->c, b->d, c->d
    // in-degree: a=0, b=1, c=1, d=2. So a starts. Then b,c become 0. Then d.
    // Valid: a, b, c, d  or  a, c, b, d
    let ok = count == 4 && order[0] == 0 && order[3] == 3
    mod_assert_true(ok, 31)
}

// T32: Export kind constants
fn test_mod_kind_constants() -> i64 with IO, Mut, Panic, Div {
    let ok = MOD_KIND_FN == 1 && MOD_KIND_TYPE == 2 && MOD_KIND_CONST == 3 && MOD_KIND_MOD == 4
    mod_assert_true(ok, 32)
}

// T33: Self-cycle on single module
fn test_mod_self_cycle() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0

    g = mod_graph_add_dep(g, 0, 0)  // self-loop

    let has_cycle = mod_graph_check_cycles(g)
    mod_assert_true(has_cycle, 33)
}

// T34: has_dep helper
fn test_mod_has_dep() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0

    g = mod_graph_add_dep(g, 0, 1)

    let has = mod_graph_has_dep(g, 0, 1)
    let no_rev = mod_graph_has_dep(g, 1, 0)
    let no_self = mod_graph_has_dep(g, 0, 0)

    let ok = has && !no_rev && !no_self
    mod_assert_true(ok, 34)
}

// T35: Unqualified resolve finds export across any module
fn test_mod_resolve_unqualified() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0

    let e_fn = mod_make_name(102, 110, 0, 2)  // "fn"
    g = mod_graph_add_export(g, e_fn, 2, MOD_KIND_FN, 99, 0, true)

    // Resolve unqualified "fn" (no "::")
    let result = mod_graph_resolve_import(g, e_fn, 2)
    let resolved_mod = result.0
    let resolved_exp = result.1

    let ok = resolved_mod == 0 && resolved_exp == 0
    mod_assert_true(ok, 35)
}

// ============================================================================
// ENTRY POINT: run all module tests
// ============================================================================

fn run_module_graph_tests() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 35

    print("=== Module Graph Tests ===\n")

    passed = passed + test_mod_empty_graph()
    passed = passed + test_mod_add_single_module()
    passed = passed + test_mod_add_multiple_modules()
    passed = passed + test_mod_find_module()
    passed = passed + test_mod_add_exports()
    passed = passed + test_mod_add_deps()
    passed = passed + test_mod_dep_invalid_ids()
    passed = passed + test_mod_no_cycle_dag()
    passed = passed + test_mod_cycle_detected()
    passed = passed + test_mod_topo_sort_linear()
    passed = passed + test_mod_topo_sort_cycle()
    passed = passed + test_mod_topo_sort_disconnected()
    passed = passed + test_mod_collect_exports()
    passed = passed + test_mod_visibility_self()
    passed = passed + test_mod_visibility_private_blocked()
    passed = passed + test_mod_visibility_public_with_dep()
    passed = passed + test_mod_visibility_no_dep_edge()
    passed = passed + test_mod_visibility_parent_sees_child()
    passed = passed + test_mod_resolve_qualified_import()
    passed = passed + test_mod_resolve_unknown_module()
    passed = passed + test_mod_resolve_unknown_export()
    passed = passed + test_mod_mark_loaded()
    passed = passed + test_mod_export_count_per_module()
    passed = passed + test_mod_public_export_count()
    passed = passed + test_mod_dep_counts()
    passed = passed + test_mod_split_qualified_basic()
    passed = passed + test_mod_split_unqualified()
    passed = passed + test_mod_find_by_parent()
    passed = passed + test_mod_no_cycle_empty()
    passed = passed + test_mod_topo_sort_single()
    passed = passed + test_mod_topo_sort_diamond()
    passed = passed + test_mod_kind_constants()
    passed = passed + test_mod_self_cycle()
    passed = passed + test_mod_has_dep()
    passed = passed + test_mod_resolve_unqualified()

    print("\nModule graph tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
