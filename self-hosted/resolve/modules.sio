    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0

    g = mod_graph_add_dep(g, 1, 0)  // b depends on a

    let ok = g.dep_count == 1 && g.deps_from[0] == 1 && g.deps_to[0] == 0
    mod_assert_true(ok, 6)
}

// T07: Dependency with invalid IDs is no-op
fn test_mod_dep_invalid_ids() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0

    g = mod_graph_add_dep(g, 0, 5)   // 5 does not exist
    g = mod_graph_add_dep(g, 5, 0)   // 5 does not exist
    g = mod_graph_add_dep(g, 0 - 1, 0)

    let ok = g.dep_count == 0
    mod_assert_true(ok, 7)
}

// T08: No cycles in a DAG
fn test_mod_no_cycle_dag() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let n_c = mod_make_name(99, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0

    // a -> b -> c (no cycle)
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 1, 2)

    let has_cycle = mod_graph_check_cycles(g)
    mod_assert_true(!has_cycle, 8)
}

// T09: Cycle detected in circular graph
fn test_mod_cycle_detected() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let n_c = mod_make_name(99, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0

    // a -> b -> c -> a (cycle)
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 1, 2)
    g = mod_graph_add_dep(g, 2, 0)

    let has_cycle = mod_graph_check_cycles(g)
    mod_assert_true(has_cycle, 9)
}

// T10: Topological sort of a linear chain
fn test_mod_topo_sort_linear() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let n_c = mod_make_name(99, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0

    // a -> b -> c
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 1, 2)

    let result = mod_graph_topo_sort(g)
    let count = result.0
    let order = result.1

    // Should produce valid ordering of 3 modules
    // c has no dependencies so it comes first, then b, then a
    let ok = count == 3 && order[0] == 2 && order[1] == 1 && order[2] == 0
    mod_assert_true(ok, 10)
}

// T11: Topological sort detects cycle and returns -1
fn test_mod_topo_sort_cycle() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0

    // a -> b -> a (cycle)
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 1, 0)

    let result = mod_graph_topo_sort(g)
    let count = result.0

    let ok = count < 0
    mod_assert_true(ok, 11)
}

// T12: Topological sort of disconnected graph
fn test_mod_topo_sort_disconnected() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let n_c = mod_make_name(99, 0, 0, 1)
    let n_d = mod_make_name(100, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0
    let r2 = mod_graph_add_module(g, n_c, 1, p, 0, 0 - 1, true)
    g = r2.0
    let r3 = mod_graph_add_module(g, n_d, 1, p, 0, 0 - 1, true)
    g = r3.0

    // a -> b, c -> d (two independent chains)
    g = mod_graph_add_dep(g, 0, 1)
    g = mod_graph_add_dep(g, 2, 3)

    let result = mod_graph_topo_sort(g)
    let count = result.0

    let ok = count == 4
    mod_assert_true(ok, 12)
}

// T13: Collect exports from a specific module
fn test_mod_collect_exports() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let n_b = mod_make_name(98, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0

    // Add 2 exports to module a (id=0) and 1 to module b (id=1)
    let e_x = mod_make_name(120, 0, 0, 1)
    let e_y = mod_make_name(121, 0, 0, 1)
    let e_z = mod_make_name(122, 0, 0, 1)
    g = mod_graph_add_export(g, e_x, 1, MOD_KIND_FN, 10, 0, true)
    g = mod_graph_add_export(g, e_y, 1, MOD_KIND_TYPE, 11, 0, true)
    g = mod_graph_add_export(g, e_z, 1, MOD_KIND_CONST, 12, 1, true)

    let result_a = mod_graph_collect_exports(g, 0)
    let count_a = result_a.0
    let result_b = mod_graph_collect_exports(g, 1)
    let count_b = result_b.0

    let ok = count_a == 2 && count_b == 1
    mod_assert_true(ok, 13)
}

// T14: Visibility — self can always see own exports
fn test_mod_visibility_self() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
    let r0 = mod_graph_add_module(g, n_a, 1, p, 0, 0 - 1, true)
    g = r0.0

    let e_priv = mod_make_name(120, 0, 0, 1)
    g = mod_graph_add_export(g, e_priv, 1, MOD_KIND_FN, 10, 0, false)  // private!

    let can_see = mod_graph_visibility_check(g, 0, 0, 0)
    mod_assert_true(can_see, 14)
}

