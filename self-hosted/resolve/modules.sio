    g = r0.0
    let r1 = mod_graph_add_module(g, n_b, 1, p, 0, 0 - 1, true)
    g = r1.0

    let before = mod_graph_all_loaded(g)
    g = mod_graph_mark_loaded(g, 0)
    let middle = mod_graph_all_loaded(g)
    g = mod_graph_mark_loaded(g, 1)
    let after = mod_graph_all_loaded(g)

    let ok = !before && !middle && after
    mod_assert_true(ok, 22)
}

