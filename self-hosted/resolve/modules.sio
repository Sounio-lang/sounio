// T19: Resolve a qualified import "foo::bar_fn"
fn test_mod_resolve_qualified_import() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    // Module "foo"
    let n_foo = mod_make_name(102, 111, 111, 3)
    let r0 = mod_graph_add_module(g, n_foo, 3, p, 0, 0 - 1, true)
    g = r0.0

    // Export "bar" in module "foo"
    let n_bar = mod_make_name(98, 97, 114, 3)
    g = mod_graph_add_export(g, n_bar, 3, MOD_KIND_FN, 42, 0, true)

    // Build qualified name "foo::bar" as bytes: f=102,o=111,o=111,:=58,:=58,b=98,a=97,r=114
    var qname: [i8; 64] = [0; 64]
    qname[0] = 102  // f
    qname[1] = 111  // o
    qname[2] = 111  // o
    qname[3] = 58   // :
    qname[4] = 58   // :
    qname[5] = 98   // b
    qname[6] = 97   // a
    qname[7] = 114  // r
    let qlen: i64 = 8

    let result = mod_graph_resolve_import(g, qname, qlen)
    let resolved_mod = result.0
    let resolved_exp = result.1

    let ok = resolved_mod == 0 && resolved_exp == 0
    mod_assert_true(ok, 19)
}

// T20: Resolve import fails for unknown module
fn test_mod_resolve_unknown_module() -> i64 with IO, Mut, Panic, Div {
    let g = mod_graph_new()

    // Try resolving "xyz::fn1" in empty graph
    var qname: [i8; 64] = [0; 64]
    qname[0] = 120  // x
    qname[1] = 121  // y
    qname[2] = 122  // z
    qname[3] = 58   // :
    qname[4] = 58   // :
    qname[5] = 102  // f
    qname[6] = 110  // n
    qname[7] = 49   // 1
    let qlen: i64 = 8

    let result = mod_graph_resolve_import(g, qname, qlen)
    let resolved_mod = result.0

    let ok = resolved_mod < 0
    mod_assert_true(ok, 20)
}

// T21: Resolve import fails for unknown export in known module
fn test_mod_resolve_unknown_export() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
