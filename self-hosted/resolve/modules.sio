    g = r0.0
    // Module "foo" exists but has no exports

    // Try resolving "foo::bar"
    var qname: [i8; 64] = [0; 64]
    qname[0] = 102  // f
    qname[1] = 111  // o
    qname[2] = 111  // o
    qname[3] = 58   // :
    qname[4] = 58   // :
    qname[5] = 98   // b
    qname[6] = 97   // a
    qname[7] = 114  // r
    let qlen: i64 = 8

    let result = mod_graph_resolve_import(g, qname, qlen)
    let resolved_exp = result.1

    let ok = resolved_exp < 0
    mod_assert_true(ok, 21)
}

// T22: Mark modules loaded
fn test_mod_mark_loaded() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_a = mod_make_name(97, 0, 0, 1)
