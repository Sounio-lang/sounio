// Name Resolution — entry point
//
// Runs the two-pass resolution algorithm on a Program AST:
//   Pass 1: collect all top-level declarations (forward references)
//   Pass 2: resolve identifiers in all item bodies
//
// Returns a ResolveResult with the final symbol table and error count.

module resolve::mod

use parser::ast::*
use lexer::span::*
use resolve::resolve::*
use resolve::symbol::*
use resolve::imports::*

pub struct ResolveResult {
    symbols: SymbolTable,
    error_count: i64,
    had_error: bool,
}

// Inject built-in function names into a resolver's global scope so that
// single-file programs can call builtins (print, read_file, etc.) without
// triggering "symbol not found" resolve errors.  These are handled at the
// IR lowering / native codegen layer and need no AST definition.
fn inject_builtins(r: Resolver) -> Resolver with Mut, Panic, Div {
    var res = r
    let dummy = Span::dummy()
    // "print" (5)
    res = res.define(builtin_name_5(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "print_int" (9): p r i n t _ i n t
    res = res.define(builtin_name_9(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8, 95 as i8, 105 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "print_char" (10): p r i n t _ c h a r
    res = res.define(builtin_name_10(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8, 95 as i8, 99 as i8, 104 as i8, 97 as i8, 114 as i8), SymbolKind::SymFunction, dummy)
    // "read_file" (9): r e a d _ f i l e
    res = res.define(builtin_name_9(114 as i8, 101 as i8, 97 as i8, 100 as i8, 95 as i8, 102 as i8, 105 as i8, 108 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "write_file" (10): w r i t e _ f i l e
    res = res.define(builtin_name_10(119 as i8, 114 as i8, 105 as i8, 116 as i8, 101 as i8, 95 as i8, 102 as i8, 105 as i8, 108 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "file_size" (9): f i l e _ s i z e
    res = res.define(builtin_name_9(102 as i8, 105 as i8, 108 as i8, 101 as i8, 95 as i8, 115 as i8, 105 as i8, 122 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "get_arg_count" (13): g e t _ a r g _ c o u n t
    res = res.define(builtin_name_13(103 as i8, 101 as i8, 116 as i8, 95 as i8, 97 as i8, 114 as i8, 103 as i8, 95 as i8, 99 as i8, 111 as i8, 117 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "get_arg" (7): g e t _ a r g
    res = res.define(builtin_name_7(103 as i8, 101 as i8, 116 as i8, 95 as i8, 97 as i8, 114 as i8, 103 as i8), SymbolKind::SymFunction, dummy)
    // "str_len" (7): s t r _ l e n
    res = res.define(builtin_name_7(115 as i8, 116 as i8, 114 as i8, 95 as i8, 108 as i8, 101 as i8, 110 as i8), SymbolKind::SymFunction, dummy)
    // "str_eq" (6): s t r _ e q
    res = res.define(builtin_name_6(115 as i8, 116 as i8, 114 as i8, 95 as i8, 101 as i8, 113 as i8), SymbolKind::SymFunction, dummy)
    // "str_slice" (9): s t r _ s l i c e
    res = res.define(builtin_name_9(115 as i8, 116 as i8, 114 as i8, 95 as i8, 115 as i8, 108 as i8, 105 as i8, 99 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "starts_with" (11): s t a r t s _ w i t h
    res = res.define(builtin_name_11(115 as i8, 116 as i8, 97 as i8, 114 as i8, 116 as i8, 115 as i8, 95 as i8, 119 as i8, 105 as i8, 116 as i8, 104 as i8), SymbolKind::SymFunction, dummy)
    // "str_concat" (10): s t r _ c o n c a t
    res = res.define(builtin_name_10(115 as i8, 116 as i8, 114 as i8, 95 as i8, 99 as i8, 111 as i8, 110 as i8, 99 as i8, 97 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    res
}

fn builtin_name_5(a: i8, b: i8, c: i8, d: i8, e: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 5 }
    n.buf[0] = a; n.buf[1] = b; n.buf[2] = c; n.buf[3] = d; n.buf[4] = e
    n
}

fn builtin_name_6(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_5(a, b, c, d, e)
    n.len = 6; n.buf[5] = f
    n
}

fn builtin_name_7(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_6(a, b, c, d, e, f)
    n.len = 7; n.buf[6] = g
    n
}

fn builtin_name_9(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_7(a, b, c, d, e, f, g)
    n.len = 9; n.buf[7] = h; n.buf[8] = i
    n
}

fn builtin_name_10(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_9(a, b, c, d, e, f, g, h, i)
    n.len = 10; n.buf[9] = j
    n
}

fn builtin_name_11(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_10(a, b, c, d, e, f, g, h, i, j)
    n.len = 11; n.buf[10] = k
    n
}

fn builtin_name_13(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_11(a, b, c, d, e, f, g, h, i, j, k)
    n.len = 13; n.buf[11] = l; n.buf[12] = m
    n
}

pub(crate) fn resolve_program(prog: Program) -> ResolveResult with Mut, Panic, Div, Alloc, IO {
    var r = resolver_new()

    // Inject builtin function names so single-file programs can call print etc.
    r = inject_builtins(r)

    // Pass 1: collect top-level items into global scope
    r = r.collect_items(prog.items)

    // Pass 2: resolve bodies
    r = r.resolve_items(prog.items)

    ResolveResult {
        symbols: r.symbols,
        error_count: r.error_count,
        had_error: r.had_error,
    }
}

// Multi-module resolution: build an export registry then resolve each module with validated imports.

pub struct ResolveBatchResult {
    results: [ResolveResult; 256],
    count: i64,
    error_count: i64,
    had_error: bool,
}

fn empty_resolve_result() -> ResolveResult with Mut, Panic, Div {
    ResolveResult { symbols: symbol_table_new(), error_count: 0, had_error: false }
}

pub fn resolve_modules(programs: [Program; 256], count: i64) -> ResolveBatchResult with Mut, Panic, Div, Alloc, IO {
    var reg = module_registry_new()

    // Pass 0: collect pub exports for each module
    var i: i64 = 0
    while i < count && i < 256 {
        let prog = programs[i as usize]
        let pair = collect_module_exports(prog.items)
        reg = module_registry_put(reg, prog.module_path, pair.0, pair.1)
        i = i + 1
    }
    // #1689: ASK whether anything was dropped. Silence here is what turned a
    // capacity limit into 80 spurious E137 in main.sio.
    let _ovf = module_registry_report_overflow(reg)

    // Resolve each module using the shared export registry
    var results: [ResolveResult; 256] = [empty_resolve_result(); 256]
    var total_err: i64 = 0
    var had: bool = false

    var j: i64 = 0
    while j < count && j < 256 {
        var r = resolver_with_modules(reg)
        r = r.collect_items(programs[j as usize].items)
        r = r.resolve_items(programs[j as usize].items)

        results[j as usize] = ResolveResult {
            symbols: r.symbols,
            error_count: r.error_count,
            had_error: r.had_error,
        }

        total_err = total_err + r.error_count
        if r.had_error { had = true }
        j = j + 1
    }

    ResolveBatchResult {
        results: results,
        count: count,
        error_count: total_err,
        had_error: had,
    }
}
