// Symbol table types for name resolution
//
// Flat-array symbol table with counter. Each symbol has a unique ID,
// a name, kind, span, and scope depth at definition time.

// ============================================================
// Symbol kinds
// ============================================================

enum SymbolKind {
    SymFunction,
    SymStruct,
    SymEnum,
    SymEnumVariant,
    SymVariable,
    SymParameter,
    SymField,
    SymTypeAlias,
    SymMethod,
    SymImplBlock,
}

// ============================================================
// Symbol entry
// ============================================================

struct Symbol {
    name: Name,
    kind: SymbolKind,
    def_span: Span,
    scope_depth: i64,
    sym_id: i64,
}

fn empty_symbol() -> Symbol {
    Symbol {
        name: Name { buf: [0; 128], len: 0 },
        kind: SymbolKind::SymVariable,
        def_span: Span::dummy(),
        scope_depth: 0,
        sym_id: -1,
    }
}

// ============================================================
// Symbol table — flat array
// ============================================================

struct SymbolTable {
    symbols: [Symbol; 4096],
    count: i64,
}

fn symbol_table_new() -> SymbolTable {
    SymbolTable {
        symbols: [empty_symbol(); 4096],
        count: 0,
    }
}

impl SymbolTable {
    fn add(self, sym: Symbol) -> SymbolTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 4096 {
            tbl.symbols[tbl.count] = sym
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn get(self, idx: i64) -> Symbol with Panic, Div {
        self.symbols[idx]
    }
}

// ============================================================
// Name comparison — byte-by-byte
// ============================================================

fn name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i] != b.buf[i] {
            return false
        }
        i = i + 1
    }
    true
}

fn name_is_empty(n: Name) -> bool {
    n.len == 0
}
