// Symbol table types for name resolution
//
// Flat-array symbol table with counter. Each symbol has a unique ID,
// a name, kind, span, and scope depth at definition time.

module resolve::symbol

use parser::ast::{Name, name_eq, name_is_empty}
use lexer::span::*

// ============================================================
// Symbol kinds
// ============================================================

pub enum SymbolKind {
    SymFunction,
    SymStruct,
    SymEnum,
    SymEnumVariant,
    SymVariable,
    SymParameter,
    SymField,
    SymTypeAlias,
    SymPolicy,
    SymAcquisitionPolicy,
    SymRecoursePolicy,
    SymTransitionPolicy,
    SymTransitionProtocol,
    SymMonitoringPolicy,
    SymAlternativePolicy,
    SymAlternativeFrontier,
    SymDecisionPolicy,
    SymDeferralPolicy,
    SymAudit,
    SymMethod,
    SymImplBlock,
    SymImported,
    SymEffect,
    SymEffectOp,
    SymUnit,
}

// ============================================================
// Symbol entry
// ============================================================

pub struct Symbol {
    name: Name,
    kind: SymbolKind,
    def_span: Span,
    scope_depth: i64,
    sym_id: i64,
}

fn empty_symbol() -> Symbol {
    Symbol {
        name: Name { buf: [0; 384], len: 0 },
        kind: SymbolKind::SymVariable,
        def_span: Span::dummy(),
        scope_depth: 0,
        sym_id: -1,
    }
}

// ============================================================
// Symbol table — flat array
// ============================================================

pub struct SymbolTable {
    symbols: [Symbol; 4096],
    count: i64,
}

pub fn symbol_table_new() -> SymbolTable {
    SymbolTable {
        symbols: [empty_symbol(); 4096],
        count: 0,
    }
}

impl SymbolTable {
    fn add(self, sym: Symbol) -> SymbolTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 4096 {
            tbl.symbols[tbl.count] = sym
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn get(self, idx: i64) -> Symbol with Panic, Div {
        self.symbols[idx]
    }
}

// name_eq and name_is_empty imported from parser::ast
