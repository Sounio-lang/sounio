// Import resolution helpers for selective imports (use path::{A, B, C})
//
// ImportItemList is a linked list of Names from the AST.
// These helpers operate on ImportItemList for name lookup and counting.

module resolve::imports

use parser::ast::*

// ============================================================
// ImportItemList helpers
// ============================================================

fn import_item_list_contains(list: Option<Box<ImportItemList>>, name: Name) -> bool with Mut, Panic, Div, Alloc {
    match list {
        None => false
        Some(node) => {
            if name_eq((*node).head, name) {
                true
            } else {
                import_item_list_contains((*node).tail, name)
            }
        }
    }
}

fn import_item_list_count(list: Option<Box<ImportItemList>>) -> i64 with Mut, Panic, Div, Alloc {
    match list {
        None => 0
        Some(node) => 1 + import_item_list_count((*node).tail)
    }
}

fn import_item_list_get(list: Option<Box<ImportItemList>>, idx: i64) -> Name with Mut, Panic, Div, Alloc {
    match list {
        None => Name { buf: [0; 128], len: 0 }
        Some(node) => {
            if idx == 0 {
                (*node).head
            } else {
                import_item_list_get((*node).tail, idx - 1)
            }
        }
    }
}

// ============================================================
// Module registry (minimal; for cross-file imports)
// ============================================================

pub struct ModuleExport {
    name: Name,
    kind: SymbolKind,
}

pub struct ModuleEntry {
    path: AstPath,
    exports: [ModuleExport; 1024],
    export_count: i64,
}

pub struct ModuleRegistry {
    modules: [ModuleEntry; 64],
    count: i64,
    overflow: bool,
}

// ModuleAuthority is intentionally separate from ModuleRegistry. The registry
// carries public exports for resolver/linker consumers; this table preserves
// the exact candidate selected by a caller import before visibility decides
// whether that candidate is accessible.
pub struct ModuleBinding {
    owner_module_id: i64,
    local_name: Name,
    target_module_id: i64,
    target_name: Name,
    kind: SymbolKind,
}

pub struct ModuleAuthority {
    bindings: [ModuleBinding; 4096],
    binding_count: i64,
    overflow: bool,
    ambiguous: bool,
    unresolved: bool,
}

fn empty_module_binding() -> ModuleBinding {
    ModuleBinding {
        owner_module_id: 0 - 1,
        local_name: Name { buf: [0; 128], len: 0 },
        target_module_id: 0 - 1,
        target_name: Name { buf: [0; 128], len: 0 },
        kind: SymbolKind::SymVariable,
    }
}

pub fn module_authority_alloc() -> *mut ModuleAuthority with Alloc {
    // Keep the authority heap-owned. Passing its 4096-entry backing array by
    // value would recreate the large-aggregate ABI hazard in the bootstrap.
    heap_alloc(2097152) as *mut ModuleAuthority
}

pub fn module_authority_init_in_place(authority: *mut ModuleAuthority) with Mut, Panic, Div {
    // Initialize one slot at a time. The authority lives on the heap precisely
    // so bootstrap code never has to materialize its 1MiB-plus backing array
    // as an aggregate temporary.
    var i: i64 = 0
    while i < 4096 {
        (*authority).bindings[i as usize] = empty_module_binding()
        i = i + 1
    }
    (*authority).binding_count = 0
    (*authority).overflow = false
    (*authority).ambiguous = false
    (*authority).unresolved = false
}

fn module_binding_same_target(a: ModuleBinding, target_module_id: i64, target_name: Name, kind: SymbolKind) -> bool with Mut, Panic, Div {
    a.target_module_id == target_module_id && name_eq(a.target_name, target_name) && a.kind == kind
}

pub fn module_authority_add_binding(
    authority: *mut ModuleAuthority,
    owner_module_id: i64,
    local_name: Name,
    target_module_id: i64,
    target_name: Name,
    kind: SymbolKind
) with Mut, Panic, Div {
    if name_is_empty(local_name) || name_is_empty(target_name) {
        return
    }
    var i: i64 = 0
    while i < (*authority).binding_count {
        let prior = (*authority).bindings[i as usize]
        if prior.owner_module_id == owner_module_id
            && name_eq(prior.local_name, local_name)
            && prior.kind == kind {
            if !module_binding_same_target(prior, target_module_id, target_name, kind) {
                (*authority).ambiguous = true
            }
            return
        }
        i = i + 1
    }
    if (*authority).binding_count >= 4096 {
        (*authority).overflow = true
        return
    }
    let slot = (*authority).binding_count
    (*authority).bindings[slot as usize] = ModuleBinding {
        owner_module_id: owner_module_id,
        local_name: local_name,
        target_module_id: target_module_id,
        target_name: target_name,
        kind: kind,
    }
    (*authority).binding_count = slot + 1
}

pub fn module_authority_find_binding(
    authority: *mut ModuleAuthority,
    owner_module_id: i64,
    local_name: Name,
    kind: SymbolKind
) -> i64 with Mut, Panic, Div {
    if authority == (0 as *mut ModuleAuthority) || (*authority).overflow || (*authority).ambiguous || (*authority).unresolved {
        return 0 - 1
    }
    var i: i64 = 0
    while i < (*authority).binding_count {
        let binding = (*authority).bindings[i as usize]
        if binding.owner_module_id == owner_module_id
            && binding.kind == kind
            && name_eq(binding.local_name, local_name) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn module_authority_is_valid(authority: *mut ModuleAuthority) -> bool with Mut, Panic, Div {
    authority != (0 as *mut ModuleAuthority) && !(*authority).overflow && !(*authority).ambiguous && !(*authority).unresolved
}

pub fn module_authority_has_unresolved_import(authority: *mut ModuleAuthority) -> bool with Mut, Panic, Div {
    authority != (0 as *mut ModuleAuthority) && (*authority).unresolved
}

pub fn module_authority_binding_target_module(authority: *mut ModuleAuthority, binding_idx: i64) -> i64 with Mut, Panic, Div {
    if authority == (0 as *mut ModuleAuthority) || binding_idx < 0 || binding_idx >= (*authority).binding_count {
        0 - 1
    } else {
        (*authority).bindings[binding_idx as usize].target_module_id
    }
}

pub fn module_authority_binding_target_name(authority: *mut ModuleAuthority, binding_idx: i64) -> Name with Mut, Panic, Div {
    if authority == (0 as *mut ModuleAuthority) || binding_idx < 0 || binding_idx >= (*authority).binding_count {
        Name { buf: [0; 128], len: 0 }
    } else {
        (*authority).bindings[binding_idx as usize].target_name
    }
}

fn module_authority_bind_variant(
    authority: *mut ModuleAuthority,
    owner_module_id: i64,
    local_name: Name,
    target_module_id: i64,
    enum_name: Name,
    variants: Option<Box<VariantDefList>>
) -> bool with Mut, Panic, Div, Alloc {
    match variants {
        None => false
        Some(list) => {
            var found = false
            if name_eq((*list).head.name, local_name) {
                module_authority_add_binding(
                    authority,
                    owner_module_id,
                    local_name,
                    target_module_id,
                    enum_name,
                    SymbolKind::SymEnumVariant
                )
                found = true
            }
            if module_authority_bind_variant(
                authority,
                owner_module_id,
                local_name,
                target_module_id,
                enum_name,
                (*list).tail
            ) {
                found = true
            }
            found
        }
    }
}

fn module_authority_bind_name_from_items(
    authority: *mut ModuleAuthority,
    owner_module_id: i64,
    target_module_id: i64,
    local_name: Name,
    items: Option<Box<ItemList>>
) -> bool with Mut, Panic, Div, Alloc {
    match items {
        None => false
        Some(list) => {
            let item = (*list).head
            var found = false
            if item.kind == ItemKind::ItemFn && name_eq(item.name, local_name) {
                module_authority_add_binding(authority, owner_module_id, local_name, target_module_id, item.name, SymbolKind::SymFunction)
                found = true
            } else if item.kind == ItemKind::ItemStruct && name_eq(item.name, local_name) {
                module_authority_add_binding(authority, owner_module_id, local_name, target_module_id, item.name, SymbolKind::SymStruct)
                found = true
            } else if item.kind == ItemKind::ItemEnum {
                if name_eq(item.name, local_name) {
                    module_authority_add_binding(authority, owner_module_id, local_name, target_module_id, item.name, SymbolKind::SymEnum)
                    found = true
                }
                match item.enum_def {
                    None => {}
                    Some(def) => {
                        if module_authority_bind_variant(
                            authority,
                            owner_module_id,
                            local_name,
                            target_module_id,
                            item.name,
                            (*def).variants
                        ) {
                            found = true
                        }
                    }
                }
            }
            if module_authority_bind_name_from_items(
                authority,
                owner_module_id,
                target_module_id,
                local_name,
                (*list).tail
            ) {
                found = true
            }
            found
        }
    }
}

pub fn module_authority_bind_import_name(
    authority: *mut ModuleAuthority,
    owner_module_id: i64,
    target_module_id: i64,
    local_name: Name,
    target_items: Option<Box<ItemList>>
) with Mut, Panic, Div, Alloc {
    if target_module_id < 0 {
        (*authority).unresolved = true
        return
    }
    if !module_authority_bind_name_from_items(
        authority,
        owner_module_id,
        target_module_id,
        local_name,
        target_items
    ) {
        // A named use declaration is evidence, even when its requested
        // symbol is absent. Never allow that declaration to fall through to
        // an unrelated global definition with the same spelling.
        (*authority).unresolved = true
    }
}

fn empty_module_export() -> ModuleExport {
    ModuleExport { name: Name { buf: [0; 128], len: 0 }, kind: SymbolKind::SymVariable }
}

fn empty_module_entry() -> ModuleEntry {
    ModuleEntry {
        path: empty_path(),
        exports: [empty_module_export(); 1024],
        export_count: 0,
    }
}

pub fn module_registry_new() -> ModuleRegistry {
    ModuleRegistry {
        modules: [empty_module_entry(); 64],
        count: 0,
        overflow: false,
    }
}

// StringList equality (byte-by-byte + structural)
fn string_list_eq(a: StringList, b: StringList) -> bool with Mut, Panic, Div, Alloc {
    if a.head_len != b.head_len { return false }

    var i: i64 = 0
    while i < a.head_len && i < 128 {
        if a.head_buf[i] != b.head_buf[i] { return false }
        i = i + 1
    }

    match (a.tail, b.tail) {
        (None, None) => true
        (Some(at), Some(bt)) => string_list_eq(*at, *bt)
        _ => false
    }
}

fn path_eq(a: AstPath, b: AstPath) -> bool with Mut, Panic, Div, Alloc {
    if a.seg_count != b.seg_count { return false }
    if a.seg_count == 0 { return true }
    string_list_eq(a.segments, b.segments)
}

pub fn module_registry_find(reg: ModuleRegistry, path: AstPath) -> i64 with Mut, Panic, Div, Alloc {
    var i: i64 = 0
    while i < reg.count {
        if path_eq(reg.modules[i as usize].path, path) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn module_registry_put(
    reg: ModuleRegistry,
    path: AstPath,
    exports: [ModuleExport; 1024],
    export_count: i64
) -> ModuleRegistry with Mut, Panic, Div, Alloc {
    var r = reg
    let idx = module_registry_find(r, path)
    if idx >= 0 {
        r.modules[idx as usize] = ModuleEntry {
            path: path,
            exports: exports,
            export_count: export_count,
        }
        return r
    }

    if r.count < 64 {
        r.modules[r.count as usize] = ModuleEntry {
            path: path,
            exports: exports,
            export_count: export_count,
        }
        r.count = r.count + 1
    } else {
        r.overflow = true
    }
    r
}

fn module_entry_contains(entry: ModuleEntry, name: Name) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < entry.export_count && i < 1024 {
        if name_eq(entry.exports[i as usize].name, name) {
            return true
        }
        i = i + 1
    }
    false
}

fn exports_empty() -> [ModuleExport; 1024] {
    [empty_module_export(); 1024]
}

fn exports_push(
    exports: [ModuleExport; 1024],
    count: i64,
    name: Name,
    kind: SymbolKind
) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div {
    var ex = exports
    var c = count
    if c < 1024 && !name_is_empty(name) {
        ex[c as usize] = ModuleExport { name: name, kind: kind }
        c = c + 1
    }
    (ex, c)
}

pub fn collect_module_exports(items: Option<Box<ItemList>>) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div, Alloc {
    collect_module_exports_loop(items, exports_empty(), 0)
}

fn collect_module_exports_loop(
    items: Option<Box<ItemList>>,
    exports: [ModuleExport; 1024],
    count: i64
) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div, Alloc {
    match items {
        None => (exports, count)
        Some(list) => {
            let item = (*list).head
            let pair = collect_module_exports_item(item, exports, count)
            collect_module_exports_loop((*list).tail, pair.0, pair.1)
        }
    }
}

fn collect_module_exports_item(
    item: Item,
    exports: [ModuleExport; 1024],
    count: i64
) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div, Alloc {
    // For now: export pub top-level items, and for pub enums also export variant names
    match item.kind {
        ItemKind::ItemFn => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymFunction) } else { (exports, count) }
        }
        ItemKind::ItemStruct => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymStruct) } else { (exports, count) }
        }
        ItemKind::ItemEnum => {
            if visibility_to_bool(item.visibility) {
                let pair = exports_push(exports, count, item.name, SymbolKind::SymEnum)
                collect_module_exports_variants(item.enum_def, pair.0, pair.1)
            } else {
                (exports, count)
            }
        }
        ItemKind::ItemTypeAlias => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemModels => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymPolicy) } else { (exports, count) }
        }
        ItemKind::ItemAcquisitionPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymAcquisitionPolicy) } else { (exports, count) }
        }
        ItemKind::ItemRecoursePolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymRecoursePolicy) } else { (exports, count) }
        }
        ItemKind::ItemTransitionPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTransitionPolicy) } else { (exports, count) }
        }
        ItemKind::ItemTransitionProtocol => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTransitionProtocol) } else { (exports, count) }
        }
        ItemKind::ItemMonitoringPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymMonitoringPolicy) } else { (exports, count) }
        }
        ItemKind::ItemAlternativePolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymAlternativePolicy) } else { (exports, count) }
        }
        ItemKind::ItemAlternativeFrontier => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymAlternativeFrontier) } else { (exports, count) }
        }
        ItemKind::ItemDecisionPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymDecisionPolicy) } else { (exports, count) }
        }
        ItemKind::ItemDeferralPolicy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymDeferralPolicy) } else { (exports, count) }
        }
        ItemKind::ItemValidation => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymPolicy) } else { (exports, count) }
        }
        ItemKind::ItemAudit => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymAudit) } else { (exports, count) }
        }
        ItemKind::ItemEffect => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymEffect) } else { (exports, count) }
        }
        ItemKind::ItemSession => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemTrait => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemAlgebra => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemStudy => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemOntology => {
            if visibility_to_bool(item.visibility) { exports_push(exports, count, item.name, SymbolKind::SymTypeAlias) } else { (exports, count) }
        }
        ItemKind::ItemImpl => (exports, count)
        ItemKind::ItemUse => (exports, count)
        ItemKind::ItemUnit => (exports, count)
    }
}

fn collect_module_exports_variants(
    opt: Option<Box<EnumDef>>,
    exports: [ModuleExport; 1024],
    count: i64
) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div, Alloc {
    match opt {
        None => (exports, count)
        Some(ed) => collect_module_exports_variant_list((*ed).variants, exports, count)
    }
}

fn collect_module_exports_variant_list(
    opt: Option<Box<VariantDefList>>,
    exports: [ModuleExport; 1024],
    count: i64
) -> ([ModuleExport; 1024], i64) with Mut, Panic, Div, Alloc {
    match opt {
        None => (exports, count)
        Some(list) => {
            let pair = exports_push(exports, count, (*list).head.name, SymbolKind::SymEnumVariant)
            collect_module_exports_variant_list((*list).tail, pair.0, pair.1)
        }
    }
}
