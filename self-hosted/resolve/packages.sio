// ---------- Topological sort tests ----------

fn test_pkg_topo_sort_linear() -> bool with Mut, Panic, Div {
    // A -> B -> C
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 10, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 20, 1, 0, 0)
    reg = rb.0
    let rc = pkg_registry_add_package(reg, 30, 1, 0, 0)
    reg = rc.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 1, 2, cst.1, false, false)

    var buf: [i64; 2048] = [0; 2048]
    let result = pkg_topo_sort(reg, buf)
    let count = result.0

    // All 3 sorted; C (no outgoing) should come before B before A in topo order
    // Actually: Kahn's puts zero-in-degree first. A has in-degree 0.
    // Result: A first, then B, then C
    count == 3
}

fn test_pkg_topo_sort_diamond() -> bool with Mut, Panic, Div {
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 10, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 20, 1, 0, 0)
    reg = rb.0
    let rc = pkg_registry_add_package(reg, 30, 1, 0, 0)
    reg = rc.0
    let rd = pkg_registry_add_package(reg, 40, 1, 0, 0)
    reg = rd.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 0, 2, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 1, 3, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 2, 3, cst.1, false, false)

    var buf: [i64; 2048] = [0; 2048]
    let result = pkg_topo_sort(reg, buf)
    let count = result.0
    buf = result.1

    // 4 nodes. A must come first (only zero-in-degree root).
    // D must come last (has in-degree 2).
    let ok1 = count == 4
    let ok2 = buf[0] == 0   // A is first
    let ok3 = buf[3] == 3   // D is last
    ok1 && ok2 && ok3
}

fn test_pkg_topo_sort_cycle_detected() -> bool with Mut, Panic, Div {
    // A -> B -> C -> A
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 10, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 20, 1, 0, 0)
    reg = rb.0
    let rc = pkg_registry_add_package(reg, 30, 1, 0, 0)
    reg = rc.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 1, 2, cst.1, false, false)
    reg = pkg_registry_add_dep(reg, 2, 0, cst.1, false, false)

    var buf: [i64; 2048] = [0; 2048]
    let result = pkg_topo_sort(reg, buf)
    let count = result.0

    // Returns -1 for cycle
    count == (0 - 1)
}

