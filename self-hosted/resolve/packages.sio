}

// ---------- Backtrack tests ----------

fn test_pkg_backtrack_push_pop() -> bool with Mut, Panic, Div {
    var reg = pkg_registry_new()
    var res = pkg_resolver_new(reg)
    res = pkg_resolver_push_backtrack(res, 5, 2, 10)

    let ok1 = res.backtrack_depth == 1
    let pop_result = pkg_resolver_pop_backtrack(res)
    res = pop_result.0
    let state = pop_result.1

    let ok2 = res.backtrack_depth == 0
    let ok3 = state.pkg_idx == 5
    let ok4 = state.version_tried == 2
    let ok5 = state.solution_count_at == 10
    ok1 && ok2 && ok3 && ok4 && ok5
}

fn test_pkg_backtrack_restore_solution() -> bool with Mut, Panic, Div {
    var reg = pkg_registry_new()
    var res = pkg_resolver_new(reg)
    res = pkg_resolver_add_solution(res, 0, 10)
    res = pkg_resolver_add_solution(res, 1, 20)
    res = pkg_resolver_add_solution(res, 2, 30)

    let ok1 = res.solution_count == 3
    res = pkg_resolver_restore_solution(res, 1)
    let ok2 = res.solution_count == 1
    let ok3 = res.solution[0].pkg_id == 0
    // Cleared entries should be empty
    let ok4 = res.solution[1].pkg_id == (0 - 1)
    ok1 && ok2 && ok3 && ok4
}

// ---------- Optional dependency tests ----------

fn test_pkg_optional_dep_not_required() -> bool with Mut, Panic, Div {
    // A has optional dep on B. B is not in registry.
    // Resolution should succeed for A alone.
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 10, 1, 0, 0)
    reg = ra.0

    // Optional dep pointing to non-existent package index
    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    // Not adding package 200, but dep references idx 1 which doesn't exist
    // This is fine since the dep is optional
    reg = pkg_registry_add_dep(reg, 0, 99, cst.1, true, false)

    var res = pkg_resolver_new(reg)
    res = pkg_resolve(res)

    res.is_resolved && res.solution_count == 1
}

fn test_pkg_dev_dep_flag() -> bool with Mut, Panic, Div {
    // Verify dev-only flag is preserved
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 10, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 20, 1, 0, 0)
    reg = rb.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, true)

    reg.deps[0].is_dev_only
}

// ---------- Lock file tests ----------

fn test_pkg_lock_file_add_find() -> bool with Mut, Panic, Div {
    var lf = pkg_lock_file_new()
    lf = pkg_lock_file_add(lf, 0, 100, 1, 2, 3)
    lf = pkg_lock_file_add(lf, 1, 200, 2, 0, 0)

    let ok1 = lf.count == 2
    let ok2 = pkg_lock_file_has(lf, 0)
    let ok3 = pkg_lock_file_has(lf, 1)
    let ok4 = !pkg_lock_file_has(lf, 2)

    let idx = pkg_lock_file_find(lf, 0)
    let ok5 = idx == 0
    let ok6 = lf.entries[0].locked_major == 1
    let ok7 = lf.entries[0].locked_minor == 2
    let ok8 = lf.entries[0].locked_patch == 3
    ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8
}

fn test_pkg_lock_file_integrity() -> bool with Mut, Panic, Div {
    var lf = pkg_lock_file_new()
    lf = pkg_lock_file_add(lf, 0, 100, 1, 0, 0)
    lf = pkg_lock_file_set_integrity(lf, 0, 999999)

    let ok1 = lf.entries[0].integrity_hash == 999999
    ok1
}

fn test_pkg_lock_file_consistency_check() -> bool with Mut, Panic, Div {
    // Build a registry with A -> B ^1.0.0
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 100, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 200, 1, 2, 0)
    reg = rb.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)

    // Lock file with B locked at 1.2.0 — should be consistent
    var lf = pkg_lock_file_new()
    lf = pkg_lock_file_add(lf, 1, 200, 1, 2, 0)

    let ok1 = pkg_lock_file_check_consistency(lf, reg)

    // Lock file with B locked at 2.0.0 — NOT consistent (^1.0.0 rejects major 2)
    var lf2 = pkg_lock_file_new()
    lf2 = pkg_lock_file_add(lf2, 1, 200, 2, 0, 0)

    let ok2 = !pkg_lock_file_check_consistency(lf2, reg)

    ok1 && ok2
}

fn test_pkg_generate_lock_from_resolution() -> bool with Mut, Panic, Div {
    // Resolve A -> B, then generate lock file
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 100, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 200, 1, 5, 0)
    reg = rb.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)

    var res = pkg_resolver_new(reg)
    res = pkg_resolve(res)

    let lf = pkg_generate_lock_file(res)
    let ok1 = lf.count == 2
    let ok2 = pkg_lock_file_has(lf, 0)
    let ok3 = pkg_lock_file_has(lf, 1)
    ok1 && ok2 && ok3
}

// ---------- Dep satisfaction marking ----------

fn test_pkg_mark_dep_satisfaction() -> bool with Mut, Panic, Div {
    // A -> B ^1.0.0, both at v1.0.0 — should be satisfied
    var reg = pkg_registry_new()
    let ra = pkg_registry_add_package(reg, 100, 1, 0, 0)
    reg = ra.0
    let rb = pkg_registry_add_package(reg, 200, 1, 0, 0)
    reg = rb.0

    let cst = pkg_registry_add_constraint(reg, PKG_CONSTRAINT_COMPAT, 1, 0, 0, 0, 0, 0)
    reg = cst.0
    reg = pkg_registry_add_dep(reg, 0, 1, cst.1, false, false)

    var res = pkg_resolver_new(reg)
    res = pkg_resolve(res)
    res = pkg_mark_dep_satisfaction(res)

    // Both should have dep_satisfied = true
    let ok1 = res.solution[0].dep_satisfied
    let ok2 = res.solution[1].dep_satisfied
    ok1 && ok2
}

// ---------- Candidate collection and sorting ----------

fn test_pkg_collect_candidates_sorted() -> bool with Mut, Panic, Div {
    // Add three versions of the same package (hash 100)
    var reg = pkg_registry_new()
    let r1 = pkg_registry_add_package(reg, 100, 1, 0, 0)
    reg = r1.0
    let r2 = pkg_registry_add_package(reg, 100, 1, 2, 0)
    reg = r2.0
    let r3 = pkg_registry_add_package(reg, 100, 2, 0, 0)
    reg = r3.0

    var buf: [i64; 256] = [0; 256]
    let result = pkg_collect_candidates(reg, 0, buf)
    let count = result.0
    buf = result.1

    // Should be sorted newest-first: 2.0.0, 1.2.0, 1.0.0
    let ok1 = count == 3
    // Index 2 (v2.0.0) should be first
    let ok2 = buf[0] == 2
    // Index 1 (v1.2.0) second
    let ok3 = buf[1] == 1
    // Index 0 (v1.0.0) third
    let ok4 = buf[2] == 0
    ok1 && ok2 && ok3 && ok4
}

// ---------- Hash helpers ----------

fn test_pkg_hash_functions() -> bool {
    let h2 = pkg_hash2(10, 20)
    let h3 = pkg_hash3(10, 20, 30)
    let ok1 = h2 == 10 * 31 + 20
    let ok2 = h3 == (10 * 31 + 20) * 31 + 30
    ok1 && ok2
}

// ---------- Edge cases ----------

fn test_pkg_empty_registry_resolve() -> bool with Mut, Panic, Div {
    let reg = pkg_registry_new()
    var res = pkg_resolver_new(reg)
    res = pkg_resolve(res)
    // No packages to resolve — immediately done
    res.is_resolved && res.solution_count == 0
}

fn test_pkg_solution_find_missing() -> bool with Mut, Panic, Div {
    let reg = pkg_registry_new()
    let res = pkg_resolver_new(reg)
    let idx = pkg_resolver_find_solution(res, 42)
    idx == (0 - 1)
}

fn test_pkg_version_zero_compare() -> bool {
    let z = pkg_version_zero()
    let ok1 = pkg_version_eq(z, pkg_version_new(0, 0, 0))
    let ok2 = pkg_version_lt(z, pkg_version_new(0, 0, 1))
    ok1 && ok2
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_pkg_tests() -> i64 with Mut, Panic, Div, IO {
    var passed: i64 = 0
    var failed: i64 = 0

    // Version comparison
    if test_pkg_version_equal() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_less_major() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_less_minor() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_less_patch() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_greater() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_cmp_equal_returns_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_encode() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_le() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_ge() { passed = passed + 1 } else { failed = failed + 1 }

    // Constraint satisfaction
    if test_pkg_constraint_exact_match() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_exact_mismatch() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_compat_same_major() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_tilde_same_minor() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_range() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_range_narrow() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_constraint_invalid_kind() { passed = passed + 1 } else { failed = failed + 1 }

    // Registry
    if test_pkg_registry_add_package() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_registry_add_dep() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_registry_find_versions() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_registry_find_deps() { passed = passed + 1 } else { failed = failed + 1 }

    // Resolution
    if test_pkg_resolve_single() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_resolve_two_independent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_resolve_a_depends_on_b() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_resolve_diamond() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_resolve_picks_newest() { passed = passed + 1 } else { failed = failed + 1 }

    // Conflicts
    if test_pkg_conflict_version() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_conflict_recording() { passed = passed + 1 } else { failed = failed + 1 }

    // Cycle detection
    if test_pkg_cycle_no_cycle() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_self_loop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_two_nodes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_three_nodes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_iterative_matches_recursive() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_optional_not_counted() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_cycle_diamond_no_cycle() { passed = passed + 1 } else { failed = failed + 1 }

    // Topological sort
    if test_pkg_topo_sort_linear() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_topo_sort_diamond() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_topo_sort_cycle_detected() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_topo_sort_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_topo_sort_single() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_topo_sort_no_edges() { passed = passed + 1 } else { failed = failed + 1 }

    // Backtracking
    if test_pkg_backtrack_push_pop() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_backtrack_restore_solution() { passed = passed + 1 } else { failed = failed + 1 }

    // Optional / dev deps
    if test_pkg_optional_dep_not_required() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_dev_dep_flag() { passed = passed + 1 } else { failed = failed + 1 }

    // Lock file
    if test_pkg_lock_file_add_find() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_lock_file_integrity() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_lock_file_consistency_check() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_generate_lock_from_resolution() { passed = passed + 1 } else { failed = failed + 1 }

    // Dep satisfaction
    if test_pkg_mark_dep_satisfaction() { passed = passed + 1 } else { failed = failed + 1 }

    // Candidates
    if test_pkg_collect_candidates_sorted() { passed = passed + 1 } else { failed = failed + 1 }

    // Hash helpers
    if test_pkg_hash_functions() { passed = passed + 1 } else { failed = failed + 1 }

    // Edge cases
    if test_pkg_empty_registry_resolve() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_solution_find_missing() { passed = passed + 1 } else { failed = failed + 1 }
    if test_pkg_version_zero_compare() { passed = passed + 1 } else { failed = failed + 1 }

    print_int(passed)
    print_int(failed)
    failed
}
