// self-hosted/gpu/test_kaxi_round_mode.sio
//
// Sub-PTX step 0 gate (B1/B2 prerequisite): verify that the
// `round=rN` K-AXI attribute (where N ∈ {n,z,p,m}) lowers to the
// matching PTX rounding-mode suffix on add/sub/mul/fma .f64 ops.
//
// Backward-compat case "no_attr" verifies that lines without
// `round=` still emit the un-suffixed PTX (`add.f64`, `mul.f64`,
// etc.) — same byte output as before this step landed.

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

fn emit(name: string, asm: KaxiAsmBuf) with IO, Mut, Panic, Div, Alloc {
    print("---KERNEL ")
    println(name)
    let ptx = kaxi_transpile_to_ptx_unified(asm, 0)
    print(ptx)
    println("---KERNEL_END")
}

// Backward-compat: f64 add/sub/mul/fma WITHOUT round=. Emission
// should match pre-Step-0 byte-for-byte (PTX defaults to RN).
fn k_no_attr() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "load_imm r0, imm=0, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=10, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=20, seq=2")
    asm = kaxi_asm_push_line(asm, "add r3, r1, r2, var=+0%, seq=3, type=f64")
    asm = kaxi_asm_push_line(asm, "sub r4, r1, r2, var=+0%, seq=4, type=f64")
    asm = kaxi_asm_push_line(asm, "mul r5, r1, r2, var=+0%, seq=5, type=f64")
    asm = kaxi_asm_push_line(asm, "fma r6, r1, r2, r3, var=+0%, seq=6, type=f64")
    asm = kaxi_asm_push_line(asm, "store_global r6, addr=r0, seq=7")
    asm = kaxi_asm_push_line(asm, "ret seq=8")
    asm
}

fn k_round(round_attr: string) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "load_imm r0, imm=0, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=10, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=20, seq=2")
    asm = kaxi_asm_push_line(asm, "add r3, r1, r2, var=+0%, seq=3, type=f64, " + round_attr)
    asm = kaxi_asm_push_line(asm, "sub r4, r1, r2, var=+0%, seq=4, type=f64, " + round_attr)
    asm = kaxi_asm_push_line(asm, "mul r5, r1, r2, var=+0%, seq=5, type=f64, " + round_attr)
    asm = kaxi_asm_push_line(asm, "fma r6, r1, r2, r3, var=+0%, seq=6, type=f64, " + round_attr)
    asm = kaxi_asm_push_line(asm, "store_global r6, addr=r0, seq=7")
    asm = kaxi_asm_push_line(asm, "ret seq=8")
    asm
}

pub fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    emit("no_attr", k_no_attr())
    emit("rn", k_round("round=rn"))
    emit("rz", k_round("round=rz"))
    emit("rp", k_round("round=rp"))
    emit("rm", k_round("round=rm"))
    0
}
