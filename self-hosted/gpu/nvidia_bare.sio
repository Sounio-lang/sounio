}

fn gpu_bare_print_hex_byte(b: i64) with IO {
    let hi = (b / 16) & 15
    let lo = b & 15
    if hi < 10 { print_char(48 + hi) } else { print_char(87 + hi) }
    if lo < 10 { print_char(48 + lo) } else { print_char(87 + lo) }
}

fn gpu_bare_print_hex(buf: GpuBareBuf) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.len {
        gpu_bare_print_hex_byte(buf.data[i as usize])
        i = i + 1
    }
    print("\n")
}

fn gpu_bare_self_check() -> bool with Mut, Panic, Div {
    let c = gpu_bare_sm80_contract()
    let b = gpu_bare_emit_sm80_exit_cubin()
    let s = gpu_bare_emit_sm80_store_u32_const_cubin()
    let v = gpu_bare_emit_sm80_vec_add_f32_cubin()
    let m = gpu_bare_emit_sm80_vec_sub_f32_cubin()
    let u = gpu_bare_emit_sm80_vec_mul_f32_cubin()
    let q = gpu_bare_emit_sm80_fma_f32_cubin()
    let d = gpu_bare_emit_sm80_epistemic_dual_output_f32_cubin()
    let a = gpu_bare_emit_l4cc_alias_epistemic_dual_output_f32_cubin()
    let p = gpu_bare_emit_sm89_l4_epistemic_dual_output_f32_cubin()
    let r = gpu_bare_emit_sm89_l4_layout_epistemic_dual_output_f32_cubin()
    let f = gpu_bare_emit_sm89_l4_flags_epistemic_dual_output_f32_cubin()
    let lens_ok = b.len == 832 && s.len == 2472 && v.len == 2472 && m.len == 2472 && u.len == 2472 && q.len == 2472 && d.len == 2472 && a.len == 2472 && p.len == 2472 && r.len == 2560 && f.len == 2560
    let magic_ok = b.data[0] == 127 && b.data[1] == 69 && b.data[2] == 76 && b.data[3] == 70 && s.data[0] == 127 && s.data[1] == 69 && s.data[2] == 76 && s.data[3] == 70 && v.data[0] == 127 && v.data[1] == 69 && v.data[2] == 76 && v.data[3] == 70 && m.data[0] == 127 && m.data[1] == 69 && m.data[2] == 76 && m.data[3] == 70 && u.data[0] == 127 && u.data[1] == 69 && u.data[2] == 76 && u.data[3] == 70 && q.data[0] == 127 && q.data[1] == 69 && q.data[2] == 76 && q.data[3] == 70 && d.data[0] == 127 && d.data[1] == 69 && d.data[2] == 76 && d.data[3] == 70 && a.data[0] == 127 && a.data[1] == 69 && a.data[2] == 76 && a.data[3] == 70 && p.data[0] == 127 && p.data[1] == 69 && p.data[2] == 76 && p.data[3] == 70 && r.data[0] == 127 && r.data[1] == 69 && r.data[2] == 76 && r.data[3] == 70 && f.data[0] == 127 && f.data[1] == 69 && f.data[2] == 76 && f.data[3] == 70
    gpu_bare_contract_valid(c) && lens_ok && magic_ok
}

fn main() with IO, Mut, Panic, Div {
    gpu_bare_print_hex(gpu_bare_emit_sm80_store_u32_const_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm80_vec_add_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm80_vec_sub_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm80_vec_mul_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm80_fma_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm80_epistemic_dual_output_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm89_l4_epistemic_dual_output_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_l4cc_alias_epistemic_dual_output_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm89_l4_layout_epistemic_dual_output_f32_cubin())
    gpu_bare_print_hex(gpu_bare_emit_sm89_l4_flags_epistemic_dual_output_f32_cubin())
}
