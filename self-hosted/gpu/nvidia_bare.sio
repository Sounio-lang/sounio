fn gpu_bare_push_symbol(
    buf: GpuBareBuf,
    name: i64,
    info: i64,
    other: i64,
    shndx: i64,
    value_lo: i64,
    value_hi: i64,
    size_lo: i64,
    size_hi: i64,
) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u32_le(out, name)
    out = gpu_bare_push_u8(out, info)
    out = gpu_bare_push_u8(out, other)
    out = gpu_bare_push_u16_le(out, shndx)
    out = gpu_bare_push_u64_le(out, value_lo, value_hi)
    out = gpu_bare_push_u64_le(out, size_lo, size_hi)
    out
}

fn gpu_bare_push_program_header(
    buf: GpuBareBuf,
    typ: i64,
    flags: i64,
    off_lo: i64,
    off_hi: i64,
    vaddr_lo: i64,
    vaddr_hi: i64,
    paddr_lo: i64,
    paddr_hi: i64,
    filesz_lo: i64,
    filesz_hi: i64,
    memsz_lo: i64,
    memsz_hi: i64,
    align_lo: i64,
    align_hi: i64,
) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u32_le(out, typ)
    out = gpu_bare_push_u32_le(out, flags)
    out = gpu_bare_push_u64_le(out, off_lo, off_hi)
    out = gpu_bare_push_u64_le(out, vaddr_lo, vaddr_hi)
    out = gpu_bare_push_u64_le(out, paddr_lo, paddr_hi)
    out = gpu_bare_push_u64_le(out, filesz_lo, filesz_hi)
    out = gpu_bare_push_u64_le(out, memsz_lo, memsz_hi)
    out = gpu_bare_push_u64_le(out, align_lo, align_hi)
    out
}

