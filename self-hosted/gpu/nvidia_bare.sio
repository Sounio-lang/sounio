fn gpu_bare_push_dual_output_sm89_l4_elf_header(buf: GpuBareBuf) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u8(out, 127)
    out = gpu_bare_push_u8(out, 69)
