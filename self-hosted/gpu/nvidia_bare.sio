fn gpu_bare_push_dual_output_sm89_l4_elf_header(buf: GpuBareBuf) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u8(out, 127)
    out = gpu_bare_push_u8(out, 69)
    out = gpu_bare_push_u8(out, 76)
    out = gpu_bare_push_u8(out, 70)
    out = gpu_bare_push_u8(out, 2)
    out = gpu_bare_push_u8(out, 1)
    out = gpu_bare_push_u8(out, 1)
    out = gpu_bare_push_u8(out, 51)
    out = gpu_bare_push_u8(out, 7)
    out = gpu_bare_pad_to(out, 16)
    out = gpu_bare_push_u16_le(out, 2)
    out = gpu_bare_push_u16_le(out, 190)
    out = gpu_bare_push_u32_le(out, 120)
    out = gpu_bare_push_u64_le(out, 0, 0)
    out = gpu_bare_push_u64_le(out, 2304, 0)
    out = gpu_bare_push_u64_le(out, 1792, 0)
    // Keep SM80-compatible ELF flags while this L4 sibling isolates the new
    // kernel identity and metadata layout; true SM89 flags are a later rung.
    out = gpu_bare_push_u32_le(out, 5244240)
    out = gpu_bare_push_u16_le(out, 64)
    out = gpu_bare_push_u16_le(out, 56)
    out = gpu_bare_push_u16_le(out, 3)
    out = gpu_bare_push_u16_le(out, 64)
    out = gpu_bare_push_u16_le(out, 8)
    out = gpu_bare_push_u16_le(out, 1)
    out
}

