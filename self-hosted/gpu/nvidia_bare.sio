fn gpu_bare_print_hex_byte(b: i64) with IO {
    let hi = (b / 16) & 15
    let lo = b & 15
    if hi < 10 { print_char(48 + hi) } else { print_char(87 + hi) }
    if lo < 10 { print_char(48 + lo) } else { print_char(87 + lo) }
}

fn gpu_bare_print_hex(buf: GpuBareBuf) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.len {
        gpu_bare_print_hex_byte(buf.data[i as usize])
        i = i + 1
    }
    print("\n")
}

fn gpu_bare_self_check() -> bool with Mut, Panic, Div {
    let c = gpu_bare_sm80_contract()
    let b = gpu_bare_emit_sm80_exit_cubin()
    let s = gpu_bare_emit_sm80_store_u32_const_cubin()
    let v = gpu_bare_emit_sm80_vec_add_f32_cubin()
    gpu_bare_contract_valid(c) && b.len == 832 && s.len == 2472 && v.len == 2472 && b.data[0] == 127 && b.data[1] == 69 && b.data[2] == 76 && b.data[3] == 70 && s.data[0] == 127 && s.data[1] == 69 && s.data[2] == 76 && s.data[3] == 70 && v.data[0] == 127 && v.data[1] == 69 && v.data[2] == 76 && v.data[3] == 70
}

fn main() with IO, Mut, Panic, Div {
    let s = gpu_bare_emit_sm80_store_u32_const_cubin()
    let v = gpu_bare_emit_sm80_vec_add_f32_cubin()
    gpu_bare_print_hex(s)
    gpu_bare_print_hex(v)
}
