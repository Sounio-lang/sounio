// self-hosted::gpu::nvidia_bare -- Sounio-owned NVIDIA CUDA ELF/CUBIN surface
//
// This module is intentionally separate from the PTX and Apple Metal lanes.
// It emits bytes for a structural SM80 CUDA-ELF specimen directly from Sounio
// constants and byte-writing helpers. The local proof mode is structural by
// default; NVIDIA hosts can also run CUDA Driver API admission and launch rungs.

enum GpuBareTarget {
    NvidiaSm80,
    NvidiaSm89L4,
}

enum GpuBareFormat {
    CubinElf64,
}

enum GpuBareKernelKind {
    ExitOnly,
    StoreU32Const,
    VecAddF32,
    VecAddF64,
    VecSubF64,
    VecMulF64,
    VecDivF64,
    VecSubF32,
    VecMulF32,
    FmaF32,
    FmaF64,
    EpistemicDualOutputF32,
    EpistemicDualOutputF32L4CcAlias,
    EpistemicDualOutputF32Sm89L4,
    EpistemicDualOutputF32Sm89L4Layout,
    EpistemicDualOutputF32Sm89L4Flags,
}

enum GpuBareProofMode {
    Structural,
    Runtime,
}

struct GpuBareMachineContract {
    value_lane: bool,
    uncertainty_lane: bool,
    algebra_law_profile: i64,
    precision_policy: i64,
    target_isa_policy: i64,
    no_reassociate: bool,
}

struct GpuBareBuf {
    data: [i64; 2560],
    len: i64,
}

fn gpu_bare_buf_new() -> GpuBareBuf {
    GpuBareBuf { data: [0; 2560], len: 0 }
}

fn gpu_bare_push_u8(buf: GpuBareBuf, b: i64) -> GpuBareBuf with Mut, Panic {
    var out = buf
    if out.len < 2560 {
        out.data[out.len as usize] = b & 255
        out.len = out.len + 1
    }
    out
}

fn gpu_bare_pad_to(buf: GpuBareBuf, size: i64) -> GpuBareBuf with Mut, Panic {
    var out = buf
    while out.len < size {
        out = gpu_bare_push_u8(out, 0)
    }
    out
}

fn gpu_bare_push_u16_le(buf: GpuBareBuf, v: i64) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u8(out, v)
    out = gpu_bare_push_u8(out, v / 256)
    out
}

fn gpu_bare_push_u32_le(buf: GpuBareBuf, v: i64) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u8(out, v)
    out = gpu_bare_push_u8(out, v / 256)
    out = gpu_bare_push_u8(out, v / 65536)
    out = gpu_bare_push_u8(out, v / 16777216)
    out
}

fn gpu_bare_push_u64_le(buf: GpuBareBuf, lo: i64, hi: i64) -> GpuBareBuf with Mut, Panic {
    var out = buf
    out = gpu_bare_push_u32_le(out, lo)
    out = gpu_bare_push_u32_le(out, hi)
    out
}

fn gpu_bare_push_ascii(buf: GpuBareBuf, s: string) -> GpuBareBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = gpu_bare_push_u8(out, str_char_at(s, i))
        i = i + 1
    }
    out
}

fn gpu_bare_push_shstrtab(buf: GpuBareBuf) -> GpuBareBuf with Mut, Panic, Div {
    var out = buf
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".shstrtab")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".nv.info")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".nv.info.sounio_bare_exit_sm80")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".text.sounio_bare_exit_sm80")
    out = gpu_bare_push_u8(out, 0)
    out
}

fn gpu_bare_push_store_shstrtab(buf: GpuBareBuf) -> GpuBareBuf with Mut, Panic, Div {
    var out = buf
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".shstrtab")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".strtab")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".symtab")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".nv.info")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".nv.info.sounio_bare_store_u32_const_sm80")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".nv.constant0.sounio_bare_store_u32_const_sm80")
    out = gpu_bare_push_u8(out, 0)
    out = gpu_bare_push_ascii(out, ".text.sounio_bare_store_u32_const_sm80")
    out = gpu_bare_push_u8(out, 0)
    out
}

