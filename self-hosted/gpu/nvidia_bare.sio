fn gpu_bare_emit_sm80_vec_mul_f32_cubin() -> GpuBareBuf with Mut, Panic, Div {
    var out = gpu_bare_emit_sm80_fma_f32_cubin()
    // Same-length specialization of the affine FMA CUBIN string tables:
    // replace "fma" with "mul" while leaving offsets and section sizes stable.
    out.data[125] = 109
    out.data[126] = 117
    out.data[127] = 108
    out.data[168] = 109
