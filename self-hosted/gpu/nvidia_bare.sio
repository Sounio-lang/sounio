fn gpu_bare_emit_sm80_epistemic_dual_output_f32_cubin() -> GpuBareBuf with Mut, Panic, Div {
    var out = gpu_bare_buf_new()

    out = gpu_bare_push_dual_output_elf_header(out)

    out = gpu_bare_push_dual_output_shstrtab(out)

    out = gpu_bare_pad_to(out, 258)
    out = gpu_bare_push_dual_output_strtab(out)

    out = gpu_bare_pad_to(out, 504)
    out = gpu_bare_push_dual_output_symbols(out)

    out = gpu_bare_pad_to(out, 624)
    out = gpu_bare_push_dual_output_global_info(out)

    out = gpu_bare_pad_to(out, 672)
    out = gpu_bare_push_dual_output_kernel_info(out)

    out = gpu_bare_pad_to(out, 848)
    out = gpu_bare_pad_to(out, 1264)

    out = gpu_bare_pad_to(out, 1280)
    out = gpu_bare_push_sm80_epistemic_dual_output_f32_body(out)

    out = gpu_bare_pad_to(out, 1792)
    out = gpu_bare_push_dual_output_section_headers(out)

    out = gpu_bare_pad_to(out, 2304)
    out = gpu_bare_push_dual_output_program_headers(out)

    out
}

