// self-hosted/gpu/test_metal_emitters.sio
// Metal MSL emitter gate test — validates hardcoded emitters and self-check.
// Does NOT require GPU hardware or macOS — validates code generation only.

use metal::*

// ============================================================================
// Test 1: vec_add emitter produces MSL with kernel void vec_add
// ============================================================================

fn test_metal_vec_add_has_kernel() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "kernel void vec_add")
}

// ============================================================================
// Test 2: vec_add emitter includes metal_stdlib
// ============================================================================

fn test_metal_vec_add_has_include() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "#include <metal_stdlib>")
}

// ============================================================================
// Test 3: vec_add emitter uses namespace metal
// ============================================================================

fn test_metal_vec_add_has_namespace() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "using namespace metal")
}

// ============================================================================
// Test 4: vec_add emitter has buffer attributes
// ============================================================================

fn test_metal_vec_add_has_buffers() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "[[buffer(0)]]") &&
    metal_buf_contains(buf, "[[buffer(1)]]") &&
    metal_buf_contains(buf, "[[buffer(2)]]")
}

// ============================================================================
// Test 5: vec_add emitter has thread_position_in_grid
// ============================================================================

fn test_metal_vec_add_has_tid() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "[[thread_position_in_grid]]")
}

// ============================================================================
// Test 6: vec_add emitter performs addition
// ============================================================================

fn test_metal_vec_add_has_addition() -> bool with Mut, Panic, Div {
    let buf = metal_emit_vec_add_f32()
    metal_buf_contains(buf, "a[tid] + b_in[tid]")
}

// ============================================================================
// Test 7: ossm_oct_step emitter produces kernel signature
// ============================================================================

fn test_metal_ossm_has_kernel() -> bool with Mut, Panic, Div {
    let buf = metal_emit_ossm_oct_step_f64_checked()
    metal_buf_contains(buf, "kernel void ossm_oct_step_f64_checked")
}

// ============================================================================
// Test 8: ossm_oct_step emitter has epistemic shadow annotation
// ============================================================================

fn test_metal_ossm_has_shadow() -> bool with Mut, Panic, Div {
    let buf = metal_emit_ossm_oct_step_f64_checked()
    metal_buf_contains(buf, "epistemic_shadow")
}

// ============================================================================
// Test 9: sedenion_cd_step emitter produces kernel signature
// ============================================================================

fn test_metal_sedenion_has_kernel() -> bool with Mut, Panic, Div {
    let buf = metal_emit_sedenion_cd_step_f64_checked()
    metal_buf_contains(buf, "kernel void sedenion_cd_step_f64_checked")
}

// ============================================================================
// Test 10: sedenion_cd_step emitter has cayley_dickson annotation
// ============================================================================

fn test_metal_sedenion_has_cd() -> bool with Mut, Panic, Div {
    let buf = metal_emit_sedenion_cd_step_f64_checked()
    metal_buf_contains(buf, "cayley_dickson")
}

// ============================================================================
// Entry point
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    if !test_metal_vec_add_has_kernel()      { println("FAIL test_metal_vec_add_has_kernel");      return 1 }
    if !test_metal_vec_add_has_include()     { println("FAIL test_metal_vec_add_has_include");     return 2 }
    if !test_metal_vec_add_has_namespace()   { println("FAIL test_metal_vec_add_has_namespace");   return 3 }
    if !test_metal_vec_add_has_buffers()     { println("FAIL test_metal_vec_add_has_buffers");     return 4 }
    if !test_metal_vec_add_has_tid()         { println("FAIL test_metal_vec_add_has_tid");         return 5 }
    if !test_metal_vec_add_has_addition()    { println("FAIL test_metal_vec_add_has_addition");    return 6 }
    if !test_metal_ossm_has_kernel()         { println("FAIL test_metal_ossm_has_kernel");         return 7 }
    if !test_metal_ossm_has_shadow()         { println("FAIL test_metal_ossm_has_shadow");         return 8 }
    if !test_metal_sedenion_has_kernel()     { println("FAIL test_metal_sedenion_has_kernel");     return 9 }
    if !test_metal_sedenion_has_cd()         { println("FAIL test_metal_sedenion_has_cd");         return 10 }

    println("PASS 10/10 Metal emitter gate tests")
    0
}
