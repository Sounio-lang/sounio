// self-hosted/gpu/kretikos_emulate.sio
// Kretikos CPU emulation driver — runs internal self-check.
//
// Usage: souc kretikos_emulate.sio /tmp/driver.elf
//        /tmp/driver.elf

use runtime::cpu_interpreter::*

fn main() -> i32 with IO, Mut, Panic {
    let ok = cpu_interpreter_self_check()
    if ok {
        println("PASS cpu_interpreter_self_check")
        0
    } else {
        println("FAIL cpu_interpreter_self_check")
        1
    }
}
