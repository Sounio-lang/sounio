// self-hosted/gpu/kretikos_emit_ptx.sio
// Kretikos PTX emission driver - produces predefined PTX text from in-tree emitters.
//
// Usage: souc kretikos_emit_ptx.sio /tmp/kretikos_emit_ptx.elf
//        /tmp/kretikos_emit_ptx.elf <pattern>
//
// Supported patterns:
//   vec_add       - f32 vector addition (SM50 target)
//   vec_sub       - f32 vector subtraction
//   vec_mul       - f32 vector multiplication
//   vec_div       - f32 vector division
//   vec_add_f64   - f64 vector addition
//   vec_sub_f64   - f64 vector subtraction
//   vec_mul_f64   - f64 vector multiplication
//   vec_div_f64   - f64 vector division
//   fma           - f32 fused multiply-add (a*b+c)
//   fma_f64       - f64 fused multiply-add (a*b+c)
//   store_u32_const - store constant u32 per thread
//   epistemic_dual_output_f32 - value, uncertainty, and validity lanes

use ptx::*

fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_ptx: error - expected <pattern>")
        println("")
        println("Supported patterns:")
        println("  vec_add         - f32 vector addition (SM50 target)")
        println("  vec_sub         - f32 vector subtraction")
        println("  vec_mul         - f32 vector multiplication")
        println("  vec_div         - f32 vector division")
        println("  vec_add_f64     - f64 vector addition")
        println("  vec_sub_f64     - f64 vector subtraction")
        println("  vec_mul_f64     - f64 vector multiplication")
        println("  vec_div_f64     - f64 vector division")
        println("  fma             - f32 fused multiply-add (a*b+c)")
        println("  fma_f64         - f64 fused multiply-add (a*b+c)")
        println("  store_u32_const - store constant u32 per thread")
        println("  epistemic_dual_output_f32 - value, uncertainty, and validity lanes")
        return 1
    }

    let pattern = get_arg(0)

    var buf: PtxBuf
    if str_eq(pattern, "vec_add") {
        buf = ptx_emit_demo_vec_add()
    } else if str_eq(pattern, "vec_sub") {
        buf = ptx_emit_vec_sub_f32()
    } else if str_eq(pattern, "vec_mul") {
        buf = ptx_emit_vec_mul_f32()
    } else if str_eq(pattern, "vec_div") {
        buf = ptx_emit_vec_div_f32()
    } else if str_eq(pattern, "vec_add_f64") {
        buf = ptx_emit_vec_add_f64()
    } else if str_eq(pattern, "vec_sub_f64") {
        buf = ptx_emit_vec_sub_f64()
    } else if str_eq(pattern, "vec_mul_f64") {
        buf = ptx_emit_vec_mul_f64()
    } else if str_eq(pattern, "vec_div_f64") {
        buf = ptx_emit_vec_div_f64()
    } else if str_eq(pattern, "fma") {
        buf = ptx_emit_fma_f32()
    } else if str_eq(pattern, "fma_f64") {
        buf = ptx_emit_fma_f64()
    } else if str_eq(pattern, "store_u32_const") {
        buf = ptx_emit_store_u32_const()
    } else if str_eq(pattern, "epistemic_dual_output_f32") {
        buf = ptx_emit_epistemic_dual_output_f32()
    } else {
        print("kretikos_emit_ptx: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    ptx_buf_print(buf)
    0
}
