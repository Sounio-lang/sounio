// self-hosted/gpu/kretikos_kaxi_compile.sio
// Source-driven K-AXI → PTX compilation: read a `.kaxi` text file and lower
// it through any of the five available transpiler modes. The first step
// toward user-authored kernels — no pattern dispatch, just K-AXI text.
//
// Usage: souc kretikos_kaxi_compile.sio /tmp/driver.elf
//        /tmp/driver.elf <input.kaxi> [mode]
//
// Modes (PtxMode tag passed to kaxi_transpile_to_ptx_unified):
//   basic       — mode 0 (u64 default)
//   epistemic   — mode 1 (u64 + variance shadow)
//   f32         — mode 2 (IEEE 754)
//   f32-2c      — mode 3 (dual buffer)
//   f32e        — mode 4 (f32 + variance)

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("usage: kretikos_kaxi_compile <input.kaxi> [mode]")
        println("modes: basic | epistemic | f32 | f32e | f32-2c")
        return 1
    }
    let path = get_arg(0)
    var mode: string = "basic"
    if argc >= 2 {
        mode = get_arg(1)
    }

    let size = file_size(path)
    if size <= 0 {
        print("error: cannot read or empty file: ")
        println(path)
        return 1
    }

    let bytes = read_file(path)

    var buf: KaxiAsmBuf = kaxi_asm_new()
    var i: i64 = 0
    let cap = if size > 16384 { 16384 } else { size }
    while i < cap {
        buf = kaxi_asm_push_byte(buf, bytes[i as usize] as i8)
        i = i + 1
    }

    let mode_id: i64 = if str_eq(mode, "epistemic") {
        1
    } else if str_eq(mode, "f32") {
        2
    } else if str_eq(mode, "f32-2c") {
        3
    } else if str_eq(mode, "f32e") {
        4
    } else {
        0
    }
    let ptx = kaxi_transpile_to_ptx_unified(buf, mode_id)
    print(ptx)
    0
}
