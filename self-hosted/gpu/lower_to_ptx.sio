fn gpu_reg_i32(reg: i64) -> string {
    // i32 uses same register names as u32 (%r0-r9)
    // Signedness is in instruction opcode (.s32 vs .u32), not register name
    if reg == 0 { "%r0" }
    else if reg == 1 { "%r1" }
    else if reg == 2 { "%r2" }
    else if reg == 3 { "%r3" }
    else if reg == 4 { "%r4" }
    else if reg == 5 { "%r5" }
    else if reg == 6 { "%r6" }
    else if reg == 7 { "%r7" }
    else if reg == 8 { "%r8" }
    else if reg == 9 { "%r9" }
    else if reg == 10 { "%r10" }
    else if reg == 11 { "%r11" }
    else if reg == 12 { "%r12" }
    else { "%r0" }
}

fn gpu_reg_i64(reg: i64) -> string {
    // i64 uses same register names as u64 (%rd0-rd9)
    // Signedness is in instruction opcode (.s64 vs .u64), not register name
    if reg == 0 { "%rd0" }
    else if reg == 1 { "%rd1" }
    else if reg == 2 { "%rd2" }
    else if reg == 3 { "%rd3" }
    else if reg == 4 { "%rd4" }
    else if reg == 5 { "%rd5" }
    else if reg == 6 { "%rd6" }
    else if reg == 7 { "%rd7" }
    else if reg == 8 { "%rd8" }
    else if reg == 9 { "%rd9" }
    else if reg == 10 { "%rd10" }
    else if reg == 11 { "%rd11" }
    else if reg == 12 { "%rd12" }
    else if reg == 13 { "%rd13" }
    else if reg == 14 { "%rd14" }
    else if reg == 15 { "%rd15" }
    else if reg == 16 { "%rd16" }
    else if reg == 17 { "%rd17" }
    else if reg == 18 { "%rd18" }
    else if reg == 19 { "%rd19" }
    else if reg == 20 { "%rd20" }
    else { "%rd0" }
}

// Helper: Convert Name to string
fn name_to_string(name: Name) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(name.buf, name.len)
}

fn gpu_pred_reg(reg: i64) -> string {
    if reg == 0 { "%p0" }
    else if reg == 1 { "%p1" }
    else if reg == 2 { "%p2" }
    else if reg == 3 { "%p3" }
    else if reg == 4 { "%p4" }
    else if reg == 5 { "%p5" }
    else if reg == 6 { "%p6" }
    else if reg == 7 { "%p7" }
    else if reg == 8 { "%p8" }
    else if reg == 9 { "%p9" }
    else if reg == 10 { "%p10" }
    else if reg == 11 { "%p11" }
    else if reg == 12 { "%p12" }
    else if reg == 13 { "%p13" }
    else if reg == 14 { "%p14" }
    else if reg == 15 { "%p15" }
    else { "%p0" }
}

fn gpu_shared_addr_str(offset: i64) -> string with Mut, Panic, Div, Alloc {
    if offset <= 0 { "shared_array" } else {
        var b = ptx_buf_new()
        b = ptx_push_str(b, "shared_array+")
        b = ptx_push_str(b, i64_to_string(offset))
        ptx_to_string(b)
    }
}

// Helper: Convert i64 to string
fn i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n < 0 {
        return "0"
    }
    if n == 0 { return "0" }

    var digits: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var bytes: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        bytes[i as usize] = digits[(rev_len - i - 1) as usize]
        i = i + 1
    }

    str_from_bytes(bytes, rev_len)
}

// Helper: Push Name bytes to buffer
fn gpu_push_name(buf: PtxBuf, name: Name) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    var i: i64 = 0
    while i < name.len {
        out = ptx_push_byte(out, name.buf[i as usize])
        i = i + 1
    }
    out
}

// Helper: Push i64 as ASCII digits
fn gpu_push_i64(buf: PtxBuf, n: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    ptx_push_str(buf, i64_to_string(n))
}
