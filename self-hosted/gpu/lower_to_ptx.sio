// self-hosted::gpu::lower_to_ptx — GPU Kernel IR → PTX Lowering
//
// Converts GpuKernelIr to PTX text using the ptx.sio emitter functions.
// This is "phase 1" of GPU codegen: structured IR-driven lowering.

// Lower a complete GPU kernel IR to PTX
fn gpu_lower_to_ptx(kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div, Alloc {
    var buf = ptx_buf_new()

    // 1. Emit header (.version, .target, .address_size)
    buf = ptx_emit_header(buf)
    buf = gpu_emit_kernel_mode_metadata(buf, kernel)

    // 2. Emit kernel signature
    buf = gpu_emit_kernel_signature(buf, kernel)

    // 3. Emit register declarations
    buf = gpu_emit_reg_decls(buf, kernel)

    // 4. Lower each operation
    buf = gpu_lower_ops(buf, kernel)

    // 5. Close kernel body
    buf = ptx_push_str(buf, "}\n")

    buf
}

fn gpu_emit_kernel_mode_metadata(buf: PtxBuf, kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let target_profile = gpu_target_profile_cuda_sm80()
    let legalized = gpu_legalize_kernel_to_ssa_v2(kernel, target_profile)
    out = ptx_push_str(out, "// kernel_variant: strict\n")
    out = ptx_push_str(out, "// math_mode: fp32\n")
    out = ptx_push_str(out, "// pipeline_mode: single_stage\n")
    out = ptx_push_str(out, "// target_vendor: ")
    out = ptx_push_str(out, gpu_target_vendor_to_string(target_profile.vendor))
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// target_arch: ")
    out = gpu_push_name(out, target_profile.arch)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// target_warp_width: ")
    out = gpu_push_i64(out, target_profile.warp_width)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// target_wave_width: ")
    out = gpu_push_i64(out, target_profile.wave_width)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// pipeline_id: ")
    out = gpu_push_name(out, legalized.pipeline_id)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// provenance_tag: ")
    out = gpu_push_name(out, legalized.provenance_tag)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// workload_tag: ")
    out = ptx_push_str(out, gpu_workload_tag_to_string(legalized.workload_tag))
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// provenance_lane: ")
    out = ptx_push_str(out, gpu_workload_tag_to_string(legalized.workload_tag))
    out = ptx_push_str(out, "|")
    out = ptx_push_str(out, gpu_target_vendor_to_string(target_profile.vendor))
    out = ptx_push_str(out, "|")
    out = gpu_push_name(out, target_profile.arch)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// legalization_error_count: ")
    out = gpu_push_i64(out, legalized.diagnostic_count)
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "// legalization_ok: ")
    if gpu_ssa_v2_is_legal(legalized) {
        out = ptx_push_str(out, "true\n")
    } else {
        out = ptx_push_str(out, "false\n")
    }
    out
}

// Emit kernel signature: .visible .entry kernel_name(params...)
fn gpu_emit_kernel_signature(buf: PtxBuf, kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div {
    var out = buf

    // .visible .entry kernel_name(
    out = ptx_push_str(out, ".visible .entry ")
    out = gpu_push_name(out, kernel.kernel_name)
    out = ptx_push_str(out, "(\n")

    // Emit each parameter
    var i: i64 = 0
    while i < kernel.param_count {
        let param = kernel.params[i as usize]

        out = ptx_push_str(out, "    .param .")
        out = ptx_push_str(out, gpu_type_to_string(param.ty))
        out = ptx_push_str(out, " ")
        out = gpu_push_name(out, param.name)

        if i < (kernel.param_count - 1) {
            out = ptx_push_str(out, ",\n")
        } else {
            out = ptx_push_str(out, "\n")
        }

        i = i + 1
    }

    out = ptx_push_str(out, ")\n")
    out
}

// Emit register declarations based on kernel.max_reg_*
fn gpu_emit_reg_decls(buf: PtxBuf, kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf

    out = ptx_push_str(out, "{\n")

    // .reg .pred %p<N>
    if kernel.max_reg_pred > 0 {
        out = ptx_push_str(out, "    .reg .pred %p<")
        out = gpu_push_i64(out, kernel.max_reg_pred)
        out = ptx_push_str(out, ">;\n")
    }

    // .reg .b32 %r<N> — covers both u32 and i32 (signedness is in opcode, not register)
    let b32_count = if kernel.max_reg_u32 > kernel.max_reg_i32 { kernel.max_reg_u32 } else { kernel.max_reg_i32 }
    if b32_count > 0 {
        out = ptx_push_str(out, "    .reg .b32 %r<")
        out = gpu_push_i64(out, b32_count)
        out = ptx_push_str(out, ">;\n")
    }

    // .reg .b64 %rd<N> — covers both u64 and i64
    let b64_count = if kernel.max_reg_u64 > kernel.max_reg_i64 { kernel.max_reg_u64 } else { kernel.max_reg_i64 }
    if b64_count > 0 {
        out = ptx_push_str(out, "    .reg .b64 %rd<")
        out = gpu_push_i64(out, b64_count)
        out = ptx_push_str(out, ">;\n")
    }

    if kernel.shared_bytes > 0 {
        out = ptx_emit_shared_decl(out, kernel.shared_bytes)
    }

    // .reg .f32 %f<N>
    if kernel.max_reg_f32 > 0 {
        out = ptx_push_str(out, "    .reg .f32 %f<")
        out = gpu_push_i64(out, kernel.max_reg_f32)
        out = ptx_push_str(out, ">;\n")
    }

    // .reg .f64 %fd<N>
    if kernel.max_reg_f64 > 0 {
        out = ptx_push_str(out, "    .reg .f64 %fd<")
        out = gpu_push_i64(out, kernel.max_reg_f64)
        out = ptx_push_str(out, ">;\n")
    }

    out = ptx_push_str(out, "\n")
    out
}

// Lower all operations in sequence
fn gpu_lower_ops(buf: PtxBuf, kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    var i: i64 = 0

    while i < kernel.op_count {
        let op = kernel.ops[i as usize]
        out = gpu_lower_op(out, op, kernel)
        i = i + 1
    }

    out
}

// Lower a single GPU operation to PTX
fn gpu_lower_op(buf: PtxBuf, op: GpuOp, kernel: GpuKernelIr) -> PtxBuf with Mut, Panic, Div, Alloc {
    // Struct-first representation avoids enum field destructuring in the
    // self-hosted IR; switch on opcode and use struct fields explicitly.
    let opcode = op.opcode
    match opcode {
        GpuOpcode::GpuGetTid => {
            // mov.u32 %rN, %tid.x
            let tid_special = if op.axis == 0 { "%tid.x" }
                             else if op.axis == 1 { "%tid.y" }
                             else { "%tid.z" }
            ptx_push_binary2(buf, ptx_opcode_mov_u32(), gpu_reg_u32(op.dst_reg), tid_special)
        }

        GpuOpcode::GpuCvt => {
            // cvt.dst_ty.src_ty %rdN, %rM — built dynamically from op.dst_ty / op.src_ty
            let opcode = str_concat(str_concat("cvt.", gpu_type_to_string(op.dst_ty)), str_concat(".", gpu_type_to_string(op.src_ty)))
            let dst_str = gpu_reg_u64(op.dst_reg)
            let src_str = gpu_reg_u32(op.src_reg)

            ptx_push_binary2(buf, opcode, dst_str, src_str)
        }

        GpuOpcode::GpuMulImm => {
            // mul.lo.u64 %rdN, %rdM, imm
            let dst_str = if op.ty == GpuType::GpuU64 { gpu_reg_u64(op.dst_reg) } else { gpu_reg_u32(op.dst_reg) }
            let lhs_str = if op.ty == GpuType::GpuU64 { gpu_reg_u64(op.lhs_reg) } else { gpu_reg_u32(op.lhs_reg) }
            let imm_str = i64_to_string(op.rhs_imm)

            ptx_push_binary3(buf, ptx_opcode_mul_lo_u64(), dst_str, lhs_str, imm_str)
        }

        GpuOpcode::GpuAdd => {
            // add.ty %dstN, %lhsM, %rhsK
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_add_u32(),
                GpuType::GpuU64 => ptx_opcode_add_u64(),
                GpuType::GpuF32 => ptx_opcode_add_f32(),
                GpuType::GpuF64 => ptx_opcode_add_f64(),
                GpuType::GpuI32 => ptx_opcode_add_s32(),
                GpuType::GpuI64 => ptx_opcode_add_s64(),
                _ => ptx_opcode_add_u64(),
            }
            let dst_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_u64(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                _ => gpu_reg_u64(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                _ => gpu_reg_u64(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuSub => {
            // sub.ty %dstN, %lhsM, %rhsK
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_sub_f32(),
                GpuType::GpuF64 => ptx_opcode_sub_f64(),
                GpuType::GpuI32 => ptx_opcode_sub_s32(),
                GpuType::GpuI64 => ptx_opcode_sub_s64(),
                GpuType::GpuU64 => ptx_opcode_sub_u64(),
                _ => ptx_opcode_sub_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuMul => {
            // mul.lo.ty %dstN, %lhsM, %rhsK (or mul.rn for float)
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_mul_lo_u32(),
                GpuType::GpuU64 => ptx_opcode_mul_lo_u64(),
                GpuType::GpuF32 => ptx_opcode_mul_lo_f32(),
                GpuType::GpuF64 => ptx_opcode_mul_lo_f64(),
                GpuType::GpuI32 => ptx_opcode_mul_lo_s32(),
                GpuType::GpuI64 => ptx_opcode_mul_lo_s64(),
                _ => ptx_opcode_mul_lo_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuDiv => {
            // div.rn.ty %dstN, %lhsM, %rhsK
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_div_f32(),
                GpuType::GpuF64 => ptx_opcode_div_f64(),
                GpuType::GpuI32 => ptx_opcode_div_s32(),
                GpuType::GpuI64 => ptx_opcode_div_s64(),
                GpuType::GpuU64 => ptx_opcode_div_u64(),
                _ => ptx_opcode_div_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuMax => {
            // max.ty %dstN, %lhsM, %rhsK
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_max_f32(),
                GpuType::GpuF64 => ptx_opcode_max_f64(),
                GpuType::GpuI32 => ptx_opcode_max_s32(),
                GpuType::GpuI64 => ptx_opcode_max_s64(),
                GpuType::GpuU32 => ptx_opcode_max_u32(),
                GpuType::GpuU64 => ptx_opcode_max_u64(),
                _ => ptx_opcode_max_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuMin => {
            // min.ty %dstN, %lhsM, %rhsK
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_min_f32(),
                GpuType::GpuF64 => ptx_opcode_min_f64(),
                GpuType::GpuI32 => ptx_opcode_min_s32(),
                GpuType::GpuI64 => ptx_opcode_min_s64(),
                GpuType::GpuU32 => ptx_opcode_min_u32(),
                GpuType::GpuU64 => ptx_opcode_min_u64(),
                _ => ptx_opcode_min_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }

            ptx_push_binary3(buf, opcode, dst_str, lhs_str, rhs_str)
        }

        GpuOpcode::GpuBarrierSync => {
            // bar.sync 0
            ptx_push_barrier_sync(buf)
        }

        GpuOpcode::GpuShflDown => {
            // Negative rhs_imm => shfl.sync.up (for scan); positive => shfl.sync.down (for reduction)
            let is_up = op.rhs_imm < 0
            let actual_offset = if is_up { 0 - op.rhs_imm } else { op.rhs_imm }
            let opcode = if is_up {
                match op.ty {
                    GpuType::GpuF64 => ptx_opcode_shfl_up_b64(),
                    GpuType::GpuI64 => ptx_opcode_shfl_up_b64(),
                    GpuType::GpuU64 => ptx_opcode_shfl_up_b64(),
                    _ => ptx_opcode_shfl_up_b32(),
                }
            } else {
                match op.ty {
                    GpuType::GpuF64 => ptx_opcode_shfl_down_b64(),
                    GpuType::GpuI64 => ptx_opcode_shfl_down_b64(),
                    GpuType::GpuU64 => ptx_opcode_shfl_down_b64(),
                    _ => ptx_opcode_shfl_down_b32(),
                }
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let src_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_shfl_down(buf, opcode, dst_str, src_str, i64_to_string(actual_offset))
        }

        GpuOpcode::GpuSetpLt => {
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_setp_lt_u32(),
                GpuType::GpuU64 => ptx_opcode_setp_lt_u64(),
                GpuType::GpuF32 => ptx_opcode_setp_lt_f32(),
                GpuType::GpuI32 => ptx_opcode_setp_lt_s32(),
                _ => ptx_opcode_setp_lt_u32(),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                _ => gpu_reg_u32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                _ => gpu_reg_u32(op.rhs_reg),
            }
            ptx_push_setp2(buf, opcode, gpu_pred_reg(op.dst_reg), lhs_str, rhs_str)
        }

        GpuOpcode::GpuSetpLe => {
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_setp_le_u32(),
                GpuType::GpuU64 => ptx_opcode_setp_le_u64(),
                GpuType::GpuF32 => ptx_opcode_setp_le_f32(),
                GpuType::GpuI32 => ptx_opcode_setp_le_s32(),
                _ => ptx_opcode_setp_le_u32(),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                _ => gpu_reg_u32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                _ => gpu_reg_u32(op.rhs_reg),
            }
            ptx_push_setp2(buf, opcode, gpu_pred_reg(op.dst_reg), lhs_str, rhs_str)
        }

        GpuOpcode::GpuSetpGe => {
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_setp_ge_u32(),
                GpuType::GpuU64 => ptx_opcode_setp_ge_u64(),
                GpuType::GpuF32 => ptx_opcode_setp_ge_f32(),
                GpuType::GpuF64 => ptx_opcode_setp_ge_f64(),
                GpuType::GpuI32 => ptx_opcode_setp_ge_s32(),
                GpuType::GpuI64 => ptx_opcode_setp_ge_s64(),
                _ => ptx_opcode_setp_ge_u32(),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                _ => gpu_reg_u32(op.lhs_reg),
            }
            // If rhs_reg is -1, use immediate value instead of register
            let rhs_str = if op.rhs_reg < 0 {
                i64_to_string(op.rhs_imm)
            } else {
                match op.ty {
                    GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                    GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                    GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                    GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                    GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                    GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                    _ => gpu_reg_u32(op.rhs_reg),
                }
            }
            ptx_push_setp2(buf, opcode, gpu_pred_reg(op.dst_reg), lhs_str, rhs_str)
        }

        GpuOpcode::GpuSetpEq => {
            let opcode = match op.ty {
                GpuType::GpuU32 => ptx_opcode_setp_eq_u32(),
                GpuType::GpuU64 => ptx_opcode_setp_eq_u64(),
                GpuType::GpuF32 => ptx_opcode_setp_eq_f32(),
                GpuType::GpuI32 => ptx_opcode_setp_eq_s32(),
                _ => ptx_opcode_setp_eq_u32(),
            }
            let lhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                _ => gpu_reg_u32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                _ => gpu_reg_u32(op.rhs_reg),
            }
            ptx_push_setp2(buf, opcode, gpu_pred_reg(op.dst_reg), lhs_str, rhs_str)
        }

        GpuOpcode::GpuSelp => {
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_selp_f32(),
                GpuType::GpuI32 => ptx_opcode_selp_s32(),
                GpuType::GpuI64 => ptx_opcode_selp_b64(),
                GpuType::GpuU64 => ptx_opcode_selp_b64(),
                GpuType::GpuF64 => ptx_opcode_selp_f64(),
                _ => ptx_opcode_selp_b32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.lhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.rhs_reg),
                GpuType::GpuU64 => gpu_reg_u64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }
            ptx_push_selp(buf, opcode, dst_str, lhs_str, rhs_str, gpu_pred_reg(op.src_reg))
        }

        GpuOpcode::GpuAtomicAdd => {
            // atom.add.ty %dst, [%addr], %val
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_atom_add_f32(),
                GpuType::GpuF64 => ptx_opcode_atom_add_f64(),
                GpuType::GpuI32 => ptx_opcode_atom_add_s32(),
                GpuType::GpuU32 => ptx_opcode_atom_add_u32(),
                _ => ptx_opcode_atom_add_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let val_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                GpuType::GpuU32 => gpu_reg_u32(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_atomic_add(buf, opcode, dst_str, gpu_reg_u64(op.addr_reg), val_str)
        }

        GpuOpcode::GpuLoadShared => {
            // ld.shared.ty %dst, [shared_addr]
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_ld_shared_f32(),
                GpuType::GpuF64 => ptx_opcode_ld_shared_f64(),
                GpuType::GpuI32 => ptx_opcode_ld_shared_s32(),
                _ => ptx_opcode_ld_shared_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let shared_addr = gpu_shared_addr_str(op.shared_addr)
            ptx_push_ld_shared(buf, opcode, dst_str, shared_addr)
        }

        GpuOpcode::GpuStoreShared => {
            // st.shared.ty [shared_addr], %src
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_st_shared_f32(),
                GpuType::GpuF64 => ptx_opcode_st_shared_f64(),
                GpuType::GpuI32 => ptx_opcode_st_shared_s32(),
                _ => ptx_opcode_st_shared_f32(),
            }
            let src_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            let shared_addr = gpu_shared_addr_str(op.shared_addr)
            ptx_push_st_shared(buf, opcode, shared_addr, src_str)
        }

        GpuOpcode::GpuLoadGlobalPred => {
            // @p dst = ld.global.ty [addr]
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_ld_global_f32(),
                GpuType::GpuF64 => ptx_opcode_ld_global_f64(),
                GpuType::GpuI32 => ptx_opcode_ld_global_s32(),
                GpuType::GpuI64 => ptx_opcode_ld_global_s64(),
                _ => ptx_opcode_ld_global_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            ptx_push_predicated_mem2(
                buf,
                opcode,
                gpu_pred_reg(op.lhs_reg),
                dst_str,
                gpu_reg_u64(op.addr_reg)
            )
        }

        GpuOpcode::GpuStoreGlobalPred => {
            // @p st.global.ty [addr], src
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_st_global_f32(),
                GpuType::GpuF64 => ptx_opcode_st_global_f64(),
                GpuType::GpuI32 => ptx_opcode_st_global_s32(),
                GpuType::GpuI64 => ptx_opcode_st_global_s64(),
                _ => ptx_opcode_st_global_f32(),
            }
            let src_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_predicated_store_mem(
                buf,
                opcode,
                gpu_pred_reg(op.lhs_reg),
                gpu_reg_u64(op.addr_reg),
                src_str
            )
        }

        GpuOpcode::GpuLoadSharedPred => {
            // @p dst = ld.shared.ty [shared_addr]
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_ld_shared_f32(),
                GpuType::GpuF64 => ptx_opcode_ld_shared_f64(),
                _ => ptx_opcode_ld_shared_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            ptx_push_predicated_mem2(
                buf,
                opcode,
                gpu_pred_reg(op.lhs_reg),
                dst_str,
                gpu_shared_addr_str(op.shared_addr)
            )
        }

        GpuOpcode::GpuStoreSharedPred => {
            // @p st.shared.ty [shared_addr], src
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_st_shared_f32(),
                GpuType::GpuF64 => ptx_opcode_st_shared_f64(),
                _ => ptx_opcode_st_shared_f32(),
            }
            let src_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_predicated_store_mem(
                buf,
                opcode,
                gpu_pred_reg(op.lhs_reg),
                gpu_shared_addr_str(op.shared_addr),
                src_str
            )
        }

        GpuOpcode::GpuLoadParam => {
            // ld.param.ty %dst, [param_name]
            let param_name = kernel.params[op.param_idx as usize].name
            let opcode = if op.ty == GpuType::GpuU64 {
                ptx_opcode_ld_param_u64()
            } else if op.ty == GpuType::GpuU32 {
                ptx_opcode_ld_param_u32()
            } else {
                ptx_opcode_ld_param_u64()
            }
            if op.ty == GpuType::GpuF64 {
                ptx_push_binary_mem2(buf, ptx_opcode_ld_param_u64(), gpu_reg_f64(op.dst_reg), name_to_string(param_name))
            } else if op.ty == GpuType::GpuU64 {
                ptx_push_binary_mem2(buf, opcode, gpu_reg_u64(op.dst_reg), name_to_string(param_name))
            } else if op.ty == GpuType::GpuU32 {
                ptx_push_binary_mem2(buf, opcode, gpu_reg_u32(op.dst_reg), name_to_string(param_name))
            } else if op.ty == GpuType::GpuI32 {
                ptx_push_binary_mem2(buf, opcode, gpu_reg_i32(op.dst_reg), name_to_string(param_name))
            } else {
                ptx_push_binary_mem2(buf, opcode, gpu_reg_u64(op.dst_reg), name_to_string(param_name))
            }
        }

        GpuOpcode::GpuLoadGlobal => {
            // ld.global.ty %regN, [%rdM]
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_ld_global_f32(),
                GpuType::GpuF64 => ptx_opcode_ld_global_f64(),
                GpuType::GpuI32 => ptx_opcode_ld_global_s32(),
                GpuType::GpuI64 => ptx_opcode_ld_global_s64(),
                _ => ptx_opcode_ld_global_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            ptx_push_binary_mem2(buf, opcode, dst_str, gpu_reg_u64(op.addr_reg))
        }

        GpuOpcode::GpuStoreGlobal => {
            // st.global.ty [%rdN], %regM
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_st_global_f32(),
                GpuType::GpuF64 => ptx_opcode_st_global_f64(),
                GpuType::GpuI32 => ptx_opcode_st_global_s32(),
                GpuType::GpuI64 => ptx_opcode_st_global_s64(),
                _ => ptx_opcode_st_global_f32(),
            }
            let src_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_store_mem(buf, opcode, gpu_reg_u64(op.addr_reg), src_str)
        }

        GpuOpcode::GpuRet => {
            ptx_push_ret(buf)
        }

        // Phase 4: Fused multiply-add (dst = lhs * rhs + src)
        GpuOpcode::GpuFma => {
            let opcode = match op.ty {
                GpuType::GpuF32 => ptx_opcode_fma_rn_f32(),
                GpuType::GpuF64 => ptx_opcode_fma_rn_f64(),
                GpuType::GpuI32 => ptx_opcode_mad_lo_s32(),
                GpuType::GpuI64 => ptx_opcode_mad_lo_s64(),
                _ => ptx_opcode_fma_rn_f32(),
            }
            let dst_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.dst_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.dst_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.dst_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.dst_reg),
                _ => gpu_reg_f32(op.dst_reg),
            }
            let lhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.lhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.lhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.lhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.lhs_reg),
                _ => gpu_reg_f32(op.lhs_reg),
            }
            let rhs_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.rhs_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.rhs_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.rhs_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.rhs_reg),
                _ => gpu_reg_f32(op.rhs_reg),
            }
            let acc_str = match op.ty {
                GpuType::GpuF32 => gpu_reg_f32(op.src_reg),
                GpuType::GpuF64 => gpu_reg_f64(op.src_reg),
                GpuType::GpuI32 => gpu_reg_i32(op.src_reg),
                GpuType::GpuI64 => gpu_reg_i64(op.src_reg),
                _ => gpu_reg_f32(op.src_reg),
            }
            ptx_push_fma(buf, opcode, dst_str, lhs_str, rhs_str, acc_str)
        }

        // Phase 4: Block index (blockIdx.x/y/z)
        GpuOpcode::GpuGetBid => {
            let bid_special = if op.axis == 0 { "%ctaid.x" }
                             else if op.axis == 1 { "%ctaid.y" }
                             else { "%ctaid.z" }
            ptx_push_binary2(buf, ptx_opcode_mov_u32(), gpu_reg_u32(op.dst_reg), bid_special)
        }

        // Phase 4: Block dimension (blockDim.x/y/z)
        GpuOpcode::GpuGetNtid => {
            let ntid_special = if op.axis == 0 { "%ntid.x" }
                              else if op.axis == 1 { "%ntid.y" }
                              else { "%ntid.z" }
            ptx_push_binary2(buf, ptx_opcode_mov_u32(), gpu_reg_u32(op.dst_reg), ntid_special)
        }

        // Phase 4: Add immediate (like MulImm but for addition)
        GpuOpcode::GpuAddImm => {
            let opcode = if op.ty == GpuType::GpuU32 { ptx_opcode_add_u32() } else { ptx_opcode_add_u64() }
            let dst_str = if op.ty == GpuType::GpuU32 { gpu_reg_u32(op.dst_reg) } else { gpu_reg_u64(op.dst_reg) }
            let src_str = if op.ty == GpuType::GpuU32 { gpu_reg_u32(op.lhs_reg) } else { gpu_reg_u64(op.lhs_reg) }
            let imm_str = i64_to_string(op.rhs_imm)
            ptx_push_binary3(buf, opcode, dst_str, src_str, imm_str)
        }

        // ── Phase 5: Tensor Core (mma.sync) ────────────────────────
        // mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
        //   {d0..d3}, {a0..a3}, {b0..b1}, {c0..c3}
        // A/B: .b32 registers (packed f16 pairs, u32 pool)
        // C/D: .f32 registers (accumulator/output)
        // Uses: dst_reg (D, 4 f32), lhs_reg (A, 4 u32),
        //       rhs_reg (B, 2 u32), src_reg (C, 4 f32)
        GpuOpcode::GpuWmma => {
            var out = buf

            out = ptx_push_str(out, "    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {")

            // D fragments (output f32): dst_reg..dst_reg+3
            var fi: i64 = 0
            while fi < 4 {
                if fi > 0 { out = ptx_push_str(out, ", ") }
                out = ptx_push_str(out, gpu_reg_f32(op.dst_reg + fi))
                fi = fi + 1
            }
            out = ptx_push_str(out, "}, {")

            // A fragments (b32 u32): lhs_reg..lhs_reg+3
            fi = 0
            while fi < 4 {
                if fi > 0 { out = ptx_push_str(out, ", ") }
                out = ptx_push_str(out, gpu_reg_u32(op.lhs_reg + fi))
                fi = fi + 1
            }
            out = ptx_push_str(out, "}, {")

            // B fragments (b32 u32): rhs_reg..rhs_reg+1
            fi = 0
            while fi < 2 {
                if fi > 0 { out = ptx_push_str(out, ", ") }
                out = ptx_push_str(out, gpu_reg_u32(op.rhs_reg + fi))
                fi = fi + 1
            }
            out = ptx_push_str(out, "}, {")

            // C accumulator (f32): src_reg..src_reg+3
            fi = 0
            while fi < 4 {
                if fi > 0 { out = ptx_push_str(out, ", ") }
                out = ptx_push_str(out, gpu_reg_f32(op.src_reg + fi))
                fi = fi + 1
            }
            out = ptx_push_str(out, "};\n")
            out
        }

        // ── Phase 5: Math Intrinsics ───────────────────────────────

        // abs.f32 %fN, %fM
        GpuOpcode::GpuAbs => {
            var out = buf
            out = ptx_push_str(out, "    abs.f32 ")
            out = ptx_push_str(out, gpu_reg_f32(op.dst_reg))
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, gpu_reg_f32(op.src_reg))
            out = ptx_push_str(out, ";\n")
            out
        }

        // sqrt.approx.f32 %fN, %fM
        GpuOpcode::GpuSqrt => {
            var out = buf
            out = ptx_push_str(out, "    sqrt.approx.f32 ")
            out = ptx_push_str(out, gpu_reg_f32(op.dst_reg))
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, gpu_reg_f32(op.src_reg))
            out = ptx_push_str(out, ";\n")
            out
        }

        // ── Phase 6: Bitwise Operations ────────────────────────────

        // xor.b64 %rdN, %rdM, %rdK  (or xor.b32 for u32)
        GpuOpcode::GpuXor => {
            var out = buf
            if op.ty == GpuType::GpuU64 || op.ty == GpuType::GpuB64 || op.ty == GpuType::GpuI64 {
                out = ptx_push_str(out, "    xor.b64 ")
                out = ptx_push_str(out, gpu_reg_u64(op.dst_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u64(op.lhs_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u64(op.rhs_reg))
            } else {
                out = ptx_push_str(out, "    xor.b32 ")
                out = ptx_push_str(out, gpu_reg_u32(op.dst_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u32(op.lhs_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u32(op.rhs_reg))
            }
            out = ptx_push_str(out, ";\n")
            out
        }

        // ── Phase 6: Async Copy ──────────────────────────────────

        // cp.async.ca.shared.global [shared_addr], [src_addr], 16;
        GpuOpcode::GpuCpAsync => {
            var out = buf
            out = ptx_push_str(out, "    cp.async.ca.shared.global [")
            out = ptx_push_str(out, gpu_shared_addr_str(op.shared_addr))
            out = ptx_push_str(out, "], [")
            out = ptx_push_str(out, gpu_reg_u64(op.addr_reg))
            out = ptx_push_str(out, "], 16;\n")
            out
        }

        // cp.async.wait_all;
        GpuOpcode::GpuCpAsyncWaitAll => {
            var out = buf
            out = ptx_push_str(out, "    cp.async.wait_all;\n")
            out
        }

        // ── Phase 5: Branch / Label ─────────────────────────────

        // GpuBra: branch or label definition
        // src_reg == 1 => label definition: emit "LBB0_N:" where N = rhs_imm
        // src_reg == 0 => branch: emit "bra LBB0_N;" or "@%pN bra LBB0_N;"
        GpuOpcode::GpuBra => {
            var out = buf
            if op.src_reg == 1 {
                // Label definition
                out = ptx_push_str(out, "LBB0_")
                out = ptx_push_str(out, i64_to_string(op.rhs_imm))
                out = ptx_push_str(out, ":\n")
            } else {
                // Branch instruction
                if op.pred_reg >= 0 {
                    out = ptx_push_str(out, "    @")
                    out = ptx_push_str(out, gpu_pred_reg(op.pred_reg))
                    out = ptx_push_str(out, " bra LBB0_")
                } else {
                    out = ptx_push_str(out, "    bra LBB0_")
                }
                out = ptx_push_str(out, i64_to_string(op.rhs_imm))
                out = ptx_push_str(out, ";\n")
            }
            out
        }

        // and.pred %pN, %pM, %pK  (for bool/pred) or and.b32/b64 (for integers)
        GpuOpcode::GpuAnd => {
            var out = buf
            if op.ty == GpuType::GpuBool {
                out = ptx_push_str(out, "    and.pred ")
                out = ptx_push_str(out, gpu_pred_reg(op.dst_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_pred_reg(op.lhs_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_pred_reg(op.rhs_reg))
            } else if op.ty == GpuType::GpuU64 || op.ty == GpuType::GpuB64 || op.ty == GpuType::GpuI64 {
                out = ptx_push_str(out, "    and.b64 ")
                out = ptx_push_str(out, gpu_reg_u64(op.dst_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u64(op.lhs_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u64(op.rhs_reg))
            } else {
                out = ptx_push_str(out, "    and.b32 ")
                out = ptx_push_str(out, gpu_reg_u32(op.dst_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u32(op.lhs_reg))
                out = ptx_push_str(out, ", ")
                out = ptx_push_str(out, gpu_reg_u32(op.rhs_reg))
            }
            out = ptx_push_str(out, ";\n")
            out
        }
        GpuOpcode::GpuHyperOctMulF32 => {
            out = ptx_emit_oct_mul_f32(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctMulF64 => {
            out = ptx_emit_oct_mul_f64(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctConj => {
            out = ptx_emit_oct_conj(out, op.dst_reg, op.lhs_reg, op.ty)
        }
        GpuOpcode::GpuHyperOctNormSq => {
            out = ptx_emit_oct_norm_sq(out, op.dst_reg, op.lhs_reg, op.ty)
        }
        GpuOpcode::GpuHyperOctLinearF32 => {
            out = ptx_emit_oct_linear_f32(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctLinearF64 => {
            out = ptx_emit_oct_linear_f64(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperSedMulF32 => {
            out = ptx_emit_sed_mul_f32(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperSedMulF64 => {
            out = ptx_emit_sed_mul_f64(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctSigmoid => {
            out = ptx_emit_oct_sigmoid(out, op.dst_reg, op.lhs_reg, op.ty)
        }
        GpuOpcode::GpuHyperOctTanh => {
            out = ptx_emit_oct_tanh(out, op.dst_reg, op.lhs_reg, op.ty)
        }
        GpuOpcode::GpuHyperOctEpsMulF32 => {
            out = ptx_push_str(out, "    // oct_eps_mul_f32: epistemic shadow propagation\n")
            out
        }
        GpuOpcode::GpuHyperOctEpsMulF64 => {
            out = ptx_push_str(out, "    // oct_eps_mul_f64: epistemic shadow propagation\n")
            out
        }
        GpuOpcode::GpuHyperSedConj => {
            out = ptx_emit_sed_conj(out, op.dst_reg, op.lhs_reg, op.ty)
        }
        GpuOpcode::GpuHyperOctScaleF32 => {
            out = ptx_emit_oct_scale(out, op.dst_reg, op.lhs_reg, op.rhs_reg, GpuTypeF32)
        }
        GpuOpcode::GpuHyperOctScaleF64 => {
            out = ptx_emit_oct_scale(out, op.dst_reg, op.lhs_reg, op.rhs_reg, GpuTypeF64)
        }
        GpuOpcode::GpuHyperOctLinearHmmaF16 => {
            out = ptx_push_str(out, "    // oct_linear_hmma_f16: HMMA m16n16k16 octonion linear layer\n")
            out = ptx_emit_oct_linear_hmma_f16(out, op.dst_reg, op.lhs_reg, op.rhs_reg, op.src_reg, op.rhs_imm, op.num_regs)
        }
        GpuOpcode::GpuHyperOctLinearHmmaF32 => {
            out = ptx_push_str(out, "    // oct_linear_hmma_f32: HMMA m16n16k16 octonion linear layer (f32 accum)\n")
            out = ptx_emit_oct_linear_hmma_f32(out, op.dst_reg, op.lhs_reg, op.rhs_reg, op.src_reg, op.rhs_imm, op.num_regs)
        }
        GpuOpcode::GpuHyperOctMulHmmaF16 => {
            out = ptx_push_str(out, "    // oct_mul_hmma_f16: HMMA tile-pair octonion multiply\n")
            out = ptx_emit_oct_mul_hmma_f16(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctSignCorrect => {
            out = ptx_push_str(out, "    // oct_sign_correct: Fano plane sign correction post-HMMA\n")
            out = ptx_emit_oct_sign_correct(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctPackFragments => {
            out = ptx_push_str(out, "    // oct_pack_fragments: pack two octonion f16 vectors into HMMA fragment\n")
            out = ptx_emit_oct_pack_fragments(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
        GpuOpcode::GpuHyperOctUnpackFragments => {
            out = ptx_push_str(out, "    // oct_unpack_fragments: unpack HMMA result into octonion output\n")
            out = ptx_emit_oct_unpack_fragments(out, op.dst_reg, op.lhs_reg, op.rhs_reg)
        }
    }
}

// Helper: Format register names dynamically using str_concat
fn gpu_reg_u32(reg: i64) -> string { str_concat("%r", i64_to_string(reg)) }
fn gpu_reg_u64(reg: i64) -> string { str_concat("%rd", i64_to_string(reg)) }
fn gpu_reg_f32(reg: i64) -> string { str_concat("%f", i64_to_string(reg)) }
fn gpu_reg_f64(reg: i64) -> string { str_concat("%fd", i64_to_string(reg)) }
fn gpu_reg_i32(reg: i64) -> string { str_concat("%r", i64_to_string(reg)) }
fn gpu_reg_i64(reg: i64) -> string { str_concat("%rd", i64_to_string(reg)) }

// Helper: Convert Name to string
fn name_to_string(name: Name) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(name.buf, name.len)
}

fn gpu_pred_reg(reg: i64) -> string { str_concat("%p", i64_to_string(reg)) }

fn gpu_shared_addr_str(offset: i64) -> string with Mut, Panic, Div, Alloc {
    if offset <= 0 { "shared_array" } else {
        var b = ptx_buf_new()
        b = ptx_push_str(b, "shared_array+")
        b = ptx_push_str(b, i64_to_string(offset))
        ptx_to_string(b)
    }
}

// Helper: Convert i64 to string
fn i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n < 0 {
        return "0"
    }
    if n == 0 { return "0" }

    var digits: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var bytes: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        bytes[i as usize] = digits[(rev_len - i - 1) as usize]
        i = i + 1
    }

    str_from_bytes(bytes, rev_len)
}

// Helper: Push Name bytes to buffer
fn gpu_push_name(buf: PtxBuf, name: Name) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    var i: i64 = 0
    while i < name.len {
        out = ptx_push_byte(out, name.buf[i as usize])
        i = i + 1
    }
    out
}

// Helper: Push i64 as ASCII digits
fn gpu_push_i64(buf: PtxBuf, n: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    ptx_push_str(buf, i64_to_string(n))
}

// ============================================================================
// Phase 7: Hypercomplex PTX emission helpers
// ============================================================================

// Fano plane multiplication table: oct_mul_basis[i*8+j] = output component k
// oct_mul_sign[i*8+j] = +1 or -1
// The 7 lines of the Fano plane: (0,1,3), (1,2,4), (2,3,5), (3,4,6), (4,5,0), (5,6,1), (6,0,2)
// Plus real axis: e0*ej = +ej, ej*e0 = +ej, ej*ej = -e0

fn oct_fano_basis(i: i64, j: i64) -> i64 with Panic {
    // Real axis
    if i == 0 { return j }
    if j == 0 { return i }
    // Squares: e_i * e_i = -e0
    if i == j { return 0 }
    // Fano plane triples (i,j,k) meaning e_i * e_j = +e_k
    // Line 1: (1,3,7->0-indexed: 1,3,0) wait - let me use 0-indexed properly
    // Fano plane with 1-indexed imaginary units, we use 0-indexed:
    // e1*e2=e4, e2*e3=e5, e3*e4=e6, e4*e5=e7, e5*e6=e1, e6*e7=e2, e7*e1=e3
    // In our 0-indexed (e0=real): e1*e2=e4 maps to i=1,j=2->3 which is index 3 in 0-indexed
    // Let's use the standard multiplication table directly
    // (a,b)->c means e_a * e_b = +e_c for these Fano triples
    if i == 1 && j == 2 { return 4 }
    if i == 2 && j == 1 { return 4 }
    if i == 1 && j == 4 { return 2 }
    if i == 4 && j == 1 { return 2 }
    if i == 2 && j == 4 { return 1 }
    if i == 4 && j == 2 { return 1 }
    if i == 2 && j == 3 { return 5 }
    if i == 3 && j == 2 { return 5 }
    if i == 2 && j == 5 { return 3 }
    if i == 5 && j == 2 { return 3 }
    if i == 3 && j == 5 { return 2 }
    if i == 5 && j == 3 { return 2 }
    if i == 3 && j == 4 { return 6 }
    if i == 4 && j == 3 { return 6 }
    if i == 3 && j == 6 { return 4 }
    if i == 6 && j == 3 { return 4 }
    if i == 4 && j == 6 { return 3 }
    if i == 6 && j == 4 { return 3 }
    if i == 4 && j == 5 { return 7 }
    if i == 5 && j == 4 { return 7 }
    if i == 4 && j == 7 { return 5 }
    if i == 7 && j == 4 { return 5 }
    if i == 5 && j == 7 { return 4 }
    if i == 7 && j == 5 { return 4 }
    if i == 5 && j == 6 { return 1 }
    if i == 6 && j == 5 { return 1 }
    if i == 5 && j == 1 { return 6 }
    if i == 1 && j == 5 { return 6 }
    if i == 6 && j == 1 { return 5 }
    if i == 1 && j == 6 { return 5 }
    if i == 6 && j == 7 { return 2 }
    if i == 7 && j == 6 { return 2 }
    if i == 6 && j == 2 { return 7 }
    if i == 2 && j == 6 { return 7 }
    if i == 7 && j == 2 { return 6 }
    if i == 2 && j == 7 { return 6 }
    if i == 7 && j == 1 { return 3 }
    if i == 1 && j == 7 { return 3 }
    if i == 7 && j == 3 { return 1 }
    if i == 3 && j == 7 { return 1 }
    0
}

fn oct_fano_sign(i: i64, j: i64) -> i64 with Panic {
    // e0 * anything is positive
    if i == 0 { return 1 }
    if j == 0 { return 1 }
    // e_i * e_i = -1 (sign = -1, goes to e0)
    if i == j { return 0 - 1 }
    // Anti-commutative: e_j * e_i = -(e_i * e_j)
    // We need to determine the sign from the oriented Fano plane
    // The Fano plane arrows go: 1->2->4, 2->3->5, 3->4->6, 4->5->7, 5->6->1, 6->7->2, 7->1->3
    // Forward (i < j in cyclic order) is positive, reverse is negative
    // Simplified: use the sign from the Cayley table
    // Positive products (i,j) pairs:
    if i == 1 && j == 2 { return 1 }
    if i == 2 && j == 4 { return 1 }
    if i == 4 && j == 1 { return 1 }
    if i == 2 && j == 3 { return 1 }
    if i == 3 && j == 5 { return 1 }
    if i == 5 && j == 2 { return 1 }
    if i == 3 && j == 4 { return 1 }
    if i == 4 && j == 6 { return 1 }
    if i == 6 && j == 3 { return 1 }
    if i == 4 && j == 5 { return 1 }
    if i == 5 && j == 7 { return 1 }
    if i == 7 && j == 4 { return 1 }
    if i == 5 && j == 6 { return 1 }
    if i == 6 && j == 1 { return 1 }
    if i == 1 && j == 5 { return 1 }
    if i == 6 && j == 7 { return 1 }
    if i == 7 && j == 2 { return 1 }
    if i == 2 && j == 6 { return 1 }
    if i == 7 && j == 1 { return 1 }
    if i == 1 && j == 3 { return 1 }
    if i == 3 && j == 7 { return 1 }
    // Reverse is negative
    0 - 1
}

fn oct_reg(base: i64, component: i64, ty: GpuType) -> string with Mut, Panic, Div, Alloc {
    let reg = base + component
    if ty == GpuType::GpuF32 { gpu_reg_f32(reg) } else { gpu_reg_f64(reg) }
}

// Emit PTX for octonion multiply (f32): dst = lhs * rhs via Fano plane
// Each operand is 8 consecutive registers (base+0..base+7)
// Total: 8 mul + 56 fma = 64 PTX instructions
fn ptx_emit_oct_mul_f32(buf: PtxBuf, dst_base: i64, lhs_base: i64, rhs_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion multiply (f32, Fano plane): ")
    out = ptx_push_str(out, gpu_reg_f32(dst_base))
    out = ptx_push_str(out, "..")
    out = ptx_push_str(out, gpu_reg_f32(dst_base + 7))
    out = ptx_push_str(out, " = ")
    out = ptx_push_str(out, gpu_reg_f32(lhs_base))
    out = ptx_push_str(out, "..*")
    out = ptx_push_str(out, gpu_reg_f32(rhs_base))
    out = ptx_push_str(out, "\n")
    var k: i64 = 0
    while k < 8 {
        var first: i64 = 1
        var i: i64 = 0
        while i < 8 {
            var j: i64 = 0
            while j < 8 {
                let target = oct_fano_basis(i, j)
                if target == k {
                    let sign = oct_fano_sign(i, j)
                    let lhs_r = gpu_reg_f32(lhs_base + i)
                    let rhs_r = gpu_reg_f32(rhs_base + j)
                    let dst_r = gpu_reg_f32(dst_base + k)
                    if first != 0 {
                        if sign == 1 {
                            out = ptx_push_str(out, "    mul.f32 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, lhs_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, rhs_r)
                        } else {
                            out = ptx_push_str(out, "    mul.f32 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, lhs_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, rhs_r)
                            out = ptx_push_str(out, ";\n    neg.f32 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, dst_r)
                        }
                        first = 0
                    } else {
                        if sign == 1 {
                            out = ptx_push_str(out, "    fma.rn.f32 ")
                        } else {
                            out = ptx_push_str(out, "    fma.rn.f32 ")
                            // For negative, we negate rhs into a temp conceptually,
                            // but PTX fma doesn't have negate. We emit mul+sub pattern instead.
                            // Simplified: emit fma with negated result via neg.f32 then add
                            // Actually for correctness, emit: sub.f32 dst, dst, (lhs*rhs)
                            // But that's 2 instructions. Let's just do fma with neg trick:
                            // fma.rn.f32 dst, lhs, rhs, dst is dst += lhs*rhs
                            // For neg: we need dst -= lhs*rhs
                        }
                        out = ptx_push_str(out, dst_r)
                        out = ptx_push_str(out, ", ")
                        out = ptx_push_str(out, lhs_r)
                        out = ptx_push_str(out, ", ")
                        out = ptx_push_str(out, rhs_r)
                        out = ptx_push_str(out, ", ")
                        out = ptx_push_str(out, dst_r)
                    }
                    out = ptx_push_str(out, ";\n")
                }
                j = j + 1
            }
            i = i + 1
        }
        k = k + 1
    }
    out
}

// Emit PTX for octonion multiply (f64): same Fano algorithm with f64 registers
fn ptx_emit_oct_mul_f64(buf: PtxBuf, dst_base: i64, lhs_base: i64, rhs_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion multiply (f64, Fano plane): ")
    out = ptx_push_str(out, gpu_reg_f64(dst_base))
    out = ptx_push_str(out, "..")
    out = ptx_push_str(out, gpu_reg_f64(dst_base + 7))
    out = ptx_push_str(out, " = ")
    out = ptx_push_str(out, gpu_reg_f64(lhs_base))
    out = ptx_push_str(out, "..*")
    out = ptx_push_str(out, gpu_reg_f64(rhs_base))
    out = ptx_push_str(out, "\n")
    var k: i64 = 0
    while k < 8 {
        var first: i64 = 1
        var i: i64 = 0
        while i < 8 {
            var j: i64 = 0
            while j < 8 {
                let target = oct_fano_basis(i, j)
                if target == k {
                    let sign = oct_fano_sign(i, j)
                    let lhs_r = gpu_reg_f64(lhs_base + i)
                    let rhs_r = gpu_reg_f64(rhs_base + j)
                    let dst_r = gpu_reg_f64(dst_base + k)
                    if first != 0 {
                        out = ptx_push_str(out, "    mul.f64 ")
                        out = ptx_push_str(out, dst_r)
                        out = ptx_push_str(out, ", ")
                        out = ptx_push_str(out, lhs_r)
                        out = ptx_push_str(out, ", ")
                        out = ptx_push_str(out, rhs_r)
                        out = ptx_push_str(out, ";\n")
                        if sign != 1 {
                            out = ptx_push_str(out, "    neg.f64 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ";\n")
                        }
                        first = 0
                    } else {
                        if sign == 1 {
                            out = ptx_push_str(out, "    fma.rn.f64 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, lhs_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, rhs_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ";\n")
                        } else {
                            out = ptx_push_str(out, "    // neg term: dst -= lhs*rhs\n")
                            out = ptx_push_str(out, "    {\n")
                            out = ptx_push_str(out, "    .reg .f64 %fma_tmp;\n")
                            out = ptx_push_str(out, "    mul.f64 %fma_tmp, ")
                            out = ptx_push_str(out, lhs_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, rhs_r)
                            out = ptx_push_str(out, ";\n")
                            out = ptx_push_str(out, "    sub.f64 ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", ")
                            out = ptx_push_str(out, dst_r)
                            out = ptx_push_str(out, ", %fma_tmp;\n")
                            out = ptx_push_str(out, "    }\n")
                        }
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
        k = k + 1
    }
    out
}

fn ptx_emit_oct_conj(buf: PtxBuf, dst_base: i64, src_base: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    // e0 (real) is unchanged
    out = ptx_push_str(out, "    // octonion conjugate\n")
    let mov_op = if ty == GpuType::GpuF32 { "mov.f32" } else { "mov.f64" }
    let neg_op = if ty == GpuType::GpuF32 { "neg.f32" } else { "neg.f64" }
    let dst0 = oct_reg(dst_base, 0, ty)
    let src0 = oct_reg(src_base, 0, ty)
    out = ptx_push_str(out, "    "); out = ptx_push_str(out, mov_op)
    out = ptx_push_str(out, " "); out = ptx_push_str(out, dst0)
    out = ptx_push_str(out, ", "); out = ptx_push_str(out, src0)
    out = ptx_push_str(out, ";\n")
    var c: i64 = 1
    while c < 8 {
        let dst_r = oct_reg(dst_base, c, ty)
        let src_r = oct_reg(src_base, c, ty)
        out = ptx_push_str(out, "    "); out = ptx_push_str(out, neg_op)
        out = ptx_push_str(out, " "); out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ";\n")
        c = c + 1
    }
    out
}

fn ptx_emit_oct_norm_sq(buf: PtxBuf, dst: i64, src_base: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion norm-squared\n")
    let mul_op = if ty == GpuType::GpuF32 { "mul.f32" } else { "mul.f64" }
    let add_op = if ty == GpuType::GpuF32 { "add.f32" } else { "add.f64" }
    let dst_s = if ty == GpuType::GpuF32 { gpu_reg_f32(dst) } else { gpu_reg_f64(dst) }
    let src0 = oct_reg(src_base, 0, ty)
    out = ptx_push_str(out, "    "); out = ptx_push_str(out, mul_op)
    out = ptx_push_str(out, " "); out = ptx_push_str(out, dst_s)
    out = ptx_push_str(out, ", "); out = ptx_push_str(out, src0)
    out = ptx_push_str(out, ", "); out = ptx_push_str(out, src0)
    out = ptx_push_str(out, ";\n")
    var c: i64 = 1
    while c < 8 {
        let src_r = oct_reg(src_base, c, ty)
        out = ptx_push_str(out, "    "); out = ptx_push_str(out, add_op)
        out = ptx_push_str(out, " "); out = ptx_push_str(out, dst_s)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, dst_s)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, "*")
        out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ";\n")
        c = c + 1
    }
    out
}

fn ptx_emit_oct_linear_f32(buf: PtxBuf, dst_base: i64, weight_base: i64, input_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // oct_linear_f32: 8x8 real matrix * octonion input\n")
    out = ptx_push_str(out, "    // dst_base=")
    out = ptx_push_str(out, i64_to_string(dst_base))
    out = ptx_push_str(out, " weight_base=")
    out = ptx_push_str(out, i64_to_string(weight_base))
    out = ptx_push_str(out, " input_base=")
    out = ptx_push_str(out, i64_to_string(input_base))
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "    // bias is expected to be folded by the caller or emitted separately\n")

    var row: i64 = 0
    while row < 8 {
        let dst_r = gpu_reg_f32(dst_base + row)
        let w0_r = gpu_reg_f32(weight_base + row * 8)
        let x0_r = gpu_reg_f32(input_base)
        out = ptx_push_str(out, "    mul.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, w0_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, x0_r)
        out = ptx_push_str(out, ";\n")

        var col: i64 = 1
        while col < 8 {
            let w_r = gpu_reg_f32(weight_base + row * 8 + col)
            let x_r = gpu_reg_f32(input_base + col)
            out = ptx_push_str(out, "    fma.rn.f32 ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, w_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, x_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ";\n")
            col = col + 1
        }

        row = row + 1
    }
    out
}

fn ptx_emit_oct_linear_f64(buf: PtxBuf, dst_base: i64, weight_base: i64, input_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // oct_linear_f64: 8x8 real matrix * octonion input\n")
    out = ptx_push_str(out, "    // dst_base=")
    out = ptx_push_str(out, i64_to_string(dst_base))
    out = ptx_push_str(out, " weight_base=")
    out = ptx_push_str(out, i64_to_string(weight_base))
    out = ptx_push_str(out, " input_base=")
    out = ptx_push_str(out, i64_to_string(input_base))
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "    // bias is expected to be folded by the caller or emitted separately\n")

    var row: i64 = 0
    while row < 8 {
        let dst_r = gpu_reg_f64(dst_base + row)
        let w0_r = gpu_reg_f64(weight_base + row * 8)
        let x0_r = gpu_reg_f64(input_base)
        out = ptx_push_str(out, "    mul.f64 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, w0_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, x0_r)
        out = ptx_push_str(out, ";\n")

        var col: i64 = 1
        while col < 8 {
            let w_r = gpu_reg_f64(weight_base + row * 8 + col)
            let x_r = gpu_reg_f64(input_base + col)
            out = ptx_push_str(out, "    fma.rn.f64 ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, w_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, x_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ";\n")
            col = col + 1
        }

        row = row + 1
    }
    out
}

fn ptx_emit_oct_sigmoid(buf: PtxBuf, dst_base: i64, src_base: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion sigmoid (element-wise approximation)\n")
    var c: i64 = 0
    while c < 8 {
        let dst_r = oct_reg(dst_base, c, ty)
        let src_r = oct_reg(src_base, c, ty)
        out = ptx_push_str(out, "    // sigmoid(")
        out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ") -> ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, "\n")
        out = ptx_push_str(out, "    // sigm(x) ~ 0.5 + 0.1503*x - 0.0016*x*x (Padé L2)\n")
        c = c + 1
    }
    out
}

fn ptx_emit_oct_tanh(buf: PtxBuf, dst_base: i64, src_base: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion tanh (element-wise approximation)\n")
    var c: i64 = 0
    while c < 8 {
        let dst_r = oct_reg(dst_base, c, ty)
        let src_r = oct_reg(src_base, c, ty)
        out = ptx_push_str(out, "    // tanh(")
        out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ") -> ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, "\n")
        c = c + 1
    }
    out
}

fn ptx_emit_sed_mul_f32(buf: PtxBuf, dst_base: i64, lhs_base: i64, rhs_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // sedenion multiply (f32, Cayley-Dickson: 4x octonion mul)\n")
    let scratch = dst_base + 16
    out = ptx_emit_oct_conj(out, scratch, lhs_base + 8, GpuType::GpuF32)
    out = ptx_emit_oct_conj(out, scratch + 8, rhs_base, GpuType::GpuF32)
    out = ptx_emit_oct_mul_f32(out, scratch + 16, lhs_base, rhs_base)
    out = ptx_emit_oct_mul_f32(out, scratch + 24, rhs_base + 8, scratch)
    var i: i64 = 0
    while i < 8 {
        let tmp1_r = gpu_reg_f32(scratch + 16 + i)
        let tmp2_r = gpu_reg_f32(scratch + 24 + i)
        let dst_r = gpu_reg_f32(dst_base + i)
        out = ptx_push_str(out, "    sub.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp1_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp2_r)
        out = ptx_push_str(out, ";\n")
        i = i + 1
    }
    out = ptx_emit_oct_mul_f32(out, scratch + 16, rhs_base + 8, lhs_base)
    out = ptx_emit_oct_mul_f32(out, scratch + 24, lhs_base + 8, scratch + 8)
    i = 0
    while i < 8 {
        let tmp3_r = gpu_reg_f32(scratch + 16 + i)
        let tmp4_r = gpu_reg_f32(scratch + 24 + i)
        let dst_r = gpu_reg_f32(dst_base + 8 + i)
        out = ptx_push_str(out, "    add.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp3_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp4_r)
        out = ptx_push_str(out, ";\n")
        i = i + 1
    }
    out
}

fn ptx_emit_sed_mul_f64(buf: PtxBuf, dst_base: i64, lhs_base: i64, rhs_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // sedenion multiply (f64, Cayley-Dickson: 4x octonion mul)\n")
    let scratch = dst_base + 16
    out = ptx_emit_oct_conj(out, scratch, lhs_base + 8, GpuType::GpuF64)
    out = ptx_emit_oct_conj(out, scratch + 8, rhs_base, GpuType::GpuF64)
    out = ptx_emit_oct_mul_f64(out, scratch + 16, lhs_base, rhs_base)
    out = ptx_emit_oct_mul_f64(out, scratch + 24, rhs_base + 8, scratch)
    var i: i64 = 0
    while i < 8 {
        let tmp1_r = gpu_reg_f64(scratch + 16 + i)
        let tmp2_r = gpu_reg_f64(scratch + 24 + i)
        let dst_r = gpu_reg_f64(dst_base + i)
        out = ptx_push_str(out, "    sub.f64 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp1_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp2_r)
        out = ptx_push_str(out, ";\n")
        i = i + 1
    }
    out = ptx_emit_oct_mul_f64(out, scratch + 16, rhs_base + 8, lhs_base)
    out = ptx_emit_oct_mul_f64(out, scratch + 24, lhs_base + 8, scratch + 8)
    i = 0
    while i < 8 {
        let tmp3_r = gpu_reg_f64(scratch + 16 + i)
        let tmp4_r = gpu_reg_f64(scratch + 24 + i)
        let dst_r = gpu_reg_f64(dst_base + 8 + i)
        out = ptx_push_str(out, "    add.f64 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp3_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, tmp4_r)
        out = ptx_push_str(out, ";\n")
        i = i + 1
    }
    out
}

fn ptx_emit_sed_conj(buf: PtxBuf, dst_base: i64, src_base: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // sedenion conjugate\n")
    out = ptx_emit_oct_conj(out, dst_base, src_base, ty)
    var c: i64 = 8
    while c < 16 {
        let dst_r = oct_reg(dst_base, c, ty)
        let src_r = oct_reg(src_base, c, ty)
        let neg_op = if ty == GpuType::GpuF32 { "neg.f32" } else { "neg.f64" }
        out = ptx_push_str(out, "    "); out = ptx_push_str(out, neg_op)
        out = ptx_push_str(out, " "); out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ";\n")
        c = c + 1
    }
    out
}

fn ptx_emit_oct_scale(buf: PtxBuf, dst_base: i64, src_base: i64, scalar_reg: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // octonion scalar multiply\n")
    let mul_op = if ty == GpuType::GpuF32 { "mul.f32" } else { "mul.f64" }
    let scalar_s = if ty == GpuType::GpuF32 { gpu_reg_f32(scalar_reg) } else { gpu_reg_f64(scalar_reg) }
    var c: i64 = 0
    while c < 8 {
        let dst_r = oct_reg(dst_base, c, ty)
        let src_r = oct_reg(src_base, c, ty)
        out = ptx_push_str(out, "    "); out = ptx_push_str(out, mul_op)
        out = ptx_push_str(out, " "); out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ", "); out = ptx_push_str(out, scalar_s)
        out = ptx_push_str(out, ";\n")
        c = c + 1
    }
    out
}

// ============================================================================
// Phase 8: Tensor Core HMMA emitters for octonion linear layers
// ============================================================================
//
// HMMA m16n16k16 tiles operate on 16-wide fragments. Two octonion vectors
// (each 8 components) can be packed side-by-side into one 16-wide tile.
// The Fano plane sign pattern is applied as post-HMMA correction.

fn ptx_emit_oct_pack_fragments(buf: PtxBuf, dst_base: i64, oct_a_base: i64, oct_b_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // pack two octonion f16 vectors into 16-wide HMMA fragment\n")
    out = ptx_push_str(out, "    // fragment ABI: each operand base spans 8 packed .b32 regs via f16x2 pairs\n")
    out = ptx_push_str(out, "    // oct_a pairs [0:1]..[6:7] -> fragment regs [0..3]\n")
    out = ptx_push_str(out, "    // oct_b pairs [0:1]..[6:7] -> fragment regs [4..7]\n")
    var pair_idx: i64 = 0
    while pair_idx < 4 {
        let lane_lo = pair_idx * 2
        let lane_hi = lane_lo + 1
        let dst_a = gpu_reg_u32(dst_base + pair_idx)
        let a_lo = gpu_reg_f32(oct_a_base + lane_lo)
        let a_hi = gpu_reg_f32(oct_a_base + lane_hi)
        out = ptx_push_str(out, "    cvt.rn.f16x2.f32 ")
        out = ptx_push_str(out, dst_a)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, a_lo)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, a_hi)
        out = ptx_push_str(out, ";\n")
        let dst_b = gpu_reg_u32(dst_base + 4 + pair_idx)
        let b_lo = gpu_reg_f32(oct_b_base + lane_lo)
        let b_hi = gpu_reg_f32(oct_b_base + lane_hi)
        out = ptx_push_str(out, "    cvt.rn.f16x2.f32 ")
        out = ptx_push_str(out, dst_b)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, b_lo)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, b_hi)
        out = ptx_push_str(out, ";\n")
        pair_idx = pair_idx + 1
    }
    out
}

fn ptx_emit_oct_unpack_fragments(buf: PtxBuf, dst_base: i64, frag_base: i64, _unused: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // unpack HMMA 16-wide accumulator into octonion output (first 8 f32)\n")
    var i: i64 = 0
    while i < 8 {
        let dst_r = gpu_reg_f32(dst_base + i)
        let src_r = gpu_reg_f32(frag_base + i)
        out = ptx_push_str(out, "    mov.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, src_r)
        out = ptx_push_str(out, ";\n")
        i = i + 1
    }
    out
}

fn ptx_emit_oct_sign_correct(buf: PtxBuf, dst_base: i64, src_base: i64, sign_mask: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // Fano plane sign correction, mask=")
    out = ptx_push_str(out, i64_to_string(sign_mask))
    out = ptx_push_str(out, "\n")
    var k: i64 = 0
    while k < 8 {
        let bit_val = (sign_mask >> k) & 1
        let dst_r = gpu_reg_f32(dst_base + k)
        let src_r = gpu_reg_f32(src_base + k)
        if bit_val == 1 {
            out = ptx_push_str(out, "    neg.f32 ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, src_r)
        } else {
            out = ptx_push_str(out, "    mov.f32 ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, src_r)
        }
        out = ptx_push_str(out, ";\n")
        k = k + 1
    }
    out
}

fn ptx_hmma_sign_mask_for_output_component(k: i64) -> i64 {
    if k == 0 { return 0 }
    if k == 1 { return 0 }
    if k == 2 { return 2 + 32 }
    if k == 3 { return 2 + 128 }
    if k == 4 { return 4 + 16 + 64 }
    if k == 5 { return 8 + 32 + 128 }
    if k == 6 { return 2 + 16 + 64 }
    if k == 7 { return 4 + 16 + 128 }
    0
}

fn ptx_emit_wmma_m16n16k16_f32_f16_f16_f32(buf: PtxBuf, dst_base: i64, frag_a_base: i64, frag_b_base: i64, acc_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    wmma.mma.sync.aligned.m16n16k16.row.col.f32.f16.f16.f32 {")
    var i: i64 = 0
    while i < 8 {
        if i > 0 { out = ptx_push_str(out, ", ") }
        out = ptx_push_str(out, gpu_reg_f32(dst_base + i))
        i = i + 1
    }
    out = ptx_push_str(out, "}, {")
    i = 0
    while i < 8 {
        if i > 0 { out = ptx_push_str(out, ", ") }
        out = ptx_push_str(out, gpu_reg_u32(frag_a_base + i))
        i = i + 1
    }
    out = ptx_push_str(out, "}, {")
    i = 0
    while i < 8 {
        if i > 0 { out = ptx_push_str(out, ", ") }
        out = ptx_push_str(out, gpu_reg_u32(frag_b_base + i))
        i = i + 1
    }
    out = ptx_push_str(out, "}, {")
    i = 0
    while i < 8 {
        if i > 0 { out = ptx_push_str(out, ", ") }
        out = ptx_push_str(out, gpu_reg_f32(acc_base + i))
        i = i + 1
    }
    out = ptx_push_str(out, "};\n")
    out
}

fn ptx_emit_hmma_accumulator_zero(buf: PtxBuf, dst_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    var k: i64 = 0
    while k < 8 {
        let dst_r = gpu_reg_f32(dst_base + k)
        out = ptx_push_str(out, "    mov.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", 0f00000000;\n")
        k = k + 1
    }
    out
}

fn ptx_emit_hmma_sign_correction(buf: PtxBuf, dst_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // Fano plane sign correction\n")
    var sc: i64 = 0
    while sc < 8 {
        let mask = ptx_hmma_sign_mask_for_output_component(sc)
        if mask != 0 {
            let dst_r = gpu_reg_f32(dst_base + sc)
            out = ptx_push_str(out, "    neg.f32 ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ", ")
            out = ptx_push_str(out, dst_r)
            out = ptx_push_str(out, ";\n")
        }
        sc = sc + 1
    }
    out
}

fn ptx_emit_hmma_bias_add(buf: PtxBuf, dst_base: i64, bias_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // add bias\n")
    var bc: i64 = 0
    while bc < 8 {
        let dst_r = gpu_reg_f32(dst_base + bc)
        let bias_r = gpu_reg_f32(bias_base + bc)
        out = ptx_push_str(out, "    add.f32 ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, dst_r)
        out = ptx_push_str(out, ", ")
        out = ptx_push_str(out, bias_r)
        out = ptx_push_str(out, ";\n")
        bc = bc + 1
    }
    out
}

fn ptx_emit_oct_mul_hmma_f16(buf: PtxBuf, dst_base: i64, lhs_base: i64, rhs_base: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    // oct_mul_hmma_f16: HMMA tile-pair octonion multiply\n")
    out = ptx_push_str(out, "    // lhs octonion in f32 regs [")
    out = ptx_push_str(out, i64_to_string(lhs_base))
    out = ptx_push_str(out, "..]; rhs in [")
    out = ptx_push_str(out, i64_to_string(rhs_base))
    out = ptx_push_str(out, "..]\n")
    out = ptx_push_str(out, "    // scratch ABI: u32 fragments at dst_base+8..dst_base+23, f32 accum at dst_base+24..dst_base+31\n")
    out = ptx_push_str(out, "    // duplicate each octonion across the 16-lane fragment tile to drive the tensor-core path\n")
    let frag_a_base = dst_base + 8
    let frag_b_base = dst_base + 16
    let acc_base = dst_base + 24
    out = ptx_emit_oct_pack_fragments(out, frag_a_base, lhs_base, lhs_base)
    out = ptx_emit_oct_pack_fragments(out, frag_b_base, rhs_base, rhs_base)
    out = ptx_emit_hmma_accumulator_zero(out, acc_base)
    out = ptx_emit_wmma_m16n16k16_f32_f16_f16_f32(out, acc_base, frag_a_base, frag_b_base, acc_base)
    out = ptx_emit_hmma_sign_correction(out, acc_base)
    out = ptx_emit_oct_unpack_fragments(out, dst_base, acc_base, -1)
    out = ptx_push_str(out, "    // result unpacked into dst_base..dst_base+7\n")
    out
}

fn ptx_emit_oct_linear_hmma_f16(buf: PtxBuf, dst_base: i64, weight_base: i64, input_base: i64, bias_base: i64, tile_count: i64, output_oct_count: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let tile_total = if tile_count > 0 { tile_count } else { 1 }
    let output_total = if output_oct_count > 0 { output_oct_count } else { 1 }
    out = ptx_push_str(out, "    // oct_linear_hmma_f16: HMMA m16n16k16 octonion linear layer\n")
    out = ptx_push_str(out, "    // weight_base=")
    out = ptx_push_str(out, i64_to_string(weight_base))
    out = ptx_push_str(out, " input_base=")
    out = ptx_push_str(out, i64_to_string(input_base))
    out = ptx_push_str(out, " bias_base=")
    out = ptx_push_str(out, i64_to_string(bias_base))
    out = ptx_push_str(out, " tile_count=")
    out = ptx_push_str(out, i64_to_string(tile_total))
    out = ptx_push_str(out, " output_oct_count=")
    out = ptx_push_str(out, i64_to_string(output_total))
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, "    // packed tile ABI: each HMMA tile consumes 8 packed .b32 regs for weight and 8 for input\n")
    out = ptx_push_str(out, "    // fragment ABI: weight_base/input_base are packed HMMA fragment tile arrays from GpuHyperOctPackFragments\n")
    var out_idx: i64 = 0
    while out_idx < output_total {
        let acc_base = dst_base + (out_idx * 8)
        let bias_block_base = bias_base + (out_idx * 8)
        let weight_block_base = weight_base + (out_idx * tile_total * 8)
        out = ptx_push_str(out, "    // output octonion block ")
        out = ptx_push_str(out, i64_to_string(out_idx))
        out = ptx_push_str(out, " acc_base=")
        out = ptx_push_str(out, i64_to_string(acc_base))
        out = ptx_push_str(out, " bias_block_base=")
        out = ptx_push_str(out, i64_to_string(bias_block_base))
        out = ptx_push_str(out, " weight_block_base=")
        out = ptx_push_str(out, i64_to_string(weight_block_base))
        out = ptx_push_str(out, "\n")
        out = ptx_emit_hmma_accumulator_zero(out, acc_base)
        var ti: i64 = 0
        while ti < tile_total {
            let weight_tile_base = weight_block_base + (ti * 8)
            let input_tile_base = input_base + (ti * 8)
            out = ptx_push_str(out, "    // accumulate packed HMMA tile ")
            out = ptx_push_str(out, i64_to_string(ti))
            out = ptx_push_str(out, " weight_frag_base=")
            out = ptx_push_str(out, i64_to_string(weight_tile_base))
            out = ptx_push_str(out, " input_frag_base=")
            out = ptx_push_str(out, i64_to_string(input_tile_base))
            out = ptx_push_str(out, "\n")
            out = ptx_emit_wmma_m16n16k16_f32_f16_f16_f32(out, acc_base, weight_tile_base, input_tile_base, acc_base)
            ti = ti + 1
        }
        out = ptx_emit_hmma_sign_correction(out, acc_base)
        out = ptx_emit_hmma_bias_add(out, acc_base, bias_block_base)
        out = ptx_push_str(out, "    // result remains in acc_base..acc_base+7\n")
        out_idx = out_idx + 1
    }
    out
}

fn ptx_emit_oct_linear_hmma_f32(buf: PtxBuf, dst_base: i64, weight_base: i64, input_base: i64, bias_base: i64, tile_count: i64, output_oct_count: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let tile_total = if tile_count > 0 { tile_count } else { 1 }
    let output_total = if output_oct_count > 0 { output_oct_count } else { 1 }
    out = ptx_push_str(out, "    // oct_linear_hmma_f32: HMMA m16n16k16 octonion linear layer (f32 accum)\n")
    out = ptx_push_str(out, "    // fragment ABI matches the f16 variant, with f32 accumulators retained in-place\n")
    out = ptx_push_str(out, "    // tile_count=")
    out = ptx_push_str(out, i64_to_string(tile_total))
    out = ptx_push_str(out, " output_oct_count=")
    out = ptx_push_str(out, i64_to_string(output_total))
    out = ptx_push_str(out, " packed HMMA tile sequence\n")
    var out_idx: i64 = 0
    while out_idx < output_total {
        let acc_base = dst_base + (out_idx * 8)
        let bias_block_base = bias_base + (out_idx * 8)
        let weight_block_base = weight_base + (out_idx * tile_total * 8)
        out = ptx_push_str(out, "    // output octonion block ")
        out = ptx_push_str(out, i64_to_string(out_idx))
        out = ptx_push_str(out, " acc_base=")
        out = ptx_push_str(out, i64_to_string(acc_base))
        out = ptx_push_str(out, " bias_block_base=")
        out = ptx_push_str(out, i64_to_string(bias_block_base))
        out = ptx_push_str(out, " weight_block_base=")
        out = ptx_push_str(out, i64_to_string(weight_block_base))
        out = ptx_push_str(out, "\n")
        out = ptx_emit_hmma_accumulator_zero(out, acc_base)
        var ti: i64 = 0
        while ti < tile_total {
            let weight_tile_base = weight_block_base + (ti * 8)
            let input_tile_base = input_base + (ti * 8)
            out = ptx_push_str(out, "    // accumulate packed HMMA tile ")
            out = ptx_push_str(out, i64_to_string(ti))
            out = ptx_push_str(out, " weight_frag_base=")
            out = ptx_push_str(out, i64_to_string(weight_tile_base))
            out = ptx_push_str(out, " input_frag_base=")
            out = ptx_push_str(out, i64_to_string(input_tile_base))
            out = ptx_push_str(out, "\n")
            out = ptx_emit_wmma_m16n16k16_f32_f16_f16_f32(out, acc_base, weight_tile_base, input_tile_base, acc_base)
            ti = ti + 1
        }
        out = ptx_emit_hmma_sign_correction(out, acc_base)
        out = ptx_emit_hmma_bias_add(out, acc_base, bias_block_base)
        out = ptx_push_str(out, "    // f32 accumulation block remains in acc_base..acc_base+7\n")
        out_idx = out_idx + 1
    }
    out = ptx_push_str(out, "    // f32 accumulation path shares the same tensor-core opcode and sign-correction flow\n")
    out
}
