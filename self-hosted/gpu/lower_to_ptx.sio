    else if reg == 7 { "%rd7" }
    else if reg == 8 { "%rd8" }
    else if reg == 9 { "%rd9" }
    else if reg == 10 { "%rd10" }
    else if reg == 11 { "%rd11" }
    else if reg == 12 { "%rd12" }
    else if reg == 13 { "%rd13" }
    else if reg == 14 { "%rd14" }
    else if reg == 15 { "%rd15" }
    else if reg == 16 { "%rd16" }
    else if reg == 17 { "%rd17" }
    else if reg == 18 { "%rd18" }
    else if reg == 19 { "%rd19" }
    else if reg == 20 { "%rd20" }
    else { "%rd0" }
}

