// self-hosted::gpu::numerical — Numerical stability analysis and FP error as epistemic uncertainty
//
// Bridges floating-point numerical analysis with the epistemic type system.
// Every floating-point operation accumulates rounding error; this module
// reifies that error as first-class uncertainty bounds compatible with
// Knowledge<T, epsilon, validity, provenance>.
//
// Core concepts:
//   ULP error          — distance in Units of Last Place between computed and exact
//   Error bounds       — interval enclosing the true error with a confidence level
//   Error propagation  — how bounds flow through arithmetic (add, mul, div, transcendentals)
//   Stability analysis — detecting catastrophic cancellation, overflow, ill-conditioning
//   Precision advisory — recommending FP width (FP8/16/32/64) for a given computation
//
// Integration with epistemic system:
//   ErrorBound     → epsilon  (uncertainty bound in Knowledge<T>)
//   StabilityRisk  → validity confidence  (1.0 - severity)
//   count nibbles  → provenance bitmask  (packed into i64)
//
// Usage pattern:
//   let ep = error_propagator_new(3, 0)              // FP64, conservative mode
//   let pair = error_prop_add(ep, x_bound, y_bound)
//   let ep2 = pair.0
//   let bound = pair.1
//   let eps = error_to_epistemic_epsilon(bound)
//   let conf = risk_to_validity_confidence(risk)

// ============================================================================
// Extern math declarations
// ============================================================================

extern "C" {
    fn sqrt(x: f64) -> f64
    fn log(x: f64) -> f64
    fn exp(x: f64) -> f64
    fn fabs(x: f64) -> f64
    fn pow(x: f64, y: f64) -> f64
}

// ============================================================================
// Precision tag constants
// ============================================================================

let PRECISION_FP8: i64 = 0
let PRECISION_FP16: i64 = 1
let PRECISION_FP32: i64 = 2
let PRECISION_FP64: i64 = 3

// ============================================================================
// Stability risk tag constants
// ============================================================================

let STABILITY_STABLE: i64 = 0
let STABILITY_MILD: i64 = 1
let STABILITY_SEVERE: i64 = 2
let STABILITY_CATASTROPHIC: i64 = 3

// ============================================================================
// Mitigation strategy tag constants
// ============================================================================

let MITIGATION_UPGRADE_PRECISION: i64 = 0
let MITIGATION_KAHAN_SUMMATION: i64 = 1
let MITIGATION_COMPENSATED: i64 = 2
let MITIGATION_RESCALING: i64 = 3
let MITIGATION_REORDERING: i64 = 4
let MITIGATION_NONE: i64 = -1

// ============================================================================
// PropagationMode constants
// ============================================================================

let PROP_MODE_CONSERVATIVE: i64 = 0
let PROP_MODE_EXPECTED: i64 = 1
let PROP_MODE_INTERVAL: i64 = 2

// ============================================================================
// Struct declarations
// ============================================================================

struct UlpError {
    ulps: i64,
    relative_error: f64,
    absolute_error: f64,
}

struct ErrorBound {
    min_error: f64,
    max_error: f64,
    expected_error: f64,
    confidence: f64,
}

struct StabilityRisk {
    tag: i64,
    condition_number: f64,
    overflow_risk: f64,
    underflow_risk: f64,
    cancellation_risk: f64,
}

struct StabilityIssue {
    risk: StabilityRisk,
    mitigation: i64,
    severity: f64,
}

struct StabilityAnalyzer {
    precision: i64,
    condition_threshold: f64,
    cancellation_threshold: f64,
    issues: [StabilityIssue; 256],
    issue_count: i64,
    total_checks: i64,
    stable_count: i64,
    mild_count: i64,
    severe_count: i64,
    catastrophic_count: i64,
}

struct ErrorPropagatorState {
    precision: i64,
    mode: i64,
    op_count: i64,
    max_epsilon_seen: f64,
}

struct PrecisionAdvisor {
    default_precision: i64,
    error_tolerance: f64,
    recommended_precision: [i64; 256],
    rec_count: i64,
}

struct StabilitySummary {
    total_checks: i64,
    stable: i64,
    mild: i64,
    severe: i64,
    catastrophic: i64,
    worst_risk: i64,
}

// ============================================================================
// Math helpers — all helpers before callers
// ============================================================================

fn f64_abs(x: f64) -> f64 {
    if x < 0.0 {
        0.0 - x
    } else {
        x
    }
}

fn f64_max(a: f64, b: f64) -> f64 {
    if a >= b { a } else { b }
}

fn f64_min(a: f64, b: f64) -> f64 {
    if a <= b { a } else { b }
}

fn f64_clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

fn f64_sqrt(x: f64) -> f64 with Div {
    // Delegates to extern C sqrt; guard negative domain.
    if x <= 0.0 {
        return 0.0
    }
    sqrt(x)
}

fn f64_log2_approx(x: f64) -> f64 {
    // Approximate log2 via repeated scaling into [1, 2) + minimax polynomial.
    // Valid for x > 0 only; returns 0.0 otherwise.
    if x <= 0.0 {
        return 0.0
    }
    var mantissa = x
    var exponent: f64 = 0.0
    while mantissa < 1.0 {
        mantissa = mantissa * 2.0
        exponent = exponent - 1.0
    }
    while mantissa >= 2.0 {
        mantissa = mantissa / 2.0
        exponent = exponent + 1.0
    }
    // Minimax polynomial for log2(m) on [1, 2]:
    //   p(m) ~ -1.6404 + m*(2.8824 + m*(-1.7418 + m*0.4996))
    let m = mantissa
    let frac = 0.0 - 1.6404 + m * (2.8824 + m * (0.0 - 1.7418 + m * 0.4996))
    exponent + frac
}

fn f64_log10(x: f64) -> f64 with Div {
    // log10(x) = log2(x) / log2(10),  log2(10) ~ 3.321928
    if x <= 0.0 {
        return 0.0
    }
    f64_log2_approx(x) / 3.321928
}

fn i64_abs(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

// ============================================================================
// Precision queries
// ============================================================================
// Tag: 0=FP8, 1=FP16, 2=FP32, 3=FP64

fn precision_epsilon(prec: i64) -> f64 {
    if prec == PRECISION_FP8 {
        0.125                          // 2^(-3)
    } else if prec == PRECISION_FP16 {
        9.765625e-4                    // 2^(-10)
    } else if prec == PRECISION_FP32 {
        1.1920929e-7                   // 2^(-23)
    } else {
        2.220446e-16                   // 2^(-52), FP64
    }
}

fn precision_max_value(prec: i64) -> f64 {
    if prec == PRECISION_FP8 {
        448.0
    } else if prec == PRECISION_FP16 {
        65504.0
    } else if prec == PRECISION_FP32 {
        3.4028235e38
    } else {
        1.7976931e308
    }
}

fn precision_min_normal(prec: i64) -> f64 {
    if prec == PRECISION_FP8 {
        0.015625                       // 2^(-6)
    } else if prec == PRECISION_FP16 {
        6.1035156e-5
    } else if prec == PRECISION_FP32 {
        1.1754944e-38
    } else {
        2.2250739e-308
    }
}

fn precision_mantissa_bits(prec: i64) -> i64 {
    if prec == PRECISION_FP8 {
        3
    } else if prec == PRECISION_FP16 {
        10
    } else if prec == PRECISION_FP32 {
        23
    } else {
        52
    }
}

fn precision_can_represent(prec: i64, value: f64) -> bool {
    let abs_val = f64_abs(value)
    if abs_val == 0.0 {
        return true
    }
    if abs_val > precision_max_value(prec) {
        return false
    }
    if abs_val < precision_min_normal(prec) {
        return false
    }
    true
}

fn precision_quantization_error(prec: i64, value: f64) -> f64 {
    f64_abs(value) * precision_epsilon(prec)
}

// ============================================================================
// UlpError — distance in Units of Last Place
// ============================================================================

fn ulp_error_new(ulps: i64, rel: f64, abs_err: f64) -> UlpError {
    UlpError {
        ulps: ulps,
        relative_error: rel,
        absolute_error: abs_err,
    }
}

fn ulp_error_from_values(computed: f64, exact: f64) -> UlpError with Div {
    // If exact == 0.0: ulps=0, rel=0, abs=|computed|
    // else: abs=|computed-exact|, rel=abs/|exact|, ulps=(i64)(rel/eps64)
    if f64_abs(exact) < 1e-300 {
        return UlpError {
            ulps: 0,
            relative_error: 0.0,
            absolute_error: f64_abs(computed),
        }
    }
    let abs_err = f64_abs(computed - exact)
    let rel = abs_err / f64_abs(exact)
    let eps64 = precision_epsilon(PRECISION_FP64)
    let ulp_f = rel / eps64
    var ulps: i64 = 0
    if ulp_f > 9223372036854775000.0 {
        ulps = 9223372036854775000
    } else {
        ulps = ulp_f as i64
    }
    UlpError {
        ulps: ulps,
        relative_error: rel,
        absolute_error: abs_err,
    }
}

fn ulp_error_is_acceptable(err: UlpError, max_ulps: i64, max_relative: f64) -> bool {
    if i64_abs(err.ulps) > max_ulps {
        return false
    }
    if err.relative_error > max_relative {
        return false
    }
    true
}

fn ulp_error_to_epsilon(err: UlpError) -> f32 {
    // Cast expected relative_error to f32, clamped to [0, 1]
    let clamped = f64_clamp(err.relative_error, 0.0, 1.0)
    clamped as f32
}

fn ulp_error_combine(a: UlpError, b: UlpError) -> UlpError {
    // Combine via quadrature (root-sum-of-squares for uncorrelated errors)
    let rel = f64_sqrt(a.relative_error * a.relative_error + b.relative_error * b.relative_error)
    let abs_err = f64_sqrt(a.absolute_error * a.absolute_error + b.absolute_error * b.absolute_error)
    let combined_ulps = i64_abs(a.ulps) + i64_abs(b.ulps)
    UlpError {
        ulps: combined_ulps,
        relative_error: rel,
        absolute_error: abs_err,
    }
}

fn ulp_error_scale(err: UlpError, factor: f64) -> UlpError {
    let abs_factor = f64_abs(factor)
    let scaled_rel = err.relative_error * abs_factor
    let scaled_abs = err.absolute_error * abs_factor
    let scaled_ulps_f = (i64_abs(err.ulps) as f64) * abs_factor
    var scaled_ulps: i64 = 0
    if scaled_ulps_f > 9223372036854775000.0 {
        scaled_ulps = 9223372036854775000
    } else {
        scaled_ulps = scaled_ulps_f as i64
    }
    UlpError {
        ulps: scaled_ulps,
        relative_error: scaled_rel,
        absolute_error: scaled_abs,
    }
}

// ============================================================================
// ErrorBound — interval enclosing the true error with a confidence level
// ============================================================================

fn error_bound_new(min_err: f64, max_err: f64, expected: f64, conf: f64) -> ErrorBound {
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: expected,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_from_estimate(error: f64, conf: f64) -> ErrorBound {
    // min = error * 0.1, max = error * 10.0, expected = error
    let abs_err = f64_abs(error)
    ErrorBound {
        min_error: abs_err * 0.1,
        max_error: abs_err * 10.0,
        expected_error: abs_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_zero() -> ErrorBound {
    ErrorBound {
        min_error: 0.0,
        max_error: 0.0,
        expected_error: 0.0,
        confidence: 1.0,
    }
}

fn error_bound_machine_epsilon(prec: i64) -> ErrorBound {
    let eps = precision_epsilon(prec)
    ErrorBound {
        min_error: 0.0,
        max_error: eps,
        expected_error: eps / 2.0,
        confidence: 0.99,
    }
}

fn error_bound_is_stable(eb: ErrorBound, threshold: f64) -> bool {
    // Stable when the expected (not worst-case) error is within the threshold
    eb.expected_error <= threshold
}

fn error_bound_widen(eb: ErrorBound, factor: f64) -> ErrorBound {
    let abs_factor = f64_abs(factor)
    ErrorBound {
        min_error: eb.min_error,
        max_error: eb.max_error * abs_factor,
        expected_error: eb.expected_error * abs_factor,
        confidence: eb.confidence * (1.0 / abs_factor),
    }
}

fn error_bound_combine(a: ErrorBound, b: ErrorBound) -> ErrorBound {
    // Quadrature for expected; conservative sum + machine_eps for max;
    // min confidence * 0.99 reflects increased uncertainty from combination.
    let exp_err = f64_sqrt(a.expected_error * a.expected_error + b.expected_error * b.expected_error)
    let min_err = f64_sqrt(a.min_error * a.min_error + b.min_error * b.min_error)
    let machine_eps = precision_epsilon(PRECISION_FP64)
    let max_err = a.max_error + b.max_error + machine_eps
    let conf = f64_min(a.confidence, b.confidence) * 0.99
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_to_epsilon(eb: ErrorBound) -> f32 {
    // Map expected_error to an epistemic epsilon, clamped to [0, 1]
    let clamped = f64_clamp(eb.expected_error, 0.0, 1.0)
    clamped as f32
}

fn error_bound_for_add(a: ErrorBound, b: ErrorBound, prec: i64) -> ErrorBound {
    // Quadrature of independent errors, plus one roundoff unit
    let machine_eps = precision_epsilon(prec)
    let exp_err = f64_sqrt(a.expected_error * a.expected_error + b.expected_error * b.expected_error)
    let max_err = a.max_error + b.max_error + machine_eps
    let min_err = f64_sqrt(a.min_error * a.min_error + b.min_error * b.min_error)
    let conf = f64_min(a.confidence, b.confidence) * 0.99
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_for_mul(a: ErrorBound, b: ErrorBound, a_val: f64, b_val: f64, prec: i64) -> ErrorBound {
    // Relative errors add: ε_result ≈ ε_a/|a| + ε_b/|b| (in relative terms)
    // In absolute form: ε_result ≈ |b|*ε_a + |a|*ε_b + machine_eps*|a*b|
    let machine_eps = precision_epsilon(prec)
    let aa = f64_abs(a_val)
    let ab = f64_abs(b_val)
    let exp_err = f64_sqrt(
        (ab * a.expected_error) * (ab * a.expected_error) +
        (aa * b.expected_error) * (aa * b.expected_error)
    ) + machine_eps * aa * ab / 2.0
    let max_err = ab * a.max_error + aa * b.max_error + machine_eps * aa * ab
    let min_err = f64_sqrt(
        (ab * a.min_error) * (ab * a.min_error) +
        (aa * b.min_error) * (aa * b.min_error)
    )
    let conf = f64_min(a.confidence, b.confidence) * 0.99
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_for_div(a: ErrorBound, b: ErrorBound, a_val: f64, b_val: f64, prec: i64) -> ErrorBound with Div {
    // Similar to mul; widen significantly if |b_val| < 1e-10
    let machine_eps = precision_epsilon(prec)
    let aa = f64_abs(a_val)
    let ab = f64_abs(b_val)
    if ab < 1e-10 {
        // Near-zero divisor: widen bound massively
        let wide = error_bound_widen(a, 1e10)
        return wide
    }
    let ab_sq = ab * ab
    let exp_err = f64_sqrt(
        (a.expected_error / ab) * (a.expected_error / ab) +
        (aa * b.expected_error / ab_sq) * (aa * b.expected_error / ab_sq)
    ) + machine_eps * aa / ab / 2.0
    let max_err = (ab * a.max_error + aa * b.max_error) / ab_sq + machine_eps * aa / ab
    let min_err = f64_sqrt(
        (a.min_error / ab) * (a.min_error / ab) +
        (aa * b.min_error / ab_sq) * (aa * b.min_error / ab_sq)
    )
    let conf = f64_min(a.confidence, b.confidence) * 0.99
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

fn error_bound_for_sqrt(a: ErrorBound, a_val: f64) -> ErrorBound with Div {
    // ε_result = ε_a / (2 * sqrt(|a_val|))
    let aa = f64_abs(a_val)
    if aa < 1e-300 {
        return error_bound_zero()
    }
    let two_sqrt_a = 2.0 * f64_sqrt(aa)
    let exp_err = a.expected_error / two_sqrt_a
    let max_err = a.max_error / two_sqrt_a
    let min_err = a.min_error / two_sqrt_a
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: a.confidence,
    }
}

fn error_bound_for_transcendental(a: ErrorBound, a_val: f64, prec: i64) -> ErrorBound {
    // Conservative: 4 * machine_eps + 2 * a.expected
    let machine_eps = precision_epsilon(prec)
    let exp_err = 4.0 * machine_eps + 2.0 * a.expected_error
    let max_err = 4.0 * machine_eps + 2.0 * a.max_error
    let min_err = a.min_error
    let conf = a.confidence * 0.95
    ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: f64_clamp(conf, 0.0, 1.0),
    }
}

// ============================================================================
// StabilityRisk constructors
// ============================================================================

fn stability_risk_stable() -> StabilityRisk {
    StabilityRisk {
        tag: STABILITY_STABLE,
        condition_number: 0.0,
        overflow_risk: 0.0,
        underflow_risk: 0.0,
        cancellation_risk: 0.0,
    }
}

fn stability_risk_mild(cond: f64) -> StabilityRisk {
    StabilityRisk {
        tag: STABILITY_MILD,
        condition_number: cond,
        overflow_risk: 0.0,
        underflow_risk: 0.0,
        cancellation_risk: 0.0,
    }
}

fn stability_risk_severe(overflow: f64, underflow: f64) -> StabilityRisk {
    StabilityRisk {
        tag: STABILITY_SEVERE,
        condition_number: 0.0,
        overflow_risk: f64_clamp(overflow, 0.0, 1.0),
        underflow_risk: f64_clamp(underflow, 0.0, 1.0),
        cancellation_risk: 0.0,
    }
}

fn stability_risk_catastrophic(cancellation: f64) -> StabilityRisk {
    StabilityRisk {
        tag: STABILITY_CATASTROPHIC,
        condition_number: 0.0,
        overflow_risk: 0.0,
        underflow_risk: 0.0,
        cancellation_risk: f64_clamp(cancellation, 0.0, 1.0),
    }
}

fn stability_risk_is_unacceptable(r: StabilityRisk) -> bool {
    r.tag >= STABILITY_SEVERE
}

fn stability_risk_severity(r: StabilityRisk) -> f64 {
    if r.tag == STABILITY_STABLE {
        0.0
    } else if r.tag == STABILITY_MILD {
        // log10(kappa) / 16, capped at 0.5
        let kappa = f64_max(r.condition_number, 1.0)
        let log_kappa = f64_log10(kappa)
        f64_clamp(log_kappa / 16.0, 0.0, 0.5)
    } else if r.tag == STABILITY_SEVERE {
        // 0.5 + 0.3 * max(overflow, underflow)
        let worst = f64_max(r.overflow_risk, r.underflow_risk)
        0.5 + 0.3 * f64_clamp(worst, 0.0, 1.0)
    } else {
        // Catastrophic: 0.8 + 0.2 * cancellation
        0.8 + 0.2 * f64_clamp(r.cancellation_risk, 0.0, 1.0)
    }
}

fn stability_risk_mitigation(r: StabilityRisk) -> i64 {
    // Returns MitigationStrategy tag constant
    if r.tag == STABILITY_STABLE {
        MITIGATION_NONE
    } else if r.tag == STABILITY_MILD {
        // High condition number → upgrade precision; otherwise rescale
        if r.condition_number > 1.0e12 {
            MITIGATION_UPGRADE_PRECISION
        } else {
            MITIGATION_RESCALING
        }
    } else if r.tag == STABILITY_SEVERE {
        // Overflow → rescaling; underflow → compensated algorithm
        if r.overflow_risk >= r.underflow_risk {
            MITIGATION_RESCALING
        } else {
            MITIGATION_COMPENSATED
        }
    } else {
        // Catastrophic cancellation → Kahan summation
        MITIGATION_KAHAN_SUMMATION
    }
}

// ============================================================================
// StabilityIssue helpers
// ============================================================================

fn stability_issue_new(risk: StabilityRisk) -> StabilityIssue {
    StabilityIssue {
        risk: risk,
        mitigation: stability_risk_mitigation(risk),
        severity: stability_risk_severity(risk),
    }
}

// ============================================================================
// StabilityAnalyzer
// ============================================================================

fn stability_analyzer_new(prec: i64) -> StabilityAnalyzer {
    StabilityAnalyzer {
        precision: prec,
        condition_threshold: 1.0e8,
        cancellation_threshold: 1.0e-6,
        issues: [stability_issue_new(stability_risk_stable()); 256],
        issue_count: 0,
        total_checks: 0,
        stable_count: 0,
        mild_count: 0,
        severe_count: 0,
        catastrophic_count: 0,
    }
}

fn stability_analyzer_record(sa: StabilityAnalyzer, risk: StabilityRisk) -> StabilityAnalyzer with Mut, Panic {
    // Append the issue and increment the appropriate per-level counter
    var out = sa
    let idx = out.issue_count
    if idx < 256 {
        out.issues[idx as usize] = stability_issue_new(risk)
        out.issue_count = idx + 1
    }
    out.total_checks = out.total_checks + 1
    if risk.tag == STABILITY_STABLE {
        out.stable_count = out.stable_count + 1
    } else if risk.tag == STABILITY_MILD {
        out.mild_count = out.mild_count + 1
    } else if risk.tag == STABILITY_SEVERE {
        out.severe_count = out.severe_count + 1
    } else {
        out.catastrophic_count = out.catastrophic_count + 1
    }
    out
}

fn stability_check_cancellation(sa: StabilityAnalyzer, x: f64, y: f64) -> (StabilityAnalyzer, StabilityRisk) with Div {
    // Detect catastrophic cancellation in x - y (or x + y with differing signs)
    // relative_diff = |x - y| / max(|x|, |y|)
    let ax = f64_abs(x)
    let ay = f64_abs(y)
    let denom = f64_max(ax, ay)

    if denom < 1e-300 {
        // Both near-zero: stable
        return (sa, stability_risk_stable())
    }

    let diff = f64_abs(x - y)
    let relative_diff = diff / denom

    var risk = stability_risk_stable()
    if relative_diff < sa.cancellation_threshold {
        // Catastrophic: nearly complete cancellation
        let severity = 1.0 - relative_diff * 1e6
        risk = stability_risk_catastrophic(f64_clamp(severity, 0.0, 1.0))
    } else if relative_diff < 0.01 {
        // Mild: significant cancellation
        let condition = 1.0 / relative_diff
        risk = stability_risk_mild(condition)
    }

    let sa2 = stability_analyzer_record(sa, risk)
    (sa2, risk)
}

fn stability_check_division(sa: StabilityAnalyzer, dividend: f64, divisor: f64) -> (StabilityAnalyzer, StabilityRisk) with Div {
    let abs_divisor = f64_abs(divisor)

    var risk = stability_risk_stable()

    if abs_divisor < 1e-300 {
        risk = stability_risk_catastrophic(1.0)
    } else if abs_divisor < 1e-10 {
        // Severe: near-zero divisor causes underflow risk
        let underflow_frac = 1.0 - abs_divisor * 1e10
        risk = stability_risk_severe(0.0, f64_clamp(underflow_frac, 0.0, 1.0))
    }
    // else: stable

    let sa2 = stability_analyzer_record(sa, risk)
    (sa2, risk)
}

fn stability_check_overflow(sa: StabilityAnalyzer, value: f64, prec: i64) -> (StabilityAnalyzer, StabilityRisk) {
    let abs_val = f64_abs(value)
    let max_val = precision_max_value(prec)

    var risk = stability_risk_stable()

    if abs_val > max_val {
        risk = stability_risk_severe(1.0, 0.0)
    } else if abs_val > max_val * 0.9 {
        risk = stability_risk_mild(10.0)
    }

    let sa2 = stability_analyzer_record(sa, risk)
    (sa2, risk)
}

fn stability_check_underflow(sa: StabilityAnalyzer, value: f64, prec: i64) -> (StabilityAnalyzer, StabilityRisk) {
    let abs_val = f64_abs(value)
    if abs_val == 0.0 {
        let sa2 = stability_analyzer_record(sa, stability_risk_stable())
        return (sa2, stability_risk_stable())
    }
    let min_n = precision_min_normal(prec)

    var risk = stability_risk_stable()

    if abs_val < min_n {
        risk = stability_risk_severe(0.0, 1.0)
    } else if abs_val < min_n * 10.0 {
        risk = stability_risk_mild(2.0)
    }

    let sa2 = stability_analyzer_record(sa, risk)
    (sa2, risk)
}

fn stability_check_condition(sa: StabilityAnalyzer, cond_num: f64) -> (StabilityAnalyzer, StabilityRisk) {
    let abs_cond = f64_abs(cond_num)

    var risk = stability_risk_stable()

    if abs_cond > 1e16 {
        risk = stability_risk_catastrophic(1.0)
    } else if abs_cond > sa.condition_threshold {
        risk = stability_risk_mild(abs_cond)
    }

    let sa2 = stability_analyzer_record(sa, risk)
    (sa2, risk)
}

fn stability_has_catastrophic(sa: StabilityAnalyzer) -> bool {
    sa.catastrophic_count > 0
}

fn stability_summary(sa: StabilityAnalyzer) -> StabilitySummary {
    // Determine the worst risk tag from counts
    var worst: i64 = STABILITY_STABLE
    if sa.mild_count > 0 {
        worst = STABILITY_MILD
    }
    if sa.severe_count > 0 {
        worst = STABILITY_SEVERE
    }
    if sa.catastrophic_count > 0 {
        worst = STABILITY_CATASTROPHIC
    }
    StabilitySummary {
        total_checks: sa.total_checks,
        stable: sa.stable_count,
        mild: sa.mild_count,
        severe: sa.severe_count,
        catastrophic: sa.catastrophic_count,
        worst_risk: worst,
    }
}

fn stability_summary_is_acceptable(s: StabilitySummary) -> bool {
    s.catastrophic == 0 && s.severe == 0
}

// ============================================================================
// ErrorPropagatorState — lightweight stateless-style propagator for GPU context
// ============================================================================

fn error_propagator_new(prec: i64, mode: i64) -> ErrorPropagatorState {
    ErrorPropagatorState {
        precision: prec,
        mode: mode,
        op_count: 0,
        max_epsilon_seen: 0.0,
    }
}

fn error_prop_update_max(ep: ErrorPropagatorState, bound: ErrorBound) -> ErrorPropagatorState {
    // Internal helper: update max_epsilon_seen and increment op_count
    var out = ep
    out.op_count = out.op_count + 1
    if bound.expected_error > out.max_epsilon_seen {
        out.max_epsilon_seen = bound.expected_error
    }
    out
}

fn error_prop_add(ep: ErrorPropagatorState, x: ErrorBound, y: ErrorBound) -> (ErrorPropagatorState, ErrorBound) {
    let result = error_bound_for_add(x, y, ep.precision)
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

fn error_prop_sub(ep: ErrorPropagatorState, x: ErrorBound, y: ErrorBound) -> (ErrorPropagatorState, ErrorBound) {
    // Subtraction has the same error propagation as addition,
    // but confidence is reduced slightly due to cancellation risk
    let base = error_bound_for_add(x, y, ep.precision)
    let result = ErrorBound {
        min_error: base.min_error,
        max_error: base.max_error,
        expected_error: base.expected_error,
        confidence: base.confidence * 0.95,
    }
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

fn error_prop_mul(ep: ErrorPropagatorState, x: ErrorBound, y: ErrorBound, x_val: f64, y_val: f64) -> (ErrorPropagatorState, ErrorBound) {
    let result = error_bound_for_mul(x, y, x_val, y_val, ep.precision)
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

fn error_prop_div(ep: ErrorPropagatorState, x: ErrorBound, y: ErrorBound, x_val: f64, y_val: f64) -> (ErrorPropagatorState, ErrorBound) with Div {
    let result = error_bound_for_div(x, y, x_val, y_val, ep.precision)
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

fn error_prop_sqrt(ep: ErrorPropagatorState, x: ErrorBound, x_val: f64) -> (ErrorPropagatorState, ErrorBound) with Div {
    let result = error_bound_for_sqrt(x, x_val)
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

fn error_prop_sum_n(ep: ErrorPropagatorState, bounds: [ErrorBound; 256], count: i64) -> (ErrorPropagatorState, ErrorBound) {
    // Sum error grows as sqrt(n) * avg_error (quadrature for uncorrelated errors)
    let machine_eps = precision_epsilon(ep.precision)
    let n_f = count as f64
    let sqrt_n = f64_sqrt(n_f)

    var sum_sq_exp: f64 = 0.0
    var sum_sq_max: f64 = 0.0
    var min_conf: f64 = 1.0
    var i: i64 = 0
    while i < count {
        let b = bounds[i as usize]
        sum_sq_exp = sum_sq_exp + b.expected_error * b.expected_error
        sum_sq_max = sum_sq_max + b.max_error * b.max_error
        if b.confidence < min_conf {
            min_conf = b.confidence
        }
        i = i + 1
    }

    let exp_err = f64_sqrt(sum_sq_exp)
    let max_err = f64_sqrt(sum_sq_max) + sqrt_n * machine_eps
    let min_err = exp_err * 0.1

    let result = ErrorBound {
        min_error: min_err,
        max_error: max_err,
        expected_error: exp_err,
        confidence: min_conf,
    }
    let ep2 = error_prop_update_max(ep, result)
    (ep2, result)
}

// ============================================================================
// PrecisionAdvisor
// ============================================================================

fn precision_advisor_new(default_prec: i64, tolerance: f64) -> PrecisionAdvisor {
    PrecisionAdvisor {
        default_precision: default_prec,
        error_tolerance: tolerance,
        recommended_precision: [0; 256],
        rec_count: 0,
    }
}

fn precision_advisor_recommend(pa: PrecisionAdvisor, error: ErrorBound, value_range: f64) -> (PrecisionAdvisor, i64) with Div {
    // relative = error.expected_error / max(|value_range|, 1e-300)
    let abs_range = f64_max(f64_abs(value_range), 1e-300)
    let relative = error.expected_error / abs_range

    var recommended: i64 = PRECISION_FP64

    if relative < precision_epsilon(PRECISION_FP8) {
        recommended = PRECISION_FP8
    } else if relative < precision_epsilon(PRECISION_FP16) {
        recommended = PRECISION_FP16
    } else if relative < precision_epsilon(PRECISION_FP32) {
        recommended = PRECISION_FP32
    }
    // else: FP64

    var out = pa
    let idx = out.rec_count
    if idx < 256 {
        out.recommended_precision[idx as usize] = recommended
        out.rec_count = idx + 1
    }
    (out, recommended)
}

fn precision_advisor_recommend_for_risk(pa: PrecisionAdvisor, risk: StabilityRisk) -> (PrecisionAdvisor, i64) {
    var recommended: i64 = PRECISION_FP32

    if risk.tag == STABILITY_STABLE {
        recommended = PRECISION_FP32
    } else if risk.tag == STABILITY_MILD {
        if risk.condition_number < 1.0e6 {
            recommended = PRECISION_FP32
        } else {
            recommended = PRECISION_FP64
        }
    } else {
        // Severe or Catastrophic
        recommended = PRECISION_FP64
    }

    var out = pa
    let idx = out.rec_count
    if idx < 256 {
        out.recommended_precision[idx as usize] = recommended
        out.rec_count = idx + 1
    }
    (out, recommended)
}

fn precision_advisor_is_quantization_safe(pa: PrecisionAdvisor, value_range: f64, error: ErrorBound) -> bool with Div {
    // quantization_error(FP8, value_range) < error.expected_error * 0.1
    let q_err = precision_quantization_error(PRECISION_FP8, value_range)
    q_err < error.expected_error * 0.1
}

// ============================================================================
// Integration with epistemic system
// ============================================================================
// These functions bridge numerical analysis → Knowledge<T> layers.
//
// Knowledge<T> has 4 layers:
//   T           — the computed value
//   epsilon     — uncertainty bound (f32)
//   validity    — boolean predicate (with confidence)
//   provenance  — data lineage bitmask

fn error_to_epistemic_epsilon(eb: ErrorBound) -> f32 {
    // Map an ErrorBound to the epsilon layer of Knowledge<T>
    // Use expected_error, clamped to [0, 1]
    let clamped = f64_clamp(eb.expected_error, 0.0, 1.0)
    clamped as f32
}

fn risk_to_validity_confidence(risk: StabilityRisk) -> f64 {
    // Map a StabilityRisk to a validity confidence in [0, 1]
    let severity = stability_risk_severity(risk)
    f64_clamp(1.0 - severity, 0.0, 1.0)
}

fn synthesize_numerical_provenance(stable: i64, mild: i64, severe: i64, catastrophic: i64) -> i64 {
    // Pack counts into a provenance bitmask using 4-bit nibbles:
    //   bits [0..3]   = stable count     (capped at 15)
    //   bits [4..7]   = mild count       (capped at 15)
    //   bits [8..11]  = severe count     (capped at 15)
    //   bits [12..15] = catastrophic count (capped at 15)
    let s = stable & 0xF
    let m = mild & 0xF
    let sv = severe & 0xF
    let c = catastrophic & 0xF
    s | (m * 16) | (sv * 256) | (c * 4096)
}

// ============================================================================
// Extended error propagation — full chain tracking (for non-GPU callers)
// ============================================================================

struct ErrorEvent {
    operation: [i8; 32],
    op_len: i64,
    input_error_0: ErrorBound,
    input_error_1: ErrorBound,
    output_error: ErrorBound,
    amplification: f64,
}

fn error_event_new() -> ErrorEvent {
    ErrorEvent {
        operation: [0; 32],
        op_len: 0,
        input_error_0: error_bound_zero(),
        input_error_1: error_bound_zero(),
        output_error: error_bound_zero(),
        amplification: 1.0,
    }
}

struct ErrorPropagator {
    precision: i64,
    mode: i64,
    history: [ErrorEvent; 1024],
    history_count: i64,
}

fn error_propagator_full_new(prec: i64, mode: i64) -> ErrorPropagator {
    ErrorPropagator {
        precision: prec,
        mode: mode,
        history: [error_event_new(); 1024],
        history_count: 0,
    }
}

fn error_propagator_make_event(
    c0: i8, c1: i8, c2: i8, c3: i8, name_len: i64,
    in0: ErrorBound, in1: ErrorBound, result: ErrorBound,
    amp: f64
) -> ErrorEvent with Mut, Panic {
    var ev = error_event_new()
    ev.operation[0] = c0
    ev.operation[1] = c1
    ev.operation[2] = c2
    ev.operation[3] = c3
    ev.op_len = name_len
    ev.input_error_0 = in0
    ev.input_error_1 = in1
    ev.output_error = result
    ev.amplification = amp
    ev
}

fn error_propagator_record(ep: ErrorPropagator, ev: ErrorEvent) -> ErrorPropagator with Mut, Panic {
    var out = ep
    let idx = out.history_count
    if idx < 1024 {
        out.history[idx as usize] = ev
        out.history_count = idx + 1
    }
    out
}

// ── Full-chain addition ──────────────────────────────────────────────

fn error_propagator_add(
    ep: ErrorPropagator,
    x: ErrorBound,
    y: ErrorBound
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let result = error_bound_for_add(x, y, ep.precision)
    let in_max = f64_max(x.max_error, y.max_error)
    var amp: f64 = 1.0
    if in_max > 1e-300 {
        amp = result.max_error / in_max
    }
    // 'a'=97 'd'=100 'd'=100 '\0'=0
    let ev = error_propagator_make_event(97, 100, 100, 0, 3, x, y, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ── Full-chain subtraction ───────────────────────────────────────────

fn error_propagator_sub(
    ep: ErrorPropagator,
    x: ErrorBound,
    y: ErrorBound
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let base = error_bound_for_add(x, y, ep.precision)
    let result = ErrorBound {
        min_error: base.min_error,
        max_error: base.max_error,
        expected_error: base.expected_error,
        confidence: base.confidence * 0.95,
    }
    let in_max = f64_max(x.max_error, y.max_error)
    var amp: f64 = 1.0
    if in_max > 1e-300 {
        amp = result.max_error / in_max
    }
    // 's'=115 'u'=117 'b'=98 '\0'=0
    let ev = error_propagator_make_event(115, 117, 98, 0, 3, x, y, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ── Full-chain multiplication ────────────────────────────────────────

fn error_propagator_mul(
    ep: ErrorPropagator,
    x: ErrorBound,
    y: ErrorBound,
    x_val: f64,
    y_val: f64
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let result = error_bound_for_mul(x, y, x_val, y_val, ep.precision)
    let in_max = f64_max(x.max_error, y.max_error)
    var amp: f64 = 1.0
    if in_max > 1e-300 {
        amp = result.max_error / in_max
    }
    // 'm'=109 'u'=117 'l'=108 '\0'=0
    let ev = error_propagator_make_event(109, 117, 108, 0, 3, x, y, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ── Full-chain division ──────────────────────────────────────────────

fn error_propagator_div(
    ep: ErrorPropagator,
    x: ErrorBound,
    y: ErrorBound,
    x_val: f64,
    y_val: f64
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let result = error_bound_for_div(x, y, x_val, y_val, ep.precision)
    let in_max = f64_max(x.max_error, y.max_error)
    var amp: f64 = 1.0
    if in_max > 1e-300 {
        amp = result.max_error / in_max
    }
    // 'd'=100 'i'=105 'v'=118 '\0'=0
    let ev = error_propagator_make_event(100, 105, 118, 0, 3, x, y, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ── Full-chain square root ───────────────────────────────────────────

fn error_propagator_sqrt(
    ep: ErrorPropagator,
    x: ErrorBound,
    x_val: f64
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let result = error_bound_for_sqrt(x, x_val)
    let zero_bound = error_bound_zero()
    var amp: f64 = 0.5
    if x.max_error > 1e-300 {
        amp = result.max_error / x.max_error
    }
    // 's'=115 'q'=113 'r'=114 't'=116
    let ev = error_propagator_make_event(115, 113, 114, 116, 4, x, zero_bound, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ── Full-chain summation (Kahan-aware) ───────────────────────────────

fn error_propagator_sum(
    ep: ErrorPropagator,
    bounds: [ErrorBound; 256],
    count: i64
) -> (ErrorPropagator, ErrorBound) with Mut, Panic {
    let machine_eps = precision_epsilon(ep.precision)
    let n_f = count as f64
    let sqrt_n = f64_sqrt(n_f)

    var sum_sq_exp: f64 = 0.0
    var sum_sq_max: f64 = 0.0
    var min_conf: f64 = 1.0
    var i: i64 = 0
    while i < count {
        let b = bounds[i as usize]
        sum_sq_exp = sum_sq_exp + b.expected_error * b.expected_error
        sum_sq_max = sum_sq_max + b.max_error * b.max_error
        if b.confidence < min_conf {
            min_conf = b.confidence
        }
        i = i + 1
    }

    let result = ErrorBound {
        min_error: f64_sqrt(sum_sq_exp) * 0.1,
        max_error: f64_sqrt(sum_sq_max) + sqrt_n * machine_eps,
        expected_error: f64_sqrt(sum_sq_exp),
        confidence: min_conf,
    }

    let zero_bound = error_bound_zero()
    var amp = sqrt_n
    if amp < 1.0 { amp = 1.0 }

    // 's'=115 'u'=117 'm'=109 '\0'=0
    let ev = error_propagator_make_event(115, 117, 109, 0, 3, zero_bound, zero_bound, result, amp)
    let ep2 = error_propagator_record(ep, ev)
    (ep2, result)
}

// ============================================================================
// Composite stability analysis helpers
// ============================================================================

fn analyze_dot_product_stability(
    sa: StabilityAnalyzer,
    values_a: [f64; 256],
    values_b: [f64; 256],
    count: i64
) -> (StabilityAnalyzer, StabilityRisk) with Mut, Panic, Div {
    // Detect catastrophic cancellation and overflow in a dot product.
    var out = sa
    var worst_risk = stability_risk_stable()
    var worst_severity: f64 = 0.0

    var dot_sum: f64 = 0.0
    var positive_sum: f64 = 0.0
    var negative_sum: f64 = 0.0

    var i: i64 = 0
    while i < count {
        let product = values_a[i as usize] * values_b[i as usize]
        dot_sum = dot_sum + product
        if product >= 0.0 {
            positive_sum = positive_sum + product
        } else {
            negative_sum = negative_sum - product
        }

        let pair = stability_check_overflow(out, product, out.precision)
        out = pair.0
        let prod_risk = pair.1
        let sev = stability_risk_severity(prod_risk)
        if sev > worst_severity {
            worst_severity = sev
            worst_risk = prod_risk
        }

        i = i + 1
    }

    let total_magnitude = positive_sum + negative_sum
    let abs_result = f64_abs(dot_sum)

    if total_magnitude > 1e-300 && abs_result < total_magnitude * out.cancellation_threshold {
        let cancellation_ratio = 1.0 - abs_result / total_magnitude
        let cancel_risk = stability_risk_catastrophic(f64_clamp(cancellation_ratio, 0.0, 1.0))
        let sev = stability_risk_severity(cancel_risk)
        if sev > worst_severity {
            worst_severity = sev
            worst_risk = cancel_risk
        }
        out = stability_analyzer_record(out, cancel_risk)
    }

    if abs_result > 1e-300 {
        let cond = total_magnitude / abs_result
        let pair2 = stability_check_condition(out, cond)
        out = pair2.0
        let cond_risk = pair2.1
        let sev2 = stability_risk_severity(cond_risk)
        if sev2 > worst_severity {
            worst_severity = sev2
            worst_risk = cond_risk
        }
    }

    (out, worst_risk)
}

fn analyze_polynomial_stability(
    sa: StabilityAnalyzer,
    coeffs: [f64; 256],
    degree: i64,
    x: f64
) -> (StabilityAnalyzer, StabilityRisk) with Mut, Panic, Div {
    // Analyze stability of polynomial evaluation via Horner's method.
    var out = sa
    var worst_risk = stability_risk_stable()
    var worst_severity: f64 = 0.0

    var result: f64 = 0.0
    if degree >= 0 {
        result = coeffs[degree as usize]
    }

    var i: i64 = degree - 1
    while i >= 0 {
        let prev = result
        result = result * x + coeffs[i as usize]

        let product_term = prev * x
        let pair = stability_check_cancellation(out, product_term, 0.0 - coeffs[i as usize])
        out = pair.0
        let step_risk = pair.1
        let sev = stability_risk_severity(step_risk)
        if sev > worst_severity {
            worst_severity = sev
            worst_risk = step_risk
        }

        let pair2 = stability_check_overflow(out, result, out.precision)
        out = pair2.0
        let ovf_risk = pair2.1
        let sev2 = stability_risk_severity(ovf_risk)
        if sev2 > worst_severity {
            worst_severity = sev2
            worst_risk = ovf_risk
        }

        i = i - 1
    }

    (out, worst_risk)
}

// ============================================================================
// Provenance synthesis from full propagation history
// ============================================================================

fn synthesize_provenance(
    history: [ErrorEvent; 1024],
    count: i64
) -> i64 with Mut, Panic {
    // XOR-fold of operation bytes across the propagation history.
    // Yields a fingerprint suitable for the provenance layer of Knowledge<T>.
    var hash: i64 = 0
    var i: i64 = 0
    while i < count {
        let ev = history[i as usize]
        var j: i64 = 0
        while j < ev.op_len {
            let byte = ev.operation[j as usize]
            let byte_i64 = byte as i64
            let rotated = (hash * 128) + (hash / 72057594037927936)
            hash = rotated ^ byte_i64
            j = j + 1
        }
        hash = hash ^ (i * 2654435761)
        i = i + 1
    }
    hash
}

// ============================================================================
// Full stability report
// ============================================================================

fn full_stability_report(
    sa: StabilityAnalyzer,
    ep: ErrorPropagator
) -> (StabilitySummary, f64, i64) with Mut, Panic {
    // Returns (StabilitySummary, overall_confidence, provenance_hash).
    let summary = stability_summary(sa)

    var overall_conf: f64 = 1.0
    var i: i64 = 0
    while i < ep.history_count {
        let ev = ep.history[i as usize]
        overall_conf = overall_conf * ev.output_error.confidence
        if overall_conf < 1e-300 {
            overall_conf = 1e-300
        }
        i = i + 1
    }

    let prov = synthesize_provenance(ep.history, ep.history_count)
    (summary, overall_conf, prov)
}
