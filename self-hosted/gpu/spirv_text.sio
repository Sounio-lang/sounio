}

// ============================================================================
// Name emission (OpName for debug info)
// ============================================================================

fn spvt_emit_name(w: SpvTextWriter, target_id: i64,
                  name: string) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpName ")
    out = spvt_push_id(out, target_id)
    out = spvt_push_str(out, " \"")
    out = spvt_push_str(out, name)
    out = spvt_push_str(out, "\"")
    out = spvt_push_newline(out)
    out
}

// ============================================================================
// Full module assembly
// ============================================================================

fn spvt_emit_module_header(w: SpvTextWriter,
                           m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "; SPIR-V Text (Sounio)")
    out = spvt_push_newline(out)
    out = spvt_push_str(out, "; Generator: Sounio Self-Hosted Compiler")
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_module_capabilities(w: SpvTextWriter,
                                 m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < m.cap_count {
        out = spvt_emit_capability(out, m.capabilities[i as usize])
        i = i + 1
    }
    out
}

fn spvt_emit_module_memory_model(w: SpvTextWriter,
                                 m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    spvt_emit_memory_model(w, m.addr_model, m.mem_model)
}

fn spvt_emit_module_entry_points(w: SpvTextWriter,
                                 m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < m.entry_count {
        let ep = m.entry_points[i as usize]
        out = spvt_emit_entry_point(out, ep.exec_model, ep.func_id,
                                    "main", ep.interface_ids,
                                    ep.interface_count)
        i = i + 1
    }
    out
}

fn spvt_emit_module_decorations(w: SpvTextWriter,
                                m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < m.dec_count {
        let d = m.decorations[i as usize]
        out = spvt_emit_decorate(out, d.target_id, d.decoration, d.value)
        i = i + 1
    }
    out
}

fn spvt_emit_module_types(w: SpvTextWriter,
                          m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < m.type_count {
        let td = m.types[i as usize]
        if td.opcode == SPVT_OP_TYPE_VOID {
            out = spvt_emit_type_void(out, td.result_id)
        } else if td.opcode == SPVT_OP_TYPE_BOOL {
            out = spvt_emit_type_bool(out, td.result_id)
        } else if td.opcode == SPVT_OP_TYPE_INT {
            out = spvt_emit_type_int(out, td.result_id,
                                     td.operands[0 as usize],
                                     td.operands[1 as usize])
        } else if td.opcode == SPVT_OP_TYPE_FLOAT {
            out = spvt_emit_type_float(out, td.result_id,
                                       td.operands[0 as usize])
        } else if td.opcode == SPVT_OP_TYPE_VECTOR {
            out = spvt_emit_type_vector(out, td.result_id,
                                        td.operands[0 as usize],
                                        td.operands[1 as usize])
        } else if td.opcode == SPVT_OP_TYPE_MATRIX {
            out = spvt_emit_type_matrix(out, td.result_id,
                                        td.operands[0 as usize],
                                        td.operands[1 as usize])
        } else if td.opcode == SPVT_OP_TYPE_POINTER {
            out = spvt_emit_type_pointer(out, td.result_id,
                                         td.operands[0 as usize],
                                         td.operands[1 as usize])
        } else if td.opcode == SPVT_OP_TYPE_FUNCTION {
            let params: [i64; 16] = [0; 16]
            out = spvt_emit_type_function(out, td.result_id,
                                          td.operands[0 as usize],
                                          params, 0)
        } else if td.opcode == SPVT_OP_TYPE_ARRAY {
            out = spvt_emit_type_array(out, td.result_id,
                                       td.operands[0 as usize],
                                       td.operands[1 as usize])
        } else if td.opcode == SPVT_OP_TYPE_STRUCT {
            let members: [i64; 8] = [0; 8]
            out = spvt_emit_type_struct(out, td.result_id,
                                        members, td.operand_count)
        }
        i = i + 1
    }
    out
}

fn spvt_emit_module_globals(w: SpvTextWriter,
                            m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < m.global_count {
        let g = m.globals[i as usize]
        out = spvt_emit_variable(out, g.var_id, g.type_id, g.storage_class)
        i = i + 1
    }
    out
}

fn spvt_emit_module_functions(w: SpvTextWriter,
                              m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var fi: i64 = 0
    while fi < m.func_count {
        let f = m.functions[fi as usize]
        // Emit OpFunction header
        // Use func_type_id = return_type_id for simplicity (would normally
        // be looked up from the module type section)
        out = spvt_emit_function(out, f.func_id, f.return_type_id,
                                 SPVT_FUNC_CTRL_NONE, f.return_type_id)

        // Emit parameters
        var pi: i64 = 0
        while pi < f.param_count {
            let param_id = f.func_id + 1 + pi
            out = spvt_emit_function_parameter(out, param_id,
                                               f.param_type_ids[pi as usize])
            pi = pi + 1
        }

        // Emit blocks
        var bi: i64 = 0
        while bi < f.block_count {
            let block = f.blocks[bi as usize]
            out = spvt_emit_label(out, block.label_id)
            bi = bi + 1
        }

        // If no blocks, emit a default label + return
        if f.block_count == 0 {
            out = spvt_emit_label(out, f.func_id + 100)
            out = spvt_emit_return(out)
        }

        out = spvt_emit_function_end(out)
        fi = fi + 1
    }
    out
}

fn spvt_assemble_module(m: SpvTextModule) -> SpvTextWriter with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_emit_module_header(w, m)
    w = spvt_emit_module_capabilities(w, m)
    w = spvt_emit_module_memory_model(w, m)
    w = spvt_emit_module_entry_points(w, m)
    w = spvt_emit_module_decorations(w, m)
    w = spvt_emit_module_types(w, m)
    w = spvt_emit_module_globals(w, m)
    w = spvt_emit_module_functions(w, m)
    w
}

// ============================================================================
// Convenience: build a minimal compute shader module
// ============================================================================

fn spvt_build_minimal_compute() -> SpvTextModule with Mut, Panic {
    var m = spvt_module_new()
    m = spvt_module_add_cap(m, SPVT_CAP_SHADER)
    m.addr_model = SPVT_ADDR_LOGICAL
    m.mem_model = SPVT_MEM_GLSL450

    // void type -> id 1
    var td_void = spvt_type_decl_new()
    td_void.opcode = SPVT_OP_TYPE_VOID
    td_void.result_id = 1
    m = spvt_module_add_type(m, td_void)

    // function type void() -> id 2
    var td_func = spvt_type_decl_new()
    td_func.opcode = SPVT_OP_TYPE_FUNCTION
    td_func.result_id = 2
    td_func.operands[0 as usize] = 1   // return type = void
    td_func.operand_count = 1
    m = spvt_module_add_type(m, td_func)

    // main function -> id 3
    let f = spvt_func_new(3, 1)
    m = spvt_module_add_func(m, f)

    // entry point
    var ep = spvt_entry_point_new()
    ep.exec_model = SPVT_EXEC_GLCOMPUTE
    ep.func_id = 3
    m = spvt_module_add_entry(m, ep)

    m
}

// ============================================================================
// Convenience: build a compute shader with types and arithmetic
// ============================================================================

fn spvt_build_arith_compute() -> SpvTextModule with Mut, Panic {
    var m = spvt_module_new()
    m = spvt_module_add_cap(m, SPVT_CAP_SHADER)
    m.addr_model = SPVT_ADDR_LOGICAL
    m.mem_model = SPVT_MEM_GLSL450

    // void type -> id 1
    var td_void = spvt_type_decl_new()
    td_void.opcode = SPVT_OP_TYPE_VOID
    td_void.result_id = 1
    m = spvt_module_add_type(m, td_void)

    // float32 type -> id 2
    var td_f32 = spvt_type_decl_new()
    td_f32.opcode = SPVT_OP_TYPE_FLOAT
    td_f32.result_id = 2
    td_f32.operands[0 as usize] = 32
    td_f32.operand_count = 1
    m = spvt_module_add_type(m, td_f32)

    // uint32 type -> id 3
    var td_u32 = spvt_type_decl_new()
    td_u32.opcode = SPVT_OP_TYPE_INT
    td_u32.result_id = 3
    td_u32.operands[0 as usize] = 32
    td_u32.operands[1 as usize] = 0
    td_u32.operand_count = 2
    m = spvt_module_add_type(m, td_u32)

    // function type void() -> id 4
    var td_func = spvt_type_decl_new()
    td_func.opcode = SPVT_OP_TYPE_FUNCTION
    td_func.result_id = 4
    td_func.operands[0 as usize] = 1   // return type = void
    td_func.operand_count = 1
    m = spvt_module_add_type(m, td_func)

    // main function -> id 5
    let f = spvt_func_new(5, 1)
    m = spvt_module_add_func(m, f)

    // entry point
    var ep = spvt_entry_point_new()
    ep.exec_model = SPVT_EXEC_GLCOMPUTE
    ep.func_id = 5
    m = spvt_module_add_entry(m, ep)

    // decoration: binding
    var dec = spvt_decoration_new()
    dec.target_id = 10
    dec.decoration = SPVT_DEC_BINDING
    dec.value = 0
    m = spvt_module_add_decoration(m, dec)

    m
}

