// Control flow emission
// ============================================================================

fn spvt_emit_branch(w: SpvTextWriter, target_id: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpBranch ")
    out = spvt_push_id(out, target_id)
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_branch_conditional(w: SpvTextWriter, cond_id: i64,
                                true_id: i64,
                                false_id: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpBranchConditional ")
    out = spvt_push_id(out, cond_id)
    out = spvt_push_space(out)
    out = spvt_push_id(out, true_id)
    out = spvt_push_space(out)
    out = spvt_push_id(out, false_id)
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_switch(w: SpvTextWriter, selector_id: i64,
                    default_id: i64, cases: [i64; 8],
                    targets: [i64; 8],
                    case_count: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpSwitch ")
    out = spvt_push_id(out, selector_id)
    out = spvt_push_space(out)
    out = spvt_push_id(out, default_id)

    var i: i64 = 0
    while i < case_count {
        out = spvt_push_space(out)
        out = spvt_push_i64(out, cases[i as usize])
        out = spvt_push_space(out)
        out = spvt_push_id(out, targets[i as usize])
        i = i + 1
    }
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_phi(w: SpvTextWriter, id: i64, type_id: i64,
                 values: [i64; 8], parents: [i64; 8],
                 pair_count: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_id(out, id)
    out = spvt_push_str(out, " = OpPhi ")
    out = spvt_push_id(out, type_id)

    var i: i64 = 0
    while i < pair_count {
        out = spvt_push_space(out)
        out = spvt_push_id(out, values[i as usize])
        out = spvt_push_space(out)
        out = spvt_push_id(out, parents[i as usize])
        i = i + 1
    }
    out = spvt_push_newline(out)
    out
}

