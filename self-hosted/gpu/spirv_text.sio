    var i = spvt_instr_with_op(SPVT_OP_FADD)
    i = spvt_instr_add_operand(i, 10)
    i = spvt_instr_add_operand(i, 20)
    i.operand_count == 2 &&
    i.operands[0 as usize] == 10 &&
    i.operands[1 as usize] == 20
}

