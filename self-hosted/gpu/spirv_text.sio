// self-hosted::gpu::spirv_text — SPIR-V text format emitter
//
// Emits SPIR-V assembly in human-readable text form (like spirv-dis output).
// Complementary to spirv.sio which emits binary words; this module produces
// readable text suitable for debugging, testing, and round-tripping through
// spirv-as.
//
// Text format example:
//   OpCapability Shader
//   OpMemoryModel Logical GLSL450
//   OpEntryPoint GLCompute %main "main" %gl_GlobalInvocationID
//   %void = OpTypeVoid
//   %uint = OpTypeInt 32 0
//   %func_void = OpTypeFunction %void
//   %main = OpFunction %void None %func_void
//   %entry = OpLabel
//   OpReturn
//   OpFunctionEnd

// ============================================================================
// SPIR-V text opcode constants (string names for text output)
// ============================================================================

let SPVT_OP_CAPABILITY: i64       = 1
let SPVT_OP_MEMORY_MODEL: i64    = 2
let SPVT_OP_ENTRY_POINT: i64     = 3
let SPVT_OP_EXECUTION_MODE: i64  = 4
let SPVT_OP_TYPE_VOID: i64       = 5
let SPVT_OP_TYPE_INT: i64        = 6
let SPVT_OP_TYPE_FLOAT: i64      = 7
let SPVT_OP_TYPE_VECTOR: i64     = 8
let SPVT_OP_TYPE_MATRIX: i64     = 9
let SPVT_OP_TYPE_POINTER: i64    = 10
let SPVT_OP_TYPE_FUNCTION: i64   = 11
let SPVT_OP_TYPE_ARRAY: i64      = 12
let SPVT_OP_TYPE_STRUCT: i64     = 13
let SPVT_OP_CONSTANT: i64        = 14
let SPVT_OP_CONSTANT_TRUE: i64   = 15
let SPVT_OP_CONSTANT_FALSE: i64  = 16
let SPVT_OP_CONSTANT_COMPOSITE: i64 = 17
let SPVT_OP_FUNCTION: i64        = 18
let SPVT_OP_FUNCTION_PARAM: i64  = 19
let SPVT_OP_FUNCTION_END: i64    = 20
let SPVT_OP_LABEL: i64           = 21
let SPVT_OP_RETURN: i64          = 22
let SPVT_OP_RETURN_VALUE: i64    = 23
let SPVT_OP_FADD: i64            = 24
let SPVT_OP_FSUB: i64            = 25
let SPVT_OP_FMUL: i64            = 26
let SPVT_OP_FDIV: i64            = 27
let SPVT_OP_IADD: i64            = 28
let SPVT_OP_ISUB: i64            = 29
let SPVT_OP_IMUL: i64            = 30
let SPVT_OP_SDIV: i64            = 31
let SPVT_OP_VARIABLE: i64        = 32
let SPVT_OP_LOAD: i64            = 33
let SPVT_OP_STORE: i64           = 34
let SPVT_OP_ACCESS_CHAIN: i64    = 35
let SPVT_OP_BRANCH: i64          = 36
let SPVT_OP_BRANCH_COND: i64     = 37
let SPVT_OP_SWITCH: i64          = 38
let SPVT_OP_PHI: i64             = 39
let SPVT_OP_SEL_MERGE: i64       = 40
let SPVT_OP_LOOP_MERGE: i64      = 41
let SPVT_OP_DECORATE: i64        = 42
let SPVT_OP_NAME: i64            = 43
let SPVT_OP_TYPE_BOOL: i64       = 44

// Capability values
let SPVT_CAP_SHADER: i64  = 1
let SPVT_CAP_KERNEL: i64  = 6

// Addressing model
let SPVT_ADDR_LOGICAL: i64 = 0

// Memory model
let SPVT_MEM_GLSL450: i64  = 1
let SPVT_MEM_OPENCL: i64   = 2

// Execution model
let SPVT_EXEC_VERTEX: i64     = 0
let SPVT_EXEC_FRAGMENT: i64   = 4
let SPVT_EXEC_GLCOMPUTE: i64  = 5

// Storage class
let SPVT_SC_INPUT: i64           = 1
let SPVT_SC_UNIFORM: i64         = 2
let SPVT_SC_OUTPUT: i64          = 3
let SPVT_SC_WORKGROUP: i64       = 4
let SPVT_SC_PRIVATE: i64         = 6
let SPVT_SC_FUNCTION: i64        = 7
let SPVT_SC_STORAGE_BUFFER: i64  = 12

// Function control
let SPVT_FUNC_CTRL_NONE: i64     = 0
let SPVT_FUNC_CTRL_INLINE: i64   = 1
let SPVT_FUNC_CTRL_NOINLINE: i64 = 2

// Decoration values
let SPVT_DEC_BUILTIN: i64        = 11
let SPVT_DEC_LOCATION: i64       = 30
let SPVT_DEC_BINDING: i64        = 33
let SPVT_DEC_DESC_SET: i64       = 34

// Selection/loop merge control
let SPVT_SEL_CTRL_NONE: i64  = 0
let SPVT_LOOP_CTRL_NONE: i64 = 0

// ============================================================================
// SpvTextInstr — one SPIR-V instruction in text form
// ============================================================================

struct SpvTextInstr {
    opcode: i64,
    result_id: i64,
    type_id: i64,
    operands: [i64; 8],
    operand_count: i64,
    has_result: bool,
}

fn spvt_instr_new() -> SpvTextInstr {
    SpvTextInstr {
        opcode: 0,
        result_id: 0,
        type_id: 0,
        operands: [0; 8],
        operand_count: 0,
        has_result: false,
    }
}

fn spvt_instr_with_op(opcode: i64) -> SpvTextInstr {
    SpvTextInstr {
        opcode: opcode,
        result_id: 0,
        type_id: 0,
        operands: [0; 8],
        operand_count: 0,
        has_result: false,
    }
}

fn spvt_instr_with_result(opcode: i64, result_id: i64, type_id: i64) -> SpvTextInstr {
    SpvTextInstr {
        opcode: opcode,
        result_id: result_id,
        type_id: type_id,
        operands: [0; 8],
        operand_count: 0,
        has_result: true,
    }
}

fn spvt_instr_add_operand(instr: SpvTextInstr, op: i64) -> SpvTextInstr with Mut, Panic {
    var out = instr
    if out.operand_count < 8 {
        out.operands[out.operand_count as usize] = op
        out.operand_count = out.operand_count + 1
    }
    out
}

// ============================================================================
// SpvTextBlock — a basic block of instruction indices
// ============================================================================

struct SpvTextBlock {
    label_id: i64,
    instrs: [i64; 256],
    instr_count: i64,
}

fn spvt_block_new(label_id: i64) -> SpvTextBlock {
    SpvTextBlock {
        label_id: label_id,
        instrs: [0; 256],
        instr_count: 0,
    }
}

fn spvt_block_add_instr(block: SpvTextBlock, instr_idx: i64) -> SpvTextBlock with Mut, Panic {
    var out = block
    if out.instr_count < 256 {
        out.instrs[out.instr_count as usize] = instr_idx
        out.instr_count = out.instr_count + 1
    }
    out
}

// ============================================================================
// SpvTextFunc — a function
// ============================================================================

struct SpvTextFunc {
    func_id: i64,
    return_type_id: i64,
    param_type_ids: [i64; 16],
    param_count: i64,
    blocks: [SpvTextBlock; 64],
    block_count: i64,
    name_hash: i64,
}

fn spvt_func_new(func_id: i64, return_type_id: i64) -> SpvTextFunc {
    SpvTextFunc {
        func_id: func_id,
        return_type_id: return_type_id,
        param_type_ids: [0; 16],
        param_count: 0,
        blocks: [spvt_block_new(0); 64],
        block_count: 0,
        name_hash: 0,
    }
}

fn spvt_func_add_param(func: SpvTextFunc, type_id: i64) -> SpvTextFunc with Mut, Panic {
    var out = func
    if out.param_count < 16 {
        out.param_type_ids[out.param_count as usize] = type_id
        out.param_count = out.param_count + 1
    }
    out
}

fn spvt_func_add_block(func: SpvTextFunc, block: SpvTextBlock) -> SpvTextFunc with Mut, Panic {
    var out = func
    if out.block_count < 64 {
        out.blocks[out.block_count as usize] = block
        out.block_count = out.block_count + 1
    }
    out
}

// ============================================================================
// SpvTextModule — full SPIR-V module in text representation
// ============================================================================

struct SpvTextDecoration {
    target_id: i64,
    decoration: i64,
    value: i64,
}

fn spvt_decoration_new() -> SpvTextDecoration {
    SpvTextDecoration { target_id: 0, decoration: 0, value: 0 }
}

struct SpvTextEntryPoint {
    exec_model: i64,
    func_id: i64,
    name_hash: i64,
    interface_ids: [i64; 8],
    interface_count: i64,
}

fn spvt_entry_point_new() -> SpvTextEntryPoint {
    SpvTextEntryPoint {
        exec_model: 0,
        func_id: 0,
        name_hash: 0,
        interface_ids: [0; 8],
        interface_count: 0,
    }
}

struct SpvTextTypeDecl {
    opcode: i64,
    result_id: i64,
    operands: [i64; 8],
    operand_count: i64,
}

fn spvt_type_decl_new() -> SpvTextTypeDecl {
    SpvTextTypeDecl {
        opcode: 0,
        result_id: 0,
        operands: [0; 8],
        operand_count: 0,
    }
}

struct SpvTextGlobal {
    var_id: i64,
    type_id: i64,
    storage_class: i64,
}

fn spvt_global_new() -> SpvTextGlobal {
    SpvTextGlobal { var_id: 0, type_id: 0, storage_class: 0 }
}

struct SpvTextModule {
    capabilities: [i64; 8],
    cap_count: i64,
    addr_model: i64,
    mem_model: i64,
    entry_points: [SpvTextEntryPoint; 8],
    entry_count: i64,
    types: [SpvTextTypeDecl; 128],
    type_count: i64,
    globals: [SpvTextGlobal; 64],
    global_count: i64,
    functions: [SpvTextFunc; 32],
    func_count: i64,
    decorations: [SpvTextDecoration; 64],
    dec_count: i64,
}

fn spvt_module_new() -> SpvTextModule {
    SpvTextModule {
        capabilities: [0; 8],
        cap_count: 0,
        addr_model: SPVT_ADDR_LOGICAL,
        mem_model: SPVT_MEM_GLSL450,
        entry_points: [spvt_entry_point_new(); 8],
        entry_count: 0,
        types: [spvt_type_decl_new(); 128],
        type_count: 0,
        globals: [spvt_global_new(); 64],
        global_count: 0,
        functions: [spvt_func_new(0, 0); 32],
        func_count: 0,
        decorations: [spvt_decoration_new(); 64],
        dec_count: 0,
    }
}

fn spvt_module_add_cap(m: SpvTextModule, cap: i64) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.cap_count < 8 {
        out.capabilities[out.cap_count as usize] = cap
        out.cap_count = out.cap_count + 1
    }
    out
}

fn spvt_module_add_entry(m: SpvTextModule, ep: SpvTextEntryPoint) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.entry_count < 8 {
        out.entry_points[out.entry_count as usize] = ep
        out.entry_count = out.entry_count + 1
    }
    out
}

fn spvt_module_add_type(m: SpvTextModule, td: SpvTextTypeDecl) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.type_count < 128 {
        out.types[out.type_count as usize] = td
        out.type_count = out.type_count + 1
    }
    out
}

fn spvt_module_add_global(m: SpvTextModule, g: SpvTextGlobal) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.global_count < 64 {
        out.globals[out.global_count as usize] = g
        out.global_count = out.global_count + 1
    }
    out
}

fn spvt_module_add_func(m: SpvTextModule, f: SpvTextFunc) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.func_count < 32 {
        out.functions[out.func_count as usize] = f
        out.func_count = out.func_count + 1
    }
    out
}

fn spvt_module_add_decoration(m: SpvTextModule, d: SpvTextDecoration) -> SpvTextModule with Mut, Panic {
    var out = m
    if out.dec_count < 64 {
        out.decorations[out.dec_count as usize] = d
        out.dec_count = out.dec_count + 1
    }
    out
}

// ============================================================================
// SpvTextWriter — text output buffer
// ============================================================================

struct SpvTextWriter {
    data: [i8; 65536],
    len: i64,
    indent: i64,
}

fn spvt_writer_new() -> SpvTextWriter {
    SpvTextWriter { data: [0; 65536], len: 0, indent: 0 }
}

fn spvt_push_byte(w: SpvTextWriter, b: i8) -> SpvTextWriter with Mut, Panic {
    var out = w
    if out.len < 65536 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

fn spvt_push_str(w: SpvTextWriter, s: string) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

fn spvt_push_newline(w: SpvTextWriter) -> SpvTextWriter with Mut, Panic {
    spvt_push_byte(w, 10)
}

fn spvt_push_space(w: SpvTextWriter) -> SpvTextWriter with Mut, Panic {
    spvt_push_byte(w, 32)
}

fn spvt_push_indent(w: SpvTextWriter) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    var i: i64 = 0
    while i < out.indent {
        out = spvt_push_str(out, "  ")
        i = i + 1
    }
    out
}

fn spvt_push_i64(w: SpvTextWriter, n: i64) -> SpvTextWriter with Mut, Panic, Div {
    if n < 0 {
        return spvt_push_str(w, "0")
    }
    if n == 0 { return spvt_push_str(w, "0") }

    var digits: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = (48 + digit) as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var out = w
    var i: i64 = 0
    while i < rev_len {
        out = spvt_push_byte(out, digits[(rev_len - i - 1) as usize])
        i = i + 1
    }
    out
}

fn spvt_push_id(w: SpvTextWriter, id: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_byte(out, 37)   // '%'
    out = spvt_push_i64(out, id)
    out
}

fn spvt_writer_contains(w: SpvTextWriter, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if w.len < nlen { return false }

    var i: i64 = 0
    while i <= (w.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if w.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn spvt_to_string(w: SpvTextWriter) -> string with Mut, Panic, Div {
    str_from_bytes(w.data, w.len)
}

// ============================================================================
// SpvTextCtx — emitter context
// ============================================================================

struct SpvTextTypeCacheEntry {
    tag: i64,
    id: i64,
}

fn spvt_cache_entry_new() -> SpvTextTypeCacheEntry {
    SpvTextTypeCacheEntry { tag: 0, id: 0 }
}

struct SpvTextTypeCache {
    entries: [SpvTextTypeCacheEntry; 64],
    count: i64,
}

fn spvt_type_cache_new() -> SpvTextTypeCache {
    SpvTextTypeCache {
        entries: [spvt_cache_entry_new(); 64],
        count: 0,
    }
}

struct SpvTextCtx {
    module: SpvTextModule,
    writer: SpvTextWriter,
    next_id: i64,
    type_cache: SpvTextTypeCache,
}

fn spvt_ctx_new() -> SpvTextCtx {
    SpvTextCtx {
        module: spvt_module_new(),
        writer: spvt_writer_new(),
        next_id: 1,
        type_cache: spvt_type_cache_new(),
    }
}

fn spvt_alloc_id(ctx: SpvTextCtx) -> SpvTextCtx with Mut {
    var out = ctx
    out.next_id = out.next_id + 1
    out
}

fn spvt_current_id(ctx: SpvTextCtx) -> i64 {
    ctx.next_id
}

fn spvt_cache_type(ctx: SpvTextCtx, tag: i64, id: i64) -> SpvTextCtx with Mut, Panic {
    var out = ctx
    if out.type_cache.count < 64 {
        out.type_cache.entries[out.type_cache.count as usize] = SpvTextTypeCacheEntry { tag: tag, id: id }
        out.type_cache.count = out.type_cache.count + 1
    }
    out
}

fn spvt_lookup_type(ctx: SpvTextCtx, tag: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ctx.type_cache.count {
        if ctx.type_cache.entries[i as usize].tag == tag {
            return ctx.type_cache.entries[i as usize].id
        }
        i = i + 1
    }
    0
}

// ============================================================================
// Opcode name lookup
// ============================================================================

fn spvt_opcode_name(op: i64) -> string {
    if op == SPVT_OP_CAPABILITY      { return "OpCapability" }
    if op == SPVT_OP_MEMORY_MODEL    { return "OpMemoryModel" }
    if op == SPVT_OP_ENTRY_POINT     { return "OpEntryPoint" }
    if op == SPVT_OP_EXECUTION_MODE  { return "OpExecutionMode" }
    if op == SPVT_OP_TYPE_VOID       { return "OpTypeVoid" }
    if op == SPVT_OP_TYPE_INT        { return "OpTypeInt" }
    if op == SPVT_OP_TYPE_FLOAT      { return "OpTypeFloat" }
    if op == SPVT_OP_TYPE_VECTOR     { return "OpTypeVector" }
    if op == SPVT_OP_TYPE_MATRIX     { return "OpTypeMatrix" }
    if op == SPVT_OP_TYPE_POINTER    { return "OpTypePointer" }
    if op == SPVT_OP_TYPE_FUNCTION   { return "OpTypeFunction" }
    if op == SPVT_OP_TYPE_ARRAY      { return "OpTypeArray" }
    if op == SPVT_OP_TYPE_STRUCT     { return "OpTypeStruct" }
    if op == SPVT_OP_TYPE_BOOL       { return "OpTypeBool" }
    if op == SPVT_OP_CONSTANT        { return "OpConstant" }
    if op == SPVT_OP_CONSTANT_TRUE   { return "OpConstantTrue" }
    if op == SPVT_OP_CONSTANT_FALSE  { return "OpConstantFalse" }
    if op == SPVT_OP_CONSTANT_COMPOSITE { return "OpConstantComposite" }
    if op == SPVT_OP_FUNCTION        { return "OpFunction" }
    if op == SPVT_OP_FUNCTION_PARAM  { return "OpFunctionParameter" }
    if op == SPVT_OP_FUNCTION_END    { return "OpFunctionEnd" }
    if op == SPVT_OP_LABEL           { return "OpLabel" }
    if op == SPVT_OP_RETURN          { return "OpReturn" }
    if op == SPVT_OP_RETURN_VALUE    { return "OpReturnValue" }
    if op == SPVT_OP_FADD            { return "OpFAdd" }
    if op == SPVT_OP_FSUB            { return "OpFSub" }
    if op == SPVT_OP_FMUL            { return "OpFMul" }
    if op == SPVT_OP_FDIV            { return "OpFDiv" }
    if op == SPVT_OP_IADD            { return "OpIAdd" }
    if op == SPVT_OP_ISUB            { return "OpISub" }
    if op == SPVT_OP_IMUL            { return "OpIMul" }
    if op == SPVT_OP_SDIV            { return "OpSDiv" }
    if op == SPVT_OP_VARIABLE        { return "OpVariable" }
    if op == SPVT_OP_LOAD            { return "OpLoad" }
    if op == SPVT_OP_STORE           { return "OpStore" }
    if op == SPVT_OP_ACCESS_CHAIN    { return "OpAccessChain" }
    if op == SPVT_OP_BRANCH          { return "OpBranch" }
    if op == SPVT_OP_BRANCH_COND     { return "OpBranchConditional" }
    if op == SPVT_OP_SWITCH          { return "OpSwitch" }
    if op == SPVT_OP_PHI             { return "OpPhi" }
    if op == SPVT_OP_SEL_MERGE       { return "OpSelectionMerge" }
    if op == SPVT_OP_LOOP_MERGE      { return "OpLoopMerge" }
    if op == SPVT_OP_DECORATE        { return "OpDecorate" }
    if op == SPVT_OP_NAME            { return "OpName" }
    return "OpUnknown"
}

// ============================================================================
// Capability name lookup
// ============================================================================

fn spvt_cap_name(cap: i64) -> string {
    if cap == SPVT_CAP_SHADER { return "Shader" }
    if cap == SPVT_CAP_KERNEL { return "Kernel" }
    return "Unknown"
}

// ============================================================================
// Memory model name lookup
// ============================================================================

fn spvt_mem_model_name(m: i64) -> string {
    if m == SPVT_MEM_GLSL450 { return "GLSL450" }
    if m == SPVT_MEM_OPENCL  { return "OpenCL" }
    return "Unknown"
}

// ============================================================================
// Addressing model name lookup
// ============================================================================

fn spvt_addr_model_name(a: i64) -> string {
    if a == SPVT_ADDR_LOGICAL { return "Logical" }
    return "Physical"
}

// ============================================================================
// Execution model name lookup
// ============================================================================

fn spvt_exec_model_name(e: i64) -> string {
    if e == SPVT_EXEC_VERTEX     { return "Vertex" }
    if e == SPVT_EXEC_FRAGMENT   { return "Fragment" }
    if e == SPVT_EXEC_GLCOMPUTE  { return "GLCompute" }
    return "Unknown"
}

// ============================================================================
// Storage class name lookup
// ============================================================================

fn spvt_storage_class_name(sc: i64) -> string {
    if sc == SPVT_SC_INPUT          { return "Input" }
    if sc == SPVT_SC_UNIFORM        { return "Uniform" }
    if sc == SPVT_SC_OUTPUT         { return "Output" }
    if sc == SPVT_SC_WORKGROUP      { return "Workgroup" }
    if sc == SPVT_SC_PRIVATE        { return "Private" }
    if sc == SPVT_SC_FUNCTION       { return "Function" }
    if sc == SPVT_SC_STORAGE_BUFFER { return "StorageBuffer" }
    return "Unknown"
}

// ============================================================================
// Decoration name lookup
// ============================================================================

fn spvt_decoration_name(d: i64) -> string {
    if d == SPVT_DEC_BUILTIN  { return "BuiltIn" }
    if d == SPVT_DEC_LOCATION { return "Location" }
    if d == SPVT_DEC_BINDING  { return "Binding" }
    if d == SPVT_DEC_DESC_SET { return "DescriptorSet" }
    return "Unknown"
}

// ============================================================================
// Function control name lookup
// ============================================================================

fn spvt_func_ctrl_name(fc: i64) -> string {
    if fc == SPVT_FUNC_CTRL_NONE     { return "None" }
    if fc == SPVT_FUNC_CTRL_INLINE   { return "Inline" }
    if fc == SPVT_FUNC_CTRL_NOINLINE { return "DontInline" }
    return "None"
}

// ============================================================================
// Capability emission
// ============================================================================

fn spvt_emit_capability(w: SpvTextWriter, cap: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpCapability ")
    out = spvt_push_str(out, spvt_cap_name(cap))
    out = spvt_push_newline(out)
    out
}

// ============================================================================
// Memory model emission
// ============================================================================

fn spvt_emit_memory_model(w: SpvTextWriter, addr: i64, mem: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpMemoryModel ")
    out = spvt_push_str(out, spvt_addr_model_name(addr))
    out = spvt_push_space(out)
    out = spvt_push_str(out, spvt_mem_model_name(mem))
    out = spvt_push_newline(out)
    out
}

// ============================================================================
// Entry point emission
// ============================================================================

fn spvt_emit_entry_point(w: SpvTextWriter, exec_model: i64, func_id: i64,
                         name: string, iface_ids: [i64; 8],
                         iface_count: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpEntryPoint ")
    out = spvt_push_str(out, spvt_exec_model_name(exec_model))
    out = spvt_push_space(out)
    out = spvt_push_id(out, func_id)
    out = spvt_push_str(out, " \"")
    out = spvt_push_str(out, name)
    out = spvt_push_str(out, "\"")

    var i: i64 = 0
    while i < iface_count {
        out = spvt_push_space(out)
        out = spvt_push_id(out, iface_ids[i as usize])
        i = i + 1
    }
    out = spvt_push_newline(out)
    out
}

// ============================================================================
// Execution mode emission
// ============================================================================

fn spvt_emit_execution_mode_local_size(w: SpvTextWriter, func_id: i64,
                                       x: i64, y: i64,
                                       z: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpExecutionMode ")
    out = spvt_push_id(out, func_id)
    out = spvt_push_str(out, " LocalSize ")
    out = spvt_push_i64(out, x)
    out = spvt_push_space(out)
    out = spvt_push_i64(out, y)
    out = spvt_push_space(out)
    out = spvt_push_i64(out, z)
    out = spvt_push_newline(out)
    out
}

