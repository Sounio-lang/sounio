                             merge_id: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpSelectionMerge ")
    out = spvt_push_id(out, merge_id)
    out = spvt_push_str(out, " None")
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_loop_merge(w: SpvTextWriter, merge_id: i64,
                        continue_id: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_str(out, "OpLoopMerge ")
    out = spvt_push_id(out, merge_id)
    out = spvt_push_space(out)
    out = spvt_push_id(out, continue_id)
    out = spvt_push_str(out, " None")
    out = spvt_push_newline(out)
    out
}

