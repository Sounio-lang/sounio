// --- Context / ID allocation ---

fn test_spvt_59_ctx_new() -> bool {
    let ctx = spvt_ctx_new()
    ctx.next_id == 1
}

fn test_spvt_60_ctx_alloc_id() -> bool with Mut {
    var ctx = spvt_ctx_new()
    let id1 = spvt_current_id(ctx)
    ctx = spvt_alloc_id(ctx)
    let id2 = spvt_current_id(ctx)
    id1 == 1 && id2 == 2
}

