    blk = spvt_block_add_instr(blk, 2)
    blk.label_id == 100 && blk.instr_count == 3
}

fn test_spvt_64_func_add_param() -> bool with Mut, Panic {
    var f = spvt_func_new(10, 1)
    f = spvt_func_add_param(f, 2)
    f = spvt_func_add_param(f, 3)
    f.param_count == 2 &&
    f.param_type_ids[0 as usize] == 2 &&
    f.param_type_ids[1 as usize] == 3
}

fn test_spvt_65_module_add_cap() -> bool with Mut, Panic {
    var m = spvt_module_new()
    m = spvt_module_add_cap(m, SPVT_CAP_SHADER)
    m = spvt_module_add_cap(m, SPVT_CAP_KERNEL)
    m.cap_count == 2 &&
    m.capabilities[0 as usize] == SPVT_CAP_SHADER &&
    m.capabilities[1 as usize] == SPVT_CAP_KERNEL
}

// --- Type pointer and function type ---

fn test_spvt_66_type_pointer() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_emit_type_pointer(w, 20, SPVT_SC_FUNCTION, 5)
    spvt_writer_contains(w, "%20 = OpTypePointer Function %5")
}

fn test_spvt_67_type_function() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = 5
    params[1 as usize] = 3
    w = spvt_emit_type_function(w, 30, 1, params, 2)
    spvt_writer_contains(w, "%30 = OpTypeFunction %1 %5 %3")
}

fn test_spvt_68_type_array() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_emit_type_array(w, 40, 5, 15)
    spvt_writer_contains(w, "%40 = OpTypeArray %5 %15")
}

fn test_spvt_69_type_struct() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    var members: [i64; 8] = [0; 8]
    members[0 as usize] = 5
    members[1 as usize] = 3
    w = spvt_emit_type_struct(w, 50, members, 2)
    spvt_writer_contains(w, "%50 = OpTypeStruct %5 %3")
}

// --- Full module assembly ---

fn test_spvt_70_minimal_module() -> bool with Mut, Panic, Div {
    let m = spvt_build_minimal_compute()
    let w = spvt_assemble_module(m)
    spvt_writer_contains(w, "OpCapability Shader") &&
    spvt_writer_contains(w, "OpMemoryModel Logical GLSL450") &&
    spvt_writer_contains(w, "OpEntryPoint GLCompute") &&
    spvt_writer_contains(w, "OpTypeVoid") &&
    spvt_writer_contains(w, "OpFunction") &&
    spvt_writer_contains(w, "OpFunctionEnd")
}

fn test_spvt_71_arith_module_has_types() -> bool with Mut, Panic, Div {
    let m = spvt_build_arith_compute()
    let w = spvt_assemble_module(m)
    spvt_writer_contains(w, "OpTypeFloat 32") &&
    spvt_writer_contains(w, "OpTypeInt 32 0") &&
    spvt_writer_contains(w, "OpDecorate %10 Binding 0")
}

fn test_spvt_72_module_header_comment() -> bool with Mut, Panic, Div {
    let m = spvt_build_minimal_compute()
    let w = spvt_assemble_module(m)
    spvt_writer_contains(w, "; SPIR-V Text (Sounio)") &&
    spvt_writer_contains(w, "; Generator: Sounio Self-Hosted Compiler")
}

fn test_spvt_73_switch() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    var cases: [i64; 8] = [0; 8]
    var targets: [i64; 8] = [0; 8]
    cases[0 as usize] = 1
    cases[1 as usize] = 2
    targets[0 as usize] = 110
    targets[1 as usize] = 111
    w = spvt_emit_switch(w, 70, 120, cases, targets, 2)
    spvt_writer_contains(w, "OpSwitch %70 %120 1 %110 2 %111")
}

fn test_spvt_74_variable_storage_buffer() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_emit_variable(w, 80, 15, SPVT_SC_STORAGE_BUFFER)
    spvt_writer_contains(w, "%80 = OpVariable %15 StorageBuffer")
}

fn test_spvt_75_type_cache() -> bool with Mut, Panic, Div {
    var ctx = spvt_ctx_new()
    ctx = spvt_cache_type(ctx, 100, 5)
    ctx = spvt_cache_type(ctx, 200, 10)
    let r1 = spvt_lookup_type(ctx, 100)
    let r2 = spvt_lookup_type(ctx, 200)
    let r3 = spvt_lookup_type(ctx, 999)
    r1 == 5 && r2 == 10 && r3 == 0
}

