// --- Writer basics ---

fn test_spvt_01_writer_new() -> bool {
    let w = spvt_writer_new()
    w.len == 0 && w.indent == 0
}

fn test_spvt_02_push_byte() -> bool with Mut, Panic {
    var w = spvt_writer_new()
    w = spvt_push_byte(w, 65)   // 'A'
    w.len == 1 && w.data[0 as usize] == 65
}

fn test_spvt_03_push_str() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_push_str(w, "hello")
    w.len == 5
}

fn test_spvt_04_push_newline() -> bool with Mut, Panic {
    var w = spvt_writer_new()
    w = spvt_push_newline(w)
    w.len == 1 && w.data[0 as usize] == 10
}

fn test_spvt_05_push_i64_zero() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_push_i64(w, 0)
    w.len == 1 && w.data[0 as usize] == 48   // '0'
}

fn test_spvt_06_push_i64_42() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_push_i64(w, 42)
    w.len == 2 && w.data[0 as usize] == 52 && w.data[1 as usize] == 50
}

fn test_spvt_07_push_id() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_push_id(w, 5)
    // Should be "%5"
    w.len == 2 && w.data[0 as usize] == 37 && w.data[1 as usize] == 53
}

fn test_spvt_08_writer_contains() -> bool with Mut, Panic, Div {
    var w = spvt_writer_new()
    w = spvt_push_str(w, "OpCapability Shader")
    spvt_writer_contains(w, "Capability") &&
    spvt_writer_contains(w, "Shader") &&
    !spvt_writer_contains(w, "Kernel")
}

