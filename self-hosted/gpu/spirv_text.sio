fn spvt_emit_binary_arith(w: SpvTextWriter, opcode: i64, id: i64,
                          type_id: i64, op1: i64,
                          op2: i64) -> SpvTextWriter with Mut, Panic, Div {
    var out = w
    out = spvt_push_id(out, id)
    out = spvt_push_str(out, " = ")
    out = spvt_push_str(out, spvt_opcode_name(opcode))
    out = spvt_push_space(out)
    out = spvt_push_id(out, type_id)
    out = spvt_push_space(out)
    out = spvt_push_id(out, op1)
    out = spvt_push_space(out)
    out = spvt_push_id(out, op2)
    out = spvt_push_newline(out)
    out
}

fn spvt_emit_fadd(w: SpvTextWriter, id: i64, type_id: i64, op1: i64,
                  op2: i64) -> SpvTextWriter with Mut, Panic, Div {
    spvt_emit_binary_arith(w, SPVT_OP_FADD, id, type_id, op1, op2)
}

