// self-hosted/gpu/kretikos_emit_epistemic_wmma.sio
// Kretikos PTX emission driver for the compiler-generated (not hand-written)
// epistemic WMMA matmul kernel (self-hosted/gpu/kernel_ir.sio,
// gpu_build_epistemic_wmma_matmul_16x16_ir), via the GpuKernelIr -> PTX
// lowering path (gpu::lower_to_ptx).
//
// Exists because that builder was previously reachable only from Sounio test
// fixtures (test_epistemic_wmma.sio, spirv_lower.sio self-checks) — there was
// no CLI path to get its PTX onto disk for `ptxas`/hardware verification on
// the DGX Spark. This does NOT replace self-hosted/gpu/epistemic_mma_reference.ptx
// (the hand-written kernel used for the PR #487 Blackwell receipt) — it emits
// the kernel_ir.sio builder's own output, which carries the corrected GUM
// quadrature (RSS) epsilon math, not the reference kernel's formula.
//
// Usage: souc build kretikos_emit_epistemic_wmma.sio -o /tmp/kretikos_emit_epistemic_wmma.elf
//        /tmp/kretikos_emit_epistemic_wmma.elf epi_wmma_mm16 > epi_wmma_mm16.ptx

use gpu::kernel_ir::*
use gpu::lower_to_ptx::*
use gpu::ptx::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_epistemic_wmma: error - expected <pattern>")
        println("")
        println("Supported patterns:")
        println("  epi_wmma_mm16 - epistemic WMMA m16n8k16 matmul (GUM RSS quadrature)")
        return 1
    }

    let pattern = get_arg(0)

    if !str_eq(pattern, "epi_wmma_mm16") {
        print("kretikos_emit_epistemic_wmma: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    let ir = gpu_build_epistemic_wmma_matmul_16x16_ir()
    let buf = gpu_lower_to_ptx(ir)
    ptx_buf_print(buf)
    0
}
