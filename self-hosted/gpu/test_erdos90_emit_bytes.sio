// Minimal compile unit: dump first bytes of HC smoke K-AXI emission.
use gpu::erdos90_hc_smoke_emit::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    kaxi_emit_erdos90_hc_smoke_build()
    var i: i64 = 0
    while i < 120 {
        print_int(kaxi_hc_smoke_asm_byte_at(i))
        if (i + 1) % 20 == 0 { println("") } else { print(" ") }
        i = i + 1
    }
    println("")
    kaxi_hc_smoke_asm_print_stdout()
    return 0
}