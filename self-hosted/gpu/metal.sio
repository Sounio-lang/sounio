fn metal_emit_rcp(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = 1.0f / ")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ";\n")
    out
}

// ============================================================================
// Phase 4A: Conversion emission helpers
// ============================================================================

fn metal_emit_cvt_f32_to_i32(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = static_cast<int>(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_cvt_i32_to_f32(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = static_cast<float>(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
