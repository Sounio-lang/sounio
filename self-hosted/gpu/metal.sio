// self-hosted::gpu::metal — Metal Shading Language (MSL) code generator
//
// Converts GpuKernelIr → MSL text (C++-like compute shaders).
// Same buffer pattern as ptx.sio (MetalBuf = fixed-size byte array + length).
//
// MSL output format:
//   #include <metal_stdlib>
//   using namespace metal;
//   kernel void kernel_name(
//       device float* param_a [[buffer(0)]],
//       device float* param_b [[buffer(1)]],
//       uint tid [[thread_position_in_grid]]
//   ) { ... }
//
// Metal Shading Language does not expose a portable native `double` type.
// Sounio therefore lowers source-level f64 through an explicit policy. The
// default self-hosted MSL path uses checked f32 storage until compensated
// float2 lowering is promoted by a runtime gate.

// ============================================================================
// MetalBuf — text buffer (same pattern as PtxBuf)
// ============================================================================

struct MetalBuf {
    data: [i8; 65536],
    len: i64,
}

fn metal_buf_new() -> MetalBuf {
    MetalBuf { data: [0; 65536], len: 0 }
}

fn metal_push_byte(buf: MetalBuf, b: i8) -> MetalBuf with Mut, Panic {
    var out = buf
    if out.len < 65536 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

// Append one MetalBuf to another.
fn metal_buf_append(dst: MetalBuf, src: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.len {
        if out.len < 65536 {
            out.data[out.len as usize] = src.data[i as usize]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// Print a MetalBuf to stdout.
pub fn metal_buf_print(buf: MetalBuf) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.len {
        print_char(buf.data[i as usize] as i64)
        i = i + 1
    }
}

fn metal_push_str(buf: MetalBuf, s: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

fn metal_push_str_mut(buf: &! MetalBuf, s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if buf.len < 65536 {
            buf.data[buf.len as usize] = str_char_at(s, i) as i8
            buf.len = buf.len + 1
        }
        i = i + 1
    }
}

fn metal_buf_contains(buf: MetalBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn metal_push_i64(buf: MetalBuf, n: i64) -> MetalBuf with Mut, Panic, Div, Alloc {
    metal_push_str(buf, i64_to_string(n))
}

fn metal_push_i64_mut(buf: &! MetalBuf, n: i64) with Mut, Panic, Div, Alloc {
    metal_push_str_mut(buf, i64_to_string(n))
}

fn metal_push_newline(buf: MetalBuf) -> MetalBuf with Mut, Panic {
    metal_push_byte(buf, 10)  // '\n'
}

fn metal_push_indent(buf: MetalBuf, depth: i64) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    var i: i64 = 0
    while i < depth {
        out = metal_push_str(out, "    ")
        i = i + 1
    }
    out
}

fn metal_to_string(buf: MetalBuf) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(buf.data, buf.len)
}

// ============================================================================
// Type mapping: GpuType → MSL type string
// ============================================================================

enum MetalF64Policy {
    MetalF64Reject,
    MetalF64F32Checked,
    MetalF64Float2Compensated,
}

fn metal_msl_supports_native_f64() -> bool {
    false
}

fn metal_default_f64_policy() -> MetalF64Policy {
    MetalF64Policy::MetalF64F32Checked
}

fn metal_f64_policy_to_string(policy: MetalF64Policy) -> string {
    match policy {
        MetalF64Policy::MetalF64Reject => "reject"
        MetalF64Policy::MetalF64F32Checked => "f32_checked"
        MetalF64Policy::MetalF64Float2Compensated => "float2_compensated"
    }
}

fn metal_f64_value_type(policy: MetalF64Policy) -> string {
    match policy {
        MetalF64Policy::MetalF64Reject => "unsupported_f64"
        MetalF64Policy::MetalF64F32Checked => "float"
        MetalF64Policy::MetalF64Float2Compensated => "float2"
    }
}

fn metal_f64_param_type(policy: MetalF64Policy) -> string {
    match policy {
        MetalF64Policy::MetalF64Reject => "device unsupported_f64*"
        MetalF64Policy::MetalF64F32Checked => "device float*"
        MetalF64Policy::MetalF64Float2Compensated => "device float2*"
    }
}

fn gpu_type_to_msl(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "uint",
        GpuType::GpuU64  => "ulong",
        GpuType::GpuF32  => "float",
        GpuType::GpuF64  => metal_f64_value_type(metal_default_f64_policy()),
        GpuType::GpuI32  => "int",
        GpuType::GpuI64  => "long",
        GpuType::GpuPtr  => "device void*",
        GpuType::GpuBool => "bool",
        GpuType::GpuTf32 => "float",    // TF32 stored as float in MSL
        GpuType::GpuF16  => "half",
        GpuType::GpuB32  => "uint",     // untyped 32-bit -> uint in MSL
        GpuType::GpuB64  => "ulong",
    }
}

// MSL pointer type for kernel parameters
fn gpu_type_to_msl_param(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "device uint*",
        GpuType::GpuU64  => "device ulong*",
        GpuType::GpuF32  => "device float*",
        GpuType::GpuF64  => metal_f64_param_type(metal_default_f64_policy()),
        GpuType::GpuI32  => "device int*",
        GpuType::GpuI64  => "device long*",
        GpuType::GpuPtr  => "device void*",
        GpuType::GpuBool => "device bool*",
        GpuType::GpuTf32 => "device float*",
        GpuType::GpuF16  => "device half*",
        GpuType::GpuB32  => "device uint*",
        GpuType::GpuB64  => "device ulong*",
    }
}

// Memory space → MSL address space qualifier
fn gpu_memspace_to_msl(space: GpuMemorySpace) -> string {
    match space {
        GpuMemorySpace::GpuMemGlobal => "device",
        GpuMemorySpace::GpuMemShared => "threadgroup",
        GpuMemorySpace::GpuMemConstant => "constant",
        GpuMemorySpace::GpuMemLocal => "thread",
    }
}

// ============================================================================
// Header emission
// ============================================================================

fn metal_emit_header(buf: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "#include <metal_stdlib>\n")
    out = metal_push_str(out, "using namespace metal;\n")
    out = metal_push_newline(out)
    out
}

// ============================================================================
// Kernel signature emission
// ============================================================================

fn metal_emit_kernel_signature(buf: MetalBuf, kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = metal_push_str(out, "kernel void ")
    out = metal_push_str(out, name_to_string(kernel.kernel_name))
    out = metal_push_str(out, "(\n")

    // Emit buffer parameters
    var pi: i64 = 0
    while pi < kernel.param_count {
        let param = kernel.params[pi as usize]
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, gpu_type_to_msl_param(param.ty))
        out = metal_push_str(out, " ")
        out = metal_push_str(out, name_to_string(param.name))
        out = metal_push_str(out, " [[buffer(")
        out = metal_push_i64(out, pi)
        out = metal_push_str(out, ")]]")
        if pi < kernel.param_count - 1 {
            out = metal_push_str(out, ",\n")
        } else {
            out = metal_push_str(out, ",\n")
        }
        pi = pi + 1
    }

    // Thread position in grid
    out = metal_push_str(out, "    uint tid [[thread_position_in_grid]],\n")
    out = metal_push_str(out, "    uint bid [[threadgroup_position_in_grid]],\n")
    out = metal_push_str(out, "    uint ntid [[threads_per_threadgroup]]\n")
    out = metal_push_str(out, ") {\n")
    out
}

// ============================================================================
// Variable declarations
// ============================================================================

fn metal_emit_var_decls(buf: &! MetalBuf, kernel: GpuKernelIr) with Mut, Panic, Div, Alloc {
    let out = buf

    // Declare registers based on max_reg counts
    // u32 registers
    if kernel.max_reg_u32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_u32 {
            metal_push_str_mut(out, "    uint r")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // u64 / pointer registers
    if kernel.max_reg_u64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_u64 {
            metal_push_str_mut(out, "    ulong rd")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // f32 registers
    if kernel.max_reg_f32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_f32 {
            metal_push_str_mut(out, "    float f")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // f64 registers
    if kernel.max_reg_f64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_f64 {
            metal_push_str_mut(out, "    ")
            metal_push_str_mut(out, metal_f64_value_type(metal_default_f64_policy()))
            metal_push_str_mut(out, " fd")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // i32 registers
    if kernel.max_reg_i32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_i32 {
            metal_push_str_mut(out, "    int sr")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // i64 registers
    if kernel.max_reg_i64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_i64 {
            metal_push_str_mut(out, "    long srd")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // Predicate registers
    if kernel.max_reg_pred > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_pred {
            metal_push_str_mut(out, "    bool p")
            metal_push_i64_mut(out, i)
            metal_push_str_mut(out, ";\n")
            i = i + 1
        }
    }

    // Shared memory (threadgroup)
    if kernel.shared_bytes > 0 {
        metal_push_str_mut(out, "    threadgroup float shared_mem[")
        metal_push_i64_mut(out, kernel.shared_bytes / 4)
        metal_push_str_mut(out, "];\n")
    }

    if metal_kernel_uses_lane_exchange(kernel) {
        metal_push_str_mut(out, "    // Lane-exchange scratch (portable fallback for shuffle family)\n")
        metal_push_str_mut(out, "    threadgroup uint __omega_shfl_u32[1024];\n")
        metal_push_str_mut(out, "    threadgroup ulong __omega_shfl_u64[1024];\n")
        metal_push_str_mut(out, "    threadgroup float __omega_shfl_f32[1024];\n")
        metal_push_str_mut(out, "    threadgroup ")
        metal_push_str_mut(out, metal_f64_value_type(metal_default_f64_policy()))
        metal_push_str_mut(out, " __omega_shfl_f64[1024];\n")
        metal_push_str_mut(out, "    threadgroup int __omega_shfl_i32[1024];\n")
        metal_push_str_mut(out, "    threadgroup long __omega_shfl_i64[1024];\n")
        metal_push_str_mut(out, "    uint __omega_local_tid = tid - (bid * ntid);\n")
        metal_push_str_mut(out, "    uint __omega_lane = __omega_local_tid & 31u;\n")
        metal_push_str_mut(out, "    uint __omega_warp_base = __omega_local_tid - __omega_lane;\n")
        metal_push_str_mut(out, "\n")
    }

    metal_push_str_mut(out, "\n")
}

// ============================================================================
// MSL register name for a given register index and type
// ============================================================================

fn metal_reg_name(ty: GpuType, idx: i64) -> string with Mut, Panic, Div, Alloc {
    match ty {
        GpuType::GpuU32 => str_concat("r", i64_to_string(idx)),
        GpuType::GpuU64 => str_concat("rd", i64_to_string(idx)),
        GpuType::GpuF32 => str_concat("f", i64_to_string(idx)),
        GpuType::GpuF64 => str_concat("fd", i64_to_string(idx)),
        GpuType::GpuI32 => str_concat("sr", i64_to_string(idx)),
        GpuType::GpuI64 => str_concat("srd", i64_to_string(idx)),
        GpuType::GpuPtr => str_concat("rd", i64_to_string(idx)),
        GpuType::GpuBool => str_concat("p", i64_to_string(idx)),
        GpuType::GpuTf32 => str_concat("f", i64_to_string(idx)),
        GpuType::GpuF16 => str_concat("h", i64_to_string(idx)),
        GpuType::GpuB32 => str_concat("r", i64_to_string(idx)),
        GpuType::GpuB64 => str_concat("rd", i64_to_string(idx)),
    }
}

fn metal_kernel_uses_lane_exchange(kernel: GpuKernelIr) -> bool {
    var i: i64 = 0
    while i < kernel.op_count {
        let opc = kernel.ops[i as usize].opcode
        if opc == GpuOpcode::GpuShflDown
        || opc == GpuOpcode::GpuShflUp
        || opc == GpuOpcode::GpuShflBfly
        || opc == GpuOpcode::GpuShflIdx {
            return true
        }
        i = i + 1
    }
    false
}

fn metal_shuffle_lane_array(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "__omega_shfl_u32",
        GpuType::GpuU64  => "__omega_shfl_u64",
        GpuType::GpuF32  => "__omega_shfl_f32",
        GpuType::GpuF64  => "__omega_shfl_f64",
        GpuType::GpuI32  => "__omega_shfl_i32",
        GpuType::GpuI64  => "__omega_shfl_i64",
        GpuType::GpuPtr  => "__omega_shfl_u64",
        GpuType::GpuBool => "__omega_shfl_u32",
        GpuType::GpuTf32 => "__omega_shfl_f32",
        GpuType::GpuF16  => "__omega_shfl_f32",
        GpuType::GpuB32  => "__omega_shfl_u32",
        GpuType::GpuB64  => "__omega_shfl_u64",
    }
}

// ============================================================================
// Phase 6 helpers: generic binary op and atomic binary op emitters
// ============================================================================

fn metal_emit_binop(buf: &! MetalBuf, op: GpuOp, sym: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.lhs_reg))
    metal_push_str_mut(out, " ")
    metal_push_str_mut(out, sym)
    metal_push_str_mut(out, " ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.rhs_reg))
    metal_push_str_mut(out, ";\n")
}

fn metal_emit_atomic_binop(buf: &! MetalBuf, op: GpuOp, fn_name: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, fn_name)
    metal_push_str_mut(out, "((device atomic_uint*)&")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.addr_reg))
    metal_push_str_mut(out, ", ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
    metal_push_str_mut(out, ", memory_order_relaxed);\n")
}

fn metal_emit_assign_literal(buf: &! MetalBuf, op: GpuOp, rhs: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, rhs)
    metal_push_str_mut(out, ";\n")
}

fn metal_emit_imm_binop(buf: &! MetalBuf, op: GpuOp, sym: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
    metal_push_str_mut(out, " ")
    metal_push_str_mut(out, sym)
    metal_push_str_mut(out, " ")
    metal_push_i64_mut(out, op.rhs_imm)
    metal_push_str_mut(out, ";\n")
}

fn metal_emit_unary_call(buf: &! MetalBuf, op: GpuOp, fn_name: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, fn_name)
    metal_push_str_mut(out, "(")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
    metal_push_str_mut(out, ");\n")
}

fn metal_emit_pred_cmp(buf: &! MetalBuf, op: GpuOp, sym: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    p")
    metal_push_i64_mut(out, op.dst_reg)
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.lhs_reg))
    metal_push_str_mut(out, " ")
    metal_push_str_mut(out, sym)
    metal_push_str_mut(out, " ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.rhs_reg))
    metal_push_str_mut(out, ";\n")
}

fn metal_emit_minmax(buf: &! MetalBuf, op: GpuOp, fn_name: string) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ")
    metal_push_str_mut(out, fn_name)
    metal_push_str_mut(out, "(")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.lhs_reg))
    metal_push_str_mut(out, ", ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.rhs_reg))
    metal_push_str_mut(out, ");\n")
}

fn metal_emit_global_load(buf: &! MetalBuf, op: GpuOp) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
    metal_push_str_mut(out, " = ((device ")
    metal_push_str_mut(out, gpu_type_to_msl(op.ty))
    metal_push_str_mut(out, "*)")
    metal_push_str_mut(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
    metal_push_str_mut(out, ")[0];\n")
}

fn metal_emit_global_store(buf: &! MetalBuf, op: GpuOp) with Mut, Panic, Div, Alloc {
    let out = buf
    metal_push_str_mut(out, "    ((device ")
    metal_push_str_mut(out, gpu_type_to_msl(op.ty))
    metal_push_str_mut(out, "*)")
    metal_push_str_mut(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
    metal_push_str_mut(out, ")[0] = ")
    metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
    metal_push_str_mut(out, ";\n")
}

// ============================================================================
// Lower operations → MSL statements
// ============================================================================

fn metal_lower_ops(buf: &! MetalBuf, kernel: GpuKernelIr) with Mut, Panic, Div, Alloc {
    let out = buf
    var i: i64 = 0

    while i < kernel.op_count {
        let op = kernel.ops[i as usize]
        metal_lower_single_op(out, op, kernel)
        i = i + 1
    }

}

fn metal_op_is_core(opc: GpuOpcode) -> bool {
    opc == GpuOpcode::GpuGetTid || opc == GpuOpcode::GpuGetBid || opc == GpuOpcode::GpuGetNtid
        || opc == GpuOpcode::GpuAdd || opc == GpuOpcode::GpuSub || opc == GpuOpcode::GpuMul
        || opc == GpuOpcode::GpuDiv || opc == GpuOpcode::GpuFma || opc == GpuOpcode::GpuMulImm
        || opc == GpuOpcode::GpuAddImm || opc == GpuOpcode::GpuCvt || opc == GpuOpcode::GpuLoadParam
}

fn metal_lower_core_op(buf: &! MetalBuf, op: GpuOp, kernel: GpuKernelIr) with Mut, Panic, Div, Alloc {
    let out = buf
    let opc = op.opcode

    if opc == GpuOpcode::GpuGetTid {
        metal_emit_assign_literal(out, op, "tid")
        return
    }
    if opc == GpuOpcode::GpuGetBid {
        metal_emit_assign_literal(out, op, "bid")
        return
    }
    if opc == GpuOpcode::GpuGetNtid {
        metal_emit_assign_literal(out, op, "ntid")
        return
    }
    if opc == GpuOpcode::GpuAdd {
        metal_emit_binop(out, op, "+")
        return
    }
    if opc == GpuOpcode::GpuSub {
        metal_emit_binop(out, op, "-")
        return
    }
    if opc == GpuOpcode::GpuMul {
        metal_emit_binop(out, op, "*")
        return
    }
    if opc == GpuOpcode::GpuDiv {
        metal_emit_binop(out, op, "/")
        return
    }
    if opc == GpuOpcode::GpuFma {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = fma(")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.lhs_reg))
        metal_push_str_mut(out, ", ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.rhs_reg))
        metal_push_str_mut(out, ", ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ");\n")
        return
    }
    if opc == GpuOpcode::GpuMulImm {
        metal_emit_imm_binop(out, op, "*")
        return
    }
    if opc == GpuOpcode::GpuAddImm {
        metal_emit_imm_binop(out, op, "+")
        return
    }
    if opc == GpuOpcode::GpuCvt {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.dst_ty, op.dst_reg))
        metal_push_str_mut(out, " = (")
        metal_push_str_mut(out, gpu_type_to_msl(op.dst_ty))
        metal_push_str_mut(out, ")")
        metal_push_str_mut(out, metal_reg_name(op.src_ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        return
    }
    if opc == GpuOpcode::GpuLoadParam {
        let param = kernel.params[op.param_idx as usize]
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = (")
        metal_push_str_mut(out, gpu_type_to_msl(op.ty))
        metal_push_str_mut(out, ")(ulong)")
        metal_push_str_mut(out, name_to_string(param.name))
        metal_push_str_mut(out, ";\n")
        return
    }
}

fn metal_op_is_memory(opc: GpuOpcode) -> bool {
    opc == GpuOpcode::GpuLoadGlobal || opc == GpuOpcode::GpuLdGlobalCached || opc == GpuOpcode::GpuStoreGlobal
        || opc == GpuOpcode::GpuLoadGlobalPred || opc == GpuOpcode::GpuStoreGlobalPred
        || opc == GpuOpcode::GpuStGlobalWriteback || opc == GpuOpcode::GpuLoadShared
        || opc == GpuOpcode::GpuStoreShared || opc == GpuOpcode::GpuLoadSharedPred
        || opc == GpuOpcode::GpuStoreSharedPred || opc == GpuOpcode::GpuBarrierSync
}

fn metal_op_is_global_memory(opc: GpuOpcode) -> bool {
    opc == GpuOpcode::GpuLoadGlobal || opc == GpuOpcode::GpuLdGlobalCached || opc == GpuOpcode::GpuStoreGlobal
        || opc == GpuOpcode::GpuLoadGlobalPred || opc == GpuOpcode::GpuStoreGlobalPred || opc == GpuOpcode::GpuStGlobalWriteback
}

fn metal_lower_global_memory_op(buf: &! MetalBuf, op: GpuOp) with Mut, Panic, Div, Alloc {
    let out = buf
    let opc = op.opcode

    if opc == GpuOpcode::GpuLoadGlobal {
        metal_emit_global_load(out, op)
        return
    }
    if opc == GpuOpcode::GpuLdGlobalCached {
        metal_push_str_mut(out, "    // cached load (lowered as standard device load)\n")
        metal_emit_global_load(out, op)
        return
    }
    if opc == GpuOpcode::GpuStoreGlobal {
        metal_emit_global_store(out, op)
        return
    }
    if opc == GpuOpcode::GpuLoadGlobalPred {
        metal_push_str_mut(out, "    if (p")
        metal_push_i64_mut(out, op.pred_reg)
        metal_push_str_mut(out, ") {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = ((device ")
        metal_push_str_mut(out, gpu_type_to_msl(op.ty))
        metal_push_str_mut(out, "*)")
        metal_push_str_mut(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        metal_push_str_mut(out, ")[0];\n")
        metal_push_str_mut(out, "    } else {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = 0;\n")
        metal_push_str_mut(out, "    }\n")
        return
    }
    if opc == GpuOpcode::GpuStoreGlobalPred {
        metal_push_str_mut(out, "    if (p")
        metal_push_i64_mut(out, op.pred_reg)
        metal_push_str_mut(out, ") {\n")
        metal_push_str_mut(out, "        ((device ")
        metal_push_str_mut(out, gpu_type_to_msl(op.ty))
        metal_push_str_mut(out, "*)")
        metal_push_str_mut(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        metal_push_str_mut(out, ")[0] = ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        metal_push_str_mut(out, "    }\n")
        return
    }
    if opc == GpuOpcode::GpuStGlobalWriteback {
        metal_push_str_mut(out, "    // writeback store (lowered as standard device store)\n")
        metal_emit_global_store(out, op)
        return
    }
}

fn metal_op_is_shared_memory(opc: GpuOpcode) -> bool {
    opc == GpuOpcode::GpuLoadShared || opc == GpuOpcode::GpuStoreShared
        || opc == GpuOpcode::GpuLoadSharedPred || opc == GpuOpcode::GpuStoreSharedPred
        || opc == GpuOpcode::GpuBarrierSync
}

fn metal_lower_shared_memory_op(buf: &! MetalBuf, op: GpuOp) with Mut, Panic, Div, Alloc {
    let out = buf
    let opc = op.opcode

    if opc == GpuOpcode::GpuLoadShared {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = shared_mem[")
        metal_push_i64_mut(out, op.shared_addr / 4)
        metal_push_str_mut(out, "];\n")
        return
    }
    if opc == GpuOpcode::GpuStoreShared {
        metal_push_str_mut(out, "    shared_mem[")
        metal_push_i64_mut(out, op.shared_addr / 4)
        metal_push_str_mut(out, "] = ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        return
    }
    if opc == GpuOpcode::GpuLoadSharedPred {
        metal_push_str_mut(out, "    if (p")
        metal_push_i64_mut(out, op.pred_reg)
        metal_push_str_mut(out, ") {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = shared_mem[")
        metal_push_i64_mut(out, op.shared_addr / 4)
        metal_push_str_mut(out, "];\n")
        metal_push_str_mut(out, "    } else {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = 0;\n")
        metal_push_str_mut(out, "    }\n")
        return
    }
    if opc == GpuOpcode::GpuStoreSharedPred {
        metal_push_str_mut(out, "    if (p")
        metal_push_i64_mut(out, op.pred_reg)
        metal_push_str_mut(out, ") {\n")
        metal_push_str_mut(out, "        shared_mem[")
        metal_push_i64_mut(out, op.shared_addr / 4)
        metal_push_str_mut(out, "] = ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        metal_push_str_mut(out, "    }\n")
        return
    }
    if opc == GpuOpcode::GpuBarrierSync {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return
    }
}

fn metal_lower_memory_op(buf: &! MetalBuf, op: GpuOp) with Mut, Panic, Div, Alloc {
    let opc = op.opcode
    if metal_op_is_global_memory(opc) {
        metal_lower_global_memory_op(buf, op)
        return
    } else if metal_op_is_shared_memory(opc) {
        metal_lower_shared_memory_op(buf, op)
        return
    } else {
        return
    }
}

fn metal_lower_single_op(buf: &! MetalBuf, op: GpuOp, kernel: GpuKernelIr) with Mut, Panic, Div, Alloc {
    let out = buf
    let opc = op.opcode

    if metal_op_is_core(opc) {
        metal_lower_core_op(out, op, kernel)
        return
    }

    if metal_op_is_memory(opc) {
        metal_lower_memory_op(out, op)
        return
    }

    // ---- Max ----
    if opc == GpuOpcode::GpuMax {
        metal_emit_minmax(out, op, "max")
        return
    }

    // ---- Min ----
    if opc == GpuOpcode::GpuMin {
        metal_emit_minmax(out, op, "min")
        return
    }

    // ---- AtomicAdd ----
    if opc == GpuOpcode::GpuAtomicAdd {
        metal_push_str_mut(out, "    atomic_fetch_add_explicit((device atomic_uint*)")
        metal_push_str_mut(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        metal_push_str_mut(out, ", ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ", memory_order_relaxed);\n")
        return
    }

    // ---- Prefetch ----
    // Portable MSL fallback: no-op with explicit marker.
    if opc == GpuOpcode::GpuPrefetch {
        metal_push_str_mut(out, "    // prefetch: no-op on portable MSL path\n")
        return
    }

    // ---- Warp shuffle family ----
    // Lane-exchange fallback using threadgroup scratch and lane math.
    if opc == GpuOpcode::GpuShflDown
    || opc == GpuOpcode::GpuShflUp
    || opc == GpuOpcode::GpuShflBfly
    || opc == GpuOpcode::GpuShflIdx {
        let dst_name = metal_reg_name(op.ty, op.dst_reg)
        let src_name = metal_reg_name(op.ty, op.src_reg)
        let lane_array = metal_shuffle_lane_array(op.ty)

        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, lane_array)
        metal_push_str_mut(out, "[__omega_local_tid & 1023u] = ")
        metal_push_str_mut(out, src_name)
        metal_push_str_mut(out, ";\n")
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")

        if opc == GpuOpcode::GpuShflDown {
            if op.rhs_imm >= 0 {
                metal_push_str_mut(out, "    uint __omega_lane_peer = __omega_lane + ")
                metal_push_i64_mut(out, op.rhs_imm)
                metal_push_str_mut(out, "u;\n")
            } else {
                metal_push_str_mut(out, "    uint __omega_lane_peer = __omega_lane >= ")
                metal_push_i64_mut(out, 0 - op.rhs_imm)
                metal_push_str_mut(out, "u ? (__omega_lane - ")
                metal_push_i64_mut(out, 0 - op.rhs_imm)
                metal_push_str_mut(out, "u) : 32u;\n")
            }
        } else if opc == GpuOpcode::GpuShflUp {
            if op.rhs_imm >= 0 {
                metal_push_str_mut(out, "    uint __omega_lane_peer = __omega_lane >= ")
                metal_push_i64_mut(out, op.rhs_imm)
                metal_push_str_mut(out, "u ? (__omega_lane - ")
                metal_push_i64_mut(out, op.rhs_imm)
                metal_push_str_mut(out, "u) : 32u;\n")
            } else {
                metal_push_str_mut(out, "    uint __omega_lane_peer = __omega_lane + ")
                metal_push_i64_mut(out, 0 - op.rhs_imm)
                metal_push_str_mut(out, "u;\n")
            }
        } else if opc == GpuOpcode::GpuShflBfly {
            metal_push_str_mut(out, "    uint __omega_lane_peer = __omega_lane ^ ")
            if op.rhs_imm >= 0 {
                metal_push_i64_mut(out, op.rhs_imm)
            } else {
                metal_push_i64_mut(out, 0 - op.rhs_imm)
            }
            metal_push_str_mut(out, "u;\n")
        } else {
            if op.rhs_reg >= 0 {
                metal_push_str_mut(out, "    uint __omega_lane_peer = (uint)")
                metal_push_str_mut(out, metal_reg_name(GpuType::GpuU32, op.rhs_reg))
                metal_push_str_mut(out, ";\n")
            } else {
                if op.rhs_imm >= 0 {
                    metal_push_str_mut(out, "    uint __omega_lane_peer = ")
                    metal_push_i64_mut(out, op.rhs_imm)
                    metal_push_str_mut(out, "u;\n")
                } else {
                    metal_push_str_mut(out, "    uint __omega_lane_peer = 32u;\n")
                }
            }
        }

        metal_push_str_mut(out, "    if (__omega_lane_peer < 32u && (__omega_warp_base + __omega_lane_peer) < ntid) {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, dst_name)
        metal_push_str_mut(out, " = ")
        metal_push_str_mut(out, lane_array)
        metal_push_str_mut(out, "[(__omega_warp_base + __omega_lane_peer) & 1023u];\n")
        metal_push_str_mut(out, "    } else {\n")
        metal_push_str_mut(out, "        ")
        metal_push_str_mut(out, dst_name)
        metal_push_str_mut(out, " = ")
        metal_push_str_mut(out, src_name)
        metal_push_str_mut(out, ";\n")
        metal_push_str_mut(out, "    }\n")
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return
    }

    // ---- Vote / Ballot ----
    if opc == GpuOpcode::GpuVote || opc == GpuOpcode::GpuBallot {
        var pred_expr = "false"
        if op.pred_reg >= 0 {
            pred_expr = str_concat("p", i64_to_string(op.pred_reg))
        } else if op.src_reg >= 0 {
            pred_expr = str_concat(metal_reg_name(op.ty, op.src_reg), " != 0")
        }

        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = ")
        if opc == GpuOpcode::GpuBallot {
            metal_push_str_mut(out, "(")
            metal_push_str_mut(out, pred_expr)
            metal_push_str_mut(out, ") ? (1u << (__omega_lane & 31u)) : 0u;\n")
        } else {
            metal_push_str_mut(out, "(")
            metal_push_str_mut(out, pred_expr)
            metal_push_str_mut(out, ") ? 1 : 0;\n")
        }
        return
    }

    // ---- Tensor ops (WMMA/MMA/TMA) ----
    // These are represented as conservative no-op placeholders in MSL path.
    if opc == GpuOpcode::GpuWmma || opc == GpuOpcode::GpuMma {
        metal_push_str_mut(out, "    // tensor op lowered as fallback on MSL path\n")
        if op.dst_reg >= 0 && op.src_reg >= 0 {
            metal_push_str_mut(out, "    ")
            metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
            metal_push_str_mut(out, " = ")
            metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
            metal_push_str_mut(out, ";\n")
        }
        return
    }
    if opc == GpuOpcode::GpuTmaLoad {
        metal_push_str_mut(out, "    // tma.load lowered to regular load fallback\n")
        if op.dst_reg >= 0 && op.addr_reg >= 0 {
            metal_emit_global_load(out, op)
        }
        return
    }
    if opc == GpuOpcode::GpuTmaStore {
        metal_push_str_mut(out, "    // tma.store lowered to regular store fallback\n")
        if op.addr_reg >= 0 && op.src_reg >= 0 {
            metal_emit_global_store(out, op)
        }
        return
    }

    // ---- Comparisons (SetpLt/Le/Eq/Ge/Gt/Ne) ----
    if opc == GpuOpcode::GpuSetpLt {
        metal_emit_pred_cmp(out, op, "<")
        return
    }
    if opc == GpuOpcode::GpuSetpLe {
        metal_emit_pred_cmp(out, op, "<=")
        return
    }
    if opc == GpuOpcode::GpuSetpEq {
        metal_emit_pred_cmp(out, op, "==")
        return
    }
    if opc == GpuOpcode::GpuSetpGe {
        metal_emit_pred_cmp(out, op, ">=")
        return
    }
    if opc == GpuOpcode::GpuSetpGt {
        metal_emit_pred_cmp(out, op, ">")
        return
    }
    if opc == GpuOpcode::GpuSetpNe {
        metal_emit_pred_cmp(out, op, "!=")
        return
    }

    // ---- Selp (predicate select) ----
    if opc == GpuOpcode::GpuSelp {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = p")
        metal_push_i64_mut(out, op.src_reg)
        metal_push_str_mut(out, " ? ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.lhs_reg))
        metal_push_str_mut(out, " : ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.rhs_reg))
        metal_push_str_mut(out, ";\n")
        return
    }

    // ---- Math intrinsics ----
    if opc == GpuOpcode::GpuSqrt {
        metal_emit_unary_call(out, op, "sqrt")
        return
    }
    if opc == GpuOpcode::GpuRsqrt {
        metal_emit_unary_call(out, op, "rsqrt")
        return
    }
    if opc == GpuOpcode::GpuExp2 {
        metal_emit_unary_call(out, op, "exp2")
        return
    }
    if opc == GpuOpcode::GpuLg2 {
        metal_emit_unary_call(out, op, "log2")
        return
    }
    if opc == GpuOpcode::GpuSin {
        metal_emit_unary_call(out, op, "sin")
        return
    }
    if opc == GpuOpcode::GpuCos {
        metal_emit_unary_call(out, op, "cos")
        return
    }
    if opc == GpuOpcode::GpuAbs {
        metal_emit_unary_call(out, op, "abs")
        return
    }
    if opc == GpuOpcode::GpuRcp {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = 1.0 / ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        return
    }

    // ---- Special registers ----
    if opc == GpuOpcode::GpuGetLaneId {
        metal_emit_assign_literal(out, op, "tid & 31")
        return
    }
    if opc == GpuOpcode::GpuGetWarpId {
        metal_emit_assign_literal(out, op, "tid / 32")
        return
    }
    if opc == GpuOpcode::GpuGetSmId {
        metal_emit_assign_literal(out, op, "0; // SM id unavailable in portable MSL")
        return
    }
    if opc == GpuOpcode::GpuGetGridDim {
        metal_emit_assign_literal(out, op, "ntid; // fallback: threads_per_threadgroup")
        return
    }

    // ---- Branch ----
    // MSL linear emitter cannot materialize arbitrary PTX label targets.
    // Deterministic fallback: branch is approximated as early return.
    if opc == GpuOpcode::GpuBra {
        if op.pred_reg >= 0 {
            metal_push_str_mut(out, "    if (p")
            metal_push_i64_mut(out, op.pred_reg)
            metal_push_str_mut(out, ") { return; } // bra fallback target L")
            metal_push_i64_mut(out, op.rhs_imm)
            metal_push_str_mut(out, "\n")
        } else {
            metal_push_str_mut(out, "    return; // bra fallback target L")
            metal_push_i64_mut(out, op.rhs_imm)
            metal_push_str_mut(out, "\n")
        }
        return
    }

    // ---- Ret ----
    if opc == GpuOpcode::GpuRet {
        metal_push_str_mut(out, "    return;\n")
        return
    }

    // ---- Exit ----
    if opc == GpuOpcode::GpuExit {
        metal_push_str_mut(out, "    return;\n")
        return
    }

    // Phase 6: Async copy (cp.async -> threadgroup_barrier in MSL)
    if opc == GpuOpcode::GpuCpAsync {
        metal_push_str_mut(out, "    // cp.async: threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return
    }
    if opc == GpuOpcode::GpuCpAsyncWait {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return
    }
    if opc == GpuOpcode::GpuCpAsyncWaitAll {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return
    }

    // Phase 6: Extended atomics
    if opc == GpuOpcode::GpuAtomicCas {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = atomic_compare_exchange_weak_explicit((device atomic_uint*)&")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.addr_reg))
        metal_push_str_mut(out, ", &")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.compare_reg))
        metal_push_str_mut(out, ", ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ", memory_order_relaxed, memory_order_relaxed);\n")
        return
    }
    if opc == GpuOpcode::GpuAtomicExch {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = atomic_exchange_explicit((device atomic_uint*)&")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.addr_reg))
        metal_push_str_mut(out, ", ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ", memory_order_relaxed);\n")
        return
    }
    if opc == GpuOpcode::GpuAtomicMin {
        metal_emit_atomic_binop(out, op, "atomic_fetch_min_explicit")
        return
    }
    if opc == GpuOpcode::GpuAtomicMax {
        metal_emit_atomic_binop(out, op, "atomic_fetch_max_explicit")
        return
    }
    if opc == GpuOpcode::GpuAtomicAnd {
        metal_emit_atomic_binop(out, op, "atomic_fetch_and_explicit")
        return
    }
    if opc == GpuOpcode::GpuAtomicOr {
        metal_emit_atomic_binop(out, op, "atomic_fetch_or_explicit")
        return
    }
    if opc == GpuOpcode::GpuAtomicXor {
        metal_emit_atomic_binop(out, op, "atomic_fetch_xor_explicit")
        return
    }

    // Phase 6: Memory fences
    if opc == GpuOpcode::GpuFenceAcquire {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return
    }
    if opc == GpuOpcode::GpuFenceRelease {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return
    }
    if opc == GpuOpcode::GpuFenceAcqRel {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return
    }
    if opc == GpuOpcode::GpuMembar {
        metal_push_str_mut(out, "    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);\n")
        return
    }

    // Phase 6: Mixed precision
    if opc == GpuOpcode::GpuCvtF32Tf32 {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = (float)(")
        metal_push_str_mut(out, metal_reg_name(op.src_ty, op.src_reg))
        metal_push_str_mut(out, "); // tf32 approx via f32\n")
        return
    }
    if opc == GpuOpcode::GpuMmaTf32 {
        metal_push_str_mut(out, "    // mma.tf32: not directly expressible in MSL 3.1\n")
        return
    }
    if opc == GpuOpcode::GpuMmaF16 {
        metal_push_str_mut(out, "    // mma.f16: not directly expressible in MSL 3.1\n")
        return
    }

    // Phase 6: Bitwise / integer
    if opc == GpuOpcode::GpuAnd {
        metal_emit_binop(out, op, "&")
        return
    }
    if opc == GpuOpcode::GpuOr {
        metal_emit_binop(out, op, "|")
        return
    }
    if opc == GpuOpcode::GpuXor {
        metal_emit_binop(out, op, "^")
        return
    }
    if opc == GpuOpcode::GpuNot {
        metal_push_str_mut(out, "    ")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.dst_reg))
        metal_push_str_mut(out, " = ~")
        metal_push_str_mut(out, metal_reg_name(op.ty, op.src_reg))
        metal_push_str_mut(out, ";\n")
        return
    }
    if opc == GpuOpcode::GpuShl {
        metal_emit_binop(out, op, "<<")
        return
    }
    if opc == GpuOpcode::GpuShr {
        metal_emit_binop(out, op, ">>")
        return
    }
    if opc == GpuOpcode::GpuShra {
        metal_emit_binop(out, op, ">>")
        return
    }
    if opc == GpuOpcode::GpuClz {
        metal_emit_unary_call(out, op, "clz")
        return
    }
    if opc == GpuOpcode::GpuPopc {
        metal_emit_unary_call(out, op, "popcount")
        return
    }

    // Phase 6: Cooperative groups
    if opc == GpuOpcode::GpuCgTiledPartition {
        metal_push_str_mut(out, "    // cg::tiled_partition: use simd_group in MSL\n")
        return
    }
    if opc == GpuOpcode::GpuCgSync {
        metal_push_str_mut(out, "    simdgroup_barrier(mem_flags::mem_none);\n")
        return
    }
    if opc == GpuOpcode::GpuCgReduce {
        metal_push_str_mut(out, "    // cg::reduce: use simd_sum/simd_min/simd_max\n")
        return
    }

    // Default: comment for unhandled opcode
    metal_push_str_mut(out, "    // unhandled opcode\n")
}

// ============================================================================
// Main entry: GpuKernelIr → MetalBuf
// ============================================================================

fn gpu_lower_to_metal(kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var buf = metal_buf_new()
    buf = metal_emit_header(buf)
    buf = metal_emit_kernel_signature(buf, kernel)
    metal_emit_var_decls(&! buf, kernel)
    metal_lower_ops(&! buf, kernel)
    buf = metal_push_str(buf, "}\n")
    buf
}

// ============================================================================
// Phase 4A: Math intrinsic emission helpers
// ============================================================================
// Standalone emitters for each math intrinsic.  Each takes a MetalBuf,
// a destination register name, and a source register name, then emits
// the corresponding MSL statement: "    dst = func(src);\n"

fn metal_emit_sqrt(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = sqrt(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_rsqrt(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
