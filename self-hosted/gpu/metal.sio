// self-hosted::gpu::metal — Metal Shading Language (MSL) code generator
//
// Converts GpuKernelIr → MSL text (C++-like compute shaders).
// Same buffer pattern as ptx.sio (MetalBuf = fixed-size byte array + length).
//
// MSL output format:
//   #include <metal_stdlib>
//   using namespace metal;
//   kernel void kernel_name(
//       device float* param_a [[buffer(0)]],
//       device float* param_b [[buffer(1)]],
//       uint tid [[thread_position_in_grid]]
//   ) { ... }
//
// Metal Shading Language does not expose a portable native `double` type.
// Sounio therefore lowers source-level f64 through an explicit policy. The
// default self-hosted MSL path uses checked f32 storage until compensated
// float2 lowering is promoted by a runtime gate.

// ============================================================================
// MetalBuf — text buffer (same pattern as PtxBuf)
// ============================================================================

pub struct MetalBuf {
    pub data: [i8; 65536],
    pub len: i64,
}

pub fn metal_buf_new() -> MetalBuf {
    MetalBuf { data: [0; 65536], len: 0 }
}

fn metal_push_byte(buf: MetalBuf, b: i8) -> MetalBuf with Mut, Panic {
    var out = buf
    if out.len < 65536 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

// Append one MetalBuf to another.
pub fn metal_buf_append(dst: MetalBuf, src: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.len {
        if out.len < 65536 {
            out.data[out.len as usize] = src.data[i as usize]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// Print a MetalBuf to stdout.
pub(crate) fn metal_buf_print(buf: MetalBuf) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.len {
        print_char(buf.data[i as usize] as i64)
        i = i + 1
    }
}

fn metal_push_str(buf: MetalBuf, s: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

pub fn metal_buf_contains(buf: MetalBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn metal_push_i64(buf: MetalBuf, n: i64) -> MetalBuf with Mut, Panic, Div {
    if n == 0 { return metal_push_byte(buf, 48) }
    var value: i64 = if n < 0 { 0 } else { n }
    var digits: [i8; 20] = [0 as i8; 20]
    var rev_len: i64 = 0
    while value > 0 {
        digits[rev_len as usize] = (48 + value % 10) as i8
        rev_len = rev_len + 1
        value = value / 10
    }
    var out = buf
    var k: i64 = rev_len - 1
    while k >= 0 {
        out = metal_push_byte(out, digits[k as usize])
        k = k - 1
    }
    out
}

var METAL_I64_TO_STRING_BUF: [i8; 32] = [0 as i8; 32]

fn metal_i64_to_string(n: i64) -> string with Mut, Panic, Div {
    var tmp = metal_buf_new()
    tmp = metal_push_i64(tmp, n)
    var i: i64 = 0
    while i < tmp.len {
        METAL_I64_TO_STRING_BUF[i as usize] = tmp.data[i as usize]
        i = i + 1
    }
    METAL_I64_TO_STRING_BUF[tmp.len as usize] = 0
    str_from_bytes(METAL_I64_TO_STRING_BUF, tmp.len)
}

fn metal_push_name(buf: MetalBuf, name: Name) -> MetalBuf with Mut, Panic {
    var out = buf
    var i: i64 = 0
    while i < name.len {
        out = metal_push_byte(out, name.buf[i as usize])
        i = i + 1
    }
    out
}

fn metal_push_newline(buf: MetalBuf) -> MetalBuf with Mut, Panic {
    metal_push_byte(buf, 10)  // '\n'
}

fn metal_push_indent(buf: MetalBuf, depth: i64) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    var i: i64 = 0
    while i < depth {
        out = metal_push_str(out, "    ")
        i = i + 1
    }
    out
}

// Global output buffer for metal_to_string; avoids returning a dangling stack pointer
// since str_from_bytes in lean_single returns the address of its first arg.
pub var METAL_TO_STRING_BUF: [i8; 65536] = [0; 65536]

fn metal_to_string(buf: MetalBuf) -> string with Mut, Panic {
    var i: i64 = 0
    while i < buf.len {
        METAL_TO_STRING_BUF[i as usize] = buf.data[i as usize]
        i = i + 1
    }
    METAL_TO_STRING_BUF[buf.len as usize] = 0
    str_from_bytes(METAL_TO_STRING_BUF, buf.len)
}

// ============================================================================
// Type mapping: GpuType → MSL type string
// ============================================================================

enum MetalF64Policy {
    MetalF64Reject,
    MetalF64F32Checked,
    MetalF64Float2Compensated,
}

fn metal_msl_supports_native_f64() -> bool {
    false
}

fn metal_default_f64_policy() -> MetalF64Policy {
    MetalF64Policy::MetalF64F32Checked
}

// Soft-keyword: Madaros parser rejects param name `policy`.
fn metal_f64_policy_to_string(f64_policy: MetalF64Policy) -> string {
    match f64_policy {
        MetalF64Policy::MetalF64Reject => "reject"
        MetalF64Policy::MetalF64F32Checked => "f32_checked"
        MetalF64Policy::MetalF64Float2Compensated => "float2_compensated"
    }
}

fn metal_f64_value_type(f64_policy: MetalF64Policy) -> string {
    match f64_policy {
        MetalF64Policy::MetalF64Reject => "unsupported_f64"
        MetalF64Policy::MetalF64F32Checked => "float"
        MetalF64Policy::MetalF64Float2Compensated => "float2"
    }
}

fn metal_f64_param_type(f64_policy: MetalF64Policy) -> string {
    match f64_policy {
        MetalF64Policy::MetalF64Reject => "device unsupported_f64*"
        MetalF64Policy::MetalF64F32Checked => "device float*"
        MetalF64Policy::MetalF64Float2Compensated => "device float2*"
    }
}

fn gpu_type_to_msl(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "uint",
        GpuType::GpuU64  => "ulong",
        GpuType::GpuF32  => "float",
        GpuType::GpuF64  => metal_f64_value_type(metal_default_f64_policy()),
        GpuType::GpuI32  => "int",
        GpuType::GpuI64  => "long",
        GpuType::GpuPtr  => "device void*",
        GpuType::GpuBool => "bool",
        GpuType::GpuTf32 => "float",    // TF32 stored as float in MSL
        GpuType::GpuF16  => "half",
        GpuType::GpuB32  => "uint",     // untyped 32-bit -> uint in MSL
        GpuType::GpuB64  => "ulong",
    }
}

// MSL pointer type for kernel parameters
fn gpu_type_to_msl_param(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "device uint*",
        GpuType::GpuU64  => "device ulong*",
        GpuType::GpuF32  => "device float*",
        GpuType::GpuF64  => metal_f64_param_type(metal_default_f64_policy()),
        GpuType::GpuI32  => "device int*",
        GpuType::GpuI64  => "device long*",
        GpuType::GpuPtr  => "device void*",
        GpuType::GpuBool => "device bool*",
        GpuType::GpuTf32 => "device float*",
        GpuType::GpuF16  => "device half*",
        GpuType::GpuB32  => "device uint*",
        GpuType::GpuB64  => "device ulong*",
    }
}

// Memory space → MSL address space qualifier
fn gpu_memspace_to_msl(space: GpuMemorySpace) -> string {
    match space {
        GpuMemorySpace::GpuMemGlobal => "device",
        GpuMemorySpace::GpuMemShared => "threadgroup",
        GpuMemorySpace::GpuMemConstant => "constant",
        GpuMemorySpace::GpuMemLocal => "thread",
    }
}

// ============================================================================
// Header emission
// ============================================================================

fn metal_emit_header(buf: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "#include <metal_stdlib>\n")
    out = metal_push_str(out, "using namespace metal;\n")
    out = metal_push_newline(out)
    out
}

fn metal_kernel_has_xor_convolution(kernel: GpuKernelIr) -> bool {
    var i: i64 = 0
    while i < kernel.op_count {
        if kernel.ops[i as usize].opcode == GpuOpcode::GpuXorConvolutionF64 { return true }
        i = i + 1
    }
    false
}

fn metal_cd_sign(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let ah = if a >= half { 1 } else { 0 }
    let bh = if b >= half { 1 } else { 0 }
    let al = a & (half - 1)
    let bl = b & (half - 1)
    if ah == 0 && bh == 0 { return metal_cd_sign(al, bl, bits - 1) }
    if ah == 0 && bh == 1 { return metal_cd_sign(bl, al, bits - 1) }
    if ah == 1 && bh == 0 {
        if bl == 0 { return metal_cd_sign(al, 0, bits - 1) }
        return 0 - metal_cd_sign(al, bl, bits - 1)
    }
    if bl == 0 { return 0 - metal_cd_sign(0, al, bits - 1) }
    metal_cd_sign(bl, al, bits - 1)
}

fn metal_emit_xor_sign_table(buf: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = metal_push_str(buf, "constant char pireus_xor_sign[256] = {")
    var d: i64 = 0
    while d < 16 {
        var j: i64 = 0
        while j < 16 {
            if d != 0 || j != 0 { out = metal_push_str(out, ",") }
            if metal_cd_sign(d ^ j, j, 4) < 0 {
                out = metal_push_str(out, "-1")
            } else {
                out = metal_push_str(out, "1")
            }
            j = j + 1
        }
        d = d + 1
    }
    metal_push_str(out, "};\n\n")
}

// ============================================================================
// Kernel signature emission
// ============================================================================

fn metal_emit_kernel_signature(buf: MetalBuf, kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = metal_push_str(out, "kernel void ")
    out = metal_push_name(out, kernel.kernel_name)
    out = metal_push_str(out, "(\n")

    // Emit buffer parameters
    var pi: i64 = 0
    while pi < kernel.param_count {
        let param = kernel.params[pi as usize]
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, gpu_type_to_msl_param(param.ty))
        out = metal_push_str(out, " ")
        out = metal_push_name(out, param.name)
        out = metal_push_str(out, " [[buffer(")
        out = metal_push_i64(out, pi)
        out = metal_push_str(out, ")]]")
        if pi < kernel.param_count - 1 {
            out = metal_push_str(out, ",\n")
        } else {
            out = metal_push_str(out, ",\n")
        }
        pi = pi + 1
    }

    // Thread position in grid
    out = metal_push_str(out, "    uint tid [[thread_position_in_grid]],\n")
    out = metal_push_str(out, "    uint bid [[threadgroup_position_in_grid]],\n")
    out = metal_push_str(out, "    uint ntid [[threads_per_threadgroup]]\n")
    out = metal_push_str(out, ") {\n")
    out
}

// ============================================================================
// Variable declarations
// ============================================================================

fn metal_emit_var_decls(buf: MetalBuf, kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf

    // Declare registers based on max_reg counts
    // u32 registers
    if kernel.max_reg_u32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_u32 {
            out = metal_push_str(out, "    uint r")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // u64 / pointer registers
    if kernel.max_reg_u64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_u64 {
            out = metal_push_str(out, "    ulong rd")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // f32 registers
    if kernel.max_reg_f32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_f32 {
            out = metal_push_str(out, "    float f")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // f64 registers
    if kernel.max_reg_f64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_f64 {
            out = metal_push_str(out, "    ")
            out = metal_push_str(out, metal_f64_value_type(metal_default_f64_policy()))
            out = metal_push_str(out, " fd")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // i32 registers
    if kernel.max_reg_i32 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_i32 {
            out = metal_push_str(out, "    int sr")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // i64 registers
    if kernel.max_reg_i64 > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_i64 {
            out = metal_push_str(out, "    long srd")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // Predicate registers
    if kernel.max_reg_pred > 0 {
        var i: i64 = 0
        while i < kernel.max_reg_pred {
            out = metal_push_str(out, "    bool p")
            out = metal_push_i64(out, i)
            out = metal_push_str(out, ";\n")
            i = i + 1
        }
    }

    // Shared memory (threadgroup)
    if kernel.shared_bytes > 0 {
        out = metal_push_str(out, "    threadgroup float shared_mem[")
        out = metal_push_i64(out, kernel.shared_bytes / 4)
        out = metal_push_str(out, "];\n")
    }

    if metal_kernel_uses_lane_exchange(kernel) {
        out = metal_push_str(out, "    // Lane-exchange scratch (portable fallback for shuffle family)\n")
        out = metal_push_str(out, "    threadgroup uint __omega_shfl_u32[1024];\n")
        out = metal_push_str(out, "    threadgroup ulong __omega_shfl_u64[1024];\n")
        out = metal_push_str(out, "    threadgroup float __omega_shfl_f32[1024];\n")
        out = metal_push_str(out, "    threadgroup ")
        out = metal_push_str(out, metal_f64_value_type(metal_default_f64_policy()))
        out = metal_push_str(out, " __omega_shfl_f64[1024];\n")
        out = metal_push_str(out, "    threadgroup int __omega_shfl_i32[1024];\n")
        out = metal_push_str(out, "    threadgroup long __omega_shfl_i64[1024];\n")
        out = metal_push_str(out, "    uint __omega_local_tid = tid - (bid * ntid);\n")
        out = metal_push_str(out, "    uint __omega_lane = __omega_local_tid & 31u;\n")
        out = metal_push_str(out, "    uint __omega_warp_base = __omega_local_tid - __omega_lane;\n")
        out = metal_push_newline(out)
    }

    out = metal_push_newline(out)
    out
}

// ============================================================================
// MSL register name for a given register index and type
// ============================================================================

fn metal_reg_name(ty: GpuType, idx: i64) -> string with Mut, Panic, Div, Alloc {
    match ty {
        GpuType::GpuU32 => str_concat("r", metal_i64_to_string(idx)),
        GpuType::GpuU64 => str_concat("rd", metal_i64_to_string(idx)),
        GpuType::GpuF32 => str_concat("f", metal_i64_to_string(idx)),
        GpuType::GpuF64 => str_concat("fd", metal_i64_to_string(idx)),
        GpuType::GpuI32 => str_concat("sr", metal_i64_to_string(idx)),
        GpuType::GpuI64 => str_concat("srd", metal_i64_to_string(idx)),
        GpuType::GpuPtr => str_concat("rd", metal_i64_to_string(idx)),
        GpuType::GpuBool => str_concat("p", metal_i64_to_string(idx)),
        GpuType::GpuTf32 => str_concat("f", metal_i64_to_string(idx)),
        GpuType::GpuF16 => str_concat("h", metal_i64_to_string(idx)),
        GpuType::GpuB32 => str_concat("r", metal_i64_to_string(idx)),
        GpuType::GpuB64 => str_concat("rd", metal_i64_to_string(idx)),
    }
}

fn metal_kernel_uses_lane_exchange(kernel: GpuKernelIr) -> bool with Mut {
    var i: i64 = 0
    while i < kernel.op_count {
        let opc = kernel.ops[i as usize].opcode
        if opc == GpuOpcode::GpuShflDown
        || opc == GpuOpcode::GpuShflUp
        || opc == GpuOpcode::GpuShflBfly
        || opc == GpuOpcode::GpuShflIdx {
            return true
        }
        i = i + 1
    }
    false
}

fn metal_shuffle_lane_array(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32  => "__omega_shfl_u32",
        GpuType::GpuU64  => "__omega_shfl_u64",
        GpuType::GpuF32  => "__omega_shfl_f32",
        GpuType::GpuF64  => "__omega_shfl_f64",
        GpuType::GpuI32  => "__omega_shfl_i32",
        GpuType::GpuI64  => "__omega_shfl_i64",
        GpuType::GpuPtr  => "__omega_shfl_u64",
        GpuType::GpuBool => "__omega_shfl_u32",
        GpuType::GpuTf32 => "__omega_shfl_f32",
        GpuType::GpuF16  => "__omega_shfl_f32",
        GpuType::GpuB32  => "__omega_shfl_u32",
        GpuType::GpuB64  => "__omega_shfl_u64",
    }
}

// ============================================================================
// Phase 6 helpers: generic binary op and atomic binary op emitters
// ============================================================================

fn metal_emit_binop(buf: MetalBuf, op: GpuOp, sym: string) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
    out = metal_push_str(out, " = ")
    out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
    out = metal_push_str(out, " ")
    out = metal_push_str(out, sym)
    out = metal_push_str(out, " ")
    out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
    out = metal_push_str(out, ";\n")
    out
}

fn metal_emit_atomic_binop(buf: MetalBuf, op: GpuOp, fn_name: string) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
    out = metal_push_str(out, " = ")
    out = metal_push_str(out, fn_name)
    out = metal_push_str(out, "((device atomic_uint*)&")
    out = metal_push_str(out, metal_reg_name(op.ty, op.addr_reg))
    out = metal_push_str(out, ", ")
    out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
    out = metal_push_str(out, ", memory_order_relaxed);\n")
    out
}

// ============================================================================
// Lower operations → MSL statements
// ============================================================================

fn metal_lower_ops(buf: MetalBuf, kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    var i: i64 = 0
    let is_xor_convolution = metal_kernel_has_xor_convolution(kernel)

    while i < kernel.op_count {
        let op = kernel.ops[i as usize]
        // The seed IR places one unconditional terminal branch immediately
        // before the compound operator. Only that exact adjacency is replaced.
        let next_is_xor = i + 1 < kernel.op_count
            && kernel.ops[(i + 1) as usize].opcode == GpuOpcode::GpuXorConvolutionF64
        let is_compound_terminal_bra = is_xor_convolution
            && op.opcode == GpuOpcode::GpuBra && op.pred_reg < 0 && next_is_xor
        if !is_compound_terminal_bra {
            out = metal_lower_single_op(out, op, kernel)
        }
        i = i + 1
    }

    out
}

fn metal_lower_single_op(buf: MetalBuf, op: GpuOp, kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let opc = op.opcode

    // ---- GetTid ----
    if opc == GpuOpcode::GpuGetTid {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = tid;\n")
        return out
    }

    // ---- GetBid ----
    if opc == GpuOpcode::GpuGetBid {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = bid;\n")
        return out
    }

    // ---- GetNtid ----
    if opc == GpuOpcode::GpuGetNtid {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ntid;\n")
        return out
    }

    // ---- Add ----
    if opc == GpuOpcode::GpuAdd {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " + ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Sub ----
    if opc == GpuOpcode::GpuSub {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " - ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Mul ----
    if opc == GpuOpcode::GpuMul {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " * ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Div ----
    if opc == GpuOpcode::GpuDiv {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " / ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Fma ----
    if opc == GpuOpcode::GpuFma {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = fma(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }

    // ---- MulImm ----
    if opc == GpuOpcode::GpuMulImm {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, " * ")
        out = metal_push_i64(out, op.rhs_imm)
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- AddImm ----
    if opc == GpuOpcode::GpuAddImm {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, " + ")
        out = metal_push_i64(out, op.rhs_imm)
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Cvt ----
    if opc == GpuOpcode::GpuCvt {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.dst_ty, op.dst_reg))
        out = metal_push_str(out, " = (")
        out = metal_push_str(out, gpu_type_to_msl(op.dst_ty))
        out = metal_push_str(out, ")")
        out = metal_push_str(out, metal_reg_name(op.src_ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- LoadParam ----
    if opc == GpuOpcode::GpuLoadParam {
        let param = kernel.params[op.param_idx as usize]
        if metal_kernel_has_xor_convolution(kernel) && op.ty == GpuType::GpuPtr {
            out = metal_push_str(out, "    // ptr parameter consumed by Pireus float2 materializer: ")
            out = metal_push_name(out, param.name)
            out = metal_push_str(out, "\n")
            return out
        }
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = (")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, ")(ulong)")
        out = metal_push_name(out, param.name)
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- LoadGlobal ----
    if opc == GpuOpcode::GpuLoadGlobal {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0];\n")
        return out
    }

    // ---- LdGlobalCached ----
    // MSL does not expose explicit cache control for generic global loads.
    // Lower to regular device load and keep opcode intent in comment.
    if opc == GpuOpcode::GpuLdGlobalCached {
        out = metal_push_str(out, "    // cached load (lowered as standard device load)\n")
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0];\n")
        return out
    }

    // ---- StoreGlobal ----
    if opc == GpuOpcode::GpuStoreGlobal {
        out = metal_push_str(out, "    ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0] = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- LoadGlobalPred ----
    if opc == GpuOpcode::GpuLoadGlobalPred {
        out = metal_push_str(out, "    if (p")
        out = metal_push_i64(out, op.pred_reg)
        out = metal_push_str(out, ") {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0];\n")
        out = metal_push_str(out, "    } else {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = 0;\n")
        out = metal_push_str(out, "    }\n")
        return out
    }

    // ---- StoreGlobalPred ----
    if opc == GpuOpcode::GpuStoreGlobalPred {
        out = metal_push_str(out, "    if (p")
        out = metal_push_i64(out, op.pred_reg)
        out = metal_push_str(out, ") {\n")
        out = metal_push_str(out, "        ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0] = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        out = metal_push_str(out, "    }\n")
        return out
    }

    // ---- StGlobalWriteback ----
    // MSL has no direct writeback qualifier here; lower to normal global store.
    if opc == GpuOpcode::GpuStGlobalWriteback {
        out = metal_push_str(out, "    // writeback store (lowered as standard device store)\n")
        out = metal_push_str(out, "    ((device ")
        out = metal_push_str(out, gpu_type_to_msl(op.ty))
        out = metal_push_str(out, "*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ")[0] = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- LoadShared ----
    if opc == GpuOpcode::GpuLoadShared {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = shared_mem[")
        out = metal_push_i64(out, op.shared_addr / 4)
        out = metal_push_str(out, "];\n")
        return out
    }

    // ---- StoreShared ----
    if opc == GpuOpcode::GpuStoreShared {
        out = metal_push_str(out, "    shared_mem[")
        out = metal_push_i64(out, op.shared_addr / 4)
        out = metal_push_str(out, "] = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- LoadSharedPred ----
    if opc == GpuOpcode::GpuLoadSharedPred {
        out = metal_push_str(out, "    if (p")
        out = metal_push_i64(out, op.pred_reg)
        out = metal_push_str(out, ") {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = shared_mem[")
        out = metal_push_i64(out, op.shared_addr / 4)
        out = metal_push_str(out, "];\n")
        out = metal_push_str(out, "    } else {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = 0;\n")
        out = metal_push_str(out, "    }\n")
        return out
    }

    // ---- StoreSharedPred ----
    if opc == GpuOpcode::GpuStoreSharedPred {
        out = metal_push_str(out, "    if (p")
        out = metal_push_i64(out, op.pred_reg)
        out = metal_push_str(out, ") {\n")
        out = metal_push_str(out, "        shared_mem[")
        out = metal_push_i64(out, op.shared_addr / 4)
        out = metal_push_str(out, "] = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        out = metal_push_str(out, "    }\n")
        return out
    }

    // ---- BarrierSync ----
    if opc == GpuOpcode::GpuBarrierSync {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return out
    }

    // ---- Max ----
    if opc == GpuOpcode::GpuMax {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = max(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ");\n")
        return out
    }

    // ---- Min ----
    if opc == GpuOpcode::GpuMin {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = min(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ");\n")
        return out
    }

    // ---- AtomicAdd ----
    if opc == GpuOpcode::GpuAtomicAdd {
        out = metal_push_str(out, "    atomic_fetch_add_explicit((device atomic_uint*)")
        out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ", memory_order_relaxed);\n")
        return out
    }

    // ---- Prefetch ----
    // Portable MSL fallback: no-op with explicit marker.
    if opc == GpuOpcode::GpuPrefetch {
        out = metal_push_str(out, "    // prefetch: no-op on portable MSL path\n")
        return out
    }

    // ---- Warp shuffle family ----
    // Lane-exchange fallback using threadgroup scratch and lane math.
    if opc == GpuOpcode::GpuShflDown
    || opc == GpuOpcode::GpuShflUp
    || opc == GpuOpcode::GpuShflBfly
    || opc == GpuOpcode::GpuShflIdx {
        let dst_name = metal_reg_name(op.ty, op.dst_reg)
        let src_name = metal_reg_name(op.ty, op.src_reg)
        let lane_array = metal_shuffle_lane_array(op.ty)

        out = metal_push_str(out, "    ")
        out = metal_push_str(out, lane_array)
        out = metal_push_str(out, "[__omega_local_tid & 1023u] = ")
        out = metal_push_str(out, src_name)
        out = metal_push_str(out, ";\n")
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")

        if opc == GpuOpcode::GpuShflDown {
            if op.rhs_imm >= 0 {
                out = metal_push_str(out, "    uint __omega_lane_peer = __omega_lane + ")
                out = metal_push_i64(out, op.rhs_imm)
                out = metal_push_str(out, "u;\n")
            } else {
                out = metal_push_str(out, "    uint __omega_lane_peer = __omega_lane >= ")
                out = metal_push_i64(out, 0 - op.rhs_imm)
                out = metal_push_str(out, "u ? (__omega_lane - ")
                out = metal_push_i64(out, 0 - op.rhs_imm)
                out = metal_push_str(out, "u) : 32u;\n")
            }
        } else if opc == GpuOpcode::GpuShflUp {
            if op.rhs_imm >= 0 {
                out = metal_push_str(out, "    uint __omega_lane_peer = __omega_lane >= ")
                out = metal_push_i64(out, op.rhs_imm)
                out = metal_push_str(out, "u ? (__omega_lane - ")
                out = metal_push_i64(out, op.rhs_imm)
                out = metal_push_str(out, "u) : 32u;\n")
            } else {
                out = metal_push_str(out, "    uint __omega_lane_peer = __omega_lane + ")
                out = metal_push_i64(out, 0 - op.rhs_imm)
                out = metal_push_str(out, "u;\n")
            }
        } else if opc == GpuOpcode::GpuShflBfly {
            out = metal_push_str(out, "    uint __omega_lane_peer = __omega_lane ^ ")
            if op.rhs_imm >= 0 {
                out = metal_push_i64(out, op.rhs_imm)
            } else {
                out = metal_push_i64(out, 0 - op.rhs_imm)
            }
            out = metal_push_str(out, "u;\n")
        } else {
            if op.rhs_reg >= 0 {
                out = metal_push_str(out, "    uint __omega_lane_peer = (uint)")
                out = metal_push_str(out, metal_reg_name(GpuType::GpuU32, op.rhs_reg))
                out = metal_push_str(out, ";\n")
            } else {
                if op.rhs_imm >= 0 {
                    out = metal_push_str(out, "    uint __omega_lane_peer = ")
                    out = metal_push_i64(out, op.rhs_imm)
                    out = metal_push_str(out, "u;\n")
                } else {
                    out = metal_push_str(out, "    uint __omega_lane_peer = 32u;\n")
                }
            }
        }

        out = metal_push_str(out, "    if (__omega_lane_peer < 32u && (__omega_warp_base + __omega_lane_peer) < ntid) {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, dst_name)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, lane_array)
        out = metal_push_str(out, "[(__omega_warp_base + __omega_lane_peer) & 1023u];\n")
        out = metal_push_str(out, "    } else {\n")
        out = metal_push_str(out, "        ")
        out = metal_push_str(out, dst_name)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, src_name)
        out = metal_push_str(out, ";\n")
        out = metal_push_str(out, "    }\n")
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return out
    }

    // ---- Vote / Ballot ----
    if opc == GpuOpcode::GpuVote || opc == GpuOpcode::GpuBallot {
        var pred_expr = "false"
        if op.pred_reg >= 0 {
            pred_expr = str_concat("p", metal_i64_to_string(op.pred_reg))
        } else if op.src_reg >= 0 {
            pred_expr = str_concat(metal_reg_name(op.ty, op.src_reg), " != 0")
        }

        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ")
        if opc == GpuOpcode::GpuBallot {
            out = metal_push_str(out, "(")
            out = metal_push_str(out, pred_expr)
            out = metal_push_str(out, ") ? (1u << (__omega_lane & 31u)) : 0u;\n")
        } else {
            out = metal_push_str(out, "(")
            out = metal_push_str(out, pred_expr)
            out = metal_push_str(out, ") ? 1 : 0;\n")
        }
        return out
    }

    // ---- Tensor ops (WMMA/MMA/TMA) ----
    // These are represented as conservative no-op placeholders in MSL path.
    if opc == GpuOpcode::GpuWmma || opc == GpuOpcode::GpuMma {
        out = metal_push_str(out, "    // tensor op lowered as fallback on MSL path\n")
        if op.dst_reg >= 0 && op.src_reg >= 0 {
            out = metal_push_str(out, "    ")
            out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
            out = metal_push_str(out, " = ")
            out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
            out = metal_push_str(out, ";\n")
        }
        return out
    }
    if opc == GpuOpcode::GpuTmaLoad {
        out = metal_push_str(out, "    // tma.load lowered to regular load fallback\n")
        if op.dst_reg >= 0 && op.addr_reg >= 0 {
            out = metal_push_str(out, "    ")
            out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
            out = metal_push_str(out, " = ((device ")
            out = metal_push_str(out, gpu_type_to_msl(op.ty))
            out = metal_push_str(out, "*)")
            out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
            out = metal_push_str(out, ")[0];\n")
        }
        return out
    }
    if opc == GpuOpcode::GpuTmaStore {
        out = metal_push_str(out, "    // tma.store lowered to regular store fallback\n")
        if op.addr_reg >= 0 && op.src_reg >= 0 {
            out = metal_push_str(out, "    ((device ")
            out = metal_push_str(out, gpu_type_to_msl(op.ty))
            out = metal_push_str(out, "*)")
            out = metal_push_str(out, metal_reg_name(GpuType::GpuPtr, op.addr_reg))
            out = metal_push_str(out, ")[0] = ")
            out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
            out = metal_push_str(out, ";\n")
        }
        return out
    }

    // ---- Comparisons (SetpLt/Le/Eq/Ge/Gt/Ne) ----
    if opc == GpuOpcode::GpuSetpLt {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " < ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuSetpLe {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " <= ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuSetpEq {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " == ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuSetpGe {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " >= ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuSetpGt {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " > ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuSetpNe {
        out = metal_push_str(out, "    p")
        out = metal_push_i64(out, op.dst_reg)
        out = metal_push_str(out, " = ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " != ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Selp (predicate select) ----
    if opc == GpuOpcode::GpuSelp {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = p")
        out = metal_push_i64(out, op.src_reg)
        out = metal_push_str(out, " ? ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.lhs_reg))
        out = metal_push_str(out, " : ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.rhs_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Math intrinsics ----
    if opc == GpuOpcode::GpuSqrt {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = sqrt(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuRsqrt {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = rsqrt(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuExp2 {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = exp2(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuLg2 {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = log2(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuSin {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = sin(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuCos {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = cos(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuAbs {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = abs(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuRcp {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = 1.0 / ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }

    // ---- Special registers ----
    if opc == GpuOpcode::GpuGetLaneId {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = tid & 31;\n")
        return out
    }
    if opc == GpuOpcode::GpuGetWarpId {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = tid / 32;\n")
        return out
    }
    if opc == GpuOpcode::GpuGetSmId {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = 0; // SM id unavailable in portable MSL\n")
        return out
    }
    if opc == GpuOpcode::GpuGetGridDim {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ntid; // fallback: threads_per_threadgroup\n")
        return out
    }

    // ---- Branch ----
    // MSL linear emitter cannot materialize arbitrary PTX label targets.
    // Deterministic fallback: branch is approximated as early return.
    if opc == GpuOpcode::GpuBra {
        if op.pred_reg >= 0 {
            out = metal_push_str(out, "    if (p")
            out = metal_push_i64(out, op.pred_reg)
            out = metal_push_str(out, ") { return; } // bra fallback target L")
            out = metal_push_i64(out, op.rhs_imm)
            out = metal_push_str(out, "\n")
        } else {
            out = metal_push_str(out, "    return; // bra fallback target L")
            out = metal_push_i64(out, op.rhs_imm)
            out = metal_push_str(out, "\n")
        }
        return out
    }

    // ---- Ret ----
    if opc == GpuOpcode::GpuRet {
        out = metal_push_str(out, "    return;\n")
        return out
    }

    // ---- Exit ----
    if opc == GpuOpcode::GpuExit {
        out = metal_push_str(out, "    return;\n")
        return out
    }

    // Phase 6: Async copy (cp.async -> threadgroup_barrier in MSL)
    if opc == GpuOpcode::GpuCpAsync {
        out = metal_push_str(out, "    // cp.async: threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return out
    }
    if opc == GpuOpcode::GpuCpAsyncWait {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return out
    }
    if opc == GpuOpcode::GpuCpAsyncWaitAll {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
        return out
    }

    // Phase 6: Extended atomics
    if opc == GpuOpcode::GpuAtomicCas {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = atomic_compare_exchange_weak_explicit((device atomic_uint*)&")
        out = metal_push_str(out, metal_reg_name(op.ty, op.addr_reg))
        out = metal_push_str(out, ", &")
        out = metal_push_str(out, metal_reg_name(op.ty, op.compare_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ", memory_order_relaxed, memory_order_relaxed);\n")
        return out
    }
    if opc == GpuOpcode::GpuAtomicExch {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = atomic_exchange_explicit((device atomic_uint*)&")
        out = metal_push_str(out, metal_reg_name(op.ty, op.addr_reg))
        out = metal_push_str(out, ", ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ", memory_order_relaxed);\n")
        return out
    }
    if opc == GpuOpcode::GpuAtomicMin {
        out = metal_emit_atomic_binop(out, op, "atomic_fetch_min_explicit")
        return out
    }
    if opc == GpuOpcode::GpuAtomicMax {
        out = metal_emit_atomic_binop(out, op, "atomic_fetch_max_explicit")
        return out
    }
    if opc == GpuOpcode::GpuAtomicAnd {
        out = metal_emit_atomic_binop(out, op, "atomic_fetch_and_explicit")
        return out
    }
    if opc == GpuOpcode::GpuAtomicOr {
        out = metal_emit_atomic_binop(out, op, "atomic_fetch_or_explicit")
        return out
    }
    if opc == GpuOpcode::GpuAtomicXor {
        out = metal_emit_atomic_binop(out, op, "atomic_fetch_xor_explicit")
        return out
    }

    // Phase 6: Memory fences
    if opc == GpuOpcode::GpuFenceAcquire {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return out
    }
    if opc == GpuOpcode::GpuFenceRelease {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return out
    }
    if opc == GpuOpcode::GpuFenceAcqRel {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_device);\n")
        return out
    }
    if opc == GpuOpcode::GpuMembar {
        out = metal_push_str(out, "    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);\n")
        return out
    }

    // Phase 6: Mixed precision
    if opc == GpuOpcode::GpuCvtF32Tf32 {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = (float)(")
        out = metal_push_str(out, metal_reg_name(op.src_ty, op.src_reg))
        out = metal_push_str(out, "); // tf32 approx via f32\n")
        return out
    }
    if opc == GpuOpcode::GpuMmaTf32 {
        out = metal_push_str(out, "    // mma.tf32: not directly expressible in MSL 3.1\n")
        return out
    }
    if opc == GpuOpcode::GpuMmaF16 {
        out = metal_push_str(out, "    // mma.f16: not directly expressible in MSL 3.1\n")
        return out
    }

    // Phase 6: Bitwise / integer
    if opc == GpuOpcode::GpuAnd {
        out = metal_emit_binop(out, op, "&")
        return out
    }
    if opc == GpuOpcode::GpuOr {
        out = metal_emit_binop(out, op, "|")
        return out
    }
    if opc == GpuOpcode::GpuXor {
        out = metal_emit_binop(out, op, "^")
        return out
    }
    if opc == GpuOpcode::GpuNot {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = ~")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ";\n")
        return out
    }
    if opc == GpuOpcode::GpuShl {
        out = metal_emit_binop(out, op, "<<")
        return out
    }
    if opc == GpuOpcode::GpuShr {
        out = metal_emit_binop(out, op, ">>")
        return out
    }
    if opc == GpuOpcode::GpuShra {
        out = metal_emit_binop(out, op, ">>")
        return out
    }
    if opc == GpuOpcode::GpuClz {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = clz(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }
    if opc == GpuOpcode::GpuPopc {
        out = metal_push_str(out, "    ")
        out = metal_push_str(out, metal_reg_name(op.ty, op.dst_reg))
        out = metal_push_str(out, " = popcount(")
        out = metal_push_str(out, metal_reg_name(op.ty, op.src_reg))
        out = metal_push_str(out, ");\n")
        return out
    }

    if opc == GpuOpcode::GpuXorConvolutionF64 {
        out = metal_push_str(out, "    // pireus.recipe=xor-shuffle+sign-xor+twofold-mul+compensated-reduce\n")
        out = metal_push_str(out, "    // pireus.equivalence=APPROXIMATE pireus.storage=float2-hi-lo\n")
        out = metal_push_str(out, "    // pireus.source_semantics=f64x16 pireus.material_abi=float2x16\n")
        out = metal_push_str(out, "    // pireus.requires_pack=f64-to-twofold-float2\n")
        out = metal_push_str(out, "    if (tid < 16u) {\n")
        out = metal_push_str(out, "        device const float2* __a = (device const float2*)")
        out = metal_push_name(out, kernel.params[0].name)
        out = metal_push_str(out, ";\n        device const float2* __b = (device const float2*)")
        out = metal_push_name(out, kernel.params[1].name)
        out = metal_push_str(out, ";\n        device float2* __out = (device float2*)")
        out = metal_push_name(out, kernel.params[2].name)
        out = metal_push_str(out, ";\n        float2 __acc = float2(0.0f);\n")
        out = metal_push_str(out, "        for (uint __j = 0u; __j < 16u; ++__j) {\n")
        out = metal_push_str(out, "            uint __ai = tid ^ __j;\n")
        out = metal_push_str(out, "            float2 __av = __a[__ai];\n")
        out = metal_push_str(out, "            float2 __bv = __b[__j];\n")
        out = metal_push_str(out, "            float __p = __av.x * __bv.x;\n")
        out = metal_push_str(out, "            float __e = fma(__av.x, __bv.x, -__p) + __av.x * __bv.y + __av.y * __bv.x;\n")
        out = metal_push_str(out, "            float __sgn = (float)pireus_xor_sign[tid * 16u + __j];\n")
        out = metal_push_str(out, "            __p *= __sgn;\n            __e *= __sgn;\n")
        out = metal_push_str(out, "            float __s = __acc.x + __p;\n            float __bb = __s - __acc.x;\n")
        out = metal_push_str(out, "            float __err = (__acc.x - (__s - __bb)) + (__p - __bb) + __acc.y + __e;\n")
        out = metal_push_str(out, "            float __hi = __s + __err;\n")
        out = metal_push_str(out, "            float __lo = __err - (__hi - __s);\n")
        out = metal_push_str(out, "            __acc = float2(__hi, __lo);\n")
        out = metal_push_str(out, "        }\n        __out[tid] = __acc;\n    }\n")
        return out
    }

    // Phase 6: Cooperative groups
    if opc == GpuOpcode::GpuCgTiledPartition {
        out = metal_push_str(out, "    // cg::tiled_partition: use simd_group in MSL\n")
        return out
    }
    if opc == GpuOpcode::GpuCgSync {
        out = metal_push_str(out, "    simdgroup_barrier(mem_flags::mem_none);\n")
        return out
    }
    if opc == GpuOpcode::GpuCgReduce {
        out = metal_push_str(out, "    // cg::reduce: use simd_sum/simd_min/simd_max\n")
        return out
    }

    // Default: comment for unhandled opcode
    out = metal_push_str(out, "    // unhandled opcode\n")
    out
}

// ============================================================================
// Main entry: GpuKernelIr → MetalBuf
// ============================================================================

pub fn gpu_lower_to_metal(kernel: GpuKernelIr) -> MetalBuf with Mut, Panic, Div, Alloc {
    var buf = metal_buf_new()
    buf = metal_emit_header(buf)
    if metal_kernel_has_xor_convolution(kernel) { buf = metal_emit_xor_sign_table(buf) }
    buf = metal_emit_kernel_signature(buf, kernel)
    buf = metal_emit_var_decls(buf, kernel)
    buf = metal_lower_ops(buf, kernel)
    buf = metal_push_str(buf, "}\n")
    buf
}

// ============================================================================
// Phase 4A: Math intrinsic emission helpers
// ============================================================================
// Standalone emitters for each math intrinsic.  Each takes a MetalBuf,
// a destination register name, and a source register name, then emits
// the corresponding MSL statement: "    dst = func(src);\n"

fn metal_emit_sqrt(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = sqrt(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_rsqrt(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = rsqrt(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_exp2(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = exp2(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_log2(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = log2(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_sin(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = sin(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

fn metal_emit_cos(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = cos(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
