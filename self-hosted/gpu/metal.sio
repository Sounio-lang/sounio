fn metal_emit_cvt_f32_to_f64(buf: MetalBuf, dst: string, src: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    ")
    out = metal_push_str(out, dst)
    out = metal_push_str(out, " = static_cast<")
    out = metal_push_str(out, metal_f64_value_type(metal_default_f64_policy()))
    out = metal_push_str(out, ">(")
    out = metal_push_str(out, src)
    out = metal_push_str(out, ");\n")
    out
}

// ============================================================================
// Metal-first algebraic kernel witnesses
// ============================================================================

fn metal_emit_vec_add_f32() -> MetalBuf with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_push_str(b, "#include <metal_stdlib>\n")
    b = metal_push_str(b, "using namespace metal;\n\n")
    b = metal_push_str(b, "kernel void vec_add(\n")
    b = metal_push_str(b, "    device const float* a [[buffer(0)]],\n")
    b = metal_push_str(b, "    device const float* b_in [[buffer(1)]],\n")
    b = metal_push_str(b, "    device float* c [[buffer(2)]],\n")
    b = metal_push_str(b, "    uint tid [[thread_position_in_grid]]\n")
    b = metal_push_str(b, ")\n")
    b = metal_push_str(b, "{\n")
    b = metal_push_str(b, "    c[tid] = a[tid] + b_in[tid];\n")
    b = metal_push_str(b, "}\n")
    b
}

fn metal_emit_epistemic_dual_output_f32() -> MetalBuf with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_push_str(b, "#include <metal_stdlib>\n")
    b = metal_push_str(b, "using namespace metal;\n\n")
    b = metal_push_str(b, "kernel void epistemic_dual_output_f32(\n")
    b = metal_push_str(b, "    device const float* a_value [[buffer(0)]],\n")
    b = metal_push_str(b, "    device const float* b_value [[buffer(1)]],\n")
    b = metal_push_str(b, "    device const float* a_eps [[buffer(2)]],\n")
    b = metal_push_str(b, "    device const float* b_eps [[buffer(3)]],\n")
    b = metal_push_str(b, "    device const uint* a_valid [[buffer(4)]],\n")
    b = metal_push_str(b, "    device const uint* b_valid [[buffer(5)]],\n")
    b = metal_push_str(b, "    device float* out_value [[buffer(6)]],\n")
    b = metal_push_str(b, "    device float* out_eps [[buffer(7)]],\n")
    b = metal_push_str(b, "    device uint* out_valid [[buffer(8)]],\n")
    b = metal_push_str(b, "    device uint* out_prov [[buffer(9)]],\n")
    b = metal_push_str(b, "    uint tid [[thread_position_in_grid]]\n")
    b = metal_push_str(b, ")\n")
    b = metal_push_str(b, "{\n")
    b = metal_push_str(b, "    out_value[tid] = a_value[tid] + b_value[tid];\n")
    b = metal_push_str(b, "    out_eps[tid] = (a_eps[tid] * a_eps[tid]) + (b_eps[tid] * b_eps[tid]);\n")
    b = metal_push_str(b, "    out_valid[tid] = a_valid[tid] & b_valid[tid];\n")
    b = metal_push_str(b, "    out_prov[tid] = (tid ^ 0x12345678u) ^ out_valid[tid];\n")
    b = metal_push_str(b, "}\n")
    b
}

fn metal_emit_ossm_oct_step_f64_checked() -> MetalBuf with Mut, Panic, Div {
    var out = metal_buf_new()
    out = metal_emit_header(out)
    out = metal_push_str(out, "// sounio.source_semantics=f64\n")
    out = metal_push_str(out, "// sounio.metal_f64_policy=f32_checked\n")
    out = metal_push_str(out, "// sounio.algebra_law_profile=octonion:alternative,non_associative,epistemic_shadow\n")
    out = metal_push_str(out, "kernel void ossm_oct_step_f64_checked(\n")
    out = metal_push_str(out, "    device int* n [[buffer(0)]],\n")
    out = metal_push_str(out, "    device float* state [[buffer(1)]],\n")
    out = metal_push_str(out, "    device float* out_buf [[buffer(2)]],\n")
    out = metal_push_str(out, "    device float* shadow [[buffer(3)]],\n")
    out = metal_push_str(out, "    uint tid [[thread_position_in_grid]]) {\n")
    out = metal_push_str(out, "    if ((int)tid >= n[0]) return;\n")
    out = metal_push_str(out, "    int upper = (int)tid + 64;\n")
    out = metal_push_str(out, "    float h0 = state[(int)tid];\n")
    out = metal_push_str(out, "    float h1 = state[upper];\n")
    out = metal_push_str(out, "    float x0 = h0 + 1.0f;\n")
    out = metal_push_str(out, "    float x1 = h1 + 0.25f;\n")
    out = metal_push_str(out, "    float ah0 = (0.5f * h0) - (0.125f * h1);\n")
    out = metal_push_str(out, "    float ah1 = (0.5f * h1) + (0.125f * h0);\n")
    out = metal_push_str(out, "    float bx0 = (0.25f * x0) - (0.5f * x1);\n")
    out = metal_push_str(out, "    float bx1 = (0.25f * x1) + (0.5f * x0);\n")
    out = metal_push_str(out, "    float next0 = ah0 + bx0;\n")
    out = metal_push_str(out, "    float next1 = ah1 + bx1;\n")
    out = metal_push_str(out, "    float energy = (next0 * next0) + (next1 * next1);\n")
    out = metal_push_str(out, "    out_buf[(int)tid] = next0;\n")
    out = metal_push_str(out, "    out_buf[upper] = next1;\n")
    out = metal_push_str(out, "    shadow[(int)tid] = energy + 0.015625f;\n")
    out = metal_push_str(out, "}\n")
    out
}

fn metal_emit_sedenion_cd_step_f64_checked() -> MetalBuf with Mut, Panic, Div {
    var out = metal_buf_new()
    out = metal_emit_header(out)
    metal_push_str_mut(&! out, "// sounio.source_semantics=f64\n")
    metal_push_str_mut(&! out, "// sounio.metal_f64_policy=f32_checked\n")
    metal_push_str_mut(&! out, "// sounio.algebra_law_profile=sedenion:cayley_dickson,non_associative,zero_divisor_sensitive,epistemic_shadow\n")
    metal_push_str_mut(&! out, "kernel void sedenion_cd_step_f64_checked(\n")
    metal_push_str_mut(&! out, "    device int* n [[buffer(0)]],\n")
    metal_push_str_mut(&! out, "    device float* state [[buffer(1)]],\n")
    metal_push_str_mut(&! out, "    device float* out_buf [[buffer(2)]],\n")
    metal_push_str_mut(&! out, "    device float* shadow [[buffer(3)]],\n")
    metal_push_str_mut(&! out, "    uint tid [[thread_position_in_grid]]) {\n")
    metal_push_str_mut(&! out, "    if ((int)tid >= n[0]) return;\n")
    metal_push_str_mut(&! out, "    int o1 = (int)tid + 64;\n")
    metal_push_str_mut(&! out, "    int o2 = (int)tid + 128;\n")
    metal_push_str_mut(&! out, "    int o3 = (int)tid + 192;\n")
    metal_push_str_mut(&! out, "    float lo0 = state[(int)tid];\n")
    metal_push_str_mut(&! out, "    float lo1 = state[o1];\n")
    metal_push_str_mut(&! out, "    float hi0 = state[o2];\n")
    metal_push_str_mut(&! out, "    float hi1 = state[o3];\n")
    metal_push_str_mut(&! out, "    float x0 = lo0 + 1.0f;\n")
    metal_push_str_mut(&! out, "    float x1 = 0.5f;\n")
    metal_push_str_mut(&! out, "    float lo_mul0 = (lo0 * x0) - (lo1 * x1);\n")
    metal_push_str_mut(&! out, "    float lo_mul1 = (lo0 * x1) + (lo1 * x0);\n")
    metal_push_str_mut(&! out, "    float hi_mul0 = (0.25f * hi0) - (0.125f * hi1);\n")
    metal_push_str_mut(&! out, "    float hi_mul1 = (0.25f * hi1) + (0.125f * hi0);\n")
    metal_push_str_mut(&! out, "    float cd_lo0 = lo_mul0 - hi_mul0;\n")
    metal_push_str_mut(&! out, "    float cd_hi0 = hi_mul1 + lo_mul1;\n")
    metal_push_str_mut(&! out, "    float norm_shadow = (cd_lo0 * cd_lo0) + (cd_hi0 * cd_hi0);\n")
    metal_push_str_mut(&! out, "    out_buf[(int)tid] = cd_lo0;\n")
    metal_push_str_mut(&! out, "    out_buf[o1] = cd_hi0;\n")
    metal_push_str_mut(&! out, "    shadow[(int)tid] = norm_shadow + 0.015625f;\n")
    metal_push_str_mut(&! out, "}\n")
    out
}

// ============================================================================
// Phase 4A: Extended comparison emission helpers
// ============================================================================

fn metal_emit_setp_gt(buf: MetalBuf, pred_dst: string, lhs: string, rhs: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    bool ")
    out = metal_push_str(out, pred_dst)
    out = metal_push_str(out, " = ")
    out = metal_push_str(out, lhs)
    out = metal_push_str(out, " > ")
    out = metal_push_str(out, rhs)
    out = metal_push_str(out, ";\n")
    out
}

fn metal_emit_setp_ne(buf: MetalBuf, pred_dst: string, lhs: string, rhs: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    bool ")
    out = metal_push_str(out, pred_dst)
    out = metal_push_str(out, " = ")
    out = metal_push_str(out, lhs)
    out = metal_push_str(out, " != ")
    out = metal_push_str(out, rhs)
    out = metal_push_str(out, ";\n")
    out
}

// ============================================================================
// Phase 4A: Control flow emission helpers
// ============================================================================

fn metal_emit_bra(buf: MetalBuf, label: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    // control: branch ")
    out = metal_push_str(out, label)
    out = metal_push_str(out, "\n")
    out
}

fn metal_emit_label(buf: MetalBuf, name: string) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    // label: ")
    out = metal_push_str(out, name)
    out = metal_push_str(out, "\n")
    out
}

fn metal_emit_exit(buf: MetalBuf) -> MetalBuf with Mut, Panic, Div {
    var out = buf
    out = metal_push_str(out, "    return;\n")
    out
}

// ============================================================================
// Self-check: smoke tests for Metal MSL codegen
// ============================================================================

fn metal_self_check_buf_push() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_push_str(b, "hello")
    metal_buf_contains(b, "hello")
}

fn metal_self_check_math_sqrt() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_sqrt(b, "v0", "v1")
    metal_buf_contains(b, "sqrt(v1)")
}

fn metal_self_check_math_rsqrt() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_rsqrt(b, "v0", "v1")
    metal_buf_contains(b, "rsqrt(v1)")
}

fn metal_self_check_math_sin_cos() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_sin(b, "v0", "v1")
    b = metal_emit_cos(b, "v2", "v3")
    metal_buf_contains(b, "sin(v1)") &&
    metal_buf_contains(b, "cos(v3)")
}

fn metal_self_check_cvt_f32_to_i32() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_cvt_f32_to_i32(b, "r0", "f0")
    metal_buf_contains(b, "static_cast<int>(f0)")
}

fn metal_self_check_cvt_i32_to_f32() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_cvt_i32_to_f32(b, "f0", "r0")
    metal_buf_contains(b, "static_cast<float>(r0)")
}

fn metal_self_check_setp_gt() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_setp_gt(b, "p0", "a", "b")
    metal_buf_contains(b, "a > b")
}

fn metal_self_check_setp_ne() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_setp_ne(b, "p0", "a", "b")
    metal_buf_contains(b, "a != b")
}

fn metal_self_check_exit() -> bool with Mut, Panic, Div {
    var b = metal_buf_new()
    b = metal_emit_exit(b)
    metal_buf_contains(b, "return;")
}

fn metal_self_check() -> bool with Mut, Panic, Div {
    let t1 = metal_self_check_buf_push()
    let t2 = metal_self_check_math_sqrt()
    let t3 = metal_self_check_math_rsqrt()
    let t4 = metal_self_check_math_sin_cos()
    let t5 = metal_self_check_cvt_f32_to_i32()
    let t6 = metal_self_check_cvt_i32_to_f32()
    let t7 = metal_self_check_setp_gt()
    let t8 = metal_self_check_setp_ne()
    let t9 = metal_self_check_exit()
    t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9
}

fn gpu_metal_main() -> i32 with IO, Mut, Panic, Div {
    let ok = metal_self_check()
    if ok {
        print("PASS metal_self_check\n")
        return 0 as i32
    } else {
        print("FAIL metal_self_check\n")
        return 1 as i32
    }
}
