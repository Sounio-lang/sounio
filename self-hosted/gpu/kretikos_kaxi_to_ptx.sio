// self-hosted/gpu/kretikos_kaxi_to_ptx.sio
// Kretikos K-AXI → PTX driver — produces ptxas-assemblable PTX from a named
// K-AXI pattern, going through the kaxi_to_ptx transpiler.
//
// Usage: souc kretikos_kaxi_to_ptx.sio /tmp/driver.elf
//        /tmp/driver.elf <pattern> [<mode>]
//
// Mode forms accepted (any position after pattern, or as flags before it):
//   short:  epistemic | f32 | f32e | f32-2c | f32-gum
//   long :  --epistemic | --f32 | --f32-epistemic | --f32-2c | --f32-gum
// Default (no mode) emits f64 base PTX.
//
// Same pattern names as `kretikos emit-kaxi`. Output is PTX text on stdout.

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*
use gpu::kretikos_emit_kaxi::*
use gpu::erdos90_hc_smoke_emit::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_kaxi_to_ptx: error - expected <pattern> [mode]")
        return 1
    }

    var pattern: string = ""
    var epistemic: bool = false
    var f32_mode: bool = false
    var f32_epistemic: bool = false
    var f32_2c: bool = false
    var f32_gum: bool = false

    var i: i64 = 0
    while i < argc {
        let a = get_arg(i)
        if str_eq(a, "--epistemic") {
            epistemic = true
        } else if str_eq(a, "epistemic") {
            epistemic = true
        } else if str_eq(a, "--f32-epistemic") {
            f32_epistemic = true
        } else if str_eq(a, "f32e") {
            f32_epistemic = true
        } else if str_eq(a, "--f32-2c") {
            f32_2c = true
        } else if str_eq(a, "f32-2c") {
            f32_2c = true
        } else if str_eq(a, "--f32-gum") {
            f32_gum = true
        } else if str_eq(a, "f32-gum") {
            f32_gum = true
        } else if str_eq(a, "--f32") {
            f32_mode = true
        } else if str_eq(a, "f32") {
            f32_mode = true
        } else if str_eq(pattern, "") {
            pattern = a
        }
        i = i + 1
    }

    if str_eq(pattern, "") {
        println("kretikos_kaxi_to_ptx: error - missing <pattern> argument")
        return 1
    }
    var buf: KaxiAsmBuf

    if str_eq(pattern, "exit_only") {
        buf = kaxi_emit_exit_only_asm()
    } else if str_eq(pattern, "vec_add") {
        buf = kaxi_emit_vec_add_asm()
    } else if str_eq(pattern, "vec_sub") {
        buf = kaxi_emit_vec_sub_asm()
    } else if str_eq(pattern, "vec_mul") {
        buf = kaxi_emit_vec_mul_asm()
    } else if str_eq(pattern, "vec_div") {
        buf = kaxi_emit_vec_div_asm()
    } else if str_eq(pattern, "vec_min") {
        buf = kaxi_emit_vec_min_asm()
    } else if str_eq(pattern, "vec_max") {
        buf = kaxi_emit_vec_max_asm()
    } else if str_eq(pattern, "vec_abs") {
        buf = kaxi_emit_vec_abs_asm()
    } else if str_eq(pattern, "vec_neg") {
        buf = kaxi_emit_vec_neg_asm()
    } else if str_eq(pattern, "vec_sqrt") {
        buf = kaxi_emit_vec_sqrt_asm()
    } else if str_eq(pattern, "vec_recip") {
        buf = kaxi_emit_vec_recip_asm()
    } else if str_eq(pattern, "vec_lg2") {
        buf = kaxi_emit_vec_lg2_asm()
    } else if str_eq(pattern, "vec_ex2") {
        buf = kaxi_emit_vec_ex2_asm()
    } else if str_eq(pattern, "vec_sin") {
        buf = kaxi_emit_vec_sin_asm()
    } else if str_eq(pattern, "vec_cos") {
        buf = kaxi_emit_vec_cos_asm()
    } else if str_eq(pattern, "vec_rsqrt") {
        buf = kaxi_emit_vec_rsqrt_asm()
    } else if str_eq(pattern, "vec_conf_sqrt") {
        buf = kaxi_emit_vec_conf_sqrt_asm()
    } else if str_eq(pattern, "vec_sqrt_gate_var") {
        buf = kaxi_emit_vec_sqrt_gate_var_asm()
    } else if str_eq(pattern, "vec_sqrt_gate_var_mb") {
        buf = kaxi_emit_vec_sqrt_gate_var_mb_asm()
    } else if str_eq(pattern, "fma") {
        buf = kaxi_emit_fma_asm()
    } else if str_eq(pattern, "source_vec_add_f64") {
        buf = kaxi_emit_source_vec_add_f64_asm()
    } else if str_eq(pattern, "source_vec_sub_f64") {
        buf = kaxi_emit_source_vec_sub_f64_asm()
    } else if str_eq(pattern, "source_vec_mul_f64") {
        buf = kaxi_emit_source_vec_mul_f64_asm()
    } else if str_eq(pattern, "source_vec_div_f64") {
        buf = kaxi_emit_source_vec_div_f64_asm()
    } else if str_eq(pattern, "source_fma_f64") {
        buf = kaxi_emit_source_fma_f64_asm()
    } else if str_eq(pattern, "source_vec_add_f32") {
        buf = kaxi_emit_source_vec_add_f32_asm()
    } else if str_eq(pattern, "source_vec_sub_f32") {
        buf = kaxi_emit_source_vec_sub_f32_asm()
    } else if str_eq(pattern, "source_vec_mul_f32") {
        buf = kaxi_emit_source_vec_mul_f32_asm()
    } else if str_eq(pattern, "source_vec_div_f32") {
        buf = kaxi_emit_source_vec_div_f32_asm()
    } else if str_eq(pattern, "source_fma_f32") {
        buf = kaxi_emit_source_fma_f32_asm()
    } else if str_eq(pattern, "source_vec_add_i32") {
        buf = kaxi_emit_source_vec_add_i32_asm()
    } else if str_eq(pattern, "source_vec_mul_i32") {
        buf = kaxi_emit_source_vec_mul_i32_asm()
    } else if str_eq(pattern, "source_epistemic_dual_output_f32") {
        buf = kaxi_emit_source_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "epistemic_elementwise_f32") {
        buf = kaxi_emit_epistemic_elementwise_f32_asm()
    } else if str_eq(pattern, "epistemic_dual_output_f32") {
        buf = kaxi_emit_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "mb_vec_double_f32") {
        buf = kaxi_emit_mb_vec_double_f32_asm()
    } else if str_eq(pattern, "pbpk_euler") {
        buf = kaxi_emit_pbpk_euler_asm()
    } else if str_eq(pattern, "pbpk_4step") {
        buf = kaxi_emit_pbpk_4step_asm()
    } else if str_eq(pattern, "pbpk_8step") {
        buf = kaxi_emit_pbpk_8step_asm()
    } else if str_eq(pattern, "pbpk_2comp") {
        buf = kaxi_emit_pbpk_2comp_asm()
    } else if str_eq(pattern, "pbpk_2comp_4step") {
        buf = kaxi_emit_pbpk_2comp_4step_asm()
    } else if str_eq(pattern, "atomic_sum_f32") {
        buf = kaxi_emit_atomic_sum_f32_asm()
    } else if str_eq(pattern, "pbpk_2comp_mb") {
        buf = kaxi_emit_pbpk_2comp_mb_asm()
    } else if str_eq(pattern, "pbpk_2comp_4step_mb") {
        buf = kaxi_emit_pbpk_2comp_4step_mb_asm()
    } else if str_eq(pattern, "x4_tree") {
        buf = kaxi_emit_x4_tree_asm()
    } else if str_eq(pattern, "x4_chain") {
        buf = kaxi_emit_x4_chain_asm()
    } else if str_eq(pattern, "pbpk_rapamycin_1comp_epistemic") {
        buf = kaxi_emit_pbpk_rapamycin_1comp_epistemic_asm()
    } else if str_eq(pattern, "pbpk_2comp_epistemic") {
        buf = kaxi_emit_pbpk_2comp_epistemic_asm()
    } else if str_eq(pattern, "pbpk_2comp_epistemic_4step") {
        buf = kaxi_emit_pbpk_2comp_epistemic_4step_asm()
    } else if str_eq(pattern, "pbpk_traj_4step") {
        buf = kaxi_emit_pbpk_traj_4step_asm()
    } else if str_eq(pattern, "conf_gate") {
        buf = kaxi_emit_conf_gate_asm()
    } else if str_eq(pattern, "octonion_assoc") {
        buf = kaxi_emit_octonion_assoc_asm()
    } else if str_eq(pattern, "octonion_mul") {
        buf = kaxi_emit_octonion_mul_asm()
    } else if str_eq(pattern, "octonion_associator") {
        buf = kaxi_emit_octonion_associator_asm()
    } else if str_eq(pattern, "octonion_assoc_norm_sum") {
        buf = kaxi_emit_octonion_assoc_norm_sum_asm()
    } else if str_eq(pattern, "sedenion_mul") {
        buf = kaxi_emit_sedenion_mul_asm()
    } else if str_eq(pattern, "sedenion_sqr") {
        buf = kaxi_emit_sedenion_sqr_asm()
    } else if str_eq(pattern, "sedenion_sqr_mb") {
        buf = kaxi_emit_sedenion_sqr_mb_asm()
    } else if str_eq(pattern, "sedenion_associator") {
        buf = kaxi_emit_sedenion_associator_asm()
    } else if str_eq(pattern, "pbpk_2comp_gum_4step") {
        buf = kaxi_emit_pbpk_2comp_gum_4step_asm()
    } else if str_eq(pattern, "erdos90_hc_smoke") {
        kaxi_emit_erdos90_hc_smoke_build()
        let hc_mode: i64 = if epistemic {
            1
        } else if f32_epistemic {
            4
        } else if f32_2c {
            3
        } else if f32_gum {
            5
        } else if f32_mode {
            2
        } else {
            0
        }
        let hc_buf = kaxi_emit_erdos90_hc_smoke_asm()
        let ptx = kaxi_transpile_to_ptx_unified(hc_buf, hc_mode)
        print(ptx)
        return 0
    } else {
        print("kretikos_kaxi_to_ptx: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    // Phase C.1: collapse 6-way dispatch to single PtxMode tag (i64).
    //   0=default, 1=epistemic, 2=f32, 3=f32_2c, 4=f32_epistemic, 5=f32_gum.
    let mode_id: i64 = if epistemic {
        1
    } else if f32_epistemic {
        4
    } else if f32_2c {
        3
    } else if f32_gum {
        5
    } else if f32_mode {
        2
    } else {
        0
    }
    let ptx = kaxi_transpile_to_ptx_unified(buf, mode_id)
    print(ptx)
    0
}
