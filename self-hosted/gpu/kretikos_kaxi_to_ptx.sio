// self-hosted/gpu/kretikos_kaxi_to_ptx.sio
// Kretikos K-AXI → PTX driver — produces ptxas-assemblable PTX from a named
// K-AXI pattern, going through the kaxi_to_ptx transpiler.
//
// Usage: souc kretikos_kaxi_to_ptx.sio /tmp/driver.elf
//        /tmp/driver.elf <pattern>
//
// Same pattern names as `kretikos emit-kaxi`. Output is PTX text on stdout.

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*
use gpu::kretikos_emit_kaxi::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_kaxi_to_ptx: error - expected <pattern> [epistemic]")
        return 1
    }

    let pattern = get_arg(0)
    var epistemic: bool = false
    if argc >= 2 {
        let mode = get_arg(1)
        if str_eq(mode, "epistemic") {
            epistemic = true
        }
    }
    var buf: KaxiAsmBuf

    if str_eq(pattern, "exit_only") {
        buf = kaxi_emit_exit_only_asm()
    } else if str_eq(pattern, "vec_add") {
        buf = kaxi_emit_vec_add_asm()
    } else if str_eq(pattern, "vec_sub") {
        buf = kaxi_emit_vec_sub_asm()
    } else if str_eq(pattern, "vec_mul") {
        buf = kaxi_emit_vec_mul_asm()
    } else if str_eq(pattern, "vec_div") {
        buf = kaxi_emit_vec_div_asm()
    } else if str_eq(pattern, "fma") {
        buf = kaxi_emit_fma_asm()
    } else if str_eq(pattern, "source_vec_add_f32") {
        buf = kaxi_emit_source_vec_add_f32_asm()
    } else if str_eq(pattern, "source_vec_sub_f32") {
        buf = kaxi_emit_source_vec_sub_f32_asm()
    } else if str_eq(pattern, "source_vec_mul_f32") {
        buf = kaxi_emit_source_vec_mul_f32_asm()
    } else if str_eq(pattern, "source_vec_div_f32") {
        buf = kaxi_emit_source_vec_div_f32_asm()
    } else if str_eq(pattern, "source_fma_f32") {
        buf = kaxi_emit_source_fma_f32_asm()
    } else if str_eq(pattern, "source_epistemic_dual_output_f32") {
        buf = kaxi_emit_source_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "epistemic_elementwise_f32") {
        buf = kaxi_emit_epistemic_elementwise_f32_asm()
    } else if str_eq(pattern, "epistemic_dual_output_f32") {
        buf = kaxi_emit_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "mb_vec_double_f32") {
        buf = kaxi_emit_mb_vec_double_f32_asm()
    } else {
        print("kretikos_kaxi_to_ptx: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    let ptx = if epistemic {
        kaxi_transpile_to_ptx_epistemic(buf)
    } else {
        kaxi_transpile_to_ptx(buf)
    }
    print(ptx)
    0
}
