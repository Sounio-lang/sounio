// ============================================================================
// Section 6 — GpuOpEntry
// ============================================================================

pub struct GpuOpEntry {
    pub opcode: i64,
    pub type_tag: i64,
    pub dst_idx: i64,
    pub src0: i64,
    pub src1: i64,
    pub src2: i64,
    pub imm_int: i64,
    pub imm_f32: f32,
    pub pred: i64,
    pub axis: i64,
}

pub fn gpu_op_entry_default() -> GpuOpEntry {
    GpuOpEntry {
        opcode: 0,
        type_tag: 0,
        dst_idx: -1,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: 0,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

// ============================================================================
// Section 7 — GpuBlockEntry
// ============================================================================

pub struct GpuBlockEntry {
    pub id: i64,
    pub ops: [GpuOpEntry; 4096],
    pub op_count: i64,
    pub term_tag: i64,
    pub term_src: i64,
    pub term_target0: i64,
    pub term_target1: i64,
}

pub fn gpu_block_entry_default() -> GpuBlockEntry {
    GpuBlockEntry {
        id: -1,
        ops: [gpu_op_entry_default(); 4096],
        op_count: 0,
        term_tag: HlirTermRetVoid,
        term_src: -1,
        term_target0: -1,
        term_target1: -1,
    }
}

// ============================================================================
// Section 8 — GpuParamEntry
// ============================================================================

pub struct GpuParamEntry {
    pub name: [i8; 64],
    pub name_len: i64,
    pub type_tag: i64,
    pub is_restrict: bool,
}

pub fn gpu_param_entry_default() -> GpuParamEntry {
    GpuParamEntry {
        name: [0; 64],
        name_len: 0,
        type_tag: GpuTypeU64,
        is_restrict: false,
    }
}

// ============================================================================
// Section 9 — GpuKernelEntry
// ============================================================================

pub struct GpuKernelEntry {
    pub name: [i8; 256],
    pub name_len: i64,
    pub is_kernel: bool,
    pub params: [GpuParamEntry; 32],
    pub param_count: i64,
    pub blocks: [GpuBlockEntry; 256],
    pub block_count: i64,
}

pub fn gpu_kernel_entry_default() -> GpuKernelEntry {
    GpuKernelEntry {
        name: [0; 256],
        name_len: 0,
        is_kernel: true,
        params: [gpu_param_entry_default(); 32],
        param_count: 0,
        blocks: [gpu_block_entry_default(); 256],
        block_count: 0,
    }
}

// ============================================================================
// Section 10 — GpuModuleOutput
// ============================================================================

pub struct GpuModuleOutput {
    pub kernels: [GpuKernelEntry; 64],
    pub kernel_count: i64,
    pub device_fns: [GpuKernelEntry; 64],
    pub device_fn_count: i64,
}

// ============================================================================
// Section 11 — EpistemicShadowEntry
// ============================================================================

pub struct EpistemicShadowEntry {
    pub hlir_value: i64,
    pub gpu_value: i64,
    pub eps_value: i64,
    pub valid_value: i64,
    pub prov_value: i64,
}

fn epistemic_shadow_entry_default() -> EpistemicShadowEntry {
    EpistemicShadowEntry {
        hlir_value: -1,
        gpu_value: -1,
        eps_value: -1,
        valid_value: -1,
        prov_value: -1,
    }
}

// ============================================================================
// Section 12 — ValueMapEntry
// ============================================================================

struct ValueMapEntry {
    hlir_id: i64,
    gpu_id: i64,
    type_tag: i64,
}

fn value_map_entry_default() -> ValueMapEntry {
    ValueMapEntry {
        hlir_id: -1,
        gpu_id: -1,
        type_tag: GpuTypeI32,
    }
}

// ============================================================================
// Section 13 — HlirToGpuState
// ============================================================================

pub struct HlirToGpuState {
    pub next_value_id: i64,
    pub next_block_id: i64,
    pub value_map: [ValueMapEntry; 8192],
    pub value_map_count: i64,
    pub block_map_src: [i64; 2048],
    pub block_map_dst: [i64; 2048],
    pub block_map_count: i64,
    pub epistemic_shadows: [EpistemicShadowEntry; 8192],
    pub shadow_count: i64,
    pub epistemic_enabled: bool,
    pub counterfactual_enabled: bool,
    pub target_sm: i64,
    pub fast_math: bool,
}

// ============================================================================
// Section 14 — Top-level constructors
// ============================================================================

fn hlir_to_gpu_state_new(epistemic: bool, counterfactual: bool, sm_version: i64, fast_math: bool) -> HlirToGpuState {
    HlirToGpuState {
        next_value_id: 0,
        next_block_id: 0,
        value_map: [value_map_entry_default(); 8192],
        value_map_count: 0,
        block_map_src: [-1; 2048],
        block_map_dst: [-1; 2048],
        block_map_count: 0,
        epistemic_shadows: [epistemic_shadow_entry_default(); 8192],
        shadow_count: 0,
        epistemic_enabled: epistemic,
        counterfactual_enabled: counterfactual,
        target_sm: sm_version,
        fast_math: fast_math,
    }
}

fn hlir_to_gpu_module_new() -> GpuModuleOutput {
    GpuModuleOutput {
        kernels: [gpu_kernel_entry_default(); 64],
        kernel_count: 0,
        device_fns: [gpu_kernel_entry_default(); 64],
        device_fn_count: 0,
    }
}

// ============================================================================
// Section 15 — Value/block allocation
// ============================================================================

fn hlir_gpu_alloc_value(s: HlirToGpuState) -> (HlirToGpuState, i64) with Mut {
    var out = s
    let id = out.next_value_id
    out.next_value_id = id + 1
    (out, id)
}

fn hlir_gpu_alloc_block(s: HlirToGpuState) -> (HlirToGpuState, i64) with Mut {
    var out = s
    let id = out.next_block_id
    out.next_block_id = id + 1
    (out, id)
}

fn hlir_gpu_map_value(s: HlirToGpuState, hlir_id: i64, type_tag: i64) -> (HlirToGpuState, i64) with Mut, Panic {
    var out = s
    let result = hlir_gpu_alloc_value(out)
    out = result.0
    let gpu_id = result.1
    if out.value_map_count < 8192 {
        let idx = out.value_map_count as usize
        out.value_map[idx] = ValueMapEntry { hlir_id: hlir_id, gpu_id: gpu_id, type_tag: type_tag }
        out.value_map_count = out.value_map_count + 1
    }
    (out, gpu_id)
}

fn hlir_gpu_lookup_value(s: HlirToGpuState, hlir_id: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.value_map_count {
        if s.value_map[i as usize].hlir_id == hlir_id {
            found = s.value_map[i as usize].gpu_id
        }
        i = i + 1
    }
    found
}

fn hlir_gpu_map_block(s: HlirToGpuState, hlir_block_id: i64) -> (HlirToGpuState, i64) with Mut, Panic {
    var out = s
    let result = hlir_gpu_alloc_block(out)
    out = result.0
    let gpu_id = result.1
    if out.block_map_count < 2048 {
        let idx = out.block_map_count as usize
        out.block_map_src[idx] = hlir_block_id
        out.block_map_dst[idx] = gpu_id
        out.block_map_count = out.block_map_count + 1
    }
    (out, gpu_id)
}

fn hlir_gpu_lookup_block(s: HlirToGpuState, hlir_block_id: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.block_map_count {
        if s.block_map_src[i as usize] == hlir_block_id {
            found = s.block_map_dst[i as usize]
        }
        i = i + 1
    }
    found
}

// ============================================================================
// Section 16 — Type lowering
// ============================================================================

fn hlir_lower_type(type_tag: i64) -> i64 {
    if type_tag == HLIR_TY_I32 { return GpuTypeI32 }
    if type_tag == HLIR_TY_I64 { return GpuTypeI64 }
    if type_tag == HLIR_TY_F32 { return GpuTypeF32 }
    if type_tag == HLIR_TY_F64 { return GpuTypeF64 }
    if type_tag == HLIR_TY_PTR { return GpuTypePtr }
    if type_tag == HLIR_TY_BOOL { return GpuTypeBool }
    if type_tag == HLIR_TY_I8 { return GpuTypeI8 }
    if type_tag == HLIR_TY_I16 { return GpuTypeI32 }
    if type_tag == HLIR_TY_U32 { return GpuTypeU32 }
    if type_tag == HLIR_TY_U64 { return GpuTypeU64 }
    if type_tag == HLIR_TY_F16 { return GpuTypeF16 }
    // Knowledge<T>: strip wrapper, default to f32
    if type_tag == HLIR_TY_KNOWLEDGE { return GpuTypeF32 }
    // Aggregate types: represented as pointers to their storage
    if type_tag == HLIR_TY_VEC2 { return GpuTypePtr }
    if type_tag == HLIR_TY_VEC3 { return GpuTypePtr }
    if type_tag == HLIR_TY_VEC4 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT2 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT3 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT4 { return GpuTypePtr }
    if type_tag == HLIR_TY_QUAT { return GpuTypePtr }
    if type_tag == HLIR_TY_OCTONION { return GpuTypePtr }
    if type_tag == HLIR_TY_SEDENION { return GpuTypePtr }
    // 128-bit integers downgraded — GPUs lack native 128-bit
    if type_tag == HLIR_TY_I128 { return GpuTypeI64 }
    if type_tag == HLIR_TY_U128 { return GpuTypeU64 }
    // Default fallback
    GpuTypeI32
}

// ============================================================================
// Section 17 — GpuOpEntry builders
// ============================================================================

fn gpu_op_make(opcode: i64, type_tag: i64, dst: i64, s0: i64, s1: i64, s2: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: s0,
        src1: s1,
        src2: s2,
        imm_int: 0,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_imm_i(opcode: i64, type_tag: i64, dst: i64, imm: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: imm,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_imm_f(opcode: i64, type_tag: i64, dst: i64, f: f32) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: 0,
        imm_f32: f,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_pred(op: GpuOpEntry, pred: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: op.opcode,
        type_tag: op.type_tag,
        dst_idx: op.dst_idx,
        src0: op.src0,
        src1: op.src1,
        src2: op.src2,
        imm_int: op.imm_int,
        imm_f32: op.imm_f32,
        pred: pred,
        axis: op.axis,
    }
}

fn gpu_op_axis(op: GpuOpEntry, axis: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: op.opcode,
        type_tag: op.type_tag,
        dst_idx: op.dst_idx,
        src0: op.src0,
        src1: op.src1,
        src2: op.src2,
        imm_int: op.imm_int,
        imm_f32: op.imm_f32,
        pred: op.pred,
        axis: axis,
    }
}

// ============================================================================
// Section 18 — Block helpers
// ============================================================================

fn gpu_block_add_op(blk: GpuBlockEntry, op: GpuOpEntry) -> GpuBlockEntry with Mut, Panic {
    var out = blk
    if out.op_count < 4096 {
        out.ops[out.op_count as usize] = op
        out.op_count = out.op_count + 1
    }
    out
}

fn gpu_block_set_term_ret(blk: GpuBlockEntry, src: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermRet,
        term_src: src,
        term_target0: -1,
        term_target1: -1,
    }
}

fn gpu_block_set_term_ret_void(blk: GpuBlockEntry) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermRetVoid,
        term_src: -1,
        term_target0: -1,
        term_target1: -1,
    }
}

fn gpu_block_set_term_br(blk: GpuBlockEntry, target: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermBr,
        term_src: -1,
        term_target0: target,
        term_target1: -1,
    }
}

fn gpu_block_set_term_condbr(blk: GpuBlockEntry, cond: i64, then_b: i64, else_b: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermCondBr,
        term_src: cond,
        term_target0: then_b,
        term_target1: else_b,
    }
}

// ============================================================================
// Section 19 — Epistemic shadow management
// ============================================================================

fn hlir_gpu_find_shadow(s: HlirToGpuState, gpu_val: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.shadow_count {
        if s.epistemic_shadows[i as usize].gpu_value == gpu_val {
            found = i
        }
        i = i + 1
    }
    found
}

fn hlir_gpu_create_shadow(s: HlirToGpuState, blk: GpuBlockEntry, main_val: i64, hlir_id: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    // Allocate eps register (f32, init 0.0)
    let eps_result = hlir_gpu_alloc_value(st)
    st = eps_result.0
    let eps_val = eps_result.1

    // Allocate valid register (bool, init true via imm 1)
    let valid_result = hlir_gpu_alloc_value(st)
    st = valid_result.0
    let valid_val = valid_result.1

    // Allocate prov register (i64, init 0)
    let prov_result = hlir_gpu_alloc_value(st)
    st = prov_result.0
    let prov_val = prov_result.1

    // Emit epsilon initialiser: eps = 0.0f
    let eps_init = gpu_op_imm_f(GpuOpcodeConst, GpuTypeF32, eps_val, 0.0 as f32)
    b = gpu_block_add_op(b, eps_init)

    // Emit valid initialiser: valid = 1 (true)
    let valid_init = gpu_op_imm_i(GpuOpcodeConst, GpuTypeBool, valid_val, 1)
    b = gpu_block_add_op(b, valid_init)

    // Emit prov initialiser: prov = 0
    let prov_init = gpu_op_imm_i(GpuOpcodeConst, GpuTypeI64, prov_val, 0)
    b = gpu_block_add_op(b, prov_init)

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: hlir_id,
            gpu_value: main_val,
            eps_value: eps_val,
            valid_value: valid_val,
            prov_value: prov_val,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit quadrature uncertainty propagation for add/sub: eps_c = sqrt(eps_a^2 + eps_b^2)
fn hlir_gpu_emit_shadow_add(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs: i64, rhs: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs)

    // Get shadow register IDs (fallback to -1 treated as 0 uncertainty)
    var eps_l: i64 = -1
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = -1
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let sq_l_r = hlir_gpu_alloc_value(st)
    st = sq_l_r.0
    let sq_l = sq_l_r.1

    let sq_r_r = hlir_gpu_alloc_value(st)
    st = sq_r_r.0
    let sq_r = sq_r_r.1

    let sum_r = hlir_gpu_alloc_value(st)
    st = sum_r.0
    let sum = sum_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // sq_l = eps_l * eps_l
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_l, eps_l, eps_l, -1))
    // sq_r = eps_r * eps_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_r, eps_r, eps_r, -1))
    // sum = sq_l + sq_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, sum, sq_l, sq_r, -1))
    // eps_res = sqrt(sum)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSqrt, GpuTypeF32, eps_res, sum, -1, -1))
    // valid_res = valid_l AND valid_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    // prov_res = prov_l OR prov_r (monotonic union)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record new shadow for result
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit first-order uncertainty propagation for mul: eps_c = |lhs|*eps_rhs + |rhs|*eps_lhs
fn hlir_gpu_emit_shadow_mul(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs_val: i64, rhs_val: i64, lhs_eps_v: i64, rhs_eps_v: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs_val)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs_val)

    var eps_l: i64 = lhs_eps_v
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = rhs_eps_v
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let abs_lhs_r = hlir_gpu_alloc_value(st)
    st = abs_lhs_r.0
    let abs_lhs = abs_lhs_r.1

    let abs_rhs_r = hlir_gpu_alloc_value(st)
    st = abs_rhs_r.0
    let abs_rhs = abs_rhs_r.1

    let term1_r = hlir_gpu_alloc_value(st)
    st = term1_r.0
    let term1 = term1_r.1

    let term2_r = hlir_gpu_alloc_value(st)
    st = term2_r.0
    let term2 = term2_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // abs_lhs = |lhs_val|
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_lhs, lhs_val, -1, -1))
    // abs_rhs = |rhs_val|
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_rhs, rhs_val, -1, -1))
    // term1 = abs_lhs * eps_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term1, abs_lhs, eps_r, -1))
    // term2 = abs_rhs * eps_l
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term2, abs_rhs, eps_l, -1))
    // eps_res = term1 + term2
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, eps_res, term1, term2, -1))
    // valid_res = valid_l AND valid_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    // prov_res = prov_l OR prov_r (monotonic union)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Validity semantics:
//   - Binary ops (add, sub, mul): valid_out = valid_a AND valid_b
//   - Division: valid_out = valid_a AND valid_b AND (|b| > near_zero)
//   - Sqrt: valid_out = valid_a (TODO: add a >= 0 domain check)
//   - General: valid means "GUM uncertainty computation is well-defined for this result"

// Emit uncertainty propagation for div: eps_c = (|lhs|*eps_rhs + |rhs|*eps_lhs) / rhs^2
// Includes near-zero denominator guard via validity predicate
fn hlir_gpu_emit_shadow_div(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs_val: i64, rhs_val: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs_val)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs_val)

    var eps_l: i64 = -1
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = -1
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let abs_lhs_r = hlir_gpu_alloc_value(st)
    st = abs_lhs_r.0
    let abs_lhs = abs_lhs_r.1

    let abs_rhs_r = hlir_gpu_alloc_value(st)
    st = abs_rhs_r.0
    let abs_rhs = abs_rhs_r.1

    let term1_r = hlir_gpu_alloc_value(st)
    st = term1_r.0
    let term1 = term1_r.1

    let term2_r = hlir_gpu_alloc_value(st)
    st = term2_r.0
    let term2 = term2_r.1

    let numer_r = hlir_gpu_alloc_value(st)
    st = numer_r.0
    let numer = numer_r.1

    let rhs_sq_r = hlir_gpu_alloc_value(st)
    st = rhs_sq_r.0
    let rhs_sq = rhs_sq_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    // Near-zero guard predicate
    let near_zero_thresh_r = hlir_gpu_alloc_value(st)
    st = near_zero_thresh_r.0
    let near_zero_thresh = near_zero_thresh_r.1

    let denom_safe_r = hlir_gpu_alloc_value(st)
    st = denom_safe_r.0
    let denom_safe = denom_safe_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // Compute uncertainty numerator
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_lhs, lhs_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_rhs, rhs_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term1, abs_lhs, eps_r, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term2, abs_rhs, eps_l, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, numer, term1, term2, -1))
    // rhs^2
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, rhs_sq, rhs_val, rhs_val, -1))
    // eps_res = numer / rhs^2  (may be inf if rhs near zero; validity gate handles it)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, GpuTypeF32, eps_res, numer, rhs_sq, -1))

    // near_zero_thresh = 1e-7 (approximately, using f32 literal)
    b = gpu_block_add_op(b, gpu_op_imm_f(GpuOpcodeConst, GpuTypeF32, near_zero_thresh, 0.0000001 as f32))
    // denom_safe = (abs_rhs >= near_zero_thresh)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, denom_safe, abs_rhs, near_zero_thresh, -1))
    // valid_res = valid_l AND valid_r AND denom_safe
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_res, denom_safe, -1))
    // prov_res = prov_l OR prov_r (monotonic union)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit FMA epistemic shadow: dst = a*b + c
// Epsilon: first multiplicative (|a|*eps_b + |b|*eps_a), then additive quadrature with eps_c
fn hlir_gpu_emit_shadow_fma(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, a_val: i64, b_val: i64, c_val: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let a_idx = hlir_gpu_find_shadow(st, a_val)
    let b_idx = hlir_gpu_find_shadow(st, b_val)
    let c_idx = hlir_gpu_find_shadow(st, c_val)

    var eps_a: i64 = -1
    var valid_a: i64 = -1
    var prov_a: i64 = -1
    var eps_b: i64 = -1
    var valid_b: i64 = -1
    var prov_b: i64 = -1
    var eps_c: i64 = -1
    var valid_c: i64 = -1
    var prov_c: i64 = -1

    if a_idx >= 0 {
        eps_a = st.epistemic_shadows[a_idx as usize].eps_value
        valid_a = st.epistemic_shadows[a_idx as usize].valid_value
        prov_a = st.epistemic_shadows[a_idx as usize].prov_value
    }
    if b_idx >= 0 {
        eps_b = st.epistemic_shadows[b_idx as usize].eps_value
        valid_b = st.epistemic_shadows[b_idx as usize].valid_value
        prov_b = st.epistemic_shadows[b_idx as usize].prov_value
    }
    if c_idx >= 0 {
        eps_c = st.epistemic_shadows[c_idx as usize].eps_value
        valid_c = st.epistemic_shadows[c_idx as usize].valid_value
        prov_c = st.epistemic_shadows[c_idx as usize].prov_value
    }

    // Step 1: multiplicative part — eps_mul = |a|*eps_b + |b|*eps_a
    let abs_a_r = hlir_gpu_alloc_value(st)
    st = abs_a_r.0
    let abs_a = abs_a_r.1

    let abs_b_r = hlir_gpu_alloc_value(st)
    st = abs_b_r.0
    let abs_b = abs_b_r.1

    let mul_t1_r = hlir_gpu_alloc_value(st)
    st = mul_t1_r.0
    let mul_t1 = mul_t1_r.1

    let mul_t2_r = hlir_gpu_alloc_value(st)
    st = mul_t2_r.0
    let mul_t2 = mul_t2_r.1

    let eps_mul_r = hlir_gpu_alloc_value(st)
    st = eps_mul_r.0
    let eps_mul = eps_mul_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_a, a_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_b, b_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, mul_t1, abs_a, eps_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, mul_t2, abs_b, eps_a, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, eps_mul, mul_t1, mul_t2, -1))

    // Step 2: additive quadrature — eps_out = sqrt(eps_mul^2 + eps_c^2)
    let sq_mul_r = hlir_gpu_alloc_value(st)
    st = sq_mul_r.0
    let sq_mul = sq_mul_r.1

    let sq_c_r = hlir_gpu_alloc_value(st)
    st = sq_c_r.0
    let sq_c = sq_c_r.1

    let sum_sq_r = hlir_gpu_alloc_value(st)
    st = sum_sq_r.0
    let sum_sq = sum_sq_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_mul, eps_mul, eps_mul, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_c, eps_c, eps_c, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, sum_sq, sq_mul, sq_c, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSqrt, GpuTypeF32, eps_res, sum_sq, -1, -1))

    // Step 3: validity = valid_a AND valid_b AND valid_c
    let valid_ab_r = hlir_gpu_alloc_value(st)
    st = valid_ab_r.0
    let valid_ab = valid_ab_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_ab, valid_a, valid_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_ab, valid_c, -1))

    // Step 4: provenance = prov_a OR prov_b OR prov_c (monotonic union)
    let prov_ab_r = hlir_gpu_alloc_value(st)
    st = prov_ab_r.0
    let prov_ab = prov_ab_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, GpuTypeI64, prov_ab, prov_a, prov_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, GpuTypeI64, prov_res, prov_ab, prov_c, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// ============================================================================
// Section 20 — Instruction lowering
// ============================================================================

fn hlir_lower_instr(s: HlirToGpuState, blk: GpuBlockEntry, op_tag: i64, type_tag: i64, hlir_dst: i64, hlir_src0: i64, hlir_src1: i64, hlir_src2: i64, imm_i: i64, imm_f: f32, axis: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let gpu_type = hlir_lower_type(type_tag)

    // Look up existing GPU IDs for sources
    let g_src0 = hlir_gpu_lookup_value(st, hlir_src0)
    let g_src1 = hlir_gpu_lookup_value(st, hlir_src1)
    let g_src2 = hlir_gpu_lookup_value(st, hlir_src2)

    // Allocate a destination register and record the mapping
    let dst_result = hlir_gpu_map_value(st, hlir_dst, gpu_type)
    st = dst_result.0
    let g_dst = dst_result.1

    if op_tag == HlirOpConst {
        // Emit integer or float constant depending on type
        if type_tag == HLIR_TY_F32 {
            b = gpu_block_add_op(b, gpu_op_imm_f(GpuOpcodeConst, gpu_type, g_dst, imm_f))
        } else {
            b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, imm_i))
        }
    } else if op_tag == HlirOpAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            // Subtraction: errors still add in quadrature
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpMul {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_mul(st, b, g_dst, g_src0, g_src1, -1, -1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFMul {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_mul(st, b, g_dst, g_src0, g_src1, -1, -1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpDiv {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_div(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFDiv {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_div(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpNeg {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeNeg, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFNeg {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeNeg, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpRem {
        // Integer remainder; no direct GPU atomic — lower as sub(a, mul(div(a,b),b))
        // Emit as placeholder GpuOpcodeSub with available operands for now
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAnd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpOr {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpXor {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpShl {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeShl, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpShr {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeShr, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpEq {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpEq, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpNe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpNe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpGt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpGe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFEq {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpEq, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFNe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpNe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFLt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFLe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFGt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFGe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLoad {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeLoadGlobal, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpStore {
        // Store: dst has no meaningful value — emit with dst_idx = -1
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeStoreGlobal, gpu_type, -1, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAlloca {
        // Local allocation: emit placeholder const 0 (address materialised by backend)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, GpuTypePtr, g_dst, 0))
    } else if op_tag == HlirOpGEP {
        // GetElementPtr: base + offset
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypePtr, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpCall {
        // Call cannot be lowered here (needs symbol name lookup in a later pass)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, -1))
    } else if op_tag == HlirOpPhi {
        // Phi nodes: resolved by block structure — emit identity add(src0, 0) as placeholder
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpZExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpTrunc {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFpExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFpTrunc {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpBitcast {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSIToFP {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFPToSI {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSelect {
        // selp dst, src0, src1, pred_cond
        let op = gpu_op_make(GpuOpcodeSelp, gpu_type, g_dst, g_src0, g_src1, -1)
        b = gpu_block_add_op(b, gpu_op_pred(op, g_src2))
    } else if op_tag == HlirOpFMA {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeFma, gpu_type, g_dst, g_src0, g_src1, g_src2))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_fma(st, b, g_dst, g_src0, g_src1, g_src2)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpGetThreadId {
        let op = gpu_op_make(GpuOpcodeGetTid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetBlockId {
        let op = gpu_op_make(GpuOpcodeGetBid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetBlockDim {
        let op = gpu_op_make(GpuOpcodeGetNtid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetGridDim {
        // No direct GPU IR for grid dim in this IR version — emit placeholder 0
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, 0))
    } else if op_tag == HlirOpAtomicAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicAdd, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicSub, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicMin {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicMin, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicMax {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicMax, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpSyncThreads {
        // Barrier sync has no destination; emit with dst -1
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeBarrierSync, gpu_type, -1, -1, -1, -1))
    } else if op_tag == HlirOpSyncWarp {
        // Warp-level barrier (mask = 0xFFFFFFFF)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeBarrierSync, gpu_type, -1, -1))
    } else {
        // Unknown op — emit a const 0 placeholder to keep value numbering consistent
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, 0))
    }

    (st, b)
}

// ============================================================================
// Section 21 — Kernel/function lowering helpers
// ============================================================================

fn hlir_gpu_lower_kernel_new(s: HlirToGpuState, is_kernel: bool) -> (HlirToGpuState, GpuKernelEntry) with Mut {
    var out = s
    var k = gpu_kernel_entry_default()
    k.is_kernel = is_kernel
    (out, k)
}

fn hlir_gpu_add_param(k: GpuKernelEntry, name_bytes: [i8; 64], name_len: i64, type_tag: i64, is_restrict: bool) -> GpuKernelEntry with Mut, Panic {
    var out = k
    if out.param_count < 32 {
        let idx = out.param_count as usize
        out.params[idx] = GpuParamEntry {
            name: name_bytes,
            name_len: name_len,
            type_tag: type_tag,
            is_restrict: is_restrict,
        }
        out.param_count = out.param_count + 1
    }
    out
}

fn hlir_gpu_emit_param_load(s: HlirToGpuState, blk: GpuBlockEntry, param_idx: i64, type_tag: i64) -> (HlirToGpuState, GpuBlockEntry, i64) with Mut, Panic {
    var st = s
    var b = blk

    let dst_result = hlir_gpu_alloc_value(st)
    st = dst_result.0
    let dst = dst_result.1

    let op = gpu_op_imm_i(GpuOpcodeLoadParam, type_tag, dst, param_idx)
    b = gpu_block_add_op(b, op)

    (st, b, dst)
}

fn hlir_gpu_add_block_to_kernel(k: GpuKernelEntry, blk: GpuBlockEntry) -> GpuKernelEntry with Mut, Panic {
    var out = k
    if out.block_count < 256 {
        let idx = out.block_count as usize
        out.blocks[idx] = blk
        out.block_count = out.block_count + 1
    }
    out
}

// ============================================================================
// Section 22 — Module-level assembly helpers
// ============================================================================

fn hlir_to_gpu_add_kernel(m: GpuModuleOutput, k: GpuKernelEntry) -> GpuModuleOutput with Mut, Panic {
    var out = m
    if out.kernel_count < 64 {
        out.kernels[out.kernel_count as usize] = k
        out.kernel_count = out.kernel_count + 1
    }
    out
}

fn hlir_to_gpu_add_device_fn(m: GpuModuleOutput, k: GpuKernelEntry) -> GpuModuleOutput with Mut, Panic {
    var out = m
    if out.device_fn_count < 64 {
        out.device_fns[out.device_fn_count as usize] = k
        out.device_fn_count = out.device_fn_count + 1
    }
    out
}

fn hlir_to_gpu_finalize(s: HlirToGpuState, m: GpuModuleOutput) -> GpuModuleOutput {
    // Finalisation is a no-op for now (future: sort blocks, resolve phi targets).
    // The state is consumed and its diagnostic information can be read before calling.
    m
}

// ============================================================================
// Section 23 — Statistics and diagnostics
// ============================================================================

fn hlir_to_gpu_count_epistemic_shadows(s: HlirToGpuState) -> i64 {
    s.shadow_count
}

fn hlir_to_gpu_count_ops(m: GpuModuleOutput) -> i64 {
    var total: i64 = 0
    var ki: i64 = 0
    while ki < m.kernel_count {
        let k = m.kernels[ki as usize]
        var bi: i64 = 0
        while bi < k.block_count {
            total = total + k.blocks[bi as usize].op_count
            bi = bi + 1
        }
        ki = ki + 1
    }
    var di: i64 = 0
    while di < m.device_fn_count {
        let d = m.device_fns[di as usize]
        var bi: i64 = 0
        while bi < d.block_count {
            total = total + d.blocks[bi as usize].op_count
            bi = bi + 1
        }
        di = di + 1
    }
    total
}

fn hlir_to_gpu_sm_supports_fast_math(sm: i64) -> bool {
    sm >= 50
}

// ============================================================================
// Section 24 — HLIR Module kernel extraction (Sprint 27)
// ============================================================================

// Count kernel functions in an HlirModule.
pub(crate) fn hlir_extract_kernel_count(module: HlirModule) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < module.fn_count {
        if module.functions[i as usize].is_kernel {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Get the module-level index of the n-th kernel function (0-indexed).
// Returns -1 if not found.
fn hlir_get_kernel_index(module: HlirModule, kernel_idx: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < module.fn_count {
        if module.functions[i as usize].is_kernel {
            if count == kernel_idx {
                return i
            }
            count = count + 1
        }
        i = i + 1
    }
    0 - 1
}

// Map an HlirTypeKind to a GpuType for kernel parameter mapping.
fn hlir_type_kind_to_gpu(kind: HlirTypeKind) -> GpuType {
    if kind == HlirTypeKind::HlirTypeI32 { GpuType::GpuI32 }
    else if kind == HlirTypeKind::HlirTypeI64 { GpuType::GpuI64 }
    else if kind == HlirTypeKind::HlirTypeF32 { GpuType::GpuF32 }
    else if kind == HlirTypeKind::HlirTypeF64 { GpuType::GpuF64 }
    else if kind == HlirTypeKind::HlirTypeU32 { GpuType::GpuU32 }
    else if kind == HlirTypeKind::HlirTypeU64 { GpuType::GpuU64 }
    else if kind == HlirTypeKind::HlirTypeBool { GpuType::GpuBool }
    else if kind == HlirTypeKind::HlirTypePtr { GpuType::GpuPtr }
    else { GpuType::GpuI64 }
}

// Map an HLIR v2 binary op tag (HLIR_BIN_*) to a GpuOpcode.
fn hlir_bin_op_to_gpu_opcode(bin_op: i64) -> GpuOpcode {
    if bin_op == HLIR_BIN_ADD || bin_op == HLIR_BIN_FADD { GpuOpcode::GpuAdd }
    else if bin_op == HLIR_BIN_SUB || bin_op == HLIR_BIN_FSUB { GpuOpcode::GpuSub }
    else if bin_op == HLIR_BIN_MUL || bin_op == HLIR_BIN_FMUL { GpuOpcode::GpuMul }
    else if bin_op == HLIR_BIN_SDIV || bin_op == HLIR_BIN_UDIV || bin_op == HLIR_BIN_FDIV { GpuOpcode::GpuDiv }
    else if bin_op == HLIR_BIN_SLT || bin_op == HLIR_BIN_ULT || bin_op == HLIR_BIN_FOLT { GpuOpcode::GpuSetpLt }
    else if bin_op == HLIR_BIN_SLE || bin_op == HLIR_BIN_ULE || bin_op == HLIR_BIN_FOLE { GpuOpcode::GpuSetpLe }
    else if bin_op == HLIR_BIN_SGT || bin_op == HLIR_BIN_UGT || bin_op == HLIR_BIN_FOGT { GpuOpcode::GpuSetpGt }
    else if bin_op == HLIR_BIN_SGE || bin_op == HLIR_BIN_UGE || bin_op == HLIR_BIN_FOGE { GpuOpcode::GpuSetpGe }
    else if bin_op == HLIR_BIN_EQ || bin_op == HLIR_BIN_FOEQ { GpuOpcode::GpuSetpEq }
    else if bin_op == HLIR_BIN_NE || bin_op == HLIR_BIN_FONE { GpuOpcode::GpuSetpNe }
    else { GpuOpcode::GpuAdd }
}

// Map a binary op tag to a GpuType.
// IMPORTANT: classify explicit HLIR_BIN_* ranges. The legacy HlirOp* constants
// are a different tag space and make source-level kernels lose compare width.
// This is the WIDTH source ONLY for comparisons, where the HlirInstr result type
// is bool and therefore useless for operand width; arithmetic/logical instrs
// instead take width from instr.ty.kind at the HLIR_OP_BINARY site below.
// World A (check.sio: gpu thread/block intrinsics typed i64) ⇒ every integer
// operand of a comparison in these kernels is i64, so int-compare → GpuI64.
fn hlir_bin_op_type(bin_op: i64) -> GpuType {
    if bin_op >= HLIR_BIN_FOEQ && bin_op <= HLIR_BIN_FOGE { GpuType::GpuF32 }
    else if bin_op >= HLIR_BIN_FADD && bin_op <= HLIR_BIN_FREM { GpuType::GpuF32 }
    else if bin_op >= HLIR_BIN_EQ && bin_op <= HLIR_BIN_UGE { GpuType::GpuI64 }
    else { GpuType::GpuI64 }
}

fn gpu_kernel_bump_reg(kernel: GpuKernelIr, reg: i64, ty: GpuType) -> GpuKernelIr with Mut {
    var k = kernel
    if reg < 0 { return k }

    let next = reg + 1
    if ty == GpuType::GpuBool {
        if next > k.max_reg_pred { k.max_reg_pred = next }
    } else if ty == GpuType::GpuU32 {
        if next > k.max_reg_u32 { k.max_reg_u32 = next }
    } else if ty == GpuType::GpuI32 {
        if next > k.max_reg_i32 { k.max_reg_i32 = next }
    } else if ty == GpuType::GpuF32 {
        if next > k.max_reg_f32 { k.max_reg_f32 = next }
    } else if ty == GpuType::GpuF64 {
        if next > k.max_reg_f64 { k.max_reg_f64 = next }
    } else {
        if next > k.max_reg_u64 { k.max_reg_u64 = next }
    }

    k
}

// Append a single GPU op to a GpuKernelIr. Returns the kernel with op appended.
fn gpu_kernel_append_op(kernel: GpuKernelIr, op: GpuOp) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    if k.op_count < 1024 {
        if op.opcode == GpuOpcode::GpuCvt {
            k = gpu_kernel_bump_reg(k, op.dst_reg, op.dst_ty)
            k = gpu_kernel_bump_reg(k, op.src_reg, op.src_ty)
        } else if op.opcode == GpuOpcode::GpuSetpLt || op.opcode == GpuOpcode::GpuSetpLe ||
                  op.opcode == GpuOpcode::GpuSetpEq || op.opcode == GpuOpcode::GpuSetpGe ||
                  op.opcode == GpuOpcode::GpuSetpGt || op.opcode == GpuOpcode::GpuSetpNe {
            k = gpu_kernel_bump_reg(k, op.dst_reg, GpuType::GpuBool)
            k = gpu_kernel_bump_reg(k, op.lhs_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.rhs_reg, op.ty)
        } else if op.opcode == GpuOpcode::GpuLoadGlobal {
            k = gpu_kernel_bump_reg(k, op.dst_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.addr_reg, GpuType::GpuU64)
        } else if op.opcode == GpuOpcode::GpuStoreGlobal {
            k = gpu_kernel_bump_reg(k, op.src_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.addr_reg, GpuType::GpuU64)
        } else if op.opcode == GpuOpcode::GpuLoadParam {
            k = gpu_kernel_bump_reg(k, op.dst_reg, op.ty)
        } else if op.opcode == GpuOpcode::GpuBra {
            k = gpu_kernel_bump_reg(k, op.pred_reg, GpuType::GpuBool)
        } else {
            k = gpu_kernel_bump_reg(k, op.dst_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.src_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.lhs_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.rhs_reg, op.ty)
            k = gpu_kernel_bump_reg(k, op.addr_reg, GpuType::GpuU64)
            k = gpu_kernel_bump_reg(k, op.pred_reg, GpuType::GpuBool)
        }
        k.ops[k.op_count as usize] = op
        k.op_count = k.op_count + 1
    }
    k
}

fn hlir_gpu_type_size_bytes(ty: GpuType) -> i64 {
    if ty == GpuType::GpuF64 || ty == GpuType::GpuI64 || ty == GpuType::GpuU64 || ty == GpuType::GpuPtr {
        8
    } else {
        4
    }
}

// Widen a 32-bit thread/block intrinsic result to i64 when the HLIR result type
// is i64. Appends `cvt.u64.u32 %rd<reg>, %r<reg>` so the value's 64-bit register
// bank is materialized for downstream i64 index arithmetic (World A: the GPU
// thread/block-index intrinsics are typed i64 by the checker). The sreg read
// itself stays mov.u32 (the special registers are genuinely 32-bit).
fn gpu_widen_intrinsic_to_i64(kernel: GpuKernelIr, reg: i64, res_kind: HlirTypeKind) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    if res_kind == HlirTypeKind::HlirTypeI64 || res_kind == HlirTypeKind::HlirTypeU64 {
        var cvt = gpu_op_new()
        cvt.opcode = GpuOpcode::GpuCvt
        cvt.dst_reg = reg
        cvt.src_reg = reg
        cvt.dst_ty = GpuType::GpuU64
        cvt.src_ty = GpuType::GpuU32
        cvt.ty = GpuType::GpuU64
        k = gpu_kernel_append_op(k, cvt)
    }
    k
}

// Lower a single HLIR instruction to GPU ops and append to kernel.
fn hlir_instr_to_gpu_ops(kernel: GpuKernelIr, instr: HlirInstr) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let op_kind = instr.op_kind

    if op_kind == HLIR_OP_BINARY {
        var op = gpu_op_new()
        op.opcode = hlir_bin_op_to_gpu_opcode(instr.bin_op)
        op.dst_reg = instr.result
        op.lhs_reg = instr.lhs
        op.rhs_reg = instr.rhs
        // Width source: for arithmetic/logical ops the HlirInstr result type IS
        // the operand width, so use it (gives i64 for index math, f64 for
        // vec_add_f64 — fixing the old hardcoded i32/f32). For comparisons the
        // result type is bool, useless for width, so fall back to the op-tag map
        // (int-compare → i64 over %rd, float-compare → f-width).
        let is_compare = instr.bin_op >= HLIR_BIN_EQ && instr.bin_op <= HLIR_BIN_FOGE
        if is_compare {
            op.ty = hlir_bin_op_type(instr.bin_op)
        } else {
            op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        }
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_LOAD {
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = instr.result
        op.addr_reg = instr.src
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        op.memory_space = GpuMemorySpace::GpuMemGlobal
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_STORE {
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuStoreGlobal
        op.addr_reg = instr.store_ptr
        op.src_reg = instr.store_value
        if instr.ty.kind == HlirTypeKind::HlirTypeVoid {
            op.ty = GpuType::GpuI64
        } else {
            op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        }
        op.memory_space = GpuMemorySpace::GpuMemGlobal
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_GET_ELEMENT_PTR {
        let elem_ty = hlir_type_kind_to_gpu(instr.ty.kind)
        let scale_reg = instr.result + 512

        var scale = gpu_op_new()
        scale.opcode = GpuOpcode::GpuMulImm
        scale.dst_reg = scale_reg
        scale.lhs_reg = instr.index
        scale.rhs_imm = hlir_gpu_type_size_bytes(elem_ty)
        scale.ty = GpuType::GpuU64
        scale.dst_ty = GpuType::GpuU64
        k = gpu_kernel_append_op(k, scale)

        var addr = gpu_op_new()
        addr.opcode = GpuOpcode::GpuAdd
        addr.dst_reg = instr.result
        addr.lhs_reg = instr.base
        addr.rhs_reg = scale_reg
        addr.ty = GpuType::GpuU64
        addr.dst_ty = GpuType::GpuU64
        k = gpu_kernel_append_op(k, addr)
    } else if op_kind == HLIR_OP_CONST {
        // Emit constant as immediate load into a virtual register. lhs_reg = -1 marks a
        // PURE immediate (no base register) so the renderer emits `mov dst, imm` rather than
        // `add dst, %reg0, imm` — reg 0 is the first kernel param, NOT a zero register, so the
        // add form silently corrupts every integer constant (e.g. array/GEP indices).
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuAddImm
        op.dst_reg = instr.result
        op.lhs_reg = 0 - 1
        op.rhs_imm = instr.constant.int_val
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_COPY {
        // Copy maps to a mov (implemented as add with zero imm)
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuAddImm
        op.dst_reg = instr.result
        op.lhs_reg = instr.src
        op.rhs_imm = 0
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_CAST {
        // Type conversion
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuCvt
        op.dst_reg = instr.result
        op.src_reg = instr.cast_value
        op.dst_ty = hlir_type_kind_to_gpu(instr.cast_target.kind)
        op.src_ty = hlir_type_kind_to_gpu(instr.cast_source.kind)
        op.ty = hlir_type_kind_to_gpu(instr.cast_target.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_ALLOCA {
        // Stack allocations map to local memory — skip in MVP
    } else if op_kind == HLIR_OP_PHI {
        // PHI nodes resolved during register allocation — skip in MVP
    } else if op_kind == HLIR_OP_UNARY {
        // Unary ops — map negation to sub from zero
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuSub
        op.dst_reg = instr.result
        op.lhs_reg = 0
        op.rhs_reg = instr.src
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_CALL_DIRECT {
        // Check if it's a GPU intrinsic by name
        // gpu_thread_id_x → GpuGetTid axis=0
        // gpu_block_id_x  → GpuGetBid axis=0
        // gpu_block_dim_x → GpuGetNtid axis=0
        var op = gpu_op_new()
        let cn = instr.call_name
        // Match against known GPU builtins (name-based dispatch)
        if hlir_name_starts_with_gpu_thread(cn) {
            op.opcode = GpuOpcode::GpuGetTid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
            k = gpu_widen_intrinsic_to_i64(k, instr.result, instr.ty.kind)
        } else if hlir_name_starts_with_gpu_block_id(cn) {
            op.opcode = GpuOpcode::GpuGetBid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
            k = gpu_widen_intrinsic_to_i64(k, instr.result, instr.ty.kind)
        } else if hlir_name_starts_with_gpu_block_dim(cn) {
            op.opcode = GpuOpcode::GpuGetNtid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
            k = gpu_widen_intrinsic_to_i64(k, instr.result, instr.ty.kind)
        } else if hlir_name_is_oct_batch_mul(cn) || hlir_name_is_sed_batch_mul(cn) {
            // Batched hypercomplex multiply → tensor-core tile. call_args = [pa, pH, pout].
            // The stage op builds L(a) (row-major f16) at shared[0] and H (col-major f16) at
            // shared[512]; the tile writes D = L(a)·H (row-major f32) to pout. Octonion uses the
            // top-left 8×8 (stage dim=8); sedenion fills the full 16×16 (dim=16).
            let dim = if hlir_name_is_sed_batch_mul(cn) { 16 } else { 8 }
            if k.shared_bytes < 1024 { k.shared_bytes = 1024 }
            let pa_reg = instr.call_args[0]
            let pH_reg = instr.call_args[1]
            let pout_reg = instr.call_args[2]
            var stg = gpu_op_new()
            stg.opcode = GpuOpcode::GpuOctBatchStage
            stg.lhs_reg = pa_reg
            stg.rhs_reg = pH_reg
            stg.rhs_imm = dim
            k = gpu_kernel_append_op(k, stg)
            var tile = gpu_op_wmma_tile(0, 512, pout_reg, 16)
            k = gpu_kernel_append_op(k, tile)
        } else if hlir_name_is_ossm_oct_step(cn) || hlir_name_is_ossm_sed_step(cn) {
            // O-SSM linear step S = A⊗H + B·x on tensor cores. Octonion dim=8; sedenion dim=16.
            // call_args = [pA, pB, px, pH, pout]. Stage L(A)+H → tile D=L(A)·H → post-add B·x.
            let sdim = if hlir_name_is_ossm_sed_step(cn) { 16 } else { 8 }
            if k.shared_bytes < 1024 { k.shared_bytes = 1024 }
            let pA_reg = instr.call_args[0]
            let pB_reg = instr.call_args[1]
            let px_reg = instr.call_args[2]
            let pH_reg = instr.call_args[3]
            let po_reg = instr.call_args[4]
            var stg = gpu_op_new()
            stg.opcode = GpuOpcode::GpuOctBatchStage
            stg.lhs_reg = pA_reg
            stg.rhs_reg = pH_reg
            stg.rhs_imm = sdim
            k = gpu_kernel_append_op(k, stg)
            var tile = gpu_op_wmma_tile(0, 512, po_reg, 16)
            k = gpu_kernel_append_op(k, tile)
            var pad = gpu_op_new()
            pad.opcode = GpuOpcode::GpuOctPostAddBx
            pad.lhs_reg = pB_reg
            pad.rhs_reg = px_reg
            pad.addr_reg = po_reg
            pad.rhs_imm = sdim
            k = gpu_kernel_append_op(k, pad)
        } else if hlir_name_is_ossm_oct_cell(cn) || hlir_name_is_ossm_sed_cell(cn) {
            // Full O-SSM cell: y = Re(C⊗sigmoid(A⊗H + B·x)). call_args = [pA,pB,px,pC,pH,py].
            // Octonion dim=8; sedenion dim=16. Two shared tiles + sigmoid + Re → one GpuOctCell.
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var cell = gpu_op_new()
            cell.opcode = GpuOpcode::GpuOctCell
            cell.rhs_imm = if hlir_name_is_ossm_sed_cell(cn) { 16 } else { 8 }
            cell.lhs_reg = instr.call_args[0]
            cell.rhs_reg = instr.call_args[1]
            cell.addr_reg = instr.call_args[2]
            cell.src_reg = instr.call_args[3]
            cell.shared_addr = instr.call_args[4]
            cell.compare_reg = instr.call_args[5]
            k = gpu_kernel_append_op(k, cell)
        } else if hlir_name_is_ossm_oct_recur(cn) || hlir_name_is_ossm_sed_recur(cn) {
            // O-SSM recurrence over T. call_args = [pA,pB,px,pC,pH,py,T]. Octonion dim=8, sedenion 16.
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var rec = gpu_op_new()
            rec.opcode = GpuOpcode::GpuOctRecur
            rec.rhs_imm = if hlir_name_is_ossm_sed_recur(cn) { 16 } else { 8 }
            rec.lhs_reg = instr.call_args[0]
            rec.rhs_reg = instr.call_args[1]
            rec.addr_reg = instr.call_args[2]
            rec.src_reg = instr.call_args[3]
            rec.shared_addr = instr.call_args[4]
            rec.compare_reg = instr.call_args[5]
            rec.byte_offset = instr.call_args[6]
            k = gpu_kernel_append_op(k, rec)
        } else if hlir_name_is_oct_assoc_bwd_dh(cn) || hlir_name_is_sed_assoc_bwd_dh(cn) {
            // VJP of the associator w.r.t. its input H: dH = L(a⊗b)ᵀ·dD − L(b)ᵀ·(L(a)ᵀ·dD).
            // call_args = [pa, pb, pdD, pdH]. Three transposed tiles + subtract → one GpuOctAssocBwdDh.
            if k.shared_bytes < 3072 { k.shared_bytes = 3072 }
            var abd = gpu_op_new()
            abd.opcode = GpuOpcode::GpuOctAssocBwdDh
            abd.rhs_imm = if hlir_name_is_sed_assoc_bwd_dh(cn) { 16 } else { 8 }
            abd.lhs_reg = instr.call_args[0]
            abd.rhs_reg = instr.call_args[1]
            abd.addr_reg = instr.call_args[2]
            abd.src_reg = instr.call_args[3]
            k = gpu_kernel_append_op(k, abd)
        } else if hlir_name_is_oct_assoc(cn) || hlir_name_is_sed_assoc(cn) {
            // Batched hypercomplex associator [a,b,H] = (a⊗b)⊗H − a⊗(b⊗H) on tensor cores.
            // call_args = [pa, pb, pH, pout]. Three tiles (L(b)·H, L(a)·q, L(a⊗b)·H) + subtract →
            // one GpuOctAssoc. Octonion dim=8; sedenion dim=16. Needs sL+sH+sS+sR = 3072 shared bytes.
            if k.shared_bytes < 3072 { k.shared_bytes = 3072 }
            var asc = gpu_op_new()
            asc.opcode = GpuOpcode::GpuOctAssoc
            asc.rhs_imm = if hlir_name_is_sed_assoc(cn) { 16 } else { 8 }
            asc.lhs_reg = instr.call_args[0]
            asc.rhs_reg = instr.call_args[1]
            asc.addr_reg = instr.call_args[2]
            asc.src_reg = instr.call_args[3]
            k = gpu_kernel_append_op(k, asc)
        } else if hlir_name_is_oct_batch_vjp(cn) || hlir_name_is_sed_batch_vjp(cn) {
            // Backward / VJP of D = L(a)·H. call_args = [pa, pH, pdD, pdH, pda]. One transposed tile
            // (dH = L(a)ᵀ·dD) + a runtime da accumulation → one GpuOctVjp. Needs sL+sH+sS = 2048 bytes.
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var vjp = gpu_op_new()
            vjp.opcode = GpuOpcode::GpuOctVjp
            vjp.rhs_imm = if hlir_name_is_sed_batch_vjp(cn) { 16 } else { 8 }
            vjp.lhs_reg = instr.call_args[0]
            vjp.rhs_reg = instr.call_args[1]
            vjp.addr_reg = instr.call_args[2]
            vjp.src_reg = instr.call_args[3]
            vjp.shared_addr = instr.call_args[4]
            k = gpu_kernel_append_op(k, vjp)
        } else if hlir_name_is_ossm_oct_bwd(cn) || hlir_name_is_ossm_sed_bwd(cn) {
            // One BPTT backward step. call_args = [pA, pHprev, pdHt, pdHprev, pdA]. Transposed tile
            // (dHprev = L(A)ᵀ·dHt, D-layout) + in-place dA accumulation → one GpuOctBwd. 2048 bytes.
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var bwd = gpu_op_new()
            bwd.opcode = GpuOpcode::GpuOctBwd
            bwd.rhs_imm = if hlir_name_is_ossm_sed_bwd(cn) { 16 } else { 8 }
            bwd.lhs_reg = instr.call_args[0]
            bwd.rhs_reg = instr.call_args[1]
            bwd.addr_reg = instr.call_args[2]
            bwd.src_reg = instr.call_args[3]
            bwd.shared_addr = instr.call_args[4]
            k = gpu_kernel_append_op(k, bwd)
        } else if hlir_name_is_oct_matvec_dh8(cn) || hlir_name_is_oct_matvec_dh16(cn) {
            // Hypercomplex matrix-vector H_out = A ⊛ H over D_h octonion channels → dense block-L matmul
            // A_big(N×N)·H_big(N×16), N=D_h·8, f16 m16n16k16 tiles. call_args = [pA, pH, pout].
            let dh = if hlir_name_is_oct_matvec_dh16(cn) { 16 } else { 8 }
            let nn = dh * 8
            let sb = nn * nn * 2 + nn * 16 * 2
            if k.shared_bytes < sb { k.shared_bytes = sb }
            var mv = gpu_op_new()
            mv.opcode = GpuOpcode::GpuOctMatvec
            mv.rhs_imm = dh
            mv.lhs_reg = instr.call_args[0]
            mv.rhs_reg = instr.call_args[1]
            mv.addr_reg = instr.call_args[2]
            k = gpu_kernel_append_op(k, mv)
        } else if hlir_name_is_oct_batch_mul_f64(cn) || hlir_name_is_sed_batch_mul_f64(cn) || hlir_name_is_oct_batch_mul_f64_t(cn) || hlir_name_is_sed_batch_mul_f64_t(cn) || hlir_name_is_oct_batch_mul_f64_grid(cn) || hlir_name_is_sed_batch_mul_f64_grid(cn) {
            // Batched hypercomplex multiply on f64 TENSOR CORES (wmma m8n8k4.f64). call_args =
            // [pa, pH, pout]. L(a) f64 in shared + m8n8k4 f64 tiles → one GpuOctBatchF64. 2048 bytes.
            // byte_offset: 0 = normal, 1 = transpose (L(a)ᵀ·B, BPTT backward), 2 = grid (block-indexed
            // by %ctaid.x — each block does one independent problem, for multi-block throughput).
            let is_t = hlir_name_is_oct_batch_mul_f64_t(cn) || hlir_name_is_sed_batch_mul_f64_t(cn)
            let is_grid = hlir_name_is_oct_batch_mul_f64_grid(cn) || hlir_name_is_sed_batch_mul_f64_grid(cn)
            let is_sed = hlir_name_is_sed_batch_mul_f64(cn) || hlir_name_is_sed_batch_mul_f64_t(cn) || hlir_name_is_sed_batch_mul_f64_grid(cn)
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var bf = gpu_op_new()
            bf.opcode = GpuOpcode::GpuOctBatchF64
            bf.rhs_imm = if is_sed { 16 } else { 8 }
            bf.byte_offset = if is_t { 1 } else { if is_grid { 2 } else { 0 } }
            bf.lhs_reg = instr.call_args[0]
            bf.rhs_reg = instr.call_args[1]
            bf.addr_reg = instr.call_args[2]
            k = gpu_kernel_append_op(k, bf)
        } else if hlir_name_is_ossm_oct_step_f64(cn) || hlir_name_is_ossm_sed_step_f64(cn) {
            // Full-f64 O-SSM step. call_args = [pA, pB, px, pH, pout]. Exact f64 → one GpuOctStepF64.
            var sf = gpu_op_new()
            sf.opcode = GpuOpcode::GpuOctStepF64
            sf.rhs_imm = if hlir_name_is_ossm_sed_step_f64(cn) { 16 } else { 8 }
            sf.lhs_reg = instr.call_args[0]
            sf.rhs_reg = instr.call_args[1]
            sf.addr_reg = instr.call_args[2]
            sf.src_reg = instr.call_args[3]
            sf.shared_addr = instr.call_args[4]
            k = gpu_kernel_append_op(k, sf)
        } else if hlir_name_is_ossm_oct_readout(cn) || hlir_name_is_ossm_sed_readout(cn) {
            // O-SSM real readout y = Re(C⊗h). call_args = [pC, pH, py]. σ(p,p)-signed reduction → one
            // GpuOctReadout (no tile). Octonion dim=8; sedenion dim=16.
            var rdo = gpu_op_new()
            rdo.opcode = GpuOpcode::GpuOctReadout
            rdo.rhs_imm = if hlir_name_is_ossm_sed_readout(cn) { 16 } else { 8 }
            rdo.lhs_reg = instr.call_args[0]
            rdo.rhs_reg = instr.call_args[1]
            rdo.addr_reg = instr.call_args[2]
            k = gpu_kernel_append_op(k, rdo)
        } else if hlir_name_is_ossm_oct_bwd_nl(cn) || hlir_name_is_ossm_sed_bwd_nl(cn) {
            // NONLINEAR BPTT backward step. call_args = [pA, pHprev, pdHt, pS, pdHprev, pdA]. Applies
            // dS = dHt ⊙ σ'(S) then the backward multiply → one GpuOctBwdNl. Needs 2048 shared bytes.
            if k.shared_bytes < 2048 { k.shared_bytes = 2048 }
            var bwn = gpu_op_new()
            bwn.opcode = GpuOpcode::GpuOctBwdNl
            bwn.rhs_imm = if hlir_name_is_ossm_sed_bwd_nl(cn) { 16 } else { 8 }
            bwn.lhs_reg = instr.call_args[0]
            bwn.rhs_reg = instr.call_args[1]
            bwn.addr_reg = instr.call_args[2]
            bwn.src_reg = instr.call_args[3]
            bwn.shared_addr = instr.call_args[4]
            bwn.compare_reg = instr.call_args[5]
            k = gpu_kernel_append_op(k, bwn)
        }
        // Other calls: skip in MVP
    }
    // Unhandled ops silently skipped in MVP bridge

    k
}

// Check if an HlirName starts with "gpu_thread_id" (13 chars).
// "oct_batch_mul" (13 chars) — the batched octonion multiply intrinsic that lowers to a
// tensor-core tile: oct_batch_mul(pa, pH, pout) computes L(a)·H for a 16-state batch.
fn hlir_name_is_oct_batch_mul(n: HlirName) -> bool {
    if n.len != 13 { return false }
    n.buf[0] == 111 as i8 && n.buf[1] == 99 as i8 && n.buf[2] == 116 as i8 && n.buf[3] == 95 as i8 &&
    n.buf[4] == 98 as i8 && n.buf[5] == 97 as i8 && n.buf[6] == 116 as i8 && n.buf[7] == 99 as i8 &&
    n.buf[8] == 104 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 109 as i8 && n.buf[11] == 117 as i8 &&
    n.buf[12] == 108 as i8
}

// "ossm_oct_step" (13 chars) — the O-SSM octonion linear recurrence step S = A⊗H + B·x on tensor
// cores: ossm_oct_step(pA, pB, px, pH, pout).
fn hlir_name_is_ossm_oct_step(n: HlirName) -> bool {
    if n.len != 13 { return false }
    n.buf[0] == 111 as i8 && n.buf[1] == 115 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 109 as i8 &&
    n.buf[4] == 95 as i8 && n.buf[5] == 111 as i8 && n.buf[6] == 99 as i8 && n.buf[7] == 116 as i8 &&
    n.buf[8] == 95 as i8 && n.buf[9] == 115 as i8 && n.buf[10] == 116 as i8 && n.buf[11] == 101 as i8 &&
    n.buf[12] == 112 as i8
}

// "ossm_sed_step" (13 chars) — the O-SSM sedenion linear step S = A⊗H + B·x (dim=16, bits=4).
fn hlir_name_is_ossm_sed_step(n: HlirName) -> bool {
    if n.len != 13 { return false }
    n.buf[0] == 111 as i8 && n.buf[1] == 115 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 109 as i8 &&
    n.buf[4] == 95 as i8 && n.buf[5] == 115 as i8 && n.buf[6] == 101 as i8 && n.buf[7] == 100 as i8 &&
    n.buf[8] == 95 as i8 && n.buf[9] == 115 as i8 && n.buf[10] == 116 as i8 && n.buf[11] == 101 as i8 &&
    n.buf[12] == 112 as i8
}

// "ossm_sed_cell" (13 chars) — full O-SSM sedenion cell (dim=16, bits=4).
fn hlir_name_is_ossm_sed_cell(n: HlirName) -> bool {
    if n.len != 13 { return false }
    n.buf[0] == 111 as i8 && n.buf[1] == 115 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 109 as i8 &&
    n.buf[4] == 95 as i8 && n.buf[5] == 115 as i8 && n.buf[6] == 101 as i8 && n.buf[7] == 100 as i8 &&
    n.buf[8] == 95 as i8 && n.buf[9] == 99 as i8 && n.buf[10] == 101 as i8 && n.buf[11] == 108 as i8 &&
    n.buf[12] == 108 as i8
}

// "ossm_sed_recur" (14 chars) — O-SSM sedenion recurrence over T (dim=16, bits=4).
fn hlir_name_is_ossm_sed_recur(n: HlirName) -> bool {
    if n.len != 14 { return false }
    n.buf[0] == 111 as i8 && n.buf[1] == 115 as i8 && n.buf[2] == 115 as i8 && n.buf[3] == 109 as i8 &&
