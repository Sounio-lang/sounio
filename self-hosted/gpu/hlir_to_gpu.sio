    if n.len < 13 { return false }
    // "gpu_block_dim" = g(103) p(112) u(117) _(95) b(98) l(108) o(111) c(99) k(107) _(95) d(100) i(105) m(109)
    n.buf[0] == 103 as i8 && n.buf[1] == 112 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 95 as i8 &&
    n.buf[4] == 98 as i8 && n.buf[5] == 108 as i8 && n.buf[6] == 111 as i8 && n.buf[7] == 99 as i8 &&
    n.buf[8] == 107 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 100 as i8 && n.buf[11] == 105 as i8 &&
    n.buf[12] == 109 as i8
}

// Convert HlirName → Name (structurally identical, different types).
fn hlir_name_to_name(hn: HlirName) -> Name {
    Name { buf: hn.buf, len: hn.len }
}

// Build a GpuKernelIr from an HlirFunction marked as kernel.
// MVP: handles basic blocks with arithmetic, loads, stores, comparisons, GPU intrinsics.
fn hlir_function_to_gpu_kernel(func: HlirFunction) -> GpuKernelIr with Mut, Panic, Div {
    var kernel = gpu_kernel_new()

    // Copy kernel name
    kernel.kernel_name = hlir_name_to_name(func.name)

    // Map HLIR params → GPU params
    var pi: i64 = 0
    while pi < func.param_count {
        if pi < 8 {
            let p = func.params[pi as usize]
            let param_ty = hlir_type_kind_to_gpu(p.ty.kind)
            kernel.params[pi as usize] = GpuParam {
                name: hlir_name_to_name(p.name),
                ty: param_ty,
            }
            kernel.param_count = kernel.param_count + 1

            if p.value_id >= 0 {
                var load_param = gpu_op_new()
                load_param.opcode = GpuOpcode::GpuLoadParam
                load_param.dst_reg = p.value_id
                load_param.param_idx = pi
                load_param.ty = param_ty
                load_param.dst_ty = param_ty
                kernel = gpu_kernel_append_op(kernel, load_param)
            }
        }
        pi = pi + 1
    }

    // Walk all basic blocks and lower instructions + terminators
    var bi: i64 = 0
    while bi < func.block_count {
        let block = func.blocks[bi as usize]

        var label_op = gpu_op_new()
        label_op.opcode = GpuOpcode::GpuBra
        label_op.src_reg = 1
        label_op.rhs_imm = block.id
        kernel = gpu_kernel_append_op(kernel, label_op)

        // Lower instructions in this block
        var ii: i64 = 0
        while ii < block.instr_count {
            var instr = block.instrs[ii as usize]
            if instr.op_kind == HLIR_OP_STORE {
                let store_ty = hlir_function_lookup_local_type(func, instr.store_value)
                if store_ty.kind != HlirTypeKind::HlirTypeVoid {
                    instr.ty = store_ty
                }
            }
            kernel = hlir_instr_to_gpu_ops(kernel, instr)
            ii = ii + 1
        }

        // Lower block terminator
        let term = block.terminator
        if term.kind == HLIR_TERM_RETURN {
            var ret_op = gpu_op_new()
            ret_op.opcode = GpuOpcode::GpuRet
            kernel = gpu_kernel_append_op(kernel, ret_op)
        } else if term.kind == HLIR_TERM_BRANCH {
            var bra_op = gpu_op_new()
            bra_op.opcode = GpuOpcode::GpuBra
            bra_op.src_reg = 0
            bra_op.rhs_imm = term.branch_target
            bra_op.pred_reg = 0 - 1
            kernel = gpu_kernel_append_op(kernel, bra_op)
        } else if term.kind == HLIR_TERM_COND_BRANCH {
            var bra_then = gpu_op_new()
            bra_then.opcode = GpuOpcode::GpuBra
            bra_then.src_reg = 0
            bra_then.rhs_imm = term.then_block
            bra_then.pred_reg = term.cond_value
            kernel = gpu_kernel_append_op(kernel, bra_then)

            var bra_else = gpu_op_new()
            bra_else.opcode = GpuOpcode::GpuBra
            bra_else.src_reg = 0
            bra_else.rhs_imm = term.else_block
            bra_else.pred_reg = 0 - 1
            kernel = gpu_kernel_append_op(kernel, bra_else)
        }
        // UNREACHABLE/SWITCH: skip in MVP

        bi = bi + 1
    }

    // If no explicit return was emitted, append one
    if kernel.op_count == 0 || kernel.ops[(kernel.op_count - 1) as usize].opcode != GpuOpcode::GpuRet {
        var ret_op = gpu_op_new()
        ret_op.opcode = GpuOpcode::GpuRet
        kernel = gpu_kernel_append_op(kernel, ret_op)
    }

    kernel
}

// ============================================================================
// Section 25 — Epistemic kernel shadow register emission (Sprint 28)
//
// No prior art: Sounio is the first language to propagate epistemic uncertainty
// through GPU kernels at the type level. Each arithmetic op on Knowledge<T>
// values gets a companion shadow op that propagates uncertainty using
// quadrature rules: eps_c = sqrt(eps_a^2 + eps_b^2) for addition,
// eps_c = |a|*eps_b + |b|*eps_a for multiplication.
// ============================================================================

// Emit shadow uncertainty propagation ops for a binary arithmetic GpuOp.
// Returns the kernel with shadow ops appended.
// Shadow registers use ids starting at offset 512 (above normal regs).
fn gpu_emit_epistemic_shadow_binary(
    kernel: GpuKernelIr,
    op: GpuOp,
    shadow_offset: i64
) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let eps_dst = op.dst_reg + shadow_offset
    let eps_lhs = op.lhs_reg + shadow_offset
    let eps_rhs = op.rhs_reg + shadow_offset

    if op.opcode == GpuOpcode::GpuAdd || op.opcode == GpuOpcode::GpuSub {
        // eps_c = sqrt(eps_a^2 + eps_b^2)  [quadrature addition]
        // Step 1: tmp1 = eps_lhs * eps_lhs
        var sq_lhs = gpu_op_new()
        sq_lhs.opcode = GpuOpcode::GpuMul
        sq_lhs.dst_reg = eps_dst + 1000
        sq_lhs.lhs_reg = eps_lhs
        sq_lhs.rhs_reg = eps_lhs
        sq_lhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sq_lhs)

        // Step 2: tmp2 = eps_rhs * eps_rhs
        var sq_rhs = gpu_op_new()
        sq_rhs.opcode = GpuOpcode::GpuMul
        sq_rhs.dst_reg = eps_dst + 1001
        sq_rhs.lhs_reg = eps_rhs
        sq_rhs.rhs_reg = eps_rhs
        sq_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sq_rhs)

        // Step 3: tmp3 = tmp1 + tmp2
        var add_sq = gpu_op_new()
        add_sq.opcode = GpuOpcode::GpuAdd
        add_sq.dst_reg = eps_dst + 1002
        add_sq.lhs_reg = eps_dst + 1000
        add_sq.rhs_reg = eps_dst + 1001
        add_sq.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, add_sq)

        // Step 4: eps_dst = sqrt(tmp3)
        var sqrt_op = gpu_op_new()
        sqrt_op.opcode = GpuOpcode::GpuSqrt
        sqrt_op.dst_reg = eps_dst
        sqrt_op.src_reg = eps_dst + 1002
        sqrt_op.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sqrt_op)
    } else if op.opcode == GpuOpcode::GpuMul {
        // eps_c = |a|*eps_b + |b|*eps_a  [first-order product rule]
        // Step 1: tmp1 = abs(lhs) * eps_rhs
        var abs_lhs = gpu_op_new()
        abs_lhs.opcode = GpuOpcode::GpuAbs
        abs_lhs.dst_reg = eps_dst + 1000
        abs_lhs.src_reg = op.lhs_reg
        abs_lhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_lhs)

        var mul1 = gpu_op_new()
        mul1.opcode = GpuOpcode::GpuMul
        mul1.dst_reg = eps_dst + 1001
        mul1.lhs_reg = eps_dst + 1000
        mul1.rhs_reg = eps_rhs
        mul1.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul1)

        // Step 2: tmp2 = abs(rhs) * eps_lhs
        var abs_rhs = gpu_op_new()
        abs_rhs.opcode = GpuOpcode::GpuAbs
        abs_rhs.dst_reg = eps_dst + 1002
        abs_rhs.src_reg = op.rhs_reg
        abs_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_rhs)

        var mul2 = gpu_op_new()
        mul2.opcode = GpuOpcode::GpuMul
        mul2.dst_reg = eps_dst + 1003
        mul2.lhs_reg = eps_dst + 1002
        mul2.rhs_reg = eps_lhs
        mul2.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul2)

        // Step 3: eps_dst = tmp1 + tmp2
        var add_eps = gpu_op_new()
        add_eps.opcode = GpuOpcode::GpuAdd
        add_eps.dst_reg = eps_dst
        add_eps.lhs_reg = eps_dst + 1001
        add_eps.rhs_reg = eps_dst + 1003
        add_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, add_eps)
    } else if op.opcode == GpuOpcode::GpuDiv {
        // eps_c = eps_a / |b|  [first-order quotient, simplified]
        var abs_rhs = gpu_op_new()
        abs_rhs.opcode = GpuOpcode::GpuAbs
        abs_rhs.dst_reg = eps_dst + 1000
        abs_rhs.src_reg = op.rhs_reg
        abs_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_rhs)

        var div_eps = gpu_op_new()
        div_eps.opcode = GpuOpcode::GpuDiv
        div_eps.dst_reg = eps_dst
        div_eps.lhs_reg = eps_lhs
        div_eps.rhs_reg = eps_dst + 1000
        div_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, div_eps)
    }
    // Other ops: shadow passthrough (eps_dst = max(eps_lhs, eps_rhs))

    k
}

// Emit shadow uncertainty propagation for unary GpuOps (Sprint 30).
// Sqrt: eps = eps_in / (2 * |val|)  [derivative of sqrt]
// Abs/Neg: eps = eps_in              [passthrough]
fn gpu_emit_epistemic_shadow_unary(
    kernel: GpuKernelIr,
    op: GpuOp,
    shadow_offset: i64
) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let eps_dst = op.dst_reg + shadow_offset
    let eps_src = op.src_reg + shadow_offset

    if op.opcode == GpuOpcode::GpuSqrt {
        // TODO: Add domain check: valid_res = valid_a AND (a >= 0.0)
        // Currently only propagates inherited validity without domain constraint.
        // eps_sqrt = eps_in / (2 * |val|)
        // Step 1: tmp1 = abs(val)
        var abs_val = gpu_op_new()
        abs_val.opcode = GpuOpcode::GpuAbs
        abs_val.dst_reg = eps_dst + 1000
        abs_val.src_reg = op.src_reg
        abs_val.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_val)

        var mul_two = gpu_op_new()
        mul_two.opcode = GpuOpcode::GpuMulImm
        mul_two.dst_reg = eps_dst + 1002
        mul_two.lhs_reg = eps_dst + 1000
        mul_two.rhs_imm = 2
        mul_two.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul_two)

        // Step 3: eps_dst = eps_src / tmp2
        var div_eps = gpu_op_new()
        div_eps.opcode = GpuOpcode::GpuDiv
        div_eps.dst_reg = eps_dst
        div_eps.lhs_reg = eps_src
        div_eps.rhs_reg = eps_dst + 1002
        div_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, div_eps)
    } else if op.opcode == GpuOpcode::GpuAbs {
        // eps passthrough: uncertainty unchanged by abs
        var copy_eps = gpu_op_new()
        copy_eps.opcode = GpuOpcode::GpuMulImm
        copy_eps.dst_reg = eps_dst
        copy_eps.lhs_reg = eps_src
        copy_eps.rhs_imm = 1
        copy_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, copy_eps)
    }

    k
}

// Lower an HlirFunction to GpuKernelIr with epistemic shadow registers.
// Each parameter gets a shadow uncertainty register; each arithmetic op
// gets companion uncertainty propagation ops.
fn hlir_function_to_epistemic_gpu_kernel(func: HlirFunction) -> GpuKernelIr with Mut, Panic, Div {
    var kernel = hlir_function_to_gpu_kernel(func)

    // Shadow register offset: shadow for reg R is at R + 512
    let shadow_offset: i64 = 512

    // Walk ops and insert shadow propagation for arithmetic ops
    // We work on a copy to avoid in-place insertion complexity
    var src_ops: [GpuOp; 1024] = kernel.ops
    let src_count = kernel.op_count

    // Reset kernel ops and rebuild with interleaved shadow ops
    kernel.op_count = 0
    var oi: i64 = 0
    while oi < src_count {
        let op = src_ops[oi as usize]
        // Append original op
        kernel = gpu_kernel_append_op(kernel, op)

        // If it's an arithmetic binary op, also emit shadow propagation
        if op.opcode == GpuOpcode::GpuAdd || op.opcode == GpuOpcode::GpuSub ||
           op.opcode == GpuOpcode::GpuMul || op.opcode == GpuOpcode::GpuDiv {
            kernel = gpu_emit_epistemic_shadow_binary(kernel, op, shadow_offset)
        }
        // Unary ops: sqrt, abs
        if op.opcode == GpuOpcode::GpuSqrt || op.opcode == GpuOpcode::GpuAbs {
            kernel = gpu_emit_epistemic_shadow_unary(kernel, op, shadow_offset)
        }

        oi = oi + 1
    }

    kernel
}

// ============================================================================
// Section 26 — End-to-end pipeline orchestrators (Sprint 28)
// ============================================================================

fn hlir_ptx_append_kernel_module(dst: PtxBuf, src: PtxBuf, include_header: bool) -> PtxBuf with Mut, Panic {
    var out = dst
    var i: i64 = 0
    if !include_header {
        var newline_count: i64 = 0
        while i < src.len && newline_count < 4 {
            if src.data[i as usize] == 10 as i8 {
                newline_count = newline_count + 1
            }
            i = i + 1
        }
    }
    while i < src.len {
        if out.len < 65536 {
            out.data[out.len as usize] = src.data[i as usize]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// Extract all kernel functions from an HlirModule, lower each to GpuKernelIr,
// then lower each to PTX and concatenate into a single PtxBuf.
pub(crate) fn hlir_kernels_to_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = hlir_ptx_append_kernel_module(combined, ptx, ki == 0)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions, apply auto-tuning, then lower to PTX.
// Auto-tuning detects workload patterns and sets optimal CTA dimensions.
pub(crate) fn hlir_kernels_to_tuned_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    let cfg = gpu_autotune_config_default()
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            var gpu_kernel = hlir_function_to_gpu_kernel(func)
            // Apply auto-tuning: analyze workload pattern, set block shape
            let tuned = gpu_autotune_tune_kernel(gpu_kernel, cfg)
            let threads = gpu_block_shape_total_threads(tuned.block_shape)
            if threads > 0 {
                gpu_kernel.max_threads = threads
            }
            if tuned.shared_mem_bytes > gpu_kernel.shared_mem_bytes {
                gpu_kernel.shared_mem_bytes = tuned.shared_mem_bytes
            }
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = hlir_ptx_append_kernel_module(combined, ptx, ki == 0)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions, attempt pairwise fusion, then lower to PTX.
// Kernel fusion merges compatible adjacent kernels to reduce launch overhead.
pub(crate) fn hlir_kernels_to_fused_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    // Extract all kernels into array
    var kernels: [GpuKernelIr; 32] = [gpu_kernel_new(); 32]
    var actual: i64 = 0
    var ki: i64 = 0
    while ki < kcount && ki < 32 {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            kernels[actual as usize] = hlir_function_to_gpu_kernel(func)
            actual = actual + 1
        }
        ki = ki + 1
    }

    // Attempt pairwise fusion (greedy)
    var fused_kernels: [GpuKernelIr; 32] = [gpu_kernel_new(); 32]
    var fused_count: i64 = 0
    var fi: i64 = 0
    while fi < actual {
        if fi + 1 < actual {
            let pair = gpu_fuse_pair(kernels[fi as usize], kernels[(fi + 1) as usize])
            if pair.1 {
                // Fusion succeeded
                fused_kernels[fused_count as usize] = pair.0
                fused_count = fused_count + 1
                fi = fi + 2
            } else {
                // Keep original
                fused_kernels[fused_count as usize] = kernels[fi as usize]
                fused_count = fused_count + 1
                fi = fi + 1
            }
        } else {
            fused_kernels[fused_count as usize] = kernels[fi as usize]
            fused_count = fused_count + 1
            fi = fi + 1
        }
    }

    // Lower all (fused + unfused) kernels to PTX
    var pi: i64 = 0
    while pi < fused_count {
        let ptx = gpu_lower_to_ptx(fused_kernels[pi as usize])
        combined = hlir_ptx_append_kernel_module(combined, ptx, pi == 0)
        pi = pi + 1
    }
    combined
}

// Extract all kernel functions with epistemic shadow registers, then lower to PTX.
// Each kernel gets companion uncertainty propagation ops for arithmetic operations.
pub(crate) fn hlir_kernels_to_epistemic_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_epistemic_gpu_kernel(func)
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = hlir_ptx_append_kernel_module(combined, ptx, ki == 0)
        }
        ki = ki + 1
    }
    combined
}

// Map GpuOpcode enum value → SPIR-V opcode tag used by gpu_lower_to_spirv.
// These constants match the GPU_OP_* values in spv_lower_single_op.
// Using enum comparisons (not raw indices) to survive future GpuOpcode reordering.
fn gpu_opcode_to_spirv_tag(op: GpuOpcode) -> i64 {
    if op == GpuOpcode::GpuGetTid        { return 0  }
    if op == GpuOpcode::GpuAdd           { return 3  }
    if op == GpuOpcode::GpuSub           { return 4  }
    if op == GpuOpcode::GpuMul           { return 5  }
    if op == GpuOpcode::GpuDiv           { return 6  }
    if op == GpuOpcode::GpuBarrierSync   { return 8  }
    if op == GpuOpcode::GpuShflDown      { return 9  }
    if op == GpuOpcode::GpuLoadGlobal    { return 13 }
    if op == GpuOpcode::GpuStoreGlobal   { return 14 }
    if op == GpuOpcode::GpuSetpLt        { return 21 }
    if op == GpuOpcode::GpuSetpLe        { return 22 }
    if op == GpuOpcode::GpuSetpEq        { return 23 }
    if op == GpuOpcode::GpuSetpGe        { return 24 }
    -1
}

// Map GpuType enum value → SPIR-V type tag used by gpu_lower_to_spirv.
fn gpu_type_to_spirv_tag(ty: GpuType) -> i64 {
    if ty == GpuType::GpuF32 { return 0 }
    if ty == GpuType::GpuF64 { return 1 }
    if ty == GpuType::GpuI32 { return 2 }
    if ty == GpuType::GpuI64 { return 3 }
    if ty == GpuType::GpuU32 { return 4 }
    if ty == GpuType::GpuU64 { return 5 }
    0
}

// Extract all kernel functions from an HlirModule and lower each to SPIR-V binary.
// Returns a single SpvBuf containing all kernels concatenated.
// Does NOT require GPU hardware — validates code generation only.
fn hlir_kernels_to_spirv(module: HlirModule) -> SpvBuf with Mut, Panic, Div, Alloc {
    var combined = spv_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)

            // Flatten GpuKernelIr ops into the flat arrays expected by gpu_lower_to_spirv
            var ops_opcodes: [i64; 256] = [0; 256]
            var ops_dst:     [i64; 256] = [0; 256]
            var ops_src_a:   [i64; 256] = [0; 256]
            var ops_src_b:   [i64; 256] = [0; 256]
            var ops_types:   [i64; 256] = [0; 256]
            var ops_imm:     [i64; 256] = [0; 256]
            var op_count: i64 = 0
            while op_count < gpu_kernel.op_count && op_count < 256 {
                let op = gpu_kernel.ops[op_count as usize]
                ops_opcodes[op_count as usize] = gpu_opcode_to_spirv_tag(op.opcode)
                ops_dst[op_count as usize]     = op.dst_reg
                ops_src_a[op_count as usize]   = op.lhs_reg
                ops_src_b[op_count as usize]   = op.rhs_reg
                ops_types[op_count as usize]   = gpu_type_to_spirv_tag(op.ty)
                op_count = op_count + 1
            }

            let kname = name_to_string(gpu_kernel.kernel_name)
            let spv = gpu_lower_to_spirv(kname, gpu_kernel.param_count,
                          ops_opcodes, ops_dst, ops_src_a, ops_src_b, ops_types, ops_imm, op_count)

            // Append this kernel's words to combined output
            var wi: i64 = 0
            while wi < spv.word_count {
                combined = spv_push_word(combined, spv.words[wi as usize])
                wi = wi + 1
            }
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions with epistemic shadow registers, then lower to SPIR-V.
// Each kernel gets companion uncertainty propagation ops for arithmetic operations.
// Uses gpu_lower_to_epistemic_spirv() from epistemic_spirv.sio.
fn hlir_kernels_to_epistemic_spirv(module: HlirModule) -> SpvBuf with Mut, Panic, Div, Alloc {
    var combined = spv_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_epistemic_gpu_kernel(func)

            // Flatten GpuKernelIr ops into flat arrays for gpu_lower_to_epistemic_spirv
            var ops_opcodes: [i64; 256] = [0; 256]
            var ops_dst:     [i64; 256] = [0; 256]
            var ops_src_a:   [i64; 256] = [0; 256]
            var ops_src_b:   [i64; 256] = [0; 256]
            var ops_types:   [i64; 256] = [0; 256]
            var op_count: i64 = 0
            while op_count < gpu_kernel.op_count && op_count < 256 {
                let op = gpu_kernel.ops[op_count as usize]
                ops_opcodes[op_count as usize] = gpu_opcode_to_spirv_tag(op.opcode)
                ops_dst[op_count as usize]     = op.dst_reg
                ops_src_a[op_count as usize]   = op.lhs_reg
                ops_src_b[op_count as usize]   = op.rhs_reg
                ops_types[op_count as usize]   = gpu_type_to_spirv_tag(op.ty)
                op_count = op_count + 1
            }

            let kname = name_to_string(gpu_kernel.kernel_name)
            let spv = gpu_lower_to_epistemic_spirv(kname, gpu_kernel.param_count,
                          ops_opcodes, ops_dst, ops_src_a, ops_src_b, ops_types, op_count)

            // Append this kernel's words to combined output
            var wi: i64 = 0
            while wi < spv.word_count {
                combined = spv_push_word(combined, spv.words[wi as usize])
                wi = wi + 1
            }
        }
        ki = ki + 1
    }
    combined
}

pub struct GpuSpirvArtifact {
    data: [i8; 65536],
    len: i64,
    word_count: i64,
}

fn gpu_spirv_artifact_empty() -> GpuSpirvArtifact {
    GpuSpirvArtifact { data: [0; 65536], len: 0, word_count: 0 }
}

fn gpu_spirv_artifact_from_buf(buf: SpvBuf) -> GpuSpirvArtifact with Mut, Panic, Div {
    var out = gpu_spirv_artifact_empty()
    out.word_count = buf.word_count
    var i: i64 = 0
    while i < buf.word_count {
        let w = buf.words[i as usize]
        if out.len + 4 <= 65536 {
            out.data[out.len as usize] = (w % 256) as i8
            out.data[(out.len + 1) as usize] = ((w / 256) % 256) as i8
            out.data[(out.len + 2) as usize] = ((w / 65536) % 256) as i8
            out.data[(out.len + 3) as usize] = ((w / 16777216) % 256) as i8
            out.len = out.len + 4
        }
        i = i + 1
    }
    out
}

pub(crate) fn hlir_kernels_to_spirv_artifact(module: HlirModule) -> GpuSpirvArtifact with Mut, Panic, Div, Alloc {
    gpu_spirv_artifact_from_buf(hlir_kernels_to_spirv(module))
}

pub(crate) fn hlir_kernels_to_epistemic_spirv_artifact(module: HlirModule) -> GpuSpirvArtifact with Mut, Panic, Div, Alloc {
    gpu_spirv_artifact_from_buf(hlir_kernels_to_epistemic_spirv(module))
}

// Extract all kernel functions and lower to Metal MSL.
pub(crate) fn hlir_kernels_to_metal(module: HlirModule) -> MetalBuf with Mut, Panic, Div, Alloc {
    var combined = metal_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)
            let metal = gpu_lower_to_metal(gpu_kernel)
            combined = metal_buf_append(combined, metal)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions and lower to CUDA Tile IR (MLIR dialect text).
// Returns a TileBuf containing all kernels as cuda_tile.module blocks.
// Map GpuOpcode enum variant → K-AXI numeric tag (matches gpu_lower_to_kaxi constants).
fn gpu_opcode_to_kaxi_tag(op: GpuOpcode) -> i64 {
    if op == GpuOpcode::GpuGetTid      { return GpuOpcodeGetTid }
    if op == GpuOpcode::GpuCvt         { return GpuOpcodeCvt }
    if op == GpuOpcode::GpuMulImm      { return GpuOpcodeMulImm }
    if op == GpuOpcode::GpuAdd         { return GpuOpcodeAdd }
    if op == GpuOpcode::GpuSub         { return GpuOpcodeSub }
    if op == GpuOpcode::GpuMul         { return GpuOpcodeMul }
    if op == GpuOpcode::GpuDiv         { return GpuOpcodeDiv }
    if op == GpuOpcode::GpuMax         { return GpuOpcodeMax }
    if op == GpuOpcode::GpuMin         { return GpuOpcodeMin }
    if op == GpuOpcode::GpuAnd         { return GpuOpcodeAnd }
    if op == GpuOpcode::GpuOr          { return GpuOpcodeOr }
    if op == GpuOpcode::GpuXor         { return GpuOpcodeXor }
    if op == GpuOpcode::GpuShl         { return GpuOpcodeShl }
    if op == GpuOpcode::GpuLoadGlobal  { return GpuOpcodeLoadGlobal }
    if op == GpuOpcode::GpuStoreGlobal { return GpuOpcodeStoreGlobal }
    if op == GpuOpcode::GpuRet         { return GpuOpcodeRet }
    if op == GpuOpcode::GpuFma         { return GpuOpcodeFma }
    if op == GpuOpcode::GpuGetBid      { return GpuOpcodeGetBid }
    if op == GpuOpcode::GpuGetNtid     { return GpuOpcodeGetNtid }
    if op == GpuOpcode::GpuAddImm      { return GpuOpcodeAddImm }
    if op == GpuOpcode::GpuBarrierSync { return GpuOpcodeBarrierSync }
    if op == GpuOpcode::GpuSetpLt      { return GpuOpcodeSetpLt }
    if op == GpuOpcode::GpuSetpLe      { return GpuOpcodeSetpLe }
    if op == GpuOpcode::GpuSetpEq      { return GpuOpcodeSetpEq }
    if op == GpuOpcode::GpuSetpGe      { return GpuOpcodeSetpGe }
    if op == GpuOpcode::GpuSelp        { return GpuOpcodeSelp }
    if op == GpuOpcode::GpuAtomicAdd   { return GpuOpcodeAtomicAdd }
    if op == GpuOpcode::GpuAtomicSub   { return GpuOpcodeAtomicSub }
    if op == GpuOpcode::GpuAtomicMin   { return GpuOpcodeAtomicMin }
    if op == GpuOpcode::GpuAtomicMax   { return GpuOpcodeAtomicMax }
    if op == GpuOpcode::GpuSqrt        { return GpuOpcodeSqrt }
    if op == GpuOpcode::GpuAbs         { return GpuOpcodeAbs }
    if op == GpuOpcode::GpuNeg         { return GpuOpcodeNeg }
    if op == GpuOpcode::GpuSetpGt      { return GpuOpcodeSetpGt }
    if op == GpuOpcode::GpuSetpNe      { return GpuOpcodeSetpNe }
    if op == GpuOpcode::GpuLoadParam   { return GpuOpcodeLoadParam }
    0
}

// Extract all kernel functions and lower to K-AXI epistemic assembly.
// Returns a KaxiAsmBuf containing all kernels concatenated with separators.
pub(crate) fn hlir_kernels_to_kaxi(module: HlirModule) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var combined = kaxi_asm_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)

            // Flatten GpuKernelIr ops into the flat arrays expected by gpu_lower_to_kaxi_typed
            var ops_opcodes: [i64; 256] = [0; 256]
            var ops_dst:     [i64; 256] = [0; 256]
            var ops_src_a:   [i64; 256] = [0; 256]
            var ops_src_b:   [i64; 256] = [0; 256]
            var ops_imm:     [i64; 256] = [0; 256]
            var ops_types:   [i64; 256] = [0; 256]
            var op_count: i64 = 0
            while op_count < gpu_kernel.op_count && op_count < 256 {
                let op = gpu_kernel.ops[op_count as usize]
                let tag = gpu_opcode_to_kaxi_tag(op.opcode)
                ops_opcodes[op_count as usize] = tag
                ops_dst[op_count as usize]     = op.dst_reg
                var op_type_code: i64 = 0
                if op.ty == GpuType::GpuF64 {
                    op_type_code = 1
                } else if op.ty == GpuType::GpuI32 {
                    op_type_code = 2
                }
                ops_types[op_count as usize]   = op_type_code
                if op.opcode == GpuOpcode::GpuLoadGlobal {
                    ops_src_a[op_count as usize] = op.addr_reg
                    ops_src_b[op_count as usize] = 0
                } else if op.opcode == GpuOpcode::GpuStoreGlobal {
                    ops_src_a[op_count as usize] = op.src_reg
                    ops_src_b[op_count as usize] = op.addr_reg
                } else if op.opcode == GpuOpcode::GpuMulImm || op.opcode == GpuOpcode::GpuAddImm {
                    ops_src_a[op_count as usize] = 0
                    ops_src_b[op_count as usize] = 0
                    ops_imm[op_count as usize]   = op.rhs_imm
                } else if op.opcode == GpuOpcode::GpuLoadParam {
                    ops_src_a[op_count as usize] = 0
                    ops_src_b[op_count as usize] = 0
                    ops_imm[op_count as usize]   = op.param_idx
                } else {
                    ops_src_a[op_count as usize] = op.lhs_reg
                    ops_src_b[op_count as usize] = op.rhs_reg
                }
                op_count = op_count + 1
            }

            let kaxi = gpu_lower_to_kaxi_typed(ops_opcodes, ops_dst, ops_src_a, ops_src_b, ops_imm, ops_types, op_count)
            combined = kaxi_asm_buf_append(combined, kaxi)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions and lower to CUDA Tile IR (MLIR dialect text).
// Returns a TileBuf containing all kernels as cuda_tile.module blocks.
pub(crate) fn hlir_kernels_to_cuda_tile(module: HlirModule) -> TileBuf with Mut, Panic, Div, Alloc {
    var combined = tile_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)

            // Flatten GpuKernelIr ops into flat arrays for gpu_lower_to_cuda_tile
            var ops_opcodes: [i64; 256] = [0; 256]
            var ops_dst:     [i64; 256] = [0; 256]
            var ops_src_a:   [i64; 256] = [0; 256]
            var ops_src_b:   [i64; 256] = [0; 256]
            var ops_types:   [i64; 256] = [0; 256]
            var op_count: i64 = 0
            while op_count < gpu_kernel.op_count && op_count < 256 {
                let op = gpu_kernel.ops[op_count as usize]
                ops_opcodes[op_count as usize] = gpu_opcode_to_spirv_tag(op.opcode)
                ops_dst[op_count as usize]     = op.dst_reg
                ops_src_a[op_count as usize]   = op.lhs_reg
                ops_src_b[op_count as usize]   = op.rhs_reg
                ops_types[op_count as usize]   = gpu_type_to_spirv_tag(op.ty)
                op_count = op_count + 1
            }

            let kname = name_to_string(gpu_kernel.kernel_name)
            let tile_buf = gpu_lower_to_cuda_tile(kname, gpu_kernel.param_count,
                           ops_opcodes, ops_dst, ops_src_a, ops_src_b, ops_types, op_count)

            // Append this kernel's text to combined output
            var ti: i64 = 0
            while ti < tile_buf.len {
                combined.data[(combined.len + ti) as usize] = tile_buf.data[ti as usize]
                ti = ti + 1
            }
            combined.len = combined.len + tile_buf.len
        }
        ki = ki + 1
    }
    combined
}

// ============================================================================
// Section 29b — Deep-wired novelty production implementations
// ============================================================================

// Popcount: count set bits using Kernighan's algorithm
fn epfuse_popcount(x: i64) -> i64 {
    var n = x
    var count: i64 = 0
    while n != 0 {
        n = n & (n - 1)
        count = count + 1
    }
    count
}

// Map GpuWorkloadTag to provenance bit tag for epistemic fusion
fn hlir_workload_prov_tag(tag: GpuWorkloadTag) -> i64 {
    if tag == GpuWorkloadTag::GpuWorkloadGeneral   { return 1   }
    if tag == GpuWorkloadTag::GpuWorkloadMl        { return 2   }
    if tag == GpuWorkloadTag::GpuWorkloadOnn       { return 4   }
    if tag == GpuWorkloadTag::GpuWorkloadQnn       { return 8   }
    if tag == GpuWorkloadTag::GpuWorkloadSnn       { return 16  }
    if tag == GpuWorkloadTag::GpuWorkloadSpnn      { return 32  }
    if tag == GpuWorkloadTag::GpuWorkloadQuantnn   { return 64  }
    if tag == GpuWorkloadTag::GpuWorkloadHyperMath { return 128 }
    256
}

// Check if a kernel contains heavy math operations (sqrt, exp, sin, cos)
fn spec_is_heavy_math_kernel(kernel: GpuKernelIr) -> bool {
    var oi: i64 = 0
    while oi < kernel.op_count && oi < 1024 {
        let op = kernel.ops[oi as usize]
        if op.opcode == GpuOpcode::GpuSqrt || op.opcode == GpuOpcode::GpuExp2 ||
           op.opcode == GpuOpcode::GpuSin || op.opcode == GpuOpcode::GpuCos {
            return true
        }
        oi = oi + 1
    }
    if kernel.op_count > 128 {
        return true
    }
    false
}

// Extract all kernel functions and apply epistemic kernel fusion (Novelty 4),
// then lower to PTX. Fuses kernels with provenance XOR weighting + uncertainty penalties.
// Production implementation: inline epistemic pairwise fusion with provenance scoring.
pub(crate) fn hlir_kernels_to_epistemic_fused_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }

    // Phase 1: Extract all kernels from HLIR module
    var kernels: [GpuKernelIr; 64] = [gpu_kernel_new(); 64]
    var actual: i64 = 0
    var ki: i64 = 0
    while ki < kcount && ki < 64 {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            kernels[actual as usize] = hlir_function_to_epistemic_gpu_kernel(func)
            actual = actual + 1
        }
        ki = ki + 1
    }

    // Phase 2: Compute provenance tags from workload types
    var prov_tags: [i64; 64] = [0; 64]
    var ei: i64 = 0
    while ei < actual {
        prov_tags[ei as usize] = hlir_workload_prov_tag(kernels[ei as usize].workload_tag)
        ei = ei + 1
    }

    // Phase 3: Get fusion configuration
    let cfg = gpu_fusion_config_default()

    // Phase 4: Greedy epistemic pairwise fusion with provenance scoring
    var fused_kernels: [GpuKernelIr; 64] = [gpu_kernel_new(); 64]
    var fused_count: i64 = 0
    var fi: i64 = 0
    while fi < actual {
        if fi + 1 < actual {
            let prov_xor = prov_tags[fi as usize] ^ prov_tags[(fi + 1) as usize]
            let overlap = gpu_fusion_overlap_params(kernels[fi as usize], kernels[(fi + 1) as usize])
            let base_score = gpu_fusion_score_pair(kernels[fi as usize], kernels[(fi + 1) as usize])
            let pcount = epfuse_popcount(prov_xor)
            let score = base_score + 60 * pcount

            if score > cfg.min_benefit_score && overlap > 0 && prov_xor != 0 {
                let pair = gpu_fuse_pair(kernels[fi as usize], kernels[(fi + 1) as usize])
                if pair.1 {
                    // Fusion succeeded
                    fused_kernels[fused_count as usize] = pair.0
                    fused_count = fused_count + 1
                    fi = fi + 2
                } else {
                    // Keep original
                    fused_kernels[fused_count as usize] = kernels[fi as usize]
                    fused_count = fused_count + 1
                    fi = fi + 1
                }
            } else {
                fused_kernels[fused_count as usize] = kernels[fi as usize]
                fused_count = fused_count + 1
                fi = fi + 1
            }
        } else {
            fused_kernels[fused_count as usize] = kernels[fi as usize]
            fused_count = fused_count + 1
            fi = fi + 1
        }
    }

    // Phase 5: Lower all fused kernels to PTX
    var pi: i64 = 0
    while pi < fused_count {
        let ptx = gpu_lower_to_ptx(fused_kernels[pi as usize])
        combined = hlir_ptx_append_kernel_module(combined, ptx, pi == 0)
        pi = pi + 1
    }

    combined
}

// Extract all kernel functions and apply speculative epistemic execution (Novelty 5),
// then lower to PTX. Emits uncertainty-threshold skip guards for refinement kernels.
// Production implementation: classify kernels, emit speculative plan metadata.
pub(crate) fn hlir_kernels_to_speculative_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }

    // Phase 1: Extract all kernels from HLIR module
    var kernels: [GpuKernelIr; 64] = [gpu_kernel_new(); 64]
    var actual: i64 = 0
    var ki: i64 = 0
    while ki < kcount && ki < 64 {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            kernels[actual as usize] = hlir_function_to_epistemic_gpu_kernel(func)
            actual = actual + 1
        }
        ki = ki + 1
    }

    // Phase 2: Classify kernels as coarse or refinement
    var is_refinement: [bool; 64] = [false; 64]
    var coarse_count: i64 = 0
    var refinement_count: i64 = 0
    var ci: i64 = 0
    while ci < actual {
        if spec_is_heavy_math_kernel(kernels[ci as usize]) {
            is_refinement[ci as usize] = true
            refinement_count = refinement_count + 1
        } else {
            coarse_count = coarse_count + 1
        }
        ci = ci + 1
    }

    // Phase 3: Emit speculative plan metadata as PTX comments
    combined = ptx_push_str(combined, "// SOUNIO_SPEC_PLAN coarse=")
    combined = gpu_push_i64(combined, coarse_count)
    combined = ptx_push_str(combined, " refinement=")
    combined = gpu_push_i64(combined, refinement_count)
    combined = ptx_push_str(combined, " threshold=1.0e-6\n")

    // Phase 4: Lower each kernel with speculative metadata
    var si: i64 = 0
    while si < actual {
        if is_refinement[si as usize] {
            combined = ptx_push_str(combined, "// SOUNIO_SPEC_GUARD kernel=")
            combined = gpu_push_i64(combined, si)
            combined = ptx_push_str(combined, "\n")
        }
        let ptx = gpu_lower_to_ptx(kernels[si as usize])
        combined = hlir_ptx_append_kernel_module(combined, ptx, si == 0)
        si = si + 1
    }

    combined
}

// Extract all kernel functions and apply provenance-aware DAG scheduling (Novelty 6),
// then lower to PTX. Builds kernel DAG, assigns CUDA streams via provenance XOR,
// emits stream assignment metadata as PTX comments.
// Production implementation: full Kahn's topological sort + greedy stream coloring.
pub(crate) fn hlir_kernels_to_dag_scheduled_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }

    // Phase 1: Extract all kernels from HLIR module
    var kernels: [GpuKernelIr; 64] = [gpu_kernel_new(); 64]
    var actual: i64 = 0
    var ki: i64 = 0
    while ki < kcount && ki < 64 {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            kernels[actual as usize] = hlir_function_to_epistemic_gpu_kernel(func)
            actual = actual + 1
        }
        ki = ki + 1
    }

    // Phase 2: Compute provenance tags
    var prov_tags: [i64; 64] = [0; 64]
    var pi: i64 = 0
    while pi < actual {
        prov_tags[pi as usize] = hlir_workload_prov_tag(kernels[pi as usize].workload_tag)
        pi = pi + 1
    }

    // Phase 3: Build dependency graph (adjacency list).
    // Flat [i64; 1024] avoids souc's nested-array-type parse bug.
    // deps[kernel_idx * 16 + dep_slot] stores the dependency kernel index.
    var deps: [i64; 1024] = [0; 1024]
    var dep_count: [i64; 64] = [0; 64]
    var di: i64 = 0
    while di < actual {
        var dj: i64 = 0
        while dj < actual {
            if di != dj {
                let overlap = gpu_fusion_overlap_params(kernels[di as usize], kernels[dj as usize])
                if overlap > 0 && prov_tags[di as usize] & prov_tags[dj as usize] != 0 {
                    // kernel dj depends on di
                    if dep_count[dj as usize] < 16 {
                        deps[(dj * 16 + dep_count[dj as usize]) as usize] = di
                        dep_count[dj as usize] = dep_count[dj as usize] + 1
                    }
                }
            }
            dj = dj + 1
        }
        di = di + 1
    }

    // Phase 4: Kahn's topological sort
    var in_degree: [i64; 64] = [0; 64]
    var ti: i64 = 0
    while ti < actual {
        in_degree[ti as usize] = dep_count[ti as usize]
        ti = ti + 1
    }

    var queue: [i64; 64] = [0; 64]
    var front: i64 = 0
    var rear: i64 = 0
    var topo_order: [i64; 64] = [0; 64]
    var topo_count: i64 = 0

    // Enqueue nodes with in_degree == 0
    var qi: i64 = 0
    while qi < actual {
        if in_degree[qi as usize] == 0 {
            queue[rear as usize] = qi
            rear = rear + 1
        }
        qi = qi + 1
    }

    // Process queue
    while front < rear {
        let node = queue[front as usize]
        front = front + 1
        topo_order[node as usize] = topo_count
        topo_count = topo_count + 1

        // For each kernel that depends on this one, decrement in_degree
        var fi: i64 = 0
        while fi < actual {
            var dci: i64 = 0
            while dci < dep_count[fi as usize] {
                if deps[(fi * 16 + dci) as usize] == node {
                    in_degree[fi as usize] = in_degree[fi as usize] - 1
                    if in_degree[fi as usize] == 0 {
                        queue[rear as usize] = fi
                        rear = rear + 1
                    }
                }
                dci = dci + 1
            }
            fi = fi + 1
        }
    }

    // Phase 5: Greedy stream assignment
    var stream_ids: [i64; 64] = [0; 64]
    var stream_count: i64 = 1
    var si: i64 = 0
    while si < topo_count {
        // Find next node in topo order
        var node: i64 = -1
        var ni: i64 = 0
        while ni < actual {
            if topo_order[ni as usize] == si {
                node = ni
                ni = actual
            }
            ni = ni + 1
        }

        if node >= 0 {
            // Assign stream: check dependencies
            var next_stream: i64 = 0
            var dci: i64 = 0
            while dci < dep_count[node as usize] {
                let dep = deps[(node * 16 + dci) as usize]
                if stream_ids[dep as usize] == next_stream {
                    next_stream = next_stream + 1
                }
                dci = dci + 1
            }
            stream_ids[node as usize] = next_stream
            if next_stream >= stream_count {
                stream_count = next_stream + 1
            }
        }

        si = si + 1
    }

    // Phase 6: Emit stream assignment metadata
    combined = ptx_push_str(combined, "// SOUNIO_DAG stream_count=")
    combined = gpu_push_i64(combined, stream_count)
    combined = ptx_push_str(combined, "\n")

    var mi: i64 = 0
    while mi < actual {
        combined = ptx_push_str(combined, "// SOUNIO_STREAM kernel=")
        combined = gpu_push_i64(combined, mi)
        combined = ptx_push_str(combined, " stream=")
        combined = gpu_push_i64(combined, stream_ids[mi as usize])
        combined = ptx_push_str(combined, "\n")
        mi = mi + 1
    }

    var di2: i64 = 0
    while di2 < actual {
        var dci2: i64 = 0
        while dci2 < dep_count[di2 as usize] {
            combined = ptx_push_str(combined, "// SOUNIO_DEP from=")
            combined = gpu_push_i64(combined, deps[(di2 * 16 + dci2) as usize])
            combined = ptx_push_str(combined, " to=")
            combined = gpu_push_i64(combined, di2)
            combined = ptx_push_str(combined, "\n")
            dci2 = dci2 + 1
        }
        di2 = di2 + 1
    }

    // Phase 7: Lower each kernel in topological order to PTX
    var loi: i64 = 0
    var emitted_count: i64 = 0
    while loi < topo_count {
        // Find node at this topo position
        var node: i64 = -1
        var ni: i64 = 0
        while ni < actual {
            if topo_order[ni as usize] == loi {
                node = ni
                ni = actual
            }
            ni = ni + 1
        }

        if node >= 0 {
            let ptx = gpu_lower_to_ptx(kernels[node as usize])
            combined = hlir_ptx_append_kernel_module(combined, ptx, emitted_count == 0)
            emitted_count = emitted_count + 1
        }

        loi = loi + 1
    }

    combined
}

// ============================================================================
// Section 30 — Production Host Glue Emission (IREE-inspired metadata descriptor)
// ============================================================================
//
// Production-grade DAG + speculative host glue emitters that:
//   1. Parse SOUNIO_* metadata from the emitted PTX buffer
//   2. Generate functional Sounio host wrappers with real multi-stream dispatch
//
// Inspired by IREE's FlatBuffer kernel descriptor pattern (OSDI '25):
// compiler emits structured metadata, runtime acts as descriptor interpreter.
//
// Metadata protocol (embedded as PTX comments by the deep-wired novelty functions):
//   // SOUNIO_DAG stream_count=N
//   // SOUNIO_STREAM kernel=K stream=S
//   // SOUNIO_DEP from=A to=B
//   // SOUNIO_SPEC_PLAN coarse=C refinement=R threshold=T
//   // SOUNIO_SPEC_GUARD kernel=K

// ----------------------------------------------------------------------------
// PTX Metadata Parser — scans PtxBuf.data for SOUNIO_* comment lines
// ----------------------------------------------------------------------------

// Check if ptx.data[pos..pos+len] matches a given prefix string.
fn ptx_meta_match(ptx: PtxBuf, pos: i64, prefix: string, prefix_len: i64) -> bool {
    if pos + prefix_len > ptx.len { return false }
    var j: i64 = 0
    while j < prefix_len {
        let pc = ptx.data[(pos + j) as usize] as i64
        let tc = str_char_at(prefix, j) as i64
        if pc != tc { return false }
        j = j + 1
    }
    true
}

// Parse a decimal integer starting at ptx.data[pos]. Returns (value, chars_consumed).
fn ptx_meta_parse_int(ptx: PtxBuf, pos: i64) -> (i64, i64) {
    var num: i64 = 0
    var count: i64 = 0
    var p = pos
    while p < ptx.len && p < pos + 10 {
        let ch = ptx.data[p as usize] as i64
        if ch >= 48 && ch <= 57 {
            num = num * 10 + (ch - 48)
            count = count + 1
            p = p + 1
        } else {
            break
        }
    }
    (num, count)
}

// Scan PTX for "// SOUNIO_DAG stream_count=" and return stream count.
fn ptx_meta_dag_stream_count(ptx: PtxBuf) -> i64 {
    let prefix = "// SOUNIO_DAG stream_count="
    let prefix_len: i64 = 27
    var i: i64 = 0
    while i < ptx.len - prefix_len {
        if ptx_meta_match(ptx, i, prefix, prefix_len) {
            let result = ptx_meta_parse_int(ptx, i + prefix_len)
            return result.0
        }
        i = i + 1
    }
    0
}

// Scan PTX for all "// SOUNIO_STREAM kernel=K stream=S" entries.
// Populates stream_ids[kernel_idx] = stream_id. Returns number of entries found.
fn ptx_meta_stream_assignments(ptx: PtxBuf, stream_ids: &! [i64; 64]) -> i64 with Mut {
    let prefix = "// SOUNIO_STREAM kernel="
    let prefix_len: i64 = 24
    var found: i64 = 0
    var i: i64 = 0
    while i < ptx.len - prefix_len {
        if ptx_meta_match(ptx, i, prefix, prefix_len) {
            let k_result = ptx_meta_parse_int(ptx, i + prefix_len)
            let kernel_idx = k_result.0
            // Skip past "kernel=N stream="
            var scan_pos = i + prefix_len + k_result.1
            // Advance past " stream="
            let stream_prefix = " stream="
            let sp_len: i64 = 8
            if ptx_meta_match(ptx, scan_pos, stream_prefix, sp_len) {
                let s_result = ptx_meta_parse_int(ptx, scan_pos + sp_len)
                if kernel_idx >= 0 && kernel_idx < 64 {
                    stream_ids[kernel_idx as usize] = s_result.0
                    found = found + 1
                }
            }
        }
        i = i + 1
    }
    found
}

// Scan PTX for all "// SOUNIO_DEP from=A to=B" entries.
// Populates dep_from[i], dep_to[i]. Returns number of dependencies found.
fn ptx_meta_dependencies(ptx: PtxBuf, dep_from: &! [i64; 256], dep_to: &! [i64; 256]) -> i64 with Mut {
    let prefix = "// SOUNIO_DEP from="
    let prefix_len: i64 = 19
    var found: i64 = 0
    var i: i64 = 0
    while i < ptx.len - prefix_len {
        if ptx_meta_match(ptx, i, prefix, prefix_len) {
            let from_result = ptx_meta_parse_int(ptx, i + prefix_len)
            var scan_pos = i + prefix_len + from_result.1
            let to_prefix = " to="
            let tp_len: i64 = 4
            if ptx_meta_match(ptx, scan_pos, to_prefix, tp_len) {
                let to_result = ptx_meta_parse_int(ptx, scan_pos + tp_len)
                if found < 256 {
                    dep_from[found as usize] = from_result.0
                    dep_to[found as usize] = to_result.0
                    found = found + 1
                }
            }
        }
        i = i + 1
    }
    found
}

// Scan PTX for "// SOUNIO_SPEC_PLAN coarse=C refinement=R".
// Returns (coarse_count, refinement_count).
fn ptx_meta_spec_plan(ptx: PtxBuf) -> (i64, i64) {
    let prefix = "// SOUNIO_SPEC_PLAN coarse="
    let prefix_len: i64 = 27
    var i: i64 = 0
    while i < ptx.len - prefix_len {
        if ptx_meta_match(ptx, i, prefix, prefix_len) {
            let c_result = ptx_meta_parse_int(ptx, i + prefix_len)
            var scan_pos = i + prefix_len + c_result.1
            let ref_prefix = " refinement="
            let rp_len: i64 = 12
            if ptx_meta_match(ptx, scan_pos, ref_prefix, rp_len) {
                let r_result = ptx_meta_parse_int(ptx, scan_pos + rp_len)
                return (c_result.0, r_result.0)
            }
        }
        i = i + 1
    }
    (0, 0)
}

// Scan PTX for all "// SOUNIO_SPEC_GUARD kernel=K" entries.
// Populates guard_kernels[i] = kernel_idx. Returns count.
fn ptx_meta_spec_guards(ptx: PtxBuf, guard_kernels: &! [i64; 64]) -> i64 with Mut {
    let prefix = "// SOUNIO_SPEC_GUARD kernel="
    let prefix_len: i64 = 28
    var found: i64 = 0
    var i: i64 = 0
    while i < ptx.len - prefix_len {
        if ptx_meta_match(ptx, i, prefix, prefix_len) {
            let k_result = ptx_meta_parse_int(ptx, i + prefix_len)
            if found < 64 {
                guard_kernels[found as usize] = k_result.0
                found = found + 1
            }
        }
        i = i + 1
    }
    found
}

// ----------------------------------------------------------------------------
// Production DAG Host Glue Emitter
// ----------------------------------------------------------------------------

// Emit production DAG host glue file with multi-stream launch.
// Parses SOUNIO_DAG metadata from PTX, generates functional .sio code.
pub(crate) fn gpu_emit_dag_host_glue(ptx: PtxBuf, output_path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    let host_path = output_path ++ "_dag_host.sio"

    // Phase 1: Parse metadata from the PTX buffer
    let stream_count = ptx_meta_dag_stream_count(ptx)
    var stream_ids: [i64; 64] = [0; 64]
    let kernel_count = ptx_meta_stream_assignments(ptx, &! stream_ids)
    var dep_from: [i64; 256] = [0; 256]
    var dep_to: [i64; 256] = [0; 256]
    let dep_count = ptx_meta_dependencies(ptx, &! dep_from, &! dep_to)

    // Phase 2: Build the host glue source
    var glue = ptx_buf_new()
    glue = ptx_push_str(glue, "// Generated DAG-scheduled host glue — multi-stream kernel dispatch\n")
    glue = ptx_push_str(glue, "// Source: Sounio provenance-aware DAG scheduler\n")
    glue = ptx_push_str(glue, "// Pattern: IREE-inspired metadata descriptor (OSDI '25)\n")
    glue = ptx_push_str(glue, "// Parsed metadata: stream_count=")
    glue = gpu_push_i64(glue, stream_count)
    glue = ptx_push_str(glue, " kernels=")
    glue = gpu_push_i64(glue, kernel_count)
    glue = ptx_push_str(glue, " deps=")
    glue = gpu_push_i64(glue, dep_count)
    glue = ptx_push_str(glue, "\n\n")
    glue = ptx_push_str(glue, "use gpu::runtime::cuda::*\n")
    glue = ptx_push_str(glue, "use gpu::runtime::launch::{gpu_launch_ptx_map, GpuLaunchConfig, GpuLaunchResult}\n\n")

    // Phase 3: Emit gpu_dag_run function
    glue = ptx_push_str(glue, "fn gpu_dag_run(\n")
    glue = ptx_push_str(glue, "    ptx: PtxBuf,\n")
    glue = ptx_push_str(glue, "    n: i64,\n")
    glue = ptx_push_str(glue, "    buf_in: *const f32,\n")
    glue = ptx_push_str(glue, "    buf_out: *const f32\n")
    glue = ptx_push_str(glue, ") -> GpuLaunchResult with IO, Mut, Panic, Div, Alloc {\n")

    // Phase 4: Emit stream creation
    var si: i64 = 0
    while si < stream_count && si < 16 {
        glue = ptx_push_str(glue, "    let s")
        glue = gpu_push_i64(glue, si)
        glue = ptx_push_str(glue, " = cuda_stream_create_bare()\n")
        si = si + 1
    }
    glue = ptx_push_str(glue, "\n")

    // Phase 5: Emit kernel launches with stream assignments and dependency syncs
    var ki: i64 = 0
    while ki < kernel_count && ki < 64 {
        // Check if this kernel has incoming dependencies that need sync
        var di: i64 = 0
        while di < dep_count {
            if dep_to[di as usize] == ki {
                let from_kernel = dep_from[di as usize]
                let from_stream = stream_ids[from_kernel as usize]
                glue = ptx_push_str(glue, "    // DEP: kernel ")
                glue = gpu_push_i64(glue, from_kernel)
                glue = ptx_push_str(glue, " -> kernel ")
                glue = gpu_push_i64(glue, ki)
                glue = ptx_push_str(glue, "\n")
                glue = ptx_push_str(glue, "    cuda_stream_synchronize_bare(s")
                glue = gpu_push_i64(glue, from_stream)
                glue = ptx_push_str(glue, ")\n")
            }
            di = di + 1
        }

        // Emit launch for this kernel
        let stream_id = stream_ids[ki as usize]
        glue = ptx_push_str(glue, "    let cfg_")
        glue = gpu_push_i64(glue, ki)
        glue = ptx_push_str(glue, " = GpuLaunchConfig { block_dim: 256, shared_mem_bytes: 0, stream_handle: s")
        glue = gpu_push_i64(glue, stream_id)
        glue = ptx_push_str(glue, " }\n")
        glue = ptx_push_str(glue, "    let r_")
        glue = gpu_push_i64(glue, ki)
        glue = ptx_push_str(glue, " = gpu_launch_ptx_map(ptx, \"kernel_")
        glue = gpu_push_i64(glue, ki)
        glue = ptx_push_str(glue, "\", n, buf_in, buf_out, cfg_")
        glue = gpu_push_i64(glue, ki)
        glue = ptx_push_str(glue, ")\n\n")

        ki = ki + 1
    }

    // Phase 6: Emit stream synchronization + cleanup
    si = 0
    while si < stream_count && si < 16 {
        glue = ptx_push_str(glue, "    cuda_stream_synchronize_bare(s")
        glue = gpu_push_i64(glue, si)
        glue = ptx_push_str(glue, ")\n")
        si = si + 1
    }
    si = 0
    while si < stream_count && si < 16 {
        glue = ptx_push_str(glue, "    cuda_stream_destroy_bare(s")
        glue = gpu_push_i64(glue, si)
        glue = ptx_push_str(glue, ")\n")
        si = si + 1
    }
    glue = ptx_push_str(glue, "\n    gpu_launch_result_ok(0.0)\n")
    glue = ptx_push_str(glue, "}\n")

    let ok = io_write_bytes_to_file(host_path, glue.data, glue.len)
    ok
}

// ----------------------------------------------------------------------------
// Production Speculative Host Glue Emitter
// ----------------------------------------------------------------------------

// Emit production speculative host glue file with epsilon-threshold skip guards.
// Parses SOUNIO_SPEC metadata from PTX, generates conditional launch code.
pub(crate) fn gpu_emit_spec_host_glue(ptx: PtxBuf, output_path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    let host_path = output_path ++ "_spec_host.sio"

    // Phase 1: Parse metadata
    let plan = ptx_meta_spec_plan(ptx)
    let coarse_count = plan.0
    let refinement_count = plan.1
    var guard_kernels: [i64; 64] = [0; 64]
    let guard_count = ptx_meta_spec_guards(ptx, &! guard_kernels)

    // Phase 2: Build the host glue source
    var glue = ptx_buf_new()
    glue = ptx_push_str(glue, "// Generated speculative host glue — uncertainty-threshold skip guards\n")
    glue = ptx_push_str(glue, "// Source: Sounio speculative epistemic execution engine\n")
    glue = ptx_push_str(glue, "// Parsed metadata: coarse=")
    glue = gpu_push_i64(glue, coarse_count)
    glue = ptx_push_str(glue, " refinement=")
    glue = gpu_push_i64(glue, refinement_count)
    glue = ptx_push_str(glue, " guards=")
    glue = gpu_push_i64(glue, guard_count)
    glue = ptx_push_str(glue, "\n\n")
    glue = ptx_push_str(glue, "use gpu::runtime::cuda::*\n")
    glue = ptx_push_str(glue, "use gpu::runtime::launch::{gpu_launch_ptx_map, GpuLaunchConfig, GpuLaunchResult}\n\n")

    // Phase 3: Emit gpu_spec_run function
    glue = ptx_push_str(glue, "fn gpu_spec_run(\n")
    glue = ptx_push_str(glue, "    ptx: PtxBuf,\n")
    glue = ptx_push_str(glue, "    n: i64,\n")
    glue = ptx_push_str(glue, "    epsilon: f64,\n")
    glue = ptx_push_str(glue, "    buf_in: *const f32,\n")
    glue = ptx_push_str(glue, "    buf_out: *const f32\n")
    glue = ptx_push_str(glue, ") -> GpuLaunchResult with IO, Mut, Panic, Div, Alloc {\n")
    glue = ptx_push_str(glue, "    let cfg = GpuLaunchConfig { block_dim: 256, shared_mem_bytes: 0, stream_handle: 0 }\n\n")

    // Phase 4: Emit coarse kernel launches (unconditional)
    let total_kernels = coarse_count + refinement_count
    var ki: i64 = 0
    while ki < total_kernels && ki < 64 {
        // Check if this kernel is a guarded refinement kernel
        var is_guarded = false
        var gi: i64 = 0
        while gi < guard_count {
            if guard_kernels[gi as usize] == ki {
                is_guarded = true
            }
            gi = gi + 1
        }

        if is_guarded {
            // Refinement kernel: conditional on epsilon
            glue = ptx_push_str(glue, "    // Refinement kernel ")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, " — guarded by epsilon threshold\n")
            glue = ptx_push_str(glue, "    if epsilon > 1.0e-6 {\n")
            glue = ptx_push_str(glue, "        let r_")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, " = gpu_launch_ptx_map(ptx, \"kernel_")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, "\", n, buf_in, buf_out, cfg)\n")
            glue = ptx_push_str(glue, "    }\n\n")
        } else {
            // Coarse kernel: always execute
            glue = ptx_push_str(glue, "    // Coarse kernel ")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, " — unconditional\n")
            glue = ptx_push_str(glue, "    let r_")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, " = gpu_launch_ptx_map(ptx, \"kernel_")
            glue = gpu_push_i64(glue, ki)
            glue = ptx_push_str(glue, "\", n, buf_in, buf_out, cfg)\n\n")
        }

        ki = ki + 1
    }

    glue = ptx_push_str(glue, "    gpu_launch_result_ok(0.0)\n")
    glue = ptx_push_str(glue, "}\n")

    let ok = io_write_bytes_to_file(host_path, glue.data, glue.len)
    ok
}

// ============================================================================
// Section 31 — Source-level GPU builtin lowering
// ============================================================================
//
// Maps source-level GPU builtin tags to GpuOp emissions in a GpuKernelIr.
// This is the bridge used when lowering `kernel fn` bodies that reference
// GPU intrinsics by name.
//
// Design:
//   - Takes GpuKernelIr by value and returns modified copy (same as all builders).
//   - Uses gpu_op_new() + field assignment pattern (same as hlir_instr_to_gpu_ops).
//   - Builtin tag constants defined below (HLIR_GPU_BUILTIN_*).
//
// Supported builtin tags:
//   HLIR_GPU_BUILTIN_TID_X       → GpuGetTid  axis=0  (gpu.thread_id.x)
//   HLIR_GPU_BUILTIN_TID_Y       → GpuGetTid  axis=1  (gpu.thread_id.y)
//   HLIR_GPU_BUILTIN_TID_Z       → GpuGetTid  axis=2  (gpu.thread_id.z)
//   HLIR_GPU_BUILTIN_BID_X       → GpuGetBid  axis=0  (gpu.block_id.x)
//   HLIR_GPU_BUILTIN_BID_Y       → GpuGetBid  axis=1  (gpu.block_id.y)
//   HLIR_GPU_BUILTIN_BID_Z       → GpuGetBid  axis=2  (gpu.block_id.z)
//   HLIR_GPU_BUILTIN_BDIM_X      → GpuGetNtid axis=0  (gpu.block_dim.x)
//   HLIR_GPU_BUILTIN_SYNC_THREADS→ GpuBarrierSync      (gpu.sync_threads)

// Builtin tag constants for hlir_lower_gpu_builtins.
let HLIR_GPU_BUILTIN_TID_X: i64 = 0
let HLIR_GPU_BUILTIN_TID_Y: i64 = 1
let HLIR_GPU_BUILTIN_TID_Z: i64 = 2
let HLIR_GPU_BUILTIN_BID_X: i64 = 3
let HLIR_GPU_BUILTIN_BID_Y: i64 = 4
let HLIR_GPU_BUILTIN_BID_Z: i64 = 5
let HLIR_GPU_BUILTIN_BDIM_X: i64 = 6
let HLIR_GPU_BUILTIN_SYNC_THREADS: i64 = 7

// Lower a source-level GPU builtin to a GpuOp and append it to the kernel.
//
// Parameters:
//   kernel      — GpuKernelIr being built (by value)
//   builtin_tag — one of HLIR_GPU_BUILTIN_* constants above
//   dst_reg     — destination virtual register for the result (-1 for void ops)
//
// Returns the kernel with one GpuOp appended (or unchanged if tag unknown).
fn hlir_lower_gpu_builtins(kernel: GpuKernelIr, builtin_tag: i64, dst_reg: i64) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    if builtin_tag == HLIR_GPU_BUILTIN_TID_X {
        // gpu.thread_id.x → GpuGetTid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_TID_Y {
        // gpu.thread_id.y → GpuGetTid axis=1
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_TID_Z {
        // gpu.thread_id.z → GpuGetTid axis=2
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 2
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_X {
        // gpu.block_id.x → GpuGetBid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_Y {
        // gpu.block_id.y → GpuGetBid axis=1
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_Z {
        // gpu.block_id.z → GpuGetBid axis=2
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 2
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BDIM_X {
        // gpu.block_dim.x → GpuGetNtid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetNtid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_SYNC_THREADS {
        // gpu.sync_threads → GpuBarrierSync
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuBarrierSync
        op.dst_reg = -1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    }
    k
}

// Emit the standard 1D kernel prologue into a GpuKernelIr.
//
// For a 1D kernel launch the standard index computation is:
//   tid        = threadIdx.x          (GpuGetTid  axis=0)
//   bid        = blockIdx.x           (GpuGetBid  axis=0)
//   bdim       = blockDim.x           (GpuGetNtid axis=0)
//   global_idx = bid * bdim + tid     (GpuMul + GpuAdd)
//
// Virtual register layout (offset from num_params):
//   num_params + 0 → tid
//   num_params + 1 → bid
//   num_params + 2 → bdim
//   num_params + 3 → bid * bdim  (scratch)
//   num_params + 4 → global_idx  (result)
//
// Returns the kernel with prologue ops appended.
fn hlir_emit_kernel_prologue(kernel: GpuKernelIr, num_params: i64) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let r_tid: i64 = num_params + 0
    let r_bid: i64 = num_params + 1
    let r_bdim: i64 = num_params + 2
    let r_mul: i64 = num_params + 3
    let r_gidx: i64 = num_params + 4

    // tid = threadIdx.x
    var op_tid = gpu_op_new()
    op_tid.opcode = GpuOpcode::GpuGetTid
    op_tid.dst_reg = r_tid
    op_tid.axis = 0
    op_tid.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_tid)

    // bid = blockIdx.x
    var op_bid = gpu_op_new()
    op_bid.opcode = GpuOpcode::GpuGetBid
    op_bid.dst_reg = r_bid
    op_bid.axis = 0
    op_bid.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_bid)

    // bdim = blockDim.x
    var op_bdim = gpu_op_new()
    op_bdim.opcode = GpuOpcode::GpuGetNtid
    op_bdim.dst_reg = r_bdim
    op_bdim.axis = 0
    op_bdim.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_bdim)

    // r_mul = bid * bdim
    var op_mul = gpu_op_new()
    op_mul.opcode = GpuOpcode::GpuMul
    op_mul.dst_reg = r_mul
    op_mul.lhs_reg = r_bid
    op_mul.rhs_reg = r_bdim
    op_mul.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_mul)

    // global_idx = r_mul + tid
    var op_add = gpu_op_new()
    op_add.opcode = GpuOpcode::GpuAdd
    op_add.dst_reg = r_gidx
    op_add.lhs_reg = r_mul
    op_add.rhs_reg = r_tid
    op_add.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_add)

    k
}
