// self-hosted::gpu::hlir_to_gpu — HLIR-to-GPU IR lowering pass
//
// Translates HLIR (SSA-form IR used by the main compiler) down to GpuKernelIr
// opcodes used for PTX/Metal/SPIR-V codegen.  This is the bridge between the
// typed IR and the GPU backend.
//
// Design principles:
// - All data structures are fixed-capacity (no heap allocation).
// - Helpers always precede their callers (no forward references).
// - State threading via struct return — no global mutation.
// - Epistemic Knowledge<T> values get four shadow registers each.
// - Counterfactual mode replicates lanes across the warp.

// ============================================================================
// Section 1 — HlirTypeTag constants
// ============================================================================

let HLIR_TY_I32: i64 = 0
let HLIR_TY_I64: i64 = 1
let HLIR_TY_F32: i64 = 2
let HLIR_TY_F64: i64 = 3
let HLIR_TY_PTR: i64 = 4
let HLIR_TY_BOOL: i64 = 5
let HLIR_TY_I8: i64 = 6
let HLIR_TY_I16: i64 = 7
let HLIR_TY_U32: i64 = 8
let HLIR_TY_U64: i64 = 9
let HLIR_TY_F16: i64 = 10
let HLIR_TY_KNOWLEDGE: i64 = 11
let HLIR_TY_VEC2: i64 = 12
let HLIR_TY_VEC3: i64 = 13
let HLIR_TY_VEC4: i64 = 14
let HLIR_TY_MAT2: i64 = 15
let HLIR_TY_MAT3: i64 = 16
let HLIR_TY_MAT4: i64 = 17
let HLIR_TY_QUAT: i64 = 18
let HLIR_TY_OCTONION: i64 = 19
let HLIR_TY_SEDENION: i64 = 20
let HLIR_TY_I128: i64 = 21
let HLIR_TY_U128: i64 = 22

// ============================================================================
// Section 2 — HlirOpTag constants
// ============================================================================

let HlirOpConst: i64 = 0
let HlirOpAdd: i64 = 1
let HlirOpSub: i64 = 2
let HlirOpMul: i64 = 3
let HlirOpDiv: i64 = 4
let HlirOpRem: i64 = 5
let HlirOpNeg: i64 = 6
let HlirOpFAdd: i64 = 7
let HlirOpFSub: i64 = 8
let HlirOpFMul: i64 = 9
let HlirOpFDiv: i64 = 10
let HlirOpFNeg: i64 = 11
let HlirOpAnd: i64 = 12
let HlirOpOr: i64 = 13
let HlirOpXor: i64 = 14
let HlirOpShl: i64 = 15
let HlirOpShr: i64 = 16
let HlirOpEq: i64 = 17
let HlirOpNe: i64 = 18
let HlirOpLt: i64 = 19
let HlirOpLe: i64 = 20
let HlirOpGt: i64 = 21
let HlirOpGe: i64 = 22
let HlirOpFEq: i64 = 23
let HlirOpFNe: i64 = 24
let HlirOpFLt: i64 = 25
let HlirOpFLe: i64 = 26
let HlirOpFGt: i64 = 27
let HlirOpFGe: i64 = 28
let HlirOpLoad: i64 = 29
let HlirOpStore: i64 = 30
let HlirOpAlloca: i64 = 31
let HlirOpGEP: i64 = 32
let HlirOpCall: i64 = 33
let HlirOpPhi: i64 = 34
let HlirOpSExt: i64 = 35
let HlirOpZExt: i64 = 36
let HlirOpTrunc: i64 = 37
let HlirOpFpExt: i64 = 38
let HlirOpFpTrunc: i64 = 39
let HlirOpBitcast: i64 = 40
let HlirOpSIToFP: i64 = 41
let HlirOpFPToSI: i64 = 42
let HlirOpSelect: i64 = 43
let HlirOpFMA: i64 = 44
let HlirOpGetThreadId: i64 = 45
let HlirOpGetBlockId: i64 = 46
let HlirOpGetBlockDim: i64 = 47
let HlirOpGetGridDim: i64 = 48
let HlirOpAtomicAdd: i64 = 49
let HlirOpAtomicSub: i64 = 50
let HlirOpAtomicMin: i64 = 51
let HlirOpAtomicMax: i64 = 52
let HlirOpSyncThreads: i64 = 53
let HlirOpSyncWarp: i64 = 54

// ============================================================================
// Section 3 — HlirTermTag constants
// ============================================================================

let HlirTermRet: i64 = 0
let HlirTermRetVoid: i64 = 1
let HlirTermBr: i64 = 2
let HlirTermCondBr: i64 = 3
let HlirTermSwitch: i64 = 4
let HlirTermUnreachable: i64 = 5

// ============================================================================
// Section 4 — GpuTypeTag constants
// ============================================================================

let GpuTypeU32: i64 = 0
let GpuTypeU64: i64 = 1
let GpuTypeF32: i64 = 2
let GpuTypeF64: i64 = 3
let GpuTypeI32: i64 = 4
let GpuTypeI64: i64 = 5
let GpuTypePtr: i64 = 6
let GpuTypeF16: i64 = 7
let GpuTypeBF16: i64 = 8
let GpuTypeBool: i64 = 9
let GpuTypeI8: i64 = 10

// ============================================================================
// Section 5 — GpuOpcodeTag constants
// ============================================================================

let GpuOpcodeGetTid: i64 = 0
let GpuOpcodeConst: i64 = 1
let GpuOpcodeCvt: i64 = 2
let GpuOpcodeMulImm: i64 = 3
let GpuOpcodeAdd: i64 = 4
let GpuOpcodeSub: i64 = 5
let GpuOpcodeMul: i64 = 6
let GpuOpcodeDiv: i64 = 7
let GpuOpcodeMax: i64 = 8
let GpuOpcodeMin: i64 = 9
let GpuOpcodeAnd: i64 = 10
let GpuOpcodeOr: i64 = 11
let GpuOpcodeXor: i64 = 12
let GpuOpcodeShl: i64 = 13
let GpuOpcodeLoadGlobal: i64 = 14
let GpuOpcodeStoreGlobal: i64 = 15
let GpuOpcodeRet: i64 = 16
let GpuOpcodeFma: i64 = 17
let GpuOpcodeGetBid: i64 = 18
let GpuOpcodeGetNtid: i64 = 19
let GpuOpcodeAddImm: i64 = 20
let GpuOpcodeBarrierSync: i64 = 21
let GpuOpcodeSetpLt: i64 = 22
let GpuOpcodeSetpLe: i64 = 23
let GpuOpcodeSetpEq: i64 = 24
let GpuOpcodeSetpGe: i64 = 25
let GpuOpcodeSelp: i64 = 26
let GpuOpcodeAtomicAdd: i64 = 27
let GpuOpcodeAtomicSub: i64 = 28
let GpuOpcodeAtomicMin: i64 = 29
let GpuOpcodeAtomicMax: i64 = 30
let GpuOpcodeSqrt: i64 = 31
let GpuOpcodeAbs: i64 = 32
let GpuOpcodeNeg: i64 = 33
let GpuOpcodeSetpGt: i64 = 34
let GpuOpcodeSetpNe: i64 = 35
let GpuOpcodeLoadParam: i64 = 36
let GpuOpcodeShr: i64 = 37

// ============================================================================
// Section 6 — GpuOpEntry
// ============================================================================

struct GpuOpEntry {
    opcode: i64,
    type_tag: i64,
    dst_idx: i64,
    src0: i64,
    src1: i64,
    src2: i64,
    imm_int: i64,
    imm_f32: f32,
    pred: i64,
    axis: i64,
}

fn gpu_op_entry_default() -> GpuOpEntry {
    GpuOpEntry {
        opcode: 0,
        type_tag: 0,
        dst_idx: -1,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: 0,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

// ============================================================================
// Section 7 — GpuBlockEntry
// ============================================================================

struct GpuBlockEntry {
    id: i64,
    ops: [GpuOpEntry; 4096],
    op_count: i64,
    term_tag: i64,
    term_src: i64,
    term_target0: i64,
    term_target1: i64,
}

fn gpu_block_entry_default() -> GpuBlockEntry {
    GpuBlockEntry {
        id: -1,
        ops: [gpu_op_entry_default(); 4096],
        op_count: 0,
        term_tag: HlirTermRetVoid,
        term_src: -1,
        term_target0: -1,
        term_target1: -1,
    }
}

// ============================================================================
// Section 8 — GpuParamEntry
// ============================================================================

struct GpuParamEntry {
    name: [i8; 64],
    name_len: i64,
    type_tag: i64,
    is_restrict: bool,
}

fn gpu_param_entry_default() -> GpuParamEntry {
    GpuParamEntry {
        name: [0; 64],
        name_len: 0,
        type_tag: GpuTypeU64,
        is_restrict: false,
    }
}

// ============================================================================
// Section 9 — GpuKernelEntry
// ============================================================================

struct GpuKernelEntry {
    name: [i8; 256],
    name_len: i64,
    is_kernel: bool,
    params: [GpuParamEntry; 32],
    param_count: i64,
    blocks: [GpuBlockEntry; 256],
    block_count: i64,
}

fn gpu_kernel_entry_default() -> GpuKernelEntry {
    GpuKernelEntry {
        name: [0; 256],
        name_len: 0,
        is_kernel: true,
        params: [gpu_param_entry_default(); 32],
        param_count: 0,
        blocks: [gpu_block_entry_default(); 256],
        block_count: 0,
    }
}

// ============================================================================
// Section 10 — GpuModuleOutput
// ============================================================================

struct GpuModuleOutput {
    kernels: [GpuKernelEntry; 64],
    kernel_count: i64,
    device_fns: [GpuKernelEntry; 64],
    device_fn_count: i64,
}

// ============================================================================
// Section 11 — EpistemicShadowEntry
// ============================================================================

struct EpistemicShadowEntry {
    hlir_value: i64,
    gpu_value: i64,
    eps_value: i64,
    valid_value: i64,
    prov_value: i64,
}

fn epistemic_shadow_entry_default() -> EpistemicShadowEntry {
    EpistemicShadowEntry {
        hlir_value: -1,
        gpu_value: -1,
        eps_value: -1,
        valid_value: -1,
        prov_value: -1,
    }
}

// ============================================================================
// Section 12 — ValueMapEntry
// ============================================================================

struct ValueMapEntry {
    hlir_id: i64,
    gpu_id: i64,
    type_tag: i64,
}

fn value_map_entry_default() -> ValueMapEntry {
    ValueMapEntry {
        hlir_id: -1,
        gpu_id: -1,
        type_tag: GpuTypeI32,
    }
}

// ============================================================================
// Section 13 — HlirToGpuState
// ============================================================================

struct HlirToGpuState {
    next_value_id: i64,
    next_block_id: i64,
    value_map: [ValueMapEntry; 8192],
    value_map_count: i64,
    block_map_src: [i64; 2048],
    block_map_dst: [i64; 2048],
    block_map_count: i64,
    epistemic_shadows: [EpistemicShadowEntry; 8192],
    shadow_count: i64,
    epistemic_enabled: bool,
    counterfactual_enabled: bool,
    target_sm: i64,
    fast_math: bool,
}

// ============================================================================
// Section 14 — Top-level constructors
// ============================================================================

fn hlir_to_gpu_state_new(epistemic: bool, counterfactual: bool, sm_version: i64, fast_math: bool) -> HlirToGpuState {
    HlirToGpuState {
        next_value_id: 0,
        next_block_id: 0,
        value_map: [value_map_entry_default(); 8192],
        value_map_count: 0,
        block_map_src: [-1; 2048],
        block_map_dst: [-1; 2048],
        block_map_count: 0,
        epistemic_shadows: [epistemic_shadow_entry_default(); 8192],
        shadow_count: 0,
        epistemic_enabled: epistemic,
        counterfactual_enabled: counterfactual,
        target_sm: sm_version,
        fast_math: fast_math,
    }
}

fn hlir_to_gpu_module_new() -> GpuModuleOutput {
    GpuModuleOutput {
        kernels: [gpu_kernel_entry_default(); 64],
        kernel_count: 0,
        device_fns: [gpu_kernel_entry_default(); 64],
        device_fn_count: 0,
    }
}

// ============================================================================
// Section 15 — Value/block allocation
// ============================================================================

fn hlir_gpu_alloc_value(s: HlirToGpuState) -> (HlirToGpuState, i64) with Mut {
    var out = s
    let id = out.next_value_id
    out.next_value_id = id + 1
    (out, id)
}

fn hlir_gpu_alloc_block(s: HlirToGpuState) -> (HlirToGpuState, i64) with Mut {
    var out = s
    let id = out.next_block_id
    out.next_block_id = id + 1
    (out, id)
}

fn hlir_gpu_map_value(s: HlirToGpuState, hlir_id: i64, type_tag: i64) -> (HlirToGpuState, i64) with Mut, Panic {
    var out = s
    let result = hlir_gpu_alloc_value(out)
    out = result.0
    let gpu_id = result.1
    if out.value_map_count < 8192 {
        let idx = out.value_map_count as usize
        out.value_map[idx] = ValueMapEntry { hlir_id: hlir_id, gpu_id: gpu_id, type_tag: type_tag }
        out.value_map_count = out.value_map_count + 1
    }
    (out, gpu_id)
}

fn hlir_gpu_lookup_value(s: HlirToGpuState, hlir_id: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.value_map_count {
        if s.value_map[i as usize].hlir_id == hlir_id {
            found = s.value_map[i as usize].gpu_id
        }
        i = i + 1
    }
    found
}

fn hlir_gpu_map_block(s: HlirToGpuState, hlir_block_id: i64) -> (HlirToGpuState, i64) with Mut, Panic {
    var out = s
    let result = hlir_gpu_alloc_block(out)
    out = result.0
    let gpu_id = result.1
    if out.block_map_count < 2048 {
        let idx = out.block_map_count as usize
        out.block_map_src[idx] = hlir_block_id
        out.block_map_dst[idx] = gpu_id
        out.block_map_count = out.block_map_count + 1
    }
    (out, gpu_id)
}

fn hlir_gpu_lookup_block(s: HlirToGpuState, hlir_block_id: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.block_map_count {
        if s.block_map_src[i as usize] == hlir_block_id {
            found = s.block_map_dst[i as usize]
        }
        i = i + 1
    }
    found
}

// ============================================================================
// Section 16 — Type lowering
// ============================================================================

fn hlir_lower_type(type_tag: i64) -> i64 {
    if type_tag == HLIR_TY_I32 { return GpuTypeI32 }
    if type_tag == HLIR_TY_I64 { return GpuTypeI64 }
    if type_tag == HLIR_TY_F32 { return GpuTypeF32 }
    if type_tag == HLIR_TY_F64 { return GpuTypeF64 }
    if type_tag == HLIR_TY_PTR { return GpuTypePtr }
    if type_tag == HLIR_TY_BOOL { return GpuTypeBool }
    if type_tag == HLIR_TY_I8 { return GpuTypeI8 }
    if type_tag == HLIR_TY_I16 { return GpuTypeI32 }
    if type_tag == HLIR_TY_U32 { return GpuTypeU32 }
    if type_tag == HLIR_TY_U64 { return GpuTypeU64 }
    if type_tag == HLIR_TY_F16 { return GpuTypeF16 }
    // Knowledge<T>: strip wrapper, default to f32
    if type_tag == HLIR_TY_KNOWLEDGE { return GpuTypeF32 }
    // Aggregate types: represented as pointers to their storage
    if type_tag == HLIR_TY_VEC2 { return GpuTypePtr }
    if type_tag == HLIR_TY_VEC3 { return GpuTypePtr }
    if type_tag == HLIR_TY_VEC4 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT2 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT3 { return GpuTypePtr }
    if type_tag == HLIR_TY_MAT4 { return GpuTypePtr }
    if type_tag == HLIR_TY_QUAT { return GpuTypePtr }
    if type_tag == HLIR_TY_OCTONION { return GpuTypePtr }
    if type_tag == HLIR_TY_SEDENION { return GpuTypePtr }
    // 128-bit integers downgraded — GPUs lack native 128-bit
    if type_tag == HLIR_TY_I128 { return GpuTypeI64 }
    if type_tag == HLIR_TY_U128 { return GpuTypeU64 }
    // Default fallback
    GpuTypeI32
}

// ============================================================================
// Section 17 — GpuOpEntry builders
// ============================================================================

fn gpu_op_make(opcode: i64, type_tag: i64, dst: i64, s0: i64, s1: i64, s2: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: s0,
        src1: s1,
        src2: s2,
        imm_int: 0,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_imm_i(opcode: i64, type_tag: i64, dst: i64, imm: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: imm,
        imm_f32: 0.0 as f32,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_imm_f(opcode: i64, type_tag: i64, dst: i64, f: f32) -> GpuOpEntry {
    GpuOpEntry {
        opcode: opcode,
        type_tag: type_tag,
        dst_idx: dst,
        src0: -1,
        src1: -1,
        src2: -1,
        imm_int: 0,
        imm_f32: f,
        pred: -1,
        axis: 0,
    }
}

fn gpu_op_pred(op: GpuOpEntry, pred: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: op.opcode,
        type_tag: op.type_tag,
        dst_idx: op.dst_idx,
        src0: op.src0,
        src1: op.src1,
        src2: op.src2,
        imm_int: op.imm_int,
        imm_f32: op.imm_f32,
        pred: pred,
        axis: op.axis,
    }
}

fn gpu_op_axis(op: GpuOpEntry, axis: i64) -> GpuOpEntry {
    GpuOpEntry {
        opcode: op.opcode,
        type_tag: op.type_tag,
        dst_idx: op.dst_idx,
        src0: op.src0,
        src1: op.src1,
        src2: op.src2,
        imm_int: op.imm_int,
        imm_f32: op.imm_f32,
        pred: op.pred,
        axis: axis,
    }
}

// ============================================================================
// Section 18 — Block helpers
// ============================================================================

fn gpu_block_add_op(blk: GpuBlockEntry, op: GpuOpEntry) -> GpuBlockEntry with Mut, Panic {
    var out = blk
    if out.op_count < 4096 {
        out.ops[out.op_count as usize] = op
        out.op_count = out.op_count + 1
    }
    out
}

fn gpu_block_set_term_ret(blk: GpuBlockEntry, src: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermRet,
        term_src: src,
        term_target0: -1,
        term_target1: -1,
    }
}

fn gpu_block_set_term_ret_void(blk: GpuBlockEntry) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermRetVoid,
        term_src: -1,
        term_target0: -1,
        term_target1: -1,
    }
}

fn gpu_block_set_term_br(blk: GpuBlockEntry, target: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermBr,
        term_src: -1,
        term_target0: target,
        term_target1: -1,
    }
}

fn gpu_block_set_term_condbr(blk: GpuBlockEntry, cond: i64, then_b: i64, else_b: i64) -> GpuBlockEntry {
    GpuBlockEntry {
        id: blk.id,
        ops: blk.ops,
        op_count: blk.op_count,
        term_tag: HlirTermCondBr,
        term_src: cond,
        term_target0: then_b,
        term_target1: else_b,
    }
}

// ============================================================================
// Section 19 — Epistemic shadow management
// ============================================================================

fn hlir_gpu_find_shadow(s: HlirToGpuState, gpu_val: i64) -> i64 {
    var i: i64 = 0
    var found: i64 = -1
    while i < s.shadow_count {
        if s.epistemic_shadows[i as usize].gpu_value == gpu_val {
            found = i
        }
        i = i + 1
    }
    found
}

fn hlir_gpu_create_shadow(s: HlirToGpuState, blk: GpuBlockEntry, main_val: i64, hlir_id: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    // Allocate eps register (f32, init 0.0)
    let eps_result = hlir_gpu_alloc_value(st)
    st = eps_result.0
    let eps_val = eps_result.1

    // Allocate valid register (bool, init true via imm 1)
    let valid_result = hlir_gpu_alloc_value(st)
    st = valid_result.0
    let valid_val = valid_result.1

    // Allocate prov register (i64, init 0)
    let prov_result = hlir_gpu_alloc_value(st)
    st = prov_result.0
    let prov_val = prov_result.1

    // Emit epsilon initialiser: eps = 0.0f
    let eps_init = gpu_op_imm_f(GpuOpcodeConst, GpuTypeF32, eps_val, 0.0 as f32)
    b = gpu_block_add_op(b, eps_init)

    // Emit valid initialiser: valid = 1 (true)
    let valid_init = gpu_op_imm_i(GpuOpcodeConst, GpuTypeBool, valid_val, 1)
    b = gpu_block_add_op(b, valid_init)

    // Emit prov initialiser: prov = 0
    let prov_init = gpu_op_imm_i(GpuOpcodeConst, GpuTypeI64, prov_val, 0)
    b = gpu_block_add_op(b, prov_init)

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: hlir_id,
            gpu_value: main_val,
            eps_value: eps_val,
            valid_value: valid_val,
            prov_value: prov_val,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit quadrature uncertainty propagation for add/sub: eps_c = sqrt(eps_a^2 + eps_b^2)
fn hlir_gpu_emit_shadow_add(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs: i64, rhs: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs)

    // Get shadow register IDs (fallback to -1 treated as 0 uncertainty)
    var eps_l: i64 = -1
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = -1
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let sq_l_r = hlir_gpu_alloc_value(st)
    st = sq_l_r.0
    let sq_l = sq_l_r.1

    let sq_r_r = hlir_gpu_alloc_value(st)
    st = sq_r_r.0
    let sq_r = sq_r_r.1

    let sum_r = hlir_gpu_alloc_value(st)
    st = sum_r.0
    let sum = sum_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // sq_l = eps_l * eps_l
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_l, eps_l, eps_l, -1))
    // sq_r = eps_r * eps_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_r, eps_r, eps_r, -1))
    // sum = sq_l + sq_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, sum, sq_l, sq_r, -1))
    // eps_res = sqrt(sum)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSqrt, GpuTypeF32, eps_res, sum, -1, -1))
    // valid_res = valid_l AND valid_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    // prov_res = prov_l XOR prov_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record new shadow for result
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit first-order uncertainty propagation for mul: eps_c = |lhs|*eps_rhs + |rhs|*eps_lhs
fn hlir_gpu_emit_shadow_mul(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs_val: i64, rhs_val: i64, lhs_eps_v: i64, rhs_eps_v: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs_val)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs_val)

    var eps_l: i64 = lhs_eps_v
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = rhs_eps_v
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let abs_lhs_r = hlir_gpu_alloc_value(st)
    st = abs_lhs_r.0
    let abs_lhs = abs_lhs_r.1

    let abs_rhs_r = hlir_gpu_alloc_value(st)
    st = abs_rhs_r.0
    let abs_rhs = abs_rhs_r.1

    let term1_r = hlir_gpu_alloc_value(st)
    st = term1_r.0
    let term1 = term1_r.1

    let term2_r = hlir_gpu_alloc_value(st)
    st = term2_r.0
    let term2 = term2_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // abs_lhs = |lhs_val|
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_lhs, lhs_val, -1, -1))
    // abs_rhs = |rhs_val|
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_rhs, rhs_val, -1, -1))
    // term1 = abs_lhs * eps_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term1, abs_lhs, eps_r, -1))
    // term2 = abs_rhs * eps_l
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term2, abs_rhs, eps_l, -1))
    // eps_res = term1 + term2
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, eps_res, term1, term2, -1))
    // valid_res = valid_l AND valid_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    // prov_res = prov_l XOR prov_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit uncertainty propagation for div: eps_c = (|lhs|*eps_rhs + |rhs|*eps_lhs) / rhs^2
// Includes near-zero denominator guard via validity predicate
fn hlir_gpu_emit_shadow_div(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, lhs_val: i64, rhs_val: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let lhs_idx = hlir_gpu_find_shadow(st, lhs_val)
    let rhs_idx = hlir_gpu_find_shadow(st, rhs_val)

    var eps_l: i64 = -1
    var valid_l: i64 = -1
    var prov_l: i64 = -1
    var eps_r: i64 = -1
    var valid_r: i64 = -1
    var prov_r: i64 = -1

    if lhs_idx >= 0 {
        eps_l = st.epistemic_shadows[lhs_idx as usize].eps_value
        valid_l = st.epistemic_shadows[lhs_idx as usize].valid_value
        prov_l = st.epistemic_shadows[lhs_idx as usize].prov_value
    }
    if rhs_idx >= 0 {
        eps_r = st.epistemic_shadows[rhs_idx as usize].eps_value
        valid_r = st.epistemic_shadows[rhs_idx as usize].valid_value
        prov_r = st.epistemic_shadows[rhs_idx as usize].prov_value
    }

    // Alloc temporaries
    let abs_lhs_r = hlir_gpu_alloc_value(st)
    st = abs_lhs_r.0
    let abs_lhs = abs_lhs_r.1

    let abs_rhs_r = hlir_gpu_alloc_value(st)
    st = abs_rhs_r.0
    let abs_rhs = abs_rhs_r.1

    let term1_r = hlir_gpu_alloc_value(st)
    st = term1_r.0
    let term1 = term1_r.1

    let term2_r = hlir_gpu_alloc_value(st)
    st = term2_r.0
    let term2 = term2_r.1

    let numer_r = hlir_gpu_alloc_value(st)
    st = numer_r.0
    let numer = numer_r.1

    let rhs_sq_r = hlir_gpu_alloc_value(st)
    st = rhs_sq_r.0
    let rhs_sq = rhs_sq_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    // Near-zero guard predicate
    let near_zero_thresh_r = hlir_gpu_alloc_value(st)
    st = near_zero_thresh_r.0
    let near_zero_thresh = near_zero_thresh_r.1

    let denom_safe_r = hlir_gpu_alloc_value(st)
    st = denom_safe_r.0
    let denom_safe = denom_safe_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    // Compute uncertainty numerator
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_lhs, lhs_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_rhs, rhs_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term1, abs_lhs, eps_r, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, term2, abs_rhs, eps_l, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, numer, term1, term2, -1))
    // rhs^2
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, rhs_sq, rhs_val, rhs_val, -1))
    // eps_res = numer / rhs^2  (may be inf if rhs near zero; validity gate handles it)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, GpuTypeF32, eps_res, numer, rhs_sq, -1))

    // near_zero_thresh = 1e-7 (approximately, using f32 literal)
    b = gpu_block_add_op(b, gpu_op_imm_f(GpuOpcodeConst, GpuTypeF32, near_zero_thresh, 0.0000001 as f32))
    // denom_safe = (abs_rhs >= near_zero_thresh)
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, denom_safe, abs_rhs, near_zero_thresh, -1))
    // valid_res = valid_l AND valid_r AND denom_safe
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_l, valid_r, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_res, denom_safe, -1))
    // prov_res = prov_l XOR prov_r
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, GpuTypeI64, prov_res, prov_l, prov_r, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// Emit FMA epistemic shadow: dst = a*b + c
// Epsilon: first multiplicative (|a|*eps_b + |b|*eps_a), then additive quadrature with eps_c
fn hlir_gpu_emit_shadow_fma(s: HlirToGpuState, blk: GpuBlockEntry, result: i64, a_val: i64, b_val: i64, c_val: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let a_idx = hlir_gpu_find_shadow(st, a_val)
    let b_idx = hlir_gpu_find_shadow(st, b_val)
    let c_idx = hlir_gpu_find_shadow(st, c_val)

    var eps_a: i64 = -1
    var valid_a: i64 = -1
    var prov_a: i64 = -1
    var eps_b: i64 = -1
    var valid_b: i64 = -1
    var prov_b: i64 = -1
    var eps_c: i64 = -1
    var valid_c: i64 = -1
    var prov_c: i64 = -1

    if a_idx >= 0 {
        eps_a = st.epistemic_shadows[a_idx as usize].eps_value
        valid_a = st.epistemic_shadows[a_idx as usize].valid_value
        prov_a = st.epistemic_shadows[a_idx as usize].prov_value
    }
    if b_idx >= 0 {
        eps_b = st.epistemic_shadows[b_idx as usize].eps_value
        valid_b = st.epistemic_shadows[b_idx as usize].valid_value
        prov_b = st.epistemic_shadows[b_idx as usize].prov_value
    }
    if c_idx >= 0 {
        eps_c = st.epistemic_shadows[c_idx as usize].eps_value
        valid_c = st.epistemic_shadows[c_idx as usize].valid_value
        prov_c = st.epistemic_shadows[c_idx as usize].prov_value
    }

    // Step 1: multiplicative part — eps_mul = |a|*eps_b + |b|*eps_a
    let abs_a_r = hlir_gpu_alloc_value(st)
    st = abs_a_r.0
    let abs_a = abs_a_r.1

    let abs_b_r = hlir_gpu_alloc_value(st)
    st = abs_b_r.0
    let abs_b = abs_b_r.1

    let mul_t1_r = hlir_gpu_alloc_value(st)
    st = mul_t1_r.0
    let mul_t1 = mul_t1_r.1

    let mul_t2_r = hlir_gpu_alloc_value(st)
    st = mul_t2_r.0
    let mul_t2 = mul_t2_r.1

    let eps_mul_r = hlir_gpu_alloc_value(st)
    st = eps_mul_r.0
    let eps_mul = eps_mul_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_a, a_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAbs, GpuTypeF32, abs_b, b_val, -1, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, mul_t1, abs_a, eps_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, mul_t2, abs_b, eps_a, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, eps_mul, mul_t1, mul_t2, -1))

    // Step 2: additive quadrature — eps_out = sqrt(eps_mul^2 + eps_c^2)
    let sq_mul_r = hlir_gpu_alloc_value(st)
    st = sq_mul_r.0
    let sq_mul = sq_mul_r.1

    let sq_c_r = hlir_gpu_alloc_value(st)
    st = sq_c_r.0
    let sq_c = sq_c_r.1

    let sum_sq_r = hlir_gpu_alloc_value(st)
    st = sum_sq_r.0
    let sum_sq = sum_sq_r.1

    let eps_res_r = hlir_gpu_alloc_value(st)
    st = eps_res_r.0
    let eps_res = eps_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_mul, eps_mul, eps_mul, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, GpuTypeF32, sq_c, eps_c, eps_c, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypeF32, sum_sq, sq_mul, sq_c, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSqrt, GpuTypeF32, eps_res, sum_sq, -1, -1))

    // Step 3: validity = valid_a AND valid_b AND valid_c
    let valid_ab_r = hlir_gpu_alloc_value(st)
    st = valid_ab_r.0
    let valid_ab = valid_ab_r.1

    let valid_res_r = hlir_gpu_alloc_value(st)
    st = valid_res_r.0
    let valid_res = valid_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_ab, valid_a, valid_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, GpuTypeBool, valid_res, valid_ab, valid_c, -1))

    // Step 4: provenance = prov_a XOR prov_b XOR prov_c
    let prov_ab_r = hlir_gpu_alloc_value(st)
    st = prov_ab_r.0
    let prov_ab = prov_ab_r.1

    let prov_res_r = hlir_gpu_alloc_value(st)
    st = prov_res_r.0
    let prov_res = prov_res_r.1

    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, GpuTypeI64, prov_ab, prov_a, prov_b, -1))
    b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, GpuTypeI64, prov_res, prov_ab, prov_c, -1))

    // Record shadow
    if st.shadow_count < 8192 {
        let idx = st.shadow_count as usize
        st.epistemic_shadows[idx] = EpistemicShadowEntry {
            hlir_value: -1,
            gpu_value: result,
            eps_value: eps_res,
            valid_value: valid_res,
            prov_value: prov_res,
        }
        st.shadow_count = st.shadow_count + 1
    }

    (st, b)
}

// ============================================================================
// Section 20 — Instruction lowering
// ============================================================================

fn hlir_lower_instr(s: HlirToGpuState, blk: GpuBlockEntry, op_tag: i64, type_tag: i64, hlir_dst: i64, hlir_src0: i64, hlir_src1: i64, hlir_src2: i64, imm_i: i64, imm_f: f32, axis: i64) -> (HlirToGpuState, GpuBlockEntry) with Mut, Panic {
    var st = s
    var b = blk

    let gpu_type = hlir_lower_type(type_tag)

    // Look up existing GPU IDs for sources
    let g_src0 = hlir_gpu_lookup_value(st, hlir_src0)
    let g_src1 = hlir_gpu_lookup_value(st, hlir_src1)
    let g_src2 = hlir_gpu_lookup_value(st, hlir_src2)

    // Allocate a destination register and record the mapping
    let dst_result = hlir_gpu_map_value(st, hlir_dst, gpu_type)
    st = dst_result.0
    let g_dst = dst_result.1

    if op_tag == HlirOpConst {
        // Emit integer or float constant depending on type
        if type_tag == HLIR_TY_F32 {
            b = gpu_block_add_op(b, gpu_op_imm_f(GpuOpcodeConst, gpu_type, g_dst, imm_f))
        } else {
            b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, imm_i))
        }
    } else if op_tag == HlirOpAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            // Subtraction: errors still add in quadrature
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_add(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpMul {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_mul(st, b, g_dst, g_src0, g_src1, -1, -1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFMul {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeMul, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_mul(st, b, g_dst, g_src0, g_src1, -1, -1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpDiv {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_div(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpFDiv {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeDiv, gpu_type, g_dst, g_src0, g_src1, -1))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_div(st, b, g_dst, g_src0, g_src1)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpNeg {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeNeg, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFNeg {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeNeg, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpRem {
        // Integer remainder; no direct GPU atomic — lower as sub(a, mul(div(a,b),b))
        // Emit as placeholder GpuOpcodeSub with available operands for now
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSub, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAnd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAnd, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpOr {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeOr, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpXor {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeXor, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpShl {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeShl, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpShr {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeShr, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpEq {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpEq, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpNe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpNe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpGt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpGe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFEq {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpEq, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFNe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpNe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFLt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFLe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpLe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFGt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGt, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpFGe {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeSetpGe, GpuTypeBool, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpLoad {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeLoadGlobal, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpStore {
        // Store: dst has no meaningful value — emit with dst_idx = -1
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeStoreGlobal, gpu_type, -1, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAlloca {
        // Local allocation: emit placeholder const 0 (address materialised by backend)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, GpuTypePtr, g_dst, 0))
    } else if op_tag == HlirOpGEP {
        // GetElementPtr: base + offset
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, GpuTypePtr, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpCall {
        // Call cannot be lowered here (needs symbol name lookup in a later pass)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, -1))
    } else if op_tag == HlirOpPhi {
        // Phi nodes: resolved by block structure — emit identity add(src0, 0) as placeholder
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAdd, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpZExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpTrunc {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFpExt {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFpTrunc {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpBitcast {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSIToFP {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpFPToSI {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeCvt, gpu_type, g_dst, g_src0, -1, -1))
    } else if op_tag == HlirOpSelect {
        // selp dst, src0, src1, pred_cond
        let op = gpu_op_make(GpuOpcodeSelp, gpu_type, g_dst, g_src0, g_src1, -1)
        b = gpu_block_add_op(b, gpu_op_pred(op, g_src2))
    } else if op_tag == HlirOpFMA {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeFma, gpu_type, g_dst, g_src0, g_src1, g_src2))
        if st.epistemic_enabled {
            let ep = hlir_gpu_emit_shadow_fma(st, b, g_dst, g_src0, g_src1, g_src2)
            st = ep.0
            b = ep.1
        }
    } else if op_tag == HlirOpGetThreadId {
        let op = gpu_op_make(GpuOpcodeGetTid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetBlockId {
        let op = gpu_op_make(GpuOpcodeGetBid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetBlockDim {
        let op = gpu_op_make(GpuOpcodeGetNtid, gpu_type, g_dst, -1, -1, -1)
        b = gpu_block_add_op(b, gpu_op_axis(op, axis))
    } else if op_tag == HlirOpGetGridDim {
        // No direct GPU IR for grid dim in this IR version — emit placeholder 0
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, 0))
    } else if op_tag == HlirOpAtomicAdd {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicAdd, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicSub {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicSub, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicMin {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicMin, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpAtomicMax {
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeAtomicMax, gpu_type, g_dst, g_src0, g_src1, -1))
    } else if op_tag == HlirOpSyncThreads {
        // Barrier sync has no destination; emit with dst -1
        b = gpu_block_add_op(b, gpu_op_make(GpuOpcodeBarrierSync, gpu_type, -1, -1, -1, -1))
    } else if op_tag == HlirOpSyncWarp {
        // Warp-level barrier (mask = 0xFFFFFFFF)
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeBarrierSync, gpu_type, -1, -1))
    } else {
        // Unknown op — emit a const 0 placeholder to keep value numbering consistent
        b = gpu_block_add_op(b, gpu_op_imm_i(GpuOpcodeConst, gpu_type, g_dst, 0))
    }

    (st, b)
}

// ============================================================================
// Section 21 — Kernel/function lowering helpers
// ============================================================================

fn hlir_gpu_lower_kernel_new(s: HlirToGpuState, is_kernel: bool) -> (HlirToGpuState, GpuKernelEntry) with Mut {
    var out = s
    var k = gpu_kernel_entry_default()
    k.is_kernel = is_kernel
    (out, k)
}

fn hlir_gpu_add_param(k: GpuKernelEntry, name_bytes: [i8; 64], name_len: i64, type_tag: i64, is_restrict: bool) -> GpuKernelEntry with Mut, Panic {
    var out = k
    if out.param_count < 32 {
        let idx = out.param_count as usize
        out.params[idx] = GpuParamEntry {
            name: name_bytes,
            name_len: name_len,
            type_tag: type_tag,
            is_restrict: is_restrict,
        }
        out.param_count = out.param_count + 1
    }
    out
}

fn hlir_gpu_emit_param_load(s: HlirToGpuState, blk: GpuBlockEntry, param_idx: i64, type_tag: i64) -> (HlirToGpuState, GpuBlockEntry, i64) with Mut, Panic {
    var st = s
    var b = blk

    let dst_result = hlir_gpu_alloc_value(st)
    st = dst_result.0
    let dst = dst_result.1

    let op = gpu_op_imm_i(GpuOpcodeLoadParam, type_tag, dst, param_idx)
    b = gpu_block_add_op(b, op)

    (st, b, dst)
}

fn hlir_gpu_add_block_to_kernel(k: GpuKernelEntry, blk: GpuBlockEntry) -> GpuKernelEntry with Mut, Panic {
    var out = k
    if out.block_count < 256 {
        let idx = out.block_count as usize
        out.blocks[idx] = blk
        out.block_count = out.block_count + 1
    }
    out
}

// ============================================================================
// Section 22 — Module-level assembly helpers
// ============================================================================

fn hlir_to_gpu_add_kernel(m: GpuModuleOutput, k: GpuKernelEntry) -> GpuModuleOutput with Mut, Panic {
    var out = m
    if out.kernel_count < 64 {
        out.kernels[out.kernel_count as usize] = k
        out.kernel_count = out.kernel_count + 1
    }
    out
}

fn hlir_to_gpu_add_device_fn(m: GpuModuleOutput, k: GpuKernelEntry) -> GpuModuleOutput with Mut, Panic {
    var out = m
    if out.device_fn_count < 64 {
        out.device_fns[out.device_fn_count as usize] = k
        out.device_fn_count = out.device_fn_count + 1
    }
    out
}

fn hlir_to_gpu_finalize(s: HlirToGpuState, m: GpuModuleOutput) -> GpuModuleOutput {
    // Finalisation is a no-op for now (future: sort blocks, resolve phi targets).
    // The state is consumed and its diagnostic information can be read before calling.
    m
}

// ============================================================================
// Section 23 — Statistics and diagnostics
// ============================================================================

fn hlir_to_gpu_count_epistemic_shadows(s: HlirToGpuState) -> i64 {
    s.shadow_count
}

fn hlir_to_gpu_count_ops(m: GpuModuleOutput) -> i64 {
    var total: i64 = 0
    var ki: i64 = 0
    while ki < m.kernel_count {
        let k = m.kernels[ki as usize]
        var bi: i64 = 0
        while bi < k.block_count {
            total = total + k.blocks[bi as usize].op_count
            bi = bi + 1
        }
        ki = ki + 1
    }
    var di: i64 = 0
    while di < m.device_fn_count {
        let d = m.device_fns[di as usize]
        var bi: i64 = 0
        while bi < d.block_count {
            total = total + d.blocks[bi as usize].op_count
            bi = bi + 1
        }
        di = di + 1
    }
    total
}

fn hlir_to_gpu_sm_supports_fast_math(sm: i64) -> bool {
    sm >= 50
}

// ============================================================================
// Section 24 — HLIR Module kernel extraction (Sprint 27)
// ============================================================================

// Count kernel functions in an HlirModule.
fn hlir_extract_kernel_count(module: HlirModule) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < module.function_count {
        if module.functions[i as usize].is_kernel {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Get the module-level index of the n-th kernel function (0-indexed).
// Returns -1 if not found.
fn hlir_get_kernel_index(module: HlirModule, kernel_idx: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < module.function_count {
        if module.functions[i as usize].is_kernel {
            if count == kernel_idx {
                return i
            }
            count = count + 1
        }
        i = i + 1
    }
    0 - 1
}

// Map an HlirTypeKind to a GpuType for kernel parameter mapping.
fn hlir_type_kind_to_gpu(kind: HlirTypeKind) -> GpuType {
    if kind == HlirTypeKind::HlirTypeI32 { GpuType::GpuI32 }
    else if kind == HlirTypeKind::HlirTypeI64 { GpuType::GpuI64 }
    else if kind == HlirTypeKind::HlirTypeF32 { GpuType::GpuF32 }
    else if kind == HlirTypeKind::HlirTypeF64 { GpuType::GpuF64 }
    else if kind == HlirTypeKind::HlirTypeU32 { GpuType::GpuU32 }
    else if kind == HlirTypeKind::HlirTypeU64 { GpuType::GpuU64 }
    else if kind == HlirTypeKind::HlirTypeBool { GpuType::GpuBool }
    else if kind == HlirTypeKind::HlirTypePtr { GpuType::GpuPtr }
    else { GpuType::GpuI64 }
}

// Map a binary op tag (HlirOpAdd..HlirOpFGe) to a GpuOpcode.
fn hlir_bin_op_to_gpu_opcode(bin_op: i64) -> GpuOpcode {
    if bin_op == HlirOpAdd || bin_op == HlirOpFAdd { GpuOpcode::GpuAdd }
    else if bin_op == HlirOpSub || bin_op == HlirOpFSub { GpuOpcode::GpuSub }
    else if bin_op == HlirOpMul || bin_op == HlirOpFMul { GpuOpcode::GpuMul }
    else if bin_op == HlirOpDiv || bin_op == HlirOpFDiv { GpuOpcode::GpuDiv }
    else if bin_op == HlirOpLt || bin_op == HlirOpFLt { GpuOpcode::GpuSetpLt }
    else if bin_op == HlirOpLe || bin_op == HlirOpFLe { GpuOpcode::GpuSetpLe }
    else if bin_op == HlirOpGt || bin_op == HlirOpFGt { GpuOpcode::GpuSetpGt }
    else if bin_op == HlirOpGe || bin_op == HlirOpFGe { GpuOpcode::GpuSetpGe }
    else if bin_op == HlirOpEq || bin_op == HlirOpFEq { GpuOpcode::GpuSetpEq }
    else if bin_op == HlirOpNe || bin_op == HlirOpFNe { GpuOpcode::GpuSetpNe }
    else { GpuOpcode::GpuAdd }
}

// Map a binary op tag to a GpuType (float ops → f32, int ops → i32 default).
fn hlir_bin_op_type(bin_op: i64) -> GpuType {
    if bin_op >= HlirOpFAdd && bin_op <= HlirOpFGe { GpuType::GpuF32 }
    else { GpuType::GpuI32 }
}

// Append a single GPU op to a GpuKernelIr. Returns the kernel with op appended.
fn gpu_kernel_append_op(kernel: GpuKernelIr, op: GpuOp) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    if k.op_count < 1024 {
        k.ops[k.op_count as usize] = op
        k.op_count = k.op_count + 1
    }
    k
}

// Lower a single HLIR instruction to GPU ops and append to kernel.
fn hlir_instr_to_gpu_ops(kernel: GpuKernelIr, instr: HlirInstr) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let op_kind = instr.op_kind

    if op_kind == HLIR_OP_BINARY {
        var op = gpu_op_new()
        op.opcode = hlir_bin_op_to_gpu_opcode(instr.bin_op)
        op.dst_reg = instr.result
        op.lhs_reg = instr.lhs
        op.rhs_reg = instr.rhs
        op.ty = hlir_bin_op_type(instr.bin_op)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_LOAD {
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = instr.result
        op.addr_reg = instr.src
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        op.memory_space = GpuMemorySpace::GpuMemGlobal
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_STORE {
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuStoreGlobal
        op.addr_reg = instr.store_ptr
        op.src_reg = instr.store_value
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        op.memory_space = GpuMemorySpace::GpuMemGlobal
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_CONST {
        // Emit constant as immediate load into a virtual register
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuAddImm
        op.dst_reg = instr.result
        op.src_reg = 0
        op.rhs_imm = instr.constant.int_val
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_COPY {
        // Copy maps to a mov (implemented as add with zero imm)
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuAddImm
        op.dst_reg = instr.result
        op.src_reg = instr.src
        op.rhs_imm = 0
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_CAST {
        // Type conversion
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuCvt
        op.dst_reg = instr.result
        op.src_reg = instr.cast_value
        op.dst_ty = hlir_type_kind_to_gpu(instr.cast_target.kind)
        op.src_ty = hlir_type_kind_to_gpu(instr.cast_source.kind)
        op.ty = hlir_type_kind_to_gpu(instr.cast_target.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_ALLOCA {
        // Stack allocations map to local memory — skip in MVP
    } else if op_kind == HLIR_OP_PHI {
        // PHI nodes resolved during register allocation — skip in MVP
    } else if op_kind == HLIR_OP_UNARY {
        // Unary ops — map negation to sub from zero
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuSub
        op.dst_reg = instr.result
        op.lhs_reg = 0
        op.rhs_reg = instr.src
        op.ty = hlir_type_kind_to_gpu(instr.ty.kind)
        k = gpu_kernel_append_op(k, op)
    } else if op_kind == HLIR_OP_CALL_DIRECT {
        // Check if it's a GPU intrinsic by name
        // gpu_thread_id_x → GpuGetTid axis=0
        // gpu_block_id_x  → GpuGetBid axis=0
        // gpu_block_dim_x → GpuGetNtid axis=0
        var op = gpu_op_new()
        let cn = instr.call_name
        // Match against known GPU builtins (name-based dispatch)
        if hlir_name_starts_with_gpu_thread(cn) {
            op.opcode = GpuOpcode::GpuGetTid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
        } else if hlir_name_starts_with_gpu_block_id(cn) {
            op.opcode = GpuOpcode::GpuGetBid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
        } else if hlir_name_starts_with_gpu_block_dim(cn) {
            op.opcode = GpuOpcode::GpuGetNtid
            op.dst_reg = instr.result
            op.axis = 0
            op.ty = GpuType::GpuU32
            k = gpu_kernel_append_op(k, op)
        }
        // Other calls: skip in MVP
    }
    // Unhandled ops silently skipped in MVP bridge

    k
}

// Check if an HlirName starts with "gpu_thread_id" (13 chars).
fn hlir_name_starts_with_gpu_thread(n: HlirName) -> bool {
    if n.len < 13 { return false }
    // "gpu_thread_id" = g(103) p(112) u(117) _(95) t(116) h(104) r(114) e(101) a(97) d(100) _(95) i(105) d(100)
    n.buf[0] == 103 as i8 && n.buf[1] == 112 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 95 as i8 &&
    n.buf[4] == 116 as i8 && n.buf[5] == 104 as i8 && n.buf[6] == 114 as i8 && n.buf[7] == 101 as i8 &&
    n.buf[8] == 97 as i8 && n.buf[9] == 100 as i8 && n.buf[10] == 95 as i8 && n.buf[11] == 105 as i8 &&
    n.buf[12] == 100 as i8
}

// Check if an HlirName starts with "gpu_block_id" (12 chars).
fn hlir_name_starts_with_gpu_block_id(n: HlirName) -> bool {
    if n.len < 12 { return false }
    // "gpu_block_id" = g(103) p(112) u(117) _(95) b(98) l(108) o(111) c(99) k(107) _(95) i(105) d(100)
    n.buf[0] == 103 as i8 && n.buf[1] == 112 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 95 as i8 &&
    n.buf[4] == 98 as i8 && n.buf[5] == 108 as i8 && n.buf[6] == 111 as i8 && n.buf[7] == 99 as i8 &&
    n.buf[8] == 107 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 105 as i8 && n.buf[11] == 100 as i8
}

// Check if an HlirName starts with "gpu_block_dim" (13 chars).
fn hlir_name_starts_with_gpu_block_dim(n: HlirName) -> bool {
    if n.len < 13 { return false }
    // "gpu_block_dim" = g(103) p(112) u(117) _(95) b(98) l(108) o(111) c(99) k(107) _(95) d(100) i(105) m(109)
    n.buf[0] == 103 as i8 && n.buf[1] == 112 as i8 && n.buf[2] == 117 as i8 && n.buf[3] == 95 as i8 &&
    n.buf[4] == 98 as i8 && n.buf[5] == 108 as i8 && n.buf[6] == 111 as i8 && n.buf[7] == 99 as i8 &&
    n.buf[8] == 107 as i8 && n.buf[9] == 95 as i8 && n.buf[10] == 100 as i8 && n.buf[11] == 105 as i8 &&
    n.buf[12] == 109 as i8
}

// Convert HlirName → Name (structurally identical, different types).
fn hlir_name_to_name(hn: HlirName) -> Name {
    Name { buf: hn.buf, len: hn.len }
}

// Build a GpuKernelIr from an HlirFunction marked as kernel.
// MVP: handles basic blocks with arithmetic, loads, stores, comparisons, GPU intrinsics.
fn hlir_function_to_gpu_kernel(func: HlirFunction) -> GpuKernelIr with Mut, Panic, Div {
    var kernel = gpu_kernel_new()

    // Copy kernel name
    kernel.kernel_name = hlir_name_to_name(func.name)

    // Map HLIR params → GPU params
    var pi: i64 = 0
    while pi < func.param_count {
        if pi < 8 {
            let p = func.params[pi as usize]
            kernel.params[pi as usize] = GpuParam {
                name: hlir_name_to_name(p.name),
                ty: hlir_type_kind_to_gpu(p.ty.kind),
            }
            kernel.param_count = kernel.param_count + 1
        }
        pi = pi + 1
    }

    // Walk all basic blocks and lower instructions + terminators
    var bi: i64 = 0
    while bi < func.block_count {
        let block = func.blocks[bi as usize]

        // Lower instructions in this block
        var ii: i64 = 0
        while ii < block.instr_count {
            kernel = hlir_instr_to_gpu_ops(kernel, block.instrs[ii as usize])
            ii = ii + 1
        }

        // Lower block terminator
        let term = block.terminator
        if term.kind == HLIR_TERM_RETURN {
            var ret_op = gpu_op_new()
            ret_op.opcode = GpuOpcode::GpuRet
            kernel = gpu_kernel_append_op(kernel, ret_op)
        } else if term.kind == HLIR_TERM_BRANCH {
            var bra_op = gpu_op_new()
            bra_op.opcode = GpuOpcode::GpuBra
            bra_op.rhs_imm = term.branch_target
            bra_op.pred_reg = 0 - 1
            kernel = gpu_kernel_append_op(kernel, bra_op)
        } else if term.kind == HLIR_TERM_COND_BRANCH {
            // Conditional branch: setp on condition, then predicated branch
            var setp_op = gpu_op_new()
            setp_op.opcode = GpuOpcode::GpuSetpNe
            setp_op.dst_reg = 0
            setp_op.lhs_reg = term.cond_value
            setp_op.rhs_imm = 0
            setp_op.ty = GpuType::GpuI32
            kernel = gpu_kernel_append_op(kernel, setp_op)

            var bra_then = gpu_op_new()
            bra_then.opcode = GpuOpcode::GpuBra
            bra_then.rhs_imm = term.then_block
            bra_then.pred_reg = 0
            kernel = gpu_kernel_append_op(kernel, bra_then)

            var bra_else = gpu_op_new()
            bra_else.opcode = GpuOpcode::GpuBra
            bra_else.rhs_imm = term.else_block
            bra_else.pred_reg = 0 - 1
            kernel = gpu_kernel_append_op(kernel, bra_else)
        }
        // UNREACHABLE/SWITCH: skip in MVP

        bi = bi + 1
    }

    // If no explicit return was emitted, append one
    if kernel.op_count == 0 || kernel.ops[(kernel.op_count - 1) as usize].opcode != GpuOpcode::GpuRet {
        var ret_op = gpu_op_new()
        ret_op.opcode = GpuOpcode::GpuRet
        kernel = gpu_kernel_append_op(kernel, ret_op)
    }

    kernel
}

// ============================================================================
// Section 25 — Epistemic kernel shadow register emission (Sprint 28)
//
// No prior art: Sounio is the first language to propagate epistemic uncertainty
// through GPU kernels at the type level. Each arithmetic op on Knowledge<T>
// values gets a companion shadow op that propagates uncertainty using
// quadrature rules: eps_c = sqrt(eps_a^2 + eps_b^2) for addition,
// eps_c = |a|*eps_b + |b|*eps_a for multiplication.
// ============================================================================

// Emit shadow uncertainty propagation ops for a binary arithmetic GpuOp.
// Returns the kernel with shadow ops appended.
// Shadow registers use ids starting at offset 512 (above normal regs).
fn gpu_emit_epistemic_shadow_binary(
    kernel: GpuKernelIr,
    op: GpuOp,
    shadow_offset: i64
) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let eps_dst = op.dst_reg + shadow_offset
    let eps_lhs = op.lhs_reg + shadow_offset
    let eps_rhs = op.rhs_reg + shadow_offset

    if op.opcode == GpuOpcode::GpuAdd || op.opcode == GpuOpcode::GpuSub {
        // eps_c = sqrt(eps_a^2 + eps_b^2)  [quadrature addition]
        // Step 1: tmp1 = eps_lhs * eps_lhs
        var sq_lhs = gpu_op_new()
        sq_lhs.opcode = GpuOpcode::GpuMul
        sq_lhs.dst_reg = eps_dst + 1000
        sq_lhs.lhs_reg = eps_lhs
        sq_lhs.rhs_reg = eps_lhs
        sq_lhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sq_lhs)

        // Step 2: tmp2 = eps_rhs * eps_rhs
        var sq_rhs = gpu_op_new()
        sq_rhs.opcode = GpuOpcode::GpuMul
        sq_rhs.dst_reg = eps_dst + 1001
        sq_rhs.lhs_reg = eps_rhs
        sq_rhs.rhs_reg = eps_rhs
        sq_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sq_rhs)

        // Step 3: tmp3 = tmp1 + tmp2
        var add_sq = gpu_op_new()
        add_sq.opcode = GpuOpcode::GpuAdd
        add_sq.dst_reg = eps_dst + 1002
        add_sq.lhs_reg = eps_dst + 1000
        add_sq.rhs_reg = eps_dst + 1001
        add_sq.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, add_sq)

        // Step 4: eps_dst = sqrt(tmp3)
        var sqrt_op = gpu_op_new()
        sqrt_op.opcode = GpuOpcode::GpuSqrt
        sqrt_op.dst_reg = eps_dst
        sqrt_op.src_reg = eps_dst + 1002
        sqrt_op.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, sqrt_op)
    } else if op.opcode == GpuOpcode::GpuMul {
        // eps_c = |a|*eps_b + |b|*eps_a  [first-order product rule]
        // Step 1: tmp1 = abs(lhs) * eps_rhs
        var abs_lhs = gpu_op_new()
        abs_lhs.opcode = GpuOpcode::GpuAbs
        abs_lhs.dst_reg = eps_dst + 1000
        abs_lhs.src_reg = op.lhs_reg
        abs_lhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_lhs)

        var mul1 = gpu_op_new()
        mul1.opcode = GpuOpcode::GpuMul
        mul1.dst_reg = eps_dst + 1001
        mul1.lhs_reg = eps_dst + 1000
        mul1.rhs_reg = eps_rhs
        mul1.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul1)

        // Step 2: tmp2 = abs(rhs) * eps_lhs
        var abs_rhs = gpu_op_new()
        abs_rhs.opcode = GpuOpcode::GpuAbs
        abs_rhs.dst_reg = eps_dst + 1002
        abs_rhs.src_reg = op.rhs_reg
        abs_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_rhs)

        var mul2 = gpu_op_new()
        mul2.opcode = GpuOpcode::GpuMul
        mul2.dst_reg = eps_dst + 1003
        mul2.lhs_reg = eps_dst + 1002
        mul2.rhs_reg = eps_lhs
        mul2.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul2)

        // Step 3: eps_dst = tmp1 + tmp2
        var add_eps = gpu_op_new()
        add_eps.opcode = GpuOpcode::GpuAdd
        add_eps.dst_reg = eps_dst
        add_eps.lhs_reg = eps_dst + 1001
        add_eps.rhs_reg = eps_dst + 1003
        add_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, add_eps)
    } else if op.opcode == GpuOpcode::GpuDiv {
        // eps_c = eps_a / |b|  [first-order quotient, simplified]
        var abs_rhs = gpu_op_new()
        abs_rhs.opcode = GpuOpcode::GpuAbs
        abs_rhs.dst_reg = eps_dst + 1000
        abs_rhs.src_reg = op.rhs_reg
        abs_rhs.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_rhs)

        var div_eps = gpu_op_new()
        div_eps.opcode = GpuOpcode::GpuDiv
        div_eps.dst_reg = eps_dst
        div_eps.lhs_reg = eps_lhs
        div_eps.rhs_reg = eps_dst + 1000
        div_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, div_eps)
    }
    // Other ops: shadow passthrough (eps_dst = max(eps_lhs, eps_rhs))

    k
}

// Emit shadow uncertainty propagation for unary GpuOps (Sprint 30).
// Sqrt: eps = eps_in / (2 * |val|)  [derivative of sqrt]
// Abs/Neg: eps = eps_in              [passthrough]
fn gpu_emit_epistemic_shadow_unary(
    kernel: GpuKernelIr,
    op: GpuOp,
    shadow_offset: i64
) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let eps_dst = op.dst_reg + shadow_offset
    let eps_src = op.src_reg + shadow_offset

    if op.opcode == GpuOpcode::GpuSqrt {
        // eps_sqrt = eps_in / (2 * |val|)
        // Step 1: tmp1 = abs(val)
        var abs_val = gpu_op_new()
        abs_val.opcode = GpuOpcode::GpuAbs
        abs_val.dst_reg = eps_dst + 1000
        abs_val.src_reg = op.src_reg
        abs_val.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, abs_val)

        var mul_two = gpu_op_new()
        mul_two.opcode = GpuOpcode::GpuMulImm
        mul_two.dst_reg = eps_dst + 1002
        mul_two.lhs_reg = eps_dst + 1000
        mul_two.rhs_imm = 2
        mul_two.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, mul_two)

        // Step 3: eps_dst = eps_src / tmp2
        var div_eps = gpu_op_new()
        div_eps.opcode = GpuOpcode::GpuDiv
        div_eps.dst_reg = eps_dst
        div_eps.lhs_reg = eps_src
        div_eps.rhs_reg = eps_dst + 1002
        div_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, div_eps)
    } else if op.opcode == GpuOpcode::GpuAbs {
        // eps passthrough: uncertainty unchanged by abs
        var copy_eps = gpu_op_new()
        copy_eps.opcode = GpuOpcode::GpuMulImm
        copy_eps.dst_reg = eps_dst
        copy_eps.lhs_reg = eps_src
        copy_eps.rhs_imm = 1
        copy_eps.ty = GpuType::GpuF64
        k = gpu_kernel_append_op(k, copy_eps)
    }

    k
}

// Lower an HlirFunction to GpuKernelIr with epistemic shadow registers.
// Each parameter gets a shadow uncertainty register; each arithmetic op
// gets companion uncertainty propagation ops.
fn hlir_function_to_epistemic_gpu_kernel(func: HlirFunction) -> GpuKernelIr with Mut, Panic, Div {
    var kernel = hlir_function_to_gpu_kernel(func)

    // Shadow register offset: shadow for reg R is at R + 512
    let shadow_offset: i64 = 512

    // Walk ops and insert shadow propagation for arithmetic ops
    // We work on a copy to avoid in-place insertion complexity
    var src_ops: [GpuOp; 1024] = kernel.ops
    let src_count = kernel.op_count

    // Reset kernel ops and rebuild with interleaved shadow ops
    kernel.op_count = 0
    var oi: i64 = 0
    while oi < src_count {
        let op = src_ops[oi as usize]
        // Append original op
        kernel = gpu_kernel_append_op(kernel, op)

        // If it's an arithmetic binary op, also emit shadow propagation
        if op.opcode == GpuOpcode::GpuAdd || op.opcode == GpuOpcode::GpuSub ||
           op.opcode == GpuOpcode::GpuMul || op.opcode == GpuOpcode::GpuDiv {
            kernel = gpu_emit_epistemic_shadow_binary(kernel, op, shadow_offset)
        }
        // Unary ops: sqrt, abs
        if op.opcode == GpuOpcode::GpuSqrt || op.opcode == GpuOpcode::GpuAbs {
            kernel = gpu_emit_epistemic_shadow_unary(kernel, op, shadow_offset)
        }

        oi = oi + 1
    }

    kernel
}

// ============================================================================
// Section 26 — End-to-end pipeline orchestrators (Sprint 28)
// ============================================================================

// Extract all kernel functions from an HlirModule, lower each to GpuKernelIr,
// then lower each to PTX and concatenate into a single PtxBuf.
fn hlir_kernels_to_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = ptx_buf_append(combined, ptx)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions, apply auto-tuning, then lower to PTX.
// Auto-tuning detects workload patterns and sets optimal CTA dimensions.
fn hlir_kernels_to_tuned_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    let cfg = gpu_autotune_config_default()
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            var gpu_kernel = hlir_function_to_gpu_kernel(func)
            // Apply auto-tuning: analyze workload pattern, set block shape
            let tuned = gpu_autotune_tune_kernel(gpu_kernel, cfg)
            let threads = gpu_block_shape_total_threads(tuned.block_shape)
            if threads > 0 {
                gpu_kernel.max_threads = threads
            }
            if tuned.shared_mem_bytes > gpu_kernel.shared_mem_bytes {
                gpu_kernel.shared_mem_bytes = tuned.shared_mem_bytes
            }
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = ptx_buf_append(combined, ptx)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions, attempt pairwise fusion, then lower to PTX.
// Kernel fusion merges compatible adjacent kernels to reduce launch overhead.
fn hlir_kernels_to_fused_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    // Extract all kernels into array
    var kernels: [GpuKernelIr; 32] = [gpu_kernel_new(); 32]
    var actual: i64 = 0
    var ki: i64 = 0
    while ki < kcount && ki < 32 {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            kernels[actual as usize] = hlir_function_to_gpu_kernel(func)
            actual = actual + 1
        }
        ki = ki + 1
    }

    // Attempt pairwise fusion (greedy)
    var fused_kernels: [GpuKernelIr; 32] = [gpu_kernel_new(); 32]
    var fused_count: i64 = 0
    var fi: i64 = 0
    while fi < actual {
        if fi + 1 < actual {
            let pair = gpu_fuse_pair(kernels[fi as usize], kernels[(fi + 1) as usize])
            if pair.1 {
                // Fusion succeeded
                fused_kernels[fused_count as usize] = pair.0
                fused_count = fused_count + 1
                fi = fi + 2
            } else {
                // Keep original
                fused_kernels[fused_count as usize] = kernels[fi as usize]
                fused_count = fused_count + 1
                fi = fi + 1
            }
        } else {
            fused_kernels[fused_count as usize] = kernels[fi as usize]
            fused_count = fused_count + 1
            fi = fi + 1
        }
    }

    // Lower all (fused + unfused) kernels to PTX
    var pi: i64 = 0
    while pi < fused_count {
        let ptx = gpu_lower_to_ptx(fused_kernels[pi as usize])
        combined = ptx_buf_append(combined, ptx)
        pi = pi + 1
    }
    combined
}

// Extract all kernel functions with epistemic shadow registers, then lower to PTX.
// Each kernel gets companion uncertainty propagation ops for arithmetic operations.
fn hlir_kernels_to_epistemic_ptx(module: HlirModule) -> PtxBuf with Mut, Panic, Div, Alloc {
    var combined = ptx_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    if kcount == 0 {
        return combined
    }
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_epistemic_gpu_kernel(func)
            let ptx = gpu_lower_to_ptx(gpu_kernel)
            combined = ptx_buf_append(combined, ptx)
        }
        ki = ki + 1
    }
    combined
}

// Extract all kernel functions and lower to Metal MSL.
fn hlir_kernels_to_metal(module: HlirModule) -> MetalBuf with Mut, Panic, Div, Alloc {
    var combined = metal_buf_new()
    let kcount = hlir_extract_kernel_count(module)
    var ki: i64 = 0
    while ki < kcount {
        let fidx = hlir_get_kernel_index(module, ki)
        if fidx >= 0 {
            let func = module.functions[fidx as usize]
            let gpu_kernel = hlir_function_to_gpu_kernel(func)
            let metal = gpu_lower_to_metal(gpu_kernel)
            combined = metal_buf_append(combined, metal)
        }
        ki = ki + 1
    }
    combined
}

// ============================================================================
// Section 30 — Source-level GPU builtin lowering
// ============================================================================
//
// Maps source-level GPU builtin tags to GpuOp emissions in a GpuKernelIr.
// This is the bridge used when lowering `kernel fn` bodies that reference
// GPU intrinsics by name.
//
// Design:
//   - Takes GpuKernelIr by value and returns modified copy (same as all builders).
//   - Uses gpu_op_new() + field assignment pattern (same as hlir_instr_to_gpu_ops).
//   - Builtin tag constants defined below (HLIR_GPU_BUILTIN_*).
//
// Supported builtin tags:
//   HLIR_GPU_BUILTIN_TID_X       → GpuGetTid  axis=0  (gpu.thread_id.x)
//   HLIR_GPU_BUILTIN_TID_Y       → GpuGetTid  axis=1  (gpu.thread_id.y)
//   HLIR_GPU_BUILTIN_TID_Z       → GpuGetTid  axis=2  (gpu.thread_id.z)
//   HLIR_GPU_BUILTIN_BID_X       → GpuGetBid  axis=0  (gpu.block_id.x)
//   HLIR_GPU_BUILTIN_BID_Y       → GpuGetBid  axis=1  (gpu.block_id.y)
//   HLIR_GPU_BUILTIN_BID_Z       → GpuGetBid  axis=2  (gpu.block_id.z)
//   HLIR_GPU_BUILTIN_BDIM_X      → GpuGetNtid axis=0  (gpu.block_dim.x)
//   HLIR_GPU_BUILTIN_SYNC_THREADS→ GpuBarrierSync      (gpu.sync_threads)

// Builtin tag constants for hlir_lower_gpu_builtins.
let HLIR_GPU_BUILTIN_TID_X: i64 = 0
let HLIR_GPU_BUILTIN_TID_Y: i64 = 1
let HLIR_GPU_BUILTIN_TID_Z: i64 = 2
let HLIR_GPU_BUILTIN_BID_X: i64 = 3
let HLIR_GPU_BUILTIN_BID_Y: i64 = 4
let HLIR_GPU_BUILTIN_BID_Z: i64 = 5
let HLIR_GPU_BUILTIN_BDIM_X: i64 = 6
let HLIR_GPU_BUILTIN_SYNC_THREADS: i64 = 7

// Lower a source-level GPU builtin to a GpuOp and append it to the kernel.
//
// Parameters:
//   kernel      — GpuKernelIr being built (by value)
//   builtin_tag — one of HLIR_GPU_BUILTIN_* constants above
//   dst_reg     — destination virtual register for the result (-1 for void ops)
//
// Returns the kernel with one GpuOp appended (or unchanged if tag unknown).
fn hlir_lower_gpu_builtins(kernel: GpuKernelIr, builtin_tag: i64, dst_reg: i64) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    if builtin_tag == HLIR_GPU_BUILTIN_TID_X {
        // gpu.thread_id.x → GpuGetTid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_TID_Y {
        // gpu.thread_id.y → GpuGetTid axis=1
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_TID_Z {
        // gpu.thread_id.z → GpuGetTid axis=2
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetTid
        op.dst_reg = dst_reg
        op.axis = 2
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_X {
        // gpu.block_id.x → GpuGetBid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_Y {
        // gpu.block_id.y → GpuGetBid axis=1
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BID_Z {
        // gpu.block_id.z → GpuGetBid axis=2
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetBid
        op.dst_reg = dst_reg
        op.axis = 2
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_BDIM_X {
        // gpu.block_dim.x → GpuGetNtid axis=0
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuGetNtid
        op.dst_reg = dst_reg
        op.axis = 0
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    } else if builtin_tag == HLIR_GPU_BUILTIN_SYNC_THREADS {
        // gpu.sync_threads → GpuBarrierSync
        var op = gpu_op_new()
        op.opcode = GpuOpcode::GpuBarrierSync
        op.dst_reg = -1
        op.ty = GpuType::GpuU32
        k = gpu_kernel_append_op(k, op)
    }
    k
}

// Emit the standard 1D kernel prologue into a GpuKernelIr.
//
// For a 1D kernel launch the standard index computation is:
//   tid        = threadIdx.x          (GpuGetTid  axis=0)
//   bid        = blockIdx.x           (GpuGetBid  axis=0)
//   bdim       = blockDim.x           (GpuGetNtid axis=0)
//   global_idx = bid * bdim + tid     (GpuMul + GpuAdd)
//
// Virtual register layout (offset from num_params):
//   num_params + 0 → tid
//   num_params + 1 → bid
//   num_params + 2 → bdim
//   num_params + 3 → bid * bdim  (scratch)
//   num_params + 4 → global_idx  (result)
//
// Returns the kernel with prologue ops appended.
fn hlir_emit_kernel_prologue(kernel: GpuKernelIr, num_params: i64) -> GpuKernelIr with Mut, Panic {
    var k = kernel
    let r_tid: i64 = num_params + 0
    let r_bid: i64 = num_params + 1
    let r_bdim: i64 = num_params + 2
    let r_mul: i64 = num_params + 3
    let r_gidx: i64 = num_params + 4

    // tid = threadIdx.x
    var op_tid = gpu_op_new()
    op_tid.opcode = GpuOpcode::GpuGetTid
    op_tid.dst_reg = r_tid
    op_tid.axis = 0
    op_tid.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_tid)

    // bid = blockIdx.x
    var op_bid = gpu_op_new()
    op_bid.opcode = GpuOpcode::GpuGetBid
    op_bid.dst_reg = r_bid
    op_bid.axis = 0
    op_bid.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_bid)

    // bdim = blockDim.x
    var op_bdim = gpu_op_new()
    op_bdim.opcode = GpuOpcode::GpuGetNtid
    op_bdim.dst_reg = r_bdim
    op_bdim.axis = 0
    op_bdim.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_bdim)

    // r_mul = bid * bdim
    var op_mul = gpu_op_new()
    op_mul.opcode = GpuOpcode::GpuMul
    op_mul.dst_reg = r_mul
    op_mul.lhs_reg = r_bid
    op_mul.rhs_reg = r_bdim
    op_mul.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_mul)

    // global_idx = r_mul + tid
    var op_add = gpu_op_new()
    op_add.opcode = GpuOpcode::GpuAdd
    op_add.dst_reg = r_gidx
    op_add.lhs_reg = r_mul
    op_add.rhs_reg = r_tid
    op_add.ty = GpuType::GpuU32
    k = gpu_kernel_append_op(k, op_add)

    k
}
