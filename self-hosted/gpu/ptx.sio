// self-hosted::gpu::ptx — PTX text emitter (phase 0)
//
// PTX-first strategy:
// - Emit deterministic PTX text as a string-like byte buffer (no GPU execution yet).
// - Keep this module pure and testable via substring checks in self-hosted tests.
//
// Later phases (not in this file yet):
// - Lower Sounio IR -> PTX
// - Emit kernel parameter layouts + address spaces
// - Host-side launch (CUDA Driver API) or static assembly path

pub struct PtxBuf {
    pub data: [i8; 65536],
    pub len: i64,
}

pub var PTX_TO_STRING_BUF: [i8; 65536] = [0; 65536]

pub fn ptx_buf_new() -> PtxBuf {
    PtxBuf { data: [0; 65536], len: 0 }
}

pub fn ptx_push_byte(buf: PtxBuf, b: i8) -> PtxBuf with Mut, Panic {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.data[out.len as usize] = b
            out.len = out.len + 1
        }
    }
    out
}

pub fn ptx_push_str(buf: PtxBuf, s: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

pub fn ptx_push_i64(buf: PtxBuf, n: i64) -> PtxBuf with Mut, Panic, Div {
    if n == 0 { return ptx_push_byte(buf, 48) }
    var value: i64 = if n < 0 { 0 } else { n }
    var digits: [i8; 20] = [0 as i8; 20]
    var rev_len: i64 = 0
    while value > 0 {
        digits[rev_len as usize] = (48 + value % 10) as i8
        rev_len = rev_len + 1
        value = value / 10
    }
    var out = buf
    var k: i64 = rev_len - 1
    while k >= 0 {
        out = ptx_push_byte(out, digits[k as usize])
        k = k - 1
    }
    out
}

pub fn ptx_buf_contains(buf: PtxBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

pub fn ptx_to_string(buf: PtxBuf) -> string with Mut, Panic {
    var i: i64 = 0
    while i < buf.len {
        PTX_TO_STRING_BUF[i as usize] = buf.data[i as usize]
        i = i + 1
    }
    PTX_TO_STRING_BUF[buf.len as usize] = 0
    str_from_bytes(PTX_TO_STRING_BUF, buf.len)
}

pub fn ptx_str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    // Self-hosted-friendly substring check.
    //
    // NOTE: The VM has a `contains` builtin, but we keep a local implementation
    // so the self-hosted compilation pipeline doesn't depend on compiler-side
    // builtin resolution for that symbol.
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }

    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

pub fn ptx_trim_leading_spaces(s: string) -> string with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0

    while i < n {
        let c = str_char_at(s, i)
        if c != 32 && c != 9 {
            break
        }
        i = i + 1
    }

    str_slice(s, i, n)
}

pub fn ptx_has_predicated_opcode(haystack: string, opcode: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == 10 {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            let first = str_char_at(line, 0)
            if (first == 64 || ptx_str_contains(line, "@%")) && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

pub fn ptx_has_predicated_opcode_with_pred(haystack: string, opcode: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == 10 {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, pred) && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

pub fn ptx_has_predicate_token(line: string, pred: string) -> bool with Mut, Panic, Div {
    let token_with_space_prefix = " " ++ pred ++ ","
    let token_with_delim = pred ++ ","
    let token_with_space_suffix = ", " ++ pred ++ ","
    let token_with_semicolon = ", " ++ pred ++ ";"

    if ptx_str_contains(line, pred) {
        if starts_with(line, pred) {
            return true
        }
        if ptx_str_contains(line, token_with_space_prefix) {
            return true
        }
        if ptx_str_contains(line, token_with_delim) {
            return true
        }
        if ptx_str_contains(line, token_with_space_suffix) {
            return true
        }
        if ptx_str_contains(line, token_with_semicolon) {
            return true
        }
    }
    false
}

pub fn ptx_has_setp_with_pred(haystack: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == 10 {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, "setp.") && ptx_has_predicate_token(line, pred) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

pub fn ptx_has_selp_with_pred(haystack: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == 10 {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, "selp") && ptx_has_predicate_token(line, pred) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

pub fn ptx_has_unpredicated_opcode(haystack: string, opcode: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == 10 {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if str_len(line) > 0 && !ptx_str_contains(line, "@") && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

