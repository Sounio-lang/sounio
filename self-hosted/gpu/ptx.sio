pub fn ptx_push_binary3(
    buf: PtxBuf,
    opcode: string,
    dst: string,
    lhs: string,
    rhs: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

pub fn ptx_push_binary2(
    buf: PtxBuf,
    opcode: string,
    lhs: string,
    rhs: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

pub fn ptx_push_binary_mem2(
    buf: PtxBuf,
    opcode: string,
    dst_or_dst_ptr: string,
    rhs_or_rhs_ptr: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst_or_dst_ptr)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, rhs_or_rhs_ptr)
    out = ptx_push_str(out, "];\n")
    out
}

pub fn ptx_push_store_mem(
    buf: PtxBuf,
    opcode: string,
    dst_ptr: string,
    src: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " [")
    out = ptx_push_str(out, dst_ptr)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

pub fn ptx_emit_shared_decl(
    buf: PtxBuf,
    bytes: i64
) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    // .align 16: covers f16 (2 B) and the f64 tensor-core tile's st.shared.f64 / wmma.load.*.f64,
    // which need 8-byte alignment (16 ≥ 8, and over-aligning is always safe).
    out = ptx_push_str(out, "    .shared .align 16 .b8 shared_array[")
    out = ptx_push_i64(out, bytes)
    out = ptx_push_str(out, "];\n")
    out
}

pub fn ptx_push_ret(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    ptx_push_str(buf, "    ret;\n")
}

// Reduction helper functions

pub fn ptx_push_barrier_sync(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    ptx_push_str(buf, "    bar.sync 0;\n")
}

pub fn ptx_push_shfl_down(
    buf: PtxBuf,
    opcode: string,
    dst: string,
    src: string,
    offset: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, offset)
    out = ptx_push_str(out, ", 0xffffffff;\n")
    out
}

