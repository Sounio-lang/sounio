// self-hosted::gpu::ptx — PTX text emitter (phase 0)
//
// PTX-first strategy:
// - Emit deterministic PTX text as a string-like byte buffer (no GPU execution yet).
// - Keep this module pure and testable via substring checks in self-hosted tests.
//
// Later phases (not in this file yet):
// - Lower Sounio IR -> PTX
// - Emit kernel parameter layouts + address spaces
// - Host-side launch (CUDA Driver API) or static assembly path

struct PtxBuf {
    data: [i8; 65536],
    len: i64,
}

fn ptx_buf_new() -> PtxBuf {
    PtxBuf { data: [0; 65536], len: 0 }
}

fn ptx_push_byte(buf: PtxBuf, b: i8) -> PtxBuf with Mut, Panic {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.data[out.len as usize] = b
            out.len = out.len + 1
        }
    }
    out
}

fn ptx_push_str(buf: PtxBuf, s: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

fn ptx_buf_contains(buf: PtxBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn ptx_to_string(buf: PtxBuf) -> string with Mut, Panic, Div, Alloc {
    // Convert the raw byte buffer to a VM string.
    // Note: `str_from_bytes` expects a list/sparse-list of ints plus a length.
    str_from_bytes(buf.data, buf.len)
}

fn ptx_str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    // Self-hosted-friendly substring check.
    //
    // NOTE: The VM has a `contains` builtin, but we keep a local implementation
    // so the self-hosted compilation pipeline doesn't depend on compiler-side
    // builtin resolution for that symbol.
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }

    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

// Core PTX emitter pieces used for deterministic text scaffolding.
// Keeps phase-0 output stable and easy to extend in later PTX-first passes.

fn ptx_header_version() -> string { "7.0" }

fn ptx_header_target() -> string { "sm_50" }

fn ptx_header_address_size() -> string { ".address_size 64" }

fn ptx_opcode_mov_u32() -> string { "mov.u32" }

fn ptx_opcode_cvt_u64_u32() -> string { "cvt.u64.u32" }

fn ptx_opcode_mul_lo_u64() -> string { "mul.lo.u64" }

fn ptx_opcode_ld_param_u64() -> string { "ld.param.u64" }

fn ptx_opcode_add_u64() -> string { "add.u64" }

fn ptx_opcode_ld_global_f32() -> string { "ld.global.f32" }

fn ptx_opcode_add_f32() -> string { "add.f32" }

fn ptx_opcode_st_global_f32() -> string { "st.global.f32" }

fn ptx_opcode_ret() -> string { "ret" }

// Type-specific opcodes for f64/i32/i64
fn ptx_opcode_add_f64() -> string { "add.f64" }

fn ptx_opcode_add_s32() -> string { "add.s32" }

fn ptx_opcode_add_s64() -> string { "add.s64" }

fn ptx_opcode_ld_global_f64() -> string { "ld.global.f64" }

fn ptx_opcode_ld_global_s32() -> string { "ld.global.s32" }

fn ptx_opcode_ld_global_s64() -> string { "ld.global.s64" }

fn ptx_opcode_st_global_f64() -> string { "st.global.f64" }

fn ptx_opcode_st_global_s32() -> string { "st.global.s32" }

fn ptx_opcode_st_global_s64() -> string { "st.global.s64" }

// Element-wise operation opcodes (sub/mul/div for all types)
fn ptx_opcode_sub_f32() -> string { "sub.f32" }

fn ptx_opcode_sub_f64() -> string { "sub.f64" }

fn ptx_opcode_sub_s32() -> string { "sub.s32" }

fn ptx_opcode_sub_s64() -> string { "sub.s64" }

fn ptx_opcode_sub_u64() -> string { "sub.u64" }

fn ptx_opcode_mul_lo_f32() -> string { "mul.lo.f32" }

fn ptx_opcode_mul_lo_f64() -> string { "mul.lo.f64" }

fn ptx_opcode_mul_lo_s32() -> string { "mul.lo.s32" }

fn ptx_opcode_mul_lo_s64() -> string { "mul.lo.s64" }

fn ptx_opcode_div_f32() -> string { "div.rn.f32" }

fn ptx_opcode_div_f64() -> string { "div.rn.f64" }

fn ptx_opcode_div_s32() -> string { "div.s32" }

fn ptx_opcode_div_s64() -> string { "div.s64" }

fn ptx_opcode_div_u64() -> string { "div.u64" }

fn ptx_push_binary3(
    buf: PtxBuf,
    opcode: string,
    dst: string,
    lhs: string,
    rhs: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_push_binary2(
    buf: PtxBuf,
    opcode: string,
    lhs: string,
    rhs: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_push_binary_mem2(
    buf: PtxBuf,
    opcode: string,
    dst_or_dst_ptr: string,
    rhs_or_rhs_ptr: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst_or_dst_ptr)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, rhs_or_rhs_ptr)
    out = ptx_push_str(out, "];\n")
    out
}

fn ptx_push_store_mem(
    buf: PtxBuf,
    opcode: string,
    dst_ptr: string,
    src: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " [")
    out = ptx_push_str(out, dst_ptr)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_push_ret(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    ptx_push_str(buf, "    ret;\n")
}

fn ptx_emit_header(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".version ")
    out = ptx_push_str(out, ptx_header_version())
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, ".target ")
    out = ptx_push_str(out, ptx_header_target())
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, ptx_header_address_size())
    out = ptx_push_str(out, "\n\n")
    out
}

fn ptx_emit_vec_add_signature(
    buf: PtxBuf,
    kernel_name: string,
    param_a: string,
    param_b: string,
    param_c: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".visible .entry ")
    out = ptx_push_str(out, kernel_name)
    out = ptx_push_str(out, "(\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_a)
    out = ptx_push_str(out, ",\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_b)
    out = ptx_push_str(out, ",\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_c)
    out = ptx_push_str(out, "\n)\n")
    out
}

fn ptx_emit_vec_add_reg_decl(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "{\n")
    out = ptx_push_str(out, "    .reg .pred %p<2>;\n")
    out = ptx_push_str(out, "    .reg .b32 %r<3>;\n")
    out = ptx_push_str(out, "    .reg .b64 %rd<9>;\n")
    out = ptx_push_str(out, "    .reg .f32 %f<4>;\n\n")
    out
}

fn ptx_emit_vec_add_body(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_binary2(out, ptx_opcode_mov_u32(), "%r1", "%tid.x")
    // NOTE: Keep behavior identical to the current phase-0 reference by retaining the
    // exact source shape and register allocation.
    out = ptx_push_binary2(out, ptx_opcode_cvt_u64_u32(), "%rd1", "%r1")
    out = ptx_push_binary3(out, ptx_opcode_mul_lo_u64(), "%rd2", "%rd1", "4")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd3", "param_a")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd4", "param_b")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd5", "param_c")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd6", "%rd3", "%rd2")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd7", "%rd4", "%rd2")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd8", "%rd5", "%rd2")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_global_f32(), "%f1", "%rd6")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_global_f32(), "%f2", "%rd7")
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), "%f3", "%f1", "%f2")
    out = ptx_push_store_mem(out, ptx_opcode_st_global_f32(), "%rd8", "%f3")
    out = ptx_push_ret(out)
    out = ptx_push_str(out, "}\n")
    out
}

fn ptx_emit_vec3_f32_add(
    buf: PtxBuf,
    out0: string,
    in0_0: string,
    in0_1: string,
    out1: string,
    in1_0: string,
    in1_1: string,
    out2: string,
    in2_0: string,
    in2_1: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out0, in0_0, in0_1)
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out1, in1_0, in1_1)
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out2, in2_0, in2_1)
    out
}

fn ptx_emit_demo_vec_add() -> PtxBuf with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_emit_header(b)
    b = ptx_emit_vec_add_signature(b, "vec_add", "param_a", "param_b", "param_c")
    b = ptx_emit_vec_add_reg_decl(b)
    b = ptx_emit_vec_add_body(b)
    b
}
