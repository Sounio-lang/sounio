// Phase 4: FMA emitter (4-operand: dst = a * b + c)
pub fn ptx_push_fma(
    buf: PtxBuf,
    opcode: string,
    dst: string,
    src_a: string,
    src_b: string,
    src_c: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src_a)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src_b)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src_c)
    out = ptx_push_str(out, ";\n")
    out
}

// Phase 4: Special register move (ctaid.x, ntid.x, etc.)
pub fn ptx_push_mov_special(
    buf: PtxBuf,
    special: string,
    axis: string,
    dst: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    mov.u32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", %")
    out = ptx_push_str(out, special)
    out = ptx_push_str(out, ".")
    out = ptx_push_str(out, axis)
    out = ptx_push_str(out, ";\n")
    out
}

// Phase 4: Add immediate (reg + immediate constant)
pub fn ptx_push_add_imm(
    buf: PtxBuf,
    opcode: string,
    dst: string,
    src: string,
    imm: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ")
    out = ptx_push_str(out, opcode)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, imm)
    out = ptx_push_str(out, ";\n")
    out
}

pub fn ptx_emit_header(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".version ")
    out = ptx_push_str(out, ptx_header_version())
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, ".target ")
    out = ptx_push_str(out, ptx_header_target())
    out = ptx_push_str(out, "\n")
    out = ptx_push_str(out, ptx_header_address_size())
    out = ptx_push_str(out, "\n\n")
    out
}

pub fn ptx_emit_dgx_sm121_header(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".version 9.0\n")
    out = ptx_push_str(out, ".target sm_121\n")
    out = ptx_push_str(out, ptx_header_address_size())
    out = ptx_push_str(out, "\n\n")
    out
}

pub fn ptx_emit_vec_add_signature(
    buf: PtxBuf,
    kernel_name: string,
    param_a: string,
    param_b: string,
    param_c: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, ".visible .entry ")
    out = ptx_push_str(out, kernel_name)
    out = ptx_push_str(out, "(\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_a)
    out = ptx_push_str(out, ",\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_b)
    out = ptx_push_str(out, ",\n")
    out = ptx_push_str(out, "    .param .u64 ")
    out = ptx_push_str(out, param_c)
    out = ptx_push_str(out, "\n)\n")
    out
}

pub fn ptx_emit_vec_add_reg_decl(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "{\n")
    out = ptx_push_str(out, "    .reg .pred %p<2>;\n")
    out = ptx_push_str(out, "    .reg .b32 %r<5>;\n")
    out = ptx_push_str(out, "    .reg .b64 %rd<9>;\n")
    out = ptx_push_str(out, "    .reg .f32 %f<4>;\n\n")
    out
}

pub fn ptx_emit_vec_add_body(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_binary2(out, ptx_opcode_mov_u32(), "%r1", "%tid.x")
    out = ptx_push_binary2(out, ptx_opcode_mov_u32(), "%r2", "%ctaid.x")
    out = ptx_push_binary2(out, ptx_opcode_mov_u32(), "%r3", "%ntid.x")
    out = ptx_push_str(out, "    mad.lo.u32 %r1, %r2, %r3, %r1;\n")
    out = ptx_push_binary2(out, ptx_opcode_cvt_u64_u32(), "%rd1", "%r1")
    out = ptx_push_binary3(out, ptx_opcode_mul_lo_u64(), "%rd2", "%rd1", "4")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd3", "param_a")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd4", "param_b")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_param_u64(), "%rd5", "param_c")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd6", "%rd3", "%rd2")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd7", "%rd4", "%rd2")
    out = ptx_push_binary3(out, ptx_opcode_add_u64(), "%rd8", "%rd5", "%rd2")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_global_f32(), "%f1", "%rd6")
    out = ptx_push_binary_mem2(out, ptx_opcode_ld_global_f32(), "%f2", "%rd7")
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), "%f3", "%f1", "%f2")
    out = ptx_push_store_mem(out, ptx_opcode_st_global_f32(), "%rd8", "%f3")
    out = ptx_push_ret(out)
    out = ptx_push_str(out, "}\n")
    out
}

pub fn ptx_emit_vec3_f32_add(
    buf: PtxBuf,
    out0: string,
    in0_0: string,
    in0_1: string,
    out1: string,
    in1_0: string,
    in1_1: string,
    out2: string,
    in2_0: string,
    in2_1: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out0, in0_0, in0_1)
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out1, in1_0, in1_1)
    out = ptx_push_binary3(out, ptx_opcode_add_f32(), out2, in2_0, in2_1)
    out
}

// Append one PtxBuf to another. Used to concatenate multiple kernel PTX outputs.
pub fn ptx_buf_append(dst: PtxBuf, src: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.len {
        if out.len < 65536 {
            out.data[out.len as usize] = src.data[i as usize]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// Print a PtxBuf to stdout.
pub fn ptx_buf_print(buf: PtxBuf) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.len {
        print_char(buf.data[i as usize] as i64)
        i = i + 1
    }
}

pub fn ptx_emit_demo_vec_add() -> PtxBuf with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_emit_header(b)
    b = ptx_emit_vec_add_signature(b, "vec_add", "param_a", "param_b", "param_c")
    b = ptx_emit_vec_add_reg_decl(b)
    b = ptx_emit_vec_add_body(b)
    b
}

pub fn ptx_emit_epistemic_dual_output_f32() -> PtxBuf with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_emit_header(b)
    b = ptx_push_str(b, ".visible .entry epistemic_dual_output_f32(\n")
    b = ptx_push_str(b, "    .param .u64 param_a_value,\n")
    b = ptx_push_str(b, "    .param .u64 param_b_value,\n")
    b = ptx_push_str(b, "    .param .u64 param_a_eps,\n")
    b = ptx_push_str(b, "    .param .u64 param_b_eps,\n")
    b = ptx_push_str(b, "    .param .u64 param_a_valid,\n")
    b = ptx_push_str(b, "    .param .u64 param_b_valid,\n")
    b = ptx_push_str(b, "    .param .u64 param_out_value,\n")
    b = ptx_push_str(b, "    .param .u64 param_out_eps,\n")
    b = ptx_push_str(b, "    .param .u64 param_out_valid,\n")
    b = ptx_push_str(b, "    .param .u64 param_out_prov\n")
    b = ptx_push_str(b, ")\n")
    b = ptx_push_str(b, "{\n")
    b = ptx_push_str(b, "    .reg .pred %p<2>;\n")
    b = ptx_push_str(b, "    .reg .b32 %r<12>;\n")
    b = ptx_push_str(b, "    .reg .b64 %rd<21>;\n")
    b = ptx_push_str(b, "    .reg .f32 %f<8>;\n\n")
    b = ptx_push_str(b, "    mov.u32 %r1, %tid.x;\n")
    b = ptx_push_str(b, "    mov.u32 %r6, %ctaid.x;\n")
    b = ptx_push_str(b, "    mov.u32 %r7, %ntid.x;\n")
    b = ptx_push_str(b, "    mad.lo.u32 %r1, %r6, %r7, %r1;\n")
    b = ptx_push_str(b, "    cvt.u64.u32 %rd1, %r1;\n")
    b = ptx_push_str(b, "    mul.lo.u64 %rd2, %rd1, 4;\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd3, [param_a_value];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd4, [param_b_value];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd5, [param_a_eps];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd6, [param_b_eps];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd7, [param_a_valid];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd8, [param_b_valid];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd9, [param_out_value];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd10, [param_out_eps];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd11, [param_out_valid];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd20, [param_out_prov];\n")
    b = ptx_push_str(b, "    add.u64 %rd12, %rd3, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd13, %rd4, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd14, %rd5, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd15, %rd6, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd16, %rd7, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd17, %rd8, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd18, %rd9, %rd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd19, %rd10, %rd2;\n")
    b = ptx_push_str(b, "    ld.global.f32 %f1, [%rd12];\n")
    b = ptx_push_str(b, "    ld.global.f32 %f2, [%rd13];\n")
    b = ptx_push_str(b, "    ld.global.f32 %f3, [%rd14];\n")
    b = ptx_push_str(b, "    ld.global.f32 %f4, [%rd15];\n")
    b = ptx_push_str(b, "    ld.global.u32 %r2, [%rd16];\n")
    b = ptx_push_str(b, "    ld.global.u32 %r3, [%rd17];\n")
    b = ptx_push_str(b, "    add.f32 %f5, %f1, %f2;\n")
    b = ptx_push_str(b, "    mul.rn.f32 %f6, %f3, %f3;\n")
    b = ptx_push_str(b, "    mul.rn.f32 %f7, %f4, %f4;\n")
    b = ptx_push_str(b, "    add.f32 %f6, %f6, %f7;\n")
    b = ptx_push_str(b, "    and.b32 %r4, %r2, %r3;\n")
    b = ptx_push_str(b, "    xor.b32 %r5, %r1, 305419896;\n")
    b = ptx_push_str(b, "    xor.b32 %r5, %r5, %r4;\n")
    b = ptx_push_str(b, "    st.global.f32 [%rd18], %f5;\n")
    b = ptx_push_str(b, "    st.global.f32 [%rd19], %f6;\n")
    b = ptx_push_str(b, "    add.u64 %rd12, %rd11, %rd2;\n")
    b = ptx_push_str(b, "    st.global.u32 [%rd12], %r4;\n")
    b = ptx_push_str(b, "    add.u64 %rd12, %rd20, %rd2;\n")
    b = ptx_push_str(b, "    st.global.u32 [%rd12], %r5;\n")
    b = ptx_push_str(b, "    ret;\n")
    b = ptx_push_str(b, "}\n")
    b
}

// ── Extended kernel emitters (Phase 2) ──────────────────────────────

pub fn ptx_emit_vec_sub_f32() -> PtxBuf with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_emit_header(b)
    b = ptx_emit_vec_add_signature(b, "vec_sub", "param_a", "param_b", "param_c")
    b = ptx_emit_vec_add_reg_decl(b)
    b = ptx_push_binary2(b, ptx_opcode_mov_u32(), "%r1", "%tid.x")
    b = ptx_push_binary2(b, ptx_opcode_cvt_u64_u32(), "%rd1", "%r1")
    b = ptx_push_binary3(b, ptx_opcode_mul_lo_u64(), "%rd2", "%rd1", "4")
    b = ptx_push_binary_mem2(b, ptx_opcode_ld_param_u64(), "%rd3", "param_a")
    b = ptx_push_binary_mem2(b, ptx_opcode_ld_param_u64(), "%rd4", "param_b")
    b = ptx_push_binary_mem2(b, ptx_opcode_ld_param_u64(), "%rd5", "param_c")
    b = ptx_push_binary3(b, ptx_opcode_add_u64(), "%rd6", "%rd3", "%rd2")
    b = ptx_push_binary3(b, ptx_opcode_add_u64(), "%rd7", "%rd4", "%rd2")
    b = ptx_push_binary3(b, ptx_opcode_add_u64(), "%rd8", "%rd5", "%rd2")
    b = ptx_push_binary_mem2(b, ptx_opcode_ld_global_f32(), "%f1", "%rd6")
    b = ptx_push_binary_mem2(b, ptx_opcode_ld_global_f32(), "%f2", "%rd7")
    b = ptx_push_binary3(b, ptx_opcode_sub_f32(), "%f3", "%f1", "%f2")
    b = ptx_push_store_mem(b, ptx_opcode_st_global_f32(), "%rd8", "%f3")
    b = ptx_push_ret(b)
    b = ptx_push_str(b, "}\n")
    b
}

