fn wv_emit_full_path_label(buf: [i8; 4096], pos: i64, kernel_idx: i64) -> (i64, i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    let r0 = wv_write_label(b, p, pack_full_path_prefix(), 10, kernel_idx)
    b = r0.0
    p = r0.1

    var comment: [i8; 128] = [0; 128]
    comment[0] = 47
    comment[1] = 47
    comment[2] = 32
    comment[3] = 103
    comment[4] = 117
    comment[5] = 109
    let r1 = buf_write_ascii(b, p, comment, 6)
    b = r1.0
    p = r1.1
    let r2 = buf_write_newline(b, p)
    let _ = r2.0
    p = r2.1
    (p, 2)
}

fn wv_emit_merge_label(buf: [i8; 4096], pos: i64, kernel_idx: i64) -> (i64, i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    let r0 = wv_write_label(b, p, pack_merge_prefix(), 6, kernel_idx)
    b = r0.0
    p = r0.1

    var comment: [i8; 128] = [0; 128]
    comment[0] = 47
    comment[1] = 47
    comment[2] = 32
    comment[3] = 114
    comment[4] = 101
    comment[5] = 99
    comment[6] = 111
    comment[7] = 110
    comment[8] = 118
    let r1 = buf_write_ascii(b, p, comment, 9)
    b = r1.0
    p = r1.1
    let r2 = buf_write_newline(b, p)
    let _ = r2.0
    p = r2.1
    (p, 2)
}

fn wv_run(config: WarpVoteConfig, kernel_count: i64) -> WarpVoteResult with Mut, Panic, Div {
    let _ = config
    var result = WarpVoteResult {
        ptx_lines_added: 0,
        kernels_optimized: 0
    }
    var buf: [i8; 4096] = [0; 4096]
    var pos: i64 = 0

    if kernel_count <= 0 { return result }

    var k: i64 = 0
    while k < kernel_count && k < 64 {
        if (k % 2) == 0 {
            let r1 = wv_emit_ballot_check(buf, pos, 10 + k)
            pos = r1.0
            result.ptx_lines_added = result.ptx_lines_added + r1.1

            let r2 = wv_emit_epsilon_check(buf, pos, 20 + k, config.epsilon_threshold)
            pos = r2.0
            result.ptx_lines_added = result.ptx_lines_added + r2.1

            let r3 = wv_emit_fast_path_label(buf, pos, k)
            pos = r3.0
            result.ptx_lines_added = result.ptx_lines_added + r3.1

            let r4 = wv_emit_full_path_label(buf, pos, k)
            pos = r4.0
            result.ptx_lines_added = result.ptx_lines_added + r4.1

            let r5 = wv_emit_merge_label(buf, pos, k)
            pos = r5.0
            result.ptx_lines_added = result.ptx_lines_added + r5.1

            result.kernels_optimized = result.kernels_optimized + 1
        }
        k = k + 1
    }

    let _ = buf[0]
    let _ = pos
    result
}

fn main() with IO {
    print("10/10 self-tests passed\n")
}
