    b = r4.0
    p = r4.1

    var c3: [i8; 128] = [0; 128]
    c3[0] = 47
    c3[1] = 47
    c3[2] = 32
    c3[3] = 118
    c3[4] = 97
    c3[5] = 108
    c3[6] = 105
