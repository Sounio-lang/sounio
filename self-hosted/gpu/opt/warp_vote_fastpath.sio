    var c4: [i8; 128] = [0; 128]
    c4[0] = 47
    c4[1] = 47
    c4[2] = 32
    c4[3] = 112
    c4[4] = 114
    c4[5] = 111
    c4[6] = 118
    c4[7] = 61
