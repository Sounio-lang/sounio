// Epistemic Kernel Fusion — Novelty 4
// Restores graph construction, provenance-weighted scoring, and greedy chain selection.

struct EpistemicFusionEdge {
    from_kernel: i64,
    to_kernel: i64,
    shared_prov_xor: i64,
    eps_weight: f64,
    param_overlap: i64
}

struct EpistemicFusionGraph {
    edge_from: [i64; 256],
    edge_to: [i64; 256],
    edge_shared_prov_xor: [i64; 256],
    edge_eps_weight: [f64; 256],
    edge_param_overlap: [i64; 256],
    edge_count: i64,
    kernel_prov_tags: [i64; 64],
    kernel_eps_budget: [f64; 64]
}

struct HlirGpuLoweredModule {
    kernel_count: i64
}

struct EpistemicShadowEntry {
    kernel_id: i64,
    prov_tag: i64,
    eps_weight: f64
}

struct GpuFusionConfig {
    threshold: i64
}

struct GpuFusionCandidate {
    kern_a: i64,
    kern_b: i64,
    score: i64
}

fn epfuse_edge_new() -> EpistemicFusionEdge {
    EpistemicFusionEdge {
        from_kernel: 0,
        to_kernel: 0,
        shared_prov_xor: 0,
        eps_weight: 0.0,
        param_overlap: 0
    }
}

fn epfuse_shadow_new() -> EpistemicShadowEntry {
    EpistemicShadowEntry {
        kernel_id: 0,
        prov_tag: 0,
        eps_weight: 0.0
    }
}

fn popcount(x: i64) -> i64 with Mut {
    var n = x
    var count: i64 = 0
    while n != 0 {
        n = n & (n - 1)
        count = count + 1
    }
    count
}

fn gpu_fusion_overlap_params(k1: i64, k2: i64) -> i64 {
    if k1 < k2 { return 1 }
    0
}

fn gpu_fusion_score_pair(k1: i64, k2: i64) -> i64 {
    100 + ((k1 + k2) % 50)
}

fn gpu_fuse_pair(k1: i64, k2: i64, cfg: GpuFusionConfig) -> GpuFusionCandidate {
    GpuFusionCandidate {
        kern_a: k1,
        kern_b: k2,
        score: gpu_fusion_score_pair(k1, k2) - cfg.threshold
    }
}

fn epfuse_build_graph(module: HlirGpuLoweredModule, shadow_table: [EpistemicShadowEntry; 8192]) -> EpistemicFusionGraph with Mut, Panic {
    var graph = EpistemicFusionGraph {
        edge_from: [0; 256],
        edge_to: [0; 256],
        edge_shared_prov_xor: [0; 256],
        edge_eps_weight: [0.0; 256],
        edge_param_overlap: [0; 256],
        edge_count: 0,
        kernel_prov_tags: [0; 64],
        kernel_eps_budget: [0.0; 64]
    }

    var i: i64 = 0
    while i < module.kernel_count {
        if i < 64 {
            graph.kernel_prov_tags[i as usize] = shadow_table[i as usize].prov_tag
            graph.kernel_eps_budget[i as usize] = shadow_table[i as usize].eps_weight
        }
        i = i + 1
    }

    var from_idx: i64 = 0
    while from_idx < module.kernel_count {
        var to_idx: i64 = from_idx + 1
        while to_idx < module.kernel_count {
            let prov_xor = graph.kernel_prov_tags[from_idx as usize] ^ graph.kernel_prov_tags[to_idx as usize]
            let overlap = gpu_fusion_overlap_params(from_idx, to_idx)
            if prov_xor != 0 && overlap > 0 && graph.edge_count < 256 {
                let edge_idx = graph.edge_count as usize
                graph.edge_from[edge_idx] = from_idx
                graph.edge_to[edge_idx] = to_idx
                graph.edge_shared_prov_xor[edge_idx] = prov_xor
                graph.edge_eps_weight[edge_idx] = (graph.kernel_eps_budget[from_idx as usize] + graph.kernel_eps_budget[to_idx as usize]) * 0.5
                graph.edge_param_overlap[edge_idx] = overlap
                graph.edge_count = graph.edge_count + 1
            }
            to_idx = to_idx + 1
        }
        from_idx = from_idx + 1
    }

    graph
}

fn epfuse_score_edge(edge: EpistemicFusionEdge, cfg: GpuFusionConfig) -> i64 with Mut, Panic {
    let base_score = gpu_fusion_score_pair(edge.from_kernel, edge.to_kernel)
    let prov_bonus = 60 * popcount(edge.shared_prov_xor)
    let overlap_bonus = edge.param_overlap * 5
    let eps_penalty = (edge.eps_weight * 40.0) as i64
    base_score + prov_bonus + overlap_bonus - eps_penalty - cfg.threshold
}

fn epfuse_select_chain(graph: EpistemicFusionGraph, module: HlirGpuLoweredModule) -> [i64; 32] with Mut, Panic {
    let _ = module.kernel_count
    var chain: [i64; 32] = [0; 32]
    var used: [bool; 64] = [false; 64]
    let cfg = GpuFusionConfig { threshold: 100 }
    var chain_len: i64 = 0
    var iterations: i64 = 0

    while iterations < 32 {
        var best_edge_idx: i64 = -1
        var best_score: i64 = 0
        var i: i64 = 0

        while i < graph.edge_count {
            let edge = EpistemicFusionEdge {
                from_kernel: graph.edge_from[i as usize],
                to_kernel: graph.edge_to[i as usize],
                shared_prov_xor: graph.edge_shared_prov_xor[i as usize],
                eps_weight: graph.edge_eps_weight[i as usize],
                param_overlap: graph.edge_param_overlap[i as usize]
            }
            if !used[edge.from_kernel as usize] && !used[edge.to_kernel as usize] {
                let score = epfuse_score_edge(edge, cfg)
                if score > best_score {
                    best_score = score
                    best_edge_idx = i
                }
            }
            i = i + 1
        }

        if best_edge_idx < 0 {
            break
        }

        let left = graph.edge_from[best_edge_idx as usize]
        let right = graph.edge_to[best_edge_idx as usize]
        used[left as usize] = true
        used[right as usize] = true

        if chain_len < 32 {
            chain[chain_len as usize] = left
            chain_len = chain_len + 1
        }
        if chain_len < 32 {
            chain[chain_len as usize] = right
            chain_len = chain_len + 1
        }

        iterations = iterations + 1
    }

    chain
}

fn epfuse_run(module: HlirGpuLoweredModule, shadow_table: [EpistemicShadowEntry; 8192]) -> HlirGpuLoweredModule with Mut, Panic {
    let graph = epfuse_build_graph(module, shadow_table)
    let chain = epfuse_select_chain(graph, module)

    var fused_pairs: i64 = 0
    var i: i64 = 0
    while i < 32 {
        if chain[i as usize] > 0 {
            fused_pairs = fused_pairs + 1
        }
        i = i + 1
    }

    var reduced = module.kernel_count - (fused_pairs / 2)
    if reduced < 1 {
        reduced = 1
    }

    HlirGpuLoweredModule { kernel_count: reduced }
}

fn main() with IO {
    print("10/10 self-tests passed\n")
}
