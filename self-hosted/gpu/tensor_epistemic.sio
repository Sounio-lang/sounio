// self-hosted::gpu::tensor_epistemic — Tensor/matrix PTX codegen with epistemic uncertainty
//
// Emits PTX for GEMM, reductions, WMMA, softmax, and layer-norm, with
// parallel "shadow" registers tracking uncertainty (epsilon) at every step.
//
// Targets: sm_80+ (Ampere and above). Tensor core WMMA paths require sm_70+.
//
// Uncertainty propagation conventions:
//   GEMM (scalar):   ε_c = sqrt(k * (a²·ε_b² + b²·ε_a²))   [quadrature]
//              alt:  ε_c = max(a_eps, b_eps)                 [max-propagation]
//   Warp sum:        ε_sum = eps * sqrt(32) ≈ eps * 5.657
//   Softmax:         ε_out_i = softmax_i * (1 - softmax_i) * ε_in  [Jacobian]
//   LayerNorm:       ε_out = chain rule through mean, var, norm steps
//
// Design: all state is threaded through EpistemicTensorState; no globals.
// Helpers precede all callers (no forward references).

// ── RegName ──────────────────────────────────────────────────────────

struct RegName {
    buf: [i8; 32],
    len: i64,
}

fn reg_name_empty() -> RegName {
    RegName { buf: [0; 32], len: 0 }
}

// ── TensorEpistemicConfig ─────────────────────────────────────────────

struct TensorEpistemicConfig {
    sm_version: i64,          // 80, 86, 89, 90, 100
    use_tensor_cores: bool,   // wmma/mma ops when sm >= 70
    epistemic_enabled: bool,
    quadrature_mode: bool,    // true = quadrature, false = max-propagation
    confidence_threshold: f32,
    warp_size: i64,           // always 32
}

fn tensor_epistemic_config_default() -> TensorEpistemicConfig {
    TensorEpistemicConfig {
        sm_version: 80,
        use_tensor_cores: true,
        epistemic_enabled: true,
        quadrature_mode: true,
        confidence_threshold: 0.05,
        warp_size: 32,
    }
}

// ── MatrixDims ────────────────────────────────────────────────────────

struct MatrixDims {
    m: i64,
    n: i64,
    k: i64,
}

// ── EpistemicTensorState ──────────────────────────────────────────────

struct EpistemicTensorState {
    buf: [i8; 65536],
    buf_len: i64,
    reg_counter: i64,
    pred_counter: i64,
    config: TensorEpistemicConfig,
}

// ════════════════════════════════════════════════════════════════════
// Low-level helpers — must precede all callers
// ════════════════════════════════════════════════════════════════════

// Append a single byte to state buffer (bounds-guarded).
fn ets_append_byte(s: EpistemicTensorState, b: i8) -> EpistemicTensorState with Mut, Panic {
    var out = s
    if out.buf_len >= 0 && out.buf_len < 65536 {
        out.buf[out.buf_len as usize] = b
        out.buf_len = out.buf_len + 1
    }
    out
}

// Write decimal string representation of v into buf; returns number of chars written.
fn i64_to_str(v: i64, buf: &![i8; 32]) -> i64 with Mut, Panic, Div {
    if v == 0 {
        buf[0 as usize] = 48  // '0'
        return 1
    }
    var tmp: [i8; 32] = [0; 32]
    var neg: bool = false
    var n = v
    if n < 0 {
        neg = true
        n = 0 - n
    }
    var pos: i64 = 0
    while n > 0 {
        let digit = n - (n / 10) * 10
        tmp[pos as usize] = (48 + digit) as i8
        n = n / 10
        pos = pos + 1
    }
    if neg {
        tmp[pos as usize] = 45  // '-'
        pos = pos + 1
    }
    // Reverse into buf
    var i: i64 = 0
    while i < pos {
        buf[(pos - 1 - i) as usize] = tmp[i as usize]
        i = i + 1
    }
    pos
}

// Copy at most 256 chars from src into state buffer.
fn ets_append_str(s: EpistemicTensorState, src: [i8; 256], src_len: i64) -> EpistemicTensorState with Mut, Panic, Div {
    var out = s
    var i: i64 = 0
    while i < src_len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = src[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// ── Inline literal appenders (for string constants) ──────────────────
//
// Sounio does not have string literals in the target self-hosted sense,
// so we build short inline [i8;256] arrays and use ets_append_str.
// These small helpers encode common PTX snippets as character arrays.

fn ets_put_cstr(s: EpistemicTensorState, chars: [i8; 256], n: i64) -> EpistemicTensorState with Mut, Panic, Div {
    ets_append_str(s, chars, n)
}

// Append an i64 as decimal digits directly to state buffer.
fn ets_append_i64(s: EpistemicTensorState, v: i64) -> EpistemicTensorState with Mut, Panic, Div {
    var out = s
    var tmp: [i8; 32] = [0; 32]
    let len = i64_to_str(v, &!tmp)
    var i: i64 = 0
    while i < len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = tmp[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// Append a newline.
fn ets_nl(s: EpistemicTensorState) -> EpistemicTensorState with Mut, Panic {
    ets_append_byte(s, 10)
}

// ── ets_emit_line ─────────────────────────────────────────────────────
// Append a 256-byte line buffer (up to len chars) followed by '\n'.
fn ets_emit_line(s: EpistemicTensorState, line: [i8; 256], len: i64) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_append_str(s, line, len)
    out = ets_append_byte(out, 10)
    out
}

// ── Literal line helpers ─────────────────────────────────────────────
// Emit a fixed short string literal (≤64 chars) as a PTX line.
// We encode the string as a [i8;256] array each time.
// To avoid repeating this boilerplate, we build a small helper.

fn make_256(chars: [i8; 64], n: i64) -> ([i8; 256], i64) {
    var out: [i8; 256] = [0; 256]
    var i: i64 = 0
    while i < n && i < 64 {
        out[i as usize] = chars[i as usize]
        i = i + 1
    }
    (out, n)
}

// ── ets_new ───────────────────────────────────────────────────────────

fn ets_new(cfg: TensorEpistemicConfig) -> EpistemicTensorState {
    EpistemicTensorState {
        buf: [0; 65536],
        buf_len: 0,
        reg_counter: 0,
        pred_counter: 0,
        config: cfg,
    }
}

// ── ets_reg_name_str ──────────────────────────────────────────────────

fn ets_reg_name_str(r: RegName) -> [i8; 32] {
    r.buf
}

// ── ets_alloc_reg ─────────────────────────────────────────────────────
// prefix: 'r'=114 → %r<n>, 'f'=102 → %f<n>, 'p'=112 → %p<n>
// Uses reg_counter for all non-pred prefixes.
fn ets_alloc_reg(s: EpistemicTensorState, prefix: i8) -> (EpistemicTensorState, RegName) with Mut, Panic, Div {
    var out = s
    let idx = out.reg_counter
    out.reg_counter = idx + 1

    var r: RegName = reg_name_empty()
    // '%'=37
    r.buf[0 as usize] = 37
    r.buf[1 as usize] = prefix
    var tmp: [i8; 32] = [0; 32]
    let dlen = i64_to_str(idx, &!tmp)
    var i: i64 = 0
    while i < dlen {
        r.buf[(2 + i) as usize] = tmp[i as usize]
        i = i + 1
    }
    r.len = 2 + dlen
    (out, r)
}

// ── ets_alloc_pred ────────────────────────────────────────────────────
// Allocates %p<n> using pred_counter.
fn ets_alloc_pred(s: EpistemicTensorState) -> (EpistemicTensorState, RegName) with Mut, Panic, Div {
    var out = s
    let idx = out.pred_counter
    out.pred_counter = idx + 1

    var r: RegName = reg_name_empty()
    r.buf[0 as usize] = 37   // '%'
    r.buf[1 as usize] = 112  // 'p'
    var tmp: [i8; 32] = [0; 32]
    let dlen = i64_to_str(idx, &!tmp)
    var i: i64 = 0
    while i < dlen {
        r.buf[(2 + i) as usize] = tmp[i as usize]
        i = i + 1
    }
    r.len = 2 + dlen
    (out, r)
}

// ── ets_emit_section ──────────────────────────────────────────────────
// Emits: "    // === <label> ==="

fn ets_emit_section(s: EpistemicTensorState, label: [i8; 64], label_len: i64) -> EpistemicTensorState with Mut, Panic, Div {
    // "    // === "
    var out = s
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 47)   // /
    out = ets_append_byte(out, 47)   // /
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 61)   // =
    out = ets_append_byte(out, 61)
    out = ets_append_byte(out, 61)
    out = ets_append_byte(out, 32)
    // label
    var i: i64 = 0
    while i < label_len {
        out = ets_append_byte(out, label[i as usize])
        i = i + 1
    }
    // " ==="
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 61)
    out = ets_append_byte(out, 61)
    out = ets_append_byte(out, 61)
    out = ets_nl(out)
    out
}

// ── RegName → buf append helper ───────────────────────────────────────

fn ets_append_reg(s: EpistemicTensorState, r: RegName) -> EpistemicTensorState with Mut, Panic, Div {
    var out = s
    var i: i64 = 0
    while i < r.len {
        out = ets_append_byte(out, r.buf[i as usize])
        i = i + 1
    }
    out
}

// ── Emit: "    <opcode> <dst>, <src1>, <src2>;\n" ────────────────────

// Append a short ASCII literal (≤32 chars) encoded in a [i8;32].
fn ets_put_s32(s: EpistemicTensorState, lit: [i8; 32], n: i64) -> EpistemicTensorState with Mut, Panic, Div {
    var out = s
    var i: i64 = 0
    while i < n {
        out = ets_append_byte(out, lit[i as usize])
        i = i + 1
    }
    out
}

// Indent (4 spaces)
fn ets_indent(s: EpistemicTensorState) -> EpistemicTensorState with Mut, Panic {
    var out = s
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out = ets_append_byte(out, 32)
    out
}

// ── Common PTX opcode emitters ────────────────────────────────────────
// Each copies a literal opcode+args pattern character-by-character.
// We avoid string allocation by writing directly into the buffer.

// Emit: "    fma.rn.f32 <dst>, <a>, <b>, <c>;\n"
fn ets_emit_fma_f32(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName, c: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    // "    fma.rn.f32 "
    var out = ets_indent(s)
    // f=102 m=109 a=97 .=46 r=114 n=110 .=46 f=102 3=51 2=50 ' '=32
    let opcode: [i8; 16] = [102,109,97,46,114,110,46,102,51,50,32,0,0,0,0,0]
    var i: i64 = 0
    while i < 11 { out = ets_append_byte(out, opcode[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, c)
    out = ets_append_byte(out, 59)  // ;
    out = ets_nl(out)
    out
}

// Emit: "    mul.f32 <dst>, <a>, <b>;\n"
fn ets_emit_mul_f32(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "mul.f32 "  m=109 u=117 l=108 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 8] = [109,117,108,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    add.f32 <dst>, <a>, <b>;\n"
fn ets_emit_add_f32(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "add.f32 " a=97 d=100 d=100 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 8] = [97,100,100,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    sqrt.approx.f32 <dst>, <src>;\n"
fn ets_emit_sqrt_f32(
    s: EpistemicTensorState,
    dst: RegName, src: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "sqrt.approx.f32 "
    // s=115 q=113 r=114 t=116 .=46 a=97 p=112 p=112 r=114 o=111 x=120 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 16] = [115,113,114,116,46,97,112,112,114,111,120,46,102,51,50,32]
    var i: i64 = 0
    while i < 16 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, src)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    mov.f32 <dst>, 0f00000000;\n"  (move float-zero)
fn ets_emit_mov_f32_zero(
    s: EpistemicTensorState,
    dst: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "mov.f32 " m=109 o=111 v=118 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 8] = [109,111,118,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    // ", 0f00000000;"
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    // 0=48 f=102 0=48 0=48 0=48 0=48 0=48 0=48 0=48 0=48
    let hex: [i8; 12] = [48,102,48,48,48,48,48,48,48,48,59,10]
    i = 0
    while i < 12 { out = ets_append_byte(out, hex[i as usize]); i = i + 1 }
    out
}

// Emit: "    mov.f32 <dst>, <src>;\n"
fn ets_emit_mov_f32(
    s: EpistemicTensorState,
    dst: RegName, src: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    let op: [i8; 8] = [109,111,118,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, src)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    shfl.sync.down.b32 <dst>, <src>, <offset_literal>, 0xffffffff;\n"
fn ets_emit_shfl_down(
    s: EpistemicTensorState,
    dst: RegName, src: RegName, offset: i64
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "shfl.sync.down.b32 "
    // s=115 h=104 f=102 l=108 .=46 s=115 y=121 n=110 c=99 .=46 d=100 o=111 w=119 n=110 .=46 b=98 3=51 2=50 ' '=32
    let op1: [i8; 12] = [115,104,102,108,46,115,121,110,99,46,100,111]
    let op2: [i8; 8] = [119,110,46,98,51,50,32,0]
    var i: i64 = 0
    while i < 12 { out = ets_append_byte(out, op1[i as usize]); i = i + 1 }
    i = 0
    while i < 7 { out = ets_append_byte(out, op2[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, src)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_i64(out, offset)
    // ", 0xffffffff;"
    // ,=44 ' '=32 0=48 x=120 f=102 f=102 f=102 f=102 f=102 f=102 f=102 f=102 ;=59
    let tail: [i8; 14] = [44,32,48,120,102,102,102,102,102,102,102,102,59,10]
    i = 0
    while i < 14 { out = ets_append_byte(out, tail[i as usize]); i = i + 1 }
    out
}

// Emit: "    max.f32 <dst>, <a>, <b>;\n"
fn ets_emit_max_f32(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "max.f32 " m=109 a=97 x=120 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 8] = [109,97,120,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    setp.eq.s32 <p>, 1, 1;\n"  (set pred to true)
fn ets_emit_setp_true(
    s: EpistemicTensorState,
    p: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "setp.eq.s32 " s=115 e=101 t=116 p=112 .=46 e=101 q=113 .=46 s=115 3=51 2=50 ' '=32
    let op: [i8; 12] = [115,101,116,112,46,101,113,46,115,51,50,32]
    var i: i64 = 0
    while i < 12 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, p)
    // ", 1, 1;\n"
    let tail: [i8; 8] = [44,32,49,44,32,49,59,10]
    i = 0
    while i < 8 { out = ets_append_byte(out, tail[i as usize]); i = i + 1 }
    out
}

// Emit: "    and.pred <dst>, <a>, <b>;\n"
fn ets_emit_and_pred(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "and.pred " a=97 n=110 d=100 .=46 p=112 r=114 e=101 d=100 ' '=32
    let op: [i8; 9] = [97,110,100,46,112,114,101,100,32]
    var i: i64 = 0
    while i < 9 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    or.pred <dst>, <a>, <b>;\n"
fn ets_emit_or_pred(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "or.pred " o=111 r=114 .=46 p=112 r=114 e=101 d=100 ' '=32
    let op: [i8; 8] = [111,114,46,112,114,101,100,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    setp.lt.f32 <dst>, <a>, <imm_hex>;\n"
fn ets_emit_setp_lt_f32_imm(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, imm_hex: [i8; 16], imm_len: i64
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "setp.lt.f32 " s=115 e=101 t=116 p=112 .=46 l=108 t=116 .=46 f=102 3=51 2=50 ' '=32
    let op: [i8; 12] = [115,101,116,112,46,108,116,46,102,51,50,32]
    var i: i64 = 0
    while i < 12 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    i = 0
    while i < imm_len { out = ets_append_byte(out, imm_hex[i as usize]); i = i + 1 }
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    bar.sync 0;\n"
fn ets_emit_bar_sync(s: EpistemicTensorState) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "bar.sync 0;"
    let lit: [i8; 12] = [98,97,114,46,115,121,110,99,32,48,59,10]
    var i: i64 = 0
    while i < 12 { out = ets_append_byte(out, lit[i as usize]); i = i + 1 }
    out
}

// Emit: "    mul.f32 <dst>, <a>, <imm_float_hex>;\n"
// imm_float_hex e.g. "0f3F000000" for 0.03125
fn ets_emit_mul_f32_imm(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, imm: [i8; 16], imm_len: i64
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    let op: [i8; 8] = [109,117,108,46,102,51,50,32]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    i = 0
    while i < imm_len { out = ets_append_byte(out, imm[i as usize]); i = i + 1 }
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

// Emit: "    div.approx.f32 <dst>, <a>, <b>;\n"
fn ets_emit_div_f32(
    s: EpistemicTensorState,
    dst: RegName, a: RegName, b: RegName
) -> EpistemicTensorState with Mut, Panic, Div {
    var out = ets_indent(s)
    // "div.approx.f32 " d=100 i=105 v=118 .=46 a=97 p=112 p=112 r=114 o=111 x=120 .=46 f=102 3=51 2=50 ' '=32
    let op1: [i8; 8] = [100,105,118,46,97,112,112,114]
    let op2: [i8; 8] = [111,120,46,102,51,50,32,0]
    var i: i64 = 0
    while i < 8 { out = ets_append_byte(out, op1[i as usize]); i = i + 1 }
    i = 0
    while i < 7 { out = ets_append_byte(out, op2[i as usize]); i = i + 1 }
    out = ets_append_reg(out, dst)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, a)
    out = ets_append_byte(out, 44); out = ets_append_byte(out, 32)
    out = ets_append_reg(out, b)
    out = ets_append_byte(out, 59); out = ets_nl(out)
    out
}

