// GPU Knowledge Vec4 pack/unpack backend witness.
//
// This harness builds a GpuKernelIr directly and lowers it through the
// production gpu_lower_to_ptx path. It proves a narrow backend-IR/PTX contract:
// four f64 lanes are loaded from offsets 0,32,64,96 and stored back to the same
// aggregate layout. It is not a CUDA device-runtime proof and does not exercise
// imported compiler lowering.

use kernel_ir_wmma_lean::*
use lower_to_ptx_wmma_vec4::*

fn load_param(dst: i64, idx: i64) -> GpuOp {
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuLoadParam
    op.dst_reg = dst
    op.param_idx = idx
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    op
}

fn add_offset(dst: i64, base: i64, offset: i64) -> GpuOp {
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuAddImm
    op.dst_reg = dst
    op.lhs_reg = base
    op.rhs_imm = offset
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    op
}

fn load_f64(dst: i64, addr: i64) -> GpuOp {
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = dst
    op.addr_reg = addr
    op.ty = GpuType::GpuF64
    op.dst_ty = GpuType::GpuF64
    op
}

fn store_f64(addr: i64, src: i64) -> GpuOp {
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = addr
    op.src_reg = src
    op.ty = GpuType::GpuF64
    op.dst_ty = GpuType::GpuF64
    op
}

fn ret_op() -> GpuOp {
    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuRet
    op
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let kernel_name = ki_ir_name_from_str("gpu_vec4_pack_unpack", 20)
    let p_in = ki_ir_name_from_str("in_ptr", 6)
    let p_out = ki_ir_name_from_str("out_ptr", 7)

    let op0 = load_param(1, 0)
    let op1 = load_param(2, 1)
    let op2 = load_f64(1, 1)
    let op3 = add_offset(3, 1, 32)
    let op4 = load_f64(2, 3)
    let op5 = add_offset(4, 1, 64)
    let op6 = load_f64(3, 4)
    let op7 = add_offset(5, 1, 96)
    let op8 = load_f64(4, 5)
    let op9 = store_f64(2, 1)
    let op10 = add_offset(6, 2, 32)
    let op11 = store_f64(6, 2)
    let op12 = add_offset(7, 2, 64)
    let op13 = store_f64(7, 3)
    let op14 = add_offset(8, 2, 96)
    let op15 = store_f64(8, 4)
    let op16 = ret_op()

    let buf = gpu_lower_vec4_pack_unpack_ops_to_ptx(
        kernel_name,
        p_in,
        p_out,
        op0,
        op1,
        op2,
        op3,
        op4,
        op5,
        op6,
        op7,
        op8,
        op9,
        op10,
        op11,
        op12,
        op13,
        op14,
        op15,
        op16,
    )
    ptx_buf_print(buf)
    0
}
