// PTX pixel-fill kernel emitter for CUDA-based software rasterization
//
// Emits PTX assembly for a parallel triangle rasterizer kernel.
// Each CUDA thread processes one pixel; barycentric test determines coverage.
//
// Kernel signature (conceptual):
//   rasterize_triangle_kernel(
//       fb_r: u32*, fb_g: u32*, fb_b: u32*,    // framebuffer channels
//       v0x, v0y, v1x, v1y, v2x, v2y: f32,     // triangle vertices
//       r0, g0, b0, r1, g1, b1, r2, g2, b2: f32, // per-vertex colors
//       width: u32, height: u32                  // framebuffer dimensions
//   )
//
// PTX output is 32-bit floating point per the SM_75+ target.

// ============================================================================
// PtxRenderBuf — text buffer for PTX assembly output
// ============================================================================

struct PtxRenderBuf {
    data: [i8; 16384],
    len: i64,
}

struct RenderScene {
    v0x: f64, v0y: f64, v0z: f64, v0r: f64, v0g: f64, v0b: f64,
    v1x: f64, v1y: f64, v1z: f64, v1r: f64, v1g: f64, v1b: f64,
    v2x: f64, v2y: f64, v2z: f64, v2r: f64, v2g: f64, v2b: f64,
    triangle_count: i64,
}

fn render_scene_default() -> RenderScene {
    RenderScene {
        v0x: 0.0, v0y: 0.72, v0z: 0.1, v0r: 1.0, v0g: 0.15, v0b: 0.12,
        v1x: 0.0 - 0.76, v1y: 0.0 - 0.58, v1z: 0.4, v1r: 0.18, v1g: 0.95, v1b: 0.28,
        v2x: 0.76, v2y: 0.0 - 0.58, v2z: 0.2, v2r: 0.1, v2g: 0.35, v2b: 1.0,
        triangle_count: 1,
    }
}

fn prend_buf_new() -> PtxRenderBuf {
    PtxRenderBuf { data: [0; 16384], len: 0 }
}

fn prend_push_byte(buf: PtxRenderBuf, b: i8) -> PtxRenderBuf with Mut, Panic {
    var out = buf
    if out.len < 16384 {
        out.data[out.len] = b
        out.len = out.len + 1
    }
    out
}

fn prend_push_str(buf: PtxRenderBuf, s: string) -> PtxRenderBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = prend_push_byte(out, str_char_at(s, i) as i8)
        i = i + 1
    }
    out
}

fn render_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == 0 { return "0" }
    if n < 0 { return "-" + render_i64_to_string(0 - n) }

    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value = n
    while value > 0 {
        let digit = value % 10
        rev[rev_len] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var out: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        out[i] = rev[rev_len - i - 1]
        i = i + 1
    }
    str_from_bytes(out, rev_len)
}

fn scene_to_milli_i64(v: f64) -> i64 {
    (v * 1000.0) as i64
}

fn prend_push_i64(buf: PtxRenderBuf, value: i64) -> PtxRenderBuf with Mut, Panic, Div, Alloc {
    prend_push_str(buf, render_i64_to_string(value))
}

// ============================================================================
// PTX header + target declaration
// ============================================================================

fn ptx_emit_render_header(buf: PtxRenderBuf) -> PtxRenderBuf with Mut, Panic, Div {
    var b = buf
    b = prend_push_str(b, ".version 7.5\n")
    b = prend_push_str(b, ".target sm_75\n")
    b = prend_push_str(b, ".address_size 64\n\n")
    b
}

fn ptx_emit_scene_constants(buf: PtxRenderBuf, scene: RenderScene) -> PtxRenderBuf with Mut, Panic, Div, Alloc {
    var b = buf
    b = prend_push_str(b, ".visible .const .s32 SCENE_TRIANGLE_COUNT = ")
    b = prend_push_i64(b, scene.triangle_count)
    b = prend_push_str(b, ";\n")

    b = prend_push_str(b, ".visible .const .s32 SCENE_V0X_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0x))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V0Y_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0y))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V0Z_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0z))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V0R_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0r))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V0G_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0g))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V0B_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v0b))
    b = prend_push_str(b, ";\n")

    b = prend_push_str(b, ".visible .const .s32 SCENE_V1X_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1x))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V1Y_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1y))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V1Z_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1z))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V1R_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1r))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V1G_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1g))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V1B_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v1b))
    b = prend_push_str(b, ";\n")

    b = prend_push_str(b, ".visible .const .s32 SCENE_V2X_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2x))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V2Y_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2y))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V2Z_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2z))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V2R_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2r))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V2G_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2g))
    b = prend_push_str(b, ";\n")
    b = prend_push_str(b, ".visible .const .s32 SCENE_V2B_MILLI = ")
    b = prend_push_i64(b, scene_to_milli_i64(scene.v2b))
    b = prend_push_str(b, ";\n\n")
    b
}

// ============================================================================
// Emit pixel-fill kernel (flat color, no interpolation — baseline PTX)
// ============================================================================

fn ptx_emit_fill_kernel(buf: PtxRenderBuf) -> PtxRenderBuf with Mut, Panic, Div {
    var b = buf
    b = prend_push_str(b, ".visible .entry fill_rect(\n")
    b = prend_push_str(b, "    .param .u64 param_fb_r,\n")
    b = prend_push_str(b, "    .param .u64 param_fb_g,\n")
    b = prend_push_str(b, "    .param .u64 param_fb_b,\n")
    b = prend_push_str(b, "    .param .u32 param_r,\n")
    b = prend_push_str(b, "    .param .u32 param_g,\n")
    b = prend_push_str(b, "    .param .u32 param_b,\n")
    b = prend_push_str(b, "    .param .u32 param_width,\n")
    b = prend_push_str(b, "    .param .u32 param_height\n")
    b = prend_push_str(b, ") {\n")
    b = prend_push_str(b, "    .reg .u32 %tid_x, %tid_y, %ntid_x, %ctaid_x, %ctaid_y;\n")
    b = prend_push_str(b, "    .reg .u32 %px, %py, %width, %height, %idx;\n")
    b = prend_push_str(b, "    .reg .u32 %r, %g, %b_col;\n")
    b = prend_push_str(b, "    .reg .u64 %fb_r, %fb_g, %fb_b, %addr;\n")
    b = prend_push_str(b, "    .reg .pred %in_bounds;\n\n")
    b = prend_push_str(b, "    // Compute pixel coordinates\n")
    b = prend_push_str(b, "    mov.u32 %tid_x, %tid.x;\n")
    b = prend_push_str(b, "    mov.u32 %tid_y, %tid.y;\n")
    b = prend_push_str(b, "    mov.u32 %ntid_x, %ntid.x;\n")
    b = prend_push_str(b, "    mov.u32 %ctaid_x, %ctaid.x;\n")
    b = prend_push_str(b, "    mov.u32 %ctaid_y, %ctaid.y;\n")
    b = prend_push_str(b, "    mad.lo.u32 %px, %ctaid_x, %ntid_x, %tid_x;\n")
    b = prend_push_str(b, "    mad.lo.u32 %py, %ctaid_y, %ntid.y, %tid_y;\n\n")
    b = prend_push_str(b, "    // Bounds check\n")
    b = prend_push_str(b, "    ld.param.u32 %width, [param_width];\n")
    b = prend_push_str(b, "    ld.param.u32 %height, [param_height];\n")
    b = prend_push_str(b, "    setp.lt.u32 %in_bounds, %px, %width;\n")
    b = prend_push_str(b, "    @!%in_bounds bra done;\n")
    b = prend_push_str(b, "    setp.lt.u32 %in_bounds, %py, %height;\n")
    b = prend_push_str(b, "    @!%in_bounds bra done;\n\n")
    b = prend_push_str(b, "    // Compute linear index\n")
    b = prend_push_str(b, "    mad.lo.u32 %idx, %py, %width, %px;\n\n")
    b = prend_push_str(b, "    // Load color parameters\n")
    b = prend_push_str(b, "    ld.param.u32 %r, [param_r];\n")
    b = prend_push_str(b, "    ld.param.u32 %g, [param_g];\n")
    b = prend_push_str(b, "    ld.param.u32 %b_col, [param_b];\n\n")
    b = prend_push_str(b, "    // Write to framebuffer channels\n")
    b = prend_push_str(b, "    ld.param.u64 %fb_r, [param_fb_r];\n")
    b = prend_push_str(b, "    cvt.u64.u32 %addr, %idx;\n")
    b = prend_push_str(b, "    mul.wide.u32 %addr, %idx, 4;\n")
    b = prend_push_str(b, "    add.u64 %addr, %fb_r, %addr;\n")
    b = prend_push_str(b, "    st.global.u32 [%addr], %r;\n")
    b = prend_push_str(b, "    ld.param.u64 %fb_g, [param_fb_g];\n")
    b = prend_push_str(b, "    add.u64 %addr, %fb_g, %addr;\n")
    b = prend_push_str(b, "    st.global.u32 [%addr], %g;\n")
    b = prend_push_str(b, "    ld.param.u64 %fb_b, [param_fb_b];\n")
    b = prend_push_str(b, "    add.u64 %addr, %fb_b, %addr;\n")
    b = prend_push_str(b, "    st.global.u32 [%addr], %b_col;\n\n")
    b = prend_push_str(b, "done:\n")
    b = prend_push_str(b, "    ret;\n")
    b = prend_push_str(b, "}\n")
    b
}

// ============================================================================
// Emit complete PTX render kernel module
// ============================================================================

fn ptx_emit_render_module() -> PtxRenderBuf with Mut, Panic, Div {
    var b = prend_buf_new()
    b = ptx_emit_render_header(b)
    b = ptx_emit_fill_kernel(b)
    b
}

fn ptx_emit_scene_kernel(buf: PtxRenderBuf, scene: RenderScene) -> PtxRenderBuf with Mut, Panic, Div, Alloc {
    var b = buf
    b = ptx_emit_render_header(b)
    b = ptx_emit_scene_constants(b, scene)
    b = ptx_emit_fill_kernel(b)
    b
}

// Print generated PTX to stdout
fn ptx_render_print(buf: PtxRenderBuf) with IO, Mut, Panic, Div {
    print("// PTX render kernel (")
    print_int(buf.len)
    print(" bytes)\n")
    var i: i64 = 0
    while i < buf.len {
        let c = buf.data[i]
        print_char(c)
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let scene = render_scene_default()
    let buf = ptx_emit_scene_kernel(prend_buf_new(), scene)
    ptx_render_print(buf)
    0
}
