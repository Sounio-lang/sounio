// self-hosted::gpu::spirv — SPIR-V binary code generator
//
// Converts GpuKernelIr → SPIR-V binary.
// SPIR-V is a binary format (not text like PTX/MSL). This module:
//   1. Writes SPIR-V magic number, version, generator ID, bound
//   2. Emits capability and extension declarations
//   3. Emits memory model (GLSL450 for Vulkan, OpenCL for compute)
//   4. Emits entry point and execution mode
//   5. Emits type declarations (OpTypeVoid, OpTypeInt, OpTypeFloat, etc.)
//   6. Emits variable declarations
//   7. Emits function body instructions
//
// SPIR-V word encoding: each instruction is [word_count << 16 | opcode] followed by operands.

// ============================================================================
// SPIR-V constants
// ============================================================================

let SPIRV_MAGIC: i64 = 119734787          // 0x07230203
let SPIRV_VERSION_1_0: i64 = 65536       // 0x00010000
let SPIRV_VERSION_1_5: i64 = 65541       // 0x00010005
let SPIRV_GENERATOR_SOUNIO: i64 = 42     // Our generator ID

// SPIR-V opcodes (subset needed for compute shaders)
let OP_NOP: i64 = 0
let OP_CAPABILITY: i64 = 17
let OP_EXTENSION: i64 = 10
let OP_EXT_INST_IMPORT: i64 = 11
let OP_MEMORY_MODEL: i64 = 14
let OP_ENTRY_POINT: i64 = 15
let OP_EXECUTION_MODE: i64 = 16
let OP_NAME: i64 = 5
let OP_DECORATE: i64 = 71
let OP_MEMBER_DECORATE: i64 = 72
let OP_TYPE_VOID: i64 = 19
let OP_TYPE_BOOL: i64 = 20
let OP_TYPE_INT: i64 = 21
let OP_TYPE_FLOAT: i64 = 22
let OP_TYPE_VECTOR: i64 = 23
let OP_TYPE_POINTER: i64 = 32
let OP_TYPE_FUNCTION: i64 = 33
let OP_TYPE_STRUCT: i64 = 30
let OP_TYPE_ARRAY: i64 = 28
let OP_CONSTANT: i64 = 43
let OP_VARIABLE: i64 = 59
let OP_FUNCTION: i64 = 54
let OP_FUNCTION_END: i64 = 56
let OP_LABEL: i64 = 248
let OP_RETURN: i64 = 253
let OP_RETURN_VALUE: i64 = 254
let OP_LOAD: i64 = 61
let OP_STORE: i64 = 62
let OP_ACCESS_CHAIN: i64 = 65
let OP_IADD: i64 = 128
let OP_ISUB: i64 = 130
let OP_IMUL: i64 = 132
let OP_UDIV: i64 = 134
let OP_SDIV: i64 = 135
let OP_UMOD: i64 = 137
let OP_SMOD: i64 = 139
let OP_FADD: i64 = 129
let OP_FSUB: i64 = 131
let OP_FMUL: i64 = 133
let OP_FDIV: i64 = 136
let OP_FREM: i64 = 140
let OP_FNEGATE: i64 = 127
let OP_SNEGATE: i64 = 126
let OP_CONVERT_F_TO_S: i64 = 110
let OP_CONVERT_S_TO_F: i64 = 111
let OP_CONVERT_F_TO_U: i64 = 109
let OP_CONVERT_U_TO_F: i64 = 112
let OP_BITWISE_AND: i64 = 197
let OP_BITWISE_OR: i64 = 198
let OP_BITWISE_XOR: i64 = 199
let OP_SHIFT_LEFT_LOGICAL: i64 = 196
let OP_SHIFT_RIGHT_LOGICAL: i64 = 194
let OP_SHIFT_RIGHT_ARITHMETIC: i64 = 195
let OP_SELECT: i64 = 169
let OP_SLESS_THAN: i64 = 178
let OP_ULESS_THAN: i64 = 176
let OP_SGREATER_THAN: i64 = 182
let OP_UGREATER_THAN: i64 = 180
let OP_SEQUAL: i64 = 170  // OpIEqual
let OP_SNOT_EQUAL: i64 = 171  // OpINotEqual
let OP_FORD_LESS_THAN: i64 = 184
let OP_FORD_GREATER_THAN: i64 = 186
let OP_FORD_EQUAL: i64 = 180
let OP_CONTROL_BARRIER: i64 = 224
let OP_EXT_INST: i64 = 12

// Addressing models
let ADDRESSING_LOGICAL: i64 = 0
let ADDRESSING_PHYSICAL_32: i64 = 1
let ADDRESSING_PHYSICAL_64: i64 = 2

// Memory models
let MEMORY_GLSL450: i64 = 1
let MEMORY_OPENCL: i64 = 2

// Execution models
let EXECUTION_GLCOMPUTE: i64 = 5

// Storage classes
let STORAGE_UNIFORM_CONSTANT: i64 = 0
let STORAGE_INPUT: i64 = 1
let STORAGE_UNIFORM: i64 = 2
let STORAGE_OUTPUT: i64 = 3
let STORAGE_WORKGROUP: i64 = 4
let STORAGE_PRIVATE: i64 = 6
let STORAGE_FUNCTION: i64 = 7
let STORAGE_STORAGE_BUFFER: i64 = 12

// Capabilities
let CAPABILITY_SHADER: i64 = 1
let CAPABILITY_KERNEL: i64 = 6
let CAPABILITY_FLOAT64: i64 = 10

// Execution modes
let EXEC_MODE_LOCAL_SIZE: i64 = 17

// Decorations
let DECORATION_BINDING: i64 = 33
let DECORATION_DESCRIPTOR_SET: i64 = 34
let DECORATION_BUILTIN: i64 = 11
let DECORATION_LOCATION: i64 = 30
let BUILTIN_GLOBAL_INVOCATION_ID: i64 = 28
let BUILTIN_LOCAL_INVOCATION_ID: i64 = 27
let BUILTIN_WORKGROUP_ID: i64 = 26
let BUILTIN_WORKGROUP_SIZE: i64 = 25

// ============================================================================
// SpvBuf — binary buffer (32-bit word oriented)
// ============================================================================

pub struct SpvBuf {
    pub words: [i64; 1024],    // SPIR-V words (stored as i64, but only low 32 bits matter)
    pub word_count: i64,
}

pub fn spv_buf_new() -> SpvBuf {
    SpvBuf { words: [0; 1024], word_count: 0 }
}

pub fn spv_push_word(buf: SpvBuf, w: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    if out.word_count < 1024 {
        out.words[out.word_count as usize] = w % 4294967296  // mask to 32 bits
        out.word_count = out.word_count + 1
    }
    out
}

// Encode an instruction: word_count << 16 | opcode
fn spv_encode_op(word_count: i64, opcode: i64) -> i64 {
    ((word_count % 65536) * 65536) + (opcode % 65536)
}

// Push a string as packed SPIR-V words (4 bytes per word, null-padded)
fn spv_push_string(buf: SpvBuf, s: string) -> SpvBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0

    while i < n {
        var w: i64 = 0
        // Pack up to 4 bytes per word
        if i < n { w = w + ((str_char_at(s, i) as i64) % 256) }
        if i + 1 < n { w = w + (((str_char_at(s, i + 1) as i64) % 256) * 256) }
        if i + 2 < n { w = w + (((str_char_at(s, i + 2) as i64) % 256) * 65536) }
        if i + 3 < n { w = w + (((str_char_at(s, i + 3) as i64) % 256) * 16777216) }
        out = spv_push_word(out, w)
        i = i + 4
    }

    // If string length is a multiple of 4, add a null-terminator word
    if n % 4 == 0 {
        out = spv_push_word(out, 0)
    }

    out
}

// Number of words needed for a string (including null padding)
fn spv_string_word_count(s: string) -> i64 with Div, Panic {
    let n = str_len(s)
    (n / 4) + 1
}

// ============================================================================
// ID allocation
// ============================================================================

struct SpvIdAlloc {
    next_id: i64,
}

fn spv_id_alloc_new() -> SpvIdAlloc {
    SpvIdAlloc { next_id: 1 }  // SPIR-V IDs start at 1
}

fn spv_alloc_id(alloc: SpvIdAlloc) -> (SpvIdAlloc, i64) with Mut {
    var out = alloc
    let id = out.next_id
    out.next_id = out.next_id + 1
    (out, id)
}

// ============================================================================
// Type IDs — cached during emission
// ============================================================================

pub struct SpvTypeIds {
    void_id: i64,
    bool_id: i64,
    uint_id: i64,
    int_id: i64,
    ulong_id: i64,
    long_id: i64,
    float_id: i64,
    double_id: i64,
    uint3_id: i64,      // uvec3 for GlobalInvocationId
    ptr_storage_uint_id: i64,
    ptr_storage_float_id: i64,
    ptr_input_uint3_id: i64,
    func_void_id: i64,
}

fn spv_type_ids_new() -> SpvTypeIds {
    SpvTypeIds {
        void_id: 0, bool_id: 0, uint_id: 0, int_id: 0,
        ulong_id: 0, long_id: 0, float_id: 0, double_id: 0,
        uint3_id: 0, ptr_storage_uint_id: 0, ptr_storage_float_id: 0,
        ptr_input_uint3_id: 0, func_void_id: 0,
    }
}

// ============================================================================
// Emit SPIR-V header
// ============================================================================

fn spv_emit_header(buf: SpvBuf, bound: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, SPIRV_MAGIC)
    out = spv_push_word(out, SPIRV_VERSION_1_5)
    out = spv_push_word(out, SPIRV_GENERATOR_SOUNIO)
    out = spv_push_word(out, bound)  // ID bound
    out = spv_push_word(out, 0)      // schema (reserved)
    out
}

// ============================================================================
// Emit capability declarations
// ============================================================================

fn spv_emit_capability(buf: SpvBuf, cap: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(2, OP_CAPABILITY))
    out = spv_push_word(out, cap)
    out
}

// ============================================================================
// Emit memory model
// ============================================================================

fn spv_emit_memory_model(buf: SpvBuf, addressing: i64, memory: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(3, OP_MEMORY_MODEL))
    out = spv_push_word(out, addressing)
    out = spv_push_word(out, memory)
    out
}

// ============================================================================
// Emit entry point
// ============================================================================

fn spv_emit_entry_point(buf: SpvBuf, exec_model: i64, func_id: i64, name: string, interface_ids: [i64; 8], interface_count: i64) -> SpvBuf with Mut, Panic, Div {
    var out = buf
    let str_words = spv_string_word_count(name)
    let total_words = 3 + str_words + interface_count
    out = spv_push_word(out, spv_encode_op(total_words, OP_ENTRY_POINT))
    out = spv_push_word(out, exec_model)
    out = spv_push_word(out, func_id)
    out = spv_push_string(out, name)
    var i: i64 = 0
    while i < interface_count {
        out = spv_push_word(out, interface_ids[i as usize])
        i = i + 1
    }
    out
}

// ============================================================================
// Emit execution mode (local size for compute)
// ============================================================================

fn spv_emit_local_size(buf: SpvBuf, func_id: i64, x: i64, y: i64, z: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(6, OP_EXECUTION_MODE))
    out = spv_push_word(out, func_id)
    out = spv_push_word(out, EXEC_MODE_LOCAL_SIZE)
    out = spv_push_word(out, x)
    out = spv_push_word(out, y)
    out = spv_push_word(out, z)
    out
}

// ============================================================================
// Emit type declarations
// ============================================================================

fn spv_emit_type_void(buf: SpvBuf, result_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(2, OP_TYPE_VOID))
    out = spv_push_word(out, result_id)
    out
}

fn spv_emit_type_int(buf: SpvBuf, result_id: i64, width: i64, signedness: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_TYPE_INT))
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, width)
    out = spv_push_word(out, signedness)
    out
}

fn spv_emit_type_float(buf: SpvBuf, result_id: i64, width: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(3, OP_TYPE_FLOAT))
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, width)
    out
}

fn spv_emit_type_vector(buf: SpvBuf, result_id: i64, component_id: i64, count: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_TYPE_VECTOR))
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, component_id)
    out = spv_push_word(out, count)
    out
}

fn spv_emit_type_pointer(buf: SpvBuf, result_id: i64, storage_class: i64, type_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_TYPE_POINTER))
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, storage_class)
    out = spv_push_word(out, type_id)
    out
}

fn spv_emit_type_function(buf: SpvBuf, result_id: i64, return_type: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(3, OP_TYPE_FUNCTION))
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, return_type)
    out
}

// ============================================================================
// Emit decoration
// ============================================================================

fn spv_emit_decorate(buf: SpvBuf, target: i64, decoration: i64, value: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_DECORATE))
    out = spv_push_word(out, target)
    out = spv_push_word(out, decoration)
    out = spv_push_word(out, value)
    out
}

fn spv_emit_decorate_builtin(buf: SpvBuf, target: i64, builtin: i64) -> SpvBuf with Mut, Panic {
    spv_emit_decorate(buf, target, DECORATION_BUILTIN, builtin)
}

fn spv_emit_decorate_binding(buf: SpvBuf, target: i64, binding: i64) -> SpvBuf with Mut, Panic {
    spv_emit_decorate(buf, target, DECORATION_BINDING, binding)
}

fn spv_emit_decorate_descriptor_set(buf: SpvBuf, target: i64, set: i64) -> SpvBuf with Mut, Panic {
    spv_emit_decorate(buf, target, DECORATION_DESCRIPTOR_SET, set)
}

fn spv_emit_decorate_location(buf: SpvBuf, target: i64, location: i64) -> SpvBuf with Mut, Panic {
    spv_emit_decorate(buf, target, DECORATION_LOCATION, location)
}

// OpExecutionMode: word_count=3, opcode=16
fn spv_emit_execution_mode(buf: SpvBuf, entry_point: i64, mode: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(3, 16))
    out = spv_push_word(out, entry_point)
    out = spv_push_word(out, mode)
    out
}

// ============================================================================
// Emit instructions (arithmetic, load, store)
// ============================================================================

fn spv_emit_binary_op(buf: SpvBuf, opcode: i64, type_id: i64, result_id: i64, op1: i64, op2: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(5, opcode))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, op1)
    out = spv_push_word(out, op2)
    out
}

fn spv_emit_load(buf: SpvBuf, type_id: i64, result_id: i64, pointer_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_LOAD))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, pointer_id)
    out
}

fn spv_emit_store(buf: SpvBuf, pointer_id: i64, value_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(3, OP_STORE))
    out = spv_push_word(out, pointer_id)
    out = spv_push_word(out, value_id)
    out
}

fn spv_emit_access_chain(buf: SpvBuf, type_id: i64, result_id: i64, base_id: i64, index_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(5, OP_ACCESS_CHAIN))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, base_id)
    out = spv_push_word(out, index_id)
    out
}

// ============================================================================
// Emit function structure
// ============================================================================

fn spv_emit_function(buf: SpvBuf, result_type: i64, result_id: i64, function_control: i64, func_type: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(5, OP_FUNCTION))
    out = spv_push_word(out, result_type)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, function_control)
    out = spv_push_word(out, func_type)
    out
}

fn spv_emit_function_end(buf: SpvBuf) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(1, OP_FUNCTION_END))
    out
}

fn spv_emit_label(buf: SpvBuf, result_id: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(2, OP_LABEL))
    out = spv_push_word(out, result_id)
    out
}

fn spv_emit_return(buf: SpvBuf) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(1, OP_RETURN))
    out
}

fn spv_emit_constant_u32(buf: SpvBuf, type_id: i64, result_id: i64, value: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_CONSTANT))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, value)
    out
}

fn spv_emit_variable(buf: SpvBuf, type_id: i64, result_id: i64, storage_class: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_VARIABLE))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, storage_class)
    out
}

// ============================================================================
// Emit OpControlBarrier (workgroup barrier)
// ============================================================================

fn spv_emit_control_barrier(buf: SpvBuf, execution_scope: i64, memory_scope: i64, semantics: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(4, OP_CONTROL_BARRIER))
    out = spv_push_word(out, execution_scope)
    out = spv_push_word(out, memory_scope)
    out = spv_push_word(out, semantics)
    out
}

// ============================================================================
// GPU opcode → SPIR-V opcode mapping
// ============================================================================

fn gpu_opcode_to_spirv(opc: GpuOpcode, ty: GpuType) -> i64 {
    let is_float = (ty == GpuType::GpuF32) || (ty == GpuType::GpuF64)

    if opc == GpuOpcode::GpuAdd { if is_float { return OP_FADD } return OP_IADD }
    if opc == GpuOpcode::GpuSub { if is_float { return OP_FSUB } return OP_ISUB }
    if opc == GpuOpcode::GpuMul { if is_float { return OP_FMUL } return OP_IMUL }
    if opc == GpuOpcode::GpuDiv {
        if is_float { return OP_FDIV }
        if ty == GpuType::GpuI32 || ty == GpuType::GpuI64 { return OP_SDIV }
        return OP_UDIV
    }

    OP_NOP
}

// ============================================================================
// Serialize SpvBuf to raw bytes (for writing to file)
// ============================================================================

struct SpvBytes {
    data: [i8; 65536],
    len: i64,
}

fn spv_to_bytes(buf: SpvBuf) -> SpvBytes with Mut, Panic, Div {
    var out = SpvBytes { data: [0; 65536], len: 0 }
    var i: i64 = 0
    while i < buf.word_count {
        let w = buf.words[i as usize]
        if out.len + 4 <= 65536 {
            // Little-endian word encoding
            out.data[out.len as usize] = (w % 256) as i8
            out.data[(out.len + 1) as usize] = ((w / 256) % 256) as i8
            out.data[(out.len + 2) as usize] = ((w / 65536) % 256) as i8
            out.data[(out.len + 3) as usize] = ((w / 16777216) % 256) as i8
            out.len = out.len + 4
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Phase 3: Full Kernel Pipeline — SPIR-V Code Generator
// ============================================================================

// Additional SPIR-V opcodes needed for the kernel pipeline
let OP_COMPOSITE_EXTRACT: i64 = 81
let OP_SLESS_THAN_OR_EQUAL: i64 = 179
let OP_SGREATER_THAN_OR_EQUAL: i64 = 183
let OP_FORD_LESS_THAN_OR_EQUAL: i64 = 185
let OP_FORD_GREATER_THAN_OR_EQUAL: i64 = 187

// Scope constants for OpControlBarrier
let SCOPE_WORKGROUP: i64 = 2
let SCOPE_DEVICE: i64 = 1
let MEMORY_SEMANTICS_WORKGROUP: i64 = 256   // WorkgroupMemory
let MEMORY_SEMANTICS_ACQUIRE_RELEASE: i64 = 8  // AcquireRelease

// Type tag encoding: 0=f32, 1=f64, 2=i32, 3=i64, 4=u32, 5=u64
let SPV_TAG_F32: i64 = 0
let SPV_TAG_F64: i64 = 1
let SPV_TAG_I32: i64 = 2
let SPV_TAG_I64: i64 = 3
let SPV_TAG_U32: i64 = 4
let SPV_TAG_U64: i64 = 5

// ============================================================================
// 1. SpvCompileState — register map and compilation state
// ============================================================================

struct SpvRegMap {
    gpu_regs: [i64; 64],
    spv_ids: [i64; 64],
    count: i64,
}

struct SpvCompileState {
    buf: SpvBuf,
    ids: SpvIdAlloc,
    types: SpvTypeIds,
    reg_map: SpvRegMap,
    // IDs allocated during kernel setup
    entry_func_id: i64,
    label_id: i64,
    gid_var_id: i64,           // GlobalInvocationId variable
    param_var_ids: [i64; 8],   // StorageBuffer param variable IDs
    // Constant IDs needed for barriers and composite extract
    const_scope_wg_id: i64,
    const_semantics_id: i64,
    const_zero_id: i64,
}

fn spv_reg_map_new() -> SpvRegMap {
    SpvRegMap {
        gpu_regs: [0; 64],
        spv_ids: [0; 64],
        count: 0,
    }
}

fn spv_reg_map_insert(map: SpvRegMap, gpu_reg: i64, spv_id: i64) -> SpvRegMap with Mut, Panic {
    var out = map
    if out.count < 64 {
        out.gpu_regs[out.count as usize] = gpu_reg
        out.spv_ids[out.count as usize] = spv_id
        out.count = out.count + 1
    }
    out
}

fn spv_reg_map_lookup(map: SpvRegMap, gpu_reg: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < map.count {
        if map.gpu_regs[i as usize] == gpu_reg {
            return map.spv_ids[i as usize]
        }
        i = i + 1
    }
    // Not found — return 0 (invalid SPIR-V ID)
    0
}

fn spv_compile_state_new() -> SpvCompileState {
    SpvCompileState {
        buf: spv_buf_new(),
        ids: spv_id_alloc_new(),
        types: spv_type_ids_new(),
        reg_map: spv_reg_map_new(),
        entry_func_id: 0,
        label_id: 0,
        gid_var_id: 0,
        param_var_ids: [0; 8],
        const_scope_wg_id: 0,
        const_semantics_id: 0,
        const_zero_id: 0,
    }
}

// ============================================================================
// 2. spv_allocate_all_types — emit type declarations
// ============================================================================

fn spv_allocate_all_types(state: SpvCompileState) -> SpvCompileState with Mut, Panic {
    var s = state

    // OpTypeVoid
    let (ids1, void_id) = spv_alloc_id(s.ids)
    s.ids = ids1
    s.buf = spv_emit_type_void(s.buf, void_id)
    s.types.void_id = void_id

    // OpTypeInt(32, unsigned) — uint
    let (ids2, uint_id) = spv_alloc_id(s.ids)
    s.ids = ids2
    s.buf = spv_emit_type_int(s.buf, uint_id, 32, 0)
    s.types.uint_id = uint_id

    // OpTypeInt(32, signed) — int
    let (ids3, int_id) = spv_alloc_id(s.ids)
    s.ids = ids3
    s.buf = spv_emit_type_int(s.buf, int_id, 32, 1)
    s.types.int_id = int_id

    // OpTypeInt(64, unsigned) — ulong
    let (ids4, ulong_id) = spv_alloc_id(s.ids)
    s.ids = ids4
    s.buf = spv_emit_type_int(s.buf, ulong_id, 64, 0)
    s.types.ulong_id = ulong_id

    // OpTypeInt(64, signed) — long
    let (ids5, long_id) = spv_alloc_id(s.ids)
    s.ids = ids5
    s.buf = spv_emit_type_int(s.buf, long_id, 64, 1)
    s.types.long_id = long_id

    // OpTypeFloat(32) — float
    let (ids6, float_id) = spv_alloc_id(s.ids)
    s.ids = ids6
    s.buf = spv_emit_type_float(s.buf, float_id, 32)
    s.types.float_id = float_id

    // OpTypeFloat(64) — double
    let (ids7, double_id) = spv_alloc_id(s.ids)
    s.ids = ids7
    s.buf = spv_emit_type_float(s.buf, double_id, 64)
    s.types.double_id = double_id

    // OpTypeVector(uint, 3) — uvec3 for GlobalInvocationId
    let (ids8, uint3_id) = spv_alloc_id(s.ids)
    s.ids = ids8
    s.buf = spv_emit_type_vector(s.buf, uint3_id, uint_id, 3)
    s.types.uint3_id = uint3_id

    // OpTypePointer(Function, float) — for function-local float pointers
    let (ids9, ptr_func_float_id) = spv_alloc_id(s.ids)
    s.ids = ids9
    s.buf = spv_emit_type_pointer(s.buf, ptr_func_float_id, STORAGE_FUNCTION, float_id)

    // OpTypePointer(StorageBuffer, uint) — for buffer params (uint element)
    let (ids10, ptr_sb_uint_id) = spv_alloc_id(s.ids)
    s.ids = ids10
    s.buf = spv_emit_type_pointer(s.buf, ptr_sb_uint_id, STORAGE_STORAGE_BUFFER, uint_id)
    s.types.ptr_storage_uint_id = ptr_sb_uint_id

    // OpTypePointer(StorageBuffer, float) — for buffer params (float element)
    let (ids11, ptr_sb_float_id) = spv_alloc_id(s.ids)
    s.ids = ids11
    s.buf = spv_emit_type_pointer(s.buf, ptr_sb_float_id, STORAGE_STORAGE_BUFFER, float_id)
    s.types.ptr_storage_float_id = ptr_sb_float_id

    // OpTypePointer(Input, uvec3) — for GlobalInvocationId
    let (ids12, ptr_input_uint3_id) = spv_alloc_id(s.ids)
    s.ids = ids12
    s.buf = spv_emit_type_pointer(s.buf, ptr_input_uint3_id, STORAGE_INPUT, uint3_id)
    s.types.ptr_input_uint3_id = ptr_input_uint3_id

    // OpTypeFunction(void) — void() function type
    let (ids13, func_void_id) = spv_alloc_id(s.ids)
    s.ids = ids13
    s.buf = spv_emit_type_function(s.buf, func_void_id, void_id)
    s.types.func_void_id = func_void_id

    s
}

// ============================================================================
// 3. spv_emit_kernel_variables — declare params and builtins
// ============================================================================

fn spv_emit_kernel_variables(state: SpvCompileState, param_count: i64) -> SpvCompileState with Mut, Panic, Div {
    var s = state

    // Declare StorageBuffer pointer variables for each kernel parameter.
    // Each gets Binding = i, DescriptorSet = 0.
    var i: i64 = 0
    while i < param_count {
        if i < 8 {
            let (ids_p, var_id) = spv_alloc_id(s.ids)
            s.ids = ids_p
            // OpVariable StorageBuffer pointer (using float pointer type as default)
            s.buf = spv_emit_variable(s.buf, s.types.ptr_storage_float_id, var_id, STORAGE_STORAGE_BUFFER)
            // OpDecorate Binding i
            s.buf = spv_emit_decorate_binding(s.buf, var_id, i)
            // OpDecorate DescriptorSet 0
            s.buf = spv_emit_decorate_descriptor_set(s.buf, var_id, 0)
            s.param_var_ids[i as usize] = var_id
        }
        i = i + 1
    }

    // Declare GlobalInvocationId input variable
    let (ids_gid, gid_var_id) = spv_alloc_id(s.ids)
    s.ids = ids_gid
    s.buf = spv_emit_variable(s.buf, s.types.ptr_input_uint3_id, gid_var_id, STORAGE_INPUT)
    // OpDecorate BuiltIn GlobalInvocationId
    s.buf = spv_emit_decorate_builtin(s.buf, gid_var_id, BUILTIN_GLOBAL_INVOCATION_ID)
    s.gid_var_id = gid_var_id

    // Emit constants needed for barriers and composite extract
    // Constant: workgroup scope (uint = 2)
    let (ids_c1, scope_wg_id) = spv_alloc_id(s.ids)
    s.ids = ids_c1
    s.buf = spv_emit_constant_u32(s.buf, s.types.uint_id, scope_wg_id, SCOPE_WORKGROUP)
    s.const_scope_wg_id = scope_wg_id

    // Constant: memory semantics for barrier (WorkgroupMemory | AcquireRelease = 264)
    let (ids_c2, semantics_id) = spv_alloc_id(s.ids)
    s.ids = ids_c2
    s.buf = spv_emit_constant_u32(s.buf, s.types.uint_id, semantics_id, MEMORY_SEMANTICS_WORKGROUP + MEMORY_SEMANTICS_ACQUIRE_RELEASE)
    s.const_semantics_id = semantics_id

    // Constant: zero (uint = 0) for composite extract index
    let (ids_c3, zero_id) = spv_alloc_id(s.ids)
    s.ids = ids_c3
    s.buf = spv_emit_constant_u32(s.buf, s.types.uint_id, zero_id, 0)
    s.const_zero_id = zero_id

    s
}

// ============================================================================
// Helper: resolve SPIR-V type ID from type_tag
// ============================================================================

fn spv_type_id_for_tag(types: SpvTypeIds, type_tag: i64) -> i64 {
    if type_tag == SPV_TAG_F32 { return types.float_id }
    if type_tag == SPV_TAG_F64 { return types.double_id }
    if type_tag == SPV_TAG_I32 { return types.int_id }
    if type_tag == SPV_TAG_I64 { return types.long_id }
    if type_tag == SPV_TAG_U32 { return types.uint_id }
    if type_tag == SPV_TAG_U64 { return types.ulong_id }
    // Default to uint
    types.uint_id
}

fn spv_is_float_tag(type_tag: i64) -> bool {
    type_tag == SPV_TAG_F32 || type_tag == SPV_TAG_F64
}

fn spv_is_signed_int_tag(type_tag: i64) -> bool {
    type_tag == SPV_TAG_I32 || type_tag == SPV_TAG_I64
}

// ============================================================================
// Helper: emit OpCompositeExtract instruction
// ============================================================================

fn spv_emit_composite_extract(buf: SpvBuf, type_id: i64, result_id: i64, composite_id: i64, index: i64) -> SpvBuf with Mut, Panic {
    var out = buf
    out = spv_push_word(out, spv_encode_op(5, OP_COMPOSITE_EXTRACT))
    out = spv_push_word(out, type_id)
    out = spv_push_word(out, result_id)
    out = spv_push_word(out, composite_id)
    out = spv_push_word(out, index)
    out
}

// ============================================================================
// 4. spv_lower_single_op — lower one GPU IR opcode to SPIR-V
// ============================================================================

fn spv_lower_single_op(state: SpvCompileState, opcode: i64, dst_reg: i64, src_a_reg: i64, src_b_reg: i64, type_tag: i64, imm: i64) -> SpvCompileState with Mut, Panic, Div {
    var s = state
    let tid = spv_type_id_for_tag(s.types, type_tag)
    let is_float = spv_is_float_tag(type_tag)
    let is_signed = spv_is_signed_int_tag(type_tag)

    // GpuOpcode enum indices (matching kernel_ir.sio order)
    let GPU_OP_GET_TID: i64 = 0
    let GPU_OP_MUL_IMM: i64 = 2
    let GPU_OP_ADD: i64 = 3
    let GPU_OP_SUB: i64 = 4
    let GPU_OP_MUL: i64 = 5
    let GPU_OP_DIV: i64 = 6
    let GPU_OP_BARRIER_SYNC: i64 = 9
    let GPU_OP_SHFL_DOWN: i64 = 10
    let GPU_OP_LOAD_PARAM: i64 = 13
    let GPU_OP_LOAD_GLOBAL: i64 = 15
    let GPU_OP_STORE_GLOBAL: i64 = 16
    let GPU_OP_SETP_LT: i64 = 22
    let GPU_OP_SETP_LE: i64 = 23
    let GPU_OP_SETP_EQ: i64 = 24
    let GPU_OP_SETP_GE: i64 = 25

    // ---- GpuAdd ----
    if opcode == GPU_OP_ADD {
        let (ids_a, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_a
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FADD, tid, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_IADD, tid, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuSub ----
    if opcode == GPU_OP_SUB {
        let (ids_b, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_b
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FSUB, tid, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_ISUB, tid, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuMul ----
    if opcode == GPU_OP_MUL {
        let (ids_c, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_c
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FMUL, tid, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_IMUL, tid, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuDiv ----
    if opcode == GPU_OP_DIV {
        let (ids_d, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_d
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FDIV, tid, result_id, src_a_id, src_b_id)
        } else if is_signed {
            s.buf = spv_emit_binary_op(s.buf, OP_SDIV, tid, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_UDIV, tid, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuLoadParam ----
    // Map dst_reg to the SPIR-V ID of the parameter variable.
    // The parameter variable ID is stored in param_var_ids[param_idx].
    // For now, we encode param_idx in src_a_reg (the caller must set it).
    if opcode == GPU_OP_LOAD_PARAM {
        let param_idx = src_a_reg
        if param_idx >= 0 && param_idx < 8 {
            let var_id = s.param_var_ids[param_idx as usize]
            s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, var_id)
        }
        return s
    }

    // ---- GpuMulImm ----
    // Emit a constant with the immediate value, then multiply.
    if opcode == GPU_OP_MUL_IMM {
        let (ids_c, const_id) = spv_alloc_id(s.ids)
        s.ids = ids_c
        s.buf = spv_emit_constant_u32(s.buf, s.types.uint_id, const_id, imm)
        let (ids_m, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_m
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FMUL, tid, result_id, src_a_id, const_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_IMUL, tid, result_id, src_a_id, const_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuLoadGlobal ----
    if opcode == GPU_OP_LOAD_GLOBAL {
        let (ids_l, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_l
        let ptr_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        s.buf = spv_emit_load(s.buf, tid, result_id, ptr_id)
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuStoreGlobal ----
    if opcode == GPU_OP_STORE_GLOBAL {
        let ptr_id = spv_reg_map_lookup(s.reg_map, dst_reg)
        let val_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        s.buf = spv_emit_store(s.buf, ptr_id, val_id)
        return s
    }

    // ---- GpuGetTid ----
    if opcode == GPU_OP_GET_TID {
        // Load the GlobalInvocationId vec3, then extract component 0 (x)
        let (ids_t1, loaded_id) = spv_alloc_id(s.ids)
        s.ids = ids_t1
        s.buf = spv_emit_load(s.buf, s.types.uint3_id, loaded_id, s.gid_var_id)
        let (ids_t2, extracted_id) = spv_alloc_id(s.ids)
        s.ids = ids_t2
        s.buf = spv_emit_composite_extract(s.buf, s.types.uint_id, extracted_id, loaded_id, 0)
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, extracted_id)
        return s
    }

    // ---- GpuBarrierSync ----
    if opcode == GPU_OP_BARRIER_SYNC {
        // OpControlBarrier(Workgroup, Workgroup, WorkgroupMemory | AcquireRelease)
        s.buf = spv_emit_control_barrier(s.buf, s.const_scope_wg_id, s.const_scope_wg_id, s.const_semantics_id)
        return s
    }

    // ---- GpuSetpLt — float: OpFOrdLessThan, int: OpSLessThan ----
    if opcode == GPU_OP_SETP_LT {
        let (ids_lt, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_lt
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FORD_LESS_THAN, s.types.bool_id, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_SLESS_THAN, s.types.bool_id, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuSetpLe — float: OpFOrdLessThanEqual, int: OpSLessThanEqual ----
    if opcode == GPU_OP_SETP_LE {
        let (ids_le, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_le
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FORD_LESS_THAN_OR_EQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_SLESS_THAN_OR_EQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuSetpEq — float: OpFOrdEqual, int: OpIEqual ----
    if opcode == GPU_OP_SETP_EQ {
        let (ids_eq, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_eq
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FORD_EQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_SEQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuSetpGe — float: OpFOrdGreaterThanEqual, int: OpSGreaterThanEqual ----
    if opcode == GPU_OP_SETP_GE {
        let (ids_ge, result_id) = spv_alloc_id(s.ids)
        s.ids = ids_ge
        let src_a_id = spv_reg_map_lookup(s.reg_map, src_a_reg)
        let src_b_id = spv_reg_map_lookup(s.reg_map, src_b_reg)
        if is_float {
            s.buf = spv_emit_binary_op(s.buf, OP_FORD_GREATER_THAN_OR_EQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        } else {
            s.buf = spv_emit_binary_op(s.buf, OP_SGREATER_THAN_OR_EQUAL, s.types.bool_id, result_id, src_a_id, src_b_id)
        }
        s.reg_map = spv_reg_map_insert(s.reg_map, dst_reg, result_id)
        return s
    }

    // ---- GpuShflDown — no direct SPIR-V equivalent ----
    // Note: SPIR-V has no warp shuffle. Would need SPV_KHR_subgroup_shuffle
    // or OpGroupNonUniformShuffleDown (requires Vulkan 1.1 + SubgroupBallotKHR).
    // For now, skip with a no-op.
    if opcode == GPU_OP_SHFL_DOWN {
        return s
    }

    // Default: skip unknown opcodes (no emission, no crash)
    s
}

// ============================================================================
// 5. gpu_lower_to_spirv — full pipeline entry point
// ============================================================================

pub fn gpu_lower_to_spirv(kernel_name: string, param_count: i64, ops_opcodes: [i64; 256], ops_dst: [i64; 256], ops_src_a: [i64; 256], ops_src_b: [i64; 256], ops_type_tags: [i64; 256], ops_imm: [i64; 256], ops_count: i64) -> SpvBuf with Mut, Panic, Div {
    var s = spv_compile_state_new()

    // We build the module body first, then prepend the header with the final ID bound.

    // 1. Emit OpCapability Shader
    s.buf = spv_emit_capability(s.buf, CAPABILITY_SHADER)

    // 2. Emit OpMemoryModel Logical GLSL450
    s.buf = spv_emit_memory_model(s.buf, ADDRESSING_LOGICAL, MEMORY_GLSL450)

    // 3. Allocate types
    s = spv_allocate_all_types(s)

    // Emit OpTypeBool (needed for predicate comparisons)
    let (ids_bool, bool_id) = spv_alloc_id(s.ids)
    s.ids = ids_bool
    s.buf = spv_push_word(s.buf, spv_encode_op(2, OP_TYPE_BOOL))
    s.buf = spv_push_word(s.buf, bool_id)
    s.types.bool_id = bool_id

    // 4. Emit kernel variables + decorations
    s = spv_emit_kernel_variables(s, param_count)

    // 5. Allocate function and label IDs
    let (ids_fn, func_id) = spv_alloc_id(s.ids)
    s.ids = ids_fn
    s.entry_func_id = func_id

    let (ids_lbl, lbl_id) = spv_alloc_id(s.ids)
    s.ids = ids_lbl
    s.label_id = lbl_id

    // 6. Emit OpEntryPoint GLCompute
    // Interface variables: gid var + all param vars
    var iface_ids: [i64; 8] = [0; 8]
    var iface_count: i64 = 0
    // Add GlobalInvocationId variable to interface
    iface_ids[0] = s.gid_var_id
    iface_count = 1
    // Add StorageBuffer param variables to interface
    var pi: i64 = 0
    while pi < param_count {
        if pi < 8 {
            if iface_count < 8 {
                iface_ids[iface_count as usize] = s.param_var_ids[pi as usize]
                iface_count = iface_count + 1
            }
        }
        pi = pi + 1
    }
    s.buf = spv_emit_entry_point(s.buf, EXECUTION_GLCOMPUTE, func_id, kernel_name, iface_ids, iface_count)

    // 7. Emit OpExecutionMode LocalSize (256, 1, 1)
    s.buf = spv_emit_local_size(s.buf, func_id, 256, 1, 1)

    // 8. Begin function
    s.buf = spv_emit_function(s.buf, s.types.void_id, func_id, 0, s.types.func_void_id)
    s.buf = spv_emit_label(s.buf, lbl_id)

    // 9. Walk ops array, calling spv_lower_single_op for each
    var oi: i64 = 0
    while oi < ops_count {
        if oi < 256 {
            s = spv_lower_single_op(
                s,
                ops_opcodes[oi as usize],
                ops_dst[oi as usize],
                ops_src_a[oi as usize],
                ops_src_b[oi as usize],
                ops_type_tags[oi as usize],
                ops_imm[oi as usize]
            )
        }
        oi = oi + 1
    }

    // 10. End function
    s.buf = spv_emit_return(s.buf)
    s.buf = spv_emit_function_end(s.buf)

    // Build final buffer: 5-word header + module body
    let bound = s.ids.next_id
    var final_buf = spv_buf_new()
    final_buf = spv_push_word(final_buf, SPIRV_MAGIC)
    final_buf = spv_push_word(final_buf, SPIRV_VERSION_1_5)
    final_buf = spv_push_word(final_buf, SPIRV_GENERATOR_SOUNIO)
    final_buf = spv_push_word(final_buf, bound)
    final_buf = spv_push_word(final_buf, 0)  // schema (reserved)

    // Copy all words from module body
    var ci: i64 = 0
    while ci < s.buf.word_count {
        final_buf = spv_push_word(final_buf, s.buf.words[ci as usize])
        ci = ci + 1
    }

    final_buf
}

// ============================================================================
// 6. Smoke tests + self_check
// ============================================================================

fn spirv_self_check_magic() -> bool with Mut, Panic, Div {
    // Build a minimal kernel with 0 ops and 2 params
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    let buf = gpu_lower_to_spirv("test_kernel", 2, opcodes, dsts, src_a, src_b, tags, imm, 0)

    // Check magic number is first word
    let magic_ok = buf.words[0] == SPIRV_MAGIC
    // Check word count is > 5 (at minimum: 5 header + capabilities + types)
    let size_ok = buf.word_count > 5
    // Check version
    let version_ok = buf.words[1] == SPIRV_VERSION_1_5
    // Check generator ID
    let generator_ok = buf.words[2] == SPIRV_GENERATOR_SOUNIO

    magic_ok && size_ok && version_ok && generator_ok
}

fn spirv_self_check_add_kernel() -> bool with Mut, Panic, Div {
    // Build a kernel with one add op: dst=2, src_a=0, src_b=1, f32
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 3   // GpuAdd
    dsts[0] = 2
    src_a[0] = 0
    src_b[0] = 1
    tags[0] = SPV_TAG_F32

    let buf = gpu_lower_to_spirv("vec_add", 3, opcodes, dsts, src_a, src_b, tags, imm, 1)

    // Must have SPIR-V magic
    let magic_ok = buf.words[0] == SPIRV_MAGIC
    // Must have more words than the empty kernel (types + variable decls + add op)
    let size_ok = buf.word_count > 20
    magic_ok && size_ok
}

fn spirv_self_check_tid_kernel() -> bool with Mut, Panic, Div {
    // Build a kernel that gets thread ID (opcode 0)
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 0   // GpuGetTid
    dsts[0] = 0
    tags[0] = SPV_TAG_U32

    let buf = gpu_lower_to_spirv("tid_test", 1, opcodes, dsts, src_a, src_b, tags, imm, 1)

    // Must have SPIR-V magic and reasonable size
    let magic_ok = buf.words[0] == SPIRV_MAGIC
    let size_ok = buf.word_count > 20
    magic_ok && size_ok
}

fn gpu_spirv_main() -> i32 with IO, Mut, Panic, Div {
    let ok = spirv_self_check()
    if ok {
        print("PASS spirv_self_check\n")
        return 0 as i32
    } else {
        print("FAIL spirv_self_check\n")
        return 1 as i32
    }
}

// ============================================================================
// Public SPIR-V emission patterns for driver consumption
// ============================================================================

fn spirv_emit_vec_add_kernel() -> SpvBuf with Mut, Panic, Div {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 0   // GpuGetTid
    dsts[0] = 0
    tags[0] = SPV_TAG_U32

    opcodes[1] = 3   // GpuAdd
    dsts[1] = 2
    src_a[1] = 0
    src_b[1] = 1
    tags[1] = SPV_TAG_F32

    gpu_lower_to_spirv("vec_add", 3, opcodes, dsts, src_a, src_b, tags, imm, 2)
}

fn spirv_emit_tid_kernel() -> SpvBuf with Mut, Panic, Div {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 0   // GpuGetTid
    dsts[0] = 0
    tags[0] = SPV_TAG_U32

    gpu_lower_to_spirv("tid_kernel", 1, opcodes, dsts, src_a, src_b, tags, imm, 1)
}

fn spirv_self_check_mulimm_kernel() -> bool with Mut, Panic, Div {
    // Build a kernel with one mul_imm op: dst=1, src_a=0, imm=4, u32
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 2    // GpuMulImm
    dsts[0] = 1
    src_a[0] = 0
    imm[0] = 4
    tags[0] = SPV_TAG_U32

    let buf = gpu_lower_to_spirv("mulimm_test", 1, opcodes, dsts, src_a, src_b, tags, imm, 1)

    let magic_ok = buf.words[0] == SPIRV_MAGIC
    let size_ok = buf.word_count > 20
    magic_ok && size_ok
}

fn spirv_self_check_loadparam_kernel() -> bool with Mut, Panic, Div {
    // Build a kernel with one load_param op: dst=0, param_idx=0
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = 13   // GpuLoadParam
    dsts[0] = 0
    src_a[0] = 0      // param_idx
    tags[0] = SPV_TAG_U32

    let buf = gpu_lower_to_spirv("loadparam_test", 1, opcodes, dsts, src_a, src_b, tags, imm, 1)

    let magic_ok = buf.words[0] == SPIRV_MAGIC
    let size_ok = buf.word_count > 20
    magic_ok && size_ok
}

fn spirv_self_check() -> bool with Mut, Panic, Div {
    let t1 = spirv_self_check_magic()
    let t2 = spirv_self_check_add_kernel()
    let t3 = spirv_self_check_tid_kernel()
    let t4 = spirv_self_check_mulimm_kernel()
    let t5 = spirv_self_check_loadparam_kernel()
    t1 && t2 && t3 && t4 && t5
}

pub fn spirv_driver_self_check() -> bool with Mut, Panic, Div {
    spirv_self_check()
}
