// self-hosted::gpu::epistemic_spirv — Epistemic SPIR-V code generator
//
// World-first: GUM-compliant uncertainty propagation for Vulkan/OpenCL kernels.
// Each Knowledge<T> value on GPU gets 4 SPIR-V result IDs:
//   val_id   (f64) — computed value
//   eps_id   (f64) — uncertainty bound (epsilon)
//   valid_id (bool) — validity predicate
//   prov_id  (u64) — bit-packed provenance (data lineage)
//
// GUM uncertainty propagation rules (JCGM 100:2008):
//   Add/Sub: e_c = sqrt(e_a^2 + e_b^2)              [quadrature]
//   Mul:     e_c = |a|*e_b + |b|*e_a                 [first-order]
//   Div:     e_c = (|a|*e_b + |b|*e_a) / b^2         [+ near-zero guard]
//   FMA:     e_c = sqrt((|a|*e_b + |b|*e_a)^2 + e_c^2)
//
// Key difference from epistemic_ptx.sio: PTX uses named registers ("%r_a_eps"),
// SPIR-V uses integer result IDs. EpistemicShadowSpv stores 4 result IDs.

// ============================================================================
// Helper: i64 -> decimal string (no stdlib dependency)
// ============================================================================

fn espv_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n < 0 {
        return "0"
    }
    if n == 0 { return "0" }

    var digits: [i8; 32] = [0 as i8; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var bytes: [i8; 32] = [0 as i8; 32]
    var i: i64 = 0
    while i < rev_len {
        bytes[i as usize] = digits[(rev_len - i - 1) as usize]
        i = i + 1
    }

    str_from_bytes(bytes, rev_len)
}

// ============================================================================
// SPIR-V constants (standalone — no imports)
// ============================================================================

let ESPV_MAGIC: i64 = 119734787
let ESPV_VERSION: i64 = 65541
let ESPV_GENERATOR: i64 = 42

// Opcodes
let ESPV_OP_EXT_INST_IMPORT: i64 = 11
let ESPV_OP_EXT_INST: i64 = 12
let ESPV_OP_CAPABILITY: i64 = 17
let ESPV_OP_MEMORY_MODEL: i64 = 14
let ESPV_OP_ENTRY_POINT: i64 = 15
let ESPV_OP_EXECUTION_MODE: i64 = 16
let ESPV_OP_TYPE_VOID: i64 = 19
let ESPV_OP_TYPE_BOOL: i64 = 20
let ESPV_OP_TYPE_INT: i64 = 21
let ESPV_OP_TYPE_FLOAT: i64 = 22
let ESPV_OP_TYPE_POINTER: i64 = 32
let ESPV_OP_TYPE_FUNCTION: i64 = 33
let ESPV_OP_CONSTANT: i64 = 43
let ESPV_OP_VARIABLE: i64 = 59
let ESPV_OP_FUNCTION: i64 = 54
let ESPV_OP_FUNCTION_END: i64 = 56
let ESPV_OP_LABEL: i64 = 248
let ESPV_OP_RETURN: i64 = 253
let ESPV_OP_LOAD: i64 = 61
let ESPV_OP_STORE: i64 = 62
let ESPV_OP_ACCESS_CHAIN: i64 = 65
let ESPV_OP_FADD: i64 = 129
let ESPV_OP_FSUB: i64 = 131
let ESPV_OP_FMUL: i64 = 133
let ESPV_OP_FDIV: i64 = 136
let ESPV_OP_FNEGATE: i64 = 127
let ESPV_OP_SELECT: i64 = 169
let ESPV_OP_FORD_LESS_THAN: i64 = 184
let ESPV_OP_LOGICAL_AND: i64 = 167
let ESPV_OP_BITWISE_OR:  i64 = 197    // SPIR-V opcode 197 = OpBitwiseOr
let ESPV_OP_BITWISE_XOR: i64 = 199
let ESPV_OP_CONTROL_BARRIER: i64 = 224
let ESPV_OP_DECORATE: i64 = 71

// Storage classes
let ESPV_STORAGE_BUFFER: i64 = 12

// Capabilities
let ESPV_CAP_SHADER: i64 = 1
let ESPV_CAP_FLOAT64: i64 = 10

// Execution modes
let ESPV_EXEC_GLCOMPUTE: i64 = 5
let ESPV_EXEC_LOCAL_SIZE: i64 = 17

// Addressing/Memory models
let ESPV_ADDR_LOGICAL: i64 = 0
let ESPV_MEM_GLSL450: i64 = 1

// Decorations
let ESPV_DECO_BINDING: i64 = 33
let ESPV_DECO_DESCRIPTOR_SET: i64 = 34
let ESPV_DECO_BUILTIN: i64 = 11
let ESPV_BUILTIN_GLOBAL_INVOCATION_ID: i64 = 28

// GLSL.std.450 extended instruction opcodes
let GLSL_STD_FABS: i64 = 4
let GLSL_STD_SQRT: i64 = 31

// GPU opcode tags (matching kernel_ir.sio)
let ESPV_GPU_OP_ADD: i64 = 3
let ESPV_GPU_OP_SUB: i64 = 4
let ESPV_GPU_OP_MUL: i64 = 5
let ESPV_GPU_OP_DIV: i64 = 6

// ============================================================================
// ESpvBuf — binary buffer (32-bit word oriented)
// ============================================================================

pub struct ESpvBuf {
    words: [i64; 16384],
    word_count: i64,
}

fn espv_buf_new() -> ESpvBuf {
    ESpvBuf { words: [0; 16384], word_count: 0 }
}

fn espv_push_word(buf: ESpvBuf, w: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    if out.word_count < 16384 {
        out.words[out.word_count as usize] = w % 4294967296
        out.word_count = out.word_count + 1
    }
    out
}

// Encode an instruction: word_count << 16 | opcode
fn espv_encode_op(word_count: i64, opcode: i64) -> i64 {
    ((word_count % 65536) * 65536) + (opcode % 65536)
}

// Push a string as packed SPIR-V words (4 bytes per word, null-padded)
fn espv_push_string(buf: ESpvBuf, s: string) -> ESpvBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0

    while i < n {
        var w: i64 = 0
        if i < n { w = w + ((str_char_at(s, i) as i64) % 256) }
        if i + 1 < n { w = w + (((str_char_at(s, i + 1) as i64) % 256) * 256) }
        if i + 2 < n { w = w + (((str_char_at(s, i + 2) as i64) % 256) * 65536) }
        if i + 3 < n { w = w + (((str_char_at(s, i + 3) as i64) % 256) * 16777216) }
        out = espv_push_word(out, w)
        i = i + 4
    }

    if n % 4 == 0 {
        out = espv_push_word(out, 0)
    }

    out
}

// Number of words needed for a string (including null padding)
fn espv_string_word_count(s: string) -> i64 with Div, Panic {
    let n = str_len(s)
    (n / 4) + 1
}

// ============================================================================
// ID allocator
// ============================================================================

struct ESpvIdAlloc {
    next_id: i64,
}

fn espv_id_alloc_new() -> ESpvIdAlloc {
    ESpvIdAlloc { next_id: 1 }
}

fn espv_alloc_id(a: ESpvIdAlloc) -> (ESpvIdAlloc, i64) with Mut {
    var out = a
    let id = out.next_id
    out.next_id = out.next_id + 1
    (out, id)
}

// ============================================================================
// EpistemicShadowSpv — 4 SPIR-V result IDs per Knowledge<T>
// ============================================================================

struct EpistemicShadowSpv {
    val_id:   i64,
    eps_id:   i64,
    valid_id: i64,
    prov_id:  i64,
}

fn espv_shadow_new(val: i64, eps: i64, valid: i64, prov: i64) -> EpistemicShadowSpv {
    EpistemicShadowSpv { val_id: val, eps_id: eps, valid_id: valid, prov_id: prov }
}

fn espv_shadow_zero() -> EpistemicShadowSpv {
    EpistemicShadowSpv { val_id: 0, eps_id: 0, valid_id: 0, prov_id: 0 }
}

// ============================================================================
// EpistemicSpvTypes — cached type IDs for epistemic computation
// ============================================================================

struct EpistemicSpvTypes {
    void_id: i64,
    bool_id: i64,
    f64_id:  i64,
    u64_id:  i64,
    ptr_f64_storage_id: i64,
    ptr_u64_storage_id: i64,
    func_void_id: i64,
    glsl_import_id: i64,
}

fn espv_types_new() -> EpistemicSpvTypes {
    EpistemicSpvTypes {
        void_id: 0, bool_id: 0, f64_id: 0, u64_id: 0,
        ptr_f64_storage_id: 0, ptr_u64_storage_id: 0,
        func_void_id: 0, glsl_import_id: 0,
    }
}

// ============================================================================
// Emit helpers — thin wrappers for common SPIR-V patterns
// ============================================================================

fn espv_emit_capability(buf: ESpvBuf, cap: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(2, ESPV_OP_CAPABILITY))
    out = espv_push_word(out, cap)
    out
}

fn espv_emit_memory_model(buf: ESpvBuf, addressing: i64, memory: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(3, ESPV_OP_MEMORY_MODEL))
    out = espv_push_word(out, addressing)
    out = espv_push_word(out, memory)
    out
}

fn espv_emit_ext_inst_import(buf: ESpvBuf, result_id: i64, name: string) -> ESpvBuf with Mut, Panic, Div {
    var out = buf
    let str_words = espv_string_word_count(name)
    let total_words = 2 + str_words
    out = espv_push_word(out, espv_encode_op(total_words, ESPV_OP_EXT_INST_IMPORT))
    out = espv_push_word(out, result_id)
    out = espv_push_string(out, name)
    out
}

fn espv_emit_entry_point(
    buf: ESpvBuf, exec_model: i64, func_id: i64, name: string,
    interface_ids: [i64; 8], interface_count: i64
) -> ESpvBuf with Mut, Panic, Div {
    var out = buf
    let str_words = espv_string_word_count(name)
    let total_words = 3 + str_words + interface_count
    out = espv_push_word(out, espv_encode_op(total_words, ESPV_OP_ENTRY_POINT))
    out = espv_push_word(out, exec_model)
    out = espv_push_word(out, func_id)
    out = espv_push_string(out, name)
    var i: i64 = 0
    while i < interface_count {
        out = espv_push_word(out, interface_ids[i as usize])
        i = i + 1
    }
    out
}

fn espv_emit_execution_mode_local_size(
    buf: ESpvBuf, func_id: i64, x: i64, y: i64, z: i64
) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(6, ESPV_OP_EXECUTION_MODE))
    out = espv_push_word(out, func_id)
    out = espv_push_word(out, ESPV_EXEC_LOCAL_SIZE)
    out = espv_push_word(out, x)
    out = espv_push_word(out, y)
    out = espv_push_word(out, z)
    out
}

fn espv_emit_type_void(buf: ESpvBuf, result_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(2, ESPV_OP_TYPE_VOID))
    out = espv_push_word(out, result_id)
    out
}

fn espv_emit_type_bool(buf: ESpvBuf, result_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(2, ESPV_OP_TYPE_BOOL))
    out = espv_push_word(out, result_id)
    out
}

fn espv_emit_type_int(buf: ESpvBuf, result_id: i64, width: i64, signedness: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(4, ESPV_OP_TYPE_INT))
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, width)
    out = espv_push_word(out, signedness)
    out
}

fn espv_emit_type_float(buf: ESpvBuf, result_id: i64, width: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(3, ESPV_OP_TYPE_FLOAT))
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, width)
    out
}

fn espv_emit_type_pointer(buf: ESpvBuf, result_id: i64, storage_class: i64, type_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(4, ESPV_OP_TYPE_POINTER))
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, storage_class)
    out = espv_push_word(out, type_id)
    out
}

fn espv_emit_type_function(buf: ESpvBuf, result_id: i64, return_type: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(3, ESPV_OP_TYPE_FUNCTION))
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, return_type)
    out
}

fn espv_emit_decorate(buf: ESpvBuf, target: i64, decoration: i64, value: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(4, ESPV_OP_DECORATE))
    out = espv_push_word(out, target)
    out = espv_push_word(out, decoration)
    out = espv_push_word(out, value)
    out
}

fn espv_emit_variable(buf: ESpvBuf, type_id: i64, result_id: i64, storage_class: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(4, ESPV_OP_VARIABLE))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, storage_class)
    out
}

fn espv_emit_constant_u64(buf: ESpvBuf, type_id: i64, result_id: i64, lo: i64, hi: i64) -> ESpvBuf with Mut, Panic {
    // OpConstant for 64-bit: 2 literal words (lo, hi)
    var out = buf
    out = espv_push_word(out, espv_encode_op(5, ESPV_OP_CONSTANT))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, lo % 4294967296)
    out = espv_push_word(out, hi % 4294967296)
    out
}

fn espv_emit_constant_f64(buf: ESpvBuf, type_id: i64, result_id: i64, lo: i64, hi: i64) -> ESpvBuf with Mut, Panic {
    // OpConstant for f64: 2 literal words (IEEE 754 double, split low/high)
    var out = buf
    out = espv_push_word(out, espv_encode_op(5, ESPV_OP_CONSTANT))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, lo % 4294967296)
    out = espv_push_word(out, hi % 4294967296)
    out
}

fn espv_emit_function(buf: ESpvBuf, result_type: i64, result_id: i64, control: i64, func_type: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(5, ESPV_OP_FUNCTION))
    out = espv_push_word(out, result_type)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, control)
    out = espv_push_word(out, func_type)
    out
}

fn espv_emit_function_end(buf: ESpvBuf) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(1, ESPV_OP_FUNCTION_END))
    out
}

fn espv_emit_label(buf: ESpvBuf, result_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(2, ESPV_OP_LABEL))
    out = espv_push_word(out, result_id)
    out
}

fn espv_emit_return(buf: ESpvBuf) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(1, ESPV_OP_RETURN))
    out
}

fn espv_emit_load(buf: ESpvBuf, type_id: i64, result_id: i64, pointer_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(4, ESPV_OP_LOAD))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, pointer_id)
    out
}

fn espv_emit_store(buf: ESpvBuf, pointer_id: i64, value_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(3, ESPV_OP_STORE))
    out = espv_push_word(out, pointer_id)
    out = espv_push_word(out, value_id)
    out
}

fn espv_emit_access_chain(buf: ESpvBuf, type_id: i64, result_id: i64, base_id: i64, index_id: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(5, ESPV_OP_ACCESS_CHAIN))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, base_id)
    out = espv_push_word(out, index_id)
    out
}

// Emit a binary arithmetic instruction (5 words: op, type, result, op1, op2)
fn espv_emit_binary_op(buf: ESpvBuf, opcode: i64, type_id: i64, result_id: i64, op1: i64, op2: i64) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(5, opcode))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, op1)
    out = espv_push_word(out, op2)
    out
}

// Emit OpExtInst for GLSL.std.450 unary instructions (e.g., FAbs, Sqrt)
fn espv_emit_ext_inst_unary(
    buf: ESpvBuf, type_id: i64, result_id: i64,
    import_id: i64, ext_opcode: i64, operand_id: i64
) -> ESpvBuf with Mut, Panic {
    // OpExtInst: word_count=6
    var out = buf
    out = espv_push_word(out, espv_encode_op(6, ESPV_OP_EXT_INST))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, import_id)
    out = espv_push_word(out, ext_opcode)
    out = espv_push_word(out, operand_id)
    out
}

// Emit OpSelect: word_count=6 (opcode, type, result, condition, true_val, false_val)
fn espv_emit_select(
    buf: ESpvBuf, type_id: i64, result_id: i64,
    condition_id: i64, true_id: i64, false_id: i64
) -> ESpvBuf with Mut, Panic {
    var out = buf
    out = espv_push_word(out, espv_encode_op(6, ESPV_OP_SELECT))
    out = espv_push_word(out, type_id)
    out = espv_push_word(out, result_id)
    out = espv_push_word(out, condition_id)
    out = espv_push_word(out, true_id)
    out = espv_push_word(out, false_id)
    out
}

// ============================================================================
// Shadow map — maps logical variable index to EpistemicShadowSpv
// ============================================================================

struct ESpvShadowEntry {
    idx: i64,
    shadow: EpistemicShadowSpv,
}

fn espv_shadow_entry_new() -> ESpvShadowEntry {
    ESpvShadowEntry { idx: 0, shadow: espv_shadow_zero() }
}

struct ESpvShadowMap {
    entries: [ESpvShadowEntry; 256],
    count: i64,
}

fn espv_shadow_map_new() -> ESpvShadowMap {
    ESpvShadowMap {
        entries: [espv_shadow_entry_new(); 256],
        count: 0,
    }
}

fn espv_shadow_map_insert(map: ESpvShadowMap, idx: i64, shadow: EpistemicShadowSpv) -> ESpvShadowMap with Mut, Panic, Div {
    var out = map
    // Check if already exists — update in place
    var i: i64 = 0
    while i < out.count {
        if out.entries[i as usize].idx == idx {
            out.entries[i as usize] = ESpvShadowEntry { idx: idx, shadow: shadow }
            return out
        }
        i = i + 1
    }
    // New entry
    if out.count < 256 {
        out.entries[out.count as usize] = ESpvShadowEntry { idx: idx, shadow: shadow }
        out.count = out.count + 1
    }
    out
}

fn espv_shadow_map_lookup(map: ESpvShadowMap, idx: i64) -> EpistemicShadowSpv with Mut, Panic, Div {
    var i: i64 = 0
    while i < map.count {
        if map.entries[i as usize].idx == idx {
            return map.entries[i as usize].shadow
        }
        i = i + 1
    }
    espv_shadow_zero()
}

// ============================================================================
// GUM Arithmetic Emitters — the core epistemic SPIR-V codegen
// ============================================================================

// Additive propagation: e_c = sqrt(e_a^2 + e_b^2)  [quadrature]
// Works for both Add and Sub (uncertainty is the same by GUM).
fn espv_emit_add(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    a: EpistemicShadowSpv, b: EpistemicShadowSpv,
    is_sub: bool
) -> (ESpvBuf, ESpvIdAlloc, EpistemicShadowSpv) with Mut, Panic {
    var out = buf
    var alloc = ids

    // 1. Value: val_c = a.val +/- b.val
    let (alloc1, val_c) = espv_alloc_id(alloc)
    alloc = alloc1
    if is_sub {
        out = espv_emit_binary_op(out, ESPV_OP_FSUB, types.f64_id, val_c, a.val_id, b.val_id)
    } else {
        out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, val_c, a.val_id, b.val_id)
    }

    // 2. Epsilon: e_c = sqrt(e_a^2 + e_b^2)
    // e_a^2
    let (alloc2, eps_a_sq) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, eps_a_sq, a.eps_id, a.eps_id)

    // e_b^2
    let (alloc3, eps_b_sq) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, eps_b_sq, b.eps_id, b.eps_id)

    // e_a^2 + e_b^2
    let (alloc4, eps_sum_sq) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, eps_sum_sq, eps_a_sq, eps_b_sq)

    // sqrt(e_a^2 + e_b^2)
    let (alloc5, eps_c) = espv_alloc_id(alloc)
    alloc = alloc5
    out = espv_emit_ext_inst_unary(out, types.f64_id, eps_c, types.glsl_import_id, GLSL_STD_SQRT, eps_sum_sq)

    // 3. Validity: valid_c = valid_a AND valid_b
    let (alloc6, valid_c) = espv_alloc_id(alloc)
    alloc = alloc6
    out = espv_emit_binary_op(out, ESPV_OP_LOGICAL_AND, types.bool_id, valid_c, a.valid_id, b.valid_id)

    // 4. Provenance: prov_c = prov_a OR prov_b (monotonic union)
    let (alloc7, prov_c) = espv_alloc_id(alloc)
    alloc = alloc7
    out = espv_emit_binary_op(out, ESPV_OP_BITWISE_OR, types.u64_id, prov_c, a.prov_id, b.prov_id)

    let shadow_c = espv_shadow_new(val_c, eps_c, valid_c, prov_c)
    (out, alloc, shadow_c)
}

// Multiplicative propagation: e_c = |a|*e_b + |b|*e_a  [first-order]
fn espv_emit_mul(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    a: EpistemicShadowSpv, b: EpistemicShadowSpv
) -> (ESpvBuf, ESpvIdAlloc, EpistemicShadowSpv) with Mut, Panic {
    var out = buf
    var alloc = ids

    // 1. Value: val_c = a.val * b.val
    let (alloc1, val_c) = espv_alloc_id(alloc)
    alloc = alloc1
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, val_c, a.val_id, b.val_id)

    // 2. Epsilon: |a| * e_b + |b| * e_a
    // |a|
    let (alloc2, abs_a) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_a, types.glsl_import_id, GLSL_STD_FABS, a.val_id)

    // |b|
    let (alloc3, abs_b) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_b, types.glsl_import_id, GLSL_STD_FABS, b.val_id)

    // |a| * e_b
    let (alloc4, term1) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, term1, abs_a, b.eps_id)

    // |b| * e_a
    let (alloc5, term2) = espv_alloc_id(alloc)
    alloc = alloc5
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, term2, abs_b, a.eps_id)

    // |a|*e_b + |b|*e_a
    let (alloc6, eps_c) = espv_alloc_id(alloc)
    alloc = alloc6
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, eps_c, term1, term2)

    // 3. Validity
    let (alloc7, valid_c) = espv_alloc_id(alloc)
    alloc = alloc7
    out = espv_emit_binary_op(out, ESPV_OP_LOGICAL_AND, types.bool_id, valid_c, a.valid_id, b.valid_id)

    // 4. Provenance: prov_c = prov_a OR prov_b (monotonic union)
    let (alloc8, prov_c) = espv_alloc_id(alloc)
    alloc = alloc8
    out = espv_emit_binary_op(out, ESPV_OP_BITWISE_OR, types.u64_id, prov_c, a.prov_id, b.prov_id)

    let shadow_c = espv_shadow_new(val_c, eps_c, valid_c, prov_c)
    (out, alloc, shadow_c)
}

// Division propagation: e_c = (|a|*e_b + |b|*e_a) / b^2  with near-zero guard
fn espv_emit_div(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    a: EpistemicShadowSpv, b: EpistemicShadowSpv,
    near_zero_const_id: i64
) -> (ESpvBuf, ESpvIdAlloc, EpistemicShadowSpv) with Mut, Panic {
    var out = buf
    var alloc = ids

    // 1. Value: val_c = a.val / b.val
    let (alloc1, val_c) = espv_alloc_id(alloc)
    alloc = alloc1
    out = espv_emit_binary_op(out, ESPV_OP_FDIV, types.f64_id, val_c, a.val_id, b.val_id)

    // 2. Epsilon numerator: |a|*e_b + |b|*e_a
    let (alloc2, abs_a) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_a, types.glsl_import_id, GLSL_STD_FABS, a.val_id)

    let (alloc3, abs_b) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_b, types.glsl_import_id, GLSL_STD_FABS, b.val_id)

    let (alloc4, term1) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, term1, abs_a, b.eps_id)

    let (alloc5, term2) = espv_alloc_id(alloc)
    alloc = alloc5
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, term2, abs_b, a.eps_id)

    let (alloc6, numer) = espv_alloc_id(alloc)
    alloc = alloc6
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, numer, term1, term2)

    // 3. Denominator: b^2
    let (alloc7, b_sq) = espv_alloc_id(alloc)
    alloc = alloc7
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, b_sq, b.val_id, b.val_id)

    // 4. Near-zero guard: if |b| < near_zero_threshold, use near_zero_threshold^2
    //    b_sq_safe = select(is_near_zero, near_zero_const, b_sq)
    let (alloc8, is_near_zero) = espv_alloc_id(alloc)
    alloc = alloc8
    out = espv_emit_binary_op(out, ESPV_OP_FORD_LESS_THAN, types.bool_id, is_near_zero, abs_b, near_zero_const_id)

    // near_zero^2 for safe denominator
    let (alloc9, nz_sq) = espv_alloc_id(alloc)
    alloc = alloc9
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, nz_sq, near_zero_const_id, near_zero_const_id)

    let (alloc10, b_sq_safe) = espv_alloc_id(alloc)
    alloc = alloc10
    out = espv_emit_select(out, types.f64_id, b_sq_safe, is_near_zero, nz_sq, b_sq)

    // 5. e_c = numerator / b_sq_safe
    let (alloc11, eps_c) = espv_alloc_id(alloc)
    alloc = alloc11
    out = espv_emit_binary_op(out, ESPV_OP_FDIV, types.f64_id, eps_c, numer, b_sq_safe)

    // 6. Validity: AND + invalidate if near-zero
    let (alloc12, valid_ab) = espv_alloc_id(alloc)
    alloc = alloc12
    out = espv_emit_binary_op(out, ESPV_OP_LOGICAL_AND, types.bool_id, valid_ab, a.valid_id, b.valid_id)

    // 7. Provenance: prov_c = prov_a OR prov_b (monotonic union)
    let (alloc13, prov_c) = espv_alloc_id(alloc)
    alloc = alloc13
    out = espv_emit_binary_op(out, ESPV_OP_BITWISE_OR, types.u64_id, prov_c, a.prov_id, b.prov_id)

    let shadow_c = espv_shadow_new(val_c, eps_c, valid_ab, prov_c)
    (out, alloc, shadow_c)
}

// FMA propagation: e_c = sqrt((|a|*e_b + |b|*e_a)^2 + e_addend^2)
fn espv_emit_fma(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    a: EpistemicShadowSpv, b: EpistemicShadowSpv, addend: EpistemicShadowSpv
) -> (ESpvBuf, ESpvIdAlloc, EpistemicShadowSpv) with Mut, Panic {
    var out = buf
    var alloc = ids

    // 1. Value: val_c = a.val * b.val + addend.val
    let (alloc1, mul_ab) = espv_alloc_id(alloc)
    alloc = alloc1
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, mul_ab, a.val_id, b.val_id)

    let (alloc2, val_c) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, val_c, mul_ab, addend.val_id)

    // 2. Epsilon for mul part: |a|*e_b + |b|*e_a
    let (alloc3, abs_a) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_a, types.glsl_import_id, GLSL_STD_FABS, a.val_id)

    let (alloc4, abs_b) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_ext_inst_unary(out, types.f64_id, abs_b, types.glsl_import_id, GLSL_STD_FABS, b.val_id)

    let (alloc5, t1) = espv_alloc_id(alloc)
    alloc = alloc5
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, t1, abs_a, b.eps_id)

    let (alloc6, t2) = espv_alloc_id(alloc)
    alloc = alloc6
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, t2, abs_b, a.eps_id)

    let (alloc7, eps_mul) = espv_alloc_id(alloc)
    alloc = alloc7
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, eps_mul, t1, t2)

    // 3. Combined: sqrt(eps_mul^2 + eps_addend^2)
    let (alloc8, eps_mul_sq) = espv_alloc_id(alloc)
    alloc = alloc8
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, eps_mul_sq, eps_mul, eps_mul)

    let (alloc9, eps_add_sq) = espv_alloc_id(alloc)
    alloc = alloc9
    out = espv_emit_binary_op(out, ESPV_OP_FMUL, types.f64_id, eps_add_sq, addend.eps_id, addend.eps_id)

    let (alloc10, eps_sum) = espv_alloc_id(alloc)
    alloc = alloc10
    out = espv_emit_binary_op(out, ESPV_OP_FADD, types.f64_id, eps_sum, eps_mul_sq, eps_add_sq)

    let (alloc11, eps_c) = espv_alloc_id(alloc)
    alloc = alloc11
    out = espv_emit_ext_inst_unary(out, types.f64_id, eps_c, types.glsl_import_id, GLSL_STD_SQRT, eps_sum)

    // 4. Validity: AND all three
    let (alloc12, v_ab) = espv_alloc_id(alloc)
    alloc = alloc12
    out = espv_emit_binary_op(out, ESPV_OP_LOGICAL_AND, types.bool_id, v_ab, a.valid_id, b.valid_id)

    let (alloc13, valid_c) = espv_alloc_id(alloc)
    alloc = alloc13
    out = espv_emit_binary_op(out, ESPV_OP_LOGICAL_AND, types.bool_id, valid_c, v_ab, addend.valid_id)

    // 5. Provenance: OR all three (monotonic union)
    let (alloc14, p_ab) = espv_alloc_id(alloc)
    alloc = alloc14
    out = espv_emit_binary_op(out, ESPV_OP_BITWISE_OR, types.u64_id, p_ab, a.prov_id, b.prov_id)

    let (alloc15, prov_c) = espv_alloc_id(alloc)
    alloc = alloc15
    out = espv_emit_binary_op(out, ESPV_OP_BITWISE_OR, types.u64_id, prov_c, p_ab, addend.prov_id)

    let shadow_c = espv_shadow_new(val_c, eps_c, valid_c, prov_c)
    (out, alloc, shadow_c)
}

// ============================================================================
// Knowledge<T> memory layout helpers — SoA layout for GPU
// Layout: val[N], eps[N], valid[N], prov[N] with stride offsets
// ============================================================================

// Load a Knowledge<T> from 4 buffer slots via AccessChain + Load
fn espv_emit_knowledge_load(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    base_ptr_id: i64, stride_const_ids: [i64; 4]
) -> (ESpvBuf, ESpvIdAlloc, EpistemicShadowSpv) with Mut, Panic {
    var out = buf
    var alloc = ids

    // AccessChain for val slot
    let (alloc1, ptr_val) = espv_alloc_id(alloc)
    alloc = alloc1
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_val, base_ptr_id, stride_const_ids[0 as usize])

    let (alloc2, val_id) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_load(out, types.f64_id, val_id, ptr_val)

    // AccessChain for eps slot
    let (alloc3, ptr_eps) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_eps, base_ptr_id, stride_const_ids[1 as usize])

    let (alloc4, eps_id) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_load(out, types.f64_id, eps_id, ptr_eps)

    // For valid, we reuse f64 as bit carrier (SPIR-V has no direct bool in buffers)
    // The host packs valid as 1.0/0.0 f64
    let (alloc5, ptr_valid) = espv_alloc_id(alloc)
    alloc = alloc5
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_valid, base_ptr_id, stride_const_ids[2 as usize])

    let (alloc6, valid_f64) = espv_alloc_id(alloc)
    alloc = alloc6
    out = espv_emit_load(out, types.f64_id, valid_f64, ptr_valid)

    // Provenance is u64, but stored via f64 reinterpret for uniform buffer layout
    let (alloc7, ptr_prov) = espv_alloc_id(alloc)
    alloc = alloc7
    out = espv_emit_access_chain(out, types.ptr_u64_storage_id, ptr_prov, base_ptr_id, stride_const_ids[3 as usize])

    let (alloc8, prov_id) = espv_alloc_id(alloc)
    alloc = alloc8
    out = espv_emit_load(out, types.u64_id, prov_id, ptr_prov)

    // Use valid_f64 as a stand-in for the bool; the first use in AND will need
    // a conversion, but we treat it as a bool ID for the shadow structure.
    // In a full pipeline, we'd emit OpFOrdNotEqual(valid_f64, 0.0) here.
    let shadow = espv_shadow_new(val_id, eps_id, valid_f64, prov_id)
    (out, alloc, shadow)
}

// Store a Knowledge<T> to 4 buffer slots via AccessChain + Store
fn espv_emit_knowledge_store(
    buf: ESpvBuf, ids: ESpvIdAlloc, types: EpistemicSpvTypes,
    shadow: EpistemicShadowSpv, base_ptr_id: i64, stride_const_ids: [i64; 4]
) -> (ESpvBuf, ESpvIdAlloc) with Mut, Panic {
    var out = buf
    var alloc = ids

    // Store val
    let (alloc1, ptr_val) = espv_alloc_id(alloc)
    alloc = alloc1
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_val, base_ptr_id, stride_const_ids[0 as usize])
    out = espv_emit_store(out, ptr_val, shadow.val_id)

    // Store eps
    let (alloc2, ptr_eps) = espv_alloc_id(alloc)
    alloc = alloc2
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_eps, base_ptr_id, stride_const_ids[1 as usize])
    out = espv_emit_store(out, ptr_eps, shadow.eps_id)

    // Store valid
    let (alloc3, ptr_valid) = espv_alloc_id(alloc)
    alloc = alloc3
    out = espv_emit_access_chain(out, types.ptr_f64_storage_id, ptr_valid, base_ptr_id, stride_const_ids[2 as usize])
    out = espv_emit_store(out, ptr_valid, shadow.valid_id)

    // Store prov
    let (alloc4, ptr_prov) = espv_alloc_id(alloc)
    alloc = alloc4
    out = espv_emit_access_chain(out, types.ptr_u64_storage_id, ptr_prov, base_ptr_id, stride_const_ids[3 as usize])
    out = espv_emit_store(out, ptr_prov, shadow.prov_id)

    (out, alloc)
}

// ============================================================================
// Allocate all epistemic types and constants
// ============================================================================

fn espv_allocate_types(
    buf: ESpvBuf, ids: ESpvIdAlloc
) -> (ESpvBuf, ESpvIdAlloc, EpistemicSpvTypes) with Mut, Panic, Div {
    var out = buf
    var alloc = ids
    var types = espv_types_new()

    // OpTypeVoid
    let (a1, void_id) = espv_alloc_id(alloc)
    alloc = a1
    out = espv_emit_type_void(out, void_id)
    types.void_id = void_id

    // OpTypeBool
    let (a2, bool_id) = espv_alloc_id(alloc)
    alloc = a2
    out = espv_emit_type_bool(out, bool_id)
    types.bool_id = bool_id

    // OpTypeFloat(64) — f64
    let (a3, f64_id) = espv_alloc_id(alloc)
    alloc = a3
    out = espv_emit_type_float(out, f64_id, 64)
    types.f64_id = f64_id

    // OpTypeInt(64, unsigned) — u64
    let (a4, u64_id) = espv_alloc_id(alloc)
    alloc = a4
    out = espv_emit_type_int(out, u64_id, 64, 0)
    types.u64_id = u64_id

    // OpTypePointer(StorageBuffer, f64)
    let (a5, ptr_f64) = espv_alloc_id(alloc)
    alloc = a5
    out = espv_emit_type_pointer(out, ptr_f64, ESPV_STORAGE_BUFFER, f64_id)
    types.ptr_f64_storage_id = ptr_f64

    // OpTypePointer(StorageBuffer, u64)
    let (a6, ptr_u64) = espv_alloc_id(alloc)
    alloc = a6
    out = espv_emit_type_pointer(out, ptr_u64, ESPV_STORAGE_BUFFER, u64_id)
    types.ptr_u64_storage_id = ptr_u64

    // OpTypeFunction(void)
    let (a7, func_void) = espv_alloc_id(alloc)
    alloc = a7
    out = espv_emit_type_function(out, func_void, void_id)
    types.func_void_id = func_void

    // OpExtInstImport "GLSL.std.450"
    let (a8, glsl_id) = espv_alloc_id(alloc)
    alloc = a8
    out = espv_emit_ext_inst_import(out, glsl_id, "GLSL.std.450")
    types.glsl_import_id = glsl_id

    (out, alloc, types)
}

// ============================================================================
// Top-level lowering: gpu_lower_to_epistemic_spirv
// ============================================================================

pub fn gpu_lower_to_epistemic_spirv(
    kernel_name: string,
    param_count: i64,
    ops_opcodes: [i64; 256],
    ops_dst: [i64; 256],
    ops_src_a: [i64; 256],
    ops_src_b: [i64; 256],
    ops_type_tags: [i64; 256],
    ops_count: i64
) -> ESpvBuf with Mut, Panic, Div {
    var buf = espv_buf_new()
    var alloc = espv_id_alloc_new()

    // ---- Phase 1: Capabilities ----
    buf = espv_emit_capability(buf, ESPV_CAP_SHADER)
    buf = espv_emit_capability(buf, ESPV_CAP_FLOAT64)

    // ---- Phase 2: Memory model ----
    buf = espv_emit_memory_model(buf, ESPV_ADDR_LOGICAL, ESPV_MEM_GLSL450)

    // ---- Phase 3: Allocate types ----
    let (buf2, alloc2, types) = espv_allocate_types(buf, alloc)
    buf = buf2
    alloc = alloc2

    // ---- Phase 4: Allocate near-zero constant for div guard ----
    // 1e-30 as f64: low=0x00000000, high=0x39B4C6F9 (approx)
    // We use a simpler encoding: just a small positive f64
    let (alloc_nz1, nz_const_id) = espv_alloc_id(alloc)
    alloc = alloc_nz1
    buf = espv_emit_constant_f64(buf, types.f64_id, nz_const_id, 0, 968018937)

    // ---- Phase 5: Allocate function + label IDs ----
    let (alloc_fn, func_id) = espv_alloc_id(alloc)
    alloc = alloc_fn
    let (alloc_lbl, label_id) = espv_alloc_id(alloc)
    alloc = alloc_lbl

    // ---- Phase 6: Emit storage buffer variables + decorations ----
    var param_var_ids: [i64; 8] = [0; 8]
    var pi: i64 = 0
    while pi < param_count {
        if pi < 8 {
            let (alloc_p, var_id) = espv_alloc_id(alloc)
            alloc = alloc_p
            buf = espv_emit_variable(buf, types.ptr_f64_storage_id, var_id, ESPV_STORAGE_BUFFER)
            buf = espv_emit_decorate(buf, var_id, ESPV_DECO_BINDING, pi)
            buf = espv_emit_decorate(buf, var_id, ESPV_DECO_DESCRIPTOR_SET, 0)
            param_var_ids[pi as usize] = var_id
        }
        pi = pi + 1
    }

    // ---- Phase 7: Entry point ----
    var iface_ids: [i64; 8] = [0; 8]
    var iface_count: i64 = 0
    var qi: i64 = 0
    while qi < param_count {
        if qi < 8 {
            if iface_count < 8 {
                iface_ids[iface_count as usize] = param_var_ids[qi as usize]
                iface_count = iface_count + 1
            }
        }
        qi = qi + 1
    }
    buf = espv_emit_entry_point(buf, ESPV_EXEC_GLCOMPUTE, func_id, kernel_name, iface_ids, iface_count)

    // ---- Phase 8: Execution mode (LocalSize 64, 1, 1) ----
    buf = espv_emit_execution_mode_local_size(buf, func_id, 64, 1, 1)

    // ---- Phase 9: Function begin ----
    buf = espv_emit_function(buf, types.void_id, func_id, 0, types.func_void_id)
    buf = espv_emit_label(buf, label_id)

    // ---- Phase 10: Walk ops, dispatch to GUM emitters ----
    var shadow_map = espv_shadow_map_new()

    // Pre-populate shadow map: for each parameter, create placeholder shadows
    // In a full pipeline, these would come from knowledge_load. Here we allocate
    // dummy IDs so the emitters can reference them.
    var ri: i64 = 0
    while ri < 64 {
        let (a_v, v_id) = espv_alloc_id(alloc)
        alloc = a_v
        let (a_e, e_id) = espv_alloc_id(alloc)
        alloc = a_e
        let (a_vl, vl_id) = espv_alloc_id(alloc)
        alloc = a_vl
        let (a_p, p_id) = espv_alloc_id(alloc)
        alloc = a_p
        shadow_map = espv_shadow_map_insert(shadow_map, ri, espv_shadow_new(v_id, e_id, vl_id, p_id))
        ri = ri + 1
    }

    var oi: i64 = 0
    while oi < ops_count {
        if oi < 256 {
            let opc = ops_opcodes[oi as usize]
            let dst = ops_dst[oi as usize]
            let src_a = ops_src_a[oi as usize]
            let src_b = ops_src_b[oi as usize]

            let shadow_a = espv_shadow_map_lookup(shadow_map, src_a)
            let shadow_b = espv_shadow_map_lookup(shadow_map, src_b)

            if opc == ESPV_GPU_OP_ADD {
                let (buf3, alloc3, shadow_c) = espv_emit_add(buf, alloc, types, shadow_a, shadow_b, false)
                buf = buf3
                alloc = alloc3
                shadow_map = espv_shadow_map_insert(shadow_map, dst, shadow_c)
            }
            if opc == ESPV_GPU_OP_SUB {
                let (buf4, alloc4, shadow_c) = espv_emit_add(buf, alloc, types, shadow_a, shadow_b, true)
                buf = buf4
                alloc = alloc4
                shadow_map = espv_shadow_map_insert(shadow_map, dst, shadow_c)
            }
            if opc == ESPV_GPU_OP_MUL {
                let (buf5, alloc5, shadow_c) = espv_emit_mul(buf, alloc, types, shadow_a, shadow_b)
                buf = buf5
                alloc = alloc5
                shadow_map = espv_shadow_map_insert(shadow_map, dst, shadow_c)
            }
            if opc == ESPV_GPU_OP_DIV {
                let (buf6, alloc6, shadow_c) = espv_emit_div(buf, alloc, types, shadow_a, shadow_b, nz_const_id)
                buf = buf6
                alloc = alloc6
                shadow_map = espv_shadow_map_insert(shadow_map, dst, shadow_c)
            }
        }
        oi = oi + 1
    }

    // ---- Phase 11: Function end ----
    buf = espv_emit_return(buf)
    buf = espv_emit_function_end(buf)

    // ---- Phase 12: Build final buffer with header ----
    let bound = alloc.next_id
    var final_buf = espv_buf_new()
    final_buf = espv_push_word(final_buf, ESPV_MAGIC)
    final_buf = espv_push_word(final_buf, ESPV_VERSION)
    final_buf = espv_push_word(final_buf, ESPV_GENERATOR)
    final_buf = espv_push_word(final_buf, bound)
    final_buf = espv_push_word(final_buf, 0)

    var ci: i64 = 0
    while ci < buf.word_count {
        final_buf = espv_push_word(final_buf, buf.words[ci as usize])
        ci = ci + 1
    }

    final_buf
}

// ============================================================================
// Utility: scan buffer for a specific word value
// ============================================================================

fn espv_buf_contains_word(buf: ESpvBuf, word: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < buf.word_count {
        if buf.words[i as usize] == word {
            return true
        }
        i = i + 1
    }
    false
}

// Count how many times a specific opcode appears in the buffer
// (check low 16 bits of each instruction word)
fn espv_buf_count_opcode(buf: ESpvBuf, opcode: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < buf.word_count {
        let w = buf.words[i as usize]
        let op = w % 65536
        let wc = w / 65536
        if op == opcode {
            count = count + 1
            // Skip over the instruction words
            if wc > 1 {
                i = i + wc
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    count
}

// ============================================================================
// Self-tests
// ============================================================================

fn espv_test_shadow_construction() -> bool {
    let s = espv_shadow_new(10, 20, 30, 40)
    s.val_id == 10 && s.eps_id == 20 && s.valid_id == 30 && s.prov_id == 40
}

fn espv_test_buf_push() -> bool with Mut, Panic {
    var buf = espv_buf_new()
    buf = espv_push_word(buf, 42)
    buf = espv_push_word(buf, 99)
    buf.word_count == 2 && buf.words[0] == 42 && buf.words[1] == 99
}

fn espv_test_encode_op() -> bool {
    // word_count=5, opcode=129 (FADD) => (5 << 16) | 129 = 327809
    let enc = espv_encode_op(5, 129)
    enc == 327809
}

fn espv_test_gum_add() -> bool with Mut, Panic {
    var buf = espv_buf_new()
    var alloc = espv_id_alloc_new()
    var types = espv_types_new()
    types.f64_id = 1
    types.bool_id = 2
    types.u64_id = 3
    types.glsl_import_id = 4

    let a = espv_shadow_new(10, 11, 12, 13)
    let b = espv_shadow_new(20, 21, 22, 23)

    let (buf2, alloc2, c) = espv_emit_add(buf, alloc, types, a, b, false)

    // Result shadow should have non-zero IDs
    c.val_id > 0 && c.eps_id > 0 && c.valid_id > 0 && c.prov_id > 0 &&
    // Buffer should have words emitted (FADD + FMUL*2 + FADD + sqrt + AND + XOR)
    buf2.word_count > 0
}

fn espv_test_gum_mul() -> bool with Mut, Panic {
    var buf = espv_buf_new()
    var alloc = espv_id_alloc_new()
    var types = espv_types_new()
    types.f64_id = 1
    types.bool_id = 2
    types.u64_id = 3
    types.glsl_import_id = 4

    let a = espv_shadow_new(10, 11, 12, 13)
    let b = espv_shadow_new(20, 21, 22, 23)

    let (buf2, alloc2, c) = espv_emit_mul(buf, alloc, types, a, b)

    c.val_id > 0 && c.eps_id > 0 && c.valid_id > 0 && c.prov_id > 0 &&
    buf2.word_count > 0
}

fn espv_test_gum_div() -> bool with Mut, Panic {
    var buf = espv_buf_new()
    var alloc = espv_id_alloc_new()
    var types = espv_types_new()
    types.f64_id = 1
    types.bool_id = 2
    types.u64_id = 3
    types.glsl_import_id = 4

    let a = espv_shadow_new(10, 11, 12, 13)
    let b = espv_shadow_new(20, 21, 22, 23)

    let (buf2, alloc2, c) = espv_emit_div(buf, alloc, types, a, b, 50)

    // Div emitter must produce near-zero guard (OpFOrdLessThan + OpSelect)
    c.val_id > 0 && c.eps_id > 0 && c.valid_id > 0 && c.prov_id > 0 &&
    buf2.word_count > 0 &&
    // Should have emitted more instructions than add (div is more complex)
    buf2.word_count > 20
}

fn espv_test_knowledge_roundtrip() -> bool with Mut, Panic {
    var buf = espv_buf_new()
    var alloc = espv_id_alloc_new()
    var types = espv_types_new()
    types.f64_id = 1
    types.u64_id = 2
    types.ptr_f64_storage_id = 3
    types.ptr_u64_storage_id = 4

    var strides: [i64; 4] = [100, 101, 102, 103]

    let (buf2, alloc2, shadow) = espv_emit_knowledge_load(buf, alloc, types, 50, strides)

    // Shadow should have valid IDs
    shadow.val_id > 0 && shadow.eps_id > 0 &&
    shadow.valid_id > 0 && shadow.prov_id > 0 &&
    buf2.word_count > 0
}

fn espv_test_full_pipeline() -> bool with Mut, Panic, Div {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]

    // Op 0: add r2 = r0 + r1
    opcodes[0] = ESPV_GPU_OP_ADD
    dsts[0] = 2
    src_a[0] = 0
    src_b[0] = 1
    tags[0] = 1

    // Op 1: mul r3 = r2 * r1
    opcodes[1] = ESPV_GPU_OP_MUL
    dsts[1] = 3
    src_a[1] = 2
    src_b[1] = 1
    tags[1] = 1

    // Op 2: div r4 = r3 / r0
    opcodes[2] = ESPV_GPU_OP_DIV
    dsts[2] = 4
    src_a[2] = 3
    src_b[2] = 0
    tags[2] = 1

    let result = gpu_lower_to_epistemic_spirv("epistemic_kernel", 2, opcodes, dsts, src_a, src_b, tags, 3)

    // Verify SPIR-V structure
    result.words[0] == ESPV_MAGIC &&
    result.word_count > 50 &&
    result.words[1] == ESPV_VERSION &&
    result.words[2] == ESPV_GENERATOR
}

fn espv_test_magic_number() -> bool with Mut, Panic, Div {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]

    let result = gpu_lower_to_epistemic_spirv("test", 1, opcodes, dsts, src_a, src_b, tags, 0)
    result.words[0] == ESPV_MAGIC
}

fn espv_test_capability_float64() -> bool with Mut, Panic, Div {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var tags: [i64; 256] = [0; 256]

    let result = gpu_lower_to_epistemic_spirv("test_cap", 1, opcodes, dsts, src_a, src_b, tags, 0)

    // Check that Float64 capability (10) appears in the buffer
    espv_buf_contains_word(result, ESPV_CAP_FLOAT64)
}

fn espv_test_main() with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    // T1: EpistemicShadowSpv construction
    if espv_test_shadow_construction() {
        passed = passed + 1
        print("  T1  OK (EpistemicShadowSpv construction)\n")
    } else {
        print("  FAIL T1 (EpistemicShadowSpv construction)\n")
    }
    total = total + 1

    // T2: espv_buf_new + push_word
    if espv_test_buf_push() {
        passed = passed + 1
        print("  T2  OK (espv_buf_new + push_word)\n")
    } else {
        print("  FAIL T2 (espv_buf_new + push_word)\n")
    }
    total = total + 1

    // T3: espv_encode_op
    if espv_test_encode_op() {
        passed = passed + 1
        print("  T3  OK (espv_encode_op)\n")
    } else {
        print("  FAIL T3 (espv_encode_op)\n")
    }
    total = total + 1

    // T4: GUM add emitter produces non-zero shadow IDs
    if espv_test_gum_add() {
        passed = passed + 1
        print("  T4  OK (GUM add: quadrature epsilon + sqrt)\n")
    } else {
        print("  FAIL T4 (GUM add)\n")
    }
    total = total + 1

    // T5: GUM mul emitter
    if espv_test_gum_mul() {
        passed = passed + 1
        print("  T5  OK (GUM mul: first-order |a|*e_b + |b|*e_a)\n")
    } else {
        print("  FAIL T5 (GUM mul)\n")
    }
    total = total + 1

    // T6: GUM div emitter with near-zero guard
    if espv_test_gum_div() {
        passed = passed + 1
        print("  T6  OK (GUM div: near-zero guard + OpSelect)\n")
    } else {
        print("  FAIL T6 (GUM div)\n")
    }
    total = total + 1

    // T7: Knowledge load/store roundtrip
    if espv_test_knowledge_roundtrip() {
        passed = passed + 1
        print("  T7  OK (Knowledge load: 4-slot AccessChain)\n")
    } else {
        print("  FAIL T7 (Knowledge load)\n")
    }
    total = total + 1

    // T8: Full gpu_lower_to_epistemic_spirv with test kernel
    if espv_test_full_pipeline() {
        passed = passed + 1
        print("  T8  OK (full epistemic SPIR-V pipeline: add+mul+div)\n")
    } else {
        print("  FAIL T8 (full pipeline)\n")
    }
    total = total + 1

    // T9: SPIR-V magic number check
    if espv_test_magic_number() {
        passed = passed + 1
        print("  T9  OK (SPIR-V magic 0x07230203)\n")
    } else {
        print("  FAIL T9 (SPIR-V magic)\n")
    }
    total = total + 1

    // T10: Capability Float64 present
    if espv_test_capability_float64() {
        passed = passed + 1
        print("  T10 OK (Capability Float64 in output)\n")
    } else {
        print("  FAIL T10 (Capability Float64)\n")
    }
    total = total + 1

    if passed == total {
        print("epistemic_spirv: all " ++ espv_i64_to_string(total) ++ " tests passed\n")
    } else {
        print("epistemic_spirv: " ++ espv_i64_to_string(passed) ++ "/" ++ espv_i64_to_string(total) ++ " passed\n")
    }
}
