use kernel_ir::*
use lower_to_ptx::*

fn append_op(kernel: GpuKernelIr, op: GpuOp) -> GpuKernelIr {
    var out = kernel
    out.ops[out.op_count as usize] = op
    out.op_count = out.op_count + 1
    out
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var kernel = gpu_kernel_new()
    kernel.kernel_name = ki_ir_name_from_bytes(120, 111, 114, 49, 4)
    kernel.max_threads = 16

    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuXorConvolutionF64
    op.lhs_reg = 0
    op.rhs_reg = 1
    op.addr_reg = 2
    op.rhs_imm = 16
    kernel = append_op(kernel, op)

    let ptx = gpu_lower_to_ptx_for_target(kernel, true)
    let implicit_target = gpu_lower_to_ptx(kernel)
    var global_kernel = gpu_kernel_new()
    global_kernel.kernel_name = ki_ir_name_from_bytes(120, 111, 114, 103, 4)
    global_kernel.max_threads = 16
    var global_op = op
    global_op.byte_offset = 1
    global_kernel = append_op(global_kernel, global_op)
    let global_ptx = gpu_lower_to_ptx_for_target(global_kernel, true)
    let ok = ptx_buf_contains(ptx, ".target sm_121")
        && ptx_buf_contains(implicit_target, ".target sm_121")
        && !ptx_buf_contains(implicit_target, ".target sm_50")
        && ptx_buf_contains(ptx, "ossm_Lsgn")
        && ptx_buf_contains(ptx, "setp.ge.u32 %p1, %r1, 16;")
        && ptx_buf_contains(ptx, "xor.b32 %r9, %r1, %r8;")
        && ptx_buf_contains(ptx, "shfl.sync.bfly.b32 %r4, %r2, %r9, 15, 65535;")
        && ptx_buf_contains(ptx, "shfl.sync.bfly.b32 %r5, %r3, %r9, 15, 65535;")
        && ptx_buf_contains(ptx, "mad.lo.u32 %r10, %r1, 16, %r8;")
        && ptx_buf_contains(ptx, "add.f64 %fd0, %fd0, %fd1;")
        && ptx_buf_contains(ptx, "st.global.f64 [%rd7], %fd0;")
        && ptx_buf_contains(global_ptx, ".target sm_121")
        && ptx_buf_contains(global_ptx, "$XCGJ:")
        && ptx_buf_contains(global_ptx, "mul.wide.u32 %rd7, %r8, 8;")
        && !ptx_buf_contains(global_ptx, "shfl.sync.bfly.b32")
        && ptx_buf_contains(global_ptx, "st.global.f64 [%rd7], %fd0;")
    if ok {
        print("PIREUS_XOR_CONV_F64_CODEGEN_PASS\n")
        return 0
    }
    print("PIREUS_XOR_CONV_F64_CODEGEN_FAIL\n")
    1
}
