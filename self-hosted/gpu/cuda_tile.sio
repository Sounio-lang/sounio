// self-hosted::gpu::cuda_tile — CUDA Tile IR text emitter
// Richer stable implementation for the cuda-tile backend surface.
//
// This module still uses the flattened opcode arrays produced by hlir_to_gpu.sio,
// but restores a larger portion of the historical Tile IR emitter surface:
// SSA refs, typed arithmetic emitters, token-keyed load/store patterns, math ops,
// and standalone self-tests that validate the emitted MLIR text.

// Flat opcode tags currently come from gpu_opcode_to_spirv_tag in hlir_to_gpu.sio.
let CT_GPU_OP_GET_TID: i64 = 0
let CT_GPU_OP_ADD: i64 = 3
let CT_GPU_OP_SUB: i64 = 4
let CT_GPU_OP_MUL: i64 = 5
let CT_GPU_OP_DIV: i64 = 6
let CT_GPU_OP_LOAD_GLOBAL: i64 = 13
let CT_GPU_OP_STORE_GLOBAL: i64 = 14
let CT_GPU_OP_FMA: i64 = 17
let CT_GPU_OP_WMMA: i64 = 37
let CT_GPU_OP_MMA: i64 = 38
let CT_GPU_OP_SQRT: i64 = 40
let CT_GPU_OP_SIN: i64 = 44
let CT_GPU_OP_COS: i64 = 45

// Flat type tags currently come from gpu_type_to_spirv_tag in hlir_to_gpu.sio.
let CT_TAG_F32: i64 = 0
let CT_TAG_I32: i64 = 2

struct TileBuf {
    data: [i8; 65536]
    len: i64
}

fn tile_buf_new() -> TileBuf {
    TileBuf { data: [0; 65536], len: 0 }
}

fn tile_push_byte(buf: TileBuf, b: i8) -> TileBuf with Mut, Panic {
    var out = buf
    if out.len < 65536 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

fn tile_push_str(buf: TileBuf, s: string) -> TileBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = tile_push_byte(out, str_char_at(s, i) as i8)
        i = i + 1
    }
    out
}

fn tile_push_int(buf: TileBuf, n: i64) -> TileBuf with Mut, Panic, Div {
    if n == 0 {
        return tile_push_byte(buf, 48)
    }

    var out = buf
    var value = n
    if value < 0 {
        out = tile_push_byte(out, 45)
        value = 0 - value
    }

    var digits: [i8; 20] = [0; 20]
    var count: i64 = 0
    while value > 0 {
        digits[count as usize] = (48 + (value % 10)) as i8
        count = count + 1
        value = value / 10
    }

    var i: i64 = count - 1
    while i >= 0 {
        out = tile_push_byte(out, digits[i as usize])
        i = i - 1
    }
    out
}

fn tile_push_newline(buf: TileBuf) -> TileBuf with Mut, Panic {
    tile_push_byte(buf, 10)
}

fn tile_to_string(buf: TileBuf) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(buf.data, buf.len)
}

fn tile_buf_print(buf: TileBuf) with IO, Mut, Panic, Div, Alloc {
    print(tile_to_string(buf))
}

fn tile_buf_contains(buf: TileBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var start: i64 = 0
    while start <= buf.len - nlen {
        var ok = true
        var i: i64 = 0
        while i < nlen {
            if buf.data[(start + i) as usize] != str_char_at(needle, i) as i8 {
                ok = false
                break
            }
            i = i + 1
        }
        if ok { return true }
        start = start + 1
    }

    false
}

struct TileIdAlloc {
    next_id: i64
}

fn tile_id_alloc_new() -> TileIdAlloc {
    TileIdAlloc { next_id: 0 }
}

fn tile_alloc_id(a: TileIdAlloc) -> (TileIdAlloc, i64) {
    let id = a.next_id
    let next = TileIdAlloc { next_id: id + 1 }
    (next, id)
}

fn tile_alloc_take(a: &!TileIdAlloc) -> i64 with Mut {
    let id = a.next_id
    a.next_id = id + 1
    id
}

fn tile_emit_type_i32(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<128xi32>")
}

fn tile_emit_type_f32(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<128xf32>")
}

fn tile_emit_type_ptr_f32(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<ptr<f32>>")
}

fn tile_emit_type_ptr_tile(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<128xptr<f32>>")
}

fn tile_emit_type_scalar_i32(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<i32>")
}

fn tile_emit_type_1_ptr_f32(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<1xptr<f32>>")
}

fn tile_emit_type_mma_a(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<16x16xf16>")
}

fn tile_emit_type_mma_b(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<16x16xf16>")
}

fn tile_emit_type_mma_acc(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    tile_push_str(buf, "tile<16x16xf32>")
}

fn tile_emit_ssa_ref(buf: TileBuf, id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "%r")
    out = tile_push_int(out, id)
    out
}

fn tile_emit_param_ref(buf: TileBuf, id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "%param")
    out = tile_push_int(out, id)
    out
}

fn tile_emit_module_header(buf: TileBuf, kernel_name: string) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "cuda_tile.module @")
    out = tile_push_str(out, kernel_name)
    out = tile_push_str(out, " {\n")
    out
}

fn tile_emit_entry_params(buf: TileBuf, kernel_name: string, param_count: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "    entry @")
    out = tile_push_str(out, kernel_name)
    out = tile_push_str(out, "(")

    var i: i64 = 0
    while i < param_count {
        out = tile_push_str(out, "%param")
        out = tile_push_int(out, i)
        out = tile_push_str(out, " : !cuda_tile.tile<ptr<f32>>")
        if i + 1 < param_count {
            out = tile_push_str(out, ", ")
        }
        i = i + 1
    }

    out = tile_push_str(out, ") {\n")
    out
}

fn tile_emit_footer(buf: TileBuf) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "    }\n")
    out = tile_push_str(out, "}\n")
    out
}

fn tile_emit_iota(buf: TileBuf, result_id: i64, elem_count: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = iota : tile<")
    out = tile_push_int(out, elem_count)
    out = tile_push_str(out, "xi32>")
    out = tile_push_newline(out)
    out
}

fn tile_emit_reshape_ptr(buf: TileBuf, result_id: i64, param_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = reshape ")
    out = tile_emit_param_ref(out, param_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_ptr_f32(out)
    out = tile_push_str(out, " -> ")
    out = tile_emit_type_1_ptr_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_broadcast_ptr(buf: TileBuf, result_id: i64, src_id: i64, width: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = broadcast ")
    out = tile_emit_ssa_ref(out, src_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_1_ptr_f32(out)
    out = tile_push_str(out, " -> tile<")
    out = tile_push_int(out, width)
    out = tile_push_str(out, "xptr<f32>>")
    out = tile_push_newline(out)
    out
}

fn tile_emit_offset_ptr(buf: TileBuf, result_id: i64, base_id: i64, offset_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = offset ")
    out = tile_emit_ssa_ref(out, base_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, offset_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_ptr_tile(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_i32(out)
    out = tile_push_str(out, " -> ")
    out = tile_emit_type_ptr_tile(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_load_ptr(buf: TileBuf, value_id: i64, token_id: i64, ptr_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, value_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, token_id)
    out = tile_push_str(out, " = load_ptr_tko weak ")
    out = tile_emit_ssa_ref(out, ptr_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_ptr_tile(out)
    out = tile_push_str(out, " -> ")
    out = tile_emit_type_f32(out)
    out = tile_push_str(out, ", token")
    out = tile_push_newline(out)
    out
}

fn tile_emit_store_ptr(buf: TileBuf, token_id: i64, ptr_id: i64, value_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, token_id)
    out = tile_push_str(out, " = store_ptr_tko weak ")
    out = tile_emit_ssa_ref(out, ptr_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, value_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_ptr_tile(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_f32(out)
    out = tile_push_str(out, " -> token")
    out = tile_push_newline(out)
    out
}

fn tile_emit_addf(buf: TileBuf, result_id: i64, lhs_id: i64, rhs_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = addf ")
    out = tile_emit_ssa_ref(out, lhs_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, rhs_id)
    out = tile_push_str(out, " rounding<nearest_even> : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_addi(buf: TileBuf, result_id: i64, lhs_id: i64, rhs_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = addi ")
    out = tile_emit_ssa_ref(out, lhs_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, rhs_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_i32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_subf(buf: TileBuf, result_id: i64, lhs_id: i64, rhs_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    let neg_id = result_id + 100000
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, neg_id)
    out = tile_push_str(out, " = negf ")
    out = tile_emit_ssa_ref(out, rhs_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out = tile_emit_addf(out, result_id, lhs_id, neg_id)
    out
}

fn tile_emit_mulf(buf: TileBuf, result_id: i64, lhs_id: i64, rhs_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = mulf ")
    out = tile_emit_ssa_ref(out, lhs_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, rhs_id)
    out = tile_push_str(out, " rounding<nearest_even> : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_divf(buf: TileBuf, result_id: i64, lhs_id: i64, rhs_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = divf ")
    out = tile_emit_ssa_ref(out, lhs_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, rhs_id)
    out = tile_push_str(out, " rounding<nearest_even> : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_fma(buf: TileBuf, result_id: i64, a_id: i64, b_id: i64, acc_id: i64) -> TileBuf with Mut, Panic, Div {
    let mul_id = result_id + 200000
    var out = tile_emit_mulf(buf, mul_id, a_id, b_id)
    out = tile_emit_addf(out, result_id, mul_id, acc_id)
    out
}

fn tile_emit_mmaf(buf: TileBuf, result_id: i64, a_id: i64, b_id: i64, acc_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = mmaf ")
    out = tile_emit_ssa_ref(out, a_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, b_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, acc_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_mma_a(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_mma_b(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_mma_acc(out)
    out = tile_push_str(out, " -> ")
    out = tile_emit_type_mma_acc(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_get_block_id(buf: TileBuf, base_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, base_id)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, base_id + 1)
    out = tile_push_str(out, ", ")
    out = tile_emit_ssa_ref(out, base_id + 2)
    out = tile_push_str(out, " = get_tile_block_id : ")
    out = tile_emit_type_scalar_i32(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_scalar_i32(out)
    out = tile_push_str(out, ", ")
    out = tile_emit_type_scalar_i32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_sqrt(buf: TileBuf, result_id: i64, src_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = math.sqrt ")
    out = tile_emit_ssa_ref(out, src_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_sin(buf: TileBuf, result_id: i64, src_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = math.sin ")
    out = tile_emit_ssa_ref(out, src_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_cos(buf: TileBuf, result_id: i64, src_id: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        ")
    out = tile_emit_ssa_ref(out, result_id)
    out = tile_push_str(out, " = math.cos ")
    out = tile_emit_ssa_ref(out, src_id)
    out = tile_push_str(out, " : ")
    out = tile_emit_type_f32(out)
    out = tile_push_newline(out)
    out
}

fn tile_emit_unknown_op(buf: TileBuf, opcode: i64) -> TileBuf with Mut, Panic, Div {
    var out = buf
    out = tile_push_str(out, "        // unknown opcode ")
    out = tile_push_int(out, opcode)
    out = tile_push_newline(out)
    out
}

fn tile_emit_load_pattern(buf: TileBuf, scratch_base: i64, param_id: i64, dst_id: i64) -> TileBuf with Mut, Panic, Div {
    let iota_id = scratch_base
    let reshape_id = scratch_base + 1
    let bcast_id = scratch_base + 2
    let ptrs_id = scratch_base + 3
    let token_id = scratch_base + 4
    var out = buf
    out = tile_emit_iota(out, iota_id, 128)
    out = tile_emit_reshape_ptr(out, reshape_id, param_id)
    out = tile_emit_broadcast_ptr(out, bcast_id, reshape_id, 128)
    out = tile_emit_offset_ptr(out, ptrs_id, bcast_id, iota_id)
    out = tile_emit_load_ptr(out, dst_id, token_id, ptrs_id)
    out
}

fn tile_emit_store_pattern(buf: TileBuf, scratch_base: i64, param_id: i64, value_id: i64) -> TileBuf with Mut, Panic, Div {
    let iota_id = scratch_base
    let reshape_id = scratch_base + 1
    let bcast_id = scratch_base + 2
    let ptrs_id = scratch_base + 3
    let token_id = scratch_base + 4
    var out = buf
    out = tile_emit_iota(out, iota_id, 128)
    out = tile_emit_reshape_ptr(out, reshape_id, param_id)
    out = tile_emit_broadcast_ptr(out, bcast_id, reshape_id, 128)
    out = tile_emit_offset_ptr(out, ptrs_id, bcast_id, iota_id)
    out = tile_emit_store_ptr(out, token_id, ptrs_id, value_id)
    out
}

fn gpu_lower_to_cuda_tile(
    kernel_name: string,
    param_count: i64,
    ops_opcodes: [i64; 256],
    ops_dst: [i64; 256],
    ops_src_a: [i64; 256],
    ops_src_b: [i64; 256],
    ops_type_tags: [i64; 256],
    ops_count: i64
) -> TileBuf with Mut, Panic, Div, Alloc {
    var buf = tile_buf_new()
    var scratch = TileIdAlloc { next_id: 1024 }
    buf = tile_emit_module_header(buf, kernel_name)
    buf = tile_emit_entry_params(buf, kernel_name, param_count)

    var i: i64 = 0
    while i < ops_count {
        let opcode = ops_opcodes[i as usize]
        let dst = ops_dst[i as usize]
        let src_a = ops_src_a[i as usize]
        let src_b = ops_src_b[i as usize]
        let tag = ops_type_tags[i as usize]

        if opcode == CT_GPU_OP_GET_TID {
            buf = tile_emit_get_block_id(buf, dst)
        } else {
            if opcode == CT_GPU_OP_ADD {
                if tag == CT_TAG_I32 {
                    buf = tile_emit_addi(buf, dst, src_a, src_b)
                } else {
                    buf = tile_emit_addf(buf, dst, src_a, src_b)
                }
            } else {
                if opcode == CT_GPU_OP_SUB {
                    buf = tile_emit_subf(buf, dst, src_a, src_b)
                } else {
                    if opcode == CT_GPU_OP_MUL {
                        buf = tile_emit_mulf(buf, dst, src_a, src_b)
                    } else {
                        if opcode == CT_GPU_OP_DIV {
                            buf = tile_emit_divf(buf, dst, src_a, src_b)
                        } else {
                            if opcode == CT_GPU_OP_LOAD_GLOBAL {
                                let scratch_base = scratch.next_id
                                scratch.next_id = scratch.next_id + 5
                                buf = tile_emit_load_pattern(buf, scratch_base, src_a, dst)
                            } else {
                                if opcode == CT_GPU_OP_STORE_GLOBAL {
                                    let scratch_base = scratch.next_id
                                    scratch.next_id = scratch.next_id + 5
                                    buf = tile_emit_store_pattern(buf, scratch_base, src_a, src_b)
                                } else {
                                    if opcode == CT_GPU_OP_FMA {
                                        buf = tile_emit_fma(buf, dst, src_a, src_b, dst)
                                    } else {
                                        if opcode == CT_GPU_OP_WMMA {
                                            buf = tile_emit_mmaf(buf, dst, src_a, src_b, dst)
                                        } else {
                                            if opcode == CT_GPU_OP_MMA {
                                                buf = tile_emit_mmaf(buf, dst, src_a, src_b, dst)
                                            } else {
                                                if opcode == CT_GPU_OP_SQRT {
                                                    buf = tile_emit_sqrt(buf, dst, src_a)
                                                } else {
                                                    if opcode == CT_GPU_OP_SIN {
                                                        buf = tile_emit_sin(buf, dst, src_a)
                                                    } else {
                                                        if opcode == CT_GPU_OP_COS {
                                                            buf = tile_emit_cos(buf, dst, src_a)
                                                        } else {
                                                            buf = tile_emit_unknown_op(buf, opcode)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        i = i + 1
    }

    tile_emit_footer(buf)
}

fn main() with IO {
