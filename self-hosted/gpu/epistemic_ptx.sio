// self-hosted::gpu::epistemic_ptx — Epistemic shadow register PTX codegen
//
// World-first: every Knowledge<T> value on GPU gets 4 shadow registers:
//   %r_val      (f32/f64) — computed value
//   %r_eps      (f32)     — uncertainty bound (epsilon)
//   %p_valid    (pred)    — validity predicate
//   %r_prov     (u64)     — bit-packed provenance (data lineage)
//
// Uncertainty propagation rules:
//   Add/Sub: ε_c = √(ε_a² + ε_b²)              [quadrature]
//   Mul:     ε_c = |a|·ε_b + |b|·ε_a            [first-order]
//   Div:     ε_c = (|a|·ε_b + |b|·ε_a) / b²    [+ near-zero guard]
//   FMA:     ε_c = √((|a|·ε_b + |b|·ε_a)² + ε_c²)
//
// Warp-level aggregation:
//   vote.sync.ballot for consensus
//   shfl.sync.down for epsilon reduction (min/max/avg)
//   OR reduction for provenance merge

// ── Inlined from ptx.sio + lower_to_ptx.sio (single-file VM) ────────
// All definitions needed by epistemic_ptx.sio are duplicated here so
// the file runs standalone under `souc run` without import support.

// Helper: i64 → decimal string (no stdlib dependency)
fn i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n < 0 {
        return "0"
    }
    if n == 0 { return "0" }

    var digits: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value: i64 = n

    while value > 0 {
        let digit = value % 10
        digits[rev_len as usize] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var bytes: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        bytes[i as usize] = digits[(rev_len - i - 1) as usize]
        i = i + 1
    }

    str_from_bytes(bytes, rev_len)
}

struct PtxBuf {
    data: [i8; 65536],
    len: i64,
}

fn ptx_buf_new() -> PtxBuf {
    PtxBuf { data: [0; 65536], len: 0 }
}

fn ptx_push_byte(buf: PtxBuf, b: i8) -> PtxBuf with Mut, Panic {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.data[out.len as usize] = b
            out.len = out.len + 1
        }
    }
    out
}

fn ptx_push_str(buf: PtxBuf, s: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 65536 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

fn ptx_buf_contains(buf: PtxBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }

    var i: i64 = 0
    while i <= (buf.len - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn ptx_to_string(buf: PtxBuf) -> string with Mut, Panic, Div, Alloc {
    str_from_bytes(buf.data, buf.len)
}

fn ptx_str_contains(haystack: string, needle: string) -> bool with Mut, Panic, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if hlen < nlen { return false }

    var i: i64 = 0
    while i <= (hlen - nlen) {
        var j: i64 = 0
        var ok: bool = true
        while j < nlen {
            if str_char_at(haystack, i + j) != str_char_at(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    false
}

fn ptx_trim_leading_spaces(s: string) -> string with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0

    while i < n {
        let c = str_char_at(s, i)
        if c != 32 && c != 9 {
            break
        }
        i = i + 1
    }

    str_slice(s, i, n)
}

fn ptx_has_predicated_opcode(haystack: string, opcode: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == '\n' {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            let first = str_char_at(line, 0)
            if (first == '@' || ptx_str_contains(line, "@%")) && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

fn ptx_has_predicated_opcode_with_pred(haystack: string, opcode: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == '\n' {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, pred) && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

fn ptx_has_predicate_token(line: string, pred: string) -> bool with Mut, Panic, Div {
    let token_with_space_prefix = " " ++ pred ++ ","
    let token_with_delim = pred ++ ","
    let token_with_space_suffix = ", " ++ pred ++ ","
    let token_with_semicolon = ", " ++ pred ++ ";"

    if ptx_str_contains(line, pred) {
        if starts_with(line, pred) {
            return true
        }
        if ptx_str_contains(line, token_with_space_prefix) {
            return true
        }
        if ptx_str_contains(line, token_with_delim) {
            return true
        }
        if ptx_str_contains(line, token_with_space_suffix) {
            return true
        }
        if ptx_str_contains(line, token_with_semicolon) {
            return true
        }
    }
    false
}

fn ptx_has_setp_with_pred(haystack: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == '\n' {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, "setp.") && ptx_has_predicate_token(line, pred) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

fn ptx_has_selp_with_pred(haystack: string, pred: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == '\n' {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if starts_with(line, "selp") && ptx_has_predicate_token(line, pred) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

fn ptx_has_unpredicated_opcode(haystack: string, opcode: string) -> bool with Mut, Panic, Div {
    let n = str_len(haystack)
    if n == 0 { return false }

    var line_start: i64 = 0
    while line_start < n {
        var line_end: i64 = line_start
        while line_end < n {
            if str_char_at(haystack, line_end) == '\n' {
                break
            }
            line_end = line_end + 1
        }

        let raw_line = str_slice(haystack, line_start, line_end)
        let line = ptx_trim_leading_spaces(raw_line)
        if str_len(line) > 0 {
            if str_len(line) > 0 && !ptx_str_contains(line, "@") && ptx_str_contains(line, opcode) {
                return true
            }
        }

        if line_end >= n {
            break
        }
        line_start = line_end + 1
    }

    false
}

