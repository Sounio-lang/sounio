    st = epistemic_f64_emit_init_shadow(st, c_sh, "3FE0000000000000", "3F1A36E2EB1C432D")
    st = epistemic_f64_emit_fma(st, r_sh, a_sh, b_sh, c_sh)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "fma.rn.f64") && eptx_str_contains(ptx, "sqrt.rn.f64")
