fn eptx_push_selp(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    src_false: string,
    src_true: string,
    pred: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src_false)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src_true)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, pred)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_predicated_mem2(
    buf: EpistemicPtxBuf,
    opcode: string,
    pred: string,
    dst_or_dst_ptr: string,
    rhs_or_rhs_ptr: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    @")
    out = eptx_push_str(out, pred)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst_or_dst_ptr)
    out = eptx_push_str(out, ", [")
    out = eptx_push_str(out, rhs_or_rhs_ptr)
    out = eptx_push_str(out, "];\n")
    out
}

fn eptx_push_predicated_store_mem(
    buf: EpistemicPtxBuf,
    opcode: string,
    pred: string,
    dst_ptr: string,
    src: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    @")
    out = eptx_push_str(out, pred)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " [")
    out = eptx_push_str(out, dst_ptr)
    out = eptx_push_str(out, "], ")
    out = eptx_push_str(out, src)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_atomic_add(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    addr: string,
    val: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", [")
    out = eptx_push_str(out, addr)
    out = eptx_push_str(out, "], ")
    out = eptx_push_str(out, val)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_ld_shared(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    addr: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", [")
    out = eptx_push_str(out, addr)
    out = eptx_push_str(out, "];\n")
    out
}

fn eptx_push_st_shared(
    buf: EpistemicPtxBuf,
    opcode: string,
    addr: string,
    src: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " [")
    out = eptx_push_str(out, addr)
    out = eptx_push_str(out, "], ")
    out = eptx_push_str(out, src)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_fma(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    src_a: string,
    src_b: string,
    src_c: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src_a)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src_b)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src_c)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_mov_special(
    buf: EpistemicPtxBuf,
    special: string,
    axis: string,
    dst: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    mov.u32 ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", %")
    out = eptx_push_str(out, special)
    out = eptx_push_str(out, ".")
    out = eptx_push_str(out, axis)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_add_imm(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    src: string,
    imm: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, imm)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_emit_header(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, ".version ")
    out = eptx_push_str(out, eptx_header_version())
    out = eptx_push_str(out, "\n")
    out = eptx_push_str(out, ".target ")
    out = eptx_push_str(out, eptx_header_target())
    out = eptx_push_str(out, "\n")
    out = eptx_push_str(out, eptx_header_address_size())
    out = eptx_push_str(out, "\n\n")
    out
}

fn eptx_emit_vec_add_signature(
    buf: EpistemicPtxBuf,
    kernel_name: string,
    param_a: string,
    param_b: string,
    param_c: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, ".visible .entry ")
    out = eptx_push_str(out, kernel_name)
    out = eptx_push_str(out, "(\n")
    out = eptx_push_str(out, "    .param .u64 ")
    out = eptx_push_str(out, param_a)
    out = eptx_push_str(out, ",\n")
    out = eptx_push_str(out, "    .param .u64 ")
    out = eptx_push_str(out, param_b)
    out = eptx_push_str(out, ",\n")
    out = eptx_push_str(out, "    .param .u64 ")
    out = eptx_push_str(out, param_c)
    out = eptx_push_str(out, "\n)\n")
    out
}

fn eptx_emit_vec_add_reg_decl(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "{\n")
    out = eptx_push_str(out, "    .reg .pred %p<2>;\n")
    out = eptx_push_str(out, "    .reg .b32 %r<3>;\n")
    out = eptx_push_str(out, "    .reg .b64 %rd<9>;\n")
    out = eptx_push_str(out, "    .reg .f32 %f<4>;\n\n")
    out
}

fn eptx_emit_vec_add_body(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_binary2(out, eptx_opcode_mov_u32(), "%r1", "%tid.x")
    out = eptx_push_binary2(out, eptx_opcode_cvt_u64_u32(), "%rd1", "%r1")
    out = eptx_push_binary3(out, eptx_opcode_mul_lo_u64(), "%rd2", "%rd1", "4")
    out = eptx_push_binary_mem2(out, eptx_opcode_ld_param_u64(), "%rd3", "param_a")
    out = eptx_push_binary_mem2(out, eptx_opcode_ld_param_u64(), "%rd4", "param_b")
    out = eptx_push_binary_mem2(out, eptx_opcode_ld_param_u64(), "%rd5", "param_c")
    out = eptx_push_binary3(out, eptx_opcode_add_u64(), "%rd6", "%rd3", "%rd2")
    out = eptx_push_binary3(out, eptx_opcode_add_u64(), "%rd7", "%rd4", "%rd2")
    out = eptx_push_binary3(out, eptx_opcode_add_u64(), "%rd8", "%rd5", "%rd2")
    out = eptx_push_binary_mem2(out, eptx_opcode_ld_global_f32(), "%f1", "%rd6")
    out = eptx_push_binary_mem2(out, eptx_opcode_ld_global_f32(), "%f2", "%rd7")
    out = eptx_push_binary3(out, eptx_opcode_add_f32(), "%f3", "%f1", "%f2")
    out = eptx_push_store_mem(out, eptx_opcode_st_global_f32(), "%rd8", "%f3")
    out = eptx_push_ret(out)
    out = eptx_push_str(out, "}\n")
    out
}

fn eptx_emit_vec3_f32_add(
    buf: EpistemicPtxBuf,
    out0: string,
    in0_0: string,
    in0_1: string,
    out1: string,
    in1_0: string,
    in1_1: string,
    out2: string,
    in2_0: string,
    in2_1: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_binary3(out, eptx_opcode_add_f32(), out0, in0_0, in0_1)
    out = eptx_push_binary3(out, eptx_opcode_add_f32(), out1, in1_0, in1_1)
    out = eptx_push_binary3(out, eptx_opcode_add_f32(), out2, in2_0, in2_1)
    out
}

fn eptx_emit_demo_vec_add() -> EpistemicPtxBuf with Mut, Panic, Div {
    var b = eptx_buf_new()
    b = eptx_emit_header(b)
    b = eptx_emit_vec_add_signature(b, "vec_add", "param_a", "param_b", "param_c")
    b = eptx_emit_vec_add_reg_decl(b)
    b = eptx_emit_vec_add_body(b)
    b
}

// ── Configuration ───────────────────────────────────────────────────

struct EpistemicPtxConfig {
    sm_major: i64,
    sm_minor: i64,
    default_epsilon: i64,       // f32 bits (IEEE 754)
    confidence_threshold: i64,  // f32 bits
    quadrature_propagation: bool,
    warp_aggregation: bool,
    provenance_tracking: bool,
    provenance_bits: i64,
    epistemic_mode: GpuEpistemicMode,
    provenance_fold_interval: i64,
    validity_pack_mode: i64, // 0=full predicates, 1=packed bit validity
}

fn epistemic_config_default() -> EpistemicPtxConfig {
    EpistemicPtxConfig {
        sm_major: 8,
        sm_minor: 0,
        default_epsilon: 0,           // 0.0f
        confidence_threshold: 1028443341, // 0.05f in IEEE 754
        quadrature_propagation: true,
        warp_aggregation: true,
        provenance_tracking: true,
        provenance_bits: 8,
        epistemic_mode: GpuEpistemicMode::GpuEpistemicStrict,
        provenance_fold_interval: 1,
        validity_pack_mode: 0,
    }
}

// ── Shadow Register Set ─────────────────────────────────────────────

struct EpistemicShadow {
    val_name: string,    // e.g. "%r_a"
    eps_name: string,    // e.g. "%r_a_eps"
    valid_name: string,  // e.g. "%p_a_valid"
    prov_name: string,   // e.g. "%r_a_prov"
}

fn epistemic_shadow_new(base: string) -> EpistemicShadow with Alloc {
    EpistemicShadow {
        val_name: "%r_" ++ base,
        eps_name: "%r_" ++ base ++ "_eps",
        valid_name: "%p_" ++ base ++ "_valid",
        prov_name: "%r_" ++ base ++ "_prov",
    }
}

// ── Emitter State ───────────────────────────────────────────────────

struct EpistemicPtxState {
    buf: EpistemicPtxBuf,
    config: EpistemicPtxConfig,
    shadow_counter: i64,
    // Track allocated shadows: up to 256 epistemic values
    shadow_bases: [i64; 256],   // hash of base name
    shadow_count: i64,
    // Temporary register counters for epistemic intermediates
    temp_f32_count: i64,
    temp_pred_count: i64,
    temp_u64_count: i64,
    emit_counter: i64,
}

fn epistemic_ptx_new(config: EpistemicPtxConfig) -> EpistemicPtxState {
    EpistemicPtxState {
        buf: eptx_buf_new(),
        config: config,
        shadow_counter: 0,
        shadow_bases: [0; 256],
        shadow_count: 0,
        temp_f32_count: 0,
        temp_pred_count: 0,
        temp_u64_count: 0,
        emit_counter: 0,
    }
}

fn epistemic_is_fast_mode(cfg: EpistemicPtxConfig) -> bool {
    cfg.epistemic_mode == GpuEpistemicMode::GpuEpistemicFast
}

fn epistemic_bump_emit_counter(st: EpistemicPtxState) -> EpistemicPtxState with Mut {
    var out = st
    out.emit_counter = out.emit_counter + 1
    out
}

fn epistemic_should_fold_provenance(st: EpistemicPtxState) -> bool with Div, Panic {
    if !st.config.provenance_tracking {
        return false
    }
    if !epistemic_is_fast_mode(st.config) {
        return true
    }
    if st.config.provenance_fold_interval <= 1 {
        return true
    }
    (st.emit_counter % st.config.provenance_fold_interval) == 0
}

fn epistemic_alloc_shadow(
    st: EpistemicPtxState,
    base: string
) -> (EpistemicPtxState, EpistemicShadow) with Mut, Panic, Div, Alloc {
    var out = st
    let idx = out.shadow_counter
    out.shadow_counter = idx + 1
    let name = base ++ "_" ++ eptx_i64_to_string(idx)
    let shadow = epistemic_shadow_new(name)
    (out, shadow)
}

fn epistemic_alloc_temp_f32(st: EpistemicPtxState) -> (EpistemicPtxState, string) with Mut, Panic, Div, Alloc {
    var out = st
    let idx = out.temp_f32_count
    out.temp_f32_count = idx + 1
    (out, "%r_eps_t" ++ eptx_i64_to_string(idx))
}

fn epistemic_alloc_temp_pred(st: EpistemicPtxState) -> (EpistemicPtxState, string) with Mut, Panic, Div, Alloc {
    var out = st
    let idx = out.temp_pred_count
    out.temp_pred_count = idx + 1
    (out, "%p_eps_t" ++ eptx_i64_to_string(idx))
}

// ── Register Pool Declaration ───────────────────────────────────────

fn epistemic_emit_shadow_reg_pool(
    st: EpistemicPtxState,
    num_shadows: i64
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st
    // Value registers (f32)
    out.buf = eptx_push_str(out.buf, "    // Epistemic shadow registers\n")
    out.buf = eptx_push_str(out.buf, "    .reg .f32 %r_<")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows * 2))
    out.buf = eptx_push_str(out.buf, ">;  // values + epsilons\n")

    // Epsilon registers (f32) — shared pool with values
    // Validity predicates
    out.buf = eptx_push_str(out.buf, "    .reg .pred %p_<")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows + 16))
    out.buf = eptx_push_str(out.buf, ">;  // validity + temporaries\n")

    // Provenance registers (u64)
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    .reg .b64 %r_prov_<")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows))
        out.buf = eptx_push_str(out.buf, ">;  // provenance\n")
    }

    // Temporary registers for epsilon calculations
    out.buf = eptx_push_str(out.buf, "    .reg .f32 %r_eps_t<16>;  // epsilon temporaries\n")
    out.buf = eptx_push_str(out.buf, "    .reg .pred %p_eps_t<8>;  // predicate temporaries\n")
    out.buf = eptx_push_str(out.buf, "    .reg .b64 %r_prov_t<4>;  // provenance temporaries\n")
    out.buf = eptx_push_str(out.buf, "\n")
    out
}

// ── Initialization ──────────────────────────────────────────────────

fn epistemic_emit_init_shadow(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    initial_value: string,
    initial_epsilon: string
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st
    // Initialize value
    out.buf = eptx_push_str(out.buf, "    mov.f32 ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, initial_value)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Initialize epsilon
    out.buf = eptx_push_str(out.buf, "    mov.f32 ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, initial_epsilon)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Initialize validity = true
    out.buf = eptx_push_str(out.buf, "    setp.eq.s32 ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 1, 1;\n")

    // Initialize provenance
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    mov.u64 ")
        out.buf = eptx_push_str(out.buf, shadow.prov_name)
        out.buf = eptx_push_str(out.buf, ", 0;\n")
    }
    out
}

// ── Additive Propagation: ε_c = √(ε_a² + ε_b²) ────────────────────

fn epistemic_emit_add(
    st: EpistemicPtxState,
    result: EpistemicShadow,
    left: EpistemicShadow,
    right: EpistemicShadow,
    is_sub: bool
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value computation
    if is_sub {
        out.buf = eptx_push_str(out.buf, "    sub.f32 ")
    } else {
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
    }
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon propagation:
    // strict: per-op quadrature with sqrt
    // fast: accumulate epsilon terms and defer sqrt pressure
    if out.config.quadrature_propagation {
        out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t0, ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t1, ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t2, %r_eps_t0, %r_eps_t1;\n")
        if epistemic_is_fast_mode(out.config) {
            out.buf = eptx_push_str(out.buf, "    add.f32 ")
            out.buf = eptx_push_str(out.buf, result.eps_name)
            out.buf = eptx_push_str(out.buf, ", ")
            out.buf = eptx_push_str(out.buf, left.eps_name)
            out.buf = eptx_push_str(out.buf, ", ")
            out.buf = eptx_push_str(out.buf, right.eps_name)
            out.buf = eptx_push_str(out.buf, ";\n")
            out.buf = eptx_push_str(out.buf, "    add.f32 ")
            out.buf = eptx_push_str(out.buf, result.eps_name)
            out.buf = eptx_push_str(out.buf, ", ")
            out.buf = eptx_push_str(out.buf, result.eps_name)
            out.buf = eptx_push_str(out.buf, ", %r_eps_t2;\n")
        } else {
            out.buf = eptx_push_str(out.buf, "    sqrt.approx.f32 ")
            out.buf = eptx_push_str(out.buf, result.eps_name)
            out.buf = eptx_push_str(out.buf, ", %r_eps_t2;\n")
        }
    } else {
        out.buf = eptx_push_str(out.buf, "    max.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    // Validity policy: strict keeps native predicates, fast packs to b32 first.
    if out.config.validity_pack_mode == 1 {
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t4, 1, 0, ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t5, 1, 0, ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    and.b32 %r_eps_t4, %r_eps_t4, %r_eps_t5;\n")
        out.buf = eptx_push_str(out.buf, "    setp.ne.s32 ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t4, 0;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    and.pred ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    // Provenance fold cadence is stricter in strict mode and periodic in fast mode.
    if epistemic_should_fold_provenance(out) {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    } else if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    // fast-mode provenance fold deferred\n")
    }
    epistemic_bump_emit_counter(out)
}

// ── Multiplicative Propagation: ε_c = |a|·ε_b + |b|·ε_a ───────────

fn epistemic_emit_mul(
    st: EpistemicPtxState,
    result: EpistemicShadow,
    left: EpistemicShadow,
    right: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value computation
    out.buf = eptx_push_str(out.buf, "    mul.rn.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon: first-order error propagation.
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t2, %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t3, %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    if epistemic_is_fast_mode(out.config) {
        out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t4, %r_eps_t2, %r_eps_t3;\n")
        out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t4, %r_eps_t4, %r_eps_t4;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t4;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t2, %r_eps_t3;\n")
    }

    if out.config.validity_pack_mode == 1 {
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t5, 1, 0, ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t6, 1, 0, ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    and.b32 %r_eps_t5, %r_eps_t5, %r_eps_t6;\n")
        out.buf = eptx_push_str(out.buf, "    setp.ne.s32 ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t5, 0;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    and.pred ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    if epistemic_should_fold_provenance(out) {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    } else if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    // fast-mode provenance fold deferred\n")
    }
    epistemic_bump_emit_counter(out)
}

// ── Division Propagation: ε_c = (|a|·ε_b + |b|·ε_a) / b² ─────────

fn epistemic_emit_div(
    st: EpistemicPtxState,
    result: EpistemicShadow,
    left: EpistemicShadow,
    right: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value computation
    out.buf = eptx_push_str(out.buf, "    div.approx.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon numerator: |a|·ε_b + |b|·ε_a
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t2, %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t3, %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t0, %r_eps_t2, %r_eps_t3;\n")

    // Denominator: b²
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // ε_c = numerator / b²
    if epistemic_is_fast_mode(out.config) {
        out.buf = eptx_push_str(out.buf, "    div.approx.f32 %r_eps_t6, %r_eps_t0, %r_eps_t1;\n")
        out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t6, %r_eps_t6, %r_eps_t6;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t6;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    div.approx.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t0, %r_eps_t1;\n")
    }

    // Near-zero guard: if |b| < 0.0001, max out uncertainty
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t2, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    setp.lt.f32 %p_eps_t0, %r_eps_t2, 0f38D1B717;\n")  // 0.0001 in hex float
    out.buf = eptx_push_str(out.buf, "    @%p_eps_t0 mov.f32 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", 0f3F800000;\n")  // 1.0 = max uncertainty

    if out.config.validity_pack_mode == 1 {
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t7, 1, 0, ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t8, 1, 0, ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    and.b32 %r_eps_t7, %r_eps_t7, %r_eps_t8;\n")
        out.buf = eptx_push_str(out.buf, "    setp.ne.s32 ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t7, 0;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    and.pred ")
        out.buf = eptx_push_str(out.buf, result.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.valid_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.valid_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    if epistemic_should_fold_provenance(out) {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    } else if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    // fast-mode provenance fold deferred\n")
    }
    epistemic_bump_emit_counter(out)
}

// ── FMA Propagation: ε = √((|a|·ε_b + |b|·ε_a)² + ε_c²) ──────────

fn epistemic_emit_fma(
    st: EpistemicPtxState,
    result: EpistemicShadow,
    a: EpistemicShadow,
    b: EpistemicShadow,
    c: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value: fma(a, b, c)
    out.buf = eptx_push_str(out.buf, "    fma.rn.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, a.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, b.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, c.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon: mul part = |a|·ε_b + |b|·ε_a
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, a.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, b.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t2, %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, b.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t3, %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, a.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t0, %r_eps_t2, %r_eps_t3;\n")

    // Square the mul part
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t0, %r_eps_t0, %r_eps_t0;\n")
    // ε_c²
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, c.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, c.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Sum
    out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t2, %r_eps_t0, %r_eps_t1;\n")
    if epistemic_is_fast_mode(out.config) {
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, c.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t2;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    sqrt.approx.f32 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t2;\n")
    }

    // Validity: 3-way conjunction
    out.buf = eptx_push_str(out.buf, "    and.pred %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, a.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, b.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    and.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, c.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    if epistemic_should_fold_provenance(out) {
        out.buf = eptx_push_str(out.buf, "    or.b64 %r_prov_t0, ")
        out.buf = eptx_push_str(out.buf, a.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, b.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", %r_prov_t0, ")
        out.buf = eptx_push_str(out.buf, c.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    } else if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    // fast-mode provenance fold deferred\n")
    }
    epistemic_bump_emit_counter(out)
}

// ── Confidence Gating ───────────────────────────────────────────────

fn epistemic_emit_confidence_gate(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    threshold_hex: string,
    high_conf_label: string,
    low_conf_label: string
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Check if ε < threshold (high confidence)
    out.buf = eptx_push_str(out.buf, "    setp.lt.f32 %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", 0f")
    out.buf = eptx_push_str(out.buf, threshold_hex)
    out.buf = eptx_push_str(out.buf, ";\n")

    // AND with validity predicate
    out.buf = eptx_push_str(out.buf, "    and.pred %p_eps_t0, %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Branch
    out.buf = eptx_push_str(out.buf, "    @%p_eps_t0 bra ")
    out.buf = eptx_push_str(out.buf, high_conf_label)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    @!%p_eps_t0 bra ")
    out.buf = eptx_push_str(out.buf, low_conf_label)
    out.buf = eptx_push_str(out.buf, ";\n")
    out
}

// Skip expensive operation if confidence is below threshold
fn epistemic_emit_predicated_on_validity(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    instruction: string
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = eptx_push_str(out.buf, "    @")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, " ")
    out.buf = eptx_push_str(out.buf, instruction)
    out.buf = eptx_push_str(out.buf, ";\n")
    out
}

// ── Warp-Level Consensus Aggregation ────────────────────────────────

// vote.sync.ballot: get bitmask of valid lanes across warp
fn epistemic_emit_warp_confidence_vote(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    ballot_reg: string,
    count_reg: string
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Get ballot of valid lanes
    out.buf = eptx_push_str(out.buf, "    vote.sync.ballot.b32 ")
    out.buf = eptx_push_str(out.buf, ballot_reg)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 0xffffffff;\n")

    // Count valid lanes (popcount)
    out.buf = eptx_push_str(out.buf, "    popc.b32 ")
    out.buf = eptx_push_str(out.buf, count_reg)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, ballot_reg)
    out.buf = eptx_push_str(out.buf, ";\n")
    out
}

// Epsilon tree reduction across warp via shfl.sync.down
// mode: 0 = min, 1 = max, 2 = sum (then /32 for average)
fn epistemic_emit_warp_epsilon_reduce(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    result_reg: string,
    mode: i64
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Initialize result from this lane's epsilon
    out.buf = eptx_push_str(out.buf, "    mov.f32 ")
    out.buf = eptx_push_str(out.buf, result_reg)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Tree reduction: offsets 16, 8, 4, 2, 1
    var offset: i64 = 16
    while offset >= 1 {
        // Shuffle down
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_eps_t0, ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")

        // Reduce operation
        if mode == 0 {
            // Min (most confident)
            out.buf = eptx_push_str(out.buf, "    min.f32 ")
        } else if mode == 1 {
            // Max (least confident)
            out.buf = eptx_push_str(out.buf, "    max.f32 ")
        } else {
            // Sum (for average)
            out.buf = eptx_push_str(out.buf, "    add.f32 ")
        }
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t0;\n")

        offset = offset / 2
    }

    // For average mode: divide by 32 (multiply by 0.03125)
    if mode == 2 {
        out.buf = eptx_push_str(out.buf, "    mul.f32 ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", 0f3D000000;\n")  // 0.03125 in hex float
    }
    out
}

// Provenance OR-reduction across warp
fn epistemic_emit_warp_provenance_merge(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    result_reg: string
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st
    if !out.config.provenance_tracking { return out }

    // Initialize from this lane's provenance
    out.buf = eptx_push_str(out.buf, "    mov.u64 ")
    out.buf = eptx_push_str(out.buf, result_reg)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.prov_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Tree OR-reduction: offsets 16, 8, 4, 2, 1
    var offset: i64 = 16
    while offset >= 1 {
        // Note: shfl operates on b32 — for b64 we need two shuffles
        // For simplicity, use the low 32 bits (provenance typically fits)
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_prov_t0, ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, result_reg)
        out.buf = eptx_push_str(out.buf, ", %r_prov_t0;\n")

        offset = offset / 2
    }
    out
}

// ── Epistemic Compare ───────────────────────────────────────────────

// Compare with confidence estimation:
// confidence = min(1.0, |a - b| / √(ε_a² + ε_b²))
fn epistemic_emit_compare(
    st: EpistemicPtxState,
    result_pred: string,
    result_conf: string,
    left: EpistemicShadow,
    right: EpistemicShadow,
    cmp_op: string        // "lt", "le", "gt", "ge", "eq", "ne"
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Standard comparison for the predicate
    out.buf = eptx_push_str(out.buf, "    setp.")
    out.buf = eptx_push_str(out.buf, cmp_op)
    out.buf = eptx_push_str(out.buf, ".f32 ")
    out.buf = eptx_push_str(out.buf, result_pred)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Confidence: |a - b| / √(ε_a² + ε_b²)
    // |a - b|
    out.buf = eptx_push_str(out.buf, "    sub.f32 %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f32 %r_eps_t0, %r_eps_t0;\n")

    // √(ε_a² + ε_b²)
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t2, ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t3, %r_eps_t1, %r_eps_t2;\n")
    out.buf = eptx_push_str(out.buf, "    sqrt.approx.f32 %r_eps_t3, %r_eps_t3;\n")

    // Confidence = |a-b| / combined_ε
    out.buf = eptx_push_str(out.buf, "    div.approx.f32 ")
    out.buf = eptx_push_str(out.buf, result_conf)
    out.buf = eptx_push_str(out.buf, ", %r_eps_t0, %r_eps_t3;\n")

    // Clamp to [0, 1]
    out.buf = eptx_push_str(out.buf, "    min.f32 ")
    out.buf = eptx_push_str(out.buf, result_conf)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, result_conf)
    out.buf = eptx_push_str(out.buf, ", 0f3F800000;\n")  // 1.0
    out
}

// ── Epistemic Select ────────────────────────────────────────────────

// Select with epistemic propagation:
// ε_result = max(ε_true, ε_false)
// prov_result = prov_true | prov_false
fn epistemic_emit_select(
    st: EpistemicPtxState,
    result: EpistemicShadow,
    pred: string,
    true_val: EpistemicShadow,
    false_val: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value select
    out.buf = eptx_push_str(out.buf, "    selp.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, true_val.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, false_val.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, pred)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon: conservative = max(ε_true, ε_false)
    out.buf = eptx_push_str(out.buf, "    max.f32 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, true_val.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, false_val.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Validity: select
    out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t0, 1, 0, ")
    out.buf = eptx_push_str(out.buf, true_val.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t1, 1, 0, ")
    out.buf = eptx_push_str(out.buf, false_val.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    selp.b32 %r_eps_t2, %r_eps_t0, %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, pred)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    setp.ne.s32 ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", %r_eps_t2, 0;\n")

    // Provenance: OR (union of both paths — conservative)
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, true_val.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, false_val.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }
    out
}

// ── Epistemic Reduction (sum with uncertainty) ──────────────────────

// Sum reduction with epistemic tracking:
// ε_sum = √(Σ ε_i²)  [quadrature for independent errors]
fn epistemic_emit_warp_reduce_sum(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    result: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Value: tree sum via shfl
    out.buf = eptx_push_str(out.buf, "    mov.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon²: accumulate squares
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t4, ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    var offset: i64 = 16
    while offset >= 1 {
        // Value reduction
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_eps_t0, ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", %r_eps_t0;\n")

        // Epsilon² reduction (add squares)
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_eps_t1, %r_eps_t4, ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t4, %r_eps_t4, %r_eps_t1;\n")

        offset = offset / 2
    }

    // Final epsilon = sqrt(sum of squares)
    out.buf = eptx_push_str(out.buf, "    sqrt.approx.f32 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", %r_eps_t4;\n")

    // Validity: all-reduce via vote.sync.all
    out.buf = eptx_push_str(out.buf, "    vote.sync.all.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 0xffffffff;\n")

    // Provenance: OR-reduce
    if out.config.provenance_tracking {
        out = epistemic_emit_warp_provenance_merge(out, shadow, result.prov_name)
    }
    out
}

// ── Weighted Mean (inverse-epsilon weighting) ───────────────────────

// Weighted mean: w_i = 1/(1 + ε_i), result = Σ(v_i · w_i) / Σ(w_i)
fn epistemic_emit_weighted_mean(
    st: EpistemicPtxState,
    shadow: EpistemicShadow,
    result: EpistemicShadow
) -> EpistemicPtxState with Mut, Panic, Div, Alloc {
    var out = st

    // Compute weight: w = 1.0 / (1.0 + ε)
    out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t0, ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", 0f3F800000;\n")  // 1.0 + ε
    out.buf = eptx_push_str(out.buf, "    rcp.approx.f32 %r_eps_t0, %r_eps_t0;\n")  // w = 1/(1+ε)

    // Weighted value: v * w
    out.buf = eptx_push_str(out.buf, "    mul.f32 %r_eps_t1, ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ", %r_eps_t0;\n")

    // Warp-reduce weighted value sum + weight sum
    // (uses %r_eps_t1 for weighted val sum, %r_eps_t0 for weight sum)
    var offset: i64 = 16
    while offset >= 1 {
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_eps_t2, %r_eps_t1, ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t1, %r_eps_t1, %r_eps_t2;\n")

        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b32 %r_eps_t3, %r_eps_t0, ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f32 %r_eps_t0, %r_eps_t0, %r_eps_t3;\n")

        offset = offset / 2
    }

    // Result = weighted sum / total weight
    out.buf = eptx_push_str(out.buf, "    div.approx.f32 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", %r_eps_t1, %r_eps_t0;\n")

    // Epsilon of weighted mean = Σ(ε_i · w_i) / Σ(w_i)
    // Simplified: use min epsilon across warp
    out = epistemic_emit_warp_epsilon_reduce(out, shadow, result.eps_name, 0)

    // Validity: all valid
    out.buf = eptx_push_str(out.buf, "    vote.sync.all.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 0xffffffff;\n")

    if out.config.provenance_tracking {
        out = epistemic_emit_warp_provenance_merge(out, shadow, result.prov_name)
    }
    out
}

// ══════════════════════════════════════════════════════════════════════
// Phase 2: f64 Epistemic Shadow Registers — Knowledge<f64> on GPU
// ══════════════════════════════════════════════════════════════════════
//
// Promotes all shadow registers to f64 for double-precision epistemic
// computing. Uses %fd_ prefix for f64 values, f64 epsilon (matching
// precision), pred for validity, u64 for provenance.

struct EpistemicShadowF64 {
    val_name: string,    // e.g. "%fd_a"       (f64)
    eps_name: string,    // e.g. "%fd_a_eps"   (f64)
    valid_name: string,  // e.g. "%p_a_valid"  (pred)
    prov_name: string,   // e.g. "%rd_a_prov"  (u64)
}

fn epistemic_shadow_f64_new(base: string) -> EpistemicShadowF64 with Alloc {
    EpistemicShadowF64 {
        val_name: "%fd_" ++ base,
        eps_name: "%fd_" ++ base ++ "_eps",
        valid_name: "%p_" ++ base ++ "_valid",
        prov_name: "%rd_" ++ base ++ "_prov",
    }
}

// Extended state for f64 epistemic compilation
struct EpistemicF64State {
    buf: EpistemicPtxBuf,
    config: EpistemicPtxConfig,
    shadow_counter: i64,
    temp_f64_count: i64,
    temp_pred_count: i64,
    temp_u64_count: i64,
}

fn epistemic_f64_new(config: EpistemicPtxConfig) -> EpistemicF64State {
    EpistemicF64State {
        buf: eptx_buf_new(),
        config: config,
        shadow_counter: 0,
        temp_f64_count: 0,
        temp_pred_count: 0,
        temp_u64_count: 0,
    }
}

fn epistemic_f64_alloc_shadow(
    st: EpistemicF64State,
    base: string
) -> (EpistemicF64State, EpistemicShadowF64) with Mut, Panic, Div, Alloc {
    var out = st
    let idx = out.shadow_counter
    out.shadow_counter = idx + 1
    let name = base ++ "_" ++ eptx_i64_to_string(idx)
    let shadow = epistemic_shadow_f64_new(name)
    (out, shadow)
}

// f64 shadow register pool declaration
fn epistemic_f64_emit_shadow_reg_pool(
    st: EpistemicF64State,
    num_shadows: i64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = eptx_push_str(out.buf, "    // Epistemic f64 shadow registers (Knowledge<f64>)\n")
    // Value registers (f64)
    out.buf = eptx_push_str(out.buf, "    .reg .f64 %fd_<")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows * 2))
    out.buf = eptx_push_str(out.buf, ">;  // f64 values + epsilons\n")
    // Validity predicates
    out.buf = eptx_push_str(out.buf, "    .reg .pred %p_<")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows + 16))
    out.buf = eptx_push_str(out.buf, ">;  // validity + temporaries\n")
    // Provenance registers (u64)
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    .reg .b64 %rd_prov_<")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(num_shadows))
        out.buf = eptx_push_str(out.buf, ">;  // provenance\n")
    }
    // Temporary registers for f64 epsilon calculations
    out.buf = eptx_push_str(out.buf, "    .reg .f64 %fd_eps_t<16>;  // f64 epsilon temporaries\n")
    out.buf = eptx_push_str(out.buf, "    .reg .pred %p_eps_t<8>;   // predicate temporaries\n")
    out.buf = eptx_push_str(out.buf, "    .reg .b64 %rd_prov_t<4>;  // provenance temporaries\n")
    out.buf = eptx_push_str(out.buf, "\n")
    out
}

// f64 shadow initialisation
fn epistemic_f64_emit_init_shadow(
    st: EpistemicF64State,
    shadow: EpistemicShadowF64,
    initial_value_hex: string,
    initial_epsilon_hex: string
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    // Value
    out.buf = eptx_push_str(out.buf, "    mov.f64 ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ", 0d")
    out.buf = eptx_push_str(out.buf, initial_value_hex)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Epsilon
    out.buf = eptx_push_str(out.buf, "    mov.f64 ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", 0d")
    out.buf = eptx_push_str(out.buf, initial_epsilon_hex)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Validity = true
    out.buf = eptx_push_str(out.buf, "    setp.eq.s32 ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 1, 1;\n")
    // Provenance
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    mov.u64 ")
        out.buf = eptx_push_str(out.buf, shadow.prov_name)
        out.buf = eptx_push_str(out.buf, ", 0;\n")
    }
    out
}

// ── f64 Add/Sub: ε_c = √(ε_a² + ε_b²)  [quadrature] ───────────────

fn epistemic_f64_emit_add(
    st: EpistemicF64State,
    result: EpistemicShadowF64,
    left: EpistemicShadowF64,
    right: EpistemicShadowF64,
    is_sub: bool
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    // Value computation
    if is_sub {
        out.buf = eptx_push_str(out.buf, "    sub.f64 ")
    } else {
        out.buf = eptx_push_str(out.buf, "    add.f64 ")
    }
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Epsilon: quadrature propagation
    if out.config.quadrature_propagation {
        // ε_a²
        out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t0, ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        // ε_b²
        out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t1, ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        // ε_a² + ε_b²
        out.buf = eptx_push_str(out.buf, "    add.f64 %fd_eps_t2, %fd_eps_t0, %fd_eps_t1;\n")
        // √(ε_a² + ε_b²) — .rn for round-to-nearest (no approx for f64)
        out.buf = eptx_push_str(out.buf, "    sqrt.rn.f64 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", %fd_eps_t2;\n")
    } else {
        out.buf = eptx_push_str(out.buf, "    max.f64 ")
        out.buf = eptx_push_str(out.buf, result.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.eps_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.eps_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    // Validity: conjunction
    out.buf = eptx_push_str(out.buf, "    and.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Provenance: OR (monotonic union) merge
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }
    out
}

// ── f64 Mul: ε_c = |a|·ε_b + |b|·ε_a ───────────────────────────────

fn epistemic_f64_emit_mul(
    st: EpistemicF64State,
    result: EpistemicShadowF64,
    left: EpistemicShadowF64,
    right: EpistemicShadowF64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    // Value
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // |a|
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // |b|
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // |a| * ε_b
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t2, %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // |b| * ε_a
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t3, %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Sum
    out.buf = eptx_push_str(out.buf, "    add.f64 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", %fd_eps_t2, %fd_eps_t3;\n")

    // Validity + provenance (same as f32 pattern)
    out.buf = eptx_push_str(out.buf, "    and.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }
    out
}

// ── f64 Div: ε_c = (|a|·ε_b + |b|·ε_a) / b²  [+ near-zero guard] ──

fn epistemic_f64_emit_div(
    st: EpistemicF64State,
    result: EpistemicShadowF64,
    left: EpistemicShadowF64,
    right: EpistemicShadowF64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    // Value
    out.buf = eptx_push_str(out.buf, "    div.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Numerator: |a|·ε_b + |b|·ε_a
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, left.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t2, %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, right.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t3, %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, left.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    add.f64 %fd_eps_t0, %fd_eps_t2, %fd_eps_t3;\n")
    // Denominator: b²
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // ε_c = numerator / b²
    out.buf = eptx_push_str(out.buf, "    div.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", %fd_eps_t0, %fd_eps_t1;\n")
    // Near-zero guard: if |b| < 1e-12, max out uncertainty
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t2, ")
    out.buf = eptx_push_str(out.buf, right.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // 1e-12 in f64 hex = 0d3D719799812DEA11
    out.buf = eptx_push_str(out.buf, "    setp.lt.f64 %p_eps_t0, %fd_eps_t2, 0d3D719799812DEA11;\n")
    // Max uncertainty = 1.0 in f64 = 0d3FF0000000000000
    out.buf = eptx_push_str(out.buf, "    @%p_eps_t0 mov.f64 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", 0d3FF0000000000000;\n")
    // Validity + provenance
    out.buf = eptx_push_str(out.buf, "    and.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, left.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, right.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, left.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, right.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }
    out
}

// ── f64 FMA: ε = √((|a|·ε_b + |b|·ε_a)² + ε_c²) ──────────────────

fn epistemic_f64_emit_fma(
    st: EpistemicF64State,
    result: EpistemicShadowF64,
    a: EpistemicShadowF64,
    b: EpistemicShadowF64,
    c: EpistemicShadowF64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    // Value: fma(a, b, c)
    out.buf = eptx_push_str(out.buf, "    fma.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, a.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, b.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, c.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Mul part: |a|·ε_b + |b|·ε_a
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, a.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    abs.f64 %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, b.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t2, %fd_eps_t0, ")
    out.buf = eptx_push_str(out.buf, b.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t3, %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, a.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    add.f64 %fd_eps_t0, %fd_eps_t2, %fd_eps_t3;\n")
    // Square the mul part
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t0, %fd_eps_t0, %fd_eps_t0;\n")
    // ε_c²
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t1, ")
    out.buf = eptx_push_str(out.buf, c.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, c.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Sum + sqrt
    out.buf = eptx_push_str(out.buf, "    add.f64 %fd_eps_t2, %fd_eps_t0, %fd_eps_t1;\n")
    out.buf = eptx_push_str(out.buf, "    sqrt.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", %fd_eps_t2;\n")
    // Validity: 3-way
    out.buf = eptx_push_str(out.buf, "    and.pred %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, a.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, b.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    and.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", %p_eps_t0, ")
    out.buf = eptx_push_str(out.buf, c.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Provenance: 3-way OR (monotonic union)
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    or.b64 %rd_prov_t0, ")
        out.buf = eptx_push_str(out.buf, a.prov_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, b.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
        out.buf = eptx_push_str(out.buf, "    or.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", %rd_prov_t0, ")
        out.buf = eptx_push_str(out.buf, c.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }
    out
}

// ══════════════════════════════════════════════════════════════════════
// Phase 2: .knowledge.* PTX Intrinsic Functions
// ══════════════════════════════════════════════════════════════════════
//
// World-first: callable PTX .func definitions that treat Knowledge<f64>
// as a first-class 4-register tuple. Each intrinsic encapsulates the
// full uncertainty propagation sequence as a self-contained PTX function
// that kernel code can call.
//
// Calling convention:
//   .func knowledge_add_f64(
//       .param .f64 out_val, .param .f64 out_eps,
//       .param .b32 out_valid, .param .b64 out_prov,
//       .param .f64 a_val, .param .f64 a_eps,
//       .param .b32 a_valid, .param .b64 a_prov,
//       .param .f64 b_val, .param .f64 b_eps,
//       .param .b32 b_valid, .param .b64 b_prov
//   )

fn knowledge_emit_func_header(
    buf: EpistemicPtxBuf,
    func_name: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "\n// .knowledge.* intrinsic: ")
    out = eptx_push_str(out, func_name)
    out = eptx_push_str(out, "\n.func ")
    out = eptx_push_str(out, func_name)
    out = eptx_push_str(out, "(\n")
    // Output params
    out = eptx_push_str(out, "    .param .f64 _out_val,\n")
    out = eptx_push_str(out, "    .param .f64 _out_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _out_valid,\n")
    out = eptx_push_str(out, "    .param .b64 _out_prov,\n")
    // Input A params
    out = eptx_push_str(out, "    .param .f64 _a_val,\n")
    out = eptx_push_str(out, "    .param .f64 _a_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _a_valid,\n")
    out = eptx_push_str(out, "    .param .b64 _a_prov,\n")
    // Input B params
    out = eptx_push_str(out, "    .param .f64 _b_val,\n")
    out = eptx_push_str(out, "    .param .f64 _b_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _b_valid,\n")
    out = eptx_push_str(out, "    .param .b64 _b_prov\n")
    out = eptx_push_str(out, ")\n{\n")
    // Local register declarations
    out = eptx_push_str(out, "    .reg .f64 %lv, %le, %av, %ae, %bv, %be;\n")
    out = eptx_push_str(out, "    .reg .pred %lp, %ap, %bp;\n")
    out = eptx_push_str(out, "    .reg .b64 %lr, %ar, %br;\n")
    out = eptx_push_str(out, "    .reg .f64 %t0, %t1, %t2, %t3;\n")
    out = eptx_push_str(out, "    .reg .pred %tp;\n")
    out = eptx_push_str(out, "    .reg .b64 %tr;\n")
    out = eptx_push_str(out, "    .reg .b32 %vi;\n")
    out = eptx_push_str(out, "\n")
    // Load params into locals
    out = eptx_push_str(out, "    ld.param.f64 %av, [_a_val];\n")
    out = eptx_push_str(out, "    ld.param.f64 %ae, [_a_eps];\n")
    out = eptx_push_str(out, "    ld.param.b32 %vi, [_a_valid];\n")
    out = eptx_push_str(out, "    setp.ne.s32 %ap, %vi, 0;\n")
    out = eptx_push_str(out, "    ld.param.b64 %ar, [_a_prov];\n")
    out = eptx_push_str(out, "    ld.param.f64 %bv, [_b_val];\n")
    out = eptx_push_str(out, "    ld.param.f64 %be, [_b_eps];\n")
    out = eptx_push_str(out, "    ld.param.b32 %vi, [_b_valid];\n")
    out = eptx_push_str(out, "    setp.ne.s32 %bp, %vi, 0;\n")
    out = eptx_push_str(out, "    ld.param.b64 %br, [_b_prov];\n")
    out = eptx_push_str(out, "\n")
    out
}

fn knowledge_emit_func_footer(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    // Store results back to output params
    out = eptx_push_str(out, "\n    st.param.f64 [_out_val], %lv;\n")
    out = eptx_push_str(out, "    st.param.f64 [_out_eps], %le;\n")
    out = eptx_push_str(out, "    selp.b32 %vi, 1, 0, %lp;\n")
    out = eptx_push_str(out, "    st.param.b32 [_out_valid], %vi;\n")
    out = eptx_push_str(out, "    st.param.b64 [_out_prov], %lr;\n")
    out = eptx_push_str(out, "    ret;\n")
    out = eptx_push_str(out, "}\n")
    out
}

// knowledge_add_f64: additive propagation with quadrature epsilon
fn knowledge_emit_intrinsic_add(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = knowledge_emit_func_header(buf, "knowledge_add_f64")
    // Value: a + b
    out = eptx_push_str(out, "    add.f64 %lv, %av, %bv;\n")
    // Epsilon: √(ε_a² + ε_b²)
    out = eptx_push_str(out, "    mul.rn.f64 %t0, %ae, %ae;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t1, %be, %be;\n")
    out = eptx_push_str(out, "    add.f64 %t2, %t0, %t1;\n")
    out = eptx_push_str(out, "    sqrt.rn.f64 %le, %t2;\n")
    // Validity: and
    out = eptx_push_str(out, "    and.pred %lp, %ap, %bp;\n")
    // Provenance: OR (monotonic union)
    out = eptx_push_str(out, "    or.b64 %lr, %ar, %br;\n")
    out = knowledge_emit_func_footer(out)
    out
}

// knowledge_sub_f64: subtractive propagation (same epsilon as add)
fn knowledge_emit_intrinsic_sub(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = knowledge_emit_func_header(buf, "knowledge_sub_f64")
    out = eptx_push_str(out, "    sub.f64 %lv, %av, %bv;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t0, %ae, %ae;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t1, %be, %be;\n")
    out = eptx_push_str(out, "    add.f64 %t2, %t0, %t1;\n")
    out = eptx_push_str(out, "    sqrt.rn.f64 %le, %t2;\n")
    out = eptx_push_str(out, "    and.pred %lp, %ap, %bp;\n")
    out = eptx_push_str(out, "    or.b64 %lr, %ar, %br;\n")
    out = knowledge_emit_func_footer(out)
    out
}

// knowledge_mul_f64: first-order multiplicative propagation
fn knowledge_emit_intrinsic_mul(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = knowledge_emit_func_header(buf, "knowledge_mul_f64")
    out = eptx_push_str(out, "    mul.rn.f64 %lv, %av, %bv;\n")
    // |a|·ε_b + |b|·ε_a
    out = eptx_push_str(out, "    abs.f64 %t0, %av;\n")
    out = eptx_push_str(out, "    abs.f64 %t1, %bv;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t2, %t0, %be;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t3, %t1, %ae;\n")
    out = eptx_push_str(out, "    add.f64 %le, %t2, %t3;\n")
    out = eptx_push_str(out, "    and.pred %lp, %ap, %bp;\n")
    out = eptx_push_str(out, "    or.b64 %lr, %ar, %br;\n")
    out = knowledge_emit_func_footer(out)
    out
}

// knowledge_div_f64: division with near-zero guard
fn knowledge_emit_intrinsic_div(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = knowledge_emit_func_header(buf, "knowledge_div_f64")
    out = eptx_push_str(out, "    div.rn.f64 %lv, %av, %bv;\n")
    // Numerator: |a|·ε_b + |b|·ε_a
    out = eptx_push_str(out, "    abs.f64 %t0, %av;\n")
    out = eptx_push_str(out, "    abs.f64 %t1, %bv;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t2, %t0, %be;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t3, %t1, %ae;\n")
    out = eptx_push_str(out, "    add.f64 %t0, %t2, %t3;\n")
    // Denominator: b²
    out = eptx_push_str(out, "    mul.rn.f64 %t1, %bv, %bv;\n")
    out = eptx_push_str(out, "    div.rn.f64 %le, %t0, %t1;\n")
    // Near-zero guard
    out = eptx_push_str(out, "    abs.f64 %t2, %bv;\n")
    out = eptx_push_str(out, "    setp.lt.f64 %tp, %t2, 0d3D719799812DEA11;\n")
    out = eptx_push_str(out, "    @%tp mov.f64 %le, 0d3FF0000000000000;\n")
    out = eptx_push_str(out, "    and.pred %lp, %ap, %bp;\n")
    out = eptx_push_str(out, "    or.b64 %lr, %ar, %br;\n")
    out = knowledge_emit_func_footer(out)
    out
}

// knowledge_fma_f64: fused multiply-add (3-input variant)
fn knowledge_emit_intrinsic_fma_header(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "\n// .knowledge.* intrinsic: knowledge_fma_f64\n")
    out = eptx_push_str(out, ".func knowledge_fma_f64(\n")
    out = eptx_push_str(out, "    .param .f64 _out_val,\n")
    out = eptx_push_str(out, "    .param .f64 _out_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _out_valid,\n")
    out = eptx_push_str(out, "    .param .b64 _out_prov,\n")
    out = eptx_push_str(out, "    .param .f64 _a_val, .param .f64 _a_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _a_valid, .param .b64 _a_prov,\n")
    out = eptx_push_str(out, "    .param .f64 _b_val, .param .f64 _b_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _b_valid, .param .b64 _b_prov,\n")
    out = eptx_push_str(out, "    .param .f64 _c_val, .param .f64 _c_eps,\n")
    out = eptx_push_str(out, "    .param .b32 _c_valid, .param .b64 _c_prov\n")
    out = eptx_push_str(out, ")\n{\n")
    out = eptx_push_str(out, "    .reg .f64 %lv, %le, %av, %ae, %bv, %be, %cv, %ce;\n")
    out = eptx_push_str(out, "    .reg .pred %lp, %ap, %bp, %cp, %tp;\n")
    out = eptx_push_str(out, "    .reg .b64 %lr, %ar, %br, %cr, %tr;\n")
    out = eptx_push_str(out, "    .reg .f64 %t0, %t1, %t2, %t3;\n")
    out = eptx_push_str(out, "    .reg .b32 %vi;\n\n")
    // Load all params
    out = eptx_push_str(out, "    ld.param.f64 %av, [_a_val]; ld.param.f64 %ae, [_a_eps];\n")
    out = eptx_push_str(out, "    ld.param.b32 %vi, [_a_valid]; setp.ne.s32 %ap, %vi, 0;\n")
    out = eptx_push_str(out, "    ld.param.b64 %ar, [_a_prov];\n")
    out = eptx_push_str(out, "    ld.param.f64 %bv, [_b_val]; ld.param.f64 %be, [_b_eps];\n")
    out = eptx_push_str(out, "    ld.param.b32 %vi, [_b_valid]; setp.ne.s32 %bp, %vi, 0;\n")
    out = eptx_push_str(out, "    ld.param.b64 %br, [_b_prov];\n")
    out = eptx_push_str(out, "    ld.param.f64 %cv, [_c_val]; ld.param.f64 %ce, [_c_eps];\n")
    out = eptx_push_str(out, "    ld.param.b32 %vi, [_c_valid]; setp.ne.s32 %cp, %vi, 0;\n")
    out = eptx_push_str(out, "    ld.param.b64 %cr, [_c_prov];\n\n")
    out
}

fn knowledge_emit_intrinsic_fma(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = knowledge_emit_intrinsic_fma_header(buf)
    // Value: fma(a, b, c)
    out = eptx_push_str(out, "    fma.rn.f64 %lv, %av, %bv, %cv;\n")
    // Epsilon: √((|a|·ε_b + |b|·ε_a)² + ε_c²)
    out = eptx_push_str(out, "    abs.f64 %t0, %av;\n")
    out = eptx_push_str(out, "    abs.f64 %t1, %bv;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t2, %t0, %be;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t3, %t1, %ae;\n")
    out = eptx_push_str(out, "    add.f64 %t0, %t2, %t3;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t0, %t0, %t0;\n")
    out = eptx_push_str(out, "    mul.rn.f64 %t1, %ce, %ce;\n")
    out = eptx_push_str(out, "    add.f64 %t2, %t0, %t1;\n")
    out = eptx_push_str(out, "    sqrt.rn.f64 %le, %t2;\n")
    // Validity: 3-way and
    out = eptx_push_str(out, "    and.pred %tp, %ap, %bp;\n")
    out = eptx_push_str(out, "    and.pred %lp, %tp, %cp;\n")
    // Provenance: 3-way OR (monotonic union)
    out = eptx_push_str(out, "    or.b64 %tr, %ar, %br;\n")
    out = eptx_push_str(out, "    or.b64 %lr, %tr, %cr;\n")
    // Store results
    out = eptx_push_str(out, "\n    st.param.f64 [_out_val], %lv;\n")
    out = eptx_push_str(out, "    st.param.f64 [_out_eps], %le;\n")
    out = eptx_push_str(out, "    selp.b32 %vi, 1, 0, %lp;\n")
    out = eptx_push_str(out, "    st.param.b32 [_out_valid], %vi;\n")
    out = eptx_push_str(out, "    st.param.b64 [_out_prov], %lr;\n")
    out = eptx_push_str(out, "    ret;\n}\n")
    out
}

// Emit ALL .knowledge.* intrinsic function preamble
fn knowledge_emit_all_intrinsics(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "\n// ═══ .knowledge.* intrinsic functions (Knowledge<f64>) ═══\n")
    out = knowledge_emit_intrinsic_add(out)
    out = knowledge_emit_intrinsic_sub(out)
    out = knowledge_emit_intrinsic_mul(out)
    out = knowledge_emit_intrinsic_div(out)
    out = knowledge_emit_intrinsic_fma(out)
    out
}

// ══════════════════════════════════════════════════════════════════════
// Phase 3: knowledge.load.global.f64 / knowledge.store.global.f64
// ══════════════════════════════════════════════════════════════════════
//
// Cohesive 4-register load/store from a single base address.
// Memory layout per Knowledge<f64> element (32 bytes):
//   offset +0:  f64 value   (8 bytes)
//   offset +8:  f64 epsilon (8 bytes)
//   offset +16: u32 valid   (4 bytes, boolean)
//   offset +20: padding     (4 bytes)
//   offset +24: u64 prov    (8 bytes)

fn knowledge_emit_load_global_f64(
    st: EpistemicF64State,
    shadow: EpistemicShadowF64,
    base_addr_reg: string,
    byte_offset: i64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = eptx_push_str(out.buf, "    // knowledge.load.global.f64 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset))
    out.buf = eptx_push_str(out.buf, "]\n")
    // Value (offset +0)
    out.buf = eptx_push_str(out.buf, "    ld.global.f64 ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ", [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset))
    out.buf = eptx_push_str(out.buf, "];\n")
    // Epsilon (offset +8)
    out.buf = eptx_push_str(out.buf, "    ld.global.f64 ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 8))
    out.buf = eptx_push_str(out.buf, "];\n")
    // Valid (offset +16, u32 → pred)
    out.buf = eptx_push_str(out.buf, "    ld.global.u32 %fd_eps_t_vi, [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 16))
    out.buf = eptx_push_str(out.buf, "];\n")
    out.buf = eptx_push_str(out.buf, "    setp.ne.s32 ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", %fd_eps_t_vi, 0;\n")
    // Provenance (offset +24)
    out.buf = eptx_push_str(out.buf, "    ld.global.u64 ")
    out.buf = eptx_push_str(out.buf, shadow.prov_name)
    out.buf = eptx_push_str(out.buf, ", [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 24))
    out.buf = eptx_push_str(out.buf, "];\n")
    out
}

fn knowledge_emit_store_global_f64(
    st: EpistemicF64State,
    shadow: EpistemicShadowF64,
    base_addr_reg: string,
    byte_offset: i64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = eptx_push_str(out.buf, "    // knowledge.store.global.f64 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset))
    out.buf = eptx_push_str(out.buf, "]\n")
    // Value
    out.buf = eptx_push_str(out.buf, "    st.global.f64 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset))
    out.buf = eptx_push_str(out.buf, "], ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Epsilon
    out.buf = eptx_push_str(out.buf, "    st.global.f64 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 8))
    out.buf = eptx_push_str(out.buf, "], ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    // Valid (pred → u32)
    out.buf = eptx_push_str(out.buf, "    selp.b32 %fd_eps_t_vi, 1, 0, ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out.buf = eptx_push_str(out.buf, "    st.global.u32 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 16))
    out.buf = eptx_push_str(out.buf, "], %fd_eps_t_vi;\n")
    // Provenance
    out.buf = eptx_push_str(out.buf, "    st.global.u64 [")
    out.buf = eptx_push_str(out.buf, base_addr_reg)
    out.buf = eptx_push_str(out.buf, "+")
    out.buf = eptx_push_str(out.buf, eptx_i64_to_string(byte_offset + 24))
    out.buf = eptx_push_str(out.buf, "], ")
    out.buf = eptx_push_str(out.buf, shadow.prov_name)
    out.buf = eptx_push_str(out.buf, ";\n")
    out
}

// ══════════════════════════════════════════════════════════════════════
// Phase 4: knowledge.reduce.warp.f64
// ══════════════════════════════════════════════════════════════════════
//
// Combined warp-wide Knowledge reduction:
//   - Value: sum via shfl.sync.down.b64 tree
//   - Epsilon: quadrature (√Σε²) via shfl.sync.down.b64
//   - Validity: all-reduce via vote.sync.all
//   - Provenance: OR-reduce via shfl.sync.down.b64 + or.b64

fn knowledge_emit_warp_reduce_f64(
    st: EpistemicF64State,
    shadow: EpistemicShadowF64,
    result: EpistemicShadowF64
) -> EpistemicF64State with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = eptx_push_str(out.buf, "    // knowledge.reduce.warp.f64\n")

    // Init result from lane value
    out.buf = eptx_push_str(out.buf, "    mov.f64 ")
    out.buf = eptx_push_str(out.buf, result.val_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.val_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Init epsilon² accumulator
    out.buf = eptx_push_str(out.buf, "    mul.rn.f64 %fd_eps_t4, ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.eps_name)
    out.buf = eptx_push_str(out.buf, ";\n")

    // Init provenance accumulator
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    mov.b64 %rd_prov_t0, ")
        out.buf = eptx_push_str(out.buf, shadow.prov_name)
        out.buf = eptx_push_str(out.buf, ";\n")
    }

    // Tree reduction: 16, 8, 4, 2, 1
    var offset: i64 = 16
    while offset >= 1 {
        // Value sum
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b64 %fd_eps_t0, ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f64 ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", ")
        out.buf = eptx_push_str(out.buf, result.val_name)
        out.buf = eptx_push_str(out.buf, ", %fd_eps_t0;\n")

        // Epsilon² sum
        out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b64 %fd_eps_t1, %fd_eps_t4, ")
        out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
        out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
        out.buf = eptx_push_str(out.buf, "    add.f64 %fd_eps_t4, %fd_eps_t4, %fd_eps_t1;\n")

        // Provenance OR
        if out.config.provenance_tracking {
            out.buf = eptx_push_str(out.buf, "    shfl.sync.down.b64 %rd_prov_t1, %rd_prov_t0, ")
            out.buf = eptx_push_str(out.buf, eptx_i64_to_string(offset))
            out.buf = eptx_push_str(out.buf, ", 31, 0xffffffff;\n")
            out.buf = eptx_push_str(out.buf, "    or.b64 %rd_prov_t0, %rd_prov_t0, %rd_prov_t1;\n")
        }

        offset = offset / 2
    }

    // Final epsilon = √(sum of squares)
    out.buf = eptx_push_str(out.buf, "    sqrt.rn.f64 ")
    out.buf = eptx_push_str(out.buf, result.eps_name)
    out.buf = eptx_push_str(out.buf, ", %fd_eps_t4;\n")

    // Validity: all-reduce
    out.buf = eptx_push_str(out.buf, "    vote.sync.all.pred ")
    out.buf = eptx_push_str(out.buf, result.valid_name)
    out.buf = eptx_push_str(out.buf, ", ")
    out.buf = eptx_push_str(out.buf, shadow.valid_name)
    out.buf = eptx_push_str(out.buf, ", 0xffffffff;\n")

    // Provenance result
    if out.config.provenance_tracking {
        out.buf = eptx_push_str(out.buf, "    mov.b64 ")
        out.buf = eptx_push_str(out.buf, result.prov_name)
        out.buf = eptx_push_str(out.buf, ", %rd_prov_t0;\n")
    }
    out
}

// ══════════════════════════════════════════════════════════════════════
// Phase 5: epistemic_ptx_compile_kernel — Full Pipeline Entry Point
// ══════════════════════════════════════════════════════════════════════
//
// Generates a complete epistemic PTX kernel with:
//   1. PTX header (.version, .target, .address_size)
//   2. .knowledge.* intrinsic function preamble
//   3. Kernel entry point with Knowledge<f64> parameters
//   4. Shadow register allocation
//   5. Epistemic load, compute, store sequence
//
// This is the world-first: an entire PTX kernel that natively computes
// with uncertainty-tracked values from load to store.

struct EpistemicKernelSpec {
    name: string,
    num_params: i64,        // number of Knowledge<f64> pointer params
    num_elements: i64,      // elements per param (for launch bounds)
    sm_major: i64,
    sm_minor: i64,
    emit_intrinsics: bool,  // whether to emit .knowledge.* func defs
    block_size: i64,        // threads per block
}

fn epistemic_kernel_spec_default() -> EpistemicKernelSpec with Alloc {
    EpistemicKernelSpec {
        name: "epistemic_kernel",
        num_params: 3,
        num_elements: 1024,
        sm_major: 8,
        sm_minor: 0,
        emit_intrinsics: true,
        block_size: 256,
    }
}

fn epistemic_ptx_compile_kernel_header(
    buf: EpistemicPtxBuf,
    spec: EpistemicKernelSpec
) -> EpistemicPtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    // PTX header
    out = eptx_push_str(out, ".version 7.8\n")
    out = eptx_push_str(out, ".target sm_")
    out = eptx_push_str(out, eptx_i64_to_string(spec.sm_major))
    out = eptx_push_str(out, eptx_i64_to_string(spec.sm_minor))
    out = eptx_push_str(out, "\n")
    out = eptx_push_str(out, ".address_size 64\n\n")

    // Emit .knowledge.* intrinsic function preamble
    if spec.emit_intrinsics {
        out = knowledge_emit_all_intrinsics(out)
    }

    // Kernel entry
    out = eptx_push_str(out, "\n.visible .entry ")
    out = eptx_push_str(out, spec.name)
    out = eptx_push_str(out, "(\n")
    // 3 Knowledge<f64> array pointers + 1 count param
    out = eptx_push_str(out, "    .param .u64 param_a,  // Knowledge<f64>* input A\n")
    out = eptx_push_str(out, "    .param .u64 param_b,  // Knowledge<f64>* input B\n")
    out = eptx_push_str(out, "    .param .u64 param_out, // Knowledge<f64>* output\n")
    out = eptx_push_str(out, "    .param .u32 param_n   // element count\n")
    out = eptx_push_str(out, ")\n")
    out
}

fn epistemic_ptx_compile_kernel(
    spec: EpistemicKernelSpec,
    config: EpistemicPtxConfig
) -> EpistemicPtxBuf with Mut, Panic, Div, Alloc {
    var buf = eptx_buf_new()

    // Header + intrinsics + kernel signature
    buf = epistemic_ptx_compile_kernel_header(buf, spec)

    // Kernel body
    buf = eptx_push_str(buf, "{\n")
    // Register declarations
    buf = eptx_push_str(buf, "    .reg .b32 %r<8>;\n")
    buf = eptx_push_str(buf, "    .reg .b64 %rd<16>;\n")
    buf = eptx_push_str(buf, "    .reg .pred %p<4>;\n")
    buf = eptx_push_str(buf, "    .reg .b32 %fd_eps_t_vi;  // valid-int temp\n")

    // f64 epistemic shadow registers: 3 Knowledge values (a, b, out)
    var f64st = epistemic_f64_new(config)
    f64st.buf = buf
    f64st = epistemic_f64_emit_shadow_reg_pool(f64st, 8)
    buf = f64st.buf

    // Thread index calculation
    buf = eptx_push_str(buf, "\n    // Thread index = blockIdx.x * blockDim.x + threadIdx.x\n")
    buf = eptx_push_str(buf, "    mov.u32 %r0, %tid.x;\n")
    buf = eptx_push_str(buf, "    mov.u32 %r1, %ctaid.x;\n")
    buf = eptx_push_str(buf, "    mov.u32 %r2, %ntid.x;\n")
    buf = eptx_push_str(buf, "    mad.lo.s32 %r3, %r1, %r2, %r0;\n")

    // Bounds check
    buf = eptx_push_str(buf, "    ld.param.u32 %r4, [param_n];\n")
    buf = eptx_push_str(buf, "    setp.ge.u32 %p0, %r3, %r4;\n")
    buf = eptx_push_str(buf, "    @%p0 bra $L_exit;\n\n")

    // Compute byte offset (element_stride = 32 bytes per Knowledge<f64>)
    buf = eptx_push_str(buf, "    cvt.u64.u32 %rd0, %r3;\n")
    buf = eptx_push_str(buf, "    mul.lo.u64 %rd1, %rd0, 32;  // 32 bytes per Knowledge<f64>\n\n")

    // Load base addresses
    buf = eptx_push_str(buf, "    ld.param.u64 %rd2, [param_a];\n")
    buf = eptx_push_str(buf, "    ld.param.u64 %rd3, [param_b];\n")
    buf = eptx_push_str(buf, "    ld.param.u64 %rd4, [param_out];\n")
    buf = eptx_push_str(buf, "    add.u64 %rd5, %rd2, %rd1;  // addr_a\n")
    buf = eptx_push_str(buf, "    add.u64 %rd6, %rd3, %rd1;  // addr_b\n")
    buf = eptx_push_str(buf, "    add.u64 %rd7, %rd4, %rd1;  // addr_out\n\n")

    // Load Knowledge<f64> A and B
    let a_sh = epistemic_shadow_f64_new("ka")
    let b_sh = epistemic_shadow_f64_new("kb")
    let out_sh = epistemic_shadow_f64_new("ko")

    f64st.buf = buf
    f64st = knowledge_emit_load_global_f64(f64st, a_sh, "%rd5", 0)
    f64st = knowledge_emit_load_global_f64(f64st, b_sh, "%rd6", 0)

    // Compute: out = a + b (with epistemic propagation)
    f64st = epistemic_f64_emit_add(f64st, out_sh, a_sh, b_sh, false)

    // Store result
    f64st = knowledge_emit_store_global_f64(f64st, out_sh, "%rd7", 0)
    buf = f64st.buf

    // Exit label
    buf = eptx_push_str(buf, "\n$L_exit:\n")
    buf = eptx_push_str(buf, "    ret;\n")
    buf = eptx_push_str(buf, "}\n")
    buf
}

// ── Smoke-test entry point ───────────────────────────────────────────
//
// Validates that the epistemic PTX codegen emits the expected opcodes for
// each uncertainty propagation rule. Runs standalone via `souc run`.

fn epistemic_smoke_test_add() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_ptx_new(cfg)
    let a_sh = epistemic_shadow_new("a")
    let b_sh = epistemic_shadow_new("b")
    let c_sh = epistemic_shadow_new("c")
    st = epistemic_emit_shadow_reg_pool(st, 8)
    st = epistemic_emit_init_shadow(st, a_sh, "0f3F800000", "0f3A83126F")
    st = epistemic_emit_init_shadow(st, b_sh, "0f40000000", "0f3A83126F")
    st = epistemic_emit_add(st, c_sh, a_sh, b_sh, false)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "add.f32") && eptx_str_contains(ptx, "sqrt.approx.f32")
}

fn epistemic_smoke_test_mul() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_ptx_new(cfg)
    let a_sh = epistemic_shadow_new("a")
    let b_sh = epistemic_shadow_new("b")
    let c_sh = epistemic_shadow_new("c")
    st = epistemic_emit_shadow_reg_pool(st, 8)
    st = epistemic_emit_init_shadow(st, a_sh, "0f3F800000", "0f3A83126F")
    st = epistemic_emit_init_shadow(st, b_sh, "0f40000000", "0f3A83126F")
    st = epistemic_emit_mul(st, c_sh, a_sh, b_sh)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "mul.rn.f32") && eptx_str_contains(ptx, "abs.f32")
}

fn epistemic_smoke_test_fma() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_ptx_new(cfg)
    let a_sh = epistemic_shadow_new("a")
    let b_sh = epistemic_shadow_new("b")
    let c_sh = epistemic_shadow_new("c")
    let r_sh = epistemic_shadow_new("r")
    st = epistemic_emit_shadow_reg_pool(st, 8)
    st = epistemic_emit_init_shadow(st, a_sh, "0f3F800000", "0f3A83126F")
    st = epistemic_emit_init_shadow(st, b_sh, "0f40000000", "0f3A83126F")
    st = epistemic_emit_init_shadow(st, c_sh, "0f3E800000", "0f39000000")
    st = epistemic_emit_fma(st, r_sh, a_sh, b_sh, c_sh)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "fma.rn.f32") && eptx_str_contains(ptx, "sqrt.approx.f32")
}

fn epistemic_smoke_test_warp_reduce() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_ptx_new(cfg)
    let s_sh = epistemic_shadow_new("s")
    let r_sh = epistemic_shadow_new("r")
    st = epistemic_emit_shadow_reg_pool(st, 4)
    st = epistemic_emit_warp_reduce_sum(st, s_sh, r_sh)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "shfl.sync.down.b32") && eptx_str_contains(ptx, "vote.sync.all.pred")
}

