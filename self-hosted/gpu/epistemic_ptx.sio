// ── Phase 3 smoke test: .knowledge.* intrinsic functions ─────────────

fn epistemic_smoke_test_knowledge_intrinsics() -> bool with Mut, Panic, Div, Alloc {
    var buf = eptx_buf_new()
    buf = knowledge_emit_all_intrinsics(buf)
    let ptx = eptx_to_string(buf)
    // Verify all 5 intrinsic functions were emitted
    eptx_str_contains(ptx, "knowledge_add_f64") &&
    eptx_str_contains(ptx, "knowledge_sub_f64") &&
    eptx_str_contains(ptx, "knowledge_mul_f64") &&
    eptx_str_contains(ptx, "knowledge_div_f64") &&
    eptx_str_contains(ptx, "knowledge_fma_f64") &&
    // Verify key PTX opcodes in the function bodies
    eptx_str_contains(ptx, "sqrt.rn.f64") &&
    eptx_str_contains(ptx, "abs.f64") &&
    eptx_str_contains(ptx, "and.pred") &&
    eptx_str_contains(ptx, "or.b64") &&
    eptx_str_contains(ptx, ".func")
}

// ── Phase 4 smoke test: knowledge.load/store ─────────────────────────

fn epistemic_smoke_test_knowledge_load_store() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_f64_new(cfg)
    let a_sh = epistemic_shadow_f64_new("a")
    st = epistemic_f64_emit_shadow_reg_pool(st, 4)
    st = knowledge_emit_load_global_f64(st, a_sh, "%rd0", 0)
    st = knowledge_emit_store_global_f64(st, a_sh, "%rd1", 0)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "ld.global.f64") &&
    eptx_str_contains(ptx, "ld.global.u64") &&
    eptx_str_contains(ptx, "st.global.f64") &&
    eptx_str_contains(ptx, "st.global.u64") &&
    eptx_str_contains(ptx, "knowledge.load.global.f64") &&
    eptx_str_contains(ptx, "knowledge.store.global.f64")
}

// ── Phase 5 smoke test: full kernel compile ──────────────────────────

fn epistemic_smoke_test_full_kernel() -> bool with Mut, Panic, Div, Alloc {
    let spec = epistemic_kernel_spec_default()
    let cfg = epistemic_config_default()
    let buf = epistemic_ptx_compile_kernel(spec, cfg)
    let ptx = eptx_to_string(buf)
    // Verify kernel structure
    eptx_str_contains(ptx, ".version 7.8") &&
    eptx_str_contains(ptx, ".target sm_80") &&
    eptx_str_contains(ptx, ".visible .entry epistemic_kernel") &&
    // Verify .knowledge.* intrinsics were emitted
    eptx_str_contains(ptx, "knowledge_add_f64") &&
    eptx_str_contains(ptx, "knowledge_mul_f64") &&
    // Verify Knowledge<f64> operations in kernel body
    eptx_str_contains(ptx, "knowledge.load.global.f64") &&
    eptx_str_contains(ptx, "knowledge.store.global.f64") &&
    eptx_str_contains(ptx, "add.f64") &&
    eptx_str_contains(ptx, "sqrt.rn.f64") &&
    // Verify structure
    eptx_str_contains(ptx, "param_a") &&
    eptx_str_contains(ptx, "param_out") &&
    eptx_str_contains(ptx, "$L_exit")
}

// ── Phase 5 smoke test: warp reduce f64 ──────────────────────────────

fn epistemic_smoke_test_warp_reduce_f64() -> bool with Mut, Panic, Div, Alloc {
    let cfg = epistemic_config_default()
    var st = epistemic_f64_new(cfg)
    let s_sh = epistemic_shadow_f64_new("s")
    let r_sh = epistemic_shadow_f64_new("r")
    st = epistemic_f64_emit_shadow_reg_pool(st, 4)
    st = knowledge_emit_warp_reduce_f64(st, s_sh, r_sh)
    let ptx = eptx_to_string(st.buf)
    eptx_str_contains(ptx, "shfl.sync.down.b64") &&
    eptx_str_contains(ptx, "vote.sync.all.pred") &&
    eptx_str_contains(ptx, "sqrt.rn.f64") &&
    eptx_str_contains(ptx, "or.b64")
}

fn gpu_epistemic_ptx_main() -> i64 with Mut, Panic, Div, Alloc, IO {
    var passed: i64 = 0
    var total: i64 = 0

    // Original f32 tests
    if epistemic_smoke_test_add() {
        passed = passed + 1
        print("  T1  OK (f32 add: quadrature epsilon + sqrt)\n")
    } else {
        print("  FAIL T1 (f32 add)\n")
    }
    total = total + 1

    if epistemic_smoke_test_mul() {
        passed = passed + 1
        print("  T2  OK (f32 mul: first-order epsilon + abs)\n")
    } else {
        print("  FAIL T2 (f32 mul)\n")
    }
    total = total + 1

    if epistemic_smoke_test_fma() {
        passed = passed + 1
        print("  T3  OK (f32 fma: combined epsilon + sqrt)\n")
    } else {
        print("  FAIL T3 (f32 fma)\n")
    }
    total = total + 1

    if epistemic_smoke_test_warp_reduce() {
        passed = passed + 1
        print("  T4  OK (f32 warp reduce: shfl + vote.sync)\n")
    } else {
        print("  FAIL T4 (f32 warp reduce)\n")
    }
    total = total + 1

    // f64 Knowledge<f64> tests
    if epistemic_smoke_test_f64_add() {
        passed = passed + 1
        print("  T5  OK (f64 add: quadrature + sqrt.rn.f64)\n")
    } else {
        print("  FAIL T5 (f64 add)\n")
    }
    total = total + 1

    if epistemic_smoke_test_f64_mul() {
        passed = passed + 1
        print("  T6  OK (f64 mul: first-order + abs.f64)\n")
    } else {
        print("  FAIL T6 (f64 mul)\n")
    }
    total = total + 1

    if epistemic_smoke_test_f64_div() {
        passed = passed + 1
        print("  T7  OK (f64 div: near-zero guard + setp.lt.f64)\n")
    } else {
        print("  FAIL T7 (f64 div)\n")
    }
    total = total + 1

    if epistemic_smoke_test_f64_fma() {
        passed = passed + 1
        print("  T8  OK (f64 fma: 3-input + sqrt.rn.f64)\n")
    } else {
        print("  FAIL T8 (f64 fma)\n")
    }
    total = total + 1

    // .knowledge.* intrinsic function tests
    if epistemic_smoke_test_knowledge_intrinsics() {
        passed = passed + 1
        print("  T9  OK (.knowledge.* intrinsic functions emitted)\n")
    } else {
        print("  FAIL T9 (.knowledge.* intrinsics)\n")
    }
    total = total + 1

    if epistemic_smoke_test_knowledge_load_store() {
        passed = passed + 1
        print("  T10 OK (knowledge.load/store.global.f64)\n")
    } else {
        print("  FAIL T10 (knowledge load/store)\n")
    }
    total = total + 1

    // Full kernel compile test
    if epistemic_smoke_test_full_kernel() {
        passed = passed + 1
        print("  T11 OK (full epistemic kernel compile)\n")
    } else {
        print("  FAIL T11 (full kernel)\n")
    }
    total = total + 1

    // Warp reduce f64 test
    if epistemic_smoke_test_warp_reduce_f64() {
        passed = passed + 1
        print("  T12 OK (knowledge.reduce.warp.f64)\n")
    } else {
        print("  FAIL T12 (warp reduce f64)\n")
    }
    total = total + 1

    if passed == total {
        print("epistemic_ptx: all " ++ eptx_i64_to_string(total) ++ " tests passed\n")
        0
    } else {
        print("epistemic_ptx: " ++ eptx_i64_to_string(passed) ++ "/" ++ eptx_i64_to_string(total) ++ " passed\n")
        1
    }
}
