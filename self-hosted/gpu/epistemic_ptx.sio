fn eptx_push_binary3(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    lhs: string,
    rhs: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, lhs)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, rhs)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_binary2(
    buf: EpistemicPtxBuf,
    opcode: string,
    lhs: string,
    rhs: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, lhs)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, rhs)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_push_binary_mem2(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst_or_dst_ptr: string,
    rhs_or_rhs_ptr: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst_or_dst_ptr)
    out = eptx_push_str(out, ", [")
    out = eptx_push_str(out, rhs_or_rhs_ptr)
    out = eptx_push_str(out, "];\n")
    out
}

fn eptx_push_store_mem(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst_ptr: string,
    src: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " [")
    out = eptx_push_str(out, dst_ptr)
    out = eptx_push_str(out, "], ")
    out = eptx_push_str(out, src)
    out = eptx_push_str(out, ";\n")
    out
}

fn eptx_emit_shared_decl(
    buf: EpistemicPtxBuf,
    bytes: i64
) -> EpistemicPtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = eptx_push_str(out, "    .shared .align 4 .b8 shared_array[")
    out = eptx_push_str(out, eptx_i64_to_string(bytes))
    out = eptx_push_str(out, "];\n")
    out
}

fn eptx_push_ret(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    eptx_push_str(buf, "    ret;\n")
}

fn eptx_push_barrier_sync(buf: EpistemicPtxBuf) -> EpistemicPtxBuf with Mut, Panic, Div {
    eptx_push_str(buf, "    bar.sync 0;\n")
}

fn eptx_push_shfl_down(
    buf: EpistemicPtxBuf,
    opcode: string,
    dst: string,
    src: string,
    offset: string
) -> EpistemicPtxBuf with Mut, Panic, Div {
    var out = buf
    out = eptx_push_str(out, "    ")
    out = eptx_push_str(out, opcode)
    out = eptx_push_str(out, " ")
    out = eptx_push_str(out, dst)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, src)
    out = eptx_push_str(out, ", ")
    out = eptx_push_str(out, offset)
    out = eptx_push_str(out, ", 0xffffffff;\n")
    out
}

