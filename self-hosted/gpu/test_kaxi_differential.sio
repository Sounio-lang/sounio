    warp = kaxi_warp_exec(warp, stream)
    emit_sim_mem(state)
    emit_warp_mem(warp)
    emit_c_direct(asm, 8)
    true
}

fn run_kernel_warp_reduce_add() -> bool with IO, Mut, Panic, Div, Alloc {
    emit_kernel_header("warp_reduce_add")
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "warp.reduc r1, r0, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=0, seq=2")
    asm = kaxi_asm_push_line(asm, "store_global r1, addr=r2, seq=3")
    asm = kaxi_asm_push_line(asm, "ret seq=4")
    var stream: KaxiTxnStream = kaxi_assemble(asm)
    var state: KaxiSimState = kaxi_sim_new()
    state = kaxi_sim_exec(state, stream)
    var warp: KaxiWarpState = kaxi_warp_new()
    warp = kaxi_warp_exec(warp, stream)
    emit_sim_mem(state)
    emit_warp_mem(warp)
    emit_c_direct(asm, 8)
    true
}

fn run_kernel_nested_divergence() -> bool with IO, Mut, Panic, Div, Alloc {
    emit_kernel_header("nested_divergence")
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=4, seq=1")
    asm = kaxi_asm_push_line(asm, "setp.lt p0, r0, r1, seq=2")
    asm = kaxi_asm_push_line(asm, "branch p0, target=8, seq=3")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=3, seq=4")
    asm = kaxi_asm_push_line(asm, "store_global r2, addr=r0, seq=5")
    asm = kaxi_asm_push_line(asm, "reconverge seq=6")
    asm = kaxi_asm_push_line(asm, "ret seq=7")
    asm = kaxi_asm_push_line(asm, "load_imm r3, imm=2, seq=8")
    asm = kaxi_asm_push_line(asm, "setp.lt p1, r0, r3, seq=9")
    asm = kaxi_asm_push_line(asm, "branch p1, target=15, seq=10")
    asm = kaxi_asm_push_line(asm, "load_imm r4, imm=2, seq=11")
    asm = kaxi_asm_push_line(asm, "store_global r4, addr=r0, seq=12")
    asm = kaxi_asm_push_line(asm, "reconverge seq=13")
    asm = kaxi_asm_push_line(asm, "ret seq=14")
    asm = kaxi_asm_push_line(asm, "load_imm r5, imm=1, seq=15")
    asm = kaxi_asm_push_line(asm, "store_global r5, addr=r0, seq=16")
    asm = kaxi_asm_push_line(asm, "reconverge seq=17")
    asm = kaxi_asm_push_line(asm, "ret seq=18")
    var stream: KaxiTxnStream = kaxi_assemble(asm)
    var state: KaxiSimState = kaxi_sim_new()
    state = kaxi_sim_exec(state, stream)
    var warp: KaxiWarpState = kaxi_warp_new()
    warp = kaxi_warp_exec(warp, stream)
    emit_sim_mem(state)
    emit_warp_mem(warp)
    emit_c_direct(asm, 8)
    true
}

fn run_kernel_selp() -> bool with IO, Mut, Panic, Div, Alloc {
    emit_kernel_header("selp")
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=2, seq=1")
    asm = kaxi_asm_push_line(asm, "setp.lt p0, r0, r1, seq=2")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=10, seq=3")
    asm = kaxi_asm_push_line(asm, "load_imm r3, imm=20, seq=4")
    asm = kaxi_asm_push_line(asm, "selp r4, r2, r3, pred=p0, seq=5")
    asm = kaxi_asm_push_line(asm, "store_global r4, addr=r0, seq=6")
    asm = kaxi_asm_push_line(asm, "ret seq=7")
    var stream: KaxiTxnStream = kaxi_assemble(asm)
    var state: KaxiSimState = kaxi_sim_new()
    state = kaxi_sim_exec(state, stream)
    var warp: KaxiWarpState = kaxi_warp_new()
    warp = kaxi_warp_exec(warp, stream)
    emit_sim_mem(state)
    emit_warp_mem(warp)
    emit_c_direct(asm, 8)
    true
}

pub fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var all_pass = true
    if !run_kernel_vec_add() { println("FAIL vec_add mismatch"); all_pass = false }
    if !run_kernel_fma() { println("FAIL fma mismatch"); all_pass = false }
    if !run_kernel_mul_div() { println("FAIL mul_div mismatch"); all_pass = false }
    if !run_kernel_multi_lane() { println("FAIL multi_lane mismatch"); all_pass = false }
    if !run_kernel_shared_memory() { println("FAIL shared_memory mismatch"); all_pass = false }
    if !run_kernel_divergent() { println("FAIL divergent mismatch"); all_pass = false }
    if !run_kernel_vote_ballot() { println("FAIL vote_ballot mismatch"); all_pass = false }
    if !run_kernel_shuffle_xor() { println("FAIL shuffle_xor mismatch"); all_pass = false }
    if !run_kernel_warp_reduce_add() { println("FAIL warp_reduce_add mismatch"); all_pass = false }
    if !run_kernel_nested_divergence() { println("FAIL nested_divergence mismatch"); all_pass = false }
    if !run_kernel_selp() { println("FAIL selp mismatch"); all_pass = false }
    if all_pass {
        println("PASS differential_sim")
    } else {
        println("FAIL differential_sim")
    }
    0
}
