    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, val)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Async Copy (cp.async for tensor core pipelines) ─────────────────

fn ptx_cp_async_size_is_valid(cp_size: i64) -> bool {
    cp_size == 4 || cp_size == 8 || cp_size == 16
}

fn ptx_cp_async_normalize_size(cp_size: i64) -> i64 {
    if ptx_cp_async_size_is_valid(cp_size) { return cp_size }
    // PTX only allows 4/8/16-byte payloads; keep invalid callers deterministic.
    16
}

// cp.async.ca.shared.global [dst_shared], [src_global], cp_size;
fn ptx_emit_cp_async(buf: PtxBuf, dst_shared: string, src_global: string, cp_size: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let size = ptx_cp_async_normalize_size(cp_size)
    out = ptx_push_str(out, "    cp.async.ca.shared.global [")
    out = ptx_push_str(out, dst_shared)
    out = ptx_push_str(out, "], [")
    out = ptx_push_str(out, src_global)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, i64_to_string(size))
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_cp_async_arch(
    buf: PtxBuf,
    arch: PtxArch,
    dst_shared: string,
    src_global: string,
    cp_size: i64
) -> PtxBuf with Mut, Panic, Div, Alloc {
    if !ptx_supports_cp_async_arch(arch) {
        var out = buf
        out = ptx_push_str(out, "    // cp.async unavailable for ")
        out = ptx_push_str(out, ptx_sm_version_string(arch.sm_major, arch.sm_minor))
        out = ptx_push_str(out, " (caller should use ld/st fallback)\n")
        return out
    }
    ptx_emit_cp_async(buf, dst_shared, src_global, cp_size)
}

// cp.async.commit_group — commits all pending cp.async in this group
fn ptx_emit_cp_async_commit(buf: PtxBuf) -> PtxBuf with Mut, Panic, Div {
    ptx_push_str(buf, "    cp.async.commit_group;\n")
}

// cp.async.wait_group N — waits until at most N groups remain pending
fn ptx_emit_cp_async_wait(buf: PtxBuf, groups: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    cp.async.wait_group ")
    out = ptx_push_str(out, i64_to_string(groups))
    out = ptx_push_str(out, ";\n")
    out
}

// ── Predicated Instruction Wrappers ─────────────────────────────────

// Predicated add: @pred add.ty dst, lhs, rhs;
fn ptx_emit_add_pred(buf: PtxBuf, pred: string, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    @")
    out = ptx_push_str(out, pred)
    out = ptx_push_str(out, " add.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

// Predicated mov: @pred mov.ty dst, src;
fn ptx_emit_mov_pred(buf: PtxBuf, pred: string, dst: string, src: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    @")
    out = ptx_push_str(out, pred)
    out = ptx_push_str(out, " mov.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

// Negated predicate branch: @!pred bra label;
fn ptx_emit_bra_not_pred(buf: PtxBuf, pred: string, label: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    @!")
    out = ptx_push_str(out, pred)
    out = ptx_push_str(out, " bra ")
    out = ptx_push_str(out, label)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Wide Multiply (mul.wide for 32->64 extension) ───────────────────

fn ptx_emit_mul_wide(buf: PtxBuf, dst: string, lhs: string, rhs: string, src_ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    mul.wide.")
    out = ptx_push_str(out, ptx_type_suffix(src_ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

// ── MAD (multiply-add without fused rounding) ───────────────────────

fn ptx_emit_mad(buf: PtxBuf, dst: string, a: string, b: string, c: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    if ptx_is_float(ty) {
        out = ptx_push_str(out, "    mad.rn.")
        out = ptx_push_str(out, ptx_type_suffix(ty))
    } else {
        out = ptx_push_str(out, "    mad.lo.")
        out = ptx_push_str(out, ptx_type_suffix(ty))
    }
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, a)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, b)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, c)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Conditional Warp Reduce (shfl.down chain) ───────────────────────
// Emit a standard warp-reduce pattern: 5 rounds of shfl.down + add
// for a 32-lane warp. dst is the final accumulated register.

fn ptx_emit_warp_reduce_add_f32(
    buf: PtxBuf,
    dst: string,
    src: string,
    tmp: string
) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    // Round 1: offset 16
    out = ptx_push_str(out, "    shfl.sync.down.b32 ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", 16, 0x1f;\n")
    out = ptx_push_str(out, "    add.f32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ";\n")
    // Round 2: offset 8
    out = ptx_push_str(out, "    shfl.sync.down.b32 ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", 8, 0x1f;\n")
    out = ptx_push_str(out, "    add.f32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ";\n")
    // Round 3: offset 4
    out = ptx_push_str(out, "    shfl.sync.down.b32 ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", 4, 0x1f;\n")
    out = ptx_push_str(out, "    add.f32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ";\n")
    // Round 4: offset 2
    out = ptx_push_str(out, "    shfl.sync.down.b32 ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", 2, 0x1f;\n")
    out = ptx_push_str(out, "    add.f32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ";\n")
    // Round 5: offset 1
    out = ptx_push_str(out, "    shfl.sync.down.b32 ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", 1, 0x1f;\n")
    out = ptx_push_str(out, "    add.f32 ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, tmp)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Texture / Surface Load (basic form) ─────────────────────────────

fn ptx_emit_tex_1d(buf: PtxBuf, dst: string, tex_ref: string, coord: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    tex.1d.v4.f32.f32 {")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, "}, [")
    out = ptx_push_str(out, tex_ref)
    out = ptx_push_str(out, ", {")
    out = ptx_push_str(out, coord)
    out = ptx_push_str(out, "}];\n")
    out
}

