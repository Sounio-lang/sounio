// self-hosted::gpu::ptx_advanced — Full PTX code generator with register allocation
//
// Builds on ptx.sio (PtxBuf) to provide:
//   1. Register allocation (PtxRegCounters) with typed register pools
//   2. Value→register mapping (PtxValueMap)
//   3. Full opcode dispatch from GpuKernelIr → PTX text
//   4. Architecture feature detection (sm_50 through sm_120)
//   5. PTX version selection per compute capability
//   6. Kernel metadata emission (.maxntid, shared memory)
//
// Architecture: GpuKernelIr → ptx_codegen_kernel() → PtxBuf (text)

// ── Register Allocation ─────────────────────────────────────────────

struct PtxRegCounters {
    pred: i64,   // predicate register count
    r16: i64,    // 16-bit register count
    r32: i64,    // 32-bit register count
    r64: i64,    // 64-bit register count
    f32_cnt: i64, // 32-bit float register count
    f64_cnt: i64, // 64-bit float register count
}

fn ptx_reg_counters_new() -> PtxRegCounters {
    PtxRegCounters {
        pred: 0, r16: 0, r32: 0, r64: 0,
        f32_cnt: 0, f64_cnt: 0,
    }
}

// Allocate a register and return its name as a string
fn ptx_alloc_pred(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.pred
    var out = rc
    out.pred = idx + 1
    (out, "p" ++ i64_to_string(idx))
}

fn ptx_alloc_r16(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.r16
    var out = rc
    out.r16 = idx + 1
    (out, "r16_" ++ i64_to_string(idx))
}

fn ptx_alloc_r32(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.r32
    var out = rc
    out.r32 = idx + 1
    (out, "r32_" ++ i64_to_string(idx))
}

fn ptx_alloc_r64(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.r64
    var out = rc
    out.r64 = idx + 1
    (out, "r64_" ++ i64_to_string(idx))
}

fn ptx_alloc_f32(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.f32_cnt
    var out = rc
    out.f32_cnt = idx + 1
    (out, "f32_" ++ i64_to_string(idx))
}

fn ptx_alloc_f64(rc: PtxRegCounters) -> (PtxRegCounters, string) with Alloc {
    let idx = rc.f64_cnt
    var out = rc
    out.f64_cnt = idx + 1
    (out, "f64_" ++ i64_to_string(idx))
}

// Allocate register for a given GpuType
fn ptx_alloc_for_type(rc: PtxRegCounters, ty: GpuType) -> (PtxRegCounters, string) with Alloc {
    if ty == GpuType::GpuF32 {
        return ptx_alloc_f32(rc)
    }
    if ty == GpuType::GpuF64 {
        return ptx_alloc_f64(rc)
    }
    if ty == GpuType::GpuU64 || ty == GpuType::GpuI64 || ty == GpuType::GpuPtr {
        return ptx_alloc_r64(rc)
    }
    if ty == GpuType::GpuU32 || ty == GpuType::GpuI32 {
        return ptx_alloc_r32(rc)
    }
    // Default: 32-bit
    ptx_alloc_r32(rc)
}

// ── Value → Register Map ────────────────────────────────────────────

struct PtxValueMap {
    op_ids: [i64; 4096],       // GpuOp index → unique id
    reg_names: [i64; 4096],    // index → offset into name_buf
    reg_lens: [i64; 4096],     // index → length in name_buf
    types: [i64; 4096],        // index → GpuType as i64
    count: i64,
    name_buf: [i8; 32768],     // flat name storage
    name_buf_len: i64,
}

fn ptx_value_map_new() -> PtxValueMap {
    PtxValueMap {
        op_ids: [0; 4096],
        reg_names: [0; 4096],
        reg_lens: [0; 4096],
        types: [0; 4096],
        count: 0,
        name_buf: [0; 32768],
        name_buf_len: 0,
    }
}

fn ptx_value_map_insert(vm: PtxValueMap, op_idx: i64, name: string, ty: GpuType) -> PtxValueMap with Mut, Panic, Div {
    var out = vm
    let c = out.count
    if c >= 4096 { return out }

    out.op_ids[c as usize] = op_idx

    // Copy name into flat buffer
    let name_start = out.name_buf_len
    let nlen = str_len(name)
    var i: i64 = 0
    while i < nlen {
        if out.name_buf_len < 32768 {
            out.name_buf[out.name_buf_len as usize] = str_char_at(name, i) as i8
            out.name_buf_len = out.name_buf_len + 1
        }
        i = i + 1
    }
    out.reg_names[c as usize] = name_start
    out.reg_lens[c as usize] = nlen

    // Store type as integer for comparison
    var ty_val: i64 = 0
    if ty == GpuType::GpuU32 { ty_val = 1 }
    if ty == GpuType::GpuU64 { ty_val = 2 }
    if ty == GpuType::GpuF32 { ty_val = 3 }
    if ty == GpuType::GpuF64 { ty_val = 4 }
    if ty == GpuType::GpuI32 { ty_val = 5 }
    if ty == GpuType::GpuI64 { ty_val = 6 }
    if ty == GpuType::GpuPtr { ty_val = 7 }
    out.types[c as usize] = ty_val

    out.count = c + 1
    out
}

fn ptx_value_map_get_name(vm: PtxValueMap, op_idx: i64) -> string with Mut, Panic, Div, Alloc {
    var i: i64 = 0
    while i < vm.count {
        if vm.op_ids[i as usize] == op_idx {
            let start = vm.reg_names[i as usize]
            let len = vm.reg_lens[i as usize]
            return str_from_bytes(vm.name_buf, len)
        }
        i = i + 1
    }
    // Not found — return placeholder
    "UNKNOWN"
}

// ── Architecture Capabilities ───────────────────────────────────────

struct PtxArch {
    sm_major: i64,
    sm_minor: i64,
}

fn ptx_arch_new(major: i64, minor: i64) -> PtxArch {
    PtxArch { sm_major: major, sm_minor: minor }
}

fn ptx_sm_version(arch: PtxArch) -> i64 {
    arch.sm_major * 10 + arch.sm_minor
}

fn ptx_recommended_version_major(arch: PtxArch) -> i64 {
    let sm = ptx_sm_version(arch)
    if sm <= 69 { return 6 }
    if sm >= 70 && sm <= 74 { return 6 }
    if sm == 75 { return 6 }
    if sm >= 80 && sm <= 86 { return 7 }
    if sm == 87 { return 7 }
    if sm == 89 { return 8 }
    if sm == 90 { return 8 }
    if sm == 100 { return 8 }
    if sm == 120 { return 8 }
    8
}

fn ptx_recommended_version_minor(arch: PtxArch) -> i64 {
    let sm = ptx_sm_version(arch)
    if sm <= 69 { return 0 }
    if sm >= 70 && sm <= 74 { return 3 }
    if sm == 75 { return 4 }
    if sm >= 80 && sm <= 86 { return 1 }
    if sm == 87 { return 4 }
    if sm == 89 { return 1 }
    if sm == 90 { return 3 }
    if sm == 100 { return 5 }
    if sm == 120 { return 6 }
    5
}

fn ptx_supports_bf16(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 80 }
fn ptx_supports_fp8(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 89 }
fn ptx_supports_tma(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_clusters(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_wgmma(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_fp4(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }
fn ptx_supports_tensor_gen5(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }
fn ptx_supports_nvlink5(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }

// ── PTX Type Strings ────────────────────────────────────────────────

fn ptx_type_suffix(ty: GpuType) -> string {
    if ty == GpuType::GpuF32 { return "f32" }
    if ty == GpuType::GpuF64 { return "f64" }
    if ty == GpuType::GpuI32 { return "s32" }
    if ty == GpuType::GpuI64 { return "s64" }
    if ty == GpuType::GpuU32 { return "u32" }
    if ty == GpuType::GpuU64 { return "u64" }
    if ty == GpuType::GpuPtr { return "u64" }
    "b32"
}

fn ptx_type_decl(ty: GpuType) -> string {
    if ty == GpuType::GpuF32 { return ".f32" }
    if ty == GpuType::GpuF64 { return ".f64" }
    if ty == GpuType::GpuI32 { return ".b32" }
    if ty == GpuType::GpuI64 { return ".b64" }
    if ty == GpuType::GpuU32 { return ".b32" }
    if ty == GpuType::GpuU64 { return ".b64" }
    if ty == GpuType::GpuPtr { return ".b64" }
    ".b32"
}

fn ptx_is_float(ty: GpuType) -> bool {
    ty == GpuType::GpuF32 || ty == GpuType::GpuF64
}

fn ptx_is_signed(ty: GpuType) -> bool {
    ty == GpuType::GpuI32 || ty == GpuType::GpuI64
}

fn ptx_is_64bit(ty: GpuType) -> bool {
    ty == GpuType::GpuU64 || ty == GpuType::GpuI64 || ty == GpuType::GpuF64 || ty == GpuType::GpuPtr
}

fn ptx_bit_width(ty: GpuType) -> string {
    if ptx_is_64bit(ty) { return "64" }
    "32"
}

// ── Codegen State ───────────────────────────────────────────────────

struct PtxCodegenState {
    buf: PtxBuf,
    regs: PtxRegCounters,
    values: PtxValueMap,
    arch: PtxArch,
    label_count: i64,
}

fn ptx_codegen_new(arch: PtxArch) -> PtxCodegenState {
    PtxCodegenState {
        buf: ptx_buf_new(),
        regs: ptx_reg_counters_new(),
        values: ptx_value_map_new(),
        arch: arch,
        label_count: 0,
    }
}

fn ptx_codegen_alloc_label(st: PtxCodegenState) -> (PtxCodegenState, string) with Alloc {
    let idx = st.label_count
    var out = st
    out.label_count = idx + 1
    (out, "L" ++ i64_to_string(idx))
}

// ── Header Emission ─────────────────────────────────────────────────

fn ptx_emit_versioned_header(st: PtxCodegenState) -> PtxCodegenState with Mut, Panic, Div, Alloc {
    var out = st
    let vmaj = ptx_recommended_version_major(out.arch)
    let vmin = ptx_recommended_version_minor(out.arch)
    let sm = ptx_sm_version(out.arch)

    out.buf = ptx_push_str(out.buf, ".version ")
    out.buf = ptx_push_str(out.buf, i64_to_string(vmaj))
    out.buf = ptx_push_str(out.buf, ".")
    out.buf = ptx_push_str(out.buf, i64_to_string(vmin))
    out.buf = ptx_push_str(out.buf, "\n")
    out.buf = ptx_push_str(out.buf, ".target sm_")
    out.buf = ptx_push_str(out.buf, i64_to_string(sm))
    out.buf = ptx_push_str(out.buf, "\n")
    out.buf = ptx_push_str(out.buf, ".address_size 64\n\n")
    out
}

// ── Register Pool Declaration ───────────────────────────────────────

fn ptx_emit_reg_pool(st: PtxCodegenState) -> PtxCodegenState with Mut, Panic, Div, Alloc {
    var out = st

    // Predicate registers
    let pred_cnt = out.regs.pred
    if pred_cnt < 16 { out.buf = ptx_push_str(out.buf, "    .reg .pred p<16>;\n") }
    else { out.buf = ptx_push_str(out.buf, "    .reg .pred p<64>;\n") }

    // 16-bit registers
    if out.regs.r16 > 0 {
        out.buf = ptx_push_str(out.buf, "    .reg .b16 r16_<64>;\n")
    }

    // 32-bit registers
    let r32_pool = if out.regs.r32 < 64 { 64 } else { 128 }
    out.buf = ptx_push_str(out.buf, "    .reg .b32 r32_<")
    out.buf = ptx_push_str(out.buf, i64_to_string(r32_pool))
    out.buf = ptx_push_str(out.buf, ">;\n")

    // 64-bit registers
    let r64_pool = if out.regs.r64 < 64 { 64 } else { 128 }
    out.buf = ptx_push_str(out.buf, "    .reg .b64 r64_<")
    out.buf = ptx_push_str(out.buf, i64_to_string(r64_pool))
    out.buf = ptx_push_str(out.buf, ">;\n")

    // f32 registers
    let f32_pool = if out.regs.f32_cnt < 64 { 64 } else { 128 }
    out.buf = ptx_push_str(out.buf, "    .reg .f32 f32_<")
    out.buf = ptx_push_str(out.buf, i64_to_string(f32_pool))
    out.buf = ptx_push_str(out.buf, ">;\n")

    // f64 registers
    if out.regs.f64_cnt > 0 {
        let f64_pool = if out.regs.f64_cnt < 32 { 32 } else { 64 }
        out.buf = ptx_push_str(out.buf, "    .reg .f64 f64_<")
        out.buf = ptx_push_str(out.buf, i64_to_string(f64_pool))
        out.buf = ptx_push_str(out.buf, ">;\n")
    }

    out.buf = ptx_push_str(out.buf, "\n")
    out
}

// ── Kernel Entry + Parameters ───────────────────────────────────────

fn ptx_emit_kernel_entry(
    st: PtxCodegenState,
    kernel: GpuKernelIr
) -> PtxCodegenState with Mut, Panic, Div, Alloc {
    var out = st

    out.buf = ptx_push_str(out.buf, ".visible .entry ")
    out.buf = ptx_push_str(out.buf, kernel.name)
    out.buf = ptx_push_str(out.buf, "(\n")

    // Emit parameters from the kernel's param_types array
    var pi: i64 = 0
    while pi < kernel.param_count {
        let pty = kernel.param_types[pi as usize]
        out.buf = ptx_push_str(out.buf, "    .param ")
        out.buf = ptx_push_str(out.buf, ptx_type_decl(pty))
        out.buf = ptx_push_str(out.buf, " param_")
        out.buf = ptx_push_str(out.buf, i64_to_string(pi))
        if pi < kernel.param_count - 1 {
            out.buf = ptx_push_str(out.buf, ",")
        }
        out.buf = ptx_push_str(out.buf, "\n")
        pi = pi + 1
    }

    out.buf = ptx_push_str(out.buf, ")\n")

    // Max threads hint
    if kernel.max_threads > 0 {
        out.buf = ptx_push_str(out.buf, ".maxntid ")
        out.buf = ptx_push_str(out.buf, i64_to_string(kernel.max_threads))
        out.buf = ptx_push_str(out.buf, ", 1, 1\n")
    }

    out.buf = ptx_push_str(out.buf, "{\n")
    out
}

// ── Shared Memory Declaration ───────────────────────────────────────

fn ptx_emit_shared_memory(
    st: PtxCodegenState,
    name: string,
    elem_type: GpuType,
    num_elements: i64,
    align: i64
) -> PtxCodegenState with Mut, Panic, Div, Alloc {
    var out = st
    out.buf = ptx_push_str(out.buf, "    .shared .align ")
    out.buf = ptx_push_str(out.buf, i64_to_string(align))
    out.buf = ptx_push_str(out.buf, " ")
    out.buf = ptx_push_str(out.buf, ptx_type_decl(elem_type))
    out.buf = ptx_push_str(out.buf, " ")
    out.buf = ptx_push_str(out.buf, name)
    out.buf = ptx_push_str(out.buf, "[")
    out.buf = ptx_push_str(out.buf, i64_to_string(num_elements))
    out.buf = ptx_push_str(out.buf, "];\n")
    out
}

// ── Instruction Emission ────────────────────────────────────────────

// Emit a single GpuOp instruction. Returns updated state.
// op_idx: index into kernel.ops[] for this instruction
fn ptx_emit_op(
    st: PtxCodegenState,
    kernel: GpuKernelIr,
    op_idx: i64
) -> PtxCodegenState with Mut, Panic, Div, Alloc {
    let opcode = kernel.opcodes[op_idx as usize]
    let dst_type = kernel.dst_types[op_idx as usize]
    let src0 = kernel.src0[op_idx as usize]
    let src1 = kernel.src1[op_idx as usize]
    let src2 = kernel.src2[op_idx as usize]
    let imm = kernel.immediates[op_idx as usize]
    let pred_reg = kernel.pred_regs[op_idx as usize]
    let mem_space = kernel.memory_spaces[op_idx as usize]
    let mask = kernel.masks[op_idx as usize]

    var out = st

    // ── Thread/Block ID ─────────────────────────────────────────
    if opcode == GpuOpcode::GpuGetTid {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        // axis from immediate: 0=x, 1=y, 2=z
        let axis = if imm == 1 { "y" } else if imm == 2 { "z" } else { "x" }
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %tid.")
        out.buf = ptx_push_str(out.buf, axis)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetBid {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        let axis = if imm == 1 { "y" } else if imm == 2 { "z" } else { "x" }
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %ctaid.")
        out.buf = ptx_push_str(out.buf, axis)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetNtid {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        let axis = if imm == 1 { "y" } else if imm == 2 { "z" } else { "x" }
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %ntid.")
        out.buf = ptx_push_str(out.buf, axis)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetGridDim {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        let axis = if imm == 1 { "y" } else if imm == 2 { "z" } else { "x" }
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %nctaid.")
        out.buf = ptx_push_str(out.buf, axis)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetLaneId {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %laneid;\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetWarpId {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %warpid;\n")
        return out
    }

    if opcode == GpuOpcode::GpuGetSmId {
        let alloc_result = ptx_alloc_r32(out.regs)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, GpuType::GpuU32)
        out.buf = ptx_push_str(out.buf, "    mov.u32 ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", %smid;\n")
        return out
    }

    // ── Type Conversion ─────────────────────────────────────────
    if opcode == GpuOpcode::GpuCvt {
        let alloc_result = ptx_alloc_for_type(out.regs, dst_type)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, dst_type)
        let src_name = ptx_value_map_get_name(out.values, src0)
        out.buf = ptx_push_str(out.buf, "    cvt.")
        out.buf = ptx_push_str(out.buf, ptx_type_suffix(dst_type))
        out.buf = ptx_push_str(out.buf, ".")
        // Source type from kernel
        let src_ty = kernel.dst_types[src0 as usize]
        out.buf = ptx_push_str(out.buf, ptx_type_suffix(src_ty))
        out.buf = ptx_push_str(out.buf, " ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", ")
        out.buf = ptx_push_str(out.buf, src_name)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    // ── Arithmetic: Add, Sub, Mul, Div ──────────────────────────
    if opcode == GpuOpcode::GpuAdd {
        let alloc_result = ptx_alloc_for_type(out.regs, dst_type)
        out.regs = alloc_result.0
        let reg = alloc_result.1
        out.values = ptx_value_map_insert(out.values, op_idx, reg, dst_type)
        let lhs = ptx_value_map_get_name(out.values, src0)
        let rhs = ptx_value_map_get_name(out.values, src1)
        if ptx_is_float(dst_type) {
            out.buf = ptx_push_str(out.buf, "    add.")
        } else {
            out.buf = ptx_push_str(out.buf, "    add.")
        }
        out.buf = ptx_push_str(out.buf, ptx_type_suffix(dst_type))
        out.buf = ptx_push_str(out.buf, " ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", ")
        out.buf = ptx_push_str(out.buf, lhs)
        out.buf = ptx_push_str(out.buf, ", ")
        out.buf = ptx_push_str(out.buf, rhs)
        out.buf = ptx_push_str(out.buf, ";\n")
        return out
    }

    if opcode == GpuOpcode::GpuSub {
