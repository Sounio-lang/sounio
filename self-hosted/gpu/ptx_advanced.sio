fn ptx_emit_bar_sync_id(buf: PtxBuf, bar_id: i64, thread_count: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    bar.sync ")
    out = ptx_push_str(out, i64_to_string(bar_id))
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, i64_to_string(thread_count))
    out = ptx_push_str(out, ";\n")
    out
}

