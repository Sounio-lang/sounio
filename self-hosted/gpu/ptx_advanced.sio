fn ptx_adv_emit_abs(buf: PtxBuf, dst: string, src: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    abs.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
