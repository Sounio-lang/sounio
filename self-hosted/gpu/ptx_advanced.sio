// ── Shift Operations ────────────────────────────────────────────────

fn ptx_emit_shl(buf: PtxBuf, dst: string, src: string, amount: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    shl.b")
    out = ptx_push_str(out, ptx_bit_width(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, amount)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_shr(buf: PtxBuf, dst: string, src: string, amount: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    if ptx_is_signed(ty) {
        out = ptx_push_str(out, "    shr.")
        out = ptx_push_str(out, ptx_type_suffix(ty))
    } else {
        out = ptx_push_str(out, "    shr.b")
        out = ptx_push_str(out, ptx_bit_width(ty))
    }
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, amount)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Register Move ───────────────────────────────────────────────────

fn ptx_emit_mov(buf: PtxBuf, dst: string, src: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    mov.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

// Move immediate value into register
fn ptx_emit_mov_imm(buf: PtxBuf, dst: string, imm_val: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    mov.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, imm_val)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Negate ──────────────────────────────────────────────────────────

fn ptx_emit_neg(buf: PtxBuf, dst: string, src: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
