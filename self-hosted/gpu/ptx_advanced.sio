    out = ptx_push_str(out, "    // ")
    out = ptx_push_str(out, text)
    out = ptx_push_str(out, "\n")
    out
}

// ── Smoke Tests ─────────────────────────────────────────────────────
//
// These tests exercise the new Phase 4B opcode emission functions.
// Each test builds a PtxBuf, emits one or more instructions, and
// checks that the output contains expected PTX text fragments.

fn ptx_adv_test_01_sqrt_f32() -> bool with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_adv_emit_sqrt(b, "%f1", "%f0", GpuType::GpuF32)
    ptx_buf_contains(b, "sqrt.approx.f32 %f1, %f0;")
}

fn ptx_adv_test_02_sqrt_f64() -> bool with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_adv_emit_sqrt(b, "%fd1", "%fd0", GpuType::GpuF64)
    ptx_buf_contains(b, "sqrt.rn.f64 %fd1, %fd0;")
}

fn ptx_adv_test_03_rcp_f32() -> bool with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_adv_emit_rcp(b, "%f1", "%f0", GpuType::GpuF32)
