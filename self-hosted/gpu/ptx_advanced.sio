}

fn ptx_adv_emit_cos(buf: PtxBuf, dst: string, src: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    if ty == GpuType::GpuF64 {
        out = ptx_push_str(out, "    cos.approx.f64 ")
