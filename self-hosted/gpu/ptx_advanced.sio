fn ptx_emit_ld_param(buf: PtxBuf, dst: string, param_idx: i64, ty: GpuType) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "    ld.param.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [param_")
    out = ptx_push_str(out, i64_to_string(param_idx))
    out = ptx_push_str(out, "];\n")
    out
}

