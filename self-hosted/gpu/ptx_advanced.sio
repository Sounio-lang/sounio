}

fn ptx_emit_fma(buf: PtxBuf, dst: string, a: string, b: string, c: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    fma.rn.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, a)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, b)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, c)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_ld_global(buf: PtxBuf, dst: string, addr: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    ld.global.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, addr)
    out = ptx_push_str(out, "];\n")
    out
}

