}

// ── Additional Atomic Operations ────────────────────────────────────

// Atomic compare-and-swap: atomically replaces [addr] with new_val if [addr] == expected
fn ptx_emit_atom_cas(buf: PtxBuf, dst: string, addr: string, expected: string, new_val: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    atom.global.cas.b")
    out = ptx_push_str(out, ptx_bit_width(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, addr)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, expected)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, new_val)
    out = ptx_push_str(out, ";\n")
    out
}

// Atomic exchange: atomically replaces [addr] with val, returns old value
fn ptx_emit_atom_exch(buf: PtxBuf, dst: string, addr: string, val: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    atom.global.exch.b")
    out = ptx_push_str(out, ptx_bit_width(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, addr)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, val)
    out = ptx_push_str(out, ";\n")
    out
}

// Atomic min (signed integer)
fn ptx_emit_atom_min(buf: PtxBuf, dst: string, addr: string, val: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    atom.global.min.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [")
    out = ptx_push_str(out, addr)
    out = ptx_push_str(out, "], ")
    out = ptx_push_str(out, val)
    out = ptx_push_str(out, ";\n")
    out
}

// Atomic max (signed integer)
fn ptx_emit_atom_max(buf: PtxBuf, dst: string, addr: string, val: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    atom.global.max.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", [")
