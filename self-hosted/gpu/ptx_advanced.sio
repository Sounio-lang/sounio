// self-hosted::gpu::ptx_advanced — Full PTX code generator with register allocation
//
// Builds on ptx.sio (PtxBuf) to provide:
//   1. Register allocation (PtxRegCounters) with typed register pools
//   2. Value→register mapping (PtxValueMap)
//   3. Full opcode dispatch from GpuKernelIr → PTX text
//   4. Architecture feature detection (sm_50 through sm_120)
//   5. PTX version selection per compute capability
//   6. Kernel metadata emission (.maxntid, shared memory)
//
// Architecture: GpuKernelIr → ptx_codegen_kernel() → PtxBuf (text)

// ── Register Allocation ─────────────────────────────────────────────

struct PtxRegCounters {
    pred: i64,   // predicate register count
    r16: i64,    // 16-bit register count
    r32: i64,    // 32-bit register count
    r64: i64,    // 64-bit register count
    f32_cnt: i64, // 32-bit float register count
    f64_cnt: i64, // 64-bit float register count
}

fn ptx_reg_counters_new() -> PtxRegCounters {
    PtxRegCounters {
        pred: 0, r16: 0, r32: 0, r64: 0,
        f32_cnt: 0, f64_cnt: 0,
    }
}

// Allocate a register and return its name as a string
fn ptx_alloc_pred(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.pred
    var out = rc
    out.pred = idx + 1
    (out, "p" ++ i64_to_string(idx))
}

fn ptx_alloc_r16(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.r16
    var out = rc
    out.r16 = idx + 1
    (out, "r16_" ++ i64_to_string(idx))
}

fn ptx_alloc_r32(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.r32
    var out = rc
    out.r32 = idx + 1
    (out, "r32_" ++ i64_to_string(idx))
}

fn ptx_alloc_r64(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.r64
    var out = rc
    out.r64 = idx + 1
    (out, "r64_" ++ i64_to_string(idx))
}

fn ptx_alloc_f32(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.f32_cnt
    var out = rc
    out.f32_cnt = idx + 1
    (out, "f32_" ++ i64_to_string(idx))
}

fn ptx_alloc_f64(rc: PtxRegCounters) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    let idx = rc.f64_cnt
    var out = rc
    out.f64_cnt = idx + 1
    (out, "f64_" ++ i64_to_string(idx))
}

// Allocate register for a given GpuType
fn ptx_alloc_for_type(rc: PtxRegCounters, ty: GpuType) -> (PtxRegCounters, string) with Mut, Panic, Div, Alloc {
    if ty == GpuType::GpuF32 {
        return ptx_alloc_f32(rc)
    }
    if ty == GpuType::GpuF64 {
        return ptx_alloc_f64(rc)
    }
    if ty == GpuType::GpuU64 || ty == GpuType::GpuI64 || ty == GpuType::GpuPtr {
        return ptx_alloc_r64(rc)
    }
    if ty == GpuType::GpuU32 || ty == GpuType::GpuI32 {
        return ptx_alloc_r32(rc)
    }
    // Default: 32-bit
    ptx_alloc_r32(rc)
}

// ── Value → Register Map ────────────────────────────────────────────

struct PtxValueMap {
    op_ids: [i64; 4096],       // GpuOp index → unique id
    reg_names: [i64; 4096],    // index → offset into name_buf
    reg_lens: [i64; 4096],     // index → length in name_buf
    types: [i64; 4096],        // index → GpuType as i64
    count: i64,
    name_buf: [i8; 32768],     // flat name storage
    name_buf_len: i64,
}

fn ptx_value_map_new() -> PtxValueMap {
    PtxValueMap {
        op_ids: [0; 4096],
        reg_names: [0; 4096],
        reg_lens: [0; 4096],
        types: [0; 4096],
        count: 0,
        name_buf: [0; 32768],
        name_buf_len: 0,
    }
}

fn ptx_value_map_insert(vm: PtxValueMap, op_idx: i64, name: string, ty: GpuType) -> PtxValueMap with Mut, Panic, Div {
    var out = vm
    let c = out.count
    if c >= 4096 { return out }

    out.op_ids[c as usize] = op_idx

    // Copy name into flat buffer
    let name_start = out.name_buf_len
    let nlen = str_len(name)
    var i: i64 = 0
    while i < nlen {
        if out.name_buf_len < 32768 {
            out.name_buf[out.name_buf_len as usize] = str_char_at(name, i) as i8
            out.name_buf_len = out.name_buf_len + 1
        }
        i = i + 1
    }
    out.reg_names[c as usize] = name_start
    out.reg_lens[c as usize] = nlen

    // Store type as integer for comparison
    var ty_val: i64 = 0
    if ty == GpuType::GpuU32 { ty_val = 1 }
    if ty == GpuType::GpuU64 { ty_val = 2 }
    if ty == GpuType::GpuF32 { ty_val = 3 }
    if ty == GpuType::GpuF64 { ty_val = 4 }
    if ty == GpuType::GpuI32 { ty_val = 5 }
    if ty == GpuType::GpuI64 { ty_val = 6 }
    if ty == GpuType::GpuPtr { ty_val = 7 }
    out.types[c as usize] = ty_val

    out.count = c + 1
    out
}

fn ptx_value_map_get_name(vm: PtxValueMap, op_idx: i64) -> string with Mut, Panic, Div, Alloc {
    var i: i64 = 0
    while i < vm.count {
        if vm.op_ids[i as usize] == op_idx {
            let start = vm.reg_names[i as usize]
            let len = vm.reg_lens[i as usize]
            var end = start + len
            if end > vm.name_buf_len { end = vm.name_buf_len }
            if start < 0 || end <= start { return "UNKNOWN" }
            let prefix = str_from_bytes(vm.name_buf, end)
            return str_slice(prefix, start, end)
        }
        i = i + 1
    }
    // Not found — return placeholder
    "UNKNOWN"
}

// Retrieve stored type for a value (returns 0=unknown if not found)
// Type codes: 1=U32, 2=U64, 3=F32, 4=F64, 5=I32, 6=I64, 7=Ptr
fn ptx_value_map_get_type(vm: PtxValueMap, op_idx: i64) -> i64 {
    var i: i64 = 0
    while i < vm.count {
        if vm.op_ids[i as usize] == op_idx {
            return vm.types[i as usize]
        }
        i = i + 1
    }
    // Not found — default to 0 (unknown)
    0
}

// Result type for ptx_coerce_to_f32: carries state + coerced register name
struct PtxCoerceResult {
    buf: PtxBuf,
    regs: PtxRegCounters,
    name: string,
}

// If src operand is not f32, emit cvt.rn.f32.{src_type} tmp, src and return tmp.
// If already f32 (ty_code==3), return src unchanged.
fn ptx_coerce_to_f32(
    buf: PtxBuf,
    regs: PtxRegCounters,
    src_name: string,
    src_ty_code: i64
) -> PtxCoerceResult with Mut, Panic, Div, Alloc {
    if src_ty_code == 3 {
        // Already f32 — no conversion needed
        return PtxCoerceResult { buf: buf, regs: regs, name: src_name }
    }
    // Allocate a temporary f32 register
    let alloc_result = ptx_alloc_f32(regs)
    let new_regs = alloc_result.0
    let tmp = alloc_result.1
    var new_buf = buf
    new_buf = ptx_push_str(new_buf, "    cvt.rn.f32.")
    if src_ty_code == 2 || src_ty_code == 7 {
        new_buf = ptx_push_str(new_buf, "u64")
    } else if src_ty_code == 6 {
        new_buf = ptx_push_str(new_buf, "s64")
    } else if src_ty_code == 1 {
        new_buf = ptx_push_str(new_buf, "u32")
    } else if src_ty_code == 5 {
        new_buf = ptx_push_str(new_buf, "s32")
    } else {
        new_buf = ptx_push_str(new_buf, "u64")  // safe default
    }
    new_buf = ptx_push_str(new_buf, " ")
    new_buf = ptx_push_str(new_buf, tmp)
    new_buf = ptx_push_str(new_buf, ", ")
    new_buf = ptx_push_str(new_buf, src_name)
    new_buf = ptx_push_str(new_buf, ";\n")
    PtxCoerceResult { buf: new_buf, regs: new_regs, name: tmp }
}

// ── Architecture Capabilities ───────────────────────────────────────

struct PtxArch {
    sm_major: i64,
    sm_minor: i64,
}

fn ptx_arch_new(major: i64, minor: i64) -> PtxArch {
    PtxArch { sm_major: major, sm_minor: minor }
}

fn ptx_sm_version(arch: PtxArch) -> i64 {
    arch.sm_major * 10 + arch.sm_minor
}

fn ptx_recommended_version_major(arch: PtxArch) -> i64 {
    let sm = ptx_sm_version(arch)
    if sm <= 69 { return 6 }
    if sm >= 70 && sm <= 74 { return 6 }
    if sm == 75 { return 6 }
    if sm >= 80 && sm <= 86 { return 7 }
    if sm == 87 { return 7 }
    if sm == 89 { return 8 }
    if sm == 90 { return 8 }
    if sm == 100 { return 8 }
    if sm == 120 { return 8 }
    8
}

fn ptx_recommended_version_minor(arch: PtxArch) -> i64 {
    let sm = ptx_sm_version(arch)
    if sm <= 69 { return 0 }
    if sm >= 70 && sm <= 74 { return 3 }
    if sm == 75 { return 4 }
    if sm >= 80 && sm <= 86 { return 1 }
    if sm == 87 { return 4 }
    if sm == 89 { return 1 }
    if sm == 90 { return 3 }
    if sm == 100 { return 5 }
    if sm == 120 { return 6 }
    5
}

fn ptx_supports_bf16_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 80 }
fn ptx_supports_fp8_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 89 }
fn ptx_supports_tma_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_cp_async_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 80 }
fn ptx_supports_redux_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 80 }
fn ptx_supports_match_arch(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 70 }
fn ptx_supports_clusters(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_wgmma(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 90 }
fn ptx_supports_fp4(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }
fn ptx_supports_tensor_gen5(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }
fn ptx_supports_nvlink5(arch: PtxArch) -> bool { ptx_sm_version(arch) >= 100 }

// Compatibility helpers (major/minor form) used by offload scaffolds.
fn ptx_sm_version_string(major: i64, minor: i64) -> string with Mut, Panic, Div, Alloc {
    "sm_" ++ i64_to_string(major) ++ i64_to_string(minor)
}

fn ptx_version_for_sm(major: i64, minor: i64) -> (i64, i64) {
    let arch = ptx_arch_new(major, minor)
    (ptx_recommended_version_major(arch), ptx_recommended_version_minor(arch))
}

fn ptx_supports_bf16(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 80
}

fn ptx_supports_fp8(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 89
}

fn ptx_supports_tma(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 90
}

fn ptx_supports_cp_async(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 80
}

fn ptx_supports_redux(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 80
}

fn ptx_supports_match(major: i64, minor: i64) -> bool {
    ptx_sm_version(ptx_arch_new(major, minor)) >= 70
}

// ── PTX Type Strings ────────────────────────────────────────────────

fn ptx_type_suffix(ty: GpuType) -> string {
    if ty == GpuType::GpuF32 { return "f32" }
    if ty == GpuType::GpuF64 { return "f64" }
    if ty == GpuType::GpuI32 { return "s32" }
    if ty == GpuType::GpuI64 { return "s64" }
    if ty == GpuType::GpuU32 { return "u32" }
    if ty == GpuType::GpuU64 { return "u64" }
    if ty == GpuType::GpuPtr { return "u64" }
    "b32"
}

fn ptx_type_decl(ty: GpuType) -> string {
    if ty == GpuType::GpuF32 { return ".f32" }
    if ty == GpuType::GpuF64 { return ".f64" }
    if ty == GpuType::GpuI32 { return ".b32" }
    if ty == GpuType::GpuI64 { return ".b64" }
    if ty == GpuType::GpuU32 { return ".b32" }
    if ty == GpuType::GpuU64 { return ".b64" }
    if ty == GpuType::GpuPtr { return ".b64" }
    ".b32"
}

fn ptx_is_float(ty: GpuType) -> bool {
    ty == GpuType::GpuF32 || ty == GpuType::GpuF64
}

fn ptx_is_signed(ty: GpuType) -> bool {
    ty == GpuType::GpuI32 || ty == GpuType::GpuI64
}

fn ptx_is_64bit(ty: GpuType) -> bool {
    ty == GpuType::GpuU64 || ty == GpuType::GpuI64 || ty == GpuType::GpuF64 || ty == GpuType::GpuPtr
}

fn ptx_bit_width(ty: GpuType) -> string {
    if ptx_is_64bit(ty) { return "64" }
    "32"
}

// ── Offload-spec compatibility helpers ─────────────────────────────
// These entrypoints match scaffold naming from ptx_regalloc_expansion.md
// and forward to the same PTX text conventions used in this module.

fn ptx_alloc_b32(rc: PtxRegCounters) -> (PtxRegCounters, i64) {
    let idx = rc.r32
    var out = rc
    out.r32 = idx + 1
    (out, idx)
}

fn ptx_alloc_b64(rc: PtxRegCounters) -> (PtxRegCounters, i64) {
    let idx = rc.r64
    var out = rc
    out.r64 = idx + 1
    (out, idx)
}

fn ptx_emit_reg_name(buf: PtxBuf, prefix: i64, index: i64) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = ptx_push_str(out, "%")
    if prefix == 0 {
        out = ptx_push_str(out, "p")
    } else if prefix == 1 {
        out = ptx_push_str(out, "r")
    } else if prefix == 2 {
        out = ptx_push_str(out, "rd")
    } else if prefix == 3 {
        out = ptx_push_str(out, "f")
    } else {
        out = ptx_push_str(out, "fd")
    }
    out = ptx_push_str(out, i64_to_string(index))
    out
}

fn ptx_emit_typed_reg_decls(buf: PtxBuf, rc: PtxRegCounters) -> PtxBuf with Mut, Panic, Div, Alloc {
    var out = buf
    if rc.pred > 0 {
        out = ptx_push_str(out, "    .reg .pred %p<")
        out = ptx_push_str(out, i64_to_string(rc.pred))
        out = ptx_push_str(out, ">;\n")
    }
    if rc.r16 > 0 {
        out = ptx_push_str(out, "    .reg .b16 %h<")
        out = ptx_push_str(out, i64_to_string(rc.r16))
        out = ptx_push_str(out, ">;\n")
    }
    if rc.r32 > 0 {
        out = ptx_push_str(out, "    .reg .b32 %r<")
        out = ptx_push_str(out, i64_to_string(rc.r32))
        out = ptx_push_str(out, ">;\n")
    }
    if rc.r64 > 0 {
        out = ptx_push_str(out, "    .reg .b64 %rd<")
        out = ptx_push_str(out, i64_to_string(rc.r64))
        out = ptx_push_str(out, ">;\n")
    }
    if rc.f32_cnt > 0 {
        out = ptx_push_str(out, "    .reg .f32 %f<")
        out = ptx_push_str(out, i64_to_string(rc.f32_cnt))
        out = ptx_push_str(out, ">;\n")
    }
    if rc.f64_cnt > 0 {
        out = ptx_push_str(out, "    .reg .f64 %fd<")
        out = ptx_push_str(out, i64_to_string(rc.f64_cnt))
        out = ptx_push_str(out, ">;\n")
    }
    out
}

fn ptx_emit_add(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    add.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_sub(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    sub.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_mul(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    if ptx_is_float(ty) {
        out = ptx_push_str(out, "    mul.")
        out = ptx_push_str(out, ptx_type_suffix(ty))
    } else {
        out = ptx_push_str(out, "    mul.lo.")
        out = ptx_push_str(out, ptx_type_suffix(ty))
    }
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_div(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    div.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_rem(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    rem.")
    out = ptx_push_str(out, ptx_type_suffix(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
