// ── Conversion with Explicit Type Suffixes ──────────────────────────

fn ptx_adv_emit_cvt(buf: PtxBuf, dst: string, src: string, dst_ty_suffix: string, src_ty_suffix: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    cvt.rn.")
    out = ptx_push_str(out, dst_ty_suffix)
    out = ptx_push_str(out, ".")
    out = ptx_push_str(out, src_ty_suffix)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

// Truncation conversion (cvt.rzi for float-to-int)
fn ptx_adv_emit_cvt_rzi(buf: PtxBuf, dst: string, src: string, dst_ty_suffix: string, src_ty_suffix: string) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    cvt.rzi.")
    out = ptx_push_str(out, dst_ty_suffix)
    out = ptx_push_str(out, ".")
    out = ptx_push_str(out, src_ty_suffix)
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, src)
    out = ptx_push_str(out, ";\n")
    out
}

// ── Bitwise Logic Operations ────────────────────────────────────────

fn ptx_emit_and(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
    out = ptx_push_str(out, "    and.b")
    out = ptx_push_str(out, ptx_bit_width(ty))
    out = ptx_push_str(out, " ")
    out = ptx_push_str(out, dst)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, lhs)
    out = ptx_push_str(out, ", ")
    out = ptx_push_str(out, rhs)
    out = ptx_push_str(out, ";\n")
    out
}

fn ptx_emit_or(buf: PtxBuf, dst: string, lhs: string, rhs: string, ty: GpuType) -> PtxBuf with Mut, Panic, Div {
    var out = buf
