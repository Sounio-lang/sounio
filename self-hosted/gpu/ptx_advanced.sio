        out.buf = ptx_push_str(out.buf, "    cos.approx.")
        out.buf = ptx_push_str(out.buf, ptx_type_suffix(dst_type))
        out.buf = ptx_push_str(out.buf, " ")
        out.buf = ptx_push_str(out.buf, reg)
        out.buf = ptx_push_str(out.buf, ", ")
        out.buf = ptx_push_str(out.buf, src)
