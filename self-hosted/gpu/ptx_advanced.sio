    b = ptx_emit_redux_min(b, "%r1", "%r0")
    b = ptx_emit_redux_max(b, "%r3", "%r2")
    ptx_buf_contains(b, "redux.sync.min.s32 %r1, %r0, 0xffffffff;") &&
    ptx_buf_contains(b, "redux.sync.max.s32 %r3, %r2, 0xffffffff;")
}

fn ptx_adv_test_47_cp_async_size_normalization() -> bool with Mut, Panic, Div, Alloc {
    var b = ptx_buf_new()
    b = ptx_emit_cp_async(b, "%rd0", "%rd1", 12)
    ptx_buf_contains(b, "cp.async.ca.shared.global [%rd0], [%rd1], 16;") &&
    !ptx_buf_contains(b, ", 12;")
}

fn ptx_adv_test_48_arch_capability_gates() -> bool {
    let sm75 = ptx_arch_new(7, 5)
    let sm89 = ptx_arch_new(8, 9)
    let sm90 = ptx_arch_new(9, 0)
    !ptx_supports_cp_async_arch(sm75) &&
    !ptx_supports_redux_arch(sm75) &&
    ptx_supports_match_arch(sm75) &&
    ptx_supports_cp_async_arch(sm89) &&
    ptx_supports_redux_arch(sm89) &&
    ptx_supports_fp8_arch(sm89) &&
    !ptx_supports_tma_arch(sm89) &&
    ptx_supports_tma_arch(sm90)
}

fn ptx_adv_test_49_cp_async_arch_fallback() -> bool with Mut, Panic, Div, Alloc {
    var fallback = ptx_buf_new()
    fallback = ptx_emit_cp_async_arch(fallback, ptx_arch_new(7, 5), "%rd0", "%rd1", 16)
    var enabled = ptx_buf_new()
    enabled = ptx_emit_cp_async_arch(enabled, ptx_arch_new(8, 9), "%rd0", "%rd1", 16)
    ptx_buf_contains(fallback, "cp.async unavailable for sm_75") &&
    ptx_buf_contains(enabled, "cp.async.ca.shared.global [%rd0], [%rd1], 16;")
}

fn ptx_adv_test_50_major_minor_capability_helpers() -> bool {
    !ptx_supports_cp_async(7, 5) &&
    ptx_supports_cp_async(8, 9) &&
    !ptx_supports_redux(7, 5) &&
    ptx_supports_redux(8, 0) &&
    !ptx_supports_match(6, 1) &&
    ptx_supports_match(7, 0)
}

// ── Self-check: run all Phase 4B tests ──────────────────────────────

fn ptx_advanced_self_check() -> bool with Mut, Panic, Div, Alloc {
    let t01 = ptx_adv_test_01_sqrt_f32()
    let t02 = ptx_adv_test_02_sqrt_f64()
    let t03 = ptx_adv_test_03_rcp_f32()
    let t04 = ptx_adv_test_04_rcp_f64()
    let t05 = ptx_adv_test_05_cvt_string_suffixes()
    let t06 = ptx_adv_test_06_cvt_rzi()
    let t07 = ptx_adv_test_07_and_b32()
    let t08 = ptx_adv_test_08_or_b64()
    let t09 = ptx_adv_test_09_xor_b32()
    let t10 = ptx_adv_test_10_not_b32()
    let t11 = ptx_adv_test_11_shl_b32()
    let t12 = ptx_adv_test_12_shr_signed()
    let t13 = ptx_adv_test_13_shr_unsigned()
    let t14 = ptx_adv_test_14_mov_f32()
    let t15 = ptx_adv_test_15_mov_imm()
    let t16 = ptx_adv_test_16_neg_f32()
    let t17 = ptx_adv_test_17_atom_cas()
    let t18 = ptx_adv_test_18_atom_exch()
    let t19 = ptx_adv_test_19_cp_async()
    let t20 = ptx_adv_test_20_cp_async_commit_wait()
    let t21 = ptx_adv_test_21_pred_add()
    let t22 = ptx_adv_test_22_bra_not_pred()
    let t23 = ptx_adv_test_23_mul_wide()

    let block1 = t01 && t02 && t03 && t04 && t05 && t06 && t07 && t08
    let block2 = t09 && t10 && t11 && t12 && t13 && t14 && t15 && t16
    let block3 = t17 && t18 && t19 && t20 && t21 && t22 && t23

    let t24 = ptx_adv_test_24_mad_float()
    let t25 = ptx_adv_test_25_mad_int()
    let t26 = ptx_adv_test_26_warp_reduce()
    let t27 = ptx_adv_test_27_membar()
    let t28 = ptx_adv_test_28_popc()
    let t29 = ptx_adv_test_29_brev()
    let t30 = ptx_adv_test_30_clz()
    let t31 = ptx_adv_test_31_pred_logic()
    let t32 = ptx_adv_test_32_redux_add()
    let t33 = ptx_adv_test_33_atom_shared_add()
    let t34 = ptx_adv_test_34_bar_sync_id()
    let t35 = ptx_adv_test_35_comment()
    let t36 = ptx_adv_test_36_sin_f32()
    let t37 = ptx_adv_test_37_cos_f64()
    let t38 = ptx_adv_test_38_exp2_f32()
    let t39 = ptx_adv_test_39_lg2_f64()
    let t40 = ptx_adv_test_40_abs_f64()
    let t41 = ptx_adv_test_41_rsqrt_f64()
    let t42 = ptx_adv_test_42_match_any()
    let t43 = ptx_adv_test_43_tex_1d()
    let t44 = ptx_adv_test_44_atom_min_max()
    let t45 = ptx_adv_test_45_mov_pred()
    let t46 = ptx_adv_test_46_redux_min_max()
    let t47 = ptx_adv_test_47_cp_async_size_normalization()
    let t48 = ptx_adv_test_48_arch_capability_gates()
    let t49 = ptx_adv_test_49_cp_async_arch_fallback()
    let t50 = ptx_adv_test_50_major_minor_capability_helpers()

    let block4 = t24 && t25 && t26 && t27 && t28 && t29 && t30 && t31
    let block5 = t32 && t33 && t34 && t35 && t36 && t37 && t38 && t39
    let block6 = t40 && t41 && t42 && t43 && t44 && t45 && t46
    let block7 = t47 && t48 && t49 && t50

    block1 && block2 && block3 && block4 && block5 && block6 && block7
}

fn gpu_ptx_advanced_main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let ok = ptx_advanced_self_check()
    if ok {
        print("PASS ptx_advanced_self_check (50 tests)\n")
        return 0 as i32
    } else {
        print("FAIL ptx_advanced_self_check\n")
        return 1 as i32
    }
}
