    ptx_buf_contains(b, "tex.1d.v4.f32.f32 {%f0}, [tex_ref, {%f1}];")
}

fn ptx_adv_test_44_atom_min_max() -> bool with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_emit_atom_min(b, "%r2", "%rd0", "%r0", GpuType::GpuI32)
    b = ptx_emit_atom_max(b, "%r3", "%rd1", "%r1", GpuType::GpuI32)
    ptx_buf_contains(b, "atom.global.min.s32 %r2, [%rd0], %r0;") &&
    ptx_buf_contains(b, "atom.global.max.s32 %r3, [%rd1], %r1;")
}

