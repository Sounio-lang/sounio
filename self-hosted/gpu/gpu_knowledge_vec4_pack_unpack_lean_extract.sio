// Minimal Sounio PTX emitter for the GPU Knowledge Vec4 pack/unpack contract.
//
// This is a lean extract/reference witness, not the canonical GpuKernelIr
// backend path. It avoids the current large-aggregate runtime blocker in the
// GpuKernelIr harness while still producing PTX from Sounio code for ptxas.

use ptx::*

fn emit_vec4_pack_unpack_ptx() -> PtxBuf with Mut, Panic, Div {
    var b = ptx_buf_new()
    b = ptx_push_str(b, ".version 7.0\n")
    b = ptx_push_str(b, ".target sm_70\n")
    b = ptx_push_str(b, ".address_size 64\n\n")
    b = ptx_push_str(b, "// SOUNIO_BACKEND_LEAN_EXTRACT_CONTRACT kernel=gpu_vec4_pack_unpack lane_offsets=0,32,64,96 lane_type=f64\n")
    b = ptx_push_str(b, ".visible .entry gpu_vec4_pack_unpack(\n")
    b = ptx_push_str(b, "    .param .u64 in_ptr,\n")
    b = ptx_push_str(b, "    .param .u64 out_ptr\n")
    b = ptx_push_str(b, ")\n")
    b = ptx_push_str(b, "{\n")
    b = ptx_push_str(b, "    .reg .b64 %rd<9>;\n")
    b = ptx_push_str(b, "    .reg .f64 %fd<5>;\n\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd1, [in_ptr];\n")
    b = ptx_push_str(b, "    ld.param.u64 %rd2, [out_ptr];\n")
    b = ptx_push_str(b, "    ld.global.f64 %fd1, [%rd1];\n")
    b = ptx_push_str(b, "    add.u64 %rd3, %rd1, 32;\n")
    b = ptx_push_str(b, "    ld.global.f64 %fd2, [%rd3];\n")
    b = ptx_push_str(b, "    add.u64 %rd4, %rd1, 64;\n")
    b = ptx_push_str(b, "    ld.global.f64 %fd3, [%rd4];\n")
    b = ptx_push_str(b, "    add.u64 %rd5, %rd1, 96;\n")
    b = ptx_push_str(b, "    ld.global.f64 %fd4, [%rd5];\n")
    b = ptx_push_str(b, "    st.global.f64 [%rd2], %fd1;\n")
    b = ptx_push_str(b, "    add.u64 %rd6, %rd2, 32;\n")
    b = ptx_push_str(b, "    st.global.f64 [%rd6], %fd2;\n")
    b = ptx_push_str(b, "    add.u64 %rd7, %rd2, 64;\n")
    b = ptx_push_str(b, "    st.global.f64 [%rd7], %fd3;\n")
    b = ptx_push_str(b, "    add.u64 %rd8, %rd2, 96;\n")
    b = ptx_push_str(b, "    st.global.f64 [%rd8], %fd4;\n")
    b = ptx_push_str(b, "    ret;\n")
    b = ptx_push_str(b, "}\n")
    b
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let b = emit_vec4_pack_unpack_ptx()
    ptx_buf_print(b)
    0
}
