    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, "];\n")
    out
}

fn ossm_emit_soa_store_f64(s: OssmPtxState, src_reg: i64, ptr_array_reg: i64, component: i64, tid_offset_reg: i64, scratch0: i64, scratch1: i64) -> OssmPtxState with Mut, Panic, Div {
    var out = s
    let byte_offset = component * 8
    out = ossm_push_str(out, "    // SoA store component ")
    out = ossm_push_str(out, i64_to_string(component))
    out = ossm_push_str(out, "\n")
    out = ossm_push_str(out, "    mov.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, i64_to_string(byte_offset))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    add.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(ptr_array_reg))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    ld.global.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", [")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, "];\n")
    out = ossm_push_str(out, "    add.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(tid_offset_reg))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    st.global.f64 [")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, "], ")
    out = ossm_push_str(out, ossm_reg_f64(src_reg))
    out = ossm_push_str(out, ";\n")
    out
}

fn ossm_emit_soa_store_f32(s: OssmPtxState, src_reg: i64, ptr_array_reg: i64, component: i64, tid_offset_reg: i64, scratch0: i64, scratch1: i64) -> OssmPtxState with Mut, Panic, Div {
    var out = s
