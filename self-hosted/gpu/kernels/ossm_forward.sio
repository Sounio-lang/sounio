// self-hosted::gpu::kernels::ossm_forward — O-SSM fused forward kernel
//
// Emits PTX for a single-dispatch O-SSM forward pass:
//   h_t = sigmoid(A * h_{t-1} + B * x_t)
//   y_t = Re(C * h_t)
//
// where * denotes octonion multiply via Fano plane (64 FMAs per mul).
//
// SoA memory layout for coalesced GPU access:
//   Each component stored contiguously: h_re[N], h_e1[N], ..., h_e7[N]
//   Thread tid processes element at index tid.
//
// Precision: dual f32/f64 paths via ossm_emit_forward_f32 / ossm_emit_forward_f64.
// Epistemic: ossm_emit_forward_eps_f32 / ossm_emit_forward_eps_f64 add shadow propagation.
//
// Total per-element compute: ~192 FMAs (2 oct muls + sigmoid + scaling)
// Register budget: ~48 f32 or ~48 f64 per thread (well within 255 limit)

// ============================================================================
// Core state (reuses HypercomplexPtxState from hypercomplex.sio)
// ============================================================================

struct OssmPtxState {
    buf: [i8; 131072],
    buf_len: i64,
    reg_counter: i64,
    pred_counter: i64,
}

fn ossm_new() -> OssmPtxState {
    OssmPtxState {
        buf: [0; 131072],
        buf_len: 0,
        reg_counter: 0,
        pred_counter: 0,
    }
}

fn ossm_append_byte(s: OssmPtxState, b: i8) -> OssmPtxState {
    var out = s
    if out.buf_len < 131072 {
        out.buf[out.buf_len as usize] = b
        out.buf_len = out.buf_len + 1
    }
    out
}

fn ossm_push_str(s: OssmPtxState, text: string) -> OssmPtxState with Mut, Panic, Div {
    var out = s
    let n = str_len(text)
    var i: i64 = 0
    while i < n {
        if out.buf_len < 131072 {
            out.buf[out.buf_len as usize] = str_char_at(text, i) as i8
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

fn ossm_alloc_reg(s: OssmPtxState) -> (OssmPtxState, i64) {
    var out = s
    let idx = out.reg_counter
    out.reg_counter = idx + 1
    (out, idx)
}

fn ossm_alloc_pred(s: OssmPtxState) -> (OssmPtxState, i64) {
    var out = s
    let idx = out.pred_counter
    out.pred_counter = idx + 1
    (out, idx)
}

// ============================================================================
// Register formatting helpers
// ============================================================================

fn ossm_reg_f32(reg: i64) -> string with Mut, Panic, Div { str_concat("%f", i64_to_string(reg)) }
fn ossm_reg_f64(reg: i64) -> string with Mut, Panic, Div { str_concat("%fd", i64_to_string(reg)) }
fn ossm_reg_u64(reg: i64) -> string with Mut, Panic, Div { str_concat("%rd", i64_to_string(reg)) }
fn ossm_pred(p: i64) -> string with Mut, Panic, Div { str_concat("%p", i64_to_string(p)) }

// ============================================================================
// SoA load/store helpers — two-level pointer indirection for coalesced access
// ============================================================================
//
// SoA layout: param points to array of 8 pointers, each pointing to
// a contiguous array of N elements for one octonion component.
// Load: pointers[component][tid]  via:
//   mov.u64 scratch0, component*8
//   add.u64 scratch0, ptr_array_reg, scratch0   // &pointers[component]
//   ld.global.u64 scratch1, [scratch0]           // pointers[component]
//   add.u64 scratch1, scratch1, tid_offset_reg   // + tid*sizeof
//   ld.global.f64 dst, [scratch1]

fn ossm_emit_soa_load_f64(s: OssmPtxState, dst_reg: i64, ptr_array_reg: i64, component: i64, tid_offset_reg: i64, scratch0: i64, scratch1: i64) -> OssmPtxState with Mut, Panic, Div {
    var out = s
    let byte_offset = component * 8
    out = ossm_push_str(out, "    // SoA load component ")
    out = ossm_push_str(out, i64_to_string(component))
    out = ossm_push_str(out, "\n")
    out = ossm_push_str(out, "    mov.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, i64_to_string(byte_offset))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    add.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(ptr_array_reg))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    ld.global.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", [")
    out = ossm_push_str(out, ossm_reg_u64(scratch0))
    out = ossm_push_str(out, "];\n")
    out = ossm_push_str(out, "    add.u64 ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, ", ")
    out = ossm_push_str(out, ossm_reg_u64(tid_offset_reg))
    out = ossm_push_str(out, ";\n")
    out = ossm_push_str(out, "    ld.global.f64 ")
    out = ossm_push_str(out, ossm_reg_f64(dst_reg))
    out = ossm_push_str(out, ", [")
    out = ossm_push_str(out, ossm_reg_u64(scratch1))
    out = ossm_push_str(out, "];\n")
    out
}

fn ossm_emit_soa_load_f32(s: OssmPtxState, dst_reg: i64, ptr_array_reg: i64, component: i64, tid_offset_reg: i64, scratch0: i64, scratch1: i64) -> OssmPtxState with Mut, Panic, Div {
    var out = s
