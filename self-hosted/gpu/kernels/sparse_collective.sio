// "    min.f32 %f<dst>, %f<a>, %f<b>;\n"
fn sps_emit_min_f32(s: SparsePtxState, dst: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    min.f32 %f")
