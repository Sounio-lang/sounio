// self-hosted::gpu::kernels::sparse_collective
//
// Sparse tensor operations and collective communication primitives for GPU.
// Emits PTX text into a byte buffer (SparsePtxState) — pure, no GPU execution.
//
// Kernels covered:
//   SpMV CSR  — Sparse Matrix-Vector Multiply, Compressed Sparse Row format
//   SpMV ELL  — Sparse Matrix-Vector Multiply, ELLPACK format
//   Warp reduce / prefix scan (add, max, min)
//   Block reduce / broadcast / exclusive scan (via shared memory)
//   allreduce kernel header (sum, max, min)
//   exclusive scan kernel header
//
// Register convention: %f<N> for f32, %r<N> for i32/i64/ptr, %p<N> for predicates.
// All helpers strictly precede callers — no forward references.

// ============================================================================
// Format and collective operation tag constants
// ============================================================================

let SPARSE_FMT_CSR: i64 = 0
let SPARSE_FMT_ELL: i64 = 1
let COLL_OP_SUM: i64 = 0
let COLL_OP_MAX: i64 = 1
let COLL_OP_MIN: i64 = 2

// ============================================================================
// Core state and descriptor types
// ============================================================================

struct SparsePtxState {
    buf: [i8; 65536],
    buf_len: i64,
    reg_counter: i64,
    pred_counter: i64,
}

struct CsrDescriptor {
    rows: i64,
    cols: i64,
    nnz: i64,
    row_ptr_reg: i64,
    col_idx_reg: i64,
    values_reg: i64,
}

struct EllDescriptor {
    rows: i64,
    cols: i64,
    max_nnz_per_row: i64,
    col_idx_reg: i64,
    values_reg: i64,
}

// ============================================================================
// Helper: write a decimal i64 into a fixed 32-byte buffer
// Returns number of bytes written.
// ============================================================================

fn sps_i64_to_buf(v: i64, buf: &![i8; 32]) -> i64 with Div {
    if v == 0 {
        buf[0] = 48  // '0'
        return 1
    }
    var digits: [i8; 20] = [0; 20]
    var n: i64 = 0
    var rem: i64 = v
    if rem < 0 { rem = 0 - rem }
    while rem > 0 {
        let d: i64 = rem - (rem / 10) * 10
        digits[n as usize] = (48 + d) as i8
        rem = rem / 10
        n = n + 1
    }
    var written: i64 = 0
    if v < 0 {
        buf[0] = 45  // '-'
        written = 1
    }
    var i: i64 = n - 1
    while i >= 0 {
        buf[written as usize] = digits[i as usize]
        written = written + 1
        i = i - 1
    }
    written
}

// ============================================================================
// Core PTX state helpers
// ============================================================================

fn sps_new() -> SparsePtxState {
    SparsePtxState {
        buf: [0; 65536],
        buf_len: 0,
        reg_counter: 0,
        pred_counter: 0,
    }
}

fn sps_append_byte(s: SparsePtxState, b: i8) -> SparsePtxState {
    var out = s
    if out.buf_len < 65536 {
        out.buf[out.buf_len as usize] = b
        out.buf_len = out.buf_len + 1
    }
    out
}

// Append up to len bytes from a fixed 64-byte literal buffer.
fn sps_push_str_lit(s: SparsePtxState, lit: [i8; 64], len: i64) -> SparsePtxState {
    var out = s
    var i: i64 = 0
    while i < len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = lit[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// Push an i64 as decimal ASCII into the state buffer.
fn sps_push_i64(s: SparsePtxState, v: i64) -> SparsePtxState with Div {
    var tmp: [i8; 32] = [0; 32]
    let len = sps_i64_to_buf(v, &!tmp)
    var out = s
    var i: i64 = 0
    while i < len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = tmp[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

fn sps_nl(s: SparsePtxState) -> SparsePtxState {
    sps_append_byte(s, 10)
}

fn sps_alloc_reg(s: SparsePtxState) -> (SparsePtxState, i64) {
    var out = s
    let idx = out.reg_counter
    out.reg_counter = idx + 1
    (out, idx)
}

fn sps_alloc_pred(s: SparsePtxState) -> (SparsePtxState, i64) {
    var out = s
    let idx = out.pred_counter
    out.pred_counter = idx + 1
    (out, idx)
}

// ============================================================================
// Internal string push — uses VM string type for convenience
// ============================================================================

fn sps_push_str(s: SparsePtxState, text: string) -> SparsePtxState with Div {
    var out = s
    let n = str_len(text)
    var i: i64 = 0
    while i < n {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = str_char_at(text, i) as i8
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// PTX opcode emitters
// All return updated SparsePtxState.
// Convention: %f<N> = f32 regs, %r<N> = integer/ptr regs, %p<N> = predicates.
// ============================================================================

// "    ld.global.f32 %f<dst>, [%r<ptr>+<off>];\n"
fn sps_emit_ld_global_f32(s: SparsePtxState, dst: i64, ptr: i64, off: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    ld.global.f32 %f")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", [%r")
    out = sps_push_i64(out, ptr)
    out = sps_push_str(out, "+")
    out = sps_push_i64(out, off)
    out = sps_push_str(out, "];\n")
    out
}

// "    ld.global.s32 %r<dst>, [%r<ptr>+<off>];\n"
fn sps_emit_ld_global_s32(s: SparsePtxState, dst: i64, ptr: i64, off: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    ld.global.s32 %r")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", [%r")
    out = sps_push_i64(out, ptr)
    out = sps_push_str(out, "+")
    out = sps_push_i64(out, off)
    out = sps_push_str(out, "];\n")
    out
}

// "    st.global.f32 [%r<ptr>+<off>], %f<val>;\n"
fn sps_emit_st_global_f32(s: SparsePtxState, ptr: i64, off: i64, val: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    st.global.f32 [%r")
    out = sps_push_i64(out, ptr)
    out = sps_push_str(out, "+")
    out = sps_push_i64(out, off)
    out = sps_push_str(out, "], %f")
    out = sps_push_i64(out, val)
    out = sps_push_str(out, ";\n")
    out
}

// "    fma.rn.f32 %f<dst>, %f<a>, %f<b>, %f<c>;\n"
fn sps_emit_fma_f32(s: SparsePtxState, dst: i64, a: i64, b: i64, c: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    fma.rn.f32 %f")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %f")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", %f")
    out = sps_push_i64(out, b)
    out = sps_push_str(out, ", %f")
    out = sps_push_i64(out, c)
    out = sps_push_str(out, ";\n")
    out
}

// "    mov.f32 %f<dst>, 0f00000000;\n"
fn sps_emit_mov_f32_zero(s: SparsePtxState, dst: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    mov.f32 %f")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", 0f00000000;\n")
    out
}

// "    add.s32 %r<dst>, %r<a>, %r<b>;\n"
fn sps_emit_add_s32(s: SparsePtxState, dst: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    add.s32 %r")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, b)
    out = sps_push_str(out, ";\n")
    out
}

// "    mul.lo.s32 %r<dst>, %r<a>, <imm>;\n"
fn sps_emit_mul_s32_imm(s: SparsePtxState, dst: i64, a: i64, imm: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    mul.lo.s32 %r")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", ")
    out = sps_push_i64(out, imm)
    out = sps_push_str(out, ";\n")
    out
}

// "    setp.lt.s32 %p<pred>, %r<a>, %r<b>;\n"
fn sps_emit_setp_lt_s32(s: SparsePtxState, pred: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    setp.lt.s32 %p")
    out = sps_push_i64(out, pred)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, b)
    out = sps_push_str(out, ";\n")
    out
}

// "    setp.ge.s32 %p<pred>, %r<a>, %r<b>;\n"
fn sps_emit_setp_ge_s32(s: SparsePtxState, pred: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    setp.ge.s32 %p")
    out = sps_push_i64(out, pred)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, b)
    out = sps_push_str(out, ";\n")
    out
}

// "    @%p<pred> bra label_<label_id>;\n"
fn sps_emit_cbr(s: SparsePtxState, pred: i64, label_id: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    @%p")
    out = sps_push_i64(out, pred)
    out = sps_push_str(out, " bra label_")
    out = sps_push_i64(out, label_id)
    out = sps_push_str(out, ";\n")
    out
}

// "    bra label_<label_id>;\n"
fn sps_emit_br(s: SparsePtxState, label_id: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    bra label_")
    out = sps_push_i64(out, label_id)
    out = sps_push_str(out, ";\n")
    out
}

// "label_<label_id>:\n"
fn sps_emit_label(s: SparsePtxState, label_id: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "label_")
    out = sps_push_i64(out, label_id)
    out = sps_push_str(out, ":\n")
    out
}

// "    cvt.u64.u32 %r<dst>, %r<src>;\n"
fn sps_emit_cvt_u64_u32(s: SparsePtxState, dst: i64, src: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    cvt.u64.u32 %r")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, src)
    out = sps_push_str(out, ";\n")
    out
}

// "    mad.wide.u32 %r<dst>, %r<a>, <b_imm>, %r<c>;\n"
fn sps_emit_mad_u64(s: SparsePtxState, dst: i64, a: i64, b_imm: i64, c: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    mad.wide.u32 %r")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", ")
    out = sps_push_i64(out, b_imm)
    out = sps_push_str(out, ", %r")
    out = sps_push_i64(out, c)
    out = sps_push_str(out, ";\n")
    out
}

// "    add.f32 %f<dst>, %f<a>, %f<b>;\n"
fn sps_emit_add_f32(s: SparsePtxState, dst: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    add.f32 %f")
    out = sps_push_i64(out, dst)
    out = sps_push_str(out, ", %f")
    out = sps_push_i64(out, a)
    out = sps_push_str(out, ", %f")
    out = sps_push_i64(out, b)
    out = sps_push_str(out, ";\n")
    out
}

// "    max.f32 %f<dst>, %f<a>, %f<b>;\n"
fn sps_emit_max_f32(s: SparsePtxState, dst: i64, a: i64, b: i64) -> SparsePtxState with Div {
    var out = s
    out = sps_push_str(out, "    max.f32 %f")
