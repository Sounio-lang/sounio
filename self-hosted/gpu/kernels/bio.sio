// abs.f32 %f<d>, %f<a>
fn bio_emit_abs_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    abs.f32 %f")
