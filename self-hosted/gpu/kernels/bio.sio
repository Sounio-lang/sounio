// self-hosted::gpu::kernels::bio — Biomedical and pharmacokinetic GPU kernels
//
// Emits PTX text for pharmacokinetic (PK) and pharmacodynamic (PD) models used
// in Sounio's scientific computing stack, with epistemic uncertainty propagation.
//
// Models covered:
//   PK one-compartment IV bolus   — C(t) = (dose/Vd) * exp(-ke*t)
//   PK oral one-compartment       — C(t) = F*dose*ka/(Vd*(ka-ke)) * (exp(-ke*t)-exp(-ka*t))
//   PD linear                     — E = e0 + slope*C
//   PD Emax                       — E = emax*C/(ec50+C)
//   PD sigmoidal Hill             — E = emax*C^n/(ec50^n+C^n)
//
// Epistemic tracking:
//   Every concentration output carries a parallel eps register for first-order
//   uncertainty propagation through dose, Vd, ka, ke uncertainties.
//
// Population PK:
//   Monte Carlo sampling of CL and Vd from log-normal distributions on GPU
//   using Box-Muller transform with ex2/lg2 approximations.
//
// Architecture:
//   BioPtxState → byte buffer (65536 bytes) + register/predicate/label counters
//   All helpers precede callers; no forward references.
//
// PTX convention: %f<N> for f32 registers, %p<N> for predicates, LBL_<N> for labels.

// ============================================================================
// PK model tags
// ============================================================================

let PK_MODEL_ONE_COMPARTMENT: i64 = 0
let PK_MODEL_TWO_COMPARTMENT: i64 = 1
let PK_MODEL_ORAL_ONE_COMPARTMENT: i64 = 2

// ============================================================================
// PD model tags
// ============================================================================

let PD_MODEL_LINEAR: i64 = 0
let PD_MODEL_EMAX: i64 = 1
let PD_MODEL_SIGMOIDAL_HILL: i64 = 2
let PD_MODEL_INDIRECT: i64 = 3

// ============================================================================
// Dose route tags
// ============================================================================

let DOSE_ROUTE_IV_BOLUS: i64 = 0
let DOSE_ROUTE_ORAL: i64 = 1
let DOSE_ROUTE_IV_INFUSION: i64 = 2

// ============================================================================
// Therapeutic window tags
// ============================================================================

let WINDOW_BELOW: i64 = 0
let WINDOW_IN: i64 = 1
let WINDOW_ABOVE: i64 = 2
let WINDOW_UNCERTAIN: i64 = 3

// ============================================================================
// Data structures
// ============================================================================

struct PKParams {
    cl: f32,
    vd: f32,
    ka: f32,
    ke: f32,
    cl_eps: f32,
    vd_eps: f32,
    ka_eps: f32,
}

struct PDParams {
    emax: f32,
    ec50: f32,
    hill: f32,
    e0: f32,
    emax_eps: f32,
    ec50_eps: f32,
}

struct DoseEvent {
    time: f32,
    amount_mg: f32,
    amount_eps: f32,
    route: i64,
}

struct PKSimResult {
    times: [f32; 256],
    concentrations: [f32; 256],
    conc_eps: [f32; 256],
    n_points: i64,
    model_tag: i64,
}

struct BioPtxState {
    buf: [i8; 65536],
    buf_len: i64,
    reg_counter: i64,
    pred_counter: i64,
    label_counter: i64,
}

// ============================================================================
// PTX emit helpers — lowest-level buffer operations
// ============================================================================

fn bio_new() -> BioPtxState {
    BioPtxState {
        buf: [0; 65536],
        buf_len: 0,
        reg_counter: 0,
        pred_counter: 0,
        label_counter: 0,
    }
}

fn bio_append_byte(s: BioPtxState, b: i8) -> BioPtxState {
    var out = s
    if out.buf_len < 65536 {
        out.buf[out.buf_len as usize] = b
        out.buf_len = out.buf_len + 1
    }
    out
}

fn bio_emit_line(s: BioPtxState, line: [i8; 128], len: i64) -> BioPtxState {
    var out = s
    var i: i64 = 0
    while i < len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = line[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

fn bio_push_str(s: BioPtxState, text: string) -> BioPtxState with Mut, Panic, Div {
    var out = s
    let n = str_len(text)
    var i: i64 = 0
    while i < n {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = str_char_at(text, i) as i8
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Register and label allocation
// ============================================================================

fn bio_alloc_reg(s: BioPtxState) -> (BioPtxState, i64) {
    var out = s
    let idx = out.reg_counter
    out.reg_counter = idx + 1
    (out, idx)
}

fn bio_alloc_pred(s: BioPtxState) -> (BioPtxState, i64) {
    var out = s
    let idx = out.pred_counter
    out.pred_counter = idx + 1
    (out, idx)
}

fn bio_alloc_label(s: BioPtxState) -> (BioPtxState, i64) {
    var out = s
    let idx = out.label_counter
    out.label_counter = idx + 1
    (out, idx)
}

// Emit a decimal integer into the buffer
fn bio_push_i64(s: BioPtxState, v: i64) -> BioPtxState with Alloc, Mut, Panic, Div {
    var out = s
    out = bio_push_str(out, i64_to_string(v))
    out
}

// ============================================================================
// PTX instruction emitters — helpers before callers
// ============================================================================

fn bio_emit_fma_f32(s: BioPtxState, d: i64, a: i64, b: i64, c: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    fma.rn.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, c)
    out = bio_push_str(out, ";\n")
    out
}

fn bio_emit_mul_f32(s: BioPtxState, d: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    mul.rn.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

fn bio_emit_add_f32(s: BioPtxState, d: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    add.rn.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

fn bio_emit_sub_f32(s: BioPtxState, d: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    sub.rn.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

fn bio_emit_div_f32(s: BioPtxState, d: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    div.approx.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

// ex2.approx.f32 %f<d>, %f<a>   — base-2 exponential approximation
fn bio_emit_ex2_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    ex2.approx.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ";\n")
    out
}

// lg2.approx.f32 %f<d>, %f<a>   — base-2 logarithm approximation
fn bio_emit_lg2_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    lg2.approx.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ";\n")
    out
}

// rcp.approx.f32 %f<d>, %f<a>
fn bio_emit_rcp_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    rcp.approx.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ";\n")
    out
}

// sqrt.approx.f32 %f<d>, %f<a>
fn bio_emit_sqrt_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    sqrt.approx.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ";\n")
    out
}

// mov.f32 %f<d>, 0f<hex8>;  — 32-bit IEEE constant from bit pattern
fn bio_emit_const_f32(s: BioPtxState, d: i64, val_hex: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    mov.f32 %f")
    out = bio_push_i64(out, d)
    out = bio_push_str(out, ", 0f")
    out = bio_push_str(out, i64_to_hex8(val_hex))
    out = bio_push_str(out, ";\n")
    out
}

// setp.gt.f32 %p<p>, %f<a>, %f<b>
fn bio_emit_setp_gt_f32(s: BioPtxState, p: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    setp.gt.f32 %p")
    out = bio_push_i64(out, p)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

// setp.lt.f32 %p<p>, %f<a>, %f<b>
fn bio_emit_setp_lt_f32(s: BioPtxState, p: i64, a: i64, b: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    setp.lt.f32 %p")
    out = bio_push_i64(out, p)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ";\n")
    out
}

// selp.f32 %f<d>, %f<a>, %f<b>, %p<p>
fn bio_emit_selp_f32(s: BioPtxState, d: i64, a: i64, b: i64, p: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
    var out = s
    out = bio_push_str(out, "    selp.f32 %f")
