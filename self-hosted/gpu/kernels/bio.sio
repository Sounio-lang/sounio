    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, a)
    out = bio_push_str(out, ", %f")
    out = bio_push_i64(out, b)
    out = bio_push_str(out, ", %p")
    out = bio_push_i64(out, p)
    out = bio_push_str(out, ";\n")
    out
}

// neg.f32 %f<d>, %f<a>
fn bio_emit_neg_f32(s: BioPtxState, d: i64, a: i64) -> BioPtxState with Mut, Panic, Div, Alloc {
