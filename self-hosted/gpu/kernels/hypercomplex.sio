}

// Helper: emit add.u64 %rd<dst>, %rd<a>, <imm>;
fn hc_emit_add_u64_imm(s: HypercomplexPtxState, dst: i64, src: i64, imm: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    add.u64 %rd")
