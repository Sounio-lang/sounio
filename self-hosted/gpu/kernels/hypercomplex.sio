// self-hosted::gpu::kernels::hypercomplex — GPU PTX kernels for hypercomplex algebra
//
// Emits PTX text for octonion, sedenion, and quaternion operations used in
// Sounio's scientific computing stack (SNN sedenion layers, PAC training, etc.).
//
// Algebras covered:
//   Quaternions  — 4D normed division algebra (Hamilton product, 16 FMAs)
//   Octonions    — 8D normed division algebra (Cayley algebra, Fano plane table)
//   Sedenions    — 16D via Cayley-Dickson from octonions; has zero divisors
//
// Epistemic tracking:
//   Every EightVec and SixteenVec carries a parallel shadow register set (eps_regs)
//   for first-order uncertainty propagation through all algebraic operations.
//
// Architecture:
//   HypercomplexPtxState → byte buffer (65536 bytes) + register/predicate counters
//   All helpers precede callers; no forward references.
//
// PTX convention: %f<N> for f32 registers, %p<N> for predicates.

// ============================================================================
// Core state and vector types
// ============================================================================

struct HypercomplexPtxState {
    buf: [i8; 65536],
    buf_len: i64,
    reg_counter: i64,
    pred_counter: i64,
}

struct EightVec {
    regs: [i64; 8],
    eps_regs: [i64; 8],
}

struct SixteenVec {
    regs: [i64; 16],
    eps_regs: [i64; 16],
}

struct FourVec {
    regs: [i64; 4],
    eps_regs: [i64; 4],
}

// ============================================================================
// PTX emit helpers — lowest-level buffer operations
// ============================================================================

fn hc_new() -> HypercomplexPtxState {
    HypercomplexPtxState {
        buf: [0; 65536],
        buf_len: 0,
        reg_counter: 0,
        pred_counter: 0,
    }
}

fn hc_append_byte(s: HypercomplexPtxState, b: i8) -> HypercomplexPtxState {
    var out = s
    if out.buf_len < 65536 {
        out.buf[out.buf_len as usize] = b
        out.buf_len = out.buf_len + 1
    }
    out
}

// Append a fixed-size 128-byte line buffer, up to len bytes
fn hc_emit_line(s: HypercomplexPtxState, line: [i8; 128], len: i64) -> HypercomplexPtxState {
    var out = s
    var i: i64 = 0
    while i < len {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = line[i as usize]
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// Append a string literal to the buffer
fn hc_push_str(s: HypercomplexPtxState, text: string) -> HypercomplexPtxState with Div {
    var out = s
    let n = str_len(text)
    var i: i64 = 0
    while i < n {
        if out.buf_len < 65536 {
            out.buf[out.buf_len as usize] = str_char_at(text, i) as i8
            out.buf_len = out.buf_len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Register allocation
// ============================================================================

fn hc_alloc_reg(s: HypercomplexPtxState) -> (HypercomplexPtxState, i64) {
    var out = s
    let idx = out.reg_counter
    out.reg_counter = idx + 1
    (out, idx)
}

fn hc_alloc_pred(s: HypercomplexPtxState) -> (HypercomplexPtxState, i64) {
    var out = s
    let idx = out.pred_counter
    out.pred_counter = idx + 1
    (out, idx)
}

fn hc_alloc_four(s: HypercomplexPtxState) -> (HypercomplexPtxState, FourVec) {
    var out = s

    var regs: [i64; 4] = [0; 4]
    var eps_regs: [i64; 4] = [0; 4]

    let p0 = hc_alloc_reg(out)
    out = p0.0
    regs[0] = p0.1

    let p1 = hc_alloc_reg(out)
    out = p1.0
    regs[1] = p1.1

    let p2 = hc_alloc_reg(out)
    out = p2.0
    regs[2] = p2.1

    let p3 = hc_alloc_reg(out)
    out = p3.0
    regs[3] = p3.1

    let e0 = hc_alloc_reg(out)
    out = e0.0
    eps_regs[0] = e0.1

    let e1 = hc_alloc_reg(out)
    out = e1.0
    eps_regs[1] = e1.1

    let e2 = hc_alloc_reg(out)
    out = e2.0
    eps_regs[2] = e2.1

    let e3 = hc_alloc_reg(out)
    out = e3.0
    eps_regs[3] = e3.1

    (out, FourVec { regs: regs, eps_regs: eps_regs })
}

fn hc_alloc_eight(s: HypercomplexPtxState) -> (HypercomplexPtxState, EightVec) {
    var out = s

    var regs: [i64; 8] = [0; 8]
    var eps_regs: [i64; 8] = [0; 8]

    let r0 = hc_alloc_reg(out)
    out = r0.0
    regs[0] = r0.1
    let r1 = hc_alloc_reg(out)
    out = r1.0
    regs[1] = r1.1
    let r2 = hc_alloc_reg(out)
    out = r2.0
    regs[2] = r2.1
    let r3 = hc_alloc_reg(out)
    out = r3.0
    regs[3] = r3.1
    let r4 = hc_alloc_reg(out)
    out = r4.0
    regs[4] = r4.1
    let r5 = hc_alloc_reg(out)
    out = r5.0
    regs[5] = r5.1
    let r6 = hc_alloc_reg(out)
    out = r6.0
    regs[6] = r6.1
    let r7 = hc_alloc_reg(out)
    out = r7.0
    regs[7] = r7.1

    let e0 = hc_alloc_reg(out)
    out = e0.0
    eps_regs[0] = e0.1
    let e1 = hc_alloc_reg(out)
    out = e1.0
    eps_regs[1] = e1.1
    let e2 = hc_alloc_reg(out)
    out = e2.0
    eps_regs[2] = e2.1
    let e3 = hc_alloc_reg(out)
    out = e3.0
    eps_regs[3] = e3.1
    let e4 = hc_alloc_reg(out)
    out = e4.0
    eps_regs[4] = e4.1
    let e5 = hc_alloc_reg(out)
    out = e5.0
    eps_regs[5] = e5.1
    let e6 = hc_alloc_reg(out)
    out = e6.0
    eps_regs[6] = e6.1
    let e7 = hc_alloc_reg(out)
    out = e7.0
    eps_regs[7] = e7.1

    (out, EightVec { regs: regs, eps_regs: eps_regs })
}

fn hc_alloc_sixteen(s: HypercomplexPtxState) -> (HypercomplexPtxState, SixteenVec) {
    var out = s

    var regs: [i64; 16] = [0; 16]
    var eps_regs: [i64; 16] = [0; 16]

    var i: i64 = 0
    while i < 16 {
        let pair = hc_alloc_reg(out)
        out = pair.0
        regs[i as usize] = pair.1
        i = i + 1
    }

    var j: i64 = 0
    while j < 16 {
        let pair = hc_alloc_reg(out)
        out = pair.0
        eps_regs[j as usize] = pair.1
        j = j + 1
    }

    (out, SixteenVec { regs: regs, eps_regs: eps_regs })
}

// ============================================================================
// Octonion Cayley multiplication table (Fano plane)
//
// The 7 lines of the Fano plane (indices 1..7):
//   (1,2,4), (2,3,5), (3,4,6), (4,5,7), (5,6,1), (6,7,2), (7,1,3)
//
// For each line (a,b,c):
//   e_a*e_b = +e_c   e_b*e_a = -e_c
//   e_b*e_c = +e_a   e_c*e_b = -e_a
//   e_c*e_a = +e_b   e_a*e_c = -e_b
//
// Diagonal: e_0*e_x = e_x, e_x*e_0 = e_x, e_i*e_i = -1 (i>0, returns e_0 with sign -1)
// ============================================================================

// Returns +1 or -1 for the sign of e_i * e_j.
// e_0 is the identity so sign is always +1 when either index is 0.
// e_i * e_i = -1 for i > 0.
fn oct_mul_sign(i: i64, j: i64) -> i64 {
    // Identity element
    if i == 0 { return 1 }
    if j == 0 { return 1 }
    // Self-product: e_i * e_i = -1
    if i == j { return -1 }

    // Fano plane line (1,2,4): e1*e2=+e4, e2*e4=+e1, e4*e1=+e2
    if i == 1 && j == 2 { return 1 }
    if i == 2 && j == 1 { return -1 }
    if i == 2 && j == 4 { return 1 }
    if i == 4 && j == 2 { return -1 }
    if i == 4 && j == 1 { return 1 }
    if i == 1 && j == 4 { return -1 }

    // Fano plane line (2,3,5): e2*e3=+e5, e3*e5=+e2, e5*e2=+e3
    if i == 2 && j == 3 { return 1 }
    if i == 3 && j == 2 { return -1 }
    if i == 3 && j == 5 { return 1 }
    if i == 5 && j == 3 { return -1 }
    if i == 5 && j == 2 { return 1 }
    if i == 2 && j == 5 { return -1 }

    // Fano plane line (3,4,6): e3*e4=+e6, e4*e6=+e3, e6*e3=+e4
    if i == 3 && j == 4 { return 1 }
    if i == 4 && j == 3 { return -1 }
    if i == 4 && j == 6 { return 1 }
    if i == 6 && j == 4 { return -1 }
    if i == 6 && j == 3 { return 1 }
    if i == 3 && j == 6 { return -1 }

    // Fano plane line (4,5,7): e4*e5=+e7, e5*e7=+e4, e7*e4=+e5
    if i == 4 && j == 5 { return 1 }
    if i == 5 && j == 4 { return -1 }
    if i == 5 && j == 7 { return 1 }
    if i == 7 && j == 5 { return -1 }
    if i == 7 && j == 4 { return 1 }
    if i == 4 && j == 7 { return -1 }

    // Fano plane line (5,6,1): e5*e6=+e1, e6*e1=+e5, e1*e5=+e6  (wait: cyclic)
    // (a,b,c)=(5,6,1): e5*e6=+e1, e6*e1=+e5, e1*e5=+e6
    if i == 5 && j == 6 { return 1 }
    if i == 6 && j == 5 { return -1 }
    if i == 6 && j == 1 { return 1 }
    if i == 1 && j == 6 { return -1 }
    if i == 1 && j == 5 { return 1 }
    if i == 5 && j == 1 { return -1 }

    // Fano plane line (6,7,2): e6*e7=+e2, e7*e2=+e6, e2*e6=+e7
    if i == 6 && j == 7 { return 1 }
    if i == 7 && j == 6 { return -1 }
    if i == 7 && j == 2 { return 1 }
    if i == 2 && j == 7 { return -1 }
    if i == 2 && j == 6 { return 1 }
    if i == 6 && j == 2 { return -1 }

    // Fano plane line (7,1,3): e7*e1=+e3, e1*e3=+e7, e3*e7=+e1
    if i == 7 && j == 1 { return 1 }
    if i == 1 && j == 7 { return -1 }
    if i == 1 && j == 3 { return 1 }
    if i == 3 && j == 1 { return -1 }
    if i == 3 && j == 7 { return 1 }
    if i == 7 && j == 3 { return -1 }

    // Should not reach here for valid indices 0..7
    0
}

// Returns index k such that e_i * e_j = sign * e_k.
// When i==0: result is e_j. When j==0: result is e_i.
// When i==j && i>0: result is e_0 (scalar, with sign -1).
fn oct_mul_basis(i: i64, j: i64) -> i64 {
    if i == 0 { return j }
    if j == 0 { return i }
    if i == j { return 0 }

    // Fano line (1,2,4)
    if i == 1 && j == 2 { return 4 }
    if i == 2 && j == 1 { return 4 }
    if i == 2 && j == 4 { return 1 }
    if i == 4 && j == 2 { return 1 }
    if i == 4 && j == 1 { return 2 }
    if i == 1 && j == 4 { return 2 }

    // Fano line (2,3,5)
    if i == 2 && j == 3 { return 5 }
    if i == 3 && j == 2 { return 5 }
    if i == 3 && j == 5 { return 2 }
    if i == 5 && j == 3 { return 2 }
    if i == 5 && j == 2 { return 3 }
    if i == 2 && j == 5 { return 3 }

    // Fano line (3,4,6)
    if i == 3 && j == 4 { return 6 }
    if i == 4 && j == 3 { return 6 }
    if i == 4 && j == 6 { return 3 }
    if i == 6 && j == 4 { return 3 }
    if i == 6 && j == 3 { return 4 }
    if i == 3 && j == 6 { return 4 }

    // Fano line (4,5,7)
    if i == 4 && j == 5 { return 7 }
    if i == 5 && j == 4 { return 7 }
    if i == 5 && j == 7 { return 4 }
    if i == 7 && j == 5 { return 4 }
    if i == 7 && j == 4 { return 5 }
    if i == 4 && j == 7 { return 5 }

    // Fano line (5,6,1)
    if i == 5 && j == 6 { return 1 }
    if i == 6 && j == 5 { return 1 }
    if i == 6 && j == 1 { return 5 }
    if i == 1 && j == 6 { return 5 }
    if i == 1 && j == 5 { return 6 }
    if i == 5 && j == 1 { return 6 }

    // Fano line (6,7,2)
    if i == 6 && j == 7 { return 2 }
    if i == 7 && j == 6 { return 2 }
    if i == 7 && j == 2 { return 6 }
    if i == 2 && j == 7 { return 6 }
    if i == 2 && j == 6 { return 7 }
    if i == 6 && j == 2 { return 7 }

    // Fano line (7,1,3)
    if i == 7 && j == 1 { return 3 }
    if i == 1 && j == 7 { return 3 }
    if i == 1 && j == 3 { return 7 }
    if i == 3 && j == 1 { return 7 }
    if i == 3 && j == 7 { return 1 }
    if i == 7 && j == 3 { return 1 }

    // Unreachable for valid 0..7 inputs
    0
}

// ============================================================================
// Atomic PTX instruction emitters
// All use register index form: %f<N>
// ============================================================================

fn hc_emit_fma_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64, c: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    fma.rn.f32 %f")
    out = hc_push_str(out, i64_to_string(dst))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(a))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(b))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(c))
    out = hc_push_str(out, ";\n")
    out
}

fn hc_emit_mul_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    mul.f32 %f")
    out = hc_push_str(out, i64_to_string(dst))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(a))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(b))
    out = hc_push_str(out, ";\n")
    out
}

fn hc_emit_add_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    add.f32 %f")
    out = hc_push_str(out, i64_to_string(dst))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(a))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(b))
    out = hc_push_str(out, ";\n")
    out
}

fn hc_emit_sub_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    sub.f32 %f")
