// Emit max.f32 %f<dst>, %f<a>, %f<b>;
fn hc_emit_max_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    max.f32 %f")
