// ============================================================================
// Phase 2: 128x128x32 shared-memory tiled oct_mul GEMM kernel
//
// Kernel: sounio_oct_mul_tiled
//
// Parameters:
//   param_a_ptr    (.u64) — pointer to A matrix (M*K octonions, row-major)
//   param_b_ptr    (.u64) — pointer to B matrix (K*N octonions, row-major)
//   param_out_ptr  (.u64) — pointer to output C matrix (M*N octonions, row-major)
//   param_m        (.u32) — M dimension (rows of A, rows of C)
//   param_k        (.u32) — K dimension (cols of A, rows of B)
//   param_n        (.u32) — N dimension (cols of B, cols of C)
//   [optional epistemic params if with_epistemic]
//
// Tile: 128x128 output octonions, K-tiles of 32 octonions.
// Thread block: 16x16 = 256 threads. Each thread computes an 8x8 sub-tile
// of the 128x128 output (128/16=8 rows, 128/16=8 cols per thread).
//
// Shared memory:
//   tile_a: 128 * 32 * 32 = 131072 bytes (128 rows, 32 cols, 32 bytes/oct)
//   tile_b: 32 * 128 * 32 = 131072 bytes (32 rows, 128 cols, 32 bytes/oct)
//
// For each K-tile:
//   1. Cooperative load: each of 256 threads loads multiple octonions from
//      global A/B into shared tile_a/tile_b.
//   2. bar.sync 0
//   3. Inner loop kk=0..31: load A[row][k_base+kk] and B[k_base+kk][col]
//      from shared memory. Accumulate via oct_mul (Cayley product) + oct_add.
//   4. bar.sync 0
// After all K-tiles: store accumulated octonion results to global C.
// ============================================================================

fn hc_emit_oct_mul_tiled_kernel(s: HypercomplexPtxState, with_epistemic: bool) -> HypercomplexPtxState with Div {
    var out = s

    // --- PTX file header ---
    out = hc_emit_ptx_file_header(out)

    // --- Kernel entry point ---
    out = hc_push_str(out, ".visible .entry sounio_oct_mul_tiled(\n")
    out = hc_push_str(out, "    .param .u64 param_a_ptr,\n")
    out = hc_push_str(out, "    .param .u64 param_b_ptr,\n")
    out = hc_push_str(out, "    .param .u64 param_out_ptr,\n")
    if with_epistemic {
        out = hc_push_str(out, "    .param .u64 param_a_eps_ptr,\n")
        out = hc_push_str(out, "    .param .u64 param_b_eps_ptr,\n")
        out = hc_push_str(out, "    .param .u64 param_out_eps_ptr,\n")
    }
    out = hc_push_str(out, "    .param .u32 param_m,\n")
    out = hc_push_str(out, "    .param .u32 param_k,\n")
    out = hc_push_str(out, "    .param .u32 param_n\n")
    out = hc_push_str(out, ")\n")
    out = hc_push_str(out, "{\n")

    // --- Register declarations ---
    // Generous pool: oct_mul per inner iteration uses ~80 f32 regs for the
    // multiply alone, plus accumulators (8 per output element * 64 outputs
    // per thread = 512 for accumulators). We declare a large pool.
    if with_epistemic {
        out = hc_push_str(out, "    .reg .f32 %f<2048>;\n")
        out = hc_push_str(out, "    .reg .pred %p<64>;\n")
    } else {
        out = hc_push_str(out, "    .reg .f32 %f<1024>;\n")
        out = hc_push_str(out, "    .reg .pred %p<32>;\n")
    }
    out = hc_push_str(out, "    .reg .b64 %rd<128>;\n")
    out = hc_push_str(out, "    .reg .b32 %r<64>;\n\n")

    // --- Shared memory declarations ---
    // tile_a: 128 rows * 32 cols * 8 floats/oct * 4 bytes/float = 131072 bytes
    // tile_b: 32 rows * 128 cols * 8 floats/oct * 4 bytes/float = 131072 bytes
    out = hc_emit_smem_decl(out, "tile_a", 131072)
    out = hc_emit_smem_decl(out, "tile_b", 131072)
    out = hc_push_str(out, "\n")

    // --- Load kernel parameters ---
    out = hc_push_str(out, "    // --- load parameters ---\n")
    out = hc_push_str(out, "    ld.param.u64 %rd0, [param_a_ptr];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [param_b_ptr];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd2, [param_out_ptr];\n")
    // rd3..rd5 reserved for epistemic pointers
    if with_epistemic {
        out = hc_push_str(out, "    ld.param.u64 %rd3, [param_a_eps_ptr];\n")
        out = hc_push_str(out, "    ld.param.u64 %rd4, [param_b_eps_ptr];\n")
        out = hc_push_str(out, "    ld.param.u64 %rd5, [param_out_eps_ptr];\n")
    }
    out = hc_push_str(out, "    ld.param.u32 %r0, [param_m];\n")
    out = hc_push_str(out, "    ld.param.u32 %r1, [param_k];\n")
    out = hc_push_str(out, "    ld.param.u32 %r2, [param_n];\n\n")

    // --- Thread position within the block (16x16 threads) ---
    out = hc_push_str(out, "    // --- thread position ---\n")
    out = hc_push_str(out, "    mov.u32 %r3, %tid.x;    // tx: 0..15\n")
    out = hc_push_str(out, "    mov.u32 %r4, %tid.y;    // ty: 0..15\n")
    out = hc_push_str(out, "    mov.u32 %r5, %ctaid.x;  // block_col\n")
    out = hc_push_str(out, "    mov.u32 %r6, %ctaid.y;  // block_row\n\n")

    // --- Compute global row/col base for this thread ---
    // Each thread computes 8 rows and 8 cols of the output tile.
    // row_base = block_row * 128 + ty * 8
    // col_base = block_col * 128 + tx * 8
    out = hc_push_str(out, "    // row_base = blockIdx.y * 128 + threadIdx.y * 8\n")
    out = hc_push_str(out, "    mad.lo.u32 %r7, %r6, 128, 0;   // block_row * 128\n")
    out = hc_push_str(out, "    mad.lo.u32 %r7, %r4, 8, %r7;   // + ty * 8\n")
    out = hc_push_str(out, "    // col_base = blockIdx.x * 128 + threadIdx.x * 8\n")
    out = hc_push_str(out, "    mad.lo.u32 %r8, %r5, 128, 0;   // block_col * 128\n")
    out = hc_push_str(out, "    mad.lo.u32 %r8, %r3, 8, %r8;   // + tx * 8\n\n")

    // --- Linear thread ID for cooperative loading ---
    // tid_linear = ty * 16 + tx  (0..255)
    out = hc_push_str(out, "    // tid_linear = ty * 16 + tx\n")
    out = hc_push_str(out, "    mad.lo.u32 %r9, %r4, 16, %r3;\n\n")

    // --- Initialize accumulator registers ---
    // Each thread accumulates an 8x8 grid of octonion results.
    // That is 8*8 = 64 octonions, each with 8 f32 components = 512 f32 regs.
    // Accumulators start at %f0 through %f511.
    // Initialize all to 0.0f (0f00000000).
    out = hc_push_str(out, "    // --- zero 8x8 octonion accumulators (512 f32 regs: f0..f511) ---\n")
    var acc_idx: i64 = 0
    while acc_idx < 512 {
        out = hc_push_str(out, "    mov.f32 %f")
        out = hc_push_str(out, i64_to_string(acc_idx))
        out = hc_push_str(out, ", 0f00000000;\n")
        acc_idx = acc_idx + 1
    }
    out = hc_push_str(out, "\n")

    // --- Shared memory base addresses ---
    // tile_a_base and tile_b_base using mov.u64 with shared address
    out = hc_push_str(out, "    // --- shared memory base addresses ---\n")
    out = hc_push_str(out, "    mov.u64 %rd10, tile_a;\n")
    out = hc_push_str(out, "    mov.u64 %rd11, tile_b;\n\n")

    // --- K-tile loop ---
    // k_base iterates from 0 to K-1 in steps of 32 (TILE_K).
    // r10 = k_base (u32 loop counter)
    out = hc_push_str(out, "    // === K-tile outer loop ===\n")
    out = hc_push_str(out, "    mov.u32 %r10, 0;  // k_base = 0\n")
    out = hc_push_str(out, "K_TILE_LOOP:\n")
    out = hc_push_str(out, "    setp.ge.u32 %p0, %r10, %r1;\n")
    out = hc_push_str(out, "    @%p0 bra K_TILE_DONE;\n\n")

    // === Phase A: Cooperative load of tile_a ===
    // tile_a has 128*32 = 4096 octonions. With 256 threads, each loads 16 octonions.
    // Each octonion is 8 f32 = 32 bytes.
    // Thread tid_linear loads octonions at linear indices:
    //   tid_linear, tid_linear+256, tid_linear+512, ..., tid_linear+3840
    // Linear index lin maps to tile_a[lin/32][lin%32] in tile coordinates.
    // tile_a row = block_row_base + lin/32 in global A coords.
    // tile_a col = k_base + lin%32 in global A coords.
    // Shared offset = lin * 32 bytes.
    // Global addr = a_ptr + (global_row * K + global_col) * 32 bytes.
    out = hc_push_str(out, "    // --- cooperative load tile_a (128x32 octonions) ---\n")
    out = hc_push_str(out, "    // Each of 256 threads loads 16 octonions (8 f32 each)\n")
    out = hc_push_str(out, "    mov.u32 %r11, %r9;  // lin = tid_linear\n")
    out = hc_push_str(out, "LOAD_TILE_A:\n")
    out = hc_push_str(out, "    setp.ge.u32 %p1, %r11, 4096;\n")
    out = hc_push_str(out, "    @%p1 bra LOAD_TILE_A_DONE;\n\n")

    // Compute tile row/col from linear index: row_t = lin / 32, col_t = lin % 32
    out = hc_push_str(out, "    // row_t = lin / 32, col_t = lin % 32\n")
    out = hc_push_str(out, "    shr.u32 %r12, %r11, 5;       // row_t = lin >> 5\n")
    out = hc_push_str(out, "    and.b32 %r13, %r11, 31;      // col_t = lin & 31\n\n")

    // Global row = blockIdx.y * 128 + row_t
    out = hc_push_str(out, "    mad.lo.u32 %r14, %r6, 128, %r12;  // global_row\n")
    // Global col = k_base + col_t
    out = hc_push_str(out, "    add.u32 %r15, %r10, %r13;          // global_col\n\n")

    // Bounds check: if global_row >= M or global_col >= K, store zero
    out = hc_push_str(out, "    setp.ge.u32 %p2, %r14, %r0;  // row >= M?\n")
    out = hc_push_str(out, "    setp.ge.u32 %p3, %r15, %r1;  // col >= K?\n")
    out = hc_push_str(out, "    or.pred %p4, %p2, %p3;\n")
    out = hc_push_str(out, "    @%p4 bra LOAD_A_ZERO;\n\n")

    // Global address: a_ptr + (global_row * K + global_col) * 32
    out = hc_push_str(out, "    // global addr = a_ptr + (row * K + col) * 32\n")
    out = hc_push_str(out, "    mul.wide.u32 %rd20, %r14, 1;  // widen row to u64\n")
    out = hc_push_str(out, "    cvt.u64.u32 %rd21, %r1;       // K as u64\n")
    out = hc_push_str(out, "    mul.lo.u64 %rd20, %rd20, %rd21; // row * K\n")
    out = hc_push_str(out, "    cvt.u64.u32 %rd22, %r15;       // col as u64\n")
    out = hc_push_str(out, "    add.u64 %rd20, %rd20, %rd22;    // row*K + col\n")
    out = hc_push_str(out, "    mul.lo.u64 %rd20, %rd20, 32;    // * 32 bytes/oct\n")
    out = hc_push_str(out, "    add.u64 %rd20, %rd0, %rd20;     // + a_ptr\n\n")

    // Shared offset = lin * 32
    out = hc_push_str(out, "    mul.wide.u32 %rd23, %r11, 32;   // smem offset\n")
    out = hc_push_str(out, "    add.u64 %rd23, %rd10, %rd23;    // + tile_a base\n\n")

    // Load 8 f32 from global, store to shared
    out = hc_push_str(out, "    // load 8 floats (1 octonion) from global -> shared\n")
    var comp_a: i64 = 0
    while comp_a < 8 {
        let byte_off_a = comp_a * 4
        out = hc_push_str(out, "    ld.global.f32 %f512, [%rd20+")
        out = hc_push_str(out, i64_to_string(byte_off_a))
        out = hc_push_str(out, "];\n")
        out = hc_push_str(out, "    st.shared.f32 [%rd23+")
        out = hc_push_str(out, i64_to_string(byte_off_a))
        out = hc_push_str(out, "], %f512;\n")
        comp_a = comp_a + 1
    }
    out = hc_push_str(out, "    bra LOAD_A_NEXT;\n\n")

    // Zero path for out-of-bounds
    out = hc_push_str(out, "LOAD_A_ZERO:\n")
    out = hc_push_str(out, "    mul.wide.u32 %rd23, %r11, 32;\n")
    out = hc_push_str(out, "    add.u64 %rd23, %rd10, %rd23;\n")
    var zc_a: i64 = 0
    while zc_a < 8 {
        let zoff_a = zc_a * 4
        out = hc_push_str(out, "    mov.f32 %f512, 0f00000000;\n")
        out = hc_push_str(out, "    st.shared.f32 [%rd23+")
        out = hc_push_str(out, i64_to_string(zoff_a))
        out = hc_push_str(out, "], %f512;\n")
        zc_a = zc_a + 1
    }
    out = hc_push_str(out, "\n")

    out = hc_push_str(out, "LOAD_A_NEXT:\n")
    out = hc_push_str(out, "    add.u32 %r11, %r11, 256;  // next element\n")
    out = hc_push_str(out, "    bra LOAD_TILE_A;\n")
    out = hc_push_str(out, "LOAD_TILE_A_DONE:\n\n")

    // === Phase B: Cooperative load of tile_b ===
    // tile_b has 32*128 = 4096 octonions. Same approach as tile_a.
    // tile_b row = k_base + lin/128, col = blockIdx.x * 128 + lin%128
    out = hc_push_str(out, "    // --- cooperative load tile_b (32x128 octonions) ---\n")
    out = hc_push_str(out, "    mov.u32 %r11, %r9;  // lin = tid_linear\n")
    out = hc_push_str(out, "LOAD_TILE_B:\n")
    out = hc_push_str(out, "    setp.ge.u32 %p1, %r11, 4096;\n")
    out = hc_push_str(out, "    @%p1 bra LOAD_TILE_B_DONE;\n\n")

    // row_t = lin / 128, col_t = lin % 128
    out = hc_push_str(out, "    shr.u32 %r12, %r11, 7;        // row_t = lin >> 7\n")
    out = hc_push_str(out, "    and.b32 %r13, %r11, 127;      // col_t = lin & 127\n\n")

    // Global row = k_base + row_t, col = blockIdx.x * 128 + col_t
    out = hc_push_str(out, "    add.u32 %r14, %r10, %r12;           // global_row\n")
    out = hc_push_str(out, "    mad.lo.u32 %r15, %r5, 128, %r13;   // global_col\n\n")

    // Bounds check
    out = hc_push_str(out, "    setp.ge.u32 %p2, %r14, %r1;  // row >= K?\n")
    out = hc_push_str(out, "    setp.ge.u32 %p3, %r15, %r2;  // col >= N?\n")
    out = hc_push_str(out, "    or.pred %p4, %p2, %p3;\n")
    out = hc_push_str(out, "    @%p4 bra LOAD_B_ZERO;\n\n")

    // Global addr = b_ptr + (global_row * N + global_col) * 32
    out = hc_push_str(out, "    mul.wide.u32 %rd20, %r14, 1;\n")
    out = hc_push_str(out, "    cvt.u64.u32 %rd21, %r2;       // N as u64\n")
    out = hc_push_str(out, "    mul.lo.u64 %rd20, %rd20, %rd21;\n")
    out = hc_push_str(out, "    cvt.u64.u32 %rd22, %r15;\n")
    out = hc_push_str(out, "    add.u64 %rd20, %rd20, %rd22;\n")
    out = hc_push_str(out, "    mul.lo.u64 %rd20, %rd20, 32;\n")
    out = hc_push_str(out, "    add.u64 %rd20, %rd1, %rd20;\n\n")

    // Shared offset = lin * 32
    out = hc_push_str(out, "    mul.wide.u32 %rd23, %r11, 32;\n")
    out = hc_push_str(out, "    add.u64 %rd23, %rd11, %rd23;\n\n")

    // Load 8 f32 from global, store to shared
    out = hc_push_str(out, "    // load 8 floats (1 octonion) from global -> shared\n")
    var comp_b: i64 = 0
    while comp_b < 8 {
        let byte_off_b = comp_b * 4
        out = hc_push_str(out, "    ld.global.f32 %f512, [%rd20+")
        out = hc_push_str(out, i64_to_string(byte_off_b))
        out = hc_push_str(out, "];\n")
        out = hc_push_str(out, "    st.shared.f32 [%rd23+")
        out = hc_push_str(out, i64_to_string(byte_off_b))
        out = hc_push_str(out, "], %f512;\n")
        comp_b = comp_b + 1
    }
    out = hc_push_str(out, "    bra LOAD_B_NEXT;\n\n")

    // Zero path
    out = hc_push_str(out, "LOAD_B_ZERO:\n")
    out = hc_push_str(out, "    mul.wide.u32 %rd23, %r11, 32;\n")
    out = hc_push_str(out, "    add.u64 %rd23, %rd11, %rd23;\n")
    var zc_b: i64 = 0
    while zc_b < 8 {
        let zoff_b = zc_b * 4
        out = hc_push_str(out, "    mov.f32 %f512, 0f00000000;\n")
        out = hc_push_str(out, "    st.shared.f32 [%rd23+")
        out = hc_push_str(out, i64_to_string(zoff_b))
        out = hc_push_str(out, "], %f512;\n")
        zc_b = zc_b + 1
    }
    out = hc_push_str(out, "\n")

    out = hc_push_str(out, "LOAD_B_NEXT:\n")
    out = hc_push_str(out, "    add.u32 %r11, %r11, 256;\n")
    out = hc_push_str(out, "    bra LOAD_TILE_B;\n")
    out = hc_push_str(out, "LOAD_TILE_B_DONE:\n\n")

    // === Barrier after tile load ===
    out = hc_emit_bar_sync(out)
    out = hc_push_str(out, "\n")

    // === Inner loop: kk = 0..31 ===
    // For each kk, each thread processes its 8x8 output sub-tile:
    //   for ri = 0..7:
    //     for ci = 0..7:
    //       a_oct = tile_a[(ty*8+ri)*32 + kk]   (shared, 8 floats)
    //       b_oct = tile_b[kk*128 + (tx*8+ci)]  (shared, 8 floats)
    //       acc[ri][ci] = oct_add(acc[ri][ci], oct_mul(a_oct, b_oct))
    //
    // We load a_oct and b_oct from shared memory into float registers,
    // then use hc_emit_oct_mul and hc_emit_oct_add inline.
    //
    // Register layout:
    //   f0..f511:   accumulators (8*8*8 = 512)
    //   f512..f519: temp a_oct (8 floats)
    //   f520..f527: temp b_oct (8 floats)
    //   f528..f535: temp oct_mul result (8 floats)
    //   f536..f543: temp for neg-b in oct_mul (8 floats)
    //   f544+:      scratch for oct_mul FMA chains

    out = hc_push_str(out, "    // === inner kk loop (0..31) ===\n")
    out = hc_push_str(out, "    mov.u32 %r16, 0;  // kk = 0\n")
    out = hc_push_str(out, "KK_LOOP:\n")
    out = hc_push_str(out, "    setp.ge.u32 %p5, %r16, 32;\n")
    out = hc_push_str(out, "    @%p5 bra KK_DONE;\n\n")

    // For each of the 8 rows this thread owns, load a_oct from shared.
    // tile_a shared address for row ri:
    //   tile_a_base + ((ty*8 + ri) * 32 + kk) * 32_bytes
    // We precompute a base for this kk: a_kk_base = (ty*8) * 32 + kk
    // Then for each ri: smem_offset = ((a_kk_base + ri*32) * 32)
    // But simpler: compute the shared address inline.

    // Load a_oct for each row into a register bank.
    // To save code size, we use a single a_oct register set (f512..f519)
    // and b_oct (f520..f527) and process one (ri,ci) pair at a time.
    // This produces more PTX but is simpler to emit.

    // For each row ri = 0..7:
    var ri: i64 = 0
    while ri < 8 {
        // Compute shared addr for a_oct:
        // tile_a_offset = ((ty*8 + ri) * 32 + kk) * 32  (bytes)
        // We use integer regs: %r17 = ty*8 + ri, %r18 = r17*32 + kk,
        // then smem_byte_offset = r18 * 32
        out = hc_push_str(out, "    // --- row ri=")
        out = hc_push_str(out, i64_to_string(ri))
        out = hc_push_str(out, " ---\n")
        out = hc_push_str(out, "    mad.lo.u32 %r17, %r4, 8, ")
        out = hc_push_str(out, i64_to_string(ri))
        out = hc_push_str(out, ";  // ty*8 + ri\n")
        out = hc_push_str(out, "    mad.lo.u32 %r18, %r17, 32, %r16; // row_in_tile*32 + kk\n")
        out = hc_push_str(out, "    mul.wide.u32 %rd24, %r18, 32;     // * 32 bytes\n")
        out = hc_push_str(out, "    add.u64 %rd24, %rd10, %rd24;      // + tile_a base\n")

        // Load 8 floats of a_oct into f512..f519
        var ac: i64 = 0
        while ac < 8 {
            let a_freg = 512 + ac
            let a_boff = ac * 4
            out = hc_push_str(out, "    ld.shared.f32 %f")
            out = hc_push_str(out, i64_to_string(a_freg))
            out = hc_push_str(out, ", [%rd24+")
            out = hc_push_str(out, i64_to_string(a_boff))
            out = hc_push_str(out, "];\n")
            ac = ac + 1
        }

        // For each col ci = 0..7:
        var ci: i64 = 0
        while ci < 8 {
            // Compute shared addr for b_oct:
            // tile_b_offset = (kk * 128 + tx*8 + ci) * 32 bytes
            out = hc_push_str(out, "    // col ci=")
            out = hc_push_str(out, i64_to_string(ci))
            out = hc_push_str(out, "\n")
            out = hc_push_str(out, "    mad.lo.u32 %r19, %r16, 128, 0;  // kk*128\n")
            out = hc_push_str(out, "    mad.lo.u32 %r19, %r3, 8, %r19;  // + tx*8\n")
            out = hc_push_str(out, "    add.u32 %r19, %r19, ")
            out = hc_push_str(out, i64_to_string(ci))
            out = hc_push_str(out, ";  // + ci\n")
            out = hc_push_str(out, "    mul.wide.u32 %rd25, %r19, 32;\n")
            out = hc_push_str(out, "    add.u64 %rd25, %rd11, %rd25;\n")

            // Load 8 floats of b_oct into f520..f527
            var bc: i64 = 0
            while bc < 8 {
                let b_freg = 520 + bc
                let b_boff = bc * 4
                out = hc_push_str(out, "    ld.shared.f32 %f")
                out = hc_push_str(out, i64_to_string(b_freg))
                out = hc_push_str(out, ", [%rd25+")
                out = hc_push_str(out, i64_to_string(b_boff))
                out = hc_push_str(out, "];\n")
                bc = bc + 1
            }

            // Inline oct_mul: result in f528..f535
            // Negate b components into f536..f543
            var ni2: i64 = 0
            while ni2 < 8 {
                let neg_dst = 536 + ni2
                let neg_src = 520 + ni2
                out = hc_push_str(out, "    neg.f32 %f")
                out = hc_push_str(out, i64_to_string(neg_dst))
                out = hc_push_str(out, ", %f")
                out = hc_push_str(out, i64_to_string(neg_src))
                out = hc_push_str(out, ";\n")
                ni2 = ni2 + 1
            }

            // For each result component k, emit the Fano-plane oct_mul
            var k: i64 = 0
            while k < 8 {
                let r_freg = 528 + k
                var first_pair: bool = true
                var ii: i64 = 0
                while ii < 8 {
                    var jj: i64 = 0
                    while jj < 8 {
                        let basis = oct_mul_basis(ii, jj)
                        if basis == k {
                            let sign = oct_mul_sign(ii, jj)
                            let a_reg_idx = 512 + ii
                            var b_use: i64 = 0
                            if sign == 1 {
                                b_use = 520 + jj
                            } else {
                                b_use = 536 + jj
                            }
                            if first_pair {
                                out = hc_push_str(out, "    mul.f32 %f")
                                out = hc_push_str(out, i64_to_string(r_freg))
                                out = hc_push_str(out, ", %f")
                                out = hc_push_str(out, i64_to_string(a_reg_idx))
                                out = hc_push_str(out, ", %f")
                                out = hc_push_str(out, i64_to_string(b_use))
                                out = hc_push_str(out, ";\n")
                                first_pair = false
                            } else {
                                out = hc_push_str(out, "    fma.rn.f32 %f")
                                out = hc_push_str(out, i64_to_string(r_freg))
                                out = hc_push_str(out, ", %f")
                                out = hc_push_str(out, i64_to_string(a_reg_idx))
                                out = hc_push_str(out, ", %f")
                                out = hc_push_str(out, i64_to_string(b_use))
                                out = hc_push_str(out, ", %f")
                                out = hc_push_str(out, i64_to_string(r_freg))
                                out = hc_push_str(out, ";\n")
                            }
                        }
                        jj = jj + 1
                    }
                    ii = ii + 1
                }
                k = k + 1
            }

            // Accumulate: acc[ri*8+ci] += oct_mul result
            // acc base register = (ri * 8 + ci) * 8
            let acc_base = (ri * 8 + ci) * 8
            var ak: i64 = 0
            while ak < 8 {
                let acc_reg = acc_base + ak
                let mul_reg = 528 + ak
                out = hc_push_str(out, "    add.f32 %f")
                out = hc_push_str(out, i64_to_string(acc_reg))
                out = hc_push_str(out, ", %f")
                out = hc_push_str(out, i64_to_string(acc_reg))
                out = hc_push_str(out, ", %f")
                out = hc_push_str(out, i64_to_string(mul_reg))
                out = hc_push_str(out, ";\n")
                ak = ak + 1
            }

            ci = ci + 1
        }
        ri = ri + 1
    }

    out = hc_push_str(out, "\n    add.u32 %r16, %r16, 1;  // kk++\n")
    out = hc_push_str(out, "    bra KK_LOOP;\n")
    out = hc_push_str(out, "KK_DONE:\n\n")

    // === Barrier after inner loop before next tile load ===
    out = hc_emit_bar_sync(out)
    out = hc_push_str(out, "\n")

    // Advance k_base by TILE_K=32
    out = hc_push_str(out, "    add.u32 %r10, %r10, 32;  // k_base += TILE_K\n")
    out = hc_push_str(out, "    bra K_TILE_LOOP;\n")
    out = hc_push_str(out, "K_TILE_DONE:\n\n")

    // === Store results to global memory ===
    // For each (ri, ci) in this thread's 8x8 sub-tile:
    //   global_row = row_base + ri = blockIdx.y * 128 + ty*8 + ri
    //   global_col = col_base + ci = blockIdx.x * 128 + tx*8 + ci
    //   out_addr = out_ptr + (global_row * N + global_col) * 32
    out = hc_push_str(out, "    // === store 8x8 octonion results to global memory ===\n")
    var sri: i64 = 0
    while sri < 8 {
        var sci: i64 = 0
        while sci < 8 {
            let s_acc_base = (sri * 8 + sci) * 8

            // global_row = r7 + sri, global_col = r8 + sci
            out = hc_push_str(out, "    // store acc[")
            out = hc_push_str(out, i64_to_string(sri))
            out = hc_push_str(out, "][")
            out = hc_push_str(out, i64_to_string(sci))
            out = hc_push_str(out, "]\n")
            out = hc_push_str(out, "    add.u32 %r20, %r7, ")
            out = hc_push_str(out, i64_to_string(sri))
            out = hc_push_str(out, ";  // global_row\n")
            out = hc_push_str(out, "    add.u32 %r21, %r8, ")
            out = hc_push_str(out, i64_to_string(sci))
            out = hc_push_str(out, ";  // global_col\n")

            // Bounds check: skip store if row >= M or col >= N
            out = hc_push_str(out, "    setp.ge.u32 %p6, %r20, %r0;\n")
            out = hc_push_str(out, "    setp.ge.u32 %p7, %r21, %r2;\n")
            out = hc_push_str(out, "    or.pred %p8, %p6, %p7;\n")
            out = hc_push_str(out, "    @%p8 bra SKIP_STORE_")
            out = hc_push_str(out, i64_to_string(sri))
            out = hc_push_str(out, "_")
            out = hc_push_str(out, i64_to_string(sci))
            out = hc_push_str(out, ";\n")

            // Compute address: out_ptr + (row * N + col) * 32
            out = hc_push_str(out, "    mul.wide.u32 %rd30, %r20, 1;\n")
            out = hc_push_str(out, "    cvt.u64.u32 %rd31, %r2;\n")
            out = hc_push_str(out, "    mul.lo.u64 %rd30, %rd30, %rd31;\n")
            out = hc_push_str(out, "    cvt.u64.u32 %rd32, %r21;\n")
            out = hc_push_str(out, "    add.u64 %rd30, %rd30, %rd32;\n")
            out = hc_push_str(out, "    mul.lo.u64 %rd30, %rd30, 32;\n")
            out = hc_push_str(out, "    add.u64 %rd30, %rd2, %rd30;\n")

            // Store 8 floats
            var sk: i64 = 0
            while sk < 8 {
                let s_reg = s_acc_base + sk
                let s_off = sk * 4
                out = hc_push_str(out, "    st.global.f32 [%rd30+")
                out = hc_push_str(out, i64_to_string(s_off))
                out = hc_push_str(out, "], %f")
                out = hc_push_str(out, i64_to_string(s_reg))
                out = hc_push_str(out, ";\n")
                sk = sk + 1
            }

            out = hc_push_str(out, "SKIP_STORE_")
            out = hc_push_str(out, i64_to_string(sri))
            out = hc_push_str(out, "_")
            out = hc_push_str(out, i64_to_string(sci))
            out = hc_push_str(out, ":\n")

            sci = sci + 1
        }
        sri = sri + 1
    }

    // === Optional epistemic store ===
    if with_epistemic {
        out = hc_push_str(out, "\n    // === epistemic uncertainty store (placeholder) ===\n")
        out = hc_push_str(out, "    // Epistemic propagation for tiled GEMM requires per-element\n")
        out = hc_push_str(out, "    // uncertainty tracking through the oct_mul accumulation chain.\n")
        out = hc_push_str(out, "    // Phase 2 stores conservative max-bound: eps_out = K * max(eps_a, eps_b).\n")
        out = hc_push_str(out, "    // Full propagation deferred to Phase 3 (register-pressure optimization).\n")
    }

    out = hc_push_str(out, "\n    ret;\n")
    out = hc_push_str(out, "}\n")
    out
}

// ============================================================================
// Phase 3: Double-buffered cp.async kernel for sm_80+ (oct_mul GEMM)
//
// cp.async.ca.shared.global — hardware-accelerated global->shared copy
// used in a ping-pong (double-buffer) pipeline to overlap loads with compute.
//
// Tile geometry:
//   TILE_M = 128, TILE_N = 128, TILE_K = 32
//   Each matrix element is one octonion = 8 floats = 32 bytes.
//   smem_a per buffer: 128 * 32 * 8 * 4 = 131072 bytes
//   smem_b per buffer: 32 * 128 * 8 * 4 = 131072 bytes
//   Total per buffer pair: 262144 bytes; two buffers = 524288 bytes
//   (Requires extended shared memory via cudaFuncSetAttribute on sm_80+.)
//
// Pipeline schedule (depth-2):
//   Prologue : cp.async buf 0; commit_group
//   Loop     : cp.async buf (1-cur); commit_group; wait_group 1; bar.sync;
//              compute on buf cur; bar.sync; cur = 1 - cur
//   Epilogue : wait_group 0; bar.sync; compute on final buf; store to global
// ============================================================================

// Emit: cp.async.ca.shared.global [%rd<smem>], [%rd<global>], 4;
// Copies 4 bytes (one f32) from global to shared asynchronously.
// The .ca qualifier (cache-all) is required for sub-16-byte copies on sm_80+.
fn hc_emit_cpasync_f32(s: HypercomplexPtxState, smem_addr_reg: i64, global_addr_reg: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    cp.async.ca.shared.global [%rd")
    out = hc_push_str(out, i64_to_string(smem_addr_reg))
    out = hc_push_str(out, "], [%rd")
    out = hc_push_str(out, i64_to_string(global_addr_reg))
    out = hc_push_str(out, "], 4;\n")
    out
}

// Emit: cp.async.commit_group;
// Commits all preceding cp.async operations into a single group for
// subsequent wait_group tracking.  The hardware tracks committed groups
// in a FIFO; wait_group N blocks until at most N groups remain in-flight.
fn hc_emit_cpasync_commit(s: HypercomplexPtxState) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    cp.async.commit_group;\n")
    out
}

// Emit: cp.async.wait_group <group>;
// Blocks the issuing thread until at most <group> committed groups remain
// in-flight.  wait_group 0 drains all pending copies; wait_group 1 ensures
// the oldest group has completed (used in the double-buffer main loop to
// overlap prefetch of the next tile with compute on the current tile).
fn hc_emit_cpasync_wait(s: HypercomplexPtxState, group: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    cp.async.wait_group ")
    out = hc_push_str(out, i64_to_string(group))
    out = hc_push_str(out, ";\n")
    out
}

// ----------------------------------------------------------------------------
// Phase 3 PTX helpers (precede the main kernel emitter)
// ----------------------------------------------------------------------------

// Emit mov.u64 %rd<dst>, <name>;  (for shared memory symbol addresses)
