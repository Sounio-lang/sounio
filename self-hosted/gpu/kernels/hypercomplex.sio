// Emit mov.f32 %f<dst>, 0f<hex>; — value encoded as 32-bit IEEE 754 hex.
// We accept the bit pattern as an i64 (cast of f32 bit representation).
fn hc_emit_const_f32(s: HypercomplexPtxState, dst: i64, val: f32) -> HypercomplexPtxState with Div {
    var out = s
    // Emit as mov with hex literal; format: 0f<8 hex digits>
    let bits = f32_to_bits(val)
    out = hc_push_str(out, "    mov.f32 %f")
    out = hc_push_str(out, i64_to_string(dst))
    out = hc_push_str(out, ", 0f")
    out = hc_push_str(out, i64_to_hex8(bits))
    out = hc_push_str(out, ";\n")
    out
}

// Emit setp.lt.f32 %p<dst>, %f<a>, %f<b>;
fn hc_emit_setp_lt_f32(s: HypercomplexPtxState, dst: i64, a: i64, b: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    setp.lt.f32 %p")
    out = hc_push_str(out, i64_to_string(dst))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(a))
    out = hc_push_str(out, ", %f")
    out = hc_push_str(out, i64_to_string(b))
    out = hc_push_str(out, ";\n")
    out
}

// Emit abs.f32 %f<dst>, %f<src>;
fn hc_emit_abs_f32(s: HypercomplexPtxState, dst: i64, src: i64) -> HypercomplexPtxState with Div {
    var out = s
