    out = hc_push_str(out, ", ")
    out = hc_push_str(out, special)
    out = hc_push_str(out, ";\n")
    out
}

// Helper: emit st.global.f32 [%rd<addr>], %f<src>;
fn hc_emit_st_global_f32(s: HypercomplexPtxState, addr_reg: i64, src_reg: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    st.global.f32 [%rd")
    out = hc_push_str(out, i64_to_string(addr_reg))
    out = hc_push_str(out, "], %f")
    out = hc_push_str(out, i64_to_string(src_reg))
    out = hc_push_str(out, ";\n")
    out
}

// Helper: emit cvt.u64.u32 %rd<dst>, %r<src>;
fn hc_emit_cvt_u64_u32(s: HypercomplexPtxState, dst_rd: i64, src_r: i64) -> HypercomplexPtxState with Div {
