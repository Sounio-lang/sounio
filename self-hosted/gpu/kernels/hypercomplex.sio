// Helper: emit mul.lo.u64 %rd<dst>, %rd<a>, <imm>;
fn hc_emit_mul_lo_u64_imm(s: HypercomplexPtxState, dst: i64, src: i64, imm: i64) -> HypercomplexPtxState with Div {
    var out = s
    out = hc_push_str(out, "    mul.lo.u64 %rd")
    out = hc_push_str(out, i64_to_string(dst))
