// self-hosted::gpu::kernels::hmma_signs — tensor-core (WMMA) octonion multiply, Convention X
//
// Octonion multiplication a·b is LINEAR in b, so it is a matrix–vector product:
//
//     a·b = L(a) · b,   where   L(a)[k][j] = σ(k⊕j, j) · a[k⊕j]     (X: e1·e2 = +e3)
//
// σ is the recursive Cayley–Dickson twist sign (canonical Convention X, matching
// stdlib and the hypercomplex.sio / ossm_forward.sio GPU emitters — see
// stdlib/algebra/README.md). Because the ±1 signs are BAKED INTO the left-multiply
// matrix, a plain signed tensor-core matmul (`wmma.mma.sync.m16n16k16.f16.f32`) of the
// 8×8 L(a) (padded to 16×16) against b yields the correct octonion product DIRECTLY —
// there is NO post-multiply "sign correction" step.
//
// HISTORY: this file previously implemented a broken post-HMMA sign-mask correction
// (`hmma_sign_mask_for_output_component` + `hmma_emit_full_sign_correction`) that
// double-negated shared output components (e.g. dst[1] negated 3×, dst[2]/dst[5]/dst[6]
// negated an even number of times → net no-op) and never implemented a coherent
// convention. It was standalone/unused. Replaced 2026-07-16 by the L(a) construction
// below, which is **hardware-validated on the DGX Spark (NVIDIA GB10, sm_121, CUDA 13.0)**:
// a wmma m16n16k16 kernel computing L(a)·B matches the exact X reference for a full
// 16-column batch (0/128 component mismatches) and the discriminator e1·e2 lands in
// component 3 (+1), not 4 — Convention X. Reference: docs/gpu/oct_wmma_validate.cu.
//
// Architecture: all helpers precede callers (no forward references).
// Uses HypercomplexPtxState from hypercomplex.sio for PTX emission.

// ============================================================================
// Canonical Cayley–Dickson sign (Convention X) — the value baked into L(a)
// ============================================================================

// Recursive Cayley–Dickson twist sign σ(a,b,bits) ∈ {+1,−1}; pure i64.
fn hmma_oct_cd_sigma(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return hmma_oct_cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return hmma_oct_cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return hmma_oct_cd_sigma(a_lo, 0, bits - 1) }
        return 0 - hmma_oct_cd_sigma(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - hmma_oct_cd_sigma(0, a_lo, bits - 1) }
    hmma_oct_cd_sigma(b_lo, a_lo, bits - 1)
}

// Which a-component feeds L(a)[k][j]:  a[k⊕j].
fn hmma_left_mul_index(k: i64, j: i64) -> i64 { k ^ j }

// Sign of L(a)[k][j] = σ(k⊕j, j) ∈ {+1,−1}. This is the entire "sign structure" —
// it is a matrix entry, applied ONCE (baked into L(a)), never as a post-correction.
fn hmma_left_mul_sign(k: i64, j: i64) -> i64 { hmma_oct_cd_sigma(k ^ j, j, 3) }

// ============================================================================
// PTX: build the signed left-multiply matrix L(a) into 64 f32 registers
// ============================================================================

// Emits L(a)[k][j] into %f[lmat_base + k*8 + j] from the a-components at
// %f[a_base + (k⊕j)], folding the compile-time σ(k⊕j,j) sign into a mov or neg.
// The resulting register block is the matrix-A operand of the wmma matmul (padded
// to 16×16 by the caller); after `wmma.mma.sync ... L, b`, no sign fixup is needed.
fn hmma_emit_build_left_mul_matrix(buf: HypercomplexPtxState, a_base: i64, lmat_base: i64) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = buf
    out = hc_push_str(out, "    // build L(a)[k][j] = sigma(k^j,j) * a[k^j]  (Convention X)\n")
    var k: i64 = 0
    while k < 8 {
        var j: i64 = 0
        while j < 8 {
            let src = a_base + (k ^ j)
            let dst = lmat_base + k * 8 + j
            if hmma_left_mul_sign(k, j) < 0 {
                out = hc_push_str(out, "    neg.f32 %f")
            } else {
                out = hc_push_str(out, "    mov.f32 %f")
            }
            out = hc_push_str(out, i64_to_string(dst))
            out = hc_push_str(out, ", %f")
            out = hc_push_str(out, i64_to_string(src))
            out = hc_push_str(out, ";\n")
            j = j + 1
        }
        k = k + 1
    }
    out
}

// ============================================================================
// Fragment packing/unpacking PTX emitters
// ============================================================================

// Emits PTX to unpack the first 8 f32 accumulator registers of the wmma result
// into an 8-component octonion output (the product a·b in Convention X).
fn hmma_emit_unpack_result(buf: HypercomplexPtxState, frag_reg: i64, oct_dst_base: i64) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = buf
    out = hc_push_str(out, "    // unpack HMMA result frag[")
    out = hc_push_str(out, i64_to_string(frag_reg))
    out = hc_push_str(out, "..] -> dst[")
    out = hc_push_str(out, i64_to_string(oct_dst_base))
    out = hc_push_str(out, "..]\n")
    var i: i64 = 0
    while i < 8 {
        out = hc_push_str(out, "    mov.f32 %f")
        out = hc_push_str(out, i64_to_string(oct_dst_base + i))
        out = hc_push_str(out, ", %f")
        out = hc_push_str(out, i64_to_string(frag_reg + i))
        out = hc_push_str(out, ";\n")
        i = i + 1
    }
    out
}

// ============================================================================
// Complete WMMA octonion-multiply kernel emitter (Convention X)
// ============================================================================

// Emits "{%<prefix><start>, ..., %<prefix><start+count-1>}".
fn hmma_emit_frag_list(buf: HypercomplexPtxState, prefix: string, start: i64, count: i64) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(buf, "{")
    var i: i64 = 0
    while i < count {
        if i > 0 { out = hc_push_str(out, ", ") }
        out = hc_push_str(out, prefix)
        out = hc_push_str(out, i64_to_string(start + i))
        i = i + 1
    }
    hc_push_str(out, "}")
}

// Emits a complete, runnable PTX kernel `sounio_oct_mul_wmma(L_ptr, B_ptr, out_ptr)` that
// computes the octonion product on tensor cores: given L(a) (16×16 f16, the caller/host builds
// L(a)[k][j]=σ(k⊕j,j)·a[k⊕j] via hmma_left_mul_sign) and B (16×16 f16), it runs one
// wmma.m16n16k16.f16→f32 tile and stores D = L(a)·B (the octonion products, Convention X).
// HARDWARE-VALIDATED on the DGX Spark (NVIDIA GB10, sm_121, CUDA 13.0): this exact emitted PTX
// ptxas-assembles and launches; e1·e2 → component 3 (+1), batch 0/128 mismatch vs the exact X
// reference. Reference harness: docs/gpu/run_sounio_ptx.cu (loads the Sounio-emitted PTX).
pub fn hmma_emit_oct_mul_wmma_kernel(s: HypercomplexPtxState) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(s, ".version 9.0\n.target sm_121\n.address_size 64\n\n")
    out = hc_push_str(out, ".visible .entry sounio_oct_mul_wmma(\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 1 p_lmat,\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 1 p_b,\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 1 p_out\n)\n{\n")
    out = hc_push_str(out, "    .reg .b32 %r<18>;\n    .reg .b32 %f<10>;\n    .reg .b64 %rd<7>;\n\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [p_lmat];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd2, [p_b];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd3, [p_out];\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd4, %rd1;\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd5, %rd2;\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd6, %rd3;\n")
    out = hc_push_str(out, "    mov.b32 %r1, 16;\n")
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.global.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%rd4], %r1;\n")
    out = hc_push_str(out, "    wmma.load.b.sync.aligned.col.m16n16k16.global.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%rd5], %r1;\n")
    out = hc_push_str(out, "    mov.f32 %f1, 0f00000000;\n")
    out = hc_push_str(out, "    wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f1, %f1, %f1, %f1, %f1, %f1, %f1, %f1};\n")
    out = hc_push_str(out, "    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", %r1;\n")
    out = hc_push_str(out, "    ret;\n}\n")
    out
}

// Emits a SELF-CONTAINED WMMA octonion-multiply kernel: sounio_oct_mul_full(a_ptr, b_ptr, out_ptr).
// Thread 0 builds L(a) IN-KERNEL into shared memory (f16, with the compile-time σ from
// hmma_left_mul_sign folded into an optional neg), stages B, bar.sync; the warp then runs one
// wmma m16n16k16 tile computing D = L(a)·B = the octonion products a·b_c (Convention X). Unlike
// hmma_emit_oct_mul_wmma_kernel (which takes a pre-built L matrix), this takes RAW octonions.
// HARDWARE-VALIDATED on the DGX Spark (NVIDIA GB10, sm_121, CUDA 13.0): the emitted PTX
// ptxas-assembles (21096-byte cubin) + launches; e1·e2 → component 3 (+1), batch 0/128 mismatch
// vs the exact X reference. Reference: docs/gpu/run_full_ptx.cu.
pub fn hmma_emit_oct_mul_full_kernel(s: HypercomplexPtxState) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(s, ".version 9.0\n.target sm_121\n.address_size 64\n\n")
    out = hc_push_str(out, ".visible .entry sounio_oct_mul_full(\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 4 p_a,\n    .param .u64 .ptr .align 4 p_b,\n    .param .u64 .ptr .align 4 p_out\n)\n{\n")
    out = hc_push_str(out, "    .reg .pred %p<2>;\n    .reg .b16 %rs<2>;\n    .reg .b32 %r<24>;\n    .reg .b32 %f<12>;\n    .reg .b64 %rd<7>;\n")
    out = hc_push_str(out, "    .shared .align 2 .b8 sL[512];\n    .shared .align 2 .b8 sB[512];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [p_a];\n    ld.param.u64 %rd2, [p_b];\n    ld.param.u64 %rd3, [p_out];\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd4, %rd1;\n    cvta.to.global.u64 %rd5, %rd2;\n    cvta.to.global.u64 %rd6, %rd3;\n")
    out = hc_push_str(out, "    mov.u32 %r18, sL;\n    mov.u32 %r19, sB;\n")
    out = hc_push_str(out, "    mov.u32 %r1, %tid.x;\n    setp.ne.u32 %p1, %r1, 0;\n    @%p1 bra $BUILD_DONE;\n")
    out = hc_push_str(out, "    mov.u16 %rs1, 0;\n    mov.u32 %r21, 0;\n$ZERO:\n")
    out = hc_push_str(out, "    add.s32 %r20, %r18, %r21;\n    st.shared.u16 [%r20], %rs1;\n")
    out = hc_push_str(out, "    add.s32 %r20, %r19, %r21;\n    st.shared.u16 [%r20], %rs1;\n")
    out = hc_push_str(out, "    add.s32 %r21, %r21, 2;\n    setp.lt.u32 %p1, %r21, 512;\n    @%p1 bra $ZERO;\n")
    var k: i64 = 0
    while k < 8 {
        var j: i64 = 0
        while j < 8 {
            let i = k ^ j
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd4+")
            out = hc_push_str(out, i64_to_string(i * 4))
            out = hc_push_str(out, "];\n")
            if hmma_left_mul_sign(k, j) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n")
            out = hc_push_str(out, "    st.shared.u16 [%r18+")
            out = hc_push_str(out, i64_to_string((k * 16 + j) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            j = j + 1
        }
        k = k + 1
    }
    var c: i64 = 0
    while c < 16 {
        var r: i64 = 0
        while r < 8 {
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd5+")
            out = hc_push_str(out, i64_to_string((c * 8 + r) * 4))
            out = hc_push_str(out, "];\n    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r19+")
            out = hc_push_str(out, i64_to_string((c * 16 + r) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            r = r + 1
        }
        c = c + 1
    }
    out = hc_push_str(out, "$BUILD_DONE:\n    bar.sync 0;\n    mov.b32 %r1, 16;\n")
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.load.b.sync.aligned.col.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    mov.f32 %f0, 0f00000000;\n")
    out = hc_push_str(out, "    wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    out = hc_push_str(out, "    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", %r1;\n    ret;\n}\n")
    out
}

// ============================================================================
// Sedenion (16-dim) tensor-core multiply — same L(a) construction, bits=4
// ============================================================================

// Sign of the sedenion left-mul matrix L(a)[k][j] = σ(k⊕j, j, 4). L(a) is 16×16 = exactly one
// wmma m16n16k16 tile (no padding).
fn hmma_sed_left_mul_sign(k: i64, j: i64) -> i64 { hmma_oct_cd_sigma(k ^ j, j, 4) }

// Emits a SELF-CONTAINED tensor-core SEDENION multiply kernel sounio_sed_mul_full(a,b,out): thread 0
// builds L(a)[k][j]=σ(k⊕j,j,4)·a[k⊕j] into shared (f16, 16×16 full tile, compile-time σ folded into
// optional neg), stages B, bar.sync, and the warp runs one wmma tile → D = L(a)·B = the sedenion
// products (Convention X). HARDWARE-VALIDATED on the DGX Spark (GB10, sm_121, CUDA 13.0): the emitted
// PTX ptxas-assembles (20576-byte cubin) + launches; e2·e5 → component 7, and the canonical zero
// divisor (e3+e10)·(e6−e15) ANNIHILATES exactly (0/16 nonzero) on the tensor core.
// Reference: docs/gpu/sed_mul_full.cu.
pub fn hmma_emit_sed_mul_full_kernel(s: HypercomplexPtxState) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(s, ".version 9.0\n.target sm_121\n.address_size 64\n\n")
    out = hc_push_str(out, ".visible .entry sounio_sed_mul_full(\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 4 p_a,\n    .param .u64 .ptr .align 4 p_b,\n    .param .u64 .ptr .align 4 p_out\n)\n{\n")
    out = hc_push_str(out, "    .reg .pred %p<2>;\n    .reg .b16 %rs<2>;\n    .reg .b32 %r<24>;\n    .reg .b32 %f<12>;\n    .reg .b64 %rd<7>;\n")
    out = hc_push_str(out, "    .shared .align 2 .b8 sL[512];\n    .shared .align 2 .b8 sB[512];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [p_a];\n    ld.param.u64 %rd2, [p_b];\n    ld.param.u64 %rd3, [p_out];\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd4, %rd1;\n    cvta.to.global.u64 %rd5, %rd2;\n    cvta.to.global.u64 %rd6, %rd3;\n")
    out = hc_push_str(out, "    mov.u32 %r18, sL;\n    mov.u32 %r19, sB;\n")
    out = hc_push_str(out, "    mov.u32 %r1, %tid.x;\n    setp.ne.u32 %p1, %r1, 0;\n    @%p1 bra $BUILD_DONE;\n")
    var k: i64 = 0
    while k < 16 {
        var j: i64 = 0
        while j < 16 {
            let i = k ^ j
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd4+")
            out = hc_push_str(out, i64_to_string(i * 4))
            out = hc_push_str(out, "];\n")
            if hmma_sed_left_mul_sign(k, j) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r18+")
            out = hc_push_str(out, i64_to_string((k * 16 + j) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            j = j + 1
        }
        k = k + 1
    }
    var c: i64 = 0
    while c < 16 {
        var r: i64 = 0
        while r < 16 {
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd5+")
            out = hc_push_str(out, i64_to_string((c * 16 + r) * 4))
            out = hc_push_str(out, "];\n    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r19+")
            out = hc_push_str(out, i64_to_string((c * 16 + r) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            r = r + 1
        }
        c = c + 1
    }
    out = hc_push_str(out, "$BUILD_DONE:\n    bar.sync 0;\n    mov.b32 %r1, 16;\n")
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.load.b.sync.aligned.col.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    mov.f32 %f0, 0f00000000;\n")
    out = hc_push_str(out, "    wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    out = hc_push_str(out, "    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", %r1;\n    ret;\n}\n")
    out
}

// ============================================================================
// Octonion ASSOCIATOR [a,b,c]=(ab)c−a(bc) on tensor cores (Convention X)
// ============================================================================

// Right-multiply matrix sign: R(c)[k][i] = σ(i, k⊕i) · c[k⊕i] realizes x ↦ x·c.
fn hmma_right_mul_sign(k: i64, i: i64) -> i64 { hmma_oct_cd_sigma(i, k ^ i, 3) }

// Emits sounio_oct_associator(a_ptr, c_ptr, out_ptr): since [a,b,c] is linear in b,
//   [a,b,c] = M·b,  M = R(c)·L(a) − L(a)·R(c)   (matrix commutator).
// Thread 0 builds L(a) and R(c) (row-major, 8×8 in a 16×16 tile, compile-time σ folded into optional
// neg), bar.sync; then TWO wmma m16n16k16 matmuls (R·L and L·R, both row.row) + 8 sub.f32 → the
// associator matrix M (16×16), stored to global. HARDWARE-VALIDATED on the DGX Spark (GB10, sm_121,
// CUDA 13.0): the emitted PTX ptxas-assembles (17552-byte cubin), launches, and reproduces the
// 168 non-associative octonion basis triples + the associator-norm dichotomy ‖[e_i,e_j,e_k]‖∈{0,2}
// on the Blackwell tensor cores. Reference: docs/gpu/assoc_tc.cu.
pub fn hmma_emit_oct_associator_kernel(s: HypercomplexPtxState) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(s, ".version 9.0\n.target sm_121\n.address_size 64\n\n")
    out = hc_push_str(out, ".visible .entry sounio_oct_associator(\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 4 p_a,\n    .param .u64 .ptr .align 4 p_c,\n    .param .u64 .ptr .align 4 p_out\n)\n{\n")
    out = hc_push_str(out, "    .reg .pred %p<2>;\n    .reg .b16 %rs<2>;\n    .reg .b32 %r<24>;\n    .reg .b32 %f<28>;\n    .reg .b64 %rd<7>;\n")
    out = hc_push_str(out, "    .shared .align 2 .b8 sL[512];\n    .shared .align 2 .b8 sR[512];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [p_a];\n    ld.param.u64 %rd2, [p_c];\n    ld.param.u64 %rd3, [p_out];\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd4, %rd1;\n    cvta.to.global.u64 %rd5, %rd2;\n    cvta.to.global.u64 %rd6, %rd3;\n")
    out = hc_push_str(out, "    mov.u32 %r18, sL;\n    mov.u32 %r19, sR;\n")
    out = hc_push_str(out, "    mov.u32 %r1, %tid.x;\n    setp.ne.u32 %p1, %r1, 0;\n    @%p1 bra $BUILD_DONE;\n")
    out = hc_push_str(out, "    mov.u16 %rs1, 0;\n    mov.u32 %r21, 0;\n$ZERO:\n")
    out = hc_push_str(out, "    add.s32 %r20, %r18, %r21;\n    st.shared.u16 [%r20], %rs1;\n")
    out = hc_push_str(out, "    add.s32 %r20, %r19, %r21;\n    st.shared.u16 [%r20], %rs1;\n")
    out = hc_push_str(out, "    add.s32 %r21, %r21, 2;\n    setp.lt.u32 %p1, %r21, 512;\n    @%p1 bra $ZERO;\n")
    var k: i64 = 0
    while k < 8 {
        var j: i64 = 0
        while j < 8 {
            let i = k ^ j
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd4+")
            out = hc_push_str(out, i64_to_string(i * 4))
            out = hc_push_str(out, "];\n")
            if hmma_left_mul_sign(k, j) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r18+")
            out = hc_push_str(out, i64_to_string((k * 16 + j) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            j = j + 1
        }
        k = k + 1
    }
    var kk: i64 = 0
    while kk < 8 {
        var ii: i64 = 0
        while ii < 8 {
            let jj = kk ^ ii
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd5+")
            out = hc_push_str(out, i64_to_string(jj * 4))
            out = hc_push_str(out, "];\n")
            if hmma_right_mul_sign(kk, ii) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r19+")
            out = hc_push_str(out, i64_to_string((kk * 16 + ii) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            ii = ii + 1
        }
        kk = kk + 1
    }
    out = hc_push_str(out, "$BUILD_DONE:\n    bar.sync 0;\n    mov.b32 %r1, 16;\n    mov.f32 %f0, 0f00000000;\n")
    // T1 = R·L
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    wmma.load.b.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.mma.sync.aligned.row.row.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    // T2 = L·R
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.load.b.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    wmma.mma.sync.aligned.row.row.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 10, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    // M = T1 - T2
    var e: i64 = 0
    while e < 8 {
        out = hc_push_str(out, "    sub.f32 %f")
        out = hc_push_str(out, i64_to_string(18 + e))
        out = hc_push_str(out, ", %f")
        out = hc_push_str(out, i64_to_string(2 + e))
        out = hc_push_str(out, ", %f")
        out = hc_push_str(out, i64_to_string(10 + e))
        out = hc_push_str(out, ";\n")
        e = e + 1
    }
    out = hc_push_str(out, "    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ")
    out = hmma_emit_frag_list(out, "%f", 18, 8)
    out = hc_push_str(out, ", %r1;\n    ret;\n}\n")
    out
}

// ============================================================================
// Sedenion ASSOCIATOR on tensor cores — richest algebra (non-assoc + zero divisors)
// ============================================================================

// Sedenion right-multiply matrix sign: R(c)[k][i] = σ(i, k⊕i, 4) · c[k⊕i].
fn hmma_sed_right_mul_sign(k: i64, i: i64) -> i64 { hmma_oct_cd_sigma(i, k ^ i, 4) }

// Emits sounio_sed_associator(a,c,out): [a,b,c]=M·b, M=R(c)·L(a)−L(a)·R(c). For sedenions L(a),R(c)
// are 16×16 = EXACTLY one wmma tile (no padding). Thread 0 builds L(a),R(c) (compile-time σ, bits=4),
// bar.sync; two wmma m16n16k16 matmuls (R·L, L·R, row.row) + 8 sub.f32 → M. HARDWARE-VALIDATED on the
// DGX Spark (GB10, sm_121, CUDA 13.0): the emitted PTX ptxas-assembles (14584-byte cubin), launches,
// and reproduces the 1848 non-associative sedenion basis triples (1527 zero + 1848 nonzero = 15³) +
// the associator-norm dichotomy ‖·‖∈{0,2} on the Blackwell tensor cores. Reference: docs/gpu/sed_assoc_tc.cu.
pub fn hmma_emit_sed_associator_kernel(s: HypercomplexPtxState) -> HypercomplexPtxState with Mut, Panic, Div, Alloc {
    var out = hc_push_str(s, ".version 9.0\n.target sm_121\n.address_size 64\n\n")
    out = hc_push_str(out, ".visible .entry sounio_sed_associator(\n")
    out = hc_push_str(out, "    .param .u64 .ptr .align 4 p_a,\n    .param .u64 .ptr .align 4 p_c,\n    .param .u64 .ptr .align 4 p_out\n)\n{\n")
    out = hc_push_str(out, "    .reg .pred %p<2>;\n    .reg .b16 %rs<2>;\n    .reg .b32 %r<24>;\n    .reg .b32 %f<28>;\n    .reg .b64 %rd<7>;\n")
    out = hc_push_str(out, "    .shared .align 2 .b8 sL[512];\n    .shared .align 2 .b8 sR[512];\n")
    out = hc_push_str(out, "    ld.param.u64 %rd1, [p_a];\n    ld.param.u64 %rd2, [p_c];\n    ld.param.u64 %rd3, [p_out];\n")
    out = hc_push_str(out, "    cvta.to.global.u64 %rd4, %rd1;\n    cvta.to.global.u64 %rd5, %rd2;\n    cvta.to.global.u64 %rd6, %rd3;\n")
    out = hc_push_str(out, "    mov.u32 %r18, sL;\n    mov.u32 %r19, sR;\n")
    out = hc_push_str(out, "    mov.u32 %r1, %tid.x;\n    setp.ne.u32 %p1, %r1, 0;\n    @%p1 bra $BUILD_DONE;\n")
    var k: i64 = 0
    while k < 16 {
        var j: i64 = 0
        while j < 16 {
            let i = k ^ j
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd4+")
            out = hc_push_str(out, i64_to_string(i * 4))
            out = hc_push_str(out, "];\n")
            if hmma_sed_left_mul_sign(k, j) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r18+")
            out = hc_push_str(out, i64_to_string((k * 16 + j) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            j = j + 1
        }
        k = k + 1
    }
    var kk: i64 = 0
    while kk < 16 {
        var ii: i64 = 0
        while ii < 16 {
            let jj = kk ^ ii
            out = hc_push_str(out, "    ld.global.f32 %f1, [%rd5+")
            out = hc_push_str(out, i64_to_string(jj * 4))
            out = hc_push_str(out, "];\n")
            if hmma_sed_right_mul_sign(kk, ii) < 0 { out = hc_push_str(out, "    neg.f32 %f1, %f1;\n") }
            out = hc_push_str(out, "    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r19+")
            out = hc_push_str(out, i64_to_string((kk * 16 + ii) * 2))
            out = hc_push_str(out, "], %rs1;\n")
            ii = ii + 1
        }
        kk = kk + 1
    }
    out = hc_push_str(out, "$BUILD_DONE:\n    bar.sync 0;\n    mov.b32 %r1, 16;\n    mov.f32 %f0, 0f00000000;\n")
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    wmma.load.b.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.mma.sync.aligned.row.row.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    out = hc_push_str(out, "    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", [%r18], %r1;\n    wmma.load.b.sync.aligned.row.m16n16k16.shared.f16 ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", [%r19], %r1;\n    wmma.mma.sync.aligned.row.row.m16n16k16.f32.f32 ")
    out = hmma_emit_frag_list(out, "%f", 10, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 2, 8)
    out = hc_push_str(out, ", ")
    out = hmma_emit_frag_list(out, "%r", 10, 8)
    out = hc_push_str(out, ", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    var e: i64 = 0
    while e < 8 {
        out = hc_push_str(out, "    sub.f32 %f")
        out = hc_push_str(out, i64_to_string(18 + e))
        out = hc_push_str(out, ", %f")
        out = hc_push_str(out, i64_to_string(2 + e))
        out = hc_push_str(out, ", %f")
        out = hc_push_str(out, i64_to_string(10 + e))
        out = hc_push_str(out, ";\n")
        e = e + 1
    }
    out = hc_push_str(out, "    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ")
    out = hmma_emit_frag_list(out, "%f", 18, 8)
    out = hc_push_str(out, ", %r1;\n    ret;\n}\n")
    out
}
