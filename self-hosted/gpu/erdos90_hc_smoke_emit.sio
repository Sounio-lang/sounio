fn hc_append_boot_range(start: i64, n: i64) with Mut, Panic {
    var i: i64 = 0
    while i < n {
        hc_push_byte_i64(hc_boot_byte(start + i))
        i = i + 1
    }
}

fn hc_append_hdr_range(start: i64, n: i64) with Mut, Panic {
    var i: i64 = 0
    while i < n {
        hc_push_byte_i64(hc_hdr_byte(start + i))
        i = i + 1
    }
}

fn hc_emit_bootstrap_blob() with Mut, Panic {
    hc_append_boot_range(0, HC_BOOT_LEN)
}

pub fn kaxi_emit_erdos90_hc_smoke_build() with Mut, Panic, Div, Alloc {
    hc_reset()
    HC_SEQ = 0
    hc_emit_header_comments()
    hc_emit_get_tid_line()
    hc_emit_bootstrap_blob()
    HC_SEQ = 8
    hc_one_step(22, 4)
    hc_total_edges(4, 19)
    hc_push_load_imm(20, HC_OUT_OFF, hc_seq())
    hc_append_add(21, 20, 0, hc_seq())
    hc_append_store_global(19, 21, hc_seq())
    hc_append_ret(hc_seq())
    hc_push_byte(10)
    hc_push_ch(59)
    hc_push_ch(32)
    hc_push_ch(101)
    hc_push_ch(110)
    hc_push_ch(100)
    hc_push_byte(10)
}

pub fn kaxi_emit_erdos90_hc_smoke_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    kaxi_emit_erdos90_hc_smoke_build()
    hc_scratch_to_local_buf()
}

pub fn kaxi_hc_smoke_asm_byte_at(i: i64) -> i64 {
    if i >= 0 && i < HC_SCRATCH_LEN {
        return HC_SCRATCH[i as usize] as i64
    }
    if i >= 0 && i < HC_ASM.len {
        return HC_ASM.data[i as usize] as i64
    }
    return 0
}

pub fn kaxi_hc_smoke_asm_len() -> i64 {
    HC_SCRATCH_LEN + HC_ASM.len
}

