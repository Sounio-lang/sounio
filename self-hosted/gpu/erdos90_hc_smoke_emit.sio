pub fn kaxi_hc_smoke_asm_print_stdout() with IO, Mut, Panic, Div, Alloc {
    var i: i64 = 0
    var line: string = ""
    let n = HC_SCRATCH_LEN
    while i < n {
        let ch = HC_SCRATCH[i as usize] as i64
        if ch == 10 {
            println(line)
            line = ""
        } else {
            line = str_concat(line, kaxi_asm_char_to_str(ch))
        }
        i = i + 1
    }
    if str_len(line) > 0 { println(line) }
}

pub fn kaxi_hc_smoke_assemble() -> KaxiTxnStream with Mut, Panic, Div, Alloc {
    var buf = hc_scratch_to_local_buf()
    kaxi_assemble_ref(&!buf)
}