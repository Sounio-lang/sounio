    hc_reset()
    hc_append_boot_range(0, 117)
    hc_append_boot_range(117, HC_BOOT_LEN - 117)
}

pub fn kaxi_emit_erdos90_count_only_build() with Mut, Panic, Div, Alloc {
    hc_reset()
    HC_SEQ = 0
    hc_emit_header_comments()
    hc_emit_bootstrap_blob()
    HC_SEQ = 8
    hc_total_edges(4, 19)
    hc_push_load_imm(20, HC_OUT_OFF, hc_seq())
    hc_append_add(21, 20, 0, hc_seq())
    hc_append_store_global(19, 21, hc_seq())
    hc_append_ret(hc_seq())
}

