    hc_push_load_imm(1, 25, 1)
    hc_push_load_imm(2, 229, 2)
    hc_push_mul_var0(3, 0, 1, 3)
    hc_push_add_var0(4, 2, 3, 4)
    hc_push_load_imm(10, 3, 5)
    hc_append_load_global(11, 10, 6)
    hc_append_add(22, 11, 0, 7)
}

