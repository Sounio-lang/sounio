// gpu::erdos90_hc_smoke_emit — K-AXI emitter for Erdős Option-B parallel HC smoke.
// Uses a module-global KaxiAsmBuf to avoid 2 MiB struct pass-by-value corruption.

use gpu::kaxi_backend::{KaxiAsmBuf, KaxiTxnStream, kaxi_asm_char_to_str, kaxi_asm_new, kaxi_assemble_ref}

let HC_PN: i64 = 25
let HC_STRIDE: i64 = 8
let HC_NBR_OFF: i64 = 29
let HC_MEM_OFF: i64 = 229
let HC_OUT_OFF: i64 = 429
let HC_LCG_MUL: i64 = 16807
let HC_LCG_PRIME: i64 = 2147483647

var HC_ASM: KaxiAsmBuf = kaxi_asm_new()
var HC_SEQ: i64 = 0
// Scratch buffer for emission: 2 MiB KaxiAsmBuf global indexing corrupts past ~128 bytes in large bundles.
var HC_SCRATCH: [i8; 262144] = [0; 262144]
var HC_SCRATCH_LEN: i64 = 0

fn hc_reset() with Mut {
    HC_ASM.len = 0
    HC_SCRATCH_LEN = 0
}

fn hc_scratch_push_byte(c: i64) with Mut, Panic {
    if HC_SCRATCH_LEN >= 0 && HC_SCRATCH_LEN < 262144 {
        HC_SCRATCH[HC_SCRATCH_LEN as usize] = c as i8
        HC_SCRATCH_LEN = HC_SCRATCH_LEN + 1
    }
}

fn hc_scratch_to_local_buf() -> KaxiAsmBuf with Mut, Panic {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    var i: i64 = 0
    while i < HC_SCRATCH_LEN && i < 2097152 {
        buf.data[i as usize] = HC_SCRATCH[i as usize]
        i = i + 1
    }
    buf.len = HC_SCRATCH_LEN
    return buf
}

fn hc_scratch_flush_to_asm() with Mut, Panic {
    HC_ASM = hc_scratch_to_local_buf()
}

fn hc_push_byte(b: i8) with Mut, Panic {
    hc_scratch_push_byte(b as i64)
}

fn hc_push_byte_i64(c: i64) with Mut, Panic {
    hc_scratch_push_byte(c)
}

fn hc_push_u64_dec(n: i64) with Mut, Panic, Div {
    var v = n
    if v < 0 {
        hc_push_ch(45)
        v = 0 - v
    }
    if v < 10 {
        hc_push_ch(48 + v)
        return
    }
    var stack: [i64; 24] = [0; 24]
    var depth: i64 = 0
    while v >= 10 {
        stack[depth as usize] = v % 10
        depth = depth + 1
        v = v / 10
    }
    hc_push_ch(48 + v)
    var d = depth - 1
    while d >= 0 {
        hc_push_ch(48 + stack[d as usize])
        d = d - 1
    }
}

fn hc_push_str(s: string) with Mut, Panic, Div, Alloc {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        hc_push_byte_i64(str_char_at(s, i))
        i = i + 1
    }
}

fn hc_push_ch(c: i64) with Mut, Panic {
    hc_push_byte_i64(c)
}

fn hc_push_comma_r() with Mut, Panic {
    hc_push_ch(44)
    hc_push_ch(32)
    hc_push_ch(114)
}

