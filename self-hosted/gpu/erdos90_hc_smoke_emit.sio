fn hc_seq() -> i64 with Mut {
    let s = HC_SEQ
    HC_SEQ = HC_SEQ + 1
    return s
}

fn hc_mod(dst: i64, src: i64, divisor: i64, q: i64, prod: i64) with Mut, Panic, Div, Alloc {
    hc_push_load_imm(q, divisor, hc_seq())
    hc_append_div( q, src, q, hc_seq())
    hc_push_load_imm(prod, divisor, hc_seq())
    hc_append_mul( prod, q, prod, hc_seq())
    hc_append_sub( dst, src, prod, hc_seq())
}

fn hc_lcg(rng: i64, t: i64, q: i64, prod: i64) with Mut, Panic, Div, Alloc {
    hc_push_load_imm(t, HC_LCG_MUL, hc_seq())
    hc_append_mul( t, rng, t, hc_seq())
    hc_mod(rng, t, HC_LCG_PRIME, q, prod)
}

fn hc_vertex_half_edges(vtx: i64, mem_base: i64, active_pred: i64, half_sum: i64) with Mut, Panic, Div, Alloc {
    var nb: i64 = 0
    while nb < HC_STRIDE {
        hc_push_load_imm(10, HC_NBR_OFF, hc_seq())
        hc_push_load_imm(11, HC_STRIDE, hc_seq())
        hc_append_mul( 12, vtx, 11, hc_seq())
        hc_append_add( 10, 10, 12, hc_seq())
        hc_push_load_imm(11, nb, hc_seq())
        hc_append_add( 10, 10, 11, hc_seq())
        hc_append_load_global( 13, 10, hc_seq())
        hc_append_add( 14, mem_base, 13, hc_seq())
        hc_append_load_global( 15, 14, hc_seq())
        hc_push_load_imm(16, 1, hc_seq())
        hc_append_setp_eq(1, 15, 16, hc_seq())
        hc_push_load_imm(17, 1, hc_seq())
        hc_push_load_imm(18, 0, hc_seq())
        hc_append_selp( 21, 17, 18, 1, hc_seq())
        hc_append_selp( 22, 21, 18, active_pred, hc_seq())
        hc_append_add( half_sum, half_sum, 22, hc_seq())
        nb = nb + 1
    }
}

fn hc_mem_deg(vtx: i64, mem_base: i64, deg_out: i64) with Mut, Panic, Div, Alloc {
    hc_push_load_imm(deg_out, 0, hc_seq())
    var nb: i64 = 0
    while nb < HC_STRIDE {
        hc_push_load_imm(10, HC_NBR_OFF, hc_seq())
        hc_push_load_imm(11, HC_STRIDE, hc_seq())
        hc_append_mul( 12, vtx, 11, hc_seq())
        hc_append_add( 10, 10, 12, hc_seq())
        hc_push_load_imm(11, nb, hc_seq())
        hc_append_add( 10, 10, 11, hc_seq())
        hc_append_load_global( 13, 10, hc_seq())
        hc_append_add( 14, mem_base, 13, hc_seq())
        hc_append_load_global( 15, 14, hc_seq())
        hc_push_load_imm(16, 1, hc_seq())
        hc_append_setp_eq(2, 15, 16, hc_seq())
        hc_push_load_imm(17, 1, hc_seq())
        hc_push_load_imm(18, 0, hc_seq())
        hc_append_selp( 19, 17, 18, 2, hc_seq())
        hc_append_add( deg_out, deg_out, 19, hc_seq())
        nb = nb + 1
    }
}

fn hc_adj(m: i64, c: i64, adj_out: i64) with Mut, Panic, Div, Alloc {
    hc_push_load_imm(adj_out, 0, hc_seq())
    var nb: i64 = 0
    while nb < HC_STRIDE {
        hc_push_load_imm(10, HC_NBR_OFF, hc_seq())
        hc_push_load_imm(11, HC_STRIDE, hc_seq())
        hc_append_mul( 12, m, 11, hc_seq())
        hc_append_add( 10, 10, 12, hc_seq())
        hc_push_load_imm(11, nb, hc_seq())
        hc_append_add( 10, 10, 11, hc_seq())
        hc_append_load_global( 13, 10, hc_seq())
        hc_append_setp_eq(3, 13, c, hc_seq())
        hc_push_load_imm(14, 1, hc_seq())
        hc_append_selp( 15, 14, adj_out, 3, hc_seq())
        hc_append_add( adj_out, adj_out, 15, hc_seq())
        nb = nb + 1
    }
}

fn hc_one_step(rng: i64, mem_base: i64) with Mut, Panic, Div, Alloc {
    hc_lcg(rng, 30, 31, 29)
    hc_mod(23, rng, HC_PN, 31, 30)
    hc_lcg(rng, 30, 31, 29)
    hc_mod(24, rng, HC_PN, 31, 30)
    hc_append_add( 25, mem_base, 23, hc_seq())
    hc_append_load_global( 26, 25, hc_seq())
    hc_append_add( 27, mem_base, 24, hc_seq())
    hc_append_load_global( 28, 27, hc_seq())
    hc_push_load_imm(6, 1, hc_seq())
    hc_push_load_imm(7, 0, hc_seq())
    hc_append_setp_eq(4, 26, 6, hc_seq())
    hc_append_setp_eq(5, 28, 7, hc_seq())
    hc_append_setp_ne(6, 23, 24, hc_seq())
    hc_mem_deg(23, mem_base, 32)
    hc_mem_deg(24, mem_base, 33)
    hc_adj(23, 24, 34)
    hc_append_sub( 35, 33, 34, hc_seq())
    hc_append_sub( 35, 35, 32, hc_seq())
    hc_append_setp_gt(7, 35, 7, hc_seq())
    hc_push_load_imm(36, 1, hc_seq())
    hc_push_load_imm(37, 0, hc_seq())
    hc_append_selp( 38, 36, 37, 4, hc_seq())
    hc_append_selp( 38, 38, 37, 5, hc_seq())
    hc_append_selp( 38, 38, 37, 6, hc_seq())
    hc_append_selp( 38, 38, 37, 7, hc_seq())
    hc_append_setp_ne(38, 38, 37, hc_seq())
    hc_append_selp( 39, 7, 26, 38, hc_seq())
    hc_append_store_global( 39, 25, hc_seq())
    hc_append_selp( 40, 6, 28, 38, hc_seq())
    hc_append_store_global( 40, 27, hc_seq())
}

fn hc_total_edges(mem_base: i64, edges_out: i64) with Mut, Panic, Div, Alloc {
    hc_push_load_imm(edges_out, 0, hc_seq())
    hc_push_load_imm(6, 1, hc_seq())
    var vtx: i64 = 0
    while vtx < HC_PN {
        hc_push_load_imm(7, vtx, hc_seq())
        hc_append_add( 8, mem_base, 7, hc_seq())
        hc_append_load_global( 9, 8, hc_seq())
        hc_append_setp_eq(0, 9, 6, hc_seq())
        hc_vertex_half_edges(7, mem_base, 0, edges_out)
        vtx = vtx + 1
    }
    hc_push_load_imm(18, 2, hc_seq())
    hc_append_div( edges_out, edges_out, 18, hc_seq())
}

