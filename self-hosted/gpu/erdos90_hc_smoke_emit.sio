fn hc_append_add(dst: i64, src_a: i64, src_b: i64, seq: i64) with Mut, Panic, Div, Alloc {
    hc_push_tok_add_r()
    hc_push_u64_dec(dst)
    hc_push_comma_r()
    hc_push_u64_dec(src_a)
    hc_push_comma_r()
    hc_push_u64_dec(src_b)
    hc_push_var125()
    hc_push_u64_dec(seq)
    hc_push_byte(10)
}

