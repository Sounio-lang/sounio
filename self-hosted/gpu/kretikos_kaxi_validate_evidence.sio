// self-hosted/gpu/kretikos_kaxi_validate_evidence.sio
//
// Pure-Sounio JSON evidence validator for kretikos certificates.
// Replaces embedded `python3 -c json.loads(...)` heredocs in CI gates.
//
// Usage:
//   driver.elf <file.json> [--expect PATH=VALUE]...
//
// PATH is a dotted key path (e.g. "lowering.profile_hint" or
// "kaxi.epistemic_lanes.store_global_count"). Each segment must
// resolve to a JSON object key in the corresponding object span;
// the final segment names the leaf value.
//
// Spec forms (operator detected in priority order):
//   PATH>=N    — leaf must be a JSON number with value >= N (integer)
//   PATH=true  — leaf must be the JSON literal true
//   PATH=false — leaf must be the JSON literal false
//   PATH=null  — leaf must be the JSON literal null
//   PATH=N     — leaf is a JSON number, integer-equal to N (when expected
//                value parses as integer); otherwise leaf is a string
//                whose body equals VALUE (no surrounding quotes in spec)
//
// The scanner is JSON-aware enough to skip over string literals (so
// braces inside strings don't fool brace-counting) and to walk past
// nested objects without confusing keys. It does NOT validate full
// JSON syntax — it trusts that the input is well-formed (the
// certificates are machine-generated by sounio drivers).
//
// Exit codes: 0 = all checks passed, 1 = at least one failure,
//             2 = malformed argv / cannot read file.

use gpu::kaxi_backend::*

// File buffer: certificates today are <16KB; size to 256KB for headroom.
struct EvidenceBuf {
    data: [i8; 262144],
    len: i64,
}

fn ev_load(path: string) -> EvidenceBuf with IO, Mut, Panic, Div, Alloc {
    var buf = EvidenceBuf { data: [0; 262144], len: 0 }
    let size = file_size(path)
    if size <= 0 { return buf }
    let bytes = read_file(path)
    let cap: i64 = if size > 262144 { 262144 } else { size }
    var i: i64 = 0
    while i < cap {
        buf.data[i as usize] = bytes[i as usize] as i8
        i = i + 1
    }
    buf.len = cap
    buf
}

// True if buf[pos..] starts with literal s (s is a Sounio string).
fn ev_match_at(buf: &EvidenceBuf, pos: i64, s: string) -> bool with Mut, Panic, Div {
    let n = str_len(s)
    if pos + n > buf.len { return false }
    var i: i64 = 0
    while i < n {
        if buf.data[(pos + i) as usize] != str_char_at(s, i) { return false }
        i = i + 1
    }
    true
}

// Skip one well-formed string literal starting at pos (pos points at
// the opening '"'). Returns position after the closing '"', or -1 on
// truncation.
fn ev_skip_string(buf: &EvidenceBuf, pos: i64) -> i64 with Mut, Panic, Div {
    var p = pos + 1
    while p < buf.len {
        let c = buf.data[p as usize]
        if c == 92 {                 // '\\' — skip escape pair
            p = p + 2
        } else if c == 34 {          // '"' — closing
            return p + 1
        } else {
            p = p + 1
        }
    }
    0 - 1
}

// Find the matching close brace for an open brace at `open_pos`.
// Tracks nested {/[ and skips string literals. Returns position of
// the matching '}' or -1 if not found within buf.len.
fn ev_match_brace(buf: &EvidenceBuf, open_pos: i64) -> i64 with Mut, Panic, Div {
    var p = open_pos + 1
    var depth: i64 = 1
    while p < buf.len {
        let c = buf.data[p as usize]
        if c == 34 {                 // string literal
            let np = ev_skip_string(buf, p)
            if np < 0 { return 0 - 1 }
            p = np
        } else if c == 123 || c == 91 {  // '{' or '['
            depth = depth + 1
            p = p + 1
        } else if c == 125 || c == 93 {  // '}' or ']'
            depth = depth - 1
            if depth == 0 { return p }
            p = p + 1
        } else {
            p = p + 1
        }
    }
    0 - 1
}

// Skip whitespace forward starting at pos.
fn ev_skip_ws(buf: &EvidenceBuf, pos: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    while p < buf.len {
        let c = buf.data[p as usize]
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p = p + 1
        } else {
            return p
        }
    }
    p
}

// Inside the JSON object spanning (open_pos+1 .. close_pos-1), find
// the value position for `"key":<...>` at top level (depth 0). Returns
// the position of the first non-whitespace byte of the value, or -1.
fn ev_find_key_value(buf: &EvidenceBuf, open_pos: i64, close_pos: i64, key: string) -> i64 with Mut, Panic, Div {
    let klen = str_len(key)
    var p = open_pos + 1
    while p < close_pos {
        let c = buf.data[p as usize]
        if c == 34 {                 // string — could be a key
            // Try matching key body: buf[p+1 .. p+1+klen] == key, then '"'.
            if p + 1 + klen + 1 <= buf.len {
                var matched = true
                if buf.data[(p + 1 + klen) as usize] != 34 { matched = false }
                var ki: i64 = 0
                while matched && ki < klen {
                    if buf.data[(p + 1 + ki) as usize] != str_char_at(key, ki) {
                        matched = false
                    }
                    ki = ki + 1
                }
                if matched {
                    // Past closing quote, skip ws + ':' + ws. If no colon
                    // follows, this string is a VALUE (e.g. "runtime_backed"
                    // appearing as the body of {"profile_kind":"runtime_backed"})
                    // not a KEY — fall through and skip past it instead of
                    // erroring out, so the walker can continue scanning for
                    // the real key.
                    var q = p + 1 + klen + 1
                    q = ev_skip_ws(buf, q)
                    if q < close_pos && buf.data[q as usize] == 58 {
                        q = ev_skip_ws(buf, q + 1)
                        if q >= close_pos { return 0 - 1 }
                        return q
                    }
                    // Else: matched body but no ':' — keep scanning.
                }
            }
            // Skip the string regardless.
            let np = ev_skip_string(buf, p)
            if np < 0 { return 0 - 1 }
            p = np
        } else if c == 123 || c == 91 {  // skip nested object/array
            let close = ev_match_brace(buf, p)
            if close < 0 { return 0 - 1 }
            p = close + 1
        } else {
            p = p + 1
        }
    }
    0 - 1
}

// Walk a dotted path. Each non-final segment must resolve to an
// object value; the final segment yields the leaf value position.
// Returns leaf position, or -1 if the path doesn't resolve.
fn ev_walk_path(buf: &EvidenceBuf, path: string) -> i64 with Mut, Panic, Div {
    // Find the document-level open '{'.
    var doc_open: i64 = 0 - 1
    var p: i64 = 0
    while p < buf.len {
        if buf.data[p as usize] == 123 { doc_open = p; break }
        p = p + 1
    }
    if doc_open < 0 { return 0 - 1 }
    let doc_close = ev_match_brace(buf, doc_open)
    if doc_close < 0 { return 0 - 1 }

    let plen = str_len(path)
    var open_pos = doc_open
    var close_pos = doc_close
    var seg_start: i64 = 0
    var i: i64 = 0
    while i <= plen {
        let at_end = i == plen
        let is_dot = !at_end && str_char_at(path, i) == 46
        if at_end || is_dot {
            // Build segment string by char comparison via index range.
            // We need to pass a slice to ev_find_key_value; instead
            // inline a per-segment matcher by re-implementing here.
            let seg_len = i - seg_start
            // Search for a key whose bytes match path[seg_start..i].
            let leaf_or_obj = ev_find_segment_value(buf, open_pos, close_pos, path, seg_start, seg_len)
            if leaf_or_obj < 0 { return 0 - 1 }
            if at_end {
                return leaf_or_obj
            }
            // Otherwise the value must be an object — narrow span.
            if buf.data[leaf_or_obj as usize] != 123 { return 0 - 1 }
            let new_close = ev_match_brace(buf, leaf_or_obj)
            if new_close < 0 { return 0 - 1 }
            open_pos = leaf_or_obj
            close_pos = new_close
            seg_start = i + 1
        }
        i = i + 1
    }
    0 - 1
}

// Like ev_find_key_value but the key is a slice of `path` rather than
// a standalone string. (Sounio strings can't be sub-sliced cheaply, so
// we compare byte-by-byte against path[seg_start..seg_start+seg_len].)
fn ev_find_segment_value(buf: &EvidenceBuf, open_pos: i64, close_pos: i64,
                         path: string, seg_start: i64, seg_len: i64) -> i64 with Mut, Panic, Div {
    var p = open_pos + 1
    while p < close_pos {
        let c = buf.data[p as usize]
        if c == 34 {
            if p + 1 + seg_len + 1 <= buf.len {
                var matched = true
                if buf.data[(p + 1 + seg_len) as usize] != 34 { matched = false }
                var ki: i64 = 0
                while matched && ki < seg_len {
                    if buf.data[(p + 1 + ki) as usize] != str_char_at(path, seg_start + ki) {
                        matched = false
                    }
                    ki = ki + 1
                }
                if matched {
                    // If no ':' follows, this is a value not a key — keep scanning.
                    var q = p + 1 + seg_len + 1
                    q = ev_skip_ws(buf, q)
                    if q < close_pos && buf.data[q as usize] == 58 {
                        q = ev_skip_ws(buf, q + 1)
                        if q >= close_pos { return 0 - 1 }
                        return q
                    }
                }
            }
            let np = ev_skip_string(buf, p)
            if np < 0 { return 0 - 1 }
            p = np
        } else if c == 123 || c == 91 {
            let close = ev_match_brace(buf, p)
            if close < 0 { return 0 - 1 }
            p = close + 1
        } else {
            p = p + 1
        }
    }
    0 - 1
}

// Read an integer from buf starting at pos. Returns (value, new_pos).
struct IntScan { value: i64, new_pos: i64, ok: bool }

fn ev_scan_int(buf: &EvidenceBuf, pos: i64) -> IntScan with Mut, Panic, Div {
    var p = pos
    var neg = false
    if p < buf.len && buf.data[p as usize] == 45 { neg = true; p = p + 1 }
    var val: i64 = 0
    var any = false
    while p < buf.len {
        let c = buf.data[p as usize]
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48) as i64
            any = true
            p = p + 1
        } else {
            break
        }
    }
    if neg { val = 0 - val }
    IntScan { value: val, new_pos: p, ok: any }
}

// Read an integer from a Sounio string. Returns (value, ok).
struct IntFromStr { value: i64, ok: bool }

fn ev_str_to_int(s: string) -> IntFromStr with Mut, Panic, Div {
    let n = str_len(s)
    if n == 0 { return IntFromStr { value: 0, ok: false } }
    var i: i64 = 0
    var neg = false
    if str_char_at(s, 0) == 45 { neg = true; i = 1 }
    if i >= n { return IntFromStr { value: 0, ok: false } }
    var val: i64 = 0
    while i < n {
        let c = str_char_at(s, i)
        if c < 48 || c > 57 { return IntFromStr { value: 0, ok: false } }
        val = val * 10 + (c - 48) as i64
        i = i + 1
    }
    if neg { val = 0 - val }
    IntFromStr { value: val, ok: true }
}

// Compare a JSON string-literal at `pos` (must point at '"') to
// the Sounio string `expected` between [exp_start, exp_start+exp_len).
fn ev_str_eq_at(buf: &EvidenceBuf, pos: i64, expected: string, exp_start: i64, exp_len: i64) -> bool with Mut, Panic, Div {
    if pos >= buf.len { return false }
    if buf.data[pos as usize] != 34 { return false }
    var p = pos + 1
    var i: i64 = 0
    while p < buf.len && i < exp_len {
        let c = buf.data[p as usize]
        if c == 34 { return false }       // closes early
        if c == 92 { return false }       // escape — not handling for evidence keys
        if c != str_char_at(expected, exp_start + i) { return false }
        p = p + 1
        i = i + 1
    }
    if i != exp_len { return false }
    if p >= buf.len { return false }
    buf.data[p as usize] == 34
}

// Find operator in spec. Returns (op_pos, op_len) where op encodes:
// 1 = '>=', 2 = '='. Returns (-1, 0) if no operator.
struct OpScan { op: i64, op_pos: i64, op_len: i64 }

fn ev_find_op(spec: string) -> OpScan with Mut, Panic, Div {
    let n = str_len(spec)
    var i: i64 = 0
    while i < n {
        let c = str_char_at(spec, i)
        if c == 62 && i + 1 < n && str_char_at(spec, i + 1) == 61 {
            return OpScan { op: 1, op_pos: i, op_len: 2 }
        }
        if c == 61 {
            return OpScan { op: 2, op_pos: i, op_len: 1 }
        }
        i = i + 1
    }
    OpScan { op: 0 - 1, op_pos: 0 - 1, op_len: 0 }
}

// One spec check. Prints a one-line diagnostic on failure.
fn ev_check_one(buf: &EvidenceBuf, spec: string) -> bool with IO, Mut, Panic, Div, Alloc {
    let opc = ev_find_op(spec)
    if opc.op < 0 {
        print("validate-evidence: bad spec (no operator): ")
        println(spec)
        return false
    }

    let leaf = ev_walk_path_prefix(buf, spec, opc.op_pos)
    if leaf < 0 {
        print("validate-evidence: PATH NOT FOUND: ")
        println(spec)
        return false
    }

    let exp_start = opc.op_pos + opc.op_len
    let exp_len = str_len(spec) - exp_start

    if opc.op == 1 {
        // PATH>=int : leaf must be a JSON number >= expected.
        let expected = ev_str_slice_to_int(spec, exp_start, exp_len)
        if !expected.ok {
            print("validate-evidence: bad >= integer in spec: ")
            println(spec)
            return false
        }
        let scan = ev_scan_int(buf, leaf)
        if !scan.ok {
            print("validate-evidence: leaf not numeric for >=: ")
            println(spec)
            return false
        }
        if scan.value < expected.value {
            print("validate-evidence: ")
            print(spec)
            print(" — got ")
            ev_print_i64(scan.value)
            print(" want >= ")
            ev_print_i64(expected.value)
            println("")
            return false
        }
        return true
    }

    // opc.op equals 2 means assign opcode -- string integer true false null or any:set
    //
    // any:val1|val2|val3 — leaf matches one of pipe-separated values
    // (each chunk is compared as a string body or as integer).
    if exp_len > 4 && ev_lit_eq(spec, exp_start, "any:") {
        let set_start = exp_start + 4
        let set_len = exp_len - 4
        var chunk_start: i64 = set_start
        var i_set: i64 = 0
        while i_set <= set_len {
            let at_end = i_set == set_len
            let is_pipe = !at_end && str_char_at(spec, set_start + i_set) == 124
            if at_end || is_pipe {
                let chunk_off = chunk_start
                let chunk_len = (set_start + i_set) - chunk_start
                if ev_chunk_matches_leaf(buf, leaf, spec, chunk_off, chunk_len) {
                    return true
                }
                chunk_start = set_start + i_set + 1
            }
            i_set = i_set + 1
        }
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }

    if exp_len == 4 && ev_lit_eq(spec, exp_start, "true") {
        if buf.data[leaf as usize] == 116 && ev_match_at(buf, leaf, "true") { return true }
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }
    if exp_len == 5 && ev_lit_eq(spec, exp_start, "false") {
        if buf.data[leaf as usize] == 102 && ev_match_at(buf, leaf, "false") { return true }
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }
    if exp_len == 4 && ev_lit_eq(spec, exp_start, "null") {
        if buf.data[leaf as usize] == 110 && ev_match_at(buf, leaf, "null") { return true }
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }

    // Try integer compare first (if expected parses as integer and leaf
    // is a JSON number).
    let as_int = ev_str_slice_to_int(spec, exp_start, exp_len)
    let leaf_byte = buf.data[leaf as usize]
    if as_int.ok && leaf_byte != 34 {
        let scan = ev_scan_int(buf, leaf)
        if scan.ok && scan.value == as_int.value { return true }
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }

    // String compare.
    if leaf_byte != 34 {
        ev_emit_mismatch(spec, buf, leaf)
        return false
    }
    if ev_str_eq_at(buf, leaf, spec, exp_start, exp_len) { return true }
    ev_emit_mismatch(spec, buf, leaf)
    false
}

// Walk path encoded in spec[0..path_end].
fn ev_walk_path_prefix(buf: &EvidenceBuf, spec: string, path_end: i64) -> i64 with Mut, Panic, Div {
    var doc_open: i64 = 0 - 1
    var p: i64 = 0
    while p < buf.len {
        if buf.data[p as usize] == 123 { doc_open = p; break }
        p = p + 1
    }
    if doc_open < 0 { return 0 - 1 }
    let doc_close = ev_match_brace(buf, doc_open)
    if doc_close < 0 { return 0 - 1 }

    var open_pos = doc_open
    var close_pos = doc_close
    var seg_start: i64 = 0
    var i: i64 = 0
    while i <= path_end {
        let at_end = i == path_end
        let is_dot = !at_end && str_char_at(spec, i) == 46
        if at_end || is_dot {
            let seg_len = i - seg_start
            let leaf_or_obj = ev_find_segment_value(buf, open_pos, close_pos, spec, seg_start, seg_len)
            if leaf_or_obj < 0 { return 0 - 1 }
            if at_end { return leaf_or_obj }
            if buf.data[leaf_or_obj as usize] != 123 { return 0 - 1 }
            let new_close = ev_match_brace(buf, leaf_or_obj)
            if new_close < 0 { return 0 - 1 }
            open_pos = leaf_or_obj
            close_pos = new_close
            seg_start = i + 1
        }
        i = i + 1
    }
    0 - 1
}

// True if `leaf` matches the chunk at spec[chunk_off..chunk_off+chunk_len].
// Chunk is treated as: integer if it parses as int and leaf is JSON number;
// otherwise as a string body compared against leaf JSON string.
fn ev_chunk_matches_leaf(buf: &EvidenceBuf, leaf: i64,
                         spec: string, chunk_off: i64, chunk_len: i64) -> bool with Mut, Panic, Div {
    let leaf_byte = buf.data[leaf as usize]
    let as_int = ev_str_slice_to_int(spec, chunk_off, chunk_len)
    if as_int.ok && leaf_byte != 34 {
        let scan = ev_scan_int(buf, leaf)
        if scan.ok && scan.value == as_int.value { return true }
        return false
    }
    if leaf_byte != 34 { return false }
    ev_str_eq_at(buf, leaf, spec, chunk_off, chunk_len)
}

// Print the JSON leaf value at path `path` to stdout. Strings are printed
// without surrounding quotes (so shell can capture them directly).
// Returns true if path resolved.
fn ev_print_one(buf: &EvidenceBuf, path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    let plen = str_len(path)
    let leaf = ev_walk_path_prefix(buf, path, plen)
    if leaf < 0 { return false }
    let c = buf.data[leaf as usize]
    var asm = kaxi_asm_new()
    if c == 34 {
        // String: print body bytes between quotes (no escape decoding for now).
        var p = leaf + 1
        while p < buf.len {
            let b = buf.data[p as usize]
            if b == 34 { break }
            if b == 92 {
                // Pass-through escape pair raw — adequate for evidence-stage paths.
                if p + 1 < buf.len {
                    asm = kaxi_asm_push_byte(asm, buf.data[(p + 1) as usize])
                    p = p + 2
                } else { p = p + 1 }
            } else {
                asm = kaxi_asm_push_byte(asm, b)
                p = p + 1
            }
        }
    } else if c == 116 || c == 102 || c == 110 {
        // true / false / null literal — print first 4 or 5 bytes verbatim.
        let n: i64 = if c == 102 { 5 } else { 4 }
        var i: i64 = 0
        while i < n && (leaf + i) < buf.len {
            asm = kaxi_asm_push_byte(asm, buf.data[(leaf + i) as usize])
            i = i + 1
        }
    } else {
        // Number / bare value — copy bytes until terminator.
        var p = leaf
        while p < buf.len {
            let b = buf.data[p as usize]
            if b == 44 || b == 125 || b == 93 || b == 32 || b == 10 || b == 13 || b == 9 { break }
            asm = kaxi_asm_push_byte(asm, b)
            p = p + 1
        }
    }
    let s = kaxi_asm_to_string(asm)
    print(s)
    println("")
    true
}

// Print the JSON value at `path` verbatim (object/array/string/number/
// literal). Used to embed sub-trees of one JSON document inside a
// larger one composed by `kretikos json-emit --raw-json`. Returns true
// if path resolved.
fn ev_print_subtree(buf: &EvidenceBuf, path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    let plen = str_len(path)
    let leaf = ev_walk_path_prefix(buf, path, plen)
    if leaf < 0 { return false }
    let c = buf.data[leaf as usize]
    var end: i64 = leaf
    if c == 123 || c == 91 {
        let m = ev_match_brace(buf, leaf)
        if m < 0 { return false }
        end = m
    } else if c == 34 {
        let after = ev_skip_string(buf, leaf)
        if after < 0 { return false }
        end = after - 1
    } else {
        var p = leaf
        while p < buf.len {
            let b = buf.data[p as usize]
            if b == 44 || b == 125 || b == 93 || b == 32 || b == 10 || b == 13 || b == 9 { break }
            p = p + 1
        }
        end = p - 1
    }
    var asm = kaxi_asm_new()
    var i = leaf
    while i <= end {
        asm = kaxi_asm_push_byte(asm, buf.data[i as usize])
        i = i + 1
    }
    print(kaxi_asm_to_string(asm))
    println("")
    true
}

fn ev_lit_eq(spec: string, start: i64, lit: string) -> bool with Mut, Panic, Div {
    let n = str_len(lit)
    var i: i64 = 0
    while i < n {
        if str_char_at(spec, start + i) != str_char_at(lit, i) { return false }
        i = i + 1
    }
    true
}

fn ev_str_slice_to_int(spec: string, start: i64, len: i64) -> IntFromStr with Mut, Panic, Div {
    if len == 0 { return IntFromStr { value: 0, ok: false } }
    var i: i64 = 0
    var neg = false
    if str_char_at(spec, start) == 45 { neg = true; i = 1 }
    if i >= len { return IntFromStr { value: 0, ok: false } }
    var val: i64 = 0
    while i < len {
        let c = str_char_at(spec, start + i)
        if c < 48 || c > 57 { return IntFromStr { value: 0, ok: false } }
        val = val * 10 + (c - 48) as i64
        i = i + 1
    }
    if neg { val = 0 - val }
    IntFromStr { value: val, ok: true }
}

// Decimal print via KaxiAsmBuf as a tiny char buffer.
fn ev_print_i64(n: i64) with IO, Mut, Panic, Div, Alloc {
    var asm = kaxi_asm_new()
    if n == 0 {
        asm = kaxi_asm_push_byte(asm, 48 as i8)
        let s = kaxi_asm_to_string(asm)
        print(s)
        return
    }
    var v = n
    var neg = false
    if v < 0 { neg = true; v = 0 - v }
    var digits: [i8; 24] = [0; 24]
    var count: i64 = 0
    while v > 0 {
        digits[count as usize] = (48 + (v - (v / 10) * 10)) as i8
        v = v / 10
        count = count + 1
    }
    if neg { asm = kaxi_asm_push_byte(asm, 45 as i8) }
    var i = count - 1
    while i >= 0 {
        asm = kaxi_asm_push_byte(asm, digits[i as usize])
        i = i - 1
    }
    let s = kaxi_asm_to_string(asm)
    print(s)
}

fn ev_emit_mismatch(spec: string, buf: &EvidenceBuf, leaf: i64) with IO, Mut, Panic, Div, Alloc {
    print("validate-evidence: mismatch ")
    print(spec)
    print(" — leaf at offset ")
    ev_print_i64(leaf)
    print(" begins '")
    var asm = kaxi_asm_new()
    var i: i64 = 0
    while i < 24 && (leaf + i) < buf.len {
        let c = buf.data[(leaf + i) as usize]
        if c == 10 || c == 13 { break }
        asm = kaxi_asm_push_byte(asm, c)
        i = i + 1
    }
    let s = kaxi_asm_to_string(asm)
    print(s)
    println("'")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("usage: kretikos_kaxi_validate_evidence <file.json> [--expect PATH=VAL]...")
        return 2
    }
    let path = get_arg(0)
    let buf = ev_load(path)
    if buf.len <= 0 {
        print("validate-evidence: cannot read file ")
        println(path)
        return 1
    }

    var i: i64 = 1
    var fail: i64 = 0
    var checked: i64 = 0
    while i < argc {
        let a = get_arg(i)
        if str_eq(a, "--expect") {
            if i + 1 >= argc {
                println("validate-evidence: --expect requires PATH=VAL")
                return 2
            }
            let spec = get_arg(i + 1)
            let ok = ev_check_one(&buf, spec)
            if !ok { fail = fail + 1 }
            checked = checked + 1
            i = i + 2
        } else if str_eq(a, "--print") {
            if i + 1 >= argc {
                println("validate-evidence: --print requires PATH")
                return 2
            }
            let p = get_arg(i + 1)
            if !ev_print_one(&buf, p) {
                print("validate-evidence: PATH NOT FOUND: ")
                println(p)
                return 1
            }
            i = i + 2
        } else if str_eq(a, "--print-or-empty") {
            if i + 1 >= argc {
                println("validate-evidence: --print-or-empty requires PATH")
                return 2
            }
            let p = get_arg(i + 1)
            if !ev_print_one(&buf, p) {
                println("")
            }
            i = i + 2
        } else if str_eq(a, "--print-subtree") {
            if i + 1 >= argc {
                println("validate-evidence: --print-subtree requires PATH")
                return 2
            }
            let p = get_arg(i + 1)
            if !ev_print_subtree(&buf, p) {
                print("validate-evidence: PATH NOT FOUND: ")
                println(p)
                return 1
            }
            i = i + 2
        } else if str_eq(a, "--print-subtree-or") {
            // --print-subtree-or PATH FALLBACK_JSON: print subtree at PATH
            // or FALLBACK_JSON if PATH is missing. Useful for embedding
            // optional sub-objects.
            if i + 2 >= argc {
                println("validate-evidence: --print-subtree-or requires PATH FALLBACK")
                return 2
            }
            let p = get_arg(i + 1)
            let fallback = get_arg(i + 2)
            if !ev_print_subtree(&buf, p) {
                println(fallback)
            }
            i = i + 3
        } else {
            print("validate-evidence: unknown argument ")
            println(a)
            return 2
        }
    }

    if fail > 0 {
        print("validate-evidence: FAIL ")
        ev_print_i64(fail)
        print("/")
        ev_print_i64(checked)
        println(" checks failed")
        return 1
    }
    if checked > 0 {
        print("validate-evidence: PASS ")
        ev_print_i64(checked)
        println(" checks")
    }
    0
}
