// self-hosted/gpu/pbpk28_mc_kernel.sio
// PBPK-28 GPU population-MC kernel: MRG32k3a substream draws.
//
// Scope: exact host-side draws plus the device advance step emitted
// as K-AXI. One stream per draw: stream k starts from
// next_substream applied k times to the package seed, then advances
// one next_u01 step per uniform. The normal draw uses a single polar
// attempt (fail-closed: rejection returns ok=false and the host
// retries with the next substream, same distribution). Lognormal
// follows mc28_lognormal_from_z exactly (mean<=0 returns mean,
// variance<=0 returns mean).
//
// Staging: the device advance step uses the untyped integer path
// (exact i64 in the K-AXI sim); the u01 float combination
// (z as f64 times norm) and the polar/lognormal transform stay
// host-side, bit-exact with the CPU reference. The mod corrections
// are branchless trunc-division identities (Sounio div truncates,
// same as the reference): with p in (-m, m),
//   k = (p - m + 1) / m  is -1 for p < 0 else 0,
//   p - k * m            is the corrected residue;
// with diff = p1 - p2,
//   z = diff + ((m1 - diff) / m1) * m1.

use gpu::kaxi_backend::*
use random::mrg32k3a::*
use math::pure::{sqrt, ln, exp, is_finite}

pub struct McDrawOut {
    pub value: f64,
    pub ok: bool,
}

// Substream start: apply next_substream draw_idx times to seed.
pub fn pbpk28_mc_substream_start(seed: Mrg32k3aState, draw_idx: i64) -> Mrg32k3aState with Mut, Div {
    var st = seed
    var k: i64 = 0
    while k < draw_idx {
        st = mrg32k3a_next_substream(st)
        k = k + 1
    }
    st
}

// One uniform from substream draw_idx (fail-closed on bad index).
pub fn pbpk28_mc_substream_u01(seed: Mrg32k3aState, draw_idx: i64) -> (f64, Mrg32k3aState, bool) with Mut, Div {
    if draw_idx < 0 {
        return (0.0, seed, false)
    }
    let st = pbpk28_mc_substream_start(seed, draw_idx)
    let r = mrg32k3a_next_u01(st)
    (r.0, r.1, true)
}

// Single polar attempt: z from (u1, u2), ok=false on rejection.
pub fn pbpk28_mc_normal_from_u01(u1: f64, u2: f64) -> McDrawOut with Mut, Div, Panic {
    if !is_finite(u1) { return McDrawOut { value: 0.0, ok: false } }
    if !is_finite(u2) { return McDrawOut { value: 0.0, ok: false } }
    let v1 = u1 * 2.0 - 1.0
    let v2 = u2 * 2.0 - 1.0
    let s = v1 * v1 + v2 * v2
    if s >= 1.0 { return McDrawOut { value: 0.0, ok: false } }
    if s <= 0.0 { return McDrawOut { value: 0.0, ok: false } }
    McDrawOut { value: v1 * sqrt(0.0 - 2.0 * ln(s) / s), ok: true }
}

// Exact port of mc28_lognormal_from_z.
pub fn pbpk28_mc_lognormal_from_z(mean: f64, variance: f64, z: f64) -> McDrawOut with Mut, Div, Panic {
    if mean <= 0.0 { return McDrawOut { value: mean, ok: true } }
    if variance <= 0.0 { return McDrawOut { value: mean, ok: true } }
    if !is_finite(z) { return McDrawOut { value: 0.0, ok: false } }
    let cv2 = variance / (mean * mean)
    let sig2_log = ln(1.0 + cv2)
    let sig_log = sqrt(sig2_log)
    let mu_log = ln(mean) - 0.5 * sig2_log
    McDrawOut { value: exp(mu_log + sig_log * z), ok: true }
}

// Device kernel: one MRG32k3a advance step per thread, integer path.
// Per-thread state at mem[tid*9 .. tid*9+6), z out at mem[tid*9+6].
// Registers: r0=tid, r1=9, r2=base, r3=0, r4=1, r5..r8 mults,
// r9=m1, r10=m2, r11..r16 state s0..s5, r17 addr tmp,
// r18.. temporaries, r29 out addr, r30 z.
pub fn kaxi_emit_pbpk28_mc_advance_asm(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var text = "; K-AXI epistemic kernel assembly
; Auto-generated by gpu_lower_to_kaxi()

"
    var seq: i64 = 0
    text = mc_load_imm(text, 0, 256, seq); seq = seq + 1
    text = mc_load_imm(text, 1, 0, seq); seq = seq + 1
    text = mc_load_32(text, 5, 18, 0, 21, 27324, seq); seq = seq + 5
    text = mc_load_32(text, 6, 18, 0, 12, 24296, seq); seq = seq + 5
    text = mc_load_32(text, 7, 18, 0, 8, 3324, seq); seq = seq + 5
    text = mc_load_32(text, 8, 18, 0, 20, 59869, seq); seq = seq + 5
    text = mc_load_32(text, 9, 18, 0, 65535, 65327, seq); seq = seq + 5
    text = mc_load_32(text, 10, 18, 0, 65535, 42683, seq); seq = seq + 5
    text = mc_load_32s(text, 11, 18, 0, s0, seq); seq = seq + 5
    text = mc_load_32s(text, 12, 18, 0, s1, seq); seq = seq + 5
    text = mc_load_32s(text, 13, 18, 0, s2, seq); seq = seq + 5
    text = mc_load_32s(text, 14, 18, 0, s3, seq); seq = seq + 5
    text = mc_load_32s(text, 15, 18, 0, s4, seq); seq = seq + 5
    text = mc_load_32s(text, 16, 18, 0, s5, seq); seq = seq + 5
    text = mc_r3(text, "mul", 19, 5, 12, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "mul", 20, 6, 11, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "sub", 21, 19, 20, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "div", 22, 21, 9, "var=+75.0%", seq); seq = seq + 1
    text = mc_r3(text, "mul", 23, 22, 9, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "sub", 24, 21, 23, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 25, 24, 9, "var=+12.5%", seq); seq = seq + 1
    text = mc_setp(text, "lt", 0, 24, 1, seq); seq = seq + 1
    text = mc_selp(text, 24, 25, 24, 0, seq); seq = seq + 1
    text = mc_r3(text, "mul", 19, 7, 16, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "mul", 20, 8, 14, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "sub", 21, 19, 20, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "div", 22, 21, 10, "var=+75.0%", seq); seq = seq + 1
    text = mc_r3(text, "mul", 23, 22, 10, "var=+62.5%", seq); seq = seq + 1
    text = mc_r3(text, "sub", 26, 21, 23, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 25, 26, 10, "var=+12.5%", seq); seq = seq + 1
    text = mc_setp(text, "lt", 0, 26, 1, seq); seq = seq + 1
    text = mc_selp(text, 26, 25, 26, 0, seq); seq = seq + 1
    text = mc_r3(text, "sub", 27, 24, 26, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 28, 27, 9, "var=+12.5%", seq); seq = seq + 1
    text = mc_setp(text, "gt", 0, 24, 26, seq); seq = seq + 1
    text = mc_selp(text, 30, 27, 28, 0, seq); seq = seq + 1
    text = mc_r3(text, "add", 11, 12, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 12, 13, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 13, 24, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 14, 15, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 15, 16, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_r3(text, "add", 16, 26, 1, "var=+12.5%", seq); seq = seq + 1
    text = mc_load_imm(text, 17, 0, seq); seq = seq + 1
    text = mc_store(text, 11, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 1, seq); seq = seq + 1
    text = mc_store(text, 12, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 2, seq); seq = seq + 1
    text = mc_store(text, 13, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 3, seq); seq = seq + 1
    text = mc_store(text, 14, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 4, seq); seq = seq + 1
    text = mc_store(text, 15, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 5, seq); seq = seq + 1
    text = mc_store(text, 16, 17, seq); seq = seq + 1
    text = mc_load_imm(text, 17, 6, seq); seq = seq + 1
    text = mc_store(text, 30, 17, seq); seq = seq + 1
    text = mc_ret(text, seq); seq = seq + 1
    kaxi_asm_push_str(kaxi_asm_new(), text)
}
fn mc_load_32(text: string, dst: i64, tmp: i64, mulreg: i64, hi: i64, lo: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = mc_load_imm(text, tmp, hi, seq)
    t = mc_r3(t, "mul", tmp, tmp, mulreg, "var=+62.5%", seq + 1)
    t = mc_r3(t, "mul", tmp, tmp, mulreg, "var=+62.5%", seq + 2)
    t = mc_load_imm(t, dst, lo, seq + 3)
    t = mc_r3(t, "add", dst, dst, tmp, "var=+12.5%", seq + 4)
    t
}
fn mc_load_32s(text: string, dst: i64, tmp: i64, mulreg: i64, val: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = mc_load_32(text, dst, tmp, mulreg, val / 65536, val - (val / 65536) * 65536, seq)
    t
}
fn mc_r3(text: string, op: string, dst: i64, a: i64, b: i64, suffix: string, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, op)
    t = str_concat(t, " r")
    t = str_concat(t, mc_i64_to_string(dst))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(a))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(b))
    t = str_concat(t, ", ")
    t = str_concat(t, suffix)
    t = str_concat(t, ", seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_load_imm(text: string, dst: i64, imm: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "load_imm r")
    t = str_concat(t, mc_i64_to_string(dst))
    t = str_concat(t, ", imm=")
    t = str_concat(t, mc_i64_to_string(imm))
    t = str_concat(t, ", seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_setp(text: string, cmp: string, pred: i64, a: i64, b: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "setp.")
    t = str_concat(t, cmp)
    t = str_concat(t, " p")
    t = str_concat(t, mc_i64_to_string(pred))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(a))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(b))
    t = str_concat(t, ", seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_selp(text: string, dst: i64, a: i64, b: i64, pred: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "selp r")
    t = str_concat(t, mc_i64_to_string(dst))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(a))
    t = str_concat(t, ", r")
    t = str_concat(t, mc_i64_to_string(b))
    t = str_concat(t, ", pred=p")
    t = str_concat(t, mc_i64_to_string(pred))
    t = str_concat(t, ", seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_store(text: string, src: i64, addr: i64, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "store_global r")
    t = str_concat(t, mc_i64_to_string(src))
    t = str_concat(t, ", addr=r")
    t = str_concat(t, mc_i64_to_string(addr))
    t = str_concat(t, ", seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_ret(text: string, seq: i64) -> string with Mut, Panic, Div, Alloc {
    var t = str_concat(text, "ret seq=")
    t = str_concat(t, mc_i64_to_string(seq))
    t = str_concat(t, "
")
    t
}
fn mc_i64_to_string(v: i64) -> string with Mut, Panic, Div {
    if v == 0 {
        return "0"
    }
    var digits = ""
    var x = v
    while x > 0 {
        let d = x - (x / 10) * 10
        var ch = "0"
        if d == 1 { ch = "1" }
        else if d == 2 { ch = "2" }
        else if d == 3 { ch = "3" }
        else if d == 4 { ch = "4" }
        else if d == 5 { ch = "5" }
        else if d == 6 { ch = "6" }
        else if d == 7 { ch = "7" }
        else if d == 8 { ch = "8" }
        else if d == 9 { ch = "9" }
        digits = str_concat(ch, digits)
        x = x / 10
    }
    digits
}
pub fn pbpk28_mc_sim_proof() -> i64 with IO, Mut, Div, Panic, Alloc {
    var fails: i64 = 0
    let seed = mrg32k3a_default_seed()
    let asm = kaxi_emit_pbpk28_mc_advance_asm(seed.s0, seed.s1, seed.s2, seed.s3, seed.s4, seed.s5)
    let stream = kaxi_assemble(asm)
    var st = kaxi_sim_new()
    st = kaxi_sim_exec(st, stream)
    let cpu = mrg32k3a_next_u01(seed)
    if kaxi_sim_mem(&!st, 0) != cpu.1.s0 { fails = fails + 1 }
    if kaxi_sim_mem(&!st, 1) != cpu.1.s1 { fails = fails + 1 }
    if kaxi_sim_mem(&!st, 2) != cpu.1.s2 { fails = fails + 1 }
    if kaxi_sim_mem(&!st, 3) != cpu.1.s3 { fails = fails + 1 }
    if kaxi_sim_mem(&!st, 4) != cpu.1.s4 { fails = fails + 1 }
    if kaxi_sim_mem(&!st, 5) != cpu.1.s5 { fails = fails + 1 }
    let p1 = cpu.1.s2
    let p2 = cpu.1.s5
    let diff = p1 - p2
    var expect_z: i64 = diff
    if p1 <= p2 { expect_z = diff + 4294967087 }
    if kaxi_sim_mem(&!st, 6) != expect_z { fails = fails + 1 }
    fails
}
