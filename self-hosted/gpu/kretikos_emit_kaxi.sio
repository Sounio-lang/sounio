// Reference witness for source_vec_add_f64: same shape as f32 add but marks type=f64.
// This is the K-AXI that kaxi-lower-source should produce for lower_vec_add_f64.sio.
pub fn kaxi_emit_source_vec_add_f64_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]
    var types: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_GET_TID
    dsts[0] = 0
    types[0] = 0

    opcodes[1] = GPU_IR_LOAD_GLOBAL
    dsts[1] = 1
    src_a[1] = 0
    types[1] = 1

    opcodes[2] = GPU_IR_LOAD_GLOBAL
    dsts[2] = 2
    src_a[2] = 0
    types[2] = 1

    opcodes[3] = GPU_IR_ADD
    dsts[3] = 3
    src_a[3] = 1
    src_b[3] = 2
    types[3] = 1

    opcodes[4] = GPU_IR_STORE_GLOBAL
    src_a[4] = 3
    src_b[4] = 0
    types[4] = 1

    opcodes[5] = GPU_IR_RET

    gpu_lower_to_kaxi_typed(opcodes, dsts, src_a, src_b, imm, types, 6)
}

