// PBPK 4-step Euler with f32 fractional dt: convergence demo.
//
//   C ← C + dt · (k_in - k_out · C)
//   k_in=10, k_out=2, dt=0.25  → per-step factor (1 - dt·k_out) = 0.5
//   Each step halves the distance to equilibrium k_in/k_out = 5.
//
// 4 unrolled steps, written as raw K-AXI text (not through gpu_lower_to_kaxi)
// so we can use load_immf with IEEE 754 hex constants.
//
// IEEE 754 hex:
//   10.0  = 0x41200000     (k_in)
//    2.0  = 0x40000000     (k_out)
//    0.25 = 0x3E800000     (dt)
//
// Variance (epistemic mode): per-step grows by factor (1 + dt²·k_out²) = 1.25
// After 4 steps: var(C₄) = 1.25⁴ = 2.44140625
//
// Expected for C₀ ∈ [1..8] (4 halvings toward 5):
//   C=1 → 3, 4, 4.5, 4.75
//   C=2 → 3.5, 4.25, 4.625, 4.8125
//   C=3 → 4, 4.5, 4.75, 4.875
//   C=4 → 4.5, 4.75, 4.875, 4.9375
//   C=5 → 5, 5, 5, 5
//   C=6 → 5.5, 5.25, 5.125, 5.0625
//   C=7 → 6, 5.5, 5.25, 5.125
//   C=8 → 6.5, 5.75, 5.375, 5.1875
pub fn kaxi_emit_pbpk_4step_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_4step_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "load_global r1, addr=r0, seq=1")
    buf = kaxi_asm_push_line(buf, "load_immf r2, fimm=41200000, seq=2")
    buf = kaxi_asm_push_line(buf, "load_immf r3, fimm=40000000, seq=3")
    buf = kaxi_asm_push_line(buf, "load_immf r4, fimm=3E800000, seq=4")

    // Step 1: r8 = C + 0.25 * (10 - 2*C)
    buf = kaxi_asm_push_line(buf, "mul r5, r3, r1, var=+0%, seq=5")
    buf = kaxi_asm_push_line(buf, "sub r6, r2, r5, var=+0%, seq=6")
    buf = kaxi_asm_push_line(buf, "mul r7, r4, r6, var=+0%, seq=7")
    buf = kaxi_asm_push_line(buf, "add r8, r1, r7, var=+0%, seq=8")

    // Step 2
    buf = kaxi_asm_push_line(buf, "mul r9, r3, r8, var=+0%, seq=9")
    buf = kaxi_asm_push_line(buf, "sub r10, r2, r9, var=+0%, seq=10")
    buf = kaxi_asm_push_line(buf, "mul r11, r4, r10, var=+0%, seq=11")
    buf = kaxi_asm_push_line(buf, "add r12, r8, r11, var=+0%, seq=12")

    // Step 3
    buf = kaxi_asm_push_line(buf, "mul r13, r3, r12, var=+0%, seq=13")
    buf = kaxi_asm_push_line(buf, "sub r14, r2, r13, var=+0%, seq=14")
    buf = kaxi_asm_push_line(buf, "mul r15, r4, r14, var=+0%, seq=15")
    buf = kaxi_asm_push_line(buf, "add r16, r12, r15, var=+0%, seq=16")

    // Step 4
    buf = kaxi_asm_push_line(buf, "mul r17, r3, r16, var=+0%, seq=17")
    buf = kaxi_asm_push_line(buf, "sub r18, r2, r17, var=+0%, seq=18")
    buf = kaxi_asm_push_line(buf, "mul r19, r4, r18, var=+0%, seq=19")
    buf = kaxi_asm_push_line(buf, "add r20, r16, r19, var=+0%, seq=20")

    buf = kaxi_asm_push_line(buf, "store_global r20, addr=r0, seq=21")
    buf = kaxi_asm_push_line(buf, "ret seq=22")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// Multi-block 4-step coupled 2-compartment PBPK — full clinical-scale kernel.
// gid = bid·ntid + tid; per-thread 4 unrolled Euler steps; uses dual-bank
// arithmetic so the global index is computed correctly while the f32 value
// math runs in parallel.
pub fn kaxi_emit_pbpk_2comp_4step_mb_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_2comp_4step_mb_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "get_bid r1, var=0%, seq=1")
    buf = kaxi_asm_push_line(buf, "get_ntid r2, var=0%, seq=2")
    buf = kaxi_asm_push_line(buf, "mul r3, r1, r2, var=+0%, seq=3")
    buf = kaxi_asm_push_line(buf, "add r4, r3, r0, var=+0%, seq=4")  // gid
    buf = kaxi_asm_push_line(buf, "load_global r5, addr=r4, buf=0, seq=5")
    buf = kaxi_asm_push_line(buf, "load_global r6, addr=r4, buf=1, seq=6")
    buf = kaxi_asm_push_line(buf, "load_immf r7, fimm=3F800000, seq=7")
    buf = kaxi_asm_push_line(buf, "load_immf r8, fimm=3F000000, seq=8")
    buf = kaxi_asm_push_line(buf, "load_immf r9, fimm=3E800000, seq=9")
    buf = kaxi_asm_push_line(buf, "load_immf r10, fimm=3F000000, seq=10")

    var c1: i64 = 5
    var c2: i64 = 6
    var idx: i64 = 11
    var seq: i64 = 11
    var step: i64 = 0
    while step < 4 {
        let r_kc1 = idx
        let r_kc2 = idx + 1
        let r_diff_in = idx + 2
        let r_d1 = idx + 3
        let r_dt_d1 = idx + 4
        let r_c1n = idx + 5
        let r_diff = idx + 6
        let r_dt_diff = idx + 7
        let r_c2n = idx + 8
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_kc1) + ", r8, r" + ptx_int_to_string(c1) + ", var=+0%, seq=" + ptx_int_to_string(seq))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_kc2) + ", r9, r" + ptx_int_to_string(c2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 1))
        buf = kaxi_asm_push_line(buf, "sub r" + ptx_int_to_string(r_diff_in) + ", r7, r" + ptx_int_to_string(r_kc1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 2))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_d1) + ", r" + ptx_int_to_string(r_diff_in) + ", r" + ptx_int_to_string(r_kc2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 3))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_dt_d1) + ", r10, r" + ptx_int_to_string(r_d1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 4))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_c1n) + ", r" + ptx_int_to_string(c1) + ", r" + ptx_int_to_string(r_dt_d1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 5))
        buf = kaxi_asm_push_line(buf, "sub r" + ptx_int_to_string(r_diff) + ", r" + ptx_int_to_string(r_kc1) + ", r" + ptx_int_to_string(r_kc2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 6))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_dt_diff) + ", r10, r" + ptx_int_to_string(r_diff) + ", var=+0%, seq=" + ptx_int_to_string(seq + 7))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_c2n) + ", r" + ptx_int_to_string(c2) + ", r" + ptx_int_to_string(r_dt_diff) + ", var=+0%, seq=" + ptx_int_to_string(seq + 8))
        c1 = r_c1n
        c2 = r_c2n
        idx = idx + 9
        seq = seq + 9
        step = step + 1
    }

    buf = kaxi_asm_push_line(buf, "store_global r" + ptx_int_to_string(c1) + ", addr=r4, buf=0, seq=99")
    buf = kaxi_asm_push_line(buf, "store_global r" + ptx_int_to_string(c2) + ", addr=r4, buf=1, seq=100")
    buf = kaxi_asm_push_line(buf, "ret seq=101")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// Multi-block 2-compartment PBPK Euler step with global indexing.
//   gid = bid·ntid + tid
//   Each thread loads C₁[gid] from buf=0, C₂[gid] from buf=1, runs one
//   coupled Euler step, writes back. Uses dual-bank arithmetic so the
//   register r4 = bid·ntid + tid is usable as both an address (%rdN) and
//   an f32 value (%fN, unused here but harmless).
pub fn kaxi_emit_pbpk_2comp_mb_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_2comp_mb_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "get_bid r1, var=0%, seq=1")
    buf = kaxi_asm_push_line(buf, "get_ntid r2, var=0%, seq=2")
    buf = kaxi_asm_push_line(buf, "mul r3, r1, r2, var=+0%, seq=3")    // bid * ntid
    buf = kaxi_asm_push_line(buf, "add r4, r3, r0, var=+0%, seq=4")    // gid
    buf = kaxi_asm_push_line(buf, "load_global r5, addr=r4, buf=0, seq=5")  // C₁[gid]
    buf = kaxi_asm_push_line(buf, "load_global r6, addr=r4, buf=1, seq=6")  // C₂[gid]
    buf = kaxi_asm_push_line(buf, "load_immf r7, fimm=3F800000, seq=7")    // k_in = 1.0
    buf = kaxi_asm_push_line(buf, "load_immf r8, fimm=3F000000, seq=8")    // k₁₂ = 0.5
    buf = kaxi_asm_push_line(buf, "load_immf r9, fimm=3E800000, seq=9")    // k₂₁ = 0.25
    buf = kaxi_asm_push_line(buf, "load_immf r10, fimm=3F000000, seq=10")  // dt = 0.5

    buf = kaxi_asm_push_line(buf, "mul r11, r8, r5, var=+0%, seq=11")   // k₁₂·C₁
    buf = kaxi_asm_push_line(buf, "mul r12, r9, r6, var=+0%, seq=12")   // k₂₁·C₂
    buf = kaxi_asm_push_line(buf, "sub r13, r7, r11, var=+0%, seq=13")  // k_in − k₁₂·C₁
    buf = kaxi_asm_push_line(buf, "add r14, r13, r12, var=+0%, seq=14") // + k₂₁·C₂
    buf = kaxi_asm_push_line(buf, "mul r15, r10, r14, var=+0%, seq=15") // dt·(…)
    buf = kaxi_asm_push_line(buf, "add r16, r5, r15, var=+0%, seq=16")  // C₁_new

    buf = kaxi_asm_push_line(buf, "sub r17, r11, r12, var=+0%, seq=17") // k₁₂·C₁ − k₂₁·C₂
    buf = kaxi_asm_push_line(buf, "mul r18, r10, r17, var=+0%, seq=18") // dt·(…)
    buf = kaxi_asm_push_line(buf, "add r19, r6, r18, var=+0%, seq=19")  // C₂_new

    buf = kaxi_asm_push_line(buf, "store_global r16, addr=r4, buf=0, seq=20")
    buf = kaxi_asm_push_line(buf, "store_global r19, addr=r4, buf=1, seq=21")
    buf = kaxi_asm_push_line(buf, "ret seq=22")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// Atomic global reduction: each thread atomically adds its tid (as f32)
// to mem[0]. After all threads complete, mem[0] = sum of all tids = N·(N−1)/2.
// Demonstrates atom.global.add.f32 — the basic primitive for histograms,
// reductions, and dose accumulation in PBPK.
pub fn kaxi_emit_atomic_sum_f32_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_atomic_sum_f32_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "load_imm r1, imm=0, seq=1")
    buf = kaxi_asm_push_line(buf, "atomic_addf r2, addr=r1, src=r0, seq=2")
    buf = kaxi_asm_push_line(buf, "ret seq=3")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// 4-step 2-compartment PBPK — coupled rapamycin Euler chain.
//
// Same dynamics as pbpk_2comp but iterated 4 times. Each step uses 9
// arithmetic registers; we chain "current C1, current C2" through the
// register file by advancing the indices.
//
// Constants live in r3,r4,r5,r6 (k_in, k12, k21, dt).
// Step k uses r3,r4,r5,r6 + fresh slots [r_step_base..r_step_base+8] and
// produces (C1_new = +6 slot, C2_new = +8 slot) which become the next
// step's (C1, C2) sources.
pub fn kaxi_emit_pbpk_2comp_4step_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_2comp_4step_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "load_global r1, addr=r0, buf=0, seq=1")
    buf = kaxi_asm_push_line(buf, "load_global r2, addr=r0, buf=1, seq=2")
    buf = kaxi_asm_push_line(buf, "load_immf r3, fimm=3F800000, seq=3")
    buf = kaxi_asm_push_line(buf, "load_immf r4, fimm=3F000000, seq=4")
    buf = kaxi_asm_push_line(buf, "load_immf r5, fimm=3E800000, seq=5")
    buf = kaxi_asm_push_line(buf, "load_immf r6, fimm=3F000000, seq=6")

    var c1: i64 = 1
    var c2: i64 = 2
    var idx: i64 = 7
    var seq: i64 = 7
    var step: i64 = 0
    while step < 4 {
        let r_kc1 = idx        // k12 * C1
        let r_kc2 = idx + 1    // k21 * C2
        let r_diff_in = idx + 2  // k_in - k12*C1
        let r_d1 = idx + 3     // (k_in - k12*C1) + k21*C2
        let r_dt_d1 = idx + 4  // dt * d1
        let r_c1n = idx + 5    // C1_new
        let r_diff = idx + 6   // k12*C1 - k21*C2
        let r_dt_diff = idx + 7  // dt * diff
        let r_c2n = idx + 8    // C2_new
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_kc1) + ", r4, r" + ptx_int_to_string(c1) + ", var=+0%, seq=" + ptx_int_to_string(seq))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_kc2) + ", r5, r" + ptx_int_to_string(c2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 1))
        buf = kaxi_asm_push_line(buf, "sub r" + ptx_int_to_string(r_diff_in) + ", r3, r" + ptx_int_to_string(r_kc1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 2))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_d1) + ", r" + ptx_int_to_string(r_diff_in) + ", r" + ptx_int_to_string(r_kc2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 3))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_dt_d1) + ", r6, r" + ptx_int_to_string(r_d1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 4))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_c1n) + ", r" + ptx_int_to_string(c1) + ", r" + ptx_int_to_string(r_dt_d1) + ", var=+0%, seq=" + ptx_int_to_string(seq + 5))
        buf = kaxi_asm_push_line(buf, "sub r" + ptx_int_to_string(r_diff) + ", r" + ptx_int_to_string(r_kc1) + ", r" + ptx_int_to_string(r_kc2) + ", var=+0%, seq=" + ptx_int_to_string(seq + 6))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_dt_diff) + ", r6, r" + ptx_int_to_string(r_diff) + ", var=+0%, seq=" + ptx_int_to_string(seq + 7))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_c2n) + ", r" + ptx_int_to_string(c2) + ", r" + ptx_int_to_string(r_dt_diff) + ", var=+0%, seq=" + ptx_int_to_string(seq + 8))
        c1 = r_c1n
        c2 = r_c2n
        idx = idx + 9
        seq = seq + 9
        step = step + 1
    }
    buf = kaxi_asm_push_line(buf, "store_global r" + ptx_int_to_string(c1) + ", addr=r0, buf=0, seq=99")
    buf = kaxi_asm_push_line(buf, "store_global r" + ptx_int_to_string(c2) + ", addr=r0, buf=1, seq=100")
    buf = kaxi_asm_push_line(buf, "ret seq=101")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// 2-compartment PBPK Euler step (rapamycin-style coupled ODE).
//
//   dC1/dt = k_in - k12·C1 + k21·C2     (central / tissue compartment)
//   dC2/dt =        k12·C1 - k21·C2     (peripheral / blood compartment)
//
// Per-thread layout: param_a holds C1 array, param_b holds C2 array.
// load/store_global use buf=0 (C1) and buf=1 (C2).
//
// Constants encoded as IEEE 754 hex via load_immf:
//   k_in  = 1.0   = 0x3F800000
//   k12   = 0.5   = 0x3F000000
//   k21   = 0.25  = 0x3E800000
//   dt    = 0.5   = 0x3F000000
//
// Closed-form for one Euler step with C2[i] = 0:
//   C1_new[i] = (1 - dt·k12)·C1[i] + dt·k_in    = 0.75·C1[i] + 0.5
//   C2_new[i] = dt·k12·C1[i]                    = 0.25·C1[i]
//
// For C1 = [1..8], C2 = 0:
//   C1_new = [1.25, 2, 2.75, 3.5, 4.25, 5, 5.75, 6.5]
//   C2_new = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2]
pub fn kaxi_emit_pbpk_2comp_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_2comp_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "load_global r1, addr=r0, buf=0, seq=1")
    buf = kaxi_asm_push_line(buf, "load_global r2, addr=r0, buf=1, seq=2")
    buf = kaxi_asm_push_line(buf, "load_immf r3, fimm=3F800000, seq=3")
    buf = kaxi_asm_push_line(buf, "load_immf r4, fimm=3F000000, seq=4")
    buf = kaxi_asm_push_line(buf, "load_immf r5, fimm=3E800000, seq=5")
    buf = kaxi_asm_push_line(buf, "load_immf r6, fimm=3F000000, seq=6")

    // dC1: r9 = k_in - k12*C1 + k21*C2;  C1_new = C1 + dt*r9
    buf = kaxi_asm_push_line(buf, "mul r7, r4, r1, var=+0%, seq=7")     // k12 * C1
    buf = kaxi_asm_push_line(buf, "mul r8, r5, r2, var=+0%, seq=8")     // k21 * C2
    buf = kaxi_asm_push_line(buf, "sub r9, r3, r7, var=+0%, seq=9")     // k_in - k12*C1
    buf = kaxi_asm_push_line(buf, "add r10, r9, r8, var=+0%, seq=10")   // + k21*C2
    buf = kaxi_asm_push_line(buf, "mul r11, r6, r10, var=+0%, seq=11")  // dt * (...)
    buf = kaxi_asm_push_line(buf, "add r12, r1, r11, var=+0%, seq=12")  // C1_new

    // dC2: r15 = k12*C1 - k21*C2;  C2_new = C2 + dt*r15
    buf = kaxi_asm_push_line(buf, "sub r13, r7, r8, var=+0%, seq=13")   // k12*C1 - k21*C2 (reuse r7, r8)
    buf = kaxi_asm_push_line(buf, "mul r14, r6, r13, var=+0%, seq=14")  // dt * (...)
    buf = kaxi_asm_push_line(buf, "add r15, r2, r14, var=+0%, seq=15")  // C2_new

    buf = kaxi_asm_push_line(buf, "store_global r12, addr=r0, buf=0, seq=16")
    buf = kaxi_asm_push_line(buf, "store_global r15, addr=r0, buf=1, seq=17")
    buf = kaxi_asm_push_line(buf, "ret seq=18")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// PBPK 8-step Euler with f32 fractional dt — same dynamics as pbpk_4step,
// extended to 8 steps to demonstrate deeper convergence and variance growth.
//
// After 8 steps with dt=0.25, k_out=2: C₈ = 0.00390625·C₀ + 4.98046875
// (each step closes half the gap to equilibrium 5; 2⁻⁸ = 1/256 = 0.00390625).
// Variance grows by factor 1.25 per step → var(C₈) = 1.25⁸ ≈ 5.96046447753906.
//
// Register reuse across steps: each step uses r5,r6,r7,r8 then carries the
// result back into r1 via copy semantics (we just rename in K-AXI).
pub fn kaxi_emit_pbpk_8step_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf: KaxiAsmBuf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by kaxi_emit_pbpk_8step_asm()")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "get_tid r0, var=0%, seq=0")
    buf = kaxi_asm_push_line(buf, "load_global r1, addr=r0, seq=1")
    buf = kaxi_asm_push_line(buf, "load_immf r2, fimm=41200000, seq=2")
    buf = kaxi_asm_push_line(buf, "load_immf r3, fimm=40000000, seq=3")
    buf = kaxi_asm_push_line(buf, "load_immf r4, fimm=3E800000, seq=4")

    // 8 unrolled steps. Each step writes 4 fresh registers; the "current C"
    // chain proceeds r1 → r8 → r12 → r16 → r20 → r24 → r28 → r32 → r36.
    var seq: i64 = 5
    var src_reg: i64 = 1
    var idx: i64 = 5
    var step: i64 = 0
    while step < 8 {
        let r_a = idx
        let r_b = idx + 1
        let r_c = idx + 2
        let r_dst = idx + 3
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_a) + ", r3, r" + ptx_int_to_string(src_reg) + ", var=+0%, seq=" + ptx_int_to_string(seq))
        buf = kaxi_asm_push_line(buf, "sub r" + ptx_int_to_string(r_b) + ", r2, r" + ptx_int_to_string(r_a) + ", var=+0%, seq=" + ptx_int_to_string(seq + 1))
        buf = kaxi_asm_push_line(buf, "mul r" + ptx_int_to_string(r_c) + ", r4, r" + ptx_int_to_string(r_b) + ", var=+0%, seq=" + ptx_int_to_string(seq + 2))
        buf = kaxi_asm_push_line(buf, "add r" + ptx_int_to_string(r_dst) + ", r" + ptx_int_to_string(src_reg) + ", r" + ptx_int_to_string(r_c) + ", var=+0%, seq=" + ptx_int_to_string(seq + 3))
        src_reg = r_dst
        idx = idx + 4
        seq = seq + 4
        step = step + 1
    }
    buf = kaxi_asm_push_line(buf, "store_global r" + ptx_int_to_string(src_reg) + ", addr=r0, seq=99")
    buf = kaxi_asm_push_line(buf, "ret seq=100")
    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// PBPK explicit Euler step (single compartment, integer arithmetic):
//   C_new = C + dt * (k_in - k_out * C)
// With k_in=10, k_out=2, dt=1, equilibrium ≈ 5. Per-thread C[tid] from mem.
// Demonstrates GUM variance propagation: σ²(C_new) = σ²(C)*(1-dt*k_out)² in
// a chain of mul, sub, mul, add operations.
pub fn kaxi_emit_pbpk_euler_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_GET_TID
    dsts[0] = 0

    opcodes[1] = GPU_IR_LOAD_GLOBAL
    dsts[1] = 1
    src_a[1] = 0

    opcodes[2] = GPU_IR_MUL_IMM
    dsts[2] = 2
    imm[2] = 10

    opcodes[3] = GPU_IR_MUL_IMM
    dsts[3] = 3
    imm[3] = 2

    opcodes[4] = GPU_IR_MUL_IMM
    dsts[4] = 4
    imm[4] = 1

    opcodes[5] = GPU_IR_MUL
    dsts[5] = 5
    src_a[5] = 3
    src_b[5] = 1

    opcodes[6] = GPU_IR_SUB
    dsts[6] = 6
    src_a[6] = 2
    src_b[6] = 5

    opcodes[7] = GPU_IR_MUL
    dsts[7] = 7
    src_a[7] = 4
    src_b[7] = 6

    opcodes[8] = GPU_IR_ADD
    dsts[8] = 8
    src_a[8] = 1
    src_b[8] = 7

    opcodes[9] = GPU_IR_STORE_GLOBAL
    src_a[9] = 8
    src_b[9] = 0

    opcodes[10] = GPU_IR_RET

    gpu_lower_to_kaxi(opcodes, dsts, src_a, src_b, imm, 11)
}

// Multi-block doubling kernel: idx = bid*ntid + tid; mem[idx] = 2*mem[idx]
// Exercises get_tid + get_bid + get_ntid + global indexing across blocks.
pub fn kaxi_emit_mb_vec_double_f32_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_GET_TID
    dsts[0] = 0

    opcodes[1] = GPU_IR_GET_BID
    dsts[1] = 1

    opcodes[2] = GPU_IR_GET_NTID
    dsts[2] = 2

    opcodes[3] = GPU_IR_MUL
    dsts[3] = 3
    src_a[3] = 1
    src_b[3] = 2

    opcodes[4] = GPU_IR_ADD
    dsts[4] = 4
    src_a[4] = 3
    src_b[4] = 0

    opcodes[5] = GPU_IR_LOAD_GLOBAL
    dsts[5] = 5
    src_a[5] = 4

    opcodes[6] = GPU_IR_ADD
    dsts[6] = 6
    src_a[6] = 5
    src_b[6] = 5

    opcodes[7] = GPU_IR_STORE_GLOBAL
    src_a[7] = 6
    src_b[7] = 4

    opcodes[8] = GPU_IR_RET

    gpu_lower_to_kaxi(opcodes, dsts, src_a, src_b, imm, 9)
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_kaxi: error - expected <pattern>")
        println("")
        println("Supported patterns:")
        println("  exit_only                 - minimal kernel that returns immediately")
        println("  vec_add                   - kernel with GetTid + Add ops")
        println("  vec_sub                   - kernel with GetTid + Sub ops")
        println("  vec_mul                   - kernel with GetTid + Mul ops")
        println("  vec_div                   - kernel with GetTid + Div ops")
        println("  fma                       - kernel with GetTid + FMA ops")
        println("  source_vec_add_f32        - checked-source vec-add lowering sketch")
        println("  source_vec_sub_f32        - checked-source vec-sub lowering sketch")
        println("  source_vec_mul_f32        - checked-source vec-mul lowering sketch")
        println("  source_vec_div_f32        - checked-source vec-div lowering sketch")
        println("  source_fma_f32            - checked-source affine multiply-add sketch")
        println("  source_epistemic_dual_output_f32 - checked-source value+uncertainty lanes")
        println("  epistemic_elementwise_f32 - value+epsilon lane arithmetic sketch")
        println("  epistemic_dual_output_f32 - separate value/uncertainty output sketch")
        println("  self-check                - run K-AXI self-check suite")
        return 1
    }

    let pattern = get_arg(0)
    var buf: KaxiAsmBuf

    if str_eq(pattern, "exit_only") {
        buf = kaxi_emit_exit_only_asm()
    } else if str_eq(pattern, "vec_add") {
        buf = kaxi_emit_vec_add_asm()
    } else if str_eq(pattern, "source_vec_add_f32") {
        buf = kaxi_emit_source_vec_add_f32_asm()
    } else if str_eq(pattern, "source_vec_sub_f32") {
        buf = kaxi_emit_source_vec_sub_f32_asm()
    } else if str_eq(pattern, "source_vec_mul_f32") {
        buf = kaxi_emit_source_vec_mul_f32_asm()
    } else if str_eq(pattern, "source_vec_div_f32") {
        buf = kaxi_emit_source_vec_div_f32_asm()
    } else if str_eq(pattern, "source_fma_f32") {
        buf = kaxi_emit_source_fma_f32_asm()
    } else if str_eq(pattern, "source_epistemic_dual_output_f32") {
        buf = kaxi_emit_source_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "vec_sub") {
        buf = kaxi_emit_vec_sub_asm()
    } else if str_eq(pattern, "vec_mul") {
        buf = kaxi_emit_vec_mul_asm()
    } else if str_eq(pattern, "vec_div") {
        buf = kaxi_emit_vec_div_asm()
    } else if str_eq(pattern, "fma") {
        buf = kaxi_emit_fma_asm()
    } else if str_eq(pattern, "epistemic_elementwise_f32") {
        buf = kaxi_emit_epistemic_elementwise_f32_asm()
    } else if str_eq(pattern, "epistemic_dual_output_f32") {
        buf = kaxi_emit_epistemic_dual_output_f32_asm()
    } else if str_eq(pattern, "mb_vec_double_f32") {
        buf = kaxi_emit_mb_vec_double_f32_asm()
    } else if str_eq(pattern, "pbpk_euler") {
        buf = kaxi_emit_pbpk_euler_asm()
    } else if str_eq(pattern, "pbpk_4step") {
        buf = kaxi_emit_pbpk_4step_asm()
    } else if str_eq(pattern, "pbpk_8step") {
        buf = kaxi_emit_pbpk_8step_asm()
    } else if str_eq(pattern, "pbpk_2comp") {
        buf = kaxi_emit_pbpk_2comp_asm()
    } else if str_eq(pattern, "pbpk_2comp_4step") {
        buf = kaxi_emit_pbpk_2comp_4step_asm()
    } else if str_eq(pattern, "atomic_sum_f32") {
        buf = kaxi_emit_atomic_sum_f32_asm()
    } else if str_eq(pattern, "pbpk_2comp_mb") {
        buf = kaxi_emit_pbpk_2comp_mb_asm()
    } else if str_eq(pattern, "pbpk_2comp_4step_mb") {
        buf = kaxi_emit_pbpk_2comp_4step_mb_asm()
    } else if str_eq(pattern, "self-check") {
        let ok = kaxi_self_check()
        if ok {
            print("PASS kaxi_self_check\n")
            return 0
        } else {
            print("FAIL kaxi_self_check\n")
            return 1
        }
    } else {
        print("kretikos_emit_kaxi: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    print(kaxi_asm_to_string(buf))
    0
}
