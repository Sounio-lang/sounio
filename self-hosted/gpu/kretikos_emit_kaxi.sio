// self-hosted/gpu/kretikos_emit_kaxi.sio
// Kretikos K-AXI emission driver - produces K-AXI epistemic assembly text.
//
// Usage: souc kretikos_emit_kaxi.sio /tmp/driver.elf
//        /tmp/driver.elf <pattern>
//
// Supported patterns:
//   exit_only                - minimal kernel that returns immediately
//   vec_add                  - kernel with GetTid + Add ops
//   vec_sub                  - kernel with GetTid + Sub ops
//   vec_mul                  - kernel with GetTid + Mul ops
//   vec_div                  - kernel with GetTid + Div ops
//   fma                      - kernel with GetTid + FMA ops
//   source_vec_add_f32       - checked-source vec-add lowering sketch
//   source_vec_sub_f32       - checked-source vec-sub lowering sketch
//   source_vec_mul_f32       - checked-source vec-mul lowering sketch
//   source_vec_div_f32       - checked-source vec-div lowering sketch
//   source_fma_f32           - checked-source affine multiply-add sketch
//   source_epistemic_dual_output_f32 - checked-source value+uncertainty lanes
//   epistemic_elementwise_f32 - value+epsilon lane arithmetic sketch
//   epistemic_dual_output_f32 - separate value/uncertainty output sketch
//   self-check               - run K-AXI self-check suite

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

pub fn kaxi_emit_exit_only_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_RET

    gpu_lower_to_kaxi(opcodes, dsts, src_a, src_b, imm, 1)
}

pub fn kaxi_emit_vec_add_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_GET_TID
    dsts[0] = 0

    opcodes[1] = GPU_IR_ADD
    dsts[1] = 1
    src_a[1] = 0
    src_b[1] = 0

    opcodes[2] = GPU_IR_RET

    gpu_lower_to_kaxi(opcodes, dsts, src_a, src_b, imm, 3)
}

pub fn kaxi_emit_source_vec_add_f32_asm() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var opcodes: [i64; 256] = [0; 256]
    var dsts: [i64; 256] = [0; 256]
    var src_a: [i64; 256] = [0; 256]
    var src_b: [i64; 256] = [0; 256]
    var imm: [i64; 256] = [0; 256]

    opcodes[0] = GPU_IR_GET_TID
    dsts[0] = 0

    opcodes[1] = GPU_IR_LOAD_GLOBAL
    dsts[1] = 1
    src_a[1] = 0

    opcodes[2] = GPU_IR_LOAD_GLOBAL
    dsts[2] = 2
    src_a[2] = 0

    opcodes[3] = GPU_IR_ADD
    dsts[3] = 3
    src_a[3] = 1
    src_b[3] = 2

    opcodes[4] = GPU_IR_STORE_GLOBAL
    src_a[4] = 3
    src_b[4] = 0

    opcodes[5] = GPU_IR_RET

    gpu_lower_to_kaxi(opcodes, dsts, src_a, src_b, imm, 6)
}

