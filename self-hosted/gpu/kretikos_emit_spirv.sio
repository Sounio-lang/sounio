fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_spirv: error - expected <pattern>")
        println("")
        println("Supported patterns:")
        println("  exit_only - minimal kernel that returns immediately")
        println("  storage_vec_add - Vulkan storage-buffer vec-add template")
        return 1
    }

    let pattern = get_arg(0)
    var buf: SpvBuf

    if str_eq(pattern, "exit_only") {
        buf = emit_exit_only_spirv()
    } else if str_eq(pattern, "self-check") {
        let ok = spirv_driver_self_check()
        if ok { print("PASS spirv_driver_self_check\n") } else { print("FAIL spirv_driver_self_check\n") }
        return 0
    } else if str_eq(pattern, "vec_add") {
        buf = spirv_emit_vec_add_kernel()
    } else if str_eq(pattern, "tid_kernel") {
        buf = spirv_emit_tid_kernel()
    } else if str_eq(pattern, "storage_vec_add") {
        buf = emit_storage_vec_add_spirv()
    } else {
        print("kretikos_emit_spirv: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    // Print as decimal words, one per line
    var i: i64 = 0
    while i < buf.word_count {
        print_byte_decimal(buf.words[i as usize])
        print("\n")
        i = i + 1
    }
    0
}
