// self-hosted/gpu/kretikos_emit_spirv.sio
// Kretikos SPIR-V emission driver — produces a minimal SPIR-V kernel.
//
// Usage: souc kretikos_emit_spirv.sio /tmp/driver.elf
//        /tmp/driver.elf <pattern>
//
// Supported patterns:
//   exit_only  - minimal kernel that returns immediately
//   self-check - run SPIR-V self-check suite
//   vec_add    - kernel with GetTid + Add ops
//   tid_kernel - kernel with GetTid only
//   storage_vec_add - Vulkan storage-buffer vec-add template

use spirv::*

fn print_byte_decimal(b: i64) with IO, Mut, Panic {
    var v = b
    if v < 0 {
        print("-")
        v = 0 - v
    }
    if v >= 10 {
        print_byte_decimal(v / 10)
    }
    let digit = v % 10
    if digit == 0 { print("0") }
    else if digit == 1 { print("1") }
    else if digit == 2 { print("2") }
    else if digit == 3 { print("3") }
    else if digit == 4 { print("4") }
    else if digit == 5 { print("5") }
    else if digit == 6 { print("6") }
    else if digit == 7 { print("7") }
    else if digit == 8 { print("8") }
    else if digit == 9 { print("9") }
}

fn emit_exit_only_spirv() -> SpvBuf with Mut, Panic, Div {
    var b = spv_buf_new()

    // Header: magic, version 1.5, generator, bound=10, schema=0
    b = spv_emit_header(b, 10)

    // Capabilities
    b = spv_emit_capability(b, 17)  // Kernel
    b = spv_emit_capability(b, 1)   // Shader

    // Memory model: Physical64, OpenCL
    b = spv_emit_memory_model(b, 2, 2)

    // Entry point: Kernel, function id 1, "main"
    var interface_ids: [i64; 8] = [0; 8]
    b = spv_emit_entry_point(b, 6, 1, "main", interface_ids, 0)

    // Execution mode: LocalSize 1 1 1
    b = spv_emit_execution_mode(b, 1, 17)

    // Types
    // %void = OpTypeVoid 2
    b = spv_emit_type_void(b, 2)
    // %fn = OpTypeFunction 3 %void
    b = spv_emit_type_function(b, 3, 2)

    // Function: %main = OpFunction %void None %fn
    b = spv_emit_function(b, 2, 1, 0, 3)

    // Label: %entry = OpLabel
    b = spv_emit_label(b, 4)

    // Return
    b = spv_emit_return(b)

    // Function end
    b = spv_emit_function_end(b)

    b
}

