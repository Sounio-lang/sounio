    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src_b))
    out = kaxi_asm_push_str(out, ", pred=p")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(pred))
    out = kaxi_asm_push_str(out, ", seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

