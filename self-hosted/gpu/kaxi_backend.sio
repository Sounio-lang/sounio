// get_nctaid: number of CTAs / blocks in the grid (PTX %nctaid.x). Required
// for runtime-derived total-thread counts in kernels that span multiple
// blocks (e.g. connectomics-sweep at N=200, where nctaid×ntid is the only
// way to address the atomic-sum slot at runtime instead of baking N at emit).
fn kaxi_asm_append_get_nctaid(buf: KaxiAsmBuf, dst: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = kaxi_asm_push_str(out, "get_nctaid r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst))
    out = kaxi_asm_push_str(out, ", var=0%, seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

fn kaxi_asm_append_setp(buf: KaxiAsmBuf, cmp: string, dst_pred: i64, src_a: i64, src_b: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = kaxi_asm_push_str(out, "setp.")
    out = kaxi_asm_push_str(out, cmp)
    out = kaxi_asm_push_str(out, " p")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst_pred))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src_a))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src_b))
    out = kaxi_asm_push_str(out, ", seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

fn kaxi_asm_append_selp(buf: KaxiAsmBuf, dst: i64, src_a: i64, src_b: i64, pred: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
