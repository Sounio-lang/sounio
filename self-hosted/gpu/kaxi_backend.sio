fn kaxi_asm_append_getvar(buf: KaxiAsmBuf, dst: i64, src: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    // Phase U unary: "gvr rD, rA, var=+0%, seq=N" — copy variance lane of rA into
    // value lane of rD. Variance lane of dst becomes 0 (the moved variance is
    // now a "fact"). Mode 4 (f32_epistemic) only — emits empty in others.
    var out = buf
    out = kaxi_asm_push_str(out, "gvr r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src))
    out = kaxi_asm_push_str(out, ", var=+0%, seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

