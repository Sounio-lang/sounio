let GPU_IR_CONST: i64 = 1
let GPU_IR_CVT: i64 = 2
let GPU_IR_MUL_IMM: i64 = 3
let GPU_IR_ADD: i64 = 4
let GPU_IR_SUB: i64 = 5
let GPU_IR_MUL: i64 = 6
let GPU_IR_DIV: i64 = 7
