    // Phase S unary: "rsq rD, rA, var=+0%, seq=N" — 1/√x (PTX-native rsqrt.approx.f32).
    var out = buf
    out = kaxi_asm_push_str(out, "rsq r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst))
