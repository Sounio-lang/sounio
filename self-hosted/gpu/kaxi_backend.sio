fn kaxi_asm_append_recip(buf: KaxiAsmBuf, dst: i64, src: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    // Phase O unary: "rcp rD, rA, var=+0%, seq=N"
    // Mnemonic matches PTX (rcp.approx.f32 / rcp.rn.f64) and avoids the
    // first-3-char collision with `rec` (reconverge).
    var out = buf
    out = kaxi_asm_push_str(out, "rcp r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src))
    out = kaxi_asm_push_str(out, ", var=+0%, seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

