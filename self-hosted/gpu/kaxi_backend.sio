module gpu::kaxi_backend;

// self-hosted::gpu::kaxi_backend - K-AXI GPU Backend + Assembler + Simulator
//
// Phase 1: Makes K-AXI a first-class GPU target.
//   1. gpu_lower_to_kaxi(kernel) -> KaxiAsmBuf (text assembly)
//   2. kaxi_assemble(asm) -> KaxiTransactionStream (binary transactions)
//   3. kaxi_simulate(stream) -> KaxiTrace (cycle-accurate simulation)
//
// Self-contained: no imports from kernel_ir.sio or other GPU modules.
// Uses parallel primitive arrays to avoid struct-array-repeat compiler bug.

// ============================================================================
// K-AXI ISA constants (matching kaxi_fabric_emitter.sio + kaxi.sio Verilog)
// ============================================================================

let KAXI_OP_PASS: i64 = 0
let KAXI_OP_ADD: i64 = 1
let KAXI_OP_MUL: i64 = 2
let KAXI_OP_DIV: i64 = 3
let KAXI_OP_FMA: i64 = 4
let KAXI_OP_LOAD_IMM: i64 = 5
let KAXI_OP_LOAD_PARAM: i64 = 6
let KAXI_OP_LOAD_GLOBAL: i64 = 7
let KAXI_OP_STORE_GLOBAL: i64 = 8
let KAXI_OP_GET_BID: i64 = 9
let KAXI_OP_GET_NTID: i64 = 10
let KAXI_OP_RET: i64 = 11
let KAXI_OP_SUB: i64 = 13
let KAXI_OP_SETP_LT: i64 = 14
let KAXI_OP_BARRIER: i64 = 12
let KAXI_OP_SETP_LE: i64 = 16
let KAXI_OP_SETP_EQ: i64 = 17
let KAXI_OP_SETP_GE: i64 = 18
let KAXI_OP_SETP_GT: i64 = 19
let KAXI_OP_SETP_NE: i64 = 20
let KAXI_OP_SELP: i64 = 21
let KAXI_OP_LOAD_SHARED: i64 = 22
let KAXI_OP_STORE_SHARED: i64 = 23
let KAXI_OP_NOP: i64 = 15
let KAXI_OP_BRANCH: i64 = 24
let KAXI_OP_RECONVERGE: i64 = 25
let KAXI_OP_VOTE_BALLOT: i64 = 26
let KAXI_OP_SHUFFLE_XOR: i64 = 27
let KAXI_OP_WARP_REDUCE_ADD: i64 = 28

let KAXI_WARP_SIZE: i64 = 8

