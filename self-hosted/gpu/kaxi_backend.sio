// Variance growth profiles (Q32.32 fractional, matching kaxi.sio Verilog)
fn kaxi_variance_add(v: i64) -> i64 {
    v + (v >> 3)
}

fn kaxi_variance_mul(v: i64) -> i64 {
    v + (v >> 1) + (v >> 3)
}

fn kaxi_variance_div(v: i64) -> i64 {
    v + (v >> 1) + (v >> 2)
}

fn kaxi_variance_fma(v: i64) -> i64 {
    v + (v >> 1) + (v >> 2) + (v >> 4)
}

// ============================================================================
// Flag packing (matches kaxi_fabric_emitter.sio)
// ============================================================================

pub fn kaxi_flags_pack(op_kind: i64, success_inc: i64, failure_inc: i64, alpha_q8: i64) -> i64 {
    let op = op_kind & 0x1F
    let failure = (failure_inc & 0xFF) << 8
    let success = (success_inc & 0xFF) << 16
    let alpha = (alpha_q8 & 0xFF) << 24
    op | failure | success | alpha
}

pub fn kaxi_flags_unpack_op_kind(flags: i64) -> i64 {
    flags & 0x1F
}

// ============================================================================
// K-AXI transaction stream (parallel arrays, struct-array-bug safe)
// ============================================================================

let KAXI_TXN_MAX: i64 = 4096

pub struct KaxiTxnStream {
    value_bits: [i64; 4096],
    variance_bits: [i64; 4096],
    prov_lo: [i64; 4096],
    prov_hi: [i64; 4096],
    conf_lo: [i64; 4096],
    conf_hi: [i64; 4096],
    flags: [i64; 4096],
    seq: [i64; 4096],
    count: i64,
}

pub fn kaxi_txn_stream_new() -> KaxiTxnStream {
    KaxiTxnStream {
        value_bits: [0; 4096],
        variance_bits: [0; 4096],
        prov_lo: [0; 4096],
        prov_hi: [0; 4096],
        conf_lo: [0; 4096],
        conf_hi: [0; 4096],
        flags: [0; 4096],
        seq: [0; 4096],
        count: 0,
    }
}

pub fn kaxi_txn_stream_count(stream: KaxiTxnStream) -> i64 {
    stream.count
}

fn kaxi_txn_stream_append(s: KaxiTxnStream, value: i64, variance: i64, pl: i64, ph: i64, cl: i64, ch: i64, fl: i64, sq: i64) -> KaxiTxnStream with Mut, Panic {
    var out = s
    if out.count < KAXI_TXN_MAX {
        let i = out.count
        out.value_bits[i as usize] = value
        out.variance_bits[i as usize] = variance
        out.prov_lo[i as usize] = pl
        out.prov_hi[i as usize] = ph
        out.conf_lo[i as usize] = cl
        out.conf_hi[i as usize] = ch
        out.flags[i as usize] = fl
        out.seq[i as usize] = sq
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// K-AXI text assembly buffer
// ============================================================================

pub struct KaxiAsmBuf {
    data: [i8; 2097152],
    len: i64,
}

pub fn kaxi_asm_new() -> KaxiAsmBuf {
    KaxiAsmBuf {
        data: [0; 2097152],
        len: 0,
    }
}

pub fn kaxi_asm_push_byte(buf: KaxiAsmBuf, b: i8) -> KaxiAsmBuf with Mut, Panic {
    var out = buf
    if out.len >= 0 && out.len < 2097152 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

pub fn kaxi_asm_push_str(buf: KaxiAsmBuf, s: string) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 2097152 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

pub fn kaxi_asm_push_line(buf: KaxiAsmBuf, s: string) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = kaxi_asm_push_str(buf, s)
    out = kaxi_asm_push_byte(out, 10) // newline
    out
}

pub fn kaxi_asm_buf_append(a: KaxiAsmBuf, b: KaxiAsmBuf) -> KaxiAsmBuf with Mut, Panic {
    var out = a
    var i: i64 = 0
    while i < b.len && out.len < 2097152 {
        out.data[out.len as usize] = b.data[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn kaxi_asm_char_to_str(ch: i64) -> string with Mut, Panic, Div, Alloc {
    if ch == 10 { return "\n" }
    else if ch == 32 { return " " }
    else if ch == 44 { return "," }
    else if ch == 61 { return "=" }
    else if ch == 42 { return "*" }
    else if ch == 43 { return "+" }
    else if ch == 47 { return "/" }
    else if ch == 58 { return ":" }
    else if ch == 33 { return "!" }
    else if ch == 63 { return "?" }
    else if ch == 64 { return "@" }
    else if ch == 37 { return "%" }
    else if ch == 46 { return "." }
    else if ch == 59 { return ";" }
    else if ch == 95 { return "_" }
    else if ch == 35 { return "#" }
    else if ch == 45 { return "-" }
    else if ch == 60 { return "<" }
    else if ch == 62 { return ">" }
    else if ch == 34 { return "\"" }
    else if ch == 92 { return "\\" }
    else if ch == 124 { return "|" }
    else if ch == 9 { return "\t" }
    else if ch == 38 { return "&" }
    else if ch == 39 { return "'" }
    else if ch == 40 { return "(" }
    else if ch == 41 { return ")" }
    else if ch == 91 { return "[" }
    else if ch == 93 { return "]" }
    else if ch == 123 { return "{" }
    else if ch == 125 { return "}" }
    else if ch == 48 { return "0" }
    else if ch == 49 { return "1" }
    else if ch == 50 { return "2" }
    else if ch == 51 { return "3" }
    else if ch == 52 { return "4" }
    else if ch == 53 { return "5" }
    else if ch == 54 { return "6" }
    else if ch == 55 { return "7" }
    else if ch == 56 { return "8" }
    else if ch == 57 { return "9" }
    else if ch >= 65 && ch <= 90 {
        let base = ch - 65
        if base == 0 { return "A" }
        else if base == 1 { return "B" }
        else if base == 2 { return "C" }
        else if base == 3 { return "D" }
        else if base == 4 { return "E" }
        else if base == 5 { return "F" }
        else if base == 6 { return "G" }
        else if base == 7 { return "H" }
        else if base == 8 { return "I" }
        else if base == 9 { return "J" }
        else if base == 10 { return "K" }
        else if base == 11 { return "L" }
        else if base == 12 { return "M" }
        else if base == 13 { return "N" }
        else if base == 14 { return "O" }
        else if base == 15 { return "P" }
        else if base == 16 { return "Q" }
        else if base == 17 { return "R" }
        else if base == 18 { return "S" }
        else if base == 19 { return "T" }
        else if base == 20 { return "U" }
        else if base == 21 { return "V" }
        else if base == 22 { return "W" }
        else if base == 23 { return "X" }
        else if base == 24 { return "Y" }
        else { return "Z" }
    }
    else if ch >= 97 && ch <= 122 {
        let base = ch - 97
        if base == 0 { return "a" }
        else if base == 1 { return "b" }
        else if base == 2 { return "c" }
        else if base == 3 { return "d" }
        else if base == 4 { return "e" }
        else if base == 5 { return "f" }
        else if base == 6 { return "g" }
        else if base == 7 { return "h" }
        else if base == 8 { return "i" }
        else if base == 9 { return "j" }
        else if base == 10 { return "k" }
        else if base == 11 { return "l" }
        else if base == 12 { return "m" }
        else if base == 13 { return "n" }
        else if base == 14 { return "o" }
        else if base == 15 { return "p" }
        else if base == 16 { return "q" }
        else if base == 17 { return "r" }
        else if base == 18 { return "s" }
        else if base == 19 { return "t" }
        else if base == 20 { return "u" }
        else if base == 21 { return "v" }
        else if base == 22 { return "w" }
        else if base == 23 { return "x" }
        else if base == 24 { return "y" }
        else { return "z" }
    }
    else { return "?" }
}

pub fn kaxi_asm_to_string(buf: KaxiAsmBuf) -> string with Mut, Panic, Div, Alloc {
    var s = ""
    var i: i64 = 0
    while i < buf.len {
        let ch = buf.data[i as usize] as i64
        s = str_concat(s, kaxi_asm_char_to_str(ch))
        i = i + 1
    }
    s
}

// Line-at-a-time stdout emit: avoids O(n^2) giant-string corruption past ~64 KiB.
pub fn kaxi_asm_print_lines(buf: KaxiAsmBuf) with IO, Mut, Panic, Div, Alloc {
    var i: i64 = 0
    var line: string = ""
    while i < buf.len {
        let ch = buf.data[i as usize] as i64
        if ch == 10 {
            println(line)
            line = ""
        } else {
            line = str_concat(line, kaxi_asm_char_to_str(ch))
        }
        i = i + 1
    }
    if str_len(line) > 0 { println(line) }
}

fn kaxi_asm_buf_contains(buf: KaxiAsmBuf, needle: string) -> bool with Mut, Panic, Div {
    let nlen = str_len(needle)
    if nlen == 0 { return true }
    if buf.len < nlen { return false }
    var i: i64 = 0
    while i <= buf.len - nlen {
        var j: i64 = 0
        var matched: bool = true
        while j < nlen {
            if buf.data[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched { return true }
        i = i + 1
    }
    false
}

// ============================================================================
// Confidence-budget header — Phase J epistemic-PTX
//
// Each kernel may declare a compile-time confidence budget on a header line:
//
//     ; conf_budget=<int 0..1000>
//
// 1000 = max-confidence (default when absent), 0 = no-confidence (refused
// under any positive policy threshold). The K-AXI → PTX driver consults this
// against a `--min-conf=<N>` policy and *refuses to lower the kernel body*
// when budget < min_conf. Compile-time, not runtime — the genuine novelty:
// the GPU never sees a kernel whose epistemic budget is below policy.
// ============================================================================

pub fn kaxi_asm_push_conf_budget(buf: KaxiAsmBuf, budget: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = kaxi_asm_push_str(out, "; conf_budget=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(budget))
    out = kaxi_asm_push_byte(out, 10)
    out
}

// Scans the assembly buffer for the literal "; conf_budget=" and parses the
// integer that follows. Returns 1000 (max confidence) when the header is
// absent — keeps existing kernels backward-compatible with confidence gating.
pub fn kaxi_asm_get_conf_budget(buf: KaxiAsmBuf) -> i64 with Mut, Panic, Div {
    // Pattern: "; conf_budget=" — bytes: ';'=59 ' '=32 'c'=99 'o'=111 'n'=110
    //   'f'=102 '_'=95 'b'=98 'u'=117 'd'=100 'g'=103 'e'=101 't'=116 '='=61
    let pat_len: i64 = 14
    if buf.len < pat_len { return 1000 }
    var i: i64 = 0
    while i <= buf.len - pat_len {
        if buf.data[i as usize] as i8 == 59
           && buf.data[(i + 1) as usize] as i8 == 32
           && buf.data[(i + 2) as usize] as i8 == 99
           && buf.data[(i + 3) as usize] as i8 == 111
           && buf.data[(i + 4) as usize] as i8 == 110
           && buf.data[(i + 5) as usize] as i8 == 102
           && buf.data[(i + 6) as usize] as i8 == 95
           && buf.data[(i + 7) as usize] as i8 == 98
           && buf.data[(i + 8) as usize] as i8 == 117
           && buf.data[(i + 9) as usize] as i8 == 100
           && buf.data[(i + 10) as usize] as i8 == 103
           && buf.data[(i + 11) as usize] as i8 == 101
           && buf.data[(i + 12) as usize] as i8 == 116
           && buf.data[(i + 13) as usize] as i8 == 61 {
            // Parse decimal digits after '='
            var p: i64 = i + pat_len
            var n: i64 = 0
            var any: bool = false
            while p < buf.len {
                let c = buf.data[p as usize] as i64
                if c >= 48 && c <= 57 {
                    n = n * 10 + (c - 48)
                    any = true
                    p = p + 1
                } else {
                    break
                }
            }
            if any { return n }
            return 1000
        }
        i = i + 1
    }
    1000
}

// True when budget >= min_conf. min_conf <= 0 disables the gate (returns true).
pub fn kaxi_check_conf_policy(buf: KaxiAsmBuf, min_conf: i64) -> bool with Mut, Panic, Div {
    if min_conf <= 0 { return true }
    let budget = kaxi_asm_get_conf_budget(buf)
    budget >= min_conf
}

// Build the refusal-PTX header used in place of the kernel body when the
// emit-time confidence policy fails. Output is valid (empty) PTX with a
// machine-readable comment that downstream tools can grep for.
pub fn kaxi_conf_reject_ptx(budget: i64, min_conf: i64) -> string with Mut, Panic, Div, Alloc {
    var s: string = ".version 7.0\n.target sm_50\n.address_size 64\n\n"
    s = str_concat(s, "// CONF_REJECT: budget=")
    s = str_concat(s, kaxi_i64_to_string(budget))
    s = str_concat(s, " < min_conf=")
    s = str_concat(s, kaxi_i64_to_string(min_conf))
    s = str_concat(s, " — kernel refused at K-AXI->PTX emit time.\n")
    s = str_concat(s, "// No .entry emitted; downstream ptxas must not be invoked.\n")
    s
}

// ============================================================================
// GPU IR -> K-AXI lowerer (parallel arrays input, matching cpu_ir_interpreter.sio)
// ============================================================================

pub fn gpu_lower_to_kaxi(
    ops_opcodes: [i64; 256],
    ops_dst: [i64; 256],
    ops_src_a: [i64; 256],
    ops_src_b: [i64; 256],
    ops_imm: [i64; 256],
    ops_count: i64
) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var buf = kaxi_asm_new()
    buf = kaxi_asm_push_line(buf, "; K-AXI epistemic kernel assembly")
    buf = kaxi_asm_push_line(buf, "; Auto-generated by gpu_lower_to_kaxi()")
    buf = kaxi_asm_push_line(buf, "")

    var seq: i64 = 0
    var oi: i64 = 0
    while oi < ops_count {
        if oi < 256 {
            let opc = ops_opcodes[oi as usize]
            let dst = ops_dst[oi as usize]
            let src_a = ops_src_a[oi as usize]
            let src_b = ops_src_b[oi as usize]
            let imm = ops_imm[oi as usize]

            if opc == GPU_IR_ADD {
                buf = kaxi_asm_append_add(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_SUB {
                buf = kaxi_asm_append_sub(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_MUL {
                buf = kaxi_asm_append_mul(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_DIV {
                buf = kaxi_asm_append_div(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_FMA {
                buf = kaxi_asm_append_fma(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_MIN {
                buf = kaxi_asm_append_min(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_MAX {
                buf = kaxi_asm_append_max(buf, dst, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_ABS {
                buf = kaxi_asm_append_abs(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_NEG {
                buf = kaxi_asm_append_neg(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_SQRT {
                buf = kaxi_asm_append_sqrt(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_RECIP {
                buf = kaxi_asm_append_recip(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_LOG {
                buf = kaxi_asm_append_log(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_EXP {
                buf = kaxi_asm_append_exp(buf, dst, src_a, seq)
            }
            else if opc == GPU_IR_SIN {
                buf = kaxi_asm_append_sin(buf, dst, src_a, seq)
            }
            else if opc == GPU_IR_COS {
                buf = kaxi_asm_append_cos(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_RSQRT {
                buf = kaxi_asm_append_rsqrt(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_GETVAR {
                buf = kaxi_asm_append_getvar(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_GET_TID {
                buf = kaxi_asm_append_get_tid(buf, dst, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_GET_BID {
                buf = kaxi_asm_append_get_bid(buf, dst, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_GET_NTID {
                buf = kaxi_asm_append_get_ntid(buf, dst, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_GET_NCTAID {
                buf = kaxi_asm_append_get_nctaid(buf, dst, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_MUL_IMM {
                // Immediate ops currently lower to a K-AXI load_imm transaction.
                buf = kaxi_asm_append_load_imm(buf, dst, imm, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_ADD_IMM {
                // Immediate ops currently lower to a K-AXI load_imm transaction.
                buf = kaxi_asm_append_load_imm(buf, dst, imm, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_LOAD_PARAM {
                buf = kaxi_asm_append_load_param(buf, dst, imm, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_LOAD_GLOBAL {
                buf = kaxi_asm_append_load_global(buf, dst, src_a, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_STORE_GLOBAL {
                buf = kaxi_asm_append_store_global(buf, src_a, src_b, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_RET {
                buf = kaxi_asm_append_ret(buf, seq)
                seq = seq + 1
            }
            else if opc == GPU_IR_BARRIER_SYNC {
                buf = kaxi_asm_append_barrier(buf, seq)
                seq = seq + 1
            }
            else {
                buf = kaxi_asm_append_nop(buf, opc, seq)
                seq = seq + 1
            }
        }
        oi = oi + 1
    }

    buf = kaxi_asm_push_line(buf, "")
    buf = kaxi_asm_push_line(buf, "; end")
    buf
}

// ============================================================================
// Assembly instruction emitters (text)
// ============================================================================

fn kaxi_digit_to_string(d: i64) -> string {
    if d == 0 { "0" }
    else if d == 1 { "1" }
    else if d == 2 { "2" }
    else if d == 3 { "3" }
    else if d == 4 { "4" }
    else if d == 5 { "5" }
    else if d == 6 { "6" }
    else if d == 7 { "7" }
    else if d == 8 { "8" }
    else { "9" }
}

fn kaxi_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == 0 { return "0" }
    if n < 0 {
        return str_concat("-", kaxi_i64_to_string(-n))
    }
    if n < 10 {
        return kaxi_digit_to_string(n)
    }
    if n < 100 {
        let tens = kaxi_digit_to_string(n / 10)
        let ones = kaxi_digit_to_string(n % 10)
        return str_concat(tens, ones)
    }
    if n < 1000 {
        // Bug fix (Phase J): the prior recursive form used kaxi_i64_to_string(n % 100)
        // which dropped a digit when n % 100 < 10 (e.g. 300 → "3" + "0" = "30").
        // Build all three digits explicitly with zero-padding semantics.
        let hundreds = kaxi_digit_to_string(n / 100)
        let tens = kaxi_digit_to_string((n / 10) % 10)
        let ones = kaxi_digit_to_string(n % 10)
        return str_concat(str_concat(hundreds, tens), ones)
    }
    if n < 10000 {
        let thousands = kaxi_digit_to_string(n / 1000)
        let hundreds = kaxi_digit_to_string((n / 100) % 10)
        let tens = kaxi_digit_to_string((n / 10) % 10)
        let ones = kaxi_digit_to_string(n % 10)
        return str_concat(str_concat(str_concat(thousands, hundreds), tens), ones)
    }
    "?"
}

fn kaxi_asm_append_add(buf: KaxiAsmBuf, dst: i64, src_a: i64, src_b: i64, seq: i64) -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var out = buf
    out = kaxi_asm_push_str(out, "add r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(dst))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src_a))
    out = kaxi_asm_push_str(out, ", r")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(src_b))
    out = kaxi_asm_push_str(out, ", var=+12.5%, seq=")
    out = kaxi_asm_push_str(out, kaxi_i64_to_string(seq))
    out = kaxi_asm_push_byte(out, 10)
    out
}

