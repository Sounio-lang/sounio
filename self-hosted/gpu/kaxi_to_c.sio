// self-hosted/gpu/kaxi_to_c.sio — K-AXI → C transpiler
//
// Generates host-runnable C code from K-AXI assembly text.
// Uses global per-lane register/predicate arrays for cross-lane ops.
// Emits goto labels for branch/reconverge divergence.

use gpu::kaxi_backend::*

pub fn kaxi_transpile_to_c(asm: KaxiAsmBuf) -> string with Mut, Panic, Div, Alloc {
    var out: KaxiAsmBuf = kaxi_asm_new()
    out = kaxi_asm_push_str(out, "#include <stdio.h>\n")
    out = kaxi_asm_push_str(out, "void kaxi_kernel(int tid, long long mem[1024], long long shared_mem[256]) {\n")
    out = kaxi_asm_push_str(out, "    long long *reg_val = kaxi_lane_reg[tid];\n")
    out = kaxi_asm_push_str(out, "    int *pred = kaxi_lane_pred[tid];\n")
    out = kaxi_asm_push_str(out, "    (void)tid;\n")

    var line_start: i64 = 0
    var i: i64 = 0
    var instr_idx: i64 = 0
    while i <= asm.len {
        let is_end = i == asm.len
        let is_newline = if i < asm.len { asm.data[i as usize] as i8 == 10 } else { true }
        if is_end || is_newline {
            let line_len = i - line_start
            if line_len > 0 {
                let first_char = asm.data[line_start as usize] as i8
                if first_char != 59 && first_char != 0 {
                    let c = kaxi_transpile_line_to_c(asm, line_start, line_len)
                    out = kaxi_asm_push_str(out, "    L")
                    out = kaxi_asm_push_str(out, int_to_string(instr_idx))
                    out = kaxi_asm_push_str(out, ": ")
                    if str_len(c) > 0 {
                        out = kaxi_asm_push_str(out, c)
                    } else {
                        out = kaxi_asm_push_str(out, "// nop")
                    }
                    out = kaxi_asm_push_byte(out, 10)
                    instr_idx = instr_idx + 1
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }

    out = kaxi_asm_push_str(out, "}\n")
    kaxi_asm_to_string(out)
}

pub fn kaxi_transpile_to_c_standalone(asm: KaxiAsmBuf, warp_size: i64) -> string with Mut, Panic, Div, Alloc {
    let kernel = kaxi_transpile_to_c(asm)
    var out: KaxiAsmBuf = kaxi_asm_new()
    out = kaxi_asm_push_str(out, "#include \"self-hosted/gpu/kaxi_c_runtime.h\"\n")
    out = kaxi_asm_push_str(out, kernel)
    out = kaxi_asm_push_str(out, "int main() {\n")
    out = kaxi_asm_push_str(out, "    long long mem[1024] = {0};\n")
    if warp_size > 1 {
        out = kaxi_asm_push_str(out, "    kaxi_run_warp(kaxi_kernel, mem, ")
        out = kaxi_asm_push_str(out, int_to_string(warp_size))
        out = kaxi_asm_push_str(out, ");\n")
    } else {
        out = kaxi_asm_push_str(out, "    kaxi_run_scalar(kaxi_kernel, mem);\n")
    }
    out = kaxi_asm_push_str(out, "    kaxi_dump_mem(\"MEM\", mem, 16);\n")
    out = kaxi_asm_push_str(out, "    return 0;\n")
    out = kaxi_asm_push_str(out, "}\n")
    kaxi_asm_to_string(out)
}

pub fn kaxi_transpile_line_to_c(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    let c0 = asm.data[line_start as usize] as i8
    let c1 = if line_len > 1 { asm.data[(line_start + 1) as usize] as i8 } else { 0 }
    let c2 = if line_len > 2 { asm.data[(line_start + 2) as usize] as i8 } else { 0 }
    let c3 = if line_len > 3 { asm.data[(line_start + 3) as usize] as i8 } else { 0 }

    if c0 == 97 && c1 == 100 && c2 == 100 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return kaxi_c_binop(dst, src_a, src_b, "+")
        }
    }
    else if c0 == 115 && c1 == 117 && c2 == 98 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return kaxi_c_binop(dst, src_a, src_b, "-")
        }
    }
    else if c0 == 109 && c1 == 117 && c2 == 108 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return kaxi_c_binop(dst, src_a, src_b, "*")
        }
    }
    else if c0 == 100 && c1 == 105 && c2 == 118 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return kaxi_c_binop(dst, src_a, src_b, "/")
        }
    }
    else if c0 == 102 && c1 == 109 && c2 == 97 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return kaxi_c_fma(dst, src_a, src_b)
        }
    }
    else if c0 == 108 && c1 == 111 && c2 == 97 {
        if line_len > 11 && asm.data[(line_start + 5) as usize] as i8 == 103 {
            // load_global
            let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
            let addr = kaxi_parse_reg_after(asm, line_start, line_len, "addr=r")
            if dst >= 0 && addr >= 0 {
                return reg_str(dst) + " = mem[" + reg_str(addr) + "];"
            }
        }
        else if line_len > 11 && asm.data[(line_start + 5) as usize] as i8 == 115 {
            // load_shared
            let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
            let addr = kaxi_parse_reg_after(asm, line_start, line_len, "addr=r")
            if dst >= 0 && addr >= 0 {
                return reg_str(dst) + " = shared_mem[" + reg_str(addr) + "];"
            }
        }
        else {
            // load_imm rD, imm=N
            let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
            let imm = kaxi_parse_imm_after(asm, line_start, line_len, "imm=")
            if dst >= 0 {
                return reg_str(dst) + " = " + int_to_string(imm) + ";"
            }
        }
    }
    else if c0 == 115 && c1 == 116 && c2 == 111 {
        // store_global / store_shared
        if line_len > 12 && asm.data[(line_start + 6) as usize] as i8 == 103 {
            let src = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
            let addr = kaxi_parse_reg_after(asm, line_start, line_len, "addr=r")
            if src >= 0 && addr >= 0 {
                return "mem[" + reg_str(addr) + "] = " + reg_str(src) + ";"
            }
        }
        else if line_len > 12 && asm.data[(line_start + 6) as usize] as i8 == 115 {
            let src = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
            let addr = kaxi_parse_reg_after(asm, line_start, line_len, "addr=r")
            if src >= 0 && addr >= 0 {
                return "shared_mem[" + reg_str(addr) + "] = " + reg_str(src) + ";"
            }
        }
    }
    else if c0 == 103 && c1 == 101 && c2 == 116 {
        // get_tid / get_bid / get_ntid — dispatch on char-after-underscore (pos 4)
        let kind = if line_len > 4 { asm.data[(line_start + 4) as usize] as i8 } else { 116 }
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        if dst >= 0 {
            if kind == 98 { return reg_str(dst) + " = 0;" }
            else if kind == 110 { return reg_str(dst) + " = 1;" }
            else { return reg_str(dst) + " = tid;" }
        }
    }
    else if c0 == 114 && c1 == 101 && c2 == 116 {
        return "return;"
    }
    else if c0 == 98 && c1 == 97 && c2 == 114 {
        return "// barrier"
    }
    else if c0 == 115 && c1 == 101 && c2 == 116 && c3 == 112 {
        let cmp = kaxi_parse_setp_cmp(asm, line_start, line_len)
        let dst = kaxi_parse_reg(asm, line_start, line_len, "p", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return pred_str(dst) + " = " + reg_str(src_a) + " " + cmp + " " + reg_str(src_b) + ";"
        }
    }
    else if c0 == 115 && c1 == 101 && c2 == 108 && c3 == 112 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = kaxi_parse_reg(asm, line_start, line_len, "r", 2)
        let pred = kaxi_parse_reg_after(asm, line_start, line_len, "pred=p")
        if dst >= 0 && src_a >= 0 && src_b >= 0 && pred >= 0 {
            return reg_str(dst) + " = " + pred_str(pred) + " ? " + reg_str(src_a) + " : " + reg_str(src_b) + ";"
        }
    }
    else if c0 == 110 && c1 == 111 && c2 == 112 {
        return "// nop"
    }
    else if c0 == 98 && c1 == 114 && c2 == 97 {
        let pred_idx = kaxi_parse_reg(asm, line_start, line_len, "p", 0)
        let target = kaxi_parse_imm_after(asm, line_start, line_len, "target=")
        if pred_idx >= 0 && target >= 0 {
            return "if (" + pred_str(pred_idx) + ") goto L" + int_to_string(target) + ";"
        }
    }
    else if c0 == 114 && c1 == 101 && c2 == 99 {
        return "// reconverge"
    }
    else if c0 == 118 && c1 == 111 && c2 == 116 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "p", 0)
        if dst >= 0 && src_a >= 0 {
            return reg_str(dst) + " = kaxi_vote_ballot(tid, " + int_to_string(src_a) + ");"
        }
    }
    else if c0 == 115 && c1 == 104 && c2 == 117 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        let imm = kaxi_parse_imm_after(asm, line_start, line_len, "imm=")
        if dst >= 0 && src_a >= 0 {
            return reg_str(dst) + " = kaxi_shuffle_xor(tid, " + int_to_string(src_a) + ", " + int_to_string(imm) + ");"
        }
    }
    else if c0 == 119 && c1 == 97 && c2 == 114 {
        let dst = kaxi_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = kaxi_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 {
            return reg_str(dst) + " = kaxi_warp_reduce_add(tid, " + int_to_string(src_a) + ");"
        }
    }

    ""
}

// Parser helpers

fn kaxi_parse_reg(asm: KaxiAsmBuf, line_start: i64, line_len: i64, prefix: string, nth: i64) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    var end_pos: i64 = line_start + line_len
    var found: i64 = 0
    let prefix_len = str_len(prefix)
    while pos < end_pos {
        var match_prefix = true
        var pi: i64 = 0
        while pi < prefix_len {
            if (pos + pi) >= end_pos || asm.data[(pos + pi) as usize] as i8 != str_char_at(prefix, pi) {
                match_prefix = false
            }
            pi = pi + 1
        }
        if match_prefix {
            pos = pos + prefix_len
            var num: i64 = 0
            var has_digit: bool = false
            while pos < end_pos {
                let ch = asm.data[pos as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    has_digit = true
                    pos = pos + 1
                } else {
                    break
                }
            }
            if has_digit {
                if found == nth {
                    return num
                }
                found = found + 1
            }
        } else {
            pos = pos + 1
        }
    }
    0 - 1
}

fn kaxi_parse_imm_after(asm: KaxiAsmBuf, line_start: i64, line_len: i64, needle: string) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            var num: i64 = 0
            var neg: bool = false
            if pos < end_pos && asm.data[pos as usize] as i8 == 45 {
                neg = true
                pos = pos + 1
            }
            var scan = pos
            while scan < end_pos {
                let ch = asm.data[scan as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    scan = scan + 1
                } else {
                    break
                }
            }
            pos = scan
            if neg { num = 0 - num }
            return num
        }
        pos = pos + 1
    }
    0
}

fn kaxi_parse_reg_after(asm: KaxiAsmBuf, line_start: i64, line_len: i64, needle: string) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            var num: i64 = 0
            var scan = pos
            while scan < end_pos {
                let ch = asm.data[scan as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    scan = scan + 1
                } else {
                    break
                }
            }
            pos = scan
            return num
        }
        pos = pos + 1
    }
    0 - 1
}

fn kaxi_parse_setp_cmp(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len > 7 {
        let c0 = asm.data[(line_start + 5) as usize] as i8
        let c1 = asm.data[(line_start + 6) as usize] as i8
        if c0 == 108 && c1 == 116 { return "<" }
        if c0 == 108 && c1 == 101 { return "<=" }
        if c0 == 101 && c1 == 113 { return "==" }
        if c0 == 103 && c1 == 101 { return ">=" }
        if c0 == 103 && c1 == 116 { return ">" }
        if c0 == 110 && c1 == 101 { return "!=" }
    }
    "=="
}

// String builders (using string concatenation to avoid array pass-by-value issue)

pub fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { -n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit
            result = char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 48 { "0" }
    else if n == 49 { "1" }
    else if n == 50 { "2" }
    else if n == 51 { "3" }
    else if n == 52 { "4" }
    else if n == 53 { "5" }
    else if n == 54 { "6" }
    else if n == 55 { "7" }
    else if n == 56 { "8" }
    else { "9" }
}

fn reg_str(idx: i64) -> string with Mut, Panic, Div {
    "reg_val[" + int_to_string(idx) + "]"
}

fn pred_str(idx: i64) -> string with Mut, Panic, Div {
    "pred[" + int_to_string(idx) + "]"
}

fn kaxi_c_binop(dst: i64, src_a: i64, src_b: i64, op: string) -> string with Mut, Panic, Div, Alloc {
    reg_str(dst) + " = " + reg_str(src_a) + " " + op + " " + reg_str(src_b) + ";"
}

fn kaxi_c_fma(dst: i64, src_a: i64, src_b: i64) -> string with Mut, Panic, Div, Alloc {
    reg_str(dst) + " = " + reg_str(src_a) + " * " + reg_str(src_b) + " + " + reg_str(src_a) + ";"
}
