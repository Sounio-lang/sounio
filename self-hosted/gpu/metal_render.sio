// Metal Shading Language (MSL) graphics pipeline emitter
//
// Emits MSL source for a Vulkan-style vertex+fragment render pipeline.
// Output is UTF-8 text suitable for Metal shader compilation via
// Xcode or metal command-line tools.
//
// Vertex shader: in_position (attribute(0)) + in_color (attribute(1))
//                → clip_position (builtin) + frag_color
// Fragment shader: frag_color → out_color (color(0))

// ============================================================================
// MetalRenderBuf — text buffer for MSL source output
// ============================================================================

struct MetalRenderBuf {
    data: [i8; 8192],
    len: i64,
}

fn mrend_buf_new() -> MetalRenderBuf {
    MetalRenderBuf { data: [0; 8192], len: 0 }
}

fn mrend_push_byte(buf: MetalRenderBuf, b: i8) -> MetalRenderBuf with Mut, Panic {
    var out = buf
    if out.len < 8192 {
        out.data[out.len] = b
        out.len = out.len + 1
    }
    out
}

// Push ASCII string
fn mrend_push_str(buf: MetalRenderBuf, s: string) -> MetalRenderBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = mrend_push_byte(out, str_char_at(s, i) as i8)
        i = i + 1
    }
    out
}

// ============================================================================
// Emit vertex struct + VertexOut struct
// ============================================================================

fn mrend_emit_structs(buf: MetalRenderBuf) -> MetalRenderBuf with Mut, Panic, Div {
    var b = buf
    b = mrend_push_str(b, "#include <metal_stdlib>\n")
    b = mrend_push_str(b, "using namespace metal;\n\n")
    b = mrend_push_str(b, "struct VertexIn {\n")
    b = mrend_push_str(b, "    float4 position [[attribute(0)]];\n")
    b = mrend_push_str(b, "    float4 color    [[attribute(1)]];\n")
    b = mrend_push_str(b, "};\n\n")
    b = mrend_push_str(b, "struct VertexOut {\n")
    b = mrend_push_str(b, "    float4 position [[position]];\n")
    b = mrend_push_str(b, "    float4 color;\n")
    b = mrend_push_str(b, "};\n\n")
    b
}

// ============================================================================
// Emit vertex shader
// ============================================================================

fn metal_emit_vertex_shader(buf: MetalRenderBuf) -> MetalRenderBuf with Mut, Panic, Div {
    var b = buf
    b = mrend_push_str(b, "vertex VertexOut vertex_main(\n")
    b = mrend_push_str(b, "    VertexIn in [[stage_in]]\n")
    b = mrend_push_str(b, ") {\n")
    b = mrend_push_str(b, "    VertexOut out;\n")
    b = mrend_push_str(b, "    out.position = in.position;\n")
    b = mrend_push_str(b, "    out.color = in.color;\n")
    b = mrend_push_str(b, "    return out;\n")
    b = mrend_push_str(b, "}\n\n")
    b
}

// ============================================================================
// Emit fragment shader
// ============================================================================

fn metal_emit_fragment_shader(buf: MetalRenderBuf) -> MetalRenderBuf with Mut, Panic, Div {
    var b = buf
    b = mrend_push_str(b, "fragment float4 fragment_main(\n")
    b = mrend_push_str(b, "    VertexOut in [[stage_in]]\n")
    b = mrend_push_str(b, ") {\n")
    b = mrend_push_str(b, "    return in.color;\n")
    b = mrend_push_str(b, "}\n")
    b
}

// ============================================================================
// Emit complete graphics pipeline MSL source
// ============================================================================

fn metal_emit_render_pipeline() -> MetalRenderBuf with Mut, Panic, Div {
    var b = mrend_buf_new()
    b = mrend_emit_structs(b)
    b = metal_emit_vertex_shader(b)
    b = metal_emit_fragment_shader(b)
    b
}

// Print generated MSL to stdout
fn metal_render_print(buf: MetalRenderBuf) with IO, Mut, Panic, Div {
    print("// Metal render pipeline MSL (")
    print_int(buf.len)
    print(" bytes)\n")
    var i: i64 = 0
    while i < buf.len {
        let c = buf.data[i]
        print_char(c)
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let buf = metal_emit_render_pipeline()
    metal_render_print(buf)
    0
}
