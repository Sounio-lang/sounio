// self-hosted/gpu/kaxi_to_ptx.sio — K-AXI → PTX transpiler
//
// Generates ptxas-assemblable PTX from K-AXI assembly text.
// Mirrors kaxi_to_c.sio shape; lowers each K-AXI instruction to one or more
// PTX instructions inside a single .visible .entry kaxi_kernel(.param .u64 mem).
//
// Register convention:
//   K-AXI rN  → PTX %rdN  (.b64)        — declared as %rd<70> bank
//   K-AXI pN  → PTX %pN   (.pred)       — declared as %p<64> bank
//   %rd63     reserved as base ptr (loaded once from param_mem)
//   %rd256..69 scratch for address arithmetic and warp-op widening
//   %r1..%r4  32-bit scratch for special regs (%tid.x, vote, shfl)
//
// Memory model:
//   K-AXI mem[r] is a u64 array; PTX lowers to (param_mem + r*8) → ld/st .global.u64
//   shared_mem is emitted as a TODO comment; the K-AXI shared kernels still
//   exercise scalar paths that pass via the C differential.

use gpu::kaxi_backend::{KaxiAsmBuf, kaxi_asm_new, kaxi_asm_push_byte, kaxi_asm_to_string}

pub fn kaxi_transpile_line_to_ptx(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase C.3: post-C.2 only the dialect-specific TODO comments
    // (load_shared / store_shared) and the predicate/control/warp-op
    // branches (setp/selp/bra/rec/vote/shuffle/warp) are reachable here.
    // arith / mem / get / ret / nop / bar are handled by the per-opcode
    // helpers in unified before this fallback.
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = if line_len > 1 { asm.data[(line_start + 1) as usize] as i8 } else { 0 as i8 }
    let c2 = if line_len > 2 { asm.data[(line_start + 2) as usize] as i8 } else { 0 as i8 }
    let c3 = if line_len > 3 { asm.data[(line_start + 3) as usize] as i8 } else { 0 as i8 }
    if c0 == 108 && c1 == 111 && c2 == 97 && line_len > 11 && asm.data[(line_start + 5) as usize] as i8 == 115 {
        return "    // TODO load_shared\n"
    }
    if c0 == 115 && c1 == 116 && c2 == 111 && line_len > 12 && asm.data[(line_start + 6) as usize] as i8 == 115 {
        return "    // TODO store_shared\n"
    }
    if c0 == 115 && c1 == 101 && c2 == 116 && c3 == 112 {
        let cmp = ptx_parse_setp_cmp(asm, line_start, line_len)
        let dst = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return "    setp." + cmp + ".u64 " + pp(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
        }
    }
    if c0 == 115 && c1 == 101 && c2 == 108 && c3 == 112 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
        let pred = ptx_parse_reg_after(asm, line_start, line_len, "pred=p")
        if dst >= 0 && src_a >= 0 && src_b >= 0 && pred >= 0 {
            return "    selp.b64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ", " + pp(pred) + ";\n"
        }
    }
    if c0 == 98 && c1 == 114 && c2 == 97 {
        let pred_idx = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        let target = ptx_parse_imm_after(asm, line_start, line_len, "target=")
        if pred_idx >= 0 && target >= 0 {
            return "    @" + pp(pred_idx) + " bra L" + ptx_int_to_string(target) + ";\n"
        }
    }
    if c0 == 114 && c1 == 101 && c2 == 99 { return "    // reconverge\n" }
    if c0 == 118 && c1 == 111 && c2 == 116 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        if dst >= 0 && src_a >= 0 {
            return "    vote.sync.ballot.b32 %r2, " + pp(src_a) + ", 0xffffffff;\n"
                 + "    cvt.u64.u32 " + rd(dst) + ", %r2;\n"
        }
    }
    if c0 == 115 && c1 == 104 && c2 == 117 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        let imm = ptx_parse_imm_after(asm, line_start, line_len, "imm=")
        if dst >= 0 && src_a >= 0 {
            return "    cvt.u32.u64 %r2, " + rd(src_a) + ";\n"
                 + "    shfl.sync.bfly.b32 %r3, %r2, " + ptx_int_to_string(imm) + ", 0x1f, 0xffffffff;\n"
                 + "    cvt.u64.u32 " + rd(dst) + ", %r3;\n"
        }
    }
    if c0 == 119 && c1 == 97 && c2 == 114 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 {
            var s: string = "    cvt.u32.u64 %r2, " + rd(src_a) + ";\n"
            s = s + "    shfl.sync.bfly.b32 %r3, %r2, 16, 0x1f, 0xffffffff;\n"
            s = s + "    add.s32 %r2, %r2, %r3;\n"
            s = s + "    shfl.sync.bfly.b32 %r3, %r2, 8, 0x1f, 0xffffffff;\n"
            s = s + "    add.s32 %r2, %r2, %r3;\n"
            s = s + "    shfl.sync.bfly.b32 %r3, %r2, 4, 0x1f, 0xffffffff;\n"
            s = s + "    add.s32 %r2, %r2, %r3;\n"
            s = s + "    shfl.sync.bfly.b32 %r3, %r2, 2, 0x1f, 0xffffffff;\n"
            s = s + "    add.s32 %r2, %r2, %r3;\n"
            s = s + "    shfl.sync.bfly.b32 %r3, %r2, 1, 0x1f, 0xffffffff;\n"
            s = s + "    add.s32 %r2, %r2, %r3;\n"
            s = s + "    cvt.u64.u32 " + rd(dst) + ", %r2;\n"
            return s
        }
    }
    ""
}

// ----- helpers -----

fn ptx_addr_compute(addr_reg: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase L: scratch %rd256, base %rd258 (was %rd256 + %rd63 — same
    // collision shape Phase I+K fixed for variance + dual-buffer modes).
    "    mul.lo.u64 %rd256, " + rd(addr_reg) + ", 8;\n"
    + "    add.u64 %rd256, %rd258, %rd256;\n"
}

fn ptx_binop(op: string, dst: i64, src_a: i64, src_b: i64) -> string with Mut, Panic, Div, Alloc {
    "    " + op + " " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
}

fn ptx_binop_f64(op: string, dst: i64, src_a: i64, src_b: i64) -> string with Mut, Panic, Div, Alloc {
    "    " + op + " " + fd(dst) + ", " + fd(src_a) + ", " + fd(src_b) + ";\n"
}

fn rd(idx: i64) -> string with Mut, Panic, Div {
    "%rd" + ptx_int_to_string(idx)
}

fn fd(idx: i64) -> string with Mut, Panic, Div, Alloc {
    "%fd" + ptx_int_to_string(idx)
}

fn pp(idx: i64) -> string with Mut, Panic, Div {
    "%p" + ptx_int_to_string(idx)
}

// Scan line for trailing ", type=f64" metadata emitted by kaxi_asm_append_*_f64().
// Returns true if found; does not affect register parsing (metadata is at end of line).
fn kaxi_line_has_type_f64(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> bool with Mut, Panic {
    // "type=f64" = t(116) y(121) p(112) e(101) =(61) f(102) 6(54) 4(52)
    let end = line_start + line_len - 7
    var pos: i64 = line_start
    while pos <= end {
        if asm.data[pos as usize] as i8 == 116 {
            if asm.data[(pos + 1) as usize] as i8 == 121 {
                if asm.data[(pos + 2) as usize] as i8 == 112 {
                    if asm.data[(pos + 3) as usize] as i8 == 101 {
                        if asm.data[(pos + 4) as usize] as i8 == 61 {
                            if asm.data[(pos + 5) as usize] as i8 == 102 {
                                if asm.data[(pos + 6) as usize] as i8 == 54 {
                                    if asm.data[(pos + 7) as usize] as i8 == 52 {
                                        return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
    false
}

fn kaxi_line_has_type_f32(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> bool with Mut, Panic {
    // "type=f32" = t(116) y(121) p(112) e(101) =(61) f(102) 3(51) 2(50)
    let end = line_start + line_len - 7
    var pos: i64 = line_start
    while pos <= end {
        if asm.data[pos as usize] as i8 == 116 {
            if asm.data[(pos + 1) as usize] as i8 == 121 {
                if asm.data[(pos + 2) as usize] as i8 == 112 {
                    if asm.data[(pos + 3) as usize] as i8 == 101 {
                        if asm.data[(pos + 4) as usize] as i8 == 61 {
                            if asm.data[(pos + 5) as usize] as i8 == 102 {
                                if asm.data[(pos + 6) as usize] as i8 == 51 {
                                    if asm.data[(pos + 7) as usize] as i8 == 50 {
                                        return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
    false
}

fn kaxi_line_has_type_i32(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> bool with Mut, Panic {
    // "type=i32" = t(116) y(121) p(112) e(101) =(61) i(105) 3(51) 2(50)
    let end = line_start + line_len - 7
    var pos: i64 = line_start
    while pos <= end {
        if asm.data[pos as usize] as i8 == 116 {
            if asm.data[(pos + 1) as usize] as i8 == 121 {
                if asm.data[(pos + 2) as usize] as i8 == 112 {
                    if asm.data[(pos + 3) as usize] as i8 == 101 {
                        if asm.data[(pos + 4) as usize] as i8 == 61 {
                            if asm.data[(pos + 5) as usize] as i8 == 105 {
                                if asm.data[(pos + 6) as usize] as i8 == 51 {
                                    if asm.data[(pos + 7) as usize] as i8 == 50 {
                                        return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
    false
}

// ---------------------------------------------------------------------------
// Epistemic lowering — GUM variance propagation alongside value computation
// ---------------------------------------------------------------------------
//
// Each K-AXI register rN gets two PTX shadows:
//   value:     %rdN
//   variance:  %rdvN (encoded as %rd(N+32))     — one warp-wide bank
//
// Memory model: two .param pointers
//   param_mem  → values
//   param_var  → variances
// Both indexed by reg-as-index, 8 bytes per element.
//
// Propagation rules (variance):
//   add/sub r3 = a ± b      : σ²(r3) = σ²(a) + σ²(b)
//   mul     r3 = a * b      : if a == b → σ²(r3) = 4·a²·σ²(a)   (delta method, X²)
//                            if a ≠ b  → σ²(r3) = a²σ²(b) + b²σ²(a)  (independent)
//   div, fma                : conservative — sum of input variances scaled by 1
//   load_imm rD, imm=N      : σ²(rD) = 0
//   get_tid/get_bid/get_ntid: σ²(rD) = 0
//   load_global rD, addr=rA : σ²(rD) ← var_mem[rA]
//   store_global rD, addr=rA: var_mem[rA] ← σ²(rD)

// Phase I (2026-05-08): re-segmented register file for variance modes
// (epistemic + f32_epistemic). Value lane lives at %rd0..%rd127,
// variance at %rd128..%rd255, scratch at %rd256/%rd257, dual-buffer
// base ptrs at %rd258/%rd259. Same shape for %f in f32_epistemic.
// This unblocks sedenion_mul (K-AXI rD up to ~113) which Phase H
// discovered was producing wrong values due to value/variance lane
// overlap and scratch/base collisions when rD ≥ 32.
fn ev(idx: i64) -> string with Mut, Panic, Div {
    "%rd" + ptx_int_to_string(idx + 128)
}

pub fn kaxi_transpile_line_to_ptx_epistemic(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase C.3: post-C.2 only load_shared/store_shared TODOs and
    // bra/setp/rec are reachable here.
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = if line_len > 1 { asm.data[(line_start + 1) as usize] as i8 } else { 0 as i8 }
    let c2 = if line_len > 2 { asm.data[(line_start + 2) as usize] as i8 } else { 0 as i8 }
    let c3 = if line_len > 3 { asm.data[(line_start + 3) as usize] as i8 } else { 0 as i8 }
    if c0 == 108 && c1 == 111 && c2 == 97 && line_len > 11 && asm.data[(line_start + 5) as usize] as i8 == 115 {
        return "    // TODO load_shared (epistemic)\n"
    }
    if c0 == 115 && c1 == 116 && c2 == 111 && line_len > 12 && asm.data[(line_start + 6) as usize] as i8 == 115 {
        return "    // TODO store_shared (epistemic)\n"
    }
    if c0 == 114 && c1 == 101 && c2 == 99 { return "    // reconverge\n" }
    if c0 == 98 && c1 == 114 && c2 == 97 {
        let pred_idx = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        let target = ptx_parse_imm_after(asm, line_start, line_len, "target=")
        if pred_idx >= 0 && target >= 0 {
            return "    @" + pp(pred_idx) + " bra L" + ptx_int_to_string(target) + ";\n"
        }
    }
    if c0 == 115 && c1 == 101 && c2 == 116 && c3 == 112 {
        let cmp = ptx_parse_setp_cmp(asm, line_start, line_len)
        let dst = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return "    setp." + cmp + ".u64 " + pp(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
        }
    }
    ""
}

// ---------------------------------------------------------------------------
// f32 lowering — same K-AXI text, but value regs are .f32 and arithmetic
// uses add/sub/mul/div/fma.rn.f32. Element stride 4 bytes.
// ---------------------------------------------------------------------------
//
// Two register banks coexist:
//   .reg .b64 %rd<70>;  — addresses, get_tid/bid/ntid (always integer)
//   .reg .f32 %f<70>;   — values, all f32 arithmetic
//
// load_global rD, addr=rA  → ld.global.f32 %fD,  [&mem + rA*4]
// store_global rD, addr=rA → st.global.f32 [&mem + rA*4], %fD
// add r3, r1, r2           → add.rn.f32 %f3, %f1, %f2
// fma r3, r1, r2           → fma.rn.f32 %f3, %f1, %f2, %f1   (a*b+a, matches u64 path)
// get_tid r0               → %rd0 = tid (f0 unused for tid registers)

fn fr(idx: i64) -> string with Mut, Panic, Div {
    "%f" + ptx_int_to_string(idx)
}

fn ri(idx: i64) -> string with Mut, Panic, Div {
    "%r" + ptx_int_to_string(idx)
}

fn ptx_binop_f32(op: string, dst: i64, src_a: i64, src_b: i64) -> string with Mut, Panic, Div, Alloc {
    "    " + op + " " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
}

fn ptx_binop_i32(op: string, dst: i64, src_a: i64, src_b: i64) -> string with Mut, Panic, Div, Alloc {
    "    " + op + " " + ri(dst) + ", " + ri(src_a) + ", " + ri(src_b) + ";\n"
}

fn ptx_addr_compute_f32(addr_reg: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase L: scratch %rd256, base %rd258.
    "    mul.lo.u64 %rd256, " + rd(addr_reg) + ", 4;\n"
    + "    add.u64 %rd256, %rd258, %rd256;\n"
}

pub fn kaxi_transpile_line_to_ptx_f32(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase C.3: post-C.2 only atomic_addf / setp / selp are reachable here.
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = if line_len > 1 { asm.data[(line_start + 1) as usize] as i8 } else { 0 as i8 }
    let c2 = if line_len > 2 { asm.data[(line_start + 2) as usize] as i8 } else { 0 as i8 }
    if c0 == 97 && c1 == 116 && c2 == 111 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let addr = ptx_parse_reg_after(asm, line_start, line_len, "addr=r")
        let src = ptx_parse_reg_after(asm, line_start, line_len, "src=r")
        if dst >= 0 && addr >= 0 && src >= 0 {
            return ptx_addr_compute_f32(addr)
                 + "    atom.global.add.f32 " + fr(dst) + ", [%rd256], " + fr(src) + ";\n"
        }
    }
    if c0 == 115 && c1 == 101 && c2 == 116 {
        let cmp = ptx_parse_setp_cmp(asm, line_start, line_len)
        let dst = ptx_parse_reg(asm, line_start, line_len, "p", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        if dst >= 0 && src_a >= 0 && src_b >= 0 {
            return "    setp." + cmp + ".f32 " + pp(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
        }
    }
    if c0 == 115 && c1 == 101 && c2 == 108 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
        let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
        let pred = ptx_parse_reg_after(asm, line_start, line_len, "pred=p")
        if dst >= 0 && src_a >= 0 && src_b >= 0 && pred >= 0 {
            return "    selp.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ", " + pp(pred) + ";\n"
        }
    }
    ""
}

// ---------------------------------------------------------------------------
// f32 two-compartment lowering — same K-AXI ops, but load/store_global takes
// a `buf=N` selector (N=0 → param_a, N=1 → param_b). Enables coupled-ODE
// kernels where each thread holds e.g. (C1, C2) on two parallel buffers.
// ---------------------------------------------------------------------------

pub fn kaxi_transpile_line_to_ptx_f32_2c(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase C.3: post-C.2 only atomic_addf is reachable here.
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = if line_len > 1 { asm.data[(line_start + 1) as usize] as i8 } else { 0 as i8 }
    let c2 = if line_len > 2 { asm.data[(line_start + 2) as usize] as i8 } else { 0 as i8 }
    if c0 == 97 && c1 == 116 && c2 == 111 {
        let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
        let addr = ptx_parse_reg_after(asm, line_start, line_len, "addr=r")
        let src = ptx_parse_reg_after(asm, line_start, line_len, "src=r")
        if dst >= 0 && addr >= 0 && src >= 0 {
            return ptx_addr_compute_f32(addr)
                 + "    atom.global.add.f32 " + fr(dst) + ", [%rd256], " + fr(src) + ";\n"
        }
    }
    ""
}

// ---------------------------------------------------------------------------
// f32 epistemic lowering — IEEE 754 values + IEEE 754 variances, GUM rules
// ---------------------------------------------------------------------------
//
// Three register banks coexist:
//   .reg .b64 %rd<70>;  — addresses (param_mem, param_var pointers; tid/bid/ntid)
//   .reg .b32 %r<8>;    — scratch for special-reg conversions
//   .reg .f32 %f<70>;   — values %f<0..31>, variances %f<32..63>
//
// param_mem  → values  (.f32 stride 4)
// param_var  → variances (.f32 stride 4)
//
// Variance rules (matches u64 epistemic, but in f32):
//   add/sub r3 = a±b      σ²(r3) = σ²(a) + σ²(b)
//   mul X²  r3 = a*a      σ²(r3) = 4·a²·σ²(a)
//   mul ind r3 = a*b      σ²(r3) = a²σ²(b) + b²σ²(a)
//   div     conservative  σ²(r3) = σ²(a) + σ²(b)
//   load_imm                σ²(rD) = 0.0f
//   get_tid/bid/ntid        σ²(rD) = 0.0f
//   load_global rD,addr=rA  σ²(rD) ← param_var[rA]
//   store_global            param_var[rA] ← σ²(rD)

fn fv(idx: i64) -> string with Mut, Panic, Div {
    // Phase I: variance lane offset 32 → 128 (see ev()).
    "%f" + ptx_int_to_string(idx + 128)
}

fn ptx_addr_compute_f32e(addr_reg: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase I: scratch moved out of value-lane region (was %rd256).
    "    mul.lo.u64 %rd256, " + rd(addr_reg) + ", 4;\n"
}

pub fn kaxi_transpile_line_to_ptx_f32_epistemic(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase C.3: all 10 branches (add/sub/mul/div/fma/load/store/get/ret/nop)
    // extracted into per-opcode helpers in C.2. Fully unreachable; stub kept
    // as the unified dispatcher needs the symbol resolvable.
    ""
}

// Parsers (independent copies — kaxi_to_c.sio's are private)

fn ptx_parse_reg(asm: KaxiAsmBuf, line_start: i64, line_len: i64, prefix: string, nth: i64) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    var end_pos: i64 = line_start + line_len
    var found: i64 = 0
    let prefix_len = str_len(prefix)
    while pos < end_pos {
        var match_prefix = true
        var pi: i64 = 0
        while pi < prefix_len {
            if (pos + pi) >= end_pos || asm.data[(pos + pi) as usize] as i8 != str_char_at(prefix, pi) {
                match_prefix = false
            }
            pi = pi + 1
        }
        if match_prefix {
            pos = pos + prefix_len
            var num: i64 = 0
            var has_digit: bool = false
            while pos < end_pos {
                let ch = asm.data[pos as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    has_digit = true
                    pos = pos + 1
                } else {
                    break
                }
            }
            if has_digit {
                if found == nth {
                    return num
                }
                found = found + 1
            }
        } else {
            pos = pos + 1
        }
    }
    0 - 1
}

fn ptx_parse_imm_after(asm: KaxiAsmBuf, line_start: i64, line_len: i64, needle: string) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            var num: i64 = 0
            var neg: bool = false
            if pos < end_pos && asm.data[pos as usize] as i8 == 45 {
                neg = true
                pos = pos + 1
            }
            var scan = pos
            while scan < end_pos {
                let ch = asm.data[scan as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    scan = scan + 1
                } else {
                    break
                }
            }
            pos = scan
            if neg { num = 0 - num }
            return num
        }
        pos = pos + 1
    }
    0
}

fn ptx_parse_reg_after(asm: KaxiAsmBuf, line_start: i64, line_len: i64, needle: string) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            var num: i64 = 0
            var scan = pos
            while scan < end_pos {
                let ch = asm.data[scan as usize] as i8
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as i64
                    scan = scan + 1
                } else {
                    break
                }
            }
            pos = scan
            return num
        }
        pos = pos + 1
    }
    0 - 1
}

// Read a single decimal digit (0..9) after "buf=" in a K-AXI line. Returns 0 if absent.
pub fn ptx_parse_buf(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> i64 with Mut, Panic {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let needle = "buf="
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            if pos < end_pos {
                let ch = asm.data[pos as usize] as i8
                if ch >= 48 && ch <= 57 {
                    return (ch - 48) as i64
                }
            }
            return 0
        }
        pos = pos + 1
    }
    0
}

// Read 8 hex chars after "fimm=" in a K-AXI line. Returns "" if not found.
pub fn ptx_parse_fimm_hex(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    var pos: i64 = line_start
    let end_pos = line_start + line_len
    let needle = "fimm="
    let nlen = str_len(needle)
    while pos + nlen <= end_pos {
        var found = true
        var ni: i64 = 0
        while ni < nlen {
            if asm.data[(pos + ni) as usize] as i8 != str_char_at(needle, ni) {
                found = false
            }
            ni = ni + 1
        }
        if found {
            pos = pos + nlen
            var out_buf: KaxiAsmBuf = kaxi_asm_new()
            var taken: i64 = 0
            while taken < 8 && pos < end_pos {
                let ch = asm.data[pos as usize] as i8
                let is_digit = ch >= 48 && ch <= 57
                let is_lo = ch >= 97 && ch <= 102
                let is_hi = ch >= 65 && ch <= 70
                if is_digit || is_lo || is_hi {
                    out_buf = kaxi_asm_push_byte(out_buf, ch)
                    pos = pos + 1
                    taken = taken + 1
                } else {
                    break
                }
            }
            if taken == 8 {
                return kaxi_asm_to_string(out_buf)
            }
            return ""
        }
        pos = pos + 1
    }
    ""
}

fn ptx_parse_setp_cmp(asm: KaxiAsmBuf, line_start: i64, line_len: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len > 7 {
        let c0 = asm.data[(line_start + 5) as usize] as i8
        let c1 = asm.data[(line_start + 6) as usize] as i8
        if c0 == 108 && c1 == 116 { return "lt" }
        if c0 == 108 && c1 == 101 { return "le" }
        if c0 == 101 && c1 == 113 { return "eq" }
        if c0 == 103 && c1 == 101 { return "ge" }
        if c0 == 103 && c1 == 116 { return "gt" }
        if c0 == 110 && c1 == 101 { return "ne" }
    }
    "eq"
}

pub fn ptx_int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { -n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit
            result = ptx_char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

fn ptx_char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 48 { "0" }
    else if n == 49 { "1" }
    else if n == 50 { "2" }
    else if n == 51 { "3" }
    else if n == 52 { "4" }
    else if n == 53 { "5" }
    else if n == 54 { "6" }
    else if n == 55 { "7" }
    else if n == 56 { "8" }
    else { "9" }
}

// ============================================================
// Phase C.1: unified PTX header dispatch
// Phase C.2: opcode-first decomposition (batch 1: arithmetic)
// ============================================================
//
// PtxMode tag (passed as i64 to keep the lean_single self-host path
// simple; struct-arg passing through the compiler chain is fragile):
//   0 = default          (.f64,  single param_mem)
//   1 = epistemic        (b64-only, dual param_mem/param_var)
//   2 = f32              (.f32,  single param_mem)
//   3 = f32_2c           (.f32,  dual param_a/param_b, half %f bank)
//   4 = f32_epistemic    (.f32,  dual param_mem/param_var)
//
// Phase C.1 unified the header (param decls, register banks, ld.param).
// Phase C.2 decomposes each K-AXI opcode into a single helper that
// handles all 5 dialects internally. Empirically the 5 line handlers
// have *different opcode sets* (18/14/13/11/10 dispatch arms), so a
// per-dialect line handler is the wrong unit; the per-opcode helper is.
//
// Drift oracle: `scripts/ci/kaxi_ptx_golden_gate.sh` — gates every
// commit byte-exact across all 185 (pattern × mode) combinations.

// ----- Phase C.2 batch 1: arithmetic opcodes ------------------------

fn kaxi_lower_add(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_binop_f64("add.f64", dst, src_a, src_b)
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_binop_f32("add.rn.f32", dst, src_a, src_b)
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_binop_i32("add.s32", dst, src_a, src_b)
        }
        return ptx_binop("add.u64", dst, src_a, src_b)
    }
    if mode == 1 {
        return "    add.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + ev(dst) + ", " + ev(src_a) + ", " + ev(src_b) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    add.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    }
    // mode == 4 (f32_epistemic): dual-bank value + variance lane (variance adds).
    return "    add.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
         + "    add.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
         + "    add.rn.f32 " + fv(dst) + ", " + fv(src_a) + ", " + fv(src_b) + ";\n"
}

fn kaxi_lower_sub(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_binop_f64("sub.f64", dst, src_a, src_b)
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_binop_f32("sub.rn.f32", dst, src_a, src_b)
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_binop_i32("sub.s32", dst, src_a, src_b)
        }
        return ptx_binop("sub.u64", dst, src_a, src_b)
    }
    if mode == 1 {
        // variance still ADDS (independent linear approximation).
        return "    sub.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + ev(dst) + ", " + ev(src_a) + ", " + ev(src_b) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    sub.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    sub.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    }
    // mode == 4: variance lane adds.
    return "    sub.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
         + "    sub.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
         + "    add.rn.f32 " + fv(dst) + ", " + fv(src_a) + ", " + fv(src_b) + ";\n"
}

fn kaxi_lower_mul(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_binop_f64("mul.f64", dst, src_a, src_b)
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_binop_f32("mul.rn.f32", dst, src_a, src_b)
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_binop_i32("mul.lo.s32", dst, src_a, src_b)
        }
        return ptx_binop("mul.lo.u64", dst, src_a, src_b)
    }
    if mode == 1 {
        // epistemic mul: σ²(a·b) — special X² case when src_a == src_b.
        // Phase I: scratch %rd256/%rd257 (was %rd256/%rd65, conflicted
        // with K-AXI rD ∈ {64,65} in big kernels).
        var s: string = "    mul.lo.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
        if src_a == src_b {
            // X²: σ²(X²) ≈ 4·X²·σ²(X)
            s = s + "    mul.lo.u64 %rd256, " + rd(src_a) + ", " + rd(src_a) + ";\n"
            s = s + "    mul.lo.u64 %rd256, %rd256, " + ev(src_a) + ";\n"
            s = s + "    shl.b64 " + ev(dst) + ", %rd256, 2;\n"
        } else {
            // independent: a²σ²(b) + b²σ²(a)
            s = s + "    mul.lo.u64 %rd256, " + rd(src_a) + ", " + rd(src_a) + ";\n"
            s = s + "    mul.lo.u64 %rd256, %rd256, " + ev(src_b) + ";\n"
            s = s + "    mul.lo.u64 %rd257, " + rd(src_b) + ", " + rd(src_b) + ";\n"
            s = s + "    mul.lo.u64 %rd257, %rd257, " + ev(src_a) + ";\n"
            s = s + "    add.u64 " + ev(dst) + ", %rd256, %rd257;\n"
        }
        return s
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    mul.lo.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    mul.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    }
    // mode == 4: f32 value lane + f32 variance lane (with X² case).
    // Phase I: scratch %f256/%f257 (was %f64/%f65).
    var s: string = "    mul.lo.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
    s = s + "    mul.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    if src_a == src_b {
        // X²: σ²(X²) = 4·X²·σ²(X)
        s = s + "    mul.rn.f32 %f256, " + fr(src_a) + ", " + fr(src_a) + ";\n"
        s = s + "    mul.rn.f32 %f256, %f256, " + fv(src_a) + ";\n"
        s = s + "    add.rn.f32 %f257, %f256, %f256;\n"
        s = s + "    add.rn.f32 " + fv(dst) + ", %f257, %f257;\n"
    } else {
        // independent: a²σ²(b) + b²σ²(a)
        s = s + "    mul.rn.f32 %f256, " + fr(src_a) + ", " + fr(src_a) + ";\n"
        s = s + "    mul.rn.f32 %f256, %f256, " + fv(src_b) + ";\n"
        s = s + "    mul.rn.f32 %f257, " + fr(src_b) + ", " + fr(src_b) + ";\n"
        s = s + "    mul.rn.f32 %f257, %f257, " + fv(src_a) + ";\n"
        s = s + "    add.rn.f32 " + fv(dst) + ", %f256, %f257;\n"
    }
    s
}

fn kaxi_lower_div(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_binop_f64("div.rn.f64", dst, src_a, src_b)
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_binop_f32("div.rn.f32", dst, src_a, src_b)
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_binop_i32("div.s32", dst, src_a, src_b)
        }
        return ptx_binop("div.u64", dst, src_a, src_b)
    }
    if mode == 1 {
        // div: conservative — variances add (independent linear approximation).
        return "    div.u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + ev(dst) + ", " + ev(src_a) + ", " + ev(src_b) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        // f32 only — no u64 lane for div in f32 dialects.
        return "    div.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    }
    // mode == 4: f32 div + variance lane (additive).
    return "    div.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
         + "    add.rn.f32 " + fv(dst) + ", " + fv(src_a) + ", " + fv(src_b) + ";\n"
}

fn kaxi_lower_fma(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    // K-AXI fma: dst = src_a * src_b + src_a (matches kaxi_to_c semantics).
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return "    mul.f64 " + fd(65) + ", " + fd(src_a) + ", " + fd(src_b) + ";\n"
                 + "    add.f64 " + fd(dst) + ", " + fd(65) + ", " + fd(src_a) + ";\n"
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return "    fma.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ", " + fr(src_a) + ";\n"
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return "    mad.lo.s32 " + ri(dst) + ", " + ri(src_a) + ", " + ri(src_b) + ", " + ri(src_a) + ";\n"
        }
        return "    mul.lo.u64 %rd256, " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + rd(dst) + ", %rd256, " + rd(src_a) + ";\n"
    }
    if mode == 1 {
        // u64 fma + variance (additive).
        return "    mul.lo.u64 %rd256, " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + rd(dst) + ", %rd256, " + rd(src_a) + ";\n"
             + "    add.u64 " + ev(dst) + ", " + ev(src_a) + ", " + ev(src_b) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    fma.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ", " + fr(src_a) + ";\n"
    }
    // mode == 4: fma + variance lane (additive).
    return "    fma.rn.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ", " + fr(src_a) + ";\n"
         + "    add.rn.f32 " + fv(dst) + ", " + fv(src_a) + ", " + fv(src_b) + ";\n"
}

// Phase E: min/max — same shape as add but with PTX `min.*` / `max.*`.
// Variance lane uses additive propagation (conservative, matches sub/div
// behaviour: σ²(min(a,b)) ≤ σ²(a)+σ²(b) for independent inputs).
fn kaxi_lower_min_max(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64, op: string) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_binop_f64(op + ".f64", dst, src_a, src_b)
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_binop_f32(op + ".f32", dst, src_a, src_b)
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_binop_i32(op + ".s32", dst, src_a, src_b)
        }
        return ptx_binop(op + ".u64", dst, src_a, src_b)
    }
    if mode == 1 {
        return "    " + op + ".u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    add.u64 " + ev(dst) + ", " + ev(src_a) + ", " + ev(src_b) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    " + op + ".u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
             + "    " + op + ".f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
    }
    return "    " + op + ".u64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
         + "    " + op + ".f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
         + "    add.rn.f32 " + fv(dst) + ", " + fv(src_a) + ", " + fv(src_b) + ";\n"
}

fn kaxi_lower_min(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    kaxi_lower_min_max(asm, line_start, line_len, mode, "min")
}

fn kaxi_lower_max(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    kaxi_lower_min_max(asm, line_start, line_len, mode, "max")
}

// Phase M: unary opcodes (abs, neg). Variance lane is COPIED from src
// (sign change / abs preserves σ² for the deterministic affine portion;
// near-zero discontinuity ignored — same conservative stance as min/max).
fn kaxi_lower_unary(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64, op_int: string, op_f64: string, op_f32: string) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return "    " + op_f64 + " " + fd(dst) + ", " + fd(src) + ";\n"
        }
        return "    " + op_int + " " + rd(dst) + ", " + rd(src) + ";\n"
    }
    if mode == 1 {
        return "    " + op_int + " " + rd(dst) + ", " + rd(src) + ";\n"
             + "    mov.u64 " + ev(dst) + ", " + ev(src) + ";\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    " + op_int + " " + rd(dst) + ", " + rd(src) + ";\n"
             + "    " + op_f32 + " " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: f32 value lane + f32 variance lane (variance copied).
    return "    " + op_int + " " + rd(dst) + ", " + rd(src) + ";\n"
         + "    " + op_f32 + " " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mov.f32 " + fv(dst) + ", " + fv(src) + ";\n"
}

fn kaxi_lower_abs(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    kaxi_lower_unary(asm, line_start, line_len, mode, "abs.s64", "abs.f64", "abs.f32")
}

fn kaxi_lower_neg(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    kaxi_lower_unary(asm, line_start, line_len, mode, "neg.s64", "neg.f64", "neg.f32")
}

// Phase P: lg2 (log₂) — third non-trivial-variance unary.
// GUM: σ²(log₂ x) = (∂lg2/∂x)² · σ²(x) = σ²(x) / (x · ln 2)².
// Helper computes (x·ln2)² scratch, divides src-variance by it.
// 0f3F317218 is f32 hex for ln(2) ≈ 0.6931472.
fn kaxi_lower_lg2(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 {
        // PTX has no native f64 lg2; default-mode skipped (would need
        // sequence of f64 ops). Default-u64 nonsense.
        return ""
    }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    lg2.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: lg2 + variance σ² / (x · ln2)².
    return "    lg2.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, " + fr(src) + ", 0f3F317218;\n"
         + "    mul.rn.f32 %f256, %f256, %f256;\n"
         + "    div.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

// Phase P: ex2 (2^x) — fourth non-trivial-variance unary.
// GUM: σ²(2^x) = (∂2^x/∂x)² · σ²(x) = (2^x · ln 2)² · σ²(x).
// Variance gets MULTIPLIED (not divided) by (value · ln2)² — first
// variance shape that needs the dst value (not the src).
fn kaxi_lower_ex2(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 { return "" }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    ex2.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: ex2 + variance (value · ln2)² · σ².
    return "    ex2.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, " + fr(dst) + ", 0f3F317218;\n"
         + "    mul.rn.f32 %f256, %f256, %f256;\n"
         + "    mul.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

// Phase O: recip (1/x) — second non-trivial-variance unary.
// GUM: σ²(1/x) ≈ (∂(1/x)/∂x)² · σ²(x) = σ²(x) / x⁴. Helper computes x²,
// squares it for x⁴, divides src-variance by x⁴. Same modes as sqrt.
fn kaxi_lower_recip(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return "    rcp.rn.f64 " + fd(dst) + ", " + fd(src) + ";\n"
        }
        return ""
    }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    rcp.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: f32 recip + variance σ²/x⁴.
    return "    rcp.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, " + fr(src) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, %f256, %f256;\n"
         + "    div.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

// Phase N: sqrt — first opcode whose variance lane is *non-trivial*.
// GUM: σ²(√x) ≈ (∂√x/∂x)² · σ²(x) = σ²(x) / (4x). Helper computes 4·src
// then divides src-variance by it. Default-mode u64 not supported (no
// native u64 sqrt in PTX); epistemic mode (u64-only) also skipped (would
// need u64↔f64 round-trip). Default-mode f64 and all f32-family modes work.
fn kaxi_lower_sqrt(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return "    sqrt.rn.f64 " + fd(dst) + ", " + fd(src) + ";\n"
        }
        return ""
    }
    if mode == 1 {
        // Phase W.C: epistemic u64 sqrt via f64 round-trip. PTX has no native
        // u64 sqrt; cvt to f64, sqrt.rn.f64, cvt back. Variance σ²(√x) =
        // σ²(x) / (4·x) computed in f64 then rounded back to u64.
        // 0d4010000000000000 = IEEE 754 f64 hex of 4.0.
        return "    cvt.rn.f64.u64 %fd0, " + rd(src) + ";\n"
             + "    sqrt.rn.f64 %fd0, %fd0;\n"
             + "    cvt.rni.u64.f64 " + rd(dst) + ", %fd0;\n"
             + "    cvt.rn.f64.u64 %fd1, " + ev(src) + ";\n"
             + "    cvt.rn.f64.u64 %fd2, " + rd(src) + ";\n"
             + "    mul.rn.f64 %fd2, %fd2, 0d4010000000000000;\n"
             + "    div.rn.f64 %fd1, %fd1, %fd2;\n"
             + "    cvt.rni.u64.f64 " + ev(dst) + ", %fd1;\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    sqrt.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: f32 sqrt + variance σ²/(4·x).
    // 0f40800000 is the IEEE 754 f32 hex representation of 4.0.
    return "    sqrt.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, " + fr(src) + ", 0f40800000;\n"
         + "    div.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

// Phase R: sin/cos — first cross-coupled-variance unaries.
// GUM: σ²(sin x) = cos²(x)·σ²(x); σ²(cos x) = sin²(x)·σ²(x).
// Variance lane needs the COMPLEMENTARY trig function evaluated on src.
// Phase S: rsqrt (1/√x) — third non-trivial-variance unary, cubic-divisive.
// GUM: σ²(1/√x) ≈ ((-1/2)·x^(-3/2))²·σ²(x) = σ²(x) / (4·x³). Helper builds
// 4·x³ = 4·src·src·src then divides src-variance by it. PTX-native sm_50.
fn kaxi_lower_rsqrt(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 { return "" }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    rsqrt.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: f32 rsqrt + variance σ²/(4·x³). 0f40800000 = f32 hex for 4.0.
    return "    rsqrt.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, " + fr(src) + ", " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, %f256, " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, %f256, 0f40800000;\n"
         + "    div.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

fn kaxi_lower_sin(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 { return "" }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    sin.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: sin + variance cos²(src)·σ². %f256 = cos(src), squared.
    return "    sin.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    cos.approx.f32 %f256, " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, %f256, %f256;\n"
         + "    mul.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

fn kaxi_lower_cos(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 0 { return "" }
    if mode == 1 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    cos.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
    }
    // mode == 4: cos + variance sin²(src)·σ². %f256 = sin(src), squared.
    return "    cos.approx.f32 " + fr(dst) + ", " + fr(src) + ";\n"
         + "    sin.approx.f32 %f256, " + fr(src) + ";\n"
         + "    mul.rn.f32 %f256, %f256, %f256;\n"
         + "    mul.rn.f32 " + fv(dst) + ", " + fv(src) + ", %f256;\n"
}

// Phase U: getvar — copy variance lane of src into value lane of dst.
// GUM: σ²(dst) = 0 (the moved variance is now a measured fact, not propagated).
// Modes 1 and 4 carry a variance lane; modes 0/2/3 don't and return "".
// Phase W.C: mode-1 u64 path added; mode-4 f32 path unchanged. Enables
// compute-then-gate pipelines where the kernel computes σ² internally then
// compares it to a threshold.
fn kaxi_lower_getvar(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src < 0 { return "" }
    if mode == 1 {
        return "    mov.u64 " + rd(dst) + ", " + ev(src) + ";\n"
             + "    mov.u64 " + ev(dst) + ", 0;\n"
    }
    if mode != 4 { return "" }
    return "    mov.f32 " + fr(dst) + ", " + fv(src) + ";\n"
         + "    mov.f32 " + fv(dst) + ", 0f00000000;\n"
}

// Phase T: unified setp/selp lowering for all 5 modes — supports the
// compile-time confidence gate. Modes 0/1 emit u64 forms (byte-identical
// to the existing per-line dispatchers); modes 2/3/4 emit f32 forms.
// Mode 3 (f32_2c) and mode 4 (f32_epistemic) gain setp/selp here for the
// first time — previously these were "// unhandled" in those modes.
fn kaxi_lower_setp(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let cmp = ptx_parse_setp_cmp(asm, line_start, line_len)
    let dst = ptx_parse_reg(asm, line_start, line_len, "p", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    if dst < 0 || src_a < 0 || src_b < 0 { return "" }
    if mode == 0 || mode == 1 {
        return "    setp." + cmp + ".u64 " + pp(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ";\n"
    }
    return "    setp." + cmp + ".f32 " + pp(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ";\n"
}

fn kaxi_lower_selp(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let src_a = ptx_parse_reg(asm, line_start, line_len, "r", 1)
    let src_b = ptx_parse_reg(asm, line_start, line_len, "r", 2)
    let pred = ptx_parse_reg_after(asm, line_start, line_len, "pred=p")
    if dst < 0 || src_a < 0 || src_b < 0 || pred < 0 { return "" }
    if mode == 0 || mode == 1 {
        return "    selp.b64 " + rd(dst) + ", " + rd(src_a) + ", " + rd(src_b) + ", " + pp(pred) + ";\n"
    }
    return "    selp.f32 " + fr(dst) + ", " + fr(src_a) + ", " + fr(src_b) + ", " + pp(pred) + ";\n"
}

fn kaxi_lower_arith(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = asm.data[(line_start + 1) as usize] as i8
    let c2 = asm.data[(line_start + 2) as usize] as i8
    if c0 == 97 && c1 == 100 && c2 == 100 { return kaxi_lower_add(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 117 && c2 == 98 { return kaxi_lower_sub(asm, line_start, line_len, mode) }
    if c0 == 109 && c1 == 117 && c2 == 108 { return kaxi_lower_mul(asm, line_start, line_len, mode) }
    if c0 == 100 && c1 == 105 && c2 == 118 { return kaxi_lower_div(asm, line_start, line_len, mode) }
    if c0 == 102 && c1 == 109 && c2 == 97 { return kaxi_lower_fma(asm, line_start, line_len, mode) }
    if c0 == 109 && c1 == 105 && c2 == 110 { return kaxi_lower_min(asm, line_start, line_len, mode) }
    if c0 == 109 && c1 == 97 && c2 == 120 { return kaxi_lower_max(asm, line_start, line_len, mode) }
    if c0 == 97 && c1 == 98 && c2 == 115 { return kaxi_lower_abs(asm, line_start, line_len, mode) }
    if c0 == 110 && c1 == 101 && c2 == 103 { return kaxi_lower_neg(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 113 && c2 == 114 { return kaxi_lower_sqrt(asm, line_start, line_len, mode) }
    if c0 == 114 && c1 == 99 && c2 == 112 { return kaxi_lower_recip(asm, line_start, line_len, mode) }
    if c0 == 108 && c1 == 103 && c2 == 50 { return kaxi_lower_lg2(asm, line_start, line_len, mode) }
    if c0 == 101 && c1 == 120 && c2 == 50 { return kaxi_lower_ex2(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 105 && c2 == 110 { return kaxi_lower_sin(asm, line_start, line_len, mode) }
    if c0 == 99 && c1 == 111 && c2 == 115 { return kaxi_lower_cos(asm, line_start, line_len, mode) }
    if c0 == 114 && c1 == 115 && c2 == 113 { return kaxi_lower_rsqrt(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 101 && c2 == 116 { return kaxi_lower_setp(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 101 && c2 == 108 { return kaxi_lower_selp(asm, line_start, line_len, mode) }
    if c0 == 103 && c1 == 118 && c2 == 114 { return kaxi_lower_getvar(asm, line_start, line_len, mode) }
    ""
}

// ----- Phase C.2 batch 2: memory opcodes (load_global/imm/immf, store_global) -----

fn kaxi_lower_load_global(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let addr = ptx_parse_reg_after(asm, line_start, line_len, "addr=r")
    if dst < 0 || addr < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_addr_compute(addr) + "    ld.global.f64 " + fd(dst) + ", [%rd256];\n"
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_addr_compute_f32(addr) + "    ld.global.f32 " + fr(dst) + ", [%rd256];\n"
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_addr_compute_f32(addr) + "    ld.global.s32 " + ri(dst) + ", [%rd256];\n"
        }
        return ptx_addr_compute(addr) + "    ld.global.u64 " + rd(dst) + ", [%rd256];\n"
    }
    if mode == 1 {
        // epistemic: dual-buffer u64 load (value + variance).
        // Phase I: scratch %rd256/%rd257, base %rd258/%rd259.
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 8;\n"
             + "    add.u64 %rd257, %rd258, %rd256;\n"
             + "    ld.global.u64 " + rd(dst) + ", [%rd257];\n"
             + "    add.u64 %rd257, %rd259, %rd256;\n"
             + "    ld.global.u64 " + ev(dst) + ", [%rd257];\n"
    }
    if mode == 2 {
        return ptx_addr_compute_f32(addr) + "    ld.global.f32 " + fr(dst) + ", [%rd256];\n"
    }
    if mode == 3 {
        // f32_2c: buf= parameter selects %rd258 vs %rd259 base.
        // Phase K: scratch %rd256, base %rd258/%rd259 (was %rd256 + %rd96/97
        // — same conflict shape Phase I fixed for variance modes).
        let buf = ptx_parse_buf(asm, line_start, line_len)
        let base = if buf == 1 { "%rd259" } else { "%rd258" }
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 4;\n"
             + "    add.u64 %rd256, " + base + ", %rd256;\n"
             + "    ld.global.f32 " + fr(dst) + ", [%rd256];\n"
    }
    if mode == 5 {
        // f32_gum: buf=0..3 selects %rd258..%rd261 (C1, C2, V1, V2).
        let buf5 = ptx_parse_buf(asm, line_start, line_len)
        let base5 = if buf5 == 0 { "%rd258" }
               else if buf5 == 1 { "%rd259" }
               else if buf5 == 2 { "%rd260" }
               else              { "%rd261" }
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 4;\n"
             + "    add.u64 %rd256, " + base5 + ", %rd256;\n"
             + "    ld.global.f32 " + fr(dst) + ", [%rd256];\n"
    }
    // mode == 4: dual-buffer f32 load (value + variance).
    // Phase I: scratch %rd256/%rd257, base %rd258/%rd259.
    return ptx_addr_compute_f32e(addr)
         + "    add.u64 %rd257, %rd258, %rd256;\n"
         + "    ld.global.f32 " + fr(dst) + ", [%rd257];\n"
         + "    add.u64 %rd257, %rd259, %rd256;\n"
         + "    ld.global.f32 " + fv(dst) + ", [%rd257];\n"
}

fn kaxi_lower_load_imm(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let imm = ptx_parse_imm_after(asm, line_start, line_len, "imm=")
    if dst < 0 { return "" }
    if mode == 0 {
        return "    mov.u64 " + rd(dst) + ", " + ptx_int_to_string(imm) + ";\n"
    }
    if mode == 1 {
        return "    mov.u64 " + rd(dst) + ", " + ptx_int_to_string(imm) + ";\n"
             + "    mov.u64 " + ev(dst) + ", 0;\n"
    }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    mov.u64 " + rd(dst) + ", " + ptx_int_to_string(imm) + ";\n"
             + "    mov.u32 %r2, " + ptx_int_to_string(imm) + ";\n"
             + "    cvt.rn.f32.s32 " + fr(dst) + ", %r2;\n"
    }
    // mode == 4
    return "    mov.u64 " + rd(dst) + ", " + ptx_int_to_string(imm) + ";\n"
         + "    mov.u32 %r2, " + ptx_int_to_string(imm) + ";\n"
         + "    cvt.rn.f32.s32 " + fr(dst) + ", %r2;\n"
         + "    mov.f32 " + fv(dst) + ", 0f00000000;\n"
}

fn kaxi_lower_load_immf(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    // load_immf rD, fimm=HEX — only present in f32-family dialects (2/3/4).
    if mode == 0 || mode == 1 { return "" }
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let hex = ptx_parse_fimm_hex(asm, line_start, line_len)
    if dst < 0 || str_len(hex) != 8 { return "" }
    if mode == 2 || mode == 3 || mode == 5 {
        return "    mov.f32 " + fr(dst) + ", 0f" + hex + ";\n"
    }
    // mode == 4: variance lane <- 0
    return "    mov.f32 " + fr(dst) + ", 0f" + hex + ";\n"
         + "    mov.f32 " + fv(dst) + ", 0f00000000;\n"
}

fn kaxi_lower_load(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    // dispatch on char-after-prefix: 'g'=global, 's'=shared (TODO, dialect-specific
    // comment — fall back), else imm/immf based on char-8.
    if line_len < 6 { return "" }
    let c5 = asm.data[(line_start + 5) as usize] as i8
    if c5 == 103 {
        if line_len > 11 { return kaxi_lower_load_global(asm, line_start, line_len, mode) }
        return ""
    }
    if c5 == 115 {
        // load_shared: leave to per-dialect handler (TODO comment varies).
        return ""
    }
    // load_imm or load_immf. In default/epistemic (modes 0/1) the old
    // per-dialect handlers had no `load_immf` branch — they fell through to
    // `load_imm`, which (by accident-of-parsing) finds "imm=" inside "fimm=N"
    // and parses N as integer. Replicate that so C.3 can stub the old
    // handlers without breaking byte-identity.
    if line_len > 8 && asm.data[(line_start + 8) as usize] as i8 == 102 && mode >= 2 {
        return kaxi_lower_load_immf(asm, line_start, line_len, mode)
    }
    kaxi_lower_load_imm(asm, line_start, line_len, mode)
}

fn kaxi_lower_store_global(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    let src = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    let addr = ptx_parse_reg_after(asm, line_start, line_len, "addr=r")
    if src < 0 || addr < 0 { return "" }
    if mode == 0 {
        if kaxi_line_has_type_f64(asm, line_start, line_len) {
            return ptx_addr_compute(addr) + "    st.global.f64 [%rd256], " + fd(src) + ";\n"
        }
        if kaxi_line_has_type_f32(asm, line_start, line_len) {
            return ptx_addr_compute_f32(addr) + "    st.global.f32 [%rd256], " + fr(src) + ";\n"
        }
        if kaxi_line_has_type_i32(asm, line_start, line_len) {
            return ptx_addr_compute_f32(addr) + "    st.global.s32 [%rd256], " + ri(src) + ";\n"
        }
        return ptx_addr_compute(addr) + "    st.global.u64 [%rd256], " + rd(src) + ";\n"
    }
    if mode == 1 {
        // epistemic: dual-buffer u64 store.
        // Phase I: scratch %rd256/%rd257, base %rd258/%rd259.
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 8;\n"
             + "    add.u64 %rd257, %rd258, %rd256;\n"
             + "    st.global.u64 [%rd257], " + rd(src) + ";\n"
             + "    add.u64 %rd257, %rd259, %rd256;\n"
             + "    st.global.u64 [%rd257], " + ev(src) + ";\n"
    }
    if mode == 2 {
        return ptx_addr_compute_f32(addr) + "    st.global.f32 [%rd256], " + fr(src) + ";\n"
    }
    if mode == 3 {
        // Phase K: scratch %rd256, base %rd258/%rd259.
        let buf = ptx_parse_buf(asm, line_start, line_len)
        let base = if buf == 1 { "%rd259" } else { "%rd258" }
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 4;\n"
             + "    add.u64 %rd256, " + base + ", %rd256;\n"
             + "    st.global.f32 [%rd256], " + fr(src) + ";\n"
    }
    if mode == 5 {
        // f32_gum: buf=0..3 selects %rd258..%rd261 (C1, C2, V1, V2).
        let buf5 = ptx_parse_buf(asm, line_start, line_len)
        let base5 = if buf5 == 0 { "%rd258" }
               else if buf5 == 1 { "%rd259" }
               else if buf5 == 2 { "%rd260" }
               else              { "%rd261" }
        return "    mul.lo.u64 %rd256, " + rd(addr) + ", 4;\n"
             + "    add.u64 %rd256, " + base5 + ", %rd256;\n"
             + "    st.global.f32 [%rd256], " + fr(src) + ";\n"
    }
    // mode == 4: dual-buffer f32 store (value + variance).
    // Phase I: scratch %rd256/%rd257, base %rd258/%rd259.
    return ptx_addr_compute_f32e(addr)
         + "    add.u64 %rd257, %rd258, %rd256;\n"
         + "    st.global.f32 [%rd257], " + fr(src) + ";\n"
         + "    add.u64 %rd257, %rd259, %rd256;\n"
         + "    st.global.f32 [%rd257], " + fv(src) + ";\n"
}

fn kaxi_lower_store(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len < 7 { return "" }
    let c6 = asm.data[(line_start + 6) as usize] as i8
    if c6 == 103 {
        if line_len > 12 { return kaxi_lower_store_global(asm, line_start, line_len, mode) }
        return ""
    }
    // store_shared TODO (dialect-specific comment) — fall back.
    ""
}

fn kaxi_lower_mem(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = asm.data[(line_start + 1) as usize] as i8
    let c2 = asm.data[(line_start + 2) as usize] as i8
    if c0 == 108 && c1 == 111 && c2 == 97 { return kaxi_lower_load(asm, line_start, line_len, mode) }
    if c0 == 115 && c1 == 116 && c2 == 111 { return kaxi_lower_store(asm, line_start, line_len, mode) }
    ""
}

// ----- Phase C.2 batch 3: special registers (get_tid/get_bid/get_ntid) -----

fn kaxi_lower_get(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    // K-AXI form: get_t / get_b / get_nt / get_nc  (char-4 selects the special
    // register; for char-4='n' char-5 disambiguates ntid vs nctaid).
    let kind = if line_len > 4 { asm.data[(line_start + 4) as usize] as i8 } else { 116 as i8 }
    let kind5 = if line_len > 5 { asm.data[(line_start + 5) as usize] as i8 } else { 0 as i8 }
    let dst = ptx_parse_reg(asm, line_start, line_len, "r", 0)
    if dst < 0 { return "" }
    let sreg = if kind == 98 { "%ctaid.x" }
        else if kind == 110 && kind5 == 99 { "%nctaid.x" }
        else if kind == 110 { "%ntid.x" }
        else { "%tid.x" }
    let head = "    mov.u32 %r1, " + sreg + ";\n"
             + "    cvt.u64.u32 " + rd(dst) + ", %r1;\n"
    if mode == 0 { return head }
    if mode == 1 { return head + "    mov.u64 " + ev(dst) + ", 0;\n" }
    if mode == 2 || mode == 3 || mode == 5 {
        return head + "    cvt.rn.f32.u32 " + fr(dst) + ", %r1;\n"
    }
    // mode == 4: f32 value lane + zero variance lane.
    head + "    cvt.rn.f32.u32 " + fr(dst) + ", %r1;\n"
         + "    mov.f32 " + fv(dst) + ", 0f00000000;\n"
}

fn kaxi_lower_special(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = asm.data[(line_start + 1) as usize] as i8
    let c2 = asm.data[(line_start + 2) as usize] as i8
    if c0 == 103 && c1 == 101 && c2 == 116 { return kaxi_lower_get(asm, line_start, line_len, mode) }
    ""
}

// ----- Phase C.2 batch 4: trivial 1-liners (ret/nop/bar) -----
//
// `ret` and `nop` are byte-identical across all 5 dialects; `bar.sync 0`
// is only present in default + epistemic. Mode-INDEPENDENT for ret/nop
// — no per-mode lane fan-out needed (these don't carry value/variance).

fn kaxi_lower_simple(asm: KaxiAsmBuf, line_start: i64, line_len: i64, mode: i64) -> string with Mut, Panic, Div, Alloc {
    if line_len < 3 { return "" }
    let c0 = asm.data[line_start as usize] as i8
    let c1 = asm.data[(line_start + 1) as usize] as i8
    let c2 = asm.data[(line_start + 2) as usize] as i8
    if c0 == 114 && c1 == 101 && c2 == 116 { return "    ret;\n" }
    if c0 == 110 && c1 == 111 && c2 == 112 { return "    // nop\n" }
    if c0 == 98 && c1 == 97 && c2 == 114 {
        if mode == 0 || mode == 1 { return "    bar.sync 0;\n" }
        return ""
    }
    ""
}

// ----- unified transpiler -------------------------------------------

pub fn kaxi_transpile_to_ptx_unified(asm: KaxiAsmBuf, mode: i64) -> string with Mut, Panic, Div, Alloc {
    // Phase G: heap-string accumulator (was: stack-allocated KaxiAsmBuf,
    // 64K hard cap that broke sedenion_mul in epistemic / f32_epistemic).
    // Sounio strings aren't subject to SRET-large-struct issues, so output
    // can grow past 64K — unlocks arbitrarily-large kernels.
    var out: string = ""
    out = out + ".version 7.0\n"
    out = out + ".target sm_50\n"
    out = out + ".address_size 64\n\n"
    out = out + ".visible .entry kaxi_kernel(\n"

    // Param decls
    if mode == 0 || mode == 2 {
        out = out + "    .param .u64 param_mem\n"
    } else if mode == 3 {
        out = out + "    .param .u64 param_a,\n"
        out = out + "    .param .u64 param_b\n"
    } else if mode == 5 {
        // f32_gum: 4 buffers — C1, C2, V1, V2.
        out = out + "    .param .u64 param_a,\n"
        out = out + "    .param .u64 param_b,\n"
        out = out + "    .param .u64 param_c,\n"
        out = out + "    .param .u64 param_d\n"
    } else {
        // mode == 1 (epistemic) || mode == 4 (f32_epistemic)
        out = out + "    .param .u64 param_mem,\n"
        out = out + "    .param .u64 param_var\n"
    }
    out = out + ")\n{\n"

    // Register banks. Order is byte-significant against goldens.
    if mode == 0 {
        // Phase L: bank up to 260 (scratch %rd256, base %rd258 above
        // value lane). %fd stays at <70> — no f64 patterns reach that high.
        // M4: %f<260> for typed f32 path; %r<260> for typed i32 path.
        out = out + "    .reg .b64 %rd<260>;\n"
        out = out + "    .reg .f64 %fd<70>;\n"
        out = out + "    .reg .f32 %f<260>;\n"
        out = out + "    .reg .b32 %r<260>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    } else if mode == 1 {
        // Phase I: bank up to 260 (value 0..127, variance 128..255,
        // scratch 256/257, base 258/259).
        // Phase W.C: %fd<8> scratch for u64↔f64 sqrt round-trip.
        out = out + "    .reg .b64 %rd<260>;\n"
        out = out + "    .reg .f64 %fd<8>;\n"
        out = out + "    .reg .b32 %r<8>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    } else if mode == 2 {
        // Phase L: bank up to 260 (scratch %rd256, base %rd258).
        out = out + "    .reg .b64 %rd<260>;\n"
        out = out + "    .reg .b32 %r<8>;\n"
        out = out + "    .reg .f32 %f<260>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    } else if mode == 3 {
        // Phase K: bank up to 260 to make room for scratch+base above
        // the value-lane region (was %rd<128> + %f<70>).
        out = out + "    .reg .b64 %rd<260>;\n"
        out = out + "    .reg .b32 %r<8>;\n"
        out = out + "    .reg .f32 %f<260>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    } else if mode == 5 {
        // f32_gum: same bank as f32_2c; base ptrs %rd258..%rd261.
        out = out + "    .reg .b64 %rd<262>;\n"
        out = out + "    .reg .b32 %r<8>;\n"
        out = out + "    .reg .f32 %f<260>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    } else {
        // mode == 4 (f32_epistemic) — Phase I bank-up
        out = out + "    .reg .b64 %rd<260>;\n"
        out = out + "    .reg .b32 %r<8>;\n"
        out = out + "    .reg .f32 %f<260>;\n"
        out = out + "    .reg .pred %p<64>;\n\n"
    }

    // ld.param — single-param modes use %rd258; dual %rd258/%rd259; quad %rd258..%rd261.
    if mode == 0 || mode == 2 {
        out = out + "    ld.param.u64 %rd258, [param_mem];\n"
    } else if mode == 3 {
        // Phase K: base ptrs at %rd258/%rd259 (was %rd96/%rd97).
        out = out + "    ld.param.u64 %rd258, [param_a];\n"
        out = out + "    ld.param.u64 %rd259, [param_b];\n"
    } else if mode == 5 {
        // f32_gum: base ptrs C1=%rd258, C2=%rd259, V1=%rd260, V2=%rd261.
        out = out + "    ld.param.u64 %rd258, [param_a];\n"
        out = out + "    ld.param.u64 %rd259, [param_b];\n"
        out = out + "    ld.param.u64 %rd260, [param_c];\n"
        out = out + "    ld.param.u64 %rd261, [param_d];\n"
    } else {
        // mode == 1 || mode == 4 — Phase I: base ptrs at %rd258/%rd259.
        out = out + "    ld.param.u64 %rd258, [param_mem];\n"
        out = out + "    ld.param.u64 %rd259, [param_var];\n"
    }

    // Loop — identical across all 5 transpilers; dispatches to the
    // existing per-mode line handler (Phase C.2 collapses these).
    var line_start: i64 = 0
    var i: i64 = 0
    var instr_idx: i64 = 0
    while i <= asm.len {
        let is_end = i == asm.len
        let is_newline = if i < asm.len { asm.data[i as usize] as i8 == 10 } else { true }
        if is_end || is_newline {
            let line_len = i - line_start
            if line_len > 0 {
                let first_char = asm.data[line_start as usize] as i8
                if first_char != 59 && first_char != 0 {
                    // Phase C.2: try opcode-first helpers (batch 1: arith,
                    // batch 2: mem, batch 3: special-regs, batch 4: simple);
                    // fall back to old per-dialect handler for the rest.
                    let p_arith = kaxi_lower_arith(asm, line_start, line_len, mode)
                    let p_mem = if str_len(p_arith) > 0 { "" } else { kaxi_lower_mem(asm, line_start, line_len, mode) }
                    let p_spec = if str_len(p_arith) > 0 || str_len(p_mem) > 0 { "" } else { kaxi_lower_special(asm, line_start, line_len, mode) }
                    let p_simple = if str_len(p_arith) > 0 || str_len(p_mem) > 0 || str_len(p_spec) > 0 { "" } else { kaxi_lower_simple(asm, line_start, line_len, mode) }
                    let p = if str_len(p_arith) > 0 {
                        p_arith
                    } else if str_len(p_mem) > 0 {
                        p_mem
                    } else if str_len(p_spec) > 0 {
                        p_spec
                    } else if str_len(p_simple) > 0 {
                        p_simple
                    } else if mode == 0 {
                        kaxi_transpile_line_to_ptx(asm, line_start, line_len)
                    } else if mode == 1 {
                        kaxi_transpile_line_to_ptx_epistemic(asm, line_start, line_len)
                    } else if mode == 2 {
                        kaxi_transpile_line_to_ptx_f32(asm, line_start, line_len)
                    } else if mode == 3 || mode == 5 {
                        kaxi_transpile_line_to_ptx_f32_2c(asm, line_start, line_len)
                    } else {
                        kaxi_transpile_line_to_ptx_f32_epistemic(asm, line_start, line_len)
                    }
                    out = out + "L" + ptx_int_to_string(instr_idx) + ":\n"
                    if str_len(p) > 0 {
                        out = out + p
                    } else {
                        out = out + "    // unhandled\n"
                    }
                    instr_idx = instr_idx + 1
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }

    out + "}\n"
}
