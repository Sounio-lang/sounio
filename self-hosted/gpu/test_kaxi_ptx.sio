// self-hosted/gpu/test_kaxi_ptx.sio — emit PTX for each K-AXI test kernel
//
// Writes one stanza per kernel to stdout in the form:
//   ---KERNEL <name>
//   <PTX text>
//   ---KERNEL_END

use gpu::kaxi_backend::*
use gpu::kaxi_to_ptx::*

fn emit(name: string, asm: KaxiAsmBuf) with IO, Mut, Panic, Div, Alloc {
    print("---KERNEL ")
    println(name)
    let ptx = kaxi_transpile_to_ptx_unified(asm, 0)
    print(ptx)
    println("---KERNEL_END")
}

fn k_vec_add() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "load_imm r0, imm=0, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=10, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=20, seq=2")
    asm = kaxi_asm_push_line(asm, "add r3, r1, r2, seq=3")
    asm = kaxi_asm_push_line(asm, "store_global r3, addr=r0, seq=4")
    asm = kaxi_asm_push_line(asm, "ret seq=5")
    asm
}

fn k_fma() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "load_imm r0, imm=0, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=2, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=3, seq=2")
    asm = kaxi_asm_push_line(asm, "fma r3, r1, r2, seq=3")
    asm = kaxi_asm_push_line(asm, "store_global r3, addr=r0, seq=4")
    asm = kaxi_asm_push_line(asm, "ret seq=5")
    asm
}

fn k_mul_div() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "load_imm r0, imm=0, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=10, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=20, seq=2")
    asm = kaxi_asm_push_line(asm, "load_imm r3, imm=4, seq=3")
    asm = kaxi_asm_push_line(asm, "mul r4, r1, r2, seq=4")
    asm = kaxi_asm_push_line(asm, "div r5, r4, r3, seq=5")
    asm = kaxi_asm_push_line(asm, "store_global r5, addr=r0, seq=6")
    asm = kaxi_asm_push_line(asm, "ret seq=7")
    asm
}

fn k_multi_lane() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=10, seq=1")
    asm = kaxi_asm_push_line(asm, "add r2, r0, r1, seq=2")
    asm = kaxi_asm_push_line(asm, "store_global r2, addr=r0, seq=3")
    asm = kaxi_asm_push_line(asm, "ret seq=4")
    asm
}

fn k_divergent() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=0, seq=1")
    asm = kaxi_asm_push_line(asm, "setp.eq p0, r0, r1, seq=2")
    asm = kaxi_asm_push_line(asm, "branch p0, target=6, seq=3")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=100, seq=4")
    asm = kaxi_asm_push_line(asm, "store_global r2, addr=r0, seq=5")
    asm = kaxi_asm_push_line(asm, "reconverge seq=6")
    asm = kaxi_asm_push_line(asm, "ret seq=7")
    asm
}

fn k_vote_ballot() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "load_imm r1, imm=4, seq=1")
    asm = kaxi_asm_push_line(asm, "setp.lt p0, r0, r1, seq=2")
    asm = kaxi_asm_push_line(asm, "vote.b r2, p0, seq=3")
    asm = kaxi_asm_push_line(asm, "load_imm r3, imm=0, seq=4")
    asm = kaxi_asm_push_line(asm, "store_global r2, addr=r3, seq=5")
    asm = kaxi_asm_push_line(asm, "ret seq=6")
    asm
}

fn k_shuffle_xor() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "shuffle.x r1, r0, imm=1, seq=1")
    asm = kaxi_asm_push_line(asm, "store_global r1, addr=r0, seq=2")
    asm = kaxi_asm_push_line(asm, "ret seq=3")
    asm
}

fn k_warp_reduce_add() -> KaxiAsmBuf with Mut, Panic, Div, Alloc {
    var asm: KaxiAsmBuf = kaxi_asm_new()
    asm = kaxi_asm_push_line(asm, "get_tid r0, var=0%, seq=0")
    asm = kaxi_asm_push_line(asm, "warp.reduc r1, r0, seq=1")
    asm = kaxi_asm_push_line(asm, "load_imm r2, imm=0, seq=2")
    asm = kaxi_asm_push_line(asm, "store_global r1, addr=r2, seq=3")
    asm = kaxi_asm_push_line(asm, "ret seq=4")
    asm
}

pub fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    emit("vec_add", k_vec_add())
    emit("fma", k_fma())
    emit("mul_div", k_mul_div())
    emit("multi_lane", k_multi_lane())
    emit("divergent", k_divergent())
    emit("vote_ballot", k_vote_ballot())
    emit("shuffle_xor", k_shuffle_xor())
    emit("warp_reduce_add", k_warp_reduce_add())
    0
}
