// self-hosted/gpu/kretikos_emit_cubin.sio
// Kretikos CUBIN emission driver - produces real CUDA ELF/CUBIN bytes.
//
// Usage: souc kretikos_emit_cubin.sio /tmp/kretikos_emit_cubin.elf
//        /tmp/kretikos_emit_cubin.elf <kind>
//
// Output: decimal byte values, one per line, written to stdout.
// The caller (bin/kretikos) converts these to binary.
//
// Supported kinds:
//   exit_only       - minimal kernel that returns immediately
//   store_u32_const - stores a constant u32 to output
//   vec_add_f32     - f32 vector addition (SM80)
//   vec_sub_f32     - f32 vector subtraction (SM80 affine ABI)
//   vec_mul_f32     - f32 vector multiplication (SM80 affine ABI)
//   fma_f32         - f32 affine FMA (SM80)
//
// f64 CUBINs are emitted by bin/kretikos from the nvidia_bare.sio chunk
// source to avoid the current Sounio runtime edge around returning long
// string literals from large chunk selectors.

use nvidia_bare::*

fn print_byte_decimal(b: i64) with IO, Mut, Panic {
    var v = b
    if v < 0 {
        print("-")
        v = 0 - v
    }
    if v >= 10 {
        print_byte_decimal(v / 10)
    }
    let digit = v % 10
    if digit == 0 { print("0") }
    else if digit == 1 { print("1") }
    else if digit == 2 { print("2") }
    else if digit == 3 { print("3") }
    else if digit == 4 { print("4") }
    else if digit == 5 { print("5") }
    else if digit == 6 { print("6") }
    else if digit == 7 { print("7") }
    else if digit == 8 { print("8") }
    else if digit == 9 { print("9") }
}

fn hex_nibble(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        c - 48
    } else if c >= 97 && c <= 102 {
        c - 87
    } else if c >= 65 && c <= 70 {
        c - 55
    } else {
        0
    }
}

fn print_hex_chunk_decimal(s: string) with IO, Mut, Panic, Div {
    var i: i64 = 0
    let n = str_len(s)
    while i + 1 < n {
        let hi = hex_nibble(str_char_at(s, i) as i64)
        let lo = hex_nibble(str_char_at(s, i + 1) as i64)
        print_byte_decimal((hi * 16) + lo)
        print("\n")
        i = i + 2
    }
}

fn print_vec_add_f64_cubin_decimal() with IO, Mut, Panic, Div {
    var i: i64 = 0
    let n = gpu_bare_sm80_vec_add_f64_cubin_hex_chunk_count()
    while i < n {
        print_hex_chunk_decimal(gpu_bare_sm80_vec_add_f64_cubin_hex_chunk(i))
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_cubin: error - expected <kind>")
        println("")
        println("Supported kinds:")
        println("  exit_only          - minimal kernel that returns immediately")
        println("  store_u32_const    - stores a constant u32 to output")
        println("  vec_add_f32        - f32 vector addition (SM80)")
        println("  vec_sub_f32        - f32 vector subtraction (SM80)")
        println("  vec_mul_f32        - f32 vector multiplication (SM80)")
        println("  fma_f32            - f32 affine fused multiply-add (SM80)")
        println("  epistemic_dual_f32 - epistemic dual-lane f32 output (SM80)")
        return 1
    }

    let kind = get_arg(0)
    var buf: GpuBareBuf

    if str_eq(kind, "exit_only") {
        buf = gpu_bare_emit_sm80_exit_cubin()
    } else if str_eq(kind, "store_u32_const") {
        buf = gpu_bare_emit_sm80_store_u32_const_cubin()
    } else if str_eq(kind, "vec_add_f32") {
        buf = gpu_bare_emit_sm80_vec_add_f32_cubin()
    } else if str_eq(kind, "vec_add_f64") {
        println("kretikos_emit_cubin: vec_add_f64 is emitted by bin/kretikos source-chunk bridge")
        return 1
    } else if str_eq(kind, "vec_sub_f32") {
        buf = gpu_bare_emit_sm80_vec_sub_f32_cubin()
    } else if str_eq(kind, "vec_mul_f32") {
        buf = gpu_bare_emit_sm80_vec_mul_f32_cubin()
    } else if str_eq(kind, "fma_f32") {
        buf = gpu_bare_emit_sm80_fma_f32_cubin()
    } else if str_eq(kind, "epistemic_dual_f32") {
        buf = gpu_bare_emit_sm80_epistemic_dual_output_f32_cubin()
    } else {
        print("kretikos_emit_cubin: error - unknown kind '")
        print(kind)
        println("'")
        return 1
    }

    var i: i64 = 0
    while i < buf.len {
        print_byte_decimal(buf.data[i as usize])
        print("\n")
        i = i + 1
    }

    0
}
