// self-hosted/gpu/kretikos_emit_metal.sio
// Kretikos Metal/MSL emission driver - produces predefined MSL text from in-tree emitters.
//
// Usage: souc kretikos_emit_metal.sio /tmp/kretikos_emit_metal.elf
//        /tmp/kretikos_emit_metal.elf <pattern>
//
// Supported patterns:
//   vec_add              - f32 vector addition (hardcoded MSL kernel)
//   epistemic_dual_output_f32 - value, uncertainty, and validity lanes
//   ossm_oct_step        - octonion OSSM step with f64-checked f32 policy
//   sedenion_cd_step     - sedenion Cayley-Dickson step with f64-checked f32 policy
//   self-check           - run internal smoke tests and print PASS/FAIL

use metal::*

fn main() -> i32 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 1 {
        println("kretikos_emit_metal: error - expected <pattern>")
        println("")
        println("Supported patterns:")
        println("  vec_add          - f32 vector addition (hardcoded MSL kernel)")
        println("  epistemic_dual_output_f32 - value, uncertainty, and validity lanes")
        println("  ossm_oct_step    - octonion OSSM step with f64-checked f32 policy")
        println("  sedenion_cd_step - sedenion Cayley-Dickson step with f64-checked f32 policy")
        println("  self-check       - run internal smoke tests and print PASS/FAIL")
        return 1
    }

    let pattern = get_arg(0)

    if str_eq(pattern, "self-check") {
        let ok = metal_self_check()
        if ok {
            println("PASS metal_self_check")
            return 0
        } else {
            println("FAIL metal_self_check")
            return 1
        }
    }

    var buf: MetalBuf
    if str_eq(pattern, "vec_add") {
        buf = metal_emit_vec_add_f32()
    } else if str_eq(pattern, "epistemic_dual_output_f32") {
        buf = metal_emit_epistemic_dual_output_f32()
    } else if str_eq(pattern, "ossm_oct_step") {
        buf = metal_emit_ossm_oct_step_f64_checked()
    } else if str_eq(pattern, "sedenion_cd_step") {
        buf = metal_emit_sedenion_cd_step_f64_checked()
    } else {
        print("kretikos_emit_metal: error - unknown pattern '")
        print(pattern)
        println("'")
        return 1
    }

    metal_buf_print(buf)
    0
}
