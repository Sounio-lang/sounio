// Stage probe for the GPU Knowledge Vec4 pack/unpack backend harness.
//
// This file is diagnostic evidence for the backend blocker: it keeps the same
// lean GPU modules as the production-backend witness and prints progress before
// each large-value operation so the probe can classify the runtime crash.

use kernel_ir_wmma_lean::*
use lower_to_ptx_wmma_vec4::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    println("stage: begin")
    var k = gpu_kernel_new()
    println("stage: kernel_new")
    k.kernel_name = ki_ir_name_from_str("gpu_vec4_pack_unpack", 20)
    println("stage: name_set")
    var p_in = gpu_param_new()
    p_in.name = ki_ir_name_from_str("in_ptr", 6)
    p_in.ty = GpuType::GpuPtr
    k.params[0] = p_in
    var p_out = gpu_param_new()
    p_out.name = ki_ir_name_from_str("out_ptr", 7)
    p_out.ty = GpuType::GpuPtr
    k.params[1] = p_out
    k.param_count = 0
    println("stage: params_set")

    var op = gpu_op_new()
    op.opcode = GpuOpcode::GpuRet
    k.ops[0] = op
    k.op_count = 1
    k.max_reg_u64 = 2
    println("stage: ops_set")

    let buf = gpu_lower_vec4_pack_unpack_ops_to_ptx(
        k.kernel_name,
        k.params[0].name,
        k.params[1].name,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
        op,
    )
    println("stage: lower_done")
    ptx_buf_print(buf)
    println("stage: print_done")
    0
}
