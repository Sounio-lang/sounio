// WebGPU Shading Language (WGSL) graphics pipeline emitter
//
// Emits WGSL source for a vertex+fragment render pipeline targeting WebGPU.
// Output is UTF-8 text compatible with wgpu/Dawn/Chrome WebGPU.
//
// Vertex shader: @location(0) position, @location(1) color
//                → @builtin(position) clip_position, @location(0) frag_color
// Fragment shader: @location(0) frag_color → @location(0) out_color

// ============================================================================
// WgslRenderBuf — text buffer for WGSL source output
// ============================================================================

struct WgslRenderBuf {
    data: [i8; 8192],
    len: i64,
}

fn wrend_buf_new() -> WgslRenderBuf {
    WgslRenderBuf { data: [0; 8192], len: 0 }
}

fn wrend_push_byte(buf: WgslRenderBuf, b: i8) -> WgslRenderBuf with Mut, Panic {
    var out = buf
    if out.len < 8192 {
        out.data[out.len] = b
        out.len = out.len + 1
    }
    out
}

fn wrend_push_str(buf: WgslRenderBuf, s: string) -> WgslRenderBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = wrend_push_byte(out, str_char_at(s, i) as i8)
        i = i + 1
    }
    out
}

// ============================================================================
// Emit VertexIn + VertexOut structs
// ============================================================================

fn wrend_emit_structs(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "struct VertexIn {\n")
    b = wrend_push_str(b, "    @location(0) position: vec4<f32>,\n")
    b = wrend_push_str(b, "    @location(1) color: vec4<f32>,\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "struct VertexOut {\n")
    b = wrend_push_str(b, "    @builtin(position) clip_position: vec4<f32>,\n")
    b = wrend_push_str(b, "    @location(0) color: vec4<f32>,\n")
    b = wrend_push_str(b, "}\n\n")
    b
}

// ============================================================================
// Emit vertex shader entry point
// ============================================================================

fn wgsl_emit_vertex_shader(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "@vertex\n")
    b = wrend_push_str(b, "fn vs_main(in: VertexIn) -> VertexOut {\n")
    b = wrend_push_str(b, "    var out: VertexOut;\n")
    b = wrend_push_str(b, "    out.clip_position = in.position;\n")
    b = wrend_push_str(b, "    out.color = in.color;\n")
    b = wrend_push_str(b, "    return out;\n")
    b = wrend_push_str(b, "}\n\n")
    b
}

// ============================================================================
// Emit fragment shader entry point
// ============================================================================

fn wgsl_emit_fragment_shader(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "@fragment\n")
    b = wrend_push_str(b, "fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {\n")
    b = wrend_push_str(b, "    return in.color;\n")
    b = wrend_push_str(b, "}\n")
    b
}

// ============================================================================
// Emit complete WGSL render pipeline
// ============================================================================

fn wgsl_emit_render_pipeline() -> WgslRenderBuf with Mut, Panic, Div {
    var b = wrend_buf_new()
    b = wrend_emit_structs(b)
    b = wgsl_emit_vertex_shader(b)
    b = wgsl_emit_fragment_shader(b)
    b
}

// Print generated WGSL to stdout
fn wgsl_render_print(buf: WgslRenderBuf) with IO, Mut, Panic, Div {
    print("// WGSL render pipeline (")
    print_int(buf.len)
    print(" bytes)\n")
    var i: i64 = 0
    while i < buf.len {
        let c = buf.data[i]
        print_char(c)
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let buf = wgsl_emit_render_pipeline()
    wgsl_render_print(buf)
    0
}
