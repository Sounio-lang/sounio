// WebGPU Shading Language (WGSL) graphics pipeline emitter
//
// Emits WGSL source for a vertex+fragment render pipeline targeting WebGPU.
// Output is UTF-8 text compatible with wgpu/Dawn/Chrome WebGPU.
//
// Vertex shader: @location(0) position, @location(1) color
//                → @builtin(position) clip_position, @location(0) frag_color
// Fragment shader: @location(0) frag_color → @location(0) out_color

// ============================================================================
// WgslRenderBuf — text buffer for WGSL source output
// ============================================================================

struct WgslRenderBuf {
    data: [i8; 16384],
    len: i64,
}

struct RenderScene {
    v0x: f64, v0y: f64, v0z: f64, v0r: f64, v0g: f64, v0b: f64,
    v1x: f64, v1y: f64, v1z: f64, v1r: f64, v1g: f64, v1b: f64,
    v2x: f64, v2y: f64, v2z: f64, v2r: f64, v2g: f64, v2b: f64,
    triangle_count: i64,
}

fn render_scene_default() -> RenderScene {
    RenderScene {
        v0x: 0.0, v0y: 0.72, v0z: 0.1, v0r: 1.0, v0g: 0.15, v0b: 0.12,
        v1x: 0.0 - 0.76, v1y: 0.0 - 0.58, v1z: 0.4, v1r: 0.18, v1g: 0.95, v1b: 0.28,
        v2x: 0.76, v2y: 0.0 - 0.58, v2z: 0.2, v2r: 0.1, v2g: 0.35, v2b: 1.0,
        triangle_count: 1,
    }
}

fn wrend_buf_new() -> WgslRenderBuf {
    WgslRenderBuf { data: [0; 16384], len: 0 }
}

fn wrend_push_byte(buf: WgslRenderBuf, b: i8) -> WgslRenderBuf with Mut, Panic {
    var out = buf
    if out.len < 16384 {
        out.data[out.len] = b
        out.len = out.len + 1
    }
    out
}

fn wrend_push_str(buf: WgslRenderBuf, s: string) -> WgslRenderBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        out = wrend_push_byte(out, str_char_at(s, i) as i8)
        i = i + 1
    }
    out
}

fn render_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == 0 { return "0" }
    if n < 0 { return "-" + render_i64_to_string(0 - n) }

    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var value = n
    while value > 0 {
        let digit = value % 10
        rev[rev_len] = 48 + digit as i8
        rev_len = rev_len + 1
        value = value / 10
    }

    var out: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        out[i] = rev[rev_len - i - 1]
        i = i + 1
    }
    str_from_bytes(out, rev_len)
}

fn scene_to_milli_i64(v: f64) -> i64 {
    (v * 1000.0) as i64
}

fn wrend_push_i64(buf: WgslRenderBuf, value: i64) -> WgslRenderBuf with Mut, Panic, Div, Alloc {
    wrend_push_str(buf, render_i64_to_string(value))
}

// ============================================================================
// Emit VertexIn + VertexOut structs
// ============================================================================

fn wrend_emit_structs(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "struct VertexIn {\n")
    b = wrend_push_str(b, "    @location(0) position: vec4<f32>,\n")
    b = wrend_push_str(b, "    @location(1) color: vec4<f32>,\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "struct VertexOut {\n")
    b = wrend_push_str(b, "    @builtin(position) clip_position: vec4<f32>,\n")
    b = wrend_push_str(b, "    @location(0) color: vec4<f32>,\n")
    b = wrend_push_str(b, "}\n\n")
    b
}

fn wgsl_emit_scene_constant(buf: WgslRenderBuf, name: string, value: i64) -> WgslRenderBuf with Mut, Panic, Div, Alloc {
    var b = buf
    b = wrend_push_str(b, "const ")
    b = wrend_push_str(b, name)
    b = wrend_push_str(b, ": i32 = ")
    b = wrend_push_i64(b, value)
    b = wrend_push_str(b, ";\n")
    b
}

fn wgsl_emit_scene_constants(buf: WgslRenderBuf, scene: RenderScene) -> WgslRenderBuf with Mut, Panic, Div, Alloc {
    var b = buf
    b = wgsl_emit_scene_constant(b, "SCENE_TRIANGLE_COUNT", scene.triangle_count)
    b = wgsl_emit_scene_constant(b, "SCENE_V0X_MILLI", scene_to_milli_i64(scene.v0x))
    b = wgsl_emit_scene_constant(b, "SCENE_V0Y_MILLI", scene_to_milli_i64(scene.v0y))
    b = wgsl_emit_scene_constant(b, "SCENE_V0Z_MILLI", scene_to_milli_i64(scene.v0z))
    b = wgsl_emit_scene_constant(b, "SCENE_V0R_MILLI", scene_to_milli_i64(scene.v0r))
    b = wgsl_emit_scene_constant(b, "SCENE_V0G_MILLI", scene_to_milli_i64(scene.v0g))
    b = wgsl_emit_scene_constant(b, "SCENE_V0B_MILLI", scene_to_milli_i64(scene.v0b))
    b = wgsl_emit_scene_constant(b, "SCENE_V1X_MILLI", scene_to_milli_i64(scene.v1x))
    b = wgsl_emit_scene_constant(b, "SCENE_V1Y_MILLI", scene_to_milli_i64(scene.v1y))
    b = wgsl_emit_scene_constant(b, "SCENE_V1Z_MILLI", scene_to_milli_i64(scene.v1z))
    b = wgsl_emit_scene_constant(b, "SCENE_V1R_MILLI", scene_to_milli_i64(scene.v1r))
    b = wgsl_emit_scene_constant(b, "SCENE_V1G_MILLI", scene_to_milli_i64(scene.v1g))
    b = wgsl_emit_scene_constant(b, "SCENE_V1B_MILLI", scene_to_milli_i64(scene.v1b))
    b = wgsl_emit_scene_constant(b, "SCENE_V2X_MILLI", scene_to_milli_i64(scene.v2x))
    b = wgsl_emit_scene_constant(b, "SCENE_V2Y_MILLI", scene_to_milli_i64(scene.v2y))
    b = wgsl_emit_scene_constant(b, "SCENE_V2Z_MILLI", scene_to_milli_i64(scene.v2z))
    b = wgsl_emit_scene_constant(b, "SCENE_V2R_MILLI", scene_to_milli_i64(scene.v2r))
    b = wgsl_emit_scene_constant(b, "SCENE_V2G_MILLI", scene_to_milli_i64(scene.v2g))
    b = wgsl_emit_scene_constant(b, "SCENE_V2B_MILLI", scene_to_milli_i64(scene.v2b))
    b = wrend_push_str(b, "\n")
    b
}

fn wgsl_emit_scene_helpers(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "fn scene_scalar(milli: i32) -> f32 {\n")
    b = wrend_push_str(b, "    return f32(milli) / 1000.0;\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_position_0() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V0X_MILLI), scene_scalar(SCENE_V0Y_MILLI), scene_scalar(SCENE_V0Z_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_position_1() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V1X_MILLI), scene_scalar(SCENE_V1Y_MILLI), scene_scalar(SCENE_V1Z_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_position_2() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V2X_MILLI), scene_scalar(SCENE_V2Y_MILLI), scene_scalar(SCENE_V2Z_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_color_0() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V0R_MILLI), scene_scalar(SCENE_V0G_MILLI), scene_scalar(SCENE_V0B_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_color_1() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V1R_MILLI), scene_scalar(SCENE_V1G_MILLI), scene_scalar(SCENE_V1B_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_color_2() -> vec4<f32> {\n")
    b = wrend_push_str(b, "    return vec4<f32>(scene_scalar(SCENE_V2R_MILLI), scene_scalar(SCENE_V2G_MILLI), scene_scalar(SCENE_V2B_MILLI), 1.0);\n")
    b = wrend_push_str(b, "}\n\n")
    b = wrend_push_str(b, "fn scene_triangle_vertex(index: i32) -> VertexIn {\n")
    b = wrend_push_str(b, "    if index == 0 { return VertexIn(scene_position_0(), scene_color_0()); }\n")
    b = wrend_push_str(b, "    if index == 1 { return VertexIn(scene_position_1(), scene_color_1()); }\n")
    b = wrend_push_str(b, "    return VertexIn(scene_position_2(), scene_color_2()); }\n\n")
    b
}

// ============================================================================
// Emit vertex shader entry point
// ============================================================================

fn wgsl_emit_vertex_shader(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "@vertex\n")
    b = wrend_push_str(b, "fn vs_main(in: VertexIn) -> VertexOut {\n")
    b = wrend_push_str(b, "    var out: VertexOut;\n")
    b = wrend_push_str(b, "    out.clip_position = in.position;\n")
    b = wrend_push_str(b, "    out.color = in.color;\n")
    b = wrend_push_str(b, "    return out;\n")
    b = wrend_push_str(b, "}\n\n")
    b
}

// ============================================================================
// Emit fragment shader entry point
// ============================================================================

fn wgsl_emit_fragment_shader(buf: WgslRenderBuf) -> WgslRenderBuf with Mut, Panic, Div {
    var b = buf
    b = wrend_push_str(b, "@fragment\n")
    b = wrend_push_str(b, "fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {\n")
    b = wrend_push_str(b, "    return in.color;\n")
    b = wrend_push_str(b, "}\n")
    b
}

// ============================================================================
// Emit complete WGSL render pipeline
// ============================================================================

fn wgsl_emit_render_pipeline() -> WgslRenderBuf with Mut, Panic, Div {
    var b = wrend_buf_new()
    b = wrend_emit_structs(b)
    b = wgsl_emit_vertex_shader(b)
    b = wgsl_emit_fragment_shader(b)
    b
}

fn wgsl_emit_scene_comment(buf: WgslRenderBuf, scene: RenderScene) -> WgslRenderBuf with Mut, Panic, Div, Alloc {
    var b = buf
    b = wrend_push_str(b, "// Sounio scene: ")
    b = wrend_push_i64(b, scene.triangle_count)
    b = wrend_push_str(b, " triangle\n")
    b = wrend_emit_structs(b)
    b = wgsl_emit_scene_constants(b, scene)
    b = wgsl_emit_scene_helpers(b)
    b = wgsl_emit_vertex_shader(b)
    b = wgsl_emit_fragment_shader(b)
    b
}

// Print generated WGSL to stdout
fn wgsl_render_print(buf: WgslRenderBuf) with IO, Mut, Panic, Div {
    print("// WGSL render pipeline (")
    print_int(buf.len)
    print(" bytes)\n")
    var i: i64 = 0
    while i < buf.len {
        let c = buf.data[i]
        print_char(c)
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let scene = render_scene_default()
    let buf = wgsl_emit_scene_comment(wrend_buf_new(), scene)
    wgsl_render_print(buf)
    0
}
