//@ run-pass
// self-hosted/gpu/test_ptx_codegen.sio — End-to-end GPU PTX codegen gate test
//
// Validates the full chain:
//   gpu_build_vec_add_ir()          [kernel_ir.sio]
//       │
//   ptx_codegen_kernel_ampere()     [ptx_advanced.sio]
//       │
//   PtxBuf (PTX text)
//       │
//   ptx_buf_contains()              [ptx.sio]
//       └─► assert expected directives + opcodes present
//
// Does NOT require GPU hardware — validates code generation only.

use kernel_ir::*
use ptx::*
use ptx_advanced::*

// ============================================================================
// Test 1: vec_add kernel produces PTX with .visible .entry
// ============================================================================

fn test_ptx_entry_directive() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    ptx_buf_contains(buf, ".visible .entry")
}

// ============================================================================
// Test 2: PTX header emitted (.version)
// ============================================================================

fn test_ptx_version_header() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    ptx_buf_contains(buf, ".version")
}

// ============================================================================
// Test 3: PTX contains .target directive
// ============================================================================

fn test_ptx_target_directive() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    ptx_buf_contains(buf, ".target")
}

// ============================================================================
// Test 4: PTX contains .param declarations (3 pointer params)
// ============================================================================

fn test_ptx_param_declarations() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    ptx_buf_contains(buf, ".param")
}

// ============================================================================
// Test 5: PTX closing brace (well-formed kernel body)
// ============================================================================

fn test_ptx_closing_brace() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    ptx_buf_contains(buf, "}")
}

// ============================================================================
// Test 6: PTX buffer is non-empty (codegen produced output)
// ============================================================================

fn test_ptx_nonempty() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_ampere(kernel)
    buf.len > 10
}

// ============================================================================
// Test 7: Default arch (sm_50) also produces valid PTX
// ============================================================================

fn test_ptx_default_arch() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_default(kernel)
    ptx_buf_contains(buf, ".visible .entry")
}

// ============================================================================
// Test 8: Hopper (sm_90) codegen works
// ============================================================================

fn test_ptx_hopper_arch() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_hopper(kernel)
    ptx_buf_contains(buf, ".target")
}

// ============================================================================
// Test 9: Blackwell (sm_100) codegen works
// ============================================================================

fn test_ptx_blackwell_arch() -> bool with Mut, Panic, Div, Alloc {
    let kernel = gpu_build_vec_add_ir()
    let buf = ptx_codegen_kernel_blackwell(kernel)
    ptx_buf_contains(buf, ".version")
}

// ============================================================================
// Test 10: Empty kernel produces at least a header
// ============================================================================

fn test_ptx_empty_kernel() -> bool with Mut, Panic, Div, Alloc {
    let k = gpu_kernel_new()
    let buf = ptx_codegen_kernel_default(k)
    buf.len > 0
}

// ============================================================================
// Entry point
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if !test_ptx_nonempty() {
        println("FAIL test_ptx_nonempty")
        return 1
    }

    if !test_ptx_version_header() {
        println("FAIL test_ptx_version_header")
        return 2
    }

    if !test_ptx_target_directive() {
        println("FAIL test_ptx_target_directive")
        return 3
    }

    if !test_ptx_entry_directive() {
        println("FAIL test_ptx_entry_directive")
        return 4
    }

    if !test_ptx_param_declarations() {
        println("FAIL test_ptx_param_declarations")
        return 5
    }

    if !test_ptx_closing_brace() {
        println("FAIL test_ptx_closing_brace")
        return 6
    }

    if !test_ptx_default_arch() {
        println("FAIL test_ptx_default_arch")
        return 7
    }

    if !test_ptx_hopper_arch() {
        println("FAIL test_ptx_hopper_arch")
        return 8
    }

    if !test_ptx_blackwell_arch() {
        println("FAIL test_ptx_blackwell_arch")
        return 9
    }

    if !test_ptx_empty_kernel() {
        println("FAIL test_ptx_empty_kernel")
        return 10
    }

    println("PASS 10/10 PTX codegen gate tests")
    0
}
