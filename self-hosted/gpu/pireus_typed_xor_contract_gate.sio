// Sounio-native acceptance witness for the GPU semantic boundary.

use hlir::ir::*
use gpu::hlir_to_gpu::*

fn main() -> i32 with IO, Mut, Panic, Div {
    var good = hlir_instr_new(HLIR_OP_CALL_DIRECT)
    good.operator_kind = HLIR_OPERATOR_XOR_CONVOLUTION
    good.xor_bits = 4
    good.xor_twist = HLIR_XOR_TWIST_CAYLEY_DICKSON_SIGN
    good.xor_candidate = HLIR_XOR_CANDIDATE_AUTO
    good.call_arg_count = 3
    if !hlir_gpu_xor_contract_valid(good) { return 1 }

    var bad_bits = good
    bad_bits.xor_bits = 3
    if hlir_gpu_xor_contract_valid(bad_bits) { return 2 }

    var bad_twist = good
    bad_twist.xor_twist = HLIR_XOR_TWIST_NONE
    if hlir_gpu_xor_contract_valid(bad_twist) { return 3 }

    var bad_arity = good
    bad_arity.call_arg_count = 2
    if hlir_gpu_xor_contract_valid(bad_arity) { return 4 }

    var bad_candidate = good
    bad_candidate.xor_candidate = HLIR_XOR_CANDIDATE_TWO_ZMM_INDEXED_PERMUTE
    if hlir_gpu_xor_contract_valid(bad_candidate) { return 5 }

    print("PIREUS_TYPED_XOR_CONTRACT_GATE_PASS\n")
    0
}
