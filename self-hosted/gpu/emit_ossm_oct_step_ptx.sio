// Sounio emitter for the O-SSM octonion LINEAR recurrence step on tensor cores (Convention X).
// sounio_ossm_oct_step(A_ptr[8], B_ptr[8], x_ptr[16], H_ptr[16*8], out_ptr[256]) computes, for a
// 16-wide batch: S[k][b] = (A⊗H[b])[k] + B[k]·x[b]. The octonion multiply A⊗H (across the batch) is
// L(A)·H — one wmma m16n16k16 tile — then thread 0 adds the B·x term. This is the tensor-core batched
// form of the O-SSM forward step's `ah = A⊗h_prev; sum = ah + B·x` (self-hosted/gpu/kernels/ossm_forward.sio).
fn i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == 0 { return "0" }
    var digits = ""
    var x = n
    while x > 0 {
        let d = x - (x / 10) * 10
        var ch = "0"
        if d == 1 { ch = "1" }
        if d == 2 { ch = "2" }
        if d == 3 { ch = "3" }
        if d == 4 { ch = "4" }
        if d == 5 { ch = "5" }
        if d == 6 { ch = "6" }
        if d == 7 { ch = "7" }
        if d == 8 { ch = "8" }
        if d == 9 { ch = "9" }
        digits = str_concat(ch, digits)
        x = x / 10
    }
    digits
}
fn cd_sigma(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma(a_lo, 0, bits - 1) }
        return 0 - cd_sigma(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma(0, a_lo, bits - 1) }
    cd_sigma(b_lo, a_lo, bits - 1)
}
fn frag(prefix: string, start: i64, count: i64) -> string with Mut, Panic, Div, Alloc {
    var s = "{"
    var i: i64 = 0
    while i < count {
        if i > 0 { s = str_concat(s, ", ") }
        s = str_concat(str_concat(s, prefix), i64_to_string(start + i))
        i = i + 1
    }
    str_concat(s, "}")
}
fn main() with IO, Mut, Panic, Div, Alloc {
    print(".version 9.0\n")
    print(".target sm_121\n")
    print(".address_size 64\n\n")
    print(".visible .entry sounio_ossm_oct_step(\n")
    print("    .param .u64 .ptr .align 4 p_A,\n")
    print("    .param .u64 .ptr .align 4 p_B,\n")
    print("    .param .u64 .ptr .align 4 p_x,\n")
    print("    .param .u64 .ptr .align 4 p_H,\n")
    print("    .param .u64 .ptr .align 4 p_out\n")
    print(")\n{\n")
    print("    .reg .pred %p<2>;\n")
    print("    .reg .b16 %rs<2>;\n")
    print("    .reg .b32 %r<24>;\n")
    print("    .reg .b32 %f<12>;\n")
    print("    .reg .b64 %rd<14>;\n")
    print("    .shared .align 2 .b8 sL[512];\n")
    print("    .shared .align 2 .b8 sH[512];\n")
    print("    ld.param.u64 %rd1, [p_A];\n")
    print("    ld.param.u64 %rd2, [p_B];\n")
    print("    ld.param.u64 %rd7, [p_x];\n")
    print("    ld.param.u64 %rd8, [p_H];\n")
    print("    ld.param.u64 %rd3, [p_out];\n")
    print("    cvta.to.global.u64 %rd4, %rd1;\n")
    print("    cvta.to.global.u64 %rd9, %rd2;\n")
    print("    cvta.to.global.u64 %rd10, %rd7;\n")
    print("    cvta.to.global.u64 %rd5, %rd8;\n")
    print("    cvta.to.global.u64 %rd6, %rd3;\n")
    print("    mov.u32 %r18, sL;\n")
    print("    mov.u32 %r19, sH;\n")
    print("    mov.u32 %r1, %tid.x;\n")
    print("    setp.ne.u32 %p1, %r1, 0;\n")
    print("    @%p1 bra $BUILD_DONE;\n")
    print("    mov.u16 %rs1, 0;\n")
    print("    mov.u32 %r21, 0;\n")
    print("$ZERO:\n")
    print("    add.s32 %r20, %r18, %r21;\n")
    print("    st.shared.u16 [%r20], %rs1;\n")
    print("    add.s32 %r20, %r19, %r21;\n")
    print("    st.shared.u16 [%r20], %rs1;\n")
    print("    add.s32 %r21, %r21, 2;\n")
    print("    setp.lt.u32 %p1, %r21, 512;\n")
    print("    @%p1 bra $ZERO;\n")
    // build L(A): L[k][j]=σ(k⊕j,j)·A[k⊕j]  (8x8 in 16x16)
    var k: i64 = 0
    while k < 8 {
        var j: i64 = 0
        while j < 8 {
            let i = k ^ j
            print("    ld.global.f32 %f1, [%rd4+") print(i64_to_string(i * 4)) print("];\n")
            if cd_sigma(i, j, 3) < 0 { print("    neg.f32 %f1, %f1;\n") }
            print("    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r18+") print(i64_to_string((k * 16 + j) * 2)) print("], %rs1;\n")
            j = j + 1
        }
        k = k + 1
    }
    // stage H col-major: sH[b*16+r] = H[b*8+r], r<8
    var b: i64 = 0
    while b < 16 {
        var r: i64 = 0
        while r < 8 {
            print("    ld.global.f32 %f1, [%rd5+") print(i64_to_string((b * 8 + r) * 4)) print("];\n")
            print("    cvt.rn.f16.f32 %rs1, %f1;\n    st.shared.u16 [%r19+") print(i64_to_string((b * 16 + r) * 2)) print("], %rs1;\n")
            r = r + 1
        }
        b = b + 1
    }
    print("$BUILD_DONE:\n")
    print("    bar.sync 0;\n")
    print("    mov.b32 %r1, 16;\n")
    print("    mov.f32 %f0, 0f00000000;\n")
    let aF = frag("%r", 2, 8)
    let hF = frag("%r", 10, 8)
    let dF = frag("%f", 2, 8)
    // AH = L(A)·H  (matrix_b col-major = H columns are batch states)
    print("    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 ") print(aF) print(", [%r18], %r1;\n")
    print("    wmma.load.b.sync.aligned.col.m16n16k16.shared.f16 ") print(hF) print(", [%r19], %r1;\n")
    print("    wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 ") print(dF) print(", ") print(aF) print(", ") print(hF)
    print(", {%f0, %f0, %f0, %f0, %f0, %f0, %f0, %f0};\n")
    print("    wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd6], ") print(dF) print(", %r1;\n")
    print("    bar.sync 0;\n")
    // thread 0: S[k*16+b] += B[k]*x[b]  (post-add, unrolled)
    print("    mov.u32 %r1, %tid.x;\n")
    print("    setp.ne.u32 %p1, %r1, 0;\n")
    print("    @%p1 bra $DONE;\n")
    var kk: i64 = 0
    while kk < 8 {
        var bb: i64 = 0
        while bb < 16 {
            let off = (kk * 16 + bb) * 4
            print("    ld.global.f32 %f2, [%rd9+") print(i64_to_string(kk * 4)) print("];\n")   // B[k]
            print("    ld.global.f32 %f3, [%rd10+") print(i64_to_string(bb * 4)) print("];\n")  // x[b]
            print("    ld.global.f32 %f4, [%rd6+") print(i64_to_string(off)) print("];\n")       // S[k][b]
            print("    fma.rn.f32 %f4, %f2, %f3, %f4;\n")
            print("    st.global.f32 [%rd6+") print(i64_to_string(off)) print("], %f4;\n")
            bb = bb + 1
        }
        kk = kk + 1
    }
    print("$DONE:\n    ret;\n}\n")
}
