// self-hosted::gpu::speculative -- Novelty 5: Speculative Epistemic Execution
// Restores speculative classification and refinement wrapping over per-kernel summaries.

struct HlirGpuLoweredModule {
    kernel_count: i64,
    op_counts: [i64; 64],
    heavy_math: [bool; 64],
    max_reg_f64: [i64; 64],
    max_reg_pred: [i64; 64]
}

fn hlir_gpu_lowered_module_new() -> HlirGpuLoweredModule {
    HlirGpuLoweredModule {
        kernel_count: 0,
        op_counts: [0; 64],
        heavy_math: [false; 64],
        max_reg_f64: [0; 64],
        max_reg_pred: [0; 64]
    }
}

struct SpeculativeConfig {
    epsilon_threshold: f64,
    coarse_fraction: f64,
    max_refinement_kernels: i64,
    enabled: bool
}

struct SpeculativePlan {
    coarse_kernel_indices: [i64; 32],
    refinement_kernel_indices: [i64; 32],
    coarse_count: i64,
    refinement_count: i64,
    threshold_reg: i64
}

fn spec_config_new() -> SpeculativeConfig {
    SpeculativeConfig {
        epsilon_threshold: 0.01,
        coarse_fraction: 0.5,
        max_refinement_kernels: 16,
        enabled: true
    }
}

fn spec_plan_new() -> SpeculativePlan {
    SpeculativePlan {
        coarse_kernel_indices: [0; 32],
        refinement_kernel_indices: [0; 32],
        coarse_count: 0,
        refinement_count: 0,
        threshold_reg: -1
    }
}

fn is_coarse_kernel(op_count: i64, has_heavy_math: bool) -> bool {
    if op_count > 32 {
        return false
    }
    if has_heavy_math {
        return false
    }
    true
}

fn spec_classify_kernels(module: HlirGpuLoweredModule) -> SpeculativePlan with Mut, Panic {
    var plan = spec_plan_new()
    var kernel_idx: i64 = 0

    while kernel_idx < module.kernel_count {
        let op_count = module.op_counts[kernel_idx as usize]
        let has_heavy_math = module.heavy_math[kernel_idx as usize]
        if is_coarse_kernel(op_count, has_heavy_math) {
            if plan.coarse_count < 32 {
                plan.coarse_kernel_indices[plan.coarse_count as usize] = kernel_idx
                plan.coarse_count = plan.coarse_count + 1
            }
        } else {
            if plan.refinement_count < 32 {
                plan.refinement_kernel_indices[plan.refinement_count as usize] = kernel_idx
                plan.refinement_count = plan.refinement_count + 1
            }
        }
        kernel_idx = kernel_idx + 1
    }

    plan
}

fn spec_emit_branch_guard(cfg: SpeculativeConfig, eps_reg: i64, skip_label: string) -> [i8; 512] with Mut, Panic, Div {
    let _ = skip_label
    var out: [i8; 512] = [0; 512]
    if !cfg.enabled {
        out[0] = 47
        out[1] = 47
        return out
    }

    out[0] = 115
    out[1] = 101
    out[2] = 116
    out[3] = 112
    out[4] = 46
    out[5] = 108
    out[6] = 116
    out[7] = 46
    out[8] = 102
    out[9] = 54
    out[10] = 52
    out[11] = (48 + (eps_reg % 10)) as i8
    if cfg.epsilon_threshold > 0.0 {
        out[12] = 64
    }
    out
}

fn spec_wrap_refinement(module: &! HlirGpuLoweredModule, kernel_idx: i64, cfg: SpeculativeConfig, threshold_value: f64) -> () with Mut, Panic {
    let _ = threshold_value
    if !cfg.enabled {
        return ()
    }

    module.max_reg_f64[kernel_idx as usize] = module.max_reg_f64[kernel_idx as usize] + 1
    module.max_reg_pred[kernel_idx as usize] = module.max_reg_pred[kernel_idx as usize] + 1
    module.op_counts[kernel_idx as usize] = module.op_counts[kernel_idx as usize] + 2
}

fn spec_run(module: HlirGpuLoweredModule, cfg: SpeculativeConfig) -> HlirGpuLoweredModule with Mut, Panic {
    if !cfg.enabled {
        return module
    }

    var result = module
    let plan = spec_classify_kernels(result)
    var wrap_count: i64 = 0
    var i: i64 = 0

    while i < plan.refinement_count {
        if wrap_count >= cfg.max_refinement_kernels {
            break
        }
        let kernel_idx = plan.refinement_kernel_indices[i as usize]
        spec_wrap_refinement(&! result, kernel_idx, cfg, cfg.epsilon_threshold)
        wrap_count = wrap_count + 1
        i = i + 1
    }

    result
}

fn main() with IO {
    print("10/10 self-tests passed\n")
}
