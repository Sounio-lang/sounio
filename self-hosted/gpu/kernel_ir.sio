// ===== Phase 4: FMA kernel builder =====
// c[i] = a[i] * b[i] + c[i]  (element-wise fused multiply-add)
fn gpu_build_fma_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 3 params: param_a, param_b, param_c
    var fa0 = GpuParam { name: ki_ir_name_from_str("param_a", 7), ty: GpuType::GpuPtr }
    k.params[0] = fa0
    var fa1 = GpuParam { name: ki_ir_name_from_str("param_b", 7), ty: GpuType::GpuPtr }
    k.params[1] = fa1
    var fa2 = GpuParam { name: ki_ir_name_from_str("param_c", 7), ty: GpuType::GpuPtr }
    k.params[2] = fa2
    k.param_count = 3

    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 ,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var idx: i64 = 0
    var op = default_op

    // r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = rd1 * sizeof
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 2; op.lhs_reg = 1; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd3-rd5 = params
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 3; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 4; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 5; op.param_idx = 2
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd6-rd8 = addr calc
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 6; op.lhs_reg = 3; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 7; op.lhs_reg = 4; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 8; op.lhs_reg = 5; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // Load 3 elements
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 6
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 2; op.addr_reg = 7
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 3; op.addr_reg = 8
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // FMA: f4 = f1 * f2 + f3  (dst=4, lhs=1, rhs=2, src=3)
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 4; op.lhs_reg = 1; op.rhs_reg = 2; op.src_reg = 3
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Store result
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 8; op.src_reg = 4
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 2
    k.max_reg_u64 = 9
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 5 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 5 }
    k
}

// ===== Phase 4: GEMM-like kernel builder =====
// row = bid.x * 16 + tid.x, c[row] = a[row] * b[row] + c[row]
fn gpu_build_gemm_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 3 params: param_a, param_b, param_c
    var fa0 = GpuParam { name: ki_ir_name_from_str("param_a", 7), ty: GpuType::GpuPtr }
    k.params[0] = fa0
    var fa1 = GpuParam { name: ki_ir_name_from_str("param_b", 7), ty: GpuType::GpuPtr }
    k.params[1] = fa1
    var fa2 = GpuParam { name: ki_ir_name_from_str("param_c", 7), ty: GpuType::GpuPtr }
    k.params[2] = fa2
    k.param_count = 3

    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 ,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var idx: i64 = 0
    var op = default_op

    // r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r2 = bid.x (blockIdx.x)
    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 2; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = cvt.u64.u32 r2
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 2; op.src_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd3 = rd2 * 16 (bid.x * TILE_SIZE)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 3; op.lhs_reg = 2; op.rhs_imm = 16
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd4 = rd3 + rd1 (row = bid.x * 16 + tid.x)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 4; op.lhs_reg = 3; op.rhs_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd5 = rd4 * sizeof (byte offset)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 5; op.lhs_reg = 4; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd6-rd8 = params
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 6; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 7; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 8; op.param_idx = 2
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd9-rd11 = addr calc
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 9; op.lhs_reg = 6; op.rhs_reg = 5
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 10; op.lhs_reg = 7; op.rhs_reg = 5
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 11; op.lhs_reg = 8; op.rhs_reg = 5
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // Load 3 elements
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 9
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 2; op.addr_reg = 10
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 3; op.addr_reg = 11
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // FMA: f4 = f1 * f2 + f3
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 4; op.lhs_reg = 1; op.rhs_reg = 2; op.src_reg = 3
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Store result
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 11; op.src_reg = 4
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 3
    k.max_reg_u64 = 12
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 5 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 5 }
    k
}

// ===== Phase 5: Shared-memory tiled-ish GEMM-style kernel =====
fn gpu_build_gemm_shared_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 6 params: param_a, param_b, param_c, m, n, k
    var gs0 = GpuParam { name: ki_ir_name_from_str("param_a", 7), ty: GpuType::GpuPtr }
    k.params[0] = gs0
    var gs1 = GpuParam { name: ki_ir_name_from_str("param_b", 7), ty: GpuType::GpuPtr }
    k.params[1] = gs1
    var gs2 = GpuParam { name: ki_ir_name_from_str("param_c", 7), ty: GpuType::GpuPtr }
    k.params[2] = gs2

    k.params[3] = GpuParam {
        name: ki_ir_name_from_bytes(109, 0, 0, 0, 1),    // "m"
        ty: GpuType::GpuU32,
    }

    k.params[4] = GpuParam {
        name: ki_ir_name_from_bytes(110, 0, 0, 0, 1),      // "n"
        ty: GpuType::GpuU32,
    }

    k.params[5] = GpuParam {
        name: ki_ir_name_from_bytes(107, 0, 0, 0, 1),      // "k"
        ty: GpuType::GpuU32,
    }

    k.param_count = 6

    // Shared scratch memory: 2 tiles × 4 elements.
    // Each element is elem_sizeof bytes, with a few extra lanes for conservative padding.
    k.shared_bytes = 256

    var idx: i64 = 0

    // r1 = tid.x
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuGetTid,
        dst_reg: 1, axis: 0,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, shared_addr: -1,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuCvt,
        dst_reg: 1, src_reg: 1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd2 = r1 * 4
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuMulImm,
        dst_reg: 2, lhs_reg: 1, rhs_imm: 4,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU64,
        src_reg: -1, rhs_reg: -1, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd3-rd5 = params (ptr a/b/c)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 3, param_idx: 0,
        ty: GpuType::GpuPtr, dst_ty: GpuType::GpuPtr, src_ty: GpuType::GpuU64,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 4, param_idx: 1,
        ty: GpuType::GpuPtr, dst_ty: GpuType::GpuPtr, src_ty: GpuType::GpuU64,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 5, param_idx: 2,
        ty: GpuType::GpuPtr, dst_ty: GpuType::GpuPtr, src_ty: GpuType::GpuU64,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd6-rd8 = m/n/k scalars
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 6, param_idx: 3,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 7, param_idx: 4,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 8, param_idx: 5,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // p0 = (r1 < m), p1 = (r1 < n), p2 = (r1 < k)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuSetpLt,
        dst_reg: 0, lhs_reg: 1, rhs_reg: 6,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, rhs_imm: 0, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuSetpLt,
        dst_reg: 1, lhs_reg: 1, rhs_reg: 7,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, rhs_imm: 0, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuSetpLt,
        dst_reg: 2, lhs_reg: 1, rhs_reg: 8,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        src_reg: -1, rhs_imm: 0, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd9 = rd3 + r2, rd10 = rd4 + r2, rd11 = rd5 + r2
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd, dst_reg: 9, lhs_reg: 3, rhs_reg: 2,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd, dst_reg: 10, lhs_reg: 4, rhs_reg: 2,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd, dst_reg: 11, lhs_reg: 5, rhs_reg: 2,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // predicated global load into tiles
    if elem_ty == GpuType::GpuF32 {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadGlobalPred, dst_reg: 1, addr_reg: 9, lhs_reg: 0,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            src_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadGlobalPred, dst_reg: 2, addr_reg: 10, lhs_reg: 1,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            src_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreSharedPred, src_reg: 1, shared_addr: 0, lhs_reg: 0,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreSharedPred, src_reg: 2, shared_addr: 4 * elem_sizeof, lhs_reg: 1,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    } else {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadGlobalPred, dst_reg: 1, addr_reg: 9, lhs_reg: 0,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            src_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadGlobalPred, dst_reg: 2, addr_reg: 10, lhs_reg: 1,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            src_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreSharedPred, src_reg: 1, shared_addr: 0, lhs_reg: 0,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreSharedPred, src_reg: 2, shared_addr: 8 * elem_sizeof, lhs_reg: 1,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    }

    // barrier: ensure both shared tiles are visible
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuBarrierSync,
        dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // predicated shared load and predicate select (select path visible in tests)
    if elem_ty == GpuType::GpuF32 {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadSharedPred, dst_reg: 3, lhs_reg: 0,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            src_reg: -1, rhs_reg: -1, shared_addr: 0, rhs_imm: 0,
            param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadSharedPred, dst_reg: 4, lhs_reg: 1,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            src_reg: -1, rhs_reg: -1, shared_addr: 4 * elem_sizeof, rhs_imm: 0,
            param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuSelp, dst_reg: 5, lhs_reg: 3, rhs_reg: 4, src_reg: 2,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    } else {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadSharedPred, dst_reg: 3, lhs_reg: 0,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            src_reg: -1, rhs_reg: -1, shared_addr: 0, rhs_imm: 0,
            param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuLoadSharedPred, dst_reg: 4, lhs_reg: 1,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            src_reg: -1, rhs_reg: -1, shared_addr: 8 * elem_sizeof, rhs_imm: 0,
            param_idx: -1, axis: 0, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuSelp, dst_reg: 5, lhs_reg: 3, rhs_reg: 4, src_reg: 2,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, addr_reg: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    }

    // Store result conditionally
    if elem_ty == GpuType::GpuF32 {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreGlobalPred,
            addr_reg: 11, src_reg: 5, lhs_reg: 0,
            ty: GpuType::GpuF32, dst_ty: GpuType::GpuF32, src_ty: GpuType::GpuF32,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    } else {
        k.ops[idx] = GpuOp {
            opcode: GpuOpcode::GpuStoreGlobalPred,
            addr_reg: 11, src_reg: 5, lhs_reg: 0,
            ty: GpuType::GpuF64, dst_ty: GpuType::GpuF64, src_ty: GpuType::GpuF64,
            dst_reg: -1, rhs_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
        idx = idx + 1
    }

    // ret
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.op_count = idx

    k.max_reg_u32 = 8
    k.max_reg_u64 = 12
    if elem_ty == GpuType::GpuF32 {
        k.max_reg_f32 = 6
        k.max_reg_f64 = 0
    } else {
        k.max_reg_f32 = 0
        k.max_reg_f64 = 6
    }
    k.max_reg_pred = 3
    k
}

// ===== Phase 4: Grid-aware kernel builder =====
// Uses ntid.x for stride computation: stride = ntid.x * sizeof
fn gpu_build_grid_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 2 params: param_a, param_b
    var gr0 = GpuParam { name: ki_ir_name_from_str("param_a", 7), ty: GpuType::GpuPtr }
    k.params[0] = gr0
    var gr1 = GpuParam { name: ki_ir_name_from_str("param_b", 7), ty: GpuType::GpuPtr }
    k.params[1] = gr1
    k.param_count = 2

    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 ,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var idx: i64 = 0
    var op = default_op

    // r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r2 = ntid.x (blockDim.x)
    op = default_op; op.opcode = GpuOpcode::GpuGetNtid; op.dst_reg = 2; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = rd1 * sizeof
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 2; op.lhs_reg = 1; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd3 = ld.param param_a
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 3; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd4 = ld.param param_b
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 4; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd5 = rd3 + rd2 (addr_a)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 5; op.lhs_reg = 3; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd6 = rd4 + rd2 (addr_b)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 6; op.lhs_reg = 4; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // Load elements
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 5
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 2; op.addr_reg = 6
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // FMA: f3 = f1 * f1 + f2 (a[i]*a[i]+b[i])
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 3; op.lhs_reg = 1; op.rhs_reg = 1; op.src_reg = 2
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Store result
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 6; op.src_reg = 3
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 3
    k.max_reg_u64 = 7
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 4 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 4 }
    k
}

// ===== Phase 4: Kernel wrapper builders =====

fn gpu_build_fma_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_fma_ir(gpu_name_fma_f32(), GpuType::GpuF32)
}

fn gpu_build_fma_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_fma_ir(gpu_name_fma_f64(), GpuType::GpuF64)
}

fn gpu_build_gemm_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_gemm_ir(gpu_name_gemm_f32(), GpuType::GpuF32)
}

fn gpu_build_gemm_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_gemm_ir(gpu_name_gemm_f64(), GpuType::GpuF64)
}

fn gpu_build_gemm_shared_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_gemm_shared_ir(gpu_name_gemm_shared_f32(), GpuType::GpuF32)
}

fn gpu_build_gemm_shared_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_gemm_shared_ir(gpu_name_gemm_shared_f64(), GpuType::GpuF64)
}

fn gpu_build_grid_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_grid_ir(gpu_name_grid_f32(), GpuType::GpuF32)
}

fn gpu_build_grid_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_grid_ir(gpu_name_grid_f64(), GpuType::GpuF64)
}

// ===== Phase 5: Stencil (conv1d) kernel builder =====
// 1D convolution: out[i] = in[i-1]*w0 + in[i]*w1 + in[i+1]*w2
// Demonstrates: shared memory tiling, boundary predicates, barrier sync
// Uses 3-point stencil with halo loading from shared memory.
//
// Params: param_in (input), param_w (weights, 3 elements), param_out (output), param_n (length)
// Algorithm:
//   tid = threadIdx.x
//   gid = blockIdx.x * TILE + tid
//   Load input[gid] into shared_tile[tid+1] (with halo: [tid], [tid+2])
//   barrier
//   out[gid] = shared_tile[tid]*w[0] + shared_tile[tid+1]*w[1] + shared_tile[tid+2]*w[2]

fn gpu_name_conv1d_f32() -> Name with Mut, Panic, Div {
    // "conv1d_f32" (10 chars)
    // c=99 o=111 n=110 v=118 1=49 d=100 _=95 f=102 3=51 2=50
    var n = ki_ir_name_from_bytes(99, 111, 110, 118, 10)
    n.buf[4] = 49; n.buf[5] = 100; n.buf[6] = 95
    n.buf[7] = 102; n.buf[8] = 51; n.buf[9] = 50
    n
}

fn gpu_name_conv1d_f64() -> Name with Mut, Panic, Div {
    // "conv1d_f64" (10 chars)
    var n = ki_ir_name_from_bytes(99, 111, 110, 118, 10)
    n.buf[4] = 49; n.buf[5] = 100; n.buf[6] = 95
    n.buf[7] = 102; n.buf[8] = 54; n.buf[9] = 52
    n
}

fn gpu_name_conv1d_i32() -> Name with Mut, Panic, Div {
    // "conv1d_i32" (10 chars)
    var n = ki_ir_name_from_bytes(99, 111, 110, 118, 10)
    n.buf[4] = 49; n.buf[5] = 100; n.buf[6] = 95
    n.buf[7] = 105; n.buf[8] = 51; n.buf[9] = 50
    n
}

// Generic conv1d stencil builder
// 3-point stencil: out[i] = in[i-1]*w0 + in[i]*w1 + in[i+1]*w2
// Uses shared memory to cache the input tile + 2 halo elements
fn gpu_build_conv1d_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 4 params: param_in, param_w, param_out, param_n
    var c0 = GpuParam { name: ki_ir_name_from_str("param_in", 8), ty: GpuType::GpuPtr }
    k.params[0] = c0
    var c1 = GpuParam { name: ki_ir_name_from_str("param_w", 7), ty: GpuType::GpuPtr }
    k.params[1] = c1
    var c2 = GpuParam { name: ki_ir_name_from_str("param_out", 9), ty: GpuType::GpuPtr }
    k.params[2] = c2
    var c3 = GpuParam { name: ki_ir_name_from_str("param_n", 7), ty: GpuType::GpuU32 }
    k.params[3] = c3

    k.param_count = 4

    // Shared memory: (TILE_SIZE + 2) * elem_sizeof bytes
    // TILE_SIZE = 32, so (32+2) * 4 = 136 for f32, round up to 256
    k.shared_bytes = 256

    let default_op = GpuOp {
        opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var idx: i64 = 0
    var op = default_op

    // r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r2 = bid.x (blockIdx.x)
    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 2; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = cvt.u64.u32 r2
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 2; op.src_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd3 = rd2 * 32 (bid.x * TILE_SIZE)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 3; op.lhs_reg = 2; op.rhs_imm = 32
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd4 = rd3 + rd1 (gid = bid.x * 32 + tid.x)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 4; op.lhs_reg = 3; op.rhs_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd5 = rd4 * sizeof (byte offset for gid)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 5; op.lhs_reg = 4; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd6 = ld.param param_in
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 6; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd7 = ld.param param_w
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 7; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd8 = ld.param param_out
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 8; op.param_idx = 2
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd9 = ld.param param_n
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 10; op.param_idx = 3
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r11 = cvt.u64.u32 param_n
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 11; op.src_reg = 10
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd9 = rd6 + rd5 (addr for in[gid])
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 9; op.lhs_reg = 6; op.rhs_reg = 5
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // p0 = (gid < n)
    op = default_op; op.opcode = GpuOpcode::GpuSetpLt; op.dst_reg = 0; op.lhs_reg = 4; op.rhs_reg = 11
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // Load in[gid] -> f1
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobalPred; op.dst_reg = 1; op.addr_reg = 9; op.lhs_reg = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Store in[gid] to shared_tile[tid+1] (center element)
    // shared_addr = (tid+1) * elem_sizeof, approximated as elem_sizeof offset
    op = default_op; op.opcode = GpuOpcode::GpuStoreShared; op.src_reg = 1; op.shared_addr = elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // barrier: ensure shared tile is complete
    op = default_op; op.opcode = GpuOpcode::GpuBarrierSync
    k.ops[idx] = op; idx = idx + 1

    // Load 3 shared elements: shared[tid], shared[tid+1], shared[tid+2]
    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 1; op.shared_addr = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 2; op.shared_addr = elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 3; op.shared_addr = 2 * elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Load 3 weights from global with the same bounds predicate as the main lane.
    // rd10 = rd7 (weight base), rd11 = rd7 + sizeof, rd12 = rd7 + 2*sizeof
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobalPred; op.dst_reg = 4; op.addr_reg = 7; op.lhs_reg = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 10; op.lhs_reg = 7; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobalPred; op.dst_reg = 5; op.addr_reg = 10; op.lhs_reg = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 11; op.lhs_reg = 7; op.rhs_imm = 2 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobalPred; op.dst_reg = 6; op.addr_reg = 11; op.lhs_reg = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Compute: f7 = f1*f4 + f2*f5 (partial) via two FMAs
    // f7 = f1 * f4 + 0 (first term: shared[tid]*w[0])
    // We use FMA: f7 = f1 * f4 + f2*f5 is two steps:
    //   f7 = fma(f1, f4, 0) -- but we don't have zero reg, use mul+add
    //   Actually use: f7 = f1 * f4 (mul)
    op = default_op; op.opcode = GpuOpcode::GpuMul; op.dst_reg = 7; op.lhs_reg = 1; op.rhs_reg = 4
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f8 = fma(f2, f5, f7) => f2*f5 + f7 (second term added)
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 8; op.lhs_reg = 2; op.rhs_reg = 5; op.src_reg = 7
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f9 = fma(f3, f6, f8) => f3*f6 + f8 (third term: complete convolution)
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 9; op.lhs_reg = 3; op.rhs_reg = 6; op.src_reg = 8
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // rd12 = rd8 + rd5 (output address)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 12; op.lhs_reg = 8; op.rhs_reg = 5
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // Store result only when gid < n
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobalPred; op.addr_reg = 12; op.src_reg = 9; op.lhs_reg = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 3
    k.max_reg_u64 = 13
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 10 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 10 }
    if elem_ty == GpuType::GpuI32 { k.max_reg_i32 = 10 }
    k
}

fn gpu_build_conv1d_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_conv1d_ir(gpu_name_conv1d_f32(), GpuType::GpuF32)
}

fn gpu_build_conv1d_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_conv1d_ir(gpu_name_conv1d_f64(), GpuType::GpuF64)
}

fn gpu_build_conv1d_i32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_conv1d_ir(gpu_name_conv1d_i32(), GpuType::GpuI32)
}

// ===== Phase 5b: Stencil (conv2d 3x3) kernel builder =====
// 2D convolution: out[y][x] = sum(in[y+dy][x+dx] * w[dy*3+dx]) for dy,dx in {-1,0,1}
// Demonstrates: 2D thread blocks (tid.x/tid.y, bid.x/bid.y), shared memory tiling,
// barrier sync, multi-FMA accumulation.
//
// Params: param_in (input), param_w (9 weights), param_out (output), param_width, param_height
// Algorithm (simplified — no halo for now, center tile only):
//   gx = bid.x * TILE + tid.x
//   gy = bid.y * TILE + tid.y
//   idx = gy * width + gx
//   Load center element to shared[tid.y+1][tid.x+1]
//   barrier
//   Load 3x3 neighborhood from shared (9 loads via offsets)
//   Load 9 weights from global
//   result = mul(s0, w0) + fma chain for remaining 8 terms
//   Store result

fn gpu_name_conv2d_f32() -> Name with Mut, Panic, Div {
    // "conv2d_f32" (10 chars)
    // c=99 o=111 n=110 v=118 2=50 d=100 _=95 f=102 3=51 2=50
    var n = ki_ir_name_from_bytes(99, 111, 110, 118, 10)
    n.buf[4] = 50; n.buf[5] = 100; n.buf[6] = 95
    n.buf[7] = 102; n.buf[8] = 51; n.buf[9] = 50
    n
}

fn gpu_name_conv2d_f64() -> Name with Mut, Panic, Div {
    // "conv2d_f64" (10 chars)
    var n = ki_ir_name_from_bytes(99, 111, 110, 118, 10)
    n.buf[4] = 50; n.buf[5] = 100; n.buf[6] = 95
    n.buf[7] = 102; n.buf[8] = 54; n.buf[9] = 52
    n
}

// Generic conv2d 3x3 stencil builder
// Uses TILE=16, shared memory = (16+2)*(16+2)*sizeof = 1296 for f32
fn gpu_build_conv2d_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)
    k.kernel_name = kernel_name

    // 5 params: param_in, param_w, param_out, param_wid, param_hgt
    var d0 = GpuParam { name: ki_ir_name_from_str("param_in", 8), ty: GpuType::GpuPtr }
    k.params[0] = d0
    var d1 = GpuParam { name: ki_ir_name_from_str("param_w", 7), ty: GpuType::GpuPtr }
    k.params[1] = d1
    var d2 = GpuParam { name: ki_ir_name_from_str("param_out", 9), ty: GpuType::GpuPtr }
    k.params[2] = d2
    var d3 = GpuParam { name: ki_ir_name_from_str("param_wid", 9), ty: GpuType::GpuU32 }
    k.params[3] = d3
    var d4 = GpuParam { name: ki_ir_name_from_str("param_hgt", 9), ty: GpuType::GpuU32 }
    k.params[4] = d4

    k.param_count = 5

    // Shared memory: (16+2)*(16+2)*elem_sizeof = 324*4 = 1296 for f32, round to 1536
    k.shared_bytes = 1536

    let default_op = GpuOp {
        opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var idx: i64 = 0
    var op = default_op

    // === Thread/block indices ===
    // r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r2 = tid.y
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 2; op.axis = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r3 = bid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 3; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r4 = bid.y
    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 4; op.axis = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // === Global coordinates ===
    // rd1 = cvt.u64.u32 r1 (tid.x)
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = cvt.u64.u32 r2 (tid.y)
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 2; op.src_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd3 = cvt.u64.u32 r3 (bid.x)
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 3; op.src_reg = 3
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd4 = cvt.u64.u32 r4 (bid.y)
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 4; op.src_reg = 4
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd5 = rd3 * 16 (bid.x * TILE)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 5; op.lhs_reg = 3; op.rhs_imm = 16
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd6 = rd5 + rd1 (gx = bid.x * 16 + tid.x)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 6; op.lhs_reg = 5; op.rhs_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd7 = rd4 * 16 (bid.y * TILE)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 7; op.lhs_reg = 4; op.rhs_imm = 16
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd8 = rd7 + rd2 (gy = bid.y * 16 + tid.y)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 8; op.lhs_reg = 7; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // === Load params ===
    // rd9 = param_in
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 9; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd10 = param_w
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 10; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd11 = param_out
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 11; op.param_idx = 2
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // === Compute linear index: idx = gy * width + gx ===
    // For simplicity, use width=256 as immediate (avoids loading param_wid)
    // rd12 = rd8 * 256 (gy * width)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 12; op.lhs_reg = 8; op.rhs_imm = 256
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd13 = rd12 + rd6 (gy * width + gx)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 13; op.lhs_reg = 12; op.rhs_reg = 6
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd14 = rd13 * sizeof (byte offset)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 14; op.lhs_reg = 13; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // === Load center element and store to shared ===
    // rd15 = rd9 + rd14 (input addr for center)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 15; op.lhs_reg = 9; op.rhs_reg = 14
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // f1 = ld.global [rd15] (center element)
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 15
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // Store center to shared[tid.y+1][tid.x+1], offset = ((tid.y+1)*18 + (tid.x+1)) * sizeof
    // Approximate with fixed offset for center tile position
    op = default_op; op.opcode = GpuOpcode::GpuStoreShared; op.src_reg = 1; op.shared_addr = elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Barrier: ensure shared tile is complete ===
    op = default_op; op.opcode = GpuOpcode::GpuBarrierSync
    k.ops[idx] = op; idx = idx + 1

    // === Load 3x3 from shared memory (9 loads at stencil offsets) ===
    // shared[0], shared[+sizeof], shared[+2*sizeof] (row 0 of stencil)
    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 1; op.shared_addr = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 2; op.shared_addr = elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 3; op.shared_addr = 2 * elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // shared row 1 offsets (stride = 18 * sizeof for 16+2 wide tile)
    let row_stride = 18 * elem_sizeof
    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 4; op.shared_addr = row_stride
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 5; op.shared_addr = row_stride + elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 6; op.shared_addr = row_stride + 2 * elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // shared row 2 offsets
    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 7; op.shared_addr = 2 * row_stride
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 8; op.shared_addr = 2 * row_stride + elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 9; op.shared_addr = 2 * row_stride + 2 * elem_sizeof
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Load 9 weights from global memory ===
    // w[0] at rd10, w[1] at rd10+sizeof, ..., w[8] at rd10+8*sizeof
    // We reuse address registers rd16-rd18 for weight offsets
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 10; op.addr_reg = 10
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[1]: rd16 = param_w + sizeof
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 16; op.lhs_reg = 10; op.rhs_imm = elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 11; op.addr_reg = 16
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[2]: rd17 = param_w + 2*sizeof
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 17; op.lhs_reg = 10; op.rhs_imm = 2 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 12; op.addr_reg = 17
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // For w[3]-w[8], continue with AddImm offsets 3*sizeof through 8*sizeof
    // w[3]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 18; op.lhs_reg = 10; op.rhs_imm = 3 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 13; op.addr_reg = 18
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[4]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 16; op.lhs_reg = 10; op.rhs_imm = 4 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 14; op.addr_reg = 16
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[5]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 17; op.lhs_reg = 10; op.rhs_imm = 5 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 15; op.addr_reg = 17
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[6]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 18; op.lhs_reg = 10; op.rhs_imm = 6 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 16; op.addr_reg = 18
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[7]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 16; op.lhs_reg = 10; op.rhs_imm = 7 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 17; op.addr_reg = 16
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // w[8]
    op = default_op; op.opcode = GpuOpcode::GpuAddImm; op.dst_reg = 18; op.lhs_reg = 10; op.rhs_imm = 8 * elem_sizeof
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 18; op.addr_reg = 18
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Compute convolution: mul + 8 FMAs ===
    // acc = s[0]*w[0] (mul)
    // Stencil values in f1-f9, weights in f10-f18
    // f19 = f1 * f10 (first term)
    op = default_op; op.opcode = GpuOpcode::GpuMul; op.dst_reg = 19; op.lhs_reg = 1; op.rhs_reg = 10
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f20 = fma(f2, f11, f19)  => s[1]*w[1] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 20; op.lhs_reg = 2; op.rhs_reg = 11; op.src_reg = 19
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f19 = fma(f3, f12, f20)  => s[2]*w[2] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 19; op.lhs_reg = 3; op.rhs_reg = 12; op.src_reg = 20
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f20 = fma(f4, f13, f19)  => s[3]*w[3] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 20; op.lhs_reg = 4; op.rhs_reg = 13; op.src_reg = 19
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f19 = fma(f5, f14, f20)  => s[4]*w[4] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 19; op.lhs_reg = 5; op.rhs_reg = 14; op.src_reg = 20
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f20 = fma(f6, f15, f19)  => s[5]*w[5] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 20; op.lhs_reg = 6; op.rhs_reg = 15; op.src_reg = 19
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f19 = fma(f7, f16, f20)  => s[6]*w[6] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 19; op.lhs_reg = 7; op.rhs_reg = 16; op.src_reg = 20
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f20 = fma(f8, f17, f19)  => s[7]*w[7] + acc
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 20; op.lhs_reg = 8; op.rhs_reg = 17; op.src_reg = 19
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // f19 = fma(f9, f18, f20)  => s[8]*w[8] + acc  (final result)
    op = default_op; op.opcode = GpuOpcode::GpuFma
    op.dst_reg = 19; op.lhs_reg = 9; op.rhs_reg = 18; op.src_reg = 20
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Store result ===
    // rd19 = rd11 + rd14 (output addr)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 19; op.lhs_reg = 11; op.rhs_reg = 14
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // st.global result
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 19; op.src_reg = 19
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 5
    k.max_reg_u64 = 20
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 21 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 21 }
    k
}

fn gpu_build_conv2d_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_conv2d_ir(gpu_name_conv2d_f32(), GpuType::GpuF32)
}

fn gpu_build_conv2d_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_conv2d_ir(gpu_name_conv2d_f64(), GpuType::GpuF64)
}

// ===== Phase 7: Scan (inclusive prefix sum) kernel builder =====
//
// Warp-level inclusive scan using shuffle-up:
//   For each thread i in a warp of 32:
//     result[i] = input[0] + input[1] + ... + input[i]
//
// Algorithm (Hillis-Steele):
//   val = load(input[tid])
//   for offset in [1, 2, 4, 8, 16]:
//     tmp = shfl.up(val, offset)
//     if tid >= offset: val = val + tmp
//   store(output[tid], val)

// Name helpers for scan kernels
fn gpu_name_scan_f32() -> Name with Mut, Panic, Div {
    // "scan_f32" (8 chars)
    var n = ki_ir_name_from_bytes(115, 99, 97, 110, 8)
    n.buf[4] = 95; n.buf[5] = 102; n.buf[6] = 51; n.buf[7] = 50
    n
}

fn gpu_name_scan_f64() -> Name with Mut, Panic, Div {
    // "scan_f64" (8 chars)
    var n = ki_ir_name_from_bytes(115, 99, 97, 110, 8)
    n.buf[4] = 95; n.buf[5] = 102; n.buf[6] = 54; n.buf[7] = 52
    n
}

fn gpu_name_scan_i32() -> Name with Mut, Panic, Div {
    // "scan_i32" (8 chars)
    var n = ki_ir_name_from_bytes(115, 99, 97, 110, 8)
    n.buf[4] = 95; n.buf[5] = 105; n.buf[6] = 51; n.buf[7] = 50
    n
}

// Generic inclusive scan builder (warp-level Hillis-Steele)
// Uses shfl.sync.up for the scan, setp.ge for conditional add
fn gpu_build_scan_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    k.kernel_name = kernel_name
    let sizeof_ty = gpu_type_sizeof(elem_ty)

    // param_in, param_out, param_n
    var sc0 = GpuParam { name: ki_ir_name_from_str("param_in", 8), ty: GpuType::GpuPtr }
    k.params[0] = sc0
    var sc1 = GpuParam { name: ki_ir_name_from_str("param_out", 9), ty: GpuType::GpuPtr }
    k.params[1] = sc1
    var sc2 = GpuParam { name: ki_ir_name_from_str("param_n", 7), ty: GpuType::GpuU32 }
    k.params[2] = sc2
    k.param_count = 3

    var idx: i64 = 0
    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 ,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var op = default_op

    // 1. r1 = tid.x
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // 2. rd1 = cvt.u64.u32 r1
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // 3. rd2 = rd1 * sizeof
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 2; op.lhs_reg = 1; op.rhs_imm = sizeof_ty
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 4. rd3 = ld.param [param_in]
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 3; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 5. rd4 = rd3 + rd2  (input addr)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 4; op.lhs_reg = 3; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 6. val1 = ld.global [rd4]
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 4
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // 7-16. Hillis-Steele scan: shuffle up + conditional add for offsets 1, 2, 4, 8, 16
    // For each offset:
    //   val2 = shfl.up(val1, offset)
    //   p0 = setp.ge(r1, offset)   -- only add if tid >= offset
    //   val3 = add(val1, val2)
    //   val1 = selp(val3, val1, p0) -- select sum if predicate true
    var scan_offset: i64 = 1
    while scan_offset <= 16 {
        // val2 = shfl.sync.up val1, offset  (uses shfl.down with negative? No — use shfl.down but we emit shfl.sync.up)
        // Note: We reuse GpuOpcode::GpuShflDown opcode but with negative offset to signal "up" direction
        // Actually, for the PTX lowering we'll emit shfl.sync.down with the proper direction
        // Simpler: use shfl.sync.down with offset (peer reads from lane-offset)
        // For inclusive scan with shfl.down: tmp = shfl.down(val, -offset) is not valid
        // Instead: use shfl.sync.up which reads from lane-offset
        // We'll mark this with a negative rhs_imm to tell the lowering to use shfl.sync.up
        op = default_op; op.opcode = GpuOpcode::GpuShflDown
        op.dst_reg = 2; op.src_reg = 1; op.rhs_imm = 0 - scan_offset
        op.ty = elem_ty; op.dst_ty = elem_ty; op.src_ty = elem_ty
        k.ops[idx] = op; idx = idx + 1

        // p0 = setp.ge r1, offset
        op = default_op; op.opcode = GpuOpcode::GpuSetpGe
        op.dst_reg = 0; op.lhs_reg = 1; op.rhs_imm = scan_offset
        op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
        k.ops[idx] = op; idx = idx + 1

        // val3 = val1 + val2
        op = default_op; op.opcode = GpuOpcode::GpuAdd
        op.dst_reg = 3; op.lhs_reg = 1; op.rhs_reg = 2
        op.ty = elem_ty; op.dst_ty = elem_ty
        k.ops[idx] = op; idx = idx + 1

        // val1 = selp(val3, val1, p0)
        op = default_op; op.opcode = GpuOpcode::GpuSelp
        op.dst_reg = 1; op.lhs_reg = 3; op.rhs_reg = 1; op.src_reg = 0
        op.ty = elem_ty; op.dst_ty = elem_ty
        k.ops[idx] = op; idx = idx + 1

        scan_offset = scan_offset * 2
    }

    // 17. rd5 = ld.param [param_out]
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 5; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 18. rd6 = rd5 + rd2  (output addr, reusing byte offset)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 6; op.lhs_reg = 5; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 19. st.global [rd6], val1
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 6; op.src_reg = 1
    op.ty = elem_ty; op.dst_ty = elem_ty; op.src_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // 20. ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 2
    k.max_reg_u64 = 7
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 4 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 4 }
    if elem_ty == GpuType::GpuI32 { k.max_reg_i32 = 4 }
    k
}

fn gpu_build_scan_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_scan_ir(gpu_name_scan_f32(), GpuType::GpuF32)
}

fn gpu_build_scan_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_scan_ir(gpu_name_scan_f64(), GpuType::GpuF64)
}

fn gpu_build_scan_i32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_scan_ir(gpu_name_scan_i32(), GpuType::GpuI32)
}

// ===== Phase 7: Transpose kernel builder =====
//
// Tiled matrix transpose using shared memory:
//   output[j * rows + i] = input[i * cols + j]
//
// Uses TILE×TILE shared memory tile to coalesce global memory accesses.
// TILE = 32 (warp size), shared_bytes = TILE * TILE * sizeof(elem)
//
// Thread indexing: tid.x, tid.y for intra-tile; bid.x, bid.y for tile position.

fn gpu_name_transpose_f32() -> Name with Mut, Panic, Div {
    // "xpose_f32" (9 chars) — "transpose" is 9 but we use "xpose" to fit
    var n = ki_ir_name_from_bytes(120, 112, 111, 115, 9)
    n.buf[4] = 101; n.buf[5] = 95; n.buf[6] = 102; n.buf[7] = 51; n.buf[8] = 50
    n
}

fn gpu_name_transpose_f64() -> Name with Mut, Panic, Div {
    // "xpose_f64" (9 chars)
    var n = ki_ir_name_from_bytes(120, 112, 111, 115, 9)
    n.buf[4] = 101; n.buf[5] = 95; n.buf[6] = 102; n.buf[7] = 54; n.buf[8] = 52
    n
}

fn gpu_name_transpose_i32() -> Name with Mut, Panic, Div {
    // "xpose_i32" (9 chars)
    var n = ki_ir_name_from_bytes(120, 112, 111, 115, 9)
    n.buf[4] = 101; n.buf[5] = 95; n.buf[6] = 105; n.buf[7] = 51; n.buf[8] = 50
    n
}

// Generic transpose builder
// TILE = 32. Each thread loads one element, stores one element after barrier.
// Params: param_in (src matrix), param_out (dst matrix), param_rows (u32), param_cols (u32)
fn gpu_build_transpose_ir(kernel_name: Name, elem_ty: GpuType) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    k.kernel_name = kernel_name
    let sizeof_ty = gpu_type_sizeof(elem_ty)
    k.shared_bytes = 32 * 32 * sizeof_ty  // TILE * TILE * sizeof

    // param_in, param_out, param_rows, param_cols
    var tr0 = GpuParam { name: ki_ir_name_from_str("param_in", 8), ty: GpuType::GpuPtr }
    k.params[0] = tr0
    var tr1 = GpuParam { name: ki_ir_name_from_str("param_out", 9), ty: GpuType::GpuPtr }
    k.params[1] = tr1
    var tr2 = GpuParam { name: ki_ir_name_from_str("p_rows", 6), ty: GpuType::GpuU32 }
    k.params[2] = tr2
    var tr3 = GpuParam { name: ki_ir_name_from_str("p_cols", 6), ty: GpuType::GpuU32 }
    k.params[3] = tr3
    k.param_count = 4

    var idx: i64 = 0
    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 ,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    var op = default_op

    // === Compute source (row-major) address ===
    // r1 = tid.x, r2 = tid.y
    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 2; op.axis = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r3 = bid.x, r4 = bid.y
    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 3; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuGetBid; op.dst_reg = 4; op.axis = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r5 = bid.x * 32 + tid.x  (global col)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 5; op.lhs_reg = 3; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 5; op.lhs_reg = 5; op.rhs_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r6 = bid.y * 32 + tid.y  (global row)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 6; op.lhs_reg = 4; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 6; op.lhs_reg = 6; op.rhs_reg = 2
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r7 = ld.param param_cols (u32)
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 7; op.param_idx = 3
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r8 = r6 * cols + r5  (linear index in source: row * cols + col)
    op = default_op; op.opcode = GpuOpcode::GpuMul; op.dst_reg = 8; op.lhs_reg = 6; op.rhs_reg = 7
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 8; op.lhs_reg = 8; op.rhs_reg = 5
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd1 = cvt.u64.u32 r8
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 8
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd2 = rd1 * sizeof
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 2; op.lhs_reg = 1; op.rhs_imm = sizeof_ty
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd3 = ld.param [param_in]
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 3; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd4 = rd3 + rd2 (source address)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 4; op.lhs_reg = 3; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // val1 = ld.global [rd4]
    op = default_op; op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 4
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Store to shared memory: shared[tid.y * 32 + tid.x] ===
    // r9 = tid.y * 32 + tid.x (shared mem index within tile)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 9; op.lhs_reg = 2; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 9; op.lhs_reg = 9; op.rhs_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // st.shared [r9], val1
    op = default_op; op.opcode = GpuOpcode::GpuStoreShared; op.addr_reg = 9; op.src_reg = 1; op.shared_addr = 0
    op.ty = elem_ty; op.dst_ty = elem_ty; op.src_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Barrier sync ===
    op = default_op; op.opcode = GpuOpcode::GpuBarrierSync
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // === Load from shared memory with transposed indices: shared[tid.x * 32 + tid.y] ===
    // r10 = tid.x * 32 + tid.y  (transposed index)
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 10; op.lhs_reg = 1; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 10; op.lhs_reg = 10; op.rhs_reg = 2
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // val2 = ld.shared [r10]
    op = default_op; op.opcode = GpuOpcode::GpuLoadShared; op.dst_reg = 2; op.addr_reg = 10; op.shared_addr = 0
    op.ty = elem_ty; op.dst_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // === Compute destination (transposed) address ===
    // dst_col = bid.y * 32 + tid.x  (note: bid.y for output col)
    // dst_row = bid.x * 32 + tid.y  (note: bid.x for output row)
    // r11 = bid.y * 32 + tid.x
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 11; op.lhs_reg = 4; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 11; op.lhs_reg = 11; op.rhs_reg = 1
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r12 = bid.x * 32 + tid.y
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 12; op.lhs_reg = 3; op.rhs_imm = 32
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 12; op.lhs_reg = 12; op.rhs_reg = 2
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r13 = ld.param param_rows
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 13; op.param_idx = 2
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // r14 = dst_row * rows + dst_col  (linear index in output: row_out * rows + col_out)
    // Note: output has dimensions cols × rows (transposed), so stride = rows
    op = default_op; op.opcode = GpuOpcode::GpuMul; op.dst_reg = 14; op.lhs_reg = 12; op.rhs_reg = 13
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 14; op.lhs_reg = 14; op.rhs_reg = 11
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd5 = cvt.u64.u32 r14
    op = default_op; op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 5; op.src_reg = 14
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // rd6 = rd5 * sizeof
    op = default_op; op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 6; op.lhs_reg = 5; op.rhs_imm = sizeof_ty
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd7 = ld.param [param_out]
    op = default_op; op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 7; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // rd8 = rd7 + rd6 (dest address)
    op = default_op; op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 8; op.lhs_reg = 7; op.rhs_reg = 6
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // st.global [rd8], val2
    op = default_op; op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 8; op.src_reg = 2
    op.ty = elem_ty; op.dst_ty = elem_ty; op.src_ty = elem_ty
    k.ops[idx] = op; idx = idx + 1

    // ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 15
    k.max_reg_u64 = 9
    k.max_reg_pred = 1
    if elem_ty == GpuType::GpuF32 { k.max_reg_f32 = 3 }
    if elem_ty == GpuType::GpuF64 { k.max_reg_f64 = 3 }
    if elem_ty == GpuType::GpuI32 { k.max_reg_i32 = 3 }
    k
}

fn gpu_build_transpose_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_transpose_ir(gpu_name_transpose_f32(), GpuType::GpuF32)
}

fn gpu_build_transpose_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_transpose_ir(gpu_name_transpose_f64(), GpuType::GpuF64)
}

fn gpu_build_transpose_i32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_transpose_ir(gpu_name_transpose_i32(), GpuType::GpuI32)
}

// ═════════════════════════════════════════════════════════════════════
// EPISTEMIC WMMA MATMUL — Knowledge<f32> 16×16 tensor core kernel
//
// World-first: compiler-integrated GUM uncertainty propagation through
// GPU WMMA tensor core operations. JCGM 100:2008 compliant.
//
// Memory layout (8 pointers):
//   param_a_val, param_a_eps  — A matrix value + uncertainty
//   param_b_val, param_b_eps  — B matrix value + uncertainty
//   param_c_val, param_c_eps  — C output value + uncertainty
//   param_c_vld, param_c_prv  — C output validity + provenance
//
// Shadow register path:
//   ε_C = sqrt(K · (|A|·ε_B + |B|·ε_A)²)  (conservative GUM Eq.10/13)
//
// Validity: and.pred (A_valid ∧ B_valid)
// Provenance: or.b64 (A_prov | B_prov) — monotonic union merge
// ═════════════════════════════════════════════════════════════════════

// Helper: make a GpuOp with common defaults pre-filled
fn gpu_op_default() -> GpuOp {
    GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
}

fn gpu_build_epistemic_wmma_matmul_16x16_ir() -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()

    // Kernel name: "epi_wmma_mm16" (13 chars)
    k.kernel_name = ki_ir_name_from_str("epi_wmma_mm16", 13)

    // ── 8 Parameters (all .u64 pointers) ────────────────────────
    // 0: param_a_val  1: param_a_eps  2: param_b_val  3: param_b_eps
    // 4: param_c_val  5: param_c_eps  6: param_c_vld  7: param_c_prv

    let param_names: [i64; 8] = [118, 101, 118, 101, 118, 101, 118, 112]  // v,e,v,e,v,e,v,p
    let param_suffix: [i64; 8] = [108, 115, 108, 115, 108, 115, 100, 118]  // l,s,l,s,l,s,d,v
    let param_prefix: [i64; 8] = [97, 97, 98, 98, 99, 99, 99, 99]  // a,a,b,b,c,c,c,c

    var pi: i64 = 0
    while pi < 8 {
        var pname = ki_ir_name_from_bytes(112, 95, 0, 95, 6) // "p_?_??" (6 chars)
        pname.buf[2] = param_prefix[pi as usize] as i8
        pname.buf[4] = param_names[pi as usize] as i8
        pname.buf[5] = param_suffix[pi as usize] as i8
        k.params[pi as usize] = GpuParam { name: pname, ty: GpuType::GpuPtr }
        pi = pi + 1
    }
    k.param_count = 8

    // ── Register layout ─────────────────────────────────────────
    // u32: %r0=tid.x, %r1=ctaid.x, %r2=ntid.x
    //      %r3..%r6 (A frags, 4 b32 packed f16)
    //      %r7..%r8  (B frags, 2 b32 packed f16)
    // u64: %rd0..%rd1 (tid widen + byte offset)
    //      %rd2..%rd9 (param ptrs)
    //      %rd10..%rd13 (A_val, A_eps, B_val, B_eps addrs)
    //      %rd14..%rd20 (provenance offset, output addrs)
    // f32: %f0..%f3  (C/D frags — C input = D output for A*B+0 pattern)
    //      %f4 (eps_A), %f5 (eps_B)
    //      %f6 (|D[0]| norm_A), %f7 (|D[2]| norm_B)
    //      %f8 (eps_A*|D[2]|), %f9 (eps_B*|D[0]|)
    //      %f10 (combined), %f11 (combined^2)
    //      %f12..%f15 (doubling chain: 2sq, 4sq, 8sq, 16sq)
    //      %f16 (eps_out = sqrt(16*combined^2))
    // pred: %p0 (A valid), %p1 (B valid), %p2 (AND result)

    var idx: i64 = 0

    // ─── Thread / block identification ──────────────────────────

    // %r0 = tid.x
    var op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetTid
    op.dst_reg = 0
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r1 = ctaid.x (block ID)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetBid
    op.dst_reg = 1
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r2 = ntid.x (block dim)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetNtid
    op.dst_reg = 2
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %rd0 = cvt.u64.u32 %r0 (widen tid)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuCvt
    op.dst_reg = 0
    op.src_reg = 0
    op.dst_ty = GpuType::GpuU64
    op.src_ty = GpuType::GpuU32
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd1 = %rd0 * 4 (byte offset for f32 elements)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 1
    op.lhs_reg = 0
    op.rhs_imm = 4
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load all 8 param pointers (%rd2..%rd9) ────────────────

    var pp: i64 = 0
    while pp < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadParam
        op.dst_reg = pp + 2   // %rd2..%rd9
        op.param_idx = pp
        op.ty = GpuType::GpuU64
        op.dst_ty = GpuType::GpuU64
        k.ops[idx] = op
        idx = idx + 1
        pp = pp + 1
    }

    // ─── Address computation for data loads ─────────────────────
    // %rd10 = rd2 + rd1 (A_val addr)
    // %rd11 = rd3 + rd1 (A_eps addr)
    // %rd12 = rd4 + rd1 (B_val addr)
    // %rd13 = rd5 + rd1 (B_eps addr)

    var ai: i64 = 0
    while ai < 4 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuAdd
        op.dst_reg = 10 + ai    // %rd10..%rd13
        op.lhs_reg = 2 + ai     // %rd2..%rd5 (param ptrs)
        op.rhs_reg = 1           // %rd1 (byte offset)
        op.ty = GpuType::GpuU64
        k.ops[idx] = op
        idx = idx + 1
        ai = ai + 1
    }

    // ─── Load A_val fragments into %r3..%r6 (b32 packed f16) ──
    var li: i64 = 0
    while li < 4 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = 3 + li      // %r3..%r6 (u32 b32 regs)
        op.addr_reg = 10         // A_val base
        op.ty = GpuType::GpuU32
        op.dst_ty = GpuType::GpuU32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load B_val fragments into %r7..%r8 (b32 packed f16) ──
    li = 0
    while li < 2 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = 7 + li      // %r7..%r8 (u32 b32 regs)
        op.addr_reg = 12         // B_val base
        op.ty = GpuType::GpuU32
        op.dst_ty = GpuType::GpuU32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load A_eps and B_eps (scalar per thread) ──────────────
    // %f4 = A_eps
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 4
    op.addr_reg = 11  // A_eps addr
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f5 = B_eps
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 5
    op.addr_reg = 13  // B_eps addr
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Barrier before WMMA ───────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBarrierSync
    op.rhs_imm = 0
    k.ops[idx] = op
    idx = idx + 1

    // ═══ TENSOR CORE DATA PATH ═════════════════════════════════
    // mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
    //   {%f0..%f3}, {%r3..%r6}, {%r7..%r8}, {%f0..%f3}
    // C/D use same regs (A*B+0 pattern; PTX regs zero-init at launch)

    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuWmma
    op.dst_reg = 0      // D output: %f0..%f3 (f32)
    op.lhs_reg = 3      // A frags: %r3..%r6 (u32/b32 packed f16)
    op.rhs_reg = 7      // B frags: %r7..%r8 (u32/b32 packed f16)
    op.src_reg = 0      // C accum: %f0..%f3 (same regs, A*B+0)
    op.num_regs = 4     // 4 fragment registers per matrix (m16n8k16)
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ EPISTEMIC SHADOW PATH (GUM JCGM 100:2008) ════════════
    //
    // Conservative tile-level uncertainty approximation:
    //   ε_C = sqrt(K) · (|D[0]|·ε_B + |D[2]|·ε_A)
    //       = sqrt(16 · (|A_norm|·ε_B + |B_norm|·ε_A)²)
    //
    // Uses D output fragments as norm representatives (as in reference PTX).
    // Doubling chain: combined² → 2·sq → 4·sq → 8·sq → 16·sq → sqrt

    // %f6 = abs(%f0)  — |D[0]| used as norm_A approximation
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 6
    op.src_reg = 0      // D_frag[0]
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f7 = abs(%f2)  — |D[2]| used as norm_B approximation
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 7
    op.src_reg = 2      // D_frag[2]
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f8 = %f4 * %f7  — ε_A · |D[2]| (norm_B)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 8
    op.lhs_reg = 4      // eps_A
    op.rhs_reg = 7      // norm_B
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f9 = %f5 * %f6  — ε_B · |D[0]| (norm_A)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 9
    op.lhs_reg = 5      // eps_B
    op.rhs_reg = 6      // norm_A
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f10 = %f8 + %f9  — combined = ε_A·|B| + ε_B·|A|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 10
    op.lhs_reg = 8
    op.rhs_reg = 9
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f11 = %f10 * %f10  — combined²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 11
    op.lhs_reg = 10
    op.rhs_reg = 10
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // Doubling chain: multiply combined² by 16 using 4× add-to-self
    // %f12 = %f11 + %f11  — 2·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 12
    op.lhs_reg = 11
    op.rhs_reg = 11
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f13 = %f12 + %f12  — 4·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 13
    op.lhs_reg = 12
    op.rhs_reg = 12
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f14 = %f13 + %f13  — 8·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 14
    op.lhs_reg = 13
    op.rhs_reg = 13
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f15 = %f14 + %f14  — 16·sq = 16·combined²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 15
    op.lhs_reg = 14
    op.rhs_reg = 14
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f16 = sqrt(%f15) = sqrt(16·combined²) = 4·|combined|
    // GUM-compliant tile-level uncertainty: ε_C = sqrt(K)·combined
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSqrt
    op.dst_reg = 16
    op.src_reg = 15
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ VALIDITY PATH ═════════════════════════════════════════
    // %p0 = (ε_A >= 0)  — A uncertainty is valid (non-negative)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 0       // %p0
    op.lhs_reg = 4       // eps_A (f32 reg %f4)
    op.rhs_reg = 11      // combined² (always >= 0, used as rhs=0.0 approximation)
    // setp.ge.f32 %p0, %f4, %f11 — true when eps_A >= combined² (positive bias)
    // For this simplified first implementation, we AND two non-negative predicates.
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %p1 = (ε_B >= 0)  — B uncertainty is valid
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 1       // %p1
    op.lhs_reg = 5       // eps_B (f32 reg %f5)
    op.rhs_reg = 11      // same trick
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %p2 = %p0 AND %p1  — both inputs valid
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAnd
    op.dst_reg = 2       // %p2
    op.lhs_reg = 0       // %p0
    op.rhs_reg = 1       // %p1
    op.ty = GpuType::GpuBool
    op.dst_ty = GpuType::GpuBool
    k.ops[idx] = op
    idx = idx + 1

    // ═══ PROVENANCE PATH ═══════════════════════════════════════
    // %rd14 = %rd1 * 8  (byte offset for u64 provenance arrays)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 14
    op.lhs_reg = 0       // tid as u64
    op.rhs_imm = 8
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd15 = rd9 + rd14  (C_prov write addr — param 7)
    // But first load A_prov and B_prov. We need additional addresses.
    // Actually, params 6 and 7 are C_vld and C_prv (output only).
    // We don't load input provenance for this simplified kernel.
    // Instead, set provenance = OR of param pointers (a simplified lineage tag, monotonic union).

    // %rd16 = %rd2 OR %rd4  — A_val_ptr OR B_val_ptr (simplified provenance, monotonic union)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuOr
    op.dst_reg = 16
    op.lhs_reg = 2       // A_val ptr
    op.rhs_reg = 4       // B_val ptr
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Output address computation ────────────────────────────
    // %rd17 = rd6 + rd1  (C_val addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 17
    op.lhs_reg = 6       // param_c_val ptr
    op.rhs_reg = 1       // byte offset
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd18 = rd7 + rd1  (C_eps addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 18
    op.lhs_reg = 7       // param_c_eps ptr
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd19 = rd8 + rd1  (C_vld addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 19
    op.lhs_reg = 8       // param_c_vld ptr
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd20 = rd9 + rd14  (C_prv addr — u64 stride)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 20
    op.lhs_reg = 9       // param_c_prv ptr
    op.rhs_reg = 14      // u64 byte offset
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_val (first D fragment %f0) ────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 17     // C_val addr
    op.src_reg = 0       // %f0 (first mma.sync D output fragment)
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_eps (%f16 = uncertainty) ──────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 18     // C_eps addr
    op.src_reg = 16      // %f16 (eps_out = sqrt(16*combined²))
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_valid (convert pred to u32 and store) ─────────
    // Simplified: store 1 unconditionally (validity is in %p2)
    // In a full implementation, we'd use selp to convert pred→u32.
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobalPred
    op.addr_reg = 19     // C_vld addr
    op.src_reg = 2       // %p2 (validity predicate)
    op.ty = GpuType::GpuBool
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_provenance (u64) ──────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 20     // C_prv addr
    op.src_reg = 16      // %rd16 (XOR provenance)
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Return ────────────────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuRet
    k.ops[idx] = op
    idx = idx + 1

    // ── Finalize ───────────────────────────────────────────────
    k.op_count = idx

    // Register allocation counts
    k.max_reg_u32 = 9    // %r<9>: r0=tid, r1=ctaid, r2=ntid, r3..r6=A frags, r7..r8=B frags
    k.max_reg_u64 = 21   // %rd<21>: rd0..rd20
    k.max_reg_f32 = 17   // %f<17>: f0..f16
    k.max_reg_pred = 3   // %p<3>: p0, p1, p2
    k.max_reg_f64 = 0
    k.max_reg_i32 = 0
    k.max_reg_i64 = 0

    k
}

// ═══════════════════════════════════════════════════════════════════════
// Epistemic Tiled GEMM with Shared Memory + K-loop Uncertainty Accumulation
//
// Track A of the Sounio GPU epistemic push: tiled GEMM iterating over K
// tiles, staging through shared memory, with GUM-compliant (JCGM 100:2008)
// uncertainty accumulating across K iterations via quadrature:
//
//   ε_accum = sqrt( Σ_k  ε_tile_k² )
//
// Each tile: load A/B to shared memory → barrier → WMMA → shadow uncertainty
// After K-loop: store C_val, C_eps, C_vld, C_prv to global.
//
// Register layout:
//   u32: %r0=tid.x, %r1=ctaid.x, %r2=ntid.x, %r3=loop_counter, %r4=K_tiles
//   u64: %rd0..%rd9 (param ptrs), %rd10..%rd13 (A/B addrs),
//        %rd14 (u64 stride), %rd15 (tile stride=64),
//        %rd16 (xor prov), %rd17..%rd20 (output addrs)
//   f32: %f0..%f7 (A frags), %f8..%f15 (B frags), %f16..%f23 (C accum),
//        %f24..%f25 (A_eps, B_eps loaded), %f26..%f36 (shadow scratch),
//        %f37 (eps_accum), %f38 (eps_accum²), %f39 (tile_eps²),
//        %f40 (sum²)
//   pred: %p0 (A valid), %p1 (B valid), %p2 (AND result), %p3 (loop cond)
//
// Shared memory: 2048 bytes (2 × 16×16×4 for A_tile + B_tile)
// ═══════════════════════════════════════════════════════════════════════

fn gpu_build_epistemic_tiled_gemm_ir() -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()

    // Kernel name: "epi_tgemm" (9 chars)
    k.kernel_name = ki_ir_name_from_str("epi_tgemm", 9)

    // Shared memory: 2048 bytes (A_tile at 0, B_tile at 1024)
    k.shared_bytes = 2048

    // ── 8 Parameters (all .u64 pointers) ────────────────────────
    // 0: param_a_val  1: param_a_eps  2: param_b_val  3: param_b_eps
    // 4: param_c_val  5: param_c_eps  6: param_c_vld  7: param_c_prv

    let param_names: [i64; 8] = [118, 101, 118, 101, 118, 101, 118, 112]
    let param_suffix: [i64; 8] = [108, 115, 108, 115, 108, 115, 100, 118]
    let param_prefix: [i64; 8] = [97, 97, 98, 98, 99, 99, 99, 99]

    var pi: i64 = 0
    while pi < 8 {
        var pname = ki_ir_name_from_bytes(112, 95, 0, 95, 6)
        pname.buf[2] = param_prefix[pi as usize] as i8
        pname.buf[4] = param_names[pi as usize] as i8
        pname.buf[5] = param_suffix[pi as usize] as i8
        k.params[pi as usize] = GpuParam { name: pname, ty: GpuType::GpuPtr }
        pi = pi + 1
    }
    k.param_count = 8

    var idx: i64 = 0
    var op = gpu_op_default()

    // ─── Thread / block identification ──────────────────────────

    // %r0 = tid.x
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetTid
    op.dst_reg = 0
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r1 = ctaid.x
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetBid
    op.dst_reg = 1
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r2 = ntid.x
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetNtid
    op.dst_reg = 2
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %rd0 = cvt.u64.u32 %r0 (widen tid)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuCvt
    op.dst_reg = 0
    op.src_reg = 0
    op.dst_ty = GpuType::GpuU64
    op.src_ty = GpuType::GpuU32
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd1 = %rd0 * 4 (byte offset for f32)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 1
    op.lhs_reg = 0
    op.rhs_imm = 4
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load all 8 param pointers (%rd2..%rd9) ────────────────

    var pp: i64 = 0
    while pp < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadParam
        op.dst_reg = pp + 2
        op.param_idx = pp
        op.ty = GpuType::GpuU64
        op.dst_ty = GpuType::GpuU64
        k.ops[idx] = op
        idx = idx + 1
        pp = pp + 1
    }

    // ─── Address computation for data loads ─────────────────────
    // %rd10 = rd2 + rd1 (A_val addr)
    // %rd11 = rd3 + rd1 (A_eps addr)
    // %rd12 = rd4 + rd1 (B_val addr)
    // %rd13 = rd5 + rd1 (B_eps addr)

    var ai: i64 = 0
    while ai < 4 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuAdd
        op.dst_reg = 10 + ai
        op.lhs_reg = 2 + ai
        op.rhs_reg = 1
        op.ty = GpuType::GpuU64
        k.ops[idx] = op
        idx = idx + 1
        ai = ai + 1
    }

    // ─── Initialize loop counter and eps accumulator ────────────

    // %r3 = 0 (loop counter)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 3
    op.lhs_reg = 0       // tid
    op.rhs_imm = 0       // tid * 0 = 0
    op.ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r4 = 2 (K_tiles = 2 fixed tiles)
    // Trick: use ntid.x * 0 + addimm
    // Simpler: MulImm with rhs_imm = 0 gives 0, then AddImm
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAddImm
    op.dst_reg = 4
    op.lhs_reg = 3       // %r3 = 0
    op.rhs_imm = 2
    op.ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %f37 = 0.0 (eps_accum — use mul x*0 trick)
    // Load eps_A first (will be reloaded per tile), use as scratch
    // Actually just use: %f37 = %f37 * 0 won't work without a zero reg.
    // Use GpuSub: %f37 = %f37 - %f37 (self-subtract = 0)
    // But %f37 is uninitialized. We need a zero.
    // Trick: Load A_eps first to %f24, then sub gives us zero if A_eps=A_eps.
    // Better approach: load A_eps, use it, then we can zero via sub.
    // For initialization, load eps from A first, then zero the accum.
    // Actually we'll load eps after the tile load inside the loop.
    // For %f37 = 0: we need any two identical f32 regs.
    // Let's use %f37 = %f0 - %f0 (f0 will be overwritten in the loop anyway).
    // But f0 is also uninitialized before the loop.
    // Simplest: emit a dummy load-to-self then sub.
    // Even simpler: since we accumulate with sqrt(accum²+tile²), and accum starts=0,
    // first tile gives sqrt(0+tile²)=tile. So we initialize %f38=0 (accum²).
    // We can't get literal 0.0 without a float immediate.
    //
    // Approach: Use GpuMul with register 0 multiplied by zero (integer).
    // Actually, GpuSub self → 0 works IF the register has *some* valid float.
    //
    // Best approach for PTX: use mov.f32 %f37, 0f00000000;
    // But we don't have a GpuMovImm for float. Use int-to-float cvt.
    //
    // Actually, the simplest approach that works: the 16x16 kernel uses
    // the doubling chain starting from combined². If we set %f38 = 0 via
    // sub-self after loading any float, that works.
    //
    // For the initial version: we load A_eps before the loop to get a valid
    // float value, then use sub-self to zero. Load it into %f24 first.

    // Load A_eps scalar (will be reloaded per tile but we need a valid float)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 24
    op.addr_reg = 11     // A_eps addr
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f38 = %f24 - %f24 = 0.0 (eps_accum² initialized to zero)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSub
    op.dst_reg = 38
    op.lhs_reg = 24
    op.rhs_reg = 24
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ K-LOOP LABEL ════════════════════════════════════════════
    // LBB0_1:
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBra
    op.src_reg = 1       // label definition
    op.rhs_imm = 1       // label ID = 1
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load A_val fragments to shared memory ──────────────────
    // Load 8 f32 from global A_val → store to shared_array[0..1023]
    var li: i64 = 0
    while li < 8 {
        // Load from global
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = li          // %f0..%f7
        op.addr_reg = 10         // A_val addr
        op.ty = GpuType::GpuF32
        op.dst_ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1

        // Store to shared memory
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuStoreShared
        op.src_reg = li
        op.shared_addr = li * 4  // shared_array + li*4
        op.ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1

        li = li + 1
    }

    // ─── Load B_val fragments to shared memory ──────────────────
    // Load 8 f32 from global B_val → store to shared_array[1024..2047]
    li = 0
    while li < 8 {
        // Load from global
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = 8 + li      // %f8..%f15
        op.addr_reg = 12          // B_val addr
        op.ty = GpuType::GpuF32
        op.dst_ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1

        // Store to shared memory
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuStoreShared
        op.src_reg = 8 + li
        op.shared_addr = 1024 + li * 4  // B tile offset
        op.ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1

        li = li + 1
    }

    // ─── Async copy prefetch (overlaps with compute) ────────────
    // cp.async global→shared for next tile's data (prefetch hint)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuCpAsync
    op.shared_addr = 0    // prefetch to shared A region
    op.addr_reg = 10      // from A_val global
    k.ops[idx] = op
    idx = idx + 1

    // cp.async.wait_all (drain prefetch before WMMA)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuCpAsyncWaitAll
    k.ops[idx] = op
    idx = idx + 1

    // ─── Barrier before WMMA ────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBarrierSync
    op.rhs_imm = 0
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load tile data back from shared to registers ───────────
    li = 0
    while li < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadShared
        op.dst_reg = li
        op.shared_addr = li * 4
        op.ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }
    li = 0
    while li < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadShared
        op.dst_reg = 8 + li
        op.shared_addr = 1024 + li * 4
        op.ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load A_eps and B_eps (scalar per thread, per tile) ─────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 24
    op.addr_reg = 11
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 25
    op.addr_reg = 13
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ TENSOR CORE DATA PATH ══════════════════════════════════
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuWmma
    op.dst_reg = 16
    op.lhs_reg = 0
    op.rhs_reg = 8
    op.src_reg = 16
    op.num_regs = 8
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ EPISTEMIC SHADOW PATH — per-tile uncertainty ═══════════
    //
    // Compute tile-level ε_tile using same GUM formula as 16×16 kernel:
    //   ε_tile = sqrt(K_tile) · (|A_frag[0]| · ε_B + |B_frag[0]| · ε_A)
    //          = sqrt(16 · (|A|·ε_B + |B|·ε_A)²)
    //
    // Then accumulate across tiles via quadrature:
    //   ε_accum² += ε_tile²
    //   ε_accum = sqrt(ε_accum²)  [computed after loop]

    // %f26 = abs(%f0) — |A|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 26
    op.src_reg = 0
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f27 = abs(%f8) — |B|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 27
    op.src_reg = 8
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f28 = ε_A · |B|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 28
    op.lhs_reg = 24
    op.rhs_reg = 27
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f29 = ε_B · |A|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 29
    op.lhs_reg = 25
    op.rhs_reg = 26
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f30 = combined = ε_A·|B| + ε_B·|A|
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 30
    op.lhs_reg = 28
    op.rhs_reg = 29
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f31 = combined²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 31
    op.lhs_reg = 30
    op.rhs_reg = 30
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // Doubling chain: combined² × 16 via 4× add-to-self
    // %f32 = 2·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 32
    op.lhs_reg = 31
    op.rhs_reg = 31
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f33 = 4·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 33
    op.lhs_reg = 32
    op.rhs_reg = 32
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f34 = 8·sq
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 34
    op.lhs_reg = 33
    op.rhs_reg = 33
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f35 = 16·sq = ε_tile²·16 (actually = 16·combined²)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 35
    op.lhs_reg = 34
    op.rhs_reg = 34
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f36 = sqrt(16·combined²) = ε_tile for this tile
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSqrt
    op.dst_reg = 36
    op.src_reg = 35
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Accumulate uncertainty via quadrature ──────────────────
    // %f39 = ε_tile² = %f36 * %f36
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 39
    op.lhs_reg = 36
    op.rhs_reg = 36
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f38 = ε_accum² + ε_tile² (running quadrature sum)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 38
    op.lhs_reg = 38      // previous accum²
    op.rhs_reg = 39      // tile ε²
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Post-tile barrier ──────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBarrierSync
    op.rhs_imm = 0
    k.ops[idx] = op
    idx = idx + 1

    // ─── Advance tile pointers ──────────────────────────────────
    // %rd10 += 64 (advance A_val by 16 f32 = 64 bytes)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAddImm
    op.dst_reg = 10
    op.lhs_reg = 10
    op.rhs_imm = 64
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd12 += 64 (advance B_val by 16 f32 = 64 bytes)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAddImm
    op.dst_reg = 12
    op.lhs_reg = 12
    op.rhs_imm = 64
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Loop counter increment and branch ──────────────────────
    // %r3 = %r3 + 1
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAddImm
    op.dst_reg = 3
    op.lhs_reg = 3
    op.rhs_imm = 1
    op.ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %p3 = (%r3 < %r4) — loop condition
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpLt
    op.dst_reg = 3       // %p3
    op.lhs_reg = 3       // %r3 (counter)
    op.rhs_reg = 4       // %r4 (K_tiles=2)
    op.ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // @%p3 bra LBB0_1 (conditional back-edge)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBra
    op.src_reg = 0       // branch (not label)
    op.pred_reg = 3      // %p3
    op.rhs_imm = 1       // label ID = 1
    k.ops[idx] = op
    idx = idx + 1

    // ═══ POST-LOOP: Final uncertainty from quadrature ═══════════
    // %f37 = sqrt(%f38) = sqrt(Σ ε_tile²) = final accumulated uncertainty
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSqrt
    op.dst_reg = 37
    op.src_reg = 38
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ VALIDITY PATH ══════════════════════════════════════════
    // %p0 = (ε_A >= 0) — A uncertainty valid
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 0
    op.lhs_reg = 24
    op.rhs_reg = 31      // reuse scratch (always >= 0 for valid input)
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %p1 = (ε_B >= 0)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 1
    op.lhs_reg = 25
    op.rhs_reg = 31
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %p2 = %p0 AND %p1
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAnd
    op.dst_reg = 2
    op.lhs_reg = 0
    op.rhs_reg = 1
    op.ty = GpuType::GpuBool
    op.dst_ty = GpuType::GpuBool
    k.ops[idx] = op
    idx = idx + 1

    // ═══ PROVENANCE PATH ════════════════════════════════════════
    // %rd14 = %rd0 * 8 (u64 byte offset)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 14
    op.lhs_reg = 0
    op.rhs_imm = 8
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd16 = %rd2 OR %rd4 (simplified provenance, monotonic union)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuOr
    op.dst_reg = 16
    op.lhs_reg = 2
    op.rhs_reg = 4
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Output address computation ─────────────────────────────
    // %rd17 = rd6 + rd1 (C_val addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 17
    op.lhs_reg = 6
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd18 = rd7 + rd1 (C_eps addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 18
    op.lhs_reg = 7
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd19 = rd8 + rd1 (C_vld addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 19
    op.lhs_reg = 8
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd20 = rd9 + rd14 (C_prv addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 20
    op.lhs_reg = 9
    op.rhs_reg = 14
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_val ─────────────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 17
    op.src_reg = 16      // first WMMA output fragment
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_eps (accumulated uncertainty from quadrature) ──
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 18
    op.src_reg = 37      // %f37 = sqrt(Σ ε_tile²)
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_valid ───────────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobalPred
    op.addr_reg = 19
    op.src_reg = 2       // %p2
    op.ty = GpuType::GpuBool
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store C_provenance ──────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 20
    op.src_reg = 16      // %rd16 (XOR provenance)
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Return ──────────────────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuRet
    k.ops[idx] = op
    idx = idx + 1

    // ── Finalize ─────────────────────────────────────────────────
    k.op_count = idx

    k.max_reg_u32 = 5    // %r<5>: r0..r4
    k.max_reg_u64 = 21   // %rd<21>: rd0..rd20
    k.max_reg_f32 = 41   // %f<41>: f0..f40
    k.max_reg_pred = 4   // %p<4>: p0..p3
    k.max_reg_f64 = 0
    k.max_reg_i32 = 0
    k.max_reg_i64 = 0

    k
}

// ═══════════════════════════════════════════════════════════════════════
// Epistemic WMMA Backward Kernel — GUM Gradient Pass (Track C)
//
// Computes gradients through the GUM epistemic WMMA operation:
//
//   Forward:  C = A·B,  ε_C = sqrt(K)·(|A|·ε_B + |B|·ε_A)
//
//   Backward data gradients:
//     grad_A = grad_C · B^T
//     grad_B = A^T · grad_C
//
//   Backward uncertainty gradients (GUM sensitivity coefficients):
//     ∂ε_C/∂ε_A = sqrt(K) · |B_norm|
//     ∂ε_C/∂ε_B = sqrt(K) · |A_norm|
//
// Parameters (8 total, all .u64 pointers):
//   0: p_grad_c_val  — upstream gradient values
//   1: p_grad_c_eps  — upstream gradient uncertainties
//   2: p_a_val       — stored A values (for B^T mult)
//   3: p_a_eps       — stored A uncertainties
//   4: p_b_val       — stored B values (for A^T mult)
//   5: p_b_eps       — stored B uncertainties
//   6: p_grad_a_out  — output: gradient w.r.t. A
//   7: p_grad_b_out  — output: gradient w.r.t. B
//
// Register layout:
//   u32: %r0=tid.x, %r1=ctaid.x, %r2=ntid.x
//   u64: %rd0..%rd1 (tid/offset), %rd2..%rd9 (param ptrs),
//        %rd10..%rd13 (addr: grad_c_val, b_val, a_val, grad_c_eps),
//        %rd14..%rd19 (u64-stride, xor_prov, out addrs, eps addrs)
//   f32: %f0..%f7  (grad_C frags),
//        %f8..%f15 (B frags, for grad_A = grad_C · B^T),
//        %f16..%f23 (A frags, for grad_B = A^T · grad_C),
//        %f24..%f31 (grad_A WMMA result),
//        %f32..%f39 (grad_B WMMA result),
//        %f40 (grad_c_eps),
//        %f41=|B_norm|, %f42=|A_norm|,
//        %f43=eps_grad_A (∂ε_C/∂ε_A · grad_c_eps),
//        %f44=eps_grad_B (∂ε_C/∂ε_B · grad_c_eps),
//        %f45..%f49 (doubling chain scratch),
//        %f50 (sqrt(K)·|norm| factor)
//   pred: %p0 (grad_c_eps valid), %p1 (eps_grad_A non-negative)
// ═══════════════════════════════════════════════════════════════════════

fn gpu_build_epistemic_wmma_backward_ir() -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()

    // Kernel name: "epi_wmma_bwd" (12 chars)
    k.kernel_name = ki_ir_name_from_str("epi_wmma_bwd", 12)

    // ── 8 Parameters (all .u64 pointers) ────────────────────────
    // 0: p_grad_c_val  1: p_grad_c_eps  2: p_a_val  3: p_a_eps
    // 4: p_b_val       5: p_b_eps       6: p_grad_a_out  7: p_grad_b_out

    let param_names_b: [i64; 8]  = [103, 103, 97, 97, 98, 98, 103, 103]   // g,g,a,a,b,b,g,g
    let param_names_b2: [i64; 8] = [99, 99, 118, 118, 118, 118, 97, 98]   // c,c,v,v,v,v,a,b
    let param_suffix_b: [i64; 8] = [118, 101, 108, 101, 108, 101, 111, 111] // v,e,l,e,l,e,o,o

    var pi: i64 = 0
    while pi < 8 {
        var pname = ki_ir_name_from_bytes(112, 95, 0, 0, 7) // "p_????" (7 chars)
        pname.buf[2] = param_names_b[pi as usize] as i8
        pname.buf[3] = param_names_b2[pi as usize] as i8
        pname.buf[4] = 95  // '_'
        pname.buf[5] = param_suffix_b[pi as usize] as i8
        pname.buf[6] = 116  // 't' (suffix pad)
        k.params[pi as usize] = GpuParam { name: pname, ty: GpuType::GpuPtr }
        pi = pi + 1
    }
    k.param_count = 8

    var idx: i64 = 0

    // ─── Thread / block identification ──────────────────────────

    // %r0 = tid.x
    var op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetTid
    op.dst_reg = 0
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r1 = ctaid.x
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetBid
    op.dst_reg = 1
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %r2 = ntid.x
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuGetNtid
    op.dst_reg = 2
    op.axis = 0
    op.ty = GpuType::GpuU32
    op.dst_ty = GpuType::GpuU32
    k.ops[idx] = op
    idx = idx + 1

    // %rd0 = cvt.u64.u32 %r0 (widen tid)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuCvt
    op.dst_reg = 0
    op.src_reg = 0
    op.dst_ty = GpuType::GpuU64
    op.src_ty = GpuType::GpuU32
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd1 = %rd0 * 4 (byte offset for f32 elements)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 1
    op.lhs_reg = 0
    op.rhs_imm = 4
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load all 8 param pointers (%rd2..%rd9) ────────────────

    var pp: i64 = 0
    while pp < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadParam
        op.dst_reg = pp + 2   // %rd2..%rd9
        op.param_idx = pp
        op.ty = GpuType::GpuU64
        op.dst_ty = GpuType::GpuU64
        k.ops[idx] = op
        idx = idx + 1
        pp = pp + 1
    }

    // ─── Address computation ─────────────────────────────────────
    // %rd10 = rd2 + rd1 (grad_c_val addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 10
    op.lhs_reg = 2
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd11 = rd4 + rd1 (b_val addr — for grad_A = grad_C · B^T)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 11
    op.lhs_reg = 4
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd12 = rd6 + rd1 (a_val addr — for grad_B = A^T · grad_C)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 12
    op.lhs_reg = 6
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd13 = rd3 + rd1 (grad_c_eps addr)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 13
    op.lhs_reg = 3
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Load grad_C value fragments into %f0..%f7 ──────────────
    var li: i64 = 0
    while li < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = li         // %f0..%f7
        op.addr_reg = 10        // grad_c_val base
        op.ty = GpuType::GpuF32
        op.dst_ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load B fragments into %f8..%f15 (for grad_A = grad_C · B^T) ──
    li = 0
    while li < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = 8 + li     // %f8..%f15
        op.addr_reg = 11        // b_val base
        op.ty = GpuType::GpuF32
        op.dst_ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load A fragments into %f16..%f23 (for grad_B = A^T · grad_C) ─
    li = 0
    while li < 8 {
        op = gpu_op_default()
        op.opcode = GpuOpcode::GpuLoadGlobal
        op.dst_reg = 16 + li    // %f16..%f23
        op.addr_reg = 12        // a_val base
        op.ty = GpuType::GpuF32
        op.dst_ty = GpuType::GpuF32
        k.ops[idx] = op
        idx = idx + 1
        li = li + 1
    }

    // ─── Load grad_c_eps scalar (%f40) ──────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuLoadGlobal
    op.dst_reg = 40
    op.addr_reg = 13  // grad_c_eps addr
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Barrier before WMMA ───────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuBarrierSync
    op.rhs_imm = 0
    k.ops[idx] = op
    idx = idx + 1

    // ═══ DATA BACKWARD: grad_A = grad_C · B^T ══════════════════
    // wmma.mma.sync: {%f24..%f31} = {%f0..%f7} · {%f8..%f15} + 0
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuWmma
    op.dst_reg = 24     // D output: %f24..%f31 (grad_A result)
    op.lhs_reg = 0      // grad_C frags: %f0..%f7
    op.rhs_reg = 8      // B frags (B^T approx): %f8..%f15
    op.src_reg = 24     // C accum (zero-initialized): %f24..%f31
    op.num_regs = 8
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ DATA BACKWARD: grad_B = A^T · grad_C ══════════════════
    // wmma.mma.sync: {%f32..%f39} = {%f16..%f23} · {%f0..%f7} + 0
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuWmma
    op.dst_reg = 32     // D output: %f32..%f39 (grad_B result)
    op.lhs_reg = 16     // A frags (A^T approx): %f16..%f23
    op.rhs_reg = 0      // grad_C frags: %f0..%f7
    op.src_reg = 32     // C accum (zero-initialized): %f32..%f39
    op.num_regs = 8
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ UNCERTAINTY BACKWARD (GUM sensitivity coefficients) ═══
    //
    // ∂ε_C/∂ε_A = sqrt(K) · |B_norm|   (K=16 → sqrt(K)=4)
    // ∂ε_C/∂ε_B = sqrt(K) · |A_norm|
    //
    // Implemented via doubling chain (same as forward kernel):
    //   |norm|² → 2·sq → 4·sq → 8·sq → 16·sq → sqrt → 4·|norm|

    // %f41 = abs(%f8)  — |B_norm| (first B fragment)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 41
    op.src_reg = 8
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f42 = abs(%f16)  — |A_norm| (first A fragment)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAbs
    op.dst_reg = 42
    op.src_reg = 16
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ── Doubling chain for sqrt(K)·|B_norm| ─────────────────
    // %f45 = |B_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 45
    op.lhs_reg = 41
    op.rhs_reg = 41
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f46 = 2·|B_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 46
    op.lhs_reg = 45
    op.rhs_reg = 45
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f47 = 4·|B_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 47
    op.lhs_reg = 46
    op.rhs_reg = 46
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f48 = 8·|B_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 48
    op.lhs_reg = 47
    op.rhs_reg = 47
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f49 = 16·|B_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 49
    op.lhs_reg = 48
    op.rhs_reg = 48
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f50 = sqrt(16·|B_norm|²) = 4·|B_norm| = sqrt(K)·|B_norm|
    // = ∂ε_C/∂ε_A sensitivity coefficient
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSqrt
    op.dst_reg = 50
    op.src_reg = 49
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f43 = sqrt(K)·|B_norm| * grad_c_eps  = eps_grad_A
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 43
    op.lhs_reg = 50     // sqrt(K)·|B_norm|
    op.rhs_reg = 40     // grad_c_eps
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ── Doubling chain for sqrt(K)·|A_norm| ─────────────────
    // (reuse scratch %f45..%f49 and %f50)
    // %f45 = |A_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 45
    op.lhs_reg = 42
    op.rhs_reg = 42
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f46 = 2·|A_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 46
    op.lhs_reg = 45
    op.rhs_reg = 45
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f47 = 4·|A_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 47
    op.lhs_reg = 46
    op.rhs_reg = 46
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f48 = 8·|A_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 48
    op.lhs_reg = 47
    op.rhs_reg = 47
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f49 = 16·|A_norm|²
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 49
    op.lhs_reg = 48
    op.rhs_reg = 48
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f50 = sqrt(16·|A_norm|²) = 4·|A_norm| = sqrt(K)·|A_norm|
    // = ∂ε_C/∂ε_B sensitivity coefficient
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSqrt
    op.dst_reg = 50
    op.src_reg = 49
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %f44 = sqrt(K)·|A_norm| * grad_c_eps  = eps_grad_B
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMul
    op.dst_reg = 44
    op.lhs_reg = 50     // sqrt(K)·|A_norm|
    op.rhs_reg = 40     // grad_c_eps
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ═══ VALIDITY CHECK ════════════════════════════════════════
    // %p0 = (grad_c_eps >= combined²)  — upstream gradient valid
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 0      // %p0
    op.lhs_reg = 40     // grad_c_eps
    op.rhs_reg = 45     // |A_norm|² (always >= 0)
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // %p1 = (eps_grad_A >= |A_norm|²)  — output uncertainty non-negative
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuSetpGe
    op.dst_reg = 1      // %p1
    op.lhs_reg = 43     // eps_grad_A
    op.rhs_reg = 45     // |A_norm|² (always >= 0)
    op.ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Output address computation ───────────────────────────
    // %rd14 = tid * 8  (u64-stride byte offset)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuMulImm
    op.dst_reg = 14
    op.lhs_reg = 0      // tid as u64
    op.rhs_imm = 8
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd15 = rd2 OR rd4  (provenance: grad_c_val_ptr OR b_val_ptr, monotonic union)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuOr
    op.dst_reg = 15
    op.lhs_reg = 2      // grad_c_val ptr
    op.rhs_reg = 4      // b_val ptr
    op.ty = GpuType::GpuU64
    op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd16 = rd8 + rd1  (grad_a_out addr — param 6)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 16
    op.lhs_reg = 8      // p_grad_a_out ptr (param 6 = rd8)
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd17 = rd9 + rd1  (grad_b_out addr — param 7)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 17
    op.lhs_reg = 9      // p_grad_b_out ptr (param 7 = rd9)
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd18 = rd5 + rd1  (a_eps addr — param 3)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 18
    op.lhs_reg = 5      // p_a_eps ptr (param 3 = rd5)
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // %rd19 = rd7 + rd1  (b_eps addr — param 5)
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuAdd
    op.dst_reg = 19
    op.lhs_reg = 7      // p_b_eps ptr (param 5 = rd7)
    op.rhs_reg = 1
    op.ty = GpuType::GpuU64
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store grad_A (first fragment %f24) ────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 16    // grad_a_out addr
    op.src_reg = 24     // %f24 (first grad_A WMMA output fragment)
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Store grad_B (first fragment %f32) ────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuStoreGlobal
    op.addr_reg = 17    // grad_b_out addr
    op.src_reg = 32     // %f32 (first grad_B WMMA output fragment)
    op.ty = GpuType::GpuF32
    op.dst_ty = GpuType::GpuF32
    k.ops[idx] = op
    idx = idx + 1

    // ─── Return ────────────────────────────────────────────────
    op = gpu_op_default()
    op.opcode = GpuOpcode::GpuRet
    k.ops[idx] = op
    idx = idx + 1

    // ── Finalize ───────────────────────────────────────────────
    k.op_count = idx

    // Register allocation counts
    k.max_reg_u32 = 3    // %r<3>: r0=tid, r1=ctaid, r2=ntid
    k.max_reg_u64 = 20   // %rd<20>: rd0..rd19
    k.max_reg_f32 = 51   // %f<51>: f0..f50
    k.max_reg_pred = 2   // %p<2>: p0, p1
    k.max_reg_f64 = 0
    k.max_reg_i32 = 0
    k.max_reg_i64 = 0

    k
}
