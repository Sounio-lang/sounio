// --- Phase 3: Reduction kernel helper ---
// Builds a reduction kernel IR with warp shuffle + final write
// reduction_op: GpuOpcode::GpuAdd for sum, GpuOpcode::GpuMax for max, GpuOpcode::GpuMin for min
// data_ty: type of data being reduced
// sizeof_ty: 4 for 32-bit, 8 for 64-bit
// use_atomic: true for sum (atom.add), false for max/min (st.global)
fn gpu_build_reduction_ir(
    name: Name,
    reduction_op: GpuOpcode,
    data_ty: GpuType,
    sizeof_ty: i64,
    use_atomic: bool
) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    k.kernel_name = name

    // param_in, param_out
    k.params[0] = GpuParam { name: ir_name_from_bytes(112, 97, 114, 97, 8), ty: GpuType::GpuPtr }
    k.params[0].name.buf[4] = 109; k.params[0].name.buf[5] = 95
    k.params[0].name.buf[6] = 105; k.params[0].name.buf[7] = 110
    k.params[1] = GpuParam { name: ir_name_from_bytes(112, 97, 114, 97, 9), ty: GpuType::GpuPtr }
    k.params[1].name.buf[4] = 109; k.params[1].name.buf[5] = 95
    k.params[1].name.buf[6] = 111; k.params[1].name.buf[7] = 117; k.params[1].name.buf[8] = 116
    k.param_count = 2

    var idx: i64 = 0
    let default_op = GpuOp { opcode: GpuOpcode::GpuRet, dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1, ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32 }

    // 1. r1 = tid.x
    var op = default_op
    op.opcode = GpuOpcode::GpuGetTid; op.dst_reg = 1; op.axis = 0
    op.ty = GpuType::GpuU32; op.dst_ty = GpuType::GpuU32; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // 2. rd1 = cvt.u64.u32 r1
    op = default_op
    op.opcode = GpuOpcode::GpuCvt; op.dst_reg = 1; op.src_reg = 1
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64; op.src_ty = GpuType::GpuU32
    k.ops[idx] = op; idx = idx + 1

    // 3. rd2 = rd1 * sizeof
    op = default_op
    op.opcode = GpuOpcode::GpuMulImm; op.dst_reg = 2; op.lhs_reg = 1; op.rhs_imm = sizeof_ty
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 4. rd3 = ld.param [param_in]
    op = default_op
    op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 3; op.param_idx = 0
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 5. rd4 = rd3 + rd2
    op = default_op
    op.opcode = GpuOpcode::GpuAdd; op.dst_reg = 4; op.lhs_reg = 3; op.rhs_reg = 2
    op.ty = GpuType::GpuU64; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 6. data1 = ld.global [rd4]
    op = default_op
    op.opcode = GpuOpcode::GpuLoadGlobal; op.dst_reg = 1; op.addr_reg = 4
    op.ty = data_ty; op.dst_ty = data_ty
    k.ops[idx] = op; idx = idx + 1

    // 7-16. Warp reduction: shuffle down + reduce (offsets 16, 8, 4, 2, 1)
    var offset: i64 = 16
    while offset >= 1 {
        // data2 = shfl.down data1, offset
        op = default_op
        op.opcode = GpuOpcode::GpuShflDown; op.dst_reg = 2; op.src_reg = 1; op.rhs_imm = offset
        op.ty = data_ty; op.dst_ty = data_ty; op.src_ty = data_ty
        k.ops[idx] = op; idx = idx + 1

        // data1 = reduction_op(data1, data2)
        op = default_op
        op.opcode = reduction_op; op.dst_reg = 1; op.lhs_reg = 1; op.rhs_reg = 2
        op.ty = data_ty; op.dst_ty = data_ty
        k.ops[idx] = op; idx = idx + 1

        offset = offset / 2
    }

    // 17. rd5 = ld.param [param_out]
    op = default_op
    op.opcode = GpuOpcode::GpuLoadParam; op.dst_reg = 5; op.param_idx = 1
    op.ty = GpuType::GpuPtr; op.dst_ty = GpuType::GpuU64
    k.ops[idx] = op; idx = idx + 1

    // 18. Write result: atomic add or global store
    if use_atomic {
        op = default_op
        op.opcode = GpuOpcode::GpuAtomicAdd; op.dst_reg = 3; op.addr_reg = 5; op.src_reg = 1
        op.ty = data_ty; op.dst_ty = data_ty; op.src_ty = data_ty
        k.ops[idx] = op; idx = idx + 1
    } else {
        op = default_op
        op.opcode = GpuOpcode::GpuStoreGlobal; op.addr_reg = 5; op.src_reg = 1
        op.ty = data_ty; op.dst_ty = data_ty; op.src_ty = data_ty
        k.ops[idx] = op; idx = idx + 1
    }

    // 19. ret
    k.ops[idx] = default_op; idx = idx + 1

    k.op_count = idx
    k.max_reg_u32 = 2
    k.max_reg_u64 = 6
    k.max_reg_pred = 1
    // Set type-specific register counts
    if data_ty == GpuType::GpuF32 { k.max_reg_f32 = 4 }
    if data_ty == GpuType::GpuF64 { k.max_reg_f64 = 4 }
    if data_ty == GpuType::GpuI32 { k.max_reg_i32 = 4 }
    if data_ty == GpuType::GpuI64 { k.max_reg_i64 = 4 }
    k
}

// --- Phase 3: 8 Reduction kernel builders ---

fn gpu_build_vec_sum_f32_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_reduction_ir(gpu_name_vec_sum(), GpuOpcode::GpuAdd, GpuType::GpuF32, 4, true)
}

