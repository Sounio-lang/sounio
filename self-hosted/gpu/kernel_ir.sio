fn gpu_name_vec_add_f64() -> Name with Mut, Panic, Div {
    // "vec_add_f64" (11 chars)
    var n = ir_name_from_bytes(118, 101, 99, 95, 11)  // "vec_"
    n.buf[4] = 97    // 'a'
    n.buf[5] = 100   // 'd'
    n.buf[6] = 100   // 'd'
    n.buf[7] = 95    // '_'
    n.buf[8] = 102   // 'f'
    n.buf[9] = 54    // '6'
    n.buf[10] = 52   // '4'
    n
}

