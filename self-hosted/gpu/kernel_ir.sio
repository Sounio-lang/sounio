fn gpu_build_vec_add_f64_ir() -> GpuKernelIr with Mut, Panic, Div {
    gpu_build_vec_binop_ir(gpu_name_vec_add_f64(), GpuOpcode::GpuAdd, GpuType::GpuF64)
}

