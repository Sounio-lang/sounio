        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.op_count = idx

    // Register usage tracking
    k.max_reg_u32 = 3   // %r<3>: r0 unused, r1, r2 unused
    k.max_reg_u64 = 9   // %rd<9>: rd0 unused, rd1-rd8
    k.max_reg_f32 = 4   // %f<4>: f0 unused, f1, f2, f3
    k.max_reg_pred = 2  // %p<2>: not used yet, but keep for compatibility

    k
}

// ===== Generic vec binop builder =====
//
// Parameterized kernel builder for all vec_{add,sub,mul,div} × {f32,f64,i32,i64}
// combinations. Avoids duplicating ~300 lines per kernel variant.
//
// Register allocation strategy:
//   - f32 elements: %f1, %f2, %f3 (separate register file)
//   - f64 elements: %fd1, %fd2, %fd3 (separate register file)
//   - i32 elements: %r2, %r3, %r4 (share with tid %r1, start at 2)
//   - i64 elements: %rd1, %rd2, %rd3 (reuse dead address-calc regs)

fn gpu_build_vec_binop_ir(
    kernel_name: Name,
    binop: GpuOpcode,
    elem_ty: GpuType,
) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)

    k.kernel_name = kernel_name

    // Parameters: .param .u64 param_a, param_b, param_c (same for all vec binops)
    var qp0 = GpuParam { name: ki_ir_name_from_str("param_a", 7), ty: GpuType::GpuPtr }
    k.params[0] = qp0
    var qp1 = GpuParam { name: ki_ir_name_from_str("param_b", 7), ty: GpuType::GpuPtr }
    k.params[1] = qp1
    var qp2 = GpuParam { name: ki_ir_name_from_str("param_c", 7), ty: GpuType::GpuPtr }
    k.params[2] = qp2

    k.param_count = 3

    // Element register numbers depend on type
    // i32 shares %r with tid (%r1), so starts at 2; others use separate file or reuse dead regs
    let elem_reg_a = if elem_ty == GpuType::GpuI32 { 2 } else { 1 }
    let elem_reg_b = if elem_ty == GpuType::GpuI32 { 3 } else { 2 }
    let elem_reg_c = if elem_ty == GpuType::GpuI32 { 4 } else { 3 }

    var idx: i64 = 0

    // r1 = tid.x
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuGetTid,
        dst_reg: 1, axis: 0,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, shared_addr: -1,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuCvt,
        dst_reg: 1, src_reg: 1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd2 = rd1 * elem_sizeof
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuMulImm,
        dst_reg: 2, lhs_reg: 1, rhs_imm: elem_sizeof,
        ty: GpuType::GpuU64,
        src_reg: -1, rhs_reg: -1, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd3 = param_a
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 3, param_idx: 0,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd4 = param_b
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 4, param_idx: 1,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd5 = param_c
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 5, param_idx: 2,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd6 = rd3 + rd2  (addr_a)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 6, lhs_reg: 3, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd7 = rd4 + rd2  (addr_b)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 7, lhs_reg: 4, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // rd8 = rd5 + rd2  (addr_c)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 8, lhs_reg: 5, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // elem_a = ld.global.ty [rd6]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: elem_reg_a, addr_reg: 6,
        ty: elem_ty,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // elem_b = ld.global.ty [rd7]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: elem_reg_b, addr_reg: 7,
        ty: elem_ty,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // elem_c = elem_a binop elem_b
    k.ops[idx] = GpuOp {
        opcode: binop,
        dst_reg: elem_reg_c, lhs_reg: elem_reg_a, rhs_reg: elem_reg_b,
        ty: elem_ty,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // st.global.ty [rd8], elem_c
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuStoreGlobal,
        addr_reg: 8, src_reg: elem_reg_c,
        ty: elem_ty,
        dst_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    // ret
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,
        atomic_op: GpuAtomicOp::GpuAtomAdd,
        cache_hint: GpuCacheHint::GpuCacheDefault,
        compare_reg: -1,
        num_regs: 0,
        byte_offset: 0,
        scope: 0,
        cg_size: 0,
    }
    idx = idx + 1

    k.op_count = idx

    // Register tracking
    // i32 uses %r shared with tid, so needs more u32 regs
    let max_reg_u32 = if elem_ty == GpuType::GpuI32 { 5 } else { 3 }
    k.max_reg_u32 = max_reg_u32
    k.max_reg_u64 = 9
    let max_reg_f32 = if elem_ty == GpuType::GpuF32 { 4 } else { 0 }
    let max_reg_f64 = if elem_ty == GpuType::GpuF64 { 4 } else { 0 }
    k.max_reg_f32 = max_reg_f32
    k.max_reg_f64 = max_reg_f64
    k.max_reg_pred = 2

    k
}

// ===== Name builders for kernel variants =====

fn gpu_name_vec_add_f64() -> Name with Mut, Panic, Div {
    // "vec_add_f64" (11 chars)
    var n = ki_ir_name_from_bytes(118, 101, 99, 95, 11)  // "vec_"
    n.buf[4] = 97    // 'a'
    n.buf[5] = 100   // 'd'
    n.buf[6] = 100   // 'd'
    n.buf[7] = 95    // '_'
    n.buf[8] = 102   // 'f'
    n.buf[9] = 54    // '6'
    n.buf[10] = 52   // '4'
    n
}

