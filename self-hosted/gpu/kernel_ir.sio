// self-hosted::gpu::kernel_ir — Minimal GPU Kernel IR
//
// A tiny, GPU-focused IR for representing CUDA/PTX kernels.
// This is NOT the general-purpose IrModule - it's specifically designed
// for GPU kernel patterns (thread IDs, global memory, vector ops).
//
// Design philosophy:
// - Keep it minimal (only what vec_add needs, then expand)
// - Direct mapping to PTX instructions
// - No SSA/phi nodes (GPU kernels are simple)
// - Fixed register allocation for now
// - Struct-based representation (no enum field destructuring - not supported by self-hosted)

// GPU data types (full type coverage for all kernels)
enum GpuType {
    GpuU32,
    GpuU64,
    GpuF32,
    GpuF64,
    GpuI32,
    GpuI64,
    GpuPtr,  // .u64 pointer type
}

// GPU operation opcodes (simple enum, no fields)
enum GpuOpcode {
    GpuGetTid,       // Get thread ID
    GpuCvt,          // Type conversion
    GpuMulImm,       // Multiply with immediate
    GpuAdd,          // Add
    GpuSub,          // Subtract
    GpuMul,          // Multiply
    GpuDiv,          // Divide
    GpuMax,          // Maximum
    GpuMin,          // Minimum
    GpuBarrierSync,  // Barrier synchronization
    GpuShflDown,     // Warp shuffle down
    GpuAtomicAdd,    // Atomic add
    GpuLoadShared,   // Load from shared memory
    GpuStoreShared,  // Store to shared memory
    GpuLoadParam,    // Load from kernel parameter
    GpuLoadGlobal,   // Load from global memory
    GpuStoreGlobal,  // Store to global memory
    GpuRet,          // Return
    GpuFma,          // Phase 4: fused multiply-add (dst = lhs * rhs + src)
    GpuGetBid,       // Phase 4: block index (blockIdx.x/y/z)
    GpuGetNtid,      // Phase 4: block dimension (blockDim.x/y/z)
    GpuAddImm,       // Phase 4: add immediate (for loop offsets)
    GpuSetpLt,       // Predicate compare less-than: setp.lt
    GpuSetpLe,       // Predicate compare less-equal: setp.le
    GpuSetpEq,       // Predicate compare equal: setp.eq
    GpuSetpGe,       // Predicate compare greater-or-equal: setp.ge
    GpuSelp,         // Predicate select: selp
    GpuLoadGlobalPred, // Predicate load from global memory
    GpuStoreGlobalPred, // Predicate store into global memory
    GpuLoadSharedPred,  // Predicate load from shared memory
    GpuStoreSharedPred, // Predicate store into shared memory

    // Phase 5: Warp operations
    GpuShflUp,          // Warp shuffle up
    GpuShflBfly,        // Warp shuffle butterfly (XOR)
    GpuShflIdx,         // Warp shuffle by index
    GpuVote,            // Warp vote (all/any/ballot)
    GpuBallot,          // Warp ballot

    // Phase 5: Tensor core
    GpuWmma,            // Warp matrix multiply-accumulate
    GpuMma,             // Matrix multiply-accumulate
    GpuTmaLoad,         // Tensor memory access load (sm_90+)
    GpuTmaStore,        // Tensor memory access store (sm_90+)

    // Phase 5: Memory (extended)
    GpuLdGlobalCached,  // Cached global load
    GpuStGlobalWriteback, // Writeback global store
    GpuPrefetch,        // Prefetch to cache

    // Phase 5: Math intrinsics
    GpuSqrt,            // Square root
    GpuRsqrt,           // Reciprocal square root
    GpuExp2,            // Base-2 exponential
    GpuLg2,             // Base-2 logarithm
    GpuSin,             // Sine
    GpuCos,             // Cosine
    GpuAbs,             // Absolute value
    GpuRcp,             // Reciprocal

    // Phase 5: Predicate (extended)
    GpuSetpGt,          // Greater-than comparison
    GpuSetpNe,          // Not-equal comparison

    // Phase 5: Control flow
    GpuBra,             // Branch (conditional/unconditional)
    GpuExit,            // Thread exit

    // Phase 5: Special registers
    GpuGetLaneId,       // Lane ID within warp
    GpuGetWarpId,       // Warp ID within block
    GpuGetSmId,         // Streaming multiprocessor ID
    GpuGetGridDim,      // Grid dimension
}

// GPU memory space (for load/store address space qualification)
enum GpuMemorySpace {
    GpuMemGlobal,
    GpuMemShared,
    GpuMemLocal,
    GpuMemConstant,
}

enum GpuError {
    GpuOk,
    GpuOpBufferOverflow,
}

// Return value used by checked op append APIs.
struct GpuAppendResult {
    kernel: GpuKernelIr,
    error: GpuError,
}

// GPU operation (struct with all possible fields, like IrInstr)
struct GpuOp {
    opcode: GpuOpcode,
    dst_reg: i64,
    src_reg: i64,
    lhs_reg: i64,
    rhs_reg: i64,
    addr_reg: i64,
    rhs_imm: i64,
    param_idx: i64,
    axis: i64,  // 0=x, 1=y, 2=z for GetTid
    shared_addr: i64,  // Shared memory address/offset
    ty: GpuType,
    dst_ty: GpuType,
    src_ty: GpuType,
    // Phase 5 extensions
    memory_space: GpuMemorySpace,   // Address space for load/store ops
    pred_reg: i64,                  // Predicate register for conditional ops (-1 = none)
    mask: i64,                      // Warp mask for shuffle/vote ops (0xFFFFFFFF = all lanes)
}

// GPU kernel parameter (e.g., .param .u64 param_a)
struct GpuParam {
    name: Name,
    ty: GpuType,
}

// GPU kernel IR (represents a single kernel)
struct GpuKernelIr {
    kernel_name: Name,
    params: [GpuParam; 8],
    param_count: i64,
    // Stage-5 hardening target: allow up to 1024 IR ops per kernel
    // (large enough for the shared-memory/tiled-family kernels in this phase).
    ops: [GpuOp; 1024],
    op_count: i64,

    // Shared-memory region size (in bytes) used by this kernel.
    // 0 means no dynamic shared declaration.
    shared_bytes: i64,

    // Register allocation info (simple for now)
    max_reg_u32: i64,
    max_reg_u64: i64,
    max_reg_f32: i64,
    max_reg_f64: i64,
    max_reg_i32: i64,
    max_reg_i64: i64,
    max_reg_pred: i64,
    // Phase 5 extensions
    shared_mem_bytes: i64,  // Total shared memory allocated (bytes)
    max_threads: i64,       // Maximum threads per block hint (0 = default)
}

// Lowered module: collection of kernels post-HLIR-to-GPU lowering, pre-optimization.
struct HlirGpuLoweredModule {
    kernels: [GpuKernelIr; 64],
    kernel_count: i64,
}

fn hlir_gpu_lowered_module_new() -> HlirGpuLoweredModule {
    HlirGpuLoweredModule {
        kernels: [gpu_kernel_new(); 64],
        kernel_count: 0,
    }
}

// Constructors and helpers

fn gpu_kernel_new() -> GpuKernelIr {
    GpuKernelIr {
        kernel_name: ir_empty_name(),
        params: [gpu_param_new(); 8],
        param_count: 0,
        ops: [gpu_op_new(); 1024],
        op_count: 0,
        shared_bytes: 0,
        max_reg_u32: 0,
        max_reg_u64: 0,
        max_reg_f32: 0,
        max_reg_f64: 0,
        max_reg_i32: 0,
        max_reg_i64: 0,
        max_reg_pred: 0,
        shared_mem_bytes: 0,
        max_threads: 0,
    }
}

fn gpu_kernel_max_ops() -> i64 {
    1024
}

fn gpu_append_op_checked(kernel: GpuKernelIr, op: GpuOp) -> GpuAppendResult with Mut, Panic, Div {
    if kernel.op_count >= gpu_kernel_max_ops() {
        GpuAppendResult { kernel: kernel, error: GpuError::GpuOpBufferOverflow }
    } else {
        var out = kernel
        out.ops[kernel.op_count as usize] = op
        out.op_count = out.op_count + 1
        GpuAppendResult { kernel: out, error: GpuError::GpuOk }
    }
}

fn gpu_add_op_checked(kernel: GpuKernelIr, op: GpuOp) -> GpuAppendResult with Mut, Panic, Div {
    gpu_append_op_checked(kernel, op)
}

fn gpu_append_op(kernel: GpuKernelIr, op: GpuOp) -> GpuKernelIr with Mut, Panic, Div {
    let out = gpu_append_op_checked(kernel, op)
    out.kernel
}

fn gpu_add_op(kernel: GpuKernelIr, op: GpuOp) -> GpuKernelIr with Mut, Panic, Div {
    let out = gpu_add_op_checked(kernel, op)
    out.kernel
}

fn gpu_param_new() -> GpuParam {
    GpuParam {
        name: ir_empty_name(),
        ty: GpuType::GpuU64,
    }
}

fn gpu_op_new() -> GpuOp {
    GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
        memory_space: GpuMemorySpace::GpuMemGlobal,
        pred_reg: -1,
        mask: 4294967295,  // 0xFFFFFFFF — all lanes
    }
}

fn gpu_type_to_string(ty: GpuType) -> string {
    match ty {
        GpuType::GpuU32 => "u32",
        GpuType::GpuU64 => "u64",
        GpuType::GpuF32 => "f32",
        GpuType::GpuF64 => "f64",
        GpuType::GpuI32 => "s32",
        GpuType::GpuI64 => "s64",
        GpuType::GpuPtr => "u64",
    }
}

fn gpu_type_sizeof(ty: GpuType) -> i64 {
    match ty {
        GpuType::GpuU32 => 4,
        GpuType::GpuU64 => 8,
        GpuType::GpuF32 => 4,
        GpuType::GpuF64 => 8,
        GpuType::GpuI32 => 4,
        GpuType::GpuI64 => 8,
        GpuType::GpuPtr => 8,
    }
}

// Build a vec_add kernel IR (canonical example, kept for backward compat with T10)
fn gpu_build_vec_add_ir() -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()

    // Kernel name: "vec_add"
    k.kernel_name = ir_name_from_bytes(118, 101, 99, 95, 7)  // "vec_add" (7 chars)
    k.kernel_name.buf[4] = 97   // 'a'
    k.kernel_name.buf[5] = 100  // 'd'
    k.kernel_name.buf[6] = 100  // 'd'

    // Parameters: .param .u64 param_a, param_b, param_c
    k.params[0] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_a"
        ty: GpuType::GpuPtr,
    }
    k.params[0].name.buf[4] = 109  // 'm'
    k.params[0].name.buf[5] = 95   // '_'
    k.params[0].name.buf[6] = 97   // 'a'

    k.params[1] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_b"
        ty: GpuType::GpuPtr,
    }
    k.params[1].name.buf[4] = 109  // 'm'
    k.params[1].name.buf[5] = 95   // '_'
    k.params[1].name.buf[6] = 98   // 'b'

    k.params[2] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_c"
        ty: GpuType::GpuPtr,
    }
    k.params[2].name.buf[4] = 109  // 'm'
    k.params[2].name.buf[5] = 95   // '_'
    k.params[2].name.buf[6] = 99   // 'c'

    k.param_count = 3

    // Operations (following PTX register allocation from reference)
    var idx: i64 = 0

    // r1 = tid.x
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuGetTid,
        dst_reg: 1,
        axis: 0,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        shared_addr: -1,
        ty: GpuType::GpuU32,
        dst_ty: GpuType::GpuU32,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuCvt,
        dst_reg: 1,
        src_reg: 1,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
    }
    idx = idx + 1

    // rd2 = rd1 * 4 (sizeof f32)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuMulImm,
        dst_reg: 2,
        lhs_reg: 1,
        rhs_imm: 4,
        ty: GpuType::GpuU64,
        src_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd3 = param_a
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 3,
        param_idx: 0,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd4 = param_b
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 4,
        param_idx: 1,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd5 = param_c
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 5,
        param_idx: 2,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd6 = rd3 + rd2
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 6,
        lhs_reg: 3,
        rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd7 = rd4 + rd2
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 7,
        lhs_reg: 4,
        rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd8 = rd5 + rd2
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 8,
        lhs_reg: 5,
        rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // f1 = global[rd6]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: 1,
        addr_reg: 6,
        ty: GpuType::GpuF32,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuF32,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // f2 = global[rd7]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: 2,
        addr_reg: 7,
        ty: GpuType::GpuF32,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuF32,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // f3 = f1 + f2
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 3,
        lhs_reg: 1,
        rhs_reg: 2,
        ty: GpuType::GpuF32,
        src_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuF32,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // global[rd8] = f3
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuStoreGlobal,
        addr_reg: 8,
        src_reg: 3,
        ty: GpuType::GpuF32,
        dst_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        dst_ty: GpuType::GpuF32,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // ret
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1,
        src_reg: -1,
        lhs_reg: -1,
        rhs_reg: -1,
        addr_reg: -1,
        rhs_imm: 0,
        param_idx: -1,
        axis: 0,
        shared_addr: -1,
        ty: GpuType::GpuU64,
        dst_ty: GpuType::GpuU64,
        src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    k.op_count = idx

    // Register usage tracking
    k.max_reg_u32 = 3   // %r<3>: r0 unused, r1, r2 unused
    k.max_reg_u64 = 9   // %rd<9>: rd0 unused, rd1-rd8
    k.max_reg_f32 = 4   // %f<4>: f0 unused, f1, f2, f3
    k.max_reg_pred = 2  // %p<2>: not used yet, but keep for compatibility

    k
}

// ===== Generic vec binop builder =====
//
// Parameterized kernel builder for all vec_{add,sub,mul,div} × {f32,f64,i32,i64}
// combinations. Avoids duplicating ~300 lines per kernel variant.
//
// Register allocation strategy:
//   - f32 elements: %f1, %f2, %f3 (separate register file)
//   - f64 elements: %fd1, %fd2, %fd3 (separate register file)
//   - i32 elements: %r2, %r3, %r4 (share with tid %r1, start at 2)
//   - i64 elements: %rd1, %rd2, %rd3 (reuse dead address-calc regs)

fn gpu_build_vec_binop_ir(
    kernel_name: Name,
    binop: GpuOpcode,
    elem_ty: GpuType,
) -> GpuKernelIr with Mut, Panic, Div {
    var k = gpu_kernel_new()
    let elem_sizeof = gpu_type_sizeof(elem_ty)

    k.kernel_name = kernel_name

    // Parameters: .param .u64 param_a, param_b, param_c (same for all vec binops)
    k.params[0] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_a"
        ty: GpuType::GpuPtr,
    }
    k.params[0].name.buf[4] = 109  // 'm'
    k.params[0].name.buf[5] = 95   // '_'
    k.params[0].name.buf[6] = 97   // 'a'

    k.params[1] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_b"
        ty: GpuType::GpuPtr,
    }
    k.params[1].name.buf[4] = 109  // 'm'
    k.params[1].name.buf[5] = 95   // '_'
    k.params[1].name.buf[6] = 98   // 'b'

    k.params[2] = GpuParam {
        name: ir_name_from_bytes(112, 97, 114, 97, 7),  // "param_c"
        ty: GpuType::GpuPtr,
    }
    k.params[2].name.buf[4] = 109  // 'm'
    k.params[2].name.buf[5] = 95   // '_'
    k.params[2].name.buf[6] = 99   // 'c'

    k.param_count = 3

    // Element register numbers depend on type
    // i32 shares %r with tid (%r1), so starts at 2; others use separate file or reuse dead regs
    let elem_reg_a = if elem_ty == GpuType::GpuI32 { 2 } else { 1 }
    let elem_reg_b = if elem_ty == GpuType::GpuI32 { 3 } else { 2 }
    let elem_reg_c = if elem_ty == GpuType::GpuI32 { 4 } else { 3 }

    var idx: i64 = 0

    // r1 = tid.x
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuGetTid,
        dst_reg: 1, axis: 0,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, shared_addr: -1,
        ty: GpuType::GpuU32, dst_ty: GpuType::GpuU32, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd1 = cvt.u64.u32 r1
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuCvt,
        dst_reg: 1, src_reg: 1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
        lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64,
    }
    idx = idx + 1

    // rd2 = rd1 * elem_sizeof
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuMulImm,
        dst_reg: 2, lhs_reg: 1, rhs_imm: elem_sizeof,
        ty: GpuType::GpuU64,
        src_reg: -1, rhs_reg: -1, addr_reg: -1,
        param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd3 = param_a
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 3, param_idx: 0,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd4 = param_b
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 4, param_idx: 1,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd5 = param_c
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadParam,
        dst_reg: 5, param_idx: 2,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd6 = rd3 + rd2  (addr_a)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 6, lhs_reg: 3, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd7 = rd4 + rd2  (addr_b)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 7, lhs_reg: 4, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // rd8 = rd5 + rd2  (addr_c)
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuAdd,
        dst_reg: 8, lhs_reg: 5, rhs_reg: 2,
        ty: GpuType::GpuU64,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // elem_a = ld.global.ty [rd6]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: elem_reg_a, addr_reg: 6,
        ty: elem_ty,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // elem_b = ld.global.ty [rd7]
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuLoadGlobal,
        dst_reg: elem_reg_b, addr_reg: 7,
        ty: elem_ty,
        src_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // elem_c = elem_a binop elem_b
    k.ops[idx] = GpuOp {
        opcode: binop,
        dst_reg: elem_reg_c, lhs_reg: elem_reg_a, rhs_reg: elem_reg_b,
        ty: elem_ty,
        src_reg: -1, addr_reg: -1, rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // st.global.ty [rd8], elem_c
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuStoreGlobal,
        addr_reg: 8, src_reg: elem_reg_c,
        ty: elem_ty,
        dst_reg: -1, lhs_reg: -1, rhs_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        dst_ty: elem_ty, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    // ret
    k.ops[idx] = GpuOp {
        opcode: GpuOpcode::GpuRet,
        dst_reg: -1, src_reg: -1, lhs_reg: -1, rhs_reg: -1, addr_reg: -1,
        rhs_imm: 0, param_idx: -1, axis: 0, shared_addr: -1,
        ty: GpuType::GpuU64, dst_ty: GpuType::GpuU64, src_ty: GpuType::GpuU32,
    }
    idx = idx + 1

    k.op_count = idx

    // Register tracking
    // i32 uses %r shared with tid, so needs more u32 regs
    k.max_reg_u32 = if elem_ty == GpuType::GpuI32 { 5 } else { 3 }
    k.max_reg_u64 = 9
    k.max_reg_f32 = if elem_ty == GpuType::GpuF32 { 4 } else { 0 }
    k.max_reg_f64 = if elem_ty == GpuType::GpuF64 { 4 } else { 0 }
    k.max_reg_pred = 2

    k
}

