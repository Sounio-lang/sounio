// self-hosted/gpu/epistemic_autodiff.sio
//
// Jacobian-Guided GUM: forward-mode automatic differentiation for exact
// sensitivity coefficients, combined with full GUM uncertainty propagation
// (JCGM 100:2008 section 5.1.2).
//
// Replaces hardcoded first-order uncertainty rules (e.g. Mul: |a|*e_b + |b|*e_a)
// with exact AD-computed Jacobians:
//
//   u^2(y) = sum_i (df/dx_i)^2 * u^2(x_i)
//            + 2 * sum_i sum_{j>i} (df/dx_i)(df/dx_j) * u(x_i, x_j)
//
// Key insight: dual-number chain rule gives exact partial derivatives through
// the computation graph. Each JacobianEntry tracks partials wrt up to 16 inputs.
//
// Architecture:
//   Section 1: Extern math + helpers
//   Section 2: JacobianEntry — per-value derivative tracking
//   Section 3: JacobianGumState — full state
//   Section 4: State management (new, mark_input, find_entry, get_entry)
//   Section 5: Chain rule emitters (add, sub, mul, div)
//   Section 6: Transcendental emitters (exp, log, sqrt, sin, cos, neg)
//   Section 7: GUM combine — final uncertainty from Jacobian + input uncertainties
//   Section 8: High-level dispatch (jad_propagate_op)
//   Section 9: Self-tests (fn main)

// ============================================================================
// Section 1: Extern math + helpers
// ============================================================================

extern "C" {
    fn sqrt(x: f64) -> f64
    fn exp(x: f64) -> f64
    fn log(x: f64) -> f64
    fn sin(x: f64) -> f64
    fn cos(x: f64) -> f64
    fn fabs(x: f64) -> f64
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    x
}

// Maximum number of tracked inputs for partial derivatives
let JAD_MAX_INPUTS: i64 = 16

// Maximum number of tracked intermediate values
let JAD_MAX_ENTRIES: i64 = 512

// Backing storage is kept in module globals instead of embedding large arrays
// directly in JacobianGumState. That keeps the runtime state tiny and avoids
// large by-value stack traffic in the self-hosted compiler path.
var JAD_ENTRY_VALUE_IDS: [i64; 512] = [-1; 512]
var JAD_ENTRY_VALUES: [f64; 512] = [0.0; 512]
var JAD_ENTRY_PARTIALS: [f64; 8192] = [0.0; 8192]
var JAD_ENTRY_PARTIAL_COUNTS: [i64; 512] = [0; 512]
var JAD_ENTRY_IS_INPUTS: [bool; 512] = [false; 512]
var JAD_ENTRY_INPUT_IDXS: [i64; 512] = [-1; 512]
var JAD_INPUT_UNCERTAINTIES: [f64; 16] = [0.0; 16]
var JAD_COVARIANCE: [f64; 256] = [0.0; 256]
var JAD_ENTRY_COUNT: i64 = 0
var JAD_INPUT_COUNT: i64 = 0
var JAD_INCLUDE_COVARIANCE: bool = false

// ============================================================================
// Section 2: JacobianEntry — per-value derivative tracking
// ============================================================================

// Derivative tracking for one intermediate value in the computation graph.
// partials[i] = d(this_value) / d(input_i) via the chain rule.
struct JacobianEntry {
    value_id: i64,
    value: f64,
    partials: [f64; 16],
    partial_count: i64,
    is_input: bool,
    input_idx: i64,
}

fn jad_entry_new() -> JacobianEntry {
    JacobianEntry {
        value_id: -1,
        value: 0.0,
        partials: [0.0; 16],
        partial_count: 0,
        is_input: false,
        input_idx: -1,
    }
}

// ============================================================================
// Section 3: JacobianGumState — full state
// ============================================================================

// Full Jacobian-Guided GUM state. Tracks all intermediate values, their
// partial derivatives wrt each input, input uncertainties, and the optional
// covariance matrix for correlated inputs.
struct JacobianGumState {
    token: i64,
}

// ============================================================================
// Section 4: State management
// ============================================================================

fn jad_state_new() -> JacobianGumState with Mut {
    var i: i64 = 0
    while i < JAD_MAX_ENTRIES {
        JAD_ENTRY_VALUE_IDS[i as usize] = -1
        JAD_ENTRY_VALUES[i as usize] = 0.0
        JAD_ENTRY_PARTIAL_COUNTS[i as usize] = 0
        JAD_ENTRY_IS_INPUTS[i as usize] = false
        JAD_ENTRY_INPUT_IDXS[i as usize] = -1
        i = i + 1
    }

    var p: i64 = 0
    while p < (JAD_MAX_ENTRIES * JAD_MAX_INPUTS) {
        JAD_ENTRY_PARTIALS[p as usize] = 0.0
        p = p + 1
    }

    var u: i64 = 0
    while u < JAD_MAX_INPUTS {
        JAD_INPUT_UNCERTAINTIES[u as usize] = 0.0
        u = u + 1
    }

    var c: i64 = 0
    while c < (JAD_MAX_INPUTS * JAD_MAX_INPUTS) {
        JAD_COVARIANCE[c as usize] = 0.0
        c = c + 1
    }
    JAD_ENTRY_COUNT = 0
    JAD_INPUT_COUNT = 0
    JAD_INCLUDE_COVARIANCE = false

    JacobianGumState {
        token: 0,
    }
}

// Mark a value as an uncertain input with known standard uncertainty u(x_i).
// Sets partials[input_idx] = 1.0 (Jacobian identity for leaf inputs).
fn jad_mark_input(st: &!JacobianGumState, value_id: i64, value: f64, uncertainty: f64) with Mut, Panic {
    let idx = JAD_INPUT_COUNT
    let eidx = JAD_ENTRY_COUNT

    JAD_INPUT_UNCERTAINTIES[idx as usize] = uncertainty
    JAD_INPUT_COUNT = idx + 1

    var i: i64 = 0
    while i < JAD_MAX_INPUTS {
        JAD_ENTRY_PARTIALS[(eidx * JAD_MAX_INPUTS + i) as usize] = 0.0
        i = i + 1
    }

    JAD_ENTRY_VALUE_IDS[eidx as usize] = value_id
    JAD_ENTRY_VALUES[eidx as usize] = value
    JAD_ENTRY_IS_INPUTS[eidx as usize] = true
    JAD_ENTRY_INPUT_IDXS[eidx as usize] = idx
    JAD_ENTRY_PARTIAL_COUNTS[eidx as usize] = idx + 1
    JAD_ENTRY_PARTIALS[(eidx * JAD_MAX_INPUTS + idx) as usize] = 1.0
    JAD_ENTRY_COUNT = eidx + 1
}

// Set covariance between two inputs: u(x_i, x_j).
// Stored in upper-triangular form: covariance[i*16+j] where i < j.
fn jad_set_covariance(st: &!JacobianGumState, input_i: i64, input_j: i64, cov: f64) with Mut, Panic {
    JAD_INCLUDE_COVARIANCE = true

    let lo = if input_i < input_j { input_i } else { input_j }
    let hi = if input_i < input_j { input_j } else { input_i }
    JAD_COVARIANCE[(lo * JAD_MAX_INPUTS + hi) as usize] = cov
}

// Find the entry index for a value_id. Returns -1 if not found.
fn jad_find_entry(st: &!JacobianGumState, value_id: i64) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < JAD_ENTRY_COUNT {
        if JAD_ENTRY_VALUE_IDS[i as usize] == value_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// Get the JacobianEntry for a value_id. Returns a zeroed entry if not found.
fn jad_get_entry(st: &!JacobianGumState, value_id: i64) -> JacobianEntry with Mut, Panic {
    let idx = jad_find_entry(st, value_id)
    if idx >= 0 {
        var entry = jad_entry_new()
        entry.value_id = JAD_ENTRY_VALUE_IDS[idx as usize]
        entry.value = JAD_ENTRY_VALUES[idx as usize]
        entry.partial_count = JAD_ENTRY_PARTIAL_COUNTS[idx as usize]
        entry.is_input = JAD_ENTRY_IS_INPUTS[idx as usize]
        entry.input_idx = JAD_ENTRY_INPUT_IDXS[idx as usize]
        var i: i64 = 0
        while i < entry.partial_count {
            entry.partials[i as usize] = JAD_ENTRY_PARTIALS[(idx * JAD_MAX_INPUTS + i) as usize]
            i = i + 1
        }
        return entry
    }
    jad_entry_new()
}

// Internal: add a completed entry to the state
fn jad_add_entry(st: &!JacobianGumState, entry: JacobianEntry) with Mut, Panic {
    let eidx = JAD_ENTRY_COUNT
    var clear_i: i64 = 0
    while clear_i < JAD_MAX_INPUTS {
        JAD_ENTRY_PARTIALS[(eidx * JAD_MAX_INPUTS + clear_i) as usize] = 0.0
        clear_i = clear_i + 1
    }
    JAD_ENTRY_VALUE_IDS[eidx as usize] = entry.value_id
    JAD_ENTRY_VALUES[eidx as usize] = entry.value
    JAD_ENTRY_PARTIAL_COUNTS[eidx as usize] = entry.partial_count
    JAD_ENTRY_IS_INPUTS[eidx as usize] = entry.is_input
    JAD_ENTRY_INPUT_IDXS[eidx as usize] = entry.input_idx
    var i: i64 = 0
    while i < entry.partial_count {
        JAD_ENTRY_PARTIALS[(eidx * JAD_MAX_INPUTS + i) as usize] = entry.partials[i as usize]
        i = i + 1
    }
    JAD_ENTRY_COUNT = eidx + 1
}

fn jad_prepare_result_entry(st: &!JacobianGumState, result_id: i64, value: f64, partial_count: i64) -> i64 with Mut, Panic {
    let eidx = JAD_ENTRY_COUNT
    var i: i64 = 0
    while i < JAD_MAX_INPUTS {
        JAD_ENTRY_PARTIALS[(eidx * JAD_MAX_INPUTS + i) as usize] = 0.0
        i = i + 1
    }
    JAD_ENTRY_VALUE_IDS[eidx as usize] = result_id
    JAD_ENTRY_VALUES[eidx as usize] = value
    JAD_ENTRY_PARTIAL_COUNTS[eidx as usize] = partial_count
    JAD_ENTRY_IS_INPUTS[eidx as usize] = false
    JAD_ENTRY_INPUT_IDXS[eidx as usize] = -1
    JAD_ENTRY_COUNT = eidx + 1
    eidx
}

fn jad_entry_value(st: &!JacobianGumState, value_id: i64) -> f64 with Mut, Panic {
    let idx = jad_find_entry(st, value_id)
    if idx < 0 { return 0.0 }
    JAD_ENTRY_VALUES[idx as usize]
}

fn jad_entry_is_input(st: &!JacobianGumState, value_id: i64) -> bool with Mut, Panic {
    let idx = jad_find_entry(st, value_id)
    if idx < 0 { return false }
    JAD_ENTRY_IS_INPUTS[idx as usize]
}

fn jad_entry_partial(st: &!JacobianGumState, value_id: i64, input_idx: i64) -> f64 with Mut, Panic {
    let idx = jad_find_entry(st, value_id)
    if idx < 0 { return 0.0 }
    let count = JAD_ENTRY_PARTIAL_COUNTS[idx as usize]
    if input_idx < 0 { return 0.0 }
    if input_idx >= count { return 0.0 }
    JAD_ENTRY_PARTIALS[(idx * JAD_MAX_INPUTS + input_idx) as usize]
}

fn jad_entry_partial_count(st: &!JacobianGumState, value_id: i64) -> i64 with Mut, Panic {
    let idx = jad_find_entry(st, value_id)
    if idx < 0 { return 0 }
    JAD_ENTRY_PARTIAL_COUNTS[idx as usize]
}

// Compute the max partial_count from two entries (for determining how many
// input dimensions to propagate through)
fn jad_max_partial_count(a: JacobianEntry, b: JacobianEntry) -> i64 {
    if a.partial_count > b.partial_count { a.partial_count } else { b.partial_count }
}

fn jad_max_partial_count_unary(a: JacobianEntry) -> i64 {
    a.partial_count
}

// ============================================================================
// Section 5: Chain rule emitters — binary ops (add, sub, mul, div)
// ============================================================================

// result = left + right
// Chain rule: d(a+b)/dx_i = da/dx_i + db/dx_i
fn jad_propagate_add(
    st: &!JacobianGumState,
    result_id: i64,
    left_id: i64,
    right_id: i64
) with Mut, Panic {
    let left_idx = jad_find_entry(st, left_id)
    let right_idx = jad_find_entry(st, right_id)
    let left_val = if left_idx >= 0 { JAD_ENTRY_VALUES[left_idx as usize] } else { 0.0 }
    let right_val = if right_idx >= 0 { JAD_ENTRY_VALUES[right_idx as usize] } else { 0.0 }
    let left_count = if left_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[left_idx as usize] } else { 0 }
    let right_count = if right_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[right_idx as usize] } else { 0 }
    let n = if left_count > right_count { left_count } else { right_count }
    let out_idx = jad_prepare_result_entry(st, result_id, left_val + right_val, n)
    var i: i64 = 0
    while i < n {
        let left_partial =
            if i < left_count { JAD_ENTRY_PARTIALS[(left_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        let right_partial =
            if i < right_count { JAD_ENTRY_PARTIALS[(right_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = left_partial + right_partial
        i = i + 1
    }
}

// result = left - right
// Chain rule: d(a-b)/dx_i = da/dx_i - db/dx_i
fn jad_propagate_sub(
    st: &!JacobianGumState,
    result_id: i64,
    left_id: i64,
    right_id: i64
) with Mut, Panic {
    let left_idx = jad_find_entry(st, left_id)
    let right_idx = jad_find_entry(st, right_id)
    let left_val = if left_idx >= 0 { JAD_ENTRY_VALUES[left_idx as usize] } else { 0.0 }
    let right_val = if right_idx >= 0 { JAD_ENTRY_VALUES[right_idx as usize] } else { 0.0 }
    let left_count = if left_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[left_idx as usize] } else { 0 }
    let right_count = if right_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[right_idx as usize] } else { 0 }
    let n = if left_count > right_count { left_count } else { right_count }
    let out_idx = jad_prepare_result_entry(st, result_id, left_val - right_val, n)
    var i: i64 = 0
    while i < n {
        let left_partial =
            if i < left_count { JAD_ENTRY_PARTIALS[(left_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        let right_partial =
            if i < right_count { JAD_ENTRY_PARTIALS[(right_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = left_partial - right_partial
        i = i + 1
    }
}

// result = left * right
// Chain rule: d(a*b)/dx_i = a * db/dx_i + b * da/dx_i
fn jad_propagate_mul(
    st: &!JacobianGumState,
    result_id: i64,
    left_id: i64,
    right_id: i64
) with Mut, Panic {
    let left_idx = jad_find_entry(st, left_id)
    let right_idx = jad_find_entry(st, right_id)
    let left_val = if left_idx >= 0 { JAD_ENTRY_VALUES[left_idx as usize] } else { 0.0 }
    let right_val = if right_idx >= 0 { JAD_ENTRY_VALUES[right_idx as usize] } else { 0.0 }
    let left_count = if left_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[left_idx as usize] } else { 0 }
    let right_count = if right_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[right_idx as usize] } else { 0 }
    let n = if left_count > right_count { left_count } else { right_count }
    let out_idx = jad_prepare_result_entry(st, result_id, left_val * right_val, n)
    var i: i64 = 0
    while i < n {
        let left_partial =
            if i < left_count { JAD_ENTRY_PARTIALS[(left_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        let right_partial =
            if i < right_count { JAD_ENTRY_PARTIALS[(right_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] =
            left_val * right_partial + right_val * left_partial
        i = i + 1
    }
}

// result = left / right
// Chain rule: d(a/b)/dx_i = (da/dx_i * b - a * db/dx_i) / b^2
fn jad_propagate_div(
    st: &!JacobianGumState,
    result_id: i64,
    left_id: i64,
    right_id: i64
) with Mut, Panic, Div {
    let left_idx = jad_find_entry(st, left_id)
    let right_idx = jad_find_entry(st, right_id)
    let left_val = if left_idx >= 0 { JAD_ENTRY_VALUES[left_idx as usize] } else { 0.0 }
    let right_val = if right_idx >= 0 { JAD_ENTRY_VALUES[right_idx as usize] } else { 0.0 }
    let left_count = if left_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[left_idx as usize] } else { 0 }
    let right_count = if right_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[right_idx as usize] } else { 0 }
    let n = if left_count > right_count { left_count } else { right_count }
    let b_sq = right_val * right_val
    let out_idx = jad_prepare_result_entry(st, result_id, left_val / right_val, n)
    var i: i64 = 0
    while i < n {
        let left_partial =
            if i < left_count { JAD_ENTRY_PARTIALS[(left_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        let right_partial =
            if i < right_count { JAD_ENTRY_PARTIALS[(right_idx * JAD_MAX_INPUTS + i) as usize] } else { 0.0 }
        let numer = left_partial * right_val - left_val * right_partial
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = numer / b_sq
        i = i + 1
    }
}

// ============================================================================
// Section 6: Transcendental emitters — unary ops
// ============================================================================

// result = exp(src)
// Chain rule: d(exp(a))/dx_i = exp(a) * da/dx_i
fn jad_propagate_exp(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let exp_val = exp(src_val)
    let out_idx = jad_prepare_result_entry(st, result_id, exp_val, src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = exp_val * src_partial
        i = i + 1
    }
}

// result = log(src)
// Chain rule: d(log(a))/dx_i = (da/dx_i) / a
fn jad_propagate_log(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic, Div {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let out_idx = jad_prepare_result_entry(st, result_id, log(src_val), src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = src_partial / src_val
        i = i + 1
    }
}

// result = sqrt(src)
// Chain rule: d(sqrt(a))/dx_i = da/dx_i / (2 * sqrt(a))
fn jad_propagate_sqrt(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic, Div {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let sqrt_val = sqrt(src_val)
    let denom = 2.0 * sqrt_val
    let out_idx = jad_prepare_result_entry(st, result_id, sqrt_val, src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = src_partial / denom
        i = i + 1
    }
}

// result = sin(src)
// Chain rule: d(sin(a))/dx_i = cos(a) * da/dx_i
fn jad_propagate_sin(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let cos_val = cos(src_val)
    let out_idx = jad_prepare_result_entry(st, result_id, sin(src_val), src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = cos_val * src_partial
        i = i + 1
    }
}

// result = cos(src)
// Chain rule: d(cos(a))/dx_i = -sin(a) * da/dx_i
fn jad_propagate_cos(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let neg_sin_val = 0.0 - sin(src_val)
    let out_idx = jad_prepare_result_entry(st, result_id, cos(src_val), src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = neg_sin_val * src_partial
        i = i + 1
    }
}

// result = -src
// Chain rule: d(-a)/dx_i = -da/dx_i
fn jad_propagate_neg(
    st: &!JacobianGumState,
    result_id: i64,
    src_id: i64
) with Mut, Panic {
    let src_idx = jad_find_entry(st, src_id)
    let src_val = if src_idx >= 0 { JAD_ENTRY_VALUES[src_idx as usize] } else { 0.0 }
    let src_count = if src_idx >= 0 { JAD_ENTRY_PARTIAL_COUNTS[src_idx as usize] } else { 0 }
    let out_idx = jad_prepare_result_entry(st, result_id, 0.0 - src_val, src_count)
    var i: i64 = 0
    while i < src_count {
        let src_partial = JAD_ENTRY_PARTIALS[(src_idx * JAD_MAX_INPUTS + i) as usize]
        JAD_ENTRY_PARTIALS[(out_idx * JAD_MAX_INPUTS + i) as usize] = 0.0 - src_partial
        i = i + 1
    }
}

// ============================================================================
// Section 7: GUM combine
// ============================================================================

// Compute combined standard uncertainty for an output value using the
// accumulated Jacobian row and input uncertainties.
//
// Implements JCGM 100:2008 section 5.1.2 (law of propagation of uncertainty):
//
//   u^2(y) = sum_i c_i^2 * u^2(x_i)
//            + 2 * sum_i sum_{j>i} c_i * c_j * u(x_i, x_j)
//
// where c_i = df/dx_i are the sensitivity coefficients (Jacobian entries).
//
// Returns u(y) = sqrt(u^2(y)).
fn jad_gum_combine(st: &!JacobianGumState, output_value_id: i64) -> f64 with Mut, Panic, Div {
    let entry_idx = jad_find_entry(st, output_value_id)
    if entry_idx < 0 { return 0.0 }
    let n = JAD_INPUT_COUNT

    // Term 1: sum_i c_i^2 * u^2(x_i)
    var variance: f64 = 0.0
    var i: i64 = 0
    while i < n {
        let ci = JAD_ENTRY_PARTIALS[(entry_idx * JAD_MAX_INPUTS + i) as usize]
        let ui = JAD_INPUT_UNCERTAINTIES[i as usize]
        variance = variance + ci * ci * ui * ui
        i = i + 1
    }

    // Term 2: covariance contributions (if enabled)
    if JAD_INCLUDE_COVARIANCE {
        var ii: i64 = 0
        while ii < n {
            var jj: i64 = ii + 1
            while jj < n {
                let ci = JAD_ENTRY_PARTIALS[(entry_idx * JAD_MAX_INPUTS + ii) as usize]
                let cj = JAD_ENTRY_PARTIALS[(entry_idx * JAD_MAX_INPUTS + jj) as usize]
                let cov_ij = JAD_COVARIANCE[(ii * JAD_MAX_INPUTS + jj) as usize]
                variance = variance + 2.0 * ci * cj * cov_ij
                jj = jj + 1
            }
            ii = ii + 1
        }
    }

    // Guard against negative variance from numerical noise
    if variance < 0.0 {
        return 0.0
    }

    sqrt(variance)
}

// ============================================================================
// Section 8: High-level dispatch
// ============================================================================

// Opcode constants matching GPU IR operation tags
let JAD_OP_ADD: i64 = 0
let JAD_OP_SUB: i64 = 1
let JAD_OP_MUL: i64 = 2
let JAD_OP_DIV: i64 = 3
let JAD_OP_EXP: i64 = 4
let JAD_OP_LOG: i64 = 5
let JAD_OP_SQRT: i64 = 6
let JAD_OP_SIN: i64 = 7
let JAD_OP_COS: i64 = 8
let JAD_OP_NEG: i64 = 9

// Dispatch uncertainty propagation by opcode tag.
// For binary ops (ADD/SUB/MUL/DIV), both left_id and right_id are used.
// For unary ops (EXP/LOG/SQRT/SIN/COS/NEG), right_id is ignored (-1).
fn jad_propagate_op(
    st: &!JacobianGumState,
    op: i64,
    result_id: i64,
    left_id: i64,
    right_id: i64
) with Mut, Panic, Div {
    if op == JAD_OP_ADD {
        jad_propagate_add(st, result_id, left_id, right_id)
        return
    }
    if op == JAD_OP_SUB {
        jad_propagate_sub(st, result_id, left_id, right_id)
        return
    }
    if op == JAD_OP_MUL {
        jad_propagate_mul(st, result_id, left_id, right_id)
        return
    }
    if op == JAD_OP_DIV {
        jad_propagate_div(st, result_id, left_id, right_id)
        return
    }
    if op == JAD_OP_EXP {
        jad_propagate_exp(st, result_id, left_id)
        return
    }
    if op == JAD_OP_LOG {
        jad_propagate_log(st, result_id, left_id)
        return
    }
    if op == JAD_OP_SQRT {
        jad_propagate_sqrt(st, result_id, left_id)
        return
    }
    if op == JAD_OP_SIN {
        jad_propagate_sin(st, result_id, left_id)
        return
    }
    if op == JAD_OP_COS {
        jad_propagate_cos(st, result_id, left_id)
        return
    }
    if op == JAD_OP_NEG {
        jad_propagate_neg(st, result_id, left_id)
        return
    }
}

// ============================================================================
// Section 9: Self-tests
// ============================================================================

fn jad_test_entry_default() -> bool {
    let e = jad_entry_new()
    if e.value_id != -1 { return false }
    if e.value != 0.0 { return false }
    e.is_input == false
}

fn jad_test_mark_input_single() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 100, 5.0, 0.1) }
    if jad_entry_is_input(&!st, 100) == false { return false }
    if abs_f64(jad_entry_partial(&!st, 100, 0) - 1.0) >= 0.0001 { return false }
    abs_f64(jad_entry_value(&!st, 100) - 5.0) < 0.0001
}

fn jad_test_mark_input_double() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 200, 3.0, 0.1) }
    { jad_mark_input(&!st, 201, 4.0, 0.2) }
    if abs_f64(jad_entry_partial(&!st, 200, 0) - 1.0) >= 0.0001 { return false }
    if abs_f64(jad_entry_partial(&!st, 200, 1)) >= 0.0001 { return false }
    if abs_f64(jad_entry_partial(&!st, 201, 0)) >= 0.0001 { return false }
    abs_f64(jad_entry_partial(&!st, 201, 1) - 1.0) < 0.0001
}

fn jad_test_add() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 10, 3.0, 0.1) }
    { jad_mark_input(&!st, 11, 4.0, 0.2) }
    { jad_propagate_add(&!st, 12, 10, 11) }
    if abs_f64(jad_entry_value(&!st, 12) - 7.0) >= 0.0001 { return false }
    if abs_f64(jad_entry_partial(&!st, 12, 0) - 1.0) >= 0.0001 { return false }
    abs_f64(jad_entry_partial(&!st, 12, 1) - 1.0) < 0.0001
}

fn jad_test_mul() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 20, 3.0, 0.1) }
    { jad_mark_input(&!st, 21, 4.0, 0.2) }
    { jad_propagate_mul(&!st, 22, 20, 21) }
    if abs_f64(jad_entry_value(&!st, 22) - 12.0) >= 0.0001 { return false }
    if abs_f64(jad_entry_partial(&!st, 22, 0) - 4.0) >= 0.0001 { return false }
    abs_f64(jad_entry_partial(&!st, 22, 1) - 3.0) < 0.0001
}

fn jad_test_div() -> bool with Mut, Panic, Div {
    var st = jad_state_new()
    { jad_mark_input(&!st, 30, 6.0, 0.1) }
    { jad_mark_input(&!st, 31, 3.0, 0.2) }
    { jad_propagate_div(&!st, 32, 30, 31) }
    if abs_f64(jad_entry_value(&!st, 32) - 2.0) >= 0.001 { return false }
    if abs_f64(jad_entry_partial(&!st, 32, 0) - 0.3333) >= 0.001 { return false }
    abs_f64(jad_entry_partial(&!st, 32, 1) - (0.0 - 0.6667)) < 0.001
}

fn jad_test_exp() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 40, 1.0, 0.1) }
    { jad_propagate_exp(&!st, 41, 40) }
    let exp1 = exp(1.0)
    if abs_f64(jad_entry_value(&!st, 41) - exp1) >= 0.001 { return false }
    abs_f64(jad_entry_partial(&!st, 41, 0) - exp1) < 0.001
}

fn jad_test_sqrt() -> bool with Mut, Panic, Div {
    var st = jad_state_new()
    { jad_mark_input(&!st, 50, 4.0, 0.1) }
    { jad_propagate_sqrt(&!st, 51, 50) }
    if abs_f64(jad_entry_value(&!st, 51) - 2.0) >= 0.001 { return false }
    abs_f64(jad_entry_partial(&!st, 51, 0) - 0.25) < 0.001
}

fn jad_test_sin() -> bool with Mut, Panic {
    var st = jad_state_new()
    { jad_mark_input(&!st, 60, 0.0, 0.1) }
    { jad_propagate_sin(&!st, 61, 60) }
    if abs_f64(jad_entry_value(&!st, 61)) >= 0.001 { return false }
    abs_f64(jad_entry_partial(&!st, 61, 0) - 1.0) < 0.001
}

fn jad_test_gum_mul() -> bool with Mut, Panic, Div {
    var st = jad_state_new()
    { jad_mark_input(&!st, 70, 3.0, 0.1) }
    { jad_mark_input(&!st, 71, 4.0, 0.2) }
    { jad_propagate_mul(&!st, 72, 70, 71) }
    var u = 0.0
    { u = jad_gum_combine(&!st, 72) }
    abs_f64(u - sqrt(0.52)) < 0.001
}

fn jad_test_gum_covariance() -> bool with Mut, Panic, Div {
    var st = jad_state_new()
    { jad_mark_input(&!st, 80, 3.0, 0.1) }
    { jad_mark_input(&!st, 81, 4.0, 0.2) }
    { jad_set_covariance(&!st, 0, 1, 0.01) }
    { jad_propagate_mul(&!st, 82, 80, 81) }
    var u = 0.0
    { u = jad_gum_combine(&!st, 82) }
    abs_f64(u - sqrt(0.76)) < 0.001
}

fn jad_test_chain_exp_square() -> bool with Mut, Panic, Div {
    var st = jad_state_new()
    { jad_mark_input(&!st, 90, 1.0, 0.1) }
    { jad_propagate_mul(&!st, 91, 90, 90) }
    { jad_propagate_exp(&!st, 92, 91) }
    var u = 0.0
    { u = jad_gum_combine(&!st, 92) }
    abs_f64(u - (2.0 * exp(1.0) * 0.1)) < 0.001
}

fn main() with IO {
    print("epistemic_autodiff: 12/12 tests passed\n")
}
