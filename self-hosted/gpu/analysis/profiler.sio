// self-hosted::gpu::analysis::profiler — GPU kernel performance analysis
//
// Static analysis of GPU kernels without a runtime CUDA profiler.
// Provides:
//   - Instruction-level FLOPs and memory-op counting
//   - Theoretical occupancy estimation from register/smem constraints
//   - Bottleneck classification: compute-bound, memory-bound, latency-bound
//   - Roofline model: peak performance vs estimated achieved performance
//   - Per-kernel and per-module metrics summaries
//   - PTX peephole optimization hints
//
// All data structures use fixed-capacity arrays; no heap allocation.
// Helpers always precede callers throughout (no forward references).

// ============================================================================
// Opcode constants (mirror kernel_ir/optimizer conventions)
// ============================================================================

let PROF_OP_ADD: i64          = 4
let PROF_OP_SUB: i64          = 5
let PROF_OP_MUL: i64          = 6
let PROF_OP_DIV: i64          = 7
let PROF_OP_FMA: i64          = 44
let PROF_OP_SQRT: i64         = 78
let PROF_OP_RSQRT: i64        = 79
let PROF_OP_EXP: i64          = 80
let PROF_OP_LOG: i64          = 81
let PROF_OP_SIN: i64          = 82
let PROF_OP_COS: i64          = 83
let PROF_OP_LOAD_GLOBAL: i64  = 14
let PROF_OP_STORE_GLOBAL: i64 = 15
let PROF_OP_LOAD_SHARED: i64  = 11
let PROF_OP_STORE_SHARED: i64 = 12
let PROF_OP_ATOMIC: i64       = 50
let PROF_OP_BARRIER: i64      = 10
let PROF_OP_SHFL: i64         = 59
let PROF_OP_VOTE: i64         = 62
let PROF_OP_SETP: i64         = 22
let PROF_OP_BRANCH: i64       = 98

// ============================================================================
// Peephole hint tag constants
// ============================================================================

let HINT_DIV_USE_RCP: i64          = 0   // replace div with rcp.approx + mul
let HINT_SQRT_USE_RSQRT: i64       = 1   // replace 1/sqrt with rsqrt.approx
let HINT_FUSED_LOAD_STORE: i64     = 2   // consecutive load+store -> LDG.128
let HINT_UNCOALESCED_ACCESS: i64   = 3   // stride > 1 in global load
let HINT_BANK_CONFLICT: i64        = 4   // shared-memory bank conflict
let HINT_WASTED_THREAD: i64        = 5   // threads that could be reorganized
let HINT_EXCESSIVE_SYNC: i64       = 6   // bar.sync inside inner loop
let HINT_DIVERGENT_BRANCH: i64     = 7   // branch depends on thread ID
let HINT_HIGH_REGISTER_USE: i64    = 8   // registers per thread > 64
let HINT_SMEM_PADDING_NEEDED: i64  = 9   // shared mem stride causes conflicts

// ============================================================================
// Bottleneck tag constants
// ============================================================================

let BOTTLENECK_COMPUTE: i64          = 0
let BOTTLENECK_MEMORY: i64           = 1
let BOTTLENECK_LATENCY: i64          = 2
let BOTTLENECK_SYNC: i64             = 3
let BOTTLENECK_BRANCH_DIVERGENCE: i64 = 4

// ============================================================================
// Limiting-factor tag constants for OccupancyEstimate
// ============================================================================

let OCC_LIMIT_REGISTERS: i64   = 0
let OCC_LIMIT_SMEM: i64        = 1
let OCC_LIMIT_BLOCKS: i64      = 2
let OCC_LIMIT_THREAD_COUNT: i64 = 3

// ============================================================================
// Core IR structs (flat, fixed-capacity — mirrors optimizer.sio)
// ============================================================================

struct ProfGpuOpEntry {
    opcode:   i64,
    type_tag: i64,
    dst_idx:  i64,
    src0:     i64,
    src1:     i64,
    src2:     i64,
    imm_int:  i64,
    imm_f32:  f32,
    pred:     i64,
    axis:     i64,
    dead:     bool,
}

struct ProfGpuBlockEntry {
    id:           i64,
    ops:          [ProfGpuOpEntry; 4096],
    op_count:     i64,
    term_tag:     i64,
    term_src:     i64,
    term_target0: i64,
    term_target1: i64,
}

struct ProfGpuKernelEntry {
    name:                  [i8; 256],
    name_len:              i64,
    is_kernel:             bool,
    blocks:                [ProfGpuBlockEntry; 256],
    block_count:           i64,
    param_count:           i64,
    shared_mem_bytes:      i64,
    max_threads_per_block: i64,
}

// ============================================================================
// SM hardware specification
// ============================================================================

struct SmHardwareSpec {
    sm_version:           i64,   // e.g. 80 for sm_80
    max_threads_per_sm:   i64,   // e.g. 2048
    max_blocks_per_sm:    i64,   // e.g. 32
    max_regs_per_sm:      i64,   // e.g. 65536
    max_regs_per_thread:  i64,   // e.g. 255
    max_smem_per_sm:      i64,   // bytes e.g. 167936 (sm_80: ~164 KB)
    max_smem_per_block:   i64,   // bytes e.g. 49152 (48 KB typical)
    warp_size:            i64,   // always 32
    fp32_throughput:      i64,   // FLOPs per SM per clock (e.g. 128 for sm_80)
    fp16_throughput:      i64,   // e.g. 256 for sm_80
    int32_throughput:     i64,   // e.g. 64 for sm_80
    mem_bandwidth_gb_s:   i64,   // GB/s (e.g. 1935 for A100)
    l2_cache_kb:          i64,   // e.g. 40960 (40 MB for A100)
}

// ============================================================================
// Analysis result structs
// ============================================================================

struct InstructionCounts {
    fp32_ops:      i64,
    fp64_ops:      i64,
    fp16_ops:      i64,
    int_ops:       i64,
    mem_loads:     i64,
    mem_stores:    i64,
    shared_loads:  i64,
    shared_stores: i64,
    atomic_ops:    i64,
    special_ops:   i64,  // sqrt, rcp, sin, cos, etc.
    branch_ops:    i64,
    barrier_ops:   i64,
    warp_ops:      i64,  // shfl, vote, ballot
    total_ops:     i64,
}

struct OccupancyEstimate {
    threads_per_block:   i64,
    registers_per_thread: i64,
    smem_per_block:      i64,
    active_warps_per_sm: i64,
    max_warps_per_sm:    i64,
    occupancy_pct:       i64,  // 0..100
    limiting_factor:     i64,  // 0=registers, 1=smem, 2=blocks, 3=thread_count
}

struct RooflinePoint {
    arithmetic_intensity:      f32,  // FLOPs / byte
    achieved_throughput_gflops: f32, // estimated GFLOPs
    peak_memory_throughput:    f32,  // GB/s
    peak_compute_throughput:   f32,  // GFLOPs
    is_memory_bound:           bool,
    is_compute_bound:          bool,
    efficiency_pct:            i64,
}

struct BottleneckInfo {
    tag:         i64,  // BOTTLENECK_* constant
    severity:    f32,  // 0.0..1.0
    description: i64,  // opaque tag for report
}

struct KernelMetrics {
    name:              [i8; 256],
    name_len:          i64,
    instr_counts:      InstructionCounts,
    occupancy:         OccupancyEstimate,
    roofline:          RooflinePoint,
    bottleneck:        BottleneckInfo,
    estimated_cycles:  i64,
    estimated_ms_at_1ghz: f32,
}

struct ModuleMetrics {
    kernels:         [KernelMetrics; 64],
    kernel_count:    i64,
    total_fp32_ops:  i64,
    total_mem_bytes: i64,
}

struct PeepholeHint {
    op_idx:   i64,
    hint_tag: i64,  // HINT_* constant
    severity: i64,  // 0=info, 1=warning, 2=critical
}

// ============================================================================
// Zero / default constructors
// ============================================================================

fn prof_ic_new() -> InstructionCounts {
    InstructionCounts {
        fp32_ops:      0,
        fp64_ops:      0,
        fp16_ops:      0,
        int_ops:       0,
        mem_loads:     0,
        mem_stores:    0,
        shared_loads:  0,
        shared_stores: 0,
        atomic_ops:    0,
        special_ops:   0,
        branch_ops:    0,
        barrier_ops:   0,
        warp_ops:      0,
        total_ops:     0,
    }
}

fn prof_occupancy_zero() -> OccupancyEstimate {
    OccupancyEstimate {
        threads_per_block:    0,
        registers_per_thread: 0,
        smem_per_block:       0,
        active_warps_per_sm:  0,
        max_warps_per_sm:     64,
        occupancy_pct:        0,
        limiting_factor:      OCC_LIMIT_THREAD_COUNT,
    }
}

fn prof_roofline_zero() -> RooflinePoint {
    RooflinePoint {
        arithmetic_intensity:       0.0,
        achieved_throughput_gflops: 0.0,
        peak_memory_throughput:     0.0,
        peak_compute_throughput:    0.0,
        is_memory_bound:            true,
        is_compute_bound:           false,
        efficiency_pct:             0,
    }
}

fn prof_bottleneck_zero() -> BottleneckInfo {
    BottleneckInfo {
        tag:         BOTTLENECK_MEMORY,
        severity:    0.5,
        description: 0,
    }
}

fn prof_peephole_hint_zero() -> PeepholeHint {
    PeepholeHint {
        op_idx:   -1,
        hint_tag: HINT_DIV_USE_RCP,
        severity: 0,
    }
}

fn prof_gpu_op_entry_zero() -> ProfGpuOpEntry {
    ProfGpuOpEntry {
        opcode:   0,
        type_tag: 0,
        dst_idx:  -1,
        src0:     -1,
        src1:     -1,
        src2:     -1,
        imm_int:  0,
        imm_f32:  0.0 as f32,
        pred:     -1,
        axis:     0,
        dead:     false,
    }
}

