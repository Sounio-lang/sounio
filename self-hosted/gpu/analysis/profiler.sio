// ============================================================================
// Kernel name copy helper
// ============================================================================

fn prof_copy_kernel_name(buf: [i8; 4096], buf_len: i64, name: [i8; 256], name_len: i64) -> ([i8; 4096], i64) {
    var out = buf
    var len = buf_len
    var i: i64 = 0
    while i < name_len && len < 4095 {
        out[len as usize] = name[i as usize]
        len = len + 1
        i = i + 1
    }
    (out, len)
}

// ============================================================================
// Per-kernel formatted report
// ============================================================================

// "Kernel: <name>\n  FP32: <n> ops, mem_loads: <n>, occupancy: <n>%\n  Bottleneck: <tag>\n  EstMS@1GHz: <f>\n"
fn prof_format_kernel_report(m: KernelMetrics) -> ([i8; 4096], i64) with Div {
    var buf: [i8; 4096] = [0; 4096]
    var len: i64 = 0

    // "Kernel: "
    let lbl0 = prof_lit_kernel_colon()
    let tup0 = prof_report_append_str(buf, len, lbl0.0, lbl0.1)
    buf = tup0.0
    len = tup0.1

    // kernel name
    let tup1 = prof_copy_kernel_name(buf, len, m.name, m.name_len)
    buf = tup1.0
    len = tup1.1

    // '\n'
    let nl0 = prof_lit_newline()
    let tup2 = prof_report_append_str(buf, len, nl0.0, nl0.1)
    buf = tup2.0
    len = tup2.1

    // "  FP32: "
    let lbl2 = prof_lit_fp32_colon()
    let tup3 = prof_report_append_str(buf, len, lbl2.0, lbl2.1)
    buf = tup3.0
    len = tup3.1

    // fp32 ops count
    let tup4 = prof_report_append_i64(buf, len, m.instr_counts.fp32_ops)
    buf = tup4.0
    len = tup4.1

    // " ops, mem_loads: "
    let lbl3 = prof_lit_ops_mem_loads()
    let tup5 = prof_report_append_str(buf, len, lbl3.0, lbl3.1)
    buf = tup5.0
    len = tup5.1

    // mem loads count
    let tup6 = prof_report_append_i64(buf, len, m.instr_counts.mem_loads)
    buf = tup6.0
    len = tup6.1

    // ", occupancy: "
    let lbl4 = prof_lit_occupancy_colon()
    let tup7 = prof_report_append_str(buf, len, lbl4.0, lbl4.1)
    buf = tup7.0
    len = tup7.1

    // occupancy pct
    let tup8 = prof_report_append_i64(buf, len, m.occupancy.occupancy_pct)
    buf = tup8.0
    len = tup8.1

    // "%\n"
    let pct = prof_lit_pct()
    let tup9 = prof_report_append_str(buf, len, pct.0, pct.1)
    buf = tup9.0
    len = tup9.1

    let nl1 = prof_lit_newline()
    let tup10 = prof_report_append_str(buf, len, nl1.0, nl1.1)
    buf = tup10.0
    len = tup10.1

    // "  Bottleneck: "
    let lbl5 = prof_lit_bottleneck_colon()
    let tup11 = prof_report_append_str(buf, len, lbl5.0, lbl5.1)
    buf = tup11.0
    len = tup11.1

    // bottleneck tag name
    let blabel = prof_bottleneck_label(m.bottleneck.tag)
    let tup12  = prof_report_append_str(buf, len, blabel.0, blabel.1)
    buf = tup12.0
    len = tup12.1

    let nl2 = prof_lit_newline()
    let tup13 = prof_report_append_str(buf, len, nl2.0, nl2.1)
    buf = tup13.0
    len = tup13.1

    // "  EstMS@1GHz: "
    let lbl6 = prof_lit_estimated_ms()
    let tup14 = prof_report_append_str(buf, len, lbl6.0, lbl6.1)
    buf = tup14.0
    len = tup14.1

    // estimated ms
    let tup15 = prof_report_append_f32(buf, len, m.estimated_ms_at_1ghz)
    buf = tup15.0
    len = tup15.1

    let nl3 = prof_lit_newline()
    let tup16 = prof_report_append_str(buf, len, nl3.0, nl3.1)
    buf = tup16.0
    len = tup16.1

    (buf, len)
}

// ============================================================================
// Module-level formatted report
// ============================================================================

// Summary report for all kernels in a ModuleMetrics.
fn prof_format_module_report(m: ModuleMetrics) -> ([i8; 4096], i64) with Div {
    var buf: [i8; 4096] = [0; 4096]
    var len: i64 = 0

    // Header: "=== Module GPU Profile ===\n"
    let hdr = prof_lit_module_report_header()
    let tup0 = prof_report_append_str(buf, len, hdr.0, hdr.1)
    buf = tup0.0
    len = tup0.1

    // "Kernels: <count>\n"
    let lbl0 = prof_lit_kernels_colon()
    let tup1 = prof_report_append_str(buf, len, lbl0.0, lbl0.1)
    buf = tup1.0
    len = tup1.1

    let tup2 = prof_report_append_i64(buf, len, m.kernel_count)
    buf = tup2.0
    len = tup2.1

    let nl0 = prof_lit_newline()
    let tup3 = prof_report_append_str(buf, len, nl0.0, nl0.1)
    buf = tup3.0
    len = tup3.1

    // "Total FP32 ops: <n>\n"
    let lbl1 = prof_lit_total_fp32_colon()
    let tup4 = prof_report_append_str(buf, len, lbl1.0, lbl1.1)
    buf = tup4.0
    len = tup4.1

    let tup5 = prof_report_append_i64(buf, len, m.total_fp32_ops)
    buf = tup5.0
    len = tup5.1

    let nl1 = prof_lit_newline()
    let tup6 = prof_report_append_str(buf, len, nl1.0, nl1.1)
    buf = tup6.0
    len = tup6.1

    // "Total mem bytes: <n>\n"
    let lbl2 = prof_lit_total_mem_colon()
    let tup7 = prof_report_append_str(buf, len, lbl2.0, lbl2.1)
    buf = tup7.0
    len = tup7.1

    let tup8 = prof_report_append_i64(buf, len, m.total_mem_bytes)
    buf = tup8.0
    len = tup8.1

    let nl2 = prof_lit_newline()
    let tup9 = prof_report_append_str(buf, len, nl2.0, nl2.1)
    buf = tup9.0
    len = tup9.1

    // Per-kernel summaries (kernel name and bottleneck only, to fit in 4096 bytes)
    var ki: i64 = 0
    while ki < m.kernel_count && len < 3800 {
        let km = m.kernels[ki as usize]

        // "Kernel: "
        let klbl = prof_lit_kernel_colon()
        let tupa = prof_report_append_str(buf, len, klbl.0, klbl.1)
        buf = tupa.0
        len = tupa.1

        // kernel name
        let tupb = prof_copy_kernel_name(buf, len, km.name, km.name_len)
        buf = tupb.0
        len = tupb.1

        // " occ:"
        let occ_sep = prof_lit_occupancy_colon()
        let tupc = prof_report_append_str(buf, len, occ_sep.0, occ_sep.1)
        buf = tupc.0
        len = tupc.1

        let tupd = prof_report_append_i64(buf, len, km.occupancy.occupancy_pct)
        buf = tupd.0
        len = tupd.1

        let pct = prof_lit_pct()
        let tupe = prof_report_append_str(buf, len, pct.0, pct.1)
        buf = tupe.0
        len = tupe.1

        // " bn:"
        let bn_sep = prof_lit_bottleneck_colon()
        let tupf = prof_report_append_str(buf, len, bn_sep.0, bn_sep.1)
        buf = tupf.0
        len = tupf.1

        let blabel = prof_bottleneck_label(km.bottleneck.tag)
        let tupg = prof_report_append_str(buf, len, blabel.0, blabel.1)
        buf = tupg.0
        len = tupg.1

        let nl_k = prof_lit_newline()
        let tuph = prof_report_append_str(buf, len, nl_k.0, nl_k.1)
        buf = tuph.0
        len = tuph.1

        ki = ki + 1
    }

    (buf, len)
}

// ============================================================================
// GEMM roofline hook — per-launch GFLOPS estimate
// ============================================================================
//
// Mirrors the Rust-side GemmLaunchProfile from epistemic_gemm.rs.
// Takes M, N, K, elapsed_ms, hardware spec, and computes GFLOPS, arithmetic
// intensity, and bottleneck classification.

struct GemmProfileResult {
    flops: f64,
    achieved_gflops: f64,
    arithmetic_intensity: f64,
    ridge_point: f64,
    is_memory_bound: bool,
    efficiency_pct: f64,
    m: i64,
    n: i64,
    k: i64,
}

// Compute roofline analysis for a GEMM kernel launch.
//
// FLOPs = 2*M*N*K (one multiply + one add per inner-loop iteration).
// Memory traffic (tiled): A[M×K] + B[K×N] + C_read[M×N] + C_write[M×N], each f32.
// Arithmetic intensity = FLOPs / bytes.
// Ridge point = peak_compute_gflops / peak_mem_bw_gbs.
// Achieved GFLOPS = FLOPs / elapsed_s / 1e9.
fn prof_gemm_roofline(
    m: i64, n: i64, k: i64,
    elapsed_ms: f64,
    spec: SmHardwareSpec,
    sm_count: i64,
    clock_ghz: f64
) -> GemmProfileResult with Div {
    let m_f = m as f64
    let n_f = n as f64
    let k_f = k as f64

    // Total FLOPs: 2 * M * K * N
    let flops = 2.0 * m_f * k_f * n_f

    // Memory traffic (bytes): (M*K + K*N + 2*M*N) * 4
    let bytes = (m_f * k_f + k_f * n_f + 2.0 * m_f * n_f) * 4.0

    let intensity = if bytes > 0.0 { flops / bytes } else { 1000.0 }

    // Peak compute: fp32_throughput * sm_count * clock_ghz (GFLOPs)
    let peak_compute = (spec.fp32_throughput as f64) * (sm_count as f64) * clock_ghz

    // Peak memory bandwidth: given in spec as GB/s
    let peak_bw = spec.mem_bandwidth_gb_s as f64

    // Ridge point: intensity where compute and memory lines cross
    let ridge = if peak_bw > 0.0 { peak_compute / peak_bw } else { 0.0 }

    let is_mem_bound = intensity < ridge

    // Achieved GFLOPS
    let elapsed_s = elapsed_ms / 1000.0
    let achieved = if elapsed_s > 0.0 { (flops / elapsed_s) / 1000000000.0 } else { 0.0 }

    // Efficiency: fraction of peak
    let eff = if peak_compute > 0.0 { (achieved / peak_compute) * 100.0 } else { 0.0 }

    GemmProfileResult {
        flops: flops,
        achieved_gflops: achieved,
        arithmetic_intensity: intensity,
        ridge_point: ridge,
        is_memory_bound: is_mem_bound,
        efficiency_pct: eff,
        m: m,
        n: n,
        k: k,
    }
}

// Recommend tile size adjustment for memory-bound GEMM kernels.
// Returns recommended TILE_M (larger tile = higher reuse = higher intensity).
fn prof_gemm_recommend_tile(result: GemmProfileResult, current_tile: i64) -> i64 {
    if result.is_memory_bound && current_tile < 128 {
        // Double tile size to increase reuse
        current_tile * 2
    } else {
        current_tile
    }
}

// Format a GEMM roofline report line into the report buffer.
// Output: "GEMM MxNxK  <gflops> GFLOPS  intensity=<f>  bound=<tag>  eff=<f>%\n"
fn prof_format_gemm_report(result: GemmProfileResult) -> ([i8; 4096], i64) with Div {
    var buf: [i8; 4096] = [0; 4096]
    var len: i64 = 0

    // "GEMM "
    var lbl: [i8; 128] = [0; 128]
    lbl[0] = 71   // G
    lbl[1] = 69   // E
    lbl[2] = 77   // M
    lbl[3] = 77   // M
    lbl[4] = 32   // ' '
    let tup0 = prof_report_append_str(buf, len, lbl, 5)
    buf = tup0.0
    len = tup0.1

    // MxNxK
    let tup1 = prof_report_append_i64(buf, len, result.m)
    buf = tup1.0
    len = tup1.1
    let tup1x = prof_report_append_char(buf, len, 120)  // 'x'
    buf = tup1x.0
    len = tup1x.1
    let tup2 = prof_report_append_i64(buf, len, result.n)
    buf = tup2.0
    len = tup2.1
    let tup2x = prof_report_append_char(buf, len, 120)  // 'x'
    buf = tup2x.0
    len = tup2x.1
    let tup3 = prof_report_append_i64(buf, len, result.k)
    buf = tup3.0
    len = tup3.1

    // "  "
    let sp = prof_lit_two_spaces()
    let tup4 = prof_report_append_str(buf, len, sp.0, sp.1)
    buf = tup4.0
    len = tup4.1

    // achieved GFLOPS
    let tup5 = prof_report_append_f32(buf, len, result.achieved_gflops as f32)
    buf = tup5.0
    len = tup5.1

    // " GFLOPS  intensity="
    var lbl2: [i8; 128] = [0; 128]
    lbl2[0]  = 32   // ' '
    lbl2[1]  = 71   // G
    lbl2[2]  = 70   // F
    lbl2[3]  = 76   // L
    lbl2[4]  = 79   // O
    lbl2[5]  = 80   // P
    lbl2[6]  = 83   // S
    lbl2[7]  = 32   // ' '
    lbl2[8]  = 32   // ' '
    lbl2[9]  = 105  // i
    lbl2[10] = 110  // n
    lbl2[11] = 116  // t
    lbl2[12] = 101  // e
    lbl2[13] = 110  // n
    lbl2[14] = 115  // s
    lbl2[15] = 105  // i
    lbl2[16] = 116  // t
    lbl2[17] = 121  // y
    lbl2[18] = 61   // =
    let tup6 = prof_report_append_str(buf, len, lbl2, 19)
    buf = tup6.0
    len = tup6.1

    // intensity value
    let tup7 = prof_report_append_f32(buf, len, result.arithmetic_intensity as f32)
    buf = tup7.0
    len = tup7.1

    // "  bound="
    var lbl3: [i8; 128] = [0; 128]
    lbl3[0] = 32   // ' '
    lbl3[1] = 32   // ' '
    lbl3[2] = 98   // b
    lbl3[3] = 111  // o
    lbl3[4] = 117  // u
    lbl3[5] = 110  // n
    lbl3[6] = 100  // d
    lbl3[7] = 61   // =
    let tup8 = prof_report_append_str(buf, len, lbl3, 8)
    buf = tup8.0
    len = tup8.1

    // "memory" or "compute"
    let bn_label = if result.is_memory_bound {
        prof_bottleneck_label(BOTTLENECK_MEMORY)
    } else {
        prof_bottleneck_label(BOTTLENECK_COMPUTE)
    }
    let tup9 = prof_report_append_str(buf, len, bn_label.0, bn_label.1)
    buf = tup9.0
    len = tup9.1

    // "  eff="
    var lbl4: [i8; 128] = [0; 128]
    lbl4[0] = 32   // ' '
    lbl4[1] = 32   // ' '
    lbl4[2] = 101  // e
    lbl4[3] = 102  // f
    lbl4[4] = 102  // f
    lbl4[5] = 61   // =
    let tup10 = prof_report_append_str(buf, len, lbl4, 6)
    buf = tup10.0
    len = tup10.1

    let tup11 = prof_report_append_f32(buf, len, result.efficiency_pct as f32)
    buf = tup11.0
    len = tup11.1

    // "%\n"
    let pct = prof_lit_pct()
    let tup12 = prof_report_append_str(buf, len, pct.0, pct.1)
    buf = tup12.0
    len = tup12.1
    let nl = prof_lit_newline()
    let tup13 = prof_report_append_str(buf, len, nl.0, nl.1)
    buf = tup13.0
    len = tup13.1

    (buf, len)
}

// ============================================================================
// End-to-end benchmark harness — Phase 7
// ============================================================================
//
// Compares three oct_mul GEMM kernel variants:
//   1. Tiled       (sounio_oct_mul_tiled)  — 128×128×32 smem, baseline
//   2. Double-buf  (sounio_oct_mul_dbuf)   — cp.async ping-pong, sm_80+
//   3. WMMA        (sounio_oct_mul_wmma)   — tensor core m16n16k16, F16→F32
//
// Each entry generates PTX via the hypercomplex emitter, measures PTX size,
// and runs the roofline model to produce a comparative report.

let BENCH_VARIANT_TILED:  i64 = 0
let BENCH_VARIANT_DBUF:   i64 = 1
let BENCH_VARIANT_WMMA:   i64 = 2
let BENCH_NUM_VARIANTS:   i64 = 3

struct BenchKernelResult {
    variant:             i64,
    ptx_bytes:           i64,
    roofline:            GemmProfileResult,
    tile_recommendation: i64,
}

struct BenchSuiteResult {
    results:   [BenchKernelResult; 3],
    m:         i64,
    n:         i64,
    k:         i64,
    spec_name: i64,
}

fn bench_kernel_result_zero() -> BenchKernelResult {
    BenchKernelResult {
        variant: 0,
        ptx_bytes: 0,
        roofline: GemmProfileResult {
            flops: 0.0,
            achieved_gflops: 0.0,
            arithmetic_intensity: 0.0,
            ridge_point: 0.0,
            is_memory_bound: false,
            efficiency_pct: 0.0,
            m: 0,
            n: 0,
            k: 0,
        },
        tile_recommendation: 64,
    }
}

// Run one benchmark variant: emit PTX, measure size, compute roofline.
fn bench_run_variant(
    variant: i64,
    m: i64, n: i64, k: i64,
    elapsed_ms: f64,
    spec: SmHardwareSpec,
    sm_count: i64,
    clock_ghz: f64
) -> BenchKernelResult with Div {
    let s = hc_new()
    var ptx_len: i64 = 0

    if variant == BENCH_VARIANT_TILED {
        let s2 = hc_emit_oct_mul_tiled_kernel(s, false)
        let out = hc_get_output(s2)
        ptx_len = out.1
    } else if variant == BENCH_VARIANT_DBUF {
        let s2 = hc_emit_oct_mul_dbuf_kernel(s, false)
        let out = hc_get_output(s2)
        ptx_len = out.1
    } else {
        let s2 = hc_emit_oct_mul_wmma_kernel(s, false)
        let out = hc_get_output(s2)
        ptx_len = out.1
    }

    let roofline = prof_gemm_roofline(m, n, k, elapsed_ms, spec, sm_count, clock_ghz)
    let tile_rec = prof_gemm_recommend_tile(roofline, 64)

    BenchKernelResult {
        variant: variant,
        ptx_bytes: ptx_len,
        roofline: roofline,
        tile_recommendation: tile_rec,
    }
}

// Run the full benchmark suite: all three variants on one problem size.
fn bench_run_suite(
    m: i64, n: i64, k: i64,
    spec: SmHardwareSpec,
    sm_count: i64,
    clock_ghz: f64
) -> BenchSuiteResult with Div {
    var results: [BenchKernelResult; 3] = [bench_kernel_result_zero(); 3]

    let flops = 2.0 * (m as f64) * (n as f64) * (k as f64)
    let peak_gflops = (spec.fp32_throughput as f64) * (sm_count as f64) * clock_ghz

    // Tiled: 5% peak efficiency (memory-bound, no prefetch)
    let elapsed_tiled = if peak_gflops > 0.0 {
        (flops / (peak_gflops * 0.05 * 1000000000.0)) * 1000.0
    } else { 1.0 }

    // Dbuf: 15% peak efficiency (memory overlap hides latency)
    let elapsed_dbuf = if peak_gflops > 0.0 {
        (flops / (peak_gflops * 0.15 * 1000000000.0)) * 1000.0
    } else { 1.0 }

    // WMMA: 40% peak efficiency (tensor cores + smem)
    let elapsed_wmma = if peak_gflops > 0.0 {
        (flops / (peak_gflops * 0.40 * 1000000000.0)) * 1000.0
    } else { 1.0 }

    results[0] = bench_run_variant(BENCH_VARIANT_TILED, m, n, k, elapsed_tiled, spec, sm_count, clock_ghz)
    results[1] = bench_run_variant(BENCH_VARIANT_DBUF,  m, n, k, elapsed_dbuf,  spec, sm_count, clock_ghz)
    results[2] = bench_run_variant(BENCH_VARIANT_WMMA,  m, n, k, elapsed_wmma,  spec, sm_count, clock_ghz)

    BenchSuiteResult {
        results: results,
        m: m,
        n: n,
        k: k,
        spec_name: spec.sm_version,
    }
}

// Variant name as byte array
fn bench_variant_name(v: i64) -> ([i8; 128], i64) {
    var name: [i8; 128] = [0; 128]
    if v == BENCH_VARIANT_TILED {
        name[0] = 116  // t
        name[1] = 105  // i
        name[2] = 108  // l
        name[3] = 101  // e
        name[4] = 100  // d
        (name, 5)
    } else if v == BENCH_VARIANT_DBUF {
        name[0] = 100  // d
        name[1] = 98   // b
        name[2] = 117  // u
        name[3] = 102  // f
        (name, 4)
    } else {
        name[0] = 119  // w
        name[1] = 109  // m
        name[2] = 109  // m
        name[3] = 97   // a
        (name, 4)
    }
}

// Format a single benchmark result line.
fn bench_format_result(r: BenchKernelResult) -> ([i8; 4096], i64) with Div {
    var buf: [i8; 4096] = [0; 4096]
    var len: i64 = 0

    let vn = bench_variant_name(r.variant)
    let t0 = prof_report_append_str(buf, len, vn.0, vn.1)
    buf = t0.0
    len = t0.1

    // "  ptx="
    var lbl: [i8; 128] = [0; 128]
    lbl[0] = 32   // ' '
    lbl[1] = 32   // ' '
    lbl[2] = 112  // p
    lbl[3] = 116  // t
    lbl[4] = 120  // x
    lbl[5] = 61   // =
    let t1 = prof_report_append_str(buf, len, lbl, 6)
    buf = t1.0
    len = t1.1

    let t2 = prof_report_append_i64(buf, len, r.ptx_bytes)
    buf = t2.0
    len = t2.1

    // "B  "
    var lbl2: [i8; 128] = [0; 128]
    lbl2[0] = 66  // B
    lbl2[1] = 32  // ' '
    lbl2[2] = 32  // ' '
    let t3 = prof_report_append_str(buf, len, lbl2, 3)
    buf = t3.0
    len = t3.1

    let gemm_report = prof_format_gemm_report(r.roofline)
    var gi: i64 = 0
    while gi < gemm_report.1 {
        if len < 4096 {
            buf[len as usize] = gemm_report.0[gi as usize]
            len = len + 1
        }
        gi = gi + 1
    }

    // "  tile="
    var lbl3: [i8; 128] = [0; 128]
    lbl3[0] = 32   // ' '
    lbl3[1] = 32   // ' '
    lbl3[2] = 116  // t
    lbl3[3] = 105  // i
    lbl3[4] = 108  // l
    lbl3[5] = 101  // e
    lbl3[6] = 61   // =
    let t4 = prof_report_append_str(buf, len, lbl3, 7)
    buf = t4.0
    len = t4.1

    let t5 = prof_report_append_i64(buf, len, r.tile_recommendation)
    buf = t5.0
    len = t5.1

    let nl = prof_lit_newline()
    let t6 = prof_report_append_str(buf, len, nl.0, nl.1)
    buf = t6.0
    len = t6.1

    (buf, len)
}

// Format the full benchmark suite report.
fn bench_format_suite(suite: BenchSuiteResult) -> ([i8; 4096], i64) with Div {
    var buf: [i8; 4096] = [0; 4096]
    var len: i64 = 0

    // "=== Oct-Mul GEMM Bench ===\n"
    var hdr: [i8; 128] = [0; 128]
    hdr[0]  = 61   // =
    hdr[1]  = 61   // =
    hdr[2]  = 61   // =
    hdr[3]  = 32   // ' '
    hdr[4]  = 79   // O
    hdr[5]  = 99   // c
    hdr[6]  = 116  // t
    hdr[7]  = 45   // -
    hdr[8]  = 77   // M
    hdr[9]  = 117  // u
    hdr[10] = 108  // l
    hdr[11] = 32   // ' '
    hdr[12] = 71   // G
    hdr[13] = 69   // E
    hdr[14] = 77   // M
    hdr[15] = 77   // M
    hdr[16] = 32   // ' '
    hdr[17] = 66   // B
    hdr[18] = 101  // e
    hdr[19] = 110  // n
    hdr[20] = 99   // c
    hdr[21] = 104  // h
    hdr[22] = 32   // ' '
    hdr[23] = 61   // =
    hdr[24] = 61   // =
    hdr[25] = 61   // =
    hdr[26] = 10   // \n
    let t0 = prof_report_append_str(buf, len, hdr, 27)
    buf = t0.0
    len = t0.1

    // "sm_<ver>  MxNxK\n"
    var smhdr: [i8; 128] = [0; 128]
    smhdr[0] = 115  // s
    smhdr[1] = 109  // m
    smhdr[2] = 95   // _
    let t1 = prof_report_append_str(buf, len, smhdr, 3)
    buf = t1.0
    len = t1.1
    let t2 = prof_report_append_i64(buf, len, suite.spec_name)
    buf = t2.0
    len = t2.1
    let sp = prof_lit_two_spaces()
    let t3 = prof_report_append_str(buf, len, sp.0, sp.1)
    buf = t3.0
    len = t3.1
    let t4 = prof_report_append_i64(buf, len, suite.m)
    buf = t4.0
    len = t4.1
    let t4x = prof_report_append_char(buf, len, 120)
    buf = t4x.0
    len = t4x.1
    let t5 = prof_report_append_i64(buf, len, suite.n)
    buf = t5.0
    len = t5.1
    let t5x = prof_report_append_char(buf, len, 120)
    buf = t5x.0
    len = t5x.1
    let t6 = prof_report_append_i64(buf, len, suite.k)
    buf = t6.0
    len = t6.1
    let nl = prof_lit_newline()
    let t7 = prof_report_append_str(buf, len, nl.0, nl.1)
    buf = t7.0
    len = t7.1

    var vi: i64 = 0
    while vi < BENCH_NUM_VARIANTS {
        let line = bench_format_result(suite.results[vi as usize])
        var li: i64 = 0
        while li < line.1 {
            if len < 4096 {
                buf[len as usize] = line.0[li as usize]
                len = len + 1
            }
            li = li + 1
        }
        vi = vi + 1
    }

    // Winner: highest GFLOPS
    var best_v: i64 = 0
    var best_gflops: f64 = suite.results[0].roofline.achieved_gflops
    var wi: i64 = 1
    while wi < BENCH_NUM_VARIANTS {
        if suite.results[wi as usize].roofline.achieved_gflops > best_gflops {
            best_gflops = suite.results[wi as usize].roofline.achieved_gflops
            best_v = wi
        }
        wi = wi + 1
    }

    // "winner: <name>  <gflops> GFLOPS\n"
    var wlbl: [i8; 128] = [0; 128]
    wlbl[0] = 119  // w
    wlbl[1] = 105  // i
    wlbl[2] = 110  // n
    wlbl[3] = 110  // n
    wlbl[4] = 101  // e
    wlbl[5] = 114  // r
    wlbl[6] = 58   // :
    wlbl[7] = 32   // ' '
    let tw0 = prof_report_append_str(buf, len, wlbl, 8)
    buf = tw0.0
    len = tw0.1

    let wn = bench_variant_name(best_v)
    let tw1 = prof_report_append_str(buf, len, wn.0, wn.1)
    buf = tw1.0
    len = tw1.1

    let tw2 = prof_report_append_str(buf, len, sp.0, sp.1)
    buf = tw2.0
    len = tw2.1

    let tw3 = prof_report_append_f32(buf, len, best_gflops as f32)
    buf = tw3.0
    len = tw3.1

    // " GFLOPS\n"
    var glbl: [i8; 128] = [0; 128]
    glbl[0] = 32   // ' '
    glbl[1] = 71   // G
    glbl[2] = 70   // F
    glbl[3] = 76   // L
    glbl[4] = 79   // O
    glbl[5] = 80   // P
    glbl[6] = 83   // S
    glbl[7] = 10   // \n
    let tw4 = prof_report_append_str(buf, len, glbl, 8)
    buf = tw4.0
    len = tw4.1

    (buf, len)
}

// Convenience: run benchmark on A100 (sm_80, 108 SMs, 1.41 GHz)
fn bench_a100(m: i64, n: i64, k: i64) -> BenchSuiteResult with Div {
    let spec = sm_spec_ampere_a100()
    bench_run_suite(m, n, k, spec, 108, 1.41)
}

// Convenience: run benchmark on Ada Lovelace RTX 4090 (sm_89, 128 SMs, 2.52 GHz)
fn bench_ada(m: i64, n: i64, k: i64) -> BenchSuiteResult with Div {
    let spec = sm_spec_ada()
    bench_run_suite(m, n, k, spec, 128, 2.52)
}

// Convenience: run benchmark on Hopper H100 (sm_90, 132 SMs, 1.83 GHz)
fn bench_hopper(m: i64, n: i64, k: i64) -> BenchSuiteResult with Div {
    let spec = sm_spec_hopper()
    bench_run_suite(m, n, k, spec, 132, 1.83)
}

// Speedup ratio: WMMA vs tiled baseline
fn bench_speedup_wmma_vs_tiled(suite: BenchSuiteResult) -> f64 with Div {
    let tiled = suite.results[BENCH_VARIANT_TILED as usize].roofline.achieved_gflops
    let wmma  = suite.results[BENCH_VARIANT_WMMA as usize].roofline.achieved_gflops
    if tiled > 0.0 { wmma / tiled } else { 0.0 }
}

// Speedup ratio: dbuf vs tiled baseline
fn bench_speedup_dbuf_vs_tiled(suite: BenchSuiteResult) -> f64 with Div {
    let tiled = suite.results[BENCH_VARIANT_TILED as usize].roofline.achieved_gflops
    let dbuf  = suite.results[BENCH_VARIANT_DBUF as usize].roofline.achieved_gflops
    if tiled > 0.0 { dbuf / tiled } else { 0.0 }
}

// Check if any variant exceeds target GFLOPS threshold
fn bench_any_exceeds_target(suite: BenchSuiteResult, target_gflops: f64) -> bool {
    var i: i64 = 0
    while i < BENCH_NUM_VARIANTS {
        if suite.results[i as usize].roofline.achieved_gflops >= target_gflops {
            return true
        }
        i = i + 1
    }
    false
}
