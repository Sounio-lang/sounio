        max_regs_per_thread: 255,
        max_smem_per_sm:     237568,
        max_smem_per_block:  237568,
        warp_size:           32,
        fp32_throughput:     256,
        fp16_throughput:     1024,
        int32_throughput:    128,
        mem_bandwidth_gb_s:  8000,
        l2_cache_kb:         131072,
    }
}

fn sm_spec_for_version(sm: i64) -> SmHardwareSpec {
    if sm <= 52 {
        sm_spec_maxwell()
    } else if sm <= 62 {
        sm_spec_pascal()
    } else if sm <= 72 {
        sm_spec_volta()
    } else if sm <= 75 {
        sm_spec_turing()
    } else if sm <= 80 {
        sm_spec_ampere_a100()
    } else if sm <= 87 {
        sm_spec_ampere_consumer()
    } else if sm <= 89 {
        sm_spec_ada()
    } else if sm <= 90 {
        sm_spec_hopper()
    } else {
        sm_spec_blackwell()
    }
}

fn sm_spec_default() -> SmHardwareSpec {
    sm_spec_ampere_a100()
}

// Estimated peak GFLOPs for a given SM spec, SM count, and clock frequency.
// Result = fp32_throughput * sm_count * clock_ghz (in GFLOPs total)
fn sm_spec_fp32_tflops(spec: SmHardwareSpec, sm_count: i64, clock_ghz: f32) -> f32 with Div {
    let throughput_f = spec.fp32_throughput as f32
    let sms_f        = sm_count as f32
    throughput_f * sms_f * clock_ghz
}

// ============================================================================
// Integer math helpers
// ============================================================================

fn prof_max_i64(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn prof_min_i64(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn prof_div_safe(a: i64, b: i64) -> i64 with Div {
    if b == 0 { 0 } else { a / b }
}

fn prof_div_safe_f(a: f32, b: f32) -> f32 with Div {
    if b == 0.0 { 0.0 } else { a / b }
}

// Integer ceiling division.
fn prof_ceil_div(a: i64, b: i64) -> i64 with Div {
    if b == 0 { 0 } else { (a + b - 1) / b }
}

fn prof_min_f32(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

fn prof_max_f32(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

// ============================================================================
// Instruction counting
// ============================================================================

// Classify one ProfGpuOpEntry into InstructionCounts and return updated counts.
fn prof_count_op(ic: InstructionCounts, op: ProfGpuOpEntry) -> InstructionCounts {
    if op.dead {
        return ic
    }
    let oc = op.opcode
    let new_total = ic.total_ops + 1

    // FP32 arithmetic
    if oc == PROF_OP_ADD || oc == PROF_OP_SUB || oc == PROF_OP_MUL || oc == PROF_OP_DIV {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops + 1,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // FMA counts as 2 FLOPs but 1 instruction; record in fp32_ops * 2 = 2 via special field
    if oc == PROF_OP_FMA {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops + 2,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Special math ops
    if oc == PROF_OP_SQRT || oc == PROF_OP_RSQRT || oc == PROF_OP_EXP ||
       oc == PROF_OP_LOG  || oc == PROF_OP_SIN   || oc == PROF_OP_COS {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops + 1,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Global memory loads
    if oc == PROF_OP_LOAD_GLOBAL {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads + 1,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Global memory stores
    if oc == PROF_OP_STORE_GLOBAL {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores + 1,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Shared memory loads
    if oc == PROF_OP_LOAD_SHARED {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads + 1,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Shared memory stores
    if oc == PROF_OP_STORE_SHARED {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores + 1,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Atomics
    if oc == PROF_OP_ATOMIC {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads + 1,
            mem_stores:    ic.mem_stores + 1,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops + 1,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Barriers
    if oc == PROF_OP_BARRIER {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops + 1,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Warp-level ops (shfl, vote, ballot)
    if oc == PROF_OP_SHFL || oc == PROF_OP_VOTE {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops + 1,
            total_ops:     new_total,
        }
    }

    // Branch and predicate set
    if oc == PROF_OP_BRANCH || oc == PROF_OP_SETP {
        return InstructionCounts {
            fp32_ops:      ic.fp32_ops,
            fp64_ops:      ic.fp64_ops,
            fp16_ops:      ic.fp16_ops,
            int_ops:       ic.int_ops,
            mem_loads:     ic.mem_loads,
            mem_stores:    ic.mem_stores,
            shared_loads:  ic.shared_loads,
            shared_stores: ic.shared_stores,
            atomic_ops:    ic.atomic_ops,
            special_ops:   ic.special_ops,
            branch_ops:    ic.branch_ops + 1,
            barrier_ops:   ic.barrier_ops,
            warp_ops:      ic.warp_ops,
            total_ops:     new_total,
        }
    }

    // Default: integer op
    InstructionCounts {
        fp32_ops:      ic.fp32_ops,
        fp64_ops:      ic.fp64_ops,
        fp16_ops:      ic.fp16_ops,
        int_ops:       ic.int_ops + 1,
        mem_loads:     ic.mem_loads,
        mem_stores:    ic.mem_stores,
        shared_loads:  ic.shared_loads,
        shared_stores: ic.shared_stores,
        atomic_ops:    ic.atomic_ops,
        special_ops:   ic.special_ops,
        branch_ops:    ic.branch_ops,
        barrier_ops:   ic.barrier_ops,
        warp_ops:      ic.warp_ops,
        total_ops:     new_total,
    }
}

// Merge two InstructionCounts by summing all fields.
fn prof_ic_merge(a: InstructionCounts, b: InstructionCounts) -> InstructionCounts {
    InstructionCounts {
        fp32_ops:      a.fp32_ops      + b.fp32_ops,
        fp64_ops:      a.fp64_ops      + b.fp64_ops,
        fp16_ops:      a.fp16_ops      + b.fp16_ops,
        int_ops:       a.int_ops       + b.int_ops,
        mem_loads:     a.mem_loads     + b.mem_loads,
        mem_stores:    a.mem_stores    + b.mem_stores,
        shared_loads:  a.shared_loads  + b.shared_loads,
        shared_stores: a.shared_stores + b.shared_stores,
        atomic_ops:    a.atomic_ops    + b.atomic_ops,
        special_ops:   a.special_ops   + b.special_ops,
        branch_ops:    a.branch_ops    + b.branch_ops,
        barrier_ops:   a.barrier_ops   + b.barrier_ops,
        warp_ops:      a.warp_ops      + b.warp_ops,
        total_ops:     a.total_ops     + b.total_ops,
    }
}

// Count all instructions in a single basic block.
fn prof_count_block(blk: ProfGpuBlockEntry) -> InstructionCounts {
    var ic = prof_ic_new()
    var i: i64 = 0
    while i < blk.op_count {
        ic = prof_count_op(ic, blk.ops[i as usize])
        i = i + 1
    }
    ic
}

// Count all instructions across all blocks of a kernel.
fn prof_count_kernel(k: ProfGpuKernelEntry) -> InstructionCounts {
    var ic = prof_ic_new()
    var b: i64 = 0
    while b < k.block_count {
        let blk_ic = prof_count_block(k.blocks[b as usize])
        ic = prof_ic_merge(ic, blk_ic)
        b = b + 1
    }
    ic
}

// ============================================================================
// Register pressure estimation
// ============================================================================

// Count the number of distinct destination register indices defined across all
// ops in a block.  Uses a simple bitmask covering indices 0..127.
fn prof_count_distinct_dsts_block(blk: ProfGpuBlockEntry) -> i64 {
    var seen: [bool; 512] = [false; 512]
    var count: i64 = 0
    var i: i64 = 0
    while i < blk.op_count {
        let d = blk.ops[i as usize].dst_idx
        if d >= 0 && d < 512 {
            if !seen[d as usize] {
                seen[d as usize] = true
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Rough register-per-thread estimate: peak distinct live values across blocks.
fn prof_regs_per_thread_estimate(k: ProfGpuKernelEntry) -> i64 {
    var peak: i64 = 0
    var b: i64 = 0
    while b < k.block_count {
        let dsts = prof_count_distinct_dsts_block(k.blocks[b as usize])
        if dsts > peak {
            peak = dsts
        }
        b = b + 1
    }
    // Clamp to plausible GPU register range [8, 255]
    if peak < 8  { peak = 8  }
    if peak > 255 { peak = 255 }
    peak
}

// ============================================================================
// Occupancy estimation
// ============================================================================

// Number of warps needed to cover threads_per_block threads.
fn prof_warps_from_threads(threads: i64) -> i64 with Div {
    prof_ceil_div(threads, 32)
}

// Maximum concurrent blocks limited by register file usage.
fn prof_blocks_from_regs(spec: SmHardwareSpec, regs_per_thread: i64, threads_per_block: i64) -> i64 with Div {
    let regs_per_block = regs_per_thread * threads_per_block
    let max_by_regs    = prof_div_safe(spec.max_regs_per_sm, regs_per_block)
    prof_min_i64(max_by_regs, spec.max_blocks_per_sm)
}

// Maximum concurrent blocks limited by shared memory.
fn prof_blocks_from_smem(spec: SmHardwareSpec, smem_per_block: i64) -> i64 with Div {
    if smem_per_block <= 0 {
        spec.max_blocks_per_sm
    } else {
        prof_div_safe(spec.max_smem_per_sm, smem_per_block)
    }
}

// Estimate theoretical occupancy given launch configuration.
fn prof_estimate_occupancy(
    spec: SmHardwareSpec,
    threads_per_block: i64,
    regs_per_thread: i64,
    smem_per_block: i64
) -> OccupancyEstimate with Div {
    let warps_per_block  = prof_warps_from_threads(threads_per_block)
    let max_warps_per_sm = prof_div_safe(spec.max_threads_per_sm, 32)

    // Blocks limited by register file
    let blocks_reg  = prof_blocks_from_regs(spec, regs_per_thread, threads_per_block)
    // Blocks limited by shared memory
    let blocks_smem = prof_blocks_from_smem(spec, smem_per_block)
    // Blocks limited by thread count
    let blocks_thd  = if threads_per_block > 0 {
        prof_div_safe(spec.max_threads_per_sm, threads_per_block)
    } else {
        spec.max_blocks_per_sm
    }
    let blocks_hw   = spec.max_blocks_per_sm

    // Determine the binding constraint
    let blocks_by_reg  = prof_min_i64(blocks_reg,  blocks_hw)
    let blocks_by_smem = prof_min_i64(blocks_smem, blocks_hw)
    let blocks_by_thd  = prof_min_i64(blocks_thd,  blocks_hw)

    // Find minimum and which factor caused it
    var active_blocks:  i64 = blocks_by_reg
    var limiting:       i64 = OCC_LIMIT_REGISTERS

    if blocks_by_smem < active_blocks {
        active_blocks = blocks_by_smem
        limiting      = OCC_LIMIT_SMEM
    }
    if blocks_by_thd < active_blocks {
        active_blocks = blocks_by_thd
        limiting      = OCC_LIMIT_THREAD_COUNT
    }
    if active_blocks > blocks_hw {
        active_blocks = blocks_hw
        limiting      = OCC_LIMIT_BLOCKS
    }

    let active_warps   = active_blocks * warps_per_block
    let clamped_warps  = prof_min_i64(active_warps, max_warps_per_sm)
    let occ_pct        = prof_div_safe(clamped_warps * 100, max_warps_per_sm)

    OccupancyEstimate {
        threads_per_block:    threads_per_block,
        registers_per_thread: regs_per_thread,
        smem_per_block:       smem_per_block,
        active_warps_per_sm:  clamped_warps,
        max_warps_per_sm:     max_warps_per_sm,
        occupancy_pct:        occ_pct,
        limiting_factor:      limiting,
    }
}

// ============================================================================
// Roofline model
// ============================================================================

// Compute arithmetic intensity: FLOPs per byte of global memory traffic.
// Assumes 4 bytes per f32 element for each global load/store.
fn prof_compute_intensity(ic: InstructionCounts, threads: i64) -> f32 with Div {
    let total_flops = ic.fp32_ops + ic.special_ops
    let mem_ops     = ic.mem_loads + ic.mem_stores
    let mem_bytes   = mem_ops * 4

    if mem_bytes == 0 {
        // No memory traffic: compute-bound by definition
        if total_flops > 0 { 1000.0 } else { 0.0 }
    } else {
        let flops_f = total_flops as f32
        let bytes_f = mem_bytes as f32
        prof_div_safe_f(flops_f, bytes_f)
    }
}

// Build a RooflinePoint from kernel statistics.
fn prof_roofline_point(
    spec: SmHardwareSpec,
    ic: InstructionCounts,
    threads_per_block: i64,
    blocks_per_sm: i64,
    occupancy: OccupancyEstimate
) -> RooflinePoint with Div {
    let intensity = prof_compute_intensity(ic, threads_per_block)

    // Peak memory bandwidth: spec gives GB/s for the whole device.
    // We use it as a device-level constant here.
    let peak_mem_bw   = spec.mem_bandwidth_gb_s as f32

    // Peak compute: fp32_throughput (FLOPs/SM/clk) * assume 1 GHz clock for normalization
    // This is a per-SM figure; scale to device elsewhere.
    let peak_compute  = spec.fp32_throughput as f32

    // Ridge point: the intensity at which compute and memory limits cross.
    // ridge = peak_compute_gflops_per_sec / peak_memory_gb_per_sec
    //       = FLOPs/SM/clk / (GB/s) — unit simplified for ratio comparison.
    let ridge = prof_div_safe_f(peak_compute, peak_mem_bw)

    let is_mem_bound  = intensity < ridge
    let is_comp_bound = !is_mem_bound

    // Achieved throughput estimate (normalized, not absolute device GFLOPs).
    // Scale by occupancy so idle SMs reduce estimated throughput.
    let occ_factor    = occupancy.occupancy_pct as f32 / 100.0
    let raw_achieved  = if is_mem_bound {
        // memory-bound: throughput limited by bandwidth
        intensity * peak_mem_bw * occ_factor
    } else {
        peak_compute * occ_factor
    }

    // Efficiency: fraction of theoretical peak actually used.
    let efficiency_f  = prof_div_safe_f(raw_achieved, peak_compute)
    let eff_pct_f     = efficiency_f * 100.0
    let eff_pct       = eff_pct_f as i64

    RooflinePoint {
        arithmetic_intensity:       intensity,
        achieved_throughput_gflops: raw_achieved,
        peak_memory_throughput:     peak_mem_bw,
        peak_compute_throughput:    peak_compute,
        is_memory_bound:            is_mem_bound,
        is_compute_bound:           is_comp_bound,
        efficiency_pct:             eff_pct,
    }
}

// ============================================================================
// Bottleneck classification
// ============================================================================

fn prof_classify_bottleneck(ic: InstructionCounts, roofline: RooflinePoint, occupancy: OccupancyEstimate) -> BottleneckInfo {
    let total_compute = ic.fp32_ops + ic.fp64_ops + ic.fp16_ops + ic.int_ops + ic.special_ops
    let total_mem     = ic.mem_loads + ic.mem_stores

    // Sync-dominated: barrier_ops exceed 10% of compute ops
    if total_compute > 0 && ic.barrier_ops * 10 > total_compute {
        return BottleneckInfo {
            tag:         BOTTLENECK_SYNC,
            severity:    0.8,
            description: 3,
        }
    }

    // Branch divergence: branch_ops exceed 20% of total
    if ic.total_ops > 0 && ic.branch_ops * 5 > ic.total_ops {
        return BottleneckInfo {
            tag:         BOTTLENECK_BRANCH_DIVERGENCE,
            severity:    0.7,
            description: 4,
        }
    }

    // Latency-bound: low occupancy with barriers present
    if occupancy.occupancy_pct < 25 && ic.barrier_ops > 0 {
        return BottleneckInfo {
            tag:         BOTTLENECK_LATENCY,
            severity:    0.6,
            description: 2,
        }
    }

    // Memory-bound: roofline says memory-bound AND mem ops significant
    if roofline.is_memory_bound && total_mem > total_compute / 4 {
        let sev_f = if total_mem > 0 && total_compute > 0 {
            let ratio_f = total_mem as f32 / (total_compute as f32 + total_mem as f32)
            if ratio_f > 1.0 { 1.0 } else { ratio_f }
        } else {
            0.5
        }
        return BottleneckInfo {
            tag:         BOTTLENECK_MEMORY,
            severity:    sev_f,
            description: 1,
        }
    }

    // Default: compute-bound
    let comp_sev = 1.0 - roofline.efficiency_pct as f32 / 100.0
    BottleneckInfo {
        tag:         BOTTLENECK_COMPUTE,
        severity:    if comp_sev < 0.0 { 0.0 } else if comp_sev > 1.0 { 1.0 } else { comp_sev },
        description: 0,
    }
}

// ============================================================================
// Peephole hint analysis
// ============================================================================

// Inspect a single op and optionally emit a peephole hint.
// Returns (has_hint, PeepholeHint).
fn prof_peephole_hint_for_op(op: ProfGpuOpEntry, op_idx: i64) -> (bool, PeepholeHint) {
    let oc = op.opcode

    // Division is expensive — suggest rcp.approx + mul
    if oc == PROF_OP_DIV {
        return (true, PeepholeHint {
            op_idx:   op_idx,
            hint_tag: HINT_DIV_USE_RCP,
            severity: 1,
        })
    }

    // sqrt followed by potential reciprocal use — suggest rsqrt.approx
    if oc == PROF_OP_SQRT {
        return (true, PeepholeHint {
            op_idx:   op_idx,
            hint_tag: HINT_SQRT_USE_RSQRT,
            severity: 1,
        })
    }

    // Branch op — flag potential divergence
    if oc == PROF_OP_BRANCH {
        return (true, PeepholeHint {
            op_idx:   op_idx,
            hint_tag: HINT_DIVERGENT_BRANCH,
            severity: 1,
        })
    }

    // Barrier op — flag as potential excessive sync (caller decides context)
    if oc == PROF_OP_BARRIER {
        return (true, PeepholeHint {
            op_idx:   op_idx,
            hint_tag: HINT_EXCESSIVE_SYNC,
            severity: 0,
        })
    }

    (false, prof_peephole_hint_zero())
}

// Scan a block's ops and accumulate peephole hints.
// Returns the updated hints array and new hint count.
fn prof_analyze_block_hints(blk: ProfGpuBlockEntry, hints: [PeepholeHint; 256], count: i64) -> ([PeepholeHint; 256], i64) {
    var out_hints = hints
    var out_count = count
    var i: i64 = 0
    while i < blk.op_count && out_count < 256 {
        let tup     = prof_peephole_hint_for_op(blk.ops[i as usize], i)
        let has     = tup.0
        let hint    = tup.1
        if has {
            out_hints[out_count as usize] = hint
            out_count = out_count + 1
        }
        i = i + 1
    }
    (out_hints, out_count)
}

// Analyze all blocks in a kernel for peephole hints.
fn prof_analyze_kernel_hints(k: ProfGpuKernelEntry) -> ([PeepholeHint; 256], i64) {
    var hints: [PeepholeHint; 256] = [prof_peephole_hint_zero(); 256]
    var count: i64 = 0
    var b: i64 = 0
    while b < k.block_count && count < 256 {
        let tup   = prof_analyze_block_hints(k.blocks[b as usize], hints, count)
        hints = tup.0
        count = tup.1
        b = b + 1
    }
    (hints, count)
}

// ============================================================================
// Full kernel analysis
// ============================================================================

fn prof_analyze_kernel(k: ProfGpuKernelEntry, spec: SmHardwareSpec) -> KernelMetrics with Div {
    let ic            = prof_count_kernel(k)
    let regs          = prof_regs_per_thread_estimate(k)
    let smem          = k.shared_mem_bytes
    let threads       = if k.max_threads_per_block > 0 { k.max_threads_per_block } else { 256 }
    let occupancy     = prof_estimate_occupancy(spec, threads, regs, smem)
    let active_blocks = prof_ceil_div(occupancy.active_warps_per_sm * 32, threads)
    let roofline      = prof_roofline_point(spec, ic, threads, active_blocks, occupancy)
    let bottleneck    = prof_classify_bottleneck(ic, roofline, occupancy)

    // Rough cycle estimate: total_ops per warp, warps serialized by SM capacity.
    // Effective IPC assumed ~0.5 accounting for memory latency.
    let warps_per_block = prof_warps_from_threads(threads)
    let total_warps     = warps_per_block * active_blocks
    let ops_per_warp    = prof_div_safe(ic.total_ops, prof_max_i64(total_warps, 1))
    let cycles          = ops_per_warp * 2  // ~2 cycles/op average with IPC=0.5

    // ms at 1 GHz: cycles / 1e6
    let ms = cycles as f32 / 1000000.0

    KernelMetrics {
        name:                 k.name,
        name_len:             k.name_len,
        instr_counts:         ic,
        occupancy:            occupancy,
        roofline:             roofline,
        bottleneck:           bottleneck,
        estimated_cycles:     cycles,
        estimated_ms_at_1ghz: ms,
    }
}

// Analyze all kernel entries in a module-level array.
fn prof_analyze_module_kernels(kernels: [ProfGpuKernelEntry; 64], count: i64, spec: SmHardwareSpec) -> ModuleMetrics with Div {
    var metrics: [KernelMetrics; 64] = [KernelMetrics {
        name:                 [0; 256],
        name_len:             0,
        instr_counts:         prof_ic_new(),
        occupancy:            prof_occupancy_zero(),
        roofline:             prof_roofline_zero(),
        bottleneck:           prof_bottleneck_zero(),
        estimated_cycles:     0,
        estimated_ms_at_1ghz: 0.0,
    }; 64]

    var total_fp32: i64 = 0
    var total_mem:  i64 = 0
    var i: i64 = 0

    while i < count {
        let km = prof_analyze_kernel(kernels[i as usize], spec)
        metrics[i as usize] = km
        total_fp32 = total_fp32 + km.instr_counts.fp32_ops
        total_mem  = total_mem  + (km.instr_counts.mem_loads + km.instr_counts.mem_stores) * 4
        i = i + 1
    }

    ModuleMetrics {
        kernels:         metrics,
        kernel_count:    count,
        total_fp32_ops:  total_fp32,
        total_mem_bytes: total_mem,
    }
}

// ============================================================================
// Report buffer helpers
// ============================================================================

// Append a fixed-width string slice (up to s_len bytes) to a report buffer.
fn prof_report_append_str(buf: [i8; 4096], buf_len: i64, s: [i8; 128], s_len: i64) -> ([i8; 4096], i64) {
    var out      = buf
    var out_len  = buf_len
    var i: i64   = 0
    while i < s_len && out_len < 4095 {
        out[out_len as usize] = s[i as usize]
        out_len = out_len + 1
        i = i + 1
    }
    (out, out_len)
}

// Append a single ASCII character (as i8) to the report buffer.
fn prof_report_append_char(buf: [i8; 4096], buf_len: i64, c: i8) -> ([i8; 4096], i64) {
    var out = buf
    var len = buf_len
    if len < 4095 {
        out[len as usize] = c
        len = len + 1
    }
    (out, len)
}

// Append the decimal representation of a non-negative i64 to the report buffer.
fn prof_report_append_i64(buf: [i8; 4096], buf_len: i64, v: i64) -> ([i8; 4096], i64) with Div {
    var out = buf
    var len = buf_len

    if v < 0 {
        let tup = prof_report_append_char(out, len, 45)  // '-'
        out = tup.0
        len = tup.1
    }

    var n = if v < 0 { 0 - v } else { v }

    if n == 0 {
        return prof_report_append_char(out, len, 48)  // '0'
    }

    // Find highest power of 10
    var divisor: i64 = 1
    var tmp = n
    while tmp >= 10 {
        divisor = divisor * 10
        tmp = tmp / 10
    }

    while divisor > 0 {
        let digit = n / divisor
        let tup   = prof_report_append_char(out, len, (48 + digit) as i8)
        out     = tup.0
        len     = tup.1
        n       = n % divisor
        divisor = divisor / 10
    }

    (out, len)
}

// Append a f32 value formatted as "X.YY" (two decimal places).
fn prof_report_append_f32(buf: [i8; 4096], buf_len: i64, v: f32) -> ([i8; 4096], i64) with Div {
    var out = buf
    var len = buf_len

    // Handle negative
    if v < 0.0 {
        let tup = prof_report_append_char(out, len, 45)  // '-'
        out = tup.0
        len = tup.1
    }
    let abs_v = if v < 0.0 { 0.0 - v } else { v }

    // Integer part
    let int_part  = abs_v as i64
    let tup1      = prof_report_append_i64(out, len, int_part)
    out = tup1.0
    len = tup1.1

    // Decimal point
    let tup2 = prof_report_append_char(out, len, 46)  // '.'
    out = tup2.0
    len = tup2.1

    // Two decimal places
    let frac      = abs_v - int_part as f32
    let frac100   = (frac * 100.0) as i64
    // Leading zero if < 10
    if frac100 < 10 {
        let tup3 = prof_report_append_char(out, len, 48)  // '0'
        out = tup3.0
        len = tup3.1
    }
    let tup4 = prof_report_append_i64(out, len, frac100)
    out = tup4.0
    len = tup4.1

    (out, len)
}

// Append a literal string expressed as individual i8 byte values.
// Convenience wrapper for short inline labels.
fn prof_report_append_label(buf: [i8; 4096], buf_len: i64, a: [i8; 128], alen: i64) -> ([i8; 4096], i64) {
    prof_report_append_str(buf, buf_len, a, alen)
}

// ============================================================================
// Bottleneck description helper
// ============================================================================

// Write a short bottleneck name into a fixed 128-byte buffer.
fn prof_bottleneck_label(tag: i64) -> ([i8; 128], i64) {
    var s: [i8; 128] = [0; 128]

    // "compute"
    if tag == BOTTLENECK_COMPUTE {
        s[0]  = 99   // c
        s[1]  = 111  // o
        s[2]  = 109  // m
        s[3]  = 112  // p
        s[4]  = 117  // u
        s[5]  = 116  // t
        s[6]  = 101  // e
        return (s, 7)
    }

    // "memory"
    if tag == BOTTLENECK_MEMORY {
        s[0] = 109  // m
        s[1] = 101  // e
        s[2] = 109  // m
        s[3] = 111  // o
        s[4] = 114  // r
        s[5] = 121  // y
        return (s, 6)
    }

    // "latency"
    if tag == BOTTLENECK_LATENCY {
        s[0] = 108  // l
        s[1] = 97   // a
        s[2] = 116  // t
        s[3] = 101  // e
        s[4] = 110  // n
        s[5] = 99   // c
        s[6] = 121  // y
        return (s, 7)
    }

    // "sync"
    if tag == BOTTLENECK_SYNC {
        s[0] = 115  // s
        s[1] = 121  // y
        s[2] = 110  // n
        s[3] = 99   // c
        return (s, 4)
    }

    // "divergence"
    s[0] = 100  // d
    s[1] = 105  // i
    s[2] = 118  // v
    s[3] = 101  // e
    s[4] = 114  // r
    s[5] = 103  // g
    s[6] = 101  // e
    s[7] = 110  // n
    s[8] = 99   // c
    s[9] = 101  // e
    (s, 10)
}

// ============================================================================
// Short literal labels (returned as [i8;128] / length pairs)
// ============================================================================

fn prof_lit_kernel_colon() -> ([i8; 128], i64) {
    // "Kernel: "
    var s: [i8; 128] = [0; 128]
    s[0] = 75   // K
    s[1] = 101  // e
    s[2] = 114  // r
    s[3] = 110  // n
    s[4] = 101  // e
    s[5] = 108  // l
    s[6] = 58   // :
    s[7] = 32   // space
    (s, 8)
}

fn prof_lit_newline() -> ([i8; 128], i64) {
    var s: [i8; 128] = [0; 128]
    s[0] = 10  // '\n'
    (s, 1)
}

fn prof_lit_two_spaces() -> ([i8; 128], i64) {
    var s: [i8; 128] = [0; 128]
    s[0] = 32  // ' '
    s[1] = 32  // ' '
    (s, 2)
}

fn prof_lit_fp32_colon() -> ([i8; 128], i64) {
    // "  FP32: "
    var s: [i8; 128] = [0; 128]
    s[0] = 32   // ' '
    s[1] = 32   // ' '
    s[2] = 70   // F
    s[3] = 80   // P
    s[4] = 51   // 3
    s[5] = 50   // 2
    s[6] = 58   // :
    s[7] = 32   // ' '
    (s, 8)
}

fn prof_lit_ops_mem_loads() -> ([i8; 128], i64) {
    // " ops, mem_loads: "
    var s: [i8; 128] = [0; 128]
    s[0]  = 32   // ' '
    s[1]  = 111  // o
    s[2]  = 112  // p
    s[3]  = 115  // s
    s[4]  = 44   // ,
    s[5]  = 32   // ' '
    s[6]  = 109  // m
    s[7]  = 101  // e
    s[8]  = 109  // m
    s[9]  = 95   // _
    s[10] = 108  // l
    s[11] = 111  // o
    s[12] = 97   // a
    s[13] = 100  // d
    s[14] = 115  // s
    s[15] = 58   // :
    s[16] = 32   // ' '
    (s, 17)
}

fn prof_lit_occupancy_colon() -> ([i8; 128], i64) {
    // ", occupancy: "
    var s: [i8; 128] = [0; 128]
    s[0]  = 44   // ,
    s[1]  = 32   // ' '
    s[2]  = 111  // o
    s[3]  = 99   // c
    s[4]  = 99   // c
    s[5]  = 117  // u
    s[6]  = 112  // p
    s[7]  = 97   // a
    s[8]  = 110  // n
    s[9]  = 99   // c
    s[10] = 121  // y
    s[11] = 58   // :
    s[12] = 32   // ' '
    (s, 13)
}

fn prof_lit_pct() -> ([i8; 128], i64) {
    var s: [i8; 128] = [0; 128]
    s[0] = 37   // %
    (s, 1)
}

fn prof_lit_bottleneck_colon() -> ([i8; 128], i64) {
    // "  Bottleneck: "
    var s: [i8; 128] = [0; 128]
    s[0]  = 32   // ' '
    s[1]  = 32   // ' '
    s[2]  = 66   // B
    s[3]  = 111  // o
    s[4]  = 116  // t
    s[5]  = 116  // t
    s[6]  = 108  // l
    s[7]  = 101  // e
    s[8]  = 110  // n
    s[9]  = 101  // e
    s[10] = 99   // c
    s[11] = 107  // k
    s[12] = 58   // :
    s[13] = 32   // ' '
    (s, 14)
}

fn prof_lit_estimated_ms() -> ([i8; 128], i64) {
    // "  EstMS@1GHz: "
    var s: [i8; 128] = [0; 128]
    s[0]  = 32   // ' '
    s[1]  = 32   // ' '
    s[2]  = 69   // E
    s[3]  = 115  // s
    s[4]  = 116  // t
    s[5]  = 77   // M
    s[6]  = 83   // S
    s[7]  = 64   // @
    s[8]  = 49   // 1
    s[9]  = 71   // G
    s[10] = 72   // H
    s[11] = 122  // z
    s[12] = 58   // :
    s[13] = 32   // ' '
    (s, 14)
}

fn prof_lit_module_report_header() -> ([i8; 128], i64) {
    // "=== Module GPU Profile ===\n"
    var s: [i8; 128] = [0; 128]
    s[0]  = 61   // =
    s[1]  = 61   // =
    s[2]  = 61   // =
    s[3]  = 32   // ' '
    s[4]  = 77   // M
    s[5]  = 111  // o
