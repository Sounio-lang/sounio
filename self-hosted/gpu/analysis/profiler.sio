    s[7]  = 117  // u
    s[8]  = 108  // l
    s[9]  = 101  // e
    s[10] = 32   // ' '
    s[11] = 71   // G
    s[12] = 80   // P
    s[13] = 85   // U
    s[14] = 32   // ' '
    s[15] = 80   // P
    s[16] = 114  // r
    s[17] = 111  // o
    s[18] = 102  // f
    s[19] = 105  // i
    s[20] = 108  // l
    s[21] = 101  // e
    s[22] = 32   // ' '
    s[23] = 61   // =
    s[24] = 61   // =
    s[25] = 61   // =
    s[26] = 10   // '\n'
    (s, 27)
}

fn prof_lit_total_fp32_colon() -> ([i8; 128], i64) {
    // "Total FP32 ops: "
