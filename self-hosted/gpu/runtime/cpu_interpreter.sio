// self-hosted/gpu/runtime/cpu_interpreter.sio
// CPU-side kernel interpreter for GpuKernelIr.
// Simulates thread execution on host arrays without GPU hardware.
//
// Phase 1: f32-only vec_add interpreter.
// Phase 2: can be extended to f64, i32, i64, and more opcodes.

// Register file for CPU simulation (fixed-size pools)
struct CpuRegF32 {
    data: [f32; 64],
}

struct CpuRegI32 {
    data: [i32; 64],
}

struct CpuRegI64 {
    data: [i64; 64],
}

struct CpuRegU32 {
    data: [u32; 64],
}

struct CpuRegU64 {
    data: [u64; 64],
}

struct CpuRegPred {
    data: [bool; 8],
}

fn cpu_reg_f32_new() -> CpuRegF32 {
    CpuRegF32 { data: [0.0; 64] }
}

fn cpu_reg_i32_new() -> CpuRegI32 {
    CpuRegI32 { data: [0; 64] }
}

fn cpu_reg_i64_new() -> CpuRegI64 {
    CpuRegI64 { data: [0; 64] }
}

fn cpu_reg_u32_new() -> CpuRegU32 {
    CpuRegU32 { data: [0; 64] }
}

fn cpu_reg_u64_new() -> CpuRegU64 {
    CpuRegU64 { data: [0; 64] }
}

fn cpu_reg_pred_new() -> CpuRegPred {
    CpuRegPred { data: [false; 8] }
}

// ============================================================================
// Simple CPU vec_add interpreter (f32 only)
//
// Simulates: c[tid] = a[tid] + b[tid] for tid = 0..n-1
//
// This is NOT a general GpuKernelIr interpreter — it is a hardcoded
// simulation of the vec_add pattern that validates the concept.
// ============================================================================

fn cpu_vec_add_f32(
    a: [f32; 1024],
    b: [f32; 1024],
    out: [f32; 1024],
    n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 {
            result[tid as usize] = a[tid as usize] + b[tid as usize]
        }
        tid = tid + 1
    }
    result
}

fn cpu_vec_sub_f32(
    a: [f32; 1024],
    b: [f32; 1024],
    out: [f32; 1024],
    n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 {
            result[tid as usize] = a[tid as usize] - b[tid as usize]
        }
        tid = tid + 1
    }
    result
}

fn cpu_vec_mul_f32(
    a: [f32; 1024],
    b: [f32; 1024],
    out: [f32; 1024],
    n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 {
            result[tid as usize] = a[tid as usize] * b[tid as usize]
        }
        tid = tid + 1
    }
    result
}

fn cpu_vec_div_f32(
    a: [f32; 1024],
    b: [f32; 1024],
    out: [f32; 1024],
    n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 {
            result[tid as usize] = a[tid as usize] / b[tid as usize]
        }
        tid = tid + 1
    }
    result
}

// ============================================================================
// Test harness
// ============================================================================

fn cpu_test_vec_add() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    b[0] = 10.0
    b[1] = 20.0
    b[2] = 30.0
    let result = cpu_vec_add_f32(a, b, out, 4)
    result[0] == 11.0 && result[1] == 22.0 && result[2] == 33.0 && result[3] == 0.0
}

fn cpu_test_vec_sub() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 20.0
    b[0] = 3.0
    b[1] = 5.0
    let result = cpu_vec_sub_f32(a, b, out, 2)
    result[0] == 7.0 && result[1] == 15.0
}

fn cpu_test_vec_mul() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 2.0
    a[1] = 3.0
    b[0] = 5.0
    b[1] = 7.0
    let result = cpu_vec_mul_f32(a, b, out, 2)
    result[0] == 10.0 && result[1] == 21.0
}

fn cpu_test_vec_div() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 21.0
    b[0] = 2.0
    b[1] = 3.0
    let result = cpu_vec_div_f32(a, b, out, 2)
    result[0] == 5.0 && result[1] == 7.0
}

fn cpu_interpreter_self_check() -> bool with Mut, Panic {
    let t1 = cpu_test_vec_add()
    let t2 = cpu_test_vec_sub()
    let t3 = cpu_test_vec_mul()
    let t4 = cpu_test_vec_div()
    t1 && t2 && t3 && t4
}

fn main() -> i32 with IO, Mut, Panic {
    let ok = cpu_interpreter_self_check()
    if ok {
        println("PASS cpu_interpreter_self_check")
        0
    } else {
        println("FAIL cpu_interpreter_self_check")
        1
    }
}
