// ============================================================================
// f32 test harness
// ============================================================================

fn cpu_test_vec_add_f32() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    b[0] = 10.0
    b[1] = 20.0
    b[2] = 30.0
    let result = cpu_vec_add_f32(a, b, out, 4)
    result[0] == 11.0 && result[1] == 22.0 && result[2] == 33.0 && result[3] == 0.0
}

fn cpu_test_vec_sub_f32() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 20.0
    b[0] = 3.0
    b[1] = 5.0
    let result = cpu_vec_sub_f32(a, b, out, 2)
    result[0] == 7.0 && result[1] == 15.0
}

fn cpu_test_vec_mul_f32() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 2.0
    a[1] = 3.0
    b[0] = 5.0
    b[1] = 7.0
    let result = cpu_vec_mul_f32(a, b, out, 2)
    result[0] == 10.0 && result[1] == 21.0
}

fn cpu_test_vec_div_f32() -> bool with Mut, Panic {
    var a: [f32; 1024] = [0.0; 1024]
    var b: [f32; 1024] = [0.0; 1024]
    var out: [f32; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 21.0
    b[0] = 2.0
    b[1] = 3.0
    let result = cpu_vec_div_f32(a, b, out, 2)
    result[0] == 5.0 && result[1] == 7.0
}

// ============================================================================
// f64 test harness
// ============================================================================

fn cpu_test_vec_add_f64() -> bool with Mut, Panic {
    var a: [f64; 1024] = [0.0; 1024]
    var b: [f64; 1024] = [0.0; 1024]
    var out: [f64; 1024] = [0.0; 1024]
    a[0] = 1.0
    a[1] = 2.0
    b[0] = 10.0
    b[1] = 20.0
    let result = cpu_vec_add_f64(a, b, out, 2)
    result[0] == 11.0 && result[1] == 22.0
}

fn cpu_test_vec_sub_f64() -> bool with Mut, Panic {
    var a: [f64; 1024] = [0.0; 1024]
    var b: [f64; 1024] = [0.0; 1024]
    var out: [f64; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 20.0
    b[0] = 3.0
    b[1] = 5.0
    let result = cpu_vec_sub_f64(a, b, out, 2)
    result[0] == 7.0 && result[1] == 15.0
}

fn cpu_test_vec_mul_f64() -> bool with Mut, Panic {
    var a: [f64; 1024] = [0.0; 1024]
    var b: [f64; 1024] = [0.0; 1024]
    var out: [f64; 1024] = [0.0; 1024]
    a[0] = 2.0
    a[1] = 3.0
    b[0] = 5.0
    b[1] = 7.0
    let result = cpu_vec_mul_f64(a, b, out, 2)
    result[0] == 10.0 && result[1] == 21.0
}

fn cpu_test_vec_div_f64() -> bool with Mut, Panic {
    var a: [f64; 1024] = [0.0; 1024]
    var b: [f64; 1024] = [0.0; 1024]
    var out: [f64; 1024] = [0.0; 1024]
    a[0] = 10.0
    a[1] = 21.0
    b[0] = 2.0
    b[1] = 3.0
    let result = cpu_vec_div_f64(a, b, out, 2)
    result[0] == 5.0 && result[1] == 7.0
}

// ============================================================================
// i32 test harness
// ============================================================================

fn cpu_test_vec_add_i32() -> bool with Mut, Panic {
    var a: [i32; 1024] = [0; 1024]
    var b: [i32; 1024] = [0; 1024]
    var out: [i32; 1024] = [0; 1024]
    a[0] = 1
    a[1] = 2
    a[2] = 3
    b[0] = 10
    b[1] = 20
    b[2] = 30
    let result = cpu_vec_add_i32(a, b, out, 4)
    result[0] == 11 && result[1] == 22 && result[2] == 33 && result[3] == 0
}

fn cpu_test_vec_sub_i32() -> bool with Mut, Panic {
    var a: [i32; 1024] = [0; 1024]
    var b: [i32; 1024] = [0; 1024]
    var out: [i32; 1024] = [0; 1024]
    a[0] = 10
    a[1] = 20
    b[0] = 3
    b[1] = 5
    let result = cpu_vec_sub_i32(a, b, out, 2)
    result[0] == 7 && result[1] == 15
}

fn cpu_test_vec_mul_i32() -> bool with Mut, Panic {
    var a: [i32; 1024] = [0; 1024]
    var b: [i32; 1024] = [0; 1024]
    var out: [i32; 1024] = [0; 1024]
    a[0] = 2
    a[1] = 3
    b[0] = 5
    b[1] = 7
    let result = cpu_vec_mul_i32(a, b, out, 2)
    result[0] == 10 && result[1] == 21
}

fn cpu_test_vec_div_i32() -> bool with Mut, Panic {
    var a: [i32; 1024] = [0; 1024]
    var b: [i32; 1024] = [0; 1024]
    var out: [i32; 1024] = [0; 1024]
    a[0] = 10
    a[1] = 21
    b[0] = 2
    b[1] = 3
    let result = cpu_vec_div_i32(a, b, out, 2)
    result[0] == 5 && result[1] == 7
}

// ============================================================================
// Self-check entry point
// ============================================================================

fn cpu_interpreter_self_check() -> bool with Mut, Panic {
    let t1 = cpu_test_vec_add_f32()
    let t2 = cpu_test_vec_sub_f32()
    let t3 = cpu_test_vec_mul_f32()
    let t4 = cpu_test_vec_div_f32()
    let t5 = cpu_test_vec_add_f64()
    let t6 = cpu_test_vec_sub_f64()
    let t7 = cpu_test_vec_mul_f64()
    let t8 = cpu_test_vec_div_f64()
    let t9 = cpu_test_vec_add_i32()
    let t10 = cpu_test_vec_sub_i32()
    let t11 = cpu_test_vec_mul_i32()
    let t12 = cpu_test_vec_div_i32()
    t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12
}

fn main() -> i32 with IO, Mut, Panic {
    let ok = cpu_interpreter_self_check()
    if ok {
        println("PASS cpu_interpreter_self_check")
        0
    } else {
        println("FAIL cpu_interpreter_self_check")
        1
    }
}
