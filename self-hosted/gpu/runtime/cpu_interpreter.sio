// self-hosted/gpu/runtime/cpu_interpreter.sio
// CPU-side kernel interpreter for GpuKernelIr.
// Simulates thread execution on host arrays without GPU hardware.
//
// Phase 1: hardcoded vector ops (f32)
// Phase 2: expanded to f64, i32

// ============================================================================
// f32 vector ops
// ============================================================================

fn cpu_vec_add_f32(
    a: [f32; 1024], b: [f32; 1024], out: [f32; 1024], n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 { result[tid as usize] = a[tid as usize] + b[tid as usize] }
        tid = tid + 1
    }
    result
}

fn cpu_vec_sub_f32(
    a: [f32; 1024], b: [f32; 1024], out: [f32; 1024], n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 { result[tid as usize] = a[tid as usize] - b[tid as usize] }
        tid = tid + 1
    }
    result
}

fn cpu_vec_mul_f32(
    a: [f32; 1024], b: [f32; 1024], out: [f32; 1024], n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 { result[tid as usize] = a[tid as usize] * b[tid as usize] }
        tid = tid + 1
    }
    result
}

fn cpu_vec_div_f32(
    a: [f32; 1024], b: [f32; 1024], out: [f32; 1024], n: i64
) -> [f32; 1024] with Mut, Panic {
    var result = out
    var tid: i64 = 0
    while tid < n {
        if tid < 1024 { result[tid as usize] = a[tid as usize] / b[tid as usize] }
        tid = tid + 1
    }
    result
}

