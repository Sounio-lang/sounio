// self-hosted::test_intern - Integration tests for string interning
//
// Run: souc test_intern.sio && ./test_intern

use intern

fn main() with IO {
    println("=== String Interning Tests ===")
    
    // Test 1: Basic interning
    println("\n1. Basic interning:")
    var interner = interner_new()
    let (interner, id1) = interner_intern(interner, "hello")
    let (interner, id2) = interner_intern(interner, "world")
    let (interner, id3) = interner_intern(interner, "hello")  // duplicate
    
    println("  'hello' -> id=" + int_to_string(id1))
    println("  'world' -> id=" + int_to_string(id2))
    println("  'hello' -> id=" + int_to_string(id3) + " (duplicate)")
    println("  Same ID for 'hello': " + bool_to_string(id1 == id3))
    
    // Test 2: Resolution
    println("\n2. Resolution:")
    let s1 = interner_resolve(interner, id1)
    let s2 = interner_resolve(interner, id2)
    println("  id=" + int_to_string(id1) + " -> '" + s1 + "'")
    println("  id=" + int_to_string(id2) + " -> '" + s2 + "'")
    
    // Test 3: Contains check
    println("\n3. Contains check:")
    let contains_hello = interner_contains(interner, "hello")
    let contains_foo = interner_contains(interner, "foo")
    println("  contains('hello'): " + bool_to_string(contains_hello))
    println("  contains('foo'): " + bool_to_string(contains_foo))
    
    // Test 4: Length and stats
    println("\n4. Statistics:")
    let count = interner_len(interner)
    println("  Unique strings: " + int_to_string(count))
    
    // Test 5: Many strings
    println("\n5. Batch interning:")
    var i: i64 = 0
    while i < 100 {
        let name = "var_" + int_to_string(i)
        let (new_interner, _) = interner_intern(interner, name)
        interner = new_interner
        i = i + 1
    }
    println("  Interned 100 unique identifiers")
    println("  Total unique: " + int_to_string(interner_len(interner)))
    
    println("\n=== All tests passed! ===")
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { -n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit  // '0' = 48
            result = char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

fn bool_to_string(b: bool) -> string with {
    if b { "true" } else { "false" }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    str_substr("0123456789", n, 1)
}
