// Smoke test: build minimal Windows PE executables using pe_coff.sio API
// Verifies MZ header, PE signature, machine type, section count.

module test_pe_smoke

use native::pe_coff::*
use native::target_policy::*

fn pe_read_u16(buf: [i8; 131072], off: i64) -> i64 {
    let lo = (buf[off as usize] as i64) & 255
    let hi = (buf[(off + 1) as usize] as i64) & 255
    lo + (hi << 8)
}

fn pe_read_u32(buf: [i8; 131072], off: i64) -> i64 {
    let b0 = (buf[off as usize] as i64) & 255
    let b1 = (buf[(off + 1) as usize] as i64) & 255
    let b2 = (buf[(off + 2) as usize] as i64) & 255
    let b3 = (buf[(off + 3) as usize] as i64) & 255
    b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
}

fn test_minimal_pe_structure() -> i64 with IO, Mut, Div, Panic {
    var code: [i8; 65536] = [0; 65536]
    code[0] = 0xB8 as i8   // mov eax, 42
    code[1] = 42 as i8
    code[2] = 0 as i8
    code[3] = 0 as i8
    code[4] = 0 as i8
    code[5] = 0xC3 as i8   // ret
    let code_len = 6

    var w = pe_writer_new()
    w = pe_set_entry_point(w, PE_SECTION_ALIGNMENT)
    w = pe_set_subsystem(w, PE_SUBSYSTEM_WINDOWS_CUI)

    let headers_size = pe_compute_headers_size(1)
    let text_raw_size = pe_file_align(code_len)
    w = pe_add_text_section(w, PE_SECTION_ALIGNMENT, code_len, headers_size, text_raw_size)
    w = pe_build_executable(w, code, code_len)

    // Verify MZ signature
    if pe_read_u16(w.buf, 0) != 23117 { return 1 }  // 0x5A4D = "MZ"

    // Verify PE signature at e_lfanew
    let pe_offset = pe_read_u32(w.buf, 60)
    if pe_read_u32(w.buf, pe_offset) != 17744 { return 3 }  // 0x4550 = "PE\0\0"

    // Verify machine = AMD64 (0x8664 = 34404)
    let machine = pe_read_u16(w.buf, pe_offset + 4)
    if machine != 34404 { return 5 }

    // Verify PE32+ magic (0x020B = 523)
    let opt_magic = pe_read_u16(w.buf, pe_offset + 24)
    if opt_magic != 523 { return 6 }

    if w.buf_len < 512 { return 7 }
    0
}

fn test_arm64_pe_structure() -> i64 with IO, Mut, Div, Panic {
    var code: [i8; 65536] = [0; 65536]
    code[0] = 0x1F as i8   // ARM64 NOP
    code[1] = 0x20 as i8
    code[2] = 0x03 as i8
    code[3] = 0xD5 as i8
    let code_len = 4

    var w = pe_writer_new_arm64()
    w = pe_set_entry_point(w, PE_SECTION_ALIGNMENT)
    w = pe_set_subsystem(w, PE_SUBSYSTEM_WINDOWS_CUI)

    let headers_size = pe_compute_headers_size(1)
    let text_raw_size = pe_file_align(code_len)
    w = pe_add_text_section(w, PE_SECTION_ALIGNMENT, code_len, headers_size, text_raw_size)
    w = pe_build_executable(w, code, code_len)

    if pe_read_u16(w.buf, 0) != 23117 { return 1 }  // MZ

    let pe_offset = pe_read_u32(w.buf, 60)
    let machine = pe_read_u16(w.buf, pe_offset + 4)
    if machine != 43620 { return 3 }
    0
}

fn test_pe_with_idata() -> i64 with IO, Mut, Div, Panic {
    var code: [i8; 65536] = [0; 65536]
    code[0] = 0xB8 as i8
    code[1] = 42 as i8
    code[2] = 0xC3 as i8
    let code_len = 3

    let text_rva = PE_SECTION_ALIGNMENT
    let text_raw_size = pe_file_align(code_len)
    let idata_rva = text_rva + pe_section_align(code_len)

    var w = pe_writer_new()
    w = pe_set_entry_point(w, text_rva)
    w = pe_set_subsystem(w, PE_SUBSYSTEM_WINDOWS_CUI)

    let headers_size = pe_compute_headers_size(2)
    w = pe_add_text_section(w, text_rva, code_len, headers_size, text_raw_size)

    let idata_total = 133
    let idata_raw_offset = headers_size + text_raw_size
    let idata_raw_size = pe_file_align(idata_total)
    w = pe_add_idata_section(w, idata_rva, idata_total, idata_raw_offset, idata_raw_size)

    w = pe_set_data_directory(w, PE_DIR_IMPORT, idata_rva, 40)
    w = pe_set_data_directory(w, PE_DIR_IAT, idata_rva + 64, 24)
    w = pe_build_executable(w, code, code_len)

    let pe_offset = pe_read_u32(w.buf, 60)
    let num_sections = pe_read_u16(w.buf, pe_offset + 6)
    if num_sections != 2 { return 1 }
    if w.buf_len < idata_raw_offset { return 2 }
    0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fail = 0

    let r1 = test_minimal_pe_structure()
    if r1 == 0 { println("PASS: x86_64 PE structure") }
    else { fail = fail + 1; print("FAIL: x86_64 PE structure = "); print_int(r1); println("") }

    let r2 = test_arm64_pe_structure()
    if r2 == 0 { println("PASS: ARM64 PE structure") }
    else { fail = fail + 1; print("FAIL: ARM64 PE structure = "); print_int(r2); println("") }

    let r3 = test_pe_with_idata()
    if r3 == 0 { println("PASS: PE with .idata section") }
    else { fail = fail + 1; print("FAIL: PE with .idata = "); print_int(r3); println("") }

    if fail > 0 { return 1 }
    println("PE smoke: 3/3 PASS")
    return 0
}
