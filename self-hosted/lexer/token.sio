// self-hosted::lexer::token — Token definitions for the Sounio self-hosted compiler
//
// TokenKind is a proper enum replacing i32 constants.
// Token carries position, text, and numeric values.
// Impl blocks provide constructors and classification.

module lexer::token

// ============================================================================
// TOKEN KIND ENUM
// ============================================================================

pub enum TokenKind {
    // --- Special ---
    Eof,
    Error,
    Newline,

    // --- Keywords: Core language ---
    Module,
    Import,
    Use,
    Export,
    Fn,
    Let,
    Var,
    Mut,
    Const,
    Type,
    Struct,
    Enum,
    Trait,
    Impl,
    Algebra,
    Study,
    Ontology,
    If,
    Else,
    Match,
    For,
    While,
    Loop,
    Break,
    Continue,
    Return,
    In,
    As,
    Where,
    Pub,
    SelfLower,
    SelfUpper,
    True,
    False,
    Is,
    Unsafe,
    Extern,
    Static,

    // --- Keywords: Units ---
    Unit,

    // --- Keywords: Effects and linear types ---
    Effect,
    Handler,
    Handle,
    With,
    Perform,
    Resume,
    Linear,
    Affine,
    Move,
    Copy,
    Drop,
    Ref,
    Dyn,
    Box,

    // --- Keywords: Async/GPU ---
    Async,
    Await,
    Spawn,
    Kernel,

    // --- Keywords: Epistemic/probabilistic ---
    Uncertain,
    Belief,
    Evidence,
    Confidence,
    Prior,
    Posterior,
    Likelihood,
    Entropy,
    Observe,
    Sample,
    Infer,
    Knowledge,
    Forgettable,      // keyword: Forgettable<T>     — ZD-annihilable type
    ExactlyPrivate,   // keyword: ExactlyPrivate<T>  — exact-privacy via ZD (G3/G4)
    Editable,         // keyword: Editable<T>        — ZD-local model editing (G5)
    CapabilityGated,  // keyword: CapabilityGated<T> — ZD-gated capability (G7)
    Composable,       // keyword: Composable<T>      — ZD-orthogonal model merge (G8)
    Audited,          // keyword: Audited<T>         — witness-bearing surgery (G9)
    Revivable,        // keyword: Revivable<T>       — time-bounded reversible surgery (G10)
    Interpretable,    // keyword: Interpretable<T>   — 168-ZD-basis canonical decomposition (AMI)
    Model,
    Policy,
    AcquisitionPolicy,
    AcquisitionPlan,
    RecoursePolicy,
    RecoursePlan,
    TransitionPolicy,
    TransitionPlan,
    MonitoringPolicy,
    ObservedTransition,
    RollbackCertificate,
    AlternativePolicy,
    AlternativeSet,
    AlternativeOption,
    DecisionPolicy,
    DeferralPolicy,
    PolicyLower,
    AcquisitionPolicyLower,
    RecoursePolicyLower,
    TransitionPolicyLower,
    TransitionProtocolLower,
    MonitoringPolicyLower,
    AlternativePolicyLower,
    AlternativeFrontierLower,
    DecisionPolicyLower,
    DeferralPolicyLower,
    ModelsLower,
    ValidationLower,
    AuditLower,
    Require,
    Objective,
    Strategy,
    Step,
    Level,
    Scope,
    Contest,
    Robust,
    Deferred,
    ContestLower,
    On,
    Route,
    MaxSteps,
    RollbackRoute,
    Valid,
    ValidUntil,
    ValidWhile,
    Derived,
    Computed,
    Measured,
    Super,
    Crate,

    // --- Identifiers and Literals ---
    Ident,
    IntLit,
    FloatLit,
    StringLit,
    CharLit,
    BoolLit,
    HexLit,
    BinLit,
    OctLit,

    // --- Operators: Single char ---
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Eq,
    Lt,
    Gt,
    Bang,
    Amp,
    Pipe,
    Caret,
    Tilde,
    Question,

    // --- Operators: Compound ---
    EqEq,
    BangEq,
    LtEq,
    GtEq,
    AmpAmp,
    PipePipe,
    Shl,
    Shr,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    Arrow,
    FatArrow,
    DotDot,
    DotDotEq,
    ColonColon,
    AmpBang,
    PlusPlus,
    PipeEq,
    ShlEq,
    ShrEq,
    PercentEq,
    CaretEq,
    AmpEq,
    LeftArrow,
    DotDotDot,
    PlusMinus,

    // --- Delimiters ---
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,

    // --- Punctuation ---
    Semi,
    Colon,
    Comma,
    Dot,
    At,
    Hash,
    Underscore,

    // --- Doc comments ---
    DocOuter,
    DocInner,
    DocBlockOuter,
    DocBlockInner,

    // --- Causal epistemic types ---
    Intervention,
    Counterfactual,
    Validated,
    Admissible,

    // --- Keywords: Annotation syntax (Sprint 27) ---
    DiffPrivate,
    DPBudget,
    CausalEffect,
    Aleatoric,
    PotentialOutcome,
    Proof,
    Lemma,
    Axiom,

    // --- Keywords: Session types ---
    Session,     // 'session'
    Chan,        // 'chan'
    Send,        // 'send' (session step)
    Recv,        // 'recv' (session step)
    Close,       // 'close' (session end)
    Dual,        // 'dual' (protocol duality)
}

// ============================================================================
// TOKEN STRUCTURE
// ============================================================================

pub struct Token {
    kind: TokenKind,
    start: i64,
    end: i64,
    line: i64,
    col: i64,
    text: [i8; 256],
    text_len: i64,
    int_value: i64,
    float_value: f64,
}

impl Token {
    pub fn new() -> Token {
        Token {
            kind: TokenKind::Eof,
            start: 0,
            end: 0,
            line: 1,
            col: 1,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    pub fn with_kind(kind: TokenKind, start: i64, end: i64, line: i64, col: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    pub fn eof(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Eof,
            start: pos,
            end: pos,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn error(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Error,
            start: pos,
            end: pos + 1,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn with_int(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: value,
            float_value: 0.0,
        }
    }

    fn with_float(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: f64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: value,
        }
    }
}

// ============================================================================
// TOKEN KIND CLASSIFICATION
// ============================================================================

pub fn tk_is_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Module => true,
        TokenKind::Import => true,
        TokenKind::Use => true,
        TokenKind::Export => true,
        TokenKind::Fn => true,
        TokenKind::Let => true,
        TokenKind::Var => true,
        TokenKind::Mut => true,
        TokenKind::Const => true,
        TokenKind::Type => true,
        TokenKind::Struct => true,
        TokenKind::Enum => true,
        TokenKind::Trait => true,
        TokenKind::Impl => true,
        TokenKind::Algebra => true,
        TokenKind::Study => true,
        TokenKind::Ontology => true,
        TokenKind::If => true,
        TokenKind::Else => true,
        TokenKind::Match => true,
        TokenKind::For => true,
        TokenKind::While => true,
        TokenKind::Loop => true,
        TokenKind::Break => true,
        TokenKind::Continue => true,
        TokenKind::Return => true,
        TokenKind::In => true,
        TokenKind::As => true,
        TokenKind::Where => true,
        TokenKind::Pub => true,
        TokenKind::SelfLower => true,
        TokenKind::SelfUpper => true,
        TokenKind::True => true,
        TokenKind::False => true,
        TokenKind::Is => true,
        TokenKind::Unsafe => true,
        TokenKind::Extern => true,
        TokenKind::Static => true,
        TokenKind::Unit => true,
        TokenKind::Effect => true,
        TokenKind::Handler => true,
        TokenKind::Handle => true,
        TokenKind::With => true,
        TokenKind::Perform => true,
        TokenKind::Resume => true,
        TokenKind::Linear => true,
        TokenKind::Affine => true,
        TokenKind::Move => true,
        TokenKind::Copy => true,
        TokenKind::Drop => true,
        TokenKind::Ref => true,
        TokenKind::Dyn => true,
        TokenKind::Box => true,
        TokenKind::Async => true,
        TokenKind::Await => true,
        TokenKind::Spawn => true,
        TokenKind::Kernel => true,
        TokenKind::Uncertain => true,
        TokenKind::Belief => true,
        TokenKind::Evidence => true,
        TokenKind::Confidence => true,
        TokenKind::Prior => true,
        TokenKind::Posterior => true,
        TokenKind::Likelihood => true,
        TokenKind::Entropy => true,
        TokenKind::Observe => true,
        TokenKind::Sample => true,
        TokenKind::Infer => true,
        TokenKind::Knowledge => true,
        TokenKind::Forgettable => true,
        TokenKind::ExactlyPrivate => true,
        TokenKind::Editable => true,
        TokenKind::CapabilityGated => true,
        TokenKind::Composable => true,
        TokenKind::Audited => true,
        TokenKind::Revivable => true,
        TokenKind::Interpretable => true,
        TokenKind::Policy => true,
        TokenKind::PolicyLower => true,
        TokenKind::Require => true,
        TokenKind::Contest => true,
        TokenKind::Robust => true,
        TokenKind::ContestLower => true,
        TokenKind::On => true,
        TokenKind::Intervention => true,
        TokenKind::Valid => true,
        TokenKind::ValidUntil => true,
        TokenKind::ValidWhile => true,
        TokenKind::Derived => true,
        TokenKind::Computed => true,
        TokenKind::Measured => true,
        TokenKind::Super => true,
        TokenKind::Crate => true,
        TokenKind::Model => true,
        TokenKind::AcquisitionPolicy => true,
        TokenKind::AcquisitionPlan => true,
        TokenKind::RecoursePolicy => true,
        TokenKind::RecoursePlan => true,
        TokenKind::TransitionPolicy => true,
        TokenKind::TransitionPlan => true,
        TokenKind::MonitoringPolicy => true,
        TokenKind::ObservedTransition => true,
        TokenKind::RollbackCertificate => true,
        TokenKind::AlternativePolicy => true,
        TokenKind::AlternativeSet => true,
        TokenKind::AlternativeOption => true,
        TokenKind::DecisionPolicy => true,
        TokenKind::DeferralPolicy => true,
        TokenKind::AcquisitionPolicyLower => true,
        TokenKind::RecoursePolicyLower => true,
        TokenKind::TransitionPolicyLower => true,
        TokenKind::TransitionProtocolLower => true,
        TokenKind::MonitoringPolicyLower => true,
        TokenKind::AlternativePolicyLower => true,
        TokenKind::AlternativeFrontierLower => true,
        TokenKind::DecisionPolicyLower => true,
        TokenKind::DeferralPolicyLower => true,
        TokenKind::ModelsLower => true,
        TokenKind::ValidationLower => true,
        TokenKind::AuditLower => true,
        TokenKind::Objective => true,
        TokenKind::Strategy => true,
        TokenKind::Step => true,
        TokenKind::Level => true,
        TokenKind::Scope => true,
        TokenKind::Deferred => true,
        TokenKind::Route => true,
        TokenKind::RollbackRoute => true,
        TokenKind::Admissible => true,
        TokenKind::DiffPrivate => true,
        TokenKind::DPBudget => true,
        TokenKind::CausalEffect => true,
        TokenKind::Aleatoric => true,
        TokenKind::PotentialOutcome => true,
        TokenKind::Proof => true,
        TokenKind::Lemma => true,
        TokenKind::Axiom => true,
        _ => tk_is_causal_keyword(kind),
    }
}

fn tk_is_causal_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Counterfactual => true,
        TokenKind::Validated => true,
        TokenKind::Session => true,
        TokenKind::Chan => true,
        TokenKind::Send => true,
        TokenKind::Recv => true,
        TokenKind::Close => true,
        TokenKind::Dual => true,
        TokenKind::MaxSteps => true,
        _ => false,
    }
}

fn tk_is_literal(kind: TokenKind) -> bool {
    match kind {
        TokenKind::IntLit => true,
        TokenKind::FloatLit => true,
        TokenKind::StringLit => true,
        TokenKind::CharLit => true,
        TokenKind::BoolLit => true,
        TokenKind::HexLit => true,
        TokenKind::BinLit => true,
        TokenKind::OctLit => true,
        _ => false,
    }
}

fn tk_is_operator(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Plus => true,
        TokenKind::Minus => true,
        TokenKind::Star => true,
        TokenKind::Slash => true,
        TokenKind::Percent => true,
        TokenKind::Eq => true,
        TokenKind::Lt => true,
        TokenKind::Gt => true,
        TokenKind::Bang => true,
        TokenKind::Amp => true,
        TokenKind::Pipe => true,
        TokenKind::Caret => true,
        TokenKind::Tilde => true,
        TokenKind::Question => true,
        TokenKind::EqEq => true,
        TokenKind::BangEq => true,
        TokenKind::LtEq => true,
        TokenKind::GtEq => true,
        TokenKind::AmpAmp => true,
        TokenKind::PipePipe => true,
        TokenKind::Shl => true,
        TokenKind::Shr => true,
        TokenKind::PlusEq => true,
        TokenKind::MinusEq => true,
        TokenKind::StarEq => true,
        TokenKind::SlashEq => true,
        TokenKind::Arrow => true,
        TokenKind::FatArrow => true,
        TokenKind::DotDot => true,
        TokenKind::DotDotEq => true,
        TokenKind::ColonColon => true,
        TokenKind::AmpBang => true,
        TokenKind::PlusPlus => true,
        TokenKind::PipeEq => true,
        TokenKind::ShlEq => true,
        TokenKind::ShrEq => true,
        TokenKind::PercentEq => true,
        TokenKind::CaretEq => true,
        TokenKind::AmpEq => true,
        TokenKind::LeftArrow => true,
        TokenKind::DotDotDot => true,
        TokenKind::PlusMinus => true,
        _ => false,
    }
}

fn tk_is_delimiter(kind: TokenKind) -> bool {
    match kind {
        TokenKind::LParen => true,
        TokenKind::RParen => true,
        TokenKind::LBrace => true,
        TokenKind::RBrace => true,
        TokenKind::LBracket => true,
        TokenKind::RBracket => true,
        _ => false,
    }
}

fn tk_is_punctuation(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Semi => true,
        TokenKind::Colon => true,
        TokenKind::Comma => true,
        TokenKind::Dot => true,
        TokenKind::At => true,
        TokenKind::Hash => true,
        TokenKind::Underscore => true,
        _ => false,
    }
}

// Contextual keywords: reserved words that must still be usable as ordinary
// identifiers in expression and pattern position.
//
// `policy`, `models`, `audit`, `validation`, `contest` and the `*_policy`
// family name domain concepts, so they collide with perfectly reasonable
// variable and parameter names. `expect_ident` already tolerates keywords (so
// parameter *declarations* parse), but the expression and pattern parsers each
// carried their own ad-hoc allow-list
// (`Ident || Knowledge || Close || Unit || Kernel || Var` and
// `Ident || Handle || Unit || Kernel`) which had grown one token at a time and
// never included this family. The result: `fn f(policy: P)` parsed, but
// `policy.x` and `let policy = ...` did not — see issue #1454.
//
// Every token listed here is an ITEM introducer only: items.sio dispatches on
// them at item position, and `parse_stmt` never dispatches items, so there is
// no ambiguity in expression or pattern position.
//
// `contest` is deliberately NOT in this list, even though it is lexed as
// `ContestLower` alongside the rest of the family: it has a genuine expression
// form (`contest { ... }`, exprs.sio) and appears in `at_expr_start`, so
// admitting it as an identifier would make `contest` in operand position
// ambiguous. It stays a hard keyword.
//
// `audit` is excluded for the same reason by a different mechanism: it is an
// INFIX operator (`expr audit name`, exprs.sio) inside the Pratt loop, which
// has no newline guard before its branch. Admitting it in primary position
// would not break that, but it would leave `audit` half-usable, so it stays a
// hard keyword until the operator itself is newline-guarded.
//
// Centralised here so the next contextual keyword is added in one place.
pub fn tk_is_contextual_ident(kind: TokenKind) -> bool {
    match kind {
        // `effect` and `handler` join for the same reason `study` and `scope`
        // did, and the evidence is the same shape: a sweep of every source under
        // self-hosted/ found 6 files the compiler could not read, each stopping
        // on an ordinary parameter named after a keyword —
        //     fn has_effect(a: &TypeArena, type_id: i64, effect: string)
        //     fn sigh_set_action(table: &! SighTable, ..., handler: i64)
        // Effect does have an item branch (items.sio:1146) and Handler has none;
        // neither is reachable from expression position, because items are parsed
        // only at top level.
        TokenKind::Effect => true,
        TokenKind::Handler => true,
        TokenKind::PolicyLower => true,
        TokenKind::AcquisitionPolicyLower => true,
        TokenKind::RecoursePolicyLower => true,
        TokenKind::TransitionPolicyLower => true,
        TokenKind::TransitionProtocolLower => true,
        TokenKind::MonitoringPolicyLower => true,
        TokenKind::AlternativePolicyLower => true,
        TokenKind::AlternativeFrontierLower => true,
        TokenKind::DecisionPolicyLower => true,
        TokenKind::DeferralPolicyLower => true,
        TokenKind::ModelsLower => true,
        TokenKind::ValidationLower => true,
        // Epistemic vocabulary that reads as ordinary nouns and appears in real
        // code as variable and parameter names. `level` in particular produced
        // 13 parse errors in stdlib/plot/line.sio, which made every importer of
        // that module look broken — including a clinical validation test that
        // was blamed for them.
        TokenKind::Level => true,
        TokenKind::Scope => true,
        TokenKind::Is => true,
        TokenKind::Study => true,
        _ => false,
    }
}

pub fn tk_is_doc_comment(kind: TokenKind) -> bool {
    match kind {
        TokenKind::DocOuter => true,
        TokenKind::DocInner => true,
        TokenKind::DocBlockOuter => true,
        TokenKind::DocBlockInner => true,
        _ => false,
    }
}

// Pratt parser precedence (for future use)
pub fn tk_precedence(kind: TokenKind) -> i64 {
    match kind {
        // Assignment operators are NOT expression operators.
        // They are handled by parse_expr_or_assign_stmt in the statement parser.
        // Logical OR = 2
        TokenKind::PipePipe => 2,
        // Logical AND = 3
        TokenKind::AmpAmp => 3,
        // Equality = 4
        TokenKind::EqEq => 4,
        TokenKind::BangEq => 4,
        // Comparison = 5
        TokenKind::Lt => 5,
        TokenKind::Gt => 5,
        TokenKind::LtEq => 5,
        TokenKind::GtEq => 5,
        // Bitwise OR = 6
        TokenKind::Pipe => 6,
        // Bitwise XOR = 7
        TokenKind::Caret => 7,
        // Bitwise AND = 8
        TokenKind::Amp => 8,
        // Shift = 9
        TokenKind::Shl => 9,
        TokenKind::Shr => 9,
        // Range = 10
        TokenKind::DotDot => 10,
        TokenKind::DotDotEq => 10,
        // Additive = 11
        TokenKind::Plus => 11,
        TokenKind::Minus => 11,
        TokenKind::PlusPlus => 11,
        // Multiplicative = 12
        TokenKind::Star => 12,
        TokenKind::Slash => 12,
        TokenKind::Percent => 12,
        // Cast = 13
        TokenKind::As => 13,
        // Unary = 13
        TokenKind::Bang => 13,
        TokenKind::Tilde => 13,
        // Call/Index = 14
        TokenKind::LParen => 14,
        TokenKind::LBracket => 14,
        TokenKind::Dot => 14,
        TokenKind::AuditLower => 14,
        // Assignment — MUST be 0 so Pratt loop breaks before consuming `=`.
        // Root cause of H4.3 binary-patch: compiled bytecode had prec=1 for Eq,
        // causing Pratt parser to swallow `=` as infix OpAdd.
        // Explicit arms as defensive documentation (default also returns 0).
        TokenKind::Eq => 0,
        TokenKind::PlusEq => 0,
        TokenKind::MinusEq => 0,
        TokenKind::StarEq => 0,
        TokenKind::SlashEq => 0,
        TokenKind::PercentEq => 0,
        _ => 0,
    }
}
