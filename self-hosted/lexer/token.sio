// self-hosted::lexer::token — Token definitions for the Sounio self-hosted compiler
//
// TokenKind is a proper enum replacing i32 constants.
// Token carries position, text, and numeric values.
// Impl blocks provide constructors and classification.

module lexer::token

// ============================================================================
// TOKEN KIND ENUM
// ============================================================================

enum TokenKind {
    // --- Special ---
    Eof,
    Error,
    Newline,

    // --- Keywords: Core language ---
    Module,
    Import,
    Use,
    Export,
    Fn,
    Let,
    Var,
    Mut,
    Const,
    Type,
    Struct,
    Enum,
    Trait,
    Impl,
    If,
    Else,
    Match,
    For,
    While,
    Loop,
    Break,
    Continue,
    Return,
    In,
    As,
    Where,
    Pub,
    SelfLower,
    SelfUpper,
    True,
    False,
    Is,
    Unsafe,
    Extern,
    Static,

    // --- Keywords: Units ---
    Unit,

    // --- Keywords: Effects and linear types ---
    Effect,
    Handler,
    Handle,
    With,
    Perform,
    Resume,
    Linear,
    Affine,
    Move,
    Copy,
    Drop,
    Ref,
    Dyn,
    Box,

    // --- Keywords: Async/GPU ---
    Async,
    Await,
    Spawn,
    Kernel,

    // --- Keywords: Epistemic/probabilistic ---
    Uncertain,
    Belief,
    Evidence,
    Confidence,
    Prior,
    Posterior,
    Likelihood,
    Entropy,
    Observe,
    Sample,
    Infer,
    Knowledge,
    Model,
    Policy,
    AcquisitionPolicy,
    AcquisitionPlan,
    RecoursePolicy,
    RecoursePlan,
    TransitionPolicy,
    TransitionPlan,
    AlternativePolicy,
    AlternativeSet,
    AlternativeOption,
    DecisionPolicy,
    DeferralPolicy,
    PolicyLower,
    AcquisitionPolicyLower,
    RecoursePolicyLower,
    TransitionPolicyLower,
    TransitionProtocolLower,
    AlternativePolicyLower,
    AlternativeFrontierLower,
    DecisionPolicyLower,
    DeferralPolicyLower,
    ModelsLower,
    ValidationLower,
    AuditLower,
    Require,
    Objective,
    Strategy,
    Step,
    Level,
    Scope,
    Contest,
    Robust,
    Deferred,
    ContestLower,
    On,
    Route,
    MaxSteps,
    RollbackRoute,
    Valid,
    ValidUntil,
    ValidWhile,
    Derived,
    Computed,
    Measured,
    Super,
    Crate,

    // --- Identifiers and Literals ---
    Ident,
    IntLit,
    FloatLit,
    StringLit,
    CharLit,
    BoolLit,
    HexLit,
    BinLit,
    OctLit,

    // --- Operators: Single char ---
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Eq,
    Lt,
    Gt,
    Bang,
    Amp,
    Pipe,
    Caret,
    Tilde,
    Question,

    // --- Operators: Compound ---
    EqEq,
    BangEq,
    LtEq,
    GtEq,
    AmpAmp,
    PipePipe,
    Shl,
    Shr,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    Arrow,
    FatArrow,
    DotDot,
    DotDotEq,
    ColonColon,
    AmpBang,
    PlusPlus,
    PipeEq,
    ShlEq,
    ShrEq,
    PercentEq,
    CaretEq,
    AmpEq,
    LeftArrow,
    DotDotDot,
    PlusMinus,

    // --- Delimiters ---
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,

    // --- Punctuation ---
    Semi,
    Colon,
    Comma,
    Dot,
    At,
    Hash,
    Underscore,

    // --- Doc comments ---
    DocOuter,
    DocInner,
    DocBlockOuter,
    DocBlockInner,

    // --- Causal epistemic types ---
    Intervention,
    Counterfactual,
    Validated,
    Admissible,

    // --- Keywords: Session types ---
    Session,     // 'session'
    Chan,        // 'chan'
    Send,        // 'send' (session step)
    Recv,        // 'recv' (session step)
    Close,       // 'close' (session end)
    Dual,        // 'dual' (protocol duality)
}

// ============================================================================
// TOKEN STRUCTURE
// ============================================================================

struct Token {
    kind: TokenKind,
    start: i64,
    end: i64,
    line: i64,
    col: i64,
    text: [i8; 256],
    text_len: i64,
    int_value: i64,
    float_value: f64,
}

impl Token {
    fn new() -> Token {
        Token {
            kind: TokenKind::Eof,
            start: 0,
            end: 0,
            line: 1,
            col: 1,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn with_kind(kind: TokenKind, start: i64, end: i64, line: i64, col: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn eof(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Eof,
            start: pos,
            end: pos,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn error(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Error,
            start: pos,
            end: pos + 1,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn with_int(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: value,
            float_value: 0.0,
        }
    }

    fn with_float(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: f64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: value,
        }
    }
}

// ============================================================================
// TOKEN KIND CLASSIFICATION
// ============================================================================

fn tk_is_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Module => true,
        TokenKind::Import => true,
        TokenKind::Use => true,
        TokenKind::Export => true,
        TokenKind::Fn => true,
        TokenKind::Let => true,
        TokenKind::Var => true,
        TokenKind::Mut => true,
        TokenKind::Const => true,
        TokenKind::Type => true,
        TokenKind::Struct => true,
        TokenKind::Enum => true,
        TokenKind::Trait => true,
        TokenKind::Impl => true,
        TokenKind::If => true,
        TokenKind::Else => true,
        TokenKind::Match => true,
        TokenKind::For => true,
        TokenKind::While => true,
        TokenKind::Loop => true,
        TokenKind::Break => true,
        TokenKind::Continue => true,
        TokenKind::Return => true,
        TokenKind::In => true,
        TokenKind::As => true,
        TokenKind::Where => true,
        TokenKind::Pub => true,
        TokenKind::SelfLower => true,
        TokenKind::SelfUpper => true,
        TokenKind::True => true,
        TokenKind::False => true,
        TokenKind::Is => true,
        TokenKind::Unsafe => true,
        TokenKind::Extern => true,
        TokenKind::Static => true,
        TokenKind::Unit => true,
        TokenKind::Effect => true,
        TokenKind::Handler => true,
        TokenKind::Handle => true,
        TokenKind::With => true,
        TokenKind::Perform => true,
        TokenKind::Resume => true,
        TokenKind::Linear => true,
        TokenKind::Affine => true,
        TokenKind::Move => true,
        TokenKind::Copy => true,
        TokenKind::Drop => true,
        TokenKind::Ref => true,
        TokenKind::Dyn => true,
        TokenKind::Box => true,
        TokenKind::Async => true,
        TokenKind::Await => true,
        TokenKind::Spawn => true,
        TokenKind::Kernel => true,
        TokenKind::Uncertain => true,
        TokenKind::Belief => true,
        TokenKind::Evidence => true,
        TokenKind::Confidence => true,
        TokenKind::Prior => true,
        TokenKind::Posterior => true,
        TokenKind::Likelihood => true,
        TokenKind::Entropy => true,
        TokenKind::Observe => true,
        TokenKind::Sample => true,
        TokenKind::Infer => true,
        TokenKind::Knowledge => true,
        TokenKind::Policy => true,
        TokenKind::PolicyLower => true,
        TokenKind::Require => true,
        TokenKind::Contest => true,
        TokenKind::Robust => true,
        TokenKind::ContestLower => true,
        TokenKind::On => true,
        TokenKind::Intervention => true,
        TokenKind::Valid => true,
        TokenKind::ValidUntil => true,
        TokenKind::ValidWhile => true,
        TokenKind::Derived => true,
        TokenKind::Computed => true,
        TokenKind::Measured => true,
        TokenKind::Super => true,
        TokenKind::Crate => true,
        _ => tk_is_causal_keyword(kind),
    }
}

fn tk_is_causal_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Counterfactual => true,
        TokenKind::Validated => true,
        TokenKind::Session => true,
        TokenKind::Chan => true,
        TokenKind::Send => true,
        TokenKind::Recv => true,
        TokenKind::Close => true,
        TokenKind::Dual => true,
        _ => false,
    }
}

fn tk_is_literal(kind: TokenKind) -> bool {
    match kind {
        TokenKind::IntLit => true,
        TokenKind::FloatLit => true,
        TokenKind::StringLit => true,
        TokenKind::CharLit => true,
        TokenKind::BoolLit => true,
        TokenKind::HexLit => true,
        TokenKind::BinLit => true,
        TokenKind::OctLit => true,
        _ => false,
    }
}

fn tk_is_operator(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Plus => true,
        TokenKind::Minus => true,
        TokenKind::Star => true,
        TokenKind::Slash => true,
        TokenKind::Percent => true,
        TokenKind::Eq => true,
        TokenKind::Lt => true,
        TokenKind::Gt => true,
        TokenKind::Bang => true,
        TokenKind::Amp => true,
        TokenKind::Pipe => true,
        TokenKind::Caret => true,
        TokenKind::Tilde => true,
        TokenKind::Question => true,
        TokenKind::EqEq => true,
        TokenKind::BangEq => true,
        TokenKind::LtEq => true,
        TokenKind::GtEq => true,
        TokenKind::AmpAmp => true,
        TokenKind::PipePipe => true,
        TokenKind::Shl => true,
        TokenKind::Shr => true,
        TokenKind::PlusEq => true,
        TokenKind::MinusEq => true,
        TokenKind::StarEq => true,
        TokenKind::SlashEq => true,
        TokenKind::Arrow => true,
        TokenKind::FatArrow => true,
        TokenKind::DotDot => true,
        TokenKind::DotDotEq => true,
        TokenKind::ColonColon => true,
        TokenKind::AmpBang => true,
        TokenKind::PlusPlus => true,
        TokenKind::PipeEq => true,
        TokenKind::ShlEq => true,
        TokenKind::ShrEq => true,
        TokenKind::PercentEq => true,
        TokenKind::CaretEq => true,
        TokenKind::AmpEq => true,
        TokenKind::LeftArrow => true,
        TokenKind::DotDotDot => true,
        TokenKind::PlusMinus => true,
        _ => false,
    }
}

fn tk_is_delimiter(kind: TokenKind) -> bool {
    match kind {
        TokenKind::LParen => true,
        TokenKind::RParen => true,
        TokenKind::LBrace => true,
        TokenKind::RBrace => true,
        TokenKind::LBracket => true,
        TokenKind::RBracket => true,
        _ => false,
    }
}

fn tk_is_punctuation(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Semi => true,
        TokenKind::Colon => true,
        TokenKind::Comma => true,
        TokenKind::Dot => true,
        TokenKind::At => true,
        TokenKind::Hash => true,
        TokenKind::Underscore => true,
        _ => false,
    }
}

fn tk_is_doc_comment(kind: TokenKind) -> bool {
    match kind {
        TokenKind::DocOuter => true,
        TokenKind::DocInner => true,
        TokenKind::DocBlockOuter => true,
        TokenKind::DocBlockInner => true,
        _ => false,
    }
}

// Pratt parser precedence (for future use)
fn tk_precedence(kind: TokenKind) -> i64 {
    match kind {
        // Assignment operators are NOT expression operators.
        // They are handled by parse_expr_or_assign_stmt in the statement parser.
        // Logical OR = 2
        TokenKind::PipePipe => 2,
        // Logical AND = 3
        TokenKind::AmpAmp => 3,
        // Equality = 4
        TokenKind::EqEq => 4,
        TokenKind::BangEq => 4,
        // Comparison = 5
        TokenKind::Lt => 5,
        TokenKind::Gt => 5,
        TokenKind::LtEq => 5,
        TokenKind::GtEq => 5,
        // Bitwise OR = 6
        TokenKind::Pipe => 6,
        // Bitwise XOR = 7
        TokenKind::Caret => 7,
        // Bitwise AND = 8
        TokenKind::Amp => 8,
        // Shift = 9
        TokenKind::Shl => 9,
        TokenKind::Shr => 9,
        // Range = 10
        TokenKind::DotDot => 10,
        TokenKind::DotDotEq => 10,
        // Additive = 11
        TokenKind::Plus => 11,
        TokenKind::Minus => 11,
        TokenKind::PlusPlus => 11,
        // Multiplicative = 12
        TokenKind::Star => 12,
        TokenKind::Slash => 12,
        TokenKind::Percent => 12,
        // Cast = 13
        TokenKind::As => 13,
        // Unary = 13
        TokenKind::Bang => 13,
        TokenKind::Tilde => 13,
        // Call/Index = 14
        TokenKind::LParen => 14,
        TokenKind::LBracket => 14,
        TokenKind::Dot => 14,
        TokenKind::AuditLower => 14,
        // Assignment — MUST be 0 so Pratt loop breaks before consuming `=`.
        // Root cause of H4.3 binary-patch: compiled bytecode had prec=1 for Eq,
        // causing Pratt parser to swallow `=` as infix OpAdd.
        // Explicit arms as defensive documentation (default also returns 0).
        TokenKind::Eq => 0,
        TokenKind::PlusEq => 0,
        TokenKind::MinusEq => 0,
        TokenKind::StarEq => 0,
        TokenKind::SlashEq => 0,
        TokenKind::PercentEq => 0,
        _ => 0,
    }
}
