// self-hosted::lexer::token — Token definitions for the Sounio self-hosted compiler
//
// All token kinds are i32 constants. Token text is stored as [i8; 256].
// This follows the proven pattern from stdlib/compiler/lexer.

// ============================================================================
// TOKEN KIND CONSTANTS
// ============================================================================

// --- Special (0-4) ---
let TK_EOF: i32 = 0
let TK_ERROR: i32 = 1
let TK_NEWLINE: i32 = 2

// --- Keywords: Core language (10-49) ---
let TK_MODULE: i32 = 10
let TK_IMPORT: i32 = 11
let TK_USE: i32 = 12
let TK_EXPORT: i32 = 13
let TK_FN: i32 = 14
let TK_LET: i32 = 15
let TK_VAR: i32 = 16
let TK_MUT: i32 = 17
let TK_CONST: i32 = 18
let TK_TYPE: i32 = 19
let TK_STRUCT: i32 = 20
let TK_ENUM: i32 = 21
let TK_TRAIT: i32 = 22
let TK_IMPL: i32 = 23
let TK_IF: i32 = 24
let TK_ELSE: i32 = 25
let TK_MATCH: i32 = 26
let TK_FOR: i32 = 27
let TK_WHILE: i32 = 28
let TK_LOOP: i32 = 29
let TK_BREAK: i32 = 30
let TK_CONTINUE: i32 = 31
let TK_RETURN: i32 = 32
let TK_IN: i32 = 33
let TK_AS: i32 = 34
let TK_WHERE: i32 = 35
let TK_PUB: i32 = 36
let TK_SELF_LOWER: i32 = 37
let TK_SELF_UPPER: i32 = 38
let TK_TRUE: i32 = 39
let TK_FALSE: i32 = 40
let TK_IS: i32 = 41
let TK_UNSAFE: i32 = 42
let TK_EXTERN: i32 = 43
let TK_STATIC: i32 = 44

// --- Keywords: Effects and linear types (50-69) ---
let TK_EFFECT: i32 = 50
let TK_HANDLER: i32 = 51
let TK_HANDLE: i32 = 52
let TK_WITH: i32 = 53
let TK_PERFORM: i32 = 54
let TK_RESUME: i32 = 55
let TK_LINEAR: i32 = 56
let TK_AFFINE: i32 = 57
let TK_MOVE: i32 = 58
let TK_COPY: i32 = 59
let TK_DROP: i32 = 60
let TK_REF: i32 = 61
let TK_DYN: i32 = 62
let TK_BOX: i32 = 63

// --- Keywords: Async/GPU (70-79) ---
let TK_ASYNC: i32 = 70
let TK_AWAIT: i32 = 71
let TK_SPAWN: i32 = 72
let TK_KERNEL: i32 = 73

// --- Keywords: Epistemic/probabilistic (80-99) ---
let TK_UNCERTAIN: i32 = 80
let TK_BELIEF: i32 = 81
let TK_EVIDENCE: i32 = 82
let TK_CONFIDENCE: i32 = 83
let TK_PRIOR: i32 = 84
let TK_POSTERIOR: i32 = 85
let TK_LIKELIHOOD: i32 = 86
let TK_ENTROPY: i32 = 87
let TK_OBSERVE: i32 = 88
let TK_SAMPLE: i32 = 89
let TK_INFER: i32 = 90
let TK_SUPER: i32 = 91
let TK_CRATE: i32 = 92

// --- Identifiers and Literals (100-119) ---
let TK_IDENT: i32 = 100
let TK_INT_LIT: i32 = 101
let TK_FLOAT_LIT: i32 = 102
let TK_STRING_LIT: i32 = 103
let TK_CHAR_LIT: i32 = 104
let TK_BOOL_LIT: i32 = 105
let TK_HEX_LIT: i32 = 106
let TK_BIN_LIT: i32 = 107
let TK_OCT_LIT: i32 = 108

// --- Operators: Single char (120-139) ---
let TK_PLUS: i32 = 120
let TK_MINUS: i32 = 121
let TK_STAR: i32 = 122
let TK_SLASH: i32 = 123
let TK_PERCENT: i32 = 124
let TK_EQ: i32 = 125
let TK_LT: i32 = 126
let TK_GT: i32 = 127
let TK_BANG: i32 = 128
let TK_AMP: i32 = 129
let TK_PIPE: i32 = 130
let TK_CARET: i32 = 131
let TK_TILDE: i32 = 132
let TK_QUESTION: i32 = 133

// --- Operators: Compound (140-169) ---
let TK_EQ_EQ: i32 = 140
let TK_BANG_EQ: i32 = 141
let TK_LT_EQ: i32 = 142
let TK_GT_EQ: i32 = 143
let TK_AMP_AMP: i32 = 144
let TK_PIPE_PIPE: i32 = 145
let TK_SHL: i32 = 146
let TK_SHR: i32 = 147
let TK_PLUS_EQ: i32 = 148
let TK_MINUS_EQ: i32 = 149
let TK_STAR_EQ: i32 = 150
let TK_SLASH_EQ: i32 = 151
let TK_ARROW: i32 = 152
let TK_FAT_ARROW: i32 = 153
let TK_DOT_DOT: i32 = 154
let TK_DOT_DOT_EQ: i32 = 155
let TK_COLON_COLON: i32 = 156
let TK_AMP_BANG: i32 = 157
let TK_PLUS_PLUS: i32 = 158
let TK_PIPE_EQ: i32 = 159
let TK_SHL_EQ: i32 = 160
let TK_SHR_EQ: i32 = 161
let TK_PERCENT_EQ: i32 = 162
let TK_CARET_EQ: i32 = 163
let TK_AMP_EQ: i32 = 164
let TK_LEFT_ARROW: i32 = 165
let TK_DOT_DOT_DOT: i32 = 166
let TK_PLUS_MINUS: i32 = 167

// --- Delimiters (170-179) ---
let TK_LPAREN: i32 = 170
let TK_RPAREN: i32 = 171
let TK_LBRACE: i32 = 172
let TK_RBRACE: i32 = 173
let TK_LBRACKET: i32 = 174
let TK_RBRACKET: i32 = 175

// --- Punctuation (180-189) ---
let TK_SEMI: i32 = 180
let TK_COLON: i32 = 181
let TK_COMMA: i32 = 182
let TK_DOT: i32 = 183
let TK_AT: i32 = 184
let TK_HASH: i32 = 185
let TK_UNDERSCORE: i32 = 186

// --- Doc comments (190-193) ---
let TK_DOC_OUTER: i32 = 190
let TK_DOC_INNER: i32 = 191
let TK_DOC_BLOCK_OUTER: i32 = 192
let TK_DOC_BLOCK_INNER: i32 = 193

// ============================================================================
// TOKEN STRUCTURE
// ============================================================================

struct Token {
    kind: i32,
    start: i64,
    end: i64,
    line: i64,
    col: i64,
    text: [i8; 256],
    text_len: i64,
    int_value: i64,
    float_value: f64,
}

fn token_new() -> Token {
    Token {
        kind: TK_EOF,
        start: 0,
        end: 0,
        line: 1,
        col: 1,
        text: [0; 256],
        text_len: 0,
        int_value: 0,
        float_value: 0.0,
    }
}

fn token_with_kind(kind: i32, start: i64, end: i64, line: i64, col: i64) -> Token {
    Token {
        kind: kind,
        start: start,
        end: end,
        line: line,
        col: col,
        text: [0; 256],
        text_len: 0,
        int_value: 0,
        float_value: 0.0,
    }
}

fn token_eof(pos: i64, line: i64, col: i64) -> Token {
    Token {
        kind: TK_EOF,
        start: pos,
        end: pos,
        line: line,
        col: col,
        text: [0; 256],
        text_len: 0,
        int_value: 0,
        float_value: 0.0,
    }
}

fn token_error(pos: i64, line: i64, col: i64) -> Token {
    Token {
        kind: TK_ERROR,
        start: pos,
        end: pos + 1,
        line: line,
        col: col,
        text: [0; 256],
        text_len: 0,
        int_value: 0,
        float_value: 0.0,
    }
}

// ============================================================================
// TOKEN KIND CLASSIFICATION
// ============================================================================

fn tk_is_keyword(kind: i32) -> bool {
    (kind >= 10 && kind < 100) && kind != TK_IDENT
}

fn tk_is_literal(kind: i32) -> bool {
    kind >= 101 && kind <= 108
}

fn tk_is_operator(kind: i32) -> bool {
    (kind >= 120 && kind < 170) || kind == TK_TILDE || kind == TK_QUESTION
}

fn tk_is_delimiter(kind: i32) -> bool {
    kind >= 170 && kind <= 175
}

fn tk_is_punctuation(kind: i32) -> bool {
    kind >= 180 && kind <= 186
}

fn tk_is_doc_comment(kind: i32) -> bool {
    kind >= 190 && kind <= 193
}

// Pratt parser precedence (for future use)
fn tk_precedence(kind: i32) -> i32 {
    // Assignment = 1
    if kind == TK_EQ || kind == TK_PLUS_EQ || kind == TK_MINUS_EQ ||
       kind == TK_STAR_EQ || kind == TK_SLASH_EQ { return 1 }
    // Logical OR = 2
    if kind == TK_PIPE_PIPE { return 2 }
    // Logical AND = 3
    if kind == TK_AMP_AMP { return 3 }
    // Equality = 4
    if kind == TK_EQ_EQ || kind == TK_BANG_EQ { return 4 }
    // Comparison = 5
    if kind == TK_LT || kind == TK_GT || kind == TK_LT_EQ || kind == TK_GT_EQ { return 5 }
    // Bitwise OR = 6
    if kind == TK_PIPE { return 6 }
    // Bitwise XOR = 7
    if kind == TK_CARET { return 7 }
    // Bitwise AND = 8
    if kind == TK_AMP { return 8 }
    // Shift = 9
    if kind == TK_SHL || kind == TK_SHR { return 9 }
    // Range = 10
    if kind == TK_DOT_DOT || kind == TK_DOT_DOT_EQ { return 10 }
    // Additive = 11
    if kind == TK_PLUS || kind == TK_MINUS || kind == TK_PLUS_PLUS { return 11 }
    // Multiplicative = 12
    if kind == TK_STAR || kind == TK_SLASH || kind == TK_PERCENT { return 12 }
    // Unary = 13
    if kind == TK_BANG || kind == TK_TILDE { return 13 }
    // Call/Index = 14
    if kind == TK_LPAREN || kind == TK_LBRACKET || kind == TK_DOT { return 14 }
    0
}
