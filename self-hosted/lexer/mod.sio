// self-hosted::lexer::mod — Main lexer entry point
//
// Tokenizes Sounio source code into a flat token array.
// Handles: identifiers, keywords, numbers (int/float/hex/bin/oct with suffixes),
// strings, chars, line comments, nestable block comments, doc comments,
// operators (max-munch), delimiters, and epistemic operators.
//
// Boot4-safe: no LexerState (moved to lexer::lex_full). Uses lex_source_to_globals.
// All token kinds use the TokenKind enum.

module lexer::mod

use lexer::cursor
use lexer::tables::*
use lexer::token::{TokenKind}
use parser::ast::*
use parser::parser::{parser_set_token_at}
use parser::mod::{parse_items_preloaded}

// Maximum tokens per file (1048576) — use literal not constant: boot4 leaves let globals at 0

// ============================================================================
// WHITESPACE AND COMMENT HANDLING
// ============================================================================

fn skip_whitespace(c: Cursor) -> Cursor with Mut, Div, Panic {
    // Scalar extraction avoids IS_SPTR=1 SRET corruption (boot4 bug).
    // Whitespace chars (space/tab/CR) are never newlines: col increments only.
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    while pos < source_len && is_whitespace(current) {
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

fn skip_line_comment(c: Cursor) -> Cursor with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    while pos < source_len && current != 10 as i8 {  // until '\n'
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

// Skip block comment with nesting support: /* ... /* inner */ ... */
struct SkipBlockResult {
    cursor: Cursor,
    unterminated: bool,
}

fn skip_block_comment(c: Cursor) -> SkipBlockResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current

    // Skip opening /* (advance_n(2) inline)
    var i: i64 = 0
    while i < 2 {
        if pos < source_len {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
        i = i + 1
    }

    var depth: i64 = 1
    while pos < source_len && depth > 0 {
        var peek1: i8 = 0 as i8
        if pos + 1 < source_len { peek1 = CURSOR_SOURCE[(pos + 1) as usize] }

        if current == 42 as i8 && peek1 == 47 as i8 {  // */
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            depth = depth - 1
        } else if current == 47 as i8 && peek1 == 42 as i8 {  // /* (nested)
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            depth = depth + 1
        } else {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    SkipBlockResult { cursor: result_cursor, unterminated: depth > 0 }
}

// ============================================================================
// IDENTIFIER AND KEYWORD SCANNING
// ============================================================================

fn scan_identifier(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    while pos < source_len && is_ident_continue(current) && text_idx < 256 {
        text[text_idx as usize] = current
        text_idx = text_idx + 1
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let kind = keyword_lookup(text, text_idx)
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

// ============================================================================
// NUMBER SCANNING (int, float, hex, bin, oct, suffixes)
// ============================================================================

fn scan_number(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var kind = TokenKind::IntLit

    // Check for 0x, 0b, 0o prefixes
    if current == 48 as i8 {  // '0'
        var next: i8 = 0 as i8
        if pos + 1 < source_len { next = CURSOR_SOURCE[(pos + 1) as usize] }
        if next == 120 as i8 || next == 88 as i8 {  // 'x' or 'X'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && is_hex_digit(current) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            while pos < source_len && (is_hex_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::HexLit
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
        if next == 98 as i8 || next == 66 as i8 {  // 'b' or 'B'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_bin_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::BinLit
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
        if next == 111 as i8 || next == 79 as i8 {  // 'o' or 'O'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_oct_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::OctLit
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
    }

    // Decimal digits (with underscore separators)
    while pos < source_len && (is_digit(current) || current == 95 as i8) {
        col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    // Check for decimal point (but not ".." range)
    if pos < source_len && current == 46 as i8 {  // '.'
        var after_dot: i8 = 0 as i8
        if pos + 1 < source_len { after_dot = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_digit(after_dot) {
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::FloatLit
        }
    }

    // Scientific notation: e/E followed by optional +/- and digits
    if pos < source_len && (current == 101 as i8 || current == 69 as i8) {  // 'e' or 'E'
        var after_e: i8 = 0 as i8
        if pos + 1 < source_len { after_e = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_digit(after_e) || after_e == 43 as i8 || after_e == 45 as i8 {
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if pos < source_len && (current == 43 as i8 || current == 45 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            while pos < source_len && is_digit(current) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::FloatLit
        }
    }

    // Numeric suffix
    let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    let suf = skip_numeric_suffix(tmp_c)
    pos = suf.pos; col = suf.col; line = suf.line; current = suf.current

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, end)
}

fn skip_numeric_suffix(c: Cursor) -> Cursor with Mut, Div, Panic {
    // Scalar-only: no Cursor struct passing. Numeric suffixes have no newlines.
    let pos0: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    let col0: i64 = c.col

    if pos0 >= source_len {
        return Cursor { source_len: source_len, pos: pos0, line: line, col: col0, current: c.current }
    }

    let ch: i8 = c.current
    var n1: i8 = 0 as i8
    var n2: i8 = 0 as i8
    if pos0 + 1 < source_len { n1 = CURSOR_SOURCE[(pos0 + 1) as usize] }
    if pos0 + 2 < source_len { n2 = CURSOR_SOURCE[(pos0 + 2) as usize] }

    var skip: i64 = 0
    if ch == 102 as i8 {  // 'f'
        if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }       // "f32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }  // "f64"
    }
    if ch == 105 as i8 {  // 'i'
        if n1 == 56 as i8 { skip = 2 }                                  // "i8"
        else if n1 == 49 as i8 && n2 == 54 as i8 { skip = 3 }          // "i16"
        else if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }          // "i32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }          // "i64"
    }
    if ch == 117 as i8 {  // 'u'
        if n1 == 56 as i8 { skip = 2 }                                  // "u8"
        else if n1 == 49 as i8 && n2 == 54 as i8 { skip = 3 }          // "u16"
        else if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }          // "u32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }          // "u64"
    }

    let pos: i64 = pos0 + skip
    let col: i64 = col0 + skip
    var current: i8 = 0 as i8
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

// ============================================================================
// STRING SCANNING (with escape processing)
// ============================================================================

fn scan_string(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    // Skip opening '"'
    if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
    pos = pos + 1
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }

    while pos < source_len && current != 34 as i8 && text_idx < 255 {  // '"'
        if current == 92 as i8 {  // backslash
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if pos < source_len {
                let esc: i8 = current
                if esc == 110 as i8 { text[text_idx as usize] = 10 as i8 }       // \n -> LF
                else if esc == 116 as i8 { text[text_idx as usize] = 9 as i8 }   // \t -> TAB
                else if esc == 114 as i8 { text[text_idx as usize] = 13 as i8 }  // \r -> CR
                else if esc == 92 as i8 { text[text_idx as usize] = 92 as i8 }   // \\ -> backslash
                else if esc == 34 as i8 { text[text_idx as usize] = 34 as i8 }   // \" -> quote
                else if esc == 48 as i8 { text[text_idx as usize] = 0 as i8 }    // \0 -> null
                else { text[text_idx as usize] = esc }
                text_idx = text_idx + 1
                if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
                pos = pos + 1
                if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
        } else {
            text[text_idx as usize] = current
            text_idx = text_idx + 1
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    var unterminated = true
    if pos < source_len && current == 34 as i8 {
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        unterminated = false
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    if unterminated {
        ScanResult::with_text(result_cursor, TokenKind::Error, start, end, text, text_idx)
    } else {
        ScanResult::with_text(result_cursor, TokenKind::StringLit, start, end, text, text_idx)
    }
}

// ============================================================================
// CHAR LITERAL SCANNING
// ============================================================================

fn scan_char_literal(c: Cursor) -> ScanResult with Mut, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos

    // Skip opening '\''
    if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
    pos = pos + 1
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }

    // Handle escape sequence
    if pos < source_len && current == 92 as i8 {  // backslash
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        if pos < source_len {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    } else if pos < source_len {
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    // Expect closing quote
    if pos < source_len && current == 39 as i8 {  // '\''
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, TokenKind::CharLit, start, end)
}

// ============================================================================
// DOC COMMENT SCANNING
// ============================================================================

fn scan_doc_comment_line(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocOuter

    if is_inner { kind = TokenKind::DocInner }

    // Skip //! or ///  (advance_n(3) inline, no newlines in // prefix)
    var i: i64 = 0
    while i < 3 {
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        i = i + 1
    }

    while pos < source_len && current != 10 as i8 && text_idx < 256 {
        text[text_idx as usize] = current
        text_idx = text_idx + 1
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

fn scan_doc_comment_block(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocBlockOuter

    if is_inner { kind = TokenKind::DocBlockInner }

    // Skip /** or /*!  (advance_n(3) inline)
    var i: i64 = 0
    while i < 3 {
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        i = i + 1
    }

    var done = false
    while pos < source_len && text_idx < 256 && !done {
        var peek1: i8 = 0 as i8
        if pos + 1 < source_len { peek1 = CURSOR_SOURCE[(pos + 1) as usize] }
        if current == 42 as i8 && peek1 == 47 as i8 {  // */
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            done = true
        } else {
            text[text_idx as usize] = current
            text_idx = text_idx + 1
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

// ============================================================================
// SOURCEFILE LOADING API (boot4-safe: scalar returns, items path)
// ============================================================================
// NOTE: pub fn lex(source, source_len, file_id) -> LexerState has been moved
// to lexer::lex_full to keep this module free of the 8MB LexerState frame.
// Tests that import lex() should use lexer::lex_full instead.

var SOURCEFILE_TRACE: i64 = 0

pub fn sourcefile_trace_enable() with Mut {
    SOURCEFILE_TRACE = 1
}

// Runs the full lexer over CURSOR_SOURCE[0..source_len], emitting all tokens
// via parser_set_token_at() only — no LexerState or token array allocation.
// CURSOR_SOURCE must be populated before calling (e.g. by lex_file_to_globals).
// Returns the total number of tokens emitted (including the EOF token).
pub fn lex_source_to_globals(source_len: i64) -> i64 with Mut, Div, Panic {
    var n: i64 = source_len
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }
    CURSOR_SOURCE_LEN = n
    var first_byte: i8 = 0 as i8
    if n > 0 { first_byte = CURSOR_SOURCE[0] }
    var cur: Cursor = Cursor {
        source_len: n,
        pos: 0,
        line: 1,
        col: 1,
        current: first_byte,
    }
    var tc: i64 = 0

    while !cur.is_eof() {
        let ch = cur.current

        if is_whitespace(ch) {
            cur = skip_whitespace(cur)
            continue
        }

        if ch == 10 {
            cur = cur.advance()
            continue
        }

        if ch == 47 {
            let next = cur.peek()
            if next == 47 {
                let third = cur.peek_n(2)
                if third == 47 && cur.peek_n(3) != 47 {
                    let result = scan_doc_comment_line(cur, false)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 1048576 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                if third == 33 {
                    let result = scan_doc_comment_line(cur, true)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 1048576 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                cur = skip_line_comment(cur)
                continue
            }
            if next == 42 {
                let third = cur.peek_n(2)
                if third == 42 && cur.peek_n(3) != 47 {
                    let result = scan_doc_comment_block(cur, false)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 1048576 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                if third == 33 {
                    let result = scan_doc_comment_block(cur, true)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 1048576 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                let block_result = skip_block_comment(cur)
                cur = block_result.cursor
                continue
            }
        }

        if ch == 34 {
            let line = cur.line
            let col = cur.col
            let result = scan_string(cur)
            cur = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 39 {
            let line = cur.line
            let col = cur.col
            let result = scan_char_literal(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_digit(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_number(cur)
            cur = result.cursor
            let nv = parse_numeric(result.start, result.end, result.kind)
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if nv.is_float {
                tok.float_value = nv.float_val
            } else {
                tok.int_value = nv.int_val
            }
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_ident_start(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_identifier(cur)
            cur = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 46 {
            let next = cur.peek()
            if next == 46 {
                let line = cur.line
                let col = cur.col
                let result = scan_operator(cur)
                cur = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if tc < 1048576 {
                    parser_set_token_at(tc, tok)
                    tc = tc + 1
                }
                continue
            }
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 58 {
            let next = cur.peek()
            if next == 58 {
                let line = cur.line
                let col = cur.col
                let result = scan_operator(cur)
                cur = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if tc < 1048576 {
                    parser_set_token_at(tc, tok)
                    tc = tc + 1
                }
                continue
            }
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_operator_start(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_operator(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_delimiter(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_delimiter(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_punctuation(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 1048576 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        cur = cur.advance()
    }

    let eof_tok = Token::eof(cur.pos, cur.line, cur.col)
    if tc < 1048576 {
        parser_set_token_at(tc, eof_tok)
        tc = tc + 1
    }
    tc
}

// Loads a .sio file directly into CURSOR_SOURCE, then lexes it to globals.
// Returns the token count. Frame is tiny: file pointer + a few scalars.
pub fn lex_file_to_globals(path: string) -> i64 with IO, Mut, Div, Panic {
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_to_globals_enter\n") }
    let size = file_size(path)
    let data = read_file(path)
    var n: i64 = size
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }
    var ci: i64 = 0
    while ci < n {
        CURSOR_SOURCE[ci as usize] = data[ci as usize]
        ci = ci + 1
    }
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_to_globals_buf_ok\n") }
    lex_source_to_globals(n)
}

// Load a .sio source file, lex it, and parse its items.
// Returns Option<Box<ItemList>> (1 slot) — avoids IS_SPTR=4 Program struct returns.
// Uses lex_file_to_globals to keep the frame tiny (no LexerState on stack).
pub fn lex_file_parse_items(path: string) -> Option<Box<ItemList>> with IO, Mut, Div, Panic, Alloc {
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_parse_items_enter\n") }
    let tc = lex_file_to_globals(path)
    if SOURCEFILE_TRACE == 1 { print("trace=lex_ok\n") }
    let items = parse_items_preloaded(tc)
    if SOURCEFILE_TRACE == 1 { print("trace=parse_ok\n") }
    items
}
