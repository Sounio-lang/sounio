// self-hosted::lexer::mod — Main lexer entry point
//
// Tokenizes Sounio source code into a flat token array.
// Handles: identifiers, keywords, numbers (int/float/hex/bin/oct with suffixes),
// strings, chars, line comments, nestable block comments, doc comments,
// operators (max-munch), delimiters, and epistemic operators.
//
// Boot4-safe: no LexerState (moved to lexer::lex_full). Uses lex_source_to_globals.
// All token kinds use the TokenKind enum.

module lexer::mod

use lexer::cursor::*
use lexer::numparse::*
use lexer::tables::*
use lexer::token::{TokenKind}
use parser::ast::*
use parser::parser::{parser_set_token_at, parser_set_token_flat, parser_set_token_int_value, parser_set_token_scalar, parser_set_last_errors}
use parser::mod::{parse_items_preloaded}

// Maximum tokens per file (2097152) — use literal not constant: boot4 leaves let globals at 0.
//
// HISTORICAL DEFECT (fixed 2026-08-17): when tc reached the table size, emits
// were silently skipped (parser_set_token_* no-ops past the wall) while the
// lexer kept walking source. The returned token_count could still grow, and
// out-of-range reads synthesized Eof — so the parser blamed an innocent line
// that never changed. That is success-by-silence: the compiler discarded its
// own input and lied about where the failure was. Same sin class as fabricating
// a zero for unimplemented extern "C" (E219). Refusal is mandatory; raising the
// ceiling without refusal only moves the lie.

// LEXER_TOKEN_OVERFLOW: 0 = ok, 1 = token table full, 2 = source byte buffer full
var LEXER_TOKEN_OVERFLOW: i64 = 0
var LEXER_TOKEN_OVERFLOW_LINE: i64 = 0
var LEXER_TOKEN_OVERFLOW_COL: i64 = 0
var LEXER_TOKEN_OVERFLOW_BYTE: i64 = 0

pub fn lexer_reset_token_overflow() with Mut {
    LEXER_TOKEN_OVERFLOW = 0
    LEXER_TOKEN_OVERFLOW_LINE = 0
    LEXER_TOKEN_OVERFLOW_COL = 0
    LEXER_TOKEN_OVERFLOW_BYTE = 0
}

pub fn lexer_token_overflow_kind() -> i64 {
    LEXER_TOKEN_OVERFLOW
}

pub fn lexer_token_overflow_line() -> i64 {
    LEXER_TOKEN_OVERFLOW_LINE
}

pub fn lexer_token_overflow_col() -> i64 {
    LEXER_TOKEN_OVERFLOW_COL
}

pub fn lexer_token_overflow_byte() -> i64 {
    LEXER_TOKEN_OVERFLOW_BYTE
}

// Record overflow once (first site wins — that is the real cause).
fn lexer_mark_token_overflow(line: i64, col: i64, byte_pos: i64, kind: i64) with Mut {
    if LEXER_TOKEN_OVERFLOW == 0 {
        LEXER_TOKEN_OVERFLOW = kind
        LEXER_TOKEN_OVERFLOW_LINE = line
        LEXER_TOKEN_OVERFLOW_COL = col
        LEXER_TOKEN_OVERFLOW_BYTE = byte_pos
    }
}

// Push one flat token. Returns new tc, or -1 if the table is full (overflow marked).
// Capacity 2097152 is the array length; the last slot must remain available for Eof
// only when we finish cleanly — any content emit at tc >= 2097152 is refusal.
fn lexer_push_flat(tc: i64, kind: i64, start: i64, end: i64, line: i64, col: i64, ival: i64) -> i64 with Mut, Panic {
    if tc >= 2097152 {
        lexer_mark_token_overflow(line, col, start, 1)
        return 0 - 1
    }
    parser_set_token_flat(tc, kind, start, end, line, col, ival)
    tc + 1
}

// Print E229 and return true if overflow is set. Call after lex when IO is available.
pub fn lexer_report_token_overflow_if_any() -> bool with IO, Mut {
    if LEXER_TOKEN_OVERFLOW == 0 {
        return false
    }
    print("error[E229]: ")
    if LEXER_TOKEN_OVERFLOW == 2 {
        print("source exceeds lexer byte buffer (capacity 16777216 bytes)")
    } else {
        print("lexer token table full (capacity 2097152 tokens)")
    }
    print("\n  --> reached at line ")
    print_int(LEXER_TOKEN_OVERFLOW_LINE)
    print(" column ")
    print_int(LEXER_TOKEN_OVERFLOW_COL)
    print(" (byte offset ")
    print_int(LEXER_TOKEN_OVERFLOW_BYTE)
    print(")\n")
    print("  = note: tokens past this table were previously SILENTLY DROPPED, so later\n")
    print("          parse errors blamed innocent lines. This is a fail-closed refusal\n")
    print("          (same discipline as E219 for unimplemented extern \"C\").\n")
    print("  = help: split the module. Raising the ceiling without keeping this refusal\n")
    print("          only moves the lie to the next input past the new wall.\n")
    true
}

// ============================================================================
// WHITESPACE AND COMMENT HANDLING
// ============================================================================

fn skip_whitespace(c: Cursor) -> Cursor with Mut, Div, Panic {
    // Scalar extraction avoids IS_SPTR=1 SRET corruption (boot4 bug).
    // Whitespace chars (space/tab/CR) are never newlines: col increments only.
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    while pos < source_len && is_whitespace(current) {
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

fn skip_line_comment(c: Cursor) -> Cursor with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    while pos < source_len && current != 10 as i8 {  // until '\n'
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

// Skip block comment with nesting support: /* ... /* inner */ ... */
struct SkipBlockResult {
    cursor: Cursor,
    unterminated: bool,
}

fn skip_block_comment(c: Cursor) -> SkipBlockResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current

    // Skip opening /* (advance_n(2) inline)
    var i: i64 = 0
    while i < 2 {
        if pos < source_len {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
        i = i + 1
    }

    var depth: i64 = 1
    while pos < source_len && depth > 0 {
        var peek1: i8 = 0 as i8
        if pos + 1 < source_len { peek1 = CURSOR_SOURCE[(pos + 1) as usize] }

        if current == 42 as i8 && peek1 == 47 as i8 {  // */
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            depth = depth - 1
        } else if current == 47 as i8 && peek1 == 42 as i8 {  // /* (nested)
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            depth = depth + 1
        } else {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    SkipBlockResult { cursor: result_cursor, unterminated: depth > 0 }
}

// ============================================================================
// IDENTIFIER AND KEYWORD SCANNING
// ============================================================================

fn scan_identifier(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    while pos < source_len && is_ident_continue(current) && text_idx < 256 {
        text[text_idx as usize] = current
        text_idx = text_idx + 1
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let kind = keyword_lookup(text, text_idx)
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

fn keyword_lookup_code(text: [i8; 256], len: i64) -> i64 {
    if len == 2 {
        if text[0] == 102 as i8 && text[1] == 110 as i8 { return 7 }   // fn
        if text[0] == 105 as i8 && text[1] == 102 as i8 { return 20 }  // if
        if text[0] == 105 as i8 && text[1] == 110 as i8 { return 29 }  // in
        if text[0] == 97 as i8 && text[1] == 115 as i8 { return 30 }   // as
        if text[0] == 105 as i8 && text[1] == 115 as i8 { return 37 }  // is
    }
    if len == 3 {
        if text[0] == 108 as i8 && text[1] == 101 as i8 && text[2] == 116 as i8 { return 8 }   // let
        if text[0] == 118 as i8 && text[1] == 97 as i8 && text[2] == 114 as i8 { return 9 }    // var
        if text[0] == 109 as i8 && text[1] == 117 as i8 && text[2] == 116 as i8 { return 10 }  // mut
        if text[0] == 102 as i8 && text[1] == 111 as i8 && text[2] == 114 as i8 { return 23 }  // for
        if text[0] == 112 as i8 && text[1] == 117 as i8 && text[2] == 98 as i8 { return 32 }   // pub
        if text[0] == 117 as i8 && text[1] == 115 as i8 && text[2] == 101 as i8 { return 5 }   // use
    }
    if len == 4 {
        if text[0] == 116 as i8 && text[1] == 121 as i8 && text[2] == 112 as i8 && text[3] == 101 as i8 { return 12 }  // type
        if text[0] == 101 as i8 && text[1] == 110 as i8 && text[2] == 117 as i8 && text[3] == 109 as i8 { return 14 }  // enum
        if text[0] == 105 as i8 && text[1] == 109 as i8 && text[2] == 112 as i8 && text[3] == 108 as i8 { return 16 }  // impl
        if text[0] == 101 as i8 && text[1] == 108 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 { return 21 }  // else
        if text[0] == 108 as i8 && text[1] == 111 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 { return 25 }  // loop
        if text[0] == 119 as i8 && text[1] == 105 as i8 && text[2] == 116 as i8 && text[3] == 104 as i8 { return 45 }  // with
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 117 as i8 && text[3] == 101 as i8 { return 35 }  // true
    }
    if len == 5 {
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 { return 15 }  // trait
        if text[0] == 109 as i8 && text[1] == 97 as i8 && text[2] == 116 as i8 && text[3] == 99 as i8 && text[4] == 104 as i8 { return 22 }  // match
        if text[0] == 119 as i8 && text[1] == 104 as i8 && text[2] == 105 as i8 && text[3] == 108 as i8 && text[4] == 101 as i8 { return 24 } // while
        if text[0] == 98 as i8 && text[1] == 114 as i8 && text[2] == 101 as i8 && text[3] == 97 as i8 && text[4] == 107 as i8 { return 26 }  // break
        if text[0] == 119 as i8 && text[1] == 104 as i8 && text[2] == 101 as i8 && text[3] == 114 as i8 && text[4] == 101 as i8 { return 31 } // where
        if text[0] == 102 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 115 as i8 && text[4] == 101 as i8 { return 36 } // false
    }
    if len == 6 {
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 114 as i8 && text[3] == 117 as i8 && text[4] == 99 as i8 && text[5] == 116 as i8 { return 13 }  // struct
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 116 as i8 && text[3] == 117 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 { return 28 }  // return
        if text[0] == 101 as i8 && text[1] == 120 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 { return 39 }  // extern
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 100 as i8 && text[3] == 117 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 { return 123 }   // module → Ident
        if text[0] == 105 as i8 && text[1] == 109 as i8 && text[2] == 112 as i8 && text[3] == 111 as i8 && text[4] == 114 as i8 && text[5] == 116 as i8 { return 4 }   // import
        if text[0] == 101 as i8 && text[1] == 120 as i8 && text[2] == 112 as i8 && text[3] == 111 as i8 && text[4] == 114 as i8 && text[5] == 116 as i8 { return 6 }   // export
    }
    123
}

// ============================================================================
// NUMBER SCANNING (int, float, hex, bin, oct, suffixes)
// ============================================================================

// V0-B: absorb C99 hex-float tails left after a HexLit scan (0x1 + p+exp).
// Takes scalar start/end/kind — NEVER pass ScanResult into this helper
// (IS_SPTR struct-arg corruption; ScanResult::new comment).
fn extend_c99_hex_float(start: i64, end: i64, kind0: TokenKind, source_len: i64, line0: i64, col0: i64) -> ScanResult with Mut, Div, Panic {
    if start + 1 >= source_len {
        let cur0 = Cursor { source_len: source_len, pos: end, line: line0, col: col0, current: 0 as i8 }
        return ScanResult::new(cur0, kind0, start, end)
    }
    if CURSOR_SOURCE[start as usize] != 48 as i8 {
        let cur0 = Cursor { source_len: source_len, pos: end, line: line0, col: col0, current: 0 as i8 }
        return ScanResult::new(cur0, kind0, start, end)
    }
    let xch = CURSOR_SOURCE[(start + 1) as usize]
    if xch != 120 as i8 && xch != 88 as i8 {
        let cur0 = Cursor { source_len: source_len, pos: end, line: line0, col: col0, current: 0 as i8 }
        return ScanResult::new(cur0, kind0, start, end)
    }
    var pos: i64 = end
    var col: i64 = col0
    var line: i64 = line0
    var kind = kind0
    var changed = 0
    var current: i8 = 0 as i8
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] }
    if pos < source_len && current == 46 as i8 {
        var after_dot: i8 = 0 as i8
        if pos + 1 < source_len { after_dot = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_hex_digit(after_dot) {
            changed = 1
            kind = TokenKind::FloatLit
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_hex_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
        }
    }
    if pos < source_len && (current == 112 as i8 || current == 80 as i8) {
        var after_p: i8 = 0 as i8
        if pos + 1 < source_len { after_p = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_digit(after_p) || after_p == 43 as i8 || after_p == 45 as i8 {
            changed = 1
            kind = TokenKind::FloatLit
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if pos < source_len && (current == 43 as i8 || current == 45 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            while pos < source_len && is_digit(current) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
        }
    }
    if changed == 0 {
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] }
        let cur0 = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
        return ScanResult::new(cur0, kind0, start, end)
    }
    let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    let suf = skip_numeric_suffix(tmp_c)
    pos = suf.pos; col = suf.col; line = suf.line
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, pos)
}

fn scan_number(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var kind = TokenKind::IntLit

    // Check for 0x, 0b, 0o prefixes
    if current == 48 as i8 {  // '0'
        var next: i8 = 0 as i8
        if pos + 1 < source_len { next = CURSOR_SOURCE[(pos + 1) as usize] }
        if next == 120 as i8 || next == 88 as i8 {  // 'x' or 'X'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            // Hex integer or C99 hex-float (0x1.8p+0 / 0x1p-10 / 0x.1p+4).
            // Mirror the decimal '.' / 'e' paths below: mutate `kind` in place,
            // no bool flag (boot4/lean_single has bitten bool locals in large fns).
            kind = TokenKind::HexLit
            while pos < source_len && (is_hex_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            // Resync from CURSOR_SOURCE — do not trust a stale `current` local.
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            // Optional hex fractional part: '.' + hex digit
            if pos < source_len && current == 46 as i8 {  // '.'
                var after_dot: i8 = 0 as i8
                if pos + 1 < source_len { after_dot = CURSOR_SOURCE[(pos + 1) as usize] }
                if is_hex_digit(after_dot) {
                    kind = TokenKind::FloatLit
                    col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
                    while pos < source_len && (is_hex_digit(current) || current == 95 as i8) {
                        col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
                    }
                }
            }
            // Binary exponent: 'p'/'P' + optional sign + decimal digits (required for C99 hex-float)
            if pos < source_len && (current == 112 as i8 || current == 80 as i8) {  // 'p'/'P'
                var after_p: i8 = 0 as i8
                if pos + 1 < source_len { after_p = CURSOR_SOURCE[(pos + 1) as usize] }
                if is_digit(after_p) || after_p == 43 as i8 || after_p == 45 as i8 {
                    kind = TokenKind::FloatLit
                    col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
                    if pos < source_len && (current == 43 as i8 || current == 45 as i8) {
                        col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
                    }
                    while pos < source_len && is_digit(current) {
                        col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
                    }
                }
            }
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
        if next == 98 as i8 || next == 66 as i8 {  // 'b' or 'B'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_bin_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::BinLit
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
        if next == 111 as i8 || next == 79 as i8 {  // 'o' or 'O'
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_oct_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::OctLit
            let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            let suf = skip_numeric_suffix(tmp_c)
            pos = suf.pos; col = suf.col; line = suf.line; current = suf.current
            let end = pos
            let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
            return ScanResult::new(result_cursor, kind, start, end)
        }
    }

    // Decimal digits (with underscore separators)
    while pos < source_len && (is_digit(current) || current == 95 as i8) {
        col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    // Check for decimal point (but not ".." range)
    if pos < source_len && current == 46 as i8 {  // '.'
        var after_dot: i8 = 0 as i8
        if pos + 1 < source_len { after_dot = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_digit(after_dot) {
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            while pos < source_len && (is_digit(current) || current == 95 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::FloatLit
        }
    }

    // Scientific notation: e/E followed by optional +/- and digits
    if pos < source_len && (current == 101 as i8 || current == 69 as i8) {  // 'e' or 'E'
        var after_e: i8 = 0 as i8
        if pos + 1 < source_len { after_e = CURSOR_SOURCE[(pos + 1) as usize] }
        if is_digit(after_e) || after_e == 43 as i8 || after_e == 45 as i8 {
            col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if pos < source_len && (current == 43 as i8 || current == 45 as i8) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            while pos < source_len && is_digit(current) {
                col = col + 1; pos = pos + 1; if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            kind = TokenKind::FloatLit
        }
    }

    // Numeric suffix
    let tmp_c = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    let suf = skip_numeric_suffix(tmp_c)
    pos = suf.pos; col = suf.col; line = suf.line; current = suf.current

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, end)
}

fn skip_numeric_suffix(c: Cursor) -> Cursor with Mut, Div, Panic {
    // Scalar-only: no Cursor struct passing. Numeric suffixes have no newlines.
    let pos0: i64 = c.pos
    let source_len: i64 = c.source_len
    let line: i64 = c.line
    let col0: i64 = c.col

    if pos0 >= source_len {
        return Cursor { source_len: source_len, pos: pos0, line: line, col: col0, current: c.current }
    }

    let ch: i8 = c.current
    var n1: i8 = 0 as i8
    var n2: i8 = 0 as i8
    if pos0 + 1 < source_len { n1 = CURSOR_SOURCE[(pos0 + 1) as usize] }
    if pos0 + 2 < source_len { n2 = CURSOR_SOURCE[(pos0 + 2) as usize] }

    var skip: i64 = 0
    if ch == 102 as i8 {  // 'f'
        if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }       // "f32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }  // "f64"
        else if n1 == 49 as i8 && n2 == 50 as i8 {
            // "f128"
            var n3: i8 = 0 as i8
            if pos0 + 3 < source_len { n3 = CURSOR_SOURCE[(pos0 + 3) as usize] }
            if n3 == 56 as i8 { skip = 4 }
        } else if n1 == 50 as i8 && n2 == 53 as i8 {
            // "f256"
            var n3b: i8 = 0 as i8
            if pos0 + 3 < source_len { n3b = CURSOR_SOURCE[(pos0 + 3) as usize] }
            if n3b == 54 as i8 { skip = 4 }
        }
    }
    if ch == 105 as i8 {  // 'i'
        if n1 == 56 as i8 { skip = 2 }                                  // "i8"
        else if n1 == 49 as i8 && n2 == 54 as i8 { skip = 3 }          // "i16"
        else if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }          // "i32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }          // "i64"
    }
    if ch == 117 as i8 {  // 'u'
        if n1 == 56 as i8 { skip = 2 }                                  // "u8"
        else if n1 == 49 as i8 && n2 == 54 as i8 { skip = 3 }          // "u16"
        else if n1 == 51 as i8 && n2 == 50 as i8 { skip = 3 }          // "u32"
        else if n1 == 54 as i8 && n2 == 52 as i8 { skip = 3 }          // "u64"
    }

    let pos: i64 = pos0 + skip
    let col: i64 = col0 + skip
    var current: i8 = 0 as i8
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] }
    Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
}

// ============================================================================
// STRING SCANNING (with escape processing)
// ============================================================================

fn scan_string(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    // Skip opening '"'
    if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
    pos = pos + 1
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }

    while pos < source_len && current != 34 as i8 && text_idx < 255 {  // '"'
        if current == 92 as i8 {  // backslash
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if pos < source_len {
                let esc: i8 = current
                if esc == 110 as i8 { text[text_idx as usize] = 10 as i8 }       // \n -> LF
                else if esc == 116 as i8 { text[text_idx as usize] = 9 as i8 }   // \t -> TAB
                else if esc == 114 as i8 { text[text_idx as usize] = 13 as i8 }  // \r -> CR
                else if esc == 92 as i8 { text[text_idx as usize] = 92 as i8 }   // \\ -> backslash
                else if esc == 34 as i8 { text[text_idx as usize] = 34 as i8 }   // \" -> quote
                else if esc == 48 as i8 { text[text_idx as usize] = 0 as i8 }    // \0 -> null
                else { text[text_idx as usize] = esc }
                text_idx = text_idx + 1
                if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
                pos = pos + 1
                if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
        } else {
            text[text_idx as usize] = current
            text_idx = text_idx + 1
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    var unterminated = true
    if pos < source_len && current == 34 as i8 {
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        unterminated = false
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    if unterminated {
        ScanResult::with_text(result_cursor, TokenKind::Error, start, end, text, text_idx)
    } else {
        ScanResult::with_text(result_cursor, TokenKind::StringLit, start, end, text, text_idx)
    }
}

// ============================================================================
// CHAR LITERAL SCANNING
// ============================================================================

fn scan_char_literal(c: Cursor) -> ScanResult with Mut, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos

    // Skip opening '\''
    if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
    pos = pos + 1
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }

    // Handle escape sequence
    if pos < source_len && current == 92 as i8 {  // backslash
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        if pos < source_len {
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    } else if pos < source_len {
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    // Expect closing quote
    if pos < source_len && current == 39 as i8 {  // '\''
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, TokenKind::CharLit, start, end)
}

// ============================================================================
// DOC COMMENT SCANNING
// ============================================================================

fn scan_doc_comment_line(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocOuter

    if is_inner { kind = TokenKind::DocInner }

    // Skip //! or ///  (advance_n(3) inline, no newlines in // prefix)
    var i: i64 = 0
    while i < 3 {
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        i = i + 1
    }

    while pos < source_len && current != 10 as i8 && text_idx < 256 {
        text[text_idx as usize] = current
        text_idx = text_idx + 1
        col = col + 1; pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

fn scan_doc_comment_block(c: Cursor, is_inner: bool) -> ScanResult with Mut, Div, Panic {
    var pos: i64 = c.pos
    let source_len: i64 = c.source_len
    var line: i64 = c.line
    var col: i64 = c.col
    var current: i8 = c.current
    let start = pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TokenKind::DocBlockOuter

    if is_inner { kind = TokenKind::DocBlockInner }

    // Skip /** or /*!  (advance_n(3) inline)
    var i: i64 = 0
    while i < 3 {
        if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        i = i + 1
    }

    var done = false
    while pos < source_len && text_idx < 256 && !done {
        var peek1: i8 = 0 as i8
        if pos + 1 < source_len { peek1 = CURSOR_SOURCE[(pos + 1) as usize] }
        if current == 42 as i8 && peek1 == 47 as i8 {  // */
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            done = true
        } else {
            text[text_idx as usize] = current
            text_idx = text_idx + 1
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::with_text(result_cursor, kind, start, end, text, text_idx)
}

// ============================================================================
// SOURCEFILE LOADING API (boot4-safe: scalar returns, items path)
// ============================================================================
// NOTE: pub fn lex(source, source_len, file_id) -> LexerState has been moved
// to lexer::lex_full to keep this module free of the 8MB LexerState frame.
// Tests that import lex() should use lexer::lex_full instead.

var SOURCEFILE_TRACE: i64 = 0

pub fn sourcefile_trace_enable() with Mut {
    SOURCEFILE_TRACE = 1
}

// Runs the full lexer over CURSOR_SOURCE[0..source_len], emitting all tokens
// via parser_set_token_at() only — no LexerState or token array allocation.
// CURSOR_SOURCE must be populated before calling (e.g. by lex_file_to_globals).
// Returns the total number of tokens emitted (including the EOF token).
pub fn lex_source_to_globals(source_len: i64) -> i64 with Mut, Div, Panic {
    lexer_reset_token_overflow()
    var n: i64 = source_len
    if n < 0 { n = 0 }
    // Source buffer is CURSOR_SOURCE, [i8; 16777216]. Truncating here was a
    // second silent drop (bytes past the wall never lexed). Refuse instead.
    if n > 16777216 {
        lexer_mark_token_overflow(1, 1, n, 2)
        return 0 - 1
    }
    CURSOR_SOURCE_LEN = n
    var pos: i64 = 0
    var line: i64 = 1
    var col: i64 = 1
    var tc: i64 = 0

    while pos < n {
        // Fail closed before any further emit once the table is full.
        if tc >= 2097152 {
            lexer_mark_token_overflow(line, col, pos, 1)
            break
        }
        let ch = CURSOR_SOURCE[pos as usize]

        if ch == 32 as i8 || ch == 9 as i8 || ch == 13 as i8 {
            col = col + 1
            pos = pos + 1
            continue
        }
        if ch == 10 as i8 {
            line = line + 1
            col = 1
            pos = pos + 1
            continue
        }

        if ch == 47 as i8 && pos + 1 < n {
            let next = CURSOR_SOURCE[(pos + 1) as usize]
            if next == 47 as i8 {
                while pos < n && CURSOR_SOURCE[pos as usize] != 10 as i8 {
                    pos = pos + 1
                    col = col + 1
                }
                continue
            }
            if next == 42 as i8 {
                pos = pos + 2
                col = col + 2
                var depth: i64 = 1
                while pos < n && depth > 0 {
                    let c0 = CURSOR_SOURCE[pos as usize]
                    let c1 = if pos + 1 < n { CURSOR_SOURCE[(pos + 1) as usize] } else { 0 as i8 }
                    if c0 == 47 as i8 && c1 == 42 as i8 {
                        depth = depth + 1
                        pos = pos + 2
                        col = col + 2
                    } else if c0 == 42 as i8 && c1 == 47 as i8 {
                        depth = depth - 1
                        pos = pos + 2
                        col = col + 2
                    } else {
                        if c0 == 10 as i8 {
                            line = line + 1
                            col = 1
                        } else {
                            col = col + 1
                        }
                        pos = pos + 1
                    }
                }
                continue
            }
        }

        if is_ident_start(ch) {
            let start = pos
            let start_col = col
            var text: [i8; 256] = [0; 256]
            var text_idx: i64 = 0
            while pos < n && is_ident_continue(CURSOR_SOURCE[pos as usize]) && text_idx < 256 {
                text[text_idx as usize] = CURSOR_SOURCE[pos as usize]
                text_idx = text_idx + 1
                pos = pos + 1
                col = col + 1
            }
            // main moved the identifier slot to the scalar setter (TokenKind
            // directly) so a new keyword needs no arm in parser_set_token_flat's
            // dispatch. Keep that, and keep this PR's fail-closed guard: the
            // guard is about the slot, not about which setter writes it.
            if tc >= 2097152 {
                lexer_mark_token_overflow(line, start_col, start, 1)
                break
            }
            parser_set_token_scalar(tc, keyword_lookup(text, text_idx), start, pos, line, start_col)
            tc = tc + 1
            continue
        }

        if is_digit(ch) {
            let start = pos
            let start_col = col
            var value: i64 = 0
            var is_float_token = false
            if ch == 48 as i8 && pos + 1 < n &&
               (CURSOR_SOURCE[(pos + 1) as usize] == 120 as i8 || CURSOR_SOURCE[(pos + 1) as usize] == 88 as i8) {
                pos = pos + 2
                col = col + 2
                while pos < n && is_hex_digit(CURSOR_SOURCE[pos as usize]) {
                    let hc = CURSOR_SOURCE[pos as usize]
                    if hc >= 48 as i8 && hc <= 57 as i8 {
                        value = value * 16 + ((hc - 48 as i8) as i64)
                    } else if hc >= 97 as i8 && hc <= 102 as i8 {
                        value = value * 16 + ((hc - 87 as i8) as i64)
                    } else if hc >= 65 as i8 && hc <= 70 as i8 {
                        value = value * 16 + ((hc - 55 as i8) as i64)
                    }
                    pos = pos + 1
                    col = col + 1
                }
                tc = lexer_push_flat(tc, 129, start, pos, line, start_col, value)
                if tc < 0 { break }
                continue
            }
            while pos < n && is_digit(CURSOR_SOURCE[pos as usize]) {
                value = value * 10 + ((CURSOR_SOURCE[pos as usize] - 48 as i8) as i64)
                pos = pos + 1
                col = col + 1
            }
            if pos + 1 < n && CURSOR_SOURCE[pos as usize] == 46 as i8 && is_digit(CURSOR_SOURCE[(pos + 1) as usize]) {
                pos = pos + 1
                col = col + 1
                while pos < n && is_digit(CURSOR_SOURCE[pos as usize]) {
                    pos = pos + 1
                    col = col + 1
                }
                is_float_token = true
            }
            if pos < n && (CURSOR_SOURCE[pos as usize] == 101 as i8 || CURSOR_SOURCE[pos as usize] == 69 as i8) {
                var exp_pos = pos + 1
                if exp_pos < n && (CURSOR_SOURCE[exp_pos as usize] == 43 as i8 || CURSOR_SOURCE[exp_pos as usize] == 45 as i8) {
                    exp_pos = exp_pos + 1
                }
                if exp_pos < n && is_digit(CURSOR_SOURCE[exp_pos as usize]) {
                    pos = pos + 1
                    col = col + 1
                    if pos < n && (CURSOR_SOURCE[pos as usize] == 43 as i8 || CURSOR_SOURCE[pos as usize] == 45 as i8) {
                        pos = pos + 1
                        col = col + 1
                    }
                    while pos < n && is_digit(CURSOR_SOURCE[pos as usize]) {
                        pos = pos + 1
                        col = col + 1
                    }
                    is_float_token = true
                }
            }
            if is_float_token {
                tc = lexer_push_flat(tc, 125, start, pos, line, start_col, 0)
            } else {
                tc = lexer_push_flat(tc, 124, start, pos, line, start_col, value)
            }
            if tc < 0 { break }
            continue
        }

        if ch == 34 as i8 {
            let start = pos
            let start_col = col
            pos = pos + 1
            col = col + 1
            while pos < n && CURSOR_SOURCE[pos as usize] != 34 as i8 {
                if CURSOR_SOURCE[pos as usize] == 92 as i8 && pos + 1 < n {
                    pos = pos + 2
                    col = col + 2
                } else {
                    pos = pos + 1
                    col = col + 1
                }
            }
            if pos < n && CURSOR_SOURCE[pos as usize] == 34 as i8 {
                pos = pos + 1
                col = col + 1
            }
            tc = lexer_push_flat(tc, 126, start, pos, line, start_col, 0)
            if tc < 0 { break }
            continue
        }

        let start = pos
        let start_col = col
        var kind_code: i64 = 1
        var width: i64 = 1
        let c2 = if pos + 1 < n { CURSOR_SOURCE[(pos + 1) as usize] } else { 0 as i8 }
        let c3 = if pos + 2 < n { CURSOR_SOURCE[(pos + 2) as usize] } else { 0 as i8 }

        if ch == 46 as i8 && c2 == 46 as i8 && c3 == 46 as i8 { kind_code = 172; width = 3 }
        else if ch == 46 as i8 && c2 == 46 as i8 && c3 == 61 as i8 { kind_code = 161; width = 3 }
        else if ch == 60 as i8 && c2 == 60 as i8 && c3 == 61 as i8 { kind_code = 166; width = 3 }
        else if ch == 62 as i8 && c2 == 62 as i8 && c3 == 61 as i8 { kind_code = 167; width = 3 }
        else if ch == 61 as i8 && c2 == 61 as i8 { kind_code = 146; width = 2 }
        else if ch == 33 as i8 && c2 == 61 as i8 { kind_code = 147; width = 2 }
        else if ch == 60 as i8 && c2 == 61 as i8 { kind_code = 148; width = 2 }
        else if ch == 62 as i8 && c2 == 61 as i8 { kind_code = 149; width = 2 }
        else if ch == 38 as i8 && c2 == 38 as i8 { kind_code = 150; width = 2 }
        else if ch == 124 as i8 && c2 == 124 as i8 { kind_code = 151; width = 2 }
        else if ch == 60 as i8 && c2 == 60 as i8 { kind_code = 152; width = 2 }
        else if ch == 62 as i8 && c2 == 62 as i8 { kind_code = 153; width = 2 }
        else if ch == 43 as i8 && c2 == 61 as i8 { kind_code = 154; width = 2 }
        else if ch == 45 as i8 && c2 == 61 as i8 { kind_code = 155; width = 2 }
        else if ch == 42 as i8 && c2 == 61 as i8 { kind_code = 156; width = 2 }
        else if ch == 47 as i8 && c2 == 61 as i8 { kind_code = 157; width = 2 }
        else if ch == 37 as i8 && c2 == 61 as i8 { kind_code = 168; width = 2 }
        else if ch == 38 as i8 && c2 == 61 as i8 { kind_code = 170; width = 2 }
        else if ch == 124 as i8 && c2 == 61 as i8 { kind_code = 165; width = 2 }
        else if ch == 94 as i8 && c2 == 61 as i8 { kind_code = 169; width = 2 }
        else if ch == 45 as i8 && c2 == 62 as i8 { kind_code = 158; width = 2 }
        else if ch == 61 as i8 && c2 == 62 as i8 { kind_code = 159; width = 2 }
        else if ch == 60 as i8 && c2 == 45 as i8 { kind_code = 171; width = 2 }
        else if ch == 38 as i8 && c2 == 33 as i8 { kind_code = 163; width = 2 }
        else if ch == 58 as i8 && c2 == 58 as i8 { kind_code = 162; width = 2 }
        else if ch == 46 as i8 && c2 == 46 as i8 { kind_code = 160; width = 2 }
        else if ch == 43 as i8 && c2 == 43 as i8 { kind_code = 164; width = 2 }
        else if ch == 43 as i8 && c2 == 45 as i8 { kind_code = 173; width = 2 }
        else if ch == 43 as i8 { kind_code = 132 }
        else if ch == 45 as i8 { kind_code = 133 }
        else if ch == 42 as i8 { kind_code = 134 }
        else if ch == 47 as i8 { kind_code = 135 }
        else if ch == 37 as i8 { kind_code = 136 }
        else if ch == 61 as i8 { kind_code = 137 }
        else if ch == 60 as i8 { kind_code = 138 }
        else if ch == 62 as i8 { kind_code = 139 }
        else if ch == 33 as i8 { kind_code = 140 }
        else if ch == 38 as i8 { kind_code = 141 }
        else if ch == 124 as i8 { kind_code = 142 }
        else if ch == 94 as i8 { kind_code = 143 }
        else if ch == 126 as i8 { kind_code = 144 }
        else if ch == 63 as i8 { kind_code = 145 }
        else if ch == 40 as i8 { kind_code = 174 }
        else if ch == 41 as i8 { kind_code = 175 }
        else if ch == 123 as i8 { kind_code = 176 }
        else if ch == 125 as i8 { kind_code = 177 }
        else if ch == 91 as i8 { kind_code = 178 }
        else if ch == 93 as i8 { kind_code = 179 }
        else if ch == 59 as i8 { kind_code = 180 }
        else if ch == 58 as i8 { kind_code = 181 }
        else if ch == 44 as i8 { kind_code = 182 }
        else if ch == 46 as i8 { kind_code = 183 }
        else if ch == 64 as i8 { kind_code = 184 }
        else if ch == 35 as i8 { kind_code = 185 }

        tc = lexer_push_flat(tc, kind_code, start, start + width, line, start_col, 0)
        if tc < 0 { break }
        pos = pos + width
        col = col + width
    }

    // Overflow: do not hand the parser a truncated stream (that re-creates the lie).
    if LEXER_TOKEN_OVERFLOW != 0 {
        return 0 - 1
    }

    // Eof must fit; if not, refuse rather than omit the terminator.
    tc = lexer_push_flat(tc, 0, pos, pos, line, col, 0)
    if tc < 0 {
        return 0 - 1
    }
    return tc

    var first_byte: i8 = 0 as i8
    if n > 0 { first_byte = CURSOR_SOURCE[0] }
    var cur: Cursor = Cursor {
        source_len: n,
        pos: 0,
        line: 1,
        col: 1,
        current: first_byte,
    }
    var tc: i64 = 0

    while !cur.is_eof() {
        let ch = cur.current

        if is_whitespace(ch) {
            cur = skip_whitespace(cur)
            continue
        }

        if ch == 10 {
            cur = cur.advance()
            continue
        }

        if ch == 47 {
            let next = cur.peek()
            if next == 47 {
                let third = cur.peek_n(2)
                if third == 47 && cur.peek_n(3) != 47 {
                    let result = scan_doc_comment_line(cur, false)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 2097152 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                if third == 33 {
                    let result = scan_doc_comment_line(cur, true)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 2097152 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                cur = skip_line_comment(cur)
                continue
            }
            if next == 42 {
                let third = cur.peek_n(2)
                if third == 42 && cur.peek_n(3) != 47 {
                    let result = scan_doc_comment_block(cur, false)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 2097152 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                if third == 33 {
                    let result = scan_doc_comment_block(cur, true)
                    cur = result.cursor
                    let tok = Token::with_kind(result.kind, result.start, result.end, cur.line, cur.col)
                    if tc < 2097152 {
                        parser_set_token_at(tc, tok)
                        tc = tc + 1
                    }
                    continue
                }
                let block_result = skip_block_comment(cur)
                cur = block_result.cursor
                continue
            }
        }

        if ch == 34 {
            let line = cur.line
            let col = cur.col
            let result = scan_string(cur)
            cur = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 39 {
            let line = cur.line
            let col = cur.col
            let result = scan_char_literal(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_digit(ch) {
            let line = cur.line
            let col = cur.col
            let source_len = cur.source_len
            let scanned = scan_number(cur)
            // Extract scalars BEFORE any struct-arg helper (IS_SPTR).
            let s0 = scanned.start
            let e0 = scanned.end
            let k0 = scanned.kind
            let result = extend_c99_hex_float(s0, e0, k0, source_len, line, col)
            cur = result.cursor
            let nv = parse_numeric(result.start, result.end, result.kind)
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if nv.is_float {
                tok.float_value = nv.float_val
            } else {
                tok.int_value = nv.int_val
            }
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_ident_start(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_identifier(cur)
            cur = result.cursor
            var tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            tok.text = result.text
            tok.text_len = result.text_len
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 46 {
            let next = cur.peek()
            if next == 46 {
                let line = cur.line
                let col = cur.col
                let result = scan_operator(cur)
                cur = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if tc < 2097152 {
                    parser_set_token_at(tc, tok)
                    tc = tc + 1
                }
                continue
            }
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if ch == 58 {
            let next = cur.peek()
            if next == 58 {
                let line = cur.line
                let col = cur.col
                let result = scan_operator(cur)
                cur = result.cursor
                let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
                if tc < 2097152 {
                    parser_set_token_at(tc, tok)
                    tc = tc + 1
                }
                continue
            }
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_operator_start(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_operator(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_delimiter(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_delimiter(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        if is_punctuation(ch) {
            let line = cur.line
            let col = cur.col
            let result = scan_punctuation(cur)
            cur = result.cursor
            let tok = Token::with_kind(result.kind, result.start, result.end, line, col)
            if tc < 2097152 {
                parser_set_token_at(tc, tok)
                tc = tc + 1
            }
            continue
        }

        cur = cur.advance()
    }

    let eof_tok = Token::eof(cur.pos, cur.line, cur.col)
    if tc < 2097152 {
        parser_set_token_at(tc, eof_tok)
        tc = tc + 1
    }
    tc
}

// Loads a .sio file directly into CURSOR_SOURCE, then lexes it to globals.
// Returns the token count. Frame is tiny: file pointer + a few scalars.
pub fn lex_file_to_globals(path: string) -> i64 with IO, Mut, Div, Panic {
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_to_globals_enter\n") }
    lexer_reset_token_overflow()
    let size = file_size(path)
    let data = read_file(path)
    var n: i64 = size
    if n < 0 { n = 0 }
    // Do not silently clip the file to the CURSOR_SOURCE wall.
    if n > 16777216 {
        lexer_mark_token_overflow(1, 1, n, 2)
        return 0 - 1
    }
    var ci: i64 = 0
    while ci < n {
        CURSOR_SOURCE[ci as usize] = data[ci as usize]
        ci = ci + 1
    }
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_to_globals_buf_ok\n") }
    lex_source_to_globals(n)
}

// Load a .sio source file, lex it, and parse its items.
// Returns Option<Box<ItemList>> (1 slot) — avoids IS_SPTR=4 Program struct returns.
// Uses lex_file_to_globals to keep the frame tiny (no LexerState on stack).
pub fn lex_file_parse_items(path: string) -> Option<Box<ItemList>> with IO, Mut, Div, Panic, Alloc {
    if SOURCEFILE_TRACE == 1 { print("trace=lex_file_parse_items_enter\n") }
    let tc = lex_file_to_globals(path)
    // Fail closed: never parse a silently truncated token stream.
    if tc < 0 || lexer_token_overflow_kind() != 0 {
        let _reported = lexer_report_token_overflow_if_any()
        // Make check-mode preflight fail (same channel as parse errors).
        parser_set_last_errors(true, 1)
        if SOURCEFILE_TRACE == 1 { print("trace=lex_token_overflow\n") }
        return None
    }
    if SOURCEFILE_TRACE == 1 { print("trace=lex_ok\n") }
    let items = parse_items_preloaded(tc)
    if SOURCEFILE_TRACE == 1 { print("trace=parse_ok\n") }
    items
}
