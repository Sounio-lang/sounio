// self-hosted::lexer::tables — Keyword lookup and operator scanning
//
// keyword_lookup: byte-by-byte comparison grouped by length
// scan_operator: longest-match (3-char > 2-char > 1-char)
// scan_delimiter: single-char delimiters and punctuation

// ============================================================================
// KEYWORD LOOKUP
// ============================================================================
// Returns TK_IDENT (100) if no keyword match.
// All comparisons use ASCII i8 values.

fn keyword_lookup(text: [i8; 256], len: i64) -> i32 {
    // Length 2: fn, if, in, as, is
    if len == 2 {
        if text[0] == 102 && text[1] == 110 { return 14 }  // "fn" -> TK_FN
        if text[0] == 105 && text[1] == 102 { return 24 }  // "if" -> TK_IF
        if text[0] == 105 && text[1] == 110 { return 33 }  // "in" -> TK_IN
        if text[0] == 97 && text[1] == 115 { return 34 }   // "as" -> TK_AS
        if text[0] == 105 && text[1] == 115 { return 41 }  // "is" -> TK_IS
    }

    // Length 3: let, var, mut, for, pub, use, ref, dyn, box
    if len == 3 {
        if text[0] == 108 && text[1] == 101 && text[2] == 116 { return 15 }  // "let"
        if text[0] == 118 && text[1] == 97 && text[2] == 114 { return 16 }   // "var"
        if text[0] == 109 && text[1] == 117 && text[2] == 116 { return 17 }  // "mut"
        if text[0] == 102 && text[1] == 111 && text[2] == 114 { return 27 }  // "for"
        if text[0] == 112 && text[1] == 117 && text[2] == 98 { return 36 }   // "pub"
        if text[0] == 117 && text[1] == 115 && text[2] == 101 { return 12 }  // "use"
        if text[0] == 114 && text[1] == 101 && text[2] == 102 { return 61 }  // "ref"
        if text[0] == 100 && text[1] == 121 && text[2] == 110 { return 62 }  // "dyn"
        if text[0] == 98 && text[1] == 111 && text[2] == 120 { return 63 }   // "box"
    }

    // Length 4: type, enum, impl, else, loop, self, Self, with, true, false, move, copy, drop
    if len == 4 {
        if text[0] == 116 && text[1] == 121 && text[2] == 112 && text[3] == 101 { return 19 }  // "type"
        if text[0] == 101 && text[1] == 110 && text[2] == 117 && text[3] == 109 { return 21 }  // "enum"
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 108 { return 23 }  // "impl"
        if text[0] == 101 && text[1] == 108 && text[2] == 115 && text[3] == 101 { return 25 }  // "else"
        if text[0] == 108 && text[1] == 111 && text[2] == 111 && text[3] == 112 { return 29 }  // "loop"
        if text[0] == 115 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return 37 }  // "self"
        if text[0] == 83 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return 38 }   // "Self"
        if text[0] == 119 && text[1] == 105 && text[2] == 116 && text[3] == 104 { return 53 }  // "with"
        if text[0] == 116 && text[1] == 114 && text[2] == 117 && text[3] == 101 { return 39 }  // "true"
        if text[0] == 109 && text[1] == 111 && text[2] == 118 && text[3] == 101 { return 58 }  // "move"
        if text[0] == 99 && text[1] == 111 && text[2] == 112 && text[3] == 121 { return 59 }   // "copy"
        if text[0] == 100 && text[1] == 114 && text[2] == 111 && text[3] == 112 { return 60 }  // "drop"
    }

    // Length 5: const, trait, match, while, break, where, false, async, await, spawn, infer, prior, super, crate
    if len == 5 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 115 && text[4] == 116 { return 18 }   // "const"
        if text[0] == 116 && text[1] == 114 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return 22 }   // "trait"
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 99 && text[4] == 104 { return 26 }    // "match"
        if text[0] == 119 && text[1] == 104 && text[2] == 105 && text[3] == 108 && text[4] == 101 { return 28 }  // "while"
        if text[0] == 98 && text[1] == 114 && text[2] == 101 && text[3] == 97 && text[4] == 107 { return 30 }    // "break"
        if text[0] == 119 && text[1] == 104 && text[2] == 101 && text[3] == 114 && text[4] == 101 { return 35 }  // "where"
        if text[0] == 102 && text[1] == 97 && text[2] == 108 && text[3] == 115 && text[4] == 101 { return 40 }   // "false"
        if text[0] == 97 && text[1] == 115 && text[2] == 121 && text[3] == 110 && text[4] == 99 { return 70 }    // "async"
        if text[0] == 97 && text[1] == 119 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return 71 }    // "await"
        if text[0] == 115 && text[1] == 112 && text[2] == 97 && text[3] == 119 && text[4] == 110 { return 72 }   // "spawn"
        if text[0] == 105 && text[1] == 110 && text[2] == 102 && text[3] == 101 && text[4] == 114 { return 90 }  // "infer"
        if text[0] == 112 && text[1] == 114 && text[2] == 105 && text[3] == 111 && text[4] == 114 { return 84 }  // "prior"
        if text[0] == 115 && text[1] == 117 && text[2] == 112 && text[3] == 101 && text[4] == 114 { return 91 }  // "super"
        if text[0] == 99 && text[1] == 114 && text[2] == 97 && text[3] == 116 && text[4] == 101 { return 92 }    // "crate"
    }

    // Length 6: struct, return, effect, handle, linear, affine, kernel, resume, unsafe, extern, static, module, import, export, sample, belief
    if len == 6 {
        if text[0] == 115 && text[1] == 116 && text[2] == 114 && text[3] == 117 && text[4] == 99 && text[5] == 116 { return 20 }   // "struct"
        if text[0] == 114 && text[1] == 101 && text[2] == 116 && text[3] == 117 && text[4] == 114 && text[5] == 110 { return 32 }   // "return"
        if text[0] == 101 && text[1] == 102 && text[2] == 102 && text[3] == 101 && text[4] == 99 && text[5] == 116 { return 50 }    // "effect"
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 { return 52 }    // "handle"
        if text[0] == 108 && text[1] == 105 && text[2] == 110 && text[3] == 101 && text[4] == 97 && text[5] == 114 { return 56 }    // "linear"
        if text[0] == 97 && text[1] == 102 && text[2] == 102 && text[3] == 105 && text[4] == 110 && text[5] == 101 { return 57 }    // "affine"
        if text[0] == 107 && text[1] == 101 && text[2] == 114 && text[3] == 110 && text[4] == 101 && text[5] == 108 { return 73 }   // "kernel"
        if text[0] == 114 && text[1] == 101 && text[2] == 115 && text[3] == 117 && text[4] == 109 && text[5] == 101 { return 55 }   // "resume"
        if text[0] == 117 && text[1] == 110 && text[2] == 115 && text[3] == 97 && text[4] == 102 && text[5] == 101 { return 42 }    // "unsafe"
        if text[0] == 101 && text[1] == 120 && text[2] == 116 && text[3] == 101 && text[4] == 114 && text[5] == 110 { return 43 }   // "extern"
        if text[0] == 115 && text[1] == 116 && text[2] == 97 && text[3] == 116 && text[4] == 105 && text[5] == 99 { return 44 }     // "static"
        if text[0] == 109 && text[1] == 111 && text[2] == 100 && text[3] == 117 && text[4] == 108 && text[5] == 101 { return 10 }   // "module"
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return 11 }   // "import"
        if text[0] == 101 && text[1] == 120 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return 13 }   // "export"
        if text[0] == 115 && text[1] == 97 && text[2] == 109 && text[3] == 112 && text[4] == 108 && text[5] == 101 { return 89 }    // "sample"
        if text[0] == 98 && text[1] == 101 && text[2] == 108 && text[3] == 105 && text[4] == 101 && text[5] == 102 { return 81 }    // "belief"
    }

    // Length 7: handler, perform, observe, entropy
    if len == 7 {
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 && text[6] == 114 { return 51 }   // "handler"
        if text[0] == 112 && text[1] == 101 && text[2] == 114 && text[3] == 102 && text[4] == 111 && text[5] == 114 && text[6] == 109 { return 54 }   // "perform"
        if text[0] == 111 && text[1] == 98 && text[2] == 115 && text[3] == 101 && text[4] == 114 && text[5] == 118 && text[6] == 101 { return 88 }    // "observe"
        if text[0] == 101 && text[1] == 110 && text[2] == 116 && text[3] == 114 && text[4] == 111 && text[5] == 112 && text[6] == 121 { return 87 }   // "entropy"
    }

    // Length 8: continue, evidence
    if len == 8 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 116 && text[4] == 105 && text[5] == 110 && text[6] == 117 && text[7] == 101 { return 31 }   // "continue"
        if text[0] == 101 && text[1] == 118 && text[2] == 105 && text[3] == 100 && text[4] == 101 && text[5] == 110 && text[6] == 99 && text[7] == 101 { return 82 }    // "evidence"
    }

    // Length 9: uncertain, posterior
    if len == 9 {
        if text[0] == 117 && text[1] == 110 && text[2] == 99 && text[3] == 101 && text[4] == 114 && text[5] == 116 && text[6] == 97 && text[7] == 105 && text[8] == 110 { return 80 }   // "uncertain"
        if text[0] == 112 && text[1] == 111 && text[2] == 115 && text[3] == 116 && text[4] == 101 && text[5] == 114 && text[6] == 105 && text[7] == 111 && text[8] == 114 { return 85 }  // "posterior"
    }

    // Length 10: confidence, likelihood
    if len == 10 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 102 && text[4] == 105 && text[5] == 100 && text[6] == 101 && text[7] == 110 && text[8] == 99 && text[9] == 101 { return 83 }   // "confidence"
        if text[0] == 108 && text[1] == 105 && text[2] == 107 && text[3] == 101 && text[4] == 108 && text[5] == 105 && text[6] == 104 && text[7] == 111 && text[8] == 111 && text[9] == 100 { return 86 }  // "likelihood"
    }

    100  // TK_IDENT
}

// ============================================================================
// OPERATOR SCANNING (longest match)
// ============================================================================

struct ScanResult {
    cursor: Cursor,
    kind: i32,
    start: i64,
    end: i64,
    text: [i8; 256],
    text_len: i64,
}

fn scan_result_new(cur: Cursor, kind: i32, start: i64, end: i64) -> ScanResult {
    ScanResult {
        cursor: cur,
        kind: kind,
        start: start,
        end: end,
        text: [0; 256],
        text_len: 0,
    }
}

fn scan_result_with_text(cur: Cursor, kind: i32, start: i64, end: i64, text: [i8; 256], text_len: i64) -> ScanResult {
    ScanResult {
        cursor: cur,
        kind: kind,
        start: start,
        end: end,
        text: text,
        text_len: text_len,
    }
}

fn scan_operator(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind: i32 = 1  // TK_ERROR default

    let c1 = cur.current
    let c2 = cursor_peek(cur)
    let c3 = cursor_peek_n(cur, 2)

    // 3-char operators
    if c1 == 46 && c2 == 46 && c3 == 46 {  // "..."
        cur = cursor_advance_n(cur, 3)
        kind = 166  // TK_DOT_DOT_DOT
    } else if c1 == 46 && c2 == 46 && c3 == 61 {  // "..="
        cur = cursor_advance_n(cur, 3)
        kind = 155  // TK_DOT_DOT_EQ
    } else if c1 == 60 && c2 == 60 && c3 == 61 {  // "<<="
        cur = cursor_advance_n(cur, 3)
        kind = 160  // TK_SHL_EQ
    } else if c1 == 62 && c2 == 62 && c3 == 61 {  // ">>="
        cur = cursor_advance_n(cur, 3)
        kind = 161  // TK_SHR_EQ
    }
    // 2-char operators
    else if c1 == 61 && c2 == 61 {  // "=="
        cur = cursor_advance_n(cur, 2)
        kind = 140  // TK_EQ_EQ
    } else if c1 == 33 && c2 == 61 {  // "!="
        cur = cursor_advance_n(cur, 2)
        kind = 141  // TK_BANG_EQ
    } else if c1 == 60 && c2 == 61 {  // "<="
        cur = cursor_advance_n(cur, 2)
        kind = 142  // TK_LT_EQ
    } else if c1 == 62 && c2 == 61 {  // ">="
        cur = cursor_advance_n(cur, 2)
        kind = 143  // TK_GT_EQ
    } else if c1 == 38 && c2 == 38 {  // "&&"
        cur = cursor_advance_n(cur, 2)
        kind = 144  // TK_AMP_AMP
    } else if c1 == 124 && c2 == 124 {  // "||"
        cur = cursor_advance_n(cur, 2)
        kind = 145  // TK_PIPE_PIPE
    } else if c1 == 60 && c2 == 60 {  // "<<"
        cur = cursor_advance_n(cur, 2)
        kind = 146  // TK_SHL
    } else if c1 == 62 && c2 == 62 {  // ">>"
        cur = cursor_advance_n(cur, 2)
        kind = 147  // TK_SHR
    } else if c1 == 43 && c2 == 61 {  // "+="
        cur = cursor_advance_n(cur, 2)
        kind = 148  // TK_PLUS_EQ
    } else if c1 == 45 && c2 == 61 {  // "-="
        cur = cursor_advance_n(cur, 2)
        kind = 149  // TK_MINUS_EQ
    } else if c1 == 42 && c2 == 61 {  // "*="
        cur = cursor_advance_n(cur, 2)
        kind = 150  // TK_STAR_EQ
    } else if c1 == 47 && c2 == 61 {  // "/="
        cur = cursor_advance_n(cur, 2)
        kind = 151  // TK_SLASH_EQ
    } else if c1 == 37 && c2 == 61 {  // "%="
        cur = cursor_advance_n(cur, 2)
        kind = 162  // TK_PERCENT_EQ
    } else if c1 == 38 && c2 == 61 {  // "&="
        cur = cursor_advance_n(cur, 2)
        kind = 164  // TK_AMP_EQ
    } else if c1 == 124 && c2 == 61 {  // "|="
        cur = cursor_advance_n(cur, 2)
        kind = 159  // TK_PIPE_EQ
    } else if c1 == 94 && c2 == 61 {  // "^="
        cur = cursor_advance_n(cur, 2)
        kind = 163  // TK_CARET_EQ
    } else if c1 == 45 && c2 == 62 {  // "->"
        cur = cursor_advance_n(cur, 2)
        kind = 152  // TK_ARROW
    } else if c1 == 61 && c2 == 62 {  // "=>"
        cur = cursor_advance_n(cur, 2)
        kind = 153  // TK_FAT_ARROW
    } else if c1 == 60 && c2 == 45 {  // "<-"
        cur = cursor_advance_n(cur, 2)
        kind = 165  // TK_LEFT_ARROW
    } else if c1 == 38 && c2 == 33 {  // "&!"
        cur = cursor_advance_n(cur, 2)
        kind = 157  // TK_AMP_BANG
    } else if c1 == 58 && c2 == 58 {  // "::"
        cur = cursor_advance_n(cur, 2)
        kind = 156  // TK_COLON_COLON
    } else if c1 == 46 && c2 == 46 {  // ".."
        cur = cursor_advance_n(cur, 2)
        kind = 154  // TK_DOT_DOT
    } else if c1 == 43 && c2 == 43 {  // "++"
        cur = cursor_advance_n(cur, 2)
        kind = 158  // TK_PLUS_PLUS
    } else if c1 == 43 && c2 == 45 {  // "+-" (±)
        cur = cursor_advance_n(cur, 2)
        kind = 167  // TK_PLUS_MINUS
    }
    // 1-char operators
    else if c1 == 43 {  // "+"
        cur = cursor_advance(cur)
        kind = 120  // TK_PLUS
    } else if c1 == 45 {  // "-"
        cur = cursor_advance(cur)
        kind = 121  // TK_MINUS
    } else if c1 == 42 {  // "*"
        cur = cursor_advance(cur)
        kind = 122  // TK_STAR
    } else if c1 == 47 {  // "/"
        cur = cursor_advance(cur)
        kind = 123  // TK_SLASH
    } else if c1 == 37 {  // "%"
        cur = cursor_advance(cur)
        kind = 124  // TK_PERCENT
    } else if c1 == 61 {  // "="
        cur = cursor_advance(cur)
        kind = 125  // TK_EQ
    } else if c1 == 60 {  // "<"
        cur = cursor_advance(cur)
        kind = 126  // TK_LT
    } else if c1 == 62 {  // ">"
        cur = cursor_advance(cur)
        kind = 127  // TK_GT
    } else if c1 == 33 {  // "!"
        cur = cursor_advance(cur)
        kind = 128  // TK_BANG
    } else if c1 == 38 {  // "&"
        cur = cursor_advance(cur)
        kind = 129  // TK_AMP
    } else if c1 == 124 {  // "|"
        cur = cursor_advance(cur)
        kind = 130  // TK_PIPE
    } else if c1 == 94 {  // "^"
        cur = cursor_advance(cur)
        kind = 131  // TK_CARET
    } else if c1 == 126 {  // "~"
        cur = cursor_advance(cur)
        kind = 132  // TK_TILDE
    } else if c1 == 63 {  // "?"
        cur = cursor_advance(cur)
        kind = 133  // TK_QUESTION
    }

    let end = cur.pos
    scan_result_new(cur, kind, start, end)
}

// ============================================================================
// DELIMITER AND PUNCTUATION SCANNING
// ============================================================================

fn scan_delimiter(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind: i32 = 1  // TK_ERROR

    let ch = cur.current

    if ch == 40 { kind = 170 }       // "(" -> TK_LPAREN
    else if ch == 41 { kind = 171 }   // ")" -> TK_RPAREN
    else if ch == 123 { kind = 172 }  // "{" -> TK_LBRACE
    else if ch == 125 { kind = 173 }  // "}" -> TK_RBRACE
    else if ch == 91 { kind = 174 }   // "[" -> TK_LBRACKET
    else if ch == 93 { kind = 175 }   // "]" -> TK_RBRACKET

    if kind != 1 {
        cur = cursor_advance(cur)
    }

    let end = cur.pos
    scan_result_new(cur, kind, start, end)
}

fn scan_punctuation(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind: i32 = 1  // TK_ERROR

    let ch = cur.current

    if ch == 59 { kind = 180 }       // ";" -> TK_SEMI
    else if ch == 58 { kind = 181 }   // ":" -> TK_COLON
    else if ch == 44 { kind = 182 }   // "," -> TK_COMMA
    else if ch == 46 { kind = 183 }   // "." -> TK_DOT
    else if ch == 64 { kind = 184 }   // "@" -> TK_AT
    else if ch == 35 { kind = 185 }   // "#" -> TK_HASH

    if kind != 1 {
        cur = cursor_advance(cur)
    }

    let end = cur.pos
    scan_result_new(cur, kind, start, end)
}
