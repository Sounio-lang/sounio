// self-hosted::lexer::tables — Keyword lookup and operator scanning
//
// keyword_lookup: byte-by-byte comparison grouped by length, returns TokenKind
// scan_operator: longest-match (3-char > 2-char > 1-char)
// scan_delimiter: single-char delimiters and punctuation
// ScanResult carries cursor state and token info with impl block.

module lexer::tables

use lexer::cursor::*
use lexer::token::*

// ============================================================================
// KEYWORD LOOKUP
// ============================================================================
// Returns TokenKind::Ident if no keyword match.
// All comparisons use ASCII i8 values.

pub fn keyword_lookup(text: [i8; 256], len: i64) -> TokenKind with Panic {
    // Length 2: fn, if, in, as, is
    if len == 2 {
        if text[0] == 102 as i8 && text[1] == 110 as i8 { return TokenKind::Fn }          // "fn"
        if text[0] == 105 as i8 && text[1] == 102 as i8 { return TokenKind::If }          // "if"
        if text[0] == 105 as i8 && text[1] == 110 as i8 { return TokenKind::In }          // "in"
        if text[0] == 111 as i8 && text[1] == 110 as i8 { return TokenKind::On }          // "on"
        if text[0] == 97 as i8 && text[1] == 115 as i8 { return TokenKind::As }           // "as"
        if text[0] == 105 as i8 && text[1] == 115 as i8 { return TokenKind::Is }          // "is"
    }

    // Length 3: let, var, mut, for, pub, use, ref, dyn, box
    if len == 3 {
        if text[0] == 108 as i8 && text[1] == 101 as i8 && text[2] == 116 as i8 { return TokenKind::Let }   // "let"
        if text[0] == 118 as i8 && text[1] == 97 as i8 && text[2] == 114 as i8 { return TokenKind::Var }    // "var"
        if text[0] == 109 as i8 && text[1] == 117 as i8 && text[2] == 116 as i8 { return TokenKind::Mut }   // "mut"
        if text[0] == 102 as i8 && text[1] == 111 as i8 && text[2] == 114 as i8 { return TokenKind::For }   // "for"
        if text[0] == 112 as i8 && text[1] == 117 as i8 && text[2] == 98 as i8 { return TokenKind::Pub }    // "pub"
        if text[0] == 117 as i8 && text[1] == 115 as i8 && text[2] == 101 as i8 { return TokenKind::Use }   // "use"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 102 as i8 { return TokenKind::Ref }   // "ref"
        if text[0] == 100 as i8 && text[1] == 121 as i8 && text[2] == 110 as i8 { return TokenKind::Dyn }   // "dyn"
        if text[0] == 98 as i8 && text[1] == 111 as i8 && text[2] == 120 as i8 { return TokenKind::Box }    // "box"
    }

    // Length 4: type, enum, impl, else, loop, self, Self, with, true, move, copy, drop, unit, chan, send, recv, dual
    if len == 4 {
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 101 as i8 && text[3] == 112 as i8 { return TokenKind::Step }          // "step"
        if text[0] == 117 as i8 && text[1] == 110 as i8 && text[2] == 105 as i8 && text[3] == 116 as i8 { return TokenKind::Unit }         // "unit"
        if text[0] == 116 as i8 && text[1] == 121 as i8 && text[2] == 112 as i8 && text[3] == 101 as i8 { return TokenKind::Type }        // "type"
        if text[0] == 101 as i8 && text[1] == 110 as i8 && text[2] == 117 as i8 && text[3] == 109 as i8 { return TokenKind::Enum }        // "enum"
        if text[0] == 105 as i8 && text[1] == 109 as i8 && text[2] == 112 as i8 && text[3] == 108 as i8 { return TokenKind::Impl }        // "impl"
        if text[0] == 101 as i8 && text[1] == 108 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 { return TokenKind::Else }        // "else"
        if text[0] == 108 as i8 && text[1] == 111 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 { return TokenKind::Loop }        // "loop"
        if text[0] == 115 as i8 && text[1] == 101 as i8 && text[2] == 108 as i8 && text[3] == 102 as i8 { return TokenKind::SelfLower }   // "self"
        if text[0] == 83 as i8 && text[1] == 101 as i8 && text[2] == 108 as i8 && text[3] == 102 as i8 { return TokenKind::SelfUpper }    // "Self"
        if text[0] == 119 as i8 && text[1] == 105 as i8 && text[2] == 116 as i8 && text[3] == 104 as i8 { return TokenKind::With }        // "with"
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 117 as i8 && text[3] == 101 as i8 { return TokenKind::True }        // "true"
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 118 as i8 && text[3] == 101 as i8 { return TokenKind::Move }        // "move"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 112 as i8 && text[3] == 121 as i8 { return TokenKind::Copy }         // "copy"
        if text[0] == 100 as i8 && text[1] == 114 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 { return TokenKind::Drop }        // "drop"
        if text[0] == 99 as i8 && text[1] == 104 as i8 && text[2] == 97 as i8 && text[3] == 110 as i8 { return TokenKind::Chan }          // "chan"
        if text[0] == 115 as i8 && text[1] == 101 as i8 && text[2] == 110 as i8 && text[3] == 100 as i8 { return TokenKind::Send }        // "send"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 118 as i8 { return TokenKind::Recv }         // "recv"
        if text[0] == 100 as i8 && text[1] == 117 as i8 && text[2] == 97 as i8 && text[3] == 108 as i8 { return TokenKind::Dual }         // "dual"
    }

    // Length 5: Proof, Lemma, Axiom, const, trait, match, while, break, where, false, async, await, spawn, infer, prior, super, crate, Valid, Model, level, scope, audit, close, study
    if len == 5 {
        if text[0] == 80 as i8 && text[1] == 114 as i8 && text[2] == 111 as i8 && text[3] == 111 as i8 && text[4] == 102 as i8 { return TokenKind::Proof }     // "Proof"
        if text[0] == 76 as i8 && text[1] == 101 as i8 && text[2] == 109 as i8 && text[3] == 109 as i8 && text[4] == 97 as i8 { return TokenKind::Lemma }     // "Lemma"
        if text[0] == 65 as i8 && text[1] == 120 as i8 && text[2] == 105 as i8 && text[3] == 111 as i8 && text[4] == 109 as i8 { return TokenKind::Axiom }     // "Axiom"
        if text[0] == 86 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 { return TokenKind::Valid }     // "Valid"
        if text[0] == 77 as i8 && text[1] == 111 as i8 && text[2] == 100 as i8 && text[3] == 101 as i8 && text[4] == 108 as i8 { return TokenKind::Model }     // "Model"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 115 as i8 && text[4] == 116 as i8 { return TokenKind::Const }    // "const"
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 { return TokenKind::Trait }    // "trait"
        if text[0] == 109 as i8 && text[1] == 97 as i8 && text[2] == 116 as i8 && text[3] == 99 as i8 && text[4] == 104 as i8 { return TokenKind::Match }     // "match"
        if text[0] == 119 as i8 && text[1] == 104 as i8 && text[2] == 105 as i8 && text[3] == 108 as i8 && text[4] == 101 as i8 { return TokenKind::While }   // "while"
        if text[0] == 98 as i8 && text[1] == 114 as i8 && text[2] == 101 as i8 && text[3] == 97 as i8 && text[4] == 107 as i8 { return TokenKind::Break }     // "break"
        if text[0] == 119 as i8 && text[1] == 104 as i8 && text[2] == 101 as i8 && text[3] == 114 as i8 && text[4] == 101 as i8 { return TokenKind::Where }   // "where"
        if text[0] == 102 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 115 as i8 && text[4] == 101 as i8 { return TokenKind::False }    // "false"
        if text[0] == 97 as i8 && text[1] == 115 as i8 && text[2] == 121 as i8 && text[3] == 110 as i8 && text[4] == 99 as i8 { return TokenKind::Async }     // "async"
        if text[0] == 97 as i8 && text[1] == 119 as i8 && text[2] == 97 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 { return TokenKind::Await }     // "await"
        if text[0] == 115 as i8 && text[1] == 112 as i8 && text[2] == 97 as i8 && text[3] == 119 as i8 && text[4] == 110 as i8 { return TokenKind::Spawn }    // "spawn"
        if text[0] == 105 as i8 && text[1] == 110 as i8 && text[2] == 102 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 { return TokenKind::Infer }   // "infer"
        if text[0] == 112 as i8 && text[1] == 114 as i8 && text[2] == 105 as i8 && text[3] == 111 as i8 && text[4] == 114 as i8 { return TokenKind::Prior }   // "prior"
        if text[0] == 115 as i8 && text[1] == 117 as i8 && text[2] == 112 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 { return TokenKind::Super }   // "super"
        if text[0] == 99 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 { return TokenKind::Crate }     // "crate"
        if text[0] == 97 as i8 && text[1] == 117 as i8 && text[2] == 100 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 { return TokenKind::AuditLower }     // "audit"
        if text[0] == 108 as i8 && text[1] == 101 as i8 && text[2] == 118 as i8 && text[3] == 101 as i8 && text[4] == 108 as i8 { return TokenKind::Level }     // "level"
        if text[0] == 115 as i8 && text[1] == 99 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 && text[4] == 101 as i8 { return TokenKind::Scope }     // "scope"
        if text[0] == 99 as i8 && text[1] == 108 as i8 && text[2] == 111 as i8 && text[3] == 115 as i8 && text[4] == 101 as i8 { return TokenKind::Close }     // "close"
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 117 as i8 && text[3] == 100 as i8 && text[4] == 121 as i8 { return TokenKind::Study }     // "study"
    }

    // Length 6: struct, return, effect, handle, linear, affine, kernel, resume, unsafe, extern, static, module, import, export, sample, belief, models
    if len == 6 {
        if text[0] == 80 as i8 && text[1] == 111 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 99 as i8 && text[5] == 121 as i8 { return TokenKind::Policy }     // "Policy"
        if text[0] == 112 as i8 && text[1] == 111 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 99 as i8 && text[5] == 121 as i8 { return TokenKind::PolicyLower }     // "policy"
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 100 as i8 && text[3] == 101 as i8 && text[4] == 108 as i8 && text[5] == 115 as i8 { return TokenKind::ModelsLower }     // "models"
        if text[0] == 82 as i8 && text[1] == 111 as i8 && text[2] == 98 as i8 && text[3] == 117 as i8 && text[4] == 115 as i8 && text[5] == 116 as i8 { return TokenKind::Robust }     // "Robust"
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 114 as i8 && text[3] == 117 as i8 && text[4] == 99 as i8 && text[5] == 116 as i8 { return TokenKind::Struct }     // "struct"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 116 as i8 && text[3] == 117 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 { return TokenKind::Return }     // "return"
        if text[0] == 101 as i8 && text[1] == 102 as i8 && text[2] == 102 as i8 && text[3] == 101 as i8 && text[4] == 99 as i8 && text[5] == 116 as i8 { return TokenKind::Effect }      // "effect"
        if text[0] == 104 as i8 && text[1] == 97 as i8 && text[2] == 110 as i8 && text[3] == 100 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 { return TokenKind::Handle }      // "handle"
        if text[0] == 108 as i8 && text[1] == 105 as i8 && text[2] == 110 as i8 && text[3] == 101 as i8 && text[4] == 97 as i8 && text[5] == 114 as i8 { return TokenKind::Linear }      // "linear"
        if text[0] == 97 as i8 && text[1] == 102 as i8 && text[2] == 102 as i8 && text[3] == 105 as i8 && text[4] == 110 as i8 && text[5] == 101 as i8 { return TokenKind::Affine }      // "affine"
        if text[0] == 107 as i8 && text[1] == 101 as i8 && text[2] == 114 as i8 && text[3] == 110 as i8 && text[4] == 101 as i8 && text[5] == 108 as i8 { return TokenKind::Kernel }     // "kernel"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 115 as i8 && text[3] == 117 as i8 && text[4] == 109 as i8 && text[5] == 101 as i8 { return TokenKind::Resume }     // "resume"
        if text[0] == 117 as i8 && text[1] == 110 as i8 && text[2] == 115 as i8 && text[3] == 97 as i8 && text[4] == 102 as i8 && text[5] == 101 as i8 { return TokenKind::Unsafe }      // "unsafe"
        if text[0] == 101 as i8 && text[1] == 120 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 { return TokenKind::Extern }     // "extern"
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 97 as i8 && text[3] == 116 as i8 && text[4] == 105 as i8 && text[5] == 99 as i8 { return TokenKind::Static }       // "static"
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 100 as i8 && text[3] == 117 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 { return TokenKind::Module }     // "module"
        if text[0] == 105 as i8 && text[1] == 109 as i8 && text[2] == 112 as i8 && text[3] == 111 as i8 && text[4] == 114 as i8 && text[5] == 116 as i8 { return TokenKind::Import }     // "import"
        if text[0] == 101 as i8 && text[1] == 120 as i8 && text[2] == 112 as i8 && text[3] == 111 as i8 && text[4] == 114 as i8 && text[5] == 116 as i8 { return TokenKind::Export }     // "export"
        if text[0] == 115 as i8 && text[1] == 97 as i8 && text[2] == 109 as i8 && text[3] == 112 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 { return TokenKind::Sample }      // "sample"
        if text[0] == 98 as i8 && text[1] == 101 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 101 as i8 && text[5] == 102 as i8 { return TokenKind::Belief }      // "belief"
    }

    // Length 7: algebra, handler, perform, observe, entropy, Derived, session
    if len == 7 {
        if text[0] == 97 as i8 && text[1] == 108 as i8 && text[2] == 103 as i8 && text[3] == 101 as i8 && text[4] == 98 as i8 && text[5] == 114 as i8 && text[6] == 97 as i8 { return TokenKind::Algebra }     // "algebra"
        if text[0] == 115 as i8 && text[1] == 101 as i8 && text[2] == 115 as i8 && text[3] == 115 as i8 && text[4] == 105 as i8 && text[5] == 111 as i8 && text[6] == 110 as i8 { return TokenKind::Session }    // "session"
        if text[0] == 67 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 && text[5] == 115 as i8 && text[6] == 116 as i8 { return TokenKind::Contest }     // "Contest"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 && text[5] == 115 as i8 && text[6] == 116 as i8 { return TokenKind::ContestLower }     // "contest"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 113 as i8 && text[3] == 117 as i8 && text[4] == 105 as i8 && text[5] == 114 as i8 && text[6] == 101 as i8 { return TokenKind::Require }     // "require"
        if text[0] == 68 as i8 && text[1] == 101 as i8 && text[2] == 114 as i8 && text[3] == 105 as i8 && text[4] == 118 as i8 && text[5] == 101 as i8 && text[6] == 100 as i8 { return TokenKind::Derived }     // "Derived"
        if text[0] == 104 as i8 && text[1] == 97 as i8 && text[2] == 110 as i8 && text[3] == 100 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 && text[6] == 114 as i8 { return TokenKind::Handler }    // "handler"
        if text[0] == 112 as i8 && text[1] == 101 as i8 && text[2] == 114 as i8 && text[3] == 102 as i8 && text[4] == 111 as i8 && text[5] == 114 as i8 && text[6] == 109 as i8 { return TokenKind::Perform }    // "perform"
        if text[0] == 111 as i8 && text[1] == 98 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 118 as i8 && text[6] == 101 as i8 { return TokenKind::Observe }     // "observe"
        if text[0] == 101 as i8 && text[1] == 110 as i8 && text[2] == 116 as i8 && text[3] == 114 as i8 && text[4] == 111 as i8 && text[5] == 112 as i8 && text[6] == 121 as i8 { return TokenKind::Entropy }    // "entropy"
        if text[0] == 65 as i8 && text[1] == 117 as i8 && text[2] == 100 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 && text[5] == 101 as i8 && text[6] == 100 as i8 { return TokenKind::Audited }    // "Audited"
    }

    // Length 8: continue, evidence, Computed, Measured, Deferred, ontology
    if len == 8 {
        if text[0] == 111 as i8 && text[1] == 110 as i8 && text[2] == 116 as i8 && text[3] == 111 as i8 && text[4] == 108 as i8 && text[5] == 111 as i8 && text[6] == 103 as i8 && text[7] == 121 as i8 { return TokenKind::Ontology }    // "ontology"
        if text[0] == 67 as i8 && text[1] == 111 as i8 && text[2] == 109 as i8 && text[3] == 112 as i8 && text[4] == 117 as i8 && text[5] == 116 as i8 && text[6] == 101 as i8 && text[7] == 100 as i8 { return TokenKind::Computed }    // "Computed"
        if text[0] == 68 as i8 && text[1] == 101 as i8 && text[2] == 102 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 114 as i8 && text[6] == 101 as i8 && text[7] == 100 as i8 { return TokenKind::Deferred }    // "Deferred"
        if text[0] == 77 as i8 && text[1] == 101 as i8 && text[2] == 97 as i8 && text[3] == 115 as i8 && text[4] == 117 as i8 && text[5] == 114 as i8 && text[6] == 101 as i8 && text[7] == 100 as i8 { return TokenKind::Measured }    // "Measured"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 116 as i8 && text[4] == 105 as i8 && text[5] == 110 as i8 && text[6] == 117 as i8 && text[7] == 101 as i8 { return TokenKind::Continue }    // "continue"
        if text[0] == 101 as i8 && text[1] == 118 as i8 && text[2] == 105 as i8 && text[3] == 100 as i8 && text[4] == 101 as i8 && text[5] == 110 as i8 && text[6] == 99 as i8 && text[7] == 101 as i8 { return TokenKind::Evidence }     // "evidence"
    }

    // Length 9: Aleatoric, uncertain, posterior, Knowledge
    if len == 9 {
        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 101 as i8 && text[3] == 97 as i8 && text[4] == 116 as i8 && text[5] == 111 as i8 && text[6] == 114 as i8 && text[7] == 105 as i8 && text[8] == 99 as i8 { return TokenKind::Aleatoric }    // "Aleatoric"
        if text[0] == 75 as i8 && text[1] == 110 as i8 && text[2] == 111 as i8 && text[3] == 119 as i8 && text[4] == 108 as i8 && text[5] == 101 as i8 && text[6] == 100 as i8 && text[7] == 103 as i8 && text[8] == 101 as i8 { return TokenKind::Knowledge }    // "Knowledge"
        if text[0] == 117 as i8 && text[1] == 110 as i8 && text[2] == 99 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 116 as i8 && text[6] == 97 as i8 && text[7] == 105 as i8 && text[8] == 110 as i8 { return TokenKind::Uncertain }    // "uncertain"
        if text[0] == 112 as i8 && text[1] == 111 as i8 && text[2] == 115 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 && text[5] == 114 as i8 && text[6] == 105 as i8 && text[7] == 111 as i8 && text[8] == 114 as i8 { return TokenKind::Posterior }   // "posterior"
        if text[0] == 86 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 && text[5] == 97 as i8 && text[6] == 116 as i8 && text[7] == 101 as i8 && text[8] == 100 as i8 { return TokenKind::Validated }     // "Validated"
        if text[0] == 82 as i8 && text[1] == 101 as i8 && text[2] == 118 as i8 && text[3] == 105 as i8 && text[4] == 118 as i8 && text[5] == 97 as i8 && text[6] == 98 as i8 && text[7] == 108 as i8 && text[8] == 101 as i8 { return TokenKind::Revivable }     // "Revivable"
    }

    // Length 8: DPBudget, strategy, Editable
    if len == 8 {
        if text[0] == 68 as i8 && text[1] == 80 as i8 && text[2] == 66 as i8 && text[3] == 117 as i8 && text[4] == 100 as i8 && text[5] == 103 as i8 && text[6] == 101 as i8 && text[7] == 116 as i8 { return TokenKind::DPBudget }    // "DPBudget"
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 114 as i8 && text[3] == 97 as i8 && text[4] == 116 as i8 && text[5] == 101 as i8 && text[6] == 103 as i8 && text[7] == 121 as i8 { return TokenKind::Strategy }   // "strategy"
        if text[0] == 69 as i8 && text[1] == 100 as i8 && text[2] == 105 as i8 && text[3] == 116 as i8 && text[4] == 97 as i8 && text[5] == 98 as i8 && text[6] == 108 as i8 && text[7] == 101 as i8 { return TokenKind::Editable }   // "Editable"
    }

    // Length 9: objective
    if len == 9 {
        if text[0] == 111 as i8 && text[1] == 98 as i8 && text[2] == 106 as i8 && text[3] == 101 as i8 && text[4] == 99 as i8 && text[5] == 116 as i8 && text[6] == 105 as i8 && text[7] == 118 as i8 && text[8] == 101 as i8 { return TokenKind::Objective }   // "objective"
    }

    // Length 9: max_steps
    if len == 9 {
        if text[0] == 109 as i8 && text[1] == 97 as i8 && text[2] == 120 as i8 && text[3] == 95 as i8 && text[4] == 115 as i8 && text[5] == 116 as i8 && text[6] == 101 as i8 && text[7] == 112 as i8 && text[8] == 115 as i8 { return TokenKind::MaxSteps }   // "max_steps"
    }

    // Length 10: confidence, likelihood, ValidUntil, ValidWhile, validation, Admissible
    if len == 10 {
        if text[0] == 65 as i8 && text[1] == 100 as i8 && text[2] == 109 as i8 && text[3] == 105 as i8 && text[4] == 115 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 98 as i8 && text[8] == 108 as i8 && text[9] == 101 as i8 { return TokenKind::Admissible }    // "Admissible"
        if text[0] == 86 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 && text[5] == 85 as i8 && text[6] == 110 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 108 as i8 { return TokenKind::ValidUntil }    // "ValidUntil"
        if text[0] == 86 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 && text[5] == 87 as i8 && text[6] == 104 as i8 && text[7] == 105 as i8 && text[8] == 108 as i8 && text[9] == 101 as i8 { return TokenKind::ValidWhile }    // "ValidWhile"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 102 as i8 && text[4] == 105 as i8 && text[5] == 100 as i8 && text[6] == 101 as i8 && text[7] == 110 as i8 && text[8] == 99 as i8 && text[9] == 101 as i8 { return TokenKind::Confidence }    // "confidence"
        if text[0] == 108 as i8 && text[1] == 105 as i8 && text[2] == 107 as i8 && text[3] == 101 as i8 && text[4] == 108 as i8 && text[5] == 105 as i8 && text[6] == 104 as i8 && text[7] == 111 as i8 && text[8] == 111 as i8 && text[9] == 100 as i8 { return TokenKind::Likelihood }   // "likelihood"
        if text[0] == 118 as i8 && text[1] == 97 as i8 && text[2] == 108 as i8 && text[3] == 105 as i8 && text[4] == 100 as i8 && text[5] == 97 as i8 && text[6] == 116 as i8 && text[7] == 105 as i8 && text[8] == 111 as i8 && text[9] == 110 as i8 { return TokenKind::ValidationLower }   // "validation"
        if text[0] == 67 as i8 && text[1] == 111 as i8 && text[2] == 109 as i8 && text[3] == 112 as i8 && text[4] == 111 as i8 && text[5] == 115 as i8 && text[6] == 97 as i8 && text[7] == 98 as i8 && text[8] == 108 as i8 && text[9] == 101 as i8 { return TokenKind::Composable }    // "Composable"
    }

    // Length 11: DiffPrivate, Forgettable
    if len == 11 {
        if text[0] == 68 as i8 && text[1] == 105 as i8 && text[2] == 102 as i8 && text[3] == 102 as i8 && text[4] == 80 as i8 && text[5] == 114 as i8 && text[6] == 105 as i8 && text[7] == 118 as i8 && text[8] == 97 as i8 && text[9] == 116 as i8 && text[10] == 101 as i8 { return TokenKind::DiffPrivate }    // "DiffPrivate"
        if text[0] == 70 as i8 && text[1] == 111 as i8 && text[2] == 114 as i8 && text[3] == 103 as i8 && text[4] == 101 as i8 && text[5] == 116 as i8 && text[6] == 116 as i8 && text[7] == 97 as i8 && text[8] == 98 as i8 && text[9] == 108 as i8 && text[10] == 101 as i8 { return TokenKind::Forgettable }    // "Forgettable"
    }

    // Length 12: CausalEffect, Intervention, RecoursePlan
    if len == 12 {
        if text[0] == 67 as i8 && text[1] == 97 as i8 && text[2] == 117 as i8 && text[3] == 115 as i8 && text[4] == 97 as i8 && text[5] == 108 as i8 && text[6] == 69 as i8 && text[7] == 102 as i8 && text[8] == 102 as i8 && text[9] == 101 as i8 && text[10] == 99 as i8 && text[11] == 116 as i8 { return TokenKind::CausalEffect }    // "CausalEffect"
        if text[0] == 82 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 111 as i8 && text[4] == 117 as i8 && text[5] == 114 as i8 && text[6] == 115 as i8 && text[7] == 101 as i8 && text[8] == 80 as i8 && text[9] == 108 as i8 && text[10] == 97 as i8 && text[11] == 110 as i8 { return TokenKind::RecoursePlan }    // "RecoursePlan"
        if text[0] == 73 as i8 && text[1] == 110 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 118 as i8 && text[6] == 101 as i8 && text[7] == 110 as i8 && text[8] == 116 as i8 && text[9] == 105 as i8 && text[10] == 111 as i8 && text[11] == 110 as i8 { return TokenKind::Intervention }    // "Intervention"
    }

    // Length 13: Interpretable (AMI canonical-basis marker)
    if len == 13 {
        if text[0] == 73 as i8 && text[1] == 110 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 112 as i8 && text[6] == 114 as i8 && text[7] == 101 as i8 && text[8] == 116 as i8 && text[9] == 97 as i8 && text[10] == 98 as i8 && text[11] == 108 as i8 && text[12] == 101 as i8 { return TokenKind::Interpretable }    // "Interpretable"
    }

    // Length 14: TransitionPlan, ExactlyPrivate
    if len == 14 {
        if text[0] == 84 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 110 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 116 as i8 && text[7] == 105 as i8 && text[8] == 111 as i8 && text[9] == 110 as i8 && text[10] == 80 as i8 && text[11] == 108 as i8 && text[12] == 97 as i8 && text[13] == 110 as i8 { return TokenKind::TransitionPlan }    // "TransitionPlan"
        if text[0] == 69 as i8 && text[1] == 120 as i8 && text[2] == 97 as i8 && text[3] == 99 as i8 && text[4] == 116 as i8 && text[5] == 108 as i8 && text[6] == 121 as i8 && text[7] == 80 as i8 && text[8] == 114 as i8 && text[9] == 105 as i8 && text[10] == 118 as i8 && text[11] == 97 as i8 && text[12] == 116 as i8 && text[13] == 101 as i8 { return TokenKind::ExactlyPrivate }    // "ExactlyPrivate"
    }

    // Length 14: Counterfactual, DecisionPolicy, DeferralPolicy, RecoursePolicy, AlternativeSet
    if len == 14 {
        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 83 as i8 && text[12] == 101 as i8 && text[13] == 116 as i8 { return TokenKind::AlternativeSet }    // "AlternativeSet"
        if text[0] == 67 as i8 && text[1] == 111 as i8 && text[2] == 117 as i8 && text[3] == 110 as i8 && text[4] == 116 as i8 && text[5] == 101 as i8 && text[6] == 114 as i8 && text[7] == 102 as i8 && text[8] == 97 as i8 && text[9] == 99 as i8 && text[10] == 116 as i8 && text[11] == 117 as i8 && text[12] == 97 as i8 && text[13] == 108 as i8 { return TokenKind::Counterfactual }    // "Counterfactual"
        if text[0] == 68 as i8 && text[1] == 101 as i8 && text[2] == 102 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 114 as i8 && text[6] == 97 as i8 && text[7] == 108 as i8 && text[8] == 80 as i8 && text[9] == 111 as i8 && text[10] == 108 as i8 && text[11] == 105 as i8 && text[12] == 99 as i8 && text[13] == 121 as i8 { return TokenKind::DeferralPolicy }    // "DeferralPolicy"
        if text[0] == 68 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 105 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 111 as i8 && text[7] == 110 as i8 && text[8] == 80 as i8 && text[9] == 111 as i8 && text[10] == 108 as i8 && text[11] == 105 as i8 && text[12] == 99 as i8 && text[13] == 121 as i8 { return TokenKind::DecisionPolicy }    // "DecisionPolicy"
        if text[0] == 82 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 111 as i8 && text[4] == 117 as i8 && text[5] == 114 as i8 && text[6] == 115 as i8 && text[7] == 101 as i8 && text[8] == 80 as i8 && text[9] == 111 as i8 && text[10] == 108 as i8 && text[11] == 105 as i8 && text[12] == 99 as i8 && text[13] == 121 as i8 { return TokenKind::RecoursePolicy }    // "RecoursePolicy"
    }

    // Length 14: rollback_route
    if len == 14 {
        if text[0] == 114 as i8 && text[1] == 111 as i8 && text[2] == 108 as i8 && text[3] == 108 as i8 && text[4] == 98 as i8 && text[5] == 97 as i8 && text[6] == 99 as i8 && text[7] == 107 as i8 && text[8] == 95 as i8 && text[9] == 114 as i8 && text[10] == 111 as i8 && text[11] == 117 as i8 && text[12] == 116 as i8 && text[13] == 101 as i8 { return TokenKind::RollbackRoute }    // "rollback_route"
    }

    // Length 16: PotentialOutcome, TransitionPolicy, MonitoringPolicy
    if len == 16 {
        if text[0] == 77 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 && text[5] == 111 as i8 && text[6] == 114 as i8 && text[7] == 105 as i8 && text[8] == 110 as i8 && text[9] == 103 as i8 && text[10] == 80 as i8 && text[11] == 111 as i8 && text[12] == 108 as i8 && text[13] == 105 as i8 && text[14] == 99 as i8 && text[15] == 121 as i8 { return TokenKind::MonitoringPolicy }    // "MonitoringPolicy"
        if text[0] == 80 as i8 && text[1] == 111 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 110 as i8 && text[5] == 116 as i8 && text[6] == 105 as i8 && text[7] == 97 as i8 && text[8] == 108 as i8 && text[9] == 79 as i8 && text[10] == 117 as i8 && text[11] == 116 as i8 && text[12] == 99 as i8 && text[13] == 111 as i8 && text[14] == 109 as i8 && text[15] == 101 as i8 { return TokenKind::PotentialOutcome }    // "PotentialOutcome"
        if text[0] == 84 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 110 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 116 as i8 && text[7] == 105 as i8 && text[8] == 111 as i8 && text[9] == 110 as i8 && text[10] == 80 as i8 && text[11] == 111 as i8 && text[12] == 108 as i8 && text[13] == 105 as i8 && text[14] == 99 as i8 && text[15] == 121 as i8 { return TokenKind::TransitionPolicy }    // "TransitionPolicy"
    }

    // Length 17: transition_policy, monitoring_policy
    if len == 17 {
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 110 as i8 && text[3] == 105 as i8 && text[4] == 116 as i8 && text[5] == 111 as i8 && text[6] == 114 as i8 && text[7] == 105 as i8 && text[8] == 110 as i8 && text[9] == 103 as i8 && text[10] == 95 as i8 && text[11] == 112 as i8 && text[12] == 111 as i8 && text[13] == 108 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 121 as i8 { return TokenKind::MonitoringPolicyLower }    // "monitoring_policy"
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 110 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 116 as i8 && text[7] == 105 as i8 && text[8] == 111 as i8 && text[9] == 110 as i8 && text[10] == 95 as i8 && text[11] == 112 as i8 && text[12] == 111 as i8 && text[13] == 108 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 121 as i8 { return TokenKind::TransitionPolicyLower }    // "transition_policy"
    }

    // Length 19: transition_protocol
    if len == 19 {
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 97 as i8 && text[3] == 110 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 116 as i8 && text[7] == 105 as i8 && text[8] == 111 as i8 && text[9] == 110 as i8 && text[10] == 95 as i8 && text[11] == 112 as i8 && text[12] == 114 as i8 && text[13] == 111 as i8 && text[14] == 116 as i8 && text[15] == 111 as i8 && text[16] == 99 as i8 && text[17] == 111 as i8 && text[18] == 108 as i8 { return TokenKind::TransitionProtocolLower }    // "transition_protocol"
    }

    // Length 15: decision_policy, deferral_policy, AcquisitionPlan, recourse_policy, CapabilityGated
    if len == 15 {
        if text[0] == 65 as i8 && text[1] == 99 as i8 && text[2] == 113 as i8 && text[3] == 117 as i8 && text[4] == 105 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 111 as i8 && text[10] == 110 as i8 && text[11] == 80 as i8 && text[12] == 108 as i8 && text[13] == 97 as i8 && text[14] == 110 as i8 { return TokenKind::AcquisitionPlan }    // "AcquisitionPlan"
        if text[0] == 100 as i8 && text[1] == 101 as i8 && text[2] == 102 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 114 as i8 && text[6] == 97 as i8 && text[7] == 108 as i8 && text[8] == 95 as i8 && text[9] == 112 as i8 && text[10] == 111 as i8 && text[11] == 108 as i8 && text[12] == 105 as i8 && text[13] == 99 as i8 && text[14] == 121 as i8 { return TokenKind::DeferralPolicyLower }   // "deferral_policy"
        if text[0] == 100 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 105 as i8 && text[4] == 115 as i8 && text[5] == 105 as i8 && text[6] == 111 as i8 && text[7] == 110 as i8 && text[8] == 95 as i8 && text[9] == 112 as i8 && text[10] == 111 as i8 && text[11] == 108 as i8 && text[12] == 105 as i8 && text[13] == 99 as i8 && text[14] == 121 as i8 { return TokenKind::DecisionPolicyLower }   // "decision_policy"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 99 as i8 && text[3] == 111 as i8 && text[4] == 117 as i8 && text[5] == 114 as i8 && text[6] == 115 as i8 && text[7] == 101 as i8 && text[8] == 95 as i8 && text[9] == 112 as i8 && text[10] == 111 as i8 && text[11] == 108 as i8 && text[12] == 105 as i8 && text[13] == 99 as i8 && text[14] == 121 as i8 { return TokenKind::RecoursePolicyLower }   // "recourse_policy"
        if text[0] == 67 as i8 && text[1] == 97 as i8 && text[2] == 112 as i8 && text[3] == 97 as i8 && text[4] == 98 as i8 && text[5] == 105 as i8 && text[6] == 108 as i8 && text[7] == 105 as i8 && text[8] == 116 as i8 && text[9] == 121 as i8 && text[10] == 71 as i8 && text[11] == 97 as i8 && text[12] == 116 as i8 && text[13] == 101 as i8 && text[14] == 100 as i8 { return TokenKind::CapabilityGated }   // "CapabilityGated"
    }

    // Length 17: AcquisitionPolicy, AlternativePolicy, AlternativeOption
    if len == 17 {
        if text[0] == 65 as i8 && text[1] == 99 as i8 && text[2] == 113 as i8 && text[3] == 117 as i8 && text[4] == 105 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 111 as i8 && text[10] == 110 as i8 && text[11] == 80 as i8 && text[12] == 111 as i8 && text[13] == 108 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 121 as i8 { return TokenKind::AcquisitionPolicy }   // "AcquisitionPolicy"
        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 79 as i8 && text[12] == 112 as i8 && text[13] == 116 as i8 && text[14] == 105 as i8 && text[15] == 111 as i8 && text[16] == 110 as i8 { return TokenKind::AlternativeOption }   // "AlternativeOption"
        if text[0] == 65 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 80 as i8 && text[12] == 111 as i8 && text[13] == 108 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 121 as i8 { return TokenKind::AlternativePolicy }   // "AlternativePolicy"
    }

    // Length 18: acquisition_policy, alternative_policy, ObservedTransition
    if len == 18 {
        if text[0] == 79 as i8 && text[1] == 98 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 118 as i8 && text[6] == 101 as i8 && text[7] == 100 as i8 && text[8] == 84 as i8 && text[9] == 114 as i8 && text[10] == 97 as i8 && text[11] == 110 as i8 && text[12] == 115 as i8 && text[13] == 105 as i8 && text[14] == 116 as i8 && text[15] == 105 as i8 && text[16] == 111 as i8 && text[17] == 110 as i8 { return TokenKind::ObservedTransition }   // "ObservedTransition"
        if text[0] == 97 as i8 && text[1] == 99 as i8 && text[2] == 113 as i8 && text[3] == 117 as i8 && text[4] == 105 as i8 && text[5] == 115 as i8 && text[6] == 105 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 111 as i8 && text[10] == 110 as i8 && text[11] == 95 as i8 && text[12] == 112 as i8 && text[13] == 111 as i8 && text[14] == 108 as i8 && text[15] == 105 as i8 && text[16] == 99 as i8 && text[17] == 121 as i8 { return TokenKind::AcquisitionPolicyLower }   // "acquisition_policy"
        if text[0] == 97 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 95 as i8 && text[12] == 112 as i8 && text[13] == 111 as i8 && text[14] == 108 as i8 && text[15] == 105 as i8 && text[16] == 99 as i8 && text[17] == 121 as i8 { return TokenKind::AlternativePolicyLower }   // "alternative_policy"
    }

    // Length 19: RollbackCertificate
    if len == 19 {
        if text[0] == 82 as i8 && text[1] == 111 as i8 && text[2] == 108 as i8 && text[3] == 108 as i8 && text[4] == 98 as i8 && text[5] == 97 as i8 && text[6] == 99 as i8 && text[7] == 107 as i8 && text[8] == 67 as i8 && text[9] == 101 as i8 && text[10] == 114 as i8 && text[11] == 116 as i8 && text[12] == 105 as i8 && text[13] == 102 as i8 && text[14] == 105 as i8 && text[15] == 99 as i8 && text[16] == 97 as i8 && text[17] == 116 as i8 && text[18] == 101 as i8 { return TokenKind::RollbackCertificate }   // "RollbackCertificate"
    }

    // Length 20: alternative_frontier
    if len == 20 {
        if text[0] == 97 as i8 && text[1] == 108 as i8 && text[2] == 116 as i8 && text[3] == 101 as i8 && text[4] == 114 as i8 && text[5] == 110 as i8 && text[6] == 97 as i8 && text[7] == 116 as i8 && text[8] == 105 as i8 && text[9] == 118 as i8 && text[10] == 101 as i8 && text[11] == 95 as i8 && text[12] == 102 as i8 && text[13] == 114 as i8 && text[14] == 111 as i8 && text[15] == 110 as i8 && text[16] == 116 as i8 && text[17] == 105 as i8 && text[18] == 101 as i8 && text[19] == 114 as i8 { return TokenKind::AlternativeFrontierLower }   // "alternative_frontier"
    }

    // Length 5: route
    if len == 5 {
        if text[0] == 114 as i8 && text[1] == 111 as i8 && text[2] == 117 as i8 && text[3] == 116 as i8 && text[4] == 101 as i8 { return TokenKind::Route }   // "route"
    }

    TokenKind::Ident
}

// ============================================================================
// SCAN RESULT
// ============================================================================

pub struct ScanResult {
    cursor: Cursor,
    kind: TokenKind,
    start: i64,
    end: i64,
    text: [i8; 256],
    text_len: i64,
}

impl ScanResult {
    pub fn new(cur: Cursor, kind: TokenKind, start: i64, end: i64) -> ScanResult {
        // Inline Cursor fields to avoid IS_SPTR=1 cursor: cur embedding bug.
        // cur.source_len etc. read through the IS_SPTR=1 pointer correctly.
        ScanResult {
            cursor: Cursor {
                source_len: cur.source_len,
                pos: cur.pos,
                line: cur.line,
                col: cur.col,
                current: cur.current,
            },
            kind: kind,
            start: start,
            end: end,
            text: [0; 256],
            text_len: 0,
        }
    }

    pub fn with_text(cur: Cursor, kind: TokenKind, start: i64, end: i64, text: [i8; 256], text_len: i64) -> ScanResult {
        ScanResult {
            cursor: Cursor {
                source_len: cur.source_len,
                pos: cur.pos,
                line: cur.line,
                col: cur.col,
                current: cur.current,
            },
            kind: kind,
            start: start,
            end: end,
            text: text,
            text_len: text_len,
        }
    }
}

// ============================================================================
// OPERATOR SCANNING (longest match)
// ============================================================================

pub fn scan_operator(c: Cursor) -> ScanResult with Mut, Div, Panic {
    // Read scalars from IS_SPTR=1 c via pointer deref — correct.
    // Compute advance count N directly; operators never contain newlines.
    let start: i64 = c.pos
    var kind = TokenKind::Error

    let c1: i8 = c.current
    let c2: i8 = c.peek()
    let c3: i8 = c.peek_n(2)

    var n: i64 = 0

    // 3-char operators
    if c1 == 46 && c2 == 46 && c3 == 46 { n = 3; kind = TokenKind::DotDotDot }
    else if c1 == 46 && c2 == 46 && c3 == 61 { n = 3; kind = TokenKind::DotDotEq }
    else if c1 == 60 && c2 == 60 && c3 == 61 { n = 3; kind = TokenKind::ShlEq }
    else if c1 == 62 && c2 == 62 && c3 == 61 { n = 3; kind = TokenKind::ShrEq }
    // 2-char operators
    else if c1 == 61 && c2 == 61 { n = 2; kind = TokenKind::EqEq }
    else if c1 == 33 && c2 == 61 { n = 2; kind = TokenKind::BangEq }
    else if c1 == 60 && c2 == 61 { n = 2; kind = TokenKind::LtEq }
    else if c1 == 62 && c2 == 61 { n = 2; kind = TokenKind::GtEq }
    else if c1 == 38 && c2 == 38 { n = 2; kind = TokenKind::AmpAmp }
    else if c1 == 124 && c2 == 124 { n = 2; kind = TokenKind::PipePipe }
    else if c1 == 60 && c2 == 60 { n = 2; kind = TokenKind::Shl }
    else if c1 == 62 && c2 == 62 { n = 2; kind = TokenKind::Shr }
    else if c1 == 43 && c2 == 61 { n = 2; kind = TokenKind::PlusEq }
    else if c1 == 45 && c2 == 61 { n = 2; kind = TokenKind::MinusEq }
    else if c1 == 42 && c2 == 61 { n = 2; kind = TokenKind::StarEq }
    else if c1 == 47 && c2 == 61 { n = 2; kind = TokenKind::SlashEq }
    else if c1 == 37 && c2 == 61 { n = 2; kind = TokenKind::PercentEq }
    else if c1 == 38 && c2 == 61 { n = 2; kind = TokenKind::AmpEq }
    else if c1 == 124 && c2 == 61 { n = 2; kind = TokenKind::PipeEq }
    else if c1 == 94 && c2 == 61 { n = 2; kind = TokenKind::CaretEq }
    else if c1 == 45 && c2 == 62 { n = 2; kind = TokenKind::Arrow }
    else if c1 == 61 && c2 == 62 { n = 2; kind = TokenKind::FatArrow }
    else if c1 == 60 && c2 == 45 { n = 2; kind = TokenKind::LeftArrow }
    else if c1 == 38 && c2 == 33 { n = 2; kind = TokenKind::AmpBang }
    else if c1 == 58 && c2 == 58 { n = 2; kind = TokenKind::ColonColon }
    else if c1 == 46 && c2 == 46 { n = 2; kind = TokenKind::DotDot }
    else if c1 == 43 && c2 == 43 { n = 2; kind = TokenKind::PlusPlus }
    else if c1 == 43 && c2 == 45 { n = 2; kind = TokenKind::PlusMinus }
    // 1-char operators
    else if c1 == 43 { n = 1; kind = TokenKind::Plus }
    else if c1 == 45 { n = 1; kind = TokenKind::Minus }
    else if c1 == 42 { n = 1; kind = TokenKind::Star }
    else if c1 == 47 { n = 1; kind = TokenKind::Slash }
    else if c1 == 37 { n = 1; kind = TokenKind::Percent }
    else if c1 == 61 { n = 1; kind = TokenKind::Eq }
    else if c1 == 60 { n = 1; kind = TokenKind::Lt }
    else if c1 == 62 { n = 1; kind = TokenKind::Gt }
    else if c1 == 33 { n = 1; kind = TokenKind::Bang }
    else if c1 == 38 { n = 1; kind = TokenKind::Amp }
    else if c1 == 124 { n = 1; kind = TokenKind::Pipe }
    else if c1 == 94 { n = 1; kind = TokenKind::Caret }
    else if c1 == 126 { n = 1; kind = TokenKind::Tilde }
    else if c1 == 63 { n = 1; kind = TokenKind::Question }

    // Operators contain no newlines: line unchanged, col += n
    let source_len: i64 = c.source_len
    let pos: i64 = c.pos + n
    let col: i64 = c.col + n
    let line: i64 = c.line
    var current: i8 = 0 as i8
    if pos < source_len { current = CURSOR_SOURCE[pos as usize] }
    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, end)
}

// ============================================================================
// DELIMITER AND PUNCTUATION SCANNING
// ============================================================================

pub fn scan_delimiter(c: Cursor) -> ScanResult with Mut, Panic {
    let start: i64 = c.pos
    let ch: i8 = c.current
    var kind = TokenKind::Error
    var matched = false

    if ch == 40 { kind = TokenKind::LParen; matched = true }
    else if ch == 41 { kind = TokenKind::RParen; matched = true }
    else if ch == 123 { kind = TokenKind::LBrace; matched = true }
    else if ch == 125 { kind = TokenKind::RBrace; matched = true }
    else if ch == 91 { kind = TokenKind::LBracket; matched = true }
    else if ch == 93 { kind = TokenKind::RBracket; matched = true }

    let source_len: i64 = c.source_len
    var pos: i64 = c.pos
    var col: i64 = c.col
    var current: i8 = c.current
    let line: i64 = c.line

    if matched {
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, end)
}

pub fn scan_punctuation(c: Cursor) -> ScanResult with Mut, Panic {
    let start: i64 = c.pos
    let ch: i8 = c.current
    var kind = TokenKind::Error
    var matched = false

    if ch == 59 { kind = TokenKind::Semi; matched = true }
    else if ch == 58 { kind = TokenKind::Colon; matched = true }
    else if ch == 44 { kind = TokenKind::Comma; matched = true }
    else if ch == 46 { kind = TokenKind::Dot; matched = true }
    else if ch == 64 { kind = TokenKind::At; matched = true }
    else if ch == 35 { kind = TokenKind::Hash; matched = true }

    let source_len: i64 = c.source_len
    var pos: i64 = c.pos
    var col: i64 = c.col
    var current: i8 = c.current
    let line: i64 = c.line

    if matched {
        col = col + 1
        pos = pos + 1
        if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
    }

    let end = pos
    let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    ScanResult::new(result_cursor, kind, start, end)
}
