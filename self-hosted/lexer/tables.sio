// self-hosted::lexer::tables — Keyword lookup and operator scanning
//
// keyword_lookup: byte-by-byte comparison grouped by length, returns TokenKind
// scan_operator: longest-match (3-char > 2-char > 1-char)
// scan_delimiter: single-char delimiters and punctuation
// ScanResult carries cursor state and token info with impl block.

// ============================================================================
// KEYWORD LOOKUP
// ============================================================================
// Returns TokenKind::Ident if no keyword match.
// All comparisons use ASCII i8 values.

fn keyword_lookup(text: [i8; 256], len: i64) -> TokenKind with Panic {
    // Length 2: fn, if, in, as, is
    if len == 2 {
        if text[0] == 102 && text[1] == 110 { return TokenKind::Fn }          // "fn"
        if text[0] == 105 && text[1] == 102 { return TokenKind::If }          // "if"
        if text[0] == 105 && text[1] == 110 { return TokenKind::In }          // "in"
        if text[0] == 97 && text[1] == 115 { return TokenKind::As }           // "as"
        if text[0] == 105 && text[1] == 115 { return TokenKind::Is }          // "is"
    }

    // Length 3: let, var, mut, for, pub, use, ref, dyn, box
    if len == 3 {
        if text[0] == 108 && text[1] == 101 && text[2] == 116 { return TokenKind::Let }   // "let"
        if text[0] == 118 && text[1] == 97 && text[2] == 114 { return TokenKind::Var }    // "var"
        if text[0] == 109 && text[1] == 117 && text[2] == 116 { return TokenKind::Mut }   // "mut"
        if text[0] == 102 && text[1] == 111 && text[2] == 114 { return TokenKind::For }   // "for"
        if text[0] == 112 && text[1] == 117 && text[2] == 98 { return TokenKind::Pub }    // "pub"
        if text[0] == 117 && text[1] == 115 && text[2] == 101 { return TokenKind::Use }   // "use"
        if text[0] == 114 && text[1] == 101 && text[2] == 102 { return TokenKind::Ref }   // "ref"
        if text[0] == 100 && text[1] == 121 && text[2] == 110 { return TokenKind::Dyn }   // "dyn"
        if text[0] == 98 && text[1] == 111 && text[2] == 120 { return TokenKind::Box }    // "box"
    }

    // Length 4: type, enum, impl, else, loop, self, Self, with, true, move, copy, drop
    if len == 4 {
        if text[0] == 116 && text[1] == 121 && text[2] == 112 && text[3] == 101 { return TokenKind::Type }        // "type"
        if text[0] == 101 && text[1] == 110 && text[2] == 117 && text[3] == 109 { return TokenKind::Enum }        // "enum"
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 108 { return TokenKind::Impl }        // "impl"
        if text[0] == 101 && text[1] == 108 && text[2] == 115 && text[3] == 101 { return TokenKind::Else }        // "else"
        if text[0] == 108 && text[1] == 111 && text[2] == 111 && text[3] == 112 { return TokenKind::Loop }        // "loop"
        if text[0] == 115 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return TokenKind::SelfLower }   // "self"
        if text[0] == 83 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return TokenKind::SelfUpper }    // "Self"
        if text[0] == 119 && text[1] == 105 && text[2] == 116 && text[3] == 104 { return TokenKind::With }        // "with"
        if text[0] == 116 && text[1] == 114 && text[2] == 117 && text[3] == 101 { return TokenKind::True }        // "true"
        if text[0] == 109 && text[1] == 111 && text[2] == 118 && text[3] == 101 { return TokenKind::Move }        // "move"
        if text[0] == 99 && text[1] == 111 && text[2] == 112 && text[3] == 121 { return TokenKind::Copy }         // "copy"
        if text[0] == 100 && text[1] == 114 && text[2] == 111 && text[3] == 112 { return TokenKind::Drop }        // "drop"
    }

    // Length 5: const, trait, match, while, break, where, false, async, await, spawn, infer, prior, super, crate
    if len == 5 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 115 && text[4] == 116 { return TokenKind::Const }    // "const"
        if text[0] == 116 && text[1] == 114 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return TokenKind::Trait }    // "trait"
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 99 && text[4] == 104 { return TokenKind::Match }     // "match"
        if text[0] == 119 && text[1] == 104 && text[2] == 105 && text[3] == 108 && text[4] == 101 { return TokenKind::While }   // "while"
        if text[0] == 98 && text[1] == 114 && text[2] == 101 && text[3] == 97 && text[4] == 107 { return TokenKind::Break }     // "break"
        if text[0] == 119 && text[1] == 104 && text[2] == 101 && text[3] == 114 && text[4] == 101 { return TokenKind::Where }   // "where"
        if text[0] == 102 && text[1] == 97 && text[2] == 108 && text[3] == 115 && text[4] == 101 { return TokenKind::False }    // "false"
        if text[0] == 97 && text[1] == 115 && text[2] == 121 && text[3] == 110 && text[4] == 99 { return TokenKind::Async }     // "async"
        if text[0] == 97 && text[1] == 119 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return TokenKind::Await }     // "await"
        if text[0] == 115 && text[1] == 112 && text[2] == 97 && text[3] == 119 && text[4] == 110 { return TokenKind::Spawn }    // "spawn"
        if text[0] == 105 && text[1] == 110 && text[2] == 102 && text[3] == 101 && text[4] == 114 { return TokenKind::Infer }   // "infer"
        if text[0] == 112 && text[1] == 114 && text[2] == 105 && text[3] == 111 && text[4] == 114 { return TokenKind::Prior }   // "prior"
        if text[0] == 115 && text[1] == 117 && text[2] == 112 && text[3] == 101 && text[4] == 114 { return TokenKind::Super }   // "super"
        if text[0] == 99 && text[1] == 114 && text[2] == 97 && text[3] == 116 && text[4] == 101 { return TokenKind::Crate }     // "crate"
    }

    // Length 6: struct, return, effect, handle, linear, affine, kernel, resume, unsafe, extern, static, module, import, export, sample, belief
    if len == 6 {
        if text[0] == 115 && text[1] == 116 && text[2] == 114 && text[3] == 117 && text[4] == 99 && text[5] == 116 { return TokenKind::Struct }     // "struct"
        if text[0] == 114 && text[1] == 101 && text[2] == 116 && text[3] == 117 && text[4] == 114 && text[5] == 110 { return TokenKind::Return }     // "return"
        if text[0] == 101 && text[1] == 102 && text[2] == 102 && text[3] == 101 && text[4] == 99 && text[5] == 116 { return TokenKind::Effect }      // "effect"
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 { return TokenKind::Handle }      // "handle"
        if text[0] == 108 && text[1] == 105 && text[2] == 110 && text[3] == 101 && text[4] == 97 && text[5] == 114 { return TokenKind::Linear }      // "linear"
        if text[0] == 97 && text[1] == 102 && text[2] == 102 && text[3] == 105 && text[4] == 110 && text[5] == 101 { return TokenKind::Affine }      // "affine"
        if text[0] == 107 && text[1] == 101 && text[2] == 114 && text[3] == 110 && text[4] == 101 && text[5] == 108 { return TokenKind::Kernel }     // "kernel"
        if text[0] == 114 && text[1] == 101 && text[2] == 115 && text[3] == 117 && text[4] == 109 && text[5] == 101 { return TokenKind::Resume }     // "resume"
        if text[0] == 117 && text[1] == 110 && text[2] == 115 && text[3] == 97 && text[4] == 102 && text[5] == 101 { return TokenKind::Unsafe }      // "unsafe"
        if text[0] == 101 && text[1] == 120 && text[2] == 116 && text[3] == 101 && text[4] == 114 && text[5] == 110 { return TokenKind::Extern }     // "extern"
        if text[0] == 115 && text[1] == 116 && text[2] == 97 && text[3] == 116 && text[4] == 105 && text[5] == 99 { return TokenKind::Static }       // "static"
        if text[0] == 109 && text[1] == 111 && text[2] == 100 && text[3] == 117 && text[4] == 108 && text[5] == 101 { return TokenKind::Module }     // "module"
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return TokenKind::Import }     // "import"
        if text[0] == 101 && text[1] == 120 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return TokenKind::Export }     // "export"
        if text[0] == 115 && text[1] == 97 && text[2] == 109 && text[3] == 112 && text[4] == 108 && text[5] == 101 { return TokenKind::Sample }      // "sample"
        if text[0] == 98 && text[1] == 101 && text[2] == 108 && text[3] == 105 && text[4] == 101 && text[5] == 102 { return TokenKind::Belief }      // "belief"
    }

    // Length 7: handler, perform, observe, entropy
    if len == 7 {
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 && text[6] == 114 { return TokenKind::Handler }    // "handler"
        if text[0] == 112 && text[1] == 101 && text[2] == 114 && text[3] == 102 && text[4] == 111 && text[5] == 114 && text[6] == 109 { return TokenKind::Perform }    // "perform"
        if text[0] == 111 && text[1] == 98 && text[2] == 115 && text[3] == 101 && text[4] == 114 && text[5] == 118 && text[6] == 101 { return TokenKind::Observe }     // "observe"
        if text[0] == 101 && text[1] == 110 && text[2] == 116 && text[3] == 114 && text[4] == 111 && text[5] == 112 && text[6] == 121 { return TokenKind::Entropy }    // "entropy"
    }

    // Length 8: continue, evidence
    if len == 8 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 116 && text[4] == 105 && text[5] == 110 && text[6] == 117 && text[7] == 101 { return TokenKind::Continue }    // "continue"
        if text[0] == 101 && text[1] == 118 && text[2] == 105 && text[3] == 100 && text[4] == 101 && text[5] == 110 && text[6] == 99 && text[7] == 101 { return TokenKind::Evidence }     // "evidence"
    }

    // Length 9: uncertain, posterior
    if len == 9 {
        if text[0] == 117 && text[1] == 110 && text[2] == 99 && text[3] == 101 && text[4] == 114 && text[5] == 116 && text[6] == 97 && text[7] == 105 && text[8] == 110 { return TokenKind::Uncertain }    // "uncertain"
        if text[0] == 112 && text[1] == 111 && text[2] == 115 && text[3] == 116 && text[4] == 101 && text[5] == 114 && text[6] == 105 && text[7] == 111 && text[8] == 114 { return TokenKind::Posterior }   // "posterior"
    }

    // Length 10: confidence, likelihood
    if len == 10 {
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 102 && text[4] == 105 && text[5] == 100 && text[6] == 101 && text[7] == 110 && text[8] == 99 && text[9] == 101 { return TokenKind::Confidence }    // "confidence"
        if text[0] == 108 && text[1] == 105 && text[2] == 107 && text[3] == 101 && text[4] == 108 && text[5] == 105 && text[6] == 104 && text[7] == 111 && text[8] == 111 && text[9] == 100 { return TokenKind::Likelihood }   // "likelihood"
    }

    TokenKind::Ident
}

// ============================================================================
// SCAN RESULT
// ============================================================================

struct ScanResult {
    cursor: Cursor,
    kind: TokenKind,
    start: i64,
    end: i64,
    text: [i8; 256],
    text_len: i64,
}

impl ScanResult {
    fn new(cur: Cursor, kind: TokenKind, start: i64, end: i64) -> ScanResult {
        ScanResult {
            cursor: cur,
            kind: kind,
            start: start,
            end: end,
            text: [0; 256],
            text_len: 0,
        }
    }

    fn with_text(cur: Cursor, kind: TokenKind, start: i64, end: i64, text: [i8; 256], text_len: i64) -> ScanResult {
        ScanResult {
            cursor: cur,
            kind: kind,
            start: start,
            end: end,
            text: text,
            text_len: text_len,
        }
    }
}

// ============================================================================
// OPERATOR SCANNING (longest match)
// ============================================================================

fn scan_operator(c: Cursor) -> ScanResult with Mut, Div, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error

    let c1 = cur.current
    let c2 = cur.peek()
    let c3 = cur.peek_n(2)

    // 3-char operators
    if c1 == 46 && c2 == 46 && c3 == 46 {  // "..."
        cur = cur.advance_n(3)
        kind = TokenKind::DotDotDot
    } else if c1 == 46 && c2 == 46 && c3 == 61 {  // "..="
        cur = cur.advance_n(3)
        kind = TokenKind::DotDotEq
    } else if c1 == 60 && c2 == 60 && c3 == 61 {  // "<<="
        cur = cur.advance_n(3)
        kind = TokenKind::ShlEq
    } else if c1 == 62 && c2 == 62 && c3 == 61 {  // ">>="
        cur = cur.advance_n(3)
        kind = TokenKind::ShrEq
    }
    // 2-char operators
    else if c1 == 61 && c2 == 61 {  // "=="
        cur = cur.advance_n(2)
        kind = TokenKind::EqEq
    } else if c1 == 33 && c2 == 61 {  // "!="
        cur = cur.advance_n(2)
        kind = TokenKind::BangEq
    } else if c1 == 60 && c2 == 61 {  // "<="
        cur = cur.advance_n(2)
        kind = TokenKind::LtEq
    } else if c1 == 62 && c2 == 61 {  // ">="
        cur = cur.advance_n(2)
        kind = TokenKind::GtEq
    } else if c1 == 38 && c2 == 38 {  // "&&"
        cur = cur.advance_n(2)
        kind = TokenKind::AmpAmp
    } else if c1 == 124 && c2 == 124 {  // "||"
        cur = cur.advance_n(2)
        kind = TokenKind::PipePipe
    } else if c1 == 60 && c2 == 60 {  // "<<"
        cur = cur.advance_n(2)
        kind = TokenKind::Shl
    } else if c1 == 62 && c2 == 62 {  // ">>"
        cur = cur.advance_n(2)
        kind = TokenKind::Shr
    } else if c1 == 43 && c2 == 61 {  // "+="
        cur = cur.advance_n(2)
        kind = TokenKind::PlusEq
    } else if c1 == 45 && c2 == 61 {  // "-="
        cur = cur.advance_n(2)
        kind = TokenKind::MinusEq
    } else if c1 == 42 && c2 == 61 {  // "*="
        cur = cur.advance_n(2)
        kind = TokenKind::StarEq
    } else if c1 == 47 && c2 == 61 {  // "/="
        cur = cur.advance_n(2)
        kind = TokenKind::SlashEq
    } else if c1 == 37 && c2 == 61 {  // "%="
        cur = cur.advance_n(2)
        kind = TokenKind::PercentEq
    } else if c1 == 38 && c2 == 61 {  // "&="
        cur = cur.advance_n(2)
        kind = TokenKind::AmpEq
    } else if c1 == 124 && c2 == 61 {  // "|="
        cur = cur.advance_n(2)
        kind = TokenKind::PipeEq
    } else if c1 == 94 && c2 == 61 {  // "^="
        cur = cur.advance_n(2)
        kind = TokenKind::CaretEq
    } else if c1 == 45 && c2 == 62 {  // "->"
        cur = cur.advance_n(2)
        kind = TokenKind::Arrow
    } else if c1 == 61 && c2 == 62 {  // "=>"
        cur = cur.advance_n(2)
        kind = TokenKind::FatArrow
    } else if c1 == 60 && c2 == 45 {  // "<-"
        cur = cur.advance_n(2)
        kind = TokenKind::LeftArrow
    } else if c1 == 38 && c2 == 33 {  // "&!"
        cur = cur.advance_n(2)
        kind = TokenKind::AmpBang
    } else if c1 == 58 && c2 == 58 {  // "::"
        cur = cur.advance_n(2)
        kind = TokenKind::ColonColon
    } else if c1 == 46 && c2 == 46 {  // ".."
        cur = cur.advance_n(2)
        kind = TokenKind::DotDot
    } else if c1 == 43 && c2 == 43 {  // "++"
        cur = cur.advance_n(2)
        kind = TokenKind::PlusPlus
    } else if c1 == 43 && c2 == 45 {  // "+-" (±)
        cur = cur.advance_n(2)
        kind = TokenKind::PlusMinus
    }
    // 1-char operators
    else if c1 == 43 {  // "+"
        cur = cur.advance()
        kind = TokenKind::Plus
    } else if c1 == 45 {  // "-"
        cur = cur.advance()
        kind = TokenKind::Minus
    } else if c1 == 42 {  // "*"
        cur = cur.advance()
        kind = TokenKind::Star
    } else if c1 == 47 {  // "/"
        cur = cur.advance()
        kind = TokenKind::Slash
    } else if c1 == 37 {  // "%"
        cur = cur.advance()
        kind = TokenKind::Percent
    } else if c1 == 61 {  // "="
        cur = cur.advance()
        kind = TokenKind::Eq
    } else if c1 == 60 {  // "<"
        cur = cur.advance()
        kind = TokenKind::Lt
    } else if c1 == 62 {  // ">"
        cur = cur.advance()
        kind = TokenKind::Gt
    } else if c1 == 33 {  // "!"
        cur = cur.advance()
        kind = TokenKind::Bang
    } else if c1 == 38 {  // "&"
        cur = cur.advance()
        kind = TokenKind::Amp
    } else if c1 == 124 {  // "|"
        cur = cur.advance()
        kind = TokenKind::Pipe
    } else if c1 == 94 {  // "^"
        cur = cur.advance()
        kind = TokenKind::Caret
    } else if c1 == 126 {  // "~"
        cur = cur.advance()
        kind = TokenKind::Tilde
    } else if c1 == 63 {  // "?"
        cur = cur.advance()
        kind = TokenKind::Question
    }

    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}

// ============================================================================
// DELIMITER AND PUNCTUATION SCANNING
// ============================================================================

fn scan_delimiter(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error
    var matched = false

    let ch = cur.current

    if ch == 40 { kind = TokenKind::LParen; matched = true }
    else if ch == 41 { kind = TokenKind::RParen; matched = true }
    else if ch == 123 { kind = TokenKind::LBrace; matched = true }
    else if ch == 125 { kind = TokenKind::RBrace; matched = true }
    else if ch == 91 { kind = TokenKind::LBracket; matched = true }
    else if ch == 93 { kind = TokenKind::RBracket; matched = true }

    if matched {
        cur = cur.advance()
    }

    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}

fn scan_punctuation(c: Cursor) -> ScanResult with Mut, Panic {
    var cur = c
    let start = cur.pos
    var kind = TokenKind::Error
    var matched = false

    let ch = cur.current

    if ch == 59 { kind = TokenKind::Semi; matched = true }
    else if ch == 58 { kind = TokenKind::Colon; matched = true }
    else if ch == 44 { kind = TokenKind::Comma; matched = true }
    else if ch == 46 { kind = TokenKind::Dot; matched = true }
    else if ch == 64 { kind = TokenKind::At; matched = true }
    else if ch == 35 { kind = TokenKind::Hash; matched = true }

    if matched {
        cur = cur.advance()
    }

    let end = cur.pos
    ScanResult::new(cur, kind, start, end)
}
