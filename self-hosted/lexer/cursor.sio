// self-hosted::lexer::cursor — Character-level source code iteration
//
// Cursor tracks position, line, and column through source bytes.
// All character comparisons use ASCII i8 values.
// State is returned (not mutated in-place) to match Sounio idiom.

// ============================================================================
// CURSOR STATE
// ============================================================================

struct Cursor {
    source: [i8; 1048576],
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

fn cursor_new() -> Cursor {
    Cursor {
        source: [0; 1048576],
        source_len: 0,
        pos: 0,
        line: 1,
        col: 1,
        current: 0,
    }
}

fn cursor_init(source: [i8; 1048576], len: i64) -> Cursor {
    var c = cursor_new()
    c.source = source
    c.source_len = len
    if len > 0 {
        c.current = source[0]
    }
    c
}

// ============================================================================
// POSITION QUERIES
// ============================================================================

fn cursor_is_eof(c: Cursor) -> bool {
    c.pos >= c.source_len
}

fn cursor_peek(c: Cursor) -> i8 with Panic {
    if c.pos + 1 < c.source_len {
        c.source[(c.pos + 1) as usize]
    } else {
        0
    }
}

fn cursor_peek_n(c: Cursor, n: i64) -> i8 with Panic {
    if c.pos + n < c.source_len {
        c.source[(c.pos + n) as usize]
    } else {
        0
    }
}

fn cursor_pos(c: Cursor) -> i64 { c.pos }
fn cursor_line(c: Cursor) -> i64 { c.line }
fn cursor_col(c: Cursor) -> i64 { c.col }

// ============================================================================
// MOVEMENT
// ============================================================================

fn cursor_advance(c: Cursor) -> Cursor with Mut, Panic {
    var nc = c
    if nc.pos < nc.source_len {
        if nc.current == 10 {  // '\n'
            nc.line = nc.line + 1
            nc.col = 1
        } else {
            nc.col = nc.col + 1
        }
        nc.pos = nc.pos + 1
        if nc.pos < nc.source_len {
            nc.current = nc.source[nc.pos as usize]
        } else {
            nc.current = 0
        }
    }
    nc
}

fn cursor_advance_n(c: Cursor, n: i64) -> Cursor with Mut, Div, Panic {
    var cur = c
    var i: i64 = 0
    while i < n {
        cur = cursor_advance(cur)
        i = i + 1
    }
    cur
}

// Consume chars while predicate holds; returns (new_cursor, collected_text, text_len)
// Since we can't return tuples with complex types, we use a result struct.
struct BumpResult {
    cursor: Cursor,
    text: [i8; 256],
    text_len: i64,
}

fn cursor_bump_while_ident(c: Cursor) -> BumpResult with Mut, Panic {
    var cur = c
    var text: [i8; 256] = [0; 256]
    var idx: i64 = 0
    while !cursor_is_eof(cur) && is_ident_continue(cur.current) && idx < 256 {
        text[idx as usize] = cur.current
        idx = idx + 1
        cur = cursor_advance(cur)
    }
    BumpResult { cursor: cur, text: text, text_len: idx }
}

fn cursor_bump_while_digit(c: Cursor) -> Cursor with Mut, Panic {
    var cur = c
    while !cursor_is_eof(cur) && is_digit(cur.current) {
        cur = cursor_advance(cur)
    }
    cur
}

fn cursor_bump_while_hex(c: Cursor) -> Cursor with Mut, Panic {
    var cur = c
    while !cursor_is_eof(cur) && is_hex_digit(cur.current) {
        cur = cursor_advance(cur)
    }
    cur
}

// ============================================================================
// CHARACTER CLASSIFICATION
// ============================================================================

fn is_whitespace(c: i8) -> bool {
    c == 32 || c == 9 || c == 13  // space, tab, CR (not LF)
}

fn is_whitespace_or_newline(c: i8) -> bool {
    c == 32 || c == 9 || c == 13 || c == 10
}

fn is_digit(c: i8) -> bool {
    c >= 48 && c <= 57  // '0'-'9'
}

fn is_hex_digit(c: i8) -> bool {
    is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)  // 0-9, a-f, A-F
}

fn is_bin_digit(c: i8) -> bool {
    c == 48 || c == 49  // '0' or '1'
}

fn is_oct_digit(c: i8) -> bool {
    c >= 48 && c <= 55  // '0'-'7'
}

fn is_alpha(c: i8) -> bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122)  // A-Z, a-z
}

fn is_ident_start(c: i8) -> bool {
    is_alpha(c) || c == 95  // letters or '_'
}

fn is_ident_continue(c: i8) -> bool {
    is_alpha(c) || is_digit(c) || c == 95  // letters, digits, or '_'
}

fn is_operator_start(c: i8) -> bool {
    c == 43 || c == 45 || c == 42 || c == 47 || c == 37 ||  // + - * / %
    c == 61 || c == 60 || c == 62 || c == 33 || c == 38 ||  // = < > ! &
    c == 124 || c == 94 || c == 126 || c == 63               // | ^ ~ ?
}

fn is_delimiter(c: i8) -> bool {
    c == 40 || c == 41 || c == 123 || c == 125 ||  // ( ) { }
    c == 91 || c == 93                                // [ ]
}

fn is_punctuation(c: i8) -> bool {
    c == 59 || c == 58 || c == 44 || c == 46 ||  // ; : , .
    c == 64 || c == 35                             // @ #
}
