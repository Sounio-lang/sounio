// self-hosted::lexer::cursor — Character-level source code iteration
//
// Cursor tracks position, line, and column through source bytes.
// All character comparisons use ASCII i8 values.
// Impl block provides navigation methods; character classification
// remains as free functions.

// ============================================================================
// CURSOR STATE
// ============================================================================

// Keep source storage out of Cursor values so advance/peek operations do not
// copy a 1MB array on each call.
var CURSOR_SOURCE: [i8; 1048576] = [0; 1048576]
var CURSOR_SOURCE_LEN: i64 = 0

fn cursor_set_source(source: [i8; 1048576], len: i64) with Mut, Panic {
    var n = len
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }

    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = source[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
}

fn cursor_source_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < CURSOR_SOURCE_LEN {
        CURSOR_SOURCE[idx as usize]
    } else {
        0 as i8
    }
}

struct Cursor {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

struct BumpResult {
    cursor: Cursor,
    text: [i8; 256],
    text_len: i64,
}

// ============================================================================
// CHARACTER CLASSIFICATION
// ============================================================================

fn is_whitespace(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8  // space, tab, CR (not LF)
}

fn is_whitespace_or_newline(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8 || c == 10 as i8
}

fn is_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 57 as i8  // '0'-'9'
}

fn is_hex_digit(c: i8) -> bool {
    is_digit(c) || (c >= 97 as i8 && c <= 102 as i8) || (c >= 65 as i8 && c <= 70 as i8)  // 0-9, a-f, A-F
}

fn is_bin_digit(c: i8) -> bool {
    c == 48 as i8 || c == 49 as i8  // '0' or '1'
}

fn is_oct_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 55 as i8  // '0'-'7'
}

fn is_alpha(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) || (c >= 97 as i8 && c <= 122 as i8)  // A-Z, a-z
}

fn is_ident_start(c: i8) -> bool {
    is_alpha(c) || c == 95 as i8  // letters or '_'
}

fn is_ident_continue(c: i8) -> bool {
    is_alpha(c) || is_digit(c) || c == 95 as i8  // letters, digits, or '_'
}

fn is_operator_start(c: i8) -> bool {
    c == 43 as i8 || c == 45 as i8 || c == 42 as i8 || c == 47 as i8 || c == 37 as i8 ||  // + - * / %
    c == 61 as i8 || c == 60 as i8 || c == 62 as i8 || c == 33 as i8 || c == 38 as i8 ||  // = < > ! &
    c == 124 as i8 || c == 94 as i8 || c == 126 as i8 || c == 63 as i8               // | ^ ~ ?
}

fn is_delimiter(c: i8) -> bool {
    c == 40 as i8 || c == 41 as i8 || c == 123 as i8 || c == 125 as i8 ||  // ( ) { }
    c == 91 as i8 || c == 93 as i8                                // [ ]
}

fn is_punctuation(c: i8) -> bool {
    c == 59 as i8 || c == 58 as i8 || c == 44 as i8 || c == 46 as i8 ||  // ; : , .
    c == 64 as i8 || c == 35 as i8                             // @ #
}

// ============================================================================
// CURSOR METHODS
// ============================================================================

impl Cursor {
    fn new() -> Cursor {
        Cursor {
            source_len: 0,
            pos: 0,
            line: 1,
            col: 1,
            current: 0 as i8,
        }
    }

    fn init(source: [i8; 1048576], len: i64) -> Cursor with Mut, Panic {
        var c = Cursor::new()
        cursor_set_source(source, len)
        c.source_len = CURSOR_SOURCE_LEN
        if c.source_len > 0 {
            c.current = CURSOR_SOURCE[0]
        }
        c
    }

    fn is_eof(self) -> bool {
        self.pos >= self.source_len
    }

    fn peek(self) -> i8 with Panic {
        if self.pos + 1 < self.source_len {
            CURSOR_SOURCE[(self.pos + 1) as usize]
        } else {
            0 as i8
        }
    }

    fn peek_n(self, n: i64) -> i8 with Panic {
        if self.pos + n < self.source_len {
            CURSOR_SOURCE[(self.pos + n) as usize]
        } else {
            0 as i8
        }
    }

    fn advance(self) -> Cursor with Mut, Panic {
        var nc = self
        if nc.pos < nc.source_len {
            if nc.current == 10 as i8 {  // '\n'
                nc.line = nc.line + 1
                nc.col = 1
            } else {
                nc.col = nc.col + 1
            }
            nc.pos = nc.pos + 1
            if nc.pos < nc.source_len {
                nc.current = CURSOR_SOURCE[nc.pos as usize]
            } else {
                nc.current = 0 as i8
            }
        }
        nc
    }

    fn advance_n(self, n: i64) -> Cursor with Mut, Div, Panic {
        var cur = self
        var i: i64 = 0
        while i < n {
            cur = cur.advance()
            i = i + 1
        }
        cur
    }

    fn bump_while_ident(self) -> BumpResult with Mut, Div, Panic {
        var cur = self
        var text: [i8; 256] = [0; 256]
        var idx: i64 = 0
        while !cur.is_eof() && is_ident_continue(cur.current) && idx < 256 {
            text[idx as usize] = cur.current
            idx = idx + 1
            cur = cur.advance()
        }
        BumpResult { cursor: cur, text: text, text_len: idx }
    }

    fn bump_while_digit(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }

    fn bump_while_hex(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_hex_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }
}
