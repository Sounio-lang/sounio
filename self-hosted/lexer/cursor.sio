// self-hosted::lexer::cursor -- Character-level source code iteration
//
// Cursor tracks position, line, and column through source bytes.
// All character comparisons use ASCII i8 values.
// Impl block provides navigation methods; character classification
// remains as free functions.

module lexer::cursor

// ============================================================================
// CURSOR STATE
// ============================================================================

// Keep source storage out of Cursor values so advance/peek operations do not
// copy a 1MB array on each call.
pub var CURSOR_SOURCE: [i8; 2097152] = [0; 2097152]
pub var CURSOR_SOURCE_LEN: i64 = 0

pub fn cursor_set_source(source: [i8; 2097152], len: i64) with Mut, Panic, Div {
    var n = len
    if n < 0 { n = 0 }
    if n > 2097152 { n = 2097152 }

    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = source[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
}

pub fn cursor_source_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < CURSOR_SOURCE_LEN {
        CURSOR_SOURCE[idx as usize]
    } else {
        0 as i8
    }
}

pub struct Cursor {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

pub struct BumpResult {
    cursor: Cursor,
    text: [i8; 256],
    text_len: i64,
}

// ============================================================================
// CHARACTER CLASSIFICATION
// ============================================================================

pub fn is_whitespace(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8  // space, tab, CR (not LF)
}

pub fn is_whitespace_or_newline(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8 || c == 10 as i8
}

pub fn is_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 57 as i8  // '0'-'9'
}

pub fn is_hex_digit(c: i8) -> bool {
    is_digit(c) || (c >= 97 as i8 && c <= 102 as i8) || (c >= 65 as i8 && c <= 70 as i8)  // 0-9, a-f, A-F
}

pub fn is_bin_digit(c: i8) -> bool {
    c == 48 as i8 || c == 49 as i8  // '0' or '1'
}

pub fn is_oct_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 55 as i8  // '0'-'7'
}

pub fn is_alpha(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) || (c >= 97 as i8 && c <= 122 as i8)  // A-Z, a-z
}

pub fn is_ident_start(c: i8) -> bool {
    is_alpha(c) || c == 95 as i8  // letters or '_'
}

pub fn is_ident_continue(c: i8) -> bool {
    is_alpha(c) || is_digit(c) || c == 95 as i8  // letters, digits, or '_'
}

pub fn is_operator_start(c: i8) -> bool {
    c == 43 as i8 || c == 45 as i8 || c == 42 as i8 || c == 47 as i8 || c == 37 as i8 ||  // + - * / %
    c == 61 as i8 || c == 60 as i8 || c == 62 as i8 || c == 33 as i8 || c == 38 as i8 ||  // = < > ! &
    c == 124 as i8 || c == 94 as i8 || c == 126 as i8 || c == 63 as i8               // | ^ ~ ?
}

pub fn is_delimiter(c: i8) -> bool {
    c == 40 as i8 || c == 41 as i8 || c == 123 as i8 || c == 125 as i8 ||  // ( ) { }
    c == 91 as i8 || c == 93 as i8                                // [ ]
}

pub fn is_punctuation(c: i8) -> bool {
    c == 59 as i8 || c == 58 as i8 || c == 44 as i8 || c == 46 as i8 ||  // ; : , .
    c == 64 as i8 || c == 35 as i8                             // @ #
}

// ============================================================================
// CURSOR METHODS
// ============================================================================

impl Cursor {
    pub fn new() -> Cursor {
        Cursor {
            source_len: 0,
            pos: 0,
            line: 1,
            col: 1,
            current: 0 as i8,
        }
    }

    pub fn init(source: [i8; 2097152], len: i64) -> Cursor with Mut, Panic, Div {
        var c = Cursor::new()
        cursor_set_source(source, len)
        c.source_len = CURSOR_SOURCE_LEN
        if c.source_len > 0 {
            c.current = CURSOR_SOURCE[0]
        }
        c
    }

    pub fn is_eof(self) -> bool {
        self.pos >= self.source_len
    }

    pub fn peek(self) -> i8 with Panic {
        if self.pos + 1 < self.source_len {
            CURSOR_SOURCE[(self.pos + 1) as usize]
        } else {
            0 as i8
        }
    }

    pub fn peek_n(self, n: i64) -> i8 with Panic {
        if self.pos + n < self.source_len {
            CURSOR_SOURCE[(self.pos + n) as usize]
        } else {
            0 as i8
        }
    }

    pub fn advance(self) -> Cursor with Mut, Panic {
        // Extract to scalars — avoid IS_SPTR=1 SRET corruption (boot4: var nc = self → nc
        // inherits IS_SPTR=1, return nc reads garbage adjacent slots into SRET_BUF).
        var pos: i64 = self.pos
        let source_len: i64 = self.source_len
        var line: i64 = self.line
        var col: i64 = self.col
        var current: i8 = self.current
        if pos < source_len {
            if current == 10 as i8 {
                line = line + 1
                col = 1
            } else {
                col = col + 1
            }
            pos = pos + 1
            if pos < source_len {
                current = CURSOR_SOURCE[pos as usize]
            } else {
                current = 0 as i8
            }
        }
        Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    }

    pub fn advance_n(self, n: i64) -> Cursor with Mut, Div, Panic {
        var pos: i64 = self.pos
        let source_len: i64 = self.source_len
        var line: i64 = self.line
        var col: i64 = self.col
        var current: i8 = self.current
        var i: i64 = 0
        while i < n {
            if pos < source_len {
                if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
                pos = pos + 1
                if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
            }
            i = i + 1
        }
        Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    }

    pub fn bump_while_ident(self) -> BumpResult with Mut, Div, Panic {
        var pos: i64 = self.pos
        let source_len: i64 = self.source_len
        var line: i64 = self.line
        var col: i64 = self.col
        var current: i8 = self.current
        var text: [i8; 256] = [0; 256]
        var idx: i64 = 0
        while pos < source_len && is_ident_continue(current) && idx < 256 {
            text[idx as usize] = current
            idx = idx + 1
            if current == 10 as i8 { line = line + 1; col = 1 } else { col = col + 1 }
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
        let result_cursor = Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
        BumpResult { cursor: result_cursor, text: text, text_len: idx }
    }

    pub fn bump_while_digit(self) -> Cursor with Mut, Div, Panic {
        var pos: i64 = self.pos
        let source_len: i64 = self.source_len
        var line: i64 = self.line
        var col: i64 = self.col
        var current: i8 = self.current
        while pos < source_len && is_digit(current) {
            col = col + 1
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
        Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    }

    pub fn bump_while_hex(self) -> Cursor with Mut, Div, Panic {
        var pos: i64 = self.pos
        let source_len: i64 = self.source_len
        var line: i64 = self.line
        var col: i64 = self.col
        var current: i8 = self.current
        while pos < source_len && is_hex_digit(current) {
            col = col + 1
            pos = pos + 1
            if pos < source_len { current = CURSOR_SOURCE[pos as usize] } else { current = 0 as i8 }
        }
        Cursor { source_len: source_len, pos: pos, line: line, col: col, current: current }
    }
}
