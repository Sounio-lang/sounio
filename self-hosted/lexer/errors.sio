// self-hosted::lexer::errors — Lexer diagnostic errors
//
// Error kinds as i32 constants. Each error carries position info.

// Error kind constants
let ERR_UNEXPECTED_CHAR: i32 = 1
let ERR_UNTERMINATED_STRING: i32 = 2
let ERR_UNTERMINATED_BLOCK_COMMENT: i32 = 3
let ERR_INVALID_ESCAPE: i32 = 4
let ERR_INVALID_NUMBER: i32 = 5
let ERR_NUMBER_OVERFLOW: i32 = 6
let ERR_UNTERMINATED_CHAR: i32 = 7
let ERR_EMPTY_CHAR_LITERAL: i32 = 8

struct LexError {
    kind: i32,
    pos: i64,
    line: i64,
    col: i64,
    // Context character (for unexpected char / invalid escape)
    context_char: i8,
}

fn lex_error_new(kind: i32, pos: i64, line: i64, col: i64) -> LexError {
    LexError {
        kind: kind,
        pos: pos,
        line: line,
        col: col,
        context_char: 0,
    }
}

fn lex_error_with_char(kind: i32, pos: i64, line: i64, col: i64, ch: i8) -> LexError {
    LexError {
        kind: kind,
        pos: pos,
        line: line,
        col: col,
        context_char: ch,
    }
}

// Return a human-readable error kind name
fn lex_error_kind_name(kind: i32) -> i32 {
    // Returns the error kind as-is for now; a full formatter would
    // convert to string via FFI or a lookup table.
    kind
}
