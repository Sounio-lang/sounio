// self-hosted::lexer::errors — Lexer diagnostic errors
//
// LexErrorKind is a proper enum replacing i32 constants.
// Each error carries position info and optional context character.

enum LexErrorKind {
    None,
    UnexpectedChar,
    UnterminatedString,
    UnterminatedBlockComment,
    InvalidEscape,
    InvalidNumber,
    NumberOverflow,
    UnterminatedChar,
    EmptyCharLiteral,
}

struct LexError {
    kind: LexErrorKind,
    pos: i64,
    line: i64,
    col: i64,
    // Context character (for unexpected char / invalid escape)
    context_char: i8,
}

impl LexError {
    fn new(kind: LexErrorKind, pos: i64, line: i64, col: i64) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: 0,
        }
    }

    fn with_char(kind: LexErrorKind, pos: i64, line: i64, col: i64, ch: i8) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: ch,
        }
    }
}
