// self-hosted::lexer::span — Source location tracking
//
// Span represents a byte-offset range in source code.
// Used for error messages and diagnostics.

struct Span {
    file_id: i32,
    start: i64,
    end: i64,
}

fn span_new(file_id: i32, start: i64, end: i64) -> Span {
    Span { file_id: file_id, start: start, end: end }
}

fn span_dummy() -> Span {
    Span { file_id: 0, start: 0, end: 0 }
}

fn span_len(s: Span) -> i64 {
    s.end - s.start
}

fn span_contains(s: Span, pos: i64) -> bool {
    pos >= s.start && pos < s.end
}

fn span_merge(a: Span, b: Span) -> Span {
    var start = a.start
    if b.start < start {
        start = b.start
    }
    var end = a.end
    if b.end > end {
        end = b.end
    }
    Span { file_id: a.file_id, start: start, end: end }
}
