// IR lowering tests

fn irt_name1(a: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 1 }
    n.buf[0] = a
    n
}

fn irt_name3(a: i8, b: i8, c: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 3 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n
}

fn irt_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn irt_name5(a: i8, b: i8, c: i8, d: i8, e: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 5 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n
}

fn irt_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 384], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn irt_single_path3(a: i8, b: i8, c: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 384] = [0; 384]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    AstPath {
        segments: StringList { head_buf: buf, head_len: 3, tail: None },
        seg_count: 1,
    }
}

fn irt_empty_block() -> Block {
    Block { stmts: None, span: Span::dummy() }
}

fn irt_int_expr(v: i64) -> Expr with Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprIntLit,
        span: Span::dummy(),
        int_val: v,
        float_val: 0.0,
        name: irt_name1(0),
        path: irt_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

