fn irt_block1(s1: Stmt) -> Block with Alloc {
    Block { stmts: Some(Box::new(StmtList { head: s1, tail: None })), span: Span::dummy() }
}

fn irt_block2(s1: Stmt, s2: Stmt) -> Block with Alloc {
    Block {
        stmts: Some(Box::new(StmtList { head: s1, tail: Some(Box::new(StmtList { head: s2, tail: None })) })),
        span: Span::dummy(),
    }
}

fn irt_fn_item(name: Name, params: Option<Box<ParamList>>, body: Block) -> Item with Alloc {
    let fd = FnDef {
        name: name,
        params: params,
        return_type: None,
        effects: None,
        body: body,
        span: Span::dummy(),
    }
    Item {
        kind: ItemKind::ItemFn,
        span: Span::dummy(),
        is_pub: false,
        name: name,
        fn_def: Some(Box::new(fd)),
        struct_def: None,
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        use_path: irt_empty_path(),
        use_glob: false,
        use_items: None,
    }
}

fn irt_prog1(item: Item) -> Program with Mut, Alloc {
    let items = Some(Box::new(ItemList { head: item, tail: None }))
    ir_set_pending_items(items)
    Program { module_path: irt_empty_path(), items: None }
}

fn irt_prog2(a: Item, b: Item) -> Program with Mut, Alloc {
    let items = Some(Box::new(ItemList { head: a, tail: Some(Box::new(ItemList { head: b, tail: None })) }))
    ir_set_pending_items(items)
    Program { module_path: irt_empty_path(), items: None }
}

fn irt_lower_item(lo: Lowerer, item: Item) -> Lowerer with Mut, Panic, Div, Alloc, IO {
    if item.kind == ItemKind::ItemFn {
        lo.lower_fn_item(item.name, item.fn_def)
    } else {
        lo
    }
}

fn irt_lower_prog1(item: Item) -> IrModule with Mut, Panic, Div, Alloc, IO {
    let p = irt_prog1(item)
    lower_program(p)
}

fn irt_lower_prog2(a: Item, b: Item) -> IrModule with Mut, Panic, Div, Alloc, IO {
    let p = irt_prog2(a, b)
    lower_program(p)
}

fn irt_find_fn(m: IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.fn_count {
        if ir_name_eq(m.functions[i].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn irt_count_opcode(f: IrFunction, op: IrOpcode) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    var c: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == op {
            c = c + 1
        }
        i = i + 1
    }
    c
}

fn irt_has_binop(f: IrFunction, op: BinaryOp) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrBinOp && f.instrs[i].bin_op == op {
            return true
        }
        i = i + 1
    }
    false
}

fn irt_has_unop(f: IrFunction, op: UnaryOp) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrUnaryOp && f.instrs[i].un_op == op {
            return true
        }
        i = i + 1
    }
    false
}

fn irt_has_call_argc(f: IrFunction, argc: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrCall && f.instrs[i].arg_count == argc {
            return true
        }
        i = i + 1
    }
    false
}

fn irt_has_call_name_and_argc(f: IrFunction, fn_name: Name, argc: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrCall &&
           f.instrs[i].arg_count == argc &&
           ir_name_eq(f.instrs[i].name, fn_name) {
            return true
        }
        i = i + 1
    }
    false
}

fn irt_has_load_imm_value(f: IrFunction, v: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrLoadImm && f.instrs[i].imm_i64 == v {
            return true
        }
        i = i + 1
    }
    false
}

fn irt_name_knowledge_kaxi_publish() -> Name with Mut, Panic {
    var n = Name { buf: [0; 128], len: 24 }
    n.buf[0] = 95 as i8
    n.buf[1] = 95 as i8
    n.buf[2] = 107 as i8
    n.buf[3] = 110 as i8
    n.buf[4] = 111 as i8
    n.buf[5] = 119 as i8
    n.buf[6] = 108 as i8
    n.buf[7] = 101 as i8
    n.buf[8] = 100 as i8
    n.buf[9] = 103 as i8
    n.buf[10] = 101 as i8
    n.buf[11] = 95 as i8
    n.buf[12] = 107 as i8
    n.buf[13] = 97 as i8
    n.buf[14] = 120 as i8
    n.buf[15] = 105 as i8
    n.buf[16] = 95 as i8
    n.buf[17] = 112 as i8
    n.buf[18] = 117 as i8
    n.buf[19] = 98 as i8
    n.buf[20] = 108 as i8
    n.buf[21] = 105 as i8
    n.buf[22] = 115 as i8
    n.buf[23] = 104 as i8
    n
}

fn ir_test_01_int_lit() -> bool with Mut, Panic, Div, Alloc, IO {
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(irt_int_expr(42))))
    let m = irt_lower_prog1(main)
    let idx = irt_find_fn(m, irt_name4(109, 97, 105, 110))
    if idx < 0 {
        return false
    }
    let f = m.functions[idx]
    if f.instr_count <= 0 {
        return false
    }
    irt_count_opcode(f, IrOpcode::IrLoadImm) >= 1
}

fn ir_test_02_float_lit() -> bool with Mut, Panic, Div, Alloc, IO {
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(irt_float_expr(3.14))))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrLoadFloat) >= 1
}

fn ir_test_03_bool_lit() -> bool with Mut, Panic, Div, Alloc, IO {
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(irt_bool_expr(true))))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrLoadBool) >= 1
}

fn ir_test_04_binop_add() -> bool with Mut, Panic, Div, Alloc, IO {
    let e = irt_bin_expr(irt_int_expr(1), BinaryOp::OpAdd, irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(e)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_has_binop(f, BinaryOp::OpAdd)
}

fn ir_test_05_unary_neg() -> bool with Mut, Panic, Div, Alloc, IO {
    let e = irt_un_expr(UnaryOp::OpNeg, irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(e)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_has_unop(f, UnaryOp::OpNeg)
}

fn ir_test_06_call_args() -> bool with Mut, Panic, Div, Alloc, IO {
    let foo = irt_fn_item(irt_name3(102, 111, 111), None, irt_block1(irt_stmt_expr(irt_int_expr(0))))
    let args = Some(Box::new(ExprList { head: irt_int_expr(7), tail: None }))
    let call = irt_call_expr(irt_ident_expr(irt_name3(102, 111, 111)), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))
    let m = irt_lower_prog2(main, foo)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_has_call_argc(f, 1)
}

fn ir_test_07_return() -> bool with Mut, Panic, Div, Alloc, IO {
    let r = irt_return_expr(irt_int_expr(9))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(r)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrReturn) >= 1
}

fn ir_test_08_let_assign_copy() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = irt_name1(120)
    let s1 = irt_stmt_var(x, irt_int_expr(1))
    let s2 = irt_stmt_assign(irt_ident_expr(x), irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, s2))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrCopy) >= 1
}

fn ir_test_09_if_branch_labels() -> bool with Mut, Panic, Div, Alloc, IO {
    let then_blk = irt_block1(irt_stmt_expr(irt_int_expr(1)))
    let ife = irt_if_expr(irt_bool_expr(true), then_blk, irt_int_expr(2))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(ife)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrBranchFalse) >= 1 && irt_count_opcode(f, IrOpcode::IrLabel) >= 2 && irt_count_opcode(f, IrOpcode::IrJump) >= 1
}

fn ir_test_10_while_loop() -> bool with Mut, Panic, Div, Alloc, IO {
    let w = irt_while_expr(irt_bool_expr(true), irt_block1(irt_stmt_expr(irt_break_expr(irt_int_expr(0)))))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(w)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrBranchFalse) >= 1 && irt_count_opcode(f, IrOpcode::IrJump) >= 1
}

fn ir_test_11_string_dedup() -> bool with Mut, Panic, Div, Alloc, IO {
    let s = irt_name3(104, 105, 33)
    let b = irt_block2(irt_stmt_expr(irt_string_expr(s)), irt_stmt_expr(irt_string_expr(s)))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, b)
    let m = irt_lower_prog1(main)
    m.string_count == 1
}

fn ir_test_12_field_get() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = irt_name1(120)
    let p = irt_name1(112)
    let sf = StructFieldInit { name: x, value: irt_int_expr(1) }
    let sl = Some(Box::new(StructFieldList { head: sf, tail: None }))
    let s1 = irt_stmt_let(p, irt_struct_lit(irt_single_path3(80, 116, 0), sl))
    let s2 = irt_stmt_expr(irt_field_expr(irt_ident_expr(p), x))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, s2))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrFieldGet) >= 1
}

fn ir_test_13_index_get() -> bool with Mut, Panic, Div, Alloc, IO {
    let a = irt_name1(97)
    let elems = Some(Box::new(ExprList {
        head: irt_int_expr(1),
        tail: Some(Box::new(ExprList { head: irt_int_expr(2), tail: None })),
    }))
    let s1 = irt_stmt_let(a, irt_array_lit(elems))
    let s2 = irt_stmt_expr(irt_index_expr(irt_ident_expr(a), irt_int_expr(0)))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, s2))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrIndexGet) >= 1
}

fn ir_test_14_loop_continue() -> bool with Mut, Panic, Div, Alloc, IO {
    let body = irt_block1(irt_stmt_expr(irt_continue_expr()))
    let lp = irt_loop_expr(body)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(lp)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_count_opcode(f, IrOpcode::IrJump) >= 1 && irt_count_opcode(f, IrOpcode::IrLabel) >= 2
}

fn ir_test_15_param_regs() -> bool with Mut, Panic, Div, Alloc, IO {
    let x = Param {
        name: irt_name1(120),
        ty: TypeExpr {
            kind: TypeExprKind::TypeNamed,
            span: Span::dummy(),
            path: irt_single_path3(105, 54, 52),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
        },
        is_self: false,
        is_self_mut: false,
        span: Span::dummy(),
    }
    let params = Some(Box::new(ParamList { head: x, tail: None }))
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), params, irt_block1(irt_stmt_expr(irt_ident_expr(irt_name1(120)))))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    f.param_count == 1 && f.param_regs[0] >= 0
}

fn ir_test_16_method_call_lowered() -> bool with Mut, Panic, Div, Alloc, IO {
    let p = irt_name1(112)
    let getx = irt_name5(103, 101, 116, 95, 120)
    let sf = StructFieldInit { name: irt_name1(120), value: irt_int_expr(1) }
    let sl = Some(Box::new(StructFieldList { head: sf, tail: None }))
    let s1 = irt_stmt_let(p, irt_struct_lit(irt_single_path3(80, 116, 0), sl))
    let me = Expr {
        kind: ExprKind::ExprMethodCall,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: getx,
        path: irt_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: Some(Box::new(irt_ident_expr(p))),
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
    }
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block2(s1, irt_stmt_expr(me)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]
    irt_has_call_argc(f, 1)
}

// Phase 0 tests: IR serialization and normalization
fn ir_test_17_serialize_roundtrip() -> bool with Mut, Panic, Div, IO {
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = ir_name_from_bytes(116 as i8, 101 as i8, 115 as i8, 116 as i8, 4)
    func.instr_count = 2
    func.reg_count = 1
    func.instrs[0] = ir_load_imm(0, 42)
    func.instrs[1] = ir_return(0)

    module.functions[0] = func

    let pair = serialize_ir_module(module)
    let buf = pair.0
    let len = pair.1

    let restored = deserialize_ir_module(buf, len)

    if restored.fn_count != 1 {
        return false
    }
    if restored.functions[0].instr_count != 2 {
        return false
    }
    if restored.functions[0].instrs[0].imm_i64 != 42 {
        return false
    }

    true
}

fn ir_test_18_normalize_deterministic() -> bool with Mut, Panic, Div {
    var module_a = ir_empty_module()
    module_a.fn_count = 1
    var func_a = ir_empty_function()
    func_a.name = ir_name_from_bytes(102 as i8, 111 as i8, 111 as i8, 0 as i8, 3)
    func_a.instr_count = 3
    func_a.instrs[0] = ir_load_imm(5, 10)
    func_a.instrs[1] = ir_load_imm(10, 20)
    func_a.instrs[2] = ir_binop(5, 5, BinaryOp::OpAdd, 10)
    module_a.functions[0] = func_a

    var module_b = ir_empty_module()
    module_b.fn_count = 1
    var func_b = ir_empty_function()
    func_b.name = ir_name_from_bytes(102 as i8, 111 as i8, 111 as i8, 0 as i8, 3)
    func_b.instr_count = 3
    func_b.instrs[0] = ir_load_imm(2, 10)
    func_b.instrs[1] = ir_load_imm(7, 20)
    func_b.instrs[2] = ir_binop(2, 2, BinaryOp::OpAdd, 7)
    module_b.functions[0] = func_b

    let norm_a = normalize_ir_module(module_a)
    let norm_b = normalize_ir_module(module_b)

    let fa = norm_a.functions[0]
    let fb = norm_b.functions[0]

    fa.instrs[0].dst == fb.instrs[0].dst && fa.instrs[1].dst == fb.instrs[1].dst
}

fn ir_test_19_normalize_label_ordering() -> bool with Mut, Panic, Div {
    var module = ir_empty_module()
    module.fn_count = 1
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(98 as i8, 97 as i8, 114 as i8, 0 as i8, 3)
    func.instr_count = 5
    func.instrs[0] = ir_label(7)
    func.instrs[1] = ir_load_imm(0, 1)
    func.instrs[2] = ir_label(2)
    func.instrs[3] = ir_load_imm(1, 2)
    func.instrs[4] = ir_jump(7)
    module.functions[0] = func

    let normalized = normalize_ir_module(module)
    let nf = normalized.functions[0]

    nf.instrs[0].label_id == 0 && nf.instrs[2].label_id == 1 && nf.instrs[4].label_id == 0
}

fn ir_test_20_sort_functions_by_name() -> bool with Mut, Panic, Div {
    var module = ir_empty_module()
    module.fn_count = 3

    var func_z = ir_empty_function()
    func_z.name = ir_name_from_bytes(122 as i8, 101 as i8, 98 as i8, 0 as i8, 3)
    module.functions[0] = func_z

    var func_m = ir_empty_function()
    func_m.name = ir_name_from_bytes(109 as i8, 105 as i8, 100 as i8, 0 as i8, 3)
    module.functions[1] = func_m

    var func_a = ir_empty_function()
    func_a.name = ir_name_from_bytes(97 as i8, 112 as i8, 101 as i8, 0 as i8, 3)
    module.functions[2] = func_a

    let normalized = normalize_ir_module(module)

    normalized.functions[0].name.buf[0] == 97 as i8 && normalized.functions[1].name.buf[0] == 109 as i8 && normalized.functions[2].name.buf[0] == 122 as i8
}

fn ir_test_21_compare_normalized_ir() -> bool with Mut, Panic, Div {
    var module_a = ir_empty_module()
    module_a.fn_count = 1
    var func_a = ir_empty_function()
    func_a.name = ir_name_from_bytes(116 as i8, 101 as i8, 115 as i8, 116 as i8, 4)
    func_a.instr_count = 1
    func_a.instrs[0] = ir_load_imm(0, 100)
    module_a.functions[0] = func_a

    var module_b = ir_empty_module()
    module_b.fn_count = 1
    var func_b = ir_empty_function()
    func_b.name = ir_name_from_bytes(116 as i8, 101 as i8, 115 as i8, 116 as i8, 4)
    func_b.instr_count = 1
    func_b.instrs[0] = ir_load_imm(0, 100)
    module_b.functions[0] = func_b

    let result = compare_normalized_ir(module_a, module_b)
    if result != 0 { return false }

    func_b.instr_count = 2
    module_b.functions[0] = func_b

    let result2 = compare_normalized_ir(module_a, module_b)
    result2 != 0
}

fn ir_test_22_hardware_publish_expands_to_5_args() -> bool with Mut, Panic, Div, Alloc, IO {
    let intrinsic = irt_name_knowledge_kaxi_publish()
    let args = Some(Box::new(ExprList {
        head: irt_float_expr(5.0),
        tail: Some(Box::new(ExprList {
            head: irt_int_expr(4), // KAXI::fma
            tail: None,
        })),
    }))
    let call = irt_call_expr(irt_ident_expr(intrinsic), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]

    // Packed flags contract: alpha_q8=16, success_inc=1, failure_inc=0, op_kind=4.
    let expected_flags = ((16 as i64) << 24) | ((1 as i64) << 16) | (4 as i64)

    irt_has_call_name_and_argc(f, intrinsic, 5) &&
    irt_count_opcode(f, IrOpcode::IrLoadFloat) >= 2 && // value + confidence defaults
    irt_has_load_imm_value(f, expected_flags)
}

fn ir_test_23_kaxi_intrinsic_5arg_passthrough() -> bool with Mut, Panic, Div, Alloc, IO {
    let intrinsic = irt_name_knowledge_kaxi_publish()
    let args = Some(Box::new(ExprList {
        head: irt_int_expr(11),
        tail: Some(Box::new(ExprList {
            head: irt_int_expr(22),
            tail: Some(Box::new(ExprList {
                head: irt_int_expr(33),
                tail: Some(Box::new(ExprList {
                    head: irt_int_expr(44),
                    tail: Some(Box::new(ExprList {
                        head: irt_int_expr(55),
                        tail: None,
                    })),
                })),
            })),
        })),
    }))
    let call = irt_call_expr(irt_ident_expr(intrinsic), args)
    let main = irt_fn_item(irt_name4(109, 97, 105, 110), None, irt_block1(irt_stmt_expr(call)))
    let m = irt_lower_prog1(main)
    let f = m.functions[irt_find_fn(m, irt_name4(109, 97, 105, 110))]

    // Explicit 5-arg intrinsic must pass through unchanged (no synthesized defaults).
    irt_has_call_name_and_argc(f, intrinsic, 5) &&
    irt_has_load_imm_value(f, 55) &&
    irt_count_opcode(f, IrOpcode::IrLoadFloat) == 0
}

fn run_ir_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== IR Lowering Tests ===\n")

    total = total + 1
    if ir_test_01_int_lit() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01\n") }
    total = total + 1
    if ir_test_02_float_lit() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02\n") }
    total = total + 1
    if ir_test_03_bool_lit() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03\n") }
    total = total + 1
    if ir_test_04_binop_add() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04\n") }
    total = total + 1
    if ir_test_05_unary_neg() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05\n") }
    total = total + 1
    if ir_test_06_call_args() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06\n") }
    total = total + 1
    if ir_test_07_return() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07\n") }
    total = total + 1
    if ir_test_08_let_assign_copy() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08\n") }
    total = total + 1
    if ir_test_09_if_branch_labels() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09\n") }
    total = total + 1
    if ir_test_10_while_loop() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10\n") }
    total = total + 1
    if ir_test_11_string_dedup() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11\n") }
    total = total + 1
    if ir_test_12_field_get() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12\n") }
    total = total + 1
    if ir_test_13_index_get() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13\n") }
    total = total + 1
    if ir_test_14_loop_continue() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14\n") }
    total = total + 1
    if ir_test_15_param_regs() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15\n") }
    total = total + 1
    if ir_test_16_method_call_lowered() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16\n") }

    print("\n=== IR Serialization/Normalization Tests (Phase 0) ===\n")

    total = total + 1
    if ir_test_17_serialize_roundtrip() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17\n") }
    total = total + 1
    if ir_test_18_normalize_deterministic() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18\n") }
    total = total + 1
    if ir_test_19_normalize_label_ordering() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19\n") }
    total = total + 1
    if ir_test_20_sort_functions_by_name() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20\n") }
    total = total + 1
    if ir_test_21_compare_normalized_ir() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21\n") }
    total = total + 1
    if ir_test_22_hardware_publish_expands_to_5_args() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22\n") }
    total = total + 1
    if ir_test_23_kaxi_intrinsic_5arg_passthrough() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23\n") }

    if passed == total { print("\n✅ IR tests: all passed\n") } else { print("\n❌ IR tests: suite fail\n") }

    if passed == total { 0 } else { 1 }
}
