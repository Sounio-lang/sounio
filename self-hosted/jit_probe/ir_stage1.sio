module jit_probe::ir_stage1

use parser::ast::{Name, StringList, AstPath, BinaryOp, UnaryOp}

enum IrOpcode {
    IrLoadImm,
    IrLoadFloat,
    IrLoadBool,
    IrLoadString,
    IrCopy,
    IrBinOp,
    IrUnaryOp,
    IrCall,
    IrReturn,
    IrJump,
    IrBranchTrue,
    IrBranchFalse,
    IrFieldGet,
    IrFieldSet,
    IrIndexGet,
    IrIndexSet,
    IrAlloc,
    IrLabel,
    IrNop,
    IrPhi,
    IrVecAddF64,
    IrVecMulF64,
    IrVecFmaF64,
    IrVecSubF64,
    IrVecMinMaxPD,
    IrMaskAnd,
    IrMaskOr,
    IrMaskNot,
    IrMaskMov,
    IrVecPermilPD,
    IrVecPermilPDImm,
    IrVecAddSubPD,
    IrHyperMulQ,
    IrVecXorPD,
    IrVecPermpd,
    IrHyperConjugateO,
    IrHyperMulO,
    IrHyperNormSqO,
    IrG2ProjectImO,
    IrG2ApplyGenO,
    IrG2DenseO,
    IrG2EquivDenseKernelO,
    IrE8RootReflectO,
    IrF4RootReflectO,
    IrE6RootReflectO,
    IrE7RootReflectO,
    IrF4CartanMulO,
    IrE6CartanMulO,
    IrE7CartanMulO,
    IrE8CartanMulO,
}

fn ir_opcode_is_nop(op: IrOpcode) -> bool {
    op == IrOpcode::IrNop
}
