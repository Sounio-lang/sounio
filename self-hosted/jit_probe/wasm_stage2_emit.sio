module jit_probe::wasm_stage2_emit

struct WasmBuf {
    data: [i8; 1024],
    len: i64,
}

fn wasm_buf_new() -> WasmBuf {
    WasmBuf { data: [0; 1024], len: 0 }
}

fn wasm_push_byte(buf: WasmBuf, b: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 && out.len < 1024 {
        var v = b % 256
        if v < 0 {
            v = v + 256
        }
        out.data[out.len as usize] = v as i8
        out.len = out.len + 1
    }
    out
}

fn wasm_push_u32_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    if v < 0 {
        v = v + 4294967296
    }
    var done = false
    while !done {
        let low7 = v % 128
        v = v / 128
        if v == 0 {
            out = wasm_push_byte(out, low7)
            done = true
        } else {
            out = wasm_push_byte(out, low7 + 128)
        }
    }
    out
}
