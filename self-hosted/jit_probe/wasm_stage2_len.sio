module jit_probe::wasm_stage2_len

fn wasm_u32_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    if v < 0 {
        v = v + 4294967296
    }
    var count: i64 = 0
    var done = false
    while !done {
        v = v / 128
        count = count + 1
        if v == 0 {
            done = true
        }
    }
    count
}
