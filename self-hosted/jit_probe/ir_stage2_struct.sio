module jit_probe::ir_stage2_struct

use parser::ast::{Name, BinaryOp, UnaryOp}

enum IrOpcodeLite {
    IrLoadImm,
    IrBinOp,
    IrCall,
    IrReturn,
    IrNop,
}

struct IrInstrLite {
    op: IrOpcodeLite,
    dst: i64,
    src1: i64,
    src2: i64,
    imm_i64: i64,
    imm_f64: f64,
    bin_op: BinaryOp,
    un_op: UnaryOp,
    name: Name,
}

struct IrFunctionLite {
    name: Name,
    instrs: [IrInstrLite; 16],
    instr_count: i64,
}

fn ir_struct_default_name() -> Name {
    Name { buf: [0; 384], len: 0 }
}

fn ir_struct_default_instr() -> IrInstrLite {
    IrInstrLite {
        op: IrOpcodeLite::IrNop,
        dst: 0,
        src1: 0,
        src2: 0,
        imm_i64: 0,
        imm_f64: 0.0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name: ir_struct_default_name(),
    }
}

fn ir_struct_default_function() -> IrFunctionLite {
    IrFunctionLite {
        name: ir_struct_default_name(),
        instrs: [ir_struct_default_instr(); 16],
        instr_count: 0,
    }
}

fn ir_struct_instr_capacity() -> i64 {
    16
}
