}

fn test_046_config_default_empty() -> bool with Mut {
    var cfg = lint_config_default()
    cfg.rule_count == 0
}

fn do_add_rule(cfg: &! LintConfig, id: i64, en: bool, sev: i64) -> () with Mut, Panic, Div {
    lint_config_add_rule(cfg, id, en, sev)
}

fn test_047_config_add_rule() -> bool with Mut, Panic, Div {
    var cfg = lint_config_default()
    do_add_rule(&! cfg, LINT_LINE_TOO_LONG(), true, LINT_WARN())
    cfg.rule_count == 1
}

fn test_048_config_is_enabled_true() -> bool with Mut, Panic, Div {
    var cfg = lint_config_default()
    do_add_rule(&! cfg, LINT_LINE_TOO_LONG(), true, LINT_WARN())
    lint_config_is_enabled(&cfg, LINT_LINE_TOO_LONG())
}

fn test_049_config_disable_rule() -> bool with Mut, Panic, Div {
    var cfg = lint_config_default()
    do_add_rule(&! cfg, LINT_LINE_TOO_LONG(), true, LINT_WARN())
    lint_config_disable_rule(&! cfg, LINT_LINE_TOO_LONG())
    !lint_config_is_enabled(&cfg, LINT_LINE_TOO_LONG())
}

fn test_050_config_enable_rule() -> bool with Mut, Panic, Div {
    var cfg = lint_config_default()
    do_add_rule(&! cfg, LINT_LINE_TOO_LONG(), false, LINT_WARN())
    lint_config_enable_rule(&! cfg, LINT_LINE_TOO_LONG())
    lint_config_is_enabled(&cfg, LINT_LINE_TOO_LONG())
}

fn test_051_config_unknown_rule_enabled_by_default() -> bool with Mut, Panic, Div {
    var cfg = lint_config_default()
    lint_config_is_enabled(&cfg, LINT_MAGIC_NUMBER())
}

fn test_052_clear_then_add() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_clear(&! ctx)
    do_add_warn(&! ctx)
    lint_diag_count(&ctx) == 1 && lint_warn_count(&ctx) == 1 && lint_error_count(&ctx) == 0
}

fn test_053_diag_line_stored() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    lint_add_diag(&! ctx, LINT_EMPTY_BLOCK(), LINT_WARN(), 42, 7, "empty")
    lint_diag_line(&ctx, 0) == 42
}

fn test_054_line_length_line_number_stored() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_line_len(&! ctx, "toolongline!!", 17, 5)
    lint_diag_line(&ctx, 0) == 17
}

fn test_055_magic_number_100() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_magic(&! ctx, "100", 1, 0)
    lint_diag_count(&ctx) == 1
}

fn test_056_line_exactly_80() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    // "12345678" has length 8, limit 8 — exactly at limit, no diag
    do_check_line_len(&! ctx, "12345678", 1, 8)
    lint_diag_count(&ctx) == 0
}

fn test_057_line_81_chars_over_80() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    // "123456789" has length 9, limit 8 — over
    do_check_line_len(&! ctx, "123456789", 1, 8)
    lint_diag_count(&ctx) == 1
}

fn test_058_count_by_severity_error() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    do_add_error(&! ctx)
    do_add_warn(&! ctx)
    lint_count_by_severity(&ctx, LINT_ERROR()) == 2
}

fn test_059_count_by_severity_warn() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    do_add_warn(&! ctx)
    do_add_warn(&! ctx)
    lint_count_by_severity(&ctx, LINT_WARN()) == 2
}

fn test_060_lint_constants_distinct() -> bool {
    let e = LINT_ERROR()
    let w = LINT_WARN()
    let i = LINT_INFO()
    e != w && w != i && e != i
}

fn test_061_rule_constants_distinct() -> bool {
    let a = LINT_UNUSED_VAR()
    let b = LINT_DEAD_CODE()
    let c = LINT_LONG_FUNCTION()
    a != b && b != c && a != c
}

fn test_062_rule_constants_nonzero() -> bool {
    LINT_UNUSED_VAR() > 0 && LINT_DEAD_CODE() > 0 && LINT_LINE_TOO_LONG() > 0
}

fn test_063_empty_block_in_source() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_empty_block(&! ctx, "fn foo() { }", 0, 5)
    lint_diag_count(&ctx) >= 1
}

fn test_064_no_empty_block_in_full_source() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_empty_block(&! ctx, "fn foo() { let x = 1 }", 0, 5)
    lint_diag_count(&ctx) == 0
}

fn test_065_add_512_diags_capacity() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    var i: i64 = 0
    while i < 512 {
        lint_add_diag(&! ctx, LINT_LINE_TOO_LONG(), LINT_WARN(), i, 0, "x")
        i = i + 1
    }
    lint_diag_count(&ctx) == 512
}

fn test_066_add_beyond_capacity_no_panic() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    var i: i64 = 0
    while i < 513 {
        lint_add_diag(&! ctx, LINT_LINE_TOO_LONG(), LINT_WARN(), i, 0, "x")
        i = i + 1
    }
    lint_diag_count(&ctx) == 512
}

fn test_067_empty_source_no_diag() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_empty_block(&! ctx, "", 0, 1)
    lint_diag_count(&ctx) == 0
}

fn test_068_todo_case_sensitive() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    // "todo" lowercase — should NOT trigger (only TODO uppercase)
    do_check_todo(&! ctx, "// todo fix", 1)
    lint_diag_count(&ctx) == 0
}

fn test_069_multiple_rules_same_context() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_todo(&! ctx, "// TODO", 1)
    do_check_magic(&! ctx, "42", 2, 0)
    do_check_line_len(&! ctx, "toolongline!", 3, 5)
    lint_diag_count(&ctx) == 3
}
