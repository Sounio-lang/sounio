// self-hosted::tools::linter — Source linter for Sounio code
//
// Detects common code quality issues: long lines, TODO comments, magic numbers,
// empty blocks, and more. Produces structured diagnostics with rule IDs,
// severity levels, and source locations.
//
// All state is threaded through LintContext via &! references.

// ============================================================================
// SEVERITY CONSTANTS
// ============================================================================

fn LINT_ERROR() -> i64 { 0 }
fn LINT_WARN()  -> i64 { 1 }
fn LINT_INFO()  -> i64 { 2 }

// ============================================================================
// RULE ID CONSTANTS
// ============================================================================

fn LINT_UNUSED_VAR()     -> i64 { 1 }
fn LINT_DEAD_CODE()      -> i64 { 2 }
fn LINT_LONG_FUNCTION()  -> i64 { 3 }
fn LINT_MAGIC_NUMBER()   -> i64 { 4 }
fn LINT_DEEP_NESTING()   -> i64 { 5 }
fn LINT_MISSING_EFFECT() -> i64 { 6 }
fn LINT_SHADOW_VAR()     -> i64 { 7 }
fn LINT_EMPTY_BLOCK()    -> i64 { 8 }
fn LINT_TODO_COMMENT()   -> i64 { 9 }
fn LINT_LINE_TOO_LONG()  -> i64 { 10 }

// ============================================================================
// STRUCTS
// ============================================================================

struct LintDiag {
    rule_id:  i64,
    severity: i64,
    line:     i64,
    col:      i64,
    msg:      [i8; 256],
    msg_len:  i64,
}

struct LintContext {
    diags:       [LintDiag; 512],
    diag_count:  i64,
    source:      [i64; 65536],
    source_len:  i64,
    error_count: i64,
    warn_count:  i64,
}

struct LintRule {
    id:       i64,
    enabled:  bool,
    severity: i64,
}

struct LintConfig {
    rules:      [LintRule; 128],
    rule_count: i64,
}

// ============================================================================
// HELPERS: empty diagnostic + empty rule
// ============================================================================

fn lint_empty_diag() -> LintDiag {
    LintDiag {
        rule_id:  0,
        severity: 0,
        line:     0,
        col:      0,
        msg:      [0; 256],  // [i8; 256]
        msg_len:  0,
    }
}

fn lint_empty_rule() -> LintRule {
    LintRule {
        id:       0,
        enabled:  false,
        severity: LINT_WARN(),
    }
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn lint_context_new() -> LintContext with Mut {
    LintContext {
        diags:       [lint_empty_diag(); 512],
        diag_count:  0,
        source:      [0; 65536],
        source_len:  0,
        error_count: 0,
        warn_count:  0,
    }
}

fn lint_config_default() -> LintConfig with Mut {
    LintConfig {
        rules:      [lint_empty_rule(); 128],
        rule_count: 0,
    }
}

// ============================================================================
// CONFIG HELPERS
// ============================================================================

fn lint_config_disable_rule(cfg: &! LintConfig, rule_id: i64) -> () with Mut, Panic, Div {
    var i: i64 = 0
    while i < cfg.rule_count {
        if cfg.rules[i as usize].id == rule_id {
            cfg.rules[i as usize].enabled = false
        }
        i = i + 1
    }
}

fn lint_config_enable_rule(cfg: &! LintConfig, rule_id: i64) -> () with Mut, Panic, Div {
    var i: i64 = 0
    while i < cfg.rule_count {
        if cfg.rules[i as usize].id == rule_id {
            cfg.rules[i as usize].enabled = true
        }
        i = i + 1
    }
}

fn lint_config_add_rule(cfg: &! LintConfig, id: i64, enabled: bool, severity: i64) -> () with Mut, Panic, Div {
    if cfg.rule_count >= 128 {
        return ()
    }
    let idx = cfg.rule_count
    cfg.rules[idx as usize] = LintRule { id: id, enabled: enabled, severity: severity }
    cfg.rule_count = cfg.rule_count + 1
}

fn lint_config_is_enabled(cfg: &LintConfig, rule_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < cfg.rule_count {
        if cfg.rules[i as usize].id == rule_id {
            return cfg.rules[i as usize].enabled
        }
        i = i + 1
    }
    true
}

// ============================================================================
// COPY STRING INTO i64 ARRAY
// ============================================================================

fn lint_copy_msg(dst: &![i8; 256], s: string) -> i64 with Mut, Panic, Div {
    let slen = str_len(s)
    var cap: i64 = 256
    var n: i64 = slen
    if n > cap { n = cap }
    var i: i64 = 0
    while i < n {
        dst[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

// ============================================================================
// ADD DIAGNOSTIC
// ============================================================================

fn lint_add_diag(ctx: &! LintContext, rule_id: i64, sev: i64, line: i64, col: i64, msg: string) -> () with Mut, Panic, Div {
    if ctx.diag_count >= 512 {
        return ()
    }
    let idx = ctx.diag_count
    ctx.diags[idx as usize] = lint_empty_diag()
    ctx.diags[idx as usize].rule_id  = rule_id
    ctx.diags[idx as usize].severity = sev
    ctx.diags[idx as usize].line     = line
    ctx.diags[idx as usize].col      = col
    let n = lint_copy_msg(&! ctx.diags[idx as usize].msg, msg)
    ctx.diags[idx as usize].msg_len  = n
    ctx.diag_count = ctx.diag_count + 1
    if sev == LINT_ERROR() {
        ctx.error_count = ctx.error_count + 1
    }
    if sev == LINT_WARN() {
        ctx.warn_count = ctx.warn_count + 1
    }
}

// ============================================================================
// ACCESSORS
// ============================================================================

fn lint_diag_count(ctx: &LintContext) -> i64 {
    ctx.diag_count
}

fn lint_error_count(ctx: &LintContext) -> i64 {
    ctx.error_count
}

fn lint_warn_count(ctx: &LintContext) -> i64 {
    ctx.warn_count
}

fn lint_has_errors(ctx: &LintContext) -> bool {
    ctx.error_count > 0
}

fn lint_diag_rule(ctx: &LintContext, idx: i64) -> i64 with Panic {
    ctx.diags[idx as usize].rule_id
}

fn lint_diag_severity(ctx: &LintContext, idx: i64) -> i64 with Panic {
    ctx.diags[idx as usize].severity
}

fn lint_diag_line(ctx: &LintContext, idx: i64) -> i64 with Panic {
    ctx.diags[idx as usize].line
}

fn lint_diag_msg(ctx: &LintContext, idx: i64) -> string with Panic, Div {
    str_from_bytes(ctx.diags[idx as usize].msg, ctx.diags[idx as usize].msg_len)
}

// ============================================================================
// CLEAR
// ============================================================================

fn lint_clear(ctx: &! LintContext) -> () with Mut {
    ctx.diag_count  = 0
    ctx.error_count = 0
    ctx.warn_count  = 0
}

// ============================================================================
// LINT RULES
// ============================================================================

// Check whether a line exceeds max_len characters.
fn lint_check_line_length(ctx: &! LintContext, line: string, line_num: i64, max_len: i64) -> () with Mut, Panic, Div {
    let n = str_len(line)
    if n > max_len {
        lint_add_diag(ctx, LINT_LINE_TOO_LONG(), LINT_WARN(), line_num, max_len + 1, "line too long")
    }
}

// Check whether a line contains a TODO comment.
fn lint_contains_todo(line: string) -> bool with Mut, Panic, Div {
    let n = str_len(line)
    if n < 4 {
        return false
    }
    var i: i64 = 0
    while i <= n - 4 {
        let c0 = str_char_at(line, i)
        let c1 = str_char_at(line, i + 1)
        let c2 = str_char_at(line, i + 2)
        let c3 = str_char_at(line, i + 3)
        // 'T'=84 'O'=79 'D'=68 'O'=79
        if c0 == 84 && c1 == 79 && c2 == 68 && c3 == 79 {
            return true
        }
        i = i + 1
    }
    false
}

fn lint_check_todo(ctx: &! LintContext, line: string, line_num: i64) -> () with Mut, Panic, Div {
    if lint_contains_todo(line) {
        lint_add_diag(ctx, LINT_TODO_COMMENT(), LINT_INFO(), line_num, 0, "TODO comment found")
    }
}

// Check whether a token string looks like a bare magic number.
// A token is a magic number if it starts with a digit but is not 0 or 1.
fn lint_is_digit(c: i64) -> bool {
    c >= 48 && c <= 57
}

fn lint_is_magic_number(token: string) -> bool with Panic, Div {
    let n = str_len(token)
    if n == 0 {
        return false
    }
    let first = str_char_at(token, 0)
    if !lint_is_digit(first) {
        return false
    }
    // Single character '0' or '1' are not magic
    if n == 1 {
        let v = first - 48
        if v == 0 || v == 1 {
            return false
        }
    }
    true
}

fn lint_check_magic_number(ctx: &! LintContext, token: string, line: i64, col: i64) -> () with Mut, Panic, Div {
    if lint_is_magic_number(token) {
        lint_add_diag(ctx, LINT_MAGIC_NUMBER(), LINT_WARN(), line, col, "magic number")
    }
}

// Scan source string for an empty block '{ }' or '{}'.
fn lint_check_empty_block(ctx: &! LintContext, source: string, pos: i64, line: i64) -> () with Mut, Panic, Div {
    let n = str_len(source)
    if pos < 0 || pos >= n {
        return ()
    }
    var i: i64 = pos
    while i < n {
        let c = str_char_at(source, i)
        // '{'=123
        if c == 123 {
            // scan forward for '}' skipping spaces
            var j: i64 = i + 1
            var only_space: bool = true
            while j < n && only_space {
                let d = str_char_at(source, j)
                // '}'=125 ' '=32 '\t'=9 '\n'=10 '\r'=13
                if d == 125 {
                    // found closing brace — empty block
                    lint_add_diag(ctx, LINT_EMPTY_BLOCK(), LINT_WARN(), line, i, "empty block")
                    only_space = false
                } else if d == 32 || d == 9 || d == 10 || d == 13 {
                    j = j + 1
                } else {
                    only_space = false
                }
            }
        }
        i = i + 1
    }
}

// ============================================================================
// COUNT DIAGNOSTICS BY SEVERITY
// ============================================================================

fn lint_count_by_severity(ctx: &LintContext, sev: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.diag_count {
        if ctx.diags[i as usize].severity == sev {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn lint_info_count(ctx: &LintContext) -> i64 with Mut, Panic, Div {
    lint_count_by_severity(ctx, LINT_INFO())
}

// Count diagnostics for a specific rule.
fn lint_count_by_rule(ctx: &LintContext, rule_id: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.diag_count {
        if ctx.diags[i as usize].rule_id == rule_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Return true if any diagnostic has the given rule_id.
fn lint_has_rule(ctx: &LintContext, rule_id: i64) -> bool with Mut, Panic, Div {
    lint_count_by_rule(ctx, rule_id) > 0
}

// ============================================================================
// TESTS
// ============================================================================

fn test_001_context_new_empty() -> bool with Mut {
    var ctx = lint_context_new()
    lint_diag_count(&ctx) == 0
}

fn test_002_error_count_zero() -> bool with Mut {
    var ctx = lint_context_new()
    lint_error_count(&ctx) == 0
}

fn test_003_warn_count_zero() -> bool with Mut {
    var ctx = lint_context_new()
    lint_warn_count(&ctx) == 0
}

fn test_004_has_errors_false() -> bool with Mut {
    var ctx = lint_context_new()
    !lint_has_errors(&ctx)
}

fn do_add_error(ctx: &! LintContext) -> () with Mut, Panic, Div {
    lint_add_diag(ctx, LINT_LINE_TOO_LONG(), LINT_ERROR(), 1, 80, "err")
}

fn test_005_add_error_increments_count() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_diag_count(&ctx) == 1
}

fn test_006_add_error_increments_error_count() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_error_count(&ctx) == 1
}

fn test_007_has_errors_after_error() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_has_errors(&ctx)
}

fn do_add_warn(ctx: &! LintContext) -> () with Mut, Panic, Div {
    lint_add_diag(ctx, LINT_TODO_COMMENT(), LINT_WARN(), 2, 0, "warn")
}

fn test_008_add_warn_increments_warn_count() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_warn(&! ctx)
    lint_warn_count(&ctx) == 1
}

fn test_009_add_warn_not_error() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_warn(&! ctx)
    lint_error_count(&ctx) == 0
}

fn test_010_diag_rule_id() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_diag_rule(&ctx, 0) == LINT_LINE_TOO_LONG()
}

fn test_011_diag_severity() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_diag_severity(&ctx, 0) == LINT_ERROR()
}

fn test_012_diag_line() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    lint_diag_line(&ctx, 0) == 1
}

fn test_013_clear_resets_counts() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_add_error(&! ctx)
    do_add_warn(&! ctx)
    lint_clear(&! ctx)
    lint_diag_count(&ctx) == 0 && lint_error_count(&ctx) == 0 && lint_warn_count(&ctx) == 0
}

fn do_check_line_len(ctx: &! LintContext, line: string, lnum: i64, max: i64) -> () with Mut, Panic, Div {
    lint_check_line_length(ctx, line, lnum, max)
}

fn test_014_line_at_limit_no_diag() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    // "hello" has length 5, limit 5 — not over
    do_check_line_len(&! ctx, "hello", 1, 5)
    lint_diag_count(&ctx) == 0
}

fn test_015_line_over_limit_diag() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    // "hello!" has length 6, limit 5 — over
    do_check_line_len(&! ctx, "hello!", 1, 5)
    lint_diag_count(&ctx) == 1
}

fn test_016_line_over_limit_rule_id() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_line_len(&! ctx, "toolongline!", 3, 5)
    lint_diag_rule(&ctx, 0) == LINT_LINE_TOO_LONG()
}

fn test_017_line_over_limit_severity_warn() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_line_len(&! ctx, "toolongline!", 3, 5)
    lint_diag_severity(&ctx, 0) == LINT_WARN()
}

fn test_018_line_empty_no_diag() -> bool with Mut, Panic, Div {
    var ctx = lint_context_new()
    do_check_line_len(&! ctx, "", 1, 80)
    lint_diag_count(&ctx) == 0
}

fn do_check_todo(ctx: &! LintContext, line: string, lnum: i64) -> () with Mut, Panic, Div {
    lint_check_todo(ctx, line, lnum)
}

