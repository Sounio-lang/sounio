    input[1] = 47   // /
    input[2] = 32   // ' '
    input[3] = 99   // c
    input[4] = 111  // o
    input[5] = 109  // m
    input[6] = 109  // m
    input[7] = 101  // e
    input[8] = 110  // n
    input[9] = 116  // t
    input[10] = 10  // \n
    let src = fmt_make_source(input, 11)
    var ctx = fmt_context_new(src, 11)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx.line_count == 1 && ctx.lines[0].is_comment
}

// T37: Tokenize number
fn test_fmt_tokenize_number() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "42\n"
    input[0] = 52   // 4
    input[1] = 50   // 2
    input[2] = 10   // \n
    let src = fmt_make_source(input, 3)
    let ctx = fmt_tokenize(fmt_context_new(src, 3))
    ctx.token_count == 2 &&
    ctx.tokens[0].kind == FMT_TOK_NUMBER &&
    ctx.tokens[0].text_len == 2
}

// T38: Tokenize punctuation
fn test_fmt_tokenize_punc() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "(\n"
    input[0] = 40   // (
    input[1] = 10   // \n
    let src = fmt_make_source(input, 2)
    let ctx = fmt_tokenize(fmt_context_new(src, 2))
    ctx.token_count == 2 &&
    ctx.tokens[0].kind == FMT_TOK_PUNC &&
    ctx.tokens[0].text_len == 1
}

// T39: Block detection produces at least one block
fn test_fmt_block_detection() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "fn f() {\nx\n}\n"
    input[0] = 102  // f
    input[1] = 110  // n
    input[2] = 32   // ' '
    input[3] = 102  // f
    input[4] = 40   // (
    input[5] = 41   // )
    input[6] = 32   // ' '
    input[7] = 123  // {
    input[8] = 10   // \n
    input[9] = 120  // x
    input[10] = 10  // \n
    input[11] = 125 // }
    input[12] = 10  // \n
    let src = fmt_make_source(input, 13)
    var ctx = fmt_context_new(src, 13)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    ctx = fmt_detect_blocks(ctx)
    ctx.block_count > 0
}

// T40: Empty input produces minimal output
fn test_fmt_empty_input() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    let ctx = fmt_format(src, 0)
    // Empty input with trailing_newline enabled should produce just \n
    ctx.output.pos == 1 && ctx.output.bytes[0] == FMT_CHAR_NEWLINE
}

// T41: Output range copy
fn test_fmt_output_range() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 65  // A
    src[1] = 66  // B
    src[2] = 67  // C
    var out = fmt_output_new()
    out = fmt_output_range(out, src, 0, 3)
    out.pos == 3 && out.bytes[0] == 65 && out.bytes[1] == 66 && out.bytes[2] == 67
}

// T42: Line width estimation
fn test_fmt_line_width() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "let x = 5\n"
    input[0] = 108  // l
    input[1] = 101  // e
    input[2] = 116  // t
    input[3] = 32   // ' '
    input[4] = 120  // x
    input[5] = 32   // ' '
    input[6] = 61   // =
    input[7] = 32   // ' '
    input[8] = 53   // 5
    input[9] = 10   // \n
    let src = fmt_make_source(input, 10)
    var ctx = fmt_context_new(src, 10)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    let width = fmt_estimate_line_width(ctx, 0)
    // "let" (3) + " " (1) + "x" (1) + " " (1) + "=" (1) + " " (1) + "5" (1) = 9
    // plus indent 0 * 4 = 0 => total 9
    width == 9
}

// T43: Assignment eq column detection
fn test_fmt_eq_col() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "let x = 5\n"
    input[0] = 108  // l
    input[1] = 101  // e
    input[2] = 116  // t
    input[3] = 32   // ' '
    input[4] = 120  // x
    input[5] = 32   // ' '
    input[6] = 61   // =
    input[7] = 32   // ' '
    input[8] = 53   // 5
    input[9] = 10   // \n
    let src = fmt_make_source(input, 10)
    var ctx = fmt_context_new(src, 10)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    let col = fmt_find_eq_col(ctx, 0)
    // "let"(3) + space(1) + "x"(1) + space(1) = 6 before "="
    col >= 0
}

// T44: Keyword detection: "let"
fn test_fmt_keyword_let() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 108  // l
    src[1] = 101  // e
    src[2] = 116  // t
    fmt_is_keyword_at(src, 0, 3)
}

// T45: Keyword detection: "var"
fn test_fmt_keyword_var() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 118  // v
    src[1] = 97   // a
    src[2] = 114  // r
    fmt_is_keyword_at(src, 0, 3)
}

// T46: Keyword detection: "while"
fn test_fmt_keyword_while() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 119  // w
    src[1] = 104  // h
    src[2] = 105  // i
    src[3] = 108  // l
    src[4] = 101  // e
    fmt_is_keyword_at(src, 0, 5)
}

// T47: Keyword detection: "return"
fn test_fmt_keyword_return() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
