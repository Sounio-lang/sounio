    src[0] = 101  // e
    src[1] = 108  // l
    src[2] = 115  // s
    src[3] = 101  // e
    fmt_is_keyword_at(src, 0, 4)
}

// T60: Context construction with config
fn test_fmt_context_with_config() -> bool with Mut, Panic {
    var cfg = fmt_config_default()
    cfg.indent_width = 8
    cfg.brace_style = FMT_BRACE_NEXT_LINE
    var src: [i8; 65536] = [0; 65536]
    let ctx = fmt_context_with_config(src, 0, cfg)
    ctx.config.indent_width == 8 && ctx.config.brace_style == FMT_BRACE_NEXT_LINE
}

// T61: Output has_run detection
fn test_fmt_output_has_run_true() -> bool with Mut, Div, Panic {
    var out = fmt_output_new()
    out = fmt_output_byte(out, 65)
    out = fmt_output_byte(out, 65)
    out = fmt_output_byte(out, 65)
    var src: [i8; 65536] = [0; 65536]
    var ctx = fmt_context_new(src, 0)
    ctx.output = out
    fmt_output_has_run(ctx, 65, 3)
}

// T62: Output has_run detection (false case)
fn test_fmt_output_has_run_false() -> bool with Mut, Div, Panic {
    var out = fmt_output_new()
    out = fmt_output_byte(out, 65)
    out = fmt_output_byte(out, 66)
    out = fmt_output_byte(out, 65)
    var src: [i8; 65536] = [0; 65536]
    var ctx = fmt_context_new(src, 0)
    ctx.output = out
    fmt_output_has_run(ctx, 65, 2) == false
}

// T63: Scan line comment
fn test_fmt_scan_line_comment() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    // "// hi\n"
    src[0] = 47   // /
    src[1] = 47   // /
    src[2] = 32   // ' '
    src[3] = 104  // h
    src[4] = 105  // i
    src[5] = 10   // \n
    let end = fmt_scan_line_comment(src, 0, 6)
    end == 5
}

// T64: Scan block comment
fn test_fmt_scan_block_comment() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    // "/* hi */"
    src[0] = 47   // /
    src[1] = 42   // *
    src[2] = 32   // ' '
    src[3] = 104  // h
    src[4] = 105  // i
    src[5] = 32   // ' '
    src[6] = 42   // *
    src[7] = 47   // /
    let end = fmt_scan_block_comment(src, 0, 8)
    end == 8
}

// T65: Scan string literal
fn test_fmt_scan_string_lit() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    // "\"abc\""
    src[0] = 34   // "
    src[1] = 97   // a
    src[2] = 98   // b
    src[3] = 99   // c
    src[4] = 34   // "
    let end = fmt_scan_string(src, 0, 5)
    end == 5
}

// T66: Scan ident
fn test_fmt_scan_ident() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 102   // f
    src[1] = 111   // o
    src[2] = 111   // o
    src[3] = 95    // _
    src[4] = 98    // b
    src[5] = 97    // a
    src[6] = 114   // r
    src[7] = 32    // ' '
    let end = fmt_scan_ident(src, 0, 8)
    end == 7
}

// T67: Scan operator: ->
fn test_fmt_scan_operator_arrow() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 45   // -
    src[1] = 62   // >
    src[2] = 32   // ' '
    let end = fmt_scan_operator(src, 0, 3)
    end == 2
}

// T68: Constants have expected values
fn test_fmt_constants() -> bool {
    FMT_MAX_TOKENS == 8192 &&
    FMT_MAX_LINES == 2048 &&
    FMT_MAX_BLOCKS == 512 &&
    FMT_MAX_OUTPUT == 65536 &&
    FMT_DEFAULT_INDENT == 4 &&
    FMT_DEFAULT_MAX_WIDTH == 100 &&
    FMT_BRACE_SAME_LINE == 1 &&
    FMT_BRACE_NEXT_LINE == 2
}

// T69: Token kind constants are distinct
fn test_fmt_token_kinds_distinct() -> bool {
    FMT_TOK_KEYWORD != FMT_TOK_IDENT &&
    FMT_TOK_IDENT != FMT_TOK_NUMBER &&
    FMT_TOK_NUMBER != FMT_TOK_STRING &&
    FMT_TOK_STRING != FMT_TOK_OP &&
    FMT_TOK_OP != FMT_TOK_PUNC &&
    FMT_TOK_PUNC != FMT_TOK_COMMENT &&
    FMT_TOK_COMMENT != FMT_TOK_NEWLINE &&
    FMT_TOK_NEWLINE != FMT_TOK_SPACE
}

// T70: Block kinds are distinct
fn test_fmt_block_kinds_distinct() -> bool {
    FMT_BLOCK_FN != FMT_BLOCK_IF &&
    FMT_BLOCK_IF != FMT_BLOCK_FOR &&
    FMT_BLOCK_FOR != FMT_BLOCK_STRUCT &&
    FMT_BLOCK_STRUCT != FMT_BLOCK_GENERIC &&
    FMT_BLOCK_GENERIC != FMT_BLOCK_IMPL &&
    FMT_BLOCK_IMPL != FMT_BLOCK_WHILE &&
    FMT_BLOCK_WHILE != FMT_BLOCK_ENUM
}

