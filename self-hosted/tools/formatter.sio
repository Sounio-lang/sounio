    total = total + 1
    if test_fmt_config_defaults() { passed = passed + 1 } else { print("FAIL: T01 config_defaults\n") }

    total = total + 1
    if test_fmt_output_new() { passed = passed + 1 } else { print("FAIL: T02 output_new\n") }

