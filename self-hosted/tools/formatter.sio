    src[1] = 101  // e
    src[2] = 116  // t
    src[3] = 117  // u
    src[4] = 114  // r
    src[5] = 110  // n
    fmt_is_keyword_at(src, 0, 6)
}

// T48: Trim trailing whitespace helper
fn test_fmt_trim_trailing() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 120  // x
    src[1] = 32   // ' '
    src[2] = 32   // ' '
    let trimmed = fmt_trim_trailing(src, 0, 3)
    trimmed == 1
}

// T49: Trim trailing: all spaces
fn test_fmt_trim_trailing_all_spaces() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 32  // ' '
    src[1] = 32  // ' '
    let trimmed = fmt_trim_trailing(src, 0, 2)
    trimmed == 0
}

// T50: No trailing whitespace in formatted output
fn test_fmt_no_trailing_ws_output() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "let x = 5  \nvar y = 10  \n"
    input[0] = 108   // l
    input[1] = 101   // e
    input[2] = 116   // t
    input[3] = 32    // ' '
    input[4] = 120   // x
    input[5] = 32    // ' '
    input[6] = 61    // =
    input[7] = 32    // ' '
    input[8] = 53    // 5
    input[9] = 32    // ' '
    input[10] = 32   // ' '
    input[11] = 10   // \n
    input[12] = 118  // v
    input[13] = 97   // a
    input[14] = 114  // r
    input[15] = 32   // ' '
    input[16] = 121  // y
    input[17] = 32   // ' '
    input[18] = 61   // =
    input[19] = 32   // ' '
    input[20] = 49   // 1
    input[21] = 48   // 0
    input[22] = 32   // ' '
    input[23] = 32   // ' '
    input[24] = 10   // \n
    let src = fmt_make_source(input, 25)
    let ctx = fmt_format(src, 25)
    fmt_output_no_trailing_ws(ctx)
}

// T51: Config with custom indent width
fn test_fmt_config_custom_indent() -> bool with Mut, Div, Panic {
    var cfg = fmt_config_default()
    cfg.indent_width = 2
    var input: [i8; 256] = [0; 256]
    // "fn f() {\nx\n}\n"
    input[0] = 102  // f
    input[1] = 110  // n
    input[2] = 32   // ' '
    input[3] = 102  // f
    input[4] = 40   // (
    input[5] = 41   // )
    input[6] = 32   // ' '
    input[7] = 123  // {
    input[8] = 10   // \n
    input[9] = 120  // x
    input[10] = 10  // \n
    input[11] = 125 // }
    input[12] = 10  // \n
    let src = fmt_make_source(input, 13)
    let ctx = fmt_format_with_config(src, 13, cfg)
    // With indent_width=2, inner "x" should have 2 leading spaces
    // Output: "fn f() {\n  x\n}\n"
    // Byte 9 (after "fn f() {\n") should be space
    ctx.output.pos > 12 && ctx.output.bytes[9] == FMT_CHAR_SPACE && ctx.output.bytes[10] == FMT_CHAR_SPACE
}

// T52: Scan number: integer
fn test_fmt_scan_number_int() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 49  // 1
    src[1] = 50  // 2
    src[2] = 51  // 3
    src[3] = 32  // ' '
    let end = fmt_scan_number(src, 0, 4)
    end == 3
}

// T53: Scan number: float
fn test_fmt_scan_number_float() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 51   // 3
    src[1] = 46   // .
    src[2] = 49   // 1
    src[3] = 52   // 4
    src[4] = 32   // ' '
    let end = fmt_scan_number(src, 0, 5)
    end == 4
}

// T54: Scan number: hex
fn test_fmt_scan_number_hex() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 48    // 0
    src[1] = 120   // x
    src[2] = 70    // F
    src[3] = 70    // F
    src[4] = 32    // ' '
    let end = fmt_scan_number(src, 0, 5)
    end == 4
}

// T55: Output byte counting
fn test_fmt_output_count() -> bool with Mut, Div, Panic {
    var out = fmt_output_new()
    out = fmt_output_byte(out, FMT_CHAR_NEWLINE)
    out = fmt_output_byte(out, 65)
    out = fmt_output_byte(out, FMT_CHAR_NEWLINE)
    out = fmt_output_byte(out, 66)
    out = fmt_output_byte(out, FMT_CHAR_NEWLINE)
    let ctx_for_count = fmt_context_new([0; 65536], 0)
    // Build a minimal context with the output
    var ctx = ctx_for_count
    ctx.output = out
    let count = fmt_output_count_byte(ctx, FMT_CHAR_NEWLINE)
    count == 3
}

// T56: Format preserves comment content
fn test_fmt_preserves_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "// hello world\n"
    input[0] = 47    // /
    input[1] = 47    // /
    input[2] = 32    // ' '
    input[3] = 104   // h
    input[4] = 101   // e
    input[5] = 108   // l
    input[6] = 108   // l
    input[7] = 111   // o
    input[8] = 32    // ' '
    input[9] = 119   // w
    input[10] = 111  // o
    input[11] = 114  // r
    input[12] = 108  // l
    input[13] = 100  // d
    input[14] = 10   // \n
    let src = fmt_make_source(input, 15)
    let ctx = fmt_format(src, 15)
    // Output should contain the comment text starting with //
    ctx.output.pos > 2 && ctx.output.bytes[0] == 47 && ctx.output.bytes[1] == 47
}

// T57: Multiple tokens on one line
fn test_fmt_multi_token_line() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "let x: i64 = 42\n"
    input[0] = 108   // l
    input[1] = 101   // e
    input[2] = 116   // t
    input[3] = 32    // ' '
    input[4] = 120   // x
    input[5] = 58    // :
    input[6] = 32    // ' '
    input[7] = 105   // i
    input[8] = 54    // 6
    input[9] = 52    // 4
    input[10] = 32   // ' '
    input[11] = 61   // =
    input[12] = 32   // ' '
    input[13] = 52   // 4
    input[14] = 50   // 2
    input[15] = 10   // \n
    let src = fmt_make_source(input, 16)
    var ctx = fmt_context_new(src, 16)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    // Tokens: let, x, :, i64, =, 42, \n
    // Line 0 should have 6 tokens (excluding newline)
    ctx.lines[0].token_count == 6
}

// T58: Keyword detection: "if"
fn test_fmt_keyword_if() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 105  // i
    src[1] = 102  // f
    fmt_is_keyword_at(src, 0, 2)
}

// T59: Keyword detection: "else"
fn test_fmt_keyword_else() -> bool with Mut, Div, Panic {
