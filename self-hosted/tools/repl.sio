// self-hosted::tools::repl — Read-eval-print loop for Sounio
//
// Fixed-capacity history (256 entries, ring-buffer eviction).
// Built-in integer expression evaluator: +, -, *, /, parentheses,
// correct operator precedence (mul/div before add/sub).
// Special commands: :q/:quit/exit/quit, :help, :history.

// ============================================================================
// CONSTANTS
// ============================================================================

fn REPL_OK()        -> i64 { 0 }
fn REPL_QUIT()      -> i64 { 1 }
fn REPL_PARSE_ERR() -> i64 { 2 }
fn REPL_EVAL_ERR()  -> i64 { 3 }

fn REPL_MAX_HISTORY()  -> i64 { 256 }
fn REPL_CHAR_STORAGE() -> i64 { 16384 }

// ============================================================================
// STRUCTS
// ============================================================================

struct ReplHistory {
    entries: [i8; 16384],  // char storage for all history entries
    offsets: [i64; 256],   // start offset of each entry
    lengths: [i64; 256],   // length of each entry
    count:   i64,
    head:    i64,          // ring buffer head for eviction
    storage_used: i64,     // bytes consumed in entries[]
}

struct ReplResult {
    output:     [i8; 4096],
    output_len: i64,
    error:      [i8; 512],
    error_len:  i64,
    ok:         bool,
    exit_code:  i64,
}

struct ReplState {
    history:     ReplHistory,
    prompt:      [i8; 64],
    prompt_len:  i64,
    line_count:  i64,
    last_result: ReplResult,
}

// ============================================================================
// HELPERS: empty structs
// ============================================================================

fn repl_empty_history() -> ReplHistory with Mut {
    ReplHistory {
        entries:      [0; 16384],
        offsets:      [0; 256],
        lengths:      [0; 256],
        count:        0,
        head:         0,
        storage_used: 0,
    }
}

fn repl_result_new() -> ReplResult with Mut {
    ReplResult {
        output:     [0; 4096],
        output_len: 0,
        error:      [0; 512],
        error_len:  0,
        ok:         true,
        exit_code:  REPL_OK(),
    }
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn repl_new() -> ReplState with Mut {
    ReplState {
        history:     repl_empty_history(),
        prompt:      [0; 64],
        prompt_len:  0,
        line_count:  0,
        last_result: repl_result_new(),
    }
}

// ============================================================================
// COPY STRING INTO i8 ARRAY HELPERS
// ============================================================================

fn repl_copy_to_i8_64(dst: &![i8; 64], s: string) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var cap: i64 = 64
    var lim: i64 = n
    if lim > cap { lim = cap }
    var i: i64 = 0
    while i < lim {
        dst[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    lim
}

fn repl_copy_to_i8_4096(dst: &![i8; 4096], s: string) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var cap: i64 = 4096
    var lim: i64 = n
    if lim > cap { lim = cap }
    var i: i64 = 0
    while i < lim {
        dst[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    lim
}

fn repl_copy_to_i8_512(dst: &![i8; 512], s: string) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var cap: i64 = 512
    var lim: i64 = n
    if lim > cap { lim = cap }
    var i: i64 = 0
    while i < lim {
        dst[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    lim
}

// ============================================================================
// SET PROMPT
// ============================================================================

fn repl_set_prompt(r: &! ReplState, prompt: string) -> () with Mut, Panic, Div {
    let n = str_len(prompt)
    var cap: i64 = 64
    var lim: i64 = n
    if lim > cap { lim = cap }
    var i: i64 = 0
    while i < lim {
        r.prompt[i as usize] = str_char_at(prompt, i) as i8
        i = i + 1
    }
    r.prompt_len = lim
}

// ============================================================================
// HISTORY — ring-buffer eviction
// ============================================================================

// Add a line to history. When count reaches 256, evict by reusing slots
// from head onwards. Storage is managed with a simple compaction-free policy:
// if there isn't enough room for a new entry, we reset storage_used and
// reuse from the beginning of entries[] (the simplest correct approach
// compatible with fixed-size arrays and no allocator).
fn repl_add_history(r: &! ReplState, line: string) -> () with Mut, Panic, Div {
    let slen = str_len(line)
    let max_hist = REPL_MAX_HISTORY()
    let max_stor = REPL_CHAR_STORAGE()
    // Clamp line length to fit in storage
    var lim: i64 = slen
    if lim > max_stor { lim = max_stor }

    // If full, evict oldest (head index)
    var slot: i64 = 0
    if r.history.count < max_hist {
        slot = r.history.count
    } else {
        slot = r.history.head
        r.history.head = (r.history.head + 1) % max_hist
    }

    // If new entry doesn't fit at current storage_used, wrap storage
    if r.history.storage_used + lim > max_stor {
        r.history.storage_used = 0
    }

    let off = r.history.storage_used
    // Copy chars
    var i: i64 = 0
    while i < lim {
        r.history.entries[(off + i) as usize] = str_char_at(line, i) as i8
        i = i + 1
    }
    r.history.offsets[slot as usize] = off
    r.history.lengths[slot as usize] = lim
    r.history.storage_used = r.history.storage_used + lim

    if r.history.count < max_hist {
        r.history.count = r.history.count + 1
    }
    r.line_count = r.line_count + 1
}

// ============================================================================
// HISTORY ACCESSORS
// ============================================================================

fn repl_history_count(r: &ReplState) -> i64 {
    r.history.count
}

fn repl_history_get(r: &ReplState, idx: i64) -> string with Panic, Div {
    if idx < 0 || idx >= r.history.count {
        return ""
    }
    let off = r.history.offsets[idx as usize]
    let len = r.history.lengths[idx as usize]
    str_from_bytes(r.history.entries, off, len)
}

fn repl_history_last(r: &ReplState) -> string with Panic, Div {
    if r.history.count == 0 {
        return ""
    }
    let idx = r.history.count - 1
    repl_history_get(r, idx)
}

// ============================================================================
// RESULT ACCESSORS
// ============================================================================

fn repl_result_ok(res: &ReplResult) -> bool {
    res.ok
}

fn repl_result_output(res: &ReplResult) -> string with Panic {
    str_from_bytes(res.output, res.output_len)
}

fn repl_result_error(res: &ReplResult) -> string with Panic {
    str_from_bytes(res.error, res.error_len)
}

fn repl_result_set_output(res: &! ReplResult, s: string) -> () with Mut, Panic, Div {
    let n = str_len(s)
    var lim: i64 = n
    if lim > 4096 { lim = 4096 }
    var i: i64 = 0
    while i < lim {
        res.output[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    res.output_len = lim
}

fn repl_result_set_error(res: &! ReplResult, s: string) -> () with Mut, Panic, Div {
    let n = str_len(s)
    var lim: i64 = n
    if lim > 512 { lim = 512 }
    var i: i64 = 0
    while i < lim {
        res.error[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    res.error_len = lim
}

// ============================================================================
// COMMAND DETECTION
// ============================================================================

// Compare a prefix of a string to a literal.
fn repl_str_eq(s: string, lit: string) -> bool with Mut, Panic, Div {
    let sn = str_len(s)
    let ln = str_len(lit)
    if sn != ln { return false }
    var i: i64 = 0
    while i < ln {
        if str_char_at(s, i) != str_char_at(lit, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn repl_is_quit_cmd(input: string) -> bool with Mut, Panic, Div {
    repl_str_eq(input, ":q") || repl_str_eq(input, ":quit") || repl_str_eq(input, "exit") || repl_str_eq(input, "quit")
}

fn repl_is_help_cmd(input: string) -> bool with Mut, Panic, Div {
    repl_str_eq(input, ":help") || repl_str_eq(input, ":h") || repl_str_eq(input, "help")
}

fn repl_is_history_cmd(input: string) -> bool with Mut, Panic, Div {
    repl_str_eq(input, ":history") || repl_str_eq(input, ":hist")
}

// Check whether input starts with a given prefix string.
fn repl_starts_with(s: string, prefix: string) -> bool with Mut, Panic, Div {
    let sn = str_len(s)
    let pn = str_len(prefix)
    if sn < pn { return false }
    var i: i64 = 0
    while i < pn {
        if str_char_at(s, i) != str_char_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    true
}

// :type <expr> — detect command
fn repl_is_type_cmd(input: string) -> bool with Mut, Panic, Div {
    repl_starts_with(input, ":type ")
}

// Extract the expression argument from ":type <expr>"
fn repl_type_cmd_arg(input: string) -> string with Mut, Panic, Div {
    let n = str_len(input)
    // ":type " is 6 chars
    if n <= 6 { return "" }
    // build substring from pos 6 onward
    var buf: [i8; 4096] = [0; 4096]
    var i: i64 = 6
    var j: i64 = 0
    while i < n && j < 4095 {
        buf[j as usize] = str_char_at(input, i) as i8
        i = i + 1
        j = j + 1
    }
    str_from_bytes(buf, j)
}

// :econf — detect command
fn repl_is_econf_cmd(input: string) -> bool with Mut, Panic, Div {
    repl_str_eq(input, ":econf")
}

// ============================================================================
// EPISTEMIC SESSION STATE
// ============================================================================
//
// A lightweight in-session epistemic certificate: tracks the running count of
// evaluated expressions, the number that parsed successfully, and the current
// aggregate confidence (0–1000 fixed-point, like lean_single's EXPR_CONF).
// Updated by repl_eval_expr; displayed by :econf.

struct ReplEpistState {
    total_exprs:    i64,   // expressions evaluated (attempted)
    certain_exprs:  i64,   // expressions that evaluated without error
    session_conf:   i64,   // current aggregate confidence (0-1000)
    gate_threshold: i64,   // threshold for "high confidence" badge (default 950)
}

fn repl_epist_new() -> ReplEpistState {
    ReplEpistState {
        total_exprs:   0,
        certain_exprs: 0,
        session_conf:  1000,  // start fully confident; degrades on errors
        gate_threshold: 950,
    }
}

// Update epistemic state after an evaluation. ok=true → certain, ok=false → uncertain.
fn repl_epist_update(ep: &! ReplEpistState, ok: bool) -> () with Mut {
    ep.total_exprs = ep.total_exprs + 1
    if ok {
        ep.certain_exprs = ep.certain_exprs + 1
        // Confidence rises toward 1000 on success: GUM product raise by 1%
        let new_conf = ep.session_conf + (1000 - ep.session_conf) / 100
        if new_conf > 1000 { ep.session_conf = 1000 } else { ep.session_conf = new_conf }
    } else {
        // Confidence decays on error: multiply by 0.95 (950/1000)
        ep.session_conf = ep.session_conf * 950 / 1000
    }
}

// Build the :econf human-readable summary string.
// Returns something like:
//   epistemic-certificate { exprs=12 certain=11 conf=978/1000 badge=high-confidence }
fn repl_epist_summary(ep: &ReplEpistState) -> string with Mut, Panic, Div {
    // Build into a 512-byte scratch buffer using integer formatting.
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0

    // "epistemic-certificate { exprs="
    let hdr = "epistemic-certificate { exprs="
    let hn = str_len(hdr)
    var hi: i64 = 0
    while hi < hn && pos < 511 {
        buf[pos as usize] = str_char_at(hdr, hi) as i8
        pos = pos + 1
        hi = hi + 1
    }
    // write total_exprs
    var tmp: [i8; 64] = [0; 64]
    let tmp_ref = &! tmp
    let tlen = repl_int_to_chars(tmp_ref, ep.total_exprs, 0)
    var ti: i64 = 0
    while ti < tlen && pos < 511 {
        buf[pos as usize] = tmp[ti as usize]
        pos = pos + 1
        ti = ti + 1
    }
    // " certain="
    let c1 = " certain="
    let c1n = str_len(c1)
    var c1i: i64 = 0
    while c1i < c1n && pos < 511 {
        buf[pos as usize] = str_char_at(c1, c1i) as i8
        pos = pos + 1
        c1i = c1i + 1
    }
    // write certain_exprs
    var tmp2: [i8; 64] = [0; 64]
    let tmp2_ref = &! tmp2
    let t2len = repl_int_to_chars(tmp2_ref, ep.certain_exprs, 0)
    var t2i: i64 = 0
    while t2i < t2len && pos < 511 {
        buf[pos as usize] = tmp2[t2i as usize]
        pos = pos + 1
        t2i = t2i + 1
    }
    // " conf="
    let c2 = " conf="
    let c2n = str_len(c2)
    var c2i: i64 = 0
    while c2i < c2n && pos < 511 {
        buf[pos as usize] = str_char_at(c2, c2i) as i8
        pos = pos + 1
        c2i = c2i + 1
    }
    // write session_conf
    var tmp3: [i8; 64] = [0; 64]
    let tmp3_ref = &! tmp3
    let t3len = repl_int_to_chars(tmp3_ref, ep.session_conf, 0)
    var t3i: i64 = 0
    while t3i < t3len && pos < 511 {
        buf[pos as usize] = tmp3[t3i as usize]
        pos = pos + 1
        t3i = t3i + 1
    }
    // "/1000 badge="
    let c3 = "/1000 badge="
    let c3n = str_len(c3)
    var c3i: i64 = 0
    while c3i < c3n && pos < 511 {
        buf[pos as usize] = str_char_at(c3, c3i) as i8
        pos = pos + 1
        c3i = c3i + 1
    }
    // badge label
    let badge = if ep.session_conf >= ep.gate_threshold { "high-confidence" } else { "uncertain" }
    let bn = str_len(badge)
    var bi: i64 = 0
    while bi < bn && pos < 511 {
        buf[pos as usize] = str_char_at(badge, bi) as i8
        pos = pos + 1
        bi = bi + 1
    }
    // " }"
    if pos < 511 { buf[pos as usize] = 32 as i8; pos = pos + 1 }
    if pos < 511 { buf[pos as usize] = 125 as i8; pos = pos + 1 }  // '}'

    str_from_bytes(buf, pos)
}

// ============================================================================
// :hist DISPLAY
// ============================================================================

// Build a human-readable history listing for the last `limit` entries.
// Returns a multiline string. At most 10 entries shown (per REPL spec).
fn repl_format_history(r: &ReplState, limit: i64) -> string with Mut, Panic, Div {
    let count = r.history.count
    var show: i64 = limit
    if show > count { show = count }
    if show > 10 { show = 10 }
    // Each entry is at most 64 chars + "NNN: " prefix (5) + "\n" (1) = ~70 bytes.
    // 10 entries × 70 = 700 bytes; use 1024 scratch buffer.
    var buf: [i8; 1024] = [0; 1024]
    var pos: i64 = 0
    var i: i64 = 0
    // Start from oldest of the `show` entries
    let start = count - show
    while i < show {
        let entry_idx = start + i
        let line = repl_history_get(r, entry_idx)
        // Write entry number "NNN: "
        var nbuf: [i8; 64] = [0; 64]
        let nbuf_ref = &! nbuf
        let nlen = repl_int_to_chars(nbuf_ref, entry_idx + 1, 0)
        var ni: i64 = 0
        while ni < nlen && pos < 1022 {
            buf[pos as usize] = nbuf[ni as usize]
            pos = pos + 1
            ni = ni + 1
        }
        // ": "
        if pos < 1022 { buf[pos as usize] = 58 as i8; pos = pos + 1 }   // ':'
        if pos < 1022 { buf[pos as usize] = 32 as i8; pos = pos + 1 }   // ' '
        // entry text
        let llen = str_len(line)
        var li: i64 = 0
        while li < llen && pos < 1022 {
            buf[pos as usize] = str_char_at(line, li) as i8
            pos = pos + 1
            li = li + 1
        }
        // newline
        if pos < 1022 { buf[pos as usize] = 10 as i8; pos = pos + 1 }   // '\n'
        i = i + 1
    }
    str_from_bytes(buf, pos)
}

// ============================================================================
// MULTI-LINE INPUT DETECTION
// ============================================================================
//
// Returns true if the line has unclosed `{` or `(` delimiters, meaning the
// user's expression is incomplete and further input should be gathered.

fn repl_needs_continuation(line: string) -> bool with Mut, Panic, Div {
    let n = str_len(line)
    var depth_brace: i64 = 0
    var depth_paren: i64 = 0
    var i: i64 = 0
    while i < n {
        let c = str_char_at(line, i)
        if c == 123 { depth_brace = depth_brace + 1 }    // '{'
        if c == 125 { depth_brace = depth_brace - 1 }    // '}'
        if c == 40  { depth_paren = depth_paren + 1 }    // '('
        if c == 41  { depth_paren = depth_paren - 1 }    // ')'
        i = i + 1
    }
    depth_brace > 0 || depth_paren > 0
}

// ============================================================================
// :type HANDLER
// ============================================================================
//
// Evaluates `expr_str` as an integer expression and returns a ReplResult
// whose output is "expr_str : i64  [conf=EXPR_CONF_PLACEHOLDER/1000]".
// The "type" shown is always i64 for this integer evaluator. The conf field
// is set to 1000 on success (literal fully determined), 0 on parse error.

fn repl_handle_type_cmd(r: &! ReplState, expr_str: string) -> ReplResult with Mut, Panic, Div {
    var res = repl_result_new()
    if str_len(expr_str) == 0 {
        res.ok = false
        res.exit_code = REPL_PARSE_ERR()
        repl_result_set_error(&! res, ":type requires an expression")
        return res
    }
    // Evaluate to get the actual value (and determine success/failure)
    let eval_res = repl_eval_expr(r, expr_str)
    // Confidence: 1000 if evaluated cleanly, 0 if error
    let conf: i64 = if eval_res.ok { 1000 } else { 0 }
    // Build output: "expr : i64  [conf=CONF/1000]"
    var buf: [i8; 256] = [0; 256]
    var pos: i64 = 0
    // copy expr_str
    let en = str_len(expr_str)
    var ei: i64 = 0
    while ei < en && pos < 250 {
        buf[pos as usize] = str_char_at(expr_str, ei) as i8
        pos = pos + 1
        ei = ei + 1
    }
    // " : i64  [conf="
    let mid = " : i64  [conf="
    let mn = str_len(mid)
    var mi: i64 = 0
    while mi < mn && pos < 250 {
        buf[pos as usize] = str_char_at(mid, mi) as i8
        pos = pos + 1
        mi = mi + 1
    }
    // write conf value
    var tmp: [i8; 64] = [0; 64]
    let tmp_ref = &! tmp
    let tlen = repl_int_to_chars(tmp_ref, conf, 0)
    var ti: i64 = 0
    while ti < tlen && pos < 250 {
        buf[pos as usize] = tmp[ti as usize]
        pos = pos + 1
        ti = ti + 1
    }
    // "/1000]"
    let tail = "/1000]"
    let tn = str_len(tail)
    var tli: i64 = 0
    while tli < tn && pos < 250 {
        buf[pos as usize] = str_char_at(tail, tli) as i8
        pos = pos + 1
        tli = tli + 1
    }
    res.ok = true
    res.exit_code = REPL_OK()
    let out = str_from_bytes(buf, pos)
    repl_result_set_output(&! res, out)
    res
}

// ============================================================================
// PROMPT FORMATTING
// ============================================================================

// Build a prompt string "sounio[N]> " where N is line_num.
// Uses digit extraction and builds into a small scratch buffer.
fn repl_int_to_chars(buf: &![i8; 64], n: i64, pos: i64) -> i64 with Mut, Panic, Div {
    if n == 0 {
        buf[pos as usize] = 48 as i8  // '0'
        return pos + 1
    }
    var val: i64 = n
    if val < 0 { val = 0 - val }
    // Collect digits in reverse
    var digits: [i8; 20] = [0; 20]
    var dcount: i64 = 0
    while val > 0 && dcount < 20 {
        let d = (val % 10) as i8
        digits[dcount as usize] = (48 + d as i64) as i8
        val = val / 10
        dcount = dcount + 1
    }
    // Write reversed
    var p: i64 = pos
    var j: i64 = dcount - 1
    while j >= 0 {
        if p < 64 {
            buf[p as usize] = digits[j as usize]
            p = p + 1
        }
        j = j - 1
    }
    p
}

fn repl_format_prompt(r: &ReplState, line_num: i64) -> string with Mut, Panic, Div {
    // Build "sounio[N]> "
    var buf: [i8; 64] = [0; 64]
    // "sounio[" = 115 111 117 110 105 111 91
    buf[0] = 115 as i8
    buf[1] = 111 as i8
    buf[2] = 117 as i8
    buf[3] = 110 as i8
    buf[4] = 105 as i8
    buf[5] = 111 as i8
    buf[6] = 91 as i8
    let buf_ref = &! buf
    var pos: i64 = repl_int_to_chars(buf_ref, line_num, 7)
    // ']' = 93
    if pos < 64 {
        buf[pos as usize] = 93 as i8
        pos = pos + 1
    }
    // '>' = 62
    if pos < 64 {
        buf[pos as usize] = 62 as i8
        pos = pos + 1
    }
    // ' ' = 32
    if pos < 64 {
        buf[pos as usize] = 32 as i8
        pos = pos + 1
    }
    str_from_bytes(buf, pos)
}

// ============================================================================
// INTEGER EXPRESSION EVALUATOR
// ============================================================================
//
// Recursive-descent parser with proper precedence:
//   expr   = term   { ('+' | '-') term }
//   term   = factor { ('*' | '/') factor }
//   factor = '(' expr ')' | integer
//
// State: input string + current position (threaded as (value, new_pos) pairs).

// Skip whitespace.
fn repl_skip_ws(s: string, pos: i64) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var p: i64 = pos
    while p < n {
        let c = str_char_at(s, p)
        if c == 32 || c == 9 { p = p + 1 } else { break }
    }
    p
}

// Parse an integer literal. Returns (value, new_pos).
// On failure returns (0, same_pos) — caller detects by pos not advancing.
fn repl_parse_int(s: string, pos: i64) -> (i64, i64) with Mut, Panic, Div {
    let n = str_len(s)
    var p: i64 = repl_skip_ws(s, pos)
    if p >= n {
        return (0, pos)
    }
    let c0 = str_char_at(s, p)
    // Digits 48..57
    if c0 < 48 || c0 > 57 {
        return (0, pos)
    }
    var val: i64 = 0
    while p < n {
        let c = str_char_at(s, p)
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        p = p + 1
    }
    (val, p)
}

// Forward declaration pattern: parse_expr and parse_term are mutually needed.
// We implement without mutual recursion by inlining factor parsing.

// Parse factor: '(' expr ')' | integer
// Returns (value, new_pos, ok)
fn repl_parse_factor(s: string, pos: i64) -> (i64, i64, bool) with Mut, Panic, Div {
    let p = repl_skip_ws(s, pos)
    let n = str_len(s)
    if p >= n {
        return (0, pos, false)
    }
    let c = str_char_at(s, p)
    // '(' = 40
    if c == 40 {
        let inner_pos = repl_parse_expr_entry(s, p + 1)
        let val = inner_pos.0
        let after = inner_pos.1
        let ok = inner_pos.2
        if !ok {
            return (0, pos, false)
        }
        let after2 = repl_skip_ws(s, after)
        if after2 >= n {
            return (0, pos, false)
        }
        let closing = str_char_at(s, after2)
        // ')' = 41
        if closing != 41 {
            return (0, pos, false)
        }
        return (val, after2 + 1, true)
    }
    // Try integer
    let r = repl_parse_int(s, p)
    let v = r.0
    let np = r.1
    if np == p {
        return (0, pos, false)
    }
    (v, np, true)
}

// Parse term: factor { ('*' | '/') factor }
fn repl_parse_term(s: string, pos: i64) -> (i64, i64, bool) with Mut, Panic, Div {
    let n = str_len(s)
    let fres = repl_parse_factor(s, pos)
    var val: i64 = fres.0
    var p: i64 = fres.1
    var ok: bool = fres.2
    if !ok {
        return (0, pos, false)
    }
    var running: bool = true
    while running {
        let p2 = repl_skip_ws(s, p)
        if p2 >= n {
            running = false
        } else {
            let c = str_char_at(s, p2)
            // '*' = 42, '/' = 47
            if c == 42 {
                let rhs = repl_parse_factor(s, p2 + 1)
                if !rhs.2 {
                    running = false
                } else {
                    val = val * rhs.0
                    p = rhs.1
                }
            } else if c == 47 {
                let rhs = repl_parse_factor(s, p2 + 1)
                if !rhs.2 {
                    running = false
                } else {
                    if rhs.0 == 0 {
                        return (0, pos, false)
                    }
                    val = val / rhs.0
                    p = rhs.1
                }
            } else {
                running = false
            }
        }
    }
    (val, p, true)
}

// Parse expr: term { ('+' | '-') term }
fn repl_parse_expr(s: string, pos: i64) -> (i64, i64, bool) with Mut, Panic, Div {
    let n = str_len(s)
    let tres = repl_parse_term(s, pos)
    var val: i64 = tres.0
    var p: i64 = tres.1
    var ok: bool = tres.2
    if !ok {
        return (0, pos, false)
    }
    var running: bool = true
    while running {
        let p2 = repl_skip_ws(s, p)
        if p2 >= n {
            running = false
        } else {
            let c = str_char_at(s, p2)
            // '+' = 43, '-' = 45
            if c == 43 {
                let rhs = repl_parse_term(s, p2 + 1)
                if !rhs.2 {
                    running = false
                } else {
                    val = val + rhs.0
                    p = rhs.1
                }
            } else if c == 45 {
                let rhs = repl_parse_term(s, p2 + 1)
                if !rhs.2 {
                    running = false
                } else {
                    val = val - rhs.0
                    p = rhs.1
                }
            } else {
                running = false
            }
        }
    }
    (val, p, true)
}

// Entry point for recursive parser (used by repl_parse_factor for nested parens)
fn repl_parse_expr_entry(s: string, pos: i64) -> (i64, i64, bool) with Mut, Panic, Div {
    repl_parse_expr(s, pos)
}

// ============================================================================
// INTEGER TO STRING
// ============================================================================

fn repl_i64_to_string(n: i64) -> string with Mut, Panic, Div {
    var buf: [i8; 24] = [0; 24]
    if n == 0 {
        buf[0] = 48 as i8
        return str_from_bytes(buf, 1)
    }
    var val: i64 = n
    var neg: bool = false
    if val < 0 {
        neg = true
        val = 0 - val
    }
    var digits: [i8; 20] = [0; 20]
    var dcount: i64 = 0
    while val > 0 && dcount < 20 {
        let d = val % 10
        digits[dcount as usize] = (48 + d) as i8
        val = val / 10
        dcount = dcount + 1
    }
    var pos: i64 = 0
    if neg {
        buf[0] = 45 as i8  // '-'
        pos = 1
    }
    var j: i64 = dcount - 1
    while j >= 0 {
        buf[pos as usize] = digits[j as usize]
        pos = pos + 1
        j = j - 1
    }
    str_from_bytes(buf, pos)
}

// Check whether a string contains a '.' character (dot = 46).
// Used by repl_eval_expr to detect f64 mode.
fn repl_has_float_literal(s: string) -> bool with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char_at(s, i) == 46 { return true }
        i = i + 1
    }
    return false
}

// ============================================================================
// EVAL EXPRESSION
// ============================================================================

fn repl_eval_expr(r: &! ReplState, input: string) -> ReplResult with Mut, Panic, Div {
    // If the expression contains a '.', evaluate in f64 mode
    if repl_has_float_literal(input) {
        return repl_eval_f64_expr(r, input)
    }
    var res = repl_result_new()
    let triple = repl_parse_expr(input, 0)
    let val = triple.0
    let end_pos = triple.1
    let ok = triple.2
    if !ok {
        res.ok = false
        res.exit_code = REPL_PARSE_ERR()
        repl_result_set_error(&! res, "parse error")
        return res
    }
    // Check that all input was consumed (after whitespace)
    let n = str_len(input)
    let final_pos = repl_skip_ws(input, end_pos)
    if final_pos < n {
        res.ok = false
        res.exit_code = REPL_PARSE_ERR()
        repl_result_set_error(&! res, "unexpected input")
        return res
    }
    let out = repl_i64_to_string(val)
    repl_result_set_output(&! res, out)
    res.ok = true
    res.exit_code = REPL_OK()
    r.last_result = res
    r.last_result
}

// ============================================================================
// F64 REPL ARITHMETIC
// f64 REPL arithmetic: 3.14 * 2.0 → 6.280000
// ============================================================================
//
// When any token in an expression contains '.', the REPL switches to f64 mode.
// The f64 evaluator supports: +, -, *, /, parentheses, float literals, integer
// literals (coerced to f64). Result is printed with 6 decimal places.
// See repl_has_float_literal above (defined before repl_eval_expr).

// Parse an f64 literal from string at position pos.
// Handles digits before and after '.': e.g. 3.14, 2.0, 0.5, 42 (int coerced).
// Returns (value, new_pos). On failure new_pos == pos.
fn repl_parse_f64_lit(s: string, pos: i64) -> (f64, i64) with Mut, Panic, Div {
    let n = str_len(s)
    var p: i64 = pos
    // Skip leading whitespace
    while p < n {
        let c = str_char_at(s, p)
        if c == 32 || c == 9 { p = p + 1 } else { break }
    }
    if p >= n { return (0.0, pos) }
    let c0 = str_char_at(s, p)
    if c0 < 48 || c0 > 57 { return (0.0, pos) }
    // Parse integer part
    var int_part: f64 = 0.0
    while p < n {
        let c = str_char_at(s, p)
        if c < 48 || c > 57 { break }
        int_part = int_part * 10.0 + ((c - 48) as f64)
        p = p + 1
    }
    // Check for '.'
    if p >= n || str_char_at(s, p) != 46 {
        return (int_part, p)
    }
    p = p + 1  // consume '.'
    // Parse fractional part
    var frac: f64 = 0.0
    var scale: f64 = 0.1
    while p < n {
        let c = str_char_at(s, p)
        if c < 48 || c > 57 { break }
        frac = frac + ((c - 48) as f64) * scale
        scale = scale / 10.0
        p = p + 1
    }
    return (int_part + frac, p)
}

// Forward declaration: parse_f64_expr and parse_f64_factor are mutually needed.
// We inline factor-level paren handling.

// Parse f64 factor: '(' expr ')' | f64_literal
// Returns (value, new_pos, ok)
fn repl_parse_f64_factor(s: string, pos: i64) -> (f64, i64, bool) with Mut, Panic, Div {
    let n = str_len(s)
    var p: i64 = pos
    // Skip whitespace
    while p < n {
        let c = str_char_at(s, p)
        if c == 32 || c == 9 { p = p + 1 } else { break }
    }
    if p >= n { return (0.0, pos, false) }
    let c = str_char_at(s, p)
    // '(' = 40
    if c == 40 {
        let inner = repl_parse_f64_expr_impl(s, p + 1)
        if !inner.2 { return (0.0, pos, false) }
        // skip whitespace after inner
        var after: i64 = inner.1
        while after < n {
            let cc = str_char_at(s, after)
            if cc == 32 || cc == 9 { after = after + 1 } else { break }
        }
        if after >= n { return (0.0, pos, false) }
        if str_char_at(s, after) != 41 { return (0.0, pos, false) }  // ')'
        return (inner.0, after + 1, true)
    }
    // Try f64 literal
    let r = repl_parse_f64_lit(s, p)
    if r.1 == p { return (0.0, pos, false) }
    return (r.0, r.1, true)
}

// Parse f64 term: factor { ('*' | '/') factor }
fn repl_parse_f64_term(s: string, pos: i64) -> (f64, i64, bool) with Mut, Panic, Div {
    let n = str_len(s)
    let fres = repl_parse_f64_factor(s, pos)
    if !fres.2 { return (0.0, pos, false) }
    var val: f64 = fres.0
    var p: i64 = fres.1
    var running: bool = true
    while running {
        var p2: i64 = p
        while p2 < n {
            let cc = str_char_at(s, p2)
            if cc == 32 || cc == 9 { p2 = p2 + 1 } else { break }
        }
        if p2 >= n {
            running = false
        } else {
            let c = str_char_at(s, p2)
            if c == 42 {  // '*'
                let rhs = repl_parse_f64_factor(s, p2 + 1)
                if !rhs.2 { running = false } else { val = val * rhs.0; p = rhs.1 }
            } else if c == 47 {  // '/'
                let rhs = repl_parse_f64_factor(s, p2 + 1)
                if !rhs.2 { running = false } else { val = val / rhs.0; p = rhs.1 }
            } else { running = false }
        }
    }
    return (val, p, true)
}

// Parse f64 expr: term { ('+' | '-') term }
fn repl_parse_f64_expr_impl(s: string, pos: i64) -> (f64, i64, bool) with Mut, Panic, Div {
    let n = str_len(s)
    let tres = repl_parse_f64_term(s, pos)
    if !tres.2 { return (0.0, pos, false) }
    var val: f64 = tres.0
    var p: i64 = tres.1
    var running: bool = true
    while running {
        var p2: i64 = p
        while p2 < n {
            let cc = str_char_at(s, p2)
            if cc == 32 || cc == 9 { p2 = p2 + 1 } else { break }
        }
        if p2 >= n {
            running = false
        } else {
            let c = str_char_at(s, p2)
            if c == 43 {  // '+'
                let rhs = repl_parse_f64_term(s, p2 + 1)
                if !rhs.2 { running = false } else { val = val + rhs.0; p = rhs.1 }
            } else if c == 45 {  // '-'
                let rhs = repl_parse_f64_term(s, p2 + 1)
                if !rhs.2 { running = false } else { val = val - rhs.0; p = rhs.1 }
            } else { running = false }
        }
    }
    return (val, p, true)
}

// Format an f64 to a string with 6 decimal places.
// E.g. 6.28 → "6.280000", 0.0 → "0.000000"
fn repl_f64_to_string(x: f64) -> string with Mut, Panic, Div {
    var buf: [i8; 48] = [0; 48]
    var pos: i64 = 0

    // Handle negative
    var v: f64 = x
    if v < 0.0 {
        buf[pos as usize] = 45 as i8  // '-'
        pos = pos + 1
        v = 0.0 - v
    }

    // Integer part via integer conversion
    let int_part: i64 = v as i64
    // Fractional part
    let frac_full: f64 = (v - (int_part as f64)) * 1000000.0
    var frac_int: i64 = frac_full as i64
    // Round
    if (frac_full - (frac_int as f64)) >= 0.5 { frac_int = frac_int + 1 }
    if frac_int >= 1000000 { frac_int = 999999 }

    // Write integer digits
    var ip = int_part
    if ip == 0 {
        buf[pos as usize] = 48 as i8
        pos = pos + 1
    } else {
        var digits: [i8; 20] = [0; 20]
        var dcount: i64 = 0
        while ip > 0 && dcount < 20 {
            let d = ip % 10
            digits[dcount as usize] = (48 + d) as i8
            ip = ip / 10
            dcount = dcount + 1
        }
        var j: i64 = dcount - 1
        while j >= 0 {
            if pos < 47 { buf[pos as usize] = digits[j as usize]; pos = pos + 1 }
            j = j - 1
        }
    }

    // '.'
    if pos < 47 { buf[pos as usize] = 46 as i8; pos = pos + 1 }

    // Write 6 fractional digits (zero-padded)
    var frac_digits: [i8; 6] = [0; 6]
    var fi: i64 = 5
    var fv: i64 = frac_int
    while fi >= 0 {
        frac_digits[fi as usize] = (48 + fv % 10) as i8
        fv = fv / 10
        fi = fi - 1
    }
    var fj: i64 = 0
    while fj < 6 {
        if pos < 47 { buf[pos as usize] = frac_digits[fj as usize]; pos = pos + 1 }
        fj = fj + 1
    }

    str_from_bytes(buf, pos)
}

// Evaluate an expression in f64 mode. Called from repl_eval_expr when a '.' is detected.
fn repl_eval_f64_expr(r: &! ReplState, input: string) -> ReplResult with Mut, Panic, Div {
    var res = repl_result_new()
    let triple = repl_parse_f64_expr_impl(input, 0)
    let val: f64 = triple.0
    let end_pos: i64 = triple.1
    let ok: bool = triple.2
    if !ok {
        res.ok = false
        res.exit_code = REPL_PARSE_ERR()
        repl_result_set_error(&! res, "parse error")
        return res
    }
    // Check all input consumed
    let n = str_len(input)
    var final_pos: i64 = end_pos
    while final_pos < n {
        let c = str_char_at(input, final_pos)
        if c == 32 || c == 9 { final_pos = final_pos + 1 } else { break }
    }
    if final_pos < n {
        res.ok = false
        res.exit_code = REPL_PARSE_ERR()
        repl_result_set_error(&! res, "unexpected input")
        return res
    }
    let out = repl_f64_to_string(val)
    repl_result_set_output(&! res, out)
    res.ok = true
    res.exit_code = REPL_OK()
    r.last_result = res
    r.last_result
}

