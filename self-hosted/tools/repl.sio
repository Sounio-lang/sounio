    n > 0
}

fn test_050_format_prompt_line42() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let p = repl_format_prompt(&r, 42)
    let n = str_len(p)
    n > 0
}

fn test_051_constants_distinct() -> bool {
    REPL_OK() != REPL_QUIT() && REPL_QUIT() != REPL_PARSE_ERR() && REPL_PARSE_ERR() != REPL_EVAL_ERR()
}

fn test_052_eval_10_div_2() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "10/2")
    let out = repl_result_output(&res)
    repl_str_eq(out, "5")
}

fn test_053_eval_paren_deep() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "((4))")
    let out = repl_result_output(&res)
    repl_str_eq(out, "4")
}

fn test_054_eval_mul_chain() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "2*3*4")
    let out = repl_result_output(&res)
    repl_str_eq(out, "24")
}

fn test_055_history_get_out_of_bounds() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let s = repl_history_get(&r, 99)
    repl_str_eq(s, "")
}

fn test_056_history_add_then_clear_check() -> bool with Mut, Panic, Div {
    var r = repl_new()
    do_add_hist(&! r, "line1")
    do_add_hist(&! r, "line2")
    do_add_hist(&! r, "line3")
    repl_history_count(&r) == 3
}

fn test_057_result_output_empty_at_start() -> bool with Mut, Panic {
    let res = repl_result_new()
    res.output_len == 0
}

fn test_058_result_error_empty_at_start() -> bool with Mut {
