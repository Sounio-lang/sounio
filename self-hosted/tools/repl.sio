}

fn test_035_eval_precedence_add_then_mul() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "1+2*3")
    let out = repl_result_output(&res)
    repl_str_eq(out, "7")
}

fn test_036_eval_parentheses() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "(1+2)*3")
    let out = repl_result_output(&res)
    repl_str_eq(out, "9")
}

fn test_037_eval_nested_parens() -> bool with Mut, Panic, Div {
    var r = repl_new()
