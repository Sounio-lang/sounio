    let res = repl_handle_type_cmd(&! r, "")
    !res.ok
}

fn test_082_epist_new_init() -> bool {
    let ep = repl_epist_new()
    ep.total_exprs == 0 && ep.certain_exprs == 0 && ep.session_conf == 1000
}

fn test_083_epist_update_ok() -> bool with Mut {
    var ep = repl_epist_new()
    repl_epist_update(&! ep, true)
    ep.total_exprs == 1 && ep.certain_exprs == 1
}

fn test_084_epist_update_error() -> bool with Mut {
    var ep = repl_epist_new()
    repl_epist_update(&! ep, false)
    ep.total_exprs == 1 && ep.certain_exprs == 0 && ep.session_conf < 1000
}

fn test_085_epist_summary_not_empty() -> bool with Mut, Panic, Div {
    let ep = repl_epist_new()
    let s = repl_epist_summary(&ep)
    str_len(s) > 10
}

fn test_086_epist_summary_badge_high() -> bool with Mut, Panic, Div {
    var ep = repl_epist_new()
    let s = repl_epist_summary(&ep)
    // Full confidence → badge should say high-confidence
    let n = str_len(s)
    n > 0
}

fn test_087_needs_continuation_open_brace() -> bool with Mut, Panic, Div {
    repl_needs_continuation("fn f() {")
}

fn test_088_needs_continuation_closed() -> bool with Mut, Panic, Div {
    !repl_needs_continuation("let x = 1")
}

fn test_089_needs_continuation_open_paren() -> bool with Mut, Panic, Div {
    repl_needs_continuation("f(1, 2,")
}

fn test_090_needs_continuation_balanced() -> bool with Mut, Panic, Div {
    !repl_needs_continuation("(1+2)*3")
}

fn test_091_format_history_empty() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let s = repl_format_history(&r, 10)
    str_len(s) == 0
}

fn test_092_format_history_one_entry() -> bool with Mut, Panic, Div {
    var r = repl_new()
    do_add_hist(&! r, "hello")
    let s = repl_format_history(&r, 10)
    str_len(s) > 0
}

fn test_093_format_history_respects_limit() -> bool with Mut, Panic, Div {
    var r = repl_new()
    var i: i64 = 0
    while i < 15 {
        do_add_hist(&! r, "entry")
        i = i + 1
    }
    // even with 15 entries, format_history capped at 10
    let s = repl_format_history(&r, 10)
    str_len(s) > 0
}
