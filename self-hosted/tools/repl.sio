fn test_061_is_quit_false_for_q() -> bool with Mut, Panic, Div {
    !repl_is_quit_cmd("q")
}

fn test_062_is_help_false_for_other() -> bool with Mut, Panic, Div {
    !repl_is_help_cmd("quit")
}

fn test_063_repl_max_history_const() -> bool {
    REPL_MAX_HISTORY() == 256
}

fn test_064_repl_char_storage_const() -> bool {
    REPL_CHAR_STORAGE() == 16384
}

fn test_065_add_256_distinct_entries() -> bool with Mut, Panic, Div {
    var r = repl_new()
    var i: i64 = 0
    while i < 50 {
        do_add_hist(&! r, "entry")
        i = i + 1
    }
    repl_history_count(&r) == 50
}

fn test_066_eval_no_error_exit_code() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "7")
    res.exit_code == REPL_OK()
}

fn test_067_eval_error_exit_code() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "abc")
    res.exit_code == REPL_PARSE_ERR()
}

