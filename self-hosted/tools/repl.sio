    var r = repl_new()
    let res = do_eval(&! r, "10-3-2")
    let out = repl_result_output(&res)
    repl_str_eq(out, "5")
}

fn test_060_eval_complex_precedence() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "2+3*4-1")
    let out = repl_result_output(&res)
    repl_str_eq(out, "13")
