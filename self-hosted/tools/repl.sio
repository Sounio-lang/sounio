    let res = repl_handle_type_cmd(&! r, "3*4")
    res.ok
}

fn test_080_handle_type_cmd_output_contains_i64() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = repl_handle_type_cmd(&! r, "3*4")
    let out = repl_result_output(&res)
