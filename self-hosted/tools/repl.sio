fn test_043_eval_parse_error_on_letters() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "abc")
    !res.ok
}

fn test_044_eval_large_number() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "100+200")
    let out = repl_result_output(&res)
    repl_str_eq(out, "300")
}

fn test_045_eval_chain_ops() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let res = do_eval(&! r, "1+2+3+4")
    let out = repl_result_output(&res)
    repl_str_eq(out, "10")
}

fn test_046_i64_to_string_zero() -> bool with Mut, Panic, Div {
    let s = repl_i64_to_string(0)
    repl_str_eq(s, "0")
}

fn test_047_i64_to_string_positive() -> bool with Mut, Panic, Div {
    let s = repl_i64_to_string(42)
    repl_str_eq(s, "42")
}

fn test_048_set_prompt() -> bool with Mut, Panic, Div {
    var r = repl_new()
    repl_set_prompt(&! r, ">>> ")
    r.prompt_len == 4
}

fn test_049_format_prompt_line1() -> bool with Mut, Panic, Div {
    var r = repl_new()
    let p = repl_format_prompt(&r, 1)
    // should contain "sounio["
