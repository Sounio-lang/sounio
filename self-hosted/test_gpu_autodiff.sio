    if autodiff_test_05_grad_op_neg() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 NEG\n") }
    total = total + 1
    if autodiff_test_06_grad_op_sqrt() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 SQRT\n") }
    total = total + 1
    if autodiff_test_07_grad_op_exp() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 EXP\n") }
    total = total + 1
    if autodiff_test_08_grad_op_log() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 LOG\n") }
    total = total + 1
    if autodiff_test_09_grad_op_sin() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 SIN\n") }
    total = total + 1
    if autodiff_test_10_grad_op_cos() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 COS\n") }
    total = total + 1
    if autodiff_test_11_grad_op_relu() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 RELU\n") }
    total = total + 1
    if autodiff_test_12_grad_op_const() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 CONST\n") }
    total = total + 1
    if autodiff_test_13_grad_op_input() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 INPUT\n") }
