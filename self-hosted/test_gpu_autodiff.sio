    if autodiff_test_46_add_grad_both() { passed = passed + 1; print("  T46 OK (a+b oracle)\n") } else { print("  FAIL T46 a+b oracle\n") }
    total = total + 1
    if autodiff_test_47_neg_grad() { passed = passed + 1; print("  T47 OK (neg oracle)\n") } else { print("  FAIL T47 neg oracle\n") }

    if passed == total {
        print("GPU Autodiff: all 47 passed\n")
    } else {
        print("GPU Autodiff: FAILED\n")
    }
    if passed == total { 0 } else { 1 }
}
