    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU Autodiff Tests ===\n")

    total = total + 1
    if autodiff_test_01_grad_op_add() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 ADD\n") }
