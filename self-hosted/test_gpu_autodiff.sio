    total = total + 1
    if autodiff_test_17_tape_new_empty() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 new\n") }
    total = total + 1
    if autodiff_test_18_tape_record() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 record\n") }
    total = total + 1
    if autodiff_test_19_tape_record_multiple() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 multi\n") }
