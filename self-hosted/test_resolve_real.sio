// self-hosted::test_resolve_real — Resolve real .sio source files from disk
//
// Tests N01-N04: Read actual source files, lex + parse + resolve them.
//
// Note: the self-hosted parser has limitations (no generic types, no
// qualified paths in expressions), so parsed ASTs may be incomplete.
// Resolution errors are expected from incomplete parses. Tests verify
// the full pipeline completes without crashing and report error counts.
//
// Entry point: run_resolve_real_tests()

// ============================================================================
// TESTS
// ============================================================================

// N01: self-hosted/lexer/span.sio — Full pipeline: lex + parse + resolve.
// Errors expected from self-hosted parser limitations (impl blocks).
fn test_N01_resolve_span() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/lexer/span.sio")
    let size = file_size("self-hosted/lexer/span.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program(state.tokens, state.token_count)
    let result = resolve_program(prog)
    print("    N01 resolve errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// N02: self-hosted/check/env.sio — Type environment bindings.
fn test_N02_resolve_env() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/check/env.sio")
    let size = file_size("self-hosted/check/env.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program(state.tokens, state.token_count)
    let result = resolve_program(prog)
    print("    N02 resolve errors: ")
