// N03: self-hosted/resolve/symbol.sio — Self-referential: resolver resolving its own symbols.
fn test_N03_resolve_symbol() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/resolve/symbol.sio")
    let size = file_size("self-hosted/resolve/symbol.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program(state.tokens, state.token_count)
    let result = resolve_program(prog)
    print("    N03 resolve errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// N04: self-hosted/resolve/scope.sio — Scope stack with push/pop.
fn test_N04_resolve_scope() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/resolve/scope.sio")
    let size = file_size("self-hosted/resolve/scope.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    let prog = parse_program(state.tokens, state.token_count)
    let result = resolve_program(prog)
    print("    N04 resolve errors: ")
    print_int(result.error_count)
    print("\n")
    true
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn run_resolve_real_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 4

    print("=== Resolve Real Files Tests ===\n")

    if test_N01_resolve_span() { passed = passed + 1; print("  N01 OK: span.sio\n") } else { print("  FAIL: N01 span.sio\n") }
    if test_N02_resolve_env() { passed = passed + 1; print("  N02 OK: env.sio\n") } else { print("  FAIL: N02 env.sio\n") }
    if test_N03_resolve_symbol() { passed = passed + 1; print("  N03 OK: symbol.sio\n") } else { print("  FAIL: N03 symbol.sio\n") }
    if test_N04_resolve_scope() { passed = passed + 1; print("  N04 OK: scope.sio\n") } else { print("  FAIL: N04 scope.sio\n") }

    print("\nResolve real tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
