module main

use pbpk::rapamycin_ind_dose_adjust::{
    ida_margin_n7_d34, ida_margin_n7_d36, ida_margin_n7_d38,
    ida_margin_n7_d40, ida_margin_n7_d42, ida_margin_n7_d44,
    ida_margin_n7_d46, ida_margin_n7_d48, ida_margin_n7_d50,
    ida_margin_n7_d52, ida_margin_n7_d54, ida_margin_n7_d56,
    ida_margin_n28_d34, ida_margin_n28_d42,
    ida_margin_n28_d50, ida_margin_n28_d56, ida_margin_n28_d60,
    ida_d_cert_n28_max,
    ida_margin_n7_at_n28_max, ida_cert_gap_n7,
    ida_ceiling_gap_steps,
    ida_margin_n7_step1, ida_margin_n7_step_last
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Inducer stratum N=7 margin scan (2mg steps) ===\n")
    print("D=34: "); print_f64(ida_margin_n7_d34()); print("\n")
    print("D=36: "); print_f64(ida_margin_n7_d36()); print("\n")
    print("D=38: "); print_f64(ida_margin_n7_d38()); print("\n")
    print("D=40: "); print_f64(ida_margin_n7_d40()); print("\n")
    print("D=42: "); print_f64(ida_margin_n7_d42()); print("\n")
    print("D=44: "); print_f64(ida_margin_n7_d44()); print("\n")
    print("D=46: "); print_f64(ida_margin_n7_d46()); print("\n")
    print("D=48: "); print_f64(ida_margin_n7_d48()); print("\n")
    print("D=50: "); print_f64(ida_margin_n7_d50()); print("\n")
    print("D=52: "); print_f64(ida_margin_n7_d52()); print("\n")
    print("D=54: "); print_f64(ida_margin_n7_d54()); print("\n")
    print("D=56: "); print_f64(ida_margin_n7_d56()); print("\n")

    print("\n=== Inducer stratum N=28 margin ===\n")
    print("D=34: "); print_f64(ida_margin_n28_d34()); print("\n")
    print("D=42: "); print_f64(ida_margin_n28_d42()); print("\n")
    print("D=50: "); print_f64(ida_margin_n28_d50()); print("\n")
    print("D=56: "); print_f64(ida_margin_n28_d56()); print("\n")
    print("D=60: "); print_f64(ida_margin_n28_d60()); print("\n")

    print("\n=== Structural infeasibility metrics ===\n")
    print("d_cert_n28_max:        "); print_f64(ida_d_cert_n28_max());        print("\n")
    print("margin_n7_at_n28_max:  "); print_f64(ida_margin_n7_at_n28_max());  print("\n")
    print("cert_gap_n7:           "); print_f64(ida_cert_gap_n7());           print("\n")
    print("ceiling_gap_steps:     "); pi(ida_ceiling_gap_steps());            print("\n")
    print("margin_n7_step1:       "); print_f64(ida_margin_n7_step1());       print("\n")
    print("margin_n7_step_last:   "); print_f64(ida_margin_n7_step_last());   print("\n")
}
