// Sprint 43 probe: GUM coverage factor (k) sensitivity
// k=1.645 (90%), k=2.0 (95.45%), k=2.576 (99%), k=3.0 (99.73%)
// N_crit table for all 5 strata × 4 k values

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn find_ncrit_k(d: f64, ke: f64, f: f64,
                ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64,
                k_thresh: f64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l(); let ceil = trough_ceil_mg_l()
    var n = 1; var found = 0
    while n <= 60 && found == 0 {
        let c  = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
        if (c - floor) / uc >= k_thresh && (ceil - c) / uc >= k_thresh { found = n }
        else { n = n + 1 }
    }
    found
}

// Also compute Z_floor and Z_ceil at the N_crit(k=2.0) for each stratum
// to understand sensitivity of the binding constraint
fn zf_at(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}
fn zc_at(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
    (trough_ceil_mg_l() - c) / uc
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    print("N_crit table (k=1.645 / k=2.000 / k=2.576 / k=3.000):\n")

    print("std  D=5mg:  ")
    pi(find_ncrit_k(5.0,0.01118,0.141,ka,fv,ke,k12,k21,1.645)); print(" / ")
    pi(find_ncrit_k(5.0,0.01118,0.141,ka,fv,ke,k12,k21,2.0));   print(" / ")
    pi(find_ncrit_k(5.0,0.01118,0.141,ka,fv,ke,k12,k21,2.576)); print(" / ")
    pi(find_ncrit_k(5.0,0.01118,0.141,ka,fv,ke,k12,k21,3.0));   print("\n")

    print("slow D=5mg:  ")
    pi(find_ncrit_k(5.0,0.00838,0.188,ka,fv,ke,k12,k21,1.645)); print(" / ")
    pi(find_ncrit_k(5.0,0.00838,0.188,ka,fv,ke,k12,k21,2.0));   print(" / ")
    pi(find_ncrit_k(5.0,0.00838,0.188,ka,fv,ke,k12,k21,2.576)); print(" / ")
    pi(find_ncrit_k(5.0,0.00838,0.188,ka,fv,ke,k12,k21,3.0));   print("\n")

    print("fast D=5mg:  ")
    pi(find_ncrit_k(5.0,0.01677,0.094,ka,fv,ke,k12,k21,1.645)); print(" / ")
    pi(find_ncrit_k(5.0,0.01677,0.094,ka,fv,ke,k12,k21,2.0));   print(" / ")
    pi(find_ncrit_k(5.0,0.01677,0.094,ka,fv,ke,k12,k21,2.576)); print(" / ")
    pi(find_ncrit_k(5.0,0.01677,0.094,ka,fv,ke,k12,k21,3.0));   print("\n")

    print("inh  D=1.5mg:")
    pi(find_ncrit_k(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,1.645)); print(" / ")
    pi(find_ncrit_k(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,2.0));   print(" / ")
    pi(find_ncrit_k(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,2.576)); print(" / ")
    pi(find_ncrit_k(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,3.0));   print("\n")

    print("ind  D=34mg: ")
    pi(find_ncrit_k(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,1.645)); print(" / ")
    pi(find_ncrit_k(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,2.0));   print(" / ")
    pi(find_ncrit_k(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,2.576)); print(" / ")
    pi(find_ncrit_k(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,3.0));   print("\n")

    // Z values at each stratum's k=2.0 N_crit, and also one dose earlier/later
    print("\nZ values at k=2.0 N_crit and neighbors:\n")

    print("std  N=5:  zf="); print_f64(zf_at(5.0,5,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,5,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std  N=6:  zf="); print_f64(zf_at(5.0,6,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,6,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std  N=7:  zf="); print_f64(zf_at(5.0,7,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,7,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")

    print("fast N=13: zf="); print_f64(zf_at(5.0,13,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,13,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=14: zf="); print_f64(zf_at(5.0,14,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,14,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=15: zf="); print_f64(zf_at(5.0,15,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,15,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=20: zf="); print_f64(zf_at(5.0,20,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,20,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast N=22: zf="); print_f64(zf_at(5.0,22,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,22,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")

    print("ind  N=25: zf="); print_f64(zf_at(34.0,25,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc_at(34.0,25,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind  N=26: zf="); print_f64(zf_at(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc_at(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind  N=30: zf="); print_f64(zf_at(34.0,30,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc_at(34.0,30,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind  N=35: zf="); print_f64(zf_at(34.0,35,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc_at(34.0,35,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")

    print("inh  N=6:  zf="); print_f64(zf_at(1.5,6,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc_at(1.5,6,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh  N=7:  zf="); print_f64(zf_at(1.5,7,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc_at(1.5,7,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")

    print("slow N=2:  zf="); print_f64(zf_at(5.0,2,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,2,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=3:  zf="); print_f64(zf_at(5.0,3,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc_at(5.0,3,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
}
