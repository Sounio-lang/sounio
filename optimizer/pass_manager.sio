    fn name() -> String {
        "inlining".to_string()
    }
    
    fn should_run(&self, level: OptimizationLevel) -> bool {
        match level {
            OptimizationLevel::O0 | OptimizationLevel::O1 => false,
            _ => true,
        }
    }
    
    fn optimize(&self, func: Function) -> Function {
        println("  Running: ")
        print(self.name())
        println("...")
        
        // Simulate inlining
        let mut optimized = func.clone();
        optimized.instructions.push("  [inlined small functions]")
        
        optimized
    }
}

