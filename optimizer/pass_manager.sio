        // Simulate LICM
        let mut optimized = func.clone();
        optimized.instructions.push("  [moved loop invariants]")
        
        optimized
    }
}

/// Pass manager
struct PassManager {
    passes: Vec<Box<dyn OptimizerPass>>,
    level: OptimizationLevel,
}

impl PassManager {
    fn new(level: OptimizationLevel) -> PassManager {
        let mut passes: Vec<Box<dyn OptimizerPass>> = Vec::new()
        
        // Add passes in order
        passes.push(Box::new(ConstantFoldingPass))
        passes.push(Box::new(DeadCodeEliminationPass))
        passes.push(Box::new(StrengthReductionPass))
        
        if level != OptimizationLevel::O0 {
            passes.push(Box::new(InliningPass))
            passes.push(Box::new(LoopUnrollingPass))
            passes.push(Box::new(CommonSubexpressionEliminationPass))
            passes.push(Box::new(LoopInvariantCodeMotionPass))
        }
        
        PassManager {
            passes,
            level,
        }
    }
    
    /// Run all enabled passes on a function
    fn optimize_function(&self, func: Function) -> Function {
        println("Optimizing function: ")
        print(func.name)
        println()
        
        let mut optimized = func;
        let mut total_modified = = 0;
        
        for pass in &self.passes {
            if pass.should_run(self.level) {
                let before = optimized.clone();
                optimized = pass.optimize(optimized);
                
                if before.instructions.len() != optimized.instructions.len() {
                    total_modified += 1;
                }
            }
        }
        
        println()
        print("Total passes applied: ")
        print(total_modified)
        println()
        println()
        
        optimized
    }
    
    /// Get list of enabled passes
    fn get_enabled_passes(&self) -> Vec<String> {
        self.passes.iter()
            .filter(|p| p.should_run(self.level))
            .map(|p| p.name())
            .collect()
    }
    
    /// Get optimization level name
    fn get_level_name(&self) -> String {
        match self.level {
            OptimizationLevel::O0 => "O0 (no optimization)",
            OptimizationLevel::O1 => "O1 (basic optimization)",
            OptimizationLevel::O2 => "O2 (moderate optimization)",
            OptimizationLevel::O3 => "O3 (aggressive optimization)",
        }
    }
}

/// Module (collection of functions)
struct Module {
    name: String,
    functions: Vec<Function>,
}

impl Module {
    fn new(name: String) -> Module {
        Module {
            name,
            functions: Vec::new(),
        }
    }
    
    fn add_function(&mut self, func: Function) {
        self.functions.push(func)
    }
}

/// Optimize an entire module
fn optimize_module(module: Module, level: OptimizationLevel) -> Module {
    println("========================================")
    println("SOUNIO OPTIMIZATION FRAMEWORK")
    println("========================================")
    println()
    println("Module: ")
    print(module.name)
    println()
    println("Optimization Level: ")
    print(level)
    println()
    
    let manager = PassManager::new(level);
    
    println("Enabled passes:")
    println("----------------")
    for (i, pass_name) in manager.get_enabled_passes().iter().enumerate() {
        print("  ")
        print(i + 1)
        print(". ")
        println(pass_name)
    }
    println()
    
    let mut optimized = module.clone();
    
    for func in optimized.functions.iter_mut() {
        *func = manager.optimize_function(func.clone())
    }
    
    println("========================================")
    println("OPTIMIZATION COMPLETE")
    println("========================================")
    println()
    
    optimized
}

/// Test function
fn test_optimization() -> i32 {
    println("Testing Optimization Framework")
    println("=============================")
    println()
    
    // Create test module
    let mut module = Module::new("test_module");
    
    // Add test function
    module.add_function(Function {
        name: "test_function".to_string(),
        instructions: vec![
            "let x = 10".to_string(),
            "let y = 20".to_string(),
            "let z = x + y".to_string(),
            "let w = z * 2".to_string(),
        ],
        blocks: vec![],
    });
    
    // Optimize at different levels
    println("Optimizing at O1:")
    println("------------------")
    let optimized_o1 = optimize_module(module.clone(), OptimizationLevel::O1)
    println()
    
    println("Optimizing at O2:")
    println("------------------")
    let optimized_o2 = optimize_module(module.clone(), OptimizationLevel::O2)
    println()
    
    println("Optimizing at O3:")
    println("------------------")
    let optimized_o3 = optimize_module(module.clone(), OptimizationLevel::O3)
    println()
    
    0
}

/// Main entry point
fn main() -> i32 {
    println()
    println("╔════════════════════════════════════════════════════════╗")
    println("║                                                        ║")
    println("║           SOUNIO OPTIMIZER - WRITTEN IN SOUNIO           ║")
    println("║                                                        ║")
    println("║   First compiler where optimizer is written in the     ║")
    println("║   language being optimized - self-hosting in action!  ║")
    println("║                                                        ║")
    println("╚════════════════════════════════════════════════════════╝")
    println()
    
    test_optimization()
    
    println()
    println("✨ Sounio optimizer written in Sounio! ✨")
    println()
    println("This demonstrates:")
    println("  • Self-hosting: Sounio optimizes Sounio code")
    println("  • Elegance: Optimizations are first-class features")
    println("  • Testability: Each pass is a regular program")
    println("  • Meta: Optimizing an optimizer with the optimizer")
    println()
    
    0
}
