/// Loop invariant code motion pass
struct LoopInvariantCodeMotionPass;

impl OptimizerPass for LoopInvariantCodeMotionPass {
    fn name() -> String {
        "loop-invariant-code-motion".to_string()
    }
    
    fn should_run(&self, level: OptimizationLevel) -> bool {
        match level {
            OptimizationLevel::O0 | OptimizationLevel::O1 => false,
            _ => true,
        }
    }
    
