//! Optimizer Benchmark Test
//!
//! Measures performance improvements from optimization concepts

/// Compute intensive function (before optimization)
fn compute_intensive_before() -> i64 {
    var result: i64 = 0

    // Lots of constant arithmetic that can be folded
    for i in 0..1000 {
        result = result + (10 + 20 * 2) + (5 * 3) + (100 / 4)
    }

    result
}

/// Compute intensive function (after optimization)
/// This simulates what the optimizer would produce
fn compute_intensive_after() -> i64 {
    var result: i64 = 0

    // Constants pre-computed by optimizer
    // 10 + 20 * 2 = 50
    // 5 * 3 = 15
    // 100 / 4 = 25
    // Total per iteration: 50 + 15 + 25 = 90

    for i in 0..1000 {
        result = result + 90
    }

    result
}

/// Test function inlining performance
fn small_function(a: i32, b: i32, c: i32) -> i32 {
    (a + b) * c
}

/// Before inlining - many function calls
fn test_inlining_before() -> i64 {
    var result: i64 = 0

    for i in 0..10000 {
        // Each call has overhead
        let temp = small_function(i as i32, (i + 1) as i32, 2)
        result = result + temp as i64
    }

    result
}

/// After inlining - function body duplicated
fn test_inlining_after() -> i64 {
    var result: i64 = 0

    for i in 0..10000 {
        // Inlined: (i + (i + 1)) * 2 = (2*i + 1) * 2 = 4*i + 2
        let temp = ((i as i32) + ((i + 1) as i32)) * 2
        result = result + temp as i64
    }

    result
}

/// Test strength reduction performance
fn test_strength_before() -> i64 {
    var result: i64 = 0

    for i in 0..100000 {
        // Expensive operations
        let doubled = i * 2
        let quadrupled = i * 4
        let shifted = i / 8
        result = result + doubled + quadrupled + shifted
    }

    result
}

/// After strength reduction
fn test_strength_after() -> i64 {
    var result: i64 = 0

    for i in 0..100000 {
        // Optimized operations
        let doubled = i << 1        // i * 2
        let quadrupled = i << 2     // i * 4
        let shifted = i >> 3        // i / 8
        result = result + doubled + quadrupled + shifted
    }

    result
}

/// Simple timing function (approximate)
fn get_time() -> i64 {
    // This is a placeholder - real timing would use system time
    // For demo purposes, we'll use iteration count as proxy
    0
}

/// Run benchmark for a function
fn benchmark_function(name: String, test_func: fn() -> i64, iterations: i32) -> i64 {
    print("Benchmarking ")
    print(name)
    print(" (")
    print(iterations)
    print(" iterations)... ")
    println()

    var total_time: i64 = 0

    for iter in 0..iterations {
        let start = get_time()
        let result = test_func()
        let end = get_time()

        // Use result to prevent optimization
        if result < 0 {
            print("Error in result")
            println()
        }

        total_time = total_time + (end - start)
    }

    let avg_time = total_time / iterations as i64
    print("  Average time: ")
    print(avg_time)
    print(" units")
    println()

    avg_time
}

/// Main benchmark runner
fn main() -> i32 {
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                                                              ║")
    println()
    print("║           SOUNIO OPTIMIZER - PERFORMANCE BENCHMARKS          ║")
    println()
    print("║                                                              ║")
    println()
    print("║   Measuring performance improvements from optimizations      ║")
    println()
    print("║                                                              ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    let benchmark_iterations = 10

    // Benchmark 1: Constant Folding
    println()
    print("BENCHMARK 1: Constant Folding")
    println()
    print("=============================")
    println()

    let before_cf = benchmark_function("Before Constant Folding".to_string(), compute_intensive_before, benchmark_iterations)
    let after_cf = benchmark_function("After Constant Folding".to_string(), compute_intensive_after, benchmark_iterations)

    let speedup_cf = if after_cf > 0 { (before_cf as f64) / (after_cf as f64) } else { 1.0 }
    print("  Speedup: ")
    print(speedup_cf)
    print("x")
    println()

    // Benchmark 2: Function Inlining
    println()
    print("BENCHMARK 2: Function Inlining")
    println()
    print("==============================")
    println()

    let before_inline = benchmark_function("Before Inlining".to_string(), test_inlining_before, benchmark_iterations)
    let after_inline = benchmark_function("After Inlining".to_string(), test_inlining_after, benchmark_iterations)

    let speedup_inline = if after_inline > 0 { (before_inline as f64) / (after_inline as f64) } else { 1.0 }
    print("  Speedup: ")
    print(speedup_inline)
    print("x")
    println()

    // Benchmark 3: Strength Reduction
    println()
    print("BENCHMARK 3: Strength Reduction")
    println()
    print("===============================")
    println()

    let before_strength = benchmark_function("Before Strength Reduction".to_string(), test_strength_before, benchmark_iterations)
    let after_strength = benchmark_function("After Strength Reduction".to_string(), test_strength_after, benchmark_iterations)

    let speedup_strength = if after_strength > 0 { (before_strength as f64) / (after_strength as f64) } else { 1.0 }
    print("  Speedup: ")
    print(speedup_strength)
    print("x")
    println()

    // Overall Results
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                        OVERALL RESULTS                      ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    let avg_speedup = (speedup_cf + speedup_inline + speedup_strength) / 3.0

    print("Constant Folding Speedup: ")
    print(speedup_cf)
    print("x")
    println()

    print("Function Inlining Speedup: ")
    print(speedup_inline)
    print("x")
    println()

    print("Strength Reduction Speedup: ")
    print(speedup_strength)
    print("x")
    println()

    print("Average Speedup: ")
    print(avg_speedup)
    print("x")
    println()
    println()

    print("🎯 OPTIMIZATION IMPACT SUMMARY")
    println()
    println()

    if avg_speedup >= 1.5 {
        print("✅ SIGNIFICANT PERFORMANCE IMPROVEMENT")
        println()
        print("   Optimizer provides measurable speedup!")
        println()
    } else if avg_speedup >= 1.2 {
        print("⚠️  MODERATE PERFORMANCE IMPROVEMENT")
        println()
        print("   Optimizer provides some benefit")
        println()
    } else {
        print("❌ MINIMAL PERFORMANCE IMPROVEMENT")
        println()
        print("   Need to investigate benchmark methodology")
        println()
    }

    print("📊 CONCLUSION: Sounio optimizer concepts are ")
    if avg_speedup >= 1.2 {
        print("WORKING")
    } else {
        print("NEEDING TUNING")
    }
    println()
    println()

    0
}
