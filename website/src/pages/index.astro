    compilerBody2: "行",
    compilerBody3: "再現可能な固定点セレモニーは",
    compilerBody4: "記録された SHA-256:",
    compilerBody5: "コンパイラが完全に自らを再生成する固定点条件は、セマンティクス（意味論）の一貫性を示す最も強力な証拠です。",
    compilerLink: "ブートストラップチェーンを見る →",
    theoremTitle: "言語内で証明された新しい定理。",
    theoremBody: "オクトニオン（八元数）の 7³ = 343 個の順序付き基底三つ組 (eᵢ, eⱼ, eₖ) のうち、正確に 168 個が [eᵢ, eⱼ, eₖ] = (eᵢ·eⱼ)·eₖ − eᵢ·(eⱼ·eₖ) ≠ 0 を満たします。この 168 という値は、ファノ平面 PG(2,2) の自己同型群の位数である |PSL(2,7)| に等しいです。この結果は、Sounio で algebra Octonion … reassociate: fano_selective 宣言を使用して初めて計算的に検証され、NumPy で独立して再現され、現在は Advances in Applied Clifford Algebras で査読中です。",
    theoremLink: "定理のページを読む →",
    safetyTitle: "コードが実行される前の患者安全性の保証。",
    safetyBody: "Sounio の Knowledge<T> 型は、すべての算術演算を通じて ISO GUM 規則によって伝播される認識的信頼度 ε ∈ [0, 1] を保持します。AUC 指導のバンコマイシン投与量に対して where c.ε ≥ 0.82 と宣言された関数は、提供された測定値の ε が 0.71 である場合、コンパイルされません。これは実行時警告でも Linter の警告でもなく、型チェッカーによる拒否です。同じメカニズムが、薬物動態学、臨床試験分析、または安全性が重要なセンサーフュージョンの認識的閾値に適用されます。",
    safetyLink: "バンコマイシンの例を読む →",
    startBuilding: "今すぐ開発を始める",
    cloneRepo: "リポジトリをクローンし、検証済みのセルフホストランチャーを使用します：",
    installGuide: "インストールガイド",
    seeProof: "証明を見る",
    langTour: "言語ツアー",
    scCtaHeading: "See clinical safety in action",
    scCtaBody: "Explore the vancomycin dosing gate, the interactive PBPK dissertation demo, and the science hub — no compiler setup required.",
    scCtaVancomycin: "Vancomycin example",
    scCtaDissertation: "Dissertation demo",
    scCtaScience: "Hub de ciência"
  }
};

const d = t[locale] || t.en;
---

<BaseLayout title={trans.page_home_title} description={trans.page_home_desc} removeTopPadding={true}>

  {/* ═══════════════════════════════════════════════════════════════
      1 — CINEMATIC WEBGL MASCOT HERO
  ═══════════════════════════════════════════════════════════════ */}
  <MascotHeroWebGL client:only="solid-js" />

  {/* ═══════════════════════════════════════════════════════════════
      2 — WHAT IS SOUNIO (30-second explanation)
  ═══════════════════════════════════════════════════════════════ */}
  <WhatIsSounio locale={locale} t={trans} />

  {/* ═══════════════════════════════════════════════════════════════
      3 — METRIC RIBBON (Synced scale & status)
  ═══════════════════════════════════════════════════════════════ */}
  <NumbersSection />

  {/* ═══════════════════════════════════════════════════════════════
      3 — THREE HARD FACTS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text={d.threeHardFacts} client:visible />
        <p class="section-subhead">{d.notClaims}</p>
      </div>

      <!-- Scientist Cards -->
      <div class="grid gap-[1rem] md:grid-cols-3" data-for-audience="scientist">

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.scUncertaintyTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.scUncertaintyBody}
          </p>
          <a href={getLocalizedPath('/learn/epistemic', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.scUncertaintyLink}
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.scSafetyTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.scSafetyBody}
          </p>
          <a href={getLocalizedPath('/proof#compile-fail-vancomycin', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.scSafetyLink}
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.scProvTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.scProvBody}
          </p>
          <a href={getLocalizedPath('/science', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.scProvLink}
          </a>
        </article>

      </div>

      <!-- Technical Cards -->
      <div class="grid gap-[1rem] md:grid-cols-3" data-for-audience="technical">

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.compilerTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.compilerBody1}{" "}
            <code class="text-[var(--color-accent-gold-soft)]">{bootstrap.stage0Path}</code>
            {" "}({bootstrap.stage0Lines?.toLocaleString() ?? "2,792"}{" "}{d.compilerBody2}).{" "}{d.compilerBody3}{" "}
            <code class="text-[var(--color-accent-gold-soft)]">{bootstrap.fixedPointChain}</code>.
            {bootstrap.recordedSha256 && (
              <>{" "}{d.compilerBody4}{" "} <code class="text-[var(--color-accent-gold-soft)]">{bootstrap.recordedSha256.slice(0, 12)}…</code>
              {bootstrap.recordedSizeKb ? ` (${bootstrap.recordedSizeKb} KB).` : "."}</>
            )}
            {" "}{d.compilerBody5}
          </p>
          <a href={getLocalizedPath('/learn/compiler', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.compilerLink}
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.theoremTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.theoremBody}
          </p>
          <a href={getLocalizedPath('/proof#theorem-168', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.theoremLink}
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            {d.safetyTitle}
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            {d.safetyBody}
          </p>
          <a href={getLocalizedPath('/proof#compile-fail-vancomycin', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            {d.safetyLink}
          </a>
        </article>

      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      4 — CODE EXAMPLES (Tabbed comparative showcase)
  ═══════════════════════════════════════════════════════════════ */}
  <CodeExamples client:only="react" locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      5 — COMPACT HONEST STATUS (Transparency ledger)
  ═══════════════════════════════════════════════════════════════ */}
  <HonestStatusSection variant="clinical" />
  <HonestStatusSection variant="technical" />

  {/* ═══════════════════════════════════════════════════════════════
      6 — CTA
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell relative overflow-hidden" data-for-audience="scientist">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_18%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.4rem] max-w-[640px]">
      <KineticText text={d.scCtaHeading} client:visible />
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.7]">
        {d.scCtaBody}
      </p>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          {d.scCtaVancomycin}
        </a>
        <a
          href={getLocalizedPath('/dissertation', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.scCtaDissertation}
        </a>
        <a
          href={getLocalizedPath('/science', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.scCtaScience}
        </a>
      </div>
    </div>
  </section>

  <section class="section-shell relative overflow-hidden" data-for-audience="technical">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_18%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.4rem] max-w-[640px]">
      <KineticText text={d.startBuilding} client:visible />
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.7]">
        {d.cloneRepo}{" "}
        <code class="font-mono text-[0.9em]">{defaultWorkflow.launcher}</code>.
        {defaultWorkflow.summary}
      </p>
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-xs sm:text-sm font-mono p-[1rem] overflow-x-auto leading-relaxed max-w-full no-scrollbar"><code>$ git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          {d.installGuide}
        </a>
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.seeProof}
        </a>
        <a
          href={getLocalizedPath('/language', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.langTour}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
