---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import EpistemicScroll from '../components/home/EpistemicScroll.astro';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import CodeExamples from '../components/home/CodeExamples';
import DomainGallery from '../components/home/DomainGallery.astro';
import NumbersSection from '../components/home/NumbersSection.astro';
import { getLocaleFromUrl, loadTranslations } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
---

<BaseLayout title="">
  <Hero locale={locale} />
  <EpistemicScroll locale={locale} />
  <FeatureGrid locale={locale} />
  <CodeExamples client:visible />
  <DomainGallery locale={locale} />
  <NumbersSection />

  <!-- Get Started CTA -->
  <section class="py-32 bg-[var(--color-surface-primary)]">
    <div class="container px-4 max-w-3xl text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-[var(--color-text-primary)] mb-12">
        {t.cta_title ?? "Ready to compute with confidence?"}
      </h2>

      <!-- Glass terminal -->
      <div class="glass glass-specular rounded-2xl p-1 mb-8 max-w-xl mx-auto">
        <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--glass-border)]">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></div>
          </div>
        </div>
        <div class="flex items-center gap-3 px-5 py-4">
          <span class="text-[var(--color-accent-green)] font-mono text-sm">$</span>
          <code class="text-[var(--color-text-primary)] font-mono text-sm flex-1 text-left truncate" id="install-cmd">
            curl -sSf https://souniolang.org/install.sh | sh
          </code>
          <button
            type="button"
            class="text-[var(--color-text-tertiary)] hover:text-[var(--color-text-primary)] transition-colors"
            id="copy-install-cta"
            aria-label="Copy install command"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 justify-center mb-8">
        <a
          href="/docs/getting-started"
          class="px-8 py-4 bg-[var(--color-text-primary)] text-[var(--color-surface-primary)] rounded-full font-semibold hover:opacity-90 transition-opacity"
        >
          {t.cta_docs ?? "Read the Docs"}
        </a>
        <a
          href="/playground"
          class="px-8 py-4 glass rounded-full font-semibold text-[var(--color-text-primary)] hover:bg-[rgba(255,255,255,0.08)] transition-colors"
        >
          {t.cta_playground ?? "Open Playground"}
        </a>
      </div>

      <p class="text-sm text-[var(--color-text-tertiary)]">
        Apache 2.0 Licensed. Open Source.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-install-cta');
  const cmdEl = document.getElementById('install-cmd');

  copyBtn?.addEventListener('click', async () => {
    const text = cmdEl?.textContent?.trim();
    if (text) {
      await navigator.clipboard.writeText(text);
      copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
      setTimeout(() => {
        copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
      }, 2000);
    }
  });
</script>
