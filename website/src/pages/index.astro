---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ManifestoPlates from '../components/home/ManifestoPlates.astro';
import Witnesses from '../components/home/Witnesses.astro';
import SounioMark from '../components/common/SounioMark.astro';
import ManifestoPulse from '../components/home/ManifestoPulse.astro';
import KnowledgeRefusalExhibit from '../components/home/KnowledgeRefusalExhibit.astro';
import LivingLanguagePulse from '../components/home/LivingLanguagePulse.astro';
import ProofMoment from '../components/home/ProofMoment.astro';
import NumberAnchor from '../components/home/NumberAnchor.astro';
import DomainGlimpses from '../components/home/DomainGlimpses.astro';
import FlagshipApplications from '../components/home/FlagshipApplications.astro';
import CompilerDepth from '../components/home/CompilerDepth.astro';
import HonestStatusSection from '../components/status/HonestStatusSection.astro';
import { KineticText } from '../components/common/KineticText';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';
import { publicContract } from '../data/artifactStatus';

const locale = getLocaleFromUrl(Astro.url);
const trans = await loadTranslations(locale);
const { defaultWorkflow } = publicContract;

const cta = {
  en: {
    heading: 'Enter the language.',
    body: 'Clone the repo. Run the self-hosted compiler. Read the proof surfaces.',
    install: 'Install guide',
    proof: 'See the proof',
    tour: 'Language tour',
    honesty: 'The argument',
  },
  pt: {
    heading: 'Entre na linguagem.',
    body: 'Clone o repositório. Execute o compilador self-hosted. Leia as superfícies de prova.',
    install: 'Guia de instalação',
    proof: 'Ver as provas',
    tour: 'Tour da linguagem',
    honesty: 'O argumento',
  },
  es: {
    heading: 'Entre en el lenguaje.',
    body: 'Clone el repositorio. Ejecute el compilador self-hosted. Lea las superficies de prueba.',
    install: 'Guía de instalación',
    proof: 'Ver las pruebas',
    tour: 'Tour del lenguaje',
    honesty: 'El argumento',
  },
  el: {
    heading: 'Εισέλθετε στη γλώσσα.',
    body: 'Κάντε clone το repo. Τρέξτε τον self-hosted compiler. Διαβάστε τις επιφάνειες απόδειξης.',
    install: 'Οδηγός εγκατάστασης',
    proof: 'Δείτε την απόδειξη',
    tour: 'Περιήγηση στη γλώσσα',
    honesty: 'Το επιχείρημα',
  },
  zh: { heading: '进入语言。', body: '克隆仓库。运行自托管编译器。阅读证明界面。', install: '安装指南', proof: '查看证明', tour: '语言导览', honesty: '论点' },
  'zh-hk': { heading: '開始使用呢種語言。', body: '複製倉庫。執行自託管編譯器。閱讀證明介面。', install: '安裝指南', proof: '查看證明', tour: '語言導覽', honesty: '論點' },
  ja: { heading: '言語に入る。', body: 'リポジトリをクローン。セルフホストコンパイラを実行。証明サーフェスを読む。', install: 'インストールガイド', proof: '証明を見る', tour: '言語ツアー', honesty: '論証' },
};

const d = cta[locale] ?? cta.en;
---

<BaseLayout title={trans.page_home_title} description={trans.page_home_desc} removeTopPadding={true}>

  {/* 1 — HERO */}
  <Hero locale={locale} />

  {/* 2 — MANIFESTO */}
  <ManifestoPulse locale={locale} />

  {/* 2b — THE TWO WITNESSES */}
  <Witnesses locale={locale} />

  {/* 3 — KNOWLEDGE REFUSAL METER */}
  <KnowledgeRefusalExhibit locale={locale} />

  {/* 3b — SPECTRUM PLATES */}
  <ManifestoPlates locale={locale} />

  {/* 4 — LIVING LANGUAGE PULSE */}
  <LivingLanguagePulse locale={locale} />

  {/* 5 — PROOF MOMENT */}
  <ProofMoment locale={locale} />

  {/* 6 — THE NUMBER */}
  <NumberAnchor locale={locale} />

  {/* 7 — DOMAIN GLIMPSES */}
  <DomainGlimpses locale={locale} />

  {/* 8 — FLAGSHIP APPLICATIONS */}
  <FlagshipApplications locale={locale} />

  {/* 9 — COMPILER DEPTH */}
  <CompilerDepth locale={locale} />

  {/* 10 — HONEST STATUS */}
  <HonestStatusSection variant="clinical" />

  {/* 11 — ENTER */}
  <section class="enter spectrum-surface" aria-label={d.heading}>
    <div class="enter-art" aria-hidden="true">
      <video class="enter-video" muted loop playsinline preload="none" poster="/media/sounio-field.webp" data-src="/media/sounio-field.mp4"></video>
      <div class="enter-veil"></div>
    </div>
    <div class="container enter-grid">
      <SounioMark size={56} class="enter-mark" />
      <KineticText text={d.heading} className="enter-title justify-center" client:visible />
      <p class="enter-body">
        {d.body}
        {defaultWorkflow.summary && <> {defaultWorkflow.summary}</>}
      </p>
      <pre class="sx-code enter-code"><code><span class="sx-c">$</span> git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="enter-actions">
        <a href={getLocalizedPath('/learn/getting-started', locale)} class="sx-btn sx-btn--primary">{d.install}</a>
        <a href={getLocalizedPath('/proof', locale)} class="sx-btn sx-btn--secondary">{d.proof}</a>
        <a href={getLocalizedPath('/language', locale)} class="sx-btn sx-btn--ghost">{d.tour}</a>
        <a href={getLocalizedPath('/honesty', locale)} class="sx-btn sx-btn--ghost">{d.honesty}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .enter {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6rem, 14vw, 11rem) 0;
    text-align: center;
  }
  .enter-art { position: absolute; inset: 0; z-index: -1; }
  .enter-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .enter-veil {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 50%, rgba(5, 8, 14, 0.82), rgba(5, 8, 14, 0.35) 70%, rgba(5, 8, 14, 0.7));
  }
  .enter-grid { display: grid; justify-items: center; gap: 1.5rem; max-width: 46rem; }
  .enter-grid :global(.enter-mark) { color: #D6B35A; filter: drop-shadow(0 0 18px rgba(214, 179, 90, 0.45)); }
  .enter :global(.enter-title) {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: #FFFFFF;
  }
  .enter-body { margin: 0; max-width: 52ch; color: rgba(255, 255, 255, 0.78); font-size: 1.05rem; line-height: 1.7; }
  .enter-code { max-width: 100%; text-align: left; background: rgba(5, 8, 14, 0.78); }
  .enter-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const v = document.querySelector<HTMLVideoElement>('.enter-video');
    if (!v || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!v.src && v.dataset.src) v.src = v.dataset.src; v.play().catch(() => {}); }
      else v.pause();
    }).observe(v);
  });
</script>
