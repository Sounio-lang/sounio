---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import { ScrollStorySection } from '../components/home/ScrollStorySection';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import DomainGallery from '../components/home/DomainGallery.astro';
import NumbersSection from '../components/home/NumbersSection.astro';
import { KineticText } from '../components/common/KineticText';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import CodeExamples from '../components/home/CodeExamples';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="Sounio — A self-hosted systems language for epistemic computing" removeTopPadding={true}>

  {/* ═══════════════════════════════════════════════════════════════
      1 — CINEMATIC HERO
  ═══════════════════════════════════════════════════════════════ */}
  <Hero locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      2 — SCROLL STORY  (audience-adaptive narrative, 400 vh)
  ═══════════════════════════════════════════════════════════════ */}
  <ScrollStorySection client:load />

  {/* ═══════════════════════════════════════════════════════════════
      3 — THREE HARD FACTS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="Three things that are true" client:visible />
        <p class="section-subhead">Not claims. Artifacts you can read, run, or verify.</p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            The compiler compiles itself.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Sounio bootstrapped from a 2,000-line C compiler through a multi-stage chain
            to a bit-identical fixed point: stage2 and stage3 produce byte-for-byte
            identical binaries.
          </p>
          <a href={getLocalizedPath('/learn/compiler', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            See the bootstrap chain →
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            A new theorem, proved inside the language.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            The number of non-associative basis triples in the octonions equals
            168 = |PSL(2,7)|. Verified computationally in Sounio, reproduced in NumPy,
            under review at Advances in Applied Clifford Algebras.
          </p>
          <a href={getLocalizedPath('/proof#theorem-168', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the theorem page →
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            Patient-safety guarantees before any code runs.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            A function requiring ε ≥ 0.82 for AUC-guided vancomycin dosing rejects an
            underpowered measurement at compile time. Not a lint — the type checker
            refuses to emit the program.
          </p>
          <a href={getLocalizedPath('/proof#compile-fail-vancomycin', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the vancomycin example →
          </a>
        </article>

      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      4 — CODE EXAMPLES  (tabbed Python vs Sounio)
  ═══════════════════════════════════════════════════════════════ */}
  <CodeExamples client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      5 — FEATURE GRID  (bento)
  ═══════════════════════════════════════════════════════════════ */}
  <FeatureGrid locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      6 — DOMAIN GALLERY
  ═══════════════════════════════════════════════════════════════ */}
  <DomainGallery locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      7 — NUMBERS
  ═══════════════════════════════════════════════════════════════ */}
  <NumbersSection />

  {/* ═══════════════════════════════════════════════════════════════
      8 — HONEST STATUS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="What is true right now" client:visible />
        <p class="section-subhead">
          The anti-slop move: the site admits what does not work before the reader discovers it.
        </p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[var(--color-accent-gold-soft)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">
            Works
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">Epistemic core</strong> — Knowledge[T] + GUM propagation, dissertation-grade</li>
            <li><strong class="text-[var(--color-text-primary)]">Self-hosted compiler</strong> — fixed-point verified (stage2 == stage3)</li>
            <li><strong class="text-[var(--color-text-primary)]">Algebra</strong> — Clifford, Cayley-Dickson, octonions — verified the 168 theorem</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology</strong> — OWL2 model + reasoner, 40 tests passing</li>
            <li><strong class="text-[var(--color-text-primary)]">Native codegen</strong> — x86-64 ELF, bit-identical bootstrap chain</li>
            <li><strong class="text-[var(--color-text-primary)]">Core stdlib</strong> — stats, linalg, ODE, signal, CSV, JSON — 81 pass / 0 fail</li>
            <li><strong class="text-[var(--color-text-primary)]">Optimizer</strong> — 1000+ e-graph rewrite rules, all FAIL=0</li>
          </ul>
        </article>

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,255,255,0.18)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-text-tertiary)]">
            Scaffolding
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">Theorem prover</strong> — 9,600 lines, no inference logic yet</li>
            <li><strong class="text-[var(--color-text-primary)]">~70% of epistemic modules</strong> — signatures with minimal bodies</li>
            <li><strong class="text-[var(--color-text-primary)]">Neural networks</strong> — quaternion/octonion: compilation errors</li>
            <li><strong class="text-[var(--color-text-primary)]">Genomics</strong> — 11 files are single-line stubs</li>
            <li><strong class="text-[var(--color-text-primary)]">Async runtime</strong> — 12 files, mostly &lt;10 lines each</li>
            <li><strong class="text-[var(--color-text-primary)]">Geometry engine</strong> — 100% disabled</li>
          </ul>
        </article>

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,80,80,0.45)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[rgba(255,100,100,0.8)]">
            Missing
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">Knowledge&lt;T&gt; generics</strong> — hardcoded as f64 struct only</li>
            <li><strong class="text-[var(--color-text-primary)]">Epistemic ODE solver</strong> — exponential decay only, not general RHS</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology federation</strong> — 8 hardcoded CURIEs, not 15M terms</li>
            <li><strong class="text-[var(--color-text-primary)]">GPU entry point</strong> — gpu/lib.sio is empty; PTX exists but no end-to-end path</li>
            <li><strong class="text-[var(--color-text-primary)]">Closure literals</strong> — |x| x + 1 not supported</li>
            <li><strong class="text-[var(--color-text-primary)]">Windows / macOS</strong> — Linux x86-64 only</li>
          </ul>
        </article>

      </div>

      <p class="mt-[1.2rem] text-[0.84rem] text-[var(--color-text-tertiary)]">
        <a href="https://github.com/sounio-lang/sounio#honest-status" target="_blank" rel="noopener noreferrer" class="hover:underline text-[var(--color-text-secondary)]">
          Read the full honest status →
        </a>
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      9 — CTA
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_18%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.4rem] max-w-[640px]">
      <KineticText text="Start building today" client:visible />
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.7]">
        Clone the repo, run the examples, push the type system. The self-hosted compiler
        is on Linux x86-64 — no toolchain required.
      </p>
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.9rem] font-mono p-[1rem] overflow-x-auto leading-relaxed"><code>$ git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          Install guide
        </a>
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          See the proof
        </a>
        <a
          href={getLocalizedPath('/language', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          Language tour
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
