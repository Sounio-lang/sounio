---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import GPUProofSection from '../components/home/GPUProofSection.astro';
import ResearchProof from '../components/home/ResearchProof.astro';
import AudiencePaths from '../components/home/AudiencePaths.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import { getProofData } from '../lib/proofData';

const locale = getLocaleFromUrl(Astro.url);
const proof = getProofData();

const capabilityCards = [
  {
    title: 'Trust is part of the language surface',
    body: 'Uncertainty, provenance, and effect boundaries are meant to stay visible all the way from source code to runtime behavior.',
  },
  {
    title: 'The public contract is inspectable',
    body: `Current release provenance is signed, the stdlib reliability gate is ${proof.stdlib.passCount}/${proof.stdlib.totalCount}, and the public GPU contract currently passes ${proof.gpu.publicPassCount}/${proof.gpu.publicCheckCount} checks.`,
  },
  {
    title: 'The project is under real pressure',
    body: 'Research programs in PBPK, connectomics, and exceptional algebra keep forcing compiler and runtime edges into the open instead of letting them stay hypothetical.',
  },
];

const productSurfaces = [
  {
    title: 'Proof',
    body: 'See the current verified snapshot, boundaries, and source-of-truth artifacts.',
    href: '/proof',
    cta: 'Inspect the proof hub',
  },
  {
    title: 'Docs',
    body: 'One direct route into the language, the implementation, and the current feature envelope.',
    href: '/learn',
    cta: 'Open docs',
  },
  {
    title: 'Research',
    body: 'Browse the scientific programs and validation pressure that are shaping the compiler.',
    href: '/science',
    cta: 'View research',
  },
  {
    title: 'Releases',
    body: 'Track attested release provenance instead of trusting stale version marketing.',
    href: '/releases',
    cta: 'Read release provenance',
  },
  {
    title: 'Showcases',
    body: 'See bounded examples and domain narratives without mistaking them for the full contract.',
    href: '/showcases',
    cta: 'Browse showcases',
  },
  {
    title: 'Playground',
    body: 'Use the interactive surface once you understand the current proof envelope and boundaries.',
    href: '/playground',
    cta: 'Open playground',
  },
];
---

<BaseLayout
  title="Scientific software with explicit uncertainty"
  description="A credibility-first language website for researchers and technical leaders who need uncertainty, provenance, and proof to be first-class."
  removeTopPadding={true}
>
  <Hero locale={locale} />
  <ProofStrip locale={locale} />
  <GPUProofSection locale={locale} />

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Why this site is changing.</h2>
        <p class="section-subhead">
          It now leads with proof, boundaries, and real pressure instead of trying to look like a generic language launch site.
        </p>
      </div>

      <div class="capability-grid premium-grid">
        {capabilityCards.map((card) => (
          <article class="capability-card glass glass-specular">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>

      <div class="home-snapshot glass">
        <div>
          <div class="snapshot-brand-lockup" aria-hidden="true">
            <img src="/assets/emblem/emblem_badge_textperfect_optionC.svg" alt="" class="snapshot-emblem" />
            <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" class="snapshot-stamp" />
          </div>
          <span class="snapshot-kicker">Current verified snapshot</span>
          <h3>What is true right now, not what might be true later.</h3>
          <p>
            Release provenance is currently attested at <strong>v{proof.release.version}</strong>. The stdlib reliability
            gate is <strong>{proof.stdlib.passCount}/{proof.stdlib.totalCount}</strong>, with{' '}
            <strong>{proof.stdlib.activeModuleEntrypoints}</strong> active module entrypoints. The GPU public contract
            passes <strong>{proof.gpu.publicPassCount}/{proof.gpu.publicCheckCount}</strong> public checks with{' '}
            <strong>{proof.gpu.attestedTargetCount}</strong> attested binary targets.
          </p>
        </div>
        <a href={getLocalizedPath('/proof', locale)} class="snapshot-link">Read the full proof surface</a>
      </div>
    </div>
  </section>

  <ResearchProof />
  <AudiencePaths locale={locale} />

  <section class="section-shell surface-section">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Primary product surfaces.</h2>
        <p class="section-subhead">
          These are the routes that matter most if you are assessing the project seriously.
        </p>
      </div>

      <div class="surface-grid premium-grid">
        {productSurfaces.map((surface) => (
          <a href={getLocalizedPath(surface.href, locale)} class="surface-card glass glass-elevated">
            <h3>{surface.title}</h3>
            <p>{surface.body}</p>
            <span>{surface.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .capability-grid,
  .surface-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .capability-card,
  .surface-card,
  .home-snapshot {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
  }

  .capability-card {
    display: grid;
    gap: 0.5rem;
  }

  .capability-card h3,
  .surface-card h3,
  .home-snapshot h3 {
    font-size: 1.18rem;
  }

  .capability-card p,
  .surface-card p,
  .home-snapshot p {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
  }

  .home-snapshot {
    margin-top: 1rem;
    display: grid;
    gap: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 28%, transparent);
    background:
      radial-gradient(560px 220px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 18%, transparent), transparent 60%),
      color-mix(in srgb, var(--color-bg-alt) 82%, transparent);
  }

  .snapshot-kicker {
    color: var(--color-accent-gold-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .snapshot-brand-lockup {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    margin-bottom: 0.65rem;
  }

  .snapshot-emblem {
    width: min(240px, 62%);
    height: auto;
    opacity: 0.92;
  }

  .snapshot-stamp {
    width: 86px;
    height: 86px;
    object-fit: contain;
    opacity: 0.16;
    filter: saturate(0) brightness(1.3);
  }
  .snapshot-link,
  .surface-card span {
    width: fit-content;
    color: var(--color-text-primary);
    font-size: 0.84rem;
    font-weight: 650;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 45%, transparent);
    padding-bottom: 0.15rem;
  }

  .surface-card {
    display: grid;
    gap: 0.55rem;
  }

  .surface-card span {
    margin-top: 0.1rem;
  }
</style>
