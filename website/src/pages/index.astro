---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import FlagshipSystems from '../components/home/FlagshipSystems.astro';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="" removeTopPadding={true}>
  <Hero locale={locale} />

  <FlagshipSystems locale={locale} />

  <section class="section-shell section-deferred">
    <div class="container">
      <div class="home-closing">
        <p class="home-closing-label">Go</p>
        <div class="home-closing-links">
          <a href={getLocalizedPath('/about/vision', locale)} class="home-closing-link">Manifesto</a>
          <a href={getLocalizedPath('/learn/getting-started', locale)} class="home-closing-link">Start</a>
          <a href={getLocalizedPath('/proof', locale)} class="home-closing-link">Proof</a>
        </div>
        <pre class="home-closing-code"><code>$ ./bin/souc run examples/hello.sio</code></pre>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-closing {
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .home-closing-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-gold-soft);
  }

  .home-closing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .home-closing-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--color-text-primary);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .home-closing-link::after {
    content: '→';
    color: var(--color-accent-gold);
  }

  .home-closing-link:hover {
    color: var(--color-accent-gold);
    transform: translateX(1px);
  }

  .home-closing-code {
    margin: 0;
    max-width: 31rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.24);
  }

  @media (min-width: 980px) {
    .home-closing {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .home-closing-code {
      justify-self: end;
    }
  }
</style>
