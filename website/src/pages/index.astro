---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import CodeExamples from '../components/home/CodeExamples';
import { getLocaleFromUrl, loadTranslations } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

// Use case cards data
const useCases = [
  {
    title: 'Pharmacometrics',
    description: 'PK/PD modeling with MedLang for drug dosage optimization and clinical trial design with rigorous uncertainty handling.',
    icon: 'pharma',
    href: '/showcases/pharma',
    gradient: 'from-rose-500 to-pink-600',
  },
  {
    title: 'Neuroimaging',
    description: 'fMRI pipeline analysis with confidence-gated processing and provenance tracking for reproducible neuroscience.',
    icon: 'brain',
    href: '/showcases/neuroimaging',
    gradient: 'from-purple-500 to-indigo-600',
  },
  {
    title: 'Quantum Chemistry',
    description: 'VQE algorithms with uncertainty quantification for variational quantum eigensolver implementations.',
    icon: 'quantum',
    href: '/showcases/quantum',
    gradient: 'from-cyan-500 to-blue-600',
  },
  {
    title: 'Climate Science',
    description: 'Climate modeling with uncertainty propagation for robust predictions and policy-relevant confidence intervals.',
    icon: 'climate',
    href: '/showcases/climate',
    gradient: 'from-emerald-500 to-teal-600',
  },
  {
    title: 'Causal Inference',
    description: 'Bayesian networks with epistemic types for causal discovery and treatment effect estimation with uncertainty.',
    icon: 'causal',
    href: '/showcases/causal',
    gradient: 'from-amber-500 to-orange-600',
  },
  {
    title: 'GPU Computing',
    description: 'Physics simulations with native GPU kernels, high-performance computing without leaving the language.',
    icon: 'gpu',
    href: '/showcases/gpu',
    gradient: 'from-red-500 to-rose-600',
  },
];

const iconPaths: Record<string, string> = {
  pharma: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  brain: 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  quantum: 'M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25',
  climate: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418',
  causal: 'M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5',
  gpu: 'M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z',
};

// Maturity items
const maturityItems = {
  stable: [
    { name: 'Epistemic types (Knowledge<T>)', icon: '🎯' },
    { name: 'GPU kernels (PTX, SPIR-V)', icon: '⚡' },
    { name: 'Effect system (IO, Mut, Alloc)', icon: '🔄' },
    { name: 'Units of measure (mg, L, h)', icon: '📏' },
    { name: 'Linear type checking', icon: '🔗' },
  ],
  experimental: [
    { name: 'Module system (use statements)', icon: '📦' },
    { name: 'Package manager', icon: '🧩' },
    { name: 'Refinement types (Z3 backend)', icon: '🔬' },
  ],
  inProgress: [
    { name: 'LSP server (language features)', icon: '✨' },
    { name: 'WebAssembly backend', icon: '🌐' },
    { name: 'Documentation generator', icon: '📖' },
  ],
};

const docCards = [
  {
    title: t.docs_getting_started,
    description: t.docs_getting_started_desc,
    href: '/docs/getting-started',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    color: 'emerald',
  },
  {
    title: t.docs_language_guide,
    description: t.docs_language_guide_desc,
    href: '/docs/language',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    color: 'blue',
  },
  {
    title: t.docs_stdlib,
    description: t.docs_stdlib_desc,
    href: '/docs/stdlib',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    color: 'purple',
  },
  {
    title: t.docs_examples,
    description: t.docs_examples_desc,
    href: '/docs/examples',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    color: 'amber',
  },
  {
    title: 'Interactive Playground',
    description: 'Write, compile, and run Sounio code directly in your browser.',
    href: '/playground',
    icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z',
    color: 'rose',
  },
  {
    title: 'Blog & Updates',
    description: 'Latest news, tutorials, and insights from the Sounio team.',
    href: '/blog',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
    color: 'cyan',
  },
];

const colorClasses: Record<string, { bg: string; text: string; border: string }> = {
  emerald: { bg: 'bg-emerald-500/10', text: 'text-emerald-500', border: 'group-hover:border-emerald-500/50' },
  blue: { bg: 'bg-blue-500/10', text: 'text-blue-500', border: 'group-hover:border-blue-500/50' },
  purple: { bg: 'bg-purple-500/10', text: 'text-purple-500', border: 'group-hover:border-purple-500/50' },
  amber: { bg: 'bg-amber-500/10', text: 'text-amber-500', border: 'group-hover:border-amber-500/50' },
  rose: { bg: 'bg-rose-500/10', text: 'text-rose-500', border: 'group-hover:border-rose-500/50' },
  cyan: { bg: 'bg-cyan-500/10', text: 'text-cyan-500', border: 'group-hover:border-cyan-500/50' },
};
---

<BaseLayout title="">
  <Hero locale={locale} />
  <FeatureGrid locale={locale} />
  <CodeExamples client:visible />

  <!-- Use Cases Section -->
  <section id="use-cases" class="relative py-32 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-[var(--color-bg)]"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-purple-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-gradient-to-tr from-[var(--color-gold-500)]/10 to-transparent rounded-full blur-3xl"></div>

    <div class="relative container px-4">
      <!-- Section header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 text-purple-500 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          Domain Applications
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-navy-900)] dark:text-white mb-6">
          {t.usecases_title}
        </h2>
        <p class="text-lg md:text-xl text-[var(--color-text-muted)] max-w-3xl mx-auto leading-relaxed">
          {t.usecases_description}
        </p>
      </div>

      <!-- Use cases grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {useCases.map((useCase, index) => (
          <a
            href={useCase.href}
            class="group relative block p-8 bg-white dark:bg-[#0d1117] rounded-2xl border border-gray-200 dark:border-white/10 hover:border-transparent transition-all duration-500"
            style={`animation: fadeInUp 0.6s ease forwards; animation-delay: ${index * 0.1}s; opacity: 0;`}
          >
            <!-- Gradient glow on hover -->
            <div class={`absolute -inset-0.5 bg-gradient-to-r ${useCase.gradient} rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-500`}></div>

            <div class="relative">
              <!-- Icon -->
              <div class={`inline-flex items-center justify-center w-14 h-14 bg-gradient-to-br ${useCase.gradient} rounded-xl mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300`}>
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[useCase.icon]} />
                </svg>
              </div>

              <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-3 group-hover:text-[var(--color-orange-500)] transition-colors">
                {useCase.title}
              </h3>

              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed mb-6">
                {useCase.description}
              </p>

              <span class="inline-flex items-center gap-2 text-[var(--color-orange-500)] font-medium text-sm group-hover:gap-3 transition-all">
                {t.usecase_learn_more}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Maturity Section -->
  <section id="maturity" class="relative py-32 overflow-hidden bg-[#0a0f1a]">
    <!-- Decorative grid -->
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative container px-4">
      <!-- Section header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 text-emerald-400 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          Project Status
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          {t.maturity_title}
        </h2>
        <p class="text-lg md:text-xl text-white/60 max-w-3xl mx-auto leading-relaxed">
          {t.maturity_description}
        </p>
      </div>

      <!-- Maturity grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Stable -->
        <div class="relative">
          <div class="absolute -inset-0.5 bg-gradient-to-b from-emerald-500 to-emerald-600 rounded-2xl opacity-20"></div>
          <div class="relative p-6 bg-[#0d1117] rounded-2xl border border-emerald-500/20">
            <div class="flex items-center gap-3 mb-6">
              <div class="flex items-center justify-center w-10 h-10 bg-emerald-500/20 rounded-lg">
                <div class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></div>
              </div>
              <h3 class="text-lg font-semibold text-emerald-400">{t.maturity_stable_label}</h3>
            </div>
            <ul class="space-y-3">
              {maturityItems.stable.map((item) => (
                <li class="flex items-center gap-3 p-3 bg-emerald-500/5 rounded-lg border border-emerald-500/10">
                  <span class="text-lg">{item.icon}</span>
                  <span class="text-white/80 text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Experimental -->
        <div class="relative">
          <div class="absolute -inset-0.5 bg-gradient-to-b from-amber-500 to-orange-600 rounded-2xl opacity-20"></div>
          <div class="relative p-6 bg-[#0d1117] rounded-2xl border border-amber-500/20">
            <div class="flex items-center gap-3 mb-6">
              <div class="flex items-center justify-center w-10 h-10 bg-amber-500/20 rounded-lg">
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
              </div>
              <h3 class="text-lg font-semibold text-amber-400">{t.maturity_experimental_label}</h3>
            </div>
            <ul class="space-y-3">
              {maturityItems.experimental.map((item) => (
                <li class="flex items-center gap-3 p-3 bg-amber-500/5 rounded-lg border border-amber-500/10">
                  <span class="text-lg">{item.icon}</span>
                  <span class="text-white/80 text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- In Progress -->
        <div class="relative">
          <div class="absolute -inset-0.5 bg-gradient-to-b from-indigo-500 to-purple-600 rounded-2xl opacity-20"></div>
          <div class="relative p-6 bg-[#0d1117] rounded-2xl border border-indigo-500/20">
            <div class="flex items-center gap-3 mb-6">
              <div class="flex items-center justify-center w-10 h-10 bg-indigo-500/20 rounded-lg">
                <svg class="w-4 h-4 text-indigo-400 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-indigo-400">{t.maturity_inprogress_label}</h3>
            </div>
            <ul class="space-y-3">
              {maturityItems.inProgress.map((item) => (
                <li class="flex items-center gap-3 p-3 bg-indigo-500/5 rounded-lg border border-indigo-500/10">
                  <span class="text-lg">{item.icon}</span>
                  <span class="text-white/80 text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Roadmap link -->
      <div class="text-center mt-12">
        <a href="/roadmap" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors">
          View full roadmap
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Documentation Section -->
  <section id="docs" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-bg)]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-[var(--color-gold-500)]/5 via-purple-500/5 to-emerald-500/5 rounded-full blur-3xl"></div>

    <div class="relative container px-4">
      <!-- Section header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 text-blue-500 dark:text-blue-400 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Documentation
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-navy-900)] dark:text-white mb-6">
          {t.docs_title}
        </h2>
        <p class="text-lg md:text-xl text-[var(--color-text-muted)] max-w-3xl mx-auto leading-relaxed">
          {t.docs_description}
        </p>
      </div>

      <!-- Docs grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {docCards.map((card, index) => (
          <a
            href={card.href}
            class={`group relative p-6 bg-white dark:bg-[#0d1117] rounded-2xl border border-gray-200 dark:border-white/10 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${colorClasses[card.color].border}`}
            style={`animation: fadeInUp 0.6s ease forwards; animation-delay: ${index * 0.1}s; opacity: 0;`}
          >
            <div class={`inline-flex items-center justify-center w-12 h-12 ${colorClasses[card.color].bg} rounded-xl mb-4 group-hover:scale-110 transition-transform duration-300`}>
              <svg class={`w-6 h-6 ${colorClasses[card.color].text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
              </svg>
            </div>

            <h3 class="text-lg font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)] transition-colors">
              {card.title}
            </h3>

            <p class="text-[var(--color-text-muted)] text-sm leading-relaxed mb-4">
              {card.description}
            </p>

            <span class={`inline-flex items-center gap-1 ${colorClasses[card.color].text} text-sm font-medium`}>
              {t.docs_explore}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Name Section -->
  <section class="relative py-32 overflow-hidden">
    <!-- Background with gradient mesh -->
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-navy-900)] via-[var(--color-navy-800)] to-[#1e1b4b]"></div>
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-[var(--color-gold-500)]/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
    </div>

    <div class="relative container px-4 max-w-4xl text-center">
      <!-- Greek temple icon -->
      <div class="inline-flex items-center justify-center w-20 h-20 bg-white/10 rounded-2xl mb-8 backdrop-blur-sm border border-white/10">
        <svg class="w-10 h-10 text-[var(--color-gold-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
        </svg>
      </div>

      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-8">
        {t.name_title}
      </h2>

      <p class="text-xl md:text-2xl leading-relaxed text-white/80 mb-8">
        {t.name_description}
      </p>

      <div class="inline-block px-6 py-3 bg-white/10 rounded-xl border border-[var(--color-gold-500)]/30 backdrop-blur-sm">
        <p class="text-lg md:text-xl text-[var(--color-gold-500)] italic font-medium">
          {t.name_meaning}
        </p>
      </div>

      <!-- Decorative line -->
      <div class="mt-12 flex items-center justify-center gap-4">
        <div class="w-16 h-px bg-gradient-to-r from-transparent to-[var(--color-gold-500)]"></div>
        <svg class="w-6 h-6 text-[var(--color-gold-500)]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
        </svg>
        <div class="w-16 h-px bg-gradient-to-l from-transparent to-[var(--color-gold-500)]"></div>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-bg)]"></div>

    <div class="relative container px-4 max-w-2xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-navy-900)] dark:text-white mb-4">
        {t.newsletter_title}
      </h2>
      <p class="text-[var(--color-text-muted)] text-lg mb-8">
        {t.newsletter_description}
      </p>

      <form class="relative">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <input
              type="email"
              placeholder={t.newsletter_placeholder}
              class="w-full px-5 py-4 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#0d1117] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold-500)] transition-all"
              required
            />
          </div>
          <button
            type="submit"
            class="px-8 py-4 bg-gradient-to-r from-[var(--color-gold-500)] to-[var(--color-orange-500)] text-[var(--color-navy-900)] rounded-xl font-semibold hover:shadow-lg hover:shadow-[var(--color-gold-500)]/25 transition-all duration-300 hover:-translate-y-0.5"
          >
            {t.newsletter_button}
          </button>
        </div>
      </form>

      <p class="mt-4 text-sm text-[var(--color-text-muted)]">
        No spam, ever. Unsubscribe anytime.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
