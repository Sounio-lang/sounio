---
{/* TODO(i18n): translate Phase 2 homepage for pt, el, zh, ja, es — handled in PROMPT 5 */}
import BaseLayout from '../layouts/BaseLayout.astro';
import { KineticText } from '../components/common/KineticText';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import { Picture } from 'astro:assets';
import pappouHero from '../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../public/assets/original-artworks/yiayia_hero.png';
import SounioCode from '../components/SounioCode.astro';

const locale = getLocaleFromUrl(Astro.url);

const vancomycinCode = `struct KnowledgeF64 {
    value: f64,
    uncertainty: f64,
    confidence: f64
}

// Conservative first-order multiplication bound (GUM §13).
fn gum_mul(a: KnowledgeF64, b: KnowledgeF64) -> KnowledgeF64 {
    let nominal = a.value * b.value
    let propagated = abs_f64(b.value) * a.uncertainty + abs_f64(a.value) * b.uncertainty
    return KnowledgeF64 {
        value: nominal,
        uncertainty: propagated,
        confidence: min_f64(a.confidence, b.confidence)
    }
}

fn main() with IO {
    // Step 1 — weight-adjusted base dose (15 mg/kg/day, confidence 0.92)
    let base_dose = make_knowledge(15.0, 0.6, 0.92)
    let weight     = make_knowledge(78.5, 0.5, 0.98)
    let ref_wt     = make_knowledge(70.0, 0.1, 1.0)
    let dose1 = gum_mul(base_dose, gum_div(weight, ref_wt))

    // Step 2 — renal attenuation (Cockcroft-Gault, confidence 0.72)
    let crcl  = make_knowledge(65.0, 8.0, 0.72)
    let dose2 = gum_mul(dose1, gum_div(crcl, make_knowledge(120.0, 1.0, 1.0)))

    // Step 3 — NSAID nephrotoxicity penalty (confidence 0.65)
    let nephro = make_knowledge(0.85, 0.03, 0.65)
    let dose3  = gum_mul(dose2, nephro)

    // Step 4 — direct trough measurement (confidence 0.96 — higher than pipeline)
    let trough = make_knowledge(14.2, 0.2, 0.96)

    // Step 5 — safety gate: confidence must reach ε ≥ 0.82
    if dose3.confidence >= 0.82 {
        println("PRESCRIBE: propagated dose confidence sufficient")
    } else {
        println("BLOCKED:   refine renal estimate before AUC-guided dosing")
    }

    if trough.confidence >= 0.82 {
        println("PRESCRIBE: trough confidence sufficient for TDM adjustment")
    } else {
        println("BLOCKED:   insufficient lab confidence")
    }
}`;
---

<BaseLayout title="Sounio — A self-hosted systems language for epistemic computing" removeTopPadding={true}>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 1 — HERO
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell pt-[clamp(3rem,8vw,6rem)]">
    <div class="container grid gap-[clamp(2rem,5vw,4rem)] lg:grid-cols-[1fr_1fr] lg:items-center">

      {/* Left — identity copy */}
      <div class="grid gap-[1.4rem]">
        <h1 class="font-sans text-[clamp(2.4rem,5vw,3.6rem)] font-[750] leading-[1.08] tracking-[-0.025em] text-[var(--color-text-primary)]">
          Sounio
        </h1>
        <p class="font-sans text-[clamp(1rem,2vw,1.2rem)] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.6]">
          A self-hosted systems language for code that knows what it does not know.
        </p>
        <p class="text-[0.97rem] text-[var(--color-text-secondary)] max-w-[58ch] leading-[1.7]">
          Software should express not only what it computes, but what it can
          justify. Every value carries its uncertainty, its provenance, and the
          confidence threshold below which it refuses to be used. The compiler
          enforces this at the type level — before a single instruction runs.
        </p>
        <div class="flex flex-wrap gap-[0.65rem] mt-[0.4rem]">
          <a
            href={getLocalizedPath('/about/vision', locale)}
            class="inline-flex items-center justify-center rounded-full px-[1.3rem] py-[0.75rem] text-[0.93rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
          >
            Read the manifesto
          </a>
          <a
            href={getLocalizedPath('/proof', locale)}
            class="inline-flex items-center justify-center rounded-full px-[1.3rem] py-[0.75rem] text-[0.93rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
          >
            See the proof
          </a>
        </div>
      </div>

      {/* Right — Pappou + Yiayia diptych */}
      <div class="grid gap-[0.5rem]">
        <div class="grid grid-cols-2 gap-[0.5rem]">
          <Picture
            src={pappouHero}
            alt="Pappou — original artwork"
            class="rounded-[var(--radius-lg)] w-full h-auto object-cover"
            formats={['avif', 'webp']}
            loading="eager"
            decoding="async"
            widths={[480, 640]}
          />
          <Picture
            src={yiayiaHero}
            alt="Yiayia — original artwork"
            class="rounded-[var(--radius-lg)] w-full h-auto object-cover"
            formats={['avif', 'webp']}
            loading="eager"
            decoding="async"
            widths={[480, 640]}
          />
        </div>
        <p class="text-center text-[0.78rem] text-[var(--color-text-tertiary)] tracking-[0.04em] italic">
          Πάππος καὶ Γιαγιά — the evidence we inherit.
        </p>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 2 — THREE HARD FACTS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="Three things that are true" client:visible />
        <p class="section-subhead">Not claims. Artifacts you can read, run, or verify.</p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        {/* Card 1 — self-hosting */}
        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            The compiler compiles itself.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Sounio bootstrapped from a 2,000-line C compiler through a multi-stage chain
            to a bit-identical fixed point: stage2 and stage3 produce byte-for-byte
            identical binaries. The self-hosted compiler is the language, not a
            reference implementation of it.
          </p>
          <a href={getLocalizedPath('/learn/compiler', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            See the bootstrap chain →
          </a>
        </article>

        {/* Card 2 — 168 theorem */}
        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            A new theorem, proved inside the language.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            While developing the octonion backend, Sounio was used to establish that
            the number of non-associative basis triples in the octonions equals
            168 = |PSL(2,7)|. The decomposition 343 = 133 + 42 + 168 was verified
            computationally in Sounio and independently reproduced in NumPy. The
            paper is under review at Advances in Applied Clifford Algebras.
          </p>
          <a href={getLocalizedPath('/proof#theorem-168', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the theorem page →
          </a>
        </article>

        {/* Card 3 — vancomycin compile-fail */}
        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            Patient-safety guarantees before any code runs.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            A function that requires ε ≥ 0.82 for AUC-guided vancomycin dosing
            rejects an underpowered measurement at compile time. Not a lint, not a
            test suite — the type checker refuses to emit the program.
          </p>
          <a href={getLocalizedPath('/proof#compile-fail-vancomycin', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the vancomycin example →
          </a>
        </article>

      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 3 — CODE TASTING
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell">
    <div class="container grid gap-[1rem] max-w-[860px]">
      <div class="grid gap-[0.4rem]">
        <KineticText text="Five-step GUM propagation" client:visible />
        <p class="section-subhead">Five-step GUM propagation with provenance attached to every value.</p>
      </div>
      <SounioCode code={vancomycinCode} title="vancomycin_propagation.sio" />
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 4 — HONEST STATUS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="What is true right now" client:visible />
        <p class="section-subhead">
          The anti-slop move: the site admits what does not work before the reader discovers it.
        </p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        {/* WORKS */}
        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">
            Works
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0">
            <li><strong class="text-[var(--color-text-primary)]">Epistemic core</strong> — Knowledge[T] + GUM propagation, dissertation-grade</li>
            <li><strong class="text-[var(--color-text-primary)]">Self-hosted compiler</strong> — fixed-point verified (stage2 == stage3)</li>
            <li><strong class="text-[var(--color-text-primary)]">Algebra</strong> — Clifford, Cayley-Dickson, octonions — verified the 168 theorem</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology</strong> — OWL2 model + reasoner, 40 tests passing</li>
            <li><strong class="text-[var(--color-text-primary)]">Native codegen</strong> — x86-64 ELF, bit-identical bootstrap chain</li>
            <li><strong class="text-[var(--color-text-primary)]">Core stdlib</strong> — stats, linalg, ODE, signal, CSV, JSON — 81 pass / 0 fail</li>
            <li><strong class="text-[var(--color-text-primary)]">Optimizer</strong> — 1000+ e-graph rewrite rules, all FAIL=0</li>
          </ul>
        </article>

        {/* SCAFFOLDING */}
        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-text-tertiary)]">
            Scaffolding
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0">
            <li><strong class="text-[var(--color-text-primary)]">Theorem prover</strong> — 9,600 lines, no inference logic yet</li>
            <li><strong class="text-[var(--color-text-primary)]">~70% of epistemic modules</strong> — signatures with minimal bodies</li>
            <li><strong class="text-[var(--color-text-primary)]">Neural networks</strong> — quaternion/octonion: compilation errors</li>
            <li><strong class="text-[var(--color-text-primary)]">Genomics</strong> — 11 files are single-line stubs</li>
            <li><strong class="text-[var(--color-text-primary)]">Async runtime</strong> — 12 files, mostly &lt;10 lines each</li>
            <li><strong class="text-[var(--color-text-primary)]">Geometry engine</strong> — 100% disabled</li>
          </ul>
        </article>

        {/* MISSING */}
        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[rgba(255,80,80,0.7)]">
            Missing
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0">
            <li><strong class="text-[var(--color-text-primary)]">Knowledge&lt;T&gt; generics</strong> — hardcoded as f64 struct only</li>
            <li><strong class="text-[var(--color-text-primary)]">Epistemic ODE solver</strong> — exponential decay only, not general RHS</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology federation</strong> — 8 hardcoded CURIEs, not 15M terms</li>
            <li><strong class="text-[var(--color-text-primary)]">GPU entry point</strong> — gpu/lib.sio is empty; PTX exists but no end-to-end path</li>
            <li><strong class="text-[var(--color-text-primary)]">Closure literals</strong> — |x| x + 1 not supported</li>
            <li><strong class="text-[var(--color-text-primary)]">Windows / macOS</strong> — Linux x86-64 only</li>
          </ul>
        </article>

      </div>

      <p class="mt-[1.2rem] text-[0.84rem] text-[var(--color-text-tertiary)]">
        <a href="https://github.com/sounio-lang/sounio#honest-status" target="_blank" rel="noopener noreferrer" class="hover:underline text-[var(--color-text-secondary)]">
          Read the full honest status →
        </a>
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 5 — FINAL CTA
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell">
    <div class="container grid gap-[1.2rem] max-w-[640px]">
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.9rem] font-mono p-[1rem] overflow-x-auto leading-relaxed"><code>$ git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          Install guide
        </a>
        <a
          href={getLocalizedPath('/about/vision', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          Read the manifesto
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
