---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import { htmlLang } from '../lib/seo-locales.mjs';
import surface from '../data/publicSurface.json';
import scientist from '../data/scientistCopy.json';

const locale = getLocaleFromUrl(Astro.url);
const content = surface[locale];
const repository = 'https://github.com/Sounio-lang/sounio';
const cloneCommands = ['git clone https://github.com/Sounio-lang/sounio.git', 'cd sounio', 'git rev-parse HEAD'].join('\n');
const guideLanguage = locale === 'el' || locale === 'pt' ? locale : 'en';
const scientistCopy = scientist[guideLanguage];
const journeys = [
  { title: scientistCopy.title, body: scientistCopy.intro, href: getLocalizedPath('/scientist', locale), language: guideLanguage },
  { title: content.programTitle, body: content.programBody, href: getLocalizedPath('/learn/getting-started', locale), language: locale },
  { title: content.researchTitle, body: content.researchBody, href: getLocalizedPath('/science', locale), language: locale },
];
const contribute = locale === 'el' ? `${repository}/blob/main/docs/el/contributing.md` : `${repository}/blob/main/CONTRIBUTING.md`;
---

<BaseLayout title={`Sounio — ${content.title}`} description={content.description} removeTopPadding={true}>
  <Hero locale={locale} />

  <section class="public-section" aria-labelledby="journey-title">
    <div class="container journey-layout">
      <div class="section-intro">
        <h2 id="journey-title">{content.journey}</h2>
        <p>{content.journeyIntro}</p>
        <p><a class="text-link" href={getLocalizedPath('/learn/language/units-and-uncertainty/', locale)} hreflang="en">Learn how units and uncertainty work in Sounio</a></p>
      </div>
      <div class="journey-list">
        {journeys.map((journey) => (
          <article>
            <h3><a href={journey.href} hreflang={htmlLang(journey.language)}>{journey.title}{journey.language !== locale && <span class="source-language" lang="en">English</span>}</a></h3>
            <p>{journey.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="public-section platform-section" aria-labelledby="platform-title">
    <div class="container platform-layout">
      <div>
        <h2 id="platform-title">{content.platformTitle}</h2>
        <p>{content.linux}</p>
        <p>{content.mac}</p>
        <a class="text-link" href={getLocalizedPath('/learn/getting-started', locale)}>{content.start}</a>
      </div>
      <div class="clone-panel">
        <h3>{content.clone}</h3>
        <pre><code>{cloneCommands}</code></pre>
        <p>{content.cloneNote}</p>
      </div>
    </div>
  </section>

  <section class="public-section" aria-labelledby="evidence-title">
    <div class="container evidence-layout">
      <div class="section-intro">
        <h2 id="evidence-title">{content.evidenceTitle}</h2>
        <p>{content.evidenceBody}</p>
      </div>
      <div>
        <ul class="evidence-links">
          <li><a href={`${repository}/actions`}>{content.checks}</a></li>
          <li><a href={getLocalizedPath('/learn/spec', locale)}>{content.spec}</a></li>
          <li><a href={getLocalizedPath('/learn/feature-status', locale)}>{content.limits}</a></li>
          <li><a href={contribute} hreflang={locale === 'el' ? 'el' : 'en'}>{content.contribute}{locale !== 'el' && locale !== 'en' && <span class="source-language" lang="en">English</span>}</a></li>
        </ul>
        <p class="scope-note">{content.scope}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .public-section { padding: clamp(3rem, 7vw, 6rem) 0; }
  .journey-layout, .evidence-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 6rem); }
  h2 { font-size: clamp(1.9rem, 3.3vw, 3rem); line-height: 1.2; letter-spacing: -.025em; font-weight: 650; text-wrap: balance; max-width: 23ch; }
  h3 { font-size: 1.25rem; line-height: 1.4; font-weight: 650; }
  p { color: var(--color-text-secondary); line-height: 1.8; max-width: 70ch; margin-top: 1rem; }
  .journey-list article { border-top: 1px solid var(--color-border-subtle); padding: 1.5rem 0; }
  .journey-list article:first-child { padding-top: 1rem; }
  .journey-list a, .text-link, .evidence-links a { text-decoration: underline; text-underline-offset: .25em; text-decoration-color: var(--color-accent-gold); }
  .source-language { display: inline-block; font-size: .75rem; margin-inline-start: .6rem; color: var(--color-text-secondary); }
  .platform-section { background: var(--color-surface-secondary); border-block: 1px solid var(--color-border-subtle); }
  .platform-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .text-link { display: inline-block; margin-top: 1.5rem; font-weight: 650; }
  .clone-panel { min-width: 0; }
  pre { margin-top: 1.2rem; padding: 1.5rem; overflow-x: auto; background: #07162c; color: #e3cf96; border-radius: .6rem; font-size: .85rem; line-height: 1.9; }
  .clone-panel p, .scope-note { font-size: .9rem; }
  .evidence-links { display: grid; gap: 1.15rem; font-size: 1.1rem; }
  .scope-note { margin-top: 1.8rem; }
  a:focus-visible { outline: 3px solid var(--color-accent-gold); outline-offset: 5px; }
  @media (max-width: 800px) { .journey-layout, .platform-layout, .evidence-layout { grid-template-columns: minmax(0, 1fr); } }
</style>
