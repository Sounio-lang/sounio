---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import { EpistemicFluidCanvas } from '../components/home/EpistemicFluidCanvas';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import DomainGallery from '../components/home/DomainGallery.astro';
import NumbersSection from '../components/home/NumbersSection.astro';
import { KineticText } from '../components/common/KineticText';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import CodeExamples from '../components/home/CodeExamples';
import { UncertaintyCalculator } from '../components/home/UncertaintyCalculator';
import AnnotatedCode from '../components/home/AnnotatedCode';
import CompilerPipeline from '../components/home/CompilerPipeline';
import NarrativeDemo from '../components/home/NarrativeDemo';
import SounioPlayground from '../components/home/SounioPlayground';
import WebGPUEpistemicDemo from '../components/home/WebGPUEpistemicDemo';
import OmeZarrSection from '../components/home/OmeZarrSection';
import OctonionFanoViz from '../components/home/OctonionFanoViz';
import PBPKRapamycinChart from '../components/home/PBPKRapamycinChart';
import SeizureAssociatorTimeline from '../components/home/SeizureAssociatorTimeline';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="Sounio — A self-hosted systems language for epistemic computing" removeTopPadding={true}>

  {/* ═══════════════════════════════════════════════════════════════
      1 — CINEMATIC HERO
  ═══════════════════════════════════════════════════════════════ */}
  <Hero locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      2 — NARRATIVE DEMO  (pain → failure → fix)
  ═══════════════════════════════════════════════════════════════ */}
  <NarrativeDemo client:load />

  {/* ═══════════════════════════════════════════════════════════════
      3 — EPISTEMIC FLUID CANVAS  (chaos → order particles, 250vh)
  ═══════════════════════════════════════════════════════════════ */}
  <EpistemicFluidCanvas client:load />

  {/* ═══════════════════════════════════════════════════════════════
      3 — THREE HARD FACTS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="Three things that are true" client:visible />
        <p class="section-subhead">Not claims. Artifacts you can read, run, or verify.</p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            The compiler compiles itself.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Sounio is written in Sounio. Starting from a 2,000-line C bootstrap (stage0),
            the chain runs stage0 → gen1 → gen2 → gen3: gen2 and gen3 are byte-for-byte
            identical (md5 = 7b91e249). The fixed-point condition — a compiler that reproduces
            itself exactly — is the strongest available evidence of semantic consistency.
            No hand-maintained binary is in the loop.
          </p>
          <a href={getLocalizedPath('/learn/compiler', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            See the bootstrap chain →
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            A new theorem, proved inside the language.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Among the 7³ = 343 ordered basis triples (eᵢ, eⱼ, eₖ) in the octonions,
            exactly 168 satisfy [eᵢ, eⱼ, eₖ] = (eᵢ·eⱼ)·eₖ − eᵢ·(eⱼ·eₖ) ≠ 0.
            The value 168 equals |PSL(2,7)|, the order of the automorphism group of the
            Fano plane PG(2,2). The result was first verified computationally in Sounio
            using the <code class="text-[var(--color-accent-gold-soft)]">algebra Octonion … reassociate: fano_selective</code> declaration,
            reproduced independently in NumPy, and is under review at
            <em>Advances in Applied Clifford Algebras</em>.
          </p>
          <a href={getLocalizedPath('/proof#theorem-168', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the theorem page →
          </a>
        </article>

        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem] grid gap-[0.7rem]">
          <h3 class="text-[1.1rem] font-[680] text-[var(--color-text-primary)] leading-[1.3]">
            Patient-safety guarantees before any code runs.
          </h3>
          <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Sounio's <code class="text-[var(--color-accent-gold-soft)]">Knowledge&lt;T&gt;</code> type
            carries an epistemic confidence ε ∈ [0, 1] propagated by ISO GUM rules through
            every arithmetic operation. A function declared
            <code class="text-[var(--color-accent-gold-soft)]">where c.ε ≥ 0.82</code>
            for AUC-guided vancomycin dosing will not compile if the measurement supplied
            has ε = 0.71 — not a runtime warning, not a lint, but a type-checker rejection.
            The same mechanism applies to any epistemic threshold in pharmacokinetics,
            clinical trial analysis, or safety-critical sensor fusion.
          </p>
          <a href={getLocalizedPath('/proof#compile-fail-vancomycin', locale)} class="mt-auto text-[0.82rem] text-[var(--color-accent-gold-soft)] hover:underline">
            Read the vancomycin example →
          </a>
        </article>

      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      4 — ANNOTATED CODE  (click-to-explain tokens)
  ═══════════════════════════════════════════════════════════════ */}
  <AnnotatedCode client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      5 — COMPILER PIPELINE  (scroll-animated stages)
  ═══════════════════════════════════════════════════════════════ */}
  <CompilerPipeline client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      6 — CODE EXAMPLES  (tabbed Python vs Sounio)
  ═══════════════════════════════════════════════════════════════ */}
  <CodeExamples client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      5 — IN-BROWSER PLAYGROUND  (WASM shim)
  ═══════════════════════════════════════════════════════════════ */}
  <SounioPlayground client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      6 — UNCERTAINTY CALCULATOR  (live GUM)
  ═══════════════════════════════════════════════════════════════ */}
  <UncertaintyCalculator client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      7 — WEBGPU EPISTEMIC DEMO
  ═══════════════════════════════════════════════════════════════ */}
  <WebGPUEpistemicDemo client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      8 — OME-ZARR VIEWER
  ═══════════════════════════════════════════════════════════════ */}
  <OmeZarrSection client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      9 — OCTONION FANO PLANE  (168 theorem, live)
  ═══════════════════════════════════════════════════════════════ */}
  <OctonionFanoViz client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      10 — PBPK RAPAMYCIN CHART  (GUM through ODE)
  ═══════════════════════════════════════════════════════════════ */}
  <PBPKRapamycinChart client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      11 — SEIZURE ASSOCIATOR TIMELINE
  ═══════════════════════════════════════════════════════════════ */}
  <SeizureAssociatorTimeline client:visible />

  {/* ═══════════════════════════════════════════════════════════════
      12 — FEATURE GRID  (bento)
  ═══════════════════════════════════════════════════════════════ */}
  <FeatureGrid locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      10 — DOMAIN GALLERY
  ═══════════════════════════════════════════════════════════════ */}
  <DomainGallery locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      11 — NUMBERS
  ═══════════════════════════════════════════════════════════════ */}
  <NumbersSection />

  {/* ═══════════════════════════════════════════════════════════════
      12 — HONEST STATUS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="What is true right now" client:visible />
        <p class="section-subhead">
          The anti-slop move: the site admits what does not work before the reader discovers it.
        </p>
      </div>

      <div class="grid gap-[1rem] md:grid-cols-3">

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[var(--color-accent-gold-soft)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">
            Works
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">Epistemic core</strong> — Knowledge&lt;T&gt; generic at compiler level, GUM propagation, dissertation-grade</li>
            <li><strong class="text-[var(--color-text-primary)]">Self-hosted compiler</strong> — fixed-point verified (stage2 == stage3)</li>
            <li><strong class="text-[var(--color-text-primary)]">Algebra</strong> — Clifford, Cayley-Dickson, octonions — verified the 168 theorem</li>
            <li><strong class="text-[var(--color-text-primary)]">Epistemic ODE solver</strong> — PBPK-14 + RK45 + Dormand-Prince; GUM through each step</li>
            <li><strong class="text-[var(--color-text-primary)]">GPU modules</strong> — Clifford, FFT, stats; souc-linux-x86_64-gpu binary ships</li>
            <li><strong class="text-[var(--color-text-primary)]">Closure literals</strong> — |x: i64| x + 1 works; tests/run-pass/closure_basic.sio passes</li>
            <li><strong class="text-[var(--color-text-primary)]">Native codegen</strong> — x86-64 ELF, bit-identical bootstrap chain</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology</strong> — OWL2 model + reasoner, 10K+ local terms, 40 tests passing</li>
            <li><strong class="text-[var(--color-text-primary)]">Optimizer</strong> — 1,000+ e-graph rewrite rules, all FAIL=0</li>
          </ul>
        </article>

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,255,255,0.18)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-text-tertiary)]">
            Scaffolding
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">Theorem prover</strong> — 11,600 lines, search + tactics present; full inference not complete</li>
            <li><strong class="text-[var(--color-text-primary)]">~70% of epistemic modules</strong> — signatures with minimal bodies</li>
            <li><strong class="text-[var(--color-text-primary)]">Neural networks</strong> — quaternion/octonion: compilation errors</li>
            <li><strong class="text-[var(--color-text-primary)]">Genomics</strong> — 11 files are single-line stubs</li>
            <li><strong class="text-[var(--color-text-primary)]">Async runtime</strong> — 12 files (~1–2 KB each); not yet wired into the runtime</li>
            <li><strong class="text-[var(--color-text-primary)]">Geometry engine</strong> — core active (engine.sio 15 KB); extended version disabled</li>
          </ul>
        </article>

        <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,80,80,0.45)]">
          <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[rgba(255,100,100,0.8)]">
            Missing
          </h3>
          <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
            <li><strong class="text-[var(--color-text-primary)]">macOS / AArch64</strong> — cross-compile via `--target aarch64-macos`; native-v2 aarch64 still preview-grade</li>
            <li><strong class="text-[var(--color-text-primary)]">Ontology federation</strong> — local 10K terms; 15M-term federated query not implemented</li>
            <li><strong class="text-[var(--color-text-primary)]">Full stdlib coverage</strong> — 822 / 919 tests pass, 96 skipped; gaps in genomics + async</li>
            <li><strong class="text-[var(--color-text-primary)]">REPL</strong> — not yet supported in native mode</li>
            <li><strong class="text-[var(--color-text-primary)]">Package manager</strong> — no registry or dependency resolution yet</li>
          </ul>
        </article>

      </div>

      <p class="mt-[1.2rem] text-[0.84rem] text-[var(--color-text-tertiary)]">
        <a href="https://github.com/sounio-lang/sounio#honest-status" target="_blank" rel="noopener noreferrer" class="hover:underline text-[var(--color-text-secondary)]">
          Read the full honest status →
        </a>
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      13 — CTA
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_18%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.4rem] max-w-[640px]">
      <KineticText text="Start building today" client:visible />
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.7]">
        Clone the repo, run the examples, push the type system. The self-hosted compiler
        is on Linux x86-64 — no toolchain required.
      </p>
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.9rem] font-mono p-[1rem] overflow-x-auto leading-relaxed"><code>$ git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          Install guide
        </a>
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          See the proof
        </a>
        <a
          href={getLocalizedPath('/language', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          Language tour
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
