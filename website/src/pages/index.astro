---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LiveProof from '../components/home/LiveProof.astro';
import ManifestoPulse from '../components/home/ManifestoPulse.astro';
import WhyNotComparison from '../components/home/WhyNotComparison.astro';
import LivingLanguagePulse from '../components/home/LivingLanguagePulse.astro';
import ProofMoment from '../components/home/ProofMoment.astro';
import NumberAnchor from '../components/home/NumberAnchor.astro';
import DomainGlimpses from '../components/home/DomainGlimpses.astro';
import FlagshipApplications from '../components/home/FlagshipApplications.astro';
import CompilerDepth from '../components/home/CompilerDepth.astro';
import HonestStatusSection from '../components/status/HonestStatusSection.astro';
import KineticText from '../components/ui/KineticText.astro';
import Button from '../components/ui/Button.astro';
import CodePanel from '../components/ui/CodePanel.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';
import { publicContract } from '../data/artifactStatus';

const locale = getLocaleFromUrl(Astro.url);
const trans = await loadTranslations(locale);
const { defaultWorkflow } = publicContract;
---

<BaseLayout title={trans.page_home_title} description={trans.page_home_desc} removeTopPadding={true}>

  {/* 1 — HERO: WebGL2 monument shader over brand art */}
  <Hero locale={locale} />

  {/* 2 — LIVE PROOF: the WASM compiler runs the epistemic chain in-browser */}
  <LiveProof locale={locale} />

  {/* 3 — MANIFESTO */}
  <ManifestoPulse locale={locale} />

  {/* 3.5 — WHY NOT PYTHON / JULIA / RUST */}
  <WhyNotComparison locale={locale} />

  {/* 4 — LIVING LANGUAGE PULSE */}
  <LivingLanguagePulse locale={locale} />

  {/* 5 — PROOF MOMENT */}
  <ProofMoment locale={locale} />

  {/* 6 — THE NUMBER */}
  <NumberAnchor locale={locale} />

  {/* 7 — DOMAIN GLIMPSES */}
  <DomainGlimpses locale={locale} />

  {/* 8 — FLAGSHIP APPLICATIONS */}
  <FlagshipApplications locale={locale} />

  {/* 9 — COMPILER DEPTH */}
  <CompilerDepth locale={locale} />

  {/* 10 — HONEST STATUS */}
  <HonestStatusSection variant="clinical" />

  {/* 11 — ENTER */}
  <section class="section-shell relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_15%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.6rem] max-w-[680px]">
      <div class="flex justify-center mb-2">
        <img src="/assets/sounio-logo.svg" alt="Sounio" class="h-14 w-14 opacity-90" width="56" height="56" />
      </div>
      <KineticText text={trans.home_cta_heading} class="section-heading text-center" />
      <p class="text-[1.05rem] text-[var(--color-ink-2)] max-w-[52ch] leading-[1.7] mx-auto text-center">
        {trans.home_cta_body}
        {defaultWorkflow.summary && <> {defaultWorkflow.summary}</>}
      </p>
      <div class="mx-auto w-full max-w-[520px]">
        <CodePanel code="$ git clone https://github.com/sounio-lang/sounio.git" lang="bash" copy={true} />
      </div>
      <div class="flex flex-wrap justify-center gap-[0.75rem]">
        <Button href={getLocalizedPath('/learn/getting-started', locale)}>{trans.home_cta_install}</Button>
        <Button href={getLocalizedPath('/proof', locale)} variant="ghost">{trans.home_cta_proof}</Button>
        <Button href={getLocalizedPath('/language', locale)} variant="ghost">{trans.home_cta_tour}</Button>
      </div>
    </div>
  </section>

</BaseLayout>
