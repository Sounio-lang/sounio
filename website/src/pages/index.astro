---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);

const capabilityCards = [
  {
    title: 'Epistemic Types',
    body: 'Every value can carry uncertainty, confidence, and provenance directly in the type system.',
    accent: 'var(--color-accent-gold)',
  },
  {
    title: 'Systems Performance',
    body: 'Native backends, GPU kernels, and explicit effects deliver low-level control without trust blind spots.',
    accent: 'var(--color-accent-teal)',
  },
  {
    title: 'Scientific Rigor',
    body: 'Built for domains where correctness is not enough and confidence quality drives real-world decisions.',
    accent: 'var(--color-accent-blue)',
  },
  {
    title: 'Auditability',
    body: 'Traceability and evidence-oriented execution paths make scientific outputs defensible and reproducible.',
    accent: 'var(--color-accent-green)',
  },
];

const domains = [
  { slug: 'pharma', label: 'Pharmacometrics', summary: 'PK/PD pipelines with confidence-aware dosing decisions.' },
  { slug: 'neuroimaging', label: 'Neuroimaging', summary: 'fMRI and signal pipelines with provenance-aware thresholds.' },
  { slug: 'quantum', label: 'Quantum', summary: 'VQE and uncertainty propagation from noisy measurement loops.' },
  { slug: 'climate', label: 'Climate Science', summary: 'Ensemble projections with explicit confidence gates.' },
];
---

<BaseLayout title="">
  <section class="hero section-shell">
    <div class="hero-media" aria-hidden="true">
      <picture class="hero-image hero-a">
        <source
          srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/pappou_hero.png" alt="" loading="eager" decoding="async" />
      </picture>
      <picture class="hero-image hero-b">
        <source
          srcset="/assets/original-artworks/yiayia_hero_1280.webp 1280w, /assets/original-artworks/yiayia_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/yiayia_hero.png" alt="" loading="lazy" decoding="async" />
      </picture>
      <div class="hero-veil"></div>
    </div>

    <div class="container hero-content">
      <span class="badge-pill">SOUNIO V2 • EPISTEMIC COMPUTING</span>
      <h1>Compute at the boundary between certainty and consequence.</h1>
      <p>
        Sounio is a systems programming language for scientific teams that need to reason not only about
        values, but about trust, provenance, and uncertainty at every stage of execution.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/learn/getting-started', locale)} class="hero-cta primary">Start with Docs</a>
        <a href={getLocalizedPath('/playground', locale)} class="hero-cta secondary">Open Playground</a>
      </div>
      <p class="hero-featured"><a href={getLocalizedPath('/docs/vancomycin-uncertainty', locale)}>Featured medical case study: Vancomycin Dosing That Cannot Lie About Uncertainty.</a></p>
      <div class="hero-trust">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" />
        <span>Built for teams shipping high-consequence scientific software.</span>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" aria-hidden="true" class="stamp-divider" loading="lazy" />
      <div class="section-headline">
        <h2 class="section-heading">Why Sounio</h2>
        <p class="section-subhead">
          Modern scientific systems need mechanical sympathy and epistemic honesty in the same language runtime.
        </p>
      </div>
      <div class="premium-grid capability-grid">
        {capabilityCards.map((card) => (
          <article class="capability-card glass glass-specular">
            <h3 style={`--card-accent: ${card.accent}`}>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell section-deep">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Scientific Domains</h2>
        <p class="section-subhead">
          Domain pipelines where confidence and traceability can change outcomes.
        </p>
      </div>
      <div class="premium-grid domain-grid">
        {domains.map((domain) => (
          <a href={getLocalizedPath(`/science/${domain.slug}`, locale)} class="domain-card glass glass-elevated">
            <h3>{domain.label}</h3>
            <p>{domain.summary}</p>
            <span>Explore domain</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container heritage-grid">
      <article class="glass glass-specular heritage-copy">
        <h2 class="section-heading">Built For High-Consequence Scientific Systems</h2>
        <p class="section-subhead">
          Sounio combines low-level systems control with explicit uncertainty and provenance semantics, so teams can ship
          faster without sacrificing auditability.
        </p>
      </article>
      <article class="glass heritage-image">
        <picture>
          <source
            srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
            sizes="(min-width: 980px) 42vw, 94vw"
            type="image/webp"
          />
          <img src="/assets/original-artworks/pappou_hero.png" alt="Sounio visual identity artwork" loading="lazy" decoding="async" />
        </picture>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container trust-grid">
      <article class="trust-panel glass glass-specular">
        <h2 class="section-heading">Verification Layer</h2>
        <p>
          Official identity assets anchor the trust model across docs, platform surfaces, and release channels, so users
          can verify they are reading canonical Sounio materials.
        </p>
        <img
          src="/assets/emblem/emblem_badge_textperfect_optionC.svg"
          alt="Sounio Language emblem badge"
          class="emblem-badge"
          loading="lazy"
          decoding="async"
        />
      </article>
      <article class="metrics-panel glass">
        <h3>Current Platform Depth</h3>
        <ul>
          <li><strong>627K+</strong><span>Language + runtime lines</span></li>
          <li><strong>236K+</strong><span>Standard library footprint</span></li>
          <li><strong>15M+</strong><span>Ontology entities integrated</span></li>
          <li><strong>6</strong><span>Locale routes supported</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container closing-shell glass glass-elevated">
      <h2 class="section-heading">Ship scientific software that explains itself.</h2>
      <p class="section-subhead">
        Build systems where every number can be questioned, traced, and trusted before it reaches a decision.
      </p>
      <div class="closing-actions">
        <a href={getLocalizedPath('/learn', locale)} class="hero-cta primary">Enter the Learning Hub</a>
        <a href="https://github.com/sounio-lang/sounio" class="hero-cta secondary" target="_blank" rel="noopener noreferrer">
          Explore on GitHub
        </a>
      </div>
      <pre><code>curl -sSf https://souniolang.org/install.sh | sh</code></pre>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: min(900px, 94vh);
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-a {
    animation: filmFade 14s linear infinite;
  }

  .hero-b {
    opacity: 0;
    animation: filmFade 14s linear infinite reverse;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1000px 440px at 82% 20%, rgba(214, 179, 90, 0.26), transparent 62%),
      linear-gradient(120deg, rgba(7, 22, 44, 0.87), rgba(7, 22, 44, 0.55) 45%, rgba(7, 22, 44, 0.92));
  }

  .hero-content {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 1.15rem;
    max-width: 690px;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 5rem);
    text-wrap: balance;
  }

  .hero p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.28rem);
    max-width: 56ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: var(--radius-full);
    padding: 0.7rem 1.2rem;
    font-size: 0.92rem;
    font-weight: 650;
    transition: transform var(--transition-base), background var(--transition-base), color var(--transition-base);
  }

  .hero-cta.primary {
    background: linear-gradient(120deg, var(--color-accent-gold), var(--color-accent-gold-soft));
    color: #10233e;
  }

  .hero-cta.secondary {
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-primary);
  }

  .hero-cta:hover {
    transform: translateY(-1px);
  }

  .hero-trust {
    margin-top: 0.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text-tertiary);
    font-size: 0.84rem;
  }

  .hero-trust img {
    width: 32px;
    height: 32px;
    opacity: 0.8;
  }

  .section-headline {
    margin-bottom: 1.7rem;
    display: grid;
    gap: 0.45rem;
  }

  .capability-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .capability-card {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }

  .capability-card h3 {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    position: relative;
  }

  .capability-card h3::after {
    content: '';
    display: block;
    width: 48px;
    height: 2px;
    margin-top: 0.45rem;
    border-radius: var(--radius-full);
    background: var(--card-accent);
  }

  .capability-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .section-deep {
    background: color-mix(in srgb, var(--color-bg-alt) 74%, transparent);
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .domain-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .domain-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.56rem;
    color: var(--color-text-primary);
  }

  .domain-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .domain-card span {
    margin-top: 0.25rem;
    color: var(--color-accent-gold-soft);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .trust-grid {
    display: grid;
    gap: 1rem;
  }

  .heritage-grid {
    display: grid;
    gap: 0.95rem;
    align-items: stretch;
  }

  .heritage-copy,
  .heritage-image {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  .heritage-image img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    object-position: center;
  }

  .trust-panel,
  .metrics-panel {
    border-radius: var(--radius-xl);
    padding: 1.2rem;
  }

  .trust-panel p {
    margin-top: 0.6rem;
    color: var(--color-text-secondary);
    max-width: 55ch;
  }

  .emblem-badge {
    margin-top: 1rem;
    width: min(240px, 62vw);
    height: auto;
    display: block;
    border-radius: 50%;
    box-shadow: var(--shadow-md);
  }

  .metrics-panel h3 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .metrics-panel ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .metrics-panel li {
    display: grid;
    gap: 0.18rem;
  }

  .metrics-panel strong {
    font-size: 1.45rem;
    color: var(--color-text-primary);
  }

  .metrics-panel span {
    font-size: 0.84rem;
    color: var(--color-text-secondary);
  }

  .closing-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1.1rem, 4vw, 2rem);
    display: grid;
    gap: 1rem;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  @media (min-width: 960px) {
    .heritage-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    }

    .trust-grid {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }
  }
</style>
