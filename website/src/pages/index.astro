---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CinematicHero } from '../components/home/CinematicHero';
import { ScrollStorySection } from '../components/home/ScrollStorySection';
import { EpistemicFluidCanvas } from '../components/home/EpistemicFluidCanvas';
import { KineticText } from '../components/common/KineticText';
import { CustomCursor } from '../components/common/CustomCursor';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import { ComparisonMatrix } from '../components/home/ComparisonMatrix';
import { Picture } from 'astro:assets';
import pappouHero from '../../public/assets/original-artworks/pappou_hero.png';

const locale = getLocaleFromUrl(Astro.url);

const capabilityCards = [
  {
    title: 'Epistemic Core',
    body: 'Confidence-aware types such as Knowledge<T> are exercised through canonical check fixtures, including compile-time refusal cases.',
    accent: 'var(--color-accent-gold)',
  },
  {
    title: 'Check-First Workflow',
    body: 'The most trustworthy repo path today is souc check over canonical fixtures and gate-backed stdlib lanes, with runtime claims scoped by artifact evidence.',
    accent: 'var(--color-accent-teal)',
  },
  {
    title: 'Self-Hosted Stack',
    body: 'The repository includes a self-hosted compiler tree, SOIR serialization, and the Poseidon bootstrap VM used to track the rustless cutover.',
    accent: 'var(--color-accent-blue)',
  },
  {
    title: 'Gate-Tracked Stdlib',
    body: 'Repo artifacts track which stdlib lanes are callable today, which remain stub surfaces, and which are still disabled.',
    accent: 'var(--color-accent-green)',
  },
];

const domains = [
  { slug: 'pharma', label: 'Pharmacometrics', summary: 'PK/PD pipelines with confidence-aware dosing decisions.' },
  { slug: 'neuroimaging', label: 'Neuroimaging', summary: 'fMRI and signal pipelines with provenance-aware thresholds.' },
  { slug: 'quantum', label: 'Quantum', summary: 'VQE and uncertainty propagation from noisy measurement loops.' },
  { slug: 'climate', label: 'Climate Science', summary: 'Ensemble projections with explicit confidence gates.' },
];
---

<BaseLayout title="" removeTopPadding={true}>
  <CustomCursor client:idle />
  
  <CinematicHero localePath={(path) => getLocalizedPath(path, locale)} client:load />

  <ScrollStorySection client:visible />
  
  <EpistemicFluidCanvas client:idle />

  <section class="section-shell">
    <div class="container">
      <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" aria-hidden="true" class="stamp-divider" width="64" height="64" loading="lazy" />
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="Why Sounio" client:visible />
        <p class="section-subhead">
          The value proposition is still the same, but the current public contract is narrower than the older marketing copy.
        </p>
      </div>
      <div class="premium-grid grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
        {capabilityCards.map((card) => (
          <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.15rem] grid gap-[0.55rem]">
            <h3 style={`--card-accent: ${card.accent}`} class="text-[1.25rem] text-[var(--color-text-primary)] relative after:content-[''] after:block after:w-[48px] after:h-[2px] after:mt-[0.45rem] after:rounded-full after:bg-[var(--card-accent)]">{card.title}</h3>
            <p class="text-[var(--color-text-secondary)] text-[0.95rem]">{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="The Sounio Difference" client:visible />
        <p class="section-subhead">
          The current repository focus is explicit uncertainty, auditable semantics, and evidence that lives next to the code.
        </p>
      </div>
      <ComparisonMatrix client:idle />
    </div>
  </section>

  <section class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container">
      <div class="mb-[1.7rem] grid gap-[0.45rem]">
        <KineticText text="Scientific Domains" client:visible />
        <p class="section-subhead">
          These are the domains with real code and artifacts in-tree, though not every lane is equally mature.
        </p>
      </div>
      <div class="premium-grid grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))]">
        {domains.map((domain) => (
          <a href={getLocalizedPath(`/science/${domain.slug}`, locale)} class="glass glass-elevated rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.56rem] text-[var(--color-text-primary)]">
            <h3 class="text-lg font-semibold">{domain.label}</h3>
            <p class="text-[var(--color-text-secondary)] text-[0.92rem]">{domain.summary}</p>
            <span class="mt-[0.25rem] text-[var(--color-accent-gold-soft)] text-[0.82rem] uppercase tracking-[0.08em]">Explore domain</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container grid gap-[0.95rem] items-stretch lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)]">
      <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem]">
        <KineticText text="Built For High-Consequence Scientific Systems" client:visible />
        <p class="section-subhead">
          Sounio is strongest where teams need to prove what a program checked, what was only sketched, and which outputs are backed by reproducible gate artifacts.
        </p>
      </article>
      <article class="glass rounded-[var(--radius-xl)] p-[1.1rem]">
        <Picture
          src={pappouHero}
          alt="Sounio visual identity artwork"
          class="rounded-[var(--radius-lg)] w-full h-full min-h-[260px] object-cover object-center"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container grid gap-4 lg:grid-cols-[1.25fr_1fr] lg:items-stretch">
      <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.2rem]">
        <KineticText text="Verification Layer" client:visible />
        <p class="mt-[0.6rem] text-[var(--color-text-secondary)] max-w-[55ch]">
          Official identity assets anchor the trust model across docs, platform surfaces, and release channels, so users
          can verify they are reading canonical Sounio materials.
        </p>
        <img
          src="/assets/emblem/emblem_badge_textperfect_optionC.svg"
          alt="Sounio Language emblem badge"
          class="mt-4 w-[min(240px,62vw)] h-auto block rounded-full shadow-[var(--shadow-md)]"
          width="240"
          height="240"
          loading="lazy"
          decoding="async"
        />
      </article>
      <article class="glass rounded-[var(--radius-xl)] p-[1.2rem]">
        <h3 class="font-sans text-[0.95rem] font-[650] tracking-[0.08em] uppercase text-[var(--color-text-tertiary)]">Current Verified Snapshot</h3>
        <ul class="mt-[0.9rem] p-0 list-none grid gap-[0.8rem]">
          <li class="grid gap-[0.18rem]"><strong class="text-[1.45rem] text-[var(--color-text-primary)]">81 / 82</strong><span class="text-[0.84rem] text-[var(--color-text-secondary)]">Stdlib reliability fixtures passing</span></li>
          <li class="grid gap-[0.18rem]"><strong class="text-[1.45rem] text-[var(--color-text-primary)]">92</strong><span class="text-[0.84rem] text-[var(--color-text-secondary)]">Active stdlib module entrypoints</span></li>
          <li class="grid gap-[0.18rem]"><strong class="text-[1.45rem] text-[var(--color-text-primary)]">2</strong><span class="text-[0.84rem] text-[var(--color-text-secondary)]">Real science lanes passing today</span></li>
          <li class="grid gap-[0.18rem]"><strong class="text-[1.45rem] text-[var(--color-text-primary)]">7</strong><span class="text-[0.84rem] text-[var(--color-text-secondary)]">Required hyper lanes passing</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container glass glass-elevated rounded-[var(--radius-2xl)] p-[clamp(1.1rem,4vw,2rem)] grid gap-4">
      <KineticText text="Ship scientific software that explains itself." client:visible />
      <p class="section-subhead">
        Start with the parts of Sounio that are already verified, then expand into the self-hosted and domain-specific lanes with the gate artifacts in hand.
      </p>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a href={getLocalizedPath('/learn', locale)} class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]">Enter the Learning Hub</a>
        <a href="https://github.com/sounio-lang/sounio" class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]" target="_blank" rel="noopener noreferrer">
          Explore on GitHub
        </a>
      </div>
      <pre><code>export SOUC_BIN=artifacts/omega/souc-bin/souc-linux-x86_64-jit
export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
$SOUC_BIN check examples/hello.sio</code></pre>
    </div>
  </section>
</BaseLayout>
