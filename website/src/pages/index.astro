---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import CodeExamples from '../components/home/CodeExamples';
import { getLocaleFromUrl, loadTranslations } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

// Use case cards data
const useCases = [
  {
    title: 'Pharmacometrics',
    description: 'PK/PD modeling with MedLang for drug dosage optimization and clinical trial design with rigorous uncertainty handling.',
    icon: '💊',
    href: '/showcases/pharma',
  },
  {
    title: 'Neuroimaging',
    description: 'fMRI pipeline analysis with confidence-gated processing and provenance tracking for reproducible neuroscience.',
    icon: '🧠',
    href: '/showcases/neuroimaging',
  },
  {
    title: 'Quantum Chemistry',
    description: 'VQE algorithms with uncertainty quantification for variational quantum eigensolver implementations.',
    icon: '⚛️',
    href: '/showcases/quantum',
  },
  {
    title: 'Climate Science',
    description: 'Climate modeling with uncertainty propagation for robust predictions and policy-relevant confidence intervals.',
    icon: '🌍',
    href: '/showcases/climate',
  },
  {
    title: 'Causal Inference',
    description: 'Bayesian networks with epistemic types for causal discovery and treatment effect estimation with uncertainty.',
    icon: '🔀',
    href: '/showcases/causal',
  },
  {
    title: 'GPU Computing',
    description: 'Physics simulations with native GPU kernels, high-performance computing without leaving the language.',
    icon: '🚀',
    href: '/showcases/gpu',
  },
];

// Maturity items
const maturityItems = {
  stable: [
    'Epistemic types (Knowledge<T>)',
    'GPU kernels (PTX, SPIR-V)',
    'Effect system (IO, Mut, Alloc)',
    'Units of measure (mg, L, h)',
    'Linear type checking',
  ],
  experimental: [
    'Module system (use statements)',
    'Package manager',
    'Refinement types (Z3 backend)',
  ],
  inProgress: [
    'LSP server (language features)',
    'WebAssembly backend',
    'Documentation generator',
  ],
};
---

<BaseLayout title="">
  <Hero locale={locale} />
  <FeatureGrid locale={locale} />
  <CodeExamples client:visible />

  <!-- Use Cases Section -->
  <section id="use-cases" class="py-24 bg-[var(--color-bg-alt)]">
    <div class="container">
      <h2 class="text-4xl font-semibold text-center mb-4 text-[var(--color-navy-900)] dark:text-white">
        {t.usecases_title}
      </h2>
      <p class="text-lg text-center text-[var(--color-text-muted)] mb-16 max-w-3xl mx-auto">
        {t.usecases_description}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {useCases.map((useCase) => (
          <a
            href={useCase.href}
            class="group block p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all duration-300 border border-transparent hover:border-[var(--color-gold-500)]"
          >
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">
              {useCase.icon}
            </div>
            <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)] transition-colors">
              {useCase.title}
            </h3>
            <p class="text-[var(--color-text-muted)] text-sm leading-relaxed mb-4">
              {useCase.description}
            </p>
            <span class="text-[var(--color-orange-500)] font-medium text-sm group-hover:underline">
              {t.usecase_learn_more}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Maturity Section -->
  <section id="maturity" class="py-24">
    <div class="container">
      <h2 class="text-4xl font-semibold text-center mb-4 text-[var(--color-navy-900)] dark:text-white">
        {t.maturity_title}
      </h2>
      <p class="text-lg text-center text-[var(--color-text-muted)] mb-16 max-w-3xl mx-auto">
        {t.maturity_description}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Stable -->
        <div>
          <h3 class="flex items-center gap-2 text-lg font-semibold text-green-600 dark:text-green-400 mb-4">
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
            {t.maturity_stable_label}
          </h3>
          <ul class="space-y-2">
            {maturityItems.stable.map((item) => (
              <li class="p-3 bg-white dark:bg-[var(--color-bg-alt)] rounded-lg border-l-4 border-green-500 shadow-sm">
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Experimental -->
        <div>
          <h3 class="flex items-center gap-2 text-lg font-semibold text-amber-600 dark:text-amber-400 mb-4">
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            {t.maturity_experimental_label}
          </h3>
          <ul class="space-y-2">
            {maturityItems.experimental.map((item) => (
              <li class="p-3 bg-white dark:bg-[var(--color-bg-alt)] rounded-lg border-l-4 border-amber-500 shadow-sm">
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- In Progress -->
        <div>
          <h3 class="flex items-center gap-2 text-lg font-semibold text-indigo-600 dark:text-indigo-400 mb-4">
            <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
            {t.maturity_inprogress_label}
          </h3>
          <ul class="space-y-2">
            {maturityItems.inProgress.map((item) => (
              <li class="p-3 bg-white dark:bg-[var(--color-bg-alt)] rounded-lg border-l-4 border-indigo-500 shadow-sm">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Documentation Section -->
  <section id="docs" class="py-24 bg-[var(--color-bg-alt)]">
    <div class="container">
      <h2 class="text-4xl font-semibold text-center mb-4 text-[var(--color-navy-900)] dark:text-white">
        {t.docs_title}
      </h2>
      <p class="text-lg text-center text-[var(--color-text-muted)] mb-16 max-w-3xl mx-auto">
        {t.docs_description}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/docs/getting-started" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-gold-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            {t.docs_getting_started}
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            {t.docs_getting_started_desc}
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            {t.docs_explore}
          </span>
        </a>

        <a href="/docs/language" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-gold-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            {t.docs_language_guide}
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            {t.docs_language_guide_desc}
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            {t.docs_explore}
          </span>
        </a>

        <a href="/docs/stdlib" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-gold-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            {t.docs_stdlib}
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            {t.docs_stdlib_desc}
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            {t.docs_explore}
          </span>
        </a>

        <a href="/docs/examples" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-gold-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            {t.docs_examples}
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            {t.docs_examples_desc}
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            {t.docs_explore}
          </span>
        </a>

        <a href="/playground" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-orange-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            Interactive Playground
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            Write, compile, and run Sounio code directly in your browser.
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            Try Now →
          </span>
        </a>

        <a href="/blog" class="group p-6 bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-orange-500)]">
          <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)]">
            Blog & Updates
          </h3>
          <p class="text-[var(--color-text-muted)] text-sm mb-4">
            Latest news, tutorials, and insights from the Sounio team.
          </p>
          <span class="text-[var(--color-orange-500)] font-medium text-sm">
            Read More →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- The Name Section -->
  <section class="py-24 bg-gradient-to-br from-[var(--color-navy-900)] to-[var(--color-navy-800)] text-white">
    <div class="container max-w-4xl text-center">
      <h2 class="text-4xl font-semibold mb-8">
        {t.name_title}
      </h2>
      <p class="text-xl leading-relaxed text-white/90 mb-6">
        {t.name_description}
      </p>
      <p class="text-lg text-[var(--color-gold-500)] italic">
        {t.name_meaning}
      </p>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="container max-w-2xl text-center">
      <h2 class="text-3xl font-semibold mb-4 text-[var(--color-navy-900)] dark:text-white">
        {t.newsletter_title}
      </h2>
      <p class="text-[var(--color-text-muted)] mb-8">
        {t.newsletter_description}
      </p>
      <form class="flex flex-col sm:flex-row gap-3 justify-center">
        <input
          type="email"
          placeholder={t.newsletter_placeholder}
          class="px-4 py-3 rounded-lg border border-[var(--color-border)] bg-white dark:bg-[var(--color-bg-alt)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold-500)] flex-1 max-w-md"
          required
        />
        <button
          type="submit"
          class="px-6 py-3 bg-[var(--color-navy-900)] text-white rounded-lg font-semibold hover:bg-[var(--color-navy-800)] transition-colors"
        >
          {t.newsletter_button}
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
