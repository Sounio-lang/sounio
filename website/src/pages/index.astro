---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ManifestoPulse from '../components/home/ManifestoPulse.astro';
import SystemAtlas from '../components/home/SystemAtlas.astro';
import PowerAtlas from '../components/home/PowerAtlas.astro';
import ProofMoment from '../components/home/ProofMoment.astro';
import NumberAnchor from '../components/home/NumberAnchor.astro';
import ParticleLoom from '../components/home/ParticleLoom';
import SounioObservatory from '../components/home/SounioObservatory.astro';
import SemanticBorder from '../components/home/SemanticBorder';
import InstrumentCorridor from '../components/home/InstrumentCorridor.astro';
import AutodiffInstrument from '../components/home/AutodiffInstrument';
import BayesianObservationInstrument from '../components/home/BayesianObservationInstrument';
import ZeroProvenanceInstrument from '../components/home/ZeroProvenanceInstrument';
import EffectBoundaryInstrument from '../components/home/EffectBoundaryInstrument';
import BorrowCustodyInstrument from '../components/home/BorrowCustodyInstrument';
import CompilerDepth from '../components/home/CompilerDepth.astro';
import HonestStatusSection from '../components/status/HonestStatusSection.astro';
import { KineticText } from '../components/common/KineticText';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';
import { publicContract } from '../data/artifactStatus';

const locale = getLocaleFromUrl(Astro.url);
const trans = await loadTranslations(locale);
const { defaultWorkflow } = publicContract;

const cta = {
  en: {
    heading: 'Enter the language.',
    body: 'Clone the repo. Run the self-hosted compiler. Read the proof surfaces.',
    install: 'Install guide',
    proof: 'See the proof',
    tour: 'Language tour',
  },
  pt: {
    heading: 'Entre na linguagem.',
    body: 'Clone o repositório. Execute o compilador self-hosted. Leia as superfícies de prova.',
    install: 'Guia de instalação',
    proof: 'Ver as provas',
    tour: 'Tour da linguagem',
  },
  es: {
    heading: 'Entre en el lenguaje.',
    body: 'Clone el repositorio. Ejecute el compilador self-hosted. Lea las superficies de prueba.',
    install: 'Guía de instalación',
    proof: 'Ver las pruebas',
    tour: 'Tour del lenguaje',
  },
  el: {
    heading: 'Εισέλθετε στη γλώσσα.',
    body: 'Κάντε clone το repo. Τρέξτε τον self-hosted compiler. Διαβάστε τις επιφάνειες απόδειξης.',
    install: 'Οδηγός εγκατάστασης',
    proof: 'Δείτε την απόδειξη',
    tour: 'Περιήγηση στη γλώσσα',
  },
  zh: { heading: '进入语言。', body: '克隆仓库。运行自托管编译器。阅读证明界面。', install: '安装指南', proof: '查看证明', tour: '语言导览' },
  'zh-hk': { heading: '開始使用呢種語言。', body: '複製倉庫。執行自託管編譯器。閱讀證明介面。', install: '安裝指南', proof: '查看證明', tour: '語言導覽' },
  ja: { heading: '言語に入る。', body: 'リポジトリをクローン。セルフホストコンパイラを実行。証明サーフェスを読む。', install: 'インストールガイド', proof: '証明を見る', tour: '言語ツアー' },
};

const d = cta[locale] ?? cta.en;
---

<BaseLayout title={trans.page_home_title} description={trans.page_home_desc} removeTopPadding={true}>

  {/* I — Identity and first proof */}
  <Hero locale={locale} />
  <ManifestoPulse locale={locale} />
  <ProofMoment locale={locale} />
  <NumberAnchor locale={locale} />

  {/* II — Twin flagships: exact algebra, then executable images */}
  <ParticleLoom locale={locale} client:visible />
  <SounioObservatory locale={locale} />

  {/* III — Semantic boundary, then secondary language instruments */}
  <SemanticBorder locale={locale} client:visible />
  <InstrumentCorridor locale={locale} />
  <AutodiffInstrument locale={locale} client:visible />
  <BayesianObservationInstrument locale={locale} client:visible />
  <ZeroProvenanceInstrument locale={locale} client:visible />
  <EffectBoundaryInstrument locale={locale} client:visible />
  <BorrowCustodyInstrument locale={locale} client:visible />

  {/* IV — System depth and honest status */}
  <SystemAtlas locale={locale} />
  <CompilerDepth locale={locale} />
  <PowerAtlas locale={locale} />
  <HonestStatusSection variant="clinical" />

  {/* V — Enter */}
  <section class="section-shell relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,color-mix(in_srgb,var(--color-accent-gold)_15%,transparent),transparent)]"></div>
    </div>
    <div class="container relative grid gap-[1.4rem] max-w-[640px]">
      <KineticText text={d.heading} client:visible />
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[52ch] leading-[1.7]">
        {d.body}
        {defaultWorkflow.summary && <> {defaultWorkflow.summary}</>}
      </p>
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-xs sm:text-sm font-mono p-[1rem] overflow-x-auto leading-relaxed max-w-full no-scrollbar"><code>$ git clone https://github.com/sounio-lang/sounio.git</code></pre>
      <div class="flex flex-wrap gap-[0.65rem]">
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          {d.install}
        </a>
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.proof}
        </a>
        <a
          href={getLocalizedPath('/language', locale)}
          class="inline-flex items-center justify-center rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          {d.tour}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
