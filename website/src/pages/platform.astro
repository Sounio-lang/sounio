---
import BaseLayout from '../layouts/BaseLayout.astro';
import RuntimeArchitecture from '../components/diagrams/RuntimeArchitecture.astro';
import ChallengeSolver from '../components/platform/ChallengeSolver';
import MedicalShowcase from '../components/medical/MedicalShowcase';
import { OntologyAutocomplete } from '../components/platform/OntologyAutocomplete';
import { ProverStatusBadge } from '../components/platform/ProverStatusBadge';
import { LogicConflictTracePanel } from '../components/platform/LogicConflictTracePanel';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);

const layers = [
  {
    title: 'Compiler Core',
    body: 'Type inference, refinement checks, and effect analysis across large scientific codebases.',
  },
  {
    title: 'Native Backends',
    body: 'AArch64/x86 targets with predictable performance and explicit control over code generation.',
  },
  {
    title: 'GPU Runtime',
    body: 'Kernel syntax integrated into the language with backend bridges for accelerated workflows.',
  },
  {
    title: 'Toolchain + LSP',
    body: 'CLI, docs, package workflows, and editor tooling tuned for scientific programming teams.',
  },
];

const commandBlocks = [
  'souc check models/pbpk_trial.sio',
  'souc run studies/uncertainty_pipeline.sio',
  'souc test --confidence-gates',
];
---

<BaseLayout title="Platform" description="Sounio compiler and runtime platform architecture">
  <section class="section-shell platform-hero">
    <div class="container platform-inner">
      <span class="badge-pill">Platform</span>
      <h1>From language semantics to runtime evidence, one integrated platform.</h1>
      <p>
        Sounio combines a scientific type system with systems-level execution so teams can move from model logic
        to production-grade pipelines without dropping uncertainty metadata.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/learn/compiler', locale)} class="hero-cta primary">Explore Compiler Docs</a>
        <a href={getLocalizedPath('/packages', locale)} class="hero-cta secondary">Browse Packages</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Platform Layers</h2>
        <p class="section-subhead">Each layer is optimized for scientific reliability without sacrificing throughput.</p>
      </div>
      <div class="layer-grid premium-grid">
        {layers.map((layer) => (
          <article class="layer-card glass glass-specular">
            <h3>{layer.title}</h3>
            <p>{layer.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Compilation Pipeline</h2>
        <p class="section-subhead">Every source program passes through type checking, effect analysis, and code generation before reaching a target backend.</p>
      </div>
      <RuntimeArchitecture />
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Ontology Resolution Experience</h2>
        <p class="section-subhead">Instantly bind 15M+ scientific terms into type-safe language constructs.</p>
      </div>
      <div class="p-8 glass glass-elevated rounded-3xl mt-8">
        <OntologyAutocomplete client:load />
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Automated Prover Feedback</h2>
        <p class="section-subhead">Visualizing the Z3-backed SMT solver continuously verifying refinement types.</p>
      </div>
      <div class="mt-8 max-w-3xl mx-auto">
        <ProverStatusBadge client:load />
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Actionable Error Traceability</h2>
        <p class="section-subhead">Clear provenance and explanations when formal models clash.</p>
      </div>
      <div class="mt-8 max-w-4xl mx-auto">
        <LogicConflictTracePanel client:load />
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Grand Challenges</h2>
        <p class="section-subhead">Using formal verification to solve the most difficult scientific problems.</p>
      </div>
      <ChallengeSolver client:load />
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Medical Verification Showcase</h2>
        <p class="section-subhead">Clinical safety guarantees through formal methods and bounded uncertainty.</p>
      </div>
      <MedicalShowcase client:load />
    </div>
  </section>

  <section class="section-shell">
    <div class="container command-shell glass glass-elevated">
      <h2 class="section-heading">Operational Workflow</h2>
      <p class="section-subhead">Common commands teams use to validate and ship confidence-aware systems.</p>
      <div class="command-list">
        {commandBlocks.map((line) => (
          <pre><code>$ {line}</code></pre>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .platform-inner {
    max-width: 760px;
    display: grid;
    gap: 1rem;
  }

  .platform-inner h1 {
    font-size: clamp(2.2rem, 5.7vw, 4.4rem);
  }

  .platform-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.17rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .layer-grid {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .layer-card {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }

  .layer-card h3 {
    font-size: 1.16rem;
  }

  .layer-card p {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
  }

  .command-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1.1rem, 4vw, 2rem);
    display: grid;
    gap: 0.95rem;
  }

  .command-list {
    display: grid;
    gap: 0.7rem;
  }
</style>
