---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const domains = [
  {
    id: 'pharmacokinetics',
    title: t.explore_domain_pk_title || 'Pharmacokinetics',
    description: t.explore_domain_pk_desc || 'ISO GUM uncertainty propagation for AUC, Cmax, and clearance models.',
    icon: '💊',
    color: 'var(--color-accent-teal)',
    slug: 'science/pharma'
  },
  {
    id: 'epistemic',
    title: t.explore_domain_epistemic_title || 'Epistemic Logic',
    description: t.explore_domain_epistemic_desc || 'First-class Knowledge<T> types with confidence thresholds.',
    icon: '🧠',
    color: 'var(--color-accent-gold)',
    slug: 'learn/epistemic'
  },
  {
    id: 'octonions',
    title: t.explore_domain_octonions_title || 'Octonion Algebra',
    description: t.explore_domain_octonions_desc || 'Computational proof of the 168 Fano plane automorphisms.',
    icon: '∈',
    color: 'var(--color-accent-purple)',
    slug: 'proof#theorem-168'
  },
  {
    id: 'compiler',
    title: t.explore_domain_compiler_title || 'Self-Hosting',
    description: t.explore_domain_compiler_desc || 'A compiler that compiles itself, proving semantic consistency.',
    icon: '⚙️',
    color: 'var(--color-accent-blue)',
    slug: 'learn/compiler'
  },
  {
    id: 'climate',
    title: t.explore_domain_climate_title || 'Climate Models',
    description: t.explore_domain_climate_desc || 'Fractional calculus for long-memory climate simulations.',
    icon: '🌍',
    color: 'var(--color-accent-green)',
    slug: 'science/climate'
  },
  {
    id: 'gpu',
    title: t.explore_domain_gpu_title || 'GPU Acceleration',
    description: t.explore_domain_gpu_desc || 'Native PTX emission for massively parallel tensor operations.',
    icon: '⚡',
    color: 'var(--color-accent-orange)',
    slug: 'learn/gpu'
  }
];
---

<BaseLayout title={t.nav_explore || "Explore Sounio"} description={t.page_explore_desc || t.seo_default_description}>
  <div class="pt-32 pb-24 min-h-screen bg-[#020617]">
    <div class="container">
      <header class="mb-16 md:mb-24">
        <h1 class="font-display text-5xl md:text-7xl font-medium tracking-tight mb-6" style="view-transition-name: explore-title" set:html={t.explore_title}></h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl font-sans font-light">
          {t.explore_subtitle}
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {domains.map((domain) => (
          <a 
            href={getLocalizedPath(`/${domain.slug}`, locale)}
            class="group relative block h-80 rounded-2xl overflow-hidden bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.05)] hover:border-[rgba(255,255,255,0.2)] transition-all duration-500"
            style={`view-transition-name: card-${domain.id}`}
          >
            <div class="absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity duration-500" style={`background-color: ${domain.color}`}></div>
            
            <div class="relative h-full p-8 flex flex-col">
              <div class="text-4xl mb-auto opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500 origin-left">
                {domain.icon}
              </div>
              
              <div>
                <h2 class="font-display text-2xl font-medium mb-3 group-hover:text-white transition-colors" style={`color: ${domain.color}`}>
                  {domain.title}
                </h2>
                <p class="text-[var(--color-text-secondary)] font-sans text-sm leading-relaxed">
                  {domain.description}
                </p>
              </div>
            </div>
            
            {/* "Punch card" dots decoration */}
            <div class="absolute top-4 right-4 flex gap-1 opacity-20">
              <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>