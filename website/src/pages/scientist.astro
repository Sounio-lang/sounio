---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptWorkbench from '../components/scientist/PromptWorkbench.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';
import { createHash } from 'node:crypto';
import catalog from '../data/scientistWorkflows.json';
import translations from '../data/scientistCopy.json';
import prepared from '../data/scientistContexts.json';

const locale = getLocaleFromUrl(Astro.url);
const language = locale === 'pt' || locale === 'el' ? locale : 'en';
const copy = translations[language];
if (prepared.catalog_sha256 !== createHash('sha256').update(JSON.stringify(catalog)).digest('hex')) throw new Error('Scientist context is stale; run node website/scripts/sync-scientist-context.mjs');
const contexts = prepared.contexts[language];
const suffix = language === 'en' ? '' : `_${language.toUpperCase()}`;
const guide = language === 'en' ? 'README.md' : `README.${language}.md`;
---

<BaseLayout title={`Sounio — ${copy.title}`} description={copy.intro}>
  <div class="scientist-page" lang={language}>
    <header class="scientist-intro">
      <a class="back-link" href={getLocalizedPath('/', locale)}>{copy.back}</a>
      <h1>{copy.title}</h1>
      <p class="intro">{copy.intro}</p>
      <p class="execution-boundary">{copy.boundary}</p>
      {language !== locale && <p class="language-fallback" lang="en">{translations.en.fallback}</p>}
    </header>
    <PromptWorkbench catalog={catalog} language={language} copy={copy} contexts={contexts} />
    <footer class="scientist-resources">
      <a href={`https://github.com/Sounio-lang/sounio/blob/main/docs/scientist/${guide}`}>{copy.guide}</a>
      <a href={`https://github.com/Sounio-lang/sounio/blob/main/docs/guide/LLM_PROGRAMMING_GUIDE${suffix}.md`}>{copy.manual}</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .scientist-page { max-width: 1240px; margin: 0 auto; padding: clamp(2rem, 6vw, 5rem) 1.5rem 4rem; }
  .scientist-intro { margin-bottom: 3.5rem; max-width: 850px; }
  .back-link { display: inline-block; color: var(--color-text-muted); font-size: .85rem; margin-bottom: 2rem; }
  h1 { font-size: clamp(2.5rem, 5.8vw, 4.6rem); line-height: 1.1; letter-spacing: -.035em; font-weight: 650; text-wrap: balance; max-width: 20ch; }
  .intro { font-size: clamp(1rem, 2vw, 1.2rem); color: var(--color-text-secondary); line-height: 1.8; margin-top: 1.4rem; max-width: 68ch; }
  .execution-boundary, .language-fallback { font-size: .9rem; color: var(--color-text-muted); line-height: 1.8; margin-top: 1rem; max-width: 80ch; }
  .scientist-resources { border-top: 1px solid var(--color-border); margin-top: 3.5rem; padding-top: 1.5rem; display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: .9rem; }
  a { text-decoration: underline; text-underline-offset: .25em; }
</style>
