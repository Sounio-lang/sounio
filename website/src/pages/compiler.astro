---
import BaseLayout from '../layouts/BaseLayout.astro';
import EffectLatticeExhibit from '../components/compiler/EffectLatticeExhibit.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const label = (el: string, en: string) => locale === 'el' ? el : en;


const compilerBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": label("Μεταγλωττιστής", "Compiler"),
      "item": new URL(getLocalizedPath('/compiler', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout
  title={label("Μεταγλωττιστής Sounio — Αρχιτεκτονική και self-hosting", "Sounio Compiler — Architecture & Self-Hosting")}
  description={label("Το souc είναι γραμμένο στη Sounio και εκκινείται μέσω τριών σταδίων. Τα binaries των σταδίων 2 και 3 είναι πανομοιότυπα κατά SHA-256. Τέσσερις φάσεις: parse, check, HLIR, emit. Ένας διαθέσιμος στόχος: στατικό Linux x86-64 ELF.", "souc is written in Sounio and bootstrapped through three stages. Stage 2 and Stage 3 binaries are SHA-256 identical. Four phases: parse, check, HLIR, emit. One shipped target: Linux x86-64 static ELF.")}
  schema={compilerBreadcrumbSchema}
>

  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="section-shell compiler-hero">
    <div class="container compiler-hero-inner">
      <span class="badge-pill">{label("Μεταγλωττιστής", "Compiler")}</span>
      <h1 class="font-display text-[clamp(2.4rem,5.5vw,4rem)] font-[400] leading-[1.08] tracking-[-0.018em] text-[var(--color-text-primary)]">
        {locale === 'el' ? <>Ο μεταγλωττιστής που<br />μεταγλωττίζει τον εαυτό του.</> : <>The compiler that<br />compiles itself.</>}
      </h1>
      <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[56ch] leading-[1.78]">
        {locale === 'el' ? <>Το <code>souc</code> είναι γραμμένο στη Sounio. Το bootstrap ξεκινά με seed binary μεταγλωττισμένο σε C, περνά από τρία στάδια και ολοκληρώνεται όταν τα στάδια 2 και 3 παράγουν πανομοιότυπη έξοδο SHA-256. Το fixed point είναι το τεκμήριο αυτοσυνέπειας.</> : <>souc is written in Sounio. Bootstrap starts with a C-compiled seed binary, runs through three stages, and terminates when Stage&nbsp;2 and Stage&nbsp;3 produce SHA-256-identical outputs. The fixed point is the proof of correctness.</>}
      </p>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  <EffectLatticeExhibit locale={locale} />

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ── Bootstrap pipeline ───────────────────────────────── */}
  <section id="bootstrap" class="section-shell scroll-mt-[5rem]">
    <div class="container compiler-section-inner">
      <div class="cs-label-group">
        <span class="cs-letter">A</span>
        <h2 class="cs-heading font-display">{label("Bootstrap σε τρία στάδια.", "Three-stage bootstrap.")}</h2>
        <p class="cs-subhead">
          {locale === 'el' ? <>Δεν απαιτείται εμπιστοσύνη στο seed binary. Η αναπαραγωγιμότητα είναι η εγγύηση: αν τα <code>gen2.elf</code> και <code>gen3.elf</code> διαφέρουν, ο compiler έχει σφάλμα.</> : <>No trust in the seed binary is required. Reproducibility is the guarantee: if <code>gen2.elf</code> and <code>gen3.elf</code> differ, the compiler has a bug.</>}
        </p>
      </div>

      <div class="pipeline-grid">
        <div class="pipeline-step glass glass-specular">
          <p class="ps-stage">Stage 0</p>
          <p class="ps-title">{label("Seed μεταγλωττισμένο σε C", "C-compiled seed")}</p>
          <p class="ps-desc">
            {locale === 'el' ? <>Ελάχιστη υλοποίηση σε C του parser και emitter της Sounio. Η μοναδική της εργασία είναι να μεταγλωττίσει το <code>lean_single.sio</code> σε λειτουργικό binary. Δεν θεωρείται έμπιστη μετά το στάδιο&nbsp;1.</> : <>A minimal C implementation of the Sounio parser and emitter. Its sole job is to compile <code>lean_single.sio</code> into a working binary. Not trusted beyond Stage&nbsp;1.</>}
          </p>
        </div>
        <div class="pipeline-arrow" aria-hidden="true">→</div>
        <div class="pipeline-step glass glass-specular">
          <p class="ps-stage">Stage 1</p>
          <p class="ps-title">{label("Πρώτο self-hosted στάδιο", "First self-hosted")}</p>
          <p class="ps-desc">
            {locale === 'el' ? <>Το seed binary μεταγλωττίζει το <code>lean_single.sio</code> σε <code>gen1.elf</code>. Αυτό είναι το πρώτο binary της Sounio που μεταγλωττίστηκε από τη Sounio.</> : <>The seed binary compiles <code>lean_single.sio</code> into <code>gen1.elf</code>. This is the first Sounio binary compiled by Sounio.</>}
          </p>
        </div>
        <div class="pipeline-arrow" aria-hidden="true">→</div>
        <div class="pipeline-step glass glass-specular">
          <p class="ps-stage">Stage 2 ≡ Stage 3</p>
          <p class="ps-title">{label("Επαληθευμένο fixed point", "Fixed-point verified")}</p>
          <p class="ps-desc">
            {locale === 'el' ? <><code>gen1.elf</code> → <code>gen2.elf</code> και μετά <code>gen2.elf</code> → <code>gen3.elf</code>. Τα SHA-256 των δύο πρέπει να είναι πανομοιότυπα. Αυτό είναι το τεκμήριο αυτοσυνέπειας του compiler.</> : <><code>gen1.elf</code> → <code>gen2.elf</code>, then <code>gen2.elf</code> → <code>gen3.elf</code>. The SHA-256 of both must be identical. This is the compiler's self-consistency proof.</>}
          </p>
        </div>
      </div>

      <div class="bootstrap-code glass">
        <p class="bc-label">{label("Εκτελέστε το μόνοι σας", "Run it yourself")}</p>
        <pre class="bc-pre"><code>{`# Stage 0 → 1: C seed compiles the Sounio compiler
./artifacts/self-hosted/souc-self-hosted-x86_64 \\
    self-hosted/compiler/lean_single.sio gen1.elf

# Stage 1 → 2: first self-hosted compile
./gen1.elf self-hosted/compiler/lean_single.sio gen2.elf

# Stage 2 → 3: fixed-point check
./gen2.elf self-hosted/compiler/lean_single.sio gen3.elf

# These two SHA-256 digests must be identical.
sha256sum gen2.elf gen3.elf`}</code></pre>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ── Four phases ──────────────────────────────────────── */}
  <section id="phases" class="section-shell scroll-mt-[5rem]">
    <div class="container compiler-section-inner">
      <div class="cs-label-group">
        <span class="cs-letter">B</span>
        <h2 class="cs-heading font-display">{label("Τέσσερις φάσεις του compiler.", "Four compiler phases.")}</h2>
        <p class="cs-subhead">
          {locale === 'el' ? <>Κάθε φάση είναι ξεχωριστό module στο <code>self-hosted/compiler/</code>. Οι επιστημικοί τύποι παρακολουθούνται σε κάθε φάση· το confidence lattice δεν διαγράφεται ανάμεσα στο HLIR και το emit.</> : <>Each phase is a separate module in <code>self-hosted/compiler/</code>. Epistemic types are tracked through every phase; the confidence lattice is never erased between HLIR and emit.</>}
        </p>
      </div>

      <div class="phases-grid">
        <div class="phase-card glass glass-specular">
          <p class="phase-name">{label("Ανάλυση (Parse)", "Parse")}</p>
          <p class="phase-file"><code>parser/items.sio</code></p>
          <p class="phase-desc">
            {locale === 'el' ? <>Parser recursive descent. Παράγει unresolved AST με annotations effects, clauses <code>where</code> και δηλώσεις algebra. Δεν υπάρχει σιωπηρή ανάκτηση tokens — κακοσχηματισμένη είσοδος είναι hard error.</> : <>Recursive-descent parser. Produces an unresolved AST including effect annotations, <code>where</code> clauses, and algebra declarations. No implicit token recovery — ill-formed input is a hard error.</>}
          </p>
        </div>
        <div class="phase-card glass glass-specular">
          <p class="phase-name">{label("Έλεγχος (Check)", "Check")}</p>
          <p class="phase-file"><code>check/mod.sio</code></p>
          <p class="phase-desc">
            {locale === 'el' ? <>Type checker με bidirectional inference. Επιλύει widening του <code>Knowledge&lt;T&gt;</code>, ενοποίηση effect rows και περιορισμούς confidence gates. Όλες οι επιστημικές υποχρεώσεις διεκπεραιώνονται εδώ ή απορρίπτονται με typed error.</> : <>Type checker with bidirectional inference. Resolves <code>Knowledge&lt;T&gt;</code> widening, effect-row unification, and confidence gate constraints. All epistemic obligations are discharged here or rejected with a typed error.</>}
          </p>
        </div>
        <div class="phase-card glass glass-specular">
          <p class="phase-name">HLIR</p>
          <p class="phase-file"><code>hlir/mod.sio</code></p>
          <p class="phase-desc">
            {locale === 'el' ? <>High-level intermediate representation. Εδώ εκτελείται rewriting e-graph με περισσότερους από 1000 κανόνες. Η διάδοση αβεβαιότητας GUM χαμηλώνεται σε explicit variance-carrying nodes πριν από το emit.</> : <>High-level intermediate representation. E-graph rewriting with 1000+ rules runs here. GUM uncertainty propagation is lowered into explicit variance-carrying nodes before emit.</>}
          </p>
        </div>
        <div class="phase-card glass glass-specular">
          <p class="phase-name">{label("Παραγωγή (Emit)", "Emit")}</p>
          <p class="phase-file"><code>emit/mod.sio</code></p>
          <p class="phase-desc">
            {locale === 'el' ? <>Backend dispatcher. Η διαθέσιμη διαδρομή είναι native x86_64 (System V ABI, static Linux ELF). Η GPU διαδρομή παράγει PTX μόνο για σκελετό ονομασμένων kernel patterns (TOUR.md §6). Οι linear types επιβάλλουν κάθε resource να καταναλώνεται ακριβώς μία φορά.</> : <>Backend dispatcher. The shipped path is x86_64 native (System V ABI, static Linux ELF). The GPU path emits PTX for a skeleton of named kernel patterns only (TOUR.md §6). Linear types enforce that every resource is consumed exactly once.</>}
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ── Targets ──────────────────────────────────────────── */}
  <section id="targets" class="section-shell scroll-mt-[5rem]">
    <div class="container compiler-section-inner">
      <div class="cs-label-group">
        <span class="cs-letter">C</span>
        <h2 class="cs-heading font-display">{label("Ένας διαθέσιμος στόχος.", "One shipped target.")}</h2>
        <p class="cs-subhead">
          {locale === 'el' ? <>Ο compiler στοχεύει μόνο Linux x86-64 (TOUR.md §6). Το epistemic layer δεν είναι runtime library — χαμηλώνεται στον ίδιο machine code που μεταφέρει τον υπολογισμό. Οι άλλοι emitters στο source tree είναι προσχέδια ή σκελετοί και παρατίθενται ώστε η κατάστασή τους να μην υπερερμηνεύεται.</> : <>The compiler targets Linux x86-64 only (TOUR.md §6). The epistemic layer is not a runtime library — it is lowered into the same machine code that carries the computation. Other emitters in the source tree are drafts or skeletons, listed here so their status is not overread.</>}
        </p>
      </div>

      <div class="targets-grid">
        <div class="target-card">
          <p class="target-arch">x86_64</p>
          <p class="target-status target-shipped">{label("Διαθέσιμο", "Shipped")}</p>
          <p class="target-desc">
            {locale === 'el' ? <>System V ABI. Ο κύριος στόχος ανάπτυξης και ο στόχος που διανέμεται. Το <code>souc</code> εκτελείται εδώ. Η confidence του <code>Knowledge&lt;T&gt;</code> αποθηκεύεται ως struct field· η διάδοση GUM μεταγλωττίζεται σε scalar arithmetic.</> : <>System V ABI. The primary development and shipped target. souc itself runs here. Knowledge&lt;T&gt; confidence is laid out as a struct field; GUM propagation compiles to scalar arithmetic.</>}
          </p>
        </div>
        <div class="target-card">
          <p class="target-arch">ARM64, macOS, WASM</p>
          <p class="target-status target-unshipped">{label("Δεν διατίθεται", "Not shipped")}</p>
          <p class="target-desc">
            {locale === 'el' ? <>Μη υποστηριζόμενοι στόχοι. Τα binaries είναι static Linux ELF και δεν εκτελούνται σε macOS. Το WASM backend είναι blocked draft (<a href="https://github.com/Sounio-lang/sounio/issues/2237">#2237</a>). Το Cranelift JIT δεν διατίθεται πλέον (CHANGELOG 2.1.0).</> : <>Not supported targets. The binaries are static Linux ELF and do not run on macOS. The WASM backend is a blocked draft (<a href="https://github.com/Sounio-lang/sounio/issues/2237">#2237</a>). The Cranelift JIT is no longer shipped (CHANGELOG 2.1.0).</>}
          </p>
        </div>
        <div class="target-card">
          <p class="target-arch">PTX</p>
          <p class="target-status target-unshipped">{label("Σκελετός εκπομπής", "Emission skeleton")}</p>
          <p class="target-desc">
            {locale === 'el' ? <><code>souc build --backend gpu</code> παράγει έγκυρο PTX για σκελετό named kernel patterns: kernels με κενά bodies, χωρίς arithmetic και χωρίς memory access (μετρήθηκε 2026-10-04, <code>examples/kernel_vec_add.sio</code>). Δεν είναι γενικός GPU backend.</> : <><code>souc build --backend gpu</code> emits valid PTX for a skeleton of named kernel patterns: kernels with empty bodies, no arithmetic and no memory access (measured 2026-10-04, <code>examples/kernel_vec_add.sio</code>). It is not a general GPU backend.</>}
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ── Lean integration ─────────────────────────────────── */}
  <section id="lean" class="section-shell scroll-mt-[5rem]">
    <div class="container compiler-section-inner">
      <div class="cs-label-group">
        <span class="cs-letter">D</span>
        <h2 class="cs-heading font-display">{label("Lean 4 για τις δύσκολες αποδείξεις.", "Lean 4 for the hard proofs.")}</h2>
        <p class="cs-subhead">
          {locale === 'el' ? <>Εκεί όπου ο type checker επιβάλλει, το Lean επαληθεύει. Οι δύο βασικές ιδιότητες του epistemic type system — GUM conservativity και confidence monotonicity — διατυπώνονται ως θεωρήματα και αποδεικνύονται στο <code>formal/EpistemicEffects.lean</code>.</> : <>Where the type checker enforces, Lean verifies. The two key properties of the epistemic type system — GUM conservativity and confidence monotonicity — are stated as theorems and proved in <code>formal/EpistemicEffects.lean</code>.</>}
        </p>
      </div>

      <div class="lean-grid">
        <div class="lean-theorem glass glass-specular">
          <p class="lt-name">gum_conservativity</p>
          <p class="lt-status">{label("Αποδεδειγμένο", "Proved")}</p>
          <p class="lt-desc">
            {locale === 'el' ? <>Η διάδοση αβεβαιότητας GUM μέσω αριθμητικής δεν αυξάνει ποτέ την confidence. Σύνθεση επιστημικών πράξεων δεν μπορεί να κατασκευάσει βεβαιότητα που δεν υπήρχε στις εισόδους.</> : <>GUM uncertainty propagation through arithmetic never increases confidence. A composition of epistemic operations cannot manufacture certainty that wasn't present in the inputs.</>}
          </p>
        </div>
        <div class="lean-theorem glass glass-specular">
          <p class="lt-name">confidence_monotonicity</p>
          <p class="lt-status">{label("Αποδεδειγμένο", "Proved")}</p>
          <p class="lt-desc">
            {locale === 'el' ? <>Το widening μιας τιμής <code>Knowledge&lt;T&gt;</code> (αύξηση του ε) δεν μπορεί να παράγει στενότερο confidence interval. Η διάταξη του confidence lattice είναι monotone σε όλες τις type operations.</> : <>Widening a <code>Knowledge&lt;T&gt;</code> value (increasing ε) cannot produce a narrower confidence interval. The ordering on the confidence lattice is monotone through all type operations.</>}
          </p>
        </div>
        <div class="lean-theorem glass glass-specular">
          <p class="lt-name">substitution_lemma</p>
          <p class="lt-status lt-open">{label("Ανοιχτή υποχρέωση", "Open obligation")}</p>
          <p class="lt-desc">
            {locale === 'el' ? <>Η substitution επιστημικών values σε effect-typed terms διατηρεί το effect row. Η δομή της απόδειξης υπάρχει· απομένει μία υποχρέωση indexed induction.</> : <>Substitution of epistemic values in effect-typed terms preserves the effect row. Proof structure is in place; one indexed-induction obligation remains.</>}
          </p>
        </div>
      </div>

      <p class="lean-pointer">
        {label("Πηγή:", "Source:")}
        <a href="https://github.com/Sounio-lang/sounio/blob/main/formal/lean4/EpistemicEffects.lean"
           target="_blank" rel="noopener"
           class="lean-link">
          formal/lean4/EpistemicEffects.lean
        </a>
        ({/* line count */}589 lines, 0 <code>sorry</code>).
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Hero
    gsap.from('.compiler-hero-inner > *', {
      y: 24, opacity: 0, stagger: 0.12, duration: 0.7, ease: 'power2.out',
      scrollTrigger: { trigger: '.compiler-hero', start: 'top 80%', once: true },
    });

    // Section A — Bootstrap pipeline
    const tlA = gsap.timeline({ scrollTrigger: { trigger: '#bootstrap', start: 'top 72%', once: true } });
    tlA.from('#bootstrap .cs-label-group', { y: 18, opacity: 0, duration: 0.5, ease: 'power2.out' })
       .from('#bootstrap .pipeline-step', { y: 28, opacity: 0, stagger: 0.14, duration: 0.6, ease: 'power2.out' }, '-=0.25')
       .from('#bootstrap .bootstrap-code', { y: 18, opacity: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');

    // Section B — Four phases
    const tlB = gsap.timeline({ scrollTrigger: { trigger: '#phases', start: 'top 72%', once: true } });
    tlB.from('#phases .cs-label-group', { y: 18, opacity: 0, duration: 0.5, ease: 'power2.out' })
       .from('#phases .phase-card', { y: 28, opacity: 0, stagger: 0.12, duration: 0.6, ease: 'power2.out' }, '-=0.25');

    // Section C — Targets
    const tlC = gsap.timeline({ scrollTrigger: { trigger: '#targets', start: 'top 72%', once: true } });
    tlC.from('#targets .cs-label-group', { y: 18, opacity: 0, duration: 0.5, ease: 'power2.out' })
       .from('#targets .target-card', { y: 24, opacity: 0, stagger: 0.12, duration: 0.55, ease: 'power2.out' }, '-=0.25');

    // Section D — Lean
    const tlD = gsap.timeline({ scrollTrigger: { trigger: '#lean', start: 'top 72%', once: true } });
    tlD.from('#lean .cs-label-group', { y: 18, opacity: 0, duration: 0.5, ease: 'power2.out' })
       .from('#lean .lean-theorem', { y: 24, opacity: 0, stagger: 0.14, duration: 0.6, ease: 'power2.out' }, '-=0.25')
       .from('#lean .lean-pointer', { y: 12, opacity: 0, duration: 0.4, ease: 'power2.out' }, '-=0.15');
  });
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .compiler-hero-inner {
    max-width: 760px;
    display: grid;
    gap: 1.1rem;
  }

  /* ── Section scaffold ───────────────────────────────────── */
  .compiler-section-inner {
    max-width: 860px;
    display: grid;
    gap: 2rem;
  }

  .cs-label-group {
    display: grid;
    gap: 0.4rem;
  }

  .cs-letter {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-gold-soft);
  }

  .cs-heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
  }

  .cs-subhead {
    font-size: 0.96rem;
    color: var(--color-text-secondary);
    line-height: 1.72;
    max-width: 66ch;
    margin: 0;
  }

  /* ── Bootstrap pipeline ─────────────────────────────────── */
  .pipeline-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 700px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
    .pipeline-arrow { display: none; }
  }

  .pipeline-step {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .ps-stage {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-gold-soft);
    opacity: 0.75;
    margin: 0;
    text-transform: uppercase;
  }

  .ps-title {
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--color-text-primary);
    margin: 0;
  }

  .ps-desc {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .pipeline-arrow {
    font-size: 1.4rem;
    color: var(--color-accent-gold-soft);
    opacity: 0.4;
    text-align: center;
  }

  .bootstrap-code {
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: grid;
    gap: 0.6rem;
  }

  .bc-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-accent-gold-soft);
    opacity: 0.7;
    margin: 0;
    text-transform: uppercase;
  }

  .bc-pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
    background: rgba(0,0,0,0.3);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
  }

  /* ── Phases ─────────────────────────────────────────────── */
  .phases-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .phase-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
