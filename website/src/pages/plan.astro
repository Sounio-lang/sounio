---
import BaseLayout from '../layouts/BaseLayout.astro';
import { escapeCheckedArtifact, escapeFullSuite, fullSuitePublished } from '../lib/claimEscapes';
import { reliabilityFace, reliabilityMayPrint, reliabilityRefusal } from '../lib/stdlibReliabilityHonesty';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const reliabilityOk = reliabilityMayPrint();

const planBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Plan",
      "item": new URL(getLocalizedPath('/plan', locale), Astro.site).toString()
    }
  ]
};

const operatingPlan = [
  {
    label: '01',
    title: 'Orient the velocity',
    status: 'Now',
    body: 'Make the daily movement legible: what changed, what matured, what is blocked, and what a visitor should do next.',
  },
  {
    label: '02',
    title: 'Make evidence inspectable',
    status: 'Now',
    body: 'Pair major public claims with artifact paths, gates, freshness, and honest uncertainty boundaries.',
  },
  {
    label: '03',
    title: 'Turn interaction into competence',
    status: 'Next',
    body: 'Use examples, diagnostics, and simulations to help visitors understand epistemic types and scientific uncertainty by doing.',
  },
  {
    label: '04',
    title: 'Localize as presence',
    status: 'Next',
    body: 'Treat each locale as a real entrance into Sounio, with visible freshness and graceful fallback where the language has moved faster than translation.',
  },
];

const evidenceGates = [
  {
    name: 'Stdlib reliability',
    value: reliabilityOk ? reliabilityFace() : reliabilityRefusal(),
    detail: reliabilityOk
      ? 'Current standard-library reliability gate reflected from artifact status.'
      : 'Artifact names a launcher, not an engine. Sync is not a remasure.',
  },
  {
    name: 'Full suite',
    value: escapeFullSuite('not published'),
    detail: fullSuitePublished()
      ? 'Used as an evidence surface, not a decorative maturity claim.'
      : 'No full-suite artifact is present in the current public contract.',
  },
  {
    name: 'Checked artifact',
    value: escapeCheckedArtifact(),
    detail: 'The site should expose compiler freshness without turning churn into anxiety.',
  },
  {
    name: 'Locales',
    value: '7',
    detail: 'English plus Portuguese, Greek, Chinese, Japanese, Spanish, and Hong Kong Cantonese paths.',
  },
];

const blockers = [
  {
    title: 'Movement source',
    next: 'Promote curated recent-change snapshots into artifact status.',
  },
  {
    title: 'Translation freshness',
    next: 'Expose freshness per locale and per content family.',
  },
  {
    title: 'Showcase evidence',
    next: 'Attach evidence cards before adding more visual expansion.',
  },
  {
    title: 'Release language',
    next: 'Keep roadmap wording proportional to named gates.',
  },
];
---

<BaseLayout
  title="Plan — Sounio Operating Surface"
  description="The operating plan for keeping Sounio legible as a fast-moving language: orientation, evidence, transformation, and agency."
  schema={planBreadcrumbSchema}
>
  <section class="plan-hero section-shell">
    <div class="container plan-hero-inner">
      <span class="badge-pill">Plan</span>
      <p class="plan-kicker">Living Language Interface</p>
      <h1>Sounio should feel fast, alive, and not adrift.</h1>
      <p class="plan-hero-copy">
        Sounio is a language in motion. The public surface has to turn velocity
        into orientation, evidence into trust, and interaction into competence.
      </p>
      <div class="plan-actions">
        <a href={getLocalizedPath('/compiler', locale)} class="plan-action plan-action-primary">Inspect compiler</a>
        <a href={getLocalizedPath('/releases', locale)} class="plan-action">Release state</a>
        <a href={getLocalizedPath('/showcases', locale)} class="plan-action">See showcases</a>
      </div>
    </div>
  </section>

  <section class="plan-thesis-band">
    <div class="container plan-thesis">
      <p class="plan-thesis-label">Core thesis</p>
      <p class="plan-thesis-text">Transformation without disorientation.</p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container plan-section-grid">
      <div class="plan-section-head">
        <p class="plan-section-label">Operating Moves</p>
        <h2>Four moves guide the public operating surface.</h2>
        <p>
          Each move keeps the project honest under high velocity. The goal is
          not to slow the language down; it is to help people enter it safely.
        </p>
      </div>

      <div class="plan-move-list">
        {operatingPlan.map((item) => (
          <article class="plan-move">
            <div class="plan-move-top">
              <span>{item.label}</span>
              <strong>{item.status}</strong>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell plan-evidence-shell">
    <div class="container">
      <div class="plan-section-head plan-section-head-wide">
        <p class="plan-section-label">Evidence Surface</p>
        <h2>The plan is backed by things the repo can actually report.</h2>
      </div>
      <div class="plan-evidence-grid">
        {evidenceGates.map((gate) => (
          <article class="plan-evidence">
            <p class="plan-evidence-name">{gate.name}</p>
            <p class="plan-evidence-value">{gate.value}</p>
            <p class="plan-evidence-detail">{gate.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container plan-two-column">
      <div>
        <p class="plan-section-label">Current Constraints</p>
        <h2>Known friction stays visible.</h2>
        <p class="plan-copy">
          A living-language surface should not hide the unfinished state. It
          should show what remains uncertain and what the next action is.
        </p>
      </div>
      <ul class="plan-blockers">
        {blockers.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.next}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-shell plan-next-shell">
    <div class="container plan-next">
      <p class="plan-section-label">Current Cut</p>
      <h2>Keep the Living Language Pulse honest.</h2>
      <p>
        The homepage pulse now summarizes movement, maturity, evidence, known
        limits, and a clear path for understanding, trying, verifying, or
        contributing. The next work is to keep its source data fresh and make
        translation freshness visible per content family.
      </p>
      <a href={getLocalizedPath('/', locale)} class="plan-action plan-action-primary">Return to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .plan-hero {
    padding-top: clamp(5.5rem, 12vw, 9rem);
    border-bottom: 1px solid var(--glass-border);
  }

  .plan-hero-inner {
    max-width: 900px;
    display: grid;
    gap: 1rem;
  }

  .plan-kicker,
  .plan-section-label,
  .plan-thesis-label {
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .plan-hero h1 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.7rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: 0;
    color: var(--color-text-primary);
  }

  .plan-hero-copy {
    max-width: 62ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.75;
  }

  .plan-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }

  .plan-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.7rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    padding: 0.72rem 1.1rem;
    color: var(--color-text-primary);
    background: var(--glass-bg);
    font-size: 0.92rem;
    font-weight: 700;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .plan-action:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent-gold) 55%, var(--glass-border));
  }

  .plan-action-primary {
    background: var(--color-accent-gold);
    color: #10233e;
    border-color: transparent;
  }

  .plan-thesis-band {
    padding: clamp(2.2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 48%, transparent);
  }

  .plan-thesis {
    display: grid;
    gap: 0.65rem;
  }

  .plan-thesis-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.8vw, 4.2rem);
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .plan-section-grid,
  .plan-two-column {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .plan-section-head {
    max-width: 620px;
    display: grid;
    gap: 0.8rem;
  }

  .plan-section-head-wide {
    max-width: 760px;
    margin-bottom: 1.4rem;
  }

  .plan-section-head h2,
  .plan-two-column h2,
  .plan-next h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .plan-section-head p:not(.plan-section-label),
  .plan-copy,
  .plan-next p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.72;
  }

  .plan-move-list {
    display: grid;
    gap: 0.85rem;
  }

  .plan-move,
  .plan-evidence {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .plan-move-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plan-move-top strong {
    color: var(--color-accent-teal);
  }

  .plan-move h3 {
    margin: 0.85rem 0 0;
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .plan-move p,
  .plan-evidence-detail,
  .plan-blockers li {
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .plan-move p {
    margin: 0.55rem 0 0;
  }

  .plan-evidence-shell {
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 34%, transparent);
  }

  .plan-evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.9rem;
  }

  .plan-evidence-name,
  .plan-evidence-detail {
    margin: 0;
  }

  .plan-evidence-name {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .plan-evidence-value {
    margin: 0.65rem 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
  }

  .plan-blockers {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-blockers li {
    display: grid;
    gap: 0.18rem;
    border-left: 2px solid var(--color-accent-gold);
    padding: 0.1rem 0 0.1rem 1rem;
  }

  .plan-blockers strong {
    color: var(--color-text-primary);
    font-size: 0.96rem;
  }

  .plan-blockers span {
    color: var(--color-text-secondary);
  }

  .plan-next-shell {
    border-top: 1px solid var(--glass-border);
  }

  .plan-next {
    max-width: 780px;
    display: grid;
    gap: 1rem;
  }

  .plan-next .plan-action {
    justify-self: start;
    margin-top: 0.25rem;
  }

  @media (min-width: 900px) {
    .plan-section-grid,
    .plan-two-column {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
</style>
