---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const showcases = await getCollection('showcases');

const sorted = showcases
  .filter((entry) => !entry.data.draft)
  .filter((entry) => !entry.id.includes('/'))  // only English (non-locale-prefixed) entries
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Showcases" description="Bounded Sounio showcases and domain narratives">
  <section class="section-shell showcases-hero">
    <div class="container showcases-content">
      <span class="badge-pill">Showcases</span>
      <h1>Bounded examples, packaged honestly.</h1>
      <p>
        Showcases are not the same thing as the public contract. They are edited entry points into real domains and
        workflows so you can understand what the project is trying to do without confusing demos for guarantees.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="showcase-grid premium-grid">
        {sorted.map((showcase) => {
          const slug = showcase.id.replace(/\.mdx$/, '');
          return (
            <a href={getLocalizedPath(`/showcases/${slug}`, locale)} class="showcase-card glass glass-elevated">
              <div class="showcase-top">
                <span class="showcase-icon">{showcase.data.icon ?? '•'}</span>
                <span class="showcase-domain">{showcase.data.domain}</span>
              </div>
              <h2>{showcase.data.title}</h2>
              <p>{showcase.data.description}</p>
              <span class="showcase-cta">Open showcase</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .showcases-content {
    max-width: 760px;
    display: grid;
    gap: 0.95rem;
  }

  .showcases-content h1 {
    font-size: clamp(2.2rem, 6vw, 4.6rem);
  }

  .showcases-content p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.2vw, 1.14rem);
  }

  .showcase-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .showcase-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .showcase-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .showcase-icon {
    font-size: 1.15rem;
  }

  .showcase-domain {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .showcase-card h2 {
    font-size: 1.18rem;
  }

  .showcase-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .showcase-cta {
    margin-top: 0.15rem;
    color: var(--color-accent-gold-soft);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
