---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return showcases
    .filter((showcase) => !showcase.id.includes('/'))  // only English (non-locale-prefixed) entries
    .map((showcase) => ({
      params: { slug: showcase.id.replace(/\.mdx$/, '') },
    }));
}

return Astro.redirect(`/science/${Astro.params.slug}`, 308);
---
