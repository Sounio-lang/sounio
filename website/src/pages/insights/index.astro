---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Card from '../../components/ui/Card.astro';
import Tag from '../../components/ui/Tag.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .filter((post) => !post.id.includes('/'))  // only English (non-locale-prefixed) posts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Insights" description="Research updates, release notes, and engineering writing from Sounio">
  <Section class="insights-hero">
    <Container class="insights-inner grid gap-4">
      <Eyebrow>Insights</Eyebrow>
      <h1 class="text-[clamp(2.2rem,5.6vw,4.45rem)]">Engineering notes from the frontier of epistemic computing.</h1>
      <p class="text-[clamp(1rem,2.4vw,1.18rem)] text-[var(--color-ink-2)]">
        Product releases, deep technical writing, and domain-facing guidance for teams building confidence-aware software.
      </p>
    </Container>
  </Section>

  <Section>
    <Container class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
      {posts.map((post) => {
        const slug = post.id.replace(/\.mdx$/, '');
        return (
          <Card pad="none" class="grid content-start gap-[0.65rem] p-[1.12rem]">
            <div class="flex items-center justify-between gap-2 text-[0.75rem] text-[var(--color-ink-3)]">
              <time>{post.data.publishedAt.toISOString().slice(0, 10)}</time>
              <span>{post.data.author}</span>
            </div>
            <h2 class="text-[1.45rem]">
              <a href={getLocalizedPath(`/insights/${slug}`, locale)}>{post.data.title}</a>
            </h2>
            <p class="text-[0.92rem] text-[var(--color-ink-2)]">{post.data.description}</p>
            <div class="flex flex-wrap gap-[0.4rem]">
              {post.data.tags.map((tag) => (
                <Tag>#{tag}</Tag>
              ))}
            </div>
          </Card>
        );
      })}
    </Container>
  </Section>
</BaseLayout>

<style>
  .insights-inner {
    max-width: 780px;
  }
</style>
