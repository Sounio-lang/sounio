---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .filter((post) => !post.id.includes('/'))  // only English (non-locale-prefixed) posts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Insights" description="Research updates, release notes, and engineering writing from Sounio">
  <section class="section-shell insights-hero">
    <div class="container insights-inner">
      <span class="badge-pill">Insights</span>
      <h1>Engineering notes from the frontier of epistemic computing.</h1>
      <p>
        Product releases, deep technical writing, and domain-facing guidance for teams building confidence-aware software.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container insight-grid premium-grid">
      {posts.map((post) => {
        const slug = post.id.replace(/\.mdx$/, '');
        return (
          <article class="glass glass-specular insight-card">
            <div class="meta-row">
              <time>{post.data.publishedAt.toISOString().slice(0, 10)}</time>
              <span>{post.data.author}</span>
            </div>
            <h2>
              <a href={getLocalizedPath(`/insights/${slug}`, locale)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="tag-row">
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .insights-inner {
    max-width: 780px;
    display: grid;
    gap: 1rem;
  }

  .insights-inner h1 {
    font-size: clamp(2.2rem, 5.6vw, 4.45rem);
  }

  .insights-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .insight-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .insight-card {
    border-radius: var(--radius-xl);
    padding: 1.12rem;
    display: grid;
    gap: 0.65rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
  }

  .insight-card h2 {
    font-size: 1.45rem;
  }

  .insight-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-row span {
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border);
    background: var(--color-surface-frost);
    color: var(--color-text-tertiary);
    font-size: 0.76rem;
    padding: 0.26rem 0.56rem;
  }
</style>
