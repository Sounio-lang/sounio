---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type LessonSummary = {
  title: string;
  slug: string;
  description: string;
  estimatedMinutes: number;
};

export async function getStaticPaths() {
  const tutorials = (await getCollection('tutorials')).filter((t) => !t.id.includes('/'));  // only English (root-level) entries
  const seriesMap = new Map<string, CollectionEntry<'tutorials'>[]>();

  for (const tutorial of tutorials) {
    const s = tutorial.data.series;
    if (!seriesMap.has(s)) {
      seriesMap.set(s, []);
    }
    seriesMap.get(s)!.push(tutorial);
  }

  return Array.from(seriesMap.entries()).map(([series, lessonEntries]) => {
    lessonEntries.sort((a, b) => a.data.order - b.data.order);
    const lessons: LessonSummary[] = lessonEntries.map((lesson) => ({
      title: lesson.data.title,
      slug: lesson.id.replace(/\.mdx$/, ''),
      description: lesson.data.description,
      estimatedMinutes: lesson.data.estimatedMinutes || 0,
    }));
    return {
      params: { series },
      props: {
        series,
        lessons,
      },
    };
  });
}

const seriesMeta: Record<string, { title: string; description: string }> = {
  'getting-started': {
    title: 'Getting Started',
    description: 'Learn the basics of Sounio programming through short guided lessons.',
  },
  'drug-dosing': {
    title: 'Uncertainty-Aware Drug Dosing',
    description:
      'Build a pharmacokinetic workflow that tracks uncertainty from measurement to decision.',
  },
};

const { series, lessons } = Astro.props as { series: string; lessons: LessonSummary[] };
const meta = seriesMeta[series] ?? { title: series, description: 'Tutorial series' };
const totalMinutes = lessons.reduce((sum, lesson) => sum + (lesson.estimatedMinutes || 0), 0);
---

<BaseLayout title={`${meta.title} Tutorial`} description={meta.description}>
  <main class="max-w-4xl mx-auto px-6 py-16">
    <a href="/tutorials" class="inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All Tutorials
    </a>

    <h1 class="text-4xl font-bold text-[var(--color-text)] mb-3">{meta.title}</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-8">{meta.description}</p>

    <div class="flex gap-4 mb-10 text-sm text-[var(--color-text-muted)]">
      <span>{lessons.length} lessons</span>
      {totalMinutes > 0 && <span>~{totalMinutes} min</span>}
    </div>

    <ol class="space-y-4">
      {lessons.map((lesson, index) => (
        <li>
          <a
            href={`/tutorials/${series}/${lesson.slug}`}
            class="block rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-5 hover:border-[var(--color-gold-500)] transition-colors"
          >
            <p class="text-sm text-[var(--color-text-muted)] mb-1">Lesson {index + 1}</p>
            <h2 class="text-xl font-semibold text-[var(--color-text)]">{lesson.title}</h2>
            <p class="text-[var(--color-text-muted)] mt-1">{lesson.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
