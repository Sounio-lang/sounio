---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials')).filter((t) => !t.id.includes('/'));  // only English (root-level) entries

// Group by series
const seriesMap = new Map<string, typeof tutorials>();
for (const t of tutorials) {
  const series = t.data.series;
  if (!seriesMap.has(series)) seriesMap.set(series, []);
  seriesMap.get(series)!.push(t);
}

// Sort each series by order
for (const [, lessons] of seriesMap) {
  lessons.sort((a, b) => a.data.order - b.data.order);
}

const seriesMeta: Record<string, { title: string; description: string }> = {
  'getting-started': {
    title: 'Getting Started',
    description: 'Learn the basics of Sounio programming',
  },
  'drug-dosing': {
    title: 'Uncertainty-Aware Drug Dosing',
    description: 'Build a pharmacokinetic model with epistemic uncertainty tracking — from basic types to clinical decisions',
  },
};
---

<BaseLayout title="Tutorials" description="Learn Sounio through guided, hands-on tutorials">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-[var(--color-text)] mb-4">Tutorials</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-12">
      Guided, hands-on lessons that teach Sounio's unique features through real scientific computing problems.
    </p>

    <div class="space-y-8">
      {Array.from(seriesMap.entries()).map(([series, lessons]) => {
        const meta = seriesMeta[series] || { title: series, description: '' };
        const totalMinutes = lessons.reduce((sum, l) => sum + (l.data.estimatedMinutes || 0), 0);
        return (
          <a
            href={`/tutorials/${series}`}
            class="block p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] hover:border-[var(--color-gold-500)] transition-colors group"
          >
            <div class="flex items-start justify-between">
              <div>
                <h2 class="text-xl font-semibold text-[var(--color-text)] group-hover:text-[var(--color-gold-500)] transition-colors">
                  {meta.title}
                </h2>
                <p class="text-[var(--color-text-muted)] mt-1">{meta.description}</p>
                <div class="flex gap-4 mt-3 text-sm text-[var(--color-text-muted)]">
                  <span>{lessons.length} lessons</span>
                  {totalMinutes > 0 && <span>~{totalMinutes} min</span>}
                </div>
              </div>
              <svg class="w-5 h-5 text-[var(--color-text-muted)] group-hover:text-[var(--color-gold-500)] transition-colors mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</BaseLayout>
