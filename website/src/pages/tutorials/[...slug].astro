---
import TutorialLayout from '../../layouts/TutorialLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');

  // Group by series
  const seriesMap = new Map<string, typeof tutorials>();
  for (const t of tutorials) {
    const series = t.data.series;
    if (!seriesMap.has(series)) seriesMap.set(series, []);
    seriesMap.get(series)!.push(t);
  }

  // Sort each series by order
  for (const [, lessons] of seriesMap) {
    lessons.sort((a, b) => a.data.order - b.data.order);
  }

  const paths = [];
  for (const [series, lessons] of seriesMap) {
    for (let i = 0; i < lessons.length; i++) {
      paths.push({
        params: { slug: `${series}/${lessons[i].slug}` },
        props: {
          entry: lessons[i],
          series,
          lessonIndex: i,
          allLessons: lessons.map(l => ({ title: l.data.title, slug: l.slug })),
        },
      });
    }
  }
  return paths;
}

const seriesTitles: Record<string, string> = {
  'getting-started': 'Getting Started',
  'drug-dosing': 'Uncertainty-Aware Drug Dosing',
};

const { entry, series, lessonIndex, allLessons } = Astro.props;
const { Content } = await entry.render();
---

<TutorialLayout
  title={entry.data.title}
  description={entry.data.description}
  tutorialTitle={seriesTitles[series] || series}
  tutorialSlug={series}
  lessons={allLessons}
  currentLesson={lessonIndex}
>
  <Content />
</TutorialLayout>
