---
import BaseLayout from '../layouts/BaseLayout.astro';

const phases = [
  {
    name: 'Phase 1: Foundation',
    status: 'completed',
    items: [
      { name: 'Core language design', status: 'completed' },
      { name: 'Lexer and parser', status: 'completed' },
      { name: 'Type checker with inference', status: 'completed' },
      { name: 'Effect system (IO, Mut, Alloc, Panic)', status: 'completed' },
      { name: 'Linear and affine types', status: 'completed' },
      { name: 'Units of measure', status: 'completed' },
    ],
  },
  {
    name: 'Phase 2: Epistemic Computing',
    status: 'completed',
    items: [
      { name: 'Knowledge<T> types', status: 'completed' },
      { name: 'Uncertainty propagation (GUM)', status: 'completed' },
      { name: 'Provenance tracking', status: 'completed' },
      { name: 'Confidence gates', status: 'completed' },
      { name: 'Scientific ontology (15M terms)', status: 'completed' },
    ],
  },
  {
    name: 'Phase 3: Backends',
    status: 'in_progress',
    items: [
      { name: 'LLVM backend', status: 'completed' },
      { name: 'Cranelift backend', status: 'completed' },
      { name: 'Native ELF/Mach-O generation', status: 'completed' },
      { name: 'GPU kernels (PTX, SPIR-V)', status: 'completed' },
      { name: 'WebAssembly backend', status: 'in_progress' },
    ],
  },
  {
    name: 'Phase 4: Tooling',
    status: 'in_progress',
    items: [
      { name: 'LSP server', status: 'in_progress' },
      { name: 'Package manager', status: 'experimental' },
      { name: 'Documentation generator', status: 'in_progress' },
      { name: 'REPL', status: 'completed' },
      { name: 'Debugger integration', status: 'planned' },
    ],
  },
  {
    name: 'Phase 5: Ecosystem',
    status: 'planned',
    items: [
      { name: 'Standard library expansion', status: 'in_progress' },
      { name: 'Package registry', status: 'planned' },
      { name: 'IDE plugins (VS Code, JetBrains)', status: 'planned' },
      { name: 'Jupyter kernel', status: 'planned' },
      { name: 'Interop with Python, R, Julia', status: 'planned' },
    ],
  },
  {
    name: 'Phase 6: Production',
    status: 'planned',
    items: [
      { name: 'Performance optimization', status: 'planned' },
      { name: 'Formal verification', status: 'planned' },
      { name: 'Security audit', status: 'planned' },
      { name: 'v1.0 stable release', status: 'planned' },
    ],
  },
];

const statusColors: Record<string, { bg: string; text: string; dot: string }> = {
  completed: {
    bg: 'bg-[rgba(48,209,88,0.1)]',
    text: 'text-[var(--color-accent-green)]',
    dot: 'bg-[var(--color-accent-green)]',
  },
  in_progress: {
    bg: 'bg-[rgba(255,159,10,0.1)]',
    text: 'text-[var(--color-accent-orange)]',
    dot: 'bg-[var(--color-accent-orange)] animate-pulse',
  },
  experimental: {
    bg: 'bg-[rgba(191,90,242,0.1)]',
    text: 'text-[var(--color-accent-purple)]',
    dot: 'bg-[var(--color-accent-purple)]',
  },
  planned: {
    bg: 'bg-[rgba(255,255,255,0.04)]',
    text: 'text-[var(--color-text-tertiary)]',
    dot: 'bg-[var(--color-text-tertiary)]',
  },
};

const statusLabels: Record<string, string> = {
  completed: 'Completed',
  in_progress: 'In Progress',
  experimental: 'Experimental',
  planned: 'Planned',
};
---

<BaseLayout title="Roadmap" description="The development roadmap for Sounio">
  <!-- Hero -->
  <section class="relative py-20 overflow-hidden bg-[var(--color-surface-primary)]">
    <div class="relative container px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-4">
        Roadmap
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Our development journey toward a production-ready epistemic computing platform
      </p>
    </div>
  </section>

  <!-- Legend -->
  <section class="py-8 border-b border-[var(--glass-border)]">
    <div class="container px-4">
      <div class="flex flex-wrap justify-center gap-6">
        {Object.entries(statusLabels).map(([status, label]) => (
          <div class="flex items-center gap-2">
            <div class={`w-3 h-3 rounded-full ${statusColors[status].dot}`}></div>
            <span class="text-sm text-[var(--color-text-secondary)]">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Phases -->
  <section class="py-16">
    <div class="container px-4">
      <div class="max-w-4xl mx-auto space-y-12">
        {phases.map((phase, phaseIndex) => (
          <div class="glass rounded-xl relative p-6">
            <!-- Phase header -->
            <div class="flex items-center gap-4 mb-6">
              <div class={`flex items-center justify-center w-10 h-10 rounded-full ${statusColors[phase.status].bg}`}>
                <span class={`text-lg font-bold ${statusColors[phase.status].text}`}>
                  {phaseIndex + 1}
                </span>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">
                  {phase.name}
                </h2>
                <span class={`text-sm ${statusColors[phase.status].text}`}>
                  {statusLabels[phase.status]}
                </span>
              </div>
            </div>

            <!-- Items grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-14">
              {phase.items.map((item) => (
                <div class={`flex items-center gap-3 p-4 rounded-xl border ${statusColors[item.status].bg} border-transparent`}>
                  <div class={`w-2 h-2 rounded-full flex-shrink-0 ${statusColors[item.status].dot}`}></div>
                  <span class="text-[var(--color-text-primary)]">{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contribute CTA -->
  <section class="py-16">
    <div class="container px-4 text-center">
      <div class="glass glass-specular rounded-2xl p-12 max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-[var(--color-text-primary)] mb-4">
          Help Shape the Future
        </h2>
        <p class="text-[var(--color-text-secondary)] mb-8 max-w-xl mx-auto">
          Sounio is open source. Contribute code, documentation, or ideas to help us build
          the future of scientific computing.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://github.com/Sounio-lang/sounio"
            class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-text-primary)] text-[var(--color-surface-primary)] rounded-xl font-semibold hover:opacity-90 transition-opacity"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
          <a
            href="https://github.com/Sounio-lang/sounio/discussions"
            class="inline-flex items-center gap-2 px-6 py-3 border border-[var(--glass-border)] rounded-xl font-semibold hover:border-[var(--color-accent-gold)] transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            Join Discussions
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
