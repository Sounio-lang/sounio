      y: 28, opacity: 0, stagger: 0.09, duration: 0.6, ease: 'power2.out',
      scrollTrigger: { trigger: '#verified-snapshot', start: 'top 76%', once: true },
    });

    // Each proof section — generic cascade by section ID
    ['#theorem-168', '#fixed-point', '#compile-fail-vancomycin', '#test-gate', '#lean-proofs'].forEach((id) => {
      const el = document.querySelector(id);
      if (!el) return;
      gsap.from(el.querySelectorAll(':scope > .container > *'), {
        y: 20, opacity: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 76%', once: true },
