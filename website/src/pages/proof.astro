---
import BaseLayout from '../layouts/BaseLayout.astro';
import SounioCode from '../components/SounioCode.astro';
import ArtifactStatusTable from '../components/status/ArtifactStatusTable.astro';
import { getProofData } from '../lib/proofData';
import { publicContract } from '../data/artifactStatus';
import { getLocaleFromUrl, loadTranslations, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const proofBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_proof_title || "Proof",
      "item": new URL(getLocalizedPath('/proof', locale), Astro.site).toString()
    }
  ]
};

const proofHub = getProofData();
const { bootstrap, metrics } = publicContract;
const gate = metrics.stdlibReliabilityGate;
const fullSuite = metrics.fullTestSuite;

const proofOverviewCards = [
  {
    title: locale === 'pt' ? 'Portão vancomicina ε' : 'Vancomycin ε gate',
    value: 'Compile-time',
    detail: locale === 'pt'
      ? 'Fixtures compile-fail rejeitam dosagem com ε abaixo do limiar ASHP (≥ 0.82)'
      : 'Compile-fail fixtures reject dosing below ASHP threshold (ε ≥ 0.82)',
  },
  {
    title: locale === 'pt' ? 'Fiabilidade stdlib' : 'Stdlib reliability',
    value: `${proofHub.stdlib.passCount}/${proofHub.stdlib.totalCount}`,
    detail: `${proofHub.stdlib.activeModuleEntrypoints} active entrypoints`,
  },
  {
    title: locale === 'pt' ? 'Proveniência de release' : 'Release provenance',
    value: `v${proofHub.release.version}`,
    detail: proofHub.release.statusLabel,
  },
  {
    title: locale === 'pt' ? 'Contrato GPU público' : 'GPU public contract',
    value: `${proofHub.gpu.publicPassCount}/${proofHub.gpu.publicCheckCount}`,
    detail: `${proofHub.gpu.attestedTargetCount} attested binary targets`,
  },
];

const vancomycinSource = `//@ compile-fail
//@ error-pattern: ε

// Vancomycin prescription safety: compile-time ε-bound enforcement.
//
// ASHP 2020 §8.3 mandates ε >= 0.82 before AUC-guided dosing is permitted.
// A dose derived solely from Cockcroft-Gault (ε=0.40, CV ~60%) is too uncertain.
// The compiler must reject assignment to the prescription slot at compile time.

// Prescribing function: only accepts dose estimates with ε >= 0.82.
fn prescribe_vancomycin(dose: Knowledge[f64, ε >= 0.82]) with IO {
    println("Vancomycin prescribed")
}

fn main() with IO {
    // CrCl-derived dose: 40% confidence only (severe renal impairment + age 84,
    // CG formula CV >> 28%, multiple co-morbidities).
    let risky_dose: Knowledge[f64, ε=0.40] = Knowledge { value: 500.0, epsilon: 0.40 }

    // ERROR: ε=0.40 violates the ε >= 0.82 lower bound required by
    // prescribe_vancomycin.  The compiler must reject this call.
    prescribe_vancomycin(risky_dose)
}`;
---

<BaseLayout
  title={t.page_proof_title}
  description={t.page_proof_desc}
  schema={proofBreadcrumbSchema}
>
  <div class="pt-32 pb-24 min-h-screen bg-[#020617]">
    <div class="container max-w-[960px]">
      <header class="mb-16 md:mb-24">
        <h1 class="font-mono text-5xl md:text-7xl font-medium tracking-tight mb-6 text-white" style="view-transition-name: proof-title">
          >_ <span class="text-[var(--color-accent-gold)]">Proof.</span>
        </h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl font-sans font-light">
          {locale === 'pt'
            ? 'Atalho para revisores e comités clínicos. Cada secção liga a um ficheiro no repositório, a um comando reproduzível e a uma citação directa do compilador.'
            : 'This page is the reviewer\'s shortcut. Every section below links to a specific file in the repository, a specific command you can run, and a direct quote from the compiler.'}
        </p>
      </header>

      <div class="grid gap-8">
        <div class="glass glass-specular rounded-2xl p-8 border border-[rgba(255,255,255,0.1)] bg-[#0B1E3A]/40 backdrop-blur-xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[var(--color-accent-gold)] to-[var(--color-accent-teal)]"></div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-mono text-2xl text-white">01_vancomycin_gate</h2>
            <span class="font-mono text-sm text-[var(--color-accent-gold)] px-3 py-1 rounded-full border border-[var(--color-accent-gold)]/30 bg-[var(--color-accent-gold)]/10">VERIFIED</span>
          </div>
          <p class="text-[var(--color-text-secondary)] font-sans mb-6">
            Compile-time rejection of under-confident dosing. ASHP 2020 §8.3 requires ε ≥ 0.82 for AUC-guided vancomycin dosing.
          </p>
          <SounioCode code={vancomycinSource} title="tests/compile-fail/vancomycin_low_conf.sio" />
        </div>

        <div class="glass glass-specular rounded-2xl p-8 border border-[rgba(255,255,255,0.1)] bg-[#0B1E3A]/40 backdrop-blur-xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[var(--color-accent-purple)] to-[var(--color-accent-blue)]"></div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-mono text-2xl text-white">02_theorem_168</h2>
            <span class="font-mono text-sm text-[var(--color-accent-purple)] px-3 py-1 rounded-full border border-[var(--color-accent-purple)]/30 bg-[var(--color-accent-purple)]/10">VERIFIED</span>
          </div>
          <p class="text-[var(--color-text-secondary)] font-sans mb-6">
            The 168 Theorem. Computational proof of the 168 Fano plane automorphisms in the octonions.
          </p>
          <div class="flex gap-4">
            <a href="https://github.com/agourakis82/168-sedenion-bijection" target="_blank" class="font-mono text-sm text-white hover:text-[var(--color-accent-purple)] transition-colors underline underline-offset-4">Verify in Python</a>
            <a href="https://github.com/sounio-lang/sounio/tree/main/stdlib/algebra" target="_blank" class="font-mono text-sm text-white hover:text-[var(--color-accent-purple)] transition-colors underline underline-offset-4">Verify in Sounio</a>
          </div>
        </div>

        <div class="glass glass-specular rounded-2xl p-8 border border-[rgba(255,255,255,0.1)] bg-[#0B1E3A]/40 backdrop-blur-xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[var(--color-accent-green)] to-[var(--color-accent-teal)]"></div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-mono text-2xl text-white">03_self_hosted_bootstrap</h2>
            <span class="font-mono text-sm text-[var(--color-accent-green)] px-3 py-1 rounded-full border border-[var(--color-accent-green)]/30 bg-[var(--color-accent-green)]/10">VERIFIED</span>
          </div>
          <p class="text-[var(--color-text-secondary)] font-sans mb-6">
            Self-hosted bit-identical bootstrap. The compiler compiles itself exactly.
          </p>
          <pre class="rounded-xl bg-[#020617] text-[#d4d4d4] text-sm font-mono p-6 overflow-x-auto border border-white/10"><code>{`# Verify
sha256sum gen2.elf gen3.elf

# Expected: identical hashes
# Recorded: ${bootstrap.recordedSha256 ?? "see CHANGELOG.md"}`}</code></pre>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
