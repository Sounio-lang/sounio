      y: 22, opacity: 0, stagger: 0.12, duration: 0.65, ease: 'power2.out',
      scrollTrigger: { trigger: '.section-shell.pt-\\[clamp\\(3rem\\,8vw\\,5rem\\)\\]', start: 'top 80%', once: true },
    });

    // Snapshot cards
