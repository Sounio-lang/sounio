---
import BaseLayout from '../layouts/BaseLayout.astro';
import SounioCode from '../components/SounioCode.astro';
import ArtifactStatusTable from '../components/status/ArtifactStatusTable.astro';
import EpistemicGateExhibit from '../components/proof/EpistemicGateExhibit.astro';
import { getProofData } from '../lib/proofData';
import { publicContract } from '../data/artifactStatus';
import { getLocaleFromUrl, loadTranslations, getLocalizedPath } from '../lib/i18n';
import {
  escapeActiveEntrypoints,
  escapeAttestedTargets,
  escapeFullSuiteSentence,
  escapeReleaseVersion,
} from '../lib/claimEscapes';
import { gpuFace, gpuMayPrint, gpuRefusal, gpuShortRefusal } from '../lib/gpuPublicHonesty';
import { reliabilityFace, reliabilityMayPrint, reliabilityRefusal, reliabilityShortRefusal } from '../lib/stdlibReliabilityHonesty';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const proofBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_proof_title || "Proof",
      "item": new URL(getLocalizedPath('/proof', locale), Astro.site).toString()
    }
  ]
};

const proofHub = getProofData();
const { bootstrap } = publicContract;
const reliabilityOk = reliabilityMayPrint();
const reliabilityShown = reliabilityOk ? reliabilityFace() : reliabilityRefusal();

const proofOverviewCards = [
  {
    title: locale === 'pt' ? 'Portão vancomicina ε' : 'Vancomycin ε gate',
    value: 'Compile-time',
    detail: locale === 'pt'
      ? 'Fixtures compile-fail rejeitam dosagem com ε abaixo do limiar ASHP (≥ 0.82)'
      : 'Compile-fail fixtures reject dosing below ASHP threshold (ε ≥ 0.82)',
  },
  {
    title: locale === 'pt' ? 'Fiabilidade stdlib' : 'Stdlib reliability',
    value: reliabilityOk ? reliabilityFace() : reliabilityShortRefusal(),
    detail: `${escapeActiveEntrypoints()} active entrypoints`,
  },
  {
    title: locale === 'pt' ? 'Proveniência de release' : 'Release provenance',
    value: escapeReleaseVersion(),
    detail: proofHub.release.statusLabel,
  },
  {
    title: locale === 'pt' ? 'Contrato GPU público' : 'GPU public contract',
    value: gpuMayPrint() ? gpuFace() : gpuShortRefusal(),
    detail: gpuMayPrint()
      ? `${escapeAttestedTargets()} attested binary targets`
      : gpuRefusal(),
  },
];

const vancomycinSource = `//@ compile-fail
//@ error-pattern: ε

// Vancomycin prescription safety: compile-time ε-bound enforcement.
//
// ASHP 2020 §8.3 mandates ε >= 0.82 before AUC-guided dosing is permitted.
// A dose derived solely from Cockcroft-Gault (ε=0.40, CV ~60%) is too uncertain.
// The compiler must reject assignment to the prescription slot at compile time.

// Prescribing function: only accepts dose estimates with ε >= 0.82.
fn prescribe_vancomycin(dose: Knowledge[f64, ε >= 0.82]) with IO {
    println("Vancomycin prescribed")
}

fn main() with IO {
    // CrCl-derived dose: 40% confidence only (severe renal impairment + age 84,
    // CG formula CV >> 28%, multiple co-morbidities).
    let risky_dose: Knowledge[f64, ε=0.40] = Knowledge { value: 500.0, epsilon: 0.40 }

    // ERROR: ε=0.40 violates the ε >= 0.82 lower bound required by
    // prescribe_vancomycin.  The compiler must reject this call.
    prescribe_vancomycin(risky_dose)
}`;
---

<BaseLayout
  title={t.page_proof_title}
  description={t.page_proof_desc}
  schema={proofBreadcrumbSchema}
>

  {/* ═══════════════════════════════════════════════════════════════
      HEADER
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell pt-[clamp(3rem,8vw,5rem)]">
    <div class="container max-w-[780px]">
      <span class="badge-pill mb-[1rem]">{locale === 'pt' ? 'Evidência' : 'Evidence'}</span>
      <h1 class="font-display text-[clamp(2.4rem,5.5vw,4rem)] font-[400] leading-[1.1] tracking-[-0.015em] text-[var(--color-text-primary)] mb-[1.2rem]">
        {locale === 'pt' ? 'O compilador não aceita a sua palavra.' : 'The compiler doesn\'t take your word for it.'}
      </h1>
      <p class="text-[0.97rem] text-[var(--color-text-secondary)] max-w-[64ch] leading-[1.75]">
        {locale === 'pt'
          ? 'Atalho para revisores e comités clínicos. Cada secção liga a um ficheiro no repositório, a um comando reproduzível e — quando possível — a uma citação directa do compilador ou do test runner.'
          : 'Five claims with receipts. Every section links to a file in the repository, a command you can run, and — where possible — a direct quote from the compiler or test runner.'}
      </p>
    </div>
  </section>

  <EpistemicGateExhibit locale={locale} />

  {/* ═══════════════════════════════════════════════════════════════
      SNAPSHOT (from committed artifacts — same source as /lib/proofData)
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell pt-0 pb-[1.5rem]" id="verified-snapshot" aria-labelledby="proof-snapshot-heading">
    <div class="container max-w-[960px] grid gap-[1.2rem]">
      <h2 id="proof-snapshot-heading" class="sr-only">Verified snapshot from repository artifacts</h2>
      <div class="grid gap-[1rem] sm:grid-cols-2 lg:grid-cols-4">
        {proofOverviewCards.map((item) => (
          <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.35rem]">
            <span class="text-[0.72rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">{item.title}</span>
            <strong class="font-serif text-[1.55rem] leading-[1.1] text-[var(--color-text-primary)]">{item.value}</strong>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.55]">{item.detail}</p>
          </article>
        ))}
      </div>

      <div class="grid gap-[1rem] lg:grid-cols-2">
        <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.15rem] grid gap-[0.65rem]">
          <span class="text-[0.72rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-accent-gold-soft)]">Boundaries</span>
          <h3 class="text-[1.15rem] font-[680] text-[var(--color-text-primary)]">What is still intentionally bounded.</h3>
          <ul class="list-disc pl-[1.15rem] text-[0.88rem] text-[var(--color-text-secondary)] grid gap-[0.45rem]">
            {proofHub.boundaries.map((boundary) => (
              <li>{boundary}</li>
            ))}
          </ul>
        </article>

        <article class="glass rounded-[var(--radius-xl)] p-[1.15rem] grid gap-[0.65rem] border border-[var(--glass-border)]">
          <span class="text-[0.72rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-accent-gold-soft)]">Source artifacts</span>
          <h3 class="text-[1.15rem] font-[680] text-[var(--color-text-primary)]">Files this page reads.</h3>
          <ul class="grid gap-[0.65rem] list-none p-0 m-0">
            {proofHub.sources.map((source) => (
              <li class="grid gap-[0.2rem]">
                <strong class="text-[0.88rem] text-[var(--color-text-primary)]">{source.label}</strong>
                <code class="text-[0.78rem] rounded-[var(--radius-md)] border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] px-[0.45rem] py-[0.35rem] text-[var(--color-text-secondary)] [overflow-wrap:anywhere]">{source.path}</code>
                <span class="text-[0.74rem] text-[var(--color-text-tertiary)]">{source.status}{source.generatedAtUtc ? ` · ${source.generatedAtUtc}` : ''}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <div class="grid gap-[0.75rem] lg:grid-cols-2">
        <article class="glass rounded-[var(--radius-xl)] p-[1.15rem] grid gap-[0.5rem] border border-[var(--glass-border)]">
          <span class="text-[0.72rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-accent-gold-soft)]">Release attestation</span>
          <p class="text-[0.9rem] text-[var(--color-text-secondary)] leading-[1.65]">
            Published provenance reports <strong class="text-[var(--color-text-primary)]">{proofHub.release.status}</strong> for
            <strong class="text-[var(--color-text-primary)]"> {escapeReleaseVersion()}</strong>.
          </p>
          {proofHub.release.assetUrl && (
            <p>
              <a href={proofHub.release.assetUrl} target="_blank" rel="noopener noreferrer" class="text-[0.88rem] font-[650] text-[var(--color-accent-gold-soft)] hover:underline">
                Open published binary artifact →
              </a>
            </p>
          )}
          {proofHub.release.sha256 && (
            <code class="block text-[0.76rem] rounded-[var(--radius-md)] border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] px-[0.55rem] py-[0.45rem] text-[var(--color-text-secondary)] overflow-x-auto">{proofHub.release.sha256}</code>
          )}
        </article>
        <article class="glass rounded-[var(--radius-xl)] p-[1.15rem] grid gap-[0.5rem] border border-[var(--glass-border)]">
          <span class="text-[0.72rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">Operational note</span>
          <p class="text-[0.9rem] text-[var(--color-text-secondary)] leading-[1.65]">
            The trust story is strongest where release provenance, stdlib reliability, and the public GPU contract overlap.
            This hub does not claim equal maturity across every research lane.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════
      LIVE ARTIFACT STATUS
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell pt-0 pb-[2rem]">
    <div class="container max-w-[780px] grid gap-[1.5rem]">
      <div class="grid gap-[0.4rem]">
        <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">§0</span>
        <h2 class="text-[1.6rem] font-[700] leading-[1.2] text-[var(--color-text-primary)]">
          Live artifact status
        </h2>
      </div>
      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        These tables are generated directly from committed artifact JSONs in the
        repository. They are not hand-curated marketing copy. If a feature is
        marked <strong>Verified</strong>, the artifact gate passed. If it is
        <strong>Blocked</strong>, the artifact gate failed and the reason is
        quoted from the test runner.
      </p>
      <ArtifactStatusTable category="compiler" title="Compiler & Toolchain" />
      <ArtifactStatusTable category="stdlib" title="Standard Library & Science Lanes" />
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ═══════════════════════════════════════════════════════════════
      TOC NAV
  ═══════════════════════════════════════════════════════════════ */}
  <section class="section-shell pt-0 pb-[2rem]">
    <div class="container max-w-[780px]">
      <nav aria-label="Sections on this page">
        <ol class="flex flex-col gap-[0.35rem] text-[0.88rem] text-[var(--color-text-secondary)] list-decimal list-inside">
          <li><a href="#compile-fail-vancomycin" class="hover:underline text-[var(--color-accent-gold-soft)]">{locale === 'pt' ? 'Recusa em compilação de dosagem sub-confiante' : 'Compile-time rejection of under-confident dosing'}</a></li>
          <li><a href="#theorem-168" class="hover:underline text-[var(--color-accent-gold-soft)]">{locale === 'pt' ? 'Teorema 168' : 'The 168 Theorem'}</a></li>
          <li><a href="#fixed-point" class="hover:underline text-[var(--color-accent-gold-soft)]">{locale === 'pt' ? 'Bootstrap self-hosted bit-idêntico' : 'Self-hosted bit-identical bootstrap'}</a></li>
          <li><a href="#test-gate" class="hover:underline text-[var(--color-accent-gold-soft)]">{locale === 'pt' ? 'Portão de testes da stdlib' : 'Standard library test gate'}</a></li>
          <li><a href="#lean-proofs" class="hover:underline text-[var(--color-accent-gold-soft)]">{locale === 'pt' ? 'Verificação Lean 4 de invariantes epistémicos' : 'Lean 4 verification of epistemic invariants'}</a></li>
        </ol>
      </nav>
    </div>
  </section>

  {/* divider */}
  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 1 — THE 168 THEOREM
  ═══════════════════════════════════════════════════════════════ */}
  <section id="theorem-168" class="section-shell scroll-mt-[5rem]">
    <div class="container max-w-[780px] grid gap-[1.2rem]">
      <div class="grid gap-[0.4rem]">
        <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">§1</span>
        <h2 class="text-[1.6rem] font-[700] leading-[1.2] text-[var(--color-text-primary)]">
          The 168 Theorem
        </h2>
      </div>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        While developing Sounio's octonion backend, we found a combinatorial
        fact that does not appear to have been stated explicitly in the
        literature: the number of ordered triples (i, j, k) in {'{1,…,7}'}³ for
        which the octonion associator [e<sub>i</sub>, e<sub>j</sub>, e<sub>k</sub>] is nonzero is exactly
        168 = |PSL(2,7)|. The decomposition reads 343 = 133 + 42 + 168.
      </p>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        The computation was performed in Sounio and independently reproduced
        in Python/NumPy. Verification repository:
        <a href="https://github.com/agourakis82/168-sedenion-bijection" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-gold-soft)] hover:underline">agourakis82/168-sedenion-bijection</a>
        (14/14 pytest passing).
      </p>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        Paper: <em>"The 168 Theorem: PSL(2,7) Governs Non-Associativity and
        Zero-Divisor Structure in the Cayley-Dickson Tower"</em> — Agourakis &amp;
        Gerenutti (2026). Submitted to <em>Advances in Applied Clifford Algebras</em>.
      </p>

      <div class="flex flex-wrap gap-[0.6rem] text-[0.85rem]">
        <a
          href="https://github.com/agourakis82/168-sedenion-bijection"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.35rem] px-[0.9rem] py-[0.45rem] rounded-full border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          Verification repo →
        </a>
        <a
          href="https://github.com/sounio-lang/sounio/tree/main/stdlib/algebra"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.35rem] px-[0.9rem] py-[0.45rem] rounded-full border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          Sounio implementation (stdlib/algebra/) →
        </a>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 2 — SELF-HOSTED FIXED POINT
  ═══════════════════════════════════════════════════════════════ */}
  <section id="fixed-point" class="section-shell scroll-mt-[5rem]">
    <div class="container max-w-[780px] grid gap-[1.2rem]">
      <div class="grid gap-[0.4rem]">
        <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">§2</span>
        <h2 class="text-[1.6rem] font-[700] leading-[1.2] text-[var(--color-text-primary)]">
          Self-hosted bit-identical bootstrap
        </h2>
      </div>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        Sounio bootstraps from a 2,792-line C compiler (<code class="font-mono text-[0.88em] bg-[rgba(255,255,255,0.07)] px-[0.3em] py-[0.1em] rounded">bootstrap/stage0.c</code>) through
        a multi-stage chain into a self-hosted compiler. Stage 2 and Stage 3
        produce byte-identical binaries — the canonical definition of a
        self-hosted fixed point. This was achieved on 2026-03-23.
      </p>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        Reproduce:
      </p>
      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.88rem] font-mono p-[1rem] overflow-x-auto leading-relaxed border border-white/10"><code>{`# Stage 0 → gen1 (from C compiler)
./artifacts/self-hosted/souc-self-hosted-x86_64 \\
    self-hosted/compiler/lean_single.sio gen1.elf

# gen1 → gen2 (first self-hosted compile)
./gen1.elf self-hosted/compiler/lean_single.sio gen2.elf

# gen2 → gen3 (fixed-point check)
./gen2.elf self-hosted/compiler/lean_single.sio gen3.elf

# Verify
sha256sum gen2.elf gen3.elf`}</code></pre>

      <p class="text-[0.88rem] text-[var(--color-text-tertiary)] leading-[1.6]">
        Expected: identical hashes. Recorded fixed-point SHA-256 (CHANGELOG): <code class="font-mono text-[0.85em]">{bootstrap.recordedSha256 ?? "see CHANGELOG.md"}</code>{bootstrap.recordedSizeKb ? ` (${bootstrap.recordedSizeKb} KB)` : ""}. Cycle parity artifact: {String(bootstrap.cycleParity)}.
      </p>

      <div class="flex flex-wrap gap-[0.6rem] text-[0.85rem]">
        <a
          href="https://github.com/sounio-lang/sounio/tree/main/bootstrap"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.35rem] px-[0.9rem] py-[0.45rem] rounded-full border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          bootstrap/ →
        </a>
        <a
          href="https://github.com/sounio-lang/sounio/blob/main/.github/workflows/ci.yml"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.35rem] px-[0.9rem] py-[0.45rem] rounded-full border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          CI: "Verify self-hosting fixed-point" job →
        </a>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 3 — VANCOMYCIN COMPILE-FAIL
  ═══════════════════════════════════════════════════════════════ */}
  <section id="compile-fail-vancomycin" class="section-shell scroll-mt-[5rem]">
    <div class="container max-w-[780px] grid gap-[1.2rem]">
      <div class="grid gap-[0.4rem]">
        <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">§3</span>
        <h2 class="text-[1.6rem] font-[700] leading-[1.2] text-[var(--color-text-primary)]">
          Compile-time rejection of under-confident dosing
        </h2>
      </div>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        ASHP 2020 §8.3 requires ε ≥ 0.82 for AUC-guided vancomycin dosing. The
        Sounio test <code class="font-mono text-[0.88em] bg-[rgba(255,255,255,0.07)] px-[0.3em] py-[0.1em] rounded">tests/compile-fail/vancomycin_low_conf.sio</code> attempts to pass
        a value with ε = 0.40 to a function with the signature
        <code class="font-mono text-[0.88em] bg-[rgba(255,255,255,0.07)] px-[0.3em] py-[0.1em] rounded">fn prescribe_vancomycin(dose: Knowledge[f64, ε &gt;= 0.82])</code>.
        The compiler rejects the program. Not a lint, not a test suite — the
        type checker refuses to emit the program.
      </p>

      <SounioCode code={vancomycinSource} title="tests/compile-fail/vancomycin_low_conf.sio" />

      <div class="grid gap-[0.5rem]">
        <p class="text-[0.88rem] font-[600] text-[var(--color-text-secondary)]">
          Compiler output (captured from <code class="font-mono text-[0.85em]">./bin/souc check tests/compile-fail/vancomycin_low_conf.sio</code>):
        </p>
        <pre class="rounded-[var(--radius-lg)] bg-[#1a0a0a] text-[#ff8080] text-[0.88rem] font-mono p-[1rem] overflow-x-auto leading-relaxed border border-[rgba(255,80,80,0.2)]"><code>{`error: Type mismatch — expected confidence level not satisfied: Knowledge ε boundary violation at line 27

typecheck: failed`}</code></pre>
        <p class="text-[0.8rem] text-[var(--color-text-tertiary)] leading-[1.6]">
          Exit code: 1. Output captured 2026-04-20. The gate criterion <code class="font-mono text-[0.82em]">//@ error-pattern: ε</code> is satisfied.
        </p>
      </div>

      <div class="flex flex-wrap gap-[0.6rem] text-[0.85rem]">
        <a
          href="https://github.com/sounio-lang/sounio/blob/main/tests/compile-fail/vancomycin_low_conf.sio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.35rem] px-[0.9rem] py-[0.45rem] rounded-full border border-[var(--glass-border)] bg-[rgba(255,255,255,0.04)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          Source file →
        </a>
      </div>
    </div>
  </section>

  <div class="border-t border-[var(--glass-border)]"></div>

  {/* ═══════════════════════════════════════════════════════════════
      SECTION 4 — TEST GATE
  ═══════════════════════════════════════════════════════════════ */}
  <section id="test-gate" class="section-shell scroll-mt-[5rem]">
    <div class="container max-w-[780px] grid gap-[1.2rem]">
      <div class="grid gap-[0.4rem]">
        <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">§4</span>
        <h2 class="text-[1.6rem] font-[700] leading-[1.2] text-[var(--color-text-primary)]">
          Standard library test gate
        </h2>
      </div>

      <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75]">
        The committed stdlib reliability gate reports <strong class="text-[var(--color-text-primary)]">{reliabilityShown}</strong> (source: <code class="font-mono text-[0.85em]">{publicContract.metrics.stdlibReliabilityGate.artifact}</code>).{escapeFullSuiteSentence()} If this page disagrees with README.md or the artifacts, those sources win.
      </p>

      <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.88rem] font-mono p-[1rem] overflow-x-auto leading-relaxed border border-white/10"><code>{reliabilityOk
        ? `$ bash scripts/stdlib_reliability_gate.sh\n\n${reliabilityFace()}`
        : `$ bash scripts/stdlib_reliability_gate.sh\n\n${reliabilityRefusal()}\n# numeral withheld — engine unnamed, not in CI`}</code></pre>

      <div class="flex flex-wrap gap-[0.6rem] text-[0.85rem]">
        <a
          href="https://github.com/sounio-lang/sounio/blob/main/scripts/run_sio_test_suite.sh"
          target="_blank"
          rel="noopener noreferrer"
