---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import DissertationViewer from '../../components/dissertation/DissertationViewer';
import { getLocaleFromUrl, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
---

<BaseLayout
  title={t.page_dissertation_title.replace(/<[^>]+>/g, '')}
  description={t.page_dissertation_subtitle}
  localizedAlternates={false}
  removeTopPadding={true}
>
  <PageHero
    badge={t.page_dissertation_badge}
    title={t.page_dissertation_title}
    subtitle={t.page_dissertation_subtitle}
    mascot="yiayia"
    compact={true}
  />

  <section class="section-shell page-body">
    <div class="container">
      <DissertationViewer client:only="react" />
      <p class="dissertation-note">
        Numerical parity with the Sounio <code>tsit5_pbpk14</code> reference solver is enforced by
        <code>scripts/ci/dissertation_frontend_parity_gate.sh</code>. The figures shown here are
        bit-traceable to the committed gates that run on every push to <code>main</code>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-body {
    background: #020617;
  }

  .dissertation-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    line-height: 1.6;
  }
</style>
