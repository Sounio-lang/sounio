---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DissertationViewer from '../../components/dissertation/DissertationViewer';
import { frontendParityRefusal } from '../../lib/dissertationWiredHonesty';
---

<BaseLayout
  title="Dissertation — Rapamycin / Cypher DES PBPK"
  description="Interactive 3D visualization of the rapamycin drug-eluting-stent 14-compartment PBPK dissertation: GUM-through-ODE, compile-time confidence gates, and ISO uncertainty budgets — all live in the browser."
  localizedAlternates={false}
>
  <section class="section-shell dissertation-hero relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/85 via-[var(--color-bg)]/40 to-[var(--color-bg)]"></div>
    </div>
    <div class="container relative z-10">
      <span class="badge-pill">Dissertation · Master's</span>
      <h1>Rapamycin, the Cypher stent, and the uncertainty you can see.</h1>
      <p>
        A live 14-compartment physiologically-based pharmacokinetic model. Move a slider; watch the
        GUM uncertainty cone widen. Push the dose; watch the compile-time confidence gate trip.
        Three computational contributions — visible, in 3D, in your browser.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <DissertationViewer client:only="react" />
      <p class="text-[0.85rem] text-[var(--color-text-tertiary)] mt-4">
        Numerical parity with the Sounio <code>tsit5_pbpk14</code> reference solver is enforced by
        <code>scripts/ci/dissertation_frontend_parity_gate.sh</code>.
        {frontendParityRefusal()}.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.dissertation-hero .container > *', {
      y: 26, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });
  });
</script>
