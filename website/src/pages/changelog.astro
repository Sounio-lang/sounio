---
import BaseLayout from '../layouts/BaseLayout.astro';

const releases = [
  {
    version: '0.100.0',
    date: '2026-02-03',
    tag: 'Release',
    tagColor: 'emerald',
    changes: [
      { type: 'feature', text: 'Complete genomics module: FPKM/TPM quantification, hypergeometric enrichment, Benjamini-Hochberg FDR' },
      { type: 'feature', text: 'Sequence I/O: FASTA, FASTQ, GFF, VCF, SAM/BAM parsers' },
      { type: 'feature', text: 'Sequence alignment: Smith-Waterman, Needleman-Wunsch, MSA builders' },
      { type: 'feature', text: 'Variant analysis: SNP calling, allele frequency, Ti/Tv ratios' },
      { type: 'feature', text: 'GPU acceleration: CUDA kernels for complement, GF4 addition, k-mer hashing' },
      { type: 'feature', text: 'DeepSeek Math integration for algorithmic verification' },
      { type: 'improvement', text: '23 comprehensive genomics stress tests (all passing)' },
      { type: 'improvement', text: 'Mathematical verification for all core algorithms' },
      { type: 'improvement', text: 'Epistemic uncertainty propagation throughout genomics pipeline' },
    ],
  },
  {
    version: '0.99.0',
    date: '2026-01-15',
    tag: 'Pre-release',
    tagColor: 'amber',
    changes: [
      { type: 'feature', text: 'Algebraic effects with native continuation support' },
      { type: 'feature', text: 'Real effect handlers for IO, Async, and GPU' },
      { type: 'feature', text: 'AArch64 and x86-64 native backends' },
      { type: 'improvement', text: 'CPS transform for multi-shot continuations' },
      { type: 'improvement', text: 'Improved error messages with source context' },
      { type: 'fix', text: 'Linear type checker now handles nested structs correctly' },
    ],
  },
  {
    version: '0.98.0',
    date: '2025-12-01',
    tag: 'Alpha',
    tagColor: 'purple',
    changes: [
      { type: 'feature', text: 'GPU kernel compilation to PTX and SPIR-V' },
      { type: 'feature', text: 'Refinement types with Z3 SMT backend' },
      { type: 'feature', text: 'Units of measure with dimensional analysis' },
      { type: 'improvement', text: 'LSP server with hover and go-to-definition' },
      { type: 'improvement', text: 'Package manager prototype' },
    ],
  },
  {
    version: '0.97.0',
    date: '2025-10-15',
    tag: 'Alpha',
    tagColor: 'purple',
    changes: [
      { type: 'feature', text: 'Knowledge<T> epistemic types' },
      { type: 'feature', text: 'GUM-compliant uncertainty propagation' },
      { type: 'feature', text: 'Provenance tracking system' },
      { type: 'feature', text: 'Effect system (IO, Mut, Alloc, Panic)' },
      { type: 'improvement', text: 'Bidirectional type inference' },
    ],
  },
  {
    version: '0.96.0',
    date: '2025-08-01',
    tag: 'Alpha',
    tagColor: 'purple',
    changes: [
      { type: 'feature', text: 'Linear and affine type checking' },
      { type: 'feature', text: 'Basic LLVM and Cranelift backends' },
      { type: 'feature', text: 'Module system with use statements' },
      { type: 'improvement', text: 'Parser rewrite for better error recovery' },
    ],
  },
  {
    version: '0.95.0',
    date: '2025-05-15',
    tag: 'Prototype',
    tagColor: 'gray',
    changes: [
      { type: 'feature', text: 'Initial compiler implementation' },
      { type: 'feature', text: 'Lexer, parser, and AST' },
      { type: 'feature', text: 'Basic type checker' },
      { type: 'feature', text: 'Tree-walking interpreter' },
    ],
  },
];

const typeIcons: Record<string, string> = {
  feature: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
  improvement: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  fix: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437',
  breaking: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
  security: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
};

const typeColors: Record<string, string> = {
  feature: 'text-[var(--color-accent-gold)]',
  improvement: 'text-[var(--color-accent-orange)]',
  fix: 'text-[var(--color-accent-green)]',
  breaking: 'text-[var(--color-accent-orange)]',
  security: 'text-[var(--color-accent-purple)]',
};

const tagColors: Record<string, string> = {
  amber: 'bg-[rgba(255,159,10,0.1)] text-[var(--color-accent-orange)] border-[rgba(255,159,10,0.2)]',
  purple: 'bg-[rgba(191,90,242,0.1)] text-[var(--color-accent-purple)] border-[rgba(191,90,242,0.2)]',
  emerald: 'bg-[rgba(48,209,88,0.1)] text-[var(--color-accent-green)] border-[rgba(48,209,88,0.2)]',
  gray: 'bg-[rgba(255,255,255,0.04)] text-[var(--color-text-tertiary)] border-[rgba(255,255,255,0.08)]',
};
---

<BaseLayout title="Changelog" description="Release history and version notes for Sounio">
  <!-- Hero -->
  <section class="relative py-20 overflow-hidden bg-[var(--color-surface-primary)]">
    <div class="relative container px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-4">
        Changelog
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)]">
        Release history and version notes
      </p>
    </div>
  </section>

  <!-- Releases -->
  <section class="py-16">
    <div class="container px-4">
      <div class="max-w-3xl mx-auto">
        {releases.map((release, index) => (
          <div class={`relative pl-8 pb-12 ${index < releases.length - 1 ? 'border-l-2 border-[var(--glass-border)]' : ''}`}>
            <!-- Timeline dot -->
            <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-[var(--color-accent-gold)]"></div>

            <!-- Release content -->
            <div class="glass rounded-xl p-6">
              <!-- Release header -->
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">
                  v{release.version}
                </h2>
                <span class={`px-3 py-1 text-xs font-medium rounded-full border ${tagColors[release.tagColor]}`}>
                  {release.tag}
                </span>
                <span class="text-[var(--color-text-secondary)] text-sm">
                  {release.date}
                </span>
              </div>

              <!-- Changes list -->
              <ul class="space-y-2">
                {release.changes.map((change) => (
                  <li class="flex items-start gap-2 text-[var(--color-text-secondary)]">
                    <svg class={`w-4 h-4 flex-shrink-0 mt-0.5 ${typeColors[change.type]}`} fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d={typeIcons[change.type]} />
                    </svg>
                    <span>{change.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Subscribe section -->
  <section class="py-12 border-t border-[var(--glass-border)]">
    <div class="container px-4 text-center">
      <p class="text-[var(--color-text-secondary)] mb-4">
        Want to be notified of new releases?
      </p>
      <a
        href="https://github.com/Sounio-lang/sounio/releases"
        class="inline-flex items-center gap-2 text-[var(--color-accent-gold)] hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Watch releases on GitHub
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
