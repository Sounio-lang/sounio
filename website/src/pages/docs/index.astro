const docSections: Array<{ slug: string; items: string[] }> = [
  { slug: 'getting-started', items: ['getting-started/hello-world', 'getting-started/first-program'] },
  { slug: 'language', items: ['language/variables', 'language/functions', 'language/control-flow'] },
  { slug: 'epistemic', items: ['epistemic/knowledge', 'epistemic/uncertainty', 'epistemic/provenance'] },
  { slug: 'effects', items: ['effects/io', 'effects/custom'] },
  { slug: 'gpu', items: [] },
  { slug: 'units', items: [] },
  { slug: 'stdlib', items: [] },
  { slug: 'tooling', items: ['tooling/lsp'] },
  { slug: 'examples', items: [] },
  { slug: 'compiler', items: ['compiler/lexer-parser', 'compiler/type-system', 'compiler/effect-system', 'compiler/codegen'] },
  { slug: 'spec', items: ['spec/language-spec'] },
];
---

<BaseLayout title={t.docs_title}>
  <div class="py-16 bg-[var(--color-surface-primary)]">
    <div class="container">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-semibold text-[var(--color-text-primary)] mb-4">
          {t.docs_title}
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
          {t.docs_description}
        </p>
      </div>

      <!-- Search -->
      <div class="max-w-2xl mx-auto mb-16">
        <div class="relative">
          <input
            type="search"
            placeholder={t.search_placeholder}
            class="w-full px-4 py-4 pl-12 rounded-xl glass text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-gold)] text-lg"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-[var(--color-text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-[var(--color-text-tertiary)] glass px-2 py-1 rounded">
            {t.search_shortcut}
          </span>
        </div>
      </div>

      <!-- Doc sections grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {docSections.map((section) => (
          <a
            href={hrefFor(section.slug)}
            class="group block p-6 glass glass-specular rounded-2xl border-l-2 border-[var(--color-accent-gold)] hover:scale-[1.01] transition-transform"
          >
            <div class="mb-3">
              <svg class="w-8 h-8 text-[var(--color-accent-gold)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={sectionIcons[section.slug] || sectionIcons['spec']} />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-2 group-hover:text-[var(--color-accent-gold)] transition-colors">
              {titleFor(section.slug)}
            </h2>
            <p class="text-[var(--color-text-secondary)] text-sm mb-4">
              {descriptionFor(section.slug)}
            </p>
            <ul class="space-y-1">
              {section.items.map((slug) => (
                <li class="text-sm text-[var(--color-text-secondary)] flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--color-accent-gold)]"></span>
                  {titleFor(slug)}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>

      <!-- Quick links -->
      <div class="mt-16 p-8 glass-elevated rounded-2xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-accent-gold)]">{t.docs_quick_start_title}</h3>
            <ul class="space-y-2 text-[var(--color-text-secondary)]">
              <li><a href={hrefFor('getting-started')} class="hover:text-[var(--color-text-primary)]">{titleFor('getting-started')}</a></li>
              <li><a href={hrefFor('getting-started/hello-world')} class="hover:text-[var(--color-text-primary)]">{titleFor('getting-started/hello-world')}</a></li>
              <li><a href={getLocalizedPath('/playground', locale)} class="hover:text-[var(--color-text-primary)]">{t.docs_try_playground}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-accent-gold)]">{t.docs_popular_title}</h3>
            <ul class="space-y-2 text-[var(--color-text-secondary)]">
              <li><a href={hrefFor('epistemic')} class="hover:text-[var(--color-text-primary)]">{titleFor('epistemic')}</a></li>
              <li><a href={hrefFor('gpu')} class="hover:text-[var(--color-text-primary)]">{titleFor('gpu')}</a></li>
              <li><a href={hrefFor('effects')} class="hover:text-[var(--color-text-primary)]">{titleFor('effects')}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-accent-gold)]">{t.docs_resources_title}</h3>
            <ul class="space-y-2 text-[var(--color-text-secondary)]">
              <li><a href="https://github.com/sounio-lang/sounio" class="hover:text-[var(--color-text-primary)]">{t.docs_github_repo}</a></li>
              <li><a href={getLocalizedPath('/manifesto', locale)} class="hover:text-[var(--color-text-primary)]">{t.docs_manifesto}</a></li>
              <li><a href="https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md" class="hover:text-[var(--color-text-primary)]">{t.docs_contributing}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
