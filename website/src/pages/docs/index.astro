---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const docSections = [
  {
    title: 'Getting Started',
    description: 'Installation, first steps, and a 5-minute quickstart guide.',
    icon: '🚀',
    href: '/docs/getting-started',
    items: ['Installation', 'Hello World', 'Your First Program', 'Project Structure'],
  },
  {
    title: 'Language Guide',
    description: 'Comprehensive reference for Sounio syntax and semantics.',
    icon: '📖',
    href: '/docs/language',
    items: ['Variables & Types', 'Functions', 'Control Flow', 'Modules'],
  },
  {
    title: 'Epistemic Types',
    description: 'Uncertainty quantification with Knowledge<T> and provenance.',
    icon: '🎯',
    href: '/docs/epistemic',
    items: ['Knowledge<T>', 'Uncertainty Propagation', 'Confidence Gates', 'Provenance'],
  },
  {
    title: 'Effect System',
    description: 'Algebraic effects for controlled side effects.',
    icon: '⚡',
    href: '/docs/effects',
    items: ['IO Effects', 'Mut Effects', 'Custom Effects', 'Effect Handlers'],
  },
  {
    title: 'GPU Computing',
    description: 'High-performance GPU kernels with native syntax.',
    icon: '🚀',
    href: '/docs/gpu',
    items: ['Kernel Syntax', 'Memory Management', 'CUDA Backend', 'Metal Backend'],
  },
  {
    title: 'Units of Measure',
    description: 'Type-safe dimensional analysis.',
    icon: '📏',
    href: '/docs/units',
    items: ['Unit Definitions', 'Dimensional Analysis', 'Unit Conversions', 'Custom Units'],
  },
  {
    title: 'Standard Library',
    description: 'API documentation for all stdlib modules.',
    icon: '📚',
    href: '/docs/stdlib',
    items: ['Core', 'Collections', 'Math', 'IO'],
  },
  {
    title: 'Examples',
    description: 'Code examples demonstrating language features.',
    icon: '💡',
    href: '/docs/examples',
    items: ['Basics', 'Scientific Computing', 'GPU Programs', 'Real-world Apps'],
  },
];
---

<BaseLayout title="Documentation">
  <div class="py-16 bg-[var(--color-bg)]">
    <div class="container">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-4">
          {t.docs_title}
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          {t.docs_description}
        </p>
      </div>

      <!-- Search -->
      <div class="max-w-2xl mx-auto mb-16">
        <div class="relative">
          <input
            type="search"
            placeholder={t.search_placeholder}
            class="w-full px-4 py-4 pl-12 rounded-xl border border-[var(--color-border)] bg-white dark:bg-[var(--color-bg-alt)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold-500)] shadow-lg text-lg"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] px-2 py-1 rounded">
            {t.search_shortcut}
          </span>
        </div>
      </div>

      <!-- Doc sections grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {docSections.map((section) => (
          <a
            href={section.href}
            class="group block p-6 bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md hover:shadow-xl transition-all border-l-4 border-[var(--color-gold-500)] hover:-translate-y-1"
          >
            <div class="text-3xl mb-3">
              {section.icon}
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)] transition-colors">
              {section.title}
            </h2>
            <p class="text-[var(--color-text-muted)] text-sm mb-4">
              {section.description}
            </p>
            <ul class="space-y-1">
              {section.items.map((item) => (
                <li class="text-sm text-[var(--color-text-muted)] flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--color-gold-500)]"></span>
                  {item}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>

      <!-- Quick links -->
      <div class="mt-16 p-8 bg-gradient-to-r from-[var(--color-navy-900)] to-[var(--color-navy-800)] rounded-2xl text-white">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">Quick Start</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href="/docs/getting-started" class="hover:text-white">Installation Guide</a></li>
              <li><a href="/docs/getting-started/hello-world" class="hover:text-white">Hello World</a></li>
              <li><a href="/playground" class="hover:text-white">Try in Playground</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">Popular Topics</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href="/docs/epistemic" class="hover:text-white">Uncertainty Types</a></li>
              <li><a href="/docs/gpu" class="hover:text-white">GPU Programming</a></li>
              <li><a href="/docs/effects" class="hover:text-white">Effect System</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">Resources</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href="https://github.com/sounio-lang/sounio" class="hover:text-white">GitHub Repository</a></li>
              <li><a href="/manifesto" class="hover:text-white">Project Manifesto</a></li>
              <li><a href="/contributing" class="hover:text-white">Contributing Guide</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
