---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocalizedPath, getLocaleFromUrl, loadTranslations, type Locale } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const DEFAULT_LOCALE: Locale = 'en';
const allDocs = await getCollection('docs');

function candidateDocIds(locale: Locale, slug: string) {
  const clean = slug.replace(/^\/+/, '').replace(/\/+$/, '');
  return [
    `${locale}/${clean}.mdx`,
    `${locale}/${clean}/index.mdx`,
    `${DEFAULT_LOCALE}/${clean}.mdx`,
    `${DEFAULT_LOCALE}/${clean}/index.mdx`,
  ];
}

function findDoc(slug: string) {
  return candidateDocIds(locale, slug)
    .map((id) => allDocs.find((d) => d.id === id))
    .find(Boolean);
}

function titleFor(slug: string) {
  return findDoc(slug)?.data.title ?? slug;
}

function descriptionFor(slug: string) {
  return findDoc(slug)?.data.description ?? '';
}

function hrefFor(slug: string) {
  return getLocalizedPath(`/docs/${slug}`, locale);
}

const docSections: Array<{ slug: string; icon: string; items: string[] }> = [
  {
    slug: 'getting-started',
    icon: '🚀',
    items: ['getting-started/hello-world', 'getting-started/first-program'],
  },
  {
    slug: 'language',
    icon: '📖',
    items: ['language/variables', 'language/functions', 'language/control-flow'],
  },
  {
    slug: 'epistemic',
    icon: '🎯',
    items: ['epistemic/knowledge', 'epistemic/uncertainty', 'epistemic/provenance'],
  },
  {
    slug: 'effects',
    icon: '⚡',
    items: ['effects/io', 'effects/custom'],
  },
  {
    slug: 'gpu',
    icon: '🚀',
    items: [],
  },
  {
    slug: 'units',
    icon: '📏',
    items: [],
  },
  {
    slug: 'stdlib',
    icon: '📚',
    items: [],
  },
  {
    slug: 'tooling',
    icon: '🛠️',
    items: ['tooling/lsp'],
  },
  {
    slug: 'examples',
    icon: '💡',
    items: [],
  },
  {
    slug: 'compiler',
    icon: '🏗️',
    items: [
      'compiler/lexer-parser',
      'compiler/type-system',
      'compiler/effect-system',
      'compiler/codegen',
    ],
  },
  {
    slug: 'spec',
    icon: '📜',
    items: ['spec/language-spec'],
  },
];
---

<BaseLayout title={t.docs_title}>
  <div class="py-16 bg-[var(--color-bg)]">
    <div class="container">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-4">
          {t.docs_title}
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          {t.docs_description}
        </p>
      </div>

      <!-- Search -->
      <div class="max-w-2xl mx-auto mb-16">
        <div class="relative">
          <input
            type="search"
            placeholder={t.search_placeholder}
            class="w-full px-4 py-4 pl-12 rounded-xl border border-[var(--color-border)] bg-white dark:bg-[var(--color-bg-alt)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold-500)] shadow-lg text-lg"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-6 h-6 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] px-2 py-1 rounded">
            {t.search_shortcut}
          </span>
        </div>
      </div>

      <!-- Doc sections grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {docSections.map((section) => (
          <a
            href={hrefFor(section.slug)}
            class="group block p-6 bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md hover:shadow-xl transition-all border-l-4 border-[var(--color-gold-500)] hover:-translate-y-1"
          >
            <div class="text-3xl mb-3">
              {section.icon}
            </div>
            <h2 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)] transition-colors">
              {titleFor(section.slug)}
            </h2>
            <p class="text-[var(--color-text-muted)] text-sm mb-4">
              {descriptionFor(section.slug)}
            </p>
            <ul class="space-y-1">
              {section.items.map((slug) => (
                <li class="text-sm text-[var(--color-text-muted)] flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--color-gold-500)]"></span>
                  {titleFor(slug)}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>

      <!-- Quick links -->
      <div class="mt-16 p-8 bg-gradient-to-r from-[var(--color-navy-900)] to-[var(--color-navy-800)] rounded-2xl text-white">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">{t.docs_quick_start_title}</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href={hrefFor('getting-started')} class="hover:text-white">{titleFor('getting-started')}</a></li>
              <li><a href={hrefFor('getting-started/hello-world')} class="hover:text-white">{titleFor('getting-started/hello-world')}</a></li>
              <li><a href={getLocalizedPath('/playground', locale)} class="hover:text-white">{t.docs_try_playground}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">{t.docs_popular_title}</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href={hrefFor('epistemic')} class="hover:text-white">{titleFor('epistemic')}</a></li>
              <li><a href={hrefFor('gpu')} class="hover:text-white">{titleFor('gpu')}</a></li>
              <li><a href={hrefFor('effects')} class="hover:text-white">{titleFor('effects')}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[var(--color-gold-500)]">{t.docs_resources_title}</h3>
            <ul class="space-y-2 text-white/80">
              <li><a href="https://github.com/sounio-lang/sounio" class="hover:text-white">{t.docs_github_repo}</a></li>
              <li><a href={getLocalizedPath('/manifesto', locale)} class="hover:text-white">{t.docs_manifesto}</a></li>
              <li><a href="https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md" class="hover:text-white">{t.docs_contributing}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
