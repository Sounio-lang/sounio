---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    // Remove locale prefix and .mdx extension from slug
    params: { slug: doc.id.replace(/^en\//, '').replace(/\.mdx$/, '') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await doc.render();

// Build sidebar from docs collection
const allDocs = await getCollection('docs');
const sidebar = [
  {
    title: 'Getting Started',
    items: [
      { title: 'Installation', href: '/docs/getting-started' },
      { title: 'Hello World', href: '/docs/hello-world' },
      { title: 'First Program', href: '/docs/first-program' },
    ],
  },
  {
    title: 'Language Guide',
    items: [
      { title: 'Variables & Types', href: '/docs/language/variables' },
      { title: 'Functions', href: '/docs/language/functions' },
      { title: 'Control Flow', href: '/docs/language/control-flow' },
    ],
  },
  {
    title: 'Epistemic Types',
    items: [
      { title: 'Knowledge<T>', href: '/docs/epistemic/knowledge' },
      { title: 'Uncertainty', href: '/docs/epistemic/uncertainty' },
      { title: 'Provenance', href: '/docs/epistemic/provenance' },
    ],
  },
  {
    title: 'Effect System',
    items: [
      { title: 'Introduction', href: '/docs/effects' },
      { title: 'IO Effects', href: '/docs/effects/io' },
      { title: 'Custom Effects', href: '/docs/effects/custom' },
    ],
  },
  {
    title: 'Reference',
    items: [
      { title: 'Standard Library', href: '/docs/stdlib' },
      { title: 'Examples', href: '/docs/examples' },
    ],
  },
];
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  headings={headings}
  sidebar={sidebar}
>
  <Content />
</DocsLayout>
