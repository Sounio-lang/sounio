---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'));
  const slugs = Array.from(
    new Set(
      docs.map((doc) => {
        const noLocale = doc.id.replace(/^en\//, '').replace(/\.mdx$/, '');
        return noLocale.endsWith('/index') ? noLocale.slice(0, -'/index'.length) : noLocale;
      })
    )
  );

  return slugs.map((slug) => ({ params: { slug } }));
}

return Astro.redirect(
  `/learn/${Array.isArray(Astro.params.slug) ? Astro.params.slug.join('/') : (Astro.params.slug ?? '')}`,
  308
);
---
