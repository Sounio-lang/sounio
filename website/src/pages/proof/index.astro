---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProofData } from '../../lib/proofData';

const proof = getProofData();

const overview = [
  {
    title: 'Release provenance',
    value: `v${proof.release.version}`,
    detail: proof.release.statusLabel,
  },
  {
    title: 'Stdlib reliability',
    value: `${proof.stdlib.passCount}/${proof.stdlib.totalCount}`,
    detail: `${proof.stdlib.activeModuleEntrypoints} active entrypoints`,
  },
  {
    title: 'GPU public contract',
    value: `${proof.gpu.publicPassCount}/${proof.gpu.publicCheckCount}`,
    detail: `${proof.gpu.attestedTargetCount} attested binary targets`,
  },
  {
    title: 'Hyper execution',
    value: `${proof.stdlib.hyperPassCount}/${proof.stdlib.hyperTotalCount}`,
    detail: `${proof.gpu.nativeLanePassCount}/${proof.gpu.nativeLaneCount} required native lanes passing`,
  },
];
---

<BaseLayout
  title="Proof"
  description="Current verified snapshot, boundaries, and artifact-backed evidence for the public Sounio surface."
>
  <section class="section-shell proof-hero">
    <div class="container proof-hero-inner">
      <span class="badge-pill">Proof</span>
      <h1>What is verified right now.</h1>
      <p>
        This page is the trust anchor for the public surface. It is built from checked artifacts in the repo rather than
        free-floating marketing copy.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="proof-grid premium-grid">
        {overview.map((item) => (
          <article class="glass glass-specular proof-card">
            <span>{item.title}</span>
            <strong>{item.value}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container proof-columns">
      <article class="glass glass-specular proof-panel">
        <span class="proof-kicker">Current boundaries</span>
        <h2>What is still intentionally bounded.</h2>
        <ul class="proof-list">
          {proof.boundaries.map((boundary) => (
            <li>{boundary}</li>
          ))}
        </ul>
      </article>

      <article class="glass proof-panel">
        <span class="proof-kicker">Source-of-truth artifacts</span>
        <h2>What this page is reading.</h2>
        <ul class="artifact-list">
          {proof.sources.map((source) => (
            <li>
              <strong>{source.label}</strong>
              <code>{source.path}</code>
              <span>{source.status}</span>
              {source.generatedAtUtc && <small>{source.generatedAtUtc}</small>}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container proof-columns">
      <article class="glass glass-specular proof-panel">
        <span class="proof-kicker">Release attestation</span>
        <h2>The currently surfaced core binary is signed.</h2>
        <p>
          The currently published release provenance artifact reports <strong>{proof.release.status}</strong> with the
          attested release at <strong>v{proof.release.version}</strong>.
        </p>
        {proof.release.assetUrl && (
          <p class="proof-inline-link">
            <a href={proof.release.assetUrl} target="_blank" rel="noopener noreferrer">Open published binary artifact</a>
          </p>
        )}
        {proof.release.sha256 && <code class="proof-inline-code">{proof.release.sha256}</code>}
      </article>

      <article class="glass proof-panel">
        <span class="proof-kicker">Runtime and language surface</span>
        <h2>What this means operationally.</h2>
        <p>
          The trust story is currently strongest where release provenance, stdlib reliability, and the public GPU
          contract intersect. That is the slice the site now foregrounds.
        </p>
        <p>
          It does <em>not</em> claim that every research lane or internal surface is equally mature. The whole point of
          this hub is to make those distinctions legible.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .proof-hero-inner {
    max-width: 780px;
    display: grid;
    gap: 0.9rem;
  }

  .proof-hero-inner h1 {
    font-size: clamp(2.3rem, 5.8vw, 4.5rem);
  }

  .proof-hero-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.2vw, 1.14rem);
  }

  .proof-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .proof-card,
  .proof-panel {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
  }

  .proof-card {
    display: grid;
    gap: 0.22rem;
  }

  .proof-card span {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }

  .proof-card strong {
    font-family: var(--font-display);
    font-size: 1.68rem;
    color: var(--color-text-primary);
  }

  .proof-card p,
  .proof-panel p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .proof-columns {
    display: grid;
    gap: 1rem;
  }

  .proof-panel {
    display: grid;
    gap: 0.75rem;
  }

  .proof-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .proof-panel h2 {
    font-size: 1.32rem;
  }

  .proof-list {
    margin: 0;
    padding-left: 1rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.5rem;
  }

  .artifact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .artifact-list li {
    display: grid;
    gap: 0.2rem;
  }

  .artifact-list strong {
    color: var(--color-text-primary);
  }

  .artifact-list code,
  .proof-inline-code {
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 86%, transparent);
    padding: 0.55rem 0.7rem;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .artifact-list span,
  .artifact-list small {
    color: var(--color-text-tertiary);
    font-size: 0.76rem;
  }

  .proof-inline-link a {
    width: fit-content;
    color: var(--color-text-primary);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 42%, transparent);
    padding-bottom: 0.12rem;
    font-size: 0.84rem;
    font-weight: 650;
  }

  @media (min-width: 980px) {
    .proof-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
