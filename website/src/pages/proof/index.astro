---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KineticText } from '../../components/common/KineticText';

const claims = [
  {
    title: 'Show bounded capability, not infinite ambition.',
    body: 'The strongest pages on this site should tell you exactly what surface exists today, what was checked recently, and where the boundary still is.',
  },
  {
    title: 'Route skeptical readers to commands and artifacts fast.',
    body: 'A proof page should collapse the distance between a homepage claim and the repository, release surface, or scientific route that substantiates it.',
  },
  {
    title: 'Keep the storefront under the same discipline as the language.',
    body: 'If a page cannot be defended by artifacts, domain pressure, or a current public contract, it should not be promoted as proof.',
  },
];

const evidence = [
  {
    label: 'Current contract',
    href: '/learn/getting-started',
    body: 'Read the bounded public surface before reading aspiration.',
  },
  {
    label: 'Release surface',
    href: '/releases',
    body: 'Inspect the artifact story instead of trusting marketing language.',
  },
  {
    label: 'Scientific pressure',
    href: '/science',
    body: 'See the routes where research programs are still forcing compiler honesty.',
  },
];
---

<BaseLayout title="Proof" description="How Sounio keeps its storefront honest.">
  <section class="section-shell">
    <div class="container grid gap-[1.2rem]">
      <div class="grid gap-[0.45rem] max-w-[62ch]">
        <p class="text-[0.76rem] uppercase tracking-[0.12em] text-[var(--color-accent-gold-soft)]">Proof discipline</p>
        <h1 class="text-[clamp(2.5rem,6vw,5rem)] font-bold leading-[0.95] text-[var(--color-text-primary)]">
          This page exists to keep the storefront honest.
        </h1>
        <p class="section-subhead">
          The homepage is allowed to be ambitious only if a skeptical reader can land here and immediately find the bounded contract, the strongest artifact surfaces, and the research routes that still exert pressure on the language.
        </p>
      </div>

      <div class="premium-grid grid gap-4 lg:grid-cols-3">
        {claims.map((claim) => (
          <article class="glass glass-specular rounded-[var(--radius-2xl)] p-[1.2rem] grid gap-[0.7rem]">
            <h2 class="text-[1.08rem] font-semibold text-[var(--color-text-primary)]">{claim.title}</h2>
            <p class="text-[0.94rem] leading-relaxed text-[var(--color-text-secondary)]">{claim.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell section-deferred bg-[color-mix(in_srgb,var(--color-bg-alt)_72%,transparent)] border-y border-[var(--glass-border)]">
    <div class="container grid gap-[1.1rem]">
      <KineticText text="Read like a reviewer" />
      <p class="section-subhead max-w-[60ch]">
        Start with the current contract. Then inspect the release surface. Then use the science routes to see whether the language is being pushed by real programs or just by taste.
      </p>

      <div class="grid gap-4 lg:grid-cols-3">
        {evidence.map((item) => (
          <a href={item.href} class="glass rounded-[var(--radius-xl)] p-[1.05rem] grid gap-[0.45rem] hover:-translate-y-px transition-transform">
            <p class="text-[0.74rem] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">{item.label}</p>
            <p class="text-[0.94rem] text-[var(--color-text-secondary)]">{item.body}</p>
            <span class="text-[0.82rem] font-semibold text-[var(--color-accent-gold)]">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
