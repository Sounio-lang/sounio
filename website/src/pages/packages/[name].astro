---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import CodePanel from '../../components/ui/CodePanel.astro';
import Tag from '../../components/ui/Tag.astro';
import { registryPackages } from '../../data/registryPackages';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

export async function getStaticPaths() {
  return registryPackages.map((pkg) => ({ params: { name: pkg.name }, props: { pkg } }));
}

const { pkg } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const installCmd = `souc add ${pkg.name}`;
---

<BaseLayout title={`Package: ${pkg.name}`} description={pkg.description}>
  <Section>
    <Container class="package-detail-shell grid gap-[0.9rem]">
      <Button href={getLocalizedPath('/packages', locale)} variant="ghost" size="sm">
        Back to Packages
      </Button>

      <article class="glass glass-specular grid gap-4 rounded-[var(--radius-xl)] p-[1.2rem]">
        <div class="flex flex-wrap items-start justify-between gap-[0.8rem]">
          <div>
            <h1 class="font-mono text-[clamp(1.55rem,4vw,2.4rem)]">{pkg.name}</h1>
            <p class="mt-[0.45rem] text-[var(--color-ink-2)]">{pkg.description}</p>
          </div>
          <span class="text-[0.8rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">v{pkg.version}</span>
        </div>

        <div class="grid gap-[0.8rem] [grid-template-columns:repeat(auto-fit,minmax(190px,1fr))]">
          <div class="rounded-[var(--radius-lg)] border border-[var(--color-line)] p-[0.8rem]">
            <h2 class="mb-2 font-[var(--font-sans)] text-[0.75rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Downloads</h2>
            <p class="text-[1rem] text-[var(--color-ink-1)]">{pkg.downloads.toLocaleString()}</p>
          </div>
          <div class="rounded-[var(--radius-lg)] border border-[var(--color-line)] p-[0.8rem]">
            <h2 class="mb-2 font-[var(--font-sans)] text-[0.75rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Status</h2>
            <p class="text-[1rem] text-[var(--color-ink-1)]">{pkg.featured ? 'Featured' : 'Community'}</p>
          </div>
          <div class="rounded-[var(--radius-lg)] border border-[var(--color-line)] p-[0.8rem]">
            <h2 class="mb-2 font-[var(--font-sans)] text-[0.75rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Install</h2>
            <CodePanel code={installCmd} lang="bash" filename="terminal" />
          </div>
        </div>

        <h2 class="font-[var(--font-sans)] text-[0.76rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Keywords</h2>
        <div class="flex flex-wrap gap-[0.44rem]">
          {pkg.keywords.map((k) => (
            <Tag>#{k}</Tag>
          ))}
        </div>
      </article>
    </Container>
  </Section>
</BaseLayout>

<style>
  .package-detail-shell {
    max-width: 920px;
  }
</style>
