---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { registryPackages as packages } from '../../data/registryPackages';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const featured = packages.filter((pkg) => pkg.featured);
---

<BaseLayout title="Packages" description="Sounio package ecosystem for scientific and systems workflows">
  <section class="section-shell packages-hero relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/original-artworks/ai_brand_sheet.png"
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.07] mix-blend-screen"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/75 via-transparent to-[var(--color-bg)]"></div>
    </div>
    <div class="container packages-inner relative z-10">
      <span class="badge-pill">Packages</span>
      <h1>Composable scientific capabilities, published as Sounio packages.</h1>
      <p>
        Discover maintained modules for numerical methods, probabilistic workflows, GPU acceleration, and domain toolkits.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Featured</h2>
      </div>
      <div class="package-grid premium-grid">
        {featured.map((pkg) => (
          <a href={getLocalizedPath(`/packages/${pkg.name}`, locale)} class="package-card glass glass-elevated">
            <div class="pkg-head">
              <h3>{pkg.name}</h3>
              <span>v{pkg.version}</span>
            </div>
            <p>{pkg.description}</p>
            <div class="pkg-meta">
              <span>{pkg.downloads.toLocaleString()} downloads</span>
              <span>Featured</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="all-packages glass">
        <table>
          <thead>
            <tr>
              <th>Package</th>
              <th>Version</th>
              <th>Description</th>
              <th>Downloads</th>
            </tr>
          </thead>
          <tbody>
            {packages.map((pkg) => (
              <tr>
                <td><a href={getLocalizedPath(`/packages/${pkg.name}`, locale)}>{pkg.name}</a></td>
                <td>{pkg.version}</td>
                <td>{pkg.description}</td>
                <td>{pkg.downloads.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .packages-inner {
    max-width: 780px;
    display: grid;
    gap: 1rem;
  }

  .packages-inner h1 {
    font-size: clamp(2.2rem, 5.6vw, 4.45rem);
  }

  .packages-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .package-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .package-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.58rem;
  }

  .pkg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pkg-head h3 {
    font-family: var(--font-mono);
    font-size: 1.02rem;
  }

  .pkg-head span {
    color: var(--color-text-tertiary);
    font-size: 0.78rem;
  }

  .package-card p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .pkg-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
    font-size: 0.76rem;
  }

  .all-packages {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--glass-border);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--glass-border);
  }

  th {
    color: var(--color-text-tertiary);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: var(--color-text-secondary);
  }

  td a {
    color: var(--color-text-primary);
    font-family: var(--font-mono);
  }

  @media (max-width: 820px) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead {
      display: none;
    }

    tr {
      border-bottom: 1px solid var(--glass-border);
    }

    td {
      border: 0;
      padding-top: 0.28rem;
      padding-bottom: 0.28rem;
    }
  }
</style>
