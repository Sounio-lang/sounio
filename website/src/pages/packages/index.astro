---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { registryPackages as packages } from '../../data/registryPackages';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const featured = packages.filter((pkg) => pkg.featured);
---

<BaseLayout title="Packages" description="Sounio package ecosystem for scientific and systems workflows">
  <Section class="packages-hero overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/original-artworks/ai_brand_sheet.png"
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.07] mix-blend-screen"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-surface-base)]/75 via-transparent to-[var(--color-surface-base)]"></div>
    </div>
    <Container class="packages-inner relative z-10 grid gap-4">
      <Eyebrow>Packages</Eyebrow>
      <h1 class="text-[clamp(2.2rem,5.6vw,4.45rem)]">Composable scientific capabilities, published as Sounio packages.</h1>
      <p class="text-[clamp(1rem,2.4vw,1.18rem)] text-[var(--color-ink-2)]">
        Discover maintained modules for numerical methods, probabilistic workflows, GPU acceleration, and domain toolkits.
      </p>
    </Container>
  </Section>

  <Section>
    <Container class="grid gap-4">
      <h2 class="section-heading">Featured</h2>
      <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(250px,1fr))]">
        {featured.map((pkg) => (
          <a
            href={getLocalizedPath(`/packages/${pkg.name}`, locale)}
            class="package-card glass glass-elevated grid gap-[0.58rem] rounded-[var(--radius-xl)] p-[1.1rem]"
          >
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-mono text-[1.02rem]">{pkg.name}</h3>
              <span class="text-[0.78rem] text-[var(--color-ink-3)]">v{pkg.version}</span>
            </div>
            <p class="text-[0.9rem] text-[var(--color-ink-2)]">{pkg.description}</p>
            <div class="flex justify-between gap-2 text-[0.76rem] text-[var(--color-ink-3)]">
              <span>{pkg.downloads.toLocaleString()} downloads</span>
              <span>Featured</span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="glass overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-line)]">
        <table>
          <thead>
            <tr>
              <th>Package</th>
              <th>Version</th>
              <th>Description</th>
              <th>Downloads</th>
            </tr>
          </thead>
          <tbody>
            {packages.map((pkg) => (
              <tr>
                <td><a href={getLocalizedPath(`/packages/${pkg.name}`, locale)}>{pkg.name}</a></td>
                <td>{pkg.version}</td>
                <td>{pkg.description}</td>
                <td>{pkg.downloads.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .packages-inner {
    max-width: 780px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }

  th {
    color: var(--color-ink-3);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: var(--color-ink-2);
  }

  td a {
    color: var(--color-ink-1);
    font-family: var(--font-mono);
  }

  @media (max-width: 820px) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead {
      display: none;
    }

    tr {
      border-bottom: 1px solid var(--color-line);
    }

    td {
      border: 0;
      padding-top: 0.28rem;
      padding-bottom: 0.28rem;
    }
  }
</style>
