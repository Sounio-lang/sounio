---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="Start Sounio" description="Choose your journey into Sounio.">
  <div class="pt-32 pb-24 min-h-screen bg-[#020617] flex flex-col justify-center">
    <div class="container max-w-4xl text-center">
      <div id="yiayia-content" class="hidden">
        <span class="text-4xl mb-6 block" role="img" aria-label="Yiayia">👵</span>
        <h1 class="font-display text-5xl md:text-7xl font-medium tracking-tight mb-6 text-white">
          Journey with <span class="text-[var(--color-accent-teal)]">Yiayia.</span>
        </h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto font-sans font-light mb-12">
          Explore Sounio's clinical precision, GUM error propagation, and patient-safety gates in pharmacology and scientific computing.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          <a href={getLocalizedPath('/dissertation', locale)} class="px-8 py-4 rounded-full bg-[var(--color-accent-teal)] text-[#020617] font-semibold text-lg hover:scale-105 transition-transform duration-300">
            View Dissertation Demo
          </a>
          <a href={getLocalizedPath('/science/pharma', locale)} class="px-8 py-4 rounded-full border border-white/10 bg-white/5 text-white font-semibold text-lg hover:bg-white/10 transition-colors duration-300">
            Explore Pharma Showcase
          </a>
        </div>
      </div>

      <div id="pappou-content" class="hidden">
        <span class="text-4xl mb-6 block" role="img" aria-label="Pappou">👴</span>
        <h1 class="font-display text-5xl md:text-7xl font-medium tracking-tight mb-6 text-white">
          Journey with <span class="text-[var(--color-accent-gold)]">Pappou.</span>
        </h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto font-sans font-light mb-12">
          Dive into Sounio's compiler, self-hosting bootstrap, algebraic effects, and native PTX/GPU acceleration.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          <a href={getLocalizedPath('/learn/getting-started', locale)} class="px-8 py-4 rounded-full bg-[var(--color-accent-gold)] text-[#020617] font-semibold text-lg hover:scale-105 transition-transform duration-300">
            Getting Started
          </a>
          <a href={getLocalizedPath('/language', locale)} class="px-8 py-4 rounded-full border border-white/10 bg-white/5 text-white font-semibold text-lg hover:bg-white/10 transition-colors duration-300">
            Language Tour
          </a>
        </div>
      </div>

      <div id="default-content" class="hidden">
        <h1 class="font-display text-5xl md:text-7xl font-medium tracking-tight mb-6 text-white">
          Choose your <span class="text-[var(--color-accent-gold)]">Path.</span>
        </h1>
        <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto font-sans font-light mb-12">
          Are you here for scientific precision and clinical pharmacometrics, or high-performance systems engineering?
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left mt-12">
          <a href={getLocalizedPath('/start?guide=yiayia', locale)} class="group p-8 rounded-2xl bg-white/5 border border-white/10 hover:border-[var(--color-accent-teal)]/30 transition-all duration-300">
            <span class="text-3xl mb-4 block" role="img" aria-label="Yiayia">👵</span>
            <h2 class="font-display text-2xl text-[var(--color-accent-teal)] mb-3">Science & Medicine</h2>
            <p class="text-[var(--color-text-secondary)] text-sm">ASHP compliance, pharmacokinetics, and uncertainty quantification.</p>
          </a>
          <a href={getLocalizedPath('/start?guide=pappou', locale)} class="group p-8 rounded-2xl bg-white/5 border border-white/10 hover:border-[var(--color-accent-gold)]/30 transition-all duration-300">
            <span class="text-3xl mb-4 block" role="img" aria-label="Pappou">👴</span>
            <h2 class="font-display text-2xl text-[var(--color-accent-gold)] mb-3">Systems & Compilers</h2>
            <p class="text-[var(--color-text-secondary)] text-sm">Self-hosting, GPU execution, and algebraic effect registry.</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function updateContent() {
    const params = new URLSearchParams(window.location.search);
    const guide = params.get('guide');

    const yiayia = document.getElementById('yiayia-content');
    const pappou = document.getElementById('pappou-content');
    const defaultContent = document.getElementById('default-content');

    if (yiayia) yiayia.classList.add('hidden');
    if (pappou) pappou.classList.add('hidden');
    if (defaultContent) defaultContent.classList.add('hidden');

    if (guide === 'yiayia') {
      yiayia?.classList.remove('hidden');
    } else if (guide === 'pappou') {
      pappou?.classList.remove('hidden');
    } else {
      defaultContent?.classList.remove('hidden');
    }
  }

  // Update on initial load and view transitions
  updateContent();
  document.addEventListener('astro:page-load', updateContent);
</script>