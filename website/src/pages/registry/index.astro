---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { registryPackages as packages } from '../../data/registryPackages';
---

<BaseLayout title="Package Registry">
  <div class="py-16 bg-[var(--color-bg)]">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-4">
          Package Registry
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Discover and install Sounio packages for scientific computing, GPU acceleration, and more.
        </p>
      </div>

      <!-- Search bar -->
      <div class="max-w-2xl mx-auto mb-12">
        <div class="relative">
          <input
            type="search"
            placeholder="Search packages..."
            class="w-full px-4 py-3 pl-12 rounded-xl border border-[var(--color-border)] bg-white dark:bg-[var(--color-bg-alt)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold-500)] shadow-sm"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Featured packages -->
      <h2 class="text-2xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-6">
        Featured Packages
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {packages.filter(p => p.featured).map((pkg) => (
          <a
            href={`/registry/${pkg.name}`}
            class="group block p-6 bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md hover:shadow-xl transition-all border-t-4 border-[var(--color-gold-500)]"
          >
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-semibold text-[var(--color-navy-900)] dark:text-white group-hover:text-[var(--color-orange-500)] font-mono">
                {pkg.name}
              </h3>
              <span class="text-sm text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] px-2 py-0.5 rounded font-mono">
                v{pkg.version}
              </span>
            </div>
            <p class="text-[var(--color-text-muted)] text-sm mb-4">
              {pkg.description}
            </p>
            <div class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              {pkg.downloads.toLocaleString()} downloads
            </div>
          </a>
        ))}
      </div>

      <!-- All packages -->
      <h2 class="text-2xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-6">
        All Packages
      </h2>
      <div class="bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md overflow-hidden">
        <table class="w-full">
          <thead class="bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)]">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-[var(--color-navy-900)] dark:text-white">Package</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-[var(--color-navy-900)] dark:text-white">Version</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-[var(--color-navy-900)] dark:text-white hidden md:table-cell">Description</th>
              <th class="px-6 py-3 text-right text-sm font-semibold text-[var(--color-navy-900)] dark:text-white">Downloads</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            {packages.map((pkg) => (
              <tr class="hover:bg-[var(--color-bg-alt)] dark:hover:bg-[var(--color-bg)] transition-colors">
                <td class="px-6 py-4">
                  <a href={`/registry/${pkg.name}`} class="font-mono text-[var(--color-navy-900)] dark:text-white hover:text-[var(--color-orange-500)]">
                    {pkg.name}
                  </a>
                </td>
                <td class="px-6 py-4 font-mono text-sm text-[var(--color-text-muted)]">
                  {pkg.version}
                </td>
                <td class="px-6 py-4 text-sm text-[var(--color-text-muted)] hidden md:table-cell">
                  {pkg.description}
                </td>
                <td class="px-6 py-4 text-right text-sm text-[var(--color-text-muted)]">
                  {pkg.downloads.toLocaleString()}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 p-6 bg-[var(--color-bg-alt)] dark:bg-[var(--color-navy-900)]/50 rounded-xl text-center">
        <h3 class="text-lg font-semibold text-[var(--color-navy-900)] dark:text-white mb-2">
          Publish Your Package
        </h3>
        <p class="text-[var(--color-text-muted)] mb-4">
          Share your Sounio packages with the community.
        </p>
        <code class="inline-block px-4 py-2 bg-[var(--color-navy-900)] text-[var(--color-gold-500)] rounded-lg font-mono text-sm">
          souc publish
        </code>
      </div>
    </div>
  </div>
</BaseLayout>
