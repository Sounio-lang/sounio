---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
---

<BaseLayout
  title="Credits and AI Disclosure — Sounio"
  description="GAIDeT-style AI-assistance disclosure for the Sounio website. Documents AI tool usage, scope, and human authorship attribution."
>
  <Section pad="default">
    <Container width="wide" class="credits-inner">
      <Eyebrow class="mb-[1rem]">Transparency</Eyebrow>
      <h1 class="font-sans text-[clamp(2rem,5vw,3rem)] font-[750] leading-[1.1] tracking-[-0.025em] text-[var(--color-ink-1)] mb-[1rem]">
        Credits and AI Disclosure
      </h1>
      <p class="text-[0.97rem] text-[var(--color-ink-2)] max-w-[64ch] leading-[1.75] mb-[2.5rem]">
        This page satisfies the <a href="https://gaidet.org" target="_blank" rel="noopener noreferrer" class="text-link">GAIDeT framework</a> and
        ICMJE 2025 authorship guidance for AI tool disclosure.
        The full machine-readable record is in <code>website/CREDITS.md</code>.
      </p>

      <div class="prose-section">
        <h2>AI Tool Usage</h2>
        <dl class="def-list">
          <dt>Tool</dt>
          <dd>Claude Code (Anthropic)</dd>
          <dt>Model</dt>
          <dd>claude-sonnet-4-6 (Sonnet 4.6)</dd>
          <dt>Operator</dt>
          <dd>Demetrios Chiuratto Agourakis (sole maintainer)</dd>
        </dl>

        <h3>Scope of AI assistance</h3>
        <p>
          AI assistance was used during the website restructuring work performed in April 2026,
          covering the following branches:
        </p>
        <ul>
          <li><code>website-restructure-01-objective-fixes</code> — objective corrections pass</li>
          <li><code>website-restructure-02-homepage</code> — homepage redesign</li>
          <li><code>website-restructure-03-proof</code> — evidence/proof page</li>
          <li><code>website-restructure-04-language-platform-merge</code> — merged <code>/platform</code> into <code>/language</code></li>
          <li><code>website-restructure-05-i18n-audit</code> — locale banners for 5 non-English locales</li>
          <li><code>website-restructure-06-disclosure-polish</code> — this disclosure page</li>
        </ul>

        <h3>Nature of AI involvement</h3>
        <ul>
          <li><strong>Drafting and editing:</strong> AI drafted page copy, component markup, and configuration changes under maintainer direction.</li>
          <li><strong>Code generation:</strong> AI wrote Astro components, CSS, and TypeScript utilities. All changes were reviewed and committed by the maintainer.</li>
          <li><strong>Translation strings:</strong> AI generated UI string translations for Portuguese, Chinese, Japanese, and Spanish. Greek (el) strings were deliberately left untranslated pending native speaker review.</li>
          <li><strong>No autonomous publication:</strong> No content was published without maintainer review and explicit <code>git push</code>.</li>
        </ul>

        <h3>What AI did not do</h3>
        <ul>
          <li>AI did not author the Sounio language specification, compiler, standard library, or scientific claims.</li>
          <li>AI did not generate content in docs, blog, science, or insights sections.</li>
          <li>AI did not make architectural decisions about language semantics or the epistemic type system.</li>
        </ul>
      </div>

      <div class="prose-section">
        <h2>Human authorship</h2>
        <p>
          All language design, compiler implementation, scientific research, and strategic direction
          are solely the work of Demetrios Chiuratto Agourakis.
        </p>
      </div>

      <div class="prose-section">
        <h2>Third-party assets</h2>
        <table class="asset-table">
          <thead>
            <tr>
              <th>Asset</th>
              <th>Source</th>
              <th>License</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sounio seal/stamp</td>
              <td>Original artwork, Sounio project</td>
              <td>Apache-2.0</td>
            </tr>
            <tr>
              <td>Inter typeface</td>
              <td>Rasmus Andersson / Google Fonts</td>
              <td>OFL-1.1</td>
            </tr>
            <tr>
              <td>JetBrains Mono</td>
              <td>JetBrains</td>
              <td>OFL-1.1</td>
            </tr>
            <tr>
              <td>GitHub mark (SVG)</td>
              <td>GitHub, Inc.</td>
              <td><a href="https://github.com/logos" target="_blank" rel="noopener noreferrer" class="text-link">GitHub Logos Policy</a></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[0.82rem] text-[var(--color-ink-3)] mt-[3rem]">Last updated: 2026-04-20</p>
    </Container>
  </Section>
</BaseLayout>

<style>
  .credits-inner {
    max-width: 780px;
  }

  .prose-section {
    margin-bottom: 2.5rem;
  }

  .prose-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink-1);
    margin: 0 0 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-line);
  }

  .prose-section h3 {
    font-size: 1rem;
    font-weight: 650;
    color: var(--color-ink-1);
    margin: 1.4rem 0 0.5rem;
  }

  .prose-section p,
  .prose-section li {
    font-size: 0.95rem;
    color: var(--color-ink-2);
    line-height: 1.75;
    max-width: 68ch;
  }

  .prose-section ul {
    padding-left: 1.4rem;
    margin: 0.5rem 0;
  }

  .prose-section li {
    margin-bottom: 0.35rem;
  }

  .prose-section code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: color-mix(in srgb, var(--color-surface-frost) 60%, transparent);
    border: 1px solid var(--color-line);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }

  .def-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 1.4rem;
    margin: 0.7rem 0 1.4rem;
  }

  .def-list dt {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    padding-top: 0.1rem;
  }

  .def-list dd {
    font-size: 0.95rem;
    color: var(--color-ink-2);
    margin: 0;
  }

  .asset-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin-top: 0.7rem;
  }

  .asset-table th {
    text-align: left;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }

  .asset-table td {
    padding: 0.5rem 0.75rem;
    color: var(--color-ink-2);
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 40%, transparent);
    vertical-align: top;
  }

  .text-link {
    color: var(--color-accent-hyperlink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .text-link:hover {
    color: var(--color-accent-hyperlink);
  }
</style>
