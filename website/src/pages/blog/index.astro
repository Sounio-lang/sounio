---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    title: 'Introducing Sounio 0.99.0',
    description: 'Our biggest release yet with native GPU kernels, improved uncertainty propagation, and a completely redesigned standard library.',
    date: '2026-01-15',
    author: 'Sounio Team',
    tags: ['release', 'gpu', 'stdlib'],
    featured: true,
  },
  {
    title: 'Uncertainty Propagation: A Deep Dive',
    description: 'How Sounio implements GUM-compliant uncertainty propagation and what it means for your scientific computations.',
    date: '2026-01-10',
    author: 'Dr. Elena Vasquez',
    tags: ['uncertainty', 'gum', 'tutorial'],
    featured: false,
  },
  {
    title: 'Building GPU Kernels in Sounio',
    description: 'A comprehensive guide to writing high-performance GPU code with Sounio\'s native kernel syntax.',
    date: '2026-01-05',
    author: 'Marcus Chen',
    tags: ['gpu', 'performance', 'tutorial'],
    featured: false,
  },
];
---

<BaseLayout title="Blog">
  <div class="py-16 bg-[var(--color-bg)]">
    <div class="container max-w-4xl">
      <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-4">
        Blog & Updates
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-12">
        Latest news, tutorials, and insights from the Sounio team.
      </p>

      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group p-6 bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md hover:shadow-xl transition-all border border-transparent hover:border-[var(--color-gold-500)]">
            <div class="flex items-center gap-3 mb-3">
              <time class="text-sm text-[var(--color-text-muted)]">{post.date}</time>
              <span class="text-[var(--color-text-muted)]">·</span>
              <span class="text-sm text-[var(--color-text-muted)]">{post.author}</span>
              {post.featured && (
                <span class="px-2 py-0.5 bg-[var(--color-gold-500)] text-[var(--color-navy-900)] text-xs font-medium rounded">
                  Featured
                </span>
              )}
            </div>
            <h2 class="text-2xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 group-hover:text-[var(--color-orange-500)] transition-colors">
              <a href={`/blog/${post.title.toLowerCase().replace(/\s+/g, '-')}`}>
                {post.title}
              </a>
            </h2>
            <p class="text-[var(--color-text-muted)] mb-4">
              {post.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <span class="px-2 py-1 bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] text-sm text-[var(--color-text-muted)] rounded">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-[var(--color-text-muted)]">
          More posts coming soon. Subscribe to our newsletter for updates.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
