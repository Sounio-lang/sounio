---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpistemicTypeLadder from '../components/diagrams/EpistemicTypeLadder.astro';
import UncertaintyFlow from '../components/diagrams/UncertaintyFlow.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);

const pillars = [
  {
    title: 'Knowledge<T> as a Primitive',
    body: 'Values carry uncertainty, confidence, and provenance by default instead of external spreadsheet logic.',
  },
  {
    title: 'Validated<T>',
    body: 'Values that pass a formal threshold check become Validated<T> — a distinct type that cannot be confused with raw measurements.',
  },
  {
    title: 'Intervention<T> & Counterfactual<T>',
    body: 'Causal reasoning is built into the type system. Interventions and counterfactuals carry confidence and are compiler-enforced.',
  },
  {
    title: 'Confidence-Gated Execution',
    body: 'Control flow can branch on confidence guarantees, so runtime behavior reflects evidence quality.',
  },
  {
    title: 'Explicit Effects',
    body: 'I/O, mutation, allocation, GPU, and probabilistic effects are visible in function signatures.',
  },
  {
    title: 'Units + Constraints',
    body: 'Dimensions and refinement checks make invalid scientific operations fail before deployment.',
  },
];

const example = `let concentration: Knowledge<f64> = Knowledge(
  9.8,
  ε=0.97,
  prov="lab_run_042"
)

if concentration.ε > 0.95 {
  approve_for_decision(concentration)
} else {
  request_remeasurement(concentration)
}`;
---

<BaseLayout title="Language" description="Sounio language principles and core semantics">
  <section class="section-shell language-hero">
    <div class="container hero-inner">
      <span class="badge-pill">Language</span>
      <h1>Designed for evidence-aware software, not just numerical output.</h1>
      <p>
        Sounio treats scientific trust as a language concern. The type system keeps uncertainty, provenance,
        and effect boundaries visible from first line to production deployment.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/learn/language', locale)} class="hero-cta primary">Read the Language Guide</a>
        <a href={getLocalizedPath('/playground', locale)} class="hero-cta secondary">Try the Playground</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">Core Pillars</h2>
        <p class="section-subhead">Mechanisms that make trust and performance coexist in one systems language.</p>
      </div>
      <div class="pillar-grid premium-grid">
        {pillars.map((pillar) => (
          <article class="pillar-card glass glass-specular">
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">The Knowledge&lt;T&gt; Progression</h2>
        <p class="section-subhead">Every value evolves through four tiers — from bare numeric to a fully epistemic, provenance-tracked type.</p>
      </div>
      <EpistemicTypeLadder />
    </div>
  </section>

  <section class="section-shell">
    <div class="container sample-grid">
      <article class="glass sample-card">
        <h2 class="section-heading">What Epistemic Code Looks Like</h2>
        <p class="section-subhead">Trust conditions become explicit runtime behavior rather than hidden assumptions.</p>
      </article>
      <article class="glass code-card">
        <pre><code>{example}</code></pre>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container flow-section">
      <div class="flow-label">
        <h2 class="section-heading">From Measurement to Decision</h2>
        <p class="section-subhead">Uncertainty propagates automatically through every operation. Confidence gates enforce data quality at the call site — no boilerplate.</p>
      </div>
      <UncertaintyFlow />
    </div>
  </section>
</BaseLayout>

<style>
  .language-hero {
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
  }

  .hero-inner {
    max-width: 760px;
    display: grid;
    gap: 1rem;
  }

  .hero-inner h1 {
    font-size: clamp(2.2rem, 5.7vw, 4.4rem);
  }

  .hero-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .pillar-grid {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .pillar-card {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }

  .pillar-card h3 {
    font-size: 1.22rem;
  }

  .pillar-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .sample-grid {
    display: grid;
    gap: 1rem;
  }

  .sample-card,
  .code-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  @media (min-width: 960px) {
    .sample-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: stretch;
    }
  }

  .flow-section {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .flow-label {
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 860px) {
    .flow-section {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
